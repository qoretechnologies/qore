#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires reflection

%try-module json
%define NoJson
%endtry

%exec-class HashDeclTest

public hashdecl Container {
    int i = 1;
    string str = "hi";
    number n;
}

public hashdecl Container2 {
    int i = 2;
    string str = "hi";
    number n;
    date d = now_us();
}

public namespace Test;

public hashdecl Test::Container3 {
    int i = 3;
}

public hashdecl R1 {
    hash<R1> r();
}

hashdecl Issue3518 {
    int i;
}

# Hashdecl with complex type default value - tests that acceptInputComplexList
# does not steal a reference from the shared default expression node
public hashdecl ComplexDefaults {
    string name;
    list<string> items = ();
    list<int> numbers = ();
    hash<string, string> metadata = {};
}

public hashdecl RuntimeFoldExpression {
    int code;
    string name;
}

public hashdecl RuntimeFoldContainer {
    *hash<string, hash<RuntimeFoldExpression>> expressions;
    *list<hash<RuntimeFoldExpression>> expression_list;
}

#! Leaf for the container-folding tests below
/** "value" is auto and "format" is optional, so an initializer whose values are all strings is
    valid for every field -- which is what makes it a usable probe for the inferred element type.
*/
public hashdecl FoldLeaf {
    auto value;
    *string format;
}

#! Nonoptional list container of hashdecls
public hashdecl FoldListParent {
    list<hash<FoldLeaf>> parts;
}

#! Optional hash container of hashdecls, covering the complex-hash gate as well as the list one
public hashdecl FoldHashParent {
    *hash<string, hash<FoldLeaf>> parts;
}

#! Recursive container: the nested element type is the declaring hashdecl itself
public hashdecl FoldTree {
    auto value;
    *string format;
    *list<hash<FoldTree>> parts;
}

#! Container of a scalar type, to confirm folding eligibility does not reach scalar element types
public hashdecl FoldScalarParent {
    list<int> numbers;
}

#! Takes a declared list container, so that argument binding is checked against a resolved literal
list<hash<FoldLeaf>> sub fold_list_arg(list<hash<FoldLeaf>> parts) {
    return parts;
}

#! Takes a declared hash container, covering the complex-hash gate in argument position
hash<string, hash<FoldLeaf>> sub fold_hash_arg(hash<string, hash<FoldLeaf>> parts) {
    return parts;
}

#! Returns a declared container built from an ordinary literal
list<hash<FoldLeaf>> sub fold_list_return() {
    return ({"value": "returned", "format": "f"},);
}

#! Overloaded variants: a source the target accepts as-is must outrank one that has to be folded
string sub fold_overload(list<hash<FoldLeaf>> parts) {
    return "folded";
}

#! ... the exact variant for an all-string literal
string sub fold_overload(list<hash<string, string>> parts) {
    return "exact";
}

#! Takes a soft list of hashdecls, to check the single-value wrap against the element type
softlist<hash<FoldLeaf>> sub fold_softlist_arg(softlist<hash<FoldLeaf>> parts) {
    return parts;
}

#! Overload set in which only the container variant can accept the call at all
string sub fold_only_overload(list<hash<FoldLeaf>> parts) {
    return "folded";
}

#! ... the variant that no container argument can reach
string sub fold_only_overload(string str) {
    return "string";
}

#! Declared containers initialized from ordinary literals in member declarations and bound as arguments
class FoldMemberHolder {
    public {
        list<hash<FoldLeaf>> parts = ({"value": "member", "format": "f"},);
        hash<string, hash<FoldLeaf>> member_map = {"a": {"value": "member-map"}};
    }

    list<hash<FoldLeaf>> take(list<hash<FoldLeaf>> parts) {
        return parts;
    }
}

public hashdecl OverrideCastInfo {
    *string value = "default";
}

hashdecl Issue3654 {
    bool b = False;
}

const B = <Issue3654>{};

# Hashdecl inheritance test declarations
public hashdecl BaseInfo {
    string name;
    int id;
}

public hashdecl ExtendedInfo inherits BaseInfo {
    date created;
    *string description;
}

public hashdecl DeeplyNested inherits ExtendedInfo {
    float value;
}

# Namespaced inheritance test
public namespace InheritTest {
    public hashdecl ParentDecl {
        int parent_id = 100;
        string parent_name = "parent";
    }

    public hashdecl ChildDecl inherits ParentDecl {
        int child_id = 200;
        string child_name = "child";
    }
}

# Hashdecl with default values in inheritance chain
public hashdecl DefaultBase {
    int base_val = 10;
    string base_str = "base_default";
}

public hashdecl DefaultChild inherits DefaultBase {
    int child_val = 20;
    string child_str = "child_default";
}

*string sub str_test() {}

#! Class with typed members, for the object member merge path
class TypedMembers {
    public {
        int i = 0;
        string str = "";
    }
}

class HashDeclTest inherits QUnit::Test {
    constructor() : QUnit::Test("HashDecl test", "1.0") {
        addTestCase("issue 3654", \issue3654());
        addTestCase("serialize imported", \serializeImportedTest());
        addTestCase("issue 3167", \issue3167());
        addTestCase("Test HashDecl", \testHashDecl());
        addTestCase("namespaced typed hash literal", \namespacedTypedHashLiteral());
        addTestCase("hashdecl inheritance", \testHashDeclInheritance());
        addTestCase("complex type defaults", \testComplexTypeDefaults());
        addTestCase("generic container hashdecl folding", \testGenericContainerHashDeclFolding());
        addTestCase("homogeneous container hashdecl folding", \testHomogeneousContainerHashDeclFolding());
        addTestCase("container folding parse/runtime agreement", \testContainerFoldingParseRuntimeAgreement());
        addTestCase("typed hash cast with overrides", \testTypedHashCastWithOverrides());
        addTestCase("typed container runtime assignment", \testTypedContainerRuntimeAssignment());
        set_return_value(main());
    }

    #! Runtime type checking of typed-container assignment
    /** The type-acceptance calls behind hashdecl key assignment, complex hash/list element assignment and
        hashdecl initialization report failure only through the ExceptionSink, so they must report the outcome
        of the assignment itself and nothing else.  Getting this wrong drops values silently, so cover both
        outcomes: an accepted value must actually be stored, and a rejected one must still raise.
    */
    testTypedContainerRuntimeAssignment() {
        # hashdecl key assignment: the value must be stored, not silently dropped
        hash<Container> c();
        c.i = auto_value(42);
        c.str = auto_value("stored");
        assertEq(42, c.i, "hashdecl int key assigned at runtime");
        assertEq("stored", c.str, "hashdecl string key assigned at runtime");

        # ... and a value of the wrong type must still be rejected
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            hash<Container> bad();
            bad.i = auto_value(new Mutex());
        }, NOTHING, "hashdecl key rejects an incompatible value");

        # hashdecl initialization from an init hash
        hash<Container> init = cast<hash<Container>>(auto_value({"i": 7, "str": "init"}));
        assertEq(7, init.i, "hashdecl initialized from an init hash");
        assertEq("init", init.str, "hashdecl string initialized from an init hash");

        # complex hash element assignment
        hash<string, int> ch();
        ch.one = auto_value(1);
        ch.two = auto_value(2);
        assertEq({"one": 1, "two": 2}, ch, "complex hash elements assigned at runtime");
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            hash<string, int> bad();
            bad.x = auto_value(new Mutex());
        }, NOTHING, "complex hash element rejects an incompatible value");

        # complex list element assignment
        list<string> sl();
        sl += auto_value("a");
        sl += auto_value("b");
        assertEq(("a", "b"), sl, "complex list elements assigned at runtime");

        # ... including the conversion branch, where the value's type does not already match the element type
        list<softstring> fl();
        fl += auto_value(5);
        assertEq(("5",), fl, "complex list element converted at runtime");
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            list<int> bad();
            bad += auto_value(1);
            bad += auto_value(new Mutex());
        }, NOTHING, "complex list element rejects an incompatible value");

        # object member merge: every member of the merged hash must be applied
        TypedMembers tm();
        tm += {"i": auto_value(11), "str": auto_value("merged")};
        assertEq(11, tm.i, "object int member merged");
        assertEq("merged", tm.str, "object string member merged");
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            TypedMembers bad();
            bad += {"i": auto_value(new Mutex())};
        }, NOTHING, "object member merge rejects an incompatible value");
    }

    #! Returns the argument with its type erased, to defer type checking to runtime
    static auto auto_value(auto v) {
        return v;
    }

    issue3654() {
        assertEq(False, B.b);
    }

    serializeImportedTest() {
        Program p();
        p.importHashDecl("Issue3518");
        p.parse("binary sub t() { return Serializable::serialize(<Issue3518>{\"i\": 1}); }", "");
        assertEq("hash<Issue3518>", Serializable::deserialize(p.callFunction("t")).fullType());
    }

    issue3167() {
        assertThrows("RUNTIME-TYPE-ERROR", "key.*Container",
            sub () {
                hash<Container> h();
                h += {"str": str_test()};
                delete h;
            }
        );
        assertThrows("RUNTIME-TYPE-ERROR", "key.*Container",
            sub () {
                hash<Container> h({
                    "str": str_test(),
                });
                delete h;
            }
        );
    }

    testHashDecl() {
        # issue #2491: test implicit creation of typed hashes (explicit value type)
        {
            hash<string, int> c;
            c.a = 1;
            assertEq(Type::Hash, c.type());
            assertEq("hash<string, int>", c.fullType());
            assertEq(1, c.a);
            assertEq(True, c instanceof hash<string, int>);
        }

        # issue #2491: test implicit creation of typed hashes (hashdecl)
        assertThrows("HASHDECL-IMPLICIT-CONSTRUCTION-ERROR", "Container", sub () {hash<Container> c; c.n = M_PIn;});

        {
            hash<Container> c();
            assertEq(Type::Hash, c.type());
            assertEq(1, c.i);
            assertEq("hi", c.str);
            assertEq(NOTHING, c.n);
            assertEq("hash<Container>", c.fullType());
            assertEq(True, c instanceof hash<Container>);
        }

        {
            hash<Container> c(("n": 1n, "str": "other", "i": 2));
            assertEq(Type::Hash, c.type());
            assertEq(2, c.i);
            assertEq("other", c.str);
            assertEq(1n, c.n);
            assertEq(("i", "str", "n"), c.keys());
        }

        {
            hash<Container> c(("n": 1n));
            assertEq(Type::Hash, c.type());
            assertEq(1, c.i);
            assertEq("hi", c.str);
            assertEq(1n, c.n);
        }

        {
            hash<Container> c();
            hash h = c;
            assertEq(Type::Hash, h.type());
            assertEq(1, h.i);
            assertEq("hi", h.str);
            assertEq(NOTHING, h.n);

            assertEq(h, c);
            assertEq(c, h);
        }

        {
            hash<Container> c();
            hash h = c;
            c = cast<hash<Container>>(h);
            assertEq(Type::Hash, c.type());
            assertEq(1, c.i);
            assertEq("hi", c.str);
            assertEq(NOTHING, c.n);

            assertEq(h, c);
            assertEq(c, h);
        }

        {
            hash<Container> c1();
            hash<Container> c2 = new hash<Container>();
            assertEq(c1, c2);
        }

        {
            hash<Container> c1(("i": 2, "str": "other", "n": 1n));
            hash<Container> c2 = new hash<Container>(("i": 2, "str": "other", "n": 1n));
            assertEq(c1, c2);
            c2.n = 2n;
            assertEq(True, c1 != c2);
        }

        {
            hash<Container> c1();
            hash<Container2> c2;
            c2 = cast<hash<Container2>>(c1);
            assertEq(Type::Date, c2.d.type());
        }

        {
            hash<string, int> h(("i": 4));
            hash<Container> c1 = cast<hash<Container>>(h);
            assertEq(4, c1.i);
        }

        {
            # make sure that a runtime assignment from a hashdecl hash to an untyped hash results in an untyped hash assignment
            hash h = new hash<Container>();
            h.b = "str";
            assertEq("str", h.b);
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", "assignment", \p.parse(), ("sub t() {hash<string, int> h = new hash<Container>();}", ""));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", "assignment", \p.parse(), ("sub t() {hash<Container> c = new hash<string, int>(('x': 3));}", ""));
        }

        {
            hash<Container> c1;
            hash<Container2> c2();
            c1 = cast<hash<Container>>(c2 - "d");
            assertEq(c1.i, 2);
        }

        {
            hash<Test::Container3> c3();
            assertEq(3, c3.i);
        }

        {
            Program p(PO_NEW_STYLE);
            p.parse("sub t() {hash<Container> c();}", "");
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), ("sub t() {hash<Container> c(); c = (\"i\": 2, \"str\": \"other\", \"n\": 1.1n);}", ""));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), ("sub t() {hash<Container> c1; hash<Container2> c2(); c1 = cast<hash<Container2>>(c2);}", ""));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), ("sub t() {hash<Container> c1; c1 = ('x1': 1);}", ""));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), ("sub t() {hash<Container> c1; hash<Container2> c2(); c1 = c2;}", ""));
        }

        {
            Program p(PO_NEW_STYLE);
            p.parse("sub t() {hash h = ('x': 1); hash<Container2> c2(); c2 += h;}", "");
            assertThrows("HASHDECL-KEY-ERROR", \p.callFunction(), ("t"));
        }

        {
            Program p(PO_NEW_STYLE);
            p.parse("sub t() {hash<Container> c(); string k = 'x1'; c{k} = 2;}", "");
            assertThrows("INVALID-MEMBER", \p.callFunction(), ("t"));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", \p.parse(), ("sub t() {hash<Container> c(); c.x1 = 2;}", ""));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), ("sub tn(string str) {} sub t() {hash<Container> c(); tn(c.i);}", ""));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), ("sub t() {hash<Container> c(); c.i = 'str';}", ""));
        }

        if (HAVE_STACK_GUARD) {
            Program p(PO_NEW_STYLE);
            p.parse("sub t() { hash<R1> r(); }", "");
            assertThrows("STACK-LIMIT-EXCEEDED", \p.callFunction(), "t");
        }

        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);
            assertThrows("PARSE-EXCEPTION", \p.parse(), ("sub t() {hash<Container> c; delete c;}", ""));
        }

        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);
            p.importHashDecl("Container");
            p.parse("hash<Container> sub t() {return new hash<Container>();}", "");
            hash<Container> c = p.callFunction("t");
            assertEq(True, c instanceof hash<Container>);
        }

        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_SYSTEM_HASHDECLS);
            assertThrows("PARSE-EXCEPTION", \p.parse(), ("sub t() {hash<ExceptionInfo> c; delete c;}", ""));
        }
    }

    namespacedTypedHashLiteral() {
        hash<Test::Container3> c = <Test::Container3>{};
        assertEq(True, c instanceof hash<Test::Container3>);
        assertEq(3, c.i);

        hash<Test::Container3> c2 = <::Test::Container3>{};
        assertEq(True, c2 instanceof hash<Test::Container3>);
        assertEq(3, c2.i);

        hash<Test::Container3> c3 = hash<Test::Container3>{};
        assertEq(True, c3 instanceof hash<Test::Container3>);
        assertEq(3, c3.i);

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", \p.parse(), ("sub t() {auto h = <Test::>{};}", ""));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", \p.parse(), ("sub t() {auto h = <::>{};}", ""));
        }
    }

    testHashDeclInheritance() {
        # Test 1: Basic inheritance - direct member access
        {
            hash<ExtendedInfo> ext = <ExtendedInfo>{
                "name": "test",
                "id": 123,
                "created": now(),
                "description": "A test",
            };
            assertEq("test", ext.name);
            assertEq(123, ext.id);
            assertEq(Type::Date, ext.created.type());
            assertEq("A test", ext.description);
            assertEq("hash<ExtendedInfo>", ext.fullType());
        }

        # Test 2: Basic inheritance - member access via hash<> constructor
        {
            hash<ExtendedInfo> ext({"name": "test2", "id": 456, "created": 2024-01-01});
            assertEq("test2", ext.name);
            assertEq(456, ext.id);
            assertEq(2024-01-01, ext.created);
        }

        # Test 3: Basic inheritance - member access via new hash<>()
        {
            hash<ExtendedInfo> ext = new hash<ExtendedInfo>({"name": "test3", "id": 789, "created": now()});
            assertEq("test3", ext.name);
            assertEq(789, ext.id);
        }

        # Test 4: Deeply nested inheritance (3 levels)
        {
            hash<DeeplyNested> deep = <DeeplyNested>{
                "name": "deep",
                "id": 1,
                "created": now(),
                "value": 3.14,
            };
            assertEq("deep", deep.name);  # from BaseInfo
            assertEq(1, deep.id);          # from BaseInfo
            assertEq(Type::Date, deep.created.type());  # from ExtendedInfo
            assertEq(3.14, deep.value);    # from DeeplyNested
            assertEq("hash<DeeplyNested>", deep.fullType());
        }

        # Test 5: Namespaced inheritance
        {
            hash<InheritTest::ChildDecl> child();
            assertEq(100, child.parent_id);
            assertEq("parent", child.parent_name);
            assertEq(200, child.child_id);
            assertEq("child", child.child_name);
        }

        # Test 6: Default values are inherited
        {
            hash<DefaultChild> dc();
            assertEq(10, dc.base_val);
            assertEq("base_default", dc.base_str);
            assertEq(20, dc.child_val);
            assertEq("child_default", dc.child_str);
        }

        # Test 7: Override parent defaults with explicit values
        {
            hash<DefaultChild> dc({"base_val": 99, "child_val": 999});
            assertEq(99, dc.base_val);
            assertEq("base_default", dc.base_str);
            assertEq(999, dc.child_val);
            assertEq("child_default", dc.child_str);
        }

        # Test 8: Error - unknown parent hashdecl
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", "undefined hashdecl",
                \p.parse(), ("hashdecl Child inherits NonExistentParent { int x; }", ""));
        }

        # Test 9: Error - circular inheritance (self-reference)
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", "circular hashdecl inheritance",
                \p.parse(), ("hashdecl SelfRef inherits SelfRef { int x; }", ""));
        }

        # Test 10: Error - circular inheritance (indirect)
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", "circular hashdecl inheritance",
                \p.parse(), ("hashdecl A inherits B { int a; } hashdecl B inherits A { int b; }", ""));
        }

        # Test 11: Error - member shadowing
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", "shadows member in parent",
                \p.parse(), ("hashdecl Parent { int x; } hashdecl Child inherits Parent { int x; }", ""));
        }

        # Test 12: Error - member shadowing in deeply nested inheritance
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", "shadows member in parent",
                \p.parse(), ("hashdecl A { int x; } hashdecl B inherits A { int y; } hashdecl C inherits B { int x; }", ""));
        }

        # Test 13: Error - unknown key assignment (parent member)
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", \p.parse(),
                ("hashdecl P { int x; } hashdecl C inherits P { int y; } sub t() { hash<C> c(); c.z = 1; }", ""));
        }

        # Test 14: Parse success - inherited type declarations work correctly
        {
            Program p(PO_NEW_STYLE);
            p.parse("
                hashdecl Base { int id; string name; }
                hashdecl Derived inherits Base { date created; }
                hash<Derived> sub get_derived() { return <Derived>{'id': 1, 'name': 'test', 'created': now()}; }
            ", "");
            hash h = p.callFunction("get_derived");
            assertEq(1, h.id);
            assertEq("test", h.name);
            assertEq(Type::Date, h.created.type());
        }

        # Test 15: Inheritance with optional types
        {
            hash<ExtendedInfo> ext = <ExtendedInfo>{
                "name": "optional_test",
                "id": 1,
                "created": now(),
            };
            # description is *string, so should be NOTHING by default
            assertEq(NOTHING, ext.description);
        }

        # Test 16: instanceof works correctly for inherited hashdecl
        {
            hash<ExtendedInfo> ext = <ExtendedInfo>{
                "name": "instanceof_test",
                "id": 1,
                "created": now(),
            };
            assertTrue(ext instanceof hash<ExtendedInfo>);
        }

        # Test 17: Hash keys include inherited members (keys() only returns non-NOTHING values)
        {
            hash<ExtendedInfo> ext = <ExtendedInfo>{
                "name": "keys_test",
                "id": 1,
                "created": now(),
                "description": "with_desc",
            };
            list<string> k = ext.keys();
            assertTrue(inlist("name", k));
            assertTrue(inlist("id", k));
            assertTrue(inlist("created", k));
            assertTrue(inlist("description", k));
        }

        # Test 18: Cast from untyped hash to derived hashdecl works
        {
            hash h = {"name": "cast_test", "id": 42, "created": now(), "description": "desc"};
            hash<ExtendedInfo> ext = cast<hash<ExtendedInfo>>(h);
            assertEq("cast_test", ext.name);
            assertEq(42, ext.id);
            assertEq("desc", ext.description);
        }

        # Test 19: Multiple independent inheritance chains
        {
            Program p(PO_NEW_STYLE);
            p.parse("
                hashdecl ChainA_Base { int a; }
                hashdecl ChainA_Derived inherits ChainA_Base { int b; }
                hashdecl ChainB_Base { string x; }
                hashdecl ChainB_Derived inherits ChainB_Base { string y; }
                list sub test() {
                    hash<ChainA_Derived> a = <ChainA_Derived>{'a': 1, 'b': 2};
                    hash<ChainB_Derived> b = <ChainB_Derived>{'x': 'hello', 'y': 'world'};
                    return (a, b);
                }
            ", "");
            list result = p.callFunction("test");
            assertEq(1, result[0].a);
            assertEq(2, result[0].b);
            assertEq("hello", result[1].x);
            assertEq("world", result[1].y);
        }

        # Test 20: Inheritance in imported hashdecl
        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);
            p.importHashDecl("BaseInfo");
            p.importHashDecl("ExtendedInfo");
            p.parse("
                hash<ExtendedInfo> sub get_ext() {
                    return <ExtendedInfo>{'name': 'imported', 'id': 999, 'created': now()};
                }
            ", "");
            hash h = p.callFunction("get_ext");
            assertEq("imported", h.name);
            assertEq(999, h.id);
        }

        # Test 21: Type compatibility - derived hashdecl assignable to base hashdecl variable
        {
            hash<ExtendedInfo> ext = <ExtendedInfo>{
                "name": "type_compat",
                "id": 42,
                "created": now(),
            };
            hash<BaseInfo> base = ext;  # derived -> base assignment
            assertEq("type_compat", base.name);
            assertEq(42, base.id);
        }

        # Test 22: Type compatibility - derived assignable to base in function parameter
        {
            Program p(PO_NEW_STYLE);
            p.parse("
                hashdecl Parent { int x; }
                hashdecl Child inherits Parent { int y; }
                int sub get_x(hash<Parent> p) { return p.x; }
                int sub test() {
                    hash<Child> c = <Child>{'x': 100, 'y': 200};
                    return get_x(c);
                }
            ", "");
            int result = p.callFunction("test");
            assertEq(100, result);
        }

        # Test 23: Type compatibility - deeply nested inheritance to base
        {
            hash<DeeplyNested> deep = <DeeplyNested>{
                "name": "deep_compat",
                "id": 99,
                "created": now(),
                "value": 1.5,
            };
            hash<BaseInfo> base = deep;  # 3-level derived -> base assignment
            assertEq("deep_compat", base.name);
            assertEq(99, base.id);
        }

        # Test 24: Type compatibility - return type covariance
        {
            Program p(PO_NEW_STYLE);
            p.parse("
                hashdecl Base { string name; }
                hashdecl Derived inherits Base { int id; }
                hash<Base> sub get_base() {
                    return <Derived>{'name': 'covariant', 'id': 123};
                }
            ", "");
            hash h = p.callFunction("get_base");
            assertEq("covariant", h.name);
        }

        # Test 25: Type compatibility in list of base type
        {
            Program p(PO_NEW_STYLE);
            p.parse("
                hashdecl Parent { int id; }
                hashdecl Child inherits Parent { string extra; }
                list<hash<Parent>> sub get_list() {
                    hash<Child> c = <Child>{'id': 1, 'extra': 'test'};
                    return (c,);
                }
            ", "");
            list l = p.callFunction("get_list");
            assertEq(1, l[0].id);
        }

        # Test 26: Reflection - getParentTypedHash() returns parent
        {
            Program p(PO_NEW_STYLE);
            p.loadModule("reflection");
            p.parse("
                hashdecl Base { int x; }
                hashdecl Derived inherits Base { int y; }
                *string sub test() {
                    TypedHash th = TypedHash::forName('Derived');
                    *TypedHash parent = th.getParentTypedHash();
                    return parent ? parent.getName() : NOTHING;
                }
            ", "");
            assertEq("Base", p.callFunction("test"));
        }

        # Test 27: Reflection - getParentTypedHash() returns NOTHING for no parent
        {
            Program p(PO_NEW_STYLE);
            p.loadModule("reflection");
            p.parse("
                hashdecl NoParent { int x; }
                bool sub test() {
                    TypedHash th = TypedHash::forName('NoParent');
                    return !exists th.getParentTypedHash();
                }
            ", "");
            assertTrue(p.callFunction("test"));
        }

        # Test 28: Reflection - inheritsFrom() returns true for descendant
        {
            Program p(PO_NEW_STYLE);
            p.loadModule("reflection");
            p.parse("
                hashdecl A { int a; }
                hashdecl B inherits A { int b; }
                hashdecl C inherits B { int c; }
                list sub test() {
                    TypedHash tha = TypedHash::forName('A');
                    TypedHash thb = TypedHash::forName('B');
                    TypedHash thc = TypedHash::forName('C');
                    return (
                        thb.inheritsFrom(tha),  # direct parent
                        thc.inheritsFrom(tha),  # grandparent
                        thc.inheritsFrom(thb),  # parent
                        tha.inheritsFrom(thb),  # reverse - should be false
                    );
                }
            ", "");
            list result = p.callFunction("test");
            assertTrue(result[0]);   # B inherits from A
            assertTrue(result[1]);   # C inherits from A (grandparent)
            assertTrue(result[2]);   # C inherits from B
            assertFalse(result[3]);  # A does NOT inherit from B
        }

        # Test 29: System hashdecl inheritance - DirStatInfo inherits StatInfo
        {
            Program p(PO_NEW_STYLE);
            p.loadModule("reflection");
            p.parse("
                list sub test() {
                    TypedHash dir = TypedHash::forName('DirStatInfo');
                    TypedHash stat = TypedHash::forName('StatInfo');
                    *TypedHash parent = dir.getParentTypedHash();
                    return (
                        parent ? parent.getName() : NOTHING,
                        dir.inheritsFrom(stat),
                    );
                }
            ", "");
            list result = p.callFunction("test");
            assertEq("StatInfo", result[0]);
            assertTrue(result[1]);
        }

        # Test 30: Import inherited hashdecls - tests parent pointer update after namespace copy
        # This test specifically verifies that when hashdecls are copied to a new namespace,
        # the parent pointer is correctly updated to avoid use-after-free bugs
        {
            # Create a Program that doesn't inherit user hashdecls automatically
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);

            # Import hashdecls with inheritance chain from the parent program
            # importHashDecl imports from the calling program's namespace
            p.importHashDecl("BaseInfo");
            p.importHashDecl("ExtendedInfo");
            p.importHashDecl("DeeplyNested");

            # Parse code that uses the imported hashdecls - this exercises parent member lookup
            p.parse("
                list sub test() {
                    hash<ExtendedInfo> ext({'name': 'test', 'id': 42, 'created': now()});
                    hash<DeeplyNested> deep({'name': 'deep', 'id': 99, 'created': now(), 'value': 3.14});
                    return (
                        ext.name,         # lookup from parent BaseInfo
                        ext.id,           # lookup from parent BaseInfo
                        exists ext.created, # local to ExtendedInfo
                        deep.name,        # lookup from grandparent BaseInfo
                        deep.id,          # lookup from grandparent BaseInfo
                        exists deep.created, # lookup from parent ExtendedInfo
                        deep.value,       # local to DeeplyNested
                    );
                }
            ", "test-prog");

            # Call the function to exercise the inheritance chain
            list result = p.callFunction("test");
            assertEq("test", result[0]);     # name from BaseInfo
            assertEq(42, result[1]);         # id from BaseInfo
            assertTrue(result[2]);           # created exists
            assertEq("deep", result[3]);     # name from grandparent BaseInfo
            assertEq(99, result[4]);         # id from grandparent BaseInfo
            assertTrue(result[5]);           # created from parent ExtendedInfo
            assertEq(3.14, result[6]);       # value local to DeeplyNested
        }

        # Test 31: Import namespaced inherited hashdecls - verifies namespace path handling
        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);

            # Import hashdecls from the InheritTest namespace
            p.importHashDecl("InheritTest::ParentDecl");
            p.importHashDecl("InheritTest::ChildDecl");

            p.parse("
                list sub test_inheritance() {
                    hash<InheritTest::ChildDecl> child();
                    return (
                        child.parent_id,    # inherited from ParentDecl
                        child.parent_name,  # inherited from ParentDecl
                        child.child_id,     # local
                        child.child_name,   # local
                    );
                }
            ", "test-prog-2");

            list result = p.callFunction("test_inheritance");
            assertEq(100, result[0]);       # parent_id default from ParentDecl
            assertEq("parent", result[1]);  # parent_name default from ParentDecl
            assertEq(200, result[2]);       # child_id default
            assertEq("child", result[3]);   # child_name default
        }

        # Test 32: Import inherited hashdecls with default values
        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);

            # Import hashdecls with default values inheritance chain
            p.importHashDecl("DefaultBase");
            p.importHashDecl("DefaultChild");

            p.parse("
                list sub test_defaults() {
                    hash<DefaultChild> d();
                    return (
                        d.base_str,     # inherited default
                        d.base_val,     # inherited default
                        d.child_str,    # local default
                        d.child_val,    # local default
                    );
                }
            ", "test-prog-3");

            list result = p.callFunction("test_defaults");
            assertEq("base_default", result[0]);  # inherited default
            assertEq(10, result[1]);              # inherited default
            assertEq("child_default", result[2]); # local default
            assertEq(20, result[3]);              # local default
        }

        # Test 33: Cross-namespace parent resolution in child Program
        # This test verifies that when a child Program is created, hashdecl parent
        # pointers are correctly resolved to point to the copies in the new namespace tree
        {
            # Create a child Program that inherits hashdecls
            Program p(PO_NEW_STYLE);

            # Parse code that uses the inherited hashdecls with cross-namespace parents
            p.parse("
                hash<ExtendedInfo> sub test_cross_ns() {
                    # ExtendedInfo inherits from BaseInfo
                    # After namespace copy, the parent pointer should be updated
                    return <ExtendedInfo>{
                        'name': 'cross_ns_test',
                        'id': 42,
                        'created': now(),
                    };
                }
            ", "cross-ns-test");

            hash result = p.callFunction("test_cross_ns");
            assertEq("cross_ns_test", result.name);  # inherited member
            assertEq(42, result.id);                  # inherited member
            assertEq(Type::Date, result.created.type());  # local member
        }

        # Test 34: Cross-namespace parent resolution with deeply nested inheritance in child Program
        {
            Program p(PO_NEW_STYLE);

            p.parse("
                hash<DeeplyNested> sub test_deep_cross_ns() {
                    # DeeplyNested inherits from ExtendedInfo which inherits from BaseInfo
                    return <DeeplyNested>{
                        'name': 'deep_cross_ns',
                        'id': 99,
                        'created': now(),
                        'value': 2.718,
                    };
                }
            ", "deep-cross-ns-test");

            hash result = p.callFunction("test_deep_cross_ns");
            assertEq("deep_cross_ns", result.name);   # grandparent member
            assertEq(99, result.id);                   # grandparent member
            assertEq(Type::Date, result.created.type()); # parent member
            assertEq(2.718, result.value);             # local member
        }

        # Test 35: Cross-namespace parent resolution with runtime importHashDecl
        # This tests that parent pointers are correctly resolved when importing
        # hashdecls one at a time at runtime
        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);

            # Import base first, then derived
            p.importHashDecl("BaseInfo");
            p.importHashDecl("ExtendedInfo");

            p.parse("
                list sub test_runtime_import() {
                    hash<ExtendedInfo> ext({'name': 'runtime_import', 'id': 123, 'created': now()});
                    return (
                        ext.name,   # should access inherited member
                        ext.id,     # should access inherited member
                    );
                }
            ", "runtime-import-test");

            list result = p.callFunction("test_runtime_import");
            assertEq("runtime_import", result[0]);
            assertEq(123, result[1]);
        }

        # Test 36: Cross-namespace parent resolution with importHashDecl - derived first
        # This tests a potential edge case where derived is imported before parent
        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);

            # Import derived first (parent doesn't exist yet in target)
            p.importHashDecl("ExtendedInfo");
            # Now import the parent
            p.importHashDecl("BaseInfo");

            p.parse("
                list sub test_reverse_import() {
                    hash<ExtendedInfo> ext({'name': 'reverse_import', 'id': 456, 'created': now()});
                    return (
                        ext.name,
                        ext.id,
                    );
                }
            ", "reverse-import-test");

            list result = p.callFunction("test_reverse_import");
            assertEq("reverse_import", result[0]);
            assertEq(456, result[1]);
        }

        # Test 37: Multiple sequential imports with parent resolution
        # Tests that importing hashdecls in batches correctly resolves parents
        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);

            # Import the full inheritance chain
            p.importHashDecl("BaseInfo");
            p.importHashDecl("ExtendedInfo");
            p.importHashDecl("DeeplyNested");

            p.parse("
                list sub test_batch_import() {
                    hash<DeeplyNested> deep({'name': 'batch', 'id': 777, 'created': now(), 'value': 1.23});
                    return (
                        deep.name,    # grandparent
                        deep.id,      # grandparent
                        deep.value,   # local
                    );
                }
            ", "batch-import-test");

            list result = p.callFunction("test_batch_import");
            assertEq("batch", result[0]);
            assertEq(777, result[1]);
            assertEq(1.23, result[2]);
        }

        # Test 38: Verify type compatibility works after cross-namespace resolution
        # Derived hashdecl should be assignable to base type after parent resolution
        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);

            p.importHashDecl("BaseInfo");
            p.importHashDecl("ExtendedInfo");

            p.parse("
                hash<BaseInfo> sub test_type_compat() {
                    hash<ExtendedInfo> ext({'name': 'compat', 'id': 888, 'created': now()});
                    # Assign derived to base - should work after parent resolution
                    return ext;
                }
            ", "type-compat-test");

            hash result = p.callFunction("test_type_compat");
            assertEq("compat", result.name);
            assertEq(888, result.id);
        }
    }

    testComplexTypeDefaults() {
        # Test that hashdecl with complex type defaults (list<T>, hash<K,V>) works
        # correctly when instantiated in a child Program.  This exercises the
        # mergeUserPublic() copy path where the default value node is shared
        # between two hashdecl copies.  Before the fix, acceptInputComplexList()
        # would steal a reference from the shared default, causing use-after-free.

        # Test 1: Direct instantiation
        {
            hash<ComplexDefaults> cd({"name": "test"});
            assertEq("test", cd.name);
            assertEq(0, cd.items.size());
            assertEq("list<string>", cd.items.fullType());
            assertEq(0, cd.numbers.size());
            assertEq("list<int>", cd.numbers.fullType());
            assertEq(0, cd.metadata.size());
        }

        # Test 2: Instantiation in a child Program (triggers mergeUserPublic copy)
        {
            Program p(PO_NEW_STYLE);
            p.parse("
                list sub test() {
                    hash<ComplexDefaults> cd({'name': 'child'});
                    return (cd.name, cd.items.size(), cd.numbers.size(), cd.metadata.size());
                }
            ", "complex-defaults-test");

            list result = p.callFunction("test");
            assertEq("child", result[0]);
            assertEq(0, result[1]);
            assertEq(0, result[2]);
            assertEq(0, result[3]);
        }

        # Test 3: Multiple instantiations in child Program
        {
            Program p(PO_NEW_STYLE);
            p.parse("
                list sub test() {
                    hash<ComplexDefaults> cd1({'name': 'first'});
                    hash<ComplexDefaults> cd2({'name': 'second'});
                    return (cd1.name, cd1.items.size(), cd2.name, cd2.items.size());
                }
            ", "complex-defaults-multi");

            list result = p.callFunction("test");
            assertEq("first", result[0]);
            assertEq(0, result[1]);
            assertEq("second", result[2]);
            assertEq(0, result[3]);
        }

        # Test 4: Imported hashdecl with complex defaults
        {
            Program p(PO_NEW_STYLE|PO_NO_INHERIT_USER_HASHDECLS);
            p.importHashDecl("ComplexDefaults");
            p.parse("
                list sub test() {
                    hash<ComplexDefaults> cd({'name': 'imported'});
                    return (cd.name, cd.items.size(), cd.numbers.size());
                }
            ", "complex-defaults-import");

            list result = p.callFunction("test");
            assertEq("imported", result[0]);
            assertEq(0, result[1]);
            assertEq(0, result[2]);
        }
    }

    testGenericContainerHashDeclFolding() {
        TypedHash th("RuntimeFoldExpression");

        auto src = {
            "one": {
                "code": 1,
                "name": "first",
            },
        };
        auto typed_map = map {
            $1.key: th.doCast($1.value)
        }, src.pairIterator();

        hash<RuntimeFoldContainer> c = <RuntimeFoldContainer>{
            "expressions": typed_map,
        };
        assertEq(True, c.expressions.one instanceof hash<RuntimeFoldExpression>);
        assertEq(1, c.expressions.one.code);
        assertEq("first", c.expressions.one.name);

        auto untyped_map = {
            "two": {
                "code": 2,
                "name": "second",
            },
        };
        hash<RuntimeFoldContainer> c2 = <RuntimeFoldContainer>{
            "expressions": untyped_map,
        };
        assertEq(True, c2.expressions.two instanceof hash<RuntimeFoldExpression>);
        assertEq(2, c2.expressions.two.code);

        auto typed_list = (
            th.doCast({
                "code": 3,
                "name": "third",
            }),
        );
        hash<RuntimeFoldContainer> c3 = <RuntimeFoldContainer>{
            "expression_list": typed_list,
        };
        assertEq(True, c3.expression_list[0] instanceof hash<RuntimeFoldExpression>);
        assertEq("third", c3.expression_list[0].name);

        auto bad_map = {
            "bad": {
                "code": "not an int",
                "name": "bad",
            },
        };
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            hash<RuntimeFoldContainer> bad = <RuntimeFoldContainer>{
                "expressions": bad_map,
            };
            delete bad;
        });
    }

    #! Container folding must not depend on whether the source values happen to share a type
    /** The fold path adopts generically-typed data -- a hash literal, a parsed JSON document -- into
        a declared structure, so what makes a source element eligible is its shape, not its value
        type.  Restricting eligibility to hash<auto>/list<auto> sources made acceptance turn on an
        accident of inference: {"value": 1, "format": "a"} infers hash<auto> and was folded, while
        the equally valid {"value": "x", "format": "a"} infers hash<string, string> and was rejected
        outright, before any field was examined, purely because both of its values were strings.

        Every case goes through auto_value() so that the container check happens at runtime; a fully
        resolved initializer is diagnosed at parse time by a different path.
    */
    testHomogeneousContainerHashDeclFolding() {
        # the regression itself: homogeneous and heterogeneous initializers must fold alike
        hash<FoldListParent> homogeneous = new hash<FoldListParent>(auto_value({
            "parts": ({"value": "hello", "format": "content:a"},),
        }));
        assertEq(True, homogeneous.parts[0] instanceof hash<FoldLeaf>, "all-string list child folded");
        assertEq("hello", homogeneous.parts[0].value, "all-string child value");
        assertEq("content:a", homogeneous.parts[0].format, "all-string child format");

        hash<FoldListParent> heterogeneous = new hash<FoldListParent>(auto_value({
            "parts": ({"value": 1, "format": "content:a"},),
        }));
        assertEq(True, heterogeneous.parts[0] instanceof hash<FoldLeaf>, "mixed-type list child folded");
        assertEq(1, heterogeneous.parts[0].value, "mixed-type child value");

        # a single-key child is homogeneous by construction
        hash<FoldListParent> single = new hash<FoldListParent>(auto_value({
            "parts": ({"value": "only"},),
        }));
        assertEq(True, single.parts[0] instanceof hash<FoldLeaf>, "single-key list child folded");
        assertEq(NOTHING, single.parts[0].format, "omitted optional field stays unset");

        # the same gate governs hash containers, not just lists
        hash<FoldHashParent> hash_container = new hash<FoldHashParent>(auto_value({
            "parts": {"a": {"value": "hello", "format": "content:a"}},
        }));
        assertEq(True, hash_container.parts.a instanceof hash<FoldLeaf>, "all-string hash child folded");
        assertEq("hello", hash_container.parts.a.value, "all-string hash child value");

        # recursive element types fold at every level
        hash<FoldTree> tree = new hash<FoldTree>(auto_value({
            "value": "a",
            "format": "f",
            "parts": ({
                "value": "b",
                "format": "g",
                "parts": ({"value": "c", "format": "h"},),
            },),
        }));
        assertEq(True, tree.parts[0] instanceof hash<FoldTree>, "recursive child folded");
        assertEq(True, tree.parts[0].parts[0] instanceof hash<FoldTree>, "recursive grandchild folded");
        assertEq("c", tree.parts[0].parts[0].value, "recursive grandchild value");
        assertEq(NOTHING, tree.parts[0].parts[0].parts, "omitted optional recursive field stays unset");

        # empty containers: nothing to fold, but the container must still be accepted and retyped
        list<auto> empty_list();
        hash<auto> empty_hash();
        hash<FoldListParent> empty_parts = new hash<FoldListParent>(auto_value({"parts": empty_list}));
        assertEq((), empty_parts.parts, "empty list container accepted");
        hash<FoldHashParent> empty_map = new hash<FoldHashParent>(auto_value({"parts": empty_hash}));
        assertEq({}, empty_map.parts, "empty hash container accepted");
        hash<FoldListParent> empty_child = new hash<FoldListParent>(auto_value({"parts": (empty_hash,)}));
        assertEq(True, empty_child.parts[0] instanceof hash<FoldLeaf>, "empty child hash folded");

        # an incompatible field value is still rejected, and the error names the offending key
        assertThrows("RUNTIME-TYPE-ERROR", "key 'format' expects type '\\*string'", sub () {
            hash<FoldListParent> bad = new hash<FoldListParent>(auto_value({
                "parts": ({"value": "x", "format": 1},),
            }));
            delete bad;
        }, NOTHING, "incompatible field value rejected in a list container");

        assertThrows("RUNTIME-TYPE-ERROR", "key 'format' expects type '\\*string'", sub () {
            hash<FoldHashParent> bad = new hash<FoldHashParent>(auto_value({
                "parts": {"a": {"value": "x", "format": 1}},
            }));
            delete bad;
        }, NOTHING, "incompatible field value rejected in a hash container");

        # ... as is an unknown field, exactly as in direct construction
        assertThrows("HASHDECL-INIT-ERROR", "unknown key 'bogus'", sub () {
            hash<FoldListParent> bad = new hash<FoldListParent>(auto_value({
                "parts": ({"value": "x", "bogus": "y"},),
            }));
            delete bad;
        }, NOTHING, "unknown field rejected in a folded child");

        # folding eligibility must not reach scalar element types
        assertThrows("RUNTIME-TYPE-ERROR", NOTHING, sub () {
            hash<FoldScalarParent> bad = new hash<FoldScalarParent>(auto_value({
                "numbers": ("a", "b"),
            }));
            delete bad;
        }, NOTHING, "string elements rejected for a list<int> field");

        # the source must survive both outcomes unchanged, whether or not it is shared
        hash<auto> shared_ok = {"parts": ({"value": "hello", "format": "content:a"},)};
        hash<auto> shared_ok_before = shared_ok;
        hash<FoldListParent> from_shared = new hash<FoldListParent>(auto_value(shared_ok));
        assertEq("hello", from_shared.parts[0].value, "shared source folded");
        assertEq(shared_ok_before, shared_ok, "shared source unchanged after a successful fold");
        assertEq("hash<FoldLeaf>", from_shared.parts[0].fullType(), "folded child carries the declared type");
        assertEq("hash<string, string>", shared_ok.parts[0].fullType(),
            "shared source child not retyped in place");

        hash<auto> shared_bad = {"parts": ({"value": "x", "format": 1},)};
        hash<auto> shared_bad_before = shared_bad;
        assertThrows("RUNTIME-TYPE-ERROR", NOTHING, sub () {
            hash<FoldListParent> bad = new hash<FoldListParent>(auto_value(shared_bad));
            delete bad;
        }, NOTHING, "shared source with an invalid field rejected");
        assertEq(shared_bad_before, shared_bad, "shared source unchanged after a failed fold");

        # an unshared source reaches the in-place branch of the fold loops
        hash<FoldListParent> from_unshared = new hash<FoldListParent>(auto_value(
            {"parts": ({"value": "hello", "format": "content:a"},)}
        ));
        assertEq("hello", from_unshared.parts[0].value, "unshared source folded");

        # a fully resolved initializer takes the parse-time path rather than the runtime gate
        # above; it must reach the same verdict, recursively as well
        hash<FoldListParent> resolved = new hash<FoldListParent>({
            "parts": ({"value": "hello", "format": "content:a"},),
        });
        assertEq("hello", resolved.parts[0].value, "fully resolved initializer folded");
        hash<FoldTree> resolved_tree = new hash<FoldTree>({
            "value": "a",
            "parts": ({"value": "b", "format": "g"},),
        });
        assertEq("b", resolved_tree.parts[0].value, "fully resolved recursive initializer folded");

        # the parse-time check defers to the runtime gate only where the fold could actually
        # convert the value; a scalar element type is still rejected outright
        Program scalar_pgm(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", "incompatible value type 'list<string>'", \scalar_pgm.parse(), (
            'hashdecl ParseScalar { list<int> numbers; }
             sub t() { ParseScalar s = new hash<ParseScalar>({"numbers": ("a", "b")}); delete s; }', ""),
            "scalar element type still rejected at parse time");

        # ... and one declared structure is still not reinterpreted as another
        Program hashdecl_pgm(PO_NEW_STYLE);
        hashdecl_pgm.parse(
            'hashdecl ParseA { int i; }
             hashdecl ParseB { int i; }
             hashdecl ParseBC { list<hash<ParseB>> items; }
             auto sub t() {
                 list<hash<ParseA>> la = (new hash<ParseA>({"i": 1}),);
                 return new hash<ParseBC>({"items": la});
             }', "");
        assertThrows("RUNTIME-TYPE-ERROR", "expects type 'list<hash<ParseB>>'", \hashdecl_pgm.callFunction(), "t",
            "hashdecl source not folded into a different hashdecl");

%ifndef NoJson
        # JSON-derived values are the motivating case: every leaf of this document is a string
        hash<FoldTree> from_json = new hash<FoldTree>(auto_value(parse_json(
            '{"value": "a", "format": "f", "parts": [{"value": "b", "format": "g"}]}'
        )));
        assertEq(True, from_json.parts[0] instanceof hash<FoldTree>, "JSON-derived child folded");
        assertEq("b", from_json.parts[0].value, "JSON-derived child value");
%endif
    }

    #! The parse-time verdict on a foldable container must match what the runtime does with it
    /** The fold loops in QoreTypeSpec::acceptInputComplexHash()/acceptInputComplexList() convert a
        container element by element for every container assignment, so a value whose element type the
        fold path can convert is accepted at runtime.  The parse-time checks and runtime variant
        selection must reach that same verdict, or acceptance turns on whether the value's type happened
        to be known statically: the identical literal was a parse error where it was written out and
        folded silently where it arrived through an "auto" expression, and an argument the parser
        accepted was then refused by overload resolution before binding could convert it.

        Every positive case here is written as a resolved literal, so it is decided at parse time, and
        paired with the same value routed through auto_value() so that both paths are compared
        directly.  See design/container-element-folding.md.
    */
    testContainerFoldingParseRuntimeAgreement() {
        # a declared container initialized from an ordinary literal: the parse-time path
        list<hash<FoldLeaf>> parts = ({"value": "hello", "format": "content:a"},);
        assertEq(True, parts[0] instanceof hash<FoldLeaf>, "literal list child folded at parse time");
        assertEq("hello", parts[0].value, "literal list child value");
        assertEq("list<hash<FoldLeaf>>", parts.fullType(), "folded list carries the declared type");

        # ... and the same value through the runtime gate must agree, element type included
        list<hash<FoldLeaf>> runtime_parts = auto_value(({"value": "hello", "format": "content:a"},));
        assertEq(parts, runtime_parts, "parse-time and runtime paths produce the same value");
        assertEq(parts.fullType(), runtime_parts.fullType(), "both paths produce the same type");

        # ... and a literal whose values do not share a type, which infers a different element type,
        # takes the same path
        list<hash<FoldLeaf>> mixed = ({"value": 1, "format": "content:a"},);
        assertEq(1, mixed[0].value, "heterogeneous literal folded at parse time");

        # assignment to an already declared variable takes the same path as the declaration
        parts = ({"value": "assigned"},);
        assertEq("assigned", parts[0].value, "literal assigned to a declared container");
        assertEq(True, parts[0] instanceof hash<FoldLeaf>, "assigned literal child folded");

        # the complex-hash gate, not just the list one
        hash<string, hash<FoldLeaf>> keyed = {"a": {"value": "hello", "format": "content:a"}};
        assertEq(True, keyed.a instanceof hash<FoldLeaf>, "literal hash child folded at parse time");
        assertEq(keyed, cast<hash<string, hash<FoldLeaf>>>(auto_value({"a": {"value": "hello",
            "format": "content:a"}})), "hash container agrees with the runtime path");

        # nested and recursive element types fold at every level
        list<list<hash<FoldLeaf>>> nested = (({"value": "deep"},),);
        assertEq(True, nested[0][0] instanceof hash<FoldLeaf>, "nested list child folded");
        hash<FoldTree> tree = new hash<FoldTree>({
            "value": "a",
            "parts": ({"value": "b", "parts": ({"value": "c"},)},),
        });
        assertEq("c", tree.parts[0].parts[0].value, "recursive literal folded at parse time");

        # empty containers have nothing to convert but must still be accepted and retyped
        list<hash<FoldLeaf>> empty_parts = ();
        assertEq((), empty_parts, "empty list literal accepted");
        hash<string, hash<FoldLeaf>> empty_map = {};
        assertEq({}, empty_map, "empty hash literal accepted");

        # argument binding: the parser accepts these, so variant selection must find them too
        assertEq("hello", fold_list_arg(({"value": "hello", "format": "content:a"},))[0].value,
            "literal bound to a declared list parameter");
        assertEq(True, fold_list_arg(({"value": "hello"},))[0] instanceof hash<FoldLeaf>,
            "bound list parameter carries the declared element type");
        assertEq("hello", fold_hash_arg({"a": {"value": "hello"}}).a.value,
            "literal bound to a declared hash parameter");
        assertEq("hello", fold_list_arg(auto_value(({"value": "hello"},)))[0].value,
            "runtime argument reaches the same variant");

        # the same in method position
        FoldMemberHolder holder();
        assertEq("hello", holder.take(({"value": "hello"},))[0].value,
            "literal bound to a declared method parameter");

        # member initializers are resolved at parse time as well
        assertEq("member", holder.parts[0].value, "member initializer literal folded");
        assertEq(True, holder.parts[0] instanceof hash<FoldLeaf>, "member initializer child folded");
        assertEq("member-map", holder.member_map.a.value, "hash member initializer literal folded");

        # ... as are return values
        assertEq("returned", fold_list_return()[0].value, "returned literal folded");
        assertEq(True, fold_list_return()[0] instanceof hash<FoldLeaf>, "returned child folded");

        # a source that needs no conversion must still outrank one that does, so admitting foldable
        # containers to variant matching cannot change which variant an existing call selects
        assertEq("exact", fold_overload(({"value": "x", "format": "f"},)),
            "an exactly matching variant wins over a folded one");
        assertEq("folded", fold_only_overload(({"value": 1, "format": "f"},)),
            "the folded variant is selected when it is the only candidate");
        assertEq("string", fold_only_overload("x"), "the other variant is still reachable");

        # binding must not retype or otherwise disturb the caller's value
        list<hash<string, string>> source = ({"value": "hello", "format": "content:a"},);
        list<hash<string, string>> source_before = source;
        assertEq("hello", fold_list_arg(source)[0].value, "declared source bound by folding");
        assertEq(source_before, source, "bound source unchanged");
        assertEq("list<hash<string, string>>", source.fullType(), "bound source not retyped in place");

        # an invalid field value is reported against the key, at runtime, from either path
        Program bad_value_pgm(PO_NEW_STYLE);
        bad_value_pgm.parse('hashdecl PLeaf { auto value; *string format; }
            auto sub t() { list<hash<PLeaf>> l = ({"value": "x", "format": 1},); return l; }', "");
        assertThrows("RUNTIME-TYPE-ERROR", "key \'format\' expects type \'\\*string\'",
            \bad_value_pgm.callFunction(), "t", "resolved literal with an invalid field value rejected");

        # ... and so is an unknown field
        Program unknown_key_pgm(PO_NEW_STYLE);
        unknown_key_pgm.parse('hashdecl PLeaf { auto value; *string format; }
            auto sub t() { list<hash<PLeaf>> l = ({"value": "x", "bogus": "y"},); return l; }', "");
        assertThrows("HASHDECL-INIT-ERROR", "unknown key \'bogus\'", \unknown_key_pgm.callFunction(), "t",
            "resolved literal with an unknown field rejected");

        # a scalar element type cannot fold, so it is still rejected outright at parse time
        Program scalar_pgm(PO_NEW_STYLE);
        assertThrows("PARSE-TYPE-ERROR", "expects list<int>", \scalar_pgm.parse(), (
            'sub t() { list<int> l = ("a", "b"); delete l; }', ""),
            "scalar element type still rejected at parse time");

        # one declared structure is still not reinterpreted as another
        Program hashdecl_pgm(PO_NEW_STYLE);
        assertThrows("PARSE-TYPE-ERROR", "expects list<hash<PB>>", \hashdecl_pgm.parse(), (
            'hashdecl PA { int i; }
             hashdecl PB { int i; }
             sub t() { list<hash<PB>> l = (new hash<PA>({"i": 1}),); delete l; }', ""),
            "hashdecl source still rejected at parse time");

        # a soft list folds the elements of a list it is given ...
        softlist<hash<FoldLeaf>> soft = ({"value": "soft"},);
        assertEq(True, soft[0] instanceof hash<FoldLeaf>, "soft list folds a list literal");
        assertEq("soft", fold_softlist_arg(({"value": "soft"},))[0].value,
            "soft list parameter folds a list literal");

        # ... but wrapping a single value into a one-element list is not a fold: nothing converts that
        # value, so it is refused by both paths rather than accepted at parse time and refused on
        # assignment
        Program soft_pgm(PO_NEW_STYLE);
        assertThrows("PARSE-TYPE-ERROR", "expects softlist<hash<PLeaf>>", \soft_pgm.parse(), (
            'hashdecl PLeaf { auto value; *string format; }
             sub t() { softlist<hash<PLeaf>> s = {"value": "x"}; delete s; }', ""),
            "single hash not wrapped into a soft list of hashdecls at parse time");
        assertThrows("RUNTIME-TYPE-ERROR", "softlist<hash<FoldLeaf>>", sub () {
            softlist<hash<FoldLeaf>> bad = auto_value({"value": "x"});
            delete bad;
        }, NOTHING, "single hash not wrapped into a soft list of hashdecls at runtime");

        # a plain hash assigned directly to a hashdecl lvalue is not a container fold, and is refused
        # by both paths
        Program direct_pgm(PO_NEW_STYLE);
        assertThrows("PARSE-TYPE-ERROR", "expects hash<PLeaf>", \direct_pgm.parse(), (
            'hashdecl PLeaf { auto value; *string format; }
             sub t() { hash<PLeaf> h = {"value": "x", "format": "f"}; delete h; }', ""),
            "plain hash still not assignable to a hashdecl lvalue at parse time");
        assertThrows("RUNTIME-TYPE-ERROR", "hash<FoldLeaf>", sub () {
            hash<FoldLeaf> bad = auto_value({"value": "x", "format": "f"});
            delete bad;
        }, NOTHING, "plain hash still not assignable to a hashdecl lvalue at runtime");
    }

    testTypedHashCastWithOverrides() {
        TypedHash th("Container");
        hash<auto> h = th.doCastWithOverrides({
            "i": 2,
            "str": "base",
            "n": 1.5,
        }, {
            "i": 9,
        });
        assertEq(True, h instanceof hash<Container>);
        assertEq(9, h.i);
        assertEq("base", h.str);
        assertEq(1.5n, h.n);
        assertEq(th.doCast({
            "i": 2,
            "str": "base",
            "n": 1.5,
        } + {
            "i": 9,
        }), h);

        hash<auto> defaults = th.doCastWithOverrides({
            "n": 2.5,
        }, {
            "i": 7,
        });
        assertEq(7, defaults.i);
        assertEq("hi", defaults.str);
        assertEq(2.5n, defaults.n);

        TypedHash optional("OverrideCastInfo");
        hash<auto> assigned_nothing = optional.doCastWithOverrides({}, {
            "value": NOTHING,
        });
        hash<auto> merged_nothing = optional.doCast({} + {
            "value": NOTHING,
        });
        assertEq(merged_nothing, assigned_nothing);
        assertEq(False, exists assigned_nothing.value);
        assertEq(NOTHING, assigned_nothing.value);

        TypedHash inherited("ExtendedInfo");
        hash<auto> extended = inherited.doCastWithOverrides({
            "name": "base",
            "id": 1,
            "created": 2026-07-23,
        }, {
            "name": "override",
            "description": "set",
        });
        assertEq("override", extended.name);
        assertEq(1, extended.id);
        assertEq(2026-07-23, extended.created);
        assertEq("set", extended.description);

        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            th.doCastWithOverrides({"n": 1.0}, {"i": "invalid"});
        });
        assertThrows("HASHDECL-INIT-ERROR", sub () {
            th.doCastWithOverrides({"n": 1.0, "unknown": 1}, {});
        });
        assertThrows("HASHDECL-INIT-ERROR", sub () {
            th.doCastWithOverrides({"n": 1.0}, {"unknown": 1});
        });
    }
}
