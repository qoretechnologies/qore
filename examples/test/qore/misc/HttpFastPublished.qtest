#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class HttpFastPublishedTest

#! Runs the native test of HttpFastPublished, the lock-free publication of the state of the HTTP fast routes
/** The async I/O threads read the routes, the listener's context and the responses of a fast route without a lock
    or a wait; the code that changes them runs on other threads.  The native test (qore-http-fast-published-test, next
    to the qore binary) checks that readers get consistent values while writers replace them, that replaced values
    are freed, that more reading threads than hazard slots still read correct values, and that a thread gives its
    slot back when it ends.  It has no dependency on libqore, so it can be built with a thread or address sanitizer
    (see the comment in http_fast_published.cpp).
*/
class HttpFastPublishedTest inherits QUnit::Test {
    constructor() : QUnit::Test("HttpFastPublishedTest", "1.0", \ARGV) {
        addTestCase("native test of HttpFastPublished", \testNative());
        set_return_value(main());
    }

    testNative() {
        # the executable is built next to the qore binary of the build; the test may run with another qore binary (an
        # installed one), so the directory of every binary that is known is searched, in order
        string native;
        if (ENV.QORE_HTTP_FAST_PUBLISHED_TEST) {
            native = ENV.QORE_HTTP_FAST_PUBLISHED_TEST;
        } else {
            foreach *string exe in (ENV.QORE_DEBUG_BINARY, ENV.QORE_BINARY, ENV.QORE_EXECUTABLE, QORE_ARGV[0]) {
                if (!exe) {
                    continue;
                }
                string candidate = dirname(exe) + "/qore-http-fast-published-test";
                if (is_executable(candidate)) {
                    native = candidate;
                    break;
                }
            }
        }
        if (!native || !is_file(native)) {
            testSkip("the native test executable is not available");
            return;
        }
        int rc;
        string output = backquote("'" + replace(native, "'", "'\\''") + "' 2>&1", \rc);
        assertEq(0, rc, output);
        assertTrue(output.startsWith("PASS: "), output);
    }
}
