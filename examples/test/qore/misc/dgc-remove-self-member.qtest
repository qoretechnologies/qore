#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class DgcRemoveSelfMemberTest

#! Holds a peer that holds it back: the two form a recursive set
class Holder {
    public {
        *Peer peer;
    }
}

#! Breaks the cycle by removing its own member with "remove", or with an assignment
class Peer {
    public {
        *Holder holder;
        auto box;
        static int destroyed = 0;
    }

    destructor() {
        ++Peer::destroyed;
    }

    string name() {
        return "peer";
    }

    removeHolder() {
        remove holder;
    }

    assignHolder() {
        holder = NOTHING;
    }

    removeBox() {
        remove box;
    }
}

#! A removal of a member of self repairs the recursive sets before the removed value is released (#6329)
/** A holder and a peer reference each other; the peer is also referenced from C++ (dbg_object_external_ref()), as the
    async I/O controller holds a poll operation.  The peer breaks the cycle in a method, and the C++ reference is
    released: the peer, still referenced by the holder, must not be collected.  The removal of a member of self with
    "remove" left the recursive set stale, and the peer was collected (OBJECT-ALREADY-DELETED) in every execution
    mode; an assignment, and a removal through another object, repaired it.
*/
class DgcRemoveSelfMemberTest inherits QUnit::Test {
    constructor() : QUnit::Test("DgcRemoveSelfMemberTest", "1.0") {
        addTestCase("remove of a member of self", sub () { runCase("remove"); });
        addTestCase("assignment to a member of self", sub () { runCase("assign"); });
        addTestCase("remove through another object", sub () { runCase("outside"); });
        addTestCase("remove of a member of self that holds the cycle's object in a list", \listCase());
        set_return_value(main());
    }

    private requireDebug() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("needs a debug build (dbg_object_external_ref())");
        }
    }

    private runCase(string how) {
        requireDebug();
        int destroyed = Peer::destroyed;
        Holder h();
        int ext;
        {
            Peer p();
            h.peer = p;
            p.holder = h;
            ext = call_function("dbg_object_external_ref", p);
        }
        switch (how) {
            case "remove": h.peer.removeHolder(); break;
            case "assign": h.peer.assignHolder(); break;
            case "outside": remove h.peer.holder; break;
        }
        call_function("dbg_object_external_deref", ext);
        assertEq(destroyed, Peer::destroyed, how + ": the referenced peer was not collected");
        string name;
        try {
            name = h.peer.name();
        } catch (hash<ExceptionInfo> ex) {
            name = ex.err;
        }
        assertEq("peer", name, how + ": the peer is usable");
        # the holder is still referenced by this frame only
        delete h;
        assertEq(destroyed + 1, Peer::destroyed, how + ": the peer is collected once the holder is released");
    }

    listCase() {
        requireDebug();
        int destroyed = Peer::destroyed;
        Holder h();
        int ext;
        {
            Peer p();
            h.peer = p;
            # the cycle runs through a list held by the peer
            p.box = (h,);
            ext = call_function("dbg_object_external_ref", p);
        }
        h.peer.removeBox();
        call_function("dbg_object_external_deref", ext);
        assertEq(destroyed, Peer::destroyed, "the referenced peer was not collected");
        assertEq("peer", h.peer.name());
    }
}
