#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own --exec-mode and in qcc executables
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../TestInterpreter.qm

%exec-class AllocFailureTest

#! Memory that cannot be allocated fails the operation that needed it with a catchable exception, and the process goes
#! on (issue #7466)
/** The allocation fails with dbg_fail_allocation() (debug builds only) in the storage of a string or a list.  Before
    the fix, the storage was replaced with a null pointer and the process ended with SIGSEGV, or the std::bad_alloc of
    the allocation ended it with std::terminate(); in the IR, JIT and tiered modes and in code compiled with qcc, an
    operation of the code itself (not of builtin code) ended the process with std::terminate() until the call of the
    code failed with the exception.  The scenarios run in child processes in each execution mode and compiled with
    qcc.
*/
class AllocFailureTest inherits QUnit::Test {
    public {
        #! the scenarios of the child and what each prints
        const Scenarios = {
            "builtin": "caught MEMORY-ALLOCATION-ERROR\nagain: 100000\n",
            # an operation of compiled code itself fails the call, which the caller catches
            "compiled": "list: caught MEMORY-ALLOCATION-ERROR\nlist: again: 100000\n"
                "string: caught MEMORY-ALLOCATION-ERROR\nstring: again: 100000\n"
                "closure-local: caught MEMORY-ALLOCATION-ERROR\nclosure-local: again: 100000\n"
                "nested: caught MEMORY-ALLOCATION-ERROR\nnested: again: 100000\n"
                "method: caught MEMORY-ALLOCATION-ERROR\nmethod: again: 100000\n"
                "caller local: caller\n",
            "callback": "caught MEMORY-ALLOCATION-ERROR\nagain: 10\n",
            "thread": "caught MEMORY-ALLOCATION-ERROR\nagain: 100000\n",
            "server": "ping: 200 pong\nfail: 503 MEMORY-ALLOCATION-ERROR\nping: 200 pong\n"
                "fail-uncaught: 500 MEMORY-ALLOCATION-ERROR\nping: 200 pong\n",
        };

        const Modes = ("ast", "ir", "jit", "tiered");

        #! the scenarios of an allocation of native code that no runtime helper handles
        const UnhandledScenarios = ("unhandled-direct", "unhandled-nested");

        #! what such a scenario prints when the call fails with the exception
        const UnhandledCaught = "caught MEMORY-ALLOCATION-ERROR\nagain: 100000\n";
    }

    private {
        string child = get_script_dir() + "/alloc-failure-child.q";
        FsUtil::TmpDir tmp("alloc-failure-");

        #! the child compiled with qcc for each optimization level, once compiled
        hash<string, string> exes;
    }

    constructor() : Test("AllocFailureTest", "1.0") {
        addTestCase("operations that fail for lack of memory", \operationTest());
        addTestCase("a statement that fails for lack of memory", \statementTest());
        addTestCase("compiled code", \compiledTest());
        addTestCase("allocations of native code that no runtime helper handles", \unhandledTest());
        set_return_value(main());
    }

    operationTest() {
        checkDebug();
        foreach string mode in (Modes) {
            foreach hash<auto> s in (Scenarios.pairIterator()) {
                hash<auto> r = run(sprintf("%s %s", interpreter(mode), s.key));
                assertEq(0, r.rc, sprintf("%s, %s: the process goes on: %s", mode, s.key, r.out));
                assertEq(s.value, r.out, sprintf("%s, %s", mode, s.key));
            }
        }
    }

    #! the operation fails with the exception, which the try block around it in the same function catches: in the AST
    #! interpreter the statement, in the other modes and in compiled code the runtime helper of the operation
    statementTest() {
        checkDebug();
        list<hash<auto>> runs;
        foreach string mode in (Modes) {
            runs += {"name": mode, "cmd": interpreter(mode)};
        }
        *string qcc = TestInterpreter::qcc_compiler();
        if (qcc) {
            foreach int opt in ((0, 3)) {
                *string exe = compiledChild(qcc, opt);
                if (exe) {
                    runs += {"name": sprintf("qcc -O%d", opt), "cmd": quote(exe)};
                }
            }
        }
        foreach hash<auto> c in (runs) {
            hash<auto> r = run(sprintf("%s statement", c.cmd), True);
            assertEq(0, r.rc, sprintf("%s: the process goes on: %s", c.name, r.out));
            assertEq("caught MEMORY-ALLOCATION-ERROR\nlist: True\ncaught MEMORY-ALLOCATION-ERROR\nstring: True\n"
                "again: 100000\n", r.out, c.name);
        }
    }

    compiledTest() {
        checkDebug();
        *string qcc = TestInterpreter::qcc_compiler();
        if (!qcc) {
            testSkip("no qcc");
        }
        foreach int opt in ((0, 3)) {
            *string exe = compiledChild(qcc, opt);
            if (!exe) {
                continue;
            }
            foreach hash<auto> s in (Scenarios.pairIterator()) {
                hash<auto> r = run(sprintf("%s %s", quote(exe), s.key));
                assertEq(0, r.rc, sprintf("qcc -O%d, %s: the process goes on: %s", opt, s.key, r.out));
                assertEq(s.value, r.out, sprintf("qcc -O%d, %s", opt, s.key));
            }
        }
    }

    #! the call fails with the exception, which the caller catches, or the process ends with the message of the
    #! terminate handler (SIGABRT), when frames of native code were left; never with another signal or an assertion
    unhandledTest() {
        checkDebug();
        list<hash<auto>> runs;
        foreach string mode in (Modes) {
            runs += {"name": mode, "cmd": interpreter(mode)};
        }
        *string qcc = TestInterpreter::qcc_compiler();
        if (qcc) {
            foreach int opt in ((0, 3)) {
                *string exe = compiledChild(qcc, opt);
                if (exe) {
                    runs += {"name": sprintf("qcc -O%d", opt), "cmd": quote(exe)};
                }
            }
        }
        foreach hash<auto> c in (runs) {
            foreach string scenario in (UnhandledScenarios) {
                string name = sprintf("%s, %s", c.name, scenario);
                hash<auto> r = run(sprintf("%s %s", c.cmd, scenario), True);
                if (!r.rc) {
                    assertEq(UnhandledCaught, r.out, name);
                } else {
                    assertEq(134, r.rc, sprintf("%s: SIGABRT: %s", name, r.out));
                    assertRegex("qore: MEMORY-ALLOCATION-ERROR: memory could not be allocated in code that cannot "
                        "fail", r.out, name);
                    assertNRegex("Assertion|Segmentation", r.out, name);
                }
            }
        }
    }

    #! returns the child compiled with qcc at the given optimization level, compiled once, or nothing if it could not
    #! be compiled
    private *string compiledChild(string qcc, int opt) {
        string key = opt.toString();
        if (exes{key}) {
            return exes{key};
        }
        string exe = sprintf("%s/child-O%d", tmp.path, opt);
        hash<auto> c = run(sprintf("%s -O%d -o %s %s", quote(qcc), opt, quote(exe), quote(child)), True);
        assertEq(0, c.rc, sprintf("qcc -O%d: %s", opt, c.out));
        if (c.rc) {
            return;
        }
        return exes{key} = exe;
    }

    private string interpreter(string mode) {
        string opts = mode == "tiered" ? "--exec-mode=tiered --jit-ir-threshold=3 --jit-jit-threshold=10"
            : "--exec-mode=" + mode;
        return sprintf("%s %s %s", quote(TestInterpreter::qore_interpreter()), opts, quote(child));
    }

    private static string quote(string s) {
        return "'" + replace(s, "'", "'\\''") + "'";
    }

    #! runs the command with no core dump: a child that ends with std::terminate() would dump core
    private hash<auto> run(string cmd, *bool with_stderr) {
        int rc;
        string out = backquote(sprintf("ulimit -c 0; %s%s", cmd, with_stderr ? " 2>&1" : " 2>/dev/null"), \rc);
        return {"rc": rc, "out": out};
    }

    private checkDebug() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_fail_allocation() is only in debug builds of the library");
        }
    }
}
