#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class GenericClassTypesTest

class SourceGenericBox<T> {
    private {
        T value;
    }

    constructor(T value) {
        self.value = value;
    }

    T get() {
        return self.value;
    }

    T echo(T value) {
        return value;
    }

    T localCopy(auto value) {
        T local = value;
        return local;
    }

    nothing set(T value) {
        self.value = value;
    }

    nothing setAny(auto value) {
        self.value = value;
    }

    list<T> asList(T value) {
        return (value,);
    }
}

class SourceGenericPair<K, V> {
    private {
        K key;
        V value;
    }

    constructor(K key, V value) {
        self.key = key;
        self.value = value;
    }

    K getKey() {
        return self.key;
    }

    V getValue() {
        return self.value;
    }
}

class SourceGenericOverloads<T> {
    string take(T value) {
        return "scalar";
    }

    string take(list<T> value) {
        return "list";
    }
}

class SourceGenericBase<T> {
    T echo(T value) {
        return value;
    }

    list<T> asList(T value) {
        return (value,);
    }
}

class SourceGenericChild<T> inherits SourceGenericBase<T> {
}

class SourceFixedBaseChild<T> inherits SourceGenericBase<string> {
}

class SourceTypedIterator<T> inherits AbstractIterator<T> {
    private {
        T value;
        bool available;
        bool valid_flag;
    }

    constructor(T value) {
        self.value = value;
        self.available = True;
    }

    bool next() {
        if (!self.available) {
            self.valid_flag = False;
            return False;
        }

        self.available = False;
        self.valid_flag = True;
        return True;
    }

    T getValue() {
        if (!self.valid_flag) {
            throw "INVALID-ITERATOR", "iterator is not valid";
        }
        return self.value;
    }

    bool valid() {
        return self.valid_flag;
    }
}

namespace SourceGenericNs {
    class Box<T> {
        T echo(T value) {
            return value;
        }
    }
}

public class GenericClassTypesTest inherits QUnit::Test {
    constructor() : Test("Generic class types", "1.0") {
        addTestCase("basic source generics", \basicSourceGenerics());
        addTestCase("multiple type parameters", \multipleTypeParameters());
        addTestCase("namespaced generic class types", \namespacedGenericClassTypes());
        addTestCase("generic overloads", \genericOverloads());
        addTestCase("runtime substitution errors", \runtimeSubstitutionErrors());
        addTestCase("generic inheritance", \genericInheritance());
        addTestCase("source generic iterators", \sourceGenericIterators());
        addTestCase("parse checks", \parseChecks());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    basicSourceGenerics() {
        SourceGenericBox<int> ibox(1);
        assertEq(1, ibox.get());
        assertEq(2, ibox.echo(2));
        ibox.set(3);
        assertEq(3, ibox.get());

        list<int> values = ibox.asList(4);
        assertEq(4, values[0]);

        SourceGenericBox<string> sbox("a");
        assertEq("a", sbox.get());
        assertEq("b", sbox.echo("b"));
    }

    multipleTypeParameters() {
        SourceGenericPair<string, int> pair("id", 7);
        assertEq("id", pair.getKey());
        assertEq(7, pair.getValue());
    }

    namespacedGenericClassTypes() {
        SourceGenericNs::Box<string> box();
        assertEq("x", box.echo("x"));
    }

    genericOverloads() {
        SourceGenericOverloads<int> overloads();
        assertEq("scalar", overloads.take(1));
        assertEq("list", overloads.take((1, 2)));
    }

    runtimeSubstitutionErrors() {
        SourceGenericBox<int> box(1);
        assertThrows("RUNTIME-TYPE-ERROR", sub () { box.localCopy("x"); });
        assertThrows("RUNTIME-TYPE-ERROR", sub () { box.setAny("x"); });
    }

    genericInheritance() {
        SourceGenericChild<int> ichild();
        assertEq(2, ichild.echo(2));
        int i = ichild.echo(3);
        assertEq(3, i);

        list<int> values = ichild.asList(4);
        assertEq(1, values.size());
        assertEq(4, values[0]);

        assertTrue(ichild instanceof SourceGenericBase<int>);
        assertFalse(ichild instanceof SourceGenericBase<string>);

        SourceGenericChild<string> schild();
        string s = schild.echo("x");
        assertEq("x", s);

        SourceFixedBaseChild<int> fixed();
        assertEq("z", fixed.echo("z"));
        assertTrue(fixed instanceof SourceGenericBase<string>);
        assertFalse(fixed instanceof SourceGenericBase<int>);
    }

    sourceGenericIterators() {
        SourceTypedIterator<int> it(5);
        assertTrue(it instanceof AbstractIterator<int>);
        assertFalse(it instanceof AbstractIterator<string>);

        AbstractIterator<int> typed = it;
        assertTrue(typed.next());
        int value = typed.getValue();
        assertEq(5, value);
        assertFalse(typed.next());

        SourceTypedIterator<int> selected_it(7);
        list<int> selected = select selected_it, $1 > 3;
        assertEq(1, selected.size());
        assertEq(7, selected[0]);
    }

    parseChecks() {
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", \p.parse(), ("class Bad<T,T> {}", "generic-classes"));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("DUPLICATE-SIGNATURE", \p.parse(), (
                "class C<T> { nothing set(T v) {} nothing set(int v) {} }", "generic-classes"));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("DUPLICATE-SIGNATURE", \p.parse(), (
                "class C<T> { nothing set(list<T> v) {} nothing set(list<int> v) {} }", "generic-classes"));
        }

        {
            Program p(PO_NEW_STYLE);
            p.parse("class C<T> { nothing set(T v) {} nothing set(list<T> v) {} } "
                "sub t() { C<int> c(); c.set(1); c.set((1, 2)); }", "generic-classes");
            p.callFunction("t");
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), (
                "class Box<T> { constructor(T value) {} } sub t() { Box<int> b(\"x\"); }", "generic-classes"));
        }

        {
            Program p(PO_NEW_STYLE);
            p.parse("class RawBox<T> {} sub t() { RawBox b(); }", "generic-classes");
            assertThrows("MISSING-TYPE-ARGUMENTS", \p.callFunction(), ("t"));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), (
                "class Base<T> { T get(T value) { return value; } } "
                "class Child<T> inherits Base<T> {} "
                "sub t() { Child<int> c(); string s = c.get(1); }", "generic-classes"));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), (
                "class Base<T> {} class Child<T> inherits Base<T, string> {}", "generic-classes"));
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-TYPE-ERROR", \p.parse(), (
                "class Base {} class Child<T> inherits Base<T> {}", "generic-classes"));
        }
    }
}
