#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class GenericClassTypesTest

class SourceGenericBox<T> {
    private {
        T value;
    }

    constructor(T value) {
        self.value = value;
    }

    T get() {
        return self.value;
    }

    T echo(T value) {
        return value;
    }

    T localCopy(auto value) {
        T local = value;
        return local;
    }

    nothing set(T value) {
        self.value = value;
    }

    nothing setAny(auto value) {
        self.value = value;
    }

    list<T> asList(T value) {
        return (value,);
    }
}

class SourceGenericPair<K, V> {
    private {
        K key;
        V value;
    }

    constructor(K key, V value) {
        self.key = key;
        self.value = value;
    }

    K getKey() {
        return self.key;
    }

    V getValue() {
        return self.value;
    }
}

class SourceDefaultBox<T = int> {
    private {
        T value;
    }

    constructor(T value) {
        self.value = value;
    }

    T get() {
        return self.value;
    }
}

class SourceDefaultPair<K, V = string> {
    private {
        K key;
        V value;
    }

    constructor(K key, V value) {
        self.key = key;
        self.value = value;
    }

    K getKey() {
        return self.key;
    }

    V getValue() {
        return self.value;
    }
}

class SourceDefaultStatic<T = int> {
    static T echo(T value) {
        return value;
    }
}

class SourceNestedDefaultStatic<T = list<hash<auto>>> {
    static T echo(T value) {
        return value;
    }
}

class SourceBoundBox<T: int = int> {
    private {
        T value;
    }

    constructor(T value) {
        self.value = value;
    }

    T get() {
        return self.value;
    }
}

class SourceGenericOverloads<T> {
    string take(T value) {
        return "scalar";
    }

    string take(list<T> value) {
        return "list";
    }
}

class SourceGenericBase<T> {
    T echo(T value) {
        return value;
    }

    list<T> asList(T value) {
        return (value,);
    }
}

class SourceGenericChild<T> inherits SourceGenericBase<T> {
}

class SourceFixedBaseChild<T> inherits SourceGenericBase<string> {
}

class SourceFixedBodyChild inherits SourceGenericBase<int> {
}

class SourceGenericBodyBase<T> {
    list<T> collectBase(T value) {
        list<T> rv();
        rv += value;
        return rv;
    }
}

class SourceFixedBodyChild2 inherits SourceGenericBodyBase<int> {
}

class SourceGenericStaticFactory<T> {
    private {
        T value;
    }

    constructor(T value) {
        self.value = value;
    }

    static SourceGenericStaticFactory<T> make(T value) {
        return new SourceGenericStaticFactory<T>(value);
    }

    static list<T> collect(T value) {
        list<T> rv();
        rv += value;
        return rv;
    }

    static T echoThroughLocal(auto value) {
        T local = value;
        return local;
    }

    T get() {
        return self.value;
    }
}

hashdecl SourceGenericResult<T> {
    T value;
    list<T> values;
}

hashdecl SourceGenericEnvelope<T> {
    string status;
    hash<SourceGenericResult<T>> result;
}

hashdecl SourceDefaultResult<T = string> {
    T value;
}

hashdecl SourceDefaultPairResult<K, V = string> {
    K key;
    V value;
}

hashdecl SourceBoundResult<T: int = int> {
    T value;
}

hashdecl SourceGenericHashParent<T> {
    T value;
}

hashdecl SourceGenericHashChild<T> inherits SourceGenericHashParent<T> {
    string name;
}

hashdecl SourceFixedHashParentChild<T> inherits SourceGenericHashParent<string> {
    T extra;
}

hashdecl SourceDefaultHashParent<T = int> {
    T id;
}

hashdecl SourceDefaultHashParentChild<T = string> inherits SourceDefaultHashParent<> {
    T label;
}

class SourceTypedIterator<T> inherits AbstractIterator<T> {
    private {
        T value;
        bool available;
        bool valid_flag;
    }

    constructor(T value) {
        self.value = value;
        self.available = True;
    }

    bool next() {
        if (!self.available) {
            self.valid_flag = False;
            return False;
        }

        self.available = False;
        self.valid_flag = True;
        return True;
    }

    T getValue() {
        if (!self.valid_flag) {
            throw "INVALID-ITERATOR", "iterator is not valid";
        }
        return self.value;
    }

    bool valid() {
        return self.valid_flag;
    }
}

class SourcePollOperation<T> inherits AbstractPollOperation<T> {
    private {
        T output;
    }

    constructor(T output) {
        self.output = output;
    }

    string getGoal() {
        return "complete";
    }

    string getState() {
        return "complete";
    }

    bool goalReached() {
        return True;
    }

    *hash<SocketPollInfo> continuePoll() {
    }

    T getOutput() {
        return output;
    }
}

class SourceObjectPairMembers {
    public {
        int count;
        string label;
    }

    constructor() {
        count = 3;
        label = "three";
    }
}

class SourceRawCompatBox<T> [legacy_raw] {
    private {
