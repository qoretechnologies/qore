    our int global_i;

    hashdecl T {
        int i = 0;
    }
}

hashdecl BatchCastInfo {
    int value;
    *string label;
    int count = 1;
}

class CTest {
    constructor(hash h) {}
    constructor(hash<auto> h) {}
}

class CTestPlain {
    constructor(hash h) {}
}

class CTestComplex {
    constructor(hash<auto> h) {}
}

class TypeMemberPseudoTest {
    public {
        Type type = BoolType;
    }
}

public enum ShortStringPseudoEnum : string {
    Input = "Input",
}

int sub ftest(int i, ...) {
    return 1;
}

int sub named_reflection_target(int alpha, *string beta = NOTHING) {
    return 1;
}

nothing sub named_reflection_varargs_only(...) {
}

class ReflectionTest inherits QUnit::Test {
    constructor() : QUnit::Test("ReflectionTest", "1.0") {
        addTestCase("ns path test", \nsPathTest());
        addTestCase("mod name tests", \modNameTests());
        addTestCase("type tests", \typeTests());
        addTestCase("typed code tests", \typedCodeTests());
        addTestCase("union type tests", \unionTypeTests());
        addTestCase("generic reflection tests", \genericReflectionTests());
        addTestCase("pgm tests", \pgmTests());
        addTestCase("issue 3145", \issue3145Test());
        addTestCase("issue 3141", \issue3141Test());
        addTestCase("issue 3035", \issue3035Test());
        addTestCase("reflection tests", \reflectionTests());
        addTestCase("typed hash batch casts", \typedHashBatchCastTest());
        addTestCase("const method reflection tests", \constMethodReflectionTests());
        addTestCase("named-call reflection tests", \namedCallReflectionTests());
        addTestCase("plugin registry reflection tests", \pluginRegistryReflectionTests());
        addTestCase("sandbox tests", \sandboxTests());
        addTestCase("pseudo-class tests", \pseudoClassTests());
        addTestCase("type member pseudo-method dispatch", \typeMemberPseudoMethodDispatchTest());
        addTestCase("program tests", \programTests());
        addTestCase("static variant tests", \staticVariantTests());
        addTestCase("cross-module namespace test", \crossModuleNamespaceTest());
        set_return_value(main());
    }

    constMethodReflectionTests() {
        Class c = Class::forName("ConstReflectionSample");

        NormalMethodVariant value = c.getMethod("value").getVariants()[0];
        assertTrue(value.isConstMethod());
        assertEq(MC_PUBLIC | MC_CONST, value.getModifiers());
        assertEq(("public", "const"), value.getModifierList());
        assertEq("public int ConstReflectionSample::value() const", value.toString());

        NormalMethodVariant mutate = c.getMethod("mutate").getVariants()[0];
        assertFalse(mutate.isConstMethod());
        assertEq(MC_PUBLIC, mutate.getModifiers());
        assertEq(("public",), mutate.getModifierList());
        assertEq("public int ConstReflectionSample::mutate()", mutate.toString());
    }

    nsPathTest() {
        assertEq("Qore::Reflection::AbstractVariant", Class::forName("AbstractVariant").getPathName());
    }

    pluginRegistryReflectionTests() {
        PluginRegistry process_registry = PluginRegistry::getProcessRegistry();
        list<string> process_modules = process_registry.getProcessModules();

        PluginRegistry program_registry = PluginRegistry::get();
        list<string> active_modules = program_registry.getActiveModules();
        foreach string mod_name in (active_modules) {
            bool found = False;
            foreach string process_mod_name in (process_modules) {
                if (process_mod_name == mod_name) {
                    found = True;
                    break;
                }
            }
            assertTrue(found);
        }

        assertThrows("PLUGIN-REGISTRY-PROGRAM-NOT-AVAILABLE", sub() {
            process_registry.getActiveModules();
        });
        assertThrows("PLUGIN-REGISTRY-PROGRAM-NOT-AVAILABLE", sub() {
            process_registry.resolveOperation(IntType, IntType, "add");
        });
        assertThrows("PLUGIN-REGISTRY-PROGRAM-NOT-AVAILABLE", sub() {
            process_registry.getRecentFallbackSites();
        });
        assertThrows("PLUGIN-REGISTRY-PROGRAM-NOT-AVAILABLE", sub() {
            process_registry.clearFallbackSites();
        });
        assertEq(NOTHING, program_registry.resolveOperation(IntType, IntType, "missing-plugin-registry-test-op"));
        assertEq((), program_registry.getRecentFallbackSites());
        program_registry.clearFallbackSites();
        assertThrows("PLUGIN-REGISTRY-MODULE-NOT-LOADED", sub() {
            process_registry.getTypes("missing-plugin-registry-test-module");
        });
        assertThrows("PLUGIN-REGISTRY-MODULE-NOT-LOADED", sub() {
            process_registry.getOperations("missing-plugin-registry-test-module");
        });
    }

    assertNamedCallableVariantCount(string name, auto params, int expected_count = 1) {
        int found = 0;
        foreach FunctionVariant v in (Function::forName(name).getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    assertNamedPseudoMethodVariantCount(PseudoClass cls, string name, auto params, int expected_count = 1) {
        int found = 0;
        foreach AbstractMethodVariant v in (cls.getMethod(name).getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    assertNamedClassMethodVariantCount(string class_name, string name, auto params, int expected_count = 1) {
        int found = 0;
        foreach AbstractMethodVariant v in (Class::forName(class_name).getMethod(name).getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    assertNamedClassStaticMethodVariantCount(string class_name, string name, auto params, int expected_count = 1) {
        int found = 0;
        foreach AbstractMethodVariant v in (Class::forName(class_name).getStaticMethod(name).getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    assertNamedConstructorVariantCount(string class_name, auto params, int expected_count = 1) {
        int found = 0;
        foreach AbstractMethodVariant v in (Class::forName(class_name).getConstructorMethod().getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    namedCallReflectionTests() {
        FunctionVariant uv = Function::forName("named_reflection_target").getVariants()[0];
        assertTrue(uv.isNamedCallable());
        assertEq(("alpha", "beta"), uv.getNamedParameterNames());

        FunctionVariant vargv = Function::forName("named_reflection_varargs_only").getVariants()[0];
        assertFalse(vargv.isNamedCallable());
        assertEq((), vargv.getNamedParameterNames());

        FunctionVariant typev = Function::forName("type").getVariants()[0];
        assertEq(("value",), typev.getParamNames());
        assertTrue(typev.isNamedCallable());
        assertEq(("value",), typev.getNamedParameterNames());

        bool found_int_with_base = False;
        foreach FunctionVariant v in (Function::forName("int").getVariants()) {
            if (v.getParamNames() == ("value", "base")) {
                found_int_with_base = True;
                assertTrue(v.isNamedCallable());
                assertEq(("value", "base"), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("value",)) {
                assertTrue(v.isNamedCallable());
                assertEq(("value",), v.getNamedParameterNames());
            }
        }
        assertTrue(found_int_with_base);

        bool found_hash_keys_values = False;
        foreach FunctionVariant v in (Function::forName("hash").getVariants()) {
            if (v.getParamNames() == ("keys", "values")) {
                found_hash_keys_values = True;
                assertTrue(v.isNamedCallable());
                assertEq(("keys", "values"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_hash_keys_values);

        bool found_two_arg_substr = False;
        bool found_three_arg_substr = False;
        foreach FunctionVariant v in (Function::forName("substr").getVariants()) {
            if (v.getParamNames() == ("str", "start")) {
                found_two_arg_substr = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str", "start"), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("str", "start", "len")) {
                found_three_arg_substr = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str", "start", "len"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_two_arg_substr);
        assertTrue(found_three_arg_substr);

        bool found_binary_substr = False;
        foreach FunctionVariant v in (Function::forName("substr").getVariants()) {
            if (v.getParamNames() == ("bin", "start", "len")) {
                found_binary_substr = True;
                assertTrue(v.isNamedCallable());
                assertEq(("bin", "start", "len"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_binary_substr);

        bool found_length_str = False;
        bool found_length_bin = False;
        foreach FunctionVariant v in (Function::forName("length").getVariants()) {
            if (v.getParamNames() == ("str",)) {
                found_length_str = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str",), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("bin",)) {
                found_length_bin = True;
                assertTrue(v.isNamedCallable());
                assertEq(("bin",), v.getNamedParameterNames());
            } else if (!v.numParams()) {
                assertFalse(v.isNamedCallable());
                assertEq((), v.getNamedParameterNames());
            }
        }
        assertTrue(found_length_str);
        assertTrue(found_length_bin);

        bool found_regex_subst_replacement = False;
        bool found_regex_subst_callback = False;
        foreach FunctionVariant v in (Function::forName("regex_subst").getVariants()) {
            if (v.getParamNames() == ("str", "pattern", "replacement", "options")) {
                found_regex_subst_replacement = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str", "pattern", "replacement", "options"), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("str", "pattern", "callback", "options")) {
                found_regex_subst_callback = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str", "pattern", "callback", "options"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_regex_subst_replacement);
        assertTrue(found_regex_subst_callback);

        foreach string name in (("chomp",)) {
            assertNamedCallableVariantCount(name, ("str",), 2);
        }

        foreach string name in (("trim", "ltrim", "rtrim")) {
            assertNamedCallableVariantCount(name, ("str", "chars"), 2);
        }

        foreach string name in (("vprintf", "f_vprintf")) {
            assertNamedCallableVariantCount(name, ("format", "values"));
        }

        bool found_abs = False;
        foreach FunctionVariant v in (Function::forName("abs").getVariants()) {
            if (v.getParamNames() == ("value",)) {
                found_abs = True;
                assertTrue(v.isNamedCallable());
                assertEq(("value",), v.getNamedParameterNames());
            } else if (!v.numParams()) {
                assertFalse(v.isNamedCallable());
                assertEq((), v.getNamedParameterNames());
            }
        }
        assertTrue(found_abs);

        FunctionVariant powv = Function::forName("pow").getVariant(IntType, IntType);
        assertTrue(powv.isNamedCallable());
        assertEq(("base", "exponent"), powv.getNamedParameterNames());

        int found_round = 0;
        foreach FunctionVariant v in (Function::forName("round").getVariants()) {
            if (v.getParamNames() == ("value", "precision")) {
