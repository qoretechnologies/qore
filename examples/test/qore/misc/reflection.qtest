        foreach string name in (("blowfish_decrypt_cbc_to_string", "des_decrypt_cbc_to_string",
                "des_ede_decrypt_cbc_to_string", "des_ede3_decrypt_cbc_to_string", "desx_decrypt_cbc_to_string",
                "rc4_decrypt_to_string", "rc2_decrypt_cbc_to_string", "cast5_decrypt_cbc_to_string",
                "rc5_decrypt_cbc_to_string")) {
