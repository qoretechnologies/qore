        FunctionVariant unsetenvv = Function::forName("unsetenv").getVariant(StringType);
        assertTrue(unsetenvv.isNamedCallable());
        assertEq(("name",), unsetenvv.getNamedParameterNames());

        FunctionVariant parse_dsv = Function::forName("Qore::SQL::parse_datasource").getVariant(StringType);
        assertTrue(parse_dsv.isNamedCallable());
