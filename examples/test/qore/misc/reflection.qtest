        foreach string name in (("uncompress_to_string", "gunzip_to_string", "inflate_raw_to_string",
                "bunzip2_to_string", "unbrotli_to_string", "unzstd_to_string")) {
            assertNamedCallableVariantCount(name, ("compressed_data", "encoding"));
        }

        assertNamedCallableVariantCount("unlz4_to_binary", ("compressed_data", "max_output_size"));
        assertNamedCallableVariantCount("unlz4_to_string", ("compressed_data", "max_output_size", "encoding"));
        assertNamedCallableVariantCount("get_compressor", ("algorithm", "level"));
        assertNamedCallableVariantCount("get_decompressor", ("algorithm",));

        assertNamedCallableVariantCount("date", ("value",), 2);
        assertNamedCallableVariantCount("date", ("date_string",));
        assertNamedCallableVariantCount("date", ("date_string", "mask"));
        assertNamedCallableVariantCount("date", ("seconds",), 2);
        assertNamedCallableVariantCount("date_ms", ("milliseconds",));
        assertNamedCallableVariantCount("date_us", ("microseconds",));
        assertNamedCallableVariantCount("format_date", ("format", "date_value"));

        foreach string name in (("localtime", "gmtime")) {
