        foreach string name in (("Qore::SQL::dbi_get_driver_capability_list", "Qore::SQL::dbi_get_driver_capabilities",
                "Qore::SQL::dbi_get_driver_options")) {
            FunctionVariant v = Function::forName(name).getVariant(StringType);
            assertTrue(v.isNamedCallable());
            assertEq(("driver",), v.getNamedParameterNames());
