        foreach string name in (("blowfish_encrypt_cbc", "des_encrypt_cbc", "des_ede_encrypt_cbc",
                "des_ede3_encrypt_cbc", "desx_encrypt_cbc", "rc4_encrypt", "rc2_encrypt_cbc",
                "cast5_encrypt_cbc", "rc5_encrypt_cbc", "blowfish_decrypt_cbc", "des_decrypt_cbc",
