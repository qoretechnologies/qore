#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}/../../../../build/modules/reflection"
%requires Util
%requires QUnit

%requires reflection

%exec-class ReflectionTest

class Base {
    public {
        int bi = 1;

        static int bsi = 2;

        const BC_I = 3;
    }

    int a() {
        return 1;
    }

    static int b() {
        return 2;
    }
}

class Test inherits Base {
    public {
        int i = 1;

        static int si = 2;

        const C_I = 3;
    }

    private {
        string str = "string";

        static string sstr = "string2";

        const C_STR = "string3";
    }

    private:internal {
        number pi = M_PIn;

        static number spi = M_PI * M_PI;

        const C_PI = M_PI * M_PI * M_PI;
    }

    int c() {
        return 3;
    }
}

class ConstReflectionSample {
    int value() const {
        return 1;
    }

    int mutate() {
        return 2;
    }
}

class ITest inherits private:internal Test {
    public {
        number pi = 0n;
    }

    private:internal int get() {
        return 1;
    }

    private:internal static int get() {
        return 2;
    }
}

# classes used by the method enumeration tests
class MethodEnumNoParent {
    constructor() {}
    destructor() {}
    copy() {}

    pubM() {}
    private privM() {}
    private:internal intM() {}

    static string pubStatic(int a) {
        return "pub";
    }

    private:internal static intStatic() {}
}

class MethodEnumBase {
    baseNormal() {}
    private basePrivate() {}
    private:internal baseInternal() {}

    string over() {
        return "base";
    }

    static string baseStatic(int a, *string b) {
        return "base";
    }

    private:internal static baseInternalStatic() {}

    static string overStatic() {
        return "base";
    }
}

