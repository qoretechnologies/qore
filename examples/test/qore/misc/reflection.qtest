        assertNamedCallableVariantCount("brotli", ("data", "quality"), 2);
        assertNamedCallableVariantCount("lz4", ("data", "acceleration"), 2);

        foreach string name in (("uncompress_to_binary", "gunzip_to_binary", "inflate_raw_to_binary",
