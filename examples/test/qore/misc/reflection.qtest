#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit

%requires reflection

%exec-class ReflectionTest

class Base {
    public {
        int bi = 1;

        static int bsi = 2;

        const BC_I = 3;
    }

    int a() {
        return 1;
    }

    static int b() {
        return 2;
    }
}

class Test inherits Base {
    public {
        int i = 1;

        static int si = 2;

        const C_I = 3;
    }

    private {
        string str = "string";

        static string sstr = "string2";

        const C_STR = "string3";
    }

    private:internal {
        number pi = M_PIn;

        static number spi = M_PI * M_PI;

        const C_PI = M_PI * M_PI * M_PI;
    }

    int c() {
        return 3;
    }
}

class ITest inherits private:internal Test {
    public {
        number pi = 0n;
    }

    private:internal int get() {
        return 1;
    }

    private:internal static int get() {
        return 2;
    }
}

namespace TestNs {
    our int global_i;

    hashdecl T {
        int i = 0;
    }
}

class CTest {
    constructor(hash h) {}
    constructor(hash<auto> h) {}
}

class CTestPlain {
    constructor(hash h) {}
}

class CTestComplex {
    constructor(hash<auto> h) {}
}

class TypeMemberPseudoTest {
    public {
        Type type = BoolType;
    }
}

int sub ftest(int i, ...) {
    return 1;
}

int sub named_reflection_target(int alpha, *string beta = NOTHING) {
    return 1;
}

nothing sub named_reflection_varargs_only(...) {
}

class ReflectionTest inherits QUnit::Test {
    constructor() : QUnit::Test("ReflectionTest", "1.0") {
        addTestCase("ns path test", \nsPathTest());
        addTestCase("mod name tests", \modNameTests());
        addTestCase("type tests", \typeTests());
        addTestCase("typed code tests", \typedCodeTests());
        addTestCase("union type tests", \unionTypeTests());
        addTestCase("pgm tests", \pgmTests());
        addTestCase("issue 3145", \issue3145Test());
        addTestCase("issue 3141", \issue3141Test());
        addTestCase("issue 3035", \issue3035Test());
        addTestCase("reflection tests", \reflectionTests());
        addTestCase("named-call reflection tests", \namedCallReflectionTests());
        addTestCase("sandbox tests", \sandboxTests());
        addTestCase("pseudo-class tests", \pseudoClassTests());
        addTestCase("type member pseudo-method dispatch", \typeMemberPseudoMethodDispatchTest());
        addTestCase("program tests", \programTests());
        addTestCase("cross-module namespace test", \crossModuleNamespaceTest());
        set_return_value(main());
    }

    nsPathTest() {
        assertEq("Qore::Reflection::AbstractVariant", Class::forName("AbstractVariant").getPathName());
    }

    assertNamedCallableVariantCount(string name, auto params, int expected_count = 1) {
        int found = 0;
        foreach FunctionVariant v in (Function::forName(name).getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    assertNamedPseudoMethodVariantCount(PseudoClass cls, string name, auto params, int expected_count = 1) {
        int found = 0;
        foreach AbstractMethodVariant v in (cls.getMethod(name).getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    assertNamedClassMethodVariantCount(string class_name, string name, auto params, int expected_count = 1) {
        int found = 0;
        foreach AbstractMethodVariant v in (Class::forName(class_name).getMethod(name).getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    assertNamedConstructorVariantCount(string class_name, auto params, int expected_count = 1) {
        int found = 0;
        foreach AbstractMethodVariant v in (Class::forName(class_name).getConstructorMethod().getVariants()) {
            if (v.getParamNames() == params) {
                ++found;
                assertTrue(v.isNamedCallable());
                assertEq(params, v.getNamedParameterNames());
            }
        }
        assertEq(expected_count, found);
    }

    namedCallReflectionTests() {
        FunctionVariant uv = Function::forName("named_reflection_target").getVariants()[0];
        assertTrue(uv.isNamedCallable());
        assertEq(("alpha", "beta"), uv.getNamedParameterNames());

        FunctionVariant vargv = Function::forName("named_reflection_varargs_only").getVariants()[0];
        assertFalse(vargv.isNamedCallable());
        assertEq((), vargv.getNamedParameterNames());

        FunctionVariant typev = Function::forName("type").getVariants()[0];
        assertEq(("value",), typev.getParamNames());
        assertTrue(typev.isNamedCallable());
        assertEq(("value",), typev.getNamedParameterNames());

        bool found_int_with_base = False;
        foreach FunctionVariant v in (Function::forName("int").getVariants()) {
            if (v.getParamNames() == ("value", "base")) {
                found_int_with_base = True;
                assertTrue(v.isNamedCallable());
                assertEq(("value", "base"), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("value",)) {
                assertTrue(v.isNamedCallable());
                assertEq(("value",), v.getNamedParameterNames());
            }
        }
        assertTrue(found_int_with_base);

        bool found_hash_keys_values = False;
        foreach FunctionVariant v in (Function::forName("hash").getVariants()) {
            if (v.getParamNames() == ("keys", "values")) {
                found_hash_keys_values = True;
                assertTrue(v.isNamedCallable());
                assertEq(("keys", "values"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_hash_keys_values);

        bool found_two_arg_substr = False;
        bool found_three_arg_substr = False;
        foreach FunctionVariant v in (Function::forName("substr").getVariants()) {
            if (v.getParamNames() == ("str", "start")) {
                found_two_arg_substr = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str", "start"), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("str", "start", "len")) {
                found_three_arg_substr = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str", "start", "len"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_two_arg_substr);
        assertTrue(found_three_arg_substr);

        bool found_binary_substr = False;
        foreach FunctionVariant v in (Function::forName("substr").getVariants()) {
            if (v.getParamNames() == ("bin", "start", "len")) {
                found_binary_substr = True;
                assertTrue(v.isNamedCallable());
                assertEq(("bin", "start", "len"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_binary_substr);

        bool found_length_str = False;
        bool found_length_bin = False;
        foreach FunctionVariant v in (Function::forName("length").getVariants()) {
            if (v.getParamNames() == ("str",)) {
                found_length_str = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str",), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("bin",)) {
                found_length_bin = True;
                assertTrue(v.isNamedCallable());
                assertEq(("bin",), v.getNamedParameterNames());
            } else if (!v.numParams()) {
                assertFalse(v.isNamedCallable());
                assertEq((), v.getNamedParameterNames());
            }
        }
        assertTrue(found_length_str);
        assertTrue(found_length_bin);

        bool found_regex_subst_replacement = False;
        bool found_regex_subst_callback = False;
        foreach FunctionVariant v in (Function::forName("regex_subst").getVariants()) {
            if (v.getParamNames() == ("str", "pattern", "replacement", "options")) {
                found_regex_subst_replacement = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str", "pattern", "replacement", "options"), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("str", "pattern", "callback", "options")) {
                found_regex_subst_callback = True;
                assertTrue(v.isNamedCallable());
                assertEq(("str", "pattern", "callback", "options"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_regex_subst_replacement);
        assertTrue(found_regex_subst_callback);

        foreach string name in (("chomp",)) {
            assertNamedCallableVariantCount(name, ("str",), 2);
        }

        foreach string name in (("trim", "ltrim", "rtrim")) {
            assertNamedCallableVariantCount(name, ("str", "chars"), 2);
        }

        foreach string name in (("vprintf", "f_vprintf")) {
            assertNamedCallableVariantCount(name, ("format", "values"));
        }

        bool found_abs = False;
        foreach FunctionVariant v in (Function::forName("abs").getVariants()) {
            if (v.getParamNames() == ("value",)) {
                found_abs = True;
                assertTrue(v.isNamedCallable());
                assertEq(("value",), v.getNamedParameterNames());
            } else if (!v.numParams()) {
                assertFalse(v.isNamedCallable());
                assertEq((), v.getNamedParameterNames());
            }
        }
        assertTrue(found_abs);

        FunctionVariant powv = Function::forName("pow").getVariant(IntType, IntType);
        assertTrue(powv.isNamedCallable());
        assertEq(("base", "exponent"), powv.getNamedParameterNames());

        int found_round = 0;
        foreach FunctionVariant v in (Function::forName("round").getVariants()) {
            if (v.getParamNames() == ("value", "precision")) {
                ++found_round;
                assertTrue(v.isNamedCallable());
                assertEq(("value", "precision"), v.getNamedParameterNames());
            } else if (!v.numParams()) {
                assertFalse(v.isNamedCallable());
                assertEq((), v.getNamedParameterNames());
            }
        }
        assertEq(3, found_round);

        FunctionVariant getenvv = Function::forName("getenv").getVariant(StringType);
        assertTrue(getenvv.isNamedCallable());
        assertEq(("name",), getenvv.getNamedParameterNames());

        bool found_setenv = False;
        foreach FunctionVariant v in (Function::forName("setenv").getVariants()) {
            if (v.getParamNames() == ("name", "value")) {
                found_setenv = True;
                assertTrue(v.isNamedCallable());
                assertEq(("name", "value"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_setenv);

        FunctionVariant unsetenvv = Function::forName("unsetenv").getVariant(StringType);
        assertTrue(unsetenvv.isNamedCallable());
        assertEq(("name",), unsetenvv.getNamedParameterNames());

        FunctionVariant parse_dsv = Function::forName("Qore::SQL::parse_datasource").getVariant(StringType);
        assertTrue(parse_dsv.isNamedCallable());
        assertEq(("datasource",), parse_dsv.getNamedParameterNames());

        bool found_make_ds = False;
        foreach FunctionVariant v in (Function::forName("Qore::SQL::make_datasource_string").getVariants()) {
            if (v.getParamNames() == ("config",)) {
                found_make_ds = True;
                assertTrue(v.isNamedCallable());
                assertEq(("config",), v.getNamedParameterNames());
            }
        }
        assertTrue(found_make_ds);

        foreach string name in (("Qore::SQL::dbi_get_driver_capability_list", "Qore::SQL::dbi_get_driver_capabilities",
                "Qore::SQL::dbi_get_driver_options")) {
            FunctionVariant v = Function::forName(name).getVariant(StringType);
            assertTrue(v.isNamedCallable());
            assertEq(("driver",), v.getNamedParameterNames());
        }

        FunctionVariant cx_valuev = Function::forName("cx_value").getVariant(StringType);
        assertTrue(cx_valuev.isNamedCallable());
        assertEq(("key",), cx_valuev.getNamedParameterNames());

        bool found_ws_encode = False;
        foreach FunctionVariant v in (Function::forName("ws_encode_frame").getVariants()) {
            if (v.getParamNames() == ("message", "opcode", "masked", "fin", "rsv_bits")) {
                found_ws_encode = True;
                assertTrue(v.isNamedCallable());
                assertEq(("message", "opcode", "masked", "fin", "rsv_bits"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_ws_encode);

        FunctionVariant ws_unmaskv = Function::forName("ws_unmask_data").getVariant(BinaryType, BinaryType);
        assertTrue(ws_unmaskv.isNamedCallable());
        assertEq(("data", "mask"), ws_unmaskv.getNamedParameterNames());

        foreach string name in (("sort", "sort_descending", "sort_stable", "sort_descending_stable", "min", "max")) {
            bool found_values = False;
            bool found_comparator = False;
            foreach FunctionVariant v in (Function::forName(name).getVariants()) {
                if (v.getParamNames() == ("values",)) {
                    found_values = True;
                    assertTrue(v.isNamedCallable());
                    assertEq(("values",), v.getNamedParameterNames());
                } else if (v.getParamNames() == ("values", "comparator")) {
                    found_comparator = True;
                    assertTrue(v.isNamedCallable());
                    assertEq(("values", "comparator"), v.getNamedParameterNames());
                } else if (!v.numParams() || v.getParamNames() == ("arg",) || v.getParamNames() == ("...",)
                        || v.getParamNames() == ("l",) || v.getParamNames() == ("l", "func")
                        || v.getParamNames() == ("l", "f")) {
                    assertFalse(v.isNamedCallable());
                    assertEq((), v.getNamedParameterNames());
                }
            }
            assertTrue(found_values);
            assertTrue(found_comparator);
        }

        int found_range = 0;
        foreach FunctionVariant v in (Function::forName("range").getVariants()) {
            if (v.getParamNames() == ("stop",)) {
                ++found_range;
                assertTrue(v.isNamedCallable());
                assertEq(("stop",), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("start", "stop", "step")) {
                ++found_range;
                assertTrue(v.isNamedCallable());
                assertEq(("start", "stop", "step"), v.getNamedParameterNames());
            }
        }
        assertEq(2, found_range);

        FunctionVariant reversev = Function::forName("reverse").getVariant(new Type("list<auto>"));
        assertTrue(reversev.isNamedCallable());
        assertEq(("values",), reversev.getNamedParameterNames());

        foreach string name in (("inlist", "inlist_hard")) {
            bool found_values = False;
            foreach FunctionVariant v in (Function::forName(name).getVariants()) {
                if (v.getParamNames() == ("value", "values")) {
                    found_values = True;
                    assertTrue(v.isNamedCallable());
                    assertEq(("value", "values"), v.getNamedParameterNames());
                } else {
                    assertFalse(v.isNamedCallable());
                    assertEq((), v.getNamedParameterNames());
                }
            }
            assertTrue(found_values);
        }

        foreach string name in (("getpwuid", "getpwuid2")) {
            FunctionVariant v = Function::forName(name).getVariant(SoftIntType);
            assertTrue(v.isNamedCallable());
            assertEq(("uid",), v.getNamedParameterNames());
        }

        foreach string name in (("getgrgid", "getgrgid2")) {
            FunctionVariant v = Function::forName(name).getVariant(SoftIntType);
            assertTrue(v.isNamedCallable());
            assertEq(("gid",), v.getNamedParameterNames());
        }

        foreach string name in (("getpwnam", "getpwnam2", "getgrnam", "getgrnam2")) {
            FunctionVariant v = Function::forName(name).getVariant(StringType);
            assertTrue(v.isNamedCallable());
            assertEq(("name",), v.getNamedParameterNames());
        }

        foreach string name in (("compress", "gzip", "deflate_raw", "bzip2", "zstd")) {
            assertNamedCallableVariantCount(name, ("data", "level"), 2);
        }

        assertNamedCallableVariantCount("brotli", ("data", "quality"), 2);
        assertNamedCallableVariantCount("lz4", ("data", "acceleration"), 2);

        foreach string name in (("uncompress_to_binary", "gunzip_to_binary", "inflate_raw_to_binary",
                "bunzip2_to_binary", "unbrotli_to_binary", "unzstd_to_binary")) {
            assertNamedCallableVariantCount(name, ("compressed_data",));
        }

        foreach string name in (("uncompress_to_string", "gunzip_to_string", "inflate_raw_to_string",
                "bunzip2_to_string", "unbrotli_to_string", "unzstd_to_string")) {
            assertNamedCallableVariantCount(name, ("compressed_data", "encoding"));
        }

        assertNamedCallableVariantCount("unlz4_to_binary", ("compressed_data", "max_output_size"));
        assertNamedCallableVariantCount("unlz4_to_string", ("compressed_data", "max_output_size", "encoding"));
        assertNamedCallableVariantCount("get_compressor", ("algorithm", "level"));
        assertNamedCallableVariantCount("get_decompressor", ("algorithm",));

        assertNamedCallableVariantCount("date", ("value",), 2);
        assertNamedCallableVariantCount("date", ("date_string",));
        assertNamedCallableVariantCount("date", ("date_string", "mask"));
        assertNamedCallableVariantCount("date", ("seconds",), 2);
        assertNamedCallableVariantCount("date_ms", ("milliseconds",));
        assertNamedCallableVariantCount("date_us", ("microseconds",));
        assertNamedCallableVariantCount("format_date", ("format", "date_value"));

        foreach string name in (("localtime", "gmtime")) {
            assertNamedCallableVariantCount(name, ("seconds", "microseconds"));
            assertNamedCallableVariantCount(name, ("date_value",));
        }

        foreach string name in (("timegm", "mktime", "date_info", "is_date_relative", "is_date_absolute",
                "get_epoch_seconds", "get_epoch_milliseconds", "get_epoch_microseconds", "get_years", "get_months",
                "get_days", "get_hours", "get_minutes", "get_seconds", "get_milliseconds", "get_microseconds",
                "get_midnight", "get_day_number", "get_day_of_week", "get_iso_day_of_week", "get_iso_week_hash",
                "get_iso_week_string", "get_duration_seconds", "get_duration_milliseconds",
                "get_duration_microseconds", "get_duration_seconds_f")) {
            assertNamedCallableVariantCount(name, ("date_value",));
        }

        foreach string name in (("years", "months", "days", "hours", "minutes", "seconds")) {
            assertNamedCallableVariantCount(name, (name,));
        }

        assertNamedCallableVariantCount("milliseconds", ("milliseconds",));
        assertNamedCallableVariantCount("microseconds", ("microseconds",));
        assertNamedCallableVariantCount("get_date_from_iso_week", ("year", "week", "day"));

        assertNamedCallableVariantCount("get_method_list", ("object_value",));
        assertNamedCallableVariantCount("call_object_method_args", ("object_value", "method", "arguments"));
        assertNamedCallableVariantCount("call_static_method_args", ("class_name", "method", "arguments"));
        assertNamedCallableVariantCount("call_pseudo_args", ("value", "method", "arguments"));
        assertNamedCallableVariantCount("create_object_args", ("class_name", "arguments"));

        assertNamedCallableVariantCount("set_signal_handler", ("signal", "handler"));
        assertNamedCallableVariantCount("remove_signal_handler", ("signal",));
        assertNamedCallableVariantCount("set_async_io_logger", ("logger",));
        assertNamedCallableVariantCount("backquote", ("command", "return_code"));
        assertNamedCallableVariantCount("call_function_args", ("name", "arguments"));
        assertNamedCallableVariantCount("call_function_args", ("callable", "arguments"));
        assertNamedCallableVariantCount("call_builtin_function_args", ("name", "arguments"));
        assertNamedCallableVariantCount("parse", ("code", "label", "warning_mask", "source", "offset", "format_label"));

        foreach string name in (("exists_function", "function_type", "reload_module")) {
            assertNamedCallableVariantCount(name, ("name",));
        }

        assertNamedCallableVariantCount("load_module", ("name", "warning_mask"));
        assertNamedCallableVariantCount("load_module_warn", ("name", "warning_mask"));
        assertNamedCallableVariantCount("load_user_module_with_program", ("name", "program"));

        foreach string name in (("html_encode", "html_decode")) {
            assertNamedCallableVariantCount(name, ("str",));
        }

        assertNamedCallableVariantCount("decode_url", ("url",));
        assertNamedCallableVariantCount("encode_url", ("url", "encode_all"));
        assertNamedCallableVariantCount("decode_uri_request", ("uri",));
        assertNamedCallableVariantCount("encode_uri_request", ("url",));
        assertNamedCallableVariantCount("parse_url", ("url", "keep_brackets"));
        assertNamedCallableVariantCount("parse_url", ("url", "options"));
        assertNamedCallableVariantCount("parseURL", ("url", "keep_brackets"));
        assertNamedCallableVariantCount("get_safe_url", ("url",));

        assertNamedCallableVariantCount("get_class_name", ("object_value",));
        assertNamedCallableVariantCount("has_key", ("container", "key"), 2);
        assertNamedCallableVariantCount("hash_values", ("hash_value",));
        assertNamedCallableVariantCount("get_byte", ("data", "offset"), 2);

        foreach string name in (("get_word_16", "get_word_32", "get_word_64", "get_word_16_lsb",
                "get_word_32_lsb", "get_word_64_lsb")) {
            assertNamedCallableVariantCount(name, ("data", "offset"), 2);
        }

        assertNamedCallableVariantCount("make_base64_string", ("data", "max_line_length"), 2);
        assertNamedCallableVariantCount("make_base64_url_string", ("data",), 2);
        assertNamedCallableVariantCount("parse_base64_string", ("base64_string",));
        assertNamedCallableVariantCount("parse_base64_string_to_string", ("base64_string", "encoding"));
        assertNamedCallableVariantCount("parse_base64_url_string", ("base64_url_string",));
        assertNamedCallableVariantCount("parse_base64_url_string_to_string", ("base64_url_string", "encoding"));
        assertNamedCallableVariantCount("make_hex_string", ("data",), 2);
        assertNamedCallableVariantCount("parse_hex_string", ("hex_string",));
        assertNamedCallableVariantCount("hextoint", ("hex_string",));
        assertNamedCallableVariantCount("strtoint", ("value", "base"));

        assertNamedCallableVariantCount("splice", ("value", "start"), 2);
        assertNamedCallableVariantCount("splice", ("value", "start", "length"));
        assertNamedCallableVariantCount("splice", ("value", "start", "length", "replacement"), 2);
        assertNamedCallableVariantCount("set_return_value", ("value",));
        assertNamedCallableVariantCount("get_ex_pos", ("exception_info",));
        assertNamedCallableVariantCount("get_local_vars", ("frame",));
        assertNamedCallableVariantCount("set_local_var_value", ("frame", "name", "value"));
        assertNamedCallableVariantCount("set_global_var_value", ("name", "value"));
        assertNamedCallableVariantCount("get_module_option", ("module", "option"));
        assertNamedCallableVariantCount("set_module_option", ("module", "option", "value"));
        assertNamedCallableVariantCount("set_app_registry", ("key", "value"));
        assertNamedCallableVariantCount("get_app_registry", ("key",));
        assertNamedCallableVariantCount("get_call_reference", ("identifier",));
        assertNamedCallableVariantCount("get_value_byte_size", ("value",));

        foreach string name in (("MD2", "MD4", "MD5", "SHA", "SHA1", "SHA224", "SHA256", "SHA384", "SHA512",
                "DSS", "DSS1", "MDC2", "RIPEMD160", "MD2_bin", "MD4_bin", "MD5_bin", "SHA_bin", "SHA1_bin",
                "SHA224_bin", "SHA256_bin", "SHA384_bin", "SHA512_bin", "DSS_bin", "DSS1_bin", "MDC2_bin",
                "RIPEMD160_binary")) {
            assertNamedCallableVariantCount(name, ("data",));
        }

        foreach string name in (("MD2_hmac", "MD4_hmac", "MD5_hmac", "SHA_hmac", "SHA1_hmac", "SHA224_hmac",
                "SHA256_hmac", "SHA384_hmac", "SHA512_hmac", "DSS_hmac", "DSS1_hmac", "MDC2_hmac",
