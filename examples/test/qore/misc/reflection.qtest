            assertTrue(found_values);
        }

        foreach string name in (("getpwuid", "getpwuid2")) {
            FunctionVariant v = Function::forName(name).getVariant(SoftIntType);
            assertTrue(v.isNamedCallable());
            assertEq(("uid",), v.getNamedParameterNames());
