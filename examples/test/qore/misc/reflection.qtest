        int socket_response_no_info_count = 0;
        foreach AbstractMethodVariant v in (Class::forName("Socket").getMethod("sendHTTPResponse").getVariants()) {
            if (v.getParamNames()
                    == ("status_code", "status_description", "http_version", "headers", "body", "timeout_ms")) {
                ++socket_response_no_info_count;
                assertFalse(v.isNamedCallable());
            }
        }
        assertEq(2, socket_response_no_info_count);
        int socket_response_callback_no_info_count = 0;
        foreach AbstractMethodVariant v in (
                Class::forName("Socket").getMethod("sendHTTPResponseWithCallback").getVariants()) {
            if (v.getParamNames()
                    == ("send_callback", "status_code", "status_description", "http_version", "headers",
                        "timeout_ms")) {
                ++socket_response_callback_no_info_count;
                assertFalse(v.isNamedCallable());
            }
        }
        assertEq(1, socket_response_callback_no_info_count);
