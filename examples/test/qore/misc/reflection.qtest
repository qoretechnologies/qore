        FunctionVariant cx_valuev = Function::forName("cx_value").getVariant(StringType);
        assertTrue(cx_valuev.isNamedCallable());
        assertEq(("key",), cx_valuev.getNamedParameterNames());

        bool found_ws_encode = False;
        foreach FunctionVariant v in (Function::forName("ws_encode_frame").getVariants()) {
            if (v.getParamNames() == ("message", "opcode", "masked", "fin", "rsv_bits")) {
                found_ws_encode = True;
                assertTrue(v.isNamedCallable());
                assertEq(("message", "opcode", "masked", "fin", "rsv_bits"), v.getNamedParameterNames());
            }
        }
        assertTrue(found_ws_encode);

        FunctionVariant ws_unmaskv = Function::forName("ws_unmask_data").getVariant(BinaryType, BinaryType);
        assertTrue(ws_unmaskv.isNamedCallable());
        assertEq(("data", "mask"), ws_unmaskv.getNamedParameterNames());

        foreach string name in (("sort", "sort_descending", "sort_stable", "sort_descending_stable", "min", "max")) {
            bool found_values = False;
            bool found_comparator = False;
            foreach FunctionVariant v in (Function::forName(name).getVariants()) {
                if (v.getParamNames() == ("values",)) {
                    found_values = True;
                    assertTrue(v.isNamedCallable());
                    assertEq(("values",), v.getNamedParameterNames());
                } else if (v.getParamNames() == ("values", "comparator")) {
                    found_comparator = True;
                    assertTrue(v.isNamedCallable());
                    assertEq(("values", "comparator"), v.getNamedParameterNames());
                } else if (!v.numParams() || v.getParamNames() == ("arg",) || v.getParamNames() == ("...",)
                        || v.getParamNames() == ("l",) || v.getParamNames() == ("l", "func")
                        || v.getParamNames() == ("l", "f")) {
                    assertFalse(v.isNamedCallable());
                    assertEq((), v.getNamedParameterNames());
                }
            }
            assertTrue(found_values);
            assertTrue(found_comparator);
        }

        int found_range = 0;
        foreach FunctionVariant v in (Function::forName("range").getVariants()) {
            if (v.getParamNames() == ("stop",)) {
                ++found_range;
                assertTrue(v.isNamedCallable());
                assertEq(("stop",), v.getNamedParameterNames());
            } else if (v.getParamNames() == ("start", "stop", "step")) {
                ++found_range;
                assertTrue(v.isNamedCallable());
                assertEq(("start", "stop", "step"), v.getNamedParameterNames());
            }
        }
        assertEq(2, found_range);

        FunctionVariant reversev = Function::forName("reverse").getVariant(new Type("list<auto>"));
        assertTrue(reversev.isNamedCallable());
        assertEq(("values",), reversev.getNamedParameterNames());

        foreach string name in (("inlist", "inlist_hard")) {
