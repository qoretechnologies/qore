                assertEq(("value", "precision"), v.getNamedParameterNames());
            } else if (!v.numParams()) {
                assertFalse(v.isNamedCallable());
                assertEq((), v.getNamedParameterNames());
            }
        }
        assertEq(3, found_round);

        FunctionVariant getenvv = Function::forName("getenv").getVariant(StringType);
        assertTrue(getenvv.isNamedCallable());
        assertEq(("name",), getenvv.getNamedParameterNames());

        bool found_setenv = False;
