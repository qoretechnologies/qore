#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class SignalTest

#! a script whose signal callback has captured an object whose destructor raises an exception; see signalReleaseExceptionTest()
const ReleaseExceptionScript = "%modern
class Tracker {
    private { Queue events; }
    constructor(Queue events) { self.events = events; }
    destructor() {
        events.push(\"destroyed\");
        throw \"SIGNAL-CALLBACK-TRACKER-ERROR\", \"raised by the destructor of an object a signal callback captured\";
    }
    finished() { events.push(\"finished\"); }
}
sub install(Queue events) {
    Tracker tracker(events);
    set_signal_handler(SIGUSR1, sub (int sig) {
        remove_signal_handler(SIGUSR1);
        tracker.finished();
    });
}
Queue events();
install(events);
kill(getpid(), SIGUSR1);
string first = events.get();
string second = events.get();
Queue next();
set_signal_handler(SIGUSR1, sub (int sig) { next.push(sig); });
kill(getpid(), SIGUSR1);
printf(\"events: %s %s; next callback: %d\\n\", first, second, next.get());
remove_signal_handler(SIGUSR1);
";

#! a script that sends itself a signal after setting its handler as the mode says; the arguments are the signal and the
#! mode; see signalDispositionTest()
const DispositionScript = "%modern
int sig = int(ARGV[0]);
string mode = ARGV[1];
Queue handled();
code callback = sub (int s) { handled.push(s); };
switch (mode) {
    case \"unset\":
        remove_signal_handler(sig);
        break;
    case \"removed\":
        set_signal_handler(sig, callback);
        remove_signal_handler(sig);
        break;
    case \"readded\":
        set_signal_handler(sig, callback);
        remove_signal_handler(sig);
        set_signal_handler(sig, callback);
        break;
}
kill(getpid(), sig);
if (mode == \"readded\") {
    printf(\"handled %d\\n\", handled.get(30s));
    exit(0);
}
# a signal that ends the process does so before this limit, which is only for a failure; for a signal that must not end
# the process, a shorter wait cannot make the test fail, only miss an effect on a very slow machine
Counter deadline(1);
deadline.waitForZero(ARGV[2] == \"ends\" ? 30s : 100ms);
printf(\"alive\\n\");
";

#! records the life of a signal callback: the callback finishing, and the destruction of what its closure captured
class SignalCallbackTracker {
    private {
        Queue events;
        bool throw_in_destructor;
    }

    constructor(Queue events, bool throw_in_destructor = False) {
        self.events = events;
        self.throw_in_destructor = throw_in_destructor;
    }

    destructor() {
        events.push("destroyed");
        if (throw_in_destructor) {
            throw "SIGNAL-CALLBACK-TRACKER-ERROR", "raised by the destructor of an object a signal callback captured";
        }
    }

    finished() {
        events.push("finished");
    }
}

class SignalTest inherits QUnit::Test {
    constructor() : QUnit::Test("Signal test", "1.0") {
        addTestCase("signal neg test", \signalNegTest());
        addTestCase("a signal without a handler, also after its handler is removed", \signalDispositionTest());
        addTestCase("reserved signals have no handlers", \signalReservedTest());
        addTestCase("signal test", \signalTest());
        addTestCase("signal handler re-register", \signalReregisterTest());
        addTestCase("signal handler rapid re-register", \signalRapidReregisterTest());
        addTestCase("a callback replaced by another thread while it runs keeps its closure",
            \signalReplaceWhileRunningTest());
        addTestCase("a callback that replaces its own handler keeps its closure", \signalReplaceOwnHandlerTest());
        addTestCase("a callback that removes its own handler and sets another keeps its closure",
            \signalRemoveReplaceOwnHandlerTest());
        addTestCase("a callback that removes its own handler", \signalRemoveOwnHandlerTest());
        addTestCase("a callback that removes its own handler twice", \signalRemoveOwnHandlerTwiceTest());
        addTestCase("an exception releasing a removed callback does not stop the next callback",
            \signalReleaseExceptionTest());
        set_return_value(main());
    }

    #! installs a SIGUSR1 handler whose callback calls the given code and then uses what its closure captured
    /** only the callback's closure references its tracker
    */
    private static installHandler(Queue events, code<nothing()> change, bool throw_in_destructor = False) {
        SignalCallbackTracker tracker(events, throw_in_destructor);
        set_signal_handler(SIGUSR1, sub (int sig) {
            change();
            tracker.finished();
        });
    }

    #! raises SIGUSR1 for the handler installHandler() installed
    /** asserts that what the callback's closure captured is destroyed only after the callback has returned
    */
    private checkCallback(code<nothing()> change, bool throw_in_destructor = False) {
        Queue events();
        installHandler(events, change, throw_in_destructor);
        kill(getpid(), SIGUSR1);
        assertEq("finished", events.get());
        assertEq("destroyed", events.get());
    }

    #! asserts that SIGUSR1 is handled by a newly installed handler
    private checkNextCallback() {
        Queue q();
        set_signal_handler(SIGUSR1, sub (int sig) { q.push(sig); });
        on_exit remove_signal_handler(SIGUSR1);
        kill(getpid(), SIGUSR1);
        assertEq(SIGUSR1, q.get());
    }

    signalReplaceWhileRunningTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        on_exit remove_signal_handler(SIGUSR1);
        Queue events();
        Queue ready();
        Queue release();
        installHandler(events, sub () {
            ready.push(True);
            release.get();
        });
        kill(getpid(), SIGUSR1);
        ready.get();
        {
            # the callback must return even when the assertion fails
            on_exit release.push(True);
            # replacing a handler does not wait for its running callback
            set_signal_handler(SIGUSR1, sub (int sig) {});
            assertEq(0, events.size(), "the running callback's closure is still referenced");
        }
        assertEq("finished", events.get());
        # the callback's closure is released once it has returned
        assertEq("destroyed", events.get());

        checkNextCallback();
    }

    signalReplaceOwnHandlerTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        on_exit remove_signal_handler(SIGUSR1);
        Queue q();
        checkCallback(sub () {
            set_signal_handler(SIGUSR1, sub (int sig) { q.push(sig); });
        });

        # the replacement is the installed handler
        kill(getpid(), SIGUSR1);
        assertEq(SIGUSR1, q.get());
    }

    signalRemoveReplaceOwnHandlerTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        on_exit remove_signal_handler(SIGUSR1);
        Queue q();
        checkCallback(sub () {
            remove_signal_handler(SIGUSR1);
            set_signal_handler(SIGUSR1, sub (int sig) { q.push(sig); });
        });

        # the handler set after the removal stays installed
        kill(getpid(), SIGUSR1);
        assertEq(SIGUSR1, q.get());
    }

    signalRemoveOwnHandlerTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        checkCallback(sub () {
            remove_signal_handler(SIGUSR1);
        });
        checkNextCallback();
    }

    signalRemoveOwnHandlerTwiceTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        # the second removal finds the handler already removed
        checkCallback(sub () {
            remove_signal_handler(SIGUSR1);
            remove_signal_handler(SIGUSR1);
        });
        checkNextCallback();
    }

    signalReleaseExceptionTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        # the destructor of the object that the removed callback captured raises an exception when the signal
        # thread releases the callback; the signal thread reports it on stderr, and the next callback runs; it runs in
        # a process of its own to check what is reported
        TmpFile script("qore-signals-", ".q");
        script.file.write(ReleaseExceptionScript);
        script.file.close();
        string cmd;
        # the library path is set again because a shell can remove it from its environment (macOS)
        foreach string var in ("LD_LIBRARY_PATH", "DYLD_LIBRARY_PATH") {
            if (ENV{var}) {
                cmd += sprintf("%s='%s' ", var, ENV{var});
            }
        }
        cmd += sprintf("'%s' '%s' 2>&1", QORE_ARGV[0], script.path);
        int rc;
        string out = backquote(cmd, \rc);
        assertEq(0, rc, out);
        assertRegex("SIGNAL-CALLBACK-TRACKER-ERROR: raised by the destructor", out);
        assertRegex("events: finished destroyed; next callback: " + SIGUSR1 + "\n", out);
    }

    #! runs DispositionScript and returns its output and its exit code, with 128 plus the signal that ended it
    private hash<auto> runDisposition(TmpFile script, int sig, string mode, string expected = "ends") {
        string cmd;
        # the library path is set again because a shell can remove it from its environment (macOS)
        foreach string var in ("LD_LIBRARY_PATH", "DYLD_LIBRARY_PATH") {
            if (ENV{var}) {
                cmd += sprintf("%s='%s' ", var, ENV{var});
            }
        }
        cmd += sprintf("'%s' '%s' %d %s %s 2>/dev/null; echo rc=$?", QORE_ARGV[0], script.path, sig, mode, expected);
        string out = backquote(cmd);
        *list<string> m = (out =~ x/rc=([0-9]+)/);
        return {"out": out, "rc": int(m[0])};
    }

    # removing a handler returns the signal to the state that it had before the handler was set
    signalDispositionTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        TmpFile script("qore-signals-", ".q");
        script.file.write(DispositionScript);
        script.file.close();

        # a signal that ends the process, by its default action or, for SIGTERM, with its cleanup, with and without a
        # handler that was removed
        foreach int sig in (SIGTERM, SIGUSR1, SIGUSR2) {
            foreach string mode in ("never", "unset", "removed") {
                hash<auto> res = runDisposition(script, sig, mode);
                assertEq(128 + sig, res.rc, sprintf("%s %s: %y", SignalToName{sig}, mode, res.out));
                assertFalse(res.out =~ /alive/, sprintf("%s %s", SignalToName{sig}, mode));
            }
            # negative: a handler that is set again handles the signal
            hash<auto> res = runDisposition(script, sig, "readded");
            assertEq(0, res.rc, sprintf("%s: %y", SignalToName{sig}, res.out));
            assertRegex("handled " + sig + "\n", res.out);
        }

        # negative: SIGHUP has no action without a handler, and SIGPIPE is always ignored
        foreach int sig in (SIGHUP, SIGPIPE) {
            foreach string mode in ("never", "unset") {
                hash<auto> res = runDisposition(script, sig, mode, "survives");
                assertEq(0, res.rc, sprintf("%s %s: %y", SignalToName{sig}, mode, res.out));
                assertRegex("alive\n", res.out);
            }
        }
        hash<auto> res = runDisposition(script, SIGHUP, "removed", "survives");
        assertEq(0, res.rc, res.out);
        assertRegex("alive\n", res.out);

        # SIGINT does as the process inherited, which an ignored SIGINT of the test run changes: the same in any case
        hash<auto> never = runDisposition(script, SIGINT, "never", "survives");
        hash<auto> removed = runDisposition(script, SIGINT, "removed", "survives");
        assertEq(never.rc, removed.rc, sprintf("%y %y", never, removed));
    }

    # a reserved signal cannot have a handler, and removing a handler that it cannot have changes nothing
    signalReservedTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        foreach int sig in (SIGALRM, SIGCHLD, SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGTRAP) {
            remove_signal_handler(sig);
            assertThrows("SIGNAL-HANDLER-ERROR", \set_signal_handler(), (sig, sub (int s) {}),
                SignalToName{sig});
        }
        # usleep() and backquote, which use SIGALRM and SIGCHLD, still work
        usleep(1ms);
        int rc;
        backquote("exit 3", \rc);
        assertEq(3, rc);
    }

    signalNegTest() {
        assertThrows("SET-SIGNAL-HANDLER-ERROR", \set_signal_handler(), (-1, sub () {}));
        assertThrows("REMOVE-SIGNAL-HANDLER-ERROR", \remove_signal_handler(), -1);
    }

    signalTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        Queue q();
        code handle = sub (int sig) {
            q.push(sig);
        };

        set_signal_handler(SIGUSR1, handle);
        kill(getpid(), SIGUSR1);
        assertEq(SIGUSR1, q.get(1s));
        remove_signal_handler(SIGUSR1);
    }

    # Test remove + immediate re-register works correctly
    signalReregisterTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        Queue q();
        set_signal_handler(SIGUSR1, sub(int sig) { q.push(sig); });
        kill(getpid(), SIGUSR1);
        assertEq(SIGUSR1, q.get(1s), "first handler received signal");

        remove_signal_handler(SIGUSR1);

        # Re-register and verify the new handler works
        Queue q2();
        set_signal_handler(SIGUSR1, sub(int sig) { q2.push(sig); });
        kill(getpid(), SIGUSR1);
        assertEq(SIGUSR1, q2.get(1s), "second handler received signal after re-register");

        remove_signal_handler(SIGUSR1);
    }

    # Regression test for stale SH_Delete status after remove-while-active + re-register
    # Uses rapid iterations to create timing races between signal thread and setHandler/removeHandler.
    # Without the fix, stale SH_Delete status would cause an assertion at signal_handler_thread line 355.
    signalRapidReregisterTest() {
        if (!HAVE_SIGNAL_HANDLING) {
            testSkip("no signal handling on this platform");
        }

        # Run many cycles of: register → send → wait → remove → re-register
        # This races the signal thread's post-handler cleanup with setHandler/removeHandler,
        # creating opportunities for the stale-status bug to trigger.
        int iterations = 50;
        int total = 0;
        for (int i = 0; i < iterations; i++) {
            Queue q();
            set_signal_handler(SIGUSR1, sub(int sig) { q.push(sig); total++; });
            kill(getpid(), SIGUSR1);
            assertEq(SIGUSR1, q.get(5s), sprintf("iteration %d: handler received signal", i));
            remove_signal_handler(SIGUSR1);
            # Immediately re-register to race with signal thread's status cleanup
        }

        # Final handler should still work after all those rapid cycles
        Queue qf();
        set_signal_handler(SIGUSR1, sub(int sig) { qf.push(sig); });
        kill(getpid(), SIGUSR1);
        assertEq(SIGUSR1, qf.get(5s), "final handler works after rapid re-register cycles");
        remove_signal_handler(SIGUSR1);

        assertEq(iterations, total, "all handlers ran");
    }
}
