#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%requires ../../../../qlib/QUnit.qm

%exec-class ParseDirectiveTest

public class ParseDirectiveTest inherits QUnit::Test {

    constructor() : Test("ParseDirectiveTest", "1.0") {
        addTestCase("else test", \elseTest());
        addTestCase("%if defined() test", \ifDefinedTest());
        addTestCase("%if boolean logic test", \ifBooleanLogicTest());
        addTestCase("%elif test", \elifTest());
        addTestCase("%if nested test", \ifNestedTest());
        addTestCase("%if error test", \ifErrorTest());
        addTestCase("strict-types test", \strictTypesTest());
        addTestCase("returns test", \returnsTest());
        addTestCase("missing arg to %append-include-path", \missingArgAppendIncludePath());
        addTestCase("missing arg to %append-module-path", \missingArgAppendModulePath());
        addTestCase("missing arg to %set-time-zone", \missingArgSetTimeZone());
        addTestCase("missing arg to %enable-warning", \missingArgEnableWarning());
        addTestCase("missing arg to %try-module", \missingArgTryModule());
        addTestCase("missing arg to %requires", \missingArgRequires());
        addTestCase("missing arg to %requires (with space)", \missingArgRequiresWithSpace());
        addTestCase("tab in arg", \tabInArg());
        addTestCase("space after %exec-class", \spaceAfterExecClass());
        addTestCase("invalid id in %try-module", \invalidIdInTryModule());
        addTestCase("ignored text before '(' in %try-module", \ignoredTextTryModule());
        addTestCase("correct %try-module", \correctTryModule());
        addTestCase("correct %requires", \correctRequires());
        addTestCase("%exec-class tests", \execClass());
        addTestCase("%exec-class crlf", \execClassCrlf());
        addTestCase("%strong-encapsulation", \strongEncapsulation());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    elseTest() {
        Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
        p.parse("
%ifdef A
int sub test() {
%ifndef X
    return -1;
%else
    return -2;
%endif
}
%else
int sub test() {
    return 1;
}
%endif
", "test");
        assertEq(1, p.callFunction("test"));
    }

    ifDefinedTest() {
        # Test basic %if defined()
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("FOO", True);
            p.parse("
%if defined(FOO)
int sub test() { return 1; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test %if !defined()
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.parse("
%if !defined(FOO)
int sub test() { return 1; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test %if defined() when not defined
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.parse("
%if defined(BAR)
int sub test() { return 0; }
%else
int sub test() { return 1; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }
    }

    ifBooleanLogicTest() {
        # Test && operator
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            p.define("B", True);
            p.parse("
%if defined(A) && defined(B)
int sub test() { return 1; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test && with one false
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            p.parse("
%if defined(A) && defined(B)
int sub test() { return 0; }
%else
int sub test() { return 1; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test || operator
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            p.parse("
%if defined(A) || defined(B)
int sub test() { return 1; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test || with both false
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.parse("
%if defined(A) || defined(B)
int sub test() { return 0; }
%else
int sub test() { return 1; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test complex expression with parentheses
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            p.define("C", True);
            p.parse("
%if (defined(A) || defined(B)) && defined(C)
int sub test() { return 1; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test !defined() with && and ||
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            p.parse("
%if defined(A) && !defined(B)
int sub test() { return 1; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }
    }

    elifTest() {
        # Test basic %elif
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("B", True);
            p.parse("
%if defined(A)
int sub test() { return 1; }
%elif defined(B)
int sub test() { return 2; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(2, p.callFunction("test"));
        }

        # Test %elif chain
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("C", True);
            p.parse("
%if defined(A)
int sub test() { return 1; }
%elif defined(B)
int sub test() { return 2; }
%elif defined(C)
int sub test() { return 3; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(3, p.callFunction("test"));
        }

        # Test %elif with boolean expression
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("X", True);
            p.define("Y", True);
            p.parse("
%if defined(A)
int sub test() { return 1; }
%elif defined(X) && defined(Y)
int sub test() { return 2; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(2, p.callFunction("test"));
        }

        # Test first true branch wins
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            p.define("B", True);
            p.parse("
%if defined(A)
int sub test() { return 1; }
%elif defined(B)
int sub test() { return 2; }
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test %else fallback
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.parse("
%if defined(A)
int sub test() { return 1; }
%elif defined(B)
int sub test() { return 2; }
%else
int sub test() { return 3; }
%endif
", "test");
            assertEq(3, p.callFunction("test"));
        }
    }

    ifNestedTest() {
        # Test nested %if
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            p.define("B", True);
            p.parse("
%if defined(A)
%if defined(B)
int sub test() { return 1; }
%else
int sub test() { return 2; }
%endif
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }

        # Test nested %if with outer false
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("B", True);
            p.parse("
%if defined(A)
%if defined(B)
int sub test() { return 1; }
%else
int sub test() { return 2; }
%endif
%else
int sub test() { return 3; }
%endif
", "test");
            assertEq(3, p.callFunction("test"));
        }

        # Test nested with %elif
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("B", True);
            p.define("C", True);
            p.parse("
%if defined(A)
int sub test() { return 1; }
%elif defined(B)
%if defined(C)
int sub test() { return 2; }
%else
int sub test() { return 3; }
%endif
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(2, p.callFunction("test"));
        }

        # Test mixing %if with %ifdef
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            p.define("B", True);
            p.parse("
%if defined(A)
%ifdef B
int sub test() { return 1; }
%else
int sub test() { return 2; }
%endif
%else
int sub test() { return 0; }
%endif
", "test");
            assertEq(1, p.callFunction("test"));
        }
    }

    ifErrorTest() {
        # Test missing expression in %if
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "missing expression in %if",
                \p.parse(), ("%if\nint x = 1;\n%endif\n", ""));
        }

        # Test %elif without %if
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "%elif found without %if",
                \p.parse(), ("%elif defined(A)\nint x = 1;\n%endif\n", ""));
        }

        # Test invalid expression
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "unexpected token",
                \p.parse(), ("%if FOO\nint x = 1;\n%endif\n", ""));
        }

        # Test missing identifier in defined()
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "expected identifier",
                \p.parse(), ("%if defined()\nint x = 1;\n%endif\n", ""));
        }

        # Test missing closing paren in defined()
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "expected '\\)'",
                \p.parse(), ("%if defined(FOO\nint x = 1;\n%endif\n", ""));
        }

        # Test unclosed %if at EOF
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "conditional block.*left open",
                \p.parse(), ("%if defined(A)\nint x = 1;\n", ""));
        }

        # Test unmatched %endif
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "unmatched %endif",
                \p.parse(), ("int x = 1;\n%endif\n", ""));
        }

        # Test %else after %else (in true branch)
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            assertThrows("PARSE-EXCEPTION", "%else already encountered",
                \p.parse(), ("%if defined(A)\nint x = 1;\n%else\nint x = 2;\n%else\nint x = 3;\n%endif\n", ""));
        }

        # Test %else after %else (in false branch going to else)
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "%else already encountered",
                \p.parse(), ("%if defined(A)\nint x = 1;\n%else\nint x = 2;\n%else\nint x = 3;\n%endif\n", ""));
        }

        # Test %elif after %else (in true branch)
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            p.define("A", True);
            assertThrows("PARSE-EXCEPTION", "%elif after %else",
                \p.parse(), ("%if defined(A)\nint x = 1;\n%else\nint x = 2;\n%elif defined(B)\nint x = 3;\n%endif\n", ""));
        }

        # Test %elif after %else (in false branch going to else)
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "%elif after %else",
                \p.parse(), ("%if defined(A)\nint x = 1;\n%else\nint x = 2;\n%elif defined(B)\nint x = 3;\n%endif\n", ""));
        }

        # Test deeply nested unclosed conditional
        {
            Program p(PO_NEW_STYLE | PO_STRICT_TYPES);
            assertThrows("PARSE-EXCEPTION", "conditional block.*left open",
                \p.parse(), ("%if defined(A)\n%if defined(B)\n%if defined(C)\nint x = 1;\n%endif\n%endif\n", ""));
        }
    }

    # Test that PO_STRICT_TYPES is 0 (support removed in Qore 2.3) and %strict-types/%loose-types
    # parse directives are silently ignored
    strictTypesTest() {
        # verify PO_STRICT_TYPES constant is 0
        assertEq(0, PO_STRICT_TYPES);

        # verify %strict-types parses without error but has no effect
        {
            Program p(PO_NEW_STYLE);
            p.parse("%strict-types\nauto sub t() { int i; return i; }", "");
            # without strict-types effect, uninitialized typed variables return NOTHING
            assertNothing(p.callFunction("t"));
        }

        # verify %loose-types parses without error
        {
            Program p(PO_NEW_STYLE);
            p.parse("%strict-types\n%loose-types\nauto sub t() { return 1; }", "");
            assertEq(1, p.callFunction("t"));
        }

        # verify PO_STRICT_TYPES | PO_NEW_STYLE equals PO_NEW_STYLE (since PO_STRICT_TYPES is 0)
        assertEq(PO_NEW_STYLE, PO_NEW_STYLE | PO_STRICT_TYPES);

        # verify uninitialized typed variables return NOTHING (not default values)
        {
            Program p(PO_NEW_STYLE);
            p.parse("auto sub t() { int i; return i; }", "");
            assertNothing(p.callFunction("t"));
        }

        {
            Program p(PO_NEW_STYLE);
            p.parse("auto sub t() { string str; return str; }", "");
            assertNothing(p.callFunction("t"));
        }

        {
            Program p(PO_NEW_STYLE);
            p.parse("auto sub t() { bool b; return b; }", "");
            assertNothing(p.callFunction("t"));
        }

        # verify delete/remove on typed variables returns NOTHING (not default values)
        {
            Program p(PO_NEW_STYLE);
            p.parse("auto sub t() { int i = 1; delete i; return i; }", "");
            assertNothing(p.callFunction("t"));
        }

        {
            Program p(PO_NEW_STYLE);
            p.parse("auto sub t() { int i = 1; remove i; return i; }", "");
            assertNothing(p.callFunction("t"));
        }
    }

    returnsTest() {
        {
            Program p();
            assertThrows("PARSE-EXCEPTION", \p.parse(), ("sub t() returns int { return 1; }", ""));
        }

        {
            Program p(PO_ALLOW_RETURNS);
            p.parse("sub t() returns int { return 1; }", "");
            assertEq(1, p.callFunction("t"));
        }
    }

    missingArgAppendIncludePath() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "missing argument to %append-include-path",
            \p.parse(), ("%append-include-path\nprint();", ""));
    }

    missingArgAppendModulePath() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "missing argument to %append-module-path",
            \p.parse(), ("%append-module-path   \nprint();", ""));
    }

    missingArgSetTimeZone() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "missing argument to %set-time-zone",
            \p.parse(), ("%set-time-zone\t   \nprint();", ""));
    }

    missingArgEnableWarning() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "missing argument to %enable-warning",
            \p.parse(), ("%enable-warning\nprint();", ""));
    }

    missingArgTryModule() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "missing argument to %try-module",
            \p.parse(), ("%try-module\n($x) xml;\nprint();\n%endtry\n", ""));
    }

    missingArgRequires() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "missing argument to %requires",
            \p.parse(), ("%requires\nprint();\n", ""));
    }

    missingArgRequiresWithSpace() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "missing argument to %requires",
            \p.parse(), ("%requires \nprint();\n", ""));
    }

    tabInArg() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        p.parse("
our $x = 0;
our $y = 0;
%append-include-path xxx\t++$x;
++$y;
%append-module-path xxx\t++$x;
++$y;
%enable-warning deprecated\t++$x;
++$y;
%disable-warning deprecated\t++$x;
++$y;
%ifdef xxx\t++$x;
$y = 9;
%endif
%ifndef yyy\t++$x;
++$y;
%endif
", "");
        p.run();
        assertEq(5, p.getGlobalVariable("y"));
        assertEq(0, p.getGlobalVariable("x"));
    }

    spaceAfterExecClass() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", \p.parse(), ("%exec-classMyClass\nclass MyClass {}", ""));
    }

    invalidIdInTryModule() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "try-module not in format.*invalid exception variable name.*",
            \p.parse(), ("%try-module (\"2%) Util\nprint();\n%endtry\nprint();\n", ""));
    }

    ignoredTextTryModule() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        assertThrows("PARSE-EXCEPTION", "try-module not in format.*extra text before.*",
            \p.parse(), ("%try-module whatever \"$@ except a parenthesis ($x) Util\nprint();\n%endtry\nprint();\n", ""));
    }

    correctTryModule() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        p.parse("%try-module\t         (\t     $x\t     \t) Util\nprint();\n%endtry\nprint();\n", "");
    }

    correctRequires() {
        Program p();
        p.replaceParseOptions(PO_DEFAULT);
        p.parse("%requires \t Util  \t   \nprint();\n", "");
    }

    execClass() {
        Program p(PO_NEW_STYLE);
        p.parse("%exec-class T\nclass T {abstract t();}", "exec-class");
        assertThrows("ABSTRACT-CLASS-ERROR", \p.run());
    }

    execClassCrlf() {
        Program p(PO_NEW_STYLE);
        p.parse("%exec-class T\r\nclass T {}\r\n", "exec-class-clrf");
    }

    strongEncapsulation() {
        testEncapsulation("namespace N; const N::c = 1;", "namespace constant");
        testEncapsulation("namespace N; class N::C;", "namespace class");
        testEncapsulation("namespace N; our int N::i = 0;", "namespace global var");
        testEncapsulation("namespace N; sub N::t() {}", "namespace function");
        testEncapsulation("namespace N { namespace N1; const N1::c = 0; }", "nested namespace constant");
        testEncapsulation("namespace N { namespace N1; sub N1::f() {} }", "nested namespace function");
        testEncapsulation("namespace N { namespace N1; class N1::C {} }", "nested namespace class");
        testEncapsulation("class C; static C::i() {}", "class method");
    }

    testEncapsulation(string code, string label) {
        {
            Program p(PO_NEW_STYLE);
            assertEq(NOTHING, p.parse(code, ""), "positive: " + label);
        }

        {
            Program p(PO_NEW_STYLE | PO_STRONG_ENCAPSULATION);
            assertThrows("PARSE-EXCEPTION", "PO_STRONG_ENCAPSULATION", \p.parse(), (code, ""), "negative: " + label);
        }

        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", "PO_STRONG_ENCAPSULATION", \p.parse(), ("%strong-encapsulation\n" + code, ""), "negative po: " + label);
        }
    }
}
