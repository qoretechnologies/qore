#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - all checks run in workers with explicit execution modes or as qcc executables
# test-platform: macos - IR optimization, JIT and AOT code generation of fused local instructions

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm
%exec-class FixedListFusedLocalsTest

#! locals that fused instructions read keep their values when a fixed list in the function is scalarized
/** The scalar replacement of fixed lists removed the store of a local holding a constant when no LoadLocal used it,
    though a fused instruction (the BranchIfLtLocalInt of a loop bound) read it, so the loop did not run (qore#7634).
    Every execution mode and a compiled executable must give the values of the AST interpreter.
*/
class FixedListFusedLocalsTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QCC_BIN ?? ENV.QORE_QCC_EXECUTABLE ?? libdir + "/qcc";
        string worker = get_script_dir() + "/fixed-list-fused-locals-worker.q";
        string prefix;
    }

    constructor() : QUnit::Test("FixedListFusedLocals", "1.0", \ARGV) {
        prefix = "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_LIBDIR=" + quote(libdir) + " ";
        addTestCase("locals of fused instructions in every execution mode", \checkModes());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private checkOutput(string out, string mode) {
        list<string> lines = select out.split("\n"), $1;
        assertEq(4, lines.size(), mode + ": all cases ran");
        assertEq((), (select lines, !($1 =~ /^PASS /)), mode + ": every case gives the expected value");
    }

    checkModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            checkOutput(ExecModeHarness::run(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode=" + mode + " "
                + quote(worker)), mode);
        }
        checkOutput(ExecModeHarness::run_ir_tier(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode=tiered "
            + quote(worker)), ExecModeHarness::IRTierName);
        TmpDir tmp("qore-fused-locals-");
        string exe = tmp.path + DirSep + "fused-locals";
        ExecModeHarness::run_any(prefix + quote(qcc_bin) + " -O2 -o " + quote(exe) + " " + quote(worker));
        assertTrue(is_file(exe), "qcc produced the executable");
        checkOutput(ExecModeHarness::run_any(prefix + quote(exe) + " -b --enable-debug"), "AOT");
    }
}
