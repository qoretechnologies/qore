%modern

module MemberNotificationChecks {
    version = "1.0";
    desc = "checks member notification dispatch across execution modes";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

public namespace MemberNotificationChecks {
    class Target {
        public { int d = 1; }
        private { list<string> events = (); }

        memberNotification(string member) {
            if (d == 13) {
                throw "NOTIFY-ERROR", "notification rejected the stored value";
            }
            push events, sprintf("%s=%d", member, self{member});
        }

        list<string> getEvents() { return events; }
        setInternally() { d = 99; }
    }

    #! checks that a notification observes the stored value and internal writes do not notify
    int sub check_typed() {
        Target g();
        g.d = 2;
        g.d += 3;
        g{"d"} = 7;
        string key = "d";
        g{key} = 11;
        g.d *= 2;
        ++g.d;
        g.setInternally();
        return g.d == 99 && g.getEvents() == ("d=2", "d=5", "d=7", "d=11", "d=22", "d=23") ? 1 : 0;
    }

    int sub check_object() {
        object g = new Target();
        g.d = 2;
        g.d += 3;
        g{"d"} = 7;
        string key = "d";
        g{key} = 11;
        g.d *= 2;
        ++g.d;
        g.setInternally();
        return g.d == 99 && g.getEvents() == ("d=2", "d=5", "d=7", "d=11", "d=22", "d=23") ? 1 : 0;
    }

    int sub check_auto(auto g) {
        g.d = 2;
        g.d += 3;
        g{"d"} = 7;
        string key = "d";
        g{key} = 11;
        g.d *= 2;
        ++g.d;
        g.setInternally();
        return g.d == 99 && g.getEvents() == ("d=2", "d=5", "d=7", "d=11", "d=22", "d=23") ? 1 : 0;
    }

    #! the exception reaches the assignment, after the new member value has been stored
    int sub check_exception() {
        object g = new Target();
        try {
            g.d = 13;
        } catch (hash<ExceptionInfo> ex) {
            return ex.err == "NOTIFY-ERROR" && g.d == 13 ? 1 : 0;
        }
        return 0;
    }

    #! returns the outcome of each check
    public hash<string, int> sub get_results() {
        return {"typed": check_typed(), "object": check_object(), "auto": check_auto(new Target()),
            "exception": check_exception()};
    }
}
