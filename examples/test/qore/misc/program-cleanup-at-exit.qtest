#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - static destructor and atexit ordering of program cleanup during exit() with dylib modules

# Copyright 2026 Qore Technologies, s.r.o.

# Programs are torn down from static destructors and atexit handlers while exit() runs, so the
# list of registered program-cleanup callbacks has to stay usable for the entire life of the
# process.  Objects with static storage duration are destroyed in reverse order of construction,
# and a module registers its callback from its module init function - which runs after that
# module's own static objects were already registered for destruction.  A destructible container
# for the callback list is therefore destroyed *first* and then read by the very teardown it
# exists to serve: the read sees a freed buffer, the size still looks non-empty because the
# container's own members are untouched, and the call jumps to whatever now occupies that heap
# memory.  That crashed oload in CI as soon as a second module needed the notification.
#
# Reproducing this needs a module that both registers a cleanup callback and owns a Program from
# an object with static storage duration.  The jni module is the one that does, and it lives in a
# different repo, so those cases degrade to a skip wherever it is not installed.
#
# The same teardown is exercised without any external module by the "staticpgm" test module, which
# does nothing but hold a Program in an object with static storage duration.  That covers the
# second hazard on the same path: libqore singletons used by Program teardown are constructed
# lazily, so a destructible singleton is registered for destruction *after* every module that owns
# a Program and is therefore destroyed *before* it - qore_exit_process() itself constructs the JIT
# singleton on its way out, which put it last in line and destroyed it first.  Program teardown
# then locked that singleton's already-destroyed std::mutex: an uncaught std::system_error and an
# aborted process on macOS, silent undefined behaviour on glibc.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires FsUtil

%try-module jni
%define NoJni
%endtry

%exec-class ProgramCleanupAtExitTest

class ProgramCleanupAtExitTest inherits QUnit::Test {
    public {
        #! the line the destructor of the global object of the module "staticpgmcode" prints at its end
        const TeardownMarker = "staticpgmcode: teardown complete";
    }

    private {
        #! the interpreter running this test, used to launch the children
        string qore_exe;
        #! environment the children need to pick up the same build as the parent
        string env_prefix = "";
        #! 1 if the test module "staticpgm" can be loaded, 0 if not, -1 if it was not checked yet
        int staticpgm_available = -1;
    }

    constructor() : Test("ProgramCleanupAtExitTest", "1.0") {
        qore_exe = ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0];
        if (ENV.LD_LIBRARY_PATH) {
            env_prefix += sprintf("LD_LIBRARY_PATH=%s ", ENV.LD_LIBRARY_PATH);
        }
        if (ENV.QORE_MODULE_DIR) {
            env_prefix += sprintf("QORE_MODULE_DIR=%s ", ENV.QORE_MODULE_DIR);
        }

        addTestCase("a clean run is reported as such", \controlTest());
        addTestCase("exit() with a cleanup callback registered does not crash", \exitTest());
        addTestCase("exit() preserves the status set by the script", \exitStatusTest());
        addTestCase("a Program owned at static scope survives exit()", \staticProgramExitTest());
        addTestCase("a Program owned at static scope preserves the exit status",
            \staticProgramExitStatusTest());
        addTestCase("a Program owned at static scope survives the end of a script that does not call exit()",
            \staticProgramNormalEndTest());
        addTestCase("Qore code run by a static Program's objects at exit() uses live thread-local data",
            \staticProgramCodeExitTest());
        addTestCase("Qore code run by a static Program's objects at the end of a script that does not call exit() "
            "runs before the library is cleaned up", \staticProgramCodeNormalEndTest());
        addTestCase("an exception raised by a static Program's destructor at the end of a script is reported",
            \staticProgramDestructorExceptionTest());
        addTestCase("the objects of a child Program that a static Program holds are destroyed while the child has "
            "its data", \staticProgramChildProgramTest());
        addTestCase("a static Program's destructor cannot start a thread when the library is cleaned up",
            \staticProgramThreadStartTest());
        addTestCase("a sandbox time limit cannot be enforced for a call made when the library is cleaned up",
            \staticProgramSandboxLimitTest());
        set_return_value(main());
    }

    #! runs "<qore> -l <module> -e '<statement>'" in a child and returns its exit status
    /** a child killed by a signal is reported by the shell as 128 + the signal number, so the
        crash this guards against shows up here as 134 (SIGABRT, raised by the C++ runtime when a
        teardown exception reaches std::terminate(), or by the JVM's crash handler) rather than as
        any status the script could have set itself
    */
    private int runChild(string statement, int expected, string module = "jni", string options = "",
            *reference<string> output, string extra_env = "") {
        # the statement is embedded in single quotes below, so it must not contain any;
        # String::find() returns -1 when the substring is absent
        @assert(statement.find("'") == -1);
        # keep the child's output when the status is not the expected one: a crash here is
        # reported by the shell only as "Abort trap: 6" or "Aborted", and the reason - a JVM fatal
        # error report, an assertion, a Qore exception - is only in the child's own output.
        # Discarding it left a CI failure with nothing to act on.
        string out_file = sprintf("%s/qore-cleanup-child-%d.log", tmp_location(), gettid());
        on_exit unlink(out_file);
        int rc = system(sprintf("%s%s%s %s -l %s -e '%s' >%s 2>&1", env_prefix, extra_env, qore_exe, options, module,
            statement, out_file));
        if (exists output) {
            output = File::readTextFile(out_file);
        }
        # a negative status means that the caller checks the status and the output itself
        if (expected >= 0 && rc != expected) {
            printf("--- child (-l %s, %s) exited with status %d, expected %d; output follows ---\n",
                module, statement, rc, expected);
            try {
                printf("%s", File::readTextFile(out_file));
            } catch (hash<ExceptionInfo> ex) {
                printf("(could not read the child's output: %s: %s)\n", ex.err, ex.desc);
            }
            printf("--- end child output ---\n");
        }
        return rc;
    }

    #! checks that the test module "staticpgm" is in the module path, and fails the test case with the reason if not
    /** "staticpgm" is a test module of the build tree (target "staticpgm"), put in the module path by run_tests.sh
        when it exists.  A build tree that was not built completely lacks it, and the children then die with a
        module load error that says nothing about the build: say what is missing and how to build it instead.

        @return true if the module can be loaded
    */
    private bool requireStaticPgm() {
        if (staticpgm_available < 0) {
            staticpgm_available = system(sprintf("%s%s -l staticpgm -e 'exit(0);' >/dev/null 2>&1", env_prefix,
                qore_exe)) == 0 ? 1 : 0;
        }
        assertTrue(staticpgm_available == 1, "the test module 'staticpgm' cannot be loaded: it is not in the module "
            "path (QORE_MODULE_DIR) because the build tree does not have it; build it with: cmake --build "
            "<build directory> --target staticpgm (run_tests.sh puts the modules of the build tree in the module "
            "path)");
        return staticpgm_available == 1;
    }

    #! a child that returns normally, to show the harness reports a clean run as 0
    /** without this, an "exit(0) gives 0" assertion could pass for the wrong reason
    */
    private controlTest() {
%ifdef NoJni
        testSkip("the jni module is not available");
%else
        assertEq(0, runChild("int i = 1; ++i;", 0), "a child that returns normally exits with 0");
%endif
    }

    private exitTest() {
%ifdef NoJni
        testSkip("the jni module is not available");
%else
        # before the fix this aborted in qore_call_program_cleanup_callback(), calling through a
        # pointer read out of the already-destroyed callback list
        assertEq(0, runChild("exit(0);", 0), "exit(0) tears the process down without crashing");
%endif
    }

    private exitStatusTest() {
%ifdef NoJni
        testSkip("the jni module is not available");
%else
        # a status that is neither 0 nor any signal-derived value, so only the script could have
        # produced it; this is what distinguishes a real teardown from a crash that happens to
        # leave a zero status behind
        assertEq(7, runChild("exit(7);", 7), "the exit status set by the script survives teardown");
%endif
    }

    #! the same teardown with no external module: "staticpgm" only holds a Program at static scope
    /** before the fix this aborted in QoreJIT::waitForBgCompileQueue(), locking the JIT
        singleton's std::mutex after ~QoreJIT() had already destroyed it
    */
    private staticProgramExitTest() {
        if (!requireStaticPgm()) {
            return;
        }
        assertEq(0, runChild("exit(0);", 0, "staticpgm"),
            "exit(0) tears the process down without crashing");
    }

    #! a script that ends normally, with no call of exit(): the teardown of the static Program runs from the exit
    #! handlers of the process after the thread-local data of the main thread was destroyed
    /** the teardown scopes of the Programs that a thread deletes were a thread_local std::vector, which the main
        thread destroyed when exit() started; the Program of "staticpgm" is deleted afterwards by a static
        destructor, which pushed onto the destroyed vector: a heap use-after-free that aborted the process
        ("corrupted double-linked list", status 134)
    */
    private staticProgramNormalEndTest() {
        if (!requireStaticPgm()) {
            return;
        }
        assertEq(0, runChild("int i = 0; ++i;", 0, "staticpgm"),
            "a script that ends normally tears the process down without crashing");
    }

    #! the static Program of the module "staticpgmcode" runs Qore code (closures, recursion, exceptions, containers) from
    #! the destructor of its global object, which runs from a static destructor after the main thread's thread-local
    #! objects were destroyed (qore#5778)
    /** the IR call-frame pool and the IR expression-handler cache were thread_local objects with destructors, which the
        main thread destroys when exit() starts: the Qore code that ran afterwards used them (a heap use-after-free; the
        child crashed with a segmentation fault in ast, ir and jit mode)
    */
    private staticProgramCodeExitTest() {
        if (system(sprintf("%s%s -l staticpgmcode -e 'exit(0);' >/dev/null 2>&1", env_prefix, qore_exe)) != 0) {
            assertTrue(False, "the test module 'staticpgmcode' cannot be loaded or crashes: it is not in the module "
                "path (QORE_MODULE_DIR) because the build tree does not have it; build it with: cmake --build "
                "<build directory> --target staticpgmcode (run_tests.sh puts the modules of the build tree in the "
                "module path)");
            return;
        }
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            string options = "--exec-mode=" + mode;
            string output = "";
            assertEq(0, runChild("exit(0);", 0, "staticpgmcode", options, \output), "exit(0): " + mode);
            assertRegex(TeardownMarker, output, "exit(0): the destructor ran to its end: " + mode);
            assertEq(7, runChild("exit(7);", 7, "staticpgmcode", options), "exit(7): " + mode);
        }
    }

    #! the static Program of the module "staticpgmcode" at the end of a script that does not call exit() (qore#6045)
    /** qore_cleanup() freed the types (and the JIT engine and the thread data) before the static destructor of the
        module deleted the Program, and the Qore code of its global object's destructor then ran on freed memory: the
        child crashed with a segmentation fault in every execution mode (valgrind: invalid reads of freed type data).
        qore_cleanup() now clears the data of the Programs that outlive the modules while the library can still run
        their code, so the destructor runs to its end, once, before the library is cleaned up
    */
    private staticProgramCodeNormalEndTest() {
        if (system(sprintf("%s%s -l staticpgmcode -e 'exit(0);' >/dev/null 2>&1", env_prefix, qore_exe)) != 0) {
            assertTrue(False, "the test module 'staticpgmcode' cannot be loaded or crashes; build it with: cmake "
                "--build <build directory> --target staticpgmcode");
            return;
        }
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            string options = "--exec-mode=" + mode;
            string output = "";
            assertEq(0, runChild("int i = 0; ++i;", 0, "staticpgmcode", options, \output), "normal end: " + mode);
            # the destructor runs exactly once: when the library is cleaned up, not again from the static destructor
            assertEq(1, (output =~ x/(staticpgmcode: teardown complete)/g).size(),
                "normal end: the destructor ran to its end once: " + mode);
            assertEq(Qore::False, output =~ /unexpected|exception/i, "normal end: no error output: " + mode);
        }
    }

    #! runs the code in \a code as the code of the static Program of "staticpgmcode" (QORE_STATICPGM_CODE_FILE) in a
    #! script that ends normally, in each execution mode, and calls \a check with the mode, the status and the output
    private runStaticProgramCode(string name, string code, code check) {
        if (system(sprintf("%s%s -l staticpgmcode -e 'exit(0);' >/dev/null 2>&1", env_prefix, qore_exe)) != 0) {
            assertTrue(False, "the test module 'staticpgmcode' cannot be loaded or crashes; build it with: cmake "
                "--build <build directory> --target staticpgmcode");
            return;
        }
        TmpDir tmp("qore-program-cleanup-" + name + "-");
        string file = tmp.path + DirSep + name + ".q";
        File f();
        f.open2(file, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(code);
        f.close();
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            string output = "";
            int rc = runChild("int i = 0; ++i;", -1, "staticpgmcode", "--exec-mode=" + mode, \output,
                sprintf("QORE_STATICPGM_CODE_FILE=%s ", file));
            check(mode, rc, output);
        }
    }

    #! an exception raised by the destructor of an object of the static Program when the library is cleaned up is
    #! reported as an unhandled exception and makes the process fail, without a crash
    private staticProgramDestructorExceptionTest() {
        runStaticProgramCode("throw", "%modern
class Thrower {
    destructor() {
        printf(\"thrower: start\\n\");
        throw \"STATICPGM-TEARDOWN-ERROR\", \"thrown by a destructor when the library is cleaned up\";
    }
}
our Thrower t = new Thrower();
", sub (string mode, int rc, string output) {
            # a crash gives 128 + the signal number
            assertTrue(rc > 0 && rc < 128, sprintf("%s: the process fails without a crash (status %d)", mode, rc));
            assertRegex("thrower: start", output, mode + ": the destructor ran");
            assertRegex("STATICPGM-TEARDOWN-ERROR", output, mode + ": the exception is reported");
        });
    }

    #! the static Program holds a child Program and an object of a class of the child, which it releases in its own
    #! destructor before the child: the object's destructor reads a global variable of the child, which still has its
    #! data, as when the owner deletes the static Program
    private staticProgramChildProgramTest() {
        runStaticProgramCode("child", "%modern
class Holder {
    private {
        Program child;
        object obj;
    }

    constructor() {
        child = new Program(PO_NEW_STYLE);
        child.parse(\"our string label = 'child-global';
class ChildObj {
    destructor() {
        printf('child destructor: %s\\n', label);
    }
}
ChildObj sub make() {
    return new ChildObj();
}\", \"child\");
        # assigns the global variable of the child
        child.run();
        obj = child.callFunction(\"make\");
    }

    destructor() {
        # the object of the child Program is released before the child Program
        delete obj;
        printf(\"holder: done\\n\");
    }
}
our Holder h = new Holder();
", sub (string mode, int rc, string output) {
            assertEq(0, rc, mode + ": the process succeeds; output: " + output);
            assertRegex("child destructor: child-global\nholder: done", output,
                mode + ": the child's object was destroyed with the child's data, before the holder ended");
        });
    }

    #! no thread can be started by Qore code that runs when the library is cleaned up: the threads have been waited
    #! for; a timed wait still times out
    private staticProgramThreadStartTest() {
        runStaticProgramCode("thread", "%modern
class Starter {
    destructor() {
        try {
            background printf(\"thread: ran\\n\");
            printf(\"thread: started\\n\");
        } catch (hash<ExceptionInfo> ex) {
            printf(\"thread: %s\\n\", ex.err);
        }
        Counter c(1);
        printf(\"wait: %d\\n\", c.waitForZero(20));
    }
}
our Starter s = new Starter();
", sub (string mode, int rc, string output) {
            assertEq(0, rc, mode + ": the process succeeds; output: " + output);
            # Counter::waitForZero() returns a non-zero error code when it times out
            assertRegex("thread: THREAD-CREATION-FAILURE\nwait: [1-9]", output,
                mode + ": the thread was refused and the timed wait timed out");
            assertEq(Qore::False, output =~ /thread: (ran|started)/, mode + ": no thread was started");
        });
    }

    #! a call with a sandbox wall time limit made by a destructor when the library is cleaned up fails at its first
    #! cancellation point: the watchdog thread that enforces the limit has been stopped and is not started again
    private staticProgramSandboxLimitTest() {
        runStaticProgramCode("sandbox", "%modern
%no-child-restrictions
class Limited {
    private {
        Program p;
    }

    constructor() {
        SandboxManager sm();
        sm.setWallTimeLimit(5000);
        p = new Program(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.parse(\"%new-style
int sub f() {
    Counter c(1);
    c.waitForZero(10);
    return 42;
}\", \"sandboxed\");
        # the limit is enforced while the library runs
        printf(\"before: %d\\n\", p.callFunction(\"f\"));
    }

    destructor() {
        try {
            printf(\"sandboxed: %d\\n\", p.callFunction(\"f\"));
        } catch (hash<ExceptionInfo> ex) {
            printf(\"sandboxed: %s: %s\\n\", ex.err, ex.desc);
        }
    }
}
our Limited l = new Limited();
", sub (string mode, int rc, string output) {
            assertEq(0, rc, mode + ": the process succeeds; output: " + output);
            assertRegex("before: 42", output, mode + ": the call succeeds while the library runs");
            assertRegex("sandboxed: SANDBOX-ERROR: .*wall time limit of 5000 ms cannot be enforced", output,
                mode + ": the call fails closed when the library is cleaned up");
        });
    }

    private staticProgramExitStatusTest() {
        if (!requireStaticPgm()) {
            return;
        }
        assertEq(7, runChild("exit(7);", 7, "staticpgm"),
            "the exit status set by the script survives teardown");
    }
}
