#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - backquote child processes: SIGINT handling, killing the process group, output pipe closing

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util

%exec-class BackquoteTest

class BackquoteTest inherits QUnit::Test {
    constructor() : QUnit::Test("Backquote test", "1.0") {
        addTestCase("Backquote test", \testBackquote());
        addTestCase("Backquote empty output", \testEmptyOutput());
        addTestCase("Backquote command not found", \testCommandNotFound());
        addTestCase("Backquote SIGINT handling", \testSignalHandling());
        addTestCase("Backquote interrupt kills process group", \testInterruptKillsProcessGroup());
        addTestCase("Backquote restricted access", \testRestrictedAccess());
        addTestCase("Backquote cancellation after the command closes its output", \testCancelAfterOutput());
        set_return_value(main());
    }

    testBackquote() {
        if (PlatformOS == "Windows") {
            testSkip("skipping because the test is being run on Windows");
        }

        assertEq("1", chomp(`/bin/echo 1`), "backquotes 1");
        assertEq("Qore is great!", chomp(`/bin/echo "Qore is great!"`), "backquotes 2");
        assertEq("Qore is great!", chomp(`/bin/echo Qore is great!`), "backquotes 3");
        assertEq("1", chomp(backquote("/bin/echo 1")), "backquote function");
        int rc;
%ifndef Windows
        backquote("cat /abcDefGHm54sdvdsCE54dfhbgzgGH45J5g4bbg4dfwrtEFG5 2>/dev/null", \rc);
%else
        backquote("cat /abcDefGHm54sdvdsCE54dfhbgzgGH45J5g4bbg4dfwrtEFG5 2>nul", \rc);
%endif
        assertEq(1, rc);
    }

    testEmptyOutput() {
        if (PlatformOS == "Windows") {
            testSkip("skipping because the test is being run on Windows");
        }

        int rc;
        string out = backquote(":", \rc);
        assertEq("", out, "backquote should return empty output");
        assertEq(0, rc, "backquote should return zero exit code");
    }

    testCommandNotFound() {
        if (PlatformOS == "Windows") {
            testSkip("skipping because the test is being run on Windows");
        }

        int rc = 0;
        string out = backquote("command_should_not_exist_12345 2>/dev/null", \rc);
        assertEq("", out, "backquote should return empty output on command not found");
        assertEq(127, rc, "backquote should return 127 for command not found");
    }

    testSignalHandling() {
        if (PlatformOS == "Windows") {
            testSkip("skipping because the test is being run on Windows");
        }

        int rc;
        backquote("trap 'exit 42' INT; kill -s INT $$; exit 0", \rc);
        assertEq(42, rc, "backquote child should handle SIGINT");
    }

    #! interrupting the sandbox of a thread in backquote() kills every process of the command
    /** The interrupt can arrive while the command's shell is starting a process: on macOS, a SIGKILL sent to the
        process group does not reach a process created at that moment, and backquote() sends it to the group again once
        the shell has ended; each command starts processes until it is killed, and several commands are interrupted,
        so that the interrupt arrives while the shell is starting a process.  The commands of the first rounds keep
        their output open, so that backquote() is reading it when it is interrupted; the others close it, so that
        backquote() is reading it or waiting for the process to exit.
    */
    testInterruptKillsProcessGroup() {
        if (PlatformOS == "Windows") {
            testSkip("skipping because the test is being run on Windows");
        }

        for (int i = 1; i <= 6; ++i) {
            interruptCommand(i, i > 3);
        }
    }

    #! runs a command in a sandboxed Program, interrupts the sandbox and checks that every process of the command ends
    /** The processes of the command hold the write end of a FIFO open, so that end-of-file on its read end shows that
        every one of them has exited.
    */
    private interruptCommand(int round, bool close_output) {
        string fifo = sprintf("%s/backquote_pgroup_fifo_%d_%d", tmp_location(), getpid(), round);
        assertEq(0, mkfifo(fifo), sprintf("round %d: FIFO created", round));
        on_exit unlink(fifo);

        SandboxManager sm();
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.setSandboxManager(sm);

        p.parse("
%modern

int sub run_backquote_rc(string cmd) {
    int lrc = 0;
    backquote(cmd, \\lrc);
    return lrc;
}
        ", "backquote_interrupt_test");

        Counter done(1);
        *string ex_err;
        int rc = -999;

        # the shell opens the FIFO on descriptor 3, which every process that it starts inherits, and writes its PID,
        # which is the ID of its process group
        string cmd = sprintf("exec 3> %s; %secho $$ >&3; i=0; while [ $i -lt 200 ]; do sleep 120 & i=$((i + 1)); "
            "done; wait", fifo, close_output ? "exec >&-; " : "");
        background sub () {
            on_exit done.dec();
            try {
                rc = p.callFunction("run_backquote_rc", cmd);
            } catch (hash<ExceptionInfo> ex) {
                ex_err = ex.err;
            }
        }();

        # blocks until the shell has opened the FIFO
        ReadOnlyFile f(fifo);
        int pgid;
        # set when processes of the command are left running
        bool left_running = False;
        on_exit {
            # ends the command if the test fails before interrupting it
            if (done.getCount()) {
                sm.requestInterrupt();
            }
            done.waitForZero();
            # the processes left running hold the FIFO open, so the ID of their process group cannot have been reused
            if (left_running) {
                kill(-pgid, SIGKILL);
            }
        }

        pgid = int(f.readLine());
        assertGt(0, pgid, sprintf("round %d: process group ID read", round));

        sm.requestInterrupt();
        # a backstop only: the interrupt ends the wait at once
        assertEq(0, done.waitForZero(20s), sprintf("round %d: the interrupted wait ended", round));
        assertEq("PROGRAM-INTERRUPTED", ex_err, sprintf("round %d: backquote() raised PROGRAM-INTERRUPTED", round));
        assertEq(-999, rc, sprintf("round %d: backquote() returned no value", round));

        # end-of-file is read when every process holding the FIFO open has exited; the timeout is a hang guard, not
        # synchronization: the processes have been killed, and the read returns when the last one has exited
        try {
            while (f.readBinary(1, 60s)) {
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "FILE-READ-TIMEOUT") {
                rethrow;
            }
            left_running = True;
        }
        assertFalse(left_running, sprintf("round %d: every process of the command has exited", round));
    }

    testRestrictedAccess() {
        if (PlatformOS == "Windows") {
            testSkip("skipping because the test is being run on Windows");
        }

        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES | PO_NO_EXTERNAL_PROCESS);
        bool parse_caught = False;
        try {
            p.parse("
%modern

string sub run_backquote() {
    return backquote(\":\");
}
            ", "backquote_restricted");
        } catch (hash<ExceptionInfo> ex) {
            parse_caught = True;
            assertEq("PARSE-EXCEPTION", ex.err, "backquote() blocked by PO_NO_EXTERNAL_PROCESS");
        }
        assertTrue(parse_caught, "backquote() should be blocked by PO_NO_EXTERNAL_PROCESS");

        Program p2(PO_NEW_STYLE | PO_NO_EXTERNAL_PROCESS);
        bool parse_op_caught = False;
        try {
            p2.parse("
%modern

string sub run_backquote_op() {
    return `/bin/echo 1`;
}
            ", "backquote_op_restricted");
        } catch (hash<ExceptionInfo> ex) {
            parse_op_caught = True;
            assertEq("PARSE-EXCEPTION", ex.err, "backquote operator blocked at parse time");
        }
        assertTrue(parse_op_caught, "backquote operator should be blocked by PO_NO_EXTERNAL_PROCESS");
    }

    #! a thread waiting for a command that has closed its output can be cancelled
    /** The command closes its standard output, so backquote() has read all of the output and waits for the process
        to exit; the wait must end when the thread is cancelled, and the process must be killed and reaped.  The wait
        could not be interrupted before (it ended only when the command exited).
    */
    testCancelAfterOutput() {
        if (PlatformOS == "Windows") {
            testSkip("skipping because the test is being run on Windows");
        }

        string fifo = sprintf("%s/backquote_fifo_%d_%d", tmp_location(), getpid(), gettid());
        assertEq(0, mkfifo(fifo));
        on_exit unlink(fifo);

        Counter done(1);
        *string err;
        *string output;
        int tid = background sub () {
            on_exit done.dec();
            try {
                # the command reports its PID through the FIFO after closing its output and then sleeps
                output = backquote(sprintf("exec >&-; echo $$ > %s; exec sleep 60", fifo));
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
        }();

        # blocks until the command has closed its output and written its PID
        int pid;
        {
            ReadOnlyFile f(fifo);
            pid = f.readLine().toInt();
        }
        assertGt(0, pid);
        on_exit {
            # ends the command if the wait was not interrupted, so that the thread ends
            if (done.getCount()) {
                kill(pid, SIGKILL);
                done.waitForZero();
            }
        }

        assertTrue(cancel_thread(tid, "test"));
        # a backstop only: the cancellation ends the wait at once
        assertEq(0, done.waitForZero(20s), "the cancelled wait ended");
        assertEq("THREAD-CANCELLED", err);
        assertEq(NOTHING, output);
        # the process has been killed and reaped before backquote() returned
        assertEq(-1, kill(pid, 0), "the process is gone");
    }
}
