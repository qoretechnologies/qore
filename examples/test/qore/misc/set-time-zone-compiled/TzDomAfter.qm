# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# module of set-time-zone-compiled.qtest: a module that declares the locale control domain in its header and sets its
# time zone after the header, where the declaration has removed the restriction (qore#6270)

%modern

module TzDomAfter {
    version = "1.0";
    desc = "a module that declares the locale control domain and sets its time zone after its header";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%set-time-zone Asia/Tokyo

public namespace TzDomAfter {
    public string sub tz_region() {
        return TimeZone::get().region();
    }
}
