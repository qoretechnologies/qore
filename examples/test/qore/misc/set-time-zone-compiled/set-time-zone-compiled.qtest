#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - time zones of programs compiled with qcc and loaded from their AOT images

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class SetTimeZoneCompiledTest

#! Regression test for issue #6270: programs compiled with qcc keep the time zone set with %set-time-zone
/** A program's \c %set-time-zone directive sets the time zone of its Program, which the dates made at run time use
    (TimeZone::get(), date(), date arithmetic).  The AOT image did not record it, so a program compiled with qcc ran
    in the time zone of the process (only the date literals, resolved when compiled, had the program's zone).

    Each program sets a time zone (a region, a UTC offset and the UTC offset 0) and prints dates made at run time;
    its output must be the one in its \c .expected file in every execution mode, on the IR tier and in programs
    compiled with qcc -O0 and -O3.
*/
class SetTimeZoneCompiledTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";

        #! the fixture programs
        const Programs = ("region", "offset", "utc");
    }

    constructor() : QUnit::Test("time zones set by programs compiled with qcc", "1.0", \ARGV) {
        foreach string name in (Programs) {
            string program_name = name;
            foreach string mode in (ExecModeHarness::ExecModes) {
                string execution_mode = mode;
                addTestCase(program_name + ": execution mode " + mode, sub () {
                    assertEq(expected(program_name), ExecModeHarness::run(command(program_name, execution_mode)));
                });
            }
            addTestCase(program_name + ": IR tier", sub () {
                assertEq(expected(program_name), ExecModeHarness::run_ir_tier(command(program_name, "tiered")));
            });
            addTestCase(program_name + ": qcc -O0", sub () { checkQcc(program_name, 0); });
            addTestCase(program_name + ": qcc -O3", sub () { checkQcc(program_name, 3); });
        }

        set_return_value(main());
    }

    private static string fixture(string name) {
        return get_script_dir() + "/" + name + ".q";
    }

    private static string expected(string name) {
        return ReadOnlyFile::readTextFile(get_script_dir() + "/" + name + ".expected");
    }

    private string command(string name, string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture(name)));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(string name, int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/" + name;
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture(name))));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected(name), backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
