# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# module of set-time-zone-compiled.qtest: a module that restricts locale control itself before its header, which
# declares another domain: the restriction applies (qore#6352)

%modern
%no-locale-control

module TzOwnOther {
    version = "1.0";
    desc = "module TzOwnOther";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "PROCESS_CONTROL";
}

%set-time-zone Asia/Tokyo

public namespace TzOwnOther {
    public string sub tz_region() {
        return TimeZone::get().region();
    }
}
