#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class DgcHandedOutValuesTest

#! counts destructor calls
class Destroyed {
    public {
        static Counter count();
    }
}

#! a value that refers back to the Queue holding it, closing a cycle through the queue's private data
class QueueValue {
    public {
        *Queue q;
    }

    constructor(*Queue q) {
        self.q = q;
    }

    destructor() {
        Destroyed::count.inc();
    }
}

#! a value that refers back to the TreeMap holding it, closing a cycle through the map's private data
class MapValue {
    public {
        *TreeMap tm;
    }

    constructor(*TreeMap tm) {
        self.tm = tm;
    }

    destructor() {
        Destroyed::count.inc();
    }
}

#! a value whose destructor uses the Queue holding it, so the queue must release it after the queue's lock
class QueueUser {
    public {
        *Queue q;
        #! the error raised in the destructor by the push, if any
        static *string error;
    }

    constructor(*Queue q) {
        self.q = q;
    }

    destructor() {
        Destroyed::count.inc();
        try {
            q.push("pushed by the destructor");
        } catch (hash<ExceptionInfo> ex) {
            QueueUser::error = ex.err;
        }
    }
}

#! a value whose destructor uses the TreeMap holding it, so the map must release it after the map's lock
class MapUser {
    public {
        *TreeMap tm;
    }

    constructor(*TreeMap tm) {
        self.tm = tm;
    }

    destructor() {
        Destroyed::count.inc();
        tm.put("b", "put by the destructor");
    }
}

#! holds a TreeMap for the threads of a test, so that the test can release the map whatever the threads still hold
class MapBox {
    public {
        *TreeMap tm;
    }

    constructor(TreeMap tm) {
        self.tm = tm;
    }
}

#! Tests that values handed out by a container whose values are scanned through private data keep the cycle alive
/** A Queue or TreeMap hands a value to the caller with its own reference; a recursive set that counted that
    reference as internal still reads the same number of references, now held from outside the set, and must not be
    collected while the caller holds the value.  See design/dgc.md, "Values handed out by a container".
*/
class DgcHandedOutValuesTest inherits QUnit::Test {
    public {
        #! the number of queues shared by the threads of the concurrent test
        const QueueCount = 2;
        #! the number of threads in the concurrent test
        const ThreadCount = 8;
        #! the number of operations each thread makes in the concurrent test
        const Iterations = 20000;
        #! the error set by setError() in the concurrent test
        const TestError = "HANDED-OUT-TEST";
    }

    constructor() : QUnit::Test("DGC values handed out by containers", "1.0") {
        addTestCase("Queue::get()", \queueGetTest());
        addTestCase("Queue::pop()", \queuePopTest());
        addTestCase("TreeMap::take()", \treeMapTakeTest());
        addTestCase("TreeMap::put() replacing a value", \treeMapReplaceTest());
        addTestCase("Queue::clear() releases its values after its lock", \queueClearReleaseTest());
        addTestCase("Queue::setError() releases its values after its lock", \queueSetErrorReleaseTest());
        addTestCase("TreeMap::put() releases the value it replaces after its lock", \treeMapPutReleaseTest());
        addTestCase("concurrent takes and scans", \concurrentTest());
        addTestCase("a value released while a scan counts it", \releasedDuringScanTest());
        set_return_value(main());
    }

    queueGetTest() {
        queueTest(False);
    }

    queuePopTest() {
        queueTest(True);
    }

    #! a value taken from a queue keeps the queue it refers to after the queue's last other reference is released
    private queueTest(bool use_pop) {
        int destroyed = Destroyed::count.getCount();
        Queue q();
        {
            QueueValue v(q);
            q.push(v);
        }
        assertSet(q, "the queue and its value");
        QueueValue v2 = use_pop ? q.pop() : q.get();
        remove q;
        assertEq(destroyed, Destroyed::count.getCount(), "nothing collected");
        assertEq(0, v2.q.size(), "the queue is still usable");
        assertEq("QueueValue", v2.className());

        # releasing the value releases both, as they no longer form a cycle
        remove v2;
        assertEq(destroyed + 1, Destroyed::count.getCount(), "the value is destroyed");
    }

    #! a value taken from a TreeMap keeps the map it refers to after the map's last other reference is released
    treeMapTakeTest() {
        int destroyed = Destroyed::count.getCount();
        TreeMap tm();
        {
            MapValue v(tm);
            tm.put("a", v);
        }
        assertSet(tm, "the map and its value");
        MapValue v2 = tm.take("a");
        remove tm;
        assertEq(destroyed, Destroyed::count.getCount(), "nothing collected");
        assertEq(NOTHING, v2.tm.getAll(), "the map is still usable");

        remove v2;
        assertEq(destroyed + 1, Destroyed::count.getCount(), "the value is destroyed");
    }

    #! a value that TreeMap::put() replaces in a cycle is released after the map's lock
    /** The map holds the value twice, so the release of one leaves a count below the one the set recorded, and the
        dereference rescans on the thread that made the put; the scan tries the map's lock, which the put held while
        it released the value, and debug builds aborted.
    */
    treeMapReplaceTest() {
        int destroyed = Destroyed::count.getCount();
        TreeMap tm();
        {
            MapValue v(tm);
            tm.put("a", v);
            tm.put("b", v);
        }
        assertSet(tm, "the map and its value");
        tm.put("a", 1);
        assertEq(destroyed, Destroyed::count.getCount(), "nothing collected");
        assertEq(1, tm.get("a"), "the value is replaced");
        assertSet(tm, "the map and the value it still holds");

        remove tm;
        assertEq(destroyed + 1, Destroyed::count.getCount(), "the map and its value are collected");
    }

    #! Queue::clear() releases the values after its lock, so that a destructor can use the queue
    /** The values were released under the queue's lock, and a destructor that used the queue blocked forever on it.
        See design/dgc.md, "Pattern B for modules: `AbstractScannablePrivateData`".
    */
    queueClearReleaseTest() {
        int destroyed = Destroyed::count.getCount();
        Queue q();
        q.push(new QueueUser(q));
        q.clear();
        assertEq(destroyed + 1, Destroyed::count.getCount(), "the value is destroyed");
        assertEq(1, q.size(), "the destructor pushed to the queue");
        assertEq("pushed by the destructor", q.get());
    }

    #! Queue::setError() releases the values after its lock, so that a destructor can use the queue
    queueSetErrorReleaseTest() {
        int destroyed = Destroyed::count.getCount();
        QueueUser::error = NOTHING;
        Queue q();
        q.push(new QueueUser(q));
        q.setError("QUEUE-TEST-ERROR", "the queue is closed");
        assertEq(destroyed + 1, Destroyed::count.getCount(), "the value is destroyed");
        assertEq("QUEUE-TEST-ERROR", QueueUser::error, "the destructor's push sees the queue's error");
        q.clearError();
        assertEq(0, q.size());
    }

    #! TreeMap::put() releases the value it replaces after its lock, so that a destructor can use the map
    treeMapPutReleaseTest() {
        int destroyed = Destroyed::count.getCount();
        TreeMap tm();
        tm.put("a", new MapUser(tm));
        tm.put("a", 1);
        assertEq(destroyed + 1, Destroyed::count.getCount(), "the value is destroyed");
        assertEq(1, tm.get("a"), "the value is replaced");
        assertEq("put by the destructor", tm.get("b"), "the destructor put a value in the map");
    }

    #! threads push values that refer back to their queue and take them while the values are scanned
    /** Each push and each take changes the cycle the queue is in, and the scans that follow run while other threads
        take the values the scan reported and release them.  A scan may then commit counts that the values no
        longer have, which is only allowed when the queue has handed a value out since the scan read it; and no value
        may be collected while a thread holds it.  At the end, every queue is counted for scanning exactly when it
        holds values.
    */
    concurrentTest() {
        list<Queue> queues = map new Queue(), xrange(QueueCount);
        Queue<hash<ExceptionInfo>> errors();
        Counter running(ThreadCount);
        for (int t = 0; t < ThreadCount; ++t) {
            background runThread(t, queues, errors, running);
        }
        running.waitForZero();

        list<hash<ExceptionInfo>> unexpected;
        while (*hash<QueueTryResult<hash<ExceptionInfo>>> r = errors.tryGet()) {
            unexpected += r.value;
        }
        assertEq(0, unexpected.size(), sprintf("unexpected errors: %y",
            (map sprintf("%s: %s", $1.err, $1.desc), unexpected)));

        foreach Queue q in (queues) {
            if (Option::HAVE_LIBRARY_DEBUGGING) {
                assertEq(q.empty() ? 0 : 1, getScanPrivateData(q), sprintf("queue %d holds %d value(s)", $#,
                    q.size()));
            }
            # clearing the queue also releases the cycles made by its values
            q.clear();
        }
    }

    #! a value released after a scan read it does not keep the scan from making the map's set
    /** A scan reads the values of a TreeMap under the map's lock and counts the references they hold after releasing
        it; a value released meanwhile has fewer references than the scan counts as internal.  The scan still makes
        the set, whose counts RSet::canDelete() does not trust because the map has given up a value since the scan read
        it: the release rescans, and the cycle that remains is collected once its last outside reference goes.  A scan
        that made no set for the component left the map and the value it still holds in no set, and they were never
        collected.  See design/dgc.md, "Values handed out by a container".
    */
    releasedDuringScanTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("needs library debugging for the scan and dereference holds");
        }
        int destroyed = Destroyed::count.getCount();
        # the threads reach the map through the box, which the test empties before the map's collection is checked:
        # a reference that a thread held would otherwise be released when the thread ends, after the check
        MapBox box(new TreeMap());
        {
            # the map holds the value twice, so that replacing one leaves a cycle
            MapValue v(box.tm);
            box.tm.put("a", v);
            box.tm.put("b", v);
        }
        assertSet(box.tm, "the map and its value");

        # the scan is held once it has read the map's values and entered the value
        Counter scan_held(1);
        Counter scan_release(1);
        # the release of the value replaced is held once it has taken its count, before it reads the value's set
        Counter deref_held(1);
        Counter deref_release(1);
        Counter scanned(1);
        Counter done(2);
        # an assertion that fails releases every hold and waits for the threads
        on_exit {
            if (scan_release.getCount()) {
                scan_release.dec();
            }
            if (deref_release.getCount()) {
                deref_release.dec();
            }
            done.waitForZero();
        }

        call_function("dbg_hold_scan_walked", "TreeMap", scan_held, scan_release);
        background sub (MapBox b) {
            on_exit done.dec();
            on_exit scanned.dec();
            call_function("dbg_rset_scan", (b.tm,), 0, True);
        }(box);
        scan_held.waitForZero();

        call_function("dbg_hold_deref_decide", "MapValue", deref_held, deref_release);
        background sub (MapBox b) {
            on_exit done.dec();
            # the map releases the value it replaces
            b.tm.put("a", 1);
        }(box);
        deref_held.waitForZero();

        # the scan counts two references from the map to a value that now has one
        scan_release.dec();
        scanned.waitForZero();
        assertSet(box.tm, "the scan made the map's set");

        # the release rescans, and the map and its value are a cycle again
        deref_release.dec();
        done.waitForZero();
        assertSet(box.tm, "the map and its value after the release");
        assertEq(destroyed, Destroyed::count.getCount(), "nothing collected");

        box.tm = NOTHING;
        assertEq(destroyed + 1, Destroyed::count.getCount(), "the map and its value are collected");
    }

    #! one thread's operations: a push followed by one of the ways to take values
    private runThread(int t, list<Queue> queues, Queue<hash<ExceptionInfo>> errors, Counter running) {
        on_exit {
            running.dec();
        }
        try {
            for (int i = 0; i < Iterations; ++i) {
                Queue q = queues[(t + i) % QueueCount];
                try {
                    q.push(new QueueValue(q));
                    *QueueValue v;
                    switch ((t + i) % 8) {
                        case 0:
                        case 1:
                            v = q.tryGet().value;
                            break;
                        case 2:
                        case 3:
                            v = q.tryPop().value;
                            break;
                        case 4:
                        case 5:
                            q.clear();
                            break;
                        case 6:
                            q.setError(TestError, "the queue is cleared by setError()");
                            q.clearError();
                            break;
                        # case 7: the value is left for the other threads to take
                    }
                    # a value taken is still usable
                    if (v) {
                        v.q.size();
                    }
                } catch (hash<ExceptionInfo> ex) {
                    # another thread set the queue's error between this thread's operations
                    if (ex.err != TestError) {
                        rethrow;
                    }
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            errors.push(ex);
        }
    }

    #! checks that the object is in a recursive set, so that the test exercises a collection decision
    /** dbg_node_info() is only available with library debugging; the set is not checked without it
    */
    private assertSet(object obj, string label) {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            return;
        }
        *list<*string> m = (call_function("dbg_node_info", obj, True) =~ x/rset: (0x[0-9a-f]+|0x0|\(nil\))/);
        assertNeq("0x0", m[0], label);
        assertNeq("(nil)", m[0], label);
    }

    #! returns the private data scan count of the given object as reported by dbg_node_info()
    private static int getScanPrivateData(object obj) {
        *list<*string> m = (call_function("dbg_node_info", obj, True) =~ x/scan_private_data: ([0-9-]+)/);
        return m[0].toInt();
    }
}
