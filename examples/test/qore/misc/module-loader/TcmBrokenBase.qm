%modern

%try-child-module TcmBroken

module TcmBrokenBase {
    version = "1.0";
    desc = "test base module with a broken child module";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

#! base module providing an extension point
public class TcmBrokenBase {
    #! returns a fixed string
    static string hello() {
        return "hello";
    }
}
