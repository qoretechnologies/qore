%modern

%requires(reexport) TcmCycleA
%try-child-module TcmCycleA

module TcmCycleB {
    version = "1.0";
    desc = "test module for mutual child module declarations";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
    init = sub () {
        TcmCycleA::trace += "b";
    };
}
