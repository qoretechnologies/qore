# -*- mode: qore; indent-tabs-mode: nil -*-
# TcmVerOkBase.qm - base module declaring a child module with a matching version constraint

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%try-child-module TcmVerChild >= 1.0

module TcmVerOkBase {
    version = "1.0";
    desc = "test base module with a matching child module version";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

#! base module recording module initialization
public class TcmVerOkBase {
    public {
        #! trace of module initialization in the order in which it occurred
        static list<string> trace;
    }

    #! adds an entry to the trace
    static add(string entry) {
        trace += entry;
    }
}
