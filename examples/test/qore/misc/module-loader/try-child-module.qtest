#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# Tests the %try-child-module parse directive: a base module declares optional child modules that extend it,
# and the module loader attaches them once the base module has been fully loaded and published.
#
# See design/qore-module-structure.md "Child Modules" and issue #5364.
#
# NOTE: module registration is global and permanent in a process, so each test case uses its own set of
# fixture modules; a module can only be loaded (or fail to load) once per process.

%modern

# required for Program::loadApplyToUserModuleWarn() in the PO_NO_MODULES test case
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class TryChildModuleTest

public class TryChildModuleTest inherits QUnit::Test {
    private {
        # absolute path to the directory holding the fixture modules
        string dir;

        # the qore binary running this test; used for test cases that need their own module registry
        string qore_bin;
    }

    constructor() : Test("Try child module test", "1.0") {
        addTestCase("absent and present children", \basicTest());
        addTestCase("child module attach order", \orderTest());
        addTestCase("nested module load", \nestedTest());
        addTestCase("child module loaded first", \childFirstTest());
        addTestCase("mutual child declarations", \cycleTest());
        addTestCase("broken child module", \brokenTest());
        addTestCase("broken child module reporting", \brokenReportTest());
        addTestCase("version constraints", \versionTest());
        addTestCase("PO_NO_MODULES", \noModulesTest());
        addTestCase("declaration errors", \declarationErrorTest());
        addTestCase("AOT-compiled parent module", \aotTest());

        dir = get_script_dir();
        if (dir !~ /^\//) {
            dir = getcwd() + "/" + dir;
        }

        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";

        set_return_value(main());
    }

    #! loads the given module into a new Program object using the fixture directory as the module path
    /** @param mod the module to load
        @param extra_code optional code parsed into the Program after the module has been loaded; used to
        provide accessors for module state, which is otherwise not visible in this Program
    */
    private Program loadModule(string mod, *string extra_code) {
        Program p(PO_NEW_STYLE);
        p.parse(sprintf("%%prepend-module-path %y\n%%requires %s\n%s", dir, mod, extra_code ?? ""), mod);
        return p;
    }

    #! returns the child module info for the given module
    private *hash<auto> childInfo(string mod) {
        hash<string, hash<auto>> mh = get_module_hash();
        return mh{mod}."child-modules";
    }

    #! runs the given code in a subprocess with the fixture directory as the module path
    /** used for checks that need a module registry of their own, or that must observe what the module
        loader writes to the console; returns the merged standard output and error output

        @param code the script to run
    */
    private string runScript(string code) {
        TmpFile tmp("tcm-", ".qr");
        tmp.file.write(code);
        tmp.file.close();
        return backquote(sprintf("QORE_MODULE_DIR=%s %s %s 2>&1", dir, qore_bin, tmp.path));
    }

    basicTest() {
        Program p = loadModule("TcmBase",
            "list<string> sub get_trace() { return TcmBase::trace; }\n"
            "list<string> sub get_children() { return keys TcmBase::children; }\n");

        # the child module's initialization code runs after the parent module has been initialized
        assertEq(("base-init", "child:ext"), p.callFunction("get_trace"));
        assertEq(("ext",), p.callFunction("get_children"));

        # the child module's namespace is not imported into a Program that loads the parent module
        assertThrows("PARSE-EXCEPTION", "TcmExtHelper", \loadModule(),
            ("TcmBase", "string sub get_first() { return TcmExtHelper::firstTraceEntry(); }\n"));

        *hash<auto> ci = childInfo("TcmBase");
        assertEq(("TcmExt", "TcmNoSuchChildModule"), keys ci);
        assertEq("attached", ci.TcmExt.status);
        assertEq("TcmExt", ci.TcmExt.spec);

        # a child module that is not installed is not an error and is reported as absent
        assertEq("absent", ci.TcmNoSuchChildModule.status);
        assertNothing(ci.TcmNoSuchChildModule.err);
        assertNothing(ci.TcmNoSuchChildModule.desc);

        # the child module was loaded and can be used by code that requires it explicitly
        Program p2 = loadModule("TcmExt",
            "string sub get_first() { return TcmExtHelper::firstTraceEntry(); }\n");
        assertEq("base-init", p2.callFunction("get_first"));
    }

    orderTest() {
        Program p = loadModule("TcmOrderBase",
            "list<string> sub get_trace() { return TcmOrderBase::trace; }\n");

        # children are attached in declaration order, and a child module's own children are attached before
        # the next declaration in the parent
        assertEq(("order1", "order1child", "order2"), p.callFunction("get_trace"));

        assertEq("attached", childInfo("TcmOrderBase").TcmOrder1.status);
        assertEq("attached", childInfo("TcmOrderBase").TcmOrder2.status);
        assertEq("attached", childInfo("TcmOrder1").TcmOrder1Child.status);
    }

    nestedTest() {
        # TcmNestOuter requires TcmNestBase, which declares TcmNestExt as a child module; TcmNestExt requires
        # TcmNestOuter in turn.  The child module can only be parsed once the outermost module load has
        # completed, so this fails unless child attachment is deferred to the outermost load boundary
        Program p = loadModule("TcmNestOuter",
            "list<string> sub get_trace() { return TcmNestBase::trace; }\n");

        assertEq(("outer", "ext:outer"), p.callFunction("get_trace"));
        assertEq("attached", childInfo("TcmNestBase").TcmNestExt.status);
    }

    childFirstTest() {
        # loading the child module first pulls in the parent module, which then declares the child module
        # that is already being loaded in this thread; the in-flight load must be left to complete
        Program p = loadModule("TcmReExt", "list<string> sub get_trace() { return TcmReBase::trace; }\n");

        assertEq(("base", "ext"), p.callFunction("get_trace"));
        assertEq("attached", childInfo("TcmReBase").TcmReExt.status);
    }

    cycleTest() {
        # TcmCycleA declares TcmCycleB as a child module, and TcmCycleB declares TcmCycleA in turn; both
        # modules must load, and neither the attach nor module teardown may recurse
        Program p = loadModule("TcmCycleA", "list<string> sub get_trace() { return TcmCycleA::trace; }\n");

        assertEq(("a", "b"), p.callFunction("get_trace"));
        assertEq("attached", childInfo("TcmCycleA").TcmCycleB.status);
        assertEq("attached", childInfo("TcmCycleB").TcmCycleA.status);
    }

    brokenTest() {
        # a child module declaration is optional, so a child that is present but cannot be loaded must not
        # make the module that declares it unusable: the failure is reported and the child is skipped
        Program p = loadModule("TcmBrokenBase",
            "string sub broken_hello() { return TcmBrokenBase::hello(); }\n");
        assertEq("hello", p.callFunction("broken_hello"));

        # the child module's own error is recorded so that a broken extension can be told from an absent
        # one; this is the only place the diagnostic survives, so it must not be swallowed
        *hash<auto> ci = childInfo("TcmBrokenBase");
        assertEq("failed", ci.TcmBroken.status);
        assertEq("PARSE-EXCEPTION", ci.TcmBroken.err);
        assertRegex("no_such_method", ci.TcmBroken.desc);

        # the child module was not registered, and its namespace is not visible through the parent
        assertNothing(get_module_hash().TcmBroken);
        assertThrows("PARSE-EXCEPTION", "TcmBrokenChild", \loadModule(),
            ("TcmBrokenBase", "string sub get_child() { return TcmBrokenChild::hello(); }\n"));

        # the failure is remembered: the child's failing load is not retried on every load of the parent,
        # and the parent module keeps working
        Program p2 = loadModule("TcmBrokenBase",
            "string sub broken_hello2() { return TcmBrokenBase::hello(); }\n");
        assertEq("hello", p2.callFunction("broken_hello2"));
        assertEq("failed", childInfo("TcmBrokenBase").TcmBroken.status);
    }

    brokenReportTest() {
        # A broken child must never be silently indistinguishable from an absent one, so it is always
        # reported.  Both channels are checked here, each in a process of its own, since a module can only
        # fail to load once per process: a %requires load has no warning sink separate from its exception
        # sink and therefore writes to the console, while Program::loadModuleWarn() has one and gets a
        # MODULE-CHILD-FAILED warning.
        string out = runScript("%modern
%requires TcmBrokenBase

printf(\"hello: %s\\n\", TcmBrokenBase::hello());
");
        assertRegex("warning: module 'TcmBrokenBase': child module 'TcmBroken' declared with "
            "%try-child-module is present but failed to load and was skipped", out);
        # the child module's own error must be part of the message; it is how the broken child is found
        assertRegex("PARSE-EXCEPTION: cannot resolve call 'TcmBrokenBase::no_such_method\\(\\)'", out);
        assertRegex("hello: hello", out);

        out = runScript("%modern
Program p(PO_NEW_STYLE);
*hash<ExceptionInfo> w = p.loadModuleWarn(\"TcmBrokenBase\", WARN_MODULES);
printf(\"warn: %s: %s: %s\\n\", w.err, w.arg, w.desc);
p.parse(\"string sub h() { return TcmBrokenBase::hello(); }\\n\", \"use\");
printf(\"hello: %s\\n\", p.callFunction(\"h\"));
");
        assertRegex("warn: MODULE-CHILD-FAILED: TcmBroken: module 'TcmBrokenBase': child module "
            "'TcmBroken' declared with %try-child-module is present but failed to load and was skipped",
            out);
        assertRegex("hello: hello", out);
        # with a warning sink available nothing is written to the console
        assertFalse(out =~ /^warning: /m);
    }

    versionTest() {
        # a version constraint that the installed child module satisfies
        Program p = loadModule("TcmVerOkBase",
            "list<string> sub get_trace() { return TcmVerOkBase::trace; }\n");
        assertEq(("ver-child",), p.callFunction("get_trace"));
        assertEq("attached", childInfo("TcmVerOkBase").TcmVerChild.status);
        assertEq("TcmVerChild >= 1.0", childInfo("TcmVerOkBase").TcmVerChild.spec);

        # a child module that is installed but does not satisfy the version constraint is a failed child,
        # not an absent one; like any other broken child it is reported and skipped
        Program p2 = loadModule("TcmVerBadBase",
            "string sub ver_hello() { return TcmVerBadBase::hello(); }\n");
        assertEq("hello", p2.callFunction("ver_hello"));

        *hash<auto> ci = childInfo("TcmVerBadBase");
        assertEq("failed", ci.TcmVerChild.status);
        assertEq("LOAD-MODULE-ERROR", ci.TcmVerChild.err);
        assertRegex("does not satisfy", ci.TcmVerChild.desc);
    }

    noModulesTest() {
        # a module loaded into a Program container that cannot load modules must not load child modules
        Program p(PO_NO_MODULES|PO_NEW_STYLE|PO_NO_CHILD_PO_RESTRICTIONS);
        *hash<ExceptionInfo> w = p.loadApplyToUserModuleWarn(dir + "/TcmNmBase.qm");

        assertEq("MODULE-CHILD-SKIPPED", w.err);
        assertRegex("PO_NO_MODULES", w.desc);

        *hash<auto> ci = childInfo("TcmNmBase");
        assertEq("skipped", ci.TcmNmExt.status);
        assertRegex("PO_NO_MODULES", ci.TcmNmExt.desc);

        # the child module was not loaded
        hash<string, hash<auto>> mh = get_module_hash();
        assertNothing(mh.TcmNmExt);
    }

    declarationErrorTest() {
        # the directive is only valid in a user module
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", "can only be used in a user module", \p.parse(),
                ("%try-child-module Foo\n", "non-module"));
        }

        # the module name is required
        {
            Program p(PO_NEW_STYLE);
            assertThrows("PARSE-EXCEPTION", "missing argument", \p.parse(),
                ("%try-child-module\n", "no-arg"));
        }

        # a module cannot declare itself as a child module
        assertThrows("PARSE-EXCEPTION", "cannot declare itself as a child module", \loadModule(),
            ("TcmSelf",));

        # the same child module cannot be declared twice
        assertThrows("PARSE-EXCEPTION", "already been declared", \loadModule(), ("TcmDup",));
    }

    aotTest() {
        # a qlib module normally reaches deployments as an AOT-compiled binary module, so child module
        # declarations must survive AOT compilation; they are delivered by the module description function
        string qcc = dirname(qore_bin) + "/qcc";
        if (!is_executable(qcc)) {
            testSkip("no qcc found at " + qcc + "; cannot test AOT-compiled child module declarations");
            return;
        }

        TmpDir tmp();

        # the parent module is AOT-compiled; its source is removed afterwards so that only the binary
        # artifact can be loaded
        string base_src = tmp.path + "/AotTcmBase.qm";
        File f();
        f.open2(base_src, O_WRONLY | O_CREAT | O_TRUNC);
        f.write("%modern
%try-child-module AotTcmExt
%try-child-module AotTcmNoSuchChildModule

module AotTcmBase {
    version = \"1.0\";
    desc = \"AOT test base module for %try-child-module\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
}

public class AotTcmBase {
    public {
        static hash<string, code> children;
        static list<string> registrations;
    }

    static registerChild(string name, code generator) {
        children{name} = generator;
        push registrations, name;
    }
}
");
        f.close();

        # the child module is also AOT-compiled; its initializer extends state owned by the parent module.
        # This is the deployment shape used by provider extensions such as SalesforcePubSubDataProvider.
        string child_src = tmp.path + "/AotTcmExt.qm";
        f.open2(child_src, O_WRONLY | O_CREAT | O_TRUNC);
        f.write("%modern
%requires(reexport) AotTcmBase

module AotTcmExt {
    version = \"1.0\";
    desc = \"AOT test child module for %try-child-module\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
    init = sub () {
        AotTcmBase::registerChild(\"ext\", sub (string name) {});
    };
}

public class AotTcmExtConstObject {
    private {
        string v = \"const-ext\";
    }

    public string value() {
        return v;
    }
}

public const AotTcmExtConst = new AotTcmExtConstObject();
");
        f.close();

        string qmod = tmp.path + "/AotTcmBase.qmod";
        string cmd = sprintf("%s -m %s -o %s 2>&1", qcc, base_src, qmod);
        string out = backquote(cmd);
        if (!is_file(qmod)) {
            testSkip("AOT compilation is not available in this build: " + out);
            return;
        }

        string child_qmod = tmp.path + "/AotTcmExt.qmod";
        cmd = sprintf("QORE_MODULE_DIR=%s %s -m %s -o %s 2>&1", tmp.path, qcc, child_src, child_qmod);
        out = backquote(cmd);
        if (!is_file(child_qmod)) {
            testSkip("AOT child compilation is not available in this build: " + out);
            return;
        }
        unlink(base_src);
        unlink(child_src);

        # qore -l loads the parent without a surrounding script parse frame.  The AOT child attach path must
        # still install thread-local program data before running the child's top-level constant initializer.
        out = backquote(sprintf(
            "QORE_LIBDIR=%s LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -l AotTcmBase "
                + "-e 'printf(\"%%s\\n\", \"cli-load-ok\");' 2>&1; echo EXIT=$?",
            dirname(qore_bin), dirname(qore_bin), tmp.path, qore_bin));
        assertEq("cli-load-ok\nEXIT=0\n", out,
            "qore -l must initialize AOT child module constants without a thread-local frame crash");

        # run the check in a subprocess: the modules must be loaded in a process where they are not yet
        # registered, and module registration is global and permanent
        string script = tmp.path + "/aot-child.qr";
        f.open2(script, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(sprintf("%%modern
%%prepend-module-path %y
%%requires AotTcmBase
%%requires AotTcmExt

hash<string, hash<auto>> mh = get_module_hash();
printf(\"status: %%s\\n\", mh.AotTcmBase.\"child-modules\".AotTcmExt.status);
printf(\"absent: %%s\\n\", mh.AotTcmBase.\"child-modules\".AotTcmNoSuchChildModule.status);
printf(\"children: %%y\\n\", keys AotTcmBase::children);
printf(\"registrations: %%y\\n\", AotTcmBase::registrations);
printf(\"const: %%s\\n\", AotTcmExtConst.value());
", tmp.path));
        f.close();

        out = backquote(sprintf("%s %s 2>&1", qore_bin, script));
        assertRegex("status: attached", out);
        assertRegex("absent: absent", out);
        assertRegex("children: \\[\"ext\"\\]", out);
        assertRegex("registrations: \\[\"ext\"\\]", out);
        assertRegex("const: const-ext", out);

        # Loading the AOT child first pulls in its parent, whose child-attachment pass observes the child as
        # already in progress.  Completing the explicit child load must still initialize it exactly once.
        string child_first_script = tmp.path + "/aot-child-first.qr";
        f.open2(child_first_script, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(sprintf("%%modern
%%prepend-module-path %y
%%requires AotTcmExt
%%requires AotTcmBase

hash<string, hash<auto>> mh = get_module_hash();
printf(\"status: %%s\\n\", mh.AotTcmBase.\"child-modules\".AotTcmExt.status);
printf(\"registrations: %%y\\n\", AotTcmBase::registrations);
", tmp.path));
        f.close();

        out = backquote(sprintf("%s %s 2>&1", qore_bin, child_first_script));
        assertRegex("status: attached", out);
        assertRegex("registrations: \\[\"ext\"\\]", out);

        # An exception from the deferred AOT child initializer is reported and the child skipped, just like
        # an exception from a source child module's init closure; the parent module stays usable.
        string broken_base_src = tmp.path + "/AotTcmBrokenBase.qm";
        f.open2(broken_base_src, O_WRONLY | O_CREAT | O_TRUNC);
        f.write("%modern
%try-child-module AotTcmBrokenExt

module AotTcmBrokenBase {
    version = \"1.0\";
    desc = \"AOT child init failure test parent\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
}

public class AotTcmBrokenBase {
    static string hello() {
        return \"broken-base\";
    }
}
");
        f.close();

        string broken_child_src = tmp.path + "/AotTcmBrokenExt.qm";
        f.open2(broken_child_src, O_WRONLY | O_CREAT | O_TRUNC);
        f.write("%modern
%requires(reexport) AotTcmBrokenBase

module AotTcmBrokenExt {
    version = \"1.0\";
    desc = \"AOT child init failure test child\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
    init = sub () {
        throw \"AOT-CHILD-INIT-ERROR\", \"intentional AOT child initialization failure\";
    };
}
");
        f.close();

        string broken_base_qmod = tmp.path + "/AotTcmBrokenBase.qmod";
        out = backquote(sprintf("%s -m %s -o %s 2>&1", qcc, broken_base_src, broken_base_qmod));
        assertTrue(is_file(broken_base_qmod), "the broken AOT parent fixture compiles: " + out);

        # Compile the child against a parent API stub without the child declaration.  Loading the real parent
        # while compiling the child would correctly attach the source child and run its intentionally failing
        # initializer before qcc could produce the fixture artifact.
        string stub_dir = tmp.path + "/broken-compile-stub";
        mkdir(stub_dir, 0755);
        string stub_src = stub_dir + "/AotTcmBrokenBase.qm";
        f.open2(stub_src, O_WRONLY | O_CREAT | O_TRUNC);
        f.write("%modern
module AotTcmBrokenBase {
    version = \"1.0\";
    desc = \"AOT child init failure compile stub\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
}
");
        f.close();
        string broken_child_qmod = tmp.path + "/AotTcmBrokenExt.qmod";
        out = backquote(sprintf("QORE_MODULE_DIR=%s %s -m %s -o %s 2>&1", stub_dir, qcc,
            broken_child_src, broken_child_qmod));
        assertTrue(is_file(broken_child_qmod), "the broken AOT child fixture compiles: " + out);
        unlink(broken_base_src);
        unlink(broken_child_src);

        string broken_script = tmp.path + "/aot-broken-child.qr";
        f.open2(broken_script, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(sprintf("%%modern
%%prepend-module-path %y
try {
    load_module(\"AotTcmBrokenBase\");
    # the module is loaded at run time, so the parent's class cannot be resolved at parse time here
    printf(\"first: ok: %%s\\n\", call_static_method(\"AotTcmBrokenBase\", \"hello\"));
} catch (hash<ExceptionInfo> ex) {
    printf(\"first: %%s: %%s\\n\", ex.err, ex.desc);
}
hash<string, hash<auto>> mh = get_module_hash();
printf(\"status: %%s\\n\", mh.AotTcmBrokenBase.\"child-modules\".AotTcmBrokenExt.status);
printf(\"stored: %%s: %%s\\n\", mh.AotTcmBrokenBase.\"child-modules\".AotTcmBrokenExt.err,
    mh.AotTcmBrokenBase.\"child-modules\".AotTcmBrokenExt.desc);
try {
    load_module(\"AotTcmBrokenBase\");
    printf(\"second: ok\\n\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"second: %%s: %%s\\n\", ex.err, ex.desc);
}
", tmp.path));
        f.close();

        out = backquote(sprintf("%s %s 2>&1", qore_bin, broken_script));
        # the parent module loads and its own symbols work without the optional extension
        assertRegex("first: ok: broken-base", out);
        assertRegex("second: ok", out);
        # the child's initialization error is reported with both module names
        assertRegex("warning: module 'AotTcmBrokenBase': child module 'AotTcmBrokenExt' declared with "
            "%try-child-module is present but failed to load and was skipped", out);
        assertRegex("AOT-CHILD-INIT-ERROR: intentional AOT child initialization failure", out);
        assertRegex("status: failed", out);
        assertRegex("stored: AOT-CHILD-INIT-ERROR: intentional AOT child initialization failure", out);
        # the failing child load is not retried, so the report is made exactly once
        assertEq(1, (select out.split("\n"), $1 =~ /child module 'AotTcmBrokenExt'/).size());
    }
}
