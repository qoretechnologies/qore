#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - module manager loading of source and AOT modules, dlopen of AOT qmods and reload of injected modules

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}/../../.."
%requires QUnit
%requires FsUtil
%requires ExecModeHarness

%exec-class ModuleLoadFailureCleanupTest

#! A failed module load releases its registration with the module manager (#5706)
/** A module that loads a module successfully and then fails (a binary module it requires is missing) must leave no
    dependency registration behind: the module manager asserts at exit in a debug build that every registration was
    released, and a leaked one is a leak in a release build.

    The cases run a child Qore in every execution mode with \c --enable-debug, and check that the failure is raised
    each time the module is loaded, that a module loaded before the failure stays usable, and that the process ends
    normally (an assertion failure ends it with a signal).
*/
class ModuleLoadFailureCleanupTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;
        TmpDir tmp("qore-module-load-failure-cleanup-");
        string src_dir;
        string qmod_dir;
        string script_path;

        #! the feature that no module path provides
        const Missing = "no_such_binary_module_for_5706";

        #! the output of every run
        const Expected = "load 1: LOAD-MODULE-ERROR: names the missing module
load 2: LOAD-MODULE-ERROR: names the missing module
good: 1
";
    }

    constructor() : QUnit::Test("ModuleLoadFailureCleanupTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        src_dir = tmp.path + "/src";
        qmod_dir = tmp.path + "/qmod";
        mkdir(src_dir);
        mkdir(qmod_dir);
        script_path = tmp.path + "/load.q";

        writeFile(src_dir + "/CleanupGood.qm", moduleCode("CleanupGood", ""));
        writeFile(src_dir + "/CleanupFailSource.qm", moduleCode("CleanupFailSource",
            "%requires CleanupGood\n%requires " + Missing + "\n"));
        # the AOT module requires json, which is hidden when it is loaded
        writeFile(src_dir + "/CleanupFailAot.qm", moduleCode("CleanupFailAot", "%requires CleanupGood\n%requires json\n"));
        writeFile(script_path, script());

        addTestCase("a source module that fails after loading a module leaves no registration",
            \testSourceModule());
        addTestCase("an AOT module that fails after loading a module leaves no registration", \testAotModule());
        addTestCase("a failed reload of a module keeps the registration of the module it replaces",
            \testFailedReload());
        addTestCase("a directory module that fails after loading a module leaves no registration (#5953)",
            \testDirectoryModule());
        addTestCase("compiling a directory module that fails to parse leaves no registration (#5953)",
            \testCompileDirectoryModule());
        addTestCase("a failed load is not a successful one", \testNegative());
        set_return_value(main());
    }

    private string writeFile(string path, string contents) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(contents);
        f.close();
        return path;
    }

    private string moduleCode(string name, string requires) {
        return sprintf("%%modern
%s
module %s {
    version = \"1.0\";
    desc = \"module load failure cleanup test module\";
    author = \"Qore\";
    license = \"MIT\";
}

public namespace %s {
    public const Value = 1;
}
", requires, name, name);
    }

    private string script() {
        return "%modern
sub load(string feature, string label, string missing) {
    try {
        Program p();
        p.parse(\"%requires \" + feature + \"\\n\", \"load\");
        printf(\"%s: loaded\\n\", label);
    } catch (hash<ExceptionInfo> ex) {
        printf(\"%s: %s: %s\\n\", label, ex.err, index(ex.desc, missing) != -1 ? \"names the missing module\" : ex.desc);
    }
}

string feature = ARGV[0];
string missing = ARGV[1];
load(feature, \"load 1\", missing);
load(feature, \"load 2\", missing);
Program p();
p.parse(\"%requires CleanupGood\\nint sub get() { return CleanupGood::Value; }\", \"good\");
printf(\"good: %d\\n\", p.callFunction(\"get\"));
";
    }

    #! runs the script in a child with only the given module directories in the module path
    private hash<ExecModeHarness::ModeRunResult> run(string module_path, string feature, string missing,
            string mode) {
        return ExecModeHarness::run_command(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s "
            "QORE_MODULE_DIR_ONLY=1 QORE_MODULE_DIR=%s %s -b --enable-debug --exec-mode=%s %s %s %s", libqore_dir,
            libqore_dir, libqore_dir, module_path, qore_bin, mode, script_path, feature, missing), True);
    }

    testSourceModule() {
        # the module path must provide the features that the child script itself needs: none
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = run(src_dir, "CleanupFailSource", Missing, mode);
            assertEq(0, r.rc, sprintf("source, %s: exit status; output: %s", mode, r.out));
            assertEq(Expected, r.stdout, sprintf("source, %s: output", mode));
        }
    }

    testAotModule() {
        # the compiler needs json, which the module requires: it is found in the module path of this test (the
        # directories of the binary modules), after the module's own directory
        string module_path = src_dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : "");
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s "
            "QORE_MODULE_DIR='%s' %s -b --compile-module --output %s %s 2>&1", libqore_dir, libqore_dir, libqore_dir,
            module_path, qore_bin, qmod_dir + "/CleanupFailAot.qmod", src_dir + "/CleanupFailAot.qm"));
        if (!is_file(qmod_dir + "/CleanupFailAot.qmod")) {
            testSkip("AOT module compilation is not available: " + compile_out);
        }
        # CleanupGood stays a source module; json is found by no module directory
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = run(qmod_dir + ":" + src_dir, "CleanupFailAot", "json", mode);
            assertEq(0, r.rc, sprintf("AOT, %s: exit status; output: %s", mode, r.out));
            assertEq(Expected, r.stdout, sprintf("AOT, %s: output", mode));
        }
    }

    #! a failed reload_module() of an injected module that another module requires (#5706)
    /** The previous module stays registered while the new one loads, so the failed load must leave its registration,
        and the registrations of its dependents, as they were: the module manager asserted at exit in a debug build
        when it released them
    */
    testFailedReload() {
        string dir = tmp.path + "/reload";
        mkdir(dir);
        string good = moduleCode("ReloadF", "%requires CleanupGood\n");
        writeFile(dir + "/CleanupGood.qm", moduleCode("CleanupGood", ""));
        writeFile(dir + "/ReloadF.qm", good);
        writeFile(dir + "/ReloadH.qm", moduleCode("ReloadH", "%requires ReloadF\n"));
        string bad = moduleCode("ReloadF", "%requires CleanupGood\n%requires " + Missing + "\n");
        string reload_script = dir + "/reload.q";
        writeFile(reload_script, sprintf("%%modern
%%no-child-restrictions
%%allow-injection
Program p(PO_NO_CHILD_PO_RESTRICTIONS);
p.loadApplyToUserModule(\"ReloadF\");
Program p2(PO_NO_CHILD_PO_RESTRICTIONS);
p2.loadApplyToUserModule(\"ReloadH\");
sub write(string contents) {
    File f();
    f.open2(\"%s/ReloadF.qm\", O_WRONLY | O_TRUNC);
    f.write(contents);
    f.close();
}
write(\"%s\");
try {
    reload_module(\"ReloadF\");
    print(\"reload 1: ok\\n\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"reload 1: %%s: %%s\\n\", ex.err, ex.desc =~ /%s/ ? \"missing\" : ex.desc);
}
write(\"%s\");
reload_module(\"ReloadF\");
print(\"reload 2: ok\\n\");
", dir, escapeForScript(bad), Missing, escapeForScript(good)));
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s QORE_MODULE_DIR_ONLY=1 QORE_MODULE_DIR=%s %s -b --enable-debug "
                "--exec-mode=%s %s", libqore_dir, libqore_dir, libqore_dir, dir, qore_bin, mode, reload_script), True);
            assertEq(0, r.rc, sprintf("reload, %s: exit status; output: %s", mode, r.out));
            assertEq("reload 1: LOAD-MODULE-ERROR: missing\nreload 2: ok\n", r.stdout,
                sprintf("reload, %s: output", mode));
        }
    }

    #! writes the directory module CleanupFailDir to \a dir, failing if \a fail is set; returns the module directory
    private string writeDirectoryModule(string dir, bool fail) {
        string mod_dir = dir + "/CleanupFailDir";
        if (!is_dir(mod_dir)) {
            mkdir(mod_dir);
        }
        writeFile(mod_dir + "/CleanupFailDir.qm", directoryModuleCode(fail));
        writeFile(mod_dir + "/Extra.qc", "%modern\npublic namespace CleanupFailDir {\n    public const Extra = 2;\n}\n");
        return mod_dir;
    }

    #! the main file of the directory module CleanupFailDir; it loads CleanupGood before it fails if \a fail is set
    private string directoryModuleCode(bool fail) {
        return moduleCode("CleanupFailDir", "%requires CleanupGood\n" + (fail ? "%requires " + Missing + "\n" : ""));
    }

    #! a directory module that loads a user module and then fails is loaded in every way, then loaded once fixed (#5953)
    /** The failed loads must leave no dependency registration of the module behind; the module manager asserted at
        exit in a debug build when one was left.  The module, fixed, is then loaded under the same name in the same
        process, and its dependency on CleanupGood orders its teardown.
    */
    testDirectoryModule() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string dir = tmp.path + "/dir-" + mode;
            mkdir(dir);
            writeFile(dir + "/CleanupGood.qm", moduleCode("CleanupGood", ""));
            string mod_dir = writeDirectoryModule(dir, True);
            string dir_script = writeFile(dir + "/load-dir.q", sprintf("%%modern
sub load(string label, code load) {
    try {
        load();
        printf(\"%%s: loaded\\n\", label);
    } catch (hash<ExceptionInfo> ex) {
        printf(\"%%s: %%s: %%s\\n\", label, ex.err, index(ex.desc, \"%s\") != -1 ? \"names the missing module\"
            : ex.desc);
    }
}
string mod_dir = \"%s\";
load(\"requires by name\", sub () { Program p(); p.parse(\"%%requires CleanupFailDir\\n\", \"name\"); });
load(\"requires by path\", sub () { Program p(); p.parse(\"%%requires \" + mod_dir + \"\\n\", \"path\"); });
load(\"loadModule by name\", sub () { Program p(); p.loadModule(\"CleanupFailDir\"); });
load(\"loadModule by path\", sub () { Program p(); p.loadModule(mod_dir); });
load(\"load_module\", sub () { load_module(\"CleanupFailDir\"); });
# fix the module: it loads under the same name, with its dependency on CleanupGood
File f();
f.open2(mod_dir + \"/CleanupFailDir.qm\", O_WRONLY | O_TRUNC);
f.write(\"%s\");
f.close();
Program p();
p.parse(\"%%requires CleanupFailDir\\nint sub get() { return CleanupFailDir::Value + CleanupFailDir::Extra; }\",
    \"fixed\");
printf(\"fixed: %%d\\n\", p.callFunction(\"get\"));
", Missing, mod_dir, escapeForScript(directoryModuleCode(False))));
            hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s QORE_MODULE_DIR_ONLY=1 QORE_MODULE_DIR=%s %s -b --enable-debug "
                "--exec-mode=%s %s", libqore_dir, libqore_dir, libqore_dir, dir, qore_bin, mode, dir_script), True);
            assertEq(0, r.rc, sprintf("directory module, %s: exit status; output: %s", mode, r.out));
            assertEq("requires by name: LOAD-MODULE-ERROR: names the missing module
requires by path: LOAD-MODULE-ERROR: names the missing module
loadModule by name: LOAD-MODULE-ERROR: names the missing module
loadModule by path: LOAD-MODULE-ERROR: names the missing module
load_module: LOAD-MODULE-ERROR: names the missing module
fixed: 3
", r.stdout, sprintf("directory module, %s: output", mode));
        }
    }

    #! the compilers report a directory module that fails to parse after loading a module, and exit normally (#5953)
    /** The module is parsed only to be compiled; the dependency on CleanupGood that its parse registered must be
        released although the compiler handles the parse error before it closes the module's context: qcc and qore
        --compile-module asserted at exit in a debug build (SIGABRT) when it was left.  Exit status 1 is a compile
        error reported normally.
    */
    testCompileDirectoryModule() {
        string dir = tmp.path + "/compile";
        mkdir(dir);
        writeFile(dir + "/CleanupGood.qm", moduleCode("CleanupGood", ""));
        string mod_dir = writeDirectoryModule(dir, True);
        string env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s QORE_MODULE_DIR_ONLY=1 "
            "QORE_MODULE_DIR=%s", libqore_dir, libqore_dir, libqore_dir, dir);

        # qore --compile-module
        int rc;
        string out = backquote(sprintf("%s %s -b --enable-debug --compile-module --output %s %s 2>&1", env, qore_bin,
            dir + "/qore-out.qmod", mod_dir), \rc);
        assertEq(1, rc, "qore --compile-module: exit status; output: " + out);
        assertEq(-1, index(out, "Assertion"), "qore --compile-module: no assertion");
        assertNeq(-1, index(out, Missing), "qore --compile-module: the error names the missing module");
        assertFalse(is_file(dir + "/qore-out.qmod"), "qore --compile-module: no module is written");

        *string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE;
        if (!qcc_bin) {
            # qcc is built next to qore; qore may have been found in the PATH
            list<string> bin_dirs = (libqore_dir, dirname(qore_bin));
            if (index(qore_bin, DirSep) == -1 && ENV.PATH) {
                bin_dirs += ENV.PATH.split(":");
            }
            foreach string bin_dir in (bin_dirs) {
                if (is_file(bin_dir + DirSep + "qcc")) {
                    qcc_bin = bin_dir + DirSep + "qcc";
                    break;
                }
            }
        }
        if (!qcc_bin) {
            testSkip(sprintf("the in-tree qcc executable is not available in %y; set QCC to test it", libqore_dir));
        }

        # qcc -m: the whole module; qcc --context: one file of it, for which the main file is parsed first
        list<hash<auto>> cmds = (
            {"label": "qcc -m", "args": sprintf("-m %s -o %s", mod_dir, dir + "/qcc-out.qmod"),
                "out": dir + "/qcc-out.qmod"},
            {"label": "qcc --context", "args": sprintf("-c --context=%s -o %s %s", mod_dir, dir + "/Extra.qo",
                mod_dir + "/Extra.qc"), "out": dir + "/Extra.qo"},
        );
        foreach hash<auto> cmd in (cmds) {
            out = backquote(sprintf("%s %s %s 2>&1", env, qcc_bin, cmd.args), \rc);
            assertEq(1, rc, sprintf("%s: exit status; output: %s", cmd.label, out));
            assertEq(-1, index(out, "Assertion"), cmd.label + ": no assertion");
            assertNeq(-1, index(out, "parse error in main module file"), cmd.label + ": the parse error is reported");
            assertFalse(is_file(cmd.out), cmd.label + ": no output is written");
        }

        # the module, fixed, compiles: the failures above are those of the module, not of the commands
        writeDirectoryModule(dir, False);
        out = backquote(sprintf("%s %s -m %s -o %s 2>&1", env, qcc_bin, mod_dir, dir + "/qcc-out.qmod"), \rc);
        assertEq(0, rc, "qcc -m, fixed module: exit status; output: " + out);
        assertTrue(is_file(dir + "/qcc-out.qmod"), "qcc -m, fixed module: the module is written");
    }

    #! returns the text for a double-quoted string literal in generated Qore code
    private string escapeForScript(string text) {
        return replace(replace(replace(text, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n");
    }

    testNegative() {
        # without the missing requirement, the module loads: the checks above test the failure, not the harness
        writeFile(src_dir + "/CleanupOk.qm", moduleCode("CleanupOk", "%requires CleanupGood\n"));
        hash<ExecModeHarness::ModeRunResult> r = run(src_dir, "CleanupOk", "none", "ast");
        assertEq(0, r.rc, "ok module: exit status");
        assertEq("load 1: loaded\nload 2: loaded\ngood: 1\n", r.stdout, "ok module: output");
    }
}
