#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# Validates the cross-thread module-dependency cycle detector.
#
# Once the process-global module-load lock M was retired (it serialized all module init and, held
# across a nested cross-thread load wait, reformed a process-wide deadlock), a genuine cross-thread
# circular dependency can no longer be masked by that lock.  It is instead detected explicitly:
# before a thread parks waiting on a feature that another thread is initializing, the loader walks the
# waiter->owner graph (checkModuleLoadCycle) and, if it returns to this thread, raises
# CIRCULAR-MODULE-DEPENDENCY instead of deadlocking.
#
# Two threads concurrently load a mutually-dependent module pair (CrossCycleA requires CrossCycleB at
# init time and vice versa) into separate Programs.  The init of each module waits until the init of the other one
# started (CrossCycleGate.qm) before it loads the other module, so both features are reserved when either thread asks
# for the other's, and the cross-thread cycle forms in every attempt; before, it formed only when the threads happened
# to interleave so, and a loaded run could miss it in every attempt (issue #6517).  The modules are cached in the
# process (as loaded or failed), so the attempt runs in a fresh process.
#
# It asserts that the detector fires (the attempt yields CYCLE -> CIRCULAR-MODULE-DEPENDENCY), and that it neither
# HANGs (deadlock) nor fails with any OTHER error or a crash.
#
# When this test itself runs under valgrind, each attempt runs under valgrind too, and must report no memory errors
# and no definitely or possibly lost memory: the failure path of a detected cycle releases everything it created.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires Util

%exec-class CircularModuleDependencyTest

class CircularModuleDependencyTest inherits QUnit::Test {
    constructor() : Test("Circular module dependency test", "1.0") {
        addTestCase("cross-thread cycle detection", \crossThreadCycleTest());
        set_return_value(main());
    }

    #! True when this test runs under valgrind
    private static bool underValgrind() {
        return is_file("/proc/self/maps") && ReadOnlyFile::readTextFile("/proc/self/maps") =~ /valgrind|vgpreload/;
    }

    crossThreadCycleTest() {
        # absolutize the fixture dir: under the test harness get_script_dir() can be relative, and the
        # driver subprocess must find the fixture modules regardless of its working directory
        string dir = get_script_dir();
        if (dir !~ /^\//) {
            dir = getcwd() + "/" + dir;
        }
        # run the driver against the local (in-development) qore/libqore under test, with the fixture
        # modules (absolute) prepended to the inherited module path
        string qore_bin = TestInterpreter::qore_interpreter();
        string modpath = dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : "");
        string driver = dir + "/cross-cycle-attempt.qr";

        # under valgrind, the attempts run under the same valgrind, found in the PATH
        *string valgrind;
        if (underValgrind()) {
            int which_rc;
            valgrind = trim(backquote("command -v valgrind", \which_rc));
            assertEq(0, which_rc, "the valgrind that runs this test is in the PATH");
        }

        # do not cd: keep the harness working directory so any relative entries inherited in
        # QORE_MODULE_DIR stay valid; reference the driver and fixtures by absolute path
        string cmd;
        *string log;
        if (valgrind) {
            # valgrind's own report goes to a file, so the output is only the attempt's outcome
            log = sprintf("%s%scross-cycle-attempt-%d.valgrind", tmp_location(), DirSep, getpid());
            cmd = sprintf("QORE_MODULE_DIR=%y %y -q --leak-check=full --errors-for-leak-kinds=definite,possible "
                "--error-exitcode=97 --log-file=%y %y -b --enable-debug %y 2>&1", modpath, valgrind, log,
                qore_bin, driver);
        } else {
            cmd = sprintf("QORE_MODULE_DIR=%y %y --enable-debug %y 2>&1", modpath, qore_bin, driver);
        }
        on_exit if (log) {
            unlink(log);
        }
        int rc;
        string out = trim(backquote(cmd, \rc));
        on_error printf("attempt output: %y\n", out);
        if (log) {
            # neither memory errors nor lost memory
            assertEq(0, rc, sprintf("the attempt under valgrind: %s", ReadOnlyFile::readTextFile(log)));
        }
        # the driver must never hang or fail with an unexpected error/crash, and the cycle always forms
        assertFalse(out == "HANG", "the attempt did not deadlock");
        assertFalse(out =~ /^OTHER:/, "the attempt did not fail with an unexpected error");
        assertEq("CYCLE", out, "the cross-thread cycle formed and CIRCULAR-MODULE-DEPENDENCY was detected");
    }
}
