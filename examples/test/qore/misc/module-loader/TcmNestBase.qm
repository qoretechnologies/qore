# -*- mode: qore; indent-tabs-mode: nil -*-
# TcmNestBase.qm - base module loaded from inside another module's parse

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%try-child-module TcmNestExt

module TcmNestBase {
    version = "1.0";
    desc = "test base module loaded from another module";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

#! base module recording module initialization
public class TcmNestBase {
    public {
        #! trace of module initialization in the order in which it occurred
        static list<string> trace;
    }

    #! adds an entry to the trace
    static add(string entry) {
        trace += entry;
    }
}
