%modern

%requires(reexport) TcmNestBase

module TcmNestOuter {
    version = "1.0";
    desc = "test module requiring the base module";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
    init = sub () {
        TcmNestBase::add("outer");
    };
}

#! class used by the child module
public class TcmNestOuter {
    #! returns a fixed string
    static string hello() {
        return "outer";
    }
}
