%modern

%requires(reexport) TcmNestBase
%requires TcmNestOuter

module TcmNestExt {
    version = "1.0";
    desc = "test child module requiring the outer module";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
    init = sub () {
        TcmNestBase::add("ext:" + TcmNestOuter::hello());
    };
}
