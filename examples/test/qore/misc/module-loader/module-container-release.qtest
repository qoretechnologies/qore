#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# A Program container passed to load a user module is owned by the call; when the module is not loaded into it, for
# example because it is already loaded, the container is released instead of being leaked.  A module name with a NUL
# character cannot be blacklisted, since it would blacklist the name cut at the NUL character.

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"

%requires QUnit
%requires Util

%exec-class ModuleContainerReleaseTest

class ModuleContainerReleaseTest inherits QUnit::Test {
    constructor() : QUnit::Test("module container release", "1.0", \ARGV) {
        addTestCase("a container for an already-loaded module is released", \testAlreadyLoaded());
        addTestCase("a container for a refused module name is released", \testRefusedName());
        addTestCase("a module name with a NUL character cannot be blacklisted", \testBlacklistNul());
        addTestCase("the exit hook of a released container calls its class from another Program",
            \testExitHookCallsClass());
        set_return_value(main());
    }

    #! returns a Program container that decrements the given Counter when it is destroyed
    static Program container(Counter released) {
        Program p(PO_NEW_STYLE);
        p.parse("
            class Watch {
                private { Counter released; }
                constructor(Counter released) { self.released = released; }
                destructor() { released.dec(); }
            }
            our *Watch watch;
            sub init(Counter released) { watch = new Watch(released); }
        ", "container");
        p.callFunction("init", released);
        return p;
    }

    testAlreadyLoaded() {
        # Util is already loaded, so the module is not loaded into the container
        Counter released(1);
        load_user_module_with_program("Util", container(released));
        assertEq(0, released.getCount(), "load_user_module_with_program() releases the container");

        released.inc();
        Program p(PO_NEW_STYLE);
        assertThrows("LOAD-MODULE-ERROR", \p.loadUserModuleWithProgram(), ("Util", container(released)));
        assertEq(0, released.getCount(), "Program::loadUserModuleWithProgram() releases the container");
    }

    testRefusedName() {
        Counter released(1);
        assertThrows("LOAD-MODULE-ERROR", \load_user_module_with_program(), ("Util\x00.txt", container(released)));
        assertEq(0, released.getCount(), "load_user_module_with_program() releases the container");

        released.inc();
        Program p(PO_NEW_STYLE);
        assertThrows("LOAD-MODULE-ERROR", \p.loadUserModuleWithProgram(), ("Util\x00.txt", container(released)));
        assertEq(0, released.getCount(), "Program::loadUserModuleWithProgram() releases the container");

        released.inc();
        assertThrows("LOAD-MODULE-ERROR", \p.loadUserModuleWithProgramWarn(), ("Util\x00.txt", container(released)));
        assertEq(0, released.getCount(), "Program::loadUserModuleWithProgramWarn() releases the container");
    }

    #! the container's exit hook runs when its last reference is released, and calls a method of the container's class
    #! through another Program
    /** The container cannot be referenced any more, but the thread deleting it runs its code: the call raised
        PROGRAM-ERROR when the exit hook ran before the thread recorded that it deletes the container
    */
    testExitHookCallsClass() {
        Program b(PO_NEW_STYLE);
        b.parse("auto sub call(object o) { return o.m(); }", "b");
        Counter released(1);
        Queue results();
        Program p(PO_NEW_STYLE);
        p.parse("
            class Watch {
                private { Counter released; }
                constructor(Counter released) { self.released = released; }
                destructor() { released.dec(); }
                string m() { return \"m\"; }
            }
            our *Watch watch;
            sub init(Counter released, Program b, Queue results) {
                watch = new Watch(released);
                register_exit_hook(sub () {
                    try {
                        results.push(b.callFunction(\"call\", watch));
                    } catch (hash<ExceptionInfo> ex) {
                        results.push(ex.err + \": \" + ex.desc);
                    }
                });
            }
        ", "container");
        p.callFunction("init", released, b, results);
        # the call releases the last reference to the container, which runs its exit hook in this thread
        load_user_module_with_program("Util", remove p);
        assertEq(1, results.size(), "the exit hook ran when the container was released");
        assertEq("m", results.get(0), "the exit hook called the method of the container's class");
        assertEq(0, released.getCount(), "the container was released");
    }

    testBlacklistNul() {
        # a name that names no module; cut at the NUL character it would blacklist "NoSuchModule"
        string name = "NoSuchModule" + get_random_string(8);
        string desc = sprintf("^module name \"%s\\\\x00\\.txt\" contains a NUL character at byte offset %d", name,
            name.size());
        assertThrows("BLACKLIST-ERROR", desc, \qore_add_module_to_blacklist(), (name + "\x00.txt",));
        assertThrows("BLACKLIST-ERROR", desc, \qore_add_module_to_blacklist_ex(), (name + "\x00.txt",));
        # the module name before the NUL character is not blacklisted
        try {
            load_module(name);
            assertTrue(False, "the module does not exist");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("LOAD-MODULE-ERROR", ex.err);
            assertFalse(ex.desc =~ /blacklisted/, "the module name is not blacklisted");
        }
    }
}
