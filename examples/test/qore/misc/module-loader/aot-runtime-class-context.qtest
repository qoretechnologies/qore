#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class AotRuntimeClassContextTest

#! Tests classes of a compiled module loaded at runtime while several threads run their methods
/** The class hierarchy of a class of a compiled module was not marked as resolved, and runtime code resolved it:
    - a method call on an object whose class is only known at runtime checks whether the calling class may use the
      object's private methods, and runtime code used the parse-time check, which resolves the hierarchy of the
      calling class the first time it is asked
    - a Program that parses a subclass of the module's class resolves the hierarchy of the class it inherits

    Either way the class's parse state was written while other threads ran its methods.  And a Program that shares the
    module's classes released the class's source Program when it was deleted, while the other Programs still used
    the class.  ThreadSanitizer builds
    report the data race in the child; every build checks that the calls in all threads return the expected values.

    The test compiles the module with qcc and runs child processes that load it with \c load_module() and call the
    method in several threads, all released together by a Counter.
*/
class AotRuntimeClassContextTest inherits QUnit::Test {
    public {
        #! the number of threads calling the method
        const Threads = 4;
        #! the number of times the child is run, each in a new process
        const Rounds = 3;
        #! the number of Programs in which a subclass of the module's class is parsed while the threads run
        const Programs = 10;

        #! the module: a class that calls a method of an object of another class known only at runtime
        const ModuleSource = "%modern
module HierCtx {
    version = \"1.0\";
    desc = \"runtime class context test module\";
    author = \"Qore Technologies, s.r.o.\";
    url = \"https://qore.org\";
    license = \"MIT\";
}

public class HierBase {
    int value() {
        return 1;
    }
}

public class HierCaller inherits HierBase {
    int call(object o) {
        return o.value();
    }
}

public class HierTarget {
    int value() {
        return 2;
    }
}
";

        #! the child: loads the module at runtime and calls the method in several threads at once; with a second
        #! argument, the main thread parses subclasses of the module's class in new Programs meanwhile, and with a
        #! third argument, deletes each of those Programs at once
        const ChildSource = "%modern
load_module(\"HierCtx\");
int threads = ARGV[0].toInt();
int programs = ARGV[1] ? ARGV[1].toInt() : 0;
bool delete_programs = ARGV[2] == \"delete\";
Counter start(1);
Counter running(threads);
Queue<int> results();
code run = sub () {
    on_exit running.dec();
    object c = create_object(\"HierCaller\");
    object t = create_object(\"HierTarget\");
    start.waitForZero();
    int sum = 0;
    for (int i = 0; i < 2000; ++i) {
        sum += call_object_method(c, \"call\", t);
    }
    results.push(sum);
};
for (int i = 0; i < threads; ++i) {
    background run();
}
start.dec();
# the Programs are kept until the threads are done
list<Program> pgms;
for (int i = 0; i < programs; ++i) {
    Program p(PO_NEW_STYLE);
    p.loadModule(\"HierCtx\");
    p.parse(\"class Sub inherits HierCaller { private int priv() { return 3; } int f(HierCaller o) { return o.value() \"
        \"+ priv(); } }\", \"sub\");
    if (!delete_programs) {
        pgms += p;
    }
}
running.waitForZero();
list<int> sums;
while (*hash<QueueTryResult<int>> r = results.tryGet()) {
    sums += r.value;
}
printf(\"sums: %y\\n\", sums);
";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOT runtime class context test", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("calls from a class of a module loaded at runtime", \runtimeClassContextTest());
        addTestCase("subclasses parsed while the class runs", \subclassParseTest());
        addTestCase("Programs sharing the class deleted while it runs", \programDeleteTest());
        set_return_value(main());
    }

    runtimeClassContextTest() {
        runChildren(0);
    }

    subclassParseTest() {
        runChildren(Programs);
    }

    programDeleteTest() {
        runChildren(Programs, True);
    }

    #! compiles the module and runs the child process in each round
    /** @param programs the number of Programs in which the child's main thread parses a subclass of the module's
        class while the threads run
        @param delete_programs if each of those Programs is deleted at once
    */
    private runChildren(int programs, bool delete_programs = False) {
        TmpDir tmp("qore-aot-runtime-class-context-");
        string src = tmp.path + DirSep + "HierCtx.qm";
        string qmod = tmp.path + DirSep + "HierCtx.qmod";
        File f();
        f.open2(src, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ModuleSource);
        f.close();
        string out = backquote(sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s QORE_MODULE_DIR=%s %s --module "
            "--strip-source -o %s %s 2>&1", libqore_dir, libqore_dir, tmp.path, qcc_bin, qmod, src));
        if (!is_file(qmod)) {
            testSkip(sprintf("qcc could not compile the module: %s", out));
        }
        # the child must load the compiled module, not its source
        unlink(src);

        string child = tmp.path + DirSep + "child.q";
        f.open2(child, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ChildSource);
        f.close();

        # each call returns 2
        list<int> expected = map 4000, xrange(Threads);
        for (int round = 1; round <= Rounds; ++round) {
            out = backquote(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s %s %d %d %s 2>&1; echo \"rc=$?\"",
                libqore_dir, tmp.path, qore_bin, child, Threads, programs, delete_programs ? "delete" : ""));
            *list<*string> rc = (out =~ x/rc=([0-9]+)\s*$/);
            assertEq("0", rc[0], sprintf("round %d: the child exits normally: %s", round, out));
            assertTrue(out.find(sprintf("sums: %y", expected)) >= 0,
                sprintf("round %d: every thread's calls return the expected values: %s", round, out));
            # a ThreadSanitizer build reports any data race in the child
            assertEq(-1, out.find("WARNING: ThreadSanitizer"), sprintf("round %d: no data race: %s", round, out));
        }
    }
}
