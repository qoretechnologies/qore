# -*- mode: qore; indent-tabs-mode: nil -*-
# TcmNmBase.qm - base module loaded into a Program container that cannot load modules

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%try-child-module TcmNmExt

module TcmNmBase {
    version = "1.0";
    desc = "test base module for PO_NO_MODULES handling";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

#! base module recording module initialization
public class TcmNmBase {
    public {
        #! trace of module initialization in the order in which it occurred
        static list<string> trace;
    }

    #! adds an entry to the trace
    static add(string entry) {
        trace += entry;
    }
}
