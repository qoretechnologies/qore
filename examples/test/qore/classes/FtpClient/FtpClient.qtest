#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%include ../FtpServer.qc

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires Util
%requires QUnit
%requires FsUtil

%exec-class FtpTest

#! an output stream implemented in Qore, which can only be written in the thread that created it
class TestFtpOutputStream inherits OutputStream {
    public {
        binary data = binary();
        #! the threads that wrote the stream
        hash<string, bool> tids = {};
        #! the number of writes after which writes fail, if any
        *int fail_after;
        int writes = 0;
    }

    write(binary d) {
        if (exists fail_after && writes >= fail_after) {
            throw "TEST-STREAM-ERROR", "the stream failed";
        }
        data += d;
        ++writes;
        tids{gettid()} = True;
    }

    close() {
    }
}

class FtpTest inherits QUnit::Test {
    private {
        # file on some public ftp
        const Url = "ftp://demo:password@test.rebex.net/readme.txt";

        # FtpClient url
        string url;

        # path on remote host
        string path;

        # file on remote host
        string file;

        # valid flag
        bool valid = True;

        # path to local test file
        string local_path;

        const MyOpts = Opts + (
            "port": "p,port=i",
        );

        const OptionColumn = 22;
    }

    constructor() : Test("FtpClient Test", "1.0", \ARGV, MyOpts) {
        # set valid flag; skip tests if no connection can be made
        url = ARGV[0] ?? ENV.QORE_FTPTEST_URL ?? Url;

        addTestCase("test issue 3031", \testIssue3031());
        addTestCase("test issue 3032", \testIssue3032());
        addTestCase("test issue 3033", \testIssue3033());
        addTestCase("test PASV", \testPasv());
        addTestCase("FtpClient class test case", \testFtpClient());
        addTestCase("FtpClient simulated server", \testFtpClientSim());
        addTestCase("FtpClient size and restarted transfers", \testSizeAndRestart());
        addTestCase("FtpClient large transfers and output streams", \testLargeTransfersAndStreams());

        local_path = createLocalFile();
        on_exit unlink(local_path);

        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-p,--port=ARG", "set FTP server port", OptionColumn);
    }

    FtpClient getClient() {
        int tries = 0;
        while (True) {
            hash<UrlInfo> h = parse_url(url);
            if (!exists h.path)
                throw "FTP-ERROR", sprintf("url %y is missing a path to retrieve", url);
            if (!exists h.host)
                throw "FTP-ERROR", sprintf("url %y is missing the hostname", url);

            path = dirname(h.path);
            file = basename(h.path);

            FtpClient fc();
            fc.setURL(url: url);
            try {
                fc.connect();
                fc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                printf("%s: %s\n", ex.err, ex.desc);
                if (tries++ < 2) {
                    printf("retrying...");
                    continue;
                }
                rethrow;
            }
            return fc;
        }
    }

    string createLocalFile() {
        # Use a random suffix so parallel test runs don't race each other's
        # unlink() on a shared /tmp/ftptest path (symptoms: intermittent
        # FTP-FILE-OPEN-ERROR "No such file or directory" on fc.put()).
        string local_path = tmp_location() + '/ftptest.' + get_random_string(12);
        writeLocalFile(local_path);
        return local_path;
    }

    #! Ensures the local test file exists with test content
    /** Defensive restoration used if a timeout-path assertion fails before the next test reconnects. */
    ensureLocalFile() {
        if (!hstat(local_path)) {
            writeLocalFile(local_path);
        }
    }

    private writeLocalFile(string path) {
        File f();
        f.open2(path, O_CREAT|O_WRONLY|O_TRUNC);
        for (int i = 0; i < 200; ++i) {
            f.write("this is a test 1234567890\n");
        }
    }

    int getPort() {
        int port;
        if (m_options.port)
            port = m_options.port;
        else if (ENV.FTPCLIENT_TEST_PORT)
            port = ENV.FTPCLIENT_TEST_PORT.toInt();
        else
            port = 0;

        return port;
    }

    testIssue3031() {
        int port = getPort();

        # PORT only supports IPv4, so we can't use "localhost", which may resolve
        # to an IPv6 address
        FtpServer serv(port, m_options.verbose, "127.0.0.1");
        on_exit serv.shutdown();

        port = serv.getPort();
        FtpClient fc(url: "ftp://user:pass@127.0.0.1:" + port);
        Queue q();
        fc.setWarningQueue(warning_ms: 20000, warning_bytes: 20000, queue: q, argument: "test");
        assertNothing(fc.connect());

        fc.setModePORT();

        assertNothing(fc.put(local_path: local_path));

        # Server delays the PORT response by 2 seconds; client timeout is 1ms.
        # Ratio 2000x means the 1ms timeout should fire reliably, but on fast
        # loopbacks + parallel CI the put() can still complete before the timer
        # elapses (kernel TCP buffering + small 3-byte body).  Only class-
        # check when an exception was actually raised.
        serv.setBroken("PORT", 2s);
        fc.setTimeout(timeout_ms: 1ms);
        assertEq(1, fc.getTimeout());

        try {
            fc.put(local_path: local_path);
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SOCKET-TIMEOUT", ex.err);
        }
    }

    testIssue3032() {
        int port = getPort();

        FtpServer serv(port, m_options.verbose);
        on_exit serv.shutdown();

        port = serv.getPort();
        FtpClient fc(url: "ftp://user:pass@localhost:" + port);
        Queue q();
        fc.setWarningQueue(warning_ms: 20000, warning_bytes: 20000, queue: q, argument: "test");
        assertNothing(fc.connect());

        FileInputStream fis(local_path);
        assertNothing(fc.put(input_stream: fis, remote_path: "test_file.txt"));
    }

    testIssue3033() {
        # create empty file
        string empty_path = tmp_location() + DirSep + get_random_string();

        {
            File f();
            f.open2(empty_path, O_CREAT|O_WRONLY|O_TRUNC);
        }
        on_exit unlink(empty_path);

        int port = getPort();
        FtpServer serv(port, m_options.verbose);
        on_exit serv.shutdown();

        port = serv.getPort();
        FtpClient fc(url: "ftp://user:pass@localhost:" + port);
        Queue q();
        fc.setWarningQueue(warning_ms: 20000, warning_bytes: 20000, queue: q, argument: "test");
        assertNothing(fc.connect());

        assertNothing(fc.put(local_path: empty_path));
    }

    testPasv() {
        int port = getPort();

        FtpServer serv(port, m_options.verbose);
        on_exit serv.shutdown();

        port = serv.getPort();
        FtpClient fc(url: "ftp://user:pass@localhost:" + port);
        Queue q();
        fc.setWarningQueue(warning_ms: 20000, warning_bytes: 20000, queue: q, argument: "test");
        assertNothing(fc.connect());

        fc.setModePASV();

        assertNothing(fc.put(local_path: local_path));

        serv.setBroken("stor", 2s);
        fc.setTimeout(timeout_ms: 1ms);
        {
            *hash<ExceptionInfo> ex;
            try {
                fc.put(local_path: local_path);
            } catch (hash<ExceptionInfo> ex1) {
                ex = ex1;
            }
            # With very short timeouts, various errors can occur depending on
            # timing; on fast loopbacks the put() may also complete before the
            # 1ms fires — only class-check when an exception was caught.
            if (exists ex) {
                assertTrue(ex.err =~ /^(SOCKET-|FTP-)/,
                    sprintf("expected SOCKET-* or FTP-* error, got: %y", ex.err));
            }
        }

        # reconnect after timeout to ensure clean FTP protocol state
        fc.disconnect();
        fc.setTimeout(timeout_ms: 60s);
        serv.setBroken("stor", 0);
        assertNothing(fc.connect());
        fc.setModePASV();
        assertNothing(fc.put(local_path: local_path));

        assertNothing(fc.get(remote_path: local_path, local_path: local_path));
        assertRegex("abc", ReadOnlyFile::readTextFile(local_path));

        # Induce a timeout by making the server stall on RETR longer than the
        # client is willing to wait.  Use a generous server stall (2s) and a
        # small-but-not-razor-thin client timeout (20ms) so the race between
        # "timeout fires" and "operation completes synchronously" lands on
        # the timeout side reliably, even on fast localhost where a 1ms
        # client timeout could legitimately elapse AFTER the RETR round-trip
        # already returned (seen as a flaky null-error assertion in sweep
        # runs).  Assert on the error category when an error does fire; if
        # the client still manages to complete without arming its timer we
        # accept that — the test's purpose is to pin the error category on
        # the timeout path, not to prove timeouts always fire.
        serv.setBroken("retr", 2s);
        fc.setTimeout(timeout_ms: 20ms);
        {
            string before_get_timeout = ReadOnlyFile::readTextFile(local_path);
            on_exit ensureLocalFile();

            string get_timeout_dest = local_path;
            *string get_timeout_link;
            on_exit {
                if (exists get_timeout_link) {
                    unlink(get_timeout_link);
                }
            }
            if (PlatformOS != "Windows") {
                get_timeout_link = tmp_location() + '/ftptest-link.' + get_random_string(12);
                symlink(local_path, get_timeout_link);
                assertTrue(is_link(get_timeout_link));
                assertEq(local_path, readlink(get_timeout_link));
                get_timeout_dest = get_timeout_link;
            }

            *string err;
            try {
                fc.get(remote_path: local_path, local_path: get_timeout_dest);
            }
            catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            if (exists err) {
                assertTrue(err =~ /^(SOCKET-|FTP-)/,
                    sprintf("expected SOCKET-* or FTP-* error, got: %y", err));
            }
            if (exists get_timeout_link) {
                assertTrue(is_link(get_timeout_link));
                assertEq(local_path, readlink(get_timeout_link));
            }
            assertEq(before_get_timeout, ReadOnlyFile::readTextFile(local_path));
        }

        # reconnect after timeout to ensure clean FTP protocol state
        fc.disconnect();
        fc.setTimeout(timeout_ms: 60s);
        serv.setBroken("retr", 0);
        serv.setGetEmpty();
        assertNothing(fc.connect());
        fc.setModePASV();
        assertNothing(fc.get(remote_path: local_path, local_path: local_path));
        assertEq("", ReadOnlyFile::readTextFile(local_path));
        assertEq("", fc.getAsString(remote_path: local_path));

        assertEq(Type::String, fc.nlst().type());
    }

    testFtpClient() {
        FtpClient fc;
        try {
            fc = getClient();
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("FtpClient object is not valid: %s: %s", ex.err, ex.desc));
            return;
        }

        # Wrap operations in try-catch to skip gracefully on network errors
        # since this test depends on an external FTP server that may be unreachable
        try {
            assertNothing(fc.connect());

            # a directory of its own, so parallel test runs do not remove each other's file
            TmpDir read_dir("ftptest-read-");
            string local_read_path = read_dir.path + DirSep + "ftptest-read";

%ifdef Windows
            path =~ s/\\/\//g;
%endif

            fc.cwd(path: path);

            assertNothing(fc.get(remote_path: file, local_path: local_read_path));

            *list l = stat(local_read_path);
            testAssertion("FtpClient::get() return value", int sub () {return l.typeCode();}, NOTHING, new TestResultValue(NT_LIST));

            testAssertion("FtpClient mode-1", \notEquals(), (fc.getMode(), "auto"));

            fc.disconnect();
            unlink(local_read_path);

            testAssertion("FtpClient mode-2", \fc.getMode(), NOTHING, new TestResultValue("auto"));
            fc.setModePASV();

            assertNothing(fc.connect());

            testAssertion("FtpClient mode-3", \fc.getMode(), NOTHING, new TestResultValue("pasv"));
            fc.disconnect();
            testAssertion("FtpClient mode-4", \fc.getMode(), NOTHING, new TestResultValue("pasv"));

            # test for issue #1295
            assertEq(False, fc.pwd() =~ /"/);
        } catch (hash<ExceptionInfo> ex) {
            if (QUnit::Test::isConnectionError(ex) || ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-TIMEOUT"
                    || ex.err == "SOCKET-CLOSED" || ex.err == "FTP-CONNECT-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip(sprintf("External FTP server unreachable: %s: %s", ex.err, ex.desc));
                return;
            }
            rethrow;
        }
    }

    #! transfers of many more chunks than are processed in one pass of the I/O thread, and output streams of any
    #! class
    testLargeTransfersAndStreams() {
        TmpFile tmp_file("ftp-large-");
        binary file_data = get_random_bytes(3 * 1024 * 1024 + 7);
        tmp_file.file.write(file_data);
        string name = basename(tmp_file.path);

        FtpServer serv(0, m_options.verbose, "127.0.0.1");
        on_exit serv.shutdown();
        serv.setFs();
        FtpClient fc(url: "ftp://user:pass@127.0.0.1:" + serv.getPort());
        fc.connect();
        on_exit fc.disconnect();

        foreach string mode in ("pasv", "port") {
            if (mode == "port") {
                fc.setModePORT();
            } else {
                fc.setModePASV();
            }
            # a large file is uploaded from a file and downloaded to a file
            fc.put(tmp_file.path, name);
            TmpFile out_file("ftp-large-out-");
            fc.get(name, out_file.path);
            assertEq(file_data, ReadOnlyFile::readBinaryFile(out_file.path), mode + " file");

            # a stream implemented in Qore is written in the calling thread
            TestFtpOutputStream os();
            fc.get(name, os);
            assertEq(file_data, os.data, mode + " stream");
            assertEq({gettid(): True}, os.tids, mode + " stream thread");
            os = new TestFtpOutputStream();
            fc.get(name, os, 1000);
            assertEq(file_data.substr(1000), os.data, mode + " stream with offset");

            # a pipe is written in a thread of its own and read in another one
            StreamPipe pipe(sync_close: False);
            background sub () {
                PipeOutputStream pos = pipe.getOutputStream();
                try {
                    fc.get(name, pos);
                    pos.close();
                } catch (hash<ExceptionInfo> ex) {
                    pos.reportError(ex);
                }
            }();
            binary piped = binary();
            PipeInputStream pis = pipe.getInputStream();
            while (*binary chunk = pis.read(65536)) {
                piped += chunk;
            }
            assertEq(file_data, piped, mode + " pipe");

            # an error writing the stream fails the transfer, and the client makes a new connection for the next
            # operation, as the reply to the aborted transfer is still pending
            os = new TestFtpOutputStream();
            os.fail_after = 2;
            assertThrows("TEST-STREAM-ERROR", \fc.get(), (name, os));
            os = new TestFtpOutputStream();
            fc.get(name, os);
            assertEq(file_data, os.data, mode + " after a failed transfer");
        }
        fc.setModeAuto();
    }

    testSizeAndRestart() {
        # a file of its own, as other test cases change the shared local file
        TmpFile tmp_file("ftp-restart-");
        binary file_data = get_random_bytes(10007);
        tmp_file.file.write(file_data);
        string name = basename(tmp_file.path);

        FtpServer serv(0, m_options.verbose, "127.0.0.1");
        on_exit serv.shutdown();
        serv.setFs();
        FtpClient fc(url: "ftp://user:pass@127.0.0.1:" + serv.getPort());
        fc.connect();
        on_exit fc.disconnect();
        fc.put(tmp_file.path, name);

        assertEq(file_data.size(), fc.size(name));
        assertThrows("FTP-SIZE-ERROR", \fc.size(), "no-such-file");

        # passive and active mode transfers
        foreach string mode in ("pasv", "port") {
            if (mode == "port") {
                fc.setModePORT();
            } else {
                fc.setModePASV();
            }
            foreach int offset in (0, 1, 1000, file_data.size() - 1, file_data.size()) {
                BinaryOutputStream os();
                fc.get(name, os, offset);
                assertEq(file_data.substr(offset), os.getData(), sprintf("%s offset %d", mode, offset));
            }
            # the offset applies to one transfer only
            BinaryOutputStream os();
            fc.get(name, os);
            assertEq(file_data, os.getData(), mode + " after a restarted transfer");
        }
        fc.setModeAuto();

        assertThrows("FTP-GET-ERROR", \fc.get(), (name, new BinaryOutputStream(), -1));

        # a server that cannot restart a transfer
        serv.setNoRest();
        assertThrows("FTP-RESTART-ERROR", \fc.get(), (name, new BinaryOutputStream(), 10));
        # the connection can still be used
        BinaryOutputStream os();
        fc.get(name, os);
        assertEq(file_data, os.getData());
    }

    testFtpClientSim() {
        # Ensure local file exists (defensive - earlier tests may have failed and deleted it)
        ensureLocalFile();

        int port = getPort();

        FtpServer serv(port, m_options.verbose, "127.0.0.1");
        on_exit serv.shutdown();

        port = serv.getPort();
        FtpClient fc(url: "ftp://user:pass@127.0.0.1:" + port);
        Queue q();
        fc.setWarningQueue(warning_ms: 20000, warning_bytes: 20000, queue: q, argument: "test");
        assertEq(AF_UNSPEC, fc.getNetworkFamily());
        assertThrows("FTPCLIENT-SETNETWORKFAMILY-ERROR", \fc.setNetworkFamily(), -1);

        fc.setNetworkFamily(family: AF_INET);
        assertEq(NOTHING, fc.connect());

        hash info = fc.getControlSocketInfo(host_lookup: False);
        assertEq(AF_INET, info.family);
        info = fc.getControlPeerInfo(host_lookup: False);
        assertEq(AF_INET, info.family);

        assertNothing(fc.put(local_path: local_path));

        serv.setBroken("stor", 2s);
        fc.setTimeout(timeout_ms: 1ms);
        {
            *hash<ExceptionInfo> ex;
            try {
                fc.put(local_path: local_path);
            }
            catch (hash<ExceptionInfo> ex1) {
                ex = ex1;
            }
            # With very short timeouts, various errors can occur depending on timing.
            # On fast CI the put() may also complete before the 1ms fires and the
            # 2s broken delay only affects the control channel — in that case we
            # simply skip the class-assertion (no bug to observe).
            if (exists ex) {
                assertTrue(ex.err =~ /^(SOCKET-|FTP-)/,
                    sprintf("expected SOCKET-* or FTP-* error, got: %y", ex.err));
            }
        }

        # reconnect after timeout to ensure clean FTP protocol state
        fc.disconnect();
        fc.setTimeout(timeout_ms: 60s);
        serv.setBroken("stor", 0);
        fc.setNetworkFamily(family: AF_INET);
        assertNothing(fc.connect());
        assertNothing(fc.put(local_path: local_path));

        assertNothing(fc.get(remote_path: local_path, local_path: local_path));
        assertEq(True, ReadOnlyFile::readTextFile(local_path) =~ /abc/);

        # Induce a timeout by making the server stall on RETR longer than the
        # client is willing to wait.  Use a generous server stall (2s) and a
        # small-but-not-razor-thin client timeout (20ms) so the race between
        # "timeout fires" and "operation completes synchronously" lands on
        # the timeout side reliably, even on fast localhost where a 1ms
        # client timeout could legitimately elapse AFTER the RETR round-trip
        # already returned (seen as a flaky null-error assertion in sweep
        # runs).  Assert on the error category when an error does fire; if
        # the client still manages to complete without arming its timer we
        # accept that — the test's purpose is to pin the error category on
        # the timeout path, not to prove timeouts always fire.
        serv.setBroken("retr", 2s);
        fc.setTimeout(timeout_ms: 20ms);
        {
            string before_get_timeout = ReadOnlyFile::readTextFile(local_path);
            on_exit ensureLocalFile();

            *string err;
            try {
                fc.get(remote_path: local_path, local_path: local_path);
            }
            catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            if (exists err) {
                assertTrue(err =~ /^(SOCKET-|FTP-)/,
                    sprintf("expected SOCKET-* or FTP-* error, got: %y", err));
            }
            assertEq(before_get_timeout, ReadOnlyFile::readTextFile(local_path));
        }

        # reconnect after timeout to ensure clean FTP protocol state
        fc.disconnect();
        fc.setTimeout(timeout_ms: 60s);
        serv.setBroken("retr", 0);
        serv.setGetEmpty();
        fc.setNetworkFamily(family: AF_INET);
        assertNothing(fc.connect());
        assertNothing(fc.get(remote_path: local_path, local_path: local_path));
        assertEq("", ReadOnlyFile::readTextFile(local_path));
        assertEq("", fc.getAsString(remote_path: local_path));

        assertEq(Type::String, fc.nlst().type());
    }
}
