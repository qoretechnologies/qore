#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of calls through method call references

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class CallReferenceDeletedObjectTest

#! Regression test for issue #6083: a call through a method call reference on a deleted object names the method
/** The compiled execution modes raised "cannot call a method on an object that has already been deleted" for a call
    through a method call reference (\o.m(), \m()) whose arguments deleted the object, where the AST interpreter named
    the method that the call runs ("cannot call U::m() ..."); a call on an object deleted before the call had the
    generic message in every mode.  Every mode now names the method: the class of the method of a resolved reference, and
    the class of the method found by name for a reference resolved by name.

    call-reference-deleted-object-worker.q makes these calls (user and builtin methods, a subclass, references through
    self, named arguments); its output must be the one in call-reference-deleted-object.expected in every execution
    mode, on the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class CallReferenceDeletedObjectTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/call-reference-deleted-object-worker.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/call-reference-deleted-object.expected");
    }

    constructor() : QUnit::Test("call reference on a deleted object", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/call-reference-deleted-object";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
