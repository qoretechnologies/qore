#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class ExplicitTypeParamMethodCallTest

#! A call of another object's generic method whose explicit type arguments name type parameters of the calling generic
#! class finds its variant in every mode (qore#5892)
/** u.mid<T>(a) in a method of Box<T> found no variant: the variant of the method called was searched for after the
    callee's receiver was made current, and the explicit type argument T was resolved with it instead of with the
    receiver of the caller.  The probes (explicit-type-param-method-call/probes.q) make the call directly, in a
    closure in a method and in a member initializer, as a named call, with a composite type argument, on a generic
    receiver, in a nested generic class, on another instantiation of the calling class (also with a parameter of the
    callee's type parameter), with a variant committed at parse time, in a background thread, with two type parameters
    and in a child class, with a static method call and a function call as controls; they run in each execution mode
    in a child process, with tiered execution at the IR tier and promoted to native code, and as qcc-compiled
    executables (-O0, -O3).
*/
class ExplicitTypeParamMethodCallTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");

        const Line = "7|\"s\"|RUNTIME-OVERLOAD-ERROR|7|7|7|7|7|7|[1, 2]|RUNTIME-OVERLOAD-ERROR|[7, \"s\"]|[1, 2]|"
            "7|\"s\"|[7, \"s\"]|RUNTIME-OVERLOAD-ERROR|7|7|[\"a\", 1]|7";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string expected;
    }

    constructor() : QUnit::Test("ExplicitTypeParamMethodCall", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        for (int i = 0; i < 4; ++i) {
            expected += sprintf("%d: %s\n", i, Line);
        }

        addTestCase("explicit type arguments naming the caller's type parameters", \testModes());
        set_return_value(main());
    }

    testModes() {
        TmpDir tmp("qore-explicit-type-param-method-call-");
        string file = tmp.path + DirSep + "prog.q";
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "explicit-type-param-method-call" + DirSep
            + "probes.q")
            + "\nfor (int i = 0; i < 4; ++i) {\n    printf(\"%d: %s\\n\", i, probes());\n}\n");
        f.close();

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=2 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)), mode);
        }
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
            "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), "tiered, IR tier");
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 --jit-jit-threshold=1 "
            "%s 2>&1", env, qore_bin, file)), "tiered, promoted");
        foreach string opt in (("-O0", "-O3")) {
            string exe = file + opt;
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                file));
            assertTrue(is_file(exe), sprintf("qcc %s compiled the executable: %s", opt, out));
            assertEq(expected, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                libqore_dir, exe)), "qcc " + opt);
            assertEq(expected, backquote(sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=1 LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, libqore_dir, exe)), "qcc " + opt + ", JIT");
        }
    }
}
