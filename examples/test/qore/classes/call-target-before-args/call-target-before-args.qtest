#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of the check of a call's target before its arguments

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class CallTargetBeforeArgsTest

#! Regression test for issue #5784: a call checks its target before it evaluates its arguments
/** The AST interpreter checks the object of a method call or of a method call reference, and that a value has the
    method called on it, before it evaluates the call's arguments; the compiled execution modes evaluated the
    arguments first, so an argument with side effects (a constructor, a function call) ran before the call raised
    OBJECT-ALREADY-DELETED or PSEUDO-METHOD-DOES-NOT-EXIST.  They now check the target first when an argument can
    have side effects, and raise the AST interpreter's messages.

    CallTargetBeforeArgs.q makes such calls (method call references to deleted objects, method calls on objects
    deleted through another variable with typed, object and auto receivers, a method call on no value), the same calls
    with arguments without side effects, and calls whose target is valid; its output must be the one in
    CallTargetBeforeArgs.expected, which the AST interpreter prints, in every execution mode, on the IR tier and in
    programs compiled with qcc -O0 and -O3.
*/
class CallTargetBeforeArgsTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/CallTargetBeforeArgs.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/CallTargetBeforeArgs.expected");
    }

    constructor() : QUnit::Test("call target checked before arguments", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/call-target-before-args";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
