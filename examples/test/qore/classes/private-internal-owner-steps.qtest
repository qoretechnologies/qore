#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class PrivateInternalOwnerStepsTest

#! the inheritance lists of the methods of a class whose ancestors are reached through the private:internal paths of
#! many classes are built in steps linear in the hierarchy (qore#7410)
/** A hub class that many classes inherit with private:internal access, and a chain of classes each of which another
    class inherits with private:internal access, so that the sets of the classes whose code can call the methods of
    the chain merge at every class of it: the access of the ancestors of a class is computed once for the lists of
    all its methods, and each computation visits each class and edge of the hierarchy a bounded number of times, so
    that the steps do not grow with the number of methods and grow linearly with the number of classes and with the
    number of subclasses.

    The steps are counted by a debug hook of the library, so that the checks are skipped by a library built without
    it.
*/
class PrivateInternalOwnerStepsTest inherits QUnit::Test {
    constructor() : QUnit::Test("PrivateInternalOwnerSteps", "1.0", \ARGV) {
        addTestCase("the methods of a class do not multiply the steps", \methodsTest());
        addTestCase("the steps grow linearly with the hierarchy", \sizeTest());
        addTestCase("the steps grow linearly with the subclasses", \subclassesTest());
        addTestCase("the calls of the owner classes", \callsTest());
        set_return_value(main());
    }

    #! returns the steps of the hierarchy walks of the parser so far, or NOTHING without the debug hook
    private static *int steps() {
        try {
            return call_function("dbg_class_hierarchy_walk_steps");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "NO-FUNCTION" || ex.err == "UNDEFINED-FUNCTION-CALL") {
                return;
            }
            rethrow;
        }
    }

    #! returns the source of the hierarchy
    /** \c M(l+1) is the top of a chain \c M1 ... \c M(l+1); each \c Xj inherits \c Mj with private:internal access;
        \c H inherits \c M1, and each of \c k classes \c Oi inherits \c H with private:internal access; \c R inherits
        all the \c Oi and \c Xj and has \c t methods and \c m(string) (none if \c t is 0); \c q classes \c Qn inherit \c R with a method each.  \c M(l+1)
        declares \c m(int), which the code of each \c Oi and \c Xj calls on an object of \c R.
    */
    private static string hierarchy(int k, int l, int t, int q) {
        string src = sprintf("class M%d { string m(int i) { return \"M%d\"; } }\n", l + 1, l + 1);
        for (int j = l; j >= 1; --j) {
            src += sprintf("class M%d inherits M%d {}\n", j, j + 1);
        }
        for (int j = 1; j <= l; ++j) {
            src += sprintf("class X%d inherits private:internal M%d { static string c(object o) { return o.m(1); } }\n", j,
                j);
        }
        src += "class H inherits M1 {}\n";
        for (int i = 0; i < k; ++i) {
            src += sprintf("class O%d inherits private:internal H { static string c(object o) { return o.m(1); } }\n", i);
        }
        list<string> parents = (map "O" + $1, xrange(k)) + (map "X" + $1, xrange(1, l + 1));
        src += sprintf("class R inherits %s {\n", parents.join(", "));
        for (int i = 0; i < t; ++i) {
            src += sprintf("    string t%d() { return \"R\"; }\n", i);
        }
        if (t) {
            src += "    string m(string s) { return s; }\n";
        }
        src += "}\n";
        for (int n = 0; n < q; ++n) {
            src += sprintf("class Q%d inherits R { string m(bool b) { return \"Q%d\"; } }\n", n, n);
        }
        return src;
    }

    #! returns the steps of the parse of the hierarchy
    private static int parseSteps(int k, int l, int t, int q) {
        Program p(PO_NEW_STYLE);
        int before = steps();
        p.parse(hierarchy(k, l, t, q), "hierarchy");
        return steps() - before;
    }

    methodsTest() {
        if (!exists steps()) {
            testSkip("the library has no class hierarchy step counter (a debug build is required)");
        }
        int one = parseSteps(50, 50, 1, 0);
        int many = parseSteps(50, 50, 100, 0);
        assertTrue(many <= 2 * one, sprintf("1 method: %d steps, 100 methods: %d steps", one, many));
    }

    sizeTest() {
        if (!exists steps()) {
            testSkip("the library has no class hierarchy step counter (a debug build is required)");
        }
        # the steps of the lists of the methods of R: those of the hierarchy with them, less those without them (the
        # classes of the chain walk their own hierarchies, whose sizes grow with the length of the chain)
        int small = parseSteps(100, 100, 20, 0) - parseSteps(100, 100, 0, 0);
        int large = parseSteps(200, 200, 20, 0) - parseSteps(200, 200, 0, 0);
        # twice the classes and edges: about twice the steps, not four times
        assertTrue(small > 0, sprintf("the steps of R's lists were counted: %d", small));
        assertTrue(large <= 3 * small, sprintf("100 owners: %d steps, 200 owners: %d steps", small, large));
        # each class and edge of the hierarchy a bounded number of times
        int size = (200 + 200) * 3 + 4;
        assertTrue(large <= 4 * size, sprintf("200 owners: %d steps for %d classes and edges", large, size));
    }

    subclassesTest() {
        if (!exists steps()) {
            testSkip("the library has no class hierarchy step counter (a debug build is required)");
        }
        int ten = parseSteps(100, 100, 1, 10) - parseSteps(100, 100, 1, 0);
        int twenty = parseSteps(100, 100, 1, 20) - parseSteps(100, 100, 1, 0);
        # each subclass walks the hierarchy once
        assertTrue(twenty <= 3 * ten, sprintf("10 subclasses: %d steps, 20 subclasses: %d steps", ten, twenty));
        # the classes and edges of the hierarchy: each subclass's walks visit each a bounded number of times
        int size = (100 + 100) * 3 + 100 + 4;
        assertTrue(twenty <= 20 * 10 * size, sprintf("20 subclasses: %d steps for %d classes and edges", twenty,
            size));
    }

    callsTest() {
        Program p(PO_NEW_STYLE);
        p.parse(hierarchy(20, 20, 5, 2) + "
list<string> sub calls() {
    Q1 q();
    list<string> l = (O0::c(q), O19::c(q), X1::c(q), X20::c(q));
    try {
        object o = q;
        l += o.m(1);
    } catch (hash<ExceptionInfo> ex) {
        l += ex.err;
    }
    return l;
}
", "calls");
        assertEq(("M21", "M21", "M21", "M21", "RUNTIME-OVERLOAD-ERROR"), p.callFunction("calls"));
    }
}
