#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class ColumnarResultTest

class ColumnarResultTest inherits QUnit::Test {
    constructor() : QUnit::Test("ColumnarResult", "1.0", \ARGV) {
        addTestCase("serializable inheritance", \serializableInheritance());
        addTestCase("mixed buffer round trip", \mixedBufferRoundTrip());
        addTestCase("sliced buffer round trip", \slicedBufferRoundTrip());
        addTestCase("row result round trip", \rowResultRoundTrip());
        addTestCase("scale-0 numeric narrowing", \scaleZeroNumericNarrowing());
        addTestCase("NUL characters in names and descriptions", \nulNames());
        addTestCase("NUL characters in strings passed on as C strings", \nulCStrings());
        set_return_value(main());
    }

    private serializableInheritance() {
        ColumnarResult result = makeMixedResult();
        assertEq(True, result instanceof Serializable);
    }

    private mixedBufferRoundTrip() {
        ColumnarResult result = makeMixedResult();
        ColumnarResult copy = roundTrip(result);
        assertColumnarEq(result, copy);
    }

    private slicedBufferRoundTrip() {
        ColumnarResult result = makeMixedResult().slice(offset: 1, count: 2);
        ColumnarResult copy = roundTrip(result);
        assertColumnarEq(result, copy);
    }

    private rowResultRoundTrip() {
        ColumnarResult result = ColumnarResult::fromRows((
            ("id": 1, "name": "alpha", "amount": 1.25n),
            ("id": 2, "name": NOTHING, "amount": -2.50n),
            ("id": 3, "name": "gamma", "amount": NOTHING),
        ));

        ColumnarResult copy = roundTrip(result);
        assertColumnarEq(result, copy);
    }

    private scaleZeroNumericNarrowing() {
        # a scale-0 numeric/decimal column with precision <= 18 must narrow to a dense
        # buffer<int64> (Qore integer) to match the scalar/row fetch paths; scale > 0 or
        # precision >= 19 must remain buffer<decimal128> (Qore number); driver-agnostic, applied
        # in the shared libqore columnar layer
        ColumnarResult result = ColumnarResult::fromColumnHash({
            "n15_0": (2n, 3n, NOTHING),
            "n18_0": (2n, 3n, NOTHING),
            "n15_2": (2.50n, 3.25n, NOTHING),
            "n20_0": (2n, 3n, NOTHING),
        }, {
            "n15_0": {"native_type": "numeric(15,0)", "nullable": True},
            "n18_0": {"native_type": "numeric(18,0)", "nullable": True},
            "n15_2": {"native_type": "numeric(15,2)", "nullable": True},
            "n20_0": {"native_type": "numeric(20,0)", "nullable": True},
        });

        hash<auto> columns = result.toColumnHash();
        # scale-0, precision <= 18 -> integer
        assertEq("buffer<*int64>", columns.n15_0.fullType(), "n15_0 narrows to int64");
        assertEq("buffer<*int64>", columns.n18_0.fullType(), "n18_0 narrows to int64");
        assertEq((2, 3, NOTHING), columns.n15_0.toList(), "n15_0 values");
        # scale > 0 -> number
        assertEq("buffer<*decimal128>", columns.n15_2.fullType(), "n15_2 stays decimal128");
        # precision >= 19 -> number
        assertEq("buffer<*decimal128>", columns.n20_0.fullType(), "n20_0 stays decimal128");
    }

    private ColumnarResult makeMixedResult() {
        return ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((1, 2, 3, 4)),
            "maybe_id": new buffer<*int64>((1, NOTHING, 3, 4)),
            "flag": new buffer<bool>((True, False, True, False)),
            "maybe_flag": new buffer<*bool>((True, NOTHING, False, True)),
            "amount": new buffer<*decimal128>((1.20n, NOTHING, -4.50n, 7n)),
            "name": new buffer<*string>(("alpha", NOTHING, "gamma", "")),
            "note": ("first", NOTHING, "third", "fourth"),
        });
    }

    private ColumnarResult roundTrip(ColumnarResult result) {
        binary serialized = Serializable::serialize(result);
        return Serializable::deserialize(serialized);
    }

    private assertColumnarEq(ColumnarResult expected, ColumnarResult actual) {
        assertEq(expected.numRows(), actual.numRows());
        assertEq(expected.numCols(), actual.numCols());
        assertEq(expected.columnNames(), actual.columnNames());
        assertEq(expected.schemaV2(), actual.schemaV2());
        assertEq(expected.toRows(), actual.toRows());

        hash<auto> expected_columns = expected.toColumnHash();
        hash<auto> actual_columns = actual.toColumnHash();
        foreach string name in (expected.columnNames()) {
            auto expected_value = expected_columns.(name);
            auto actual_value = actual_columns.(name);
            assertEq(expected_value.fullType(), actual_value.fullType(), name + " type");
            assertEq(columnValues(expected_value), columnValues(actual_value), name + " values");
        }
    }

    private list<auto> columnValues(auto value) {
        return value.type() == Type::List ? value : value.toList();
    }

    # a column or field name with a NUL character cannot be a hash key, and a name or description string is used
    # whole: it is never cut at a NUL character to another valid value
    private nulNames() {
        # a schema field name
        assertThrows("HASH-KEY-ERROR", \ColumnarResult::fromColumnHash(), ({"st": ({"a": 1},)}, {"st": {"schema": {
            "kind": "struct",
            "children": ({"name": "a\x00b", "kind": "int"},),
        }}}), "a struct field name with a NUL character cannot be a hash key");
        # a column name given in the schema
        assertThrows("HASH-KEY-ERROR", \ColumnarResult::fromColumnHash(), ({"c": (1,)}, {"c": {"schema": {
            "name": "c\x00d",
            "kind": "int",
        }}}), "a column name with a NUL character in the schema cannot be a hash key");

        # a kind with a NUL character is not the kind before the NUL character, but an unknown kind
        hash<auto> nul_kind = ColumnarResult::fromColumnHash({"st": ({"a": 1},)}, {"st": {"schema": {
            "kind": "struct\x00x",
            "children": ({"name": "a", "kind": "int"},),
        }}}).schemaV2()[0];
        hash<auto> unknown_kind = ColumnarResult::fromColumnHash({"st": ({"a": 1},)}, {"st": {"schema": {
            "kind": "nosuchkind",
            "children": ({"name": "a", "kind": "int"},),
        }}}).schemaV2()[0];
        assertEq(unknown_kind.kind, nul_kind.kind, "a kind with a NUL character is an unknown kind");

        # a lookup by a name with a NUL character finds no column, rather than the column named by the part before it
        ColumnarResult result = ColumnarResult::fromColumnHash({"a": (1, NOTHING), "s": ("x", "y")});
        assertThrows("COLUMNAR-RESULT-ERROR", "does not exist", \result.getColumn(), ("a\x00b",),
            "getColumn() finds no column for a name with a NUL character");
        assertThrows("COLUMNAR-RESULT-ERROR", "does not exist", \result.nullMask(), ("a\x00b",),
            "nullMask() finds no column for a name with a NUL character");
        assertThrows("COLUMNAR-RESULT-ERROR", "does not exist", \result.stringPredicateMask(),
            ("s\x00t", "contains", "x"), "stringPredicateMask() finds no column for a name with a NUL character");

        # a serialized column name with a NUL character cannot be a hash key
        hash<SerializationInfo> data = result.serializeToData();
        string column_index;
        string schema_index;
        foreach hash<auto> i in (data._index.pairIterator()) {
            # only hash entries have members
            if (!i.value.hasKey("_members")) {
                continue;
            }
            hash<auto> members = i.value._members;
            if (members.data && members.name == "a") {
                column_index = i.key;
                schema_index = members.schema._index;
            }
        }
        hash<SerializationInfo> bad_column = data;
        bad_column._index{column_index}._members.name = "a\x00b";
        assertThrows("HASH-KEY-ERROR", \Serializable::deserialize(), (bad_column,),
            "a serialized column name with a NUL character cannot be a hash key");
        hash<SerializationInfo> bad_schema = data;
        bad_schema._index{schema_index}._members.name = "a\x00b";
        assertThrows("HASH-KEY-ERROR", \Serializable::deserialize(), (bad_schema,),
            "a serialized schema name with a NUL character cannot be a hash key");
    }

    # a description string or operator passed on as a C string would be cut at a NUL character and name another
    # value, so it is refused
    private nulCStrings() {
        assertThrows("COLUMNAR-RESULT-ERROR", "native type", \ColumnarResult::fromColumnHash(),
            ({"a": (1,)}, {"a": {"native_type": "int8\x00x"}}), "a native type with a NUL character is refused");
        assertThrows("COLUMNAR-SCHEMA-ERROR", "buffer type", \ColumnarResult::fromColumnHash(),
            ({"a": (1,)}, {"a": {"schema": {"buffer_type": "int64\x00x"}}}),
            "a buffer type with a NUL character is refused");
        assertThrows("COLUMNAR-SCHEMA-ERROR", "time unit", \ColumnarResult::fromColumnHash(),
            ({"t": (2026-01-01T00:00:00Z,)}, {"t": {"schema": {"kind": "timestamp", "time_unit": "us\x00x"}}}),
            "a time unit with a NUL character is refused");
        assertThrows("COLUMNAR-SCHEMA-ERROR", "time zone", \ColumnarResult::fromColumnHash(),
            ({"t": (2026-01-01T00:00:00Z,)}, {"t": {"schema": {"kind": "timestamp", "timezone": "UTC\x00x"}}}),
            "a time zone with a NUL character is refused");

        ColumnarResult result = ColumnarResult::fromColumnHash({"a": new buffer<int64>((1, 2)), "s": ("x", "y")});
        buffer<bool> mask = result.nullMask("a", True);
        assertThrows("COLUMNAR-RESULT-ERROR", "mask operator", \result.combineMasks(), (mask, mask, "&&\x00x"),
            "a mask operator with a NUL character is refused");
        assertThrows("COLUMNAR-RESULT-ERROR", "string predicate", \result.stringPredicateMask(),
            ("s", "contains\x00x", "x"), "a string predicate with a NUL character is refused");

        # a serialized buffer element type
        hash<SerializationInfo> data = result.serializeToData();
        string data_index;
        foreach hash<auto> i in (data._index.pairIterator()) {
            if (!i.value.hasKey("_members")) {
                continue;
            }
            hash<auto> members = i.value._members;
            if (members.element_type == "int64") {
                data_index = i.key;
            }
        }
        hash<SerializationInfo> bad_type = data;
        bad_type._index{data_index}._members.element_type = "int64\x00x";
        assertThrows("DESERIALIZATION-ERROR", "buffer element type", \Serializable::deserialize(), (bad_type,),
            "a serialized buffer element type with a NUL character is refused");
    }
}
