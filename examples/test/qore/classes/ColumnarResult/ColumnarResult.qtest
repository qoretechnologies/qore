#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class ColumnarResultTest

#! An enum with an integer value, for the dense integer column tests
enum CrIntEnum {
    Twelve = 12,
}

#! An object held by a ColumnarResult in the garbage collection tests
class CrNode inherits Serializable {
    public {
        auto ref;

        #! counts the destructions of CrNode objects
        static Counter destroyed();
    }

    destructor() {
        CrNode::destroyed.inc();
    }
}

class ColumnarResultTest inherits QUnit::Test {
    constructor() : QUnit::Test("ColumnarResult", "1.0", \ARGV) {
        addTestCase("serializable inheritance", \serializableInheritance());
        addTestCase("mixed buffer round trip", \mixedBufferRoundTrip());
        addTestCase("sliced buffer round trip", \slicedBufferRoundTrip());
        addTestCase("row result round trip", \rowResultRoundTrip());
        addTestCase("scale-0 numeric narrowing", \scaleZeroNumericNarrowing());
        addTestCase("large ints in a dense int64 column", \largeIntColumn());
        addTestCase("script values accepted in a dense integer column", \scriptIntColumnAccepted());
        addTestCase("script values refused in a dense integer column", \scriptIntColumnRefused());
        addTestCase("NUL characters in names and descriptions", \nulNames());
        addTestCase("NUL characters in strings passed on as C strings", \nulCStrings());
        addTestCase("a cycle through an object in a ColumnarResult column is collected", \cycleCollection());
        set_return_value(main());
    }

    private serializableInheritance() {
        ColumnarResult result = makeMixedResult();
        assertEq(True, result instanceof Serializable);
    }

    private mixedBufferRoundTrip() {
        ColumnarResult result = makeMixedResult();
        ColumnarResult copy = roundTrip(result);
        assertColumnarEq(result, copy);
    }

    private slicedBufferRoundTrip() {
        ColumnarResult result = makeMixedResult().slice(offset: 1, count: 2);
        ColumnarResult copy = roundTrip(result);
        assertColumnarEq(result, copy);
    }

    private rowResultRoundTrip() {
        ColumnarResult result = ColumnarResult::fromRows((
            ("id": 1, "name": "alpha", "amount": 1.25n),
            ("id": 2, "name": NOTHING, "amount": -2.50n),
            ("id": 3, "name": "gamma", "amount": NOTHING),
        ));

        ColumnarResult copy = roundTrip(result);
        assertColumnarEq(result, copy);
    }

    private scaleZeroNumericNarrowing() {
        # a scale-0 numeric/decimal column with precision <= 18 must narrow to a dense
        # buffer<int64> (Qore integer) to match the scalar/row fetch paths; scale > 0 or
        # precision >= 19 must remain buffer<decimal128> (Qore number); driver-agnostic, applied
        # in the shared libqore columnar layer
        ColumnarResult result = ColumnarResult::fromColumnHash({
            "n15_0": (2n, 3n, NOTHING),
            "n18_0": (2n, 3n, NOTHING),
            "n15_2": (2.50n, 3.25n, NOTHING),
            "n20_0": (2n, 3n, NOTHING),
        }, {
            "n15_0": {"native_type": "numeric(15,0)", "nullable": True},
            "n18_0": {"native_type": "numeric(18,0)", "nullable": True},
            "n15_2": {"native_type": "numeric(15,2)", "nullable": True},
            "n20_0": {"native_type": "numeric(20,0)", "nullable": True},
        });

        hash<auto> columns = result.toColumnHash();
        # scale-0, precision <= 18 -> integer
        assertEq("buffer<*int64>", columns.n15_0.fullType(), "n15_0 narrows to int64");
        assertEq("buffer<*int64>", columns.n18_0.fullType(), "n18_0 narrows to int64");
        assertEq((2, 3, NOTHING), columns.n15_0.toList(), "n15_0 values");
        # scale > 0 -> number
        assertEq("buffer<*decimal128>", columns.n15_2.fullType(), "n15_2 stays decimal128");
        # precision >= 19 -> number
        assertEq("buffer<*decimal128>", columns.n20_0.fullType(), "n20_0 stays decimal128");
    }

    #! ints outside of the inline range are stored in and read from a dense int64 buffer (qore#6146)
    /** The values were stored correctly, but each one leaked the temporary node that held it, which valgrind shows
        (definitely lost); this checks the values on the same path
    */
    private largeIntColumn() {
        list<auto> ints = (1 << 50, -(1 << 60), 9223372036854775807, -9223372036854775807 - 1, 3, NOTHING);
        ColumnarResult result = ColumnarResult::fromColumnHash({
            "i": ints,
            "n18_0": (123456789012345678n, -123456789012345678n, NOTHING, 1n, 2n, 3n),
        }, {
            "i": {"native_type": "bigint", "nullable": True},
            "n18_0": {"native_type": "numeric(18,0)", "nullable": True},
        });
        hash<auto> columns = result.toColumnHash();
        assertEq("buffer<*int64>", columns.i.fullType());
        assertEq(ints, columns.i.toList());
        assertEq("buffer<*int64>", columns.n18_0.fullType());
        assertEq((123456789012345678, -123456789012345678, NOTHING, 1, 2, 3), columns.n18_0.toList());
    }

    # the descriptions that make a list column a dense integer buffer
    private hash<string, hash<auto>> intColumnDescs() {
        return {
            "bigint": {"native_type": "bigint"},
            "NT_INT": {"type": NT_INT},
            "integer": {"native_type": "integer"},
            "numeric(10,0)": {"native_type": "numeric(10,0)"},
        };
    }

    # ints, floats, numbers, numeric strings, NULL and NOTHING given by a script are stored in a dense integer column
    # (a float or number is truncated toward zero, as by int())
    private scriptIntColumnAccepted() {
        list<auto> values = (1, 1000, -3, 1.5, -1.5, 2.9n, -2.9n, "12", " -7 ", "+5", "\t8\n", NOTHING, NULL);
        list<auto> expected = (1, 1000, -3, 1, -1, 2, -2, 12, -7, 5, 8, NOTHING, NOTHING);
        foreach hash<auto> i in (intColumnDescs().pairIterator()) {
            ColumnarResult r = ColumnarResult::fromColumnHash({"i": values}, {"i": i.value});
            auto column = r.toColumnHash().i;
            assertRegex("^buffer<\\*int(64|32)>$", column.fullType(), i.key + ": dense buffer");
            assertEq(expected, column.toList(), i.key + ": values");
        }

        # numeric strings of values that are not stored inline in a value (see largeIntColumn() for ints)
        ColumnarResult r = ColumnarResult::fromColumnHash({"i": ("4611686018427387904", "-9223372036854775808")},
            {"i": {"native_type": "bigint"}});
        assertEq((1 << 62, -9223372036854775807 - 1), r.toColumnHash().i.toList(), "64-bit numeric strings");

        # fromRows() checks the values in the same way
        r = ColumnarResult::fromRows((("i": "12"), ("i": 2.5), ("i": NOTHING)), {"i": {"native_type": "bigint"}});
        assertEq((12, 2, NOTHING), r.toColumnHash().i.toList(), "fromRows() values");

        # a column of ints with no description is inferred as a dense int64 column
        r = ColumnarResult::fromColumnHash({"i": (1, NOTHING, 3)});
        assertEq("buffer<*int64>", r.toColumnHash().i.fullType(), "inferred int column");
        assertEq((1, NOTHING, 3), r.toColumnHash().i.toList(), "inferred int column values");

        # a list with a value that is not an int is not inferred as an int column, and keeps its values
        r = ColumnarResult::fromColumnHash({"i": (1, "x", True)});
        assertEq((1, "x", True), r.toColumnHash().i, "inferred mixed column");

        # an enum value with an integer value is an int, and a numeric string in an encoding that is not
        # ASCII-compatible is read as the same characters in UTF-8
        r = ColumnarResult::fromColumnHash({"i": (CrIntEnum::Twelve, convert_encoding("42", "UTF-16LE"))},
            {"i": {"native_type": "bigint"}});
        assertEq((12, 42), r.toColumnHash().i.toList(), "enum and UTF-16 values");
    }

    # any other value given by a script for a dense integer column raises an exception instead of being stored as an
    # integer (before qore#6147, "x" was stored as 0)
    private scriptIntColumnRefused() {
        # the type of each refused value in the message
        hash<string, auto> refused = {
            "string": "x",
            "empty string": "",
            "fraction string": "1.5",
            "exponent string": "1e3",
            "trailing characters": "12abc",
            "sign only": "-",
            "whitespace only": "  ",
            "out of range string": "9223372036854775808",
            "NUL character string": "12\x00",
            "bool True": True,
            "bool False": False,
            "list": (1, 2),
            "hash": {"a": 1},
            "date": 2026-01-01,
            "binary": <0102>,
        };
        foreach hash<auto> d in (intColumnDescs().pairIterator()) {
            foreach hash<auto> v in (refused.pairIterator()) {
                string label = sprintf("%s: %s", d.key, v.key);
                string expected_desc = v.value.typeCode() == NT_STRING
                    ? "integer column 'col' row 1 has a string that is not a decimal integer"
                    : sprintf("integer column 'col' row 1 has type '%s'", v.value.fullType());
                *hash<ExceptionInfo> ex;
                try {
                    ColumnarResult r = ColumnarResult::fromColumnHash({"col": (1, v.value, 3)}, {"col": d.value});
                } catch (hash<ExceptionInfo> e) {
                    ex = e;
                }
                assertEq("COLUMNAR-RESULT-ERROR", ex.err, label + ": err");
                assertEq(expected_desc, ex.desc ? ex.desc.substr(0, expected_desc.length()) : NOTHING,
                    label + ": desc");
            }
        }

        # the issue's example
        assertThrows("COLUMNAR-RESULT-ERROR", "integer column 'i' row 1 has a string",
            \ColumnarResult::fromColumnHash(), ({"i": (1 << 50, "x")}, {"i": {"native_type": "bigint"}}),
            "qore#6147 example");

        # fromRows() checks the values in the same way
        assertThrows("COLUMNAR-RESULT-ERROR", "integer column 'i' row 2 has type 'bool'",
            \ColumnarResult::fromRows(), ((("i": 1), ("i": NOTHING), ("i": True)), {"i": {"native_type": "bigint"}}),
            "fromRows() refuses a bool");

        # a char and a non-numeric string in an encoding that is not ASCII-compatible
        assertThrows("COLUMNAR-RESULT-ERROR", "integer column 'i' row 0 has type 'char'",
            \ColumnarResult::fromColumnHash(), ({"i": ("ab"[0],)}, {"i": {"native_type": "bigint"}}),
            "a char is refused");
        assertThrows("COLUMNAR-RESULT-ERROR", "integer column 'i' row 0 has a string",
            \ColumnarResult::fromColumnHash(), ({"i": (convert_encoding("4x", "UTF-16LE"),)},
            {"i": {"native_type": "bigint"}}), "a non-numeric UTF-16 string is refused");

        # a "schema" sub-hash of the description that makes a list column a dense integer column is checked too
        assertThrows("COLUMNAR-RESULT-ERROR", "integer column 'i' row 1 has a string",
            \ColumnarResult::fromColumnHash(), ({"i": (1, "x")}, {"i": {"schema": {"native_type": "bigint"}}}),
            "a schema sub-hash with an integer native type");
        assertThrows("COLUMNAR-RESULT-ERROR", "integer column 'i' row 1 has type 'bool'",
            \ColumnarResult::fromColumnHash(), ({"i": (1, True)},
            {"i": {"native_type": "json", "schema": {"native_type": "integer"}}}),
            "a schema sub-hash with an integer native type under a native type that is not dense");
        assertThrows("COLUMNAR-RESULT-ERROR", "integer column 'i' row 1 has a string",
            \ColumnarResult::fromRows(), ((("i": 1), ("i": "x")), {"i": {"schema": {"native_type": "bigint"}}}),
            "fromRows() with a schema sub-hash");
        ColumnarResult sr = ColumnarResult::fromColumnHash({"i": (1, "12", 2.5)},
            {"i": {"schema": {"native_type": "bigint"}}});
        assertEq((1, 12, 2), sr.toColumnHash().i.toList(), "a schema sub-hash with accepted values");

        # serialized data with a list column of a dense integer type is checked in the same way
        hash<SerializationInfo> data = ColumnarResult::fromColumnHash({"a": (1, "x")}).serializeToData();
        bool found;
        foreach hash<auto> i in (data._index.pairIterator()) {
            # only hash entries have members
            if (i.value.hasKey("_members") && i.value._members.name == "a" && i.value._members.hasKey("kind")) {
                data._index{i.key}._members += {"kind": "int", "native_type": "bigint"};
                found = True;
            }
        }
        assertTrue(found, "serialized schema found");
        assertThrows("COLUMNAR-RESULT-ERROR", "integer column 'a' row 1 has a string", \Serializable::deserialize(),
            (data,), "deserialization refuses a non-numeric string");
    }

    private ColumnarResult makeMixedResult() {
        return ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((1, 2, 3, 4)),
            "maybe_id": new buffer<*int64>((1, NOTHING, 3, 4)),
            "flag": new buffer<bool>((True, False, True, False)),
            "maybe_flag": new buffer<*bool>((True, NOTHING, False, True)),
            "amount": new buffer<*decimal128>((1.20n, NOTHING, -4.50n, 7n)),
            "name": new buffer<*string>(("alpha", NOTHING, "gamma", "")),
            "note": ("first", NOTHING, "third", "fourth"),
        });
    }

    private ColumnarResult roundTrip(ColumnarResult result) {
        binary serialized = Serializable::serialize(result);
        return Serializable::deserialize(serialized);
    }

    private assertColumnarEq(ColumnarResult expected, ColumnarResult actual) {
        assertEq(expected.numRows(), actual.numRows());
        assertEq(expected.numCols(), actual.numCols());
        assertEq(expected.columnNames(), actual.columnNames());
        assertEq(expected.schemaV2(), actual.schemaV2());
        assertEq(expected.toRows(), actual.toRows());

        hash<auto> expected_columns = expected.toColumnHash();
        hash<auto> actual_columns = actual.toColumnHash();
        foreach string name in (expected.columnNames()) {
            auto expected_value = expected_columns.(name);
            auto actual_value = actual_columns.(name);
            assertEq(expected_value.fullType(), actual_value.fullType(), name + " type");
            assertEq(columnValues(expected_value), columnValues(actual_value), name + " values");
        }
    }

    private list<auto> columnValues(auto value) {
        return value.type() == Type::List ? value : value.toList();
    }

    # a column or field name with a NUL character cannot be a hash key, and a name or description string is used
    # whole: it is never cut at a NUL character to another valid value
    private nulNames() {
        # a schema field name
        assertThrows("HASH-KEY-ERROR", \ColumnarResult::fromColumnHash(), ({"st": ({"a": 1},)}, {"st": {"schema": {
            "kind": "struct",
            "children": ({"name": "a\x00b", "kind": "int"},),
        }}}), "a struct field name with a NUL character cannot be a hash key");
        # a column name given in the schema
        assertThrows("HASH-KEY-ERROR", \ColumnarResult::fromColumnHash(), ({"c": (1,)}, {"c": {"schema": {
            "name": "c\x00d",
            "kind": "int",
        }}}), "a column name with a NUL character in the schema cannot be a hash key");

        # a kind with a NUL character is not the kind before the NUL character, but an unknown kind
        hash<auto> nul_kind = ColumnarResult::fromColumnHash({"st": ({"a": 1},)}, {"st": {"schema": {
            "kind": "struct\x00x",
            "children": ({"name": "a", "kind": "int"},),
        }}}).schemaV2()[0];
        hash<auto> unknown_kind = ColumnarResult::fromColumnHash({"st": ({"a": 1},)}, {"st": {"schema": {
            "kind": "nosuchkind",
            "children": ({"name": "a", "kind": "int"},),
        }}}).schemaV2()[0];
        assertEq(unknown_kind.kind, nul_kind.kind, "a kind with a NUL character is an unknown kind");

        # a lookup by a name with a NUL character finds no column, rather than the column named by the part before it
        ColumnarResult result = ColumnarResult::fromColumnHash({"a": (1, NOTHING), "s": ("x", "y")});
        assertThrows("COLUMNAR-RESULT-ERROR", "does not exist", \result.getColumn(), ("a\x00b",),
            "getColumn() finds no column for a name with a NUL character");
        assertThrows("COLUMNAR-RESULT-ERROR", "does not exist", \result.nullMask(), ("a\x00b",),
            "nullMask() finds no column for a name with a NUL character");
        assertThrows("COLUMNAR-RESULT-ERROR", "does not exist", \result.stringPredicateMask(),
            ("s\x00t", "contains", "x"), "stringPredicateMask() finds no column for a name with a NUL character");

        # a serialized column name with a NUL character cannot be a hash key
        hash<SerializationInfo> data = result.serializeToData();
        string column_index;
        string schema_index;
        foreach hash<auto> i in (data._index.pairIterator()) {
            # only hash entries have members
            if (!i.value.hasKey("_members")) {
                continue;
            }
            hash<auto> members = i.value._members;
            if (members.data && members.name == "a") {
                column_index = i.key;
                schema_index = members.schema._index;
            }
        }
        hash<SerializationInfo> bad_column = data;
        bad_column._index{column_index}._members.name = "a\x00b";
        assertThrows("HASH-KEY-ERROR", \Serializable::deserialize(), (bad_column,),
            "a serialized column name with a NUL character cannot be a hash key");
        hash<SerializationInfo> bad_schema = data;
        bad_schema._index{schema_index}._members.name = "a\x00b";
        assertThrows("HASH-KEY-ERROR", \Serializable::deserialize(), (bad_schema,),
            "a serialized schema name with a NUL character cannot be a hash key");
    }

    # a description string or operator passed on as a C string would be cut at a NUL character and name another
    # value, so it is refused
    private nulCStrings() {
        assertThrows("COLUMNAR-RESULT-ERROR", "native type", \ColumnarResult::fromColumnHash(),
            ({"a": (1,)}, {"a": {"native_type": "int8\x00x"}}), "a native type with a NUL character is refused");
        assertThrows("COLUMNAR-SCHEMA-ERROR", "buffer type", \ColumnarResult::fromColumnHash(),
            ({"a": (1,)}, {"a": {"schema": {"buffer_type": "int64\x00x"}}}),
            "a buffer type with a NUL character is refused");
        assertThrows("COLUMNAR-SCHEMA-ERROR", "time unit", \ColumnarResult::fromColumnHash(),
            ({"t": (2026-01-01T00:00:00Z,)}, {"t": {"schema": {"kind": "timestamp", "time_unit": "us\x00x"}}}),
            "a time unit with a NUL character is refused");
        assertThrows("COLUMNAR-SCHEMA-ERROR", "time zone", \ColumnarResult::fromColumnHash(),
            ({"t": (2026-01-01T00:00:00Z,)}, {"t": {"schema": {"kind": "timestamp", "timezone": "UTC\x00x"}}}),
            "a time zone with a NUL character is refused");

        ColumnarResult result = ColumnarResult::fromColumnHash({"a": new buffer<int64>((1, 2)), "s": ("x", "y")});
        buffer<bool> mask = result.nullMask("a", True);
        assertThrows("COLUMNAR-RESULT-ERROR", "mask operator", \result.combineMasks(), (mask, mask, "&&\x00x"),
            "a mask operator with a NUL character is refused");
        assertThrows("COLUMNAR-RESULT-ERROR", "string predicate", \result.stringPredicateMask(),
            ("s", "contains\x00x", "x"), "a string predicate with a NUL character is refused");

        # a serialized buffer element type
        hash<SerializationInfo> data = result.serializeToData();
        string data_index;
        foreach hash<auto> i in (data._index.pairIterator()) {
            if (!i.value.hasKey("_members")) {
                continue;
            }
            hash<auto> members = i.value._members;
            if (members.element_type == "int64") {
                data_index = i.key;
            }
        }
        hash<SerializationInfo> bad_type = data;
        bad_type._index{data_index}._members.element_type = "int64\x00x";
        assertThrows("DESERIALIZATION-ERROR", "buffer element type", \Serializable::deserialize(), (bad_type,),
            "a serialized buffer element type with a NUL character is refused");
    }

    # an object in a column of a ColumnarResult that refers to the ColumnarResult
    private crMakeCycle(string kind) {
        CrNode n();
        switch (kind) {
            case "fromColumnHash":
                n.ref = ColumnarResult::fromColumnHash({"x": (n,)});
                break;
            case "fromRows":
                n.ref = ColumnarResult::fromRows(({"x": n},));
                break;
            case "nested":
                n.ref = ColumnarResult::fromColumnHash({"k": (1,), "x": ({"node": n},)});
                break;
            case "filter":
                n.ref = ColumnarResult::fromColumnHash({"x": (n, NOTHING)}).filter((True, False));
                break;
            case "take":
                n.ref = ColumnarResult::fromColumnHash({"x": (NOTHING, n)}).take((1,));
                break;
            case "slice":
                n.ref = ColumnarResult::fromColumnHash({"x": (NOTHING, n)}).slice(offset: 1, count: 1);
                break;
        }
        auto first = n.ref.getColumn("x")[0];
        if (kind == "nested") {
            first = first.node;
        }
        assertEq(True, first == n, sprintf("the %s() result holds the object", kind));
    }

    # an object in a deserialized ColumnarResult that refers to it
    private crMakeDeserializedCycle() {
        CrNode n();
        n.ref = ColumnarResult::fromColumnHash({"x": (n,)});
        CrNode copy = Serializable::deserialize(n.serializeToData());
        assertEq(True, copy != n, "the object is deserialized");
        assertEq(True, copy.ref.getColumn("x")[0] == copy, "the deserialized ColumnarResult holds the copy");
    }

    private cycleCollection() {
        int start = CrNode::destroyed.getCount();
        int count = 0;
        foreach string kind in ("fromColumnHash", "fromRows", "nested", "filter", "take", "slice") {
            crMakeCycle(kind);
            assertEq(++count, CrNode::destroyed.getCount() - start,
                sprintf("a cycle through a %s() result is collected", kind));
        }
        crMakeDeserializedCycle();
        assertEq(count + 2, CrNode::destroyed.getCount() - start,
            "a cycle through a deserialized ColumnarResult is collected, as is the original");

        # a ColumnarResult held from outside the cycle keeps it
        ColumnarResult kept;
        {
            CrNode n();
            kept = ColumnarResult::fromColumnHash({"x": (n,)});
            n.ref = kept;
        }
        assertEq(count + 2, CrNode::destroyed.getCount() - start, "a cycle held from outside is not collected");
        CrNode node = kept.getColumn("x")[0];
        assertEq(True, node.ref == kept, "the object in the column still refers to the ColumnarResult");
        remove node;
        remove kept;
        assertEq(count + 3, CrNode::destroyed.getCount() - start, "the cycle is collected when it is no longer held");
    }
}
