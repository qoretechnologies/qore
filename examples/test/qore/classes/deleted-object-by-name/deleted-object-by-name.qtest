#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of self calls on deleted objects

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class DeletedObjectByNameTest

#! Regression test for issue #6168: a self call on a deleted object that is looked up by name names the object's class
/** A self call on an object deleted before the call that is not bound to the method resolved at parse time (an object
    of a subclass, or a call of an abstract method) is looked up by name on the class of the object; the AST interpreter
    raises "cannot call <class of the object>::<method>() on an object that has already been deleted"
    (qore_class_private::evalMethod()), and the IR interpreter and JIT code named the class of the method that they
    found.

    DeletedObjectByName.q makes these calls; its output must be the one in DeletedObjectByName.expected in every
    execution mode, on the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class DeletedObjectByNameTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/DeletedObjectByName.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/DeletedObjectByName.expected");
    }

    constructor() : QUnit::Test("self call on a deleted object looked up by name", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/deleted-object-by-name";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
