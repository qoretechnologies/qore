#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of the class member layout and initialization of objects

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class PrivateInternalMemberInitTest

#! Regression test for issue #6402: each class's private:internal members are initialized in a subclass's objects
/** When a class declared a private:internal member with the name of a private:internal member of one of its base
    classes, the member of the class was not initialized in an object of a subclass, so the class's methods read no
    value.

    PrivateInternalMemberInit.q reads the members of each level of such hierarchies: two levels and their subclasses,
    the same name at several levels (adjacent or not) of a deep chain, members without initializers, a public member
    with the same name in a subclass or in another parent, multiple inheritance, a diamond, object members (and the
    order of their destructors), transient members and serialization, static members, closures and copy(); its output
    must be the one in PrivateInternalMemberInit.expected in every execution mode, on the IR tier and in programs
    compiled with qcc -O0 and -O3.
*/
class PrivateInternalMemberInitTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/PrivateInternalMemberInit.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/PrivateInternalMemberInit.expected");
    }

    constructor() : QUnit::Test("private:internal member initialization", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/private-internal-member-init";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
