#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%prepend-module-path "${SCRIPT_DIR}"
%requires ./SandboxSerializationTrustedLib.qm

%exec-class SandboxSerializationTrustedTest

#! the trusted forms of the Serializable API (qore#7146)
/** Trusted code that sandboxed code calls serializes and deserializes the values of its own Program with all state
    with Serializable::serializeTrusted(), serializeTrustedToData() and deserializeTrusted(), where the plain forms
    withhold the non-public state of the classes declared by trusted code; sandboxed code cannot call them, directly,
    through a call reference or a closure
*/

#! a class declared by trusted code with non-public state, such as an order's data
class StOrderData inherits Serializable {
    private {
        string secret = "ORDER-STATE";
    }

    string getSecret() {
        return secret;
    }
}

#! the code of another trusted class, which sandboxed code calls: a cache of serialized values
class StCache {
    public {
        static binary stored;
    }

    #! serializes an object of another trusted class with the plain form
    static string storePlain() {
        try {
            StCache::stored = Serializable::serialize(new StOrderData());
            return "OK";
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    #! serializes an object of another trusted class with the trusted form
    static string storeTrusted() {
        try {
            StCache::stored = Serializable::serializeTrusted(new StOrderData());
            return "OK";
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    #! serializes to data with the trusted form and deserializes it with the trusted form
    static string roundTripData() {
        try {
            hash<SerializationInfo> h = Serializable::serializeTrustedToData(new StOrderData());
            StOrderData o = Serializable::deserializeTrusted(h);
            return o.getSecret();
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    #! serializes to a stream with the trusted form and deserializes it from a stream with the trusted form
    static string roundTripStream() {
        try {
            BinaryOutputStream out();
            Serializable::serializeTrusted(new StOrderData(), out);
            BinaryInputStream input(out.getData());
            StOrderData o = Serializable::deserializeTrusted(input);
            return o.getSecret();
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    #! serializes the given object, which the test shares, with the trusted form
    static string serializeShared(object o) {
        try {
            Serializable::serializeTrusted(o);
            return "OK";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! serializes the given object with the trusted form and returns whether its non-public state is in the data
    static string serTrustedObj(object o) {
        try {
            return sprintf("%N", Serializable::serializeTrustedToData(o)) =~ /ORDER-STATE/ ? "STATE" : "NO-STATE";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! serializes the given object with the plain form
    static string serPlainObj(object o) {
        try {
            return sprintf("%N", Serializable::serializeToData(o)) =~ /ORDER-STATE/ ? "STATE" : "NO-STATE";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! serializes the given object with Program::serializeToData() and returns whether its non-public state is in the
    #! data
    static string serProgramObj(Program pg, object o) {
        try {
            return sprintf("%N", pg.serializeToData(o)) =~ /ORDER-STATE/ ? "STATE" : "NO-STATE";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! formats the given object
    static string formatObj(object o) {
        return sprintf("%y", o) =~ /ORDER-STATE/ ? "STATE" : "NO-STATE";
    }

    #! deserializes the stored data, which the trusted code wrote, with the plain form
    static string loadPlain() {
        try {
            StOrderData o = Serializable::deserialize(StCache::stored);
            return o.getSecret();
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    #! deserializes the stored data, which the trusted code wrote, with the trusted form
    static string loadTrusted() {
        try {
            StOrderData o = Serializable::deserializeTrusted(StCache::stored);
            return o.getSecret();
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("%s: %s", ex.err, ex.desc);
        }
    }
}

#! a call reference to the trusted form that trusted code outside a class creates
code sub st_host_ref() {
    return \Serializable::serializeTrusted();
}

public class SandboxSerializationTrustedTest inherits QUnit::Test {
    private {
        SandboxManager manager();
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
    }

    constructor() : QUnit::Test("SandboxSerializationTrusted", "1.0") {
        p.setSandboxManager(manager);
        p.importClass("StOrderData");
        p.importClass("StCache");
        p.parse("string sub call(string m) {\n"
            "    switch (m) {\n"
            "        case \"storePlain\": return StCache::storePlain();\n"
            "        case \"storeTrusted\": return StCache::storeTrusted();\n"
            "        case \"loadPlain\": return StCache::loadPlain();\n"
            "        case \"loadTrusted\": return StCache::loadTrusted();\n"
            "        case \"roundTripData\": return StCache::roundTripData();\n"
            "        case \"roundTripStream\": return StCache::roundTripStream();\n"
            "    }\n"
            "    return \"UNKNOWN\";\n"
            "}\n"
            "string sub direct(string api) {\n"
            "    try {\n"
            "        switch (api) {\n"
            "            case \"serializeTrusted\": Serializable::serializeTrusted(new StOrderData()); break;\n"
            "            case \"serializeTrustedToData\": Serializable::serializeTrustedToData(new StOrderData()); "
            "break;\n"
            "            case \"deserializeTrusted\": Serializable::deserializeTrusted(Serializable::serialize(1)); "
            "break;\n"
            "        }\n"
            "        return \"OK\";\n"
            "    } catch (hash<ExceptionInfo> ex) {\n"
            "        return ex.err;\n"
            "    }\n"
            "}\n"
            "string sub invoke(code c, auto arg) {\n"
            "    try {\n"
            "        c(arg);\n"
            "        return \"OK\";\n"
            "    } catch (hash<ExceptionInfo> ex) {\n"
            "        return ex.err;\n"
            "    }\n"
            "}\n"
            "code sub closure() { return auto sub (auto v) { return Serializable::serializeTrusted(v); }; }\n"
            "string sub deser_form(string form) {\n"
            "    binary b = Serializable::serialize(1);\n"
            "    try {\n"
            "        switch (form) {\n"
            "            case \"string\": Serializable::deserializeTrusted(b.toString(\"ISO-8859-1\")); break;\n"
            "            case \"stream\": Serializable::deserializeTrusted(new BinaryInputStream(b)); break;\n"
            "            case \"data\": Serializable::deserializeTrusted(Serializable::serializeToData(1)); break;\n"
            "        }\n"
            "        return \"OK\";\n"
            "    } catch (hash<ExceptionInfo> ex) {\n"
            "        return ex.err;\n"
            "    }\n"
            "}\n"
            "string sub call_shared(object o) { return StCache::serializeShared(o); }\n"
            "string sub lib_class() { return StLibCache::roundTrip(); }\n"
            "string sub lib_function() { return st_lib_round_trip(); }\n"
            "string sub by_name() {\n"
            "    try {\n"
            "        call_static_method(\"Serializable\", \"serializeTrusted\", 1);\n"
            "        return \"OK\";\n"
            "    } catch (hash<ExceptionInfo> ex) {\n"
            "        return ex.err;\n"
            "    }\n"
            "}\n"
            "nothing sub in_background(Queue q) {\n"
            "    background q.push(direct(\"serializeTrusted\"));\n"
            "}\n",
            "sandboxed");

        addTestCase("trusted code that sandboxed code calls", \trustedCalleeTest());
        addTestCase("sandboxed callers", \sandboxedCallerTest());
        addTestCase("trusted code without a sandbox", \noSandboxTest());
        addTestCase("a governed sandbox", \governedTest());
        addTestCase("shared objects", \sharedObjectTest());
        addTestCase("objects of tenants", \tenantObjectTest());
        addTestCase("library module code", \libraryTest());
        addTestCase("a module that a tenant loads", \tenantModuleTest());
        addTestCase("parse define", \defineTest());
        set_return_value(main());
    }

    #! the plain forms withhold the state of the other trusted class; the trusted forms give and set it
    trustedCalleeTest() {
        assertRegex("^SERIALIZATION-ERROR", p.callFunction("call", "storePlain"));
        assertEq("OK", p.callFunction("call", "storeTrusted"));
        # the data that the trusted code wrote is set with the trusted form only
        assertRegex("^DESERIALIZATION-ERROR", p.callFunction("call", "loadPlain"));
        assertEq("ORDER-STATE", p.callFunction("call", "loadTrusted"));
        assertEq("ORDER-STATE", p.callFunction("call", "roundTripData"));
        assertEq("ORDER-STATE", p.callFunction("call", "roundTripStream"));
    }

    #! sandboxed code cannot call the trusted forms: directly, through a call reference that trusted code created, or
    #! through its own closure
    sandboxedCallerTest() {
        StCache::stored = Serializable::serialize(new StOrderData());
        foreach string api in ("serializeTrusted", "serializeTrustedToData", "deserializeTrusted") {
            assertEq("SANDBOX-ACCESS-ERROR", p.callFunction("direct", api), api);
        }
        code ser = \Serializable::serializeTrusted();
        assertEq("SANDBOX-ACCESS-ERROR", p.callFunction("invoke", ser, new StOrderData()));
        code deser = \Serializable::deserializeTrusted();
        assertEq("SANDBOX-ACCESS-ERROR", p.callFunction("invoke", deser, StCache::stored));
        code c = p.callFunction("closure");
        assertEq("SANDBOX-ACCESS-ERROR", p.callFunction("invoke", c, new StOrderData()));
        # a call reference that trusted code outside a class created
        assertEq("SANDBOX-ACCESS-ERROR", p.callFunction("invoke", st_host_ref(), new StOrderData()));
        # the other forms of deserializeTrusted()
        foreach string form in ("string", "stream", "data") {
            assertEq("SANDBOX-ACCESS-ERROR", p.callFunction("deser_form", form), form);
        }
        # a call by name, and a call in a background thread that sandboxed code starts
        assertEq("SANDBOX-ACCESS-ERROR", p.callFunction("by_name"));
        Queue q();
        p.callFunction("in_background", q);
        assertEq("SANDBOX-ACCESS-ERROR", q.get(30s));
    }

    #! a sandbox that allows uncontrolled APIs governs trusted code, which can call the trusted forms (qore#7737)
    governedTest() {
        SandboxManager gm();
        gm.setUncontrolledApiPolicy(True);
        Program g(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        g.setSandboxManager(gm);
        g.importClass("StOrderData");
        g.parse("string sub round_trip() {\n"
            "    try {\n"
            "        StOrderData o = Serializable::deserializeTrusted(Serializable::serializeTrusted(new StOrderData()));\n"
            "        return o.getSecret();\n"
            "    } catch (hash<ExceptionInfo> ex) {\n"
            "        return sprintf(\"%s: %s\", ex.err, ex.desc);\n"
            "    }\n"
            "}\n"
            "string sub other(object o) {\n"
            "    try {\n"
            "        return sprintf(\"%N\", Serializable::serializeTrustedToData(o)) =~ /ORDER-STATE/ ? \"STATE\" "
            ": \"NO-STATE\";\n"
            "    } catch (hash<ExceptionInfo> ex) {\n"
            "        return ex.err;\n"
            "    }\n"
            "}\n", "governed");
        assertEq("ORDER-STATE", g.callFunction("round_trip"));
        # an object with the provenance of another tenant: the governed tenant is subject to tenant isolation, so the
        # owner rule of the non-public members of objects is not lifted for it (it is the only rule that decides here)
        Program a = newTenant();
        StOrderData oa = a.callFunction("call", object sub () { return new StOrderData(); });
        assertRegex("^SERIALIZATION-ERROR|^NO-STATE", g.callFunction("other", oa));
    }

    #! the rule of shared objects applies to the trusted forms as to the plain forms (qore#7673)
    sharedObjectTest() {
        StOrderData o();
        SandboxManager::shareObject(o);
        # trusted code that no sandboxed code calls
        assertEq("ORDER-STATE", Serializable::deserializeTrusted(Serializable::serializeTrusted(o)).getSecret());
        # trusted code that sandboxed code calls
        assertEq("SHARED-OBJECT-ERROR", p.callFunction("call_shared", o));
    }

    #! trusted code that no sandboxed code calls gets the same result as with the plain forms
    noSandboxTest() {
        binary b = Serializable::serializeTrusted(new StOrderData());
        assertEq(b, Serializable::serialize(new StOrderData()));
        StOrderData o = Serializable::deserializeTrusted(b);
        assertEq("ORDER-STATE", o.getSecret());
        o = Serializable::deserializeTrusted(Serializable::serializeTrustedToData(new StOrderData()));
        assertEq("ORDER-STATE", o.getSecret());
        o = Serializable::deserializeTrusted(b.toString("ISO-8859-1"));
        assertEq("ORDER-STATE", o.getSecret());
    }

    #! the parse define, in a Program of its own
    defineTest() {
        Program d(PO_NEW_STYLE);
        d.parse("bool sub has() {\n%ifdef QORE_HAS_SERIALIZE_TRUSTED\nreturn True;\n%else\nreturn False;\n%endif\n}\n",
            "define");
        assertEq(True, d.callFunction("has"));
    }

    #! the trusted forms give the non-public members of an object with the provenance of a tenant, also to trusted code
    #! that serves another tenant; the plain forms and formatting withhold them there (see sandbox_object_ownership)
    tenantObjectTest() {
        # tenant A: trusted code creates an object while the tenant calls it
        Program a = newTenant();
        StOrderData oa = a.callFunction("call", object sub () { return new StOrderData(); });
        # an object that tenant A's own code created
        object own = a.callFunction("make");
        # tenant B: trusted code that serves it
        Program b = newTenant();
        b.parse("string sub trusted_obj(object o) { return StCache::serTrustedObj(o); }\n"
            "string sub plain_obj(object o) { return StCache::serPlainObj(o); }\n"
            "string sub format_obj(object o) { return StCache::formatObj(o); }\n"
            "string sub program_obj(Program pg, object o) { return StCache::serProgramObj(pg, o); }\n", "b");

        # trusted code that no sandboxed code calls
        assertEq("STATE", StCache::serTrustedObj(oa));
        assertRegex("ORDER-STATE", sprintf("%N", a.serializeToData(oa)));
        # trusted code that serves tenant A, and trusted code that serves tenant B
        assertEq("STATE", a.callFunction("call", string sub () { return StCache::serTrustedObj(oa); }));
        assertEq("STATE", b.callFunction("trusted_obj", oa));
        # Program::serializeToData() in trusted code that serves tenant B, with tenant A's object
        assertEq("STATE", b.callFunction("program_obj", a, oa));
        # the object that tenant A's own code created
        assertEq("STATE", StCache::serTrustedObj(own));
        assertEq("STATE", b.callFunction("trusted_obj", own));
        # the plain form and formatting while serving tenant B withhold it
        assertRegex("^SERIALIZATION-ERROR|^NO-STATE", b.callFunction("plain_obj", oa));
        assertEq("NO-STATE", b.callFunction("format_obj", oa));
        # a deserialized copy, which keeps no provenance, is an ordinary object of trusted code: the plain form in
        # trusted code that serves tenant B withholds its non-public state by the rule of the classes declared by
        # trusted code (see sandbox_serialization)
        StOrderData copy = Serializable::deserializeTrusted(Serializable::serializeTrusted(oa));
        assertEq("ORDER-STATE", copy.getSecret());
        assertRegex("^SERIALIZATION-ERROR|^NO-STATE", b.callFunction("plain_obj", copy));
    }

    #! the code of a library module's class acts for itself; its code outside a class acts for its caller
    libraryTest() {
        assertEq("LIB-STATE", p.callFunction("lib_class"));
        assertEq("SANDBOX-ACCESS-ERROR", p.callFunction("lib_function"));
        # without a sandboxed caller
        assertEq("LIB-STATE", st_lib_round_trip());
    }

    #! a module that a tenant loads from a path that it chose: trusted code that loads it by name later never gets the
    #! state of the trusted forms through its code
    tenantModuleTest() {
        Program t = newTenant();
        string path = get_script_dir() + "/SandboxSerializationTrustedLib2.qm";
        try {
            t.loadModule(path);
        } catch (hash<ExceptionInfo> ex) {
            # the tenant cannot load it: the refusal of the sandbox is all there is to check
            assertRegex("SANDBOX|ACCESS", ex.err, ex.desc);
            return;
        }
        string result;
        try {
            load_module("SandboxSerializationTrustedLib2");
            result = call_static_method("StLib2Cache", "roundTrip");
        } catch (hash<ExceptionInfo> ex) {
            result = ex.err;
        }
        assertNeq("LIB2-STATE", result);
    }

    #! returns a new sandboxed Program of a tenant with the trusted classes and a function that calls a closure
    private Program newTenant() {
        Program t(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        t.setSandboxManager(new SandboxManager());
        t.importClass("StOrderData");
        t.importClass("StCache");
        t.parse("auto sub call(code c) { return c(); }\n"
            "object sub make() { return new StOrderData(); }\n", "tenant");
        return t;
    }
}
