#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.
#
# the exceptions raised for a datasource string, a datasource hash or the connection values of a datasource show none
# of its user name, password and database name: a parse error shows only the driver name of the string, a string that
# is not a valid driver name is never looked up or loaded as a module, and the errors of an open datasource show its
# driver, host and port with the user name, the password and the database name masked (qore#6961)

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class DatasourceSecretMaskingTest

class DatasourceSecretMaskingTest inherits QUnit::Test {
    public {
        const User = "u_SECRET1";
        const Pass = "p_SECRET2";
        const Db = "d_SECRET3";
        const Secrets = (User, Pass, Db);

        #! the credentials of a datasource string
        const Creds = User + "/" + Pass + "@" + Db;

        #! the mock driver, which needs no server
        const Driver = "dbitest";
        const Host = "h-host";
        const Port = 4321;

        #! a datasource string with the mock driver, a host and a port
        const ConnStr = sprintf("%s:%s%%%s:%d", Driver, Creds, Host, Port);

        #! the masked description of ConnStr in the messages of an open datasource
        const Masked = sprintf("%s:****/****@****%%%s:%d", Driver, Host, Port);

        #! datasource strings that cannot be parsed, the start of the description of the error, and whether the
        #! driver name is shown
        const ParseErrors = (
            ("pgsql:" + User + "/" + Pass, "missing database name delimited by '@'", True),
            (User + "/" + Pass + "x" + Db, "missing database name delimited by '@'", False),
            ("pgsql:" + Creds + "(utf8", "missing closing parenthesis in charset specification", True),
            ("pgsql:" + Creds + "%", "missing hostname string after '%' delimeter", True),
            ("pgsql:" + Creds + "%host:12x", "invalid characters present in port number", True),
            ("pgsql:" + Creds + "{=x}", "missing value after '=' in option specification", True),
            ("pgsql:" + Creds + "{a=1,a=2}", "option 'a' repeated", True),
        );

        #! a string that is not a driver name: it would be looked up as a driver and loaded as a module path
        const BadDriver = "nosuchdrv:" + Creds;
    }

    constructor() : Test("DatasourceSecretMaskingTest", "1.0") {
        addTestCase("parse_datasource()", \parseDatasource());
        addTestCase("Datasource string constructors", \datasourceString());
        addTestCase("DatasourcePool string constructors", \poolString());
        addTestCase("a datasource string as a driver name", \stringAsDriver());
        addTestCase("datasource hashes", \datasourceHash());
        addTestCase("connection values with a NUL character", \nulValues());
        addTestCase("setters", \setters());
        addTestCase("deserialization", \deserialization());
        addTestCase("DBI driver lookups", \driverLookups());
        addTestCase("errors of a Datasource", \datasourceErrors());
        addTestCase("errors of a DatasourcePool", \poolErrors());
        set_return_value(main());
    }

    parseDatasource() {
        foreach list<auto> l in (ParseErrors) {
            hash<ExceptionInfo> ex = catchEx(hash<auto> sub () { return parse_datasource(l[0]); },
                "parse_datasource()");
            checkParseError(ex, l, "parse_datasource()");
            # the deprecated function is the same
            ex = catchEx(sub () { call_function("parseDatasource", l[0]); }, "parseDatasource()");
            checkParseError(ex, l, "parseDatasource()");
        }
    }

    datasourceString() {
        foreach list<auto> l in (ParseErrors) {
            # the constructor requires a driver name in the string
            if (!l[2]) {
                continue;
            }
            hash<ExceptionInfo> ex = catchEx(sub () { Datasource ds(l[0]); }, "Datasource(string)");
            if (l[0] =~ /@/) {
                checkParseError(ex, l, "Datasource(string)");
            } else {
                # the constructor checks first that the driver name is followed by a database name
                checkNoSecrets(ex, "Datasource(string)");
                assertEq("DATASOURCE-PARSE-ERROR", ex.err);
                assertRegex("driver is missing", ex.desc);
            }
            # the driver argument of the constructor can be a datasource string
            ex = catchEx(sub () { Datasource ds(l[0], NOTHING, NOTHING, NOTHING); }, "Datasource(driver)");
            if (l[0] =~ /@/) {
                checkParseError(ex, l, "Datasource(driver)");
            } else {
                checkInvalidDriver(ex, "DATASOURCE-UNSUPPORTED-DATABASE", "Datasource(driver)");
            }
        }
        # a string with no driver name
        hash<ExceptionInfo> ex = catchEx(sub () { Datasource ds(Creds); }, "Datasource(string) with no driver");
        checkNoSecrets(ex, "Datasource(string) with no driver");
        assertEq("DATASOURCE-PARSE-ERROR", ex.err);
        assertRegex("driver is missing", ex.desc);
    }

    poolString() {
        foreach list<auto> l in (ParseErrors) {
            hash<ExceptionInfo> ex = catchEx(sub () { DatasourcePool p(l[0]); }, "DatasourcePool(string)");
            checkParseError(ex, l, "DatasourcePool(string)");
            if (!l[2]) {
                continue;
            }
            # the driver argument of the constructor can be a datasource string with the default arguments
            ex = catchEx(sub () { DatasourcePool p(l[0], NOTHING, NOTHING, NOTHING); }, "DatasourcePool(driver)");
            checkParseError(ex, l, "DatasourcePool(driver)");
        }
    }

    stringAsDriver() {
        # with a port, the driver argument of the Datasource constructor is not a datasource string; before, it was
        # tried as a module path, and the error of the module load showed it
        hash<ExceptionInfo> ex = catchEx(sub () {
            Datasource ds(BadDriver, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, 5432);
        }, "Datasource() with a port");
        checkInvalidDriver(ex, "DATASOURCE-UNSUPPORTED-DATABASE", "Datasource() with a port");

        # with other connection values and no port, it is a datasource string, whose driver cannot be loaded
        ex = catchEx(sub () { Datasource ds(BadDriver, "user", "pass", "db"); }, "Datasource() with values");
        checkNoSecrets(ex, "Datasource() with values");
        assertRegex("nosuchdrv", getText(ex));

        # with a minimum and maximum that are not the default, the driver argument of the DatasourcePool constructor
        # is not a datasource string
        ex = catchEx(sub () {
            DatasourcePool p(BadDriver, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, 1, 2);
        }, "DatasourcePool() with min and max");
        checkInvalidDriver(ex, "DATASOURCEPOOL-UNSUPPORTED-DATABASE", "DatasourcePool() with min and max");
        ex = catchEx(sub () {
            DatasourcePool p(BadDriver, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, 3, 10, 5432);
        }, "DatasourcePool() with a port");
        checkInvalidDriver(ex, "DATASOURCEPOOL-UNSUPPORTED-DATABASE", "DatasourcePool() with a port");

        # without a port, a driver argument with no '@' is not a datasource string either
        ex = catchEx(sub () {
            Datasource ds("nosuchdrv:" + User + "/" + Pass, NOTHING, NOTHING, NOTHING);
        }, "Datasource() with no '@'");
        checkInvalidDriver(ex, "DATASOURCE-UNSUPPORTED-DATABASE", "Datasource() with no '@'");

        # a valid driver name that cannot be loaded is shown
        ex = catchEx(sub () {
            Datasource ds("nosuchdrv", User, Pass, Db, NOTHING, NOTHING, 5432);
        }, "Datasource() with a driver that cannot be loaded");
        checkNoSecrets(ex, "Datasource() with a driver that cannot be loaded");
        assertRegex("nosuchdrv", getText(ex));
        ex = catchEx(sub () {
            DatasourcePool p("nosuchdrv", User, Pass, Db, NOTHING, NOTHING, 1, 2);
        }, "DatasourcePool() with a driver that cannot be loaded");
        checkNoSecrets(ex, "DatasourcePool() with a driver that cannot be loaded");
        assertEq("DATASOURCEPOOL-UNSUPPORTED-DATABASE", ex.err);
        assertRegex("nosuchdrv", ex.desc);
    }

    datasourceHash() {
        hash<auto> conf = {"type": BadDriver, "user": User, "pass": Pass, "db": Db};
        hash<ExceptionInfo> ex = catchEx(sub () { Datasource ds(conf); }, "Datasource(hash)");
        checkInvalidDriver(ex, "DATASOURCE-UNSUPPORTED-DATABASE", "Datasource(hash)");
        ex = catchEx(sub () { DatasourcePool p(conf); }, "DatasourcePool(hash)");
        checkInvalidDriver(ex, "DATASOURCEPOOL-UNSUPPORTED-DATABASE", "DatasourcePool(hash)");

        # a valid driver name that cannot be loaded is shown, the other values are not
        conf.type = "nosuchdrv";
        ex = catchEx(sub () { Datasource ds(conf); }, "Datasource(hash) with a driver that cannot be loaded");
        checkNoSecrets(ex, "Datasource(hash) with a driver that cannot be loaded");
        assertRegex("nosuchdrv", getText(ex));
        ex = catchEx(sub () { DatasourcePool p(conf); }, "DatasourcePool(hash) with a driver that cannot be loaded");
        checkNoSecrets(ex, "DatasourcePool(hash) with a driver that cannot be loaded");
        assertEq("DATASOURCEPOOL-UNSUPPORTED-DATABASE", ex.err);
        assertRegex("nosuchdrv", ex.desc);
    }

    nulValues() {
        # the value cut at the NUL character would be another one; the values are not shown
        foreach string key in ("user", "pass", "db") {
            hash<auto> conf = {"type": Driver, "user": User, "pass": Pass, "db": Db};
            conf{key} += "\x00x";
            string label = sprintf("Datasource(hash) with a NUL character in %y", key);
            hash<ExceptionInfo> ex = catchEx(sub () { Datasource ds(conf); }, label);
            checkNoSecrets(ex, label);
            assertEq("DATASOURCE-CONSTRUCTOR-ERROR", ex.err, label);
            assertEq(sprintf("'%s' value contains a NUL character; datasource values cannot contain NUL characters",
                key), ex.desc, label);

            label = sprintf("DatasourcePool(hash) with a NUL character in %y", key);
            ex = catchEx(sub () { DatasourcePool p(conf); }, label);
            checkNoSecrets(ex, label);
            assertEq("DATASOURCEPOOL-CONSTRUCTOR-ERROR", ex.err, label);
            assertEq(sprintf("'%s' value contains a NUL character; datasource values cannot contain NUL characters",
                key), ex.desc, label);
        }
        {
            hash<auto> conf = {"type": Driver + ":" + Creds + "\x00x"};
            hash<ExceptionInfo> ex = catchEx(sub () { Datasource ds(conf); }, "Datasource(hash) with a NUL type");
            checkNoSecrets(ex, "Datasource(hash) with a NUL type");
            assertEq("'type' value contains a NUL character; datasource values cannot contain NUL characters",
                ex.desc);
        }

        # the positional values
        list<auto> args = (Driver, User, Pass, Db);
        foreach list<auto> l in ((1, "user name"), (2, "password"), (3, "database name")) {
            list<auto> a = args;
            a[l[0]] += "\x00x";
            string label = sprintf("Datasource() with a NUL character in the %s", l[1]);
            hash<ExceptionInfo> ex = catchEx(sub () { Datasource ds(a[0], a[1], a[2], a[3]); }, label);
            checkNoSecrets(ex, label);
            assertEq("DATASOURCE-CONSTRUCTOR-ERROR", ex.err, label);
            assertEq(sprintf("%s contains a NUL character; datasource values cannot contain NUL characters", l[1]),
                ex.desc, label);

            label = sprintf("DatasourcePool() with a NUL character in the %s", l[1]);
            ex = catchEx(sub () { DatasourcePool p(a[0], a[1], a[2], a[3], NOTHING, NOTHING, 1, 1); }, label);
            checkNoSecrets(ex, label);
            assertEq("DATASOURCEPOOL-CONSTRUCTOR-ERROR", ex.err, label);
            assertEq(sprintf("%s contains a NUL character; datasource values cannot contain NUL characters", l[1]),
                ex.desc, label);
        }
    }

    setters() {
        Datasource ds(Driver, NOTHING, NOTHING, "db");
        foreach list<auto> l in ((\ds.setUserName(), User, "user name"), (\ds.setPassword(), Pass, "password"),
                (\ds.setDBName(), Db, "database name")) {
            string label = sprintf("the setter of the %s", l[2]);
            hash<ExceptionInfo> ex = catchEx(sub () { l[0](l[1] + "\x00x"); }, label);
            checkNoSecrets(ex, label);
            assertEq("DATASOURCE-ERROR", ex.err, label);
            assertEq(sprintf("%s contains a NUL character; datasource values cannot contain NUL characters", l[2]),
                ex.desc, label);
        }
    }

    deserialization() {
        Datasource ds(ConnStr);
        DatasourcePool pool(Driver + ":" + Creds + "{min=1,max=1}");
        on_exit delete pool;

        foreach list<auto> l in ((ds, "Qore::SQL::Datasource", "DATASOURCE-UNSUPPORTED-DATABASE"),
                (pool, "Qore::SQL::DatasourcePool", "DATASOURCEPOOL-UNSUPPORTED-DATABASE")) {
            # a configuration hash whose driver is a datasource string
            hash<SerializationInfo> data = l[0].serializeToData();
            data._index."0"._class_data{l[1]}.conf.type = BadDriver;
            string label = sprintf("%s deserialization with an invalid driver", l[1]);
            hash<ExceptionInfo> ex = catchEx(auto sub () { return Serializable::deserialize(data); }, label);
            checkInvalidDriver(ex, l[2], label);

            # a legacy configuration string that cannot be parsed
            data = l[0].serializeToData();
            data._index."0"._class_data{l[1]}.conf = ParseErrors[2][0];
            label = sprintf("%s deserialization with a datasource string that cannot be parsed", l[1]);
            ex = catchEx(auto sub () { return Serializable::deserialize(data); }, label);
            checkParseError(ex, ParseErrors[2], label);
        }
    }

    driverLookups() {
        # the path of a module is not loaded as a driver module: before, a driver name with a '/' was loaded as a
        # module path
        string path = get_script_dir() + "../../../../../qlib/TextWrap.qm";
        assertTrue(is_file(path), path);
        assertNothing(get_module_hash().TextWrap, "the module is not loaded before the lookups");
        assertEq(0, dbi_get_driver_capabilities(path));
        assertNothing(dbi_get_driver_capability_list(path));
        assertNothing(dbi_get_driver_options(path));
        assertThrows("DATASOURCE-UNSUPPORTED-DATABASE", "^the DBI driver name is not valid",
            sub () { Datasource ds(path, NOTHING, NOTHING, "db", NOTHING, NOTHING, 1); });
        assertThrows("DATASOURCEPOOL-UNSUPPORTED-DATABASE", "^the DBI driver name is not valid",
            sub () { DatasourcePool p(path, NOTHING, NOTHING, "db", NOTHING, NOTHING, 1, 1); });
        assertNothing(get_module_hash().TextWrap, "the module path was not loaded");

        # a string that is not a driver name is not found, and not loaded as a module
        assertEq(0, dbi_get_driver_capabilities(BadDriver));
        assertNothing(dbi_get_driver_capability_list(BadDriver));
        assertNothing(dbi_get_driver_options(BadDriver));
        assertNothing(call_function("getDBIDriverCapabilities", BadDriver));
        assertNothing(call_function("getDBIDriverCapabilityList", BadDriver));
        # a driver name is found
        Datasource ds(ConnStr);
        assertGt(0, dbi_get_driver_capabilities(Driver));
    }

    datasourceErrors() {
        # autocommit
        {
            Datasource ds(ConnStr);
            ds.open();
            on_exit ds.close();
            ds.setAutoCommit(True);
            hash<ExceptionInfo> ex = catchEx(\ds.beginTransaction(), "AUTOCOMMIT-ERROR");
            checkMasked(ex, "AUTOCOMMIT-ERROR", "AUTOCOMMIT-ERROR");
        }

        # a thread resource of a transaction in progress
        {
            Datasource ds(ConnStr);
            ds.setAutoCommit(False);
            ds.open();
            on_exit ds.close();
            ds.beginTransaction();
            hash<ExceptionInfo> ex = catchEx(\throw_thread_resource_exceptions(), "thread resource");
            checkMasked(ex, "DATASOURCE-TRANSACTION-EXCEPTION", "thread resource");
            assertRegex("terminated while in a transaction", ex.desc);
        }

        # a datasource closed while in a transaction
        {
            Datasource ds(ConnStr);
            ds.setAutoCommit(False);
            ds.open();
            ds.beginTransaction();
            hash<ExceptionInfo> ex = catchEx(\ds.close(), "close");
            checkMasked(ex, "DATASOURCE-TRANSACTION-EXCEPTION", "close");
            assertRegex("closed while in a transaction", ex.desc);
        }

        # a datasource deleted while another thread holds its transaction lock: the other thread holds it until
        # this thread has deleted the datasource
        {
            Datasource ds(ConnStr);
            ds.setAutoCommit(False);
            ds.open();
            Queue progress();
            Counter release(1);
            *string resource_err;
            background sub () {
                on_exit progress.push("done");
                try {
                    ds.beginTransaction();
                    progress.push("held");
                } catch (hash<ExceptionInfo> ex) {
                    progress.push(sprintf("%s: %s", ex.err, ex.desc));
                    return;
                }
                release.waitForZero();
                # the transaction of the deleted datasource is rolled back with the resources of this thread
                try {
                    throw_thread_resource_exceptions();
                } catch (hash<ExceptionInfo> ex) {
                    resource_err = getText(ex);
                }
            }();
            string first = progress.get();
            hash<ExceptionInfo> ex;
            if (first == "held") {
                ex = catchEx(sub () { delete ds; }, "delete in another thread");
            }
            release.dec();
            assertEq("held", first);
            assertEq("done", progress.get());
            if (ex) {
                checkMasked(ex, "DATASOURCE-ERROR", "delete in another thread");
                assertRegex("deleted Datasource while TID [0-9]+ is holding the transaction lock", ex.desc);
            }
            foreach string secret in (Secrets) {
                assertEq(-1, (resource_err ?? "").find(secret), "the resource exception of the other thread");
            }
        }

        # a transaction lock timeout: this thread holds the lock until the other thread has timed out
        {
            Datasource ds(ConnStr);
            ds.setAutoCommit(False);
            ds.setTransactionLockTimeout(1);
            ds.open();
            on_exit ds.close();
            ds.beginTransaction();
            on_exit ds.rollback();
            Queue result();
            background sub () {
                try {
                    ds.exec("select 1");
                    ds.rollback();
                    result.push("no exception");
                } catch (hash<ExceptionInfo> ex) {
                    result.push(ex);
                }
            }();
            auto r = result.get();
            if (r.typeCode() != NT_HASH) {
                fail(sprintf("the other thread did not time out on the transaction lock: %y", r));
            } else {
                checkMasked(r, "TRANSACTION-LOCK-TIMEOUT", "lock timeout");
                assertRegex("timed out", r.desc);
            }
        }
    }

    poolErrors() {
        string str = ConnStr + "{min=1,max=1}";

        # a thread resource of a transaction in progress
        {
            DatasourcePool p(str);
            on_exit delete p;
            p.beginTransaction();
            hash<ExceptionInfo> ex = catchEx(\throw_thread_resource_exceptions(), "pool thread resource");
            checkMasked(ex, "DATASOURCEPOOL-LOCK-EXCEPTION", "pool thread resource");
            assertRegex("terminated while in a transaction", ex.desc);
        }

        # a pool deleted while in a transaction
        {
            DatasourcePool p(str);
            p.beginTransaction();
            hash<ExceptionInfo> ex = catchEx(sub () { delete p; }, "pool delete");
            checkMasked(ex, "DATASOURCEPOOL-LOCK-EXCEPTION", "pool delete");
            assertRegex("deleted DatasourcePool while in a transaction", ex.desc);
        }

        # a pool deleted while another thread uses a connection in a transaction: the other thread holds it until
        # this thread has deleted the pool
        {
            DatasourcePool p(str);
            Queue progress();
            Counter release(1);
            *string resource_err;
            background sub () {
                on_exit progress.push("done");
                try {
                    p.beginTransaction();
                    progress.push("held");
                } catch (hash<ExceptionInfo> ex) {
                    progress.push(sprintf("%s: %s", ex.err, ex.desc));
                    return;
                }
                release.waitForZero();
                # the transaction of the deleted pool is rolled back with the resources of this thread
                try {
                    throw_thread_resource_exceptions();
                } catch (hash<ExceptionInfo> ex) {
                    resource_err = getText(ex);
                }
            }();
            string first = progress.get();
            hash<ExceptionInfo> ex;
            if (first == "held") {
                ex = catchEx(sub () { delete p; }, "pool delete in another thread");
            }
            release.dec();
            assertEq("held", first);
            assertEq("done", progress.get());
            if (ex) {
                checkMasked(ex, "DATASOURCEPOOL-ERROR", "pool delete in another thread");
                assertRegex("deleted DatasourcePool while TID [0-9]+ using connection", ex.desc);
            }
            assertTrue(exists resource_err, "the other thread's transaction is rolled back with a notice");
            foreach string secret in (Secrets) {
                assertEq(-1, (resource_err ?? "").find(secret), "the resource exception of the other thread");
            }
            assertTrue((resource_err ?? "").find(Masked + ": ") >= 0, resource_err ?? "");
        }

        # a timeout waiting for a connection: this thread holds the only connection until the other thread has timed
        # out
        {
            DatasourcePool p(str);
            on_exit delete p;
            p.setErrorTimeout(1);
            p.beginTransaction();
            on_exit p.rollback();
            Queue result();
            background sub () {
                try {
                    p.beginTransaction();
                    p.rollback();
                    result.push("no exception");
                } catch (hash<ExceptionInfo> ex) {
                    result.push(ex);
                }
            }();
            auto r = result.get();
            if (r.typeCode() != NT_HASH) {
                fail(sprintf("the other thread did not time out waiting for a connection: %y", r));
            } else {
                checkMasked(r, "DATASOURCEPOOL-TIMEOUT", "pool timeout");
                assertRegex("timed out", r.desc);
            }
        }
    }

    #! returns the exception raised by the code, or fails the test case
    private hash<ExceptionInfo> catchEx(code c, string label) {
        try {
            c();
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        fail(sprintf("%s: no exception was raised", label));
        # not reached
        return <ExceptionInfo>{};
    }

    #! returns the text of an exception and the exceptions chained to it: their error codes, descriptions and
    #! arguments
    private static string getText(*hash<ExceptionInfo> ex) {
        string text;
        while (ex) {
            text += sprintf("%s: %s: %y\n", ex.err, ex.desc, ex.arg);
            ex = ex.next;
        }
        return text;
    }

    #! checks that an exception and the exceptions chained to it show none of the user name, password and database
    #! name
    private checkNoSecrets(hash<ExceptionInfo> ex, string label) {
        string text = getText(ex);
        foreach string secret in (Secrets) {
            assertEq(-1, text.find(secret), sprintf("%s: the exception shows %y: %s", label, secret, text));
        }
    }

    #! checks the exception of a datasource string that cannot be parsed
    private checkParseError(hash<ExceptionInfo> ex, list<auto> l, string label) {
        checkNoSecrets(ex, label);
        assertEq("DATASOURCE-PARSE-ERROR", ex.err, label);
        # the description names the problem, and the driver name if the string starts with one
        if (l[1]) {
            assertTrue(ex.desc.find(l[1]) == 0, sprintf("%s: %y does not start with %y", label, ex.desc, l[1]));
        }
        if (l[2]) {
            string driver = (l[0] =~ x/^([^:]+):/)[0];
            assertRegex("in datasource string '" + driver + ":\\*\\*\\*\\*'$", ex.desc, label);
        } else {
            assertRegex("in datasource string '\\*\\*\\*\\*'$", ex.desc, label);
        }
    }

    #! checks the exception of a string that is not a driver name
    private checkInvalidDriver(hash<ExceptionInfo> ex, string err, string label) {
        checkNoSecrets(ex, label);
        assertEq(err, ex.err, sprintf("%s: %s", label, getText(ex)));
        assertRegex("^the DBI driver name is not valid", ex.desc, label);
        # it was not looked up, so no module was loaded
        assertNothing(ex.next, label);
    }

    #! checks the exception of a datasource, which shows the driver, the host and the port, and masks the user name,
    #! the password and the database name
    private checkMasked(hash<ExceptionInfo> ex, string err, string label) {
        checkNoSecrets(ex, label);
        assertEq(err, ex.err, sprintf("%s: %s", label, getText(ex)));
        assertTrue(ex.desc.find(Masked + ": ") == 0, sprintf("%s: %y does not start with %y", label, ex.desc,
            Masked + ": "));
    }
}
