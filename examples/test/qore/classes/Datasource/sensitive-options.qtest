#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires dbitest
%exec-class DatasourceSensitiveOptionsTest

#! DBI driver option information declares which options are sensitive (qore#7070)
/** The "dbitest" mock driver declares its "secret" option sensitive with QDBI_OPT_SENSITIVE; its other options are not
    sensitive.
*/
class DatasourceSensitiveOptionsTest inherits QUnit::Test {
    constructor() : Test("DBI sensitive driver options", "1.0", \ARGV) {
        addTestCase("the parse define", \parseDefine());
        addTestCase("the driver option information", \driverOptions());
        addTestCase("the option information of a Datasource", \datasourceOptions());
        addTestCase("the option information of a DatasourcePool", \poolOptions());
        addTestCase("mask_datasource_options()", \maskOptions());
        set_return_value(main());
    }

    parseDefine() {
%ifdef QoreHasDbiSensitiveOptions
        assertTrue(True);
%else
        fail("QoreHasDbiSensitiveOptions is not defined");
%endif
    }

    driverOptions() {
        hash<auto> h = dbi_get_driver_options("dbitest");
        assertTrue(h.secret.sensitive, "the secret option is sensitive");
        foreach hash<auto> i in (h.pairIterator()) {
            assertEq(Type::Boolean, i.value.sensitive.type(), i.key + ": the key is a bool");
            if (i.key != "secret") {
                assertFalse(i.value.sensitive, i.key + ": not sensitive");
            }
        }
    }

    datasourceOptions() {
        Datasource ds({"type": "dbitest", "db": "test", "options": {"secret": "s3cr3t", "rows": 3}});
        ds.open();
        on_exit ds.close();
        hash<auto> h = ds.getOptionHash();
        assertTrue(h.secret.sensitive);
        assertFalse(h.rows.sensitive);
        # the option information gives the value to the code that owns the datasource
        assertEq("s3cr3t", h.secret.value);
        assertEq(3, h.rows.value);
    }

    poolOptions() {
        DatasourcePool pool({"type": "dbitest", "db": "test", "options": {"secret": "s3cr3t", "min": 1, "max": 2}});
        hash<auto> h = pool.getOptionHash();
        assertTrue(h.secret.sensitive);
        assertFalse(h.rows.sensitive);
    }

    maskOptions() {
        # a sensitive option and an option that the driver does not declare are masked
        assertEq({"secret": "****", "rows": 3, "fault": "", "unknown": "****"},
            mask_datasource_options("dbitest", {"secret": "s3cr3t", "rows": 3, "fault": "", "unknown": "x"}));
        # option names are matched as the driver matches them, without case
        assertEq({"SECRET": "****", "Rows": 3}, mask_datasource_options("dbitest", {"SECRET": "s3cr3t", "Rows": 3}));
        # a driver that is not loaded is not loaded by the function: every value is masked
        assertEq({"rows": "****"}, mask_datasource_options("qore-7070-no-such-driver", {"rows": 3}));
        assertFalse(inlist("qore-7070-no-such-driver", dbi_get_driver_list() ?? ()));
        # a driver module that is installed but not loaded is not loaded either
        if (!inlist("sqlite3", dbi_get_driver_list() ?? ())) {
            assertEq({"timeout": "****"}, mask_datasource_options("sqlite3", {"timeout": 1}));
            assertFalse(inlist("sqlite3", dbi_get_driver_list() ?? ()));
        }
        # neither is a value given with a name that is not a driver name, or a name with a NUL character
        assertEq({"rows": "****"}, mask_datasource_options("dbitest:u/p@db", {"rows": 3}));
        assertEq({"rows": "****"}, mask_datasource_options("dbitest\0x", {"rows": 3}));
        assertEq({}, mask_datasource_options("dbitest", NOTHING));
        assertEq({}, mask_datasource_options("dbitest", {}));
    }
}
