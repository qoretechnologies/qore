#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires dbitest
%exec-class DatasourceSensitiveDbNameTest

#! A DBI driver declares that its database name can hold credentials (qore#7275)
/** The "dbitestsensitivedb" mock driver declares DBI_CAP_SENSITIVE_DBNAME; the "dbitest" mock driver does not.
*/
class DatasourceSensitiveDbNameTest inherits QUnit::Test {
    public {
        const Db = "jdbc:x://h/d?user=u&password=s3cr3t-7275";
    }

    constructor() : Test("DBI sensitive database names", "1.0", \ARGV) {
        addTestCase("the parse define", \parseDefine());
        addTestCase("the driver capabilities", \driverCapabilities());
        addTestCase("the capabilities of a Datasource and a DatasourcePool", \datasourceCapabilities());
        addTestCase("mask_datasource_dbname()", \maskDbName());
        set_return_value(main());
    }

    parseDefine() {
%ifdef QORE_HAVE_DBI_SENSITIVE_DBNAME
        assertTrue(True);
%else
        fail("QORE_HAVE_DBI_SENSITIVE_DBNAME is not defined");
%endif
    }

    driverCapabilities() {
        assertTrue(inlist("SensitiveDbName", dbi_get_driver_capability_list("dbitestsensitivedb")));
        assertFalse(inlist("SensitiveDbName", dbi_get_driver_capability_list("dbitest")));
%ifdef QORE_HAVE_DBI_SENSITIVE_DBNAME
        assertEq(DBI_CAP_SENSITIVE_DBNAME,
            dbi_get_driver_capabilities("dbitestsensitivedb") & DBI_CAP_SENSITIVE_DBNAME);
        assertEq(0, dbi_get_driver_capabilities("dbitest") & DBI_CAP_SENSITIVE_DBNAME);
%endif
    }

    datasourceCapabilities() {
        Datasource ds({"type": "dbitestsensitivedb", "db": Db});
        assertTrue(inlist("SensitiveDbName", ds.getCapabilityList()));
        DatasourcePool pool({"type": "dbitestsensitivedb", "db": Db, "options": {"min": 1, "max": 1}});
        assertTrue(inlist("SensitiveDbName", pool.getCapabilityList()));
        Datasource ds2({"type": "dbitest", "db": "test"});
        assertFalse(inlist("SensitiveDbName", ds2.getCapabilityList()));
    }

    maskDbName() {
%ifdef QORE_HAVE_DBI_SENSITIVE_DBNAME
        # the database name of a driver that declares the capability is masked
        assertEq("****", mask_datasource_dbname("dbitestsensitivedb", Db));
        # the database name of a driver that does not declare it is shown
        assertEq(Db, mask_datasource_dbname("dbitest", Db));
        assertEq("test", mask_datasource_dbname("dbitest", "test"));
        # driver names are matched without case, as the DBI layer matches them
        assertEq("****", mask_datasource_dbname("DBITESTSENSITIVEDB", Db));
        # a driver that is not loaded is not loaded by the function: the database name is masked (fail-closed)
        assertEq("****", mask_datasource_dbname("qore-7275-no-such-driver", "test"));
        assertFalse(inlist("qore-7275-no-such-driver", dbi_get_driver_list() ?? ()));
        # a driver module that is installed but not loaded is not loaded either
        if (!inlist("sqlite3", dbi_get_driver_list() ?? ())) {
            assertEq("****", mask_datasource_dbname("sqlite3", "/tmp/x.db"));
            assertFalse(inlist("sqlite3", dbi_get_driver_list() ?? ()));
        }
        # neither is a name that is not a driver name, or a name with a NUL character
        assertEq("****", mask_datasource_dbname("dbitest:u/p@db", "test"));
        assertEq("****", mask_datasource_dbname("dbitest\0x", "test"));
        # no database name, or an empty one, has nothing to mask
        assertEq(NOTHING, mask_datasource_dbname("dbitestsensitivedb", NOTHING));
        assertEq(NOTHING, mask_datasource_dbname("qore-7275-no-such-driver"));
        assertEq("", mask_datasource_dbname("dbitestsensitivedb", ""));
%else
        fail("QORE_HAVE_DBI_SENSITIVE_DBNAME is not defined");
%endif
    }
}
