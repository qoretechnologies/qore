#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class GenericStaticCallListTest

#! Tests static calls of generic class instantiations separated by commas (qore#6037)
/** Two such calls in a list or an argument list were parsed as one expression, with no error, as the type arguments
    of the first call ran on to the second one.  The checks are in generic-static-call-list-worker.qr, which is run in
    each execution mode and as a program compiled with qcc; every run must give the results below.  Type arguments
    that are not closed before the method name are still refused with a parse error.
*/
class GenericStaticCallListTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "plain-pair": "[1, \"x\"]",
            "same-instantiation": "[1, \"x\"]",
            "other-instantiations": "[1, \"x\"]",
            "three": "[1, 2, \"z\"]",
            "argument-list": "\"1 \\\"x\\\"\"",
            "generic-then-plain": "[1, \"x\"]",
            "nested-type-args": "[1, 2]",
            "callable-type-arg": "[1, 2]",
            "method-type-args": "[\"id:\\\"a\\\"\", \"id:1\"]",
            "method-type-args-then-call": "[\"typed:\\\"s\\\"\", 3]",
            "root-qualified": "[1, \"y\"]",
            "or-nothing-type-arg": "[null, 5]",
            "nested-call": "[\"in\", 7]",
            "operator": "3",
        };

        #! malformed calls that must be refused, with the start of the error
        const Refused = {
            "unclosed type argument in a list": "(Holder<list<int>::echo(1), Holder<int>::echo(2))",
            "unclosed type argument": "Holder<list<int>::echo(1)",
            "extra closing bracket": "(Holder<int>>::echo(1), 2)",
        };

        #! the execution modes that the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("GenericStaticCallListTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled program", \testCompiledProgram());
        addTestCase("malformed calls are refused", \testRefused());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    testCompiledProgram() {
        TmpDir tmp("qore-generic-static-call-list-");
        string exe = tmp.path + DirSep + "generic-static-call-list";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1", libqore_dir,
            qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
    }

    testRefused() {
        TmpDir tmp("qore-generic-static-call-refused-");
        foreach hash<auto> i in (Refused.pairIterator()) {
            string path = tmp.path + DirSep + "refused.q";
            File f();
            f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
            f.printf("%%modern\nclass Holder<T> {\n    static auto echo(auto v) {\n        return v;\n    }\n}\n"
                "printf(\"%%y\\n\", %s);\n", i.value);
            f.close();
            string out = backquote(sprintf("LD_LIBRARY_PATH=%s %s -b %s 2>&1", libqore_dir, qore_bin, path));
            assertRegex("PARSE-EXCEPTION: unterminated type specification in static method call", out, i.key);
        }
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "generic-static-call-list-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them; any other output fails
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
