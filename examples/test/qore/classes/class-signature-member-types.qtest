#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - AOT class signature hashes of qcc executables and modules, module loading

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class ClassSignatureMemberTypesTest

#! classes of other Programs that differ only in a declared member, static variable or return type are other types
#! (qore#7457)
/** The signature of a user class, which decides whether a class of another Program with the same path is the same
    type, was computed before the types of its members and static variables were resolved, so that a type other than
    a simple builtin type (a container, hashdecl, class, enum or union type) was hashed as \c any, and the return
    types of methods were not hashed, nor the namespace paths of the type arguments of a generic parent class: two
    Programs whose classes \c MTP::Foo differed only in such a type took an object of one for the other.  The
    declared types are now part of the signature; the same declaration in another Program is still the same type, also
    when one of them is compiled by qcc (an executable or a qcc -m module, whose AOT image stores the signature hash)
    or parsed with other parse options (the \c nothing return type that PO_REQUIRE_TYPES and PO_REQUIRE_PROTOTYPES
    imply for a method without a declared return type is not in the signature).

    The output of every execution mode, of qcc executables (-O0, -O3) and of the program whose classes are loaded from
    the module's source and from a qcc -m .qmod must be the same: probe.expected.  The programs, the checks that they
    share (checks.ql), the classes (classes.ql) and the module are in \c class-signature-member-types/.
*/
class ClassSignatureMemberTypesTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/class-signature-member-types";

        const Name = "probe";
        const Module = "MemberTypeClasses";
    }

    constructor() : QUnit::Test("ClassSignatureMemberTypesTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT, tiered and IR-tier execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        addTestCase("the classes in a module and in a qcc -m .qmod", \testModule());
        set_return_value(main());
    }

    private string qccBin() {
        string qcc_bin = ENV.QCC ?? ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        return is_file(qcc_bin) ? qcc_bin : "qcc";
    }

    private string expected() {
        return ReadOnlyFile::readTextFile(dir + "/" + Name + ".expected");
    }

    private string command(string mode, string script = Name, *string module_dir) {
        return sprintf("%s%s -b --enable-debug --exec-mode=%s %s/%s.q %s", module_dir ? "QORE_MODULE_DIR="
            + module_dir + " " : "", qore_bin, mode, dir, script, dir);
    }

    private string run(string mode, string script = Name, *string module_dir) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command(mode, script, module_dir));
        assertEq(0, r.rc, sprintf("%s: exit status (output: %y)", mode, r.out));
        ExecModeHarness::check_native(r);
        return r.stdout;
    }

    testAst() {
        assertEq(expected(), run("ast"), "ast");
    }

    testModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode), mode);
        }
        # the IR tier of tiered execution runs the calls in the IR interpreter
        assertEq(expected(), ExecModeHarness::run_ir_tier(command("tiered")), ExecModeHarness::IRTierName);
    }

    testModule() {
        # the module's source
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode, "module-user", dir), "source module: " + mode);
        }

        # the module compiled by qcc -m, whose class signatures the AOT image holds
        TmpDir tmp("qore-class-signature-member-types-qmod-");
        int rc;
        string out = backquote(sprintf("%s -m -o %s/%s.qmod %s/%s.qm 2>&1", qccBin(), tmp.path, Module, dir, Module),
            \rc);
        if (rc || !is_file(tmp.path + "/" + Module + ".qmod")) {
            testSkip("qcc is not available or cannot compile the module " + Module + ": " + out);
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode, "module-user", tmp.path), "qmod: " + mode);
        }
    }

    testCompiled() {
        string qcc_bin = qccBin();
        TmpDir tmp("qore-class-signature-member-types-");
        foreach string opt in (("0", "3")) {
            string exe = sprintf("%s/%s-O%s", tmp.path, Name, opt);
            int rc;
            string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, Name), \rc);
            if (rc || !is_file(exe)) {
                testSkip("qcc is not available or cannot compile " + Name + ": " + out);
            }
            # -b must be the first argument of a compiled program
            string result = backquote(sprintf("%s -b %s 2>&1", exe, dir), \rc);
            assertEq(0, rc, sprintf("-O%s: exit status (output: %y)", opt, result));
            assertEq(expected(), result, sprintf("-O%s", opt));
        }
    }
}
