#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation and linking of method calls resolved at run time, module loading

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class PrivateInternalSubclassCallsTest

#! the methods of a class inherited with private:internal access are called only by the code of the inheriting class
#! (qore#7410)
/** A method of a parent class that a class reaches through the private:internal inheritance of a class in its
    hierarchy is called only from the code of the class that inherits it with private:internal access, also on the
    objects of its subclasses, in every call form; the code of the subclasses of that class, of its other parent
    classes and of other classes cannot call it.

    The output of every execution mode, of qcc executables (-O0, -O3) and of the program whose parent classes are
    loaded from the module's source and from a qcc -m .qmod must be the same: probe.expected; child.q (the classes'
    copies in child Programs and calls resolved when parsed) must print child.expected.  The programs, the classes
    that they share (users.ql) and the module are in \c private-internal-subclass-calls/.
*/
class PrivateInternalSubclassCallsTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/private-internal-subclass-calls";
    }

    constructor() : QUnit::Test("PrivateInternalSubclassCallsTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT, tiered and IR-tier execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        addTestCase("the parent classes in a module and in a qcc -m .qmod", \testModule());
        set_return_value(main());
    }

    private string qccBin() {
        string qcc_bin = ENV.QCC ?? ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        return is_file(qcc_bin) ? qcc_bin : "qcc";
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string command(string mode, string script, *string module_dir) {
        return sprintf("%s%s -b --enable-debug --exec-mode=%s %s/%s.q", module_dir ? "QORE_MODULE_DIR="
            + module_dir + " " : "", qore_bin, mode, dir, script);
    }

    private string run(string mode, string script, *string module_dir) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command(mode, script, module_dir));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", script, mode, r.out));
        ExecModeHarness::check_native(r);
        return r.stdout;
    }

    testAst() {
        foreach string name in (("probe", "child")) {
            assertEq(expected(name), run("ast", name), name + ": ast");
        }
    }

    testModes() {
        foreach string name in (("probe", "child")) {
            foreach string mode in (ExecModeHarness::ExecModes) {
                assertEq(expected(name), run(mode, name), name + ": " + mode);
            }
            # the IR tier of tiered execution runs the calls in the IR interpreter
            assertEq(expected(name), ExecModeHarness::run_ir_tier(command("tiered", name)),
                name + ": " + ExecModeHarness::IRTierName);
        }
    }

    testModule() {
        string ex = expected("probe");
        # the module's source
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(ex, run(mode, "module-user", dir), "source module: " + mode);
        }

        # the module compiled by qcc -m
        TmpDir tmp("qore-private-internal-subclass-calls-qmod-");
        string mod = "PrivateInternalSubclassA";
        int rc;
        string out = backquote(sprintf("%s -m -o %s/%s.qmod %s/%s.qm 2>&1", qccBin(), tmp.path, mod, dir, mod), \rc);
        if (rc || !is_file(tmp.path + "/" + mod + ".qmod")) {
            testSkip("qcc is not available or cannot compile the module " + mod + ": " + out);
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(ex, run(mode, "module-user", tmp.path), "qmod: " + mode);
        }
    }

    testCompiled() {
        string qcc_bin = qccBin();
        TmpDir tmp("qore-private-internal-subclass-calls-");
        foreach string name in (("probe", "child")) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                if (rc || !is_file(exe)) {
                    testSkip("qcc is not available or cannot compile " + name + ": " + out);
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
