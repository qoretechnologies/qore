#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../../ExecModeHarness.qm

%exec-class WebSocketUpgradeTokensTest

#! Tests how HTTPClient recognizes a WebSocket upgrade request from its Connection and Upgrade headers
/** Both headers are comma-separated token lists compared case-insensitively (RFC 9110), and either can be a list of
    values; only string values were examined, and "upgrade" was searched as a substring of Connection.  The checks are
    in websocket-upgrade-tokens-worker.qr, which is run in each execution mode and as a program compiled with qcc;
    every run must give the results below.
*/
class WebSocketUpgradeTokensTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "plain": "101:switched",
            "connection-list": "101:switched",
            "connection-tokens": "101:switched",
            "connection-tokens-spaces": "101:switched",
            "case-insensitive": "101:switched",
            "upgrade-list": "101:switched",
            "upgrade-tokens": "101:switched",
            "upgrade-version": "101:switched",
            "not-upgrade-token": "101:not-switched",
            "not-websocket-token": "101:not-switched",
            "no-connection": "101:not-switched",
        };

        #! the execution modes that the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("WebSocketUpgradeTokensTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    testCompiledProgram() {
        TmpDir tmp("qore-websocket-upgrade-tokens-");
        string exe = tmp.path + DirSep + "websocket-upgrade-tokens";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1", libqore_dir,
            qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "websocket-upgrade-tokens-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z0-9]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
