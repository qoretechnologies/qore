#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/1.x responses read from TCP and TLS sockets and the close of the connection
# Copyright (C) 2026 Qore Technologies, s.r.o.

# The status line of an HTTP/1.x response must be "HTTP/" DIGIT "." DIGIT SP 3DIGIT [ SP [ reason-phrase ] ] (RFC 9112
# section 4, which requires the space after the code; a line that ends right after it is accepted, as other clients
# do), with a status code in the range 100 - 599 (RFC 9110 section 15): a response with any other first line,
# such as one with data before the status line or a status code that is not three digits, fails the request with a
# SOCKET-HTTP-ERROR exception, and the connection is closed, never reused; the request is not repeated, whatever its
# method.  Both the HTTPClient class and the HttpClientIo connection manager are tested, and Socket::readHTTPHeader()
# (qore#7485).

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires HttpClientIo

%exec-class HttpClientInvalidStatusLineTest

