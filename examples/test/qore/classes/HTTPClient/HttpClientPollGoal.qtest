#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class HttpClientPollGoalTest

#! The bound on every blocking wait in this test: a hang guard only, never a timing assertion
const HangGuard = 60s;

#! A server for one connection: it answers the request, closes the connection at once, or keeps it open unanswered
class OneShotServer {
    public {
        int port;
        #! for the "keep" mode: the server closes the kept connection once this reaches zero
        Counter close_now(1);
    }

    private {
        Socket listener();
        Counter done(1);
        #! the server closes the connection when an item is pushed, for the "silent" mode
        Queue release();
    }

    constructor(string mode) {
        listener.bindINET("127.0.0.1", "0", True);
        listener.listen();
        port = listener.getSocketInfo().port;
        background serve(mode);
    }

    #! Stops the server; the background thread holds a reference to the object, so this is not a destructor
    stop() {
        release.push(True);
        # closing the listener ends an accept() that no client connects to
        listener.close();
        done.waitForZero(HangGuard);
    }

    private serve(string mode) {
        on_exit done.dec();
        try {
            Socket conn = listener.accept();
            if (mode == "close") {
                conn.close();
                return;
            }
            if (mode == "keep") {
                # the first request is answered and the connection kept; it is closed when the test says so
                conn.readHTTPHeader(HangGuard);
                conn.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain"}, "kept");
                close_now.waitForZero(HangGuard);
                conn.close();
                return;
            }
            if (mode == "ok") {
                conn.readHTTPHeader(HangGuard);
                conn.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain", "Connection": "close"},
                    "answered");
                return;
            }
            # silent: the connection is kept open and the request is never read or answered
            release.get(HangGuard);
            conn.close();
        } catch (hash<ExceptionInfo> ex) {
            # the client went away first
        }
    }
}

class HttpClientPollGoalTest inherits QUnit::Test {
    constructor() : Test("HttpClientPollGoalTest", "1.0") {
        addTestCase("an aborted request has not reached its goal", \testAbort());
        addTestCase("a request that times out has not reached its goal", \testTimeout());
        addTestCase("a request that fails has not reached its goal", \testError());
        addTestCase("an answered request has reached its goal", \testSuccess());
        addTestCase("a request whose connection the server closed before it was submitted fails in its poll operation",
            \testCloseBeforeSubmit());
        addTestCase("a request on a connection whose poll operation failed before the connection was marked closed "
            "fails in its poll operation", \testFailedBeforeMarkedClosed());
        addTestCase("a request on a connection that another thread is closing fails in its poll operation",
            \testConcurrentClose());
        set_return_value(main());
    }

    private hash<SocketPollResultInfo> exec(HTTPClient hc, AbstractPollOperation spop, timeout to) {
        return AsyncIoController::exec(<SocketPollOperationInfo>{
            "sock": hc,
            "spop": spop,
            "owner": sprintf("http-client-poll-goal-%d", getpid()),
            "to": to,
        });
    }

    testAbort() {
        OneShotServer srv("silent");
        on_exit srv.stop();
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/abort");
        spop.abort();
        assertFalse(spop.goalReached(), "an aborted request has not reached its goal");
        assertNothing(spop.getOutput(), "an aborted request has no output");
    }

    testTimeout() {
        OneShotServer srv("silent");
        on_exit srv.stop();
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/timeout");
        # the operation's timeout in the controller ends the request the server never answers
        hash<SocketPollResultInfo> result = exec(hc, spop, 200ms);
        assertEq("SOCKET-TIMEOUT", result.ex.err, "the request times out");
        assertFalse(spop.goalReached(), "a request that timed out has not reached its goal");
    }

    testError() {
        OneShotServer srv("close");
        on_exit srv.stop();
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/error");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertTrue(exists result.ex, "the request fails");
        assertFalse(spop.goalReached(), sprintf("a request that failed (%s) has not reached its goal", result.ex.err));
    }

    #! The server closes a pooled keep-alive connection after startPollSendRecv() found it ready and before the request
    #! is submitted: the error is reported by the poll operation, as when the connection is found closed, and not
    #! raised by startPollSendRecv()
    testCloseBeforeSubmit() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hook that orders the close and the submit is only in debug builds");
        }
        OneShotServer srv("keep");
        on_exit srv.stop();
        on_exit if (srv.close_now.getCount()) {
            srv.close_now.dec();
        }
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        # the first request leaves a ready keep-alive connection in the pool
        assertEq(200, hc.send(NOTHING, "GET", "/first").status_code);
        # the server closes the connection when the submit of the next request is reached, and the submit is made
        # once the I/O thread marked the connection closed
        Counter closed(1);
        call_function("dbg_http_submit_after_close", srv.close_now, closed);
        on_exit call_function("dbg_http_submit_after_close_clear");
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/closed");
        assertEq(0, closed.getCount(), "the connection was closed before the request was submitted");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertTrue(exists result.ex, "the request fails");
        assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
    }

    #! The server closes a pooled keep-alive connection, and the request is submitted after the connection's poll
    #! operation published the failure and before the connection is marked closed (the window in which a server that
    #! closes at once can fail a new connection): the error is reported by the poll operation, as when the connection
    #! is found closed, and not raised by startPollSendRecv()
    testFailedBeforeMarkedClosed() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hook that defers marking a failed connection closed is only in debug builds");
        }
        OneShotServer srv("keep");
        on_exit srv.stop();
        on_exit if (srv.close_now.getCount()) {
            srv.close_now.dec();
        }
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        # the first request leaves a ready keep-alive connection in the pool
        assertEq(200, hc.send(NOTHING, "GET", "/first").status_code);
        # the poll operation of the connection publishes the failure when the server closes it, and the connection is
        # left looking open (and reusable) until the hook is released
        Counter deferred(1);
        call_function("dbg_defer_http1_connection_close", deferred);
        on_exit call_function("dbg_release_http1_connection_close");
        srv.close_now.dec();
        assertEq(0, deferred.waitForZero(HangGuard), "the connection's poll operation failed");
        AbstractPollOperation spop = hc.startPollSendRecv("POST", "/failed", "body");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertEq("HTTP1-CONNECTION-CLOSED", result.ex.err, "the request fails with the connection's error");
        assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
    }

    #! Another thread closes the client's connections (HTTPClient::disconnect()) after startPollSendRecv() checked out
    #! a pooled connection: the submit is made once the close has invalidated the connection (new calls on it are
    #! refused) and before the connection is marked closed, and the error is reported by the poll operation instead of
    #! being raised by startPollSendRecv()
    testConcurrentClose() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that order the close and the submit are only in debug builds");
        }
        OneShotServer srv("keep");
        on_exit srv.stop();
        on_exit if (srv.close_now.getCount()) {
            srv.close_now.dec();
        }
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        # the first request leaves a ready keep-alive connection in the pool
        assertEq(200, hc.send(NOTHING, "GET", "/first").status_code);

        # the submit is held once the connection is checked out, and the close once it has invalidated the connection
        Counter submit_reached(1);
        Counter submit_release(1);
        Counter close_reached(1);
        Counter close_release(1);
        call_function("dbg_http_hold_at", "submit", submit_reached, submit_release);
        call_function("dbg_http_hold_at", "close", close_reached, close_release);
        on_exit {
            call_function("dbg_http_hold_clear");
            if (submit_release.getCount()) {
                submit_release.dec();
            }
            if (close_release.getCount()) {
                close_release.dec();
            }
        }

        Counter submitted(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        background sub () {
            on_exit submitted.dec();
            try {
                spop = hc.startPollSendRecv("GET", "/closing");
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, submit_reached.waitForZero(HangGuard), "the request checked out the pooled connection");

        Counter closed(1);
        background sub () {
            on_exit closed.dec();
            hc.disconnect();
        }();
        assertEq(0, close_reached.waitForZero(HangGuard), "the close invalidated the connection");

        # the submit is made while the connection is being closed
        submit_release.dec();
        assertEq(0, submitted.waitForZero(HangGuard), "startPollSendRecv() returned");
        assertNothing(start_ex, sprintf("startPollSendRecv() raised no exception (%s)", start_ex.err ?? "-"));
        # the close completes
        close_release.dec();
        assertEq(0, closed.waitForZero(HangGuard), "the close completed");

        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertEq("HTTPCLIENT-STATE-ERROR", result.ex.err, "the request fails in its poll operation");
        assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
    }

    testSuccess() {
        OneShotServer srv("ok");
        on_exit srv.stop();
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/ok");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertNothing(result.ex, "the request succeeds");
        assertTrue(spop.goalReached(), "an answered request has reached its goal");
        assertEq(200, spop.getOutput().code, "the output has the response status code");
    }
}
