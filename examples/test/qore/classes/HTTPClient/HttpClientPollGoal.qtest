#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires ../../../TestCertificates.qm

%exec-class HttpClientPollGoalTest

#! The bound on every blocking wait in this test: a hang guard only, never a timing assertion
const HangGuard = 60s;

#! A server for one connection: it answers the request, closes the connection at once, or keeps it open unanswered
class OneShotServer {
    public {
        int port;
        #! for the "keep" mode: the server closes the kept connection once this reaches zero
        Counter close_now(1);
    }

    private {
        Socket listener();
        Counter done(1);
        #! the server closes the connection when an item is pushed, for the "silent" mode
        Queue release();
    }

    constructor(string mode) {
        listener.bindINET("127.0.0.1", "0", True);
        listener.listen();
        port = listener.getSocketInfo().port;
        background serve(mode);
    }

    #! Stops the server; the background thread holds a reference to the object, so this is not a destructor
    stop() {
        release.push(True);
        # closing the listener ends an accept() that no client connects to
        listener.close();
        done.waitForZero(HangGuard);
    }

    private serve(string mode) {
        on_exit done.dec();
        try {
            Socket conn = listener.accept();
            if (mode == "close") {
                conn.close();
                return;
            }
            if (mode == "keep") {
                # the first request is answered and the connection kept; it is closed when the test says so
                conn.readHTTPHeader(HangGuard);
                conn.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain"}, "kept");
                close_now.waitForZero(HangGuard);
                conn.close();
                return;
            }
            if (mode == "ok") {
                conn.readHTTPHeader(HangGuard);
                conn.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain", "Connection": "close"},
                    "answered");
                return;
            }
            # silent: the connection is kept open and the request is never read or answered
            release.get(HangGuard);
            conn.close();
        } catch (hash<ExceptionInfo> ex) {
            # the client went away first
        }
    }
}

#! A response body that sends nothing until released
class BlockingStream inherits InputStream {
    private {
        Counter gate;
    }

    constructor(Counter gate) {
        self.gate = gate;
    }

    *binary read(int limit) {
        # a hang guard only: the test releases the gate
        gate.waitForZero(HangGuard);
        return NOTHING;
    }

    int peek() {
        return -1;
    }
}

#! Answers /stream with a body that sends nothing until released, and anything else at once
class H2Handler inherits AbstractHttpRequestHandler {
    public {
        Counter gate(1);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.path =~ /stream/) {
            return makeResponse(200, new BlockingStream(gate), {"Content-Type": "application/octet-stream"});
        }
        return makeResponse(200, "ok", {"Content-Type": "text/plain"});
    }
}

class HttpClientPollGoalTest inherits QUnit::Test {
    constructor() : Test("HttpClientPollGoalTest", "1.0") {
        addTestCase("an aborted request has not reached its goal", \testAbort());
        addTestCase("a request that times out has not reached its goal", \testTimeout());
        addTestCase("a request that fails has not reached its goal", \testError());
        addTestCase("a request whose new connection fails before the connection manager reserves it fails in its "
            "poll operation", \testNewConnectionFailsBeforeReservation());
        addTestCase("an answered request has reached its goal", \testSuccess());
        addTestCase("a request whose connection the server closed before it was submitted fails in its poll operation",
            \testCloseBeforeSubmit());
        addTestCase("a request on a connection whose poll operation failed before the connection was marked closed "
            "fails in its poll operation", \testFailedBeforeMarkedClosed());
        addTestCase("a request on a connection that another thread is closing fails in its poll operation",
            \testConcurrentClose());
        addTestCase("a request whose negotiating (ALPN) connection is closed before it is handed over fails in its poll "
            "operation", \testFinalizeAfterClose());
        addTestCase("a request whose negotiating connection another thread is closing does not close it a second time",
            \testFinalizeDuringClose());
        addTestCase("a close of a negotiating connection waits for its hand-over", \testTakeoverDuringClose());
        addTestCase("a connect hands over its negotiating connection after a close of the client's connections",
            \testConnectSwapAfterClose());
        addTestCase("a request keeps the pooled connection that it acquired across a close of the client's connections",
            \testAcquireAfterClose());
        addTestCase("a request whose submit found the connection closed and that is invalidated before the error is "
            "classified fails in its poll operation", \testSubmitFailedThenInvalidated());
        addTestCase("a request on a multiplexed connection that another request closes is not closed a second time",
            \testConcurrentCloseMultiplexed());
        set_return_value(main());
    }

    private hash<SocketPollResultInfo> exec(HTTPClient hc, AbstractPollOperation spop, timeout to) {
        return AsyncIoController::exec(<SocketPollOperationInfo>{
            "sock": hc,
            "spop": spop,
            "owner": sprintf("http-client-poll-goal-%d", getpid()),
            "to": to,
        });
    }

    testAbort() {
        OneShotServer srv("silent");
        on_exit srv.stop();
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/abort");
        spop.abort();
        assertFalse(spop.goalReached(), "an aborted request has not reached its goal");
        assertNothing(spop.getOutput(), "an aborted request has no output");
    }

    testTimeout() {
        OneShotServer srv("silent");
        on_exit srv.stop();
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/timeout");
        # the operation's timeout in the controller ends the request the server never answers
        hash<SocketPollResultInfo> result = exec(hc, spop, 200ms);
        assertEq("SOCKET-TIMEOUT", result.ex.err, "the request times out");
        assertFalse(spop.goalReached(), "a request that timed out has not reached its goal");
    }

    testError() {
        OneShotServer srv("close");
        on_exit srv.stop();
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/error");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertTrue(exists result.ex, "the request fails");
        assertFalse(spop.goalReached(), sprintf("a request that failed (%s) has not reached its goal", result.ex.err));
    }

    #! A new connection fails before the connection manager reserves it: the error is reported by the poll operation
    /** The manager refuses a new connection that closed before it reserved its first stream and raises the
        connection's error from the acquire (a refused connect here; a server that closes the connection at once, as in
        testError(), on a loaded host); startPollSendRecv() raised it itself instead of reporting it through its poll
        operation (qore#6111).  The connect is ordered before the reservation with dbg_http_new_connection_wait(), and
        the port refuses connections at once: a connection holds it and nothing listens on it.
    */
    testNewConnectionFailsBeforeReservation() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hook that orders the connect and the reservation is only in debug builds");
        }
        # a port that refuses connections at once: a connection holds it, and its listener is closed
        Socket listener();
        listener.bindINET("127.0.0.1", "0", False);
        listener.listen(1);
        int port = listener.getSocketInfo().port;
        Socket client();
        client.connect(sprintf("127.0.0.1:%d", port), HangGuard);
        *Socket server_end = listener.accept(HangGuard);
        assertTrue(exists server_end, "the connection that holds the port is accepted");
        listener.close();

        HTTPClient hc({"url": "http://127.0.0.1:" + port});
        call_function("dbg_http_new_connection_wait");
        on_exit call_function("dbg_http_new_connection_wait_clear");
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/refused");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertEq("SOCKET-CONNECT-ERROR", result.ex.err, "the refused connect is reported by the poll operation");
        assertFalse(spop.goalReached(), "a request whose connect was refused has not reached its goal");
    }

    #! The server closes a pooled keep-alive connection after startPollSendRecv() found it ready and before the request
    #! is submitted: the error is reported by the poll operation, as when the connection is found closed, and not
    #! raised by startPollSendRecv()
    testCloseBeforeSubmit() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hook that orders the close and the submit is only in debug builds");
        }
        OneShotServer srv("keep");
        on_exit srv.stop();
        on_exit if (srv.close_now.getCount()) {
            srv.close_now.dec();
        }
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        # the first request leaves a ready keep-alive connection in the pool
        assertEq(200, hc.send(NOTHING, "GET", "/first").status_code);
        # the server closes the connection when the submit of the next request is reached, and the submit is made
        # once the I/O thread marked the connection closed
        Counter closed(1);
        call_function("dbg_http_submit_after_close", srv.close_now, closed);
        on_exit call_function("dbg_http_submit_after_close_clear");
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/closed");
        assertEq(0, closed.getCount(), "the connection was closed before the request was submitted");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertTrue(exists result.ex, "the request fails");
        assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
    }

    #! The server closes a pooled keep-alive connection, and the request is submitted after the connection's poll
    #! operation published the failure and before the connection is marked closed (the window in which a server that
    #! closes at once can fail a new connection): the error is reported by the poll operation, as when the connection
    #! is found closed, and not raised by startPollSendRecv()
    testFailedBeforeMarkedClosed() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hook that defers marking a failed connection closed is only in debug builds");
        }
        OneShotServer srv("keep");
        on_exit srv.stop();
        on_exit if (srv.close_now.getCount()) {
            srv.close_now.dec();
        }
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        # the first request leaves a ready keep-alive connection in the pool
        assertEq(200, hc.send(NOTHING, "GET", "/first").status_code);
        # the poll operation of the connection publishes the failure when the server closes it, and the connection is
        # left looking open (and reusable) until the hook is released
        Counter deferred(1);
        call_function("dbg_defer_http1_connection_close", deferred);
        on_exit call_function("dbg_release_http1_connection_close");
        srv.close_now.dec();
        assertEq(0, deferred.waitForZero(HangGuard), "the connection's poll operation failed");
        AbstractPollOperation spop = hc.startPollSendRecv("POST", "/failed", "body");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertEq("HTTP1-CONNECTION-CLOSED", result.ex.err, "the request fails with the connection's error");
        assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
    }

    #! Another thread closes the client's connections (HTTPClient::disconnect()) after startPollSendRecv() checked out
    #! a pooled connection: the submit is made once the close has invalidated the connection (new calls on it are
    #! refused) and before the connection is marked closed, and the error is reported by the poll operation instead of
    #! being raised by startPollSendRecv()
    testConcurrentClose() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that order the close and the submit are only in debug builds");
        }
        OneShotServer srv("keep");
        on_exit srv.stop();
        on_exit if (srv.close_now.getCount()) {
            srv.close_now.dec();
        }
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        # the first request leaves a ready keep-alive connection in the pool
        assertEq(200, hc.send(NOTHING, "GET", "/first").status_code);

        # the submit is held once the connection is checked out, and the close once it has invalidated the connection
        Counter submit_reached(1);
        Counter submit_release(1);
        Counter close_reached(1);
        Counter close_release(1);
        # registered before the hooks are armed, so that a failure while arming them leaves none armed
        on_exit {
            call_function("dbg_http_hold_clear");
            if (submit_release.getCount()) {
                submit_release.dec();
            }
            if (close_release.getCount()) {
                close_release.dec();
            }
        }
        call_function("dbg_http_hold_at", "submit", submit_reached, submit_release);
        call_function("dbg_http_hold_at", "close", close_reached, close_release);

        Counter submitted(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        background sub () {
            on_exit submitted.dec();
            try {
                spop = hc.startPollSendRecv("GET", "/closing");
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, submit_reached.waitForZero(HangGuard), "the request checked out the pooled connection");

        Counter closed(1);
        background sub () {
            on_exit closed.dec();
            hc.disconnect();
        }();
        assertEq(0, close_reached.waitForZero(HangGuard), "the close invalidated the connection");

        # the submit is made while the connection is being closed
        submit_release.dec();
        assertEq(0, submitted.waitForZero(HangGuard), "startPollSendRecv() returned");
        assertNothing(start_ex, sprintf("startPollSendRecv() raised no exception (%s)", start_ex.err ?? "-"));
        # the close completes
        close_release.dec();
        assertEq(0, closed.waitForZero(HangGuard), "the close completed");

        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        # reported as the poll operations report a disconnect
        assertEq("SOCKET-NOT-OPEN", result.ex.err, "the request fails in its poll operation");
        assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
    }

    #! A request finds its ALPN-negotiating connection (HTTPS, protocol negotiated) ready, and another thread closes
    #! the client's connections before the request hands the connection over to a concrete HTTP/1 or HTTP/2 connection:
    #! the error is reported by the poll operation instead of being raised by startPollSendRecv() (qore#6301: the hand-
    #! over refused the connection that was no longer ready with HTTPCLIENT-NEGOTIATE-ERROR, which was raised)
    testFinalizeAfterClose() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that order the close and the finalize are only in debug builds");
        }
        H2Handler handler();
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("http-client-poll-goal", LoggerLevel::getLevelInfo()),
        });
        on_exit server.stop();
        server.setDefaultHandler("tls", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
            "enable_h3": False,
        }).port;
        server.waitForAsyncIo();

        # a client whose connections negotiate their protocol with ALPN
        HTTPClient hc({
            "url": sprintf("https://127.0.0.1:%d", port),
            "http3_mode": "disabled",
            "ssl_verify_cert": False,
        });

        Counter finalize_reached(1);
        Counter finalize_release(1);
        # registered before the hook is armed, so that a failure while arming it leaves none armed
        on_exit {
            call_function("dbg_http_hold_clear");
            if (finalize_release.getCount()) {
                finalize_release.dec();
            }
        }
        # the request waits for its negotiating connection to be ready and is held before it hands it over
        call_function("dbg_http_hold_at", "finalize", finalize_reached, finalize_release);

        Counter submitted(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        background sub () {
            on_exit submitted.dec();
            try {
                spop = hc.startPollSendRecv("GET", "/negotiated");
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, finalize_reached.waitForZero(HangGuard), "the request found its negotiating connection ready");

        # another thread closes the client's connections while the request is held
        Counter closed(1);
        background sub () {
            on_exit closed.dec();
            hc.disconnect();
        }();
        assertEq(0, closed.waitForZero(HangGuard), "the close completed");

        # the request hands over the connection that was closed meanwhile
        finalize_release.dec();
        assertEq(0, submitted.waitForZero(HangGuard), "startPollSendRecv() returned");
        assertNothing(start_ex, sprintf("startPollSendRecv() raised no exception (%s: %s)", start_ex.err ?? "-",
            start_ex.desc ?? "-"));
        assertTrue(exists spop, "startPollSendRecv() returned a poll operation");
        if (spop) {
            hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
            # reported as the poll operations report a disconnect
            assertEq("SOCKET-NOT-OPEN", result.ex.err, "the request fails in its poll operation");
            assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
        }
    }

    #! A request finds its ALPN-negotiating connection ready, and another thread closes the client's connections: the
    #! close has taken the connection out of the pool and invalidated it, and is held before it closes the connection,
    #! when the request hands the connection over; the hand-over refuses it, the request fails in its poll operation, and
    #! the connection is not closed a second time beside the close in progress (qore#6303)
    testFinalizeDuringClose() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that order the close and the finalize are only in debug builds");
        }
        H2Handler handler();
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("http-client-poll-goal", LoggerLevel::getLevelInfo()),
        });
        on_exit server.stop();
        server.setDefaultHandler("tls", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
            "enable_h3": False,
        }).port;
        server.waitForAsyncIo();

        HTTPClient hc({
            "url": sprintf("https://127.0.0.1:%d", port),
            "http3_mode": "disabled",
            "ssl_verify_cert": False,
        });
        int closes = call_function("dbg_http_concurrent_closes");

        Counter finalize_reached(1);
        Counter finalize_release(1);
        Counter close_reached(1);
        Counter close_release(1);
        # registered before the hooks are armed, so that a failure while arming them leaves none armed
        on_exit {
            call_function("dbg_http_hold_clear");
            if (finalize_release.getCount()) {
                finalize_release.dec();
            }
            if (close_release.getCount()) {
                close_release.dec();
            }
        }
        call_function("dbg_http_hold_at", "finalize", finalize_reached, finalize_release);

        Counter submitted(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        background sub () {
            on_exit submitted.dec();
            try {
                spop = hc.startPollSendRecv("GET", "/negotiated");
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, finalize_reached.waitForZero(HangGuard), "the request found its negotiating connection ready");

        # another thread closes the client's connections; its close of the negotiating connection is held once it
        # invalidated the connection
        call_function("dbg_http_hold_at", "close", close_reached, close_release);
        Counter closed(1);
        background sub () {
            on_exit closed.dec();
            hc.disconnect();
        }();
        assertEq(0, close_reached.waitForZero(HangGuard), "the close invalidated the negotiating connection");

        # the request hands over the connection while the close is in progress
        finalize_release.dec();
        assertEq(0, submitted.waitForZero(HangGuard), "startPollSendRecv() returned");
        assertNothing(start_ex, sprintf("startPollSendRecv() raised no exception (%s: %s)", start_ex.err ?? "-",
            start_ex.desc ?? "-"));
        # the close completes
        close_release.dec();
        assertEq(0, closed.waitForZero(HangGuard), "the close completed");
        assertEq(closes, call_function("dbg_http_concurrent_closes"), "no second close of the connection ran beside "
            "the close in progress");

        assertTrue(exists spop, "startPollSendRecv() returned a poll operation");
        if (spop) {
            hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
            assertTrue(exists result.ex, "the request fails in its poll operation");
            assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
        }
    }

    #! A request acquires a keep-alive connection from the pool, and another thread closes the client's connections
    #! after the pool lock was released and before the request uses the connection: the close releases the pool's
    #! reference, and the request, which owns a reference of its own from the moment it found the connection, keeps it
    #! alive and ends with an error (qore#6303: the connection manager handed out a borrowed connection, so the close
    #! destroyed the connection before the request took a reference)
    testAcquireAfterClose() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hook that orders the close and the acquire is only in debug builds");
        }
        H2Handler handler();
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("http-client-poll-goal", LoggerLevel::getLevelInfo()),
        });
        on_exit server.stop();
        server.setDefaultHandler("plain", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
        }).port;
        server.waitForAsyncIo();

        HTTPClient hc({
            "url": sprintf("http://127.0.0.1:%d", port),
            "http3_mode": "disabled",
        });

        # a first request leaves its keep-alive connection in the pool
        AbstractPollOperation first = hc.startPollSendRecv("GET", "/first");
        hash<SocketPollResultInfo> first_result = exec(hc, first, HangGuard);
        assertNothing(first_result.ex, "the first request succeeded");
        assertTrue(first.goalReached(), "the first request reached its goal");

        # the second request finds the connection in the pool and is held after the pool lock is released
        Counter acquired_reached(1);
        Counter acquired_release(1);
        # the background threads of the test, which end before it does
        Counter threads();
        # registered before the hook is armed, so that a failure while arming it leaves none armed
        on_exit {
            call_function("dbg_http_hold_clear");
            if (acquired_release.getCount()) {
                acquired_release.dec();
            }
            threads.waitForZero(HangGuard);
        }
        call_function("dbg_http_hold_at", "acquired", acquired_reached, acquired_release);

        Counter started(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        threads.inc();
        background sub () {
            on_exit {
                started.dec();
                threads.dec();
            }
            try {
                spop = hc.startPollSendRecv("GET", "/second");
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, acquired_reached.waitForZero(HangGuard), "the request acquired the pooled connection");

        # the close of the client's connections removes the connection from the pool and releases the pool's reference
        hc.disconnect();

        # the request uses the connection that it acquired
        acquired_release.dec();
        assertEq(0, started.waitForZero(HangGuard), "startPollSendRecv() returned");
        if (spop) {
            # the request finds the connection that it kept closed
            hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
            assertEq("HTTP-CLIENT-CONNECT-ERROR", result.ex.err, sprintf("the request reports the closed connection "
                "(%s: %s)", result.ex.err ?? "-", result.ex.desc ?? "-"));
        } else {
            assertTrue(exists start_ex, "startPollSendRecv() raised an exception if it returned no poll operation");
        }
    }

    #! A connect hands its ready ALPN-negotiating connection over to a concrete connection, and another thread closes
    #! the client's connections after the hand-over and before the connection manager replaces the negotiating
    #! connection in its pool: the close removes the negotiating connection from the pool and releases the pool's
    #! reference, and the connect, which holds a reference of its own, then finds it gone from the pool (qore#6303:
    #! the connect held no reference, so the negotiating connection was destroyed while the manager used it)
    testConnectSwapAfterClose() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that order the close and the hand-over are only in debug builds");
        }
        H2Handler handler();
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("http-client-poll-goal", LoggerLevel::getLevelInfo()),
        });
        on_exit server.stop();
        server.setDefaultHandler("tls", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
            "enable_h3": False,
        }).port;
        server.waitForAsyncIo();

        HTTPClient hc({
            "url": sprintf("https://127.0.0.1:%d", port),
            "http3_mode": "disabled",
            "ssl_verify_cert": False,
        });

        # the connect waits for its negotiating connection to be ready (the release Counter of the finalize hold is
        # 0), so that it hands the connection over itself, and is held after the hand-over
        Counter finalize_reached(1);
        Counter finalize_release(0);
        Counter swap_reached(1);
        Counter swap_release(1);
        # the background threads of the test, which end before it does
        Counter threads();
        # registered before the hooks are armed, so that a failure while arming them leaves none armed
        on_exit {
            call_function("dbg_http_hold_clear");
            if (swap_release.getCount()) {
                swap_release.dec();
            }
            threads.waitForZero(HangGuard);
        }
        call_function("dbg_http_hold_at", "finalize", finalize_reached, finalize_release);
        call_function("dbg_http_hold_at", "swap", swap_reached, swap_release);

        Counter started(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        threads.inc();
        background sub () {
            on_exit {
                started.dec();
                threads.dec();
            }
            try {
                spop = hc.startPollConnect();
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, swap_reached.waitForZero(HangGuard), "the connect handed over its negotiating connection");

        # the close of the client's connections removes the negotiating connection from the pool and completes: the
        # hand-over is over, so it does not wait for it
        hc.disconnect();

        # the manager replaces the negotiating connection, which is no longer in the pool; the connect's own reference
        # keeps the negotiating connection alive until then
        swap_release.dec();
        assertEq(0, started.waitForZero(HangGuard), "startPollConnect() returned");
        assertNothing(start_ex, sprintf("startPollConnect() raised no exception (%s: %s)", start_ex.err ?? "-",
            start_ex.desc ?? "-"));
        assertTrue(exists spop, "startPollConnect() returned a poll operation");
        if (spop) {
            # the client was disconnected while the connect was in progress
            hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
            assertEq("SOCKET-NOT-OPEN", result.ex.err, sprintf("the connect reports the disconnect (%s: %s)",
                result.ex.err ?? "-", result.ex.desc ?? "-"));
            assertFalse(spop.goalReached(), "the connect did not reach its goal");
        }
    }

    #! A request hands its ALPN-negotiating connection over to a concrete connection, and another thread begins to close
    #! the client's connections during the hand-over: the close waits for the hand-over, which holds the connection's
    #! method guard, and then finds the connection taken over; the socket is never cancelled while it is handed over
    #! (qore#6303: the hand-over held no guard, so a close that began after its checks cancelled the socket of the new
    #! connection)
    testTakeoverDuringClose() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that order the close and the hand-over are only in debug builds");
        }
        H2Handler handler();
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("http-client-poll-goal", LoggerLevel::getLevelInfo()),
        });
        on_exit server.stop();
        server.setDefaultHandler("tls", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
            "enable_h3": False,
        }).port;
        server.waitForAsyncIo();

        HTTPClient hc({
            "url": sprintf("https://127.0.0.1:%d", port),
            "http3_mode": "disabled",
            "ssl_verify_cert": False,
        });
        int closes = call_function("dbg_http_concurrent_closes");

        # the request waits for its negotiating connection to be ready (and is not held there: its release Counter is
        # 0), so that it hands the connection over itself, and is held in the hand-over with the method guard held
        Counter finalize_reached(1);
        Counter finalize_release(0);
        Counter takeover_reached(1);
        Counter takeover_release(1);
        # reports that the close waits for the hand-over (its release Counter is 0)
        Counter drain_reached(1);
        Counter drain_release(0);
        # the background threads of the test, which end before it does, so that a failure leaves none behind to take
        # the hooks of a later case
        Counter threads();
        # registered before the hooks are armed, so that a failure while arming them leaves none armed
        on_exit {
            call_function("dbg_http_hold_clear");
            if (takeover_release.getCount()) {
                takeover_release.dec();
            }
            threads.waitForZero(HangGuard);
        }
        call_function("dbg_http_hold_at", "finalize", finalize_reached, finalize_release);
        call_function("dbg_http_hold_at", "takeover", takeover_reached, takeover_release);

        Counter submitted(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        threads.inc();
        background sub () {
            on_exit {
                submitted.dec();
                threads.dec();
            }
            try {
                spop = hc.startPollSendRecv("GET", "/negotiated");
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, takeover_reached.waitForZero(HangGuard), "the request is handing over its negotiating connection");

        # another thread closes the client's connections: its close of the negotiating connection waits for the
        # hand-over
        call_function("dbg_http_hold_at", "drain-wait", drain_reached, drain_release);
        Counter closed(1);
        threads.inc();
        background sub () {
            on_exit {
                closed.dec();
                threads.dec();
            }
            hc.disconnect();
        }();
        assertEq(0, drain_reached.waitForZero(HangGuard), "the close waits for the hand-over");

        # the hand-over completes; the close then finds the connection taken over
        takeover_release.dec();
        assertEq(0, submitted.waitForZero(HangGuard), "startPollSendRecv() returned");
        assertNothing(start_ex, sprintf("startPollSendRecv() raised no exception (%s: %s)", start_ex.err ?? "-",
            start_ex.desc ?? "-"));
        assertEq(0, closed.waitForZero(HangGuard), "the close completed");
        assertEq(closes, call_function("dbg_http_concurrent_closes"), "no second close of the connection ran beside "
            "the close in progress");

        assertTrue(exists spop, "startPollSendRecv() returned a poll operation");
        if (spop) {
            # the request ends: on the concrete connection that it took over, or with the error of the disconnect
            hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
            assertTrue(exists result.ex || spop.goalReached(), "the request ended");
        }
    }

    #! The server closes a pooled keep-alive connection and the submit of the next request finds it closed (it raises
    #! the error that the connection's poll operation stored); then another thread closes the client's connections,
    #! which invalidates the connection (new calls on it are refused, also the read of its error) before the error of
    #! the submit is classified: the error is reported by the poll operation instead of being raised by
    #! startPollSendRecv() (qore#6111: the error was matched with the connection's error only, which the invalidated
    #! connection no longer gave)
    testSubmitFailedThenInvalidated() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that order the close and the submit are only in debug builds");
        }
        OneShotServer srv("keep");
        on_exit srv.stop();
        on_exit if (srv.close_now.getCount()) {
            srv.close_now.dec();
        }
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        # the first request leaves a ready keep-alive connection in the pool
        assertEq(200, hc.send(NOTHING, "GET", "/first").status_code);

        Counter marked_closed(1);
        Counter failed_reached(1);
        Counter failed_release(1);
        Counter close_reached(1);
        Counter close_release(1);
        # registered before the hooks are armed, so that a failure while arming them leaves none armed
        on_exit {
            call_function("dbg_http_hold_clear");
            call_function("dbg_http_submit_after_close_clear");
            if (failed_release.getCount()) {
                failed_release.dec();
            }
            if (close_release.getCount()) {
                close_release.dec();
            }
        }
        # the server closes the connection when the submit is reached, and the submit is made once the I/O thread
        # marked the connection closed: the submit raises the error that its poll operation stored
        call_function("dbg_http_submit_after_close", srv.close_now, marked_closed);
        # the failed submit is held before its error is classified, and the close once it invalidated the connection
        call_function("dbg_http_hold_at", "submit-failed", failed_reached, failed_release);
        call_function("dbg_http_hold_at", "close", close_reached, close_release);

        Counter submitted(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        background sub () {
            on_exit submitted.dec();
            try {
                spop = hc.startPollSendRecv("GET", "/closed");
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, failed_reached.waitForZero(HangGuard), "the submit found the connection closed");

        Counter closed(1);
        background sub () {
            on_exit closed.dec();
            hc.disconnect();
        }();
        assertEq(0, close_reached.waitForZero(HangGuard), "the close invalidated the connection");

        # the error of the submit is classified while the connection is invalidated
        failed_release.dec();
        assertEq(0, submitted.waitForZero(HangGuard), "startPollSendRecv() returned");
        assertNothing(start_ex, sprintf("startPollSendRecv() raised no exception (%s: %s)", start_ex.err ?? "-",
            start_ex.desc ?? "-"));
        # the close completes
        close_release.dec();
        assertEq(0, closed.waitForZero(HangGuard), "the close completed");

        assertTrue(exists spop, "startPollSendRecv() returned a poll operation");
        if (spop) {
            hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
            # reported as the poll operations report a disconnect, through the deferred error of the submit
            assertEq("SOCKET-NOT-OPEN", result.ex.err, "the request fails in its poll operation");
            assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
        }
    }

    #! A streaming request on a pooled HTTP/2 connection is aborted, which closes the connection (without taking it
    #! out of the pool), while another request on the same connection is about to submit: the other request's error is
    #! reported by its poll operation, and the connection is not closed a second time beside the first close
    testConcurrentCloseMultiplexed() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that order the close and the submit are only in debug builds");
        }
        H2Handler handler();
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("http-client-poll-goal", LoggerLevel::getLevelInfo()),
        });
        on_exit server.stop();
        on_exit if (handler.gate.getCount()) {
            handler.gate.dec();
        }
        server.setDefaultHandler("h2", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "http_version": "h2c",
        }).port;
        server.waitForAsyncIo();

        HTTPClient hc({"url": "http://127.0.0.1:" + port});
        hc.setHttp2Mode("h2c");
        # the first request leaves a ready HTTP/2 connection in the pool
        assertEq(200, hc.send(NOTHING, "GET", "/first").status_code);
        int closes = call_function("dbg_http_concurrent_closes");
        # a streaming request on the pooled connection: its abort closes the connection
        AbstractPollOperation streaming = hc.startPollSendAndStream("GET", "/stream");

        Counter submit_reached(1);
        Counter submit_release(1);
        Counter close_reached(1);
        Counter close_release(1);
        on_exit {
            call_function("dbg_http_hold_clear");
            if (submit_release.getCount()) {
                submit_release.dec();
            }
            if (close_release.getCount()) {
                close_release.dec();
            }
        }
        call_function("dbg_http_hold_at", "submit", submit_reached, submit_release);
        call_function("dbg_http_hold_at", "close", close_reached, close_release);

        Counter submitted(1);
        *AbstractPollOperation spop;
        *hash<ExceptionInfo> start_ex;
        background sub () {
            on_exit submitted.dec();
            try {
                spop = hc.startPollSendRecv("GET", "/other");
            } catch (hash<ExceptionInfo> ex) {
                start_ex = ex;
            }
        }();
        assertEq(0, submit_reached.waitForZero(HangGuard), "the request checked out the pooled connection");

        Counter aborted(1);
        background sub () {
            on_exit aborted.dec();
            streaming.abort();
        }();
        assertEq(0, close_reached.waitForZero(HangGuard), "the abort's close invalidated the connection");

        # the submit is made while the connection is being closed
        submit_release.dec();
        assertEq(0, submitted.waitForZero(HangGuard), "startPollSendRecv() returned");
        assertNothing(start_ex, sprintf("startPollSendRecv() raised no exception (%s)", start_ex.err ?? "-"));
        close_release.dec();
        assertEq(0, aborted.waitForZero(HangGuard), "the close completed");
        assertEq(closes, call_function("dbg_http_concurrent_closes"),
            "no second close of the connection ran beside the first");

        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        # the error of a submit that the closing connection refused
        assertEq("HTTPCLIENT-STATE-ERROR", result.ex.err, "the request fails in its poll operation");
        assertFalse(spop.goalReached(), "a request that failed has not reached its goal");
    }

    testSuccess() {
        OneShotServer srv("ok");
        on_exit srv.stop();
        HTTPClient hc({"url": "http://127.0.0.1:" + srv.port});
        AbstractPollOperation spop = hc.startPollSendRecv("GET", "/ok");
        hash<SocketPollResultInfo> result = exec(hc, spop, HangGuard);
        assertNothing(result.ex, "the request succeeds");
        assertTrue(spop.goalReached(), "an answered request has reached its goal");
        assertEq(200, spop.getOutput().code, "the output has the response status code");
    }
}
