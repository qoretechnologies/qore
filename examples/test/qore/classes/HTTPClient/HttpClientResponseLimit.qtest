    Tests for the maximum size of an HTTP response body received by HTTPClient (max_response_body_size):
    - HTTP/1.1 bodies with a Content-Length, chunked transfer encoding, and read until the connection closes
    - decoded bodies for every supported Content-Encoding and a decompression bomb
    - streaming delivery, the poll API, HTTP/2, and HTTP/3
    - malformed chunk sizes
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer

%exec-class HttpClientResponseLimitTest

#! An HTTP/1.1 server that answers each request with the raw response a callback builds for its path
/** Each connection gets one response and is closed.  The server is stopped with a request for \c /stop, so that
    no accept timeout is needed.
*/
class RawResponseServer {
    public {
        int port;
    }

    private {
        Socket listener();
        Counter running(1);
        code<binary(string)> respond;
    }

    constructor(code<binary(string)> respond) {
        self.respond = respond;
        listener.bindINET("127.0.0.1", 0);
        listener.listen();
        port = listener.getSocketInfo().port;
        background run();
    }

    destructor() {
        stop();
    }

    stop() {
        if (!running.getCount()) {
            return;
        }
        Socket s();
        s.connect("127.0.0.1:" + port);
        s.send("GET /stop HTTP/1.1\r\nHost: localhost\r\n\r\n");
        running.waitForZero();
    }

    private run() {
        on_exit running.dec();
        while (True) {
            Socket s = listener.accept();
            hash<auto> hdr = s.readHTTPHeader(30s);
            if (hdr.path == "/stop") {
                break;
            }
            try {
                s.send(respond(hdr.path));
            } catch (hash<ExceptionInfo> ex) {
                # the client may close the connection before reading the whole response
            }
            s.close();
        }
    }
}

#! returns a response body of the size given by the last path element, optionally with a content encoding
class SizedBodyHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        list<string> parts = hdr.path.split("/");
        int size = parts.last().toInt();
        # random bytes do not compress, so the server does not compress them itself
        binary data = get_random_bytes(size);
        if (parts[0] == "gzip") {
            return makeResponse(200, gzip(binary(strmul("x", size))), {
                "Content-Type": MimeTypeOctetStream,
                "Content-Encoding": "gzip",
            });
        }
        return makeResponse(200, data, {"Content-Type": MimeTypeOctetStream});
    }
}

class HttpClientResponseLimitTest inherits QUnit::Test {
    private {
        # the maximum response body size of the tests
        const Limit = 4096;

        # the size of a decompression bomb
        const BombSize = 256 * 1024 * 1024;

