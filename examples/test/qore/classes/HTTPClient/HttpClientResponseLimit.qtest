        const BombMaxPeakGrowth = 64 * 1024 * 1024;

        # the encoders for each supported content encoding
        const Encoders = {
            "gzip": binary sub (binary b) { return gzip(b); },
            "deflate": binary sub (binary b) { return compress(b); },
            "bzip2": binary sub (binary b) { return bzip2(b); },
            "br": binary sub (binary b) { return brotli(b); },
            "zstd": binary sub (binary b) { return zstd(b); },
