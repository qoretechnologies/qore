        #! maps the names of the test certificates to the address of the test servers
        const HostMap = {"wrong.example": "127.0.0.1", "other.example": "127.0.0.1"};
    }

    private {
        TmpDir tmp;
        string ca_file;
        HttpServer server;
        #! TLS listener with a certificate for wrong.example
        int tls_port;
        #! plain HTTP listener
        int plain_port;
        #! a plain HTTP proxy
        TestConnectProxy http_proxy;
        #! an HTTPS proxy with a certificate for 127.0.0.1
        TestConnectProxy https_proxy;
        #! an HTTPS proxy with a certificate for another host
        TestConnectProxy wrong_proxy;
    }

    constructor() : Test("HttpClientHttpsProxyTest", "1.0", \ARGV) {
        addTestCase("TLS through a proxy tunnel is made for the target", \tunnelTargetTest());
        addTestCase("TLS through an HTTPS proxy tunnel", \httpsProxyTunnelTest());
        addTestCase("plain HTTP through an HTTPS proxy", \httpsProxyPlainTest());
        addTestCase("certificate verification through proxies", \verifyTest());
        addTestCase("proxy option errors", \optionErrorTest());
        set_return_value(main());
    }

    globalSetUp() {
        tmp = new TmpDir("https-proxy-");
        ca_file = tmp.path + "/ca.pem";
        File f();
        f.open2(ca_file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(CaCert + "\n");

        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        server.setDefaultHandler("host", new HostHandler());
        tls_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(WrongHostCert),
            "key": new SSLPrivateKey(WrongHostKey),
        }).port;
        plain_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
        }).port;
        server.waitForAsyncIo();

        http_proxy = new TestConnectProxy(NOTHING, NOTHING, NOTHING, HostMap);
        https_proxy = new TestConnectProxy(NOTHING, new SSLCertificate(GoodCert), new SSLPrivateKey(GoodKey), HostMap);
        wrong_proxy = new TestConnectProxy(NOTHING, new SSLCertificate(WrongHostCert),
            new SSLPrivateKey(WrongHostKey), HostMap);
    }

    globalTearDown() {
        map $1.shutdown(), (http_proxy, https_proxy, wrong_proxy), $1;
        if (server) {
            server.stop();
        }
        delete tmp;
    }

    tunnelTargetTest() {
        # the server's certificate is issued for wrong.example, the name of the target, not for the proxy at
        # 127.0.0.1; the TLS connection through the tunnel is made and verified for the target
        string url = sprintf("https://wrong.example:%d", tls_port);
        string proxy = sprintf("http://127.0.0.1:%d", http_proxy.getPort());
        assertEq("host:wrong.example:" + tls_port, httpClientGet(url, proxy, "1.1"));
        assertEq("host:wrong.example:" + tls_port, httpClientGet(url, proxy, "2"));
        foreach string proto in ("h1", "h2") {
            assertEq("host:wrong.example:" + tls_port, ioGet(url, proxy, proto), proto);
        }
    }

    httpsProxyTunnelTest() {
        # the TLS connection to the target is carried by the TLS connection to the proxy
        string url = sprintf("https://wrong.example:%d", tls_port);
        string proxy = sprintf("https://127.0.0.1:%d", https_proxy.getPort());
        int start = https_proxy.getRequests().size();
        assertEq("host:wrong.example:" + tls_port, httpClientGet(url, proxy, "1.1"));
        assertEq("host:wrong.example:" + tls_port, httpClientGet(url, proxy, "2"));
        foreach string proto in ("h1", "h2") {
            assertEq("host:wrong.example:" + tls_port, ioGet(url, proxy, proto), proto);
        }
        list<hash<auto>> reqs = https_proxy.getRequests()[start..];
        assertEq(4, reqs.size());
        foreach hash<auto> req in (reqs) {
            assertTrue(req.ssl);
            assertEq(sprintf("CONNECT wrong.example:%d HTTP/1.1", tls_port), req.line);
        }
    }

    httpsProxyPlainTest() {
        # a plain HTTP request is sent to the proxy with an absolute URI over the TLS connection to the proxy
        string url = sprintf("http://wrong.example:%d", plain_port);
        string proxy = sprintf("https://127.0.0.1:%d", https_proxy.getPort());
        int start = https_proxy.getRequests().size();
        assertEq("host:wrong.example:" + plain_port, httpClientGet(url, proxy, "1.1"));
        assertEq("host:wrong.example:" + plain_port, ioGet(url, proxy, "h1"));
        list<hash<auto>> reqs = https_proxy.getRequests()[start..];
        assertEq(2, reqs.size());
        foreach hash<auto> req in (reqs) {
            assertTrue(req.ssl);
            assertRegex(sprintf("^GET http://wrong.example:%d/ ", plain_port), req.line);
        }
    }

    verifyTest() {
        # the certificate of the target is verified against the name of the target through the tunnel
        string url = sprintf("https://other.example:%d", tls_port);
        foreach string proxy in (sprintf("http://127.0.0.1:%d", http_proxy.getPort()),
                sprintf("https://127.0.0.1:%d", https_proxy.getPort())) {
            assertThrows("SOCKET-SSL-ERROR", \httpClientGet(), (url, proxy, "1.1"), proxy);
            foreach string proto in ("h1", "h2") {
                assertThrows("HTTPCLIENT-CONNECT-ERROR", "hostname mismatch.*other|hostname mismatch", \ioGet(),
                    (url, proxy, proto), proxy + " " + proto);
            }
        }
        # the certificate of an HTTPS proxy is verified against the name of the proxy
        url = sprintf("https://wrong.example:%d", tls_port);
        string proxy = sprintf("https://127.0.0.1:%d", wrong_proxy.getPort());
        assertThrows("SOCKET-SSL-ERROR", "TLS connection to the proxy failed.*mismatch", \httpClientGet(),
            (url, proxy, "1.1"));
        foreach string proto in ("h1", "h2") {
            assertThrows("HTTPCLIENT-CONNECT-ERROR", "TLS connection to the proxy failed.*mismatch",
                \ioGet(), (url, proxy, proto), proto);
        }
        # ... unless all certificates are accepted
        assertEq("host:wrong.example:" + tls_port, ioGet(url, proxy, "h1", {"accept_all_certs": True}));
        # a TLS connection to a proxy that does not use TLS fails
        Socket plain();
        plain.bindINET("127.0.0.1", "0", True);
        plain.listen();
        Counter done(1);
        bool stop;
        background sub () {
            on_exit done.dec();
            # answers the TLS handshake with an HTTP error response, as a plain HTTP proxy does; the client retries
            # a failed connection, so every connection is answered
            while (!stop) {
                *Socket s = plain.accept(100ms);
                if (!s) {
                    continue;
                }
                s.recvBinary(-1, 20s);
                s.send("HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
                s.close();
            }
        }();
        on_exit {
            stop = True;
            done.waitForZero();
            plain.close();
        }
        proxy = sprintf("https://127.0.0.1:%d", plain.getSocketInfo().port);
        assertThrows("HTTPCLIENT-CONNECT-ERROR", "TLS connection to the proxy failed", \ioGet(), (url, proxy, "h1"));
    }

    optionErrorTest() {
        assertThrows("HTTPCLIENT-OPTION-ERROR", "unsupported scheme", sub () {
            new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
                "proxy_url": "socks5://127.0.0.1:1080",
            });
        });
        # a proxy URL that cannot be parsed is not given in the error, since it can contain a password
        try {
            new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
                "proxy_url": "http://user:secret@host:abc",
            });
            fail("the proxy URL is not valid");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("HTTPCLIENT-OPTION-ERROR", ex.err);
            assertNRegex("secret", ex.desc);
        }
    }

    #! makes a GET request with HTTPClient through the given proxy, verifying the certificates with the test CA
    private string httpClientGet(string url, string proxy, string http_version) {
        HTTPClient hc({
            "url": url,
            "proxy": proxy,
            "http_version": http_version,
            "ssl_verify_cert": True,
            "ssl_ca_file": ca_file,
            "timeout": 20s,
            "connect_timeout": 20s,
        });
        on_exit hc.disconnect();
        return hc.get("/");
    }

    #! makes a GET request with HttpClientIo through the given proxy, verifying the certificates with the test CA
    private string ioGet(string url, string proxy, string protocol, *hash<auto> opts) {
        HttpClientConnectionManager mgr(cast<hash<HttpClientConnectionManagerOptions>>({
            "protocol": protocol,
            "proxy_url": proxy,
            "ssl_verify_mode": SSL_VERIFY_PEER,
            "ssl_ca_file": ca_file,
            "accept_encoding": "",
        } + opts));
        on_exit mgr.closeAll();
        return mgr.request(url, "GET", "/").body;
    }
}
