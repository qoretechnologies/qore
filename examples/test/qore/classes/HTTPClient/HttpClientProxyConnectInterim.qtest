#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - proxy CONNECT responses read from TCP and TLS sockets and TLS connections through the tunnel
# Copyright 2026 Qore Technologies, s.r.o.

# The interim (1xx other than 101) responses of a proxy to CONNECT are skipped, and the proxy's final response
# decides whether the tunnel is made: a 2xx makes it, and a 101, any other final response or more than 16 interim
# responses fail the connection; data that the proxy sends after its 2xx response, before the client starts the TLS
# connection to the target server, fails it too, as it would otherwise be read as if the target server had sent it
# (qore#7486).  HTTPClient (HTTP/1.1 and HTTP/2) and the HttpClientIo connection manager (h1 and h2) are tested through
# an HTTP and an HTTPS proxy.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo

%include ../TestConnectProxy.qc

%exec-class HttpClientProxyConnectInterimTest

#! Answers every request with @ref HttpClientProxyConnectInterimTest::OriginBody
class OriginHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, HttpClientProxyConnectInterimTest::OriginBody, {"Content-Type": MimeTypeText});
    }
}

public class HttpClientProxyConnectInterimTest inherits QUnit::Test {
    public {
        #! a certificate for localhost and 127.0.0.1, valid until 2126
        const Cert = "-----BEGIN CERTIFICATE-----
MIIDOTCCAiGgAwIBAgIUb/hhtacVbMRFB9IjBCEsMk0fNK4wDQYJKoZIhvcNAQEL
