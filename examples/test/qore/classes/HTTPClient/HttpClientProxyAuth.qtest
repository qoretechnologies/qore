%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo

%include ../TestConnectProxy.qc

%exec-class HttpClientProxyAuthTest

#! Reports the Proxy-Authorization header received by the target server
class ProxyAuthEchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, sprintf("proxy-authorization: %s", hdr."proxy-authorization" ?? "none"),
            {"Content-Type": MimeTypeText});
    }
}

