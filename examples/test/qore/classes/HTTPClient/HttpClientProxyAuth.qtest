PPZCfm/8UYl3BR1cjpMM3K+NmRnRprr3SH9QxsECgYEAgTR94CDtYFnOf6fYlKrS
LS2vudPAPnPgvnMyoXqkdMVXPFaGt2H0jZbqJNeZ4rDD+F7xKw7Bh7dobks+nTpE
DlzqJCYj569YNnMxXATrUXWlZKA2gUadYwrQYdoIe4eI8pAa5q2BgY7PsaqyFN0q
+QCcroH4V1WH5zPROGJoPVc=
-----END PRIVATE KEY-----";

        #! the credentials required by the proxy
        const User = "user";
        const Pass = "pass";
        const ProxyAuth = "Basic " + make_base64_string(User + ":" + Pass);

        #! credentials that must be percent-encoded in a URL
        const SpecialUser = "us@r";
        const SpecialPass = "p:ss wörd";

        #! the response of the target server to a request without proxy credentials
        const TargetResponse = "proxy-authorization: none";
    }

    private {
        HttpServer server;
        int tls_port;
        int plain_port;
        TestConnectProxy proxy;
        #! a proxy requiring SpecialUser and SpecialPass
        TestConnectProxy special_proxy;
    }

    constructor() : Test("HttpClientProxyAuthTest", "1.0") {
        addTestCase("HTTPClient proxy credentials", \httpClientTest());
        addTestCase("HttpClientIo proxy credentials", \httpClientIoTest());
        addTestCase("HttpClientIo percent-encoded proxy credentials", \httpClientIoEncodedTest());
        addTestCase("proxy from the environment", \environmentTest());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{"logger": new Logger("proxy-auth",
            LoggerLevel::getLevelInfo())});
        server.setDefaultHandler("echo", new ProxyAuthEchoHandler());
        tls_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(Cert),
            "key": new SSLPrivateKey(Key),
        }).port;
        plain_port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        proxy = new TestConnectProxy(ProxyAuth);
        special_proxy = new TestConnectProxy("Basic " + make_base64_string(SpecialUser + ":" + SpecialPass));
    }

    globalTearDown() {
        proxy.shutdown();
        special_proxy.shutdown();
        server.stop();
    }

    #! returns the proxy URL with or without credentials
    private string getProxyUrl(bool creds = True, *string pass) {
        return sprintf("http://%s127.0.0.1:%d", creds ? sprintf("%s:%s@", User, pass ?? Pass) : "",
            proxy.getPort());
    }

    httpClientTest() {
        foreach hash<auto> t in (
            {"url": sprintf("https://127.0.0.1:%d", tls_port), "versions": ("1.1", "2.0", "auto")},
            {"url": sprintf("http://127.0.0.1:%d", plain_port), "versions": ("1.1", "2.0")},
        ) {
            foreach string version in (t.versions) {
                string msg = sprintf("HTTPClient %s %s", t.url, version);
                # the proxy receives the credentials; the target server never does
                HTTPClient hc({"url": t.url, "http_version": version, "proxy": getProxyUrl(), "timeout": 10s});
                hc.setSslVerifyMode(SSL_VERIFY_NONE);
                assertEq(TargetResponse, hc.get("/"), msg);

                # no credentials
                hc = new HTTPClient({"url": t.url, "http_version": version, "proxy": getProxyUrl(False),
                    "timeout": 10s});
                assertRegex("407", getError(\hc.get(), "/"), msg + " (no credentials)");

                # wrong credentials
                hc = new HTTPClient({"url": t.url, "http_version": version, "proxy": getProxyUrl(True, "wrong"),
                    "timeout": 10s});
                assertRegex("407", getError(\hc.get(), "/"), msg + " (wrong credentials)");
            }
        }

        # a Proxy-Authorization header given for a request through a tunnel is not sent to the target server
        HTTPClient hc({"url": sprintf("https://127.0.0.1:%d", tls_port), "http_version": "1.1",
            "proxy": getProxyUrl(), "timeout": 10s});
        assertEq(TargetResponse, hc.get("/", {"Proxy-Authorization": "Basic secret"}));

        # every request sent to the proxy carried the credentials, and the tunnels were made to the target
        list<hash<auto>> reqs = proxy.getRequests();
        assertTrue(reqs.size() > 10);
        list<string> connects = map $1.line, reqs, $1.line =~ /^CONNECT/;
        assertTrue(connects.size() > 0);
        assertEq((), select connects, $1 != sprintf("CONNECT 127.0.0.1:%d HTTP/1.1", tls_port));
    }

    httpClientIoTest() {
        foreach hash<auto> t in (
            {"url": sprintf("https://127.0.0.1:%d", tls_port), "protocols": ("h1", "h2", "auto")},
            {"url": sprintf("http://127.0.0.1:%d", plain_port), "protocols": ("h1", "h2", "auto")},
        ) {
            foreach string protocol in (t.protocols) {
                string msg = sprintf("HttpClientIo %s %s", t.url, protocol);
                HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
                    "protocol": protocol,
                    "proxy_url": getProxyUrl(),
                    "accept_all_certs": True,
                    "max_request_retries": 0,
                });
                on_exit mgr.closeAll();
                hash<auto> resp = mgr.request(t.url, "GET", "/");
                assertEq(200, resp.status_code, msg);
                assertEq(TargetResponse, resp.body, msg);

                HttpClientIo::HttpClientConnectionManager mgr2(<HttpClientIo::HttpClientConnectionManagerOptions>{
                    "protocol": protocol,
                    "proxy_url": getProxyUrl(False),
                    "accept_all_certs": True,
                    "max_request_retries": 0,
                });
                on_exit mgr2.closeAll();
                string err;
                try {
                    resp = mgr2.request(t.url, "GET", "/");
                    err = sprintf("status %d", resp.status_code);
                } catch (hash<ExceptionInfo> ex) {
                    err = ex.err + ": " + ex.desc;
                }
                assertRegex("407", err, msg + " (no credentials)");
            }
        }
    }

    #! credentials in a proxy URL are percent-decoded (RFC 3986 section 3.2.1)
    httpClientIoEncodedTest() {
        string proxy_url = sprintf("http://%s:%s@127.0.0.1:%d", encode_url(SpecialUser, True),
            encode_url(SpecialPass, True), special_proxy.getPort());
        foreach string url in (sprintf("https://127.0.0.1:%d", tls_port), sprintf("http://127.0.0.1:%d", plain_port)) {
            HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "auto",
                "proxy_url": proxy_url,
                "accept_all_certs": True,
            });
            on_exit mgr.closeAll();
            hash<auto> resp = mgr.request(url, "GET", "/");
            assertEq(200, resp.status_code, url);
            assertEq(TargetResponse, resp.body, url);
        }
    }

    environmentTest() {
        hash<string, *string> saved = map {$1: getenv($1)}, ("http_proxy", "https_proxy", "HTTPS_PROXY", "all_proxy",
            "ALL_PROXY", "no_proxy", "NO_PROXY", "HTTP_PROXY");
        on_exit {
            foreach hash<auto> i in (saved.pairIterator()) {
                if (exists i.value) {
                    setenv(i.key, i.value);
                } else {
                    unsetenv(i.key);
                }
            }
        }
        map unsetenv($1), keys saved;

        assertEq(NOTHING, get_proxy_url_from_environment("http://example.com/"));
        # the upper-case HTTP_PROXY is not used
        setenv("HTTP_PROXY", "http://evil:1");
        assertEq(NOTHING, get_proxy_url_from_environment("http://example.com/"));
        setenv("http_proxy", "proxy.local:3128");
        assertEq("http://proxy.local:3128", get_proxy_url_from_environment("http://example.com/"));
        assertEq(NOTHING, get_proxy_url_from_environment("https://example.com/"));
        setenv("HTTPS_PROXY", "http://secure-proxy:8080");
        assertEq("http://secure-proxy:8080", get_proxy_url_from_environment("https://example.com/"));
        setenv("https_proxy", "http://lower-proxy:8080");
        assertEq("http://lower-proxy:8080", get_proxy_url_from_environment("https://example.com/"));
        unsetenv("https_proxy");
        unsetenv("HTTPS_PROXY");
        setenv("all_proxy", "http://all:1");
        assertEq("http://all:1", get_proxy_url_from_environment("https://example.com/"));

        # hosts excluded with no_proxy
        setenv("no_proxy", "localhost, .internal.example, example.org:8080, 10.1.2.3, [::1]");
        assertEq(NOTHING, get_proxy_url_from_environment("http://localhost:8000/"));
        assertEq(NOTHING, get_proxy_url_from_environment("http://a.internal.example/"));
        assertEq(NOTHING, get_proxy_url_from_environment("http://internal.example/"));
        assertEq(NOTHING, get_proxy_url_from_environment("http://www.example.org/"));
        assertEq(NOTHING, get_proxy_url_from_environment("http://10.1.2.3/"));
        assertEq(NOTHING, get_proxy_url_from_environment("http://[::1]:8080/"));
        assertEq("http://proxy.local:3128", get_proxy_url_from_environment("http://notinternal.example/"));
        assertEq("http://proxy.local:3128", get_proxy_url_from_environment("http://10.1.2.30/"));
        setenv("no_proxy", "*");
        assertEq(NOTHING, get_proxy_url_from_environment("http://example.com/"));
        unsetenv("no_proxy");
        setenv("NO_PROXY", "example.com");
        assertEq(NOTHING, get_proxy_url_from_environment("http://example.com/"));
    }

    #! returns the error raised by the call
    private string getError(code c, auto arg) {
        try {
            c(arg);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err + ": " + ex.desc;
        }
        return "no error";
    }
}
