#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../../ExecModeHarness.qm

%exec-class ConnectHeaderValuesTest

#! Tests the header values that HTTPClient::sendHttp2Connect() and sendHttp3Connect() send
/** The headers of an extended CONNECT request are sent as those of every other request: a value that is not a
    string as a string, the elements of a list as repeated headers, and an empty value not at all; an int, bool or
    float header was silently dropped.  The checks are in connect-header-values-worker.qr, which is run in each
    execution mode and as a program compiled with qcc; every run must give the results below.
*/
class ConnectHeaderValuesTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        #! the headers that every request must send; the server parses repeated headers into a list, and HTTP/3
        #! repeated fields into one comma-separated value
        const Expected = {
            "h2-connect": "200",
            "h3-connect": "200",
            "h2-headers": "x-int=\"5\" x-list=list(a,2) x-bool=\"1\" x-float=\"1.5\" x-str=\"s\" x-empty=null",
            "h3-headers": "x-int=\"5\" x-list=\"a, 2\" x-bool=\"1\" x-float=\"1.5\" x-str=\"s\" x-empty=null",
        };

        #! the execution modes that the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("ConnectHeaderValuesTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    testCompiledProgram() {
        TmpDir tmp("qore-connect-header-values-");
        string exe = tmp.path + DirSep + "connect-header-values";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1", libqore_dir,
            qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "connect-header-values-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z0-9]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
