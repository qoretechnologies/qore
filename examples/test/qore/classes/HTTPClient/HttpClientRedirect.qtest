%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires ../../../../../qlib/QUnit.qm
%requires ../../../../../qlib/Util.qm
%requires ../../../../../qlib/Mime.qm
%requires ../../../../../qlib/Logger.qm
%requires ../../../../../qlib/HttpServerUtil.qm
%requires ../../../../../qlib/HttpServer.qm
%requires ../../../../../qlib/AsyncSocketIo

%exec-class HttpClientRedirectTest

#! Makes a request for a sandboxed Program as module code does: this function runs in an unsandboxed Program
/** @param mode \c "sync" (blocking), \c "poll" (a poll operation driven on this thread), or \c "controller" (a poll
    operation driven by the async I/O controller, whose callback workers acquire redirect connections)
    @param url the URL of the server
    @param path the request path
*/
auto sub sandbox_request(string mode, string url, string path) {
    HTTPClient hc({"url": url});
    switch (mode) {
        case "sync":
            return hc.send(NOTHING, "GET", path).body;
        case "poll":
            return HttpClientRedirectTest::drive(hc.startPollSendRecv("GET", path))."response-body";
    }
    AbstractPollOperation op = hc.startPollSendRecv("GET", path);
    Queue q = AsyncSocketIo::getGlobalAsyncIoController().submit(<SocketPollOperationInfo>{
        "sock": hc,
        "spop": op,
        "to": 30s,
        "owner": "http-client-redirect-sandbox-test",
    });
    hash<SocketPollResultInfo> result = q.get();
    if (result.ex) {
        throw result.ex.err, result.ex.desc, result.ex.arg;
    }
    return op.getOutput()."response-body";
}

