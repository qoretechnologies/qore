    HTTPClient::sendUrl() tests: a request selects its own target without changing the client, so every test
    asserts both where the request went and that the client is left exactly as it was configured.
*/

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer

%exec-class HttpClientRequestUrlTest

