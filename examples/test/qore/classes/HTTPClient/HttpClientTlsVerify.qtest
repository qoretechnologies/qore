#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - OpenSSL certificate verification with CA files and hashed CA dirs over TLS and QUIC
# test-loopback: localhost - it verifies the certificate host name "localhost" over TCP and QUIC; its TLS listeners listen on both loopback addresses with the same port, its QUIC listeners on 0.0.0.0 and ::1 with the same port, and the listener of each certificate-failure case is bound to the host that its client connects to
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires Util
%requires FsUtil
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires RestClientIo
%requires ../../../RefusedQuicPort.qm

%exec-class HttpClientTlsVerifyTest

class TlsVerifyHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "verified", {"Content-Type": MimeTypeText});
    }
}

#! Records the connections a connection manager makes, so that a test can tell whether a failed connection was retried
/** A QUIC listener of HttpServer cannot report the handshakes it receives, so the connections are recorded where the
    client starts them: every new connection, of a forced protocol or of either protocol of a race between HTTP/3 and
    HTTP/2, synchronous and asynchronous alike, is submitted to the I/O controller; a connection that wins a race is
    submitted again, so each connection is recorded once
*/
class RecordingManager inherits HttpClientIo::HttpClientConnectionManager {
    private {
        Mutex m();
        list<HttpClientIo::HttpClientConnection> connections();
        #! the IDs of the connections recorded
        hash<string, bool> ids();
    }

    constructor(hash<HttpClientIo::HttpClientConnectionManagerOptions> opts)
            : HttpClientIo::HttpClientConnectionManager(opts) {
    }

    #! Returns the connections made, in the order they were started
    list<HttpClientIo::HttpClientConnection> getConnections() {
        AutoLock al(m);
        return connections;
    }

    private submitConnectionToController(string key, HttpClientIo::HttpClientConnection conn, bool initial = True) {
        {
            AutoLock al(m);
            string id = conn.getConnectionId().toString();
            if (!ids{id}) {
                ids{id} = True;
                connections += conn;
            }
        }
        HttpClientIo::HttpClientConnectionManager::submitConnectionToController(key, conn, initial);
    }
}

