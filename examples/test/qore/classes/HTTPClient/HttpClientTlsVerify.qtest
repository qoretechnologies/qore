        #! HTTP versions tested over TCP
        const TcpVersions = ("1.1", "2.0", "auto");

        #! the client APIs whose connection failures are tested
        const Apis = ("REST", "REST async", "HTTP", "HTTP async");
    }

    private {
        TmpDir tmp;
        string ca_file;
        string ca_dir;
        HttpServer server;
        #! TLS listener with a certificate for localhost and 127.0.0.1
        int good_port;
        #! TLS listener with a certificate for another host
        int wrong_port;
        #! QUIC listeners
        int quic_good_port;
        int quic_wrong_port;
        #! the two ends of the connections that hold the TCP side of the ports of the QUIC listeners (see
        #! addQuicListener())
        list<Socket> quic_tcp_holds = ();
        #! True if the IPv6 side of the ports of the QUIC listeners is held too (the host has an IPv6 loopback)
        bool quic_tcp_v6_held = True;
    }

    constructor() : Test("HttpClientTlsVerifyTest", "1.0") {
        addTestCase("Socket CA locations", \socketTest());
        addTestCase("HTTPClient CA options", \httpClientTest());
        addTestCase("HTTPClient CA with HTTP/3", \http3Test());
        addTestCase("HTTP/3 session tickets", \http3TicketTest());
        addTestCase("HTTP/3 clock step back", \http3ClockStepBackTest());
        addTestCase("HttpClientIo CA options", \httpClientIoTest());
        addTestCase("RestClientIo CA options", \restClientIoTest());
        addTestCase("TCP certificate failures are not retried", \certificateFailureTest());
        addTestCase("HTTP/3 certificate failures are not retried", \http3CertificateFailureTest());
        addTestCase("HTTP/3 with all certificates accepted", \http3AcceptAllTest());
        addTestCase("HTTP/3 connection failures are retried", \http3ConnectFailureTest());
        addTestCase("the TCP side of the QUIC listeners' ports refuses connections", \quicPortTcpRefusedTest());
        addTestCase("HTTP/3 and HTTP/2 race: certificate failures are not retried", \raceCertificateFailureTest());
        addTestCase("HTTPClient option errors", \optionErrorTest());
        set_return_value(main());
    }

    globalSetUp() {
        # several cases make QUIC connections to a UDP port where nothing receives datagrams (an address of
        # "localhost" in another family than the listener's, or a free port); such a connection fails after a grace
        # period of 1.5 seconds following the ICMP "port unreachable", which the DEBUG-only hook sets to 0, so each
        # attempt fails at once in the same way
        if (inlist("debug", get_feature_list())) {
            setenv("QORE_QUIC_TEST_ECONNREFUSED_GRACE_MS", "0");
        }
        tmp = new TmpDir("tls-verify-");
        ca_file = tmp.path + "/ca.pem";
        File f();
        f.open2(ca_file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(CaCert + "\n");
        ca_dir = tmp.path + "/ca-dir";
        mkdir(ca_dir);
        f = new File();
        f.open2(ca_dir + "/" + CaHash + ".0", O_CREAT | O_WRONLY | O_TRUNC);
        f.write(CaCert + "\n");

        Logger logger("tls-verify", LoggerLevel::getLevelInfo());
        server = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        server.setDefaultHandler("tls", new TlsVerifyHandler());
        good_port = addLoopbackListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(GoodCert),
            "key": new SSLPrivateKey(GoodKey),
        });
        wrong_port = addLoopbackListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(WrongHostCert),
            "key": new SSLPrivateKey(WrongHostKey),
        });
        server.waitForAsyncIo();
        quic_good_port = addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(GoodCert),
            "key": new SSLPrivateKey(GoodKey),
        });
        quic_wrong_port = addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(WrongHostCert),
            "key": new SSLPrivateKey(WrongHostKey),
        });
        server.waitForAsyncIo();
    }

    #! Adds a TLS listener on both loopback addresses with the same port and returns the port
    /** The clients connect to \c "localhost", to verify the certificate's host name, and to \c "127.0.0.1": a
        listener on only one loopback address would leave a client of \c "localhost" to the address in the other
        family, where a test running beside this one can listen on the same port number (qore#7469).  The port that
        the system assigns on \c 127.0.0.1 can be in use on \c ::1 (by TCP or by the UDP socket of the paired QUIC
        listener), in which case another port is taken.  Without an IPv6 loopback address, the listener is only on
        \c 127.0.0.1.
    */
    private int addLoopbackListener(hash<HttpListenerOptionInfo> opts) {
        for (int attempt = 1; ; ++attempt) {
            hash<HttpListenerOptionInfo> v4_opts = opts;
            v4_opts.node = "127.0.0.1";
            v4_opts.service = 0;
            hash<auto> v4 = server.addListener(v4_opts);
            if (!hasIpv6Loopback()) {
                return v4.port;
            }
            try {
                hash<HttpListenerOptionInfo> v6_opts = opts;
                v6_opts.node = "::1";
                v6_opts.service = v4.port;
                server.addListener(v6_opts);
            } catch (hash<ExceptionInfo> ex) {
                # the port is in use on the IPv6 loopback address: another port is taken
                server.stopListenerID(v4.id);
                if (attempt == 20) {
                    rethrow;
                }
                continue;
            }
            return v4.port;
        }
    }

    #! Returns True if the IPv6 loopback address can be bound
    private static bool hasIpv6Loopback() {
        Socket s();
        on_exit s.close();
        try {
            s.bindINET("::1", 0, False, AF_INET6);
        } catch (hash<ExceptionInfo> ex) {
            return False;
        }
        return True;
    }

    #! A TCP connection to the port of a QUIC listener is refused, and does not wait for its timeout (qore#6347)
    /** The race tests expect the HTTP/2 leg of a race to the port of a QUIC listener to fail with
        SOCKET-CONNECT-ERROR; a port that drops connection requests (a socket that is bound but does not listen, on
        macOS) leaves it to its connect timeout instead.  The timeout of the connections here is longer than any
        refusal takes, so only a dropped connection request reaches it.
    */
    quicPortTcpRefusedTest() {
        list<string> hosts = ("127.0.0.1",);
        if (quic_tcp_v6_held) {
            hosts += "::1";
        }
        foreach int port in ((quic_good_port, quic_wrong_port)) {
            foreach string host in (hosts) {
                string target = host =~ /:/ ? sprintf("[%s]:%d", host, port) : sprintf("%s:%d", host, port);
                Socket s();
                assertThrows("SOCKET-CONNECT-ERROR", \s.connect(), (target, 30s),
                    sprintf("a connection to %s is refused", target));
            }
        }
    }

    #! Adds a QUIC listener on a port whose TCP side is held by a connection, and returns the port
    /** The race tests rely on a TCP connection to the port of a QUIC listener being refused at once.  A free TCP port
        is not enough: tests running beside this one can listen on it.  A socket that is bound but does not listen is
        not enough either: macOS drops a connection request to such a socket instead of refusing it, so the client
        waits for its connect timeout (qore#6347).  The port is bound without \c SO_REUSEADDR on the wildcard address
        (dual-stack), a connection is made to it over IPv4 and, if the host has an IPv6 loopback, one over IPv6, and the
        listening socket is closed once they are accepted: the connections hold the port, so no other socket can bind
        it (an IPv4 connection holds only the IPv4 side of the port: without the IPv6 one, an IPv6 socket could bind
        it), and a connection request to it finds no listening socket and is refused at once, on macOS as on Linux.
        The QUIC listener then takes the same port number for UDP, on \c 0.0.0.0 and, if the host has an IPv6
        loopback, on \c ::1, which can be in use, in which case another port is taken.
    */
    private int addQuicListener(hash<HttpListenerOptionInfo> opts) {
        for (int attempt = 1; ; ++attempt) {
            # a dual-stack socket on the wildcard address: no IPv4 or IPv6 socket can bind the port
            Socket listener();
            if (listener.bind(0, False)) {  # all-interfaces: the wildcard bind holds the port for IPv4 and IPv6 clients
                throw "BIND-ERROR", strerror();
            }
            int port = listener.getSocketInfo().port;
            if (listener.listen(2)) {
                throw "LISTEN-ERROR", strerror();
            }
            # the connections that hold the port; the listening socket is closed once they are accepted
            list<Socket> holds = ();
            foreach string target in ((sprintf("127.0.0.1:%d", port), sprintf("[::1]:%d", port))) {
                Socket client();
                try {
                    client.connect(target, 30s);
                } catch (hash<ExceptionInfo> ex) {
                    # no IPv6 loopback: only the IPv4 side of the port is held, and only it is checked
                    if (target =~ /^\[/) {
                        quic_tcp_v6_held = False;
                        break;
                    }
                    rethrow;
                }
                *Socket server_end = listener.accept(30s);
                if (!server_end) {
                    throw "ACCEPT-ERROR", sprintf("the connection to %s that holds the TCP port was not accepted",
                        target);
                }
                holds += (client, server_end);
            }
            listener.close();
            try {
                hash<auto> v4 = server.addQuicListener(opts, port);
                # a client of "localhost" can try the IPv6 loopback address first: the QUIC listener receives there
                # too, so that it reaches no listener of a test running beside this one (qore#7469)
                if (quic_tcp_v6_held) {
                    try {
                        server.addQuicListener(opts + <HttpListenerOptionInfo>{"node": "::1"}, port);
                    } catch (hash<ExceptionInfo> ex) {
                        server.stopListenerID(v4.id);
                        rethrow;
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                # the UDP port is in use: another port is taken
                if (attempt == 20) {
                    rethrow;
                }
                continue;
            }
            quic_tcp_holds += holds;
            return port;
        }
    }

    globalTearDown() {
        unsetenv("QORE_QUIC_TEST_ECONNREFUSED_GRACE_MS");
        if (server) {
            server.stop();
        }
        delete tmp;
    }

    socketTest() {
        # the default CAs do not include the test CA
        Socket s();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        try {
            s.connectSSL("localhost:" + good_port, 10s);
            fail("the private CA must not be trusted by default");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SOCKET-SSL-ERROR", ex.err);
            assertEq(NT_INT, ex.arg.ssl_verify_error.typeCode());
            assertGt(0, ex.arg.ssl_verify_error);
        }

        # a CA file
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(ca_file);
        s.connectSSL("localhost:" + good_port, 10s);
        assertEq("X509_V_OK", s.verifyPeerCertificate());
        s.close();

        # a CA directory
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(NOTHING, ca_dir);
        s.connectSSL("localhost:" + good_port, 10s);
        s.close();

        # a certificate issued by the CA for another host is rejected
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(ca_file);
        assertThrows("SOCKET-SSL-ERROR", \s.connectSSL(), ("localhost:" + wrong_port, 10s));

        # ... unless all certificates are accepted
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(ca_file);
        s.acceptAllCertificates();
        s.connectSSL("localhost:" + wrong_port, 10s);
        s.close();

        # CA locations that cannot be loaded are an error
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(tmp.path + "/no-such-file.pem");
        assertThrows("SOCKET-SSL-ERROR", \s.connectSSL(), ("localhost:" + good_port, 10s));

        # clearing the CA locations restores the default CAs
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(ca_file);
        s.setSslCaLocations();
        assertThrows("SOCKET-SSL-ERROR", \s.connectSSL(), ("localhost:" + good_port, 10s));
    }

    httpClientTest() {
        foreach string version in (TcpVersions) {
            string msg = "HTTP " + version;
            # not trusted by the default CAs
            HTTPClient hc({"url": "https://localhost:" + good_port, "http_version": version,
                "ssl_verify_cert": True, "timeout": 10s});
            assertThrows("SOCKET-SSL-ERROR", \hc.get(), "/", msg + " (default CAs)");

            # trusted with the CA file or directory
            foreach hash<auto> opt in ({"ssl_ca_file": ca_file}, {"ssl_ca_path": ca_dir}) {
                hc = new HTTPClient({"url": "https://localhost:" + good_port, "http_version": version,
                    "ssl_verify_cert": True, "timeout": 10s} + opt);
                assertEq("verified", hc.get("/"), msg + sprintf(" %y", opt));
            }

            # the CA locations are serialized with the client
            HTTPClient hc2 = Serializable::deserialize(hc.serialize());
            assertEq("verified", hc2.get("/"), msg + " (deserialized)");

            # a certificate issued for another host is rejected
            hc = new HTTPClient({"url": "https://localhost:" + wrong_port, "http_version": version,
                "ssl_verify_cert": True, "ssl_ca_file": ca_file, "timeout": 10s});
            assertThrows("SOCKET-SSL-ERROR", \hc.get(), "/", msg + " (wrong host)");

            # setting the CA locations on an existing client applies to new connections
            hc = new HTTPClient({"url": "https://localhost:" + good_port, "http_version": version,
                "ssl_verify_cert": True, "timeout": 10s});
            hc.setSslCaLocations(ca_file);
            assertEq("verified", hc.get("/"), msg + " (setSslCaLocations())");
        }
    }

    http3Test() {
        string url = "https://localhost:" + quic_good_port;
        HTTPClient hc({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "timeout": 10s});
        assertRejected(\hc.get(), "/", "HTTP/3 default CAs");

        hc = new HTTPClient({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "ssl_ca_file": ca_file,
            "timeout": 10s});
        assertEq("verified", hc.get("/"));

        # the host name is verified
        url = "https://localhost:" + quic_wrong_port;
        hc = new HTTPClient({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "ssl_ca_file": ca_file,
            "timeout": 10s});
        assertRejected(\hc.get(), "/", "HTTP/3 wrong host");

        # all certificates are accepted if requested
        hc = new HTTPClient({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "ssl_ca_file": ca_file,
            "timeout": 10s});
        hc.acceptAllCertificates();
        assertEq("verified", hc.get("/"));
    }

    #! A QUIC connection survives the clock going back while it is open
    /** ngtcp2 aborts the process when a connection is given a timestamp earlier than one it has
        already seen.  On macOS this happened when the clock used for QUIC timestamps stepped
        back along with the wall clock.  The DEBUG-only \c QORE_QUIC_TEST_CLOCK_STEP_BACK_MS hook
        starts each new connection (client and server side) that far ahead of the clock, which is
        the state a connection is in right after such a step, so every ngtcp2 call that follows
        sees an earlier time than the connection's last one.
    */
    http3ClockStepBackTest() {
        if (!inlist("debug", get_feature_list())) {
            testSkip("the QUIC clock step-back hook requires a debug library build");
        }
        setenv("QORE_QUIC_TEST_CLOCK_STEP_BACK_MS", "200");
        on_exit unsetenv("QORE_QUIC_TEST_CLOCK_STEP_BACK_MS");

        HTTPClient hc({"url": "https://localhost:" + quic_good_port, "http_version": "3.0",
            "ssl_verify_cert": True, "ssl_ca_file": ca_file, "timeout": 10s});
        on_exit hc.disconnect();
        assertEq("verified", hc.get("/"));
        # a second request on the same connection, after the handshake, also goes through
        assertEq("verified", hc.get("/"));
        # a rejected certificate closes the connection from the same skewed state
        hc = new HTTPClient({"url": "https://localhost:" + quic_wrong_port, "http_version": "3.0",
            "ssl_verify_cert": True, "ssl_ca_file": ca_file, "timeout": 10s});
        assertRejected(\hc.get(), "/", "HTTP/3 wrong host after a clock step back");
    }

    #! A session resumed with a ticket is not verified again, so a ticket must not be used with another trust configuration
    http3TicketTest() {
        string url = "https://localhost:" + quic_wrong_port;
        # a client that accepts all certificates connects and receives a session ticket
        for (int i = 0; i < 2; ++i) {
            HTTPClient hc({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "timeout": 10s});
            hc.acceptAllCertificates();
            assertEq("verified", hc.get("/"));
            hc.disconnect();
        }
        # a verifying client to the same origin must not resume that session
        HTTPClient hc({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "ssl_ca_file": ca_file,
            "timeout": 10s});
        assertRejected(\hc.get(), "/", "HTTP/3 no resumption across trust configurations");
    }

    httpClientIoTest() {
        # protocol -> port
        hash<string, int> targets = {
            "h1": good_port,
            "h2": good_port,
            "h3": quic_good_port,
        };
        foreach hash<auto> i in (targets.pairIterator()) {
            string url = sprintf("https://localhost:%d", i.value);
            string msg = "HttpClientIo " + i.key;
            # not trusted by the default CAs
            {
                HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
                    "protocol": i.key,
                    "ssl_verify_mode": SSL_VERIFY_PEER,
                });
                on_exit mgr.closeAll();
                assertRejected(\mgr.request(), (url, "GET", "/"), msg + " (default CAs)");
            }
            foreach hash<auto> opt in ({"ssl_ca_file": ca_file}, {"ssl_ca_path": ca_dir}) {
                HttpClientIo::HttpClientConnectionManager mgr(cast<hash<HttpClientIo::HttpClientConnectionManagerOptions>>(
                    {"protocol": i.key, "ssl_verify_mode": SSL_VERIFY_PEER} + opt));
                on_exit mgr.closeAll();
                hash<auto> resp = mgr.request(url, "GET", "/");
                assertEq(200, resp.status_code, msg + sprintf(" %y", opt));
                assertEq("verified", resp.body, msg + sprintf(" %y", opt));
            }
        }
    }

    restClientIoTest() {
        # the options of HTTPClient and RestClient configure the connection manager of RestClientIo
        hash<string, int> targets = {
            "h1": good_port,
            "h2": good_port,
            "h3": quic_good_port,
        };
        foreach hash<auto> i in (targets.pairIterator()) {
            string url = sprintf("https://localhost:%d", i.value);
            string msg = "RestClientIo " + i.key;
            # not trusted by the default CAs
            {
                RestClientIo rest({"url": url, "protocol": i.key, "ssl_verify_cert": True, "data": "text"});
                on_exit rest.close();
                assertRejected(\rest.restGet(), "/", msg + " (default CAs)");
            }
            foreach hash<auto> opt in ({"ssl_ca_file": ca_file}, {"ssl_ca_path": ca_dir}) {
                RestClientIo rest({"url": url, "protocol": i.key, "ssl_verify_cert": True, "data": "text"} + opt);
                on_exit rest.close();
                hash<RestResponseInfo> resp = rest.restGet("/");
                assertEq(200, resp.status_code, msg + sprintf(" %y", opt));
                assertEq("verified", resp.body, msg + sprintf(" %y", opt));
            }
        }
        # HTTP/3 disabled: the TCP listener is used
        RestClientIo rest({"url": sprintf("https://localhost:%d", good_port), "ssl_verify_cert": True,
            "ssl_ca_file": ca_file, "enable_http3": False, "data": "text"});
        on_exit rest.close();
        hash<RestResponseInfo> resp = rest.restGet("/");
        assertEq(200, resp.status_code);
        assertNeq("h3", resp.protocol);
    }

    #! A refused TLS handshake must end the call, even if a second connection would never answer
    certificateFailureTest() {
        foreach string protocol in ("auto", "h1", "h2") {
            foreach string host in ("localhost", "127.0.0.1") {
                foreach bool trusted in (False, True) {
                    foreach string api in ("REST", "REST async", "HTTP", "HTTP async") {
                        singleCertificateFailure(protocol, host, trusted, api);
                    }
                }
            }
        }
    }

    private singleCertificateFailure(string protocol, string host, bool trusted, string api) {
        string msg = sprintf("%s %s trusted=%y %s", protocol, host, trusted, api);
        # the listener is bound to the host that the client connects to: a socket bound to "localhost" holds its
        # port on the name's addresses in the other address family, so that the client reaches no other listener
        Socket listener();
        listener.bind(host + ":0");
        listener.listen();
        listener.setCertificate(trusted ? WrongHostCert : GoodCert);
        listener.setPrivateKey(trusted ? WrongHostKey : GoodKey);
        Counter finished(1);
        background acceptRejectedCertificate(listener, finished);
        on_exit {
            listener.close();
            finished.waitForZero(15s);
        }
        string url = sprintf("https://%s:%d", host, listener.getSocketInfo().port);
        RestClientIo rest({
            "url": url,
            "protocol": protocol,
            "ssl_verify_cert": True,
            "ssl_ca_file": trusted ? ca_file : NOTHING,
            "enable_http3": False,
            "connect_timeout": 10s,
            "timeout": 20s,
            "data": "text",
        });
        on_exit rest.close();
        HttpClientIo::HttpClientConnectionManager mgr = rest.getConnectionManager();
        date started = microseconds(clock_get_monotonic_us());
        try {
            switch (api) {
                case "REST":
                    rest.restGet("/");
                    break;
                case "REST async":
                    rest.restGetAsync("/").get(25s);
                    break;
                case "HTTP":
                    mgr.request(url, "GET", "/");
                    break;
                case "HTTP async":
                    mgr.requestAsync(url, "GET", "/").get(25s);
                    break;
            }
            fail(msg + ": no exception raised");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SOCKET-SSL-ERROR", ex.err, msg);
            assertEq(NT_INT, ex.arg.arg.ssl_verify_error.typeCode(), msg);
            assertGt(0, ex.arg.arg.ssl_verify_error, msg);
            assertRegex("certificate verify failed", ex.desc, msg);
            assertRegex(trusted ? (host == "localhost" ? "hostname mismatch" : "IP address mismatch")
                : "unable to get local issuer certificate", ex.desc, msg);
            assertLt(5000, (microseconds(clock_get_monotonic_us()) - started).durationMilliseconds(),
                msg + ": prompt refusal");
        }
        # The rejected first handshake was the only TCP connection, regardless of the default retry budget.
        finished.waitForZero(15s);
        *Socket retry = listener.accept(1ms);
        if (retry) {
            retry.close();
        }
        assertNothing(retry, msg + ": no second connection");
    }

    private acceptRejectedCertificate(Socket listener, Counter finished) {
        on_exit finished.dec();
        try {
            *Socket peer = listener.acceptSSL(10s);
            if (peer) {
                peer.close();
            }
        } catch (hash<ExceptionInfo> ex) {
            # Leave the listener open, but do not answer a second handshake. A retry must not hide the TLS error.
        }
    }

    #! A refused server certificate ends an HTTP/3 call as it does over TCP: with the original TLS error, no retry
    http3CertificateFailureTest() {
        foreach string host in ("localhost", "127.0.0.1") {
            foreach bool trusted in (False, True) {
                foreach string api in (Apis) {
                    singleHttp3CertificateFailure(host, trusted, api);
                }
            }
        }
    }

    private singleHttp3CertificateFailure(string host, bool trusted, string api) {
        string msg = sprintf("h3 %s trusted=%y %s", host, trusted, api);
        # the certificate of the listener is not issued by a default CA; with the test CA trusted, the listener with
        # the certificate issued for another host is used
        string url = sprintf("https://%s:%d", host, trusted ? quic_wrong_port : quic_good_port);
        RecordingManager mgr = http3Manager(trusted ? {"ssl_ca_file": ca_file} : NOTHING);
        on_exit mgr.closeAll();
        try {
            http3Get(mgr, url, api);
            fail(msg + ": no exception raised");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SOCKET-SSL-ERROR", ex.err, msg + ": " + ex.desc);
            # the error of the connection is the argument, as for a refused certificate over TCP
            assertEq("SOCKET-SSL-ERROR", ex.arg.err, msg);
            assertEq(NT_INT, ex.arg.arg.ssl_verify_error.typeCode(), msg);
            assertGt(0, ex.arg.arg.ssl_verify_error, msg);
            assertRegex("certificate verify failed", ex.desc, msg);
            assertRegex(trusted ? (host == "localhost" ? "hostname mismatch" : "IP address mismatch")
                : "unable to get local issuer certificate", ex.desc, msg);
        }
        # A host name can resolve to an address in another family first, where nothing receives datagrams; that
        # attempt does not reach the server and is followed by one in the next family. The refused certificate must be
        # the last connection: it is not retried.
        list<HttpClientIo::HttpClientConnection> conns = mgr.getConnections();
        list<HttpClientIo::HttpClientConnection> refused = select conns,
            $1.getPollOperation().getError().arg.ssl_verify_error;
        assertEq(1, refused.size(), msg + ": one certificate refusal");
        assertTrue(refused[0] == conns.last(), msg + ": no connection after the certificate refusal");
    }

    #! A client that accepts all certificates connects over HTTP/3 to a listener whose certificate fails verification
    http3AcceptAllTest() {
        foreach string api in (Apis) {
            RecordingManager mgr = http3Manager({"accept_all_certs": True});
            on_exit mgr.closeAll();
            assertEq("verified", http3Get(mgr, sprintf("https://127.0.0.1:%d", quic_wrong_port), api), api);
            assertEq(1, mgr.getConnections().size(), api);
        }
    }

    #! An HTTP/3 connection failure that is not a TLS error remains a connection error that is retried
    /** Nothing receives datagrams on the port, so each attempt fails without reaching a server: by the ICMP "port
        unreachable" (after the grace period, which the DEBUG-only hook sets to 0), or by the handshake timeout when
        the attempt does not end by the refusal before the connect timeout, as on a busy host (qore#6519); either is
        a connection error, and the number of connections, with and without a retry, shows that it is retried.  The
        request timeout leaves room for two handshake timeouts.
    */
    http3ConnectFailureTest() {
        # the system refuses the datagrams on this port, which the test holds (issue #6461)
        RefusedUdpPort refused();
        on_exit refused.close();
        string url = sprintf("https://127.0.0.1:%d", refused.port);
        foreach string api in (Apis) {
            foreach int retries in (0, 1) {
                string msg = sprintf("%s retries=%d", api, retries);
                RecordingManager mgr = http3Manager({"accept_all_certs": True, "connect_timeout": 5s,
                    "request_timeout": 30s, "max_request_retries": retries});
                on_exit mgr.closeAll();
                try {
                    http3Get(mgr, url, api);
                    fail(msg + ": no exception raised");
                } catch (hash<ExceptionInfo> ex) {
                    assertEq("HTTPCLIENT-CONNECT-ERROR", ex.err, msg + ": " + ex.desc);
                    # an error of a connection that never reached a server
                    assertTrue(HttpClientIo::HttpClientConnectionManager::H3UnreachedErrors{ex.arg.err},
                        msg + ": " + ex.desc);
                    if (ex.arg.err == "QUIC-CONNECT-REFUSED" && inlist("debug", get_feature_list())) {
                        # the refusal ended the attempt after the grace period set by the test hook
                        assertRegex("did not recover within 0 ms", ex.desc, msg + ": " + ex.desc);
                    }
                }
                # each attempt is a connection of its own
                assertEq(retries + 1, mgr.getConnections().size(), msg);
            }
        }
    }

    #! With automatic protocol selection, a refused certificate ends the race of HTTP/3 and HTTP/2 without a retry
    /** The TLS listeners also receive HTTP/3 on their ports, on both loopback addresses; the certificate refusal is
        reported whichever protocol fails first.
    */
    raceCertificateFailureTest() {
        foreach bool trusted in (False, True) {
            foreach string api in (Apis) {
                foreach string host in ("localhost", "127.0.0.1") {
                    singleRaceCertificateFailure(host, trusted ? wrong_port : good_port, trusted, api);
                }
                # nothing accepts TCP connections on the port of a QUIC listener: HTTP/2 fails with a connection
                # error, and the certificate refusal of HTTP/3 is reported, whichever fails first (the race waits for
                # both protocols' outcomes)
                singleRaceCertificateFailure("127.0.0.1", trusted ? quic_wrong_port : quic_good_port, trusted, api,
                    "SOCKET-CONNECT-ERROR");
            }
        }
    }

    #! Tests a race of HTTP/3 and HTTP/2 to a server whose certificate is refused
    /** @param host the host name of the server
        @param port the port of the server
        @param trusted if the test CA is trusted, so that the certificate is refused for another reason
        @param api the client API to use
        @param h2_err the error of the HTTP/2 connection if it does not reach the server
    */
    private singleRaceCertificateFailure(string host, int port, bool trusted, string api, *string h2_err) {
        string msg = sprintf("auto %s:%d trusted=%y %s", host, port, trusted, api);
        string url = sprintf("https://%s:%d", host, port);
        RecordingManager mgr(cast<hash<HttpClientIo::HttpClientConnectionManagerOptions>>({
            "protocol": "auto",
            "enable_http3": True,
            "ssl_verify_mode": SSL_VERIFY_PEER,
            "connect_timeout": 10s,
            "request_timeout": 20s,
            "max_request_retries": 2,
        } + (trusted ? {"ssl_ca_file": ca_file} : NOTHING)));
        on_exit mgr.closeAll();
        try {
            http3Get(mgr, url, api);
            fail(msg + ": no exception raised");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SOCKET-SSL-ERROR", ex.err, msg + ": " + ex.desc);
            assertEq("SOCKET-SSL-ERROR", ex.arg.err, msg);
            assertEq(NT_INT, ex.arg.arg.ssl_verify_error.typeCode(), msg);
            assertGt(0, ex.arg.arg.ssl_verify_error, msg);
            assertRegex("certificate verify failed", ex.desc, msg);
            assertRegex(trusted ? (host == "localhost" ? "hostname mismatch" : "IP address mismatch")
                : "unable to get local issuer certificate", ex.desc, msg);
        }
        list<HttpClientIo::HttpClientConnection> conns = mgr.getConnections();
        # each protocol was tried once: the race was not run again
        assertEq(("h2", "h3"), sort(map $1.getProtocol(), conns), msg + ": one race");
        if (h2_err) {
            assertEq(h2_err, (select conns, $1.getProtocol() == "h2")[0].getPollOperation().getError().err, msg);
        }
    }

    #! Returns a connection manager that forces HTTP/3 and verifies the server certificate
    private RecordingManager http3Manager(*hash<auto> opts) {
        return new RecordingManager(cast<hash<HttpClientIo::HttpClientConnectionManagerOptions>>({
            "protocol": "h3",
            "ssl_verify_mode": SSL_VERIFY_PEER,
            "connect_timeout": 10s,
            "request_timeout": 20s,
            "max_request_retries": 2,
        } + opts));
    }

    #! Makes a GET request for "/" with the given API and returns the response body
    private auto http3Get(RecordingManager mgr, string url, string api) {
        switch (api) {
            case "REST": {
                RestClientIo rest({"url": url, "data": "text"}, mgr);
                on_exit rest.close();
                return rest.restGet("/").body;
            }
            case "REST async": {
                RestClientIo rest({"url": url, "data": "text"}, mgr);
                on_exit rest.close();
                return rest.restGetAsync("/").get(35s).body;
            }
            case "HTTP":
                return mgr.request(url, "GET", "/").body;
            case "HTTP async":
                return mgr.requestAsync(url, "GET", "/").get(35s).body;
        }
        throw "TEST-ERROR", sprintf("unknown API %y", api);
    }

    optionErrorTest() {
        assertThrows("HTTP-CLIENT-OPTION-ERROR", sub () {
            HTTPClient hc({"url": "https://localhost", "ssl_ca_file": 1});
        });
        assertThrows("HTTP-CLIENT-OPTION-ERROR", sub () {
            HTTPClient hc({"url": "https://localhost", "ssl_ca_path": True});
        });
    }

    #! asserts that the call fails because the server certificate is rejected
    /** the TLS error is raised as it is over TCP, whatever the protocol */
    private assertRejected(code c, auto args, string msg) {
        try {
            call_function_args(c, args);
            fail(msg + ": no exception raised");
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("%s: %s: %s\n", msg, ex.err, ex.desc);
            }
            assertEq("SOCKET-SSL-ERROR", ex.err, msg + ": " + ex.desc);
            assertRegex("certificate verify failed", ex.desc, msg + ": " + ex.err);
        }
    }
}
