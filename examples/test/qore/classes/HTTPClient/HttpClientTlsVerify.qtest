        #! the subject name hash of CaCert, which names it in a CA directory
        const CaHash = "86453cfa";

        #! HTTP versions tested over TCP
        const TcpVersions = ("1.1", "2.0", "auto");
    }

    private {
        TmpDir tmp;
        string ca_file;
        string ca_dir;
        HttpServer server;
        #! TLS listener with a certificate for localhost and 127.0.0.1
        int good_port;
        #! TLS listener with a certificate for another host
        int wrong_port;
        #! QUIC listeners
        int quic_good_port;
        int quic_wrong_port;
    }

    constructor() : Test("HttpClientTlsVerifyTest", "1.0") {
        addTestCase("Socket CA locations", \socketTest());
        addTestCase("HTTPClient CA options", \httpClientTest());
        addTestCase("HTTPClient CA with HTTP/3", \http3Test());
        addTestCase("HTTP/3 session tickets", \http3TicketTest());
        addTestCase("HttpClientIo CA options", \httpClientIoTest());
        addTestCase("HTTPClient option errors", \optionErrorTest());
        set_return_value(main());
    }

    globalSetUp() {
        tmp = new TmpDir("tls-verify-");
        ca_file = tmp.path + "/ca.pem";
        File f();
        f.open2(ca_file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(CaCert + "\n");
        ca_dir = tmp.path + "/ca-dir";
        mkdir(ca_dir);
        f = new File();
        f.open2(ca_dir + "/" + CaHash + ".0", O_CREAT | O_WRONLY | O_TRUNC);
        f.write(CaCert + "\n");

        Logger logger("tls-verify", LoggerLevel::getLevelInfo());
        server = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        server.setDefaultHandler("tls", new TlsVerifyHandler());
        good_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(GoodCert),
            "key": new SSLPrivateKey(GoodKey),
        }).port;
        wrong_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(WrongHostCert),
            "key": new SSLPrivateKey(WrongHostKey),
        }).port;
        server.waitForAsyncIo();
        quic_good_port = server.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(GoodCert),
            "key": new SSLPrivateKey(GoodKey),
        }).port;
        quic_wrong_port = server.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(WrongHostCert),
            "key": new SSLPrivateKey(WrongHostKey),
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        if (server) {
            server.stop();
        }
        delete tmp;
    }

    socketTest() {
        # the default CAs do not include the test CA
        Socket s();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        assertThrows("SOCKET-SSL-ERROR", \s.connectSSL(), ("localhost:" + good_port, 10s));

        # a CA file
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(ca_file);
        s.connectSSL("localhost:" + good_port, 10s);
        assertEq("X509_V_OK", s.verifyPeerCertificate());
        s.close();

        # a CA directory
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(NOTHING, ca_dir);
        s.connectSSL("localhost:" + good_port, 10s);
        s.close();

        # a certificate issued by the CA for another host is rejected
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(ca_file);
        assertThrows("SOCKET-SSL-ERROR", \s.connectSSL(), ("localhost:" + wrong_port, 10s));

        # ... unless all certificates are accepted
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(ca_file);
        s.acceptAllCertificates();
        s.connectSSL("localhost:" + wrong_port, 10s);
        s.close();

        # CA locations that cannot be loaded are an error
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(tmp.path + "/no-such-file.pem");
        assertThrows("SOCKET-SSL-ERROR", \s.connectSSL(), ("localhost:" + good_port, 10s));

        # clearing the CA locations restores the default CAs
        s = new Socket();
        s.setSslVerifyMode(SSL_VERIFY_PEER);
        s.setSslCaLocations(ca_file);
        s.setSslCaLocations();
        assertThrows("SOCKET-SSL-ERROR", \s.connectSSL(), ("localhost:" + good_port, 10s));
    }

    httpClientTest() {
        foreach string version in (TcpVersions) {
            string msg = "HTTP " + version;
            # not trusted by the default CAs
            HTTPClient hc({"url": "https://localhost:" + good_port, "http_version": version,
                "ssl_verify_cert": True, "timeout": 10s});
            assertThrows("SOCKET-SSL-ERROR", \hc.get(), "/", msg + " (default CAs)");

            # trusted with the CA file or directory
            foreach hash<auto> opt in ({"ssl_ca_file": ca_file}, {"ssl_ca_path": ca_dir}) {
                hc = new HTTPClient({"url": "https://localhost:" + good_port, "http_version": version,
                    "ssl_verify_cert": True, "timeout": 10s} + opt);
                assertEq("verified", hc.get("/"), msg + sprintf(" %y", opt));
            }

            # the CA locations are serialized with the client
            HTTPClient hc2 = Serializable::deserialize(hc.serialize());
            assertEq("verified", hc2.get("/"), msg + " (deserialized)");

            # a certificate issued for another host is rejected
            hc = new HTTPClient({"url": "https://localhost:" + wrong_port, "http_version": version,
                "ssl_verify_cert": True, "ssl_ca_file": ca_file, "timeout": 10s});
            assertThrows("SOCKET-SSL-ERROR", \hc.get(), "/", msg + " (wrong host)");

            # setting the CA locations on an existing client applies to new connections
            hc = new HTTPClient({"url": "https://localhost:" + good_port, "http_version": version,
                "ssl_verify_cert": True, "timeout": 10s});
            hc.setSslCaLocations(ca_file);
            assertEq("verified", hc.get("/"), msg + " (setSslCaLocations())");
        }
    }

    http3Test() {
        string url = "https://localhost:" + quic_good_port;
        HTTPClient hc({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "timeout": 10s});
        assertRejected(\hc.get(), "/", "HTTP/3 default CAs");

        hc = new HTTPClient({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "ssl_ca_file": ca_file,
            "timeout": 10s});
        assertEq("verified", hc.get("/"));

        # the host name is verified
        url = "https://localhost:" + quic_wrong_port;
        hc = new HTTPClient({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "ssl_ca_file": ca_file,
            "timeout": 10s});
        assertRejected(\hc.get(), "/", "HTTP/3 wrong host");

        # all certificates are accepted if requested
        hc = new HTTPClient({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "ssl_ca_file": ca_file,
            "timeout": 10s});
        hc.acceptAllCertificates();
        assertEq("verified", hc.get("/"));
    }

    #! A session resumed with a ticket is not verified again, so a ticket must not be used with another trust configuration
    http3TicketTest() {
        string url = "https://localhost:" + quic_wrong_port;
        # a client that accepts all certificates connects and receives a session ticket
        for (int i = 0; i < 2; ++i) {
            HTTPClient hc({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "timeout": 10s});
            hc.acceptAllCertificates();
            assertEq("verified", hc.get("/"));
            hc.disconnect();
        }
        # a verifying client to the same origin must not resume that session
        HTTPClient hc({"url": url, "http_version": "3.0", "ssl_verify_cert": True, "ssl_ca_file": ca_file,
            "timeout": 10s});
        assertRejected(\hc.get(), "/", "HTTP/3 no resumption across trust configurations");
    }

    httpClientIoTest() {
        # protocol -> port
        hash<string, int> targets = {
            "h1": good_port,
            "h2": good_port,
            "h3": quic_good_port,
        };
        foreach hash<auto> i in (targets.pairIterator()) {
            # the HTTP/3 listener is IPv4 only
            string url = sprintf("https://%s:%d", i.key == "h3" ? "127.0.0.1" : "localhost", i.value);
            string msg = "HttpClientIo " + i.key;
            # not trusted by the default CAs
            {
                HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
                    "protocol": i.key,
                    "ssl_verify_mode": SSL_VERIFY_PEER,
                });
                on_exit mgr.closeAll();
                assertRejected(\mgr.request(), (url, "GET", "/"), msg + " (default CAs)");
            }
            foreach hash<auto> opt in ({"ssl_ca_file": ca_file}, {"ssl_ca_path": ca_dir}) {
                HttpClientIo::HttpClientConnectionManager mgr(cast<hash<HttpClientIo::HttpClientConnectionManagerOptions>>(
                    {"protocol": i.key, "ssl_verify_mode": SSL_VERIFY_PEER} + opt));
                on_exit mgr.closeAll();
                hash<auto> resp = mgr.request(url, "GET", "/");
                assertEq(200, resp.status_code, msg + sprintf(" %y", opt));
                assertEq("verified", resp.body, msg + sprintf(" %y", opt));
            }
        }
    }

    optionErrorTest() {
        assertThrows("HTTP-CLIENT-OPTION-ERROR", sub () {
            HTTPClient hc({"url": "https://localhost", "ssl_ca_file": 1});
        });
        assertThrows("HTTP-CLIENT-OPTION-ERROR", sub () {
            HTTPClient hc({"url": "https://localhost", "ssl_ca_path": True});
        });
    }

    #! asserts that the call fails because the server certificate is rejected
    private assertRejected(code c, auto args, string msg) {
        try {
            call_function_args(c, args);
            fail(msg + ": no exception raised");
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("%s: %s: %s\n", msg, ex.err, ex.desc);
            }
            assertRegex("certificate verify failed", ex.desc, msg + ": " + ex.err);
        }
    }
}
