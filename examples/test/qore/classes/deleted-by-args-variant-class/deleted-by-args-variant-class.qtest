#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of the check of a call's target after its arguments

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class DeletedByArgsVariantClassTest

#! Regression test for issue #5824: the error of a call whose arguments deleted its object names the variant's class
/** The AST interpreter raises "cannot call <class>::<method>() on an object that has already been deleted" when it
    enters the code of the variant that the call resolves with its arguments, naming the class of the variant, which
    can be another class than the method's: an implementation of an abstract method in another parent class, or a
    variant of an overloaded method inherited from a parent class.  The compiled modes evaluate the arguments before
    the call; their check of the call's target after the arguments named the class of the method.

    DeletedByArgsVariantClass.q makes these calls; its output must be the one in DeletedByArgsVariantClass.expected in
    every execution mode, on the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class DeletedByArgsVariantClassTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/DeletedByArgsVariantClass.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/DeletedByArgsVariantClass.expected");
    }

    constructor() : QUnit::Test("call whose arguments delete its object", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/deleted-by-args-variant-class";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
