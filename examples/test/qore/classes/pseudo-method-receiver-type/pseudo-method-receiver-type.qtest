#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of pseudo-method calls

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class PseudoMethodReceiverTypeTest

#! Regression test for issue #7363: a pseudo-method that the parser resolved for the declared type of an expression runs
#! on a value of another type
/** A call through a call reference whose declared return type the function behind it does not honor had its
    pseudo-method resolved for the declared type and then ran it on the value, which treated the value as a value of
    its own type (a wrong result, a read of internal memory, or a crash).  The method of the name is now looked up for
    the value's own type, as it already was for nothing, and the usual exception is raised if there is none; a value of
    the declared type still runs the method resolved at parse time.

    PseudoMethodReceiverType.q runs each case in a child; its output must be the one in
    PseudoMethodReceiverType.expected in every execution mode, on the IR tier and in programs compiled with qcc -O0
    and -O3.
*/
class PseudoMethodReceiverTypeTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/PseudoMethodReceiverType.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/PseudoMethodReceiverType.expected");
    }

    constructor() : QUnit::Test("pseudo-method on a value of another type than the parser assumed", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/pseudo-method-receiver-type";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
