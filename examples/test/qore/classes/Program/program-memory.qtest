#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class ProgramMemoryTest

class ProgramMemoryImportedBaseClass {
}

class ProgramMemoryImportedClass inherits ProgramMemoryImportedBaseClass {
    int get() {
        return 1;
    }
}

class ProgramMemoryImportedArgClass {
    private {
        int i;
    }

    constructor(int i) {
        self.i = i;
    }

    int get() {
        return i;
    }
}

class ProgramMemoryTest inherits QUnit::Test {
    constructor() : QUnit::Test("ProgramMemoryTest", "1.0", \ARGV) {
        addTestCase("child Program class handles are reclaimed", \classHandleReclamationTest());
        addTestCase("objects outliving their Program release class handles",
            \objectClassHandleReclamationTest());
        addTestCase("AOT module imports reclaim per-Program init state",
            \aotModuleProgramReclamationTest());
        addTestCase("imported classes can be used as base classes with constructor arguments",
            \importedBaseClassConstructorArgTest());
        set_return_value(main());
    }

    classHandleReclamationTest() {
        if (!hasAllocTracking()) {
            testSkip("allocation-tracking build required for leak-byte assertion");
        }

        # Warm retained class-reference and IR call-frame capacity before measuring.
        runClassHandleCycles(200);
        call_function("stop_alloc_tracking");

        call_function("start_alloc_tracking");
        runClassHandleCycles(100);
        hash<auto> result_100 = call_function("stop_alloc_tracking");

        call_function("start_alloc_tracking");
        runClassHandleCycles(200);
        hash<auto> result_200 = call_function("stop_alloc_tracking");
        assertLe(getLiveBytes(result_100) + 1024, getLiveBytes(result_200),
            "child Program class-handle allocations must remain bounded");
    }

    #! Objects hold a reference to their class pointer and not only to the class's private data
    /** A class imported into a child Program is addressed through a wrapper owned by that Program's
        class list; the wrapper is reclaimed as soon as the last pointer reference is released.
        Objects of the class must therefore reference the wrapper, otherwise an object that outlives
        the Program that created it is left with a dangling class pointer, and destroying it
        dereferences freed memory.

        This test also verifies that the wrapper is still reclaimed once the object is destroyed
        (i.e. that the object's pointer reference is released again). */
    objectClassHandleReclamationTest() {
        if (!hasAllocTracking()) {
            testSkip("allocation-tracking build required for leak-byte assertion");
        }

        # Warm class-reference maps, parsed-code caches, and IR call frames before measuring.
        assertEq(200, runObjectClassHandleCycles(200), "warmup objects remain usable");
        call_function("stop_alloc_tracking");

        call_function("start_alloc_tracking");
        int object_count = runObjectClassHandleCycles(100);
        hash<auto> result_100 = call_function("stop_alloc_tracking");
        assertEq(100, object_count, "measured objects remain usable");

        call_function("start_alloc_tracking");
        object_count = runObjectClassHandleCycles(200);
        hash<auto> result_200 = call_function("stop_alloc_tracking");
        assertEq(200, object_count, "larger measured objects remain usable");
        assertLe(getLiveBytes(result_100) + 1024, getLiveBytes(result_200),
            "object class-handle allocations must remain bounded");
    }

    private static runClassHandleCycles(int cycles) {
        for (int i = 0; i < cycles; ++i) {
            Program pgm();
            pgm.importClass("ProgramMemoryImportedClass");
            delete pgm;
        }
    }

    private int runObjectClassHandleCycles(int cycles) {
        int object_count;
        for (int i = 0; i < cycles; ++i) {
            auto o;
            {
                Program pgm();
                pgm.importClass("ProgramMemoryImportedClass");
                pgm.parse("%new-style\nour ProgramMemoryImportedClass obj = "
                    "new ProgramMemoryImportedClass();", "test");
                pgm.run();
                # the object is created in the child Program, so its class is the child's wrapper
                o = pgm.getGlobalVariable("obj");
                object_count += o.get();
                # the child Program is destroyed while the object is still referenced here
                delete pgm;
            }
            # the object (and its class pointer reference) is released here
            delete o;
        }
        return object_count;
    }

    aotModuleProgramReclamationTest() {
        string tmp_dir = make_tmp_dir();
        on_exit remove_tree(tmp_dir);

        string qm_path = tmp_dir + "/ProgramMemoryAOT.qm";
        string qmod_path = tmp_dir + "/ProgramMemoryAOT.qmod";
        File source();
        source.open2(qm_path, O_WRONLY | O_CREAT | O_TRUNC);
        source.write("%modern
module ProgramMemoryAOT {
    version = \"1.0\";
    desc = \"Program AOT module lifetime test\";
    author = \"Qore\";
    license = \"MIT\";
    init = sub () {
        code<int(int)> increment = int sub (int value) {
            return value + 1;
        };
        ProgramMemoryAOT::InitCount = increment(ProgramMemoryAOT::InitCount ?? 0);
    };
}

public namespace ProgramMemoryAOT {
    public our int InitCount;
}
");
        source.close();

        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QCC ?? ENV.QORE_QCC
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        string compile_out = backquote(sprintf(
            "QORE_LIBDIR=%s LD_LIBRARY_PATH=%s %s -m --strip-source -o %s %s 2>&1",
            shellQuote(libqore_dir), shellQuote(libqore_dir), shellQuote(qcc_bin),
            shellQuote(qmod_path), shellQuote(qm_path)));
        assertTrue(is_file(qmod_path), "compiled AOT module: " + compile_out);
        unlink(qm_path);

        # Warm the process-wide AOT module and its shadow metadata before tracking.
        Program warmup();
        warmup.loadModule(qmod_path);
        delete warmup;

        if (!hasAllocTracking()) {
            testSkip("allocation-tracking build required for leak-byte assertion");
        }

        int init_count = runSequentialAotModuleCycles(qmod_path, 100);
        assertEq(101, init_count,
            "AOT module init markers must not outlive their Program");

        # Warm the larger loop path before measuring so that IR interpreter
        # capacity growth is not attributed to AOT module imports.
        init_count = runSequentialAotModuleCycles(qmod_path, 200);
        assertEq(301, init_count, "AOT module init must run once in every warmup Program");

        # End feature detection before measuring the allocation slope.
        call_function("stop_alloc_tracking");
        call_function("start_alloc_tracking");
        init_count = runSequentialAotModuleCycles(qmod_path, 100);
        hash<auto> result_100 = call_function("stop_alloc_tracking");
        assertEq(401, init_count, "AOT module init must run once in every Program");

        call_function("start_alloc_tracking");
        init_count = runSequentialAotModuleCycles(qmod_path, 200);
        hash<auto> result_200 = call_function("stop_alloc_tracking");
        assertEq(601, init_count, "AOT module init must run once in every Program");
        assertLe(getLiveBytes(result_100) + 1024, getLiveBytes(result_200),
            "AOT module import allocations must remain bounded as Program count grows");
    }

    #! An imported class must be usable as a base class with base class constructor arguments
    /** Base class nodes store the canonical (primary) class pointer, while base class constructor
        argument lists are resolved to the importing Program's wrapper for the same class; matching
        the two must therefore be done on the class's private data and not on the pointer */
    importedBaseClassConstructorArgTest() {
        Program pgm();
        pgm.importClass("ProgramMemoryImportedArgClass");
        pgm.parse("%new-style
class Child inherits ProgramMemoryImportedArgClass {
    constructor() : ProgramMemoryImportedArgClass(42) {
    }
}
int sub get() { return (new Child()).get(); }", "test");
        assertEq(42, pgm.callFunction("get"));
    }

    private bool hasAllocTracking() {
        try {
            call_function("start_alloc_tracking");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "NO-FUNCTION" || ex.err == "UNDEFINED-FUNCTION-CALL") {
                return False;
            }
            rethrow;
        }
        return True;
    }

    private int runSequentialAotModuleCycles(string qmod_path, int cycles) {
        int init_count;
        for (int i = 0; i < cycles; ++i) {
            Program pgm();
            pgm.loadModule(qmod_path);
            init_count = pgm.getGlobalVariable("ProgramMemoryAOT::InitCount");
            delete pgm;
        }
        return init_count;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }

    private static int getLiveBytes(hash<auto> result) {
        int live_bytes = 0;
        foreach string key in (keys result) {
            if (key != "_objects") {
                live_bytes += result{key}.leak_bytes;
            }
        }
        return live_bytes;
    }
}
