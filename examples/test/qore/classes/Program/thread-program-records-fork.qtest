#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - fork() and the fork handlers of the records of a thread's Programs

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class ThreadProgramRecordsForkTest

#! fork() while another thread changes the records of the Programs it is in can leave the child blocked or inconsistent
/** A thread records the Programs that it has data in and its thread-local data in each Program family; other threads
    use these records when they tear down a Program.  fork() waits for a change in progress, so that a child process
    gets the records consistent, and the child can tear down the Programs of the parent's other threads.

    dbg_hold_program_record_change() (debug builds) parks the next thread that reaches the change inside it, and
    dbg_fork_while_program_record_held() calls fork() meanwhile: fork() must wait until the thread has finished the
    change, and the child must be able to use and delete the Program.  A child that finds the records locked exits at
    once (98), and one that waits forever is ended, so the test cannot hang.
*/
class ThreadProgramRecordsForkTest inherits QUnit::Test {
    public {
        #! the change of a thread's records when it enters a Program for the first time (QPRS_THREAD_PROGRAMS)
        const SiteThreadPrograms = 0;
        #! the change of a thread's records when it saves its first thread-local data in a family (QPRS_THREAD_DATA)
        const SiteThreadData = 1;
        #! after a thread's first entry into a Program has been recorded (QPRS_THREAD_PROGRAMS_DONE)
        const SiteThreadProgramsDone = 6;
        #! after a Program being cleared has cleared the data of a thread in it (QPRS_THREAD_DATA_CLEARED)
        const SiteThreadDataCleared = 8;

        #! the code of the Programs that the test enters
        const ProgramCode = "
int sub add(int a, int b) {
    return a + b;
}

sub save(string key, auto value) {
    save_thread_data(key, value);
}

auto sub get(string key) {
    return get_thread_data(key);
}

# starts the given number of threads in the Program, each of which saves thread-local data, and returns the sum of
# the values that the threads computed
int sub run_threads(int n) {
    Counter c(n);
    Mutex m();
    int sum = 0;
    for (int i = 1; i <= n; ++i) {
        background sub (int v) {
            on_exit c.dec();
            save_thread_data(\"v\", v);
            int r = add(get_thread_data(\"v\"), v);
            m.lock();
            on_exit m.unlock();
            sum += r;
        }(i);
    }
    c.waitForZero();
    return sum;
}
";
    }

    constructor() : Test("ThreadProgramRecordsForkTest", "1.0") {
        addTestCase("fork() waits for a change of a thread's Programs", \programsTest());
        addTestCase("fork() waits for a change of a thread's thread-local data", \threadDataTest());
        addTestCase("a thread's entry into a Program is recorded with its references", \entryReferencesTest());
        addTestCase("a Program being cleared removes the data of a thread before releasing it",
            \clearedThreadDataTest());
        set_return_value(main());
    }

    #! fork() waits while a thread adds a Program to its records on its first entry, and the child can delete it
    /** The thread that is parked holds the lock of its records; the child deletes the Program, which removes it from
        the records of each thread that has data in it, the parked one's as well
    */
    programsTest() {
        checkAvailable();
        Program p(PO_NEW_STYLE);
        p.parse(ProgramCode, "thread-program-records");
        # threads of the parent have entered the Program before the fork: 1 + 2 + 3 doubled
        assertEq(12, p.callFunction("run_threads", 3));

        call_function("dbg_hold_program_record_change", SiteThreadPrograms, p);
        on_exit call_function("dbg_hold_program_record_change_clear");

        Counter entered(1);
        int entry_result;
        background sub () {
            on_exit entered.dec();
            entry_result = p.callFunction("add", 20, 22);
        }();

        hash<auto> r = call_function("dbg_fork_while_program_record_held", "program_thread_containers", int sub () {
            if (p.callFunction("add", 2, 3) != 5) {
                return 1;
            }
            # 1 + 2 + 3 + 4 doubled
            if (p.callFunction("run_threads", 4) != 20) {
                return 2;
            }
            # removes the Program from the records of every thread that has data in it
            delete p;
            # a new Program can be entered and deleted
            Program p2(PO_NEW_STYLE);
            p2.parse(ProgramCode, "thread-program-records-child");
            if (p2.callFunction("add", 1, 1) != 2) {
                return 3;
            }
            delete p2;
            return 0;
        });
        entered.waitForZero();

        assertTrue(r.waited, "the fork handlers were reached while the thread was inside the change");
        assertTrue(r.changed, "fork() waited until the thread had finished the change");
        assertEq(0, r.status, "the child used and deleted the Program");
        assertEq(42, entry_result, "the parked thread entered the Program and ran its code");

        # the parent can still enter the Program and run threads in it
        assertEq(6, p.callFunction("run_threads", 2));
    }

    #! fork() waits while a thread records its first thread-local data in a family, and the child can free the data
    /** The child saves thread-local data in the Program and deletes it, which frees the data of every thread in the
        Program's family, the parked one's as well
    */
    threadDataTest() {
        checkAvailable();
        Program p(PO_NEW_STYLE);
        p.parse(ProgramCode, "thread-data-records");
        assertEq(12, p.callFunction("run_threads", 3));
        p.callFunction("save", "parent", True);

        # the thread enters the Program first, so that it is parked only in the change of its thread-local data
        Counter in_program(1);
        Counter go(1);
        Counter done(1);
        auto saved;
        background sub () {
            on_exit done.dec();
            p.callFunction("add", 1, 2);
            in_program.dec();
            go.waitForZero();
            p.callFunction("save", "parked", 42);
            saved = p.callFunction("get", "parked");
        }();
        in_program.waitForZero();

        call_function("dbg_hold_program_record_change", SiteThreadData, p);
        on_exit call_function("dbg_hold_program_record_change_clear");
        go.dec();

        hash<auto> r = call_function("dbg_fork_while_program_record_held", "program_thread_containers", int sub () {
            p.callFunction("save", "child", True);
            if (p.callFunction("get", "child") !== True) {
                return 1;
            }
            if (p.callFunction("run_threads", 4) != 20) {
                return 2;
            }
            # frees the thread-local data of every thread in the Program's family
            delete p;
            return 0;
        });
        done.waitForZero();

        assertTrue(r.waited, "the fork handlers were reached while the thread was inside the change");
        assertTrue(r.changed, "fork() waited until the thread had finished the change");
        assertEq(0, r.status, "the child used the thread-local data and deleted the Program");
        assertEq(42, saved, "the parked thread saved its thread-local data");

        assertTrue(p.callFunction("get", "parent"));
        assertEq(6, p.callFunction("run_threads", 2));
    }

    #! the child finds a thread's first entry into a Program with the references that go with it
    /** The thread is parked right after its entry has been recorded; fork() does not wait for it.  The child deletes
        the Program, which releases the references of the entry: a record without them would release references
        that were never taken
    */
    entryReferencesTest() {
        checkAvailable();
        Program p(PO_NEW_STYLE);
        p.parse(ProgramCode, "entry-references");

        call_function("dbg_hold_program_record_change", SiteThreadProgramsDone, p);
        on_exit call_function("dbg_hold_program_record_change_clear");

        Counter done(1);
        int entry_result;
        background sub () {
            on_exit done.dec();
            entry_result = p.callFunction("add", 20, 22);
        }();

        hash<auto> r = call_function("dbg_fork_while_program_record_held", NOTHING, int sub () {
            if (p.callFunction("add", 2, 3) != 5) {
                return 1;
            }
            # releases the references of every thread's entry
            delete p;
            # a new Program can be created and deleted
            Program p2(PO_NEW_STYLE);
            p2.parse(ProgramCode, "entry-references-child");
            if (p2.callFunction("add", 1, 1) != 2) {
                return 2;
            }
            delete p2;
            return 0;
        });
        call_function("dbg_hold_program_record_change_clear");
        done.waitForZero();

        assertEq(0, r.status, "the child deleted the Program");
        assertEq(42, entry_result);
        assertEq(5, p.callFunction("add", 2, 3));
    }

    #! the child of a process whose Program is being cleared does not reach the freed data of a thread
    /** A thread enters the Program, which another thread then deletes; the deletion is parked after it has cleared
        the data of the first thread, which then ends and frees its data.  The child finds the Program in the middle of
        being cleared, and must not reach the freed data (valgrind reports an access to it)
    */
    clearedThreadDataTest() {
        checkAvailable();
        Program p(PO_NEW_STYLE);
        p.parse(ProgramCode, "cleared-thread-data");

        Counter entered(1);
        Counter go(1);
        Counter ended(1);
        int tid;
        # the ID of the thread's Program data
        int tpd_id;
        background sub () {
            on_exit ended.dec();
            tid = gettid();
            tpd_id = call_function("dbg_get_thread_program_data_id");
            p.callFunction("add", 1, 2);
            entered.dec();
            go.waitForZero();
        }();
        entered.waitForZero();

        call_function("dbg_hold_program_record_change", SiteThreadDataCleared, p, tid);
        on_exit call_function("dbg_hold_program_record_change_clear");

        Counter deleted(1);
        background sub () {
            on_exit deleted.dec();
            delete p;
        }();
        assertTrue(call_function("dbg_wait_program_record_held"), "the deletion cleared the data of the thread");

        # the thread ends and frees its data, whose reference from the Program was released
        go.dec();
        ended.waitForZero();
        assertTrue(call_function("dbg_wait_thread_program_data_released", tpd_id, 120000),
            "the data of the thread was freed");

        hash<auto> r = call_function("dbg_fork_while_program_record_held", NOTHING, int sub () {
            Program p2(PO_NEW_STYLE);
            p2.parse(ProgramCode, "cleared-thread-data-child");
            if (p2.callFunction("run_threads", 2) != 6) {
                return 1;
            }
            delete p2;
            return 0;
        });
        call_function("dbg_hold_program_record_change_clear");
        deleted.waitForZero();

        assertEq(0, r.status, "the child created and deleted a Program");
    }

    private checkAvailable() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the test needs a debug build of the library");
        }
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
    }
}
