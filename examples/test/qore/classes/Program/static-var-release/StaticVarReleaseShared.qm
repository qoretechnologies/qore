# -*- mode: qore; indent-tabs-mode: nil -*-
# StaticVarReleaseShared.qm - module of static-var-release.qtest: a static variable whose value's destructor creates
# and deletes a Program that shares the module's classes, some of whose static variables have already been released,
# when the module's static variables are released at teardown

# Copyright 2026 Qore Technologies, s.r.o.

%modern

module StaticVarReleaseShared {
    version = "1.0";
    desc = "module of the static variable release tests";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

public namespace StaticVarReleaseShared {
    #! a class whose static variables are released before Holder's (the classes are cleared in name order)
    public class Alpha {
        public {
            static int v = 5;
            static hash<auto> h = {"a": 1};
        }
    }

    #! creates and deletes a Program in its destructor that shares the classes of this module, then reads Alpha's
    #! variables, which the deleted Program shared
    public class Guard {
        destructor() {
            {
                Program p(PO_NEW_STYLE);
                p.parse("int sub get() { return StaticVarReleaseShared::Holder::value(); }", "guard");
                printf("guard Program result: %d\n", p.callFunction("get"));
            }
            printf("guard read: %y %y\n", Alpha::v, Alpha::h);
        }
    }

    #! holds the guard in a static variable
    public class Holder {
        public {
            static int before = 1;
            static Guard guard = new Guard();
            static hash<auto> after = {"a": 1};
        }

        static int value() {
            return 42;
        }
    }

    #! reads the variables of Alpha and Holder in its destructor, after Holder's have been released
    class Reader {
        destructor() {
            printf("reader read: %y %y\n", Alpha::v, Holder::before);
        }
    }

    #! holds the reader in a static variable released after Holder's
    class Zulu {
        public {
            static Reader reader = new Reader();
        }
    }
}
