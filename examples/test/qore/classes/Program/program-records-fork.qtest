#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - fork() and the fork handlers of the records of Programs that change at run time

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class ProgramRecordsForkTest

#! fork() while another thread changes a record of a Program at run time can leave the child blocked or inconsistent
/** A Program keeps records that change at run time and at module load: the lock state of its parse options, the
    features of the modules loaded into it, and others.  fork() waits for a change in progress of a record that the
    child could get inconsistent, and the child never waits for a lock held by a thread that does not exist in it.

    dbg_hold_program_record_change() (debug builds) parks the next thread that reaches the change inside it, and
    dbg_fork_while_program_record_held() calls fork() meanwhile.  A child that finds the records locked exits at once
    (98), and one that waits forever is ended, so the test cannot hang.
*/
class ProgramRecordsForkTest inherits QUnit::Test {
    public {
        #! the change of the lock state of a Program's parse options (QPRS_PARSE_OPTION_LOCK)
        const SiteParseOptionLock = 2;
        #! the change of the features of a Program (QPRS_FEATURES)
        const SiteFeatures = 3;

        #! the code of the Programs that the test enters
        const ProgramCode = "
int sub add(int a, int b) {
    return a + b;
}
";
    }

    constructor() : Test("ProgramRecordsForkTest", "1.0") {
        addTestCase("the child can change the parse options of a Program whose options another thread was locking",
            \parseOptionLockTest());
        addTestCase("fork() waits for a change of the features of a Program", \featuresTest());
        set_return_value(main());
    }

    #! a thread is parked while it locks the parse options of a Program; the child locks and changes them
    /** fork() does not wait for the thread: the lock of the change is held only while the lock state of the options
        is checked and changed, and the child gets that state consistent; the child must not wait for the lock
    */
    parseOptionLockTest() {
        checkAvailable();
        Program p(PO_NEW_STYLE);
        p.parse(ProgramCode, "parse-option-lock");
        p.setParseOptions(PO_NO_FILESYSTEM);

        call_function("dbg_hold_program_record_change", SiteParseOptionLock, p);
        on_exit call_function("dbg_hold_program_record_change_clear");

        Counter done(1);
        background sub () {
            on_exit done.dec();
            p.lockOptions();
        }();

        hash<auto> r = call_function("dbg_fork_while_program_record_held", NOTHING, int sub () {
            # the options can be changed and locked in the child
            p.setParseOptions(PO_NO_NETWORK);
            p.lockOptions();
            try {
                p.disableParseOptions(PO_NO_FILESYSTEM);
                return 1;
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "OPTIONS-LOCKED") {
                    return 2;
                }
            }
            if (p.callFunction("add", 2, 3) != 5) {
                return 3;
            }
            delete p;
            return 0;
        });
        done.waitForZero();

        assertEq(0, r.status, "the child changed and locked the options of the Program");
        # the parked thread locked the options in the parent
        assertThrows("OPTIONS-LOCKED", \p.disableParseOptions(), PO_NO_FILESYSTEM);
    }

    #! fork() waits while a thread adds the feature of a module that it loads to a Program
    featuresTest() {
        checkAvailable();
        TmpDir tmp("qore-program-records-fork-");
        string mod_name = sprintf("ProgramRecordsForkMod%d", getpid());
        string mod_path = tmp.path + "/" + mod_name + ".qm";
        File f();
        f.open2(mod_path, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(sprintf("%%new-style
%%require-types
%%strict-args

module %s {
    version = \"1.0\";
    desc = \"test module\";
    author = \"Qore Technologies, s.r.o.\";
    url = \"https://qore.org\";
}

public namespace %s {
    public int sub forty_two() {
        return 42;
    }
}
", mod_name, mod_name));
        f.close();

        Program p(PO_NEW_STYLE);
        p.parse(ProgramCode, "features");

        call_function("dbg_hold_program_record_change", SiteFeatures, p);
        on_exit call_function("dbg_hold_program_record_change_clear");

        Counter done(1);
        background sub () {
            on_exit done.dec();
            p.loadModule(mod_path);
        }();

        # the child only reads the features: after the change, the loading thread goes on to merge the module's
        # namespace into the Program's, whose locks are per-object locks that a child cannot use while another thread
        # of the parent held them (see design/fork-handlers.md, "What is not covered")
        hash<auto> r = call_function("dbg_fork_while_program_record_held", "program_thread_containers", int sub () {
            # the feature was added before the process was copied
            list<string> features = p.getFeatureList();
            if (!inlist(mod_name, features)) {
                return 1;
            }
            # the list is consistent: each feature once
            hash<string, bool> seen;
            foreach string feature in (features) {
                if (seen{feature}) {
                    return 2;
                }
                seen{feature} = True;
            }
            return 0;
        });
        done.waitForZero();

        assertTrue(r.waited, "the fork handlers were reached while the thread was inside the change");
        assertTrue(r.changed, "fork() waited until the thread had finished the change");
        assertEq(0, r.status, "the child found the feature");
        assertTrue(inlist(mod_name, p.getFeatureList()));
    }

    private checkAvailable() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the test needs a debug build of the library");
        }
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
    }
}
