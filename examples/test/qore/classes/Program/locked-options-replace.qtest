#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
# Program::replaceParseOptions() may only be called by a Program with PO_NO_CHILD_PO_RESTRICTIONS; the Programs
# whose options are replaced are locked: created with explicit options without it, children of such a Program, or
# locked with Program::lockOptions()
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}/system-options"
%requires QUnit

%exec-class LockedOptionsReplaceTest

#! Tests that Program::replaceParseOptions() cannot remove the restrictions locked in a Program
/** The replacement is checked as Program::disableParseOptions() checks the options it removes
    (design/locked-parse-options.md): a replacement that drops a locked restriction is refused with
    \c OPTIONS-LOCKED, one that only adds restrictions is made
*/
class LockedOptionsReplaceTest inherits QUnit::Test {
    constructor() : QUnit::Test("LockedOptionsReplaceTest", "1.0", \ARGV) {
        addTestCase("a locked child keeps the restrictions it was created with", \createdLocked());
        addTestCase("a child keeps the restrictions it inherited", \inherited());
        addTestCase("a Program locked with lockOptions() keeps the restrictions it had then", \lockOptions());
        addTestCase("an extended restriction is not dropped by an int replacement", \extendedRestriction());
        addTestCase("an unlocked Program may still drop a restriction", \unlocked());
        addTestCase("system options belong to the runtime", \systemOptions());
        set_return_value(main());
    }

    systemOptions() {
        Program pgm(PO_NO_CHILD_PO_RESTRICTIONS);
        int original = pgm.getParseOptions();
        int mask = PO_NO_NETWORK | PO_IN_MODULE;
        ParseOptions boxed(mask);
        assertThrows("PROGRAM-OPTION-ERROR", "PO_IN_MODULE", sub() { new Program(mask); });
        assertThrows("PROGRAM-OPTION-ERROR", "PO_IN_MODULE", sub() { new Program(boxed); });
        assertThrows("PROGRAM-OPTION-ERROR", "PO_IN_MODULE", \pgm.setParseOptions(), mask);
        assertEq(original, pgm.getParseOptions());
        assertThrows("PROGRAM-OPTION-ERROR", "PO_IN_MODULE", \pgm.setParseOptions(), boxed);
        assertEq(original, pgm.getParseOptions());
        pgm.setParseOptions(PO_NO_NETWORK);
        assertThrows("PROGRAM-OPTION-ERROR", "PO_IN_MODULE", \pgm.disableParseOptions(), mask);
        assertEq(original | PO_NO_NETWORK, pgm.getParseOptions());
        assertThrows("PROGRAM-OPTION-ERROR", "PO_IN_MODULE", \pgm.disableParseOptions(), boxed);
        assertEq(original | PO_NO_NETWORK, pgm.getParseOptions());
        pgm.disableParseOptions(PO_NO_NETWORK);
        assertThrows("PROGRAM-OPTION-ERROR", "PO_IN_MODULE", \pgm.replaceParseOptions(), original | mask);
        assertEq(original, pgm.getParseOptions());

        # Load the module in a Program that passes its restrictions to children.
        Program loader(PO_MODERN);
        loader.loadModule("SystemOptionsFixture");
        loader.parse("Program sub makeChild() { return SystemOptionsFixture::child(); }", "factory");
        Program moduleChild = loader.callFunction("makeChild");
        int inherited = moduleChild.getParseOptions();
        # a Program that module code creates runs its own code, so it does not inherit the module mark (#7067); the
        # refusal to clear PO_IN_MODULE from a Program that has it is tested in C++ (ut_program_system_option_changes()
        # in run_unit_tests()), as no Program that Qore code can reach has the option
        assertEq(0, inherited & PO_IN_MODULE, "a module child does not inherit the runtime option");
        moduleChild.replaceParseOptions(inherited | PO_NO_NETWORK);
        assertEq(inherited | PO_NO_NETWORK, moduleChild.getParseOptions());
        assertThrows("PROGRAM-OPTION-ERROR", "PO_IN_MODULE", \moduleChild.replaceParseOptions(),
            inherited | PO_NO_NETWORK | PO_IN_MODULE);
        assertEq(inherited | PO_NO_NETWORK, moduleChild.getParseOptions());
    }

    createdLocked() {
        Program pgm(PO_NO_NETWORK | PO_NO_FILESYSTEM);
        checkLocked(pgm, "created locked");
        assertThrows("OPTIONS-LOCKED", "enable-debug", \pgm.setParseOptions(), PO_ENABLE_DEBUG);
        # disableParseOptions() is refused as well
        assertThrows("OPTIONS-LOCKED", "PO_NO_FILESYSTEM", \pgm.disableParseOptions(), PO_NO_FILESYSTEM);
        assertTrue(pgm.getFullParseOptions().hasAll(PO_NO_FILESYSTEM), "created locked: the restriction is kept");
    }

    inherited() {
        # a locked Program without child restrictions, whose children inherit its options
        Program parent(PO_NO_NETWORK | PO_NO_FILESYSTEM);
        parent.parse("Program sub make() { return new Program(); }", "make");
        Program pgm = parent.callFunction("make");
        assertTrue(pgm.getFullParseOptions().hasAll(PO_NO_NETWORK | PO_NO_FILESYSTEM),
            "the child inherits the restrictions");
        checkLocked(pgm, "inherited");
    }

    lockOptions() {
        Program pgm(PO_NO_CHILD_PO_RESTRICTIONS | PO_NO_NETWORK | PO_NO_FILESYSTEM);
        pgm.lockOptions();
        checkLocked(pgm, "lockOptions()");
        assertThrows("OPTIONS-LOCKED", "PO_NO_FILESYSTEM", \pgm.disableParseOptions(), PO_NO_FILESYSTEM);
        assertTrue(pgm.getFullParseOptions().hasAll(PO_NO_FILESYSTEM), "lockOptions(): the restriction is kept");

        # a restriction added after the lock may be dropped by a replacement
        int opts = pgm.getParseOptions();
        pgm.setParseOptions(PO_NO_EXTERNAL_PROCESS);
        pgm.replaceParseOptions(opts);
        assertFalse(pgm.getFullParseOptions().hasAll(PO_NO_EXTERNAL_PROCESS),
            "lockOptions(): a restriction added after the lock is dropped");
        assertTrue(pgm.getFullParseOptions().hasAll(PO_NO_NETWORK | PO_NO_FILESYSTEM),
            "lockOptions(): the locked ones are kept");
    }

    extendedRestriction() {
        Program pgm(new ParseOptions("no-new"));
        assertTrue(pgm.getFullParseOptions().hasAll("no-new"), "the Program has the extended restriction");
        # the int mask cannot hold the extended option, so this replacement would drop it
        assertThrows("OPTIONS-LOCKED", "no-new", \pgm.replaceParseOptions(), pgm.getParseOptions());
        assertTrue(pgm.getFullParseOptions().hasAll("no-new"), "the extended restriction is kept");
        assertThrows("PARSE-EXCEPTION", "NO_NEW", \pgm.parse(), ("auto sub f() { return new Mutex(); }", "use"));
        # the control: the code parses in a Program without the restriction
        Program plain(PO_NO_CHILD_PO_RESTRICTIONS);
        plain.parse("auto sub f() { return new Mutex(); }", "use");
        assertTrue(plain.existsFunction("f"), "code that needs it parses without the restriction");
    }

    #! the control: a Program created with PO_NO_CHILD_PO_RESTRICTIONS is not locked
    unlocked() {
        Program pgm(PO_NO_CHILD_PO_RESTRICTIONS | PO_NO_NETWORK);
        pgm.replaceParseOptions(pgm.getParseOptions() & ~PO_NO_NETWORK);
        assertFalse(pgm.getFullParseOptions().hasAll(PO_NO_NETWORK), "the restriction is dropped");
        pgm.parse("auto sub f() { return new Socket(); }", "use");
        assertTrue(pgm.existsFunction("f"), "code that needs it parses");
    }

    #! checks that \a pgm, with PO_NO_NETWORK | PO_NO_FILESYSTEM locked in, keeps them in a replacement
    private checkLocked(Program pgm, string label) {
        int opts = pgm.getParseOptions();
        assertTrue((opts & (PO_NO_NETWORK | PO_NO_FILESYSTEM)) == (PO_NO_NETWORK | PO_NO_FILESYSTEM),
            label + ": the Program has the restrictions");

        assertThrows("OPTIONS-LOCKED", \pgm.replaceParseOptions(), opts & ~PO_NO_NETWORK);
        assertEq(opts, pgm.getParseOptions(), label + ": the options are unchanged");
        assertTrue(pgm.getFullParseOptions().hasAll(PO_NO_NETWORK), label + ": the restriction is kept");
        assertThrows("ILLEGAL-CLASS-INSTANTIATION", \pgm.parse(), ("auto sub f() { return new Socket(); }", "use"));

        # a replacement that drops a locked restriction while adding another is refused as a whole
        assertThrows("OPTIONS-LOCKED", \pgm.replaceParseOptions(),
            (opts & ~PO_NO_FILESYSTEM) | PO_NO_EXTERNAL_PROCESS);
        assertEq(opts, pgm.getParseOptions(), label + ": the options are unchanged after the mixed replacement");

        # a replacement that only adds a restriction is made
        pgm.replaceParseOptions(opts | PO_NO_PROCESS_CONTROL);
        assertEq(opts | PO_NO_PROCESS_CONTROL, pgm.getParseOptions(), label + ": a restriction is added");
    }
}
