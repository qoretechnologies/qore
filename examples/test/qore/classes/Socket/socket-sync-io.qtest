#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - blocking socket I/O, timeouts, thread cancellation of waits, /dev/fd descriptor counts
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class SocketSyncIoTest

#! Tests the semantics of the synchronous accept(), recv(), send() and close() of a Socket
/** The calls are served by the async I/O controller; a close cancels the socket's operations on the I/O thread that
    runs them (see AsyncIoControllerPriv::getSocketThreadIndexes()).  The results must be those of a blocking
    socket: the data, the timeout and cancellation exceptions, the wake-up of a call by a close from another thread,
    the report of a peer's close, and no descriptor left open.
*/
class SocketSyncIoTest inherits QUnit::Test {
    public {
        #! the time allowed for a call that the test expects to end at once
        const Timeout = 60s;
    }

    constructor() : QUnit::Test("SocketSyncIoTest", "1.0", \ARGV) {
        addTestCase("accept, recv, send and close in a loop", \testLoop());
        addTestCase("recv returns data sent while it waits", \testRecvWaits());
        addTestCase("recv timeout", \testRecvTimeout());
        addTestCase("accept timeout", \testAcceptTimeout());
        addTestCase("a large send waits for the reader", \testLargeSend());
        addTestCase("cancel_thread ends a waiting recv", \testCancelRecv());
        addTestCase("cancel_thread ends a waiting accept", \testCancelAccept());
        addTestCase("close from another thread ends a waiting recv", \testCloseWakesRecv());
        addTestCase("a peer's close is reported", \testPeerClose());
        addTestCase("the descriptor count does not grow", \testNoDescriptorLeak());
        set_return_value(main());
    }

    private Socket listener() {
        Socket s();
        s.bindINET("127.0.0.1", 0);
        s.listen();
        return s;
    }

    testLoop() {
        Socket s = listener();
        int port = s.getPort();
        for (int i = 0; i < 200; ++i) {
            Socket c();
            c.connect("127.0.0.1:" + port);
            Socket a = s.accept(Timeout);
            string req = "request " + i;
            c.send(req);
            assertEq(req, a.recv(req.size(), Timeout));
            a.send("reply " + i);
            assertEq("reply " + i, c.recv(("reply " + i).size(), Timeout));
            a.close();
            c.close();
        }
    }

    testRecvWaits() {
        Socket s = listener();
        int port = s.getPort();
        Socket c();
        c.connect("127.0.0.1:" + port);
        Socket a = s.accept(Timeout);
        Queue q();
        Counter started(1);
        int tid = background sub () {
            started.dec();
            q.push(a.recv(5, Timeout));
        }();
        started.waitForZero(Timeout);
        c.send("hello");
        assertEq("hello", q.get(Timeout));
        thread_join(tid);
    }

    testRecvTimeout() {
        Socket s = listener();
        int port = s.getPort();
        Socket c();
        c.connect("127.0.0.1:" + port);
        Socket a = s.accept(Timeout);
        hash<ExceptionInfo> ex;
        try {
            a.recv(1, 50ms);
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        assertEq("SOCKET-TIMEOUT", ex.err, "recv with no data times out");
        # the socket is still usable after a timeout
        c.send("x");
        assertEq("x", a.recv(1, Timeout));
    }

    testAcceptTimeout() {
        Socket s = listener();
        assertNothing(s.accept(50ms), "accept with no connection times out and returns nothing");
        int port = s.getPort();
        Socket c();
        c.connect("127.0.0.1:" + port);
        assertTrue(s.accept(Timeout).isOpen(), "the next connection is accepted");
    }

    testLargeSend() {
        Socket s = listener();
        int port = s.getPort();
        Socket c();
        c.connect("127.0.0.1:" + port);
        Socket a = s.accept(Timeout);
        # larger than the socket buffers, so the send waits for the reader
        const int Size = 16 * 1024 * 1024;
        string data = strmul("0123456789abcdef", Size / 16);
        Queue q();
        int tid = background sub () {
            q.push(a.recv(Size, Timeout));
        }();
        c.send(data);
        string got = q.get(Timeout);
        assertEq(Size, got.size());
        assertTrue(got == data, "the large message is intact");
        thread_join(tid);
    }

    #! runs code in a thread that is cancelled, returning the exception it ended with
    private *hash<ExceptionInfo> cancelled(code body) {
        Queue ready();
        Queue res();
        int tid = background sub () {
            ready.push(1);
            try {
                body();
                res.push(NOTHING);
            } catch (hash<ExceptionInfo> ex) {
                res.push(ex);
            }
        }();
        ready.get(Timeout);
        # the request is honored whether the thread has started to wait or not
        cancel_thread(tid);
        *hash<ExceptionInfo> ex = res.get(Timeout);
        thread_join(tid);
        return ex;
    }

    testCancelRecv() {
        Socket s = listener();
        int port = s.getPort();
        Socket c();
        c.connect("127.0.0.1:" + port);
        Socket a = s.accept(Timeout);
        *hash<ExceptionInfo> ex = cancelled(sub () { a.recv(1, Timeout); });
        assertEq("THREAD-CANCELLED", ex.err);
    }

    testCancelAccept() {
        Socket s = listener();
        *hash<ExceptionInfo> ex = cancelled(sub () { s.accept(Timeout); });
        assertEq("THREAD-CANCELLED", ex.err);
    }

    testCloseWakesRecv() {
        Socket s = listener();
        int port = s.getPort();
        Socket c();
        c.connect("127.0.0.1:" + port);
        Socket a = s.accept(Timeout);
        Queue ready();
        Queue res();
        int tid = background sub () {
            ready.push(1);
            try {
                a.recv(1, Timeout);
                res.push("returned");
            } catch (hash<ExceptionInfo> ex) {
                res.push(ex.err);
            }
        }();
        ready.get(Timeout);
        # the close lands before the call starts (SOCKET-NOT-OPEN) or while it waits (SOCKET-CLOSED, or a normal
        # return, as before); what matters is that the call ends: the close must wake it, so that it does not wait
        # for its timeout
        a.close();
        string err = res.get(Timeout);
        assertTrue(inlist(err, ("SOCKET-CLOSED", "SOCKET-NOT-OPEN", "returned")), "the call ends: " + err);
        thread_join(tid);
    }

    testPeerClose() {
        Socket s = listener();
        int port = s.getPort();
        Socket c();
        c.connect("127.0.0.1:" + port);
        Socket a = s.accept(Timeout);
        c.send("bye");
        c.close();
        assertEq("bye", a.recv(3, Timeout));
        hash<ExceptionInfo> ex;
        try {
            a.recv(1, Timeout);
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        assertEq("SOCKET-CLOSED", ex.err, "the peer's close is reported as in the controller");
    }

    #! Returns the directory that lists the open descriptors of this process, if the platform has one
    /** Linux has /proc/self/fd; macOS and the BSDs have /dev/fd
    */
    private static *string getFdDir() {
        foreach string dir in ("/proc/self/fd", "/dev/fd") {
            if (is_dir(dir)) {
                return dir;
            }
        }
    }

    private int numFds(string dir) {
        return elements (new Dir()).list(dir);
    }

    testNoDescriptorLeak() {
        *string fd_dir = getFdDir();
        if (!fd_dir) {
            testSkip("the platform has no directory that lists the open descriptors of a process");
        }
        Socket s = listener();
        int port = s.getPort();
        # one round to settle lazily created descriptors
        {
            Socket c();
            c.connect("127.0.0.1:" + port);
            Socket a = s.accept(Timeout);
            c.send("x");
            a.recv(1, Timeout);
        }
        int before = numFds(fd_dir);
        for (int i = 0; i < 100; ++i) {
            Socket c();
            c.connect("127.0.0.1:" + port);
            Socket a = s.accept(Timeout);
            c.send("x");
            a.recv(1, Timeout);
            a.close();
            c.close();
        }
        assertEq(before, numFds(fd_dir), "no descriptor is left open by the calls");
    }
}
