#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - poll() readiness of listening sockets (the accept queue after connect), non-blocking accept

%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires Util
%requires QUnit

%exec-class PollAcceptTest

#! Test for poll() detection of pending accept on listener sockets
/** This test verifies that poll() correctly detects pending connections
    on listener sockets. On some platforms (notably macOS), poll() may not
    reliably report POLLIN on listener sockets even when connections are
    pending in the accept queue.

    The test creates listener sockets, connects clients, and verifies that
    poll() detects the pending connections.  It makes no timing assumption: the server side of a connection becomes
    acceptable when the kernel has processed the client's final ACK, which on a loaded machine can take any time, so
    each poll waits for readiness with a timeout that only guards against a hang; a poll that misses the
    level-triggered event of a pending connection fails at that timeout (issue #6416).
*/
class PollAcceptTest inherits QUnit::Test {
    public {
        # Number of iterations for stress testing
        const Iterations = 100;

        # Number of listeners for multi-listener test
        const NumListeners = 6;

        # The timeout (ms) of a poll for a pending connection; only a guard against a hang
        const PollHangGuard = 30000;
    }

    constructor() : Test("PollAcceptTest", "1.0") {
        addTestCase("basic poll accept detection", \testBasicPollAccept());
        addTestCase("multiple listeners poll accept", \testMultiListenerPollAccept());
        addTestCase("stress test poll accept", \testStressPollAccept());
        addTestCase("non-blocking accept without poll", \testNonBlockingAcceptWithoutPoll());
        set_return_value(main());
    }

    #! Test basic poll() detection of a pending accept
    testBasicPollAccept() {
        # Create listener
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        hash<auto> info = listener.getSocketInfo(False);

        # Connect client - this creates a pending connection
        Socket client();
        client.setNoDelay(True);
        client.connectINET(info.address, info.port, 10s, info.family);

        # Poll should detect the pending connection
        list<hash<SocketPollInfo>> poll_list = (
            cast<hash<SocketPollInfo>>({"events": SOCK_POLLIN, "socket": listener}),
        );

        list<auto> ready = Socket::poll(poll_list, PollHangGuard);
        if (ready.size() != 1) {
            fail(sprintf("poll() should detect the pending accept; it reported %d socket(s)", ready.size()));
            return;
        }

        # Clean up - accept the connection
        Socket accepted = listener.accept(0);
        assertTrue(accepted.isOpen(), "accepted socket should be open");
    }

    #! Test poll() with multiple listeners (mimics Qorus HTTP server scenario)
    testMultiListenerPollAccept() {
        list<Socket> listeners = ();
        list<hash<auto>> infos = ();

        # Create multiple listeners
        for (int i = 0; i < NumListeners; ++i) {
            Socket listener();
            listener.bind("localhost:0");
            listener.listen();
            push listeners, listener;
            push infos, listener.getSocketInfo(False);
        }

        # Connect to a random listener
        int target_idx = rand() % NumListeners;
        hash<auto> target_info = infos[target_idx];
        Socket client();
        client.setNoDelay(True);
        client.connectINET(target_info.address, target_info.port, 10s, target_info.family);

        # Poll all listeners
        list<hash<SocketPollInfo>> poll_list = ();
        foreach Socket l in (listeners) {
            push poll_list, cast<hash<SocketPollInfo>>({"events": SOCK_POLLIN, "socket": l});
        }

        list<auto> ready = Socket::poll(poll_list, PollHangGuard);
        if (ready.size() != 1) {
            fail(sprintf("poll() should detect exactly one pending accept; it reported %d socket(s)", ready.size()));
            return;
        }

        # Verify it's the correct listener
        string ready_hash = ready[0].socket.uniqueHash();
        string target_hash = listeners[target_idx].uniqueHash();
        assertEq(target_hash, ready_hash, "poll() should report the correct listener as ready");

        # Clean up
        Socket accepted = listeners[target_idx].accept(0);
        assertTrue(accepted.isOpen());
    }

    #! Stress test - run multiple iterations to catch intermittent failures
    testStressPollAccept() {
        for (int iter = 0; iter < Iterations; ++iter) {
            Socket listener();
            listener.bind("localhost:0");
            listener.listen();
            hash<auto> info = listener.getSocketInfo(False);

            Socket client();
            client.setNoDelay(True);
            client.connectINET(info.address, info.port, 10s, info.family);

            list<hash<SocketPollInfo>> poll_list = (
                cast<hash<SocketPollInfo>>({"events": SOCK_POLLIN, "socket": listener}),
            );

            list<auto> ready = Socket::poll(poll_list, PollHangGuard);
            if (ready.size() != 1) {
                fail(sprintf("poll() did not detect the pending accept of iteration %d of %d", iter + 1,
                    Iterations));
                return;
            }
            Socket accepted = listener.accept(0);
            assertTrue(accepted.isOpen(), sprintf("iteration %d: the accepted socket is open", iter + 1));
        }
    }

    #! Test that verifies a non-blocking accept() returns NOTHING without a connection and a pending connection
    /** accept(0) must not block when no connection is pending, and must return a connection that is pending; the
        connection is pending once the listener reports it as readable (the poll() detection of a pending accept
        itself is checked by the other cases)
    */
    testNonBlockingAcceptWithoutPoll() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        hash<auto> info = listener.getSocketInfo(False);

        # Try accept before any connection with timeout=0
        # Should return NOTHING or timeout, not block
        bool got_nothing = False;
        try {
            *Socket early = listener.accept(0);
            if (!early) {
                got_nothing = True;
            }
        } catch (hash<ExceptionInfo> ex) {
            # Timeout or error is expected
            got_nothing = True;
        }
        assertTrue(got_nothing, "accept(0) with no connection should return NOTHING or timeout");

        # Now connect a client
        Socket client();
        client.setNoDelay(True);
        client.connectINET(info.address, info.port, 10s, info.family);

        # connectINET() returns when the client side is established; the connection can be accepted only when the
        # kernel has processed the client's final ACK, which on a loaded machine can take any time: wait until the
        # listener is readable (a pending connection); the timeout only guards against a hang (issue #6408)
        assertTrue(listener.isDataAvailable(30s), "the listener reports the pending connection");

        # accept(0) must return the pending connection without blocking
        *Socket accepted;
        try {
            accepted = listener.accept(0);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("accept(0) failed after client connected: %s: %s", ex.err, ex.desc));
            return;
        }

        assertTrue(exists accepted, "accept(0) should return a socket after client connects");
        assertTrue(accepted.isOpen(), "accepted socket should be open");
    }
}
