#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%requires ../../../DnsTestServer.qm
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class CaresErrorStatusTest

#! A name lookup error gives the resolver's status in its argument
/** \c QOREADDRINFO-GETINFO-ERROR was raised with the same error code and no argument for every failure of the
    resolver, so a caller could not tell a name that does not exist from a DNS server that did not answer.  A local
    DNS server (dbg_cares_set_servers()) gives each answer without the network.
*/
class CaresErrorStatusTest inherits QUnit::Test {
    private {
        *DnsTestServer dns;
        string old_servers;
    }

    constructor() : QUnit::Test("CaresErrorStatus", "1.0") {
        addTestCase("getaddrinfo() gives the resolver's status", \getaddrinfoTest());
        addTestCase("getaddrinfo_async() gives the resolver's status", \getaddrinfoAsyncTest());
        addTestCase("a lookup of both families is definite only if both answers are", \mixedFamiliesTest());
        addTestCase("a definite answer with no failed query makes no other query", \definiteQueriesTest());
        addTestCase("a lookup canceled while its failure is checked", \cancelDuringCheckTest());
        addTestCase("a lookup that times out while its failure is checked", \timeoutDuringCheckTest());
        addTestCase("Socket::resolveAddrInfo() gives the resolver's status", \resolveAddrInfoTest());
        addTestCase("Socket::connect() gives the resolver's status", \connectTest());
        addTestCase("HTTPClient gives the resolver's status", \httpClientTest());
        addTestCase("a server that does not listen gives a temporary status", \refusedTest());
        set_return_value(main());
    }

    globalSetUp() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            return;
        }
        dns = new DnsTestServer();
        old_servers = call_function("dbg_cares_set_servers", dns.getServer());
    }

    globalTearDown() {
        if (dns) {
            call_function("dbg_cares_set_servers", old_servers);
            dns.stop();
        }
    }

    getaddrinfoTest() {
        checkDebug();
        # a name ending in a dot is looked up as it is, without the search domains of the host
        foreach hash<auto> i in (Expected.pairIterator()) {
            checkStatus(\getaddrinfo(), (i.key + ".qore-test.",), i.value);
        }
    }

    #! the Future of getaddrinfo_async() raised the error without its argument
    getaddrinfoAsyncTest() {
        checkDebug();
        foreach hash<auto> i in (Expected.pairIterator()) {
            checkStatus(sub (string name) { getaddrinfo_async(name).get(); }, (i.key + ".qore-test.",), i.value);
        }
    }

    #! c-ares gives the status of the address family whose query finished last
    /** A SERVFAIL answer for the A query and a NODATA answer for the AAAA query, which the server gives last, made
        the lookup of both families fail with ENODATA, a definite answer, so a caller that retries temporary failures
        did not retry it
    */
    mixedFamiliesTest() {
        checkDebug();
        # each query is tried once, so that the server's answer for AAAA comes after the last one for A
        hash<auto> opts = call_function("dbg_cares_set_query_options", {"tries": 1, "timeout_ms": 60000});
        on_exit call_function("dbg_cares_set_query_options", opts);
        string name = "mixed.qore-test.";
        checkStatus(\getaddrinfo(), (name,), "ESERVFAIL");
        checkStatus(\getaddrinfo(), (name, NOTHING, AF_UNSPEC), "ESERVFAIL");
        checkStatus(\Socket::resolveAddrInfo(), (name, "80"), "ESERVFAIL");
        checkStatus(sub (string name) { getaddrinfo_async(name).get(); }, (name,), "ESERVFAIL");
        # a lookup of IPv4 only gives the answer of its family
        checkStatus(\getaddrinfo(), (name, NOTHING, AF_INET), "ESERVFAIL");
        # names whose answers are the same for both families keep their definite status
        checkStatus(\getaddrinfo(), ("nx.qore-test.", NOTHING, AF_UNSPEC), "ENOTFOUND");
        checkStatus(\getaddrinfo(), ("nodata.qore-test.", NOTHING, AF_UNSPEC), "ENODATA");
    }

    #! A definite failure is checked only if a query of the lookup failed
    /** The lookup of each family that checks a definite failure of a lookup of both was made for every such failure,
        so a name that does not exist was looked up twice: the server gives no SOA record, which c-ares needs to
        cache a negative answer
    */
    definiteQueriesTest() {
        checkDebug();
        foreach hash<auto> i in ({"label": "nx", "status": "ENOTFOUND"}, {"label": "nodata", "status": "ENODATA"}) {
            string name = i.label + ".qore-test.";
            int before = dns.getQueries(i.label);
            checkStatus(\getaddrinfo(), (name, NOTHING, AF_UNSPEC), i.status);
            assertEq(2, dns.getQueries(i.label) - before, name + ": one query for A and one for AAAA");
            before = dns.getQueries(i.label);
            checkStatus(\getaddrinfo(), (name, NOTHING, AF_INET), i.status);
            assertEq(1, dns.getQueries(i.label) - before, name + ": one query for A");
        }
    }

    #! A lookup canceled while the lookup of each family checks its failure ends at once
    /** The server drops the queries of the check, and the lookup's operation is canceled when it has received one
    */
    cancelDuringCheckTest() {
        checkDebug();
        hash<auto> opts = call_function("dbg_cares_set_query_options", {"tries": 1, "timeout_ms": 60000});
        on_exit call_function("dbg_cares_set_query_options", opts);
        dns.resetMixedDrop();
        Future f = getaddrinfo_async("mixeddrop.qore-test.");
        # the A query of the lookup of IPv4; the NODATA answer for AAAA comes from the query cache of the channel
        assertEq("mixeddrop", dns.waitDropped(60s), "the check of the failure has started");
        list<string> op_keys = select AsyncIoController::getInfo().cache_keys,
            $1 =~ /^QoreDNS::getaddrinfo_async:/;
        assertEq(1, op_keys.size(), "the lookup's operation is running");
        assertTrue(AsyncIoController::cancelByKey(op_keys[0]));
        hash<ExceptionInfo> ex = lookupError(sub () { f.get(); }, ());
        assertEq("QOREADDRINFO-CANCELLED", ex.err);
    }

    #! The lookups of each family that time out make the failure a timeout
    /** The server drops the queries of the check; c-ares tries each query once, with a timeout that the answers to
        the lookup itself, which the server gives at once, come within
    */
    timeoutDuringCheckTest() {
        checkDebug();
        hash<auto> opts = call_function("dbg_cares_set_query_options", {"tries": 1, "timeout_ms": 1000});
        on_exit call_function("dbg_cares_set_query_options", opts);
        dns.resetMixedDrop();
        int before = dns.getQueries("mixeddrop");
        hash<ExceptionInfo> ex = lookupError(\getaddrinfo(), ("mixeddrop.qore-test.",));
        assertEq("QOREADDRINFO-GETINFO-ERROR", ex.err);
        assertEq("ETIMEOUT", ex.arg.status, "the check timed out");
        # the queries of the lookup, and the A query of the lookup of IPv4, which was dropped (the NODATA answer for
        # AAAA comes from the query cache of the channel)
        assertEq(3, dns.getQueries("mixeddrop") - before, "the check of the failure ran");
        assertEq("mixeddrop", dns.waitDropped(30s), "the A query of the check was dropped");
    }

    resolveAddrInfoTest() {
        checkDebug();
        foreach hash<auto> i in (Expected.pairIterator()) {
            checkStatus(\Socket::resolveAddrInfo(), (i.key + ".qore-test.", "80"), i.value);
        }
    }

    connectTest() {
        checkDebug();
        foreach hash<auto> i in (Expected.pairIterator()) {
            checkStatus(sub (string target) { Socket s(); s.connect(target, 10s); }, (i.key + ".qore-test.:80",),
                i.value);
        }
    }

    #! HTTPClient raised the connection's error again without its argument
    httpClientTest() {
        checkDebug();
        foreach hash<auto> i in (Expected.pairIterator()) {
            checkStatus(sub (string url) { HTTPClient h({"url": url}); h.connect(); },
                ("http://" + i.key + ".qore-test.",), i.value);
            checkStatus(sub (string url) { HTTPClient h({"url": url}); h.get("/"); },
                ("http://" + i.key + ".qore-test.",), i.value);
        }
    }

    refusedTest() {
        checkDebug();
        # a UDP port held by a socket connected to another address: no socket takes a datagram from the resolver on
        # it, and none can be bound to it while it is held, so the system refuses the datagrams
        Socket held();
        held.connectINET("127.0.0.1", dns.getServer().split(":").last(), 5s, AF_INET, SOCK_DGRAM);
        on_exit held.close();
        string servers = call_function("dbg_cares_set_servers", "127.0.0.1:" + held.getSocketInfo().port);
        on_exit call_function("dbg_cares_set_servers", servers);
        hash<ExceptionInfo> ex = lookupError(\getaddrinfo(), ("nx.qore-test.",));
        assertEq("QOREADDRINFO-GETINFO-ERROR", ex.err);
        assertEq("ECONNREFUSED", ex.arg.status, "a DNS server that does not listen is a temporary failure");
    }

    private checkStatus(code lookup, list<auto> args, string status) {
        hash<ExceptionInfo> ex = lookupError(lookup, args);
        assertEq("QOREADDRINFO-GETINFO-ERROR", ex.err, sprintf("%y: the error code", args[0]));
        assertEq(status, ex.arg.status, sprintf("%y: the resolver's status", args[0]));
    }

    private hash<ExceptionInfo> lookupError(code lookup, list<auto> args) {
        try {
            call_function_args(lookup, args);
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        throw "TEST-ERROR", sprintf("the lookup of %y did not fail", args[0]);
    }

    private checkDebug() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_cares_set_servers() is only registered in a library-debug build");
        }
    }

    #! the status of the resolver for the first label of a name (see DnsTestServer::Rcodes)
    const Expected = {
        "nx": "ENOTFOUND",
        "nodata": "ENODATA",
        "servfail": "ESERVFAIL",
        "refused": "EREFUSED",
    };
}
