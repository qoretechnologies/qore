class SocketLingeringCloseTest inherits QUnit::Test {
    public {
        #! the response the server sends before closing
        const Response = "response";
    }

    constructor() : Test("SocketLingeringCloseTest", "1.0") {
        addTestCase("unread data is discarded, and the peer reads the response", \unreadDataTest());
        addTestCase("data sent after the response is discarded", \dataAfterResponseTest());
        addTestCase("the maximum amount of data to discard", \maxDiscardTest());
        addTestCase("TLS", \tlsTest());
        addTestCase("buffered data is discarded", \bufferedDataTest());
        addTestCase("peer already closed", \peerClosedTest());
        addTestCase("socket not open", \notOpenTest());
        set_return_value(main());
    }

    unreadDataTest() {
        hash<auto> conn = connect();
        Socket client = conn.client;
        Socket server = conn.server;
        on_exit client.close();

        # the server never reads this data
        client.send(binary(strmul("x", 65536)));
        server.send(Response);
        Queue result = startLingeringClose(server);

        assertEq(Response, client.recv(Response.size(), 10s), "the response is read");
        assertThrows("SOCKET-CLOSED", \client.recv(), (1, 10s), "the response is followed by the end of the stream");
        client.close();

        hash<LingeringCloseInfo> info = getResult(result);
        assertEq(65536, info.discarded, "all unread data was discarded");
        assertTrue(info.peer_closed, "the connection ended when the peer closed it");
        assertFalse(info.max_discard_reached);
        assertFalse(server.isOpen(), "the socket is closed");
    }

    dataAfterResponseTest() {
        hash<auto> conn = connect();
        Socket client = conn.client;
        Socket server = conn.server;
        on_exit client.close();

        server.send(Response);
        Queue result = startLingeringClose(server);
        assertEq(Response, client.recv(Response.size(), 10s), "the response is read");
        # the server's sending side is shut down, but it still receives
        for (int i = 0; i < 3; ++i) {
            client.send(binary(strmul("y", 20000)));
        }
        client.close();

        hash<LingeringCloseInfo> info = getResult(result);
        assertEq(60000, info.discarded, "the data sent after the response was discarded");
        assertTrue(info.peer_closed, "the connection ended when the peer closed it");
    }

    maxDiscardTest() {
        hash<auto> conn = connect();
        Socket client = conn.client;
        Socket server = conn.server;
        on_exit client.close();

        # the peer never closes its side; the discard limit ends the wait
        client.send(binary(strmul("z", 100000)));
        Queue result = startLingeringClose(server, 50000);

        hash<LingeringCloseInfo> info = getResult(result);
        assertTrue(info.max_discard_reached, "the limit ended the wait");
        assertGe(50000, info.discarded, "at least the limit was discarded");
        assertFalse(info.peer_closed, "the peer did not close its side");
        assertFalse(server.isOpen(), "the socket is closed");
    }

    tlsTest() {
        Socket listener();
        listener.bind("127.0.0.1:0", True);
        listener.listen();
        on_exit listener.close();
        listener.setCertificate(TestCert);
        listener.setPrivateKey(TestCert);
        int port = listener.getSocketInfo().port;

        Queue accepted();
        background sub () {
            try {
                accepted.push(listener.acceptSSL(15s));
            } catch (hash<ExceptionInfo> ex) {
                accepted.push(ex);
            }
        }();
        Socket client();
        client.connectSSL(sprintf("127.0.0.1:%d", port), 15s);
        on_exit client.close();
        auto a = accepted.get(15s);
        if (!(a instanceof Socket)) {
            throw a.err, a.desc;
        }
        Socket server = a;

        # the server never reads this data
        client.send(binary(strmul("t", 32768)));
        server.send(Response);
        Queue result = startLingeringClose(server);

        assertEq(Response, client.recv(Response.size(), 10s), "the response is read");
        # the server's close_notify alert ends the TLS stream
        assertThrows("SOCKET-CLOSED", \client.recv(), (1, 10s), "the response is followed by the end of the stream");
        client.close();

        hash<LingeringCloseInfo> info = getResult(result);
        # the unread records and the client's closing alert, as encrypted on the wire
        assertGt(32768, info.discarded, "the unread TLS records were discarded");
        assertTrue(info.peer_closed, "the connection ended when the peer closed it");
        assertFalse(server.isOpen(), "the socket is closed");
    }

    bufferedDataTest() {
        hash<auto> conn = connect();
        Socket client = conn.client;
        Socket server = conn.server;
        on_exit client.close();

        # the server reads the request line and header; the bytes after them are either in the socket's buffer or
        # still in the system's receive buffer, and are discarded either way
        client.send("GET / HTTP/1.1\r\nHost: localhost\r\n\r\nextra");
        hash<auto> hdr = server.readHTTPHeader(10s);
        assertEq("GET", hdr.method);
        server.send(Response);
        Queue result = startLingeringClose(server);

        assertEq(Response, client.recv(Response.size(), 10s), "the response is read");
        client.close();

        hash<LingeringCloseInfo> info = getResult(result);
        assertEq(5, info.discarded, "the unread bytes after the header were discarded");
        assertTrue(info.peer_closed);
    }

    peerClosedTest() {
        hash<auto> conn = connect();
        Socket client = conn.client;
        Socket server = conn.server;

        client.close();
        Queue result = startLingeringClose(server);

        hash<LingeringCloseInfo> info = getResult(result);
        assertEq(0, info.discarded, "there was nothing to discard");
        assertTrue(info.peer_closed, "the peer had closed its side");
        assertFalse(server.isOpen(), "the socket is closed");
    }

    notOpenTest() {
        Socket s();
        assertThrows("SOCKET-NOT-OPEN", \s.startPollLingeringClose());
    }

    #! returns a connected client and server socket pair
    private hash<auto> connect() {
        Socket listener();
        listener.bind("127.0.0.1:0", True);
        listener.listen();
        on_exit listener.close();
        Socket client();
        client.connect(sprintf("127.0.0.1:%d", listener.getSocketInfo().port), 10s);
        Socket server = listener.accept(10s);
        return {"client": client, "server": server};
    }

    #! drives the lingering close of the socket in a background thread; the Queue receives the result
    private Queue startLingeringClose(Socket s, int max_discard = 0) {
        Queue result();
        AbstractPollOperation<auto> op = s.startPollLingeringClose(max_discard);
        background sub () {
            try {
                # monotonic microseconds
                int deadline = clock_get_monotonic_us() + 30 * 1000000;
                while (*hash<SocketPollInfo> info = op.continuePoll()) {
                    int remaining_ms = (deadline - clock_get_monotonic_us()) / 1000;
                    if (remaining_ms <= 0 || !Socket::poll((info,), remaining_ms)) {
                        throw "LINGERING-CLOSE-TIMEOUT", "the lingering close did not complete in time";
                    }
                }
                result.push(op.getOutput());
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex);
            }
        }();
        return result;
    }

    #! returns the result of a lingering close
    private hash<LingeringCloseInfo> getResult(Queue result) {
        auto rv = result.get(60s);
        if (rv instanceof hash<ExceptionInfo>) {
            throw rv.err, rv.desc;
        }
        return rv;
    }
}
