#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - dual-stack wildcard binds versus IPv4 listeners and kernel port assignment, TIME_WAIT

/*
    Copyright (C) 2026 Qore Technologies, s.r.o., all rights reserved

    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    A socket bound on all interfaces never shares its port with a socket that another program holds for IPv4 on
    0.0.0.0 or 127.0.0.1, because an IPv4 client of such an address would reach the other socket instead.  Linux
    refuses such a bind; macOS allowed it for the dual-stack IPv6 wildcard socket that a bind on all interfaces
    opens, and for an IPv4 wildcard socket with SO_REUSEADDR, and its system-assigned ports for the IPv6 wildcard
    address did not avoid ports held for IPv4.

    The tests can run at the same time as other programs: a port is never released before the test binds it again,
    and the ports held at given numbers are bound without SO_REUSEADDR, so that none is a port that another program
    uses.  A port that only connections hold can still be bound by number by another program that reuses the
    address (issue #6322); the test of a given port reports that program's listener as the cause instead of failing.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../PortHolder.qm

%exec-class SocketWildcardBindTest

class SocketWildcardBindTest inherits QUnit::Test {
    public {
        #! the number of free ports held after the next system-assigned port for the system-assigned port tests
        const HeldPorts = 64;
    }

    constructor() : Test("SocketWildcardBindTest", "1.0") {
        addTestCase("a given port that a listener holds on 127.0.0.1 is refused", \givenPortLoopbackTest());
        addTestCase("a given port that a listener holds on 0.0.0.0 is refused", \givenPortWildcardTest());
        addTestCase("a system-assigned port is one that no IPv4 listener holds", \systemPortTest());
        addTestCase("a server restarted on its port while its connections are in TIME_WAIT binds the port",
            \timeWaitTest());
        addTestCase("a datagram socket on all interfaces is refused a port held for IPv4", \datagramTest());
        addTestCase("a given port on which no socket listens is bound and serves IPv4 clients", \freePortTest());
        addTestCase("a given port that another program binds by number while connections hold it is reported",
            \takenFreePortTest());
        set_return_value(main());
    }

    #! returns a listening TCP socket on the given IPv4 address and a system-assigned or given port
    private static Socket listener(string address, int port = 0) {
        Socket s();
        s.bindINET(address, port, True, AF_INET);
        s.listen();
        return s;
    }

    #! returns the port of a connection to a listener on 127.0.0.1 that is then closed, and the connection's sockets
    /** No socket listens on the port, the system assigns the port to no other socket while the connection holds it
        (neither to a bind of port 0 nor to a connect() of any destination), and a bind of the port is refused unless
        it reuses the address, as the bind of a server restarted on its port does.  A port that is released before it
        is bound again could be taken by a concurrent program first.  Another program can still bind the port by
        number with \c SO_REUSEADDR, as one that restarts a server on a port that it had released does, and listen
        on it; no socket keeps such a bind from the port (see bindFreePort())
    */
    private static list<auto> connectionHeldPort() {
        Socket probe = listener("127.0.0.1");
        on_exit probe.close();
        int port = probe.getSocketInfo(False).port;
        Socket client();
        client.connect(sprintf("127.0.0.1:%d", port), 5s);
        Socket peer = probe.accept(5s);
        return (port, client, peer);
    }

    #! returns a bound datagram socket on the given IPv4 address
    private static Socket datagram(string address, int port = 0, bool reuse = False) {
        Socket s();
        s.bindINET(address, port, reuse, AF_INET, SOCK_DGRAM);
        return s;
    }

    #! the binds on all interfaces of a given port, each returning the socket bound or throwing the bind's error
    private static hash<string, code> wildcardBinds() {
        return {
            "bindINET() without an address": Socket sub (int port) {
                Socket s();
                s.bindINET(NOTHING, port, True);  # all-interfaces: tests the bind on all interfaces
                return s;
            },
            "bindINET() on the IPv6 wildcard address": Socket sub (int port) {
                Socket s();
                s.bindINET("::", port, True, AF_INET6);  # all-interfaces: tests the bind on all interfaces
                return s;
            },
            "bindINET() on the IPv4 wildcard address": Socket sub (int port) {
                Socket s();
                s.bindINET("0.0.0.0", port, True, AF_INET);  # all-interfaces: tests the bind on all interfaces
                return s;
            },
            "bind() with a port": Socket sub (int port) {
                Socket s();
                if (s.bind(port, True)) {
                    throw "SOCKET-BIND-ERROR", sprintf("bind(%d) failed: %s", port, strerror());
                }
                return s;
            },
        };
    }

    #! asserts that every bind on all interfaces of the port is refused with SOCKET-BIND-ERROR (EADDRINUSE)
    private refusedEverywhere(int port, string holder, *list<string> skip) {
        foreach hash<auto> i in (wildcardBinds().pairIterator()) {
            if (inlist(i.key, skip)) {
                continue;
            }
            string label = sprintf("%s of port %d held on %s", i.key, port, holder);
            *Socket bound;
            *hash<ExceptionInfo> error;
            try {
                bound = i.value(port);
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            if (bound) {
                bound.close();
            }
            assertEq("SOCKET-BIND-ERROR", error.err, label + ": refused");
            assertRegex(strerror(EADDRINUSE), error.desc ?? "", label + ": the port is in use");
        }
    }

    givenPortLoopbackTest() {
        Socket other = listener("127.0.0.1");
        on_exit other.close();
        refusedEverywhere(other.getSocketInfo(False).port, "127.0.0.1");
    }

    givenPortWildcardTest() {
        Socket other = listener("0.0.0.0");
        on_exit other.close();
        refusedEverywhere(other.getSocketInfo(False).port, "0.0.0.0");
    }

    systemPortTest() {
        # hold the next system-assigned port and the HeldPorts free ports after it, in the order of the system's
        # assignment; a system that assigns ports in sequence (macOS) would give the next bind one of them if it did not
        # avoid them.  Concurrent programs, which take the ports that the system assigns next too, do not change how
        # many are held (see PortHolder::hold_next_free_ports())
        hash<string, Socket> held = PortHolder::hold_next_free_ports(HeldPorts);
        on_exit map $1.close(), held.iterator();
        assertEq(HeldPorts + 1, held.size(), sprintf("the next system-assigned port and the %d free ports after it "
            "are held (system-assigned ports: %y)", HeldPorts, PortHolder::ephemeral_range()));
        foreach hash<auto> i in (wildcardBinds().pairIterator()) {
            Socket s = i.value(0);
            on_exit s.close();
            int port = s.getSocketInfo(False).port;
            assertFalse(held.hasKey(port), sprintf("%s of port 0 got port %d, which no IPv4 listener holds",
                i.key, port));
            # an IPv4 client of the port reaches the socket
            s.listen();
            Socket client();
            on_exit client.close();
            client.connect(sprintf("127.0.0.1:%d", port), 5s);
            *Socket accepted = s.accept(5s);
            assertTrue(exists accepted, sprintf("%s: an IPv4 client of port %d reaches the socket", i.key, port));
            if (accepted) {
                accepted.close();
            }
        }
    }

    timeWaitTest() {
        int port;
        {
            Socket server();
            server.bindINET(NOTHING, 0, True);  # all-interfaces: tests the bind on all interfaces
            server.listen();
            port = server.getSocketInfo(False).port;
            Socket client();
            client.connect(sprintf("127.0.0.1:%d", port), 5s);
            Socket accepted = server.accept(5s);
            # the server closes first, so its end of the connection enters TIME_WAIT
            accepted.close();
            assertThrows("SOCKET-CLOSED", \client.recv(), (1, 5s), "the client reads the end of the connection");
            client.close();
            server.close();
        }
        # without SO_REUSEADDR the port cannot be bound while the closed connection holds it in TIME_WAIT; a kernel
        # whose table of TIME_WAIT connections is full (tcp_max_tw_buckets, as when many tests run at once in the
        # network namespace of a CI pod) closes the connection without keeping it, and then nothing holds the port:
        # the precondition is checked where the system's sockets show the TIME_WAIT connection, or cannot be read
        *list<string> states = PortHolder::tcp_local_states(port);
        if (!exists states || inlist("06", states)) {
            Socket s();
            on_exit s.close();
            # all-interfaces: tests the bind on all interfaces
            assertThrows("SOCKET-BIND-ERROR", \s.bindINET(), (NOTHING, port, False), "TIME_WAIT holds the port");
        }
        # the restarted server reuses the address and binds the port
        Socket restarted();
        on_exit restarted.close();
        try {
            restarted.bindINET(NOTHING, port, True);  # all-interfaces: tests the bind on all interfaces
            restarted.listen();
        } catch (hash<ExceptionInfo> ex) {
            # another program can bind the port by number while only the closed connection holds it, as for
            # freePortTest() (see bindFreePort())
            *list<string> listeners = PortHolder::tcp_listeners(port);
            if (listeners) {
                testSkip("another program listens on port %d (%s), which it bound by number while the closed "
                    "connection held it; no socket keeps such a bind from the port (%s: %s)", port,
                    join(", ", listeners), ex.err, ex.desc);
            }
            rethrow;
        }
        assertEq(port, restarted.getSocketInfo(False).port, "the restarted server binds its port");
    }

    datagramTest() {
        foreach string holder in (("127.0.0.1", "0.0.0.0")) {
            Socket other = datagram(holder);
            on_exit other.close();
            int port = other.getSocketInfo(False).port;
            # the UDP socket of an HTTP/3 listener on all interfaces
            Socket quic();
            on_exit quic.close();
            # all-interfaces: tests the bind on all interfaces
            assertThrows("SOCKET-BIND-ERROR", \quic.bindINET(), ("::", port, False, AF_INET6, SOCK_DGRAM),
                sprintf("an IPv6 wildcard datagram socket on port %d held on %s", port, holder));
            if (holder == "127.0.0.1") {
                # an IPv4 wildcard datagram socket that reuses the address
                Socket any();
                on_exit any.close();
                # all-interfaces: tests the bind on all interfaces
                assertThrows("SOCKET-BIND-ERROR", \any.bindINET(), (NOTHING, port, True, AF_UNSPEC, SOCK_DGRAM),
                    sprintf("a datagram socket on all interfaces on port %d held on 127.0.0.1", port));
            }
        }
    }

    freePortTest() {
        # a port on which no socket listens, which a connection holds so that the system assigns it to no other socket
        (int port, Socket held_client, Socket held_peer) = connectionHeldPort();
        on_exit {
            held_client.close();
            held_peer.close();
        }
        *string taken = bindFreePort(port);
        if (taken) {
            testSkip("%s", taken);
        }
    }

    takenFreePortTest() {
        # another program binds the held port by number, reusing the address, and listens on it, as a program that
        # restarts a server on a port that it had released does; the bind on all interfaces is then refused, and that
        # is reported as the cause instead of a failure of the bind
        (int port, Socket held_client, Socket held_peer) = connectionHeldPort();
        on_exit {
            held_client.close();
            held_peer.close();
        }
        Socket other;
        try {
            other = listener("127.0.0.1", port);
        } catch (hash<ExceptionInfo> ex) {
            # this system keeps the port from a bind by number while connections hold it: the given port is bound
            assertEq(NOTHING, bindFreePort(port), sprintf("the held port %d is bound (%s: %s)", port, ex.err,
                ex.desc));
            return;
        }
        on_exit other.close();
        assertTrue(PortHolder::tcp_listeners(port).val(), sprintf("the listener on port %d is reported", port));
        *string taken = bindFreePort(port);
        assertRegex(sprintf("another program listens on port %d", port), taken ?? "<nothing>");
    }

    #! binds the given port on all interfaces and checks that an IPv4 client reaches it
    /** @return why the port could not be bound if a socket listens on it, which another program can bind by number
        while connections hold it; the bind's exception is rethrown if no socket listens on the port
    */
    private *string bindFreePort(int port) {
        Socket s();
        on_exit s.close();
        try {
            s.bindINET(NOTHING, port, True);  # all-interfaces: tests the bind on all interfaces
            s.listen();
        } catch (hash<ExceptionInfo> ex) {
            # the held port is in use only if another program bound it by number with SO_REUSEADDR and listens on
            # it: the connections that hold it do not listen, and the system assigns it to no other socket
            *list<string> listeners = PortHolder::tcp_listeners(port);
            if (listeners) {
                return sprintf("another program listens on port %d (%s), which it bound by number while the test "
                    "held the port with connections, as a program that restarts a server on a port that it had "
                    "released does; no socket keeps such a bind from the port (%s: %s)", port,
                    join(", ", listeners), ex.err, ex.desc);
            }
            rethrow;
        }
        assertEq(port, s.getSocketInfo(False).port, "the given port is bound");
        Socket client();
        on_exit client.close();
        client.connect(sprintf("127.0.0.1:%d", port), 5s);
        assertTrue(exists s.accept(5s), "an IPv4 client reaches the socket");
    }
}
