#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - the peer's receive window as macOS and Linux report it for loopback TCP connections
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class DbgResetSocketFullWindowTest

#! dbg_reset_socket() raises an error instead of waiting forever when what was written cannot arrive
/** dbg_reset_socket() resets a connection once the peer has acknowledged everything written on it; when the peer's
    receive window is 0 with data left unacknowledged (its receive buffer is full and its program does not read), the
    data could only arrive once the peer's program reads, so it raises \c DBG-RESET-SOCKET-ERROR and leaves the socket
    open.  Debug builds only.
*/
class DbgResetSocketFullWindowTest inherits QUnit::Test {
    public {
        #! the bytes the peer writes: more than a client that does not read and the peer's send buffer take
        const WriteSize = 32 * 1024 * 1024;

        #! the most milliseconds a poll waits before the window is looked at again; it paces the checks only
        const PollPaceMs = 10;

        #! the calls of the send after which the test fails if the client's receive window has not closed (a hang
        #! guard: the window closes once the client's buffer is full)
        const MaxCalls = 6000;
    }

    constructor() : Test("DbgResetSocketFullWindowTest", "1.0") {
        addTestCase("a reset with data that cannot arrive raises an error", \fullWindowTest());
        set_return_value(main());
    }

    fullWindowTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_reset_socket() is only in debug builds of the library");
        }
        Socket listener();
        on_exit listener.close();
        listener.bindINET("127.0.0.1", 0, True, AF_INET);
        listener.listen();
        string target = sprintf("127.0.0.1:%d", listener.getSocketInfo(False).port);

        # a small answer arrives at once: the reset is made, and the client reads the answer
        {
            Socket client();
            on_exit client.close();
            client.connect(target, 5s);
            Socket peer = listener.accept(5s);
            on_exit peer.close();
            peer.send("answer");
            call_function("dbg_reset_socket", peer);
            assertFalse(peer.isOpen(), "the socket is closed by the reset");
            assertEq("answer", client.recv(6, 5s));
        }

        Socket client();
        on_exit client.close();
        client.connect(target, 5s);
        Socket peer = listener.accept(5s);
        on_exit peer.close();

        # without the peer's receive window, which the system's headers or kernel may not give, dbg_reset_socket()
        # cannot tell data that cannot arrive, and waits for it
        if (call_function("dbg_tcp_peer_window", peer) < 0) {
            testSkip("the system does not give the receive window that the peer of a TCP socket advertised");
        }

        # the peer writes, without blocking, more than the client's receive buffer and its own send buffer take, as the
        # client does not read: a non-blocking send writes until the socket would block, and then returns the poll
        # information.  The send is driven, waiting on the poll between the calls, until the socket would block and
        # the client's receive window is 0: the client's receive buffer is full, and nothing more can arrive until it
        # reads.  The poll's bound only paces the checks, as a window that closes does not wake it up
        AbstractPollOperation op = peer.startPollSend(binary(strmul("x", WriteSize)));
        int calls = 0;
        while (True) {
            *hash<SocketPollInfo> info = op.continuePoll();
            if (!info) {
                testSkip("the buffers took the whole write");
            }
            if (++calls > 1 && call_function("dbg_tcp_peer_window", peer) == 0) {
                break;
            }
            if (calls > MaxCalls) {
                assertTrue(False, sprintf("the client's receive window did not close after %d calls", calls));
                return;
            }
            Socket::poll((info,), PollPaceMs);
        }

        assertThrows("DBG-RESET-SOCKET-ERROR", "the peer's receive window is 0", \call_function(),
            ("dbg_reset_socket", peer));
        assertTrue(peer.isOpen(), "the socket is not closed");
    }
}
