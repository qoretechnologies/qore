#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - direct socket close wakes the event loop during c-ares resolution
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%exec-class Test

class Test inherits QUnit::Test {
    constructor() : QUnit::Test("close while resolving", "1.0", ARGV) {
        addTestCase("direct close wakes resolving connect", \closeWhileResolving());
        addTestCase("a failed worker wait aborts before result delivery", \workerRegistrationFailure());
        set_return_value(main());
    }

    closeWhileResolving() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("requires the debug DNS and native close hooks");
        }
        # The port receives the query but never answers. The resolver and operation timeouts
        # are longer than the test's guard, so neither can complete the connection in its place.
        Socket dns();
        dns.bindINET("127.0.0.1", "0", False, AF_INET, SOCK_DGRAM);
        on_exit dns.close();
        string servers = call_function("dbg_cares_set_servers", "127.0.0.1:" + dns.getSocketInfo().port);
        on_exit call_function("dbg_cares_set_servers", servers);
        hash<auto> opts = call_function("dbg_cares_set_query_options", {"tries": 1, "timeout_ms": 60000});
        on_exit call_function("dbg_cares_set_query_options", opts);

        Socket s();
        on_exit s.close();
        # Exercise creation of the callback, insertion in the socket list and operation map, and the initial recheck.
        foreach int stage in (1, 2, 3, 4) {
            assertEq(0, call_function("dbg_socket_generation_wake", s, stage), "no subscription before stage " + stage);
            Queue done = resolve(s);
            hash<SocketPollResultInfo> result = done.get(5s);
            assertEq("OUT-OF-MEMORY", result.ex.err, "generation wake allocation stage " + stage);
            assertTrue(result.canceled);
            assertEq(0, call_function("dbg_socket_generation_wake", s), "the partial subscription was released");
        }

        Queue done = resolve(s);
        # Wait for the actual generation subscription. The DNS port also has requests from the earlier operations.
        for (int i = 0; i < 500 && !call_function("dbg_socket_generation_wake", s); ++i) {
            usleep(10ms);
        }
        assertEq(1, call_function("dbg_socket_generation_wake", s), "the next connect registered its wake");
        assertTrue(dns.isDataAvailable(10s), "the connect operation issued a DNS query");
        call_function("dbg_close_socket_directly", s);
        hash<SocketPollResultInfo> result = done.get(5s);
        assertEq("SOCKET-CLOSED", result.ex.err);
    }

    workerRegistrationFailure() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("requires the debug registration hook");
        }
        Socket s();
        WorkerWait op(s);
        call_function("dbg_socket_generation_wake", s, 4);
        Queue done = AsyncIoController::submit(<SocketPollOperationInfo>{"sock": s, "spop": op,
            "owner": "worker-generation-wake", "to": 60s});
        hash<SocketPollResultInfo> result = done.get(5s);
        assertEq("OUT-OF-MEMORY", result.ex.err);
        assertTrue(result.canceled);
        assertTrue(op.aborted);
        assertEq(0, call_function("dbg_socket_generation_wake", s));
    }

    private Queue resolve(Socket s) {
        return AsyncIoController::submit(<SocketPollOperationInfo>{
            "sock": s,
            "spop": s.startPollConnect("close.qore-test.:80"),
            "owner": "close-while-resolving",
            "to": 60s,
        });
    }
}

#! A Qore worker reports a descriptorless wait to the I/O thread.
class WorkerWait inherits AbstractPollOperation<auto> {
    private { Socket s; }
    public { bool aborted = False; }

    constructor(Socket s) { self.s = s; }
    string getGoal() { return "wait"; }
    string getState() { return "waiting"; }
    bool goalReached() { return False; }
    *hash<SocketPollInfo> continuePoll() { return <SocketPollInfo>{"socket": s, "events": 0}; }
    auto getOutput() {}
    abort() { aborted = True; }
}
