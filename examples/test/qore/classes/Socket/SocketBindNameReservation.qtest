    A TCP socket bound to a name with addresses in more than one address family, such as "localhost", holds its port
    on the name's addresses in the other address families, so that a client connecting to the name, which tries the
    IPv6 address first, cannot reach another listener with the same port number in the other address family.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires Util

%exec-class SocketBindNameReservationTest

class SocketBindNameReservationTest inherits QUnit::Test {
    public {
        #! the number of ports that the given-port test tries; only a port range almost all in use exhausts them
        const MaxPortAttempts = 1024;
    }

    private {
        #! the hosts file that gives "localhost" both loopback addresses, in debug builds
        *string hosts_file;
    }

    constructor() : Test("SocketBindNameReservationTest", "1.0") {
        # "localhost" resolves to the addresses that the hosts file gives it; a hosts file of the test's own gives it
        # both loopback addresses, also where the system's gives it one, as in a podman container
        if (Option::HAVE_LIBRARY_DEBUGGING) {
            hosts_file = sprintf("%s%sqore-reservation-hosts-%d", tmp_location(), DirSep, getpid());
            File f();
            f.open2(hosts_file, O_CREAT | O_TRUNC | O_WRONLY);
            f.write("127.0.0.1\tlocalhost\n::1\tlocalhost\n");
            f.close();
            call_function("dbg_cares_set_hosts_file", hosts_file);
        }
        on_exit if (hosts_file) {
            call_function("dbg_cares_set_hosts_file", "");
            unlink(hosts_file);
        }
        addTestCase("the port is held in the other address family", \reservationTest());
        addTestCase("a client of the name reaches the socket", \connectByNameTest());
        addTestCase("closing the socket releases the port", \closeTest());
        addTestCase("rebinding the socket moves the reservation", \rebindTest());
        addTestCase("a given port in use in the other address family", \givenPortTest());
        addTestCase("an address family given for the bind", \familyTest());
        addTestCase("an IP address", \ipAddressTest());
        addTestCase("datagram sockets", \udpTest());
        set_return_value(main());
    }

    #! skips the test unless "localhost" has an IPv4 and an IPv6 loopback address that can both be bound
    private checkLocalhost() {
        hash<string, bool> families;
        foreach hash<auto> ai in (getaddrinfo("localhost", NOTHING, AF_UNSPEC)) {
            families{ai.family} = True;
        }
        if (!families{AF_INET} || !families{AF_INET6}) {
            testSkip("\"localhost\" does not resolve to addresses in both address families");
        }
        Socket s6();
        on_exit s6.close();
        try {
            s6.bindINET("::1", 0, False, AF_INET6);
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("the IPv6 loopback address cannot be bound: %s: %s", ex.err, ex.desc));
        }
    }

    #! returns the loopback address and family other than the family given
    private static list<auto> otherLoopback(int family) {
        return family == AF_INET ? ("::1", AF_INET6) : ("127.0.0.1", AF_INET);
    }

    #! binds and listens on "localhost" with an ephemeral port and returns the socket's info
    private hash<auto> listenLocalhost(Socket s) {
        s.bind("localhost:0", True);
        s.listen();
        hash<auto> info = s.getSocketInfo(False);
        assertTrue(info.port > 0, "an ephemeral port was bound");
        return info;
    }

    #! asserts that the port can or cannot be bound on the other loopback address
    private assertOtherBindable(hash<auto> info, bool bindable, string msg) {
        (string addr, int family) = SocketBindNameReservationTest::otherLoopback(info.family);
        Socket other();
        on_exit other.close();
        if (bindable) {
            other.bindINET(addr, info.port, True, family);
            assertEq(info.port, other.getSocketInfo(False).port, msg);
            return;
        }
        # a bind of a port that the reservation holds is refused; with SO_REUSEADDR also on Linux, while macOS allows
        # it for a program of the same user on a port that only a connection holds, as the reservation does there
        assertThrows("SOCKET-BIND-ERROR", \other.bindINET(), (addr, info.port, False, family), msg);
        if (PlatformOS != "Darwin") {
            assertThrows("SOCKET-BIND-ERROR", \other.bindINET(), (addr, info.port, True, family),
                msg + " (SO_REUSEADDR)");
        }
    }

    reservationTest() {
        checkLocalhost();
        Socket s();
        on_exit s.close();
        hash<auto> info = listenLocalhost(s);
        assertOtherBindable(info, False, "the port is held in the other address family");

        # a connection to the other loopback address is refused at once, as no socket listens there; it must not time
        # out, as a client of the name that tries that address first would wait for it
        (string addr, int family) = SocketBindNameReservationTest::otherLoopback(info.family);
        Socket c();
        *hash<ExceptionInfo> err;
        try {
            c.connectINET(addr, info.port, 10s, family);
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq("SOCKET-CONNECT-ERROR", err.err, "the connection fails");
        assertRegex(strerror(ECONNREFUSED), err.desc ?? "", "the connection is refused");
    }

    connectByNameTest() {
        checkLocalhost();
        Socket s();
        on_exit s.close();
        hash<auto> info = listenLocalhost(s);
        Socket c();
        on_exit c.close();
        c.connect("localhost:" + info.port, 10s);
        Socket a = s.accept(10s);
        on_exit a.close();
        c.send("ping");
        assertEq("ping", a.recv(4, 10s), "the client reached the socket bound to the name");
        assertEq(info.family, c.getPeerInfo(False).family, "the client connected in the socket's address family");
    }

    closeTest() {
        checkLocalhost();
        Socket s();
        hash<auto> info = listenLocalhost(s);
        s.close();
        assertOtherBindable(info, True, "the port can be bound in the other address family after the close");
    }

    rebindTest() {
        checkLocalhost();
        Socket s();
        on_exit s.close();
        hash<auto> info1 = listenLocalhost(s);
        # binding the socket again closes it first, which releases the port in both address families
        hash<auto> info2 = listenLocalhost(s);
        assertOtherBindable(info2, False, "the new port is held in the other address family");
        if (info1.port != info2.port) {
            assertOtherBindable(info1, True, "the previous port is released in the other address family");
        }
    }

    givenPortTest() {
        checkLocalhost();
        # find the address family that "localhost" is bound in
        Socket probe();
        hash<auto> info = listenLocalhost(probe);
        probe.close();
        (string addr, int family) = SocketBindNameReservationTest::otherLoopback(info.family);

        # another socket holds a port in the other address family; a bind to the name with that port as before
        # binds the name's first address that can be bound.  The system assigns the holder's port in the other address
        # family, and concurrent programs can use the port in the name's: macOS assigns a port of one family without
        # checking the other.  The port of the name's first address is therefore bound too, by a listener that a
        # connection to it then replaces: no socket listens on the port, the system assigns it to no concurrent
        # program, and the bind of the name, which reuses the address, can take it.  The listener reuses the address
        # too: Linux lets a socket bind an address and port that a connection holds only if both sockets reuse the
        # address, and the accepted connection has the listener's setting (macOS lets a program bind a port that only
        # a connection of the same user holds).  A port in use at the name's first address is replaced by the next one
        # that the system assigns in the other family
        string first_addr = info.family == AF_INET6 ? "::1" : "127.0.0.1";
        *Socket holder;
        *Socket held_client;
        *Socket held_peer;
        on_exit {
            map $1.close(), (holder, held_client, held_peer), $1;
        }
        int port;
        for (int attempt = 0; attempt < MaxPortAttempts && !port; ++attempt) {
            Socket other();
            other.bindINET(addr, 0, False, family);
            other.listen();
            int candidate = other.getSocketInfo(False).port;
            Socket listener();
            try {
                listener.bindINET(first_addr, candidate, True, info.family);
                listener.listen();
            } catch (hash<ExceptionInfo> ex) {
                # the port is in use at the name's first address; the next one is tried
                other.close();
                continue;
            }
            Socket client();
            client.connect(sprintf("%s:%d", info.family == AF_INET6 ? "[::1]" : first_addr, candidate), 5s);
            held_peer = listener.accept(5s);
            listener.close();
            held_client = client;
            holder = other;
            port = candidate;
        }
        assertGt(0, port, "a port free at the name's first address is held in the other address family");
        Socket s();
        on_exit s.close();
        assertEq(0, s.bind("localhost:" + port, True), sprintf("the name is bound with the given port: %s",
            strerror(errno())));
        s.listen();
        assertEq(port, s.getSocketInfo(False).port, "the given port was bound");
        assertEq(info.family, s.getSocketInfo(False).family, "the name's first address was bound");
    }

    familyTest() {
        checkLocalhost();
        # with an address family given for the bind, the name is bound in that family only, and the port is still
        # held on the name's addresses in the other family, so that a client connecting to the name does not reach
        # another listener there
        foreach int family in ((AF_INET, AF_INET6)) {
            Socket s();
            on_exit s.close();
            s.bindINET("localhost", 0, True, family);
            s.listen();
            hash<auto> info = s.getSocketInfo(False);
            assertEq(family, info.family);
            assertOtherBindable(info, False, sprintf("the port is held in the other address family (%d)", family));
        }
    }

    ipAddressTest() {
        checkLocalhost();
        # an IP address has no addresses in other address families
        Socket s();
        on_exit s.close();
        s.bind("127.0.0.1:0", True);
        s.listen();
        assertOtherBindable(s.getSocketInfo(False), True, "no port is held for an IP address");
    }

    udpTest() {
        checkLocalhost();
        # a datagram to an address that is bound but never read would be lost instead of refused, so no port is held
        Socket s();
        on_exit s.close();
        s.bindINET("localhost", 0, True, AF_UNSPEC, SOCK_DGRAM);
        hash<auto> info = s.getSocketInfo(False);
        (string addr, int family) = SocketBindNameReservationTest::otherLoopback(info.family);
        Socket other();
        on_exit other.close();
        other.bindINET(addr, info.port, True, family, SOCK_DGRAM);
        assertEq(info.port, other.getSocketInfo(False).port, "no port is held for a datagram socket");
    }
}
