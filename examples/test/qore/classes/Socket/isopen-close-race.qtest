    DEALINGS IN THE SOFTWARE.

    Regression test for Socket::isOpen() called while another thread closes the socket.

    The close releases the socket's descriptor on the socket's I/O thread, with the socket's close lock held, while
    isOpen() reads the descriptor without a lock, so the descriptor was a data race (reported by ThreadSanitizer).
    The test makes a thread call isOpen() while another thread closes the socket, with nothing that orders the calls
    with the close, which is what ThreadSanitizer needs to report the race: it must report nothing.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class IsOpenCloseRaceTest

class IsOpenCloseRaceTest inherits QUnit::Test {
    constructor() : Test("IsOpenCloseRaceTest", "1.0") {
        addTestCase("isOpen() while another thread closes the socket", \isOpenCloseTest());
        set_return_value(main());
    }

    private isOpenCloseTest() {
        Socket listener();
        listener.bindINET("127.0.0.1", "0", True, AF_INET);
        listener.listen();
        on_exit listener.close();
        int port = listener.getSocketInfo().port;

        for (int i = 0; i < 20; ++i) {
            Socket client();
            client.connect("127.0.0.1:" + port);
            Socket peer = listener.accept();
            on_exit peer.close();

            assertTrue(client.isOpen(), "the socket is open before the close");
            # the checking thread calls isOpen() after the counter that lets the close go ahead, so nothing orders its
            # calls with the close; the calls are bounded, as a thread waiting for the close would not end under
            # valgrind, which runs one thread at a time
            Counter checking(1);
            Counter done(1);
            background sub () {
                on_exit done.dec();
                checking.dec();
                for (int c = 0; c < 1000 && client.isOpen(); ++c) {
                }
            }();
            checking.waitForZero();
            client.close();
            done.waitForZero();
            assertFalse(client.isOpen(), "the socket is closed after the close");
        }
    }
}
