%modern

%requires QUnit

%exec-class SocketStreamFlushedTest

class SocketStreamFlushedTest inherits QUnit::Test {
    constructor() : QUnit::Test("SocketStreamFlushed", "1.0") {
        addTestCase("the flush waits raise an error without a session", \noSessionTest());
        set_return_value(main());
    }

    noSessionTest() {
        Socket s();
        assertThrows("HTTP2-ERROR", "no HTTP/2 session", \s.waitForHttp2StreamFlushed(), (1, 0));
        assertThrows("QUIC-ERROR", "no active QUIC session", \s.waitForQuicClientStreamFlushed(), (0, 0));
    }
}
