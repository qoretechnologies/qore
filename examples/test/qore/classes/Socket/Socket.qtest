class SocketTest inherits QUnit::Test {
    private {
        auto o;
        auto fam;

        const XString = "This is a binary string";
        const XBinary = Qore::binary(XString);

        Counter counter(1);

        Queue queue();
        Counter stopc();

        int server_port;
        int client_port;

        string client_host;

        const MyOpts = {
            "server"     : "S,server=s",
            "servonly"   : "O,server-only",
            "ipv4"       : "4,ipv4",
            "ipv6"       : "6,ipv6",
            "ssl"        : "s,ssl",
            "key"        : "k,private-key=s",
            "cert"       : "c,cert=s",
            "pass"       : "p,private-key-password=s",
            "clientkey"  : "K,client-private-key=s",
            "clientcert" : "C,client-cert=s",
            "events"     : "e,show-events",
        } + Opts;
    }

    constructor() : QUnit::Test("Socket test", "1.0", \ARGV, MyOpts) {
        process_command_line();

        addTestCase("Accept poll test", \acceptPollTest());
        addTestCase("HTTP response poll test", \httpResponsePollTest());
        addTestCase("send binary test", \sendBinaryTest());
        addTestCase("send close test", \sendCloseTest());
        addTestCase("poll test", \pollTest());
        addTestCase("tls13 test", \tls13Test());
        addTestCase("connection ID", \connectionIdTest());
        addTestCase("Client/Server Socket tests", \clientServerSocketTest());
        addTestCase("Unconnected Socket tests", \unconnectedSocketTest());
        addTestCase("Random Port tests", \randomPortSocketTest());
        addTestCase("SSL read test", \sslReadTest());
        addTestCase("SSL poll send partial test", \sslPollSendPartialTest());
        addTestCase("SSL write disconnect test", \sslWriteDisconnectTest());
        addTestCase("ALPN test", \alpnTest());
        set_return_value(main());
    }

    private doServ(Queue q) {
        Socket s0();
        # bind on a random free port
        s0.bind(0);
        s0.listen();
        q.push(s0.getSocketInfo().port);
        s0.setCertificate(TestCert);
        s0.setPrivateKey(TestCert);
        s0.acceptSSL();
    }

    acceptPollTest() {
        Socket s();
        s.bind("localhost:0");
        s.listen();
        int port = s.getSocketInfo().port;

        SocketPollOperation spop = s.startPollAccept();
        assertEq("accept", spop.getGoal());
        assertEq("accepting", spop.getState());

        string str = get_random_string(50);

        background sub () {
            Socket s0();
            s0.connect("localhost:" + port);
            s0.send(str);
        }();

        while (*hash<SocketPollInfo> info = spop.continuePoll()) {
            Socket::poll((info,), 100ms);
        }
        assertEq("accepted", spop.getState());
        assertTrue(spop.goalReached());

        Socket s1 = spop.getOutput();
        string str0 = s1.recv(str.size());
        assertEq(str, str0);

        s.setCertificate(TestCert);
        s.setPrivateKey(TestCert);
        s.bind("localhost:0");
        s.listen();
        port = s.getSocketInfo().port;

        spop = s.startPollAccept();
        assertEq("accept", spop.getGoal());
        assertEq("accepting", spop.getState());

        str = get_random_string(50);

        background sub () {
            Socket s0();
            s0.connectSSL("localhost:" + port);
            s0.send(str);
        }();

        while (*hash<SocketPollInfo> info = spop.continuePoll()) {
            #printf("info: %y -> %y\n", info, spop.getState());
            Socket::poll((info,), 100ms);
        }
        assertEq("accepted", spop.getState());
        assertTrue(spop.goalReached());

        s1 = spop.getOutput();
        str0 = s1.recv(str.size());
        assertEq(str, str0);
    }

    httpResponsePollTest() {
        # Test startPollSendHttpResponse method

        # Test 1: Simple response with body
        {
            Socket server();
            server.bind("localhost:0");
            server.listen();
            int port = server.getSocketInfo().port;

            # Background thread to receive and verify the HTTP response
            Counter cnt(1);
            hash<auto> http_response;
            background sub () {
                Socket client();
                client.connect("localhost:" + port);
                # Send an HTTP request
                client.send("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
                # Read the response using HTTP-aware methods
                http_response = client.readHTTPHeader(5s);
                if (http_response."content-length") {
                    http_response.body = client.recv(http_response."content-length", 1s);
                }
                cnt.dec();
            }();

            # Accept the connection
            Socket conn = server.accept(5s);

            # Read the request using HTTP-aware methods
            hash<auto> req = conn.readHTTPHeader(5s);
            assertEq("GET", req.method);

            # Send response using poll method
            string body = "Hello, World!";
            hash<auto> headers = {
                "Content-Type": "text/plain",
                "X-Custom-Header": "test-value",
            };

            SocketPollOperation spop = conn.startPollSendHttpResponse(200, "OK", "1.1", headers, body);
            assertEq("send-http-response", spop.getGoal());

            # Complete the send
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                Socket::poll((info,), 100ms);
            }
            assertTrue(spop.goalReached());

            # Wait for client to receive and verify
            cnt.waitForZero(5s);

            # Verify the response
            assertEq(200, http_response.status_code);
            assertEq("text/plain", http_response."content-type");
            assertEq("test-value", http_response."x-custom-header");
            assertEq("13", http_response."content-length");
            assertEq("Hello, World!", http_response.body);
        }

        # Test 2: Response without body (should have Content-Length: 0)
        {
            Socket server();
            server.bind("localhost:0");
            server.listen();
            int port = server.getSocketInfo().port;

            Counter cnt(1);
            hash<auto> http_response;
            background sub () {
                Socket client();
                client.connect("localhost:" + port);
                client.send("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
                http_response = client.readHTTPHeader(5s);
                cnt.dec();
            }();

            Socket conn = server.accept(5s);
            conn.readHTTPHeader(5s);

            SocketPollOperation spop = conn.startPollSendHttpResponse(204, "No Content", "1.1", {}, NOTHING);
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                Socket::poll((info,), 100ms);
            }
            assertTrue(spop.goalReached());

            cnt.waitForZero(5s);
            assertEq(204, http_response.status_code);
            assertEq("0", http_response."content-length");
        }

        # Test 3: Response with binary body
        {
            Socket server();
            server.bind("localhost:0");
            server.listen();
            int port = server.getSocketInfo().port;

            Counter cnt(1);
            hash<auto> http_response;
            background sub () {
                Socket client();
                client.connect("localhost:" + port);
                client.send("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
                http_response = client.readHTTPHeader(5s);
                if (http_response."content-length") {
                    http_response.body = client.recvBinary(http_response."content-length", 1s);
                }
                cnt.dec();
            }();

            Socket conn = server.accept(5s);
            conn.readHTTPHeader(5s);

            binary bin_body = <48656c6c6f>; # "Hello" in hex
            SocketPollOperation spop = conn.startPollSendHttpResponse(200, "OK", "1.1",
                {"Content-Type": "application/octet-stream"}, bin_body);
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                Socket::poll((info,), 100ms);
            }
            assertTrue(spop.goalReached());

            cnt.waitForZero(5s);
            assertEq(200, http_response.status_code);
            assertEq("5", http_response."content-length");
            assertEq(<48656c6c6f>, http_response.body);
        }

        # Test 4: Content-Length header in input should be ignored
        {
            Socket server();
            server.bind("localhost:0");
            server.listen();
            int port = server.getSocketInfo().port;

            Counter cnt(1);
            hash<auto> http_response;
            background sub () {
                Socket client();
                client.connect("localhost:" + port);
                client.send("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
                http_response = client.readHTTPHeader(5s);
                if (http_response."content-length") {
                    http_response.body = client.recv(http_response."content-length", 1s);
                }
                cnt.dec();
            }();

            Socket conn = server.accept(5s);
            conn.readHTTPHeader(5s);

            # Pass wrong Content-Length - should be ignored and replaced with correct value
            SocketPollOperation spop = conn.startPollSendHttpResponse(200, "OK", "1.1",
                {"Content-Length": "9999", "Content-Type": "text/plain"}, "test");
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                Socket::poll((info,), 100ms);
            }
            assertTrue(spop.goalReached());

            cnt.waitForZero(5s);
            assertEq(200, http_response.status_code);
            # Should have correct Content-Length (4), not the wrong one (9999)
            assertEq("4", http_response."content-length");
            assertEq("test", http_response.body);
        }
    }

    sendBinaryTest() {
        {
            Socket s0();
            Socket s1();

            if (s0.bind("127.0.0.1:0", True)) {
                throw "SOCKET-BIND-ERROR", strerror();
            }
            s0.listen();
            int port = s0.getSocketInfo().port;

            s1.connect("127.0.0.1:" + port);
            binary b = get_random_bytes(128 * 1024);

            Socket s2 = s0.accept(1ms);

            s1.send(b);

            binary b0;
            while (b0.size() != b.size()) {
                b0 += s2.recvBinary(-1);
            }
            assertEq(b, b0);
        }
        {
            # Use two queues to avoid race conditions - one for each direction
            Queue serverToClient();
            Queue clientToServer();
            int BinarySize = 128 * 1024;
            background sub () {
                Socket s0();

                if (s0.bind("127.0.0.1:0", True)) {
                    throw "SOCKET-BIND-ERROR", strerror();
                }
                s0.listen();
                int port = s0.getSocketInfo().port;

                s0.setCertificate(TestCert);
                s0.setPrivateKey(TestCert);
                serverToClient.push(port);

                Socket s2 = s0.acceptSSL(15s);
                # Receive all data - loop until we get the expected size
                binary b0;
                while (b0.size() < BinarySize) {
                    assertTrue(s2.isDataAvailable(5s));
                    b0 += s2.recvBinary(-1, 1s);
                }
                # Push received data for client to verify
                serverToClient.push(b0);

                # Generate and send new data
                b0 = get_random_bytes(BinarySize);
                serverToClient.push(b0);
                s2.send(b0, 5s);

                # Wait for client verification result
                assertEq(True, clientToServer.get(10s));
            }();

            Socket s1();

            s1.connectSSL("127.0.0.1:" + serverToClient.get(2s));

            binary b = get_random_bytes(BinarySize);
            s1.send(b, 5s);
            # Verify server received what we sent
            assertEq(b, serverToClient.get(5s));

            # Get what server will send
            binary expected = serverToClient.get(10s);

            # Receive all data - loop until we get the expected size
            binary b1;
            while (b1.size() < BinarySize) {
                assertTrue(s1.isDataAvailable(5s));
                b1 += s1.recvBinary(-1, 1s);
            }
            # Verify received data matches what server sent
            assertEq(expected, b1);
            # Signal success to server
            clientToServer.push(True);
        }
    }

    sendCloseTest() {
        Socket s0();
        Socket s1();

        if (s0.bind("127.0.0.1:0", True)) {
            throw "SOCKET-BIND-ERROR", strerror();
        }
        s0.listen();
        int port = s0.getSocketInfo().port;

        s1.connect("127.0.0.1:" + port);
        string str = get_random_string(256);

        Socket s2 = s0.accept(1ms);

        s1.send(str);
        s1.close();

        string str0 = s2.recv(-1);
        assertEq(str, str0);
    }

    pollTest() {
        Socket s0();
        Socket s1();

        list<hash<SocketPollInfo>> poll_list = (
            <SocketPollInfo>{
                "events": SOCK_POLLIN,
                "socket": s0,
            },
            <SocketPollInfo>{
                "events": SOCK_POLLOUT,
                "socket": s1,
            },
        );

        list<hash<SocketPollInfo>> new_list;

        {
            if (s0.bind("127.0.0.1:0", True)) {
                throw "SOCKET-BIND-ERROR", strerror();
            }
            s0.listen();
            int port = s0.getSocketInfo().port;

            Socket s2();

            {
                SocketPollOperation spop = s2.startPollConnect("-1");
                assertThrows("SOCKET-NON-BLOCK-ERROR", \s2.startPollConnect(), "x");
                assertThrows("SOCKET-NON-BLOCK-ERROR", \s2.connect(), "x");
                assertThrows("SOCKET-NON-BLOCK-ERROR", \s2.startPollSend(), "x");
                assertThrows("SOCKET-NON-BLOCK-ERROR", \s2.startPollRecvString(), 1234);
                assertThrows("SOCKET-NON-BLOCK-ERROR", \s2.startPollRecvBinary(), 1234);
                assertEq("connecting", spop.getState());
                assertThrows("SOCKET-CONNECT-ERROR", \spop.continuePoll());
            }
            {
                SocketPollOperation spop = s2.startPollConnect("65536");
                assertEq("connecting", spop.getState());
                assertThrows("SOCKET-CONNECT-ERROR", \spop.continuePoll());
            }
            assertThrows("SOCKET-NOT-OPEN", \s2.startPollSend(), <abcd>);
            assertThrows("SOCKET-NOT-OPEN", \s2.startPollRecvString(), 1234);
            assertThrows("SOCKET-NOT-OPEN", \s2.startPollRecvBinary(), 1234);

            string target = "127.0.0.1:" + port;
            SocketPollOperation spop = s2.startPollConnect(target);
            assertEq("connect", spop.getGoal());
            assertEq("connecting", spop.getState());
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                #printf("info: %y\n", info);
                new_list = Socket::poll((info,), 100ms);
            }
            assertEq("connected", spop.getState());
            assertTrue(spop.goalReached());

            assertTrue(s2.isOpen());
            assertTrue(s0.isOpen());
            assertTrue(s0.isDataAvailable());

            Socket s3 = s0.accept(1ms);
            string test_msg = get_random_string();
            s3.send(test_msg);

            string msg = s2.recv(-1);
            assertEq(test_msg, msg);

            spop = s3.startPollSend(test_msg);
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                #printf("send info: %y\n", info);
                new_list = Socket::poll((info,), 1s);
            }

            msg = s2.recv(test_msg.size());
            assertEq(test_msg, msg);

            spop = s3.startPollSend(test_msg);
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                #printf("recv info: %y\n", info);
                new_list = Socket::poll((info,), 1s);
            }

            spop = s2.startPollRecvString(test_msg.size());
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                #printf("recv info: %y\n", info);
                new_list = Socket::poll((info,), 1s);
            }
            assertEq(test_msg, spop.getOutput());

            s3.send(test_msg);
            spop = s2.startPollRecvBinary(test_msg.size());
            while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                #printf("recv info: %y\n", info);
                new_list = Socket::poll((info,), 1s);
            }
            assertEq(binary(test_msg), spop.getOutput());

            binary bigmsg = get_random_bytes(10 * 1024 * 1024);
            {
                SocketPollOperation spop_send = s3.startPollSend(bigmsg);
                SocketPollOperation spop_recv = s2.startPollRecvBinary(bigmsg.size());
                while (True) {
                    poll_list = ();
                    *hash<SocketPollInfo> info_send = spop_send.continuePoll();
                    if (info_send) {
                        #printf("send info: %y\n", info_send);
                        poll_list += info_send;
                    }
                    *hash<SocketPollInfo> info_recv = spop_recv.continuePoll();
                    if (info_recv) {
                        #printf("recv info: %y\n", info_recv);
                        poll_list += info_recv;
                    }
                    if (!poll_list) {
                        break;
                    }
                    new_list = Socket::poll(poll_list, 1s);
                }
                assertEq(bigmsg, spop_recv.getOutput());
            }

            {
                SocketPollOperation spop_send = s3.startPollSend(bigmsg);
                SocketPollOperation spop_recv = s2.startPollRecvData();
                binary bmsg;
                while (True) {
                    poll_list = ();
                    *hash<SocketPollInfo> info_send = s3 ? spop_send.continuePoll() : NOTHING;
                    #printf("send info: %y\n", info_send);
                    if (info_send) {
                        poll_list += info_send;
                    } else {
                        #printf("closing send socket\n");
                        delete s3;
                    }
                    while (True) {
                        *hash<SocketPollInfo> info_recv = spop_recv.continuePoll();
                        #printf("recv info: %y (s3: %y)\n", info_recv, exists s3);
                        if (info_recv) {
                            poll_list += info_recv;
                        } else {
                            binary b = spop_recv.getOutput();
                            #printf("got %d bytes\n", b.size());
                            bmsg += b;
                            if (!s2.isOpen()) {
                                break;
                            }
                            spop_recv = s2.startPollRecvData();
                            continue;
                        }
                        break;
                    }
                    if (!poll_list) {
                        break;
                    }
                    #printf("poll list: %N\n", poll_list);
                    new_list = Socket::poll(poll_list, 1s);
                }
                assertEq(bigmsg.size(), bmsg.size());
                assertEq(bigmsg.toSHA512(), bmsg.toSHA512());
            }

            {
                Queue q();
                background sub () {
                    Socket ssl();
                    # bind on a random free port
                    ssl.bind(0);
                    ssl.listen();

                    q.push(ssl.getSocketInfo().port);

                    ssl.setCertificate(TestCert);
                    ssl.setPrivateKey(TestCert);

                    Socket receiver = ssl.acceptSSL();

                    list<hash<SocketPollInfo>> recv_poll_list;

                    SocketPollOperation spop_recv = receiver.startPollRecvData();
                    binary bmsg;
                    while (True) {
                        *hash<SocketPollInfo> info_recv;
                        try {
                            info_recv = spop_recv.continuePoll();
                        } catch (hash<ExceptionInfo> ex) {
                            if (ex.err == "SOCKET-SSL-ERROR" && ex.desc =~ /EOF/) {
                                break;
                            }
                            rethrow;
                        }
                        #printf("TID %d: recv info: %y\n", gettid(), info_recv);
                        if (info_recv) {
                            recv_poll_list = (info_recv,);
                        } else {
                            binary b = spop_recv.getOutput();
                            #/*
                            #printf("TID %d: got %d bytes\n", gettid(), b.size());
                            if (b.size()) {
                                bmsg += b;
                                #printf("TID %d: got %d bytes (bmsg: %d)\n", gettid(), b.size(), bmsg.size());
                                if (bmsg.size() == bigmsg.size()) {
                                    break;
                                }
                            #} else {
                            #    printf("errno: %d %s (open: %y bin: %d <=> %d)\n", errno(), strerror(),
                            #        receiver.isOpen(), bmsg.size(), bigmsg.size());
                            }
                            if (!receiver.isOpen()) {
                                break;
                            }
                            spop_recv = receiver.startPollRecvData();
                            continue;
                        }
                        if (!recv_poll_list) {
                            break;
                        }
                        #printf("TID %d: errno: %d (%s) bin: %d <=> %d recv_poll_list: %N\n", gettid(), errno(),
                        #    strerror(), bmsg.size(), bigmsg.size(), recv_poll_list);
                        Socket::poll(recv_poll_list, 1m);
                    }
                    q.push(bmsg);
                }();

                Socket sender();
                port = q.get();
                sender.connectSSL("localhost:" + port);

                SocketPollOperation spop_send = sender.startPollSend(bigmsg);
                while (True) {
                    poll_list = ();
                    *hash<SocketPollInfo> info_send = sender ? spop_send.continuePoll() : NOTHING;
                    #printf("send info: %y\n", info_send);
                    if (info_send) {
                        poll_list += info_send;
                    } else {
                        break;
                    }
                    if (!poll_list) {
                        break;
                    }
                    #printf("poll list: %N\n", poll_list);
                    new_list = Socket::poll(poll_list, 1s);
                }
                binary bmsg = q.get();
                assertEq(bigmsg.size(), bmsg.size());
                assertEq(bigmsg.toSHA512(), bmsg.toSHA512());
            }

            Socket s4();
            if (s4.bind("127.0.0.1:0", True)) {
                throw "SOCKET-BIND-ERROR", strerror();
            }
            int port2 = s4.getSocketInfo().port;
            s4.close();
            s4.shutdown();
            target = "127.0.0.1:" + port2;
            spop = s2.startPollConnect(target);
            assertEq("connect", spop.getGoal());
            assertEq("connecting", spop.getState());
            {
                on_error printf("target %y\n", target);
                assertThrows("SOCKET-CONNECT-ERROR", sub () {
                    while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                        Socket::poll((info,), 1s);
                    }
                });
            }

            spop = s2.startPollConnectSsl(target);
            assertEq("connect-ssl", spop.getGoal());
            assertEq("connecting", spop.getState());
            assertThrows("SOCKET-CONNECT-ERROR", sub () {
                while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                    Socket::poll((info,), 1s);
                }
            });

            {
                msg = get_random_string();

                Queue q();
                background sub () {
                    Socket ssl();
                    # bind on a random free port
                    ssl.bind(0);
                    ssl.listen();

                    q.push(ssl.getSocketInfo().port);

                    ssl.setCertificate(TestCert);
                    ssl.setPrivateKey(TestCert);

                    Socket ns = ssl.acceptSSL();
                    SocketPollOperation spop0 = ns.startPollSend(msg);
                    while (*hash<SocketPollInfo> info = spop0.continuePoll()) {
                        #printf("send info: %y\n", info);
                        Socket::poll((info,), 1s);
                    }

                    spop0 = ns.startPollSend(msg);
                    while (*hash<SocketPollInfo> info = spop0.continuePoll()) {
                        #printf("send info: %y\n", info);
                        Socket::poll((info,), 1s);
                    }

                    spop0 = ns.startPollSend(msg);
                    while (*hash<SocketPollInfo> info = spop0.continuePoll()) {
                        #printf("send info: %y\n", info);
                        Socket::poll((info,), 1s);
                    }

                    spop0 = ns.startPollSend(bigmsg);
                    while (*hash<SocketPollInfo> info = spop0.continuePoll()) {
                        #printf("send info: %y\n", info);
                        Socket::poll((info,), 1s);
                    }
                }();

                int port3 = q.get();

                target = "127.0.0.1:" + port3;
                spop = s2.startPollConnectSsl(target);
                assertEq("connect-ssl", spop.getGoal());
                assertEq("connecting", spop.getState());
                while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                    #printf("recv info: %y\n", info);
                    new_list = Socket::poll((info,), 1s);
                }
                assertEq("connected", spop.getState());
                assertTrue(spop.goalReached());
                assertNothing(spop.getOutput());
                assertEq(msg, s2.recv(msg.size()));

                spop = s2.startPollRecvString(msg.size());
                while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                    #printf("recv info: %y\n", info);
                    new_list = Socket::poll((info,), 1s);
                }
                assertEq(msg, spop.getOutput());

                spop = s2.startPollRecvBinary(msg.size());
                while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                    #printf("recv info: %y\n", info);
                    new_list = Socket::poll((info,), 1s);
                }
                assertEq(binary(msg), spop.getOutput());

                spop = s2.startPollRecvBinary(bigmsg.size());
                while (*hash<SocketPollInfo> info = spop.continuePoll()) {
                    #printf("recv info: %y\n", info);
                    new_list = Socket::poll((info,), 1s);
                }
                assertEq(bigmsg, spop.getOutput());
            }

            {
                Queue q();
                background sub () {
                    Socket ssl();
                    # bind on a random free port
                    ssl.bind(0);
                    ssl.listen();

                    q.push(ssl.getSocketInfo().port);

                    ssl.accept();
                }();

                int port3 = q.get();

                target = "127.0.0.1:" + port3;
                spop = s2.startPollConnectSsl(target);
                assertEq("connect-ssl", spop.getGoal());
                assertEq("connecting", spop.getState());
                on_error printf("goal reached: %y state: %y output: %y\n", spop.goalReached(), spop.getState(), spop.getOutput());
                assertThrows("SOCKET-SSL-ERROR", sub () {
                    *hash<SocketPollInfo> info;
                    do {
                        info = spop.continuePoll();
                        if (info) {
                            Socket::poll((info,), 250ms);
                        }
                    } while (info);
                });
                assertFalse(spop.goalReached());
                assertNothing(spop.getOutput());
            }
        }

        # bind and listen again
        if (s0.bind("127.0.0.1:0", True)) {
            throw "SOCKET-BIND-ERROR", strerror();
        }
        s0.listen();
        int port = s0.getSocketInfo().port;

        s1.connect("127.0.0.1:" + port);
        Socket s2 = s0.accept();
        string test_msg = get_random_string();
        s2.send(test_msg);

        poll_list = (
            <SocketPollInfo>{
                "events": SOCK_POLLIN,
                "socket": s1,
            },
            <SocketPollInfo>{
                "events": SOCK_POLLOUT,
                "socket": s2,
            },
        );

        usleep(500ms);
        new_list = Socket::poll(poll_list, 5s);
        assertEq(2, new_list.size());
        assertEq(SOCK_POLLIN, new_list[0].events);
        assertEq(s1, new_list[0].socket);
        assertEq(SOCK_POLLOUT, new_list[1].events);
        assertEq(s2, new_list[1].socket);

        poll_list = (
            <SocketPollInfo>{
                "events": SOCK_POLLIN | SOCK_POLLOUT,
                "socket": s1,
            },
            <SocketPollInfo>{
                "events": SOCK_POLLIN | SOCK_POLLOUT,
                "socket": s2,
            },
        );

        new_list = Socket::poll(poll_list, 5s);
        assertEq(2, new_list.size());
        assertEq(SOCK_POLLIN | SOCK_POLLOUT, new_list[0].events);
        assertEq(s1, new_list[0].socket);
        assertEq(SOCK_POLLOUT, new_list[1].events);
        assertEq(s2, new_list[1].socket);

        string msg = s1.recv(-1);
        assertEq(test_msg, msg);

        new_list = Socket::poll(poll_list, 5s);
        assertEq(2, new_list.size());
        assertEq(SOCK_POLLOUT, new_list[0].events);
        assertEq(s1, new_list[0].socket);
        assertEq(SOCK_POLLOUT, new_list[1].events);
        assertEq(s2, new_list[1].socket);

        s1.close();
        assertThrows("SOCKET-NOT-OPEN", \Socket::poll(), (poll_list, 0s));

        new_list = poll_list;
        remove new_list[0].socket;
        assertThrows("SOCKET-POLL-ERROR", \Socket::poll(), (new_list, 1s));

        shift poll_list;
        new_list = poll_list;
        new_list[0].events = 0;
        assertThrows("SOCKET-POLL-ERROR", \Socket::poll(), (new_list, 1s));

        delete s2;
        assertThrows("OBJECT-ALREADY-DELETED", \Socket::poll(), (poll_list, 1s));

        # close socket in background
        s1.connect("127.0.0.1:" + port);
        s2 = s0.accept();

        Counter cnt(1);
        Queue q();
        code poll = sub () {
            list<hash<SocketPollInfo>> new_poll_list = (
                <SocketPollInfo>{
                    "events": SOCK_POLLIN,
                    "socket": s1,
                },
                <SocketPollInfo>{
                    "events": SOCK_POLLIN,
                    "socket": s2,
                },
            );
            cnt.dec();
            try {
                q.push(Socket::poll(new_poll_list, 30s));
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        };
        background poll();
        cnt.waitForZero();
        usleep(250ms);
        delete s1;
        auto v = q.get();
        on_error {
            printf("%y\n", v.fullType());
            map printf("%d: events: %y\n", $#, $1.events), v;
        }
        assertEq(SOCK_POLLERR, v[0].events);
    }

    tls13Test() {
        assertEq(0, qore_get_library_options() & QLO_DISABLE_TLS_13);

        # disable TLS 1.3
        qore_set_library_options(QLO_DISABLE_TLS_13);
        assertEq(QLO_DISABLE_TLS_13, qore_get_library_options() & QLO_DISABLE_TLS_13);

        Queue q();
        background doServ(q);

        Socket s1();
        s1.connectSSL("127.0.0.1:" + q.get());

        if (m_options.verbose > 2) {
            SocketTest::printf("server: secure connection (%s %s) from %s\n", s1.getSSLCipherName(), s1.getSSLCipherVersion(),
                s1.getPeerInfo().address_desc);
        }
        assertNeq("TLSv1.3", s1.getSSLCipherVersion());
    }

