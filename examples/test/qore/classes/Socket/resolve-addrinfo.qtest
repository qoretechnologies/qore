#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - getaddrinfo/getnameinfo through c-ares with the system resolver configuration
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class Test

class ResolveAddrInfoWorkerPollOperation inherits Qore::AbstractPollOperation<auto> {
    string getGoal() {
        return "reject-sync-resolve-addrinfo";
    }

    string getState() {
        return "resolving";
    }

    bool goalReached() {
        return False;
    }

    *hash<SocketPollInfo> continuePoll() {
        list<hash<auto>> ignored = Socket::resolveAddrInfo("127.0.0.1", "0", AF_INET,
            AI_NUMERICHOST | AI_NUMERICSERV);
        return NOTHING;
    }
}

class Test inherits QUnit::Test {
    constructor() : QUnit::Test("Socket resolveAddrInfo", "1.0", ARGV) {
        addTestCase("numeric host", \testNumericHost());
        addTestCase("global getaddrinfo", \testGlobalGetaddrinfo());
        addTestCase("global getaddrinfo async", \testGlobalGetaddrinfoAsync());
        addTestCase("global getnameinfo async", \testGlobalGetnameinfoAsync());
        addTestCase("passive wildcard", \testPassiveWildcard());
        addTestCase("numeric host error", \testNumericHostError());
        addTestCase("numeric restrictions reject resolvable names", \testNumericRestrictions());
        addTestCase("numeric service boundaries", \testNumericServiceBoundaries());
        addTestCase("canonical numeric address", \testCanonicalNumericAddress());
        addTestCase("sync resolution rejected from async worker",
            \testSyncResolutionRejectedFromAsyncWorker());
        set_return_value(main());
    }

    testNumericHost() {
        list<hash<auto>> l = Socket::resolveAddrInfo("127.0.0.1", "0", AF_INET,
            AI_NUMERICHOST | AI_NUMERICSERV);
        assertGt(0, l.size());
        assertAddressInfo(l[0], True);
        assertEq("127.0.0.1", l[0].address);
        assertEq(AF_INET, l[0].family);
        assertEq(0, l[0].port);
    }

    testGlobalGetaddrinfo() {
        list<hash<auto>> l = getaddrinfo("127.0.0.1", "0", AF_INET, AI_NUMERICHOST | AI_NUMERICSERV);
        assertGt(0, l.size());
        assertAddressInfo(l[0], True);
        assertEq("127.0.0.1", l[0].address);
        assertEq(AF_INET, l[0].family);
        assertEq(0, l[0].port);
    }

    testGlobalGetaddrinfoAsync() {
        Future f = getaddrinfo_async("127.0.0.1", "0", AF_INET, AI_NUMERICHOST | AI_NUMERICSERV);
        list<hash<auto>> l = f.get(10s);
        assertGt(0, l.size());
        assertAddressInfo(l[0], True);
        assertEq("127.0.0.1", l[0].address);
        assertEq(AF_INET, l[0].family);
        assertEq(0, l[0].port);
    }

    testGlobalGetnameinfoAsync() {
        Future f = getnameinfo_async("127.0.0.1", AF_INET, 12345);
        hash<auto> h = f.get(10s);
        assertTrue(exists h.address);
        assertTrue(exists h.address_desc);
        assertTrue(exists h.family);
        assertTrue(exists h.familystr);
        assertTrue(exists h.port);
        assertEq("127.0.0.1", h.address);
        assertEq(AF_INET, h.family);
        assertEq(12345, h.port);
    }

    testPassiveWildcard() {
        list<hash<auto>> l = Socket::resolveAddrInfo(NOTHING, "0", AF_UNSPEC,
            AI_PASSIVE | AI_NUMERICSERV);
        assertGt(0, l.size());
        assertAddressInfo(l[0], True);
        assertEq(0, l[0].port);
    }

    testNumericHostError() {
        assertThrows("QOREADDRINFO-GETINFO-ERROR", \Socket::resolveAddrInfo(),
            ("not-an-address", "80", AF_INET, AI_NUMERICHOST | AI_NUMERICSERV));
    }

    testSyncResolutionRejectedFromAsyncWorker() {
        EventNotifier notifier();
        ResolveAddrInfoWorkerPollOperation op();
        Queue result_queue = AsyncIoController::submit(<SocketPollOperationInfo>{
            "sock": notifier,
            "spop": op,
            "owner": "resolve-addrinfo-sync-worker-guard",
            "to": 10s,
        });

        hash<SocketPollResultInfo> result = result_queue.get(10s);
        assertEq("SOCKET-SYNC-ON-IO-THREAD-ERROR", result.ex.err);
        assertEq("reject-sync-resolve-addrinfo", result.spop.getGoal());
    }

    testNumericRestrictions() {
        assertThrows("QOREADDRINFO-GETINFO-ERROR", \Socket::resolveAddrInfo(),
            ("localhost", "80", AF_INET, AI_NUMERICHOST));
        assertThrows("QOREADDRINFO-GETINFO-ERROR", \Socket::resolveAddrInfo(),
            ("127.0.0.1", "http", AF_INET, AI_NUMERICSERV));

        foreach hash<auto> args in ((
                {"host": "localhost", "service": "80", "flags": AI_NUMERICHOST},
                {"host": "127.0.0.1", "service": "http", "flags": AI_NUMERICSERV})) {
            Future f = getaddrinfo_async(args.host, args.service, AF_INET, args.flags);
            assertThrows("QOREADDRINFO-GETINFO-ERROR", \f.get(), (10s,));
        }
    }

    testNumericServiceBoundaries() {
        foreach string service in (("0", "80", "65535")) {
            list<hash<auto>> addrs = Socket::resolveAddrInfo("127.0.0.1", service, AF_INET);
            assertGt(0, addrs.size());
            assertEq(int(service), addrs[0].port, "numeric ports retain their value without explicit hints");
        }
        foreach string service in (("65536", "999999999999999999999999", "-1", "80http")) {
            assertThrows("QOREADDRINFO-GETINFO-ERROR", \Socket::resolveAddrInfo(),
                ("127.0.0.1", service, AF_INET, AI_NUMERICSERV));
        }
    }

    testCanonicalNumericAddress() {
        list<hash<auto>> addrs = Socket::resolveAddrInfo("127.0.0.1", "80", AF_INET,
            AI_NUMERICHOST | AI_NUMERICSERV | AI_CANONNAME);
        assertGt(0, addrs.size());
        assertEq("127.0.0.1", addrs[0].canonname);
        assertEq(80, addrs[0].port);
    }

    private assertAddressInfo(hash<auto> h, bool expect_port) {
        assertTrue(exists h.address);
        assertTrue(exists h.address_desc);
        assertTrue(exists h.family);
        assertTrue(exists h.familystr);
        assertTrue(exists h.socktype);
        assertTrue(exists h.protocol);
        assertTrue(exists h.addrlen);
        assertEq(expect_port, exists h.port);
    }
}
