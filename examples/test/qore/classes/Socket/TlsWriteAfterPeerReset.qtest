class TlsWriteAfterPeerResetTest inherits QUnit::Test {
    public {
        #! upper bound on any blocking operation; a read that blocks until it fails the test
        const Timeout = 60s;

        #! the data the client writes: larger than the socket buffers, so the write is still going when the peer
        #! answers and resets
        const WriteSize = 8 * 1024 * 1024;

        #! what the peer answers before it resets the connection
        const Answer = "the peer's answer";
    }

    constructor() : Test("TlsWriteAfterPeerResetTest", "1.0") {
        addTestCase("plain: the answer is read after the write fails, then the end of the connection",
            \plainTest());
        addTestCase("TLS: the socket stays open after the write fails, the answer is read, then the end of the "
            "connection", \tlsTest());
        addTestCase("TLS: a socket kept open after a failed write is closed without a close_notify alert",
            \tlsNoCloseNotifyAfterFailedWriteTest());
        addTestCase("TLS server: a socket kept open after a failed write is closed without a close_notify alert",
            \tlsServerNoCloseNotifyAfterFailedWriteTest());
        addTestCase("TLS: a protocol error on a write closes the socket whatever errno holds",
            \tlsProtocolErrorClosesTest());
        set_return_value(main());
    }

    plainTest() {
        exchange(False);
    }

    tlsTest() {
        exchange(True);
    }

    #! Skips the test unless the library has its debugging hooks
    private requireDebugHooks() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hooks that observe and force the TLS behaviour are only in debug builds");
        }
    }

    #! After a write failed because of a peer reset (SSL_ERROR_SYSCALL), OpenSSL forbids SSL_shutdown(): the close of
    #! the socket kept open sends no close_notify alert, while the close of a healthy TLS socket does
    tlsNoCloseNotifyAfterFailedWriteTest() {
        requireDebugHooks();
        # a healthy connection: its close sends the alert
        {
            Socket listener();
            listener.setCertificate(new SSLCertificate(CertPem));
            listener.setPrivateKey(new SSLPrivateKey(KeyPem));
            listener.bind("localhost:0", True);
            listener.listen();
            on_exit listener.close();
            Queue accepted();
            background sub () {
                try {
                    Socket conn = listener.accept(Timeout);
                    conn.upgradeServerToSSL(Timeout);
                    accepted.push(conn);
                } catch (hash<ExceptionInfo> ex) {
                    accepted.push(ex.err);
                }
            }();
            Socket sock();
            sock.connectSSL(sprintf("localhost:%d", listener.getPort()), Timeout);
            auto conn = accepted.get(Timeout);
            assertEq(NT_OBJECT, conn.typeCode(), sprintf("the peer accepted the connection: %y", conn));
            int before = call_function("dbg_ssl_close_notify_count");
            sock.close();
            assertEq(before + 1, call_function("dbg_ssl_close_notify_count"), "a healthy close sends close_notify");
            call_function("dbg_reset_socket", conn);
        }
        # a connection whose write failed because of the peer's reset: its close sends none
        Socket sock = failedTlsWrite();
        int before = call_function("dbg_ssl_close_notify_count");
        sock.close();
        assertEq(before, call_function("dbg_ssl_close_notify_count"),
            "no close_notify is sent after a fatal write error");
    }

    #! The same on the server's side: the client resets the connection, so the server's write fails; the close of the
    #! server's socket kept open sends no close_notify alert
    tlsServerNoCloseNotifyAfterFailedWriteTest() {
        requireDebugHooks();
        Socket listener();
        listener.setCertificate(new SSLCertificate(CertPem));
        listener.setPrivateKey(new SSLPrivateKey(KeyPem));
        listener.bind("localhost:0", True);
        listener.listen();
        on_exit listener.close();
        Queue accepted();
        background sub () {
            try {
                Socket conn = listener.accept(Timeout);
                conn.upgradeServerToSSL(Timeout);
                accepted.push(conn);
            } catch (hash<ExceptionInfo> ex) {
                accepted.push(sprintf("%s: %s", ex.err, ex.desc));
            }
        }();
        Socket client();
        client.connectSSL(sprintf("localhost:%d", listener.getPort()), Timeout);
        auto conn = accepted.get(Timeout);
        assertEq(NT_OBJECT, conn.typeCode(), sprintf("the server accepted the connection: %y", conn));
        call_function("dbg_reset_socket", client);
        hash<ExceptionInfo> ex;
        try {
            conn.send(strmul("w", WriteSize), Timeout);
            fail("a write to a reset connection must fail");
        } catch (hash<ExceptionInfo> ex1) {
            ex = ex1;
        }
        assertEq("SOCKET-SSL-ERROR", ex.err, ex.desc);
        assertTrue(conn.isOpen(), "the server's socket stays open after the write failed");
        int before = call_function("dbg_ssl_close_notify_count");
        conn.close();
        assertEq(before, call_function("dbg_ssl_close_notify_count"),
            "no close_notify is sent by the server after a fatal write error");
    }

    #! An SSL_ERROR_SSL write failure closes the socket, also when errno holds a peer-close error from before
    tlsProtocolErrorClosesTest() {
        requireDebugHooks();
        Socket listener();
        listener.setCertificate(new SSLCertificate(CertPem));
        listener.setPrivateKey(new SSLPrivateKey(KeyPem));
        listener.bind("localhost:0", True);
        listener.listen();
        on_exit listener.close();
        Queue accepted();
        background sub () {
            try {
                Socket conn = listener.accept(Timeout);
                conn.upgradeServerToSSL(Timeout);
                accepted.push(conn);
            } catch (hash<ExceptionInfo> ex) {
                accepted.push(ex.err);
            }
        }();
        Socket sock();
        sock.connectSSL(sprintf("localhost:%d", listener.getPort()), Timeout);
        auto conn = accepted.get(Timeout);
        on_exit if (conn.typeCode() == NT_OBJECT) {
            call_function("dbg_reset_socket", conn);
        }
        call_function("dbg_force_ssl_error_ssl", sock);
        hash<ExceptionInfo> ex;
        try {
            sock.send("x", Timeout);
            fail("the forced protocol error must fail the write");
        } catch (hash<ExceptionInfo> ex1) {
            ex = ex1;
        }
        assertEq("SOCKET-SSL-ERROR", ex.err, ex.desc);
        # the TLS library's error is reported, not a transport failure
        assertRegex("decryption failed|bad record mac", ex.desc.lwr(), "the TLS protocol error is reported");
        assertEq(NOTHING, ex.arg, "the stale errno is not reported as a peer close");
        assertFalse(sock.isOpen(), "the socket is closed after a TLS protocol error");
    }

    #! Returns a TLS socket whose write failed because the peer answered and reset the connection; the socket is open
    private Socket failedTlsWrite() {
        Socket listener();
        listener.setCertificate(new SSLCertificate(CertPem));
        listener.setPrivateKey(new SSLPrivateKey(KeyPem));
        listener.bind("localhost:0", True);
        listener.listen();
        on_exit listener.close();
        Counter done(1);
        background sub () {
            on_exit done.dec();
            try {
                Socket conn = listener.accept(Timeout);
                conn.upgradeServerToSSL(Timeout);
                conn.recvBinary(1024, Timeout);
                call_function("dbg_reset_socket", conn);
            } catch (hash<ExceptionInfo> ex) {
            }
        }();
        Socket sock();
        sock.connectSSL(sprintf("localhost:%d", listener.getPort()), Timeout);
        try {
            sock.send(strmul("w", WriteSize), Timeout);
            fail("a write to a reset connection must fail");
        } catch (hash<ExceptionInfo> ex) {
        }
        assertEq(0, done.waitForZero(Timeout), "the peer finished");
        assertTrue(sock.isOpen(), "the socket stays open after the write failed");
        return sock;
    }

    #! The peer reads a little, answers and resets the connection while the client is writing
    private exchange(bool tls) {
        Socket listener();
        if (tls) {
            listener.setCertificate(new SSLCertificate(CertPem));
            listener.setPrivateKey(new SSLPrivateKey(KeyPem));
        }
        listener.bind("localhost:0", True);
        listener.listen();
        on_exit listener.close();

        Counter done(1);
        Queue peer_err();
        background sub () {
            on_exit done.dec();
            try {
                Socket conn = listener.accept(Timeout);
                if (tls) {
                    conn.upgradeServerToSSL(Timeout);
                }
                conn.recvBinary(1024, Timeout);
                conn.send(Answer, Timeout);
                # the client's data is left unread: the connection is reset
                if (Option::HAVE_LIBRARY_DEBUGGING) {
                    call_function("dbg_reset_socket", conn);
                } else {
                    conn.close();
                }
            } catch (hash<ExceptionInfo> ex) {
                peer_err.push(sprintf("%s: %s", ex.err, ex.desc));
            }
        }();

        Socket sock();
        if (tls) {
            sock.connectSSL(sprintf("localhost:%d", listener.getPort()), Timeout);
        } else {
            sock.connect(sprintf("localhost:%d", listener.getPort()), Timeout);
        }
        on_exit sock.close();

        hash<ExceptionInfo> ex;
        try {
            sock.send(strmul("w", WriteSize), Timeout);
            fail("a write to a reset connection must fail");
        } catch (hash<ExceptionInfo> ex1) {
            ex = ex1;
        }
        assertEq(0, done.waitForZero(Timeout), "the peer finished");
        assertEq(0, peer_err.size(), sprintf("the peer did not fail: %y", peer_err.size() ? peer_err.get() : NOTHING));

        string err = tls ? "SOCKET-SSL-ERROR" : "SOCKET-SEND-ERROR";
        assertEq(err, ex.err, sprintf("the write error (%s)", ex.desc));
        assertEq(NT_INT, ex.arg.typeCode(), "the errno is the exception argument");
        assertTrue(ex.arg == Err::EPIPE || ex.arg == Err::ECONNRESET || ex.arg == Err::ECONNABORTED,
            sprintf("the errno says the peer closed or reset the connection (%y)", ex.arg));
        assertTrue(sock.isOpen(), "the socket stays open after the write failed");

        # the answer was received before the reset, so it is read
        assertEq(Answer, sock.recv(Answer.size(), Timeout), "the peer's answer is read after the failed write");

        # the read after it returns the end of the connection at once; a read that waited would time out
        *string rest;
        *string read_err;
        try {
            rest = sock.recv(1, Timeout);
        } catch (hash<ExceptionInfo> ex2) {
            read_err = ex2.err;
        }
        assertNeq("SOCKET-TIMEOUT", read_err, "the read after the answer does not wait");
        assertTrue(exists read_err || !rest,
            sprintf("the read after the answer returns the end of the connection (got %y, %y)", rest, read_err));
    }
}
