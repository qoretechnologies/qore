%exec-class QuicE2ETest

class QuicE2ETest inherits QUnit::Test {
    private {
        Logger mLogger;
    }

    constructor() : QUnit::Test("QuicE2ETest", "1.0", \ARGV, Opts) {
        addTestCase("QUIC poll operation creation", \testQuicPollOpCreation());
        addTestCase("QUIC server initial state", \testQuicServerInitialState());
        addTestCase("QUIC client initial state", \testQuicClientInitialState());
        addTestCase("QUIC handshake over localhost", \testQuicHandshake());
        addTestCase("QUIC server cert/key validation", \testQuicServerCertKeyValidation());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("quic-e2e-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Helper: get the port a socket is bound to
    private int getSocketPort(Socket sock) {
        hash<auto> info = sock.getSocketInfo();
        return info.port;
    }

    #! Test creating QUIC poll operations for both client and server
    testQuicPollOpCreation() {
        # Server poll op
        Socket server_sock();
        server_sock.bindINET("127.0.0.1", "0", True, AF_INET, SOCK_DGRAM);
        server_sock.setCertificate(new SSLCertificate(CertPem));
        server_sock.setPrivateKey(new SSLPrivateKey(KeyPem));

        AbstractPollOperation server_op = server_sock.startPollQuicAccept();
        assertTrue(exists server_op, "server poll op created");
        assertFalse(server_op.goalReached(), "server goal not reached yet");

        # Client poll op
        Socket client_sock();
        client_sock.bindINET("127.0.0.1", "0", True, AF_INET, SOCK_DGRAM);

        int server_port = getSocketPort(server_sock);
        AbstractPollOperation client_op = client_sock.startPollQuicConnect("127.0.0.1", server_port);
        assertTrue(exists client_op, "client poll op created");
        assertFalse(client_op.goalReached(), "client goal not reached yet");
    }

    #! Test server poll operation initial state
    testQuicServerInitialState() {
        Socket server_sock();
        server_sock.bindINET("127.0.0.1", "0", True, AF_INET, SOCK_DGRAM);
        server_sock.setCertificate(new SSLCertificate(CertPem));
        server_sock.setPrivateKey(new SSLPrivateKey(KeyPem));

        AbstractPollOperation server_op = server_sock.startPollQuicAccept();
        # Server starts waiting for initial QUIC packet (handshake-recv state)
        assertEq("handshake-recv", server_op.getState(), "server starts in handshake-recv");
    }

    #! Test client poll operation initial state
    testQuicClientInitialState() {
        Socket server_sock();
        server_sock.bindINET("127.0.0.1", "0", True, AF_INET, SOCK_DGRAM);
        int server_port = getSocketPort(server_sock);

        Socket client_sock();
        client_sock.bindINET("127.0.0.1", "0", True, AF_INET, SOCK_DGRAM);

        AbstractPollOperation client_op = client_sock.startPollQuicConnect("127.0.0.1", server_port);
        # Client starts by sending the initial handshake packet
        string state = client_op.getState();
        assertTrue(state == "handshake-send" || state == "handshake-recv",
                   "client starts in handshake state: " + state);
    }

    #! Test QUIC handshake between client and server over localhost UDP
    testQuicHandshake() {
        AsyncSocketIo::AsyncSocketIoController ctrl(True);
        ctrl.start();
        on_exit {
            ctrl.stop();
        }

        # Create server socket (UDP)
        Socket server_sock();
        server_sock.bindINET("127.0.0.1", "0", True, AF_INET, SOCK_DGRAM);
        int server_port = getSocketPort(server_sock);
        assertTrue(server_port > 0, "server bound to port " + string(server_port));

        # Set certificate and key on server socket (required for QUIC/TLS 1.3)
        server_sock.setCertificate(new SSLCertificate(CertPem));
        server_sock.setPrivateKey(new SSLPrivateKey(KeyPem));

        # Create client socket (UDP) — needs to be bound for recvfrom
        Socket client_sock();
        client_sock.bindINET("127.0.0.1", "0", True, AF_INET, SOCK_DGRAM);

        # Start poll operations
        AbstractPollOperation server_op = server_sock.startPollQuicAccept();
        AbstractPollOperation client_op = client_sock.startPollQuicConnect("127.0.0.1", server_port);

        # Submit both to controller
        Queue server_q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": server_sock,
            "spop": server_op,
            "owner": "server",
            "to": 10s,
        });
        Queue client_q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client_sock,
            "spop": client_op,
            "owner": "client",
            "to": 10s,
        });

        # The client poll operation needs the HTTP/3 layer to be initialized before
        # we can submit a request. Use a background thread that waits for the client
        # to reach "reading" state (handshake + HTTP/3 setup complete), then submits
        # the request.
        Counter request_submitted(1);
        bool submit_error = False;
        string submit_error_msg;

        code request_submitter = sub() {
            on_exit request_submitted.dec();
            try {
                # Wait for client to reach "reading" state (HTTP/3 ready)
                # AbstractPollOperation doesn't provide event callbacks for state
                # transitions; use Queue.get() with short timeout to yield the thread
                # while the AsyncSocketIoController drives the handshake
                Queue yield_q();
                date deadline = now_us() + 10s;
                while (client_op.getState() != "reading") {
                    date remaining = deadline - now_us();
                    if (remaining <= 0us) {
                        submit_error = True;
                        submit_error_msg = "timeout waiting for client to reach reading state; "
                            "state=" + client_op.getState();
                        return;
                    }
                    try {
                        yield_q.get(min(remaining, 5ms));
                    } catch () {
                    }
                }

                # Now submit the GET request
                auto stream_id = client_sock.submitQuicRequest("GET", "/test");
                if (stream_id < 0) {
                    submit_error = True;
                    submit_error_msg = "submitQuicRequest returned negative stream_id";
                    return;
                }

                # Wake up the controller so it re-polls the client operation,
                # which will flush the queued HTTP/3 request frames over UDP
                ctrl.wake();
            } catch (hash<ExceptionInfo> ex) {
                submit_error = True;
                submit_error_msg = sprintf("%s: %s", ex.err, ex.desc);
            }
        };
        background request_submitter();

        # Wait for server to receive the request
        auto server_result = server_q.get(15000);

        # Wait for request submission thread
        assertEq(0, request_submitted.waitForZero(5s), "request submission completed");
        assertFalse(submit_error, "request submitted without error"
            + (submit_error ? ": " + submit_error_msg : ""));

        if (m_options.verbose > 1) {
            printf("server_result: %y\n", server_result);
            printf("server state: %s\n", server_op.getState());
            printf("server goalReached: %y\n", server_op.goalReached());
            printf("client state: %s\n", client_op.getState());
            printf("client goalReached: %y\n", client_op.goalReached());
        }

        # Verify server received the request
        assertEq(True, server_op.goalReached(), "server reached goal (received request)"
            + "; server_state=" + server_op.getState()
            + "; server_result=" + sprintf("%y", server_result));

        hash<auto> server_output = server_op.getOutput();
        assertEq("GET", server_output.method, "server received GET method");
        assertEq("/test", server_output.path, "server received /test path");
        assertTrue(server_output.stream_id >= 0, "server has valid stream id");
    }

    #! Test that missing cert/key is detected on first handshake packet
    testQuicServerCertKeyValidation() {
        # Create a UDP socket without cert/key
        Socket server_sock();
        server_sock.bindINET("127.0.0.1", "0", True, AF_INET, SOCK_DGRAM);

        # Can create the poll op without cert/key
        AbstractPollOperation server_op = server_sock.startPollQuicAccept();
        assertEq("handshake-recv", server_op.getState(),
                 "accept op created without cert/key, starts in handshake-recv");
        assertFalse(server_op.goalReached(), "goal not reached");
    }
}

namespace Opts {
    const opts = {
        "verbose": "verbose,v:i+",
    };
}
