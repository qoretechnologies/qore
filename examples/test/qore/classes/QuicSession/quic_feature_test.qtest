%modern

%requires ../../../../../qlib/QUnit.qm

# Set up SIGUSR1 handler to dump thread stacks for debugging
@debug {
    set_signal_handler(SIGUSR1, sub (int sig) {
        printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
            get_all_thread_call_stacks());
    });
}

%exec-class QuicFeatureTest

#! Test that QUIC/HTTP/3 support is detected and available
class QuicFeatureTest inherits QUnit::Test {
    constructor() : Test("QuicFeatureTest", "1.0") {
        addTestCase("HTTP3 feature detection", \testHttp3Feature());
        set_return_value(main());
    }

    #! Verify HTTP3 feature constant and feature list
    testHttp3Feature() {
        # HTTP2 is always available (required)
        assertTrue(HAVE_HTTP2, "HAVE_HTTP2 constant is true");

        # HTTP3 is always available (required)
        assertTrue(HAVE_HTTP3, "HAVE_HTTP3 constant is true");

        # Verify HTTP3 is in the feature list
        assertTrue(inlist_hard("HTTP3", get_feature_list()), "HTTP3 feature is registered");
    }
}
