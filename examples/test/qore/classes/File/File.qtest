#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%try-module xml
%define NoXml
%endtry

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires Util
%requires FsUtil
%requires QUnit

%exec-class FileTest

class FileTest inherits QUnit::Test {
    public {
        const Data = "äsdfaä";

        const Script = "printf(\"%s\", stdin.readBinary(10).toHex());";
    }

    constructor() : QUnit::Test("File", "1.0") {
        addTestCase("non-blocking I/O", \testNonBlockingIo());
        addTestCase("poll xml parse", \pollXmlParseTest());
        addTestCase("FileTest", \fileTest());
        addTestCase("File named calls", \namedCallTest());
        addTestCase("issue 3061", \issue3061());
        addTestCase("redirect test", \redirectTest());
        addTestCase("a closed file has no descriptor", \closedFileDescriptorTest());
        # writei8() and writei8LSB() wrote only 4 of the 8 bytes of the integer
        addTestCase("8-byte integers are written whole", \int8WriteTest());
        set_return_value(main());
    }

    testNonBlockingIo() {
        data content = get_random_string(512);
        testNonBlockingIoIntern(content);

        content = get_random_bytes(512);
        testNonBlockingIoIntern(content);

        content = get_random_bytes(10 * 1024 * 1024);
        testNonBlockingIoIntern(content);
    }

    testNonBlockingIoIntern(data content) {
        TmpFile tmp("qore-File-");
        tmp.file.write(content);
        tmp.file.close();

        File f();
        FilePollOperation fpop = f.startPollRead(tmp.path, content.typeCode() == NT_STRING);
        string label = sprintf("%d byte %s file: ", content.size(), content.type());
        assertEq("read-done", fpop.getGoal(), label + "goal: read-done");
        assertEq("reading", fpop.getState(), label + "reading");

        list<hash<SocketPollInfo>> new_list;
        while (*hash<SocketPollInfo> info = fpop.continuePoll()) {
            #printf("info: %y\n", info);
            new_list = Socket::poll((info,), 1s);
        }
        assertEq("read-done", fpop.getState(), label + "state: read-done");
        assertTrue(fpop.goalReached(), label + "goal reached");

        assertEq(content, fpop.getOutput(), label + "content matches");
    }

    pollXmlParseTest() {
%ifdef NoXml
        testSkip("no XML module present");
%else
        string xml = "<root><a>1</a></root>";
        TmpFile tmp("qore-File-");
        tmp.file.write(xml);
        tmp.file.close();

        File f();
        FilePollOperation fpop = f.startPollRead(tmp.path, True);
        while (*hash<SocketPollInfo> info = fpop.continuePoll()) {
            Socket::poll((info,), 1s);
        }
        assertTrue(fpop.goalReached(), "poll read goal reached");

        string xml_read = fpop.getOutput();
        assertEq(xml, xml_read, "poll read XML matches");
        hash parsed = parse_xml(xml_read, XPF_NONE);
        assertEq(NT_HASH, parsed.typeCode(), "parse_xml returned a hash");
        assertEq("1", parsed.root.a, "parse_xml content matches");

        TmpFile empty_tmp("qore-File-");
        empty_tmp.file.write("");
        empty_tmp.file.close();

        File f2();
        FilePollOperation fpop2 = f2.startPollRead(empty_tmp.path, True);
        while (*hash<SocketPollInfo> info2 = fpop2.continuePoll()) {
            Socket::poll((info2,), 1s);
        }
        assertEq("", fpop2.getOutput(), "empty poll read returns empty string");
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml(), ("", XPF_NONE));
%endif
    }

    fileTest() {
        string file = sprintf(tmp_location() + DirSep + get_random_string());
        {
            File f();
            f.open2(file, O_CREAT|O_WRONLY|O_TRUNC, 0666, "utf-8");
            f.write(Data);
        }
        on_exit unlink(file);

        ReadOnlyFile f(file);
        # issue 1547
        assertEq("ä", f.getchar());
        assertEq("s", f.getchar());
        f.setPos(0);
        # issue 1548
        assertEq("ä", f.read(1));
        assertEq("s", f.read(1));
        assertEq("dfaä", f.read(4));
        f.setPos(0);
        assertEq(Data, f.read(-1));
    }

    namedCallTest() {
        string path = sprintf(tmp_location() + DirSep + get_random_string());
        string binpath = sprintf(tmp_location() + DirSep + get_random_string());
        on_exit {
            if (is_file(path))
                unlink(path);
            if (is_file(binpath))
                unlink(binpath);
        }

        File f(encoding: "UTF-8");
        f.open2(path: path, flags: O_CREAT | O_RDWR | O_TRUNC, mode: 0600, encoding: "UTF-8");
        assertEq(3, f.write(data: "abc"));
        assertEq(3, f.print(data: "def"));
        assertEq(2, f.vprintf(format: "%s%d", values: ("x", 1)));
        assertEq(3, f.f_vprintf(format: "%3s", values: ("abcdef",)));
        f.setCharset(encoding: "UTF-8");
%ifdef HAVE_FILE_LOCKING
        assertEq(0, f.lock(lock_type: F_UNLCK, start: 0, length: 0, whence: SEEK_SET));
%endif
        f.setPos(0);
        assertEq("abcdefx1abc", f.read(-1));
        f.close();

        File opened(encoding: "UTF-8");
        assertEq(0, opened.open(path: path, flags: O_RDONLY, mode: 0600, encoding: "UTF-8"));
        opened.close();

        File bin();
        bin.open2(path: binpath, flags: O_CREAT | O_WRONLY | O_TRUNC, mode: 0600);
        bin.writei1(value: 0x12);
        bin.writei2LSB(value: 0x3456);
        bin.close();
        assertEq(<125634>, File::readBinaryFile(binpath));
    }

    issue3061() {
        # create a temporary Qore script
        string fn = sprintf("%s/%s", tmp_location(), get_random_string());
        {
            File f();
            f.open2(fn, O_CREAT|O_WRONLY|O_TRUNC);
            f.write(Script);
        }
        on_exit unlink(fn);

        # this test works on all platforms but was made for Windows; both children are the interpreter running this
        # test, as the qore found on PATH can be another version or missing
        string qore = shellQuote(getQoreExecutable());
        string hex = backquote(qore + ' -ne "printf(\"a\r\n\");" | ' + qore + " " + shellQuote(fn));
        assertEq("610d0a", hex);
    }

    #! Returns the interpreter running this test as an absolute path, so a child process runs the same build
    private static string getQoreExecutable() {
        string qore = ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        # a relative path is made absolute, as a child can run in another directory; a bare name is looked up in PATH
        return absolute_path(qore) || qore !~ /[\/\\]/ ? qore : getcwd() + DirSep + qore;
    }

    #! Quotes a string as one word for the shell
    private static string shellQuote(string str) {
%ifdef Windows
        return "\"" + str + "\"";
%else
        return "'" + replace(str, "'", "'\\''") + "'";
%endif
    }

    redirectTest() {
        string file = sprintf(tmp_location() + DirSep + get_random_string());
        File f();
        f.open2(file, O_CREAT|O_WRONLY|O_TRUNC);
        on_exit unlink(file);

        f.write("test1");
        assertEq("test1", ReadOnlyFile::readTextFile(file));
        assertEq("test", File::readTextFile(file, NOTHING, 4));
        assertEq("test".toBinary(), File::readBinaryFile(file, 4));

        stderr.redirect(target_file: f);
        stderr.setPos(0);
        stderr.write(data: "test2");

        assertEq("test2", ReadOnlyFile::readTextFile(file));
    }

    int8WriteTest() {
        string path = tmp_location() + DirSep + get_random_string();
        on_exit unlink(path);
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC, 0600);
        assertEq(8, f.writei8(0x0102030405060708), "writei8() writes 8 bytes");
        assertEq(8, f.writei8LSB(0x0102030405060708), "writei8LSB() writes 8 bytes");
        assertEq(8, f.writei8(-2), "writei8() writes 8 bytes of a negative integer");
        f.close();
        assertEq(<01020304050607080807060504030201fffffffffffffffe>, File::readBinaryFile(path),
            "the bytes of the integers in big-endian and little-endian order");

        ReadOnlyFile r(path);
        assertEq(0x0102030405060708, r.readi8(), "readi8() reads the integer written by writei8()");
        assertEq(0x0102030405060708, r.readi8LSB(), "readi8LSB() reads the integer written by writei8LSB()");
        assertEq(-2, r.readi8(), "readi8() reads the negative integer");
        assertEq(NOTHING, r.readi8(), "the end of the file");
    }

    closedFileDescriptorTest() {
        TmpFile tmp("qore-File-");
        assertGe(0, tmp.file.getPollableDescriptor(), "an open file has a descriptor");
        assertEq(0, tmp.file.close(), "the file is closed");
        assertFalse(tmp.file.isOpen(), "the file is not open after File::close()");
        assertEq(-1, tmp.file.getPollableDescriptor(), "a closed file has no descriptor");
        tmp.file.open2(tmp.path, O_RDONLY);
        assertGe(0, tmp.file.getPollableDescriptor(), "a reopened file has a descriptor");
    }
}
