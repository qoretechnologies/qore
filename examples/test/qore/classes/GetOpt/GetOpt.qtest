#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class Test

class Test inherits QUnit::Test {
    private {
        const O = (
            "outd" : "o,out=s",
            );

        const Args = ("-o", "ooo");
    }

    constructor() : QUnit::Test("GetOpt", "1.0") {
        addTestCase("GetOpt::parse(list)", \parseList());
        addTestCase("GetOpt named calls", \namedCallTest());
        set_return_value(main());
    }

    parseList() {
        list l = Args;

        GetOpt g(O);
        hash h = g.parse2(l);
        testAssertionValue("GetOpt::parse2(list)", Args, l);

        h = g.parse2(\l);
        testAssertionValue("GetOpt::parse2(list)", (), l);
    }

    namedCallTest() {
        list l = Args;
        GetOpt g(options: O);

        hash h = g.parse(arguments: \l);
        assertEq("ooo", h.outd);
        assertEq((), l);

        l = Args;
        h = g.parse2(arguments: \l);
        assertEq("ooo", h.outd);
        assertEq((), l);

        l = Args;
        h = g.parse3(arguments: \l);
        assertEq("ooo", h.outd);
        assertEq((), l);

        l = Args;
        h = GetOpt::parse(options: O, arguments: \l);
        assertEq("ooo", h.outd);
        assertEq((), l);

        l = Args;
        h = GetOpt::parseEx(options: O, arguments: \l);
        assertEq("ooo", h.outd);
        assertEq((), l);

        l = Args;
        h = GetOpt::parseExit(options: O, arguments: \l);
        assertEq("ooo", h.outd);
        assertEq((), l);
    }
}
