#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class IsSandboxedTest

#! Returns what the two queries answer in the current thread's code
hash<auto> sub queries() {
    return {"isSandboxed": SandboxManager::isSandboxed(), "isGoverned": SandboxManager::isGoverned()};
}

#! Verifies SandboxManager::isSandboxed()
/** The code that a sandboxed Program calls is created by the test, which no sandbox governs, before it is called,
    as trusted infrastructure creates the code that serves sandboxed callers: code created while serving a
    sandboxed caller carries its sandbox (see SandboxManager::callWithSystemPolicy())
*/
class IsSandboxedTest inherits QUnit::Test {
    private {
        #! the queries
        code plain = \queries();
        #! the queries under a policy barrier
        code barrier;
        #! the queries in a system-policy capability
        code capability = SandboxManager::createSystemPolicyCall(\queries());
        #! the queries in a thread that the calling code starts, or the error that they raised there
        /** the thread passes on an error instead of leaving the caller waiting
        */
        code thread = auto sub () {
            Queue q();
            background sub () {
                try {
                    q.push(queries());
                } catch (hash<ExceptionInfo> ex) {
                    q.push(sprintf("%s: %s", ex.err, ex.desc));
                }
            }();
            return q.get();
        };
    }

    constructor() : Test("SandboxManager::isSandboxed()", "1.0", \ARGV) {
        code queries_ref = \queries();
        barrier = hash<auto> sub () { return SandboxManager::callWithSystemPolicy(queries_ref); };
        addTestCase("trusted code is not sandboxed", \trustedTest());
        addTestCase("sandboxed code, also under a policy barrier or in a capability", \sandboxedTest());
        addTestCase("a thread that sandboxed code starts, and an object that it created", \inheritedTest());
        addTestCase("restricted code can call it", \restrictedTest());
        set_return_value(main());
    }

    trustedTest() {
        assertEq({"isSandboxed": False, "isGoverned": False}, plain());
        assertEq({"isSandboxed": False, "isGoverned": False}, barrier());
        assertEq({"isSandboxed": False, "isGoverned": False}, capability());
    }

    sandboxedTest() {
        # isGoverned() and callWithSystemPolicy() are judged by the Program of the code that calls them: the trusted
        # test's code calls them for the sandboxed code, under the default sandbox as under one that allows
        # uncontrolled APIs (qore#5741)
        foreach bool allow in ((False, True)) {
            Program p = sandboxed(allow);
            string label = allow ? "a sandbox that allows uncontrolled APIs" : "the default sandbox";
            assertEq({"isSandboxed": True, "isGoverned": True}, p.callFunction("run", plain), label);
            # a policy barrier masks the sandbox's policy, not the sandbox
            assertEq({"isSandboxed": True, "isGoverned": False}, p.callFunction("run", barrier), label);
            assertEq({"isSandboxed": True, "isGoverned": False}, p.callFunction("run", capability), label);
        }
        # the sandboxed code's own calls are refused by the default sandbox; isSandboxed() is not an uncontrolled API
        Program p = sandboxed();
        assertTrue(p.callFunction("own_is_sandboxed"), "the sandboxed code's own isSandboxed()");
        assertThrows("INVALID-FUNCTION-ACCESS", "uncontrolled API.*isGoverned", \p.callFunction(),
            ("own_is_governed",), "the sandboxed code's own isGoverned()");
        assertThrows("INVALID-FUNCTION-ACCESS", "uncontrolled API.*callWithSystemPolicy", \p.callFunction(),
            ("own_barrier",), "the sandboxed code's own policy barrier");
    }

    inheritedTest() {
        foreach bool allow in ((False, True)) {
            Program p = sandboxed(allow);
            string label = allow ? "a sandbox that allows uncontrolled APIs" : "the default sandbox";
            # trusted code in a thread that sandboxed code starts: it inherits the sandbox
            assertEq({"isSandboxed": True, "isGoverned": True}, p.callFunction("run", thread), label);
            # the method of an object that sandboxed code created runs under its sandbox, also when trusted code
            # calls it
            object o = p.callFunction("make");
            assertTrue(o.isSandboxed(), label);
        }
    }

    restrictedTest() {
        Program r(PO_NEW_STYLE | PO_NO_UNCONTROLLED_APIS, True);
        r.parse("bool sub t() { return SandboxManager::isSandboxed(); }\n", "restricted");
        assertFalse(r.callFunction("t"));
        r.setSandboxManager(new SandboxManager());
        assertTrue(r.callFunction("t"));
    }

    #! Returns a sandboxed Program that calls the code given
    /** @param allow_uncontrolled_apis whether the sandbox allows the code that it governs uncontrolled APIs
        (SandboxManager::setUncontrolledApiPolicy())
    */
    private Program sandboxed(bool allow_uncontrolled_apis = False) {
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS, True);
        p.parse("auto sub run(code c) { return c(); }\n"
            "bool sub own_is_sandboxed() { return SandboxManager::isSandboxed(); }\n"
            "bool sub own_is_governed() { return SandboxManager::isGoverned(); }\n"
            "auto sub own_barrier() { return SandboxManager::callWithSystemPolicy(sub () {}); }\n"
            "class Probe { bool isSandboxed() { return SandboxManager::isSandboxed(); } }\n"
            "object sub make() { return new Probe(); }\n", "sandboxed");
        SandboxManager sm();
        sm.setUncontrolledApiPolicy(allow_uncontrolled_apis);
        p.setSandboxManager(sm);
        return p;
    }
}
