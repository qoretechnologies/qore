#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - AOT code generation and linking of qcc executables and of a qcc-compiled module

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit
%requires ../../TestInterpreter.qm

%exec-class GenericMethodHashdeclPathsTest

#! Hashdecls and typed containers whose types use the type parameters of generic code are those of the running
#! instantiation in every mode (qore#5720, qore#5661)
/** In a generic method or function, cast<hash<HD<U>>>(), new hash<HD<U>>() (AST) and the casts to typed containers of
    U (cast<hash<string, U>>(), cast<list<U>>() and their nested forms) checked their values against the type
    parameter U instead of the type argument of the call, and raised RUNTIME-TYPE-ERROR; the same in a generic class
    with its own T.  In qcc-compiled code, the construction, the new expression and the cast of a hashdecl with a type
    parameter of the method could not resolve the hashdecl (HASHDECL-ERROR, IR-CAST-ERROR).

    The probes (generic-method-hashdecl-paths/probes.q) construct, cast and assign hashdecls and typed containers of
    the type parameters of static methods, normal methods, generic functions and a generic method of a generic class
    (with the class's T and the method's U in one hashdecl), with another instantiation of the same method, with
    values of the wrong type (whose errors name the types of the instantiation), or-nothing and softlist casts, in a
    closure, in a background thread, in four threads running two instantiations at the same time, and with two
    instantiations of a generic class whose own T is in the paths, and the same forms in non-generic code as a
    control.  They run in each execution mode in a child process, with tiered execution at the IR tier and promoted
    to native code, as qcc-compiled executables (-O0, -O3) and in a qcc-compiled module (-O0, -O3) loaded by a child
    in each execution mode; the forms that fail in qcc-compiled non-generic code too are checked in the interpreted
    modes only.
*/
class GenericMethodHashdeclPathsTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");

        const HdInt = "{a: 1} hash<HD<int>>";
        const HdStr = "{a: \"s\"} hash<HD<string>>";
        const HashInt = "{a: 1} hash<string, int>";
        const ListInt = "[1] list<int>";
        const ListHd = "[{a: 1}] list<hash<HD<int>>>";
        const HashList = "{a: [1]} hash<string, list<int>>";
        const HashHd = "{a: {a: 1}} hash<string, hash<HD<int>>>";
        const HdList = "{a: [1]} hash<HD<list<int>>>";
        const Hd2 = "{a: \"x\", b: 1} hash<HD2<string, int>>";
        const BadValue = "RUNTIME-TYPE-ERROR: key 'a' expects type 'int', but got type 'string' instead (while "
            "initializing hashdecl 'HD<int>')";

        #! the forms of each context of a type parameter of a generic method or function and their results
        const Forms = (
            ("ctor", HdInt), ("cast", HdInt), ("new", HdInt), ("assign", HashInt), ("typedCtor", HashInt),
            ("typedCast", HashInt), ("typedNew", HashInt), ("listCast", ListInt), ("listHdCast", ListHd),
            ("listHdAssign", ListHd), ("hashListCast", HashList), ("hashListCtor", HashList),
            ("hashListAssign", HashList), ("hashHdCast", HashHd), ("hdOfList", HdList),
        );

        #! the results of the probes of the static methods after their forms
        const StaticExtra = (
            ("cast<string>", HdStr), ("new<string>", HdStr), ("castBad", BadValue), ("newBad", BadValue),
            ("castNonHash", "RUNTIME-CAST-ERROR: cannot cast from type 'integer' to hashdecl 'HD<int>'"),
            ("typedCastNonHash", "RUNTIME-CAST-ERROR: cannot cast from type 'integer' to 'hash<string, int>'"),
            ("listCastNonList", "RUNTIME-CAST-ERROR: cannot cast from type 'integer' to 'list<int>'"),
            ("onHashCastNonHash", "RUNTIME-CAST-ERROR: cannot cast from type 'integer' to '*hash<string, int>'"),
            ("bgCast", HdInt), ("bgList", ListInt), ("onHdCast", HdInt), ("onHdNothing", "null nothing"),
            ("softlistListCast", "[1] softlist<int>"), ("closureCast", HdInt), ("closureNew", HdInt),
        );

        #! the results of the probes of the generic method of the generic class and of the controls
        const GenericClass = (
            ("G.ctor", Hd2), ("G.cast", Hd2), ("G.new", Hd2),
            ("G.hashHdCast", "{k: {a: \"x\", b: 1}} hash<string, hash<HD2<string, int>>>"),
            ("G.listHdCast", "[{a: \"x\", b: 1}] list<hash<HD2<string, int>>>"),
            ("G.hashListAssign", "{k: [1]} hash<string, list<int>>"), ("G.sctor", Hd2),
            ("GT<int>.cast", HdInt), ("GT<string>.cast", HdStr), ("GT<int>.new", HdInt), ("GT<string>.new", HdStr),
            ("GT<int>.ctor", HdInt), ("GT<string>.ctor", HdStr), ("GT<int>.list", ListInt),
            ("GT<string>.list", "[\"s\"] list<string>"), ("threads", "\"ok\" string"),
            ("concrete.cast", HdInt), ("concrete.new", HdInt),
        );

        #! the results of the probes left out in qcc-compiled code (see probes())
        const InterpretedOnly = (
            ("S.onListCast", "[1] *list<int>"), ("S.onHashCast", "{a: 1} *hash<string, int>"),
            ("S.softlistCast", ListInt),
        );

        #! the header of the module that the probes are compiled in
        const ModuleHeader = "%modern
module GenericHashdeclPaths {
    version = \"1.0\";
    desc = \"generic method hashdecl path test module\";
    author = \"Qore Technologies, s.r.o.\";
    url = \"https://qore.org\";
    license = \"MIT\";
}
";

        #! the child that loads the compiled module and runs its probes
        const ModuleChild = "%modern
%requires GenericHashdeclPaths
for (int i = 0; i < 4; ++i) {
    map printf(\"%d: %s\\n\", i, $1), probes(True);
}
printf(\"%s\\n\", basename(get_module_hash().GenericHashdeclPaths.filename));
";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        #! the output of the probes in the interpreted modes
        string expected;
        #! the output of the probes in qcc-compiled code
        string expected_qcc;
    }

    constructor() : QUnit::Test("GenericMethodHashdeclPaths", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        list<list<string>> lines;
        foreach string ctx in (("S", "N", "f")) {
            lines += map ((ctx + "." + $1[0]), $1[1]), Forms;
            if (ctx == "S") {
                lines += map (("S." + $1[0]), $1[1]), StaticExtra;
            }
        }
        lines += GenericClass;
        for (int i = 0; i < 4; ++i) {
            map expected_qcc += sprintf("%d: %s: %s\n", i, $1[0], $1[1]), lines;
            map expected += sprintf("%d: %s: %s\n", i, $1[0], $1[1]), lines + InterpretedOnly;
        }

        addTestCase("interpreted and compiled programs", \testModes());
        addTestCase("compiled module", \testModule());
        set_return_value(main());
    }

    string getProbes() {
        return ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "generic-method-hashdecl-paths" + DirSep
            + "probes.q");
    }

    #! writes a program that runs the probes four times
    string writeProgram(string dir, string name, bool qcc) {
        string file = dir + DirSep + name;
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(getProbes() + sprintf("\nfor (int i = 0; i < 4; ++i) {\n    map printf(\"%%d: %%s\\n\", i, $1), "
            "probes(%s);\n}\n", qcc ? "True" : "False"));
        f.close();
        return file;
    }

    testModes() {
        TmpDir tmp("qore-generic-method-hashdecl-paths-");
        string file = writeProgram(tmp.path, "prog.q", False);
        string qcc_file = writeProgram(tmp.path, "prog-qcc.q", True);

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=2 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)), mode);
        }
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
            "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), "tiered, IR tier");
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 --jit-jit-threshold=1 "
            "%s 2>&1", env, qore_bin, file)), "tiered, promoted");
        foreach string opt in (("-O0", "-O3")) {
            string exe = qcc_file + opt;
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                qcc_file));
            assertTrue(is_file(exe), sprintf("qcc %s compiled the executable: %s", opt, out));
            assertEq(expected_qcc, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                libqore_dir, exe)), "qcc " + opt);
            assertEq(expected_qcc, backquote(sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=1 LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, libqore_dir, exe)), "qcc " + opt + ", JIT");
        }
    }

    testModule() {
        TmpDir tmp("qore-generic-method-hashdecl-paths-module-");
        string src = tmp.path + DirSep + "GenericHashdeclPaths.qm";
        string qmod = tmp.path + DirSep + "GenericHashdeclPaths.qmod";
        string child = tmp.path + DirSep + "child.q";
        File f();
        f.open2(child, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ModuleChild);
        f.close();

        # the probes are exported by the module
        string probes = getProbes();
        string decl = "\nlist<string> sub probes(*bool qcc) {";
        assertTrue(probes.find(decl) >= 0, "the probes are declared as expected");
        probes = replace(probes, decl, "\npublic list<string> sub probes(*bool qcc) {");

        foreach string opt in (("-O0", "-O3")) {
            f.open2(src, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(ModuleHeader + probes);
            f.close();
            if (is_file(qmod)) {
                unlink(qmod);
            }
            string out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s "
                "QORE_MODULE_DIR=%s %s %s --module --strip-source -o %s %s 2>&1", libqore_dir, libqore_dir,
                libqore_dir, tmp.path, qcc_bin, opt, qmod, src));
            assertTrue(is_file(qmod), sprintf("qcc %s compiled the module: %s", opt, out));
            # the child must load the compiled module: there is no source to fall back to
            unlink(src);

            foreach string mode in (ExecModes) {
                out = backquote(sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=2 LD_LIBRARY_PATH=%s "
                    "DYLD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b --exec-mode=%s %s 2>&1", libqore_dir,
                    libqore_dir, tmp.path, qore_bin, mode, child));
                assertEq(expected_qcc + "GenericHashdeclPaths.qmod\n", out, sprintf("module %s, %s", opt, mode));
            }
        }
    }
}
