#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation and loading of deep class hierarchies

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class DeepInheritanceChainTest

#! Test for issue #6106: deep class hierarchies behave the same in every execution mode
/** Parsing a long chain of classes took time that grew with the fourth power of its length, as each class walked
    the whole hierarchy again for each of its ancestors; the ancestors are now taken from the list of its base
    classes.

    DeepInheritanceChain.q builds objects of deep hierarchies whose classes call their base class constructors with
    arguments, override methods, declare members with initializers, implement the abstract methods of their base
    classes and inherit several classes that share a base class, in its own code and in a deeper one generated and
    parsed in a Program; its output (the order of the constructors and destructors, the members and the methods
    called) must be the one in DeepInheritanceChain.expected in every execution mode, on the IR tier and in programs
    compiled with qcc -O0 and -O2.
*/
class DeepInheritanceChainTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/DeepInheritanceChain.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/DeepInheritanceChain.expected");
    }

    constructor() : QUnit::Test("deep inheritance chain", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O2", sub () { checkQcc(2); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/deep-inheritance-chain";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
