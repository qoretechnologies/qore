#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class DeepInheritanceChainParseScalingTest

#! Test for issue #6106: the work of parsing a chain of classes grows about quadratically with its length
/** Each class of a chain walked the whole hierarchy again for each of its ancestors to add them to its list of base
    classes, and initialized the hierarchy of each ancestor again, adding the ancestors of their methods again: the
    parse time grew about with the fourth power of the length of the chain.  This test parses chains of Short and of
    Long classes and compares the number of steps taken walking class hierarchies and member lists while parsing
    them, which a debug build counts (dbg_class_hierarchy_steps()): the longer chain must not take more than MaxRatio
    times as many steps, a bound above the ratio of the squares of the lengths (each class still has a list of all of
    its ancestors and of their members) and below the ratio of their cubes.  The parse times are only printed (with
    -v); the test is skipped in a build without the counter.
*/
class DeepInheritanceChainParseScalingTest inherits QUnit::Test {
    public {
        const Short = 150;
        const Long = 600;
        #! the ratio of the squares of the lengths is 16, of their cubes 64
        const MaxRatio = 32.0;
    }

    constructor() : QUnit::Test("deep inheritance chain parse scaling", "1.0", \ARGV) {
        addTestCase("chain of classes", \chainTest());
        addTestCase("chain of classes with several base classes", \multiTest());
        set_return_value(main());
    }

    chainTest() {
        checkScaling(\chainSource());
    }

    multiTest() {
        checkScaling(\multiSource());
    }

    private checkScaling(code source) {
        *int start = steps();
        if (!exists start) {
            testSkip("a debug build is required for dbg_class_hierarchy_steps()");
        }
        hash<auto> short_parse = parse(source(Short));
        hash<auto> long_parse = parse(source(Long));
        float ratio = long_parse.steps.toFloat() / short_parse.steps;
        if (m_options.verbose) {
            printf("%d classes: %d steps (%.4fs), %d classes: %d steps (%.4fs), ratio: %.1f\n", Short,
                short_parse.steps, short_parse.time, Long, long_parse.steps, long_parse.time, ratio);
        }
        assertTrue(ratio < MaxRatio, sprintf("parsing %d classes took %.1f times as many steps as parsing %d "
            "classes (%d and %d); the bound is %.1f", Long, ratio, Short, long_parse.steps, short_parse.steps,
            MaxRatio));
    }

    #! returns the number of steps counted so far, or nothing if the build does not count them
    private static *int steps() {
        try {
            return call_function("dbg_class_hierarchy_steps");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "NO-FUNCTION" || ex.err == "UNDEFINED-FUNCTION-CALL") {
                return;
            }
            rethrow;
        }
    }

    #! parses the source and returns the steps that it took and its time
    private static hash<auto> parse(string src) {
        Program pgm(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS | PO_STRONG_ENCAPSULATION);
        int start = steps();
        date start_time = now_us();
        pgm.parse(src, "chain");
        return {
            "steps": steps() - start,
            "time": (now_us() - start_time).durationSecondsFloat(),
        };
    }

    #! each class calls its base class constructor, declares a member and overrides a method
    private static string chainSource(int n) {
        string src = "class C0 { public { int m0 = 0; } constructor() {} int m() { return 0; } }\n";
        for (int i = 1; i < n; ++i) {
            src += sprintf("class C%d inherits C%d { public { int m%d = %d; } constructor() : C%d() {} "
                "int m() { return %d; } }\n", i, i - 1, i, i, i - 1, i);
        }
        return src;
    }

    #! each class also inherits a class of its own, and those classes have a common base class
    private static string multiSource(int n) {
        string src = "class B {}\nclass C0 { constructor() {} }\n";
        for (int i = 1; i < n; ++i) {
            src += sprintf("class M%d inherits B {}\nclass C%d inherits C%d, M%d { constructor() : C%d(), M%d() {} "
                "}\n", i, i, i - 1, i, i - 1, i);
        }
        return src;
    }
}
