#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation and linking of method calls resolved at run time, module loading

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class AbstractRedeclaredParentOrderTest

#! a class that inherits an abstract method from a class that declares it and from a class that redeclares it over an
#! implementation of its own parent class is resolved the same way with its parent classes in either order and whether
#! the parent classes are in the same program or in a module (qore#7382)
/** With <tt>class C0 { abstract private string m(); } class C3 inherits C0 { string m() {...} } class C4 inherits C3
    { abstract string m(); }</tt>, <tt>class C7 inherits C4, C0 {}</tt> could not be instantiated, while
    <tt>class C8 inherits C0, C4 {}</tt> and \c C7 with \c C4 loaded from a module could: the abstract variant that the
    class kept was \c C4's, and the search for its implementation passed over \c C4 and its parent classes.

    The output of every execution mode, of qcc executables (-O0, -O3) and of the program whose parent classes are
    loaded from the module's source and from a qcc -m .qmod must be the same: probe.expected.  The programs, the
    classes that they share (users.ql) and the module are in \c abstract-redeclared-parent-order/.
*/
class AbstractRedeclaredParentOrderTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/abstract-redeclared-parent-order";

        const Name = "probe";
        const Module = "AbstractRedeclaredOrder";
    }

    constructor() : QUnit::Test("AbstractRedeclaredParentOrderTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT, tiered and IR-tier execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        addTestCase("the parent classes in a module and in a qcc -m .qmod", \testModule());
        set_return_value(main());
    }

    private string qccBin() {
        string qcc_bin = ENV.QCC ?? ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        return is_file(qcc_bin) ? qcc_bin : "qcc";
    }

    private string expected() {
        return ReadOnlyFile::readTextFile(dir + "/" + Name + ".expected");
    }

    private string command(string mode, string script = Name, *string module_dir) {
        return sprintf("%s%s -b --enable-debug --exec-mode=%s %s/%s.q", module_dir ? "QORE_MODULE_DIR="
            + module_dir + " " : "", qore_bin, mode, dir, script);
    }

    private string run(string mode, string script = Name, *string module_dir) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command(mode, script, module_dir));
        assertEq(0, r.rc, sprintf("%s: exit status (output: %y)", mode, r.out));
        ExecModeHarness::check_native(r);
        return r.stdout;
    }

    testAst() {
        assertEq(expected(), run("ast"), "ast");
    }

    testModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode), mode);
        }
        # the IR tier of tiered execution runs the calls in the IR interpreter
        assertEq(expected(), ExecModeHarness::run_ir_tier(command("tiered")), ExecModeHarness::IRTierName);
    }

    testModule() {
        # the module's source
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode, "module-user", dir), "source module: " + mode);
        }

        # the module compiled by qcc -m, whose abstract methods the AOT loader merges and resolves
        TmpDir tmp("qore-abstract-redeclared-parent-order-qmod-");
        int rc;
        string out = backquote(sprintf("%s -m -o %s/%s.qmod %s/%s.qm 2>&1", qccBin(), tmp.path, Module, dir, Module),
            \rc);
        if (rc || !is_file(tmp.path + "/" + Module + ".qmod")) {
            testSkip("qcc is not available or cannot compile the module " + Module + ": " + out);
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode, "module-user", tmp.path), "qmod: " + mode);
        }
    }

    testCompiled() {
        string qcc_bin = qccBin();
        TmpDir tmp("qore-abstract-redeclared-parent-order-");
        foreach string opt in (("0", "3")) {
            string exe = sprintf("%s/%s-O%s", tmp.path, Name, opt);
            int rc;
            string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, Name), \rc);
            if (rc || !is_file(exe)) {
                testSkip("qcc is not available or cannot compile " + Name + ": " + out);
            }
            # -b must be the first argument of a compiled program
            string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
            assertEq(0, rc, sprintf("-O%s: exit status (output: %y)", opt, result));
            assertEq(expected(), result, sprintf("-O%s", opt));
        }
    }
}
