#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of method calls of members that hold code, with named arguments

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class NamedCallMemberCodeTest

#! Regression test for issue #6361: a named call of a member that holds code binds the names to the code's parameters
/** A call of a method that a class does not have, of the name of a member of no type (auto) that holds code, was
    bound at parse time to the pseudo-method of objects of the same name, and its arguments were passed to the
    member's code by position at run time; a named call of a member of a code type was refused.  Such a call now binds
    its names at run time to the parameters of the code that the member holds (or to those of the pseudo-method when
    the member does not hold code).

    NamedCallMemberCode.q prints the result or exception code of such calls; its output must be the one in
    NamedCallMemberCode.expected, which the AST interpreter prints, in every execution mode, on the IR tier and in
    programs compiled with qcc -O0 and -O3.
*/
class NamedCallMemberCodeTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/NamedCallMemberCode.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/NamedCallMemberCode.expected");
    }

    constructor() : QUnit::Test("named calls of members that hold code", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/named-call-member-code";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
