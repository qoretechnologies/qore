#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of the calls of the val() pseudo-method of objects

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ObjectValVisibilityTest

#! The value of an object does not depend on the visibility of its members to the calling code (issue #7048)
/** <object>::val() is True for an object with members in its main storage, wherever it is called from: public and
    private members count, and a member declared private:internal, which is stored apart, does not.  The boolean
    conversion of an object does not depend on its members, and <object>::firstKey() and lastKey() do not return a
    member declared private:internal.

    object-val-visibility-worker.q evaluates objects with no members and with public, private and private:internal
    members from outside the class, from an unrelated class, and from the class's and a child class's methods; its
    output must be the one in object-val-visibility.expected in every execution mode, on the IR tier and in programs
    compiled with qcc -O0 and -O3.
*/
class ObjectValVisibilityTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/object-val-visibility-worker.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/object-val-visibility.expected");
    }

    constructor() : QUnit::Test("object value and member visibility", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/object-val-visibility";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        int rc;
        assertEq(expected, backquote(shellQuote(program) + " 2>&1", \rc));
        assertEq(0, rc, "the exit status of the compiled program");
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
