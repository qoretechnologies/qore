# module of qmod-subclass-parse.qtest (issue #6106): a hierarchy whose classes are used by other threads while a
# Program parses subclasses of them

%modern

module QmodSubclassParseBase {
    version = "1.0";
    desc = "test module for qmod-subclass-parse.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
}

public namespace QmodSubclassParseBase {
public class Root {
    public { int r = 1; }
    constructor() {}
    destructor() {}
    int f() { return 0; }
    abstract int ab();
}
public class M0 inherits Root {
    public { int m0 = 0; }
    constructor() {}
    int mm0() { return 0; }
    int ab() { return -0; }
}
