#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of the calls of the member enumerations of objects

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ObjectMemberEnumerationTest

#! The member enumerations of an object report the members that the calling code can access (issue #7048)
/** <object>::keys(), size(), empty() and val() and the elements operator reported and counted the private members of
    an object to any caller, while the keys operator, hash() and the object iterators report only the members that the
    calling code can access; code outside the class's hierarchy could list the names of the private members of an
    object that other code shares.  They now give the results of the keys operator in the same context.

    object-member-enumeration-worker.q enumerates the members of objects with public, private and private:internal
    members from code outside the class hierarchy, from an unrelated class, from the class's own methods and from a
    child class's methods; its output must be the one in object-member-enumeration.expected in every execution mode,
    on the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class ObjectMemberEnumerationTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/object-member-enumeration-worker.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/object-member-enumeration.expected");
    }

    constructor() : QUnit::Test("object member enumerations", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/object-member-enumeration";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        int rc;
        assertEq(expected, backquote(shellQuote(program) + " 2>&1", \rc));
        assertEq(0, rc, "the exit status of the compiled program");
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
