#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires Util
%requires QUnit

%exec-class DirTest

class DirTest inherits QUnit::Test {
    constructor() : QUnit::Test("Dir", "1.0") {
        addTestCase("DirTest", \dirTest());
        addTestCase("Dir named calls", \namedCallTest());
        addTestCase("Dir typed listing", \typedListingTest());
        addTestCase("issue3192 test", \issue3192Test());
        addTestCase("DirStatInfo inherits StatInfo", \dirStatInfoTest());
        set_return_value(main());
    }

    dirTest() {
        string dir1 = sprintf(tmp_location() + DirSep + get_random_string());
        Dir d();
        bool b = d.chdir(dir1);
        assertEq(False, b);
        int rc = d.create();
        on_exit
            rmdir(dir1);
        assertEq(1, rc);
        assertEq("DIRECTORY", hstat(dir1).type);

        string dir2 = get_random_string();
        string dir3 = get_random_string();
        b = d.chdir(dir2);
        assertEq(False, b);
        b = d.chdir(dir3);
        assertEq(False, b);
        rc = d.create();
        string path2 = dir1 + DirSep + dir2;
        string path3 = dir1 + DirSep + dir2 + DirSep + dir3;
        on_exit {
            rmdir(path3);
            rmdir(path2);
        }
        assertEq(2, rc);
        assertEq("DIRECTORY", hstat(path3).type);
        assertEq("DIRECTORY", hstat(path2).type);

%ifdef HAVE_STATVFS
        hash<auto> h = d.statvfs();
        assertEq("hash<FilesystemInfo>", h.fullType());
%endif
    }

    namedCallTest() {
        string tmpdirPath = sprintf(tmp_location() + DirSep + "qoretest" + get_random_string());
        string subdir = "named_subdir";
        string filename = "named.txt";
        string subdirPath = tmpdirPath + DirSep + subdir;
        string filePath = subdirPath + DirSep + filename;
        on_exit {
            if (is_file(filePath))
                unlink(filePath);
            if (is_dir(subdirPath))
                rmdir(subdirPath);
            if (is_dir(tmpdirPath))
                rmdir(tmpdirPath);
        }

        Dir d(encoding: "UTF-8");
        assertEq(False, d.chdir(path: tmpdirPath));
        assertEq(1, d.create(mode: 0700));
        d.chmod(mode: 0700);
        d.mkdir(subdir: subdir, mode: 0700);

        Dir child = d.openDir(subdir: subdir, encoding: "UTF-8");
        File f = child.openFile(filename: filename, flags: O_CREAT | O_WRONLY | O_TRUNC, mode: 0600,
            encoding: "UTF-8");
        f.write("abc\n");
        f.close();

        assertEq((subdir,), d.listDirs(full: False));
        assertEq((filename,), child.listFiles(regex: "^named", regex_options: 0, full: False));
        assertEq((filename,), child.list(regex: "\\.txt$", regex_options: 0, full: False));

        list<auto> full = child.listFiles(full: True);
        assertEq(filename, full[0].name);
        assertEq("hash<DirStatInfo>", full[0].fullType());

        assertTrue(child.removeFile(filename: filename));
        assertFalse(child.removeFile(filename: filename));
        d.rmdir(subdir: subdir);
    }

    typedListingTest() {
%ifdef Windows
        testSkip("skipping because the test is being run on Windows");
%endif

        string tmpdirPath = sprintf(tmp_location() + DirSep + "qoretest" + get_random_string());
        string subdir = "typed_subdir";
        string fileA = "alpha.txt";
        string fileB = "beta.log";
        string fileAPath = tmpdirPath + DirSep + fileA;
        string fileBPath = tmpdirPath + DirSep + fileB;
        string subdirPath = tmpdirPath + DirSep + subdir;

        Dir d();
        assertEq(False, d.chdir(tmpdirPath));
        assertEq(1, d.create());
        on_exit system("rm -rf " + tmpdirPath);

        d.mkdir(subdir);
        {
            File f();
            f.open2(fileAPath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("abc\n");
            f.close();
        }
        {
            File f();
            f.open2(fileBPath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("def\n");
            f.close();
        }

        list<string> entries = sort(d.listNames());
        assertEq((fileA, fileB, subdir), entries);
        assertEq("list<string>", entries.fullType());

        list<hash<DirStatInfo>> entry_info = d.listInfo(regex: "^alpha");
        assertEq(1, entry_info.size());
        assertEq(fileA, entry_info[0].name);
        assertEq("list<hash<DirStatInfo>>", entry_info.fullType());

        list<string> files = sort(d.listFiles());
        assertEq((fileA, fileB), files);
        assertEq("list<string>", files.fullType());

        ListIterator<string> it = d.listFiles().iterator();
        assertTrue(it.next());
        string first_file = it.getValue();
        assertTrue(first_file == fileA || first_file == fileB);

        list<string> txt_files = d.listFileNames(regex: "\\.txt$");
        assertEq((fileA,), txt_files);
        assertEq("list<string>", txt_files.fullType());

        list<hash<DirStatInfo>> txt_info = d.listFileInfo(regex: "\\.txt$");
        assertEq(1, txt_info.size());
        assertEq(fileA, txt_info[0].name);
        assertEq("list<hash<DirStatInfo>>", txt_info.fullType());

        list<string> dirs = d.listDirNames();
        assertEq((subdir,), dirs);
        assertEq("list<string>", dirs.fullType());

        list<hash<DirStatInfo>> dir_info = d.listDirInfo();
        assertEq(1, dir_info.size());
        assertEq(subdir, dir_info[0].name);
        assertEq("list<hash<DirStatInfo>>", dir_info.fullType());

        union<list<string>, list<hash<DirStatInfo>>> legacy_names = d.listFiles(full: False);
        assertEq("list<string>", legacy_names.fullType());
        assertEq((fileA, fileB), sort(legacy_names));

        union<list<string>, list<hash<DirStatInfo>>> legacy_info =
            d.listFiles(regex: "\\.txt$", regex_options: 0, full: True);
        assertEq("list<hash<DirStatInfo>>", legacy_info.fullType());
        assertEq(fileA, legacy_info[0].name);
    }

    issue3192Test() {
%ifdef Windows
        testSkip("skipping because the test is being run on Windows");
%endif

        # create temp dir
        string tmpdirPath = sprintf(tmp_location() + DirSep + "qoretest" + get_random_string());
        Dir d();
        bool b = d.chdir(tmpdirPath);
        assertEq(False, b);
        int rc = d.create();
        on_exit system("rm -rf " + tmpdirPath + "/*");

        # create random file
        string fileA = get_random_string() + "A";
        string aPath = tmpdirPath + DirSep + fileA;
        {
            File f();
            f.open2(aPath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("abc\n");
            f.close();
        }
        on_exit system("rm -f " + aPath);

        # create symlink with non-existent target
        string linkName = get_random_string() + "_link";
        string linkPath = tmpdirPath + DirSep + linkName;
        string targetName = "sdjfksdfjksf";
        rc = system("ln -s " + targetName + " " + linkPath);
        if (rc)
            fail();
        on_exit system("rm -f " + linkPath);

        assertEq(sort((fileA, linkName)), sort(d.list()));
        list<string> files = d.listFiles();
        assertEq((fileA,), files);
        assertEq(list(), d.listDirs());
    }

    dirStatInfoTest() {
%ifdef Windows
        testSkip("skipping because the test is being run on Windows");
%endif

        string tmpdirPath = sprintf(tmp_location() + DirSep + "qoretest" + get_random_string());
        Dir d();
        bool b = d.chdir(tmpdirPath);
        assertEq(False, b);
        d.create();
        on_exit system("rm -rf " + tmpdirPath + "/*");
        on_exit rmdir(tmpdirPath);

        string fileA = get_random_string() + "A";
        string aPath = tmpdirPath + DirSep + fileA;
        {
            File f();
            f.open2(aPath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("abc\n");
            f.close();
        }
        on_exit system("rm -f " + aPath);

        list<auto> full = d.listFiles(True);
        assertTrue(full.size() > 0);

        *hash<DirStatInfo> entry;
        foreach hash<DirStatInfo> h in (full) {
            if (h.name == fileA) {
                entry = h;
                break;
            }
        }
        assertTrue(exists entry);
        assertEq("hash<DirStatInfo>", entry.fullType());
        assertEq(Type::Date, entry.mtime.type());
        assertTrue(exists entry.size);
    }
}
