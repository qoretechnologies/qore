#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of static method call references and the release of a deleted Program's classes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class StaticMethodRefDeletedProgramTest

#! A static method call reference to a method of an imported class, called after its Program is deleted (issue #6622)
/** A static method call reference held its Program with a weak reference only; the Program's copies of the classes
    that it imported are released when it is deleted, and a call of the reference read the method and its class before
    it found that the Program had been deleted (seen with valgrind).  The reference now holds the classes that a call
    reads (the method's class, the class context that made it and the class of its receiver), and a call raises
    PROGRAM-ERROR once the Program is deleted.

    static-method-ref-deleted-program-worker.q makes such references (written in code, from get_call_reference(), in
    a method of the imported class and of a class of the Program) and calls them after the Program is deleted; its
    output must be the one in static-method-ref-deleted-program.expected in every execution mode, on the IR tier and
    in programs compiled with qcc -O0 and -O3.  Before the fix, the first such call crashed a release build; in a debug
    build, valgrind shows the read of released memory.
*/
class StaticMethodRefDeletedProgramTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/static-method-ref-deleted-program-worker.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/static-method-ref-deleted-program.expected");
    }

    constructor() : QUnit::Test("static method reference after its Program is deleted", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/static-method-ref-deleted-program";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
