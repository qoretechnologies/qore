#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of calls through self of abstract methods

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class AbstractSecondParentTest

#! Regression test for issue #3070: an abstract method implemented by another parent class is called through self
/** A call through self of an abstract method of a parent class that another parent class (or a parent of it)
    implements raised RUNTIME-OVERLOAD-ERROR ("no variant matching '::Base::m(integer)' can be found") in the AST
    interpreter, the IR interpreter and JIT code when the object was of the class of the call: the method resolved at
    parse time, the abstract one, was called instead of the implementation; programs compiled with qcc called the
    implementation, as the call through the object does in every mode.

    AbstractSecondParent.q makes these calls; its output must be the one in AbstractSecondParent.expected in every
    execution mode, on the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class AbstractSecondParentTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/AbstractSecondParent.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/AbstractSecondParent.expected");
    }

    constructor() : QUnit::Test("abstract method implemented by another parent", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/abstract-second-parent";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
