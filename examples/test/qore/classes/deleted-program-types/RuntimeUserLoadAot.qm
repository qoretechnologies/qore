%requires qore >= 2.0

module RuntimeUserLoadAot {
    version = "1.0";
    desc = "an AOT module that loads a user module at run time (issue #6501)";
    author = "Qore Technologies";
    url = "https://qoretechnologies.com";
}

%modern

#! loads the user module \c RuntimeUserLoaded from the module's own Program, as ProviderIndexUtil loads modules
/** The module's Program imports the declarations of the loaded module, so the module must be deleted before it, and
    before the native module that the loaded module requires, when the process ends.
*/
public int sub runtime_user_load() {
    load_module("RuntimeUserLoaded");
    return 1;
}
