%requires qore >= 2.0

module RuntimeLoadTest {
    version = "1.0";
    desc = "a module that loads a native module at run time (qore#5790)";
    author = "Qore Technologies";
    url = "https://qoretechnologies.com";
}

%modern

#! loads the native module \c yaml from the module's own Program, as Util's get_file_from_sftp() loads ssh2
/** The module's Program imports the declarations of the loaded module, so the module must be deleted before it
    when the process ends.
*/
public int sub runtime_load_test_load() {
    load_module("yaml");
    return 1;
}
