%requires qore >= 2.0
%requires reflection
%requires RuntimeUserCycleAot

module RuntimeUserCycleLoaded {
    version = "1.0";
    desc = "a user module loaded at run time by an AOT module that it requires, with a hashdecl naming a class of a "
        "native module (issue #6501)";
    author = "Qore Technologies";
    url = "https://qoretechnologies.com";
}

%modern

#! a hashdecl whose member type is a class of the native module \c reflection
public hashdecl RuntimeUserCycleLoadedInfo {
    #! a class of the native module
    Class cls;
}
