#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../../qlib/QUnit.qm

%exec-class AsyncIoLoggerTest

#! Simple LoggerInterfaceBase implementation for testing
class TestLogger inherits LoggerInterfaceBase {
    public {
        list<hash<auto>> messages();
        int min_level = 0;
        Mutex mtx();
    }

    logArgs(int level, string message, *softlist<auto> args) {
        string formatted = args ? vsprintf(message, args) : message;
        AutoLock al(mtx);
        push messages, {
            "level": level,
            "message": formatted,
        };
    }

    bool isEnabledFor(int level) {
        return level >= min_level;
    }

    list<hash<auto>> getMessages() {
        AutoLock al(mtx);
        return messages;
    }

    nothing clearMessages() {
        AutoLock al(mtx);
        messages = ();
    }
}

#! Class with only one of the required methods
class PartialLogger {
    bool isEnabledFor(int level) { return True; }
}

class AsyncIoLoggerTest inherits QUnit::Test {
    constructor() : Test("AsyncIoLoggerTest", "1.0") {
        addTestCase("LoggerInterfaceBase is abstract", \testAbstractClass());
        addTestCase("custom LoggerInterfaceBase subclass", \testCustomSubclass());
        addTestCase("set/get round-trip", \testSetGetRoundTrip());
        addTestCase("clear logger", \testClearLogger());
        addTestCase("replace logger", \testReplaceLogger());
        addTestCase("set_async_io_logger validation", \testSetAsyncIoLoggerValidation());
        # Tests using AsyncIoController constructor require debug build + env var
        if (Option::HAVE_LIBRARY_DEBUGGING && ENV.QORE_ASYNCIO_TEST_MODE) {
            addTestCase("AsyncIoController global fallback", \testControllerGlobalFallback());
            addTestCase("AsyncIoController per-controller priority", \testControllerPriority());
            addTestCase("log level filtering", \testLogLevelFiltering());
            addTestCase("thread safety", \testThreadSafety());
        }
        set_return_value(main());
    }

    globalTearDown() {
        set_async_io_logger(NOTHING);
    }

    #! LoggerInterfaceBase cannot be instantiated directly
    testAbstractClass() {
        # Must use Program to test abstract class instantiation — direct 'new' is caught at parse time
        Program p(PO_NEW_STYLE);
        assertThrows("ABSTRACT-CLASS-ERROR", "LoggerInterfaceBase", \p.parse(),
            ("LoggerInterfaceBase sub test() { return new LoggerInterfaceBase(); }", "test"));
    }

    #! A properly implemented subclass works
    testCustomSubclass() {
        TestLogger lgr();
        assertEq(True, lgr instanceof LoggerInterfaceBase);
        assertEq(True, lgr.isEnabledFor(0));
        lgr.logArgs(20000, "hello %s %d", ("world", 42));
        list<hash<auto>> msgs = lgr.getMessages();
        assertEq(1, msgs.size());
        assertEq("hello world 42", msgs[0].message);
        assertEq(20000, msgs[0].level);
    }

    #! set_async_io_logger / get_async_io_logger round trip
    testSetGetRoundTrip() {
        on_exit set_async_io_logger(NOTHING);
        TestLogger lgr();
        set_async_io_logger(lgr);
        *object got = get_async_io_logger();
        assertEq(True, got === lgr);
    }

    #! Clearing the logger returns NOTHING
    testClearLogger() {
        on_exit set_async_io_logger(NOTHING);
        TestLogger lgr();
        set_async_io_logger(lgr);
        assertEq(True, get_async_io_logger() === lgr);
        set_async_io_logger(NOTHING);
        assertNothing(get_async_io_logger());
    }

    #! Replacing the logger works
    testReplaceLogger() {
        on_exit set_async_io_logger(NOTHING);
        TestLogger lgr1();
        TestLogger lgr2();
        set_async_io_logger(lgr1);
        assertEq(True, get_async_io_logger() === lgr1);
        set_async_io_logger(lgr2);
        assertEq(True, get_async_io_logger() === lgr2);
    }

    #! set_async_io_logger validates logger object has required methods
    testSetAsyncIoLoggerValidation() {
        # Object without logArgs() should fail
        assertThrows("ASYNC-IO-LOGGER-ERROR", "logArgs", sub() {
            set_async_io_logger(new PartialLogger());
        });

        # Ensure logger not set after validation failure
        assertNothing(get_async_io_logger());
    }

    #! AsyncIoController falls back to global logger when no per-controller logger is set
    testControllerGlobalFallback() {
        on_exit set_async_io_logger(NOTHING);

        TestLogger global_lgr();
        global_lgr.min_level = 0;
        set_async_io_logger(global_lgr);

        # Create controller without per-controller logger (autostop=False to keep I/O thread alive)
        AsyncIoController ctrl(False);
        ctrl.start();
        assertTrue(ctrl.waitReady(10s));

        # The I/O thread logs "I/O thread ready" at DEBUG level when it starts
        ctrl.stop();
        ctrl.waitStop();

        list<hash<auto>> msgs = global_lgr.getMessages();
        # Should have at least the "I/O thread ready" message
        assertTrue(msgs.size() >= 1,
            sprintf("expected >= 1 log messages from global logger fallback, got %d", msgs.size()));
    }

    #! Per-controller logger takes precedence over global logger
    testControllerPriority() {
        on_exit set_async_io_logger(NOTHING);

        TestLogger global_lgr();
        global_lgr.min_level = 0;
        set_async_io_logger(global_lgr);

        TestLogger ctrl_lgr();
        ctrl_lgr.min_level = 0;

        AsyncIoController ctrl(False);
        ctrl.setLogger(ctrl_lgr);
        ctrl.start();
        assertTrue(ctrl.waitReady(10s));
        ctrl.stop();
        ctrl.waitStop();

        # Per-controller logger should have messages (at least "I/O thread ready")
        list<hash<auto>> ctrl_msgs = ctrl_lgr.getMessages();
        assertTrue(ctrl_msgs.size() >= 1,
            sprintf("expected >= 1 log messages from per-controller logger, got %d", ctrl_msgs.size()));

        # Global logger should have NO messages (per-controller takes priority)
        list<hash<auto>> global_msgs = global_lgr.getMessages();
        assertEq(0, global_msgs.size(),
            sprintf("expected 0 log messages from global logger, got %d", global_msgs.size()));
    }

    #! Messages below the enabled level are not forwarded
    testLogLevelFiltering() {
        on_exit set_async_io_logger(NOTHING);

        TestLogger lgr();
        lgr.min_level = 30000;  # WARN level
        set_async_io_logger(lgr);

        # Create controller - its DEBUG messages should be filtered out
        AsyncIoController ctrl(False);
        ctrl.start();
        assertTrue(ctrl.waitReady(10s));
        ctrl.stop();
        ctrl.waitStop();

        # All controller lifecycle messages are at DEBUG level (10000), which is below WARN (30000)
        list<hash<auto>> msgs = lgr.getMessages();
        assertEq(0, msgs.size(),
            sprintf("expected 0 messages (all filtered), got %d: %y", msgs.size(), msgs));
    }

    #! Multiple threads can log concurrently while logger is set/cleared
    testThreadSafety() {
        on_exit set_async_io_logger(NOTHING);

        TestLogger lgr();
        lgr.min_level = 0;
        set_async_io_logger(lgr);

        Counter cnt(4);
        list<string> errors();
        Mutex err_mtx();

        # Start multiple controllers concurrently
        for (int i = 0; i < 4; ++i) {
            int idx = i;
            background sub() {
                on_exit cnt.dec();
                try {
                    AsyncIoController ctrl(False);
                    ctrl.start();
                    ctrl.waitReady(10s);
                    ctrl.stop();
                    ctrl.waitStop();
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(err_mtx);
                    push errors, sprintf("thread %d: %s: %s", idx, ex.err, ex.desc);
                }
            }();
        }

        # Also cycle the global logger a few times while controllers are running
        for (int i = 0; i < 10; ++i) {
            TestLogger tmp();
            tmp.min_level = 0;
            set_async_io_logger(tmp);
        }
        set_async_io_logger(lgr);

        int rc = cnt.waitForZero(30s);
        assertEq(0, rc, "all threads completed within timeout");
        assertEq(0, errors.size(),
            errors.size() > 0 ? sprintf("thread errors: %y", errors) : "no errors");
    }
}
