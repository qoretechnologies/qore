#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of member access in class hierarchies

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ImportedPrivateInternalPathsTest

#! Regression test for the imported-class form of qore#6668: a member reached through a private:internal path and a
#! public path by a class declared in a child Program that imports the classes of the paths has one value
/** The classes are declared in the parent Program and imported into a child Program per class, which declares a
    class that inherits them in both orders, one level deeper, beside the base class, and through a private:internal
    path above a public one; the member that the base class's initializer and constructor write is read from outside,
    from the base class, from both paths and from the class itself, before and after a write by the base class.

    ImportedPrivateInternalPaths.q checks these accesses; its output must be the one in
    ImportedPrivateInternalPaths.expected in every execution mode, on the IR tier and in programs compiled with qcc
    -O0 and -O3.
*/
class ImportedPrivateInternalPathsTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/ImportedPrivateInternalPaths.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/ImportedPrivateInternalPaths.expected");
    }

    constructor() : QUnit::Test("imported private internal paths", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/imported-private-internal-paths";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
