#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit
%requires ../../TestInterpreter.qm

%exec-class DeletedObjectOverloadTest

#! A deleted object keeps its class for the selection of a variant, in every call form and execution mode (qore#6159)
/** A deleted object matched no class type when the variant was resolved at run time, while a variant selected at
    parse time took it: k(Obj) beside k(int) was called with a typed argument, and an untyped one raised
    RUNTIME-OVERLOAD-ERROR, and the compiled modes resolved method calls again at run time.  The probes
    (deleted-object-overload/probes.q) call each case (k(Obj) and k(int), the lone n1(Obj), p(*Obj) and p(int),
    a(Obj) and a(auto), g<X>(X) and g(auto) with explicit type arguments, and a variant that uses the object) as
    functions, static methods and normal methods with typed and untyped arguments, through call references,
    call_function() and call_object_method(), with a live object and with the same object deleted: each call selects
    the same variant for both, and the variant that uses the deleted object raises OBJECT-ALREADY-DELETED.  They also
    call g<Obj>(1), which only the variant without type parameters takes, and a method of a child class beside a
    generic method of its parent class (qore#6152).  They run in each execution mode in a child process, with tiered
    execution at the IR tier and promoted to native code, and as qcc-compiled executables (-O0, -O3).
*/
class DeletedObjectOverloadTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");

        #! the results of the calls of each case with a live object, in the order of calls() in the probes
        const Live = (
            # functions, static methods and normal methods: typed and untyped arguments
            "Obj", "Obj", "Obj", "Obj", "*Obj", "*Obj", "Obj", "Obj", "X", "X", "obj", "obj",
            "Obj", "Obj", "Obj", "Obj", "*Obj", "*Obj", "Obj", "Obj", "X", "X", "obj", "obj",
            "Obj", "Obj", "Obj", "Obj", "*Obj", "*Obj", "Obj", "Obj", "X", "X", "obj", "obj",
            # call references
            "Obj", "Obj", "*Obj", "Obj", "X", "Obj", "*Obj", "Obj", "Obj", "Obj", "X",
            # call_function() and call_object_method()
            "Obj", "Obj", "*Obj", "Obj", "X", "Obj", "Obj", "*Obj", "Obj",
            # a child class object
            "Obj",
        );
        #! the calls that use the object
        const Uses = (10, 11, 22, 23, 34, 35);
        #! the other calls
        const Other = "auto auto auto child-auto";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string expected;
    }

    constructor() : QUnit::Test("DeletedObjectOverload", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        list<string> l = ();
        for (int i = 0; i < Live.size(); ++i) {
            l += sprintf("%d:%s/%s", i, Live[i], (inlist(i, Uses) ? "OBJECT-ALREADY-DELETED" : Live[i]));
        }
        string line = l.join(" ") + " " + Other;
        for (int i = 0; i < 2; ++i) {
            expected += sprintf("%d: %s\n", i, line);
        }

        addTestCase("a deleted object keeps its class for the selection of a variant", \testModes());
        set_return_value(main());
    }

    testModes() {
        TmpDir tmp("qore-deleted-object-overload-");
        string file = tmp.path + DirSep + "prog.q";
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "deleted-object-overload" + DirSep
            + "probes.q")
            + "\nfor (int i = 0; i < 2; ++i) {\n    printf(\"%d: %s\\n\", i, probes());\n}\n");
        f.close();

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=1 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)), mode);
        }
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
            "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), "tiered, IR tier");
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 --jit-jit-threshold=1 "
            "%s 2>&1", env, qore_bin, file)), "tiered, promoted");
        foreach string opt in (("-O0", "-O3")) {
            string exe = file + opt;
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                file));
            assertTrue(is_file(exe), sprintf("qcc %s compiled the executable: %s", opt, out));
            assertEq(expected, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                libqore_dir, exe)), "qcc " + opt);
            assertEq(expected, backquote(sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=1 LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, libqore_dir, exe)), "qcc " + opt + ", JIT");
        }
    }
}
