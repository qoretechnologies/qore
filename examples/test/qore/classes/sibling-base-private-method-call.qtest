#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation and linking of method calls resolved at run time

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class SiblingBasePrivateMethodCallTest

#! a private method of a parent class is not called from another parent class of the object (qore#6735)
/** Code in a parent class of an object can call the private methods of its own class and of the classes related to
    it, but not those of another parent class of the object (a sibling of its class).  An untyped call there in the
    IR interpreter (and so in the JIT and tiered modes before a method is compiled) called the private method that
    the AST interpreter and qcc executables refuse, and that a typed call does not call.  The program covers normal,
    static, \c private:internal and \c private:hierarchy methods, calls with arguments, call references,
    call_object_method(), closures (also one run in a background thread), typed calls (parsed in a child Program),
    and the calls that may call the private method (from its own class, the object's class and a subclass); the
    output of every execution mode and of qcc executables (-O0, -O3) must be the expected one.

    The program is in \c sibling-base-private-method-call/.
*/
class SiblingBasePrivateMethodCallTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/sibling-base-private-method-call";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("probe",);
    }

    constructor() : QUnit::Test("SiblingBasePrivateMethodCallTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT, tiered and IR-tier execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    #! runs the program in a mode; ir_tier: tiered execution on the IR tier (ExecModeHarness::IRTierEnv)
    private string run(string name, string mode, *bool ir_tier) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name), NOTHING,
            ir_tier ? ExecModeHarness::IRTierEnv : NOTHING);
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, ir_tier ? ExecModeHarness::IRTierName
            : mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
            # the IR tier of tiered execution runs the calls in the IR interpreter
            assertEq(expected(name), run(name, "tiered", True), name + " " + ExecModeHarness::IRTierName);
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        TmpDir tmp("qore-sibling-base-private-method-call-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                if (rc || !is_file(exe)) {
                    testSkip("qcc is not available or cannot compile " + name + ": " + out);
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
