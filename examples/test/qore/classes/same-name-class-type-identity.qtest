#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation and linking of type checks and method calls, module loading

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class SameNameClassTypeIdentityTest

#! classes with the same name and the same declarations in different namespaces are different types (qore#7397)
/** <tt>namespace SNA { class Foo {} } namespace SNB { class Foo {} }</tt>: an object of \c SNB::Foo was accepted for
    the type \c SNA::Foo, as the classes had the same name and signature, so a method overloaded on the two classes
    called the variant for \c SNA::Foo with an object of \c SNB::Foo (in every execution mode for an untyped argument,
    in IR, JIT, tiered and qcc executables also for a typed one), an abstract method declared for \c SNB::Foo was
    implemented by a variant for \c SNA::Foo, and a parameter or a variable of either type accepted an object of the
    other class.  The namespace path of a class is now part of its signature; the same declaration in another Program
    is still the same type.

    The output of every execution mode, of qcc executables (-O0, -O3) and of the program whose classes are loaded from
    the module's source and from a qcc -m .qmod must be the same: probe.expected.  The programs, the checks that they
    share (users.ql) and the module are in \c same-name-class-type-identity/.
*/
class SameNameClassTypeIdentityTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/same-name-class-type-identity";

        const Name = "probe";
        const Module = "SameNameClasses";
    }

    constructor() : QUnit::Test("SameNameClassTypeIdentityTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT, tiered and IR-tier execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        addTestCase("the classes in a module and in a qcc -m .qmod", \testModule());
        set_return_value(main());
    }

    private string qccBin() {
        string qcc_bin = ENV.QCC ?? ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        return is_file(qcc_bin) ? qcc_bin : "qcc";
    }

    private string expected() {
        return ReadOnlyFile::readTextFile(dir + "/" + Name + ".expected");
    }

    private string command(string mode, string script = Name, *string module_dir) {
        return sprintf("%s%s -b --enable-debug --exec-mode=%s %s/%s.q", module_dir ? "QORE_MODULE_DIR="
            + module_dir + " " : "", qore_bin, mode, dir, script);
    }

    private string run(string mode, string script = Name, *string module_dir) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command(mode, script, module_dir));
        assertEq(0, r.rc, sprintf("%s: exit status (output: %y)", mode, r.out));
        ExecModeHarness::check_native(r);
        return r.stdout;
    }

    testAst() {
        assertEq(expected(), run("ast"), "ast");
    }

    testModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode), mode);
        }
        # the IR tier of tiered execution runs the calls in the IR interpreter
        assertEq(expected(), ExecModeHarness::run_ir_tier(command("tiered")), ExecModeHarness::IRTierName);
    }

    testModule() {
        # the module's source
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode, "module-user", dir), "source module: " + mode);
        }

        # the module compiled by qcc -m, whose class signatures the AOT image holds
        TmpDir tmp("qore-same-name-class-type-identity-qmod-");
        int rc;
        string out = backquote(sprintf("%s -m -o %s/%s.qmod %s/%s.qm 2>&1", qccBin(), tmp.path, Module, dir, Module),
            \rc);
        if (rc || !is_file(tmp.path + "/" + Module + ".qmod")) {
            testSkip("qcc is not available or cannot compile the module " + Module + ": " + out);
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expected(), run(mode, "module-user", tmp.path), "qmod: " + mode);
        }
    }

    testCompiled() {
        string qcc_bin = qccBin();
        TmpDir tmp("qore-same-name-class-type-identity-");
        foreach string opt in (("0", "3")) {
            string exe = sprintf("%s/%s-O%s", tmp.path, Name, opt);
            int rc;
            string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, Name), \rc);
            if (rc || !is_file(exe)) {
                testSkip("qcc is not available or cannot compile " + Name + ": " + out);
            }
            # -b must be the first argument of a compiled program
            string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
            assertEq(0, rc, sprintf("-O%s: exit status (output: %y)", opt, result));
            assertEq(expected(), result, sprintf("-O%s", opt));
        }
    }
}
