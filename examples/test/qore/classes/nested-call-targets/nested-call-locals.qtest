#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of nested calls whose arguments use locals

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class NestedCallLocalsTest

#! Regression test for issue #6920: the analyses of the locals of nested calls walk the expression of each call once
/** The expression of a call is the call's whole expression, with its arguments, which are the expressions of the
    instructions of the calls nested in it; the analyses of the locals that the expressions read and of the references
    that they create (QoreIRFunction::detectCreatesReference(), computeIROnlyLocals()) walk an expression found again
    no more.

    NestedCallLocals.q nests static method calls and function calls 1 to 40 deep whose arguments read untyped locals,
    create references to them, take them in closures or assign them, at the innermost and at the outermost level; its
    output must be the one in NestedCallLocals.expected, which the AST interpreter prints, in every execution mode, on
    the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class NestedCallLocalsTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/NestedCallLocals.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/NestedCallLocals.expected");
    }

    constructor() : QUnit::Test("nested call locals", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/nested-call-locals";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
