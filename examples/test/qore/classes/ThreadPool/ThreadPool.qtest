#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires Util
%requires QUnit

%exec-class ThreadPoolTest

class RefTest {
    test(reference<hash<auto>> val) {
        ThreadPool thread_pool();
        foreach string key in (keys val) {
            string ckey = key;
            thread_pool.submit(sub() {
                ++val{ckey};
                ++val.i;
            });
        }
        thread_pool.stopWait();
        check(\val);
    }

    private check(reference<hash<auto>> val) {
        val.other = 3;
    }
}

class ThreadPoolTest inherits QUnit::Test {
    private {
        hash<auto> val;
    }

    constructor() : QUnit::Test("ThreadPool", "1.0") {
        addTestCase("ref test", \refTest());
        addTestCase("stopWait() test", \stopWaitTest());
        addTestCase("ThreadPoolTest", \ThreadPoolTest());
        addTestCase("rapid worker reuse", \rapidReuseTest());
        addTestCase("idle release under load", \idleReleaseTest());
        addTestCase("stopWait() with busy workers", \stopWaitBusyTest());
        addTestCase("detachCurrentThread() only detaches a worker of the pool", \detachOwnWorkerTest());
        addTestCase("a detached worker does not count against max_threads", \detachMaxThreadsTest());
        addTestCase("stopWait() waits for a detached worker", \detachStopWaitTest());
        addTestCase("stop() waits for a detached worker", \detachStopTest());
        set_return_value(main());
    }

    #! detachCurrentThread() detaches the worker of the calling task, and only a worker of the pool it is called on
    detachOwnWorkerTest() {
        ThreadPool tp(1);
        ThreadPool other(1);
        assertFalse(tp.detachCurrentThread(), "a thread that is not a worker is not detached");
        Queue results();
        tp.submit(sub () {
            # the worker of another pool is not detached by this one
            results.push(other.detachCurrentThread());
            results.push(tp.detachCurrentThread());
            # a second call returns True too
            results.push(tp.detachCurrentThread());
            results.push(tp.toString());
        });
        assertFalse(results.get(30s), "another pool does not detach the worker");
        assertTrue(results.get(30s), "the worker of the calling task is detached");
        assertTrue(results.get(30s), "a detached worker stays detached");
        string desc = results.get(30s);
        assertRegex("detached: \\[[0-9]+\\]", desc, "the detached worker is shown as such: " + desc);
        assertRegex("running: \\[\\]", desc, "the detached worker is not counted as a running worker: " + desc);
        tp.stopWait();
        other.stopWait();
    }

    #! a detached worker no longer counts against max_threads, so a queued task runs while it is busy
    detachMaxThreadsTest() {
        ThreadPool tp(1);
        Counter release(1);
        Counter detached(1);
        Counter second_ran(1);
        # the first task takes the only worker and keeps it until it is released
        tp.submit(sub () {
            if (tp.detachCurrentThread()) {
                detached.dec();
            }
            release.waitForZero();
        });
        assertEq(0, detached.waitForZero(30s), "the first task detached its worker");
        # the second task runs although the first still runs: the pool started another worker for it
        tp.submit(sub () {
            second_ran.dec();
        });
        assertEq(0, second_ran.waitForZero(30s), "a task queued while the detached task runs is run");
        release.dec();
        tp.stopWait();
    }

    #! stopWait() returns only once a detached task has returned
    /** The task may be released before the stop is entered (nothing shows when the stop has started without
        polling), in which case this checks that the pool stops with a detached worker that has ended; when the stop
        is entered first, it checks that the stop waits for the detached task.  It never fails without a bug.
    */
    detachStopWaitTest() {
        ThreadPool tp(1);
        Counter release(1);
        Counter detached(1);
        bool stop_returned = False;
        bool stopped_before_return = False;
        tp.submit(sub () {
            tp.detachCurrentThread();
            detached.dec();
            release.waitForZero();
            stopped_before_return = stop_returned;
        });
        assertEq(0, detached.waitForZero(30s), "the task detached its worker");
        Counter stop_done(1);
        background sub () {
            on_exit stop_done.dec();
            tp.stopWait();
            stop_returned = True;
        }();
        release.dec();
        assertEq(0, stop_done.waitForZero(30s), "stopWait() returned");
        assertFalse(stopped_before_return, "stopWait() did not return before the detached task returned");
    }

    #! stop() returns only once a detached task has returned
    /** See detachStopWaitTest() for the order of the release and the stop.
    */
    detachStopTest() {
        ThreadPool tp(1);
        Counter release(1);
        Counter detached(1);
        Counter task_done(1);
        bool stop_returned = False;
        bool stopped_before_return = False;
        tp.submit(sub () {
            on_exit task_done.dec();
            tp.detachCurrentThread();
            detached.dec();
            release.waitForZero();
            stopped_before_return = stop_returned;
        });
        assertEq(0, detached.waitForZero(30s), "the task detached its worker");
        Counter stop_done(1);
        background sub () {
            on_exit stop_done.dec();
            tp.stop();
            stop_returned = True;
        }();
        release.dec();
        assertEq(0, stop_done.waitForZero(30s), "stop() returned");
        assertEq(0, task_done.getCount(), "the detached task ran to its end");
        assertFalse(stopped_before_return, "stop() did not return before the detached task returned");
    }

    #! a worker is handed a new task right after it returns itself to the idle list
    /** A worker returns itself to the pool with ThreadPool::done() without holding its own lock, so the pool can
        hand it a task before it waits for one; the task must still run exactly once.
    */
    rapidReuseTest() {
        int n = 0;
        Mutex m();
        ThreadPool tp(2, 0, 1);
        for (int i = 0; i < 1000; ++i) {
            tp.submit(sub () { m.lock(); on_exit m.unlock(); ++n; });
        }
        tp.stopWait();
        assertEq(1000, n);
    }

    #! idle workers are released while other workers return themselves to the idle list
    idleReleaseTest() {
        int n = 0;
        Mutex m();
        ThreadPool tp(4, 0, 4, 1ms);
        for (int round = 0; round < 20; ++round) {
            Counter done(10);
            for (int i = 0; i < 10; ++i) {
                tp.submit(sub () { m.lock(); on_exit m.unlock(); ++n; done.dec(); });
            }
            done.waitForZero();
        }
        tp.stopWait();
        assertEq(200, n);
    }

    #! the pool is stopped while its workers are still running tasks
    stopWaitBusyTest() {
        int n = 0;
        Mutex m();
        Counter started(4);
        Counter go(1);
        ThreadPool tp(4, 0, 2);
        for (int i = 0; i < 4; ++i) {
            tp.submit(sub () { started.dec(); go.waitForZero(); m.lock(); on_exit m.unlock(); ++n; });
        }
        # a task queued behind the busy workers runs before the pool stops
        tp.submit(sub () { m.lock(); on_exit m.unlock(); ++n; });
        started.waitForZero();
        background sub () { go.dec(); }();
        tp.stopWait();
        assertEq(5, n);
    }

    # issue #3939
    refTest() {
        val = {
            "test-1": 1,
            "test-2": 1,
        };
        RefTest rt();
        rt.test(\val);
        assertEq(2, val.i);
    }

    private doRef(reference<hash<auto>> val) {
        ThreadPool thread_pool();
        foreach string key in (keys val) {
            thread_pool.submit(sub() {
                ++val{key};
                ++val.i;
            });
        }
        thread_pool.stopWait();
        check(\val);
    }

    private check(reference<hash<auto>> val) {
        val.other = 3;
    }

    # issue #3897
    stopWaitTest() {
        int c;
        ThreadPool tp();
        code job = sub () { ++c; };
        tp.submit(job);
        tp.submit(job);
        tp.stopWait();
        assertEq(2, c);
    }

    ThreadPoolTest() {
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.parse("sub set(string k, auto val) { save_thread_data((k: val)); } auto sub get(string k) { return get_thread_data(k); }", "");
        p.callFunction("set", "key", "value1");
        assertEq("value1", p.callFunction("get", "key"));

        Counter c(1);
        Counter start(1);

        code task = sub () {
            assertEq(NOTHING, p.callFunction("get", "key"));
            p.callFunction("set", "key", "value");
            assertEq("value", p.callFunction("get", "key"));
            start.dec();
            c.waitForZero();
        };

        ThreadPool tp();
        tp.submit(task);

        # wait for task to be run
        start.waitForZero();

        assertEq("value1", p.callFunction("get", "key"));

        delete p;
        delete task;

        # signal background task to exit
        c.dec();
    }
}
