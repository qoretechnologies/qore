    HTTP/2 Benchmark Server
    -----------------------
    Simple HTTPS/HTTP/2 server for use with h2load and wrk benchmarks.
    Writes its port number to a file for the driver script to read.

    Usage:
      qore h2-bench-server.qr [--port-file=PATH] [--verbose]
*/

%requires Util
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires ../../../TestCertificates.qm

#! Simple handler that returns "OK" for all requests
class BenchHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {"Content-Type": "text/plain"});
    }
}

#! Handler that returns a response of configurable size
class SizedHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 1000;
        *list<*string> m = (hdr.path =~ x/sized\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        return makeResponse(200, strmul("X", size), {"Content-Type": "text/plain"});
    }
}

const CertPem = TestCertificates::CertPem;

const KeyPem = TestCertificates::KeyPem;

const Opts = {
    "port_file": "port-file=s",
    "verbose": "verbose,v",
    "help": "help,h",
};

sub usage() {
    printf(
"Usage: h2-bench-server.qr [OPTIONS]

HTTP/2 benchmark server for use with h2load/wrk.

Options:
  --port-file=PATH    Write listening port to this file (default: stdout)
  --verbose, -v       Verbose logging
  --help, -h          Show usage

Endpoints:
  /           Returns 'OK' (2 bytes)
  /sized/N    Returns N bytes of 'X' characters
");
    exit(0);
}

GetOpt g(Opts);
hash<auto> opts = g.parse3(\ARGV);
if (opts.help) {
    usage();
}

# Create logger
Logger logger("h2-bench-server", LoggerLevel::getLevelInfo());
if (opts.verbose) {
    logger.addAppender(new StdoutAppender());
}

# Create HTTP server
hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
    "logger": logger,
    "debug": opts.verbose ? True : False,
};
HttpServer server(http_opts);

# Register handlers
server.setHandler("bench", "/", NOTHING, new BenchHandler());
server.setHandler("sized", "/sized", NOTHING, new SizedHandler());
server.setDefaultHandler("bench", new BenchHandler());

# Add HTTPS listener for HTTP/2
SSLCertificate cert(CertPem);
SSLPrivateKey key(KeyPem);
hash<auto> listener_info = server.addListener(<HttpListenerOptionInfo>{
    "service": 0,
    "cert": cert,
    "key": key,
    "http_version": "auto",
});
int port = listener_info.port;

# Write port to file or stdout
if (opts.port_file) {
    File f();
    f.open2(opts.port_file, O_CREAT | O_WRONLY | O_TRUNC);
    f.write(sprintf("%d\n", port));
} else {
    printf("PORT=%d\n", port);
}

stderr.printf("HTTP/2 benchmark server listening on https://localhost:%d\n", port);
stderr.printf("Press Ctrl+C to stop\n");

# Wait until killed
Counter stop(1);

set_signal_handler(SIGINT, sub (int sig) {
    stderr.printf("\nShutting down...\n");
    stop.dec();
});
set_signal_handler(SIGTERM, sub (int sig) {
    stop.dec();
});

stop.waitForZero();

server.stop();
stderr.printf("Server stopped.\n");
