%modern

#! a library module for asyncio_cancel_ownership.qtest whose initialization submits an async I/O operation and
#! adds a timer
module AioCancelInitLib {
    version = "1.0";
    desc = "test library module whose initialization submits an async I/O operation";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    init = sub () {
        AioCancelInitLib::Lib::init();
    };
}

public namespace AioCancelInitLib {
class WaitingOperation inherits AbstractPollOperation<auto> {
    private {
        EventNotifier notifier;
    }

    constructor(EventNotifier notifier) {
        self.notifier = notifier;
    }

    string getGoal() {
        return "waiting";
    }

    string getState() {
        return "waiting";
    }

    bool goalReached() {
        return False;
    }

    *hash<SocketPollInfo> continuePoll() {
        return <SocketPollInfo>{"events": SOCK_POLLIN, "socket": notifier};
    }
}

public class Lib {
    private:internal {
        static *EventNotifier notifier;
        #! the operation object: an operation whose object is deleted is canceled
        static *WaitingOperation op;
        #! the timer that the module's initialization adds
        static int timer_id;
    }

    #! the ID of the timer that the module's initialization adds
    static int getTimerId() {
        return timer_id;
    }

    #! the key of the operation that the module's initialization submits
    static string getKey() {
        return sprintf("aio-cancel-init-lib-%d", getpid());
    }

    static init() {
        notifier = new EventNotifier();
        AsyncIoController::submit(<SocketPollOperationInfo>{
            "sock": notifier,
            "spop": (op = new WaitingOperation(notifier)),
            "owner": getKey(),
            "key": getKey(),
            "to": -1s,
        });
        timer_id = AsyncIoController::addTimerDelay(1D, True);
    }

    static bool cancelByKey(string key) {
        return AsyncIoController::cancelByKey(key);
    }
}
}
