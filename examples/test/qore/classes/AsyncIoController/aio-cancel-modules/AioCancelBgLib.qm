%modern

#! a library module for asyncio_cancel_ownership.qtest: submits, cancels and replaces async I/O operations and adds and
#! cancels timers in threads that it starts
module AioCancelBgLib {
    version = "1.0";
    desc = "test library module that acts on async I/O operations and timers in threads that it starts";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
}

public namespace AioCancelBgLib {
#! an operation that waits for an event of its notifier, which never comes
class WaitingOperation inherits AbstractPollOperation<auto> {
    private {
        EventNotifier notifier;
    }

    constructor(EventNotifier notifier) {
        self.notifier = notifier;
    }

    string getGoal() {
        return "waiting";
    }

    string getState() {
        return "waiting";
    }

    bool goalReached() {
        return False;
    }

    *hash<SocketPollInfo> continuePoll() {
        return <SocketPollInfo>{"events": SOCK_POLLIN, "socket": notifier};
    }
}

public class Lib {
    private:internal {
        #! the notifiers and the operation objects of the submitted operations: an operation whose object is
        #! deleted is canceled
        static list<auto> held;
        static Mutex lck();
        static Queue service_requests();
        static Queue service_replies();
        #! the module's pool, shared by every caller: its one worker runs every task (qore#7010)
        static ThreadPool pool(1, 1, 1);
    }

    #! runs the code in a task of the module's pool and returns its result, or the error that it raised
    private:internal static auto inPool(code c) {
        Queue q();
        pool.submit(sub () {
            try {
                q.push({"result": c()});
            } catch (hash<ExceptionInfo> ex) {
                q.push({"error": ex.err});
            }
        });
        hash<auto> h = q.get(60s);
        return h.hasKey("error") ? h.error : h.result;
    }

    #! runs the code in the callback of a timer and returns its result, or the error that it raised
    private:internal static auto inTimer(code c) {
        Queue q();
        AsyncIoController::addTimerDelay(0s, sub () {
            try {
                q.push({"result": c()});
            } catch (hash<ExceptionInfo> ex) {
                q.push({"error": ex.err});
            }
        });
        hash<auto> h = q.get(60s);
        return h.hasKey("error") ? h.error : h.result;
    }

    #! adds a timer in a task of the module's pool that a thread that the module starts submits; returns its ID and
    #! the TID of the pool's worker
    static auto addTimerPoolBg() {
        return inThread(auto sub () {
            return Lib::inPool(hash<auto> sub () {
                return {"id": AsyncIoController::addTimerDelay(1D, True), "tid": gettid()};
            });
        });
    }

    #! cancels a timer in a task of the module's pool that a thread that the module starts submits; returns the
    #! result and the TID of the pool's worker
    static auto cancelTimerPoolBg(int id) {
        return inThread(auto sub () {
            return Lib::inPool(hash<auto> sub () {
                return {"result": AsyncIoController::cancelTimer(id), "tid": gettid()};
            });
        });
    }

    #! adds a timer in a task of the module's pool and cancels it in another, both submitted by one thread that the
    #! module starts; returns the result of the cancel
    static auto addCancelTimerPoolBg() {
        return inThread(auto sub () {
            int id = Lib::inPool(int sub () { return AsyncIoController::addTimerDelay(1D, True); });
            return Lib::inPool(bool sub () { return AsyncIoController::cancelTimer(id); });
        });
    }

    #! adds a timer in the callback of a timer that a thread that the module starts adds; returns its ID and the TID of
    #! the worker that runs the callback
    static auto addTimerInCallbackBg() {
        return inThread(auto sub () {
            return Lib::inTimer(hash<auto> sub () {
                return {"id": AsyncIoController::addTimerDelay(1D, True), "tid": gettid()};
            });
        });
    }

    #! cancels a timer in the callback of a timer that a thread that the module starts adds; returns the result and the
    #! TID of the worker that runs the callback
    static auto cancelTimerInCallbackBg(int id) {
        return inThread(auto sub () {
            return Lib::inTimer(hash<auto> sub () {
                return {"result": AsyncIoController::cancelTimer(id), "tid": gettid()};
            });
        });
    }

    #! adds a timer in the callback of a timer and cancels it in the callback of another, both added by one thread that
    #! the module starts; returns the result of the cancel
    static auto addCancelTimerInCallbackBg() {
        return inThread(auto sub () {
            int id = Lib::inTimer(int sub () { return AsyncIoController::addTimerDelay(1D, True); });
            return Lib::inTimer(bool sub () { return AsyncIoController::cancelTimer(id); });
        });
    }

    #! runs the code in a thread that the module starts and returns its result, or the error that it raised, once the
    #! thread has ended
    /** The thread has ended when this returns: its TID can then be given to the next thread that the module starts
    */
    private:internal static auto inThread(code c) {
        Queue q();
        int tid = background sub () {
            try {
                q.push({"result": c()});
            } catch (hash<ExceptionInfo> ex) {
                q.push({"error": ex.err});
            }
        }();
        hash<auto> h = q.get(60s);
        if (!thread_join(tid, 60s)) {
            throw "THREAD-ERROR", sprintf("thread %d did not end", tid);
        }
        return h.hasKey("error") ? h.error : h.result;
    }

    private:internal static auto submitIntern(string key, bool replace, *string owner) {
        EventNotifier n();
        {
            AutoLock al(lck);
            push held, n;
        }
        WaitingOperation op(n);
        {
            AutoLock al(lck);
            push held, op;
        }
        return AsyncIoController::submit(<SocketPollOperationInfo>{
            "sock": n,
            "spop": op,
            "owner": owner ?? key,
            "key": key,
            "to": -1s,
        }, replace);
    }

    #! submits an operation with the key in a thread that the module starts; returns its result queue
    static auto submitBg(string key) {
        return inThread(auto sub () { return Lib::submitIntern(key, False); });
    }

    #! submits an operation with the owner and the key in a thread that the module starts; returns its result queue
    static auto submitBgFor(string owner, string key) {
        return inThread(auto sub () { return Lib::submitIntern(key, False, owner); });
    }

    #! submits an operation with the key, replacing the one with the key, in a thread that the module starts; returns
    #! its result queue
    static auto replaceBg(string key) {
        return inThread(auto sub () { return Lib::submitIntern(key, True); });
    }

    #! adds a timer in a thread that the module starts; returns its ID and the TID of the thread
    static hash<auto> addTimerBgTid() {
        return inThread(hash<auto> sub () {
            return {"id": AsyncIoController::addTimerDelay(1D, True), "tid": gettid()};
        });
    }

    #! cancels a timer in a thread that the module starts; returns the result and the TID of the thread
    static hash<auto> cancelTimerBgTid(int id) {
        return inThread(hash<auto> sub () {
            return {"result": AsyncIoController::cancelTimer(id), "tid": gettid()};
        });
    }

    #! starts the module's service thread, which serves every caller of the module (qore#6208)
    static startService() {
        background Lib::service();
    }

    #! has the service thread add a timer; returns its ID
    static int serviceAddTimer() {
        service_requests.push({"op": "timer"});
        return service_replies.get(60s);
    }

    #! has the service thread submit an operation with the key; returns its result queue
    static auto serviceSubmit(string key) {
        service_requests.push({"op": "submit", "key": key});
        return service_replies.get(60s);
    }

    #! stops the service thread
    static stopService() {
        service_requests.push({"op": "stop"});
        service_replies.get(60s);
    }

    #! adds a timer that does not expire in the test in the call; returns its ID
    static int addTimerCall() {
        return AsyncIoController::addTimerDelay(1D, True);
    }

    #! cancels a timer in the call
    static bool cancelTimerCall(int id) {
        return AsyncIoController::cancelTimer(id);
    }

    #! the service thread: its own code adds the timers and submits the operations, for no caller of its own
    private:internal static service() {
        while (True) {
            hash<auto> r = service_requests.get();
            switch (r.op) {
                case "stop": service_replies.push(True); return;
                case "timer": service_replies.push(AsyncIoController::addTimerDelay(1D, True)); break;
                case "submit": service_replies.push(Lib::submitIntern(r.key, False)); break;
            }
        }
    }

    #! cancels by key in a thread that the module starts
    static auto cancelBg(string key) {
        return inThread(auto sub () { return AsyncIoController::cancelByKey(key); });
    }

    #! cancels by owner in a thread that the module starts
    static auto cancelOwnerBg(string owner) {
        return inThread(auto sub () { return AsyncIoController::cancelByOwner(owner); });
    }

    #! adds a timer that does not expire in the test in a thread that the module starts; returns its ID
    static auto addTimerBg() {
        return inThread(auto sub () { return AsyncIoController::addTimerDelay(1D, True); });
    }

    #! cancels a timer in a thread that the module starts
    static auto cancelTimerBg(int id) {
        return inThread(auto sub () { return AsyncIoController::cancelTimer(id); });
    }
}
}
