    # Category 5: Scalability
    # ========================================================================

    #! 10 cycles of start -> submit connect -> accept -> result -> stop
    testIoThreadRestartCycles() {
        int cycles = scaleForValgrind(10, 3);

        AsyncIoController ctrl(False);

        for (int i = 0; i < cycles; ++i) {
            ctrl.start();
            assertTrue(ctrl.waitReady(ShortTimeout));

            Socket listener();
            listener.bind("localhost:0");
            listener.listen();
            int port = listener.getSocketInfo().port;

            Socket client();
            AbstractPollOperation spop = client.startPollConnect("localhost:" + port);
            Queue q = ctrl.submit(<SocketPollOperationInfo>{
                "sock": client,
                "spop": spop,
                "owner": sprintf("cycle-%d", i),
                "to": ConnectTimeout,
            });

            Socket accepted = listener.accept(ConnectTimeout);

            hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
            assertFalse(result.canceled ?? False);
            assertNothing(result.ex);

            ctrl.stop();
            assertFalse(ctrl.running());
        }
    }

    #! Submit blocking op, background thread calls stop(), main thread immediately submits new op
    testSubmitDuringStop() {
        AsyncIoController ctrl(False);
        ctrl.start();
        assertTrue(ctrl.waitReady(ShortTimeout));

        # Submit a blocking op
        hash<auto> setup = setupBlockingRecvOp();
        Queue q1 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup.server,
            "spop": setup.spop,
            "owner": "stop-submit",
            "to": -1,
            "key": "stop-submit:1",
        });

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Background thread calls stop
        Counter stop_done(1);
        background sub () {
            on_exit stop_done.dec();
            try {
                ctrl.stop();
            } catch (hash<ExceptionInfo> ex) {
                # Expected
            }
        }();

        # Wait for stop to complete
        assertEq(0, stop_done.waitForZero(ShortTimeout));

        # First op should be canceled
        hash<SocketPollResultInfo> result1 = q1.get(ShortTimeout);
        assertTrue(result1.canceled ?? False);

        # Submit a new op — should restart the thread
        Socket listener2();
        listener2.bind("localhost:0");
        listener2.listen();
        int port2 = listener2.getSocketInfo().port;

        Socket client2();
        AbstractPollOperation spop2 = client2.startPollConnect("localhost:" + port2);
        Queue q2 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client2,
            "spop": spop2,
            "owner": "stop-submit-2",
            "to": ConnectTimeout,
        });

        Socket accepted2 = listener2.accept(ConnectTimeout);
        hash<SocketPollResultInfo> result2 = q2.get(ConnectTimeout);
        assertFalse(result2.canceled ?? False);
        assertNothing(result2.ex);

        ctrl.stop();
    }

    #! N=100 mixed accept + recv + timers
    testLargeScaleMixedOperations() {
        int n = scaleForValgrind(100, 20);
        int n_accept = n / 2;
        int n_recv = n / 2;
        int n_timers = n / 10;

        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        # Timer tracking
        Counter timer_done(n_timers);
        Mutex timer_m();
        int timer_fire_count = 0;
        ctrl.setTimerCallback(sub (hash<TimerEventInfo> info) {
            {
                AutoLock al(timer_m);
                ++timer_fire_count;
            }
            timer_done.dec();
        });

        # Submit accept ops with callbacks
        Socket listener();
        listener.bind("localhost:0");
        listener.listen(n_accept + 10);
        int port = listener.getSocketInfo().port;
        on_exit listener.close();

        Counter accept_done(n_accept);
        for (int i = 0; i < n_accept; ++i) {
            AbstractPollOperation spop = listener.startPollAccept();
            ctrl.submit(<SocketPollOperationInfo>{
                "sock": listener,
                "spop": spop,
                "owner": "large-scale",
                "to": ConnectTimeout,
                "key": sprintf("lsa:%d", i),
                "callback": sub (hash<SocketPollResultInfo> result) {
                    accept_done.dec();
                },
            });
        }

        # Submit recv ops with queues
        list<hash<auto>> recv_setups = ();
        list<Queue> recv_queues = ();
        for (int i = 0; i < n_recv; ++i) {
            hash<auto> setup = setupBlockingRecvOp();
            push recv_setups, setup;
            Queue q = ctrl.submit(<SocketPollOperationInfo>{
                "sock": setup.server,
                "spop": setup.spop,
                "owner": "large-scale",
                "to": ConnectTimeout,
                "key": sprintf("lsr:%d", i),
            });
            push recv_queues, q;
        }

        # Add timers
        for (int i = 0; i < n_timers; ++i) {
            ctrl.addTimer(now_us() + (100ms + milliseconds(i * 20)), {"index": i});
        }

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Connect clients for accept ops
        for (int i = 0; i < n_accept; ++i) {
            Socket client();
            client.connect("localhost:" + port);
        }

        # Send data for recv ops
        for (int i = 0; i < n_recv; ++i) {
            recv_setups[i].client.send("data");
        }

        # Wait for all accept completions
        assertEq(0, accept_done.waitForZero(StressTimeout));

        # Wait for all recv completions
        int recv_completed = 0;
        for (int i = 0; i < n_recv; ++i) {
            hash<SocketPollResultInfo> result = recv_queues[i].get(StressTimeout);
            if (!(result.canceled ?? False) && !result.ex) {
                ++recv_completed;
            }
        }
        assertEq(n_recv, recv_completed);

        # Wait for all timer completions
        assertEq(0, timer_done.waitForZero(StressTimeout));
        {
            AutoLock al(timer_m);
            assertEq(n_timers, timer_fire_count);
        }
    }

    # ========================================================================
    # Category 6: Mixed Patterns
    # ========================================================================

    #! 3 callback recv ops + 1 blocking exec() connect op on same controller
    testMixedExecAndCallback() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        int n_callbacks = 3;
        Counter cb_done(n_callbacks);
        Mutex cb_m();
        int cb_success = 0;

        # Submit 3 recv ops with callbacks
        list<hash<auto>> setups = ();
        for (int i = 0; i < n_callbacks; ++i) {
            hash<auto> setup = setupBlockingRecvOp();
            push setups, setup;
            ctrl.submit(<SocketPollOperationInfo>{
                "sock": setup.server,
                "spop": setup.spop,
                "owner": "mixed-exec",
                "to": ConnectTimeout,
                "key": sprintf("mixed-cb:%d", i),
                "callback": sub (hash<SocketPollResultInfo> result) {
                    if (!(result.canceled ?? False) && !result.ex) {
                        AutoLock al(cb_m);
                        ++cb_success;
                    }
                    cb_done.dec();
                },
            });
        }

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Background thread: send data to trigger all 3 callbacks
        background sub () {
            try {
                for (int i = 0; i < n_callbacks; ++i) {
                    setups[i].client.send("callback-data");
                }
            } catch (hash<ExceptionInfo> ex) {
                # Ignore
            }
        }();

        # Main thread: blocking exec() with a connect op
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        # Accept in background
        Counter accept_done(1);
        background sub () {
            on_exit accept_done.dec();
            try {
                Socket accepted = listener.accept(ConnectTimeout);
            } catch (hash<ExceptionInfo> ex) {
                # Ignore
            }
        }();

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);
        hash<SocketPollResultInfo> exec_result = ctrl.exec(<SocketPollOperationInfo>{
            "sock": client,
            "spop": spop,
            "owner": "mixed-exec-sync",
            "to": ConnectTimeout,
        });

        # exec() should return connect result
        assertFalse(exec_result.canceled ?? False);
        assertNothing(exec_result.ex);

        # All 3 callbacks should fire
        assertEq(0, cb_done.waitForZero(StressTimeout));
        {
            AutoLock al(cb_m);
            assertEq(n_callbacks, cb_success);
        }

        assertEq(0, accept_done.waitForZero(ShortTimeout));
    }

    #! Submit recv op, call wake() 5-10 times rapidly, then send data
    testWakeForPendingWrites() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        hash<auto> setup = setupBlockingRecvOp();
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup.server,
            "spop": setup.spop,
            "owner": "wake-test",
            "to": ConnectTimeout,
        });

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Rapid wakes (HTTP/2 frame flushing pattern)
        for (int i = 0; i < 10; ++i) {
            ctrl.wake();
        }

        # Send data to complete the recv
        setup.client.send("wake-data");

        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertFalse(result.canceled ?? False);
        assertNothing(result.ex);
    }

    #! Submit op with other: {"gen": 1}, cancel, submit replacement with other: {"gen": 2}
    testGenerationCounterStaleResults() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        hash<auto> setup1 = setupBlockingRecvOp();
        Queue q_old = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup1.server,
            "spop": setup1.spop,
            "owner": "gen-test",
            "to": -1,
            "key": "gen-key",
            "other": {"gen": 1},
        });

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Cancel the first op
        assertTrue(ctrl.cancelByKey("gen-key"));

        # Verify first result is canceled with gen 1
        hash<SocketPollResultInfo> result1 = q_old.get(ShortTimeout);
        assertTrue(result1.canceled ?? False);
        assertEq(1, result1.other.gen);

        # Submit replacement with gen 2
        hash<auto> setup2 = setupBlockingRecvOp();
        Queue q_new = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup2.server,
            "spop": setup2.spop,
            "owner": "gen-test",
            "to": ConnectTimeout,
            "key": "gen-key",
            "other": {"gen": 2},
        });

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Complete the new op
        setup2.client.send("gen2-data");

        hash<SocketPollResultInfo> result2 = q_new.get(ConnectTimeout);
        assertFalse(result2.canceled ?? False);
        assertNothing(result2.ex);
        assertEq(2, result2.other.gen);
    }

    #! UDP recv + timer that triggers a send to complete a recv (simulates QUIC retransmit)
    testUdpDatagramWithTimerRetransmit() {
        # Use a TCP pair for the timer-driven send pattern
        # (UDP sendTo requires startPollSendTo which needs a nested callback)
        hash<auto> pair = setupSocketPair();
        on_exit {
            pair.server.close();
            pair.client.close();
            pair.listener.close();
        }

        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        # Submit recv op
        AbstractPollOperation recv_op = pair.server.startPollRecvData();
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": pair.server,
            "spop": recv_op,
            "owner": "retransmit-2",
            "to": ConnectTimeout,
            "key": "retransmit:recv",
        });

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Timer callback sends data directly (synchronous send on connected socket)
        Counter timer_done(1);
        Socket timer_client = pair.client;
        ctrl.setTimerCallback(sub (hash<TimerEventInfo> info) {
            timer_client.send("timer-retransmit-data");
            timer_done.dec();
        });

        ctrl.addTimer(now_us() + 100ms, "retransmit-2");

        # Timer fires -> data sent -> recv completes
        assertEq(0, timer_done.waitForZero(ShortTimeout));

        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertFalse(result.canceled ?? False);
        assertNothing(result.ex);
    }

    #! Recv on socketA with key "conn:1", cancel, submit recv on socketB with same key
    testConnectionMigrationPattern() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        # Setup socketA
        hash<auto> setupA = setupBlockingRecvOp();
        Queue qA = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setupA.server,
            "spop": setupA.spop,
            "owner": "migration",
            "to": -1,
            "key": "conn:1",
        });

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Cancel socketA op
        assertTrue(ctrl.cancelByKey("conn:1"));

        hash<SocketPollResultInfo> resultA = qA.get(ShortTimeout);
        assertTrue(resultA.canceled ?? False);

        # Submit on socketB with same key (no replace needed since old one was canceled)
        hash<auto> setupB = setupBlockingRecvOp();
        Queue qB = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setupB.server,
            "spop": setupB.spop,
            "owner": "migration",
            "to": ConnectTimeout,
            "key": "conn:1",
        });

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Send data on socketB
        setupB.client.send("migrated-data");

        hash<SocketPollResultInfo> resultB = qB.get(ConnectTimeout);
        assertFalse(resultB.canceled ?? False);
        assertNothing(resultB.ex);
    }

    # ========================================================================
    # Category 7: Error/Edge Cases
    # ========================================================================

    #! 5 accept ops on same listener with custom keys. Cancel 3 by key. 2 remaining still work.
    testSharedSocketRefCounting() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen(10);
        int port = listener.getSocketInfo().port;
        on_exit listener.close();

        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        int n = 5;
        list<Queue> queues = ();
        for (int i = 0; i < n; ++i) {
            AbstractPollOperation spop = listener.startPollAccept();
            Queue q = ctrl.submit(<SocketPollOperationInfo>{
                "sock": listener,
                "spop": spop,
                "owner": "refcount",
                "to": ConnectTimeout,
                "key": sprintf("ref:%d", i),
            });
            push queues, q;
        }

        assertTrue(ctrl.waitForProcessing(ShortTimeout));
        assertEq(n, ctrl.getCacheSize());

        # Cancel 3 ops by key
        for (int i = 0; i < 3; ++i) {
            assertTrue(ctrl.cancelByKey(sprintf("ref:%d", i)));
        }
        assertEq(2, ctrl.getCacheSize());

        # Verify canceled ops
        for (int i = 0; i < 3; ++i) {
            hash<SocketPollResultInfo> result = queues[i].get(ShortTimeout);
            assertTrue(result.canceled ?? False);
        }

        # Remaining 2 ops should still work — connect 2 clients
        for (int i = 0; i < 2; ++i) {
            Socket client();
            client.connect("localhost:" + port);
        }

        int completed = 0;
        for (int i = 3; i < n; ++i) {
            hash<SocketPollResultInfo> result = queues[i].get(ConnectTimeout);
            if (!(result.canceled ?? False) && !result.ex) {
                ++completed;
            }
        }
        assertEq(2, completed);
    }

    #! 5 connect ops with callbacks, one throws exception. Other 4 succeed.
    testCallbackExceptionDoesNotLoseOps() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        int n = 5;
        int throw_index = 2;  # The third callback throws

        Socket listener();
        listener.bind("localhost:0");
        listener.listen(n + 5);
        int port = listener.getSocketInfo().port;
        on_exit listener.close();

        Mutex m();
        list<int> completed_indices = ();
        Counter done(n);

        for (int i = 0; i < n; ++i) {
            int my_index = i;
            Socket client();
            AbstractPollOperation spop = client.startPollConnect("localhost:" + port);
            ctrl.submit(<SocketPollOperationInfo>{
                "sock": client,
                "spop": spop,
                "owner": "cb-exception",
                "to": ConnectTimeout,
                "key": sprintf("cb-ex:%d", i),
                "callback": sub (hash<SocketPollResultInfo> result) {
                    {
                        AutoLock al(m);
                        push completed_indices, my_index;
                    }
                    done.dec();
                    if (my_index == throw_index) {
                        throw "TEST-CB-EXCEPTION", "intentional exception from callback";
                    }
                },
            });
        }

        # Accept all connections
        for (int i = 0; i < n; ++i) {
            Socket accepted = listener.accept(ConnectTimeout);
        }

        assertEq(0, done.waitForZero(StressTimeout));

        {
            AutoLock al(m);
            assertEq(n, completed_indices.size());
        }

        # Controller should still be functional
        Socket client2();
        AbstractPollOperation spop2 = client2.startPollConnect("localhost:" + port);
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client2,
            "spop": spop2,
            "owner": "post-exception",
            "to": ConnectTimeout,
        });

        Socket accepted2 = listener.accept(ConnectTimeout);
        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertFalse(result.canceled ?? False);
        assertNothing(result.ex);
    }

    #! 30 blocking recv ops. stopClear(). All 30 results have canceled=True.
    testStopClearUnderLoad() {
        int n = scaleForValgrind(30, 5);

        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit {
            try { ctrl.stop(); } catch () {}
        }

        # Must keep references to setups so client sockets aren't garbage collected
        # (client socket close would cause EOF on server, completing recv ops)
        list<hash<auto>> setups = ();
        list<Queue> queues = ();
        for (int i = 0; i < n; ++i) {
            hash<auto> setup = setupBlockingRecvOp();
            push setups, setup;
            Queue q = ctrl.submit(<SocketPollOperationInfo>{
                "sock": setup.server,
                "spop": setup.spop,
                "owner": "stop-clear",
                "to": -1,
                "key": sprintf("sc:%d", i),
            });
            push queues, q;
        }

        assertTrue(ctrl.waitForProcessing(ShortTimeout));
        assertEq(n, ctrl.getCacheSize());

        # stopClear
        ctrl.stopClear();

        # All should be canceled
        int canceled = 0;
        for (int i = 0; i < n; ++i) {
            hash<SocketPollResultInfo> result = queues[i].get(ShortTimeout);
            if (result.canceled ?? False) {
                ++canceled;
            }
        }
        assertEq(n, canceled);

        assertFalse(ctrl.running());
        assertEq(0, ctrl.getCacheSize());
    }

    #! Submit with key "dup", submit again with same key without replace. ASYNC-IO-ERROR thrown.
    testDuplicateKeyWithCustomKeys() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        hash<auto> setup1 = setupBlockingRecvOp();
        Queue q1 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup1.server,
            "spop": setup1.spop,
            "owner": "dup-test",
            "to": -1,
            "key": "dup",
        });

        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # Second submit with same key should throw
        hash<auto> setup2 = setupBlockingRecvOp();
        assertThrows("ASYNC-IO-ERROR", sub () {
            ctrl.submit(<SocketPollOperationInfo>{
                "sock": setup2.server,
                "spop": setup2.spop,
                "owner": "dup-test",
                "to": -1,
                "key": "dup",
            });
        });

        # First op should still be active and cancelable
        assertEq(1, ctrl.getCacheSize());
        assertTrue(ctrl.cancelByKey("dup"));

        hash<SocketPollResultInfo> result = q1.get(ShortTimeout);
        assertTrue(result.canceled ?? False);
    }

    #! Multiple submit batches with waitForProcessing() after each
    testWaitForProcessingEdgeCases() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        int batches = scaleForValgrind(5, 3);
        int batch_size = scaleForValgrind(10, 3);

        for (int batch = 0; batch < batches; ++batch) {
            list<Queue> queues = ();

            # Submit a batch of connect ops
            Socket listener();
            listener.bind("localhost:0");
            listener.listen(batch_size + 5);
            int port = listener.getSocketInfo().port;

            for (int i = 0; i < batch_size; ++i) {
                Socket client();
                AbstractPollOperation spop = client.startPollConnect("localhost:" + port);
                Queue q = ctrl.submit(<SocketPollOperationInfo>{
                    "sock": client,
                    "spop": spop,
                    "owner": sprintf("batch-%d", batch),
                    "to": ConnectTimeout,
                    "key": sprintf("batch:%d:%d", batch, i),
                });
                push queues, q;
            }

            # waitForProcessing after batch submit
            assertTrue(ctrl.waitForProcessing(ShortTimeout));

            # Accept all and drain queues
            for (int i = 0; i < batch_size; ++i) {
                Socket accepted = listener.accept(ConnectTimeout);
            }

            int completed = 0;
            for (int i = 0; i < batch_size; ++i) {
                hash<SocketPollResultInfo> result = queues[i].get(ConnectTimeout);
                if (!(result.canceled ?? False) && !result.ex) {
                    ++completed;
                }
            }
            assertEq(batch_size, completed);
        }
    }

    #! exec() with recv op and 500ms timeout, no data sent
    testExecTimeout() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();
        assertTrue(ctrl.waitReady(ShortTimeout));

        hash<auto> setup = setupBlockingRecvOp();

        # exec() with timeout - no data sent so it should time out
        hash<SocketPollResultInfo> result = ctrl.exec(<SocketPollOperationInfo>{
            "sock": setup.server,
            "spop": setup.spop,
            "owner": "exec-timeout",
            "to": 500ms,
        });

        assertFalse(result.canceled ?? False);
        assertEq(True, exists result.ex);
        assertEq("SOCKET-TIMEOUT", result.ex.err);

        # Controller should still be functional
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client,
            "spop": spop,
            "owner": "post-timeout",
            "to": ConnectTimeout,
        });

        Socket accepted = listener.accept(ConnectTimeout);
        hash<SocketPollResultInfo> result2 = q.get(ConnectTimeout);
        assertFalse(result2.canceled ?? False);
        assertNothing(result2.ex);
    }
}
