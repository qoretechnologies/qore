#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../../qlib/QUnit.qm

%exec-class AsyncIoControllerTest

#! Comprehensive tests for the AsyncIoController class
class AsyncIoControllerTest inherits QUnit::Test {
    public {
        const ConnectTimeout = 60s;
        const ShortTimeout = 10s;
    }

    constructor() : Test("AsyncIoControllerTest", "1.0") {
        # Tests using the constructor require a debug build + QORE_ASYNCIO_TEST_MODE=1
        if (Option::HAVE_LIBRARY_DEBUGGING && ENV.QORE_ASYNCIO_TEST_MODE) {
            addTestCase("basic construction and state", \testConstruction());
            addTestCase("autostop flag", \testAutostop());
            addTestCase("start/stop lifecycle", \testStartStop());
            addTestCase("submit with queue result", \testSubmitQueue());
            addTestCase("submit with callback", \testSubmitCallback());
            addTestCase("submit with shared queue", \testSubmitSharedQueue());
            addTestCase("exec synchronous", \testExec());
            addTestCase("cancel by socket", \testCancelBySocket());
            addTestCase("cancel by key", \testCancelByKey());
            addTestCase("cancel by owner", \testCancelByOwner());
            addTestCase("submit with replace", \testSubmitReplace());
            addTestCase("submit with custom key", \testSubmitCustomKey());
            addTestCase("autostop behavior", \testAutostopBehavior());
            addTestCase("autostop disabled", \testAutostopDisabled());
            addTestCase("multiple concurrent operations", \testMultipleConcurrent());
            addTestCase("getInfo", \testGetInfo());
            addTestCase("waitReady", \testWaitReady());
            addTestCase("other data passthrough", \testOtherData());
            addTestCase("duplicate key error", \testDuplicateKeyError());
            addTestCase("submit after stop error", \testSubmitAfterStop());
            addTestCase("wake", \testWake());
            addTestCase("operation timeout", \testOperationTimeout());
            addTestCase("actual timeout expiry", \testActualTimeout());
            addTestCase("direct cancel when I/O thread not running", \testDirectCancel());
            addTestCase("setLogger validation", \testSetLoggerValidation());
            addTestCase("continuePoll exception", \testContinuePollException());
            addTestCase("controller timer callback fires", \testControllerTimer());
            addTestCase("controller timer cancel", \testControllerTimerCancel());
            addTestCase("controller timer cleanup on stop", \testControllerTimerCleanupOnStop());
            addTestCase("controller timer with I/O", \testControllerTimerWithIo());

            # Dedicated thread tests
            addTestCase("dedicated thread with C++ continuePoll", \testDedicatedThreadCpp());
            addTestCase("dedicated thread with Qore continuePoll", \testDedicatedThreadQore());
            addTestCase("dedicated thread cancel", \testDedicatedThreadCancel());
            addTestCase("dedicated thread error propagation", \testDedicatedThreadError());
            addTestCase("dedicated thread cancel by owner", \testDedicatedThreadCancelByOwner());
            addTestCase("dedicated thread reuse after cancel", \testDedicatedThreadReuse());
        }

        # These tests always work (use get() singleton, not constructor)
        addTestCase("copy constructor error", \testCopy());
        addTestCase("static get() singleton", \testGetSingleton());

        set_return_value(main());
    }

    #! Helper: build a SocketPollOperationInfo hash for a connect operation
    private hash<SocketPollOperationInfo> makeConnectInfo(Socket client, AbstractPollOperation spop,
            string owner = "test", timeout to = ConnectTimeout) {
        return <SocketPollOperationInfo>{
            "sock": client,
            "spop": spop,
            "owner": owner,
            "to": to,
        };
    }

    #! Helper: create a connected socket pair and a recv operation that will block until data is sent
    /** This creates an operation that will not complete until data is explicitly sent.
        Useful for testing cancel, replace, and other operations that need an in-flight operation.
        @return a hash with keys: listener, server, client, spop
    */
    private hash<auto> setupBlockingRecvOp() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        # Establish a connection
        Socket client();
        client.connect("localhost:" + port);
        Socket server = listener.accept(ConnectTimeout);

        # Create a recv operation on the server side - will block until client sends data
        AbstractPollOperation spop = server.startPollRecvString(1024);

        return {
            "listener": listener,
            "server": server,
            "client": client,
            "spop": spop,
        };
    }

    testConstruction() {
        # Default construction (autostop = True)
        {
            AsyncIoController ctrl();
            assertTrue(ctrl.getAutostop());
            assertFalse(ctrl.running());
            assertEq(0, ctrl.getCacheSize());
        }

        # Explicit autostop = True
        {
            AsyncIoController ctrl1(True);
            assertTrue(ctrl1.getAutostop());
        }

        # Explicit autostop = False
        {
            AsyncIoController ctrl2(False);
            assertFalse(ctrl2.getAutostop());
        }
    }

    testAutostop() {
        AsyncIoController ctrl();
        assertTrue(ctrl.getAutostop());

        ctrl.setAutostop(False);
        assertFalse(ctrl.getAutostop());

        ctrl.setAutostop(True);
        assertTrue(ctrl.getAutostop());
    }

    testStartStop() {
        AsyncIoController ctrl(False);
        assertFalse(ctrl.running());

        ctrl.start();
        assertTrue(ctrl.waitReady(ShortTimeout));
        assertTrue(ctrl.running());

        ctrl.stop();
        assertFalse(ctrl.running());

        # Stop when already stopped should be safe
        ctrl.stop();
        assertFalse(ctrl.running());
    }

    testSubmitQueue() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        AsyncIoController ctrl();

        Queue q = ctrl.submit(makeConnectInfo(client, spop));
        assertEq(True, exists q);
        assertGe(0, ctrl.getCacheSize());

        # Accept the connection on the listener side
        Socket accepted = listener.accept(ConnectTimeout);

        # Wait for the result
        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertEq(True, exists result);
        assertEq(True, exists result.sock);
        assertEq(True, exists result.spop);
        assertFalse(result.canceled ?? False);
        assertNothing(result.ex);
    }

    testSubmitCallback() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        AsyncIoController ctrl();

        Queue sync_q();
        auto rv = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client,
            "spop": spop,
            "owner": "test",
            "to": ConnectTimeout,
            "callback": sub (hash<SocketPollResultInfo> result) {
                sync_q.push(result);
            },
        });
        # When callback is provided, submit returns NOTHING
        assertNothing(rv);

        # Accept the connection
        Socket accepted = listener.accept(ConnectTimeout);

        # Result delivered via callback
        hash<SocketPollResultInfo> result = sync_q.get(ConnectTimeout);
        assertEq(True, exists result);
        assertFalse(result.canceled ?? False);
        assertNothing(result.ex);
    }

    testSubmitSharedQueue() {
        # Use blocking recv operations so they stay in-flight until we send data
        hash<auto> setup1 = setupBlockingRecvOp();
        hash<auto> setup2 = setupBlockingRecvOp();

        AsyncIoController ctrl(False);
        Queue shared_q();

        ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup1.server,
            "spop": setup1.spop,
            "owner": "test",
            "to": -1,
            "resultQueue": shared_q,
        });

        ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup2.server,
            "spop": setup2.spop,
            "owner": "test",
            "to": -1,
            "resultQueue": shared_q,
        });

        assertTrue(ctrl.waitReady(ShortTimeout));
        assertEq(2, ctrl.getCacheSize());

        # Send 1024 bytes to complete each recv operation (startPollRecvString(1024))
        string fill = strmul("x", 1024);
        setup1.client.send(fill);
        setup2.client.send(fill);

        # Both results arrive in the shared queue
        hash<SocketPollResultInfo> result1 = shared_q.get(ConnectTimeout);
        assertEq(True, exists result1);
        assertFalse(result1.canceled ?? False);

        hash<SocketPollResultInfo> result2 = shared_q.get(ConnectTimeout);
        assertEq(True, exists result2);
        assertFalse(result2.canceled ?? False);

        ctrl.stop();
    }

    testExec() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        AsyncIoController ctrl();

        # Accept in a background thread since exec() blocks
        Counter done(1);
        background sub () {
            try {
                on_exit done.dec();
                Socket accepted = listener.accept(ConnectTimeout);
            } catch (hash<ExceptionInfo> ex) {
                # Ignore
            }
        }();

        hash<SocketPollResultInfo> result = ctrl.exec(makeConnectInfo(client, spop));

        assertEq(True, exists result);
        assertFalse(result.canceled ?? False);
        assertNothing(result.ex);

        assertEq(0, done.waitForZero(ConnectTimeout));
    }

    testCancelBySocket() {
        # Use a blocking recv operation so the operation stays in-flight
        hash<auto> setup = setupBlockingRecvOp();
        AsyncIoController ctrl(False);

        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup.server,
            "spop": setup.spop,
            "owner": "test",
            "to": -1,
        });

        assertTrue(ctrl.waitReady(ShortTimeout));
        assertEq(1, ctrl.getCacheSize());

        # Cancel the operation by socket
        bool canceled = ctrl.cancel(setup.server);
        assertTrue(canceled);
        assertEq(0, ctrl.getCacheSize());

        # The result should indicate cancellation
        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertTrue(result.canceled ?? False);

        ctrl.stop();
    }

    testCancelByKey() {
        hash<auto> setup = setupBlockingRecvOp();
        AsyncIoController ctrl(False);

        string key = "my-custom-key";
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup.server,
            "spop": setup.spop,
            "owner": "test",
            "to": -1,
            "key": key,
        });

        assertTrue(ctrl.waitReady(ShortTimeout));
        assertEq(1, ctrl.getCacheSize());

        bool canceled = ctrl.cancelByKey(key);
        assertTrue(canceled);
        assertEq(0, ctrl.getCacheSize());

        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertTrue(result.canceled ?? False);

        # Cancel non-existent key should return False
        canceled = ctrl.cancelByKey("no-such-key");
        assertFalse(canceled);

        ctrl.stop();
    }

    testCancelByOwner() {
        # Create 3 blocking recv operations with different owners
        hash<auto> setup1 = setupBlockingRecvOp();
        hash<auto> setup2 = setupBlockingRecvOp();
        hash<auto> setup3 = setupBlockingRecvOp();

        AsyncIoController ctrl(False);

        Queue q1 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup1.server, "spop": setup1.spop, "owner": "owner-A", "to": -1,
        });
        Queue q2 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup2.server, "spop": setup2.spop, "owner": "owner-A", "to": -1,
        });
        Queue q3 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup3.server, "spop": setup3.spop, "owner": "owner-B", "to": -1,
        });

        assertTrue(ctrl.waitReady(ShortTimeout));
        assertEq(3, ctrl.getCacheSize());

        # Cancel all operations for owner-A
        int count = ctrl.cancelByOwner("owner-A");
        assertEq(2, count);
        assertEq(1, ctrl.getCacheSize());

        # Verify both owner-A operations were canceled
        hash<SocketPollResultInfo> result1 = q1.get(ShortTimeout);
        assertTrue(result1.canceled ?? False);

        hash<SocketPollResultInfo> result2 = q2.get(ShortTimeout);
        assertTrue(result2.canceled ?? False);

        # owner-B operation should still be active; cancel it too
        count = ctrl.cancelByOwner("owner-B");
        assertEq(1, count);
        assertEq(0, ctrl.getCacheSize());

        hash<SocketPollResultInfo> result3 = q3.get(ShortTimeout);
        assertTrue(result3.canceled ?? False);

        # Cancel with no matching owner
        count = ctrl.cancelByOwner("no-such-owner");
        assertEq(0, count);

        ctrl.stop();
    }

    testSubmitReplace() {
        # Use a blocking recv op for the first operation (so it stays in-flight)
        hash<auto> setup1 = setupBlockingRecvOp();
        AsyncIoController ctrl(False);

        string key = "replace-key";
        Queue q1 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup1.server,
            "spop": setup1.spop,
            "owner": "test",
            "to": -1,
            "key": key,
        });

        assertTrue(ctrl.waitReady(ShortTimeout));
        assertEq(1, ctrl.getCacheSize());

        # Create a new connect operation to replace the old one
        Socket listener2();
        listener2.bind("localhost:0");
        listener2.listen();
        int port2 = listener2.getSocketInfo().port;

        Socket client2();
        AbstractPollOperation spop2 = client2.startPollConnect("localhost:" + port2);

        Queue q2 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client2,
            "spop": spop2,
            "owner": "test",
            "to": ConnectTimeout,
            "key": key,
        }, True);

        # Old operation should have been canceled
        hash<SocketPollResultInfo> result1 = q1.get(ShortTimeout);
        assertTrue(result1.canceled ?? False);

        # Accept and verify the new operation completes
        Socket accepted2 = listener2.accept(ConnectTimeout);
        hash<SocketPollResultInfo> result2 = q2.get(ConnectTimeout);
        assertEq(True, exists result2);
        assertFalse(result2.canceled ?? False);

        ctrl.stop();
    }

    testSubmitCustomKey() {
        # Use blocking recv operations so they stay in-flight until we send data
        hash<auto> setup1 = setupBlockingRecvOp();
        hash<auto> setup2 = setupBlockingRecvOp();

        AsyncIoController ctrl(False);

        Queue q1 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup1.server,
            "spop": setup1.spop,
            "owner": "test",
            "to": -1,
            "key": "connect:1",
        });

        Queue q2 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup2.server,
            "spop": setup2.spop,
            "owner": "test",
            "to": -1,
            "key": "connect:2",
        });

        assertTrue(ctrl.waitReady(ShortTimeout));
        assertEq(2, ctrl.getCacheSize());

        # Send 1024 bytes to complete each recv operation (startPollRecvString(1024))
        string fill = strmul("x", 1024);
        setup1.client.send(fill);
        setup2.client.send(fill);

        # Both should complete
        hash<SocketPollResultInfo> result1 = q1.get(ConnectTimeout);
        assertFalse(result1.canceled ?? False);
        assertNothing(result1.ex);

        hash<SocketPollResultInfo> result2 = q2.get(ConnectTimeout);
        assertFalse(result2.canceled ?? False);
        assertNothing(result2.ex);

        ctrl.stop();
    }

    testAutostopBehavior() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        AsyncIoController ctrl(True);

        Queue q = ctrl.submit(makeConnectInfo(client, spop));

        assertTrue(ctrl.running());

        # Accept the connection to let the operation complete
        Socket accepted = listener.accept(ConnectTimeout);

        # Wait for result
        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertFalse(result.canceled ?? False);

        # With autostop, the I/O thread should stop after all operations complete
        ctrl.waitStop();
        assertFalse(ctrl.running());
    }

    testAutostopDisabled() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        AsyncIoController ctrl(False);

        Queue q = ctrl.submit(makeConnectInfo(client, spop));

        assertTrue(ctrl.running());

        # Accept the connection
        Socket accepted = listener.accept(ConnectTimeout);

        # Wait for result
        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertFalse(result.canceled ?? False);

        # Wait for I/O thread to process the completed operation
        assertTrue(ctrl.waitForProcessing(ShortTimeout));

        # With autostop disabled, I/O thread should keep running
        assertTrue(ctrl.running());
        assertEq(0, ctrl.getCacheSize());

        ctrl.stop();
        assertFalse(ctrl.running());
    }

    testMultipleConcurrent() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        int count = 5;
        AsyncIoController ctrl();
        list<Queue> queues = ();

        for (int i = 0; i < count; ++i) {
            Socket client();
            AbstractPollOperation spop = client.startPollConnect("localhost:" + port);
            Queue q = ctrl.submit(<SocketPollOperationInfo>{
                "sock": client,
                "spop": spop,
                "owner": "test-" + i,
                "to": ConnectTimeout,
                "key": "connect:" + i,
            });
            push queues, q;
        }

        # With the C++ controller, localhost connects may complete before all submits finish,
        # so getCacheSize() may be 0 on fast systems; the real test is that all 5 complete
        assertTrue(ctrl.getCacheSize() <= count);

        # Accept all connections
        for (int i = 0; i < count; ++i) {
            Socket accepted = listener.accept(ConnectTimeout);
        }

        # All should complete
        int completed = 0;
        foreach Queue q in (queues) {
            hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
            assertEq(True, exists result);
            if (!(result.canceled ?? False) && !result.ex) {
                ++completed;
            }
        }
        assertEq(count, completed);
    }

    testGetInfo() {
        AsyncIoController ctrl(False);
        ctrl.start();
        assertTrue(ctrl.waitReady(ShortTimeout));

        hash<auto> info = ctrl.getInfo();
        assertTrue(info.running);
        assertEq(0, info.cache_size);
        assertFalse(info.autostop);
        assertFalse(info.shutting_down);
        assertEq(True, info.tid > 0);
        assertEq("list<string>", info.cache_keys.fullType());
        assertEq(0, info.cache_keys.size());

        ctrl.stop();

        info = ctrl.getInfo();
        assertFalse(info.running);
    }

    testWaitReady() {
        AsyncIoController ctrl(False);

        # waitReady before start should return false with timeout
        bool ready = ctrl.waitReady(100ms);
        assertFalse(ready);

        ctrl.start();
        ready = ctrl.waitReady(ShortTimeout);
        assertTrue(ready);

        ctrl.stop();
    }

    testOtherData() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        AsyncIoController ctrl();

        hash<auto> other_data = {
            "request_id": 42,
            "label": "test-op",
            "nested": {"a": 1, "b": 2},
        };

        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client,
            "spop": spop,
            "owner": "test",
            "to": ConnectTimeout,
            "other": other_data,
        });

        # Accept connection
        Socket accepted = listener.accept(ConnectTimeout);

        # Verify 'other' data is passed through
        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertEq(True, exists result.other);
        assertEq(42, result.other.request_id);
        assertEq("test-op", result.other.label);
        assertEq(1, result.other.nested.a);
    }

    testDuplicateKeyError() {
        hash<auto> setup1 = setupBlockingRecvOp();
        AsyncIoController ctrl(False);

        ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup1.server,
            "spop": setup1.spop,
            "owner": "test",
            "to": -1,
            "key": "dup-key",
        });

        assertTrue(ctrl.waitReady(ShortTimeout));

        # Second submit with same key without replace should throw
        hash<auto> setup2 = setupBlockingRecvOp();

        assertThrows("ASYNC-IO-ERROR", sub () {
            ctrl.submit(<SocketPollOperationInfo>{
                "sock": setup2.server,
                "spop": setup2.spop,
                "owner": "test",
                "to": -1,
                "key": "dup-key",
            });
        });

        ctrl.stop();
    }

    testSubmitAfterStop() {
        AsyncIoController ctrl(False);
        ctrl.start();
        assertTrue(ctrl.waitReady(ShortTimeout));
        ctrl.stop();
        assertFalse(ctrl.running());

        # Submit after stop should work (restarts thread)
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        Queue q = ctrl.submit(makeConnectInfo(client, spop));

        # Accept and complete
        Socket accepted = listener.accept(ConnectTimeout);
        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertFalse(result.canceled ?? False);
    }

    testWake() {
        # Wake on a non-running controller should not crash
        AsyncIoController ctrl(False);
        ctrl.wake();

        # Wake on a running controller
        ctrl.start();
        assertTrue(ctrl.waitReady(ShortTimeout));
        ctrl.wake();
        # No assertion needed - just verify no crash/hang
        ctrl.stop();
    }

    testOperationTimeout() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        # Connect on localhost completes quickly; verify the op succeeds (not times out)
        AsyncIoController ctrl();
        Queue q = ctrl.submit(makeConnectInfo(client, spop));

        # Accept the connection
        Socket accepted = listener.accept(ConnectTimeout);

        hash<SocketPollResultInfo> result = q.get(ConnectTimeout);
        assertFalse(result.canceled ?? False);
        assertNothing(result.ex);
    }

    testCopy() {
        auto ctrl = AsyncIoController::get();
        # Copy should raise an error (singleton enforcement)
        assertThrows("ASYNCIOCONTROLLER-COPY-ERROR", sub () { ctrl.copy(); });
    }

    testGetSingleton() {
        # get() returns the same object every time
        auto c1 = AsyncIoController::get();
        auto c2 = AsyncIoController::get();
        assertTrue(c1 === c2);
        # Default autostop is True
        assertTrue(c1.getAutostop());
    }

    testActualTimeout() {
        # Create a connected pair but never send data, so the recv op will time out
        hash<auto> setup = setupBlockingRecvOp();

        AsyncIoController ctrl();
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup.server,
            "spop": setup.spop,
            "owner": "test",
            "to": 1s,  # 1 second timeout
        });

        # Wait for the result — should arrive within a few seconds
        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertEq(True, exists result);
        assertFalse(result.canceled ?? False);
        # Timeout delivers an exception hash with err = "SOCKET-TIMEOUT"
        assertEq(True, exists result.ex);
        assertEq("SOCKET-TIMEOUT", result.ex.err);
    }

    testDirectCancel() {
        # Test cancel on unknown key returns False
        AsyncIoController ctrl(False);
        assertFalse(ctrl.cancelByKey("nonexistent-key"));

        # Test cancelByOwner on unknown owner returns 0
        assertEq(0, ctrl.cancelByOwner("nonexistent-owner"));

        # Test cancel by key on a running operation
        hash<auto> setup = setupBlockingRecvOp();
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup.server,
            "spop": setup.spop,
            "owner": "test",
            "to": -1,
            "key": "cancel-key",
        });
        assertTrue(ctrl.waitReady(ShortTimeout));
        assertTrue(ctrl.cancelByKey("cancel-key"));
        assertEq(0, ctrl.getCacheSize());

        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertTrue(result.canceled ?? False);

        # Test cancelByOwner on a running operation
        hash<auto> setup2 = setupBlockingRecvOp();
        ctrl.start();
        Queue q2 = ctrl.submit(<SocketPollOperationInfo>{
            "sock": setup2.server,
            "spop": setup2.spop,
            "owner": "cancel-owner",
            "to": -1,
        });
        assertTrue(ctrl.waitForProcessing(ShortTimeout));
        assertEq(1, ctrl.cancelByOwner("cancel-owner"));
        assertEq(0, ctrl.getCacheSize());

        hash<SocketPollResultInfo> result2 = q2.get(ShortTimeout);
        assertTrue(result2.canceled ?? False);

        ctrl.stop();
    }

    testSetLoggerValidation() {
        AsyncIoController ctrl();

        # Passing NOTHING should succeed (clears logger)
        ctrl.setLogger();

        # Object with both logArgs and isEnabledFor should succeed
        # (We need a real LoggerInterface object; test that invalid objects are rejected)

        # Object missing logArgs should throw
        assertThrows("ASYNC-IO-ERROR", "logArgs", sub() {
            ctrl.setLogger(new Mutex());
        });

        # Passing NOTHING again should succeed (idempotent clear)
        ctrl.setLogger();
    }

    #! Test that a timer fires and the callback is invoked
    testControllerTimer() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        # Track callback invocation
        Counter cnt(1);
        hash<auto> received_info;

        ctrl.setTimerCallback(sub (hash<TimerEventInfo> info) {
            received_info = info;
            cnt.dec();
        });

        int id = ctrl.addTimer(now_us() + 100ms, {"key": "heartbeat"});
        assertTrue(id > 0);

        # Wait for callback to fire
        int rc = cnt.waitForZero(5s);
        assertEq(0, rc);
        assertEq(id, received_info.id);
        assertEq({"key": "heartbeat"}, received_info.udata);
    }

    #! Test that canceling a timer prevents callback
    testControllerTimerCancel() {
        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        Counter fired_cnt(1);
        ctrl.setTimerCallback(sub (hash<TimerEventInfo> info) {
            fired_cnt.dec();
        });

        # Use a very long timeout so it won't fire even under valgrind
        int id = ctrl.addTimer(now_us() + 60s, NOTHING);
        assertTrue(id > 0);

        bool canceled = ctrl.cancelTimer(id);
        assertTrue(canceled);

        # Second cancel should return False
        assertFalse(ctrl.cancelTimer(id));

        # Verify the timer doesn't fire — wait a short time (the timer had a 60s deadline
        # so even under valgrind it shouldn't fire before cancellation takes effect)
        int rc = fired_cnt.waitForZero(500ms);
        assertNeq(0, rc);  # counter never reached zero (timer didn't fire)
    }

    #! Test that timers are cleaned up when controller is stopped
    testControllerTimerCleanupOnStop() {
        AsyncIoController ctrl(False);
        ctrl.start();

        bool callback_fired = False;
        ctrl.setTimerCallback(sub (hash<TimerEventInfo> info) {
            callback_fired = True;
        });

        ctrl.addTimer(now_us() + 5s, "timer1");
        ctrl.addTimer(now_us() + 5s, "timer2");

        # Stop the controller — timers should be cleaned up
        ctrl.stop();
        assertFalse(callback_fired);
        # If we get here without a crash or leak, the test passes
        assertTrue(True);
    }

    #! Test that timers and I/O operations work together
    testControllerTimerWithIo() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        AsyncIoController ctrl(False);
        ctrl.start();
        on_exit ctrl.stop();

        # Set up timer callback
        Counter timer_cnt(1);
        int timer_id_received;
        ctrl.setTimerCallback(sub (hash<TimerEventInfo> info) {
            timer_id_received = info.id;
            timer_cnt.dec();
        });

        # Submit a connect operation (will complete quickly)
        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client,
            "spop": spop,
            "owner": "test",
            "to": ConnectTimeout,
        });

        # Add a timer too
        int tid = ctrl.addTimer(now_us() + 100ms, "timer-with-io");

        # Wait for both: I/O should complete first, then timer fires
        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertEq(True, exists result);
        assertFalse(result.canceled ?? False);

        # Wait for timer to fire
        int rc = timer_cnt.waitForZero(5s);
        assertEq(0, rc);
        assertEq(tid, timer_id_received);
    }

    testContinuePollException() {
        # Use a connected pair — we need a valid socket for the SocketPollOperationInfo
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        client.connect("localhost:" + port);
        Socket server = listener.accept(ConnectTimeout);

        # Create an operation with an ErrorPollOp that throws on continuePoll
        # Since no poll_info is provided, the I/O thread calls continuePoll immediately
        AsyncIoController ctrl();
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": server,
            "spop": new ErrorPollOp(),
            "owner": "test",
            "to": ConnectTimeout,
        });

        # The result should have an exception — continuePoll throws immediately
        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertEq(True, exists result);
        assertFalse(result.canceled ?? False);
        assertEq(True, exists result.ex);
        assertEq("TEST-POLL-ERROR", result.ex.err);
    }

    # --- Dedicated thread tests ---

    #! Helper: set up a listener and return a connect poll operation
    private hash<auto> setupConnectOp() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Socket client();
        AbstractPollOperation spop = client.startPollConnect("localhost:" + port);

        return {
            "listener": listener,
            "client": client,
            "spop": spop,
            "port": port,
        };
    }

    #! Verify C++ poll operation runs on a dedicated thread (direct path, no dispatcher)
    testDedicatedThreadCpp() {
        hash<auto> op = setupConnectOp();
        on_exit {
            try { op.listener.close(); } catch () {}
            try { op.client.close(); } catch () {}
        }

        AsyncIoController ctrl();
        on_exit ctrl.stop();

        # Submit with dedicated_thread=True — C++ connect operation, no Qore override
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": op.client,
            "spop": op.spop,
            "owner": "dedicated-test",
            "to": ConnectTimeout,
            "dedicated_thread": True,
        });

        # Controller should show the dedicated thread
        hash<auto> info = ctrl.getInfo();
        assertEq(True, info.dedicated_thread_count > 0,
            "controller should have dedicated threads");

        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertEq(True, exists result, "should get a result");
        assertFalse(result.canceled ?? False, "should not be canceled");
        assertFalse(exists result.ex,
            sprintf("should have no exception: %y", result.ex));
        # Accept the connection to clean up
        Socket accepted = op.listener.accept(ShortTimeout);
    }

    #! Verify Qore-language continuePoll() override dispatches through the worker pool
    testDedicatedThreadQore() {
        hash<auto> op = setupConnectOp();
        on_exit {
            try { op.listener.close(); } catch () {}
            try { op.client.close(); } catch () {}
        }

        AsyncIoController ctrl();
        on_exit ctrl.stop();

        # Use QorePollOp which has a Qore-language continuePoll() override
        auto qore_op = new QorePollOp(op.spop, op.client);

        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": op.client,
            "spop": qore_op,
            "owner": "qore-dedicated-test",
            "to": ConnectTimeout,
            "dedicated_thread": True,
        });

        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertEq(True, exists result, "should get a result");
        assertFalse(result.canceled ?? False, "should not be canceled");
        assertFalse(exists result.ex,
            sprintf("should have no exception: %y", result.ex));

        # Verify the Qore continuePoll was actually called
        assertEq(True, qore_op.wasCalled(), "Qore continuePoll should have been called");
        Socket accepted = op.listener.accept(ShortTimeout);
    }

    #! Verify cancel works for dedicated threads
    testDedicatedThreadCancel() {
        # Use a connect to a non-routable address so the operation stays in-flight
        Socket client();
        # 192.0.2.1 is TEST-NET-1 (RFC 5737) — guaranteed non-routable
        AbstractPollOperation spop = client.startPollConnect("192.0.2.1:12345");

        AsyncIoController ctrl();
        on_exit ctrl.stop();

        string key = "cancel-me";
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client,
            "spop": spop,
            "owner": "cancel-test",
            "to": ConnectTimeout,
            "dedicated_thread": True,
            "key": key,
        });

        # Cancel the dedicated thread
        assertTrue(ctrl.cancelByKey(key), "cancelByKey should find the dedicated thread");

        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertEq(True, exists result, "should get a result");
        assertEq(True, result.canceled, "result should be canceled");
    }

    #! Verify exception propagation from Qore continuePoll on dedicated thread
    testDedicatedThreadError() {
        # Need a valid socket for the SocketPollOperationInfo
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;
        Socket client();
        client.connect("localhost:" + port);
        Socket server = listener.accept(ConnectTimeout);
        on_exit {
            try { listener.close(); } catch () {}
            try { server.close(); } catch () {}
            try { client.close(); } catch () {}
        }

        AsyncIoController ctrl();
        on_exit ctrl.stop();

        # ErrorPollOp throws on first continuePoll — dispatched via QoreCallDispatcher
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": server,
            "spop": new ErrorPollOp(),
            "owner": "error-test",
            "to": ConnectTimeout,
            "dedicated_thread": True,
        });

        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertEq(True, exists result, "should get a result");
        assertFalse(result.canceled ?? False, "should not be canceled");
        assertEq(True, exists result.ex, "should have an exception");
        assertEq("TEST-POLL-ERROR", result.ex.err,
            "exception err should match");
    }

    #! Verify cancelByOwner works for dedicated threads
    testDedicatedThreadCancelByOwner() {
        # Use non-routable address so the operation stays in-flight
        Socket client();
        AbstractPollOperation spop = client.startPollConnect("192.0.2.1:12345");

        AsyncIoController ctrl();
        on_exit ctrl.stop();

        string owner = "owner-dedicated";
        Queue q = ctrl.submit(<SocketPollOperationInfo>{
            "sock": client,
            "spop": spop,
            "owner": owner,
            "to": ConnectTimeout,
            "dedicated_thread": True,
        });

        int count = ctrl.cancelByOwner(owner);
        assertEq(1, count, "cancelByOwner should cancel 1 dedicated thread");

        hash<SocketPollResultInfo> result = q.get(ShortTimeout);
        assertEq(True, result.canceled, "result should be canceled");
    }

    #! Verify dedicated threads can be reused after cancel (dispatcher lifecycle)
    testDedicatedThreadReuse() {
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;
        on_exit { try { listener.close(); } catch () {} }

        AsyncIoController ctrl();
        on_exit ctrl.stop();

        for (int i = 0; i < 3; i++) {
            Socket client();
            AbstractPollOperation spop = client.startPollConnect("localhost:" + port);
            auto qore_op = new QorePollOp(spop, client);

            Queue q = ctrl.submit(<SocketPollOperationInfo>{
                "sock": client,
                "spop": qore_op,
                "owner": sprintf("reuse-%d", i),
                "to": ConnectTimeout,
                "dedicated_thread": True,
            });

            hash<SocketPollResultInfo> result = q.get(ShortTimeout);
            assertEq(True, exists result,
                sprintf("cycle %d: should get result", i));
            assertFalse(result.canceled ?? False,
                sprintf("cycle %d: should not be canceled", i));
            assertFalse(exists result.ex,
                sprintf("cycle %d: should have no exception: %y", i, result.ex));
            assertEq(True, qore_op.wasCalled(),
                sprintf("cycle %d: Qore continuePoll should have been called", i));

            # Accept and close the connection
            Socket accepted = listener.accept(ShortTimeout);
            try { accepted.close(); } catch () {}
            try { client.close(); } catch () {}
        }
    }
}

#! Mock poll operation that throws on continuePoll
class ErrorPollOp inherits AbstractPollOperation {
    string getGoal() {
        return "error";
    }

    string getState() {
        return "waiting";
    }

    bool goalReached() {
        return False;
    }

    *hash<SocketPollInfo> continuePoll() {
        throw "TEST-POLL-ERROR", "intentional error from test poll operation";
    }
}

#! Qore-language poll operation wrapper — validates the dispatcher path
/** Wraps a real C++ poll operation with a Qore-language continuePoll() override.
    Tracks whether the Qore method was called, proving the QoreCallDispatcher
    worker thread pool dispatched the call correctly.
*/
class QorePollOp inherits AbstractPollOperation {
    private {
        AbstractPollOperation inner;
        Socket sock;
        bool called = False;
    }

    constructor(AbstractPollOperation inner, Socket sock) {
        self.inner = inner;
        self.sock = sock;
    }

    string getGoal() {
        return inner.getGoal();
    }

    string getState() {
        return inner.getState();
    }

    bool goalReached() {
        return inner.goalReached();
    }

    *hash<SocketPollInfo> continuePoll() {
        called = True;
        *hash<SocketPollInfo> rv = inner.continuePoll();
        if (rv) {
            return rv;
        }
        # If the inner operation completed (returned NOTHING), return NOTHING
        # so the dedicated thread delivers the goal-reached result
        if (inner.goalReached()) {
            return NOTHING;
        }
        # Still in progress — return POLLIN for the socket
        return <SocketPollInfo>{
            "events": SOCK_POLLIN,
            "socket": sock,
        };
    }

    bool wasCalled() {
        return called;
    }
}
