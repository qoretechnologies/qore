#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class StaticVarInitParseOptionsTest

#! The initializer of a class static variable runs with the parse options of its declaration (qore#6273)
/** It ran with the options of the code that triggered its evaluation: the statement that parses the declaring code,
    or none while a module is loaded, so that a range with negative offsets or a check of strict arguments gave a value
    that the same expression does not give in the declaring code's constants (qore#6205) and functions.
*/
class StaticVarInitParseOptionsTest inherits QUnit::Test {
    public {
        #! %modern code: static variables, and constants and a function with the same expressions
        const Code = "%modern
list<int> sub get_list() { return (1, 2, 3); }
class C {
    public {
        static auto Range = get_list()[-2..-1];
        static bool Strict = (Program::getCallerCapabilityMask(0) & PO_STRICT_ARGS) != 0;
    }
}
const ConstRange = get_list()[-2..-1];
const ConstStrict = (Program::getCallerCapabilityMask(0) & PO_STRICT_ARGS) != 0;
hash<auto> sub get() {
    return {
        \"static_range\": C::Range,
        \"static_strict\": C::Strict,
        \"const_range\": ConstRange,
        \"const_strict\": ConstStrict,
        \"fn_range\": get_list()[-2..-1],
    };
}
";

        #! legacy code without negative offsets and with loose arguments that parses the %modern code
        const LegacyHost = "%no-negative-offsets
%loose-args
hash sub run(string $code) {
    my $p = new Program();
    $p.parse($code, \"code\");
    return $p.callFunction(\"get\");
}
";

        #! a %modern module with the same static variables and constants
        const ModuleSource = "%modern
module StaticVarInitOpts {
    version = \"1.0\";
    desc = \"qore#6273: static variable initializers with the parse options of their declaration\";
    author = \"Qore\";
    license = \"MIT\";
}
list<int> sub get_list() { return (1, 2, 3); }
public namespace StaticVarInitOpts {
    public class C {
        public {
            static auto Range = get_list()[-2..-1];
            static bool Strict = (Program::getCallerCapabilityMask(0) & PO_STRICT_ARGS) != 0;
            static bool Restricted = (Program::getCallerCapabilityMask(0) & PO_NO_TERMINAL_IO) != 0;
        }
    }
    public const ConstRange = get_list()[-2..-1];
    public hash<auto> sub get() {
        return {
            \"static_range\": C::Range,
            \"static_strict\": C::Strict,
            \"static_restricted\": C::Restricted,
            \"const_range\": ConstRange,
        };
    }
}
";

        #! module code that loads a module at run time for its caller
        const LoaderModuleSource = "%modern
module StaticVarInitLoader {
    version = \"1.0\";
    desc = \"qore#6273: loads a module for its caller\";
    author = \"Qore\";
    license = \"MIT\";
}
public namespace StaticVarInitLoader {
    public hash<auto> sub load() {
        load_module(\"StaticVarInitOpts\");
        return call_function(\"StaticVarInitOpts::get\");
    }
}
";

        #! the values that the declaration's options give
        const Expected = {
            "static_range": (2, 3),
            "static_strict": True,
        };
    }

    constructor() : QUnit::Test("StaticVarInitParseOptionsTest", "1.0", \ARGV) {
        addTestCase("code parsed at run time by code with other options", \parsedAtRunTimeTest());
        addTestCase("a module loaded by legacy code", \moduleTest());
        addTestCase("a module loaded by module code for a sandboxed caller", \sandboxedLoadTest());
        set_return_value(main());
    }

    parsedAtRunTimeTest() {
        Program host();
        host.parse(LegacyHost, "host");
        hash<auto> h = host.callFunction("run", Code);
        assertEq(Expected, h{"static_range", "static_strict"}, "the static variables have the declaration's values");
        assertEq(h.const_range, h.static_range, "a static variable has the value of a constant");
        assertEq(h.fn_range, h.static_range, "a static variable has the value that the function computes");
        assertEq(h.const_strict, h.static_strict, "the static variable sees the strict arguments of the constant");
    }

    moduleTest() {
        TmpDir mods("qore-static-var-init-");
        write(mods.path + "/StaticVarInitOpts.qm", ModuleSource);
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setScriptPath(mods.path + "/legacy.q");
        p.parse(sprintf("%%no-negative-offsets\n%%loose-args\n%%prepend-module-path %s\n%%requires StaticVarInitOpts\n"
            "hash sub get() { return StaticVarInitOpts::get(); }\n", mods.path), "legacy");
        hash<auto> h = p.callFunction("get");
        assertEq(Expected, h{"static_range", "static_strict"}, "the module's static variables have its values");
        assertEq(h.const_range, h.static_range, "a static variable has the value of the module's constant");
        assertFalse(h.static_restricted, "the module's static variable has no restriction");
    }

    sandboxedLoadTest() {
        TmpDir mods("qore-static-var-init-");
        write(mods.path + "/StaticVarInitOpts.qm", ModuleSource);
        write(mods.path + "/StaticVarInitLoader.qm", LoaderModuleSource);
        # the host loads the loader module, so that its code runs with its own options for the sandboxed caller
        Program p(PO_NO_TERMINAL_IO);
        p.setSandboxManager(new SandboxManager());
        p.parse(sprintf("%%modern\n%%prepend-module-path %s\n%%requires StaticVarInitLoader\n"
            "hash<auto> sub get() { return StaticVarInitLoader::load(); }\n", mods.path), "sandboxed");
        hash<auto> h = p.callFunction("get");
        # the module code runs with the caller's restriction, but the module that it loads initializes its static
        # variables with its own options, as its constants
        assertFalse(h.static_restricted, "the static variable of a module loaded for a sandboxed caller has no "
            "restriction");
        assertEq(Expected, h{"static_range", "static_strict"}, "the loaded module's static variables have its values");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }
}
