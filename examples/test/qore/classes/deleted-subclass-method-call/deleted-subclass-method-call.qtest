#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class DeletedSubclassMethodCallTest

#! Tests the error of a method call on a deleted object of a subclass (qore#6025)
/** The error names the object's class, as the AST interpreter names it when it dispatches the call by name; a program
    compiled with qcc named the class of the method found at parse time.  The checks are in
    deleted-subclass-method-call-worker.qr, which is run in each execution mode and as a program compiled with qcc;
    every run must give the results below.
*/
class DeletedSubclassMethodCallTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "subclass": "OBJECT-ALREADY-DELETED: cannot call Gone::m2() on an object that has already been deleted",
            "subclass-override": "OBJECT-ALREADY-DELETED: cannot call Override::m2() on an object that has already "
                "been deleted",
            "subclass-return-value": "OBJECT-ALREADY-DELETED: cannot call Gone::get() on an object that has already "
                "been deleted",
            "subclass-argument-side-effect": "OBJECT-ALREADY-DELETED: cannot call Gone::m2() on an object that has "
                "already been deleted",
            "subclass-auto": "OBJECT-ALREADY-DELETED: cannot call Gone::m2() on an object that has already been "
                "deleted",
            "subclass-hash-member": "OBJECT-ALREADY-DELETED: cannot call Gone::m2() on an object that has already "
                "been deleted",
            "same-class": "OBJECT-ALREADY-DELETED: cannot call Base::m2(int x) on an object that has already been "
                "deleted",
            "cached-dispatch": "OBJECT-ALREADY-DELETED: cannot call Gone::m2() on an object that has already been "
                "deleted",
            "stable": "True",
        };

    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("DeletedSubclassMethodCallTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("IR tier", \testIrTier());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    #! every function runs on the IR tier, which the tiered run of ExecModes hardly runs
    testIrTier() {
        checkWorkerOutput("ir-tier", ExecModeHarness::run_ir_tier(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug "
            "--exec-mode=tiered %s", libqore_dir, qore_bin, getWorker())));
    }

    testCompiledProgram() {
        TmpDir tmp("qore-deleted-subclass-method-call-");
        string exe = tmp.path + DirSep + "deleted-subclass-method-call";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1", libqore_dir,
            qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "deleted-subclass-method-call-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them; any other output fails
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
