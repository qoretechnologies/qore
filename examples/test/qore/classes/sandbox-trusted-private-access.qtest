#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the member and method accesses of sandboxed classes

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class SandboxTrustedPrivateAccessTest

#! a class that sandboxed code declares cannot use the private declarations of a class that trusted code declares
#! (qore#6843)
/** For a class declared in a Program with a sandbox manager, the private members, methods and static variables that
    a class declared by trusted code declares are as if they were \c private:internal, on any object: the static
    forms are refused at parse time, the dynamic forms (an object of the class or of the class itself through a
    variable without a type, a member name computed at run time, the conversion of the object to a hash, its keys
    and its iteration, call references and closures, reflection) at run time.  The class can still use its own
    members and the public members that it inherits, implement and override the private methods of the trusted
    class, which the trusted class calls, and call the base class's version of a method that it overrides; trusted
    code keeps its private access to the objects of the sandboxed class.  A class that sandboxed code declares with
    the name and the declarations of a trusted class has no private access to the trusted class's objects either
    (lookalike.q; its private:internal declarations: lookalike-internal.q, which depends on qore#7036).  The uses of
    the private hooks of library classes that stay allowed (overrides, private and public, a recursive call of the own
    override, the implementation of private abstract hooks, the call of the library class's version of an overridden
    method) and the call of another private method of a library class, which is refused, are in library-hooks.q; the
    public methods that library classes offer their sandboxed subclasses in place of their private members are in
    public-hooks.q.  The output of every execution mode and of qcc executables (-O0, -O3) must be the expected one.

    The programs are in \c sandbox-trusted-private-access/.
*/
class SandboxTrustedPrivateAccessTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/sandbox-trusted-private-access";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("probe", "lookalike", "library-hooks", "public-hooks", "stream-request", "final-hooks");

        #! the private:internal declarations of a look-alike class (lookalike-internal.q) are refused once qore#7036
        #! is fixed: until then the program is not run
        const InternalRequires7036 = True;

        #! the programs that need the sqlite3 driver, which they leave out when it cannot be loaded
        const Sqlite3Programs = ("library-hooks",);

        #! the reason why the programs that need the sqlite3 driver are left out, if they are
        *string sqlite3_missing;
    }

    constructor() : QUnit::Test("SandboxTrustedPrivateAccessTest", "1.0", \ARGV) {
        # the driver is loaded in a child process, as the programs load it
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b -l sqlite3 -e 'exit(0);'",
            qore_bin));
        if (r.rc) {
            sqlite3_missing = sprintf("the sqlite3 driver cannot be loaded (%s): %y are not run",
                trim(r.out) ?: sprintf("exit status %d", r.rc), Sqlite3Programs);
        }
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT, tiered and IR-tier execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        addTestCase("the private:internal declarations of a look-alike class (qore#7036)", \testInternal());
        set_return_value(main());
    }

    #! the programs that can run here
    private list<string> programs() {
        return sqlite3_missing ? (select Programs, !inlist($1, Sqlite3Programs)) : Programs;
    }

    #! ends a test case with a skip when programs were left out
    private skipIfLeftOut() {
        if (sqlite3_missing) {
            testSkip(sqlite3_missing);
        }
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    #! runs the program in a mode; ir_tier: tiered execution on the IR tier (ExecModeHarness::IRTierEnv)
    private string run(string name, string mode, *bool ir_tier) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name), NOTHING,
            ir_tier ? ExecModeHarness::IRTierEnv : NOTHING);
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, ir_tier ? ExecModeHarness::IRTierName
            : mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (programs()) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
        skipIfLeftOut();
    }

    testModes() {
        foreach string name in (programs()) {
            foreach string mode in (Modes) {
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
            # the IR tier of tiered execution runs the calls in the IR interpreter
            assertEq(expected(name), run(name, "tiered", True), name + " " + ExecModeHarness::IRTierName);
        }
        skipIfLeftOut();
    }

    testInternal() {
        if (InternalRequires7036) {
            testSkip("the private:internal declarations of a look-alike class are refused once qore#7036 is fixed");
        }
        foreach string mode in (Modes) {
            assertEq(expected("lookalike-internal"), run("lookalike-internal", mode), "lookalike-internal " + mode);
        }
    }

    #! returns the qcc of the test
    private string qccBin() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        return is_file(qcc_bin) ? qcc_bin : "qcc";
    }

    #! compiles a program with qcc; skips the test case if it cannot
    private compile(string src, string exe, string opt) {
        int rc;
        string out = backquote(sprintf("%s -O%s -o %s %s 2>&1", qccBin(), opt, exe, src), \rc);
        if (rc || !is_file(exe)) {
            testSkip("qcc is not available or cannot compile " + src + ": " + out);
        }
    }

    #! runs an executable that qcc compiled from a program and checks its output
    /** @param quiet_loader_warnings if @ref True, the module loader's warnings are only returned (see
        ExecModeHarness::run_command())

        @return the result of the run, with the module loader's warnings, which are not output of the program
    */
    private hash<ExecModeHarness::ModeRunResult> runCompiled(string name, string exe, string label,
            *bool quiet_loader_warnings) {
        # -b must be the first argument of a compiled program
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b", exe),
            quiet_loader_warnings);
        assertEq(0, r.rc, sprintf("%s: exit status (output: %y)", label, r.out));
        assertEq(expected(name), r.stdout, label);
        # the program writes nothing else to stderr (the native compilation trace is not output either)
        assertEq("", r.stderr, label + ": stderr");
        return r;
    }

    testCompiled() {
        TmpDir tmp("qore-sandbox-trusted-private-access-");
        foreach string name in (programs()) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                compile(sprintf("%s/%s.q", dir, name), exe, opt);
                runCompiled(name, exe, sprintf("%s -O%s", name, opt));
            }
        }
        skipIfLeftOut();
    }
}
