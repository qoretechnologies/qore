#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes, and in qcc executables

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit
%requires ../../TestInterpreter.qm

%exec-class NumberRoundExactTest

#! round(), ceil() and floor() of a number with a precision are exact for any precision (qore#6278)
/** They scaled the number by a floating-point power of 10, which is inexact above 10^22 and was limited to 10^308, so
    that round(1.2345678901234567890123456789n, 24) gave a long inexact value and a precision beyond 308 gave a wrong
    multiple (ceil(123.5n, -400) gave about 10^308); the multiple of the power of 10 is now found exactly, in integer
    arithmetic, from the binary value of the number, and is correctly rounded: with digits after the decimal point
    to the precision of the number parsed from its decimal string (qore#7014), so that it compares equal to the
    literal of its value, and otherwise to the number's precision.  The probes (number-round-exact/probes.q) run in each
    execution mode in a child process, with tiered execution at the IR tier and promoted to native code, and as
    qcc-compiled executables (-O0, -O3).  The expected output is number-round-exact/expected.txt.
*/
class NumberRoundExactTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string expected;
    }

    constructor() : QUnit::Test("NumberRoundExact", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = TestInterpreter::qcc_compiler() ?? "qcc";
        string lines = ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "number-round-exact" + DirSep
            + "expected.txt");
        for (int i = 0; i < 3; ++i) {
            expected += sprintf("%d:\n%s", i, lines);
        }

        addTestCase("number rounding with a precision is exact", \testModes());
        set_return_value(main());
    }

    testModes() {
        TmpDir tmp("qore-number-round-exact-");
        string file = tmp.path + DirSep + "prog.q";
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "number-round-exact" + DirSep + "probes.q")
            + "\nfor (int i = 0; i < 3; ++i) {\n    printf(\"%d:\\n%s\\n\", i, probes());\n}\n");
        f.close();

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=2 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)), mode);
        }
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
            "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), "tiered, IR tier");
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 --jit-jit-threshold=1 "
            "%s 2>&1", env, qore_bin, file)), "tiered, promoted");
        foreach string opt in (("-O0", "-O3")) {
            string exe = file + opt;
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                file));
            assertTrue(is_file(exe), sprintf("qcc %s compiled the executable: %s", opt, out));
            assertEq(expected, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                libqore_dir, exe)), "qcc " + opt);
            assertEq(expected, backquote(sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=1 LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, libqore_dir, exe)), "qcc " + opt + ", JIT");
        }
    }
}
