two_locals 1: k |~k~l
two_locals 2: k |~k~l
three_locals 1: k |~z~k~l
three_locals 2: k |~z~k~l
member_read 1: b |~b~a
member_read 2: b |~b~a
method_arg 1: ba |~c~b~a
method_arg 2: ba |~c~b~a
container_read 1: h |~h~a
container_read 2: h |~h~a
first_local 1: l |~k~l
first_local 2: l |~k~l
constant 1: x |~k~l
constant 2: x |~k~l
nested 1: innerouter |~last~inner~outer
nested 2: innerouter |~last~inner~outer
handler 1: b ||exit~b~a
handler 2: b ||exit~b~a
foreach_reassign 1: m2 ~m~t|~m2~t2
foreach_reassign 2: m2 ~m~t|~m2~t2
param_read 1: pa |~a~p
param_read 2: pa |~a~p
in_try 1: b |~b~a
in_try 2: b |~b~a
in_catch 1: e |~e~a
in_catch 2: e |~e~a
catch_block_local 1: k |~k~e
catch_block_local 2: k |~k~e
only_local 1: a1 |~a
only_local 2: a1 |~a
