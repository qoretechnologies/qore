#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class PwdTest

public class PwdTest inherits QUnit::Test {
    constructor() : Test("PwdTest", "1.0") {
        addTestCase("Pwd tests", \pwdTestMethod(), NOTHING);
        addTestCase("Pwd error codes", \pwdErrorCodeTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    pwdTestMethod() {
        if (!Option::HAVE_UNIX_USERMGT) {
            testSkip("No support for UNIX user management");
        }

        hash h;

        testAssertion("getpwuid()", \getpwuid(), (0,), new TestResultPartialHashMatch(("pw_uid" : 0)));
        testAssertion("getpwuid2()", \getpwuid2(), (0,), new TestResultPartialHashMatch(("pw_uid" : 0)));

        testAssertion("getpwnam()", \getpwnam(), ("root",), new TestResultPartialHashMatch(("pw_uid" : 0)));
        testAssertion("getpwnam2()", \getpwnam2(), ("root",), new TestResultPartialHashMatch(("pw_uid" : 0)));

        h = testAssertion("getgrgid()", \getgrgid(), (0,), new TestResultPartialHashMatch(("gr_gid" : 0)));
        testAssertion("getgrgid2()", \getgrgid2(), (0,), new TestResultPartialHashMatch(("gr_gid" : 0)));

        testAssertion("getgrnam()", \getgrnam(), (h.gr_name,), new TestResultPartialHashMatch(("gr_gid" : 0)));
        testAssertion("getgrnam2()", \getgrnam2(), (h.gr_name,), new TestResultPartialHashMatch(("gr_gid" : 0)));
    }

    # the functions that raise an exception for an unknown user or group raise their documented error codes
    pwdErrorCodeTest() {
        if (!Option::HAVE_UNIX_USERMGT) {
            testSkip("No support for UNIX user management");
        }

        # names and IDs that no system defines
        string user = "qore-no-such-user-" + getpid();
        string group = "qore-no-such-group-" + getpid();
        int id = 2147483000;
        assertNothing(getpwnam(user));
        assertNothing(getgrnam(group));
        assertNothing(getpwuid(id));
        assertNothing(getgrgid(id));

        # the description depends on whether the system reports an error for an unknown name
        assertThrows("GETPWNAM2-ERROR", \getpwnam2(), user);
        assertThrows("GETGRNAM2-ERROR", \getgrnam2(), group);
        assertThrows("GETPWUID2-ERROR", \getpwuid2(), id);
        assertThrows("GETGRGID2-ERROR", \getgrgid2(), id);
    }
}
