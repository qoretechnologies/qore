#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class RelativeDateRangeTest

#! The functions that make a relative date raise INVALID-DATE for a value out of its range in every mode (qore#6101)
/** years(), months(), days(), hours(), minutes(), seconds(), milliseconds() and microseconds() narrowed the 64-bit
    argument (or its whole hours) to the 32-bit component of the relative date, so a large value wrapped to another,
    often negative, duration.  The probes (relative-date-range/probes.q) run in each execution mode in a child
    process, with tiered execution at the IR tier and promoted to native code, and as qcc-compiled executables (-O0,
    -O3).
*/
class RelativeDateRangeTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");

        const Line = "INVALID-DATE,INVALID-DATE,INVALID-DATE,INVALID-DATE,INVALID-DATE,INVALID-DATE,INVALID-DATE,"
            "INVALID-DATE,INVALID-DATE,INVALID-DATE,INVALID-DATE,<time: 2147483647 hours 59 minutes 59 seconds>,"
            "<time: -2147483648 hours>,<time: 35791394 hours 9 minutes>,<time: 2147483647 hours>,"
            "<time: -2147483648 years>,<time: -1 seconds -500 milliseconds>,<time: 1500 microseconds>";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string expected;
    }

    constructor() : QUnit::Test("RelativeDateRange", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        for (int i = 0; i < 8; ++i) {
            expected += sprintf("%d: %s\n", i, Line);
        }

        addTestCase("relative dates out of range raise in every mode", \testModes());
        set_return_value(main());
    }

    testModes() {
        TmpDir tmp("qore-relative-date-range-");
        string file = tmp.path + DirSep + "prog.q";
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "relative-date-range" + DirSep
            + "probes.q")
            + "\nfor (int i = 0; i < 8; ++i) {\n    printf(\"%d: %s\\n\", i, probes());\n}\n");
        f.close();

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=5 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)), mode);
        }
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
            "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), "tiered, IR tier");
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 --jit-jit-threshold=1 "
            "%s 2>&1", env, qore_bin, file)), "tiered, promoted");
        foreach string opt in (("-O0", "-O3")) {
            string exe = file + opt;
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                file));
            assertTrue(is_file(exe), sprintf("qcc %s compiled the executable: %s", opt, out));
            assertEq(expected, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                libqore_dir, exe)), "qcc " + opt);
            assertEq(expected, backquote(sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=1 LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, libqore_dir, exe)), "qcc " + opt + ", JIT");
        }
    }
}
