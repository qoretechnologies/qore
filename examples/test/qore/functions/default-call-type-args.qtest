#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-platform: macos - AOT image loading of generic default values

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class DefaultCallTypeArgsTest

#! A default value's call with explicit type arguments keeps them in a qcc executable (qore#5964)
/** A default value that is a call of a function, a static method or a method of a constant without arguments was
    written to an AOT image as the name of the callee only, so the explicit type arguments of the call
    (inner<softint>()) or of the generic class (G<softint>::m()) were lost and the call used the callee's default
    type arguments.  Such a call is now written as an expression with its type arguments.
    The probes (default-call-type-args/probes.q) run in each execution mode in a child process, with tiered execution
    at the IR tier and promoted to native code, and as qcc-compiled executables (-O0, -O3), also with the code compiled
    to native code.
*/
class DefaultCallTypeArgsTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");

        const Line = "[8] [\"8\"] [8] [\"8\"] [9] [\"9\"] [9] [\"9\"] [5] [\"5\"] [7] [\"7\"]";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string expected;
    }

    constructor() : QUnit::Test("DefaultCallTypeArgs", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        for (int i = 0; i < 8; ++i) {
            expected += sprintf("%d: %s\n", i, Line);
        }

        addTestCase("default value calls keep their type arguments in every mode", \testModes());
        set_return_value(main());
    }

    testModes() {
        TmpDir tmp("qore-default-call-type-args-");
        string file = tmp.path + DirSep + "prog.q";
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "default-call-type-args" + DirSep
            + "probes.q") + "\nprint(probes());\n");
        f.close();

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=5 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)), mode);
        }
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
            "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), "tiered, IR tier");
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 --jit-jit-threshold=1 "
            "%s 2>&1", env, qore_bin, file)), "tiered, promoted");
        foreach string opt in (("-O0", "-O3")) {
            string exe = file + opt;
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                file));
            assertTrue(is_file(exe), sprintf("qcc %s compiled the executable: %s", opt, out));
            assertEq(expected, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                libqore_dir, exe)), "qcc " + opt);
            # with the closures compiled to native code
            assertEq(expected, backquote(sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=1 LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, libqore_dir, exe)), "qcc " + opt + ", JIT");
        }
    }
}
