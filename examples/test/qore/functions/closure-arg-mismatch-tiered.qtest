#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-platform: macos - JIT code generation and tiered promotion of inlined closure calls

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class ClosureArgMismatchTieredTest

#! A closure called with an argument that its signature does not accept raises RUNTIME-OVERLOAD-ERROR (qore#5864)
/** With tiered execution, a closure call inlined at the IR tier checked the arguments against the parameter types
    itself and raised RUNTIME-TYPE-ERROR, where the AST interpreter, the IR interpreter and the JIT raise
    RUNTIME-OVERLOAD-ERROR, as for a call of a function with the same signature.  The probes
    (closure-arg-mismatch-tiered/probes.q) run in each execution
    mode in a child process, with tiered execution at the IR tier and promoted to native code, and as qcc-compiled
    executables (-O0, -O3).
*/
class ClosureArgMismatchTieredTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");

        const Line = "13; "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(string)' can be found (3); "
            "\"1x\"; "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(integer, "
            "float)' can be found (3); "
            "45; "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(integer, integer, "
            "integer, integer, integer, integer, integer, integer, string)' can be found (3); "
            "1; "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(string)' can be found (3); "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(binary)' can be found (3); "
            "1; "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(reference<string>)' can "
            "be found (3); "
            "2; "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(binary)' can be found (3); "
            "3; "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(string, "
            "integer)' can be found (3); "
            "2; "
            "RUNTIME-OVERLOAD-ERROR no variant matching '<anonymous closure>(list<string>)' can be "
            "found (3); "
            "calls 7, count ";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string expected;
    }

    constructor() : QUnit::Test("ClosureArgMismatchTiered", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        for (int i = 0; i < 8; ++i) {
            expected += sprintf("%d: %s%d\n", i, Line, i + 1);
        }

        addTestCase("closure argument mismatches raise the same error in every mode", \testModes());
        set_return_value(main());
    }

    testModes() {
        TmpDir tmp("qore-closure-arg-mismatch-tiered-");
        string file = tmp.path + DirSep + "prog.q";
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "closure-arg-mismatch-tiered" + DirSep
            + "probes.q") + "\nprint(probes());\n");
        f.close();

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=5 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)), mode);
        }
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
            "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), "tiered, IR tier");
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 --jit-jit-threshold=1 "
            "%s 2>&1", env, qore_bin, file)), "tiered, promoted");
        foreach string opt in (("-O0", "-O3")) {
            string exe = file + opt;
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                file));
            assertTrue(is_file(exe), sprintf("qcc %s compiled the executable: %s", opt, out));
            assertEq(expected, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                libqore_dir, exe)), "qcc " + opt);
        }
    }
}
