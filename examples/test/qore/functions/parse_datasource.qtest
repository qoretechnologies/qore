#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

# assert tests with no return value
%disable-warning return-value-ignored

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class ParseDatasourceTest

public class ParseDatasourceTest inherits QUnit::Test {
    constructor() : Test("Parse_datasource test", "1.0") {
        addTestCase("Test 1", \test(), NOTHING);
        addTestCase("makeConfigString", \testMakeConfigString());
        addTestCase("make_datasource_string", \testMakeDatasourceString());
        addTestCase("round trip", \testRoundTrip());
        addTestCase("host and port", \portTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    test() {
        {
            hash<auto> dh = (
                "user"    : "user",
                "pass"    : "123pass@word",
                "db"      : "dbname",
                "charset" : "utf8",
                "host"    : "hostname",
            );
            string ds = "user/123pass@word@dbname(utf8)%hostname";

            assertEq(dh, parse_datasource(ds));
        }
        assertEq({
            "type": "sqlite3",
            "db": "/tmp/my-db.sqlite",
        }, parse_datasource("sqlite3:@/tmp/my-db.sqlite"));

        assertEq({
            "type": "sqlite3",
            "db": ":memory:",
        }, parse_datasource("sqlite3:@:memory:"));
        # a database name can have colons
        assertEq({
            "type": "test",
            "user": "a",
            "db": "b:x",
            "host": "c",
        }, parse_datasource("test:a@b:x%c"));
        assertEq({
            "user": "a",
            "db": "b",
            "host": "c",
            "port": 5,
            "options": {
                "abc@xyz:1234": "123",
            },
        }, parse_datasource("a@b%c:5{abc@xyz:1234=123}"));

        assertEq({
            "type": "d",
            "user": "a",
            "pass": "b",
            "db": "c",
            "charset": "utf8",
            "host": "localhost",
            "port": 5432,
        }, parse_datasource("d:a/b@c(utf8)%localhost:5432"));

        assertThrows("DATASOURCE-PARSE-ERROR", "empty text", sub() { parse_datasource(""); });
        assertThrows("DATASOURCE-PARSE-ERROR", "missing closing parenthesis", sub() { parse_datasource("a@b("); });
        assertThrows("DATASOURCE-PARSE-ERROR", "missing hostname", sub() { parse_datasource("a@b%"); });
        assertThrows("DATASOURCE-PARSE-ERROR", "missing hostname", sub() { parse_datasource("a@b%{}"); });
        assertThrows("DATASOURCE-PARSE-ERROR", "invalid characters present", sub() { parse_datasource("a@b%c:12x2"); });
    }

    #! the host ends at the first ":", which gives a port from 1 to 65535; an IPv6 address is in brackets (issue #6997)
    portTest() {
        assertEq({"type": "pgsql", "user": "u", "pass": "p", "db": "db", "host": "h", "port": 1},
            parse_datasource("pgsql:u/p@db%h:1"));
        assertEq({"type": "pgsql", "user": "u", "pass": "p", "db": "db", "host": "h", "port": 65535},
            parse_datasource("pgsql:u/p@db%h:65535"));
        assertEq({"type": "pgsql", "user": "u", "pass": "p", "db": "db", "host": "h"},
            parse_datasource("pgsql:u/p@db%h"));
        # an explicit port 0, a port larger than 65535, negative or not a number
        map assertThrows("DATASOURCE-PARSE-ERROR", "invalid port number", \parse_datasource(), $1), (
            "pgsql:u/p@db%h:0", "pgsql:u/p@db%h:00", "pgsql:u/p@db%h:65536", "pgsql:u/p@db%h:99999999999",
            "pgsql:u/p@db%h:", "pgsql:u/p@db%[::1]:", "pgsql:u/p@db%[::1]:0", "pgsql:u/p@db:0",
            "pgsql:u/p@db%h:0{min=1}",
        );
        map assertThrows("DATASOURCE-PARSE-ERROR", "invalid characters present in port number",
            \parse_datasource(), $1), (
            "pgsql:u/p@db%h:-1", "pgsql:u/p@db%h:abc", "pgsql:u/p@db%h:5x", "pgsql:u/p@db%h:x", "a@b%c:x",
            "a@b%c:x{abc@xyz:1234=123}", "pgsql:u/p@db%fe80::1:5432",
        );
        # an IPv6 address without brackets
        assertThrows("DATASOURCE-PARSE-ERROR", "missing hostname", \parse_datasource(), "pgsql:u/p@db%::1");
        assertThrows("DATASOURCE-PARSE-ERROR", "unrecognized characters", \parse_datasource(), "pgsql:u/p@db%[::1]x");
        # an IPv6 address in brackets
        assertEq({"type": "pgsql", "user": "u", "pass": "p", "db": "db", "host": "::1", "port": 5432},
            parse_datasource("pgsql:u/p@db%[::1]:5432"));
        assertEq({"type": "pgsql", "user": "u", "pass": "p", "db": "db", "host": "fe80::1"},
            parse_datasource("pgsql:u/p@db%[fe80::1]"));
        assertEq({"type": "pgsql", "db": "db", "host": "::1", "port": 5432, "options": {"min": "1"}},
            parse_datasource("pgsql:@db%[::1]:5432{min=1}"));
        assertThrows("DATASOURCE-PARSE-ERROR", "missing IPv6 address", \parse_datasource(), "pgsql:u/p@db%[::1");
        assertThrows("DATASOURCE-PARSE-ERROR", "missing IPv6 address", \parse_datasource(), "pgsql:u/p@db%[]:5");
        # an IPv6 host is given in brackets, which parses back to the same hash
        string str = make_datasource_string({"type": "pgsql", "db": "db", "host": "::1", "port": 5432});
        assertEq("pgsql:@db%[::1]:5432", str);
        assertEq({"type": "pgsql", "db": "db", "host": "::1", "port": 5432}, parse_datasource(str));
    }

    testMakeConfigString() {
        # full config with all fields
        assertEq("pgsql:user/pass@dbname(utf8)%hostname:5432{min=4,max=10}",
            Datasource::makeConfigString({
                "type": "pgsql",
                "user": "user",
                "pass": "pass",
                "db": "dbname",
                "charset": "utf8",
                "host": "hostname",
                "port": 5432,
                "options": {"min": "4", "max": "10"},
            }));

        # minimal config: type + db only
        assertEq("pgsql:@dbname", Datasource::makeConfigString({
            "type": "pgsql",
            "db": "dbname",
        }));

        # type only, no db
        assertEq("pgsql:@", Datasource::makeConfigString({
            "type": "pgsql",
        }));

        # without password (safe URL)
        assertEq("pgsql:user@dbname", Datasource::makeConfigString({
            "type": "pgsql",
            "user": "user",
            "db": "dbname",
        }));

        # sqlite3 file path
        assertEq("sqlite3:@/tmp/my-db.sqlite", Datasource::makeConfigString({
            "type": "sqlite3",
            "db": "/tmp/my-db.sqlite",
        }));

        # sqlite3 in-memory
        assertEq("sqlite3:@:memory:", Datasource::makeConfigString({
            "type": "sqlite3",
            "db": ":memory:",
        }));

        # boolean true option -> key only
        assertEq("pgsql:@db{opt1}", Datasource::makeConfigString({
            "type": "pgsql",
            "db": "db",
            "options": {"opt1": True},
        }));

        # boolean false option -> skipped
        assertEq("pgsql:@db", Datasource::makeConfigString({
            "type": "pgsql",
            "db": "db",
            "options": {"opt1": False},
        }));

        # NOTHING option -> skipped
        assertEq("pgsql:@db", Datasource::makeConfigString({
            "type": "pgsql",
            "db": "db",
            "options": {"opt1": NOTHING},
        }));

        # host without port
        assertEq("pgsql:@db%myhost", Datasource::makeConfigString({
            "type": "pgsql",
            "db": "db",
            "host": "myhost",
        }));

        # password with @ in it
        assertEq("pgsql:user/p@ss@dbname", Datasource::makeConfigString({
            "type": "pgsql",
            "user": "user",
            "pass": "p@ss",
            "db": "dbname",
        }));

        # multiple options with mixed types
        assertEq("pgsql:@db{opt1,opt2=val2}", Datasource::makeConfigString({
            "type": "pgsql",
            "db": "db",
            "options": {"opt1": True, "opt2": "val2"},
        }));

        # port without host -> port is silently dropped (parser expects %host:port)
        assertEq("pgsql:@db", Datasource::makeConfigString({
            "type": "pgsql",
            "db": "db",
            "port": 5432,
        }));

        # error: missing type key
        assertThrows("MAKE-DATASOURCE-STRING-ERROR", sub() {
            Datasource::makeConfigString({"db": "test"});
        });

        # error: empty type value
        assertThrows("MAKE-DATASOURCE-STRING-ERROR", sub() {
            Datasource::makeConfigString({"type": ""});
        });
    }

    testMakeDatasourceString() {
        # standalone function produces same result as static method
        hash<auto> config = {
            "type": "pgsql",
            "user": "user",
            "pass": "pass",
            "db": "dbname",
            "charset": "utf8",
            "host": "hostname",
            "port": 5432,
            "options": {"min": "4", "max": "10"},
        };
        assertEq(Datasource::makeConfigString(config), make_datasource_string(config));

        # minimal config
        config = {
            "type": "pgsql",
            "db": "dbname",
        };
        assertEq(Datasource::makeConfigString(config), make_datasource_string(config));

        # error case works the same
        assertThrows("MAKE-DATASOURCE-STRING-ERROR", sub() {
            make_datasource_string({"db": "test"});
        });
    }

    testRoundTrip() {
        # hash -> string -> hash: parse_datasource(make_datasource_string(h)) == h
        {
            hash<auto> h = {
                "type": "pgsql",
                "user": "user",
                "pass": "pass",
                "db": "dbname",
                "charset": "utf8",
                "host": "hostname",
                "port": 5432,
            };
            assertEq(h, parse_datasource(make_datasource_string(h)));
        }

        # minimal config round trip
        {
            hash<auto> h = {
                "type": "pgsql",
                "db": "dbname",
            };
            assertEq(h, parse_datasource(make_datasource_string(h)));
        }

        # sqlite3 file path round trip
        {
            hash<auto> h = {
                "type": "sqlite3",
                "db": "/tmp/my-db.sqlite",
            };
            assertEq(h, parse_datasource(make_datasource_string(h)));
        }

        # sqlite3 in-memory round trip
        {
            hash<auto> h = {
                "type": "sqlite3",
                "db": ":memory:",
            };
            assertEq(h, parse_datasource(make_datasource_string(h)));
        }

        # host + port round trip
        {
            hash<auto> h = {
                "type": "pgsql",
                "user": "user",
                "db": "db",
                "host": "host",
                "port": 5432,
            };
            assertEq(h, parse_datasource(make_datasource_string(h)));
        }

        # options round trip
        {
            hash<auto> h = {
                "type": "pgsql",
                "user": "user",
                "db": "db",
                "options": {"min": "4", "max": "10"},
            };
            assertEq(h, parse_datasource(make_datasource_string(h)));
        }

        # boolean true option round trip
        {
            hash<auto> h = {
                "type": "pgsql",
                "db": "db",
                "options": {"opt1": True},
            };
            # boolean True becomes key-only in string, which parse_datasource returns as True
            string s = make_datasource_string(h);
            assertEq("pgsql:@db{opt1}", s);
            hash<auto> parsed = parse_datasource(s);
            assertEq(True, parsed.options.opt1);
        }

        # string -> hash -> string: make_datasource_string(parse_datasource(s)) == s
        {
            string s = "pgsql:user/pass@dbname(utf8)%hostname:5432{min=4,max=10}";
            assertEq(s, make_datasource_string(parse_datasource(s)));
        }

        # minimal string round trip
        {
            string s = "pgsql:@dbname";
            assertEq(s, make_datasource_string(parse_datasource(s)));
        }

        # user + db string round trip
        {
            string s = "pgsql:user@dbname";
            assertEq(s, make_datasource_string(parse_datasource(s)));
        }

        # password with @ round trip
        {
            string s = "pgsql:user/p@ss@dbname";
            assertEq(s, make_datasource_string(parse_datasource(s)));
        }

        # host + port string round trip
        {
            string s = "pgsql:@db%myhost:1234";
            assertEq(s, make_datasource_string(parse_datasource(s)));
        }
    }
}
