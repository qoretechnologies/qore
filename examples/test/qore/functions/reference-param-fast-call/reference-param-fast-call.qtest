#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of calls with reference parameters and their fast call paths

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ReferenceParamFastCallTest

#! Tests calls of functions and methods with reference parameters (issue #7271)
/** ReferenceParamFastCall.q calls functions, methods, static methods and private methods with \c reference<T> and
    untyped \c reference parameters, given references to locals, hash keys, list elements, members and globals,
    through several call levels, with \c NOTHING, with values that the parameter's type rejects and converts, with
    writes that closures and other references see during the call and that an exception interrupts, with containers
    that the callee changes while the caller holds a copy, with weak references, through call references and named
    arguments bound at parse time and at run time, and across Program boundaries into a child and a sandboxed
    Program; its output must be the one in ReferenceParamFastCall.expected, which the AST interpreter prints, in every
    execution mode, on the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class ReferenceParamFastCallTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/ReferenceParamFastCall.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/ReferenceParamFastCall.expected");
    }

    constructor() : QUnit::Test("reference parameter fast calls", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/reference-param-fast-call";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
