#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/QUnit.qm

%exec-class GetByteSizeTest

public class GetByteSizeTest inherits QUnit::Test {
    constructor() : Test("GetByteSizeTest", "1.0") {
        addTestCase("Basic types", \testBasicTypes());
        addTestCase("Strings", \testStrings());
        addTestCase("Binary", \testBinary());
        addTestCase("Lists", \testLists());
        addTestCase("Hashes", \testHashes());
        addTestCase("Nested structures", \testNestedStructures());
        addTestCase("Object exception", \testObjectException());
        addTestCase("Edge cases", \testEdgeCases());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    testBasicTypes() {
        # NOTHING and NULL
        assertEq(0, get_value_byte_size(NOTHING), "NOTHING size");
        assertEq(0, get_value_byte_size(NULL), "NULL size");

        # Boolean
        assertEq(1, get_value_byte_size(True), "True size");
        assertEq(1, get_value_byte_size(False), "False size");

        # Integer
        assertEq(8, get_value_byte_size(0), "int 0 size");
        assertEq(8, get_value_byte_size(42), "int 42 size");
        assertEq(8, get_value_byte_size(-1), "int -1 size");
        assertEq(8, get_value_byte_size(9223372036854775807), "max int size");

        # Float
        assertEq(8, get_value_byte_size(0.0), "float 0.0 size");
        assertEq(8, get_value_byte_size(3.14159), "float pi size");
        assertEq(8, get_value_byte_size(-1.5), "float -1.5 size");

        # Date
        assertEq(64, get_value_byte_size(now()), "date size");
        assertEq(64, get_value_byte_size(2024-01-01), "date literal size");

        # Number (arbitrary precision)
        assertEq(32, get_value_byte_size(1.0n), "number size");
        assertEq(32, get_value_byte_size(123456789012345678901234567890n), "large number size");
    }

    testStrings() {
        assertEq(0, get_value_byte_size(""), "empty string size");
        assertEq(1, get_value_byte_size("a"), "single char size");
        assertEq(5, get_value_byte_size("hello"), "hello size");
        assertEq(11, get_value_byte_size("hello world"), "hello world size");

        # Unicode strings - size is in bytes, not characters
        string utf8 = "café";  # 5 bytes in UTF-8 (c, a, f, 0xC3, 0xA9)
        assertTrue(get_value_byte_size(utf8) >= 4, "UTF-8 string size >= char count");

        # Large string
        string large = strmul("x", 10000);
        assertEq(10000, get_value_byte_size(large), "10000 char string size");
    }

    testBinary() {
        assertEq(0, get_value_byte_size(binary()), "empty binary size");
        assertEq(5, get_value_byte_size(<68656c6c6f>), "5 byte binary size");  # "hello"
        assertEq(11, get_value_byte_size(<68656c6c6f776f726c6421>), "11 byte binary size");  # "helloworld!"

        # Binary from string
        binary b = "test".toBinary();
        assertEq(4, get_value_byte_size(b), "binary from string size");
    }

    testLists() {
        # Empty list
        assertEq(0, get_value_byte_size(()), "empty list size");

        # List of integers
        assertEq(24, get_value_byte_size((1, 2, 3)), "3 int list size");  # 3 * 8

        # List of strings
        assertEq(6, get_value_byte_size(("ab", "cd", "ef")), "3 string list size");  # 2 + 2 + 2

        # Mixed list
        int expected = 8 + 5 + 1;  # int + "hello" + True
        assertEq(expected, get_value_byte_size((42, "hello", True)), "mixed list size");

        # List with NOTHING
        assertEq(8, get_value_byte_size((NOTHING, 42)), "list with NOTHING size");
    }

    testHashes() {
        # Empty hash
        assertEq(0, get_value_byte_size({}), "empty hash size");

        # Hash with string key and int value
        int expected = 1 + 8;  # "a" (1 char) + int (8)
        assertEq(expected, get_value_byte_size({"a": 1}), "single key hash size");

        # Hash with multiple entries
        expected = 1 + 8 + 1 + 4;  # "a" + 1(int) + "b" + "test"
        assertEq(expected, get_value_byte_size({"a": 1, "b": "test"}), "two key hash size");

        # Hash with longer keys
        expected = 4 + 5;  # "name" + "David"
        assertEq(expected, get_value_byte_size({"name": "David"}), "longer key hash size");
    }

    testNestedStructures() {
        # Nested list
        list<auto> nested = ((1, 2), (3, 4));
        assertEq(32, get_value_byte_size(nested), "nested list size");  # 4 ints * 8

        # Nested hash
        hash<auto> h = {
            "outer": {
                "inner": "value"
            }
        };
        int expected = 5 + 5 + 5;  # "outer" + "inner" + "value"
        assertEq(expected, get_value_byte_size(h), "nested hash size");

        # Complex nested structure
        hash<auto> complex = {
            "list": (1, 2, 3),
            "hash": {"a": "b"},
            "str": "test"
        };
        # "list" (4) + 3 ints (24) + "hash" (4) + "a" (1) + "b" (1) + "str" (3) + "test" (4)
        expected = 4 + 24 + 4 + 1 + 1 + 3 + 4;
        assertEq(expected, get_value_byte_size(complex), "complex nested structure size");

        # Deeply nested
        hash<auto> deep = {"a": {"b": {"c": {"d": "e"}}}};
        expected = 1 + 1 + 1 + 1 + 1;  # all single char keys/values
        assertEq(expected, get_value_byte_size(deep), "deeply nested hash size");
    }

    testObjectException() {
        # Objects should throw an exception
        Mutex m();
        assertThrows("GET-VALUE-BYTE-SIZE-ERROR", \get_value_byte_size(), (m,), "object throws exception");

        # Object in a list should also throw
        list<auto> l = (1, m);
        assertThrows("GET-VALUE-BYTE-SIZE-ERROR", \get_value_byte_size(), (l,), "object in list throws exception");

        # Object in a hash should also throw
        hash<auto> h = {"obj": m};
        assertThrows("GET-VALUE-BYTE-SIZE-ERROR", \get_value_byte_size(), (h,), "object in hash throws exception");
    }

    testEdgeCases() {
        # Very large list
        list<int> large_list = ();
        for (int i = 0; i < 1000; i++) {
            large_list += i;
        }
        assertEq(8000, get_value_byte_size(large_list), "1000 int list size");

        # Hash with empty values
        hash<auto> h = {"a": "", "b": NOTHING, "c": binary()};
        assertEq(3, get_value_byte_size(h), "hash with empty values size");  # just the keys

        # Circular reference prevention - lists and hashes with self-references
        # Note: Qore doesn't allow circular references in simple data, so this just tests
        # that the function handles normal nested structures correctly

        # Very long key
        string long_key = strmul("k", 1000);
        hash<auto> long_key_hash = {};
        long_key_hash{long_key} = 1;
        assertEq(1000 + 8, get_value_byte_size(long_key_hash), "hash with 1000 char key");

        # List with nulls
        assertEq(0, get_value_byte_size((NULL, NULL, NULL)), "list of NULLs");

        # Mixed nullish values
        assertEq(0, get_value_byte_size((NOTHING, NULL, NOTHING)), "mixed nullish list");
    }
}
