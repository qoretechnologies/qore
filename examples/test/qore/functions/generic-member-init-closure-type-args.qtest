#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-platform: macos - AOT serialization of closure IR in member initializers and its JIT/qcc execution

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class GenericMemberInitClosureTypeArgsTest

#! The explicit type arguments of a call in a member initializer's closure are kept in qcc code (qore#5865)
/** qcc serializes a member initializer with the IR of its closures; the serialized call carried no explicit type
    arguments, so identity<T>(a) and identity<int>(a) in such a closure were called with type arguments inferred from
    the arguments.  The probes (generic-member-init-closure-type-args/probes.q) run in each execution
    mode in a child process, with tiered execution at the IR tier and promoted to native code, and as qcc-compiled
    executables (-O0, -O3).
*/
class GenericMemberInitClosureTypeArgsTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");

        const Line = "1 integer; RUNTIME-OVERLOAD-ERROR; \"s\" string; RUNTIME-OVERLOAD-ERROR; 2 integer; "
            "RUNTIME-OVERLOAD-ERROR; 3 integer; RUNTIME-OVERLOAD-ERROR; 4 integer; "
            "RUNTIME-OVERLOAD-ERROR; \"p\" string; RUNTIME-OVERLOAD-ERROR; 6 integer; "
            "RUNTIME-OVERLOAD-ERROR; 7 integer; RUNTIME-OVERLOAD-ERROR; 8 integer; "
            "RUNTIME-OVERLOAD-ERROR; \"q\" string; RUNTIME-OVERLOAD-ERROR; \"r\" string; "
            "RUNTIME-OVERLOAD-ERROR; \"u\" string; RUNTIME-OVERLOAD-ERROR; 12 integer; \"1334\" string";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string expected;
    }

    constructor() : QUnit::Test("GenericMemberInitClosureTypeArgs", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        for (int i = 0; i < 8; ++i) {
            expected += sprintf("%d: %s\n", i, Line);
        }

        addTestCase("member initializer closures keep explicit type arguments in every mode", \testModes());
        set_return_value(main());
    }

    testModes() {
        TmpDir tmp("qore-generic-member-init-closure-type-args-");
        string file = tmp.path + DirSep + "prog.q";
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "generic-member-init-closure-type-args" + DirSep
            + "probes.q") + "\nprint(probes());\n");
        f.close();

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=5 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)), mode);
        }
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
            "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), "tiered, IR tier");
        assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 --jit-jit-threshold=1 "
            "%s 2>&1", env, qore_bin, file)), "tiered, promoted");
        foreach string opt in (("-O0", "-O3")) {
            string exe = file + opt;
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                file));
            assertTrue(is_file(exe), sprintf("qcc %s compiled the executable: %s", opt, out));
            assertEq(expected, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                libqore_dir, exe)), "qcc " + opt);
            # with the closures compiled to native code: the JIT has the type arguments of a call read from
            # serialized IR too
            assertEq(expected, backquote(sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=1 LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, libqore_dir, exe)), "qcc " + opt + ", JIT");
        }
    }
}
