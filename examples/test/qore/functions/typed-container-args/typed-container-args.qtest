#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class TypedContainerArgsTest

#! Tests runtime variant selection for typed containers whose match depends on their elements
/** Where the match of a typed container depends on its elements (a nested container folded by its shape, a nested
    element type that may not match, a softlist parameter), the elements are checked, so a variant whose binding would
    fail is not selected; calls that bind select the same variant as before.  The checks are in
    typed-container-args-worker.qr, which is run in each execution mode and as a program compiled with qcc; every run
    must give the results below.
*/
class TypedContainerArgsTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "exact-int": "ex(list<int>):list<int>",
            "exact-string": "ex(list<string>):list<string>",
            "list-overload-int": "lo(list<int>):list<int>",
            "list-overload-string": "lo(list):list",
            "hash-overload-int": "ha(hash<string, int>):hash<string, int>",
            "softlist-typed-int": "sl(list<int>):list<int>",
            "softlist-typed-string": "sl(softlist<string>):list<string>",
            "softlist-convert": "ss(softlist<softstring>):list<softstring>",
            "softlist-scalar": "sa(softlist<string>):list<string>",
            "nested-fold": "nf(list<list<softint>>):list<list<softint>>:[[1]]",
            "nested-exact": "nb(list<list<int>>):list<list<int>>",
            "nested-hashdecl": "lf(list<hash<Leaf>>):list<hash<Leaf>>/hash<Leaf>",
            "nested-tie": "tie(list<list<softint>>):list<list<softint>>",
            "may-not-match-good": "na(list<list<int>>):list<list<int>>",
            "nested-empty": "nb(list<list<int>>):list<list<int>>",
            "nested-bad": "nb(auto):list<list<string>>",
            "nested-bad-single": "RUNTIME-OVERLOAD-ERROR",
            "nested-hash-bad": "hb(auto):hash<string, list<string>>",
            "softlist-bad": "RUNTIME-OVERLOAD-ERROR",
            "softlist-bad-auto": "sa(auto):list<float>",
            "softlist-bad-single": "RUNTIME-OVERLOAD-ERROR",
            "may-not-match-string": "na(list<list<string>>):list<list<string>>",
            "may-not-match-mixed": "na(auto):list<list<auto>>",
            "nested-hashdecl-bad": "HASHDECL-INIT-ERROR",
            "method-alternating": "m(list<list<int>>):list<list<int>>,"
                "m(auto):list<list<auto>>,"
                "m(list<list<int>>):list<list<int>>,"
                "m(auto):list<list<auto>>",
            "stable": "yes",
        };

        #! the execution modes that the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("TypedContainerArgsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    testCompiledProgram() {
        TmpDir tmp("qore-typed-container-args-");
        string exe = tmp.path + DirSep + "typed-container-args";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1", libqore_dir,
            qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "typed-container-args-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
