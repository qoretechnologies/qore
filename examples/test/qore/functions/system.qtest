#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - system() exit codes, SIGINT handling, process group kill and thread cancellation

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires FsUtil
%requires QUnit

%exec-class SystemCallTest

class SystemCallTest inherits QUnit::Test {
    constructor() : Test("SystemCallTest", "1.0") {
        addTestCase("system() test", \testMethod());
        addTestCase("system() exit code", \testExitCode());
        addTestCase("system() command not found", \testCommandNotFound());
        addTestCase("system() SIGINT handling", \testSignalHandling());
        addTestCase("system() interrupt kills process group", \testInterruptKillsProcessGroup());
        addTestCase("system() restricted access", \testRestrictedAccess());
        addTestCase("system() thread cancellation", \testThreadCancellation());

        # Return for compatibility with test harness that checks return value
        set_return_value(main());
    }

    testMethod() {
%ifdef Windows
        testSkip("Windows");
%endif
        # a directory of its own, so that concurrent runs of this test do not share the file
        TmpDir tmp("qore-system-");
        string file = tmp.path + DirSep + "output";

        testAssertion("system() call", \system(), "/bin/echo OUTPUT > " + file, 0);

        assertEq("OUTPUT", chomp(ReadOnlyFile::readTextFile(file)));
    }

    testExitCode() {
%ifdef Windows
        testSkip("Windows");
%endif
        int rc = system("exit 7");
        assertEq(7, rc, "system() should return the command exit code");
    }

    testCommandNotFound() {
%ifdef Windows
        testSkip("Windows");
%endif
        int rc = system("command_should_not_exist_12345 2>/dev/null");
        assertEq(127, rc, "system() should return 127 for command not found");
    }

    testSignalHandling() {
%ifdef Windows
        testSkip("Windows");
%endif
        int rc = system("trap 'exit 42' INT; kill -s INT $$; sleep 1; exit 0");
        assertEq(42, rc, "system() child should handle SIGINT");
    }

    #! interrupting the sandbox of a thread waiting in system() kills every process of the command
    /** The interrupt can arrive while the command's shell is starting a process: on macOS, a SIGKILL sent to the
        process group does not reach a process created at that moment, and system() sends it to the group again once
        the shell has ended; each command starts processes until it is killed, and several commands are interrupted,
        so that the interrupt arrives while the shell is starting a process.
    */
    testInterruptKillsProcessGroup() {
%ifdef Windows
        testSkip("Windows");
%endif
        for (int i = 1; i <= 5; ++i) {
            interruptCommand(i);
        }
    }

    #! runs a command in a sandboxed Program, interrupts the sandbox and checks that every process of the command ends
    /** The processes of the command hold the write end of a FIFO open, so that end-of-file on its read end shows that
        every one of them has exited.
    */
    private interruptCommand(int round) {
        # a directory of its own, so that concurrent runs of this test do not share the FIFO
        TmpDir tmp("qore-system-");
        string fifo = tmp.path + DirSep + "fifo";
        assertEq(0, mkfifo(fifo), sprintf("round %d: FIFO created", round));

        SandboxManager sm();
        sm.addFilesystemAllowedPath("/bin/sh", QSEC_EXECUTE);
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.setSandboxManager(sm);

        p.parse("
%modern

int sub run_system(string cmd) {
    return system(cmd);
}
        ", "system_interrupt_test");

        Counter done(1);
        *string ex_err;
        int rc = -999;

        # the shell opens the FIFO on descriptor 3, which every process that it starts inherits, and writes its PID,
        # which is the ID of its process group
        string cmd = sprintf("exec 3> %s; echo $$ >&3; i=0; while [ $i -lt 200 ]; do sleep 120 & i=$((i + 1)); "
            "done; wait", fifo);
        background sub () {
            on_exit done.dec();
            try {
                rc = p.callFunction("run_system", cmd);
            } catch (hash<ExceptionInfo> ex) {
                ex_err = ex.err;
            }
        }();

        # blocks until the shell has opened the FIFO
        ReadOnlyFile f(fifo);
        int pgid;
        # set when processes of the command are left running
        bool left_running = False;
        on_exit {
            # ends the command if the test fails before interrupting it
            if (done.getCount()) {
                sm.requestInterrupt();
            }
            done.waitForZero();
            # the processes left running hold the FIFO open, so the ID of their process group cannot have been reused
            if (left_running) {
                kill(-pgid, SIGKILL);
            }
        }

        pgid = int(f.readLine());
        assertGt(0, pgid, sprintf("round %d: process group ID read", round));

        sm.requestInterrupt();
        # a backstop only: the interrupt ends the wait at once
        assertEq(0, done.waitForZero(20s), sprintf("round %d: the interrupted wait ended", round));
        assertEq("PROGRAM-INTERRUPTED", ex_err, sprintf("round %d: system() raised PROGRAM-INTERRUPTED", round));
        assertEq(-999, rc, sprintf("round %d: system() returned no value", round));

        # end-of-file is read when every process holding the FIFO open has exited; the timeout is a hang guard, not
        # synchronization: the processes have been killed, and the read returns when the last one has exited
        try {
            while (f.readBinary(1, 60s)) {
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "FILE-READ-TIMEOUT") {
                rethrow;
            }
            left_running = True;
        }
        assertFalse(left_running, sprintf("round %d: every process of the command has exited", round));
    }

    testRestrictedAccess() {
%ifdef Windows
        testSkip("Windows");
%endif
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES | PO_NO_EXTERNAL_PROCESS);
        bool parse_caught = False;
        try {
            p.parse("
%modern

int sub run_system() {
    return system(\":\");
}
            ", "system_restricted");
        } catch (hash<ExceptionInfo> ex) {
            parse_caught = True;
            assertEq("PARSE-EXCEPTION", ex.err, "system() blocked by PO_NO_EXTERNAL_PROCESS");
        }
        assertTrue(parse_caught, "system() should be blocked by PO_NO_EXTERNAL_PROCESS");
    }

    #! a thread waiting in system() can be cancelled; the process is killed and reaped
    testThreadCancellation() {
%ifdef Windows
        testSkip("Windows");
%endif
        string fifo = sprintf("%s/system_fifo_%d_%d", tmp_location(), getpid(), gettid());
        assertEq(0, mkfifo(fifo));
        on_exit unlink(fifo);

        Counter done(1);
        *string err;
        int rc = -999;
        int tid = background sub () {
            on_exit done.dec();
            try {
                # the command reports its PID through the FIFO and then sleeps
                rc = system(sprintf("echo $$ > %s; exec sleep 60", fifo));
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
        }();

        # blocks until the command has written its PID
        int pid;
        {
            ReadOnlyFile f(fifo);
            pid = f.readLine().toInt();
        }
        assertGt(0, pid);
        on_exit {
            # ends the command if the wait was not interrupted, so that the thread ends
            if (done.getCount()) {
                kill(pid, SIGKILL);
                done.waitForZero();
            }
        }

        assertTrue(cancel_thread(tid, "test"));
        # a backstop only: the cancellation ends the wait at once
        assertEq(0, done.waitForZero(20s), "the cancelled wait ended");
        assertEq("THREAD-CANCELLED", err);
        assertEq(-999, rc);
        # the process has been killed and reaped before system() returned
        assertEq(-1, kill(pid, 0), "the process is gone");
    }
}
