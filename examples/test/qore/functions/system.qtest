#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - system() exit codes, SIGINT handling, process group kill and thread cancellation

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires FsUtil
%requires QUnit

%exec-class SystemCallTest

class SystemCallTest inherits QUnit::Test {
    #! a script that starts processes in a loop and writes the shell's PID to descriptor 3 after starting 20 of them
    const ShellLoop = "i=0; while [ $i -lt 200 ]; do sleep 120 & i=$((i + 1)); [ $i -eq 20 ] && echo $$ >&3; done; "
        "wait";
    #! a script that starts subshells, each of which starts subshells that start processes, and writes the shell's PID
    #! to descriptor 3 once it has started the first subshells
    /** The first subshells are starting subshells when the command is interrupted, and a subshell being started then
        goes on starting processes after the shell has ended.
    */
    const SubshellLoops = "j=0; while [ $j -lt 8 ]; do ( i=0; while [ $i -lt 8 ]; do ( k=0; while [ $k -lt 4 ]; do "
        "sleep 120 & k=$((k + 1)); done; wait ) & i=$((i + 1)); done; wait ) & j=$((j + 1)); done; echo $$ >&3; wait";

    constructor() : Test("SystemCallTest", "1.0") {
        addTestCase("system() test", \testMethod());
        addTestCase("system() exit code", \testExitCode());
        addTestCase("system() command not found", \testCommandNotFound());
        addTestCase("system() SIGINT handling", \testSignalHandling());
        addTestCase("system() interrupt kills process group", \testInterruptKillsProcessGroup());
        addTestCase("system() restricted access", \testRestrictedAccess());
        addTestCase("system() thread cancellation", \testThreadCancellation());

        # Return for compatibility with test harness that checks return value
        set_return_value(main());
    }

    testMethod() {
%ifdef Windows
        testSkip("Windows");
%endif
        # a directory of its own, so that concurrent runs of this test do not share the file
        TmpDir tmp("qore-system-");
        string file = tmp.path + DirSep + "output";

        testAssertion("system() call", \system(), "/bin/echo OUTPUT > " + file, 0);

        assertEq("OUTPUT", chomp(ReadOnlyFile::readTextFile(file)));
    }

    testExitCode() {
%ifdef Windows
        testSkip("Windows");
%endif
        int rc = system("exit 7");
        assertEq(7, rc, "system() should return the command exit code");
    }

    testCommandNotFound() {
%ifdef Windows
        testSkip("Windows");
%endif
        int rc = system("command_should_not_exist_12345 2>/dev/null");
        assertEq(127, rc, "system() should return 127 for command not found");
    }

    testSignalHandling() {
%ifdef Windows
        testSkip("Windows");
%endif
        int rc = system("trap 'exit 42' INT; kill -s INT $$; sleep 1; exit 0");
        assertEq(42, rc, "system() child should handle SIGINT");
    }

    #! interrupting the sandbox of a thread waiting in system() kills every process of the command
    /** The interrupt can arrive while a process of the command is starting a process: on macOS, a process being
        created when SIGKILL is sent to its process group does not receive it, and system() kills the group
        again each time processes in it end, until none is left but the command's shell.  The commands start
        processes in loops and write the shell's PID once some have been started, so that the interrupt arrives
        while processes are being started: by the shell, or by subshells, which go on starting processes after the
        shell has ended.
    */
    testInterruptKillsProcessGroup() {
%ifdef Windows
        testSkip("Windows");
%endif
        for (int i = 1; i <= 3; ++i) {
            interruptCommand(sprintf("round %d: the shell starts processes", i), ShellLoop);
        }
        for (int i = 1; i <= 8; ++i) {
            interruptCommand(sprintf("round %d: subshells start processes", i), SubshellLoops);
        }
    }

    #! runs a command in a sandboxed Program, interrupts the sandbox and checks that every process of the command ends
    /** The shell opens a FIFO on descriptor 3, which every process of the command inherits and holds open, so that
        end-of-file on its read end shows that every one of them has exited; the script writes the shell's PID, which
        is the ID of its process group, to the FIFO.
    */
    private interruptCommand(string label, string script) {
        # a directory of its own, so that concurrent runs of this test do not share the FIFO
        TmpDir tmp("qore-system-");
        string fifo = tmp.path + DirSep + "fifo";
        assertEq(0, mkfifo(fifo), label + ": FIFO created");

        SandboxManager sm();
        sm.addFilesystemAllowedPath("/bin/sh", QSEC_EXECUTE);
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.setSandboxManager(sm);

        p.parse("
%modern

int sub run_system(string cmd) {
    return system(cmd);
}
        ", "system_interrupt_test");

        Counter done(1);
        *string ex_err;
        int rc = -999;

        string cmd = sprintf("exec 3> %s; %s", fifo, script);
        background sub () {
            on_exit {
                # opens the FIFO and closes it at once: if the command failed before its shell opened the FIFO, this
                # ends the open() of its read end below; the open() returns at once otherwise, as the read end is open
                try {
                    File w();
                    w.open2(fifo, O_WRONLY);
                } catch (hash<ExceptionInfo> ex) {
                    stderr.printf("%s: cannot open the FIFO to write: %s\n", label, get_exception_string(ex));
                }
                done.dec();
            }
            try {
                rc = p.callFunction("run_system", cmd);
            } catch (hash<ExceptionInfo> ex) {
                ex_err = ex.err;
            }
        }();

        # blocks until the shell has opened the FIFO
        ReadOnlyFile f(fifo);
        int pgid;
        # set when processes of the command are left running
        bool left_running = False;
        on_exit {
            # ends the command if the test fails before interrupting it
            if (done.getCount()) {
                sm.requestInterrupt();
            }
            done.waitForZero();
            # the processes left running hold the FIFO open, so the ID of their process group cannot have been reused
            if (left_running) {
                kill(-pgid, SIGKILL);
            }
        }

        pgid = int(f.readLine());
        assertGt(0, pgid, label + ": process group ID read");

        sm.requestInterrupt();
        # a backstop only: the interrupt ends the wait at once
        assertEq(0, done.waitForZero(20s), label + ": the interrupted wait ended");
        assertEq("PROGRAM-INTERRUPTED", ex_err, label + ": system() raised PROGRAM-INTERRUPTED");
        assertEq(-999, rc, label + ": system() returned no value");

        # end-of-file is read when every process holding the FIFO open has exited; the timeout is a hang guard, not
        # synchronization: the processes have been killed, and the read returns when the last one has exited
        try {
            while (f.readBinary(1, 30s)) {
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "FILE-READ-TIMEOUT") {
                rethrow;
            }
            left_running = True;
        }
        assertFalse(left_running, label + ": every process of the command has exited");
    }

    testRestrictedAccess() {
%ifdef Windows
        testSkip("Windows");
%endif
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES | PO_NO_EXTERNAL_PROCESS);
        bool parse_caught = False;
        try {
            p.parse("
%modern

int sub run_system() {
    return system(\":\");
}
            ", "system_restricted");
        } catch (hash<ExceptionInfo> ex) {
            parse_caught = True;
            assertEq("PARSE-EXCEPTION", ex.err, "system() blocked by PO_NO_EXTERNAL_PROCESS");
        }
        assertTrue(parse_caught, "system() should be blocked by PO_NO_EXTERNAL_PROCESS");
    }

    #! a thread waiting in system() can be cancelled; the process is killed and reaped
    testThreadCancellation() {
%ifdef Windows
        testSkip("Windows");
%endif
        string fifo = sprintf("%s/system_fifo_%d_%d", tmp_location(), getpid(), gettid());
        assertEq(0, mkfifo(fifo));
        on_exit unlink(fifo);

        Counter done(1);
        *string err;
        int rc = -999;
        int tid = background sub () {
            on_exit done.dec();
            try {
                # the command reports its PID through the FIFO and then sleeps
                rc = system(sprintf("echo $$ > %s; exec sleep 60", fifo));
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
        }();

        # blocks until the command has written its PID
        int pid;
        {
            ReadOnlyFile f(fifo);
            pid = f.readLine().toInt();
        }
        assertGt(0, pid);
        on_exit {
            # ends the command if the wait was not interrupted, so that the thread ends
            if (done.getCount()) {
                kill(pid, SIGKILL);
                done.waitForZero();
            }
        }

        assertTrue(cancel_thread(tid, "test"));
        # a backstop only: the cancellation ends the wait at once
        assertEq(0, done.waitForZero(20s), "the cancelled wait ended");
        assertEq("THREAD-CANCELLED", err);
        assertEq(-999, rc);
        # the process has been killed and reaped before system() returned
        assertEq(-1, kill(pid, 0), "the process is gone");
    }
}
