#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class StringTest

public class StringTest inherits QUnit::Test {
    constructor() : Test("StringTest", "1.0") {
        addTestCase("null test", \nullTest());
        addTestCase("function tests", \functionTests());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    nullTest() {
        string str = "hi" + <00>.toString() + "there";
        str = convert_encoding(str, "ascii");

        assertEq(8, str.size());
        assertEq(0, ord(str[2]));
        assertEq("there", str[3..]);
        assertEq(0, ord(str[-6]));

        str = "hi" + <00>.toString() + "there";
        assertEq(8, str.size());
        assertEq(0, ord(str[2]));
        assertEq("there", str[3..]);
        assertEq(0, ord(str[-6]));

        str = reverse(str);
        assertEq("ereht", str[0..4]);
    }

    functionTests() {
        assertEq(1150200.55n, parse_number("1.150.200,55", ".,"));
        assertEq(1150200.55, parse_float("1.150.200,55", ".,"));
        assertEq(1150200, parse_int("1.150.200,55", ".,"));

        assertEq(1150200.55n, parse_number("1,150,200.55", ",."));
        assertEq(1150200.55, parse_float("1,150,200.55", ",."));
        assertEq(1150200, parse_int("1,150,200.55", ",."));

        assertEq(-4970.55n, parse_number("-4.970,55", ".,"));
        assertEq(-4970.55, parse_float("-4.970,55", ".,"));
        assertEq(-4970, parse_int("-4.970,55", ".,"));

        assertEq(-4970.55n, parse_number("-4,970.55", ",."));
        assertEq(-4970.55, parse_float("-4,970.55", ",."));
        assertEq(-4970, parse_int("-4,970.55", ",."));

        assertEq("asd", trunc_str("asdfäzxcv", 3));
        assertEq("asdf", trunc_str("asdfäzxcv", 4));
        assertEq("asdf", trunc_str("asdfäzxcv", 5));
        assertEq("asdfä", trunc_str("asdfäzxcv", 6));
        assertEq("asdfäz", trunc_str("asdfäzxcv", 7));
        assertEq("asdfäzx", trunc_str("asdfäzxcv", 8));
        # the whole string within the length, also with NUL bytes, which are kept (qore#6604)
        assertEq("asdfäzxcv", trunc_str("asdfäzxcv", 10));
        assertEq("asdfäzxcv", trunc_str("asdfäzxcv", 100));
        string nul = binary_to_string(<6100620063>, "UTF-8");
        assertEq(<6100620063>, binary(trunc_str(nul, 100)));
        assertEq(<610062>, binary(trunc_str(nul, 3)));
        string u16 = binary_to_string(<610062006300>, "UTF-16LE");
        assertEq(<610062006300>, binary(trunc_str(u16, 100)));
        assertEq(<61006200>, binary(trunc_str(u16, 5)));

        assertEq(195, ord("à"));
    }
}
