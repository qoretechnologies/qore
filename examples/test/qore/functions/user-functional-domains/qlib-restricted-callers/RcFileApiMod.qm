# -*- mode: qore; indent-tabs-mode: nil -*-
# RcFileApiMod.qm - test module whose initialization registers a file API (qore#6337)

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%requires DataProvider

module RcFileApiMod {
    version = "1.0";
    desc = "test module whose initialization registers a file API";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
    init = sub () {
        DataProviderActionCatalog::registerAppFileApi("QoreTestRcFileApiApp", <DataProviderFileApiInfo>{
            "read_action": "read-file",
            "read_path_option": "path",
            "read_data_field": "data",
        });
    };
    domains = "PROCESS";
}

#! The public definitions of the test module
public namespace RcFileApiMod {
}
