%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil

%include QlibAllModulesLoad.qc

%exec-class QlibAllModulesLoadPart2

#! runs part 2 of 2 of the cases of QlibAllModulesLoadBase: the first load without terminal I/O (#6438)
class QlibAllModulesLoadPart2 inherits QlibAllModulesLoadBase {
    constructor() : QlibAllModulesLoadBase("QlibAllModulesLoadPart2", 2) {
    }
}
