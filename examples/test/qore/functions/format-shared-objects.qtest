#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%exec-class SharedObjectFormatTest

class DisplayNode {
    public {
        string label;
        *DisplayNode left;
        *DisplayNode right;
    }

    constructor(string label, *DisplayNode left, *DisplayNode right) {
        self.label = label;
        self.left = left;
        self.right = right;
    }
}

class SharedObjectFormatTest inherits QUnit::Test {
    constructor() : QUnit::Test("shared object formatting", "1.0", \ARGV) {
        addTestCase("one expansion per object in a diamond", \diamond());
        addTestCase("deep graph and conversion scope", \deep());
        addTestCase("cycles and independent objects", \identity());
        set_return_value(main());
    }

    diamond() {
        DisplayNode leaf("one-leaf");
        DisplayNode root = leaf;
        for (int i = 0; i < 8; ++i) {
            root = new DisplayNode("branch", root, root);
        }
        foreach string spec in ("%n", "%N", "%y", "%Y") {
            string text = sprintf(spec, root);
            assertEq(1, text.split("one-leaf").size() - 1, spec);
            assertEq(8, text.split("branch").size() - 1, spec);
            # Leave room for class names, indentation and the reference markers.
            assertTrue(text.size() < 8192, spec);
        }
    }

    deep() {
        DisplayNode leaf("one-leaf");
        DisplayNode root = leaf;
        for (int i = 0; i < 64; ++i) {
            root = new DisplayNode("branch", root, leaf);
        }
        foreach string spec in ("%n", "%N", "%y", "%Y") {
            string text = sprintf(spec, root);
            assertEq(1, text.split("one-leaf").size() - 1, spec);
            assertEq(64, text.split("branch").size() - 1, spec);
            assertTrue(text.size() < 128 * 1024, spec);
        }
        # References through sibling hashes and lists use the enclosing conversion.
        auto siblings = ({"item": leaf}, {"items": (leaf,)});
        string text = sprintf("%y", siblings);
        assertEq(1, text.split("one-leaf").size() - 1);
        assertEq(text + "|" + text, sprintf("%y|%y", siblings, siblings));
    }

    identity() {
        DisplayNode a("same");
        DisplayNode b("same");
        assertEq(2, sprintf("%y", (a, b)).split("same").size() - 1);
        a.left = a;
        on_exit a.left = NOTHING;
        assertRegex("recursive reference to object", sprintf("%y", a));
    }
}
