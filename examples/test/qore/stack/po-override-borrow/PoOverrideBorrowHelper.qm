%modern

module PoOverrideBorrowHelper {
    version = "1.0";
    desc = "module code that calls back into the code of its caller";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! the namespace of the module
public namespace PoOverrideBorrowHelper {
#! calls a callback of the caller
public auto sub call_back(code c, auto arg) {
    return c(arg);
}

#! recurses in module code, then calls a callback of the caller; returns the callback's value plus the depth
public int sub module_recurse(code c, int n) {
    return n ? module_recurse(c, n - 1) + 1 : c();
}

#! calls callbacks of the caller from methods
public class ModuleCaller {
    #! calls a callback of the caller
    public auto callBack(code c, auto arg) {
        return c(arg);
    }

    #! calls a callback of the caller holding the gate of this object
    public synchronized auto callBackSynchronized(code c, auto arg) {
        return c(arg);
    }
}
}
