#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class StackGuardTest

public class StackGuardTest inherits QUnit::Test {
    public {
        const ThreadStackSize = 512 * 1024;
    }

    constructor() : Test("StackGuardTest", "1.0") {
        addTestCase("stack size", \testStackSize());
        addTestCase("Test overflowing the stack limit", \testInfiniteRecurse());
        addTestCase("Test two threads", \testRecurseWithBackground());
        addTestCase("Test a stack no larger than the guard", \testStackSizeTooSmall());
        addTestCase("Test a small stack", \testSmallStack());
        addTestCase("Test the primary thread of a process with a large environment",
            \testPrimaryThreadLargeEnvironment());

        set_return_value(main());
    }

    setUp() {
        if (!Option::HAVE_STACK_GUARD) {
            testSkip("Qore library was not built with stack protection support");
        }
    }

    testStackSize() {
        assertGt(ThreadStackSize, get_stack_size());
        Queue q();
        background sub () {
            try {
                assertGe(ThreadStackSize, get_stack_size());
                q.push();
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        }();
        *hash<ExceptionInfo> ex = q.get();
        if (ex) {
            throw ex.err, ex.desc, ex.arg;
        }
    }

    recurse() {
        recurse();
    }

    testInfiniteRecurse() {
        assertThrows("STACK-LIMIT-EXCEEDED", "this thread's stack has exceeded the stack size limit", \recurse());
    }

    testRecurseWithBackground() {
        Promise p();
        Future f = p.getFuture();
        background sub () {
            try {
                testInfiniteRecurse();
                p.set(NOTHING);
            } catch (hash<ExceptionInfo> ex) {
                p.set(ex);
            }
        }();
        testInfiniteRecurse();
        auto bg_result = f.get();
        if (bg_result instanceof hash<ExceptionInfo>) {
            throw bg_result.err, bg_result.desc, bg_result.arg;
        }
    }

    testStackSizeTooSmall() {
        # the stack guard reserves 80KB on these CPUs
        if (!inlist(Qore::PlatformCPU, ("x86_64", "arm64", "aarch64"))) {
            testSkip(sprintf("the stack guard size on %y is not known to this test", Qore::PlatformCPU));
        }
        int size = get_default_thread_stack_size();
        # a stack of 64KB is valid for threads, but no larger than the stack guard: no code could run on it
        assertThrows("SET-DEFAULT-THREAD-STACK-SIZE-ERROR", "stack guard", \set_default_thread_stack_size(), 64 * 1024);
        # the default is unchanged
        assertEq(size, get_default_thread_stack_size());
    }

    #! A stack overflow in the primary thread raises an exception, also when the environment is larger than the guard
    /** On Linux, the stack resource limit bounds the whole stack mapping, including the arguments and the environment
        above the top of the stack.  The stack limit was derived as if the stack itself could grow to the resource
        limit, so the limit lay beyond the real end of the stack by the size of the environment, and a process whose
        environment was larger than the stack guard crashed (SIGSEGV) instead of raising STACK-LIMIT-EXCEEDED.
    */
    testPrimaryThreadLargeEnvironment() {
        TmpDir dir("qore-primary-stack-env-");
        string script = dir.path + "/recurse.q";
        File f();
        f.open2(script, O_CREAT | O_WRONLY | O_TRUNC);
        f.write("%new-style\nint sub recurse(int n) { return recurse(n + 1) + 1; }\n"
            "try { recurse(0); } catch (hash<ExceptionInfo> ex) { print(ex.err); }\n");
        f.close();
        string qore = ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0];
        # six variables of 100 KB each (no single environment string can be larger than 128 KB on Linux): 600 KB,
        # far more than the 144 KB guard of the primary thread, and within the space for the arguments and the
        # environment (2 MB with an 8 MB stack resource limit on Linux, 1 MB on macOS)
        string vars = (map sprintf("QORE_TEST_PAD_%d=\"$(printf '%%102400s' '')\"", $1), xrange(6)).join(" ");
        int rc;
        string output = backquote(sprintf("env %s %s %s 2>&1", vars, qore, script), \rc);
        assertEq(0, rc, output);
        assertEq("STACK-LIMIT-EXCEEDED", output);
    }

    testSmallStack() {
        int size = get_default_thread_stack_size();
        on_exit set_default_thread_stack_size(size);
        set_default_thread_stack_size(160 * 1024);
        Queue q();
        background sub () {
            try {
                recurse();
                q.push("no exception");
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        }();
        auto rv = q.get();
        assertEq("STACK-LIMIT-EXCEEDED", rv.err);
        # the limit reported is the part of the stack not reserved for the guard
        *string limit = (rv.desc =~ x/\(([0-9]+) bytes\)/)[0];
        assertGt(0, int(limit));
        assertLt(160 * 1024, int(limit));
    }
}
