%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class RecursionFrameBudgetTest

/*  The stack that one level of a recursion of interpreted code uses (issue #5852).

    Each level of a recursion of a function or method puts the frames of the whole call path on the thread's stack
    (for IR execution: the IR interpreter, the call helpers, the variant's evaluation); a deep recursion on Alpine
    (musl, 8 MB thread stacks) runs out of stack first, and any growth of a frame on that path costs its size at every
    level.  This test measures the bytes per level of a recursion of a function, a method and a static method in the
    AST and IR execution modes, and fails when it exceeds the budget of the build.

    The bytes per level are measured as a difference: the recursion runs until STACK-LIMIT-EXCEEDED in a thread with
    a 4 MB stack and in one with an 8 MB stack, so (8 MB - 4 MB) / (depth8 - depth4) is the stack of one level, free
    of the stack guard, of the thread's start and of the frames below the recursion.  What remains depends on the
    compiler, its optimization level and the C library's headers (in a release build, the frame of the IR
    interpreter is about 2.4 KB larger with musl than with glibc, with the same GCC version): the budgets are for
    GCC on x86_64 Linux with glibc (Ubuntu) and with musl (Alpine), each with a release build (-O3) and a debug
    build (-Og, as CI builds Qore).  They are 5-7% over the measured values, but never more than 400 bytes, so that
    a frame of 528 bytes more at each level (an array in a frame of the IR interpreter, as 13281fbbd7 added) fails
    here.  On any other compiler, CPU, C library or flag set (see getCalibrationMismatch()) the values are reported
    but not checked, as they are in sanitizer builds, whose stack redzones make every frame larger.

    tools/check-stack-usage.py checks the frames of the same path, function by function, in a release build made with
    -DQORE_STACK_USAGE_REPORT=ON; this test checks their sum as the recursion uses it, in the build being tested.
*/

public class RecursionFrameBudgetTest inherits QUnit::Test {
    public {
        #! the code of the recursions; each records its depth in maxdepth before it recurses
        const Code = "%modern
our int maxdepth;
int sub frec(int n) { maxdepth = n; return frec(n + 1); }
public class C {
    public int m(int n) { maxdepth = n; return m(n + 1); }
    public static int s(int n) { maxdepth = n; return C::s(n + 1); }
}
int sub method_rec(int n) { C c(); return c.m(n); }
int sub static_rec(int n) { return C::s(n); }
# returns the depth that the recursion reached when it ran out of stack
int sub run(string f) {
    maxdepth = 0;
    try {
        call_function(f, 0);
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != \"STACK-LIMIT-EXCEEDED\") {
            rethrow;
        }
    }
    return maxdepth;
}
";

        #! the recursions measured: the function that the recursion runs in the Program -> the label
        const Recursions = {
            "frec": "function",
            "method_rec": "method",
            "static_rec": "static method",
        };

        #! the execution modes measured
        const Modes = {
            "ast": EM_AST,
            "ir": EM_IR,
        };

        #! the GCC major version that the budgets are calibrated for
        const CalibratedGccMajor = "15";

        #! the flags of the build types that the budgets are calibrated for (see Qore's CMakeLists.txt)
        const CalibratedBuildTypeFlags = {
            "release": "-O3 -DNDEBUG",
            "debug": "-g -Og",
        };

        #! the only compiler flags (CFLAGS) besides those of the build type that the budgets are calibrated for
        const CalibratedCFlags = ("-fno-strict-aliasing", "-std=c++20");

        #! the targets that the budgets are calibrated for: target triple -> C library and the hardening options that
        #! the distribution's GCC enables by default (Ubuntu and Alpine, the images of CI)
        const CalibratedTargets = {
            "x86_64-linux-gnu": {
                "libc": "glibc",
                "hardening": {"stack_protector": 2, "fortify_source": 3, "cet": 3, "glibcxx_assertions": False},
            },
            "x86_64-alpine-linux-musl": {
                "libc": "musl",
                "hardening": {"stack_protector": 2, "fortify_source": 2, "cet": 0, "glibcxx_assertions": False},
            },
        };

        #! the two stack sizes of the measurement
        const SmallStack = 4 * 1024 * 1024;
        const LargeStack = 8 * 1024 * 1024;

        #! the budgets in bytes per level: C library and build type -> execution mode -> recursion
        /** measured with GCC 15.2 on x86_64; see the comment at the top
        */
        const Budgets = {
            # measured: ast 2783, 2590, 2641; ir 4355, 5489, 4396
            "glibc release": {
                "ast": {"function": 2980, "method": 2780, "static method": 2830},
                "ir": {"function": 4650, "method": 5850, "static method": 4700},
            },
            # measured: ast 2766, 2702, 2624; ir 4369, 5857, 4369
            "glibc debug": {
                "ast": {"function": 2960, "method": 2890, "static method": 2810},
                "ir": {"function": 4670, "method": 6250, "static method": 4670},
            },
            # measured: ast 2783, 2592, 2639; ir 6765, 7928, 6820
            "musl release": {
                "ast": {"function": 2980, "method": 2780, "static method": 2830},
                "ir": {"function": 7165, "method": 8328, "static method": 7220},
            },
            # measured: ast 2766, 2704, 2623; ir 4369, 5857, 4369
            "musl debug": {
                "ast": {"function": 2960, "method": 2890, "static method": 2810},
                "ir": {"function": 4670, "method": 6250, "static method": 4670},
            },
        };
    }

    constructor() : Test("RecursionFrameBudgetTest", "1.0") {
        addTestCase("bytes per level of a recursion of interpreted code", \testBytesPerLevel());
        addTestCase("measurement", \testMeasurement());
        addTestCase("calibration of the budgets", \testCalibration());
        set_return_value(main());
    }

    setUp() {
        if (!Option::HAVE_STACK_GUARD) {
            testSkip("Qore library was not built with stack protection support");
        }
        if (!Option::HAVE_MANAGE_STACK) {
            testSkip("this platform cannot set the stack size of new threads");
        }
    }

    #! returns the budgets of a library with the given build information: "<C library> <build type>"
    static string getBudgetKey(hash<auto> info, bool library_debugging) {
        return sprintf("%s %s", CalibratedTargets{info.Target}.libc ?? "unknown libc",
            library_debugging ? "debug" : "release");
    }

    #! returns why the budgets do not apply to a library with the given build information, or nothing if they do
    /** @param info the build information of the library, as get_qore_library_info() returns it
        @param library_debugging if the library was built with debugging (Qore::Option::HAVE_LIBRARY_DEBUGGING)

        The budgets are calibrated for one compiler and flag set: GCC 15 on x86_64 Linux with glibc (Ubuntu) or musl
        (Alpine) and the hardening options of the distribution's GCC, a single compilation unit, no link-time
        optimization, no flags beyond the defaults, and the release (-O3 -DNDEBUG) or debug (-g -Og) flags of Qore's
        CMake build; frames differ with another GCC version or distribution, another optimization level (a
        distribution's -O2 build, a debug build made without -Og), link-time optimization or other hardening flags, so
        such a build is not checked
    */
    static *string getCalibrationMismatch(hash<auto> info, bool library_debugging) {
        if (info.Compiler != "GNU") {
            return sprintf("the budgets are for GCC, and this library was built with %y", info.Compiler);
        }
        foreach string key in (("CompilerVersion", "BuildType", "BuildTypeCFLAGS", "SingleCompilationUnit", "Target",
            "InterproceduralOptimization", "Hardening")) {
            if (!exists info{key}) {
                return sprintf("this library does not report how it was built (%y)", key);
            }
        }
        if ((info.CompilerVersion =~ x/^([0-9]+)/)[0] != CalibratedGccMajor) {
            return sprintf("the budgets are for GCC %s, and this library was built with GCC %s", CalibratedGccMajor,
                info.CompilerVersion);
        }
        if (info.PlatformCPU != "x86_64" || info.PlatformOS != "Linux") {
            return sprintf("the budgets are for x86_64 Linux, and this is %s %s", info.PlatformCPU, info.PlatformOS);
        }
        *hash<auto> target = CalibratedTargets{info.Target};
        if (!target) {
            return sprintf("the budgets are for the targets %y, and this library was built for %y",
                keys CalibratedTargets, info.Target);
        }
        if (info.Hardening != target.hardening) {
            return sprintf("the budgets are for the hardening options %y of %s, and this library was built with %y",
                target.hardening, info.Target, info.Hardening);
        }
        if (!info.SingleCompilationUnit) {
            return "the budgets are for a library built as a single compilation unit, as CI builds it";
        }
        if (info.InterproceduralOptimization) {
            return "the budgets are for a library built without link-time optimization";
        }
        string build_type = library_debugging ? "debug" : "release";
        if (info.BuildType.lwr() != build_type) {
            return sprintf("the budgets are for the release and debug build types, and this library was built with "
                "%y", info.BuildType);
        }
        string type_flags = CalibratedBuildTypeFlags{build_type};
        if (info.BuildTypeCFLAGS != type_flags) {
            return sprintf("the budgets are for a %s build with %y, and this library was built with %y", build_type,
                type_flags, info.BuildTypeCFLAGS);
        }
        list<string> extra = select info.CFLAGS.split(" "), $1 && !inlist($1, CalibratedCFlags);
        if (extra) {
            return sprintf("the budgets are for a library built with no compiler flags beyond %y, and this library "
                "was also built with %y", CalibratedCFlags, extra);
        }
    }

    #! returns why the budgets do not apply to the library, or nothing if they do
    /** @param info the build information of the library, as get_qore_library_info() returns it
        @param library_debugging if the library was built with debugging (Qore::Option::HAVE_LIBRARY_DEBUGGING)
        @param maps the memory map of the process (/proc/self/maps), if it can be read
    */
    static *string getUncalibratedReason(hash<auto> info, bool library_debugging, *string maps) {
        *string reason = getCalibrationMismatch(info, library_debugging);
        if (reason) {
            return reason;
        }
        # a sanitizer's runtime is loaded into a sanitizer build, whose frames have redzones
        *list<string> sanitizer = maps ? (maps =~ x/(lib[a-z]*san)\b/) : NOTHING;
        if (sanitizer) {
            return sprintf("a sanitizer runtime (%s) is loaded, and its stack redzones make frames larger",
                sanitizer[0]);
        }
        return getMeasurementProblem(maps);
    }

    #! returns why the depth of a recursion does not measure the stack in this process, or nothing if it does
    /** Valgrind manages the stacks of the threads itself and can give a new thread the stack of a thread that has
        ended, of another size, so the depths that this test measures do not follow the stack size that it asks for
    */
    static *string getMeasurementProblem(*string maps) {
        if (maps =~ /vgpreload_/) {
            return "the process runs under valgrind, which can give a thread the stack of another thread";
        }
    }

    #! returns the memory map of the process, or nothing if it cannot be read
    static *string getMaps() {
        if (is_readable("/proc/self/maps")) {
            return File::readTextFile("/proc/self/maps");
        }
    }

    #! returns the depth that a recursion reaches before it runs out of stack in a thread with the given stack size
    int getDepth(Program pgm, string func, int stack_size) {
        int old_size = get_default_thread_stack_size();
        on_exit set_default_thread_stack_size(old_size);
        set_default_thread_stack_size(stack_size);
        Queue q();
        background sub () {
            try {
                q.push(pgm.callFunction("run", func));
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        }();
        auto rv = q.get();
        if (rv instanceof hash<ExceptionInfo>) {
            throw rv.err, rv.desc, rv.arg;
        }
        return rv;
    }

    #! measures the recursions in an execution mode: recursion label -> {"small": depth, "large": depth, "bpl": bytes}
    hash<string, hash<auto>> measure(ExecMode mode) {
        Program pgm(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES | PO_STRONG_ENCAPSULATION);
        pgm.setExecMode(mode);
        pgm.parse(Code, "recursion-frame-budget");
        pgm.run();
        hash<string, hash<auto>> rv = {};
        foreach hash<auto> i in (Recursions.pairIterator()) {
            int small = getDepth(pgm, i.key, SmallStack);
            int large = getDepth(pgm, i.key, LargeStack);
            assertGt(small, large, sprintf("%s: depth with %d bytes > depth with %d bytes", i.value, LargeStack,
                SmallStack));
            int bpl = large > small ? (LargeStack - SmallStack) / (large - small) : 0;
            rv{i.value} = {"small": small, "large": large, "bpl": bpl};
        }
        return rv;
    }

    testBytesPerLevel() {
        hash<auto> info = get_qore_library_info();
        *string reason = getUncalibratedReason(info, Option::HAVE_LIBRARY_DEBUGGING, getMaps());
        string build_type = getBudgetKey(info, Option::HAVE_LIBRARY_DEBUGGING);
        # every recursion is measured before the check, so that a failure reports all of them
        list<string> over = ();
        foreach hash<auto> m in (Modes.pairIterator()) {
            hash<string, hash<auto>> r = measure(m.value);
            foreach hash<auto> i in (r.pairIterator()) {
                int budget = Budgets{build_type}{m.key}{i.key} ?? 0;
                string msg = sprintf("%s %s recursion, %s build: %d bytes per level (budget %d; depth %d with a "
                    "%d MB stack)", m.key, i.key, build_type, i.value.bpl, budget, i.value.large,
                    LargeStack / 1024 / 1024);
                if (m_options.verbose || reason) {
                    printf("%s\n", msg);
                }
                if (!reason && i.value.bpl > budget) {
                    over += msg;
                }
            }
        }
        if (reason) {
            testSkip("the bytes per level are reported, not checked: " + reason);
        }
        # a frame on the call path grew: see tools/stack-usage-budgets.txt for the frames and what to do
        assertEq((), over, "recursions over their budget of bytes per level");
    }

    #! the budgets are checked only for a build like the one they are calibrated for
    testCalibration() {
        hash<auto> release = {
            "Compiler": "GNU",
            "CompilerVersion": "15.2.0",
            "PlatformCPU": "x86_64",
            "PlatformOS": "Linux",
            "SingleCompilationUnit": True,
            "BuildType": "Release",
            "BuildTypeCFLAGS": "-O3 -DNDEBUG",
            "CFLAGS": "-fno-strict-aliasing -std=c++20",
            "Target": "x86_64-linux-gnu",
            "InterproceduralOptimization": False,
            "Hardening": {"stack_protector": 2, "fortify_source": 3, "cet": 3, "glibcxx_assertions": False},
        };
        hash<auto> debug = release + {"BuildType": "debug", "BuildTypeCFLAGS": "-g -Og"};
        hash<auto> musl = release + {
            "Target": "x86_64-alpine-linux-musl",
            "Hardening": {"stack_protector": 2, "fortify_source": 2, "cet": 0, "glibcxx_assertions": False},
        };
        assertNothing(getCalibrationMismatch(release, False));
        assertNothing(getCalibrationMismatch(debug, True));
        assertNothing(getCalibrationMismatch(musl, False));
        assertEq("glibc release", getBudgetKey(release, False));
        assertEq("glibc debug", getBudgetKey(debug, True));
        assertEq("musl release", getBudgetKey(musl, False));

        # each difference from the calibrated builds: the build information -> library debugging -> the reason
        list<list<auto>> cases = (
            (release + {"Compiler": "Clang"}, False, "built with \"Clang\""),
            (release - "CompilerVersion", False, "does not report"),
            (release + {"CompilerVersion": "14.2.0"}, False, "GCC 15, and this library was built with GCC 14.2.0"),
            (release + {"CompilerVersion": "16.1.0"}, False, "GCC 16.1.0"),
            (release + {"PlatformCPU": "aarch64"}, False, "aarch64 Linux"),
            (release + {"SingleCompilationUnit": False}, False, "single compilation unit"),
            # a distribution build: build type "None" with its own flags in CFLAGS
            (release + {"BuildType": "None", "BuildTypeCFLAGS": "",
                "CFLAGS": "-g -O2 -fstack-protector-strong -fno-strict-aliasing -std=c++20"}, False, "\"None\""),
            (release + {"BuildType": "RelWithDebInfo", "BuildTypeCFLAGS": "-O2 -g -DNDEBUG"}, False,
                "\"RelWithDebInfo\""),
            # a debug build made without -Og (QORE_OPTIMIZE_DEBUG_BUILDS=OFF) is -O0
            (debug + {"BuildTypeCFLAGS": "-g"}, True, "built with \"-g\""),
            # a debug library with release flags, or the reverse
            (debug, False, "\"debug\""),
            (release, True, "\"Release\""),
            (release + {"CFLAGS": "-fno-strict-aliasing -std=c++20 -flto"}, False, "also built with [\"-flto\"]"),
            (release + {"CFLAGS": "-O2 -fno-strict-aliasing -std=c++20"}, False, "also built with [\"-O2\"]"),
            # a multi-config generator reports no build type: the configuration is chosen when the library is built
            (release + {"BuildType": "multi-config", "BuildTypeCFLAGS": ""}, False, "\"multi-config\""),
            (release + {"Target": "aarch64-linux-gnu"}, False, "built for \"aarch64-linux-gnu\""),
            (release + {"InterproceduralOptimization": True}, False, "link-time optimization"),
            # another distribution's GCC with other hardening defaults
            (release + {"Hardening": release.Hardening + {"cet": 0}}, False, "hardening options"),
            (release + {"Hardening": release.Hardening + {"glibcxx_assertions": True}}, False, "hardening options"),
            (musl + {"Hardening": release.Hardening}, False, "hardening options"),
            (release - "Hardening", False, "does not report how it was built (\"Hardening\")"),
        );
        foreach list<auto> c in (cases) {
            *string reason = getCalibrationMismatch(c[0], c[1]);
            assertEq(True, reason.typeCode() == NT_STRING && reason.find(c[2]) >= 0,
                sprintf("case %d: %y contains %y", $#, reason, c[2]));
            # the check that decides whether the budgets are enforced finds the same reason
            assertEq(reason, getUncalibratedReason(c[0], c[1], ""), sprintf("case %d", $#));
        }

        # a calibrated build is checked unless a sanitizer runtime is loaded or the process runs under valgrind
        *string reason = getUncalibratedReason(release, False,
            "4000-4001 r-xp 0 08:01 1 /usr/libexec/valgrind/vgpreload_memcheck-amd64-linux.so\n");
        assertEq(True, reason.typeCode() == NT_STRING && reason.find("valgrind") >= 0, reason);
        assertNothing(getUncalibratedReason(release, False, "7f00-7f01 r-xp 0 08:01 1 /usr/lib/libc.so.6\n"));
        assertNothing(getUncalibratedReason(release, False, NOTHING));
        reason = getUncalibratedReason(release, False,
            "7f00-7f01 r-xp 0 08:01 1 /usr/lib/x86_64-linux-gnu/libasan.so.8.0.0\n");
        assertEq(True, reason.typeCode() == NT_STRING && reason.find("sanitizer runtime (libasan)") >= 0, reason);
    }

    #! the measurement itself: each recursion runs out of stack at a depth that grows with the stack
    testMeasurement() {
        *string problem = getMeasurementProblem(getMaps());
        if (problem) {
            testSkip(problem);
        }
        Program pgm(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES | PO_STRONG_ENCAPSULATION);
        pgm.setExecMode(EM_IR);
        pgm.parse(Code, "recursion-frame-budget");
        pgm.run();
        int d1 = getDepth(pgm, "frec", 1024 * 1024);
        int d2 = getDepth(pgm, "frec", 2 * 1024 * 1024);
        # a level uses at least a few hundred bytes and no more than 64 KB in any build
        assertGt(16, d1);
        assertLt(1024 * 1024 / 256, d1);
        # twice the stack holds about twice the levels: the part below the recursion is a fraction of a megabyte
        assertGt(d1 * 3 / 2, d2);
        assertLt(d1 * 5 / 2, d2);
        # an error other than running out of stack is not taken for the end of the recursion
        assertThrows("NO-FUNCTION", \pgm.callFunction(), ("run", "frec_missing"));
    }
}
