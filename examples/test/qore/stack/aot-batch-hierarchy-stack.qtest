#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - AOT code generation, linking and loading with a small main thread stack (ulimit -s)

/*  Copyright 2026 Qore Technologies, s.r.o.

