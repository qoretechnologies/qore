%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class ClassChainConstructionStackTest

#! Constructing an object of a deep hierarchy of classes without constructors checks the stack at each level
/** The constructors of the base classes of a class without a constructor are run by a native recursion with one level
    per class of the hierarchy, whose depth the parser accepts whatever the stack of the thread that constructs an
    object; each level checks the stack, so that the construction succeeds or raises \c STACK-LIMIT-EXCEEDED in every
    thread, and never overruns the thread's stack.  The objects are constructed in threads with stack sizes from 128KB
    to 8MB.

    Only the construction runs in the threads: the object is checked in the main thread.  An object of the hierarchy
    is constructed in the main thread first, as the first construction of an object of a class walks its hierarchy
    once to cache what it finds.
*/
class ClassChainConstructionStackTest inherits QUnit::Test {
    public {
        #! the number of classes in the hierarchy
        const Depth = 3000;

        #! the smallest stack size of the threads in KB
        const MinStackKb = 128;

        #! the largest stack size of the threads in KB
        const MaxStackKb = 8192;
    }

    constructor() : QUnit::Test("ClassChainConstructionStackTest", "1.0") {
        addTestCase("a hierarchy of classes without constructors", \chainTest());
        set_return_value(main());
    }

    setUp() {
        if (!Option::HAVE_STACK_GUARD) {
            testSkip("Qore library was not built with stack protection support");
        }
    }

    #! returns the source of a hierarchy of Depth classes without constructors and a function that constructs its most
    #! derived class
    private static string getSource() {
        string code = "class C0 { public { int v = 1; } int depth() { return 0; } }\n";
        for (int i = 1; i < Depth; ++i) {
            code += sprintf("class C%d inherits C%d { int depth() { return %d; } }\n", i, i - 1, i);
        }
        code += sprintf("auto sub make() { return new C%d(); }\n", Depth - 1);
        return code;
    }

    private chainTest() {
        Program pgm(PO_NEW_STYLE | PO_REQUIRE_TYPES);
        pgm.parse(getSource(), "class-chain");
        checkObject(pgm.callFunction("make"), "main thread");

        int old_size = get_default_thread_stack_size();
        on_exit set_default_thread_stack_size(old_size);

        hash<string, int> results;
        for (int kb = MinStackKb; kb <= MaxStackKb; kb *= 2) {
            set_default_thread_stack_size(kb * 1024);
            Queue q();
            background sub () {
                try {
                    q.push(pgm.callFunction("make"));
                } catch (hash<ExceptionInfo> ex) {
                    q.push(ex.err);
                }
            }();
            auto result = q.get();
            string label = sprintf("%dK", kb);
            if (result.typeCode() == NT_STRING) {
                assertEq("STACK-LIMIT-EXCEEDED", result, label);
                ++results.stack;
            } else {
                checkObject(result, label);
                ++results.constructed;
            }
        }
        # the smallest stack is too small for the hierarchy and the largest is large enough
        assertGt(0, results.stack, "construction runs short of a small stack");
        assertGt(0, results.constructed, "construction succeeds with a large stack");
    }

    #! checks an object of the most derived class of a hierarchy
    private checkObject(auto obj, string label) {
        assertEq(Depth - 1, obj.depth(), label);
        assertEq(1, obj.v, label);
    }
}
