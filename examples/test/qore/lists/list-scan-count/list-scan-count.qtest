#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in children that set their own execution modes and in qcc executables
# test-platform: macos - the scan counts of the lists of JIT code, of background threads and of qcc executables
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm
%requires ../../../TestInterpreter.qm

%exec-class ListScanCountTest

#! A value that needs a scan for recursive references and is put into a list in place is counted in its scan count
/** The scan count of a list is the number of its values that need a scan (an object, a closure that captured a
    variable); the paths of paths.q put such values into a list without push(): the arguments of a call evaluated into
    a list of its own (a direct call, the copy of a background call evaluated in the new thread, a named call bound at
    parse time), a default value that replaces the argument NOTHING, the arguments of a named call of a function or a
    method bound to the parameters at run time, and the list that reverse() returns (qore#7159).  A debug build checks the count when a
    value is taken out of the list again (the parameters take the arguments over), and the cycle that a list returned
    by reverse() closes is found only if the list counts its values, in every build: the object is destroyed when its
    block ends.  The output must be the same in the ast, ir, jit and tiered modes, on the IR tier of the tiered mode,
    and in executables made by qcc at -O0 and -O3.
*/
class ListScanCountTest inherits QUnit::Test {
    public {
        #! the execution modes
        const Modes = ("ast", "ir", "jit", "tiered");

        #! the qcc optimization levels
        const OptLevels = ("-O0", "-O3");

        #! the environment of a run in which every function is compiled at its first call
        const CompileEnv = "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1";

        #! the output of paths.q
        const Expected = "direct object: 2\n"
            "direct closure: 2\n"
            "background closure: 2\n"
            "background object: 2\n"
            "background named: 2\n"
            "named object: 2\n"
            "default object: 2\n"
            "default closure: 2\n"
            "runtime named object: 2\n"
            "runtime named method: 2\n"
            "reverse: destroyed\n"
            "end\n";
    }

    private {
        string qore_bin;
        string qcc_bin;
        #! the library path of the qcc compiles and of the executables
        string lib_env;
    }

    constructor() : QUnit::Test("ListScanCountTest", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = TestInterpreter::qcc_compiler() ?? "qcc";
        lib_env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s", libqore_dir, libqore_dir);
        addTestCase("values put into a list in place are counted in its scan count", \countTest());
        set_return_value(main());
    }

    countTest() {
        TmpDir dir("qore-list-scan-count-");
        string src = join_paths(dir.path, "paths.q");
        copy_file(get_script_dir() + "/paths.q", src);
        foreach string mode in (Modes) {
            hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s %s %s -b --enable-debug "
                "--exec-mode=%s %s", lib_env, CompileEnv, qore_bin, mode, src));
            assertEq(0, r.rc, sprintf("%s: exit status (output: %y)", mode, r.out));
            assertEq(Expected, r.stdout, mode);
        }
        assertEq(Expected, ExecModeHarness::run_ir_tier(sprintf("%s %s -b --enable-debug --exec-mode=tiered %s",
            lib_env, qore_bin, src)), "IR tier");
        foreach string opt in (OptLevels) {
            string exe = join_paths(dir.path, "paths" + opt);
            int rc;
            string output = backquote(sprintf("%s %s %s -o %s %s 2>&1", lib_env, qcc_bin, opt, exe, src), \rc);
            assertEq(0, rc, sprintf("qcc %s: exit status (output: %s)", opt, output.substr(-2000)));
            # -b must be the first argument of a compiled program
            string out = backquote(sprintf("%s %s -b", lib_env, exe), \rc);
            assertEq(0, rc, sprintf("qcc %s executable: exit status (output: %y)", opt, out));
            assertEq(Expected, out, "qcc " + opt);
        }
    }
}
