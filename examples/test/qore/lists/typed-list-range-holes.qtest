#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - every check runs the script in a child process that sets its own --exec-mode, or AOT
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class TypedListRangeHolesTest

#! qore#6435: a range of a typed list with a hole gives a slice with the or-nothing element type
/** A list<int> can hold NOTHING in its range: delete and remove of an element leave a hole, and an assignment past its
    end fills the gap with NOTHING.  A range over such a list failed an assertion in a debug build in every execution
    mode (a RUNTIME-TYPE-ERROR in a release build): its slice had the element type of the list, which NOTHING does not
    have.  The slice now has the or-nothing element type (list<*int>) when it holds a hole; one without a hole keeps
    the element type of the list.

    The script next to the test (typed-list-range-holes/holes.q) runs in every execution mode, on the IR tier and as
    AOT executables (qcc -O0 and -O3), and its output must be the expected one.
*/
class TypedListRangeHolesTest inherits QUnit::Test {
    public {
        const Expected = "delete hole: [10, null, 12, 13] list<int>
delete hole slice: [10, null, 12] list<*int>
delete hole reverse slice: [13, 12, null, 10] list<*int>
delete hole slice without the hole: [12, 13] list<int>
remove hole slice: [null, 11] list<*int>
gap: [10, null, null, 13] list<int>
gap slice: [10, null, null, 13] list<*int>
gap slice of the gap: [null, null] list<*int>
gap slice in a variable: [10, null, null, 13] list<*int>
gap map: RUNTIME-TYPE-ERROR
gap foreach: [10, null, null, 13] list<auto>
gap selector range: [10, null, null, 13] list<*int>
string gap slice: [\"a\", null, \"c\"] list<*string>
softint gap slice: [10, null, 12] list<*softint>
or-nothing gap slice: [10, null, 12] list<*int>
hash member gap slice: [10, null, 12] list<*int>
gap slice to list<int>: RUNTIME-TYPE-ERROR
";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
    }

    constructor() : QUnit::Test("typed list range holes", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir,
            libqore_dir);

        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executables", \aotTest());
        set_return_value(main());
    }

    #! runs the script in every execution mode and on the IR tier
    private modesTest() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(Expected, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode,
                scriptPath())), mode);
        }
        assertEq(Expected, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin,
            scriptPath())), ExecModeHarness::IRTierName);
    }

    #! compiles the script with qcc -O0 and -O3 and checks the output of the executables
    private aotTest() {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir dir("typed-list-range-holes-aot-");
        foreach string opt in ("-O0", "-O3") {
            string exe = sprintf("%s/holes%s", dir.path, opt);
            string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, scriptPath()));
            assertTrue(is_file(exe), sprintf("%s: qcc compiles the script: %s", opt, out));
            assertEq(Expected, ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
        }
    }

    private string scriptPath() {
        return get_script_dir() + "/typed-list-range-holes/holes.q";
    }
}
