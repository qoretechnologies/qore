#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - threads and debugger attach, and AOT code generation and linking of debug IR

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class DebuggerExceptionIdTest

#! The ID of an exception that a debugger gets (#5906)
/** The exception hash of DebugProgram::onException() has the \c debug_id key: the same in each event of an exception,
    also after a rethrow of it, and new for each exception that is raised, also by a handler.  DebuggerExceptionId.q
    gives the output of the AST interpreter in every execution mode and compiled with qcc.
*/
class DebuggerExceptionIdTest inherits QUnit::Test {
    public {
        #! the output of DebuggerExceptionId.q with the AST interpreter
        const Expected = "two_levels: [\"RUNTIME-TYPE-ERROR@55#1\"]
loop: [\"LOOP@64#1\", \"LOOP@64#2\"]
rethrow_it: [\"RE@72#1\"]
in_handler: [\"BODY@83#1\", \"HANDLER@81#2\"]
";

        #! the optimization levels of the AOT compiles
        const OptLevels = (0, 3);
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string script;
    }

    constructor() : QUnit::Test("DebuggerExceptionIdTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        script = get_script_dir() + "/DebuggerExceptionId.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": the debugger's exception IDs", \modeTest(), (mode,));
        }
        foreach int opt in (OptLevels) {
            addTestCase(sprintf("qcc -O%d: the debugger's exception IDs", opt), \aotTest(), (opt,));
        }
        set_return_value(main());
    }

    modeTest(string mode) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, script));
        assertEq(Expected, output, mode + ": the output of the AST interpreter");
    }

    aotTest(int opt) {
        TmpDir tmp("qore-debugger-exception-id-");
        string exe = tmp.path + DirSep + "debugger-exception-id";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s", libqore_dir,
            libqore_dir, exe));
        assertEq(Expected, output, sprintf("qcc -O%d: the output of the AST interpreter", opt));
    }
}
