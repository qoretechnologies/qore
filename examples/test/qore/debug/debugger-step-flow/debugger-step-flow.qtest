                "result": "null",
                "log": (),
                "steps": (240, "b241", 241, "b243", 243, 244, "b237", 237, 240, "b241", 241, "b243", 243),
            },
            {"function": "switch_in_loop", "flow": "return", "tag": "switch_case", "hit": 1, "block": False,
                "result": "null",
                "log": (),
