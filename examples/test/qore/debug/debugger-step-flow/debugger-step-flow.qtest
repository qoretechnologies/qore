                    "result": "20",
                    "log": (),
                    "steps": (460, 461, "b522", 522, 457, 460, 461, "b522", 522, 457, 460, 461, 524, "b519", 519),
                },
            },
            # native code: the caller calls the callee directly as native code (a callee of its JIT batch), which
            # ignores the request and makes no event for the callee's block on its next calls (#6289)
            {"function": "facts_int_caller", "flow": "return", "tag": "facts_int_first", "hit": 1, "block": False,
                "facts": True,
                "result": "RUNTIME-TYPE-ERROR: <block return> expects type 'int', but got no value instead: "
                    + "block missing return statement",
                "log": (),
                "steps": (469, "b529", 529),
                "native": {
                    "result": "210",
                    "log": (),
                    "steps": (469, 470, "b532", 532, 466, 469, 470, "b532", 532, 466, 469, 470, 534, "b529", 529),
                },
            },
            {"function": "facts_projection", "flow": "return", "tag": "facts_hash_first", "hit": 1, "block": False,
                "facts": True,
                "result": "[1, 1, null, 1, 1]",
                "log": (),
                "steps": (478, 542, "b543", 543),
            },
            # the IR interpreter ignores the break, and the function then calls code of StepFlowTarget.q
            {"function": "facts_argument", "flow": "break", "tag": "facts_string_first", "hit": 1, "block": False,
                "facts": True, "calls": True,
                "result": "16",
                "log": ("RUNTIME-OVERLOAD-ERROR",),
                "steps": (451, "b494", 494, 496, "b497", 497),
            },
            {"function": "facts_value", "flow": "continue", "tag": "facts_string_first", "hit": 1, "block": False,
                "facts": True,
                "result": "[4, 4, 0, 4, 4]",
                "log": ("\"abcd\"", "\"abcd\"", "null", "\"abcd\"", "\"abcd\""),
                "steps": (451, 508, 509, 510, "b511", 511),
            },
            # an immediately called closure, whose return facts let the native code of the caller leave out the check
            # of the argument of a callee's fast entry (#6201)
            {"function": "facts_closure_caller", "flow": "return", "tag": "facts_closure_first", "hit": 1,
                "block": False, "facts": True, "calls": True,
                "result": "172",
                "log": ("RUNTIME-OVERLOAD-ERROR",),
                "steps": (587, "b593", 593, "b583", 583, 590, "b591", 591, "b584", 584, 587, 588, "b576", 576, "b583",
                    583, 590, "b591", 591, "b584", 584, 587, 588, "b576", 576, 596, "b580", 580),
            },
            # no request: a debugger attached in a call that raises an exception gets the events of the handlers that
            # the exception runs in the caller (#6201)
            {"function": "attach_throw_caller", "flow": "none", "tag": "attach_throw_first", "hit": 1, "block": False,
                "result": "ATTACH-THROW: ",
                "log": (),
                "steps": (556, 557, "b558", 558, "b564", 564),
            },
            # a continue in while loops
            {"function": "while_loop", "flow": "continue", "tag": "while_first", "hit": 2, "block": False,
                "again": "55",
                "result": "55",
                "log": (),
                "steps": (32, 33, 34, "b29", 29, 32, "b29", 29, 32, 33, 34, "b29", 29, 32, 33, 34, 36),
            },
            {"function": "while_call_loop", "flow": "continue", "tag": "while_call_first", "hit": 2, "block": False,
                "result": "55",
                "log": ("cond0", "cond1", "cond2", "cond3", "cond3", "cond4", "cond5"),
                "steps": (48, 49, 50, "b45", 45, 48, "b45", 45, 48, 49, 50, "b45", 45, 48, 49, 50, 52),
            },
            # the calls of each kind that a frame running when the debugger attached makes after the attach, which
            # start with the debugger attached and take the request as with the AST interpreter (#6201); a function
            # that the native code of the frame calls directly (a callee of its JIT batch) runs as native code,
            # which ignores the request and makes no event for the callee's block (#6289), and a method or static
            # method that the IR interpreter runs inline runs in the IR frame (#6473)
            {"function": "callpath_function_caller", "flow": "return", "tag": "callpath_function", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (634, "b614", 614, "b631", 631, 634, "b614", 614, 615, "b631", 631, 634, "b614", 614, 615,
                    636, "b629", 629),
                "native": {
                    "result": "5",
                    "log": ("1", "11", "21", "31", "41"),
                    "steps": (634, 614, 615, "b631", 631, 634, 614, 615, "b631", 631, 634, 614, 615, 636, "b629",
                    629),
                },
            },
            {"function": "callpath_function_caller", "flow": "break", "tag": "callpath_function", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (634, "b614", 614, "b631", 631, 634, "b614", 614, 615, "b631", 631, 634, "b614", 614, 615,
                    636, "b629", 629),
                "native": {
                    "result": "5",
                    "log": ("1", "11", "21", "31", "41"),
                    "steps": (634, 614, 615, "b631", 631, 634, 614, 615, "b631", 631, 634, 614, 615, 636, "b629",
                    629),
                },
            },
            {"function": "callpath_method_caller", "flow": "return", "tag": "callpath_method", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (646, "b603", 603, "b643", 643, 646, "b603", 603, 604, "b643", 643, 646, "b603", 603, 604,
                    648, "b640", 640),
            },
            # the IR interpreter runs the method inline in the frame that was running when the debugger attached,
            # which ignores the break (#6473)
            {"function": "callpath_method_caller", "flow": "break", "tag": "callpath_method", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (646, "b603", 603, "b643", 643, 646, "b603", 603, 604, "b643", 643, 646, "b603", 603, 604,
                    648, "b640", 640),
                "ir": {
                    "result": "5",
                    "log": ("1", "11", "21", "31", "41"),
                    "steps": (646, "b603", 603, 604, "b643", 643, 646, "b603", 603, 604, "b643", 643, 646, "b603",
                    603, 604, 648, "b640", 640),
                },
            },
            {"function": "callpath_static_caller", "flow": "return", "tag": "callpath_static", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (657, "b608", 608, "b654", 654, 657, "b608", 608, 609, "b654", 654, 657, "b608", 608, 609,
                    659, "b652", 652),
            },
            # the IR interpreter runs the method inline in the frame that was running when the debugger attached,
            # which ignores the break (#6473)
            {"function": "callpath_static_caller", "flow": "break", "tag": "callpath_static", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (657, "b608", 608, "b654", 654, 657, "b608", 608, 609, "b654", 654, 657, "b608", 608, 609,
                    659, "b652", 652),
                "ir": {
                    "result": "5",
                    "log": ("1", "11", "21", "31", "41"),
                    "steps": (657, "b608", 608, 609, "b654", 654, 657, "b608", 608, 609, "b654", 654, 657, "b608",
                    608, 609, 659, "b652", 652),
                },
            },
            {"function": "callpath_closure_caller", "flow": "return", "tag": "callpath_closure", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (672, "b665", 665, "b669", 669, 672, "b665", 665, 666, "b669", 669, 672, "b665", 665, 666,
                    674, "b663", 663),
            },
            {"function": "callpath_closure_caller", "flow": "break", "tag": "callpath_closure", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (672, "b665", 665, "b669", 669, 672, "b665", 665, 666, "b669", 669, 672, "b665", 665, 666,
                    674, "b663", 663),
            },
            {"function": "callpath_ref_caller", "flow": "return", "tag": "callpath_ref", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (684, "b619", 619, "b681", 681, 684, "b619", 619, 620, "b681", 681, 684, "b619", 619, 620,
                    686, "b678", 678),
            },
            {"function": "callpath_ref_caller", "flow": "break", "tag": "callpath_ref", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (684, "b619", 619, "b681", 681, 684, "b619", 619, 620, "b681", 681, 684, "b619", 619, 620,
                    686, "b678", 678),
            },
            {"function": "callpath_leaf_caller", "flow": "return", "tag": "callpath_leaf", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (695, "b625", 625, "b692", 692, 695, "b625", 625, "b692", 692, 695, "b625", 625, 697,
                    "b690", 690),
                "native": {
                    "result": "5",
                    "log": ("1", "11", "21", "31", "41"),
                    "steps": (695, 625, "b692", 692, 695, 625, "b692", 692, 695, 625, 697, "b690", 690),
                },
            },
            {"function": "callpath_leaf_caller", "flow": "break", "tag": "callpath_leaf", "hit": 1, "block": False,
                "call_path": True, "calls": True,
                "result": "5",
                "log": ("1", "11", "null", "31", "41"),
                "steps": (695, "b625", 625, "b692", 692, 695, "b625", 625, "b692", 692, 695, "b625", 625, 697,
                    "b690", 690),
                "native": {
                    "result": "5",
                    "log": ("1", "11", "21", "31", "41"),
                    "steps": (695, 625, "b692", 692, 695, 625, "b692", 692, 695, 625, 697, "b690", 690),
                },
            },
        );
    }

    private {
        string qore_bin;
        #! the lines of the tags of StepFlowTarget.q
        hash<string, int> tags;
        #! the output line of StepFlowDebugger.q of each function without a request (see getNoRequest())
        hash<string, string> no_request;
    }

    constructor() : QUnit::Test("DebuggerStepFlow", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        tags = getTags();
        addTestCase("a return at a step event", \testReturn());
        addTestCase("a break at a step event", \testBreak());
        addTestCase("a continue at a step event", \testContinue());
        addTestCase("a request in a handler and the requests of a return", \testHandler());
        addTestCase("a return in a callee whose return facts its native caller relies on", \testReturnFacts());
        addTestCase("the events of the handlers run by an exception after a debugger attached", \testNoRequest());
        addTestCase("the calls of each kind that a frame makes after it attached a debugger", \testCallPaths());
        addTestCase("a debugger attached by another thread while a loop runs", \testSpin());
        set_return_value(main());
    }

    #! returns the 1-based line numbers of the lines of StepFlowTarget.q tagged "### <tag>"
    private static hash<string, int> getTags() {
        hash<string, int> ret = {};
        list<string> lines = ReadOnlyFile::readTextFile(get_script_dir() + "/StepFlowTarget.q").split("\n");
        for (int i = 0; i < lines.size(); ++i) {
            *list<*string> tag = lines[i] =~ x/### ([a-z_]+)$/;
            if (tag) {
                ret{tag[0]} = i + 1;
            }
        }
        return ret;
    }

    #! returns the output line of StepFlowDebugger.q expected for a case
    private static string getExpected(hash<auto> c) {
        return sprintf("RESULT:%s LOG:%y STEPS:%y", c.result, c.log, c.steps);
    }

    #! returns the output line of StepFlowDebugger.q
    private static string getOutput(string out) {
        *list<*string> line = out =~ x/^(RESULT:.*)$/m;
        return line ? line[0] : out;
    }

    #! returns the output line of StepFlowDebugger.q expected for a case in a frame that was running when the
    #! debugger attached, as native code (\a tier "native") or in the IR interpreter (\a tier "ir") (#6201)
    private string getRunningExpected(hash<auto> c, string tier) {
        # a pinned result
        if (c{tier}) {
            return getExpected(c + c{tier});
        }
        # a call that starts after the debugger attached, and the IR interpreter's return, take the request as the
        # AST interpreter does
        if (c.flow == "none" || c.call_path || (tier == "ir" && c.flow == "return")) {
            return getExpected(c);
        }
        # an ignored request: the run without it
        return getNoRequest(c);
    }

    #! returns the output line of StepFlowDebugger.q of the function of a case without a request, with the AST
    #! interpreter
    private string getNoRequest(hash<auto> c) {
        if (!no_request{c.function}) {
            string dir = get_script_dir();
            hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s --enable-debug "
                "--exec-mode=ast %s/StepFlowDebugger.q %s/StepFlowTarget.q %s none %d 1 -", qore_bin, dir, dir,
                c.function, tags{c.tag}));
            no_request{c.function} = getOutput(r.out);
        }
        return no_request{c.function};
    }

    #! runs a case in every execution mode and compares the results with those of the AST interpreter, or with those
    #! documented for a frame that was running when the debugger attached (#6201)
    private checkCase(hash<auto> c) {
        string dir = get_script_dir();
        string args = sprintf("%s/StepFlowDebugger.q %s/StepFlowTarget.q %s %s %d %d %s", dir, dir, c.function,
            c.flow, tags{c.tag}, c.hit, c.block ? "block" : "-");
        string what = sprintf("%s %s at %s#%d%s", c.function, c.flow, c.tag, c.hit, c.block ? " (block)" : "");
        # a second request, after the first one
        if (c.flow2) {
            args += sprintf(" %s %d %d", c.flow2, tags{c.tag2}, c.hit2);
            what += sprintf(", %s at %s#%d", c.flow2, c.tag2, c.hit2);
        }
        string ir_args = args;
        if (c.again) {
            args += " again";
        }
        # the calls that start with the debugger attached, as with the AST interpreter
        *string again_ast;
        foreach string mode in (ExecModeHarness::ExecModes) {
            string expected = mode == "ast"
                ? getExpected(c)
                : getRunningExpected(c, mode == "ir" ? "ir" : "native");
            hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s --enable-debug "
                "--exec-mode=%s %s", qore_bin, mode, args), NOTHING, c.promoted
                ? ExecModeHarness::TraceEnv + " QORE_IR_OPT_STATS=1" : NOTHING);
            ExecModeHarness::check_native(r);
            assertEq(expected, getOutput(r.out), sprintf("%s: %s", what, mode));
            if (c.again) {
                *list<*string> again = r.out =~ x/^(AGAIN-RESULT:.*)$/m;
                *list<*string> detached = r.out =~ x/^DETACHED-RESULT:(.*) COMPILED:(.*)$/m;
                string again_line = again[0] ?? r.out;
                if (mode == "ast") {
                    again_ast = again_line;
                    assertEq(c.again, (again_line =~ x/^AGAIN-RESULT:(.*) LOG:/)[0], sprintf("%s: %s: next call",
                        what, mode));
                } else {
                    assertEq(again_ast, again_line, sprintf("%s: %s: next call", what, mode));
                }
                # the code runs as before the debugger attached, without being compiled again
                assertEq((getNoRequest(c) =~ x/^RESULT:(.*) LOG:/)[0], detached[0], sprintf("%s: %s: after the "
                    "debugger detached", what, mode));
                if (detached[1] != "-") {
                    assertEq("0", detached[1], sprintf("%s: %s: functions compiled after the debugger attached", what,
                        mode));
                }
                # the function is compiled to native code once in the run (QORE_JIT_TIMING trace), also without
                # library debugging: never again after the debugger attached or detached
                if (mode == "jit" || mode == "tiered") {
                    string name = "'" + c.function + "@";
                    assertEq(1, (select r.trace, ExecModeHarness::is_native_compilation($1) && $1.find(name) >= 0)
                        .size(), sprintf("%s: %s: compilations of %s()", what, mode, c.function));
                }
            }
            # the locals that the IR keeps in native registers in the function (SSA promotion)
            if (c.promoted && mode != "ast") {
                *list<*string> stats = regex_extract(r.stderr, "IR-OPT: " + c.function
                    + ": .* native-local-loads=([0-9]+)");
                assertGt(0, (stats[0] ?? "0").toInt(), sprintf("%s: %s: promoted loads", what, mode));
            }
            # the function runs as native code when the debugger attaches with JIT and tiered execution
            if (mode == "jit" || mode == "tiered") {
                string name = "'" + c.function + "@";
                assertTrue((select r.trace, ExecModeHarness::is_native_compilation($1) && $1.find(name) >= 0)
                    ? True : False, sprintf("%s: %s: %s() was compiled to native code", what, mode, c.function));
            }
        }
        # tiered execution on the IR tier
        if (c.calls) {
            return;
        }
        assertEq(getRunningExpected(c, "ir"), getOutput(ExecModeHarness::run_ir_tier(sprintf("%s --enable-debug "
            "--exec-mode=tiered %s", qore_bin, ir_args))), sprintf("%s: %s", what, ExecModeHarness::IRTierName));
    }

    #! a debugger that another thread attaches while a loop runs (#6201)
    /** The loop runs as native code with JIT and tiered execution, which ignores the break, and with the IR
        interpreter with IR execution, which ignores it too: its float and int locals then grow together, until the
        debugger stops the loop; with the AST interpreter, the break before the second statement leaves the float one
        step ahead.  The next call, with the debugger attached, takes the break in every mode.
    */
    testSpin() {
        string dir = get_script_dir();
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s --enable-debug "
                "--exec-mode=%s %s/SpinFlowDebugger.q %s/StepFlowTarget.q %d", qore_bin, mode, dir, dir,
                tags.spin_total));
            ExecModeHarness::check_native(r);
            *list<*string> m = r.out =~ x/^RUNNING:f=([0-9.]+) total=([0-9]+) AGAIN:(.*)$/m;
            if (!m) {
                fail(sprintf("%s: unexpected output: %y", mode, r.out));
                continue;
            }
            float f = m[0].toFloat();
            int total = m[1].toInt();
            assertEq(mode == "ast" ? 1.5 * (total + 1) : 1.5 * total, f, sprintf("%s: running loop: f=%y total=%y",
                mode, f, total));
            assertEq("f=3.0 total=1", m[2], sprintf("%s: next call", mode));
        }
    }

    testReturn() {
        foreach hash<auto> c in (Cases) {
            if (c.flow == "return" && !c.handler && !c.facts && !c.call_path) {
                checkCase(c);
            }
        }
    }

    testBreak() {
        foreach hash<auto> c in (Cases) {
            if (c.flow == "break" && !c.handler && !c.facts && !c.call_path) {
                checkCase(c);
            }
        }
    }

    testContinue() {
        foreach hash<auto> c in (Cases) {
            if (c.flow == "continue" && !c.handler && !c.facts && !c.call_path) {
                checkCase(c);
            }
        }
    }

    testHandler() {
        foreach hash<auto> c in (Cases) {
            if (c.handler) {
                checkCase(c);
            }
        }
    }

    testNoRequest() {
        foreach hash<auto> c in (Cases) {
            if (c.flow == "none") {
                checkCase(c);
            }
        }
    }

    testCallPaths() {
        foreach hash<auto> c in (Cases) {
            if (c.call_path) {
                checkCase(c);
            }
        }
    }

    testReturnFacts() {
        foreach hash<auto> c in (Cases) {
            if (c.facts) {
                checkCase(c);
            }
        }
    }
}
