#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT code generation of the debugger's step hooks and of their exits from native frames

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../ExecModeHarness.qm

%exec-class DebuggerStepFlowTest

#! A debugger that requests a flow at a step event gets the flow of the AST interpreter in a call that starts while it
#! is attached, in every execution mode, and in a frame that was running when it attached, the flow documented for the
#! tier of the frame (debugger_running_code)
/** StepFlowDebugger.q calls a function of StepFlowTarget.q in a Program that does not allow a debugger, once to compile
    it to native code with JIT and tiered execution, and then with a debugger in its own Program that the function
    attaches while it runs (through ProgramControl::resolveProgramId()): the function then runs as native code with
    JIT and tiered execution, with the IR interpreter with IR execution and on the IR tier of tiered execution, and
    with the AST interpreter with AST execution.  The debugger steps, and requests a flow at a step event of a
    statement or of a block.

    The expectations below are those of the AST interpreter.  Code lowered from the parse tree has no paths for the
    requests (#6201, design/debug-flow-edges.md "Which code has paths"): a frame that was running when the debugger
    attached ignores them as native code, and the IR interpreter takes a return (the frame returns without a value)
    and ignores a break or a continue; the step events are still reported, so that an ignored request gives the run
    without the request.  A call that starts while the debugger is attached runs on the AST interpreter in every
    execution mode, and takes every request: the calls of each kind that the frame makes after the attach, and with
    \c again, the next call of the function, which also checks that the function runs without being compiled again
    after the debugger detached.  SpinFlowDebugger.q attaches the debugger from another thread while a loop runs.

    The rest of this description is the behaviour of the AST interpreter.

    With the AST interpreter, a return (DebugFlowReturn) at a step event returns from the function at once, without a
    value: the statement does not run, and the handlers of the blocks that the return leaves run as for a return.  A
    function whose return type does not accept no value raises the error of a function without a return statement.
    Native code ignored the request (issue #6200).

    A break or a continue (DebugFlowBreak, DebugFlowContinue) at a step event is a break or a continue statement
    placed before the statement: the blocks that it leaves run their handlers and release their locals, and the
    innermost loop ends or starts its next iteration (a switch statement ends at a break); with no loop (or switch) to
    take it, the function returns without a value.  The IR interpreter ran the statement and did not leave a loop whose
    condition is a fused comparison, and native code ignored the request (issues #6200 and #6201).  A float local that
    the IR keeps in a native register has its value of the step event after the loop.

    A request at a step event of a handler ends the handler, and the block takes the request of its last handler run,
    as with the AST interpreter (StatementBlock::execIntern()): with a handler lowered inline in the code of the
    block's exit and with handlers that run out of line.  A return requested while a return leaves the function, a
    thread_exit or an exception raised by a handler or a destructor while it does, are taken as with the AST
    interpreter.

    A return requested in a callee that native code calls directly, whose code never returns no value, returns no
    value to its caller as with the AST interpreter: the native code of the caller does not rely on the callee's
    return facts (that its value is not NOTHING, or of a type) there, unless the callee's declared return type
    requires a value, where the return raises the error of a missing return value (#6201).
*/
class DebuggerStepFlowTest inherits QUnit::Test {
    public {
        #! the requests and the result, the values logged and the step events of the AST interpreter
        /** - \c function: the function of StepFlowTarget.q called
            - \c flow: the flow that the debugger requests, or \c none for none
            - \c tag: the tag of the line of the statement or block of the request
            - \c hit: the request is made at the hit-th step event of the statement or block
            - \c block: the request is made at the step event of the block that starts on the line, not of the
              statement
            - \c result: the value that the function returned, or the exception that it raised
            - \c log: the values that the function logged while the debugger was attached
            - \c steps: the step events of the debugger: the line of a statement, or "b" and the line of a block
            - \c flow2, \c tag2, \c hit2: a second request, at the hit2-th step event of the statement after the
              first request
            - \c handler: the case of a request in a handler, or of a request while a return leaves the function
            - \c facts: the function calls a callee whose return facts (a value that is not NOTHING, its type, the
              shape of a hash) the native code of the function relies on, and the request is made in the callee
              (#6201)
            - \c promoted: the function has locals that the IR keeps in native registers (SSA promotion), which the
              run checks with the optimization statistics of the IR (QORE_IR_OPT_STATS)
            - \c calls: the function calls code of StepFlowTarget.q while the debugger is attached, which runs on the
              AST tier then, as every call with a debugger attached does (UserVariantBase::evalTiered()), so that it
              is not run on the IR tier only (ExecModeHarness::run_ir_tier())
            - \c native, \c ir: the result, log and steps of a frame that was running when the debugger attached as
              native code (JIT and tiered execution) or in the IR interpreter (IR execution and the IR tier of tiered
              execution), where they are not those of an ignored request (the run without the request) or, for a
              return in the IR interpreter, of the AST interpreter (#6201)
            - \c again: the function is called again with the debugger attached, which takes the request as the AST
              interpreter in every mode (#6201); the value is the result of that call
        */
        const Cases = (
            {"function": "for_loop", "flow": "return", "tag": "for_first", "hit": 2, "block": False,
                "result": "null",
                "log": (),
                "steps": (17, 18, "b14", 14, 17),
                "again": "null",
            },
            {"function": "for_loop", "flow": "return", "tag": "for_body", "hit": 2, "block": True,
                "result": "null",
                "log": (),
                "steps": (17, 18, "b14", 14, 17, 18, "b14"),
            },
            {"function": "while_loop", "flow": "return", "tag": "while_first", "hit": 2, "block": False,
                "result": "null",
                "log": (),
                "steps": (32, 33, 34, "b29", 29, 32),
            },
            {"function": "foreach_loop", "flow": "return", "tag": "foreach_first", "hit": 2, "block": False,
