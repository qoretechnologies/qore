#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# Runs qdbg with a script of commands on its input: with input that is not a terminal, a command that resumes a
# thread returns when the thread stops again or stops being debugged, and the first command is processed when the
# program has attached to the debugger, so each command of the script is processed at the stop that it is written
# for, without waiting for any time

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires Util

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class QdbgScriptTest

public class QdbgScriptTest inherits QUnit::Test {
    private {
        #! the program that is debugged; the comments are the line numbers
        const Program = "%modern\n"                                         # 1
            "int sub add(int a, int b) {\n"                                  # 2
            "    int sum = a + b;\n"                                         # 3
            "    return sum;\n"                                              # 4
            "}\n"                                                            # 5
            "hash<auto> h = {\"name\": \"invoice\", \"lines\": (1, 2, 3)};\n"  # 6
            "int total = add(2, 3);\n"                                       # 7
            "printf(\"total: %d %y\\n\", total, h);\n";                      # 8

        #! a program whose line 4 runs five times, with i from 0 to 4; the comments are the line numbers
        const LoopProgram = "%modern\n"                                     # 1
            "int total = 0;\n"                                              # 2
            "for (int i = 0; i < 5; ++i) {\n"                               # 3
            "    total += i;\n"                                             # 4
            "}\n"                                                           # 5
            "printf(\"total: %d\\n\", total);\n";                          # 6

        #! a program with a line of three statements, calls to step into, a caught and an uncaught exception
        const FeatureProgram = "%modern\n"                                   # 1
            "int sub g(int x) { return x * 10; }\n"                           # 2
            "hash<auto> h = {\"name\": \"é\", \"lines\": (1, 2, 3)};\n"      # 3
            "string s = \"é😀\"; int x = g(1); int y = g(g(2));\n"           # 4
            "try { throw \"CAUGHT\"; } catch (hash<ExceptionInfo> ex) {}\n"   # 5
            "printf(\"%d %d %y\\n\", x, y, h.lines);\n"                      # 6
            "throw \"UNCAUGHT\";\n";                                         # 7

        #! a program with a thread that runs while the initial thread is stopped
        const ThreadProgram = "%modern\n"                                    # 1
            "our bool done;\n"                                                # 2
            "Counter c(1);\n"                                                 # 3
            "background sub () { on_exit c.dec(); int n; while (!done) { ++n; } printf(\"thread done\\n\"); }();\n" # 4
            "done = True;\n"                                                  # 5
            "c.waitForZero();\n";                                             # 6

        #! a program with a long list and a function that is called in a loop
        const DisplayProgram = "%modern\n"                                   # 1
            "list<int> big = range(0, 249);\n"                                # 2
            "int sub f(int a) { int b = a * 2; return b; }\n"                 # 3
            "int total = 0;\n"                                                # 4
            "for (int i = 0; i < 3; ++i) { total += f(i); }\n"                # 5
            "printf(\"%d\\n\", total);\n";                                   # 6

        string qore_exe = QdbgScriptTest::getQoreExecutable();
        string qdbg = normalize_dir(get_script_dir() + "/../../../../bin/qdbg");
        string qdbg_remote = normalize_dir(get_script_dir() + "/../../../../bin/qdbg-remote");
        string qdbg_server = normalize_dir(get_script_dir() + "/../../../../bin/qdbg-server");
        string qdbg_vsc_adapter = normalize_dir(get_script_dir() + "/../../../../bin/qdbg-vsc-adapter");
        string qlib_dir = normalize_dir(get_script_dir() + "/../../../../qlib");
    }

    #! returns the qore executable to run qdbg with; a relative path is made absolute, as qdbg runs in a temporary
    #! directory
    static string getQoreExecutable() {
        string exe = ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        if (exe =~ /\// && !absolute_path(exe)) {
            exe = normalize_dir(getcwd() + DirSep + exe);
        }
        return exe;
    }

    constructor() : Test("QdbgScript", "1.0", \ARGV) {
        addTestCase("a script of commands", \scriptTest());
        addTestCase("a program without statements", \emptyProgramTest());
        addTestCase("conditions, hit conditions and log messages of breakpoints", \breakpointConditionTest());
        addTestCase("exception filters, columns, step-in targets and variables", \featureTest());
        addTestCase("all threads stop together", \stopAllTest());
        addTestCase("exceptions by code", \exceptionCodeTest());
        addTestCase("display expressions, pages of values and columns of the call stack", \displayTest());
        addTestCase("qdbg-remote with a debug server that requires a token", \remoteTest());
        addTestCase("commands of threads, frames and steps", \threadCommandTest());
        addTestCase("quitting while a thread is stopped", \quitTest());
        addTestCase("help and errors", \helpTest());
        addTestCase("time zones", \timeZoneTest());
        addTestCase("the usage of the debugger tools", \usageTest());
        addTestCase("errors at the start of qdbg and qdbg-server", \startupErrorTest());
        set_return_value(main());
    }

    #! runs qdbg for the program with the commands on its input and returns its output and exit code
    private hash<auto> runQdbg(string program, list<string> commands, *list<string> args) {
        TmpDir tmp("qore-qdbg-test-");
        File f();
        f.open2(tmp.path + "/target.q", O_CREAT | O_WRONLY | O_TRUNC);
        f.write(program);
        f.close();
        f.open2(tmp.path + "/commands", O_CREAT | O_WRONLY | O_TRUNC);
        f.write(commands.join("\n") + "\n");
        f.close();
        *string module_dir = ENV.QORE_MODULE_DIR;
        # -y . disables the command history file
        string cmd = sprintf("cd '%s' && QORE_MODULE_DIR='%s' '%s' '%s' -y . --no-color %s target.q < commands 2>&1",
            tmp.path, qlib_dir + (module_dir ? ":" + module_dir : ""), qore_exe, qdbg,
            (map sprintf("'%s'", $1), args ?? ()).join(" "));
        int rc;
        string out = backquote(cmd, \rc);
        # loader warnings of AOT modules that are out of date are about the environment, not output of qdbg
        out = (select out.split("\n"), $1 !~ /^warning: (AOT|binary) module/).join("\n");
        if (m_options.verbose > 1) {
            printf("%s\n", out);
        }
        return {"out": out, "rc": rc};
    }

    #! asserts that the strings are in the output in the order given
    private assertInOrder(string out, list<string> strings) {
        int pos = 0;
        foreach string s in (strings) {
            int i = out.find(s, pos);
            assertGt(-1, i, sprintf("%y after offset %d", s, pos));
            if (i < 0) {
                return;
            }
            pos = i + s.size();
        }
    }

    scriptTest() {
        hash<auto> res = runQdbg(Program, (
            # at the start of the program, expressions are evaluated with its code and there are no local variables
            "eval add(20, 22)",
            "thread local",
            "break create add",
            "break create target.q 8",
            "go run",
            "bt",
            "thread local",
            "thread local a",
            "thread local nosuch",
            "go run",
            "thread local total",
            "eval h.lines[1] + total",
            "eval nosuch",
            "go run",
            "go run",
            "quit",
        ));
        assertEq(0, res.rc);
        assertInOrder(res.out, (
            "interrupt/attach",
            "integer add(20, 22) = 42",
            "no local vars in frame",
            # the results of commands are printed in YAML style
            "bkptid: 1",
            "bkptid: 2",
            # the commands after "go run" are processed at the stop in add()
            "interrupt/step", "bkptid: 1", "(target.q:3",
            "TID 2 call stack:", " - 0*: interrupt: step()", " - 1 : add()",
            "local vars in frame: sum, argv, b, a",
            "integer a = 2",
            "there is no local var \"nosuch\"",
            # and at the stop at line 8
            "interrupt/step", "bkptid: 2", "(target.q:8",
            "integer total = 5",
            # an expression with the local variables of the frame
            "integer h.lines[1] + total = 7",
            "DEBUG-EVALUATE-ERROR",
            "total: 5",
            "interrupt/detach",
        ));
        # no command was processed when the thread was not stopped
        assertFalse(res.out =~ /is not stopped/, "no command is processed when the thread is not stopped");
        assertFalse(res.out =~ /Program is not set/, "no command is processed before the program attaches");
    }

    breakpointConditionTest() {
        hash<auto> res = runQdbg(LoopProgram, (
            "break create target.q 4",
            "break condition 1 i == 3",
            "break create target.q 4",
            "break log 2 i={i} total={total}",
            # negative: an invalid hit condition
            "break hitcondition 2 often",
            "break list",
            "go run",
            "thread local i",
            # without its condition the breakpoint has no options and its hits are no longer counted; with a hit
            # condition, they are counted again from its next hit
            "break condition 1",
            "break hitcondition 1 1",
            "break list",
            "go run",
            "thread local i",
            "go run",
            "quit",
        ));
        assertEq(0, res.rc);
        assertInOrder(res.out, (
            "interrupt/attach",
            "bkptid: 1",
            "bkptid: 2",
            "BREAKPOINT-HIT-CONDITION-ERROR",
            # the options of the breakpoints
            "condition: i == 3", "log: i={i} total={total}",
            # the logpoint writes its message at each hit, and the thread stops when the condition is true
            "i=0 total=0", "i=1 total=0", "i=2 total=1", "i=3 total=3",
            "interrupt/step", "bkptid: 1", "integer i = 3",
            # the logpoint was hit four times
            "hitcondition: 1", "log: i={i} total={total} hits: 4",
            "i=4 total=6",
            "interrupt/step", "bkptid: 1", "integer i = 4",
            "total: 10",
            "interrupt/detach",
        ));
    }

    featureTest() {
        hash<auto> res = runQdbg(FeatureProgram, (
            # all exceptions stop threads by default
            "exception filter",
            "exception filter uncaught",
            "exception filter",
            # the statements of line 4 with their columns, counted in characters
            "stmt line 4",
            # breakpoints on the second and the third statement of line 4
            "break create target.q 4:20",
            "break create target.q 4:33",
            "go run",
            # a hash with its keys, an element, a key, and a variable that does not exist
            "thread var h",
            "thread var h.lines[1]",
            "thread var h{name}",
            "thread var nosuch",
            # an element set to the value of an expression
            "thread var h.lines[1] = 40 + 2",
            "go run",
            # the calls of "int y = g(g(2));", and a step into the outer one
            "thread targets",
            "go stepinto 2",
            "thread local x",
            # negative: a call that the statement does not have
            "go stepinto 9",
            # the caught exception does not stop the thread
            "go run",
            "go run",
            "quit",
        ));
        assertEq(0, res.rc);
        assertInOrder(res.out, (
            "exceptions that stop threads: user, system, uncaught",
            "exceptions that stop threads: uncaught",
        ));
        assertInOrder(res.out, (
            "column 1", "column 18", "column 32",
            "bkptid: 1", "bkptid: 2",
            "interrupt/step", "bkptid: 1",
            "h: hash<auto>", "name: string \"é\"", "lines: list<int>",
            "h.lines[1]: integer 2",
            "h{name}: string \"é\"",
            "no global variable \"nosuch\"",
            "h.lines[1] = integer 42",
            "interrupt/step", "bkptid: 2",
            "1: g (target.q:4:42)", "2: g (target.q:4:40)",
            "interrupt/step", "integer x = 20",
            "the statement has no call",
            "10 200 [1, 42, 3]",
            "interrupt/exception", "(target.q:7",
            "interrupt/detach",
        ));
        # the caught exception did not stop the thread
        assertFalse(res.out =~ /target\.q:5/, "the caught exception does not stop the thread");
    }

    # when the initial thread stops, the thread that it started stops, and they continue together
    stopAllTest() {
        hash<auto> res = runQdbg(ThreadProgram, (
            "options stopall set 1",
            "break create target.q 5",
            "go run",
            "go run",
            "quit",
        ));
        assertEq(0, res.rc);
        assertInOrder(res.out, (
            "interrupt/attach",
            # the initial thread stops at the breakpoint; the other thread stops at its start or in its loop
            "bkptid: 1",
            "thread done",
            "interrupt/detach",
        ));
        # the thread that the initial thread started stopped and continued with it
        list<string> tids = (res.out =~ x/interrupt\/[a-z]+, pgm: [0-9]+, tid: ([0-9]+)/g) ?? ();
        assertTrue((map {$1: True}, tids).size() >= 2, sprintf("%y", tids));
    }

    # the exception filter with the code of the caught exception stops only at that exception
    exceptionCodeTest() {
        hash<auto> res = runQdbg(FeatureProgram, (
            "exception filter CAUGHT",
            "exception filter",
            "go run",
            "go run",
            "go run",
            "quit",
        ));
        assertEq(0, res.rc);
        assertInOrder(res.out, (
            "exceptions that stop threads: CAUGHT",
            "interrupt/exception", "(target.q:5",
            "interrupt/detach",
        ));
        # the program ends with the uncaught exception, which it writes
        assertFalse(res.out =~ /interrupt\/exception[^\n]*target\.q:7/, "the uncaught exception does not stop the "
            "thread");
    }

    displayTest() {
        hash<auto> res = runQdbg(DisplayProgram, (
            "break create target.q 3:20",
            "break create target.q 6",
            "display a",
            "display a * 10",
            "display",
            "go run",
            # the call stack with the columns of the statements
            "bt",
            "go run",
            "undisplay 1",
            "go run",
            # negative: an expression that does not exist
            "undisplay 5",
            "undisplay",
            "go run",
            # the elements of a long list from an index, and the rest of them
            "thread var big from 240",
            "thread var big",
            "go run",
            "quit",
        ));
        assertEq(0, res.rc);
        # the list of the expressions; the output of the command line has CR LF line ends
        assertRegex("(?m)^1: a\r?\n2: a \\* 10\r?$", res.out, "the list of the display expressions");
        assertInOrder(res.out, (
            # the expressions are shown at each stop
            "interrupt/step", "1: a = 0", "2: a * 10 = 0",
            "0*: interrupt: step() (target.q:3:20-3", "1 : f() (target.q:5:31-5",
            "interrupt/step", "1: a = 1", "2: a * 10 = 10",
            "interrupt/step", "1: a * 10 = 20",
            "there is no display expression 5",
            "interrupt/step", "(target.q:6",
            "big: list<int> list (249)", "  240: integer 240", "  248: integer 248",
            "big: list<int> list (249)", "  0: integer 0", "  99: integer 99",
            "... 149 more (thread var big from 100)",
            "6\n",
        ));
        # no expression is shown after they were removed
        int last = res.out.find("(target.q:6");
        assertFalse(res.out.substr(last) =~ /^1: a/m, "no display expression is shown");
    }

%ifdef NoProcess
    remoteTest() {
        testSkip("no process module 2.2 or later");
    }
%else
    #! runs qdbg-remote with the commands on its input for a debug server and returns its output and exit code
    private hash<auto> runRemote(int port, list<string> commands, *string token) {
        TmpDir tmp("qore-qdbg-test-");
        File f();
        f.open2(tmp.path + "/commands", O_CREAT | O_WRONLY | O_TRUNC);
        f.write(commands.join("\n") + "\n");
        f.close();
        *string module_dir = ENV.QORE_MODULE_DIR;
        string cmd = sprintf("cd '%s' && QORE_MODULE_DIR='%s' '%s' '%s' -y . --no-color %s localhost:%d < commands 2>&1",
            tmp.path, qlib_dir + (module_dir ? ":" + module_dir : ""), qore_exe, qdbg_remote,
            token ? sprintf("-H 'Authorization=Bearer %s'", token) : "", port);
        int rc;
        string out = backquote(cmd, \rc);
        out = (select out.split("\n"), $1 !~ /^warning: (AOT|binary) module/).join("\n");
        if (m_options.verbose > 1) {
            printf("%s\n", out);
        }
        return {"out": out, "rc": rc};
    }

    # qdbg-remote processes each command of a script at the stop that it is written for, as qdbg does, with a debug
    # server that requires a token
    remoteTest() {
        TmpDir tmp("qore-qdbg-test-");
        File f();
        f.open2(tmp.path + "/target.q", O_CREAT | O_WRONLY | O_TRUNC);
        f.write(LoopProgram);
        f.close();
        *string module_dir = ENV.QORE_MODULE_DIR;
        Process server(qore_exe, (qdbg_server, "target.q"), {
            "cwd": tmp.path,
            "env": Process::getEnvironment() + {
                "QORE_MODULE_DIR": qlib_dir + (module_dir ? ":" + module_dir : ""),
                "QDBG_SERVER_TOKEN": "s3cret",
            },
        });
        on_exit if (server.running()) {
            server.terminate();
        }
        string line = "";
        while (line !~ /\n/) {
            *string s = server.readStdout(1024, 30s);
            if (!exists s) {
                throw "TEST-ERROR", "the debug server did not start";
            }
            line += s;
        }
        int port = (line =~ x/listening on port ([0-9]+)/)[0].toInt();

        # negative: no token and a wrong token
        hash<auto> res = runRemote(port, ("quit",));
        assertNeq(0, res.rc);
        assertRegex("401", res.out);
        res = runRemote(port, ("quit",), "wrong");
        assertNeq(0, res.rc);

        # the thread of the program that the server holds at its start is the current thread
        res = runRemote(port, (
            "break create target.q 4",
            "break condition 1 i == 2",
            "display total",
            "go run",
            "thread local i",
            "thread var total",
            "go run",
            "quit",
        ), "s3cret");
        assertEq(0, res.rc, res.out);
        assertInOrder(res.out, (
            "connected to debug server",
            "bkptid: 1",
            # the command that resumes the thread returns when it stops at the breakpoint
            "interrupt/step", "bkptid: 1",
            "1: total = 1",
            "integer i = 2",
            "total: integer 1",
            "total: 10",
            "interrupt/detach",
        ));
        server.write("end\n");
        assertTrue(server.wait(30s), "the debug server ends");
    }
%endif

    threadCommandTest() {
        hash<auto> res = runQdbg(Program, (
            "help thread",
            "thread set 2",
            "break create target.q 7",
            "break create target.q 8",
            # without a mode, the thread continues to the next breakpoint
            "go",
            "bt all",
            "thread list",
            # negative: a frame that the stack does not have
            "frame set 9",
            # the only call of the line, and its first statement
            "go stepinto",
            # the end of the function
            "go untilreturn",
            "go",
            "go",
            "quit",
        ));
        assertEq(0, res.rc);
        assertInOrder(res.out, (
            "Subcommands; \"help thread <subcommand>\" shows the details of one:",
            "  set      Select the current thread.",
            "thread context set to TID 2",
            "interrupt/step", "bkptid: 1", "(target.q:7",
            "call stack:", "interrupt: step() (target.q:7",
            "the thread has", "stack frames, numbered from 0",
            "interrupt/step", "(target.q:3",
            "interrupt/funcExit", "(target.q:5",
            "interrupt/step", "bkptid: 2", "(target.q:8",
            "total: 5",
        ));
        assertFalse(res.out =~ /RUNTIME-TYPE-ERROR|INVALID-MEMBER/, "no error of the debugger");
    }

    helpTest() {
        hash<auto> res = runQdbg(Program, (
            "help",
            "help thread set",
            "help go",
            # negative: an unknown command, a missing file name and lines without statements
            "help nosuch",
            "history load",
            "break create target.q 1",
            "break create 1",
            "quit",
        ));
        assertEq(0, res.rc);
        assertInOrder(res.out, (
            "Commands; \"help <command>\" shows the details of one:",
            "  break ", "Commands for breakpoints, which pause the program when it reaches them.",
            "  go ", "Resume the current thread.",
            "Quick start:", "break create <line>",
            "thread set: Select the current thread.", "Usage: thread set <thread>",
            "go: Resume the current thread.", "  go step ", "run to the next line",
            "nosuch: unknown command; try \"help\"",
            "Error: the name of the file is missing: history load <file>",
            "Error: there is no statement on line 1 of \"target.q\" where the program can pause "
                "(PROGRAM-STATEMENT-ERROR)",
            "Error: there is no statement on line 1 where the program can pause (PROGRAM-STATEMENT-ERROR)",
        ));
        # each command of the list has a description
        *list<*string> m = (res.out =~ x/shows the details of one:\r?\n(.*?)\r?\n\r?\nQuick start:/s);
        assertEq(1, m.size());
        list<string> lines = m[0].split("\n");
        assertGt(15, lines.size());
        foreach string line in (lines) {
            assertRegex("^  [a-z]+( \\([a-z, ]+\\))? +[A-Z][^\\r]+\\.\\r?$", line);
        }
        # without the full information of exceptions, the codes of commands are not shown
        assertFalse(res.out =~ /DEBUG-COMMAND/);
    }

    timeZoneTest() {
        string program = "%modern\nprintf(\"offset: %d\\n\", TimeZone::get().UTCOffset());\n";
        hash<auto> res = runQdbg(program, ("go", "quit"), ("-z", "+01:30"));
        assertEq(0, res.rc);
        assertRegex("offset: 5400\\b", res.out);
        res = runQdbg(program, ("go", "quit"), ("-z", "-05:00"));
        assertRegex("offset: -18000\\b", res.out);
        res = runQdbg(program, ("go", "quit"), ("-z", "Etc/GMT-2"));
        assertRegex("offset: 7200\\b", res.out);
        # negative: an offset that is not valid
        res = runQdbg(program, ("go", "quit"), ("-z", "+1"));
        assertRegex("\"\\+1\" is not a valid UTC offset", res.out);
        assertFalse(res.out =~ /offset: /);
    }

    #! runs a debugger tool with arguments and returns its output and exit code
    private hash<auto> runTool(string tool, list<string> args) {
        *string module_dir = ENV.QORE_MODULE_DIR;
        string cmd = sprintf("QORE_MODULE_DIR='%s' '%s' '%s' %s < /dev/null 2>&1",
            qlib_dir + (module_dir ? ":" + module_dir : ""), qore_exe, tool,
            (map sprintf("'%s'", $1), args).join(" "));
        int rc;
        string out = backquote(cmd, \rc);
        out = (select out.split("\n"), $1 !~ /^warning: (AOT|binary) module/).join("\n");
        return {"out": out, "rc": rc};
    }

    usageTest() {
        hash<auto> res = runTool(qdbg, ("-h",));
        assertRegex("usage: qdbg \\[options\\]", res.out);
        assertRegex("-z, --time-zone=zone +the time zone of the script", res.out);
        assertRegex("Type \"help\" at the prompt", res.out);
        res = runTool(qdbg_remote, ("-h",));
        assertRegex("usage: qdbg-remote \\[options\\] <url>", res.out);
        # the default response timeout in milliseconds
        assertRegex("milliseconds; the default is 1500", res.out);
        res = runTool(qdbg_server, ("-h",));
        assertRegex("-k, --token-file=<file>", res.out);
        assertRegex("should require a token", res.out);
        res = runTool(qdbg_vsc_adapter, ("-h",));
        assertRegex("-X, --execute=pgmlist", res.out);
        assertRegex("milliseconds; the default is 1500", res.out);
        assertRegex("UTC offset, such as \\+01:00", res.out);
        # negative: qdbg-remote without a URL
        res = runTool(qdbg_remote, ());
        assertNeq(0, res.rc);
        assertRegex("the URL of the debug server is missing", res.out);
    }

    startupErrorTest() {
        string file = tmp_location() + "/no-such-dir-qdbg/target.q";
        hash<auto> res = runTool(qdbg, (file,));
        assertNeq(0, res.rc);
        assertRegex("^qdbg: error: cannot open .*no-such-dir-qdbg/target.q.* \\(FILE-OPEN2-ERROR\\)", res.out);
        # the error is shown although the output of the server is captured for its clients
        res = runTool(qdbg_server, (file,));
        assertNeq(0, res.rc);
        assertRegex("qdbg-server: error: cannot open .*no-such-dir-qdbg/target.q.* \\(FILE-OPEN2-ERROR\\)", res.out);
        # with -v, the call stack of the error is shown
        res = runTool(qdbg, ("-v", file));
        assertNeq(0, res.rc);
        assertRegex("called at", res.out);
    }

    # a thread that continues when qdbg quits does not stop again, as at the end of the program
    quitTest() {
        hash<auto> res = runQdbg(FeatureProgram, (
            "go run",
            "quit",
        ));
        assertEq(0, res.rc);
        assertInOrder(res.out, ("interrupt/exception", "CAUGHT"));
    }

    # a program that never attaches to the debugger, as it has no statements, does not keep qdbg waiting
    emptyProgramTest() {
        hash<auto> res = runQdbg("%modern\n", ("quit",));
        assertEq(0, res.rc);
        assertFalse(res.out =~ /Program is not set/, "no command is processed before the program attaches");
    }
}
