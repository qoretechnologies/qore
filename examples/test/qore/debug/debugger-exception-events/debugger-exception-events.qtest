#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - AOT code generation and linking of a debugged program, and the debugger's callbacks in its threads

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class DebuggerExceptionEventsTest

#! A debugger gets the same exception events in every execution mode (#5795)
/** The AST interpreter calls the debugger's onException() callback for each statement that an exception leaves: the
    statement that raised it, each statement that contains it, and the statement of each caller, until a try
    statement catches it.  The script DebuggerExceptionEvents.q records these events for programs that raise
    exceptions in top-level code, functions, methods, nested statements, loops and catch blocks, and its output with
    the AST interpreter is the reference for the other execution modes.

    The debugged programs run on the AST interpreter while a debugger is attached, also their top-level code: the IR
    interpreter and native code made no event for most of these statements, and top-level code with JIT execution made
    none at all.  The tiered run of ExecModeHarness::run_ir_tier() is not used: it requires that no call runs on the
    AST tier.

    The script DebuggerExceptionEventsFunctions.q does the same for the functions of the script itself, which are
    also compiled ahead of time with qcc: with a debugger attached, AOT functions run their debug IR, whose IR
    interpreter makes the event of the current statement wherever an exception leaves a frame or reaches a handler in
    it; before, a builtin's exception made no event, a caller none for its statement, a closure and the statements of
    on_exit and on_error code none, a rethrow in on_error code an event too many, and a function left by an exception
    no exit event.  With the argument \c step, the debugger steps through the code, and the exit events of the
    functions are recorded too, which must follow the exception events, as with the AST interpreter.  The debug IR
    of AOT code has no nesting of statements, and its closures no location, so the statements that contain the one
    that raised the exception get no event, a debugger that dismisses an exception where the IR cannot continue
    after the statement ends the function, which returns no value, and a closure's exit event has no line (see
    @ref debugger_aot_exception_events "the debugger's exception events in AOT code").
*/
class DebuggerExceptionEventsTest inherits QUnit::Test {
    public {
        #! the output of DebuggerExceptionEvents.q with the AST interpreter
        const Expected = "top-level throw: [\"A@2\"]
function: [\"B@3\", \"B@5\"]
nested statements: [\"C@4\", \"C@3\", \"C@7\"]
top-level builtin: [\"DIVISION-BY-ZERO@3\"]
builtin in a function: [\"DIVISION-BY-ZERO@4\", \"DIVISION-BY-ZERO@6\"]
top-level try: [\"E@3\", \"F@6\"]
caught from a function: [\"G@3\", \"G@6\"]
top-level loop: [\"H@3\", \"H@2\"]
method: [\"I@4\", \"I@8\"]
rethrow in a catch block: [\"J@3\", \"K@5\", \"K@2\"]
loop in a function: [\"L@5\", \"L@4\", \"L@3\", \"L@9\"]
";

        #! the output of DebuggerExceptionEventsFunctions.q with the AST interpreter, by its argument
        const ExpectedFunctions = {
            "run": "f_throw: [\"B@68\"]
f_nested: [\"C@72\", \"C@71\"]
f_builtin: [\"DIVISION-BY-ZERO@77\"]
f_caught: [\"E@81\", \"F@84\"]
f_loop: [\"H@88\", \"H@87\"]
f_caller: [\"B@68\", \"B@92\"]
f_catch_rethrow: [\"J@96\", \"K@98\", \"K@95\"]
f_builtin_caught: [\"DIVISION-BY-ZERO@104\"]
f_closure: [\"CL@109\", \"CL@110\"]
f_on_exit_throw: [\"C@114\", \"C2@113\"]
f_on_error_rethrow_caught: [\"R@119\", \"R@118\"]
f_dismiss: [\"DIVISION-BY-ZERO@125\"] rv=2
",
            "step": "f_throw: [\"B@68\", \"exit@68\"]
f_nested: [\"C@72\", \"C@71\", \"exit@71\"]
f_builtin: [\"DIVISION-BY-ZERO@77\", \"exit@76\"]
f_caught: [\"E@81\", \"F@84\", \"exit@80\"]
f_loop: [\"H@88\", \"H@87\", \"exit@87\"]
f_caller: [\"B@68\", \"exit@68\", \"B@92\", \"exit@92\"]
f_catch_rethrow: [\"J@96\", \"K@98\", \"K@95\", \"exit@95\"]
f_builtin_caught: [\"DIVISION-BY-ZERO@104\", \"exit@102\"]
f_closure: [\"CL@109\", \"exit@109\", \"CL@110\", \"exit@109\"]
f_on_exit_throw: [\"C@114\", \"C2@113\", \"exit@113\"]
f_on_error_rethrow_caught: [\"R@119\", \"R@118\", \"exit@117\"]
f_dismiss: [\"DIVISION-BY-ZERO@125\", \"exit@124\"] rv=2
",
        };

        #! the output of DebuggerExceptionEventsFunctions.q compiled ahead of time, by its argument
        /** it differs from that of the AST interpreter only where the debug IR of AOT code has no nesting of its
            statements and closures no location: the if, for and try statements that contain the statement that
            raised an exception get no event, the dismissal in f_dismiss() ends the function, which returns no value,
            and the exit event of the closure in f_closure() has no line (see @ref debugger_aot_exception_events)
        */
        const ExpectedFunctionsAot = {
            "run": "f_throw: [\"B@68\"]
f_nested: [\"C@72\"]
f_builtin: [\"DIVISION-BY-ZERO@77\"]
f_caught: [\"E@81\", \"F@84\"]
f_loop: [\"H@88\"]
f_caller: [\"B@68\", \"B@92\"]
f_catch_rethrow: [\"J@96\", \"K@98\"]
f_builtin_caught: [\"DIVISION-BY-ZERO@104\"]
f_closure: [\"CL@109\", \"CL@110\"]
f_on_exit_throw: [\"C@114\", \"C2@113\"]
f_on_error_rethrow_caught: [\"R@119\", \"R@118\"]
f_dismiss: [\"DIVISION-BY-ZERO@125\"] rv=null
",
            "step": "f_throw: [\"B@68\", \"exit@68\"]
f_nested: [\"C@72\", \"exit@71\"]
f_builtin: [\"DIVISION-BY-ZERO@77\", \"exit@76\"]
f_caught: [\"E@81\", \"F@84\", \"exit@80\"]
f_loop: [\"H@88\", \"exit@87\"]
f_caller: [\"B@68\", \"exit@68\", \"B@92\", \"exit@92\"]
f_catch_rethrow: [\"J@96\", \"K@98\", \"exit@95\"]
f_builtin_caught: [\"DIVISION-BY-ZERO@104\", \"exit@102\"]
f_closure: [\"CL@109\", \"CL@110\", \"exit@109\"]
f_on_exit_throw: [\"C@114\", \"C2@113\", \"exit@113\"]
f_on_error_rethrow_caught: [\"R@119\", \"R@118\", \"exit@117\"]
f_dismiss: [\"DIVISION-BY-ZERO@125\", \"exit@124\"] rv=null
",
        };

        #! the output of DebuggerEntryReturn.q in every execution mode and compiled ahead of time
        const ExpectedEntryReturn = "returned=True rv=null\n";

        #! the optimization levels of the AOT compiles
        const OptLevels = (0, 3);
    }

    private {
        string qore_bin;
        string libqore_dir;
        string script;
        string functions_script;
        string entry_return_script;
        string qcc_bin;
    }

    constructor() : QUnit::Test("DebuggerExceptionEventsTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        script = get_script_dir() + "/DebuggerExceptionEvents.q";
        functions_script = get_script_dir() + "/DebuggerExceptionEventsFunctions.q";
        entry_return_script = get_script_dir() + "/DebuggerEntryReturn.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": exception events", \eventsTest(), (mode,));
            foreach string arg in (ExpectedFunctions.keys()) {
                addTestCase(sprintf("%s: exception events of functions (%s)", mode, arg), \functionEventsTest(),
                    (mode, arg));
            }
            addTestCase(mode + ": a return at the start of a function", \entryReturnTest(), (mode,));
        }
        foreach int opt in (OptLevels) {
            foreach string arg in (ExpectedFunctions.keys()) {
                addTestCase(sprintf("qcc -O%d: exception events of functions (%s)", opt, arg),
                    \aotFunctionEventsTest(), (opt, arg));
            }
            addTestCase(sprintf("qcc -O%d: a return at the start of a function", opt), \aotEntryReturnTest(), (opt,));
        }
        set_return_value(main());
    }

    eventsTest(string mode) {
        # the debugged programs run on the AST interpreter; only the script's own code is compiled with JIT execution
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, script), NativeCheck::Jit);
        assertEq(Expected, output, mode + ": the exception events of the AST interpreter");
    }

    functionEventsTest(string mode, string arg) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s %s",
            libqore_dir, libqore_dir, qore_bin, mode, functions_script, arg), NativeCheck::Jit);
        assertEq(ExpectedFunctions{arg}, output, mode + ": the exception events of the AST interpreter");
    }

    #! a debugger's return at the start of a function ends it with no value; the debug IR of AOT code failed with
    #! IR-EXECUTION-ERROR
    entryReturnTest(string mode) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, entry_return_script), NativeCheck::Jit);
        assertEq(ExpectedEntryReturn, output, mode + ": the function returned at its start");
    }

    aotEntryReturnTest(int opt) {
        TmpDir tmp("qore-debugger-entry-return-");
        string exe = tmp.path + DirSep + "entry-return";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            entry_return_script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s", libqore_dir,
            libqore_dir, exe));
        assertEq(ExpectedEntryReturn, output, sprintf("qcc -O%d: the function returned at its start", opt));
    }

    aotFunctionEventsTest(int opt, string arg) {
        TmpDir tmp("qore-debugger-exception-events-");
        string exe = tmp.path + DirSep + "functions";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            functions_script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s %s", libqore_dir,
            libqore_dir, exe, arg));
        assertEq(ExpectedFunctionsAot{arg}, output, sprintf("qcc -O%d: the exception events of the debug IR", opt));
    }
}
