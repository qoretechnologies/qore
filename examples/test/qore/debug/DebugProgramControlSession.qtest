#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# Tests the debug server (DebugProgramControl) as qdbg and the VS Code debug adapter use it

%modern
%allow-debugger
%no-debugging

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DebugProgramControl
%requires DebugCmdLine
%requires Util

%exec-class DebugProgramControlTest

#! the debugged program; the line numbers are referenced by the tests
const TargetScript = "%modern
int sub add(int a, int b) {
    int sum = a + b;
    return sum;
}
hash<auto> h = {\"name\": \"invoice\", \"lines\": (1, 2, 3)};
int total = add(2, 3);
printf(\"%d %y\\n\", total, h);
";

const TargetLabel = "dpc-target.q";

#! a program with an overloaded function
const OverloadScript = "%modern
int sub f(int i) {
    return i;
}
int sub f(string s) {
    return s.size();
}
int sub g() {
    return f(1) + f(\"ab\");
}
printf(\"%d\\n\", g());
";

#! a command line that sends no commands, for its parsing of commands
class TestCommandLine inherits DebugCommandLine {
    public printfImpl(string fmt, ...) {
    }

    public *hash<auto> doCommandImpl(hash<auto> data) {
    }
}

#! how long a test waits for an event of the debugged program before it fails
const EventTimeout = 30s;

#! a debug server that queues what it sends to its client so that a test can act on it deterministically
class TestDebugProgramControl inherits DebugProgramControl {
    public {
        const CX = {"id": 1};

        #! responses sent by the debugged threads
        Queue responses();

        #! events broadcast to all clients
        Queue events();

        #! gives the commands sent to stopped threads their unique IDs
        Sequence uids();
    }

    constructor() : DebugProgramControl("DebugProgramControlTest") {
        registerConnection(CX);
    }

    public nothing sendDataImpl(hash<auto> cx, auto data) {
        responses.push(data);
    }

    public nothing broadcastDataImpl(auto data) {
        events.push(data);
    }

    #! sends a command that is processed in the server thread and returns its result
    auto command(string cmd, *hash<auto> args) {
        hash<auto> rv = processCommand(CX, {"cmd": cmd} + args);
        if (rv.type == DebugResponseType::Error) {
            throw rv.result.err, rv.result.desc;
        }
        @assert(rv.type == DebugResponseType::Response);
        return rv.result;
    }

    #! sends a command to a stopped thread and returns the response the thread sends
    /** a stopped thread answers every command, with the unique ID of the command
    */
    auto threadCommand(int tid, string cmd, *hash<auto> args) {
        hash<auto> resp = threadRequest(tid, cmd, args);
        if (resp.type == DebugResponseType::Error) {
            throw resp.result.err, resp.result.desc;
        }
        return resp.result;
    }

    #! sends a command to a stopped thread and returns the whole answer
    hash<auto> threadRequest(int tid, string cmd, *hash<auto> args) {
        string uid = string(uids.next());
        hash<auto> rv = processCommand(CX, {"cmd": cmd, "tid": tid, "uid": uid} + args);
        if (rv.type == DebugResponseType::Error) {
            throw rv.result.err, rv.result.desc;
        }
        @assert(rv.type == DebugResponseType::Thread);
        hash<auto> resp = responses.get(EventTimeout);
        if (resp.uid != uid) {
            throw "TEST-ERROR", sprintf("expecting the answer to command %y (uid %y); got: %y", cmd, uid, resp);
        }
        return resp;
    }

    #! sends a command to a stopped thread whose answer has no result, such as "debug/frame/set"
    threadSend(int tid, string cmd, *hash<auto> args) {
        auto result = threadCommand(tid, cmd, args);
        if (result != {}) {
            throw "TEST-ERROR", sprintf("expecting an empty answer to command %y; got: %y", cmd, result);
        }
    }

    #! resumes a stopped thread; the thread answers "go" with an empty hash before it resumes
    go(int tid, string runState = "run") {
        threadSend(tid, "thread/go/" + runState);
    }

    #! returns the next interrupt event, skipping breakpoint change notifications
    /** @param pgmId if given, interrupt events of any other program are skipped; the debugged programs share this
        one event queue, so without the filter an interrupt left in the queue by a previously-removed program (for
        example its \c detach when its test case resumed it to its end in a different order under load) would be
        returned to the next program's client as if it were that program's event
    */
    hash<auto> getInterrupt(*int pgmId) {
        while (True) {
            hash<auto> e = events.get(EventTimeout);
            if (e.cmd == DebugEventCmd::Interrupt && (!exists pgmId || e.pgmid == pgmId)) {
                return e;
            }
        }
    }
}

#! a debugged program run in a background thread, stopped at its start
class DebuggedProgram {
    public {
        TestDebugProgramControl dpc;
        Program pgm;
        int pgmId;

        #! TID of the thread running the program, which the debugger stopped at its start
        int tid;

        #! receives the result of the program run when it ends
        Queue done();

        #! True when the program run has ended
        bool finished;
    }

    constructor(TestDebugProgramControl dpc, string script = TargetScript, string label = TargetLabel) {
        self.dpc = dpc;
        pgm = dpc.createProgram(label, NOTHING, (), script);
        pgmId = pgm.getProgram().getProgramId();
        background run();
        hash<auto> e = dpc.getInterrupt(pgmId);
        if (e.func != "attach") {
            throw "TEST-ERROR", sprintf("expecting the attach event at the start of the program; got: %y", e);
        }
        tid = e.tid;
    }

    private run() {
        try {
            done.push({"rc": pgm.run()});
        } catch (hash<ExceptionInfo> ex) {
            done.push({"ex": ex});
        }
    }

    #! creates a breakpoint on a line of the program and returns the result
    hash<auto> breakAt(int line, string file = TargetLabel) {
        return dpc.command(sprintf("program/%d/breakpoint//create", pgmId), {
            "value": {"file": file, "lineno": line},
        });
    }

    #! runs the program until it stops and returns the interrupt event
    hash<auto> runToStop() {
        dpc.go(tid);
        return dpc.getInterrupt(pgmId);
    }

    #! runs the program to its end and returns the result of the run
    /** the debugger stops the thread again when the program ends, at the detach event
    */
    hash<auto> finish() {
        dpc.go(tid);
        hash<auto> e = dpc.getInterrupt(pgmId);
        if (e.func != "detach") {
            throw "TEST-ERROR", sprintf("expecting the detach event at the end of the program; got: %y", e);
        }
        dpc.go(tid);
        hash<auto> rv = done.get(EventTimeout);
        finished = True;
        return rv;
    }

    #! ends debugging of the program and the program run, also when a test failed while the program was stopped
    cleanup() {
        dpc.removeProgram(pgm.getProgram());
        if (!finished) {
            # releases the thread if it is stopped; it does not stop again as the program is no longer debugged
            dpc.shutdown();
            done.get(EventTimeout);
            finished = True;
        }
    }
}

public class DebugProgramControlTest inherits QUnit::Test {
    private {
        TestDebugProgramControl dpc;
    }

    constructor() : QUnit::Test("DebugProgramControl", "1.0", \ARGV) {
        addTestCase("thread stack", \threadStackTest());
        addTestCase("thread stack of all threads", \allThreadStacksTest());
        addTestCase("thread stack frame", \threadStackFrameTest());
        addTestCase("breakpoint on top-level statement", \topLevelBreakpointTest());
        addTestCase("local variables of the frames of a stopped thread", \localVariableTest());
        addTestCase("local variables of the frames of a thread stopped in a function", \functionFrameVariableTest());
        addTestCase("every command of a stopped thread is answered", \threadAnswerTest());
        addTestCase("breakpoint on statement without temporaries", \noTempBreakpointTest());
        addTestCase("breakpoint on file given with another path", \filePathBreakpointTest());
        addTestCase("breakpoint on function", \functionBreakpointTest());
        addTestCase("breakpoint on overloaded function", \overloadedFunctionBreakpointTest());
        addTestCase("statement identification of the command line", \commandLineStatementTest());
        addTestCase("breakpoint errors", \breakpointErrorTest());
        set_return_value(main());
    }

    globalSetUp() {
        dpc = new TestDebugProgramControl();
    }

    globalTearDown() {
        dpc.shutdown();
    }

    threadStackTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        hash<auto> bp = p.breakAt(8);
        assertEq(Type::Int, bp.bkptid.type());

        hash<auto> e = p.runToStop();
        assertEq("step", e.func);
        assertEq(bp.bkptid, e.bkptid);
        assertEq(8, e.line);

        list<auto> stack = dpc.threadCommand(p.tid, "thread/stack");
        assertGt(0, stack.size());
        # the frames are untyped hashes so that the debugger can add keys of its own
        foreach hash<auto> frame in (stack) {
            assertEq("hash", frame.fullType());
        }
        # the frame of the debugged statement is the current one by default
        assertTrue(stack[0].current);
        assertEq(1, (select stack, $1.current).size());
        assertEq("interrupt: step", stack[0].function);
        assertEq(TargetLabel, stack[0].file);
        assertEq(8, stack[0].line);

        # the event carries the same stack, without a current frame
        assertEq(stack.size(), e.stack.size());
        assertEq(8, e.stack[0].line);
        assertNothing(e.stack[0].current);

        assertEq({"rc": NOTHING}, p.finish());
    }

    allThreadStacksTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        p.breakAt(8);
        hash<auto> e = p.runToStop();
        assertEq(8, e.line);

        hash<auto> stacks = dpc.command("thread/stack");
        list<auto> stack = stacks{p.tid};
        assertGt(0, stack.size());
        # the stack of the stopped thread is adjusted to the debugged statement
        assertEq("hash", stack[0].fullType());
        assertEq("interrupt: step", stack[0].function);
        assertEq(8, stack[0].line);
        assertEq(p.pgmId, stack[0].programid);
        # the stack of this thread, which is not stopped, is returned unchanged
        assertEq(Type::List, stacks{gettid()}.type());

        assertEq({"rc": NOTHING}, p.finish());
    }

    threadStackFrameTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        p.breakAt(8);
        p.runToStop();

        list<auto> stack = dpc.threadCommand(p.tid, "thread/stack");
        # a frame given in the command is the current one
        if (stack.size() > 1) {
            list<auto> stack1 = dpc.threadCommand(p.tid, "thread/stack", {"frameid": 1});
            assertNothing(stack1[0].current);
            assertTrue(stack1[1].current);
        }
        # a frame beyond the stack marks no frame as current
        list<auto> stack2 = dpc.threadCommand(p.tid, "thread/stack", {"frameid": stack.size()});
        assertEq(0, (select stack2, $1.current).size());
        # the frame set with "debug/frame/set" is the current one by default
        dpc.threadSend(p.tid, "thread/debug/frame/set", {"value": AbstractDebugControl::serialize(stack.size() - 1)});
        assertEq(stack.size() - 1, dpc.threadCommand(p.tid, "thread/debug/frame/get"));
        list<auto> stack3 = dpc.threadCommand(p.tid, "thread/stack");
        assertTrue(stack3[stack.size() - 1].current);
        assertEq(1, (select stack3, $1.current).size());

        assertEq({"rc": NOTHING}, p.finish());
    }

    topLevelBreakpointTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        hash<auto> bp6 = p.breakAt(6);
        hash<auto> bp8 = p.breakAt(8);
        assertNeq(bp6.stmtid, bp8.stmtid);

        hash<auto> e = p.runToStop();
        assertEq(bp6.bkptid, e.bkptid);
        assertEq(6, e.line);
        e = p.runToStop();
        assertEq(bp8.bkptid, e.bkptid);
        assertEq(8, e.line);

        assertEq({"rc": NOTHING}, p.finish());
    }

    # the debugger's callbacks run with the options of the debugger, not with the restrictions of the debugged
    # code, and see the frames of the debugged code
    localVariableTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        p.breakAt(8);
        hash<auto> e = p.runToStop();
        assertEq(8, e.line);

        list<auto> names = dpc.threadCommand(p.tid, "thread/local//list");
        assertTrue(inlist("h", names));
        assertTrue(inlist("total", names));
        hash<auto> total = dpc.threadCommand(p.tid, "thread/local/total/get");
        assertEq(5, AbstractDebugControl::unserialize(total.value));
        hash<auto> h = dpc.threadCommand(p.tid, "thread/local/h/get");
        assertEq("invoice", AbstractDebugControl::unserialize(h.value).name);

        # a local variable set by the debugger
        dpc.threadSend(p.tid, "thread/local/total/set", {"value": AbstractDebugControl::serialize(10)});
        total = dpc.threadCommand(p.tid, "thread/local/total/get");
        assertEq(10, AbstractDebugControl::unserialize(total.value));

        assertEq({"rc": NOTHING}, p.finish());
    }

    # each frame of a thread stopped in a function has the local variables of its code: the callee of a call that
    # the interpreter would inline or make through a fast path has a frame of its own while a debugger is attached,
    # and the temporaries of the debugger's callbacks are not variables of the stopped code
    functionFrameVariableTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        p.breakAt(4);
        hash<auto> e = p.runToStop();
        assertEq(4, e.line);

        # the frame of add()
        list<auto> names = dpc.threadCommand(p.tid, "thread/local//list");
        assertEq(("a", "argv", "b", "sum"), sort(names));
        hash<auto> sum = dpc.threadCommand(p.tid, "thread/local/sum/get");
        assertEq(5, AbstractDebugControl::unserialize(sum.value));
        hash<auto> a = dpc.threadCommand(p.tid, "thread/local/a/get", {"frameid": 0});
        assertEq(2, AbstractDebugControl::unserialize(a.value));

        # the frame of the top-level code that called add()
        names = dpc.threadCommand(p.tid, "thread/local//list", {"frameid": 1});
        assertEq(("h", "total"), sort(names));
        hash<auto> h = dpc.threadCommand(p.tid, "thread/local/h/get", {"frameid": 1});
        assertEq("invoice", AbstractDebugControl::unserialize(h.value).name);
        # a variable of another frame is not found: the answer has no value
        assertEq({}, dpc.threadCommand(p.tid, "thread/local/h/get"));

        # a local variable of the stopped function set by the debugger changes what the function returns
        dpc.threadSend(p.tid, "thread/local/sum/set", {"value": AbstractDebugControl::serialize(42)});
        sum = dpc.threadCommand(p.tid, "thread/local/sum/get");
        assertEq(42, AbstractDebugControl::unserialize(sum.value));

        # the program prints the value returned by add()
        assertEq({"rc": NOTHING}, p.finish());
    }

    # a stopped thread answers every command of a client, so that the client can wait for the answer without a
    # timeout, and a command queued for a thread that resumed is answered with an error
    threadAnswerTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        p.breakAt(8);
        p.runToStop();

        # commands with no result are answered with an empty hash, with the unique ID of the command
        hash<auto> resp = dpc.threadRequest(p.tid, "thread/debug/frame/set", {"value": AbstractDebugControl::serialize(0)});
        assertEq(DebugResponseType::Response, resp.type);
        assertEq({}, resp.result);
        assertEq(p.tid, resp.tid);
        # an error is answered as an error
        resp = dpc.threadRequest(p.tid, "thread/go/no-such-state");
        assertEq(DebugResponseType::Error, resp.type);
        assertEq("DEBUG-HANDLER-ERROR", resp.result.err);

        # "go" and a command sent right after it: the second command is always answered with its own unique ID and
        # is never left hanging (the #5560 guarantee).  Which answer it gets depends on scheduling and is correct
        # either way: if the thread had already resumed when the command was processed it is answered with the
        # "is not stopped" error (drained from the thread's queue or answered inline); if the thread had re-stopped
        # at the detach event at the program's end (the breakpoint is on the last statement) before the command was
        # processed, it is answered with a normal stack response of the detach frame.  The faster IR/JIT tiers reach
        # the re-stop sooner, so the normal-response outcome is common there and rare with the AST interpreter.
        string go_uid = string(dpc.uids.next());
        string stack_uid = string(dpc.uids.next());
        hash<auto> rv = dpc.processCommand(TestDebugProgramControl::CX, {"cmd": "thread/go/run", "tid": p.tid,
            "uid": go_uid});
        assertEq(DebugResponseType::Thread, rv.type);
        rv = dpc.processCommand(TestDebugProgramControl::CX, {"cmd": "thread/stack", "tid": p.tid, "uid": stack_uid});
        resp = dpc.responses.get(EventTimeout);
        assertEq(go_uid, resp.uid);
        assertEq({}, resp.result);
        if (rv.type == DebugResponseType::Thread) {
            resp = dpc.responses.get(EventTimeout);
        } else {
            resp = rv;
        }
        # answered, with the command's own unique ID
        assertEq(stack_uid, resp.uid);
        if (resp.type == DebugResponseType::Error) {
            # the thread had resumed: specifically the "is not stopped" error
            assertEq("DEBUG-HANDLER-ERROR", resp.result.err);
            assertRegex("is not stopped", resp.result.desc);
        } else {
            # the thread had re-stopped at the detach event: a well-formed, non-empty call stack
            assertEq(DebugResponseType::Response, resp.type);
            assertEq(Type::List, resp.result.type());
            assertGt(0, resp.result.size());
            assertEq(Type::Hash, resp.result[0].type());
        }

        # the program ends: it stops at the detach event
        hash<auto> e = dpc.getInterrupt(p.pgmId);
        assertEq("detach", e.func);
        dpc.go(p.tid);
        assertEq({"rc": NOTHING}, p.done.get(EventTimeout));
        p.finished = True;
    }

    # issue #5558: statements that create no temporaries, such as a declaration with an int expression or a return
    # statement, had no step event with the IR and JIT tiers, so their breakpoints were never hit
    noTempBreakpointTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        hash<auto> bp7 = p.breakAt(7);
        hash<auto> bp3 = p.breakAt(3);
        hash<auto> bp4 = p.breakAt(4);

        hash<auto> e = p.runToStop();
        assertEq(bp7.bkptid, e.bkptid);
        assertEq(7, e.line);
        e = p.runToStop();
        assertEq(bp3.bkptid, e.bkptid);
        assertEq(3, e.line);
        # the stack of a stop in a function
        list<auto> stack = dpc.threadCommand(p.tid, "thread/stack");
        assertEq(3, stack[0].line);
        assertEq("add", stack[1].function);
        assertEq(7, stack[1].line);
        e = p.runToStop();
        assertEq(bp4.bkptid, e.bkptid);
        assertEq(4, e.line);

        assertEq({"rc": NOTHING}, p.finish());
    }

    # issue #5558: a file parsed with a relative path can be given with an absolute path, as an IDE gives it
    filePathBreakpointTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        string abs_path = normalize_dir(getcwd() + DirSep + TargetLabel);
        hash<auto> bp_abs = p.breakAt(8, abs_path);
        hash<auto> bp_dot = p.breakAt(8, "." + DirSep + TargetLabel);
        hash<auto> bp_dotdot = p.breakAt(8, normalize_dir(getcwd()) + DirSep + "x" + DirSep + ".." + DirSep
            + TargetLabel);
        hash<auto> bp = p.breakAt(8);
        assertEq(bp.stmtid, bp_abs.stmtid);
        assertEq(bp.stmtid, bp_dot.stmtid);
        assertEq(bp.stmtid, bp_dotdot.stmtid);
        # the file in another directory is another file
        assertThrows("PROGRAM-STATEMENT-ERROR", \p.breakAt(), (8, DirSep + "no-such-dir" + DirSep + TargetLabel));

        hash<auto> e = p.runToStop();
        assertEq(8, e.line);
        assertEq(bp_abs.stmtid, e.statementid);

        assertEq({"rc": NOTHING}, p.finish());
    }

    # issue #5558: a function given by its name only is its only variant
    functionBreakpointTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        string cmd = sprintf("program/%d/breakpoint//create", p.pgmId);
        hash<auto> bp = dpc.command(cmd, {"value": {"function": "add"}});
        # the same statement as the variant given with its parameter types
        hash<auto> bp_args = dpc.command(cmd, {"value": {"function": "add", "args": ("int", "int")}});
        assertEq(bp.stmtid, bp_args.stmtid);
        # a variant without parameters does not exist
        assertThrows("VARIANT-MATCH-ERROR", \dpc.command(), (cmd, {"value": {"function": "add", "args": ()}}));
        # a function that does not exist
        assertThrows("PROGRAM-ERROR", \dpc.command(), (cmd, {"value": {"function": "no_such_function"}}));

        hash<auto> e = p.runToStop();
        assertEq("step", e.func);
        assertEq(bp_args.bkptid, e.bkptid);
        list<auto> stack = dpc.threadCommand(p.tid, "thread/stack");
        assertEq("add", stack[1].function);

        assertEq({"rc": NOTHING}, p.finish());
    }

    overloadedFunctionBreakpointTest() {
        DebuggedProgram p(dpc, OverloadScript, "dpc-overload.q");
        on_exit p.cleanup();
        string cmd = sprintf("program/%d/breakpoint//create", p.pgmId);
        # a function with more than one variant needs the parameter types
        assertThrows("DEBUG-HANDLER-ERROR", "\"f\" has 2 variants", \dpc.command(), (cmd, {"value": {"function": "f"}}));
        hash<auto> bp_string = dpc.command(cmd, {"value": {"function": "f", "args": ("string",)}});
        hash<auto> bp_int = dpc.command(cmd, {"value": {"function": "f", "args": ("int",)}});
        assertNeq(bp_int.stmtid, bp_string.stmtid);

        hash<auto> e = p.runToStop();
        assertEq(bp_int.bkptid, e.bkptid);
        e = p.runToStop();
        assertEq(bp_string.bkptid, e.bkptid);

        assertEq({"rc": NOTHING}, p.finish());
    }

    commandLineStatementTest() {
        TestCommandLine cl();
        assertEq({"file": "", "lineno": 7}, cl.getStatementValue(("7",)));
        assertEq({"file": "x.q", "lineno": 7}, cl.getStatementValue(("x.q", "7")));
        assertEq({"id": 3}, cl.getStatementValue(("#3",)));
        assertEq({"function": "add", "args": ("int", "int")}, cl.getStatementValue(("add(int, int)",)));
        assertEq({"function": "add", "args": ()}, cl.getStatementValue(("add()",)));
        # issue #5558: a function given by its name only
        assertEq({"function": "add"}, cl.getStatementValue(("add",)));
        assertEq({"function": "Ns::add"}, cl.getStatementValue(("Ns::add",)));
        assertThrows("DEBUG-PROGRAM-HELPER", "Statement description is missing", \cl.getStatementValue(), ((),));
        assertThrows("DEBUG-PROGRAM-HELPER", "expecting", \cl.getStatementValue(), (("x.q",),));
        assertThrows("DEBUG-PROGRAM-HELPER", "expecting", \cl.getStatementValue(), (("x.q", "y"),));
    }

    breakpointErrorTest() {
        DebuggedProgram p(dpc);
        on_exit p.cleanup();
        # a line with no statement
        assertThrows("PROGRAM-STATEMENT-ERROR", \p.breakAt(), (100,));
        # a file the program was not parsed from
        assertThrows("PROGRAM-STATEMENT-ERROR", \p.breakAt(), (6, "other.q"));
        # a program that does not exist
        assertThrows("PROGRAM-ERROR", \dpc.command(), ("program/2147483647/breakpoint//create",
            {"value": {"file": TargetLabel, "lineno": 6}}));
        # a thread that is not stopped
        assertThrows("DEBUG-HANDLER-ERROR", \dpc.threadCommand(), (gettid(), "thread/stack"));

        assertEq({"rc": NOTHING}, p.finish());
    }
}
