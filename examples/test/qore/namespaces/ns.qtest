#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

public namespace ParentRedeclareNs {
    public const SharedPort = 8001;
    public const SharedName = "parent-api";

    public class SharedClass {
    }

    public enum SharedEnum : string {
        Value = "value",
    }
}

%exec-class Test

class Test inherits QUnit::Test {
    constructor() : QUnit::Test("ns", "1.0") {
        addTestCase("ns", \nsTests());
        addTestCase("parented Program module public const redeclare",
            \parentedProgramModulePublicConstRedeclare());

        set_return_value(main());
    }

    nsTests() {
        {
            Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
            p.loadModule(get_script_dir() + "/T.qm");

            string code = "namespace T { namespace T1 { namespace T2 { class X {} class X1 inherits X {} } }}";
            list args = (code, "issue-538-1");
            testNullAssertion("issue-538-1", \p.parse(), args);
        }

        {
            Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
            p.loadModule(get_script_dir() + "/T.qm");

            string code = "namespace T { namespace T1 { class X {} class X1 inherits X {} } }";
            list args = (code, "issue-538-2");
            testNullAssertion("issue-538-2", \p.parse(), args);
        }
    }

    parentedProgramModulePublicConstRedeclare() {
        Program p(PO_DEFAULT, False);
        p.loadApplyToUserModule(get_script_dir() + "/ParentRedeclare.qm", True);
        assertTrue(True, "parented Program accepts public API redeclarations from loaded user module");
    }
}
