#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class SharedActionSetsTest

#! Regression test for qore#7714: the process-wide REST schema action sets of data provider modules are shared objects
/** SharedActionSets.q gets the action sets that two data provider modules keep for every caller (one built in a lazy
    shared value, one in a lazy value of the data provider action catalog) first in a tenant (a sandboxed Program):
    the sets, their operations and their request types are shared objects, which the tenant cannot change or delete;
    the tenant can still use them (also building their output-type callbacks, which a shared set keeps in an update
    scope) and copy a set, which gives an unshared copy of its own; trusted code still uses the sets afterwards.  Its
    output must be the one in SharedActionSets.expected in every execution mode, and in programs compiled with qcc -O0
    and -O3 (the tenant's code is parsed at run time, so the compiled code there is that of the trusted caller).
*/
class SharedActionSetsTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        list<string> fixtures = ("SharedActionSets",);
    }

    constructor() : QUnit::Test("shared action sets", "1.0", \ARGV) {
        foreach string fixture in (fixtures) {
            string name = fixture;
            foreach string mode in (ExecModeHarness::ExecModes) {
                string execution_mode = mode;
                addTestCase(name + ": execution mode " + mode, sub () {
                    # the library modules' code chooses its own execution, so the native compilation is not checked
                    assertEq(expected(name), ExecModeHarness::run(command(name, execution_mode),
                        ExecModeHarness::NativeCheck::None));
                });
            }
            addTestCase(name + ": qcc -O0", sub () { checkQcc(name, 0); });
            addTestCase(name + ": qcc -O3", sub () { checkQcc(name, 3); });
        }

        set_return_value(main());
    }

    private string fixture(string name) {
        return get_script_dir() + "/" + name + ".q";
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(get_script_dir() + "/" + name + ".expected");
    }

    private string command(string name, string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture(name)));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(string name, int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/" + name;
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture(name))));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        # the output of the fixture only: a library module that the program loads from source because its binary
        # module was built for another Qore library warns on stderr
        assertEq(expected(name), backquote(shellQuote(program) + " 2>/dev/null"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
