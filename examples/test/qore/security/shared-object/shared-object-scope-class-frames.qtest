#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - the class contexts of the call frames of the JIT and AOT native code

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class SharedObjectScopeClassFramesTest

#! The frames of a class that restricted code declared count in an update scope at any depth (qore#7795)
/** In an update scope of a shared object, the code of a class that restricted code declared acts for restricted code
    wherever it is on the stack: the code that it calls (a method of the object's own class, directly or through other
    methods, a plain function or another class of the library) cannot change the object, share an object or open
    another update scope, also when its sandbox has since been relaxed to trust its code and when the class is in the
    %Program of the scope; once it returns, the scope's own code changes the object again.  A scope that restricted
    code opens through the object's class, whose own code then runs in it with the provenance of restricted code (also
    with a library object that restricted code created), still changes the object and shares objects, and the code of
    a class of a trusted (governed) sandbox is not affected.

    SharedObjectScopeClassFrames.q checks these; its output must be the one in SharedObjectScopeClassFrames.expected in
    every execution mode, and in programs compiled with qcc -O0 and -O3.
*/
class SharedObjectScopeClassFramesTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/SharedObjectScopeClassFrames.q";
        string lib = get_script_dir() + "/SharedObjectScopeClassFramesLib.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/SharedObjectScopeClassFrames.expected");
    }

    constructor() : QUnit::Test("shared object scope class frames", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run_stdout(command(execution_mode)));
            });
        }
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s %s", shellQuote(qore_bin), mode, shellQuote(fixture),
            shellQuote(lib));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/shared-object-scope-class-frames";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        # the output of the fixture only: a library module that the program loads from source because its binary
        # module was built for another Qore library warns on stderr
        assertEq(expected, backquote(shellQuote(program) + " " + shellQuote(lib) + " 2>/dev/null"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
