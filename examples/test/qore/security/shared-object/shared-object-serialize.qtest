#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - the serialization calls of the JIT and AOT native code

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class SharedObjectSerializeTest

#! Regression test for qore#7673: serialization of a shared object fails closed for sandboxed code
/** Code that is sandboxed or acts for sandboxed code (a tenant, a trusted deputy that the tenant calls, the code of
    the object's own class) cannot serialize an object that trusted code marked with SandboxManager::shareObject(),
    with any of the serialization APIs, nor a value that holds one (an object, a hash, a list or a weak reference),
    whatever its classes declare (a class with its own serializeMembers() method, also one that leaves out private
    containers, a subclass, a class with only transient members, a class that inherits a builtin class with a
    serializer, a class that inherits SandboxSerializable); nothing is written to a stream for a refused object.
    Trusted code serializes as before, and a deserialized object is not shared.  The objects that are not shared that
    the tenant serializes are of a trusted class that inherits SandboxSerializable: without it, the tenant cannot
    serialize the non-public state of a trusted class (SERIALIZATION-ERROR, qore#7146), which one case checks.

    SharedObjectSerialize.q checks these serializations; SharedObjectSerializeModules.q checks that the tenant cannot
    serialize the shared objects of the classes of the standard modules that guard their state with
    SandboxManager::isSharedObject(self), which trusted code still serializes.  Their output must be the one in the
    .expected files in every execution mode, and in programs compiled with qcc -O0 and -O3 (the tenant's code is
    parsed at run time, so the compiled serializations there are those of the trusted code).
*/
class SharedObjectSerializeTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        list<string> fixtures = ("SharedObjectSerialize", "SharedObjectSerializeModules");
    }

    constructor() : QUnit::Test("shared object serialize", "1.0", \ARGV) {
        foreach string fixture in (fixtures) {
            string name = fixture;
            foreach string mode in (ExecModeHarness::ExecModes) {
                string execution_mode = mode;
                addTestCase(name + ": execution mode " + mode, sub () {
                    # the library modules' code chooses its own execution, so the native compilation is not checked
                    assertEq(expected(name), ExecModeHarness::run(command(name, execution_mode),
                        ExecModeHarness::NativeCheck::None));
                });
            }
            addTestCase(name + ": qcc -O0", sub () { checkQcc(name, 0); });
            addTestCase(name + ": qcc -O3", sub () { checkQcc(name, 3); });
        }

        set_return_value(main());
    }

    private string fixture(string name) {
        return get_script_dir() + "/" + name + ".q";
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(get_script_dir() + "/" + name + ".expected");
    }

    private string command(string name, string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture(name)));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(string name, int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/" + name;
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture(name))));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        # the output of the fixture only: a library module that the program loads from source because its binary
        # module was built for another Qore library warns on stderr
        assertEq(expected(name), backquote(shellQuote(program) + " 2>/dev/null"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
