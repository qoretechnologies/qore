#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# the builtin WebSocket poll-operation classes (WebSocketClientPollOperationBase and HttpWebSocketPollOperationBase)
# are in the NETWORK functional domain (qore#7157): their send methods write data of the caller's choosing on the
# connected Socket that they are given, so code restricted from NETWORK, which cannot create a Socket or send on one,
# cannot send on a Socket that other code gives it through them either: it cannot create them (nor the WebSocketClient
# and HttpServerAsyncIo classes that inherit them), neither in code nor by a name given at run time, nor call their
# methods, also on an object that other code gives it; code that may use the network can

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
# loaded by the test, so that the restricted Programs import them (a Program restricted from NETWORK cannot load
# them itself, as they create NETWORK classes)
%requires WebSocketClient
%requires HttpServerAsyncIo

%exec-class WebSocketPollOpNetworkDomainTest

class WebSocketPollOpNetworkDomainTest inherits QUnit::Test {
    public {
        const Restricted = PO_MODERN | PO_NO_NETWORK;
        const Plain = PO_MODERN;

        #! the builtin classes
        const Classes = ("WebSocketClientPollOperationBase", "HttpWebSocketPollOperationBase");

        #! the qlib classes that inherit them, with the module that each is in
        const Subclasses = {
            "WebSocketClient::WebSocketClientPollOperation": "WebSocketClient",
            "HttpServerAsyncIo::HttpWebSocketPollOperation": "HttpServerAsyncIo",
        };
    }

    constructor() : QUnit::Test("WebSocketPollOpNetworkDomainTest", "1.0") {
        addTestCase("parse", \parseTest());
        addTestCase("subclasses", \subclassTest());
        addTestCase("runtime creation", \runtimeCreateTest());
        addTestCase("runtime method call", \runtimeMethodTest());
        addTestCase("unrestricted", \unrestrictedTest());
        set_return_value(main());
    }

    #! the error of parsing \a code in a new Program with \a po, or "parsed"
    private static string parseErr(int po, string code) {
        Program p(po);
        try {
            p.parse(code, "probe");
            return "parsed";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! code that creates an object of the class with a Socket that the code is given
    private static string newCode(string cls) {
        return sprintf("object sub f(Socket s) { return new %s(s); }", cls);
    }

    #! code that sends a text message with an object of the class that the code is given
    private static string sendCode(string cls) {
        return sprintf("sub f(%s o) { o.sendText(\"x\"); }", cls);
    }

    #! returns a connected pair of sockets: the server's end, which the code under test gets, and the client's
    private static list<Socket> connectedPair() {
        Socket listener();
        listener.bind("127.0.0.1:0");
        listener.listen();
        Socket client();
        client.connect("127.0.0.1:" + listener.getSocketInfo().port);
        Socket server = listener.accept(10s);
        listener.close();
        return (server, client);
    }

    parseTest() {
        foreach string cls in (Classes) {
            assertEq("ILLEGAL-CLASS-INSTANTIATION", parseErr(Restricted, newCode(cls)), "new " + cls);
            assertEq("PARSE-EXCEPTION", parseErr(Restricted, sendCode(cls)), "method of " + cls);
        }
    }

    #! the qlib classes inherit the domain
    subclassTest() {
        foreach hash<auto> i in (Subclasses.pairIterator()) {
            assertEq("ILLEGAL-CLASS-INSTANTIATION", parseErr(Restricted, sprintf("%%requires %s\n%s", i.value,
                newCode(i.key))), i.key);
        }
    }

    #! by a name given at run time, with a connected Socket that the host gives the code
    runtimeCreateTest() {
        Program p(Restricted);
        p.parse("auto sub f(string cls, Socket s) { return create_object_args(cls, (s,)); }", "probe");
        foreach string cls in (Classes) {
            list<Socket> pair = connectedPair();
            on_exit {
                pair[0].close();
                pair[1].close();
            }
            string err;
            try {
                p.callFunction("f", cls, pair[0]);
                err = "created";
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            assertEq("CREATE-OBJECT-ERROR", err, cls);
        }
    }

    #! a send method called by a name given at run time, on an object that the host gives the code: nothing is sent
    runtimeMethodTest() {
        Program p(Restricted);
        p.parse("auto sub f(object o) { return call_object_method(o, \"sendText\", \"x\"); }", "probe");
        foreach string cls in (Classes) {
            list<Socket> pair = connectedPair();
            on_exit {
                pair[0].close();
                pair[1].close();
            }
            object o = create_object(cls, pair[0]);
            string err;
            try {
                p.callFunction("f", o);
                err = "called";
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            assertNeq("called", err, cls + ": the method was refused");
            # nothing reached the peer
            assertFalse(pair[1].isDataAvailable(0), cls + ": nothing was sent");
        }
    }

    unrestrictedTest() {
        foreach string cls in (Classes) {
            assertEq("parsed", parseErr(Plain, newCode(cls)), "new " + cls);
            assertEq("parsed", parseErr(Plain, sendCode(cls)), "method of " + cls);
        }
        # code that may use the network creates the classes by name and sends with them
        Program p(Plain);
        p.parse("auto sub f(string cls, Socket s) { object o = create_object_args(cls, (s,)); o.sendText(\"x\"); "
            "return o; }", "probe");
        foreach string cls in (Classes) {
            list<Socket> pair = connectedPair();
            on_exit {
                pair[0].close();
                pair[1].close();
            }
            assertEq(Type::Object, p.callFunction("f", cls, pair[0]).type(), cls);
        }
    }
}
