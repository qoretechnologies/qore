# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

# a trusted module whose public variables and static class members every importer shares (qore#5664)

%modern

module OurVarMod {
    version = "1.0";
    desc = "test module with public state";
    author = "Qore Technologies";
    url = "https://qore.org";
}

public namespace OurVarMod {
    public class Obj {
        public {
            int x = 1;
            static int sx = 1;
            static list<int> sl;
        }

        #! the module's own setter of a static member: a method runs in the module's Program
        static set_sx(int v) {
            sx = v;
        }

        static resetStatic() {
            sx = 1;
            sl = (1, 2, 3);
        }
    }

    #! a class with declared members and a member gate
    public class G {
        public {
            int x = 1;
        }

        private {
            int p = 7;
        }

        auto memberGate(string m) {
            return "gate:" + m;
        }
    }

    public our int i;
    public our list<int> l;
    public our hash<auto> h;
    public our string s;
    public our Obj o;
    public our G g;
    public our hash<auto> hn;

    public sub reset() {
        i = 1;
        l = (1, 2, 3);
        h = {"a": 1, "b": 2};
        s = "abc";
        o = new Obj();
        g = new G();
        hn = {"a": {"b": 1}};
        Obj::resetStatic();
    }

    #! a function of the module runs in the Program that calls it, with its restrictions
    public sub set_sx_func(int v) {
        Obj::sx = v;
    }

    public string sub state() {
        return sprintf("%y|%y|%y|%s|%y|%y|%y|%y", i, l, h, s, o.x, hn, Obj::sx, Obj::sl);
    }

    public sub set_i(int v) {
        i = v;
    }

    public sub push_l(int v) {
        push l, v;
    }
}
