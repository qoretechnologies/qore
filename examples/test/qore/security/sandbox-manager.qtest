    testQueueInterrupt() {
        # Test that Queue::get/pop is interrupted when interrupt is pre-set
        SandboxManager sm();
        sm.requestInterrupt();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern
sub doQueueGet() {
    Queue q();
    q.get();
}
sub doQueuePop() {
    Queue q();
    q.pop();
}
        ", "queue_interrupt");

        bool caught = False;
        try {
            p.callFunction("doQueueGet");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("PROGRAM-INTERRUPTED", ex.err, "Queue::get() interrupted correctly");
        }
        assertEq(True, caught, "Queue::get() was interrupted");

        caught = False;
        try {
            p.callFunction("doQueuePop");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("PROGRAM-INTERRUPTED", ex.err, "Queue::pop() interrupted correctly");
        }
        assertEq(True, caught, "Queue::pop() was interrupted");
    }

