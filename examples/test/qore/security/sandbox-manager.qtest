    testNetworkConfiguration() {
        # Test network security configuration methods
        SandboxManager sm();

        # Test default policy
        assertEq(False, sm.getNetworkDefaultPolicy(), "Default network policy is deny");

        sm.setNetworkDefaultPolicy(True);
        assertEq(True, sm.getNetworkDefaultPolicy(), "Network policy can be set to allow");

        sm.setNetworkDefaultPolicy(False);
        assertEq(False, sm.getNetworkDefaultPolicy(), "Network policy can be set back to deny");

        # Test adding allowed host
        sm.addNetworkAllowedHost("example.com");
        sm.addNetworkAllowedHost("*.trusted.org");

        # Test adding allowed port
        sm.addNetworkAllowedPort(443, QSEC_NET_TCP);
        sm.addNetworkAllowedPort(80, QSEC_NET_ALL);

        # Test adding allowed port range
        sm.addNetworkAllowedPortRange(8000, 9000, QSEC_NET_TCP);

        # Test adding allowed IP range
        sm.addNetworkAllowedIPRange("203.0.113.0/24");

        # Test adding denied IP range
        sm.addNetworkDeniedIPRange("192.168.0.0/16");

        # Test getting configuration
        hash<auto> config = sm.getNetworkConfiguration();
        assertEq("hash", config.fullType(), "Network configuration is a hash");
        assertEq("deny", config.default_policy, "Default policy in config is deny");
    }

    testBlockPrivateNetworks() {
        # Test the blockPrivateNetworks preset
        SandboxManager sm();
        sm.blockPrivateNetworks();

        hash<auto> config = sm.getNetworkConfiguration();
        assertEq(True, config.denied_ranges_count > 0, "Private networks added to denied list");

        # Test blockLocalhost
        SandboxManager sm2();
        sm2.blockLocalhost();

        hash<auto> config2 = sm2.getNetworkConfiguration();
        assertEq(True, config2.denied_ranges_count > 0, "Localhost added to denied list");

        # Test allowHTTPSOnly
        SandboxManager sm3();
        sm3.allowHTTPSOnly();

        hash<auto> config3 = sm3.getNetworkConfiguration();
        assertEq(True, config3.allowed_ports.size() > 0, "HTTPS port added to allowed list");
    }

    testNetworkSocketIntegration() {
        # Test that network security is enforced for socket connections
        SandboxManager sm();

        # Block private networks and set default to allow (so we can test blocking)
        sm.blockPrivateNetworks();
        sm.setNetworkDefaultPolicy(True);

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern
sub connectToLocalhost() {
    Socket s();
    s.connect('127.0.0.1:80', 1000);
}
        ", "network_security");

        bool caught = False;
        try {
            p.callFunction("connectToLocalhost");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            # Should get NETWORK-ACCESS-DENIED or SOCKET-CONNECT-ERROR (if localhost blocked before DNS)
            assertEq(True, ex.err == "NETWORK-ACCESS-DENIED" || ex.err == "SOCKET-CONNECT-ERROR",
                "Connection to localhost blocked with correct error: " + ex.err);
        }
        assertEq(True, caught, "Connection to localhost was blocked");

        # Test with allowed destination - use default allow policy
        SandboxManager sm2();
        sm2.setNetworkDefaultPolicy(True);

        Program p2(PO_NO_CHILD_PO_RESTRICTIONS);
        p2.setSandboxManager(sm2);

        p2.parse("
%modern
sub connectToPublic() {
    Socket s();
    # This will likely fail to connect but should not be blocked by security
    try {
        s.connect('93.184.216.34:80', 100);  # example.com IP
    } catch (ex) {
        # Connection timeout/refused is expected, not security block
        if (ex.err == 'NETWORK-ACCESS-DENIED') {
            throw ex;
        }
    }
}
        ", "network_allowed");

        caught = False;
        try {
            p2.callFunction("connectToPublic");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "NETWORK-ACCESS-DENIED") {
                caught = True;
            }
            # Other exceptions (timeout, refused) are OK
        }
        assertEq(False, caught, "Connection to public IP was not blocked");
    }

    testMutexBlockedInterrupt() {
        # Test that sleep() can be interrupted while ALREADY blocked
        # This tests the polling mechanism - sleep() blocks in 500ms chunks and
        # checks for interrupt between chunks.
        #
        # Note: The Queue, Counter, and Condition blocked tests below verify
        # that other blocking primitives also support polling-based interrupts.

        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern
sub doSleepTest(Queue resultQueue) {
    resultQueue.push('ready');

    try {
        sleep(60s);  # Will block, but should be interruptible via polling
        resultQueue.push({'caught': False, 'err': ''});
    } catch (hash<ExceptionInfo> ex) {
        resultQueue.push({'caught': True, 'err': ex.err});
    }
}
        ", "sleep_blocked_interrupt");

        # Start the test in background
        background p.callFunction("doSleepTest", resultQueue);

        # Wait for the 'ready' signal
        auto ready = resultQueue.get(5s);
        assertEq("ready", ready, "Test setup completed");

        # Give a little time for sleep() to start blocking
        usleep(100ms);

        # Request interrupt while thread is blocked on sleep
        sm.requestInterrupt();

        # Wait for result (should come within polling interval + margin)
        # Sleep polls every 100ms, so should respond quickly
        hash<auto> result = resultQueue.get(2s);
        assertEq(True, result.caught, "sleep() was interrupted while blocked");
        assertEq("PROGRAM-INTERRUPTED", result.err, "Correct exception thrown for blocked sleep interrupt");
    }

    testQueueBlockedInterrupt() {
        # Test that Queue::get() can be interrupted while ALREADY blocked

        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern
sub doQueueTest(Queue resultQueue) {
    Queue emptyQueue();

    # Signal that we're ready
    resultQueue.push('ready');

    # Block on empty queue - this will block indefinitely without interrupt
    try {
        emptyQueue.get();
        resultQueue.push({'caught': False, 'err': ''});
    } catch (hash<ExceptionInfo> ex) {
        resultQueue.push({'caught': True, 'err': ex.err});
    }
}
        ", "queue_blocked_interrupt");

        # Start the test in background
        background p.callFunction("doQueueTest", resultQueue);

        # Wait for the 'ready' signal
        auto ready = resultQueue.get(5s);
        assertEq("ready", ready, "Test setup completed");

        # Give a little time for the get() to block
        usleep(100ms);

        # Request interrupt while thread is blocked on queue
        sm.requestInterrupt();

        # Wait for result
        hash<auto> result = resultQueue.get(2s);
        assertEq(True, result.caught, "Queue::get() was interrupted while blocked");
        assertEq("PROGRAM-INTERRUPTED", result.err, "Correct exception thrown for blocked Queue interrupt");
    }

    testCounterBlockedInterrupt() {
        # Test that Counter::waitForZero() can be interrupted while ALREADY blocked

        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern
sub doCounterTest(Queue resultQueue) {
    Counter cnt(1);  # Will never reach zero without dec()

    # Signal that we're ready
    resultQueue.push('ready');

    # Block waiting for counter to reach zero
    try {
        cnt.waitForZero();
        resultQueue.push({'caught': False, 'err': ''});
    } catch (hash<ExceptionInfo> ex) {
        resultQueue.push({'caught': True, 'err': ex.err});
    }
}
        ", "counter_blocked_interrupt");

        # Start the test in background
        background p.callFunction("doCounterTest", resultQueue);

        # Wait for the 'ready' signal
        auto ready = resultQueue.get(5s);
        assertEq("ready", ready, "Test setup completed");

        # Give a little time for waitForZero() to block
        usleep(100ms);

        # Request interrupt while thread is blocked
        sm.requestInterrupt();

        # Wait for result
        hash<auto> result = resultQueue.get(2s);
        assertEq(True, result.caught, "Counter::waitForZero() was interrupted while blocked");
        assertEq("PROGRAM-INTERRUPTED", result.err, "Correct exception thrown for blocked Counter interrupt");
    }

    testConditionBlockedInterrupt() {
        # Test that Condition::wait() can be interrupted while ALREADY blocked

        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern
sub doConditionTest(Queue resultQueue) {
    Mutex mtx();
    Condition cond();

    mtx.lock();

    # Signal that we're ready
    resultQueue.push('ready');

    # Block waiting for condition signal that never comes
    try {
        cond.wait(mtx);
        mtx.unlock();
        resultQueue.push({'caught': False, 'err': ''});
    } catch (hash<ExceptionInfo> ex) {
        try { mtx.unlock(); } catch () {}
        resultQueue.push({'caught': True, 'err': ex.err});
    }
}
        ", "condition_blocked_interrupt");

        # Start the test in background
        background p.callFunction("doConditionTest", resultQueue);

        # Wait for the 'ready' signal
        auto ready = resultQueue.get(5s);
        assertEq("ready", ready, "Test setup completed");

        # Give a little time for wait() to block
        usleep(100ms);

        # Request interrupt while thread is blocked
        sm.requestInterrupt();

        # Wait for result
        hash<auto> result = resultQueue.get(2s);
        assertEq(True, result.caught, "Condition::wait() was interrupted while blocked");
        assertEq("PROGRAM-INTERRUPTED", result.err, "Correct exception thrown for blocked Condition interrupt");
    }

    testCancelCallback() {
        # Test that cancel callbacks are invoked when requestInterrupt() is called
        # This tests the cancel callback mechanism used by database modules for interruptible I/O

        SandboxManager sm();
        Queue resultQueue();

        # Create a child program with sandbox manager
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern

# Simulates a blocking operation that would be cancelled by the callback
sub blockingOperation(Queue q) {
    q.push('started');
    # Block on an empty queue - this would normally block forever
    # but will be interrupted when requestInterrupt() is called
    Queue blockingQ();
    try {
        blockingQ.get();
    } catch (hash<ExceptionInfo> ex) {
        q.push({'interrupted': True, 'err': ex.err});
    }
}
        ", "cancel_callback_test");

        # Start blocking operation in background
        background p.callFunction("blockingOperation", resultQueue);

        # Wait for the operation to start
        auto started = resultQueue.get(5s);
        assertEq("started", started, "Blocking operation started");

        # Give time for the queue get to block
        usleep(100ms);

        # Request interrupt - this should trigger the cancel callback mechanism
        # For database modules, this would call database-specific cancel functions
        sm.requestInterrupt();

        # Wait for the result
        hash<auto> result = resultQueue.get(2s);
        assertEq(True, result.interrupted, "Blocking operation was interrupted");
        assertEq("PROGRAM-INTERRUPTED", result.err, "Correct exception from cancel");
    }

    testCancelCallbackMultiple() {
        # Test that multiple independent operations can each have their own cancel callbacks
        # This simulates multiple database connections each with their own cancel mechanism

        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern

sub multipleBlockers(Queue q, int count) {
    Counter ready(count);

    for (int i = 0; i < count; i++) {
        int threadId = i;
        background sub() {
            Queue blockingQ();
            ready.dec();
            try {
                blockingQ.get();
                q.push({'id': threadId, 'err': NOTHING, 'completed': True});
            } catch (hash<ExceptionInfo> ex) {
                q.push({'id': threadId, 'err': ex.err, 'completed': False});
            }
        }();
    }

    # Signal all threads are ready
    ready.waitForZero();
    q.push('all_started');
}
        ", "multiple_cancel_test");

        int threadCount = 3;
        background p.callFunction("multipleBlockers", resultQueue, threadCount);

        # Wait for all threads to start blocking
        auto started = resultQueue.get(5s);
        assertEq("all_started", started, "All blocking threads started");

        # Give time for all gets to block
        usleep(100ms);

        # Request interrupt
        sm.requestInterrupt();

        # Collect results from all threads
        list<hash<auto>> results = ();
        for (int i = 0; i < threadCount; i++) {
            auto result = resultQueue.get(2s);
            if (result.typeCode() == NT_HASH && exists result.id) {
                results += result;
            }
        }

        # Verify all threads were interrupted
        assertEq(threadCount, results.size(), "All threads reported results");
        foreach hash<auto> r in (results) {
            assertEq("PROGRAM-INTERRUPTED", r.err, "Thread " + r.id + " got correct exception");
        }
    }

    testCancelCallbackUnregister() {
        # Test that cancel callbacks are properly unregistered after an operation completes
        # This ensures no memory leaks or stale callbacks

        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);

        p.parse("
%modern

# Perform multiple short operations - each would register/unregister a cancel callback
sub shortOperations(Queue q, int count) {
    for (int i = 0; i < count; i++) {
        # A short operation that completes normally
        # In database modules, this would be a quick query that registers
        # a cancel callback on entry and unregisters on exit
        usleep(10ms);
    }
    q.push({'completed': count});
}
        ", "unregister_test");

        # Run multiple short operations
        int count = 10;
        background p.callFunction("shortOperations", resultQueue, count);

        # Wait for completion
        hash<auto> result = resultQueue.get(5s);
        assertEq(count, result.completed, "All short operations completed");

        # Now verify that interrupt still works after many register/unregister cycles
        Program p2(PO_NO_CHILD_PO_RESTRICTIONS);
        p2.setSandboxManager(sm);

        p2.parse("
%modern
sub blockAfterManyOps(Queue q) {
    q.push('ready');
    Queue blockingQ();
    try {
        blockingQ.get();
    } catch (hash<ExceptionInfo> ex) {
        q.push({'err': ex.err});
    }
}
        ", "block_after_unregister");

        background p2.callFunction("blockAfterManyOps", resultQueue);

        auto ready = resultQueue.get(5s);
        assertEq("ready", ready, "Ready to block after many operations");

        usleep(100ms);
        sm.requestInterrupt();

        result = resultQueue.get(2s);
        assertEq("PROGRAM-INTERRUPTED", result.err, "Interrupt still works after many callback cycles");
    }

    #! Test for edge cases with concurrent callback invocation and unregistration
    #! This verifies that the atomic pointer protection in cancel helpers works correctly
    testCancelCallbackConcurrentTiming() {
        # This test specifically tests the race condition between:
        # 1. requestInterrupt() copying callbacks and invoking them
        # 2. The cancel helper being destroyed and clearing its pointers

        SandboxManager sm();

        # Run multiple rapid cycles of interrupt/clear to stress test the timing
        int cycles = 100;
        int successCount = 0;

        for (int i = 0; i < cycles; i++) {
            Queue resultQueue();
            Program p(PO_NO_CHILD_PO_RESTRICTIONS);
            p.setSandboxManager(sm);

            p.parse("
%modern

sub quickBlockingOp(Queue q) {
    q.push('started');
    Queue block();
    try {
        block.get(100ms);
        q.push({'timeout': True});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'err': ex.err});
    }
}
            ", "concurrent_timing_test");

            background p.callFunction("quickBlockingOp", resultQueue);

            auto started = resultQueue.get(1s);
            assertEq("started", started);

            # Small delay then interrupt - this races with the blocking op
            usleep(10ms);
            sm.requestInterrupt();

            hash<auto> result = resultQueue.get(1s);
            if (result.err == "PROGRAM-INTERRUPTED") {
                successCount++;
            }

            # Clear interrupt for next iteration
            sm.clearInterrupt();
        }

        # Most cycles should have been interrupted successfully
        # (some may timeout naturally due to timing)
        assertTrue(successCount > cycles / 2,
            sprintf("At least half of %d cycles interrupted (got %d)", cycles, successCount));

        # Test rapid register/unregister without any blocking
        # This exercises the callback registration code path
        for (int i = 0; i < 50; i++) {
            Program p(PO_NO_CHILD_PO_RESTRICTIONS);
            p.setSandboxManager(sm);

            p.parse("
%modern
sub noOp() {}
            ", "rapid_noop");

            # Just calling parse and letting program go out of scope
            # exercises the module initialization/cleanup paths
        }

        assertEq(True, True, "Rapid register/unregister cycles completed without crash");
    }
}
