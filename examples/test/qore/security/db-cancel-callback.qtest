#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%new-style
%enable-all-warnings
%require-types
%strict-args
%no-child-restrictions

%requires QUnit

%exec-class DbCancelCallbackTest

#! Test database cancel callback functionality
#!
#! This test verifies that database operations can be cancelled using the
#! SandboxManager cancel callback mechanism. It requires actual database
#! connections to run.
#!
#! Environment variables:
#! - QORE_DB_CONNSTR_PGSQL: PostgreSQL connection string
#! - QORE_DB_CONNSTR_ORACLE: Oracle connection string
#! - QORE_DB_CONNSTR_SYBASE: Sybase/FreeTDS connection string
#! - QORE_DB_CONNSTR_MYSQL: MySQL connection string
#!
#! Example:
#! QORE_DB_CONNSTR_PGSQL="pgsql:user/pass@host/db" ./qore db-cancel-callback.qtest
class DbCancelCallbackTest inherits QUnit::Test {
    private {
        *string pgsql_connstr;
        *string oracle_connstr;
        *string sybase_connstr;
        *string mysql_connstr;
    }

    constructor() : QUnit::Test("DbCancelCallbackTest", "1.0", \ARGV) {
        pgsql_connstr = ENV.QORE_DB_CONNSTR_PGSQL;
        oracle_connstr = ENV.QORE_DB_CONNSTR_ORACLE;
        sybase_connstr = ENV.QORE_DB_CONNSTR_SYBASE;
        mysql_connstr = ENV.QORE_DB_CONNSTR_MYSQL;

        if (pgsql_connstr) {
            addTestCase("PostgreSQL cancel callback test", \testPgsqlCancel());
            addTestCase("PostgreSQL blocked cancel test", \testPgsqlBlockedCancel());
        }
        if (oracle_connstr) {
            addTestCase("Oracle cancel callback test", \testOracleCancel());
            addTestCase("Oracle blocked cancel test", \testOracleBlockedCancel());
        }
        if (sybase_connstr) {
            addTestCase("Sybase cancel callback test", \testSybaseCancel());
            addTestCase("Sybase blocked cancel test", \testSybaseBlockedCancel());
        }
        if (mysql_connstr) {
            addTestCase("MySQL cancel callback test", \testMysqlCancel());
        }

        if (!pgsql_connstr && !oracle_connstr && !sybase_connstr && !mysql_connstr) {
            addTestCase("No database connection configured", \testNoDatabaseConfigured());
        }

        set_return_value(main());
    }

    testNoDatabaseConfigured() {
        testSkip("No database connection strings configured. Set QORE_DB_CONNSTR_* environment variables.");
    }

    #! Test that PostgreSQL operations can be cancelled via the cancel callback
    testPgsqlCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        try {
            p.loadModule("pgsql");
        } catch (hash<ExceptionInfo> ex) {
            testSkip("PostgreSQL module not available: " + ex.desc);
            return;
        }

        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    q.push('connected');

    try {
        # Run a query that takes some time
        # pg_sleep(10) will sleep for 10 seconds
        ds.exec('SELECT pg_sleep(10)');
        q.push({'cancelled': False});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'cancelled': True, 'err': ex.err, 'desc': ex.desc});
    }
}
        ", "pgsql_cancel"), "pgsql_cancel_test");

        background p.callFunction("runQuery", resultQueue, pgsql_connstr);

        auto connected = resultQueue.get(10s);
        assertEq("connected", connected, "Connected to PostgreSQL");

        # Give time for the query to start executing
        usleep(500ms);

        # Request interrupt - this should trigger PQcancel via the cancel callback
        sm.requestInterrupt();

        # Wait for the result
        hash<auto> result = resultQueue.get(5s);
        assertEq(True, result.cancelled, "PostgreSQL query was cancelled");
        # The error could be PROGRAM-INTERRUPTED or a database-specific cancellation error
        assertEq(True, exists result.err, "Exception was thrown: " + result.err);
    }

    #! Test PostgreSQL cancel when query is blocked on server
    testPgsqlBlockedCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        try {
            p.loadModule("pgsql");
        } catch (hash<ExceptionInfo> ex) {
            testSkip("PostgreSQL module not available: " + ex.desc);
            return;
        }

        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runBlockingQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    q.push('connected');

    try {
        # This will block waiting for a lock that will never be released
        # We use pg_advisory_lock which blocks until lock is available
        # First, we take the lock in another session would cause blocking
        # For simplicity, just use pg_sleep which is a blocking operation
        ds.exec('SELECT pg_sleep(60)');
        q.push({'cancelled': False});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'cancelled': True, 'err': ex.err});
    }
}
        ", "pgsql_blocked"), "pgsql_blocked_test");

        background p.callFunction("runBlockingQuery", resultQueue, pgsql_connstr);

        auto connected = resultQueue.get(10s);
        assertEq("connected", connected, "Connected to PostgreSQL");

        # Wait for query to be fully blocked on server
        usleep(1s);

        # Request interrupt
        sm.requestInterrupt();

        # Should return quickly after cancel
        hash<auto> result = resultQueue.get(5s);
        assertEq(True, result.cancelled, "Blocked PostgreSQL query was cancelled");
    }

    #! Test Oracle cancel callback
    testOracleCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        try {
            p.loadModule("oracle");
        } catch (hash<ExceptionInfo> ex) {
            testSkip("Oracle module not available: " + ex.desc);
            return;
        }

        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    q.push('connected');

    try {
        # DBMS_LOCK.SLEEP requires execute privilege on DBMS_LOCK
        # Use a simpler approach - a long-running query
        ds.exec('BEGIN DBMS_SESSION.SLEEP(10); END;');
        q.push({'cancelled': False});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'cancelled': True, 'err': ex.err, 'desc': ex.desc});
    }
}
        ", "oracle_cancel"), "oracle_cancel_test");

        background p.callFunction("runQuery", resultQueue, oracle_connstr);

        auto connected = resultQueue.get(10s);
        assertEq("connected", connected, "Connected to Oracle");

        usleep(500ms);
        sm.requestInterrupt();

        hash<auto> result = resultQueue.get(5s);
        assertEq(True, result.cancelled, "Oracle query was cancelled");
    }

    testOracleBlockedCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        try {
            p.loadModule("oracle");
        } catch (hash<ExceptionInfo> ex) {
            testSkip("Oracle module not available: " + ex.desc);
            return;
        }

        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runBlockingQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    q.push('connected');

    try {
        ds.exec('BEGIN DBMS_SESSION.SLEEP(60); END;');
        q.push({'cancelled': False});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'cancelled': True, 'err': ex.err});
    }
}
        ", "oracle_blocked"), "oracle_blocked_test");

        background p.callFunction("runBlockingQuery", resultQueue, oracle_connstr);

        auto connected = resultQueue.get(10s);
        assertEq("connected", connected, "Connected to Oracle");

        usleep(1s);
        sm.requestInterrupt();

        hash<auto> result = resultQueue.get(5s);
        assertEq(True, result.cancelled, "Blocked Oracle query was cancelled");
    }

    #! Test Sybase/FreeTDS cancel callback
    testSybaseCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        try {
            p.loadModule("sybase");
        } catch (hash<ExceptionInfo> ex) {
            testSkip("Sybase module not available: " + ex.desc);
            return;
        }

        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    q.push('connected');

    try {
        # WAITFOR DELAY is Sybase/SQL Server's equivalent of sleep
        ds.exec('WAITFOR DELAY ''00:00:10''');
        q.push({'cancelled': False});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'cancelled': True, 'err': ex.err, 'desc': ex.desc});
    }
}
        ", "sybase_cancel"), "sybase_cancel_test");

        background p.callFunction("runQuery", resultQueue, sybase_connstr);

        auto connected = resultQueue.get(10s);
        assertEq("connected", connected, "Connected to Sybase");

        usleep(500ms);
        sm.requestInterrupt();

        hash<auto> result = resultQueue.get(5s);
        assertEq(True, result.cancelled, "Sybase query was cancelled");
    }

    testSybaseBlockedCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        try {
            p.loadModule("sybase");
        } catch (hash<ExceptionInfo> ex) {
            testSkip("Sybase module not available: " + ex.desc);
            return;
        }

        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runBlockingQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    q.push('connected');

    try {
        ds.exec('WAITFOR DELAY ''00:01:00''');
        q.push({'cancelled': False});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'cancelled': True, 'err': ex.err});
    }
}
        ", "sybase_blocked"), "sybase_blocked_test");

        background p.callFunction("runBlockingQuery", resultQueue, sybase_connstr);

        auto connected = resultQueue.get(10s);
        assertEq("connected", connected, "Connected to Sybase");

        usleep(1s);
        sm.requestInterrupt();

        hash<auto> result = resultQueue.get(5s);
        assertEq(True, result.cancelled, "Blocked Sybase query was cancelled");
    }

    #! Test MySQL cancel - note: MySQL cancel may require async API implementation
    testMysqlCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        try {
            p.loadModule("mysql");
        } catch (hash<ExceptionInfo> ex) {
            testSkip("MySQL module not available: " + ex.desc);
            return;
        }

        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    q.push('connected');

    try {
        # MySQL's SLEEP function
        ds.exec('SELECT SLEEP(10)');
        q.push({'cancelled': False});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'cancelled': True, 'err': ex.err, 'desc': ex.desc});
    }
}
        ", "mysql_cancel"), "mysql_cancel_test");

        background p.callFunction("runQuery", resultQueue, mysql_connstr);

        auto connected = resultQueue.get(10s);
        assertEq("connected", connected, "Connected to MySQL");

        usleep(500ms);
        sm.requestInterrupt();

        # MySQL may not support true cancellation without async API
        # Check if we get a result within reasonable time
        hash<auto> result;
        try {
            result = resultQueue.get(5s);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "QUEUE-TIMEOUT") {
                testSkip("MySQL cancel not implemented - requires async API");
                return;
            }
            rethrow;
        }
        assertEq(True, result.cancelled, "MySQL query was cancelled");
    }
}
