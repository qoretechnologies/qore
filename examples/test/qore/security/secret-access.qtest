#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - all checks run in workers with explicit execution modes or as qcc executables
# test-platform: macos - JIT and AOT code generation of calls into module Programs, and the frames of compiled code

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm
%exec-class SecretAccessTest

#! SandboxManager::checkSecretAccess() (qore#7863)
/** A library class that gives a secret that an object holds calls the method with the object's owner: the owner, code
    that is not restricted and not a tenant, and the code of a library module that acts for its caller get the secret;
    code that a sandbox restricts and a tenant (a governing sandbox with an isolation domain) are refused when they call
    the method themselves, also through call_object_method(), a call reference of their own, a callback that library
    code calls, and a module that they loaded by its path (which is not library code).  The checks are in
    secret-access/secret-access-worker.q, which is run in each execution mode, with the library module compiled to an
    AOT module, and as a program compiled with qcc.
*/
class SecretAccessTest inherits QUnit::Test {
    public {
        #! the output of the worker: the same in every mode
        const Expected = (
            "host ok",
            "restricted-direct PERMISSION-DENIED",
            "restricted-provider ok",
            "restricted-provider-twice ok",
            "restricted-provider-by-name ok",
            "restricted-call-object-method PERMISSION-DENIED",
            "restricted-call-ref PERMISSION-DENIED",
            "restricted-callback PERMISSION-DENIED",
            "restricted-own-holder ok",
            "restricted-path-module PERMISSION-DENIED",
            "tenant-direct PERMISSION-DENIED",
            "tenant-provider ok",
            "tenant-provider-twice ok",
            "tenant-provider-by-name ok",
            "tenant-call-object-method PERMISSION-DENIED",
            "tenant-call-ref PERMISSION-DENIED",
            "tenant-callback PERMISSION-DENIED",
            "tenant-own-holder ok",
            "tenant-path-module PERMISSION-DENIED",
        );
    }

    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        *string qcc_bin = TestInterpreter::qcc_compiler();
        string dir = get_script_dir() + DirSep + "secret-access";
        string prefix;
    }

    constructor() : QUnit::Test("SecretAccessTest", "1.0", \ARGV) {
        # secret-access/lib is a trusted module directory: the modules there are library code (qore#7077)
        prefix = makePrefix(dir + DirSep + "lib");
        addTestCase("each execution mode", \testModes());
        addTestCase("AOT library module", \testAotModule());
        addTestCase("qcc executables", \testCompiled());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private static string expectedOutput() {
        return (map $1 + "\n", Expected).join("");
    }

    #! the environment of a run, with \a lib as a trusted module directory
    private string makePrefix(string lib) {
        return "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir) + " QORE_LIBDIR="
            + quote(libdir) + " QORE_MODULE_DIR=" + quote(lib) + ":$QORE_MODULE_DIR ";
    }

    testModes() {
        string worker = quote(dir + DirSep + "secret-access-worker.q");
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expectedOutput(), ExecModeHarness::run(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode="
                + mode + " " + worker, ExecModeHarness::NativeCheck::None), mode);
        }
        assertEq(expectedOutput(), ExecModeHarness::run_ir_tier(prefix + quote(qore_bin)
            + " -b --enable-debug --exec-mode=tiered " + worker), ExecModeHarness::IRTierName);
    }

    #! the library module compiled with qcc -m: its code runs as native code of its own Program
    testAotModule() {
        if (!qcc_bin) {
            testSkip("qcc is not available");
        }
        TmpDir tmp("qore-secret-access-");
        foreach string f in (("SecretAccessPath.qm", "SecretAccessPathT.qm", "secret-access-worker.q")) {
            copy_file(dir + DirSep + f, tmp.path + DirSep + f);
        }
        # the library module, in a trusted module directory of its own
        string lib = tmp.path + DirSep + "lib";
        mkdir(lib);
        copy_file(dir + DirSep + "lib" + DirSep + "SecretAccessLib.qm", lib + DirSep + "SecretAccessLib.qm");
        string aot_prefix = makePrefix(lib);
        ExecModeHarness::run_any(sprintf("cd %s && QORE_MODULE_DIR=%s:$QORE_MODULE_DIR %s%s -m -o SecretAccessLib.qmod "
            "SecretAccessLib.qm", quote(lib), quote(lib), aot_prefix, quote(qcc_bin)));
        assertTrue(is_file(lib + DirSep + "SecretAccessLib.qmod"), "SecretAccessLib.qmod was compiled");
        string worker = quote(tmp.path + DirSep + "secret-access-worker.q");
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(expectedOutput(), ExecModeHarness::run(aot_prefix + quote(qore_bin)
                + " -b --enable-debug --exec-mode=" + mode + " " + worker, ExecModeHarness::NativeCheck::None),
                "AOT module, " + mode);
        }
    }

    #! the worker compiled with qcc
    testCompiled() {
        if (!qcc_bin) {
            testSkip("qcc is not available");
        }
        TmpDir tmp("qore-secret-access-exe-");
        foreach string f in (("SecretAccessPath.qm", "SecretAccessPathT.qm")) {
            copy_file(dir + DirSep + f, tmp.path + DirSep + f);
        }
        foreach string opt in (("-O0", "-O3")) {
            string exe = tmp.path + DirSep + "secret-access" + opt;
            ExecModeHarness::run_any(prefix + quote(qcc_bin) + " " + opt + " -o " + quote(exe) + " "
                + quote(dir + DirSep + "secret-access-worker.q"));
            assertTrue(is_file(exe), "qcc " + opt + " produced the executable");
            assertEq(expectedOutput(), ExecModeHarness::run_any(prefix + quote(exe) + " -b"), "qcc " + opt);
        }
    }
}
