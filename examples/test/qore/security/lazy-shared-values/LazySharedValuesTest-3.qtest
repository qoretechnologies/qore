# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - threads waiting on condition variables, trusted builds and AOT-compiled calls of builtin classes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%include LazySharedValuesTest.qc

%exec-class LazySharedValuesTestPart3

#! runs part 3 of 3 of the cases of LazySharedValuesTestBase: LazySharedValues.q and LazySharedModuleByPath.q in every execution mode and compiled with qcc
class LazySharedValuesTestPart3 inherits LazySharedValuesTestBase {
    constructor() : LazySharedValuesTestBase("LazySharedValuesTestPart3", 3) {
    }
}
