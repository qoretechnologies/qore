%modern

#! a library module (found in the module path), for secret-access.qtest (qore#7863)
module SecretAccessLib {
    version = "1.0";
    desc = "SandboxManager::checkSecretAccess() test library module";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
}

#! an object that holds a secret and gives it to its owner and to library code that acts for others
public class SalHolder {
    private:internal {
        *int owner = SandboxManager::getCallerProgramId();
    }
    private {
        string secret = "THE-SECRET";
    }

    string getSecret() {
        SandboxManager::checkSecretAccess(owner, "secret");
        return secret;
    }
}

#! library code that uses the secret of an object that it is given
public class SalProvider {
    #! the module acts for its caller
    string use(SalHolder h) {
        return h.getSecret();
    }

    #! the module calls the method through other module code
    string useTwice(SalHolder h) {
        return use(h);
    }

    #! the module calls a callable that its caller gave it: the callable is its caller's code
    string callback(code c) {
        return c();
    }

    #! the module calls the method with call_object_method(), as the code that it acts for
    string useByName(SalHolder h) {
        return call_object_method(h, "getSecret");
    }
}
