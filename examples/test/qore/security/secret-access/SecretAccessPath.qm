%modern
%requires SecretAccessLib

#! a module loaded by its path, not library code, for secret-access.qtest (qore#7863)
module SecretAccessPath {
    version = "1.0";
    desc = "SandboxManager::checkSecretAccess() test module loaded by path";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
}

public class SapUser {
    string use(SalHolder h) {
        return h.getSecret();
    }
}
