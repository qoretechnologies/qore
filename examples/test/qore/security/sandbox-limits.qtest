#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# SandboxManager resource limits (issue #5581): the wall-clock time and stack size limits of each call into a sandbox.
#
# A call starts when a thread enters code governed by the sandbox from code it does not govern; work the call
# continues on other threads shares its deadline; when the deadline passes, the threads of the call raise
# SANDBOX-TIMEOUT at their next cancellation point until they leave the call.  See
# design/sandbox-resource-limits.md.
#
# Every call that is expected to time out runs code that never ends on its own (a busy loop or a wait with no
# timeout), so the test never depends on how fast the machine is: a missing timeout hangs the test instead of
# passing it.  The only timing assertions are lower bounds: a call cannot end before its deadline.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires QUnit

%exec-class SandboxLimitsTest

class SandboxLimitsTest inherits QUnit::Test {
    public {
        #! the limit used by most tests, in milliseconds
        const Limit = 300;

        #! the description of the exception for the given limit
        const TimeoutDesc = "the sandbox wall time limit of %d ms was exceeded";

        #! the CPU time limit used by the tests, in milliseconds
        const CpuLimit = 300;

        #! the description of the CPU time exception for the given limit
        const CpuDesc = "the sandbox CPU time limit of %d ms was exceeded";

        #! the stack limit used by the tests, in bytes
        const StackLimit = 256 * 1024;

        #! the description of the stack exception for the given limit
        const StackDesc = "exceeded the sandbox stack size limit of %d bytes";

        #! the sandboxed code
        const SandboxCode = "
%modern
int sub spin_while() {
    int i = 0;
    while (True) {
        ++i;
    }
    return i;
}
int sub spin_for() {
    int i;
    for (i = 0; ; ++i) {
    }
    return i;
}
int sub spin_foreach() {
    int n = 0;
    foreach int i in (xrange(0, MAXINT)) {
        n += i;
    }
    return n;
}
int sub spin_do() {
    int i = 0;
    do {
        ++i;
    } while (True);
    return i;
}
int sub spin_recursive(int depth) {
    if (depth) {
        return spin_recursive(depth - 1);
    }
    return spin_while();
}
sub do_sleep() {
    sleep(3600);
}
sub queue_get() {
    Queue q();
    q.get();
}
sub counter_wait() {
    Counter c(1);
    c.waitForZero();
}
sub condition_wait() {
    Mutex m();
    Condition c();
    m.lock();
    on_exit m.unlock();
    c.wait(m);
}
sub mutex_lock(Mutex m) {
    m.lock();
}
string sub quick() {
    return \"done\";
}
string sub nap(int ms) {
    usleep(ms * 1000);
    return \"rested\";
}
# signals the host and then spins
int sub signal_and_spin(Queue started) {
    started.push(True);
    return spin_while();
}
# returns the value pushed by the host
auto sub wait_for(Queue q) {
    return q.get();
}
# catches the timeout and tries to go on
int sub catch_and_continue(reference<int> catches) {
    try {
        spin_while();
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != \"SANDBOX-TIMEOUT\") {
            rethrow;
        }
        ++catches;
        # clearing the thread's cancellation request does not clear a sandbox limit
        clear_thread_cancel();
        # cancellation deferral is for cleanup code: a deferred cleanup runs to its end
        defer_thread_cancel(sub () {
            for (int i = 0; i < 10; ++i) {
                ++catches;
            }
        });
    }
    # the timeout is raised again at the next cancellation point
    return spin_while();
}
# re-enters the sandbox through trusted code, after spending most of the limit
int sub reenter(code callback, int ms) {
    usleep(ms * 1000);
    return callback();
}
# calls the trusted code
auto sub call(code c) {
    return c();
}
# calls the trusted code and returns the error it raised
string sub call_catch(code c) {
    try {
        c();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
    return \"no error\";
}
# starts a thread that spins and reports the exception that ends it
sub spin_in_background(Queue result) {
    background sub () {
        try {
            spin_while();
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex.err);
        }
    }();
}
# submits a task that spins and reports the exception that ends it
sub spin_in_task(Queue result) {
    AsyncIoController::submitTask(sub () {
        try {
            spin_while();
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex.err);
        }
    });
}
# submits a task to a thread pool that spins and reports the exception that ends it
sub spin_in_pool(Qore::Thread::ThreadPool pool, Queue result) {
    pool.submit(sub () {
        try {
            spin_while();
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex.err);
        }
    });
}
# starts threads that spin and report the exception that ends them; returns the number of threads started, which is
# less than n if the call timed out while it was starting them
int sub spin_threads(int n, Queue result) {
    int started = 0;
    try {
        for (; started < n; ++started) {
            background sub () {
                try {
                    spin_while();
                } catch (hash<ExceptionInfo> ex) {
                    result.push(ex.err);
                }
            }();
        }
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != \"SANDBOX-TIMEOUT\") {
            rethrow;
        }
    }
    return started;
}
# recurses without end
int sub recurse(int n) {
    return recurse(n + 1);
}
# recurses as deep as the stack allows and returns the depth reached
int sub max_depth(int n) {
    try {
        return max_depth(n + 1);
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != \"STACK-LIMIT-EXCEEDED\") {
            rethrow;
        }
        return n;
    }
}
# recurses to the given depth and then calls the trusted code
auto sub recurse_then_call(int n, code c) {
    if (n) {
        return recurse_then_call(n - 1, c);
    }
    return c();
}
# recurses without end in a new thread and reports the exception that ends it
sub recurse_in_background(Queue result) {
    background sub () {
        try {
            recurse(0);
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex.desc);
        }
    }();
}
# starts a thread that spins and reports the exception that ends it
sub report_in_background(Queue result) {
    background sub () {
        try {
            spin_while();
            result.push(NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex);
        }
    }();
}
# calls the trusted code, then starts a thread that spins and reports the exception that ends it
sub call_then_report_in_background(code c, Queue result) {
    c();
    report_in_background(result);
}
# starts threads that spin and waits for their results; the waiting thread uses (almost) no CPU time
list<string> sub spin_threads_and_wait(int n) {
    Queue result();
    for (int i = 0; i < n; ++i) {
        background sub () {
            try {
                spin_while();
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex.err);
            }
        }();
    }
    list<string> errs = ();
    for (int i = 0; i < n; ++i) {
        errs += result.get();
    }
    return errs;
}
# runs two tasks one after the other on a one-thread pool: the first uses CPU time, the second starts after the first
# has left the call; each reports the CPU time of the call as the watchdog measures it
list<int> sub cpu_across_tasks(Qore::Thread::ThreadPool pool, int iterations) {
    Queue q();
    pool.submit(sub () {
        int n = 0;
        for (int i = 0; i < iterations; ++i) {
            n += i;
        }
        q.push(call_function(\"dbg_sandbox_cpu_used\"));
    });
    pool.submit(sub () {
        q.push(call_function(\"dbg_sandbox_cpu_used\"));
    });
    return (q.get(), q.get());
}
class Spinner {
    int spin() {
        return spin_while();
    }
    string quick() {
        return \"object done\";
    }
}
Spinner sub get_spinner() {
    return new Spinner();
}
code sub get_closure() {
    return auto sub (bool forever) {
        if (forever) {
            return spin_while();
        }
        return \"closure done\";
    };
}
";
    }

    constructor() : QUnit::Test("SandboxLimitsTest", "1.0", \ARGV) {
        addTestCase("CPU time limit API", \testCpuApi());
        addTestCase("the CPU time limit stops busy code", \testCpuLoop());
        addTestCase("waiting uses no CPU time", \testCpuWaiting());
        addTestCase("the CPU time of all threads of a call counts", \testCpuThreads());
        addTestCase("the CPU time of a thread that left the call still counts", \testCpuDetached());
        addTestCase("stack limit API", \testStackApi());
        addTestCase("a call whose limits cannot be tracked fails naming those limits", \testFailClosed());
        addTestCase("the stack limit bounds recursion", \testStackRecursion());
        addTestCase("a re-entry does not restart the stack measurement", \testStackReentry());
        addTestCase("the stack limit applies to threads the call starts and to nested sandboxes",
            \testStackContinuations());
        addTestCase("wall time limit API", \testApi());
        addTestCase("busy loops end at the deadline", \testBusyLoops());
        addTestCase("blocked waits end at the deadline", \testBlockedWaits());
        addTestCase("each call has its own deadline", \testPerCall());
        addTestCase("the timeout cannot be caught and ignored", \testCatchAndContinue());
        addTestCase("a re-entry keeps the original deadline", \testReentry());
        addTestCase("work started by the call shares its deadline", \testContinuations());
        addTestCase("a timeout ends only the call that exceeded its limit", \testConcurrentCalls());
        addTestCase("all threads of a call end at the deadline", \testManyThreads());
        addTestCase("nested sandboxes", \testNested());
        addTestCase("code created in the sandbox runs as a new call", \testProvenance());
        addTestCase("no limit, no timeout", \testNoLimit());
        set_return_value(main());
    }

    #! returns a Program with the given sandbox manager and the sandboxed code
    private Program sandboxed(SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.parse(SandboxCode, "sandboxed");
        return p;
    }

    #! returns a sandbox manager with the given wall time limit
    private SandboxManager limited(int ms = Limit) {
        SandboxManager sm();
        sm.setWallTimeLimit(ms);
        return sm;
    }

    #! calls a function that must time out, checks the exception and the elapsed time, and returns the elapsed time
    private int expectTimeout(Program p, string func, softlist<auto> args = (), int limit = Limit) {
        int start = clock_get_monotonic_us();
        try {
            p.callFunctionArgs(func, args);
            fail(sprintf("%s() returned instead of timing out", func));
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SANDBOX-TIMEOUT", ex.err, sprintf("%s(): %s: %s", func, ex.err, ex.desc));
            assertRegex(sprintf(TimeoutDesc, limit), ex.desc, func + "() description");
            assertEq({"wall_time_limit": limit}, ex.arg, func + "() exception argument");
        }
        int elapsed = (clock_get_monotonic_us() - start) / 1000;
        assertGe(limit, elapsed, func + "() cannot time out before its deadline");
        return elapsed;
    }

    testApi() {
        SandboxManager sm();
        assertEq(0, sm.getWallTimeLimit(), "no limit by default");
        sm.setWallTimeLimit(1500);
        assertEq(1500, sm.getWallTimeLimit());
        assertEq(1500, sm.getConfiguration().wall_time_limit, "configuration key");
        assertEq(("filesystem", "network", "max_threads", "wall_time_limit", "cpu_time_limit", "max_stack_size",
            "interrupt_requested"), keys sm.getConfiguration(), "configuration keys");
        sm.setWallTimeLimit(max_wall_time_ms: 2500);
        assertEq(2500, sm.getWallTimeLimit(), "named argument");

        SandboxManager copy = sm.copy();
        assertEq(2500, copy.getWallTimeLimit(), "copy() copies the limit");
        sm.setWallTimeLimit(10);
        assertEq(2500, copy.getWallTimeLimit(), "the copy is independent");

        sm.setWallTimeLimit(0);
        assertEq(0, sm.getWallTimeLimit(), "0 removes the limit");

        assertThrows("SANDBOX-CONFIG-ERROR", "cannot be negative", \sm.setWallTimeLimit(), -1);
        assertEq(0, sm.getWallTimeLimit(), "a rejected value does not change the limit");

        assertEq(5000, SandboxManager::createLockdown().getWallTimeLimit(), "lockdown preset");
        assertEq(30000, SandboxManager::createWebSafe().getWallTimeLimit(), "web-safe preset");
    }

    #! returns a sandbox manager with the given CPU time limit
    private SandboxManager cpuLimited(int ms = CpuLimit) {
        SandboxManager sm();
        sm.setCPUTimeLimit(ms);
        return sm;
    }

    #! checks that an exception is the CPU time timeout
    private checkCpuTimeout(hash<ExceptionInfo> ex, string label) {
        assertEq("SANDBOX-TIMEOUT", ex.err, sprintf("%s: %s: %s", label, ex.err, ex.desc));
        assertRegex(sprintf(CpuDesc, CpuLimit), ex.desc, label);
        assertEq({"cpu_time_limit": CpuLimit}, ex.arg, label + ": exception argument");
    }

    testCpuApi() {
        SandboxManager sm();
        assertEq(0, sm.getCPUTimeLimit(), "no limit by default");
        sm.setCPUTimeLimit(1500);
        assertEq(1500, sm.getCPUTimeLimit());
        assertEq(1500, sm.getConfiguration().cpu_time_limit, "configuration key");
        sm.setCPUTimeLimit(max_cpu_time_ms: 2500);
        assertEq(2500, sm.getCPUTimeLimit(), "named argument");
        SandboxManager copy = sm.copy();
        assertEq(2500, copy.getCPUTimeLimit(), "copy() copies the limit");
        sm.setCPUTimeLimit(0);
        assertEq(0, sm.getCPUTimeLimit(), "0 removes the limit");
        assertEq(2500, copy.getCPUTimeLimit(), "the copy is independent");
        assertThrows("SANDBOX-CONFIG-ERROR", "cannot be negative", \sm.setCPUTimeLimit(), -1);
        assertEq(0, sm.getCPUTimeLimit(), "a rejected value does not change the limit");
        assertEq(1000, SandboxManager::createLockdown().getCPUTimeLimit(), "lockdown preset");
        assertEq(10000, SandboxManager::createWebSafe().getCPUTimeLimit(), "web-safe preset");
    }

    testCpuLoop() {
        Program p = sandboxed(cpuLimited());
        foreach string func in ("spin_while", "spin_foreach") {
            int start = clock_get_monotonic_us();
            try {
                p.callFunction(func);
                fail(func + "() returned");
            } catch (hash<ExceptionInfo> ex) {
                checkCpuTimeout(ex, func + "()");
            }
            # a thread cannot use more CPU time than wall-clock time
            assertGe(CpuLimit, (clock_get_monotonic_us() - start) / 1000, func + "() cannot time out early");
        }
        assertEq("done", p.callFunction("quick"), "the next call is not affected");
    }

    testCpuWaiting() {
        # a call that sleeps for three times its CPU time limit completes
        Program p = sandboxed(cpuLimited());
        assertEq("rested", p.callFunction("nap", CpuLimit * 3));
    }

    testCpuThreads() {
        # the calling thread waits (using almost no CPU time) while the threads it started spin: only their CPU time
        # can use up the limit, so without it the call would never end
        Program p = sandboxed(cpuLimited());
        try {
            list<string> errs = p.callFunction("spin_threads_and_wait", 4);
            # the waiting thread received every result before it saw the timeout itself
            assertEq(("SANDBOX-TIMEOUT",) * 4, errs);
        } catch (hash<ExceptionInfo> ex) {
            checkCpuTimeout(ex, "the waiting thread");
        }
    }

    testCpuDetached() {
        # the measurement needs a debug hook
        try {
            call_function("dbg_sandbox_cpu_used");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "NO-FUNCTION" || ex.err == "UNDEFINED-FUNCTION-CALL") {
                testSkip("dbg_sandbox_cpu_used() is only available in debug builds");
            }
            rethrow;
        }
        assertEq(-1, call_function("dbg_sandbox_cpu_used"), "no call with a CPU time limit");
        Program p = sandboxed(cpuLimited(120000));
        Qore::Thread::ThreadPool pool(1);
        on_exit pool.stopWait();
        list<int> used = p.callFunction("cpu_across_tasks", pool, 200000);
        assertGt(0, used[0], "the first task used CPU time");
        assertGe(used[0], used[1], "the CPU time of the first task still counts after it has left the call");
    }

    #! returns a sandbox manager with the given stack limit
    private SandboxManager stackLimited(int bytes = StackLimit) {
        SandboxManager sm();
        sm.setMaxStackSize(bytes);
        return sm;
    }

    testStackApi() {
        SandboxManager sm();
        assertEq(0, sm.getMaxStackSize(), "no limit by default");
        sm.setMaxStackSize(65536);
        assertEq(65536, sm.getMaxStackSize());
        assertEq(65536, sm.getConfiguration().max_stack_size, "configuration key");
        sm.setMaxStackSize(max_stack_bytes: 131072);
        assertEq(131072, sm.getMaxStackSize(), "named argument");
        SandboxManager copy = sm.copy();
        assertEq(131072, copy.getMaxStackSize(), "copy() copies the limit");
        sm.setMaxStackSize(0);
        assertEq(0, sm.getMaxStackSize(), "0 removes the limit");
        assertEq(131072, copy.getMaxStackSize(), "the copy is independent");
        assertThrows("SANDBOX-CONFIG-ERROR", "cannot be negative", \sm.setMaxStackSize(), -1);
        assertEq(0, sm.getMaxStackSize(), "a rejected value does not change the limit");
        assertEq(1024 * 1024, SandboxManager::createLockdown().getMaxStackSize(), "lockdown preset");
        assertEq(2 * 1024 * 1024, SandboxManager::createWebSafe().getMaxStackSize(), "web-safe preset");
    }

    testStackRecursion() {
        Program p = sandboxed(stackLimited());
        try {
            p.callFunction("recurse", 0);
            fail("no exception");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("STACK-LIMIT-EXCEEDED", ex.err);
            assertRegex(sprintf(StackDesc, StackLimit), ex.desc);
            assertEq({"max_stack_size": StackLimit}, ex.arg, "the exception argument names the limit");
        }
        # recursion within the limit is allowed
        int depth = p.callFunction("max_depth", 0);
        assertGe(10, depth, "a moderate depth is allowed");
        assertEq("done", p.callFunctionArgs("recurse_then_call", (depth / 2, auto sub () { return "done"; })));
        # without the limit, the same code reaches a much greater depth: the thread's own limit
        Program unlimited = sandboxed(new SandboxManager());
        assertGt(depth * 4, unlimited.callFunction("max_depth", 0), "the thread's own stack allows more");
        # and the host's stack limit is restored after the call
        assertEq("done", unlimited.callFunctionArgs("recurse_then_call", (depth * 4, auto sub () { return "done"; })));
    }

    testStackReentry() {
        # the sandbox uses most of its stack, then re-enters itself through trusted code: the re-entered code only has
        # the rest, where a new measurement would give it the whole limit again
        Program p = sandboxed(stackLimited());
        int depth = p.callFunction("max_depth", 0);
        code callback = auto sub () { return p.callFunction("max_depth", 0); };
        int reentered = p.callFunctionArgs("recurse_then_call", (depth * 2 / 3, callback));
        assertLt(depth * 3 / 4, reentered, sprintf("the re-entry kept the original measurement (full depth %d)",
            depth));
    }

    testStackContinuations() {
        Program p = sandboxed(stackLimited());
        Queue result();
        p.callFunction("recurse_in_background", result);
        assertRegex(sprintf(StackDesc, StackLimit), result.get(), "a thread started by the call");

        # the outer limit applies in an inner sandbox that has no stack limit of its own
        Program inner = sandboxed(new SandboxManager());
        code call_inner = auto sub () { return inner.callFunction("recurse", 0); };
        try {
            p.callFunction("call", call_inner);
            fail("no exception");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("STACK-LIMIT-EXCEEDED", ex.err);
            assertRegex(sprintf(StackDesc, StackLimit), ex.desc, "the outer limit in the inner sandbox");
        }
    }

    #! calls a function after making the next budget recording fail, and returns the exception it raised
    private hash<ExceptionInfo> failClosed(Program p, string func, softlist<auto> args = ()) {
        call_function("dbg_sandbox_fail_next_budgets", 1);
        on_exit call_function("dbg_sandbox_fail_next_budgets", 0);
        try {
            p.callFunctionArgs(func, args);
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        throw "TEST-ERROR", func + "() returned";
    }

    testFailClosed() {
        # the hook that makes a budget recording fail exists in debug builds only
        try {
            call_function("dbg_sandbox_fail_next_budgets", 0);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "NO-FUNCTION" || ex.err == "UNDEFINED-FUNCTION-CALL") {
                testSkip("dbg_sandbox_fail_next_budgets() is only available in debug builds");
            }
            rethrow;
        }
        string tail = " cannot be enforced for this call: the resources to track %s could not be allocated";

        # a wall time limit: the next cancellation point fails
        Program p = sandboxed(limited());
        hash<ExceptionInfo> ex = failClosed(p, "spin_while");
        assertEq("SANDBOX-ERROR", ex.err, ex.desc);
        assertRegex("the sandbox wall time limit of " + Limit + " ms" + sprintf(tail, "it"), ex.desc);
        assertEq({"wall_time_limit": Limit}, ex.arg);
        # the failure ends with the call
        assertEq("done", p.callFunction("quick"), "the next call is not affected");

        # a stack limit: recursion, which has no cancellation point, fails at its next call
        p = sandboxed(stackLimited());
        ex = failClosed(p, "recurse", 0);
        assertEq("SANDBOX-ERROR", ex.err, ex.desc);
        assertRegex("the sandbox stack size limit of " + StackLimit + " bytes" + sprintf(tail, "it"), ex.desc);
        assertEq({"max_stack_size": StackLimit}, ex.arg);
        assertGe(10, p.callFunction("max_depth", 0), "the next call has its stack again");

        # both limits
        SandboxManager sm = limited();
        sm.setMaxStackSize(StackLimit);
        p = sandboxed(sm);
        ex = failClosed(p, "spin_while");
        assertEq("SANDBOX-ERROR", ex.err, ex.desc);
        assertRegex("the sandbox wall time limit of " + Limit + " ms and the sandbox stack size limit of "
            + StackLimit + " bytes" + sprintf(tail, "them"), ex.desc);
        assertEq({"wall_time_limit": Limit, "max_stack_size": StackLimit}, ex.arg);

        # a CPU time limit
        p = sandboxed(cpuLimited());
        ex = failClosed(p, "spin_while");
        assertEq("SANDBOX-ERROR", ex.err, ex.desc);
        assertRegex("the sandbox CPU time limit of " + CpuLimit + " ms" + sprintf(tail, "it"), ex.desc);
        assertEq({"cpu_time_limit": CpuLimit}, ex.arg);

        # all limits
        sm = limited();
        sm.setCPUTimeLimit(CpuLimit);
        sm.setMaxStackSize(StackLimit);
        p = sandboxed(sm);
        ex = failClosed(p, "spin_while");
        assertEq("SANDBOX-ERROR", ex.err, ex.desc);
        assertRegex("the sandbox wall time limit of " + Limit + " ms, the sandbox CPU time limit of " + CpuLimit
            + " ms and the sandbox stack size limit of " + StackLimit + " bytes" + sprintf(tail, "them"), ex.desc);
        assertEq({"wall_time_limit": Limit, "cpu_time_limit": CpuLimit, "max_stack_size": StackLimit}, ex.arg);

        # a thread that continues a call and cannot record its budget
        p = sandboxed(limited(120000));
        Queue result();
        code arm = sub () { call_function("dbg_sandbox_fail_next_budgets", 1); };
        p.callFunction("call_then_report_in_background", arm, result);
        ex = result.get();
        assertEq("SANDBOX-ERROR", ex.err, ex.desc);
        assertRegex("the sandbox wall time limit of 120000 ms" + sprintf(tail, "it"), ex.desc);
        assertEq({"wall_time_limit": 120000}, ex.arg);

        # a thread started by a call that failed closed: the limits are known, their values are not
        p = sandboxed(limited());
        call_function("dbg_sandbox_fail_next_budgets", 1);
        {
            on_exit call_function("dbg_sandbox_fail_next_budgets", 0);
            # the call returns before it reaches a cancellation point
            p.callFunction("report_in_background", result);
        }
        ex = result.get();
        assertEq("SANDBOX-ERROR", ex.err, ex.desc);
        assertRegex("the sandbox wall time limit" + sprintf(tail, "it"), ex.desc);
        assertEq({"wall_time_limit": NOTHING}, ex.arg);
    }

    testBusyLoops() {
        Program p = sandboxed(limited());
        foreach string func in ("spin_while", "spin_for", "spin_foreach", "spin_do") {
            expectTimeout(p, func);
        }
        expectTimeout(p, "spin_recursive", 50);
    }

    testBlockedWaits() {
        Program p = sandboxed(limited());
        foreach string func in ("do_sleep", "queue_get", "counter_wait", "condition_wait") {
            expectTimeout(p, func);
        }
        # a lock held by another thread
        Mutex m();
        Queue locked();
        Queue release();
        background sub () {
            m.lock();
            on_exit m.unlock();
            locked.push(True);
            release.get();
        }();
        locked.get();
        on_exit release.push(True);
        expectTimeout(p, "mutex_lock", m);
    }

    testPerCall() {
        # each call gets the whole limit: three calls that each use more than a third of it all complete
        Program p = sandboxed(limited(1500));
        for (int i = 0; i < 3; ++i) {
            assertEq("rested", p.callFunction("nap", 600), "call " + i);
        }
        # a call after a timed-out call is not affected by it
        expectTimeout(p, "spin_while", NOTHING, 1500);
        assertEq("done", p.callFunction("quick"), "a call after a timeout");
        # nor is the host thread, which left the call
        assertFalse(thread_cancelled(), "the host thread is not cancelled");
        int n = 0;
        for (int i = 0; i < 1000; ++i) {
            ++n;
        }
        usleep(1);
        assertEq(1000, n, "the host continues after the timeout");
    }

    testCatchAndContinue() {
        Program p = sandboxed(limited());
        int catches = 0;
        int start = clock_get_monotonic_us();
        try {
            p.callFunction("catch_and_continue", \catches);
            fail("catch_and_continue() returned");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SANDBOX-TIMEOUT", ex.err, ex.desc);
        }
        assertGe(Limit, (clock_get_monotonic_us() - start) / 1000);
        # the first catch, then the deferred cleanup's loop, whose checks are deferred
        assertEq(11, catches, "the timeout was caught once, and the deferred cleanup ran to its end");
    }

    testReentry() {
        # the sandbox re-enters itself through trusted code, which first raises the limit to two minutes: a call
        # that started then would have the long limit, so only the original deadline can end the re-entered loop
        SandboxManager sm = limited();
        Program p = sandboxed(sm);
        code callback = auto sub () {
            sm.setWallTimeLimit(120000);
            return p.callFunction("spin_while");
        };
        expectTimeout(p, "reenter", (callback, 0));
    }

    testContinuations() {
        Program p = sandboxed(limited());
        Queue result();
        # the calls return at once; the work they started ends at their deadlines
        p.callFunction("spin_in_background", result);
        assertEq("SANDBOX-TIMEOUT", result.get(), "a background thread shares the deadline");
        p.callFunction("spin_in_task", result);
        assertEq("SANDBOX-TIMEOUT", result.get(), "an async I/O task shares the deadline");
        # a pool owned by the host: its worker serves the sandbox's task under the sandbox's call budget
        Qore::Thread::ThreadPool pool(1);
        on_exit pool.stopWait();
        p.callFunction("spin_in_pool", pool, result);
        assertEq("SANDBOX-TIMEOUT", result.get(), "a thread pool task shares the deadline");
    }

    testConcurrentCalls() {
        SandboxManager sm = limited();
        Program p = sandboxed(sm);
        # the first call spins with the short limit
        Queue started();
        Queue first();
        background sub () {
            try {
                p.callFunction("signal_and_spin", started);
                first.push("no error");
            } catch (hash<ExceptionInfo> ex) {
                first.push(ex.err);
            }
        }();
        started.get();
        # the second call starts with a long limit (a limit applies to the calls that start after it is set), and
        # waits until the first one has timed out
        sm.setWallTimeLimit(120000);
        Queue go();
        Queue second();
        background sub () {
            try {
                second.push(p.callFunction("wait_for", go));
            } catch (hash<ExceptionInfo> ex) {
                second.push(ex.err);
            }
        }();
        assertEq("SANDBOX-TIMEOUT", first.get(), "the first call timed out");
        go.push("second done");
        assertEq("second done", second.get(), "the second call was not affected");
    }

    testManyThreads() {
        Program p = sandboxed(limited());
        Queue result();
        int started = p.callFunction("spin_threads", 8, result);
        assertGe(1, started, "threads were started");
        for (int i = 0; i < started; ++i) {
            assertEq("SANDBOX-TIMEOUT", result.get(), "thread " + i);
        }
    }

    testNested() {
        # the outer deadline stops code running in an inner sandbox that has no limit of its own
        Program outer = sandboxed(limited());
        Program inner = sandboxed(new SandboxManager());
        code call_inner = auto sub () { return inner.callFunction("spin_while"); };
        expectTimeout(outer, "call", call_inner);

        # an inner limit applies on its own; once the inner call has ended, the outer call goes on
        Program outer2 = sandboxed(limited(120000));
        Program inner2 = sandboxed(limited());
        code call_inner2 = auto sub () { return inner2.callFunction("spin_while"); };
        assertEq("SANDBOX-TIMEOUT", outer2.callFunction("call_catch", call_inner2),
            "the inner call timed out and the outer call continued");
        assertEq("done", outer2.callFunction("quick"));
    }

    testProvenance() {
        Program p = sandboxed(limited());
        code closure = p.callFunction("get_closure");
        object spinner = p.callFunction("get_spinner");
        # let the deadline of the calls that created them pass
        expectTimeout(p, "spin_while");
        # a call from the host is a new call: it has its own deadline, and the expired one does not apply
        assertEq("closure done", closure(False), "the closure runs as a new call");
        assertEq("object done", spinner.quick(), "the method runs as a new call");
        int start = clock_get_monotonic_us();
        assertThrows("SANDBOX-TIMEOUT", NOTHING, closure, True);
        assertGe(Limit, (clock_get_monotonic_us() - start) / 1000, "the closure got a deadline of its own");
        assertThrows("SANDBOX-TIMEOUT", \spinner.spin());
    }

    testNoLimit() {
        # a manager without a limit, a limit removed with 0, and a Program without a manager
        SandboxManager removed = limited();
        removed.setWallTimeLimit(0);
        Program unmanaged(PO_NO_CHILD_PO_RESTRICTIONS);
        unmanaged.parse(SandboxCode, "unmanaged");
        foreach Program p in (sandboxed(new SandboxManager()), sandboxed(removed), unmanaged) {
            # a call that takes longer than the limits used elsewhere
            assertEq("rested", p.callFunction("nap", Limit * 2));
        }
    }
}
