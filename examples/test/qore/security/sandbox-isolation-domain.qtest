#! trusted code that a build runs: sets a global variable of a Program that the caller gives it
nothing sub build_set_global(Program p, string name, auto value) {
    p.setGlobalVarValue(name, value);
}

#! trusted code that a build runs: loads a module into a Program that the caller gives it
nothing sub build_load_module(Program p, string mod) {
    p.loadModule(mod);
}

#! trusted code that a build runs: starts the worker of a shared pool (a library's lazily started worker)
ThreadPool sub build_start_pool() {
    ThreadPool tp(1, 1, 1);
    Queue q();
    tp.submit(sub () { q.push(True); });
    q.get();
    return tp;
}

#! trusted code that a build runs: runs the code that the caller gives it on the shared pool and returns the result or
#! the error
auto sub build_on_pool(ThreadPool tp, code c, softlist<auto> args) {
    Queue q();
    tp.submit(sub () {
        try {
            q.push({"result": call_function_args(c, args)});
        } catch (hash<ExceptionInfo> ex) {
            q.push({"err": ex.err});
        }
    });
    hash<auto> h = q.get();
    if (h.err) {
        throw h.err, "in the pool";
    }
    return h.result;
}

#! trusted code that runs the code that the caller gives it on the second pool from a task of the first pool, and returns
#! the result or the error (the second task's isolation is the first task's, joined with the second worker's)
auto sub build_on_pools(ThreadPool tp1, ThreadPool tp2, code c, softlist<auto> args) {
    Queue q();
    tp1.submit(sub () {
        try {
            tp2.submit(sub () {
                try {
                    q.push({"result": call_function_args(c, args)});
                } catch (hash<ExceptionInfo> ex) {
                    q.push({"err": ex.err});
                }
            });
        } catch (hash<ExceptionInfo> ex) {
            q.push({"err": ex.err});
        }
    });
    # the timeout only guards against a hang (QUEUE-TIMEOUT)
    hash<auto> h = q.get(60s);
    if (h.err) {
        throw h.err, "in the second pool";
    }
    return h.result;
}

#! trusted code that a build runs: the isolation domain that it works for, also in a thread that it starts
list<*string> sub build_caller_domain() {
    Queue q();
    background sub () {
        q.push(SandboxManager::getCallerIsolationDomain());
    }();
    return (SandboxManager::getCallerIsolationDomain(), q.get());
}

#! trusted code that a build runs: creates an eval Program from a Program that the caller gives it
string sub build_eval(Program p) {
    ProgramControl pc = p.getProgram();
    return pc.createEvalProgram(PO_NEW_STYLE).className();
}

#! trusted code that a build runs: calls a function of a Program that the caller gives it
auto sub build_call_pgm(Program p, string f, softlist<auto> args) {
    return p.callFunctionArgs(f, args);
}

#! a trusted class whose objects get the sandbox of the code that creates them as provenance
class Holder {
    int run() {
        return 1;
    }
}

#! trusted code that sandboxed code calls: the object gets the caller's sandbox as provenance
Holder sub new_holder() {
    return new Holder();
}

class SandboxIsolationDomainTest inherits QUnit::Test {
    private {
        code BuildCallArgs;
        code BuildCallMethod;
        code BuildCallFirst;
        code BuildCallReturned;
        code BuildThreadCall;
        code BuildNested;
        code BuildCallPgm;
        code BuildCallLoop;
        code BuildEval;
        code BuildCallerDomain;
        code BuildStartPool;
        code BuildOnPool;
        code BuildParse;
        code BuildParsePending;
        code BuildLoadModule;
        code BuildSetGlobal;
        code BuildProgramOp;

        #! tenant A's interface, its second interface (same domain), tenant B's interface
        Program a;
        Program a2;
        Program b;
    }

    constructor() : QUnit::Test("sandbox isolation domains", "1.0", \ARGV) {
        addTestCase("the isolation domain of a sandbox", \domainApi());
        addTestCase("the code of another tenant does not run in a build that a tenant called", \refused());
        addTestCase("the same tenant's code, the build's own code and host code run", \allowed());
        addTestCase("a build that trusted code enters may run any tenant's code", \trustedCaller());
        addTestCase("the code of the Program that created the build runs in it, whatever its domain",
            \creatorCode());
        addTestCase("sandboxes without a domain refuse nothing", \noDomain());
        addTestCase("the code of another tenant has no effect: direct calls, nested and lost calls, parsing",
            \noEffect());
        addTestCase("a build cannot use another tenant's Program: neither its code nor its state", \programOps());
        addTestCase("a worker started in a tenant's build runs other work under its submitter's isolation",
            \sharedWorker());
        set_return_value(main());
    }

    globalSetUp() {
        BuildCallArgs = SandboxManager::createTrustedBuildCall(\build_call_args());
        BuildCallMethod = SandboxManager::createTrustedBuildCall(\build_call_method());
        BuildCallFirst = SandboxManager::createTrustedBuildCall(\build_call_first());
        BuildCallReturned = SandboxManager::createTrustedBuildCall(\build_call_returned());
        BuildThreadCall = SandboxManager::createTrustedBuildCall(\build_thread_call());
        BuildNested = SandboxManager::createTrustedBuildCall(\build_nested());
        BuildCallPgm = SandboxManager::createTrustedBuildCall(\build_call_pgm());
        BuildCallLoop = SandboxManager::createTrustedBuildCall(\build_call_loop());
        BuildEval = SandboxManager::createTrustedBuildCall(\build_eval());
        BuildCallerDomain = SandboxManager::createTrustedBuildCall(\build_caller_domain());
        BuildStartPool = SandboxManager::createTrustedBuildCall(\build_start_pool());
        BuildOnPool = SandboxManager::createTrustedBuildCall(\build_on_pool());
        BuildParse = SandboxManager::createTrustedBuildCall(\build_parse());
        BuildParsePending = SandboxManager::createTrustedBuildCall(\build_parse_pending());
        BuildLoadModule = SandboxManager::createTrustedBuildCall(\build_load_module());
        BuildSetGlobal = SandboxManager::createTrustedBuildCall(\build_set_global());
        BuildProgramOp = SandboxManager::createTrustedBuildCall(\build_program_op());

        a = tenant("a", "tenant-a");
        a2 = tenant("a", "tenant-a2");
        b = tenant("b", "tenant-b");
    }

    programOps() {
        # every method of Program and of ProgramControl is refused on a Program of another tenant, before it reads or
        # changes anything; the tenant's own Program is not refused
        foreach hash<auto> i in (ProgramOps.pairIterator()) {
            Program b_target = opTarget("b");
            assertThrows("SANDBOX-ISOLATION-ERROR", "accessing a Program", \a.callFunction(), ("call", BuildProgramOp,
                (i.value, b_target)), "Program::" + i.key);
            assertNotIsolationError(i.value, opTarget("a"), "Program::" + i.key);
        }
        foreach hash<auto> i in (ControlOps.pairIterator()) {
            # the ProgramControl of a Program that is kept (the control does not keep its Program)
            Program b_pgm = opTarget("b");
            Program a_pgm = opTarget("a");
            # createEvalProgram() names its own operation
            assertThrows("SANDBOX-ISOLATION-ERROR", i.key == "createEvalProgram" ? "createEvalProgram" : "accessing a Program",
                \a.callFunction(), ("call", BuildProgramOp, (i.value, b_pgm.getProgram())), "ProgramControl::" + i.key);
            assertNotIsolationError(i.value, a_pgm.getProgram(), "ProgramControl::" + i.key);
        }
        foreach hash<auto> i in (DebuggerOps.pairIterator()) {
            Program b_pgm = opTarget("b");
            Program a_pgm = opTarget("a");
            assertThrows("SANDBOX-ISOLATION-ERROR", "accessing a Program", \a.callFunction(), ("call", BuildProgramOp,
                (i.value, b_pgm.getProgram())), i.key);
            assertNotIsolationError(i.value, a_pgm.getProgram(), i.key);
        }
        # another tenant's Program is not taken as the container of a module (which deletes its object): it is checked
        # first, and its object is unchanged
        hash<string, code> container_ops = {
            "Program::loadUserModuleWithProgram": sub (Program c) {
                opTarget("a").loadUserModuleWithProgram("Mime", c);
            },
            "Program::loadUserModuleWithProgramWarn": sub (Program c) {
                opTarget("a").loadUserModuleWithProgramWarn("Mime", c);
            },
            "load_user_module_with_program()": sub (Program c) { load_user_module_with_program("Mime", c); },
        };
        foreach hash<auto> i in (container_ops.pairIterator()) {
            Program b_container = opTarget("b");
            assertThrows("SANDBOX-ISOLATION-ERROR", "accessing a Program", \a.callFunction(), ("call", BuildProgramOp,
                (i.value, b_container)), i.key);
            assertEq(1, b_container.getGlobalVariable("x"), i.key);
            assertNotIsolationError(i.value, opTarget("a"), i.key);
        }
        # the state of the other tenant's Program is unchanged
        Program b_target = opTarget("b");
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildProgramOp,
            (ProgramOps.setGlobalVarValue, b_target)));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildProgramOp,
            (ControlOps.setGlobalVarValue, b_target.getProgram())));
        assertEq(1, b_target.getGlobalVariable("x"));
        # Programs that are not another tenant's are not refused: the host's (a library's Program), one of a sandbox
        # without a domain, the tenant's own
        Program lib(PO_NEW_STYLE);
        lib.parse("our int x; int sub f() { return 3; }", "library");
        lib.setGlobalVarValue("x", 4);
        Program none = tenantProgram();
        none.parse("our int x;", "no-domain");
        none.setGlobalVarValue("x", 5);
        code read = int sub (Program p) { return p.getGlobalVariable("x"); };
        assertEq(4, a.callFunction("call", BuildCallArgs, (read, (lib,))));
        assertEq(5, a.callFunction("call", BuildCallArgs, (read, (none,))));
        assertEq(1, a.callFunction("call", BuildCallArgs, (read, (opTarget("a"),))));
        assertEq(3, a.callFunction("call", BuildCallArgs, (int sub (Program p) { return p.callFunction("f"); },
            (lib,))));
        # the code, constants and statics of a module that the host loaded (its Program has no sandbox) are read and
        # run in the build
        assertEq("text/plain|text/html", a.callFunction("call", BuildCallArgs, (string sub () {
            return Mime::MimeTypeText + "|" + Mime::get_mime_type_from_ext("x.html"); }, ())));
        # an expression of the other tenant's Program that the host created is not evaluated in the build (it enters
        # the Program); one of the tenant's own is
        Program b_expr_pgm = opTarget("b");
        Expression b_expr = b_expr_pgm.getExpression("f() + 1", "expr");
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallArgs,
            (auto sub (Expression e) { return e.eval(); }, (b_expr,))));
        Program a_expr_pgm = opTarget("a");
        Expression a_expr = a_expr_pgm.getExpression("f() + 1", "expr");
        assertEq(2, a.callFunction("call", BuildCallArgs, (auto sub (Expression e) { return e.eval(); }, (a_expr,))));
        # the Program's ID only identifies it
        assertEq(b_target.getProgramId(), a.callFunction("call", BuildCallArgs, (int sub (Program p) {
            return p.getProgramId(); }, (b_target,))));
    }

    #! the operation in a build that tenant A called on its own Program: any error but an isolation error
    private assertNotIsolationError(code op, object target, string label) {
        try {
            a.callFunction("call", BuildProgramOp, (op, target));
        } catch (hash<ExceptionInfo> ex) {
            assertNeq("SANDBOX-ISOLATION-ERROR", ex.err, label + ": " + ex.desc);
        }
    }

    #! a Program of the given domain with a global variable \c x (1) and a function \c f()
    private Program opTarget(string domain) {
        Program p = tenantProgram(domain);
        p.parse("our int x; int sub f() { return 1; }", "op-target");
        p.setGlobalVarValue("x", 1);
        return p;
    }

    #! creates a Program governed by a sandbox of the given domain (none: a sandbox without a domain), with no code
    private Program tenantProgram(*string domain) {
        SandboxManager m();
        m.setUncontrolledApiPolicy(True);
        if (domain) {
            m.setIsolationDomain(domain);
        }
        Program p(PO_MODERN);
        p.setSandboxManager(m);
        return p;
    }

    #! creates the Program of a tenant's interface
    private Program tenant(*string domain, string name) {
        SandboxManager m();
        m.setUncontrolledApiPolicy(True);
        if (domain) {
            m.setIsolationDomain(domain);
        }
        Program p(PO_MODERN);
        p.setSandboxManager(m);
        p.parse(TenantSource, name);
        return p;
    }

    domainApi() {
        SandboxManager m();
        assertNothing(m.getIsolationDomain());
        assertThrows("SANDBOX-CONFIG-ERROR", "must not be empty", \m.setIsolationDomain(), "");
        m.setIsolationDomain("x");
        assertEq("x", m.getIsolationDomain());
        # the same domain again changes nothing; another is refused
        m.setIsolationDomain("x");
        assertThrows("SANDBOX-CONFIG-ERROR", "cannot be changed", \m.setIsolationDomain(), "y");
        # a copy belongs to the same tenant
        assertEq("x", m.copy().getIsolationDomain());

        # the domain is set before the sandbox governs code
        SandboxManager n();
        Program p(PO_MODERN);
        p.setSandboxManager(n);
        assertThrows("SANDBOX-CONFIG-ERROR", "already governs code", \n.setIsolationDomain(), "x");

        # sandboxed code cannot set a domain, also not of a sandbox that it created
        assertEq("SANDBOX-ACCESS-ERROR", a.callFunction("set_domain", new SandboxManager(), "b"));
        # the domain of the calling code: the tenant's, also through trusted library code that it calls; none for the
        # host
        assertEq("a", a.callFunction("caller_domain"));
        assertEq("b", b.callFunction("call", \SandboxManager::getCallerIsolationDomain()));
        assertNothing(SandboxManager::getCallerIsolationDomain());
        # the code of a trusted build works for the tenant that entered it (whose sandbox the build's barrier hides),
        # also in a thread that it starts; for nobody in a build that the host entered
        assertEq(("a", "a"), a.callFunction("call", BuildCallerDomain));
        assertEq(("b", "b"), b.callFunction("call", BuildCallerDomain));
        assertEq((NOTHING, NOTHING), BuildCallerDomain());
        # a sandbox that sandboxed code creates belongs to the tenant of that code
        assertEq("a", a.callFunction("new_manager_domain"));
        assertEq("b", b.callFunction("new_manager_domain"));
    }

    refused() {
        code b_ref = b.getCallReference("make");
        code b_closure = b.callFunction("mk_closure");
        object b_obj = b.callFunction("mk_object");
        # an object of a trusted class with tenant B's sandbox as provenance
        Holder b_holder = b.callFunction("call", \new_holder());
        # tenant A's own code that returns tenant B's code
        code a_returning = a.callFunction("returning", b_ref);

        int frames = budgetFrames();
        assertThrows("SANDBOX-ISOLATION-ERROR", "isolation domain 'b'.*isolation domain 'a'",
            \a.callFunction(), ("call", BuildCallArgs, (b_ref, 10)));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallArgs, (b_closure, 10)));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallMethod, (b_obj, "make", 10)));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallMethod, (b_holder, "run")));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallFirst, ((b_ref,), 10)));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallReturned, (a_returning, 10)));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildThreadCall, (b_ref, 10)));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildNested, (BuildCallArgs, b_ref, 10)));
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallPgm, (b, "make", 10)));
        # the refused entries left no frames
        if (frames >= 0) {
            assertEq(frames, budgetFrames());
        }
        # an eval Program of the other tenant's Program
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildEval, (b,)));
        # a child Program of the tenant (a composite of its sandboxes) calls the build
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("child_call", BuildCallArgs, b_ref, 10));
        assertEq(10, a.callFunction("child_call", BuildCallArgs, a.getCallReference("make"), 10).size());
        # and the tenant can still call its own code through the build
        assertEq(10, a.callFunction("call", BuildCallArgs, (a.getCallReference("make"), 10)).size());
    }

    allowed() {
        # the same tenant's other interface (a TrustedSynchronousExecution-style build)
        assertEq(10, a.callFunction("call", BuildCallArgs, (a2.getCallReference("make"), 10)).size());
        assertEq(10, a.callFunction("call", BuildCallMethod, (a2.callFunction("mk_object"), "make", 10)).size());
        assertEq(10, a.callFunction("call", BuildCallPgm, (a2, "make", 10)).size());
        assertEq(10, a.callFunction("call", BuildThreadCall, (a2.getCallReference("make"), 10)).size());
        # the caller's own code
        assertEq(10, a.callFunction("call", BuildCallArgs, (a.callFunction("mk_closure"), 10)).size());
        # host code
        code host = list<string> sub (int n) { return map "x", xrange(n); };
        assertEq(10, a.callFunction("call", BuildCallArgs, (host, 10)).size());
    }

    trustedCaller() {
        # the host orchestrates across tenants
        assertEq(10, BuildCallArgs(b.getCallReference("make"), 10).size());
        assertEq(10, BuildThreadCall(b.getCallReference("make"), 10).size());
        assertEq(10, BuildNested(BuildCallArgs, b.getCallReference("make"), 10).size());
    }

    creatorCode() {
        # a capability created by the code of a trusted Program, which the host then gives a sandbox of another
        # domain: the build's own code, and the creator's code that the caller's code calls in the build, run
        Program creator(PO_MODERN);
        creator.parse("%modern
list<string> sub make(int n) {
    list<string> l = ();
    for (int i = 0; i < n; ++i) {
        l += \"c\";
    }
    return l;
}
auto sub run(code c, softlist<auto> args) {
    return call_function_args(c, args);
}
code sub mk() {
    return Qore::SandboxManager::createTrustedBuildCall(\\run());
}
", "creator");
        code cap = creator.callFunction("mk");
        SandboxManager mc();
        mc.setUncontrolledApiPolicy(True);
        mc.setIsolationDomain("c");
        creator.setSandboxManager(mc);
        # the build's own code
        assertEq(10, a.callFunction("call", cap, (creator.getCallReference("make"), 10)).size());
        # the creator's code that the caller's code calls in the build
        assertEq(10, a.callFunction("call", cap, (a.getCallReference("call"), (creator.getCallReference("make"),
            10))).size());
        # another tenant's code is still refused there
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", cap, (b.getCallReference("make"), 10)));
        code c_make = creator.getCallReference("make");
        # a nested build never widens what runs: the build that tenant A entered refuses the creator's code (domain c)
        # also in a build of the creator's capability that it calls
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildNested, (cap, c_make, 10)));

        # pool tasks run under the isolation of the code that submitted them, not that of the build that started the
        # pool's worker: the worker of tp1 starts in a build that tenant A entered (which refuses the creator's code),
        # the worker of tp2 in A's build of the creator's capability (which allows it); a task submitted from a task
        # of tp1 continues the capability's build only (a continuation that runs inline in other builds keeps their
        # isolation as well: ut_sandbox_isolation_joined_twice() in run_unit_tests())
        ThreadPool tp1 = a.callFunction("call", BuildStartPool);
        on_exit tp1.stop();
        ThreadPool tp2 = a.callFunction("call", cap, (\build_start_pool(), ()));
        on_exit tp2.stop();
        assertEq(3, a.callFunction("call", cap, (\build_on_pool(), (tp2, c_make, 3))).size());
        assertEq(3, a.callFunction("call", cap, (\build_on_pools(), (tp1, tp2, c_make, 3))).size());
        # another tenant's code is refused on the same path
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", cap, (\build_on_pools(),
            (tp1, tp2, b.getCallReference("make"), 3))));
    }

    noDomain() {
        Program x = tenant(NOTHING, "no-domain-x");
        Program y = tenant(NOTHING, "no-domain-y");
        assertEq(10, x.callFunction("call", BuildCallArgs, (y.getCallReference("make"), 10)).size());
        # a caller without a domain refuses no tenant's code either
        assertEq(10, x.callFunction("call", BuildCallArgs, (b.getCallReference("make"), 10)).size());
        # the code of a sandbox without a domain runs for a tenant
        assertEq(10, a.callFunction("call", BuildCallArgs, (y.getCallReference("make"), 10)).size());
    }

    noEffect() {
        # tenant B's counter, warmed up by calls of the host (which may call any tenant's code), so that the calls run
        # on the fast paths of each execution mode
        hash<auto> counter = b.callFunction("mk_counter");
        for (int i = 0; i < 20; ++i) {
            counter.inc();
        }
        assertEq(20, counter.get());

        # a direct call of the closure by the build's code, in a loop: the host's build (which may run any tenant's
        # code) warms up the build's call site first, so that the tenant's call takes its fast paths
        BuildCallLoop(counter.inc, 50);
        assertEq(70, counter.get());
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallLoop, (counter.inc, 50)));
        assertEq(70, counter.get());

        # a nested build that a sandbox without a domain enters inside the tenant's build: the tenant's isolation
        # still holds
        Program y = tenant(NOTHING, "nested-no-domain");
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildCallArgs,
            (y.getCallReference("call"), (BuildCallArgs, (counter.inc,)))));
        assertEq(70, counter.get());

        # parsing code in the other tenant's Program
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildParse,
            (b, "our int build_parse_x = make(1).size();")));
        assertNothing(b.getGlobalVariable("build_parse_x"));
        # parsing without committing (the parse is refused itself, not only its commit): nothing is pending
        Program b_pending = tenantProgram("b");
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildParsePending,
            (b_pending, "our int build_pending_x = 1;")));
        b_pending.parseCommit();
        assertNothing(b_pending.getGlobalVariable("build_pending_x"));
        # loading a module into the other tenant's Program: the module is not loaded into it
        Program b_module = tenantProgram("b");
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildLoadModule, (b_module, "Mime")));
        b_module.parse("list<string> sub features() { return get_feature_list(); }", "module-check");
        list<string> features = b_module.callFunction("features");
        assertTrue(features.size() > 0);
        assertFalse(inlist("Mime", features), sprintf("%y", features));
        # changing a global variable of the other tenant's Program (no code of it runs: the Program access check)
        Program b_global = tenantProgram("b");
        b_global.parse("our int build_global;", "global");
        b_global.setGlobalVarValue("build_global", 1);
        assertThrows("SANDBOX-ISOLATION-ERROR", "accessing a Program", \a.callFunction(), ("call", BuildSetGlobal,
            (b_global, "build_global", 2)));
        assertEq(1, b_global.getGlobalVariable("build_global"));
        # the tenant's own Program
        Program a_global = tenantProgram("a");
        a_global.parse("our int build_global;", "global");
        a_global.setGlobalVarValue("build_global", 1);
        a.callFunction("call", BuildSetGlobal, (a_global, "build_global", 2));
        assertEq(2, a_global.getGlobalVariable("build_global"));

        # a call whose limits cannot be enforced (its budget could not be recorded) keeps the isolation
        try {
            call_function("dbg_sandbox_fail_next_budgets", 0);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "NO-FUNCTION" || ex.err == "UNDEFINED-FUNCTION-CALL") {
                return;
            }
            rethrow;
        }
        SandboxManager mw();
        mw.setUncontrolledApiPolicy(True);
        mw.setWallTimeLimit(600000);
        mw.setIsolationDomain("a");
        Program aw(PO_MODERN);
        aw.setSandboxManager(mw);
        aw.parse(TenantSource, "tenant-a-limited");
        code aw_call = aw.getCallReference("call");
        call_function("dbg_sandbox_fail_next_budgets", 1);
        on_exit call_function("dbg_sandbox_fail_next_budgets", 0);
        try {
            a.callFunction("call", BuildCallArgs, (aw_call, (counter.inc,)));
            assertTrue(False, "the call was not refused");
        } catch (hash<ExceptionInfo> ex) {
            # the isolation error, or the error of the call whose limits cannot be enforced; the counter is unchanged
            assertTrue(ex.err == "SANDBOX-ISOLATION-ERROR" || ex.err == "SANDBOX-ERROR", ex.err);
        }
        assertEq(70, counter.get());
    }

    sharedWorker() {
        # the worker of a shared pool starts in tenant A's build (a library that starts it lazily)
        ThreadPool tp = a.callFunction("call", BuildStartPool);
        on_exit tp.stop();
        code b_make = b.getCallReference("make");
        # a task of the host runs tenant B's code on it: the host may run any tenant's code
        Queue q();
        tp.submit(sub () { q.push(b_make(3).size()); });
        assertEq(3, q.get());
        # tenant A's task in its build still cannot run tenant B's code there
        assertThrows("SANDBOX-ISOLATION-ERROR", \a.callFunction(), ("call", BuildOnPool, (tp, b_make, 3)));
        # and the host's tasks are not affected by it
        tp.submit(sub () { q.push(b_make(4).size()); });
        assertEq(4, q.get());
    }

    #! the number of call budget frames of the thread, or -1 in a release build
    private int budgetFrames() {
        try {
            return call_function("dbg_sandbox_budget_frames");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "NO-FUNCTION" || ex.err == "UNDEFINED-FUNCTION-CALL") {
                return -1;
            }
            rethrow;
        }
    }
}
