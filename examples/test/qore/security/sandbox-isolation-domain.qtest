#! a debugger that the test uses only to add Programs to and to break them
class OpDebugProgram inherits DebugProgram {
    onAttach(ProgramControl pgm, reference rs, reference rts) {}
    onDetach(ProgramControl pgm, reference rs, reference rts) {}
    onStep(ProgramControl pgm, int bsid, *int sid, *int bid, reference flow, reference rs, reference rts) {}
    onFunctionEnter(ProgramControl pgm, int sid, reference rs, reference rts) {}
    onFunctionExit(ProgramControl pgm, int sid, reference rv, reference rs, reference rts) {}
    onException(ProgramControl pgm, int sid, hash<auto> ex, reference dismiss, reference rs, reference rts) {}
    onExit(ProgramControl pgm, int sid, reference rv, reference rs, reference rts) {}
}

#! the debugger methods that act on a ProgramControl that they are given (qore#6536)
const DebuggerOps = {
    "DebugProgram::addProgram": sub (ProgramControl pc) { (new OpDebugProgram()).addProgram(pc); },
    "DebugProgram::removeProgram": sub (ProgramControl pc) { (new OpDebugProgram()).removeProgram(pc); },
    "DebugProgram::attachThread": sub (ProgramControl pc) { (new OpDebugProgram()).attachThread(pc, gettid()); },
    "DebugProgram::breakProgramThread": sub (ProgramControl pc) {
        (new OpDebugProgram()).breakProgramThread(pc, gettid());
    },
    "DebugProgram::setProgramTerminating": sub (ProgramControl pc) {
        (new OpDebugProgram()).setProgramTerminating(pc);
    },
    "DebugProgram::breakProgram": sub (ProgramControl pc) { (new OpDebugProgram()).breakProgram(pc); },
    "Breakpoint::assignProgram": sub (ProgramControl pc) { (new Breakpoint()).assignProgram(pc); },
};

