#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires AwsRestClient
%requires ./ambient-host/AmbientCallers.qm

%exec-class AmbientAwsCredentialsTest

#! The AWS credential chain resolves no credentials of the host for code restricted from external information
#! (qore#6844)
/** The key, secret and session token of the environment, the ECS task-role endpoint and the IMDSv2 instance
    credentials are the host's; code restricted from external information gives its own, which still work
*/
class AmbientAwsCredentialsTest inherits QUnit::Test {
    public {
        #! the code of the Programs; it reports what it gets, or the error it gets
        const Source = "%modern
%requires AwsRestClient
auto sub try_call(code c) {
    try {
        return c();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
hash<auto> sub env(*hash<auto> opts) {
    return AwsRestClient::AwsRestClientBase::applyEnvCredentials(opts ?? {});
}
auto sub ecs() {
    return try_call(auto sub () { return AwsRestClient::AwsRestClientBase::getEcsCredentials().aws_keyid; });
}
auto sub imds(string url) {
    return try_call(auto sub () {
        return AwsRestClient::AwsRestClientBase::getImdsCredentials({\"aws_imds_url\": url}).aws_keyid;
    });
}
*string sub instance(string url) {
    return AwsRestClient::AwsRestClientBase::applyInstanceCredentials({\"aws_imds_url\": url}).aws_keyid;
}
*bool sub ec2() {
    return AwsRestClient::AwsRestClientBase::isEc2Compute();
}
auto sub client(*hash<auto> opts) {
    return try_call(auto sub () {
        AwsRestClient::AwsRestClientIo c({\"url\": \"https://s3.us-east-1.amazonaws.com\", \"aws_imds_disabled\": True}
            + opts);
        return \"CLIENT\";
    });
}
*string sub capability(code cap) {
    return cap();
}
";

        #! what the error of a refused caller says
        const Refused = "restricted from external information";
    }

    private {
        #! the Programs of each kind of calling code
        hash<string, Program> pgms;
        #! the fake metadata server
        AmbientCallers::FakeMetadataServer mds();
    }

    constructor() : Test("AmbientAwsCredentials", "1.0", \ARGV) {
        addTestCase("environment credentials", \envTest());
        addTestCase("container credentials", \ecsTest());
        addTestCase("instance credentials", \imdsTest());
        addTestCase("clients", \clientTest());
        addTestCase("host grants", \grantTest());
        set_return_value(main());
    }

    globalSetUp() {
        pgms = AmbientCallers::make_programs(Source, "aws");
    }

    #! the key, secret and session token of the environment
    envTest() {
        AmbientCallers::EnvHelper env({
            "AWS_ACCESS_KEY_ID": "HOSTKEYID",
            "AWS_SECRET_ACCESS_KEY": "host-secret",
            "AWS_SESSION_TOKEN": "host-token",
            "AWS_REGION": "eu-west-9",
        });
        hash<auto> h = AwsRestClientBase::applyEnvCredentials({});
        assertEq("HOSTKEYID", h.aws_keyid, "host");
        assertEq("host-secret", h.aws_secret, "host");
        foreach string kind in (AmbientCallers::Kinds) {
            h = pgms{kind}.callFunction("env");
            # the region is not a credential
            assertEq("eu-west-9", h.aws_region, kind);
            if (AmbientCallers::restricted(kind)) {
                assertEq(NOTHING, h.aws_keyid, kind);
                assertEq(NOTHING, h.aws_secret, kind);
                assertEq(NOTHING, h.aws_token, kind);
            } else {
                assertEq("HOSTKEYID", h.aws_keyid, kind);
                assertEq("host-secret", h.aws_secret, kind);
                assertEq("host-token", h.aws_token, kind);
            }
            # explicit credentials are the caller's own
            h = pgms{kind}.callFunction("env", {"aws_keyid": "MINE", "aws_secret": "my-secret"});
            assertEq("MINE", h.aws_keyid, kind);
            assertEq("my-secret", h.aws_secret, kind);
        }
    }

    #! the ECS task-role endpoint
    ecsTest() {
        AmbientCallers::EnvHelper env({
            "AWS_CONTAINER_CREDENTIALS_FULL_URI": mds.url + "/ecs/creds",
            "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI": NOTHING,
            "AWS_ACCESS_KEY_ID": NOTHING,
        });
        assertEq("HOST-ECS-KEY", AwsRestClientBase::getEcsCredentials().aws_keyid, "host");
        foreach string kind in (AmbientCallers::Kinds) {
            auto v = pgms{kind}.callFunction("ecs");
            if (AmbientCallers::restricted(kind)) {
                assertRegex("^AWSRESTCLIENT-IMDS-ERROR: .*" + Refused, v, kind);
                # the chain does not query the endpoint either
                assertEq(NOTHING, pgms{kind}.callFunction("instance", mds.url), kind);
            } else {
                assertEq("HOST-ECS-KEY", v, kind);
                assertEq("HOST-ECS-KEY", pgms{kind}.callFunction("instance", mds.url), kind);
            }
        }
    }

    #! the IMDSv2 instance credentials and the host's hardware identity
    imdsTest() {
        AmbientCallers::EnvHelper env({
            "AWS_CONTAINER_CREDENTIALS_FULL_URI": NOTHING,
            "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI": NOTHING,
            "AWS_ACCESS_KEY_ID": NOTHING,
        });
        assertEq("HOST-IMDS-KEY", AwsRestClientBase::getImdsCredentials({"aws_imds_url": mds.url}).aws_keyid,
            "host");
        foreach string kind in (AmbientCallers::Kinds) {
            int calls = mds.handler.calls;
            auto v = pgms{kind}.callFunction("imds", mds.url);
            *string instance = pgms{kind}.callFunction("instance", mds.url);
            if (AmbientCallers::restricted(kind)) {
                assertRegex("^AWSRESTCLIENT-IMDS-ERROR: .*" + Refused, v, kind);
                assertEq(NOTHING, instance, kind);
                # the metadata server was not asked
                assertEq(calls, mds.handler.calls, kind);
                # the hardware identity of the host is not read
                assertEq(NOTHING, pgms{kind}.callFunction("ec2"), kind);
            } else {
                assertEq("HOST-IMDS-KEY", v, kind);
                assertEq("HOST-IMDS-KEY", instance, kind);
                assertEq(AwsRestClientBase::isEc2Compute(), pgms{kind}.callFunction("ec2"), kind);
            }
        }
    }

    #! a client without credentials is refused with an error that says why; explicit credentials work
    clientTest() {
        AmbientCallers::EnvHelper env({
            "AWS_ACCESS_KEY_ID": "HOSTKEYID",
            "AWS_SECRET_ACCESS_KEY": "host-secret",
            "AWS_CONTAINER_CREDENTIALS_FULL_URI": NOTHING,
            "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI": NOTHING,
        });
        foreach string kind in (AmbientCallers::Kinds) {
            auto v = pgms{kind}.callFunction("client");
            if (AmbientCallers::restricted(kind)) {
                assertRegex("^AWSRESTCLIENT-ERROR: missing required option \"aws_keyid\".*" + Refused, v, kind);
            } else {
                assertEq("CLIENT", v, kind);
            }
            assertEq("CLIENT", pgms{kind}.callFunction("client", {"aws_keyid": "MINE", "aws_secret": "my-secret"}),
                kind);
        }
    }

    #! a capability that the host creates reads the host's credentials for any caller
    grantTest() {
        AmbientCallers::EnvHelper env({
            "AWS_ACCESS_KEY_ID": "HOSTKEYID",
            "AWS_SECRET_ACCESS_KEY": "host-secret",
        });
        code cap = SandboxManager::createSystemPolicyCall(*string sub () {
            return AwsRestClientBase::applyEnvCredentials({}).aws_keyid;
        });
        foreach string kind in (AmbientCallers::Kinds) {
            assertEq("HOSTKEYID", pgms{kind}.callFunction("capability", cap), kind);
        }
    }
}
