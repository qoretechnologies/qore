# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# helpers of the ambient host data tests (qore#6844): the Programs of the kinds of calling code and a fake metadata
# server of the clouds

%modern
%requires HttpServerUtil
%requires HttpServer
%requires Logger
%requires json

module AmbientCallers {
    version = "1.0";
    desc = "ambient host data test helpers (qore#6844)";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        AmbientCallers::Invoke = \AmbientCallers::invoke();
        # called by name, so that the module can be loaded by code that may not use uncontrolled APIs
        AmbientCallers::Capability = call_static_method("SandboxManager", "createSystemPolicyCall",
            AmbientCallers::Invoke);
    };
}

public namespace AmbientCallers {
    #! the kinds of calling code: what they may get (see SandboxManager::callerMayReadExternalInfo() and
    #! SandboxManager::callerMayReceiveHostSecrets())
    public const KindInfo = {
        # a Program that is neither restricted nor sandboxed
        "unrestricted": {"po": 0, "sandboxed": False, "read": True, "secrets": True},
        "restricted": {"po": PO_NO_EXTERNAL_INFO, "sandboxed": False, "read": False, "secrets": False},
        "sandboxed restricted": {"po": PO_NO_EXTERNAL_INFO, "sandboxed": True, "read": False, "secrets": False},
        # a sandbox that allows everything: it governs the code without restricting it
        "sandboxed": {"po": 0, "sandboxed": True, "read": True, "secrets": False},
    };

    #! the execution modes in which the Programs run
    public const Modes = {"ast": EM_AST, "ir": EM_IR, "jit": EM_JIT, "tiered": EM_TIERED};

    #! the code that the grants run, created in the module's initialization (a call reference created while serving
    #! a restricted caller keeps its restrictions)
    our code Invoke;
    #! a system-policy capability of Invoke, created in the module's initialization
    our code Capability;

    #! returns the kind of the Program of the given key of make_programs()
    public string sub kind(string key) {
        return (key =~ x/^([^:]+):/)[0];
    }

    #! returns True if code of the Program of the given key may read external information
    public bool sub may_read(string key) {
        return KindInfo{kind(key)}.read;
    }

    #! returns True if code of the Program of the given key may receive the host's secrets
    public bool sub may_receive(string key) {
        return KindInfo{kind(key)}.secrets;
    }

    #! returns True if code of the Program of the given key may not read external information
    public bool sub restricted(string key) {
        return !may_read(key);
    }

    #! creates a Program of each kind in each execution mode with the given source; keys: "<kind>: <mode>"
    public hash<string, Program> sub make_programs(string source, string label) {
        hash<string, Program> rv;
        foreach hash<auto> m in (Modes.pairIterator()) {
            foreach hash<auto> k in (KindInfo.pairIterator()) {
                Program p(PO_NEW_STYLE | k.value.po);
                # runtime-created Programs do not take the execution mode of the process
                p.setExecMode(m.value);
                if (k.value.sandboxed) {
                    SandboxManager sm();
                    sm.setNetworkDefaultPolicy(True);
                    sm.setFilesystemDefaultPolicy(True);
                    p.setSandboxManager(sm);
                }
                p.parse(source, label);
                rv{k.key + ": " + m.key} = p;
            }
        }
        return rv;
    }

    #! calls a function, or a static method if \a cls is given, of library code for the caller
    public auto sub invoke(*string cls, string name, *softlist<auto> args) {
        # the module of the target, in this module's Program (a no-op once it is loaded)
        *string mod = ((cls ?? name) =~ x/^([^:]+)::/)[0];
        if (mod && mod != "Qore") {
            load_module(mod);
        }
        return cls ? call_static_method_args(cls, name, args) : call_function_args(name, args);
    }

    #! calls invoke() under a policy barrier that this module's code establishes (a host grant)
    public auto sub invoke_barrier(*string cls, string name, *softlist<auto> args) {
        return call_static_method("SandboxManager", "callWithSystemPolicy", Invoke, (cls, name, args));
    }

    #! calls invoke() through a system-policy capability that this module created in its initialization (a host grant)
    public auto sub invoke_capability(*string cls, string name, *softlist<auto> args) {
        return Capability(cls, name, args);
    }

    #! an object of this module's class that the host creates and lends: its methods run library code for the
    #! borrower, directly and in threads that they start
    public class LentWorker {
        #! calls invoke() in the method
        public auto direct(*string cls, string name, *softlist<auto> args) {
            try {
                return AmbientCallers::invoke(cls, name, args);
            } catch (hash<ExceptionInfo> ex) {
                return ex.err + ": " + ex.desc;
            }
        }

        #! calls invoke() in a thread that the method starts, and returns its result
        public auto inThread(*string cls, string name, *softlist<auto> args) {
            Queue q();
            background AmbientCallers::LentWorker::run(q, cls, name, args);
            return q.get();
        }

        #! calls invoke() in a task of a thread pool that the method creates, and returns its result
        public auto inPool(*string cls, string name, *softlist<auto> args) {
            Queue q();
            ThreadPool tp(1);
            on_exit tp.stopWait();
            tp.submit(sub () { AmbientCallers::LentWorker::run(q, cls, name, args); });
            return q.get();
        }

        #! runs invoke() and pushes its result or error on \a q
        static run(Queue q, *string cls, string name, *softlist<auto> args) {
            try {
                q.push(AmbientCallers::invoke(cls, name, args));
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex.err + ": " + ex.desc);
            }
        }
    }

    #! sets the given environment variables while the returned object exists, and restores them after
    public class EnvHelper {
        private {
            hash<string, *string> saved;
        }

        constructor(hash<string, *string> vars) {
            saved = map {$1: getenv($1)}, keys vars;
            set(vars);
        }

        destructor() {
            set(saved);
        }

        set(hash<string, *string> vars) {
            foreach hash<auto> i in (vars.pairIterator()) {
                if (exists i.value) {
                    setenv(i.key, i.value);
                } else {
                    unsetenv(i.key);
                }
            }
        }
    }

    #! a fake metadata server of the clouds: AWS IMDSv2 and ECS, the GCP metadata server and the Azure IMDS
    public class FakeMetadataHandler inherits AbstractHttpRequestHandler {
        public {
            #! the number of requests
            int calls = 0;
        }

        hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
            ++calls;
            string path = cx.raw_path;
            if (hdr.method == "PUT" && path == "/latest/api/token") {
                return makeResponse({"Content-Type": "text/plain"}, 200, "imds-session-token");
            }
            if (path =~ /^\/latest\/meta-data\/iam\/security-credentials\/?$/) {
                return makeResponse({"Content-Type": "text/plain"}, 200, "host-role");
            }
            if (path == "/latest/meta-data/iam/security-credentials/host-role") {
                return makeResponse({"Content-Type": "application/json"}, 200, make_json({
                    "Code": "Success",
                    "AccessKeyId": "HOST-IMDS-KEY",
                    "SecretAccessKey": "host-imds-secret",
                    "Token": "host-imds-token",
                    "Expiration": "2099-01-01T00:00:00Z",
                }));
            }
            if (path =~ /^\/ecs/) {
                return makeResponse({"Content-Type": "application/json"}, 200, make_json({
                    "AccessKeyId": "HOST-ECS-KEY",
                    "SecretAccessKey": "host-ecs-secret",
                    "Token": "host-ecs-token",
                    "Expiration": "2099-01-01T00:00:00Z",
                }));
            }
            if (path =~ /^\/computeMetadata\//) {
                return makeResponse({"Content-Type": "application/json"}, 200,
                    "{\"access_token\":\"host-gcp-token\",\"expires_in\":1800,\"token_type\":\"Bearer\"}");
            }
            if (path =~ /^\/metadata\/identity\//) {
                return makeResponse({"Content-Type": "application/json"}, 200,
                    "{\"access_token\":\"host-azure-token\",\"expires_in\":\"1800\",\"token_type\":\"Bearer\"}");
            }
            # an HTTP Negotiate (Kerberos) challenge
            if (path =~ /^\/negotiate/) {
                return makeResponse({"Content-Type": "text/plain", "WWW-Authenticate": "Negotiate"}, 401,
                    "authentication required");
            }
            return makeResponse({"Content-Type": "text/plain"}, 404, "not found");
        }
    }

    #! a fake metadata server that listens on localhost while it exists
    public class FakeMetadataServer {
        public {
            #! the URL of the server
            string url;
            #! the handler
            FakeMetadataHandler handler();
        }

        private {
            HttpServer http;
        }

        constructor() {
            http = new HttpServer(<HttpServerOptionInfo>{"logger": new Logger("fake", LoggerLevel::getLevelError())});
            http.setDefaultHandler("metadata", handler);
            url = "http://localhost:" + http.addListener(<HttpListenerOptionInfo>{"node": "localhost",
                "service": 0}).port;
        }

        destructor() {
            http.stop();
        }
    }
}
