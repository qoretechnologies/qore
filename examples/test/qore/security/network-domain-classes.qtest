#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - all checks run in workers with explicit execution modes or as qcc executables
# test-platform: macos - JIT and AOT code generation, qcc executables and an outbound TCP connection

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class NetworkDomainClassesTest

#! A builtin class that starts a connection is in the NETWORK functional domain (qore#7105)
/** Code that may not use the network (PO_NO_NETWORK) cannot create Http1Connection, neither by its name in code
    (refused at parse time) nor by a name given at run time (create_object()), nor call the methods of one that it is
    given; code that may use the network can.
    The checks are in network-domain-classes/network-domain-worker.q, which is run in each execution mode and as a
    program compiled with qcc.
*/
class NetworkDomainClassesTest inherits QUnit::Test {
    public {
        #! the cases of the worker, in the order it runs them
        const Cases = ("parse-new", "parse-method", "runtime-create-object", "plain-parse", "plain-connects");
    }

    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        *string qcc_bin = TestInterpreter::qcc_compiler();
        string worker = get_script_dir() + DirSep + "network-domain-classes" + DirSep + "network-domain-worker.q";
        string prefix;
    }

    constructor() : QUnit::Test("NetworkDomainClassesTest", "1.0", \ARGV) {
        prefix = "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_LIBDIR=" + quote(libdir) + " ";
        addTestCase("each execution mode", \testModes());
        addTestCase("qcc executables", \testCompiled());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    #! the expected output of the worker
    private static string expected() {
        return (map $1 + "=ok\n", Cases).join("");
    }

    testModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            # the Programs that the worker creates run with its execution mode
            assertEq(expected(), ExecModeHarness::run(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode="
                + mode + " " + quote(worker), ExecModeHarness::NativeCheck::None), mode);
        }
        assertEq(expected(), ExecModeHarness::run_ir_tier(prefix + quote(qore_bin)
            + " -b --enable-debug --exec-mode=tiered " + quote(worker)), ExecModeHarness::IRTierName);
    }

    testCompiled() {
        if (!qcc_bin) {
            testSkip("qcc is not available");
        }
        TmpDir tmp("qore-network-domain-exe-");
        foreach string opt in (("-O0", "-O3")) {
            string exe = tmp.path + DirSep + "network-domain" + opt;
            ExecModeHarness::run_any(prefix + quote(qcc_bin) + " " + opt + " -o " + quote(exe) + " " + quote(worker));
            assertTrue(is_file(exe), "qcc " + opt + " produced the executable");
            assertEq(expected(), ExecModeHarness::run_any(prefix + quote(exe) + " -b"), "qcc " + opt);
        }
    }
}
