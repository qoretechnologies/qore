#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class SandboxIsolationCompositeTest

#! Code that the sandboxes of different isolation domains govern together belongs to no isolation domain (qore#7009)
/** When one tenant calls a closure of another tenant's code, the sandboxes of both govern it: it gets no tenant's
    domain, it cannot create a sandbox, a Program or a thread, and a trusted build that it enters runs the code of
    neither tenant.  The same tenant, and a tenant whose code a sandbox without a domain also governs, are unaffected.

    sandbox-isolation-composite/IsolationComposite.q checks these; its output must be the one in
    sandbox-isolation-composite/IsolationComposite.expected in every execution mode, and in programs compiled with qcc
    -O0 and -O3.
*/
class SandboxIsolationCompositeTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/sandbox-isolation-composite/IsolationComposite.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir()
            + "/sandbox-isolation-composite/IsolationComposite.expected");
    }

    constructor() : QUnit::Test("sandbox isolation composite", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                # the checks run in child Programs, which choose their own execution, so the native compilation is
                # not checked
                assertEq(expected, ExecModeHarness::run(command(execution_mode), ExecModeHarness::NativeCheck::None));
            });
        }
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/sandbox-isolation-composite";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>/dev/null"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
