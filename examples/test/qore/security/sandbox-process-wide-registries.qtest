#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - a signal handler of trusted code delivered to the process after sandboxed code is refused

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class SandboxProcessWideRegistriesTest

#! Process-wide callback registries of the builtin API refuse changes by sandboxed code (issue #6743)
/** A process-wide registry is shared by the code of every Program, and what it holds runs or is used later for every
    caller: a change by code that is sandboxed or acts for sandboxed code raises \c SANDBOX-REGISTRATION-ERROR, also
    through a policy barrier; trusted code is not affected, and what it registered stays in place for every tenant.
    The same applies to the settings of the process-wide async I/O controller (issue #6836), whose loggers and number
    of operations are not disclosed to sandboxed code either
*/
class SandboxProcessWideRegistriesTest inherits QUnit::Test {
    public {
        #! the calls that sandboxed code makes; each must raise SANDBOX-REGISTRATION-ERROR
        const Calls = {
            "set_signal_handler": "set_signal_handler(SIGUSR2, sub (int sig) {});",
            "remove_signal_handler": "remove_signal_handler(SIGUSR2);",
            "set_timer_callback": "AsyncIoController::setTimerCallback(sub (hash<auto> h) {});",
            "clear_timer_callback": "AsyncIoController::setTimerCallback();",
            "set_controller_logger": "AsyncIoController::setLogger(new TL());",
            "clear_controller_logger": "AsyncIoController::setLogger();",
            "set_async_io_logger": "set_async_io_logger(new TL());",
            "clear_async_io_logger": "set_async_io_logger();",
            "set_app_registry": "set_app_registry(\"qore-test-6743\", \"tenant\");",
            "remove_app_registry": "set_app_registry(\"qore-test-6743\");",
            "check_registration": "SandboxManager::checkProcessWideRegistration(\"register a test callback\");",
            "register_exit_hook": "register_exit_hook(sub () {});",
            # the settings of the process-wide async I/O controller (issue #6836); autostop and the number of I/O threads are
            # set to their current values, the callback workers to the default
            "set_autostop": "AsyncIoController::setAutostop(AsyncIoController::getAutostop());",
            "set_max_callback_workers": "AsyncIoController::setMaxCallbackWorkers();",
            "set_max_io_threads": "AsyncIoController::setMaxIoThreads(AsyncIoController::getInfo().io_threads);",
        };

        #! the calls whose API raises an exception of its own
        const CallErrors = {
            "register_exit_hook": "EXIT-HOOK-ERROR",
        };

        #! a logger class of the tenants
        const LoggerSource = "class TL inherits LoggerInterfaceBase {
    logArgs(int level, string message, *softlist<auto> format_args) {}
    bool isEnabledFor(int level) { return True; }
}
";

        #! the application registry key of the test
        const Key = "qore-test-6743";

        #! the code that reads the state of the async I/O controller, as readState() does (issue #6836)
        const ReadStateSource = "string cache_size;
    try {
        cache_size = AsyncIoController::getCacheSize().typeCode() == NT_INT ? \"int\" : \"other\";
    } catch (hash<ExceptionInfo> ex) {
        cache_size = ex.err;
    }
    return {
        \"controller_logger\": exists AsyncIoController::getLogger(),
        \"async_io_logger\": exists get_async_io_logger(),
        \"autostop\": AsyncIoController::getAutostop(),
        \"cache_size\": cache_size,
    };";
    }

    constructor() : Test("process-wide callback registries refuse sandboxed code", "1.0", \ARGV) {
        addTestCase("sandboxed code cannot change a process-wide registry", \sandboxedTest());
        addTestCase("what trusted code registered stays in place for every tenant", \trustedStateTest());
        addTestCase("the settings of the async I/O controller that trusted code made stay in effect",
            \controllerSettingsTest());
        addTestCase("the loggers and the operations of the async I/O controller are not disclosed",
            \controllerStateTest());
        addTestCase("trusted code serving sandboxed code under a policy barrier cannot either", \barrierTest());
        addTestCase("a Program that sandboxed code creates is refused when trusted code calls it",
            \childProgramTest());
        addTestCase("trusted code is not refused", \trustedTest());
        set_return_value(main());
    }

    sandboxedTest() {
        # the calls that were not refused, with what they raised instead
        hash<string, string> not_refused = {};
        foreach hash<auto> i in (Calls.pairIterator()) {
            try {
                Program tenant = SandboxProcessWideRegistriesTest::tenant("tenant-" + i.key, i.key, i.value);
                tenant.callFunction("t_" + i.key);
                not_refused{i.key} = "no exception";
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != (CallErrors{i.key} ?? "SANDBOX-REGISTRATION-ERROR")) {
                    not_refused{i.key} = sprintf("%s: %s", ex.err, ex.desc);
                }
            }
        }
        assertEq({}, not_refused);
    }

    trustedStateTest() {
        set_app_registry(Key, "host");
        on_exit set_app_registry(Key);
        Program tenant_a = SandboxProcessWideRegistriesTest::tenant("tenant-a", "set_app_registry",
            Calls.set_app_registry);
        Program tenant_b = SandboxProcessWideRegistriesTest::tenant("tenant-b", "read",
            sprintf("return get_app_registry(%y);", Key));
        assertThrows("SANDBOX-REGISTRATION-ERROR", \tenant_a.callFunction(), "t_set_app_registry");
        # the host still sees its value; the other tenant does not get the registry (issue #6749)
        assertNothing(tenant_b.callFunction("t_read"));
        assertEq("host", get_app_registry(Key));

        if (HAVE_SIGNAL_HANDLING) {
            Counter c(1);
            set_signal_handler(SIGUSR2, sub (int sig) { c.dec(); });
            on_exit remove_signal_handler(SIGUSR2);
            Program tenant_c = SandboxProcessWideRegistriesTest::tenant("tenant-c", "remove_signal_handler",
                Calls.remove_signal_handler);
            assertThrows("SANDBOX-REGISTRATION-ERROR", \tenant_c.callFunction(), "t_remove_signal_handler");
            # the host's handler still runs
            system(sprintf("kill -USR2 %d", getpid()));
            assertEq(0, c.waitForZero(10s));
        }
    }

    controllerSettingsTest() {
        # the host's settings, restored when the test ends
        bool autostop = AsyncIoController::getAutostop();
        on_exit AsyncIoController::setAutostop(autostop);
        AsyncIoController::setAutostop(!autostop);
        int io_threads = AsyncIoController::getInfo().io_threads;
        # the I/O thread count, if a tenant changed it
        on_exit if (AsyncIoController::getInfo().io_threads != io_threads && !AsyncIoController::running()) {
            AsyncIoController::setMaxIoThreads(io_threads);
        }

        # what each attempt raised, and the settings that the host and another tenant see after it
        hash<auto> results = {};
        hash<auto> host_settings = {"autostop": !autostop, "io_threads": io_threads};
        Program tenant_b = SandboxProcessWideRegistriesTest::tenant("tenant-b", "read",
            "return {\"autostop\": AsyncIoController::getAutostop(), "
            "\"io_threads\": AsyncIoController::getInfo().io_threads};");
        # records the attempt and the settings after it, and gives the host's settings back
        code check = sub (string name, code attempt) {
            try {
                attempt();
                results{name} = "no exception";
            } catch (hash<ExceptionInfo> ex) {
                results{name} = ex.err;
            }
            results{name + " (host)"} = {
                "autostop": AsyncIoController::getAutostop(),
                "io_threads": AsyncIoController::getInfo().io_threads,
            };
            results{name + " (tenant-b)"} = tenant_b.callFunction("t_read");
            AsyncIoController::setAutostop(!autostop);
            if (AsyncIoController::getInfo().io_threads != io_threads && !AsyncIoController::running()) {
                AsyncIoController::setMaxIoThreads(io_threads);
            }
        };

        # one tenant tries to change them
        Program tenant_a = SandboxProcessWideRegistriesTest::tenant("tenant-a", "settings",
            "AsyncIoController::setAutostop(a); AsyncIoController::setMaxCallbackWorkers(1); "
            "AsyncIoController::setMaxIoThreads(n + 1);", "bool a, int n");
        check("tenant", sub () { tenant_a.callFunction("t_settings", autostop, io_threads); });

        # trusted code serving the tenants under a policy barrier
        code cap = SandboxManager::createSystemPolicyCall(sub (bool a, int n) {
            AsyncIoController::setAutostop(a);
            AsyncIoController::setMaxIoThreads(n);
        });
        Program tenant_c = SandboxProcessWideRegistriesTest::tenant("tenant-c", "run", "c(a, n);",
            "code c, bool a, int n");
        check("barrier", sub () { tenant_c.callFunction("t_run", cap, autostop, io_threads + 1); });

        # a Program that a tenant creates, called later by trusted code
        Program tenant_d = SandboxProcessWideRegistriesTest::tenant("tenant-d", "child", "Program p(PO_NEW_STYLE); "
            "p.parse(\"sub autostop(bool a) { AsyncIoController::setAutostop(a); } "
            "sub workers() { AsyncIoController::setMaxCallbackWorkers(1); } "
            "sub io_threads(int n) { AsyncIoController::setMaxIoThreads(n); }\", \"child\"); return p;");
        Program child = tenant_d.callFunction("t_child");
        check("child autostop", sub () { child.callFunction("autostop", autostop); });
        check("child workers", sub () { child.callFunction("workers"); });
        check("child io_threads", sub () { child.callFunction("io_threads", io_threads + 1); });

        hash<auto> expected = {};
        map expected += {
            $1: "SANDBOX-REGISTRATION-ERROR",
            $1 + " (host)": host_settings,
            $1 + " (tenant-b)": host_settings,
        }, ("tenant", "barrier", "child autostop", "child workers", "child io_threads");
        assertEq(expected, results);

        # the host changes them
        AsyncIoController::setAutostop(autostop);
        assertEq(autostop, AsyncIoController::getAutostop());
        AsyncIoController::setMaxCallbackWorkers();
    }

    controllerStateTest() {
        # the loggers of the host, restored when the test ends
        *LoggerInterfaceBase controller_logger = AsyncIoController::getLogger();
        on_exit AsyncIoController::setLogger(controller_logger);
        *object async_io_logger = get_async_io_logger();
        on_exit set_async_io_logger(async_io_logger);
        HostLogger host_controller_logger();
        HostLogger host_async_io_logger();
        AsyncIoController::setLogger(host_controller_logger);
        set_async_io_logger(host_async_io_logger);
        bool autostop = AsyncIoController::getAutostop();

        # what trusted code reads
        hash<auto> trusted = {
            "controller_logger": True,
            "async_io_logger": True,
            "autostop": autostop,
            "cache_size": "int",
        };
        # what code that is sandboxed or acts for sandboxed code reads: the setting, but neither the host's loggers
        # nor the number of the operations of every caller
        hash<auto> sandboxed = {
            "controller_logger": False,
            "async_io_logger": False,
            "autostop": autostop,
            "cache_size": "PERMISSION-DENIED",
        };

        hash<auto> results = {};
        # two tenants with sandboxes of their own
        foreach string name in ("tenant-a", "tenant-b") {
            Program tenant = SandboxProcessWideRegistriesTest::tenant(name, "read", ReadStateSource);
            results{name} = tenant.callFunction("t_read");
        }
        # a background thread of a tenant
        Program tenant_bg = SandboxProcessWideRegistriesTest::tenant("tenant-bg", "bg",
            "code read = hash<auto> sub () { " + ReadStateSource + " }; Queue q(); background q.push(read()); "
            "return q.get();");
        results."background" = tenant_bg.callFunction("t_bg");
        # trusted code serving a tenant under a policy barrier
        code cap = SandboxManager::createSystemPolicyCall(hash<auto> sub () {
            return SandboxProcessWideRegistriesTest::readState();
        });
        Program tenant_c = SandboxProcessWideRegistriesTest::tenant("tenant-c", "run", "return c();", "code c");
        results.barrier = tenant_c.callFunction("t_run", cap);
        # a Program that a tenant creates, called later by trusted code
        Program tenant_d = SandboxProcessWideRegistriesTest::tenant("tenant-d", "child", "Program p(PO_NEW_STYLE); "
            "p.parse(\"hash<auto> sub read() { \" + s + \" }\", \"child\"); return p;", "string s");
        Program child = tenant_d.callFunction("t_child", ReadStateSource);
        results.child = child.callFunction("read");
        # trusted code and a trusted Program
        results.host = SandboxProcessWideRegistriesTest::readState();
        Program trusted_pgm(PO_NEW_STYLE);
        trusted_pgm.parse("hash<auto> sub read() { " + ReadStateSource + " }", "trusted");
        results."trusted Program" = trusted_pgm.callFunction("read");

        hash<auto> expected = {};
        map expected{$1} = sandboxed, ("tenant-a", "tenant-b", "background", "barrier", "child");
        map expected{$1} = trusted, ("host", "trusted Program");
        assertEq(expected, results);
        # the host still has its loggers
        assertEq(host_controller_logger, AsyncIoController::getLogger());
        assertEq(host_async_io_logger, get_async_io_logger());
    }

    #! Reads the state of the async I/O controller as \c ReadStateSource does
    static hash<auto> readState() {
        string cache_size;
        try {
            cache_size = AsyncIoController::getCacheSize().typeCode() == NT_INT ? "int" : "other";
        } catch (hash<ExceptionInfo> ex) {
            cache_size = ex.err;
        }
        return {
            "controller_logger": exists AsyncIoController::getLogger(),
            "async_io_logger": exists get_async_io_logger(),
            "autostop": AsyncIoController::getAutostop(),
            "cache_size": cache_size,
        };
    }

    barrierTest() {
        set_app_registry(Key, "host");
        on_exit set_app_registry(Key);
        # trusted infrastructure that changes the registry for its callers, under a policy barrier
        code cap = SandboxManager::createSystemPolicyCall(sub () { set_app_registry(Key, "tenant"); });
        Program tenant = SandboxProcessWideRegistriesTest::tenant("tenant", "run", "return c();", "code c");
        assertThrows("SANDBOX-REGISTRATION-ERROR", \tenant.callFunction(), ("t_run", cap));
        assertEq("host", get_app_registry(Key));

        # an exit hook that the tenant gives to such infrastructure
        code exit_cap = SandboxManager::createSystemPolicyCall(int sub (code hook) { return register_exit_hook(hook); });
        Program tenant_hook = SandboxProcessWideRegistriesTest::tenant("tenant-hook", "run_hook",
            "return c(sub () {});", "code c");
        assertThrows("EXIT-HOOK-ERROR", \tenant_hook.callFunction(), ("t_run_hook", exit_cap));
    }

    childProgramTest() {
        set_app_registry(Key, "host");
        on_exit set_app_registry(Key);
        # a Program that sandboxed code creates has no sandbox manager of its own; trusted code calls it later
        Program tenant = SandboxProcessWideRegistriesTest::tenant("tenant", "child", "Program p(PO_NEW_STYLE); "
            "p.parse(\"sub set() { set_app_registry('qore-test-6743', 'tenant'); } "
            "bool sub allowed() { return SandboxManager::isProcessWideRegistrationAllowed(); }\", \"child\"); "
            "return p;");
        Program child = tenant.callFunction("t_child");
        assertFalse(child.callFunction("allowed"));
        assertThrows("SANDBOX-REGISTRATION-ERROR", \child.callFunction(), "set");
        assertEq("host", get_app_registry(Key));
    }

    trustedTest() {
        # a trusted Program: no sandbox
        Program trusted(PO_NEW_STYLE);
        trusted.parse("auto sub check() { SandboxManager::checkProcessWideRegistration(\"register a test "
            "callback\"); return SandboxManager::isProcessWideRegistrationAllowed(); }", "trusted");
        assertTrue(trusted.callFunction("check"));
        Program tenant = SandboxProcessWideRegistriesTest::tenant("tenant", "allowed",
            "return SandboxManager::isProcessWideRegistrationAllowed();");
        assertFalse(tenant.callFunction("t_allowed"));
        set_app_registry(Key, "host");
        assertEq("host", get_app_registry(Key));
        set_app_registry(Key);
        assertNothing(get_app_registry(Key));
    }

    #! Returns a sandboxed Program with one function
    private static Program tenant(string name, string func, string body, *string args) {
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS, True);
        p.parse(sprintf("auto sub t_%s(%s) { %s }\n", func, args ?? "", body) + LoggerSource, name);
        p.setSandboxManager(new SandboxManager());
        return p;
    }
}

#! a logger of the host
class HostLogger inherits LoggerInterfaceBase {
    logArgs(int level, string message, *softlist<auto> format_args) {
    }

    bool isEnabledFor(int level) {
        return True;
    }
}
