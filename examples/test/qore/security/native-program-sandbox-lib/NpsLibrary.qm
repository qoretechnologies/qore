# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# A library module for native-program-sandbox.qtest (issue #5659): the test puts this directory in the process-wide
# module path, so the module is library code also when sandboxed code loads it first.  Its class and the Program
# that its initialization creates are trusted code.

%modern

module NpsLibrary {
    version = "1.0";
    desc = "library code that sandboxed code loads first";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = \NpsLibrary::init();
}

public namespace NpsLibrary {
    #! the Program that the initialization of the module creates
    our Program InitProgram;

    #! creates the Program; called when the module is initialized
    sub init() {
        InitProgram = new Program(PO_NEW_STYLE);
    }

    #! returns the Program that the initialization of the module created
    public Program sub init_program() {
        return InitProgram;
    }

    #! a class whose destructor reaches a cancellation point
    public class Res {
        private {
            Queue ev;
        }

        constructor(Queue ev) {
            self.ev = ev;
        }

        destructor() {
            Mutex m();
            m.lock();
            m.unlock();
            ev.push("dtor");
        }
    }

    #! reaches a cancellation point
    public sub point() {
        Mutex m();
        m.lock();
        m.unlock();
    }

    #! returns an object of the class
    public Res sub make(Queue ev) {
        return new Res(ev);
    }
}
