#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# The threads of a ThreadPool (its own thread and its workers) count against the thread limit of the sandbox of the
# Program that created the pool, if that Program has a SandboxManager (qore#5635): creating a pool without a free slot
# raises THREAD-CREATION-FAILURE; a pool cannot start more workers than the sandbox has free thread slots, so its
# queued tasks wait for its busy workers; a pool that has no worker and cannot start one refuses a task with
# THREAD-CREATION-FAILURE in the submitting code; a worker stops counting when it leaves the pool, and the pool's own
# thread when the pool stops.  A pool created by a Program without a sandbox manager is not limited; a module loaded by
# a sandboxed Program has the loader's sandbox, so its pools are counted.
#
# Whether a worker holds a slot is checked deterministically with a probe: a Program that shares the SandboxManager
# and starts threads with the background operator, which the sandbox refuses when all of its slots are held.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}"
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires QUnit
%requires SandboxThreadFixture

%exec-class ThreadPoolThreadLimitTest

class ThreadPoolThreadLimitTest inherits QUnit::Test {
    #! the code of the Program that creates the pool and submits tasks to it
    const PoolSource = "
ThreadPool sub make_pool(int max_threads, int min_idle = 0, int max_idle = 0) {
    return new ThreadPool(max_threads, min_idle, max_idle);
}

# submits n tasks that each report their start and then wait on the gate; returns True for each task submitted or the
# exception that refused it, which this code handles
list<auto> sub submit(ThreadPool tp, int n, Queue started, Queue gate) {
    list<auto> rv = ();
    for (int i = 0; i < n; ++i) {
        try {
            tp.submit(sub () {
                started.push(True);
                gate.get(60s);
            });
            rv += True;
        } catch (hash<ExceptionInfo> ex) {
            rv += sprintf(\"%s: %s\", ex.err, ex.desc);
        }
    }
    return rv;
}
";

    #! the code of the Program that probes the free slots of the sandbox
    const ProbeSource = "
# starts n threads that each wait on the gate; returns the TID of each or the exception that refused it
list<auto> sub start_blocked(int n, Queue gate) {
    list<auto> rv = ();
    for (int i = 0; i < n; ++i) {
        try {
            rv += background gate.get(60s);
        } catch (hash<ExceptionInfo> ex) {
            rv += sprintf(\"%s: %s\", ex.err, ex.desc);
        }
    }
    return rv;
}
";

    constructor() : QUnit::Test("ThreadPool thread limit", "1.0", \ARGV) {
        addTestCase("the workers of a pool count against its creator's sandbox", \testWorkersCount());
        addTestCase("the limit refuses a task in the submitting code when the pool has no worker",
            \testSubmitRefused());
        addTestCase("a restricted Program cannot exceed its limit with a pool", \testRestricted());
        addTestCase("idle workers beyond the limit are not started", \testMinIdle());
        addTestCase("the workers stop counting when the pool stops", \testRelease());
        addTestCase("a pool created without a sandbox is not limited", \testUnsandboxedCreator());
        addTestCase("a sandbox without a limit counts but does not limit the workers", \testNoLimit());
        addTestCase("the pool keeps the sandbox of its creation", \testManagerReplaced());
        addTestCase("the pool's own thread counts", \testPoolThread());
        addTestCase("workers that leave the pool after each task release their slots", \testWorkerLeaves());
        addTestCase("stopping a pool whose tasks wait for a slot", \testStopWaiting());
        addTestCase("a pool created by a module counts against the module Program's sandbox", \testModulePool());
        addTestCase("a slot released by another thread of the sandbox wakes a waiting pool",
            \testSlotReleasedElsewhere());
        addTestCase("a task waiting for a slot can be submitted by a task of the same pool",
            \testNestedSubmit());
        addTestCase("raising the thread limit wakes a waiting pool", \testLimitRaised());
        addTestCase("a slot that another pool releases wakes a waiting pool", \testOtherPoolWakes());
        set_return_value(main());
    }

    #! releases n waiting threads
    private static release(Queue gate, int n) {
        for (int i = 0; i < n; ++i) {
            gate.push(True);
        }
    }

    #! waits for n start reports
    private static waitStarted(Queue started, int n) {
        for (int i = 0; i < n; ++i) {
            started.get(60s);
        }
    }

    #! waits until each thread in the list has ended; elements that are not TIDs are ignored
    private joinAll(list<auto> l) {
        foreach auto tid in (l) {
            if (tid.typeCode() == NT_INT) {
                assertTrue(thread_join(tid, 60s), sprintf("thread %d ended", tid));
            }
        }
    }

    #! returns the Program that creates the pool, with the given sandbox
    private static Program getPoolProgram(*SandboxManager sm, int opts = PO_NEW_STYLE, *ExecMode mode) {
        Program p(opts);
        if (exists mode) {
            p.setExecMode(mode);
            p.parse("%modern\n" + PoolSource, "pool");
        } else {
            p.parse(PoolSource, "pool");
        }
        if (sm) {
            p.setSandboxManager(sm);
        }
        return p;
    }

    #! returns a Program that probes the free slots of the given sandbox
    private static Program getProbe(SandboxManager sm) {
        Program p(PO_NEW_STYLE);
        p.parse(ProbeSource, "probe");
        p.setSandboxManager(sm);
        return p;
    }

    #! returns the expected error for a thread refused at the given limit
    private static string refused(int max_threads) {
        return sprintf("THREAD-CREATION-FAILURE: cannot start a thread: sandbox thread limit of %d reached",
            max_threads);
    }

    #! returns the number of threads the probe can start at once in the given sandbox, up to n, and ends them
    /** Asking for one more thread than the limit also detects a slot that was released twice.
    */
    private int freeSlots(Program probe, int n) {
        Queue gate();
        list<auto> l = probe.callFunction("start_blocked", n, gate);
        list<auto> tids = select l, $1.typeCode() == NT_INT;
        release(gate, tids.size());
        joinAll(tids);
        return tids.size();
    }

    testWorkersCount() {
        # the pool's own thread and two workers
        SandboxManager sm();
        sm.setMaxThreads(3);
        Program p = getPoolProgram(sm);
        Program probe = getProbe(sm);
        ThreadPool tp = p.callFunction("make_pool", 10);
        Queue started();
        Queue gate();
        on_exit {
            release(gate, 10);
            tp.stopWait();
        }
        # ten tasks for a pool that allows ten workers: the sandbox allows two besides the pool's own thread
        assertEq((map True, xrange(10)), p.callFunction("submit", tp, 10, started, gate));
        waitStarted(started, 2);
        # all slots are held by the pool
        Queue probe_gate();
        list<auto> l = probe.callFunction("start_blocked", 1, probe_gate);
        assertEq((refused(3),), l, "the probe cannot start a thread while the pool holds the slots");
        # each task that ends lets the next one run on a worker that is free again
        for (int i = 2; i < 10; ++i) {
            gate.push(True);
            started.get(60s);
        }
        release(gate, 2);
        tp.stopWait();
        assertEq(3, freeSlots(probe, 4), "the slots are free after the pool stopped");
    }

    testSubmitRefused() {
        # in every execution mode of the Program that submits, the failure is raised in its code, which handles it
        hash<string, ExecMode> modes = {"ast": EM_AST, "ir": EM_IR, "jit": EM_JIT, "tiered": EM_TIERED};
        foreach string name in (keys modes) {
            # the pool's own thread holds one slot
            SandboxManager sm();
            sm.setMaxThreads(2);
            Program p = getPoolProgram(sm, PO_NEW_STYLE, modes{name});
            Program probe = getProbe(sm);
            ThreadPool tp = p.callFunction("make_pool", 4);
            Queue started();
            Queue gate();
            Queue probe_gate();
            list<auto> probe_threads;
            on_exit {
                release(gate, 1);
                release(probe_gate, 1);
                joinAll(probe_threads);
                tp.stopWait();
            }
            # another thread of the sandbox holds its other slot
            probe_threads = probe.callFunction("start_blocked", 1, probe_gate);
            assertEq(NT_INT, probe_threads[0].typeCode(), name);
            assertEq((refused(2),), p.callFunction("submit", tp, 1, started, gate), name);
            # once the slot is free, the pool starts a worker for the next task
            probe_gate.push(True);
            joinAll(probe_threads);
            probe_threads = ();
            assertEq((True,), p.callFunction("submit", tp, 1, started, gate), name);
            started.get(60s);
        }
    }

    testRestricted() {
        # a Program that cannot start threads itself, as in the review of qore#5635: before the fix, its pool ran ten
        # workers under a limit of two; here the pool's own thread and two workers fill a limit of three
        SandboxManager sm();
        sm.setMaxThreads(3);
        Program p = getPoolProgram(sm, PO_NEW_STYLE | PO_NO_THREAD_CONTROL);
        Program probe = getProbe(sm);
        ThreadPool tp = p.callFunction("make_pool", 10);
        Queue started();
        Queue gate();
        on_exit {
            release(gate, 10);
            tp.stopWait();
        }
        assertEq((map True, xrange(10)), p.callFunction("submit", tp, 10, started, gate));
        waitStarted(started, 2);
        assertEq(0, freeSlots(probe, 1), "the pool holds all slots");
        release(gate, 10);
        waitStarted(started, 8);
        tp.stopWait();
        assertEq(3, freeSlots(probe, 4), "the slots are free after the pool stopped");
    }

    testMinIdle() {
        # the pool wants four idle workers; the sandbox allows two besides the pool's own thread, and the pool does not
        # report an error
        SandboxManager sm();
        sm.setMaxThreads(3);
        Program p = getPoolProgram(sm);
        Program probe = getProbe(sm);
        ThreadPool tp = p.callFunction("make_pool", 4, 4, 4);
        Queue started();
        Queue gate();
        on_exit {
            release(gate, 4);
            tp.stopWait();
        }
        assertEq((map True, xrange(4)), p.callFunction("submit", tp, 4, started, gate));
        waitStarted(started, 2);
        assertEq(0, freeSlots(probe, 1), "the pool holds all slots");
        release(gate, 4);
        waitStarted(started, 2);
        tp.stopWait();
        assertEq(3, freeSlots(probe, 4), "the slots are free after the pool stopped");
    }

    testRelease() {
        SandboxManager sm();
        sm.setMaxThreads(4);
        Program p = getPoolProgram(sm);
        Program probe = getProbe(sm);
        # several pools one after the other: each can use all slots only if the previous one released them
        for (int round = 0; round < 3; ++round) {
            ThreadPool tp = p.callFunction("make_pool", 3, 3, 3);
            Queue started();
            Queue gate();
            on_exit {
                release(gate, 3);
                tp.stopWait();
            }
            assertEq((True, True, True), p.callFunction("submit", tp, 3, started, gate), "round " + round);
            waitStarted(started, 3);
            assertEq(0, freeSlots(probe, 1), "round " + round);
            release(gate, 3);
            tp.stopWait();
            assertEq(4, freeSlots(probe, 5), "round " + round);
        }
        # a pool that is destroyed without stopWait() releases its slots too
        {
            ThreadPool tp = p.callFunction("make_pool", 2, 2, 2);
            Queue started();
            Queue gate();
            assertEq((True, True), p.callFunction("submit", tp, 2, started, gate));
            waitStarted(started, 2);
            release(gate, 2);
            # stop() waits for the workers to end
            delete tp;
        }
        assertEq(4, freeSlots(probe, 5), "the slots are free after the pool was deleted");
    }

    testUnsandboxedCreator() {
        # the pool is created by a Program without a sandbox (like a module Program) and used for sandboxed code
        SandboxManager sm();
        sm.setMaxThreads(1);
        Program creator = getPoolProgram();
        Program p = getPoolProgram(sm);
        Program probe = getProbe(sm);
        ThreadPool tp = creator.callFunction("make_pool", 3);
        Queue started();
        Queue gate();
        on_exit {
            release(gate, 3);
            tp.stopWait();
        }
        assertEq((True, True, True), p.callFunction("submit", tp, 3, started, gate));
        waitStarted(started, 3);
        assertEq(1, freeSlots(probe, 1), "the workers of a pool created without a sandbox do not count");
    }

    testNoLimit() {
        SandboxManager sm();
        Program p = getPoolProgram(sm);
        ThreadPool tp = p.callFunction("make_pool", 6);
        Queue started();
        Queue gate();
        on_exit {
            release(gate, 6);
            tp.stopWait();
        }
        assertEq((map True, xrange(6)), p.callFunction("submit", tp, 6, started, gate));
        # all six tasks run at once
        waitStarted(started, 6);
    }

    testManagerReplaced() {
        # the pool's own thread and one worker
        SandboxManager sm1();
        sm1.setMaxThreads(2);
        SandboxManager sm2();
        sm2.setMaxThreads(5);
        Program p = getPoolProgram(sm1);
        Program probe1 = getProbe(sm1);
        Program probe2 = getProbe(sm2);
        ThreadPool tp = p.callFunction("make_pool", 3);
        # the Program gets another sandbox after it created the pool
        p.setSandboxManager(sm2);
        Queue started();
        Queue gate();
        on_exit {
            release(gate, 3);
            tp.stopWait();
        }
        assertEq((True, True, True), p.callFunction("submit", tp, 3, started, gate));
        waitStarted(started, 1);
        assertEq(0, freeSlots(probe1, 1), "the worker holds the slot of the sandbox of the pool's creation");
        assertEq(5, freeSlots(probe2, 6), "the worker does not count against the Program's new sandbox");
        release(gate, 3);
        waitStarted(started, 2);
    }

    testPoolThread() {
        SandboxManager sm();
        sm.setMaxThreads(2);
        Program p = getPoolProgram(sm);
        Program probe = getProbe(sm);
        ThreadPool tp1 = p.callFunction("make_pool", 1);
        on_exit tp1.stopWait();
        assertEq(1, freeSlots(probe, 3), "a pool without workers holds the slot of its own thread");
        ThreadPool tp2 = p.callFunction("make_pool", 1);
        on_exit tp2.stopWait();
        assertEq(0, freeSlots(probe, 1), "two pools hold both slots");
        assertThrows("THREAD-CREATION-FAILURE", "sandbox thread limit of 2 reached", \p.callFunction(),
            ("make_pool", 1), "a pool cannot be created without a free slot");
        tp1.stopWait();
        tp2.stopWait();
        assertEq(2, freeSlots(probe, 3), "the slots are free after the pools stopped");

        # many pools, as in the review of qore#5635, are refused at the limit
        SandboxManager sm3();
        sm3.setMaxThreads(3);
        Program p3 = getPoolProgram(sm3, PO_NEW_STYLE | PO_NO_THREAD_CONTROL);
        list<ThreadPool> pools = ();
        on_exit {
            map $1.stopWait(), pools;
        }
        int refusals = 0;
        for (int i = 0; i < 20; ++i) {
            try {
                pools += p3.callFunction("make_pool", 1);
            } catch (hash<ExceptionInfo> ex) {
                assertEq("THREAD-CREATION-FAILURE", ex.err);
                ++refusals;
            }
        }
        assertEq(3, pools.size(), "only three pools can be created under a limit of three");
        assertEq(17, refusals);
    }

    testWorkerLeaves() {
        # with no idle workers kept (max_idle_threads 0, idle_release_timeout 0), a worker leaves the pool when its
        # task ends and the queue is empty, and the next task gets a new worker
        SandboxManager sm();
        sm.setMaxThreads(2);
        Program p(PO_NEW_STYLE);
        p.parse("ThreadPool sub make_pool() { return new ThreadPool(1, 0, 0, 0); }
auto sub run(ThreadPool tp, Queue result, int i) { tp.submit(sub () { result.push(i); }); }", "leaves");
        p.setSandboxManager(sm);
        Program probe = getProbe(sm);
        ThreadPool tp = p.callFunction("make_pool");
        on_exit tp.stopWait();
        Queue result();
        for (int i = 0; i < 10; ++i) {
            p.callFunction("run", tp, result, i);
            assertEq(i, result.get(60s));
        }
        tp.stopWait();
        assertEq(2, freeSlots(probe, 3), "no slot is leaked or released twice when workers leave the pool");
    }

    testStopWaiting() {
        # one worker under the limit; the second task waits for it; stopping the pool runs or cancels every task
        SandboxManager sm();
        sm.setMaxThreads(2);
        Program p(PO_NEW_STYLE);
        p.parse("ThreadPool sub make_pool() { return new ThreadPool(4); }
sub submit(ThreadPool tp, Queue started, Queue gate, Queue result, int i) {
    tp.submit(sub () { started.push(True); gate.get(60s); result.push(\"ran\"); },
        sub () { result.push(\"cancelled\"); });
}", "stop");
        p.setSandboxManager(sm);
        Program probe = getProbe(sm);
        ThreadPool tp = p.callFunction("make_pool");
        Queue started();
        Queue gate();
        Queue result();
        p.callFunction("submit", tp, started, gate, result, 0);
        p.callFunction("submit", tp, started, gate, result, 1);
        started.get(60s);
        Queue stopped();
        date start = now_us();
        int tid = background (sub () { tp.stop(); stopped.push(True); })();
        on_exit thread_join(tid);
        release(gate, 2);
        assertEq(True, stopped.get(60s), "stop() returns");
        # the pool's thread stops at once instead of waiting idle_release_timeout (5s) to retry getting a worker
        assertLt(4s, now_us() - start, "stop() does not wait to retry");
        list<string> outcomes = (result.get(60s), result.get(60s));
        assertEq("ran", outcomes[0], "the running task ends");
        assertTrue(outcomes[1] == "ran" || outcomes[1] == "cancelled", "the waiting task runs or is cancelled");
        assertEq(2, freeSlots(probe, 3), "the slots are free after the pool stopped");
    }

    testModulePool() {
        # a sandboxed Program loads a module first (this script does not load it), and the module's Program gets the
        # loader's sandbox
        SandboxManager sm();
        sm.setMaxThreads(2);
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(sm);
        p.parse("%requires SandboxPoolFixture
ThreadPool sub make_pool(int n) { return SandboxPoolFixture::make_pool(n); }", "module-loader");
        Program probe = getProbe(sm);
        ThreadPool tp = p.callFunction("make_pool", 2);
        on_exit tp.stopWait();
        assertEq(1, freeSlots(probe, 3), "the pool created by the module holds a slot of the loader's sandbox");
        tp.stopWait();
        assertEq(2, freeSlots(probe, 3), "the slot is free after the pool stopped");

        # a module that this unsandboxed script loaded first: its Program has no sandbox, so its pool is not counted
        # against a sandboxed caller
        SandboxManager sm2();
        sm2.setMaxThreads(1);
        Program p2(PO_NEW_STYLE);
        p2.parse("ThreadPool sub make_pool(int n) { return SandboxThreadFixture::Runner::makePool(n); }", "caller");
        p2.setSandboxManager(sm2);
        Program probe2 = getProbe(sm2);
        ThreadPool tp2 = p2.callFunction("make_pool", 2);
        on_exit tp2.stopWait();
        assertEq(1, freeSlots(probe2, 2), "a pool created by a module Program without a sandbox is not counted");
    }

    testSlotReleasedElsewhere() {
        # the pool's own thread, one worker and a thread of the probe fill the limit; the queued task must start when
        # the probe's thread ends, although the pool's worker stays busy
        SandboxManager sm();
        sm.setMaxThreads(3);
        Program p = getPoolProgram(sm);
        Program probe = getProbe(sm);
        ThreadPool tp = p.callFunction("make_pool", 4);
        Queue started();
        Queue gate();
        Queue probe_gate();
        list<auto> probe_threads;
        on_exit {
            release(gate, 2);
            release(probe_gate, 1);
            joinAll(probe_threads);
            tp.stopWait();
        }
        assertEq((True,), p.callFunction("submit", tp, 1, started, gate));
        started.get(60s);
        probe_threads = probe.callFunction("start_blocked", 1, probe_gate);
        assertEq(NT_INT, probe_threads[0].typeCode());
        # the second task is queued: no slot is free and the only worker is busy
        assertEq((True,), p.callFunction("submit", tp, 1, started, gate));
        assertEq(0, freeSlots(probe, 1), "the sandbox has no free slot while the second task waits");
        # the probe's thread ends and frees a slot: the pool starts a worker for the waiting task
        probe_gate.push(True);
        joinAll(probe_threads);
        probe_threads = ();
        assertEq(True, started.get(60s), "the waiting task starts when another thread of the sandbox ends");
        release(gate, 2);
        tp.stopWait();
        assertEq(3, freeSlots(probe, 4), "the slots are free after the pool stopped");
    }

    testNestedSubmit() {
        # a task submits another task to its own pool and waits for it; a slot freed elsewhere lets the second task run
        # instead of the pool waiting for the first task, which waits for the second
        SandboxManager sm();
        sm.setMaxThreads(3);
        Program p(PO_NEW_STYLE);
        p.parse("ThreadPool sub make_pool() { return new ThreadPool(4); }
sub run(ThreadPool tp, Queue started, Queue result) {
    tp.submit(sub () {
        started.push(True);
        Queue inner();
        tp.submit(sub () { inner.push(\"inner\"); });
        result.push(inner.get(60s));
    });
}", "nested");
        p.setSandboxManager(sm);
        Program probe = getProbe(sm);
        ThreadPool tp = p.callFunction("make_pool");
        Queue probe_gate();
        list<auto> probe_threads;
        on_exit {
            release(probe_gate, 1);
            joinAll(probe_threads);
            tp.stopWait();
        }
        # the probe holds the slot that the inner task needs
        probe_threads = probe.callFunction("start_blocked", 1, probe_gate);
        assertEq(NT_INT, probe_threads[0].typeCode());
        Queue started();
        Queue result();
        p.callFunction("run", tp, started, result);
        started.get(60s);
        probe_gate.push(True);
        joinAll(probe_threads);
        probe_threads = ();
        assertEq("inner", result.get(60s), "the inner task runs once a slot is free");
    }

    testLimitRaised() {
        # the pool's own thread and a busy worker fill the limit, and a second task waits
        SandboxManager sm();
        sm.setMaxThreads(2);
        Program p = getPoolProgram(sm);
        ThreadPool tp = p.callFunction("make_pool", 4);
        Queue started();
        Queue gate();
        on_exit {
            release(gate, 2);
            tp.stopWait();
        }
        assertEq((True, True), p.callFunction("submit", tp, 2, started, gate));
        started.get(60s);
        # the host raises the limit: the waiting task gets a worker while the first one stays busy
        sm.setMaxThreads(3);
        assertEq(True, started.get(60s), "the waiting task starts when the limit is raised");
    }

    testOtherPoolWakes() {
        # two pools in one sandbox: pool A's thread and worker, and pool B's thread and worker fill a limit of 4; B's
        # second task waits until A releases a slot, either because A's worker leaves A after its task or because A
        # stops
        foreach string how in (("worker-leaves", "stop")) {
            SandboxManager sm();
            sm.setMaxThreads(4);
            Program p(PO_NEW_STYLE);
            # pool A keeps no idle worker (max_idle_threads 0, idle_release_timeout 0), so its worker leaves after its
            # task
            p.parse(PoolSource + "ThreadPool sub make_leaving_pool() { return new ThreadPool(1, 0, 0, 0); }", "pools");
            p.setSandboxManager(sm);
            Program probe = getProbe(sm);
            ThreadPool a = p.callFunction("make_leaving_pool");
            ThreadPool b = p.callFunction("make_pool", 4);
            Queue a_started();
            Queue a_gate();
            Queue b_started();
            Queue b_gate();
            on_exit {
                release(a_gate, 1);
                release(b_gate, 2);
                a.stopWait();
                b.stopWait();
            }
            assertEq((True,), p.callFunction("submit", a, 1, a_started, a_gate), how);
            a_started.get(60s);
            assertEq((True, True), p.callFunction("submit", b, 2, b_started, b_gate), how);
            b_started.get(60s);
            assertEq(0, freeSlots(probe, 1), how + ": the pools hold all slots");
            # A's task ends; A releases its worker's slot (it leaves A), or A stops and releases both of its slots
            a_gate.push(True);
            if (how == "stop") {
                a.stopWait();
            }
            assertEq(True, b_started.get(60s), how + ": B's waiting task starts when A releases a slot");
            release(b_gate, 2);
            a.stopWait();
            b.stopWait();
            assertEq(4, freeSlots(probe, 5), how + ": the slots are free after the pools stopped");
        }
    }
}
