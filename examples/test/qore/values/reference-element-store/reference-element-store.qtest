#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of the stores of container elements and object members

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ReferenceElementStoreTest

#! An assignment of an element or a member that holds a reference is made through it (issue #6661)
/** The AST interpreter assigns an element of a container (a hash key, a list element) or a member of an object that
    holds a reference through the reference (LValueHelper::doLValue()); the stores of the IR interpreter and of native
    code replaced the element instead, which raised RUNTIME-TYPE-ERROR for a container typed to hold references and
    silently replaced the reference otherwise.

    reference-element-store-worker.q makes such assignments (typed and untyped hashes and lists, variables and
    literals, constant and dynamic keys, a negative index, object members from outside and inside a method, a type
    error of the referenced lvalue); its output must be the one in reference-element-store.expected (that of the AST
    interpreter) in every execution mode, on the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class ReferenceElementStoreTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/reference-element-store-worker.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/reference-element-store.expected");
    }

    constructor() : QUnit::Test("assignments through references held in elements", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/reference-element-store";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
