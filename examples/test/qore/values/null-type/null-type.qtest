#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%include null-type-checks.qi

%exec-class NullTypeTest

#! Tests that NULL is a value of type NULL in every execution engine, however the engine holds it
/** The checks in null-type-checks.qi run in this program, in each execution mode, and from a compiled (AOT) module;
    every engine must give the same results, and every check must pass.  In a debug build of the library, the C++
    unit tests also check every QoreValue accessor with NULL held inline and as the NULL node.
*/
class NullTypeTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;
        #! the results of the checks in this program
        list<string> expected;
    }

    constructor() : QUnit::Test("NullTypeTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("in this program", \testInProcess());
        addTestCase("each execution mode", \testExecModes());
        addTestCase("a compiled module", \testCompiledModule());
        addTestCase("the QoreValue accessors", \testAccessors());
        set_return_value(main());
    }

    globalSetUp() {
        expected = NullTypeChecks::get_results();
    }

    testInProcess() {
        checkResults("in-process", expected);
        # ten checks, each run three times
        assertEq(30, expected.size(), "every check ran");
    }

    testExecModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = runWorker("null-type-worker.q", get_script_dir(),
                "--exec-mode=" + mode);
            checkWorkerOutput(mode, r.stdout, r.stderr);
            checkEngine(mode, r.trace);
        }
    }

    testCompiledModule() {
        TmpDir tmp("qore-null-type-");
        string qmod_path = tmp.path + DirSep + "NullTypeChecks.qmod";
        string src_path = get_script_dir() + DirSep + "NullTypeChecks.qm";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output "
            "%s %s 2>&1", libqore_dir, qore_bin, qmod_path, src_path));
        assertTrue(is_file(qmod_path), "compiled checks module: " + compile_out);

        # the directory holds only the compiled module, so the worker cannot load the source instead
        hash<ExecModeHarness::ModeRunResult> r = runWorker("null-type-module-worker.q", tmp.path);
        checkWorkerOutput("aot", r.stdout, r.stderr);
    }

    testAccessors() {
        # run_debug_unit_tests() is registered only in a library built with DEBUG; it is looked up when the test
        # runs, so that a release build parses this test
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the C++ unit tests are only in debug builds of the library");
        }
        hash<auto> res = call_function("run_debug_unit_tests");
        assertGt(0, res.test_count, "the C++ unit tests ran");
        assertEq(0, res.fail_count, sprintf("all %d C++ unit test assertions passed", res.test_count));
    }

    #! runs a worker with the given module directory and options and returns its output and compilation trace
    /** ExecModeHarness runs it with synchronous native compilation that follows the first call of a function, so
        with --exec-mode=jit or tiered the first pass runs with the IR interpreter and the second one as native code;
        native code must have been compiled with JIT and tiered execution and none with AST and IR execution
    */
    private hash<ExecModeHarness::ModeRunResult> runWorker(string worker_name, string module_dir, string opts = "") {
        string worker = get_script_dir() + DirSep + worker_name;
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("LD_LIBRARY_PATH=%s "
            "DYLD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b %s %s", libqore_dir, libqore_dir, module_dir, qore_bin,
            opts, worker));
        if (r.mode) {
            ExecModeHarness::check_native(r, ExecModeHarness::NativeCheck::JitAndTiered);
        }
        return r;
    }

    #! checks that a worker ran the checks with the engine named by its execution mode
    /** No code is compiled to native code with the AST or the IR interpreter; with JIT and tiered execution the
        functions with the checks are compiled after their first call, so the second pass runs them as native code
    */
    private checkEngine(string mode, list<string> trace) {
        if (mode == "ast" || mode == "ir") {
            assertEq((), trace, mode + ": no code is compiled to native code");
        } else {
            list<string> promoted = select trace, $1 =~ /promoted/ && $1 =~ /'member_types@/;
            assertTrue(promoted.size() > 0, mode + ": the checks run as native code: " + trace.join("\n"));
        }
    }

    #! compares the lines printed by a worker with the results of the checks in this program
    private checkWorkerOutput(string label, string out, string err) {
        assertEq("", err, label + ": no error output");
        list<string> results = select out.split("\n"), $1.val();
        checkResults(label, results);
        # the worker runs the checks twice
        assertEq(expected + expected, results, label + ": the same checks as in this program, twice");
    }

    #! checks that every check passed
    private checkResults(string label, list<string> results) {
        assertTrue(results.size() > 0, label + ": checks ran");
        foreach string line in (results) {
            assertTrue(line =~ /^ok /, label + ": " + line);
        }
    }
}
