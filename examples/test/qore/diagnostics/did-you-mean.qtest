#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class DidYouMeanTest

#! Tests "did you mean ...?" near-match suggestions in identifier-resolution parse errors
public class DidYouMeanTest inherits QUnit::Test {
    constructor() : Test("DidYouMeanTest", "1.0") {
        addTestCase("bareword constant typo", \testConstantTypo());
        addTestCase("bareword local var typo", \testLocalVarTypo());
        addTestCase("bareword global var typo", \testGlobalVarTypo());
        addTestCase("bareword case mismatch", \testCaseMismatch());
        addTestCase("class constant typo", \testClassConstantTypo());
        addTestCase("undefined class typo", \testUndefinedClassTypo());
        addTestCase("no false suggestion", \testNoFalseSuggestion());
        addTestCase("transposition typo", \testTranspositionTypo());
        addTestCase("undefined type typo", \testUndefinedTypeTypo());
        addTestCase("undefined function typo", \testUndefinedFunctionTypo());
        addTestCase("undefined hashdecl type typo", \testUndefinedHashDeclTypo());
        addTestCase("bareword in constant initializer", \testBarewordInConstantInitializer());
        addTestCase("constant typo in constant initializer", \testConstantTypoInConstantInitializer());
        set_return_value(main());
    }

    #! parses the code and returns the concatenated error text across the whole exception chain (or NOTHING)
    private *string parseErrText(string code) {
        Program p(PO_NEW_STYLE);
        try {
            p.parse(code, "");
        } catch (hash<ExceptionInfo> ex) {
            string txt;
            *hash<ExceptionInfo> e = ex;
            while (e) {
                txt += sprintf("%s: %s\n", e.err, e.desc);
                e = e.next;
            }
            return txt;
        }
        return NOTHING;
    }

    testConstantTypo() {
        Program p(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", "did you mean 'MY_TIMEOUT'", \p.parse(),
            ("const MY_TIMEOUT = 100; int sub t() { return MY_TIMEOUTT; }", ""));
    }

    testLocalVarTypo() {
        Program p(PO_NEW_STYLE);
        # in %new-style bare references are enabled, so a misspelled local var is an unresolved bareword
        assertThrows("PARSE-EXCEPTION", "did you mean 'myCount'", \p.parse(),
            ("int sub t() { int myCount = 3; return myCountt; }", ""));
    }

    testGlobalVarTypo() {
        Program p(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", "did you mean 'myGlobal'", \p.parse(),
            ("our int myGlobal; int sub t() { return myGloball; }", ""));
    }

    testCaseMismatch() {
        Program p(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", "did you mean 'MyConst'.*check capitalization", \p.parse(),
            ("const MyConst = 5; int sub t() { return myconst; }", ""));
    }

    testClassConstantTypo() {
        Program p(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", "did you mean 'TIMEOUT'", \p.parse(),
            ("class C { public { const TIMEOUT = 10; } int m() { return TIMEOUTT; } }", ""));
    }

    testUndefinedClassTypo() {
        Program p(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", "did you mean 'MyClass'", \p.parse(),
            ("class MyClass {} MyClass sub t() { return new MyClasss(); }", ""));
    }

    testNoFalseSuggestion() {
        Program p(PO_NEW_STYLE);
        # a name with no near match must not produce a spurious suggestion
        *string desc;
        try {
            p.parse("int sub t() { return zzqqxxww; }", "");
        } catch (hash<ExceptionInfo> ex) {
            desc = ex.desc;
        }
        assertEq(True, exists desc, "parse must fail");
        assertEq(False, desc =~ /did you mean/, "no suggestion for an unrelated name");
    }

    testTranspositionTypo() {
        Program p(PO_NEW_STYLE);
        # adjacent transposition (Damerau): 'VALEU' -> 'VALUE' is edit distance 1
        assertThrows("PARSE-EXCEPTION", "did you mean 'VALUE'", \p.parse(),
            ("const VALUE = 42; int sub t() { return VALEU; }", ""));
    }

    testUndefinedTypeTypo() {
        *string txt = parseErrText("class MyWidget {} MyWidgett sub t() { return new MyWidget(); }");
        assertEq(True, exists txt, "parse must fail");
        assertRegex("reference to undefined type 'MyWidgett'; did you mean 'MyWidget'", txt);
    }

    testUndefinedFunctionTypo() {
        *string txt = parseErrText("int sub compute() { return 1; } int sub t() { return computee(); }");
        assertEq(True, exists txt, "parse must fail");
        assertRegex("function 'computee\\(\\)' cannot be found; did you mean 'compute'", txt);
    }

    testUndefinedHashDeclTypo() {
        *string txt = parseErrText("hashdecl MyData { int a; } hash<MyDataa> sub t() { return new hash<MyData>(); }");
        assertEq(True, exists txt, "parse must fail");
        assertRegex("undefined hashdecl 'MyDataa'; did you mean 'MyData'", txt);
    }

    testBarewordInConstantInitializer() {
        # regression: an unresolvable bareword in a constant initializer used to crash the
        # parser with a null deref. Constant parsing pushes a block-marker VNode with no
        # lvar onto the local-variable stack, and the "did you mean" suggestion code walked
        # that stack and dereferenced the marker's missing lvar. It must now produce a clean
        # parse error instead of a segfault.
        Program p(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", "cannot resolve bareword 'nonexistent_bareword'", \p.parse(),
            ("const C = nonexistent_bareword;", ""));
    }

    testConstantTypoInConstantInitializer() {
        # the local-var stack walk must be skipped safely (leading marker VNode) yet still
        # surface the constant near-match suggestion from the constant-initializer context
        Program p(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", "did you mean 'MY_BASE'", \p.parse(),
            ("const MY_BASE = 1; const DERIVED = MY_BASEE + 1;", ""));
    }
}
