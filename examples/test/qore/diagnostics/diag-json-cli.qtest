#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class DiagJsonCliTest

#! Tests the standalone interpreter's --diag-format=json structured-diagnostics emitter
public class DiagJsonCliTest inherits QUnit::Test {
    constructor() : Test("DiagJsonCliTest", "1.0") {
        addTestCase("json error output", \testJsonError());
        addTestCase("json empty for clean program", \testJsonClean());
        addTestCase("json language trap warning", \testJsonLanguageTrapWarning());
        addTestCase("json via environment variable", \testJsonEnv());
        addTestCase("json error for a module that fails to load", \testJsonModuleLoadError());
        set_return_value(main());
    }

    private string qoreBin() {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? ENV.QORE_EXECUTABLE ?? QORE_ARGV[0] ?? ARGV[0];
        assertTrue(exists qore_bin, "no qore binary path available");
        return qore_bin;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }

    private string runDiag(string src, *hash<string, string> env_over) {
        string env_prefix = "";
        if (exists env_over) {
            foreach string k in (keys env_over) {
                env_prefix += sprintf("%s=%s ", k, env_over{k});
            }
        }
        # capture stdout only (diagnostics mode prints the JSON array to stdout and suppresses text output)
        string cmd = sprintf("%s%s --diag-format=json -e %s 2>/dev/null",
            env_prefix, qoreBin(), shellQuote(src));
        return backquote(cmd);
    }

    private string runTrapDiag(string src) {
        string cmd = sprintf("%s --diag-format=json --enable-warning=language-traps -e %s 2>/dev/null",
            qoreBin(), shellQuote(src));
        return backquote(cmd);
    }

    private string runEnv(string src) {
        string cmd = sprintf("QORE_DIAG_FORMAT=json %s -e %s 2>/dev/null",
            qoreBin(), shellQuote(src));
        return backquote(cmd);
    }

    testJsonError() {
        string out = runDiag("class MyWidget {} MyWidget sub f() { return new MyWidgett(); }");
        assertRegex("\"severity\":\"error\"", out);
        assertRegex("\"code\":\"PARSE-EXCEPTION\"", out);
        assertRegex("\"id\":\"PARSE-EXCEPTION\"", out);
        assertRegex("\"hint\":null", out);
        assertRegex("\"suggestions\":\\[\\]", out);
        assertRegex("\"facts\":\\{\\}", out);
        assertRegex("\"relatedLocations\":\\[\\]", out);
        assertRegex("\"fixes\":\\[\\]", out);
        assertRegex("undefined class 'MyWidgett'; did you mean 'MyWidget'", out);
        # a real column span must be present (a positive integer)
        assertRegex("\"startColumn\":[0-9]+", out);
        assertFalse(out =~ /"startColumn":-1/, "the error should carry a real column");
    }

    #! Writes a module that fails to load and a script that requires it; returns the script path
    private static string writeBrokenModuleScript(string dir) {
        mkdir(dir + "/mods", 0700, True);
        File m();
        m.open2(dir + "/mods/DiagBroken.qm", O_CREAT | O_WRONLY | O_TRUNC);
        m.write("%modern\nmodule DiagBroken {\n    version = \"1.0\";\n    desc = \"test\";\n"
            "    author = \"test\";\n    url = \"https://qore.org\";\n}\n"
            "public namespace DiagBroken {\n    public int sub f() { return undefined_function(); }\n}\n");
        File s();
        s.open2(dir + "/use.q", O_CREAT | O_WRONLY | O_TRUNC);
        s.write("%modern\n%requires DiagBroken\nint x = 1;\n");
        return dir + "/use.q";
    }

    #! Removes the files written by writeBrokenModuleScript()
    private static removeBrokenModuleScript(string dir) {
        unlink(dir + "/mods/DiagBroken.qm");
        rmdir(dir + "/mods");
        unlink(dir + "/use.q");
        rmdir(dir);
    }

    testJsonModuleLoadError() {
        string dir = sprintf("%s/diag-json-module-%d", ENV.TMPDIR ?? "/tmp", getpid());
        string script = DiagJsonCliTest::writeBrokenModuleScript(dir);
        on_exit {
            DiagJsonCliTest::removeBrokenModuleScript(dir);
        }
        int rc;
        string out = backquote(sprintf("QORE_MODULE_DIR=%s %s --diag-format=json %s 2>/dev/null",
            DiagJsonCliTest::shellQuote(dir + "/mods"), qoreBin(), DiagJsonCliTest::shellQuote(script)), \rc);
        assertEq(2, rc, "exit code 2 for an error");
        assertRegex("\"severity\":\"error\"", out, "the error is reported, not an empty list");
        assertRegex("function 'undefined_function\\(\\)' cannot be found \\(while loading user module "
            "\\\\\"DiagBroken\\\\\"", out);
        # the error is placed at the %requires directive in the script, where an editor shows it
        assertRegex("\"file\":\"[^\"]*use.q\"", out);
        assertRegex("\"startLine\":2,\"endLine\":2", out);
    }

    testJsonClean() {
        string out = runDiag("int sub f() { return 1; }");
        assertEq("[]", trim(out), "clean program emits an empty JSON array");
    }

    testJsonLanguageTrapWarning() {
        string out = runTrapDiag("nothing sub f() { int x; int y = x; }");
        assertRegex("\"severity\":\"warning\"", out);
        assertRegex("\"code\":\"LANGUAGE-TRAP\"", out);
        assertRegex("\"id\":\"UNINITIALIZED-LOCAL-READ\"", out);
        assertRegex("\"variable\":\"x\"", out);
        assertRegex("initialize 'x' before this read", out);
    }

    testJsonEnv() {
        string out = runEnv("int sub f() { return undefinedxyz; }");
        assertRegex("\"severity\":\"error\"", out);
        assertRegex("cannot resolve bareword 'undefinedxyz'", out);
    }
}
