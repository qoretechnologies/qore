#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class EnumExhaustiveSwitchTest

#! Tests the non-exhaustive-switch warning for switches over enum values
public class EnumExhaustiveSwitchTest inherits QUnit::Test {
    public {
        const EnumDecl = "enum Color : int { Red = 1, Green = 2, Blue = 3, }\n";
    }

    constructor() : Test("EnumExhaustiveSwitchTest", "1.0") {
        addTestCase("missing one member", \testMissingMember());
        addTestCase("missing two members", \testMissingTwoMembers());
        addTestCase("all members covered", \testAllCovered());
        addTestCase("default present", \testDefaultPresent());
        addTestCase("non-enum operand", \testNonEnumOperand());
        addTestCase("relational case suppresses", \testRelationalCase());
        addTestCase("warning off when masked out", \testMaskedOut());
        set_return_value(main());
    }

    #! parses the code with only the non-exhaustive-switch warning enabled and returns the warning info (if any)
    private *hash<ExceptionInfo> parseWarn(string code, int mask = WARN_NONEXHAUSTIVE_SWITCH) {
        Program p(PO_NEW_STYLE);
        return p.parse(code, "", mask);
    }

    testMissingMember() {
        *hash<ExceptionInfo> w = parseWarn(EnumDecl
            + "int sub f(Color c) { switch (c) { case Color::Red: return 1; case Color::Green: return 2; } return 0; }");
        assertEq(True, exists w, "a warning must be raised");
        assertEq("NON-EXHAUSTIVE-SWITCH", w.err);
        assertRegex("Blue", w.desc);
        assertRegex("does not handle 1 of its values", w.desc);
    }

    testMissingTwoMembers() {
        *hash<ExceptionInfo> w = parseWarn(EnumDecl
            + "int sub f(Color c) { switch (c) { case Color::Red: return 1; } return 0; }");
        assertEq(True, exists w, "a warning must be raised");
        assertEq("NON-EXHAUSTIVE-SWITCH", w.err);
        assertRegex("does not handle 2 of its values", w.desc);
        assertRegex("Green", w.desc);
        assertRegex("Blue", w.desc);
    }

    testAllCovered() {
        *hash<ExceptionInfo> w = parseWarn(EnumDecl
            + "int sub f(Color c) { switch (c) { case Color::Red: return 1; case Color::Green: return 2; "
            + "case Color::Blue: return 3; } return 0; }");
        assertEq(NOTHING, w, "no warning when every member is handled");
    }

    testDefaultPresent() {
        *hash<ExceptionInfo> w = parseWarn(EnumDecl
            + "int sub f(Color c) { switch (c) { case Color::Red: return 1; default: return 0; } }");
        assertEq(NOTHING, w, "a default: label silences the warning");
    }

    testNonEnumOperand() {
        *hash<ExceptionInfo> w = parseWarn(
            "int sub f(int c) { switch (c) { case 1: return 1; case 2: return 2; } return 0; }");
        assertEq(NOTHING, w, "no warning for a non-enum switch operand");
    }

    testRelationalCase() {
        # a relational case block means coverage cannot be determined, so no warning is raised
        *hash<ExceptionInfo> w = parseWarn(EnumDecl
            + "int sub f(Color c) { switch (c) { case < Color::Blue: return 1; } return 0; }");
        assertEq(NOTHING, w, "no warning when a relational case is present");
    }

    testMaskedOut() {
        # the same non-exhaustive switch must not warn when the warning is not in the mask
        *hash<ExceptionInfo> w = parseWarn(EnumDecl
            + "int sub f(Color c) { switch (c) { case Color::Red: return 1; } return 0; }",
            WARN_DEPRECATED);
        assertEq(NOTHING, w, "no warning when non-exhaustive-switch is masked out");
    }
}
