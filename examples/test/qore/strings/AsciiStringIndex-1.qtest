%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires ../../ExecModeHarness.qm
%include AsciiStringIndex.qc

%exec-class AsciiStringIndexPart1

#! runs part 1 of 3 of the cases of AsciiStringIndexBase: the native checks
class AsciiStringIndexPart1 inherits AsciiStringIndexBase {
    constructor() : AsciiStringIndexBase("AsciiStringIndexPart1", 1) {
    }
}
