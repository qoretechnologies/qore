#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - CJK multi-byte encodings as the system iconv supports them, and their probing

# Copyright 2026 Qore Technologies, s.r.o.

# The character functions of the multi-byte encodings (EUC, Shift_JIS, GBK, Big5, UHC, Johab) count the bytes that
# are characters of the encoding by its definition: a byte or byte sequence that is never a character of the encoding
# is invalid on every platform (issue #6665).  isEncodingValid() and the conversions take validity from the
# platform's iconv, which can accept such bytes as vendor or user-defined characters or decode an incomplete sequence,
# so the test checks them against a conversion of the same bytes.  A well-formed double-byte sequence that is not
# assigned to a character is not checked by the character functions; the conversions refuse it.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit

%exec-class DbcsByteStructureTest

class DbcsByteStructureTest inherits QUnit::Test {
    public {
        #! a sample text in each encoding, to check that the system iconv supports it
        const Samples = {
            "Shift_JIS": "日本語",
            "CP932": "日本語",
            "Windows-31J": "日本語",
            "EUC-JP": "日本語ｱ",
            "EUC-KR": "한국어",
            "GB2312": "中文",
            "GBK": "中文丂",
            "WINDOWS-936": "中文丂",
            "Big5": "繁體中文",
            "CP950": "繁體中文",
            "CP949": "한국어갂",
            "JOHAB": "한국어",
        };

        #! the cases of each encoding: the bytes between "A" and "B", and the number of characters that they are, or -1
        #! if they are not characters of the encoding by its definition (a byte or a first byte outside it, a first
        #! byte followed by a byte that is not one of its second bytes, or an incomplete SS2 or SS3 sequence), which
        #! the character functions refuse on every platform.  isEncodingValid() and the conversions take the validity
        #! of such bytes from the platform's iconv (see the character encoding page), which can map them as vendor or
        #! user-defined characters or decode a sequence that is not complete (ex: macOS decodes the Shift_JIS
        #! user-defined area 0xF040 and a lone EUC-JP SS2 byte 0x8E, which glibc refuses; glibc decodes 0x80 in Big5
        #! as U+0080), so their isEncodingValid() is checked against a conversion of the same bytes with the
        #! platform's iconv, not against a fixed result
        const Cases = {
            "Shift_JIS": {
                "80": -1, "a0": -1, "fd": -1, "f040": -1, "82a0": 1, "a1": 1, "8140": 1,
            },
            "CP932": {
                "80": -1, "a0": -1, "fd": -1, "fe": -1, "ff": -1, "fa40": 1, "a1": 1, "8140": 1,
            },
            "Windows-31J": {
                "80": -1, "a0": -1, "fd": -1, "ff": -1, "fa40": 1,
            },
            "EUC-JP": {
                # C1 control characters (JIS X 0208 Annex 1)
                "80": 1, "9f": 1,
                # SS2 and a JIS X 0201 kana
                "8ea1": 1, "8edf": 1, "8ee0": -1, "8e": -1,
                # SS3 and JIS X 0212
                "8fa1a1": 1, "8fa1": -1,
                "a1a1": 1, "a0": -1, "ff": -1, "a1a0": -1,
            },
            "EUC-KR": {
                # C1 control characters (KS X 2901); SS2 and SS3 are not used
                "80": 1, "8e": 1, "8f": 1, "8ea1a1": 2,
                "b0a1": 1, "a0": -1, "ff": -1, "b0a0": -1,
            },
            "GB2312": {
                "80": -1, "8ea1": -1, "8fa1a1": -1, "b0a1": 1, "a0": -1,
            },
            "GBK": {
                # the euro sign in its code page
                "80": 1, "ff": -1, "8140": 1, "817f": -1, "81ff": -1, "8180": 1,
            },
            "WINDOWS-936": {
                "80": 1, "ff": -1, "8140": 1, "817f": -1,
            },
            "Big5": {
                "80": -1, "a140": 1, "a1a1": 1, "a180": -1, "a1a0": -1, "8140": -1, "fa40": -1, "ff": -1,
            },
            "CP950": {
                "80": -1, "8140": 1, "a180": -1, "f9fe": 1, "ff": -1,
            },
            "CP949": {
                "80": -1, "8141": 1, "815b": -1, "817b": -1, "8181": 1, "b0a1": 1, "ff": -1,
            },
            "JOHAB": {
                "80": -1, "8441": 1, "8431": -1, "d931": 1, "d991": 1, "d941": 1, "d441": -1, "d971": 1,
                "d980": -1, "fa41": -1,
            },
        };
    }

    constructor() : QUnit::Test("DbcsByteStructureTest", "1.0", \ARGV) {
        addTestCase("character functions", \testCharacters());
        set_return_value(main());
    }

    #! returns True if the system iconv supports the encoding
    private bool supported(string enc) {
        try {
            return convert_encoding(convert_encoding(Samples{enc}, enc), "UTF-8") == Samples{enc};
        } catch (hash<ExceptionInfo> ex) {
            return False;
        }
    }

    #! returns True if the system iconv converts the string to UTF-8
    private bool converts(string str) {
        try {
            convert_encoding(str, "UTF-8");
            return True;
        } catch (hash<ExceptionInfo> ex) {
            return False;
        }
    }

    testCharacters() {
        int checked = 0;
        foreach hash<auto> i in (Cases.pairIterator()) {
            string enc = i.key;
            if (!supported(enc)) {
                continue;
            }
            foreach hash<auto> c in (i.value.pairIterator()) {
                string label = sprintf("%s <%s>", enc, c.key);
                string str = binary_to_string(<41> + parse_hex_string(c.key) + <42>, enc);
                if (c.value < 0) {
                    assertThrows("INVALID-ENCODING", \str.length(), NOTHING, label + ": length()");
                    assertThrows("INVALID-ENCODING", \str.substr(), 2, label + ": substr()");
                    # valid as the platform's iconv converts it
                    assertEq(converts(str), str.isEncodingValid(), label + ": isEncodingValid() as iconv");
                } else {
                    assertEq(c.value + 2, str.length(), label + ": length()");
                    assertEq("B", convert_encoding(str.substr(-1), "UTF-8"), label + ": the last character");
                }
                ++checked;
            }
        }
        # the encodings are supported on the platforms that run the test
        assertTrue(checked > 0);
    }
}
