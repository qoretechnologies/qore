#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - UTF-16LE conversion with the system iconv and byte searches in JIT and qcc-compiled code

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ByteOffsetsTest

#! Regression test for issue #6271: byte positions of bindex() and brindex()
/** brindex() did not find a match that ends at the search position, which rindex() finds, and bindex() with a
    negative position gave no match where index() searches from the resolved position; the C++ API's
    QoreString::findAny() searched for the whole string instead of any of its bytes.  <binary>::find() gave -1 for a
    negative offset before the start, where the string search functions search from the start (issue #6281).

    ByteOffsets.q checks bindex(), brindex(), index(), rindex(), <string>::find(), <string>::rfind(),
    <binary>::find() and <binary>::rfind() for texts in ISO-8859-1, UTF-8 and UTF-16LE at every position against a
    reference implementation over the text's bytes and characters; its output must be the one in
    ByteOffsets.expected in every execution mode, on the IR tier and in programs compiled with qcc -O0 and -O3.  The
    native executable qore-byte-offsets-test (byte_offsets.cpp) checks the C++ overloads of bindex(), brindex(),
    find(), rfind(), findAny() and rfindAny().
*/
class ByteOffsetsTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/ByteOffsets.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/ByteOffsets.expected");
    }

    constructor() : QUnit::Test("byte positions of bindex() and brindex()", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });
        addTestCase("native C++ API", \native());

        set_return_value(main());
    }

    private native() {
        string native = ENV.QORE_BYTE_OFFSETS_TEST ?? dirname(qore_bin) + "/qore-byte-offsets-test";
        if (!is_file(native)) {
            testSkip("the native byte offset test executable is not available");
            return;
        }
        int rc;
        string output = backquote(shellQuote(native) + " 2>&1", \rc);
        assertEq(0, rc, output);
        assertTrue(output.startsWith("PASS: "), output);
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/byte-offsets";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
