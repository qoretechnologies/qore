#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of closure-bound local variables and their references

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ReferenceCycleScopeExitTest

#! Regression test for issue #7329: a cycle of references between local variables is freed when the function returns
/** A local variable whose reference is taken (\c \a) is closure-bound, a heap variable that the cycle collector walks.
    The type of a variable that holds a reference (\c reference r = \a) said that it needs no scan, so the collector took
    the variable for a leaf, never followed its reference back to the variable it refers to, and a cycle of references
    (\c a = \r) was never freed: valgrind reported it as lost at exit.  A cycle that a closure can still reach through
    one of its variables is not freed until the closure is gone.

    ReferenceCycleScopeExit.q makes the cycles and prints the results of the closures that use them; its output must be
    the one in ReferenceCycleScopeExit.expected in every execution mode, on the IR tier and in programs compiled with qcc
    -O0 and -O3; and under valgrind nothing may be lost, with the program ended normally (the leak is only visible
    then).
*/
class ReferenceCycleScopeExitTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/ReferenceCycleScopeExit.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/ReferenceCycleScopeExit.expected");
    }

    constructor() : QUnit::Test("a cycle of references between local variables is freed at scope exit", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("valgrind: nothing is lost", \valgrindTest());
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! runs the fixture under valgrind in each execution mode that valgrind can run: no byte may be lost, as the cycles
    #! are made in functions and the program ends normally
    valgrindTest() {
        if (system("valgrind --version > /dev/null 2>&1")) {
            testSkip("valgrind is not available");
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        foreach string mode in (("ast", "ir")) {
            string log = sprintf("%s/valgrind-%s.log", dir, mode);
            string cmd = sprintf("QORE_PCRE2_NO_JIT=1 valgrind --leak-check=full --log-file=%s "
                "--errors-for-leak-kinds=definite,indirect --error-exitcode=9 %s -b --enable-debug --exec-mode=%s %s "
                "2>&1", shellQuote(log), shellQuote(qore_bin), mode, shellQuote(fixture));
            assertEq(expected, backquote(cmd), "output under valgrind, " + mode);
            string report = ReadOnlyFile::readTextFile(log);
            assertTrue(report =~ /definitely lost: 0 bytes in 0 blocks/, "nothing definitely lost, " + mode + ": " + report);
            assertTrue(report =~ /indirectly lost: 0 bytes in 0 blocks/, "nothing indirectly lost, " + mode);
            assertTrue(report =~ /ERROR SUMMARY: 0 errors/, "no errors, " + mode);
        }
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/reference-cycle-scope-exit";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
