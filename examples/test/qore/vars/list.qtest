#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/QUnit.qm

# Allow child Program objects to have more liberal permissions than the parent.
%no-child-restrictions

%exec-class ListTest

hashdecl T {
    int i = 0;
}

auto sub test_4355(Counter c) {
    on_exit c.dec();
    list<auto> l = map "string-" + sprintf("%05d", $#), xrange(0, 3000);
    return sort(l);
}

auto sub test_4355_stable(Counter c) {
    on_exit c.dec();
    list<auto> l = map "string-" + sprintf("%05d", $#), xrange(0, 10000);
    return sort_stable(l);
}

public class ListTest inherits QUnit::Test {
    constructor() : Test("ListTest", "1.0") {
        addTestCase("list test", \listTest());
        addTestCase("reverse iterator native fast path", \reverseIterFastPathTest());
        addTestCase("line iterator native fast path", \lineIterFastPathTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    # Regression test: ReverseIterator family must iterate backwards when
    # driven through AbstractIteratorHelper (foreach / map / select / foldl),
    # not just when next() is called explicitly.  The native fast-path
    # introduced in 2026-04 inherits from forward priv classes, so reverse
    # subclasses must override nativeNext to call prev() instead of next().
    reverseIterFastPathTest() {
        list<int> l = (1, 2, 3, 4, 5);

        # ListReverseIterator via foreach
        ListReverseIterator lri(l);
        list<int> got = ();
        foreach int v in (lri) { got += v; }
        assertEq((5, 4, 3, 2, 1), got);

        # ListReverseIterator via map
        ListReverseIterator lri2(l);
        assertEq((50, 40, 30, 20, 10), (map $1 * 10, lri2));

        # HashListReverseIterator via foreach
        hash<auto> data = {"col1": (1, 2, 3), "col2": ("a", "b", "c")};
        HashListReverseIterator hlri(data);
        list<hash<auto>> rows = ();
        foreach hash<auto> row in (hlri) { rows += row; }
        assertEq(({"col1": 3, "col2": "c"}, {"col1": 2, "col2": "b"}, {"col1": 1, "col2": "a"}), rows);

        # ListHashReverseIterator via foreach
        list<auto> lh = ({"x": 1, "y": 10}, {"x": 2, "y": 20}, {"x": 3, "y": 30});
        ListHashReverseIterator lhri(lh);
        list<auto> hr = ();
        foreach auto row in (lhri) { hr += row; }
        assertEq(({"x": 3, "y": 30}, {"x": 2, "y": 20}, {"x": 1, "y": 10}), hr);

        # SingleValueIterator via foreach
        SingleValueIterator svi(42);
        list<auto> sv = ();
        foreach auto v in (svi) { sv += v; }
        assertEq((42,), sv);

        # SingleValueIterator with NOTHING (yields nothing)
        SingleValueIterator svn(NOTHING);
        list<auto> svn_got = ();
        foreach auto v in (svn) { svn_got += v; }
        assertEq(0, svn_got.size());

        # ListHashIterator via foreach must yield rows (hashes), not raw
        # list elements — prior bug would inherit ListIterator's fast path
        # and bypass the hash type-check in getRow().
        ListHashIterator lhi(lh);
        list<auto> rows_fwd = ();
        foreach auto row in (lhi) { rows_fwd += row; }
        assertEq(({"x": 1, "y": 10}, {"x": 2, "y": 20}, {"x": 3, "y": 30}), rows_fwd);

        # HashListIterator via foreach yields rows in column-major order.
        HashListIterator hli(data);
        list<auto> rows_hl = ();
        foreach auto row in (hli) { rows_hl += row; }
        assertEq(({"col1": 1, "col2": "a"}, {"col1": 2, "col2": "b"}, {"col1": 3, "col2": "c"}), rows_hl);
    }

    lineIterFastPathTest() {
        # DataLineIterator: in-memory, fast path via nativeNext(xsink)/nativeGetValue.
        string data = "alpha\nbeta\ngamma\n";

        DataLineIterator it(data);
        list<string> got = ();
        foreach string line in (it) { got += line; }
        assertEq(("alpha", "beta", "gamma"), got);

        # map composition exercises native fast path.
        DataLineIterator it2(data);
        list<int> sizes = map $1.size(), it2;
        assertEq((5, 4, 5), sizes);

        # Empty input
        DataLineIterator empty("");
        list<string> empty_got = ();
        foreach string line in (empty) { empty_got += line; }
        assertEq(0, empty_got.size());

        # No trailing newline still yields the line
        DataLineIterator nonl("solo");
        list<string> nonl_got = ();
        foreach string line in (nonl) { nonl_got += line; }
        assertEq(("solo",), nonl_got);
    }

    listTest() {
        # issue #4355
        {
            Counter c(1);
            background test_4355(c);
            c.waitForZero();
            assertTrue(True);
        }

        {
            Counter c(1);
            background test_4355_stable(c);
            c.waitForZero();
            assertTrue(True);
        }

        hash<string, list<hash<T>>> h();
        {
            list<string> l0 = h.keys();
            assertEq(True, l0.complexType());
            any l1 = h.keys();
            assertEq(False, l1.complexType());
            l1 += 1;
            assertEq(1, l1[0]);
        }
        {
            # assigning a complex type to a list lvalue strips the type info
            list l = new list<int>();
            assertEq(False, l.complexType());
        }
        {
            list<int> l();
            l = map $1, l, $1;
            assertEq(True, l.complexType());
            assertEq("list<int>", l.fullType());
            assertEq((), l);
            l = map $1, l;
            assertEq(True, l.complexType());
            assertEq("list<int>", l.fullType());
            assertEq((), l);
            l = select l, $1;
            assertEq(True, l.complexType());
            assertEq("list<int>", l.fullType());
            assertEq((), l);
            assertEq(1, test(new list<int>(), new list<string>()));
        }
        {
            Program p(PO_NEW_STYLE);
            p.parse("list sub t() {string line = 'a+b,c'; any x; x = (line =~ x/(.)\\+(.*)/); x[1] = split(',', x[1]); return x[1];}", "");
            assertEq(("b", "c"), p.callFunction("t"));
        }
        {
            list l;
            l += 1;
            assertEq((1,), l);
        }
        {
            list<auto> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            list<int> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            softlist l;
            l += 1;
            assertEq((1,), l);
        }
        {
            softlist<auto> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            softlist<int> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *list l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *list<auto> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *list<int> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *softlist l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *softlist<auto> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *softlist<int> l;
            l += 1;
            assertEq((1,), l);
        }

        {
            code t = auto sub(int i) { return <StatInfo>{}; };
            auto v = 1;
            list<auto> l = (1, t(v));
            assertEq("hash<StatInfo>", l[1].fullType());
        }
    }

    int test(list<int> l1, list<string> l2) {
        return 1;
    }
}
