#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/FsUtil.qm

# Allow child Program objects to have more liberal permissions than the parent.
%no-child-restrictions

%exec-class ListTest

hashdecl T {
    int i = 0;
}

# Helper for ObjectIterator family tests; member declaration order
# determines iteration order (matches the runtime member hash).
class Foo {
    public {
        int x = 1;
        int y = 2;
        int z = 3;
    }
}

auto sub test_4355(Counter c) {
    on_exit c.dec();
    list<auto> l = map "string-" + sprintf("%05d", $#), xrange(0, 3000);
    return sort(l);
}

auto sub test_4355_stable(Counter c) {
    on_exit c.dec();
    list<auto> l = map "string-" + sprintf("%05d", $#), xrange(0, 10000);
    return sort_stable(l);
}

public class ListTest inherits QUnit::Test {
    constructor() : Test("ListTest", "1.0") {
        addTestCase("list test", \listTest());
        addTestCase("reverse iterator native fast path", \reverseIterFastPathTest());
        addTestCase("line iterator native fast path", \lineIterFastPathTest());
        addTestCase("hash/object iterator native fast path", \hashObjectIterFastPathTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    # Regression test: ReverseIterator family must iterate backwards when
    # driven through AbstractIteratorHelper (foreach / map / select / foldl),
    # not just when next() is called explicitly.  The native fast-path
    # introduced in 2026-04 inherits from forward priv classes, so reverse
    # subclasses must override nativeNext to call prev() instead of next().
    reverseIterFastPathTest() {
        list<int> l = (1, 2, 3, 4, 5);

        # ListIterator<T> carries the list element type through AbstractIterator<T>.
        ListIterator<int> li(l);
        AbstractIterator<int> typed_li = li;
        assertTrue(typed_li instanceof AbstractIterator<int>);
        assertFalse(typed_li instanceof AbstractIterator<auto>);
        assertTrue(typed_li.next());
        int first = typed_li.getValue();
        assertEq(1, first);

        object pseudo_li = l.iterator();
        assertTrue(pseudo_li instanceof ListIterator<int>);
        assertTrue(pseudo_li instanceof AbstractIterator<int>);
        assertFalse(pseudo_li instanceof AbstractIterator<auto>);

        # ListReverseIterator via foreach
        ListReverseIterator<int> lri(l);
        assertTrue(lri instanceof ListReverseIterator<int>);
        assertTrue(lri instanceof ListIterator<int>);
        assertFalse(lri instanceof AbstractIterator<auto>);
        list<int> got = ();
        foreach int v in (lri) { got += v; }
        assertEq((5, 4, 3, 2, 1), got);

        # ListReverseIterator via map
        ListReverseIterator<int> lri2(l);
        assertEq((50, 40, 30, 20, 10), (map $1 * 10, lri2));

        # HashListReverseIterator via foreach
        hash<auto> data = {"col1": (1, 2, 3), "col2": ("a", "b", "c")};
        HashListReverseIterator hlri(data);
        list<hash<auto>> rows = ();
        foreach hash<auto> row in (hlri) { rows += row; }
        assertEq(({"col1": 3, "col2": "c"}, {"col1": 2, "col2": "b"}, {"col1": 1, "col2": "a"}), rows);

        # ListHashReverseIterator via foreach
        list<auto> lh = ({"x": 1, "y": 10}, {"x": 2, "y": 20}, {"x": 3, "y": 30});
        ListHashReverseIterator lhri(lh);
        list<auto> hr = ();
        foreach auto row in (lhri) { hr += row; }
        assertEq(({"x": 3, "y": 30}, {"x": 2, "y": 20}, {"x": 1, "y": 10}), hr);

        # SingleValueIterator via foreach
        SingleValueIterator<int> svi(42);
        AbstractIterator<int> typed_svi = svi;
        assertTrue(typed_svi instanceof AbstractIterator<int>);
        assertFalse(typed_svi instanceof AbstractIterator<auto>);
        list<auto> sv = ();
        foreach auto v in (svi) { sv += v; }
        assertEq((42,), sv);

        # SingleValueIterator with NOTHING (yields nothing)
        SingleValueIterator svn(NOTHING);
        list<auto> svn_got = ();
        foreach auto v in (svn) { svn_got += v; }
        assertEq(0, svn_got.size());

        # ListHashIterator via foreach must yield rows (hashes), not raw
        # list elements — prior bug would inherit ListIterator's fast path
        # and bypass the hash type-check in getRow().
        ListHashIterator lhi(lh);
        list<auto> rows_fwd = ();
        foreach auto row in (lhi) { rows_fwd += row; }
        assertEq(({"x": 1, "y": 10}, {"x": 2, "y": 20}, {"x": 3, "y": 30}), rows_fwd);

        # HashListIterator via foreach yields rows in column-major order.
        HashListIterator hli(data);
        list<auto> rows_hl = ();
        foreach auto row in (hli) { rows_hl += row; }
        assertEq(({"col1": 1, "col2": "a"}, {"col1": 2, "col2": "b"}, {"col1": 3, "col2": "c"}), rows_hl);
    }

    lineIterFastPathTest() {
        # InputStreamLineIterator
        {
            StringInputStream sis("alpha\nbeta\ngamma\n");
            InputStreamLineIterator isli(sis, "UTF-8");
            list<string> got = ();
            foreach string line in (isli) { got += line; }
            assertEq(("alpha", "beta", "gamma"), got);
        }

        # FileLineIterator
        {
            FsUtil::TmpFile tmp("qore_iterfp", ".txt");
            tmp.file.printf("one\ntwo\nthree\n");
            tmp.file.close();
            FileLineIterator typed_fli(tmp.path);
            AbstractIterator<string> typed_file = typed_fli;
            assertTrue(typed_file instanceof AbstractIterator<string>);
            assertFalse(typed_file instanceof AbstractIterator<auto>);
            assertTrue(typed_file.next());
            string first = typed_file.getValue();
            assertEq("one", first);

            FileLineIterator fli(tmp.path);
            list<string> got = ();
            foreach string line in (fli) { got += line; }
            assertEq(("one", "two", "three"), got);
        }

        # DataLineIterator: in-memory, fast path via nativeNext(xsink)/nativeGetValue.
        string data = "alpha\nbeta\ngamma\n";

        DataLineIterator it(data);
        AbstractIterator<string> typed_data = it;
        assertTrue(typed_data instanceof AbstractIterator<string>);
        assertFalse(typed_data instanceof AbstractIterator<auto>);
        assertTrue(typed_data.next());
        string first = typed_data.getValue();
        assertEq("alpha", first);

        DataLineIterator it_foreach(data);
        list<string> got = ();
        foreach string line in (it_foreach) { got += line; }
        assertEq(("alpha", "beta", "gamma"), got);

        # map composition exercises native fast path.
        DataLineIterator it2(data);
        list<int> sizes = map $1.size(), it2;
        assertEq((5, 4, 5), sizes);

        # Empty input
        DataLineIterator empty("");
        list<string> empty_got = ();
        foreach string line in (empty) { empty_got += line; }
        assertEq(0, empty_got.size());

        # No trailing newline still yields the line
        DataLineIterator nonl("solo");
        list<string> nonl_got = ();
        foreach string line in (nonl) { nonl_got += line; }
        assertEq(("solo",), nonl_got);
    }

    hashObjectIterFastPathTest() {
        # All three hash views (value / key / pair) and reverse variants
        # share QoreHashIterator priv; the fast path branches on a view-mode
        # flag set by the QPP ctor.  Verify each Qore class yields the right
        # shape through foreach (drives AbstractIteratorHelper -> fast path).
        hash<string, int> h = {"a": 1, "b": 2, "c": 3};

        object pseudo_hi = h.iterator();
        assertTrue(pseudo_hi instanceof HashIterator<int>);
        assertTrue(pseudo_hi instanceof AbstractIterator<int>);
        assertFalse(pseudo_hi instanceof AbstractIterator<auto>);

        # Forward: VIEW_VALUE
        HashIterator<int> hi(h);
        AbstractIterator<int> typed_hi = hi;
        assertTrue(typed_hi instanceof AbstractIterator<int>);
        assertFalse(typed_hi instanceof AbstractIterator<auto>);
        list<auto> vals = ();
        foreach auto v in (hi) { vals += v; }
        assertEq((1, 2, 3), vals);
        HashIterator<int> hi_get(h);
        assertTrue(hi_get.next());
        int hv = hi_get.getValue();
        int hkv = hi_get.getKeyValue();
        assertEq(1, hv);
        assertEq(1, hkv);

        # Forward: VIEW_KEY
        HashKeyIterator hki(h);
        assertTrue(hki instanceof HashIterator<auto>);
        assertTrue(hki instanceof AbstractIterator<auto>);
        assertFalse(hki instanceof AbstractIterator<int>);
        list<auto> ks = ();
        foreach auto k in (hki) { ks += k; }
        assertEq(("a", "b", "c"), ks);

        # Forward: VIEW_PAIR
        HashPairIterator hpi(h);
        assertTrue(hpi instanceof HashIterator<auto>);
        assertTrue(hpi instanceof AbstractIterator<auto>);
        assertFalse(hpi instanceof AbstractIterator<int>);
        list<auto> pairs = ();
        foreach auto p in (hpi) { pairs += p; }
        assertEq(({"key": "a", "value": 1}, {"key": "b", "value": 2}, {"key": "c", "value": 3}), pairs);

        # Reverse value
        HashReverseIterator<int> hri(h);
        assertTrue(hri instanceof HashReverseIterator<int>);
        assertTrue(hri instanceof HashIterator<int>);
        assertTrue(hri instanceof AbstractIterator<int>);
        assertFalse(hri instanceof AbstractIterator<auto>);
        list<auto> rvals = ();
        foreach auto v in (hri) { rvals += v; }
        assertEq((3, 2, 1), rvals);

        # Reverse key
        HashKeyReverseIterator hkri(h);
        list<auto> rks = ();
        foreach auto k in (hkri) { rks += k; }
        assertEq(("c", "b", "a"), rks);

        # Reverse pair
        HashPairReverseIterator hpri(h);
        list<auto> rpairs = ();
        foreach auto p in (hpri) { rpairs += p; }
        assertEq(({"key": "c", "value": 3}, {"key": "b", "value": 2}, {"key": "a", "value": 1}), rpairs);

        # Object family — same priv chain, different ctor source.
        Foo o();
        ObjectIterator oi(o);
        list<auto> ovals = ();
        foreach auto v in (oi) { ovals += v; }
        assertEq((1, 2, 3), ovals);

        ObjectKeyIterator oki(o);
        list<auto> oks = ();
        foreach auto k in (oki) { oks += k; }
        assertEq(("x", "y", "z"), oks);

        ObjectPairIterator opi(o);
        list<auto> opairs = ();
        foreach auto p in (opi) { opairs += p; }
        assertEq(({"key": "x", "value": 1}, {"key": "y", "value": 2}, {"key": "z", "value": 3}), opairs);

        # Reverse object
        ObjectReverseIterator ori(o);
        list<auto> orev = ();
        foreach auto v in (ori) { orev += v; }
        assertEq((3, 2, 1), orev);

        ObjectKeyReverseIterator okri(o);
        list<auto> rok = ();
        foreach auto k in (okri) { rok += k; }
        assertEq(("z", "y", "x"), rok);

        ObjectPairReverseIterator opri(o);
        list<auto> rop = ();
        foreach auto p in (opri) { rop += p; }
        assertEq(({"key": "z", "value": 3}, {"key": "y", "value": 2}, {"key": "x", "value": 1}), rop);
    }

    listTest() {
        # issue #4355
        {
            Counter c(1);
            background test_4355(c);
            c.waitForZero();
            assertTrue(True);
        }

        {
            Counter c(1);
            background test_4355_stable(c);
            c.waitForZero();
            assertTrue(True);
        }

        hash<string, list<hash<T>>> h();
        {
            list<string> l0 = h.keys();
            assertEq(True, l0.complexType());
            any l1 = h.keys();
            assertEq(False, l1.complexType());
            l1 += 1;
            assertEq(1, l1[0]);
        }
        {
            # assigning a complex type to a list lvalue strips the type info
            list l = new list<int>();
            assertEq(False, l.complexType());
        }
        {
            list<int> l();
            l = map $1, l, $1;
            assertEq(True, l.complexType());
            assertEq("list<int>", l.fullType());
            assertEq((), l);
            l = map $1, l;
            assertEq(True, l.complexType());
            assertEq("list<int>", l.fullType());
            assertEq((), l);
            l = select l, $1;
            assertEq(True, l.complexType());
            assertEq("list<int>", l.fullType());
            assertEq((), l);
            assertEq(1, test(new list<int>(), new list<string>()));
        }
        {
            Program p(PO_NEW_STYLE);
            p.parse("list sub t() {string line = 'a+b,c'; any x; x = (line =~ x/(.)\\+(.*)/); x[1] = split(',', x[1]); return x[1];}", "");
            assertEq(("b", "c"), p.callFunction("t"));
        }
        {
            list l;
            l += 1;
            assertEq((1,), l);
        }
        {
            list<auto> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            list<int> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            softlist l;
            l += 1;
            assertEq((1,), l);
        }
        {
            softlist<auto> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            softlist<int> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *list l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *list<auto> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *list<int> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *softlist l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *softlist<auto> l;
            l += 1;
            assertEq((1,), l);
        }
        {
            *softlist<int> l;
            l += 1;
            assertEq((1,), l);
        }

        {
            code t = auto sub(int i) { return <StatInfo>{}; };
            auto v = 1;
            list<auto> l = (1, t(v));
            assertEq("hash<StatInfo>", l[1].fullType());
        }
    }

    int test(list<int> l1, list<string> l2) {
        return 1;
    }
}
