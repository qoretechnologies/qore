#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT code generation and a qcc executable compiled and linked from the driver

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%exec-class HashCopyTest

#! Copies of hashes have the members of the original in its order, and find every key, in every execution mode
#! (qore#7265)
/** A copy of a hash creates its members with the hashes of the original's keys, in a key map that is reserved for
    them.  The probe copies hashes of many sizes (empty, around the sizes where the key map grows, and large), hashes
    with deleted keys, with keys that are not ASCII, empty, long or given in other encodings, nested hashes, copies of
    copies, typed hashes and hashdecl hashes (also with rejected assignments), hash literals with values computed at
    run time, sums, slices and objects, then changes the copies, adds and deletes keys and checks every key of the
    copies and of the originals.  The output must be the expected one, which the AST interpreter gave before the
    change, in every execution mode and as a qcc-compiled executable.
*/
class HashCopyTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string probe = get_script_dir() + "/hash-copy/probe.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/hash-copy/expected.txt");
    }

    constructor() : QUnit::Test("hash copy test", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = TestInterpreter::qcc_compiler() ?? "qcc";
        addTestCase("hash copies in every execution mode and in AOT", \testCopies());
        set_return_value(main());
    }

    testCopies() {
        # the expected output has the results that the copies are about
        assertTrue(expected =~ /^size26 copy: 27 ok k0=0,k1=1,.*,k25=25,added=26$/m);
        assertTrue(expected =~ /^size1000 copy keys: 1001 first "k0" last "added"$/m);
        assertTrue(expected =~ /^size1000 changed copy keys: 541 /m);
        assertTrue(expected =~ /^deleted copy: 16 ok k1="changed",k2=2,.*,k18=18,k5="re-added"$/m);
        assertTrue(expected =~ /^non-ascii lookup iso-8859-1: 1$/m);
        assertTrue(expected =~ /^hashdecl copy: hash<HD> 2 ok a=10,b="two"$/m);
        assertTrue(expected =~ /^typed copy: hash<string, int> 4 ok a=1,b=20,c=3,d=4$/m);
        assertTrue(expected =~ /^iterated original: 6 ok k0=0,k1=1,k2=2,k3=3,k4=4,k5=5$/m);
        # every key check of the probe passed: verify() reports a missing key, a wrong value, a key that the hash
        # should not have or a wrong size
        assertFalse(expected =~ /(no key \x22|value of \x22|has \x22|size [0-9]+ keys [0-9]+)/);
        assertEq(70, (expected =~ x/^([^:]+: (?:[0-9]+ )?ok\b)/gm).size());
        string env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_JIT_SYNC_COMPILE=1", libqore_dir,
            libqore_dir);
        foreach string mode in (ExecModes) {
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, probe)), mode);
        }
        TmpDir tmp("qore-hash-copy-");
        string exe = tmp.path + DirSep + "probe";
        string out = backquote(sprintf("%s QORE_LIBDIR=%s %s -o %s %s 2>&1", env, libqore_dir, qcc_bin, exe, probe));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        assertEq(expected, backquote(sprintf("%s %s 2>&1", env, exe)), "executable");
    }
}
