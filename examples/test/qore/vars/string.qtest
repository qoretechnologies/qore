#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

# tests are made where the return value is ignored
%disable-warning return-value-ignored

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class StringTest

class StringTest inherits QUnit::Test {
    constructor() : QUnit::Test("String test", "1.0") {
        addTestCase("pseudo-method test", \testPseudoMethods());
        addTestCase("Base64 URL test", \testBase64Url());
        addTestCase("split regex", \splitRegexTest());
        addTestCase("split keep_trailing_empty", \testSplitKeepTrailingEmpty());
        addTestCase("splitString iterator", \testSplitStringIter());
        addTestCase("splitLines iterator", \testSplitLinesIter());
        addTestCase("splitLinesRegex iterator", \testSplitLinesRegexIter());
        addTestCase("splitChars iterator", \testSplitCharsIter());
        addTestCase("getByte pseudo-method", \testGetByte());
        addTestCase("codePointIterator", \testCodePointIter());
        addTestCase("Scanner class", \testScanner());
        addTestCase("non scalar test", \nonScalarTest());
        addTestCase("width test", \testWidth());
        addTestCase("Unicode case mapping test", \testUnicodeCase());
        addTestCase("Basic functions test", \testBasics());
        addTestCase("Comparison test", \testComparison());
        addTestCase("Encoding test", \testEncoding());
        addTestCase("NUL string constants", \testNulStringConstants());
        addTestCase("UTF-16 test", \testUtf16());
        addTestCase("UTF-16 transform test", \testUtf16Transforms());
        addTestCase("getLine test", \testGetLine());
        addTestCase("ASCII x UTF-8 string equality tests", \testASCIIUTF8Equality());
        addTestCase("Base64 and hex test", \testBase64Hex());
        addTestCase("Splice test", \testSplice());
        addTestCase("Extract test", \testExtract());
        addTestCase("Join test", \testJoin());
        addTestCase("Transliteration test", \testTransliteration());
        addTestCase("Regex test", \testRegex());
        addTestCase("Chomp and trim test", \testChompAndTrim());
        addTestCase("Float strings test", \testFloat());
        addTestCase("String conversion test", \testConversions());
        addTestCase("trim", \testTrim());
        set_return_value(main());
    }

    testPseudoMethods() {
        string str = "hello there";
        assertTrue(str.startsWith("hel"));
        assertFalse(str.startsWith("hel0"));

        assertTrue(str.endsWith("ere"));
        assertFalse(str.endsWith("0ere"));

        assertTrue(str.contains("o t"));
        assertFalse(str.contains("o t0"));
    }

    testBase64Url() {
        string str = "<div dir=\"ltr\"><br><img src=\"test\" alt=\"?\" height=\"1\" width=\"1\"></div>";
        string base64_url = "PGRpdiBkaXI9Imx0ciI-PGJyPjxpbWcgc3JjPSJ0ZXN0IiBhbHQ9Ij8iIGhlaWdodD0iMSIgd2lkdGg9IjEiPjwvZGl2Pg";
        string base64 = "PGRpdiBkaXI9Imx0ciI+PGJyPjxpbWcgc3JjPSJ0ZXN0IiBhbHQ9Ij8iIGhlaWdodD0iMSIgd2lkdGg9IjEiPjwvZGl2Pg==";

        assertEq(base64_url, make_base64_url_string(str));
        assertEq(base64, make_base64_string(str));
        #assertEq(str, parse_base64_url_string_to_string(base64_url));
        assertEq(str, parse_base64_string_to_string(base64));
    }

    splitRegexTest() {
        string str = "gee this is a long string";
        list<string> a = str.splitRegex(" ");
        assertEq(True, a.complexType());
        assertEq("list<string>", a.fullType());
        assertEq("is", a[2]);
        assertEq("string", a[5]);

        a = str.splitRegex(" ", True);
        assertEq(True, a.complexType());
        assertEq("list<string>", a.fullType());
        assertEq("is ", a[2]);
        assertEq("string", a[5]);

        str = "field1.field2\\.with\\.dots.field3";
        a = str.splitRegex("(?<!\\\\)\\.");
        assertEq(True, a.complexType());
        assertEq("list<string>", a.fullType());
        assertEq(("field1", "field2\\.with\\.dots", "field3"), a);

        a = str.splitRegex("(?<!\\\\)\\.", True);
        assertEq(True, a.complexType());
        assertEq("list<string>", a.fullType());
        assertEq(("field1.", "field2\\.with\\.dots.", "field3"), a);

        a = str.splitRegex("xxx");
        assertTrue(a.size() == 1);
        assertTrue(a[0] == str);

        a = str.splitRegex("FIELD", RE_Caseless);
        assertEq(True, a.complexType());
        assertEq("list<string>", a.fullType());
        assertEq(("", "1.", "2\\.with\\.dots.", "3"), a);

        a = str.splitRegex("FIELD", RE_Caseless, True);
        assertEq(True, a.complexType());
        assertEq("list<string>", a.fullType());
        assertEq(("field", "1.field", "2\\.with\\.dots.field", "3"), a);

        str = str.upr();
        a = str.splitRegex("field", RE_Caseless, True);
        assertEq(True, a.complexType());
        assertEq("list<string>", a.fullType());
        assertEq(("FIELD", "1.FIELD", "2\\.WITH\\.DOTS.FIELD", "3"), a);
    }

    testSplitKeepTrailingEmpty() {
        # --- the default is unchanged: interior empty fields are kept, the trailing one is dropped
        assertEq(("a", "", "b"), split("/", "a//b"));
        assertEq(("a", "b"), split("/", "a/b/"));
        assertEq((), split("/", ""));
        assertEq(("", ""), split("/", "//"));
        assertEq(("plain",), split("/", "plain"));
        # the same via the pseudo-method
        assertEq(("a", "b"), "a/b/".split("/"));
        assertEq(("a", "", "b"), "a//b".split("/"));

        # --- keep_trailing_empty keeps exactly that one field
        assertEq(("a", "b", ""), split("/", "a/b/", False, True));
        assertEq(("a", "", "b"), split("/", "a//b", False, True));
        assertEq(("",), split("/", "", False, True));
        assertEq(("", "", ""), split("/", "//", False, True));
        assertEq(("plain",), split("/", "plain", False, True));
        # a leading separator was never affected: its empty field is not the trailing one
        assertEq(("", "lead"), split("/", "/lead", False, True));
        # a folder-marker object name: the trailing "/" is significant and must survive
        assertEq(("dir", ""), split("/", "dir/", False, True));
        assertEq(("dir", ""), "dir/".split("/", False, True));

        # --- with_separator composes with keep_trailing_empty
        assertEq(("a/", "b/"), split("/", "a/b/", True));
        assertEq(("a/", "b/", ""), split("/", "a/b/", True, True));

        # --- multi-byte separators
        assertEq(("a", "b"), split("::", "a::b::"));
        assertEq(("a", "b", ""), split("::", "a::b::", False, True));

        # --- the binary variant and its pseudo-method
        assertEq((binary("a"), binary("b")), split(binary("/"), binary("a/b/")));
        assertEq((binary("a"), binary("b"), binary()), split(binary("/"), binary("a/b/"), True));
        assertEq((binary("a"), binary("b"), binary()), binary("a/b/").split(binary("/"), True));

        # --- the quoted variants
        assertEq(("a", "b"), split(",", "a,b,", "'"));
        assertEq(("a", "b", ""), split(",", "a,b,", "'", False, True));
        assertEq(("a", "b", ""), "a,b,".split(",", "'", False, True));
        # a quoted final field followed by the separator
        assertEq(("a", "b", ""), split(",", "a,'b',", "'", False, True));
        # an empty quoted final field followed by the separator
        assertEq(("a", "", ""), split(",", "a,'',", "'", False, True));
        # no trailing separator: nothing is added
        assertEq(("a", "b"), split(",", "a,b", "'", False, True));
        assertEq(("a", "b"), split(",", "a,'b'", "'", False, True));
        # an empty subject yields the single empty field, as the unquoted form does
        assertEq(("",), split(",", "", "'", False, True));
        # trim_unquoted still applies
        assertEq(("a", "b", ""), split(",", " a , b ,", "'", True, True));
        # a quote longer than the separator falls back to the unquoted implementation, which must
        # still honor the flag
        assertEq(("a", "b"), split(",", "a,b,", "''"));
        assertEq(("a", "b", ""), split(",", "a,b,", "''", False, True));

        # --- the point of the flag: the split becomes exactly reversible
        foreach string s in (("a/b/", "a//b", "", "//", "plain", "/lead", "dir/", "a/b/c", "///")) {
            assertEq(s, join("/", split("/", s, False, True)), sprintf("round trip %y", s));
        }

        # --- and the eager and lazy forms now agree
        foreach string s in (("a/b/", "a//b", "", "//", "plain", "dir/", "a/b/c")) {
            assertEq((map $1, s.splitString("/")), s.split("/", False, True),
                sprintf("eager == lazy for %y", s));
        }
    }

    testSplitStringIter() {
        # basic semantics match eager split
        string s = "a,b,,c";
        list<string> expected = s.split(",");
        list<string> got = map $1, s.splitString(",");
        assertEq(expected, got);

        AbstractIterator<string> typed = s.splitString(",");
        assertTrue(typed instanceof AbstractIterator<string>);
        assertFalse(typed instanceof AbstractIterator<auto>);
        assertTrue(typed.next());
        string first = typed.getValue();
        assertEq("a", first);

        # an empty source string yields one empty piece; eager split() drops that trailing empty
        # field by default and only matches when "keep_trailing_empty" is set
        assertEq(("",), (map $1, "".splitString(",")));
        assertEq((), "".split(","));
        assertEq(("",), "".split(",", False, True));

        # delimiter not found yields the whole string
        assertEq(("xyz",), (map $1, "xyz".splitString(",")));

        # trailing delimiter yields a trailing empty piece
        assertEq(("a", "b", ""), (map $1, "a,b,".splitString(",")));
        # ... which the eager form reproduces only with "keep_trailing_empty"
        assertEq(("a", "b"), "a,b,".split(","));
        assertEq(("a", "b", ""), "a,b,".split(",", False, True));

        # multi-byte delimiter
        assertEq(("x", "y", "z"), (map $1, "x::y::z".splitString("::")));

        # iterator protocol: valid() before next(), next() advances, reset()
        StringSplitIterator i("one two three", " ");
        assertFalse(i.valid());
        assertTrue(i.next());
        assertEq("one", i.getValue());
        assertTrue(i.valid());
        assertTrue(i.next());
        assertEq("two", i.getValue());
        assertTrue(i.next());
        assertEq("three", i.getValue());
        assertFalse(i.next());
        assertFalse(i.valid());
        i.reset();
        assertTrue(i.next());
        assertEq("one", i.getValue());

        # getValue() on invalid iterator throws
        StringSplitIterator j("x", ",");
        assertThrows("INVALID-ITERATOR", \j.getValue());

        # functional-operator composition (exercises the native fast path)
        assertEq(6, foldl $1 + $2, (map $1.size(), "aa,bb,cc".splitString(",")));
        list<string> selected = select "aa,bb,cc".splitString(","), $1 == "bb";
        assertEq(("bb",), selected);
    }

    testSplitLinesIter() {
        # "\n" delimited
        assertEq(("a", "b", "c"), (map $1, "a\nb\nc".splitLines()));

        # "\r\n" stripped transparently
        assertEq(("a", "b", "c"), (map $1, "a\r\nb\r\nc".splitLines()));

        # mixed line endings
        assertEq(("a", "b", "c", ""), (map $1, "a\r\nb\nc\r\n".splitLines()));

        # empty string yields a single empty piece
        assertEq(("",), (map $1, "".splitLines()));

        # lone \r is NOT a line terminator (documented behaviour — splits on \n only)
        assertEq(("a\rb",), (map $1, "a\rb".splitLines()));

        # isolated trailing \r is trimmed (even with no preceding \n)
        assertEq(("a",), (map $1, "a\r".splitLines()));

        # functional composition
        int lines = foldl $1 + $2, (map 1, "one\ntwo\nthree".splitLines());
        assertEq(3, lines);
    }

    testSplitLinesRegexIter() {
        # any of LF / CR / CRLF
        assertEq(("a", "b", "c"), (map $1, "a\r\nb\nc".splitLinesRegex("\r?\n|\r")));

        # case-insensitive separator
        assertEq(("1", "2", "3"), (map $1, "1FOO2foo3".splitLinesRegex("foo", RE_Caseless)));

        # with_separator=True keeps the matched separator on each piece
        list<auto> got = map $1, "a,b;c".splitLinesRegex("[,;]", 0, True);
        assertEq(("a,", "b;", "c"), got);

        # invalid regex raises at the pseudo-method call, not lazily
        assertThrows("REGEX-COMPILATION-ERROR",
            sub () { "abc".splitLinesRegex("("); });

        # direct StringRegexSplitIterator: iterator protocol
        StringRegexSplitIterator it("x|y|z", "\\|");
        assertFalse(it.valid());
        assertTrue(it.next());
        assertEq("x", it.getValue());
        assertTrue(it.next());
        assertEq("y", it.getValue());
        assertTrue(it.next());
        assertEq("z", it.getValue());
        assertFalse(it.next());
        assertFalse(it.valid());

        # reset()
        it.reset();
        assertFalse(it.valid());
        assertTrue(it.next());
        assertEq("x", it.getValue());

        # getValue() on invalid iterator throws
        StringRegexSplitIterator je("x", ",");
        assertThrows("INVALID-ITERATOR", \je.getValue());

        # trailing separator yields a trailing empty piece
        assertEq(("a", "b", ""), (map $1, "a,b,".splitLinesRegex(",")));

        # no match yields whole string
        assertEq(("abc",), (map $1, "abc".splitLinesRegex("x")));

        # invalid regex passed directly to the iterator ctor
        assertThrows("REGEX-COMPILATION-ERROR",
            sub () { StringRegexSplitIterator i("x", "("); });

        # early termination: select stops iterating at the first match
        # (verifies the lazy iterator's short-circuit behaviour)
        list<auto> first_fatal = select "info\nwarn\nFATAL: boom\nmore\nFATAL: again".splitLinesRegex("\n"),
            $1 =~ /FATAL/;
        assertEq(2, first_fatal.size());
    }

    testSplitCharsIter() {
        # ASCII: one byte per codepoint
        assertEq(("a", "b", "c"), (map $1, "abc".splitChars()));

        # Empty string yields no pieces
        list<auto> empty = map $1, "".splitChars();
        assertEq(0, empty.size());

        # UTF-8 multi-byte codepoints: 6 chars, 18 bytes
        string ja = "ステップの例";
        assertEq(6, ja.length());
        assertEq(18, ja.size());
        list<auto> chars = map $1, ja.splitChars();
        assertEq(6, chars.size());
        # each piece is exactly one codepoint wide (3 bytes in UTF-8 for these)
        assertEq(3, chars[0].size());
        assertEq("ス", chars[0]);
        assertEq("例", chars[5]);
        # concat of all pieces reconstructs the source
        assertEq(ja, foldl $1 + $2, chars);

        # Mixed ASCII + multi-byte
        list<auto> mixed = map $1, "aスb".splitChars();
        assertEq(("a", "ス", "b"), mixed);

        # 4-byte UTF-8 (emoji codepoint U+1F600 encoded as F0 9F 98 80)
        string emoji = "a😀b";
        list<auto> eparts = map $1, emoji.splitChars();
        assertEq(3, eparts.size());
        assertEq("a", eparts[0]);
        assertEq(4, eparts[1].size());
        assertEq("😀", eparts[1]);
        assertEq("b", eparts[2]);

        # functional composition (exercises native fast path)
        int digits = foldl $1 + $2, (map ($1 =~ /[0-9]/ ? 1 : 0), "a1b2c3".splitChars());
        assertEq(3, digits);

    }

    testGetByte() {
        # ASCII positive offsets
        string s = "abc#";
        assertEq(0x61, s.getByte(0));
        assertEq(0x62, s.getByte(1));
        assertEq(0x63, s.getByte(2));
        assertEq(0x23, s.getByte(3));

        # Negative offsets count from end
        assertEq(0x23, s.getByte(-1));
        assertEq(0x63, s.getByte(-2));

        # Out of range returns NOTHING
        assertNothing(s.getByte(99));
        assertNothing(s.getByte(-100));
        assertNothing(s.getByte(s.size()));

        # Empty string: any offset is out of range
        assertNothing("".getByte(0));
        assertNothing("".getByte(-1));

        # UTF-8 returns raw bytes, NOT codepoints
        # "aéb" = 0x61, 0xc3, 0xa9, 0x62
        string u = "aéb";
        assertEq(4, u.size());
        assertEq(0x61, u.getByte(0));
        assertEq(0xc3, u.getByte(1));
        assertEq(0xa9, u.getByte(2));
        assertEq(0x62, u.getByte(3));

        # Compared to getUnicode which returns codepoints
        assertEq(0x61, u.getUnicode(0));
        assertEq(0xe9, u.getUnicode(1));   # é = U+00E9
        assertEq(0x62, u.getUnicode(2));
    }

    testCodePointIter() {
        # ASCII: each byte is one codepoint
        list<auto> got = map $1, "abc".codePointIterator();
        assertEq((0x61, 0x62, 0x63), got);

        AbstractIterator<int> typed = "abc".codePointIterator();
        assertTrue(typed instanceof AbstractIterator<int>);
        assertFalse(typed instanceof AbstractIterator<auto>);
        assertTrue(typed.next());
        int first = typed.getValue();
        assertEq(0x61, first);

        # Empty string yields no elements
        list<int> empty = map $1, "".codePointIterator();
        assertEq(0, empty.size());

        # UTF-8 multi-byte: "aéb" = U+0061, U+00E9, U+0062 (3 codepoints / 4 bytes)
        list<auto> u8 = map $1, "aéb".codePointIterator();
        assertEq((0x61, 0xe9, 0x62), u8);

        # 4-byte UTF-8 (emoji U+1F600)
        list<auto> em = map $1, "a😀b".codePointIterator();
        assertEq((0x61, 0x1f600, 0x62), em);

        # Direct iterator protocol
        StringCharIterator it("xyz");
        assertFalse(it.valid());
        assertTrue(it.next());
        assertEq(0x78, it.getValue());
        assertTrue(it.next());
        assertEq(0x79, it.getValue());
        assertTrue(it.next());
        assertEq(0x7a, it.getValue());
        assertFalse(it.next());
        assertFalse(it.valid());

        # reset()
        it.reset();
        assertTrue(it.next());
        assertEq(0x78, it.getValue());

        # getValue() before next() throws
        StringCharIterator je("x");
        assertThrows("INVALID-ITERATOR", \je.getValue());

        # Functional composition (exercises native fast path)
        int sum = foldl $1 + $2, "abc".codePointIterator();
        assertEq(0x61 + 0x62 + 0x63, sum);

        # select for ASCII letter count
        list<int> letters = select "He llo, World!".codePointIterator(),
            ($1 >= ord("A") && $1 <= ord("Z")) || ($1 >= ord("a") && $1 <= ord("z"));
        assertEq(10, letters.size());

        Program p();
        assertThrows("PARSE-TYPE-ERROR", \p.parse(),
            ("%new-style\nsub t(){list<string> cps = map $1, \"abc\".codePointIterator();}",
                "codepoint-iterator-static-type-error"));
    }

    testScanner() {
        Scanner s("hello\nworld");

        # Initial state
        assertEq(0x68, s.peekByte());
        assertEq(0x68, s.peek());
        assertEq(0, s.getBytePos());
        assertEq(1, s.getLine());
        assertEq(1, s.getColumn());
        assertFalse(s.atEnd());
        assertEq(11, s.bytesRemaining());

        # peekByteAt
        assertEq(0x65, s.peekByteAt(1));      # 'e'
        assertEq(0x6f, s.peekByteAt(4));      # 'o'
        assertEq(0x0a, s.peekByteAt(5));      # '\n'
        assertEq(-1, s.peekByteAt(99));        # out of range
        assertEq(-1, s.peekByteAt(-1));        # before start

        # advance updates line/column; line increments on newline crossing
        Scanner s2("hello\nworld");
        assertTrue(s2.advance());   # past 'h'
        assertEq(2, s2.getColumn());
        s2.advanceN(4);             # past 'ello' (now positioned at '\n')
        assertEq(0x0a, s2.peekByte());
        assertTrue(s2.advance());   # past '\n' — line 1 → 2
        assertEq(2, s2.getLine());
        assertEq(1, s2.getColumn());

        # advanceByte vs advance
        Scanner s3("aé");
        assertEq(0x61, s3.peekByte());
        assertTrue(s3.advanceByte());
        assertEq(0xc3, s3.peekByte());          # first byte of UTF-8 'é'
        # advance treats 'é' as one codepoint
        Scanner s4("aé");
        assertTrue(s4.advance());
        assertTrue(s4.advance());                # past 'é' (2 bytes)
        assertTrue(s4.atEnd());

        # match advances past literal, leaves cursor unchanged on miss
        Scanner m("foobar");
        assertTrue(m.match("foo"));
        assertEq(3, m.getBytePos());
        assertFalse(m.match("xyz"));
        assertEq(3, m.getBytePos());
        assertTrue(m.match("bar"));
        assertTrue(m.atEnd());

        # startsWith doesn't advance
        Scanner sw("hello");
        assertTrue(sw.startsWith("he"));
        assertEq(0, sw.getBytePos());
        assertFalse(sw.startsWith("xy"));

        # extractRange
        Scanner e("hello world");
        assertEq("hello", e.extractRange(0, 5));
        assertEq("world", e.extractRange(6, 5));
        assertEq("", e.extractRange(0, 0));
        assertNothing(e.extractRange(0, 100));     # out of bounds
        assertNothing(e.extractRange(-1, 5));      # negative

        # reset
        Scanner r("abc");
        r.advanceN(2);
        assertEq(2, r.getBytePos());
        r.reset();
        assertEq(0, r.getBytePos());
        assertEq(1, r.getLine());
        assertEq(1, r.getColumn());

        # getString returns the source
        Scanner gs("source text");
        assertEq("source text", gs.getString());

        # codepoint peek for non-ASCII
        Scanner u("é");
        assertEq(0xe9, u.peek());                  # codepoint
        assertEq(0xc3, u.peekByte());              # first byte
        assertEq(2, u.bytesRemaining());

        # peekAt with character offsets
        Scanner pa("aéb");
        assertEq(0x61, pa.peekAt(0));              # 'a'
        assertEq(0xe9, pa.peekAt(1));              # 'é'
        assertEq(0x62, pa.peekAt(2));              # 'b'
        assertEq(-1, pa.peekAt(3));                # past end
    }

    nonScalarTest() {
        {
            Program p(PO_NEW_STYLE);
            *hash<ExceptionInfo> warn = p.parse("string str = 'a'; hash<auto> v = {}; auto x = str + v; remove x;", "",
                -1);
            assertEq("INVALID-OPERATION", warn.err);
        }
        {
            Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
            *hash<ExceptionInfo> warn = p.parse("string str = 'a'; hash<auto> v = {}; auto x = str + v; remove x;",
                "", -1);
            assertEq("INVALID-OPERATION", warn.err);
        }
        {
            Program p(PO_NEW_STYLE);
            *hash<ExceptionInfo> warn = p.parse("string str = 'a'; str += {};", "", -1);
            assertEq("INVALID-OPERATION", warn.err);
        }
        {
            Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
            *hash<ExceptionInfo> warn = p.parse("string str = 'a'; str += {};", "", -1);
            assertEq("INVALID-OPERATION", warn.err);
        }
        {
            Program p(PO_NEW_STYLE);
            *hash<ExceptionInfo> warn = p.parse("auto sub test() { string str = 'a'; *list<auto> v = (); return str + v; }", "",
                -1);
            assertNothing(warn.err);
            assertEq(("a",), p.callFunction("test"));
        }
    }

    testWidth() {
        # 6 characters, 12 positions, 18 bytes
        string str = "ステップの例";
        assertEq(6, str.length());
        assertEq(12, str.width());
        assertEq(18, str.size());
        assertEq(str + " ", sprintf("%-13w", str));
        assertEq(str + " ", vsprintf("%-13w", str));
        assertEq("ステ.", f_sprintf("%-5w", str));
        assertEq("ステ.", f_vsprintf("%-5w", str));
    }

    testUnicodeCase() {
        # -- full (1-to-many) upper-case mappings from the Unicode SpecialCasing data --
        assertEq("STRASSE", "stra\u{DF}e".upr(), "\u{DF} -> SS");
        assertEq("FIND", "\u{FB01}nd".upr(), "ligature \u{FB01} -> FI");
        assertEq("FFLOOD", "\u{FB04}ood".upr(), "ligature \u{FB04} -> FFL");
        assertEq("\u{2BC}N", "\u{149}".upr(), "\u{149} -> \u{2BC}N");
        assertEq("J\u{30C}", "\u{1F0}".upr(), "\u{1F0} -> J + combining caron");
        assertEq("\u{399}\u{308}\u{301}", "\u{390}".upr(), "\u{390} -> 3 codepoints");
        assertEq("\u{3A5}\u{308}\u{301}", "\u{3B0}".upr(), "\u{3B0} -> 3 codepoints");
        assertEq("\u{544}\u{535}", "\u{FB14}".upr(), "Armenian ligature \u{FB14} -> \u{544}\u{535}");
        assertEq("\u{1F08}\u{399}", "\u{1F80}".upr(), "Greek iota subscript \u{1F80} -> \u{1F08}\u{399}");
        assertEq("\u{3A9}\u{399}", "\u{1FFC}".upr(), "Greek iota subscript \u{1FFC} -> \u{3A9}\u{399}");

        # -- full (1-to-many) lower-case mapping --
        # U+0130 LATIN CAPITAL LETTER I WITH DOT ABOVE was returned unchanged before the
        # complete Unicode case mapping tables were used
        assertEq("i\u{307}", "\u{130}".lwr(), "\u{130} -> i + combining dot above");
        assertEq("i\u{307}stanbul", "\u{130}stanbul".lwr(), "\u{130} in a word");
        assertEq(9, "\u{130}stanbul".lwr().length(), "\u{130} full lower-case length");
        assertEq(10, "\u{130}stanbul".lwr().size(), "\u{130} full lower-case size");

        # -- the language-independent Final_Sigma condition --
        assertEq("\u{3BF}\u{3B4}\u{3BF}\u{3C2}", "\u{39F}\u{394}\u{39F}\u{3A3}".lwr(),
            "word-final \u{3A3} -> \u{3C2}");
        assertEq("\u{3C3}\u{3C2}", "\u{3A3}\u{3A3}".lwr(), "only the final \u{3A3} maps to \u{3C2}");
        assertEq("\u{3C3}", "\u{3A3}".lwr(), "an isolated \u{3A3} is not word-final");
        assertEq("\u{3B1}\u{3C3}\u{3B2}", "\u{391}\u{3A3}\u{392}".lwr(),
            "\u{3A3} followed by a cased character stays \u{3C3}");
        assertEq("\u{3B1}\u{3C2}'", "\u{391}\u{3A3}'".lwr(),
            "a case-ignorable character after \u{3A3} does not break Final_Sigma");
        assertEq("\u{3B1}\u{3C3}'\u{3B2}", "\u{391}\u{3A3}'\u{392}".lwr(),
            "a cased character after a case-ignorable one breaks Final_Sigma");
        assertEq("\u{3C3}\u{3B2}", "\u{3A3}\u{392}".lwr(),
            "\u{3A3} with no preceding cased character stays \u{3C3}");
        assertEq("\u{3A3}\u{3A3}", "\u{3C3}\u{3C2}".upr(), "both sigmas upper-case to \u{3A3}");

        # -- title-case characters map in both directions --
        assertEq("\u{1C4}UNGLA", "\u{1C5}ungla".upr(), "\u{1C5} -> \u{1C4}");
        assertEq("\u{1C6}ungla", "\u{1C5}ungla".lwr(), "\u{1C5} -> \u{1C6}");

        # -- scripts and blocks that the old hand-maintained table did not cover --
        assertEq("\u{10428}", "\u{10400}".lwr(), "Deseret \u{10400} -> \u{10428}");
        assertEq("\u{10400}", "\u{10428}".upr(), "Deseret \u{10428} -> \u{10400}");
        assertEq("\u{104D8}", "\u{104B0}".lwr(), "Osage \u{104B0} -> \u{104D8}");
        assertEq("\u{1E900}", "\u{1E922}".upr(), "Adlam \u{1E922} -> \u{1E900}");
        assertEq("\u{118C0}", "\u{118A0}".lwr(), "Warang Citi \u{118A0} -> \u{118C0}");
        assertEq("\u{10CC0}", "\u{10C80}".lwr(), "Old Hungarian \u{10C80} -> \u{10CC0}");
        assertEq("\u{16E60}", "\u{16E40}".lwr(), "Medefaidrin \u{16E40} -> \u{16E60}");
        assertEq("\u{10597}", "\u{10570}".lwr(), "Vithkuqi \u{10570} -> \u{10597}");
        assertEq("\u{13A0}", "\u{AB70}".upr(), "Cherokee \u{AB70} -> \u{13A0}");
        assertEq("\u{AB80}", "\u{13B0}".lwr(), "Cherokee \u{13B0} -> \u{AB80}");
        assertEq("\u{2C30}", "\u{2C00}".lwr(), "Glagolitic \u{2C00} -> \u{2C30}");
        assertEq("\u{2C81}", "\u{2C80}".lwr(), "Coptic \u{2C80} -> \u{2C81}");
        assertEq("\u{2C61}", "\u{2C60}".lwr(), "Latin Extended-C \u{2C60} -> \u{2C61}");
        assertEq("\u{A722}", "\u{A723}".upr(), "Latin Extended-D \u{A723} -> \u{A722}");
        assertEq("\u{A790}", "\u{A791}".upr(), "Latin Extended-E \u{A791} -> \u{A790}");
        assertEq("\u{A65F}", "\u{A65E}".lwr(), "Cyrillic Extended-B \u{A65E} -> \u{A65F}");
        assertEq("\u{2D00}", "\u{10A0}".lwr(), "Georgian Asomtavruli \u{10A0} -> \u{2D00}");
        assertEq("\u{10D0}", "\u{1C90}".lwr(), "Georgian Mtavruli \u{1C90} -> \u{10D0}");
        assertEq("\u{2177}", "\u{2167}".lwr(), "Roman numeral \u{2167} -> \u{2177}");
        assertEq("\u{24D0}", "\u{24B6}".lwr(), "circled \u{24B6} -> \u{24D0}");
        assertEq("\u{FF41}", "\u{FF21}".lwr(), "fullwidth \u{FF21} -> \u{FF41}");

        # -- singleton mappings into unrelated blocks --
        assertEq("\u{39C}", "\u{B5}".upr(), "micro sign -> Greek capital mu");
        assertEq("S", "\u{17F}".upr(), "long s -> S");
        assertEq("I", "\u{131}".upr(), "dotless i -> I");

        # -- characters with no case mapping are returned unchanged --
        assertEq("\u{5D0}\u{5D1}", "\u{5D0}\u{5D1}".upr(), "Hebrew has no case");
        assertEq("\u{6C49}\u{5B57}", "\u{6C49}\u{5B57}".lwr(), "Han characters have no case");
        assertEq("\u{1F600}", "\u{1F600}".upr(), "emoji have no case");
        assertEq("0123!@#", "0123!@#".upr(), "digits and punctuation are unchanged");
        assertEq("\u{10330}", "\u{10330}".upr(), "Old Italic has no case");

        # -- mixed strings and round trips --
        string mixed = "\u{6C49}\u{5B57} abc \u{3B1}\u{3B2} \u{4F0}\u{4F1} \u{1F600}";
        assertEq("\u{6C49}\u{5B57} ABC \u{391}\u{392} \u{4F0}\u{4F0} \u{1F600}", mixed.upr(),
            "mixed-script upr()");
        assertEq("\u{6C49}\u{5B57} abc \u{3B1}\u{3B2} \u{4F1}\u{4F1} \u{1F600}", mixed.lwr(),
            "mixed-script lwr()");
        assertEq(mixed.lwr(), mixed.upr().lwr(), "upr()/lwr() round trip");
        assertEq(mixed.upr(), mixed.lwr().upr(), "lwr()/upr() round trip");
        assertEq(mixed.upr(), mixed.upr().upr(), "upr() is idempotent");
        assertEq(mixed.lwr(), mixed.lwr().lwr(), "lwr() is idempotent");

        # -- the tolower()/toupper() functions use the same mappings --
        assertEq("\u{130}stanbul".lwr(), tolower("\u{130}stanbul"), "tolower() matches <string>::lwr()");
        assertEq("stra\u{DF}e".upr(), toupper("stra\u{DF}e"), "toupper() matches <string>::upr()");

        # -- length() and size() of the transformed string --
        assertEq(7, "stra\u{DF}e".upr().length(), "1-to-many upr() length");
        assertEq(7, "stra\u{DF}e".upr().size(), "1-to-many upr() size");
        assertEq(6, "\u{1F80}\u{1F81}\u{1FFC}".upr().length(), "Greek iota subscript upr() length");
        assertEq(14, "\u{1F80}\u{1F81}\u{1FFC}".upr().size(), "Greek iota subscript upr() size");
        assertEq(3, "\u{10428}\u{10429}\u{1042A}".upr().length(), "supplementary upr() length");
        assertEq(12, "\u{10428}\u{10429}\u{1042A}".upr().size(), "supplementary upr() size");
        assertEq(0, "".upr().length(), "empty string upr() length");
        assertEq("", "".lwr(), "empty string lwr()");

        # -- non-UTF-8 encodings --
        string l1 = convert_encoding("h\u{E9}llo caf\u{E9}", "ISO-8859-1");
        assertEq("ISO-8859-1", l1.upr().encoding(), "ISO-8859-1 upr() keeps the encoding");
        assertEq("H\u{C9}LLO CAF\u{C9}", convert_encoding(l1.upr(), "UTF-8"), "ISO-8859-1 upr()");
        assertEq("h\u{E9}llo caf\u{E9}", convert_encoding(l1.upr().lwr(), "UTF-8"), "ISO-8859-1 lwr()");
        string l1_ss = convert_encoding("stra\u{DF}e", "ISO-8859-1");
        assertEq("STRASSE", convert_encoding(l1_ss.upr(), "UTF-8"), "ISO-8859-1 1-to-many upr()");
        string el = convert_encoding("\u{39F}\u{394}\u{39F}\u{3A3}", "ISO-8859-7");
        assertEq("\u{3BF}\u{3B4}\u{3BF}\u{3C2}", convert_encoding(el.lwr(), "UTF-8"),
            "ISO-8859-7 Final_Sigma");
        assertEq(4, el.lwr().length(), "ISO-8859-7 lwr() length");

        # a mapping that the string's encoding cannot represent leaves the character unchanged
        # instead of raising an ENCODING-CONVERSION-ERROR; \u{FF} maps to \u{178} and \u{B5} maps
        # to \u{39C}, neither of which exists in ISO-8859-1
        string l1_y = convert_encoding("\u{FF}", "ISO-8859-1");
        assertEq("\u{FF}", convert_encoding(l1_y.upr(), "UTF-8"), "unrepresentable upr() mapping");
        assertEq("ISO-8859-1", l1_y.upr().encoding(), "unrepresentable upr() keeps the encoding");
        string l1_mu = convert_encoding("\u{B5}", "ISO-8859-1");
        assertEq("\u{B5}", convert_encoding(l1_mu.upr(), "UTF-8"), "unrepresentable micro sign upr()");
        # the same characters do get mapped in an encoding that can represent the result
        assertEq("\u{178}", "\u{FF}".upr(), "UTF-8 \u{FF} -> \u{178}");
        assertEq("\u{39C}", "\u{B5}".upr(), "UTF-8 \u{B5} -> \u{39C}");
        # characters in the middle of a string are not disturbed by the fallback
        string l1_mix = convert_encoding("a\u{FF}b\u{E9}c", "ISO-8859-1");
        assertEq("A\u{FF}B\u{C9}C", convert_encoding(l1_mix.upr(), "UTF-8"),
            "unrepresentable mapping in the middle of a string");
        assertEq(5, l1_mix.upr().length(), "unrepresentable mapping keeps the length");
    }

    testBasics() {
        string str = "Hi there, you there, pal";
        string big = "GEE WHIZ";
        assertEq(strlen(str), 24, "strlen()");
        assertEq(str.strlen(), 24, "<string>::strlen()");
        assertEq(str.size(), 24, "<string::size()");
        assertEq(toupper(str), "HI THERE, YOU THERE, PAL", "toupper()");
        assertEq(str.upr(), "HI THERE, YOU THERE, PAL", "<string>::upr()");
        assertEq(big.lwr(), "gee whiz", "<string>::lwr()");
        assertEq(reverse(big), "ZIHW EEG", "reverse()");

        assertEq(strmul(big, 2), "GEE WHIZGEE WHIZ", "strmul() basic");
        assertEq(strmul("%v, ", 3, 2), "%v, %v, %v", "strmul() extended");
        assertEq(strmul(123, 2), "123123", "strmul() type conversion");

        assertEq(chr(104), "h", "chr()");

        str = "gee this is a long string";
        list<string> a = split(" ", str);
        assertEq(True, a.complexType());
        assertEq("list<string>", a.fullType());
        assertEq(a[2], "is", "first string split()");
        assertEq(a[5], "string", "second string split()");

        list<binary> bl = split(binary(" "), binary(str));
        assertEq(bl[2], binary("is"), "first binary split()");
        assertEq(bl[5], binary("string"), "second binary split()");
    }

    testComparison() {
        assertTrue("a" < "b");
        assertTrue("a" <= "b");
        assertTrue("b" > "a");
        assertTrue("b" >= "a");
        assertTrue("ab" > "a");
        assertTrue("a" < "ab");

        string text = "string";
        assertFalse(text[0] == "*");
        assertTrue(text[0] == "s");
        assertTrue(text[0] != "*");
        assertTrue(text[0] < "t");
        assertTrue(text[0] <= "s");
        assertTrue(text[0] > "r");
        assertTrue(text[0] >= "s");

        text = "äbc";
        assertTrue(text[0] == "ä");
        assertTrue(text[0] < "å");
    }

    testEncoding() {
        # set up a string with UTF-8 multi-byte characters
        string str = "Über die Wolken läßt sich die Höhe begrüßen";
        assertEq(strlen(str), 49, "UTF-8 strlen()");
        assertEq(str.strlen(), 49, "UTF-8 <string>::strlen()");
        assertEq(length(str), 43, "UTF-8 length()");
        assertEq(str.length(), 43, "UTF-8 <string>::length()");
        assertEq(substr(str, 30), "Höhe begrüßen", "first UTF-8 substr()");
        assertEq(substr(str, -8), "begrüßen", "second UTF-8 substr()");
        assertEq(substr(str, 0, -39), "Über", "third UTF-8 substr()");
        assertEq(index(str, "läßt"), 16, "first UTF-8 index()");
        assertEq(index(str, "läßt", 1), 16, "second UTF-8 index()");
        assertEq(rindex(str, "ß"), 40, "first UTF-8 rindex()");
        assertEq(rindex(str, "ß", 25), 18, "second UTF-8 rindex()");
        assertEq(bindex(str, "läßt"), 17, "first UTF-8 bindex()");
        assertEq(bindex(str, "läßt", 1), 17, "second UTF-8 bindex()");
        assertEq(brindex(str, "ß"), 45, "first UTF-8 brindex()");
        assertEq(brindex(str, "ß", 25), 20, "second UTF-8 brindex()");
        assertEq(reverse(str), "neßürgeb ehöH eid hcis tßäl nekloW eid rebÜ", "UTF-8 reverse()");
        assertEq(index(str, "==="), -1, "negative index()");
        assertEq(rindex(str, "==="), -1, "negative rindex()");
        assertEq(bindex(str, "==="), -1, "negative bindex()");

        assertEq(c'\u{F6}', str[31], "first UTF-8 string index dereference");
        assertEq(c'\u{FC}', str[39], "second UTF-8 string index dereference");

        # save string
        string ostr = str;
        # convert the string to single-byte ISO-8859-1 characters and retest
        str = convert_encoding(str, "ISO-8859-1");
        assertEq(str != ostr, False, "string != operator with same text with different encodings");
        assertEq(strlen(str), 43, "ISO-8859-1 strlen()");
        assertEq(str.strlen(), 43, "ISO-8859-1 <string>::strlen()");
        assertEq(length(str), 43, "ISO-8859-1 length()");
        assertEq(str.length(), 43, "ISO-8859-1 <string>::length()");
        assertEq(substr(str, 30), convert_encoding("Höhe begrüßen", "ISO-8859-1"), "first ISO-8859-1 substr()");
        assertEq(substr(str, -8), convert_encoding("begrüßen", "ISO-8859-1"), "second ISO-8859-1 substr()");
        assertEq(substr(str, 0, -39), convert_encoding("Über", "ISO-8859-1"), "third ISO-8859-1 substr()");
        assertEq(index(str, convert_encoding("läßt", "ISO-8859-1")), 16, "first ISO-8859-1 index()");
        assertEq(index(str, convert_encoding("läßt", "ISO-8859-1"), 1), 16, "second ISO-8859-1 index()");
        assertEq(rindex(str, convert_encoding("ß", "ISO-8859-1")), 40, "first ISO-8859-1 rindex()");
        assertEq(rindex(str, convert_encoding("ß", "ISO-8859-1"), 25), 18, "second ISO-8859-1 rindex()");
        assertEq(ord(str, 1), 98, "ord()");

        str = "äüößÄÖÜ";
        # test length() with UTF-8 multi-byte characters
        assertEq(length(str), 7, "length() with UTF-8 multi-byte characters");
        assertEq(strlen(str), 14, "strlen() with UTF-8 multi-byte characters");
        # test charset encoding conversions
        string nstr = convert_encoding(str, "ISO-8859-1");
        assertEq(length(nstr), 7, "length() with ISO-8859-1 special characters");
        assertEq(strlen(nstr), 7, "strlen() with ISO-8859-1 special characters");
        assertEq(str, convert_encoding(nstr, "UTF-8"), "convert_encoding()");

        str = "příliš žluťoučký kůň úpěl ďábelské ódy";
        assertEq("prilis zlutoucky kun upel dabelske ody", str.unaccent(), "<string>::unaccent()");
        string ustr = str.upr();
        assertEq("PŘÍLIŠ ŽLUŤOUČKÝ KŮŇ ÚPĚL ĎÁBELSKÉ ÓDY", ustr, "<string>::upr()");
        assertEq("příliš žluťoučký kůň úpěl ďábelské ódy", ustr.lwr(), "<string>::lwr()");

        # Ukrainian Cyrillic case conversion (tests 2-byte UTF-8 encoding in concatUTF8FromUnicode)
        assertEq("ПРИВІТ СВІТЕ", "привіт світе".upr(), "Ukrainian upr()");
        assertEq("привіт світе", "ПРИВІТ СВІТЕ".lwr(), "Ukrainian lwr()");
        # Ukrainian-specific letters
        assertEq("І", "і".upr(), "Ukrainian і -> І");
        assertEq("Ї", "ї".upr(), "Ukrainian ї -> Ї");
        assertEq("Є", "є".upr(), "Ukrainian є -> Є");
        assertEq("Ґ", "ґ".upr(), "Ukrainian ґ -> Ґ");
        assertEq("і", "І".lwr(), "Ukrainian І -> і");
        assertEq("ї", "Ї".lwr(), "Ukrainian Ї -> ї");

        # 1-to-many uppercase mappings
        assertEq("STRASSE", "straße".upr(), "German ß -> SS");
        assertEq("FIND", "ﬁnd".upr(), "ligature ﬁ -> FI");
        assertEq("FLOOR", "ﬂoor".upr(), "ligature ﬂ -> FL");

        # Greek case conversion
        assertEq("ΑΒΓΔ", "αβγδ".upr(), "Greek upr()");
        assertEq("αβγδ", "ΑΒΓΔ".lwr(), "Greek lwr()");

        # Latin extended
        assertEq("HÉLLO CAFÉ", "héllo café".upr(), "Latin extended upr()");

        assertThrows("ENCODING-CONVERSION-ERROR", \convert_encoding(), ("ß", "US-ASCII"));
        assertThrows("ENCODING-CONVERSION-ERROR", \convert_encoding(), ("汉字", "ISO-8859-1"));
    }

    private string makeNulPrefixedString() {
        string str = "";
        str += "\0";
        str += "end";
        return str;
    }

    testNulStringConstants() {
        string str;
        for (int i = 0; i < 1100; ++i) {
            str = makeNulPrefixedString();
        }

        assertEq("\0end", str);
        assertEq(4, str.size());
    }

    testGetLine() {
        int bc;
        string s = "alpha\nbeta\r\ngamma\rdelta";
        assertEq("alpha", s.getLine(0, NOTHING, True, \bc));
        assertEq(6, bc);
        assertEq("alpha\n", s.getLine(0, NOTHING, False, \bc));
        assertEq(6, bc);
        assertEq("beta", s.getLine(6, NOTHING, True, \bc));
        assertEq(6, bc);
        # "\r\n" is a single end of line sequence and must be returned intact when not trimmed; the
        # byte-oriented scan returned "\r\r" here
        assertEq("beta\r\n", s.getLine(6, NOTHING, False, \bc));
        assertEq(6, bc);
        assertEq("gamma", s.getLine(12, NOTHING, True, \bc));
        assertEq(6, bc);
        assertEq("gamma\r", s.getLine(12, NOTHING, False, \bc));
        assertEq(6, bc);
        # the last line has no end of line sequence
        assertEq("delta", s.getLine(18, NOTHING, True, \bc));
        assertEq(5, bc);
        assertEq(NOTHING, s.getLine(s.size()));
        assertEq(NOTHING, "".getLine());

        # an explicit line separator
        assertEq("a", "a::b::c".getLine(0, "::", True, \bc));
        assertEq(3, bc);
        assertEq("a::", "a::b::c".getLine(0, "::", False, \bc));
        assertEq(3, bc);
        assertEq("c", "a::b::c".getLine(6, "::", True, \bc));
        assertEq(1, bc);

        # embedded nulls must not terminate the line early
        string nul = "a\0b\nc";
        assertEq(5, nul.size());
        assertEq("a\0b", nul.getLine(0, NOTHING, True, \bc));
        assertEq(4, bc);
        assertEq("c", nul.getLine(4, NOTHING, True, \bc));
        assertEq(1, bc);

        # in UTF-16 the end of line characters are not single bytes; the byte-oriented scan stopped at
        # the null half of the first code unit and returned an empty or invalid string
        foreach string enc in (("UTF-16", "UTF-16BE", "UTF-16LE")) {
            string u = convert_encoding("alpha\nbeta\r\ngamma", enc);
            assertEq(34, u.size(), enc);
            assertEq("alpha", convert_encoding(u.getLine(0, NOTHING, True, \bc), "UTF-8"), enc);
            assertEq(12, bc, enc);
            assertEq("alpha\n", convert_encoding(u.getLine(0, NOTHING, False, \bc), "UTF-8"), enc);
            assertEq(12, bc, enc);
            assertEq("beta", convert_encoding(u.getLine(12, NOTHING, True, \bc), "UTF-8"), enc);
            assertEq(12, bc, enc);
            assertEq("beta\r\n", convert_encoding(u.getLine(12, NOTHING, False, \bc), "UTF-8"), enc);
            assertEq(12, bc, enc);
            assertEq("gamma", convert_encoding(u.getLine(24, NOTHING, True, \bc), "UTF-8"), enc);
            assertEq(10, bc, enc);
            # the returned lines must be valid strings in the source encoding
            assertEq(enc, u.getLine(0).encoding(), enc);
            assertEq(5, u.getLine(0).length(), enc);
            # an explicit line separator in the string's encoding
            assertEq("alpha", convert_encoding(u.getLine(0, convert_encoding("\n", enc), True, \bc),
                "UTF-8"), enc);
            assertEq(12, bc, enc);
        }
    }

    testUtf16Transforms() {
        # a string tagged with the byte-order-neutral "UTF-16" encoding holds big-endian code units
        # with no byte order mark; this matches the decoding handlers registered for the encoding and
        # the Unicode default for a UTF-16 stream with no BOM.  iconv's own "UTF-16" output is a BOM
        # followed by native-endian code units, which decoded as U+FFFE plus byte-swapped characters
        hash<string, string> exp_hex = {
            "UTF-16": "006800e9",
            "UTF-16BE": "006800e9",
            "UTF-16LE": "6800e900",
        };

        string utf8 = "Příliš žluťoučký kůň úpěl ďábelské ódy. \u{10400}";

        foreach string enc in (keys exp_hex) {
            string s = convert_encoding("hé", enc);
            assertEq(enc, s.encoding(), enc);
            assertEq(exp_hex{enc}, s.toHex(), enc);
            assertEq(4, s.size(), enc);
            assertEq(2, s.length(), enc);
            assertEq(104, s[0].ord(), enc);
            assertEq(233, s[1].ord(), enc);
            assertEq("hé", convert_encoding(s, "UTF-8"), enc);
            assertEq(("h", "é"), (map convert_encoding($1, "UTF-8"), s.splitChars()), enc);

            # case conversion must decode the string instead of taking the byte-oriented ASCII fast
            # path, which matched the 0x00 half of a code unit and wrote single bytes
            assertEq("HÉ", convert_encoding(s.upr(), "UTF-8"), enc);
            assertEq("hé", convert_encoding(s.upr().lwr(), "UTF-8"), enc);
            assertEq(enc, s.upr().encoding(), enc);
            assertEq(4, s.upr().size(), enc);
            assertEq(2, s.upr().length(), enc);

            # unaccent() must encode its replacement strings instead of concatenating raw ASCII bytes
            string un = s.unaccent();
            assertEq("he", convert_encoding(un, "UTF-8"), enc);
            assertEq(enc, un.encoding(), enc);
            assertEq(4, un.size(), enc);
            assertEq(2, un.length(), enc);

            # a replacement of more than one character
            string multi = convert_encoding("stra\u{df}e", enc).unaccent();
            assertEq("strasse", convert_encoding(multi, "UTF-8"), enc);
            assertEq(7, multi.length(), enc);
            assertEq(14, multi.size(), enc);

            # supplementary-plane characters exercise the surrogate path
            string sp = convert_encoding("a\u{10400}z", enc);
            assertEq(3, sp.length(), enc);
            assertEq(8, sp.size(), enc);
            assertEq(0x10400, sp[1].ord(), enc);
            assertEq("a\u{10428}z", convert_encoding(sp.lwr(), "UTF-8"), enc);
            assertEq("A\u{10400}Z", convert_encoding(sp.upr(), "UTF-8"), enc);
            assertEq(3, sp.lwr().length(), enc);
            assertEq(("a", "\u{10400}", "z"), (map convert_encoding($1, "UTF-8"), sp.splitChars()), enc);

            # the language-independent Final_Sigma condition also needs decoded characters
            assertEq("\u{3BF}\u{3B4}\u{3BF}\u{3C2}",
                convert_encoding(convert_encoding("\u{39F}\u{394}\u{39F}\u{3A3}", enc).lwr(), "UTF-8"), enc);

            # reverse() copied characters with strncpy(), which stopped at the null byte in a code unit
            assertEq("éh", convert_encoding(reverse(s), "UTF-8"), enc);

            # chomp() compared raw bytes against "\n" and "\r"
            assertEq("x", convert_encoding(chomp(convert_encoding("x\n", enc)), "UTF-8"), enc);
            assertEq("x", convert_encoding(chomp(convert_encoding("x\r\n", enc)), "UTF-8"), enc);
            assertEq("x", convert_encoding(chomp(convert_encoding("x", enc)), "UTF-8"), enc);
            assertEq("x\ry", convert_encoding(chomp(convert_encoding("x\ry", enc)), "UTF-8"), enc);

            # replace() appended the tail after the last match as a null-terminated string
            assertEq("héLLO wörld", convert_encoding(replace(convert_encoding("héllo wörld", enc),
                convert_encoding("llo", enc), convert_encoding("LLO", enc)), "UTF-8"), enc);

            # these predicates determined the argument's byte length with strlen(), which is 0 for
            # big-endian UTF-16 data starting with an ASCII character, so every argument matched
            assertTrue(s.startsWith(convert_encoding("h", enc)), enc);
            assertFalse(s.startsWith(convert_encoding("zz", enc)), enc);
            assertTrue(s.endsWith(convert_encoding("é", enc)), enc);
            assertFalse(s.endsWith(convert_encoding("zz", enc)), enc);
            assertTrue(s.contains(convert_encoding("é", enc)), enc);
            assertFalse(s.contains(convert_encoding("zz", enc)), enc);
            assertEq(0, s.comparePartial(convert_encoding("h", enc)), enc);
            assertEq(-1, s.comparePartial(convert_encoding("zz", enc)), enc);

            # a full round trip through the encoding must not change the string
            assertEq(utf8, convert_encoding(convert_encoding(utf8, enc), "UTF-8"), enc);
        }

        # a byte order mark selects the byte order for the byte-order-neutral "UTF-16" encoding and is
        # removed from the string
        string be = binary_to_string(<feff006800e9>, "UTF-16");
        assertEq("UTF-16BE", be.encoding());
        assertEq(2, be.length());
        assertEq("hé", convert_encoding(be, "UTF-8"));

        string le = binary_to_string(<fffe6800e900>, "UTF-16");
        assertEq("UTF-16LE", le.encoding());
        assertEq(2, le.length());
        assertEq("hé", convert_encoding(le, "UTF-8"));

        # UTF-16 data with no byte order mark is big-endian
        string none = binary_to_string(<006800e9>, "UTF-16");
        assertEq("UTF-16", none.encoding());
        assertEq(2, none.length());
        assertEq("hé", convert_encoding(none, "UTF-8"));

        # an explicit byte order is not changed by a byte order mark, but the mark is still removed
        string ebe = binary_to_string(<feff006800e9>, "UTF-16BE");
        assertEq("UTF-16BE", ebe.encoding());
        assertEq(2, ebe.length());
        assertEq("hé", convert_encoding(ebe, "UTF-8"));

        string ele = binary_to_string(<fffe6800e900>, "UTF-16LE");
        assertEq("UTF-16LE", ele.encoding());
        assertEq(2, ele.length());
        assertEq("hé", convert_encoding(ele, "UTF-8"));

        # UTF-16 is not self-synchronizing: the low byte of one code unit and the high byte of the
        # next can form the byte sequence of a different character, so a byte-oriented substring
        # search could match at a position that is not a character boundary.  Here U+0100 followed by
        # U+0A41 produces the byte pair that encodes "\n" straddling the character boundary
        string benl = convert_encoding("\n", "UTF-16BE");
        string be_split = convert_encoding("x\u{100}\u{A41}y", "UTF-16BE");
        assertEq("007801000a410079", be_split.toHex());
        assertEq(4, be_split.length());
        assertEq(-1, index(be_split, benl));
        assertEq(-1, rindex(be_split, benl));
        assertFalse(be_split.contains(benl));
        assertEq(1, be_split.split(benl).size());
        assertEq(1, (map $1, be_split.splitString(benl)).size());
        assertEq(be_split.toHex(), replace(be_split, benl, convert_encoding("Z", "UTF-16BE")).toHex());
        assertEq(be_split.toHex(), be_split.getLine().toHex());

        # the same with the characters reversed in UTF-16LE
        string lenl = convert_encoding("\n", "UTF-16LE");
        string le_split = convert_encoding("x\u{A41}\u{100}y", "UTF-16LE");
        assertEq("7800410a00017900", le_split.toHex());
        assertEq(4, le_split.length());
        assertEq(-1, index(le_split, lenl));
        assertEq(-1, rindex(le_split, lenl));
        assertFalse(le_split.contains(lenl));
        assertEq(1, le_split.split(lenl).size());
        assertEq(1, (map $1, le_split.splitString(lenl)).size());
        assertEq(le_split.toHex(), replace(le_split, lenl, convert_encoding("Z", "UTF-16LE")).toHex());
        assertEq(le_split.toHex(), le_split.getLine().toHex());

        # a separator that really is at a character boundary is still found
        string real = convert_encoding("x\u{100}\n\u{A41}y", "UTF-16BE");
        assertEq(2, index(real, benl));
        assertEq(2, rindex(real, benl));
        assertTrue(real.contains(benl));
        assertEq(2, real.split(benl).size());
        assertEq(2, (map $1, real.splitString(benl)).size());
        assertEq("x\u{100}", convert_encoding(real.getLine(), "UTF-8"));
        assertEq("x\u{100}Z\u{A41}y", convert_encoding(replace(real, benl,
            convert_encoding("Z", "UTF-16BE")), "UTF-8"));

        # concatUnicode() concatenated a 0x01 byte instead of the character with any encoding other
        # than UTF-8, because the temporary string holder was converted to bool and then to char
        assertEq(<61e962>, binary(html_decode(convert_encoding("a&eacute;b", "ISO-8859-1"))));

        # entity encoding and decoding are still not supported with non-ASCII-compatible encodings
        assertThrows("UNSUPPORTED-ENCODING", \html_decode(), convert_encoding("a&eacute;b", "UTF-16BE"));
        assertThrows("UNSUPPORTED-ENCODING", \html_encode(), convert_encoding("a<b", "UTF-16BE"));
    }

    testUtf16() {
        string a = convert_encoding("xbcd", "UTF16BE");
        string b = convert_encoding("aaaa", "UTF16BE");
        assertTrue(a != b);
        assertFalse(a != a);
        assertFalse(a == b);
        assertFalse(a === b);
        assertTrue(a == a);
        assertTrue(a === a);
        assertTrue(a > b);
        assertTrue(a >= b);
        assertFalse(a > a);
        assertTrue(a >= a);
        assertTrue(b < a);
        assertTrue(b <= a);
        assertFalse(b < b);
        assertTrue(b <= b);
        assertEq(1, a <=> b);
        assertEq(0, a <=> a);
        assertEq(-1, b <=> a);
        assertTrue(b.equalPartial(b));
        assertFalse(b.equalPartial(a));
        assertFalse(b.equalPartial(b+b));
        assertTrue(b.equalPartial(b.substr(2)));
        assertTrue(b.equalPartial(b.substr(2, 1)));
        assertTrue(b.equalPartial(b.substr(2, -1)));
        assertTrue(b.equalPartial(substr(b, 2)));
        assertTrue(b.equalPartial(substr(b, 2, 1)));
        assertTrue(b.equalPartial(substr(b, 2, -1)));

        string c = convert_encoding("abcd", "UTF16LE");
        string d = convert_encoding("aaaa", "UTF16LE");
        assertTrue(c != d);
        assertFalse(c != c);
        assertFalse(c == d);
        assertFalse(c === d);
        assertTrue(c == c);
        assertTrue(c === c);
        assertTrue(c > d);
        assertTrue(c >= d);
        assertFalse(c > c);
        assertTrue(c >= c);
        assertTrue(d < c);
        assertTrue(d <= c);
        assertFalse(d < d);
        assertTrue(d <= d);
        assertEq(1, c <=> d);
        assertEq(0, c <=> c);
        assertEq(-1, d <=> c);
        assertTrue(d.equalPartial(d));
        assertFalse(d.equalPartial(c));
        assertFalse(d.equalPartial(d+d));
        assertTrue(d.equalPartial(d.substr(2)));
        assertTrue(d.equalPartial(d.substr(2, 1)));
        assertTrue(d.equalPartial(d.substr(2, -1)));
        assertTrue(d.equalPartial(substr(d, 2)));
        assertTrue(d.equalPartial(substr(d, 2, 1)));
        assertTrue(d.equalPartial(substr(d, 2, -1)));

        a = convert_encoding("\nabcd\n", "UTF16BE");
        assertEq("abcd", trim(a));
        a = convert_encoding("\nabcd\n", "UTF16BE");
        assertEq("abcd", trim(a, "12\n3"));
        a = convert_encoding("\nabcd\n", "UTF16BE");
        assertEq("\nabcd", rtrim(a));
        a = convert_encoding("\nabcd\n", "UTF16BE");
        assertEq("\nabcd", rtrim(a, "12\n3"));
        a = convert_encoding("\nabcd\n", "UTF16BE");
        assertEq("abcd\n", ltrim(a));
        a = convert_encoding("\nabcd\n", "UTF16BE");
        assertEq("abcd\n", ltrim(a, "12\n3"));
        a = convert_encoding("\nabcd\n", "UTF16BE");
        assertEq("abcd", trim a);

        a = convert_encoding("\r\nabcd\r\n", "UTF16BE");
        assertEq("abcd", trim(a));
        a = convert_encoding("\r\nabcd\r\n", "UTF16BE");
        assertEq("abcd", trim(a, "12\r\n3"));
        a = convert_encoding("\r\nabcd\r\n", "UTF16BE");
        assertEq("\r\nabcd", rtrim(a));
        a = convert_encoding("\r\nabcd\r\n", "UTF16BE");
        assertEq("\r\nabcd", rtrim(a, "12\r\n3"));
        a = convert_encoding("\r\nabcd\r\n", "UTF16BE");
        assertEq("abcd\r\n", ltrim(a));
        a = convert_encoding("\r\nabcd\r\n", "UTF16BE");
        assertEq("abcd\r\n", ltrim(a, "12\r\n3"));
        a = convert_encoding("\r\nabcd\r\n", "UTF16BE");
        assertEq("abcd", trim a);

        a = convert_encoding("\rabcd\r", "UTF16BE");
        assertEq("abcd", trim(a));
        a = convert_encoding("\rabcd\r", "UTF16BE");
        assertEq("abcd", trim(a, "12\r3"));
        a = convert_encoding("\rabcd\r", "UTF16BE");
        assertEq("\rabcd", rtrim(a));
        a = convert_encoding("\rabcd\r", "UTF16BE");
        assertEq("\rabcd", rtrim(a, "12\r3"));
        a = convert_encoding("\rabcd\r", "UTF16BE");
        assertEq("abcd\r", ltrim(a));
        a = convert_encoding("\rabcd\r", "UTF16BE");
        assertEq("abcd\r", ltrim(a, "12\r3"));
        a = convert_encoding("\rabcd\r", "UTF16BE");
        assertEq("abcd", trim a);

        a = convert_encoding("\nabcd\n", "UTF16LE");
        assertEq("abcd", trim(a));
        a = convert_encoding("\nabcd\n", "UTF16LE");
        assertEq("abcd", trim(a, "12\n3"));
        a = convert_encoding("\nabcd\n", "UTF16LE");
        assertEq("\nabcd", rtrim(a));
        a = convert_encoding("\nabcd\n", "UTF16LE");
        assertEq("\nabcd", rtrim(a, "12\n3"));
        a = convert_encoding("\nabcd\n", "UTF16LE");
        assertEq("abcd\n", ltrim(a));
        a = convert_encoding("\nabcd\n", "UTF16LE");
        assertEq("abcd\n", ltrim(a, "12\n3"));
        a = convert_encoding("\nabcd\n", "UTF16LE");
        assertEq("abcd", trim a);

        a = convert_encoding("\r\nabcd\r\n", "UTF16LE");
        assertEq("abcd", trim(a));
        a = convert_encoding("\r\nabcd\r\n", "UTF16LE");
        assertEq("abcd", trim(a, "12\r\n3"));
        a = convert_encoding("\r\nabcd\r\n", "UTF16LE");
        assertEq("\r\nabcd", rtrim(a));
        a = convert_encoding("\r\nabcd\r\n", "UTF16LE");
        assertEq("\r\nabcd", rtrim(a, "12\r\n3"));
        a = convert_encoding("\r\nabcd\r\n", "UTF16LE");
        assertEq("abcd\r\n", ltrim(a));
        a = convert_encoding("\r\nabcd\r\n", "UTF16LE");
        assertEq("abcd\r\n", ltrim(a, "12\r\n3"));
        a = convert_encoding("\r\nabcd\r\n", "UTF16LE");
        assertEq("abcd", trim a);

        a = convert_encoding("\rabcd\r", "UTF16LE");
        assertEq("abcd", trim(a));
        a = convert_encoding("\rabcd\r", "UTF16LE");
        assertEq("abcd", trim(a, "12\r3"));
        a = convert_encoding("\rabcd\r", "UTF16LE");
        assertEq("\rabcd", rtrim(a));
        a = convert_encoding("\rabcd\r", "UTF16LE");
        assertEq("\rabcd", rtrim(a, "12\r3"));
        a = convert_encoding("\rabcd\r", "UTF16LE");
        assertEq("abcd\r", ltrim(a));
        a = convert_encoding("\rabcd\r", "UTF16LE");
        assertEq("abcd\r", ltrim(a, "12\r3"));
        a = convert_encoding("\rabcd\r", "UTF16LE");
        assertEq("abcd", trim a);

        assertEq("ABCD", toupper(a));
        assertEq("ABCD", a.upr());
        assertEq("abcd", tolower(toupper(a)));
        assertEq("abcd", a.upr().lwr());
        assertEq(("a", "cd"), split(convert_encoding("b", "UTF16LE"), a));
        assertEq(("a", "cd"), a.split(convert_encoding("b", "UTF16LE")));
        assertEq(("a", "cd"), split(convert_encoding("b", "UTF16BE"), a));
        assertEq(("a", "cd"), a.split(convert_encoding("b", "UTF16BE")));

        string lstr = convert_encoding("a,b,c", "UTF16LE");
        assertEq(("a", "b", "c"), split(convert_encoding(",", "UTF16LE"), lstr));
        assertEq(("a", "b", "c"), lstr.split(convert_encoding(",", "UTF16LE")));
        lstr = convert_encoding("a,'b,c,d',e", "UTF16LE");
        assertEq(("a", "b,c,d", "e"), split(convert_encoding(",", "UTF16LE"), lstr, convert_encoding("'", "UTF16LE")));
        assertEq(("a", "b,c,d", "e"), lstr.split(convert_encoding(",", "UTF16LE"), convert_encoding("'", "UTF16LE")));

        lstr = convert_encoding("a,b,c", "UTF16BE");
        assertEq(("a", "b", "c"), split(convert_encoding(",", "UTF16BE"), lstr));
        assertEq(("a", "b", "c"), lstr.split(convert_encoding(",", "UTF16BE")));
        lstr = convert_encoding("a,'b,c,d',e", "UTF16BE");
        assertEq(("a", "b,c,d", "e"), split(convert_encoding(",", "UTF16BE"), lstr, convert_encoding("'", "UTF16BE")));
        assertEq(("a", "b,c,d", "e"), lstr.split(convert_encoding(",", "UTF16BE"), convert_encoding("'", "UTF16BE")));

        # test strings with double quotes and escaped quotes as part of the field
        lstr = "a,'',b,'c','''d''',e,'f''1'''";
        assertEq(("a", "", "b", "c","'d'","e","f'1'"), lstr.split(",", "'"));
        lstr = "a,b'c','\\'d','e''1',f";
        assertEq(("a", "b'c'","'d","e'1","f"), lstr.split(",", "'"));
        assertThrows("SPLIT-ERROR", \split(), (",", "a,'asdsad", "'"));
        assertThrows("SPLIT-ERROR", \split(), (",", "a,''ad", "'"));
        assertThrows("SPLIT-ERROR", \split(), (",", "a,'ad'x,b", "'"));

        # test currently unsupported operations
        assertThrows("UNSUPPORTED-ENCODING", \html_encode(), a);
        assertThrows("UNSUPPORTED-ENCODING", \html_decode(), a);
        assertThrows("UNSUPPORTED-ENCODING", \encode_url(), a);
        assertThrows("UNSUPPORTED-ENCODING", \encode_uri_request(), a);
        assertThrows("UNSUPPORTED-ENCODING", sub (string str) { str.equalPartialPath(str); }, a);
        assertThrows("UNSUPPORTED-ENCODING", sub (string str) { str.toInt(16); }, a);

        assertEq("%22hello%22", encode_url("\"hello\""));
        assertEq("%22hello%22", encode_uri_request("\"hello\""));
    }

    testASCIIUTF8Equality() {
        string a = convert_encoding("ěščřžýáíé", "UTF-8");
        string b = convert_encoding("escrzyaie", "ASCII");
        assertFalse(a == b);
        assertTrue(a != b);
        assertFalse(b == a);
        assertTrue(b != a);
        assertFalse(a.equalPartial(b));
        assertFalse(b.equalPartial(a));
        assertFalse(a.equalPartialPath(b));
        assertFalse(b.equalPartialPath(a));
    }

    testBase64Hex() {
        # assign binary object
        binary x = <0abf83e8ca72d32c>;
        string b64 = make_base64_string(x);
        assertEq(x, parse_base64_string(b64), "first base64");
        assertEq("aGVsbG8=", make_base64_string("hello"), "make_base64_string()");
        string b64url = make_base64_url_string(x);
        assertEq(x, parse_base64_url_string(b64url), "first base64-url");
        assertEq("aGVsbG8", make_base64_url_string("hello"), "first make_base64_url_string()");
        b64url = x.toBase64Url();
        assertEq(x, parse_base64_url_string(b64url), "first <string>::toBase64Url()");
        assertEq("aGVsbG8", make_base64_url_string("hello"), "second make_base64_url_string()");

        binary b = get_random_bytes(1024);
        b64 = make_base64_string(b);
        assertEq(b, parse_base64_string(b64));
        b64 = make_base64_url_string(b);
        assertEq(b, parse_base64_url_string(b64));

        string hex = make_hex_string(x);
        assertEq(x, parse_hex_string(hex), "first hex");
        assertEq("", parse_base64_string_to_string(""));
    }

    testSplice() {
        # UTF-8 string splice operator tests
        string str = "äbcdéf";
        splice str, 5;
        assertEq(str, "äbcdé", "first UTF-8 string splice");
        splice str, 3, 1;
        assertEq(str, "äbcé", "second UTF-8 string splice");
        splice str, 1, 2, "GHI";
        assertEq(str, "äGHIé", "third UTF-8 string splice");
        splice str, 0, 4, "jkl";
        assertEq(str, "jklé", "fourth UTF-8 string splice");
        splice str, 0, 1;
        assertEq(str, "klé", "fifth UTF-8 string splice");
        splice str, 5, 2, "MNO";
        assertEq(str, "kléMNO", "sixth UTF-8 string splice");
        splice str, -4, 2, "p";
        assertEq(str, "klpNO", "seventh UTF-8 string splice");
        splice str, -4, -2, "QRS";
        assertEq(str, "kQRSNO", "eighth UTF-8 string splice");

        # single-byte string splice operator tests
        str = convert_encoding("äbcdéf", "ISO-8859-1");
        splice str, 5;
        assertTrue(str == "äbcdé", "first ISO-8859-1 string splice");
        splice str, 3, 1;
        assertTrue(str == "äbcé", "second ISO-8859-1 string splice");
        splice str, 1, 2, "GHI";
        assertTrue(str == "äGHIé", "third ISO-8859-1 string splice");
        splice str, 0, 4, "jkl";
        assertTrue(str == "jklé", "fouth ISO-8859-1 string splice");
        splice str, 0, 1;
        assertTrue(str == "klé", "fifth ISO-8859-1 string splice");
        splice str, 5, 2, "MNO";
        assertTrue(str == "kléMNO", "sixth ISO-8859-1 string splice");
        splice str, -4, 2, "p";
        assertTrue(str == "klpNO", "seventh ISO-8859-1 string splice");
        splice str, -4, -2, "QRS";
        assertTrue(str == "kQRSNO", "eighth ISO-8859-1 string splice");

        # UTF-8 string splice function tests
        str = "äbcdéf";
        str = splice str, 5;
        assertEq(str, "äbcdé", "first UTF-8 string splice");
        str = splice str, 3, 1;
        assertEq(str, "äbcé", "second UTF-8 string splice");
        str = splice str, 1, 2, "GHI";
        assertEq(str, "äGHIé", "third UTF-8 string splice");
        str = splice str, 0, 4, "jkl";
        assertEq(str, "jklé", "fourth UTF-8 string splice");
        str = splice str, 0, 1;
        assertEq(str, "klé", "fifth UTF-8 string splice");
        str = splice str, 5, 2, "MNO";
        assertEq(str, "kléMNO", "sixth UTF-8 string splice");
        str = splice str, -4, 2, "p";
        assertEq(str, "klpNO", "seventh UTF-8 string splice");
        str = splice str, -4, -2, "QRS";
        assertEq(str, "kQRSNO", "eighth UTF-8 string splice");

        # single-byte string splice function tests
        str = convert_encoding("äbcdéf", "ISO-8859-1");
        str = splice str, 5;
        assertTrue(str == "äbcdé", "first ISO-8859-1 string splice");
        str = splice str, 3, 1;
        assertTrue(str == "äbcé", "second ISO-8859-1 string splice");
        str = splice str, 1, 2, "GHI";
        assertTrue(str == "äGHIé", "third ISO-8859-1 string splice");
        str = splice str, 0, 4, "jkl";
        assertTrue(str == "jklé", "fouth ISO-8859-1 string splice");
        str = splice str, 0, 1;
        assertTrue(str == "klé", "fifth ISO-8859-1 string splice");
        str = splice str, 5, 2, "MNO";
        assertTrue(str == "kléMNO", "sixth ISO-8859-1 string splice");
        str = splice str, -4, 2, "p";
        assertTrue(str == "klpNO", "seventh ISO-8859-1 string splice");
        str = splice str, -4, -2, "QRS";
        assertTrue(str == "kQRSNO", "eighth ISO-8859-1 string splice");
    }

    testExtract() {
        # UTF-8 string extract tests
        string str = "äbcdéf";
        assertEq((extract str, 4), "éf", "first UTF-8 string extract");
        assertEq((extract str, 1, 2), "bc", "second UTF-8 string extract");
        assertEq((extract str, 1, 1, "bcdef"), "d", "third UTF-8 string extract");
        assertEq(str, "äbcdef", "final UTF-8 string extract");

        str = convert_encoding("äbcdéf", "ISO-8859-1");
        string val = extract str, 4;
        assertTrue(val == "éf", "first UTF-8 string extract");
        val = extract str, 1, 2;
        assertTrue(val == "bc", "second UTF-8 string extract");
        val = extract str, 1, 1, "bcdef";
        assertTrue(val == "d", "third UTF-8 string extract");
        assertTrue(str == "äbcdef", "final UTF-8 string extract");
    }

    testJoin() {
        string str = join(":", "login","passwd",1,"gid","gcos","home","shell");
        assertEq(str, "login:passwd:1:gid:gcos:home:shell", "first join");
        list l = ("login","passwd","uid","gid","gcos","home","shell");
        str = join(":", l);
        assertEq(str, "login:passwd:uid:gid:gcos:home:shell", "second join");
    }

    testTransliteration() {
        string str = "Hello There";
        assertEq(str =~ tr/def/123/, "H2llo Th2r2", "first transliteration");
        assertEq(str =~ tr/a-z/0-9/, "H2999 T7292", "first range transliteration");
        str = "Hello There";
        assertEq(str =~ tr/a-z/A-Z/, "HELLO THERE", "second range transliteration");
        assertEq(str =~ tr/A-Z/a-z/, "hello there", "third range transliteration");
    }

    testRegex() {
        # regex subpattern extraction operator tests
        assertEq("xmlns:wsdl" =~ x/(\w+):(\w+)/, ("xmlns", "wsdl"), "regex subpattern extraction");
        assertEq("xmlns-wsdl" =~ x/(\w+):(\w+)/, NOTHING, "negative regex subpattern extraction");

        # unicode match tests
        assertNothing("ステップの例:1.0" =~ x/(\w+):([[:alnum:]\._]+)/);
        assertEq(("ステップの例", "1.0"), ("ステップの例:1.0" =~ x/(\w+):([[:alnum:]\._]+)/u));
        assertNothing(regex_extract("ステップの例:1.0", "(\\w+):([[:alnum:]\\._]+)"));
        assertEq(("ステップの例", "1.0"), regex_extract("ステップの例:1.0", "(\\w+):([[:alnum:]\\._]+)", RE_Unicode));

        assertEq(regex_extract("xmlns:wsdl", "(\\w+):(\\w+)"), ("xmlns", "wsdl"), "regex_extract()");
        {
            *list<*string> l = ("xmlns:wsdl" =~ x/(\w+):(\w+)/);
            assertEq(True, l.complexType());
            assertEq("list<*string>", l.fullType());
            l = regex_extract("xmlns:wsdl", "(\\w+):(\\w+)");
            assertEq(True, l.complexType());
            assertEq("list<*string>", l.fullType());
        }

        # regex operator tests
        assertTrue("hello" =~ /^hel*/, "regular expression positive match");
        assertFalse("hello" =~ m/123*/, "regular expression negative match");
        assertTrue("hello" =~ m/^HEL*/i, "regular expression case-insensitive positive match");
        assertFalse("hello" =~ /^HEL*/, "regular expression case-insensitive negative match");
        assertTrue("test\nx" =~ /test.x/s, "regular expression newline positive match");
        assertFalse("test\nx" =~ /test.x/, "regular expression newline negative match");
        assertTrue("hello" =~ /^  hel* #comment/x, "extended regular expression positive match");
        assertFalse("hello" =~ /^  hel* #comment/, "extended regular expression negative match");
        assertTrue("test\nx123" =~ /^x123/m, "multiline regular expression positive match");
        assertFalse("test\nx123" =~ /^x123/, "multiline regular expression negative match");
        # NOTE that escaping UTF-8 characters (\ä) doesn't work on PPC for some reason
        assertTrue("testäöüß" =~ /äöüß/, "regular expression UTF-8 match");
        assertFalse("testäöüß" =~ /aouB/, "regular expression UTF-8 negative match");
        assertFalse("hello" !~ /hel*/, "negative regular expression negative match");
        assertTrue("hello" !~ /123*/, "negative regular expression positive match");

        # regex substitution operator tests
        list l = ( "hello bar hi bar", "bar hello bar hi bar", "hello bar hi" );
        assertEq(l[0] =~ s/bar/foo/, "hello foo hi bar", "first non-global regular expression substitution");
        assertEq(l[1] =~ s/bar/foo/, "foo hello bar hi bar", "second non-global regular expression substitution");
        assertEq(l[2] =~ s/BAR/foo/i, "hello foo hi", "case-insensitive non-global regular expression substitution");
        l = ( "hello bar hi bar", "bar hello bar hi bar", "hello bar hi" );
        assertEq(l[0] =~ s/bar/foo/g, "hello foo hi foo", "first global regular expression substitution");
        assertEq(l[1] =~ s/bar/foo/g, "foo hello foo hi foo", "second global regular expression substitution");
        assertEq(l[2] =~ s/BAR/foo/ig, "hello foo hi", "case-insensitive global regular expression substitution");

        string astr= "abc def";
        astr =~ s/(\w+) +(\w+)/$2, $1/;
        assertEq(astr, "def, abc", "regular expression subpattern substitution");

        # regex() tests
        assertTrue(regex("hello", "^hel*"), "regex() positive match");
        assertFalse(regex("hello", "123*"), "regex() negative match");
        assertTrue(regex("hello", "^HEL*", RE_Caseless), "regex() case-insensitive positive match");
        assertFalse(regex("hello", "^HEL*"), "regex() case-insensitive negative match");
        assertTrue(regex("test\nx", "test.x", RE_DotAll), "regex() newline positive match");
        assertFalse(regex("test\nx", "test.x/"), "regex() newline negative match");
        assertTrue(regex("hello", "^  hel* #comment", RE_Extended), "regex() extended positive match");
        assertFalse(regex("hello", "^  hel* #comment"), "regex() extended negative match");
        assertTrue(regex("test\nx123", "^x123", RE_MultiLine), "regex() multiline positive match");
        assertFalse(regex("test\nx123", "^x123/"), "regex() multiline negative match");
        assertTrue(regex("testäöüß", "\äöüß"), "regex() UTF-8 match");
        assertFalse(regex("testäöüß", "aouB"), "regex() UTF-8 negative match");

        # regex_subst() tests
        l = ( "hello bar hi bar", "bar hello bar hi bar", "hello bar hi" );
        assertEq(regex_subst(l[0], "bar", "foo"), "hello foo hi bar", "first non-global regex_subst()");
        assertEq(regex_subst(l[1], "bar", "foo"), "foo hello bar hi bar", "second non-global regex_subst()");
        assertEq(regex_subst(l[2], "BAR", "foo", RE_Caseless), "hello foo hi", "case-insensitive non-global regex_subst()");
        l = ( "hello bar hi bar", "bar hello bar hi bar", "hello bar hi" );
        assertEq(regex_subst(l[0], "bar", "foo", RE_Global), "hello foo hi foo", "first global regex_subst()");
        assertEq(regex_subst(l[1], "bar", "foo", RE_Global), "foo hello foo hi foo", "second global regex_subst()");
        assertEq(regex_subst(l[2], "BAR", "foo", RE_Global|RE_Caseless), "hello foo hi", "case-insensitive global regex_subst()");

        astr = "abc def";
        # note that the escape characters have to be escaped in the following pattern string
        assertEq(regex_subst(astr, "(\\w+) +(\\w+)", "$2, $1"), "def, abc", "first subpattern regex_subst()");
        # here we use single-quotes, so the escape characters do not have to be escaped
        assertEq(regex_subst(astr, '(\w+) +(\w+)', "$2, $1"), "def, abc", "second subpattern regex_subst()");
    }

    testChompAndTrim() {
        # chomp tests
        string str = "hello\n";
        chomp str;
        assertEq(str, "hello", "first string chomp");
        str += "\r\n";
        chomp str;
        assertEq(str, "hello", "second string chomp");
        list l = ( 1, "hello\n", 3.0, True, "test\r\n" );
        chomp l;
        assertEq(l, ( 1, "hello", 3.0, True, "test" ), "list chomp");

        hash h = ( "key1" : "hello\n", "key2" : 2045, "key3": "test\r\n", "key4" : 302.223 );
        chomp h;
        assertEq(h, ( "key1" : "hello", "key2" : 2045, "key3": "test", "key4" : 302.223 ), "hash chomp");
        str = "hello\n";
        chomp(\str);
        assertEq(str, "hello", "string reference chomp()");
        str = "  \t\n  hello  \n   \r \t \0 ";
        trim str;
        assertEq("hello", str, "trim string operator test");
        str = "  \t\n  hello  \n   \r \t \0 ";
        trim(\str);
        assertEq("hello", str, "trim string reference test");

        str = "  \t\n  hello  \n   \r \t \0 ";
        assertEq("hello", trim(str), "trim string function test");
        assertEq("  \t\n  hello", rtrim(str), "rtrim string function test");
        assertEq("hello  \n   \r \t \0 ", ltrim(str), "ltrim string function test");

        str = "  \t\n  hello  \n   \r \t \0 ";
        rtrim(\str);
        assertEq("  \t\n  hello", str, "rtrim string reference test");
        str = "  \t\n  hello  \n   \r \t \0 ";
        ltrim(\str);
        assertEq("hello  \n   \r \t \0 ", str, "ltrim string reference test");

        l = ( 1, "   \r \t hello  \n  \r \v \t", 3.0, True, "    test\r\n  " );
        trim l;
        assertEq((1, "hello", 3.0, True, "test"), l, "list trim");

        h = {"key1" : "    hello\n \r  ", "key2" : 2045, "key3": "     test\r   \n \t\v   ", "key4" : 302.223};
        trim h;
        assertEq({"key1" : "hello", "key2" : 2045, "key3": "test", "key4" : 302.223}, h, "hash trim");

        softstring tstr = 1;
        tstr += "\n";
        chomp(\tstr);
        assertEq("1", tstr);
    }

    testFloat() {
        # make sure strings containing floating-point numbers between -1.0 and 1.0 exclusive return True when evaluated in a boolean context
        assertTrue(boolean("0.1"), "first string fp boolean");
        assertTrue(boolean("-0.1"), "second string fp boolean");

        # regression tests for floating-point formatting bugs
        assertEq(sprintf("%f", 1.5), "1.500000", "%f float");
        assertEq(sprintf("%f", 1.5n), "1.500000", "%f number");
        assertEq(sprintf("%g", 1.5), "1.5", "%f float");
        assertEq(sprintf("%g", 1.5n), "1.5", "%f number");
    }

    testConversions() {
        # NULL is treated like NOTHING for soft types — rejected for non-optional softstring
        assertThrows("PARSE-TYPE-ERROR", sub () {
            Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
            p.parse("string s = string(NULL);", "test", WARN_DEFAULT);
        });
    }

    testTrim() {
        string a = "\nabcd\n";
        assertEq("abcd", trim(a));
        a = "\nabcd\n";
        assertEq("abcd", trim(a, "12\n3"));
        a = "\nabcd\n";
        assertEq("\nabcd", rtrim(a));
        a = "\nabcd\n";
        assertEq("\nabcd", rtrim(a, "12\n3"));
        a = "\nabcd\n";
        assertEq("abcd\n", ltrim(a));
        a = "\nabcd\n";
        assertEq("abcd\n", ltrim(a, "12\n3"));
        a = "\nabcd\n";
        assertEq("abcd", trim a);

        a = "\r\nabcd\r\n";
        assertEq("abcd", trim(a));
        a = "\r\nabcd\r\n";
        assertEq("abcd", trim(a, "12\r\n3"));
        a = "\r\nabcd\r\n";
        assertEq("\r\nabcd", rtrim(a));
        a = "\r\nabcd\r\n";
        assertEq("\r\nabcd", rtrim(a, "12\r\n3"));
        a = "\r\nabcd\r\n";
        assertEq("abcd\r\n", ltrim(a));
        a = "\r\nabcd\r\n";
        assertEq("abcd\r\n", ltrim(a, "12\r\n3"));
        a = "\r\nabcd\r\n";
        assertEq("abcd", trim a);

        a = "\rabcd\r";
        assertEq("abcd", trim(a));
        a = "\rabcd\r";
        assertEq("abcd", trim(a, "12\r3"));
        a = "\rabcd\r";
        assertEq("\rabcd", rtrim(a));
        a = "\rabcd\r";
        assertEq("\rabcd", rtrim(a, "12\r3"));
        a = "\rabcd\r";
        assertEq("abcd\r", ltrim(a));
        a = "\rabcd\r";
        assertEq("abcd\r", ltrim(a, "12\r3"));
        a = "\rabcd\r";
        assertEq("abcd", trim a);
    }
}
