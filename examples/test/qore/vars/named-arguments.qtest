#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit

%exec-class NamedArgumentsTest

string sub na_defaults(int a = 1, int b = 2, int c = 3) {
    return sprintf("%d:%d:%d", a, b, c);
}

string sub na_required(int a, int b, int c = 3) {
    return sprintf("%d:%d:%d", a, b, c);
}

our list<int> na_order;

int sub na_mark(int v) {
    na_order += v;
    return v;
}

string sub na_misc_concat(string left, string right) {
    return sprintf("%s%s", left, right);
}

string sub na_pair(int a, int b) {
    return sprintf("%d:%d", a, b);
}

nothing sub na_set_ref(reference<int> target, int value) {
    target = value;
}

string sub na_fixed_varargs(int a, int b = 2, ...) {
    return sprintf("%d:%d", a, b);
}

string sub na_pick(int count, string mode = "default") {
    return sprintf("count:%d:%s", count, mode);
}

string sub na_pick(float size, string unit = "m") {
    return sprintf("size:%s:%s", size, unit);
}

number sub na_math_floor(number value, int precision) {
    return floor(precision: precision, value: value);
}

int sub na_math_compare(float left, float right, float epsilon) {
    return compare(left: left, right: right, epsilon: epsilon);
}

int sub na_math_compare_number(number left, number right, number epsilon) {
    return compare(left: left, right: right, epsilon: epsilon);
}

float sub na_math_hypot(float x, float y) {
    return hypot(x: x, y: y);
}

float sub na_math_atan2(float x, float y) {
    return atan2(x: x, y: y);
}

class NA_Base {
    public {
        string base_value;
    }

    constructor(int a = 1, int b = 2) {
        base_value = sprintf("%d:%d", a, b);
    }
}

class NA_Child inherits NA_Base {
    public {
        string child_value;
    }

    constructor(int x = 3, int y = 4) : NA_Base(b: na_mark(20), a: na_mark(10)) {
        child_value = sprintf("%d:%d", x, y);
    }

    string method(int a, int b = 2) {
        return sprintf("%d:%d", a, b);
    }

    static string staticMethod(int a, int b = 2) {
        return sprintf("%d:%d", a, b);
    }
}

class NA_Logger inherits LoggerInterfaceBase {
    public {
        list<hash<auto>> messages();
    }

    logArgs(int level, string message, *softlist<auto> format_args) {
        push messages, {
            "level": level,
            "message": format_args ? vsprintf(message, format_args) : message,
        };
    }

    bool isEnabledFor(int level) {
        return level >= 1000;
    }
}

public class NamedArgumentsTest inherits QUnit::Test {
    constructor() : Test("Named arguments test", "1.0") {
        addTestCase("defaults and mixed arguments", \defaultsAndMixedArguments(), NOTHING);
        addTestCase("methods and constructors", \methodsAndConstructors(), NOTHING);
        addTestCase("references and varargs", \referencesAndVarargs(), NOTHING);
        addTestCase("source evaluation order", \sourceEvaluationOrder(), NOTHING);
        addTestCase("overload selection by name", \overloadSelectionByName(), NOTHING);
        addTestCase("builtin opt-in", \builtinOptIn(), NOTHING);
        addTestCase("reviewed math builtin opt-in", \reviewedMathBuiltinOptIn(), NOTHING);
        addTestCase("reviewed type builtin opt-in", \reviewedTypeBuiltinOptIn(), NOTHING);
        addTestCase("reviewed string builtin opt-in", \reviewedStringBuiltinOptIn(), NOTHING);
        addTestCase("reviewed utility builtin opt-in", \reviewedUtilityBuiltinOptIn(), NOTHING);
        addTestCase("reviewed list builtin opt-in", \reviewedListBuiltinOptIn(), NOTHING);
        addTestCase("reviewed pwd builtin opt-in", \reviewedPwdBuiltinOptIn(), NOTHING);
        addTestCase("reviewed compression builtin opt-in", \reviewedCompressionBuiltinOptIn(), NOTHING);
        addTestCase("reviewed time builtin opt-in", \reviewedTimeBuiltinOptIn(), NOTHING);
        addTestCase("reviewed object builtin opt-in", \reviewedObjectBuiltinOptIn(), NOTHING);
        addTestCase("reviewed misc builtin opt-in", \reviewedMiscBuiltinOptIn(), NOTHING);
        addTestCase("reviewed crypto builtin opt-in", \reviewedCryptoBuiltinOptIn(), NOTHING);
        addTestCase("reviewed file builtin opt-in", \reviewedFileBuiltinOptIn(), NOTHING);
        addTestCase("reviewed library builtin opt-in", \reviewedLibraryBuiltinOptIn(), NOTHING);
        addTestCase("reviewed parse-options class builtin opt-in", \reviewedParseOptionsClassBuiltinOptIn(),
            NOTHING);
        addTestCase("reviewed thread builtin opt-in", \reviewedThreadBuiltinOptIn(), NOTHING);
        addTestCase("reviewed thread class builtin opt-in", \reviewedThreadClassBuiltinOptIn(), NOTHING);
        addTestCase("reviewed event-loop class builtin opt-in", \reviewedEventLoopClassBuiltinOptIn(),
            NOTHING);
        addTestCase("reviewed HTTP readiness builtin opt-in", \reviewedHttpReadinessBuiltinOptIn(),
            NOTHING);
        addTestCase("reviewed async I/O controller builtin opt-in",
            \reviewedAsyncIoControllerBuiltinOptIn(), NOTHING);
        addTestCase("reviewed stream builtin opt-in", \reviewedStreamBuiltinOptIn(), NOTHING);
        addTestCase("reviewed iterator builtin opt-in", \reviewedIteratorBuiltinOptIn(), NOTHING);
        addTestCase("reviewed regex class builtin opt-in", \reviewedRegexClassBuiltinOptIn(), NOTHING);
        addTestCase("reviewed pseudo-method opt-in", \reviewedPseudoMethodOptIn(), NOTHING);
        addTestCase("parse failures", \parseFailures(), NOTHING);

        # Return for compatibility with test harness that checks return value.
        set_return_value(value: main());
    }

    defaultsAndMixedArguments() {
        assertEq("1:2:100", na_defaults(c: 100), "named default holes");
        assertEq("9:2:100", na_defaults(a: 9, c: 100), "named middle default");
        assertEq("9:2:100", na_required(9, c: 100, b: 2), "positional before named");
    }

    methodsAndConstructors() {
        na_order = ();
        NA_Child child = new NA_Child(y: 8, x: 7);
        assertEq("10:20", child.base_value, "base constructor arguments are mapped by name");
        assertEq("7:8", child.child_value, "constructor arguments are mapped by name");
        assertEq((20, 10), na_order, "base constructor argument evaluation keeps source order");
        assertEq("3:4", child.method(b: 4, a: 3), "method arguments are mapped by name");
        assertEq("5:6", NA_Child::staticMethod(b: 6, a: 5), "static method arguments are mapped by name");
    }

    referencesAndVarargs() {
        int target = 1;
        na_set_ref(value: 9, target: \target);
        assertEq(9, target, "reference arguments are mapped by name");
        assertEq("5:2", na_fixed_varargs(a: 5), "fixed parameters before varargs accept named arguments");
        assertEq("5:6", na_fixed_varargs(b: 6, a: 5), "fixed parameters before varargs are reordered");
    }

    sourceEvaluationOrder() {
        na_order = ();
        assertEq("2:1", na_pair(b: na_mark(1), a: na_mark(2)), "mapped call result");
        assertEq((1, 2), na_order, "source order is preserved");
    }

    overloadSelectionByName() {
        assertEq("count:3:default", na_pick(count: 3), "first variant selected by name");
        assertEq("size:1.5:cm", na_pick(size: 1.5, unit: "cm"), "second variant selected by name");
    }

    builtinOptIn() {
        assertEq("cde", substr(str: "abcdef", start: 2, len: 3), "opted-in builtin accepts named arguments");
        assertEq("de", substr(len: 2, str: "abcdef", start: 3), "opted-in builtin accepts reordered names");
        assertEq("cde", "abcdef".substr(start: 2, length: 3), "opted-in string pseudo-method accepts named arguments");
    }

    reviewedMathBuiltinOptIn() {
        assertEq(8, pow(base: cast<int>(2), exponent: cast<int>(3)), "math builtin uses reviewed public names");
        assertEq(0, na_math_compare_number(357.27n, na_math_floor(357.271n, 2), 0.000000000001n),
            "renamed optional precision can be reordered");
        assertEq(0, na_math_compare(10.0, 10.05, 0.1), "reviewed compare names are accepted");
        assertEq(5.0, na_math_hypot(3.0, 4.0), "canonical hypot names are accepted");
        assertEq(1.0, na_math_atan2(1.0, 1.0) / (M_PI / 4), "canonical atan2 names are accepted");
    }

    reviewedTypeBuiltinOptIn() {
        assertEq(True, boolean(value: 1), "boolean conversion uses value");
        assertEq(254, int(base: 16, value: "fe"), "integer conversion exposes base and value");
        assertEq(3.5, float(value: "3.5"), "float conversion uses value");
        assertEq("string", type(value: "x"), "type inspection uses value");
        assertEq("integer", typename(value: 1), "typename inspection uses value");
        assertEq("A", binary_to_string(encoding: "USASCII", value: binary(value: "A")),
            "binary conversion exposes value and encoding");
    }

    reviewedStringBuiltinOptIn() {
        assertEq(3, length(str: "abc"), "string length accepts named arguments");
        assertEq(3, length(bin: binary(value: "abc")), "binary length accepts named arguments");
        assertEq("cde", binary_to_string(value: substr(bin: binary(value: "abcdef"), start: 2, len: 3),
            encoding: "USASCII"), "binary substr exposes bin/start/len");
        assertEq(2, index(substr: "cd", str: "abcdef", pos: 1), "index exposes search names");
        assertEq(("a", "b"), split(separator: ",", str: "a,b"), "split exposes separator and string");
        assertEq(True, regex(str: "abc123", pattern: "\\d+", options: 0), "regex exposes pattern");
        assertEq("abcX", regex_subst(str: "abc123", pattern: "\\d+", replacement: "X"),
            "regex_subst exposes replacement");
        assertEq("a:b", join(separator: ":", values: ("a", "b")), "join list variant exposes separator and values");
        assertEq("x:2", vsprintf(format: "%s:%d", values: ("x", 2)), "vsprintf exposes format and values");

        string ref = "  line\n";
        assertEq("  line", chomp(str: \ref), "reference chomp exposes str");
        assertEq("  line", ref, "reference chomp updates the lvalue");
        assertEq("line", trim(str: \ref, chars: " "), "reference trim exposes str and chars");
        ref = "  line";
        assertEq("line", ltrim(str: \ref, chars: " "), "reference ltrim exposes str and chars");
        ref = "line  ";
        assertEq("line", rtrim(str: \ref, chars: " "), "reference rtrim exposes str and chars");

        Scanner scanner = new Scanner(source: "hello");
        assertEq("ell", scanner.extractRange(byte_offset: 1, byte_length: 3),
            "Scanner constructor and extractRange expose source and byte ranges");
        assertTrue(scanner.startsWith(literal: "he"), "Scanner startsWith exposes literal");
        assertTrue(scanner.match(literal: "he"), "Scanner match exposes literal");
        assertEq(ord("l"), scanner.peekByteAt(byte_offset: 0), "Scanner peekByteAt exposes byte_offset");
        assertEq(ord("o"), scanner.peekAt(char_offset: 2), "Scanner peekAt exposes char_offset");
        assertEq(2, scanner.advanceN(count: 2), "Scanner advanceN exposes count");
        assertEq(ord("o"), scanner.peek(), "Scanner named calls leave expected cursor position");

        Program p(PO_NEW_STYLE);
        p.parse("vprintf(format: \"%s\", values: (\"x\")); f_vprintf(format: \"%s\", values: (\"x\"));",
            "vprintf-named");
    }

    reviewedUtilityBuiltinOptIn() {
        string key = "QORE_NAMED_ARGS_TEST_ENV";
        unsetenv(name: key);
        setenv(name: key, value: "named-ok");
        assertEq("named-ok", getenv(name: key), "environment helpers expose name and value");
        unsetenv(name: key);
        assertNothing(getenv(name: key), "environment helpers clean up with named arguments");

        assertEq({
            "type": "sqlite3",
            "db": ":memory:",
        }, parse_datasource(datasource: "sqlite3:@:memory:"), "parse_datasource exposes datasource");

        hash<auto> row = {
            "name": ("david",),
        };
        context (row) {
            assertEq("david", cx_value(key: "name"), "cx_value exposes key");
        }

        assertEq(<81026869>, ws_encode_frame(message: "hi", opcode: 1, masked: False),
            "ws_encode_frame exposes message and opcode");
        assertEq(<01020304>, ws_unmask_data(data: <00000000>, mask: <01020304>),
            "ws_unmask_data exposes data and mask");
    }

    reviewedListBuiltinOptIn() {
        code<int(auto, auto)> descending = int sub(auto left, auto right) {
            return right <=> left;
        };

        assertEq((1, 2, 3), sort(values: (3, 1, 2)), "sort exposes values");
        assertEq((3, 2, 1), sort(comparator: descending, values: (1, 3, 2)), "sort exposes comparator");
        assertEq((3, 2, 1), sort_descending(values: (1, 3, 2)), "sort_descending exposes values");
        assertEq((1, 2, 3), sort_stable(values: (3, 1, 2)), "sort_stable exposes values");
        assertEq((3, 2, 1), sort_descending_stable(values: (1, 3, 2)),
            "sort_descending_stable exposes values");
        assertEq(1, min(values: (3, 1, 2)), "min exposes values");
        assertEq(3, max(values: (1, 3, 2)), "max exposes values");
        assertEq((1, 3), range(start: 1, stop: 5, step: 2), "range exposes start, stop, and step");
        assertEq((0, 1, 2), range(stop: 3), "range exposes stop");
        assertEq((3, 2, 1), reverse(values: (1, 2, 3)), "reverse exposes values");
        assertTrue(inlist(value: "1", values: (1, 2)), "inlist exposes value and values");
        assertFalse(inlist_hard(value: "1", values: (1, 2)), "inlist_hard exposes value and values");
    }

    reviewedPwdBuiltinOptIn() {
        Program p(PO_NEW_STYLE);
        p.parse("getpwuid(uid: 0); getpwuid2(uid: 0); getpwnam(name: \"root\"); getpwnam2(name: \"root\"); "
            "getgrgid(gid: 0); getgrgid2(gid: 0); getgrnam(name: \"root\"); getgrnam2(name: \"root\");",
            "pwd-named");
    }

    reviewedCompressionBuiltinOptIn() {
        string payload = "named compression payload";

        binary zlib = compress(data: payload, level: Z_DEFAULT_COMPRESSION);
        assertEq(payload, uncompress_to_string(compressed_data: zlib, encoding: "utf-8"),
            "zlib helpers expose data and compressed_data");
        assertEq(binary(value: payload), uncompress_to_binary(compressed_data: zlib),
            "zlib binary decompression exposes compressed_data");

        binary gzip_data = gzip(data: payload, level: Z_DEFAULT_COMPRESSION);
        assertEq(payload, gunzip_to_string(compressed_data: gzip_data, encoding: "utf-8"),
            "gzip helpers expose data and compressed_data");
        assertEq(binary(value: payload), gunzip_to_binary(compressed_data: gzip_data),
            "gzip binary decompression exposes compressed_data");

        binary raw = deflate_raw(data: payload, level: Z_DEFAULT_COMPRESSION);
        assertEq(payload, inflate_raw_to_string(compressed_data: raw, encoding: "utf-8"),
            "raw deflate helpers expose data and compressed_data");
        assertEq(binary(value: payload), inflate_raw_to_binary(compressed_data: raw),
            "raw deflate binary decompression exposes compressed_data");

        binary bzip = bzip2(data: payload, level: BZ2_DEFAULT_COMPRESSION);
        assertEq(payload, bunzip2_to_string(compressed_data: bzip, encoding: "utf-8"),
            "bzip2 helpers expose data and compressed_data");
        assertEq(binary(value: payload), bunzip2_to_binary(compressed_data: bzip),
            "bzip2 binary decompression exposes compressed_data");

        binary brotli_data = brotli(data: payload, quality: BROTLI_DEFAULT_QUALITY);
        assertEq(payload, unbrotli_to_string(compressed_data: brotli_data, encoding: "utf-8"),
            "Brotli helpers expose data and compressed_data");
        assertEq(binary(value: payload), unbrotli_to_binary(compressed_data: brotli_data),
            "Brotli binary decompression exposes compressed_data");

        binary zstd_data = zstd(data: payload, level: ZSTD_DEFAULT_LEVEL);
        assertEq(payload, unzstd_to_string(compressed_data: zstd_data, encoding: "utf-8"),
            "Zstd helpers expose data and compressed_data");
        assertEq(binary(value: payload), unzstd_to_binary(compressed_data: zstd_data),
            "Zstd binary decompression exposes compressed_data");

        binary lz4_data = lz4(data: payload, acceleration: LZ4_DEFAULT_ACCELERATION);
        assertEq(payload, unlz4_to_string(compressed_data: lz4_data, max_output_size: 1024, encoding: "utf-8"),
            "LZ4 helpers expose data and compressed_data");
        assertEq(binary(value: payload), unlz4_to_binary(compressed_data: lz4_data, max_output_size: 1024),
            "LZ4 binary decompression exposes compressed_data");

        assertTrue(get_compressor(algorithm: COMPRESSION_ALG_ZLIB, level: COMPRESSION_LEVEL_DEFAULT) != NOTHING,
            "get_compressor exposes algorithm");
        assertTrue(get_decompressor(algorithm: COMPRESSION_ALG_ZLIB) != NOTHING,
            "get_decompressor exposes algorithm");
    }

    reviewedTimeBuiltinOptIn() {
        date absolute = date(date_string: "2020-01-02T03:04:05Z");
        assertEq(absolute, date(value: absolute), "date conversion exposes value");
        assertEq(10s, date(seconds: 10), "numeric date conversion exposes seconds");
        assertEq("2020-01-02", format_date(format: "YYYY-MM-DD", date_value: absolute),
            "format_date exposes date_value");

        date masked = date(date_string: "20200102 030405", mask: "YYYYMMDD HHmmSS");
        assertEq("2020-01-02", format_date(format: "YYYY-MM-DD", date_value: masked),
            "masked date parsing exposes date_string and mask");

        date epoch = gmtime(seconds: 10, microseconds: 500000);
        assertEq(10, get_epoch_seconds(date_value: epoch), "gmtime exposes seconds and microseconds");
        assertEq(10, timegm(date_value: epoch), "timegm exposes date_value");
        assertEq(10, mktime(date_value: epoch), "mktime exposes date_value");
        assertEq(epoch, gmtime(date_value: epoch), "gmtime date variant exposes date_value");
        assertEq(10, get_epoch_seconds(date_value: localtime(seconds: 10, microseconds: 0)),
            "localtime exposes seconds and microseconds");

        date relative = days(days: 1) + hours(hours: 2) + minutes(minutes: 3) + seconds(seconds: 4)
            + milliseconds(milliseconds: 5) + microseconds(microseconds: 6);
        assertTrue(is_date_relative(date_value: relative), "relative date inspection exposes date_value");
        assertFalse(is_date_absolute(date_value: relative), "absolute date inspection exposes date_value");
        assertEq(1, get_days(date_value: days(days: 1)), "get_days exposes date_value");
        assertEq(2, get_hours(date_value: hours(hours: 2)), "get_hours exposes date_value");
        assertEq(3, get_minutes(date_value: minutes(minutes: 3)), "get_minutes exposes date_value");
        assertEq(4, get_seconds(date_value: seconds(seconds: 4)), "get_seconds exposes date_value");
        assertEq(5, get_milliseconds(date_value: milliseconds(milliseconds: 5)),
            "get_milliseconds exposes date_value");
        assertEq(6, get_microseconds(date_value: microseconds(microseconds: 6)),
            "get_microseconds exposes date_value");
        assertEq(86400, get_duration_seconds(date_value: days(days: 1)),
            "duration helpers expose date_value");

        assertEq("2020-01-02", format_date(format: "YYYY-MM-DD",
            date_value: get_midnight(date_value: absolute)), "get_midnight exposes date_value");
        assertEq(2020, date_info(date_value: absolute).year, "date_info exposes date_value");
        assertEq("2019-12-30", format_date(format: "YYYY-MM-DD",
            date_value: get_date_from_iso_week(year: 2020, week: 1, day: 1)),
            "ISO week helper exposes year, week, and day");

        TimeZone original_tz = TimeZone::get();
        on_exit TimeZone::set(zone: original_tz);
        TimeZone utc = new TimeZone(region: "UTC");
        TimeZone utc_offset = new TimeZone(seconds_east: 0);
        assertEq(0, get_epoch_seconds(date_value: utc.date(seconds: 0, microseconds: 0)),
            "TimeZone date exposes seconds and microseconds");
        assertEq(0, get_epoch_seconds(date_value: utc_offset.date(date_string: "1970-01-01T00:00:00Z")),
            "TimeZone date exposes date_string");
        assertEq(0, get_epoch_seconds(date_value: utc.date(date_string: "1970-01-01 00:00:00",
            mask: "YYYY-MM-DD HH:mm:SS")), "TimeZone date exposes mask");
        assertEq(get_epoch_microseconds(date_value: absolute),
            get_epoch_microseconds(date_value: utc.date(date_value: absolute)),
            "TimeZone date exposes date_value");
        assertEq(1234, get_epoch_milliseconds(date_value: utc.dateMs(milliseconds: 1234)),
            "TimeZone dateMs exposes milliseconds");
        assertEq(1234567, get_epoch_microseconds(date_value: utc.dateUs(microseconds: 1234567)),
            "TimeZone dateUs exposes microseconds");
        TimeZone::setRegion(region: "UTC");
        TimeZone::setUTCOffset(seconds_east: 0);
        TimeZone::set(zone: original_tz);
    }

    reviewedObjectBuiltinOptIn() {
        NA_Child child = new NA_Child(1, 2);
        assertEq("13:14", call_object_method_args(object_value: child, method: "method", arguments: (13, 14)),
            "object method helper exposes object_value and arguments");
        assertEq("15:16", call_static_method_args(class_name: "NA_Child", method: "staticMethod",
            arguments: (15, 16)), "static method helper exposes class_name and arguments");
        assertEq("17:18", cast<NA_Child>(create_object_args(class_name: "NA_Child", arguments: (17, 18))).child_value,
            "object creation helper exposes class_name and arguments");
        assertEq("cde", call_pseudo_args(value: "abcdef", method: "substr", arguments: (2, 3)),
            "pseudo-method helper exposes value and arguments");
        assertTrue(inlist("method", get_method_list(object_value: child)), "method list exposes object_value");
    }

    reviewedMiscBuiltinOptIn() {
        assertEq("&lt;x&gt;", html_encode(str: "<x>"), "HTML helpers expose str");
        assertEq("<x>", html_decode(str: "&lt;x&gt;"), "HTML decode exposes str");
        assertEq("a b", decode_url(url: "a%20b"), "URL decode exposes url");
        assertEq("a%20b", encode_url(url: "a b"), "URL encode exposes url");
        assertEq("a b", decode_uri_request(uri: "a%20b"), "URI request decode exposes uri");
        assertEq("a%20b", encode_uri_request(url: "a b"), "URI request encode exposes url");

        assertTrue(exists_function(name: "type"), "function inspection exposes name");
        assertEq("builtin", function_type(name: "type"), "function_type exposes name");
        assertEq("named", call_function_args(name: "na_misc_concat", arguments: ("nam", "ed")),
            "call_function_args exposes name and arguments");
        assertEq("named", call_function_args(callable: \na_misc_concat(), arguments: ("nam", "ed")),
            "call_function_args exposes callable and arguments");
        assertEq("cde", call_builtin_function_args(name: "substr", arguments: ("abcdef", 2, 3)),
            "call_builtin_function_args exposes arguments");

        NA_Child child = new NA_Child();
        assertEq("NA_Child", get_class_name(object_value: child), "class name helper exposes object_value");
        assertTrue(has_key(container: {"k": 1}, key: "k"), "has_key exposes container");
        assertEq(("v",), hash_values(hash_value: {"k": "v"}), "hash_values exposes hash_value");
        assertEq(98, get_byte(data: "abc", offset: 1), "byte helper exposes data and offset");

        assertEq("YWI=", make_base64_string(data: "ab"), "base64 helper exposes data");
        assertEq("ab", parse_base64_string_to_string(base64_string: "YWI=", encoding: "utf-8"),
            "base64 parser exposes base64_string");
        assertEq("ab", binary_to_string(value: parse_base64_url_string(base64_url_string: "YWI="),
            encoding: "utf-8"), "base64-url parser exposes base64_url_string");
        assertEq("ab", make_hex_string(data: <ab>), "hex helper exposes data");
        assertEq(<ab>, parse_hex_string(hex_string: "ab"), "hex parser exposes hex_string");
        assertEq(171, hextoint(hex_string: "ab"), "hextoint exposes hex_string");
        assertEq(65, strtoint(value: "101", base: 8), "strtoint exposes value and base");

        assertEq("aZZdef", splice(value: "abcdef", start: 1, length: 2, replacement: "ZZ"),
            "string splice exposes value and replacement");
        assertEq((1, 9, 4), splice(value: (1, 2, 3, 4), start: 1, length: 2, replacement: (9)),
            "list splice exposes value and replacement");
        assertEq("https://user:<masked>@example.com/x", get_safe_url(url: "https://user:pass@example.com/x"),
            "safe URL helper exposes url");
        assertEq("example.com", parse_url(url: "https://example.com/path", keep_brackets: False).host,
            "parse_url exposes keep_brackets");
        assertEq("example.com", parseURL(url: "https://example.com/path").host, "parseURL exposes url");
        assertEq(3, get_value_byte_size(value: "abc"), "byte size helper exposes value");

        LoggerInterfaceBase logger = new NA_Logger();
        assertFalse(logger.isEnabledFor(level: 999), "LoggerInterfaceBase exposes level");
        assertTrue(logger.isEnabledFor(level: 1000), "LoggerInterfaceBase exposes level");
        logger.logArgs(level: 1000, message: "hello %s", format_args: ("world",));
        assertEq("hello world", cast<NA_Logger>(logger).messages[0].message,
            "LoggerInterfaceBase exposes format_args");
    }

    reviewedCryptoBuiltinOptIn() {
        string data = "named crypto payload";
        string key = "1234567812345abcabcdefghijklmnopqrstuvwxyz";

        assertEq(MD5(data), MD5(data: data), "digest helper exposes data");
        assertEq(MD5_bin(data), MD5_bin(data: data), "binary digest helper exposes data");
        assertEq(MD5_hmac(data, key), MD5_hmac(data: data, key: key), "HMAC helper exposes data and key");
        assertEq(digest("md5", data), digest(digest: "md5", data: data), "generic digest exposes digest and data");
        assertEq(hmac("sha256", data, key), hmac(digest: "sha256", data: data, key: key),
            "generic HMAC exposes digest, data, and key");
        assertTrue(has_digest(digest: "sha256"), "digest inspection exposes digest");

        binary encrypted = encrypt(algorithm: "blowfish", data: data, key: key);
        assertEq(data, decrypt_to_string(algorithm: "blowfish", data: encrypted, key: key, encoding: "utf-8"),
            "generic crypto helpers expose algorithm and data");
        assertTrue(get_encryptor(algorithm: "blowfish", key: key) != NOTHING, "get_encryptor exposes algorithm");
        assertTrue(get_decryptor(algorithm: "blowfish", key: key) != NOTHING, "get_decryptor exposes algorithm");
        assertTrue(get_cipher_info(cipher: "blowfish") != NOTHING, "get_cipher_info exposes cipher");
        assertEq(16, pbkdf2(digest: "sha256", password: "password", salt: "salt", iterations: 1,
            key_length: 16).size(), "pbkdf2 exposes key_length");
        assertEq(4, get_random_bytes(size: 4).size(), "random helper exposes size");
        assertThrows("SSLCERTIFICATE-CONSTRUCTOR-ERROR", sub () { new SSLCertificate(pem: "not a certificate"); });
        assertThrows("SSLCERTIFICATE-CONSTRUCTOR-ERROR", sub () { new SSLCertificate(der: <00>); });
        assertThrows("SSLPRIVATEKEY-CONSTRUCTOR-ERROR",
            sub () { new SSLPrivateKey(pem: "not a key", password: "secret"); });
        assertThrows("SSLPRIVATEKEY-CONSTRUCTOR-ERROR", sub () { new SSLPrivateKey(der: <00>); });
    }

    reviewedFileBuiltinOptIn() {
        string file = sprintf("%s%sqore-na-file-%d-%s.txt", tmp_location(), DirSep, getpid(),
            get_random_bytes(size: 4).toHex());
        string target = file + ".renamed";
        on_exit unlink(path: file);
        on_exit unlink(path: target);

        {
            File f();
            f.open2(file, O_CREAT | O_WRONLY | O_TRUNC, 0600, "utf-8");
            f.write("named file");
        }

        assertTrue(is_file(path: file), "is_file exposes path");
        assertFalse(is_dir(path: file), "is_dir exposes path");
        assertTrue(is_readable(path: file), "is_readable exposes path");
        assertTrue(is_writable(path: file), "is_writable exposes path");
        assertEq(0, chmod(path: file, mode: 0600), "chmod exposes path and mode");
        assertTrue(stat(path: file) != NOTHING, "stat exposes path");
        assertTrue(lstat(path: file) != NOTHING, "lstat exposes path");
        assertTrue(hstat(path: file) != NOTHING, "hstat exposes path");
        assertTrue(hlstat(path: file) != NOTHING, "hlstat exposes path");
        assertTrue(statvfs(path: file) != NOTHING, "statvfs exposes path");
        assertTrue(inlist(file, glob(pattern: file)), "glob exposes pattern");
        assertTrue(absolute_path(path: file), "absolute_path exposes path");
        assertTrue(absolute_path_unix(path: file), "absolute_path_unix exposes path");
        assertTrue(absolute_path(path: realpath(path: file)), "realpath exposes path");

        rename(source_path: file, target_path: target);
        assertFalse(is_file(path: file), "rename moved source");
        assertTrue(is_file(path: target), "rename moved target");
        int old_mask = umask(mask: 022);
        assertEq(022, umask(mask: old_mask), "umask exposes mask");

        Program p(PO_NEW_STYLE);
        p.parse("chdir(path: \"/\"); mkdir(path: \"/tmp/qore-na\", mode: 0777, parents: True); "
            "mkdir_ex(path: \"/tmp/qore-na\", mode: 0777, parents: True); mkfifo(path: \"/tmp/qore-na-fifo\"); "
            "unlink(path: \"/tmp/qore-na\"); rmdir(path: \"/tmp/qore-na\"); "
            "chown(path: \"/tmp/qore-na\", owner: -1, group: -1); "
            "lchown(path: \"/tmp/qore-na\", owner: -1, group: -1); "
            "readlink(path: \"/tmp/qore-na-link\"); "
            "symlink(target_path: \"/tmp/qore-na-target\", link_path: \"/tmp/qore-na-link\"); "
            "is_socket(path: \"/tmp/qore-na\"); is_pipe(path: \"/tmp/qore-na\"); "
            "is_cdev(path: \"/tmp/qore-na\"); is_bdev(path: \"/tmp/qore-na\"); "
            "is_dev(path: \"/tmp/qore-na\"); is_link(path: \"/tmp/qore-na\"); "
            "is_executable(path: \"/bin/sh\"); absolute_path_windows(path: \"C:\\\\temp\");",
            "file-named");
    }

    reviewedLibraryBuiltinOptIn() {
        assertEq("file.txt", basename(path: "/tmp/file.txt"), "basename exposes path");
        assertEq("/tmp", dirname(path: "/tmp/file.txt"), "dirname exposes path");
        assertTrue(strerror(error_number: 0) != NOTHING, "strerror exposes error_number");
        srand(seed: 1);
        assertEq(0, sleep(seconds: 0), "sleep exposes seconds");
        assertEq(0, usleep(microseconds: 0), "usleep exposes microseconds");
        assertEq(0, usleep(duration: 0ms), "usleep date variant exposes duration");

        TreeMap tm();
        tm.put(path: "api/v1", value: "handler");
        *string unmatched;
        assertEq("handler", tm.get(path: "api/v1/users", unmatched: \unmatched),
            "TreeMap get exposes path and unmatched");
        assertEq("users", unmatched, "TreeMap get writes unmatched suffix");
        assertEq("handler", tm.take(path: "api/v1"), "TreeMap take exposes path");

        string original_http2 = get_global_http2_mode();
        on_exit set_global_http2_mode(mode: original_http2);
        set_global_http2_mode(mode: "auto");
        assertEq("auto", get_global_http2_mode(), "HTTP/2 mode string variant exposes mode");
        set_global_http2_mode(mode: HTTP2Mode::Disabled);
        assertEq("disabled", get_global_http2_mode(), "HTTP/2 mode enum variant exposes mode");

        Program p(PO_NEW_STYLE);
        p.parse("sub ql_lib_named_exit() { exit(status: 0); } "
            "sub ql_lib_named_exec() { exec(command: \"/bin/true\"); } "
            "sub ql_lib_named_system() { system(command: \"true\"); } "
            "sub ql_lib_named_setgroups() { setgroups(group_ids: ()); } "
            "sub ql_lib_named_kill() { kill(pid: 0, signal: 0); } "
            "sub ql_lib_named_setuid() { setuid(uid: 0); seteuid(uid: 0); } "
            "sub ql_lib_named_setgid() { setgid(gid: 0); setegid(gid: 0); } "
            "sub ql_lib_named_gethostbyname() { gethostbyname(hostname: \"localhost\"); "
            "gethostbyname_long(hostname: \"localhost\"); } "
            "sub ql_lib_named_gethostbyaddr() { gethostbyaddr(address: \"127.0.0.1\", family: AF_INET); "
            "gethostbyaddr_long(address: \"127.0.0.1\", family: AF_INET); } "
            "sub ql_lib_named_getaddrinfo() { getaddrinfo(node: \"localhost\", service: NOTHING, "
            "family: AF_UNSPEC, flags: 0); getaddrinfo_async(node: \"localhost\", service: NOTHING, "
            "family: AF_UNSPEC, flags: 0, socktype: SOCK_STREAM, protocol: 0, timeout: -1); } "
            "sub ql_lib_named_getnameinfo() { getnameinfo_async(address: \"127.0.0.1\", family: AF_INET, "
            "port: 0, timeout: -1); } "
            "sub ql_lib_named_closefds() { close_all_fd(standard_fds: False); } "
            "sub ql_lib_named_options() { qore_set_library_options(options: 0); } "
            "sub ql_lib_named_blacklist() { qore_add_module_to_blacklist(name: \"NamedArgsTest\", "
            "message: \"test\"); qore_add_module_to_blacklist_ex(name: \"NamedArgsTest\", message: \"test\"); }",
            "library-named");
    }

    reviewedParseOptionsClassBuiltinOptIn() {
        ParseOptions opts = new ParseOptions(parse_options: PO_NO_NETWORK);
        assertTrue(opts.hasAll(parse_options: PO_NO_NETWORK), "ParseOptions integer constructor exposes parse_options");

        opts.set(name: "no-filesystem");
        assertTrue(opts.hasAny(name: "no-filesystem"), "ParseOptions string methods expose name");
        opts.clear(name: "no-filesystem");
        assertFalse(opts.hasAny(name: "no-filesystem"), "ParseOptions clear exposes name");

        opts.set(parse_options: PO_NO_GUI);
        assertTrue(opts.hasAny(parse_options: PO_NO_GUI), "ParseOptions set exposes parse_options");
        opts.clear(parse_options: PO_NO_GUI);
        assertFalse(opts.hasAny(parse_options: PO_NO_GUI), "ParseOptions clear exposes parse_options");

        ParseOptions other = new ParseOptions(names: ("no-database",));
        ParseOptions merged = opts.merge(other: other);
        assertTrue(merged.hasAll(other: other), "ParseOptions object variants expose other");
        assertTrue(merged.hasAny(name: "no-database"), "ParseOptions list constructor exposes names");

        ParseOptions masked = merged.mask(parse_options: PO_NO_DATABASE);
        assertTrue(masked.equals(other: other), "ParseOptions mask and equals expose reviewed names");
    }

    reviewedThreadBuiltinOptIn() {
        save_thread_data(data: {"na-thread-key": "value"});
        assertEq("value", get_thread_data(key: "na-thread-key"), "thread data lookup exposes key");
        assertEq({"na-thread-key": "value"}, remove_thread_data(key_list: ("na-thread-key",)),
            "thread data removal exposes keys");
        save_thread_data(key: "na-thread-key", value: "deleted");
        delete_thread_data(key_list: ("na-thread-key",));
        assertNothing(get_thread_data(key: "na-thread-key"), "thread data deletion exposes keys");
        assertTrue(get_parent_caller_location(offset: 0) != NOTHING, "caller location exposes offset");

        assertEq((2, 4, 6), parallel_map(callable: auto sub(auto x) { return x * 2; }, items: (1, 2, 3),
            thread_count: 1), "parallel_map exposes callable, items, and thread_count");
        list<auto> seen = ();
        parallel_foreach(callable: sub(auto x) { seen += x; }, items: (1, 2, 3), thread_count: 1);
        assertEq((1, 2, 3), seen, "parallel_foreach exposes callable, items, and thread_count");

        Channel ch(1);
        ch.send("payload");
        hash<auto> selected = channel_select(cases: ({"channel": ch, "op": "recv"},), timeout: 0);
        assertEq(0, selected.index, "channel_select exposes cases");
        assertEq("payload", selected.value, "channel_select receives the ready value");

        Program p(PO_NEW_STYLE);
        p.parse("sub ql_thread_named_cancel() { cancel_thread(thread_id: 1, reason: NOTHING); } "
            "sub ql_thread_named_stack() { set_default_thread_stack_size(stack_size: 1024 * 1024); } "
            "sub ql_thread_named_init() { set_thread_init(callback: NOTHING); } "
            "sub ql_thread_named_name() { set_thread_name(name: \"qore-na\"); } "
            "sub ql_thread_named_tz() { set_thread_tz(timezone: new TimeZone(\"UTC\")); } "
            "sub ql_thread_named_resource() { set_thread_resource(resource: sub(auto arg) {}, argument: NOTHING); "
            "remove_thread_resource(resource: sub() {}); }",
            "thread-named");
    }

    reviewedThreadClassBuiltinOptIn() {
        Queue q = new Queue(max_size: 2);
        q.push(value: "tail", timeout_ms: 0);
        q.insert(value: "head", timeout_ms: 0);
        assertEq("head", q.get(timeout_ms: 0), "Queue get exposes timeout_ms");
        assertEq("tail", q.pop(timeout_ms: 0), "Queue constructor and insert/push expose names");
        q.setError(error: "NAMED-QUEUE-ERROR", description: "named queue error");
        q.clearError();

        Channel ch = new Channel(capacity: 1);
        assertTrue(ch.trySend(value: "payload"), "Channel trySend exposes value");
        assertEq("payload", ch.recv(timeout_ms: 0), "Channel recv exposes timeout_ms");
        ch.send(value: "iter", timeout_ms: 0);
        ch.close();
        ChannelIterator it = new ChannelIterator(channel: ch);
        assertTrue(it.next(), "ChannelIterator constructor exposes channel");
        assertEq("iter", it.getValue(), "ChannelIterator receives channel values");

        Semaphore sem = new Semaphore(permits: 1);
        sem.acquire(timeout_ms: -1);
        sem.release(permits: 1);
        AutoSemaphore as = new AutoSemaphore(semaphore: sem);
        as.release();
        as.acquire(timeout_ms: -1);

        Counter counter = new Counter(initial_value: 0);
        assertEq(0, counter.waitForZero(timeout_ms: -1), "Counter exposes initial_value and timeout_ms");

        WaitGroup wg();
        assertEq(0, wg.wait(timeout_ms: 0), "WaitGroup wait exposes timeout_ms");
        wg.add(count: 1);
        assertEq(1, wg.getCount(), "WaitGroup add exposes count");
        wg.done();

        Mutex mutex();
        assertEq(0, mutex.lock(timeout_ms: 0), "Mutex lock exposes timeout_ms");
        mutex.unlock();
        {
            AutoLock lock = new AutoLock(mutex: mutex);
            lock.unlock();
        }

        Gate gate();
        assertEq(0, gate.enter(timeout_ms: 0), "Gate enter exposes timeout_ms");
        gate.exit();
        AutoGate gate_lock = new AutoGate(gate: gate);
        delete gate_lock;

        {
            RWLock rwlock();
            assertEq(0, rwlock.readLock(timeout_ms: 0), "RWLock readLock exposes timeout_ms");
            rwlock.readUnlock();
            AutoReadLock read_lock = new AutoReadLock(lock: rwlock);
        }
        {
            RWLock rwlock();
            assertEq(0, rwlock.writeLock(timeout_ms: 0), "RWLock writeLock exposes timeout_ms");
            rwlock.writeUnlock();
            AutoWriteLock write_lock = new AutoWriteLock(lock: rwlock);
        }

        Promise promise();
        Future future = promise.getFuture();
        promise.set(value: "resolved");
        assertEq("resolved", future.get(timeout_ms: 0), "Promise set and Future get expose names");
        Promise error_promise();
        Future error_future = error_promise.getFuture();
        error_promise.setError(error: "NAMED-PROMISE-ERROR", description: "named promise error",
            argument: "detail");
        assertThrows("NAMED-PROMISE-ERROR", "named promise error",
            sub() { error_future.get(timeout_ms: 0); });

        ThreadPool thread_pool = new ThreadPool(max_threads: 2, min_idle_threads: 0, max_idle_threads: 1,
            idle_release_timeout: 1s);
        Counter thread_pool_counter(1);
        thread_pool.submit(task: sub () { thread_pool_counter.dec(); }, cancel_callback: NOTHING);
        assertEq(0, thread_pool_counter.waitForZero(timeout_ms: 10s), "ThreadPool submit exposes task");
        thread_pool.stopWait();

        Mutex cond_mutex();
        Condition cond();
        cond_mutex.lock();
        on_exit cond_mutex.unlock();
        assertEq(ETIMEDOUT, cond.wait(lock: cond_mutex, timeout_ms: 1),
            "Condition wait exposes lock and timeout_ms");
        assertEq(ETIMEDOUT, cond.wait(lock: cond_mutex, timeout_date: 1ms),
            "Condition wait exposes timeout_date");
        assertEq(0, cond.wait_count(lock: cond_mutex), "Condition wait_count exposes lock");
    }

    reviewedEventLoopClassBuiltinOptIn() {
        EventLoop loop();
        int timer_id = loop.addTimer(deadline: now_us(), user_data: "named-timer");
        *list<hash<EventPollInfo>> timer_events = loop.poll(timeout_ms: 0);
        assertEq(1, timer_events.size(), "EventLoop poll exposes timeout_ms");
        assertEq(timer_id, timer_events[0].timer_id, "EventLoop addTimer exposes deadline");
        assertEq("named-timer", timer_events[0].timer_udata, "EventLoop addTimer exposes user_data");
        assertFalse(loop.cancelTimer(timer_id: timer_id), "EventLoop cancelTimer exposes timer_id");

        EventNotifier notifier();
        loop.add(notifier: notifier, events: SOCK_POLLIN);
        notifier.notify();
        *list<hash<EventPollInfo>> notifier_events = loop.poll(timeout_ms: 1s);
        assertEq(1, notifier_events.size(), "EventLoop add exposes notifier and events");
        assertTrue((notifier_events[0].events & SOCK_POLLIN) != 0, "EventLoop returns notifier readiness");
        loop.del(notifier: notifier);
        notifier.acknowledge();
    }

    reviewedHttpReadinessBuiltinOptIn() {
        AbstractHttpPollConnection conn();
        EventNotifier notifier();

        assertTrue(conn.registerReadyNotifier(notifier: notifier),
            "AbstractHttpPollConnection registerReadyNotifier exposes notifier");
        assertFalse(conn.waitForReady(timeout_ms: 0ms),
            "AbstractHttpPollConnection waitForReady exposes timeout_ms");
        conn.onConnectionReady();
        assertTrue(conn.waitForReady(timeout_ms: 0ms),
            "AbstractHttpPollConnection reports readiness after onConnectionReady");
        notifier.acknowledge();

        HttpClientConnectionBase base();
        assertFalse(base.waitForReadyOrError(timeout_ms: 1),
            "HttpClientConnectionBase waitForReadyOrError exposes timeout_ms");
    }

    reviewedAsyncIoControllerBuiltinOptIn() {
        AsyncIoController::setAutostop(auto_stop: True);
        AsyncIoController::setLogger(logger: NOTHING);
        AsyncIoController::setTimerCallback(callback: NOTHING);
        AsyncIoController::setMaxCallbackWorkers(max_workers: 0);

        Counter counter(1);
        AsyncIoController::submitTask(task: sub () { counter.dec(); }, cancel_callback: NOTHING);
        assertEq(0, counter.waitForZero(timeout_ms: 10s), "AsyncIoController submitTask exposes task");

        int timer_id = AsyncIoController::addTimer(deadline: now_us() + 10s,
            user_data: "named-arguments-timer");
        assertTrue(AsyncIoController::cancelTimer(timer_id: timer_id),
            "AsyncIoController addTimer/cancelTimer expose timer names");

        assertFalse(AsyncIoController::cancelByKey(key: "named-arguments-no-key"),
            "AsyncIoController cancelByKey exposes key");
        assertEq(0, AsyncIoController::cancelByOwner(owner: "named-arguments-no-owner"),
            "AsyncIoController cancelByOwner exposes owner");
        AsyncIoController::flushCallbacksByOwner(owner: "named-arguments-no-owner");

        assertTrue(AsyncIoController::waitReady(timeout_ms: 10s),
            "AsyncIoController waitReady exposes timeout_ms");
        assertTrue(AsyncIoController::waitForProcessing(timeout_ms: 10s),
            "AsyncIoController waitForProcessing exposes timeout_ms");
    }

    reviewedStreamBuiltinOptIn() {
        BinaryInputStream bis = new BinaryInputStream(source: binary("abc"));
        assertEq(binary("ab"), bis.read(limit: 2), "BinaryInputStream constructor and read expose names");

        StringInputStream sis = new StringInputStream(source: "alpha");
        assertEq(binary("al"), sis.read(limit: 2), "StringInputStream constructor and read expose names");

        BinaryOutputStream bos();
        bos.write(data: <0102>);
        assertEq(<0102>, bos.getData(), "BinaryOutputStream write exposes data");

        StringOutputStream sos = new StringOutputStream(encoding: "UTF-8");
        sos.write(data: binary("ab"));
        assertEq("ab", sos.getData(), "StringOutputStream constructor and write expose names");

        string stream_file = sprintf("%s%sqore-na-stream-%d-%s.txt", tmp_location(), DirSep, getpid(),
            get_random_bytes(size: 4).toHex());
        string line_file = sprintf("%s%sqore-na-lines-%d-%s.txt", tmp_location(), DirSep, getpid(),
            get_random_bytes(size: 4).toHex());
        on_exit unlink(path: stream_file);
        on_exit unlink(path: line_file);

        FileOutputStream file_out = new FileOutputStream(path: stream_file, append: False, mode: 0600,
            encoding: "UTF-8");
        file_out.write(data: binary("abcdef"));
        file_out.close();
        FileInputStream file_in = new FileInputStream(path: stream_file, timeout_ms: -1,
            nonblocking_open: False);
        assertEq(binary("ab"), file_in.read(limit: 2), "FileInputStream constructor and read expose names");
        assertEq(binary("cd"), file_in.readWithTimeout(limit: 2, timeout_ms: -1),
            "FileInputStream readWithTimeout exposes names");
        assertEq(binary("ef"), file_in.readNonBlock(limit: 2), "FileInputStream readNonBlock exposes limit");

        FileOutputStream line_out = new FileOutputStream(path: line_file, append: False, mode: 0600,
            encoding: "UTF-8");
        line_out.write(data: binary("first\nsecond"));
        line_out.close();
        FileLineIterator fli = new FileLineIterator(path: line_file, encoding: "UTF-8",
            line_separator: "\n", trim_line: True, nonblocking_open: False);
        assertTrue(fli.next(), "FileLineIterator constructor exposes path and line_separator");
        assertEq("first", fli.getValue(), "FileLineIterator trims named line separator");

        StreamReader sr = new StreamReader(input_stream: new StringInputStream(source: "line1\nline2"),
            encoding: "UTF-8");
        assertEq("line1", sr.readLine(line_separator: "\n", trim_line: True),
            "StreamReader readLine exposes line_separator and trim_line");
        assertEq(binary("line2"), sr.readBinary(limit: -1), "StreamReader readBinary exposes limit");

        sr = new StreamReader(input_stream: new StringInputStream(source: "abc"), encoding: "UTF-8");
        assertEq("ab", sr.readString(limit: 2), "StreamReader readString exposes limit");

        BufferedStreamReader bsr = new BufferedStreamReader(input_stream: new StringInputStream(source: "x\ny"),
            encoding: "UTF-8", buffer_size: 2);
        assertEq("x", bsr.readLine(line_separator: "\n", trim_line: True),
            "BufferedStreamReader constructor exposes input_stream, encoding, and buffer_size");

        BinaryOutputStream writer_out();
        StreamWriter sw = new StreamWriter(output_stream: writer_out, encoding: "UTF-8");
        sw.print(text: "a");
        sw.write(text: "b");
        sw.write(data: <63>);
        sw.vprintf(format: "%s", format_args: ("d",));
        sw.f_vprintf(format: "%2s", format_args: ("ef",));
        sw.writei1(value: 65);
        assertEq(binary("abcdefA"), writer_out.getData(),
            "StreamWriter exposes output_stream, text, data, format_args, and value names");

        StreamPipe pipe = new StreamPipe(sync_close: False, timeout_ms: 1s, buffer_size: 1024);
        PipeOutputStream pipe_out = pipe.getOutputStream();
        PipeInputStream pipe_in = pipe.getInputStream();
        pipe_out.write(data: binary("xy"));
        pipe_out.close();
        assertEq(binary("xy"), pipe_in.read(limit: 10), "StreamPipe and pipe streams expose names");

        EncodingConversionInputStream ecis = new EncodingConversionInputStream(
            input_stream: new BinaryInputStream(source: binary("abc")), source_encoding: "UTF-8",
            target_encoding: "UTF-8");
        assertEq(binary("abc"), ecis.read(limit: 10),
            "EncodingConversionInputStream exposes input_stream and encoding names");

        BinaryOutputStream conversion_out();
        EncodingConversionOutputStream ecos = new EncodingConversionOutputStream(output_stream: conversion_out,
            source_encoding: "UTF-8", target_encoding: "UTF-8");
        ecos.write(data: binary("cd"));
        ecos.close();
        assertEq(binary("cd"), conversion_out.getData(),
            "EncodingConversionOutputStream exposes output_stream and encoding names");

        InputStreamLineIterator isli = new InputStreamLineIterator(
            input_stream: new StringInputStream(source: "first\nsecond"), encoding: "UTF-8",
            line_separator: "\n", trim_line: True, buffer_size: 64);
        assertTrue(isli.next(), "InputStreamLineIterator input stream variant accepts named arguments");
        assertEq("first", isli.getValue(), "InputStreamLineIterator trims named line separator");

        InputStreamLineIterator srli = new InputStreamLineIterator(
            stream_reader: new StreamReader(input_stream: new StringInputStream(source: "third\nfourth"),
                encoding: "UTF-8"), line_separator: "\n", trim_line: True);
        assertTrue(srli.next(), "InputStreamLineIterator StreamReader variant accepts named arguments");
        assertEq("third", srli.getValue(), "InputStreamLineIterator StreamReader variant trims named separator");

        DataLineIterator dli = new DataLineIterator(source: "a,b\nc,d", line_separator: "\n", trim_line: True);
        assertTrue(dli.next(), "DataLineIterator named constructor creates iterator");
        assertEq(("a", "b"), dli.getSplitLine(separator: ",", quote: "'", line_separator: "\n",
            trim_unquoted: False), "AbstractLineIterator getSplitLine exposes separator and line_separator");

        StringSplitIterator split_it = new StringSplitIterator(source: "left:right", separator: ":");
        assertTrue(split_it.next(), "StringSplitIterator named constructor creates iterator");
        assertEq("left", split_it.getValue(), "StringSplitIterator exposes source and separator");

        StringRegexSplitIterator regex_it = new StringRegexSplitIterator(source: "left:right",
            separator_pattern: ":", options: 0, with_separator: False);
        assertTrue(regex_it.next(), "StringRegexSplitIterator named constructor creates iterator");
        assertEq("left", regex_it.getValue(),
            "StringRegexSplitIterator exposes source and separator_pattern");
    }

    reviewedIteratorBuiltinOptIn() {
        Sequence seq = new Sequence(start: 10);
        assertEq(10, seq.getCurrent(), "Sequence constructor exposes start");

        SingleValueIterator single_it = new SingleValueIterator(value: "only");
        assertTrue(single_it.next(), "SingleValueIterator named constructor creates iterator");
        assertEq("only", single_it.getValue(), "SingleValueIterator exposes value");

        RangeIterator range_it = new RangeIterator(0, 1, 1, "tick");
        assertTrue(range_it.next(), "RangeIterator value override constructor creates iterator");
        assertEq("tick", range_it.getValue(), "RangeIterator keeps value override positional");

        RangeIterator numeric_range_it = new RangeIterator(start: 0, stop: 1, step: 1);
        assertTrue(numeric_range_it.next(), "RangeIterator allows value to be omitted");
        assertEq(0, numeric_range_it.getValue(), "RangeIterator omitted value yields numeric values");

        RangeIterator stop_it = new RangeIterator(stop: 1);
        assertTrue(stop_it.next(), "RangeIterator stop-only constructor exposes stop");
        assertEq(0, stop_it.getValue(), "RangeIterator stop-only constructor starts at zero");

        RangeIterator xrange_it = xrange(0, 1, 1, "x");
        assertTrue(xrange_it.next(), "xrange keeps value override positional");
        assertEq("x", xrange_it.getValue(), "xrange value override is preserved");
        RangeIterator numeric_xrange_it = xrange(start: 0, stop: 1, step: 1);
        assertTrue(numeric_xrange_it.next(), "xrange allows value to be omitted");
        assertEq(0, numeric_xrange_it.getValue(), "xrange omitted value yields numeric values");
        assertTrue(xrange(stop: 1).next(), "xrange stop-only variant exposes stop");

        StringCharIterator char_it = new StringCharIterator(source: "a");
        assertTrue(char_it.next(), "StringCharIterator named constructor creates iterator");
        assertEq(ord("a"), char_it.getValue(), "StringCharIterator exposes source");

        list<auto> values = (10, 20);
        ListIterator list_it = new ListIterator(list_value: values);
        assertTrue(list_it.next(), "ListIterator named constructor creates iterator");
        assertTrue(list_it.set(position: 1), "ListIterator exposes position");
        assertEq(20, list_it.getValue(), "ListIterator exposes list_value");
        ListReverseIterator list_rev_it = new ListReverseIterator(list_value: values);
        assertTrue(list_rev_it.next(), "ListReverseIterator exposes list_value");
        assertEq(20, list_rev_it.getValue(), "ListReverseIterator starts from the end");

        hash<auto> hash_value = {"first": 1, "second": 2};
        HashIterator hash_it = new HashIterator(hash_value: hash_value);
        assertTrue(hash_it.next(), "HashIterator exposes hash_value");
        HashReverseIterator hash_rev_it = new HashReverseIterator(hash_value: hash_value);
        assertTrue(hash_rev_it.next(), "HashReverseIterator exposes hash_value");
        HashKeyIterator hash_key_it = new HashKeyIterator(hash_value: hash_value);
        assertTrue(hash_key_it.next(), "HashKeyIterator exposes hash_value");
        HashKeyReverseIterator hash_key_rev_it = new HashKeyReverseIterator(hash_value: hash_value);
        assertTrue(hash_key_rev_it.next(), "HashKeyReverseIterator exposes hash_value");
        HashPairIterator hash_pair_it = new HashPairIterator(hash_value: hash_value);
        assertTrue(hash_pair_it.next(), "HashPairIterator exposes hash_value");
        HashPairReverseIterator hash_pair_rev_it = new HashPairReverseIterator(hash_value: hash_value);
        assertTrue(hash_pair_rev_it.next(), "HashPairReverseIterator exposes hash_value");

        list<auto> rows = ({"value": "first"}, {"value": "second"});
        ListHashIterator list_hash_it = new ListHashIterator(list_value: rows);
        assertTrue(list_hash_it.next(), "ListHashIterator exposes list_value");
        assertEq("first", list_hash_it.getKeyValue(key: "value"), "ListHashIterator exposes key");
        assertTrue(list_hash_it.set(position: 1), "ListHashIterator exposes position");
        assertEq("second", list_hash_it.memberGate(key: "value"), "ListHashIterator memberGate exposes key");
        ListHashReverseIterator list_hash_rev_it = new ListHashReverseIterator(list_value: rows);
        assertTrue(list_hash_rev_it.next(), "ListHashReverseIterator exposes list_value");
        assertEq("second", list_hash_rev_it.memberGate(key: "value"),
            "ListHashReverseIterator memberGate exposes key");

        hash<auto> columns = {"value": ("first", "second"), "fixed": "constant"};
        HashListIterator hash_list_it = new HashListIterator(hash_value: columns);
        assertTrue(hash_list_it.next(), "HashListIterator exposes hash_value");
        assertEq("first", hash_list_it.getKeyValue(key: "value"), "HashListIterator exposes key");
        hash_list_it.set(position: 1);
        assertEq("second", hash_list_it.memberGate(key: "value"), "HashListIterator memberGate exposes key");
        HashListReverseIterator hash_list_rev_it = new HashListReverseIterator(hash_value: columns);
        assertTrue(hash_list_rev_it.next(), "HashListReverseIterator exposes hash_value");
        assertEq("second", hash_list_rev_it.memberGate(key: "value"),
            "HashListReverseIterator memberGate exposes key");

        NA_Child obj();
        ObjectIterator object_it = new ObjectIterator(object_value: obj);
        assertTrue(object_it.next(), "ObjectIterator exposes object_value");
        ObjectReverseIterator object_rev_it = new ObjectReverseIterator(object_value: obj);
        assertTrue(object_rev_it.next(), "ObjectReverseIterator exposes object_value");
        ObjectKeyIterator object_key_it = new ObjectKeyIterator(object_value: obj);
        assertTrue(object_key_it.next(), "ObjectKeyIterator exposes object_value");
        ObjectKeyReverseIterator object_key_rev_it = new ObjectKeyReverseIterator(object_value: obj);
        assertTrue(object_key_rev_it.next(), "ObjectKeyReverseIterator exposes object_value");
        ObjectPairIterator object_pair_it = new ObjectPairIterator(object_value: obj);
        assertTrue(object_pair_it.next(), "ObjectPairIterator exposes object_value");
        ObjectPairReverseIterator object_pair_rev_it = new ObjectPairReverseIterator(object_value: obj);
        assertTrue(object_pair_rev_it.next(), "ObjectPairReverseIterator exposes object_value");
    }

    reviewedRegexClassBuiltinOptIn() {
        Regex regex = new Regex(pattern: "([a-z]+)(\\d+)", options: 0);
        assertTrue(regex.match(subject: "alpha42"), "Regex constructor and match expose pattern and subject");
        assertEq(2, regex.count(subject: "alpha42 beta7"), "Regex count exposes subject");
        assertEq(("alpha", "42"), regex.extractGroups(subject: "alpha42"),
            "Regex extractGroups exposes subject");

        Regex named_regex = new Regex(pattern: "(?<word>[a-z]+)", options: 0);
        auto named = named_regex.extractNamedGroups(subject: "alpha");
        assertEq("alpha", named.word, "Regex extractNamedGroups exposes subject");
        auto detailed = named_regex.extractDetailed(subject: "alpha");
        assertEq("alpha", detailed[0].match, "Regex extractDetailed exposes subject");

        RegexExtract extractor = new RegexExtract(pattern: "([a-z]+)(\\d+)", options: 0);
        assertTrue(extractor.match(subject: "beta7"), "RegexExtract constructor and match expose subject");
        assertEq(("beta", "7"), extractor.extractGroups(subject: "beta7"),
            "RegexExtract extractGroups exposes subject");
        assertEq(2, extractor.count(subject: "beta7 gamma8"), "RegexExtract count exposes subject");

        RegexExtract named_extractor = new RegexExtract(pattern: "(?<word>[a-z]+)", options: 0);
        named = named_extractor.extractNamedGroups(subject: "beta");
        assertEq("beta", named.word, "RegexExtract extractNamedGroups exposes subject");
        detailed = named_extractor.extractDetailed(subject: "beta");
        assertEq("beta", detailed[0].match, "RegexExtract extractDetailed exposes subject");

        RegexSubst subst = new RegexSubst(pattern: "\\d+", replacement: "NUM", options: RE_Global);
        assertEq("aNUMbNUM", subst.subst(subject: "a1b2"), "RegexSubst default replacement exposes subject");
        assertEq("aXbX", subst.subst(subject: "a1b2", replacement: "X"),
            "RegexSubst replacement override exposes replacement");
        assertEq("a[1]b[2]", subst.subst(subject: "a1b2",
            callback: string sub(hash<RegexMatchInfo> m) { return "[" + m.match + "]"; }),
            "RegexSubst callback replacement exposes callback");
    }

    reviewedPseudoMethodOptIn() {
        assertEq((1).fullType(False), (1).fullType(with_namespaces: False),
            "value pseudo-method exposes with_namespaces");
        assertEq((True).toString("UTF-8"), (True).toString(encoding: "UTF-8"),
            "value pseudo-method exposes encoding");

        binary bin = binary("abcabc");
        assertEq(1, bin.find(pattern: binary("bc"), byte_offset: 0), "binary find exposes pattern and byte_offset");
        assertEq(4, bin.rfind(pattern: binary("bc"), byte_offset: -1), "binary rfind exposes pattern and byte_offset");
        assertEq(bin.split(binary("bc")), bin.split(separator: binary("bc")),
            "binary split exposes separator");
        assertEq("YQ==", binary("a").toBase64(max_line_length: -1), "binary toBase64 exposes max_line_length");
        assertEq("6162", binary("ab").toHexArray(byte_prefix: NOTHING, byte_suffix: NOTHING, bytes_per_line: 0,
            line_separator: NOTHING), "binary toHexArray exposes formatting arguments");
        assertEq("bc", bin.substr(start: 1, length: 2).toString(encoding: "UTF-8"),
            "binary substr exposes start and length");

        string text = "alpha\nbeta\nalpha";
        assertEq(text.find("ph", 0), text.find(substring: "ph", offset: 0),
            "string find exposes substring and offset");
        assertEq(text.rfind("alpha", -1), text.rfind(substring: "alpha", offset: -1),
            "string rfind exposes substring and offset");
        assertEq(text.substr(0, 5), text.substr(start: 0, length: 5), "string substr exposes length");
        assertEq(text.split("\n", True), text.split(separator: "\n", with_separator: True),
            "string split exposes separator and with_separator");
        assertEq("'a', b".split(",", "'", True), "'a', b".split(separator: ",", quote: "'", trim_unquoted: True),
            "string split quote variant exposes separator, quote, and trim_unquoted");
        assertTrue(text.splitString(separator: "\n") != NOTHING, "string splitString exposes separator");
        assertTrue(text.splitLinesRegex(separator_pattern: "\n", options: 0, with_separator: False) != NOTHING,
            "string splitLinesRegex exposes separator_pattern");
        assertEq(text.splitRegex("\n", 0, False, -1), text.splitRegex(separator_pattern: "\n", options: 0,
            with_separator: False, limit: -1), "string splitRegex exposes regex separator with options");
        assertTrue(text.regex(pattern: "^alpha", options: 0), "string regex exposes pattern");
        assertEq(2, text.regexCount(pattern: "alpha", options: 0), "string regexCount exposes pattern");
        assertEq(text.regexExtract("(alpha)", 0), text.regexExtract(pattern: "(alpha)", options: 0),
            "string regexExtract exposes pattern");
        assertEq(text.regexExtractNamed("(?<word>alpha)", 0),
            text.regexExtractNamed(pattern: "(?<word>alpha)", options: 0),
            "string regexExtractNamed exposes pattern");
        assertEq(text.regexExtractDetailed("alpha", 0), text.regexExtractDetailed(pattern: "alpha", options: 0),
            "string regexExtractDetailed exposes pattern");
        assertEq(text.getUnicode(0), text.getUnicode(offset: 0), "string getUnicode exposes offset");
        assertEq(text.getByte(0), text.getByte(byte_offset: 0), "string getByte exposes byte_offset");
        assertTrue(text.startsWith(prefix: "alpha"), "string startsWith exposes prefix");
        assertTrue(text.endsWith(suffix: "alpha"), "string endsWith exposes suffix");
        assertTrue(text.contains(substring: "beta"), "string contains exposes substring");
        int byte_count = 0;
        assertEq("alpha", text.getLine(offset: 0, line_separator: "\n", trim_line: True, byte_count: \byte_count),
            "string getLine exposes line_separator and byte_count");
        assertEq(6, byte_count, "string getLine writes byte_count");
        assertEq("<tag>", "&lt;tag&gt;".getDecoded(decoding_flags: CD_ALL), "string getDecoded exposes decoding_flags");
        assertEq("&lt;tag&gt;", "<tag>".getEncoded(encoding_flags: CE_HTML), "string getEncoded exposes encoding_flags");
        assertEq("YQ==", "a".toBase64(max_line_length: -1), "string toBase64 exposes max_line_length");
        assertEq("YQ", "a".toBase64Url(max_line_length: -1), "string toBase64Url exposes max_line_length");
        assertEq(255, "ff".toInt(base: 16), "string toInt exposes base");
        assertEq(0, "abc".comparePartial(other_string: "ab"), "string comparePartial exposes other_string");
        assertTrue("abc".equalPartial(other_string: "ab"), "string equalPartial exposes other_string");
        assertTrue("/api/v1".equalPartialPath(other_string: "/api"), "string equalPartialPath exposes other_string");

        assertEq(date(seconds: 0).format("YYYY"), date(seconds: 0).format(format: "YYYY"),
            "date format exposes format");
        assertEq((255).toBase(16), (255).toBase(base: 16), "int toBase exposes base");
        assertEq((255).encodeMsb(2), (255).encodeMsb(size: 2), "int encodeMsb exposes size");
        assertEq((255).encodeLsb(2), (255).encodeLsb(size: 2), "int encodeLsb exposes size");
        assertEq((1234).format(".,0"), (1234).format(format: ".,0"), "int format exposes format");
        assertEq((1234).format(2, ".", ","), (1234).format(precision: 2, decimal_separator: ".",
            thousands_separator: ","), "int format exposes precision and separators");
        assertEq((12.5).toBase(10), (12.5).toBase(base: 10), "float toBase exposes base");
        assertEq((12.5).format(".,1"), (12.5).format(format: ".,1"), "float format exposes format");
        assertEq((12.5n).toString(NF_Default), (12.5n).toString(format_flags: NF_Default),
            "number toString exposes format_flags");
        assertEq((12.5n).format(2, ".", ","), (12.5n).format(precision: 2, decimal_separator: ".",
            thousands_separator: ","), "number format exposes precision and separators");

        hash<auto> h = {"a": 1};
        assertTrue(h.hasKey(key: "a"), "hash hasKey exposes key");
        assertTrue(h.hasKeyValue(key: "a"), "hash hasKeyValue exposes key");
        assertTrue(h.compareKeys(other_hash: {"a": 2}), "hash compareKeys exposes other_hash");
        assertFalse(NOTHING.hasKey(key: "a"), "nothing hasKey exposes key");
        assertFalse(NOTHING.hasKeyValue(key: "a"), "nothing hasKeyValue exposes key");

        assertEq("a:b:c", ("a", "b", "c").join(separator: ":"), "list join exposes separator");
        assertTrue((1, 2, 3).contains(value: 2), "list contains exposes value");
        assertTrue((1, 2, 3).rangeIterator(value: "x") != NOTHING, "list rangeIterator exposes value");

        assertTrue(self.hasCallableMethod(method: "reviewedPseudoMethodOptIn"),
            "object hasCallableMethod exposes method");
        assertTrue(self.hasCallableNormalMethod(method: "reviewedPseudoMethodOptIn"),
            "object hasCallableNormalMethod exposes method");
        assertFalse(self.hasCallableStaticMethod(method: "reviewedPseudoMethodOptIn"),
            "object hasCallableStaticMethod exposes method");
        assertTrue(self.getCallReference(identifier: "reviewedPseudoMethodOptIn") != NOTHING,
            "object getCallReference exposes identifier");
    }

    parseFailures() {
        assertThrows("NAMED-ARG-DUPLICATE", "duplicate named argument 'a'", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("sub f(int a) {} f(a: 1, a: 2);", "duplicate-name");
        });

        assertThrows("NAMED-ARG-UNKNOWN", "named argument 'z' does not match any accessible parameter", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("sub f(int a) {} f(z: 1);", "unknown-name");
        });

        assertThrows("NAMED-ARG-POSITIONAL-AFTER-NAMED", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("sub f(int a, int b) {} f(a: 1, 2);", "positional-after-named");
        });

        assertThrows("NAMED-ARG-OVERWRITES-POSITIONAL", "named argument 'a' would overwrite a positional argument", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("sub f(int a, int b) {} f(1, a: 2);", "overwrite-positional");
        });

        assertThrows("NAMED-CALL-NOT-SUPPORTED", "call-reference or closure calls without a parse-time-resolved signature", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("sub f(int a) {} code c = \\f(); c(a: 1);", "call-reference");
        });

        assertThrows("NAMED-CALL-NOT-SUPPORTED", "have not opted in to named arguments", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("sprintf(fmt: \"%s\", value: \"x\");", "builtin-not-opted-in");
        });

        assertThrows("NAMED-ARG-UNKNOWN", "accessible named parameters are 'values' and 'comparator'", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("sort(arg: 1);", "builtin-unknown-name");
        });

        assertThrows("NAMED-CALL-NOT-SUPPORTED", "varargs-only variants cannot accept named arguments", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("sub f(...) {} f(a: 1);", "varargs-only");
        });

        assertThrows("NAMED-CALL-NOT-SUPPORTED", "ambiguous or depends on runtime argument types", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("abs(value: 1);", "ambiguous-builtin-named");
        });

        assertThrows("NAMED-ARG-UNKNOWN", "named argument 'missing' does not match any accessible parameter", sub() {
            Program p(PO_NEW_STYLE);
            p.parse("class B { constructor(int a) {} } class C inherits B { constructor() : B(missing: 1) {} } C c();",
                "base-constructor-unknown");
        });
    }
}
