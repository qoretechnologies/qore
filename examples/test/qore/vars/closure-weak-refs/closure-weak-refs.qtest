#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires QUnit
%requires FsUtil
%requires ClosureWeakRefChecks

%exec-class ClosureWeakRefsTest

#! Tests weak references held by closure-bound local variables
/** A local variable that is passed by reference or captured by a closure lives in a heap-allocated variable, which
    each execution engine reads and writes with its own code.  The checks are in ClosureWeakRefChecks.qm and run in
    this program, in each execution mode and from a compiled module.
*/
class ClosureWeakRefsTest inherits QUnit::Test {
    public {
        #! every check passes
        const Checks = keys ClosureWeakRefChecks::get_results();

        #! the execution modes that the worker is run in
        const ExecModes = ("ast", "ir", "jit");
    }

    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("ClosureWeakRefsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("checks in this program", \testInProgram());
        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled module", \testCompiledModule());

        set_return_value(main());
    }

    testInProgram() {
        checkResults("in-program", ClosureWeakRefChecks::get_results());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            checkWorkerOutput(mode, runWorker(get_script_dir(), "--exec-mode=" + mode));
        }
    }

    testCompiledModule() {
        TmpDir tmp("qore-closure-weak-refs-");
        string qmod_path = tmp.path + DirSep + "ClosureWeakRefChecks.qmod";
        string src_path = get_script_dir() + DirSep + "ClosureWeakRefChecks.qm";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output "
            "%s %s 2>&1", libqore_dir, qore_bin, qmod_path, src_path));
        assertTrue(is_file(qmod_path), "compiled checks module: " + compile_out);

        # the directory holds only the compiled module, so the worker cannot load the source instead
        checkWorkerOutput("aot", runWorker(tmp.path));
    }

    #! runs the worker with the checks module loaded from the given directory and returns its output
    private string runWorker(string module_dir, string opts = "") {
        string worker = get_script_dir() + DirSep + "closure-weak-refs-worker.q";
        return backquote(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b %s %s 2>&1", libqore_dir,
            module_dir, qore_bin, opts, worker));
    }

    #! parses the "name=value" lines printed by the worker and checks them
    private checkWorkerOutput(string label, string out) {
        hash<string, int> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(-?[0-9]+)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1].toInt();
        }
        checkResults(label, results);
    }

    private checkResults(string label, hash<string, int> results) {
        assertEq(sort(Checks), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (results.pairIterator()) {
            assertEq(1, i.value, sprintf("%s: %s", label, i.key));
        }
    }
}
