%modern
%allow-weak-references
%allow-debugger

module ClosureWeakRefChecks {
    version = "1.0";
    desc = "checks for weak references held by closure-bound local variables";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** A local variable that is passed by reference or captured by a closure is closure-bound: its value lives in a
    heap-allocated variable instead of in the frame, and each execution engine reads and writes it through that
    variable.  These checks give such variables weak references (\c ":=") to a hash or a list, and verify that
    the value the weak reference points to is neither released early nor rejected by the variable's type.
    Object checks also verify that calls through a weak reference raise OBJECT-ALREADY-DELETED after destruction,
    whether read directly, through a reference, or inside a closure (issue 5509).

    The checks are in a module so that the same code can be run from source in each execution mode and as a
    compiled (AOT) module.  Each check returns 1 if it passed and 0 if it did not.
*/
public namespace ClosureWeakRefChecks {
    #! records destruction independently of the object reached through a weak reference
    class Target {
        public {
            int value = 7;
        }
        private {
            reference<int> destroyed;
        }

        constructor(reference<int> counter) {
            destroyed = \counter;
        }

        destructor() {
            ++destroyed;
        }

        int ping() {
            return value;
        }
    }

    #! takes a reference, which makes the variable it is given closure-bound
    sub touch(reference<auto> r) {
    }

    #! returns the result of every check
    public hash<string, int> sub get_results() {
        return {
            "weak-hash-local-vars": check_weak_hash_local_vars(),
            "weak-list-local-vars": check_weak_list_local_vars(),
            "weak-hash-block-exit": check_weak_hash_block_exit(),
            "weak-list-block-exit": check_weak_list_block_exit(),
            "weak-list-reference": check_weak_list_reference(),
            "weak-list-closure": check_weak_list_closure(),
            "weak-list-or-nothing": check_weak_list_or_nothing(),
            "weak-softlist": check_weak_softlist(),
            "weak-typed-list": check_weak_typed_list(),
            "weak-list-type-error": check_weak_list_type_error(),
            "weak-object-local": check_weak_object_local(),
            "weak-object-captured-direct": check_weak_object_captured_direct(),
            "weak-object-closure": check_weak_object_closure(),
            "weak-object-typed-closure": check_weak_object_typed_closure(),
            "weak-object-escaped-closure": check_weak_object_escaped_closure(),
            "weak-object-reference": check_weak_object_reference(),
        };
    }

    #! get_local_vars() reads a closure-bound variable holding a weak hash reference without releasing its target
    int sub check_weak_hash_local_vars() {
        hash<auto> h = {"a": 1};
        hash<auto> wh := h;
        touch(\wh);
        for (int i = 0; i < 3; ++i) {
            hash<auto> lv = get_local_vars(0);
            if (lv.wh.value != {"a": 1}) {
                return 0;
            }
        }
        return h == {"a": 1} ? 1 : 0;
    }

    #! get_local_vars() reads a closure-bound variable holding a weak list reference without releasing its target
    int sub check_weak_list_local_vars() {
        list<auto> l = (1, 2);
        list<auto> wl := l;
        touch(\wl);
        for (int i = 0; i < 3; ++i) {
            hash<auto> lv = get_local_vars(0);
            if (lv.wl.value != (1, 2)) {
                return 0;
            }
        }
        return l == (1, 2) ? 1 : 0;
    }

    #! leaving the block of a closure-bound variable holding a weak hash reference does not release its target
    int sub check_weak_hash_block_exit() {
        hash<auto> h = {"a": 1};
        for (int i = 0; i < 10; ++i) {
            hash<auto> wh := h;
            touch(\wh);
        }
        return h == {"a": 1} ? 1 : 0;
    }

    #! leaving the block of a closure-bound variable holding a weak list reference does not release its target
    int sub check_weak_list_block_exit() {
        list<auto> l = (1, 2);
        for (int i = 0; i < 10; ++i) {
            list<auto> wl := l;
            touch(\wl);
        }
        return l == (1, 2) ? 1 : 0;
    }

    #! a weak list reference can be assigned to a list variable that is passed by reference
    int sub check_weak_list_reference() {
        list<auto> l = (1, 2);
        list<auto> wl := l;
        touch(\wl);
        return wl == (1, 2) ? 1 : 0;
    }

    #! a weak list reference can be assigned to a list variable that a closure captures
    int sub check_weak_list_closure() {
        list<auto> l = (1, 2);
        list<auto> wl := l;
        code c = auto sub () { return wl; };
        return c() == (1, 2) ? 1 : 0;
    }

    #! a weak list reference can be assigned to a closure-bound variable of an or-nothing list type
    int sub check_weak_list_or_nothing() {
        list<auto> l = (1, 2);
        *list<auto> wl := l;
        touch(\wl);
        return wl == (1, 2) ? 1 : 0;
    }

    #! a weak list reference can be assigned to a closure-bound variable of a soft list type
    int sub check_weak_softlist() {
        list<auto> l = (1, 2);
        softlist<auto> wl := l;
        touch(\wl);
        return wl == (1, 2) ? 1 : 0;
    }

    #! a weak reference to a typed list can be assigned to a closure-bound variable of the same type
    int sub check_weak_typed_list() {
        list<int> l = (1, 2);
        list<int> wl := l;
        touch(\wl);
        return wl == (1, 2) ? 1 : 0;
    }

    #! a weak reference to a list whose element type the variable does not accept is still rejected
    int sub check_weak_list_type_error() {
        # typed at run time only, so that the assignment is not rejected when the module is parsed
        auto l = ("a", "b");
        try {
            list<hash<auto>> wl := l;
            touch(\wl);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err == "RUNTIME-TYPE-ERROR" ? 1 : 0;
        }
        return 0;
    }

    #! an uncaptured local must reject a pseudo-method call after the last strong reference is released
    int sub check_weak_object_local() {
        int destroyed = 0;
        auto weak;
        {
            Target o(\destroyed);
            weak := o;
            if (!weak.val() || weak.ping() != 7) {
                return 0;
            }
        }
        if (destroyed != 1) {
            return 0;
        }
        try {
            weak.val();
        } catch (hash<ExceptionInfo> ex) {
            return ex.err == "OBJECT-ALREADY-DELETED" ? 1 : 0;
        }
        return 0;
    }

    #! capturing the weak variable must not change the result of a direct read in its declaring function
    int sub check_weak_object_captured_direct() {
        int destroyed = 0;
        auto weak;
        code<auto()> read = auto sub () { return weak.val(); };
        {
            Target o(\destroyed);
            weak := o;
            if (!read()) {
                return 0;
            }
        }
        if (destroyed != 1) {
            return 0;
        }
        try {
            weak.val();
        } catch (hash<ExceptionInfo> ex) {
            return ex.err == "OBJECT-ALREADY-DELETED" ? 1 : 0;
        }
        return 0;
    }

    #! returns whether a call rejected its destroyed receiver with the required exception
    bool sub rejects_deleted(code<auto()> read) {
        try {
            read();
        } catch (hash<ExceptionInfo> ex) {
            return ex.err == "OBJECT-ALREADY-DELETED";
        }
        return False;
    }

    #! pseudo-methods, ordinary methods, missing methods and copy all reject a destroyed captured receiver
    int sub check_weak_object_closure() {
        int destroyed = 0;
        auto weak;
        code<auto()> val = auto sub () { return weak.val(); };
        code<auto()> name = auto sub () { return weak.className(); };
        code<auto()> ping = auto sub () { return weak.ping(); };
        code<auto()> missing = auto sub () { return weak.missing(); };
        code<auto()> copy = auto sub () { return weak.copy(); };
        {
            Target o(\destroyed);
            weak := o;
            if (!val() || name() != "Target" || ping() != 7) {
                return 0;
            }
        }
        if (destroyed != 1) {
            return 0;
        }
        return rejects_deleted(val) && rejects_deleted(name) && rejects_deleted(ping)
            && rejects_deleted(missing) && rejects_deleted(copy) ? 1 : 0;
    }

    #! a statically typed captured receiver follows the same rules as an auto receiver
    int sub check_weak_object_typed_closure() {
        int destroyed = 0;
        *Target weak;
        code<auto()> val = auto sub () { return weak.val(); };
        code<auto()> ping = auto sub () { return weak.ping(); };
        {
            Target o(\destroyed);
            weak := o;
            if (!val() || ping() != 7) {
                return 0;
            }
        }
        return destroyed == 1 && rejects_deleted(val) && rejects_deleted(ping) ? 1 : 0;
    }

    #! returns a closure whose weak reference survives both the target and its creating frame
    code<auto()> sub make_deleted_reader(reference<int> destroyed) {
        Target o(\destroyed);
        auto weak := o;
        return auto sub () { return weak.val(); };
    }

    #! repeated calls must keep raising the exception without reviving or destroying the target again
    int sub check_weak_object_escaped_closure() {
        int destroyed = 0;
        code<auto()> read = make_deleted_reader(\destroyed);
        if (destroyed != 1) {
            return 0;
        }
        for (int i = 0; i < 3; ++i) {
            if (!rejects_deleted(read)) {
                return 0;
            }
        }
        return destroyed == 1 ? 1 : 0;
    }

    #! reference parameters must retain the receiver's deleted state
    int sub read_deleted_reference(reference<auto> weak) {
        try {
            weak.val();
        } catch (hash<ExceptionInfo> ex) {
            return ex.err == "OBJECT-ALREADY-DELETED" ? 1 : 0;
        }
        return 0;
    }

    #! passing a weak variable by reference must not turn a destroyed receiver into NOTHING
    int sub check_weak_object_reference() {
        int destroyed = 0;
        auto weak;
        {
            Target o(\destroyed);
            weak := o;
        }
        return destroyed == 1 ? read_deleted_reference(\weak) : 0;
    }

}
