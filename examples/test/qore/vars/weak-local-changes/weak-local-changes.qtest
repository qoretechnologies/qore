#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%allow-weak-references
%allow-opaque-references

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%include weak-local-change-checks.qi

%exec-class WeakLocalChangesTest

#! Tests the operators that change a local variable assigned with the weak assignment operator (:=)
/** A read of such a variable gives the target of its weak reference, but an operator that changes the variable (+=,
    -=, *=, ++, push, ...) sees the weak reference as the variable holds it, as the AST interpreter's lvalue does, and
    the target is not changed; every execution mode must give the AST interpreter's results, also when the weak
    assignment follows the change in the code.  The checks are in weak-local-change-checks.qi and run in this program,
    in a worker in each execution mode and from a compiled module.
*/
class WeakLocalChangesTest inherits QUnit::Test {
    public {
        #! the result of each check, as the AST interpreter gives it: the variable and the target after the change
        const Expected = {
            "assigned-later": "3/[1, 2]",
            "hash-minus": "0/{a: 1, b: 2}",
            "hash-plus": "0/{a: 1}",
            "list-and": "0/[1, 2]",
            "list-divide": "0/[1, 2]",
            "list-minus": "-1/[1, 2]",
            "list-modulo": "0/[1, 2]",
            "list-multiply": "0/[1, 2]",
            "list-or": "3/[1, 2]",
            "list-plus": "3/[1, 2]",
            "list-post-decrement": "-1/[1, 2]",
            "list-post-increment": "1/[1, 2]",
            "list-pre-decrement": "-1/[1, 2]",
            "list-pre-increment": "1/[1, 2]",
            "list-push": "PUSH-ERROR",
            "list-shift-left": "0/[1, 2]",
            "list-shift-right": "0/[1, 2]",
            "list-xor": "3/[1, 2]",
            "object-plus": "null/1",
            # an opaque reference is a strong reference: the change sees the list
            "opaque-plus": "[1, 2, 3]/[1, 2]",
            "result-used": "3 3/[1, 2]",
        };
    }

    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("WeakLocalChangesTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("checks in this program", \testInProgram());
        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled module", \testCompiledModule());

        set_return_value(main());
    }

    testInProgram() {
        checkResults("in-program", WeakLocalChangeChecks::get_results());
    }

    testExecModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            checkWorkerOutput(mode, runWorker("weak-local-changes-worker.q", get_script_dir(), "--exec-mode=" + mode));
        }
    }

    testCompiledModule() {
        TmpDir tmp("qore-weak-local-changes-");
        string qmod_path = tmp.path + DirSep + "WeakLocalChangeChecks.qmod";
        string src_path = get_script_dir() + DirSep + "WeakLocalChangeChecks.qm";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output "
            "%s %s 2>&1", libqore_dir, qore_bin, qmod_path, src_path));
        assertTrue(is_file(qmod_path), "compiled checks module: " + compile_out);

        # the directory holds only the compiled module, so the worker cannot load the source instead
        checkWorkerOutput("aot", runWorker("weak-local-changes-module-worker.q", tmp.path));
    }

    #! runs the given worker with the given module directory and returns its output
    private string runWorker(string worker_name, string module_dir, string opts = "") {
        string worker = get_script_dir() + DirSep + worker_name;
        return ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b --enable-debug %s %s",
            libqore_dir, module_dir, qore_bin, opts, worker));
    }

    #! parses the "name=value" lines printed by the worker and checks them
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        checkResults(label, results);
    }

    private checkResults(string label, hash<string, string> results) {
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (results.pairIterator()) {
            assertEq(Expected{i.key}, i.value, sprintf("%s: %s", label, i.key));
        }
    }
}
