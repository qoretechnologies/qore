# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# checks for reading weak references to objects held by containers; included by weak-object-reads-worker.q, so that
# the checks run in the execution mode of the worker, by weak-object-reads.qtest, so that they run in the mode of the
# test, and by WeakObjectReadChecks.qm for the compiled run

/** A weak reference (\c ":=") held by a hash or an object member reads as its target while the target exists, and a
    method call through a weak reference to an object that has been destroyed, directly or through a call reference
    created from it, raises \c OBJECT-ALREADY-DELETED.  Each check returns 1 when it passes.
*/
public namespace WeakObjectReadChecks {
    #! the target of the weak references
    class Target {
        public {
            int n = 7;
        }

        int ping() {
            return n;
        }
    }

    #! holds a weak reference in an object member
    class Holder {
        public {
            auto member;
        }
    }

    #! returns all check results: check name -> 1 for pass, 0 for fail
    public hash<string, int> sub get_results() {
        return {
            "live-hash-value": check_live_hash_value(),
            "live-object-member": check_live_object_member(),
            "destroyed-hash-value-call": check_destroyed_hash_value_call(),
            "destroyed-member-call": check_destroyed_member_call(),
        };
    }

    #! returns the results of the checks of call references created through weak references: check name -> 1 for pass
    /** A weak reference read from a hash, a list or an object member reads as its target, also when the target is
        an object that has been destroyed, so a call reference created from it raises \c OBJECT-ALREADY-DELETED when
        it is called; compiled code raised \c OBJECT-METHOD-REFERENCE-ERROR instead when it created the call
        reference, as it read no value.
    */
    public hash<string, int> sub get_call_reference_results() {
        return {
            "destroyed-hash-value-call-reference": check_destroyed_hash_value_call_reference(),
            "destroyed-dynamic-key-call-reference": check_destroyed_dynamic_key_call_reference(),
            "destroyed-list-element-call-reference": check_destroyed_list_element_call_reference(),
            "destroyed-member-call-reference": check_destroyed_member_call_reference(),
            "live-call-reference": check_live_call_reference(),
        };
    }

    #! returns @ref True if the argument has a value
    bool sub has_value(*object o) {
        return exists o;
    }

    #! returns @ref True if the code raises OBJECT-ALREADY-DELETED
    bool sub rejects_deleted(code<auto()> call) {
        try {
            call();
        } catch (hash<ExceptionInfo> ex) {
            return ex.err == "OBJECT-ALREADY-DELETED";
        }
        return False;
    }

    #! returns a hash with a weak reference to a destroyed object
    hash<auto> sub destroyed_hash() {
        hash<auto!> h = {};
        {
            Target t();
            h.target := t;
        }
        return h;
    }

    #! returns a list whose element is a weak reference to a destroyed object
    list<auto> sub destroyed_list() {
        list<auto!> l = (1,);
        {
            Target t();
            l[0] := t;
        }
        return l;
    }

    #! returns an object whose member is a weak reference to a destroyed object
    Holder sub destroyed_holder() {
        Holder holder();
        {
            Target t();
            holder.member := t;
        }
        return holder;
    }

    int sub check_live_hash_value() {
        Target t();
        hash<auto!> h = {};
        h.target := t;
        *object o = h.target;
        return exists h.target && o == t && has_value(h.target) && h.target.ping() == 7 ? 1 : 0;
    }

    int sub check_live_object_member() {
        Target t();
        Holder holder();
        holder.member := t;
        *object o = holder.member;
        return exists holder.member && o == t && has_value(holder.member) && holder.member.ping() == 7 ? 1 : 0;
    }

    int sub check_destroyed_hash_value_call() {
        hash<auto> h = destroyed_hash();
        return rejects_deleted(auto sub () { return h.target.ping(); })
            && rejects_deleted(auto sub () { return h.target.val(); }) ? 1 : 0;
    }

    #! a call reference created through a weak reference to a destroyed object raises when it is called
    int sub check_destroyed_hash_value_call_reference() {
        hash<auto> h = destroyed_hash();
        code c = \h.target.ping();
        return rejects_deleted(c) ? 1 : 0;
    }

    #! as check_destroyed_hash_value_call_reference() with a key that is not a constant
    int sub check_destroyed_dynamic_key_call_reference() {
        hash<auto> h = destroyed_hash();
        string k = "target";
        code c = \h{k}.ping();
        return rejects_deleted(c) ? 1 : 0;
    }

    #! as check_destroyed_hash_value_call_reference() with a list element
    int sub check_destroyed_list_element_call_reference() {
        list<auto> l = destroyed_list();
        code c = \l[0].ping();
        return rejects_deleted(c) ? 1 : 0;
    }

    int sub check_destroyed_member_call() {
        Holder holder = destroyed_holder();
        return rejects_deleted(auto sub () { return holder.member.ping(); })
            && rejects_deleted(auto sub () { return holder.member.val(); }) ? 1 : 0;
    }

    int sub check_destroyed_member_call_reference() {
        Holder holder = destroyed_holder();
        code c = \holder.member.ping();
        return rejects_deleted(c) ? 1 : 0;
    }

    #! a call reference created through a weak reference reaches the live target, and raises once it is destroyed
    int sub check_live_call_reference() {
        hash<auto!> h = {};
        code c;
        int rv;
        {
            Target t();
            h.target := t;
            c = \h.target.ping();
            rv = c();
        }
        return rv == 7 && rejects_deleted(c) ? 1 : 0;
    }
}
