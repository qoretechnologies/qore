%modern
%allow-weak-references

module WeakObjectReadChecks {
    version = "1.0";
    desc = "checks for reading weak references to objects held by containers";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** A weak reference (\c ":=") to an object that has been destroyed reads as no value when it is read from a hash or
    an object member, while a method call through it, directly or through a call reference created from it, raises
    \c OBJECT-ALREADY-DELETED.  Each check returns 1 when it passes; the AST interpreter read such a reference as the
    destroyed object, so that it existed and was accepted for a parameter of type \c *object, while the compiled
    tiers read it as no value.
*/
public namespace WeakObjectReadChecks {
    #! the target of the weak references
    class Target {
        public {
            int n = 7;
        }

        int ping() {
            return n;
        }
    }

    #! holds a weak reference in an object member
    class Holder {
        public {
            auto member;
        }
    }

    #! returns all check results: check name -> 1 for pass, 0 for fail
    public hash<string, int> sub get_results() {
        return {
            "live-hash-value": check_live_hash_value(),
            "live-object-member": check_live_object_member(),
            "destroyed-hash-value-exists": check_destroyed_hash_value_exists(),
            "destroyed-hash-value-is-nothing": check_destroyed_hash_value_is_nothing(),
            "destroyed-hash-value-assigned": check_destroyed_hash_value_assigned(),
            "destroyed-hash-value-argument": check_destroyed_hash_value_argument(),
            "destroyed-hash-value-call": check_destroyed_hash_value_call(),
            "destroyed-member-exists": check_destroyed_member_exists(),
            "destroyed-member-is-nothing": check_destroyed_member_is_nothing(),
            "destroyed-member-assigned": check_destroyed_member_assigned(),
            "destroyed-member-argument": check_destroyed_member_argument(),
            "destroyed-member-call": check_destroyed_member_call(),
        };
    }

    #! returns the results of the checks of call references created through weak references: check name -> 1 for pass
    /** Compiled code creates a call reference from the value that it reads through a weak reference, which is no
        value for a destroyed object, so it raises \c OBJECT-METHOD-REFERENCE-ERROR where the other execution modes
        create a call reference that raises \c OBJECT-ALREADY-DELETED when it is called; these checks are therefore
        not run from a compiled module.
    */
    public hash<string, int> sub get_call_reference_results() {
        return {
            "destroyed-hash-value-call-reference": check_destroyed_hash_value_call_reference(),
            "destroyed-member-call-reference": check_destroyed_member_call_reference(),
            "live-call-reference": check_live_call_reference(),
        };
    }

    #! returns @ref True if the argument has a value
    bool sub has_value(*object o) {
        return exists o;
    }

    #! returns @ref True if the code raises OBJECT-ALREADY-DELETED
    bool sub rejects_deleted(code<auto()> call) {
        try {
            call();
        } catch (hash<ExceptionInfo> ex) {
            return ex.err == "OBJECT-ALREADY-DELETED";
        }
        return False;
    }

    #! returns a hash with a weak reference to a destroyed object
    hash<auto> sub destroyed_hash() {
        hash<auto!> h = {};
        {
            Target t();
            h.target := t;
        }
        return h;
    }

    #! returns an object whose member is a weak reference to a destroyed object
    Holder sub destroyed_holder() {
        Holder holder();
        {
            Target t();
            holder.member := t;
        }
        return holder;
    }

    int sub check_live_hash_value() {
        Target t();
        hash<auto!> h = {};
        h.target := t;
        *object o = h.target;
        return exists h.target && o == t && has_value(h.target) && h.target.ping() == 7 ? 1 : 0;
    }

    int sub check_live_object_member() {
        Target t();
        Holder holder();
        holder.member := t;
        *object o = holder.member;
        return exists holder.member && o == t && has_value(holder.member) && holder.member.ping() == 7 ? 1 : 0;
    }

    int sub check_destroyed_hash_value_exists() {
        hash<auto> h = destroyed_hash();
        return !exists h.target ? 1 : 0;
    }

    int sub check_destroyed_hash_value_is_nothing() {
        hash<auto> h = destroyed_hash();
        return h.target === NOTHING && !h.target ? 1 : 0;
    }

    int sub check_destroyed_hash_value_assigned() {
        hash<auto> h = destroyed_hash();
        *object o = h.target;
        auto a = h.target;
        return !exists o && !exists a ? 1 : 0;
    }

    int sub check_destroyed_hash_value_argument() {
        hash<auto> h = destroyed_hash();
        return !has_value(h.target) ? 1 : 0;
    }

    int sub check_destroyed_hash_value_call() {
        hash<auto> h = destroyed_hash();
        return rejects_deleted(auto sub () { return h.target.ping(); })
            && rejects_deleted(auto sub () { return h.target.val(); }) ? 1 : 0;
    }

    #! a call reference created through a weak reference to a destroyed object raises when it is called
    int sub check_destroyed_hash_value_call_reference() {
        hash<auto> h = destroyed_hash();
        code c = \h.target.ping();
        return rejects_deleted(c) ? 1 : 0;
    }

    int sub check_destroyed_member_exists() {
        Holder holder = destroyed_holder();
        return !exists holder.member ? 1 : 0;
    }

    int sub check_destroyed_member_is_nothing() {
        Holder holder = destroyed_holder();
        return holder.member === NOTHING && !holder.member ? 1 : 0;
    }

    int sub check_destroyed_member_assigned() {
        Holder holder = destroyed_holder();
        *object o = holder.member;
        auto a = holder.member;
        return !exists o && !exists a ? 1 : 0;
    }

    int sub check_destroyed_member_argument() {
        Holder holder = destroyed_holder();
        return !has_value(holder.member) ? 1 : 0;
    }

    int sub check_destroyed_member_call() {
        Holder holder = destroyed_holder();
        return rejects_deleted(auto sub () { return holder.member.ping(); })
            && rejects_deleted(auto sub () { return holder.member.val(); }) ? 1 : 0;
    }

    int sub check_destroyed_member_call_reference() {
        Holder holder = destroyed_holder();
        code c = \holder.member.ping();
        return rejects_deleted(c) ? 1 : 0;
    }

    #! a call reference created through a weak reference reaches the live target, and raises once it is destroyed
    int sub check_live_call_reference() {
        hash<auto!> h = {};
        code c;
        int rv;
        {
            Target t();
            h.target := t;
            c = \h.target.ping();
            rv = c();
        }
        return rv == 7 && rejects_deleted(c) ? 1 : 0;
    }
}
