#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

string sub auto_variant(auto x) { return "auto"; }
string sub auto_variant(Mutex x) { return "mutex"; }

sub check(string desc, string expected, string actual) {
    if (actual != expected) {
        printf("FAIL: %s is %s (should be %s)\n", desc, actual, expected);
        exit(1);
    }
}

# Simple test: if/else with different assignments
{
    auto x;
    if (1) {  # Always true
        Mutex m();
        x = m;
    } else {
        x = NOTHING;
    }
    string result = auto_variant(x);
    check("if-else (always if): x", "mutex", result);
}

# Even simpler: just assign NOTHING
{
    auto y;
    y = NOTHING;
    string result = auto_variant(y);
    check("after NOTHING assignment: y", "auto", result);
}

# Baseline: straight assignment
{
    Mutex m();
    auto z = m;
    string result = auto_variant(z);
    check("direct Mutex assignment: z", "mutex", result);
}
