#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%exec-class NumberRoundTripTest

class NumberRoundTripTest inherits QUnit::Test {
    constructor() : Test("Round-trip decimal formatting", "1.0") {
        addTestCase("Meaningful decimal digits", \numbers());
        addTestCase("Native floating-point values", \floats());
        addTestCase("IEEE boundaries and exponent expansion", \boundaries());
        addTestCase("Signed zero and special values", \special());
        addTestCase("Existing formatting and recovery", \unchanged());
        set_return_value(main());
    }

    numbers() {
        foreach string text in ("123.45", "0.1", "1.00000000000000000001",
                "0.123450000000000000000006", "0.99999999999999999999",
                "123456789012345678901234567890.123456789", "0.0000000000000000000000000000000001") {
            number value = number(text);
            assertEq(text, value.toStringRoundTrip(), text);
            assertEq("-" + text, (-value).toStringRoundTrip(), text);
            assertEq(value, number(value.toStringRoundTrip()));
        }
        assertEq("1e-31", number("1e-31").toStringRoundTrip(True));
        assertEq("1.2345e2", 123.45n.toStringRoundTrip(True));
        assertEq("-1.2345e2", (-123.45n).toStringRoundTrip(True));
    }

    floats() {
        foreach hash<auto> test in ({"value": 123.45, "text": "123.45"},
                {"value": 0.1, "text": "0.1"}, {"value": 1.0000000000000002, "text": "1.0000000000000002"},
                {"value": 0.3 - 0.2, "text": "0.09999999999999998"},
                {"value": 1.0 / 3.0, "text": "0.3333333333333333"}) {
            float value = test.value;
            assertEq(test.text, value.toStringRoundTrip());
            assertEq("-" + test.text, (-value).toStringRoundTrip());
            assertEq(value, float(value.toStringRoundTrip()));
            assertEq(value, float(value.toStringRoundTrip(True)));
        }
        assertEq("1.2345e2", 123.45.toStringRoundTrip(True));
        assertEq("1" + strmul("0", 100), 1e100.toStringRoundTrip());
        assertEq("1e100", 1e100.toStringRoundTrip(True));
    }

    boundaries() {
        foreach float value in (5e-324, 2.2250738585072014e-308, 2.225073858507201e-308,
                1.7976931348623157e308, 9007199254740992.0, 9007199254740994.0,
                0.9999999999999999, 1.0000000000000002) {
            string plain = value.toStringRoundTrip();
            string scientific = value.toStringRoundTrip(True);
            assertFalse(plain =~ /[eE]/);
            assertEq(value, float(plain));
            assertEq(value, float(scientific));
            assertEq(-value, float((-value).toStringRoundTrip()));
        }
        assertEq("0." + strmul("0", 323) + "5", 5e-324.toStringRoundTrip());
        assertEq("5e-324", 5e-324.toStringRoundTrip(True));
        assertEq("1.7976931348623157e308", 1.7976931348623157e308.toStringRoundTrip(True));
        number large = number("1e10000");
        assertEq("1e10000", large.toStringRoundTrip(True));
        assertEq("1" + strmul("0", 10000), large.toStringRoundTrip());
    }

    special() {
        foreach auto value in (0.0, 0n) {
            assertEq("0", value.toStringRoundTrip());
            assertEq("0e0", value.toStringRoundTrip(True));
        }
        foreach auto value in (-0.0, number("-0")) {
            assertEq("-0", value.toStringRoundTrip());
            assertEq("-0e0", value.toStringRoundTrip(True));
        }
        foreach bool scientific in (False, True) {
            foreach auto value in (@nan@, number(@nan@)) {
                assertEq("NaN", value.toStringRoundTrip(scientific));
            }
            foreach auto value in (@inf@, number(@inf@)) {
                assertEq("INF", value.toStringRoundTrip(scientific));
            }
            foreach auto value in (-@inf@, number(-@inf@)) {
                assertEq("-INF", value.toStringRoundTrip(scientific));
            }
        }
    }

    unchanged() {
        number value = number("1.00000000000000000001");
        string raw = value.toString(NF_Raw);
        int bits = value.prec();
        assertEq("1", value.toString(), "the existing display heuristic remains unchanged");
        assertEq("1.00000000000000000001", value.toStringRoundTrip());
        assertEq(raw, value.toString(NF_Raw));
        assertEq(bits, value.prec());
        auto invalid = "invalid";
        assertThrows("RUNTIME-OVERLOAD-ERROR", sub() { value.toStringRoundTrip(invalid); });
        assertEq("1.00000000000000000001", value.toStringRoundTrip());
        assertThrows("RUNTIME-OVERLOAD-ERROR", sub() { 0.1.toStringRoundTrip(invalid); });
        assertEq("0.1", 0.1.toStringRoundTrip());
    }
}
