#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - the native fast-entry code generation and linking of qcc executables
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs the script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class AutoNoNarrowPlainTest

#! issue #6059: a list or hash that reaches a plain `auto!` parameter or return loses its complex type in qcc code
/** A plain `auto!` (not a subtype such as `hash<auto!>`) strips complex type information like `any`, as the AST
    interpreter does: a list or hash assigned to an `auto!` parameter, local, member or global variable or returned
    through the return type `auto!` loses its complex type, so values of any type can be written into it.  Native fast
    entries of qcc-compiled code kept the complex type of a parameter (an `auto!` parameter's variable has the type
    `auto`) and of a returned value (the return was not converted).  The script passes and returns lists, hashes, a
    hashdecl and a scalar through `auto!` in functions, methods, a static method and closures, directly and through
    call_function() and call_object_method(), with `auto` as the control, and checks that the caller's values keep
    their own types.  qcc also replaced a call with the argument of a function that only returns a parameter, which
    skipped the strip of an `auto!` or `any` parameter or of an `auto!` or `any` local that the parameter is stored
    in before it is returned, or of a type parameter of a generic class instantiated as `any`; the script makes such
    calls from a function with locals as arguments.
*/
class AutoNoNarrowPlainTest inherits QUnit::Test {
    public {
        const Iteration = "param: list hash\n"
            "param hashdecl: hash\n"
            "param default: list\n"
            "param write: [1, 2, \"a\"] list\n"
            "auto param: list<int> hash<string, int>\n"
            "method param: list hash\n"
            "static method param: list\n"
            "closure param: hash\n"
            "call_function: list\n"
            "call_object_method: hash\n"
            "return param: [1, 2] list\n"
            "return local: {a: 1} hash\n"
            "return literal: [1, 2] list\n"
            "return hashdecl: {a: 1} hash\n"
            "return scalar: 1 integer\n"
            "method return: {a: 1} hash\n"
            "closure return: [1, 2] list\n"
            "call_function return: [1, 2] list\n"
            "auto return: [1, 2] list<int>\n"
            "local: list hash\n"
            "local write: [1, 2, \"a\"] list\n"
            "member: list init: list\n"
            "global: hash\n"
            "foreach: list\n"
            "forwarded: auto! list, stored list, any list, any through auto hash, static method hash, auto! return "
                "list, auto list<int>, write [1, 2, \"s\"]\n"
            "stored: any list, auto! list, auto list<int>, other list<int>\n"
            "generic: any [1, 2, \"x\"] list, any hash hash, typed list<int>\n"
            "caller: list<int> hash<string, int>\n";
        const Expected = Iteration + Iteration + Iteration;
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
        string script;
    }

    constructor() : QUnit::Test("plain auto! strip", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir, libqore_dir);
        script = get_script_dir() + "/AutoNoNarrowPlain.qr";

        addTestCase("execution modes", \modesTest());
        addTestCase("background compiles", \backgroundTest());
        addTestCase("AOT executable -O0", \aotTest(), "-O0");
        addTestCase("AOT executable -O3", \aotTest(), "-O3");
        set_return_value(main());
    }

    #! runs the script in every execution mode, compiled at the first call
    private modesTest() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(Expected, ExecModeHarness::run(sprintf("%s QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 %s "
                "--exec-mode=%s %s", env, qore_bin, mode, script)), mode);
        }
    }

    #! runs the script with background compiles
    private backgroundTest() {
        foreach string mode in (("jit", "tiered")) {
            assertEq(Expected, backquote(sprintf("env -u QORE_JIT_SYNC_COMPILE %s QORE_IR_THRESHOLD=1 "
                "QORE_JIT_THRESHOLD=1 %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, script)),
                mode + " with background compiles");
        }
    }

    #! compiles the script with qcc: the functions are called through their native fast entries
    private aotTest(string opt) {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir dir("auto-no-narrow-plain-aot-");
        string exe = dir.path + "/auto-no-narrow-plain";
        string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, script));
        assertTrue(is_file(exe), "qcc " + opt + " compiles the script: " + out);
        assertEq(Expected, ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
    }
}
