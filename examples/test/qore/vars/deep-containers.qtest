#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm

%exec-class DeepContainersTest

class DestructorLog {
    public {
        list<string> names = ();
    }
}

class Logged {
    private {
        DestructorLog log;
        string name;
    }

    constructor(DestructorLog log, string name) {
        self.log = log;
        self.name = name;
    }

    destructor() {
        push log.names, name;
    }
}

class DeepContainersTest inherits QUnit::Test {
    public {
        const Depth = 200000;
        # freeing runs in a thread with a small stack
        const StackSize = 512 * 1024;
    }

    constructor() : QUnit::Test("deep containers", "1.0") {
        addTestCase("Freeing deeply nested lists and hashes", \freeDeepContainers());
        addTestCase("Destructors run in depth-first order", \destructorOrder());
        addTestCase("Types of deeply nested containers", \containerTypes());
        set_return_value(main());
    }

    freeDeepContainers() {
        inThread(sub () {
            list<auto> l = ();
            for (int i = 0; i < Depth; ++i) {
                l = (l, i);
            }
            assertEq(Depth - 1, l[1]);
            remove l;

            hash<auto> h = {};
            for (int i = 0; i < Depth; ++i) {
                h = {"child": h, "list": (h, i)};
            }
            assertEq(2, h.list.size());
            remove h;

            # a nested container that is still referenced elsewhere is not freed
            list<auto> shared = (1, 2);
            l = shared;
            for (int i = 0; i < Depth; ++i) {
                l = (l, shared);
            }
            remove l;
            assertEq((1, 2), shared);
        });
    }

    destructorOrder() {
        foreach int depth in ((4, 40, 400)) {
            # the expected order of the destructors, depth-first as the containers are declared
            list<string> expected = ();
            DestructorLog log();
            inThread(sub () {
                auto value = makeTree(log, depth, "", \expected);
                remove value;
            });
            assertEq(expected, log.names, sprintf("depth %d", depth));
        }
    }

    containerTypes() {
        # the type of a list or hash is derived from the types of its values; the derived types are nested up to a
        # limit, so that each level does not create a type whose name is as long as its nesting
        string src = "hash<string, string> sub run(int depth) {
    auto l = 1;
    auto h = 1;
    for (int i = 0; i < depth; ++i) {
        l = (l,);
        h = {\"a\": h};
    }
    return {\"list\": l.fullType(), \"hash\": h.fullType(), \"inner\": ((1,),).fullType()};
}";
        foreach ExecMode mode in (EM_AST, EM_IR) {
            Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
            p.setExecMode(mode);
            p.parse(src, "container types");
            hash<string, string> types = p.callFunction("run", 10000);
            assertEq("list<list<int>>", types.inner, sprintf("mode %y", mode));
            assertRegex("^list<list<", types.list, sprintf("mode %y", mode));
            assertRegex("^hash<string, hash<string, ", types.hash, sprintf("mode %y", mode));
            assertLt(1000, types.list.size(), sprintf("mode %y", mode));
            assertLt(2000, types.hash.size(), sprintf("mode %y", mode));
        }
    }

    private static auto makeTree(DestructorLog log, int depth, string path, reference<list<string>> expected) {
        # iterative construction from the innermost container outward; the order of the destructors is the order of
        # the entries from the outermost container inward
        auto inner = new Logged(log, path + "/leaf");
        list<list<string>> names = ();
        for (int i = depth - 1; i >= 0; --i) {
            string first = sprintf("%s/%d/first", path, i);
            string last = sprintf("%s/%d/last", path, i);
            if (i % 2) {
                inner = (new Logged(log, first), inner, new Logged(log, last));
            } else {
                inner = {"a": new Logged(log, first), "b": inner, "c": new Logged(log, last)};
            }
            unshift names, (first, last);
        }
        # first objects from the outside in, then the leaf, then the last objects from the inside out
        foreach list<string> n in (names) {
            push expected, n[0];
        }
        push expected, path + "/leaf";
        foreach list<string> n in (reverse(names)) {
            push expected, n[1];
        }
        return inner;
    }

    private inThread(code test) {
        if (!HAVE_MANAGE_STACK) {
            testSkip("stack management is not available");
        }
        int defaultSize = get_default_thread_stack_size();
        set_default_thread_stack_size(StackSize);
        on_exit set_default_thread_stack_size(defaultSize);

        Counter c(1);
        *hash<ExceptionInfo> ex;
        background sub () {
            on_exit c.dec();
            try {
                test();
            } catch (hash<ExceptionInfo> e) {
                ex = e;
            }
        }();
        c.waitForZero();
        if (ex) {
            throw ex.err, ex.desc, ex.arg;
        }
    }
}
