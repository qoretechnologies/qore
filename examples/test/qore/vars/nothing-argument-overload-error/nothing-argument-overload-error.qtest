#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of calls whose variant is resolved when they run

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class NothingArgumentOverloadErrorTest

#! Regression test for issue #5771: a NOTHING argument to a parameter that does not accept it
/** A local that can hold no value (%loose-types, after delete or remove, or a value of type auto) given to a
    parameter that does not accept NOTHING raised RUNTIME-TYPE-ERROR in JIT and AOT code, which passed it to the
    variant resolved at parse time, and RUNTIME-OVERLOAD-ERROR in the AST interpreter.  The variant is now committed at
    parse time only when the argument is guaranteed to match it, so every mode resolves such a call when it runs.

    NothingArgumentOverloadError.q makes each call (functions, methods, static methods, closures, call references,
    two variants, nested calls, calls in expressions and loops) directly in a function of its own; its output must be
    the one in NothingArgumentOverloadError.expected, which the AST interpreter prints, in every execution mode, on the
    IR tier and in programs compiled with qcc -O0 and -O3.
*/
class NothingArgumentOverloadErrorTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/NothingArgumentOverloadError.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/NothingArgumentOverloadError.expected");
    }

    constructor() : QUnit::Test("NOTHING argument overload error", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/nothing-argument-overload-error";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
