#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# writes the checks of weak-container-reads.qtest and their results with the AST interpreter, which is the benchmark
# for the semantics of the other execution modes
#
# usage:
#   make-weak-container-read-checks.qr            writes weak-container-read-checks.qi: every way of reading a weak
#                                                 reference from a container with every operation on the value read
#   make-weak-container-read-checks.qr --results  runs the checks with the AST interpreter and writes their results
#                                                 to weak-container-read-results.qi
#
# after a change to the checks, run it without arguments, then with --results, and review both diffs

#! a way of reading a weak reference from a container: name, read expression
hashdecl ReadForm {
    string name;
    string expr;
}

#! an operation on the value read: name, code giving a string, where {E} stands for the read expression
hashdecl ReadOperation {
    string name;
    string code;
}

const Forms = (
    <ReadForm>{"name": "hash-value", "expr": "h.w"},
    <ReadForm>{"name": "hash-dynamic-key", "expr": "h{k}"},
    <ReadForm>{"name": "member", "expr": "o.w"},
    <ReadForm>{"name": "member-dynamic-key", "expr": "o{k}"},
    <ReadForm>{"name": "list-element", "expr": "l[0]"},
    <ReadForm>{"name": "list-element-variable-index", "expr": "l[i]"},
    <ReadForm>{"name": "typed-list-element", "expr": "tl[i]"},
    <ReadForm>{"name": "map", "expr": "$1"},
    <ReadForm>{"name": "foreach", "expr": "v"},
    <ReadForm>{"name": "typed-foreach", "expr": "v"},
);

const Operations = (
    <ReadOperation>{"name": "exists", "code": 'sprintf("%y", exists {E})'},
    <ReadOperation>{"name": "is-nothing", "code": 'sprintf("%y", {E} === NOTHING)'},
    <ReadOperation>{"name": "optional-object-argument", "code": 'sprintf("%y", has_value({E}))'},
    <ReadOperation>{"name": "object-argument", "code": 'sprintf("%y", is_object({E}))'},
    <ReadOperation>{"name": "auto-argument", "code": 'type_of({E})'},
    <ReadOperation>{"name": "returned", "code": 'sprintf("%y", exists identity({E}))'},
    <ReadOperation>{"name": "assigned", "code": 'assigned_exists({E})'},
    <ReadOperation>{"name": "assigned-typed", "code": 'typed_assigned_exists({E})'},
    <ReadOperation>{"name": "method-call", "code": 'sprintf("%y", {E}.ping())'},
    <ReadOperation>{"name": "pseudo-method-call", "code": '{E}.type()'},
    <ReadOperation>{"name": "member-read", "code": 'sprintf("%y", {E}.n)'},
    <ReadOperation>{"name": "instanceof", "code": 'sprintf("%y", {E} instanceof Target)'},
    <ReadOperation>{"name": "cast", "code": 'sprintf("%y", exists cast<*Target>({E}))'},
    <ReadOperation>{"name": "bool", "code": 'sprintf("%y", {E} ? True : False)'},
    <ReadOperation>{"name": "copied-into-list", "code": 'list_copy_exists(({E},))'},
    <ReadOperation>{"name": "string", "code": 'sprintf("%y", {E})'},
);

const Header = '# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# checks of weak references read from containers, which every execution mode must read as the AST interpreter does;
# included by weak-container-reads-worker.q, so that the checks run in the execution mode of the worker, by
# weak-container-reads.qtest, so that they run in the mode of the test, and by WeakContainerReadChecks.qm for the
# compiled run; written by make-weak-container-read-checks.qr
#
# each check applies one operation to a weak reference read in one way - from a hash value, an object member or a
# list element, by map or as the variable of a foreach loop - and returns the result as a string, or the err of the
# exception raised; the target of the weak reference exists or has been destroyed

public namespace WeakContainerReadChecks {
    #! the target of the weak references
    public class Target {
        public {
            int n = 7;
        }

        int ping() {
            return n;
        }
    }

    #! holds a weak reference in an object member
    public class Holder {
        public {
            auto w;
        }
    }

    #! returns True if the argument has a value
    bool sub has_value(*object o) {
        return exists o;
    }

    #! returns True; requires an object
    bool sub is_object(object o) {
        return True;
    }

    #! returns the type of the argument
    string sub type_of(auto v) {
        return v.type();
    }

    #! returns its argument
    auto sub identity(auto v) {
        return v;
    }

    #! returns whether a local variable assigned the value has a value
    string sub assigned_exists(auto v) {
        auto a = v;
        return sprintf("%y", exists a);
    }

    #! returns whether a typed local variable assigned the value has a value
    string sub typed_assigned_exists(*Target v) {
        *Target a = v;
        return sprintf("%y", exists a);
    }

    #! returns whether the first element of the list has a value, read by an iterator
    string sub list_copy_exists(list<auto> l) {
        ListIterator it(l);
        it.next();
        return sprintf("%y", exists it.getValue());
    }
';

const ResultsHeader = '    #! returns the results of every check for a live and for a destroyed target: name -> result
    public hash<string, string> sub get_results() {
        hash<string, string> rv = {};
        foreach bool live in (True, False) {
            hash<auto!> h = {};
            Holder o();
            list<auto!> l = (1,);
            list<Target> tl = ();
            *Target keep;
            {
                Target t();
                h.w := t;
                o.w := t;
                l[0] := t;
                tl[0] := t;
                if (live) {
                    keep = t;
                }
            }
            string prefix = live ? "live-" : "destroyed-";';

const ResultsFooter = '        }
        return rv;
    }
';

const Footer = '    #! returns the results of the checks of loops: name -> result
    /** Compiled code can read the elements of a list in a bounded loop directly; each check reads the elements in
        such a loop, compares them with no value and copies them, for a live and for a destroyed target.  The
        variable of a foreach loop is assigned each element as it is; the checks of get_loop_variable_results()
        cover it.
    */
    public hash<string, string> sub get_loop_results() {
        hash<string, string> rv = {};
        foreach bool live in (True, False) {
            list<Target> tl = ();
            *Target keep;
            {
                Target t();
                tl[0] := t;
                if (live) {
                    keep = t;
                }
            }
            string prefix = live ? "live-" : "destroyed-";
            rv{prefix + "typed-list-loop-is-nothing"} = loop_is_nothing(tl);
            rv{prefix + "typed-list-loop-copied"} = loop_copied(tl);
        }
        return rv + get_loop_variable_results();
    }

    string sub loop_is_nothing(list<Target> l) {
        int nothing = 0;
        for (int i = 0; i < l.size(); ++i) {
            if (l[i] === NOTHING) {
                ++nothing;
            }
        }
        return sprintf("%d", nothing);
    }

    string sub loop_copied(list<Target> l) {
        list<auto> copy = ();
        for (int i = 0; i < l.size(); ++i) {
            push copy, l[i];
        }
        return list_copy_exists(copy);
    }

    #! a hash with a declared type for the checks of typed loop variables
    public hashdecl LoopInfo {
        int a;
    }

    #! returns the result of the check as a string, or the err of the exception it raises
    string sub loop_check(code<auto()> check) {
        try {
            auto rv = check();
            return rv.typeCode() == NT_STRING ? rv : sprintf("%y", rv);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! returns the results of the checks of the variable of a foreach loop: name -> result
    /** The variable of a foreach loop is assigned each element of the list as it is, so that it is a weak reference
        for an element that is a weak reference and a strong reference for any other element.  The checks cover a
        loop variable captured by a closure, a global loop variable, a loop over a reference, when an element that
        is not a weak reference is released, and the type checks and conversions of typed loop variables.
    */
    hash<string, string> sub get_loop_variable_results() {
        Target t();
        list<auto> wl = ();
        wl[0] := t;
        hash<auto> wh = {"a": 1};
        list<auto> whl = ();
        whl[0] := wh;
        list<auto> ll = (1, 2);
        list<auto> wll = ();
        wll[0] := ll;
        return {
            "loop-variable-closure": loop_check(string sub () {
                # the second run reads the weak reference that the first run read
                return sprintf("%d %d", loop_variable_closure_sum(wl), loop_variable_closure_sum(wl));
            }),
            "loop-variable-closure-lifetime": loop_check(\loop_variable_closure_lifetime()),
            "loop-variable-global": loop_check(int sub () {
                int s = 0;
                foreach our auto loop_variable_global in (wl) {
                    s += loop_variable_global.ping();
                }
                return s;
            }),
            "loop-variable-reference-unchanged": loop_check(\loop_variable_reference_unchanged()),
            "loop-variable-reference-assigned": loop_check(\loop_variable_reference_assigned()),
            "loop-variable-strong-element-released": loop_check(\loop_variable_strong_element_released()),
            "loop-variable-strong-element-in-body": loop_check(\loop_variable_strong_element_in_body()),
            "loop-variable-typed-strong-element-released":
                loop_check(\loop_variable_typed_strong_element_released()),
            "loop-variable-closure-strong-element-released":
                loop_check(\loop_variable_closure_strong_element_released()),
            "loop-variable-object-over-weak": loop_check(int sub () {
                int s = 0;
                foreach Target x in (wl) {
                    s += x.ping();
                }
                return s;
            }),
            "loop-variable-hash-over-weak-hash": loop_check(string sub () {
                string rv;
                foreach hash<auto> x in (whl) {
                    rv = sprintf("%s %d", x.type(), x.a);
                }
                return rv;
            }),
            "loop-variable-list-over-weak-list": loop_check(string sub () {
                string rv;
                foreach list<auto> x in (wll) {
                    rv = sprintf("%s %d", x.type(), x[1]);
                }
                return rv;
            }),
            "loop-variable-int-over-strings": loop_check(int sub () {
                int s = 0;
                foreach int x in (("a", "b")) {
                    s += x;
                }
                return s;
            }),
            "loop-variable-hash-over-string": loop_check(int sub () {
                int s = 0;
                foreach hash<auto> x in (("a",)) {
                    s += x.size();
                }
                return s;
            }),
            "loop-variable-object-over-int": loop_check(string sub () {
                string rv;
                foreach object x in ((1,)) {
                    rv = get_class_name(x);
                }
                return rv;
            }),
            "loop-variable-string-over-weak": loop_check(string sub () {
                string rv;
                foreach string x in (wl) {
                    rv = x;
                }
                return rv;
            }),
            "loop-variable-plain-hash-type": loop_check(string sub () {
                string rv;
                foreach hash x in (({"a": 1},)) {
                    rv = x.fullType();
                }
                return rv;
            }),
            "loop-variable-plain-list-type": loop_check(string sub () {
