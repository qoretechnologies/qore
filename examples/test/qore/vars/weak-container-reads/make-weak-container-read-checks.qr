    }

    #! a strong copy of the loop variable keeps the target alive after the loop, as any other variable does
    string sub loop_variable_strong_copy_lifetime() {
        int before = Tracked::destroyed;
        *Tracked t = new Tracked();
        list<auto> l = ();
        l[0] := t;
        *Tracked keep;
        foreach auto v in (l) {
            keep = v;
        }
        t = NOTHING;
        int kept = Tracked::destroyed - before;
        keep = NOTHING;
        return sprintf("%d %d", kept, Tracked::destroyed - before);
    }

    #! returns the sum of calling closures that capture the variable of a foreach loop over the given list
    int sub loop_variable_closure_sum(list<auto> l) {
        list<code> cl = ();
        foreach auto v in (l) {
            push cl, int sub () {
                return v.ping();
            };
        }
        int s = 0;
        for (int i = 0; i < cl.size(); ++i) {
            s += cl[i]();
        }
        return s;
    }

    #! a closure that captures a loop variable assigned a weak reference does not keep its target alive
    string sub loop_variable_closure_lifetime() {
        int before = Tracked::destroyed;
        *Tracked t = new Tracked();
        list<auto> l = ();
        l[0] := t;
        code c;
        foreach auto v in (l) {
            c = bool sub () {
                return exists v;
            };
        }
        t = NOTHING;
        return sprintf("%d %y", Tracked::destroyed - before, c());
    }

    #! a loop over a reference that does not change the variable writes the weak reference back to the list
    string sub loop_variable_reference_unchanged() {
        int before = Tracked::destroyed;
        *Tracked t = new Tracked();
        list<auto> l = ();
        l[0] := t;
        foreach auto v in (\l) {
        }
        t = NOTHING;
        return sprintf("%d", Tracked::destroyed - before);
    }

    #! a loop over a reference that assigns the variable the target writes a strong reference back to the list
    string sub loop_variable_reference_assigned() {
        int before = Tracked::destroyed;
        *Tracked t = new Tracked();
        list<auto> l = ();
        l[0] := t;
        foreach auto v in (\l) {
            auto target = v;
            v = target;
        }
        t = NOTHING;
        return sprintf("%d", Tracked::destroyed - before);
    }

    #! an element that is not a weak reference is released with the list once the variable no longer holds it
    string sub loop_variable_strong_element_released() {
        int before = Tracked::destroyed;
        *list<auto> l = (new Tracked(),);
        foreach auto v in (l) {
            v = NOTHING;
        }
        l = NOTHING;
        return sprintf("%d", Tracked::destroyed - before);
    }

    #! the variable keeps an element that is not a weak reference alive while the loop body runs
    string sub loop_variable_strong_element_in_body() {
        int before = Tracked::destroyed;
        hash<auto> c = {"l": (new Tracked(),)};
        string rv;
        foreach auto v in (c.l) {
            remove c.l;
            rv = sprintf("%d %y", Tracked::destroyed - before, exists v);
        }
        return rv + sprintf(" %d", Tracked::destroyed - before);
    }

    #! as loop_variable_strong_element_released() with a typed variable
    string sub loop_variable_typed_strong_element_released() {
        int before = Tracked::destroyed;
        *list<Tracked> l = (new Tracked(),);
        foreach *Tracked v in (l) {
            v = NOTHING;
        }
        l = NOTHING;
        return sprintf("%d", Tracked::destroyed - before);
    }

    #! as loop_variable_strong_element_released() with a variable captured by a closure
    string sub loop_variable_closure_strong_element_released() {
        int before = Tracked::destroyed;
        *list<auto> l = (new Tracked(),);
        code c;
        foreach auto v in (l) {
            c = bool sub () {
                return exists v;
            };
            v = NOTHING;
        }
        l = NOTHING;
        return sprintf("%d %y", Tracked::destroyed - before, c());
    }

    #! a target whose destruction is counted
    public class Tracked {
        public {
            static int destroyed = 0;
        }

        destructor() {
            ++destroyed;
        }
    }

    #! returns the results of the checks of when a target is destroyed while a value read from a weak reference to it
    #! is held: name -> result
    /** Each check reads a weak reference to the target, then releases the only strong reference to the target and
        reports whether the target was destroyed while the value read is still in scope.
    */
    public hash<string, string> sub get_lifetime_results() {
        return {
            "lifetime-hash-value-assigned": lifetime_hash_value_assigned(),
            "lifetime-list-element-assigned": lifetime_list_element_assigned(),
            "lifetime-foreach": lifetime_foreach(),
            "lifetime-typed-foreach": lifetime_typed_foreach(),
            "lifetime-map": lifetime_map(),
        };
    }

    #! returns a hash holding the only strong reference to a new target under "t", and the weak references "h" and "l"
    hash<auto> sub make_tracked() {
        Tracked::destroyed = 0;
        hash<auto!> rv = {"t": new Tracked()};
        hash<auto!> h = {};
        h.w := rv.t;
        list<auto!> l = (1,);
        l[0] := rv.t;
        rv.h = h;
        rv.l = l;
        return rv;
    }

    string sub lifetime_hash_value_assigned() {
        hash<auto!> c = make_tracked();
        auto a = c.h.w;
        remove c.t;
        return sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists a);
    }

    string sub lifetime_list_element_assigned() {
        hash<auto!> c = make_tracked();
        list<auto> l = c.l;
        auto a = l[0];
        remove c.t;
        return sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists a);
    }

    string sub lifetime_foreach() {
        hash<auto!> c = make_tracked();
        string rv;
        foreach auto v in (c.l) {
            remove c.t;
            rv = sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists v);
        }
        return rv;
    }

    string sub lifetime_typed_foreach() {
        hash<auto!> c = make_tracked();
        string rv;
        foreach Tracked v in (c.l) {
            remove c.t;
            rv = sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists v);
        }
        return rv;
    }

    string sub lifetime_map() {
        hash<auto!> c = make_tracked();
        list<auto> l = c.l;
        return (map lifetime_map_element($1, \c), l)[0];
    }

    string sub lifetime_map_element(auto v, reference<hash<auto!>> c) {
        remove c.t;
        return sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists v);
    }
}
';

#! returns the body of the check of the operation on the value read in the given way
string sub check_body(ReadForm form, string expr) {
    switch (form.name) {
        case "map":
            return sprintf("        try {\n            return (map %s, l)[0];\n        } catch (hash<ExceptionInfo> ex) {\n"
                "            return ex.err;\n        }", expr);
        case "foreach":
        case "typed-foreach":
            return sprintf("        string rv;\n        try {\n            foreach %s v in (l) {\n"
                "                rv = %s;\n            }\n        } catch (hash<ExceptionInfo> ex) {\n"
                "            return ex.err;\n        }\n        return rv;", form.name == "foreach" ? "auto" : "Target",
                expr);
    }
    return sprintf("        try {\n            return %s;\n        } catch (hash<ExceptionInfo> ex) {\n"
        "            return ex.err;\n        }", expr);
}

#! returns the checks
string sub make_checks() {
    list<string> out = (Header, ResultsHeader);
    foreach hash<ReadForm> form in (Forms) {
        int fi = $#;
        foreach hash<ReadOperation> op in (Operations) {
            push out, sprintf("            rv{prefix + \"%s-%s\"} = c_%d_%d(h, o, l, tl, \"w\", 0);", form.name,
                op.name, fi, $#);
        }
    }
    push out, ResultsFooter;
    foreach hash<ReadForm> form in (Forms) {
        int fi = $#;
        foreach hash<ReadOperation> op in (Operations) {
            push out, sprintf("    #! %s of a weak reference read as %s\n"
                "    string sub c_%d_%d(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {\n"
                "%s\n    }\n", op.name, form.name, fi, $#, check_body(form, replace(op.code, "{E}", form.expr)));
        }
    }
    push out, Footer;
    return out.join("\n");
}

#! returns the results of the checks with the AST interpreter as the results file
string sub make_results(string dir) {
    string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
    int rc;
    string output = backquote(sprintf("%s -b --exec-mode=ast %s", qore_bin,
        dir + DirSep + "weak-container-reads-worker.q"), \rc);
    if (rc) {
        throw "WORKER-ERROR", sprintf("the worker failed with exit code %d: %s", rc, output);
    }
    hash<string, string> results = {};
    foreach string line in (output.split("\n")) {
        *list<string> kv = (line =~ x/^([^=]+)=(.*)$/);
        if (!kv) {
            if (line.val()) {
                throw "WORKER-ERROR", sprintf("unexpected worker output: %y", line);
            }
            continue;
        }
        results{kv[0]} = kv[1];
    }
    list<string> out = ('# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# the results of the checks in weak-container-read-checks.qi with the AST interpreter, which every execution mode
# must give: the AST interpreter is the benchmark for the semantics of the other modes; written by
# make-weak-container-read-checks.qr --results

public namespace WeakContainerReadChecks {
    #! check name -> the result of the check with the AST interpreter
    public const AstResults = {',);
    foreach string name in (sort(keys results)) {
        push out, sprintf("        \"%s\": \"%s\",", name, replace(replace(results{name}, "\\", "\\\\"), "\"",
            "\\\""));
    }
    push out, "    };\n}\n";
    printf("%d results\n", results.size());
    return out.join("\n");
}

#! writes the file
sub write_file(string path, string contents) {
    File f();
    f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
    f.write(contents);
    f.close();
    printf("wrote %s\n", path);
}

string dir = get_script_dir();
if (ARGV[0] == "--results") {
    write_file(dir + DirSep + "weak-container-read-results.qi", make_results(dir));
} else if (ARGV) {
    stderr.printf("usage: %s [--results]\n", get_script_name());
    exit(1);
} else {
    write_file(dir + DirSep + "weak-container-read-checks.qi", make_checks());
}
