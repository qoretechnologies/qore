#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%allow-weak-references

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%include weak-container-read-checks.qi
%include weak-container-read-results.qi

%exec-class WeakContainerReadsTest

#! Tests that every execution mode reads weak references from containers as the AST interpreter does
/** The AST interpreter is the benchmark for the semantics of the other execution modes.  Each check applies an
    operation to a weak reference (\c ":=") read from a hash value, an object member or a list element, or by map,
    with a live and with a destroyed target; the checks are in
    weak-container-read-checks.qi, and weak-container-read-results.qi has their results with the AST interpreter.
    The checks run in this program, in a worker in each execution mode and from a compiled module.
*/
class WeakContainerReadsTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("WeakContainerReadsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("checks in this program", \testInProgram());
        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled module", \testCompiledModule());

        set_return_value(main());
    }

    #! the checks in the execution mode that the test is run in
    testInProgram() {
        checkResults("in-program", WeakContainerReadChecks::get_results()
            + WeakContainerReadChecks::get_lifetime_results() + WeakContainerReadChecks::get_loop_results());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            checkWorkerOutput(mode, runWorker("weak-container-reads-worker.q", get_script_dir(),
                "--exec-mode=" + mode));
        }
    }

    testCompiledModule() {
        TmpDir tmp("qore-weak-container-reads-");
        string qmod_path = tmp.path + DirSep + "WeakContainerReadChecks.qmod";
        string src_path = get_script_dir() + DirSep + "WeakContainerReadChecks.qm";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output "
            "%s %s 2>&1", libqore_dir, qore_bin, qmod_path, src_path));
        assertTrue(is_file(qmod_path), "compiled checks module: " + compile_out);

        # the directory holds only the compiled module, so the worker cannot load the source instead
        checkWorkerOutput("aot", runWorker("weak-container-reads-module-worker.q", tmp.path));
    }

    #! a run with an execution mode runs through ExecModeHarness, which checks its native compilation
    private string runWorker(string worker_name, string module_dir, string opts = "") {
        string worker = get_script_dir() + DirSep + worker_name;
        return ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b --enable-debug %s %s",
            libqore_dir, module_dir, qore_bin, opts, worker));
    }

    #! parses the "name=value" lines printed by the worker and checks them
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        checkResults(label, results);
    }

    #! every check gives the result it gives with the AST interpreter
    private checkResults(string label, hash<string, string> results) {
        assertEq(sort(keys WeakContainerReadChecks::AstResults), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (WeakContainerReadChecks::AstResults.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
