    #! exists of a weak reference read as hash-value
    string sub c_0_0(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", exists h.w);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! is-nothing of a weak reference read as hash-value
    string sub c_0_1(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", h.w === NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

