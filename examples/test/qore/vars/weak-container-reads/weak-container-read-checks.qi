    #! exists of a weak reference read as hash-value
    string sub c_0_0(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", exists h.w);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! is-nothing of a weak reference read as hash-value
    string sub c_0_1(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", h.w === NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! optional-object-argument of a weak reference read as hash-value
    string sub c_0_2(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", has_value(h.w));
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! object-argument of a weak reference read as hash-value
    string sub c_0_3(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", is_object(h.w));
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! auto-argument of a weak reference read as hash-value
    string sub c_0_4(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return type_of(h.w);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! returned of a weak reference read as hash-value
    string sub c_0_5(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", exists identity(h.w));
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! assigned of a weak reference read as hash-value
    string sub c_0_6(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return assigned_exists(h.w);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! assigned-typed of a weak reference read as hash-value
    string sub c_0_7(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return typed_assigned_exists(h.w);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! method-call of a weak reference read as hash-value
    string sub c_0_8(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", h.w.ping());
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! pseudo-method-call of a weak reference read as hash-value
    string sub c_0_9(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return h.w.type();
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! member-read of a weak reference read as hash-value
    string sub c_0_10(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", h.w.n);
        } catch (hash<ExceptionInfo> ex) {
