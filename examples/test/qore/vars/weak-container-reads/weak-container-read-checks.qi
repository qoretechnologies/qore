    #! a strong copy of the loop variable keeps the target alive after the loop, as any other variable does
    string sub loop_variable_strong_copy_lifetime() {
        int before = Tracked::destroyed;
        *Tracked t = new Tracked();
        list<auto> l = ();
        l[0] := t;
        *Tracked keep;
        foreach auto v in (l) {
            keep = v;
        }
        t = NOTHING;
        int kept = Tracked::destroyed - before;
        keep = NOTHING;
        return sprintf("%d %d", kept, Tracked::destroyed - before);
    }

    #! returns the sum of calling closures that capture the variable of a foreach loop over the given list
    int sub loop_variable_closure_sum(list<auto> l) {
        list<code> cl = ();
        foreach auto v in (l) {
            push cl, int sub () {
                return v.ping();
            };
        }
        int s = 0;
        for (int i = 0; i < cl.size(); ++i) {
            s += cl[i]();
        }
        return s;
    }

    #! a closure that captures a loop variable assigned a weak reference does not keep its target alive
    string sub loop_variable_closure_lifetime() {
        int before = Tracked::destroyed;
        *Tracked t = new Tracked();
        list<auto> l = ();
        l[0] := t;
        code c;
        foreach auto v in (l) {
            c = bool sub () {
                return exists v;
            };
        }
        t = NOTHING;
        return sprintf("%d %y", Tracked::destroyed - before, c());
    }

    #! a loop over a reference that does not change the variable writes the weak reference back to the list
    string sub loop_variable_reference_unchanged() {
        int before = Tracked::destroyed;
        *Tracked t = new Tracked();
        list<auto> l = ();
        l[0] := t;
        foreach auto v in (\l) {
        }
        t = NOTHING;
        return sprintf("%d", Tracked::destroyed - before);
    }

    #! a loop over a reference that assigns the variable the target writes a strong reference back to the list
    string sub loop_variable_reference_assigned() {
        int before = Tracked::destroyed;
        *Tracked t = new Tracked();
        list<auto> l = ();
        l[0] := t;
        foreach auto v in (\l) {
            auto target = v;
            v = target;
        }
        t = NOTHING;
        return sprintf("%d", Tracked::destroyed - before);
    }

    #! an element that is not a weak reference is released with the list once the variable no longer holds it
    string sub loop_variable_strong_element_released() {
        int before = Tracked::destroyed;
        *list<auto> l = (new Tracked(),);
        foreach auto v in (l) {
            v = NOTHING;
        }
        l = NOTHING;
        return sprintf("%d", Tracked::destroyed - before);
    }

    #! the variable keeps an element that is not a weak reference alive while the loop body runs
    string sub loop_variable_strong_element_in_body() {
        int before = Tracked::destroyed;
        hash<auto> c = {"l": (new Tracked(),)};
        string rv;
        foreach auto v in (c.l) {
            remove c.l;
            rv = sprintf("%d %y", Tracked::destroyed - before, exists v);
        }
        return rv + sprintf(" %d", Tracked::destroyed - before);
    }

    #! as loop_variable_strong_element_released() with a typed variable
    string sub loop_variable_typed_strong_element_released() {
        int before = Tracked::destroyed;
        *list<Tracked> l = (new Tracked(),);
        foreach *Tracked v in (l) {
            v = NOTHING;
        }
        l = NOTHING;
        return sprintf("%d", Tracked::destroyed - before);
    }

    #! as loop_variable_strong_element_released() with a variable captured by a closure
    string sub loop_variable_closure_strong_element_released() {
        int before = Tracked::destroyed;
        *list<auto> l = (new Tracked(),);
        code c;
        foreach auto v in (l) {
            c = bool sub () {
                return exists v;
            };
            v = NOTHING;
        }
        l = NOTHING;
        return sprintf("%d %y", Tracked::destroyed - before, c());
    }

    #! a target whose destruction is counted
    public class Tracked {
        public {
            static int destroyed = 0;
        }

        destructor() {
            ++destroyed;
        }
    }

    #! returns the results of the checks of when a target is destroyed while a value read from a weak reference to it
    #! is held: name -> result
    /** Each check reads a weak reference to the target, then releases the only strong reference to the target and
        reports whether the target was destroyed while the value read is still in scope.
    */
    public hash<string, string> sub get_lifetime_results() {
        return {
            "lifetime-hash-value-assigned": lifetime_hash_value_assigned(),
            "lifetime-list-element-assigned": lifetime_list_element_assigned(),
            "lifetime-foreach": lifetime_foreach(),
            "lifetime-typed-foreach": lifetime_typed_foreach(),
            "lifetime-map": lifetime_map(),
        };
    }

    #! returns a hash holding the only strong reference to a new target under "t", and the weak references "h" and "l"
    hash<auto> sub make_tracked() {
        Tracked::destroyed = 0;
        hash<auto!> rv = {"t": new Tracked()};
        hash<auto!> h = {};
        h.w := rv.t;
        list<auto!> l = (1,);
        l[0] := rv.t;
        rv.h = h;
        rv.l = l;
        return rv;
    }

    string sub lifetime_hash_value_assigned() {
        hash<auto!> c = make_tracked();
        auto a = c.h.w;
        remove c.t;
        return sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists a);
    }

    string sub lifetime_list_element_assigned() {
        hash<auto!> c = make_tracked();
        list<auto> l = c.l;
        auto a = l[0];
        remove c.t;
        return sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists a);
    }

    string sub lifetime_foreach() {
        hash<auto!> c = make_tracked();
        string rv;
        foreach auto v in (c.l) {
            remove c.t;
            rv = sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists v);
        }
        return rv;
    }

    string sub lifetime_typed_foreach() {
        hash<auto!> c = make_tracked();
        string rv;
        foreach Tracked v in (c.l) {
            remove c.t;
            rv = sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists v);
        }
        return rv;
    }

    string sub lifetime_map() {
        hash<auto!> c = make_tracked();
        list<auto> l = c.l;
        return (map lifetime_map_element($1, \c), l)[0];
    }

    string sub lifetime_map_element(auto v, reference<hash<auto!>> c) {
        remove c.t;
        return sprintf("destroyed: %d, exists: %y", Tracked::destroyed, exists v);
    }
}
