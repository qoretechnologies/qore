    #! returns the results of the checks of loops: name -> result
    /** Compiled code can read the elements of a list in a bounded loop directly; each check reads the elements in
        such a loop, compares them with no value and copies them, for a live and for a destroyed target.  The
        variable of a foreach loop is assigned each element as it is; the checks of get_loop_variable_results()
        cover it.
    */
    public hash<string, string> sub get_loop_results() {
        hash<string, string> rv = {};
        foreach bool live in (True, False) {
            list<Target> tl = ();
            *Target keep;
            {
                Target t();
                tl[0] := t;
                if (live) {
                    keep = t;
                }
            }
            string prefix = live ? "live-" : "destroyed-";
            rv{prefix + "typed-list-loop-is-nothing"} = loop_is_nothing(tl);
            rv{prefix + "typed-list-loop-copied"} = loop_copied(tl);
        }
        return rv + get_loop_variable_results();
    }

    string sub loop_is_nothing(list<Target> l) {
        int nothing = 0;
        for (int i = 0; i < l.size(); ++i) {
            if (l[i] === NOTHING) {
                ++nothing;
            }
        }
        return sprintf("%d", nothing);
    }

    string sub loop_copied(list<Target> l) {
        list<auto> copy = ();
        for (int i = 0; i < l.size(); ++i) {
            push copy, l[i];
        }
        return list_copy_exists(copy);
    }

    #! a hash with a declared type for the checks of typed loop variables
    public hashdecl LoopInfo {
        int a;
    }

    #! returns the result of the check as a string, or the err of the exception it raises
    string sub loop_check(code<auto()> check) {
        try {
            auto rv = check();
            return rv.typeCode() == NT_STRING ? rv : sprintf("%y", rv);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

