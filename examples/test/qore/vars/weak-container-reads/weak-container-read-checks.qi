        }
    }

    #! instanceof of a weak reference read as hash-value
    string sub c_0_11(hash<auto> h, Holder o, list<auto> l, list<Target> tl, string k, int i) {
        try {
            return sprintf("%y", h.w instanceof Target);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
