#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%exec-class DotKeywordWhitespaceTest

#! a keyword used as a member or method name after "." can have white space before it, as any other name can (issue
#! #525): "h. keys()" was the keys operator applied to "()"
class DotKeywordWhitespaceTest inherits QUnit::Test {
    public {
        #! the white space put between the dot and the keyword
        const Spaces = (" ", "\t", "\n", " \n\t ", "\r\n");
    }

    constructor() : QUnit::Test("dot keyword whitespace", "1.0") {
        addTestCase("method calls", \methodCalls());
        addTestCase("every keyword after a dot", \everyKeyword());
        addTestCase("line numbers", \lineNumbers());
        addTestCase("keyword operators", \keywordOperators());
        addTestCase("the fix of a hard keyword", \hardKeywordFix());
        addTestCase("the location of the token after a keyword", \nextTokenLocation());
        set_return_value(main());
    }

    #! the case of the issue: a method of a hash whose name is a keyword
    private methodCalls() {
        hash<auto> h = {"1": "2", "3": "4"};
        foreach string sp in (Spaces) {
            assertEq(("1", "3"), evalCode("hash<auto> h = {\"1\": \"2\", \"3\": \"4\"}; return h." + sp + "keys();"),
                sprintf("%y", sp));
            assertEq(2, evalCode("hash<auto> h = {\"1\": \"2\", \"3\": \"4\"}; return h." + sp + "size();"),
                sprintf("%y", sp));
        }
        # with no white space, as before
        assertEq(("1", "3"), h.keys());
    }

    #! every keyword that the scanner reads after a dot gives the same result with white space before it as without
    private everyKeyword() {
        list<string> kws = getDotKeywords();
        assertGt(60, kws.size(), "the scanner's dot keyword rules");
        foreach string kw in (kws) {
            string code_fmt = "hash<auto> h = {\"%s\": 3}; return h.%s%s;";
            auto expected = tryCode(sprintf(code_fmt, kw, "", kw));
            foreach string sp in (Spaces) {
                assertEq(expected, tryCode(sprintf(code_fmt, kw, sp, kw)), sprintf("'%s' after %y", kw, sp));
            }
        }
    }

    #! a line break in the token: the lines after it are counted
    private lineNumbers() {
        Program p(PO_MODERN | PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse("int sub get() {\n    hash<auto> h = {\"a\": 1};\n    list<auto> l = h.\n\n        keys();\n"
            "    throw \"X\", l;\n}\n", "lines");
        try {
            p.callFunction("get");
            assertTrue(False, "the function throws");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("X", ex.err);
            assertEq(("a",), ex.desc);
            assertEq(6, ex.line);
        }
    }

    #! a keyword that is not after a dot is still the keyword
    private keywordOperators() {
        assertEq(("a",), evalCode("hash<auto> h = {\"a\": 1}; return keys h;"));
        assertEq(1, evalCode("list<auto> l = (1,); return elements l;"));
    }

    #! the fix offered for a hard keyword after a dot replaces the dot, the white space and the keyword
    private hardKeywordFix() {
        foreach string sp in ("", "   ", "\n    ", "\t\n\n ", "\r\n ") {
            string src = "nothing sub get() {\n    hash<auto> h = {};\n    any v = h." + sp + "enum;\n}\n";
            Program p(PO_MODERN);
            p.setParseDiagnosticsCollected(True);
            try {
                p.parse(src, "hard-keyword");
            } catch (hash<ExceptionInfo> ex) {}
            *hash<ParseDiagnosticInfo> d;
            foreach hash<ParseDiagnosticInfo> i in (p.getParseDiagnostics()) {
                if (i.id == "HARD-KEYWORD-MEMBER-ACCESS") {
                    d = i;
                    break;
                }
            }
            assertEq("HARD-KEYWORD-MEMBER-ACCESS", d.id, sprintf("%y", sp));
            hash<ParseDiagnosticEditInfo> e = d.fixes[0].edits[0];
            string fixed = src.substr(0, offset(src, e.startLine, e.startColumn)) + e.replacement
                + src.substr(offset(src, e.endLine, e.endColumn));
            assertEq("nothing sub get() {\n    hash<auto> h = {};\n    any v = h{\"enum\"};\n}\n", fixed,
                sprintf("%y", sp));
        }
    }

    #! the token after a dot keyword starts right after the keyword: the character after it was counted twice
    private nextTokenLocation() {
        # the line of the error and the code before it
        list<list<string>> cases = (
            ("    auto x = h.keys ) ;", ""),
            ("    auto x = h.keys;   )", ""),
            ("    auto x = h. keys ) ;", ""),
            ("    )", "    auto x = h.keys\n"),
            ("    )", "    auto x = h.\n    keys\n"),
        );
        foreach list<string> c in (cases) {
            string src = "nothing sub get() {\n    hash<auto> h = {};\n" + c[1] + c[0] + "\n}\n";
            Program p(PO_MODERN);
            p.setParseDiagnosticsCollected(True);
            try {
                p.parse(src, "next-token");
            } catch (hash<ExceptionInfo> ex) {}
            *hash<ParseDiagnosticInfo> d;
            foreach hash<ParseDiagnosticInfo> i in (p.getParseDiagnostics()) {
                if (i.severity == "error") {
                    d = i;
                    break;
                }
            }
            assertRegex("unexpected '\\)'", d.message, src);
            # the line of the error: the lines of the code before it, after the two first lines
            assertEq(3 + (c[1] =~ x/(\n)/g).size(), d.startLine, src);
            assertEq(c[0].find(")"), d.startColumn, src);
        }
    }

    #! returns the offset in the text of a 1-based line and a 0-based column
    private int offset(string text, int line, int col) {
        int off = 0;
        while (--line) {
            off = text.find("\n", off) + 1;
        }
        return off + col;
    }

    #! returns the dot keywords of the scanner's rules
    private list<string> getDotKeywords() {
        string path = get_script_dir() + "/../../../../lib/scanner.lpp";
        if (!is_file(path)) {
            testSkip("the scanner's source is not available at " + path);
        }
        string src = ReadOnlyFile::readTextFile(path);
        *list<*string> kws = (src =~ x/\n\\\.\{DOTWS\}\*([A-Za-z_]+)/g);
        return map $1, kws;
    }

    #! returns the value of the code, run as the body of a function in a new Program
    private auto evalCode(string body) {
        Program p(PO_MODERN | PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse("auto sub get() { " + body + " }\n", "code");
        return p.callFunction("get");
    }

    #! returns the value of the code or the error and description of its exception
    private auto tryCode(string body) {
        try {
            return {"value": evalCode(body)};
        } catch (hash<ExceptionInfo> ex) {
            # the description without the location, which differs by the white space
            return {"err": ex.err, "desc": ex.desc};
        }
    }
}
