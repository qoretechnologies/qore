%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil

%include ParseStackBoundary.qc

%exec-class ParseStackBoundaryPart5

#! runs part 5 of 5 of the cases of ParseStackBoundaryBase: chains of AOT modules
class ParseStackBoundaryPart5 inherits ParseStackBoundaryBase {
    constructor() : ParseStackBoundaryBase("ParseStackBoundaryPart5", 5) {
    }
}
