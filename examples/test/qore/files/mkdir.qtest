#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit

%exec-class MkdirTest

class MkdirTest inherits QUnit::Test {
    public {}

    private {
        #! the base name of the directories the test creates in the temporary directory
        /** unique for every run, so that runs on the same host, at the same time or after a run that left
            directories behind, never use each other's directories
        */
        string unique_name = sprintf("qore_mkdir_test_%d_%s", getpid(), get_random_string(8));
    }

    constructor() : Test("mkdir Test", "1.0") {
        addTestCase("mkdirPosTest", \mkdirPosTest());
        addTestCase("mkdirNegTest", \mkdirNegTest());
        addTestCase("mkdirParentTest", \mkdirParentTest());

        set_return_value(main());
    }

    mkdirPosTest() {
        string dir = tmp_location() + DirSep + unique_name + "-mkpos";
        on_exit rmdir(dir);
        int ret = mkdir(dir);
        assertEq(0, ret);
    }

    mkdirNegTest() {
        string dir = tmp_location() + DirSep + unique_name + "-mkneg/mk2/mk3/mk4";
        on_exit rmdir(dir);
        int ret = mkdir(dir);
        assertEq(-1, ret);

        assertEq(-1, mkdir("/err/invalid", 0700, True));
        assertThrows("DIR-CREATE-FAILURE", \mkdir_ex(), ("/err/invalid", 0700, True));
    }

    mkdirParentTest() {
        string dir1 = tmp_location() + DirSep + unique_name + "-mkparpos3";
        string dir2 = dir1 + DirSep + "mk2";
        string dir3 = dir2 + DirSep + "mk3";
        int ret = mkdir(dir3, 0777, True);
        on_exit {
            rmdir(dir3);
            rmdir(dir2);
            rmdir(dir1);
        }
        assertEq("DIRECTORY", hstat(dir3).type);
        assertEq("DIRECTORY", hstat(dir2).type);
        assertEq("DIRECTORY", hstat(dir1).type);

        assertEq(0, ret);
    }
}
