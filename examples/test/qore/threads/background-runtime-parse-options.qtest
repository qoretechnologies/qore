#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in qcc executables
# test-platform: macos - background threads started by interpreted, compiled and AOT-compiled code

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../TestInterpreter.qm

%exec-class BackgroundRuntimeParseOptionsTest

#! A background thread runs with the run-time parse options of the code that starts it (qore#6208)
/** The thread started by the \c background operator began with no run-time parse options, so the background
    expression did not run with the options of the starting code, nor with the restrictions that apply to it.  The
    checks run in every execution mode, in a child Program with a restriction and in one without, for a background
    expression, a background closure and nested background expressions; a module (source and compiled) starts a
    thread for a restricted and for a sandboxed caller; thread pool tasks, call_async() callbacks and signal handlers
    that are call references to builtin code and call_async() code run with the restriction of the code that handed
    them over, as do exit hooks; a thread pool task that module code submits for a sandboxed caller keeps the
    caller's restriction; a script compares the options of its thread with its own, interpreted and as qcc
    executables.  Each case runs in a process of its own, which waits for its background threads before it exits, so
    its output is complete and in order.
*/
class BackgroundRuntimeParseOptionsTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;

        const Modes = ("ast", "ir", "tiered", "jit");

        #! the code of the child Program, which runs in the mode given and with or without a restriction
        const ChildCode = "%modern
nothing sub expr(File f) {
    background f.print(\"expr: printed\\n\");
}
nothing sub nested_expr(File f) {
    background (background f.print(\"nested expr: printed\\n\"));
}
nothing sub closure(File f, Queue q) {
    background sub () {
        try {
            f.print(\"\");
            q.push(\"closure: printed\");
        } catch (hash<ExceptionInfo> ex) {
            q.push(\"closure: \" + ex.err);
        }
    }();
}
nothing sub nested_closure(File f, Queue q) {
    background (background sub () {
        try {
            f.print(\"\");
            q.push(\"nested closure: printed\");
        } catch (hash<ExceptionInfo> ex) {
            q.push(\"nested closure: \" + ex.err);
        }
    }());
}
nothing sub mask(Queue q) {
    background q.push(\"mask: \" + ((Program::getCallerCapabilityMask(0) & PO_NO_TERMINAL_IO) ? \"restricted\"
        : \"unrestricted\"));
}
nothing sub nested_mask(Queue q) {
    background (background q.push(\"nested mask: \" + ((Program::getCallerCapabilityMask(0) & PO_NO_TERMINAL_IO)
        ? \"restricted\" : \"unrestricted\")));
}
nothing sub neg_index(Queue q) {
    list<int> l = (1, 2, 3);
    background q.push(\"index: \" + l[-1]);
}
";

        #! runs one case of the child Program: ARGV[0] is the mode, ARGV[1] the case, ARGV[2] \"restricted\" or not
        const ChildScript = "%modern
%no-child-restrictions
hash<string, auto> modes = {\"ast\": EM_AST, \"ir\": EM_IR, \"tiered\": EM_TIERED, \"jit\": EM_JIT};
Program p(ARGV[2] == \"restricted\" ? PO_NO_TERMINAL_IO : 0);
p.setExecMode(modes{ARGV[0]});
p.parse(ENV.BG_CHILD_CODE, \"child\");
switch (ARGV[1]) {
    case \"expr\":
        p.callFunction(\"expr\", stdout);
        break;
    case \"nested-expr\":
        p.callFunction(\"nested_expr\", stdout);
        break;
    case \"probe\":
        Queue q();
        foreach string f in ((\"closure\", \"nested_closure\")) {
            p.callFunction(f, stdout, q);
            printf(\"%s\\n\", q.get(30000));
        }
        foreach string f in ((\"mask\", \"nested_mask\", \"neg_index\")) {
            p.callFunction(f, q);
            printf(\"%s\\n\", q.get(30000));
        }
        break;
}
";

        #! a module whose code starts threads
        const ModuleSource = "%modern

module BgRuntimeOpts {
    version = \"1.0\";
    desc = \"qore#6208: background threads with the run-time parse options of the starting code\";
    author = \"Qore\";
    license = \"MIT\";
}

public namespace BgRuntimeOpts {
    #! returns whether the module's threads run with its options, and the value of a negative index in one
    public list<auto> sub probe() {
        Queue q();
        list<int> l = (1, 2, 3);
        int m = Program::getCallerCapabilityMask(0);
        background (q.push(Program::getCallerCapabilityMask(0) == m), q.push(l[-1]));
        list<auto> rv = (q.get(30000), q.get(30000));
        background (background q.push(Program::getCallerCapabilityMask(0) == m));
        rv += q.get(30000);
        return rv;
    }

    #! prints in a background thread
    public nothing sub bgprint(File f) {
        background f.print(\"module: printed\\n\");
    }

    #! prints in a thread pool task: a closure of the module, which keeps the restriction of the module code's caller
    public nothing sub poolprint(File f) {
        ThreadPool tp(1);
        tp.submit(sub () { f.print(\"module: printed\\n\"); });
        tp.stopWait();
    }
}
";

        #! a %modern importer of the module
        const ModernImporter = "%modern
%requires BgRuntimeOpts
printf(\"%y\\n\", BgRuntimeOpts::probe());
";

        #! a restricted Program that calls module code that starts a thread: the module code runs with the
        #! restriction of its caller, and so does its thread
        const RestrictedImporter = "%modern
%no-child-restrictions
hash<string, auto> modes = {\"ast\": EM_AST, \"ir\": EM_IR, \"tiered\": EM_TIERED, \"jit\": EM_JIT};
Program p(PO_NO_TERMINAL_IO);
p.setExecMode(modes{ARGV[0]});
p.parse(\"%modern\\n%requires BgRuntimeOpts\\nnothing sub run(File f) { BgRuntimeOpts::bgprint(f); }\\n\", \"child\");
p.callFunction(\"run\", stdout);
";

        #! code run for a Program in other threads: a call reference to builtin code (a thread pool task, a signal
        #! handler) sets no options of its own, so it runs with those of the code that handed it over; ARGV[0] is the
        #! case, ARGV[1] \"restricted\" or not
        const CallbackScript = "%modern
%no-child-restrictions
Program p(ARGV[1] == \"restricted\" ? PO_NO_TERMINAL_IO : 0);
p.parse(\"%modern
nothing sub pool(File f, Queue q) {
    # one worker runs the tasks in order: the second ends after the first
    ThreadPool tp(1);
    tp.submit(\\\\f.sync());
    tp.submit(sub () { q.push(\\\"pool: done\\\"); });
    tp.stopWait();
}
nothing sub async(File f, Queue q) {
    # call_async() takes code with a Program: a closure, which runs with the options of its own Program
    Future fu = call_async(sub () { f.sync(); });
    try {
        fu.get();
        q.push(\\\"async: allowed\\\");
    } catch (hash<ExceptionInfo> ex) {
        q.push(\\\"async: \\\" + ex.err);
    }
}
nothing sub exit_hook(File f, Queue q) {
    # hooks run in the reverse order of their registration: this one runs after the builtin one
    register_exit_hook(sub () { q.push(\\\"exit_hook: done\\\"); });
    register_exit_hook(\\\\f.sync());
}
nothing sub signal(File f, Queue q) {
    # the handler is called with the signal number, which File::lock() takes; it checks the terminal I/O restriction
    set_signal_handler(SIGUSR1, \\\\f.lock());
    set_signal_handler(SIGUSR2, sub (int sig) { q.push(\\\"signal: done\\\"); });
}
\", \"child\");
Queue q();
p.callFunction(ARGV[0], stdout, q);
if (ARGV[0] == \"exit_hook\") {
    # deleting the Program runs its hooks in this thread
    delete p;
}
if (ARGV[0] == \"signal\") {
    # the signal thread runs one handler at a time, and the lower signal first when both are pending
    system(\"kill -USR1 \" + getpid());
    system(\"kill -USR2 \" + getpid());
}
printf(\"%s\\n\", q.get(30000));
";

        #! a sandboxed caller of module code that the process loaded before: the module code runs with the restriction
        #! of its caller, which the thread that it starts inherits (the override of a call of module code); without the
        #! sandbox, the module code runs with its own options, but the terminal is not used for a caller restricted from
        #! it, which the thread that module code starts records (qore#7140, qore#6337)
        const SandboxedCaller = "%modern
%no-child-restrictions
%requires BgRuntimeOpts
hash<string, auto> modes = {\"ast\": EM_AST, \"ir\": EM_IR, \"tiered\": EM_TIERED, \"jit\": EM_JIT};
# \"nofs\": a caller restricted from the file system only, without a sandbox
Program p(ARGV[1] == \"nofs\" ? PO_NO_FILESYSTEM : PO_NO_TERMINAL_IO);
p.setExecMode(modes{ARGV[0]});
if (ARGV[1] == \"sandboxed\") {
    p.setSandboxManager(new SandboxManager());
}
p.parse(\"%modern\\n%requires BgRuntimeOpts\\nnothing sub run(File f, string how) { \"
    \"how == 'pool' ? BgRuntimeOpts::poolprint(f) : BgRuntimeOpts::bgprint(f); }\\n\", \"child\");
p.callFunction(\"run\", stdout, ARGV[2]);
";

        #! a script whose threads compare their options with the script's, for qcc executables
        const ExeSource = "%modern
Queue q();
list<int> l = (1, 2, 3);
int m = Program::getCallerCapabilityMask(0);
background (q.push(Program::getCallerCapabilityMask(0) == m), q.push(l[-1]));
list<auto> rv = (q.get(30000), q.get(30000));
background (background q.push(Program::getCallerCapabilityMask(0) == m));
rv += q.get(30000);
printf(\"%y\\n\", rv);
";
    }

    constructor() : QUnit::Test("BackgroundRuntimeParseOptionsTest", "1.0", \ARGV) {
        # never the test's own executable when it runs compiled with qcc (TestInterpreter)
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = TestInterpreter::qcc_compiler() ?? "";
        addTestCase("child Program: background code runs with the restriction of the starting code",
            \restrictedTest());
        addTestCase("child Program: background code without a restriction", \openTest());
        addTestCase("module: threads of module code", \moduleTest());
        addTestCase("callbacks: thread pool tasks, call_async() and signal handlers", \callbackTest());
        addTestCase("script: threads of interpreted and compiled code", \exeTest());
        set_return_value(main());
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    #! the environment of a child process: the library under test; closures are compiled at their first call
    private string env() {
        return sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s QORE_IR_THRESHOLD=1 "
            "QORE_JIT_THRESHOLD=1", libqore_dir, libqore_dir, libqore_dir);
    }

    private string runChild(string script, string mode, string case_name, string restriction) {
        return backquote(sprintf("%s BG_CHILD_CODE=%s %s -b %s %s %s %s 2>&1", env(), shell_quote(ChildCode),
            qore_bin, script, mode, case_name, restriction));
    }

    private string shell_quote(string str) {
        return "'" + replace(str, "'", "'\\''") + "'";
    }

    restrictedTest() {
        TmpDir tmp("qore-bg-runtime-po-");
        string script = tmp.path + "/child.q";
        write(script, ChildScript);
        foreach string mode in (Modes) {
            foreach string case_name in (("expr", "nested-expr")) {
                string out = runChild(script, mode, case_name, "restricted");
                assertRegex("ILLEGAL-EXPRESSION", out, sprintf("%s refused, mode %s", case_name, mode));
                assertFalse(out =~ /printed/, sprintf("%s did not print, mode %s: %s", case_name, mode, out));
            }
            assertEq("closure: ILLEGAL-EXPRESSION\n"
                "nested closure: ILLEGAL-EXPRESSION\n"
                "mask: restricted\n"
                "nested mask: restricted\n"
                "index: 3\n", runChild(script, mode, "probe", "restricted"), "probe, mode " + mode);
        }
    }

    openTest() {
        TmpDir tmp("qore-bg-runtime-po-");
        string script = tmp.path + "/child.q";
        write(script, ChildScript);
        foreach string mode in (Modes) {
            assertEq("expr: printed\n", runChild(script, mode, "expr", "open"), "expr, mode " + mode);
            assertEq("nested expr: printed\n", runChild(script, mode, "nested-expr", "open"),
                "nested expr, mode " + mode);
            assertEq("closure: printed\n"
                "nested closure: printed\n"
                "mask: unrestricted\n"
                "nested mask: unrestricted\n"
                "index: 3\n", runChild(script, mode, "probe", "open"), "probe, mode " + mode);
        }
    }

    moduleTest() {
        TmpDir src("qore-bg-runtime-po-src-");
        write(src.path + "/BgRuntimeOpts.qm", ModuleSource);
        TmpDir aot("qore-bg-runtime-po-qmod-");
        write(aot.path + "/BgRuntimeOpts.qm", ModuleSource);
        string out = backquote(sprintf("%s QORE_MODULE_DIR=%s %s -b --compile-module --strip-source --output "
            "%s/BgRuntimeOpts.qmod %s/BgRuntimeOpts.qm 2>&1", env(), aot.path, qore_bin, aot.path, aot.path));
        assertTrue(is_file(aot.path + "/BgRuntimeOpts.qmod"), "compiled the module: " + out);
        # the compiled module only: the source would be loaded in its place if the qmod could not be
        unlink(aot.path + "/BgRuntimeOpts.qm");

        TmpDir run_dir("qore-bg-runtime-po-run-");
        string modern = run_dir.path + "/modern.q";
        string restricted = run_dir.path + "/restricted.q";
        string sandboxed = run_dir.path + "/sandboxed.q";
        write(modern, ModernImporter);
        write(restricted, RestrictedImporter);
        write(sandboxed, SandboxedCaller);
        foreach hash<auto> dir in (("source": src.path, "qmod": aot.path).pairIterator()) {
            foreach string mode in (Modes) {
                assertEq("[True, 3, True]\n", backquote(sprintf("%s QORE_MODULE_DIR=%s %s -b --exec-mode=%s %s 2>&1",
                    env(), dir.value, qore_bin, mode, modern)), sprintf("%s module, mode %s", dir.key, mode));
                out = backquote(sprintf("%s QORE_MODULE_DIR=%s %s -b --exec-mode=%s %s %s 2>&1", env(), dir.value,
                    qore_bin, mode, restricted, mode));
                assertRegex("ILLEGAL-EXPRESSION", out, sprintf("%s module, restricted caller, mode %s", dir.key,
                    mode));
                assertFalse(out =~ /printed/, sprintf("%s module, restricted caller, mode %s: %s", dir.key, mode,
                    out));
                foreach string how in (("bg", "pool")) {
                    out = backquote(sprintf("%s QORE_MODULE_DIR=%s %s -b --exec-mode=%s %s %s sandboxed %s 2>&1",
                        env(), dir.value, qore_bin, mode, sandboxed, mode, how));
                    # the module code and its thread run with the restriction of the sandboxed caller: refused by
                    # the runtime options, before the caller rule (qore#7140)
                    assertRegex("ILLEGAL-EXPRESSION: File::print\\(\\) cannot be called with a system constant "
                        "object when 'no-terminal-io' is set", out, sprintf("%s module %s, sandboxed caller, mode %s",
                        dir.key, how, mode));
                    assertFalse(out =~ /printed/, sprintf("%s module %s, sandboxed caller, mode %s: %s", dir.key, how,
                        mode, out));
                    # the caller is restricted from terminal I/O: the module code's thread does not print for it,
                    # with or without a sandbox (qore#7140)
                    out = backquote(sprintf("%s QORE_MODULE_DIR=%s %s -b --exec-mode=%s %s %s open %s 2>&1", env(),
                        dir.value, qore_bin, mode, sandboxed, mode, how));
                    assertRegex("ILLEGAL-EXPRESSION: File::print\\(\\) cannot be called for code that is restricted "
                        "from terminal I/O", out, sprintf("%s module %s, caller without a sandbox, mode %s", dir.key,
                        how, mode));
                    assertFalse(out =~ /printed/, sprintf("%s module %s, caller without a sandbox, mode %s: %s",
                        dir.key, how, mode, out));
                    # the caller rule covers terminal I/O only: a caller without a sandbox that is restricted from
                    # another domain does not stop the module code's thread from printing
                    assertEq("module: printed\n", backquote(sprintf("%s QORE_MODULE_DIR=%s %s -b --exec-mode=%s %s "
                        "%s nofs %s 2>&1", env(), dir.value, qore_bin, mode, sandboxed, mode, how)),
                        sprintf("%s module %s, caller restricted from the file system, mode %s", dir.key, how,
                        mode));
                }
            }
        }
    }

    callbackTest() {
        TmpDir tmp("qore-bg-runtime-po-cb-");
        string script = tmp.path + "/cb.q";
        write(script, CallbackScript);
        list<string> cases = ("pool", "async", "exit_hook");
        # signals: the order of pending signals is the lowest first on Linux
        if (PlatformOS == "Linux") {
            cases += "signal";
        }
        foreach string case_name in (cases) {
            # signal handling is enabled: no -b
            string out = backquote(sprintf("%s %s %s %s restricted 2>&1", env(), qore_bin, script, case_name));
            assertRegex("ILLEGAL-EXPRESSION", out, case_name + " restricted: " + out);
            out = backquote(sprintf("%s %s %s %s open 2>&1", env(), qore_bin, script, case_name));
            assertRegex(case_name + ": " + (case_name == "async" ? "allowed" : "done") + "\n$", out,
                case_name + " open: " + out);
            assertFalse(out =~ /ILLEGAL-EXPRESSION/, case_name + " open: " + out);
        }
    }

    exeTest() {
        TmpDir tmp("qore-bg-runtime-po-exe-");
        string script = tmp.path + "/bg.q";
        write(script, ExeSource);
        foreach string mode in (Modes) {
            assertEq("[True, 3, True]\n", backquote(sprintf("%s %s -b --exec-mode=%s %s 2>&1", env(), qore_bin, mode,
                script)), "interpreted, mode " + mode);
        }
        if (!qcc_bin.val() || !is_file(qcc_bin)) {
            testSkip("qcc is unavailable");
        }
        foreach string opt in (("-O0", "-O3")) {
            string exe = tmp.path + "/bg" + opt;
            string out = backquote(sprintf("%s %s %s -o %s %s 2>&1", env(), qcc_bin, opt, exe, script));
            assertTrue(is_file(exe), "built the executable " + opt + ": " + out);
            assertEq("[True, 3, True]\n", backquote(sprintf("%s %s 2>&1", env(), exe)), "executable " + opt);
        }
    }
}
