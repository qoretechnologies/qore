#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class Test

class BGTest {
    int add(int arg) {
        return arg;
    }
}

class StaleSelfCaptureTest {
    private {
        string value;
        *Queue queue;
    }

    constructor(string v, *Queue q = NOTHING) {
        value = v;
        queue = q;
    }

    code<string()> getSyncClosure() {
        return string sub () {
            return value;
        };
    }

    code<string()> getIndependentClosure(string local_value) {
        return string sub () {
            return local_value;
        };
    }

    code<nothing()> getBackgroundClosure() {
        return sub () {
            queue.push(value);
        };
    }

    runInlineBackground() {
        background sub () {
            queue.push(value);
        }();
    }
}

# runs a call reference in a new thread; nothing here names the object
sub run_call_ref(code<string()> c, Queue gate, Queue result) {
    gate.get();
    try {
        result.push(c());
    } catch (hash<ExceptionInfo> ex) {
        result.push(ex.err);
    }
}

# an object that starts a thread on itself from its own constructor
class BgLifetimeCtor {
    private {
        string value;
    }

    constructor(string v, Queue gate, Queue result) {
        value = v;
        # a self call takes a real reference on the object for the duration of the thread
        background work(gate, result);
    }

    private work(Queue gate, Queue result) {
        # the caller has dropped its last reference by the time the gate is released
        gate.get();
        try {
            result.push(value);
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex.err);
        }
    }
}

# an object reached by the new thread only through a call reference
class BgLifetimeCallRef {
    private {
        string value;
    }

    constructor(string v) {
        value = v;
    }

    string get() {
        return value;
    }

    # a call reference binds its object weakly, so this does not prolong the object's lifetime
    startViaCallRef(Queue gate, Queue result) {
        code<string()> c = \get();
        background run_call_ref(c, gate, result);
    }

    # a self call does prolong it, for the same object and the same member access
    startViaSelfCall(Queue gate, Queue result) {
        background work(gate, result);
    }

    private work(Queue gate, Queue result) {
        gate.get();
        try {
            result.push(value);
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex.err);
        }
    }
}

# signals when the thread is inside the method so the object can be deleted underneath it
class BgLifetimeDelete {
    private {
        string value;
    }

    constructor(string v) {
        value = v;
    }

    work(Queue started, Queue gate, Queue result) {
        started.push(True);
        gate.get();
        try {
            result.push(value);
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex.err);
        }
    }
}

class Test inherits QUnit::Test {
    public {
        BGTest test();

        const Code = "
%exec-class T

class T {
    constructor() { background $.method(); }
    method() {}
}
";

        const ThreadName = "my-thread";
    }

    constructor() : QUnit::Test("background", "1.0", \ARGV) {
        addTestCase("background operator tests", \basicTests());
        addTestCase("issue 1467", \issue1467());
        addTestCase("issue 2637", \issue2637());
        addTestCase("issue 2679", \issue2679());
        addTestCase("issue 2653", \issue2653());
        addTestCase("issue 2701", \issue2701());
        addTestCase("issue 2444", \issue2444());
        addTestCase("stale self capture", \staleSelfCapture());
        addTestCase("background object lifetime", \backgroundObjectLifetime());
        set_return_value(main());
    }

    issue2653() {
        background test.add(1);
    }

    issue1467() {
        Program p();
        p.parse(Code, "issue 1467");
        assertEq(NOTHING, p.run());
    }

    issue2637() {
        assertEq(1, issue2637_1(1));
    }

    private int issue2637_1(int a1) {
        Counter c(1);
        background issue2637_2(c, ("a": a1));
        c.waitForZero();
        return a1;
    }

    private auto issue2637_2(Counter c, hash<auto> h) {
        c.dec();
    }

    issue2679() {
        # causes a crash with #2279
        Program p(PO_NEW_STYLE);
        p.parse("background (sprintf(\"A\"), sprintf(\"B\"));", "", WARN_RETURN_VALUE_IGNORED);
        assertTrue(True);
    }

    basicTests() {
        Counter cnt();
        int i = 0;

        code c = sub () {
            delete i;
            cnt.dec();
        };

        cnt.inc();
        testNullAssertion("delete local var in background", c);
        cnt.waitForZero();

        c = sub () {
            remove i;
            cnt.dec();
        };

        cnt.inc();
        testNullAssertion("remove local var in background", c);
        cnt.waitForZero();

        # do negative tests
        c = sub () {
            Program p(PO_NEW_STYLE);
            p.parse("int i;background (i *= 10); #1
            background (i /= 10); #2
            background (i -= 10); #3
            background (i += 10); #4
            background (i %= 10); #5
            background (i >>= 10); #6
            background (i <<= 10); #7
            background ++i; #8
            background i++; #9
            background --i; #10
            background i--; #11
            string str;
            background splice str, 0; #12
            background extract str, 0; #13", "bg");
        };

        *hash<auto> ex = testAssertion("background negative test", c, NOTHING, new TestResultExceptionType("PARSE-EXCEPTION"));

        # count exceptions
        while (ex) {
            ++i;
            ex = ex.next;
        }
        testAssertionValue("background negative count", i, 13);

        cnt.inc();
        testAssertion("create closure with bound local var in background exp", sub () {Test::f1(cnt);}, NOTHING, new TestResultValue());
        cnt.waitForZero();

        cnt.inc();
        testAssertion("create complex closure in background exp", sub () {Test::f2(cnt);}, NOTHING, new TestResultValue());
        cnt.waitForZero();
    }

    issue2701() {
        if (!HAVE_MANAGE_STACK) {
            testSkip("cannot manage the stack");
        }

        int size = get_default_thread_stack_size();
        #printf("size: %d\n", size);
        assertGt(0, size);
        int orig_size = size;
        size = set_default_thread_stack_size(size * 2);
        assertEq(orig_size * 2, size);
        if (HAVE_GET_STACK_SIZE) {
            Queue q();
            background checkStackSize(q);
            # issue #2701: the actual stack size assigned may be larger than requested
            assertGe(size, q.get());
        }
    }

    issue2444() {
        if (!HAVE_THREAD_NAME) {
            testSkip("no thread names available");
        }
        assertEq("qore/" + gettid(), get_thread_name());
        set_thread_name(ThreadName);
        assertEq(ThreadName, get_thread_name());
    }

    staleSelfCapture() {
        code sync_closure;
        {
            StaleSelfCaptureTest t("sync");
            sync_closure = t.getSyncClosure();
        }

        assertThrows("OBJECT-ALREADY-DELETED",
            "closure invocation failed because captured 'self' \\(class 'StaleSelfCaptureTest'\\) has already been destroyed",
            sync_closure);

        code independent_closure;
        {
            StaleSelfCaptureTest t("unused");
            independent_closure = t.getIndependentClosure("local");
        }

        assertEq("local", independent_closure());

        code bg_closure;
        Queue q();
        {
            StaleSelfCaptureTest t("background", q);
            bg_closure = t.getBackgroundClosure();
        }

        assertThrows("BACKGROUND-CLOSURE-INVALID-CAPTURE",
            "background closure captured 'self' of class 'StaleSelfCaptureTest' "
            "which has already been destroyed or is being destroyed",
            sub () {
                background bg_closure();
            });

        assertThrows("QUEUE-TIMEOUT", sub () {
            q.get(-1);
        });

        Queue inline_q();
        {
            StaleSelfCaptureTest t("inline", inline_q);
            t.runInlineBackground();
        }

        assertEq("inline", inline_q.get(5s));
    }

    # see design/qore-language-traps.md trap 16 and @ref background_object_lifetime
    backgroundObjectLifetime() {
        # a background self call from a constructor keeps an otherwise unreferenced object alive
        {
            Queue gate();
            Queue result();
            # the object is not retained anywhere: it is released when this statement completes
            new BgLifetimeCtor("ctor", gate, result);
            gate.push(True);
            assertEq("ctor", result.get(5s));
        }

        # a background self call from a method keeps an otherwise unreferenced object alive
        {
            Queue gate();
            Queue result();
            (new BgLifetimeCallRef("self-call")).startViaSelfCall(gate, result);
            gate.push(True);
            assertEq("self-call", result.get(5s));
        }

        # a method call on an object expression keeps the object alive after it leaves scope
        {
            Queue gate();
            Queue result();
            {
                BgLifetimeDelete obj("obj-expr");
                Queue started();
                background obj.work(started, gate, result);
                assertTrue(started.get(5s));
            }
            gate.push(True);
            assertEq("obj-expr", result.get(5s));
        }

        # a call reference does NOT prolong the object's lifetime
        {
            Queue gate();
            Queue result();
            (new BgLifetimeCallRef("call-ref")).startViaCallRef(gate, result);
            gate.push(True);
            assertEq("OBJECT-ALREADY-DELETED", result.get(5s));
        }

        # the same call reference works while an ordinary reference to the object is held
        {
            Queue gate();
            Queue result();
            BgLifetimeCallRef obj("call-ref-live");
            code<string()> c = \obj.get();
            background run_call_ref(c, gate, result);
            gate.push(True);
            assertEq("call-ref-live", result.get(5s));
        }

        # delete is unconditional: it is not deferred by a running background thread
        {
            Queue started();
            Queue gate();
            Queue result();
            BgLifetimeDelete obj("deleted");
            background obj.work(started, gate, result);
            assertTrue(started.get(5s));
            delete obj;
            gate.push(True);
            assertEq("OBJECT-ALREADY-DELETED", result.get(5s));
        }
    }

    private static checkStackSize(Queue q) {
        q.push(get_stack_size());
    }

    static any f1(Counter cnt) {
        int a = 8;
        background sub () {++a; cnt.dec();}();
    }

    static any f2(Counter cnt) {
        int a = 8;
        background sub () {++a; sub() {++a; cnt.dec();}();}();
    }
}
