#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - thread stack sizes and the static TLS that the C library takes from them, stack limits
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class SmallThreadStackTest

#! A foreign thread with a 224KB stack has that stack for its own use, and parses and runs ordinary code there
/** glibc takes the static TLS block of the process from the stack of every thread, so libqore's static
    \c thread_local buffers (about 58KB of QUIC batch buffers and the \c channel_select() generator) took that much
    from every thread's stack.  The fixture creates a thread with a 224KB stack, checks that no more than 24KB of it
    is used before the thread's entry point, and parses code there that loads a module and uses classes, hashdecls,
    closures, sorting, a regular expression and formatting, and runs it, in AST, IR, JIT and tiered modes; runaway
    recursion there must raise STACK-LIMIT-EXCEEDED, and the thread must run code again afterwards.
*/
public class SmallThreadStackTest inherits QUnit::Test {
    constructor() : Test("SmallThreadStackTest", "1.0") {
        addTestCase("224KB foreign thread", \check());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private check() {
        if (!Option::HAVE_STACK_GUARD) {
            testSkip("runtime built without native stack protection");
        }
        string root = realpath(get_script_dir() + "/../../../..");
        string libdir = realpath(ENV.QORE_LIBDIR ?? root + "/build");
        TmpDir dir("qore-small-thread-stack-");
        string exe = dir.path + "/small-thread-stack";
        list<string> args = (ENV.CXX ?? "c++", "-std=c++17", "-pthread", "-g", "-O2", "-I" + root + "/include",
            "-I" + libdir + "/include", get_script_dir() + "/small_thread_stack.cpp", "-L" + libdir,
            "-Wl,-rpath," + libdir, "-lqore", "-o", exe);
        *list<*string> target = (Qore::CFLAGS =~ x/(-mmacosx-version-min=\S+)/);
        if (target) {
            push args, target[0];
        }
        int status;
        string output = backquote((map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        output = backquote("LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_MODULE_DIR="
            # the fixture's code loads Util, whose binary module dependencies may be found only in the caller's
            # module path (as in CI, where they are built in the tree, not installed)
            + quote(root + "/qlib" + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : ""))
            + " " + quote(exe) + " 2>&1", \status);
        assertEq(0, status, output);
        assertEq("small-thread-stack: ok\n", output);
    }
}
