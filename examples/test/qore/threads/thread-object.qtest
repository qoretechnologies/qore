#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-weak-references

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class ThreadObjectTest

sub threadObjectDump(int sig) {
    printf("=== THREAD_OBJECT_DUMP signal=%d pid=%d num_threads=%d thread_list=%Y ===\n",
        sig, getpid(), num_threads(), thread_list());
    printf("thread_stacks=%Y\n", get_all_thread_call_stacks());
    printf("=== END THREAD_OBJECT_DUMP ===\n");
    flush();
}

# this class implements a background thread that does not extend the scope of the object
# and is shut down cleanly when the object goes out of scope - this allows objects
# to have a natural scope and also a service thread that's managed with the natural
# lifecycle of the object
class TransparentObjectThreadTest {
    private:internal {
        Counter end(1);
        bool stop;
        int sleep_us;
    }

    constructor(int nsleep_us = 50000) {
        sleep_us = nsleep_us;
        # we have to let the test method dereference the object before finishing the method
        # otherwise there is a race condition where the destructor is run in the background
        # thread and will wait on the end counter before it can be decremented
        Counter start(1);
        background test(self, start);
        start.waitForZero();
    }

    destructor() {
        stop = True;
        end.waitForZero();
    }

    static test(TransparentObjectThreadTest t, Counter start) {
        # let the object go out of scope naturally
        TransparentObjectThreadTest self := t;
        remove t;
        # signal the constructor to continue
        start.dec();
        # signal the object's end counter when done
        on_exit self.end.dec();

        # loop until we are signaled to stop
        while (!self.stop) {
            usleep(self.sleep_us);
        }
    }
}

#! Object whose method another thread calls through a weak call reference during teardown
/** An object's members are destroyed only after its destructor returns; a method
    call that another thread makes through a weak reference once the destructor
    has started is refused with \c OBJECT-ALREADY-DELETED, so it cannot hold a
    member @ref Qore::Thread::Mutex "Mutex" when the member cleanup deletes it
    (issue #7509; before, the call entered the object, and the cleanup raised
    \c LOCK-ERROR in the thread dropping the object unless the lock object was
    pinned in a local for the life of the call).

    The counters make the interleaving deterministic: the worker calls the method
    only after teardown has started, and the destructor returns only once the
    worker's call has been made (it decrements \c locked if it enters the
    object and takes the lock, the worker does otherwise).
*/
class MemberLockLifetimeHolder {
    public {
        Mutex m();
        bool pin;
        Counter in_destructor;
        Counter locked;
        Counter release;
    }

    constructor(bool pin_lock, Counter in_destructor, Counter locked, Counter release) {
        pin = pin_lock;
        self.in_destructor = in_destructor;
        self.locked = locked;
        self.release = release;
    }

    #! returns a weak method call reference, as async APIs hand to I/O controllers
    code<nothing()> getCallback() {
        return \work();
    }

    destructor() {
        # let the worker call the method now that teardown has begun
        in_destructor.dec();
        # return (and destroy the members) only once the worker's call has been made
        locked.waitForZero();
    }

    private work() {
        if (pin) {
            # pin the lock object in a local so the member cleanup cannot delete
            # it while it is held
            Mutex m_pin = m;
            AutoLock al(m);
            locked.dec();
            release.waitForZero();
        } else {
            AutoLock al(m);
            locked.dec();
            release.waitForZero();
        }
    }
}

class ThreadObjectTest inherits QUnit::Test {
    private {
        int threads;
        int iters;
    }
    constructor() : QUnit::Test("Thread object test", "1.0") {
        addTestCase("Test Counter", \testCounter());
        addTestCase("Test Queue", \testQueue());
        addTestCase("Test Thread", \testThread());
        addTestCase("Test TransparentObjectThreadTest", \transparentObjectThreadTest());
        addTestCase("Test TransparentObjectThreadTest JIT cleanup", \transparentObjectThreadJitCleanupTest());
        addTestCase("Test member lock lifetime in teardown", \memberLockLifetimeTest());
        set_return_value(main());
    }

    globalSetUp() {
        if (getenv("QORE_THREAD_OBJECT_DUMP_ON_SIGNAL")) {
            set_signal_handler(SIGUSR1, \threadObjectDump());
        }

        threads = 5;
        iters = 2000;
    }

    testCounter() {
        new CounterTest(threads, iters, self);
    }

    testQueue() {
        new QueueTest(threads, iters, self);
    }

    testThread() {
        new ThreadTest(threads, iters, self);
    }

    transparentObjectThreadTest() {
        TransparentObjectThreadTest t();
        assertTrue(True);
    }

    transparentObjectThreadJitCleanupTest() {
        for (int i = 0; i < 1000; ++i) {
            TransparentObjectThreadTest t(1000);
        }
        assertTrue(True);
    }

    #! Calling a method of an object through a weak call reference while its destructor runs
    /** The call is refused with \c OBJECT-ALREADY-DELETED, with or without a
        local pin on the lock object, so the member cleanup that follows the
        destructor never deletes the @ref Qore::Thread::Mutex "Mutex" while the
        worker holds it (issue #7509).

        This is the mechanism behind async APIs that hand weak method call
        references to an I/O controller (e.g.
        @ref HttpClientStreamingIo::SseObservable "SseObservable"): the controller
        does not keep the object alive, so its own I/O thread can call into the
        object while the owner tears it down.
    */
    memberLockLifetimeTest() {
        assertEq("OBJECT-ALREADY-DELETED", runMemberLockTeardown(False), "unpinned member lock");
        assertEq("OBJECT-ALREADY-DELETED", runMemberLockTeardown(True), "pinned member lock");
    }

    #! Drops the object while a worker thread calls its method through a weak call reference
    /** @return the error of the worker's call, or \c "entered" if the call entered the object
    */
    private string runMemberLockTeardown(bool pin) {
        Counter in_destructor(1);
        Counter locked(1);
        Counter release(1);
        Counter finished(1);
        code<nothing()> cb;
        string rv;
        on_exit {
            # let the worker release the lock and reap it in all cases; only this
            # thread ever decrements the counter, so it is still 1 here
            release.dec();
            finished.waitForZero();
        }
        {
            MemberLockLifetimeHolder h(pin, in_destructor, locked, release);
            # weak method call reference: it does not keep the object alive
            cb = h.getCallback();
            background sub () {
                on_exit finished.dec();
                # enter the object only after its teardown has started
                in_destructor.waitForZero();
                try {
                    cb();
                    rv = "entered";
                } catch (hash<ExceptionInfo> ex) {
                    rv = ex.err;
                    # the call did not enter the object: the destructor can return
                    locked.dec();
                }
            }();
            # scope exit drops the last strong reference: the destructor runs and
            # the member cleanup that follows deletes the lock
        }
        # the worker has made its call when the destructor returns, and has set rv before
        finished.waitForZero();
        return rv;
    }
}

class CounterTest {
    private {
        int threads;
        int iters;
        any obj;
        Counter c();
    }
    constructor(int nthreads, int niters, ThreadObjectTest t) {
        threads = nthreads;
        iters = niters;
        obj.key.500.hello = 0;

        do_threads();
        c.waitForZero();
        t.assertTrue(!obj.key.500.hello, "counter");
    }

    private do_threads() {
        while (threads--) {
            c.inc();
            background add();
            c.inc();
            background subtract();
        }
    }

    private add() {
        for (int i = 0; i < iters; i++)
            obj.key.500.hello++;
        c.dec();
    }

    private subtract() {
        for (int i = 0; i < iters; i++)
            obj.key.500.hello--;
        c.dec();
    }
}

class QueueTest {
    private {
        Queue q();
        Counter x();
    }
    constructor(int nthreads, int niters, ThreadObjectTest t) {
        for (int i; i < nthreads; i++) {
            x.inc();
            background qt(niters);
        }
        int c = nthreads * niters;
        while (c--)
            if (rand() % 2)
                q.pop();
            else
                q.get();

        x.waitForZero();
        t.assertTrue(!q.size(), "queue");
    }

    private qt(int niters) {
        for (int i; i < niters; i++)
            q.push(sprintf("tid-%d-%d", gettid(), i));
        x.dec();
    }
}

my int thread_tid;

class ThreadTest inherits Mutex {
    private {
        hash data;
        int threads;
        int iters;

        RWLock drw();
        Gate g();
        Counter c();

        hash gdata;
        hash rwdata;
    }
    constructor(int nthreads, int niters, ThreadObjectTest t) {
        threads = nthreads;
        iters = niters;
        while (threads) {
            c.inc();
            background worker();
            threads--;
        }
        #sleep(1);
        #printf("num_threads:%y\nthread_list:%y\ngettid:%y\n", num_threads(), thread_list(), gettid());
        #printf("get_all_thread_data:%N\nget_all_thread_call_stacks:%N\n", get_all_thread_data(), get_all_thread_call_stacks());
        c.waitForZero();
        t.assertTrue(True, "thread object tests");
    }
    *hash getData(list l) {
        lock();
        on_exit unlock();
        return data{l};
    }
    setData(hash h) {
        lock();
        on_exit unlock();
        data += h;
    }
    *hash getRWData(list l) {
        drw.readLock();
        on_exit
            drw.readUnlock();
        return rwdata{l};
    }
    setRWData(hash h) {
        drw.writeLock();
        on_exit
            drw.writeUnlock();
        rwdata += h;
    }
    *hash getGateData(list l) {
        g.enter();
        on_exit g.exit();
        return gdata{l};
    }
    setGateData(hash h) {
        g.enter();
        on_exit g.exit();
        gdata+= h;
    }
    worker() {
        thread_tid = gettid();
        #printf("worker start:%y, var:%y\n", gettid(), thread_tid);
        for (int i = 0; i < iters; i++) {
            #if (!(i % 1000))
            #    printf("TID %3d: %d/%d\n", gettid(), i, iters);
            int c = rand() % 6;
            string key1 = sprintf("key%d", rand() % 10);
            string key2 = sprintf("key%d", (rand() % 10) + 10);
            string key3 = sprintf("key%d", rand() % 20);
            if (!c) {
                hash h = (
                    key1: rand() % 10,
                    key2: rand() % 10,
                    );
                setData(h);
                continue;
            }
            if (c == 1) {
                getData((key1, key2, key3));
                continue;
            }
            if (c == 2) {
                hash h = (
                    key1: rand() % 10,
                    key2: rand() % 10,
                    );
                setRWData(h);
                continue;
            }
            if (c == 3) {
                getRWData((key1, key2, key3));
                continue;
            }
            if (c == 4) {
                hash h = (
                    key1: rand() % 10,
                    key2: rand() % 10,
                    );
                setGateData(h);
                continue;
            }
            if (c == 5) {
                getGateData((key1, key2, key3));
                continue;
            }
        }
        /*
        printf("worker sleep:%y\n", gettid());
        sleep(3);
        */
        c.dec();
        /*
        printf("worker end:%y, var:%y\n", gettid(), thread_tid);
        printf("get_all_thread_data():%y\n", get_all_thread_data());
        */
    }
}
