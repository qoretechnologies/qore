#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class CancelWakeupTest

#! A blocked wait ends as soon as cancellation is requested, without a periodic timeout
/** The worker blocks a thread in each kind of wait that only a cancellation can end, makes the request once the
    thread is blocked in the wait (dbg_wait_for_cancellable_wait()), and reports, for each of three trials, how the
    wait ended.  Before blocking waits were woken by the request, they noticed it at a periodic cancellation check:
    every 500 ms for I/O, lock and condition waits, and every 100 ms for sleep() and usleep().

    In debug builds each case checks which path ended the wait, with no timing: the request woke the wait exactly
    once through the thread's registered condition or wakeup channel (dbg_get_cancel_wake_count()), and the waiting
    thread made only a few cancellation checks (dbg_get_cancel_check_count()), so the wait did not poll.  Every build
    checks the order of events: the wait ends with the cancellation exception and nothing else, the child process
    never writes to its output, and a condition wait ends with its lock held again.
*/
class CancelWakeupTest inherits QUnit::Test {
    public {
        #! the most cancellation checks that the waiting thread may make during a woken call
        /** A woken wait checks before and after it registers and once after it wakes, and the code around it a fixed
            number of times more, which depends on the execution mode (a condition wait makes 6 in AST mode, 19 in IR
            mode under the harness), not on time; a wait that polled would check at every interval for as long as it
            was blocked.
        */
        const MaxChecks = 32;

        #! cases with their expected exception and detail; the wake path is not checked for those with a detail
        const Special = {
            "interrupted backquote read": {"err": "PROGRAM-INTERRUPTED"},
            "deferred backquote read": {"err": "THREAD-CANCELLED", "detail": "\"done\""},
            "wait after cleared cancel": {"err": "AFTER-CLEAR", "detail": "True"},
        };

        #! every case the worker runs
        const Cases = (
            "pipe read", "backquote read", "system wait", "stream pipe read", "socket read", "tls socket read",
            "sleep", "usleep", "mutex lock", "mutex lock timeout", "auto lock", "read lock", "read lock timeout",
            "write lock", "write lock timeout", "gate enter", "gate enter timeout", "condition wait", "counter wait",
            "queue get", "auto semaphore", "channel select", "channel select timeout", "datasource lock",
            "interrupted backquote read", "deferred backquote read", "wait after cleared cancel",
        );
    }

    constructor() : Test("CancelWakeupTest", "1.0") {
        addTestCase("blocked waits wake on cancellation", \wakeTest());
        set_return_value(main());
    }

    wakeTest() {
        if (PlatformOS == "Windows") {
            testSkip("requires POSIX processes and FIFOs");
        }
        string qore = ENV.QORE_BINARY ?? QORE_ARGV[0];
        string worker = get_script_dir() + "/cancel-wakeup-worker.q";
        string pem = get_script_dir() + "/../../classes/HTTPClient/h2-proxy-handoff/localhost.pem";
        foreach string mode in (ExecModeHarness::ExecModes) {
            TmpDir tmp("cancel-wakeup");
            string out = ExecModeHarness::run(sprintf("'%s' --exec-mode=%s '%s' '%s' '%s'", qore, mode, worker,
                tmp.path, pem), ExecModeHarness::NativeCheck::Jit);
            checkOutput(mode, out);
        }
    }

    private checkOutput(string mode, string out) {
        hash<string, list<string>> results;
        foreach string line in (out.split("\n")) {
            if (!line.val()) {
                continue;
            }
            list<string> l = line.split("|");
            # an empty detail at the end of the line is not returned by split()
            if (l.size() == 4) {
                l += "";
            }
            if (l.size() != 5) {
                fail(sprintf("%s: unexpected output line %y", mode, line));
            }
            results{l[0]} = l;
        }
        foreach string name in (Cases) {
            string label = sprintf("%s: %s", mode, name);
            *list<string> l = results{name};
            if (!l) {
                fail(sprintf("%s: no result; output: %y", label, out));
            }
            # the dbitest driver is built with the library; a build without it cannot run the case
            if (name == "datasource lock" && l[1] == "SKIP") {
                continue;
            }
            *hash<auto> special = Special{name};
            assertEq(special.err ?? "THREAD-CANCELLED", l[1], label + ": exception");
            if (special.detail) {
                assertEq(special.detail, l[4], label + ": detail");
                continue;
            }
            if (!Option::HAVE_LIBRARY_DEBUGGING) {
                continue;
            }
            # each trial's request woke the wait once, through its registered condition or wakeup channel
            assertEq("1/1/1", l[2], label + ": the request woke the wait once in each trial");
            int checks = l[3].toInt();
            assertTrue(checks >= 0 && checks <= MaxChecks, sprintf("%s: %d cancellation checks during the call "
                "(at most %d: the wait did not poll)", label, checks, MaxChecks));
        }
    }
}
