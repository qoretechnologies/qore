#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/QUnit.qm

%exec-class DeadlockTest

class Base {
    private {
        bool dl; # deadlock flag

        static bool sdl; # static deadlock flag
    }
}

class D1 inherits Base {
    synchronized m(Test t, D2 d, *Counter c) {
        if (c) {
            c.dec();
            c.waitForZero();
        }
        if (dl)
            return;
        try {
            return d.m(t, self);
        } catch (hash<ExceptionInfo> ex) {
            t.assertEq("THREAD-DEADLOCK", ex.err, "mutex-deadlock");
            dl = True;
        }
    }

    static synchronized sm(Test t, *Counter c) {
        if (c) {
            c.dec();
            c.waitForZero();
        }
        if (sdl)
            return;
        try {
            return D2::sm(t);
        } catch (hash<ExceptionInfo> ex) {
            t.assertEq("THREAD-DEADLOCK", ex.err, "mutex-deadlock");
            sdl = True;
        }
    }
}

class D2 inherits Base {
    synchronized m(Test t, D1 d, *Counter c) {
        if (c) {
            c.dec();
            c.waitForZero();
        }
        if (dl)
            return;
        try {
            return d.m(t, self);
        } catch (hash<ExceptionInfo> ex) {
            t.assertEq("THREAD-DEADLOCK", ex.err, "mutex-deadlock");
            dl = True;
        }
    }

    static synchronized sm(Test t, *Counter c) {
        if (c) {
            c.dec();
            c.waitForZero();
        }
        if (sdl)
            return;
        try {
            return D1::sm(t);
        } catch (hash<ExceptionInfo> ex) {
            t.assertEq("THREAD-DEADLOCK", ex.err, "mutex-deadlock");
            sdl = True;
        }
    }
}

our bool dl;

synchronized sub internal_deadlock_a(Test t, *Counter c) {
    if (c) {
        c.dec();
        c.waitForZero();
    }
    if (dl)
        return;
    try {
        return internal_deadlock_b(t);
    } catch (hash<ExceptionInfo> ex) {
        t.assertEq("THREAD-DEADLOCK", ex.err, "mutex-deadlock");
        dl = True;
    }
}

synchronized sub internal_deadlock_b(Test t, *Counter c) {
    if (c) {
        c.dec();
        c.waitForZero();
    }
    if (dl)
        return;
    try {
        return internal_deadlock_a(t);
    } catch (hash<ExceptionInfo> ex) {
        t.assertEq("THREAD-DEADLOCK", ex.err, "mutex-deadlock");
        dl = True;
    }
}

class DeadlockTest inherits QUnit::Test {
    constructor() : QUnit::Test("Deadlock test", "1.0") {
        addTestCase("issue 2817", \issue2817());
        addTestCase("sub-millisecond timeout", \subMillisecondTimeout());
        addTestCase("Test deadlocks", \testDeadlocks());
        set_return_value(main());
    }

    globalSetUp() {
        dl = False;
    }

    issue2817() {
        RWLock l();
        Condition c();
        Counter cnt(1);
        code waiter = sub () {
            l.readLock();
            l.readLock();
            cnt.dec();
            on_exit {l.readUnlock(); l.readUnlock();}
            c.wait(l);
        };
        background waiter();
        cnt.waitForZero();
        l.writeLock();
        on_exit l.writeUnlock();
        c.broadcast();
        assertTrue(True);
    }

    subMillisecondTimeout() {
        Mutex m();
        Condition cond();
        m.lock();
        on_exit m.unlock();

        # sub-millisecond timeout must not block indefinitely
        # (previously truncated to 0ms, which is the "indefinite wait" sentinel)
        int rc = cond.wait(m, 500us);
        assertEq(ETIMEDOUT, rc, "sub-ms timeout (500us)");

        # sanity baseline: 1ms timeout
        rc = cond.wait(m, 1ms);
        assertEq(ETIMEDOUT, rc, "1ms timeout baseline");

        # 999us should also not block
        rc = cond.wait(m, 999us);
        assertEq(ETIMEDOUT, rc, "sub-ms timeout (999us)");
    }

    mutex_gate_deadlock_a(Counter c, Mutex m, Gate g) {
        AutoLock al(m);
        c.dec();
        c.waitForZero();
        try {
            g.enter();
            g.exit();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("THREAD-DEADLOCK", ex.err, "gate-deadlock");
        }
    }

    mutex_gate_deadlock_b(Counter c, Mutex m, Gate g) {
        AutoGate ag(g);
        c.dec();
        c.waitForZero();
        try {
            m.lock();
            m.unlock();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("THREAD-DEADLOCK", ex.err, "gate-deadlock");
        }
    }

    readwrite_deadlock_c(Counter c, RWLock rw1, RWLock rw2) {
        AutoWriteLock al(rw1);
        c.dec();
        c.waitForZero();
        try {
            rw2.writeLock();
            rw2.writeUnlock();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("THREAD-DEADLOCK", ex.err, "rwl-deadlock-c");
        }
    }

    readwrite_deadlock_d(Counter c, RWLock rw1, RWLock rw2) {
        AutoReadLock al(rw2);
        c.dec();
        c.waitForZero();
        try {
            rw1.readLock();
            rw1.readUnlock();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("THREAD-DEADLOCK", ex.err, "rwl-deadlock-d");
        }
    }

    test_thread_resources() {
        Mutex m();
        m.lock();

        assertThrows('LOCK-ERROR', "terminated while holding", sub () {throw_thread_resource_exceptions();});

        Gate g();
        g.enter();
        assertThrows('LOCK-ERROR', "terminated while holding", sub () {throw_thread_resource_exceptions();});

        RWLock rw();
        rw.readLock();
        rw.readLock();
        assertThrows('LOCK-ERROR', "terminated while holding", sub () {throw_thread_resource_exceptions();});

        rw.writeLock();
        assertThrows('LOCK-ERROR', "terminated while holding", sub () {throw_thread_resource_exceptions();});

        rw.readLock();
        mark_thread_resources();

        # no exception should be thrown here
        throw_thread_resource_exceptions_to_mark();

        assertThrows('LOCK-ERROR', "terminated while holding", sub () {throw_thread_resource_exceptions();});
    }

    cond_test(Counter c, Condition cond, Mutex m, int n) {
        m.lock();
        c.dec();
        try {
            cond.wait(m);
        } catch (hash<ExceptionInfo> ex) {
            assertEq("LOCK-ERROR", ex.err, "cond-error-" + n);
        }
    }

    rwl_cond_test(Counter c, Condition cond, RWLock rwl, int n) {
        rwl.readLock();
        c.dec();
        try {
            cond.wait(rwl);
        } catch (hash<ExceptionInfo> ex) {
            assertEq("LOCK-ERROR", ex.err, "rwl-cond-error-" + n);
        }
    }

    counter_test(Counter c, int n) {
        try {
            c.waitForZero();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("COUNTER-ERROR", ex.err, "counter-error-" + n);
        }
    }

    queue_test(Queue q, int n) {
        try {
            q.get();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("QUEUE-ERROR", ex.err, "queue-error-" + n);
        }
    }

    testDeadlocks() {
        # internal deadlock with synchronized methods
        Counter c(2);
        Counter done(1);
        D1 d1();
        D2 d2();
        background sub () { d1.m(self, d2, c); done.dec(); }();
        d2.m(self, d1, c);
        done.waitForZero();

        # internal deadlock with synchronized static methods
        c.inc();
        c.inc();
        done.inc();
        background sub () { D1::sm(self, c); done.dec(); }();
        D2::sm(self, c);
        done.waitForZero();

        # internal deadlock with synchronized functions
        c.inc();
        c.inc();
        done.inc();
        background sub () { internal_deadlock_a(self, c); done.dec(); }();
        internal_deadlock_b(self, c);
        done.waitForZero();

        # deadlock tests with qore classes and explicit locking
        Mutex m();
        Gate g();

        # increment counter for synchronization
        c.inc();
        c.inc();
        done.inc();
        background sub () { mutex_gate_deadlock_a(c, m, g); done.dec(); }();
        mutex_gate_deadlock_b(c, m, g);
        done.waitForZero();

        # deadlock tests with other classes
        RWLock rw1();
        RWLock rw2();

        # increment counter for synchronization
        c.inc();
        c.inc();
        done.inc();
        background sub () { readwrite_deadlock_c(c, rw1, rw2); done.dec(); }();
        readwrite_deadlock_d(c, rw1, rw2);
        done.waitForZero();

        # mutex tests
        m.lock();
        assertThrows('LOCK-ERROR', "called Mutex::lock.*twice without", sub () {m.lock();});

        m.unlock();
        assertThrows('LOCK-ERROR', "called Mutex::unlock.*while the lock was already unlocked", sub () {m.unlock();});

        delete m;

        # Gate tests
        assertThrows('LOCK-ERROR', "called Gate::exit", sub () {g.exit();});
        g.enter();
        assertThrows('LOCK-ERROR', "deleted Gate object", sub () {delete g;});

        assertThrows('LOCK-ERROR', "RWLock::writeUnlock", sub () {rw1.writeUnlock();});
        assertThrows('LOCK-ERROR', "RWLock::readUnlock", sub () {rw1.readUnlock();});

        rw1.writeLock();
        assertThrows('LOCK-ERROR', "RWLock::readUnlock", sub () {rw1.readUnlock();});

        rw1.writeUnlock();
        rw1.readLock();
        assertThrows('LOCK-ERROR', "RWLock::writeUnlock", sub () {rw1.writeUnlock();});
        # read-to-write lock upgrade must be detected as LOCK-ERROR, not THREAD-DEADLOCK
        assertThrows('LOCK-ERROR', "read lock.*read-to-write lock upgrades are not supported",
            sub () {rw1.writeLock();});

        rw1.readUnlock();

        # make sure threads sleeping on Condition variable wake up with an exception
        # if the mutex object is deleted in another thread
        Condition cond();
        m = new Mutex();
        # increment counter for synchronization
        c.inc();
        c.inc();
        done.inc();
        done.inc();
        background sub () { cond_test(c, cond, m, 1); done.dec(); }();
        background sub () { cond_test(c, cond, m, 2); done.dec(); }();
        c.waitForZero();
        # lock and unlock to ensure there are 2 condition variables waiting on this Mutex
        m.lock();
        m.unlock();
        assertEq(2, cond.wait_count(m));
        assertThrows('LOCK-ERROR', "Mutex object deleted", sub () {delete m;});
        done.waitForZero();

        # try it with a RWLock object
        c.inc();
        c.inc();
        done.inc();
        done.inc();
        background sub () { rwl_cond_test(c, cond, rw1, 1); done.dec(); }();
        background sub () { rwl_cond_test(c, cond, rw1, 2); done.dec(); }();
        c.waitForZero();
        # lock and unlock to ensure there are 2 condition variables waiting on this RWLock
        rw1.writeLock();
        rw1.writeUnlock();
        assertThrows('RWLOCK-ERROR', "RWLock object deleted", sub () {delete rw1;});
        done.waitForZero();

        # make sure threads sleeping on a counter wake up with an exception
        # when the counter is deleted
        Counter c1();
        c1.inc();
        done.inc();
        done.inc();
        background sub () { counter_test(c1, 1); done.dec(); }();
        background sub () { counter_test(c1, 2); done.dec(); }();
        # sleep until there are 2 counter variables waiting on this Counter
        while (c1.getWaiting() != 2) {
            usleep(10ms);
        }
        assertThrows('COUNTER-ERROR', "Counter deleted while", sub () {delete c1;});
        done.waitForZero();

        # make sure threads sleeping on a Queue wake up with an exception
        # when the Queue is deleted
        Queue q();
        done.inc();
        done.inc();
        background sub () { queue_test(q, 1); done.dec(); }();
        background sub () { queue_test(q, 2); done.dec(); }();
        # sleep until there are 2 threads waiting on this Queue
        while (q.getWaiting() != 2) {
            usleep(10ms);
        }
        assertThrows('QUEUE-ERROR', "Queue deleted while", sub () {delete q;});
        done.waitForZero();

        # test thread resource tracking checks
        done.inc();
        background sub () { test_thread_resources(); done.dec(); }();
        done.waitForZero();
    }
}
