#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - background threads that start background threads with copies of calls through self

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm
%exec-class NestedBackgroundSelfCallTest

#! a background expression nested in a background expression calls methods of the object (qore#5971)
/** The outer background expression copies the inner one for its thread, with its calls through self as copies that
    hold the object of the starting code; the inner one copies them again in the thread of the outer one, which has no
    object of its own.  The AST interpreter took the object from the thread and crashed; the copy keeps the object of
    the copied call.
*/
class NestedBackgroundSelfCallTest inherits QUnit::Test {
    private {
        string qore_bin = executablePath(ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore");
        string lib_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QCC ?? lib_dir + "/qcc";
        string probe = get_script_dir() + "/nested-background-self-call/probe.q";
        *string ast_out;
    }

    constructor() : Test("nested background self call", "1.0", \ARGV) {
        addTestCase("AST runs the calls of nested background expressions", \astReference());
        addTestCase("compiled modes match AST", \sourceModes());
        addTestCase("qcc executables match AST", \compiled());
        set_return_value(main());
    }

    astReference() {
        assertEq("b1 B::m(2)\nalive done\nb1 B::m(3)\nthree levels done\nb1 B::m(4)\nb1 B::m(5)\nlist done\n"
            "b1 B::pm(6)\nprivate done\nB::sm(7)\nstatic done\nb1 B::m(8)\nclosure done\nb1 B::m(9)\nb1 B::m(9)\n"
            "argument done\nmap done\nmap with a call done\nselect done\ninner map done\ninner select done\n"
            "deleted done\n", getAst());
    }

    sourceModes() {
        string expected = getAst();
        foreach string mode in ("ir", "jit") {
            assertEq(expected, runProbe((qore_bin, "-b", "--enable-debug", "--exec-mode=" + mode, probe), mode), mode);
        }
        assertEq(expected, runProbe(("QORE_JIT_SYNC_COMPILE=1", "QORE_IR_THRESHOLD=1", "QORE_JIT_THRESHOLD=1",
            qore_bin, "-b", "--enable-debug", "--exec-mode=tiered", probe), "tiered"), "tiered");
    }

    compiled() {
        string expected = getAst();
        foreach string level in ("-O0", "-O3") {
            TmpDir dir("qore-nested-background-self-call-");
            string exe = dir.path + "/probe";
            run((qcc_bin, level, "-o", exe, probe));
            assertEq(expected, runProbe((exe, "-b", "--enable-debug"), "qcc " + level), "qcc " + level);
        }
    }

    private string getAst() {
        if (!exists ast_out) {
            ast_out = runProbe((qore_bin, "-b", "--enable-debug", "--exec-mode=ast", probe), "ast");
        }
        return ast_out;
    }

    private static string quote(string value) {
        return "'" + join("'\\''", split("'", value)) + "'";
    }

    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string directory in (split(":", ENV.PATH ?? "")) {
            string path = (directory ? directory : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", "cannot locate Qore executable " + name;
    }

    #! runs a command and returns its output; one that runs qore with an execution mode runs through ExecModeHarness
    private hash<ExecModeHarness::ModeRunResult> runResult(list<string> args) {
        string command = "env LD_LIBRARY_PATH=" + quote(lib_dir) + " QORE_LIBDIR=" + quote(lib_dir) + " "
            + (map quote($1), args).join(" ");
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command);
        if (r.mode) {
            ExecModeHarness::check_native(r);
        }
        assertEq(0, r.rc, r.out);
        return r;
    }

    #! runs a command and returns its standard output
    private string run(list<string> args) {
        return runResult(args).stdout;
    }

    #! runs the probe and checks that the call on the deleted object raised its error in the inner thread
    private string runProbe(list<string> args, string label) {
        hash<ExecModeHarness::ModeRunResult> r = runResult(args);
        list<string> lines = r.stderr.split("\n");
        assertEq(1, (select lines, $1 =~ /^OBJECT-ALREADY-DELETED: cannot call B::m\(/).size(),
            label + ": " + r.stderr);
        # no other exception is raised
        assertEq(1, (select lines, $1 =~ /^unhandled QORE System exception/).size(), label + ": " + r.stderr);
        return r.stdout;
    }
}
