#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-platform: macos - type arguments of generic code in background threads (JIT, AOT, thread start)

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires FsUtil
%requires QUnit

%exec-class GenericBackgroundTypeArgsTest

#! A background expression of generic code runs with the type arguments of that code (qore#5732)
/** A background thread started no instantiation of the type parameters of the code that started it, so an explicit
    type argument naming one (ex: <tt>background G::f<U>(v)</tt> in a generic method, or <tt>identity<T>(v)</tt> in a
    method of a generic class) could not be resolved in the thread ("cannot infer type arguments"); the thread now
    runs its expression with the type arguments and the receiver type of the starting code.  In qcc-compiled code, a
    background call with explicit type arguments that was decomposed (a call by name, or from the expression) lost
    them; such a call is now made by a helper, whose compiled call keeps them.  The probes
    (generic-background-type-args/probes.q) run at the top level and in a child Program, in each execution mode in a
    child process, at the IR tier and promoted to native code with tiered execution, and as qcc-compiled executables
    (-O0, -O3).
*/
class GenericBackgroundTypeArgsTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");

        const Line = "{v: 1, t: \"integer\"} hash<auto>; \"2\" string; 3 integer; \"4\" string; [5] list<int>; 6"
            " integer; \"RUNTIME-OVERLOAD-ERROR\" string; [7, 7, 7, 7] list<auto>; [\"RUNTIME-OVERLOAD-"
            "ERROR\", \"RUNTIME-OVERLOAD-ERROR\", \"RUNTIME-OVERLOAD-ERROR\", \"RUNTIME-OVERLOAD-ERROR"
            "\"] list<auto>";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string probes;
        string expected;
    }

    constructor() : QUnit::Test("GenericBackgroundTypeArgs", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        probes = ReadOnlyFile::readTextFile(get_script_dir() + DirSep + "generic-background-type-args" + DirSep
            + "probes.q");
        for (int i = 0; i < 8; ++i) {
            expected += sprintf("%d: %s\n", i, Line);
        }

        addTestCase("background expressions of generic code run with its type arguments in every mode", \testModes());
        set_return_value(main());
    }

    testModes() {
        TmpDir tmp("qore-generic-background-type-args-");
        # the probes at the top level, and in a child Program whose source is the same file
        string top = tmp.path + DirSep + "top.q";
        writeFile(top, probes + "\nprint(probes());\n");
        string probes_file = tmp.path + DirSep + "probes.q";
        writeFile(probes_file, probes);
        string child = tmp.path + DirSep + "child.q";
        writeFile(child, sprintf("%%modern\nProgram p(PO_NEW_STYLE);\np.parse(ReadOnlyFile::readTextFile(%y), "
            "\"probes\");\nprint(p.callFunction(\"probes\"));\n", probes_file));

        string env = sprintf("QORE_JIT_SYNC_COMPILE=1 QORE_JIT_THRESHOLD=5 LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s",
            libqore_dir, libqore_dir);
        foreach string file in (top, child) {
            string label = basename(file);
            foreach string mode in (ExecModes) {
                assertEq(expected, backquote(sprintf("%s %s --exec-mode=%s %s 2>&1", env, qore_bin, mode, file)),
                    sprintf("%s: %s", label, mode));
            }
            # tiered execution kept at the IR tier, and promoted to native code
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
                "--jit-jit-threshold=1000000 %s 2>&1", env, qore_bin, file)), label + ": tiered, IR tier");
            assertEq(expected, backquote(sprintf("%s %s --exec-mode=tiered --jit-ir-threshold=1 "
                "--jit-jit-threshold=1 %s 2>&1", env, qore_bin, file)), label + ": tiered, promoted");

            foreach string opt in (("-O0", "-O3")) {
                string exe = file + opt;
                string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                    file));
                assertTrue(is_file(exe), sprintf("%s: qcc %s compiled the executable: %s", label, opt, out));
                assertEq(expected, backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
                    libqore_dir, exe)), sprintf("%s: qcc %s", label, opt));
            }
        }
    }

    private writeFile(string path, string data) {
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(data);
        f.close();
    }
}
