#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - cancellation and program interrupts of lock, condition, queue and counter waits in destructors
# test-exec-mode: parent - the cases run destructors in the test's own process; the mode and AOT runs are children

# Copyright (C) 2026 Qore Technologies, s.r.o.

# Destructors on a cancelled or interrupted thread (issue #5634; see "Destructors" in
# design/cooperative-cancellation.md):
# - the destructor of a trusted class (a class of a Program without a sandbox manager) runs with cancellation and
#   program interrupts deferred: it completes, and the pending request is raised at the first cancellation point after
#   it, with its original reason
# - the destructor of a sandboxed class (a class of a Program with a sandbox manager) never gets a deferral: with a
#   cancellation, an interrupt or a sandbox limit pending, it is skipped, and the object's members are released as
#   when it is obliterated; the decision is made per class in the hierarchy
# - a sandbox limit (call budget, memory limit) is never deferred, so a trusted destructor in a sandbox call cannot
#   run unbounded
#
# Every interleaving is forced with Counters and Queues; no case depends on timing.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class DestructorCancellationTest

#! A gate a destructor waits for on a Condition
class DtorGate {
    private {
        Mutex m();
        Condition c();
        bool opened = False;
    }

    #! reports the wait and waits until the gate is opened
    waitOpen(Queue ev, string name) {
        m.lock();
        on_exit m.unlock();
        ev.push(name + "-waiting");
        while (!opened) {
            c.wait(m);
        }
    }

    open() {
        m.lock();
        on_exit m.unlock();
        opened = True;
        c.broadcast();
    }
}

#! A trusted class whose destructor reaches every kind of cancellation point
class TrustedRes {
    private {
        Queue ev;
        string label;
        *DtorGate gate;
        *Queue items;
        *Counter count;
    }

    constructor(Queue ev, string label = "dtor", *DtorGate gate, *Queue items, *Counter count) {
        self.ev = ev;
        self.label = label;
        self.gate = gate;
        self.items = items;
        self.count = count;
    }

    ping() {
    }

    destructor() {
        ev.push(label + "-start");
        # a Mutex lock is a cancellation point even when the Mutex is free
        Mutex m();
        m.lock();
        m.unlock();
        ev.push(label + "-locked");
        if (gate) {
            # a loop and a Condition wait
            gate.waitOpen(ev, label + "-cond");
        }
        if (items) {
            ev.push(label + "-queue-waiting");
            ev.push(label + "-queue:" + items.get());
        }
        if (count) {
            ev.push(label + "-counter-waiting");
            count.waitForZero();
        }
        ev.push(label + "-end");
    }
}

#! A trusted class whose destructor throws once it has passed a cancellation point
class TrustedThrower {
    private {
        Queue ev;
    }

    constructor(Queue ev) {
        self.ev = ev;
    }

    destructor() {
        Mutex m();
        m.lock();
        m.unlock();
        ev.push("thrower-locked");
        throw "DTOR-ERROR", "the destructor fails";
    }
}

#! A trusted class whose destructor releases another object explicitly, and has a member released after it
class TrustedOuter {
    private {
        Queue ev;
        TrustedRes a;
        TrustedRes b;
    }

    constructor(Queue ev) {
        self.ev = ev;
        a = new TrustedRes(ev, "a");
        b = new TrustedRes(ev, "b");
    }

    destructor() {
        Mutex m();
        m.lock();
        m.unlock();
        ev.push("outer-locked");
        delete a;
        ev.push("outer-end");
    }
}

#! A trusted class holding an object that its destructor releases, for a sandboxed object released by trusted code
class TrustedHolder {
    public {
        auto held;
    }

    private {
        Queue ev;
    }

    constructor(Queue ev) {
        self.ev = ev;
    }

    destructor() {
        Mutex m();
        m.lock();
        m.unlock();
        ev.push("holder-locked");
        delete held;
        ev.push("holder-end");
    }
}

#! A trusted base class whose destructor calls a method that a sandboxed subclass overrides
class TrustedBase {
    private {
        Queue ev;
    }

    constructor(Queue ev) {
        self.ev = ev;
    }

    hook() {
    }

    destructor() {
        Mutex m();
        m.lock();
        m.unlock();
        ev.push("base-locked");
        hook();
        ev.push("base-end");
    }
}

#! A trusted class whose destructor waits forever, so only a sandbox limit can end it
class TrustedBlocker {
    private {
        Counter entered;
    }

    constructor(Counter entered) {
        self.entered = entered;
    }

    destructor() {
        Counter never(1);
        entered.dec();
        never.waitForZero();
    }
}

#! A trusted class whose destructor allocates memory without a bound, so only a memory limit can end it
class TrustedGrower {
    destructor() {
        list<string> l = ();
        while (True) {
            l += strmul("x", 4096);
        }
    }
}

class DestructorCancellationTest inherits QUnit::Test {
    public {
        #! a limit for every wait of the test; never reached unless a case fails
        const T = 30s;

        #! the reason given to the cancellations
        const Reason = "destructor-test";

        #! the code of the sandboxed Programs; TrustedBase and TrustedRes are imported from the test's Program
        const SandboxedSource = "%modern

class SbRes {
    private {
        Queue ev;
        TrustedRes member;
    }

    constructor(Queue ev) {
        self.ev = ev;
        member = new TrustedRes(ev, \"member\");
    }

    destructor() {
        ev.push(\"sb-start\");
        # not deferred: a cancellation that arrives while the destructor runs ends it here
        Mutex m();
        m.lock();
        m.unlock();
        ev.push(\"sb-end\");
    }
}

class SbSub inherits TrustedBase {
    constructor(Queue ev) : TrustedBase(ev) {
    }

    hook() {
        # sandboxed code called by a trusted destructor does not get the destructor's deferral
        try {
            Mutex m();
            m.lock();
            m.unlock();
            ev.push(\"hook-locked\");
        } catch (hash<ExceptionInfo> ex) {
            ev.push(\"hook:\" + ex.err);
        }
    }

    destructor() {
        ev.push(\"sub-dtor\");
    }
}

sub hold(string cls, Queue ev, Counter ready, Counter block) {
    object o = create_object(cls, ev);
    ready.dec();
    block.waitForZero();
}

object sub make(string cls, Queue ev) {
    return create_object(cls, ev);
}

sub release(string cls, Queue ev) {
    object o = create_object(cls, ev);
}

sub block_in_destructor(Counter entered) {
    TrustedBlocker b(entered);
}

sub grow_in_destructor() {
    TrustedGrower g();
}
";

        #! the execution modes of the sandboxed Programs
        const Modes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
    }

    constructor() : QUnit::Test("DestructorCancellationTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        # libqore is next to qore in a build directory, and in ../lib for an installed qore
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        if (!ENV.QORE_LIBDIR && !glob(libqore_dir + "/libqore*") && is_dir(libqore_dir + "/../lib")) {
            libqore_dir = normalize_dir(libqore_dir + "/../lib");
        }
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(dirname(qore_bin) + "/qcc") ? dirname(qore_bin) + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir,
            libqore_dir);

        addTestCase("a trusted destructor completes on a cancelled thread", \trustedUnwindTest());
        addTestCase("an explicit delete on a cancelled thread while other references exist", \trustedDeleteTest());
        addTestCase("a trusted destructor that throws ends its deferral", \trustedThrowTest());
        addTestCase("nested trusted destructors", \trustedNestedTest());
        addTestCase("a trusted destructor completes under a program interrupt", \trustedInterruptTest());
        addTestCase("a trusted destructor completes under Program::cancelThreads()", \trustedCancelThreadsTest());
        addTestCase("a sandboxed destructor is skipped when a cancellation is pending", \sandboxedSkipTest());
        addTestCase("a sandboxed subclass of a trusted class", \mixedHierarchyTest());
        addTestCase("a sandboxed destructor runs when nothing is pending", \sandboxedRunsTest());
        addTestCase("a sandboxed destructor is skipped when an interrupt is pending", \sandboxedInterruptTest());
        addTestCase("a sandboxed object released by a trusted destructor", \sandboxedInTrustedTest());
        addTestCase("a sandboxed object released in a cleanup critical section", \sandboxedInDeferralTest());
        addTestCase("a sandbox wall time limit ends a trusted destructor", \budgetTest());
        addTestCase("a sandbox wall time limit ends a trusted destructor on a cancelled thread",
            \budgetCancelledTest());
        addTestCase("a sandbox memory limit ends a trusted destructor", \memoryLimitTest());
        addTestCase("the rule holds in AST, IR, JIT and tiered execution", \execModesTest());
        addTestCase("the rule holds in AOT-compiled code", \aotTest());

        set_return_value(main());
    }

    #! checks that the next events are the given ones, in order
    private expect(Queue ev, list<string> events) {
        foreach string e in (events) {
            assertEq(e, ev.get(T));
        }
    }

    #! reports the exception of a cancellation point reached after a destructor, with its reason
    private static checkAgain(Queue ev) {
        try {
            Counter c(1);
            c.waitForZero();
            ev.push("not-raised");
        } catch (hash<ExceptionInfo> ex) {
            ev.push("again:" + ex.err + (ex.desc =~ /destructor-test/ ? ":reason" : ":" + ex.desc));
        }
    }

    #! returns the execution mode with the given name
    private static ExecMode execMode(string mode) {
        switch (mode) {
            case "ast": return EM_AST;
            case "ir": return EM_IR;
            case "jit": return EM_JIT;
        }
        return EM_TIERED;
    }

    #! returns a sandboxed Program
    private Program sandboxed(SandboxManager sm, string mode = "tiered") {
        Program p(PO_NEW_STYLE);
        p.setExecMode(execMode(mode));
        p.importClass("TrustedBase");
        p.importClass("TrustedRes");
        p.importClass("TrustedBlocker");
        p.importClass("TrustedGrower");
        p.setSandboxManager(sm);
        p.parse(SandboxedSource, "sandboxed");
        return p;
    }

    #! A local released while THREAD-CANCELLED unwinds the stack: the destructor passes a lock, a Condition wait, a
    #! Queue get and a Counter wait, and the cancellation is raised again afterwards with its reason
    trustedUnwindTest() {
        Queue ev();
        Counter ready(1);
        Counter block(1);
        DtorGate gate();
        Queue items();
        Counter count(1);
        on_exit {
            gate.open();
            items.push("cleanup");
            if (count.getCount()) {
                count.dec();
            }
            if (block.getCount()) {
                block.dec();
            }
        }
        int tid = background sub () {
            try {
                TrustedRes r(ev, "dtor", gate, items, count);
                ready.dec();
                block.waitForZero();
            } catch (hash<ExceptionInfo> ex) {
                ev.push("caught:" + ex.err);
                ev.push("pending:" + (thread_cancelled() ? "True" : "False"));
                DestructorCancellationTest::checkAgain(ev);
            }
            ev.push("end");
        }();
        assertEq(0, ready.waitForZero(T));
        assertTrue(cancel_thread(tid, Reason));
        expect(ev, ("dtor-start", "dtor-locked", "dtor-cond-waiting"));
        gate.open();
        expect(ev, ("dtor-queue-waiting",));
        items.push("item");
        expect(ev, ("dtor-queue:item", "dtor-counter-waiting"));
        count.dec();
        expect(ev, ("dtor-end", "caught:THREAD-CANCELLED", "pending:True", "again:THREAD-CANCELLED:reason", "end"));
        thread_join(tid);
    }

    #! delete on a cancelled thread: the destructor completes, the other reference sees a deleted object, and the
    #! cancellation is raised again
    trustedDeleteTest() {
        Queue ev();
        Counter ready(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        int tid = background sub () {
            TrustedRes r(ev);
            TrustedRes other = r;
            try {
                ready.dec();
                block.waitForZero();
            } catch (hash<ExceptionInfo> ex) {
                ev.push("caught:" + ex.err);
            }
            delete r;
            try {
                other.ping();
                ev.push("other-valid");
            } catch (hash<ExceptionInfo> ex) {
                ev.push("other:" + ex.err);
            }
            DestructorCancellationTest::checkAgain(ev);
        }();
        assertEq(0, ready.waitForZero(T));
        assertTrue(cancel_thread(tid, Reason));
        expect(ev, ("caught:THREAD-CANCELLED", "dtor-start", "dtor-locked", "dtor-end",
            "other:OBJECT-ALREADY-DELETED", "again:THREAD-CANCELLED:reason"));
        thread_join(tid);
    }

    #! A destructor that throws on a cancelled thread: its exception is raised by delete, and the deferral ends with
    #! the destructor, so the cancellation is raised at the next cancellation point
    trustedThrowTest() {
        Queue ev();
        Counter ready(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        int tid = background sub () {
            TrustedThrower t(ev);
            try {
                ready.dec();
                block.waitForZero();
            } catch (hash<ExceptionInfo> ex) {
                ev.push("caught:" + ex.err);
            }
            try {
                delete t;
                ev.push("deleted");
            } catch (hash<ExceptionInfo> ex) {
                ev.push("delete:" + ex.err);
            }
            DestructorCancellationTest::checkAgain(ev);
        }();
        assertEq(0, ready.waitForZero(T));
        assertTrue(cancel_thread(tid, Reason));
        expect(ev, ("caught:THREAD-CANCELLED", "thrower-locked", "delete:DTOR-ERROR",
            "again:THREAD-CANCELLED:reason"));
        thread_join(tid);
    }

    #! A destructor that releases an object explicitly, and a member released after the destructor, on a cancelled
    #! thread: all of them complete
    trustedNestedTest() {
        Queue ev();
        Counter ready(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        int tid = background sub () {
            try {
                TrustedOuter o(ev);
                ready.dec();
                block.waitForZero();
            } catch (hash<ExceptionInfo> ex) {
                ev.push("caught:" + ex.err);
                DestructorCancellationTest::checkAgain(ev);
            }
        }();
        assertEq(0, ready.waitForZero(T));
        assertTrue(cancel_thread(tid, Reason));
        expect(ev, ("outer-locked", "a-start", "a-locked", "a-end", "outer-end", "b-start", "b-locked", "b-end",
            "caught:THREAD-CANCELLED", "again:THREAD-CANCELLED:reason"));
        thread_join(tid);
    }

    #! A trusted destructor in a sandbox call that is interrupted completes; PROGRAM-INTERRUPTED ends the call
    trustedInterruptTest() {
        SandboxManager sm();
        Program p = sandboxed(sm);
        Queue ev();
        Counter ready(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        Queue result();
        int tid = background sub () {
            try {
                p.callFunction("hold", "TrustedRes", ev, ready, block);
                result.push("returned");
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex.err);
            }
        }();
        assertEq(0, ready.waitForZero(T));
        sm.requestInterrupt();
        expect(ev, ("dtor-start", "dtor-locked", "dtor-end"));
        assertEq("PROGRAM-INTERRUPTED", result.get(T));
        thread_join(tid);
        sm.clearInterrupt();
    }

    #! A thread of a Program without a sandbox manager cancelled with Program::cancelThreads(): the destructor of a
    #! class of the Program completes
    trustedCancelThreadsTest() {
        Program p(PO_NEW_STYLE);
        p.importClass("DtorGate");
        p.parse("class ChildRes {
    private {
        Queue ev;
        DtorGate gate;
    }
    constructor(Queue ev, DtorGate gate) {
        self.ev = ev;
        self.gate = gate;
    }
    destructor() {
        Mutex m();
        m.lock();
        m.unlock();
        gate.waitOpen(ev, \"child\");
        ev.push(\"child-end\");
    }
}
sub run(Queue ev, DtorGate gate, Counter ready, Counter block) {
    ChildRes r(ev, gate);
    ready.dec();
    block.waitForZero();
}", "child");
        Queue ev();
        DtorGate gate();
        Counter ready(1);
        Counter block(1);
        on_exit {
            gate.open();
            if (block.getCount()) {
                block.dec();
            }
        }
        Queue result();
        int tid = background sub () {
            try {
                p.callFunction("run", ev, gate, ready, block);
                result.push("returned");
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex.err);
            }
        }();
        assertEq(0, ready.waitForZero(T));
        assertEq(1, p.cancelThreads(Reason));
        expect(ev, ("child-waiting",));
        gate.open();
        expect(ev, ("child-end",));
        assertEq("THREAD-CANCELLED", result.get(T));
        thread_join(tid);
    }

    #! runs \a func of the sandboxed Program with \a cls on a thread that is cancelled once it holds the object
    private string runCancelled(Program p, string cls, Queue ev) {
        Counter ready(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        Queue result();
        int tid = background sub () {
            try {
                p.callFunction("hold", cls, ev, ready, block);
                result.push("returned");
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex.err);
            }
            ev.push("thread-end");
        }();
        assertEq(0, ready.waitForZero(T));
        assertTrue(cancel_thread(tid, Reason));
        string rv = result.get(T);
        thread_join(tid);
        return rv;
    }

    #! A sandboxed class on a cancelled thread: its destructor is skipped, and its trusted member is destroyed
    #! completely
    sandboxedSkipTest() {
        foreach string mode in (Modes) {
            SandboxManager sm();
            Program p = sandboxed(sm, mode);
            Queue ev();
            assertEq("THREAD-CANCELLED", runCancelled(p, "SbRes", ev), mode);
            expect(ev, ("member-start", "member-locked", "member-end", "thread-end"));
            assertEq(0, ev.size(), mode);
        }
    }

    #! A sandboxed subclass of a trusted base class on a cancelled thread: only the subclass's destructor is
    #! skipped; the base destructor runs deferred, and the sandboxed method it calls is not deferred
    mixedHierarchyTest() {
        foreach string mode in (Modes) {
            SandboxManager sm();
            Program p = sandboxed(sm, mode);
            Queue ev();
            assertEq("THREAD-CANCELLED", runCancelled(p, "SbSub", ev), mode);
            expect(ev, ("base-locked", "hook:THREAD-CANCELLED", "base-end", "thread-end"));
        }
    }

    #! Nothing pending: the destructor of a sandboxed class runs as before, in every class of the hierarchy
    sandboxedRunsTest() {
        foreach string mode in (Modes) {
            SandboxManager sm();
            Program p = sandboxed(sm, mode);
            Queue ev();
            p.callFunction("release", "SbRes", ev);
            expect(ev, ("sb-start", "sb-end", "member-start", "member-locked", "member-end"));
            p.callFunction("release", "SbSub", ev);
            expect(ev, ("sub-dtor", "base-locked", "hook-locked", "base-end"));
        }
    }

    #! An interrupted sandbox call: the sandboxed destructor is skipped and its trusted member destroyed completely
    sandboxedInterruptTest() {
        SandboxManager sm();
        Program p = sandboxed(sm);
        Queue ev();
        Counter ready(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        Queue result();
        int tid = background sub () {
            try {
                p.callFunction("hold", "SbRes", ev, ready, block);
                result.push("returned");
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex.err);
            }
        }();
        assertEq(0, ready.waitForZero(T));
        sm.requestInterrupt();
        assertEq("PROGRAM-INTERRUPTED", result.get(T));
        thread_join(tid);
        expect(ev, ("member-start", "member-locked", "member-end"));
        assertEq(0, ev.size());
        sm.clearInterrupt();
    }

    #! A sandboxed object released by the destructor of a trusted class on a cancelled thread: the trusted destructor
    #! completes, and the sandboxed destructor does not inherit its deferral, so it is skipped
    sandboxedInTrustedTest() {
        SandboxManager sm();
        Program p = sandboxed(sm);
        Queue ev();
        Counter ready(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        int tid = background sub () {
            try {
                TrustedHolder h(ev);
                h.held = p.callFunction("make", "SbRes", ev);
                ready.dec();
                block.waitForZero();
            } catch (hash<ExceptionInfo> ex) {
                ev.push("caught:" + ex.err);
            }
        }();
        assertEq(0, ready.waitForZero(T));
        assertTrue(cancel_thread(tid, Reason));
        expect(ev, ("holder-locked", "member-start", "member-locked", "member-end", "holder-end",
            "caught:THREAD-CANCELLED"));
        thread_join(tid);
    }

    #! A sandboxed object released inside defer_thread_cancel() on a cancelled thread: sandboxed code never runs
    #! under a deferral, so its destructor is skipped
    sandboxedInDeferralTest() {
        SandboxManager sm();
        Program p = sandboxed(sm);
        Queue ev();
        Counter ready(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        int tid = background sub () {
            object o = p.callFunction("make", "SbRes", ev);
            try {
                ready.dec();
                block.waitForZero();
            } catch (hash<ExceptionInfo> ex) {
                ev.push("caught:" + ex.err);
            }
            defer_thread_cancel(sub () {
                delete o;
                ev.push("deferred-end");
            });
            DestructorCancellationTest::checkAgain(ev);
        }();
        assertEq(0, ready.waitForZero(T));
        assertTrue(cancel_thread(tid, Reason));
        expect(ev, ("caught:THREAD-CANCELLED", "member-start", "member-locked", "member-end", "deferred-end",
            "again:THREAD-CANCELLED:reason"));
        thread_join(tid);
    }

    #! A trusted destructor in a sandbox call with a wall time limit waits forever: the limit is not deferred
    budgetTest() {
        SandboxManager sm();
        sm.setWallTimeLimit(200);
        Program p = sandboxed(sm);
        Counter entered(1);
        assertThrows("SANDBOX-TIMEOUT", \p.callFunction(), ("block_in_destructor", entered));
        assertEq(0, entered.getCount(), "the destructor ran");
    }

    #! The same on a cancelled thread: the deferred cancellation does not keep the limit from ending the destructor,
    #! and it is still pending afterwards
    budgetCancelledTest() {
        SandboxManager sm();
        sm.setWallTimeLimit(500);
        Program p = sandboxed(sm);
        Counter entered(1);
        Queue ev();
        int tid = background sub () {
            try {
                p.callFunction("block_in_destructor", entered);
                ev.push("returned");
            } catch (hash<ExceptionInfo> ex) {
                ev.push("caught:" + ex.err);
            }
            ev.push("pending:" + (thread_cancelled() ? "True" : "False"));
            DestructorCancellationTest::checkAgain(ev);
        }();
        assertEq(0, entered.waitForZero(T));
        # the destructor waits with the cancellation deferred; the request stays pending
        assertTrue(cancel_thread(tid, Reason));
        expect(ev, ("caught:SANDBOX-TIMEOUT", "pending:True", "again:THREAD-CANCELLED:reason"));
        thread_join(tid);
    }

    #! A trusted destructor in a sandbox call with a memory limit allocates without a bound: the limit is not
    #! deferred
    memoryLimitTest() {
        SandboxManager sm();
        sm.setMemoryLimit(4 * 1024 * 1024);
        Program p = sandboxed(sm);
        assertThrows("SANDBOX-MEMORY-LIMIT", \p.callFunction(), "grow_in_destructor");
    }

    #! the script run in each execution mode and as an AOT-compiled executable; its argument is the execution mode of
    #! its sandboxed Program
    private string modeScript() {
        return "%modern
%no-child-restrictions

class TrustedBase {
    private {
        Queue ev;
    }
    constructor(Queue ev) {
        self.ev = ev;
    }
    hook() {
    }
    destructor() {
        Mutex m();
        m.lock();
        m.unlock();
        ev.push(\"base-locked\");
        hook();
        ev.push(\"base-end\");
    }
}

class TrustedRes {
    private {
        Queue ev;
        Queue items;
    }
    constructor(Queue ev, Queue items) {
        self.ev = ev;
        self.items = items;
    }
    destructor() {
        Mutex m();
        m.lock();
        m.unlock();
        ev.push(\"res-waiting\");
        ev.push(\"res-queue:\" + items.get());
    }
}

class TrustedBlocker {
    private {
        Counter entered;
    }
    constructor(Counter entered) {
        self.entered = entered;
    }
    destructor() {
        Counter never(1);
        entered.dec();
        never.waitForZero();
    }
}

const Sandboxed = \"%modern
class SbSub inherits TrustedBase {
    constructor(Queue ev) : TrustedBase(ev) {
    }
    hook() {
        try {
            Mutex m();
            m.lock();
            m.unlock();
            ev.push('hook-locked');
        } catch (hash<ExceptionInfo> ex) {
            ev.push('hook:' + ex.err);
        }
    }
    destructor() {
        ev.push('sub-dtor');
    }
}
sub hold(Queue ev, Counter ready, Counter block) {
    SbSub s(ev);
    ready.dec();
    block.waitForZero();
}
sub block_in_destructor(Counter entered) {
    TrustedBlocker b(entered);
}
\";

list<string> sub drain(Queue ev, string last) {
    list<string> l = ();
    while (True) {
        string e = ev.get(30s);
        l += e;
        if (e == last) {
            break;
        }
    }
    return l;
}

list<string> out = ();

# a trusted destructor on a cancelled thread
{
    Queue ev();
    Queue items();
    Counter ready(1);
    Counter block(1);
    int tid = background sub () {
        try {
            TrustedRes r(ev, items);
            ready.dec();
            block.waitForZero();
        } catch (hash<ExceptionInfo> ex) {
            ev.push(\"caught:\" + ex.err);
        }
    }();
    ready.waitForZero(30s);
    cancel_thread(tid, \"mode\");
    string e = ev.get(30s);
    if (e == \"res-waiting\") {
        items.push(\"x\");
        out += e;
        out += drain(ev, \"caught:THREAD-CANCELLED\");
    } else {
        out += e;
    }
    block.dec();
    thread_join(tid);
}

# a sandboxed subclass of a trusted class on a cancelled thread
{
    SandboxManager sm();
    Program p(PO_NEW_STYLE);
    p.setExecMode({\"ast\": EM_AST, \"ir\": EM_IR, \"jit\": EM_JIT, \"tiered\": EM_TIERED}{ARGV[0] ?? \"tiered\"});
    p.importClass(\"TrustedBase\");
    p.importClass(\"TrustedBlocker\");
    p.setSandboxManager(sm);
    p.parse(Sandboxed, \"sandboxed\");
    Queue ev();
    Counter ready(1);
    Counter block(1);
    int tid = background sub () {
        try {
            p.callFunction(\"hold\", ev, ready, block);
        } catch (hash<ExceptionInfo> ex) {
            ev.push(\"caught:\" + ex.err);
        }
    }();
    ready.waitForZero(30s);
    cancel_thread(tid, \"mode\");
    out += drain(ev, \"caught:THREAD-CANCELLED\");
    block.dec();
    thread_join(tid);

    # a wall time limit ends a trusted destructor
    sm.setWallTimeLimit(200);
    try {
        p.callFunction(\"block_in_destructor\", new Counter(1));
        out += \"returned\";
    } catch (hash<ExceptionInfo> ex) {
        out += \"limit:\" + ex.err;
    }
}

printf(\"%s\\n\", out.join(\",\"));
";
    }

    #! the output of the mode script when the rule holds
    const ModeExpected = "res-waiting,res-queue:x,caught:THREAD-CANCELLED,base-locked,hook:THREAD-CANCELLED,"
        "base-end,caught:THREAD-CANCELLED,limit:SANDBOX-TIMEOUT\n";

    execModesTest() {
        TmpFile tf("qore-destructor-cancellation-", ".qr");
        tf.file.write(modeScript());
        tf.file.close();
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(ModeExpected, ExecModeHarness::run_any(sprintf("%s %s -b --exec-mode=%s %s %s", env, qore_bin,
                mode, tf.path, mode)), mode);
        }
    }

    aotTest() {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir tmp("qore-destructor-cancellation-aot-");
        string source = tmp.path + "/destructor-cancellation.qr";
        {
            File f();
            f.open2(source, O_CREAT | O_TRUNC | O_WRONLY);
            f.write(modeScript());
        }
        string exe = tmp.path + "/destructor-cancellation";
        string out = ExecModeHarness::run_any(sprintf("%s %s -O3 -o %s %s", env, qcc_bin, exe, source));
        assertTrue(is_file(exe), "AOT compile produced an executable: " + out);
        assertEq(ModeExpected, ExecModeHarness::run_any(sprintf("%s %s tiered", env, exe)));
    }
}
