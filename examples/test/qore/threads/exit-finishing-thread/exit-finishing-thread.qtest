#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - process exit while a background thread is finishing (static destruction, thread counts)
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm

%exec-class ExitFinishingThreadTest

#! exit() does not run the static destructors while a background thread is finishing (#6405)
/** A background thread releases its TID before it leaves the process's background thread count (thread_counter),
    and exit() treated the process as single-threaded once no TID was in use: it ran the static destructors, and the
    finishing thread then locked the destroyed thread_counter (an assertion in a debug build, a use of a destroyed
    object in a release build).  The child process holds the finishing thread between the two points with a debug
    control and calls exit().  The hold is ended by exit() when it waits for the thread, or by the destruction of the
    static objects, so that a thread that exit() did not wait for uses the destroyed counter and the child aborts; a
    hold that ends by its 30 s timeout prints a line that fails the test, so the timeout cannot make it pass.
*/
class ExitFinishingThreadTest inherits QUnit::Test {
    constructor() : QUnit::Test("ExitFinishingThreadTest", "1.0") {
        addTestCase("exit() waits for a finishing background thread", \exitTest());
        addTestCase("exit() waits for the thread-local destructors of a finished background thread", \exitTlsTest());
        set_return_value(main());
    }

    exitTest() {
        runChild("exit-child.q");
    }

    #! the thread-local destructors of a background thread run after it has left its thread function: exit() waits
    #! for them too, as the reaper joins the thread before the thread leaves the background thread count (#6412)
    exitTlsTest() {
        runChild("exit-tls-child.q");
    }

    private runChild(string name) {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("needs a debug build (dbg_hold_next_thread_finish())");
        }
        string script = get_script_dir() + DirSep + name;
        for (int i = 0; i < 3; ++i) {
            int status;
            string out = backquote(sprintf("%s %s 2>&1", TestInterpreter::qore_interpreter(), script), \status);
            assertEq(0, status, out);
            assertEq("exiting\n", out);
        }
    }
}
