%new-style
%require-types
%strict-args

/** @section domthreadplainintro Introduction
    Starts a thread for its caller: without a declaration of the THREAD_CONTROL domain, a Program that may not control
    threads cannot load it.
*/
module DomThreadPlain {
    version = "1.0";
    desc = "domain declaration test fixture: declares no domain";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

public namespace DomThreadPlain {
    #! starts a thread of the module and returns when it has run
    public string sub probe() {
        Queue q();
        background q.push("ran");
        return q.get(30s);
    }
}
