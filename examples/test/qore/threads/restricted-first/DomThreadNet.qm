%new-style
%require-types
%strict-args

/** @section domthreadnetintro Introduction
    Starts a thread for its caller that uses the network, which its declared domains grant to its own code, and the
    filesystem, which they do not.
*/
module DomThreadNet {
    version = "1.0";
    desc = "domain declaration test fixture: declares NETWORK and THREAD_CONTROL";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "NETWORK,THREAD_CONTROL";
}

public namespace DomThreadNet {
    #! in a thread of the module, connects to \a port on the loopback address and reads the existence of \a path
    /** @return the outcome of each, after the thread ends: the exception code, or \c "ok"
    */
    public hash<auto> sub probe(int port, string path) {
        Queue q();
        background sub () {
            hash<auto> rv;
            try {
                Socket s();
                s.connect("127.0.0.1:" + port, 5s);
                s.close();
                rv.net = "ok";
            } catch (hash<ExceptionInfo> ex) {
                rv.net = ex.err;
            }
            try {
                # by name, so that the call is checked when it is made, not when the module is parsed
                call_function("is_file", path);
                rv.fs = "ok";
            } catch (hash<ExceptionInfo> ex) {
                rv.fs = ex.err;
            }
            q.push(rv);
        }();
        return q.get(30s);
    }
}
