#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Creates threads until Qore refuses to create another one (THREAD-CREATION-FAILURE), so it runs as many threads as
# Qore allows (MAX_QORE_THREADS, 8192 on Linux).  Under valgrind, give valgrind room for all of them, or valgrind
# aborts the test before Qore's limit is reached:
#     valgrind --max-threads=8300 qore -b max-threads-count.qtest
#
# The cases wait for threads on Counters, never for a time: the assignment case runs first, while the test's thread
# is the only one, and the count case waits for each thread it started to finish.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit

%exec-class MaxThreadCountTest

our Queue q;

public class MaxThreadCountTest inherits QUnit::Test {
    private {
        int limit = 0;
    }

    constructor() : Test("Max thread count test", "1.0") {
        # the TID case runs first: the order of the TIDs it is given is only meaningful while no threads of an
        # earlier case are still ending and freeing TIDs
        addTestCase("TID assignments", \testTidAssignments());
        addTestCase("max thread count", \testMaxThreadCount());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    globalSetUp() {
        q = new Queue();
    }

    t(Counter c, Counter c0) {
        c.waitForZero();
        c0.dec();
    }

    private checkSkipMaxThreadTest() {
        # Skip on macOS - creating 8000+ threads can cause kernel panics on Apple Silicon
        if (PlatformOS == "Darwin") {
            testSkip("skipping max thread test on macOS to prevent kernel panics");
        }
        if (ENV.SKIP_MAX_THREAD_TEST) {
            testSkip("skipping max thread test due to environment variable");
        }
        if (PlatformOS == "Linux") {
            *int thread_limit = getLinuxThreadLimit();
            if (thread_limit !== NOTHING && thread_limit > 20000) {
                testSkip(sprintf("skipping max thread test: effective Linux thread limit %d exceeds harness-safe "
                    "limit %d", thread_limit, 20000));
            }
        }
    }

    private *int getLinuxThreadLimit() {
        *int limit = getLinuxCgroupPidsLimit();
        *int rlimit = getLinuxProcessRLimit();
        if (rlimit !== NOTHING && (limit === NOTHING || rlimit < limit)) {
            limit = rlimit;
        }
        return limit;
    }

    private *int getLinuxProcessRLimit() {
        try {
            string limits = File::readTextFile("/proc/self/limits");
            foreach string line in (limits.split("\n")) {
                *string value = (line =~ x/^Max processes\s+(\S+)/)[0];
                if (value === NOTHING || value == "unlimited") {
                    continue;
                }
                return value.toInt();
            }
        } catch () {
        }
        return NOTHING;
    }

    private *int getLinuxCgroupPidsLimit() {
        *int limit;
        try {
            string cgroups = File::readTextFile("/proc/self/cgroup");
            foreach string line in (cgroups.split("\n")) {
                if (!line) {
                    continue;
                }
                list<string> parts = line.split(":");
                if (parts.size() < 3) {
                    continue;
                }

                *int cgroup_limit = getCgroupPathPidsLimit(parts[2]);
                if (cgroup_limit !== NOTHING && (limit === NOTHING || cgroup_limit < limit)) {
                    limit = cgroup_limit;
                }
            }
        } catch () {
        }
        return limit;
    }

    private *int getCgroupPathPidsLimit(string cgroup_path) {
        *int limit;
        string path = cgroup_path;
        while (True) {
            string file = "/sys/fs/cgroup" + (path == "/" ? "" : path) + "/pids.max";
            *int path_limit = readPositiveIntFile(file);
            if (path_limit !== NOTHING && (limit === NOTHING || path_limit < limit)) {
                limit = path_limit;
            }
            if (!path || path == "/") {
                break;
            }

            int slash = path.rfind("/");
            path = slash <= 0 ? "/" : path[0..slash - 1];
        }
        return limit;
    }

    private *int readPositiveIntFile(string path) {
        try {
            if (!is_file(path)) {
                return NOTHING;
            }
            string value = trim(File::readTextFile(path));
            if (!value || value == "max") {
                return NOTHING;
            }
            int rv = value.toInt();
            return rv > 0 ? rv : NOTHING;
        } catch () {
            return NOTHING;
        }
    }

    testMaxThreadCount() {
        checkSkipMaxThreadTest();

        Counter c(1);
        Counter c0();
        try {
            while (True) {
                c0.inc();
                on_error {
                    # Capture thread count BEFORE signaling threads to exit
                    # This fixes race condition where threads exit before we can count them
                    limit = num_threads();
                    c.dec();
                    c0.dec();
                }
                background t(c, c0);
            }
        } catch (hash<ExceptionInfo> ex) {
            assertEq("THREAD-CREATION-FAILURE", ex.err, "found thread count limit");
            # Log diagnostic info when thread limit is suspiciously low
            if (limit < 100) {
                printf("WARNING: low thread limit detected: %d\n", limit);
                printf("  exception: %s: %s\n", ex.err, ex.desc);
                # Try to get cgroup pids limit if available
                try {
                    *string pids_max = File::readTextFile("/sys/fs/cgroup/pids.max");
                    printf("  cgroup pids.max: %s", pids_max);
                } catch () {
                    # Try alternate path for cgroup v1
                    try {
                        *string pids_max = File::readTextFile("/sys/fs/cgroup/pids/pids.max");
                        printf("  cgroup pids.max (v1): %s", pids_max);
                    } catch () {
                        # Ignore - cgroup info not available
                    }
                }
            }
        }

        if (m_options.verbose > 2) {
            printf("max threads: %d\n", limit);
        }

        assertGt(100, limit);

        # every thread started has finished
        c0.waitForZero();
    }

    testTidAssignments() {
        checkSkipMaxThreadTest();

        list<int> l;
        Counter c(1);

        code t = sub (Counter c0) {
            l += gettid();
            c0.dec();
            c.waitForZero();
        };

        # this case runs first, so the test's own thread is the only one
        assertEq(1, num_threads(), "no other thread is running");

        try {
            while (True) {
                Counter c0(1);
                background t(c0);
                c0.waitForZero();
            }
        } catch (hash<ExceptionInfo> ex) {
            assertEq("THREAD-CREATION-FAILURE", ex.err, "thread limit for assignment test");
            c.dec();
        }

        assertGt(100, l.size());

        # check TIDs for order
        int last = 0;
        int ooo;
        foreach int tid in (l) {
            if (tid < last) {
                ++ooo;
            }
            last = tid;
        }
        assertTrue(ooo < 2);
    }
}
