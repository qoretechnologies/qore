#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the release of a return value on an exception

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ReturnAfterUnreachableExitTest

#! The value of a return that a handler interrupts is released after the locals, its exit unreachable (#6028)
/** A return statement whose handler ended in a throw or a thread_exit behind an if with a constant condition left its
    Return in a block that the IR optimizer found unreachable and removed: without a Return, the IR interpreter and
    native code no longer took the value for one that the exception interrupts, and released it with the statement's
    temporaries, before the function's locals.  The AST interpreter keeps it until the function ends.
    ReturnAfterUnreachableExit.q gives the output of the AST interpreter in every execution mode and compiled with qcc.
*/
class ReturnAfterUnreachableExitTest inherits QUnit::Test {
    public {
        #! the output of ReturnAfterUnreachableExit.q with the AST interpreter
        const Expected = "a1: [\"x\", \"~a1-z\", \"~a1-t\", \"caught:A1\"] live=0
a1: [\"x\", \"~a1-z\", \"~a1-t\", \"caught:A1\"] live=0
a1: [\"x\", \"~a1-z\", \"~a1-t\", \"caught:A1\"] live=0
a2: [\"s\", \"~a2-z\", \"~a2-t\", \"caught:A2\"] live=0
a2: [\"s\", \"~a2-z\", \"~a2-t\", \"caught:A2\"] live=0
a2: [\"s\", \"~a2-z\", \"~a2-t\", \"caught:A2\"] live=0
a3: [\"x\", \"~a3-z\", \"~a3-t\", \"caught:A3\"] live=0
a3: [\"x\", \"~a3-z\", \"~a3-t\", \"caught:A3\"] live=0
a3: [\"x\", \"~a3-z\", \"~a3-t\", \"caught:A3\"] live=0
a5: [\"x\", \"~a5-z\", \"~a5-t\", \"caught:A5\"] live=0
a5: [\"x\", \"~a5-z\", \"~a5-t\", \"caught:A5\"] live=0
a5: [\"x\", \"~a5-z\", \"~a5-t\", \"caught:A5\"] live=0
a4: [\"x\", \"~a4-z\", \"~a4-t\"] live=0
a4: [\"x\", \"~a4-z\", \"~a4-t\"] live=0
a4: [\"x\", \"~a4-z\", \"~a4-t\"] live=0
";

        #! the optimization levels of the AOT compiles
        const OptLevels = (0, 3);
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string script;
    }

    constructor() : QUnit::Test("ReturnAfterUnreachableExitTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        script = get_script_dir() + "/ReturnAfterUnreachableExit.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": the value of a return after an unreachable exit", \modeTest(), (mode,));
        }
        foreach int opt in (OptLevels) {
            addTestCase(sprintf("qcc -O%d: the value of a return after an unreachable exit", opt), \aotTest(), (opt,));
        }
        set_return_value(main());
    }

    modeTest(string mode) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, script));
        assertEq(Expected, output, mode + ": the output of the AST interpreter");
    }

    aotTest(int opt) {
        TmpDir tmp("qore-return-after-unreachable-exit-");
        string exe = tmp.path + DirSep + "return-after-unreachable-exit";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
            libqore_dir, libqore_dir, exe));
        assertEq(Expected, output, sprintf("qcc -O%d: the output of the AST interpreter", opt));
    }
}
