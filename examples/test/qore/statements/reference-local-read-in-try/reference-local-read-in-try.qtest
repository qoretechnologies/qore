#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of the entry block of a function with a reference parameter

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ReferenceLocalReadInTryTest

#! Regression test for issue #5908: an exception raised by reading a reference local is handled where it is read
/** A local declared with a reference type is read through the reference on every load.  The JIT and AOT code also
    read it once when the function was entered, to initialize a native cache that such a local never uses: when the
    referenced lvalue raised an exception on the read (a reference to an undeclared member of an object of a class with
    declared members raises INVALID-MEMBER), the exception was raised outside the try block of the read and handled by
    the caller.

    ReferenceLocalReadInTry.q reads reference parameters and a local declared as a reference in try blocks, as method
    and function call arguments, and without a handler, and reads and writes a valid reference; its output must be the
    one in ReferenceLocalReadInTry.expected, which the AST interpreter prints, in every execution mode, on the IR tier
    and in programs compiled with qcc -O0 and -O3.
*/
class ReferenceLocalReadInTryTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/ReferenceLocalReadInTry.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/ReferenceLocalReadInTry.expected");
    }

    constructor() : QUnit::Test("reference local read in try block", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/reference-local-read-in-try";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
