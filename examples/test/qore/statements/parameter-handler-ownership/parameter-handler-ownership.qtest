nested-TypedList: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
nested-List: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
nested-AnyList: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
plain-parameter: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
handler-local: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-method: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-static-method: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-closure: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-call-reference: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-no-try-function: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-no-try-method: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-no-try-closure: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
on-error-method: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
