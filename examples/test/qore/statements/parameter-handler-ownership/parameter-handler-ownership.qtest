on-error-AnyHash: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
on-error-TypedList: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
on-error-List: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
on-error-AnyList: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
nested-Object: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
