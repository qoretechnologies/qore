on-error-no-try-closure: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-Object: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-AnyObject: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-TypedHash: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-Hash: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-AnyHash: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-TypedList: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
catch-List: [\"~a\", \"assigned\", \"exit\", \"~b\", \"caught:E\"]
