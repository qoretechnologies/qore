# test-exec-mode: children - checks run in child processes with explicit execution modes
# test-platform: macos - JIT and AOT exception unwinding and handler ownership

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm
%exec-class ParameterHandlerOwnershipTest

#! Replacing a parameter releases its old value at the AST assignment boundary (#6004, #5701)
