#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the exception exit of a handler

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class HandlerClosureLocalRaiseTest

#! A closure-bound local of a handler that raises is released at the end of its block (#6012)
/** The exception exit of a native handler function (tiered after promotion, qcc) released the locals that the
    handler declares (#6002) but not closure-bound ones, which were popped from the closure stack only with the
    function's variables, after the handlers that run after the handler.  HandlerClosureLocalRaise.q gives the output of
    the AST interpreter in every execution mode and compiled with qcc.
*/
class HandlerClosureLocalRaiseTest inherits QUnit::Test {
    public {
        #! the output of HandlerClosureLocalRaise.q with the AST interpreter
        const Expected = "f1: [\"~z1\", \"x\", \"caught:E\"]
f2: [\"~z2\", \"x\", \"caught:E\"]
f3: [\"x\", \"~f3\", \"caught:E\"]
f4: [\"x\", \"caught:E\"]
f4 kept: [\"~z4\"]
f5: [\"~z5-0\", \"~z5-1\", \"x\", \"caught:E\"]
f6: [\"~z6\", \"~y6\", \"x\", \"caught:E\"]
f7: [\"h\", \"~z7\", \"x\", \"caught:E\"]
f8: [\"~z8-0\", \"x0\", \"~z8-1\", \"x1\", \"caught:E0\"]
f9: [\"body\", \"~z9\", \"x\", \"caught:H\"]
f1: [\"~z1\", \"x\", \"caught:E\"]
f2: [\"~z2\", \"x\", \"caught:E\"]
f3: [\"x\", \"~f3\", \"caught:E\"]
f4: [\"x\", \"caught:E\"]
f4 kept: [\"~z4\"]
f5: [\"~z5-0\", \"~z5-1\", \"x\", \"caught:E\"]
f6: [\"~z6\", \"~y6\", \"x\", \"caught:E\"]
f7: [\"h\", \"~z7\", \"x\", \"caught:E\"]
f8: [\"~z8-0\", \"x0\", \"~z8-1\", \"x1\", \"caught:E0\"]
f9: [\"body\", \"~z9\", \"x\", \"caught:H\"]
f1: [\"~z1\", \"x\", \"caught:E\"]
f2: [\"~z2\", \"x\", \"caught:E\"]
f3: [\"x\", \"~f3\", \"caught:E\"]
f4: [\"x\", \"caught:E\"]
f4 kept: [\"~z4\"]
f5: [\"~z5-0\", \"~z5-1\", \"x\", \"caught:E\"]
f6: [\"~z6\", \"~y6\", \"x\", \"caught:E\"]
f7: [\"h\", \"~z7\", \"x\", \"caught:E\"]
f8: [\"~z8-0\", \"x0\", \"~z8-1\", \"x1\", \"caught:E0\"]
f9: [\"body\", \"~z9\", \"x\", \"caught:H\"]
";

        #! the optimization levels of the AOT compiles
        const OptLevels = (0, 3);
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string script;
    }

    constructor() : QUnit::Test("HandlerClosureLocalRaiseTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        script = get_script_dir() + "/HandlerClosureLocalRaise.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": a closure-bound local of a handler that raises", \modeTest(), (mode,));
        }
        foreach int opt in (OptLevels) {
            addTestCase(sprintf("qcc -O%d: a closure-bound local of a handler that raises", opt), \aotTest(),
                (opt,));
        }
        set_return_value(main());
    }

    modeTest(string mode) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, script));
        assertEq(Expected, output, mode + ": the output of the AST interpreter");
    }

    aotTest(int opt) {
        TmpDir tmp("qore-handler-closure-local-raise-");
        string exe = tmp.path + DirSep + "handler-closure-local-raise";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
            libqore_dir, libqore_dir, exe));
        assertEq(Expected, output, sprintf("qcc -O%d: the output of the AST interpreter", opt));
    }
}
