%requires FsUtil
%requires ../../../ExecModeHarness.qm

%include HandlerReturnPastCap.qc

%exec-class HandlerReturnPastCapPart2

#! runs part 2 of 2 of the cases of HandlerReturnPastCapBase: tiered execution and qcc -O0/-O3
class HandlerReturnPastCapPart2 inherits HandlerReturnPastCapBase {
    constructor() : HandlerReturnPastCapBase("HandlerReturnPastCapPart2", 2) {
    }
}
