    foreach auto v in (buf_vals) {
        string s = res(\sw_buf_eq_i0(), v);
        string i = res(\if_buf_eq_i0(), v);
        printf("buf[%d] == 0: %s %s\n", $#, s, i);
        if (s != i) {
            ++mismatches;
        }
    }
    foreach auto v in (buf_vals) {
        string s = res(\sw_buf_eq_f15(), v);
        string i = res(\if_buf_eq_f15(), v);
        printf("buf[%d] == 1.5: %s %s\n", $#, s, i);
        if (s != i) {
            ++mismatches;
        }
    }
    foreach auto v in (buf_vals) {
        string s = res(\sw_buf_eq_n2(), v);
        string i = res(\if_buf_eq_n2(), v);
        printf("buf[%d] == 2n: %s %s\n", $#, s, i);
        if (s != i) {
            ++mismatches;
        }
    }
    foreach auto v in (buf_vals) {
        string s = res(\sw_buf_eq_s1(), v);
        string i = res(\if_buf_eq_s1(), v);
        printf("buf[%d] == '1': %s %s\n", $#, s, i);
        if (s != i) {
            ++mismatches;
        }
    }
    foreach auto v in (buf_vals) {
        string s = res(\sw_buf_eq_sabc(), v);
        string i = res(\if_buf_eq_sabc(), v);
        printf("buf[%d] == 'abc': %s %s\n", $#, s, i);
        if (s != i) {
            ++mismatches;
        }
    }
    foreach auto v in (buf_vals) {
        string s = res(\sw_buf_eq_t(), v);
        string i = res(\if_buf_eq_t(), v);
        printf("buf[%d] == True: %s %s\n", $#, s, i);
        if (s != i) {
            ++mismatches;
        }
    }
    foreach auto v in (buf_vals) {
        string s = res(\sw_buf_eq_d(), v);
        string i = res(\if_buf_eq_d(), v);
        printf("buf[%d] == 2026-01-01: %s %s\n", $#, s, i);
        if (s != i) {
            ++mismatches;
        }
    }
    printf("mismatches: %d\n", mismatches);
    return mismatches;
}

main();
