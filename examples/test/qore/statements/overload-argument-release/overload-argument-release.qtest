#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - checks run in child processes with explicit execution modes
# test-platform: macos - JIT and AOT exception unwinding and handler ownership

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm
%exec-class OverloadArgumentReleaseTest

#! Overload rejection releases argument temporaries before locals and handlers (#6098)
class OverloadArgumentReleaseTest inherits QUnit::Test {
    public {
        const Expected = "object_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
list_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
hash_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
no_throw_count: [\"~v\", \"~t\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR\"] live=0
both_throw_count: [\"dthrow:v\", \"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-v/DT-tt\"] live=0
type_reject: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
invoked: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"inner:RUNTIME-OVERLOAD-ERROR/DT-tt\", \"continued\", \"~z\", \"got\"] live=0
invoked_type: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"inner:RUNTIME-OVERLOAD-ERROR/DT-tt\", \"continued\", \"~z\", \"got\"] live=0
handlers: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"exit\", \"error\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
successful: [\"~q\", \"~z\", \"got\", \"~v\"] live=0
zero_args: [\"~q\", \"~z\", \"outer:ZERO\"] live=0
object_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
list_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
hash_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
no_throw_count: [\"~v\", \"~t\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR\"] live=0
both_throw_count: [\"dthrow:v\", \"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-v/DT-tt\"] live=0
type_reject: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
invoked: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"inner:RUNTIME-OVERLOAD-ERROR/DT-tt\", \"continued\", \"~z\", \"got\"] live=0
invoked_type: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"inner:RUNTIME-OVERLOAD-ERROR/DT-tt\", \"continued\", \"~z\", \"got\"] live=0
handlers: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"exit\", \"error\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
successful: [\"~q\", \"~z\", \"got\", \"~v\"] live=0
zero_args: [\"~q\", \"~z\", \"outer:ZERO\"] live=0
object_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
list_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
hash_count: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
no_throw_count: [\"~v\", \"~t\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR\"] live=0
both_throw_count: [\"dthrow:v\", \"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-v/DT-tt\"] live=0
type_reject: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
invoked: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"inner:RUNTIME-OVERLOAD-ERROR/DT-tt\", \"continued\", \"~z\", \"got\"] live=0
invoked_type: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"inner:RUNTIME-OVERLOAD-ERROR/DT-tt\", \"continued\", \"~z\", \"got\"] live=0
handlers: [\"~v\", \"dthrow:tt\", \"~tt\", \"~q\", \"exit\", \"error\", \"~z\", \"outer:RUNTIME-OVERLOAD-ERROR/DT-tt\"] live=0
successful: [\"~q\", \"~z\", \"got\", \"~v\"] live=0
zero_args: [\"~q\", \"~z\", \"outer:ZERO\"] live=0
";
    }
    private {
        string qore_bin;
        string qcc_bin;
        string prefix;
        string worker;
    }
    constructor() : QUnit::Test("OverloadArgumentReleaseTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? libdir + "/qcc";
        prefix = "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_LIBDIR=" + quote(libdir) + " ";
        worker = get_script_dir() + "/OverloadArgumentRelease.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": rejected argument release", \modeTest(), (mode,));
        }
        addTestCase("tiered IR: rejected argument release", \irTierTest());
        foreach int opt in (0, 3) {
            addTestCase(sprintf("qcc -O%d: rejected argument release", opt), \aotTest(), (opt,));
        }
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string checked(string command, bool ir_tier = False) {
        hash<ExecModeHarness::ModeRunResult> result = ExecModeHarness::run_command(command, False,
            ir_tier ? ExecModeHarness::IRTierEnv : NOTHING);
        assertEq(0, result.rc, sprintf("child exited normally: %s\n%s", command, result.out));
        if (ir_tier) { ExecModeHarness::check_ir_tier(result); }
        else if (result.mode) { ExecModeHarness::check_native(result); }
        return result.out;
    }
    modeTest(string mode) {
        assertEq(Expected, checked(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode="
            + mode + " " + quote(worker)), mode);
    }
    irTierTest() {
        assertEq(Expected, checked(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode=tiered "
            + quote(worker), True), "tiered IR");
    }
    aotTest(int opt) {
        TmpDir tmp("qore-overload-argument-release-");
        string exe = tmp.path + DirSep + "overload-argument-release";
        checked(prefix + quote(qcc_bin) + sprintf(" -O%d -o ", opt) + quote(exe) + " " + quote(worker));
        assertTrue(is_file(exe), "qcc produced the executable");
        assertEq(Expected, checked(prefix + quote(exe) + " -b --enable-debug"), "qcc");
    }
}
