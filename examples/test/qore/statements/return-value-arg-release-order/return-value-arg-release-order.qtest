#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT call helpers releasing a return value and the parameters on an exception

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ReturnValueArgReleaseOrderTest

#! The value of a return that an exception raised after it is released before the arguments of the call (#6039)
/** When the destructor of a local raised an exception after a return, the call helpers of native code
    (qore_rt_call_direct_aot() and the other fast call helpers) released the parameters, which hold the only
    references to the arguments that the call consumed, before the value of the return: a qcc executable ran the
    destructor of a temporary argument before that of the value.  The AST interpreter releases the value first, as
    the caller releases its arguments after the call.  ReturnValueArgReleaseOrder.q gives the output of the AST
    interpreter in every execution mode and compiled with qcc.
*/
class ReturnValueArgReleaseOrderTest inherits QUnit::Test {
    public {
        #! the output of ReturnValueArgReleaseOrder.q with the AST interpreter
        const Expected = "f: [\"~f-d\", \"~f-t\", \"~f-p\", \"caught:DX\"]
ft: [\"~ft-d\", \"~ft-t\", \"~ft-p\", \"caught:DX\"]
fq: [\"~fq-d\", \"~fq-t\", \"~fq-p\", \"caught:DX\"]
fh: [\"~fh-t\", \"~fh-p\", \"caught:HX\"]
fs: [\"~fs-d\", \"~fs-p\", \"caught:DX\"]
m: [\"~m-d\", \"~m-t\", \"~m-p\", \"caught:DX\"]
s: [\"~s-d\", \"~s-t\", \"~s-p\", \"caught:DX\"]
tm: [\"~tm-d\", \"~tm-t\", \"~tm-p\", \"caught:DX\"]
cl: [\"~cl-d\", \"~cl-t\", \"~cl-p\", \"caught:DX\"]
cr: [\"~f-d\", \"~f-t\", \"~cr-p\", \"caught:DX\"]
mr: [\"~m-d\", \"~m-t\", \"~mr-p\", \"caught:DX\"]
rec: [\"~rec-d\", \"~rec-t\", \"~rec-p1\", \"~rec-p\", \"caught:DX\"]
as: [\"~f-d\", \"~f-t\", \"~as-p\", \"caught:DX\"]
lp: [\"~f-d\", \"~f-t\", \"~lp-p\", \"caught:DX\"]
f: [\"~f-d\", \"~f-t\", \"~f-p\", \"caught:DX\"]
ft: [\"~ft-d\", \"~ft-t\", \"~ft-p\", \"caught:DX\"]
fq: [\"~fq-d\", \"~fq-t\", \"~fq-p\", \"caught:DX\"]
fh: [\"~fh-t\", \"~fh-p\", \"caught:HX\"]
fs: [\"~fs-d\", \"~fs-p\", \"caught:DX\"]
m: [\"~m-d\", \"~m-t\", \"~m-p\", \"caught:DX\"]
s: [\"~s-d\", \"~s-t\", \"~s-p\", \"caught:DX\"]
tm: [\"~tm-d\", \"~tm-t\", \"~tm-p\", \"caught:DX\"]
cl: [\"~cl-d\", \"~cl-t\", \"~cl-p\", \"caught:DX\"]
cr: [\"~f-d\", \"~f-t\", \"~cr-p\", \"caught:DX\"]
mr: [\"~m-d\", \"~m-t\", \"~mr-p\", \"caught:DX\"]
rec: [\"~rec-d\", \"~rec-t\", \"~rec-p1\", \"~rec-p\", \"caught:DX\"]
as: [\"~f-d\", \"~f-t\", \"~as-p\", \"caught:DX\"]
lp: [\"~f-d\", \"~f-t\", \"~lp-p\", \"caught:DX\"]
f: [\"~f-d\", \"~f-t\", \"~f-p\", \"caught:DX\"]
ft: [\"~ft-d\", \"~ft-t\", \"~ft-p\", \"caught:DX\"]
fq: [\"~fq-d\", \"~fq-t\", \"~fq-p\", \"caught:DX\"]
fh: [\"~fh-t\", \"~fh-p\", \"caught:HX\"]
fs: [\"~fs-d\", \"~fs-p\", \"caught:DX\"]
m: [\"~m-d\", \"~m-t\", \"~m-p\", \"caught:DX\"]
s: [\"~s-d\", \"~s-t\", \"~s-p\", \"caught:DX\"]
tm: [\"~tm-d\", \"~tm-t\", \"~tm-p\", \"caught:DX\"]
cl: [\"~cl-d\", \"~cl-t\", \"~cl-p\", \"caught:DX\"]
cr: [\"~f-d\", \"~f-t\", \"~cr-p\", \"caught:DX\"]
mr: [\"~m-d\", \"~m-t\", \"~mr-p\", \"caught:DX\"]
rec: [\"~rec-d\", \"~rec-t\", \"~rec-p1\", \"~rec-p\", \"caught:DX\"]
as: [\"~f-d\", \"~f-t\", \"~as-p\", \"caught:DX\"]
lp: [\"~f-d\", \"~f-t\", \"~lp-p\", \"caught:DX\"]
";

        #! the optimization levels of the AOT compiles
        const OptLevels = (0, 3);
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string script;
    }

    constructor() : QUnit::Test("ReturnValueArgReleaseOrderTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        script = get_script_dir() + "/ReturnValueArgReleaseOrder.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": the release order of a return value and the arguments", \modeTest(), (mode,));
        }
        foreach int opt in (OptLevels) {
            addTestCase(sprintf("qcc -O%d: the release order of a return value and the arguments", opt), \aotTest(),
                (opt,));
        }
        set_return_value(main());
    }

    modeTest(string mode) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, script));
        assertEq(Expected, output, mode + ": the output of the AST interpreter");
    }

    aotTest(int opt) {
        TmpDir tmp("qore-return-value-arg-release-order-");
        string exe = tmp.path + DirSep + "return-value-arg-release-order";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
            libqore_dir, libqore_dir, exe));
        assertEq(Expected, output, sprintf("qcc -O%d: the output of the AST interpreter", opt));
    }
}
