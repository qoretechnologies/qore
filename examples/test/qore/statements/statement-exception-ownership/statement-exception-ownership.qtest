#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - checks run in child processes with explicit execution modes
# test-platform: macos - JIT and AOT exception unwinding and handler ownership

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm
%exec-class StatementExceptionOwnershipTest

#! Raising statements release cached local owners before their block handlers (#6007)
class StatementExceptionOwnershipTest inherits QUnit::Test {
    public {
        const Expected = "local-init: [\"~a\", \"exit\", \"~b\", \"caught:E2\"]
return-throw: [\"~a\", \"exit\", \"~b\", \"caught:E2\"]
error-handler: [\"~a\", \"error\", \"~b\", \"caught:E2\"]
rejected-return-exit: [\"~a\", \"exit\", \"caught:RUNTIME-TYPE-ERROR\"]
rejected-return-error: [\"~a\", \"error\", \"caught:RUNTIME-TYPE-ERROR\"]
try-rejected-return: [\"~a\", \"exit\", \"inner:RUNTIME-TYPE-ERROR\", \"result:7\"]
typed-local: [\"~a\", \"exit\", \"caught:RUNTIME-TYPE-ERROR\"]
list-read: [\"~a\", \"exit\", \"caught:E2\"]
hash-read: [\"~a\", \"exit\", \"caught:E2\"]
nested-scopes: [\"~inner\", \"inner-error\", \"~inner2\", \"~outer\", \"outer-exit\", \"~outer2\", \"caught:E2\"]
throwing-destructor: [\"~a\", \"handler:DTOR\", \"handler-end\", \"~b\", \"caught:E2\"]
temporary-read: [\"~temp\", \"exit\", \"caught:E2\"]
local-init: [\"~a\", \"exit\", \"~b\", \"caught:E2\"]
return-throw: [\"~a\", \"exit\", \"~b\", \"caught:E2\"]
error-handler: [\"~a\", \"error\", \"~b\", \"caught:E2\"]
rejected-return-exit: [\"~a\", \"exit\", \"caught:RUNTIME-TYPE-ERROR\"]
rejected-return-error: [\"~a\", \"error\", \"caught:RUNTIME-TYPE-ERROR\"]
try-rejected-return: [\"~a\", \"exit\", \"inner:RUNTIME-TYPE-ERROR\", \"result:7\"]
typed-local: [\"~a\", \"exit\", \"caught:RUNTIME-TYPE-ERROR\"]
list-read: [\"~a\", \"exit\", \"caught:E2\"]
hash-read: [\"~a\", \"exit\", \"caught:E2\"]
nested-scopes: [\"~inner\", \"inner-error\", \"~inner2\", \"~outer\", \"outer-exit\", \"~outer2\", \"caught:E2\"]
throwing-destructor: [\"~a\", \"handler:DTOR\", \"handler-end\", \"~b\", \"caught:E2\"]
temporary-read: [\"~temp\", \"exit\", \"caught:E2\"]
";
    }
    private {
        string qore_bin;
        string qcc_bin;
        string prefix;
        string worker;
    }
    constructor() : QUnit::Test("StatementExceptionOwnershipTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? libdir + "/qcc";
        prefix = "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_LIBDIR=" + quote(libdir) + " ";
        worker = get_script_dir() + "/StatementExceptionOwnership.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": statement exception ownership", \modeTest(), (mode,));
        }
        addTestCase("tiered IR: statement exception ownership", \irTierTest());
        foreach int opt in (0, 3) {
            addTestCase(sprintf("qcc -O%d: statement exception ownership", opt), \aotTest(), (opt,));
        }
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string checked(string command, bool ir_tier = False) {
        hash<ExecModeHarness::ModeRunResult> result = ExecModeHarness::run_command(command, False,
            ir_tier ? ExecModeHarness::IRTierEnv : NOTHING);
        assertEq(0, result.rc, sprintf("child exited normally: %s\n%s", command, result.out));
        if (ir_tier) { ExecModeHarness::check_ir_tier(result); }
        else if (result.mode) { ExecModeHarness::check_native(result); }
        return result.out;
    }
    modeTest(string mode) {
        assertEq(Expected, checked(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode="
            + mode + " " + quote(worker)), mode);
    }
    irTierTest() {
        assertEq(Expected, checked(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode=tiered "
            + quote(worker), True), "tiered IR");
    }
    aotTest(int opt) {
        TmpDir tmp("qore-statement-exception-ownership-");
        string exe = tmp.path + DirSep + "statement-exception";
        checked(prefix + quote(qcc_bin) + sprintf(" -O%d -o ", opt) + quote(exe) + " " + quote(worker));
        assertTrue(is_file(exe), "qcc produced the executable");
        assertEq(Expected, checked(prefix + quote(exe) + " -b --enable-debug"), "qcc");
    }
}
