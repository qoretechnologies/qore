#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the exception paths of handlers

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class HandlerLocalReleaseTest

#! The locals that a handler declares are released at the end of their blocks when the handler raises (#6002)
/** A local declared in an on_exit or on_error handler that raised an exception was released after the handlers that
    ran after it: in the IR interpreter and in native code when the handler ran out of line, where the local was taken
    for a variable of the function, and in native code when the handler was lowered inline in the function, where
    the handler's block had no exception path of its own.  The AST interpreter releases it at the end of its block.
    A container local of a handler run out of line that the handler changes in place keeps its value in native code
    (h8, which the first version of the fix broke).
    HandlerLocalRelease.q gives the output of the AST interpreter in every execution mode and compiled with qcc.
*/
class HandlerLocalReleaseTest inherits QUnit::Test {
    public {
        #! the output of HandlerLocalRelease.q with the AST interpreter
        const Expected = "h1: [\"~h1-z\", \"x\", \"caught:E1\"]
h1: [\"~h1-z\", \"x\", \"caught:E1\"]
h2: [\"~h2-z\", \"x\", \"caught:E2\"]
h2: [\"~h2-z\", \"x\", \"caught:E2\"]
h3: [\"n\", \"~h3-z\", \"x\", \"~h3-a\", \"caught:H3\"]
h3: [\"n\", \"~h3-z\", \"x\", \"~h3-a\", \"caught:H3\"]
h5: [\"~h5-b\", \"catch:X\", \"h2\", \"n:h5-a\", \"~h5-z\", \"h1:h5-a\", \"~h5-a\", \"caught:X\"]
h5: [\"~h5-b\", \"catch:X\", \"h2\", \"n:h5-a\", \"~h5-z\", \"h1:h5-a\", \"~h5-a\", \"caught:X\"]
h6: [\"~h6-z\", \"x\", \"caught:H6\"]
h6: [\"~h6-z\", \"x\", \"caught:H6\"]
h7: [\"~h7-z0\", \"~h7-z1\", \"x\", \"caught:H7\"]
h7: [\"~h7-z0\", \"~h7-z1\", \"x\", \"caught:H7\"]
h8: [\"l: [1] h: {a: 1}\", \"caught:E8\"]
h8: [\"l: [1] h: {a: 1}\", \"caught:E8\"]
";

        #! the optimization levels of the AOT compiles
        const OptLevels = (0, 3);
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string script;
    }

    constructor() : QUnit::Test("HandlerLocalReleaseTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        script = get_script_dir() + "/HandlerLocalRelease.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": the release of the locals of a handler that raises", \modeTest(), (mode,));
        }
        foreach int opt in (OptLevels) {
            addTestCase(sprintf("qcc -O%d: the release of the locals of a handler that raises", opt), \aotTest(),
                (opt,));
        }
        set_return_value(main());
    }

    modeTest(string mode) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, script));
        assertEq(Expected, output, mode + ": the output of the AST interpreter");
    }

    aotTest(int opt) {
        TmpDir tmp("qore-handler-local-release-");
        string exe = tmp.path + DirSep + "handler-local-release";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
            libqore_dir, libqore_dir, exe));
        assertEq(Expected, output, sprintf("qcc -O%d: the output of the AST interpreter", opt));
    }
}
