%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%include HandlerReturnPastCapFlow.qc

%exec-class HandlerReturnPastCapFlowPart2

#! runs part 2 of 2 of the cases of HandlerReturnPastCapFlowBase: tiered execution and qcc -O0/-O3
class HandlerReturnPastCapFlowPart2 inherits HandlerReturnPastCapFlowBase {
    constructor() : HandlerReturnPastCapFlowBase("HandlerReturnPastCapFlowPart2", 2) {
    }
}
