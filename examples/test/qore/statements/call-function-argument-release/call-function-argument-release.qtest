#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - checks run in child processes with explicit execution modes
# test-platform: macos - JIT and AOT exception unwinding and handler ownership

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm
%exec-class CallFunctionArgumentReleaseTest

#! Argument cleanup errors release the call result before locals and handlers (#6093)
class CallFunctionArgumentReleaseTest inherits QUnit::Test {
    public {
        const Expected = "ref_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
named_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
list_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
hash_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
caught_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"inner:DT\", \"continued\", \"~z\", \"got\"] live=0
handlers: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"exit\", \"error\", \"~z\", \"caught:DT\"] live=0
assigned: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
discarded: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
result_raises: [\"dthrow\", \"~tt\", \"dthrow\", \"~v\", \"~q\", \"~z\", \"caught:DT\", \"next:RESULT\"] live=0
call_raises: [\"~v\", \"~t\", \"~q\", \"~z\", \"caught:CALL\"] live=0
direct_control: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
statement_control: [\"dthrow\", \"~tt\", \"~q\", \"~z\", \"~v\", \"caught:DT\"] live=0
success_control: [\"~t\", \"~q\", \"~z\", \"got\", \"~v\"] live=0
ref_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
named_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
list_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
hash_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
caught_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"inner:DT\", \"continued\", \"~z\", \"got\"] live=0
handlers: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"exit\", \"error\", \"~z\", \"caught:DT\"] live=0
assigned: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
discarded: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
result_raises: [\"dthrow\", \"~tt\", \"dthrow\", \"~v\", \"~q\", \"~z\", \"caught:DT\", \"next:RESULT\"] live=0
call_raises: [\"~v\", \"~t\", \"~q\", \"~z\", \"caught:CALL\"] live=0
direct_control: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
statement_control: [\"dthrow\", \"~tt\", \"~q\", \"~z\", \"~v\", \"caught:DT\"] live=0
success_control: [\"~t\", \"~q\", \"~z\", \"got\", \"~v\"] live=0
ref_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
named_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
list_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
hash_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
caught_return: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"inner:DT\", \"continued\", \"~z\", \"got\"] live=0
handlers: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"exit\", \"error\", \"~z\", \"caught:DT\"] live=0
assigned: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
discarded: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
result_raises: [\"dthrow\", \"~tt\", \"dthrow\", \"~v\", \"~q\", \"~z\", \"caught:DT\", \"next:RESULT\"] live=0
call_raises: [\"~v\", \"~t\", \"~q\", \"~z\", \"caught:CALL\"] live=0
direct_control: [\"dthrow\", \"~tt\", \"~v\", \"~q\", \"~z\", \"caught:DT\"] live=0
statement_control: [\"dthrow\", \"~tt\", \"~q\", \"~z\", \"~v\", \"caught:DT\"] live=0
success_control: [\"~t\", \"~q\", \"~z\", \"got\", \"~v\"] live=0
";
    }
    private {
        string qore_bin;
        string qcc_bin;
        string prefix;
        string worker;
    }
    constructor() : QUnit::Test("CallFunctionArgumentReleaseTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? libdir + "/qcc";
        prefix = "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_LIBDIR=" + quote(libdir) + " ";
        worker = get_script_dir() + "/CallFunctionArgumentRelease.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": call argument release", \modeTest(), (mode,));
        }
        addTestCase("tiered IR: call argument release", \irTierTest());
        foreach int opt in (0, 3) {
            addTestCase(sprintf("qcc -O%d: call argument release", opt), \aotTest(), (opt,));
        }
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string checked(string command, bool ir_tier = False) {
        hash<ExecModeHarness::ModeRunResult> result = ExecModeHarness::run_command(command, False,
            ir_tier ? ExecModeHarness::IRTierEnv : NOTHING);
        assertEq(0, result.rc, sprintf("child exited normally: %s\n%s", command, result.out));
        if (ir_tier) { ExecModeHarness::check_ir_tier(result); }
        else if (result.mode) { ExecModeHarness::check_native(result); }
        return result.out;
    }
    modeTest(string mode) {
        assertEq(Expected, checked(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode="
            + mode + " " + quote(worker)), mode);
    }
    irTierTest() {
        assertEq(Expected, checked(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode=tiered "
            + quote(worker), True), "tiered IR");
    }
    aotTest(int opt) {
        TmpDir tmp("qore-call-function-argument-release-");
        string exe = tmp.path + DirSep + "call-function-argument-release";
        checked(prefix + quote(qcc_bin) + sprintf(" -O%d -o ", opt) + quote(exe) + " " + quote(worker));
        assertTrue(is_file(exe), "qcc produced the executable");
        assertEq(Expected, checked(prefix + quote(exe) + " -b --enable-debug"), "qcc");
    }
}
