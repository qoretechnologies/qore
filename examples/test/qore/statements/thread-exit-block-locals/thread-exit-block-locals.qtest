#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of a thread_exit leaving blocks with locals and handlers

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class ThreadExitBlockLocalsTest

#! A thread_exit releases the locals of the blocks that it leaves before the handlers of enclosing blocks (#6041)
/** A thread_exit in a block without handlers released the block's locals after the on_exit handlers of an enclosing
    block in every execution mode but ast and with qcc; the AST interpreter releases them as the thread_exit leaves
    their block, as it does for an exception.  Fixed by 77284a92f3 (#5912), with which a thread_exit leaves the blocks
    of the frame through their exits; this test covers the order.  ThreadExitBlockLocals.q gives the output of the AST
    interpreter in every execution mode and compiled with qcc.
*/
class ThreadExitBlockLocalsTest inherits QUnit::Test {
    public {
        #! the output of ThreadExitBlockLocals.q with the AST interpreter
        const Expected = "[\"~d2\", \"~d\", \"eh\"]
[\"~fd\", \"fh\"]
[\"~gc\", \"~gb\", \"gh\", \"~ga\"]
[\"~hd\", \"hh\", \"caught:X\"]
[\"~ld0\", \"lh0\", \"~ld1\", \"lh1\"]
[\"~d2\", \"~d\", \"eh\"]
[\"~fd\", \"fh\"]
[\"~gc\", \"~gb\", \"gh\", \"~ga\"]
[\"~hd\", \"hh\", \"caught:X\"]
[\"~ld0\", \"lh0\", \"~ld1\", \"lh1\"]
[\"~d2\", \"~d\", \"eh\"]
[\"~fd\", \"fh\"]
[\"~gc\", \"~gb\", \"gh\", \"~ga\"]
[\"~hd\", \"hh\", \"caught:X\"]
[\"~ld0\", \"lh0\", \"~ld1\", \"lh1\"]
";

        #! the optimization levels of the AOT compiles
        const OptLevels = (0, 3);
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string script;
    }

    constructor() : QUnit::Test("ThreadExitBlockLocalsTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        script = get_script_dir() + "/ThreadExitBlockLocals.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": the locals that a thread_exit leaves before the handlers", \modeTest(), (mode,));
        }
        foreach int opt in (OptLevels) {
            addTestCase(sprintf("qcc -O%d: the locals that a thread_exit leaves before the handlers", opt), \aotTest(),
                (opt,));
        }
        set_return_value(main());
    }

    modeTest(string mode) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, script));
        assertEq(Expected, output, mode + ": the output of the AST interpreter");
    }

    aotTest(int opt) {
        TmpDir tmp("qore-thread-exit-block-locals-");
        string exe = tmp.path + DirSep + "thread-exit-block-locals";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
            libqore_dir, libqore_dir, exe));
        assertEq(Expected, output, sprintf("qcc -O%d: the output of the AST interpreter", opt));
    }
}
