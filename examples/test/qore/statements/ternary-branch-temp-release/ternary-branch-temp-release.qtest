#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the release of temporaries on an exception edge

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class TernaryBranchTempReleaseTest

#! A temporary of a call in a branch of ?: that an exception interrupts is released before the block's locals (#5997)
/** Native code lowers the blocks of a function in layout order, and the continuation blocks of the calls in a branch
    of ?: (or ??, ?*, &&) come after the join block of the operator, which ends the statement and closes its temp
    scope: the exception edge of a call in such a block found no open scope and released none of the statement's
    temporaries, which the exit of the try block or of the function released after the locals.  The AST interpreter
    and the IR interpreter release them first.  TernaryBranchTempRelease.q gives the output of the AST interpreter in
    every execution mode and compiled with qcc.
*/
class TernaryBranchTempReleaseTest inherits QUnit::Test {
    public {
        #! the output of TernaryBranchTempRelease.q with the AST interpreter
        const Expected = "plain: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
ternary: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
ternary-else: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
both-1: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
both-2: [\"~b\", \"~z\", \"c\", \"~o\"] live=0
arg-list: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
nested: [\"~a\", \"~w\", \"~z\", \"c\", \"~o\"] live=0
nested-call: [\"~b\", \"~a\", \"~z\", \"c\", \"~o\"] live=0
null-coalescing: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
value-coalescing: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
assignment: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
call-arg: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
logical-and: [\"~a\", \"~z\", \"c\", \"~o\"] live=0
loop: [\"~a0\", \"~z0\", \"c0\", \"~a1\", \"~z1\", \"c1\"] live=0
caller-return: [\"~a\", \"~z\", \"c\"] live=0
caller-assign: [\"~a\", \"~z\", \"c\"] live=0
";

        #! the optimization levels of the AOT compiles
        const OptLevels = (0, 3);
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string script;
    }

    constructor() : QUnit::Test("TernaryBranchTempReleaseTest", "1.0") {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        script = get_script_dir() + "/TernaryBranchTempRelease.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(mode + ": the release of the temporaries of a branch of ?: on an exception", \modeTest(),
                (mode,));
        }
        foreach int opt in (OptLevels) {
            addTestCase(sprintf("qcc -O%d: the release of the temporaries of a branch of ?: on an exception", opt),
                \aotTest(), (opt,));
        }
        set_return_value(main());
    }

    modeTest(string mode) {
        string output = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --exec-mode=%s %s",
            libqore_dir, libqore_dir, qore_bin, mode, script));
        assertEq(Expected, output, mode + ": the output of the AST interpreter");
    }

    aotTest(int opt) {
        TmpDir tmp("qore-ternary-branch-temp-release-");
        string exe = tmp.path + DirSep + "ternary-branch-temp-release";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O%d -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
            script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        string output = ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
            libqore_dir, libqore_dir, exe));
        assertEq(Expected, output, sprintf("qcc -O%d: the output of the AST interpreter", opt));
    }
}
