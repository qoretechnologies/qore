%modern

module TestBuildTools {
    version = "1.0";
    desc    = "finds the build tools (compilers, qcc, readelf) that the tests run";
    author  = "David Nichols <david@qore.org>";
    url     = "http://qore.org";
    license = "MIT";
}

/** A test that builds a program with a compiler skips only when the compiler is not there: any other failure of the
    build is a failure of the test.  A tool is found as the shell that runs it finds it (\c command \c -v), so the
    shell's default search path applies when \c PATH is not set, and a tool that the shell would run is never taken
    as missing.

    @par Example:
    @code{.py}
%requires ../TestBuildTools.qm

list<string> cxx = TestBuildTools::command_words(ENV.CXX, "c++");
if (!TestBuildTools::find_command(cxx[0])) {
    testSkip(sprintf("no C++ compiler: %y is not available", cxx[0]));
}
    @endcode
*/
public namespace TestBuildTools {
    #! Returns the words of a command line given in an environment variable, such as \c CC or \c CXX
    /** @param cmd the command line, which can name a launcher before the tool (ex: \c "ccache c++"); words are
        separated by whitespace
        @param default_cmd the command line used when \a cmd is not set, or is empty or only whitespace

        @return the words of the command line; never empty when \a default_cmd has a word
    */
    public list<string> sub command_words(*string cmd, string default_cmd) {
        list<string> words = TestBuildTools::split_words(cmd ?? "");
        return words ? words : TestBuildTools::split_words(default_cmd);
    }

    #! Returns the path of the command as the shell finds it, or NOTHING if the shell cannot run it
    /** @param name a command name, found in the shell's search path (\c PATH, or the shell's default search path when
        \c PATH is not set), or a path, which must be an executable file

        @return the path of the command, or NOTHING if it cannot be run
    */
    public *string sub find_command(string name) {
        if (!name.val()) {
            return;
        }
        if (name =~ /\//) {
            return is_executable(name) ? name : NOTHING;
        }
        int status;
        string output = backquote("command -v " + TestBuildTools::shell_quote(name) + " 2>/dev/null", \status);
        if (status) {
            return;
        }
        *string path = (output =~ x/^([^\n]+)/)[0];
        # a shell builtin or function is reported by its name; only a file is a tool
        return (path && path =~ /\// && is_executable(path)) ? path : NOTHING;
    }

    #! Quotes a word for the shell
    public string sub shell_quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    #! Returns the words of the string, separated by whitespace
    public list<string> sub split_words(string str) {
        *list<*string> words = (str =~ x/(\S+)/g);
        return words ? (map $1, words, $1) : ();
    }
}
