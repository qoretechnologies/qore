%modern

module cppapisrc {
    version = "1.0";
    desc = "Qore-language test module: a module with no C++ code at all, so that "
        "q_get_module_cpp_api() can be tested against one";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! namespace for the cppapisrc test module
public namespace CppApiSrc {
    #! proves the module really loaded before it is used as a negative test case
    public const CppApiSrcMarker = "cppapisrc";
}
