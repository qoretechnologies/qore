%modern

# the "cppapiuser" test module is built into the build tree by examples/test/module-cpp-api/CMakeLists.txt and is
# not installed, so QORE_MODULE_DIR must include the build tree (run_tests.sh does this)
%requires cppapiuser
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class ModulePollableTest

#! The bound on every blocking wait in this test: a hang guard only, never a timing assertion
const HangGuard = 60s;

#! A poll operation that waits once for its pollable object to become readable
class WaitOnceOperation inherits AbstractPollOperation<auto> {
    private {
        AbstractPollableIoObjectBase io;
        bool waited = False;
        bool done = False;
    }

    constructor(AbstractPollableIoObjectBase io) {
        self.io = io;
    }

    string getGoal() {
        return "wait-once";
    }

    string getState() {
        return done ? "done" : "waiting";
    }

    bool goalReached() {
        return done;
    }

    *hash<SocketPollInfo> continuePoll() {
        if (!waited) {
            waited = True;
            return <SocketPollInfo>{
                "events": SOCK_POLLIN,
                "socket": io,
            };
        }
        done = True;
        return NOTHING;
    }
}

#! Tests that a class in a binary module can implement the C++ pollable I/O interface
/** AbstractPollableIoObjectBase's constructor was not exported, so no binary module could derive the class: a
    module's pollable objects could only implement the %Qore-level interface, whose descriptor
    @ref Qore::Socket::poll() "Socket::poll()" waits on by number, with no hold, so a close made by another thread
    while the async I/O controller had the number registered let another file or socket reuse it.
*/
class ModulePollableTest inherits QUnit::Test {
    constructor() : QUnit::Test("module-pollable", "1.0", \ARGV) {
        addTestCase("a module class derives the C++ pollable base class", \deriveTest());
        addTestCase("Socket::poll() waits on a module pollable with the module's hold", \socketPollTest());
        addTestCase("a module pollable closed while the controller waits on it keeps its descriptor until the "
            "controller stops waiting", \closeWhileRegisteredTest());
        addTestCase("Socket::poll() waits for the extra descriptors of a pollable without a descriptor",
            \noDescriptorExtraFdsTest());
        addTestCase("Socket::poll() honours the poll timeout of a pollable without a descriptor",
            \noDescriptorPollTimeoutTest());
        addTestCase("Socket::poll() refuses a pollable without a descriptor, extra descriptors or a poll timeout",
            \noDescriptorRefusedTest());
        set_return_value(main());
    }

    deriveTest() {
        CppApiTest::PollableProbe probe();
        on_exit probe.close();
        assertTrue(probe instanceof AbstractPollableIoObjectBase, "the module class is a C++ pollable");
        assertGe(0, probe.getPollableDescriptor(), "the module object reports its descriptor");
    }

    socketPollTest() {
        CppApiTest::PollableProbe probe();
        on_exit probe.close();
        probe.signal();
        list<hash<SocketPollInfo>> ready = Socket::poll((<SocketPollInfo>{
            "events": SOCK_POLLIN,
            "socket": probe,
        },), HangGuard);
        assertEq(1, ready.size(), "the readable module pollable is reported");
        assertEq(SOCK_POLLIN, ready[0].events & SOCK_POLLIN, "the module pollable is readable");
        assertGt(0, probe.getHoldCount(), "the async I/O controller registered the descriptor with the module's hold");
    }

    noDescriptorExtraFdsTest() {
        # an object without a descriptor, as a socket whose connection resolves the name of its host, whose poll info
        # gives the descriptor of the resolver as an extra descriptor
        CppApiTest::PollableProbe resolving();
        resolving.close();
        CppApiTest::PollableProbe resolver();
        on_exit resolver.close();
        hash<SocketPollInfo> waiting = <SocketPollInfo>{
            "events": SOCK_POLLIN,
            "socket": resolving,
            "extra_fds": (<ExtraPollFdInfo>{"fd": resolver.getPollableDescriptor(), "events": SOCK_POLLIN},),
            "poll_timeout_ms": HangGuard.durationMilliseconds(),
        };
        resolver.signal();
        list<hash<SocketPollInfo>> ready = Socket::poll((waiting,), HangGuard);
        assertEq(1, ready.size(), "the element is reported with its ready extra descriptor");
        assertEq(SOCK_POLLIN, ready[0].events, "the events of the extra descriptor, and none for the object");
        assertEq(resolving, ready[0].socket, "the element's object");

        # with another element whose object is ready, the element without a descriptor is not reported as closed
        CppApiTest::PollableProbe idle();
        on_exit idle.close();
        CppApiTest::PollableProbe open();
        on_exit open.close();
        open.signal();
        waiting.extra_fds = (<ExtraPollFdInfo>{"fd": idle.getPollableDescriptor(), "events": SOCK_POLLIN},);
        ready = Socket::poll((waiting, <SocketPollInfo>{"events": SOCK_POLLIN, "socket": open}), HangGuard);
        assertEq(1, ready.size(), "only the ready object is reported");
        assertEq(open, ready[0].socket, "the ready object");
    }

    noDescriptorPollTimeoutTest() {
        CppApiTest::PollableProbe resolving();
        resolving.close();
        # only a poll timeout: the poll waits for it and reports nothing
        list<hash<SocketPollInfo>> ready = Socket::poll((<SocketPollInfo>{
            "events": SOCK_POLLIN,
            "socket": resolving,
            "poll_timeout_ms": 10,
        },), HangGuard);
        assertEq((), ready, "nothing is reported when the poll timeout expires");

        # an extra descriptor that does not become ready: the poll timeout ends the wait
        CppApiTest::PollableProbe idle();
        on_exit idle.close();
        ready = Socket::poll((<SocketPollInfo>{
            "events": SOCK_POLLIN,
            "socket": resolving,
            "extra_fds": (<ExtraPollFdInfo>{"fd": idle.getPollableDescriptor(), "events": SOCK_POLLIN},),
            "poll_timeout_ms": 10,
        },), HangGuard);
        assertEq((), ready, "nothing is reported when the poll timeout expires before the extra descriptor");
    }

    noDescriptorRefusedTest() {
        CppApiTest::PollableProbe closed();
        closed.close();
        assertThrows("SOCKET-NOT-OPEN", \Socket::poll(), ((<SocketPollInfo>{
            "events": SOCK_POLLIN,
            "socket": closed,
        },), HangGuard), "a closed object with nothing else to wait for");
    }

    closeWhileRegisteredTest() {
        CppApiTest::PollableProbe probe();
        on_exit probe.close();
        WaitOnceOperation op(probe);
        Queue<hash<SocketPollResultInfo>> rq = AsyncIoController::submit(<SocketPollOperationInfo>{
            "sock": probe,
            "spop": op,
            "owner": sprintf("module-pollable-%d", getpid()),
            "to": -1,
        });

        # the controller takes the hold when it registers the descriptor; nothing makes the pipe readable, so the
        # registration stays until the pipe is signaled below
        assertTrue(probe.waitForHold(HangGuard), "the controller registered the descriptor with the module's hold");
        probe.close();
        assertEq(-1, probe.getPollableDescriptor(), "the closed object has no descriptor");
        assertFalse(probe.isDescriptorClosed(),
            "the descriptor stays open while the controller has it registered, so its number cannot be reused");

        # the event ends the operation, and the controller removes the registration and releases its hold
        probe.signal();
        hash<SocketPollResultInfo> result = rq.get(HangGuard);
        assertNothing(result.ex, "the operation completed without an error");
        assertTrue(op.goalReached(), "the operation saw the event");
        assertTrue(probe.isDescriptorClosed(), "the descriptor is closed once the controller stopped waiting on it");
    }
}
