%modern

# the "cppapiuser" test module is built into the build tree by examples/test/module-cpp-api/CMakeLists.txt and is
# not installed, so QORE_MODULE_DIR must include the build tree (run_tests.sh does this)
%requires cppapiuser
%requires json
%requires dataframe
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/QUnit.qm

%exec-class ModuleSymbolVisibilityTest

#! tests the symbol visibility of the binary modules built with Qore
/** DLLLOCAL and DLLEXPORT (include/qore/common.h) mark visibility only where HAVE_GCC_VISIBILITY is defined.  The
    binary modules built with Qore had no definition of it, so every symbol they define was exported; binary modules
    are loaded with their symbols available to the whole process, where one module's internal symbol could be bound
    in place of another's.
*/
class ModuleSymbolVisibilityTest inherits QUnit::Test {
    constructor() : QUnit::Test("module-symbol-visibility", "1.0", \ARGV) {
        addTestCase("module internals are not exported", \internalTest());
        addTestCase("module interfaces are exported", \interfaceTest());
        set_return_value(main());
    }

    #! a symbol a module declares DLLLOCAL is not exported
    internalTest() {
        # initJsonStreamWriterClass(QoreNamespace&), declared DLLLOCAL in modules/json/src/QC_JsonStreamWriter.h and
        # defined in the json module
        assertFalse(cpp_api_symbol_exported("_Z25initJsonStreamWriterClassR13QoreNamespace"),
            "a DLLLOCAL function of the json module");
    }

    #! the symbols other code finds by name stay exported
    interfaceTest() {
        # the module's entry point, which the module loader resolves
        assertTrue(cpp_api_symbol_exported("json_qore_module_desc"), "json module entry point");
        # the module's C++ API, which q_get_module_cpp_api() resolves for other modules
        assertTrue(cpp_api_symbol_exported("json_qore_cpp_api"), "json module C++ API");
        # a runtime helper of a plugin opcode, which the plugin registry resolves by the name the module registers
        assertTrue(cpp_api_symbol_exported("dataframe_slice"), "dataframe plugin runtime helper");
        # a name no object defines
        assertFalse(cpp_api_symbol_exported("qore_no_such_symbol_in_any_module"), "an undefined name");
    }
}
