namespace {
// a pipe whose descriptors are closed when it goes out of scope
class TestPipe {
public:
    TestPipe(ExceptionSink* xsink) {
        if (pipe(fds)) {
            fds[0] = fds[1] = -1;
            xsink->raiseErrnoException("PIPE-ERROR", errno, "pipe() failed");
        }
    }

    ~TestPipe() {
        if (fds[0] != -1) {
            close(fds[0]);
            close(fds[1]);
        }
    }

    // makes the read end readable; returns 0 for success
    int fill(ExceptionSink* xsink) {
        char c = 'x';
        if (write(fds[1], &c, 1) != 1) {
            xsink->raiseErrnoException("PIPE-ERROR", errno, "write() failed");
            return -1;
        }
        return 0;
    }

    int readFd() const {
        return fds[0];
    }

    TestPipe(const TestPipe&) = delete;
    TestPipe& operator=(const TestPipe&) = delete;

private:
    int fds[2];
};

// returns the time remaining until a deadline for poll(): -1 for no timeout, 0 if it has passed
int remaining_ms(int timeout_ms, int64 deadline_us) {
    if (timeout_ms < 0) {
        return -1;
    }
    int64 us = deadline_us - q_get_monotonic_us();
    return us <= 0 ? 0 : static_cast<int>((us + 999) / 1000);
}

// the file that records the children created with fork(); -1 until cpp_api_record_fork_children() is called
std::atomic<int> fork_child_fd(-1);

// appends one byte to the record file in each child created with fork() (write() is async-signal-safe)
void record_fork_child() {
    int fd = fork_child_fd.load(std::memory_order_relaxed);
    if (fd >= 0) {
        char c = 'f';
        // nothing can be reported in a forked child; a short write only loses a record
        ssize_t rc = write(fd, &c, 1);
        (void)rc;
    }
}

// waits for a child process; returns its exit status, -1 if it did not exit normally, or -2 if waitpid() failed
// (errno is then set)
int wait_child(pid_t pid) {
    int status = 0;
    while (waitpid(pid, &status, 0) < 0) {
        if (errno != EINTR) {
            return -2;
        }
    }
    return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
}

// the exit status of a child process that changed and read the environment as expected
constexpr int ENV_CHILD_OK = 0;
// the exit status of a child process that could not change the environment
constexpr int ENV_CHILD_SET_FAILED = 2;
// the exit status of a child process that read another value than it set
constexpr int ENV_CHILD_WRONG_VALUE = 3;

// in a child process: sets the variable and reads it back; returns the exit status for the parent
int env_child_set_and_check(const char* name, const char* value) {
    if (SystemEnvironment::set(name, value)) {
        return ENV_CHILD_SET_FAILED;
    }
    QoreEnvironmentValue v(name);
    return v && v.str() == value ? ENV_CHILD_OK : ENV_CHILD_WRONG_VALUE;
}

// holds the environment lock in another thread until it is released; the thread is always joined
class EnvLockHolderThread {
public:
    EnvLockHolderThread(bool exclusive) : release_future(release.get_future()) {
        std::future<void> held_future = held.get_future();
        holder = std::thread([this, exclusive]() {
            if (exclusive) {
                AtomicEnvironmentSetter env_lock;
                held.set_value();
                release_future.wait();
            } else {
                QoreEnvironmentReadLock env_lock;
                held.set_value();
                release_future.wait();
            }
        });
        held_future.wait();
    }

    ~EnvLockHolderThread() {
        signalRelease();
        if (holder.joinable()) {
            holder.join();
        }
    }

    //! tells the holder to release the lock; does not wait for it
    void signalRelease() {
        if (!released) {
            released = true;
            release.set_value();
        }
    }

    EnvLockHolderThread(const EnvLockHolderThread&) = delete;
    EnvLockHolderThread& operator=(const EnvLockHolderThread&) = delete;

private:
    std::promise<void> held;
    std::promise<void> release;
    std::future<void> release_future;
    std::thread holder;
    bool released = false;
};

// the owner of the external data that tests the lock order of the copy of a Program's external data
constexpr const char* ExtDataOwner = "cppapiuser-lock-order";

// the lock of the module that copy() takes, as a module's copy() takes its own locks
std::mutex ext_data_module_lock;

// the state of the copies, so that a test knows when a copy() is running
struct ExtDataCopyState {
    std::mutex m;
    std::condition_variable cv;
    bool in_copy = false;
    int copies = 0;
};
ExtDataCopyState ext_data_copy_state;

// external data whose copy() takes the module's lock
class LockingExtData : public AbstractQoreProgramExternalData {
public:
    AbstractQoreProgramExternalData* copy(QoreProgram* pgm) const override {
        {
            std::lock_guard<std::mutex> lg(ext_data_copy_state.m);
            ext_data_copy_state.in_copy = true;
            ++ext_data_copy_state.copies;
            ext_data_copy_state.cv.notify_all();
        }
        std::lock_guard<std::mutex> lg(ext_data_module_lock);
        return new LockingExtData;
    }

    void doDeref() override {
        delete this;
    }
};
}

/** @defgroup cppapiuser_functions cppapiuser Test Module Functions
    Drivers that let examples/test/module-cpp-api/module-cpp-api.qtest exercise
    q_get_module_cpp_api() and a resolved C++ API struct from Qore-language code.
*/
///@{
namespace Qore::CppApiTest;

//! resolves any module's C++ API and returns the version of the struct the module published
/** @param feature the feature name of the module publishing the API
    @param major the major version to request
    @param minor the minimum minor version to request

    @return a hash with \c major and \c minor keys taken from the resolved struct's header

    @throw LOAD-MODULE-ERROR the module could not be found or loaded
    @throw MODULE-CPP-API-ERROR the module exports no C++ API
    @throw MODULE-CPP-API-VERSION-ERROR the module cannot serve the requested version
*/
hash<auto> cpp_api_resolve(string feature, int major, int minor) [flags=RET_VALUE_ONLY] {
    const void* api = q_get_module_cpp_api(feature->c_str(), static_cast<unsigned>(major),
        static_cast<unsigned>(minor), xsink);
    if (!api) {
        assert(*xsink);
        return QoreValue();
    }
    const QoreModuleCppApiHeader* hdr = reinterpret_cast<const QoreModuleCppApiHeader*>(api);
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    rv->setKeyValue("major", static_cast<int64>(hdr->major), xsink);
    rv->setKeyValue("minor", static_cast<int64>(hdr->minor), xsink);
    return rv.release();
}

//! returns the sum of the arguments, computed by the cppapitest module through its C++ API
/** @param a the first addend
    @param b the second addend

    @return the sum of \a a and \a b
*/
int cpp_api_add(int a, int b) [flags=RET_VALUE_ONLY] {
    const QoreCppApiTestApi* api = cppapiuser_get_api(xsink);
    if (!api) {
        return QoreValue();
    }
    return api->add(a, b);
}

//! returns the argument reversed, computed by the cppapitest module through its C++ API
/** @param str the string to reverse

    @return \a str reversed
*/
string cpp_api_reverse(string str) [flags=RET_VALUE_ONLY] {
    const QoreCppApiTestApi* api = cppapiuser_get_api(xsink);
    if (!api) {
        return QoreValue();
    }
    return api->reverse(*str, xsink);
}

//! adds each element of \a vals to an opaque counter handle owned by the cppapitest module
/** Exercises an opaque handle crossing the module boundary with the explicit \c ref and \c deref
    members of the API struct.

    @param vals the values to add to the counter
    @param extra_ref if @ref True "True", takes an extra reference to the handle and releases it
    again, so that reference counting across the boundary is exercised in both directions

    @return the counter's final value
*/
int cpp_api_counter_roundtrip(list<int> vals, bool extra_ref = False) [flags=RET_VALUE_ONLY] {
    const QoreCppApiTestApi* api = cppapiuser_get_api(xsink);
    if (!api) {
        return QoreValue();
    }
    CounterHolder c(api, api->counter_create(0));
    if (extra_ref) {
        api->counter_ref(*c);
    }
    int64 rv = 0;
    ConstListIterator i(vals);
    while (i.next()) {
        rv = api->counter_add(*c, i.getValue().getAsBigInt());
    }
    if (extra_ref) {
        api->counter_deref(*c);
    }
    return rv;
}

//! returns the number of counter handles the cppapitest module currently has allocated
/** @return the number of live counter handles; zero unless a handle has been leaked
*/
int cpp_api_counter_live_count() [flags=RET_VALUE_ONLY] {
    const QoreCppApiTestApi* api = cppapiuser_get_api(xsink);
    if (!api) {
        return QoreValue();
    }
    return api->counter_live_count();
}

//! adds a namespace to the root namespace of a loaded user module's Program, as a binary module does at runtime
/** Takes the module Program's parse ownership, as module-jni does when it attaches its \c Jni namespace to a Program
    the first time the Program's Java classes are used, and adds a new namespace through the public
    QoreNamespace::addNamespace().  Other threads may be importing the module at the same time, copying from that root
    namespace into their own Programs.

    @param module the name of a loaded user module
    @param name the name of the namespace to add; adding an existing name merges into it

    @return @ref True "True" if the namespace was added, @ref False "False" if the module's Program could not be
    owned for parsing because it is being deleted

    @throw MODULE-PROGRAM-ERROR no user module with the given name is loaded
*/
bool cpp_api_add_module_namespace(string module, string name) {
    QoreProgram* pgm = ModuleManager::findUserModuleProgram(module->c_str());
    if (!pgm) {
        xsink->raiseException("MODULE-PROGRAM-ERROR", "no user module '%s' is loaded", module->c_str());
        return QoreValue();
    }
    ProgramRuntimeExternalParseContextHelper pch(pgm);
    if (!pch) {
        return false;
    }
    pgm->getRootNS()->addNamespace(new QoreNamespace(name->c_str()));
    return true;
}

//! records each child process that this process creates with fork() in a file
/** A pthread_atfork() child handler appends one byte to the file in every child created with fork(); a child created
    with posix_spawn() runs no handler, so it is not recorded.  The handler is registered once; the file is opened by
    the first call and kept open for the life of the process.

    @param path the file to append to; created if it does not exist

    @throw FORK-RECORD-ERROR the file cannot be opened, the handler cannot be registered, or another file is already
    used
*/
nothing cpp_api_record_fork_children(string path) [dom=FILESYSTEM,PROCESS] {
    static std::mutex m;
    static std::string record_path;
    std::lock_guard<std::mutex> lock(m);
    if (fork_child_fd.load() >= 0) {
        if (record_path != path->c_str()) {
            xsink->raiseException("FORK-RECORD-ERROR", "fork children are already recorded in %s",
                record_path.c_str());
        }
        return QoreValue();
    }
    int fd = open(path->c_str(), O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC, 0600);
    if (fd < 0) {
        xsink->raiseErrnoException("FORK-RECORD-ERROR", errno, "cannot open %s", path->c_str());
        return QoreValue();
    }
    int rc = pthread_atfork(nullptr, nullptr, record_fork_child);
    if (rc) {
        close(fd);
        xsink->raiseErrnoException("FORK-RECORD-ERROR", rc, "pthread_atfork() failed");
        return QoreValue();
    }
    record_path = path->c_str();
    fork_child_fd.store(fd);
    return QoreValue();
}

//! creates a child process with fork() that exits at once, and waits for it
/** The positive control for cpp_api_record_fork_children(): the child is recorded before fork() returns in it

    @return the exit status of the child

    @throw FORK-RECORD-ERROR fork() or waitpid() failed
*/
int cpp_api_fork_and_wait() [dom=PROCESS] {
    pid_t pid = fork();
    if (!pid) {
        _exit(0);
    }
    if (pid < 0) {
        xsink->raiseErrnoException("FORK-RECORD-ERROR", errno, "fork() failed");
        return QoreValue();
    }
    int status = 0;
    while (waitpid(pid, &status, 0) < 0) {
        if (errno != EINTR) {
            xsink->raiseErrnoException("FORK-RECORD-ERROR", errno, "waitpid() failed");
            return QoreValue();
        }
    }
    return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
}

//! sets the soft limit on the number of processes of this process's real user (RLIMIT_NPROC)
/** With a soft limit below the number of processes that the user already has, this process cannot create any process
    (unless the user is privileged), so a failure to start a process can be tested.

    @param limit the new soft limit; -1 means no limit

    @return the previous soft limit; -1 means no limit

    @throw PROCESS-LIMIT-ERROR the argument is invalid, or getrlimit() or setrlimit() failed
*/
int cpp_api_set_process_limit(int limit) [dom=PROCESS] {
    if (limit < -1) {
        xsink->raiseException("PROCESS-LIMIT-ERROR", "invalid process limit " QLLD, limit);
        return QoreValue();
    }
    struct rlimit rl;
    if (getrlimit(RLIMIT_NPROC, &rl)) {
        xsink->raiseErrnoException("PROCESS-LIMIT-ERROR", errno, "getrlimit() failed");
        return QoreValue();
    }
    int64 old_limit = rl.rlim_cur == RLIM_INFINITY ? -1 : static_cast<int64>(rl.rlim_cur);
    rl.rlim_cur = limit == -1 ? RLIM_INFINITY : static_cast<rlim_t>(limit);
    if (setrlimit(RLIMIT_NPROC, &rl)) {
        xsink->raiseErrnoException("PROCESS-LIMIT-ERROR", errno, "setrlimit() failed");
        return QoreValue();
    }
    return old_limit;
}

//! raises an exception and returns a new reference to the argument
/** Builtin code can raise an exception and still return a value, but no caller may receive the value; see
    ExceptionResultProbe

    @param value the value to return
    @param err the exception code to raise

    @return a new reference to \a value, which the caller never receives because of the exception

    @throw err always
*/
auto cpp_api_return_with_exception(auto value, string err) {
    xsink->raiseException(err->c_str(), "the function returned a value with this exception");
    return value.refSelf();
}

//! takes the first value of a Queue through the public C++ API, which has no access to the Queue object
/** @param queue an object of a class that inherits Queue; must not be empty

    @return the value taken

    @throw QUEUE-ERROR the object is not a Queue, or the queue is empty
*/
auto cpp_api_queue_shift(object queue) {
    QoreQueueHelper qh(queue, xsink);
    // the helper raises an exception if the object has no Queue
    if (*xsink) {
        return QoreValue();
    }
    if (!qh.size()) {
        xsink->raiseException("QUEUE-ERROR", "the queue is empty");
        return QoreValue();
    }
    return qh.shift(xsink);
}

//! takes the last value of a Queue through the public C++ API, which has no access to the Queue object
/** @param queue an object of a class that inherits Queue; must not be empty

    @return the value taken

    @throw QUEUE-ERROR the object is not a Queue, or the queue is empty
*/
auto cpp_api_queue_pop(object queue) {
    QoreQueueHelper qh(queue, xsink);
    // the helper raises an exception if the object has no Queue
    if (*xsink) {
        return QoreValue();
    }
    if (!qh.size()) {
        xsink->raiseException("QUEUE-ERROR", "the queue is empty");
        return QoreValue();
    }
    return qh.pop(xsink);
}

//! clears a Queue through the public C++ API, which has no access to the Queue object
/** @param queue an object of a class that inherits Queue

    @throw QUEUE-ERROR the object is not a Queue
*/
nothing cpp_api_queue_clear(object queue) {
    QoreQueueHelper qh(queue, xsink);
    // the helper raises an exception if the object has no Queue
    if (*xsink) {
        return QoreValue();
    }
    qh.clear(xsink);
    return QoreValue();
}
//! returns the number of references to the Queue private data of an object, other than the one this call holds
/** Lets tests check that the C++ API releases the references it takes to a Queue

    @param queue an object of a class that inherits Queue

    @return the number of references to the object's Queue private data before this call

    @throw QUEUE-ERROR the object is not a Queue
*/
int cpp_api_queue_private_refs(object queue) [flags=RET_VALUE_ONLY] {
    AbstractPrivateData* pd = queue->getReferencedPrivateData(CID_QUEUE, xsink);
    if (!pd) {
        if (!*xsink) {
            xsink->raiseException("QUEUE-ERROR", "expecting an object derived from Queue; got class '%s' instead",
                queue->getClassName());
        }
        return QoreValue();
    }
    int refs = pd->reference_count() - 1;
    pd->deref(xsink);
    return refs;
}

//! waits for a new pipe to become readable with qore_cancellable_poll()
/** Lets tests check the exported cancellable poll: its results without a cancellation request and how soon a
    request ends it.

    @param fill if @ref True, the pipe is made readable before the wait
    @param timeout_ms the timeout for the wait; negative for none

    @return a hash with \c rc: the return value (the number of descriptors with events or 0 on timeout) and
    \c readable: @ref True if the pipe was reported readable

    @throw THREAD-CANCELLED the thread was cancelled during the wait
    @throw PROGRAM-INTERRUPTED the thread's Program was interrupted during the wait
*/
hash<auto> cpp_api_cancellable_poll(bool fill, int timeout_ms) {
    TestPipe p(xsink);
    if (*xsink || (fill && p.fill(xsink))) {
        return QoreValue();
    }
    struct pollfd pfd = {p.readFd(), POLLIN, 0};
    int rc = qore_cancellable_poll(&pfd, 1, static_cast<int>(timeout_ms), xsink, "cpp api poll");
    if (rc == QORE_POLL_CANCELLED) {
        assert(*xsink);
        return QoreValue();
    }
    if (rc < 0) {
        return xsink->raiseErrnoException("POLL-ERROR", errno, "qore_cancellable_poll() failed");
    }
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    rv->setKeyValue("rc", rc, xsink);
    rv->setKeyValue("readable", (pfd.revents & POLLIN) ? true : false, xsink);
    return rv.release();
}

//! waits for a descriptor of the caller with qore_cancellable_poll()
/** Lets tests check the exported cancellable poll on descriptors such as named pipes, on whose end poll(2) waits
    forever on Darwin.

    @param fd the descriptor to wait for
    @param write if @ref True, the wait is for write readiness, else for read readiness
    @param timeout_ms the timeout for the wait; negative for none

    @return a hash with \c rc: the return value (the number of descriptors with events or 0 on timeout) and
    \c ready: @ref True if the requested readiness was reported

    @throw THREAD-CANCELLED the thread was cancelled during the wait
    @throw PROGRAM-INTERRUPTED the thread's Program was interrupted during the wait
*/
hash<auto> cpp_api_cancellable_poll_fd(int fd, bool write, int timeout_ms) {
    struct pollfd pfd = {static_cast<int>(fd), static_cast<short>(write ? POLLOUT : POLLIN), 0};
    int rc = qore_cancellable_poll(&pfd, 1, static_cast<int>(timeout_ms), xsink, "cpp api poll");
    if (rc == QORE_POLL_CANCELLED) {
        assert(*xsink);
        return QoreValue();
    }
    if (rc < 0) {
        return xsink->raiseErrnoException("POLL-ERROR", errno, "qore_cancellable_poll() failed");
    }
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    rv->setKeyValue("rc", rc, xsink);
    rv->setKeyValue("ready", (pfd.revents & (write ? POLLOUT : POLLIN)) ? true : false, xsink);
    return rv.release();
}

//! writes with OutputStream::writeWithTimeout(), the C++ API that waits for the stream's descriptor
/** @param output_stream the stream to write to
    @param data the data to write
    @param timeout_ms the timeout of the wait for write readiness; 0 for a write that does not wait

    @return the number of bytes written; 0 if the stream cannot be written to within the timeout

    @throw OUTPUT-STREAM-ERROR the wait failed or reported an error
*/
int cpp_api_output_stream_write_with_timeout(object output_stream, binary data, int timeout_ms) {
    OutputStream* os = static_cast<OutputStream*>(output_stream->getReferencedPrivateData(CID_OUTPUTSTREAM,
        xsink));
    if (!os) {
        if (!*xsink) {
            xsink->raiseException("OUTPUT-STREAM-ERROR", "expecting an object derived from OutputStream; got class "
                "'%s' instead", output_stream->getClassName());
        }
        return QoreValue();
    }
    ReferenceHolder<OutputStream> holder(os, xsink);
    int64 rc = os->writeWithTimeout(data->getPtr(), data->size(), timeout_ms, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return rc;
}

//! waits for a new pipe to become readable in a loop of the module's own that watches the wakeup descriptor
/** Lets tests check qore_cancel_wakeup_register(), qore_cancel_wakeup_check() and qore_cancel_wakeup_unregister()
    (through QoreCancelWakeupHelper) as a library with its own event loop uses them.

    @param fill if @ref True, the pipe is made readable before the wait
    @param timeout_ms the timeout for the wait; negative for none
    @param nested if @ref True, a nested registration and a nested qore_cancellable_poll() are made inside the loop

    @return a hash with \c rc: 1 if the pipe became readable, 0 on timeout, and \c wake_fd: @ref True if there was
    a wakeup descriptor to watch

    @throw THREAD-CANCELLED the thread was cancelled during the wait
    @throw PROGRAM-INTERRUPTED the thread's Program was interrupted during the wait
*/
hash<auto> cpp_api_wakeup_loop(bool fill, int timeout_ms, bool nested = False) {
    TestPipe p(xsink);
    if (*xsink || (fill && p.fill(xsink))) {
        return QoreValue();
    }
    QoreCancelWakeupHelper cwh(xsink, "cpp api loop");
    if (*xsink) {
        return QoreValue();
    }
    int64 deadline_us = timeout_ms > 0 ? q_get_monotonic_us() + timeout_ms * 1000 : 0;
    int rc = 0;
    while (true) {
        if (nested) {
            // a nested registration and a nested cancellable poll leave the outer registration in effect
            QoreCancelWakeupHelper inner(xsink, "cpp api nested");
            if (*xsink) {
                return QoreValue();
            }
            if (inner.fd() != cwh.fd()) {
                return xsink->raiseException("NESTED-ERROR", "a nested registration returned descriptor %d; "
                    "expecting %d", inner.fd(), cwh.fd());
            }
            struct pollfd npfd = {p.readFd(), POLLIN, 0};
            int nrc = qore_cancellable_poll(&npfd, 1, 0, xsink, "cpp api nested poll");
            if (nrc == QORE_POLL_CANCELLED) {
                return QoreValue();
            }
            if (nrc > 0) {
                rc = 1;
                break;
            }
        }
        struct pollfd pfds[2] = {{p.readFd(), POLLIN, 0}, {cwh.fd(), POLLIN, 0}};
        int nfds = cwh.fd() >= 0 ? 2 : 1;
        int prc = poll(pfds, nfds, remaining_ms(static_cast<int>(timeout_ms), deadline_us));
        if (prc < 0) {
            if (errno == EINTR) {
                continue;
            }
            return xsink->raiseErrnoException("POLL-ERROR", errno, "poll() failed");
        }
        if (nfds == 2 && pfds[1].revents) {
            if (qore_cancel_wakeup_check(xsink, "cpp api loop")) {
                return QoreValue();
            }
        }
        if (pfds[0].revents & POLLIN) {
            rc = 1;
            break;
        }
        if (!prc) {
            break;
        }
    }
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    rv->setKeyValue("rc", rc, xsink);
    rv->setKeyValue("wake_fd", cwh.fd() >= 0, xsink);
    return rv.release();
}

//! returns @ref True if the current thread's wakeup descriptor is readable right after it has been registered
/** A request that has been delivered or cleared must not leave the descriptor readable for the next wait.

    @throw THREAD-CANCELLED a request is pending
*/
bool cpp_api_wakeup_fd_readable() {
    QoreCancelWakeupHelper cwh(xsink, "cpp api readiness");
    if (*xsink || cwh.fd() < 0) {
        return false;
    }
    struct pollfd pfd = {cwh.fd(), POLLIN, 0};
    int rc = poll(&pfd, 1, 0);
    if (rc < 0) {
        return xsink->raiseErrnoException("POLL-ERROR", errno, "poll() failed");
    }
    return rc > 0;
}

//! returns the signals raised by a fault in the executing thread that are blocked in the calling thread
/** A blocked fault signal cannot be delivered: the thread executes the faulting instruction again for ever.

    @return the numbers of the blocked signals among \c SIGSEGV, \c SIGBUS, \c SIGILL, \c SIGFPE and \c SIGTRAP
*/
list<int> cpp_api_blocked_fault_signals() [flags=RET_VALUE_ONLY] {
    sigset_t mask;
    sigemptyset(&mask);
    int rc = pthread_sigmask(SIG_BLOCK, nullptr, &mask);
    if (rc) {
        xsink->raiseErrnoException("SIGNAL-MASK-ERROR", rc, "pthread_sigmask() failed");
        return QoreValue();
    }
    ReferenceHolder<QoreListNode> rv(new QoreListNode(bigIntTypeInfo), xsink);
    for (int sig : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGTRAP}) {
        if (sigismember(&mask, sig) == 1) {
            rv->push(sig, xsink);
        }
    }
    return rv.release();
}

//! finds or creates a time zone from a region name or a UTC offset with the public find_create_timezone() API
/** Lets tests check the time zone a driver gets from a \c timezone option, as DBI drivers and Arrow imports call it

    @param name a region name (ex: \c "Europe/Prague") or a UTC offset (\c "+DD[[:]DD[[:]DD]]" or \c "-DD...")
    @param epoch the time, in seconds since the epoch, for which the UTC offset is returned

    @return a hash with \c region: the name of the zone (\c "UTC" for UTC itself) and \c utc_offset: its UTC
    offset in seconds east at \a epoch

    @throw PARSE-SET-TIME-ZONE-ERROR \a name is not a valid UTC offset
    @throw FILE-OPEN2-ERROR the zoneinfo file for the region cannot be opened
    @throw TZINFO-ERROR the zoneinfo file for the region cannot be read
*/
hash<auto> cpp_api_find_create_timezone(string name, int epoch = 0) [flags=RET_VALUE_ONLY] {
    const AbstractQoreZoneInfo* zone = find_create_timezone(name->c_str(), xsink);
    if (*xsink) {
        return QoreValue();
    }
    bool is_dst;
    const char* zone_name;
    int utc_offset = tz_get_utc_offset(zone, epoch, is_dst, zone_name);
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    rv->setKeyValue("region", new QoreStringNode(tz_get_region_name(zone)), xsink);
    rv->setKeyValue("utc_offset", utc_offset, xsink);
    return rv.release();
}

//! detaches the descriptor of a File object with QoreFile::detachFd() and returns the object's state afterwards
/** Lets tests check that a detach leaves the object without the descriptor.  The descriptor is not closed here: it
    is returned, so that the test can close or destroy the File before passing it to cpp_api_fd_write_and_close().

    @param file a File object

    @return a hash with \c fd: the descriptor returned by the detach (-1 if none), \c is_open: QoreFile::isOpen()
    after it, \c get_fd: QoreFile::getFD() after it, and \c second_fd: the descriptor returned by a second detach

    @throw OBJECT-INCOMPATIBLE \a file is not a File object
*/
hash<auto> cpp_api_file_detach_fd(object file) [dom=FILESYSTEM] {
    QoreFileHelper fh(file, xsink);
    // the helper raises an exception if the object has no File
    if (*xsink) {
        return QoreValue();
    }
    // the hash is created before the detach, so that no descriptor is detached if it cannot be created
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    int fd = fh->detachFd();
    rv->setKeyValue("fd", fd, xsink);
    rv->setKeyValue("is_open", fh->isOpen(), xsink);
    rv->setKeyValue("get_fd", fh->getFD(), xsink);
    rv->setKeyValue("second_fd", fh->detachFd(), xsink);
    return rv.release();
}

//! writes to and closes a descriptor detached from a File, if it is still open on the file it was detached from
/** Lets tests check that a File object does not close a descriptor detached from it, neither when it is closed nor
    when it is destroyed.  A descriptor that is not open on \a path is neither written to nor closed, as it is not
    the descriptor the caller owns: the File closed it, and its number may have been reused.

    @param fd the descriptor returned by cpp_api_file_detach_fd()
    @param path the path of the file the descriptor was opened on
    @param data the data to write

    @return a hash with \c same_file: @ref True if \a fd is open on \a path, \c written: the number of bytes
    written (-1 if nothing was written or the write failed), and \c close_rc: the return value of close(2) (-1 if
    the descriptor was not closed or the close failed)

    @throw STAT-ERROR \a path cannot be checked
*/
hash<auto> cpp_api_fd_write_and_close(int fd, string path, string data) [dom=FILESYSTEM] {
    struct stat path_st;
    if (::stat(path->c_str(), &path_st)) {
        return xsink->raiseErrnoException("STAT-ERROR", errno, "stat('%s') failed", path->c_str());
    }
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    struct stat fd_st;
    bool same_file = fd >= 0 && fd <= INT_MAX && !::fstat(static_cast<int>(fd), &fd_st)
        && fd_st.st_dev == path_st.st_dev && fd_st.st_ino == path_st.st_ino;
    int64 written = -1;
    int close_rc = -1;
    if (same_file) {
        written = ::write(static_cast<int>(fd), data->c_str(), data->size());
        close_rc = ::close(static_cast<int>(fd));
    }
    rv->setKeyValue("same_file", same_file, xsink);
    rv->setKeyValue("written", written, xsink);
    rv->setKeyValue("close_rc", close_rc, xsink);
    return rv.release();
}

//! returns whether the dynamic linker finds a symbol in the objects loaded into the process
/** Binary modules are loaded with their symbols available to the whole process, so this tells whether a module
    exports a symbol: one declared \c DLLEXPORT must be found, one declared \c DLLLOCAL must not.

    @param symbol the symbol's name as the dynamic linker knows it: the mangled name of a C++ symbol, without the
    leading underscore Mach-O adds

    @return @ref True "True" if \c dlsym(RTLD_DEFAULT) resolves \a symbol
*/
bool cpp_api_symbol_exported(string symbol) [flags=CONSTANT] {
    return dlsym(RTLD_DEFAULT, symbol->c_str()) != nullptr;
}

//! returns the environment variables whose names start with a prefix, read from \c environ under a QoreEnvironmentReadLock
/** The \c environ array and its strings must stay valid and unchanged while the lock is held, however other threads
    change the environment

    @param prefix the prefix of the names of the variables to return

    @return a hash of the variables found (name: value)
*/
hash<auto> cpp_api_env_snapshot(string prefix) [dom=EXTERNAL_INFO] {
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    QoreEnvironmentReadLock env_lock;
    for (char** e = environ; *e; ++e) {
        if (strncmp(*e, prefix->c_str(), prefix->size())) {
            continue;
        }
        const char* eq = strchr(*e, '=');
        if (!eq) {
            continue;
        }
        std::string name(*e, eq - *e);
        rv->setKeyValue(name.c_str(), new QoreStringNode(eq + 1), xsink);
    }
    return rv.release();
}

//! sets two environment variables to the same value atomically with an AtomicEnvironmentSetter
/** @param name1 the name of the first variable
    @param name2 the name of the second variable
    @param value the value of both variables

    @return 0 for success, -1 if a variable could not be set
*/
int cpp_api_env_set_pair(string name1, string name2, string value) [dom=PROCESS] {
    AtomicEnvironmentSetter aes;
    int rc = aes.set(name1->c_str(), value->c_str());
    if (!rc) {
        rc = aes.set(name2->c_str(), value->c_str());
    }
    return rc;
}

//! reads an environment variable with QoreEnvironmentValue
/** @param name the name of the variable

    @return the value of the variable, or @ref nothing if it is not set
*/
*string cpp_api_env_value(string name) [dom=EXTERNAL_INFO] {
    QoreEnvironmentValue v(name->c_str());
    if (!v) {
        return QoreValue();
    }
    return new QoreStringNode(v.str());
}

//! returns the result of SystemEnvironment::isSet() for an environment variable
/** @param name the name of the variable

    @return True if the variable is set, even to an empty value
*/
bool cpp_api_env_is_set(string name) [dom=EXTERNAL_INFO] {
    return SystemEnvironment::isSet(name->c_str());
}

//! tries to change and read the environment while holding a QoreEnvironmentReadLock
/** A thread holding the lock shared cannot change the environment: SystemEnvironment::set() and
    SystemEnvironment::unset() and the functions of an AtomicEnvironmentSetter created meanwhile (which nests the
    shared hold) return -1 with \c errno \c EDEADLK; reads nest

    @param name the name of the variable
    @param value the value to try to set

    @return a hash with the return value and \c errno of each attempt (\c set_rc, \c set_errno, \c unset_rc,
    \c unset_errno, \c aes_set_rc, \c aes_set_errno, \c aes_unset_rc, \c aes_unset_errno), the value of the
    variable read with nested reads (\c value, \c is_set), and \c after_rc, the return value of
    SystemEnvironment::set() after the lock has been released
*/
hash<auto> cpp_api_env_change_while_read_locked(string name, string value) [dom=PROCESS] {
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    {
        QoreEnvironmentReadLock env_lock;
        errno = 0;
        int rc = SystemEnvironment::set(name->c_str(), value->c_str());
        rv->setKeyValue("set_rc", rc, xsink);
        rv->setKeyValue("set_errno", errno, xsink);
        errno = 0;
        rc = SystemEnvironment::unset(name->c_str());
        rv->setKeyValue("unset_rc", rc, xsink);
        rv->setKeyValue("unset_errno", errno, xsink);
        {
            AtomicEnvironmentSetter aes;
            errno = 0;
            rc = aes.set(name->c_str(), value->c_str());
            rv->setKeyValue("aes_set_rc", rc, xsink);
            rv->setKeyValue("aes_set_errno", errno, xsink);
            errno = 0;
            rc = aes.unset(name->c_str());
            rv->setKeyValue("aes_unset_rc", rc, xsink);
            rv->setKeyValue("aes_unset_errno", errno, xsink);
        }
        // nested reads
        QoreEnvironmentReadLock nested_lock;
        QoreEnvironmentValue v(name->c_str());
        rv->setKeyValue("value", v ? QoreValue(new QoreStringNode(v.str())) : QoreValue(), xsink);
        rv->setKeyValue("is_set", SystemEnvironment::isSet(name->c_str()), xsink);
    }
    rv->setKeyValue("after_rc", SystemEnvironment::set(name->c_str(), value->c_str()), xsink);
    return rv.release();
}

//! changes and reads the environment with the lock nested in one thread: exclusive inside exclusive, shared inside exclusive
/** @param name the name of the variable
    @param value the value to set

    @return the value of the variable read inside the outer exclusive hold after the inner one set it to
    <tt>value + "-inner"</tt> and SystemEnvironment::set() set it to \a value again, or @ref nothing if it is not set

    @throw ENV-ERROR a change failed
*/
*string cpp_api_env_nested_exclusive(string name, string value) [dom=PROCESS] {
    AtomicEnvironmentSetter outer;
    std::string inner_value = std::string(value->c_str()) + "-inner";
    {
        AtomicEnvironmentSetter inner;
        if (inner.set(name->c_str(), inner_value.c_str())) {
            return xsink->raiseErrnoException("ENV-ERROR", errno, "nested AtomicEnvironmentSetter::set() failed");
        }
    }
    QoreEnvironmentValue v1(name->c_str());
    if (!v1 || v1.str() != inner_value) {
        return xsink->raiseException("ENV-ERROR", "the nested change was not visible");
    }
    if (SystemEnvironment::set(name->c_str(), value->c_str())) {
        return xsink->raiseErrnoException("ENV-ERROR", errno, "SystemEnvironment::set() inside the exclusive hold "
            "failed");
    }
    QoreEnvironmentValue v(name->c_str());
    if (!v) {
        return QoreValue();
    }
    return new QoreStringNode(v.str());
}

//! creates a child process with fork() while another thread is about to release the environment lock, and waits for it
/** The other thread holds the lock until this thread is about to call fork(), and releases it then: fork() waits for
    it (the fork handlers acquire the lock before the process is copied), and the child changes and reads the
    environment, which it can only do if the lock is free in the child

    @param name the name of the variable that the child sets
    @param value the value that the child sets
    @param exclusive @ref True if the other thread holds the lock exclusively, @ref False if shared

    @return the exit status of the child: 0 for success, 2 if it could not set the variable, 3 if it read another
    value, -1 if it did not exit normally

    @throw FORK-ERROR fork() or waitpid() failed
*/
int cpp_api_env_fork_while_held(string name, string value, bool exclusive) [dom=PROCESS] {
    pid_t pid;
    int fork_errno;
    {
        EnvLockHolderThread holder(exclusive);
        // the holder releases the lock now, before or while fork() waits for it
        holder.signalRelease();
        pid = fork();
        if (!pid) {
            // only this thread exists in the child
            _exit(env_child_set_and_check(name->c_str(), value->c_str()));
        }
        fork_errno = errno;
    }
    if (pid < 0) {
        return xsink->raiseErrnoException("FORK-ERROR", fork_errno, "fork() failed");
    }
    int rc = wait_child(pid);
    if (rc == -2) {
        return xsink->raiseErrnoException("FORK-ERROR", errno, "waitpid() failed");
    }
    return rc;
}

//! starts threads that fail while another thread sets the stack size of the primary thread, and returns the failures
/** A thread start held the stack lock across pthread_create() and its failure handling, which deregisters the TID
    under the lock of the thread list; q_enforce_thread_size_on_primary_thread() holds the lock of the thread list
    while it takes the stack lock, so the two could deadlock.

    The thread starts fail deterministically: the default thread stack size is set to a size that no process can
    map (1 EiB) for the duration of the call.  Another thread calls q_enforce_thread_size_on_primary_thread() as
    often as threads are started; it sets the stack size of the primary thread to the default size too, so no Qore
    code runs in the primary thread until both loops are done and the sizes are restored.

    @param iterations the number of thread starts and the number of calls of
    q_enforce_thread_size_on_primary_thread()

    @return the number of thread starts that failed
*/
int cpp_api_thread_start_failure_race(int iterations) [dom=PROCESS,THREAD_CONTROL] {
    size_t default_size = q_thread_get_stack_size();
    q_thread_set_stack_size(static_cast<size_t>(1) << 60, xsink);
    if (*xsink) {
        return QoreValue();
    }
    std::thread enforcer([iterations]() {
        for (int64 i = 0; i < iterations; ++i) {
            q_enforce_thread_size_on_primary_thread();
        }
    });
    int64 failed = 0;
    for (int64 i = 0; i < iterations; ++i) {
        // a cancelled thread stops starting threads; the sizes are still restored below
        if (i && !(i % 1000) && qore_check_cancel(nullptr, "starting threads")) {
            break;
        }
        ExceptionSink start_xsink;
        if (q_start_thread(&start_xsink, [](ExceptionSink*, void*) {}, nullptr) == -1) {
            ++failed;
        }
        start_xsink.clear();
    }
    enforcer.join();
    q_thread_set_stack_size(default_size, xsink);
    q_enforce_thread_size_on_primary_thread();
    return failed;
}

//! creates a child process with the C library's fork() (not Qore's fork()) that runs Qore code, and waits for it
/** Qore's fork() stops the signal thread before fork() and starts it again after it; a fork() made by other code
    (here, this module) does not, so the child must handle a signal thread that does not exist in it

    @param c the code to run in the child; it returns the child's exit status (an integer)

    @return the exit status of the child: the code's return value, 99 if the code raised an exception, or -1 if the
    child did not exit normally

    @throw FORK-ERROR fork() or waitpid() failed
*/
int cpp_api_fork_and_call(code c) [dom=PROCESS] {
    pid_t pid = fork();
    if (!pid) {
        ExceptionSink child_xsink;
        ValueHolder rv(c->execValue(nullptr, &child_xsink), &child_xsink);
        int status = child_xsink ? 99 : static_cast<int>(rv->getAsBigInt());
        child_xsink.clear();
        _exit(status);
    }
    if (pid < 0) {
        return xsink->raiseErrnoException("FORK-ERROR", errno, "fork() failed");
    }
    int rc = wait_child(pid);
    if (rc == -2) {
        return xsink->raiseErrnoException("FORK-ERROR", errno, "waitpid() failed");
    }
    return rc;
}

//! waits for a child process created with the Qore fork() function
/** @param pid the PID of the child process

    @return the exit status of the child, or -1 if it did not exit normally

    @throw FORK-ERROR waitpid() failed
*/
int cpp_api_wait_child(int pid) [dom=PROCESS] {
    int rc = wait_child(static_cast<pid_t>(pid));
    if (rc == -2) {
        return xsink->raiseErrnoException("FORK-ERROR", errno, "waitpid() failed");
    }
    return rc;
}

//! keeps an exception in a sink managed outside of Qore, then adopts it in the calling thread
/** The exception is raised in a sink of its own, on the calling thread or, if @p other_thread is @ref True, on a
    thread registered with Qore for it, and handed over to a sink managed outside of Qore
    (ExceptionSink::markExternallyManaged()), as a module keeps exceptions beyond the call that raised them or hands
    them to another thread.  It is then assimilated into a sink of the calling thread, and, with @p rethrow, from that
    sink into the sink of the call, as an exception crosses the sinks of nested calls and destructors; otherwise that
    sink is cleared, as when the exception is handled.

    With @p mark @ref True, the sink that raised the exception is marked before it is assimilated into the sink
    managed outside of Qore; otherwise it is assimilated while it still counts the exception.

    @return a hash of the state of the calling thread, unless the exception is rethrown: \c kept: whether it counted
    an active exception while the exception was held outside of Qore; \c adopted: whether it counted one after
    adopting it; \c handled: whether it counted one after it was cleared

    @throw any the exception given if @p rethrow is @ref True
*/
*hash<auto> cpp_api_exception_handoff(string err, string desc, bool other, bool mark, bool rethrow) [dom=THREAD_CONTROL] {
    ExceptionSink kept;
    kept.markExternallyManaged();
    std::string err_str(err->c_str());
    std::string desc_str(desc->c_str());
    auto raise_into_kept = [&kept, &err_str, &desc_str, mark] () {
        ExceptionSink raised;
        raised.raiseException(err_str.c_str(), "%s", desc_str.c_str());
        if (mark) {
            raised.markExternallyManaged();
        }
        kept.assimilate(raised);
    };
    if (other) {
        // the worker thread is deregistered with an assertion that it counts no active exception
        std::thread worker([&raise_into_kept] () {
            QoreForeignThreadHelper qfth;
            raise_into_kept();
        });
        worker.join();
    } else {
        raise_into_kept();
    }
    bool kept_active = q_active_exception();

    ExceptionSink nested;
    nested.assimilate(kept);
    bool adopted_active = q_active_exception();
    if (rethrow) {
        xsink->assimilate(nested);
        return QoreValue();
    }
    nested.clear();
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    rv->setKeyValue("kept", kept_active, nullptr);
    rv->setKeyValue("adopted", adopted_active, nullptr);
    rv->setKeyValue("handled", q_active_exception(), nullptr);
    return rv.release();
}

//! returns @ref True if the calling thread counts an active exception
/** @return @ref True if the calling thread counts an active exception (q_active_exception())
*/
bool cpp_api_active_exception() [dom=THREAD_CONTROL] {
    return q_active_exception();
}

//! sets the external data of the current Program whose copy() takes a lock of the module
/** A child Program created from the current Program copies it; see cpp_api_ext_data_read_while_copying().

    @throw EXT-DATA-ERROR the data is already set
*/
nothing cpp_api_ext_data_set() [dom=PROCESS] {
    QoreProgram* pgm = getProgram();
    if (pgm->getExternalData(ExtDataOwner)) {
        xsink->raiseException("EXT-DATA-ERROR", "the external data is already set");
        return QoreValue();
    }
    pgm->setExternalData(ExtDataOwner, new LockingExtData);
    std::lock_guard<std::mutex> lg(ext_data_copy_state.m);
    ext_data_copy_state.in_copy = false;
    ext_data_copy_state.copies = 0;
}

//! removes the external data set by cpp_api_ext_data_set() from the current Program
/** @return True if the data was set
*/
bool cpp_api_ext_data_remove() [dom=PROCESS] {
    AbstractQoreProgramExternalData* data = getProgram()->removeExternalData(ExtDataOwner);
    if (!data) {
        return false;
    }
    data->doDeref();
    return true;
}

//! returns the number of copies of the external data set by cpp_api_ext_data_set() made since it was set
/** @return the number of copies
*/
int cpp_api_ext_data_copies() [flags=RET_VALUE_ONLY] {
    std::lock_guard<std::mutex> lg(ext_data_copy_state.m);
    return ext_data_copy_state.copies;
}

//! holds the module's lock that copy() takes, waits until a copy() runs, and reads the Program's external data
/** Another thread creates a child Program of the current Program, whose copy() of the external data set by
    cpp_api_ext_data_set() waits for the module's lock held here; reading the external data then takes the lock of
    the Program, which deadlocked if the copy was made with the Program's lock held.

    @return True if the external data was found
*/
bool cpp_api_ext_data_read_while_copying() [dom=PROCESS] {
    std::lock_guard<std::mutex> module_lock(ext_data_module_lock);
    {
        std::unique_lock<std::mutex> ul(ext_data_copy_state.m);
        ext_data_copy_state.cv.wait(ul, [] { return ext_data_copy_state.in_copy; });
        ext_data_copy_state.in_copy = false;
    }
    return getProgram()->getExternalData(ExtDataOwner) != nullptr;
}

//! reads the Program's external data while holding the module's lock that copy() takes
/** The lock order of a module that takes its lock and then the Program's lock, as cpp_api_ext_data_read_while_copying()
    does without waiting for a copy: a lock-order checker (ThreadSanitizer) reports an inversion when a child Program
    is then created in the same process and the copy is made with the Program's lock held.

    @return True if the external data was found
*/
bool cpp_api_ext_data_read_while_locked() [dom=PROCESS] {
    std::lock_guard<std::mutex> module_lock(ext_data_module_lock);
    return getProgram()->getExternalData(ExtDataOwner) != nullptr;
}

///@}
