#include "cppapiuser-module.h"
#include "QC_ProgramContextProbe.h"

//! reports the Program context that a binary module's C++ code sees when its methods are called
/** Binary modules that act on the caller's behalf check the calling Program's restrictions from C++
    with <tt>getProgram()->getParseOptions()</tt> -- e.g. @ref PO_NO_FILESYSTEM before touching a file.
    One builtin class is shared by every Program that imports the module defining it, so the class's
    namespace cannot be used to establish which Program is executing: this class exists so that
    examples/test/module-cpp-api/module-cpp-api.qtest can assert that a method body sees the Program
    that called it, whether or not the module is also loaded into another Program.
*/
qclass ProgramContextProbe [arg=AbstractPrivateData* pd; ns=Qore::CppApiTest];

//! creates the object
/**
 */
ProgramContextProbe::constructor() {
    self->setPrivate(CID_PROGRAMCONTEXTPROBE, new AbstractPrivateData);
}

//! returns the parse options of the Program that the calling method's C++ body sees
/** @return the value of <tt>getProgram()->getParseOptions()</tt>, or 0 if there is no Program context
*/
int ProgramContextProbe::getParseOptions() [flags=CONSTANT] {
    QoreProgram* pgm = getProgram();
    return pgm ? pgm->getParseOptions64() : 0;
}

//! returns the parse options seen by a static method's C++ body
/** static methods reach the Program context over a different call path than normal methods, so both
    are covered

    @return the value of <tt>getProgram()->getParseOptions()</tt>, or 0 if there is no Program context
*/
static int ProgramContextProbe::getStaticParseOptions() [flags=CONSTANT] {
    QoreProgram* pgm = getProgram();
    return pgm ? pgm->getParseOptions64() : 0;
}
