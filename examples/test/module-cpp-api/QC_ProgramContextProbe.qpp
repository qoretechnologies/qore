#include "cppapiuser-module.h"
#include "QC_ProgramContextProbe.h"

#include <functional>
#include <new>

// runs enter, which enters a Program from C++, and reports what the entry leaves (see enterProgram())
// the exceptions of the entry go to a sink of its own, reported with the key "error" (the first one's name)
static QoreHashNode* enter_program_report(ExceptionSink* xsink, const std::function<bool(ExceptionSink*)>& enter) {
    QoreProgram* before = getProgram();
    bool caught = false;
    bool entered = false;
    ExceptionSink entry_xsink;
    try {
        entered = enter(&entry_xsink);
    } catch (std::bad_alloc&) {
        caught = true;
    }
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    rv->setKeyValue("caught", caught, xsink);
    rv->setKeyValue("entered", entered, xsink);
    rv->setKeyValue("restored", getProgram() == before, xsink);
    if (entry_xsink) {
        rv->setKeyValue("error", entry_xsink.getExceptionErr().refSelf(), xsink);
        entry_xsink.clear();
    }
    return rv.release();
}

//! reports the Program context that a binary module's C++ code sees when its methods are called
/** Binary modules that act on the caller's behalf check the calling Program's restrictions from C++
    with <tt>getProgram()->getParseOptions()</tt> -- e.g. @ref PO_NO_FILESYSTEM before touching a file.
    One builtin class is shared by every Program that imports the module defining it, so the class's
    namespace cannot be used to establish which Program is executing: this class exists so that
    examples/test/module-cpp-api/module-cpp-api.qtest can assert that a method body sees the Program
    that called it, whether or not the module is also loaded into another Program.
*/
qclass ProgramContextProbe [arg=AbstractPrivateData* pd; ns=Qore::CppApiTest];

//! creates the object
/**
 */
ProgramContextProbe::constructor() {
    self->setPrivate(CID_PROGRAMCONTEXTPROBE, new AbstractPrivateData);
}

//! returns the parse options of the Program that the calling method's C++ body sees
/** @return the value of <tt>getProgram()->getParseOptions()</tt>, or 0 if there is no Program context
*/
int ProgramContextProbe::getParseOptions() [flags=CONSTANT] {
    QoreProgram* pgm = getProgram();
    return pgm ? pgm->getParseOptions64() : 0;
}

//! returns the parse options seen by a static method's C++ body
/** static methods reach the Program context over a different call path than normal methods, so both
    are covered

    @return the value of <tt>getProgram()->getParseOptions()</tt>, or 0 if there is no Program context
*/
static int ProgramContextProbe::getStaticParseOptions() [flags=CONSTANT] {
    QoreProgram* pgm = getProgram();
    return pgm ? pgm->getParseOptions64() : 0;
}

//! returns what qore_program_thread_entry_pending() reports for a Program to the C++ code of a module
/** @param program the Program to check

    @return True if a call into \a program from here must enter it although it can be the current Program
*/
static bool ProgramContextProbe::threadEntryPending(Program[QoreProgram] program) [flags=RET_VALUE_ONLY] {
    return qore_program_thread_entry_pending(*program);
}

//! returns whether a module's call into a Program that it made current with QoreProgramContextHelper must enter it
/** QoreProgramContextHelper sets the current Program without entering it: the decision of the example of
    qore_program_thread_entry_pending() is made in that state

    @param program the Program to make current

    @return True if a call into \a program must enter it with QoreExternalProgramContextHelper
*/
static bool ProgramContextProbe::needsEntryInContext(Program[QoreProgram] program) [flags=RET_VALUE_ONLY] {
    QoreProgram* pgm = *program;
    QoreProgramContextHelper pch(pgm);
    return pgm != getProgram() || qore_program_thread_entry_pending(pgm);
}

//! Enters a Program with QoreExternalProgramContextHelper and reports what the entry leaves
/** With dbg_fail_next_program_entry() armed (debug builds), an allocation fails while the helper enters the Program:
    the std::bad_alloc propagates from the helper's constructor, and the thread must be as it was before the entry
    (issue #6198)

    @param program the Program to enter

    @return a hash with the keys \c caught (True if std::bad_alloc was thrown), \c entered (True if the Program was
    the current one inside the helper), \c restored (True if the calling Program is the current one afterwards) and,
    if the entry raised a Qore exception, \c error (the name of the first one)
*/
static hash<auto> ProgramContextProbe::enterProgram(Program[QoreProgram] program) {
    QoreProgram* pgm = *program;
    return enter_program_report(xsink, [pgm](ExceptionSink* entry_xsink) -> bool {
        QoreExternalProgramContextHelper pch(entry_xsink, pgm);
        return !*entry_xsink && getProgram() == pgm;
    });
}

//! Parses and commits code in a Program from C++ and reports what the commit's entry into the Program leaves
/** As enterProgram(), for the entry that QoreProgram::parseCommit() makes (ProgramRuntimeParseCommitContextHelper):
    with dbg_fail_next_program_entry() armed, an allocation fails while the commit enters the Program, and the thread
    must be as it was before (issue #6198)

    @param program the Program to parse the code in
    @param code the code to parse

    @return a hash with the keys \c caught (True if std::bad_alloc was thrown), \c entered (True if the code was
    committed) and \c restored (True if the calling Program is the current one afterwards)
*/
static hash<auto> ProgramContextProbe::commitProgram(Program[QoreProgram] program, string code) {
    QoreProgram* pgm = *program;
    return enter_program_report(xsink, [pgm, code](ExceptionSink* entry_xsink) -> bool {
        pgm->parsePending(code->c_str(), "program-context-probe", entry_xsink);
        if (*entry_xsink) {
            return false;
        }
        pgm->parseCommit(entry_xsink);
        return !*entry_xsink;
    });
}
