#include "cppapiuser-module.h"
#include "QC_ExceptionResultProbe.h"

//! returns a value together with an exception, as builtin code is allowed to do
/** Builtin code can raise an exception and still return a value; strtoint(), for example, returns the clamped
    value of an out-of-range number with its exception.  No caller may receive such a value: it is released when
    the builtin code returns.  These methods, and cpp_api_return_with_exception(), return a new reference to their
    argument with an exception, so that
    examples/test/module-cpp-api/builtin-exception-result/builtin-exception-result.qtest can detect a
    leaked result: an object passed as the argument is only destroyed if every reference to it is released.
*/
qclass ExceptionResultProbe [arg=AbstractPrivateData* pd; ns=Qore::CppApiTest];

//! creates the object
/**
 */
ExceptionResultProbe::constructor() {
    self->setPrivate(CID_EXCEPTIONRESULTPROBE, new AbstractPrivateData);
}

//! raises an exception and returns a new reference to the argument
/** @param value the value to return
    @param err the exception code to raise

    @return a new reference to \a value, which the caller never receives because of the exception

    @throw err always
*/
auto ExceptionResultProbe::returnWithException(auto value, string err) {
    xsink->raiseException(err->c_str(), "the method returned a value with this exception");
    return value.refSelf();
}

//! raises an exception and returns a new reference to the argument
/** static methods are called through a different builtin variant than normal methods, so both are covered

    @param value the value to return
    @param err the exception code to raise

    @return a new reference to \a value, which the caller never receives because of the exception

    @throw err always
*/
static auto ExceptionResultProbe::staticReturnWithException(auto value, string err) {
    xsink->raiseException(err->c_str(), "the static method returned a value with this exception");
    return value.refSelf();
}
