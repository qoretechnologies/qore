#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - binary module loading and its module API version check
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check loads the test modules in a child process that sets its own --exec-mode
#
# The apicur and apiold test modules (examples/test/module-cpp-api) are built into the build tree and never
# installed, so QORE_MODULE_DIR must include the build tree (run_tests.sh does this)

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../ExecModeHarness.qm

%exec-class ModuleApiVersionTest

#! A binary module built for an earlier module API is refused with LOAD-MODULE-ERROR
/** The public headers of module API 2.0 had inline code that a binary module compiled with them carries (the enum
    value ownership of qore#5519), so a module built with them must not be loaded: the module API is 2.1, and a module
    that declares 2.0 is refused with the API mismatch error, while a module built with the current headers loads.
*/
class ModuleApiVersionTest inherits QUnit::Test {
    private {
        string qore_bin;
        string env;
    }

    constructor() : QUnit::Test("module API version", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
        addTestCase("API version check", \versionTest());
        set_return_value(main());
    }

    private versionTest() {
        string probe = get_script_dir() + "/module-api-probe.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            # the probe only loads modules: no code of its own is compiled to native code in any mode
            string out = ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, probe),
                NativeCheck::None);
            assertRegex("apiold: LOAD-MODULE-ERROR: module '[^']*apiold[^']*\\.qmod': feature 'apiold': API mismatch, "
                "module supports API 2\\.0, however only version 2\\.1 is supported\n", out, mode + ": apiold");
            assertRegex("apicur: loaded API 2\\.1\n", out, mode + ": apicur");
        }
    }
}
