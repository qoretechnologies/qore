%modern
%enable-all-warnings
# the Programs of the test have a top-level local variable, which %modern does not allow
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires cppapiuser

%exec-class ProgramEntryFailureTest

#! an allocation that fails while C++ code enters another Program leaves the thread as it was (issue #6198)
/** The entry (ProgramThreadCountContextHelper, used by QoreExternalProgramContextHelper, Program::callFunction() and
    the other cross-Program calls) switches the thread's current Program and takes the Program's thread count before
    steps that allocate.  A std::bad_alloc thrown by one of them propagates from the helper's constructor, whose
    destructor does not run: the entry must restore the thread itself (its current Program, its local data and its
    context chain) and release the thread count, or the thread would keep running in the Program it never entered and
    deleting the Program would wait for the count forever.

    dbg_fail_next_program_entry() (debug builds only) makes the next entry fail at one of its steps;
    ProgramContextProbe::enterProgram() (the cppapiuser test module) enters a Program with
    QoreExternalProgramContextHelper, catches std::bad_alloc and reports what the entry left.
*/
class ProgramEntryFailureTest inherits QUnit::Test {
    public {
        #! the steps of the entry at which the allocation fails, with their names (qore_dbg_program_entry_site_e)
        const Sites = {
            "the switch of the current Program": 0,
            "the allocation of the thread's local data": 1,
            "the record of the Program in the thread": 2,
            "the instantiation of the top-level local variables": 3,
            "the instantiation of a top-level local variable after the first": 4,
            "the steps after the switch of the thread's context": 5,
        };

        #! a Program that counts the runs of its thread initialization code and starts a thread that calls back into it
        /** The background thread runs the thread initialization code when it starts; its call of a closure of the
            Program through another Program enters the Program again, which must not run it again
        */
        const ThreadInitSource = "
our *int inits;
sub init() { inits = (inits ?? 0) + 1; }
sub setup() { set_thread_init(\\init()); }
int sub run(Program other) {
    int before = inits ?? 0;
    Queue q();
    background sub () {
        other.callFunction(\"call\", sub () {});
        q.push(True);
    }();
    q.get();
    return (inits ?? 0) - before;
}
";
    }

    constructor() : QUnit::Test("program-entry-failure", "1.0") {
        addTestCase("an entry without a failure enters the Program", \entryTest());
        addTestCase("a failed entry leaves the thread as it was", \failedEntryTest());
        addTestCase("a failed entry of a parse commit leaves the thread as it was", \failedCommitTest());
        addTestCase("a thread runs the thread initialization code of its Program once", \threadInitTest());
        set_return_value(main());
    }

    #! returns a Program with a function and top-level local variables to instantiate
    private static Program makeProgram() {
        Program p(PO_NEW_STYLE);
        # top-level local variables (their declarations are instantiated for each thread that enters the Program);
        # the function reads both, so an instantiation resumed after a failure must have made the second
        p.parse("*int x; *int y; int sub one() { return (x ?? 1) + (y ?? 0); }", "program-entry-failure");
        return p;
    }

    entryTest() {
        Program p = makeProgram();
        hash<auto> r = ProgramContextProbe::enterProgram(p);
        assertEq({"caught": False, "entered": True, "restored": True}, r, "the probe enters the Program");
        assertEq(1, p.callFunction("one"));
    }

    failedEntryTest() {
        if (!exists_function("dbg_fail_next_program_entry")) {
            testSkip("dbg_fail_next_program_entry() is only available in debug builds");
        }
        foreach hash<auto> i in (Sites.pairIterator()) {
            # a new Program for each step, entered in a thread that has not entered it before: the thread's local data
            # is allocated and the top-level variables instantiated on the first entry of a thread (the Program's
            # parse in this thread made this thread's data already)
            Program p = makeProgram();
            Queue q();
            background sub () {
                hash<auto> rv;
                try {
                    call_function("dbg_fail_next_program_entry", i.value);
                    on_exit {
                        # disarmed if the step was not reached
                        call_function("dbg_fail_next_program_entry", -1);
                    }
                    rv.failed = ProgramContextProbe::enterProgram(p);
                    # the thread can enter the Program afterwards, and its code runs with its own local data
                    rv.call = p.callFunction("one");
                    rv.again = ProgramContextProbe::enterProgram(p);
                } catch (hash<ExceptionInfo> ex) {
                    rv.err = sprintf("%s: %s", ex.err, ex.desc);
                }
                q.push(rv);
            }();
            hash<auto> r = q.get(60s);
            assertEq(NOTHING, r.err, i.key + ": no exception");
            assertTrue(r.failed.caught, i.key + ": the allocation failed");
            assertFalse(r.failed.entered, i.key + ": the Program was not entered");
            assertTrue(r.failed.restored, i.key + ": the thread is back in the calling Program");
            assertEq(1, r.call, i.key + ": the Program is entered after the failure");
            assertEq({"caught": False, "entered": True, "restored": True}, r.again,
                i.key + ": the probe enters the Program after the failure");
            # the failed entry released the Program's thread count: deleting the Program does not wait for it
            delete p;
            assertEq(NOTHING, p, i.key + ": the Program was deleted");
        }
    }

    failedCommitTest() {
        if (!exists_function("dbg_fail_next_program_entry")) {
            testSkip("dbg_fail_next_program_entry() is only available in debug builds");
        }
        # the steps that the entry of a parse commit makes (ProgramRuntimeParseCommitContextHelper): the thread's
        # local data and its record in the thread, made on the thread's first entry
        foreach hash<auto> i in (Sites.pairIterator()) {
            if (i.value != 1 && i.value != 2) {
                continue;
            }
            # a Program without code: its code is parsed and committed only from the thread below
            Program p(PO_NEW_STYLE);
            Queue q();
            background sub () {
                hash<auto> rv;
                try {
                    call_function("dbg_fail_next_program_entry", i.value);
                    on_exit {
                        call_function("dbg_fail_next_program_entry", -1);
                    }
                    rv.failed = ProgramContextProbe::commitProgram(p, "int sub two() { return 2; }");
                    # the Program is unlocked: code is committed in it afterwards
                    rv.again = ProgramContextProbe::commitProgram(p, "int sub three() { return 3; }");
                    rv.call = p.callFunction("three");
                } catch (hash<ExceptionInfo> ex) {
                    rv.err = sprintf("%s: %s", ex.err, ex.desc);
                }
                q.push(rv);
            }();
            hash<auto> r = q.get(60s);
            assertEq(NOTHING, r.err, i.key + ": no exception");
            assertTrue(r.failed.caught, i.key + ": the allocation failed");
            assertTrue(r.failed.restored, i.key + ": the thread is back in the calling Program");
            assertEq({"caught": False, "entered": True, "restored": True}, r.again,
                i.key + ": code is committed after the failure");
            assertEq(3, r.call, i.key + ": the committed code runs");
            delete p;
            assertEq(NOTHING, p, i.key + ": the Program was deleted");
        }
    }

    threadInitTest() {
        Program p(PO_NEW_STYLE);
        p.parse(ThreadInitSource, "program-entry-thread-init");
        Program other(PO_NEW_STYLE);
        other.parse("sub call(code c) { c(); }", "program-entry-other");
        p.callFunction("setup");
        assertEq(1, p.callFunction("run", other), "the thread initialization code ran once in the new thread");
    }
}
