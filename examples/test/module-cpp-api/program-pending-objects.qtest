%modern
%enable-all-warnings
# the Program of the Qore subclass test allows reparsing
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires cppapiuser

%exec-class ProgramPendingObjectsTest

#! objects of the builtin classes of a Program that refuses runtime entry while code is parsed in it (qore#6752)
/** A module command can create objects of builtin classes of the Program it runs in (their source Program) while
    the Program has code pending (Program::parsePending() without Program::parseCommit()), or after
    Program::parseRollback() without @ref PO_ALLOW_REPARSE, when the Program refuses runtime entry: module-python
    raises an exception whose argument is an object of a Python class of the Program, and its \c import command adds
    constants with such objects.  The \c "pending-error" and \c "pending-const" commands of the \c cppapiuser test
    module do the same with a class whose destructor and method are C++ code (cpp_api_pending_probe_destroyed()).

    Neither the lookup of a method of such an object (also of a pseudo-method such as \c className()) nor the C++
    destructor of its class runs code of the Program, so neither needs runtime entry into it; a method of the class and
    the destructor of a class with Qore code still do, and are refused.
*/
class ProgramPendingObjectsTest inherits QUnit::Test {
    constructor() : QUnit::Test("program-pending-objects", "1.0") {
        addTestCase("exception argument", \exceptionArgumentTest());
        addTestCase("constants", \constantsTest());
        addTestCase("committed control", \committedControlTest());
        addTestCase("Qore subclass destructor", \qoreSubclassDestructorTest());
        set_return_value(main());
    }

    #! returns a Program with code pending and the test module loaded
    private Program getPendingProgram(int opts = PO_NEW_STYLE) {
        Program p(opts);
        p.parsePending("sub f() {}", "pending");
        p.loadModule("cppapiuser");
        return p;
    }

    exceptionArgumentTest() {
        Program p = getPendingProgram();
        int before = cpp_api_pending_probe_destroyed();
        *string escaped;
        bool caught;
        try {
            try {
                p.issueModuleCmd("cppapiuser", "pending-error");
            } catch (hash<ExceptionInfo> ex) {
                caught = True;
                assertEq("CPPAPIUSER-PENDING-ERROR", ex.err);
                # the pseudo-methods of the object, found after the lookup of the method in its class
                assertEq("PendingProbe", ex.arg.className());
                assertEq("object", ex.arg.type());
                # the lookup of a method that the class does not have
                assertThrows("METHOD-DOES-NOT-EXIST", sub () { ex.arg.noSuchMethod(); });
                # a method of the class is code of the Program, which still refuses runtime entry
                assertThrows("PROGRAM-ERROR", "undergoing parsing", sub () { ex.arg.value(); });
            }
        } catch (hash<ExceptionInfo> ex) {
            # the destruction of the argument with the caught exception after the catch block
            escaped = sprintf("%s: %s", ex.err, ex.desc);
        }
        assertTrue(caught);
        assertNothing(escaped);
        # the C++ destructor ran when the exception was deleted
        assertEq(before + 1, cpp_api_pending_probe_destroyed());

        # the Program can still be committed, and then runs the method
        p.parseCommit();
        try {
            p.issueModuleCmd("cppapiuser", "pending-error");
        } catch (hash<ExceptionInfo> ex) {
            assertEq(1, ex.arg.value());
        }
        assertEq(before + 2, cpp_api_pending_probe_destroyed());
    }

    constantsTest() {
        foreach string mode in ("keep", "rollback") {
            int before = cpp_api_pending_probe_destroyed();
            *string err;
            try {
                Program p = getPendingProgram();
                p.issueModuleCmd("cppapiuser", "pending-const C1");
                p.issueModuleCmd("cppapiuser", "pending-const C2");
                if (mode == "rollback") {
                    p.parseRollback();
                }
                # the deletion of the Program clears its constants while it refuses runtime entry
                delete p;
            } catch (hash<ExceptionInfo> ex) {
                err = sprintf("%s: %s", ex.err, ex.desc);
            }
            assertNothing(err, mode);
            assertEq(before + 2, cpp_api_pending_probe_destroyed(), mode);
        }
    }

    #! a committed Program: no runtime entry is refused (passes without the fix as well)
    committedControlTest() {
        int before = cpp_api_pending_probe_destroyed();
        *string err;
        try {
            Program p = getPendingProgram();
            p.issueModuleCmd("cppapiuser", "pending-const C1");
            p.parseCommit();
            delete p;
        } catch (hash<ExceptionInfo> ex) {
            err = sprintf("%s: %s", ex.err, ex.desc);
        }
        assertNothing(err);
        assertEq(before + 1, cpp_api_pending_probe_destroyed());
    }

    #! the destructor of a Qore subclass is Qore code of the Program: it is still refused, the C++ one still runs
    qoreSubclassDestructorTest() {
        Program p(PO_NEW_STYLE | PO_ALLOW_REPARSE);
        p.loadModule("cppapiuser");
        # the module command creates the builtin class in the Program, while the code is parsed
        p.parse("%module-cmd(cppapiuser) pending-const C1\n"
            "class Sub inherits CppApiPendingProbe::PendingProbe { destructor() { ++destroyed; } } "
            "int destroyed = 0; object sub make() { return new Sub(); } int sub get_destroyed() { return destroyed; }",
            "sub");
        # initializes the global variable
        p.run();
        object o = p.callFunction("make");
        assertEq("Sub", o.className());

        p.parsePending("sub g() {}", "pending");
        int before = cpp_api_pending_probe_destroyed();
        *string err;
        try {
            delete o;
        } catch (hash<ExceptionInfo> ex) {
            err = sprintf("%s: %s", ex.err, ex.desc);
        }
        assertRegex("^PROGRAM-ERROR: .*undergoing parsing", err);
        assertNothing(o);
        # the C++ destructor of the builtin base class ran
        assertEq(before + 1, cpp_api_pending_probe_destroyed());
        p.parseCommit();
        # the Qore destructor did not run
        assertEq(0, p.callFunction("get_destroyed"));
    }
}
