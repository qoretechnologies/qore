#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires QUnit
%requires FsUtil
%requires NothingVariantChecks
%requires ../../ExecModeHarness.qm

%exec-class NothingVariantTest

#! Checks that an argument with no value selects the same variant at parse time and at run time
/** A literal NOTHING, an omitted argument, and a variable holding no value whose type is not known at parse time
    select the same variant: the first variant declared among those that accept no value equally well, in each
    execution mode and from a compiled module.  Before the fix, with three or more such variants the parse-time
    resolution selected the last one, while the run-time resolution selected the first one.
*/
class NothingVariantTest inherits QUnit::Test {
    public {
        #! the variant each call selects
        const Expected = {
            "sfl": "*string",
            "sl": "*string",
            "lsf": "*softlist",
            "fls": "*Foo",
            "isl": "*int",
            "nsl": "*Foo",
            "two": "*string",
            "static": "*string",
            "method": "*string",
            "method-object": "*string",
            "builtin": "*string",
        };

        #! the execution modes that the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("NothingVariantTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("calls in this program", \testInProgram());
        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled module", \testCompiledModule());

        set_return_value(main());
    }

    testInProgram() {
        checkResults("in-program", NothingVariantChecks::get_results());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            checkWorkerOutput(mode, runWorker(get_script_dir(), "--exec-mode=" + mode));
        }
    }

    testCompiledModule() {
        TmpDir tmp("qore-nothing-variants-");
        string qmod_path = tmp.path + DirSep + "NothingVariantChecks.qmod";
        string src_path = get_script_dir() + DirSep + "NothingVariantChecks.qm";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output "
            "%s %s 2>&1", libqore_dir, qore_bin, qmod_path, src_path));
        assertTrue(is_file(qmod_path), "compiled module: " + compile_out);

        # the directory holds only the compiled module, so the worker cannot load the source instead
        checkWorkerOutput("aot", runWorker(tmp.path));
    }

    #! runs the worker with the module loaded from the given directory and returns its output
    private string runWorker(string module_dir, string opts = "") {
        string worker = get_script_dir() + DirSep + "nothing-variants-worker.q";
        module_dir += ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : "";
        return ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b --enable-debug %s %s",
            libqore_dir, module_dir, qore_bin, opts, worker));
    }

    #! parses the "name=variant" lines printed by the worker and checks them
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.+)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        checkResults(label, results);
    }

    private checkResults(string label, hash<string, string> results) {
        hash<string, string> expected = {};
        foreach hash<auto> i in (Expected.pairIterator()) {
            foreach string form in ("literal", "omitted", "variable") {
                string key = i.key + "-" + form;
                if (i.key == "method-object" && form == "omitted") {
                    continue;
                }
                expected{key} = i.value;
            }
        }
        assertEq(expected, results, label);
    }
}
