%modern
%enable-all-warnings

# the "cppapiuser" test module is built into the build tree by
# examples/test/module-cpp-api/CMakeLists.txt and is not installed, so QORE_MODULE_DIR must include
# the build tree (run_tests.sh does this)
%requires cppapiuser

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/QUnit.qm

%exec-class SerializationContextIndexTest

#! tests the serialization index API used by builtin serializers and deserializers
/** A builtin serializer stores the index strings returned by QoreSerializationContext::serializeHash(),
    serializeList() and serializeObject(), and its deserializer passes them to
    QoreDeserializationContext::deserializeContainer().  The SerializationIndexProbe class from the
    "cppapiuser" test module serializes its label through a hash and a list that are released as soon as
    they have been serialized, and verifies in its deserializer that each stored index resolves to the
    expected container.
*/
class SerializationContextIndexTest inherits QUnit::Test {
    public {
        #! the class data key of the probe class
        const ProbeClass = "Qore::CppApiTest::SerializationIndexProbe";
        #! the number of probes serialized in one operation
        const Probes = 200;
    }

    constructor() : QUnit::Test("serialization-context-index", "1.0") {
        addTestCase("context index strings name index entries", \indexStrings());
        addTestCase("context index strings round trip", \roundTrip());
        addTestCase("released native containers keep distinct identities", \releasedContainers());
        addTestCase("invalid context index strings are rejected", \invalidIndexes());
        set_return_value(main());
    }

    indexStrings() {
        SerializationIndexProbe probe("label-ü");
        hash<SerializationInfo> data = Serializable::serializeToData(probe);
        # the object, its hash and its list
        assertEq(3, data._index.size());
        string self_index = data._data._index;
        hash<auto> indexes = data._index{self_index}._class_data{ProbeClass};
        assertEq(self_index, indexes.self);
        assertEq("label-ü", data._index{indexes.hash}._members.label);
        assertEq(("label-ü",), data._index{indexes.list}._elements);
    }

    roundTrip() {
        SerializationIndexProbe probe("label-ü");
        SerializationIndexProbe restored = Serializable::deserialize(Serializable::serialize(probe));
        assertTrue(restored !== probe);
        assertEq("label-ü", restored.getLabel());
    }

    releasedContainers() {
        list<SerializationIndexProbe> probes = map new SerializationIndexProbe("label-" + $1), xrange(Probes);
        hash<SerializationInfo> data = Serializable::serializeToData(probes);
        # the source list, then for each probe: the object, its hash and its list
        assertEq(1 + Probes * 3, data._index.size());
        list<auto> restored = Serializable::deserialize(data);
        assertEq(Probes, restored.size());
        foreach SerializationIndexProbe probe in (restored) {
            assertEq("label-" + $#, probe.getLabel());
        }
    }

    invalidIndexes() {
        SerializationIndexProbe probe("label");
        hash<SerializationInfo> good = Serializable::serializeToData(probe);
        string self_index = good._data._index;
        hash<auto> indexes = good._index{self_index}._class_data{ProbeClass};

        hash<SerializationInfo> data = good;
        data._index{self_index}._class_data{ProbeClass}.hash = "missing";
        assertThrows("DESERIALIZATION-ERROR", "no such index exists", \Serializable::deserialize(), (data,));

        data = good;
        data._index{self_index}._class_data{ProbeClass}.list = indexes.hash;
        assertThrows("DESERIALIZATION-ERROR", "list index", \Serializable::deserialize(), (data,));

        data = good;
        data._index{self_index}._class_data{ProbeClass}.self = indexes.hash;
        assertThrows("DESERIALIZATION-ERROR", "self index", \Serializable::deserialize(), (data,));

        data = good;
        remove data._index{self_index}._class_data{ProbeClass}.hash;
        assertThrows("DESERIALIZATION-ERROR", "key 'hash'", \Serializable::deserialize(), (data,));

        SerializationIndexProbe restored = Serializable::deserialize(good);
        assertEq("label", restored.getLabel());
    }
}
