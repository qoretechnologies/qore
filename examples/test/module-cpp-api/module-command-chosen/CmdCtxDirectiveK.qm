%modern

# a user module with a %module-cmd directive in its own source that a sandboxed Program loads by a path of its own,
# from its source and compiled with qcc (module-command-context.qtest, testSandboxedLoaderReplay()): not library code,
# so its command is judged by the restrictions of the loader

module CmdCtxDirectiveK {
    version = "1.0";
    desc = "issues a module command from the source of a module";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

%module-cmd(cmdctxaware) record
