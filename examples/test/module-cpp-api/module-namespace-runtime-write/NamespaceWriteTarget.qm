%modern

module NamespaceWriteTarget {
    version = "1.0";
    desc = "test module: every import copies its namespaces from the module's shared Program, which a binary module "
        "writes to at the same time";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! the module's public namespace, copied into each importing Program
public namespace NamespaceWriteTarget {
    #! a nested namespace, so that an import walks the sub-namespace map
    public namespace Inner {
        #! a class an importing Program calls
        public class Item {
            #! returns a fixed value
            static int value() {
                return 42;
            }
        }
    }

    #! a constant an importing Program reads
    public const Version = "1.0";
}
