#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - sandbox network and filesystem policy for DBI connections, host name resolution and UNIX sockets

# Copyright (C) 2026 Qore Technologies, s.r.o.

# the "dbitargetprobe" test module is built into the build tree by examples/test/module-cpp-api/CMakeLists.txt and is
# not installed

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires dbitargetprobe
%requires QUnit
%requires FsUtil

%exec-class DatasourceSandboxTargetsTest

#! Tests the sandbox check of DBI connections (qore#5747)
/** Before a driver opens a connection that code governed by a sandbox restricting network or filesystem access chose,
    the Qore library asks the driver for the destinations of the connection and checks each of them against the policy
    of every such sandbox: a TCP destination by each address of its host, a UNIX socket against the network and
    filesystem policy.  The driver is given the checked destinations with the addresses of each host, and a driver that
    cannot report its destinations is refused, unless it declares that it reaches local resources only.

    The "dbitargetprobe" driver reports its destinations from the host name of the datasource and returns the checked
    destinations that it was given; "dbilocalprobe" reaches local files only, and "dbinotargetprobe" reports no
    destinations (see dbitargetprobe-module.cpp).  Every address used is a loopback address or one of TEST-NET-3
    (RFC 5737), and no driver connects to anything.
*/
public class DatasourceSandboxTargetsTest inherits QUnit::Test {
    public {
        #! the code of the sandboxed Programs
        const Source = "
Datasource sub make(string type, string host, int port = 0, string db = \"db\") {
    return new Datasource({\"type\": type, \"user\": \"u\", \"pass\": \"p\", \"db\": db, \"host\": host, \"port\": port});
}

auto sub open_select(string type, string host, int port = 0, string sql = \"checked\", string db = \"db\") {
    Datasource ds = make(type, host, port, db);
    ds.open();
    on_exit ds.close();
    return ds.select(sql);
}

auto sub open_ds(Datasource ds, string sql = \"checked\") {
    ds.open();
    on_exit ds.close();
    return ds.select(sql);
}

nothing sub set_host(Datasource ds, string host) {
    ds.setHostName(host);
}

auto sub use_pool(DatasourcePool pool) {
    return pool.select(\"checked\");
}

auto sub open_pool(string host) {
    DatasourcePool pool({\"type\": \"dbitargetprobe\", \"db\": \"db\", \"host\": host, \"options\": {\"min\": 1, \"max\": 1}});
    on_exit delete pool;
    return pool.select(\"checked\");
}
";

        #! the denied range of the tests: TEST-NET-3 (RFC 5737), where no destination of a test can be
        const DeniedRange = "203.0.113.0/24";
    }

    constructor() : QUnit::Test("DatasourceSandboxTargetsTest", "1.0", \ARGV) {
        addTestCase("a connection that no sandbox chose is not checked", \testNoSandbox());
        addTestCase("a sandbox that restricts nothing does not check", \testAllowAll());
        addTestCase("a denied TCP destination is refused before the driver connects", \testDenied());
        addTestCase("every destination is checked", \testEveryDestination());
        addTestCase("the driver is given the checked addresses of each host", \testCheckedAddresses());
        addTestCase("a host name is checked by its name and by each of its addresses", \testHostName());
        addTestCase("the port is checked", \testPort());
        addTestCase("a UNIX socket is checked against the network and filesystem policy", \testSocket());
        addTestCase("destinations that cannot be checked are refused", \testUncheckable());
        addTestCase("a driver that cannot report its destinations is refused", \testNoTargets());
        addTestCase("a local-only driver checks its files itself", \testLocalOnly());
        addTestCase("the policy is that of the code that chose the connection", \testChooser());
        addTestCase("each open is checked with the current policy", \testReopen());
        addTestCase("a driver checks an address that its connection reached", \testConnectAddress());
        set_return_value(main());
    }

    #! a sandbox that allows by default and denies TEST-NET-3
    static SandboxManager denyTestNet() {
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        sm.setFilesystemDefaultPolicy(True);
        sm.addNetworkDeniedIPRange(DeniedRange);
        return sm;
    }

    #! a sandbox that restricts nothing
    static SandboxManager allowAll() {
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        sm.setFilesystemDefaultPolicy(True);
        return sm;
    }

    #! returns a Program governed by the sandbox
    static Program sandboxed(SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.loadModule("dbitargetprobe");
        p.parse("%modern\n" + Source, "datasource-sandbox-targets");
        p.setSandboxManager(sm);
        return p;
    }

    #! returns the error of a call in the Program, or what it returns
    static auto call(Program p, string func, ...) {
        try {
            return p.callFunctionArgs(func, argv);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    testNoSandbox() {
        DbiTargetProbe::reset();
        Datasource ds({"type": "dbitargetprobe", "db": "db", "host": "203.0.113.1"});
        ds.open();
        on_exit ds.close();
        assertEq(NOTHING, ds.select("checked"), "not checked");
        assertEq(0, DbiTargetProbe::targetCalls(), "the driver was not asked");
    }

    testAllowAll() {
        DbiTargetProbe::reset();
        Program p = sandboxed(allowAll());
        assertEq(NOTHING, call(p, "open_select", "dbitargetprobe", "203.0.113.1"), "not checked");
        assertEq(0, DbiTargetProbe::targetCalls(), "the driver was not asked");
        # a driver that cannot report its destinations is not refused
        assertEq(NOTHING, call(p, "open_select", "dbinotargetprobe", "203.0.113.1"));
    }

    testDenied() {
        DbiTargetProbe::reset();
        Program p = sandboxed(denyTestNet());
        assertEq("NETWORK-ACCESS-DENIED", call(p, "open_select", "dbitargetprobe", "203.0.113.1"));
        assertEq(0, DbiTargetProbe::opens(), "the driver did not connect");
        assertEq(1, DbiTargetProbe::targetCalls(), "the driver was asked once");
    }

    testEveryDestination() {
        Program p = sandboxed(denyTestNet());
        assertEq("NETWORK-ACCESS-DENIED", call(p, "open_select", "dbitargetprobe", "127.0.0.1,203.0.113.2"));
        assertEq("NETWORK-ACCESS-DENIED", call(p, "open_select", "dbitargetprobe", "203.0.113.2,127.0.0.1"));
    }

    testCheckedAddresses() {
        Program p = sandboxed(denyTestNet());
        assertEq(({"host": "127.0.0.1", "port": 6000, "addresses": ("127.0.0.1",)},),
            call(p, "open_select", "dbitargetprobe", "127.0.0.1", 6000));
        # the default port of the driver, two destinations in the order of the driver
        assertEq((
            {"host": "127.0.0.2", "port": 5432, "addresses": ("127.0.0.2",)},
            {"host": "::1", "port": 5432, "addresses": ("::1",)},
        ), call(p, "open_select", "dbitargetprobe", "127.0.0.2,::1"));
        # the datasource keeps them while the connection is open
        assertEq(call(p, "open_select", "dbitargetprobe", "127.0.0.1", 6000, "checked"),
            call(p, "open_select", "dbitargetprobe", "127.0.0.1", 6000, "current"));
    }

    testHostName() {
        Program p = sandboxed(denyTestNet());
        list<auto> checked = call(p, "open_select", "dbitargetprobe", "localhost");
        assertEq(1, checked.size());
        assertEq("localhost", checked[0].host, "the host as the driver reported it");
        assertTrue(checked[0].addresses.size() > 0, "the addresses of the host");
        foreach string addr in (checked[0].addresses) {
            assertTrue(addr =~ /^127\./ || addr == "::1", "a loopback address: " + addr);
        }

        # an address of the host is denied
        SandboxManager deny_lo = allowAll();
        deny_lo.addNetworkDeniedIPRange("127.0.0.0/8");
        deny_lo.addNetworkDeniedIPRange("::1/128");
        assertEq("NETWORK-ACCESS-DENIED", call(sandboxed(deny_lo), "open_select", "dbitargetprobe", "localhost"));

        # an allowed host name pattern applies to the addresses of the host
        SandboxManager by_name();
        by_name.setNetworkDefaultPolicy(False);
        by_name.setFilesystemDefaultPolicy(True);
        by_name.addNetworkAllowedHost("localhost");
        assertEq("localhost", call(sandboxed(by_name), "open_select", "dbitargetprobe", "localhost")[0].host);
        assertEq("NETWORK-ACCESS-DENIED", call(sandboxed(by_name), "open_select", "dbitargetprobe", "127.0.0.1"));
    }

    testPort() {
        SandboxManager only_port = allowAll();
        only_port.addNetworkAllowedPort(5432);
        Program p = sandboxed(only_port);
        assertEq("NETWORK-ACCESS-DENIED", call(p, "open_select", "dbitargetprobe", "127.0.0.1", 6000));
        assertEq("127.0.0.1", call(p, "open_select", "dbitargetprobe", "127.0.0.1", 5432)[0].host);
    }

    testSocket() {
        TmpDir dir("dbi-sandbox-targets");
        string path = dir.path + "/.s.PGSQL.5432";
        # only the socket of the connection is denied
        SandboxManager deny_socket = denyTestNet();
        deny_socket.addFilesystemDeniedPath(path);
        assertEq("FILESYSTEM-ACCESS-DENIED", call(sandboxed(deny_socket), "open_select", "dbitargetprobe", path));
        SandboxManager deny_other = denyTestNet();
        deny_other.addFilesystemDeniedPath(path + "0");
        assertEq(({"socket": path},), call(sandboxed(deny_other), "open_select", "dbitargetprobe", path));

        # an abstract socket is no file that the filesystem policy can decide on
        assertEq("NETWORK-ACCESS-DENIED", call(sandboxed(denyTestNet()), "open_select", "dbitargetprobe",
            "@qore-test"));
    }

    testUncheckable() {
        Program p = sandboxed(denyTestNet());
        # a host that cannot be resolved (RFC 6761)
        assertEq("NETWORK-ACCESS-DENIED", call(p, "open_select", "dbitargetprobe", "qore-test.invalid"));
        # an invalid destination and no destination
        assertEq("NETWORK-ACCESS-DENIED", call(p, "open_select", "dbitargetprobe", "bad"));
        assertEq("NETWORK-ACCESS-DENIED", call(p, "open_select", "dbitargetprobe", "none"));
        # the driver refuses the connection itself
        assertEq("DBITARGETPROBE-REFUSED", call(p, "open_select", "dbitargetprobe", "raise"));
    }

    testNoTargets() {
        DbiTargetProbe::reset();
        # the destination is allowed: the driver is refused, as it cannot report where it connects
        assertEq("NETWORK-ACCESS-DENIED", call(sandboxed(denyTestNet()), "open_select", "dbinotargetprobe", "127.0.0.1"));
        # a sandbox that restricts the filesystem only also refuses it
        SandboxManager fs_only = allowAll();
        fs_only.addFilesystemDeniedPath("/qore-test-denied");
        assertEq("NETWORK-ACCESS-DENIED", call(sandboxed(fs_only), "open_select", "dbinotargetprobe", "127.0.0.1"));
    }

    testLocalOnly() {
        TmpDir dir("dbi-sandbox-local");
        string file = dir.path + "/test.db";
        # no network access at all: the driver reaches no network destination and is not asked for any
        SandboxManager no_net();
        no_net.setNetworkDefaultPolicy(False);
        no_net.setFilesystemDefaultPolicy(True);
        Program p = sandboxed(no_net);
        assertTrue(call(p, "open_select", "dbilocalprobe", "", 0, "restricted", file), "restricted");
        # the filesystem policy of the code that chose the file decides
        no_net.addFilesystemDeniedPath(file);
        assertEq("FILESYSTEM-ACCESS-DENIED", call(p, "open_select", "dbilocalprobe", "", 0, "restricted", file));
        # not restricted for trusted code
        Datasource ds({"type": "dbilocalprobe", "db": file});
        ds.open();
        on_exit ds.close();
        assertFalse(ds.select("restricted"), "not restricted");
        assertTrue(inlist("LocalOnly", dbi_get_driver_capability_list("dbilocalprobe")));
        assertFalse(inlist("LocalOnly", dbi_get_driver_capability_list("dbitargetprobe")));
    }

    testChooser() {
        Program p = sandboxed(denyTestNet());
        # a datasource that trusted code configured, opened by the sandboxed code: not checked
        Datasource trusted({"type": "dbitargetprobe", "db": "db", "host": "203.0.113.1"});
        assertEq(NOTHING, call(p, "open_ds", trusted));
        # the sandboxed code sets the host of a trusted datasource, which trusted code opens: checked
        Datasource configured({"type": "dbitargetprobe", "db": "db", "host": "127.0.0.1"});
        call(p, "set_host", configured, "203.0.113.1");
        assertThrows("NETWORK-ACCESS-DENIED", \configured.open());
        call(p, "set_host", configured, "127.0.0.1");
        configured.open();
        on_exit configured.close();
        assertEq("127.0.0.1", configured.select("checked")[0].host, "checked for the sandbox of the setter");

        # a pool that the sandboxed code created: its connections are checked
        assertEq("NETWORK-ACCESS-DENIED", call(p, "open_pool", "203.0.113.1"));
        assertEq("127.0.0.1", call(p, "open_pool", "127.0.0.1")[0].host);
        # a trusted pool used by the sandboxed code: not checked
        DatasourcePool pool({"type": "dbitargetprobe", "db": "db", "host": "203.0.113.1", "options": {"min": 1,
            "max": 1}});
        on_exit delete pool;
        assertEq(NOTHING, call(p, "use_pool", pool));
    }

    testReopen() {
        SandboxManager sm = denyTestNet();
        Program p = sandboxed(sm);
        Datasource ds = p.callFunction("make", "dbitargetprobe", "127.0.0.1");
        ds.open();
        ds.close();
        # the policy changes: the next open is checked with it
        sm.addNetworkDeniedIPRange("127.0.0.0/8");
        assertThrows("NETWORK-ACCESS-DENIED", \ds.open());
    }

    #! qore#6649: qore_dbi_check_connect_address() checks an address that a connection reached (a redirect of the
    #! server, for example) against the same policies as the destinations before the connection
    testConnectAddress() {
        Program p = sandboxed(denyTestNet());
        # a datasource that the sandboxed code created
        Datasource ds = p.callFunction("make", "dbitargetprobe", "127.0.0.1");
        ds.open();
        on_exit ds.close();
        assertThrows("NETWORK-ACCESS-DENIED", \ds.select(), "address 203.0.113.7", "a denied address");
        assertThrows("NETWORK-ACCESS-DENIED", \ds.select(), "address ::ffff:203.0.113.7",
            "a denied address, mapped to IPv6");
        assertEq(True, ds.select("address 127.0.0.1"), "an allowed address");
        assertEq(True, ds.select("address ::1"), "an allowed IPv6 address");
        assertEq(True, ds.select("address localhost 127.0.0.1"), "with a host name");

        # a copy of it, which trusted code made and opened: checked with the same policy as its destinations
        Datasource copy = ds.copy();
        copy.open();
        on_exit copy.close();
        assertEq("127.0.0.1", copy.select("checked")[0].host, "the copy's destinations were checked");
        assertThrows("NETWORK-ACCESS-DENIED", \copy.select(), "address 203.0.113.7", "the copy: a denied address");
        assertEq(True, copy.select("address 127.0.0.1"), "the copy: an allowed address");

        # a datasource that no sandbox chose: nothing is checked
        Datasource trusted({"type": "dbitargetprobe", "db": "db", "host": "127.0.0.1"});
        trusted.open();
        on_exit trusted.close();
        assertEq(True, trusted.select("address 203.0.113.7"), "not restricted");

        # the policy of the code that set a value of a trusted datasource applies (the record of the values in use)
        Datasource configured({"type": "dbitargetprobe", "db": "db", "host": "127.0.0.2"});
        call(p, "set_host", configured, "127.0.0.1");
        configured.open();
        on_exit configured.close();
        assertThrows("NETWORK-ACCESS-DENIED", \configured.select(), "address 203.0.113.7", "the setter's sandbox");
    }
}