%modern

module TestCertificates {
    version = "1.0";
    desc    = "the TLS certificate and key that the tests use";
    author  = "David Nichols <david@qore.org>";
    url     = "http://qore.org";
    license = "MIT";
}

/** Tests that need a TLS server certificate use this one instead of embedding their own, so that no test certificate
    expires unnoticed: examples/test/qlib/SSL/test-certificate-expiry.qtest fails when any certificate under
    examples/test expires within five years.

    The certificate is self-signed for \c localhost, \c 127.0.0.1 and \c ::1 and valid until 2126.  Its key is public:
    never use either outside tests.

    @par Example:
    @code{.py}
%requires ../../TestCertificates.qm

int port = server.addListener(<HttpListenerOptionInfo>{
    "service": 0,
    "cert": new SSLCertificate(TestCertificates::CertPem),
    "key": new SSLPrivateKey(TestCertificates::KeyPem),
}).port;
    @endcode
*/
public namespace TestCertificates {
