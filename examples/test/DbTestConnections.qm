%modern

module DbTestConnections {
    version = "1.0";
    desc = "gives the database connections that a database-generic test runs against";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
}

/** @mainpage DbTestConnections Module

    A test that works with any database runs against every database connection that is configured, not only the
    first one found: a test that used only the first one never ran against the others, so a defect of another
    driver went unnoticed.

    The connections are given by the test's \c -c / \c --conn option, which is then the only one, or else by the
    environment variables in DbTestConnections::EnvVars; a datasource string given by more than one variable is
    used once, under the first variable that gives it.
*/

#! the namespace of the module
public namespace DbTestConnections {
#! a database connection that a test runs against
public hashdecl DbTestConnection {
    #! the name of the connection in test case names: the environment variable that gives it, or \c "conn"
    string label;

    #! the datasource string
    string connstr;

    #! the driver of the datasource string, or @ref nothing if it cannot be parsed
    *string driver;
}

#! gives the database connections of a database-generic test
public class DbTestConnections {
    public {
        #! the environment variables that give database connections, in the order that they are used
        const EnvVars = (
            "QORE_DB_CONNSTR",
            "QORE_DB_CONNSTR_PGSQL",
            "QORE_DB_CONNSTR_ORACLE",
            "QORE_DB_CONNSTR_MYSQL",
            "QORE_DB_CONNSTR_FREETDS",
        );
    }

    #! returns the connections that a test runs against
    /** @param connstr the datasource string of the test's \c -c option; when it is set, it is the only connection
        @param env the environment to read the variables from

        @return the connections, each datasource string once; an empty list if none is configured
    */
    static list<hash<DbTestConnection>> get(*string connstr, hash<auto> env = ENV) {
        if (connstr.val()) {
            return (DbTestConnections::make("conn", connstr),);
        }
        list<hash<DbTestConnection>> rv = ();
        hash<string, bool> seen = {};
        foreach string var in (EnvVars) {
            auto value = env{var};
            if (value.typeCode() != NT_STRING || !value.val() || seen{value}) {
                continue;
            }
            seen{value} = True;
            rv += DbTestConnections::make(var, value);
        }
        return rv;
    }

    #! returns a connection
    private static hash<DbTestConnection> make(string label, string connstr) {
        *string driver;
        try {
            driver = parse_datasource(connstr).type;
        } catch (hash<ExceptionInfo> ex) {
            # the test reports the error when it opens the connection
        }
        return <DbTestConnection>{
            "label": label,
            "connstr": connstr,
            "driver": driver,
        };
    }
}
}
