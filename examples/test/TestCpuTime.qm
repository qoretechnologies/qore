%modern

module TestCpuTime {
    version = "1.0";
    desc    = "the CPU time that the test process has used";
    author  = "David Nichols <david@qore.org>";
    url     = "http://qore.org";
    license = "MIT";
}

/** A test that checks that a server waits without running continuously measures the CPU time that its own process
    uses over the wait, without the compiles of the JIT's background compile thread (named @c qore-jit-bg): tiered
    execution compiles a function in the background once it is called often enough, which can happen during the wait
    (a client thread of the test that runs Qore code), and a compile can take tenths of a second; it is not the
    server's work (qoretechnologies/qore#7654).

    @par Example:
    @code{.py}
%requires ../../TestCpuTime.qm

hash<string, int> start = TestCpuTime::cpuSnapshot();
usleep(6s);
float used = TestCpuTime::cpuTimeSince(start);
    @endcode
*/
public namespace TestCpuTime {
#! Returns a snapshot of the CPU time that the threads of the process have used, for cpuTimeSince()
/** On Linux, the CPU time of each thread in nanoseconds, from the first field of its
    @c /proc/self/task/<tid>/schedstat, or, on a kernel without it, from the @c utime and @c stime fields of its
    @c /proc/self/task/<tid>/stat (in clock ticks of 10 ms), without the JIT's background compile thread (named
    @c qore-jit-bg); elsewhere the CPU time of the process from ps(1) (hundredths of a second on macOS), under
    the key @c "ps", which includes the compiles

    @throw CPU-TIME-ERROR the CPU time cannot be read
*/
public hash<string, int> sub cpuSnapshot() {
    hash<string, int> rv();
    if (is_readable("/proc/self/task")) {
        foreach string path in (glob("/proc/self/task/*/schedstat")) {
            if (isJitCompileThread(path)) {
                continue;
            }
            string str;
            try {
                str = (new ReadOnlyFile(path)).read(-1);
            } catch (hash<ExceptionInfo> ex) {
                # the thread ended
                continue;
            }
            *string ns = (str =~ x/^([0-9]+)/)[0];
            if (ns) {
                rv{path} = ns.toInt();
            }
        }
        if (rv) {
            return rv;
        }
        foreach string path in (glob("/proc/self/task/*/stat")) {
            if (isJitCompileThread(path)) {
                continue;
            }
            string str;
            try {
                str = (new ReadOnlyFile(path)).read(-1);
            } catch (hash<ExceptionInfo> ex) {
                # the thread ended
                continue;
            }
            # the fields after the command name, which is in parentheses and can contain spaces: utime and stime are
            # the 14th and 15th fields of the line, the 12th and 13th after the name
            int i = str.rfind(")");
            if (i < 0) {
                continue;
            }
            list<string> fields = trim(str.substr(i + 1)).split(" ");
            if (fields.size() > 12) {
                rv{path} = (fields[11].toInt() + fields[12].toInt()) * 10000000;
            }
        }
        if (rv) {
            return rv;
        }
    }
    return {"ps": psCpuTimeNs()};
}

#! Returns the CPU time in seconds that the process has used since the snapshot
/** On Linux, the growth of each thread that exists at both times plus the whole time of each thread started since;
    a thread that ended in between is not counted

    @throw CPU-TIME-ERROR the CPU time cannot be read
*/
public float sub cpuTimeSince(hash<string, int> start) {
    hash<string, int> now = cpuSnapshot();
    int ns = 0;
    foreach hash<auto> i in (now.pairIterator()) {
        ns += i.value - (start{i.key} ?? 0);
    }
    return ns / 1000000000.0;
}

#! Returns @ref True if the thread of a task file is the JIT background compile thread
/** Returns @ref True if the thread of the @c /proc/self/task/<tid>/ file @p path is the JIT's background compile
    thread, which libqore names @c qore-jit-bg (a thread that ended or cannot be read is not)
*/
bool sub isJitCompileThread(string path) {
    try {
        return trim((new ReadOnlyFile(dirname(path) + "/comm")).read(-1)) == "qore-jit-bg";
    } catch (hash<ExceptionInfo> ex) {
        return False;
    }
}

#! Returns the CPU time of the process from ps(1), which prints it as [[dd-]hh:]mm:ss[.ss], in nanoseconds
/** Linux's ps prints whole seconds, which is why cpuSnapshot() does not use it there
*/
int sub psCpuTimeNs() {
    string str = trim(backquote(sprintf("ps -o time= -p %d", getpid())));
    if (str !~ /^[0-9]/) {
        throw "CPU-TIME-ERROR", sprintf("cannot read the CPU time of process %d: %y", getpid(), str);
    }
    int days = 0;
    if (str =~ /-/) {
        (*string d, *string rest) = (str =~ x/^([0-9]+)-(.*)$/);
        days = d.toInt();
        str = rest;
    }
    float rv = 0.0;
    foreach string part in (str.split(":")) {
        rv = rv * 60.0 + part.toFloat();
    }
    return ((rv + days * 86400.0) * 1000000000.0).toInt();
}
}
