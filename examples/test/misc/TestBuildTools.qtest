#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - the shell's command search, with and without PATH, and executable file checks
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../TestBuildTools.qm

%exec-class TestBuildToolsTest

#! The tests of TestBuildTools: a tool is missing only when the shell cannot run it
public class TestBuildToolsTest inherits QUnit::Test {
    constructor() : Test("TestBuildToolsTest", "1.0") {
        addTestCase("command words", \commandWordsTest());
        addTestCase("find a command", \findCommandTest());
        addTestCase("find a command without PATH", \noPathTest());
        set_return_value(main());
    }

    commandWordsTest() {
        assertEq(("c++",), TestBuildTools::command_words(NOTHING, "c++"));
        # an empty or blank variable is not set
        assertEq(("c++",), TestBuildTools::command_words("", "c++"));
        assertEq(("cc",), TestBuildTools::command_words(" \t ", "cc"));
        # a launcher before the compiler, and any whitespace between the words
        assertEq(("ccache", "c++", "-O2"), TestBuildTools::command_words("  ccache\tc++  -O2\n", "cc"));
        assertEq(("clang", "-m64"), TestBuildTools::command_words(NOTHING, "clang -m64"));
        assertEq((), TestBuildTools::command_words(NOTHING, ""));
    }

    findCommandTest() {
        # a name that the shell finds in its search path
        *string sh = TestBuildTools::find_command("sh");
        assertTrue(sh =~ /\/sh$/, sprintf("%y", sh));
        assertTrue(sh && is_executable(sh), sprintf("%y", sh));
        # a path
        assertEq("/bin/sh", TestBuildTools::find_command("/bin/sh"));
        # missing: no such command, a file that is not executable, a directory, no such file, nothing
        assertEq(NOTHING, TestBuildTools::find_command("qore-test-no-such-command-6047"));
        TmpDir dir("qore-test-build-tools-");
        string file = dir.path + "/not-executable";
        File f();
        f.open2(file, O_WRONLY | O_CREAT | O_TRUNC);
        f.write("#!/bin/sh\n");
        f.close();
        assertEq(NOTHING, TestBuildTools::find_command(file));
        assertEq(NOTHING, TestBuildTools::find_command(dir.path));
        assertEq(NOTHING, TestBuildTools::find_command(dir.path + "/no-such-file"));
        assertEq(NOTHING, TestBuildTools::find_command(""));
        # a name with characters that the shell would interpret is a name, not a command line
        assertEq(NOTHING, TestBuildTools::find_command("sh; echo x"));
    }

    noPathTest() {
        # without PATH, the shell searches its default path, where it finds sh
        *string path = ENV.PATH;
        on_exit {
            if (exists path) {
                setenv("PATH", path);
            }
        }
        unsetenv("PATH");
        *string sh = TestBuildTools::find_command("sh");
        assertTrue(sh =~ /\/sh$/, sprintf("%y", sh));
        assertEq(NOTHING, TestBuildTools::find_command("qore-test-no-such-command-6047"));
    }
}
