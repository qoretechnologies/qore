#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - qcc AOT code generation and JIT native code of inline strings passed to the i18n module

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires Util
%requires ../../../examples/test/TestInterpreter.qm

%include ../../../examples/test/ShortStringProbeTest.qc

%exec-class I18nShortStringAccessTest

#! the i18n module reads the strings of its options in both of their representations (qore#7062)
/** A value holds a string of up to 6 bytes inline, with no QoreStringNode behind it; the module read a catalog path
    option as a QoreStringNode after checking only its type, which dereferenced a null pointer for such a value (and a
    debug build aborted on an assertion).  The probes (short-string-access/probes.q) run in each execution mode and
    as qcc-compiled executables.
*/
class I18nShortStringAccessTest inherits ShortStringProbeTest {
    constructor() : ShortStringProbeTest("i18n short string access",
            get_script_dir() + DirSep + "short-string-access" + DirSep + "probes.q",
            "search_path: /x\n"
            "override_path: /x,/y\n") {
        set_return_value(main());
    }
}
