//! Formats a currency value with explicit locale data and options.
/** @param value integer, floating-point, number, or base-10 decimal string
    @param currency ISO 4217 currency code such as \c "USD" or \c "EUR"
    @param locale BCP 47 locale tag
    @param opts optional hash; supported keys are \c min_fraction_digits, \c max_fraction_digits, and \c grouping
    @return locale-formatted currency value

    @throw I18N-NUMBER-ERROR if \a value is a malformed decimal string
    @throw I18N-CURRENCY-ERROR if \a currency is invalid
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-FORMAT-ERROR if \a opts is invalid
    @throw I18N-ICU-ERROR if ICU cannot format the value
*/
string format_currency(auto value, string currency, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_format_currency_value(value, currency, locale, opts, xsink);
}

//! Formats an absolute date/time value with explicit locale data.
/** @param dt absolute date/time value
    @param locale BCP 47 locale tag, including supported calendar/hour-cycle extensions
    @return locale-formatted date/time with medium date and short time styles

    @throw I18N-DATETIME-ERROR if \a dt is relative
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-FORMAT-ERROR if formatting options are invalid
    @throw I18N-ICU-ERROR if ICU cannot create a date/time formatter
*/
string format_datetime(date dt, string locale) [flags=RET_VALUE_ONLY] {
    return i18n_format_datetime_value(dt, locale, nullptr, xsink);
}

//! Formats an absolute date/time value with explicit locale data and style options.
/** @param dt absolute date/time value
    @param locale BCP 47 locale tag, including supported calendar/hour-cycle extensions
    @param opts optional hash; \c date_style and \c time_style may be \c "none", \c "short", \c "medium", \c "long",
        or \c "full"; alternatively pass \c skeleton for CLDR skeleton formatting such as \c "yMMMd"
    @return locale-formatted date/time

    @throw I18N-DATETIME-ERROR if \a dt is relative
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-FORMAT-ERROR if \a opts is invalid
    @throw I18N-ICU-ERROR if ICU cannot create a date/time formatter
*/
string format_datetime(date dt, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_format_datetime_value(dt, locale, opts, xsink);
}

//! Compares two strings using explicit locale collation.
/** @param left left string
    @param right right string
    @param locale BCP 47 locale tag, including supported Unicode collation extensions
    @return \c -1 if \a left sorts before \a right, \c 1 if after, or \c 0 if equal under the collator

    @throw I18N-STRING-ERROR if either string cannot be converted to UTF-8
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create a collator
*/
int compare_strings(string left, string right, string locale) [flags=RET_VALUE_ONLY] {
    std::string left_str = i18n_string_arg_to_utf8(left, xsink, "left");
    if (*xsink) {
        return QoreValue();
    }
    std::string right_str = i18n_string_arg_to_utf8(right, xsink, "right");
    if (*xsink) {
        return QoreValue();
    }
    std::unique_ptr<icu::Collator> collator = i18n_make_collator(locale, xsink);
    if (*xsink) {
        return QoreValue();
    }

    icu::Collator::EComparisonResult result = collator->compare(i18n_utf8_to_unicode_string(left_str),
        i18n_utf8_to_unicode_string(right_str));
    return result == icu::Collator::LESS ? -1 : result == icu::Collator::GREATER ? 1 : 0;
}

//! Evaluates a locale-sensitive string predicate using ICU collation rules.
/** @param value string to test
    @param op predicate operator: \c "contains", \c "starts-with", \c "ends-with", or \c "equals"
    @param needle string to search for or compare against
    @param locale BCP 47 locale tag, including supported Unicode collation extensions
    @return @ref True if \a value matches the predicate under the locale collator

    @throw I18N-STRING-ERROR if either string cannot be converted to UTF-8
    @throw I18N-STRING-PREDICATE-ERROR if \a op or an option is invalid
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create or apply the collator

    @par Example:
    @code{.py}
bool tr_match = I18n::string_predicate("Istanbul", "starts-with", "i", "tr-TR");
bool accent_folded = I18n::string_predicate("Resume", "equals", "resume", "en-US", {"strength": "primary"});
    @endcode
*/
bool string_predicate(string value, string op, string needle, string locale) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return i18n_string_predicate_impl(value, op, needle, locale, nullptr, xsink);
}

//! Evaluates a locale-sensitive string predicate using ICU collation options.
/** @param value string to test
    @param op predicate operator: \c "contains", \c "starts-with", \c "ends-with", or \c "equals"
    @param needle string to search for or compare against
    @param locale BCP 47 locale tag, including supported Unicode collation extensions
    @param opts optional hash with collation options:
      - \c strength: \c "primary", \c "secondary", \c "tertiary", \c "quaternary", or \c "identical"
      - \c normalization: bool enabling canonical normalization; defaults to @ref True
      - \c case_level: bool enabling ICU case-level comparison; defaults to @ref False
    @return @ref True if \a value matches the predicate under the locale collator

    @throw I18N-STRING-ERROR if either string cannot be converted to UTF-8
    @throw I18N-STRING-PREDICATE-ERROR if \a op or an option is invalid
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create or apply the collator

    @par Example:
    @code{.py}
bool accent_insensitive = I18n::string_predicate("Resume", "equals", "resume", "en-US",
    {"strength": "primary"});
bool accent_sensitive = I18n::string_predicate("Resume", "equals", "resume", "en-US",
    {"strength": "secondary"});
    @endcode
*/
bool string_predicate(string value, string op, string needle, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return i18n_string_predicate_impl(value, op, needle, locale, opts, xsink);
}

//! Evaluates a locale-sensitive string predicate for every value in a list or buffer.
/** @param values list or buffer of values to test; @ref NOTHING and @ref NULL entries are returned as @ref False
    @param op predicate operator: \c "contains", \c "starts-with", \c "ends-with", or \c "equals"
    @param needle string to search for or compare against
    @param locale BCP 47 locale tag, including supported Unicode collation extensions
    @return a dense \c buffer<bool> mask

    @throw I18N-STRING-PREDICATE-ERROR if \a values, \a op, or an option is invalid
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create or apply the collator

    @par Example:
    @code{.py}
buffer<bool> selected = I18n::string_predicate_mask(names, "contains", "i", "tr-TR");
    @endcode
*/
auto string_predicate_mask(auto values, string op, string needle, string locale) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return i18n_string_predicate_mask_impl(values, op, needle, locale, nullptr, xsink);
}

//! Evaluates a locale-sensitive string predicate for every value in a list or buffer with collation options.
/** @param values list or buffer of values to test; @ref NOTHING and @ref NULL entries are returned as @ref False
    @param op predicate operator: \c "contains", \c "starts-with", \c "ends-with", or \c "equals"
    @param needle string to search for or compare against
    @param locale BCP 47 locale tag, including supported Unicode collation extensions
    @param opts optional hash with the same keys accepted by \ref string_predicate()
    @return a dense \c buffer<bool> mask

    @throw I18N-STRING-PREDICATE-ERROR if \a values, \a op, or an option is invalid
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create or apply the collator

    @par Example:
    @code{.py}
buffer<bool> selected = I18n::string_predicate_mask(names, "equals", "resume", "en-US",
    {"strength": "primary"});
    @endcode
*/
auto string_predicate_mask(auto values, string op, string needle, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return i18n_string_predicate_mask_impl(values, op, needle, locale, opts, xsink);
}

//! Returns an ICU sort key for a string and explicit locale.
/** Sort keys are binary data intended for cache-local ordering only.

    @param value string to convert
    @param locale BCP 47 locale tag, including supported Unicode collation extensions
    @return binary ICU sort key

    @throw I18N-STRING-ERROR if \a value cannot be converted to UTF-8 or the sort key is too large
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create a collator

    @note Sort keys are not stable across ICU/CLDR versions, locales, or collation options. Persistent keys must be
    tagged with the locale, options, backend, ICU/CLDR versions, and collation version.
*/
binary get_sort_key(string value, string locale) [flags=RET_VALUE_ONLY] {
    std::string value_str = i18n_string_arg_to_utf8(value, xsink, "value");
    if (*xsink) {
        return QoreValue();
    }
    std::unique_ptr<icu::Collator> collator = i18n_make_collator(locale, xsink);
    if (*xsink) {
        return QoreValue();
    }

    icu::UnicodeString uvalue = i18n_utf8_to_unicode_string(value_str);
    int32_t len = collator->getSortKey(uvalue, nullptr, 0);
    if (len < 0 || len > 1024 * 1024) {
        xsink->raiseException("I18N-STRING-ERROR", "generated sort key is too large");
        return QoreValue();
    }

    std::vector<uint8_t> data(static_cast<size_t>(len));
    int32_t actual = collator->getSortKey(uvalue, data.data(), len);
    if (actual < 0 || actual > len) {
        xsink->raiseException("I18N-ICU-ERROR", "cannot generate sort key");
        return QoreValue();
    }

    BinaryNode* rv = new BinaryNode;
    rv->append(data.data(), static_cast<size_t>(actual));
    return rv;
}

//! Returns the ICU collation version for an explicit locale.
/** @param locale BCP 47 locale tag
    @return collation version string

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create a collator
*/
string get_collation_version(string locale) [flags=RET_VALUE_ONLY] {
    std::unique_ptr<icu::Collator> collator = i18n_make_collator(locale, xsink);
    if (*xsink) {
        return QoreValue();
    }

    UVersionInfo version;
    collator->getVersion(version);
    return new QoreStringNode(i18n_version_to_string(version), QCS_UTF8);
}

//! Returns the CLDR plural category for a value and locale using cardinal rules.
/** @param value integer, floating-point, number, or base-10 decimal string
    @param locale BCP 47 locale tag, for example \c "en", \c "ru", or \c "ar"
    @return one of \c "zero", \c "one", \c "two", \c "few", \c "many", or \c "other"

    @throw I18N-NUMBER-ERROR if \a value is a malformed decimal string
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create or apply plural rules

    @note String values preserve visible fraction digits, so \c "1", \c "1.0", and \c "1.00" can select different
    categories in locales whose CLDR rules distinguish them.

    @par Example:
    @code{.py}
assertEq("one", I18n::plural_category(1, "en"));
assertEq("few", I18n::plural_category(2, "ru"));
    @endcode
*/
string plural_category(auto value, string locale) [flags=RET_VALUE_ONLY] {
    std::string category = i18n_select_plural_category(value, locale, nullptr, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreStringNode(category, QCS_UTF8);
}

//! Returns the CLDR plural category for a value and locale.
/** @param value integer, floating-point, number, or base-10 decimal string
    @param locale BCP 47 locale tag, for example \c "en", \c "ru", or \c "ar"
    @param opts optional hash; \c "type" may be \c "cardinal" or \c "ordinal"
    @return one of \c "zero", \c "one", \c "two", \c "few", \c "many", or \c "other"

    @throw I18N-NUMBER-ERROR if \a value is a malformed decimal string
    @throw I18N-PLURAL-TYPE-ERROR if \c opts.type is unsupported
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create or apply plural rules

    @par Example:
    @code{.py}
assertEq("one", I18n::plural_category(1, "en", {"type": "ordinal"}));
assertEq("two", I18n::plural_category(2, "en", {"type": "ordinal"}));
    @endcode
*/
string plural_category(auto value, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    std::string category = i18n_select_plural_category(value, locale, opts, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreStringNode(category, QCS_UTF8);
}

//! Selects a caller-supplied plural form using cardinal CLDR rules.
/** @param value integer, floating-point, number, or base-10 decimal string
    @param locale BCP 47 locale tag
    @param forms hash keyed by CLDR plural category, with optional exact-value keys such as \c "=0" or \c "=1"
    @return the selected form string; missing category keys fall back to \c "other"

    @throw I18N-FORMS-ERROR if \a forms is invalid or does not include an \c "other" fallback
    @throw I18N-NUMBER-ERROR if \a value or an exact-value key is malformed
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create or apply plural rules

    @note This function only selects among forms supplied by the caller. A locale string alone cannot localize an
    English two-form word pair into languages with more plural categories.

    @par Example:
    @code{.py}
hash<auto> ru = {"one": "soubor", "few": "soubory", "many": "souboru", "other": "souboru"};
printf("%d %s\n", n, I18n::plural_form(n, "cs", ru));
    @endcode
*/
string plural_form(auto value, string locale, hash<auto> forms) [flags=RET_VALUE_ONLY] {
    return i18n_select_plural_form(value, locale, forms, nullptr, xsink);
}

//! Selects a caller-supplied plural form using CLDR rules.
/** @param value integer, floating-point, number, or base-10 decimal string
    @param locale BCP 47 locale tag
    @param forms hash keyed by CLDR plural category, with optional exact-value keys such as \c "=0" or \c "=1"
    @param opts optional hash; \c "type" may be \c "cardinal" or \c "ordinal"
    @return the selected form string; missing category keys fall back to \c "other"

    @throw I18N-FORMS-ERROR if \a forms is invalid or does not include an \c "other" fallback
    @throw I18N-NUMBER-ERROR if \a value or an exact-value key is malformed
    @throw I18N-PLURAL-TYPE-ERROR if \c opts.type is unsupported
    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-ICU-ERROR if ICU cannot create or apply plural rules

    @note Exact-value keys take precedence over CLDR categories.

    @par Example:
    @code{.py}
hash<auto> en_ordinal = {"one": "st", "two": "nd", "few": "rd", "other": "th"};
printf("2%s\n", I18n::plural_form(2, "en", en_ordinal, {"type": "ordinal"}));
    @endcode
*/
string plural_form(auto value, string locale, hash<auto> forms, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_select_plural_form(value, locale, forms, opts, xsink);
}

//! Converts a string to upper case using the case mappings of a locale.
/** @param str the string to convert
    @param locale locale tag whose case mappings are used (ex: \c "tr" for Turkish)
    @return the string in upper case

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8

    @note Full case mappings are used, so the result can be longer than the input
    (ex: \c "ß" -> \c "SS"); pass the \c simple option for one-to-one mappings

    @par Example:
    @code{.py}
assertEq("İSİM", I18n::to_upper("isim", "tr"));
assertEq("ISIM", I18n::to_upper("isim", "en"));
    @endcode
*/
string to_upper(string str, string locale) [flags=RET_VALUE_ONLY] {
    return i18n_case_convert(str, locale, nullptr, true, xsink);
}

//! Converts a string to upper case using the case mappings of a locale.
/** @param str the string to convert
    @param locale locale tag whose case mappings are used
    @param opts optional hash with a \c simple bool key; when @ref True "True", one-to-one case mappings are
    used, so the result has the same number of characters as the input and a letter with no single-character
    upper-case form is returned unchanged (ex: \c "ß")

    @return the string in upper case

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8
    @throw I18N-CASE-ERROR if an option has an invalid type

    @par Example:
    @code{.py}
assertEq("SS", I18n::to_upper("ß", "de"));
assertEq("ß", I18n::to_upper("ß", "de", {"simple": True}));
    @endcode
*/
string to_upper(string str, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_case_convert(str, locale, opts, true, xsink);
}

//! Converts a string to lower case using the case mappings of a locale.
/** @param str the string to convert
    @param locale locale tag whose case mappings are used
    @return the string in lower case

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8

    @note The Greek final sigma is produced where it belongs, so this is preferred over a manual
    substitution (ex: \c "ΟΔΟΣ" -> \c "οδος" ending in \c "ς")

    @par Example:
    @code{.py}
assertEq("ıletısım", I18n::to_lower("ILETISIM", "tr"));
assertEq("iletisim", I18n::to_lower("ILETISIM", "en"));
    @endcode
*/
string to_lower(string str, string locale) [flags=RET_VALUE_ONLY] {
    return i18n_case_convert(str, locale, nullptr, false, xsink);
}

//! Converts a string to lower case using the case mappings of a locale.
/** @param str the string to convert
    @param locale locale tag whose case mappings are used
    @param opts optional hash with a \c simple bool key, as documented in
    @ref Qore::I18n::to_upper() "to_upper()"

    @return the string in lower case

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8
    @throw I18N-CASE-ERROR if an option has an invalid type

    @par Example:
    @code{.py}
assertEq("οδος", I18n::to_lower("ΟΔΟΣ", "el"));
    @endcode
*/
string to_lower(string str, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_case_convert(str, locale, opts, false, xsink);
}

//! Capitalizes the initial letter of a string using the case mappings of a locale.
/** The remainder of the string is converted to lower case; pass the \c keep_case option to leave it as
    written

    @param str the string to capitalize
    @param locale locale tag whose case mappings are used
    @return the string with its initial letter capitalized

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8

    @note The initial <i>letter</i> is capitalized rather than the initial character, so a string beginning
    with a digit or punctuation capitalizes the first letter that follows (ex: \c "2factor" ->
    \c "2Factor")

    @note Locale-specific rules apply to the initial letter, so a Dutch \c "ij" is capitalized as a digraph
    and a Turkish \c "i" acquires its dot

    @par Example:
    @code{.py}
assertEq("IJsselmeer", I18n::capitalize("ijsselmeer", "nl"));
assertEq("Ijsselmeer", I18n::capitalize("ijsselmeer", "en"));
    @endcode
*/
string capitalize(string str, string locale) [flags=RET_VALUE_ONLY] {
    return i18n_capitalize_impl(str, locale, nullptr, xsink);
}

//! Capitalizes the initial letter of a string using the case mappings of a locale.
/** @param str the string to capitalize
    @param locale locale tag whose case mappings are used
    @param opts optional hash with a \c keep_case bool key; when @ref True "True", the remainder of the
    string is left as written instead of being converted to lower case, so acronyms keep their case
    (ex: \c "URLs", \c "TPS")

    @return the string with its initial letter capitalized

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8
    @throw I18N-CASE-ERROR if an option has an invalid type

    @par Example:
    @code{.py}
assertEq("URLs", I18n::capitalize("URLs", "en", {"keep_case": True}));
assertEq("Urls", I18n::capitalize("URLs", "en"));
    @endcode
*/
string capitalize(string str, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_capitalize_impl(str, locale, opts, xsink);
}

//! Applies Unicode titlecasing to a string, capitalizing the first letter of every word.
/** @param str the string to convert
    @param locale locale tag whose case mappings are used
    @return the string with the first letter of every word capitalized and the rest in lower case

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8

    @note This is the Unicode titlecase operation, <b>not</b> the typographic title case of any language: it
    capitalizes every word, so \c "wait for active shards" becomes \c "Wait For Active Shards" and a French
    \c "numero de commande" becomes \c "Numero De Commande".  Use
    @ref Qore::I18n::to_display_case() "to_display_case()" to apply the capitalization a locale conventionally
    expects of a label or heading; use this function to normalize a name or a shouted string
    (ex: \c "JOHN SMITH" -> \c "John Smith")

    @par Example:
    @code{.py}
assertEq("John Smith", I18n::to_title("JOHN SMITH", "en"));
    @endcode
*/
string to_title(string str, string locale) [flags=RET_VALUE_ONLY] {
    return i18n_to_title_impl(str, locale, nullptr, xsink);
}

//! Applies Unicode titlecasing to a string, capitalizing the first letter of every word.
/** @param str the string to convert
    @param locale locale tag whose case mappings are used
    @param opts optional hash with the following keys:
    - \c no_lowercase: (bool) leave the remainder of each word as written instead of converting it to lower
      case
    - \c no_break_adjustment: (bool) capitalize at each word break rather than at the first cased letter
      after it

    @return the titlecased string

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8
    @throw I18N-CASE-ERROR if an option has an invalid type

    @note This is the Unicode titlecase operation, not the typographic title case of any language; see
    @ref Qore::I18n::to_title() "to_title()"

    @par Example:
    @code{.py}
assertEq("URLs Here", I18n::to_title("URLs here", "en", {"no_lowercase": True}));
    @endcode
*/
string to_title(string str, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_to_title_impl(str, locale, opts, xsink);
}

//! Returns the case-folded form of a string for caseless matching.
/** @param str the string to fold
    @return the case-folded string

    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8

    @note Case folding is locale-independent by definition and therefore takes no locale; the folded form is
    for comparison and as a lookup key, not for display

    @par Example:
    @code{.py}
assertEq(I18n::fold_case("straße"), I18n::fold_case("STRASSE"));
    @endcode
*/
string fold_case(string str) [flags=RET_VALUE_ONLY] {
    return i18n_fold_case_impl(str, nullptr, xsink);
}

//! Returns the case-folded form of a string for caseless matching.
/** @param str the string to fold
    @param opts optional hash with a \c turkic bool key; when @ref True "True", the dotted and dotless I are
    folded as the distinct letters they are in Turkic languages rather than as case variants

    @return the case-folded string

    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8
    @throw I18N-CASE-ERROR if an option has an invalid type

    @par Example:
    @code{.py}
assertNeq(I18n::fold_case("I", {"turkic": True}), I18n::fold_case("i", {"turkic": True}));
    @endcode
*/
string fold_case(string str, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_fold_case_impl(str, opts, xsink);
}

//! Applies the capitalization a locale conventionally expects of a short label or heading.
/** @param str the phrase to convert
    @param locale locale tag whose convention is applied
    @return the phrase capitalized according to the locale's convention

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8

    @note Initial letters are capitalized and the remainder of each word is left as written, so acronyms
    survive; the sole exception is an English function word between the first and last words of the phrase,
    which is converted to lower case because the convention requires it

    @note This function applies a language convention and knows nothing of technical or brand vocabulary; it
    renders \c "api key" as \c "Api key".  A caller with such a vocabulary should render each word itself and
    use @ref Qore::I18n::get_capitalization_style() "get_capitalization_style()" and
    @ref Qore::I18n::get_function_words() "get_function_words()" to drive the convention

    @note The capitalization styles are Qore data rather than CLDR data; CLDR carries capitalization context
    only for its own display names, and that data describes how nouns are capitalized in those names rather
    than how a heading is capitalized

    @par Example:
    @code{.py}
assertEq("Wait for Active Shards", I18n::to_display_case("wait for active shards", "en"));
assertEq("Numero de commande", I18n::to_display_case("numero de commande", "fr"));
    @endcode
*/
string to_display_case(string str, string locale) [flags=RET_VALUE_ONLY] {
    return i18n_display_case_impl(str, locale, nullptr, xsink);
}

//! Applies the capitalization a locale conventionally expects of a short label or heading.
/** @param str the phrase to convert
    @param locale locale tag whose convention is applied
    @param opts optional hash with the following keys:
    - \c style: (string) apply this style instead of the locale's: \c "title" capitalizes every word except a
      function word between the first and last, \c "sentence" capitalizes only the first word, and
      \c "preserve" capitalizes nothing
    - \c function_words: (list of strings) use these function words instead of the built-in list; compared
      case-folded

    @return the phrase capitalized according to the requested convention

    @throw I18N-LOCALE-ERROR if \a locale is invalid
    @throw I18N-STRING-ERROR if \a str cannot be converted to UTF-8
    @throw I18N-CASE-ERROR if an option has an invalid type or \c style has an unknown value

    @par Example:
    @code{.py}
assertEq("Numero de commande", I18n::to_display_case("numero de commande", "en", {"style": "sentence"}));
    @endcode
*/
string to_display_case(string str, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY] {
    return i18n_display_case_impl(str, locale, opts, xsink);
}

//! Returns the capitalization style a locale conventionally applies to a short label or heading.
/** @param locale locale tag
    @return one of \c "title", \c "sentence", or \c "preserve"

    @throw I18N-LOCALE-ERROR if \a locale is invalid

    @note A locale with no entry uses \c "sentence", which is the majority convention.  The root locale uses
    \c "title" for compatibility: @ref Qore::I18n::get_thread_locale() "get_thread_locale()" returns
    \c "root" when no locale is set, and any caller passing that through would otherwise move every existing
    English label to sentence case

    @note These styles are Qore data rather than CLDR data; see
    @ref Qore::I18n::to_display_case() "to_display_case()"

    @par Example:
    @code{.py}
assertEq("title", I18n::get_capitalization_style("en"));
assertEq("sentence", I18n::get_capitalization_style("fr"));
assertEq("preserve", I18n::get_capitalization_style("ja"));
    @endcode
*/
string get_capitalization_style(string locale) [flags=RET_VALUE_ONLY] {
    icu::Locale loc = i18n_make_locale(locale, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreStringNode(i18n_capitalization_style_for(loc), QCS_UTF8);
}

//! Returns the function words a locale leaves in lower case in the middle of a label or heading.
/** @param locale locale tag
    @return the function words for the locale, in lower case; empty for every locale whose style is not
    \c "title", because no other convention lower-cases them

    @throw I18N-LOCALE-ERROR if \a locale is invalid

    @note These words are Qore data rather than CLDR data; see
    @ref Qore::I18n::to_display_case() "to_display_case()"

    @par Example:
    @code{.py}
assertTrue(I18n::get_function_words("en").size() > 0);
assertEq((), I18n::get_function_words("fr"));
    @endcode
*/
list<string> get_function_words(string locale) [flags=RET_VALUE_ONLY] {
    icu::Locale loc = i18n_make_locale(locale, xsink);
    if (*xsink) {
        return QoreValue();
    }
    ReferenceHolder<QoreListNode> rv(new QoreListNode(stringTypeInfo), xsink);
    if (!strcmp(i18n_capitalization_style_for(loc), "title")) {
        for (size_t i = 0, e = sizeof(i18n_en_function_words) / sizeof(i18n_en_function_words[0]); i < e;
            ++i) {
            rv->push(new QoreStringNode(i18n_en_function_words[i], QCS_UTF8), xsink);
            if (*xsink) {
                return QoreValue();
            }
        }
    }
    return rv.release();
}

///@}
