#include "i18n-module.h"

#include "i18n-catalog-dir-index.h"

//! Reusable native catalog discovery for one bounded operation.
/** Discovering the catalog files for one domain and locale probes a small number of candidate paths and scans one
    fragment directory for every search root and locale-fallback entry.  An operation that builds catalogs for many
    domains and locales repeats those reads against the same directories: with 250 domains and 12 locales, one
    search root is read thousands of times even though its contents do not change while the operation runs.

    An index reads each directory at most once and answers every later query for it from that snapshot.  The
    results are identical to @ref Qore::I18n::discover_catalog_files() for the same arguments.

    The index has no invalidation and never refreshes itself: how stale its view of the filesystem can become is
    bounded by the lifetime of the object, which is why the caller owns it.  Create one for an operation, use it
    for that operation, and discard it; call @ref CatalogDiscoveryIndex::clear() to take a new snapshot with the
    same object.  Do not keep one alive as a process-global cache, where catalogs installed or removed after the
    index was created would remain invisible or keep being reported.

    Access control is unaffected: a program can discover exactly the catalog files it can discover without an
    index.  Where a sandbox manager does not permit reading a directory as a whole, that directory is probed path
    by path exactly as it is without an index.

    This class is thread-safe.

    @par Example
    @code{.py}
I18n::CatalogDiscoveryIndex index();
foreach string domain in (domains) {
    foreach string locale in (locales) {
        I18n::MessageCatalog catalog(index.discover(domain, locale, opts));
        ...
    }
}
    @endcode
*/
qclass CatalogDiscoveryIndex [arg=I18nCatalogDirIndex* index; ns=Qore::I18n; flags=final];

//! Creates an empty discovery index.
/** The first query for a directory reads it; every later query for the same directory is answered from the
    snapshot.

    @par Example
    @code{.py}
I18n::CatalogDiscoveryIndex index();
    @endcode
*/
CatalogDiscoveryIndex::constructor() {
    self->setPrivate(CID_CATALOGDISCOVERYINDEX, new I18nCatalogDirIndex);
}

//! CatalogDiscoveryIndex objects cannot be copied.
/** @throw COPY-ERROR always thrown
*/
CatalogDiscoveryIndex::copy() {
    xsink->raiseException("COPY-ERROR", "CatalogDiscoveryIndex objects cannot be copied");
}

//! Discovers native catalog JSON files for a domain and requested locale, reusing directory reads.
/** The return value is identical to @ref Qore::I18n::discover_catalog_files() called with the same arguments; only
    the number of filesystem reads differs.

    @param domain catalog domain
    @param locale requested locale
    @param opts optional hash with \c search_path and \c override_path string or list<string> entries

    @return existing native catalog JSON file paths in load order

    @throw I18N-CATALOG-ERROR if \a domain or \a opts is invalid, or a catalog fragment directory cannot be read
    @throw I18N-LOCALE-ERROR if \a locale is invalid

    @par Example
    @code{.py}
list<string> files = index.discover("billing", "cs-CZ", {"search_path": (catalog_root,)});
    @endcode

    @note Files discovered through an index reflect the filesystem as it was when each directory was first read by
    this index, not as it is now.
*/
list<string> CatalogDiscoveryIndex::discover(string domain, string locale, *hash<auto> opts) [flags=RET_VALUE_ONLY;dom=FILESYSTEM,EXTERNAL_INFO] {
    return i18n_discover_catalog_files_api(domain, locale, opts, index, xsink);
}

//! Returns the number of directories this index has read from disk.
/** The count is reset by @ref CatalogDiscoveryIndex::clear().  It exists so that callers and tests can verify that
    an operation reuses directory reads instead of inferring it from elapsed time.

    @return the number of directories read from disk since the index was created or last cleared

    @par Example
    @code{.py}
int scans = index.getDirectoryScanCount();
    @endcode
*/
int CatalogDiscoveryIndex::getDirectoryScanCount() [flags=RET_VALUE_ONLY] {
    return index->getDirectoryScanCount();
}

//! Returns the number of directories held in the snapshot.
/** @return the number of directories in the snapshot, including directories that do not exist

    @par Example
    @code{.py}
int dirs = index.getDirectoryCount();
    @endcode
*/
int CatalogDiscoveryIndex::getDirectoryCount() [flags=RET_VALUE_ONLY] {
    return index->getDirectoryCount();
}

//! Discards the snapshot so that the next query reads the filesystem again.
/** The directory scan count is reset as well.

    @par Example
    @code{.py}
index.clear();
    @endcode
*/
nothing CatalogDiscoveryIndex::clear() {
    index->clear();
}
