#include "sshutil-module.h"

//! Descriptor-only default server host-key provider preserving filesystem path behavior.
/** This class does not read private keys. It returns ordered descriptors that SSH server modules
    can import using their native SSH library integrations.

    @since sshutil 1.0
*/
qclass FilesystemSshServerHostKeyProvider [arg=FilesystemSshServerHostKeyProviderData* p; ns=Qore::SshUtil;
    vparent=AbstractSshServerHostKeyProvider];

//! Creates the provider.
/** @param key_paths private-key paths to expose as ordered server host-key material descriptors
    @param passphrase_ref optional non-secret passphrase reference for encrypted keys

    @since sshutil 1.0
*/
FilesystemSshServerHostKeyProvider::constructor(list<string> key_paths, *string passphrase_ref) {
    self->setPrivate(CID_FILESYSTEMSSHSERVERHOSTKEYPROVIDER,
        new FilesystemSshServerHostKeyProviderData(key_paths, passphrase_ref, xsink));
}

//! Copying is not supported.
/**
    @throw SSHUTIL-SERVER-HOST-KEY-PROVIDER-COPY-ERROR copying the provider is not supported
*/
FilesystemSshServerHostKeyProvider::copy() {
    xsink->raiseException("SSHUTIL-SERVER-HOST-KEY-PROVIDER-COPY-ERROR",
        "copying FilesystemSshServerHostKeyProvider objects is not supported");
}

//! Returns ordered server host-key material descriptors for a listener.
/**
    @since sshutil 1.0
*/
list<hash<SshPrivateKeyMaterial>> FilesystemSshServerHostKeyProvider::getServerHostKeyMaterial(hash<auto> ctxt) {
    (void)ctxt;
    return p->getServerHostKeyMaterial(xsink);
}
