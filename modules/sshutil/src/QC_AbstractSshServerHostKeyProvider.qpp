#include "sshutil-module.h"

//! Abstract server host-key provider.
/** Subclasses return ordered server host-key material descriptors for listener setup or reload.

    @since sshutil 1.0
*/
qclass AbstractSshServerHostKeyProvider [arg=AbstractSshServerHostKeyProviderData* p; ns=Qore::SshUtil];

//! Returns ordered server host-key material descriptors for a listener.
/**
    @since sshutil 1.0
*/
abstract list<hash<SshPrivateKeyMaterial>> AbstractSshServerHostKeyProvider::getServerHostKeyMaterial(hash<auto> ctxt);
