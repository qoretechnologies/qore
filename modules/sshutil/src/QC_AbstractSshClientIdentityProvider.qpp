#include "sshutil-module.h"

//! Abstract client identity provider.
/** Subclasses return ordered SSH public-key authentication candidates and may return short-lived
    private key material for provider-backed candidates at point of need.

    @since sshutil 1.0
*/
qclass AbstractSshClientIdentityProvider [arg=AbstractSshClientIdentityProviderData* p; ns=Qore::SshUtil];

//! Returns ordered client authentication candidates for the given context.
/**
    @since sshutil 1.0
*/
abstract list<hash<SshClientIdentityCandidate>> AbstractSshClientIdentityProvider::getClientIdentityCandidates(hash<auto> ctxt);

//! Returns short-lived private key material for a candidate at point of need.
/** The default implementation returns @ref nothing.

    @since sshutil 1.0
*/
*hash<SshPrivateKeyMaterial> AbstractSshClientIdentityProvider::getPrivateKeyMaterial(hash<auto> ctxt, hash<SshClientIdentityCandidate> candidate) {
    (void)ctxt;
    (void)candidate;
    return QoreValue();
}
