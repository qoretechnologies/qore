#include "sshutil-module.h"
#include <qore/QoreSandboxManager.h>

//! Thread-safe registry for provider/store objects.
/** Higher-level configuration should store stable registry names; runtime code resolves those names
    to process-local provider/store objects through this registry.

    A registration ends when the @ref Qore::Program "Program" that created the registered object is destroyed: the
    object is deregistered and released while its Program can still run its destructor.

    @since sshutil 1.0
*/
qclass SshUtilRegistry [arg=SshUtilRegistryData* p; ns=Qore::SshUtil];

//! Registers a client identity provider.
/** @throw SSHUTIL-REGISTRY-ERROR the name is invalid or already registered and \c replace is False
    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot change the registry,
        which is process-wide (see @ref sandbox_process_wide_registries)
*/
static SshUtilRegistry::registerClientIdentityProvider(string name, AbstractSshClientIdentityProvider provider,
        bool replace = False) {
    // the registry is process-wide: code that a sandbox governs cannot change it (qore#6744)
    if (qore_check_process_wide_registration("change the SSH client identity provider registry", xsink)) {
        return QoreValue();
    }
    SshUtilRegistry::registerClientIdentityProvider(name->c_str(), provider, replace, xsink);
}

//! Deregisters a client identity provider.
/** @return the previously registered provider or NOTHING
    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot change the registry,
        which is process-wide (see @ref sandbox_process_wide_registries)
*/
static *AbstractSshClientIdentityProvider SshUtilRegistry::deregisterClientIdentityProvider(string name) {
    // the registry is process-wide: code that a sandbox governs cannot change it (qore#6744)
    if (qore_check_process_wide_registration("change the SSH client identity provider registry", xsink)) {
        return QoreValue();
    }
    return SshUtilRegistry::deregisterClientIdentityProvider(name->c_str());
}

//! Returns a client identity provider by registry name.
/** @return the registered provider or NOTHING
    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot get providers from the
        registry, which is process-wide and can hold credentials (see @ref sandbox_process_wide_registries)
*/
static *AbstractSshClientIdentityProvider SshUtilRegistry::getClientIdentityProvider(string name) {
    // the registered objects can hold the credentials of other tenants: code that a sandbox governs cannot get
    // them from the process-wide registry (qore#6744)
    if (qore_check_process_wide_registration("get a provider from the SSH client identity provider registry", xsink)) {
        return QoreValue();
    }
    return SshUtilRegistry::getClientIdentityProvider(name->c_str());
}

//! Returns the registered client identity provider names.
/** @return the registered provider names
    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot list the registry,
        which is process-wide: the names are those of the entries of other code (see
        @ref sandbox_process_wide_registries)
*/
static list<string> SshUtilRegistry::listClientIdentityProviders() {
    // the names are those of the providers of other tenants, which can name them (qore#6846)
    if (qore_check_process_wide_registration("list the SSH client identity provider registry", xsink)) {
        return QoreValue();
    }
    return SshUtilRegistry::listClientIdentityProviders(xsink);
}

