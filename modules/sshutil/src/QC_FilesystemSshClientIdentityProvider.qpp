#include "sshutil-module.h"

//! Descriptor-only default client identity provider for filesystem keys and SSH agent fallback.
/** This class does not read private keys. It returns ordered descriptors that SSH client modules
    can import using their native SSH library integrations.

    @since sshutil 1.0
*/
qclass FilesystemSshClientIdentityProvider [arg=FilesystemSshClientIdentityProviderData* p; ns=Qore::SshUtil;
    vparent=AbstractSshClientIdentityProvider];

//! Creates the provider.
/** @param key_paths private-key paths to expose as ordered filesystem candidates
    @param agent include an SSH agent candidate before file candidates
    @param optional mark returned candidates optional

    @since sshutil 1.0
*/
FilesystemSshClientIdentityProvider::constructor(*list<string> key_paths, bool agent = False, bool optional = False) {
    self->setPrivate(CID_FILESYSTEMSSHCLIENTIDENTITYPROVIDER,
        new FilesystemSshClientIdentityProviderData(key_paths, agent, optional, xsink));
}

//! Copying is not supported.
/**
    @throw SSHUTIL-CLIENT-IDENTITY-PROVIDER-COPY-ERROR copying the provider is not supported
*/
FilesystemSshClientIdentityProvider::copy() {
    xsink->raiseException("SSHUTIL-CLIENT-IDENTITY-PROVIDER-COPY-ERROR",
        "copying FilesystemSshClientIdentityProvider objects is not supported");
}

//! Returns ordered client authentication candidates for the given context.
/**
    @since sshutil 1.0
*/
list<hash<SshClientIdentityCandidate>> FilesystemSshClientIdentityProvider::getClientIdentityCandidates(hash<auto> ctxt) {
    (void)ctxt;
    return p->getClientIdentityCandidates(xsink);
}
