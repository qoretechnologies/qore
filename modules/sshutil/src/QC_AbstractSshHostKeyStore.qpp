#include "sshutil-module.h"

//! Abstract remote host-key trust store.
/** Subclasses verify observed remote server host keys, perform atomic TOFU acceptance, and
    support explicit manual approval operations.

    @since sshutil 1.0
*/
qclass AbstractSshHostKeyStore [arg=AbstractSshHostKeyStoreData* p; ns=Qore::SshUtil];

//! Verifies an observed remote server host key.
/**
    @since sshutil 1.0
*/
abstract hash<SshHostKeyDecisionInfo> AbstractSshHostKeyStore::verifyHostKey(hash<auto> ctxt, hash<auto> observed_key);

//! Atomically accepts an observed remote server host key only if no record exists.
/**
    @since sshutil 1.0
*/
abstract hash<SshHostKeyDecisionInfo> AbstractSshHostKeyStore::acceptHostKeyIfAbsent(hash<auto> ctxt, hash<auto> observed_key);

//! Explicit manual approval operation with compare-and-set semantics.
/**
    @since sshutil 1.0
*/
abstract hash<SshHostKeyDecisionInfo> AbstractSshHostKeyStore::approveHostKey(hash<auto> ctxt, hash<auto> expected_observed_key, hash<auto> record);
