#include "qore/Qore.h"

//! DataFrame shape information
/** @par Example:
    @code{.py}
hash<DataFrame::DataFrameShape> shape = df.shape();
printf("rows=%d cols=%d\n", shape.rows, shape.cols);
    @endcode

    @since dataframe 1.0
*/
hashdecl Qore::DataFrame::DataFrameShape {
    //! Number of rows
    int rows;
    //! Number of columns
    int cols;
}

//! Per-column descriptive statistics
/** Returned by @ref DataFrame::describe()

    @par Example:
    @code{.py}
list<hash<DataFrame::ColumnStats>> stats = df.describe();
foreach hash<DataFrame::ColumnStats> stat in (stats) {
    printf("%s: count=%d nulls=%d\n", stat.name, stat.count, stat.null_count);
}
    @endcode
*/
hashdecl Qore::DataFrame::ColumnStats {
    //! Column name
    string name;
    //! Column data type
    string dtype;
    //! Count of non-null values
    int count;
    //! Count of null values
    int null_count;
    //! Mean (numeric columns only)
    *float mean;
    //! Standard deviation (numeric columns only)
    *float std;
    //! Minimum value (numeric columns only)
    *float min;
    //! 25th percentile (numeric columns only)
    *float q25;
    //! Median / 50th percentile (numeric columns only)
    *float q50;
    //! 75th percentile (numeric columns only)
    *float q75;
    //! Maximum value (numeric columns only)
    *float max;
    //! Count of unique non-null values (string columns only)
    *int unique_count;
}

//! CSV read/write options
/** @par Example:
    @code{.py}
hash<DataFrame::CsvOptions> options = {
    "separator": "\t",
    "header": True,
};
DataFrame::DataFrame df = DataFrame::DataFrame::readCSV("input.tsv", options);
    @endcode

    @since dataframe 1.0
*/
hashdecl Qore::DataFrame::CsvOptions {
    //! Field separator (default ",")
    *string separator;
    //! Quote character (default '"')
    *string quote_char;
    //! Whether the first row is a header (default True)
    *bool header;
    //! String representing null/missing values (also recognizes "NA", "NULL", "None")
    *string null_string;
    //! Number of rows to skip before the header
    *int skip_rows;
    //! Maximum number of data rows to read
    *int max_rows;
}

//! Parquet read options
/** @par Example:
    @code{.py}
hash<DataFrame::ParquetReadOptions> options = {
    "columns": ("order_id", "customer_name", "total"),
    "filters": ({
        "column": "status",
        "op": "==",
        "value": "complete",
    }, {
        "column": "total",
        "op": ">=",
        "value": 1000.0,
    }),
    "use_threads": True,
};
DataFrame::DataFrame df = DataFrame::DataFrame::readParquet("orders.parquet", options);
    @endcode

    @since dataframe 1.0
*/
hashdecl Qore::DataFrame::ParquetReadOptions {
    //! Top-level column names to read; omitted means all columns
    *list<string> columns;
    //! Parquet row group numbers to read; omitted means all row groups
    *list<int> row_groups;
    //! Number of records read per Arrow batch; omitted uses Arrow defaults
    *int batch_size;
    //! Whether Arrow may use worker threads while reading multiple columns
    *bool use_threads;
    //! ANDed filter hashes with keys "column", "op", and optional "value"; safe forms prune Parquet row groups with statistics, and all forms are applied exactly after the read
    *list<hash<auto>> filters;
    //! Whether Parquet row-group statistics may be used to prune filters (default True)
    *bool use_statistics;
}

//! Parquet write options
/** @par Example:
    @code{.py}
hash<DataFrame::ParquetWriteOptions> options = {
    "compression": "zstd",
    "row_group_size": 100000,
    "use_dictionary": True,
};
df.writeParquet("orders.parquet", options);
    @endcode

    @since dataframe 1.0
*/
hashdecl Qore::DataFrame::ParquetWriteOptions {
    //! Compression codec: "none", "snappy", "gzip", "brotli", "zstd", "lz4", or "lz4_frame"
    *string compression;
    //! Maximum rows per Parquet row group
    *int row_group_size;
    //! Whether dictionary encoding is enabled globally
    *bool use_dictionary;
    //! Whether column statistics are written
    *bool write_statistics;
    //! Whether Arrow may use worker threads while writing columns
    *bool use_threads;
    //! Whether to store serialized Arrow schema metadata in the Parquet file
    *bool store_schema;
}
