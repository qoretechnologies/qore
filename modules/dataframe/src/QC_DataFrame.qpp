using namespace QoreDataFrameNS;

namespace {

static std::string qdfBuildInsertSql(const std::string& table_name,
        const std::vector<Column>& columns) {
    std::ostringstream sql;
    sql << "INSERT INTO " << table_name << " (";
    for (size_t c = 0; c < columns.size(); ++c) {
        if (c) {
            sql << ", ";
        }
        sql << columns[c].name;
    }
    sql << ") VALUES (";
    for (size_t c = 0; c < columns.size(); ++c) {
        if (c) {
            sql << ", ";
        }
        sql << "%v";
    }
    sql << ")";
    return sql.str();
}

static bool qdfHasMethod(const QoreObject* obj, const char* name) {
    const QoreClass* cls = obj->getClass();
    return cls && cls->findMethod(name);
}

static QoreObject* qdfGetSqlStatement(QoreObject* ds, ValueHolder& stmt_val,
        ExceptionSink* xsink) {
    if (!qdfHasMethod(ds, "getSQLStatement")) {
        return nullptr;
    }

    stmt_val = ds->evalMethod("getSQLStatement", nullptr, xsink);
    if (*xsink) {
        return nullptr;
    }

    QoreObject* stmt = stmt_val->get<QoreObject>();
    if (!stmt) {
        xsink->raiseException("DATAFRAME-DB-ERROR",
            "getSQLStatement() returned type '%s'; expected an SQLStatement object",
            stmt_val->getTypeName());
        return nullptr;
    }
    return stmt;
}

static int qdfPrepareStatement(QoreObject* stmt, const std::string& sql,
        ExceptionSink* xsink) {
    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), xsink);
    args->push(new QoreStringNode(sql), xsink);
    if (*xsink) {
        return -1;
    }

    ValueHolder rv(stmt->evalMethod("prepare", *args, xsink), xsink);
    return *xsink ? -1 : 0;
}

static int qdfExecStatementArgs(QoreObject* stmt, QoreListNode* bind_args,
        ExceptionSink* xsink) {
    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), xsink);
    args->push(bind_args, xsink);
    if (*xsink) {
        return -1;
    }

    ValueHolder rv(stmt->evalMethod("execArgs", *args, xsink), xsink);
    return *xsink ? -1 : 0;
}

static QoreListNode* qdfBuildRowArgs(const std::vector<Column>& columns,
        int64_t row, ExceptionSink* xsink) {
    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), xsink);
    int64_t n = 0;
    for (const Column& col : columns) {
        if (n && !(n % 100) && qore_check_cancel(xsink, "building DataFrame row bind arguments")) {
            return nullptr;
        }
        args->push(col.data->getValueAt(row, xsink), xsink);
        if (*xsink) {
            return nullptr;
        }
        ++n;
    }
    return args.release();
}

static QoreHashNode* qdfBuildColumnHashRange(const std::vector<Column>& columns,
        int64_t start, int64_t count, ExceptionSink* xsink) {
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);

    int64_t n = 0;
    for (const Column& col : columns) {
        if (n && !(n % 100) && qore_check_cancel(xsink, "building DataFrame column batch")) {
            return nullptr;
        }
        ReferenceHolder<QoreListNode> values(
            columnToQoreListRange(*col.data, start, count, xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        h->setKeyValue(col.name.c_str(), values.release(), xsink);
        if (*xsink) {
            return nullptr;
        }
        ++n;
    }

    return h.release();
}

static const char* qdfColumnQoreType(ColumnType type) {
    switch (type) {
        case ColumnType::FLOAT64:
            return "float";
        case ColumnType::INT64:
            return "integer";
        case ColumnType::BOOL:
            return "bool";
        case ColumnType::DATE:
            return "date";
        case ColumnType::STRING:
        case ColumnType::AUTO:
        default:
            return "string";
    }
}

static QoreHashNode* qdfBuildTableDescription(const std::vector<Column>& columns,
        ExceptionSink* xsink) {
    ReferenceHolder<QoreHashNode> desc(new QoreHashNode(autoTypeInfo), xsink);
    ReferenceHolder<QoreHashNode> cols(new QoreHashNode(autoTypeInfo), xsink);

    int64_t n = 0;
    for (const Column& col : columns) {
        if (n && !(n % 100) && qore_check_cancel(xsink, "building DataFrame table description")) {
            return nullptr;
        }
        ReferenceHolder<QoreHashNode> cdesc(new QoreHashNode(autoTypeInfo), xsink);
        cdesc->setKeyValue("qore_type", new QoreStringNode(qdfColumnQoreType(col.data->type)), xsink);
        if (*xsink) {
            return nullptr;
        }
        cols->setKeyValue(col.name.c_str(), cdesc.release(), xsink);
        if (*xsink) {
            return nullptr;
        }
        ++n;
    }

    desc->setKeyValue("columns", cols.release(), xsink);
    if (*xsink) {
        return nullptr;
    }
    return desc.release();
}

static int qdfLoadModule(QoreProgram* pgm, const char* module, ExceptionSink* xsink) {
    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), xsink);
    args->push(new QoreStringNode(module), xsink);
    if (*xsink) {
        return -1;
    }

    ValueHolder rv(pgm->callFunction("load_module", *args, xsink), xsink);
    return *xsink ? -1 : 0;
}

static int qdfCallObjectMethod(QoreObject* obj, const char* method,
        QoreValue arg, ExceptionSink* xsink) {
    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), xsink);
    args->push(arg, xsink);
    if (*xsink) {
        return -1;
    }

    ValueHolder rv(obj->evalMethod(method, *args, xsink), xsink);
    return *xsink ? -1 : 0;
}

static int qdfCallObjectMethod(QoreObject* obj, const char* method,
        ExceptionSink* xsink) {
    ValueHolder rv(obj->evalMethod(method, nullptr, xsink), xsink);
    return *xsink ? -1 : 0;
}

static int qdfCallObjectBoolMethod(QoreObject* obj, const char* method,
        bool& result, ExceptionSink* xsink) {
    ValueHolder rv(obj->evalMethod(method, nullptr, xsink), xsink);
    if (*xsink) {
        return -1;
    }
    result = rv->getAsBool();
    return 0;
}

static int qdfTryGenericBulkInsert(QoreProgram* pgm, QoreObject* ds,
        const std::string& table_name, const QoreHashNode* options,
        const std::vector<Column>& columns, int64_t n_rows, int64_t block_size,
        ExceptionSink* xsink) {
    // SqlUtil delegates SQL generation and array-bind handling to the
    // driver-specific AbstractTable implementation, and emulates bulk DML when
    // a driver does not support native array binding.
    ExceptionSink load_xsink;
    if (qdfLoadModule(pgm, "SqlUtil", &load_xsink)) {
        return 1;
    }

    const QoreClass* table_cls = pgm->findClass("SqlUtil::Table", xsink);
    if (*xsink) {
        return -1;
    }
    if (!table_cls) {
        xsink->raiseException("DATAFRAME-DB-ERROR",
            "SqlUtil was loaded, but SqlUtil::Table is not available");
        return -1;
    }

    ReferenceHolder<QoreListNode> table_args(new QoreListNode(autoTypeInfo), xsink);
    table_args->push(ds->refSelf(), xsink);
    if (options) {
        QoreValue table_description = options->getKeyValue("table_description");
        if (!table_description.isNullOrNothing()) {
            if (table_description.getType() != NT_HASH) {
                xsink->raiseException("DATAFRAME-DB-ERROR",
                    "DataFrame::toTable() option 'table_description' has type '%s'; expected 'hash'",
                    table_description.getTypeName());
                return -1;
            }
            table_args->push(table_description.refSelf(), xsink);
        } else {
            table_args->push(qdfBuildTableDescription(columns, xsink), xsink);
        }
    } else {
        table_args->push(qdfBuildTableDescription(columns, xsink), xsink);
    }
    table_args->push(new QoreStringNode(table_name), xsink);
    if (options) {
        QoreValue table_options = options->getKeyValue("table_options");
        if (!table_options.isNullOrNothing()) {
            table_args->push(table_options.refSelf(), xsink);
        }
    }
    if (*xsink) {
        return -1;
    }

    ReferenceHolder<QoreObject> table(table_cls->execConstructor(*table_args, xsink), xsink);
    if (*xsink) {
        return -1;
    }

    bool exists = false;
    if (qdfCallObjectBoolMethod(*table, "checkExistence", exists, xsink)) {
        xsink->clear();
        return 1;
    }
    if (!exists) {
        return 1;
    }

    bool inserted_any = false;
    for (int64_t start = 0; start < n_rows; start += block_size) {
        if (qore_check_cancel(xsink, "writing DataFrame to table")) {
            return -1;
        }

        int64_t count = std::min(block_size, n_rows - start);
        ReferenceHolder<QoreHashNode> data(qdfBuildColumnHashRange(columns, start, count, xsink), xsink);
        if (*xsink) {
            return -1;
        }
        if (qdfCallObjectMethod(*table, "bulkInsert", data.release(), xsink)) {
            if (!inserted_any) {
                xsink->clear();
                return 1;
            }
            return -1;
        }
        inserted_any = true;
    }

    return 0;
}

static int qdfPreparedRowInsert(QoreObject* ds, const std::string& sql,
        const std::vector<Column>& columns, int64_t n_rows, ExceptionSink* xsink) {
    ValueHolder stmt_val(xsink);
    QoreObject* stmt = qdfGetSqlStatement(ds, stmt_val, xsink);
    if (*xsink) {
        return -1;
    }
    if (!stmt) {
        return 1;
    }

    if (qdfPrepareStatement(stmt, sql, xsink)) {
        return -1;
    }

    for (int64_t r = 0; r < n_rows; ++r) {
        if ((r % 100) == 0 && r > 0
                && qore_check_cancel(xsink, "writing DataFrame to table")) {
            return -1;
        }

        ReferenceHolder<QoreListNode> bind_args(qdfBuildRowArgs(columns, r, xsink), xsink);
        if (*xsink) {
            return -1;
        }
        if (qdfExecStatementArgs(stmt, bind_args.release(), xsink)) {
            return -1;
        }
    }

    return 0;
}

static int qdfExecRowInsert(QoreObject* ds, const std::string& sql,
        const std::vector<Column>& columns, int64_t n_rows, ExceptionSink* xsink) {
    for (int64_t r = 0; r < n_rows; ++r) {
        if ((r % 100) == 0 && r > 0
                && qore_check_cancel(xsink, "writing DataFrame to table")) {
            return -1;
        }

        ReferenceHolder<QoreListNode> call_args(qdfBuildRowArgs(columns, r, xsink), xsink);
        if (*xsink) {
            return -1;
        }
        call_args->insert(new QoreStringNode(sql), xsink);
        if (*xsink) {
            return -1;
        }

        ValueHolder result(ds->evalMethod("exec", *call_args, xsink), xsink);
        if (*xsink) {
            return -1;
        }
    }

    return 0;
}

} // namespace

//! Columnar DataFrame for typed, SQL-like data manipulation
/** Provides a column-oriented data structure with typed columns (float64, int64,
    string, bool, date), null/missing value support, and SQL-like operations.

    @par Example:
    @code{.py}
    %requires dataframe

    # Construct from records
    DataFrame df(
        ({"name": "Alice", "age": 30, "score": 95.5},
         {"name": "Bob",   "age": 25, "score": 88.0},
         {"name": "Carol", "age": 35, "score": 92.0}));

    hash<DataFrameShape> shape = df.shape();
    printf("Shape: %y\n", shape);
    printf("Columns: %y\n", df.columnNames());
    printf("Ages: %y\n", df["age"]);
    printf("First row: %y\n", df[0]);
    printf("First two rows: %s\n", df[0..1].toString());
    printf("%s\n", df.toString());
    @endcode

    @since dataframe 1.0
*/
qclass DataFrame [arg=QoreDataFrame* df; ns=Qore::DataFrame; flags=final];

//! Creates an empty DataFrame
/** Creates a DataFrame with no rows and no columns.
*/
DataFrame::constructor() {
    self->setPrivate(CID_DATAFRAME, new QoreDataFrame());
}

//! Creates a DataFrame from a list of record hashes
/** @param records a list of hashes where each hash is a row; column names
    and types are inferred from the data

    @throw DATAFRAME-ERROR if records contain non-hash elements or are inconsistent
*/
DataFrame::constructor(list<auto> records) {
    QoreDataFrame* dataframe = QoreDataFrame::fromRecords(records, xsink);
    if (!dataframe) {
        return;
    }
    self->setPrivate(CID_DATAFRAME, dataframe);
}

//! Creates a DataFrame from a hash of column lists
/** @param columns a hash where keys are column names and values are lists
    of column values; all lists must have the same length

    @throw DATAFRAME-ERROR if column lengths are inconsistent
*/
DataFrame::constructor(hash<auto> columns) {
    QoreDataFrame* dataframe = QoreDataFrame::fromColumns(columns, xsink);
    if (!dataframe) {
        return;
    }
    self->setPrivate(CID_DATAFRAME, dataframe);
}

//! DataFrames cannot be copied
/** @throw COPY-ERROR always thrown
*/
DataFrame::copy() {
    xsink->raiseException("COPY-ERROR", "DataFrame objects cannot be copied");
}

//! Returns the number of rows
/** @return the row count
*/
int DataFrame::numRows() [flags=CONSTANT] {
    return df->numRows();
}

//! Returns the number of columns
/** @return the column count
*/
int DataFrame::numCols() [flags=CONSTANT] {
    return df->numCols();
}

//! Returns the list of column names
/** @return list of column name strings
*/
list<string> DataFrame::columnNames() [flags=CONSTANT] {
    return df->columnNames(xsink);
}

//! Returns the list of column type names
/** @return list of type name strings (e.g. "float64", "int64", "string")
*/
list<string> DataFrame::dtypes() [flags=CONSTANT] {
    return df->dtypes(xsink);
}

//! Returns the shape as a hash with "rows" and "cols" keys
/** @return hash with "rows" and "cols" integer values
*/
hash<DataFrameShape> DataFrame::shape() [flags=CONSTANT] {
    return df->shape(xsink);
}

//! Returns a column's values as a list
/** @param name the column name
    @throw DATAFRAME-COLUMN-ERROR if column not found
*/
list<auto> DataFrame::getColumn(string name) [flags=RET_VALUE_ONLY] {
    return df->getColumn(name->c_str(), xsink);
}

//! Returns a column's values as a dense buffer
/** Numeric and boolean columns are returned as \c buffer<T> values. When the
    DataFrame was constructed from a buffer-backed column, the returned value
    shares the same dense storage under Qore's normal copy-on-write rules.

    @param name the column name
    @return a dense buffer containing the column values

    @par Example:
    @code{.py}
    DataFrame df({"id": new buffer<int64>((1001, 1002, 1003))});
    buffer<int64> ids = df.getColumnBuffer("id");
    @endcode

    @throw DATAFRAME-COLUMN-ERROR if the column is not found or cannot be
    represented as a dense buffer
*/
auto DataFrame::getColumnBuffer(string name) [flags=RET_VALUE_ONLY] {
    return df->getColumnBuffer(name->c_str(), xsink);
}

//! Returns a row as a hash
/** @param index the zero-based row index
    @throw DATAFRAME-INDEX-ERROR if index out of range
*/
hash<auto> DataFrame::getRow(int index) [flags=RET_VALUE_ONLY] {
    return df->getRow(index, xsink);
}

//! Returns a lazy column reference for building row-mask predicates
/** @param name the column name
    @return a ColumnRef that can be compared with scalar values to produce a RowMask

    @par Example:
    @code{.py}
    RowMask adults = df.column("age") >= 18;
    DataFrame adult_rows = df[adults];
    @endcode

    @throw DATAFRAME-COLUMN-ERROR if the column does not exist when the predicate is evaluated
*/
ColumnRef DataFrame::column(string name) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* referenced_df = static_cast<QoreDataFrame*>(self->getReferencedPrivateData(CID_DATAFRAME, xsink));
    if (!referenced_df) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_COLUMNREF, getProgram()), xsink);
    obj->setPrivate(CID_COLUMNREF, new QoreDataFrameColumnRef(referenced_df, name->c_str()));
    return obj.release();
}

//! Returns the first n rows as a new DataFrame (default 5)
/** @param n number of rows (default 5)
    @return new DataFrame object with the first n rows

    @par Example:
    @code{.py}
    DataFrame top3 = df.head(3);
    printf("Top 3: %d rows\n", top3.numRows());
    @endcode
*/
DataFrame DataFrame::head(*int n) [flags=RET_VALUE_ONLY] {
    int64_t rows = n ? (int64_t)n : 5;
    QoreDataFrame* result = df->head(rows, xsink);
    if (!result) {
        return QoreValue();
    }
    // Wrap in a new Qore DataFrame object
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns the last n rows as a new DataFrame (default 5)
/** @param n number of rows (default 5)
    @return new DataFrame object with the last n rows
*/
DataFrame DataFrame::tail(*int n) [flags=RET_VALUE_ONLY] {
    int64_t rows = n ? (int64_t)n : 5;
    QoreDataFrame* result = df->tail(rows, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns a row slice [start, end) as a new DataFrame
/** @param start the starting row index (inclusive)
    @param end the ending row index (exclusive)
    @return new DataFrame object with the specified row range
*/
DataFrame DataFrame::slice(int start, int end) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = df->slice(start, end, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Extracts numeric columns as a matrix for ML algorithms
/** @param columns optional list of column names (default: all numeric columns)
    @return list of row lists (list<list<float>>); null values become NaN

    The output format is compatible with ML module's fitMatrix() method.

    @par Example:
    @code{.py}
    list<auto> matrix = df.toMatrix(("feature1", "feature2"));
    model.fitMatrix(matrix, df.toVector("target"));
    @endcode

    @throw DATAFRAME-ERROR if a specified column is not numeric
*/
list<auto> DataFrame::toMatrix(*list<string> columns) [flags=RET_VALUE_ONLY] {
    return df->toMatrix(columns, xsink);
}

//! Extracts a single numeric column as a flat list for ML algorithms
/** @param column the column name
    @return list of float values; null values become NaN

    @par Example:
    @code{.py}
    list<auto> target = df.toVector("price");
    @endcode

    @throw DATAFRAME-ERROR if the column is not numeric
*/
list<auto> DataFrame::toVector(string column) [flags=RET_VALUE_ONLY] {
    return df->toVector(column->c_str(), xsink);
}

//! Creates a DataFrame from a numeric matrix and column names
/** @param matrix list of row lists (list<list<float>>)
    @param column_names optional list of column names

    @return new DataFrame with float64 columns

    @par Example:
    @code{.py}
    DataFrame df = DataFrame::fromMatrix(
        ((1.0, 2.0), (3.0, 4.0)), ("x", "y"));
    @endcode
*/
static DataFrame DataFrame::fromMatrix(list<auto> matrix, *list<string> column_names) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = QoreDataFrame::fromMatrix(matrix, column_names, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Joins this DataFrame with another on shared key columns
/** @param other the right-side DataFrame
    @param on list of column names to join on (must exist in both DataFrames)
    @param how join type: "inner" (default), "left", "right", "outer", "cross"

    For non-key columns with the same name in both DataFrames, the right-side
    column is suffixed with "_right".

    @return new DataFrame object with joined rows

    @par Example:
    @code{.py}
    DataFrame orders(
        ({"order_id": 1, "customer_id": 10, "amount": 99.0},
         {"order_id": 2, "customer_id": 20, "amount": 50.0}));
    DataFrame customers(
        ({"customer_id": 10, "name": "Alice"},
         {"customer_id": 20, "name": "Bob"}));

    DataFrame joined = orders.join(customers, ("customer_id",));
    # Result: order_id, customer_id, amount, name
    @endcode

    @throw DATAFRAME-JOIN-ERROR if join type is invalid or key columns not found

*/
DataFrame DataFrame::join(DataFrame[QoreDataFrame] other, list<string> on, *string how) [flags=RET_VALUE_ONLY] {
    std::string how_str = how ? how->c_str() : "inner";
    QoreDataFrame* result = df->join(*other, on, how_str, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Groups the DataFrame by the specified columns for aggregation
/** @param columns list of column names to group by
    @return a GroupedDataFrame object for calling agg(), count(), sum(), mean()

    @par Example:
    @code{.py}
    GroupedDataFrame gdf = df.groupBy(("dept",));
    DataFrame means = gdf.agg({"salary": "mean"});
    DataFrame counts = gdf.count();
    @endcode

    @throw DATAFRAME-COLUMN-ERROR if a column name is not found

*/
GroupedDataFrame DataFrame::groupBy(list<string> columns) [flags=RET_VALUE_ONLY] {
    // Convert column name list to std::vector
    std::vector<std::string> col_names;
    for (size_t i = 0; i < columns->size(); ++i) {
        QoreValue v = columns->retrieveEntry(i);
        if (v.getType() == NT_STRING) {
            QoreStringValueHelper s(v);
            col_names.push_back(s->c_str());
        }
    }
    QoreGroupedDataFrame* gdf_result = new QoreGroupedDataFrame(df, col_names, xsink);
    if (*xsink) {
        delete gdf_result;
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(
        new QoreObject(QC_GROUPEDDATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_GROUPEDDATAFRAME, gdf_result);
    return obj.release();
}

//! Returns a new DataFrame with only the specified columns
/** @param columns list of column names to select
    @return new DataFrame object with the selected columns

    @par Example:
    @code{.py}
    DataFrame nums = df.select(("age", "score"));
    @endcode

    @throw DATAFRAME-COLUMN-ERROR if a column name is not found

*/
DataFrame DataFrame::select(list<string> columns) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = df->select(columns, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns a new DataFrame with rows matching the condition
/** @param column the column name to filter on
    @param op the comparison operator: "==", "!=", "<", "<=", ">", ">=",
    "contains", "startswith", "endswith", "is_null", "not_null"
    @param value the value to compare against

    @return new DataFrame object with matching rows

    @par Example:
    @code{.py}
    DataFrame adults = df.filter("age", ">=", 18);
    DataFrame bobs = df.filter("name", "==", "Bob");
    DataFrame has_score = df.filter("score", "not_null", 0);
    @endcode

    @throw DATAFRAME-COLUMN-ERROR if column not found

*/
DataFrame DataFrame::filter(string column, string op, auto value) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = df->filter(column->c_str(), op->c_str(), value, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns a new DataFrame with rows selected by a RowMask
/** @param mask a row mask produced by comparing a ColumnRef with a scalar value
    @return new DataFrame object with rows selected by the mask

    @par Example:
    @code{.py}
    RowMask current = df.column("status") == "active";
    DataFrame active = df.filter(current);
    @endcode

    @throw DATAFRAME-FILTER-ERROR if the mask length does not match the DataFrame row count
*/
DataFrame DataFrame::filter(RowMask[QoreDataFrameRowMask] mask) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = df->filterMask(mask->getMask(), xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns a new DataFrame sorted by the specified columns
/** @param columns list of column names to sort by
    @param ascending optional list of booleans (True = ascending, default True)

    @return new DataFrame object with sorted rows

    @par Example:
    @code{.py}
    DataFrame sorted = df.sortBy(("age",));
    DataFrame desc = df.sortBy(("score",), (False,));
    DataFrame multi = df.sortBy(("dept", "salary"), (True, False));
    @endcode

    @throw DATAFRAME-COLUMN-ERROR if column not found

*/
DataFrame DataFrame::sortBy(list<string> columns, *list<auto> ascending) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = df->sortBy(columns, ascending, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Concatenates DataFrames vertically or horizontally
/** @param dataframes list of DataFrame objects to concatenate
    @param axis 0 for vertical row stacking, 1 for horizontal column concat

    @return a new DataFrame

    Horizontal concat requires all inputs to have the same row count and rejects
    duplicate column names.

    @par Example:
    @code{.py}
    DataFrame left({"id": (1, 2)});
    DataFrame right({"score": (10.0, 20.0)});
    DataFrame combined = DataFrame::concat((left, right), axis: 1);
    @endcode
*/
static DataFrame DataFrame::concat(list<DataFrame> dataframes, *int axis) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    QoreDataFrame* result = QoreDataFrame::concat(dataframes, axis ? static_cast<int>(axis) : 0, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns a new DataFrame with null values replaced by the given value
/** @param value the replacement value (converted to each column's type)
    @return new DataFrame object with nulls filled

    @par Example:
    @code{.py}
    DataFrame filled = df.fillna(0);
    @endcode

*/
DataFrame DataFrame::fillna(auto value) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = df->fillna(value, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns a new DataFrame with rows containing any null values removed
/** @return new DataFrame object with no null values

    @par Example:
    @code{.py}
    DataFrame clean = df.dropna();
    @endcode

*/
DataFrame DataFrame::dropna() [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = df->dropna(xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns counts of distinct values in one column
/** @param column the column to count
    @param dropna if True (the default), null values are excluded
    @param sort_desc if True, sort rows by count descending; otherwise values
           are returned in first-seen order for maximum throughput
    @param count_name optional name of the count column; defaults to \c count
    @return new DataFrame with the value column and count column

    @par Example:
    @code{.py}
    DataFrame counts = orders.valueCounts("status", sort_desc: True);
    printf("%s\n", counts.toString());
    @endcode

    @throw DATAFRAME-COLUMN-ERROR if the column is not found
*/
DataFrame DataFrame::valueCounts(string column, bool dropna = True, bool sort_desc = False,
        string count_name = "count") [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    QoreDataFrame* result = df->valueCounts(column->c_str(), dropna, sort_desc, count_name->c_str(), xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns the number of distinct values in one column
/** @param column the column to inspect
    @param dropna if True (the default), null values are excluded
    @return unique value count

    @par Example:
    @code{.py}
    int customer_segments = customers.nunique("segment");
    @endcode

    @throw DATAFRAME-COLUMN-ERROR if the column is not found
*/
int DataFrame::nunique(string column, bool dropna = True) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return df->nunique(column->c_str(), dropna, xsink);
}

//! Converts the DataFrame to a list of record hashes
/** @return list<hash<auto>> where each element is one row
*/
list<hash<auto>> DataFrame::toRecords() [flags=RET_VALUE_ONLY] {
    return df->toRecords(xsink);
}

//! Converts the DataFrame to a hash of column lists
/** @return hash<auto> where keys are column names, values are lists
*/
hash<auto> DataFrame::toColumnHash() [flags=RET_VALUE_ONLY] {
    return df->toColumnHash(xsink);
}

//! Converts the DataFrame to a SQL ColumnarResult
/** Dense numeric, boolean, and string columns are returned as \c buffer<T> values.
    Existing buffer-backed DataFrame columns are passed through without copying
    under Qore's normal copy-on-write semantics.

    @return a \c Qore::SQL::ColumnarResult object

    @par Example:
    @code{.py}
    ColumnarResult result = df.toColumnarResult();
    buffer<int64> ids = result.getColumn("id");
    @endcode
*/
auto DataFrame::toColumnarResult() [flags=RET_VALUE_ONLY] {
    return qore_columnar_result_to_object(df->toColumnarResult(xsink), xsink);
}

//! Creates a DataFrame from a SQL ColumnarResult
/** This method preserves dense \c buffer<T> columns stored in native
    ColumnarResult objects, so SQL-to-DataFrame flows can avoid materializing
    primitive and string columns as lists. ColumnarResult-compatible objects are still
    accepted through their \c toColumnHash() method.

    @param result a \c Qore::SQL::ColumnarResult object
    @return a new DataFrame

    @par Example:
    @code{.py}
    ColumnarResult result = ds.selectColumnar("select id, total from orders");
    DataFrame df = DataFrame::fromColumnarResult(result);
    @endcode
*/
static DataFrame DataFrame::fromColumnarResult(auto result) [flags=RET_VALUE_ONLY] {
    if (result.getType() != NT_OBJECT) {
        xsink->raiseException("DATAFRAME-ERROR",
            "DataFrame::fromColumnarResult() expects a ColumnarResult-compatible object, got '%s'",
            result.getTypeName());
        return QoreValue();
    }

    QoreObject* result_obj = result.get<QoreObject>();
    ReferenceHolder<QoreColumnarResult> result_data(qore_columnar_result_try_from_object(result_obj, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    QoreDataFrame* dataframe = nullptr;
    if (result_data) {
        dataframe = QoreDataFrame::fromColumnarResult(*result_data, xsink);
    } else {
        if (!qdfHasMethod(result_obj, "toColumnHash")) {
            xsink->raiseException("DATAFRAME-ERROR",
                "DataFrame::fromColumnarResult() expects a ColumnarResult-compatible object, got class '%s'",
                result_obj->getClassName());
            return QoreValue();
        }

        ValueHolder columns(result_obj->evalMethod("toColumnHash", nullptr, xsink), xsink);
        if (*xsink) {
            return QoreValue();
        }
        if (columns->getType() != NT_HASH) {
            xsink->raiseException("DATAFRAME-ERROR",
                "ColumnarResult::toColumnHash() returned type '%s'; expected 'hash'",
                columns->getTypeName());
            return QoreValue();
        }

        dataframe = QoreDataFrame::fromColumns(columns->get<const QoreHashNode>(), xsink);
    }
    if (!dataframe) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, dataframe);
    return obj.release();
}

//! Returns per-column descriptive statistics
/** @return list of ColumnStats hashes with count, mean, std, min, max, quartiles
*/
list<hash<ColumnStats>> DataFrame::describe() [flags=RET_VALUE_ONLY] {
    return df->describe(xsink);
}

//! Returns a string representation for display
/** @param max_rows maximum number of rows to show (default 10)
*/
string DataFrame::toString(*int max_rows) [flags=RET_VALUE_ONLY] {
    int64_t rows = max_rows ? (int64_t)max_rows : 10;
    return df->toString(rows, xsink);
}

//! Adds a new column to the DataFrame (in-place)
/** @param name the column name
    @param data a list of values for the column (must match row count)
    @throw DATAFRAME-COLUMN-ERROR if column already exists or row count mismatch
*/
nothing DataFrame::addColumn(string name, list<auto> data) {
    df->addColumn(name->c_str(), data, xsink);
}

//! Removes a column from the DataFrame (in-place)
/** @param name the column name to remove
    @throw DATAFRAME-COLUMN-ERROR if column not found
*/
nothing DataFrame::dropColumn(string name) {
    df->dropColumn(name->c_str(), xsink);
}

//! Renames a column (in-place)
/** @param old_name the current column name
    @param new_name the new column name
    @throw DATAFRAME-COLUMN-ERROR if old column not found or new name already exists
*/
nothing DataFrame::renameColumn(string old_name, string new_name) {
    df->renameColumn(old_name->c_str(), new_name->c_str(), xsink);
}

//! Reads a CSV file into a new DataFrame
/** @param path the file path to read
    @param options optional CsvOptions hash controlling separator, quoting, headers, etc.

    @return new DataFrame object with inferred column types

    Column types are inferred from the data: integers → int64, decimals → float64,
    otherwise → string. Empty cells and recognized null strings ("NA", "NULL", "None")
    are treated as null values.

    @par Example:
    @code{.py}
    DataFrame df = DataFrame::readCSV("/path/to/data.csv");
    hash<CsvOptions> tsv_options = {"separator": "\t"};
    DataFrame tsv = DataFrame::readCSV("data.tsv", tsv_options);
    @endcode

    @throw DATAFRAME-IO-ERROR if the file cannot be opened

*/
static DataFrame DataFrame::readCSV(string path, *hash<CsvOptions> options) [dom=FILESYSTEM; flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = QoreDataFrame::readCSV(path->c_str(), options, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Writes the DataFrame to a CSV file
/** @param path the file path to write
    @param options optional CsvOptions hash controlling separator

    @par Example:
    @code{.py}
    df.writeCSV("/path/to/output.csv");
    hash<CsvOptions> options = {"separator": "\t"};
    df.writeCSV("output.tsv", options);
    @endcode

    @throw DATAFRAME-IO-ERROR if the file cannot be opened for writing

*/
nothing DataFrame::writeCSV(string path, *hash<CsvOptions> options) [dom=FILESYSTEM] {
    df->writeCSV(path->c_str(), options, xsink);
}

//! Creates a DataFrame from a SQL query result
/** @param ds a Datasource or DatasourcePool object
    @param sql the SQL SELECT query to execute
    @param bind_args optional bind arguments for the query

    Calls the datasource's \c selectColumnar() method when the driver advertises
    \c DBI_CAP_HAS_COLUMNAR_SELECT, otherwise uses \c select() directly to avoid
    a compatibility conversion through ColumnarResult. ColumnarResult objects,
    column-oriented hashes, and row-oriented lists are accepted.

    @return new DataFrame object with query results

    @par Example:
    @code{.py}
    Datasource ds("pgsql:user/pass@mydb%localhost");
    ds.open();
    DataFrame df = DataFrame::fromQuery(ds,
        "SELECT name, age, salary FROM employees WHERE dept = %v", ("sales",));
    printf("Loaded %d rows\n", df.numRows());
    @endcode

    @throw DATAFRAME-DB-ERROR if the query fails or returns unexpected results
*/
static DataFrame DataFrame::fromQuery(object ds, string sql, *list<auto> bind_args) [dom=DATABASE; flags=RET_VALUE_ONLY] {
    if (qore_check_cancel(xsink, "executing query for DataFrame")) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> call_args(new QoreListNode(autoTypeInfo), xsink);
    call_args->push(sql->refSelf(), xsink);
    if (*xsink) {
        return QoreValue();
    }
    if (bind_args) {
        // Flatten bind args into the call
        for (size_t i = 0; i < bind_args->size(); ++i) {
            if (i && !(i % 100) && qore_check_cancel(xsink, "preparing DataFrame query arguments")) {
                return QoreValue();
            }
            call_args->push(bind_args->retrieveEntry(i).refSelf(), xsink);
            if (*xsink) {
                return QoreValue();
            }
        }
    }

    const char* query_method = nullptr;
    if (qdfHasMethod(ds, "selectColumnar")) {
        query_method = "selectColumnar";
        if (qdfHasMethod(ds, "getCapabilities") && qdfHasMethod(ds, "select")) {
            ValueHolder caps(ds->evalMethod("getCapabilities", nullptr, xsink), xsink);
            if (*xsink) {
                return QoreValue();
            }
            if (caps->getType() == NT_INT
                    && !(caps->getAsBigInt() & DBI_CAP_HAS_COLUMNAR_SELECT)) {
                query_method = "select";
            }
        }
    } else if (qdfHasMethod(ds, "select")) {
        query_method = "select";
    } else {
        xsink->raiseException("DATAFRAME-DB-ERROR",
            "DataFrame::fromQuery() expects an object with select() or selectColumnar(); got class '%s'",
            ds->getClassName());
        return QoreValue();
    }

    QoreValue result = ds->evalMethod(query_method, *call_args, xsink);
    if (*xsink) {
        return QoreValue();
    }

    QoreDataFrame* df_result = nullptr;
    if (result.getType() == NT_OBJECT) {
        QoreObject* result_obj = result.get<QoreObject>();
        ReferenceHolder<QoreColumnarResult> result_data(qore_columnar_result_try_from_object(result_obj, xsink),
            xsink);
        if (*xsink) {
            result.discard(xsink);
            return QoreValue();
        }

        if (result_data) {
            df_result = QoreDataFrame::fromColumnarResult(*result_data, xsink);
        } else {
            if (!qdfHasMethod(result_obj, "toColumnHash")) {
                xsink->raiseException("DATAFRAME-DB-ERROR",
                    "unexpected query result object class '%s'; expected a ColumnarResult object with toColumnHash()",
                    result_obj->getClassName());
            } else {
                ValueHolder columns(result_obj->evalMethod("toColumnHash", nullptr, xsink), xsink);
                if (!*xsink) {
                    if (columns->getType() != NT_HASH) {
                        xsink->raiseException("DATAFRAME-DB-ERROR",
                            "ColumnarResult::toColumnHash() returned type '%s'; expected 'hash'",
                            columns->getTypeName());
                    } else {
                        df_result = QoreDataFrame::fromColumns(columns->get<const QoreHashNode>(), xsink);
                    }
                }
            }
        }
    } else if (result.getType() == NT_HASH) {
        // Column-oriented: {"col1": (v1, v2, ...), ...}
        df_result = QoreDataFrame::fromColumns(result.get<const QoreHashNode>(), xsink);
    } else if (result.getType() == NT_LIST) {
        // Row-oriented: ({"col1": v1, ...}, ...)
        df_result = QoreDataFrame::fromRecords(result.get<const QoreListNode>(), xsink);
    } else if (result.isNullOrNothing()) {
        df_result = new QoreDataFrame();
    } else {
        xsink->raiseException("DATAFRAME-DB-ERROR",
            "unexpected query result type: %s", result.getTypeName());
    }
    result.discard(xsink);

    if (!df_result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, df_result);
    return obj.release();
}

//! Reads an Apache Arrow IPC stream or file binary into a new DataFrame
/** @param data an Apache Arrow IPC stream or file-format binary buffer

    Loads Arrow columnar data from memory.  Fixed-width Arrow columns such as
    \c int64, \c double, \c bool, and \c decimal128 are preserved as dense
    DataFrame buffers when possible, allowing follow-on
    \c toColumnarResult() calls to keep packed column storage without
    materializing row hashes.  String columns are preserved as string columns,
    timestamps are converted to DataFrame date columns, and recursive Arrow
    schemas such as lists, structs, maps, and dictionary-compatible columns are
    preserved through lossless \c auto columns with ColumnarResult schema
    metadata.  Unsupported physical Arrow layouts are copied into Qore-owned
    storage rather than weakening the logical schema.

    @return new DataFrame object with Arrow IPC data

    @par Example:
    @code{.py}
    binary payload = source_df.toArrowIpc();
    DataFrame df = DataFrame::fromArrowIpc(payload);

    ColumnarResult columns = df.toColumnarResult();
    printf("loaded %d Arrow rows with %d columns\n",
        df.numRows(), columns.numColumns());
    @endcode

    @throw DATAFRAME-IO-ERROR if the data cannot be parsed as Arrow IPC data
*/
static DataFrame DataFrame::fromArrowIpc(binary data) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = QoreDataFrame::fromArrowIpc(data, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Writes the DataFrame as an Apache Arrow IPC stream binary
/** Serializes DataFrame columns to an Arrow IPC stream in memory.  This is the
    preferred interchange format for passing DataFrame data to binary modules
    such as gRPC/Arrow Flight without touching the filesystem.  Primitive
    numeric, boolean, string, date, and decimal columns are written with their
    matching Arrow logical types when possible.  DataFrame columns that carry
    recursive ColumnarResult schema metadata, including list, struct, map, and
    dictionary-compatible columns, are written with that schema and lossless
    Qore values.  Dynamic columns without a concrete schema are materialized
    through the most specific supported Arrow type; values that cannot be
    represented safely raise \c DATAFRAME-IO-ERROR.

    @return an Arrow IPC stream containing the DataFrame schema and data

    @par Example:
    @code{.py}
    DataFrame df(({"id": 1, "score": 95.5}, {"id": 2, "score": 88.0}));

    binary payload = df.toArrowIpc();
    DataFrame copy = DataFrame::fromArrowIpc(payload);
    assertEq(df.toRecords(), copy.toRecords());
    @endcode

    @throw DATAFRAME-IO-ERROR if Arrow serialization fails
*/
binary DataFrame::toArrowIpc() [flags=RET_VALUE_ONLY] {
    return df->toArrowIpc(xsink);
}

//! Reads a Parquet file into a new DataFrame
/** @param path the Parquet file path
    @param options optional ParquetReadOptions hash:
    - \c columns: top-level column names to read; omitted reads all columns
    - \c row_groups: row group numbers to read; omitted reads all row groups
    - \c batch_size: Arrow records per read batch
    - \c use_threads: enables Arrow threaded column reads
    - \c filters: ANDed filter hashes with keys \c column, \c op, and optional \c value
    - \c use_statistics: enables safe row-group pruning with Parquet statistics; default \c True

    Uses Apache Arrow and Parquet to load typed columnar data from disk.
    Column projection is pushed down to the Parquet reader, so unselected
    columns are not decoded unless they are needed by \c filters.  Row-group
    selection is also passed to the reader.  When \c filters is supplied,
    simple range/equality predicates on primitive, decimal128, and logical
    timestamp/date columns use Parquet row-group statistics to avoid reading row
    groups that cannot match when the comparison value maps safely to the
    Parquet logical storage unit.  The filters are always applied exactly after
    reading, so unsupported statistics pushdown forms fall back to correct
    in-memory filtering.

    @return new DataFrame object with Parquet data

    @par Example:
    @code{.py}
    hash<ParquetReadOptions> options = {
        "columns": ("order_id", "customer_name", "total"),
        "filters": ({
            "column": "status",
            "op": "==",
            "value": "complete",
        }, {
            "column": "total",
            "op": ">=",
            "value": 1000.0,
        }),
        "use_threads": True,
    };
    DataFrame df = DataFrame::readParquet("/data/sales.parquet", options);
    printf("Loaded %d rows, %d cols\n", df.numRows(), df.numCols());
    @endcode

    @throw DATAFRAME-IO-ERROR if the file cannot be opened or parsed
*/
static DataFrame DataFrame::readParquet(string path, *hash<ParquetReadOptions> options) [dom=FILESYSTEM; flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = QoreDataFrame::readParquet(path->c_str(), options, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Writes the DataFrame to a Parquet file
/** @param path the Parquet file path
    @param options optional ParquetWriteOptions hash:
    - \c compression: \c "none", \c "snappy", \c "gzip", \c "brotli", \c "zstd", \c "lz4", or \c "lz4_frame"
    - \c row_group_size: maximum rows per Parquet row group
    - \c use_dictionary: enables or disables dictionary encoding globally
    - \c write_statistics: enables or disables column statistics
    - \c use_threads: enables Arrow threaded column writes
    - \c store_schema: stores Arrow schema metadata in the Parquet file

    Uses Apache Arrow and Parquet to write typed columnar data to disk.

    @par Example:
    @code{.py}
    hash<ParquetWriteOptions> options = {
        "compression": "zstd",
        "row_group_size": 100000,
        "use_dictionary": True,
    };
    df.writeParquet("/data/output.parquet", options);
    @endcode

    @throw DATAFRAME-IO-ERROR if the file cannot be opened for writing
*/
nothing DataFrame::writeParquet(string path, *hash<ParquetWriteOptions> options) [dom=FILESYSTEM] {
    df->writeParquet(path->c_str(), options, xsink);
}

//! Inserts DataFrame rows into a database table
/** @param ds a Datasource or DatasourcePool object
    @param table_name the target table name
    @param options optional hash:
    - \c block_size (int, default 10000): rows per bulk database execution when
      supported
    - \c commit_interval (int): deprecated alias for \c block_size, kept for
      compatibility; this method does not commit transactions
    - \c table_options (hash): optional SqlUtil::Table options passed to the
      generic table wrapper
    - \c table_description (hash): optional SqlUtil table description hash; if
      omitted, one is inferred from the DataFrame column types

    Column names from the DataFrame are used as the column list. When available,
    the method writes through SqlUtil::AbstractTable bulk inserts, allowing each
    driver to use its native bulk DML / array-bind support or SqlUtil's
    emulation. If the generic SqlUtil module cannot be loaded, the method falls
    back to a prepared insert statement when possible and finally to per-row
    \c exec() calls.

    @note This method does not commit or roll back the datasource. Use
    Datasource::commit(), Datasource::rollback(), DatasourcePool::commit(), or
    DatasourcePool::rollback() in caller-managed transaction handling.

    @par Example:
    @code{.py}
    Datasource ds("pgsql:user/pass@mydb%localhost");
    ds.open();
    df.toTable(ds, "employees");
    ds.commit();
    @endcode

    @throw DATAFRAME-DB-ERROR if the INSERT fails
*/
nothing DataFrame::toTable(object ds, string table_name, *hash<auto> options) [dom=DATABASE] {
    if (qore_check_cancel(xsink, "writing DataFrame to table")) {
        return QoreValue();
    }

    int64_t n_rows_val = df->numRows();
    int64_t n_cols_val = df->numCols();
    if (n_rows_val == 0 || n_cols_val == 0) {
        return QoreValue();
    }

    int64_t block_size = 10000;
    if (options) {
        QoreValue bs = options->getKeyValue("block_size");
        if (!bs.isNullOrNothing()) {
            block_size = bs.getAsBigInt();
        } else {
            QoreValue ci = options->getKeyValue("commit_interval");
            if (!ci.isNullOrNothing()) {
                block_size = ci.getAsBigInt();
            }
        }
    }
    if (block_size <= 0) {
        block_size = n_rows_val;
    }

    std::vector<Column> columns;
    {
        std::lock_guard<std::mutex> lk(df->getMutex());
        columns = df->getColumns();
    }

    int rc = qdfTryGenericBulkInsert(getProgram(), ds, table_name->c_str(), options,
        columns, n_rows_val, block_size, xsink);
    if (*xsink) {
        return QoreValue();
    }
    if (rc == 0) {
        return QoreValue();
    }

    std::string sql = qdfBuildInsertSql(table_name->c_str(), columns);
    rc = qdfPreparedRowInsert(ds, sql, columns, n_rows_val, xsink);
    if (*xsink) {
        return QoreValue();
    }
    if (rc == 0) {
        return QoreValue();
    }

    qdfExecRowInsert(ds, sql, columns, n_rows_val, xsink);
    return QoreValue();
}

//! Returns a new DataFrame with an added or replaced column
/** @param name column name (replaces if already exists)
    @param data list of values (must match row count)
    @return new DataFrame object

    @par Example:
    @code{.py}
    DataFrame df2 = df.withColumn("rank", df.rowNumber({"order_by": ("score",)}));
    @endcode

*/
DataFrame DataFrame::withColumn(string name, list<auto> data) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = df->withColumn(name->c_str(), data, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Pivots from long to wide format
/** @param index_col column to use as row index
    @param columns_col column whose unique values become output columns
    @param values_col column with values to aggregate
    @param agg_func aggregation function: "sum" (default) or "mean"
    @return new DataFrame in wide format

    @par Example:
    @code{.py}
    # Long: name, metric, value → Wide: name, metric1, metric2
    DataFrame wide = df.pivot("name", "metric", "value");
    @endcode

*/
DataFrame DataFrame::pivot(string index_col, string columns_col, string values_col, *string agg_func) [flags=RET_VALUE_ONLY] {
    std::string func = agg_func ? agg_func->c_str() : "sum";
    QoreDataFrame* result = df->pivot(index_col->c_str(), columns_col->c_str(),
        values_col->c_str(), func, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Melts from wide to long format (unpivot)
/** @param id_vars columns to keep as identifier variables
    @param value_vars columns to unpivot (default: all non-id columns)
    @param var_name name for the variable column (default "variable")
    @param value_name name for the value column (default "value")
    @return new DataFrame in long format

    @par Example:
    @code{.py}
    DataFrame long_df = df.melt(("name",), ("score", "age"), "metric", "value");
    @endcode

*/
DataFrame DataFrame::melt(list<string> id_vars, *list<string> value_vars, *string var_name, *string value_name) [flags=RET_VALUE_ONLY] {
    std::string vn = var_name ? var_name->c_str() : "variable";
    std::string val_n = value_name ? value_name->c_str() : "value";
    QoreDataFrame* result = df->melt(id_vars, value_vars, vn, val_n, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    obj->setPrivate(CID_DATAFRAME, result);
    return obj.release();
}

//! Returns row numbers within optional partitions (window function)
/** @param spec optional WindowSpec hash with partition_by, order_by, ascending
    @return list of integers (1-based row numbers)

    @par Example:
    @code{.py}
    list<int> rn = df.rowNumber({"partition_by": ("dept",), "order_by": ("salary",)});
    DataFrame df2 = df.withColumn("row_num", rn);
    @endcode

*/
list<int> DataFrame::rowNumber(*hash<auto> spec) [flags=RET_VALUE_ONLY] {
    return df->rowNumber(spec, xsink);
}

//! Returns previous row's value within partitions (window function)
/** @param column column to access
    @param offset number of rows to look back (default 1)
    @param spec optional WindowSpec hash
    @return list of values (NOTHING at partition boundaries)

*/
list<auto> DataFrame::lag(string column, *int offset, *hash<auto> spec) [flags=RET_VALUE_ONLY] {
    int64_t off = offset ? (int64_t)offset : 1;
    return df->lag(column->c_str(), off, spec, xsink);
}

//! Returns next row's value within partitions (window function)
/** @param column column to access
    @param offset number of rows to look ahead (default 1)
    @param spec optional WindowSpec hash
    @return list of values (NOTHING at partition boundaries)

*/
list<auto> DataFrame::lead(string column, *int offset, *hash<auto> spec) [flags=RET_VALUE_ONLY] {
    int64_t off = offset ? (int64_t)offset : 1;
    return df->lead(column->c_str(), off, spec, xsink);
}

//! Returns cumulative sum within partitions (window function)
/** @param column numeric column to sum
    @param spec optional WindowSpec hash
    @return list of cumulative sums

*/
list<auto> DataFrame::cumSum(string column, *hash<auto> spec) [flags=RET_VALUE_ONLY] {
    return df->cumSum(column->c_str(), spec, xsink);
}

//! Returns rolling mean within partitions (window function)
/** @param column numeric column to average
    @param window_size number of rows in the rolling window
    @param spec optional WindowSpec hash
    @return list of rolling mean values (NOTHING when window has no data)

*/
list<auto> DataFrame::rollingMean(string column, int window_size, *hash<auto> spec) [flags=RET_VALUE_ONLY] {
    return df->rollingMean(column->c_str(), (int64_t)window_size, spec, xsink);
}
