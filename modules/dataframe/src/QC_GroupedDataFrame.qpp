#include "QC_GroupedDataFrame.h"

using namespace QoreDataFrameNS;

//! A grouped DataFrame for aggregation operations
/** Created by @ref DataFrame::groupBy(). Holds group keys and row indices per group.

    @par Example:
    @code{.py}
    %requires dataframe

    DataFrame df(
        ({"dept": "sales",  "salary": 50000},
         {"dept": "sales",  "salary": 60000},
         {"dept": "eng",    "salary": 80000},
         {"dept": "eng",    "salary": 90000}));

    GroupedDataFrame gdf = df.groupBy(("dept",));
    DataFrame result = gdf.agg({"salary": "mean"});
    printf("%s\n", result.toString());
    @endcode

    @since dataframe 1.0
*/
qclass GroupedDataFrame [arg=QoreGroupedDataFrame* gdf; ns=Qore::DataFrame; flags=final];

//! Destroys the GroupedDataFrame
/** Releases the values of the columns of its DataFrame that it holds.
*/
GroupedDataFrame::destructor() {
    gdf->destructor(*self, xsink);
    gdf->deref(xsink);
}

//! GroupedDataFrames cannot be copied
/** @throw COPY-ERROR always thrown
*/
GroupedDataFrame::copy() {
    xsink->raiseException("COPY-ERROR", "GroupedDataFrame objects cannot be copied");
}

//! Aggregates groups with per-column function specifications
/** @param agg_spec a hash mapping column names to aggregation functions.
    Each value can be a string (single function) or a list of strings
    (multiple functions — result columns suffixed with _func).

    Supported functions:
    - for a column of any type: \c "count" and \c "nunique" (the number of values and of distinct values that
      are not null, as an \c int64 column), \c "first" and \c "last" (the first and last value that is not null,
      in a column of the type of the source column)
    - for a numeric, string, date or bool column: \c "min" and \c "max"; the result of a numeric column is a
      \c float64 column, and that of another column a column of its type, with strings compared byte by byte
    - for a numeric column: \c "sum", \c "mean", \c "std" and \c "median", as a \c float64 column

    @return new DataFrame with one row per group

    @par Example:
    @code{.py}
    DataFrame result = gdf.agg({"salary": "mean", "bonus": ("sum", "max"), "name": "first"});
    @endcode

    @throw DATAFRAME-COLUMN-ERROR a column is not found, or an aggregation cannot be applied to the type of a column
    @throw DATAFRAME-ERROR an aggregation is unknown, or is not a string or a list of strings

*/
DataFrame GroupedDataFrame::agg(hash<auto> agg_spec) [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = gdf->agg(agg_spec, xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    setDataFramePrivate(**obj, result);
    return obj.release();
}

//! Returns a count of rows per group
/** @return new DataFrame with group key columns plus a "count" column

    @par Example:
    @code{.py}
    DataFrame counts = gdf.count();
    @endcode

*/
DataFrame GroupedDataFrame::count() [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = gdf->count(xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    setDataFramePrivate(**obj, result);
    return obj.release();
}

//! Returns the sum of numeric columns per group
/** @return new DataFrame with group key columns plus summed numeric columns

*/
DataFrame GroupedDataFrame::sum() [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = gdf->sum(xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    setDataFramePrivate(**obj, result);
    return obj.release();
}

//! Returns the mean of numeric columns per group
/** @return new DataFrame with group key columns plus averaged numeric columns

*/
DataFrame GroupedDataFrame::mean() [flags=RET_VALUE_ONLY] {
    QoreDataFrame* result = gdf->mean(xsink);
    if (!result) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_DATAFRAME, getProgram()), xsink);
    setDataFramePrivate(**obj, result);
    return obj.release();
}

//! Returns the number of groups
/** @return the group count
*/
int GroupedDataFrame::numGroups() [flags=CONSTANT] {
    return gdf->numGroups();
}
