#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

/*  dataframe-concat-types.qtest Copyright 2026 Qore Technologies, s.r.o.
    MIT License
*/

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"

%requires QUnit

%requires dataframe

%exec-class DataFrameConcatTypesTest

#! A vertical concat() keeps the element type and columnar schema of a column with dense storage, as a float32 or
#! decimal128 column, when every DataFrame has the same kind of column or none (qore#6097)
class DataFrameConcatTypesTest inherits QUnit::Test {
    constructor() : Test("DataFrameConcatTypesTest", "1.0", \ARGV) {
        addTestCase("float32", \float32Test());
        addTestCase("decimal128", \decimalTest());
        addTestCase("timestamp", \timestampTest());
        addTestCase("duration", \durationTest());
        addTestCase("sliced nullable source", \slicedTest());
        addTestCase("float32 buffer", \float32BufferTest());
        set_return_value(main());
    }

    float32Test() {
        # NaN, 1.5, inf, null, -inf and -2.25 in a float32 column (data/gen-filter-fixtures.cpp)
        DataFrame::DataFrame df = DataFrame::DataFrame::readParquet(get_script_dir() + DirSep + "data" + DirSep
            + "dense_float32.parquet");
        DataFrame::DataFrame both = DataFrame::DataFrame::concat((df.slice(1, 3), df.slice(4, 6)));
        hash<auto> schema = getSchema(both, "v");
        assertEq("float32", schema.buffer_type, "the column is still a float32 buffer");
        assertEq((1.5, @inf@, -@inf@, -2.25), both.getColumn("v"), "the values");
    }

    decimalTest() {
        DataFrame::DataFrame df = decimalFrame((1.25n, -1n, NOTHING), 10, 2);
        DataFrame::DataFrame other = decimalFrame((2.5n,), 10, 2);
        DataFrame::DataFrame both = DataFrame::DataFrame::concat((df, other, df.select(("id",))));
        hash<auto> schema = getSchema(both, "v");
        assertEq(("decimal128", 10, 2), (schema.kind, schema.precision, schema.scale), "the decimal type");
        assertEq((1.25n, -1n, NOTHING, 2.5n, NOTHING, NOTHING, NOTHING), both.getColumn("v"),
            "the values, and nulls for a DataFrame without the column");
        # columns with another scale are concatenated as columns that hold any value
        DataFrame::DataFrame other_scale = decimalFrame((2.5n,), 10, 1);
        DataFrame::DataFrame mixed = DataFrame::DataFrame::concat((df, other_scale));
        assertEq((1.25n, -1n, NOTHING, 2.5n), mixed.getColumn("v"), "the values of decimal columns of two scales");
    }

    timestampTest() {
        list<auto> dates = (2024-01-01T10:00:00Z, NOTHING, 1969-12-31T23:59:59.5Z);
        DataFrame::DataFrame df = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "v": dates,
        }, {
            "v": {"schema": {"kind": "timestamp", "time_unit": "us", "timezone": "UTC", "nullable": True}},
        }));
        DataFrame::DataFrame both = DataFrame::DataFrame::concat((df, df));
        assertEq("date", both.dtypes()[0], "a date column");
        assertEq("timestamp", getSchema(both, "v").kind, "a timestamp column");
        assertEq(dates + dates, both.getColumn("v"), "the values");
    }

    durationTest() {
        list<auto> durations = (5s, NOTHING, 1D);
        DataFrame::DataFrame du = durationFrame(durations);
        DataFrame::DataFrame both = DataFrame::DataFrame::concat((du, du));
        assertEq("duration", getSchema(both, "v").kind, "a duration column");
        assertTrue(both.getColumn("v")[3] == 5s, "a relative date");
        # a timestamp column and a duration column, whose buffers of microseconds mean other values, are not
        # concatenated as dense storage: the timestamp is not read as a duration, nor the duration as a timestamp
        DataFrame::DataFrame ts = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "v": (2024-01-01T10:00:00Z,),
        }, {
            "v": {"schema": {"kind": "timestamp", "time_unit": "us", "timezone": "UTC", "nullable": True}},
        }));
        foreach list<DataFrame::DataFrame> frames in (((ts, du), (du, ts))) {
            DataFrame::DataFrame mixed = DataFrame::DataFrame::concat(frames);
            list<auto> expected = frames[0].getColumn("v") + frames[1].getColumn("v");
            list<auto> actual = mixed.getColumn("v");
            assertEq("auto", mixed.dtypes()[0], "a timestamp and durations make a column that holds any value");
            assertEq(expected.size(), actual.size(), "rows");
            foreach auto value in (expected) {
                # an absolute date and a time value are never equal
                assertTrue(value === actual[$#] || (exists value && value == actual[$#]),
                    sprintf("row %d: %y", $#, actual[$#]));
            }
        }
        # the time unit of a duration column's schema does not change its buffer of microseconds
        DataFrame::DataFrame du_ms = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "v": (7s,),
        }, {
            "v": {"schema": {"kind": "duration", "time_unit": "ms", "nullable": True}},
        }));
        DataFrame::DataFrame units = DataFrame::DataFrame::concat((du, du_ms));
        assertEq("duration", getSchema(units, "v").kind, "durations of two time units");
        assertTrue(units.getColumn("v")[0] == 5s && units.getColumn("v")[3] == 7s,
            "time values of two time units");
        # timestamps of two time zones are absolute dates
        DataFrame::DataFrame ts_cet = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "v": (2024-06-01T10:00:00+02:00,),
        }, {
            "v": {"schema": {"kind": "timestamp", "time_unit": "us", "timezone": "Europe/Prague",
                "nullable": True}},
        }));
        DataFrame::DataFrame zones = DataFrame::DataFrame::concat((ts, ts_cet));
        assertEq("date", zones.dtypes()[0], "timestamps of two time zones");
        assertTrue(zones.getColumn("v")[0] == 2024-01-01T10:00:00Z
            && zones.getColumn("v")[1] == 2024-06-01T08:00:00Z, "the dates of two time zones");
    }

    #! a float32 column read from Parquet, which has a schema, and one built from a buffer<float32>, which has none
    float32BufferTest() {
        DataFrame::DataFrame parquet = DataFrame::DataFrame::readParquet(get_script_dir() + DirSep + "data" + DirSep
            + "dense_float32.parquet").select(("v",)).slice(1, 2);
        DataFrame::DataFrame buffer({"v": new buffer<float32>((0.5, 2))});
        foreach list<DataFrame::DataFrame> frames in (((parquet, buffer), (buffer, parquet))) {
            DataFrame::DataFrame both = DataFrame::DataFrame::concat(frames);
            assertEq("float32", getSchema(both, "v").buffer_type, "a float32 buffer");
            assertEq(frames[0].getColumn("v") + frames[1].getColumn("v"), both.getColumn("v"), "the values");
        }
    }

    #! the validity bits of a view of a nullable source at an offset that is not a multiple of 8
    slicedTest() {
        list<auto> cells = map $1 % 3 ? ($1 + 0.25n) : NOTHING, xrange(20);
        DataFrame::DataFrame df = decimalFrame(cells, 10, 2);
        DataFrame::DataFrame both = DataFrame::DataFrame::concat((df.slice(5, 13), df.slice(3, 9)));
        assertEq(cells[5..12] + cells[3..8], both.getColumn("v"), "the values and nulls");
    }

    private DataFrame::DataFrame durationFrame(list<auto> values) {
        return DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "v": values,
        }, {
            "v": {"native_type": "interval", "nullable": True},
        }));
    }

    private DataFrame::DataFrame decimalFrame(list<auto> values, int precision, int scale) {
        return DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "id": range(values.size()),
            "v": values,
        }, {
            "v": {"schema": {"kind": "decimal128", "precision": precision, "scale": scale, "nullable": True}},
        }));
    }

    private hash<auto> getSchema(DataFrame::DataFrame df, string name) {
        foreach hash<auto> column in (df.toColumnarResult().schemaV2()) {
            if (column.name == name) {
                return column;
            }
        }
        return {};
    }
}
