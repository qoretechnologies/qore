#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

/*  dataframe-dbi.qtest Copyright 2026 Qore Technologies, s.r.o.
    MIT License
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../build/modules/dataframe"

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires Util

%try-module dataframe
%define NoDataFrame
%endtry

%exec-class DataFrameDbiTest

class DataFrameDbiTest inherits QUnit::Test {
    constructor() : Test("DataFrameDbiTest", "1.0") {
        addTestCase("PostgreSQL DataFrame DBI columnar path", \pgsqlTest());
        addTestCase("MySQL DataFrame DBI columnar path", \mysqlTest());
        addTestCase("Oracle DataFrame DBI columnar path", \oracleTest());
        addTestCase("FreeTDS DataFrame DBI columnar path", \freetdsTest());
        addTestCase("ODBC DataFrame DBI columnar path", \odbcTest());
        addTestCase("JDBC DataFrame DBI columnar path", \jdbcTest());
        addTestCase("SQLite DataFrame DBI columnar path", \sqliteTest());

        set_return_value(main());
    }

    private list<auto> getColumn(DataFrame::DataFrame df, string name) {
        try {
            return df.getColumn(name);
        } catch (hash<ExceptionInfo> ex) {
            return df.getColumn(name.upr());
        }
    }

    private execIgnore(Datasource ds, string sql) {
        try {
            ds.exec(sql);
            ds.commit();
        } catch (hash<ExceptionInfo> ex) {
            try {
                ds.rollback();
            } catch (hash<ExceptionInfo> rollback_ex) {
            }
        }
    }

    private verifyDriver(string label, Datasource ds) {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        try {
            ds.open();
        } catch (hash<ExceptionInfo> ex) {
            testSkip(label + " connection not available: " + ex.err + ": " + ex.desc);
        }

        string table = sprintf("qdfdbi%d", getpid());
        string out_table = sprintf("qdfdbo%d", getpid());
        string key_table = sprintf("qdfdbk%d", getpid());
        on_exit {
            execIgnore(ds, "DROP TABLE " + key_table);
            execIgnore(ds, "DROP TABLE " + out_table);
            execIgnore(ds, "DROP TABLE " + table);
            ds.close();
        }

        execIgnore(ds, "DROP TABLE " + key_table);
        execIgnore(ds, "DROP TABLE " + out_table);
        execIgnore(ds, "DROP TABLE " + table);

        ds.exec("CREATE TABLE " + table + " (id integer, name varchar(80), score float)");
        ds.exec("INSERT INTO " + table + " (id, name, score) VALUES (1, 'Ada', 95.5)");
        ds.exec("INSERT INTO " + table + " (id, name, score) VALUES (2, 'Bo', 88.0)");
        ds.exec("INSERT INTO " + table + " (id, name, score) VALUES (3, 'Cy', 92.25)");
        ds.commit();

        # Oracle's INTEGER is NUMBER(38): a scale-0 numeric of a precision over 18 is a decimal128 column of numbers
        # in a columnar result, as it does not always fit in an int64; the other databases' integer is an int64
        list<auto> ids = ds.getDriverRealName() =~ /oracle/i ? (1n, 2n, 3n) : (1, 2, 3);
        DataFrame::DataFrame df = DataFrame::DataFrame::fromQuery(ds,
            "SELECT id, name, score FROM " + table + " ORDER BY id");
        assertEq(3, df.numRows(), label + " fromQuery preserves row count");
        assertEq(ids, getColumn(df, "id"), label + " fromQuery preserves dense ids");
        assertEq(("Ada", "Bo", "Cy"), cast<list<string>>(getColumn(df, "name")),
            label + " fromQuery preserves strings");

        ColumnarResult columns = ds.selectColumnar("SELECT id, name, score FROM " + table + " ORDER BY id");
        assertEq(3, columns.numRows(), label + " selectColumnar returns rows");
        assertEq(ids, columns.getColumn("id").toList(), label + " selectColumnar preserves dense ids");

        ds.exec("CREATE TABLE " + out_table + " (id integer, name varchar(80), score float)");
        df.toTable(ds, out_table);
        ds.commit();

        DataFrame::DataFrame out = DataFrame::DataFrame::fromQuery(ds,
            "SELECT id, name, score FROM " + out_table + " ORDER BY id");
        assertEq(("Ada", "Bo", "Cy"), cast<list<string>>(getColumn(out, "name")),
            label + " toTable round-trip preserves strings");

        # a bulk insert that fails raises the error of the database, not the error of a fallback statement: a
        # database such as PostgreSQL aborts the transaction on an error, so a fallback would fail with "current
        # transaction is aborted"
        ds.exec("CREATE TABLE " + key_table + " (id integer primary key, name varchar(80))");
        ds.exec("INSERT INTO " + key_table + " (id, name) VALUES (1, 'Ada')");
        ds.commit();
        DataFrame::DataFrame dup({"id": (2, 1), "name": ("Bo", "Ada again")});
        *hash<ExceptionInfo> ex;
        try {
            dup.toTable(ds, key_table);
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        # the caller rolls back the failed write; nothing is committed in either case
        ds.rollback();
        assertTrue(exists ex, label + " toTable() of a duplicate key raises an exception");
        if (ex) {
            string err = ex.err + ": " + ex.desc;
            assertRegex("duplicate|unique|primary key", err.lwr(),
                label + " toTable() raises the duplicate key error of the database");
            assertFalse(err =~ /current transaction is aborted/i,
                label + " toTable() does not hide the error behind a fallback statement");
        }
        # Oracle's INTEGER column is a column of numbers, as above
        list<auto> key_ids = getColumn(DataFrame::DataFrame::fromQuery(ds,
            "SELECT id FROM " + key_table + " ORDER BY id"), "id");
        assertEq(ds.getDriverRealName() =~ /oracle/i ? (1n,) : (1,), key_ids,
            label + " the caller rolled back the failed toTable()");
    }

    private verifyConnstr(string label, *string connstr) {
        if (!connstr) {
            testSkip(label + " connection string not set");
        }
        verifyDriver(label, getDatasource(label, connstr));
    }

    #! Returns a datasource for the datasource string; skips the test case if the module of its driver cannot be
    #! loaded (LOAD-MODULE-ERROR: it is not installed, or it was built for another module API)
    private Datasource getDatasource(string label, string connstr) {
        try {
            return new Datasource(connstr);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "LOAD-MODULE-ERROR") {
                rethrow;
            }
            testSkip(sprintf("%s driver module unavailable: %s: %s", label, ex.err, ex.desc));
        }
    }

    private pgsqlTest() {
        verifyConnstr("pgsql", ENV.QORE_DB_CONNSTR_PGSQL);
    }

    private mysqlTest() {
        verifyConnstr("mysql", ENV.QORE_DB_CONNSTR_MYSQL);
    }

    private oracleTest() {
        verifyConnstr("oracle", ENV.QORE_DB_CONNSTR_ORACLE);
    }

    private freetdsTest() {
        verifyConnstr("freetds", ENV.QORE_DB_CONNSTR_FREETDS);
    }

    private odbcTest() {
        verifyConnstr("odbc", ENV.QORE_DB_CONNSTR_ODBC);
    }

    private jdbcTest() {
        verifyConnstr("jdbc", ENV.QORE_DB_CONNSTR_JDBC_PGSQL);
    }

    private sqliteTest() {
        verifyDriver("sqlite3", getDatasource("sqlite3", "sqlite3:@:memory:"));
    }
}
