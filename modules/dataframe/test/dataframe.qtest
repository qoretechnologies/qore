    groupByTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"dept": "sales",  "name": "Alice", "salary": 50000},
             {"dept": "sales",  "name": "Bob",   "salary": 60000},
             {"dept": "eng",    "name": "Carol", "salary": 80000},
             {"dept": "eng",    "name": "Dave",  "salary": 90000},
             {"dept": "eng",    "name": "Eve",   "salary": 85000}));

        auto gdf = df.groupBy(("dept",));
        assertEq(2, gdf.numGroups(), "groupBy creates 2 groups");

        # count()
        auto counts = gdf.count();
        assertEq(2, counts.numRows(), "count has 2 rows");
        # Sort by dept to get deterministic order
        auto sorted_counts = counts.sortBy(("dept",));
        assertEq(("eng", "sales"), sorted_counts.getColumn("dept"), "count dept values");
        assertEq((3, 2), sorted_counts.getColumn("count"), "count values");

        # sum()
        auto sums = gdf.sum();
        auto sorted_sums = sums.sortBy(("dept",));
        # eng: 80000+90000+85000=255000, sales: 50000+60000=110000
        assertEq((255000.0, 110000.0), sorted_sums.getColumn("salary"), "sum values");

        # mean()
        auto means = gdf.mean();
        auto sorted_means = means.sortBy(("dept",));
        # eng: 255000/3=85000, sales: 110000/2=55000
        assertEq((85000.0, 55000.0), sorted_means.getColumn("salary"), "mean values");
    }

    groupByAggTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"cat": "A", "val": 10, "score": 1.0},
             {"cat": "A", "val": 20, "score": 2.0},
             {"cat": "B", "val": 30, "score": 3.0}));

        auto gdf = df.groupBy(("cat",));

        # Multi-function aggregation
        auto result = gdf.agg({"val": ("sum", "mean"), "score": "max"});
        auto sorted = result.sortBy(("cat",));
        assertEq(2, sorted.numRows(), "agg row count");
        # Check column names: cat, val_sum, val_mean, score
        list<string> cols = sorted.columnNames();
        assertTrue(cols.contains("val_sum"), "agg has val_sum column");
        assertTrue(cols.contains("val_mean"), "agg has val_mean column");
        assertTrue(cols.contains("score"), "agg has score column");

        # A: val_sum=30, val_mean=15, score_max=2.0
        # B: val_sum=30, val_mean=30, score_max=3.0
        assertEq((30.0, 30.0), sorted.getColumn("val_sum"), "agg val_sum");
        assertEq((15.0, 30.0), sorted.getColumn("val_mean"), "agg val_mean");
        assertEq((2.0, 3.0), sorted.getColumn("score"), "agg score max");
    }

    pivotMeltTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        # Pivot: long → wide
        DataFrame::DataFrame long_df(
            ({"name": "Alice", "metric": "score", "value": 95},
             {"name": "Alice", "metric": "age",   "value": 30},
             {"name": "Bob",   "metric": "score", "value": 88},
             {"name": "Bob",   "metric": "age",   "value": 25}));

        auto wide = long_df.pivot("name", "metric", "value");
        assertEq(2, wide.numRows(), "pivot row count");
        assertTrue(wide.columnNames().contains("score"), "pivot has score column");
        assertTrue(wide.columnNames().contains("age"), "pivot has age column");

        # Melt: wide → long
        DataFrame::DataFrame wide_df(
            ({"name": "Alice", "score": 95, "age": 30},
             {"name": "Bob",   "score": 88, "age": 25}));

        auto melted = wide_df.melt(("name",), ("score", "age"), "metric", "value");
        assertEq(4, melted.numRows(), "melt row count (2 rows × 2 value cols)");
        assertEq(("name", "metric", "value"), melted.columnNames(), "melt column names");

        # withColumn
        DataFrame::DataFrame df(({"a": 1, "b": 2}, {"a": 3, "b": 4}));
        auto df2 = df.withColumn("c", (10, 20));
        assertEq(3, df2.numCols(), "withColumn adds column");
        assertEq((10, 20), df2.getColumn("c"), "withColumn values");
        # Original unchanged
        assertEq(2, df.numCols(), "original not modified");
    }

    windowFunctionsTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"dept": "A", "name": "Alice", "salary": 50000},
             {"dept": "A", "name": "Bob",   "salary": 60000},
             {"dept": "A", "name": "Carol", "salary": 55000},
             {"dept": "B", "name": "Dave",  "salary": 80000},
             {"dept": "B", "name": "Eve",   "salary": 90000}));

        # rowNumber without partition (global)
        list<int> rn_global = df.rowNumber({"order_by": ("salary",)});
        assertEq(5, rn_global.size(), "rowNumber global length");
        # Salary order: 50000(1), 55000(2), 60000(3), 80000(4), 90000(5)
        assertEq(1, rn_global[0], "rowNumber salary=50000 is 1");

        # rowNumber with partition
        list<int> rn_part = df.rowNumber({
            "partition_by": ("dept",),
            "order_by": ("salary",),
        });
        # Dept A: 50000(1), 55000(2), 60000(3); Dept B: 80000(1), 90000(2)
        assertEq(5, rn_part.size(), "rowNumber partitioned length");

        # cumSum
        list<auto> cs = df.cumSum("salary", {"order_by": ("salary",)});
        assertEq(5, cs.size(), "cumSum length");
        # Cumulative: 50000, 105000, 165000, 245000, 335000
        assertEq(50000.0, cs[0], "cumSum first");

        # lag
        list<auto> lagged = df.lag("salary", 1, {"order_by": ("salary",)});
        assertEq(NOTHING, lagged[0], "lag first row is NOTHING");

        # lead
        list<auto> led = df.lead("salary", 1, {"order_by": ("salary",)});
        assertEq(NOTHING, led[4], "lead last row is NOTHING");

        # rollingMean
        list<auto> rm = df.rollingMean("salary", 2, {"order_by": ("salary",)});
        assertEq(5, rm.size(), "rollingMean length");
        # Window=2: [50000], [50000,55000], [55000,60000], ...
        assertEq(50000.0, rm[0], "rollingMean first (window of 1)");
    }

    joinTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame orders(
            ({"order_id": 1, "cust_id": 10, "amount": 99.0},
             {"order_id": 2, "cust_id": 20, "amount": 50.0},
             {"order_id": 3, "cust_id": 30, "amount": 75.0}));
        DataFrame::DataFrame customers(
            ({"cust_id": 10, "name": "Alice"},
             {"cust_id": 20, "name": "Bob"},
             {"cust_id": 40, "name": "Dave"}));

        # Inner join: only matching keys
        auto inner = orders.join(customers, ("cust_id",));
        assertEq(2, inner.numRows(), "inner join row count");
        auto sorted_inner = inner.sortBy(("cust_id",));
        assertEq((10, 20), sorted_inner.getColumn("cust_id"), "inner join keys");
        assertEq(("Alice", "Bob"), sorted_inner.getColumn("name"), "inner join names");

        # Left join: all left rows, null for unmatched right
        auto left = orders.join(customers, ("cust_id",), "left");
        assertEq(3, left.numRows(), "left join row count");
        auto sorted_left = left.sortBy(("cust_id",));
        assertEq((10, 20, 30), sorted_left.getColumn("cust_id"), "left join keys");
        assertEq(NOTHING, sorted_left.getColumn("name")[2], "left join null for unmatched");

        # Right join: all right rows, null for unmatched left
        auto right = orders.join(customers, ("cust_id",), "right");
        assertEq(3, right.numRows(), "right join row count");
        auto sorted_right = right.sortBy(("cust_id",));
        assertEq((10, 20, 40), sorted_right.getColumn("cust_id"), "right join keys");
        assertEq(NOTHING, sorted_right.getColumn("amount")[2], "right join null for unmatched");

        # Outer join: all rows from both sides
        auto outer = orders.join(customers, ("cust_id",), "outer");
        assertEq(4, outer.numRows(), "outer join row count");

        # Cross join
        DataFrame::DataFrame a(
            ({"x": 1}, {"x": 2}));
        DataFrame::DataFrame b(
            ({"y": "a"}, {"y": "b"}, {"y": "c"}));
        auto cross = a.join(b, (), "cross");
        assertEq(6, cross.numRows(), "cross join 2x3=6");

        # Column name conflict
        DataFrame::DataFrame t1(({"id": 1, "val": 10}, {"id": 2, "val": 11}));
        DataFrame::DataFrame t2(({"id": 1, "val": 20}, {"id": 2, "val": 21}));
        auto conflict = t1.join(t2, ("id",));
        list<string> cols = conflict.columnNames();
        assertTrue(cols.contains("val"), "conflict: left val");
        assertTrue(cols.contains("val_right"), "conflict: right val suffixed");
    }

    dataProviderTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
%ifdef NoDataProviderDataFrame
        testSkip("DataProviderDataFrame module not available");
%endif
        DataFrame::DataFrame df(
            ({"name": "Alice", "age": 30, "score": 95.5},
             {"name": "Bob",   "age": 25, "score": 88.0},
             {"name": "Carol", "age": 35, "score": 92.0}));

        DataProviderDataFrame::DataFrameDataProvider prov(df);
        assertEq("dataframe", prov.getName(), "provider name");

        # Record type reflects DataFrame schema
        *hash<string, AbstractDataField> rt = prov.getRecordType();
        assertTrue(exists rt.name, "record type has name field");
        assertTrue(exists rt.age, "record type has age field");

        # Search with equality filter
        auto it = prov.searchRecords({"name": "Bob"});
        assertTrue(it.next(), "search finds Bob");
        hash<auto> rec = it.getValue();
        assertEq("Bob", rec.name, "search result name");
        assertEq(25, rec.age, "search result age");
        assertFalse(it.next(), "search has no more results");

        # Search with comparison filter
        auto it2 = prov.searchRecords({"age": {">=": 30}});
        int count = 0;
        while (it2.next()) {
            ++count;
        }
        assertEq(2, count, "comparison filter returns 2 records");

        assertTrue(prov.supportsSearchExpressions(), "DataFrame provider supports DPQL search expressions");

        # Search with a DPQL expression string
        auto dpql_it = prov.searchRecords('@score >= 90 && @age >= 30');
        list<string> dpql_names();
        while (dpql_it.next()) {
            push dpql_names, dpql_it.getValue().name;
        }
        assertEq(("Alice", "Carol"), dpql_names, "DataFrame provider filters row search with DPQL");

        # Bulk DPQL searches preserve DataFrameBlock shape
        AbstractDataProviderBulkRecordInterface dpql_bulk = prov.searchRecordsBulk(10, '@score >= 90');
        assertEq(DataProviderShape::DataFrameBlock, dpql_bulk.getValueShape(),
            "DataFrame provider DPQL bulk search advertises DataFrameBlock shape");
        DataFrame::DataFrame dpql_block = dpql_bulk.getShapedValue();
        assertEq(("Alice", "Carol"), dpql_block.getColumn("name"),
            "DataFrame provider DPQL bulk search filters DataFrame blocks");
        assertNothing(dpql_bulk.getShapedValue(), "DataFrame provider DPQL bulk search ends after matching block");

        # Get DataFrame back from provider
        DataFrame::DataFrame df2 = prov.getDataFrame();
        assertEq(3, df2.numRows(), "getDataFrame preserves rows");
    }

    dataProviderPipelineShapeTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
%ifdef NoDataProviderDataFrame
        testSkip("DataProviderDataFrame module not available");
%endif
        DataFrame::DataFrame df(
            ({"name": "Alice", "status": "active", "amount": 90},
             {"name": "Bob", "status": "inactive", "amount": 220},
             {"name": "Carol", "status": "active", "amount": 180},
             {"name": "Dave", "status": "active", "amount": 125}));

        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(df),
            "DataFrame values are detected as DataFrameBlock shape");
        assertEq(4, AbstractDataProcessor::shapeRecordCount(df, DataProviderShape::DataFrameBlock),
            "DataFrameBlock record count uses DataFrame rows");

        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "&&",
            "args": (
                <DataProviderExpression>{
                    "exp": "==",
                    "args": (<DataProviderFieldReference>{"field": "status"}, "active"),
                },
                <DataProviderExpression>{
                    "exp": ">",
                    "args": (<DataProviderFieldReference>{"field": "amount"}, 100),
                },
            ),
        };

        QoreFilterRecordsProcessor proc({"where_cond": expr});
        assertTrue(proc.supportsInputShape(DataProviderShape::DataFrameBlock),
            "filter processor supports DataFrameBlock input");

        DataFrame::DataFrame filtered = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(2, filtered.numRows(), "DataFrameBlock filter keeps matching rows");
        assertEq(("Carol", "Dave"), filtered.getColumn("name"), "DataFrameBlock filter preserves row order");

        hash<DataProviderExpression> parsed_expr = DataProvider::parseDpqlExpression(
            '@status == "active" && @amount > 100');
        QoreFilterRecordsProcessor parsed_proc({"where_cond": parsed_expr});
        DataFrame::DataFrame parsed_filtered = parsed_proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(("Carol", "Dave"), parsed_filtered.getColumn("name"),
            "DataFrameBlock filter accepts parsed DPQL expressions");

        QoreFilterRecordsProcessor dpql_proc({
            "dpql_where": '@status in ("active", "pending") && @amount between 100 and 200',
        });
        DataFrame::DataFrame dpql_filtered = dpql_proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(("Carol", "Dave"), dpql_filtered.getColumn("name"),
            "DataFrameBlock filter parses DPQL strings directly");

        QoreFilterRecordsProcessor where_string_proc({
            "where_cond": '@status == "active" && @amount > 100',
        });
        DataFrame::DataFrame where_string_filtered = where_string_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Carol", "Dave"), where_string_filtered.getColumn("name"),
            "DataFrameBlock filter accepts DPQL strings in where_cond");

        QoreFilterRecordsProcessor contains_proc({
            "dpql_where": 'contains(@name, "a") && @status == "active"',
        });
        DataFrame::DataFrame contains_filtered = contains_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Carol", "Dave"), contains_filtered.getColumn("name"),
            "DataFrameBlock filter applies DPQL string operators");

        QoreFilterRecordsProcessor icase_string_proc({
            "dpql_where": 'contains(@name, "AL", true) || @name like "D%"',
        });
        DataFrame::DataFrame icase_string_filtered = icase_string_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Dave"), icase_string_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports case-insensitive strings and LIKE masks");

        QoreFilterRecordsProcessor regex_proc({
            "dpql_where": '@name !~ /^(A|B)/',
        });
        DataFrame::DataFrame regex_filtered = regex_proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(("Carol", "Dave"), regex_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports regex masks");

        QoreFilterRecordsProcessor string_or_proc({
            "dpql_where": 'contains(@name, "a") || @amount > 200',
        });
        DataFrame::DataFrame string_or_filtered = string_or_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Bob", "Carol", "Dave"), string_or_filtered.getColumn("name"),
            "DataFrameBlock vectorized string predicates compose with OR masks");

        QoreFilterRecordsProcessor string_not_proc({
            "dpql_where": '!contains(@name, "a")',
        });
        DataFrame::DataFrame string_not_filtered = string_not_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Bob"), string_not_filtered.getColumn("name"),
            "DataFrameBlock vectorized string predicates compose with NOT masks");

        QoreFilterRecordsProcessor contains_any_proc({
            "dpql_where": 'containsAny(@name, "li", "av")',
        });
        DataFrame::DataFrame contains_any_filtered = contains_any_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Dave"), contains_any_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports containsAny string masks");

        DataFrame::DataFrame nested_df(
            ({"name": "Alice", "amount": 90, "tags": ("vip", "active"), "scores": (95, 91),
                "payload": {"region": "EU", "tier": "gold"}},
             {"name": "Bob", "amount": 220, "tags": ("trial",), "scores": (88, 84),
                "payload": {"region": "US", "tier": "silver"}},
             {"name": "Carol", "amount": 180, "tags": ("vip", "closed"), "scores": (92, 90),
                "payload": {"region": "EU", "tier": "gold"}},
             {"name": "Dave", "amount": 125, "tags": ("standard",), "scores": (85, 86),
                "payload": {"region": "APAC", "tier": "bronze"}}));

        QoreFilterRecordsProcessor list_contains_proc({
            "dpql_where": 'listContains(@tags, "vip")',
        });
        DataFrame::DataFrame list_contains_filtered = list_contains_proc.processRecordsShape(nested_df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Carol"), list_contains_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports listContains predicates");

        QoreFilterRecordsProcessor list_contains_any_proc({
            "dpql_where": 'listContainsAny(@tags, "trial", "standard")',
        });
        DataFrame::DataFrame list_contains_any_filtered = list_contains_any_proc.processRecordsShape(nested_df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Bob", "Dave"), list_contains_any_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports listContainsAny predicates");

        QoreFilterRecordsProcessor index_proc({
            "dpql_where": '@scores[0] >= 90',
        });
        DataFrame::DataFrame index_filtered = index_proc.processRecordsShape(nested_df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Carol"), index_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports list index accessors");

        hash<DataProviderExpression> slice_expr = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_FUNC_SLICE,
                    "args": (
                        <DataProviderFieldReference>{"field": "scores"},
                        <DataProviderRangeSpec>{"start": 0, "end": 1}
                    ),
                },
                (95, 91)
            ),
        };
        QoreFilterRecordsProcessor slice_proc({"where_cond": slice_expr});
        DataFrame::DataFrame slice_filtered = slice_proc.processRecordsShape(nested_df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice",), slice_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports list slice accessors");

        QoreFilterRecordsProcessor key_proc({
            "dpql_where": '@payload{region} == "EU"',
        });
        DataFrame::DataFrame key_filtered = key_proc.processRecordsShape(nested_df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Carol"), key_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports hash key accessors");

        hash<DataProviderExpression> ternary_expr = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_OP_TERNARY,
                    "args": (
                        <DataProviderExpression>{
                            "exp": DP_SEARCH_OP_GE,
                            "args": (<DataProviderFieldReference>{"field": "amount"}, 150),
                        },
                        "large",
                        "small"
                    ),
                },
                "large"
            ),
        };
        QoreFilterRecordsProcessor ternary_proc({"where_cond": ternary_expr});
        DataFrame::DataFrame ternary_filtered = ternary_proc.processRecordsShape(nested_df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Bob", "Carol"), ternary_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports ternary computed values");

        hash<DataProviderExpression> between_expr = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_BETWEEN,
            "args": (<DataProviderFieldReference>{"field": "amount"}, 100, 200),
        };
        QoreFilterRecordsProcessor between_proc({"where_cond": between_expr});
        DataFrame::DataFrame between_filtered = between_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Carol", "Dave"), between_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports between masks");

        hash<DataProviderExpression> in_expr = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_IN,
            "args": (<DataProviderFieldReference>{"field": "status"}, "active"),
        };
        QoreFilterRecordsProcessor in_proc({"where_cond": in_expr});
        DataFrame::DataFrame in_filtered = in_proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Carol", "Dave"), in_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports in masks");

        hash<DataProviderExpression> list_in_expr = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_IN,
            "args": (<DataProviderFieldReference>{"field": "status"}, ("active", "pending")),
        };
        QoreFilterRecordsProcessor list_in_proc({"where_cond": list_in_expr});
        DataFrame::DataFrame list_in_filtered = list_in_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Carol", "Dave"), list_in_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports list-valued in masks");

        hash<DataProviderExpression> not_in_expr = <DataProviderExpression>{
            "exp": DP_OP_NOT_IN,
            "args": (<DataProviderFieldReference>{"field": "status"}, "inactive"),
        };
        QoreFilterRecordsProcessor not_in_proc({"where_cond": not_in_expr});
        DataFrame::DataFrame not_in_filtered = not_in_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Alice", "Carol", "Dave"), not_in_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports not-in masks");

        QoreFilterRecordsProcessor computed_between_proc({
            "dpql_where": '@amount + 10 between 130 and 200',
        });
        DataFrame::DataFrame computed_between_filtered = computed_between_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Carol", "Dave"), computed_between_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports computed between masks");

        hash<DataProviderExpression> computed_in_strict_expr = <DataProviderExpression>{
            "exp": DP_OP_AND,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_SEARCH_OP_IN,
                    "args": (
                        <DataProviderExpression>{
                            "exp": DP_OP_TO_LOWER,
                            "args": (<DataProviderFieldReference>{"field": "status"},),
                        },
                        "active"
                    ),
                },
                <DataProviderExpression>{
                    "exp": DP_OP_ABSOLUTE_NE,
                    "args": (<DataProviderFieldReference>{"field": "amount"}, 90),
                },
            ),
        };
        QoreFilterRecordsProcessor computed_in_proc({"where_cond": computed_in_strict_expr});
        DataFrame::DataFrame computed_in_filtered = computed_in_proc.processRecordsShape(df,
            DataProviderShape::DataFrameBlock);
        assertEq(("Carol", "Dave"), computed_in_filtered.getColumn("name"),
            "DataFrameBlock vectorized filter supports computed in and structured strict inequality masks");

        hash<DataProviderExpression> fallback_expr = <DataProviderExpression>{
            "exp": "||",
            "args": (
                <DataProviderExpression>{
                    "exp": "==",
                    "args": (<DataProviderFieldReference>{"field": "status"}, "inactive"),
                },
                <DataProviderExpression>{
                    "exp": "<",
                    "args": (<DataProviderFieldReference>{"field": "amount"}, 100),
                },
            ),
        };
        QoreFilterRecordsProcessor fallback_proc({"where_cond": fallback_expr});
        DataFrame::DataFrame fallback_filtered = fallback_proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(2, fallback_filtered.numRows(), "DataFrameBlock filter fallback keeps matching rows");
        assertEq(("Alice", "Bob"), fallback_filtered.getColumn("name"),
            "DataFrameBlock filter fallback preserves runtime DataFrame class");

        QoreGroupByProcessor grouper({
            "group_by": "status",
            "aggregates": "orders=count(),total=sum(amount),avg_amount=avg(amount)",
        });
        assertTrue(grouper.supportsInputShape(DataProviderShape::DataFrameBlock),
            "group-by processor supports DataFrameBlock input");
        assertNothing(grouper.processRecordsShape(df, DataProviderShape::DataFrameBlock),
            "DataFrameBlock group-by accumulates without immediate output");
        *list<auto> grouped_blocks = grouper.flushAndCollect();
        assertEq(1, grouped_blocks.size(), "DataFrameBlock group-by flush emits one shaped block");
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(grouped_blocks[0]),
            "DataFrameBlock group-by preserves DataFrame shape on pipeline flush");
        auto grouped_df = grouped_blocks[0].sortBy(("status",));
        assertEq(("active", "inactive"), grouped_df.getColumn("status"),
            "DataFrameBlock group-by keeps group fields");
        assertEq((3, 1), grouped_df.getColumn("orders"), "DataFrameBlock group-by counts records");
        assertEq((395.0, 220.0), grouped_df.getColumn("total"), "DataFrameBlock group-by computes sums");
        assertFloatEq(395.0 / 3.0, grouped_df.getColumn("avg_amount")[0], 1e-10,
            "DataFrameBlock group-by computes averages with native DataFrame mean");
        assertFloatEq(220.0, grouped_df.getColumn("avg_amount")[1], 1e-10,
            "DataFrameBlock group-by computes averages with native DataFrame mean");

        QoreGroupByProcessor multi_grouper({
            "group_by": "status",
            "aggregates": "orders=count(),total=sum(amount),avg_amount=avg(amount)",
        });
        DataFrame::DataFrame first_group_block({
            "status": ("active", "inactive"),
            "amount": (90.0, 220.0),
        });
        DataFrame::DataFrame second_group_block({
            "status": ("active", "active"),
            "amount": (125.0, 180.0),
        });
        assertNothing(multi_grouper.processRecordsShape(first_group_block, DataProviderShape::DataFrameBlock),
            "first native-compatible DataFrameBlock group-by block is deferred");
        assertNothing(multi_grouper.processRecordsShape(second_group_block, DataProviderShape::DataFrameBlock),
            "second native-compatible DataFrameBlock group-by block deopts without losing the first block");
        *list<auto> multi_grouped_blocks = multi_grouper.flushAndCollect();
        assertEq(1, multi_grouped_blocks.size(), "multi-block DataFrameBlock group-by flush emits one block");
        auto multi_grouped_df = multi_grouped_blocks[0].sortBy(("status",));
        assertEq(("active", "inactive"), multi_grouped_df.getColumn("status"),
            "multi-block DataFrameBlock group-by keeps group fields");
        assertEq((3, 1), multi_grouped_df.getColumn("orders"),
            "multi-block DataFrameBlock group-by counts records from all blocks");
        assertEq((395.0, 220.0), multi_grouped_df.getColumn("total"),
            "multi-block DataFrameBlock group-by sums records from all blocks");
        assertFloatEq(395.0 / 3.0, multi_grouped_df.getColumn("avg_amount")[0], 1e-10,
            "multi-block DataFrameBlock group-by averages records from all blocks");

        DataFrame::DataFrame corr_df({
            "id": new buffer<int64>((1, 2, 3)),
            "amount": new buffer<float64>((90.0, 220.0, 180.0)),
        });
        QoreCorrelationProcessor df_corr_flush({"fields": "id,amount", "window_size": 10});
        assertNothing(df_corr_flush.processRecordsShape(corr_df, DataProviderShape::DataFrameBlock),
            "DataFrameBlock correlation buffers partial windows");
        *list<auto> df_corr_flush_blocks = df_corr_flush.flushAndCollect();
        assertEq(1, df_corr_flush_blocks.size(), "DataFrameBlock correlation flush emits one shaped block");
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(df_corr_flush_blocks[0]),
            "DataFrameBlock correlation flush preserves DataFrame shape");
        assertEq(("correlation",), df_corr_flush_blocks[0].getColumn("event_type"),
            "DataFrameBlock correlation flush emits event values");

        list<auto> callback_rows;
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "dataframe-shape-pipeline-test",
            "output_callback": sub (auto row) {
                push callback_rows, row;
            },
        });
        pipe.append(proc);
        pipe.submit(df);
        pipe.waitDone();

        assertEq(2, callback_rows.size(), "pipeline callback emits DataFrame rows");
        assertEq("Carol", callback_rows[0].name, "pipeline preserves first matching DataFrame row");
        assertEq("Dave", callback_rows[1].name, "pipeline preserves second matching DataFrame row");
        assertEq(4, pipe.getInfo().record_count, "pipeline counts DataFrame input rows");
        assertTrue(pipe.getInfo().bulk, "DataFrame input keeps pipeline in bulk mode");

        list<auto> grouped_callback_rows;
        DataProviderPipeline grouped_pipe(<PipelineOptionInfo>{
            "name": "dataframe-shape-filter-group-test",
            "output_callback": sub (auto row) {
                push grouped_callback_rows, row;
            },
        });
        grouped_pipe.append(new QoreFilterRecordsProcessor({"where_cond": expr}));
        grouped_pipe.append(new QoreGroupByProcessor({
            "group_by": "status",
            "aggregates": "orders=count(),total=sum(amount)",
        }));
        grouped_pipe.submit(df);
        grouped_pipe.waitDone();

        assertEq(1, grouped_callback_rows.size(), "filter -> group-by pipeline emits one aggregate row");
        assertEq("active", grouped_callback_rows[0].status, "filter -> group-by preserves group value");
        assertEq(2, grouped_callback_rows[0].orders, "filter -> group-by counts filtered rows");
        assertEq(305.0, grouped_callback_rows[0].total, "filter -> group-by sums filtered rows");
        assertEq(4, grouped_pipe.getInfo().record_count,
            "filter -> group-by pipeline counts DataFrame input rows");
        assertTrue(grouped_pipe.getInfo().bulk, "filter -> group-by pipeline stays in bulk mode");

        DataProviderDataFrame::DataFrameDataProvider prov(df);
        assertEqSoft((DataProviderShape::DataFrameBlock, DataProviderShape::HashOfLists), prov.getBulkReadShapes(),
            "DataFrame provider advertises native DataFrame bulk read support");
        assertTrue(prov.supportsBulkReadShape(DataProviderShape::DataFrameBlock),
            "DataFrame provider reports DataFrameBlock bulk read support");
        assertTrue(prov.supportsBulkReadShape(DataProviderShape::HashOfLists),
            "DataFrame provider keeps hash-of-lists compatibility support");

        AbstractDataProviderBulkRecordInterface shaped_bulk = prov.searchRecordsBulk(3);
        assertEq(DataProviderShape::DataFrameBlock, shaped_bulk.getValueShape(),
            "DataFrame provider bulk iterator advertises DataFrameBlock shape");
        *auto shaped_block = shaped_bulk.getShapedValue();
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(shaped_block),
            "DataFrame provider shaped bulk iterator returns a DataFrame block");
        assertEq(3, AbstractDataProcessor::shapeRecordCount(shaped_block, DataProviderShape::DataFrameBlock),
            "DataFrame provider shaped bulk block preserves row count");
        assertEq(("Alice", "Bob", "Carol"), shaped_block.toColumnHash().name,
            "DataFrame provider shaped bulk block preserves values");

        AbstractDataProviderBulkRecordInterface bulk = prov.searchRecordsBulk(2);
        assertEq({"name": ("Alice", "Bob"), "status": ("active", "inactive"), "amount": (90, 220)},
            bulk.getValue(), "DataFrame provider returns first bulk block");
        assertEq({"name": ("Carol", "Dave"), "status": ("active", "active"), "amount": (180, 125)},
            bulk.getValue(), "DataFrame provider returns second bulk block");
        assertNothing(bulk.getValue(), "DataFrame provider bulk iterator ends after all rows");
        assertEq(4, bulk.getRecordCount(), "DataFrame provider bulk iterator counts rows");

        AbstractDataProviderBulkRecordInterface active_bulk = prov.searchRecordsBulk(10, {"status": "active"});
        assertEq({"name": ("Alice", "Carol", "Dave"), "status": ("active", "active", "active"),
            "amount": (90, 180, 125)}, active_bulk.getValue(), "DataFrame provider filters bulk blocks");
        assertNothing(active_bulk.getValue(), "filtered DataFrame bulk iterator ends after matching rows");
    }

    dataProviderDpqlShapeTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
%ifdef NoDataProviderDataFrame
        testSkip("DataProviderDataFrame module not available");
%endif
        DataFrame::DataFrame df({
            "id": new buffer<int64>((1, 2, 3, 4)),
            "status": ("active", "inactive", "active", "active"),
            "amount": new buffer<float64>((90.0, 220.0, 180.0, 125.0)),
            "target": new buffer<float64>((100.0, 200.0, 185.0, 120.0)),
            "name": ("Alice", "Bob", "Carol", "Dave"),
        });
        auto columns = df.toColumnarResult();

        QoreFilterRecordsProcessor columns_proc({
            "dpql_where": '@amount >= 125.0 && @id != 2',
        });
        auto filtered = columns_proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(filtered),
            "DPQL BufferColumns filter preserves BufferColumns shape");
        assertEq((3, 4), filtered.getColumn("id").toList(),
            "DPQL BufferColumns filter uses dense numeric masks");

        QoreFilterRecordsProcessor string_proc({
            "dpql_where": 'contains(@name, "a") && @id > 1',
        });
        auto string_filtered = string_proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(string_filtered),
            "DPQL BufferColumns string fallback preserves BufferColumns shape");
        assertEq((3, 4), string_filtered.getColumn("id").toList(),
            "DPQL BufferColumns string fallback keeps matching rows");

        QoreFilterRecordsProcessor string_mask_proc({
            "dpql_where": 'startsWith(@name, "D") || @amount > 200',
        });
        auto string_mask_filtered = string_mask_proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq((2, 4), string_mask_filtered.getColumn("id").toList(),
            "DPQL BufferColumns string predicates build dense masks");

        QoreFilterRecordsProcessor contains_any_proc({
            "dpql_where": 'containsAny(@name, "li", "av")',
        });
        auto contains_any_filtered = contains_any_proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq((1, 4), contains_any_filtered.getColumn("id").toList(),
            "DPQL BufferColumns containsAny predicates build dense masks");

        QoreFilterRecordsProcessor like_proc({
            "dpql_where": '@name like "%a%" && @id > 1',
        });
        auto like_filtered = like_proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq((3, 4), like_filtered.getColumn("id").toList(),
            "DPQL BufferColumns LIKE predicates build dense masks");

        QoreFilterRecordsProcessor regex_proc({
            "dpql_where": '@name =~ /^(A|D)/',
        });
        auto regex_filtered = regex_proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq((1, 4), regex_filtered.getColumn("id").toList(),
            "DPQL BufferColumns regex predicates build dense masks");

        QoreFilterRecordsProcessor field_cmp_proc({
            "dpql_where": '@amount >= @target',
        });
        auto field_cmp_filtered = field_cmp_proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq((2, 4), field_cmp_filtered.getColumn("id").toList(),
            "DPQL BufferColumns field comparisons build dense masks");

        QoreFilterRecordsProcessor computed_cmp_proc({
            "dpql_where": '@amount + @id >= @target',
        });
        auto computed_cmp_filtered = computed_cmp_proc.processRecordsShape(columns,
            DataProviderShape::BufferColumns);
        assertEq((2, 4), computed_cmp_filtered.getColumn("id").toList(),
            "DPQL BufferColumns expression comparisons build dense masks");

        QoreFilterRecordsProcessor computed_between_proc({
            "dpql_where": '@amount + @id between 126.0 and 185.0',
        });
        auto computed_between_filtered = computed_between_proc.processRecordsShape(columns,
            DataProviderShape::BufferColumns);
        assertEq((3, 4), computed_between_filtered.getColumn("id").toList(),
            "DPQL BufferColumns computed between expressions build dense masks");

        hash<DataProviderExpression> computed_in_strict_expr = <DataProviderExpression>{
            "exp": DP_OP_AND,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_SEARCH_OP_IN,
                    "args": (
                        <DataProviderExpression>{
                            "exp": DP_OP_TO_LOWER,
                            "args": (<DataProviderFieldReference>{"field": "status"},),
                        },
                        "active"
                    ),
                },
                <DataProviderExpression>{
                    "exp": DP_OP_ABSOLUTE_NE,
                    "args": (<DataProviderFieldReference>{"field": "amount"}, 90.0),
                },
            ),
        };
        QoreFilterRecordsProcessor computed_in_proc({"where_cond": computed_in_strict_expr});
        auto computed_in_filtered = computed_in_proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq((3, 4), computed_in_filtered.getColumn("id").toList(),
            "DPQL BufferColumns computed in expressions and structured strict inequality build dense masks");

        DataFrame::DataFrame nested_filter_df(
            ({"id": 1, "name": "Alice", "amount": 90.0, "tags": ("vip", "active"), "scores": (95, 91),
                "payload": {"region": "EU", "tier": "gold"}},
             {"id": 2, "name": "Bob", "amount": 220.0, "tags": ("trial",), "scores": (88, 84),
                "payload": {"region": "US", "tier": "silver"}},
             {"id": 3, "name": "Carol", "amount": 180.0, "tags": ("vip", "closed"), "scores": (92, 90),
                "payload": {"region": "EU", "tier": "gold"}},
             {"id": 4, "name": "Dave", "amount": 125.0, "tags": ("standard",), "scores": (85, 86),
                "payload": {"region": "APAC", "tier": "bronze"}}));
        auto nested_filter_columns = nested_filter_df.toColumnarResult();

        QoreFilterRecordsProcessor nested_list_proc({
            "dpql_where": 'listContains(@tags, "vip") || listContainsAny(@tags, "trial")',
        });
        auto nested_list_filtered = nested_list_proc.processRecordsShape(nested_filter_columns,
            DataProviderShape::BufferColumns);
        assertEq((1, 2, 3), nested_list_filtered.getColumn("id").toList(),
            "DPQL BufferColumns list membership predicates build dense masks");

        QoreFilterRecordsProcessor nested_accessor_proc({
            "dpql_where": '@payload{region} == "EU" && @scores[0] >= 90',
        });
        auto nested_accessor_filtered = nested_accessor_proc.processRecordsShape(nested_filter_columns,
            DataProviderShape::BufferColumns);
        assertEq((1, 3), nested_accessor_filtered.getColumn("id").toList(),
            "DPQL BufferColumns nested accessors build dense masks");

        hash<DataProviderExpression> ternary_expr = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_OP_TERNARY,
                    "args": (
                        <DataProviderExpression>{
                            "exp": DP_SEARCH_OP_GE,
                            "args": (<DataProviderFieldReference>{"field": "amount"}, 150.0),
                        },
                        "large",
                        "small"
                    ),
                },
                "large"
            ),
        };
        QoreFilterRecordsProcessor ternary_proc({"where_cond": ternary_expr});
        auto ternary_filtered = ternary_proc.processRecordsShape(nested_filter_columns,
            DataProviderShape::BufferColumns);
        assertEq((2, 3), ternary_filtered.getColumn("id").toList(),
            "DPQL BufferColumns ternary expressions build dense masks");

        date ts1 = date("2026-01-01T00:00:00Z");
        date ts2 = date("2026-01-02T00:00:00Z");
        date ts3 = date("2026-01-03T00:00:00Z");
        date ts4 = date("2026-01-04T00:00:00Z");
        ColumnarResult temporal_columns = ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((1, 2, 3, 4)),
            "created_at": (ts1, ts2, ts3, ts4),
        }, {
            "created_at": {"native_type": "timestamp with time zone", "nullable": False},
        });
        QoreFilterRecordsProcessor temporal_proc({
            "dpql_where": '@created_at >= 2026-01-02T00:00:00Z && @created_at < 2026-01-04T00:00:00Z',
        });
        auto temporal_filtered = temporal_proc.processRecordsShape(temporal_columns,
            DataProviderShape::BufferColumns);
        assertEq((2, 3), temporal_filtered.getColumn("id").toList(),
            "DPQL BufferColumns timestamp predicates build dense temporal masks");

        QoreFilterRecordsProcessor temporal_range_proc({
            "dpql_where": 'inRange(@created_at, 2026-01-02T00:00:00Z, 2026-01-04T00:00:00Z)',
        });
        auto temporal_range_filtered = temporal_range_proc.processRecordsShape(temporal_columns,
            DataProviderShape::BufferColumns);
        assertEq((2, 3), temporal_range_filtered.getColumn("id").toList(),
            "DPQL BufferColumns timestamp inRange predicates normalize dense temporal masks");

        hash<auto> raw_buffers = {
            "id": new buffer<int64>((1, 2, 3, 4)),
            "amount": new buffer<float64>((90.0, 220.0, 180.0, 125.0)),
            "target": new buffer<float64>((100.0, 200.0, 185.0, 120.0)),
            "active": new buffer<bool>((True, False, True, True)),
        };
        QoreFilterRecordsProcessor raw_proc({
            "dpql_where": '@active == true && @amount >= 125.0',
        });
        auto raw_filtered = raw_proc.processRecordsShape(raw_buffers, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(raw_filtered),
            "DPQL hash-of-buffers filter returns BufferColumns shape");
        assertEq((3, 4), raw_filtered.getColumn("id").toList(),
            "DPQL hash-of-buffers filter keeps matching rows");

        QoreFilterRecordsProcessor raw_field_cmp_proc({
            "dpql_where": '@amount >= @target',
        });
        auto raw_field_cmp_filtered = raw_field_cmp_proc.processRecordsShape(raw_buffers,
            DataProviderShape::BufferColumns);
        assertEq((2, 4), raw_field_cmp_filtered.getColumn("id").toList(),
            "DPQL hash-of-buffers field comparisons build dense masks");
    }

    bufferColumnsPipelineShapeTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
%ifdef NoDataProviderDataFrame
        testSkip("DataProviderDataFrame module not available");
%endif
        DataFrame::DataFrame df({
            "id": new buffer<int64>((1, 2, 3, 4)),
            "segment": new buffer<int64>((1, 1, 2, 2)),
            "optional_id": new buffer<*int64>((10, NOTHING, 30, NOTHING)),
            "amount": new buffer<float64>((90.0, 220.0, 180.0, 125.0)),
            "name": ("Alice", "Bob", "Carol", "Dave"),
        });
        auto columns = df.toColumnarResult();

        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(columns),
            "ColumnarResult values are detected as BufferColumns shape");
        assertEq(4, AbstractDataProcessor::shapeRecordCount(columns, DataProviderShape::BufferColumns),
            "BufferColumns record count uses ColumnarResult rows");
        assertEq((2, 3), columns.slice(offset: 1, count: 2).getColumn("id").toList(),
            "ColumnarResult::slice preserves dense contiguous row ranges");
        ColumnarResult projected_columns = ColumnarResult::fromColumnHash({
            "id": columns.getColumn("id"),
            "amount": columns.getColumn("amount"),
        });
        assertEq(("id", "amount"), projected_columns.columnNames(),
            "ColumnarResult::fromColumnHash builds projected columnar blocks");
        assertEq((1, 2, 3, 4), projected_columns.getColumn("id").toList(),
            "ColumnarResult::fromColumnHash preserves dense buffers");
        ColumnarResult row_columns = ColumnarResult::fromRows(({"id": 1, "amount": 90.0},
            {"id": 2, "amount": 220.0}));
        assertEq((1, 2), row_columns.getColumn("id").toList(),
            "ColumnarResult::fromRows builds compatibility columnar blocks");
        ColumnarResult decimal_columns = ColumnarResult::fromColumnHash({
            "total": (12.34n, NOTHING),
        }, {
            "total": {"native_type": "decimal(18, 2)", "nullable": True},
        });
        list<hash<auto>> decimal_schema = decimal_columns.schemaV2();
        assertEq("decimal128", decimal_schema[0].kind,
            "ColumnarResult::schemaV2 preserves decimal logical type");
        assertEq("buffer<*decimal128>", decimal_columns.getColumn("total").fullType(),
            "ColumnarResult stores decimal logical columns as dense decimal buffers");
        assertEq(18, decimal_schema[0].precision,
            "ColumnarResult::schemaV2 preserves decimal precision");
        assertEq(2, decimal_schema[0].scale,
            "ColumnarResult::schemaV2 preserves decimal scale");
        DataFrame::DataFrame decimal_df = DataFrame::DataFrame::fromColumnarResult(decimal_columns);
        assertEq("auto", decimal_df.dtypes()[0],
            "DataFrame preserves decimal columns as lossless auto values");
        assertEq((12.34n, NOTHING), decimal_df.getColumn("total"),
            "DataFrame preserves decimal Qore number values");
        assertEq("buffer<*decimal128>", decimal_df.getColumnBuffer("total").fullType(),
            "DataFrame preserves packed decimal buffers");
        ColumnarResult decimal_roundtrip = decimal_df.toColumnarResult();
        list<hash<auto>> decimal_roundtrip_schema = decimal_roundtrip.schemaV2();
        assertEq("decimal128", decimal_roundtrip_schema[0].kind,
            "DataFrame ColumnarResult round-trip preserves decimal logical type");
        assertEq("buffer<*decimal128>", decimal_roundtrip.getColumn("total").fullType(),
            "DataFrame ColumnarResult round-trip preserves packed decimal buffers");
        assertEq(18, decimal_roundtrip_schema[0].precision,
            "DataFrame ColumnarResult round-trip preserves decimal precision");
        assertEq(2, decimal_roundtrip_schema[0].scale,
            "DataFrame ColumnarResult round-trip preserves decimal scale");

        date ts0 = 1969-12-31T23:59:59.123456Z;
        date ts1 = 2026-01-01T00:00:00.123456Z;
        date ts3 = 2026-01-03T12:30:00.654321Z;
        ColumnarResult temporal_columns = ColumnarResult::fromColumnHash({
            "created_at": (ts0, ts1, NOTHING, ts3),
        }, {
            "created_at": {"native_type": "timestamp with time zone", "nullable": True},
        });
        list<hash<auto>> temporal_schema = temporal_columns.schemaV2();
        assertEq("timestamp", temporal_schema[0].kind,
            "ColumnarResult::schemaV2 preserves timestamp logical type");
        assertEq("buffer<*int64>", temporal_columns.getColumn("created_at").fullType(),
            "ColumnarResult stores timestamp columns as dense microsecond buffers");
        assertEq(get_epoch_microseconds(ts0), temporal_columns.getColumn("created_at")[0],
            "dense timestamp buffer stores pre-epoch UTC epoch microseconds");
        assertEq(get_epoch_microseconds(ts1), temporal_columns.getColumn("created_at")[1],
            "dense timestamp buffer stores UTC epoch microseconds");
        assertEq(get_epoch_microseconds(ts0), get_epoch_microseconds(temporal_columns.toRows()[0].created_at),
            "ColumnarResult row materialization restores pre-epoch timestamp date values");
        assertEq(get_epoch_microseconds(ts3), get_epoch_microseconds(temporal_columns.toRows()[3].created_at),
            "ColumnarResult row materialization restores timestamp date values");
        DataFrame::DataFrame temporal_df = DataFrame::DataFrame::fromColumnarResult(temporal_columns);
        assertEq("date", temporal_df.dtypes()[0],
            "DataFrame consumes dense timestamp columns as date columns");
        assertEq(get_epoch_microseconds(ts0), get_epoch_microseconds(temporal_df.getColumn("created_at")[0]),
            "DataFrame date column preserves pre-epoch dense timestamp values");
        assertEq(get_epoch_microseconds(ts3), get_epoch_microseconds(temporal_df.getColumn("created_at")[3]),
            "DataFrame date column preserves dense timestamp values");
        ColumnarResult temporal_roundtrip = temporal_df.toColumnarResult();
        assertEq("timestamp", temporal_roundtrip.schemaV2()[0].kind,
            "DataFrame ColumnarResult round-trip preserves timestamp logical type");
        assertEq("buffer<*int64>", temporal_roundtrip.getColumn("created_at").fullType(),
            "DataFrame ColumnarResult round-trip preserves packed timestamp buffer");

        date dur0 = 5s + microseconds(123);
        date dur2 = 1m + 2s + microseconds(456789);
        ColumnarResult duration_columns = ColumnarResult::fromColumnHash({
