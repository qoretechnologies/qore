            "BufferColumns vectorized filter preserves dense string columns");

        auto raw_filtered = proc.processRecordsShape(raw_buffers, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(raw_filtered),
            "hash-of-buffers filter returns BufferColumns shape");
        assertEq((3, 4), raw_filtered.getColumn("id").toList(),
            "hash-of-buffers filter uses dense BufferColumns path");

