        hash<auto> raw_buffers = {
            "id": new buffer<int64>((1, 2, 3, 4)),
            "segment": new buffer<int64>((1, 1, 2, 2)),
            "optional_id": new buffer<*int64>((10, NOTHING, 30, NOTHING)),
            "amount": new buffer<float64>((90.0, 220.0, 180.0, 125.0)),
            "active": new buffer<bool>((True, False, True, True)),
        };
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(raw_buffers),
            "hashes of typed buffers are detected as BufferColumns shape");
        assertEq(4, AbstractDataProcessor::shapeRecordCount(raw_buffers, DataProviderShape::BufferColumns),
            "BufferColumns record count supports hash-of-buffers blocks");
        list<auto> raw_rows = AbstractDataProcessor::convertShape(
            raw_buffers, DataProviderShape::BufferColumns, DataProviderShape::RowRecords);
        assertEq(4, raw_rows.size(), "hash-of-buffers conversion emits row records");
        assertEq(220.0, raw_rows[1].amount, "hash-of-buffers conversion preserves dense values");

        hash<DataProviderExpression> expr = <DataProviderExpression>{
