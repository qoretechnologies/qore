        assertEq((1, 2), grouped_df.getColumnBuffer("segment").toList(),
            "BufferColumns group-by keeps dense group keys");
        assertEq((2, 2), grouped_df.getColumnBuffer("orders").toList(),
            "BufferColumns group-by computes dense counts");
        assertEq((310.0, 305.0), grouped_df.getColumnBuffer("total").toList(),
            "BufferColumns group-by computes dense sums");
