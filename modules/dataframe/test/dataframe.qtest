            "DataFrame ColumnarResult round-trip preserves duration logical type");
        assertEq("buffer<*int64>", duration_roundtrip.getColumn("elapsed").fullType(),
            "DataFrame ColumnarResult round-trip preserves packed duration buffer");
        DataFrame::DataFrame converted_temporal_df = AbstractDataProcessor::convertShape(temporal_columns,
            DataProviderShape::BufferColumns, DataProviderShape::DataFrameBlock)[0];
        assertEq("timestamp", converted_temporal_df.toColumnarResult().schemaV2()[0].kind,
            "BufferColumns to DataFrameBlock conversion preserves ColumnarResult timestamp schema");
        DataFrame::DataFrame converted_duration_df = AbstractDataProcessor::convertShape(duration_columns,
            DataProviderShape::BufferColumns, DataProviderShape::DataFrameBlock)[0];
