        hash<DataProviderExpression> in_columns_expr = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_IN,
            "args": (<DataProviderFieldReference>{"field": "id"}, 1, 4),
        };
        QoreFilterRecordsProcessor in_columns_proc({"where_cond": in_columns_expr});
        assertEq((1, 4), in_columns_proc.processRecordsShape(columns,
            DataProviderShape::BufferColumns).getColumn("id").toList(),
            "BufferColumns vectorized filter supports in masks");

        hash<DataProviderExpression> list_in_columns_expr = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_IN,
            "args": (<DataProviderFieldReference>{"field": "id"}, (1, 4)),
        };
        QoreFilterRecordsProcessor list_in_columns_proc({"where_cond": list_in_columns_expr});
        assertEq((1, 4), list_in_columns_proc.processRecordsShape(columns,
            DataProviderShape::BufferColumns).getColumn("id").toList(),
            "BufferColumns vectorized filter supports list-valued in masks");

        hash<DataProviderExpression> not_in_columns_expr = <DataProviderExpression>{
            "exp": DP_OP_NOT_IN,
            "args": (<DataProviderFieldReference>{"field": "id"}, 1, 4),
        };
        QoreFilterRecordsProcessor not_in_columns_proc({"where_cond": not_in_columns_expr});
        assertEq((2, 3), not_in_columns_proc.processRecordsShape(columns,
            DataProviderShape::BufferColumns).getColumn("id").toList(),
            "BufferColumns vectorized filter supports not-in masks");

        DataFrame::DataFrame filtered_df = AbstractDataProcessor::convertShape(
            filtered, DataProviderShape::BufferColumns, DataProviderShape::DataFrameBlock)[0];
        assertEq((3, 4), filtered_df.getColumnBuffer("id").toList(),
            "BufferColumns -> DataFrameBlock preserves dense columns");

        list<auto> callback_rows;
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "buffer-columns-shape-pipeline-test",
            "output_callback": sub (auto row) {
                push callback_rows, row;
            },
        });
        pipe.append(new QoreFilterRecordsProcessor({"where_cond": expr}));
        pipe.submit(columns);
        pipe.waitDone();

        assertEq(2, callback_rows.size(), "pipeline callback emits BufferColumns rows");
        assertEq("Carol", callback_rows[0].name, "BufferColumns pipeline preserves first row");
        assertEq("Dave", callback_rows[1].name, "BufferColumns pipeline preserves second row");
        assertTrue(pipe.getInfo().bulk, "BufferColumns input keeps pipeline in bulk mode");
    }

    parquetTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        # Test Parquet read/write round-trip
        DataFrame::DataFrame df(
            ({"id": 1, "name": "Alice", "score": 95.5},
             {"id": 2, "name": "Bob",   "score": 88.0},
             {"id": 3, "name": "Carol", "score": NOTHING}));

        string tmp_path = tmp_location() + "/df_parquet_test_" + string(getpid()) + ".parquet";
        on_exit {
            unlink(tmp_path);
        }

        df.writeParquet(tmp_path, <DataFrame::ParquetWriteOptions>{
            "compression": "none",
            "row_group_size": 2,
            "use_dictionary": False,
            "write_statistics": True,
            "store_schema": True,
        });

        # Read back
        auto df2 = DataFrame::DataFrame::readParquet(tmp_path);
        assertEq(3, df2.numRows(), "Parquet round-trip rows");
        assertEq(3, df2.numCols(), "Parquet round-trip cols");

        # Verify values
        assertEq((1, 2, 3), df2.getColumn("id"), "Parquet int column");
        assertEq("buffer<*int64>", df2.getColumnBuffer("id").fullType(),
            "Parquet nullable Arrow int column is preserved as a dense buffer");
        assertEq((1, 2, 3), df2.getColumnBuffer("id").toList(),
            "Parquet dense int column preserves values");
        assertEq(("Alice", "Bob", "Carol"), df2.getColumn("name"),
            "Parquet string column");

        # Score column: 95.5, 88.0, NULL
        list<auto> scores = df2.getColumn("score");
        assertEq(95.5, scores[0], "Parquet float value");
        assertEq(88.0, scores[1], "Parquet float value 2");
        assertEq(NOTHING, scores[2], "Parquet null preserved");
        ColumnarResult columns = df2.toColumnarResult();
        assertEq("buffer<*int64>", columns.getColumn("id").fullType(),
            "Parquet DataFrame toColumnarResult keeps dense Arrow int storage");
        list<hash<auto>> schema = columns.schemaV2();
        assertTrue(schema[0].nullable,
            "Parquet nullable Arrow schema metadata is preserved in ColumnarResult");

        DataFrame::DataFrame projected = DataFrame::DataFrame::readParquet(tmp_path, <DataFrame::ParquetReadOptions>{
            "columns": ("name", "id"),
            "batch_size": 1,
            "use_threads": True,
        });
        assertEq(("name", "id"), projected.columnNames(),
            "Parquet read column projection preserves requested top-level column order");
        assertEq(("Alice", "Bob", "Carol"), projected.getColumn("name"),
            "Parquet projected string column preserves values");
        assertEq((1, 2, 3), projected.getColumn("id"),
            "Parquet projected int column preserves values");

        DataFrame::DataFrame last_group = DataFrame::DataFrame::readParquet(tmp_path, <DataFrame::ParquetReadOptions>{
            "columns": ("id", "score"),
            "row_groups": (1,),
        });
        assertEq(1, last_group.numRows(), "Parquet row group selection returns selected rows");
        assertEq(2, last_group.numCols(), "Parquet row group selection preserves projected columns");
        assertEq((3,), last_group.getColumn("id"), "Parquet row group selection preserves row values");

        DataFrame::DataFrame filtered_projection = DataFrame::DataFrame::readParquet(tmp_path,
            <DataFrame::ParquetReadOptions>{
                "columns": ("name",),
                "filters": ({
                    "column": "id",
                    "op": ">=",
                    "value": 2,
                }, {
                    "column": "score",
                    "op": "not_null",
                }),
            });
        assertEq(("name",), filtered_projection.columnNames(),
            "Parquet filtered projection removes filter-only columns");
        assertEq(("Bob",), filtered_projection.getColumn("name"),
            "Parquet read filters are applied exactly after row-group pruning");

        DataFrame::DataFrame string_filtered = DataFrame::DataFrame::readParquet(tmp_path,
            <DataFrame::ParquetReadOptions>{
                "filters": ({
                    "column": "name",
                    "op": "contains",
                    "value": "o",
                },),
                "use_statistics": False,
            });
        assertEq((2, 3), string_filtered.getColumn("id"),
            "Parquet read filters support exact string predicate fallback");

        DataFrame::DataFrame no_matches = DataFrame::DataFrame::readParquet(tmp_path,
            <DataFrame::ParquetReadOptions>{
                "filters": ({
                    "column": "id",
                    "op": ">",
                    "value": 100,
                },),
            });
        assertEq(0, no_matches.numRows(),
            "Parquet statistics pruning with exact filtering returns empty DataFrames correctly");

        ColumnarResult decimal_columns = ColumnarResult::fromColumnHash({
            "total": (12.34n, NOTHING),
        }, {
            "total": {"native_type": "decimal(18, 2)", "nullable": True},
        });
        DataFrame::DataFrame decimal_df = DataFrame::DataFrame::fromColumnarResult(decimal_columns);
        decimal_df.writeParquet(tmp_path);
        DataFrame::DataFrame decimal_parquet_df = DataFrame::DataFrame::readParquet(tmp_path);
        assertEq((12.34n, NOTHING), decimal_parquet_df.getColumn("total"),
            "Parquet preserves decimal Qore number values");
        assertEq("buffer<*decimal128>", decimal_parquet_df.getColumnBuffer("total").fullType(),
            "Parquet preserves decimal columns as dense buffers");
        list<hash<auto>> decimal_parquet_schema = decimal_parquet_df.toColumnarResult().schemaV2();
        assertEq("decimal128", decimal_parquet_schema[0].kind,
            "Parquet preserves decimal logical type");
        assertEq(18, decimal_parquet_schema[0].precision,
            "Parquet preserves decimal precision");
        assertEq(2, decimal_parquet_schema[0].scale,
            "Parquet preserves decimal scale");

        date parquet_ts0 = 1969-12-31T23:59:59.123456Z;
        date parquet_ts2 = 2026-01-03T12:30:00.654321Z;
        ColumnarResult temporal_columns = ColumnarResult::fromColumnHash({
            "created_at": (parquet_ts0, NOTHING, parquet_ts2),
        }, {
            "created_at": {"native_type": "timestamp with time zone", "nullable": True},
        });
        DataFrame::DataFrame temporal_df = DataFrame::DataFrame::fromColumnarResult(temporal_columns);
        temporal_df.writeParquet(tmp_path);
        DataFrame::DataFrame temporal_parquet_df = DataFrame::DataFrame::readParquet(tmp_path);
        assertEq(get_epoch_microseconds(parquet_ts0),
            get_epoch_microseconds(temporal_parquet_df.getColumn("created_at")[0]),
            "Parquet preserves dense timestamp values");
        assertEq(NOTHING, temporal_parquet_df.getColumn("created_at")[1],
            "Parquet preserves dense timestamp null values");
        assertEq(get_epoch_microseconds(parquet_ts2),
            get_epoch_microseconds(temporal_parquet_df.getColumn("created_at")[2]),
            "Parquet preserves later dense timestamp values");
        assertEq("buffer<*int64>", temporal_parquet_df.getColumnBuffer("created_at").fullType(),
            "Parquet preserves timestamp columns as dense microsecond buffers");
        list<hash<auto>> temporal_parquet_schema = temporal_parquet_df.toColumnarResult().schemaV2();
        assertEq("timestamp", temporal_parquet_schema[0].kind,
            "Parquet preserves timestamp logical type");
        assertEq("int64", temporal_parquet_schema[0].buffer_type,
            "Parquet schema metadata preserves timestamp dense storage");
        assertEq("us", temporal_parquet_schema[0].time_unit,
            "Parquet schema metadata preserves timestamp microsecond units");

        DataFrame::DataFrame null_dense_df({
            "id": new buffer<*int64>((NOTHING, 2, NOTHING, 4)),
            "flag": new buffer<*bool>((True, NOTHING, False, NOTHING)),
            "name": new buffer<*string>((NOTHING, "Ada", "Bo", NOTHING)),
            "amount": new buffer<*decimal128>((NOTHING, 12.50n, -3.25n, NOTHING)),
        });
        null_dense_df.writeParquet(tmp_path, <DataFrame::ParquetWriteOptions>{
            "compression": "none",
            "row_group_size": 2,
        });
        DataFrame::DataFrame null_dense_parquet_df = DataFrame::DataFrame::readParquet(tmp_path);
        assertEq((NOTHING, 2, NOTHING, 4), null_dense_parquet_df.getColumn("id"),
            "Parquet preserves null-heavy nullable int values");
        assertEq("buffer<*int64>", null_dense_parquet_df.getColumnBuffer("id").fullType(),
            "Parquet preserves null-heavy nullable int dense storage");
        assertEq((True, NOTHING, False, NOTHING), null_dense_parquet_df.getColumn("flag"),
            "Parquet preserves null-heavy nullable bool values");
        assertEq("buffer<*bool>", null_dense_parquet_df.getColumnBuffer("flag").fullType(),
            "Parquet preserves null-heavy nullable bool dense storage");
        assertEq((NOTHING, "Ada", "Bo", NOTHING), null_dense_parquet_df.getColumn("name"),
            "Parquet preserves null-heavy nullable string values");
        assertEq("buffer<*string>", null_dense_parquet_df.getColumnBuffer("name").fullType(),
            "Parquet preserves null-heavy nullable string dense storage");
        assertEq((NOTHING, 12.50n, -3.25n, NOTHING), null_dense_parquet_df.getColumn("amount"),
            "Parquet preserves null-heavy nullable decimal values");
        assertEq("buffer<*decimal128>", null_dense_parquet_df.getColumnBuffer("amount").fullType(),
            "Parquet preserves null-heavy nullable decimal dense storage");

        ColumnarResult nested_columns = ColumnarResult::fromColumnHash({
            "customer": ({"id": 1, "name": "Ada"}, {"id": 2, "name": NOTHING}),
        }, {
            "customer": {"schema": {
                "kind": "struct",
                "nullable": False,
                "children": (
                    {"name": "id", "kind": "int", "nullable": False},
                    {"name": "name", "kind": "string", "nullable": True}
                ),
            }},
        });
        DataFrame::DataFrame nested_df = DataFrame::DataFrame::fromColumnarResult(nested_columns);
        nested_df.writeParquet(tmp_path);
        DataFrame::DataFrame nested_parquet_df = DataFrame::DataFrame::readParquet(tmp_path);
        assertEq(1, nested_parquet_df.getColumn("customer")[0].id,
            "Parquet preserves nested struct values");
        list<hash<auto>> nested_parquet_schema = nested_parquet_df.toColumnarResult().schemaV2();
        assertEq("struct", nested_parquet_schema[0].kind,
            "Parquet preserves nested logical type");
        assertEq("name", nested_parquet_schema[0].children[1].name,
            "Parquet preserves nested child metadata");
        DataFrame::DataFrame nested_parquet_slice = nested_parquet_df.slice(1, 2);
        nested_parquet_slice.writeParquet(tmp_path);
        DataFrame::DataFrame nested_parquet_slice_df = DataFrame::DataFrame::readParquet(tmp_path);
        assertEq(2, nested_parquet_slice_df.getColumn("customer")[0].id,
            "Parquet preserves sliced nested struct values through Arrow storage");
        assertEq(NOTHING, nested_parquet_slice_df.getColumn("customer")[0].name,
            "Parquet preserves sliced nested struct null child values");

        ColumnarResult list_columns = ColumnarResult::fromColumnHash({
            "items": ((1, 2), (3, 4, 5), NOTHING),
        }, {
            "items": {"schema": {
                "kind": "list",
                "nullable": True,
                "children": ({"name": "item", "kind": "int", "nullable": False},),
            }},
        });
        DataFrame::DataFrame list_df = DataFrame::DataFrame::fromColumnarResult(list_columns);
        list_df.writeParquet(tmp_path);
        DataFrame::DataFrame list_parquet_df = DataFrame::DataFrame::readParquet(tmp_path);
        assertEq((3, 4, 5), list_parquet_df.getColumn("items")[1],
            "Parquet preserves nested list values");
        list<hash<auto>> list_parquet_schema = list_parquet_df.toColumnarResult().schemaV2();
        assertEq("list", list_parquet_schema[0].kind,
            "Parquet preserves nested list metadata");
        DataFrame::DataFrame list_parquet_slice = list_parquet_df.slice(1, 3);
        list_parquet_slice.writeParquet(tmp_path);
        DataFrame::DataFrame list_parquet_slice_df = DataFrame::DataFrame::readParquet(tmp_path);
        assertEq((3, 4, 5), list_parquet_slice_df.getColumn("items")[0],
            "Parquet preserves sliced nested list values through Arrow storage");
        assertEq(NOTHING, list_parquet_slice_df.getColumn("items")[1],
            "Parquet preserves sliced nested list null values");
    }

    arrowIpcTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"id": 1, "name": "Alice", "score": 95.5, "active": True},
             {"id": 2, "name": "Bob",   "score": 88.0, "active": False},
             {"id": 3, "name": "Carol", "score": NOTHING, "active": True}));

        binary payload = df.toArrowIpc();
        assertTrue(payload.size() > 0, "Arrow IPC export returns non-empty binary");

        auto df2 = DataFrame::DataFrame::fromArrowIpc(payload);
        assertEq(3, df2.numRows(), "Arrow IPC round-trip rows");
        assertEq(4, df2.numCols(), "Arrow IPC round-trip cols");
        assertEq((1, 2, 3), df2.getColumn("id"), "Arrow IPC int column");
        assertEq(("Alice", "Bob", "Carol"), df2.getColumn("name"),
            "Arrow IPC string column");
        assertEq((True, False, True), df2.getColumn("active"),
            "Arrow IPC bool column");

        list<auto> scores = df2.getColumn("score");
        assertEq(95.5, scores[0], "Arrow IPC float value");
        assertEq(88.0, scores[1], "Arrow IPC float value 2");
        assertEq(NOTHING, scores[2], "Arrow IPC null preserved");

        assertEq("buffer<*int64>", df2.getColumnBuffer("id").fullType(),
            "Arrow IPC fixed-width int column is preserved as a dense buffer");
        ColumnarResult columns = df2.toColumnarResult();
        assertEq("buffer<*int64>", columns.getColumn("id").fullType(),
            "Arrow IPC DataFrame toColumnarResult keeps dense Arrow int storage");
        list<hash<auto>> schema = columns.schemaV2();
        assertEq("id", schema[0].name, "Arrow IPC schema keeps first column name");
        assertEq("int64", schema[0].buffer_type,
            "Arrow IPC schema metadata preserves dense int storage");
        assertTrue(schema[0].nullable,
            "Arrow IPC nullable Arrow schema metadata is preserved in ColumnarResult");

        ColumnarResult decimal_columns = ColumnarResult::fromColumnHash({
            "total": (12.34n, NOTHING),
        }, {
            "total": {"native_type": "decimal(18, 2)", "nullable": True},
        });
        DataFrame::DataFrame decimal_df = DataFrame::DataFrame::fromColumnarResult(decimal_columns);
        DataFrame::DataFrame decimal_ipc_df = DataFrame::DataFrame::fromArrowIpc(decimal_df.toArrowIpc());
        assertEq((12.34n, NOTHING), decimal_ipc_df.getColumn("total"),
            "Arrow IPC preserves decimal Qore number values");
        assertEq("buffer<*decimal128>", decimal_ipc_df.getColumnBuffer("total").fullType(),
            "Arrow IPC preserves decimal columns as dense buffers");
        list<hash<auto>> decimal_ipc_schema = decimal_ipc_df.toColumnarResult().schemaV2();
        assertEq("decimal128", decimal_ipc_schema[0].kind,
            "Arrow IPC preserves decimal logical type");
        assertEq(18, decimal_ipc_schema[0].precision,
            "Arrow IPC preserves decimal precision");
        assertEq(2, decimal_ipc_schema[0].scale,
            "Arrow IPC preserves decimal scale");

        date ipc_ts0 = 1969-12-31T23:59:59.123456Z;
        date ipc_ts2 = 2026-01-03T12:30:00.654321Z;
        ColumnarResult temporal_columns = ColumnarResult::fromColumnHash({
            "created_at": (ipc_ts0, NOTHING, ipc_ts2),
        }, {
            "created_at": {"native_type": "timestamp with time zone", "nullable": True},
        });
        DataFrame::DataFrame temporal_df = DataFrame::DataFrame::fromColumnarResult(temporal_columns);
        DataFrame::DataFrame temporal_ipc_df = DataFrame::DataFrame::fromArrowIpc(temporal_df.toArrowIpc());
        assertEq(get_epoch_microseconds(ipc_ts0), get_epoch_microseconds(temporal_ipc_df.getColumn("created_at")[0]),
            "Arrow IPC preserves dense timestamp values");
        assertEq(NOTHING, temporal_ipc_df.getColumn("created_at")[1],
            "Arrow IPC preserves dense timestamp null values");
        assertEq(get_epoch_microseconds(ipc_ts2), get_epoch_microseconds(temporal_ipc_df.getColumn("created_at")[2]),
            "Arrow IPC preserves later dense timestamp values");
        assertEq("buffer<*int64>", temporal_ipc_df.getColumnBuffer("created_at").fullType(),
            "Arrow IPC preserves timestamp columns as dense microsecond buffers");
        list<hash<auto>> temporal_ipc_schema = temporal_ipc_df.toColumnarResult().schemaV2();
        assertEq("timestamp", temporal_ipc_schema[0].kind,
            "Arrow IPC preserves timestamp logical type");
        assertEq("int64", temporal_ipc_schema[0].buffer_type,
            "Arrow IPC schema metadata preserves timestamp dense storage");
        assertEq("us", temporal_ipc_schema[0].time_unit,
            "Arrow IPC schema metadata preserves timestamp microsecond units");

        date ipc_dur0 = 5s + microseconds(123);
        date ipc_dur2 = 1m + 2s + microseconds(456789);
        ColumnarResult duration_columns = ColumnarResult::fromColumnHash({
            "elapsed": (ipc_dur0, NOTHING, ipc_dur2),
        }, {
            "elapsed": {"native_type": "interval", "nullable": True},
        });
        DataFrame::DataFrame duration_df = DataFrame::DataFrame::fromColumnarResult(duration_columns);
        DataFrame::DataFrame duration_ipc_df = DataFrame::DataFrame::fromArrowIpc(duration_df.toArrowIpc());
        assertEq(get_duration_microseconds(ipc_dur0), get_duration_microseconds(duration_ipc_df.getColumn("elapsed")[0]),
            "Arrow IPC preserves dense duration values");
        assertEq(NOTHING, duration_ipc_df.getColumn("elapsed")[1],
            "Arrow IPC preserves dense duration null values");
        assertEq(get_duration_microseconds(ipc_dur2), get_duration_microseconds(duration_ipc_df.getColumn("elapsed")[2]),
            "Arrow IPC preserves later dense duration values");
        assertEq("buffer<*int64>", duration_ipc_df.getColumnBuffer("elapsed").fullType(),
            "Arrow IPC preserves duration columns as dense microsecond buffers");
        list<hash<auto>> duration_ipc_schema = duration_ipc_df.toColumnarResult().schemaV2();
        assertEq("duration", duration_ipc_schema[0].kind,
            "Arrow IPC preserves duration logical type");
        assertEq("int64", duration_ipc_schema[0].buffer_type,
            "Arrow IPC schema metadata preserves duration dense storage");
        assertEq("us", duration_ipc_schema[0].time_unit,
            "Arrow IPC schema metadata preserves duration microsecond units");

        DataFrame::DataFrame null_dense_df({
            "id": new buffer<*int64>((NOTHING, 2, NOTHING, 4)),
            "flag": new buffer<*bool>((True, NOTHING, False, NOTHING)),
            "name": new buffer<*string>((NOTHING, "Ada", "Bo", NOTHING)),
            "amount": new buffer<*decimal128>((NOTHING, 12.50n, -3.25n, NOTHING)),
        });
        DataFrame::DataFrame null_dense_ipc_df = DataFrame::DataFrame::fromArrowIpc(null_dense_df.toArrowIpc());
        assertEq((NOTHING, 2, NOTHING, 4), null_dense_ipc_df.getColumn("id"),
            "Arrow IPC preserves null-heavy nullable int values");
        assertEq("buffer<*int64>", null_dense_ipc_df.getColumnBuffer("id").fullType(),
            "Arrow IPC preserves null-heavy nullable int dense storage");
        assertEq((True, NOTHING, False, NOTHING), null_dense_ipc_df.getColumn("flag"),
            "Arrow IPC preserves null-heavy nullable bool values");
        assertEq("buffer<*bool>", null_dense_ipc_df.getColumnBuffer("flag").fullType(),
            "Arrow IPC preserves null-heavy nullable bool dense storage");
        assertEq((NOTHING, "Ada", "Bo", NOTHING), null_dense_ipc_df.getColumn("name"),
            "Arrow IPC preserves null-heavy nullable string values");
        assertEq("buffer<*string>", null_dense_ipc_df.getColumnBuffer("name").fullType(),
            "Arrow IPC preserves null-heavy nullable string dense storage");
        assertEq((NOTHING, 12.50n, -3.25n, NOTHING), null_dense_ipc_df.getColumn("amount"),
            "Arrow IPC preserves null-heavy nullable decimal values");
        assertEq("buffer<*decimal128>", null_dense_ipc_df.getColumnBuffer("amount").fullType(),
            "Arrow IPC preserves null-heavy nullable decimal dense storage");

        ColumnarResult nested_columns = ColumnarResult::fromColumnHash({
            "customer": ({"id": 1, "name": "Ada"}, {"id": 2, "name": NOTHING}),
        }, {
            "customer": {"schema": {
                "kind": "struct",
                "nullable": False,
                "children": (
                    {"name": "id", "kind": "int", "nullable": False},
                    {"name": "name", "kind": "string", "nullable": True}
                ),
            }},
        });
        DataFrame::DataFrame nested_df = DataFrame::DataFrame::fromColumnarResult(nested_columns);
        DataFrame::DataFrame nested_ipc_df = DataFrame::DataFrame::fromArrowIpc(nested_df.toArrowIpc());
        assertEq(1, nested_ipc_df.getColumn("customer")[0].id,
            "Arrow IPC preserves nested struct values");
        list<hash<auto>> nested_ipc_schema = nested_ipc_df.toColumnarResult().schemaV2();
        assertEq("struct", nested_ipc_schema[0].kind,
            "Arrow IPC preserves nested logical type");
        assertEq("name", nested_ipc_schema[0].children[1].name,
            "Arrow IPC preserves nested child metadata");
        DataFrame::DataFrame nested_ipc_slice_df = DataFrame::DataFrame::fromArrowIpc(
            nested_ipc_df.slice(1, 2).toArrowIpc());
        assertEq(2, nested_ipc_slice_df.getColumn("customer")[0].id,
            "Arrow IPC preserves sliced nested struct values through Arrow storage");
        assertEq(NOTHING, nested_ipc_slice_df.getColumn("customer")[0].name,
            "Arrow IPC preserves sliced nested struct null child values");

        ColumnarResult list_columns = ColumnarResult::fromColumnHash({
            "items": ((1, 2), (3, 4, 5), NOTHING),
        }, {
            "items": {"schema": {
                "kind": "list",
                "nullable": True,
                "children": ({"name": "item", "kind": "int", "nullable": False},),
            }},
        });
        DataFrame::DataFrame list_df = DataFrame::DataFrame::fromColumnarResult(list_columns);
        DataFrame::DataFrame list_ipc_df = DataFrame::DataFrame::fromArrowIpc(list_df.toArrowIpc());
        assertEq((1, 2), list_ipc_df.getColumn("items")[0],
            "Arrow IPC preserves nested list values");
        list<hash<auto>> list_ipc_schema = list_ipc_df.toColumnarResult().schemaV2();
        assertEq("list", list_ipc_schema[0].kind,
            "Arrow IPC preserves nested list metadata");
        DataFrame::DataFrame list_ipc_slice_df = DataFrame::DataFrame::fromArrowIpc(
            list_ipc_df.slice(1, 3).toArrowIpc());
        assertEq((3, 4, 5), list_ipc_slice_df.getColumn("items")[0],
            "Arrow IPC preserves sliced nested list values through Arrow storage");
        assertEq(NOTHING, list_ipc_slice_df.getColumn("items")[1],
            "Arrow IPC preserves sliced nested list null values");

        assertThrows("DATAFRAME-IO-ERROR", \DataFrame::DataFrame::fromArrowIpc(), (binary("not an arrow stream"),),
            "Arrow IPC import rejects invalid payloads with DataFrame I/O diagnostics");
    }

    mlIntegrationTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"x1": 1.0, "x2": 2.0, "y": 10.0, "label": "a"},
             {"x1": 3.0, "x2": 4.0, "y": 20.0, "label": "b"},
             {"x1": 5.0, "x2": 6.0, "y": 30.0, "label": "c"}));

        # toMatrix — specified columns
        list<auto> mat = df.toMatrix(("x1", "x2"));
        assertEq(3, mat.size(), "toMatrix row count");
        assertEq(2, mat[0].size(), "toMatrix col count");
        assertEq(1.0, mat[0][0], "toMatrix first value");
        assertEq(6.0, mat[2][1], "toMatrix last value");

        # toMatrix — all numeric (skips string column)
        list<auto> mat_all = df.toMatrix();
        assertEq(3, mat_all.size(), "toMatrix all rows");
        assertEq(3, mat_all[0].size(), "toMatrix all numeric cols (x1, x2, y)");

        # toVector
        list<auto> target = df.toVector("y");
        assertEq((10.0, 20.0, 30.0), target, "toVector values");

        # toVector error on non-numeric
        assertThrows("DATAFRAME-ERROR", \df.toVector(), ("label",),
            "toVector on string column throws");

        # fromMatrix round-trip
        auto df2 = DataFrame::DataFrame::fromMatrix(mat, ("a", "b"));
        assertEq(3, df2.numRows(), "fromMatrix rows");
        assertEq(2, df2.numCols(), "fromMatrix cols");
        assertEq(("a", "b"), df2.columnNames(), "fromMatrix column names");
        assertEq(1.0, df2.getColumn("a")[0], "fromMatrix first value");

        # toMatrix → fromMatrix round-trip
        auto df3 = DataFrame::DataFrame::fromMatrix(df.toMatrix(("x1", "x2")), ("x1", "x2"));
        assertEq(df.getColumn("x1"), df3.getColumn("x1"), "round-trip x1");
        assertEq(df.getColumn("x2"), df3.getColumn("x2"), "round-trip x2");

        # Test with null values → NaN
        DataFrame::DataFrame df_null(
            ({"v": 1.0}, {"v": NOTHING}, {"v": 3.0}));
        list<auto> vec_null = df_null.toVector("v");
        assertEq(1.0, vec_null[0], "toVector null: first");
        # NaN check: NaN != NaN
        assertTrue(vec_null[1] != vec_null[1], "toVector null: NaN for NOTHING");
        assertEq(3.0, vec_null[2], "toVector null: third");
    }

    dbQueryTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        # Skip if no database connection available
        *string connstr = ENV.QORE_DB_CONNSTR_PGSQL;
        if (!connstr) {
            testSkip("QORE_DB_CONNSTR_PGSQL not set");
        }

        # Test with a simple query
        Datasource ds(connstr);
        ds.open();
        on_exit {
            ds.close();
        }

        # Create a temp table, insert data, query into DataFrame
        ds.exec("CREATE TEMP TABLE df_test (id int, name text, score float)");
        ds.exec("INSERT INTO df_test VALUES (1, 'Alice', 95.5)");
        ds.exec("INSERT INTO df_test VALUES (2, 'Bob', 88.0)");
        ds.exec("INSERT INTO df_test VALUES (3, 'Carol', 92.0)");
        ds.commit();

        auto df = DataFrame::DataFrame::fromQuery(ds, "SELECT * FROM df_test ORDER BY id");
        assertEq(3, df.numRows(), "DB query row count");
        assertEq(3, df.numCols(), "DB query col count");

        # Verify data
        list<auto> ids = df.getColumn("id");
        assertEq(3, ids.size(), "DB query id column size");

        # toTable round-trip
        ds.exec("CREATE TEMP TABLE df_test_out (id int, name text, score float)");
        df.toTable(ds, "df_test_out");
        ds.commit();

        auto df2 = DataFrame::DataFrame::fromQuery(ds,
            "SELECT * FROM df_test_out ORDER BY id");
        assertEq(3, df2.numRows(), "toTable round-trip rows");
        assertEq(("Alice", "Bob", "Carol"), df2.getColumn("name"),
            "toTable round-trip names");
    }

    dbQueryDispatchTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        MockDataFrameDatasource fallback(False);
        DataFrame::DataFrame fallback_df = DataFrame::DataFrame::fromQuery(fallback, "select test");
        assertEq(1, fallback.selectCalls(), "fromQuery uses select() when native columnar support is absent");
        assertEq(0, fallback.selectColumnarCalls(),
            "fromQuery avoids selectColumnar() compatibility fallback when native columnar support is absent");
        assertEq(("Ada", "Bo"), fallback_df.getColumn("name"), "fromQuery select() fallback returns rows");

        MockDataFrameDatasource native(True);
        DataFrame::DataFrame native_df = DataFrame::DataFrame::fromQuery(native, "select test");
        assertEq(0, native.selectCalls(), "fromQuery avoids select() when native columnar support is present");
        assertEq(1, native.selectColumnarCalls(),
            "fromQuery uses selectColumnar() when native columnar support is present");
        assertEq((1, 2), native_df.getColumnBuffer("id").toList(),
            "fromQuery preserves dense native columnar columns");
    }

    csvMissingValuesTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        string csv_path = get_script_dir() + "/data/test_missing.csv";
        auto df = DataFrame::DataFrame::readCSV(csv_path);

        assertEq(4, df.numRows(), "CSV missing rows");

        # Row 2 (index 1): value is empty → null
        list<auto> vals = df.getColumn("value");
        assertEq(10.5, vals[0], "CSV first value present");
        assertEq(NOTHING, vals[1], "CSV empty cell is null");
        assertEq(30.0, vals[2], "CSV third value present");
        assertEq(NOTHING, vals[3], "CSV 'NA' is null");

        # Row 3 (index 2): label is empty → null
        list<auto> labels = df.getColumn("label");
        assertEq("A", labels[0], "CSV first label");
        assertEq(NOTHING, labels[2], "CSV empty label is null");
    }
}
