%modern

%requires ../../../qlib/Util.qm
%requires ../../../qlib/QUnit.qm

%try-module dataframe
%define NoDataFrame
%endtry

%try-module DataProviderDataFrame
%define NoDataProviderDataFrame
%endtry

%exec-class DataFrameTest

class MockDataFrameDatasource {
    private {
        bool native_columnar;
        int select_calls;
        int select_columnar_calls;
    }

    constructor(bool native_columnar) {
        self.native_columnar = native_columnar;
        select_calls = 0;
        select_columnar_calls = 0;
    }

    int getCapabilities() {
        return native_columnar ? DBI_CAP_HAS_COLUMNAR_SELECT : 0;
    }

    auto select(string sql, ...) {
        ++select_calls;
        return {"id": (1, 2), "name": ("Ada", "Bo")};
    }

    auto selectColumnar(string sql, ...) {
        ++select_columnar_calls;
        return ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((1, 2)),
            "name": ("Ada", "Bo"),
        });
    }

    int selectCalls() {
        return select_calls;
    }

    int selectColumnarCalls() {
        return select_columnar_calls;
    }
}

class DataFrameTest inherits QUnit::Test {
    constructor() : Test("DataFrameTest", "1.0") {
        addTestCase("constructionTest", \constructionTest());
        addTestCase("typedApiMetadataTest", \typedApiMetadataTest());
        addTestCase("typeInferenceTest", \typeInferenceTest());
        addTestCase("metadataTest", \metadataTest());
        addTestCase("accessTest", \accessTest());
        addTestCase("pluginOperatorTest", \pluginOperatorTest());
        addTestCase("denseBufferColumnTest", \denseBufferColumnTest());
        addTestCase("roundTripTest", \roundTripTest());
        addTestCase("mutationTest", \mutationTest());
        addTestCase("describeTest", \describeTest());
        addTestCase("headTailSliceTest", \headTailSliceTest());
        addTestCase("nullHandlingTest", \nullHandlingTest());
        addTestCase("errorCasesTest", \errorCasesTest());
        addTestCase("selectTest", \selectTest());
        addTestCase("filterTest", \filterTest());
        addTestCase("sortByTest", \sortByTest());
        addTestCase("horizontalConcatTest", \horizontalConcatTest());
        addTestCase("columnarResultFilterTest", \columnarResultFilterTest());
        addTestCase("fillnaDropnaTest", \fillnaDropnaTest());
        addTestCase("valueCountsTest", \valueCountsTest());
        addTestCase("csvReadTest", \csvReadTest());
        addTestCase("csvWriteRoundTripTest", \csvWriteRoundTripTest());
        addTestCase("csvMissingValuesTest", \csvMissingValuesTest());
        addTestCase("dbQueryDispatchTest", \dbQueryDispatchTest());
        addTestCase("dbQueryTest", \dbQueryTest());
        addTestCase("mlIntegrationTest", \mlIntegrationTest());
        addTestCase("parquetTest", \parquetTest());
        addTestCase("arrowIpcTest", \arrowIpcTest());
        addTestCase("dataProviderTest", \dataProviderTest());
        addTestCase("dataProviderPipelineShapeTest", \dataProviderPipelineShapeTest());
        addTestCase("dataProviderDpqlShapeTest", \dataProviderDpqlShapeTest());
        addTestCase("bufferColumnsPipelineShapeTest", \bufferColumnsPipelineShapeTest());
        addTestCase("groupByTest", \groupByTest());
        addTestCase("groupByAggTest", \groupByAggTest());
        addTestCase("joinTest", \joinTest());
        addTestCase("pivotMeltTest", \pivotMeltTest());
        addTestCase("windowFunctionsTest", \windowFunctionsTest());

        set_return_value(main());
    }

    constructionTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        # Empty constructor
        DataFrame::DataFrame empty();
        assertEq(0, empty.numRows(), "empty DataFrame has 0 rows");
        assertEq(0, empty.numCols(), "empty DataFrame has 0 cols");

        # Construct from list<hash>
        DataFrame::DataFrame df(
            ({"x": 1, "y": 2.0},
             {"x": 3, "y": 4.0}));
        assertEq(2, df.numRows(), "from records: 2 rows");
        assertEq(2, df.numCols(), "from records: 2 cols");

        # Construct from hash of lists (column-oriented)
        DataFrame::DataFrame df2({"a": (1, 2, 3), "b": ("x", "y", "z")});
        assertEq(3, df2.numRows(), "from columns: 3 rows");
        assertEq(2, df2.numCols(), "from columns: 2 cols");
    }

    typedApiMetadataTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        Program p(PO_NEW_STYLE);
        p.parse("
%requires dataframe

sub typed_dataframe_api() {
    DataFrame::DataFrame df(({\"a\": 1}, {\"a\": 2}));
    hash<DataFrame::DataFrameShape> shape = df.shape();
    DataFrame::DataFrame head = df.head(1);
    DataFrame::DataFrame tail = df.tail(1);
    DataFrame::DataFrame sliced = df.slice(0, 1);
    DataFrame::DataFrame selected = df.select((\"a\",));
    DataFrame::DataFrame filtered = df.filter(\"a\", \">\", 0);
    DataFrame::DataFrame sorted = df.sortBy((\"a\",));
    DataFrame::DataFrame filled = df.fillna(0);
    DataFrame::DataFrame clean = df.dropna();
    DataFrame::DataFrame with_col = df.withColumn(\"b\", (3, 4));
    buffer<int64> dense = df.getColumnBuffer(\"a\");
    auto columnar = df.toColumnarResult();
    DataFrame::DataFrame from_columnar = DataFrame::DataFrame::fromColumnarResult(columnar);
    DataFrame::DataFrame concatenated = DataFrame::DataFrame::concat((df, from_columnar));
    DataFrame::RowMask positive = df.column(\"a\") > 0;
    DataFrame::RowMask selected_mask = positive & (df.column(\"a\") != 2);
    DataFrame::RowMask either_mask = selected_mask | (df.column(\"a\") == 2);
    DataFrame::RowMask changed_mask = either_mask ^ selected_mask;
    DataFrame::RowMask inverted_mask = ~changed_mask;
    DataFrame::DataFrame masked = df.filter(inverted_mask);
    DataFrame::GroupedDataFrame grouped = df.groupBy((\"a\",));
    DataFrame::DataFrame counts = grouped.count();
    list<hash<DataFrame::ColumnStats>> stats = df.describe();
}
", "dataframe typed API");

%ifndef NoDataProviderDataFrame
        Program p3(PO_NEW_STYLE);
        p3.parse("
%requires DataProviderDataFrame

sub typed_dataframe_provider() {
    DataFrame::DataFrame df(({\"a\": 1}, {\"a\": 2}));
    DataProviderDataFrame::DataFrameDataProvider prov(df);
    AbstractDataProviderRecordIterator<hash<auto>> iter = prov.searchRecords();
    hash<auto> rec = iter.getValue();
}
", "dataframe provider typed API");
%endif

        Program p2(PO_NEW_STYLE);
        assertThrows("PARSE-TYPE-ERROR", \p2.parse(), ("
%requires dataframe

sub invalid_dataframe_api() {
    DataFrame::DataFrame df(({\"a\": 1},));
    string s = df.head(1);
}
", "dataframe typed API"));
    }

    typeInferenceTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"int_col": 42, "float_col": 3.14, "str_col": "hello",
              "bool_col": True},));

        list<string> types = df.dtypes();
        assertEq("int64", types[0], "int column detected as int64");
        assertEq("float64", types[1], "float column detected as float64");
        assertEq("string", types[2], "string column detected as string");
        assertEq("bool", types[3], "bool column detected as bool");

        # Mixed int+float → float64
        DataFrame::DataFrame df2({"mixed": (1, 2.5, 3)});
        assertEq("float64", df2.dtypes()[0], "mixed int+float → float64");
    }

    metadataTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"name": "Alice", "age": 30},
             {"name": "Bob",   "age": 25}));

        assertEq(("name", "age"), df.columnNames(), "column names");
        assertEq(("string", "int64"), df.dtypes(), "dtypes");

        hash<DataFrame::DataFrameShape> s = df.shape();
        assertEq(2, s.rows, "shape rows");
        assertEq(2, s.cols, "shape cols");
    }

    accessTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"a": 10, "b": "x"},
             {"a": 20, "b": "y"},
             {"a": 30, "b": "z"}));

        # getColumn
        assertEq((10, 20, 30), df.getColumn("a"), "getColumn int");
        assertEq(("x", "y", "z"), df.getColumn("b"), "getColumn string");

        # getRow
        hash<auto> row = df.getRow(1);
        assertEq(20, row.a, "getRow a");
        assertEq("y", row.b, "getRow b");
    }

    pluginOperatorTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"id": 1, "name": "Alice", "score": 95.5},
             {"id": 2, "name": "Bob",   "score": 88.0},
             {"id": 3, "name": "Carol", "score": 92.0},
             {"id": 4, "name": "Dave",  "score": 79.0}));

        assertEq((1, 2, 3, 4), df["id"], "string subscript returns a column");
        hash<auto> row = df[2];
        assertEq("Carol", row.name, "integer subscript returns a row");
        assertEq(92.0, row.score, "integer subscript preserves row values");

        DataFrame::DataFrame middle = df[1..2];
        assertEq(2, middle.numRows(), "range subscript returns a DataFrame");
        assertEq(("Bob", "Carol"), middle["name"], "range subscript keeps inclusive order");

        DataFrame::DataFrame reverse = df[2..1];
        assertEq(("Carol", "Bob"), reverse["name"], "reverse range subscript is supported");

        assertEq(("Alice", "Bob"), df[..1]["name"], "open-start range subscript is supported");
        assertEq(("Carol", "Dave"), df[2..]["name"], "open-end range subscript is supported");
        assertEq(0, df[99..100].numRows(), "range subscript outside row bounds is empty");

        DataFrame::ColumnRef score = df.column("score");
        assertEq("score", score.name(), "column() returns a named ColumnRef");
        assertEq((95.5, 88.0, 92.0, 79.0), score.values(), "ColumnRef values() returns the source column");

        DataFrame::RowMask high_scores = score >= 90.0;
        assertEq((True, False, True, False), high_scores.toList(), "ColumnRef comparison returns a RowMask");
        assertEq(4, high_scores.size(), "RowMask size tracks DataFrame rows");
        assertEq(2, high_scores.count(), "RowMask count tracks selected rows");
        assertEq(("Alice", "Carol"), df[high_scores]["name"], "RowMask subscript filters rows");

        DataFrame::DataFrame bob = df.filter(df.column("name") == "Bob");
        assertEq((2,), bob["id"], "filter(RowMask) accepts equality predicates");

        DataFrame::RowMask not_bob = df.column("name") != "Bob";
        assertEq((True, False, True, True), not_bob.toList(), "not-equals predicates are supported");

        DataFrame::RowMask current = df.column("id") <= 3;
        DataFrame::RowMask high_and_current = high_scores & current;
        assertEq((True, False, True, False), high_and_current.toList(), "RowMask & intersects predicates");
        assertEq(("Alice", "Carol"), df[high_and_current]["name"], "RowMask & filters once with a composite mask");

        DataFrame::RowMask low_scores = score < 90.0;
        DataFrame::RowMask low_or_carol = low_scores | (df.column("name") == "Carol");
        assertEq((False, True, True, True), low_or_carol.toList(), "RowMask | unions predicates");

        DataFrame::RowMask high_xor_carol = high_scores ^ (df.column("name") == "Carol");
        assertEq((True, False, False, False), high_xor_carol.toList(), "RowMask ^ selects exactly one predicate");

        DataFrame::RowMask not_high = ~high_scores;
        assertEq((False, True, False, True), not_high.toList(), "RowMask ~ inverts predicates");
        DataFrame::RowMask explicit_mask((True, False, True, False));
        assertEq(("Alice", "Carol"), df[explicit_mask]["name"],
            "RowMask constructor accepts explicit boolean masks");

        assertEq(high_and_current.toList(), high_scores.intersect(current).toList(),
            "RowMask intersect() matches &");
        assertEq(low_or_carol.toList(), low_scores.unionWith(df.column("name") == "Carol").toList(),
            "RowMask unionWith() matches |");
        assertEq(high_xor_carol.toList(), high_scores.symmetricDifference(df.column("name") == "Carol").toList(),
            "RowMask symmetricDifference() matches ^");
        assertEq(not_high.toList(), high_scores.invert().toList(), "RowMask invert() matches ~");

        DataFrame::DataFrame short_df(({"id": 1}, {"id": 2}));
        assertThrows("DATAFRAME-ROWMASK-ERROR", \high_scores.intersect(), (short_df.column("id") > 0,),
            "mismatched RowMask lengths are rejected");

        DataFrame::DataFrame missing(
            ({"id": 1, "value": 10},
             {"id": 2, "value": NOTHING},
             {"id": 3, "value": 20}));
        assertEq((2,), missing[missing.column("value") == NOTHING]["id"], "NOTHING equality matches null rows");
        assertEq((1, 3), missing[missing.column("value") != NOTHING]["id"], "NOTHING inequality excludes null rows");
    }

    denseBufferColumnTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        buffer<int64> ids = new buffer<int64>((1001, 1002, 1003));
        buffer<float64> scores = new buffer<float64>((95.5, 88.0, 92.0));
        buffer<*string> names = new buffer<*string>(("Alice", "Bob", "Carol"));
        DataFrame::DataFrame df({"id": ids, "score": scores, "name": names});

        assertEq((1001, 1002, 1003), df.getColumn("id"), "buffer constructor preserves column values");
        assertEq((1001, 1002, 1003), df.getColumnBuffer("id").toList(),
            "getColumnBuffer returns dense integer values");
        assertEq((95.5, 88.0, 92.0), df.getColumnBuffer("score").toList(),
            "getColumnBuffer returns dense float values");
        assertEq(("Alice", "Bob", "Carol"), df.getColumnBuffer("name").toList(),
            "getColumnBuffer returns dense string values");
        assertEq(("Bob", "Carol"), names.view(start: 1, count: 2).toList(),
            "buffer<string> views preserve offsets");
        names[1] = "Bobby";
        assertEq(("Alice", "Bob", "Carol"), df.getColumnBuffer("name").toList(),
            "buffer-backed string DataFrame columns follow buffer copy-on-write semantics");
        ids[0] = 9999;
        assertEq((1001, 1002, 1003), df.getColumnBuffer("id").toList(),
            "buffer-backed DataFrame columns follow buffer copy-on-write semantics");
        DataFrame::DataFrame filtered_df = df.filter(df.column("id").compare(">=", 1002));
        assertEq((1002, 1003), filtered_df.getColumnBuffer("id").toList(),
            "filtered buffer-backed DataFrame columns remain dense");

        auto result = df.toColumnarResult();
        assertEq("ColumnarResult", result.className(), "toColumnarResult returns a ColumnarResult");
        assertEq((1001, 1002, 1003), result.getColumn("id").toList(),
            "ColumnarResult preserves dense integer column");
        assertEq(("Alice", "Bob", "Carol"), result.getColumn("name").toList(),
            "ColumnarResult preserves dense string column");

        DataFrame::DataFrame roundtrip = DataFrame::DataFrame::fromColumnarResult(result);
        assertEq((1001, 1002, 1003), roundtrip.getColumnBuffer("id").toList(),
            "fromColumnarResult preserves dense columns");
        assertEq(("Alice", "Bob", "Carol"), roundtrip.getColumnBuffer("name").toList(),
            "fromColumnarResult preserves dense string columns");
    }

    roundTripTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        list<hash<auto>> original = (
            {"x": 1, "y": "a"},
            {"x": 2, "y": "b"},
            {"x": 3, "y": "c"},
        );

        DataFrame::DataFrame df(original);
        list<hash<auto>> result = df.toRecords();

        assertEq(3, result.size(), "round-trip preserves row count");
        assertEq(1, result[0].x, "round-trip preserves int value");
        assertEq("b", result[1].y, "round-trip preserves string value");

        # Column hash round-trip
        hash<auto> cols = df.toColumnHash();
        assertEq((1, 2, 3), cols.x, "toColumnHash x");
        assertEq(("a", "b", "c"), cols.y, "toColumnHash y");
    }

    mutationTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(({"a": 1}, {"a": 2}));

        # addColumn
        df.addColumn("b", (10, 20));
        assertEq(("a", "b"), df.columnNames(), "addColumn adds column");
        assertEq((10, 20), df.getColumn("b"), "addColumn values correct");

        # renameColumn
        df.renameColumn("b", "c");
        assertEq(("a", "c"), df.columnNames(), "renameColumn works");

        # dropColumn
        df.dropColumn("c");
        assertEq(("a",), df.columnNames(), "dropColumn removes column");

        # Error: duplicate column
        assertThrows("DATAFRAME-COLUMN-ERROR", \df.addColumn(), ("a", (1, 2)),
            "addColumn duplicate throws");

        # Error: drop non-existent
        assertThrows("DATAFRAME-COLUMN-ERROR", \df.dropColumn(), ("nonexistent",),
            "dropColumn missing throws");
    }

    describeTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"val": 10.0, "name": "a"},
             {"val": 20.0, "name": "b"},
             {"val": 30.0, "name": "c"},
             {"val": 40.0, "name": "a"}));

        list<hash<DataFrame::ColumnStats>> stats = df.describe();
        assertEq(2, stats.size(), "describe returns stats for all columns");

        # Numeric column stats
        hash<auto> val_stats = stats[0];
        assertEq("val", val_stats.name, "describe name");
        assertEq(4, val_stats.count, "describe count");
        assertEq(0, val_stats.null_count, "describe null_count");
        # mean of 10, 20, 30, 40 = 25
        float delta = abs(val_stats.mean - 25.0);
        assertTrue(delta < 0.01, "describe mean ≈ 25");
        assertEq(10.0, val_stats.min, "describe min");
        assertEq(40.0, val_stats.max, "describe max");

        # String column stats
        hash<auto> name_stats = stats[1];
        assertEq("name", name_stats.name, "describe string name");
        assertEq(3, name_stats.unique_count, "describe unique_count");
    }

    headTailSliceTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"v": 1}, {"v": 2}, {"v": 3}, {"v": 4}, {"v": 5}));

        auto h = df.head(2);
        assertEq(2, h.numRows(), "head(2) rows");
        assertEq((1, 2), h.getColumn("v"), "head(2) values");

        auto t = df.tail(2);
        assertEq(2, t.numRows(), "tail(2) rows");
        assertEq((4, 5), t.getColumn("v"), "tail(2) values");

        auto s = df.slice(1, 4);
        assertEq(3, s.numRows(), "slice(1,4) rows");
        assertEq((2, 3, 4), s.getColumn("v"), "slice(1,4) values");

        # Default head/tail (5 rows, but only 5 available)
        auto h5 = df.head();
        assertEq(5, h5.numRows(), "head() default 5");

        DataFrame::DataFrame dense_df({"v": new buffer<int64>((1, 2, 3, 4, 5))});
        assertEq((1, 2), dense_df.head(2).getColumnBuffer("v").toList(),
            "head() preserves dense buffer-backed columns");
        assertEq((2, 3, 4), dense_df.slice(1, 4).getColumnBuffer("v").toList(),
            "slice() preserves dense buffer-backed columns");
    }

    nullHandlingTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"a": 1, "b": "x"},
             {"a": NOTHING, "b": "y"},
             {"a": 3, "b": NOTHING}));

        # Nulls in getColumn
        list<auto> a_vals = df.getColumn("a");
        assertEq(1, a_vals[0], "null handling: first value present");
        assertEq(NOTHING, a_vals[1], "null handling: NOTHING preserved");
        assertEq(3, a_vals[2], "null handling: third value present");

        # Nulls in getRow
        hash<auto> row = df.getRow(1);
        assertEq(NOTHING, row.a, "null in row hash");
        assertEq("y", row.b, "non-null in row hash");

        # Describe with nulls
        list<hash<DataFrame::ColumnStats>> stats = df.describe();
        hash<auto> a_stats = stats[0];
        assertEq(2, a_stats.count, "describe count excludes nulls");
        assertEq(1, a_stats.null_count, "describe null_count");
    }

    selectTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"a": 1, "b": "x", "c": 10.0},
             {"a": 2, "b": "y", "c": 20.0},
             {"a": 3, "b": "z", "c": 30.0}));

        auto sel = df.select(("a", "c"));
        assertEq(3, sel.numRows(), "select preserves rows");
        assertEq(2, sel.numCols(), "select reduces columns");
        assertEq(("a", "c"), sel.columnNames(), "select column names");
        assertEq((1, 2, 3), sel.getColumn("a"), "select values preserved");
    }

    filterTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"name": "Alice", "age": 30, "score": 95.5},
             {"name": "Bob",   "age": 25, "score": 88.0},
             {"name": "Carol", "age": 35, "score": 92.0},
             {"name": "Dave",  "age": 28, "score": 78.0}));

        # Numeric comparison
        auto older = df.filter("age", ">=", 30);
        assertEq(2, older.numRows(), "filter >= 30 returns 2 rows");
        assertEq(("Alice", "Carol"), older.getColumn("name"), "filter >= values");

        # String equality
        auto bob = df.filter("name", "==", "Bob");
        assertEq(1, bob.numRows(), "filter string ==");
        assertEq(25, bob.getColumn("age")[0], "filter string == value");

        # String contains
        auto has_a = df.filter("name", "contains", "a");
        # "Carol" and "Dave" contain lowercase 'a'
        assertEq(2, has_a.numRows(), "filter contains");

        # No matches
        auto none = df.filter("age", ">", 100);
        assertEq(0, none.numRows(), "filter no matches");

        # Null filter
        DataFrame::DataFrame df2(
            ({"a": 1, "b": "x"},
             {"a": NOTHING, "b": "y"},
             {"a": 3, "b": NOTHING}));
        auto nulls = df2.filter("a", "is_null", 0);
        assertEq(1, nulls.numRows(), "filter is_null");
        auto non_nulls = df2.filter("a", "not_null", 0);
        assertEq(2, non_nulls.numRows(), "filter not_null");
    }

    sortByTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"name": "Carol", "age": 35},
             {"name": "Alice", "age": 30},
             {"name": "Bob",   "age": 25}));

        # Sort ascending
        auto sorted = df.sortBy(("age",));
        assertEq((25, 30, 35), sorted.getColumn("age"), "sort ascending");
        assertEq(("Bob", "Alice", "Carol"), sorted.getColumn("name"),
            "sort carries other columns");

        # Sort descending
        auto desc = df.sortBy(("age",), (False,));
        assertEq((35, 30, 25), desc.getColumn("age"), "sort descending");

        # Sort by string
        auto alpha = df.sortBy(("name",));
        assertEq(("Alice", "Bob", "Carol"), alpha.getColumn("name"), "sort string");
    }

    horizontalConcatTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame left({"id": new buffer<int64>((1, 2, 3)), "name": ("Ada", "Bo", "Cy")});
        DataFrame::DataFrame right({"score": new buffer<float64>((90.0, 80.0, 70.0)), "active": (True, False, True)});

        DataFrame::DataFrame combined = DataFrame::DataFrame::concat((left, right), 1);
        assertEq(3, combined.numRows(), "horizontal concat preserves row count");
        assertEq(("id", "name", "score", "active"), combined.columnNames(),
            "horizontal concat preserves column order");
        assertEq((1, 2, 3), combined.getColumnBuffer("id").toList(),
            "horizontal concat preserves dense left columns");
        assertEq((90.0, 80.0, 70.0), combined.getColumnBuffer("score").toList(),
            "horizontal concat preserves dense right columns");

        DataFrame::DataFrame short({"other": (1, 2)});
        assertThrows("DATAFRAME-ERROR", sub () {
            auto ignored = DataFrame::DataFrame::concat((left, short), 1);
        }, NOTHING,
            "horizontal concat rejects row-count mismatch");

        DataFrame::DataFrame duplicate({"id": (4, 5, 6)});
        assertThrows("DATAFRAME-COLUMN-ERROR", sub () {
            auto ignored = DataFrame::DataFrame::concat((left, duplicate), 1);
        }, NOTHING,
            "horizontal concat rejects duplicate column names");
    }

    columnarResultFilterTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df({
            "id": new buffer<int64>((1, 2, 3, 4)),
            "segment": new buffer<int64>((1, 1, 2, 2)),
            "amount": new buffer<float64>((90.0, 220.0, 180.0, 125.0)),
            "name": ("Alice", "Bob", "Carol", "Dave"),
            "code": ("A1", "B2", "C1", "D4"),
        });

        auto result = df.toColumnarResult();
        auto filtered = result.filter(result.getColumn("amount") >= 125.0);
        assertEq((2, 3, 4), filtered.getColumn("id").toList(),
            "ColumnarResult::filter accepts dense boolean masks");
        assertEq(("Bob", "Carol", "Dave"), filtered.getColumn("name").toList(),
            "ColumnarResult::filter preserves dense string columns");

        auto amount_mask = result.getColumn("amount") >= 125.0;
        auto not_carol = result.getColumn("id") != 3;
        auto combined = result.combineMasks(amount_mask, not_carol, "&&");
        assertEq("buffer<bool>", combined.fullType(), "ColumnarResult::combineMasks returns a dense mask");
        assertEq((2, 4), result.filter(combined).getColumn("id").toList(),
            "ColumnarResult::combineMasks intersects dense masks");
        assertEq((1,), result.filter(result.invertMask(amount_mask)).getColumn("id").toList(),
            "ColumnarResult::invertMask inverts dense masks");

        DataFrame::DataFrame nullable_df({
            "id": new buffer<int64>((1, 2, 3, 4)),
            "optional_id": new buffer<*int64>((10, NOTHING, 30, NOTHING)),
        });
        auto nullable_result = nullable_df.toColumnarResult();
        assertEq((2, 4), nullable_result.filter(nullable_result.nullMask("optional_id")).getColumn("id").toList(),
            "ColumnarResult::nullMask selects null dense-buffer rows");
        assertEq((1, 3), nullable_result.filter(nullable_result.nullMask("optional_id", True)).getColumn("id").toList(),
            "ColumnarResult::nullMask can select non-null dense-buffer rows");
        assertEq((1, 3, 4), result.filter(result.stringPredicateMask("name", "contains", "a", True)).getColumn("id").toList(),
            "ColumnarResult::stringPredicateMask selects matching string rows");
        assertEq((1, 3), result.filter(result.stringPredicateMask("code", "contains", 1)).getColumn("id").toList(),
            "ColumnarResult::stringPredicateMask converts predicate values with softstring rules");

        assertThrows("COLUMNAR-RESULT-ERROR", \result.filter(), (new buffer<int64>((1, 0, 1, 0)),),
            "ColumnarResult::filter rejects non-boolean buffers as masks");
    }

    fillnaDropnaTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(
            ({"a": 1,       "b": "x"},
             {"a": NOTHING, "b": "y"},
             {"a": 3,       "b": NOTHING}));

        # fillna
        auto filled = df.fillna(0);
        assertEq(3, filled.numRows(), "fillna preserves rows");
        assertEq((1, 0, 3), filled.getColumn("a"), "fillna replaces int nulls");
        assertEq(("x", "y", "0"), filled.getColumn("b"), "fillna replaces string nulls");

        # dropna
        auto dropped = df.dropna();
        assertEq(1, dropped.numRows(), "dropna keeps only complete rows");
        assertEq(1, dropped.getColumn("a")[0], "dropna correct row");
        assertEq("x", dropped.getColumn("b")[0], "dropna correct row value");
    }

    valueCountsTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df({
            "region": ("north", "south", "north", "west", "south", "south", NOTHING),
            "score": (10.0, 20.0, 10.0, 30.0, 20.0, 20.0, NOTHING),
            "flag": (True, False, True, True, False, False, NOTHING),
        });

        DataFrame::DataFrame counts = df.valueCounts("region");
        assertEq(("north", "south", "west"), counts.getColumn("region"),
            "valueCounts excludes nulls by default");
        assertEq((2, 3, 1), counts.getColumn("count"),
            "valueCounts preserves first-seen order by default");

        DataFrame::DataFrame sorted_counts = df.valueCounts("region", sort_desc: True);
        assertEq(("south", "north", "west"), sorted_counts.getColumn("region"),
            "valueCounts can sort by descending count");
        assertEq((3, 2, 1), sorted_counts.getColumn("count"),
            "valueCounts sorted counts are correct");

        DataFrame::DataFrame with_null = df.valueCounts("region", dropna: False, count_name: "n");
        assertEq(4, with_null.numRows(), "valueCounts can include nulls");
        assertEq((2, 3, 1, 1), with_null.getColumn("n"),
            "valueCounts counts null values when requested");

        assertEq(3, df.nunique("region"), "nunique excludes nulls by default");
        assertEq(4, df.nunique("region", dropna: False), "nunique can include nulls");
        assertEq(3, df.nunique("score"), "nunique handles numeric columns");
        assertEq(2, df.nunique("flag"), "nunique handles bool columns");
        DataFrame::DataFrame flag_counts = df.valueCounts("flag");
        assertEq((True, False), flag_counts.getColumn("flag"),
            "valueCounts preserves first-seen order for bool columns");

        DataFrame::DataFrame count_name_df({"count": ("a", "a", "b")});
        DataFrame::DataFrame count_name_counts = count_name_df.valueCounts("count");
        assertEq(("count", "value_count"), count_name_counts.columnNames(),
            "valueCounts avoids duplicate default count column names");
        assertEq((2, 1), count_name_counts.getColumn("value_count"),
            "valueCounts duplicate-name fallback counts correctly");
    }

    errorCasesTest() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%endif
        DataFrame::DataFrame df(({"a": 1}, {"a": 2}));

        # Column not found
        assertThrows("DATAFRAME-COLUMN-ERROR", \df.getColumn(), ("nonexistent",),
            "getColumn missing column");

        # Row index out of range
        assertThrows("DATAFRAME-INDEX-ERROR", \df.getRow(), (99,),
            "getRow out of range");

        # Mismatched column lengths
        bool caught = False;
        try {
            new DataFrame::DataFrame({"a": (1, 2), "b": (1, 2, 3)});
        } catch (hash<ExceptionInfo> ex) {
            assertEq("DATAFRAME-ERROR", ex.err, "mismatched column lengths");
            caught = True;
        }
        assertTrue(caught, "mismatched column lengths throws");

        # addColumn row count mismatch
        assertThrows("DATAFRAME-COLUMN-ERROR", \df.addColumn(), ("b", (1, 2, 3)),
            "addColumn row mismatch");

        # Invalid filter operator
        assertThrows("DATAFRAME-FILTER-ERROR", \df.filter(), ("a", "LIKE", 1),
            "invalid filter operator");
    }

