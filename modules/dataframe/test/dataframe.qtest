        assertEq(get_duration_microseconds(dur2), duration_columns.getColumn("elapsed")[2],
            "dense duration buffer preserves larger relative microsecond values");
        assertEq(get_duration_microseconds(dur0), get_duration_microseconds(duration_columns.toRows()[0].elapsed),
            "ColumnarResult row materialization restores duration date values");
        DataFrame::DataFrame duration_df = DataFrame::DataFrame::fromColumnarResult(duration_columns);
        assertEq("date", duration_df.dtypes()[0],
            "DataFrame consumes dense duration columns as date columns");
        assertEq(get_duration_microseconds(dur0), get_duration_microseconds(duration_df.getColumn("elapsed")[0]),
            "DataFrame date column preserves dense duration values");
        ColumnarResult duration_roundtrip = duration_df.toColumnarResult();
