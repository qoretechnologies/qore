#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

/*  dataframe-duration-export.qtest Copyright 2026 Qore Technologies, s.r.o.
    MIT License
*/

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"

%requires QUnit

%requires dataframe

%exec-class DataFrameDurationExportTest

#! A duration or timestamp column is exported in the time unit of its schema with the values it holds (qore#6102)
class DataFrameDurationExportTest inherits QUnit::Test {
    constructor() : Test("DataFrameDurationExportTest", "1.0", \ARGV) {
        addTestCase("Arrow IPC round trip", \roundTripTest());
        addTestCase("timestamps in nanoseconds", \nanoTimestampTest());
        set_return_value(main());
    }

    #! a timestamp in nanoseconds is exported if it fits in an int64, and raises an error if not, instead of wrapping
    nanoTimestampTest() {
        DataFrame::DataFrame in_range = timestampFrame((2024-01-01T10:00:00.123456Z, 1677-09-22T00:12:44Z));
        list<auto> exported = DataFrame::DataFrame::fromArrowIpc(in_range.toArrowIpc()).getColumn("v");
        assertTrue(exported[0] == 2024-01-01T10:00:00.123456Z && exported[1] == 1677-09-22T00:12:44Z,
            sprintf("timestamps in the range: %y", exported));
        foreach date d in ((2300-01-01T00:00:00Z, 1600-01-01T00:00:00Z)) {
            DataFrame::DataFrame df = timestampFrame((d,));
            assertThrows("DATAFRAME-IO-ERROR", \df.toArrowIpc(), (), sprintf("%y", d));
        }
    }

    private DataFrame::DataFrame timestampFrame(list<auto> values) {
        return DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "v": values,
        }, {
            "v": {"schema": {"kind": "timestamp", "time_unit": "ns", "timezone": "UTC", "nullable": True}},
        }));
    }

    roundTripTest() {
        # the values in each time unit: a time unit of seconds keeps whole seconds
        hash<string, list<auto>> expected = {
            "s": (7s, 1s, NOTHING),
            "ms": (7s, 1500ms, NOTHING),
            "us": (7s, 1500ms, NOTHING),
            "ns": (7s, 1500ms, NOTHING),
        };
        # negative durations, which are not dense storage in a column made from a list of values
        foreach string unit in (("ms", "us", "ns")) {
            DataFrame::DataFrame df = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
                "v": (-1500ms, -7s),
            }, {
                "v": {"schema": {"kind": "duration", "time_unit": unit, "nullable": True}},
            }));
            list<auto> actual = DataFrame::DataFrame::fromArrowIpc(df.toArrowIpc()).getColumn("v");
            assertTrue(actual[0] == -1500ms && actual[1] == -7s, sprintf("%s: negative durations: %y", unit,
                actual));
        }
        foreach string unit in (keys expected) {
            DataFrame::DataFrame df = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
                "v": (7s, 1500ms, NOTHING),
            }, {
                "v": {"schema": {"kind": "duration", "time_unit": unit, "nullable": True}},
            }));
            list<auto> actual = DataFrame::DataFrame::fromArrowIpc(df.toArrowIpc()).getColumn("v");
            assertEq(3, actual.size(), unit + ": rows");
            foreach auto value in (expected{unit}) {
                if (exists value) {
                    assertTrue(actual[$#] == value, sprintf("%s: row %d: %y", unit, $#, actual[$#]));
                } else {
                    assertEq(NOTHING, actual[$#], sprintf("%s: row %d", unit, $#));
                }
            }
        }
    }
}
