#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

/*  dataframe-melt-types.qtest Copyright 2026 Qore Technologies, s.r.o.
    MIT License
*/

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"

%requires QUnit

%requires dataframe

%exec-class DataFrameMeltTypesTest

#! melt() keeps the types of its identifier columns and of non-numeric value columns (qore#6116)
class DataFrameMeltTypesTest inherits QUnit::Test {
    constructor() : Test("DataFrameMeltTypesTest", "1.0", \ARGV) {
        addTestCase("melt() of columns of any type", \meltTest());
        addTestCase("melt() of columns with schemas", \schemaTest());
        set_return_value(main());
    }

    #! melt() of identifier and value columns of every type
    meltTest() {
        # the issue: an int and a string value column
        DataFrame::DataFrame d(({"id": 1, "x": 10, "y": "s"}, {"id": 2, "x": 20, "y": "t"}));
        DataFrame::DataFrame m = d.melt(("id",), ("x", "y"));
        assertEq(("10", "s", "20", "t"), m.getColumn("value"), "int and string values");
        # identifier columns of every type keep their types and values
        DataFrame::DataFrame all({
            "b": (True, NOTHING),
            "d": (2024-01-01T00:00:00Z, 2024-01-02T00:00:00Z),
            "u": (1h, NOTHING),
            "a": (c'z', (1, 2)),
            "s": ("x", "y"),
            "f": (1.5, NOTHING),
            "v": (1, 2),
            "w": (3, 4),
        });
        m = all.melt(("b", "d", "u", "a", "s", "f"), ("v", "w"));
        assertEq(4, m.numRows());
        assertEq((True, True, NOTHING, NOTHING), m.getColumn("b"), "bool");
        list<auto> dates = m.getColumn("d");
        assertTrue(dates[0] == 2024-01-01T00:00:00Z && dates[3] == 2024-01-02T00:00:00Z, sprintf("dates: %y", dates));
        list<auto> durations = m.getColumn("u");
        assertTrue(is_date_relative(durations[0]) && durations[1] == 1h && !exists durations[2],
            sprintf("durations: %y", durations));
        assertEq((c'z', c'z', (1, 2), (1, 2)), m.getColumn("a"), "any value");
        assertEq(("x", "x", "y", "y"), m.getColumn("s"), "string");
        assertEq((1.5, 1.5, NOTHING, NOTHING), m.getColumn("f"), "float");
        assertEq((1.0, 3.0, 2.0, 4.0), m.getColumn("value"), "numeric values");
        # value columns of one type keep it; of durations, durations
        DataFrame::DataFrame dur({"id": (1, 2), "p": (1h, 2h), "q": (3h, NOTHING)});
        list<auto> dv = dur.melt(("id",)).getColumn("value");
        assertTrue(is_date_relative(dv[0]) && dv[0] == 1h && dv[2] == 2h && !exists dv[3],
            sprintf("duration values: %y", dv));
        DataFrame::DataFrame bools({"id": (1,), "p": (True,), "q": (False,)});
        assertEq((True, False), bools.melt(("id",)).getColumn("value"), "bool values");
        # values of a column that holds any value
        DataFrame::DataFrame anyv({"id": (1, 2), "p": (c'z', (1, 2)), "q": (1, 2)});
        assertEq((c'z', 1, (1, 2), 2), anyv.melt(("id",)).getColumn("value"), "any values");
        # an int and a bool value column make a string column, as the column hash constructor makes it
        DataFrame::DataFrame ib({"id": (1,), "x": (10,), "b": (True,)});
        assertEq(("10", "1"), ib.melt(("id",)).getColumn("value"), "int and bool values");
        # decimal value columns keep their values and type
        DataFrame::DataFrame dec = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "id": (1,), "p": (12345678901234567.89n,), "q": (2.5n,),
        }, {
            "p": {"schema": {"kind": "decimal128", "precision": 20, "scale": 2}},
            "q": {"schema": {"kind": "decimal128", "precision": 20, "scale": 2}},
        }));
        list<auto> dv2 = DataFrame::DataFrame::fromArrowIpc(dec.melt(("id",)).toArrowIpc()).getColumn("value");
        assertTrue(dv2[0] == 12345678901234567.89n && dv2[1] == 2.5n, sprintf("decimal values: %y", dv2));
        # an empty frame, and identifier columns only
        DataFrame::DataFrame empty({"id": (), "x": (), "y": ()});
        assertEq(0, empty.melt(("id",)).numRows(), "an empty frame");
        DataFrame::DataFrame ids({"id": (1, 2)});
        assertEq(0, ids.melt(("id",)).numRows(), "identifier columns only");
    }

    #! value columns of one type with different schemas: a common schema, or a column that holds any value
    schemaTest() {
        # decimals of different precisions and scales: a common decimal schema, which keeps every digit
        DataFrame::DataFrame dec = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "id": (1,), "p": (12345678901234567.89n,), "q": (2.5n,), "r": (1234567890123456789012.5n,),
        }, {
            "p": {"schema": {"kind": "decimal128", "precision": 20, "scale": 2}},
            "q": {"schema": {"kind": "decimal128", "precision": 22, "scale": 1}},
            "r": {"schema": {"kind": "decimal128", "precision": 23, "scale": 1}},
        }));
        DataFrame::DataFrame m = dec.melt(("id",), ("p", "q"));
        assertEq(("decimal128", 23, 2), schema(m, "value"){"kind", "precision", "scale"}.values(), "decimal schema");
        list<auto> v = DataFrame::DataFrame::fromArrowIpc(m.toArrowIpc()).getColumn("value");
        assertTrue(v[0] == 12345678901234567.89n && v[1] == 2.5n, sprintf("decimal values: %y", v));
        # decimals whose common schema would have more than 38 digits: a column that holds the exact numbers
        m = dec.melt(("id",), ("p", "r"));
        assertEq("auto", m.dtypes()[2], "more than 38 digits");
        assertEq((12345678901234567.89n, 1234567890123456789012.5n), m.getColumn("value"), "exact numbers");
        # float32 value columns keep their schema
        string dir = get_script_dir() + DirSep + "data" + DirSep;
        DataFrame::DataFrame f32 = DataFrame::DataFrame::readParquet(dir + "dense_float32.parquet");
        f32.addColumn("k", (1, 2, 3, 4, 5, 6));
        DataFrame::DataFrame f2 = f32.join(f32, ("k",));
        m = f2.melt(("k",), ("v", "v_right"));
        assertEq(schema(f32, "v"), schema(m, "value"), "float32 values");
        # timestamps of different units: microseconds
        DataFrame::DataFrame ts = DataFrame::DataFrame::fromColumnarResult(ColumnarResult::fromColumnHash({
            "id": (1,), "a": (2024-01-01T10:00:00.5Z,), "b": (2024-01-02T10:00:00Z,),
        }, {
            "a": {"schema": {"kind": "timestamp", "time_unit": "ms", "timezone": "UTC", "nullable": True}},
            "b": {"schema": {"kind": "timestamp", "time_unit": "s", "timezone": "UTC", "nullable": True}},
        }));
        m = ts.melt(("id",));
        assertEq("us", schema(m, "value").time_unit, "timestamp unit");
        list<auto> tv = DataFrame::DataFrame::fromArrowIpc(m.toArrowIpc()).getColumn("value");
        assertTrue(tv[0] == 2024-01-01T10:00:00.5Z && tv[1] == 2024-01-02T10:00:00Z, sprintf("timestamps: %y", tv));
    }

    #! returns the columnar schema of a column: its kind, element type, precision, scale, time unit and zone
    private hash<auto> schema(DataFrame::DataFrame df, string name) {
        foreach hash<auto> column in (df.toColumnarResult().schemaV2()) {
            if (column.name == name) {
                return column{"kind", "buffer_type", "precision", "scale", "time_unit", "timezone"};
            }
        }
        return {};
    }
}
