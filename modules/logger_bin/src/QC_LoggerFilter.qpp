#include "qore_logger.h"

#include "QC_LoggerFilter.h"
#include "QC_LoggerEvent.h"

class QoreLoggerFilter : public AbstractPrivateData {
public:
    DLLLOCAL QoreLoggerFilter() {
    }

    DLLLOCAL virtual ~QoreLoggerFilter() = default;
};

//! Abstract class that defines the interface for logger filters
/** Event data (@ref LoggerEvent) are formatted before the record is passed to the target
*/
qclass LoggerFilter [ns=Qore::Logger; arg=QoreLoggerFilter* ll];

//! Creates the object
/**
*/
LoggerFilter::constructor() {
    self->setPrivate(CID_LOGGERFILTER, new QoreLoggerFilter);
}

//! Performs filtering logic on an event and returns the decision for the event
/**
    The method should be overridden to implement a real rule. The default result is \c NEUTRAL

    @param event the log event

    @return the result of evaluating the event (the default for this method is \c NEUTRAL)
*/
int LoggerFilter::eval(LoggerEvent[QoreLoggerEvent] event) {
    ReferenceHolder<AbstractPrivateData> holder(event, xsink);
    return NEUTRAL;
}
