%modern

%requires ../../../qlib/Util.qm
%requires ../../../qlib/QUnit.qm

%prepend-module-path "${SCRIPT_DIR}/../../../build/modules/tokenizer"

%requires json

%try-module tokenizer
%define NoTokenizer
%endtry

%exec-class TokenizerTest

class TokenizerTest inherits QUnit::Test {
    constructor() : Test("TokenizerTest", "1.0") {
        addTestCase("basicWordPiece", \basicWordPieceTest());
        addTestCase("bertTokenizer", \bertTokenizerTest());
        addTestCase("encodeDecodeRoundTrip", \encodeDecodeRoundTripTest());
        addTestCase("emptyInput", \emptyInputTest());
        addTestCase("unicodeInput", \unicodeInputTest());
        addTestCase("vocabLookup", \vocabLookupTest());
        addTestCase("skipSpecialTokens", \skipSpecialTokensTest());
        addTestCase("errorCases", \errorCasesTest());
        addTestCase("gpt2Tokenizer", \gpt2TokenizerTest());
        addTestCase("t5Tokenizer", \t5TokenizerTest());
        addTestCase("gpt2Decode", \gpt2DecodeTest());
        addTestCase("gpt4StyleSplitTokenizer", \gpt4StyleSplitTokenizerTest());
        addTestCase("splitBehavior", \splitBehaviorTest());
        addTestCase("llamaTokenizer", \llamaTokenizerTest());
        addTestCase("bertSentencePair", \bertSentencePairTest());
        addTestCase("truncationTest", \truncationTest());
        addTestCase("paddingTest", \paddingTest());
        addTestCase("batchEncodingTest", \batchEncodingTest());
        addTestCase("modelInputTensorBatchTest", \modelInputTensorBatchTest());
        addTestCase("unicodeDigitTest", \unicodeDigitTest());
        addTestCase("replaceRegexNormalizerTest", \replaceRegexNormalizerTest());
        addTestCase("decoderCleanupTest", \decoderCleanupTest());
        addTestCase("wordIdsTest", \wordIdsTest());
        addTestCase("addTokensTest", \addTokensTest());
        addTestCase("preTokenizedTest", \preTokenizedTest());
        addTestCase("slidingWindowTest", \slidingWindowTest());
        addTestCase("NUL characters in text and tokens", \nulTextTest());
        addTestCase("NUL characters in tokenizer configurations", \nulConfigTest());
        addTestCase("added tokens have their token strings", \addedTokenStringTest());
        addTestCase("chat templates", \chatTemplateTest());
        addTestCase("chat template values are not template text", \chatTemplateInjectionTest());
        addTestCase("configuration loaded while it is read", \concurrentConfigTest());
        addTestCase("added tokens are looked up before the model vocabulary", \addedTokenPrecedenceTest());

        set_return_value(main());
    }

    private Tokenizer::HFTokenizer createMinimalWordPiece() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        hash<auto> config = {
            "model": {
                "type": "WordPiece",
                "vocab": {
                    "[PAD]": 0, "[UNK]": 1, "[CLS]": 2, "[SEP]": 3,
                    "hello": 4, "world": 5, ",": 6, "!": 7,
                    "##s": 8, "##ed": 9, "the": 10, "a": 11,
                },
                "unk_token": "[UNK]",
                "continuing_subword_prefix": "##",
            },
            "added_tokens": (
                {"id": 0, "content": "[PAD]", "special": True},
                {"id": 1, "content": "[UNK]", "special": True},
                {"id": 2, "content": "[CLS]", "special": True},
                {"id": 3, "content": "[SEP]", "special": True},
            ),
            "post_processor": {
                "type": "BertProcessing",
                "sep": ("[SEP]", 3),
                "cls": ("[CLS]", 2),
            },
            "decoder": {
                "type": "WordPiece",
                "prefix": "##",
                "cleanup": True,
            },
        };
        return new Tokenizer::HFTokenizer(config);
    }

    basicWordPieceTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        Tokenizer::HFTokenizer tok = createMinimalWordPiece();

        assertEq(12, tok.getVocabSize(), "vocab size should be 12");
        assertEq(4, tok.tokenToId("hello"), "hello should be ID 4");
        assertEq("hello", tok.idToToken(4), "ID 4 should be hello");
        assertEq(-1, tok.tokenToId("nonexistent"), "unknown token returns -1");
    }

    bertTokenizerTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        # Load real BERT tokenizer
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/bert-base-uncased-tokenizer.json");
        hash<auto> config = parse_json(json_str);
        Tokenizer::HFTokenizer tok(config);

        assertEq(30522, tok.getVocabSize(), "BERT vocab size");

        # Test known BERT tokenization
        hash<auto> enc = tok.encode("Hello, world!");
        # Expected: [CLS]=101 hello=7592 ,=1010 world=2088 !=999 [SEP]=102
        assertEq(6, enc.input_ids.size(), "should produce 6 tokens");
        assertEq(101, enc.input_ids[0], "[CLS] should be 101");
        assertEq(7592, enc.input_ids[1], "hello should be 7592");
        assertEq(1010, enc.input_ids[2], ", should be 1010");
        assertEq(2088, enc.input_ids[3], "world should be 2088");
        assertEq(999, enc.input_ids[4], "! should be 999");
        assertEq(102, enc.input_ids[5], "[SEP] should be 102");

        # Test subword tokenization
        hash<auto> enc2 = tok.encode("unhappiness");
        assertTrue(enc2.input_ids.size() > 3,
            "unhappiness should be split into subwords + [CLS] + [SEP]");
    }

    encodeDecodeRoundTripTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/bert-base-uncased-tokenizer.json");
        Tokenizer::HFTokenizer tok(parse_json(json_str));

        # Encode then decode (with special tokens skipped)
        string input = "the quick brown fox jumps over the lazy dog";
        hash<auto> enc = tok.encode(input);
        string decoded = tok.decode(enc.input_ids, True);
        # After lowercase normalization + skip special tokens
        assertEq(input, trim(decoded),
            "round-trip should preserve content after normalization");
    }

    emptyInputTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        Tokenizer::HFTokenizer tok = createMinimalWordPiece();

        # Empty string should produce only special tokens
        hash<auto> enc = tok.encode("");
        assertTrue(enc.input_ids.size() >= 0,
            "empty input should not crash");
    }

    unicodeInputTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/bert-base-uncased-tokenizer.json");
        Tokenizer::HFTokenizer tok(parse_json(json_str));

        # CJK characters should be handled by BertNormalizer
        hash<auto> enc = tok.encode("Hello 世界");
        assertTrue(enc.input_ids.size() > 2,
            "CJK input should tokenize without crash");

        # Emoji
        hash<auto> enc2 = tok.encode("Hello 🌍");
        assertTrue(enc2.input_ids.size() > 2,
            "emoji input should tokenize without crash");

        # Accented characters
        hash<auto> enc3 = tok.encode("café résumé naïve");
        assertTrue(enc3.input_ids.size() > 2,
            "accented input should tokenize without crash");
    }

    replaceRegexNormalizerTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        hash<auto> config = {
            "normalizer": {
                "type": "Replace",
                "pattern": {"Regex": "[0-9]+"},
                "content": " NUM ",
            },
            "pre_tokenizer": {"type": "WhitespaceSplit"},
            "model": {
                "type": "WordPiece",
                "vocab": {
                    "[UNK]": 0,
                    "abc": 1,
                    "NUM": 2,
                    "def": 3,
                },
                "unk_token": "[UNK]",
            },
        };
        Tokenizer::HFTokenizer tok(config);

        hash<auto> enc = tok.encode("abc123def456");
        assertEq((1, 2, 3, 2), enc.input_ids,
            "Replace normalizer should support HuggingFace Regex patterns");
    }

    vocabLookupTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        Tokenizer::HFTokenizer tok = createMinimalWordPiece();

        # Test all known tokens
        assertEq(0, tok.tokenToId("[PAD]"), "[PAD] = 0");
        assertEq(1, tok.tokenToId("[UNK]"), "[UNK] = 1");
        assertEq(2, tok.tokenToId("[CLS]"), "[CLS] = 2");
        assertEq(3, tok.tokenToId("[SEP]"), "[SEP] = 3");

        # Test reverse
        assertEq("[PAD]", tok.idToToken(0), "0 = [PAD]");
        assertEq("[UNK]", tok.idToToken(1), "1 = [UNK]");
    }

    skipSpecialTokensTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/bert-base-uncased-tokenizer.json");
        Tokenizer::HFTokenizer tok(parse_json(json_str));

        hash<auto> enc = tok.encode("hello");
        # With special tokens
        string with_special = tok.decode(enc.input_ids, False);
        assertTrue(with_special.find("[CLS]") >= 0,
            "decode without skip should contain [CLS]");

        # Without special tokens
        string without_special = tok.decode(enc.input_ids, True);
        assertEq(-1, without_special.find("[CLS]"),
            "decode with skip should not contain [CLS]");
    }

    gpt2TokenizerTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/gpt2-tokenizer.json");
        Tokenizer::HFTokenizer tok(parse_json(json_str));

        assertEq(50257, tok.getVocabSize(), "GPT-2 vocab size");

        # Reference: Python tokenizers library
        hash<auto> enc = tok.encode("Hello, world!");
        assertEq((15496, 11, 995, 0), enc.input_ids,
            "GPT-2 'Hello, world!' should match Python reference");

        hash<auto> enc2 = tok.encode("The quick brown fox jumps over the lazy dog");
        assertEq((464, 2068, 7586, 21831, 18045, 625, 262, 16931, 3290), enc2.input_ids,
            "GPT-2 fox sentence should match Python reference");
    }

    t5TokenizerTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/t5-small-tokenizer.json");
        Tokenizer::HFTokenizer tok(parse_json(json_str));

        assertEq(32100, tok.getVocabSize(), "T5 vocab size");

        # Reference: Python tokenizers library
        hash<auto> enc = tok.encode("Hello, world!");
        assertEq((8774, 6, 296, 55, 1), enc.input_ids,
            "T5 'Hello, world!' should match Python reference");

        hash<auto> enc2 = tok.encode("translate English to German: The house is wonderful.");
        assertEq((13959, 1566, 12, 2968, 10, 37, 629, 19, 1627, 5, 1), enc2.input_ids,
            "T5 translate should match Python reference");
    }

    gpt2DecodeTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/gpt2-tokenizer.json");
        Tokenizer::HFTokenizer tok(parse_json(json_str));

        # Round-trip: encode then decode
        string input = "The quick brown fox jumps over the lazy dog";
        hash<auto> enc = tok.encode(input);
        string decoded = tok.decode(enc.input_ids);
        assertEq(input, decoded, "GPT-2 round-trip should preserve text exactly");
    }

    gpt4StyleSplitTokenizerTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        # GPT-4/Qwen-style byte-level BPE: the pre_tokenizer is a Sequence of a
        # Split{Regex} followed by a ByteLevel.  The Split pattern uses inline
        # case-insensitive groups (?i:...), Unicode property classes \p{L} / \p{N},
        # and a lookahead (?!\S) — none of which ECMAScript std::regex supports.
        # Before the PCRE2-based SplitPreTokenizer this fixture failed to load with
        # "PRETOKENIZER-CONFIG-ERROR: invalid Split regex pattern".  (gpt2's fixture
        # uses a bare ByteLevel with no Split, so it never exercised this path.)
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/gpt4-style-split-tokenizer.json");

        # Regression: construction must not throw on the Split regex.
        Tokenizer::HFTokenizer tok(parse_json(json_str));
        assertEq(50257, tok.getVocabSize(), "GPT-4-style split vocab size");

        # Reference: Python tokenizers (HF) on this exact fixture.
        hash<auto> enc = tok.encode("The quick brown fox jumps over the lazy dog.");
        assertEq((464, 2068, 7586, 21831, 18045, 625, 262, 16931, 3290, 13), enc.input_ids,
            "Split path basic sentence should match HF reference");

        # Exercises the hard regex features: case-insensitive (?i:) on the uppercase
        # contraction "IT'S", and Unicode \p{L} on the accented letter in "HÉR'S".
        hash<auto> enc2 = tok.encode("I'm sure they're right; IT'S HÉR'S too.");
        assertEq((40, 1101, 1654, 484, 821, 826, 26, 7283, 6, 50, 367, 38351, 49, 6, 50, 1165, 13),
            enc2.input_ids,
            "Split path (?i:) contractions + \\p{L} accents should match HF reference");

        # \p{L}+ vs \p{N} boundary splitting: letters and digits become separate pieces.
        assertEq(9, tok.encode("abc123 456def").input_ids.size(),
            "Split path letter/digit boundary count should match HF reference");

        # Round-trip through the ByteLevel decoder is lossless.
        string input = "The quick brown fox.";
        assertEq(input, tok.decode(tok.encode(input).input_ids),
            "GPT-4-style split round-trip should preserve text");
    }

    private Tokenizer::HFTokenizer createSplitWordPiece(string behavior) {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        # WordPiece over a Split{"-"} pre-tokenizer: the vocab contains every
        # pre-token produced by all four behaviors so each maps to exactly one
        # token, making the segmentation directly observable via enc.tokens.
        hash<auto> config = {
            "model": {
                "type": "WordPiece",
                "vocab": {
                    "[UNK]": 0, "a": 1, "b": 2, "c": 3, "-": 4,
                    "a-": 5, "b-": 6, "-b": 7, "-c": 8,
                },
                "unk_token": "[UNK]",
                "continuing_subword_prefix": "##",
            },
            "pre_tokenizer": {
                "type": "Split",
                "pattern": {"Regex": "-"},
                "behavior": behavior,
                "invert": False,
            },
        };
        return new Tokenizer::HFTokenizer(config);
    }

    splitBehaviorTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        # Verify the four HuggingFace SplitDelimiterBehavior modes against the
        # reference Python tokenizers library output for "a-b-c" (delimiter "-").
        assertEq(("a", "-", "b", "-", "c"),
            createSplitWordPiece("Isolated").encode("a-b-c").tokens,
            "Isolated keeps the delimiter as its own piece");
        assertEq(("a", "b", "c"),
            createSplitWordPiece("Removed").encode("a-b-c").tokens,
            "Removed drops the delimiter");
        assertEq(("a-", "b-", "c"),
            createSplitWordPiece("MergedWithPrevious").encode("a-b-c").tokens,
            "MergedWithPrevious attaches the delimiter to the preceding piece");
        assertEq(("a", "-b", "-c"),
            createSplitWordPiece("MergedWithNext").encode("a-b-c").tokens,
            "MergedWithNext attaches the delimiter to the following piece");
    }

    llamaTokenizerTest() {
%ifdef NoTokenizer
        testSkip("tokenizer module not available");
%endif
        string json_str = ReadOnlyFile::readTextFile(
            get_script_dir() + "/test_data/tinyllama-tokenizer.json");
