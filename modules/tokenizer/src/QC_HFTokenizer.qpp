#include "HFTokenizer.h"

using namespace QoreTokenizer;

//! HuggingFace-compatible text tokenizer
/** Implements the full tokenization pipeline from tokenizer.json:
    normalize → pre-tokenize → model tokenize → post-process

    Supports BPE (GPT-2, RoBERTa, Llama), WordPiece (BERT), and
    Unigram (T5, XLM-RoBERTa) tokenization models.

    @par Example:
    @code{.py}
    %requires json
    %requires tokenizer

    hash<auto> config = parse_json(ReadOnlyFile::readTextFile("tokenizer.json"));
    Tokenizer::HFTokenizer tok(config);

    hash<auto> enc = tok.encode("Hello, world!");
    printf("Token IDs: %y\n", enc.input_ids);

    string text = tok.decode(enc.input_ids);
    printf("Decoded: %s\n", text);
    @endcode

    @since tokenizer 1.0
*/
qclass HFTokenizer [arg=QoreHFTokenizer* tok; ns=Qore::Tokenizer; flags=final];

//! Creates a new HFTokenizer from a parsed tokenizer.json configuration hash
/** @param config the parsed tokenizer.json hash (from parse_json())

    @throw TOKENIZER-ERROR if the configuration is invalid or missing required fields
*/
HFTokenizer::constructor(hash<auto> config) {
    self->setPrivate(CID_HFTOKENIZER, new QoreHFTokenizer(config, xsink));
}

//! Encodes text to token IDs
/** @param text the input text to tokenize

    @return a hash with input_ids, token_type_ids, attention_mask, tokens
*/
hash<auto> HFTokenizer::encode(string text) {
    return tok->encode(text, nullptr, true, xsink);
}

//! Encodes text with options for sentence pairs
/** @param text the input text to tokenize
    @param text_pair optional second text for sentence-pair tasks
    @param add_special_tokens whether to add special tokens (default True)

    @return encoding result hash
*/
hash<auto> HFTokenizer::encodeWithOptions(string text, *string text_pair, softbool add_special_tokens = True) {
    return tok->encode(text, text_pair, (bool)add_special_tokens, xsink);
}

//! Decodes token IDs back to text
/** @param ids a list of token IDs to decode
    @param skip_special_tokens whether to skip special tokens (default False)

    @return the decoded text string
*/
string HFTokenizer::decode(list<softint> ids, softbool skip_special_tokens = False) {
    return tok->decode(ids, (bool)skip_special_tokens, xsink);
}

//! Returns the vocabulary size
/** @return the number of tokens in the vocabulary
*/
int HFTokenizer::getVocabSize() [flags=CONSTANT] {
    return tok->getVocabSize();
}

//! Converts a token ID to its string representation
/** @param id the token ID
    @return the token string
*/
string HFTokenizer::idToToken(int id) [flags=CONSTANT] {
    return tok->idToToken(id, xsink);
}

//! Converts a token string to its ID
/** @param token the token string
    @return the token ID, or -1 if not found
*/
int HFTokenizer::tokenToId(string token) [flags=CONSTANT] {
    return tok->tokenToId(token);
}

//! Returns the full vocabulary as a token-to-ID hash
/** Includes all model vocabulary entries plus any added tokens.
    @return a hash mapping token strings to their integer IDs
*/
hash<string, int> HFTokenizer::getVocab() [flags=CONSTANT] {
    return tok->getVocab(xsink);
}

//! Advanced encoding with truncation, padding, and sentence pair support
/** @param text the input text to tokenize
    @param options optional hash with:
    - \c text_pair (*string): second text for sentence-pair tasks
    - \c max_length (*int): maximum sequence length (including special tokens)
    - \c truncation (*string): truncation strategy: "longest_first", "only_first", "only_second"
    - \c padding (*string): padding strategy: "max_length" (to max_length) or "true" (batch)
    - \c add_special_tokens (*bool): whether to add special tokens (default True)
    - \c pad_token_id (*int): override pad token ID
    - \c is_pretokenized (*bool): if True, treat input as pre-tokenized words
    - \c words (*list<string>): explicit word list for pre-tokenized input
    - \c stride (*int): overlap size for sliding window when truncation produces overflow
    - \c return_overflowing_tokens (*bool): if True, include overflowing token chunks

    @return encoding result hash with input_ids, token_type_ids, attention_mask,
    tokens, offset_mapping, special_tokens_mask, word_ids, and optionally overflowing
*/
hash<auto> HFTokenizer::encodeAdvanced(string text, *hash<auto> options) {
    return tok->encodeAdvanced(text, options, xsink);
}

//! Batch encoding with truncation and padding
/** @param texts list of texts to encode
    @param options same as encodeAdvanced, plus padding "true" for batch-longest

    @return list of encoding result hashes
*/
list<hash<auto>> HFTokenizer::encodeBatch(list<string> texts, *hash<auto> options) {
    return tok->encodeBatch(texts, options, xsink);
}

//! Returns the pad token ID, or -1 if no pad token
/** @return the pad token ID, or -1 if not found
*/
int HFTokenizer::getPadTokenId() [flags=CONSTANT] {
    return tok->getPadTokenId();
}

//! Encodes pre-tokenized word list (skips normalization and pre-tokenization)
/** @param words list of pre-tokenized words to encode
    @param options optional hash with the same options as encodeAdvanced
    (max_length, truncation, padding, add_special_tokens, pad_token_id)

    word_ids in the result naturally map to the index of each input word.
    This is useful when the caller has domain-specific tokenization
    (e.g., code tokenizers, chemical formulas) and wants to skip the
    tokenizer's normalization and pre-tokenization stages.

    @return encoding result hash

    @par Example:
    @code{.py}
    hash<auto> enc = tok.encodePreTokenized(("Hello", "world", "!"));
    printf("word_ids: %y\n", enc.word_ids);
    # word_ids maps each token to its input word index
    @endcode

    @since tokenizer 1.1
*/
hash<auto> HFTokenizer::encodePreTokenized(list<string> words, *hash<auto> options) {
    // Build options hash with is_pretokenized flag
    ReferenceHolder<QoreHashNode> opts(new QoreHashNode(autoTypeInfo), xsink);
    if (options) {
        ConstHashIterator it(options);
        while (it.next()) {
            opts->setKeyValue(it.getKey(), it.get().refSelf(), xsink);
        }
    }
    opts->setKeyValue("is_pretokenized", true, xsink);
    opts->setKeyValue("words", words->refSelf(), xsink);
    SimpleRefHolder<QoreStringNode> empty_text(new QoreStringNode(""));
    return tok->encodeAdvanced(*empty_text, *opts, xsink);
}

//! Adds tokens to the tokenizer vocabulary dynamically
/** @param tokens a list of token definitions; each element can be either:
    - a string (the token content, added as non-special)
    - a hash with keys: \c content (string), \c special (bool), \c single_word (bool)

    Duplicate tokens (already in the model vocabulary or added tokens) are skipped.

    @return the number of tokens actually added

    @par Example:
    @code{.py}
    int added = tok.addTokens(("<|custom|>", {"content": "<|pad|>", "special": True}));
    @endcode

    @since tokenizer 1.1
*/
int HFTokenizer::addTokens(list<auto> tokens) {
    return tok->addTokens(tokens, xsink);
}
