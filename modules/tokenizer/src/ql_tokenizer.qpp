#include "qore/Qore.h"

//! Tokenizer encoding result
/** Returned by @ref HFTokenizer::encode()

    @since tokenizer 1.0
*/
hashdecl Qore::Tokenizer::TokenizerEncoding {
    //! Token IDs
    list<int> input_ids;
    //! Segment IDs (0 for first text, 1 for second)
    *list<int> token_type_ids;
    //! Attention mask (1 for real tokens, 0 for padding)
    *list<int> attention_mask;
    //! String tokens
    *list<string> tokens;
    //! Byte-level offset mapping: each entry is (start, end) in the original text
    *list<list<int>> offset_mapping;
    //! Special tokens mask (1 = special token, 0 = content token)
    *list<int> special_tokens_mask;
}
