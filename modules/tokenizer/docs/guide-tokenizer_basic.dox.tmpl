/** @page tokenizer_basicguide Basic Usage

    @tableofcontents

    @par Loading a tokenizer from a tokenizer.json file:
    @code{.py}
%requires json
%requires tokenizer

# Load tokenizer configuration from file
hash<auto> config = parse_json(ReadOnlyFile::readTextFile("tokenizer.json"));
Tokenizer::HFTokenizer tok(config);

# Basic encoding — returns token IDs with special tokens
hash<auto> enc = tok.encode("Hello, world!");
printf("IDs: %y\n", enc.input_ids);
# BERT output: (101, 7592, 1010, 2088, 999, 102)  = [CLS] hello , world ! [SEP]
# GPT-2 output: (15496, 11, 995, 0)                = Hello , world !

# Decode back to text
string text = tok.decode(enc.input_ids);
printf("Text: %s\n", text);
    @endcode
*/
