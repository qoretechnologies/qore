#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%requires linenoise

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"

%requires QUnit

%exec-class LinenoiseSandboxTest

#! The line editor is process-wide: sandboxed code cannot use it (issues #6743, #6846)
/** The line editor is shared by the whole process: its callbacks run for whatever code reads a line, its history
    holds the lines of all of it, and an editing session can be used by any code that knows its number; a call by
    sandboxed code raises \c SANDBOX-REGISTRATION-ERROR, and trusted code is not affected
*/
class LinenoiseSandboxTest inherits QUnit::Test {
    public {
        #! the calls that sandboxed code makes; each must raise SANDBOX-REGISTRATION-ERROR
        const Calls = {
            "set_callback": "Linenoise::set_callback(list<string> sub (string line) { return (); });",
            "set_hints_callback": "Linenoise::set_hints_callback(*hash<auto> sub (string line) {});",
            "clear_hints_callback": "Linenoise::set_hints_callback();",
            "set_syntax_callback": "Linenoise::set_syntax_callback(*list<auto> sub (string line) {});",
            "clear_syntax_callback": "Linenoise::set_syntax_callback();",
            "bind_key": "Linenoise::bind_key(\"ctrl-x\", hash<auto> sub (hash<auto> info) { return {}; });",
            "unbind_key": "Linenoise::unbind_key(\"ctrl-x\");",
            "clear_history_provider": "Linenoise::set_history_provider();",
            "set_history_provider": "Linenoise::set_history_provider(new HP());",
            # the line editor itself, its history, settings and editing sessions (qore#6846)
            "line": "Linenoise::line(\"> \");",
            "line_with_timeout": "Linenoise::line_with_timeout(\"> \", 1);",
            "history_add": "Linenoise::history_add(\"tenant line\");",
            "history_set_max_len": "Linenoise::history_set_max_len(1);",
            "history_save": "Linenoise::history_save(\"/tmp/linenoise-sandbox-history\");",
            "history_load": "Linenoise::history_load(\"/tmp/linenoise-sandbox-history\");",
            "history_free": "Linenoise::history_free();",
            "history": "Linenoise::history();",
            "preload_buffer": "Linenoise::preload_buffer(\"text\");",
            "set_auto_dedent": "Linenoise::set_auto_dedent(\"    \", \"}\");",
            "set_mask_mode": "Linenoise::set_mask_mode(True);",
            "set_menu_complete": "Linenoise::set_menu_complete(True);",
            "set_completion_case_insensitive": "Linenoise::set_completion_case_insensitive(True);",
            "set_filename_completion": "Linenoise::set_filename_completion(True);",
            "set_right_prompt": "Linenoise::set_right_prompt(\"right\");",
            "edit_start": "Linenoise::edit_start(\"> \");",
            "edit_feed": "Linenoise::edit_feed(1, 10);",
            "edit_get_line": "Linenoise::edit_get_line(1);",
            "edit_stop": "Linenoise::edit_stop(1);",
            "edit_fd": "Linenoise::edit_fd(1);",
            "edit_get_buffer": "Linenoise::edit_get_buffer(1);",
            "edit_set_silent": "Linenoise::edit_set_silent(1, True);",
            "edit_key_type": "Linenoise::edit_key_type(1);",
        };
    }

    const HistoryProviderSource = "class HP inherits Linenoise::AbstractHistoryProvider {
    *string prev(string prefix) {}
    *string next(string prefix) {}
    nothing reset() {}
}
";

    constructor() : Test("LinenoiseSandboxTest", "1.0", \ARGV) {
        addTestCase("sandboxed code cannot use the line editor", \sandboxedTest());
        addTestCase("sandboxed code cannot read or change the history of the line editor", \historyTest());
        addTestCase("trusted code is not refused", \trustedTest());
        set_return_value(main());
    }

    sandboxedTest() {
        # the calls that were not refused, with what they raised instead
        hash<string, string> not_refused = {};
        foreach hash<auto> i in (Calls.pairIterator()) {
            try {
                Program tenant = LinenoiseSandboxTest::tenant(i.key, i.value);
                tenant.callFunction("t_" + i.key);
                not_refused{i.key} = "no exception";
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SANDBOX-REGISTRATION-ERROR") {
                    not_refused{i.key} = sprintf("%s: %s", ex.err, ex.desc);
                }
            }
        }
        assertEq({}, not_refused);
    }

    #! qore#6846: the history of trusted code's lines is neither read nor changed by a tenant
    historyTest() {
        Linenoise::history_free();
        Linenoise::history_add("trusted secret");
        on_exit Linenoise::history_free();
        foreach string func in (("history", "history_add", "history_free")) {
            Program tenant = LinenoiseSandboxTest::tenant(func, Calls{func});
            assertThrows("SANDBOX-REGISTRATION-ERROR", \tenant.callFunction(), ("t_" + func,), func);
        }
        assertEq(("trusted secret",), Linenoise::history(), "the history is unchanged");
    }

    trustedTest() {
        Linenoise::bind_key("ctrl-x", hash<auto> sub (hash<auto> info) { return {}; });
        Linenoise::unbind_key("ctrl-x");
        Linenoise::set_hints_callback();
        Linenoise::set_syntax_callback();
        Linenoise::set_history_provider();
        assertTrue(True);
    }

    #! Returns a sandboxed Program with one function
    private static Program tenant(string func, string body) {
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS, True);
        p.parse(sprintf("%%requires linenoise\n%sauto sub t_%s() { %s }\n", HistoryProviderSource, func, body),
            "tenant-" + func);
        p.setSandboxManager(new SandboxManager());
        return p;
    }
}
