%exec-class Krb5ModuleTest

class CaptureLogAppender inherits Qore::Logger::LoggerAppender {
    private {
        list<string> messages = ();
    }

    constructor() : LoggerAppender("capture") {
    }

    list<string> getMessages() {
        return messages;
    }

    private auto serializeImpl(Qore::Logger::LoggerEvent event) {
        return event.getMessage();
    }

    public processEventImpl(int type, auto params) {
        if (type == Qore::Logger::LoggerAppender::EVENT_LOG) {
            push messages, string(params);
        }
    }
}

