        p.parse(sprintf("
            nothing sub test_denied_init_creds_keytab() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                auto kt = ctx.openKeytab(\"FILE:%s\");
                ctx.acquireCredentialsWithKeytab(principal, kt);
            }
        ", keytabPath), "sandbox_denied_init_creds_keytab");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
