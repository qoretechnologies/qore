    private testAcquireCredentialsRequiresNetworkDomain() {
        Program p(PO_MODERN | PO_NO_NETWORK);
        p.loadModule("krb5");
        assertThrows("PARSE-EXCEPTION", "acquireCredentialsWithPassword", sub() {
            p.parse("
                nothing sub test_network_blocked() {
                    Qore::Krb5::Krb5Context ctx();
                    Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                    ctx.acquireCredentialsWithPassword(principal, \"secret\");
                }
            ", "no_network_acquire_password");
        });
    }

    private testAcquireCredentialsNetworkSandboxDeny() {
        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse("
            nothing sub test_network_sandbox_denied() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                ctx.acquireCredentialsWithPassword(principal, \"secret\");
            }
        ", "network_sandbox_acquire_password");

        SandboxManager sm();
        p.setSandboxManager(sm);

        assertThrows("KRB5-SANDBOX-ERROR", "fine-grained network sandbox", sub() {
            p.callFunction("test_network_sandbox_denied");
        });
    }

    private testAcquireCredentialsPreCancelled() {
        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse("
            nothing sub test_pre_cancelled_acquire() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                ctx.acquireCredentialsWithPassword(principal, \"secret\");
            }
        ", "pre_cancelled_acquire_password");

        SandboxManager sm();
        sm.requestInterrupt();
        p.setSandboxManager(sm);

        assertThrows("PROGRAM-INTERRUPTED", sub() {
            p.callFunction("test_pre_cancelled_acquire");
        });
    }

