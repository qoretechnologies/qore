    private testKeytabRemoveEntry() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:remove-entry-test");
        Qore::Krb5::Krb5Principal p("HTTP/host.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        kt.addEntry(p, getTestKeyHex2(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 2);
        assertEq(2, kt.listEntries().size());

        kt.removeEntry(p, 1, Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96);
        list<hash<Qore::Krb5::Krb5KeytabEntryInfo>> remaining = kt.listEntries();
        assertEq(1, remaining.size());
        assertEq(2, remaining[0].kvno);
    }

    private testKeytabRemoveEntryNonExistent() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:remove-nonexist-test");
        Qore::Krb5::Krb5Principal p("HTTP/host.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);

        Qore::Krb5::Krb5Principal other("HTTP/other.example.com@EXAMPLE.COM");
        assertThrows("KRB5-KEYTAB-ERROR", sub() {
            kt.removeEntry(other, 1, Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96);
        });
    }

    private testKeytabRemoveEntrySandboxDeny() {
        string keytabPath = getSandboxKeytabPath("remove-deny");
        cleanupSandboxKeytab(keytabPath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            nothing sub test_denied_kt_remove() {
                Qore::Krb5::Krb5Context ctx();
                auto kt = ctx.openKeytab(\"FILE:%s\");
                Qore::Krb5::Krb5Principal principal(\"HTTP/host.example.com@EXAMPLE.COM\");
                kt.removeEntry(principal, 1, Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96);
            }
        ", keytabPath), "sandbox_denied_kt_remove");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() {
            p.callFunction("test_denied_kt_remove");
        });
        cleanupSandboxKeytab(keytabPath);
    }

    private testKeytabRemoveThenHasContent() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:remove-hascontent-test");
        Qore::Krb5::Krb5Principal p("HTTP/host.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        assertTrue(kt.hasContent());
        kt.removeEntry(p, 1, Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96);
        assertFalse(kt.hasContent());
    }
