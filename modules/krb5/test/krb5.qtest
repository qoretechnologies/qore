    private testListCredentialCachesReturnsList() {
        Qore::Krb5::Krb5Context ctx();
        list<hash<Qore::Krb5::Krb5CredentialCacheInfo>> caches = ctx.listCredentialCaches();
        assertTrue(caches instanceof list);
        foreach hash<Qore::Krb5::Krb5CredentialCacheInfo> entry in (caches) {
            assertTrue(entry.name instanceof string);
            assertTrue(entry.type instanceof string);
            assertTrue(entry.full_name instanceof string);
            assertTrue(entry.accessible instanceof bool);
            assertTrue(entry.has_principal instanceof bool);
        }
    }

    private testListCredentialCachesContainsMemoryCache() {
        # MEMORY caches created in-process are not part of the system credential
        # cache collection. Verify the method returns consistent types and that
        # any listed caches have valid field types.
        Qore::Krb5::Krb5Context ctx();
        list<hash<Qore::Krb5::Krb5CredentialCacheInfo>> caches = ctx.listCredentialCaches();
        assertTrue(caches instanceof list);
        foreach hash<Qore::Krb5::Krb5CredentialCacheInfo> entry in (caches) {
            assertTrue(entry.type.val());
            if (entry.accessible) {
                assertTrue(entry.full_name.val());
            } else {
                assertEq("", entry.name);
                assertEq("", entry.full_name);
            }
            if (entry.has_principal) {
                assertTrue(entry.principal.val());
            }
        }
        # Call again to verify cursor cleanup and reuse works
        list<hash<Qore::Krb5::Krb5CredentialCacheInfo>> caches2 = ctx.listCredentialCaches();
        assertEq(caches.size(), caches2.size());
    }

    private testListCredentialCachesSandboxRedaction() {
        string cachePath = getSandboxCachePath("collection-redaction");
        cleanupSandboxCache(cachePath);

        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal principal("service/qorus.example.com@EXAMPLE.COM");
        auto cc = ctx.openCredentialCache("FILE:" + cachePath);
        cc.initialize(principal);

        *string oldCacheName = getenv("KRB5CCNAME");
        setenv("KRB5CCNAME", "FILE:" + cachePath);
        on_error {
            if (exists oldCacheName) {
                setenv("KRB5CCNAME", oldCacheName);
            } else {
                unsetenv("KRB5CCNAME");
            }
            cleanupSandboxCache(cachePath);
        }

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse("
            list<hash<Qore::Krb5::Krb5CredentialCacheInfo>> sub test_collection_redaction() {
                Qore::Krb5::Krb5Context ctx();
                return ctx.listCredentialCaches();
            }
        ", "sandbox_denied_collection");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        list<hash<Qore::Krb5::Krb5CredentialCacheInfo>> caches = p.callFunction("test_collection_redaction");
        if (exists oldCacheName) {
            setenv("KRB5CCNAME", oldCacheName);
        } else {
            unsetenv("KRB5CCNAME");
        }

        bool foundRedacted = False;
        foreach hash<Qore::Krb5::Krb5CredentialCacheInfo> entry in (caches) {
            if (entry.type == "FILE" && !entry.accessible) {
                foundRedacted = True;
                assertEq("", entry.name);
                assertEq("", entry.full_name);
                assertFalse(entry.has_principal);
                assertFalse(exists entry.principal);
            }
        }
        assertTrue(foundRedacted);

        cleanupSandboxCache(cachePath);
    }

    private testInitialCredentialsBooleanOptionsAccepted() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("alice@EXAMPLE.COM");

        # Each boolean option should be accepted at the option-parsing level.
        # The error should come from KDC contact, not option validation.
        list<string> boolOpts = ("forwardable", "proxiable", "anonymous", "pac_request",
            "change_password_prompt");
        for (int i = 0; i < boolOpts.size(); i++) {
            hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
            opts{boolOpts[i]} = True;
            assertThrows("KRB5-INIT-CREDS-ERROR", sub() {
                ctx.acquireCredentialsWithPassword(p, "test", opts);
            });
        }
    }

