        hash<Qore::Krb5::Krb5KeytabEntryInfo> entry = kt.getEntry(p, 0,
            Qore::Krb5::ENCTYPE_AES128_CTS_HMAC_SHA1_96);
        assertEq(Qore::Krb5::ENCTYPE_AES128_CTS_HMAC_SHA1_96, entry.enctype);
    }

