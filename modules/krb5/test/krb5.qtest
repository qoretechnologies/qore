    private testGssAcceptorCredentialFromKeytab() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-gss-acceptor-keytab");
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);

        auto cred = Qore::Krb5::GssCredential::fromKeytab(kt, p);
        Qore::Krb5::GssAcceptorContext acceptor(cred);
        assertFalse(acceptor.isComplete());
        assertEq(NOTHING, acceptor.getInitiatorName());
    }

