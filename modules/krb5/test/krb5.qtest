    private testSpnegoNegotiateAuthorizationHeader() {
        string gssHex = "deadbeefcafebabe";
        string header = Krb5Util::buildNegotiateAuthorizationHeader(gssHex);
        assertTrue(header =~ /^Negotiate /);

        string token = Krb5Util::extractNegotiateHeaderToken("Authorization: " + header);
        assertEq(header.substr(10), token);

        binary decoded = parse_base64_string(token);
        assertEq("602706062b0601050502a01d301ba00d300b06092a864886f712010202a20a0408" + gssHex,
            make_hex_string(decoded));
    }

    private testSpnegoParseInitialToken() {
        string gssHex = "deadbeefcafebabe";
        string header = Krb5Util::buildNegotiateAuthorizationHeader(gssHex);
        assertEq(gssHex, Krb5Util::parseNegotiateAuthorizationHeader("Authorization: " + header));
        assertEq(gssHex, Krb5Util::parseSpnegoInitialToken(Krb5Util::extractNegotiateHeaderToken(header)));

        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::parseSpnegoInitialToken("");
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::parseSpnegoInitialToken(make_base64_string(<6005>));
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::parseSpnegoInitialToken(Krb5Util::negotiateSpnegoResponseToken("cafebabe", 1));
        });
    }

