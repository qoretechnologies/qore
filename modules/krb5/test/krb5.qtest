    private testSpnegoNegotiateHeaderInvalidRejected() {
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::extractNegotiateHeaderToken("Basic abc");
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::extractNegotiateHeaderToken("Negotiate");
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::extractNegotiateHeaderToken("WWW-Authenticate: Negotiate !!!");
        });
    }

    private testSpnegoResponseInfoAndHeaders() {
        string tokenHex = "cafebabe12345678";
        string header = Krb5Util::buildNegotiateWwwAuthenticateHeader(tokenHex, 1);
        assertTrue(header =~ /^Negotiate /);

        hash<Krb5Util::SpnegoResponseInfo> info = Krb5Util::parseNegotiateResponseHeader(
            "WWW-Authenticate: " + header);
        assertEq(tokenHex, info.token);
        assertEq(1, info.neg_state);
        assertEq("accept-incomplete", info.neg_state_name);
        assertEq(tokenHex, Krb5Util::parseSpnegoResponse(Krb5Util::extractNegotiateHeaderToken(header)));

        string finalHeader = Krb5Util::buildNegotiateWwwAuthenticateHeader(NOTHING, 0);
        hash<Krb5Util::SpnegoResponseInfo> finalInfo = Krb5Util::parseNegotiateResponseHeader(finalHeader);
        assertEq(0, finalInfo.neg_state);
        assertEq("accept-completed", finalInfo.neg_state_name);
        assertFalse(exists finalInfo.token);
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::parseSpnegoResponse(Krb5Util::extractNegotiateHeaderToken(finalHeader));
        });

        assertEq("Negotiate", Krb5Util::buildNegotiateWwwAuthenticateHeader());
    }

    private testSpnegoResponseTokenValidation() {
        string tokenHex = "cafebabe12345678";
        hash<Krb5Util::SpnegoResponseInfo> tokenOnly =
            Krb5Util::parseSpnegoResponseInfo(Krb5Util::negotiateSpnegoResponseToken(tokenHex));
        assertEq(tokenHex, tokenOnly.token);
        assertFalse(exists tokenOnly.neg_state);

        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::negotiateSpnegoResponseToken();
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::negotiateSpnegoResponseToken("");
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::negotiateSpnegoResponseToken("abc");
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::negotiateSpnegoResponseToken("xyz0");
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::negotiateSpnegoResponseToken(NOTHING, -1);
        });
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::negotiateSpnegoResponseToken(NOTHING, 4);
        });
    }

    private testSpnegoLoggerDiagnosticsSafe() {
        Qore::Logger::Logger logger("krb5-spnego-test", "DEBUG");
        CaptureLogAppender appender();
        logger.addAppender(appender);
        appender.open();

        string secretLikeToken = "deadbeefcafebabe";
        string header = Krb5Util::buildNegotiateAuthorizationHeader(secretLikeToken, logger);
        string b64 = Krb5Util::extractNegotiateHeaderToken(header, logger);
        Krb5Util::parseSpnegoResponseInfo(Krb5Util::negotiateSpnegoResponseToken("cafebabe", 1, logger), logger);

        list<string> messages = appender.getMessages();
        assertTrue(messages.size() >= 4);
        string combined = foldl $1 + "\n" + $2, messages;
        assertTrue(combined.find("Krb5Util SPNEGO") >= 0);
        assertTrue(combined.find("token_bytes") >= 0);
        assertEq(-1, combined.find(secretLikeToken));
        assertEq(-1, combined.find(b64));
    }

