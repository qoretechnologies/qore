        assertEq(2000, entries[0].end_time);
    }

    private testMemoryCredentialCacheRoundtrip() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("service/qorus.example.com@EXAMPLE.COM");
        auto cc = ctx.createMemoryCredentialCache(p, "module-krb5-roundtrip");
        assertEq("MEMORY", cc.getType());
        assertEq("module-krb5-roundtrip", cc.getName());
        assertEq("MEMORY:module-krb5-roundtrip", cc.getFullName());
        assertTrue(cc.hasPrimaryPrincipal());

        auto cp = cc.getPrimaryPrincipal();
        assertEq("service/qorus.example.com@EXAMPLE.COM", cp.toString());
        assertTrue(p.equals(cp));
    }

    private testEmptyCredentialCache() {
        Qore::Krb5::Krb5Context ctx();
        auto cc = ctx.openCredentialCache("MEMORY:module-krb5-empty");
        assertFalse(cc.hasPrimaryPrincipal());
        assertThrows("KRB5-CACHE-ERROR", sub() {
            cc.getPrimaryPrincipal();
        });
    }

    private testEmptyCacheNameRejected() {
        Qore::Krb5::Krb5Context ctx();
        assertThrows("KRB5-CACHE-ERROR", sub() {
            ctx.openCredentialCache("");
        });
        Qore::Krb5::Krb5Principal p("service/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-CACHE-ERROR", sub() {
            ctx.createMemoryCredentialCache(p, "");
        });
    }

    #! a Program governed by a sandbox with the given isolation domain (or none), whose code uses credential caches;
    #! with \a fs_root, its filesystem policy allows only that directory
    private Program cacheTenant(*string domain, bool network = False, *string fs_root) {
        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse("
            *string sub principal_of(string name) {
                Qore::Krb5::Krb5Context ctx();
                auto cc = ctx.openCredentialCache(name);
                return cc.hasPrimaryPrincipal() ? cc.getPrimaryPrincipal().toString() : NOTHING;
            }
            string sub init_cache(string name, string principal) {
                Qore::Krb5::Krb5Context ctx();
                auto cc = ctx.openCredentialCache(name);
                cc.initialize(new Qore::Krb5::Krb5Principal(principal));
                return cc.getFullName();
            }
            hash<auto> sub default_cache() {
                Qore::Krb5::Krb5Context ctx();
                auto cc = ctx.openDefaultCredentialCache();
                return {\"name\": ctx.getDefaultCredentialCacheName(), \"full_name\": cc.getFullName(),
                    \"type\": cc.getType()};
            }
            *string sub cache_principal(Qore::Krb5::Krb5CredentialCache cc) {
                return cc.getPrimaryPrincipal().toString();
            }
            list<auto> sub list_names() {
                Qore::Krb5::Krb5Context ctx();
                return map $1.full_name, ctx.listCredentialCaches();
            }
            Qore::Krb5::Krb5CredentialCache sub open_cache(string name) {
                Qore::Krb5::Krb5Context ctx();
                return ctx.openCredentialCache(name);
            }
            bool sub keytab_has_content(string name) {
                Qore::Krb5::Krb5Context ctx();
                return ctx.openKeytab(name).hasContent();
            }
            Qore::Krb5::Krb5Keytab sub keytab_add(string name, string principal, string key) {
                Qore::Krb5::Krb5Context ctx();
                auto kt = ctx.openKeytab(name);
                kt.addEntry(new Qore::Krb5::Krb5Principal(principal), key,
                    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
                return kt;
            }
            hash<auto> sub default_keytab() {
                Qore::Krb5::Krb5Context ctx();
                return {\"name\": ctx.getDefaultKeytabName(), \"kt_name\": ctx.openDefaultKeytab().getName()};
            }
            bool sub keytab_obj_has_content(Qore::Krb5::Krb5Keytab kt) {
                return kt.hasContent();
            }
            *string sub gss_cred_from_keytab(Qore::Krb5::Krb5Keytab kt) {
                Qore::Krb5::GssCredential c = Qore::Krb5::GssCredential::fromKeytab(kt);
                return exists c ? \"ok\" : NOTHING;
            }
            hash<auto> sub gss_cred_from_keytab_result(Qore::Krb5::Krb5Keytab kt) {
                try {
                    Qore::Krb5::GssCredential::fromKeytab(kt);
                } catch (hash<ExceptionInfo> ex) {
                    return {\"err\": ex.err, \"desc\": ex.desc};
                }
                return {};
            }
            Qore::Krb5::GssCredential sub gss_cred_obj_from_keytab(Qore::Krb5::Krb5Keytab kt) {
                return Qore::Krb5::GssCredential::fromKeytab(kt);
            }
            hash<auto> sub gss_accept_with(Qore::Krb5::GssCredential cred) {
                try {
                    Qore::Krb5::GssAcceptorContext c(cred);
                    c.step(\"00\");
                } catch (hash<ExceptionInfo> ex) {
                    return {\"err\": ex.err, \"desc\": ex.desc};
                }
                return {};
            }
            hash<auto> sub gss_cred_from_cache(string name) {
                try {
                    Qore::Krb5::Krb5Context ctx();
                    Qore::Krb5::GssCredential c = Qore::Krb5::GssCredential::fromCredentialCache(
                        ctx.openCredentialCache(name));
                    return {\"ok\": exists c};
                } catch (hash<ExceptionInfo> ex) {
                    return {\"err\": ex.err, \"desc\": ex.desc};
                }
            }
            hash<auto> sub gss_accept_default() {
                try {
                    Qore::Krb5::GssAcceptorContext c();
                    c.step(\"00\");
                } catch (hash<ExceptionInfo> ex) {
                    return {\"err\": ex.err, \"desc\": ex.desc};
                }
                return {};
            }
            hash<auto> sub gss_default() {
                try {
                    Qore::Krb5::GssClientContext c(\"HTTP@host.example.com\");
                    c.step();
                } catch (hash<ExceptionInfo> ex) {
                    return {\"err\": ex.err, \"desc\": ex.desc};
                }
                return {};
            }
        ", "krb5_cache_tenant");
        SandboxManager sm();
        if (domain) {
            sm.setIsolationDomain(domain);
        }
        if (network) {
            # an unrestricted network policy: the module's KDC operations are allowed
            sm.setNetworkDefaultPolicy(True);
        }
        if (fs_root) {
            sm.setFilesystemSandboxRoot(fs_root);
        }
        p.setSandboxManager(sm);
        return p;
    }

    #! the names in a directory
    private static list<string> listDir(string path) {
        Dir d();
        d.chdir(path);
        return d.list() ?? ();
    }

    #! the replay cache directory of the GSSAPI acceptors of sandboxed code (qore#7756): in the temporary directory
    #! (TMPDIR, which the test sets; Util::tmp_location() uses ENV, which setenv() does not change)
    private string replayCacheDir() {
        return realpath(getenv("TMPDIR")) + "/qore-krb5-rcache-" + geteuid();
    }

    #! the replay cache file of the GSSAPI acceptors of an isolation domain (qore#7756)
    private string domainReplayCachePath(string domain) {
        return replayCacheDir() + "/qore-sandbox-d" + make_hex_string(binary(domain)) + "-krb5-rcache";
    }

    #! a memory cache of the host is not visible to sandboxed code, which has a cache of its own of the same name
    #! (qore#7671)
    private testMemoryCacheIsolation() {
        string name = "MEMORY:module-krb5-isolation-" + getpid();
        Qore::Krb5::Krb5Context ctx();
        auto host = ctx.openCredentialCache(name);
        host.initialize(new Qore::Krb5::Krb5Principal("host/trusted.example.com@EXAMPLE.COM"));

        Program a = cacheTenant("tenant-a");
        Program b = cacheTenant("tenant-b");
        Program b2 = cacheTenant("tenant-b");
        Program none = cacheTenant();

        # the tenants do not see the host's cache
        assertNothing(a.callFunction("principal_of", name), "the host's cache is not visible to a tenant");
        assertNothing(none.callFunction("principal_of", name), "nor to a sandbox without a domain");

        # each tenant has a cache of its own of that name, under the name that it gave
        assertEq(name, a.callFunction("init_cache", name, "a/tenant.example.com@EXAMPLE.COM"));
        assertEq("a/tenant.example.com@EXAMPLE.COM", a.callFunction("principal_of", name));
        assertNothing(b.callFunction("principal_of", name), "tenant b does not see tenant a's cache");
        b.callFunction("init_cache", name, "b/tenant.example.com@EXAMPLE.COM");
        assertEq("b/tenant.example.com@EXAMPLE.COM", b2.callFunction("principal_of", name),
            "the Programs of one isolation domain share its caches");
        assertEq("a/tenant.example.com@EXAMPLE.COM", a.callFunction("principal_of", name));
        assertNothing(none.callFunction("principal_of", name), "a sandbox without a domain has caches of its own");

        # two sandboxes without a domain do not share caches either
        Program none2 = cacheTenant();
        none.callFunction("init_cache", name, "n/tenant.example.com@EXAMPLE.COM");
        assertNothing(none2.callFunction("principal_of", name), "each sandbox without a domain has caches of its own");

        # the host's cache is unchanged
        assertEq("host/trusted.example.com@EXAMPLE.COM", ctx.openCredentialCache(name).getPrimaryPrincipal().toString());

        # a cache object of tenant a that is given to tenant b cannot be used by it
        auto a_cache = a.callFunction("open_cache", name);
        # tenant b's code that calls tenant a's object belongs to both domains, which have no caches in common
        assertThrows("KRB5-SANDBOX-ERROR", "more than one isolation domain", \b.callFunction(),
            ("cache_principal", a_cache));
        # a call of a method of tenant a's cache object runs under tenant a's sandbox, also from the host: it gives the
        # name that tenant a gave
        assertEq(name, a_cache.getFullName());


        # a cache object of the host that is given to sandboxed code cannot be used by it
        assertThrows("KRB5-SANDBOX-ERROR", "belongs to other code", \a.callFunction(), ("cache_principal", host));

        # (MIT Kerberos does not list memory caches in a cache collection, so the listing is not checked here)
    }

    #! the default cache of sandboxed code is a memory cache of its isolation domain, not the default of the process
    private testSandboxDefaultCache() {
        Program a = cacheTenant("tenant-default");
        hash<auto> d = a.callFunction("default_cache");
        assertEq("MEMORY:default", d.name);
        assertEq("MEMORY:default", d.full_name);
        assertEq("MEMORY", d.type);
        a.callFunction("init_cache", "MEMORY:default", "d/tenant.example.com@EXAMPLE.COM");
        assertEq("d/tenant.example.com@EXAMPLE.COM", a.callFunction("principal_of", "MEMORY:default"));
        # the process's own MEMORY:default cache is not the tenant's
        Qore::Krb5::Krb5Context ctx();
        assertFalse(ctx.openCredentialCache("MEMORY:default").hasPrimaryPrincipal());
    }

    #! the caches that the OS shares by user cannot be kept apart, and are refused to sandboxed code
    private testSandboxSharedCacheTypesRefused() {
        Program a = cacheTenant("tenant-refused");
        foreach string name in (("KCM:", "API:", "KEYRING:persistent:0", "MSLSA:", "KEYRING:user:x", "KEYRING:session:x",
                "KEYRING:legacy-name")) {
            assertThrows("KRB5-SANDBOX-ERROR", \a.callFunction(), ("principal_of", name), name);
        }
    }

    #! keyring caches are kept per isolation domain where the kernel has keyrings
    private testKeyringCacheIsolation() {
        string name = "KEYRING:process:module-krb5-isolation-" + getpid();
        Qore::Krb5::Krb5Context ctx();
        try {
            ctx.openCredentialCache(name).initialize(new Qore::Krb5::Krb5Principal("host/trusted.example.com@EXAMPLE.COM"));
        } catch (hash<ExceptionInfo> ex) {
            testSkip("keyring credential caches are not available: " + ex.desc);
        }
        Program a = cacheTenant("tenant-keyring");
        assertNothing(a.callFunction("principal_of", name), "the host's keyring cache is not visible to a tenant");
        # the full name of the tenant's cache is the one that MIT Kerberos gives for the name (kind:coll:coll), as
        # for the host's
        assertEq(ctx.openCredentialCache(name).getFullName(),
            a.callFunction("init_cache", name, "k/tenant.example.com@EXAMPLE.COM"));
        assertEq("k/tenant.example.com@EXAMPLE.COM", a.callFunction("principal_of", name));
        assertEq("host/trusted.example.com@EXAMPLE.COM", ctx.openCredentialCache(name).getPrimaryPrincipal().toString());
        # another tenant does not see it
        Program b = cacheTenant("tenant-keyring-b");
        assertNothing(b.callFunction("principal_of", name));
        # a cache name in a collection, and the thread keyring: the full name given back opens the same cache
        foreach string n in ((name + ":sub", "KEYRING:thread:module-krb5-isolation-" + getpid())) {
            string full = a.callFunction("init_cache", n, "s/tenant.example.com@EXAMPLE.COM");
            assertEq("s/tenant.example.com@EXAMPLE.COM", a.callFunction("principal_of", full), n);
            assertNothing(b.callFunction("principal_of", n), n);
        }
    }

    #! a GSS initiator of sandboxed code without a credential would use the default cache of the process
    private testSandboxGssDefaultCredentials() {
        # with an unrestricted network policy, so that the network check of the module does not refuse it first
        Program a = cacheTenant("tenant-gss", True);
        hash<auto> r = a.callFunction("gss_default");
        assertEq("KRB5-SANDBOX-ERROR", r.err, r.desc);
        assertRegex("default credentials", r.desc);
    }

    #! a memory keytab of the host is not visible to sandboxed code, which has a keytab of its own of the same name
    #! (qore#7736)
    private testMemoryKeytabIsolation() {
        string name = "MEMORY:module-krb5-kt-isolation-" + getpid();
        Qore::Krb5::Krb5Context ctx();
        auto host = ctx.openKeytab(name);
        host.addEntry(new Qore::Krb5::Krb5Principal("HTTP/trusted.example.com@EXAMPLE.COM"), getTestKeyHex1(),
            Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 3);
        Program a = cacheTenant("kt-tenant-a");
        Program b = cacheTenant("kt-tenant-b");
        assertFalse(a.callFunction("keytab_has_content", name), "the host's keytab is not visible to a tenant");
        # a memory keytab lives while a handle of it is open: the test holds tenant a's
        auto a_kt = a.callFunction("keytab_add", name, "HTTP/a.example.com@EXAMPLE.COM", getTestKeyHex1());
        assertEq(name, a_kt.getName(), "the name that tenant a gave");
        assertTrue(a.callFunction("keytab_has_content", name));
        assertFalse(b.callFunction("keytab_has_content", name), "tenant b does not see tenant a's keytab");
        # the host's keytab is unchanged: one entry
        assertEq(1, ctx.openKeytab(name).listEntries().size());
        assertEq("HTTP/trusted.example.com@EXAMPLE.COM", ctx.openKeytab(name).listEntries()[0].principal);
        # a keytab object of the host that is given to sandboxed code cannot be used by it
        assertThrows("KRB5-SANDBOX-ERROR", "belongs to other code", \a.callFunction(), ("keytab_obj_has_content", host));
        # a GSS acceptor credential: from tenant a's own keytab, not from the host's
        assertEq("ok", a.callFunction("gss_cred_from_keytab", a_kt));
        assertThrows("KRB5-SANDBOX-ERROR", "belongs to other code", \a.callFunction(), ("gss_cred_from_keytab", host));
        # the default keytab of sandboxed code is its own, also with KRB5_KTNAME set
        *string ktname = getenv("KRB5_KTNAME");
        on_exit if (exists ktname) { setenv("KRB5_KTNAME", ktname); } else { unsetenv("KRB5_KTNAME"); }
        setenv("KRB5_KTNAME", name);
        hash<auto> d = a.callFunction("default_keytab");
        assertEq("MEMORY:default", d.name);
        assertEq("MEMORY:default", d.kt_name);
        assertFalse(a.callFunction("keytab_has_content", "MEMORY:default"), "not the host's keytab of KRB5_KTNAME");
    }

    #! a GSS acceptor of sandboxed code without a credential would use the default keytab of the process (qore#7736)
    private testSandboxGssAcceptorDefaultKeytab() {
        Program a = cacheTenant("tenant-gss-accept", True);
        hash<auto> r = a.callFunction("gss_accept_default");
        assertEq("KRB5-SANDBOX-ERROR", r.err, r.desc);
        assertRegex("default keytab", r.desc);
    }

    #! the acceptor credential of sandboxed code names the replay cache of its isolation domain, a file of the module
    #! that needs no filesystem access, not the replay cache of the process (KRB5RCACHENAME) (qore#7756)
    private testSandboxGssAcceptorReplayCache() {
        # the replay caches of this test are in a temporary directory of its own
        TmpDir tmp("module-krb5-rcache-");
        *string tmpdir = getenv("TMPDIR");
        *string rcname = getenv("KRB5RCACHENAME");
        *string rcdir = getenv("KRB5RCACHEDIR");
        on_exit {
            if (exists tmpdir) { setenv("TMPDIR", tmpdir); } else { unsetenv("TMPDIR"); }
            if (exists rcname) { setenv("KRB5RCACHENAME", rcname); } else { unsetenv("KRB5RCACHENAME"); }
            if (exists rcdir) { setenv("KRB5RCACHEDIR", rcdir); } else { unsetenv("KRB5RCACHEDIR"); }
        }
        setenv("TMPDIR", tmp.path);
        string host_rcache = tmp.path + "/host-rcache";
        setenv("KRB5RCACHENAME", "file2:" + host_rcache);
        setenv("KRB5RCACHEDIR", tmp.path);

        string kt_name = "MEMORY:module-krb5-rcache-" + getpid();
        string dom_a = "rcache-tenant-a-" + getpid();
        string dom_b = "rcache-tenant-b-" + getpid();
        string a_rcache = domainReplayCachePath(dom_a);
        string b_rcache = domainReplayCachePath(dom_b);
        assertNeq(a_rcache, b_rcache);

        # the replay cache needs no filesystem access: the policy of tenant a allows only another directory
        TmpDir other("module-krb5-rcache-other-");
        Program a = cacheTenant(dom_a, False, other.path);
        auto a_kt = a.callFunction("keytab_add", kt_name, "HTTP/a.example.com@EXAMPLE.COM", getTestKeyHex1());
        assertEq({}, a.callFunction("gss_cred_from_keytab_result", a_kt));
        # a directory that only the effective user can use, with the file of the domain
        hash<StatInfo> dir_info = hlstat(replayCacheDir());
        assertEq("DIRECTORY", dir_info.type);
        assertEq(0, dir_info.mode & 077);
        hash<StatInfo> info = hlstat(a_rcache);
        assertEq("REGULAR", info.type);
        assertEq(0, info.mode & 077);
        assertFalse(is_file(host_rcache), "the replay cache of the process is not created");

        # another domain has a replay cache of its own
        Program b = cacheTenant(dom_b);
        auto b_kt = b.callFunction("keytab_add", kt_name, "HTTP/b.example.com@EXAMPLE.COM", getTestKeyHex1());
        assertEq({}, b.callFunction("gss_cred_from_keytab_result", b_kt));
        assertTrue(is_file(b_rcache));

        # a sandbox without an isolation domain: the name has a token of the process, as Program IDs are unique
        # only in the process
        Program none = cacheTenant();
        auto none_kt = none.callFunction("keytab_add", kt_name, "HTTP/n.example.com@EXAMPLE.COM", getTestKeyHex1());
        assertEq({}, none.callFunction("gss_cred_from_keytab_result", none_kt));
        list<string> by_program = select listDir(replayCacheDir()), $1 =~ /^qore-sandbox-p/;
        assertEq(1, by_program.size(), sprintf("%y", by_program));
        assertRegex("^qore-sandbox-p[0-9]+-" + getpid() + "-[0-9a-f]+-krb5-rcache$", by_program[0]);

        # an acceptor of the domain with the credential gets to the token (a malformed one here)
        Qore::Krb5::GssCredential a_cred = a.callFunction("gss_cred_obj_from_keytab", a_kt);
        hash<auto> r = a.callFunction("gss_accept_with", a_cred);
        assertEq("KRB5-GSS-ERROR", r.err, r.desc);
        assertFalse(is_file(host_rcache), "the replay cache of the process is not created");

        # the replay cache replaced with a link after the credential was acquired: the acceptor refuses to step, and
        # the file that the link names is not written
        string target = tmp.path + "/read-only.dat";
        File f();
        f.open2(target, O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write("unchanged");
        f.close();
        unlink(a_rcache);
        symlink(target, a_rcache);
        r = a.callFunction("gss_accept_with", a_cred);
        assertEq("KRB5-SANDBOX-ERROR", r.err, r.desc);
        assertRegex("replay cache", r.desc);
        assertEq("unchanged", ReadOnlyFile::readTextFile(target));
        # also when a credential is acquired
        r = a.callFunction("gss_cred_from_keytab_result", a_kt);
        assertEq("KRB5-SANDBOX-ERROR", r.err, r.desc);
        assertEq("unchanged", ReadOnlyFile::readTextFile(target));
        unlink(a_rcache);
        assertEq({}, a.callFunction("gss_cred_from_keytab_result", a_kt));
    }

    #! the replay cache directory must be a directory that only the effective user can use (qore#7756)
    private testSandboxGssAcceptorReplayCacheDir() {
        TmpDir tmp("module-krb5-rcache-dir-");
        *string tmpdir = getenv("TMPDIR");
        on_exit if (exists tmpdir) { setenv("TMPDIR", tmpdir); } else { unsetenv("TMPDIR"); }
        setenv("TMPDIR", tmp.path);

        string kt_name = "MEMORY:module-krb5-rcache-dir-" + getpid();
        Program a = cacheTenant("rcache-dir-tenant-" + getpid());
        auto a_kt = a.callFunction("keytab_add", kt_name, "HTTP/a.example.com@EXAMPLE.COM", getTestKeyHex1());

        # a directory that others can use
        string dir = replayCacheDir();
        mkdir(dir, 0755);
        chmod(dir, 0755);
        hash<auto> r = a.callFunction("gss_cred_from_keytab_result", a_kt);
        assertEq("KRB5-SANDBOX-ERROR", r.err, r.desc);
        assertRegex("replay cache directory", r.desc);
        chmod(dir, 0700);
        assertEq({}, a.callFunction("gss_cred_from_keytab_result", a_kt));

        # a link to a directory
        remove_tree(dir);
        string other = tmp.path + "/other";
        mkdir(other, 0700);
        symlink(other, dir);
        r = a.callFunction("gss_cred_from_keytab_result", a_kt);
        assertEq("KRB5-SANDBOX-ERROR", r.err, r.desc);
        assertRegex("replay cache directory", r.desc);
        assertEq((), listDir(other), "nothing is created in the directory that the link names");
    }

    #! an acceptor credential that code of another isolation domain acquired names the replay cache of that domain:
    #! an acceptor of sandboxed code does not use it; a credential that trusted code made is one that it was given
    #! (qore#7756)
    private testSandboxGssAcceptorOtherDomainCredential() {
        string kt_name = "MEMORY:module-krb5-rcache-cred-" + getpid();
        Program a = cacheTenant("rcache-cred-tenant-a-" + getpid());
        Program b = cacheTenant("rcache-cred-tenant-b-" + getpid());
        auto a_kt = a.callFunction("keytab_add", kt_name, "HTTP/a.example.com@EXAMPLE.COM", getTestKeyHex1());
        Qore::Krb5::GssCredential a_cred = a.callFunction("gss_cred_obj_from_keytab", a_kt);
        # tenant a's own acceptor gets to the (malformed) token
        hash<auto> r = a.callFunction("gss_accept_with", a_cred);
        assertEq("KRB5-GSS-ERROR", r.err, r.desc);
        # tenant b's does not use tenant a's credential
        r = b.callFunction("gss_accept_with", a_cred);
        assertEq("KRB5-SANDBOX-ERROR", r.err, r.desc);
        assertRegex("replay cache of another isolation domain", r.desc);

        # a credential that trusted code made and gives to sandboxed code
        Qore::Krb5::Krb5Context ctx();
        auto host_kt = ctx.openKeytab(kt_name);
        host_kt.addEntry(new Qore::Krb5::Krb5Principal("HTTP/host.example.com@EXAMPLE.COM"), getTestKeyHex1(),
            Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        r = b.callFunction("gss_accept_with", Qore::Krb5::GssCredential::fromKeytab(host_kt));
        assertEq("KRB5-GSS-ERROR", r.err, r.desc);
    }

    #! an initiator credential of a cache without a ticket gets one with the client keytab: the sandbox's own, not the
    #! client keytab of the process (KRB5_CLIENT_KTNAME) (qore#7736)
    private testSandboxGssClientKeytab() {
        string kt = "MEMORY:module-krb5-client-kt-" + getpid();
        Qore::Krb5::Krb5Context ctx();
        auto hkt = ctx.openKeytab(kt);
        hkt.addEntry(new Qore::Krb5::Krb5Principal("user/x.example.com@EXAMPLE.COM"), getTestKeyHex1(),
            Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        *string client_kt = getenv("KRB5_CLIENT_KTNAME");
        on_exit if (exists client_kt) { setenv("KRB5_CLIENT_KTNAME", client_kt); } else { unsetenv("KRB5_CLIENT_KTNAME"); }
        setenv("KRB5_CLIENT_KTNAME", kt);
        # an unrestricted network policy: the module's network check does not refuse it first
        Program a = cacheTenant("tenant-client-kt", True);
        a.callFunction("init_cache", "MEMORY:client", "user/x.example.com@EXAMPLE.COM");
        hash<auto> r = a.callFunction("gss_cred_from_cache", "MEMORY:client");
        # the domain's client keytab has no key: the cache stays empty (with the host's client keytab, MIT Kerberos
        # would request a ticket from the KDC with its key)
        assertEq("KRB5-GSS-ERROR", r.err, r.desc);
        assertRegex("cache is empty", r.desc, "no ticket request with the client keytab of the process");
    }

