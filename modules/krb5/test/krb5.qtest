    private testKeytabGetEntrySpecificKvno() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:kvno-select-test");
        Qore::Krb5::Krb5Principal p("HTTP/host.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        kt.addEntry(p, getTestKeyHex2(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 3);

        hash<Qore::Krb5::Krb5KeytabEntryInfo> entry = kt.getEntry(p, 1);
        assertEq(1, entry.kvno);

        entry = kt.getEntry(p, 3);
        assertEq(3, entry.kvno);
    }

    private testKeytabGetEntrySpecificEnctype() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:enctype-select-test");
        Qore::Krb5::Krb5Principal p("HTTP/host.example.com@EXAMPLE.COM");
        string keyHex128 = "00112233445566778899aabbccddeeff";
