    private testSpnegoNegotiateTokenBuild() {
        # Build an SPNEGO token from a known GSS token hex
        string gssHex = "deadbeefcafebabe";
        string b64 = Krb5Util::negotiateSpnegoToken(gssHex);
        assertTrue(b64.val());

        # Decode and verify the exact DER structure.
        binary decoded = parse_base64_string(b64);
        assertEq("602706062b0601050502a01d301ba00d300b06092a864886f712010202a20a0408" + gssHex,
            make_hex_string(decoded));
    }

