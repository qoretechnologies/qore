        kt.addEntry(p, getTestKeyHex2(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 3);

        hash<Qore::Krb5::Krb5KeytabEntryInfo> entry = kt.getEntry(p, 1);
