#!/usr/bin/env qore
# test-platform: macos - credential caches and principals with the system Kerberos/GSS-API library on macOS
%modern

/* Copyright (C) 2026 Qore Technologies, s.r.o. */

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires Util
%requires FsUtil
%requires QUnit
%requires krb5
%requires Krb5Util
%requires Logger

%exec-class Krb5ModuleTest

class CaptureLogAppender inherits Qore::Logger::LoggerAppender {
    private {
        list<string> messages = ();
    }

    constructor() : LoggerAppender("capture") {
    }

    list<string> getMessages() {
        return messages;
    }

    private auto serializeImpl(Qore::Logger::LoggerEvent event) {
        return event.getMessage();
    }

    public processEventImpl(int type, auto params) {
        if (type == Qore::Logger::LoggerAppender::EVENT_LOG) {
            push messages, string(params);
        }
    }
}

public class Krb5ModuleTest inherits QUnit::Test {
    private {
        #! the base name of the credential cache and keytab files the test creates in /tmp
        /** unique for every run, so that runs on the same host, at the same time or after a run that left files
            behind, never use each other's files; the files are in /tmp, as the sandbox cases allow /tmp
        */
        string unique_name = sprintf("module-krb5-%d-%s", getpid(), get_random_string(8));

        #! the temporary directory of the test (TMPDIR), where the replay caches of the sandboxed GSSAPI acceptors are
        #! (qore#7756)
        TmpDir tmp_dir("module-krb5-test-");
    }

