    private string getSandboxCachePath(string suffix) {
        return sprintf("/tmp/module-krb5-%s.ccache", suffix);
    }

    private string getSandboxKeytabPath(string suffix) {
        return sprintf("/tmp/module-krb5-%s.keytab", suffix);
    }

    private cleanupSandboxCache(string path) {
        try {
            unlink(path);
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    private cleanupSandboxKeytab(string path) {
        try {
            unlink(path);
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    private string getTestKeyHex1() {
        return "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
    }

    private string getTestKeyHex2() {
        return "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100";
    }

    private testUtilityModuleHelpers() {
        assertEq("ldap/ad.example.com@EXAMPLE.COM",
            Krb5Util::getHostBasedServicePrincipal("ldap", "ad.example.com", "EXAMPLE.COM"));
    }

    private testUtilityParseHostBasedServicePrincipal() {
        hash<Krb5Util::Krb5HostBasedServicePrincipalInfo> info =
            Krb5Util::parseHostBasedServicePrincipal("HTTP/qorus.example.com@EXAMPLE.COM");
        assertEq("HTTP", info.service);
        assertEq("qorus.example.com", info.host);
        assertEq("EXAMPLE.COM", info.realm);
    }

    private testUtilityParseHostBasedServicePrincipalRejectsSingleComponent() {
        # Not a host-based service principal — only one component before the realm.
        assertThrows("KRB5-PRINCIPAL-ERROR", "host-based", sub() {
            Krb5Util::parseHostBasedServicePrincipal("alice@EXAMPLE.COM");
        });
    }

    private testUtilityParseHostBasedServicePrincipalRejectsMalformed() {
        assertThrows("KRB5-PRINCIPAL-ERROR", sub() {
            Krb5Util::parseHostBasedServicePrincipal("not-a-principal");
        });
    }

    private testUtilityBuildTlsServerEndPointChannelBindingHex() {
        # The hex-encoded ASCII prefix "tls-server-end-point:" is 21 bytes / 42 hex chars.
        string prefix_hex = "746c732d7365727665722d656e642d706f696e743a";
        string cert_hash_hex = "00112233445566778899aabbccddeeff";
        string cb = Krb5Util::buildTlsServerEndPointChannelBindingHex(cert_hash_hex);
        assertEq(prefix_hex + cert_hash_hex, cb);

        # The produced value must be acceptable as a GssClientContextOptions
        # channel_binding_application_data_hex value (accepted without error).
        hash<Qore::Krb5::GssClientContextOptions> opts();
        opts.channel_binding_application_data_hex = cb;
        Qore::Krb5::GssClientContext ctx("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", ctx.getTargetName());
    }

    private testUtilityBuildTlsServerEndPointChannelBindingHexValidation() {
        assertThrows("KRB5-CHANNEL-BINDING-ERROR", sub() {
            Krb5Util::buildTlsServerEndPointChannelBindingHex("");
        });
        assertThrows("KRB5-CHANNEL-BINDING-ERROR", sub() {
            Krb5Util::buildTlsServerEndPointChannelBindingHex("abc");
        });
        assertThrows("KRB5-CHANNEL-BINDING-ERROR", sub() {
            Krb5Util::buildTlsServerEndPointChannelBindingHex("zz");
        });
    }

    private testUtilityCredentialLifecycleHelpers() {
        hash<Qore::Krb5::Krb5CredentialsInfo> info = createTestCredentials().getInfo();

        hash<Krb5Util::CredentialLifecycleInfo> nearExpiry =
            Krb5Util::getCredentialLifecycleInfo(info, 120, 1900);
        assertEq(1900, nearExpiry.now_epoch_seconds);
        assertEq(1000, nearExpiry.start_time);
        assertEq(2000, nearExpiry.end_time);
        assertEq(3000, nearExpiry.renew_until);
        assertEq(-900, nearExpiry.seconds_until_start);
        assertEq(100, nearExpiry.remaining_seconds);
        assertEq(1100, nearExpiry.renewable_seconds);
        assertTrue(nearExpiry.started);
        assertFalse(nearExpiry.expired);
        assertTrue(nearExpiry.valid);
        assertTrue(nearExpiry.renewable);
        assertTrue(nearExpiry.within_renewal_threshold);
        assertTrue(nearExpiry.should_renew);

        assertFalse(Krb5Util::isCredentialExpired(info, 1999));
        assertTrue(Krb5Util::isCredentialExpired(info, 2000));
        assertTrue(Krb5Util::shouldRenewCredential(info, 100, 1900));
        assertFalse(Krb5Util::shouldRenewCredential(info, 50, 1900));

        hash<Krb5Util::CredentialLifecycleInfo> beforeStart =
            Krb5Util::getCredentialLifecycleInfo(info, 120, 900);
        assertFalse(beforeStart.started);
        assertFalse(beforeStart.expired);
        assertFalse(beforeStart.valid);
        assertEq(100, beforeStart.seconds_until_start);
        assertEq(1100, beforeStart.remaining_seconds);
        assertFalse(beforeStart.within_renewal_threshold);
        assertFalse(beforeStart.should_renew);

        hash<Qore::Krb5::Krb5CredentialsInfo> nonRenewable = info;
        nonRenewable.renew_until = 0;
        hash<Krb5Util::CredentialLifecycleInfo> nonRenewableStatus =
            Krb5Util::getCredentialLifecycleInfo(nonRenewable, 120, 1900);
        assertFalse(nonRenewableStatus.renewable);
        assertEq(0, nonRenewableStatus.renewable_seconds);
        assertTrue(nonRenewableStatus.within_renewal_threshold);
        assertFalse(nonRenewableStatus.should_renew);
    }

    private testUtilityCredentialLifecycleValidation() {
        hash<Qore::Krb5::Krb5CredentialsInfo> info = createTestCredentials().getInfo();

        assertThrows("KRB5-CREDENTIAL-LIFECYCLE-ERROR", sub() {
            Krb5Util::getCredentialLifecycleInfo(info, -1, 1900);
        });
        assertThrows("KRB5-CREDENTIAL-LIFECYCLE-ERROR", sub() {
            Krb5Util::getCredentialLifecycleInfo(info, 120, -1);
        });

        hash<Qore::Krb5::Krb5CredentialsInfo> bad = info;
        bad.end_time = 999;
        assertThrows("KRB5-CREDENTIAL-LIFECYCLE-ERROR", sub() {
            Krb5Util::getCredentialLifecycleInfo(bad, 120, 1900);
        });

        bad = info;
        bad.renew_until = -1;
        assertThrows("KRB5-CREDENTIAL-LIFECYCLE-ERROR", sub() {
            Krb5Util::getCredentialLifecycleInfo(bad, 120, 1900);
        });
    }

    private testUtilityCredentialLifecycleLoggerDiagnosticsSafe() {
        Qore::Logger::Logger logger("krb5-lifecycle-test", "DEBUG");
        CaptureLogAppender appender();
        logger.addAppender(appender);
        appender.open();

        hash<Qore::Krb5::Krb5CredentialsInfo> info = createTestCredentials().getInfo();
        Krb5Util::getCredentialLifecycleInfo(info, 120, 1900, logger);

        list<string> messages = appender.getMessages();
        assertTrue(messages.size() >= 1);
        string combined = foldl $1 + "\n" + $2, messages;
        assertTrue(combined.find("Krb5Util credential lifecycle") >= 0);
        assertTrue(combined.find("remaining_seconds") >= 0);
        assertEq(-1, combined.find(getTestKeyHex1()));
        assertEq(-1, combined.find("abcd"));
    }

    private testValidateKerberosEnvironmentBasic() {
        hash<Krb5Util::KerberosEnvironmentInfo> env = Krb5Util::validateKerberosEnvironment();
        assertTrue(env.warnings instanceof list);
        assertTrue(env.errors instanceof list);
        assertTrue(env.checks instanceof list);
        assertTrue(env.checks.size() > 0);
        assertTrue(hasEnvironmentCheck(env, "default-realm"));
        assertTrue(env.healthy instanceof bool);
        assertEq(env.errors.size() == 0, env.healthy);
        assertTrue(env.cache_accessible instanceof bool);
        assertTrue(env.keytab_accessible instanceof bool);
    }

    private testValidateKerberosEnvironmentServicePrincipal() {
        hash<Krb5Util::KerberosEnvironmentInfo> env =
            Krb5Util::validateKerberosEnvironment("HTTP/nonexistent.example.com@EXAMPLE.COM");
        assertTrue(env instanceof hash);
        if (env.keytab_accessible && exists env.keytab_entry_count && env.keytab_entry_count > 0) {
            assertTrue(env.service_principal_in_keytab instanceof bool);
            if (env.service_principal_in_keytab == False) {
                assertFalse(env.healthy);
                assertTrue(hasEnvironmentCheck(env, "default-keytab-service-principal", False, "error"));
            }
        }
        # Always verify the function completes without throwing
        assertTrue(env.healthy instanceof bool);
    }

    private testValidateKerberosEnvironmentMalformedServicePrincipal() {
        assertThrows("KRB5-PRINCIPAL-ERROR", sub() {
            Krb5Util::validateKerberosEnvironment("");
        });
    }

    private testValidateKerberosEnvironmentInvalidOptions() {
        hash<Krb5Util::KerberosEnvironmentValidationOptions> opts();
        opts.renew_threshold_seconds = -1;
        assertThrows("KRB5-ENVIRONMENT-ERROR", sub() {
            Krb5Util::validateKerberosEnvironment(NOTHING, NOTHING, opts);
        });

        hash<Krb5Util::KerberosEnvironmentValidationOptions> opts2();
        opts2.min_tgt_lifetime_seconds = -1;
        assertThrows("KRB5-ENVIRONMENT-ERROR", sub() {
            Krb5Util::validateKerberosEnvironment(NOTHING, NOTHING, opts2);
        });
    }

    private testValidateKerberosEnvironmentLoggerSafe() {
        Qore::Logger::Logger logger("krb5-env-test", "DEBUG");
        CaptureLogAppender appender();
        logger.addAppender(appender);
        appender.open();

        Krb5Util::validateKerberosEnvironment(NOTHING, logger);

        list<string> messages = appender.getMessages();
        assertTrue(messages.size() >= 2);
        string combined = foldl $1 + "\n" + $2, messages;
        assertTrue(combined.find("Krb5Util environment") >= 0);
    }

    private bool hasEnvironmentCheck(hash<Krb5Util::KerberosEnvironmentInfo> env, string checkId,
            *bool expectedOk = NOTHING, *string expectedSeverity = NOTHING) {
        foreach hash<Krb5Util::KerberosEnvironmentCheckInfo> check in (env.checks) {
            if (check.check_id == checkId
                    && (!exists expectedOk || check.ok == expectedOk)
                    && (!exists expectedSeverity || check.severity == expectedSeverity)) {
                return True;
            }
        }
        return False;
    }

    private testS4uImpersonateRequiresNetworkDomain() {
        Program p(PO_NO_NETWORK);
        assertThrows("PARSE-EXCEPTION", sub() {
            p.parse("
%modern
%requires krb5
Qore::Krb5::GssCredential cred;
Qore::Krb5::Krb5Principal p(\"alice@EXAMPLE.COM\");
Qore::Krb5::GssCredential::impersonateName(cred, p);
", "s4u-domain-test");
        });
    }

    private testS4uImpersonatedClientHelperRequiresNetworkDomain() {
        Program p(PO_NO_NETWORK);
        assertThrows("PARSE-EXCEPTION", sub() {
            p.parse("
%modern
%requires krb5
%requires Krb5Util
Qore::Krb5::GssCredential cred;
Qore::Krb5::Krb5Principal p(\"alice@EXAMPLE.COM\");
Krb5Util::createImpersonatedClientContext(\"HTTP/backend.example.com@EXAMPLE.COM\", cred, p);
", "s4u-helper-domain-test");
        });
    }

    private testS4uImpersonatedClientHelperRejectsEmptyTarget() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-s4u-helper-empty-target");
        Qore::Krb5::Krb5Principal service("HTTP/qorus.example.com@EXAMPLE.COM");
        kt.addEntry(service, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        Qore::Krb5::GssCredential cred = Qore::Krb5::GssCredential::fromKeytab(kt, service);
        Qore::Krb5::Krb5Principal user("alice@EXAMPLE.COM");

        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            Krb5Util::createImpersonatedClientContext("", cred, user);
        });
    }

    private testS4uProxyEmptyCacheRejected() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-s4u-proxy-empty");
        cache.initialize(client);

        Qore::Krb5::Krb5Credentials evidence = createTestCredentials();
        Qore::Krb5::Krb5Principal target("HTTP/target.example.com@EXAMPLE.COM");

        assertThrows("KRB5-S4U-PROXY-ERROR", sub() {
            ctx.acquireS4U2ProxyCredentials(cache, evidence, target);
        });
    }

    private testS4uProxySandboxDeny() {
        string cachePath = getSandboxCachePath("s4u-proxy-sandbox");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            nothing sub test_denied_s4u_proxy() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal client(\"alice@EXAMPLE.COM\");
                Qore::Krb5::Krb5Principal server(\"HTTP/qorus.example.com@EXAMPLE.COM\");
                Qore::Krb5::Krb5Credentials evidence(client, server,
                    \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
                    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000, 3000, 0x40, \"abcd\");
                Qore::Krb5::Krb5Principal target(\"HTTP/target.example.com@EXAMPLE.COM\");
                auto cc = ctx.openCredentialCache(\"FILE:%s\");
                ctx.acquireS4U2ProxyCredentials(cc, evidence, target);
            }
        ", cachePath), "sandbox_denied_s4u_proxy");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() {
            p.callFunction("test_denied_s4u_proxy");
        });
        cleanupSandboxCache(cachePath);
    }

    private Qore::Krb5::Krb5Credentials createTestTgt() {
        return createTestTgtWithTimes(1000, 2000, 3000);
    }

    private Qore::Krb5::Krb5Credentials createTestTgtWithTimes(int startTime, int endTime, int renewUntil) {
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal server("krbtgt/EXAMPLE.COM@EXAMPLE.COM");
        Qore::Krb5::Krb5Credentials creds(client, server, getTestKeyHex1(),
            Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, startTime, endTime, renewUntil, 0x40, "abcd");
        return creds;
    }

    private testRenewAndStoreNoTgt() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-renew-no-tgt");
        cache.initialize(client);
        cache.storeCredentials(createTestCredentials());

        hash<Krb5Util::RenewAndStoreResult> result = Krb5Util::renewAndStoreIfNeeded(ctx, cache, 300);
        assertFalse(result.renewed);
        assertFalse(result.was_expired);
        assertFalse(exists result.lifecycle);
        assertFalse(exists result.error);
    }

    private testRenewAndStoreExpired() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-renew-expired");
        cache.initialize(client);
        cache.storeCredentials(createTestTgt());

        # TGT has end_time=2000, which is in the past — should be expired
        hash<Krb5Util::RenewAndStoreResult> result = Krb5Util::renewAndStoreIfNeeded(ctx, cache, 300);
        assertFalse(result.renewed);
        assertTrue(result.was_expired);
        assertTrue(exists result.lifecycle);
        assertTrue(result.lifecycle.expired);
    }

    private testRenewAndStoreValidation() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-renew-validation");
        cache.initialize(client);

        assertThrows("KRB5-RENEW-STORE-ERROR", sub() {
            Krb5Util::renewAndStoreIfNeeded(ctx, cache, -1);
        });
    }

    private testRenewAndStoreLoggerDiagnosticsSafe() {
        Qore::Logger::Logger logger("krb5-renew-store-test", "DEBUG");
        CaptureLogAppender appender();
        logger.addAppender(appender);
        appender.open();

        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-renew-logger");
        cache.initialize(client);
        cache.storeCredentials(createTestTgt());

        Krb5Util::renewAndStoreIfNeeded(ctx, cache, 300, logger);

        list<string> messages = appender.getMessages();
        assertTrue(messages.size() >= 2);
        string combined = foldl $1 + "\n" + $2, messages;
        assertTrue(combined.find("Krb5Util renew-and-store") >= 0);
        assertEq(-1, combined.find(getTestKeyHex1()));
        assertEq(-1, combined.find("abcd"));
    }

    private testCredentialCacheMaintenanceNoTgt() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-maint-no-tgt");
        cache.initialize(client);
        cache.storeCredentials(createTestCredentials());

        hash<Krb5Util::CredentialCacheMaintenanceResult> result =
            Krb5Util::maintainCredentialCache(ctx, cache);
        assertTrue(result.healthy);
        assertFalse(result.renewed);
        assertFalse(result.was_expired);
        assertFalse(exists result.tgt_lifecycle);
        assertTrue(result.warnings.size() > 0);
    }

    private testCredentialCacheMaintenanceMissingTgtError() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-maint-missing-tgt-error");
        cache.initialize(client);

        hash<Krb5Util::CredentialCacheMaintenanceOptions> opts();
        opts.missing_tgt_is_error = True;
        hash<Krb5Util::CredentialCacheMaintenanceResult> result =
            Krb5Util::maintainCredentialCache(ctx, cache, opts);
        assertFalse(result.healthy);
        assertTrue(result.errors.size() > 0);

        opts.fail_fast = True;
        assertThrows("KRB5-CACHE-MAINTENANCE-ERROR", sub() {
            Krb5Util::maintainCredentialCache(ctx, cache, opts);
        });
    }

    private testCredentialCacheMaintenanceExpiredTgt() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-maint-expired-tgt");
        cache.initialize(client);
        cache.storeCredentials(createTestTgt());

        hash<Krb5Util::CredentialCacheMaintenanceResult> result =
            Krb5Util::maintainCredentialCache(ctx, cache);
        assertTrue(result.healthy);
        assertTrue(result.was_expired);
        assertFalse(result.renewed);
        assertTrue(exists result.tgt_lifecycle);
        assertTrue(result.tgt_lifecycle.expired);
    }

    private testCredentialCacheMaintenanceDryRunRenewal() {
        int t = now().getEpochSeconds();
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-maint-dry-run-renewal");
        cache.initialize(client);
        cache.storeCredentials(createTestTgtWithTimes(t - 10, t + 100, t + 3600));

        hash<Krb5Util::CredentialCacheMaintenanceOptions> opts();
        opts.renew_threshold_seconds = 300;
        opts.dry_run = True;
        opts.service_principals = ("HTTP/target.example.com@EXAMPLE.COM",);

        hash<Krb5Util::CredentialCacheMaintenanceResult> result =
            Krb5Util::maintainCredentialCache(ctx, cache, opts);
        assertTrue(result.healthy);
        assertTrue(result.dry_run);
        assertFalse(result.renewed);
        assertTrue(result.tgt_lifecycle.should_renew);
        assertEq(1, result.service_tickets.size());
        assertTrue(result.service_tickets[0].dry_run);
        assertFalse(result.service_tickets[0].acquired);
    }

    private testCredentialCacheMaintenanceServiceTicketFailure() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cache = ctx.createMemoryCredentialCache(client, "module-krb5-maint-service-failure");
        cache.initialize(client);

        hash<Krb5Util::CredentialCacheMaintenanceOptions> opts();
        opts.service_principals = ("HTTP/target.example.com@EXAMPLE.COM",);
        hash<Krb5Util::CredentialCacheMaintenanceResult> result =
            Krb5Util::maintainCredentialCache(ctx, cache, opts);
        assertFalse(result.healthy);
        assertEq(1, result.service_tickets.size());
        assertFalse(result.service_tickets[0].acquired);
        assertTrue(exists result.service_tickets[0].error);

        opts.fail_fast = True;
        assertThrows("KRB5-CACHE-MAINTENANCE-ERROR", sub() {
            Krb5Util::maintainCredentialCache(ctx, cache, opts);
        });
    }

