    private testSpnegoParseResponseInvalidDataRejected() {
        # Valid base64 but not a valid SPNEGO NegTokenResp
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::parseSpnegoResponse(make_base64_string(<deadbeef>));
        });
    }

    private testSpnegoParseResponseLengthBoundsRejected() {
        # Outer NegTokenResp length exceeds available data.
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::parseSpnegoResponse(make_base64_string(<a1053000>));
        });

        # responseToken OCTET STRING length exceeds the containing field.
        assertThrows("KRB5-SPNEGO-ERROR", sub() {
            Krb5Util::parseSpnegoResponse(make_base64_string(<a1083006a2040408cafe>));
        });
    }

    private testSpnegoRoundTrip() {
        # Build a NegTokenResp manually with a known responseToken
        string knownTokenHex = "cafebabe12345678";
        binary knownToken = parse_hex_string(knownTokenHex);

        # NegTokenResp ::= SEQUENCE {
        #   [0] ENUMERATED { accept-incomplete(1) }   -- negState
        #   [2] OCTET STRING { responseToken }
        # }
        # negState: a0 03 0a 01 01  (ENUMERATED 1 = accept-incomplete)
        binary negState = parse_hex_string("a003" + "0a0101");
        # responseToken: a2 LEN 04 LEN <token>
        binary octetString = <04> + binary(chr(knownToken.size())) + knownToken;
        binary responseTokenField = <a2> + binary(chr(octetString.size())) + octetString;
        binary seqContent = negState + responseTokenField;
        binary seq = <30> + binary(chr(seqContent.size())) + seqContent;
        binary negTokenResp = <a1> + binary(chr(seq.size())) + seq;

        string b64 = make_base64_string(negTokenResp);
        string extracted = Krb5Util::parseSpnegoResponse(b64);
        assertEq(knownTokenHex, extracted);
    }

    private testRenewCredentialsEmptyCache() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("alice@EXAMPLE.COM");
        auto cc = ctx.openCredentialCache("MEMORY:renew-empty-test");
        assertThrows("KRB5-RENEW-ERROR", sub() {
            ctx.renewCredentials(cc, p);
        });
    }

    private testRenewCredentialsSandboxDeny() {
        string cachePath = getSandboxCachePath("renew-deny");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            nothing sub test_denied_renew() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                auto cc = ctx.openCredentialCache(\"FILE:%s\");
                ctx.renewCredentials(cc, principal);
            }
        ", cachePath), "sandbox_denied_renew");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() {
            p.callFunction("test_denied_renew");
        });
        cleanupSandboxCache(cachePath);
    }

    private testRenewCredentialsRequiresNetworkDomain() {
        Program p(PO_MODERN | PO_NO_NETWORK);
        p.loadModule("krb5");
        assertThrows("PARSE-EXCEPTION", "renewCredentials", sub() {
            p.parse("
                nothing sub test_network_blocked_renew() {
                    Qore::Krb5::Krb5Context ctx();
                    Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                    auto cc = ctx.openCredentialCache(\"MEMORY:nd-renew\");
                    ctx.renewCredentials(cc, principal);
                }
            ", "no_network_renew");
        });
    }

