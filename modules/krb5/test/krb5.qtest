    private testPrincipalThreeComponents() {
        Qore::Krb5::Krb5Principal p("HTTP/host.example.com/extra@REALM");
        assertEq(3, p.getComponentCount());
        assertEq("HTTP", p.getComponent(0));
        assertEq("host.example.com", p.getComponent(1));
        assertEq("extra", p.getComponent(2));
        assertEq("REALM", p.getRealm());
    }

