    private testGssCredentialRequiresFilesystemDomain() {
        # When filesystem access is denied, the GssCredential class itself is
        # inaccessible because it carries dom=FILESYSTEM.
        Program p(PO_MODERN | PO_NO_FILESYSTEM);
        p.loadModule("krb5");
        assertThrows("INVALID-METHOD", sub() {
            p.parse("
                nothing sub test_gss_cred_blocked() {
                    Qore::Krb5::GssCredential::fromCredentialCache(NOTHING);
                }
            ", "no_fs_gss_cred");
        });
    }

    private testKrb5CredentialsHasNoDomain() {
        # Krb5Credentials must construct from hex without requiring any domain.
        Program p(PO_MODERN | PO_NO_NETWORK | PO_NO_FILESYSTEM);
        p.loadModule("krb5");
        p.parse("
            string sub build_creds() {
                Qore::Krb5::Krb5Principal client(\"alice@EXAMPLE.COM\");
                Qore::Krb5::Krb5Principal server(\"HTTP/qorus.example.com@EXAMPLE.COM\");
                Qore::Krb5::Krb5Credentials creds(client, server,
                    \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
                    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000);
                return creds.getInfo().client;
            }
        ", "sandboxed_creds_build");
        assertEq("alice@EXAMPLE.COM", p.callFunction("build_creds"));
    }

    private testPrincipalCopyAcrossContexts() {
        Qore::Krb5::Krb5Principal a("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal b = a.copy();
        assertEq("alice@EXAMPLE.COM", b.toString());
        assertEq("EXAMPLE.COM", b.getRealm());
        assertTrue(a.equals(b));
        # copy must be independent: source destruction must not touch dest.
        delete a;
        assertEq("alice@EXAMPLE.COM", b.toString());
    }

    private testStoreAndListAcrossContexts() {
        # store a Krb5Credentials built via a different krb5_context than the cache;
        # verifies that QoreKrb5CredentialCache::storeCredentials copies across contexts.
        Qore::Krb5::Krb5Context cache_ctx();
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        auto cc = cache_ctx.createMemoryCredentialCache(client, "module-krb5-cross-context");

        Qore::Krb5::Krb5Credentials creds = createTestCredentials();
        cc.storeCredentials(creds);

        list<hash<Qore::Krb5::Krb5CredentialsInfo>> entries = cc.listCredentials();
        assertEq(1, entries.size());
        assertEq("alice@EXAMPLE.COM", entries[0].client);
    }

    private testEnctypeNameFallback() {
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal server("HTTP/qorus.example.com@EXAMPLE.COM");
        Qore::Krb5::Krb5Credentials creds(client, server, getTestKeyHex1(),
            0x7fff, 1000, 2000);
        hash<Qore::Krb5::Krb5CredentialsInfo> info = creds.getInfo();
        assertEq(0x7fff, info.enctype);
        # Exact fallback format may vary across MIT krb5 versions but must be non-empty.
        assertFalse(info.enctype_name == "");
    }

    private testCacheStoreSandboxDeny() {
        string cachePath = getSandboxCachePath("store-deny");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            nothing sub test_denied_cache_store() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal client(\"alice@EXAMPLE.COM\");
                Qore::Krb5::Krb5Principal server(\"HTTP/qorus.example.com@EXAMPLE.COM\");
                Qore::Krb5::Krb5Credentials creds(client, server,
                    \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
                    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000, 3000, 0x40, \"abcd\");
                auto cc = ctx.openCredentialCache(\"FILE:%s\");
                cc.initialize(client);
                cc.storeCredentials(creds);
            }
        ", cachePath), "sandbox_denied_cache_store");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() {
            p.callFunction("test_denied_cache_store");
        });
        cleanupSandboxCache(cachePath);
    }

