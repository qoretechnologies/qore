#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

/*
    Copyright (C) 2026 Qore Technologies, s.r.o., all rights reserved

    Integration tests for Kerberos/SPNEGO HTTP Negotiate authentication
    against an external Apache mod_auth_gssapi implementation.
*/

%modern

%requires ../../../qlib/QUnit.qm
%requires ../../../qlib/DataProvider
%requires ../../../qlib/ConnectionProvider
%requires ../../../qlib/RestSchemaValidator.qm
%requires ../../../qlib/Swagger.qm
%requires ../../../qlib/OpenApi3.qm
%requires ../../../qlib/HttpClientIo
%requires ../../../qlib/HttpClientStreamingIo
%requires ../../../qlib/RestClient.qm
%requires ../../../qlib/RestClientIo.qm
%requires krb5

%requires json

%exec-class RestClientIoKrb5AuthProxyIntegrationTest

class AuthProxySseObserver inherits DataProvider::Observer {
    public {
        list<hash<auto>> events = ();
        Mutex m();
        Condition cond();
        int expected_count;
    }

    constructor(int expected_count) {
        self.expected_count = expected_count;
    }

    update(string event_id, hash<auto> data) {
        AutoLock al(m);
        push events, {
            "event_id": event_id,
            "data": data,
        };
        cond.broadcast();
    }

    bool waitForEvents(timeout t = 30s) {
        AutoLock al(m);
        date end_time = now_us() + t;
        while (events.size() < expected_count) {
            date remaining = end_time - now_us();
            if (remaining <= 0us) {
                return False;
            }
            cond.wait(m, remaining);
        }
        return True;
    }
}

public class RestClientIoKrb5AuthProxyIntegrationTest inherits QUnit::Test {
    private {
        bool cache_ready = False;
    }

    constructor() : Test("RestClientIoKrb5AuthProxyIntegrationTest", "1.0") {
        addTestCase("sync RestClient negotiate through external auth proxy",
            \testSyncRestClientNegotiate());
        addTestCase("poll RestClient negotiate through external auth proxy",
            \testPollRestClientNegotiate());
        addTestCase("sync RestClientIo negotiate through external auth proxy",
            \testSyncRestClientIoNegotiate());
        addTestCase("async RestClientIo negotiate through external auth proxy",
            \testAsyncRestClientIoNegotiate());
        addTestCase("SSE RestClientIo negotiate through external auth proxy",
            \testSseRestClientIoNegotiate());
        addTestCase("SSE observable RestClientIo negotiate through external auth proxy",
            \testSseObservableRestClientIoNegotiate());
        addTestCase("notifier async RestClientIo negotiate through external auth proxy",
            \testNotifierAsyncRestClientIoNegotiate());
        addTestCase("cancellable async RestClientIo negotiate through external auth proxy",
            \testCancellableAsyncRestClientIoNegotiate());
        addTestCase("signed async RestClientIo negotiate through external auth proxy",
            \testSignedAsyncRestClientIoNegotiate());
        addTestCase("RestClientIo ping negotiate through external auth proxy",
            \testPingNegotiate());

        set_return_value(main());
    }

    private string requireEnv(string name) {
        *string value = getenv(name);
        if (!value || value == "") {
            testSkip(sprintf("environment variable %s is not set", name));
        }
        return value;
    }

    private string clientPrincipal() {
        return requireEnv("QORE_KRB5_AUTH_PROXY_CLIENT_PRINCIPAL");
    }

    private timeout testTimeout() {
        *string value = getenv("QORE_KRB5_AUTH_PROXY_TEST_TIMEOUT");
        return value && value != "" ? seconds(value.toInt()) : 30s;
    }

    private hash<auto> getClientOptions() {
        setupCredentialCache();
        timeout to = testTimeout();
        return {
            "url": requireEnv("QORE_KRB5_AUTH_PROXY_URL"),
            "data": "json",
            "connect_timeout": to,
            "timeout": to,
            "negotiate_auth": True,
            "negotiate_service_principal": requireEnv("QORE_KRB5_AUTH_PROXY_SERVICE_PRINCIPAL"),
            "negotiate_credential_cache": requireEnv("QORE_KRB5_AUTH_PROXY_CREDENTIAL_CACHE"),
        };
    }

    private setupCredentialCache() {
        if (cache_ready) {
            return;
        }

        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal principal(clientPrincipal());
        hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
        opts.canonicalize = True;

        Qore::Krb5::Krb5Credentials creds = ctx.acquireCredentialsWithPassword(
            principal, requireEnv("QORE_KRB5_AUTH_PROXY_CLIENT_PASSWORD"), opts);

        auto cc = ctx.openCredentialCache(requireEnv("QORE_KRB5_AUTH_PROXY_CREDENTIAL_CACHE"));
        cc.initialize(principal);
        cc.storeCredentials(creds);
        cache_ready = True;
    }

    private assertAuthenticatedBody(hash<auto> body, string path) {
        assertEq(path, body.path);
        assertEq(clientPrincipal(), body.remote_user);
    }

    private assertBackendSawAuthenticatedRequest(string path) {
        string log_path = requireEnv("QORE_KRB5_AUTH_PROXY_BACKEND_LOG");
        string content = ReadOnlyFile::readTextFile(log_path);
        foreach string line in (content.split("\n")) {
            if (!line.val()) {
                continue;
            }
            hash<auto> request = parse_json(line);
            if (request.path == path && request.remote_user == clientPrincipal()) {
                return;
            }
        }
        assertTrue(False, sprintf("backend did not see authenticated request %y; log: %s",
            path, content));
    }

    private static *hash<ExceptionInfo> drivePingOp(Qore::AbstractPollOperation op) {
        try {
            while (!op.goalReached()) {
                *hash<SocketPollInfo> info = op.continuePoll();
                if (!info) {
                    break;
                }
                Socket::poll((info,), 10s);
            }
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        return NOTHING;
    }

    testSyncRestClientNegotiate() {
        RestClient rest(getClientOptions());
        hash<auto> response = rest.get("/api/restclient");
        assertEq(200, response.status_code);
        assertAuthenticatedBody(response.body, "/api/restclient");
    }

    testPollRestClientNegotiate() {
        RestClient rest(getClientOptions());
        Qore::AbstractPollOperation op = rest.startPollGet("/api/restclient-poll");
        *hash<ExceptionInfo> ex = drivePingOp(op);
        on_error printf("krb5 auth proxy poll RestClient error: %y\n", ex);
        assertFalse(exists ex, "Negotiate-enabled poll RestClient should authenticate through the external auth proxy");
        assertTrue(op.goalReached());
        hash<auto> response = op.getOutput();
        assertEq(200, response.status_code);
        assertAuthenticatedBody(response.body, "/api/restclient-poll");
    }

    testSyncRestClientIoNegotiate() {
        RestClientIo::RestClientIo rest(getClientOptions());
        on_exit rest.close();
        hash<RestClient::RestResponseInfo> response = rest.restGet("/api/restclientio");
        assertEq(200, response.status_code);
        assertAuthenticatedBody(response.body, "/api/restclientio");
    }

    testAsyncRestClientIoNegotiate() {
        RestClientIo::RestClientIo rest(getClientOptions());
        on_exit rest.close();
        RestClientIo::RestFuture f = rest.restGetAsync("/api/restclientio-async");
        hash<RestClient::RestResponseInfo> response = f.get(testTimeout());
        assertEq(200, response.status_code);
        assertAuthenticatedBody(response.body, "/api/restclientio-async");
    }

    testSseRestClientIoNegotiate() {
        RestClientIo::RestClientIo rest(getClientOptions());
        on_exit rest.close();
        SseStreamReader reader = rest.restSseReader("GET",
            "/api/restclientio-sse", NOTHING, NOTHING);
        on_exit reader.cancel();

        *hash<SseMessageInfo> evt = reader.readEvent(testTimeout());
        assertTrue(exists evt, "Negotiate-enabled RestClientIo SSE reader should receive an event");
        assertEq("auth", evt.event);
        assertAuthenticatedBody(parse_json(evt.data), "/api/restclientio-sse");
    }

    testSseObservableRestClientIoNegotiate() {
        RestClientIo::RestClientIo rest(getClientOptions());
        on_exit rest.close();
        HttpClientStreamingIo::SseObservable obs = rest.restObserveSse("GET",
            "/api/restclientio-sse", NOTHING, NOTHING, {"serialization": "none"});
        AuthProxySseObserver observer(2);
        obs.registerObserver(observer);
        obs.observersReady();
        on_exit obs.stopEvents();

        bool got_events = observer.waitForEvents(testTimeout());
        if (!got_events) {
            printf("SSE observable events before timeout: %y\n", observer.events);
        }
        assertTrue(got_events,
            sprintf("Negotiate-enabled RestClientIo SSE observable should receive an event; events=%y",
                observer.events));
        assertEq(HttpClientStreamingIo::EVENT_SSE_CONNECTED, observer.events[0].event_id);
        assertEq(HttpClientStreamingIo::EVENT_SSE_DATA, observer.events[1].event_id);
        assertEq("auth", observer.events[1].data.event);
        assertAuthenticatedBody(parse_json(observer.events[1].data.data),
            "/api/restclientio-sse");
    }

    testNotifierAsyncRestClientIoNegotiate() {
        RestClientIo::RestClientIo rest(getClientOptions());
        on_exit rest.close();
        EventNotifier notifier();
        hash<auto> result = rest.restDoRequestAsyncWithNotifier("GET",
            "/api/restclientio-notifier", NOTHING, NOTHING, notifier);
        assertTrue(rest.getConnectionManager().getController().waitForNotifier(notifier, testTimeout()),
            "notifier async RestClientIo Negotiate should signal completion");
        notifier.acknowledge();
        hash<auto> response = result.future.get();
        assertEq(200, response.status_code);
        assertAuthenticatedBody(parse_json(response.body.toString()), "/api/restclientio-notifier");
    }

    testCancellableAsyncRestClientIoNegotiate() {
        RestClientIo::RestClientIo rest(getClientOptions());
        on_exit rest.close();
        HttpClientIo::HttpCancellableFuture f = rest.restDoRequestCancellableAsync("GET",
            "/api/restclientio-cancellable", NOTHING, NOTHING);
        hash<auto> response = f.get(testTimeout());
        assertEq(200, response.status_code);
        assertAuthenticatedBody(parse_json(response.body.toString()), "/api/restclientio-cancellable");
    }

    testSignedAsyncRestClientIoNegotiate() {
        RestClientIo::RestClientIo rest(getClientOptions());
        on_exit rest.close();
        code signer = auto sub (hash<auto> info) {
            return "krb5-auth-proxy-signature:" + info.path;
        };
        RestClientIo::RestFuture f = rest.doSignedRequestAsync("x-test-signature",
            signer, "GET", "/api/restclientio-signed", NOTHING);
        hash<RestClient::RestResponseInfo> response = f.get(testTimeout());
        assertEq(200, response.status_code);
        assertAuthenticatedBody(response.body, "/api/restclientio-signed");
    }

    testPingNegotiate() {
        hash<auto> opts = getClientOptions() - "url" + {
            "ping_method": "GET",
            "ping_path": "/api/ping",
        };
        RestClient::RestConnection rc("krb5-auth-proxy-ping", "krb5-auth-proxy-ping",
            requireEnv("QORE_KRB5_AUTH_PROXY_URL"), {}, opts);
        Qore::AbstractPollOperation op = rc.startPollConnect();
        assertEq("ping", op.getGoal());

        *hash<ExceptionInfo> ex = drivePingOp(op);
        on_error printf("krb5 auth proxy ping error: %y\n", ex);
        assertFalse(exists ex, "Negotiate-enabled ping should authenticate through the external auth proxy");
        assertTrue(op.goalReached());
        assertBackendSawAuthenticatedRequest("/api/ping");
    }
}
