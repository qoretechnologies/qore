#!/usr/bin/env qore
# test-platform: macos - the default credential and the credential stores of the system Kerberos/GSS-API library
%modern

/* Copyright (C) 2026 Qore Technologies, s.r.o. */

%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires Util
%requires krb5
%requires Krb5Util
%requires RestClientIo
%requires ../../../examples/test/qore/security/ambient-host/AmbientCallers.qm

%exec-class Krb5AmbientCredentialTest

#! The Kerberos credentials of the host are not used for code that may not receive the host's secrets (qore#6844)
/** The process's default credential, the default credential cache and keytab, the credential caches of the host and
    the credential stores that are not files of the caller's own are refused by Krb5Util and by the classes of the krb5
    module to code restricted from external information and to sandboxed code, also through a lent object, unless the
    host grants them; a credential store that the caller names and may use is its own
*/
class Krb5AmbientCredentialTest inherits QUnit::Test {
    public {
        #! the code of the Programs; each function reports what it gets, or the error it gets
        const Source = "%modern
%requires krb5
%requires Krb5Util
%requires AmbientCallers
%requires RestClientIo
auto sub try_call(code c) {
    try {
        return c();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
auto sub make_context(*string ccache, *string keytab) {
    return try_call(auto sub () {
        return Krb5Util::createHttpNegotiateClientContext(\"HTTP@host.example\", ccache, keytab,
            <Qore::Krb5::GssClientContextOptions>{\"name_type\": \"hostbased-service\"}).className();
    });
}
auto sub native_step() {
    return try_call(auto sub () {
        Qore::Krb5::GssClientContext ctx(\"HTTP@host.example\",
            <Qore::Krb5::GssClientContextOptions>{\"name_type\": \"hostbased-service\"});
        return ctx.step();
    });
}
auto sub lent_step(object ctx) {
    return try_call(auto sub () { return ctx.step(); });
}
hash<auto> sub defaults() {
    Qore::Krb5::Krb5Context kctx();
    return {
        \"cache_name\": try_call(\\kctx.getDefaultCredentialCacheName()),
        \"keytab_name\": try_call(\\kctx.getDefaultKeytabName()),
        \"cache\": try_call(auto sub () { return kctx.openDefaultCredentialCache().className(); }),
        \"keytab\": try_call(auto sub () { return kctx.openDefaultKeytab().className(); }),
        \"caches\": try_call(\\kctx.listCredentialCaches()),
    };
}
auto sub named_cache(string name) {
    return try_call(auto sub () {
        Qore::Krb5::Krb5Context kctx();
        return Qore::Krb5::GssCredential::fromCredentialCache(kctx.openCredentialCache(name)).className();
    });
}
auto sub rest_negotiate(string url) {
    return try_call(auto sub () {
        RestClientIo::RestClientIo rest({\"url\": url, \"negotiate_auth\": True, \"data\": \"text\"});
        on_exit rest.close();
        return rest.restGet(\"/negotiate\").status_code;
    });
}
auto sub lent_rest(object rest) {
    return try_call(auto sub () { return rest.restGet(\"/negotiate\").status_code; });
}
# the request runs on the threads of the async I/O controller, where the Negotiate retry builds the context
auto sub async_rest(string url) {
    try {
        RestClientIo::RestClientIo rest({\"url\": url, \"negotiate_auth\": True, \"data\": \"text\"});
        on_exit rest.close();
        return rest.restGetAsync(\"/negotiate\").get().status_code;
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
auto sub lent_async_rest(object rest) {
    try {
        return rest.restGetAsync(\"/negotiate\").get().status_code;
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
auto sub realm() {
    return try_call(auto sub () {
        Qore::Krb5::Krb5Context kctx();
        return (kctx.getDefaultRealm(), Qore::Krb5::Krb5Principal::getDefaultRealm());
    });
}
hash<auto> sub environment() {
    return Krb5Util::validateKerberosEnvironment();
}
auto sub grant(string how) {
    # no closure: a policy barrier does not mask the provenance of a callback of the restricted code
    list<auto> args = (\"HTTP@host.example\", NOTHING, NOTHING,
        <Qore::Krb5::GssClientContextOptions>{\"name_type\": \"hostbased-service\"});
    try {
        return (how == \"barrier\"
            ? AmbientCallers::invoke_barrier(NOTHING, \"Krb5Util::createHttpNegotiateClientContext\", args)
            : AmbientCallers::invoke_capability(NOTHING, \"Krb5Util::createHttpNegotiateClientContext\", args))
            .className();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
";

        #! the code of a Program restricted from the file system, which cannot use the classes of the krb5 module
        const FsRestrictedSource = "%modern
%requires Krb5Util
auto sub make_context(*string ccache, *string keytab) {
    try {
        return Krb5Util::createHttpNegotiateClientContext(\"HTTP@host.example\", ccache, keytab,
            <Qore::Krb5::GssClientContextOptions>{\"name_type\": \"hostbased-service\"}).className();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
";

        #! what the error of a refused caller says
        const Refused = "(not available to the calling code|holds the host's credentials)";
    }

    private {
        hash<string, Program> pgms;
    }

    constructor() : Test("Krb5AmbientCredential", "1.0", \ARGV) {
        addTestCase("default credential", \defaultCredentialTest());
        addTestCase("defaults of the native classes", \nativeDefaultsTest());
        addTestCase("lent context", \lentTest());
        addTestCase("named credential stores", \namedStoreTest());
        addTestCase("Kerberos environment", \environmentTest());
        addTestCase("host grants", \grantTest());
        addTestCase("default realm", \realmTest());
        addTestCase("REST Negotiate retry", \restNegotiateTest());
        set_return_value(main());
    }

    globalSetUp() {
        pgms = AmbientCallers::make_programs(Source, "krb5");
    }

    #! the process's default credential, through Krb5Util and the native class
    defaultCredentialTest() {
        foreach string kind in (keys pgms) {
            auto ctx = pgms{kind}.callFunction("make_context");
            auto step = pgms{kind}.callFunction("native_step");
            if (AmbientCallers::may_receive(kind)) {
                assertEq("GssClientContext", ctx, kind);
                # no credential is available here: the library's own error
                assertNRegex(Refused, sprintf("%y", step), kind);
            } else {
                assertRegex("^KRB5-GSS-ERROR: .*" + Refused, ctx, kind);
                assertRegex("^KRB5-GSS-ERROR: .*" + Refused, step, kind);
            }
        }
    }

    #! the default credential cache and keytab and the host's credential caches
    nativeDefaultsTest() {
        foreach string kind in (keys pgms) {
            hash<auto> h = pgms{kind}.callFunction("defaults");
            foreach hash<auto> i in (h.pairIterator()) {
                string label = kind + ": " + i.key;
                if (AmbientCallers::may_receive(kind)) {
                    assertNRegex(Refused, sprintf("%y", i.value), label);
                } else {
                    assertRegex("^KRB5-(CACHE|KEYTAB)-ERROR: .*" + Refused, i.value, label);
                }
            }
        }
    }

    #! a context that the host creates and lends uses the host's default credential only for a caller that may
    #! receive it
    lentTest() {
        foreach string kind in (keys pgms) {
            GssClientContext ctx("HTTP@host.example", <GssClientContextOptions>{"name_type": "hostbased-service"});
            auto v = pgms{kind}.callFunction("lent_step", ctx);
            if (AmbientCallers::may_receive(kind)) {
                assertNRegex(Refused, sprintf("%y", v), kind);
            } else {
                assertRegex("^KRB5-GSS-ERROR: .*" + Refused, v, kind);
            }
        }
    }

    #! a credential store that the caller names: a memory store is its own, a store of the host (KEYRING) is not
    namedStoreTest() {
        string mem = "MEMORY:krb5-ambient-" + get_random_string(8);
        foreach string kind in (keys pgms) {
            assertNRegex(Refused, sprintf("%y", pgms{kind}.callFunction("named_cache", mem)), kind + ": memory");
            auto v = pgms{kind}.callFunction("named_cache", "KEYRING:persistent:krb5-ambient");
            # a platform without the KEYRING backend cannot resolve the name for anybody
            if (v =~ /resolving credential cache/) {
                continue;
            }
            if (AmbientCallers::may_receive(kind)) {
                assertNRegex(Refused, sprintf("%y", v), kind + ": keyring");
            } else {
                assertRegex("^KRB5-CACHE-ERROR: .*" + Refused, v, kind + ": keyring");
            }
        }
        # a file that code restricted from the file system names
        Program p(PO_NEW_STYLE | PO_NO_FILESYSTEM | PO_NO_EXTERNAL_INFO);
        p.parse(FsRestrictedSource, "fs-restricted");
        string path = sprintf("FILE:%s/krb5-ambient-%s", tmp_location(), get_random_string(12));
        assertRegex("^KRB5-CACHE-ERROR: .*restricted from the file system", p.callFunction("make_context", path),
            "ccache");
        assertRegex("^KRB5-KEYTAB-ERROR: .*restricted from the file system",
            p.callFunction("make_context", NOTHING, path), "keytab");
        # for code that may use the file system, the file is opened (and does not exist)
        foreach string kind in (keys pgms) {
            assertNRegex("restricted from the file system|" + Refused,
                sprintf("%y", pgms{kind}.callFunction("make_context", path)), kind + ": ccache file");
        }
    }

    #! Krb5Util::validateKerberosEnvironment() reports nothing of the host's defaults to such code
    environmentTest() {
        foreach string kind in (keys pgms) {
            hash<auto> h = pgms{kind}.callFunction("environment");
            if (AmbientCallers::may_receive(kind)) {
                assertEq(Type::String, h.default_cache_name.type(), kind);
            } else {
                assertEq(NOTHING, h.default_cache_name, kind);
                assertEq(NOTHING, h.default_keytab_name, kind);
                assertFalse(h.cache_accessible, kind);
            }
        }
    }

    #! the host's grants: library code that establishes a policy barrier, or calls a system-policy capability, uses
    #! the host's default credential for any caller
    grantTest() {
        foreach string kind in (keys pgms) {
            foreach string how in (("barrier", "capability")) {
                assertEq("GssClientContext", pgms{kind}.callFunction("grant", how), kind + ": " + how);
            }
        }
    }

    #! the Negotiate retry of a REST client, which can run on a thread of the async I/O controller, creates no
    #! context with the default credential for a caller that may not receive it, also for a client that the host lent
    restNegotiateTest() {
        AmbientCallers::FakeMetadataServer srv();
        foreach string kind in (keys pgms) {
            auto v = pgms{kind}.callFunction("rest_negotiate", srv.url);
            RestClientIo lent({"url": srv.url, "negotiate_auth": True, "data": "text"});
            on_exit lent.close();
            auto lv = pgms{kind}.callFunction("lent_rest", lent);
            auto av = pgms{kind}.callFunction("async_rest", srv.url);
            auto lav = pgms{kind}.callFunction("lent_async_rest", lent);
            foreach hash<auto> i in ({"sync": v, "lent": lv, "async": av, "lent async": lav}.pairIterator()) {
                if (AmbientCallers::may_receive(kind)) {
                    assertNRegex(Refused, sprintf("%y", i.value), kind + ": " + i.key);
                } else {
                    assertRegex(Refused, sprintf("%y", i.value), kind + ": " + i.key);
                }
            }
        }
    }

    #! the default realm is configuration of the host: refused only to code restricted from external information
    realmTest() {
        foreach string kind in (keys pgms) {
            auto v = pgms{kind}.callFunction("realm");
            if (AmbientCallers::may_read(kind)) {
                assertNRegex("not available to code restricted", sprintf("%y", v), kind);
            } else {
                assertRegex("^KRB5-REALM-ERROR: .*not available to code restricted from external information", v, kind);
            }
        }
    }
}
