#!/usr/bin/env qore
# test-platform: macos - the default credential and the credential stores of the system Kerberos/GSS-API library
%modern

/* Copyright (C) 2026 Qore Technologies, s.r.o. */

%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires Util
%requires krb5
%requires Krb5Util

%exec-class Krb5AmbientCredentialTest

#! The HTTP Negotiate client of Krb5Util uses no default Kerberos credential of the process for code restricted from
#! external information, and opens no credential store that code restricted from the file system names (qore#6844)
class Krb5AmbientCredentialTest inherits QUnit::Test {
    public {
        #! the code of the Programs; it reports the class of the context it gets, or the error it gets
        const Source = "%modern
%requires Krb5Util
string sub make_context(*string ccache, *string keytab) {
    try {
        object ctx = Krb5Util::createHttpNegotiateClientContext(\"HTTP@host.example\", ccache, keytab,
            <Qore::Krb5::GssClientContextOptions>{\"name_type\": \"hostbased-service\"});
        return ctx.className();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
";
    }

    constructor() : Test("Krb5AmbientCredential", "1.0", \ARGV) {
        addTestCase("default credential", \defaultCredentialTest());
        addTestCase("named credential stores", \namedStoreTest());
        set_return_value(main());
    }

    private Program make(int po, bool sandboxed = False) {
        Program p(PO_NEW_STYLE | po);
        if (sandboxed) {
            SandboxManager sm();
            sm.setNetworkDefaultPolicy(True);
            sm.setFilesystemDefaultPolicy(True);
            p.setSandboxManager(sm);
        }
        p.parse(Source, "krb5");
        return p;
    }

    #! the process's default credential is the host's
    defaultCredentialTest() {
        string host = Krb5Util::createHttpNegotiateClientContext("HTTP@host.example", NOTHING, NOTHING,
            <Qore::Krb5::GssClientContextOptions>{"name_type": "hostbased-service"}).className();
        assertEq("GssClientContext", host);
        foreach hash<auto> i in ({
                "restricted": make(PO_NO_EXTERNAL_INFO),
                "sandboxed restricted": make(PO_NO_EXTERNAL_INFO, True),
            }.pairIterator()) {
            assertRegex("^KRB5-GSS-ERROR: .*default Kerberos credential.*restricted from external information",
                i.value.callFunction("make_context"), i.key);
        }
        foreach hash<auto> i in ({
                "unrestricted": make(0),
                "sandboxed": make(0, True),
                # a restriction of another domain does not count
                "no file system": make(PO_NO_FILESYSTEM),
            }.pairIterator()) {
            assertEq(host, i.value.callFunction("make_context"), i.key);
        }
    }

    #! a credential cache or keytab that the caller names is opened only for a caller that may use the file system
    namedStoreTest() {
        string path = sprintf("FILE:%s/krb5-ambient-%s", tmp_location(), get_random_string(12));
        Program p = make(PO_NO_FILESYSTEM);
        assertRegex("^KRB5-CACHE-ERROR: .*restricted from the file system", p.callFunction("make_context", path), "ccache");
        assertRegex("^KRB5-KEYTAB-ERROR: .*restricted from the file system", p.callFunction("make_context", NOTHING, path),
            "keytab");
        # for other code, the store is opened (and does not exist)
        foreach hash<auto> i in ({"unrestricted": make(0), "no external info": make(PO_NO_EXTERNAL_INFO)}
                .pairIterator()) {
            assertNRegex("restricted from the file system", i.value.callFunction("make_context", path), i.key);
            assertNRegex("restricted from the file system", i.value.callFunction("make_context", NOTHING, path), i.key);
        }
    }
}
