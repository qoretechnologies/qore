#include "krb5-module.h"

//! Kerberos credential-cache wrapper
/** This class wraps a single credential cache and provides safe inspection and
    initialization helpers.
*/
qclass Krb5CredentialCache [arg=QoreKrb5CredentialCache* cache; ns=Qore::Krb5; dom=FILESYSTEM; flags=final];

//! Returns the backend-specific cache name
/**
*/
string Krb5CredentialCache::getName() [flags=CONSTANT] {
    return cache->getName();
}

//! Returns the credential-cache backend type
/**
*/
string Krb5CredentialCache::getType() [flags=CONSTANT] {
    return cache->getType();
}

//! Returns the full credential-cache specifier
/** @throw KRB5-CACHE-ERROR if the full name cannot be read
*/
string Krb5CredentialCache::getFullName() [flags=CONSTANT] {
    return cache->getFullName(xsink);
}

//! Initializes the credential cache with a primary principal
/** @param principal the primary principal to associate with the cache

    @throw KRB5-CACHE-ERROR if the cache cannot be initialized
    @throw KRB5-SANDBOX-ERROR if the cache backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed cache is outside the filesystem sandbox
*/
nothing Krb5CredentialCache::initialize(Krb5Principal[QoreKrb5Principal] principal) {
    cache->initialize(**principal, xsink);
}

//! Stores credentials in the cache
/** @param creds credentials to store

    @throw KRB5-CACHE-ERROR if the credentials cannot be stored
    @throw KRB5-SANDBOX-ERROR if the cache backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed cache is outside the filesystem sandbox
*/
nothing Krb5CredentialCache::storeCredentials(Krb5Credentials[QoreKrb5Credentials] creds) {
    cache->storeCredentials(**creds, xsink);
}

//! Lists credential metadata stored in the cache
/** @return a list of @ref Qore::Krb5::Krb5CredentialsInfo hashes, one per stored credential

    @throw KRB5-CACHE-ERROR if the cache cannot be enumerated
    @throw KRB5-CREDENTIALS-ERROR if credential metadata cannot be rendered
    @throw KRB5-SANDBOX-ERROR if the cache backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed cache is outside the filesystem sandbox
*/
list<hash<Krb5CredentialsInfo>> Krb5CredentialCache::listCredentials() [flags=CONSTANT] {
    return cache->listCredentials(xsink);
}

//! Returns True if the cache contains a primary principal
/** @throw KRB5-CACHE-ERROR if the cache cannot be read
    @throw KRB5-SANDBOX-ERROR if the cache backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed cache is outside the filesystem sandbox
*/
bool Krb5CredentialCache::hasPrimaryPrincipal() [flags=CONSTANT] {
    return cache->hasPrimaryPrincipal(xsink);
}

//! Returns the credential cache primary principal
/** @throw KRB5-CACHE-ERROR if the cache has no primary principal or cannot be read
    @throw KRB5-PRINCIPAL-ERROR if the principal cannot be copied into a new context
    @throw KRB5-SANDBOX-ERROR if the cache backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed cache is outside the filesystem sandbox
*/
Krb5Principal Krb5CredentialCache::getPrimaryPrincipal() [flags=CONSTANT] {
    SimpleRefHolder<QoreKrb5Principal> principal(cache->getPrimaryPrincipal(xsink));
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_KRB5PRINCIPAL, getProgram()), xsink);
    rv->setPrivate(CID_KRB5PRINCIPAL, principal.release());
    return rv.release();
}
