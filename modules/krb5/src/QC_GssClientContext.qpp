#include "krb5-module.h"

//! Initiator-side GSSAPI client context
/** This class supports target-name setup and iterative initiator token generation
    with hex-encoded tokens, plus optional channel bindings and message wrap/unwrap
    helpers for negotiated SASL/GSSAPI integrity or confidentiality layers.
*/
qclass GssClientContext [arg=QoreGssClientContext* ctx; ns=Qore::Krb5; dom=NETWORK; flags=final];

//! Options for GSSAPI initiator contexts
/**
*/
hashdecl Qore::Krb5::GssClientContextOptions {
    //! Requested GSS flags bitmask; omit for the secure module default
    *int flags;

    //! Requested security-context lifetime in seconds; 0 means default
    *int lifetime;

    //! Mechanism selector; supported values are \c "kerberos" and \c "default"
    *string mechanism;

    //! GSSAPI target-name type; supported values are \c "krb5-principal", \c "hostbased-service", and \c "default"
    *string name_type;

    //! Optional channel-binding initiator address type; defaults to \c GSS_AF_NULLADDR
    *int channel_binding_initiator_addrtype;

    //! Optional channel-binding initiator address encoded as hexadecimal
    *string channel_binding_initiator_address_hex;

    //! Optional channel-binding acceptor address type; defaults to \c GSS_AF_NULLADDR
    *int channel_binding_acceptor_addrtype;

    //! Optional channel-binding acceptor address encoded as hexadecimal
    *string channel_binding_acceptor_address_hex;

    //! Optional channel-binding application data encoded as hexadecimal
    *string channel_binding_application_data_hex;
}

//! Result of a single GSSAPI initiator context step
/**
*/
hashdecl Qore::Krb5::GssStepInfo {
    //! \c True if negotiation is complete after this step
    bool complete;

    //! Negotiated GSS flags as an integer bitmask
    int flags;

    //! Reported security-context lifetime in seconds
    int lifetime;

    //! Hex-encoded output token to send to the acceptor, or \c NOTHING if none was produced
    *string token;
}

//! Result of a GSSAPI @ref Qore::Krb5::GssClientContext::wrap() operation
/**
*/
hashdecl Qore::Krb5::GssWrapInfo {
    //! Hex-encoded wrapped token
    string token;

    //! True if confidentiality was applied in addition to integrity
    bool confidential;
}

//! Result of a GSSAPI @ref Qore::Krb5::GssClientContext::unwrap() operation
/**
*/
hashdecl Qore::Krb5::GssUnwrapInfo {
    //! Hex-encoded unwrapped message bytes
    string message;

    //! True if confidentiality was applied to the received token
    bool confidential;

    //! Reported GSSAPI quality-of-protection value
    int qop;
}

//! Result of a GSSAPI @ref Qore::Krb5::GssClientContext::getMic() operation
/**
*/
hashdecl Qore::Krb5::GssMicInfo {
    //! Hex-encoded MIC token
    string token;
}

//! Result of a GSSAPI @ref Qore::Krb5::GssClientContext::verifyMic() operation
/**
*/
hashdecl Qore::Krb5::GssMicVerifyInfo {
    //! Reported GSSAPI quality-of-protection value
    int qop;
}

//! Creates an initiator-side GSSAPI context for the given service principal
/** @param service_principal a Kerberos service principal such as
    \c "HTTP/qorus.example.com@EXAMPLE.COM"

    @throw KRB5-GSS-ARG-ERROR if \a service_principal is empty
    @throw KRB5-GSS-ERROR if the GSSAPI target name cannot be imported
*/
GssClientContext::constructor(string service_principal) {
    SimpleRefHolder<QoreGssClientContext> c(new QoreGssClientContext(service_principal->c_str(), nullptr, xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_GSSCLIENTCONTEXT, c.release());
}

//! Creates an initiator-side GSSAPI context with explicit options
/** @param service_principal a Kerberos service principal, or a host-based service name
    if \c opts.name_type is \c "hostbased-service"
    @param opts initiator options (flags, lifetime, mechanism, name type, channel bindings)

    @throw KRB5-GSS-ARG-ERROR if \a service_principal is empty or an
    option value is invalid or inconsistent
    @throw KRB5-TOKEN-ERROR if any channel-binding hex value is malformed
    @throw KRB5-GSS-ERROR if the GSSAPI target name cannot be imported
*/
GssClientContext::constructor(string service_principal, hash<GssClientContextOptions> opts) {
    SimpleRefHolder<QoreGssClientContext> c(new QoreGssClientContext(service_principal->c_str(), opts, xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_GSSCLIENTCONTEXT, c.release());
}

//! Creates an initiator-side GSSAPI context bound to explicit credentials
/** @param service_principal a Kerberos service principal such as
    \c "HTTP/qorus.example.com@EXAMPLE.COM"
    @param cred explicit GSSAPI credential

    @throw KRB5-GSS-ARG-ERROR if \a service_principal is empty
    @throw KRB5-GSS-ERROR if the GSSAPI target name cannot be imported
*/
GssClientContext::constructor(string service_principal, GssCredential[QoreGssCredential] cred) {
    SimpleRefHolder<QoreGssClientContext> c(new QoreGssClientContext(service_principal->c_str(), *cred,
        nullptr, xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_GSSCLIENTCONTEXT, c.release());
}

//! Creates an initiator-side GSSAPI context bound to explicit credentials and options
/** @param service_principal a Kerberos service principal, or a host-based service name
    if \c opts.name_type is \c "hostbased-service"
    @param cred explicit GSSAPI credential
    @param opts initiator options (flags, lifetime, mechanism, name type, channel bindings)

    @throw KRB5-GSS-ARG-ERROR if \a service_principal is empty or an
    option value is invalid or inconsistent
    @throw KRB5-TOKEN-ERROR if any channel-binding hex value is malformed
    @throw KRB5-GSS-ERROR if the GSSAPI target name cannot be imported
*/
GssClientContext::constructor(string service_principal, GssCredential[QoreGssCredential] cred,
        hash<GssClientContextOptions> opts) {
    SimpleRefHolder<QoreGssClientContext> c(new QoreGssClientContext(service_principal->c_str(), *cred,
        opts, xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_GSSCLIENTCONTEXT, c.release());
}

//! Returns the target principal string used for the context
/**
*/
string GssClientContext::getTargetName() [flags=CONSTANT] {
    return ctx->getTargetName();
}

//! Returns True if the context negotiation is complete
/**
*/
bool GssClientContext::isComplete() [flags=CONSTANT] {
    return ctx->isComplete();
}

//! Resets the security context state
/**
*/
nothing GssClientContext::reset() {
    ctx->reset();
}

//! Advances the initiator security context
/** This method should be called in a loop until @ref Qore::Krb5::GssStepInfo::complete is
    \c True, exchanging hex-encoded tokens with the acceptor each round.
    Cooperative cancellation is checked before each GSSAPI call. After control
    enters the MIT GSSAPI library, cancellation is observed when that library
    call returns.

    @return a @ref Qore::Krb5::GssStepInfo describing the step result

    @throw KRB5-GSS-ERROR if the GSSAPI negotiation fails
    @throw KRB5-SANDBOX-ERROR if the active network sandbox policy cannot
    be enforced while MIT GSSAPI contacts the KDC
*/
hash<GssStepInfo> GssClientContext::step() {
    return ctx->step(nullptr, xsink);
}

//! Advances the initiator security context with a hex-encoded input token
/** @param token_hex hex-encoded acceptor token to process

    @return a @ref Qore::Krb5::GssStepInfo describing the step result

    @throw KRB5-TOKEN-ERROR if \a token_hex is not valid hexadecimal
    @throw KRB5-GSS-ERROR if the GSSAPI negotiation fails
    @throw KRB5-SANDBOX-ERROR if the active network sandbox policy cannot
    be enforced while MIT GSSAPI contacts the KDC
*/
hash<GssStepInfo> GssClientContext::step(string token_hex) {
    return ctx->step(token_hex->c_str(), xsink);
}

//! Wraps a hex-encoded message with GSSAPI integrity or confidentiality protection
/** The context must be complete before this method can be called.

    @param message_hex message bytes encoded as hexadecimal
    @param confidential request confidentiality in addition to integrity; defaults to True
    @param qop requested GSSAPI quality-of-protection value; defaults to 0

    @return a @ref Qore::Krb5::GssWrapInfo describing the wrapped token

    @throw KRB5-TOKEN-ERROR if \a message_hex is not valid hexadecimal
    @throw KRB5-GSS-ARG-ERROR if \a qop is negative
    @throw KRB5-GSS-STATE-ERROR if the context is not complete
    @throw KRB5-GSS-ERROR if GSSAPI wrapping fails
*/
hash<GssWrapInfo> GssClientContext::wrap(string message_hex, bool confidential = True, int qop = 0) {
    return ctx->wrap(message_hex->c_str(), confidential, static_cast<int>(qop), xsink);
}

//! Unwraps a hex-encoded GSSAPI protected token
/** The context must be complete before this method can be called.

    @param token_hex wrapped token bytes encoded as hexadecimal

    @return a @ref Qore::Krb5::GssUnwrapInfo describing the unwrapped message

    @throw KRB5-TOKEN-ERROR if \a token_hex is not valid hexadecimal or is empty
    @throw KRB5-GSS-STATE-ERROR if the context is not complete
    @throw KRB5-GSS-ERROR if GSSAPI unwrapping fails
*/
hash<GssUnwrapInfo> GssClientContext::unwrap(string token_hex) {
    return ctx->unwrap(token_hex->c_str(), xsink);
}

//! Returns the maximum plaintext size for a wrapped token size
/** The context must be complete before this method can be called.

    @param output_size requested maximum wrapped-token size in bytes
    @param confidential request confidentiality in addition to integrity; defaults to True
    @param qop requested GSSAPI quality-of-protection value; defaults to 0

    @throw KRB5-GSS-ARG-ERROR if \c output_size or \c qop is invalid
    @throw KRB5-GSS-STATE-ERROR if the context is not complete
    @throw KRB5-GSS-ERROR if the GSSAPI library cannot compute the size limit
*/
int GssClientContext::getWrapSizeLimit(int output_size, bool confidential = True, int qop = 0) {
    return ctx->getWrapSizeLimit(output_size, confidential, static_cast<int>(qop), xsink);
}

//! Computes a GSSAPI MIC (Message Integrity Code) over a hex-encoded message
/** The context must be complete before this method can be called.

    @param message_hex message bytes encoded as hexadecimal
    @param qop requested GSSAPI quality-of-protection value; defaults to 0

    @return a @ref Qore::Krb5::GssMicInfo with the hex-encoded MIC token

    @throw KRB5-TOKEN-ERROR if \a message_hex is not valid hexadecimal
    @throw KRB5-GSS-ARG-ERROR if \a qop is negative
    @throw KRB5-GSS-STATE-ERROR if the context is not complete
    @throw KRB5-GSS-ERROR if GSSAPI MIC computation fails
*/
hash<GssMicInfo> GssClientContext::getMic(string message_hex, int qop = 0) {
    return ctx->getMic(message_hex->c_str(), static_cast<int>(qop), xsink);
}

//! Verifies a GSSAPI MIC over a hex-encoded message
/** The context must be complete before this method can be called.

    @param message_hex message bytes encoded as hexadecimal
    @param mic_hex MIC token bytes encoded as hexadecimal

    @return a @ref Qore::Krb5::GssMicVerifyInfo with the reported QOP value

    @throw KRB5-TOKEN-ERROR if \a message_hex or \a mic_hex is not valid
    hexadecimal, or if \a mic_hex is empty
    @throw KRB5-GSS-STATE-ERROR if the context is not complete
    @throw KRB5-GSS-ERROR if GSSAPI MIC verification fails
*/
hash<GssMicVerifyInfo> GssClientContext::verifyMic(string message_hex, string mic_hex) {
    return ctx->verifyMic(message_hex->c_str(), mic_hex->c_str(), xsink);
}
