#include "krb5-module.h"

//! Metadata for Kerberos credentials
/**
*/
hashdecl Qore::Krb5::Krb5CredentialsInfo {
    //! Client principal
    string client;

    //! Server principal
    string server;

    //! Numeric session-key enctype identifier
    int enctype;

    //! Human-readable enctype name when available
    string enctype_name;

    //! Start time as seconds since the Unix epoch
    int start_time;

    //! End time as seconds since the Unix epoch
    int end_time;

    //! Renew-until time as seconds since the Unix epoch, or 0 if not renewable
    int renew_until;

    //! Kerberos ticket flags
    int ticket_flags;

    //! True if the credential uses another ticket's session key
    bool is_skey;

    //! Ticket size in bytes
    int ticket_size;
}

//! Kerberos credentials wrapper
/** This class represents Kerberos credentials and exposes metadata suitable
    for cache inspection and credential-acquisition APIs.
*/
qclass Krb5Credentials [arg=QoreKrb5Credentials* creds; ns=Qore::Krb5; flags=final];

//! Creates a credentials object from explicit credential fields
/** This constructor is useful for deterministic cache tests and for importing
    externally acquired credentials.

    @param client client principal
    @param server server principal
    @param session_key_hex raw session key encoded as hexadecimal
    @param enctype Kerberos enctype identifier
    @param start_time start time as seconds since the Unix epoch
    @param end_time end time as seconds since the Unix epoch
    @param renew_until renew-until time, or 0 if not renewable
    @param flags Kerberos ticket flags
    @param ticket_hex encoded ticket data; if omitted, a one-byte placeholder
    ticket is used

    @throw KRB5-INIT-ERROR if a Kerberos context cannot be initialized
    @throw KRB5-CREDENTIALS-ERROR if any field is malformed (invalid hex,
    empty key, or invalid ticket data)
*/
Krb5Credentials::constructor(Krb5Principal[QoreKrb5Principal] client, Krb5Principal[QoreKrb5Principal] server,
        string session_key_hex, int enctype, int start_time, int end_time, *int renew_until = 0,
        *int flags = 0, *string ticket_hex = "00") {
    SimpleRefHolder<QoreKrb5Credentials> c(new QoreKrb5Credentials(**client, **server, session_key_hex->c_str(),
        static_cast<krb5_enctype>(enctype), static_cast<krb5_timestamp>(start_time),
        static_cast<krb5_timestamp>(end_time),
        renew_until ? static_cast<krb5_timestamp>(static_cast<int>(renew_until)) : 0,
        flags ? static_cast<krb5_flags>(static_cast<int>(flags)) : 0,
        ticket_hex ? ticket_hex->c_str() : "00", xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_KRB5CREDENTIALS, c.release());
}

//! Returns credential metadata
/** @return a @ref Qore::Krb5::Krb5CredentialsInfo hash with principal names,
    timestamps, flags, and enctype — not key or ticket bytes

    @throw KRB5-CREDENTIALS-ERROR if principal names cannot be rendered
*/
hash<Krb5CredentialsInfo> Krb5Credentials::getInfo() [flags=CONSTANT] {
    return creds->getInfo(xsink);
}

//! Returns the client principal
/** @throw KRB5-INIT-ERROR if a new Kerberos context cannot be initialized
    @throw KRB5-PRINCIPAL-ERROR if the client principal cannot be copied
*/
Krb5Principal Krb5Credentials::getClientPrincipal() [flags=CONSTANT] {
    SimpleRefHolder<QoreKrb5Principal> principal(creds->getClientPrincipal(xsink));
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_KRB5PRINCIPAL, getProgram()), xsink);
    rv->setPrivate(CID_KRB5PRINCIPAL, principal.release());
    return rv.release();
}

//! Returns the server principal
/** @throw KRB5-INIT-ERROR if a new Kerberos context cannot be initialized
    @throw KRB5-PRINCIPAL-ERROR if the server principal cannot be copied
*/
Krb5Principal Krb5Credentials::getServerPrincipal() [flags=CONSTANT] {
    SimpleRefHolder<QoreKrb5Principal> principal(creds->getServerPrincipal(xsink));
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_KRB5PRINCIPAL, getProgram()), xsink);
    rv->setPrivate(CID_KRB5PRINCIPAL, principal.release());
    return rv.release();
}
