#include "krb5-module.h"

//! Explicit GSSAPI credential handle
/** This class lets applications bind GSSAPI initiator contexts to a specific
    Kerberos credential cache or client keytab instead of relying on the
    process default credential.
*/
qclass GssCredential [arg=QoreGssCredential* cred; ns=Qore::Krb5; dom=FILESYSTEM; flags=final];

//! Imports a GSSAPI credential from a Kerberos credential cache
/** @param cache source credential cache

    @throw KRB5-GSS-ERROR if the credential cannot be imported
    @throw KRB5-SANDBOX-ERROR if the cache backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed cache is outside the filesystem sandbox
*/
static GssCredential GssCredential::fromCredentialCache(Krb5CredentialCache[QoreKrb5CredentialCache] cache)
        [dom=FILESYSTEM] {
    SimpleRefHolder<QoreGssCredential> cred(new QoreGssCredential(**cache, xsink));
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GSSCREDENTIAL, getProgram()), xsink);
    rv->setPrivate(CID_GSSCREDENTIAL, cred.release());
    return rv.release();
}

//! Imports a GSSAPI initiator credential from a client keytab
/** @param keytab source keytab

    @throw KRB5-GSS-ERROR if the credential cannot be imported
    @throw KRB5-SANDBOX-ERROR if the keytab backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed keytab is outside the filesystem sandbox
*/
static GssCredential GssCredential::fromKeytab(Krb5Keytab[QoreKrb5Keytab] keytab) [dom=FILESYSTEM] {
    SimpleRefHolder<QoreGssCredential> cred(new QoreGssCredential(**keytab, nullptr, xsink));
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GSSCREDENTIAL, getProgram()), xsink);
    rv->setPrivate(CID_GSSCREDENTIAL, cred.release());
    return rv.release();
}

//! Imports a GSSAPI initiator credential from a client keytab and principal
/** @param keytab source keytab
    @param principal keytab client principal

    @throw KRB5-GSS-ERROR if the credential cannot be imported
    @throw KRB5-SANDBOX-ERROR if the keytab backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed keytab is outside the filesystem sandbox
*/
static GssCredential GssCredential::fromKeytab(Krb5Keytab[QoreKrb5Keytab] keytab,
        Krb5Principal[QoreKrb5Principal] principal) [dom=FILESYSTEM] {
    SimpleRefHolder<QoreGssCredential> cred(new QoreGssCredential(**keytab, *principal, xsink));
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GSSCREDENTIAL, getProgram()), xsink);
    rv->setPrivate(CID_GSSCREDENTIAL, cred.release());
    return rv.release();
}

//! Acquires an impersonated credential via S4U2Self
/** Uses the \a impersonator_cred service credential to obtain a ticket
    on behalf of \a user_principal without the user's password or
    delegation. This is the GSSAPI-level S4U2Self operation
    (\c gss_acquire_cred_impersonate_name).

    The resulting GSS credential can be used to initiate new GSSAPI contexts
    on behalf of the user. It is not a @ref Qore::Krb5::Krb5Credentials
    evidence ticket for @ref Qore::Krb5::Krb5Context::acquireS4U2ProxyCredentials().
    For the GSS-level flow, use \c Krb5Util::createImpersonatedClientContext().

    Requires MIT krb5 1.8 or later and KDC configuration with
    \c ok_to_auth_as_delegate on the service principal.

    @param impersonator_cred service credential (typically from a keytab)
    @param user_principal principal to impersonate

    @return impersonated @ref Qore::Krb5::GssCredential

    @throw KRB5-GSS-ARG-ERROR if the impersonator credential is invalid
    @throw KRB5-GSS-ERROR if the S4U2Self operation fails
    @throw KRB5-NOT-SUPPORTED if the platform lacks S4U2Self support
    @throw KRB5-SANDBOX-ERROR if the active network sandbox policy cannot
    be enforced while MIT GSSAPI contacts the KDC
*/
static GssCredential GssCredential::impersonateName(GssCredential[QoreGssCredential] impersonator_cred,
        Krb5Principal[QoreKrb5Principal] user_principal) [dom=NETWORK] {
    SimpleRefHolder<QoreGssCredential> cred(new QoreGssCredential(**impersonator_cred, **user_principal, xsink));
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GSSCREDENTIAL, getProgram()), xsink);
    rv->setPrivate(CID_GSSCREDENTIAL, cred.release());
    return rv.release();
}
