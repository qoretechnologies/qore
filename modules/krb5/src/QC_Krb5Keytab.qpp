#include "krb5-module.h"

//! Metadata for a single keytab entry
/**
*/
hashdecl Qore::Krb5::Krb5KeytabEntryInfo {
    //! Principal stored in the entry
    string principal;

    //! Key version number
    int kvno;

    //! Numeric enctype identifier
    int enctype;

    //! Human-readable enctype name when available
    string enctype_name;

    //! Entry write timestamp
    int timestamp;

    //! Key length in bytes
    int key_size;
}

//! Kerberos keytab wrapper
/** This class wraps a single keytab and provides service-key metadata access
    and deterministic entry-management helpers.
*/
qclass Krb5Keytab [arg=QoreKrb5Keytab* keytab; ns=Qore::Krb5; dom=FILESYSTEM; flags=final];

//! Returns the full keytab specifier
/** @throw KRB5-KEYTAB-ERROR if the keytab name cannot be read
*/
string Krb5Keytab::getName() [flags=CONSTANT] {
    return keytab->getName(xsink);
}

//! Returns the keytab backend type
/**
*/
string Krb5Keytab::getType() [flags=CONSTANT] {
    return keytab->getType();
}

//! Returns True if the keytab contains at least one entry
/** @throw KRB5-KEYTAB-ERROR if the keytab cannot be inspected
    @throw KRB5-SANDBOX-ERROR if the keytab backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed keytab is outside the filesystem sandbox
*/
bool Krb5Keytab::hasContent() [flags=CONSTANT] {
    return keytab->hasContent(xsink);
}

//! Adds a keytab entry with a hex-encoded raw key
/** @param principal principal for the entry
    @param key_hex raw key material encoded as hexadecimal
    @param enctype Kerberos enctype identifier
    @param kvno key version number; defaults to \c 1 when not supplied

    @throw KRB5-KEYTAB-ERROR if the entry cannot be added or the key hex is invalid
    @throw KRB5-SANDBOX-ERROR if the keytab backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed keytab is outside the filesystem sandbox
*/
nothing Krb5Keytab::addEntry(Krb5Principal[QoreKrb5Principal] principal, string key_hex, int enctype,
        *int kvno) {
    keytab->addEntry(**principal, key_hex->c_str(), static_cast<krb5_enctype>(enctype),
        kvno ? static_cast<krb5_kvno>(static_cast<int>(kvno)) : 1, xsink);
}

//! Looks up a keytab entry
/** @param principal principal to match
    @param kvno key version number, or 0 for the highest available kvno
    @param enctype Kerberos enctype identifier, or 0 for any enctype

    @throw KRB5-KEYTAB-ERROR if no matching entry is found or the keytab cannot be read
    @throw KRB5-SANDBOX-ERROR if the keytab backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed keytab is outside the filesystem sandbox
*/
hash<Krb5KeytabEntryInfo> Krb5Keytab::getEntry(Krb5Principal[QoreKrb5Principal] principal, *int kvno,
        *int enctype) [flags=CONSTANT] {
    return keytab->getEntry(**principal,
        kvno ? static_cast<krb5_kvno>(static_cast<int>(kvno)) : 0,
        enctype ? static_cast<krb5_enctype>(static_cast<int>(enctype)) : 0, xsink);
}

//! Lists all entries in the keytab
/** @return a list of @ref Qore::Krb5::Krb5KeytabEntryInfo hashes, one per keytab entry

    @throw KRB5-KEYTAB-ERROR if the keytab cannot be enumerated
    @throw KRB5-SANDBOX-ERROR if the keytab backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed keytab is outside the filesystem sandbox
*/
list<hash<Krb5KeytabEntryInfo>> Krb5Keytab::listEntries() [flags=CONSTANT] {
    return keytab->listEntries(xsink);
}

//! Removes a keytab entry matching the given principal, key version, and enctype
/** @param principal principal to match
    @param kvno key version number to match; use 0 to match the highest kvno
    @param enctype Kerberos enctype identifier to match; use 0 for any enctype

    @throw KRB5-KEYTAB-ERROR if no matching entry is found or the entry cannot be removed
    @throw KRB5-SANDBOX-ERROR if the keytab backend is not allowed by the sandbox
    @throw FILESYSTEM-ACCESS-DENIED if a file-backed keytab is outside the filesystem sandbox
*/
nothing Krb5Keytab::removeEntry(Krb5Principal[QoreKrb5Principal] principal, *int kvno, *int enctype) {
    keytab->removeEntry(**principal,
        kvno ? static_cast<krb5_kvno>(static_cast<int>(kvno)) : 0,
        enctype ? static_cast<krb5_enctype>(static_cast<int>(enctype)) : 0, xsink);
}
