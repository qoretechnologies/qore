    testGetNodesInfo() {
        # Test that getNodesInfo returns 0-indexed line numbers (LSP convention)
        # String starts with newline, so:
        # Line 0: (empty), Line 1: %new-style, Line 2: class TestClass {
        string testCode = "
%new-style
class TestClass {
}
";
        AstParser parser();
        *AstTree tree = parser.parseString(testCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list nodes = tree.getNodesInfo();
        assertTrue(nodes.size() > 0, "nodes found");

        # Find the class declaration and verify line numbers are 0-indexed
        # Tree-sitter CST uses "type" field with string node types
        bool foundClass = False;
        foreach auto node in (nodes) {
            if (node.type == "class_declaration") {
                foundClass = True;
                # Line numbers should be 0-indexed (>= 0)
                assertTrue(node.loc.start_line >= 0, "start_line is 0-indexed");
                # Find the name child
                *hash nameChild = findChildByField(node, "name");
                assertTrue(exists(nameChild), "class has name child");
                assertEq("TestClass", nameChild.text, "class name text");
                # The class name should be on line 2 (0-indexed)
                assertEq(2, nameChild.loc.start_line, "class name start_line is 0-indexed");
                break;
            }
        }
        assertTrue(foundClass, "class node found in getNodesInfo");
    }

%ifdef HasAstTreeSearcher
    testScopeSymbols() {
        # Test scope-aware symbol search
        string testCode = "
%new-style
namespace MyNamespace {
    class MyClass {
        public {
            int memberVar;
        }
        int myMethod(int param) {
            int localVar = 1;
            return localVar;
        }
    }
    const MY_CONST = 42;
}
";
        AstParser parser();
        *AstTree tree = parser.parseString(testCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        AstTreeSearcher searcher();

        # Search for symbols at position inside myMethod body (line 10, col 12)
        # 0-indexed: line 9, col 11
        *list scopeSyms = searcher.findScopeSymbols(tree, "test.q", 9, 11);
        assertEq(True, exists(scopeSyms), "scope symbols found");
        assertTrue(scopeSyms.size() > 0, "at least one scope symbol");

        # Check that symbols have scope_level field and verify specific symbols
        bool hasLocalVar = False;
        bool hasParam = False;
        bool hasMemberVar = False;
        bool hasMyMethod = False;
        bool hasMyClass = False;
        bool hasNamespace = False;
        foreach auto s in (scopeSyms) {
            assertEq(True, exists(s.scope_level), "symbol has scope_level");
            switch (s.name) {
                case "localVar":
                    hasLocalVar = True;
                    assertEq(0, s.scope_level, "local variable has scope_level 0");
                    assertEq(ASYK_Variable, s.kind, "localVar is Variable");
                    break;
                case "param":
                    hasParam = True;
                    assertEq(0, s.scope_level, "parameter has scope_level 0");
                    assertEq(ASYK_Variable, s.kind, "param is Variable");
                    break;
                case "memberVar":
                    hasMemberVar = True;
                    assertTrue(s.scope_level > 0, "member has higher scope_level");
                    break;
                case "myMethod":
                    hasMyMethod = True;
                    assertTrue(s.scope_level > 0, "method has higher scope_level");
                    break;
                case "MyClass":
                    hasMyClass = True;
                    break;
                case "MyNamespace":
                    hasNamespace = True;
                    assertEq(ASYK_Namespace, s.kind, "MyNamespace is Namespace");
                    break;
            }
        }

        # Verify we found all expected symbols
        assertTrue(hasLocalVar, "found localVar symbol");
        assertTrue(hasParam, "found param symbol");
        assertTrue(hasMemberVar, "found memberVar symbol");
        assertTrue(hasMyMethod, "found myMethod symbol");
        assertTrue(hasMyClass, "found MyClass symbol");
        assertTrue(hasNamespace, "found MyNamespace symbol");
    }

    testDocComments() {
        AstParser parser();
        *AstTree tree = parser.parseString(DocCommentCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        AstTreeSearcher searcher();
        *list syms = searcher.findSymbols(tree, "test.q");

        assertEq(True, exists(syms), "symbols found");

        # Build a map of symbol name to docComment
        hash<string, *string> docComments;
        foreach auto s in (syms) {
            docComments{s.name} = s.docComment;
        }

        # Test class doc comment (claimed when scanner sees 'class' keyword)
        assertTrue(exists(docComments{"MyClass"}), "class has docComment field");
        assertTrue(docComments{"MyClass"} =~ /Doc comment for MyClass/, "class docComment contains expected text");

        # Test constructor doc comment
        assertTrue(exists(docComments{"MyClass::constructor"}), "constructor has docComment");
        assertTrue(docComments{"MyClass::constructor"} =~ /Doc for constructor/, "constructor docComment correct");

        # Test method doc comment
        assertTrue(exists(docComments{"MyClass::myMethod"}), "method has docComment");
        assertTrue(docComments{"MyClass::myMethod"} =~ /Doc for myMethod/, "method docComment correct");

        # Test function doc comment
        assertTrue(exists(docComments{"my_function"}), "function has docComment");
        assertTrue(docComments{"my_function"} =~ /Doc for my_function/, "function docComment correct");

        # Test constant doc comment
        assertTrue(exists(docComments{"MyConst"}), "constant has docComment");
        assertTrue(docComments{"MyConst"} =~ /Doc for MyConst/, "constant docComment correct");

        # Test hashdecl doc comment
        assertTrue(exists(docComments{"MyHashDecl"}), "hashdecl has docComment");
        assertTrue(docComments{"MyHashDecl"} =~ /Doc for MyHashDecl/, "hashdecl docComment correct");
    }

    testDocCommentsComprehensive() {
        AstParser parser();
        *AstTree tree = parser.parseString(DocCommentComprehensiveCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        AstTreeSearcher searcher();
        *list syms = searcher.findSymbols(tree, "test.q");
        assertEq(True, exists(syms), "symbols found");

        # Build a map of symbol name to docComment
        hash<string, *string> docComments;
        foreach auto s in (syms) {
            docComments{s.name} = s.docComment;
        }

        # Note: namespace doc comments are not currently supported by astparser
        # Test that namespace is found (doc comments skipped)
        assertTrue(docComments.hasKey("TestNs"), "namespace found");

        # Test class with block comment and doxygen tags
        assertTrue(exists(docComments{"TestNs::ClassA"}), "ClassA has docComment");
        assertTrue(docComments{"TestNs::ClassA"} =~ /@brief/, "ClassA doc has @brief tag");
        assertTrue(docComments{"TestNs::ClassA"} =~ /@since/, "ClassA doc has @since tag");

        # Test constructor with multi-line #! and @param
        assertTrue(exists(docComments{"TestNs::ClassA::constructor"}), "constructor has docComment");
        assertTrue(docComments{"TestNs::ClassA::constructor"} =~ /@param val/, "constructor doc has @param");

        # Test destructor
        assertTrue(exists(docComments{"TestNs::ClassA::destructor"}), "destructor has docComment");
        assertTrue(docComments{"TestNs::ClassA::destructor"} =~ /Destructor doc/, "destructor doc correct");

        # Test method with multiple @param and @return
        assertTrue(exists(docComments{"TestNs::ClassA::add"}), "add method has docComment");
        assertTrue(docComments{"TestNs::ClassA::add"} =~ /@param a/, "add doc has @param a");
        assertTrue(docComments{"TestNs::ClassA::add"} =~ /@param b/, "add doc has @param b");
        assertTrue(docComments{"TestNs::ClassA::add"} =~ /@return/, "add doc has @return");

        # Test static method with block comment
        assertTrue(exists(docComments{"TestNs::ClassA::staticMethod"}), "staticMethod has docComment");
        assertTrue(docComments{"TestNs::ClassA::staticMethod"} =~ /Static method doc/, "staticMethod doc correct");

        # Test abstract method
        assertTrue(exists(docComments{"TestNs::ClassA::abstractMethod"}), "abstractMethod has docComment");

        # Test class with inheritance
        assertTrue(exists(docComments{"TestNs::ClassB"}), "ClassB has docComment");
        assertTrue(docComments{"TestNs::ClassB"} =~ /inheritance doc/, "ClassB doc mentions inheritance");

        # Test empty class
        assertTrue(exists(docComments{"TestNs::EmptyClass"}), "EmptyClass has docComment");
        assertTrue(docComments{"TestNs::EmptyClass"} =~ /Empty class doc/, "EmptyClass doc correct");

        # Test forward declaration
        assertTrue(exists(docComments{"TestNs::ForwardDecl"}), "ForwardDecl has docComment");

        # Test hashdecl with multi-line doc
        assertTrue(exists(docComments{"TestNs::MyHash"}), "hashdecl has docComment");
        assertTrue(docComments{"TestNs::MyHash"} =~ /Hashdecl doc/, "hashdecl doc has first line");
        assertTrue(docComments{"TestNs::MyHash"} =~ /with multiple lines/, "hashdecl doc has second line");

        # Test constant
        assertTrue(exists(docComments{"TestNs::COMPLEX_CONST"}), "constant has docComment");

        # Test top-level class (outside namespace)
        assertTrue(exists(docComments{"TopLevelClass"}), "TopLevelClass has docComment");
    }
%endif

    testDocCommentsGetNodesInfo() {
        # Test that CST contains class and method nodes, and getComments() captures doc comments
        AstParser parser();
        *AstTree tree = parser.parseString(DocCommentCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list<auto> nodes = tree.getNodesInfo();
        assertTrue(nodes.size() > 0, "has nodes");

        # Find the class node in CST
        *hash<auto> classNode = findNodeByType(nodes, "class_declaration");
        assertTrue(exists(classNode), "found class_declaration in CST");
        *hash<auto> nameChild = findChildByField(classNode, "name");
        assertTrue(exists(nameChild), "class has name child");
        assertEq("MyClass", nameChild.text, "class name is MyClass");

        # Verify doc comments are captured via getComments()
        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        bool foundClassDoc = False;
        bool foundConstructorDoc = False;
        foreach hash<auto> c in (comments) {
            if (c.text =~ /Doc comment for MyClass/) {
                foundClassDoc = True;
            }
            if (c.text =~ /Doc for constructor/) {
                foundConstructorDoc = True;
            }
        }
        assertTrue(foundClassDoc, "found class doc comment via getComments()");
        assertTrue(foundConstructorDoc, "found constructor doc comment via getComments()");
    }

%ifdef HasAstTreeSearcher
    testDocCommentsEdgeCases() {
        AstParser parser();
        AstTreeSearcher searcher();

        # Test 1: Consecutive doc comments - blank line separates blocks
        {
            *AstTree tree = parser.parseString(DocCommentConsecutiveCode);
            assertEq(0, parser.getErrorCount(), "consecutive: no parse errors");

            *list syms = searcher.findSymbols(tree, "test.q");
            hash<string, *string> docComments;
            foreach auto s in (syms) {
                docComments{s.name} = s.docComment;
            }

            assertTrue(exists(docComments{"MyClass"}), "consecutive: class has docComment");
            # After blank line, new doc block starts - should have "Second doc block"
            assertTrue(docComments{"MyClass"} =~ /Second doc block/, "consecutive: has second block");
        }

        # Test 2: Doc comment with blank line before declaration
        {
            *AstTree tree = parser.parseString(DocCommentBlankLineCode);
            assertEq(0, parser.getErrorCount(), "blank line: no parse errors");

            *list syms = searcher.findSymbols(tree, "test.q");
            hash<string, *string> docComments;
            foreach auto s in (syms) {
                docComments{s.name} = s.docComment;
            }

            # With blank line separation, doc comment should NOT attach
            # (depends on implementation - current behavior attaches)
            assertTrue(docComments.hasKey("MyClass"), "blank line: class found");
        }

        # Test 3: No doc comment
        {
            *AstTree tree = parser.parseString(NoDocCommentCode);
            assertEq(0, parser.getErrorCount(), "no doc: no parse errors");

            *list syms = searcher.findSymbols(tree, "test.q");
            hash<string, *string> docComments;
            foreach auto s in (syms) {
                docComments{s.name} = s.docComment;
            }

            assertTrue(docComments.hasKey("MyClass"), "no doc: class found");
            assertNothing(docComments{"MyClass"}, "no doc: class has no docComment");
        }

        # Test 4: Doc comment with line comment inside function body
        {
            *AstTree tree = parser.parseString(DocCommentBodyCommentCode);
            assertEq(0, parser.getErrorCount(), "body comment: no parse errors");

            *list syms = searcher.findSymbols(tree, "test.q");
            hash<string, *string> docComments;
            foreach auto s in (syms) {
                docComments{s.name} = s.docComment;
            }

            assertTrue(exists(docComments{"func_with_body_comment"}), "body comment: function has docComment");
            assertTrue(docComments{"func_with_body_comment"} =~ /Doc for function with body comment/,
                "body comment: docComment correct");
        }

        # Test 5: Doc comment with nested sub expression inside function body
        {
            *AstTree tree = parser.parseString(DocCommentNestedSubCode);
            assertEq(0, parser.getErrorCount(), "nested sub: no parse errors");

            *list syms = searcher.findSymbols(tree, "test.q");
            hash<string, *string> docComments;
            foreach auto s in (syms) {
                docComments{s.name} = s.docComment;
            }

            assertTrue(exists(docComments{"func_with_nested_sub"}), "nested sub: function has docComment");
            assertTrue(docComments{"func_with_nested_sub"} =~ /Doc for function with nested sub/,
                "nested sub: docComment correct");
        }
    }
%endif

    # Test for block comments in hash literal lookahead (fixed infinite loop bug)
    testBlockCommentsInHashLookahead() {
        # This pattern caused an infinite loop before the fix:
        # The lookahead code didn't handle block comments, causing */ to be
        # misinterpreted as a regex start
        string code = '
class Test {
    /** @throw INVALID-REFERENCE invalid reference
    */
    test() {
    }
}
';
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree");
        assertEq(0, parser.getErrorCount(), "no parse errors for block comment before method");
    }

    # Test for consecutive parse options in hash literals with identifier keys
    testConsecutiveParseOptionsInHash() {
        # This pattern failed before the grammar fix:
        # After %endif %ifndef, an identifier key like SomeConst: wasn't recognized
        string code = '
const h = {
    "a": 1,
%endif
%ifndef X
    SomeConst: 2,
};
';
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree");
        assertEq(0, parser.getErrorCount(), "no parse errors for consecutive parse options with identifier key");

        # Also test the exact Swagger.qm pattern
        string code2 = '
const MimeDataTypes = {
    "yaml": 1,
%endif
%ifndef NoXml
    MimeTypeXmlApp: {
        "serialize": 1,
    },
%endif
    "json": 2,
};
';
        parser = new AstParser();
        tree = parser.parseString(code2);
        assertEq(True, exists(tree), "parseString returns tree for Swagger pattern");
        assertEq(0, parser.getErrorCount(), "no parse errors for Swagger.qm pattern");
    }

    # Test that $# (last index operator) is not treated as a comment
    testLastIndexOperatorInHash() {
        # The $# operator should not be treated as starting a comment
        string code = '
sub test() {
    list l = (1, 2, 3);
    int last = l[$#];
    int next = l[$# + 1];
}
';
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree");
        assertEq(0, parser.getErrorCount(), "no parse errors for $# operator");
    }

    # Test for escaped backslash in single-quoted strings (like Windows paths 'C:\')
    # In Qore, '\\' inside a single-quoted string is an escaped backslash.
    # The test source needs double-escaping because it's inside a Qore double-quoted string:
    #   '\\\\' in double-quoted → '\\' in value → escaped backslash in single-quoted context
    testEscapedQuoteInString() {
        string code = "%new-style
list x = ('C:\\\\', 'test');
";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree");
        assertEq(0, parser.getErrorCount(), "no parse errors for escaped backslash pattern");

        # Also test the pattern from join_paths.qtest with multiple path strings
        code = "%new-style
list results = (
    ('C:\\\\', 'file.txt', 'C:\\\\file.txt'),
);
";
        parser = new AstParser();
        tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree for Windows path pattern");
        assertEq(0, parser.getErrorCount(), "no parse errors for Windows path pattern");
    }

    testDateSubtypeParsing() {
        AstParser parser();
        *AstTree tree = parser.parseString(DateSubtypeCode);
        # date<absolute> and date<relative> are complex types that tree-sitter
        # may parse with errors in typedef context; verify the tree is produced
        assertTrue(exists(tree), "parseString returns tree");

        list nodes = tree.getNodesInfo();
        # Find typedef_declaration nodes
        bool foundTypedef = False;
        foreach auto node in (nodes) {
            if (node.type == "typedef_declaration") {
                foundTypedef = True;
            }
        }
        assertTrue(foundTypedef, "typedef declarations found in CST");

        # Also check that the class and hashdecl are present
        *hash<auto> classNode = findNodeByType(nodes, "class_declaration");
        assertTrue(exists(classNode), "class declaration found");
        *hash<auto> hashdeclNode = findNodeByType(nodes, "hashdecl_declaration");
        assertTrue(exists(hashdeclNode), "hashdecl declaration found");
    }

    # Test conditional directives with trailing line and block comments
    testConditionalDirectivesWithComments() {
        # Test %ifdef with trailing comment
        string code = "%modern
%ifdef Test # line comment after ifdef
class TestClass {}
%endif # line comment after endif
";
        AstParser parser();
        parser.setConditionalParsing(True);
        parser.setDefines(("Test",));
        *AstTree tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree for ifdef with comment");
        assertEq(0, parser.getErrorCount(), "no parse errors for ifdef with comment");

        # Test %ifndef with trailing comment
        code = "%modern
%ifndef NotDefined # check if not defined
class TestClass {}
%endif # end ifndef block
";
        parser = new AstParser();
        parser.setConditionalParsing(True);
        tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree for ifndef with comment");
        assertEq(0, parser.getErrorCount(), "no parse errors for ifndef with comment");

        # Test %if with trailing comment
        code = "%modern
%if defined(Feature) # check feature flag
class TestClass {}
%endif # end if block
";
        parser = new AstParser();
        parser.setConditionalParsing(True);
        parser.setDefines(("Feature",));
        tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree for %if with comment");
        assertEq(0, parser.getErrorCount(), "no parse errors for %if with comment");

        # Test %elif with trailing comment
        code = "%modern
%if defined(Option1) # first option
class Option1Class {}
%elif defined(Option2) # second option
class Option2Class {}
%else # fallback
class FallbackClass {}
%endif # end chain
";
        parser = new AstParser();
        parser.setConditionalParsing(True);
        parser.setDefines(("Option2",));
        tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree for elif with comment");
        assertEq(0, parser.getErrorCount(), "no parse errors for elif with comment");

        # Test block comments after directives
        code = "%modern
%ifdef Feature /* block comment */
%if defined(Feature) && !defined(Other) /* combined condition */
class TestClass {}
%endif /* end if */
%endif /* end ifdef */
";
        parser = new AstParser();
        parser.setConditionalParsing(True);
        parser.setDefines(("Feature",));
        tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree for block comments");
        assertEq(0, parser.getErrorCount(), "no parse errors for block comments");

        # Test mixed line and block comments
        code = "%modern
%ifdef Level1 # outer level
%ifndef Level2 /* should skip */
class Skipped {}
%else # Level2 is not defined, use this
class Used {}
%endif # inner
%endif /* outer */
";
        parser = new AstParser();
        parser.setConditionalParsing(True);
        parser.setDefines(("Level1",));
        tree = parser.parseString(code);
        assertEq(True, exists(tree), "parseString returns tree for mixed comments");
        assertEq(0, parser.getErrorCount(), "no parse errors for mixed comments");
    }
    testModuleMetadataGetNodesInfo() {
        string code = "%modern\nmodule TestModule {\n    version = \"1.0\";\n    desc = \"test module\";\n    author = \"tester\";\n    url = \"http://example\";\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertTrue(exists(tree), "parseString returns tree");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list nodes = tree.getNodesInfo();
        assertGt(0, nodes.size(), "nodes found");

        *hash<auto> modNode = findNodeByType(nodes, "module_declaration");
        assertTrue(exists(modNode), "module node found in getNodesInfo");

        # Verify module name
        *hash<auto> nameChild = findChildByField(modNode, "name");
        assertTrue(exists(nameChild), "module has name child");
        assertEq("TestModule", nameChild.text, "module name");

        # Verify attributes
        list<auto> attrs = findAllChildrenByType(modNode, "module_attribute");
        assertEq(4, attrs.size(), "module has 4 attributes");

        # Verify attribute keys
        assertEq("version", findChildByField(attrs[0], "name").text, "first attribute key");
        assertEq("desc", findChildByField(attrs[1], "name").text, "second attribute key");
        assertEq("author", findChildByField(attrs[2], "name").text, "third attribute key");
        assertEq("url", findChildByField(attrs[3], "name").text, "fourth attribute key");

        # Verify attribute values (string text includes quotes in CST)
        assertEq("1.0", getStringValue(findChildByField(attrs[0], "value")), "version value");
        assertEq("test module", getStringValue(findChildByField(attrs[1], "value")), "desc value");
        assertEq("tester", getStringValue(findChildByField(attrs[2], "value")), "author value");
        assertEq("http://example", getStringValue(findChildByField(attrs[3], "value")), "url value");

        # Verify location info is set
        assertTrue(exists(modNode.loc), "module has location");
        assertTrue(exists(nameChild.loc), "module name has location");
    }

%ifdef HasAstTreeSearcher
    testModuleMetadataSymbols() {
        string code = "%modern\nmodule TestModule {\n    version = \"1.0\";\n    desc = \"test module\";\n}\n";
