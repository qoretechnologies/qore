    testModuleMetadataDocComment() {
        # Test that doc comments on modules are captured via getComments()
        string code = "%modern\n#! This is a test module\nmodule DocModule {\n    version = \"1.0\";\n    desc = \"documented module\";\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list nodes = tree.getNodesInfo();
        *hash<auto> modNode = findNodeByType(nodes, "module_declaration");
        assertTrue(exists(modNode), "documented module found in getNodesInfo");
        *hash<auto> nameChild = findChildByField(modNode, "name");
        assertEq("DocModule", nameChild.text, "module name");

        # Doc comments are returned via getComments() in the new backend
        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        bool foundModuleDoc = False;
        foreach hash<auto> c in (comments) {
            if (c.text =~ /test module/) {
                foundModuleDoc = True;
            }
        }
        assertTrue(foundModuleDoc, "module doc comment found via getComments()");
    }

    testModuleNoAttributes() {
        # Module with empty body (only parse options, no key=value attributes)
