    testModuleAttrExprTraversal() {
        # Test that query walkers descend into attribute value expressions.
        # Position the cursor on the string literal inside an attribute value
        # and verify findSymbolInfo/findNode can locate the expression node.
        # Line 2 (0-indexed): "    version = \"1.0\";"
        #   The string literal "1.0" is at approximately cols 14..19
        string code = "%modern\nmodule TestModule {\n    version = \"1.0\";\n    desc = \"test module\";\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        AstTreeSearcher searcher();
        # findSymbolInfo at the string literal position inside module attr
        # The key assertion is that it doesn't crash and it reaches the expression.
        # If info is returned, it should be about the expression node, not the module.
        *hash info = searcher.findSymbolInfo(tree, 2, 16);
        if (info) {
            assertTrue(exists(info.name), "findSymbolInfo returned named info");
        } else {
            assertTrue(True, "findSymbolInfo returned NOTHING (acceptable)");
        }

        # Verify attribute expression has correct location info via getNodesInfo
        list nodes = tree.getNodesInfo();
        *hash<auto> modNode = findNodeByType(nodes, "module_declaration");
        assertTrue(exists(modNode), "module found");
        # The version attribute has location info via its children
        list<auto> attrs = findAllChildrenByType(modNode, "module_attribute");
        assertTrue(attrs.size() > 0, "module has attributes");
        *hash<auto> verValue = findChildByField(attrs[0], "value");
        assertTrue(exists(verValue), "version attribute has value");
        assertEq(2, verValue.loc.start_line, "version value on line 2");
        assertGt(0, verValue.loc.start_column, "version value has non-zero start column");
    }
%endif

    testModuleWithFollowingCode() {
        # Module declaration followed by namespace and function code
        string code = "%modern\nmodule TestModule {\n    version = \"1.0\";\n    desc = \"test module\";\n    author = \"tester\";\n    url = \"http://example\";\n    license = \"MIT\";\n}\npublic namespace TestModule {\n    public int sub getValue() {\n        return 1;\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertTrue(exists(tree), "parseString returns tree");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list nodes = tree.getNodesInfo();
        # Should have both module and namespace declarations
        *hash<auto> modNode = findNodeByType(nodes, "module_declaration");
        assertTrue(exists(modNode), "module declaration found");
        list<auto> attrs = findAllChildrenByType(modNode, "module_attribute");
        assertEq(5, attrs.size(), "module has 5 attributes including license");
        assertEq("license", findChildByField(attrs[4], "name").text, "fifth attribute is license");
        assertEq("MIT", getStringValue(findChildByField(attrs[4], "value")), "license value");

        *hash<auto> nsNode = findNodeByType(nodes, "namespace_declaration");
        assertTrue(exists(nsNode), "namespace declaration found after module");
    }

    testModuleSingleAttribute() {
        # Module with just one attribute
        string code = "%modern\nmodule MinModule {\n    version = \"0.1\";\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list nodes = tree.getNodesInfo();
        *hash<auto> modNode = findNodeByType(nodes, "module_declaration");
        assertTrue(exists(modNode), "module found");
        assertEq("MinModule", findChildByField(modNode, "name").text, "module name");
        list<auto> attrs = findAllChildrenByType(modNode, "module_attribute");
        assertEq(1, attrs.size(), "exactly one attribute");
        assertEq("version", findChildByField(attrs[0], "name").text, "attribute key");
        assertEq("0.1", getStringValue(findChildByField(attrs[0], "value")), "attribute value");
    }

    testModuleSpecialCharsInValues() {
        # Module with special characters in attribute values
        string code = "%modern\nmodule SpecialModule {\n    version = \"2.0.1-beta\";\n    desc = \"module with <special> & \\\"chars\\\"\";\n    author = \"Name <email@example.com>\";\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list nodes = tree.getNodesInfo();
        *hash<auto> modNode = findNodeByType(nodes, "module_declaration");
        assertTrue(exists(modNode), "module found");
        assertEq("SpecialModule", findChildByField(modNode, "name").text, "module name");
        list<auto> attrs = findAllChildrenByType(modNode, "module_attribute");
        assertEq(3, attrs.size(), "3 attributes");
        assertEq("2.0.1-beta", getStringValue(findChildByField(attrs[0], "value")), "version with hyphens");
    }

    testModuleInitDelAttributes() {
        # init and del attributes accept code/closure expressions
        string code = "%modern\nmodule TestModule {\n    version = \"1.0\";\n    init = sub () { printf(\"init\\n\"); };\n    del = sub () { printf(\"del\\n\"); };\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        # init/del with closures should parse without errors
        assertTrue(exists(tree), "parseString returns tree for init/del module");
        assertEq(0, parser.getErrorCount(), "no parse errors for init/del attributes");

        list nodes = tree.getNodesInfo();
        *hash<auto> modNode = findNodeByType(nodes, "module_declaration");
        assertTrue(exists(modNode), "module found");
        assertEq("TestModule", findChildByField(modNode, "name").text, "module name");
        list<auto> attrs = findAllChildrenByType(modNode, "module_attribute");
        assertEq(3, attrs.size(), "3 attributes (version, init, del)");
        assertEq("version", findChildByField(attrs[0], "name").text, "first attr is version");
        assertEq("init", findChildByField(attrs[1], "name").text, "second attr is init");
        assertEq("del", findChildByField(attrs[2], "name").text, "third attr is del");
        # init/del values should have non-string CST types (closure expressions)
        *hash<auto> initVal = findChildByField(attrs[1], "value");
        assertTrue(exists(initVal), "init has value");
        # The value should contain a closure/sub expression, not just a string literal
        *hash<auto> initLeaf = findChildByType(initVal, "string");
        assertFalse(exists(initLeaf), "init value is not a plain string");
    }

    testEnumSerialization() {
        string code = "%modern\nnamespace Test {\n    /** Doc for MyEnum */\n    public enum MyEnum {\n        /** First value */\n        First = 1,\n        /** Second value */\n        Second = 2,\n        Third,\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        assertTrue(exists(tree), "parseString returns tree");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list<auto> nodes = tree.getNodesInfo();
        # find the namespace node
        *hash<auto> nsNode = findNodeByType(nodes, "namespace_declaration");
        assertTrue(exists(nsNode), "namespace found");
        assertEq("Test", findChildByField(nsNode, "name").text, "namespace name");

        # find the enum in the namespace children
        *hash<auto> enumNode = findChildByType(nsNode, "enum_declaration");
        assertTrue(exists(enumNode), "enum found in namespace");
        assertEq("MyEnum", findChildByField(enumNode, "name").text, "enum name");

        # find enum members
        list<auto> members = findAllChildrenByType(enumNode, "enum_member");
        assertEq(3, members.size(), "enum has 3 members");

        # check enum member names
        assertEq("First", findChildByField(members[0], "name").text, "first member name");
        assertTrue(exists(findChildByField(members[0], "value")), "first member has value");

        assertEq("Second", findChildByField(members[1], "name").text, "second member name");
        assertTrue(exists(findChildByField(members[1], "value")), "second member has value");

        assertEq("Third", findChildByField(members[2], "name").text, "third member name");

        # check doc comments via getComments()
        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        bool foundEnumDoc = False;
        bool foundFirstDoc = False;
        bool foundSecondDoc = False;
        foreach hash<auto> c in (comments) {
            if (c.text =~ /Doc for MyEnum/) {
                foundEnumDoc = True;
            }
            if (c.text =~ /First value/) {
                foundFirstDoc = True;
            }
            if (c.text =~ /Second value/) {
                foundSecondDoc = True;
            }
        }
        assertTrue(foundEnumDoc, "enum doc comment found");
        assertTrue(foundFirstDoc, "first member doc comment found");
        assertTrue(foundSecondDoc, "second member doc comment found");
    }

    testCommentCaptureLine() {
        AstParser parser();
        *AstTree tree = parser.parseString(CommentCaptureCode);
        assertTrue(exists(tree), "tree exists");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        assertTrue(comments.size() >= 4, "at least 4 line comments captured (got " + comments.size() + ")");

        # All line comments should have kind ACK_Line (0)
        int lineCount = 0;
        foreach hash<auto> c in (comments) {
            if (c.kind == 0) {
                ++lineCount;
                # Verify text starts with #
                assertTrue(c.text =~ /^#/, "line comment text starts with #: " + c.text);
                # Verify location info present
                assertTrue(c.loc.firstLine > 0, "firstLine > 0");
                assertTrue(c.loc.firstCol > 0, "firstCol > 0");
            }
        }
        assertTrue(lineCount >= 4, "at least 4 line comments (got " + lineCount + ")");

        # Check specific comment text values
        bool foundThisIs = False;
        bool foundInsideClass = False;
        bool foundTrailing = False;
        bool foundFinal = False;
        foreach hash<auto> c in (comments) {
            if (c.text =~ /This is a line comment/) {
                foundThisIs = True;
            }
            if (c.text =~ /Comment inside class/) {
                foundInsideClass = True;
            }
            if (c.text =~ /trailing comment/) {
                foundTrailing = True;
            }
            if (c.text =~ /Final comment/) {
                foundFinal = True;
            }
        }
        assertTrue(foundThisIs, "found 'This is a line comment'");
        assertTrue(foundInsideClass, "found 'Comment inside class'");
        assertTrue(foundTrailing, "found 'trailing comment'");
        assertTrue(foundFinal, "found 'Final comment'");
    }

    testCommentCaptureBlock() {
        AstParser parser();
        *AstTree tree = parser.parseString(BlockCommentCaptureCode);
        assertTrue(exists(tree), "tree exists");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        assertTrue(comments.size() >= 2, "at least 2 block comments captured (got " + comments.size() + ")");

        # Find block comments (kind == 1)
        int blockCount = 0;
        bool foundSingleLine = False;
        bool foundMultiLine = False;
        foreach hash<auto> c in (comments) {
            if (c.kind == 1) {
                ++blockCount;
                assertTrue(c.text =~ /^\/\*/, "block comment starts with /*: " + c.text);
                assertTrue(c.text =~ /\*\/$/, "block comment ends with */: " + c.text);
                if (c.text =~ /Block comment/) {
                    foundSingleLine = True;
                }
                if (c.text =~ /Multi-line/) {
                    foundMultiLine = True;
                    # Multi-line block should span multiple lines
                    assertTrue(c.loc.lastLine > c.loc.firstLine, "multi-line block spans lines");
                }
            }
        }
        assertTrue(blockCount >= 2, "at least 2 block comments (got " + blockCount + ")");
        assertTrue(foundSingleLine, "found single-line block comment");
        assertTrue(foundMultiLine, "found multi-line block comment");
    }

    testCommentCaptureDoc() {
        AstParser parser();
        *AstTree tree = parser.parseString(DocCommentCaptureCode);
        assertTrue(exists(tree), "tree exists");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        assertTrue(comments.size() >= 2, "at least 2 doc comments captured (got " + comments.size() + ")");

        # Check for doc line comment (kind == 2)
        bool foundDocLine = False;
        bool foundDocBlock = False;
        foreach hash<auto> c in (comments) {
            if (c.kind == 2 && c.text =~ /Doc line comment/) {
                foundDocLine = True;
                assertTrue(c.text =~ /^#!/, "doc line comment starts with #!");
            }
            if (c.kind == 3 && c.text =~ /Doc block comment/) {
                foundDocBlock = True;
                assertTrue(c.text =~ /^\/\*\*/, "doc block comment starts with /**");
                assertTrue(c.text =~ /\*\/$/, "doc block comment ends with */");
            }
        }
        assertTrue(foundDocLine, "found doc line comment");
        assertTrue(foundDocBlock, "found doc block comment");

        # Doc comments should also appear in getNodesInfo (via existing docComment mechanism)
        *list<hash<auto>> nodes = tree.getNodesInfo();
        assertTrue(exists(nodes), "nodes returned");
    }

    testCommentCaptureMixed() {
        AstParser parser();
        *AstTree tree = parser.parseString(MixedCommentCode);
        assertTrue(exists(tree), "tree exists");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        assertEq(4, comments.size(), "exactly 4 mixed comments captured");

        # Verify kinds are in source order: line, doc_line, block, doc_block
        assertEq(0, comments[0].kind, "first is line comment");
        assertEq(2, comments[1].kind, "second is doc line comment");
        assertEq(1, comments[2].kind, "third is block comment");
        assertEq(3, comments[3].kind, "fourth is doc block comment");

        # Verify text content
        assertTrue(comments[0].text =~ /Regular line comment/, "line comment text");
        assertTrue(comments[1].text =~ /Doc line comment/, "doc line text");
        assertTrue(comments[2].text =~ /Block comment/, "block comment text");
        assertTrue(comments[3].text =~ /Doc block comment/, "doc block text");

        # Verify ordering by line number
        for (int i = 1; i < comments.size(); ++i) {
            assertTrue(comments[i].loc.firstLine >= comments[i - 1].loc.firstLine,
                "comments in source order (comment " + i + ")");
        }
    }

    testCommentCaptureSpecialChars() {
        AstParser parser();
        *AstTree tree = parser.parseString(CommentSpecialCharsCode);
        assertTrue(exists(tree), "tree exists");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        assertTrue(comments.size() >= 3, "at least 3 comments (got " + comments.size() + ")");

        # Check special chars preserved
        bool foundSpecial = False;
        bool foundEmptyish = False;
        bool foundEmpty = False;
        foreach hash<auto> c in (comments) {
            if (c.text =~ /special chars/) {
                foundSpecial = True;
                assertTrue(c.text =~ /@#\$%\^&\*\(\)/, "special chars preserved");
            }
            if (c.text =~ /Empty-ish/) {
                foundEmptyish = True;
            }
            if (c.text == "#") {
                foundEmpty = True;
            }
        }
        assertTrue(foundSpecial, "found special chars comment");
        assertTrue(foundEmptyish, "found empty-ish comment");
        assertTrue(foundEmpty, "found empty comment (#)");
    }

    testCommentCaptureInline() {
        AstParser parser();
        *AstTree tree = parser.parseString(InlineCommentCode);
        assertTrue(exists(tree), "tree exists");
        assertEq(0, parser.getErrorCount(), "no parse errors");

        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        assertTrue(comments.size() >= 2, "at least 2 inline comments (got " + comments.size() + ")");

        # Inline comments should be on the same line as code
        bool foundInline = False;
        bool foundAnother = False;
        foreach hash<auto> c in (comments) {
            if (c.text =~ /inline comment/) {
                foundInline = True;
                # The comment should not be at column 1 (it's trailing)
                assertTrue(c.loc.firstCol > 1, "inline comment not at column 1");
            }
            if (c.text =~ /another inline/) {
                foundAnother = True;
            }
        }
        assertTrue(foundInline, "found 'inline comment'");
        assertTrue(foundAnother, "found 'another inline'");
    }

    testCommentCaptureInterleaved() {
        # Test that comments between declarations are captured
        AstParser parser();
        *AstTree tree = parser.parseString(DocCommentComprehensiveCode);
        assertTrue(exists(tree), "tree exists");
        # DocCommentComprehensiveCode uses %new-style and some constructs that
        # tree-sitter may report minor errors for; focus on comment capture
        assertTrue(parser.getErrorCount() <= 3, "at most 3 parse errors");

        *list<hash<auto>> comments = tree.getComments();
        assertTrue(exists(comments), "comments returned");
        # The comprehensive code has many doc comments
        assertTrue(comments.size() >= 10, "many comments captured (got " + comments.size() + ")");

        # Verify all comments have valid locations
        foreach hash<auto> c in (comments) {
            assertTrue(c.loc.firstLine > 0, "valid firstLine");
            assertTrue(c.loc.firstCol > 0, "valid firstCol");
            assertTrue(c.loc.lastLine >= c.loc.firstLine, "lastLine >= firstLine");
            assertTrue(c.text.size() > 0, "non-empty text");
        }

        # Verify CST has a namespace declaration
        *list<hash<auto>> nodes = tree.getNodesInfo();
        assertTrue(exists(nodes), "nodes returned");

        *hash<auto> nsNode = findNodeByType(nodes, "namespace_declaration");
        assertTrue(exists(nsNode), "namespace found in CST");

        # Verify namespace doc comment is captured via getComments()
        bool foundNsDoc = False;
        foreach hash<auto> c in (comments) {
            if (c.text =~ /namespace doc/) {
                foundNsDoc = True;
            }
        }
        assertTrue(foundNsDoc, "namespace doc comment found via getComments()");
    }

    # Helper to find the first function declaration in getNodesInfo output
    private *hash<auto> findFunctionNode(list<auto> nodes) {
        foreach hash<auto> n in (nodes) {
            if (n.type == "function_declaration") {
                return n;
            }
        }
        return NOTHING;
    }

    testDefaultParamSimple() {
        # sub f(int a = 1, int b) -> parameter_list with 2 parameter children
        AstParser parser();
        *AstTree tree = parser.parseString(DefaultParamSimpleCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list<auto> nodes = tree.getNodesInfo();
        *hash<auto> fn = findFunctionNode(nodes);
        assertTrue(exists(fn), "function node found");
        assertEq("f", findChildByField(fn, "name").text, "function name is f");

        # Find parameter_list and its parameter children
        *hash<auto> paramList = findChildByType(fn, "parameter_list");
        assertTrue(exists(paramList), "function has parameter_list");
        list<auto> params = findAllChildrenByType(paramList, "parameter");
        assertEq(2, params.size(), "2 params in list");

        # First param: has default (int a = 1)
        assertEq("a", findChildByField(params[0], "name").text, "param 0 name is a");
        assertTrue(exists(findChildByField(params[0], "default")), "param 0 has default value");

        # Second param: no default (int b)
        assertEq("b", findChildByField(params[1], "name").text, "param 1 name is b");
        assertFalse(exists(findChildByField(params[1], "default")), "param 1 has no default");
    }

    testDefaultParamMultiple() {
        # sub f(string a = "hello", int b = 42, bool c) -> 3 parameter children
        AstParser parser();
        *AstTree tree = parser.parseString(DefaultParamMultipleCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list<auto> nodes = tree.getNodesInfo();
        *hash<auto> fn = findFunctionNode(nodes);
        assertTrue(exists(fn), "function node found");

        *hash<auto> paramList = findChildByType(fn, "parameter_list");
        list<auto> params = findAllChildrenByType(paramList, "parameter");
        assertEq(3, params.size(), "3 params in list");

        # First param: assignment (string a = "hello")
        assertEq("a", findChildByField(params[0], "name").text, "param 0 name is a");
        assertTrue(exists(findChildByField(params[0], "default")), "param 0 has default");

        # Second param: assignment (int b = 42)
        assertEq("b", findChildByField(params[1], "name").text, "param 1 name is b");
        assertTrue(exists(findChildByField(params[1], "default")), "param 1 has default");

        # Third param: decl (bool c) - no default
        assertEq("c", findChildByField(params[2], "name").text, "param 2 name is c");
        assertFalse(exists(findChildByField(params[2], "default")), "param 2 has no default");
    }

    testDefaultParamNoDefaults() {
        # sub f(int a, int b, int c) -> 3 parameters, none with defaults
        AstParser parser();
        *AstTree tree = parser.parseString(DefaultParamNoDefaultsCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        list<auto> nodes = tree.getNodesInfo();
        *hash<auto> fn = findFunctionNode(nodes);
        assertTrue(exists(fn), "function node found");

        *hash<auto> paramList = findChildByType(fn, "parameter_list");
        list<auto> params = findAllChildrenByType(paramList, "parameter");
        assertEq(3, params.size(), "3 params in list");

        # All three should be plain parameters without defaults
        for (int i = 0; i < 3; i++) {
            assertFalse(exists(findChildByField(params[i], "default")),
                sprintf("param %d has no default", i));
        }
        assertEq("a", findChildByField(params[0], "name").text, "param 0 name is a");
        assertEq("b", findChildByField(params[1], "name").text, "param 1 name is b");
        assertEq("c", findChildByField(params[2], "name").text, "param 2 name is c");
    }

    testDefaultParamSofttype() {
