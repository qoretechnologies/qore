%ifdef HasAstTreeSearcher
    testConditionalParsingMode() {
        AstTreeSearcher searcher();

        # Test 1: %ifdef with defined flag
        {
            string code = "%modern\n%define DOC_FLAG\n%ifdef DOC_FLAG\nconst DOC_CONST = 1;\n%else\nconst OTHER_CONST = 2;\n%endif\n";
            AstParser parser();
            parser.setConditionalParsing(True);
            *AstTree tree = parser.parseString(code);
            assertEq(0, parser.getErrorCount(), "no parse errors (ifdef defined)");
            *list syms = searcher.findSymbols(tree, "test.q");
            assertEq(True, exists(syms), "symbols found (ifdef defined)");
            assertTrue(hasConstant(syms, "DOC_CONST"), "DOC_CONST present (ifdef defined)");
            assertFalse(hasConstant(syms, "OTHER_CONST"), "OTHER_CONST absent (ifdef defined)");
        }

        # Test 2: %ifdef with undefined flag (else branch)
        {
            string code = "%modern\n%ifdef DOC_FLAG\nconst DOC_CONST = 1;\n%else\nconst OTHER_CONST = 2;\n%endif\n";
            AstParser parser();
            parser.setConditionalParsing(True);
            *AstTree tree = parser.parseString(code);
            assertEq(0, parser.getErrorCount(), "no parse errors (ifdef undefined)");
            *list syms = searcher.findSymbols(tree, "test.q");
            assertTrue(hasConstant(syms, "OTHER_CONST"), "OTHER_CONST present (ifdef undefined)");
            assertFalse(hasConstant(syms, "DOC_CONST"), "DOC_CONST absent (ifdef undefined)");
        }

        # Test 3: %if defined() with defined flag
        {
            string code = "%modern\n%define FLAG\n%if defined(FLAG)\nconst IF_CONST = 1;\n%else\nconst IF_OTHER = 2;\n%endif\n";
            AstParser parser();
            parser.setConditionalParsing(True);
            *AstTree tree = parser.parseString(code);
            assertEq(0, parser.getErrorCount(), "no parse errors (if defined)");
            *list syms = searcher.findSymbols(tree, "test.q");
            assertTrue(hasConstant(syms, "IF_CONST"), "IF_CONST present (if defined)");
            assertFalse(hasConstant(syms, "IF_OTHER"), "IF_OTHER absent (if defined)");
        }

        # Test 4: %if defined() with undefined flag (else branch)
        {
            string code = "%modern\n%if defined(FLAG)\nconst IF_CONST = 1;\n%else\nconst IF_OTHER = 2;\n%endif\n";
            AstParser parser();
            parser.setConditionalParsing(True);
            *AstTree tree = parser.parseString(code);
            assertEq(0, parser.getErrorCount(), "no parse errors (if undefined)");
            *list syms = searcher.findSymbols(tree, "test.q");
            assertTrue(hasConstant(syms, "IF_OTHER"), "IF_OTHER present (if undefined)");
            assertFalse(hasConstant(syms, "IF_CONST"), "IF_CONST absent (if undefined)");
        }

        # Test 5: %if !defined() negation
        {
            string code = "%modern\n%if !defined(FLAG)\nconst NOT_DEFINED = 1;\n%else\nconst IS_DEFINED = 2;\n%endif\n";
            AstParser parser();
            parser.setConditionalParsing(True);
            *AstTree tree = parser.parseString(code);
            assertEq(0, parser.getErrorCount(), "no parse errors (!defined)");
            *list syms = searcher.findSymbols(tree, "test.q");
            assertTrue(hasConstant(syms, "NOT_DEFINED"), "NOT_DEFINED present (!defined)");
            assertFalse(hasConstant(syms, "IS_DEFINED"), "IS_DEFINED absent (!defined)");
        }

        # Test 6: %if defined() && defined() compound expression
        {
            string code = "%modern\n%define A\n%define B\n%if defined(A) && defined(B)\nconst BOTH = 1;\n%endif\n";
            AstParser parser();
            parser.setConditionalParsing(True);
            *AstTree tree = parser.parseString(code);
            assertEq(0, parser.getErrorCount(), "no parse errors (A && B)");
            *list syms = searcher.findSymbols(tree, "test.q");
            assertTrue(hasConstant(syms, "BOTH"), "BOTH present (A && B)");
        }

        # Test 7: %if defined() || defined() compound expression
        {
            string code = "%modern\n%define A\n%if defined(A) || defined(B)\nconst EITHER = 1;\n%endif\n";
            AstParser parser();
            parser.setConditionalParsing(True);
            *AstTree tree = parser.parseString(code);
            assertEq(0, parser.getErrorCount(), "no parse errors (A || B)");
            *list syms = searcher.findSymbols(tree, "test.q");
            assertTrue(hasConstant(syms, "EITHER"), "EITHER present (A || B)");
        }
    }

    private static bool hasConstant(list syms, string name) {
        foreach auto s in (syms) {
            if (s.kind == ASYK_Constant && s.name == name) {
                return True;
            }
        }
        return False;
    }
%endif

