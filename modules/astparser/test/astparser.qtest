#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%new-style
%enable-all-warnings
%require-types
%strict-args

%requires ../../../qlib/Util.qm
%requires ../../../qlib/QUnit.qm

%try-module astparser
%define NoAstParser
%endtry

%ifndef NoAstParser
%define HasAstTreeSearcher
%endif

%exec-class AstParserTest

public class AstParserTest inherits QUnit::Test {
    public {
        # Test source code samples
        const SimpleClassCode = "
%new-style
class MyClass {
    public {
        int x;
    }
    constructor(int val) {
        x = val;
    }
    int getX() {
        return x;
    }
}
";

        const TypedefCode = "
%new-style
