%ifdef NoAstParser
    testNoModule() {
        testSkip("astparser module not available");
    }
%else
    # Helper: find a child node by its field name in a CST node hash
    private static *hash<auto> findChildByField(hash<auto> node, string fieldName) {
        if (!node.children) {
            return;
        }
        foreach auto child in (node.children) {
            if (child.field == fieldName) {
                return child;
            }
        }
    }

    # Helper: find the first child node by its type in a CST node hash
    private static *hash<auto> findChildByType(hash<auto> node, string typeName) {
        if (!node.children) {
            return;
        }
        foreach auto child in (node.children) {
            if (child.type == typeName) {
                return child;
            }
        }
    }

    # Helper: find a top-level node by type in a getNodesInfo() result list
    private static *hash<auto> findNodeByType(list<auto> nodes, string typeName) {
        foreach auto node in (nodes) {
            if (node.type == typeName) {
                return node;
            }
        }
    }

    # Helper: find all children of a given type in a CST node
    private static list<auto> findAllChildrenByType(hash<auto> node, string typeName) {
        list<auto> result = ();
        if (!node.children) {
            return result;
        }
        foreach auto child in (node.children) {
            if (child.type == typeName) {
                push result, child;
            }
        }
        return result;
    }

    # Helper: get text from the deepest leaf node (recursive)
    private static *string getLeafText(hash<auto> node) {
        if (exists node.text) {
            return node.text;
        }
        if (node.children) {
            foreach auto child in (node.children) {
                *string text = getLeafText(child);
                if (exists text) {
                    return text;
                }
            }
        }
    }

    # Helper: extract unquoted string value from a CST expression node
    # Traverses down to the deepest text and strips surrounding quotes
    private static *string getStringValue(hash<auto> node) {
        *string text = getLeafText(node);
        if (exists text && text.size() >= 2) {
            return text.substr(1, text.size() - 2);
        }
    }

    testBasicParsing() {
        AstParser parser();
        *AstTree tree = parser.parseString(SimpleClassCode);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseFile() {
        string tmpfile = tmp_location() + "/astparser_parse_file_" + getpid() + ".q";
        {
            File f();
            f.open2(tmpfile, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(SimpleClassCode);
        }
        on_exit unlink(tmpfile);

        AstParser parser();
        *AstTree tree = parser.parseFile(tmpfile);
        assertTrue(exists(tree), "parseFile returns tree");
        assertEq(0, parser.getErrorCount(), "no parse errors");
    }

    testDiagnostics() {
        string badCode = "%new-style\nsub broken() {\n    int x = ;\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(badCode);
        assertTrue(!exists(tree) || parser.getErrorCount() > 0, "parse errors reported");

        *list diags = parser.getDiagnostics();
        assertTrue(exists(diags), "diagnostics returned");
        assertTrue(diags.size() > 0, "diagnostic entries present");

        hash diag = diags[0];
        assertTrue(exists(diag.range), "diagnostic has range");
        assertTrue(exists(diag.range.start), "diagnostic range has start");
        assertTrue(exists(diag.range.end), "diagnostic range has end");
        assertTrue(diag.range.start.line >= 0, "start line is 0-indexed");
        assertTrue(diag.range.start.character >= 0, "start character is 0-indexed");
        assertTrue(diag.range.end.line >= diag.range.start.line, "end line >= start line");
        assertTrue(exists(diag.message), "diagnostic has message");
    }

    testModernModuleParsing() {
        string code = "%modern\nmodule TestModule {\n    version = \"1.0\";\n    desc = \"test module\";\n    author = \"tester\";\n    url = \"http://example\";\n    license = \"MIT\";\n}\npublic namespace TestModule {\n    public int sub getValue() {\n        return 1;\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

