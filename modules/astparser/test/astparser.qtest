#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%new-style
%enable-all-warnings
%require-types
%strict-args

%requires ../../../qlib/QUnit.qm

%try-module astparser
%define NoAstParser
%endtry

%exec-class AstParserTest

public class AstParserTest inherits QUnit::Test {
    public {
        # Test source code samples
        const SimpleClassCode = "
%new-style
class MyClass {
    public {
        int x;
    }
    constructor(int val) {
        x = val;
    }
    int getX() {
        return x;
    }
}
";

        const TypedefCode = "
%new-style
namespace Test {
    public typedef MyInt = int;
    public typedef MyString = string;
    public typedef MyList = list<int>;
}
";

        const NamespaceCode = "
%new-style
namespace Outer {
    namespace Inner {
        class NestedClass {
        }
        const CONST_VAL = 42;
    }
}
";

        const FunctionCode = "
%new-style
sub add(int a, int b) returns int {
    return a + b;
}
sub greet(string name) returns string {
    return 'Hello, ' + name;
}
";

        const HashDeclCode = "
%new-style
public hashdecl PersonInfo {
    string name;
    int age;
    *string email;
}
";

        const HashDeclInheritanceCode = "
%new-style
public hashdecl BaseInfo {
    string name;
    int id;
}

public hashdecl ExtendedInfo inherits BaseInfo {
    date created;
    *string description;
}
";

        const ConstantCode = "
%new-style
namespace Constants {
    const PI = 3.14159;
    const E = 2.71828;
}
";

        const DocCommentCode = "
%new-style
/** Doc comment for MyClass
    with multiple lines
*/
class MyClass {
    #! Doc for constructor
    constructor() {}

    #! Doc for myMethod
    int myMethod() { return 1; }
}

#! Doc for my_function
sub my_function() {
}

/** Doc for MyConst */
const MyConst = 1;

#! Doc for MyHashDecl
hashdecl MyHashDecl {
    int x;
}
";

        # Comprehensive doc comment test code
        const DocCommentComprehensiveCode = "
%new-style

#! First line of namespace doc
#! Second line of namespace doc
namespace TestNs {
    /** Block doc for ClassA
        @brief A test class
        @since 1.0
    */
    class ClassA {
        #! Doc for public member block
        public {
            #! Doc for member x
            int x;
            #! Doc for member y
            string y;
        }

        #! Doc for private block
        private {
            int z;
        }

        #! Constructor doc
        #! @param val initial value
        constructor(int val) {
            x = val;
        }

        #! Destructor doc
        destructor() {}

        #! Method doc with params
        #! @param a first param
        #! @param b second param
        #! @return the sum
        int add(int a, int b) {
            return a + b;
        }

        /** Static method doc */
        static int staticMethod() {
            return 42;
        }

        #! Abstract method doc
        abstract string abstractMethod();
    }

    #! Class with inheritance doc
    class ClassB inherits ClassA {
        constructor() : ClassA(0) {}
    }

    #! Empty class doc
    class EmptyClass {
    }

    #! Forward declaration doc
    class ForwardDecl;

    #! Hashdecl doc
    #! with multiple lines
    hashdecl MyHash {
        int id;
        string name;
    }

    #! Constant with complex value
    const COMPLEX_CONST = {
        'key': 'value',
    };
}

#! Top-level class without namespace
class TopLevelClass {
    constructor() {}
}
";

        # Test for consecutive doc comments (only last block should attach)
        const DocCommentConsecutiveCode = "
#! First doc block
#! continues here

#! Second doc block (should be used)
#! also continues
class MyClass {
    constructor() {}
}
";

        # Test for doc comment with blank line separation
        const DocCommentBlankLineCode = "
#! Doc comment

class MyClass {
    constructor() {}
}
";

        # Test for no doc comment
        const NoDocCommentCode = "
class MyClass {
    constructor() {}
}
";

        const DateSubtypeCode = "
%new-style
public typedef AbsDate = date<absolute>;
public typedef RelDate = date<relative>;

class DateTypes {
    public {
        date<absolute> abs;
        date<relative> rel;
    }
}

public hashdecl DateInfo {
    date<absolute> created;
    date<relative> offset;
}
";
    }

    constructor() : Test("AstParserTest", "1.0") {
%ifdef NoAstParser
        addTestCase("astparser module not available", \testNoModule());
%else
        addTestCase("Basic parsing", \testBasicParsing());
        addTestCase("Modern module parsing", \testModernModuleParsing());
        addTestCase("Parse directives in blocks", \testParseDirectivesInBlocks());
        addTestCase("Parse directives in member lists", \testParseDirectivesInMemberLists());
        addTestCase("Parse directives in expressions", \testParseDirectivesInExpressions());
        addTestCase("Parse directives in switch cases", \testParseDirectivesInSwitchCases());
        addTestCase("Parse directives in list expressions", \testParseDirectivesInListExpressions());
        addTestCase("Parse directives in hash literals", \testParseDirectivesInHashLiterals());
        addTestCase("Parse directives in string concatenation", \testParseDirectivesInStringConcat());
        addTestCase("Parse directives in module blocks", \testParseDirectivesInModuleBlocks());
        addTestCase("Parse directives in module decls", \testParseDirectivesInModuleDecls());
        addTestCase("Hash literal multiline string", \testHashLiteralMultilineString());
        addTestCase("Hash literal long strings", \testHashLiteralLongStrings());
        addTestCase("Hash literal expression keys", \testHashLiteralExpressionKeys());
        addTestCase("Parenthesized regex expression", \testParenthesizedRegexMatch());
        addTestCase("Parenthesized division access", \testParenthesizedDivisionAccess());
        addTestCase("Parenthesized expression at EOF", \testParenthesizedExpressionAtEOF());
        addTestCase("Parenthesized hash literals", \testParenthesizedHashLiterals());
        addTestCase("Curly hash literals", \testCurlyHashLiterals());
        addTestCase("Typed hash literals", \testTypedHashLiterals());
        addTestCase("Typed hash nested", \testTypedHashNested());
        addTestCase("Typed hash parse directives", \testTypedHashParseDirectives());
        addTestCase("Typed hash mixed keys", \testTypedHashMixedKeys());
        addTestCase("Hash literal expression values", \testHashLiteralExpressionValues());
        addTestCase("Hash literal unary values", \testHashLiteralUnaryValues());
        addTestCase("Hash literal ternary values", \testHashLiteralTernaryValues());
        addTestCase("Hash literal access values", \testHashLiteralAccessValues());
        addTestCase("Hash literal operator values", \testHashLiteralOperatorValues());
        addTestCase("Conditional parsing mode", \testConditionalParsingMode());
        addTestCase("List assignment parsing", \testListAssignmentParsing());
        addTestCase("Class parsing", \testClassParsing());
        addTestCase("Typedef parsing", \testTypedefParsing());
        addTestCase("Namespace parsing", \testNamespaceParsing());
        addTestCase("Function parsing", \testFunctionParsing());
        addTestCase("Hashdecl parsing", \testHashdeclParsing());
        addTestCase("Hashdecl inheritance parsing", \testHashdeclInheritanceParsing());
        addTestCase("Constant parsing", \testConstantParsing());
        addTestCase("Symbol kind constants", \testSymbolKindConstants());
        addTestCase("Find symbol info", \testFindSymbolInfo());
        addTestCase("Find references", \testFindReferences());
        addTestCase("Hover info", \testHoverInfo());
        addTestCase("getNodesInfo line indexing", \testGetNodesInfo());
        addTestCase("Scope symbols", \testScopeSymbols());
        addTestCase("Doc comments", \testDocComments());
        addTestCase("Doc comments comprehensive", \testDocCommentsComprehensive());
        addTestCase("Doc comments in getNodesInfo", \testDocCommentsGetNodesInfo());
        addTestCase("Doc comments edge cases", \testDocCommentsEdgeCases());
        addTestCase("Date subtype parsing", \testDateSubtypeParsing());
%endif
        set_return_value(main());
    }

%ifdef NoAstParser
    testNoModule() {
        testSkip("astparser module not available");
    }
%else
    testBasicParsing() {
        AstParser parser();
        *AstTree tree = parser.parseString(SimpleClassCode);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testModernModuleParsing() {
        string code = "%modern\nmodule TestModule {\n    version = \"1.0\";\n    desc = \"test module\";\n    author = \"tester\";\n    url = \"http://example\";\n    license = \"MIT\";\n}\npublic namespace TestModule {\n    public int sub getValue() {\n        return 1;\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInBlocks() {
        string code = "%modern\npublic class Foo {\n    int getValue() {\n%disable-warning deprecated\n        return 1;\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInMemberLists() {
        string code = "%modern\nnamespace Test {\n%disable-warning deprecated\n    public class Bar {\n        public {\n%disable-warning deprecated\n            int x;\n        }\n    }\n%disable-warning deprecated\n    public hashdecl Info {\n%disable-warning deprecated\n        int id;\n    }\n%disable-warning deprecated\n    public enum Kind {\n        A,\n%disable-warning deprecated\n        B\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInExpressions() {
        string code = "%modern\npublic hashdecl HttpServerOptionInfo {\n    int idle_threads =\n%ifndef NO_SYSCONF\n        2\n%else\n        10\n%endif\n        ;\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInSwitchCases() {
        string code = "%modern\nsub parse_kind(string type) {\n    switch (type) {\n%ifndef NoYaml\n        case \"yaml\": return 1;\n%endif\n        case \"json\": return 2;\n        default: return 0;\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInListExpressions() {
        string code = "%modern\npublic class ListTest {\n    public {\n        const RequiredKeys = (\n%ifdef PO_NO_PROCESS_CONTROL\n            \"sleep\",\n%endif\n%ifdef PO_NO_THREAD_CONTROL\n            \"start_thread\",\n%endif\n        );\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInHashLiterals() {
        string code = "%modern\npublic class HashTest {\n    public {\n        const DataSerializationSupport = {\n%ifndef NoJson\n            \"json\": \\HashTest::serializeJson(),\n%endif\n            \"none\": \\HashTest::serializeDefault(),\n        };\n    }\n    static code serializeJson() {\n        return \\sprintf; # dummy\n    }\n    static code serializeDefault() {\n        return \\sprintf; # dummy\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInStringConcat() {
        string code = "%new-style\npublic class StringTest {\n    public {\n        const Desc = \"data serialization:\\n\"\n%ifndef NoJson\n            \" - json\\n\"\n%endif\n%ifndef NoYaml\n            \" - yaml\\n\"\n%endif\n            \" - none\\n\";\n    }\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInModuleBlocks() {
        string code = "%new-style\nmodule TestModule {\n%ifndef QORE_QDX_RUN\n    init = sub () {\n    };\n%endif\n}\n";
        AstParser parser();
        parser.setConditionalParsing(True);
        parser.setDefines(("QORE_QDX_RUN",));
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testParseDirectivesInModuleDecls() {
        string code = "%new-style\nmodule TestModule {\n    version = \"1.0\";\n%ifdef QORE_QDX_RUN\n    desc = \"doc\";\n%else\n    desc = \"runtime\";\n%endif\n}\n";
        AstParser parser();
        parser.setConditionalParsing(True);
        parser.setDefines(("QORE_QDX_RUN",));
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testHashLiteralMultilineString() {
        string code = "sub test() {\n    hash h = {\n        \"short_desc\": \"The number of most recent messages from the thread when constructing the context for \"\n            \"the run\",\n    };\n}\n";
        AstParser parser();
        parser.setConditionalParsing(True);
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testHashLiteralLongStrings() {
        string code = "public class OpenAiTrunctationStrategyDataType inherits HashDataType {\n    public {\n        const Fields = {\n            \"type\": {\n                \"display_name\": \"Type\",\n                \"short_desc\": \"The truncation strategy to use for the thread\",\n                \"desc\": \"The truncation strategy to use for the thread. The default is `auto`. If set to \"\n                    \"`last_messages`, the thread will be truncated to the `n` most recent messages in the thread. \"\n                    \"When set to `auto`, messages in the middle of the thread will be dropped to fit the context \"\n                    \"length of the model, `max_prompt_tokens`\",\n                \"type\": AbstractDataProviderTypeMap.\"string\",\n                \"allowed_values\": (\n                    <AllowedValueInfo>{\n                        \"display_name\": \"auto\",\n                        \"short_desc\": \"Messages in the middle of the thread will be dropped to fit the context \"\n                            \"length of the model\",\n                        \"desc\": \"Messages in the middle of the thread will be dropped to fit the context length of \"\n                            \"the model, `max_prompt_tokens`\",\n                        \"value\": \"auto\",\n                    },\n                    <AllowedValueInfo>{\n                        \"display_name\": \"last_messages\",\n                        \"short_desc\": \"The thread will be truncated to the 'n' most recent messages in the thread\",\n                        \"desc\": \"The thread will be truncated to the `n` most recent messages in the thread\",\n                        \"value\": \"last_messages\",\n                    },\n                ),\n                \"default_value\": \"auto\",\n            },\n            \"last_messages\": {\n                \"display_name\": \"Last Messages\",\n                \"short_desc\": \"The number of most recent messages from the thread when constructing the context for \"\n                    \"the run\",\n                \"desc\": \"The number of most recent messages from the thread when constructing the context for the \"\n                    \"run\",\n                \"type\": AbstractDataProviderTypeMap.\"*int\",\n            },\n        };\n    }\n}\n";
        AstParser parser();
        parser.setConditionalParsing(True);
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testHashLiteralExpressionKeys() {
        string code = "%new-style\nsub make_hash() {\n    hash h = (\"a\": 1);\n    return (sprintf(\"%d\", 1): h{\"a\"});\n}\n";
