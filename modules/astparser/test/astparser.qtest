        addTestCase("Hash literal operator values", \testHashLiteralOperatorValues());
        addTestCase("Block comments in hash lookahead", \testBlockCommentsInHashLookahead());
        addTestCase("Consecutive parse options in hash", \testConsecutiveParseOptionsInHash());
        addTestCase("Last index operator in hash", \testLastIndexOperatorInHash());
        addTestCase("Escaped quote in string", \testEscapedQuoteInString());
%ifdef HasAstTreeSearcher
