    testTypedHashNested() {
        string code = "%modern\nsub make_nested_typed_hash() {\n    return <TokenInfo>{\n        \"type\": TOK_EOF,\n        \"value\": \"\",\n        \"meta\": <MetaInfo>{\n            \"path\": \"file.q\",\n            \"line\": 1,\n        },\n    };\n}\n";
