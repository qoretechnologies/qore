        const DocCommentCode = "
%new-style
/** Doc comment for MyClass
    with multiple lines
*/
class MyClass {
    #! Doc for constructor
    constructor() {}

    #! Doc for myMethod
    int myMethod() { return 1; }
}

#! Doc for my_function
sub my_function() {
}

/** Doc for MyConst */
const MyConst = 1;

#! Doc for MyHashDecl
hashdecl MyHashDecl {
    int x;
}
";

        # Comprehensive doc comment test code
        const DocCommentComprehensiveCode = "
%new-style

#! First line of namespace doc
#! Second line of namespace doc
namespace TestNs {
    /** Block doc for ClassA
        @brief A test class
        @since 1.0
    */
    class ClassA {
        #! Doc for public member block
        public {
            #! Doc for member x
            int x;
            #! Doc for member y
            string y;
        }

        #! Doc for private block
        private {
            int z;
        }

        #! Constructor doc
        #! @param val initial value
        constructor(int val) {
            x = val;
        }

        #! Destructor doc
        destructor() {}

        #! Method doc with params
        #! @param a first param
        #! @param b second param
        #! @return the sum
        int add(int a, int b) {
            return a + b;
        }

        /** Static method doc */
        static int staticMethod() {
            return 42;
        }

        #! Abstract method doc
        abstract string abstractMethod();
    }

    #! Class with inheritance doc
    class ClassB inherits ClassA {
        constructor() : ClassA(0) {}
    }

    #! Empty class doc
    class EmptyClass {
    }

    #! Forward declaration doc
    class ForwardDecl;

    #! Hashdecl doc
    #! with multiple lines
    hashdecl MyHash {
        int id;
        string name;
    }

    #! Constant with complex value
    const COMPLEX_CONST = {
        'key': 'value',
    };
}

#! Top-level class without namespace
class TopLevelClass {
    constructor() {}
}
";

        # Test for consecutive doc comments (only last block should attach)
        const DocCommentConsecutiveCode = "
#! First doc block
#! continues here

#! Second doc block (should be used)
#! also continues
class MyClass {
    constructor() {}
}
";

        # Test for doc comment with blank line separation
        const DocCommentBlankLineCode = "
#! Doc comment

class MyClass {
    constructor() {}
}
";

        # Test for no doc comment
        const NoDocCommentCode = "
class MyClass {
    constructor() {}
}
";

        # Test for doc comment with line comments inside the function body
        const DocCommentBodyCommentCode = "
#! Doc for function with body comment
sub func_with_body_comment() {
    # body comment that should not clear the doc comment
    return 1;
}
";

        # Test for doc comment with nested sub expression in body
        const DocCommentNestedSubCode = "
#! Doc for function with nested sub
sub func_with_nested_sub() {
    code inner = sub () {
        return 1;
    };
    return inner();
}
";

