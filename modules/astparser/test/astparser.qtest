    testTypedHashParseDirectives() {
        string code = "%modern\nsub make_typed_hash_directives() {\n    return <TokenInfo>{\n%ifdef QORE_QDX_RUN\n        \"type\": TOK_EOF,\n%else\n        \"type\": TOK_INVALID,\n%endif\n        \"value\": \"\",\n    };\n}\n";
        AstParser parser();
        parser.setConditionalParsing(True);
        parser.setDefines(("QORE_QDX_RUN",));
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testTypedHashMixedKeys() {
        string code = "%modern\nsub make_typed_hash_mixed() {\n    return <TokenInfo>{\n        type: TOK_EOF,\n        \"value\": \"\",\n        id: 1,\n    };\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testHashLiteralExpressionValues() {
        string code = "%modern\nsub make_hash_with_exprs() {\n    list<hash> l = ();\n    *string placeholder;\n    string path;\n    l += {\n        \"type\": ET_Placeholder,\n        \"val\": {\n            \"type\": remove placeholder,\n            \"path\": path,\n        },\n    };\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testHashLiteralUnaryValues() {
        string code = "%modern\nsub make_hash_with_unary() {\n    string path;\n    return {\n        \"type\": -1,\n        \"path\": path,\n    };\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testHashLiteralTernaryValues() {
        string code = "%modern\nsub make_hash_with_ternary() {\n    bool cond = True;\n    string val;\n    return {\n        \"type\": cond ? ET_RawString : ET_QuotedString,\n        \"val\": val,\n    };\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testHashLiteralAccessValues() {
        string code = "%modern\nsub make_hash_with_access() {\n    hash h = {\n        \"any\": 1,\n    };\n    return {\n        \"type\": h.any,\n        \"type_code\": h.\"any\",\n    };\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testHashLiteralOperatorValues() {
        string code = "%modern\nsub make_hash_with_ops() {\n    list l = (1, 2);\n    hash h = {\n        \"a\": 1,\n    };\n    string s = \"  value\\n\";\n    return {\n        \"keys\": keys h,\n        \"shift\": shift l,\n        \"pop\": pop l,\n        \"chomp\": chomp s,\n        \"trim\": trim s,\n    };\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testConditionalParsingMode() {
        string code = "%modern\n%define DOC_FLAG\n%ifdef DOC_FLAG\nconst DOC_CONST = 1;\n%else\nconst OTHER_CONST = 2;\n%endif\n%if defined(DOC_FLAG)\nconst IF_CONST = 3;\n%else\nconst IF_OTHER = 4;\n%endif\n";
        AstParser parser();
        parser.setConditionalParsing(True);
        *AstTree tree = parser.parseString(code);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        AstTreeSearcher searcher();
        *list syms = searcher.findSymbols(tree, "test.q");
        assertEq(True, exists(syms), "symbols found");

        bool has_doc = False;
        bool has_other = False;
        bool has_if = False;
        bool has_if_other = False;
        foreach auto s in (syms) {
            if (s.kind == ASYK_Constant && s.name == "DOC_CONST") {
                has_doc = True;
            } else if (s.kind == ASYK_Constant && s.name == "OTHER_CONST") {
                has_other = True;
            } else if (s.kind == ASYK_Constant && s.name == "IF_CONST") {
                has_if = True;
            } else if (s.kind == ASYK_Constant && s.name == "IF_OTHER") {
                has_if_other = True;
            }
        }
        testAssertion("DOC_CONST present", \equals(), (has_doc, True));
        testAssertion("OTHER_CONST absent", \equals(), (has_other, False));
        testAssertion("IF_CONST present", \equals(), (has_if, True));
        testAssertion("IF_OTHER absent", \equals(), (has_if_other, False));

        string code_else = "%modern\n%ifdef DOC_FLAG\nconst DOC_CONST = 1;\n%else\nconst OTHER_CONST = 2;\n%endif\n";
        AstParser parser_else();
        parser_else.setConditionalParsing(True);
        *AstTree tree_else = parser_else.parseString(code_else);
        assertEq(0, parser_else.getErrorCount(), "no parse errors (else)");
        *list syms_else = searcher.findSymbols(tree_else, "test.q");
        bool has_other_only = False;
        bool has_doc_else = False;
        foreach auto s in (syms_else) {
            if (s.kind == ASYK_Constant && s.name == "OTHER_CONST") {
                has_other_only = True;
            } else if (s.kind == ASYK_Constant && s.name == "DOC_CONST") {
                has_doc_else = True;
            }
        }
        testAssertion("OTHER_CONST present (else)", \equals(), (has_other_only, True));
        testAssertion("DOC_CONST absent (else)", \equals(), (has_doc_else, False));
    }

    testListAssignmentParsing() {
        string code = "%modern\nsub parse_value(string str) {\n    (*string num, *string suffix) = (str =~ x/^([0-9]+)\\s*([a-z]+)?$/i);\n    return (num, suffix);\n}\n";
        AstParser parser();
        *AstTree tree = parser.parseString(code);
        testAssertion("parseString returns tree", \exists(), (tree,));
        testAssertion("no parse errors", \equals(), (parser.getErrorCount(), 0));
    }

    testClassParsing() {
        AstParser parser();
        *AstTree tree = parser.parseString(SimpleClassCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        AstTreeSearcher searcher();
        *list syms = searcher.findSymbols(tree, "test.q");

        assertEq(True, exists(syms), "symbols found");

        # Find class symbol
        bool foundClass = False;
        foreach auto s in (syms) {
            if (s.kind == ASYK_Class && s.name == "MyClass") {
                foundClass = True;
                break;
            }
        }
        testAssertion("class symbol found", \equals(), (foundClass, True));

        # Find method symbol
        bool foundMethod = False;
        foreach auto s in (syms) {
            if (s.kind == ASYK_Method && s.name =~ /getX/) {
                foundMethod = True;
                break;
            }
        }
        testAssertion("method symbol found", \equals(), (foundMethod, True));
    }

    testTypedefParsing() {
        AstParser parser();
        *AstTree tree = parser.parseString(TypedefCode);
        assertEq(0, parser.getErrorCount(), "no parse errors");

        AstTreeSearcher searcher();
        *list syms = searcher.findSymbols(tree, "test.q");

        assertEq(True, exists(syms), "symbols found");

        # Count typedef symbols
        int typedefCount = 0;
        list<string> typedefNames = ();
        foreach auto s in (syms) {
            if (s.kind == ASYK_TypeAlias) {
                typedefCount++;
                typedefNames += s.name;
            }
        }

        testAssertion("found 3 typedefs", \equals(), (typedefCount, 3));
        testAssertion("MyInt typedef found", \inlist_hard(), ("Test::MyInt", typedefNames));
        testAssertion("MyString typedef found", \inlist_hard(), ("Test::MyString", typedefNames));
        testAssertion("MyList typedef found", \inlist_hard(), ("Test::MyList", typedefNames));
    }

