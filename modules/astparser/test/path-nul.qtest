#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# A file name with a NUL character is refused instead of being cut at the NUL character.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"

%requires Util
%requires QUnit
%requires FsUtil
%requires astparser

%exec-class AstParserPathNulTest

class AstParserPathNulTest inherits QUnit::Test {
    constructor() : QUnit::Test("astparser path NUL characters", "1.0", \ARGV) {
        addTestCase("AstParser::parseFile()", \testParseFile());
        addTestCase("AstTree::printTree()", \testPrintTree());
        set_return_value(main());
    }

    #! asserts that the code raises the given error for a string with a NUL character at the given byte offset
    /** @param what what the string is in the description, ex: \c "path"
    */
    assertNul(string err, string what, int offset, code c, string label) {
        try {
            c();
            assertTrue(False, label + ": an exception is raised");
        } catch (hash<ExceptionInfo> ex) {
            assertEq(err, ex.err, label + ": error code");
            assertEq(0, ex.desc.find(what + " \""), label + ": the description names the " + what);
            assertTrue(ex.desc.find(sprintf("\" contains a NUL character at byte offset %d; ", offset)) > 0,
                label + ": the description gives the offset of the NUL character");
            assertEq(EINVAL, ex.arg, label + ": the argument is EINVAL");
        }
    }

    testParseFile() {
        TmpDir dir("astparser-path-nul-");
        string src = dir.path + "/code.q";
        File f();
        f.open2(src, O_CREAT | O_TRUNC | O_WRONLY);
        f.write("sub f() {}\n");
        f.close();

        AstParser parser();
        # cut at the NUL character, the name would name the source file
        assertEq(NOTHING, parser.parseFile(src + "\x00.txt"), "parseFile() of a name with a NUL character");
        assertEq(EINVAL, errno(), "errno() is EINVAL");
        assertTrue(parser.parseFile(src) instanceof AstTree, "parseFile() without the NUL character");
    }

    testPrintTree() {
        TmpDir dir("astparser-path-nul-");
        string out = dir.path + "/tree.txt";
        AstParser parser();
        AstTree tree = parser.parseString("sub f() {}\n");
        assertNul("FILE-OPEN-ERROR", "path", out.size(), sub () { tree.printTree(out + "\x00.log"); },
            "printTree()");
        assertFalse(is_file(out), "no file is created");
        tree.printTree(out);
        assertTrue(is_file(out), "printTree() without the NUL character");
    }
}
