#include <fstream>

#include "qore/Qore.h"

#include "AstTreeHolder.h"

//! AstTree class
/** AST tree structure.

    @since %Qore 0.8.13
 */
qclass AstTree [arg=AstTreeHolder* ath; ns=astparser; flags=final];

//! Creates the AstTree.
/**
 */
AstTree::constructor() {
    self->setPrivate(CID_ASTTREE, new AstTreeHolder);
}

//! Print tree.
/**
    @param file name of file where to print out the tree
 */
AstTree::printTree(string file) {
    std::ofstream ofs(file->c_str(), std::ofstream::out | std::ofstream::trunc);
    ath->printTree(ofs);
}

//! Get info about nodes in the tree.
/** Export the tree structure to Qore hashes and lists.
    @return list of node info hashes
 */
list AstTree::getNodesInfo() {
    return ath->getNodesInfo();
}

//! Returns a list of all comments found in the source code.
/** Each entry is a hash with the following keys:
    - \c "kind" (\c int): comment kind (0 = line, 1 = block, 2 = doc line, 3 = doc block)
    - \c "text" (\c string): full comment text including delimiters
    - \c "loc" (\c hash): location hash with keys \c "firstLine", \c "firstCol", \c "lastLine", \c "lastCol"

    @return list of comment hashes, or @ref nothing if no tree is set

    @since astparser 2.0
 */
*list<hash<auto>> AstTree::getComments() {
    return ath->getComments();
}
