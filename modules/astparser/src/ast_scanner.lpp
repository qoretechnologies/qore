<incl>{WS}*                             /* ignore white space */
<incl>[^\n\r]+                          {
                                            yylval->parseopt = new ASTStringParseOption(APOK_INCLUDE, yytext);
                                            BEGIN(INITIAL);
                                            return PARSE_OPTION_END;
