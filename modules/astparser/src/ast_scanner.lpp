#define AST_SCANNER 1

// issue #3166: use q_strtod() from Qore and avoid warnings
DLLEXPORT double q_strtod(const char* str);

static int ascii_to_octal(char c) {
    return c - '0';
}

#ifdef AST_SCANNER
static int brace_depth = 0;
static std::vector<int> typed_hash_depths;

static bool is_identifier_string(const std::string& s) {
    if (s.empty()) {
        return false;
    }
    if (!isalpha(static_cast<unsigned char>(s[0])) && s[0] != '_') {
        return false;
    }
    for (size_t i = 1; i < s.size(); ++i) {
        unsigned char c = static_cast<unsigned char>(s[i]);
        if (!isalnum(c) && c != '_') {
            return false;
        }
    }
    return true;
}

#define AST_PEEK_NEXT_NONSPACE(scanner, out_c) \
    do { \
        std::vector<int> buf; \
        int c = 0; \
        do { \
            c = yyinput(scanner); \
            if (c == EOF) { \
                break; \
            } \
            buf.push_back(c); \
        } while (c == ' ' || c == '\\t' || c == '\\r' || c == '\\n'); \
        for (int i = static_cast<int>(buf.size()) - 1; i >= 0; --i) { \
            unput(buf[i]); \
        } \
        out_c = c; \
    } while (false)
#endif

static char* make_scoped_vref(const char* str) {
    size_t len = strlen(str);
    char* rv = (char*)malloc(sizeof(char) * len);
    size_t i = 0;
    while (*str) {
        if (*str != '$')
            rv[i++] = *str;
        ++str;
    }
    rv[i] = '\0';
    return rv;
}

// the return value of this function must be freed if non-0
static char* trim(const char* str) {
    while ((*str) == ' ' || (*str) == '\t')
        str++;
    // duplicate string
    char* n = strdup(str);
    // find end of string
    unsigned l = (unsigned)strlen(n);
    if (l) {
        char* e = n + l - 1;
        while ((*e) == ' ' || (*e) == '\t')
            *(e--) = '\0';
    }
    if (!n[0]) {
        free(n);
        n = 0;
    }
    return n;
}

// edits the string (even though it's a 'const char*') and returns a pointer to a string with leading and trailing whitespace removed
static char* trim_inplace(const char* str) {
    while ((*str) == ' ' || (*str) == '\t')
        str++;
    // find end of string
    unsigned l = (unsigned)strlen(str);
    if (l) {
        const char* e = str + l - 1;
        while ((*e) == ' ' || (*e) == '\t')
            *((char*)(e--)) = '\0';
    }
    return str[0] ? (char*)str : 0;
}

static char* remove_quotes(char* str) {
    str[strlen(str) - 1] = '\0';
    return str + 1;
}

static int64_t parse_get_integer(const char* str, bool& err) {
    errno = 0;
    int64_t rv = strtoll(str, 0, 10);
    if (errno == ERANGE)
        err = true;
    return rv;
}

static bool isRegexModifier(ASTRegexExpression* re, int c) {
    if (c == 'i')
        re->caseSensitive = false;
    else if (c == 's')
        re->dotAll = true;
    else if (c == 'x')
        re->extended = true;
    else if (c == 'm')
        re->multiline = true;
    else if (c == 'u') {
        re->unicode = true;
    } else {
        return false;
    }
    return true;
}

static bool isRegexExtractModifier(ASTRegexExpression* re, int c) {
    if (isRegexModifier(re, c))
        return true;
    if (c == 'g')
        re->global = true;
    else
        return false;
    return true;
}

static bool isRegexSubstModifier(ASTRegexSubstExpression* rs, int c) {
    if (c == 'g')
        rs->global = true;
    else if (c == 'i')
        rs->caseSensitive = false;
    else if (c == 's')
        rs->dotAll = true;
    else if (c == 'x')
        rs->extended = true;
    else if (c == 'm')
        rs->multiline = true;
    else if (c == 'u') {
        rs->unicode = true;
    } else {
        return false;
    }
    return true;
}

static char* make_cast(const char* s) {
    size_t size = strlen(s+5);

    // copy and cut off the trailing '>'
    char* str = (char*) malloc(size--);
    memcpy(str, s+5, size);
    str[size] = '\0';

    // trim
    while (size > 0 && str[--size] == ' ') str[size] = '\0';
    return str;
}

static bool angle_balanced(const char* p) {
    int ob = 0;
    int cb = 0;
    while (*p) {
        switch (*p) {
            case '<': ++ob; break;
            case '>': ++cb; break;
        }
        ++p;
    }
    return ob == cb;
}

#define AST_DOT_KW_IDENTIFIER(kw) { yylval->String = new std::string(kw); size_t pos = yylval->String->size() + 1; if (yytext[pos]) unput(yytext[pos]); return DOT_KW_IDENTIFIER; }

#define AST_FLEX_DO_EOF yyterminate();

// Global parse options.
bool PO_BROKEN_LOGIC_PRECEDENCE = false;
bool PO_BROKEN_OPERATORS = false;
bool PO_NO_TRANSIENT = false;
bool PO_NO_TYPEDEF = false;
bool PO_NO_ENUM = false;

// Pending doc comment - accumulates doc comment text to be attached to the next declaration
static std::string* pendingDocComment = nullptr;
// Tracks whether we're in a consecutive doc comment block
static bool inDocCommentBlock = false;
// Claimed doc comment for class declarations - stored separately so class body members don't steal it
static std::string* pendingClassDocComment = nullptr;
// Claimed doc comment for hashdecl declarations - stored separately so hashdecl body members don't steal it
static std::string* pendingHashdeclDocComment = nullptr;
// Claimed doc comment for namespace declarations - stored separately so namespace body members don't steal it
static std::string* pendingNamespaceDocComment = nullptr;

// Conditional parsing stack entry
struct ConditionalEntry {
    bool elseSeen;      // Have we seen %else for this level?
    bool inElseBranch;  // Are we currently in the else branch?

    ConditionalEntry() : elseSeen(false), inElseBranch(false) {}
};

// Stack of conditional parsing levels
static std::vector<ConditionalEntry> conditionalStack;
static size_t cond_skip_depth = 0;
static bool ast_conditional_eval = false;
static std::unordered_set<std::string> ast_defines;

// Push a new conditional level
static void cond_push() {
    conditionalStack.push_back(ConditionalEntry());
}

// Pop a conditional level, returns true if stack was not empty
static bool cond_pop() {
    if (conditionalStack.empty()) {
        return false;
    }
    conditionalStack.pop_back();
    return true;
}

// Check if we're in a conditional block
static bool cond_in_block() {
    return !conditionalStack.empty();
}

// Check if %else was already seen at current level
static bool cond_has_else() {
    if (conditionalStack.empty()) {
        return false;
    }
    return conditionalStack.back().elseSeen;
}

// Mark that we've seen %else at current level
static void cond_mark_else() {
    if (!conditionalStack.empty()) {
        conditionalStack.back().elseSeen = true;
        conditionalStack.back().inElseBranch = true;
    }
}

// Get current nesting depth
static size_t cond_depth() {
    return conditionalStack.size();
}

static void cond_set_skip_depth() {
    cond_skip_depth = cond_depth();
}

static bool cond_is_skip_top_level() {
    return cond_depth() == cond_skip_depth;
}

extern "C" void ast_scanner_set_conditional_eval(bool enabled) {
    ast_conditional_eval = enabled;
}

extern "C" void ast_scanner_clear_defines() {
    ast_defines.clear();
}

extern "C" void ast_scanner_add_define(const char* name) {
    if (name && *name) {
        ast_defines.insert(name);
    }
}

extern "C" void ast_scanner_reset_conditionals() {
    conditionalStack.clear();
    cond_skip_depth = 0;
}

static void ast_define_from_line(const char* pstr) {
    if (!pstr) {
        return;
    }
    char* trimmed = trim_inplace(pstr);
    if (!trimmed) {
        return;
    }
    char* space = strchr(trimmed, ' ');
    if (space) {
        *space = '\0';
    }
    if (*trimmed) {
        ast_defines.insert(trimmed);
    }
}

static bool ast_is_defined(const char* pstr) {
    if (!pstr) {
        return false;
    }
    char* trimmed = trim_inplace(pstr);
    if (!trimmed || !*trimmed) {
        return false;
    }
    return ast_defines.find(trimmed) != ast_defines.end();
}

// Expression parser for %if directive with boolean logic support
// Grammar:
//   expr     := or_expr
//   or_expr  := and_expr ('||' and_expr)*
//   and_expr := unary_expr ('&&' unary_expr)*
//   unary_expr := '!' unary_expr | primary
//   primary  := 'defined' '(' IDENT ')' | '(' expr ')'
class AstConditionParser {
private:
    const char* pos;
    const char* end;
    bool error;

    void skip_whitespace() {
        while (pos < end && (*pos == ' ' || *pos == '\t')) {
            ++pos;
        }
    }

    bool match(const char* str) {
        skip_whitespace();
        size_t len = strlen(str);
        if (pos + len <= end && !strncmp(pos, str, len)) {
            // For "defined", make sure next char isn't alphanumeric or underscore
            if (strcmp(str, "defined") == 0 && pos + len < end
                && (isalnum(static_cast<unsigned char>(pos[len])) || pos[len] == '_')) {
                return false;
            }
            pos += len;
            return true;
        }
        return false;
    }

    bool peek(const char* str) {
        skip_whitespace();
        size_t len = strlen(str);
        return pos + len <= end && !strncmp(pos, str, len);
    }

    bool parse_identifier(std::string& ident) {
        skip_whitespace();
        if (pos >= end || (!isalpha(*pos) && *pos != '_')) {
            return false;
        }
        const char* start = pos++;
        while (pos < end && (isalnum(*pos) || *pos == '_')) {
            ++pos;
        }
        ident.assign(start, pos - start);
        return true;
    }

    bool parse_primary() {
        skip_whitespace();

        if (match("defined")) {
            skip_whitespace();
            if (!match("(")) {
                error = true;
                return false;
            }
            std::string ident;
            if (!parse_identifier(ident)) {
                error = true;
                return false;
            }
            skip_whitespace();
            if (!match(")")) {
                error = true;
                return false;
            }
            return ast_defines.find(ident) != ast_defines.end();
        }

        if (match("(")) {
            bool result = parse_or_expr();
            skip_whitespace();
            if (!match(")")) {
                error = true;
                return false;
            }
            return result;
        }

        error = true;
        return false;
    }

    bool parse_unary_expr() {
        skip_whitespace();
        if (match("!")) {
            return !parse_unary_expr();
        }
        return parse_primary();
    }

    bool parse_and_expr() {
        bool result = parse_unary_expr();
        if (error) {
            return false;
        }
        while (peek("&&")) {
            match("&&");
            bool rhs = parse_unary_expr();
            if (error) {
                return false;
            }
            result = result && rhs;
        }
        return result;
    }

    bool parse_or_expr() {
        bool result = parse_and_expr();
        if (error) {
            return false;
        }
        while (peek("||")) {
            match("||");
            bool rhs = parse_and_expr();
            if (error) {
                return false;
            }
            result = result || rhs;
        }
        return result;
    }

public:
    AstConditionParser(const char* expr, size_t len)
        : pos(expr), end(expr + len), error(false) {}

    bool parse(bool& result) {
        skip_whitespace();
        if (pos >= end) {
            return false;
        }
        result = parse_or_expr();
        if (error) {
            return false;
        }
        skip_whitespace();
        return pos >= end;
    }
};

static bool ast_parse_simple_defined_expr(const char* expr, bool& result) {
    const char* p = expr;
    auto skip_ws = [&p]() {
        while (*p == ' ' || *p == '\t') {
            ++p;
        }
    };
    auto parse_ident = [&p](std::string& ident) -> bool {
        if (!*p || (!isalpha(static_cast<unsigned char>(*p)) && *p != '_')) {
            return false;
        }
        const char* start = p++;
        while (*p && (isalnum(static_cast<unsigned char>(*p)) || *p == '_')) {
            ++p;
        }
        ident.assign(start, p - start);
        return true;
    };

    skip_ws();
    bool negate = false;
    while (*p == '!') {
        negate = !negate;
        ++p;
        skip_ws();
    }
    if (strncmp(p, "defined", 7) != 0) {
        return false;
    }
    if (isalnum(static_cast<unsigned char>(p[7])) || p[7] == '_') {
        return false;
    }
    p += 7;
    skip_ws();
    std::string ident;
    if (*p == '(') {
        ++p;
        skip_ws();
        if (!parse_ident(ident)) {
            return false;
        }
        skip_ws();
        if (*p != ')') {
            return false;
        }
        ++p;
    } else {
        if (!parse_ident(ident)) {
            return false;
        }
    }
    skip_ws();
    if (*p) {
        return false;
    }
    bool val = ast_defines.find(ident) != ast_defines.end();
    result = negate ? !val : val;
    return true;
}

static bool ast_evaluate_condition(const char* expr, bool& result) {
    if (!expr) {
        return false;
    }
    char* trimmed = trim_inplace(expr);
    if (!trimmed || !*trimmed) {
        return false;
    }
    AstConditionParser parser(trimmed, strlen(trimmed));
    if (parser.parse(result)) {
        return true;
    }
    // Fallback to simple parser for backwards compatibility
    return ast_parse_simple_defined_expr(trimmed, result);
}

// Clears the pending doc comment
static void clearPendingDocComment() {
    delete pendingDocComment;
    pendingDocComment = nullptr;
    inDocCommentBlock = false;
}

// Claims the pending doc comment for a class declaration
// This should be called when the scanner sees the 'class' keyword, before the class body is parsed
static void claimClassDocComment() {
    delete pendingClassDocComment;
    pendingClassDocComment = pendingDocComment;
    pendingDocComment = nullptr;
    inDocCommentBlock = false;
}

// Claims the pending doc comment for a hashdecl declaration
// This should be called when the scanner sees the 'hashdecl' keyword, before the hashdecl body is parsed
static void claimHashdeclDocComment() {
    delete pendingHashdeclDocComment;
    pendingHashdeclDocComment = pendingDocComment;
    pendingDocComment = nullptr;
    inDocCommentBlock = false;
}

// Claims the pending doc comment for a namespace declaration
// This should be called when the scanner sees the 'namespace' keyword, before the namespace body is parsed
static void claimNamespaceDocComment() {
    delete pendingNamespaceDocComment;
    pendingNamespaceDocComment = pendingDocComment;
    pendingDocComment = nullptr;
    inDocCommentBlock = false;
}

// Called when starting a new doc comment
// If we're continuing a consecutive doc comment block, append; otherwise replace
static void startDocComment(const char* text) {
    if (inDocCommentBlock && pendingDocComment) {
        // Append to existing doc comment
        pendingDocComment->append("\n");
        pendingDocComment->append(text);
    } else {
        // Start fresh
        delete pendingDocComment;
        pendingDocComment = new std::string(text);
    }
    inDocCommentBlock = true;
}

// Appends text to the current doc comment
static void appendDocComment(const char* text) {
    if (pendingDocComment) {
        pendingDocComment->append(text);
    }
}

// Called when we see any non-doc-comment, non-whitespace token
static void endDocCommentBlock() {
    inDocCommentBlock = false;
}

// Takes ownership of the pending doc comment (returns it and clears the static variable)
// NOTE: This function is called from ast_parser.ypp, so it cannot be static
std::string* takePendingDocComment() {
    std::string* result = pendingDocComment;
    pendingDocComment = nullptr;
    return result;
}

// Takes ownership of the claimed class doc comment (returns it and clears the static variable)
// NOTE: This function is called from ast_parser.ypp, so it cannot be static
std::string* takeClassDocComment() {
    std::string* result = pendingClassDocComment;
    pendingClassDocComment = nullptr;
    return result;
}

// Takes ownership of the claimed hashdecl doc comment (returns it and clears the static variable)
// NOTE: This function is called from ast_parser.ypp, so it cannot be static
std::string* takeHashdeclDocComment() {
    std::string* result = pendingHashdeclDocComment;
    pendingHashdeclDocComment = nullptr;
    return result;
}

// Takes ownership of the claimed namespace doc comment (returns it and clears the static variable)
// NOTE: This function is called from ast_parser.ypp, so it cannot be static
std::string* takeNamespaceDocComment() {
    std::string* result = pendingNamespaceDocComment;
    pendingNamespaceDocComment = nullptr;
    return result;
}
%}

%option noyywrap nomain noyy_top_state warn
%option reentrant bison-bridge bison-locations
%option stack
%option yylineno
%option noyy_push_state
%option noyy_pop_state

%x str_state regex_state incl p_def p_ifdef p_ifndef p_if p_elif p_skip_to_endif p_skip_to_endif_or_else case_state regex_googleplex regex_negative_universe regex_subst1 regex_subst2 line_comment doc_line_comment block_comment1 block_comment2 doc_block_comment exec_class_state requires regex_trans1 regex_trans2 regex_extract_state disable_warning enable_warning append_path_state append_module_state module_cmd set_zone try_module try_reexport_module angle_state

HEX_DIGIT       [0-9A-Fa-f]
HEX_CONST       0x{HEX_DIGIT}+
OCTAL_CONST     \\[0-7]{1,3}
DIGIT           [0-9]
WORD            [a-zA-Z_][a-zA-Z0-9_]*
WS              [ \t\r]
WSNL            [ \t\r\n]
YEAR            [0-9]{4}
MONTH           (0[1-9])|(1[012])
DAY             ((0[1-9])|([12][0-9])|(3[01]))
HOUR            ([01][0-9])|(2[0-3])
MSEC            [0-5][0-9]
US              [0-9]{1,6}
D2              [0-9]{2}
BINARY          <({HEX_DIGIT}{HEX_DIGIT})+>
TZ              (Z|([+-][01][0-9](:{MSEC}(:{MSEC})?)?))
RDATE           P(-?[0-9]+(\.[0-9]+)?[YMDHSu])+
RDATETIME       P(-?[0-9]+(\.[0-9]+)?[YMD])+T(-?[0-9]+(\.[0-9]+)?[HMSu])+
RTIME           PT(-?[0-9]+(\.[0-9]+)?[HMSu])+

