    <<EOF>>                             { AST_FLEX_DO_EOF }
}
^%elif{WS}*$                            {
                                            // %elif with no expression
                                            if (!cond_in_block()) {
                                                // %elif without %if - just ignore
                                            } else if (cond_has_else()) {
                                                // %elif after %else - ignore (would be error in real parser)
                                            }
                                            if (ast_conditional_eval && cond_in_block()) {
                                                cond_set_skip_depth();
                                                BEGIN(p_skip_to_endif);
                                            }
                                        }
^%elif{WS}+                             { BEGIN(p_elif); return PARSE_OPTION_BEGIN; }
<p_elif>{
    [^\n\r]+$                           {
                                            const char* trimmed = trim_inplace(yytext);
                                            if (trimmed)
                                                yylval->parseopt = new ASTStringParseOption(APOK_ELIF, trimmed);
                                            if (ast_conditional_eval && cond_in_block()) {
                                                cond_set_skip_depth();
                                                BEGIN(p_skip_to_endif);
                                            } else {
                                                BEGIN(INITIAL);
                                            }
                                            return PARSE_OPTION_END;
                                        }
    <<EOF>>                             { AST_FLEX_DO_EOF }
}
^%else{WS}*$                            {
                                            if (!cond_in_block()) {
                                                // %else without %if - just ignore for AST parsing
                                            } else if (cond_has_else()) {
                                                // Duplicate %else - ignore (would be error in real parser)
                                            } else {
                                                // Mark that we've seen %else at this level
                                                cond_mark_else();
                                            }
                                            if (ast_conditional_eval && cond_in_block()) {
                                                cond_set_skip_depth();
                                                BEGIN(p_skip_to_endif);
                                            }
                                            yylval->parseopt = new ASTParseOption(APOK_ELSE);
                                            return PARSE_OPTION_FULL;
                                        }
^%endif{WS}*$                           {
                                            // Pop the conditional level
                                            if (!cond_pop()) {
                                                // %endif without matching %if/%ifdef/%ifndef - ignore for AST parsing
                                            }
                                            yylval->parseopt = new ASTParseOption(APOK_ENDIF);
                                            return PARSE_OPTION_FULL;
                                        }
<p_skip_to_endif>{
    ^%endif{WS}*$                       {
                                            if (cond_pop() && cond_depth() < cond_skip_depth) {
                                                cond_skip_depth = 0;
                                                BEGIN(INITIAL);
                                            }
                                        }
    ^%else{WS}*$                        {
                                            if (cond_is_skip_top_level() && cond_has_else()) {
                                                // ignore
                                            }
                                        }
    ^%elif{WS}+[^\n\r]+$                {
                                            if (cond_is_skip_top_level() && cond_has_else()) {
                                                // ignore
                                            }
                                        }
    ^.*                                 {
                                            if (!strncmp("%ifdef", yytext, 6) || !strncmp("%ifndef", yytext, 7)) {
                                                cond_push();
                                            } else if (!strncmp("%if", yytext, 3)
                                                && (yytext[3] == ' ' || yytext[3] == '\t')) {
                                                cond_push();
                                            }
                                        }
    \n                                  // ignore
    <<EOF>>                             { AST_FLEX_DO_EOF }
}
<p_skip_to_endif_or_else>{
    ^%elif{WS}+[^\n\r]+$                {
                                            if (cond_is_skip_top_level()) {
                                                if (!cond_has_else()) {
                                                    const char* expr = yytext + 5;
                                                    while (*expr == ' ' || *expr == '\t') {
                                                        ++expr;
                                                    }
                                                    bool result = false;
                                                    if (ast_evaluate_condition(expr, result) && result) {
                                                        cond_skip_depth = 0;
                                                        BEGIN(INITIAL);
                                                    }
                                                } else {
                                                    BEGIN(p_skip_to_endif);
                                                }
                                            }
                                        }
    ^%else{WS}*$                        {
                                            if (cond_is_skip_top_level()) {
                                                if (!cond_has_else()) {
                                                    cond_mark_else();
                                                    cond_skip_depth = 0;
                                                    BEGIN(INITIAL);
                                                } else {
                                                    BEGIN(p_skip_to_endif);
                                                }
                                            }
                                        }
    ^%endif{WS}*$                       {
                                            if (cond_pop() && cond_depth() < cond_skip_depth) {
                                                cond_skip_depth = 0;
                                                BEGIN(INITIAL);
                                            }
                                        }
    ^.*                                 {
                                            if (!strncmp("%ifdef", yytext, 6) || !strncmp("%ifndef", yytext, 7)) {
                                                cond_push();
                                            } else if (!strncmp("%if", yytext, 3)
                                                && (yytext[3] == ' ' || yytext[3] == '\t')) {
                                                cond_push();
                                            }
                                        }
    \n                                  // ignore
    <<EOF>>                             { AST_FLEX_DO_EOF }
}
