\!\~                                    { BEGIN(regex_negative_universe); return REGEX_NMATCH; }
\(                                      {
                                            endDocCommentBlock();
#ifdef AST_SCANNER
                                            bool is_hash_literal = false;
                                            {
                                                bool saw_top_qmark = false;
                                                bool saw_colon = false;
                                                bool saw_comma = false;
                                                int paren_depth = 0;
                                                int brace_depth = 0;
                                                int bracket_depth = 0;
                                                int c = 0;
                                                int prev_nonspace = 0;
                                                // Avoid yyinput() for string-backed buffers; it can crash on refills.
                                                bool use_input = YY_CURRENT_BUFFER_LVALUE->yy_input_file != nullptr;
                                                bool saw_regex_op = false;
                                                std::vector<int> buf;
                                                const char* scan_p = yyg->yy_c_buf_p;
                                                int scan_idx = 0;
                                                auto read_char = [&]() -> int {
                                                    if (use_input) {
                                                        int ch = yyinput(yyscanner);
                                                        if (ch != EOF) {
                                                            buf.push_back(ch);
                                                        }
                                                        return ch;
                                                    }
                                                    int ch = (scan_idx == 0)
                                                        ? yyg->yy_hold_char
                                                        : static_cast<unsigned char>(scan_p[scan_idx]);
                                                    if (ch == YY_END_OF_BUFFER_CHAR) {
                                                        return EOF;
                                                    }
                                                    ++scan_idx;
                                                    return ch;
                                                };
                                                auto unread_buf = [&]() {
                                                    if (!use_input) {
                                                        return;
                                                    }
                                                    for (int i = static_cast<int>(buf.size()) - 1; i >= 0; --i) {
                                                        unput(buf[i]);
                                                    }
                                                };

                                                do {
                                                    c = read_char();
                                                } while (c == ' ' || c == '\t' || c == '\r' || c == '\n');

                                                while (c != EOF && c != 0) {
                                                    if (c == '=' || c == '!') {
                                                        int nextc = read_char();
                                                        if (nextc == '~') {
                                                            saw_regex_op = true;
                                                            prev_nonspace = '~';
                                                            c = read_char();
                                                            continue;
                                                        }
                                                        prev_nonspace = c;
                                                        c = nextc;
                                                        continue;
                                                    }
                                                    if (c == '"' || c == '\'') {
                                                        int quote = c;
                                                        bool escaped = false;
                                                        while (true) {
                                                            c = read_char();
                                                            if (c == EOF || c == 0) {
                                                                break;
                                                            }
                                                            if (escaped) {
                                                                escaped = false;
                                                                continue;
                                                            }
                                                            if (c == '\\') {
                                                                escaped = true;
                                                                continue;
                                                            }
                                                            if (c == quote) {
                                                                break;
                                                            }
                                                        }
                                                        prev_nonspace = 'S';
                                                    } else if (c == '/') {
                                                        // First check for block comment /*...*/
                                                        int nextc = read_char();
                                                        if (nextc == '*') {
                                                            // Block comment - skip until */
                                                            bool saw_star = false;
                                                            while (true) {
                                                                c = read_char();
                                                                if (c == EOF || c == 0) {
                                                                    break;
                                                                }
                                                                if (saw_star && c == '/') {
                                                                    // End of block comment
                                                                    break;
                                                                }
                                                                saw_star = (c == '*');
                                                            }
                                                            c = read_char();
                                                            continue;
                                                        }
                                                        // Not a block comment - check for regex or division
                                                        // Treat only regex contexts as regex literals to avoid
                                                        // swallowing division operators when scanning for hash keys.
                                                        bool regex_candidate = saw_regex_op
                                                            || prev_nonspace == 0
                                                            || strchr("([,{=:+-*!?&|^~", prev_nonspace) != nullptr;
                                                        if (!regex_candidate) {
                                                            prev_nonspace = c;
                                                            c = nextc;
                                                            continue;
                                                        }
                                                        // Regex - read the content we already peeked
                                                        c = nextc;
                                                        bool escaped = false;
                                                        while (c != EOF && c != 0) {
                                                            if (escaped) {
                                                                escaped = false;
                                                            } else if (c == '\\') {
                                                                escaped = true;
                                                            } else if (c == '/') {
                                                                break;
                                                            }
                                                            c = read_char();
                                                        }
                                                        while (true) {
                                                            c = read_char();
                                                            if (c == EOF || c == 0) {
                                                                break;
                                                            }
                                                            if (!isalpha(static_cast<unsigned char>(c))) {
                                                                break;
                                                            }
                                                        }
                                                        prev_nonspace = 'R';
                                                        saw_regex_op = false;
                                                        continue;
                                                    } else if (c == '#' && prev_nonspace != '$') {
                                                        // Line comment - skip until newline
                                                        // Note: $# is the "last index" operator, not a comment
                                                        while (true) {
                                                            c = read_char();
                                                            if (c == EOF || c == 0 || c == '\n' || c == '\r') {
                                                                break;
                                                            }
                                                        }
                                                        if (c != EOF && c != 0) {
                                                            c = read_char();
                                                        }
                                                        continue;
                                                    } else if (c == '(') {
                                                        paren_depth++;
                                                    } else if (c == ')') {
                                                        if (paren_depth == 0) {
                                                            break;
                                                        }
                                                        paren_depth--;
                                                    } else if (c == '{') {
                                                        brace_depth++;
                                                    } else if (c == '}') {
                                                        if (brace_depth > 0) {
                                                            brace_depth--;
                                                        }
                                                    } else if (c == '[') {
                                                        bracket_depth++;
                                                    } else if (c == ']') {
                                                        if (bracket_depth > 0) {
                                                            bracket_depth--;
                                                        }
                                                    } else if (paren_depth == 0 && brace_depth == 0 && bracket_depth == 0) {
                                                        if (c == '?') {
                                                            saw_top_qmark = true;
                                                        } else if (c == ',') {
                                                            saw_comma = true;
                                                            break;
                                                        } else if (c == ':') {
                                                            int nextc = read_char();
                                                            if (nextc != ':' && !saw_top_qmark) {
                                                                saw_colon = true;
                                                                break;
                                                            }
                                                        }
                                                    }
                                                    if (c != ' ' && c != '\t' && c != '\r' && c != '\n') {
                                                        prev_nonspace = c;
                                                    }
                                                    c = read_char();
                                                }

                                                if (saw_colon && !saw_comma) {
                                                    is_hash_literal = true;
                                                }

                                                unread_buf();
                                            }
                                            if (is_hash_literal) {
                                                return HASH_PAREN_OPEN;
                                            }
#endif
                                            return yytext[0];
                                        }
\{                                      {
                                            endDocCommentBlock();
#ifdef AST_SCANNER
                                            brace_depth++;
#endif
                                            return yytext[0];
                                        }
\}                                      {
                                            endDocCommentBlock();
#ifdef AST_SCANNER
                                            if (brace_depth > 0) {
                                                brace_depth--;
                                            }
                                            if (!typed_hash_depths.empty()
                                                && brace_depth < typed_hash_depths.back()) {
                                                // Close the current typed hash depth when leaving its braces.
                                                typed_hash_depths.pop_back();
                                            }
#endif
                                            return yytext[0];
                                        }
{WSNL}+                                 /* ignore whitespace */
.                                       { endDocCommentBlock(); return yytext[0]; }
