<p_if>{
    [^\n\r]+$                           {
                                            const char* trimmed = trim_inplace(yytext);
                                            if (trimmed)
                                                yylval->parseopt = new ASTStringParseOption(APOK_IF, trimmed);
                                            cond_push();
                                            if (ast_conditional_eval && trimmed) {
                                                bool result = false;
                                                if (ast_evaluate_condition(trimmed, result)) {
                                                    if (result) {
                                                        BEGIN(INITIAL);
                                                    } else {
                                                        cond_set_skip_depth();
                                                        BEGIN(p_skip_to_endif_or_else);
                                                    }
                                                } else {
                                                    cond_set_skip_depth();
                                                    BEGIN(p_skip_to_endif);
