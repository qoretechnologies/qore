#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <string>
#include <utility>
#include <vector>

#include "AstParseErrorLog.h"
#include "ast/AST.h"

#define YYINITDEPTH 300
//#define YYDEBUG 1

#define YYLTYPE ASTParseLocation

#define YYLLOC_DEFAULT(Current, Rhs, N)                            \
    do                                                             \
        if (N) {                                                   \
            (Current).firstLine    = YYRHSLOC(Rhs, 1).firstLine;   \
            (Current).firstCol     = YYRHSLOC(Rhs, 1).firstCol;    \
            (Current).lastLine     = YYRHSLOC(Rhs, N).lastLine;    \
            (Current).lastCol      = YYRHSLOC(Rhs, N).lastCol;     \
        }                                                          \
        else {                                                     \
            (Current).firstLine = (Current).lastLine =             \
                YYRHSLOC(Rhs, 0).lastLine;                         \
            (Current).firstCol = (Current).lastCol =               \
                YYRHSLOC(Rhs, 0).lastCol;                          \
        }                                                          \
    while (0)


// Needed for the lex-param and parse-param Bison options.
typedef void* yyscan_t;
%}

// remove this and use the following line when bison is updated on all build environments enough to support api.pure
%pure-parser
%lex-param {yyscan_t yyscanner}
%parse-param {yyscan_t yyscanner}
%parse-param {AstParseErrorLog* errorLog}
%parse-param {ASTTree* parseTree}
%locations
// remove this and use the following line when bison is updated on all build environments enough to support parse.error verbose
%error-verbose

// ======== PARSER CONFLICTS - INTENTIONAL BY DESIGN ========
// This grammar has 877 shift/reduce and 933 reduce/reduce conflicts.
//
// WHY: Unlike the main Qore parser (lib/parser.ypp) which handles parse directives
// at the scanner level, this AST parser returns them as tokens (PARSE_OPTION_FULL,
// PARSE_OPTION_BEGIN/END) so their locations can be tracked for IDE features.
//
// This creates inherent ambiguity because parse_option rules appear in multiple
// forms throughout the grammar:
//   1. As standalone elements: `top_level_command: parse_option`
//   2. As prefixes: `top_level_command: parse_option top_level_command`
//   3. Interstitially: `hash ',' parse_option hash_element`
//
// When the parser sees `parse_option X`, it cannot decide at lookahead whether
// parse_option is standalone (reduce) or part of a larger construct (shift).
//
// CORRECTNESS: Bison's default conflict resolution (prefer shift for S/R, prefer
// earlier rule for R/R) produces correct behavior, verified by the test suite.
// Shift preference means parse_option attaches to following constructs, which is
// the intuitive interpretation.
//
// WARNINGS: Conflict warnings are suppressed via CMakeLists.txt COMPILE_FLAGS
// (-Wno-conflicts-sr -Wno-conflicts-rr). If you modify this grammar and need to
// check for NEW conflicts, temporarily remove those flags and rebuild.
//
// EXPECTED COUNTS (as of 2026-01-12):
//   Shift/Reduce:  877
//   Reduce/Reduce: 933
// ===========================================================

%union {
    bool b;
    int i4;
    unsigned int ui4;
    int64_t integer;
    double decimal;
    std::string* String;
    char* string;
    ASTDeclaration* astdecl;
    ASTNode* astnode;
    std::vector<ASTCallExpression*>* bclist;
    ASTCallExpression* callexpr;
    ASTCaseExpression* caseexpr;
    ASTClassDeclaration* classdecl;
    ASTContextModExpression* cmodexpr;
    std::vector<ASTContextModExpression*>* cmodlist;
    ASTConstantDeclaration* constdecl;
    ASTConstrInitExpression* constrinit;
    std::vector<ASTDeclaration*>* decllist;
    ASTExpression* expression;
    std::vector<ASTExpression*>* exprlist;
    ASTFunctionDeclaration* funcdecl;
    ASTHashExpression* hash;
    ASTHashDeclaration* hashdecl;
    ASTHashdeclHashExpression* hashdeclhash;
    ASTEnumDeclaration* enumdecl;
    ASTEnumMemberDeclaration* enummember;
    std::vector<ASTEnumMemberDeclaration*>* enummemberlist;
    ASTTypedefDeclaration* typedefdecl;
    ASTHashElementExpression* hashelem;
    ASTHashMemberDeclaration* hashmember;
    std::vector<ASTHashMemberDeclaration*>* hashmemberlist;
    ASTName* astname;
    ASTListExpression* list;
    ASTMemberGroupDeclaration* membergroup;
    ASTNameExpression* nameexpr;
    ASTNamespaceDeclaration* nsdecl;
    ASTParseOption* parseopt;
    ASTRegexExpression* regex;
    ASTRegexSubstExpression* regexsubst;
    ASTRegexTransExpression* regextrans;
    ASTStatementBlock *sblock;
    ASTSuperclassDeclaration* sclassdecl;
    std::vector<ASTSuperclassDeclaration*>* sclist;
    ASTStatement* statement;
    ASTSwitchBodyExpression* switchexpr;
}

%{

#define YY_LEX_PARAMETERS YYSTYPE *lvalp, YYLTYPE *loc, yyscan_t yyscanner

int yylex(YY_LEX_PARAMETERS);

void yyerror(YYLTYPE *loc, yyscan_t scanner, AstParseErrorLog* errorLog, ASTTree* parseTree, const char* str) {
    errorLog->reportError(*loc, str);
}

// Defined in ast_scanner.lpp - takes ownership of pending doc comment
extern std::string* takePendingDocComment();
// Defined in ast_scanner.lpp - takes ownership of claimed class doc comment
extern std::string* takeClassDocComment();
// Defined in ast_scanner.lpp - takes ownership of claimed hashdecl doc comment
extern std::string* takeHashdeclDocComment();

// Defined in ast_scanner.lpp - takes ownership of claimed namespace doc comment
extern std::string* takeNamespaceDocComment();
// Defined in ast_scanner.lpp - takes ownership of claimed sub doc comment
extern std::string* takeSubDocComment();

// Helper macro to attach pending doc comment to a declaration
#define ATTACH_DOC_COMMENT(decl) \
    do { \
        std::string* doc = takePendingDocComment(); \
        if (doc && decl) { \
            (decl)->setDocComment(doc); \
        } \
    } while (0)

// Helper macro to attach class doc comment (claimed when scanner saw 'class' keyword)
#define ATTACH_CLASS_DOC_COMMENT(decl) \
    do { \
        std::string* doc = takeClassDocComment(); \
        if (doc && decl) { \
            (decl)->setDocComment(doc); \
        } \
    } while (0)

// Helper macro to attach hashdecl doc comment (claimed when scanner saw 'hashdecl' keyword)
#define ATTACH_HASHDECL_DOC_COMMENT(decl) \
    do { \
        std::string* doc = takeHashdeclDocComment(); \
        if (doc && decl) { \
            (decl)->setDocComment(doc); \
        } \
    } while (0)

// Helper macro to attach namespace doc comment (claimed when scanner saw 'namespace' keyword)
#define ATTACH_NAMESPACE_DOC_COMMENT(decl) \
    do { \
        std::string* doc = takeNamespaceDocComment(); \
        if (doc && decl) { \
            (decl)->setDocComment(doc); \
        } \
    } while (0)

// Helper macro to attach sub doc comment (claimed when scanner saw 'sub' keyword)
#define ATTACH_SUB_DOC_COMMENT(decl) \
    do { \
        std::string* doc = takeSubDocComment(); \
        if (doc && decl) { \
            (decl)->setDocComment(doc); \
        } \
    } while (0)

%}

