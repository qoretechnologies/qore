#include <memory>
#include <string>
#include <vector>

#include "qore/Qore.h"

#include "AstTreeHolder.h"
#include "CSTSearcher.h"
#include "QC_AstTree.h"

//! AstTreeSearcher class — provides symbol search on tree-sitter CST.
/** Provides methods for finding symbols, references, scope symbols, hover info,
    and symbol info in a parsed Qore AST tree.

    @since %Qore 0.8.13
 */
qclass AstTreeSearcher [arg=AbstractPrivateData* apd; ns=astparser; flags=final];

//! Creates the AstTreeSearcher.
/**
 */
AstTreeSearcher::constructor() {
    self->setPrivate(CID_ASTTREESEARCHER, new AbstractPrivateData);
}

//! Hover info.
/**
    @param tree AST tree structure
    @param kind symbol kind
    @param line on what line lies the symbol we want to get info about (0-indexed)
    @param col on what column lies the symbol we want to get info about (0-indexed)

    @return hash with hover info containing "description" key, or NOTHING if not found
 */
*hash<auto> AstTreeSearcher::hoverInfo(astparser::AstTree[AstTreeHolder] tree, int kind, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::string desc = CSTSearcher::buildHoverInfo(
        result, static_cast<ASTSymbolKind>(kind),
        static_cast<uint32_t>(line), static_cast<uint32_t>(col));

    if (desc.empty()) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> rv(new QoreHashNode, xsink);
    if (*xsink) {
        return QoreValue();
    }
    rv->setKeyValue("description", new QoreStringNode(desc), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return rv.release();
}

//! Find symbol info.
/**
    @param tree AST tree structure
    @param line on what line lies the symbol we want to get info about (0-indexed)
    @param col on what column lies the symbol we want to get info about (0-indexed)

    @return hash with symbol info (kind, usage, name, range) or NOTHING if not found
 */
*hash<auto> AstTreeSearcher::findSymbolInfo(astparser::AstTree[AstTreeHolder] tree, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    CSTSymbolInfo si = CSTSearcher::findSymbolInfo(
        result, static_cast<uint32_t>(line), static_cast<uint32_t>(col));

    // Return NOTHING if no useful result
    if (si.kind == ASYK_None && si.usage == ASUK_None) {
        return QoreValue();
    }
    if (si.startLine == 0 && si.startCol == 0 && si.endLine == 0 && si.endCol == 0
        && si.name.empty()) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
    ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
    ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode, xsink);
    if (*xsink) {
        return QoreValue();
    }

    // tree-sitter coordinates are already 0-indexed — no conversion needed
    startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
    startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
    if (*xsink) {
        return QoreValue();
    }
    endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
    endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
    if (*xsink) {
        return QoreValue();
    }
    range->setKeyValue("start", startHash.release(), xsink);
    range->setKeyValue("end", endHash.release(), xsink);
    if (*xsink) {
        return QoreValue();
    }

    rv->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
    rv->setKeyValue("usage", static_cast<int64>(si.usage), xsink);
    rv->setKeyValue("name", new QoreStringNode(si.name), xsink);
    rv->setKeyValue("range", range.release(), xsink);
    if (*xsink) {
        return QoreValue();
    }

    return rv.release();
}

//! Find symbol references
/**
    @param tree AST tree structure
    @param uri document's uri
    @param line line on which the symbol lies (0-indexed)
    @param col column at which the symbol lies (0-indexed)
    @param includeDecl whether to include a reference at the passed position

    @return list of reference locations, or NOTHING if none found
 */
*list<auto> AstTreeSearcher::findReferences(astparser::AstTree[AstTreeHolder] tree, string uri, int line, int col, bool includeDecl) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::unique_ptr<std::vector<TSNode>> vec(
        CSTSearcher::findReferences(result,
            static_cast<uint32_t>(line), static_cast<uint32_t>(col), includeDecl));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        TSNode node = vec->at(i);
        QoreHashNode* location = CSTSearcher::makeLocation(
            node, std::string(uri->c_str()), xsink);
        if (*xsink) {
            return QoreValue();
        }
        if (location) {
            lst->push(location, xsink);
            if (*xsink) {
                return QoreValue();
            }
        }
    }

    return lst.release();
}

//! Resolve the definition location for the symbol at position.
/**
    @param tree AST tree structure
    @param uri document's URI
    @param line 0-indexed line
    @param col 0-indexed column

    @return list of location hashes {uri, range}, or NOTHING if not found

    @since %Qore 2.2
 */
*list<auto> AstTreeSearcher::resolveDefinition(astparser::AstTree[AstTreeHolder] tree, string uri, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::unique_ptr<std::vector<TSNode>> vec(
        CSTSearcher::resolveDefinition(result,
            static_cast<uint32_t>(line), static_cast<uint32_t>(col)));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        TSNode node = vec->at(i);
        QoreHashNode* location = CSTSearcher::makeLocation(
            node, std::string(uri->c_str()), xsink);
        if (*xsink) {
            return QoreValue();
        }
        if (location) {
            lst->push(location, xsink);
            if (*xsink) {
                return QoreValue();
            }
        }
    }

    return lst.release();
}

//! Resolve definition across multiple documents.
/**
    @param tree AST tree structure for the current document
    @param uri document's URI
    @param line 0-indexed line
    @param col 0-indexed column
    @param otherDocs hash mapping URI (string) to AstTree objects for other open documents

    @return list of location hashes {uri, range}, or NOTHING if not found

    @since %Qore 2.3
 */
*list<auto> AstTreeSearcher::resolveDefinitionCrossDoc(astparser::AstTree[AstTreeHolder] tree, string uri, int line, int col, *hash<auto> otherDocs) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    // RAII guard for referenced AstTreeHolder pointers
    struct HolderGuard {
        std::vector<AstTreeHolder*> holders;
        ExceptionSink* xsink;

        HolderGuard(ExceptionSink* xs) : xsink(xs) {}
        ~HolderGuard() {
            for (auto* h : holders) {
                h->deref(xsink);
            }
        }

        // non-copyable
        HolderGuard(const HolderGuard&) = delete;
        HolderGuard& operator=(const HolderGuard&) = delete;
    };

    HolderGuard guard(xsink);

    // Build vector<DocumentRef> from the otherDocs hash
    std::vector<DocumentRef> docRefs;

    if (otherDocs && otherDocs->size()) {
        ConstHashIterator hi(otherDocs);
        while (hi.next()) {
            QoreValue val = hi.get();
            if (val.getType() != NT_OBJECT) {
                continue;
            }
            QoreObject* obj = val.get<QoreObject>();
            AstTreeHolder* ath = reinterpret_cast<AstTreeHolder*>(
                obj->getReferencedPrivateData(CID_ASTTREE, xsink));
            if (*xsink) {
                return QoreValue();
            }
            if (!ath) {
                continue;
            }
            guard.holders.push_back(ath);
            AstParseResult* otherResult = ath->get();
            if (otherResult) {
                std::string docUri(hi.getKey());
                docRefs.push_back({otherResult, docUri});
            }
        }
    }

    std::string currentUri(uri->c_str());
    std::unique_ptr<std::vector<DefinitionResult>> vec(
        CSTSearcher::resolveDefinitionCrossDoc(result,
            static_cast<uint32_t>(line), static_cast<uint32_t>(col), docRefs));

    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const DefinitionResult& dr = vec->at(i);
        // Use the result's URI if set, otherwise use current document URI
        std::string nodeUri = dr.uri.empty() ? currentUri : dr.uri;
        QoreHashNode* location = CSTSearcher::makeLocation(dr.node, nodeUri, xsink);
        if (*xsink) {
            return QoreValue();
        }
        if (location) {
            lst->push(location, xsink);
            if (*xsink) {
                return QoreValue();
            }
        }
    }

    return lst.release();
}

//! Find all symbols in a document.
/**
    @param tree AST tree structure
    @param uri document's uri
    @param fixSymbols whether to fix symbol infos (prefix with namespace/class scope)
    @param bareNames whether to return bare symbol names (without namespace and class prefixes)

    @return list of symbols, or NOTHING if none found
 */
*list<auto> AstTreeSearcher::findSymbols(astparser::AstTree[AstTreeHolder] tree, string uri, bool fixSymbols = True, bool bareNames = False) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::unique_ptr<std::vector<CSTSymbolInfo>> vec(
        CSTSearcher::collectSymbols(result, fixSymbols, bareNames));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const CSTSymbolInfo& si = vec->at(i);
        ReferenceHolder<QoreHashNode> symbolInfo(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        // Build range
        ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> location(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
        startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
        endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        range->setKeyValue("start", startHash.release(), xsink);
        range->setKeyValue("end", endHash.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        location->setKeyValue("uri", uri->stringRefSelf(), xsink);
        location->setKeyValue("range", range.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }

        symbolInfo->setKeyValue("name", new QoreStringNode(si.name), xsink);
        symbolInfo->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
        symbolInfo->setKeyValue("location", location.release(), xsink);
        if (!si.docComment.empty()) {
            symbolInfo->setKeyValue("docComment", new QoreStringNode(si.docComment), xsink);
        }
        if (*xsink) {
            return QoreValue();
        }
        lst->push(symbolInfo.release(), xsink);
    }

    return lst.release();
}

//! Find matching symbols in a document.
/**
    @param tree AST tree structure
    @param uri document's uri
    @param query search query
    @param exactMatch whether to only find exact matches
    @param fixSymbols whether to fix symbol infos
    @param bareNames whether to return bare symbol names (without namespace and class prefixes)

    @return list of symbols, or NOTHING if none found
 */
*list<auto> AstTreeSearcher::findMatchingSymbols(astparser::AstTree[AstTreeHolder] tree, string uri, string query, bool exactMatch = False, bool fixSymbols = True, bool bareNames = False) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::string queryStr(query->c_str());
    std::unique_ptr<std::vector<CSTSymbolInfo>> vec(
        CSTSearcher::findMatchingSymbols(result, queryStr, exactMatch, fixSymbols, bareNames));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const CSTSymbolInfo& si = vec->at(i);
        ReferenceHolder<QoreHashNode> symbolInfo(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> location(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
        startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
        endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        range->setKeyValue("start", startHash.release(), xsink);
        range->setKeyValue("end", endHash.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        location->setKeyValue("uri", uri->stringRefSelf(), xsink);
        location->setKeyValue("range", range.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        symbolInfo->setKeyValue("name", new QoreStringNode(si.name), xsink);
        symbolInfo->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
        symbolInfo->setKeyValue("location", location.release(), xsink);
        if (!si.docComment.empty()) {
            symbolInfo->setKeyValue("docComment", new QoreStringNode(si.docComment), xsink);
        }
        if (*xsink) {
            return QoreValue();
        }
        lst->push(symbolInfo.release(), xsink);
    }

    return lst.release();
}

//! Find symbols accessible from a specific scope position.
/**
    @param tree AST tree structure
    @param uri document's uri
    @param line on what line lies the position (0-indexed)
    @param col on what column lies the position (0-indexed)

    @return list of symbols with scope level information, or NOTHING if none found

    Scope levels:
    - 0: Local variables and parameters in the current function/method
    - 1: Class members (when inside a class method)
    - 2: Namespace-level symbols
    - 3+: Outer namespaces

    @since %Qore 2.2
 */
*list<auto> AstTreeSearcher::findScopeSymbols(astparser::AstTree[AstTreeHolder] tree, string uri, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    // tree-sitter uses 0-indexed, same as our API — no conversion needed
    std::unique_ptr<std::vector<CSTScopeSymbolInfo>> vec(
        CSTSearcher::findScopeSymbols(result,
            static_cast<uint32_t>(line), static_cast<uint32_t>(col)));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const CSTScopeSymbolInfo& ssi = vec->at(i);
        const CSTSymbolInfo& si = ssi.symbol;

        ReferenceHolder<QoreHashNode> symbolInfo(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> location(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
        startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
        endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        range->setKeyValue("start", startHash.release(), xsink);
        range->setKeyValue("end", endHash.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        location->setKeyValue("uri", uri->stringRefSelf(), xsink);
        location->setKeyValue("range", range.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }

        symbolInfo->setKeyValue("name", new QoreStringNode(si.name), xsink);
        symbolInfo->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
        symbolInfo->setKeyValue("location", location.release(), xsink);
        symbolInfo->setKeyValue("scope_level", static_cast<int64>(ssi.scopeLevel), xsink);
        if (!si.docComment.empty()) {
            symbolInfo->setKeyValue("docComment", new QoreStringNode(si.docComment), xsink);
        }
        if (*xsink) {
            return QoreValue();
        }
        lst->push(symbolInfo.release(), xsink);
    }

    return lst.release();
}

//! Find scope symbols with detailed metadata.
/**
    @param tree AST tree structure
    @param uri document's uri
    @param line on what line lies the position (0-indexed)
    @param col on what column lies the position (0-indexed)

    @return list of detailed symbols with returnType, typeName, access, isStatic, params, or NOTHING

    @since %Qore 2.2
 */
*list<auto> AstTreeSearcher::findScopeSymbolsDetailed(astparser::AstTree[AstTreeHolder] tree, string uri, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::unique_ptr<std::vector<CSTSymbolDetail>> vec(
        CSTSearcher::findScopeSymbolsDetailed(result,
            static_cast<uint32_t>(line), static_cast<uint32_t>(col)));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const CSTSymbolDetail& sd = vec->at(i);
        const CSTSymbolInfo& si = sd.symbol;

        ReferenceHolder<QoreHashNode> symbolInfo(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> location(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
        startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
        endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        range->setKeyValue("start", startHash.release(), xsink);
        range->setKeyValue("end", endHash.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        location->setKeyValue("uri", uri->stringRefSelf(), xsink);
        location->setKeyValue("range", range.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }

        symbolInfo->setKeyValue("name", new QoreStringNode(si.name), xsink);
        symbolInfo->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
        symbolInfo->setKeyValue("location", location.release(), xsink);
        symbolInfo->setKeyValue("scope_level", static_cast<int64>(sd.scopeLevel), xsink);
        if (!si.docComment.empty()) {
            symbolInfo->setKeyValue("docComment", new QoreStringNode(si.docComment), xsink);
        }
        if (!sd.returnType.empty()) {
            symbolInfo->setKeyValue("returnType", new QoreStringNode(sd.returnType), xsink);
        }
        if (!sd.typeName.empty()) {
            symbolInfo->setKeyValue("typeName", new QoreStringNode(sd.typeName), xsink);
        }
        if (!sd.access.empty()) {
            symbolInfo->setKeyValue("access", new QoreStringNode(sd.access), xsink);
        }
        symbolInfo->setKeyValue("isStatic", sd.isStatic, xsink);
        if (*xsink) {
            return QoreValue();
        }

        // Add params list
        if (!sd.params.empty()) {
            ReferenceHolder<QoreListNode> paramList(new QoreListNode, xsink);
            for (const auto& p : sd.params) {
                ReferenceHolder<QoreHashNode> paramHash(new QoreHashNode, xsink);
                if (*xsink) {
                    return QoreValue();
                }
                paramHash->setKeyValue("name", new QoreStringNode(p.name), xsink);
                if (!p.typeName.empty()) {
                    paramHash->setKeyValue("typeName", new QoreStringNode(p.typeName), xsink);
                }
                if (!p.defaultVal.empty()) {
                    paramHash->setKeyValue("defaultVal", new QoreStringNode(p.defaultVal), xsink);
                }
                if (*xsink) {
                    return QoreValue();
                }
                paramList->push(paramHash.release(), xsink);
            }
            symbolInfo->setKeyValue("params", paramList.release(), xsink);
        }
        if (*xsink) {
            return QoreValue();
        }
        lst->push(symbolInfo.release(), xsink);
    }

    return lst.release();
}

//! Resolve the type of a symbol at position.
/**
    @param tree AST tree structure
    @param line on what line lies the position (0-indexed)
    @param col on what column lies the position (0-indexed)

    @return type name string, or NOTHING if not found

    @since %Qore 2.2
 */
*string AstTreeSearcher::getSymbolType(astparser::AstTree[AstTreeHolder] tree, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::string typeName = CSTSearcher::getSymbolType(
        result, static_cast<uint32_t>(line), static_cast<uint32_t>(col));

    if (typeName.empty()) {
        return QoreValue();
    }

    return new QoreStringNode(typeName);
}

//! Find members of a named type.
/**
    @param tree AST tree structure
    @param uri document's uri
    @param typeName name of the type to find members for
    @param includeInherited whether to include inherited members (default True)

    @return list of detailed member symbols, or NOTHING if not found

    @since %Qore 2.2
 */
*list<auto> AstTreeSearcher::findTypeMembers(astparser::AstTree[AstTreeHolder] tree, string uri, string typeName, bool includeInherited = True) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::string typeStr(typeName->c_str());
    std::unique_ptr<std::vector<CSTSymbolDetail>> vec(
        CSTSearcher::findTypeMembers(result, typeStr, includeInherited));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const CSTSymbolDetail& sd = vec->at(i);
        const CSTSymbolInfo& si = sd.symbol;

        ReferenceHolder<QoreHashNode> symbolInfo(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> location(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
        startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
        endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        range->setKeyValue("start", startHash.release(), xsink);
        range->setKeyValue("end", endHash.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        location->setKeyValue("uri", uri->stringRefSelf(), xsink);
        location->setKeyValue("range", range.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }

        symbolInfo->setKeyValue("name", new QoreStringNode(si.name), xsink);
        symbolInfo->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
        symbolInfo->setKeyValue("location", location.release(), xsink);
        if (!si.docComment.empty()) {
            symbolInfo->setKeyValue("docComment", new QoreStringNode(si.docComment), xsink);
        }
        if (!sd.returnType.empty()) {
            symbolInfo->setKeyValue("returnType", new QoreStringNode(sd.returnType), xsink);
        }
        if (!sd.typeName.empty()) {
            symbolInfo->setKeyValue("typeName", new QoreStringNode(sd.typeName), xsink);
        }
        if (!sd.access.empty()) {
            symbolInfo->setKeyValue("access", new QoreStringNode(sd.access), xsink);
        }
        symbolInfo->setKeyValue("isStatic", sd.isStatic, xsink);
        if (*xsink) {
            return QoreValue();
        }

        if (!sd.params.empty()) {
            ReferenceHolder<QoreListNode> paramList(new QoreListNode, xsink);
            for (const auto& p : sd.params) {
                ReferenceHolder<QoreHashNode> paramHash(new QoreHashNode, xsink);
                if (*xsink) {
                    return QoreValue();
                }
                paramHash->setKeyValue("name", new QoreStringNode(p.name), xsink);
                if (!p.typeName.empty()) {
                    paramHash->setKeyValue("typeName", new QoreStringNode(p.typeName), xsink);
                }
                if (!p.defaultVal.empty()) {
                    paramHash->setKeyValue("defaultVal", new QoreStringNode(p.defaultVal), xsink);
                }
                if (*xsink) {
                    return QoreValue();
                }
                paramList->push(paramHash.release(), xsink);
            }
            symbolInfo->setKeyValue("params", paramList.release(), xsink);
        }
        if (*xsink) {
            return QoreValue();
        }
        lst->push(symbolInfo.release(), xsink);
    }

    return lst.release();
}
