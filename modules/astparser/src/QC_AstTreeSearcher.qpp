#include <memory>
#include <string>
#include <vector>

#include "qore/Qore.h"

#include "AstTreeHolder.h"
#include "CSTSearcher.h"
#include "QC_AstTree.h"

//! AstTreeSearcher class — provides symbol search on tree-sitter CST.
/** Provides methods for finding symbols, references, scope symbols, hover info,
    and symbol info in a parsed Qore AST tree.

    @since %Qore 0.8.13
 */
qclass AstTreeSearcher [arg=AbstractPrivateData* apd; ns=astparser; flags=final];

//! Creates the AstTreeSearcher.
/**
 */
AstTreeSearcher::constructor() {
    self->setPrivate(CID_ASTTREESEARCHER, new AbstractPrivateData);
}

//! Hover info.
/**
    @param tree AST tree structure
    @param kind symbol kind
    @param line on what line lies the symbol we want to get info about (0-indexed)
    @param col on what column lies the symbol we want to get info about (0-indexed)

    @return hash with hover info containing "description" key, or NOTHING if not found
 */
*hash AstTreeSearcher::hoverInfo(astparser::AstTree[AstTreeHolder] tree, int kind, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::string desc = CSTSearcher::buildHoverInfo(
        result, static_cast<ASTSymbolKind>(kind),
        static_cast<uint32_t>(line), static_cast<uint32_t>(col));

    if (desc.empty()) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> rv(new QoreHashNode, xsink);
    if (*xsink) {
        return QoreValue();
    }
    rv->setKeyValue("description", new QoreStringNode(desc), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return rv.release();
}

//! Find symbol info.
/**
    @param tree AST tree structure
    @param line on what line lies the symbol we want to get info about (0-indexed)
    @param col on what column lies the symbol we want to get info about (0-indexed)

    @return hash with symbol info (kind, usage, name, range) or NOTHING if not found
 */
*hash AstTreeSearcher::findSymbolInfo(astparser::AstTree[AstTreeHolder] tree, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    CSTSymbolInfo si = CSTSearcher::findSymbolInfo(
        result, static_cast<uint32_t>(line), static_cast<uint32_t>(col));

    // Return NOTHING if no useful result
    if (si.kind == ASYK_None && si.usage == ASUK_None) {
        return QoreValue();
    }
    if (si.startLine == 0 && si.startCol == 0 && si.endLine == 0 && si.endCol == 0
        && si.name.empty()) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
    ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
    ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode, xsink);
    if (*xsink) {
        return QoreValue();
    }

    // tree-sitter coordinates are already 0-indexed — no conversion needed
    startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
    startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
    if (*xsink) {
        return QoreValue();
    }
    endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
    endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
    if (*xsink) {
        return QoreValue();
    }
    range->setKeyValue("start", startHash.release(), xsink);
    range->setKeyValue("end", endHash.release(), xsink);
    if (*xsink) {
        return QoreValue();
    }

    rv->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
    rv->setKeyValue("usage", static_cast<int64>(si.usage), xsink);
    rv->setKeyValue("name", new QoreStringNode(si.name), xsink);
    rv->setKeyValue("range", range.release(), xsink);
    if (*xsink) {
        return QoreValue();
    }

    return rv.release();
}

//! Find symbol references
/**
    @param tree AST tree structure
    @param uri document's uri
    @param line line on which the symbol lies (0-indexed)
    @param col column at which the symbol lies (0-indexed)
    @param includeDecl whether to include a reference at the passed position

    @return list of reference locations, or NOTHING if none found
 */
*list AstTreeSearcher::findReferences(astparser::AstTree[AstTreeHolder] tree, string uri, int line, int col, bool includeDecl) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::unique_ptr<std::vector<TSNode>> vec(
        CSTSearcher::findReferences(result,
            static_cast<uint32_t>(line), static_cast<uint32_t>(col), includeDecl));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        TSNode node = vec->at(i);
        QoreHashNode* location = CSTSearcher::makeLocation(
            node, std::string(uri->c_str()), xsink);
        if (*xsink) {
            return QoreValue();
        }
        if (location) {
            lst->push(location, xsink);
            if (*xsink) {
                return QoreValue();
            }
        }
    }

    return lst.release();
}

//! Find all symbols in a document.
/**
    @param tree AST tree structure
    @param uri document's uri
    @param fixSymbols whether to fix symbol infos (prefix with namespace/class scope)
    @param bareNames whether to return bare symbol names (without namespace and class prefixes)

    @return list of symbols, or NOTHING if none found
 */
*list AstTreeSearcher::findSymbols(astparser::AstTree[AstTreeHolder] tree, string uri, bool fixSymbols = True, bool bareNames = False) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::unique_ptr<std::vector<CSTSymbolInfo>> vec(
        CSTSearcher::collectSymbols(result, fixSymbols, bareNames));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const CSTSymbolInfo& si = vec->at(i);
        ReferenceHolder<QoreHashNode> symbolInfo(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        // Build range
        ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> location(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
        startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
        endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        range->setKeyValue("start", startHash.release(), xsink);
        range->setKeyValue("end", endHash.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        location->setKeyValue("uri", uri->stringRefSelf(), xsink);
        location->setKeyValue("range", range.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }

        symbolInfo->setKeyValue("name", new QoreStringNode(si.name), xsink);
        symbolInfo->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
        symbolInfo->setKeyValue("location", location.release(), xsink);
        if (!si.docComment.empty()) {
            symbolInfo->setKeyValue("docComment", new QoreStringNode(si.docComment), xsink);
        }
        if (*xsink) {
            return QoreValue();
        }
        lst->push(symbolInfo.release(), xsink);
    }

    return lst.release();
}

//! Find matching symbols in a document.
/**
    @param tree AST tree structure
    @param uri document's uri
    @param query search query
    @param exactMatch whether to only find exact matches
    @param fixSymbols whether to fix symbol infos
    @param bareNames whether to return bare symbol names (without namespace and class prefixes)

    @return list of symbols, or NOTHING if none found
 */
*list AstTreeSearcher::findMatchingSymbols(astparser::AstTree[AstTreeHolder] tree, string uri, string query, bool exactMatch = False, bool fixSymbols = True, bool bareNames = False) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    std::string queryStr(query->c_str());
    std::unique_ptr<std::vector<CSTSymbolInfo>> vec(
        CSTSearcher::findMatchingSymbols(result, queryStr, exactMatch, fixSymbols, bareNames));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const CSTSymbolInfo& si = vec->at(i);
        ReferenceHolder<QoreHashNode> symbolInfo(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> location(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
        startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
        endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        range->setKeyValue("start", startHash.release(), xsink);
        range->setKeyValue("end", endHash.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        location->setKeyValue("uri", uri->stringRefSelf(), xsink);
        location->setKeyValue("range", range.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        symbolInfo->setKeyValue("name", new QoreStringNode(si.name), xsink);
        symbolInfo->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
        symbolInfo->setKeyValue("location", location.release(), xsink);
        if (!si.docComment.empty()) {
            symbolInfo->setKeyValue("docComment", new QoreStringNode(si.docComment), xsink);
        }
        if (*xsink) {
            return QoreValue();
        }
        lst->push(symbolInfo.release(), xsink);
    }

    return lst.release();
}

//! Find symbols accessible from a specific scope position.
/**
    @param tree AST tree structure
    @param uri document's uri
    @param line on what line lies the position (0-indexed)
    @param col on what column lies the position (0-indexed)

    @return list of symbols with scope level information, or NOTHING if none found

    Scope levels:
    - 0: Local variables and parameters in the current function/method
    - 1: Class members (when inside a class method)
    - 2: Namespace-level symbols
    - 3+: Outer namespaces

    @since %Qore 2.2
 */
*list AstTreeSearcher::findScopeSymbols(astparser::AstTree[AstTreeHolder] tree, string uri, int line, int col) {
    ReferenceHolder<AstTreeHolder> holder(tree, xsink);

    AstParseResult* result = tree->get();
    if (!result) {
        return QoreValue();
    }

    // tree-sitter uses 0-indexed, same as our API — no conversion needed
    std::unique_ptr<std::vector<CSTScopeSymbolInfo>> vec(
        CSTSearcher::findScopeSymbols(result,
            static_cast<uint32_t>(line), static_cast<uint32_t>(col)));
    if (!vec) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> lst(new QoreListNode, xsink);
    for (size_t i = 0, count = vec->size(); i < count; i++) {
        const CSTScopeSymbolInfo& ssi = vec->at(i);
        const CSTSymbolInfo& si = ssi.symbol;

        ReferenceHolder<QoreHashNode> symbolInfo(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        ReferenceHolder<QoreHashNode> startHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> endHash(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> range(new QoreHashNode, xsink);
        ReferenceHolder<QoreHashNode> location(new QoreHashNode, xsink);
        if (*xsink) {
            return QoreValue();
        }

        startHash->setKeyValue("line", static_cast<int64>(si.startLine), xsink);
        startHash->setKeyValue("character", static_cast<int64>(si.startCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        endHash->setKeyValue("line", static_cast<int64>(si.endLine), xsink);
        endHash->setKeyValue("character", static_cast<int64>(si.endCol), xsink);
        if (*xsink) {
            return QoreValue();
        }
        range->setKeyValue("start", startHash.release(), xsink);
        range->setKeyValue("end", endHash.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
        location->setKeyValue("uri", uri->stringRefSelf(), xsink);
        location->setKeyValue("range", range.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }

        symbolInfo->setKeyValue("name", new QoreStringNode(si.name), xsink);
        symbolInfo->setKeyValue("kind", static_cast<int64>(si.kind), xsink);
        symbolInfo->setKeyValue("location", location.release(), xsink);
        symbolInfo->setKeyValue("scope_level", static_cast<int64>(ssi.scopeLevel), xsink);
        if (!si.docComment.empty()) {
            symbolInfo->setKeyValue("docComment", new QoreStringNode(si.docComment), xsink);
        }
        if (*xsink) {
            return QoreValue();
        }
        lst->push(symbolInfo.release(), xsink);
    }

    return lst.release();
}
