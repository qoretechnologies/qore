#include "QC_AbstractMLClassifier.h"

//! Abstract base class for classification models that predict discrete labels (e.g. LogisticRegression, DecisionTree, RandomForest, GradientBoostedTrees, SVM, NaiveBayes, KNN).
/** This class cannot be instantiated directly; it serves as a typed parent for
    concrete ML model subclasses. See @ref AbstractMLModel for the full hierarchy.
*/
qclass AbstractMLClassifier [ns=Qore::ML; arg=QoreMLModel* m; vparent=AbstractMLEstimator];

//! Throws an exception; this class is abstract and cannot be instantiated directly
/** @throw ABSTRACT-MLMODEL-ERROR the AbstractMLClassifier class is abstract; instantiate a
    concrete ML model subclass instead
*/
AbstractMLClassifier::constructor() {
    xsink->raiseException("ABSTRACT-MLMODEL-ERROR", "the AbstractMLClassifier class is abstract "
        "and cannot be instantiated directly; instantiate a concrete ML model subclass instead");
}
