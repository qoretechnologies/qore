#include "qore/Qore.h"
#include "QC_SeasonalDecomposition.h"

extern const TypedHashDecl* hashdeclSeasonalDecompositionResult;

//! The SeasonalDecomposition class implements classical seasonal decomposition
/** Decomposes a time series into trend, seasonal, and residual components using
    moving average extraction, supporting both additive and multiplicative modes.

    @par Example:
    @code{.py}
SeasonalDecomposition sd({"period": 12, "type": "additive"});
list<hash<SeasonalDecompositionResult>> results = sd.decompose(monthly_values);
    @endcode

    @since ml 1.0
*/
qclass SeasonalDecomposition [arg=QoreSeasonalDecomposition* sd; ns=Qore::ML; flags=final];

//! Creates a SeasonalDecomposition instance with the given options
/** @param options a hash with the following keys:
    - \c period (int, required): seasonal period
    - \c type (string, default "additive"): "additive" or "multiplicative"

    @throw ML-SEASONAL-DECOMPOSITION-ERROR invalid option values
*/
SeasonalDecomposition::constructor(hash<auto> options) {
    int64 period = 0;
    const char* type = "additive";

    QoreValue v = options->getKeyValue("period");
    if (v.isNullOrNothing()) {
        xsink->raiseException("ML-SEASONAL-DECOMPOSITION-ERROR",
            "required option 'period' not provided");
        return;
    }
    period = v.getAsBigInt();

    v = options->getKeyValue("type");
    if (!v.isNullOrNothing() && v.getType() == NT_STRING) {
        type = v.get<const QoreStringNode>()->c_str();
    }

    if (period < 2) {
        xsink->raiseException("ML-SEASONAL-DECOMPOSITION-ERROR",
            "period must be >= 2; got " QLLD, period);
        return;
    }

    if (strcmp(type, "additive") != 0 && strcmp(type, "multiplicative") != 0) {
        xsink->raiseException("ML-SEASONAL-DECOMPOSITION-ERROR",
            "type must be 'additive' or 'multiplicative'; got '%s'", type);
        return;
    }

    self->setPrivate(CID_SEASONALDECOMPOSITION,
        new QoreSeasonalDecomposition(static_cast<int>(period), type));
}

//! Creates a copy of the SeasonalDecomposition instance
/** @throw COPY-ERROR SeasonalDecomposition objects cannot be copied
*/
SeasonalDecomposition::copy() {
    xsink->raiseException("COPY-ERROR", "SeasonalDecomposition objects cannot be copied");
}

//! Decomposes a time series into trend, seasonal, and residual components
/** @param series a list of float values (>= 2 * period values required)
    @return a list of @ref SeasonalDecompositionResult hashes; trend and residual are
    NOTHING at the edges where the moving average cannot be computed

    @par Example:
    @code{.py}
list<hash<SeasonalDecompositionResult>> results = sd.decompose(monthly_values);
for (int i = 0; i < results.size(); ++i) {
    if (exists results[i].trend) {
        printf("i=%d trend=%.2f seasonal=%.2f residual=%.2f\n",
            i, results[i].trend, results[i].seasonal, results[i].residual);
    }
}
    @endcode

    @throw ML-SEASONAL-DECOMPOSITION-ERROR not enough data (< 2 * period values)
*/
list<hash<SeasonalDecompositionResult>> SeasonalDecomposition::decompose(list<auto> series) {
    VectorXd vec = qoreListToVector(series, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return sd->decompose(vec, xsink);
}

//! Returns the configured seasonal period
/** @return the period value
*/
int SeasonalDecomposition::getPeriod() [flags=CONSTANT] {
    return sd->getPeriod();
}

//! Returns the configured decomposition type
/** @return "additive" or "multiplicative"
*/
string SeasonalDecomposition::getType() [flags=CONSTANT] {
    return new QoreStringNode(sd->getType().c_str());
}
