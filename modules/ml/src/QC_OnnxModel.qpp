#include "qore/Qore.h"

#include "QC_OnnxModel.h"

// Extern declarations for hashdecls (defined in ml-module.cpp)
extern const TypedHashDecl* hashdeclOnnxTensorInfo;
extern const TypedHashDecl* hashdeclOnnxModelInfo;
extern const TypedHashDecl* hashdeclOnnxProviderConfig;
extern const TypedHashDecl* hashdeclOnnxSessionConfig;
extern const TypedHashDecl* hashdeclOnnxProviderDiagnostic;

//! Per-run ONNX Runtime options
/** Configures options for one ONNX Runtime inference call. Use this class when
    a deployment needs run tags, per-run logging, termination control, or
    provider-specific run configuration entries.

    @par Example:
    @code{.py}
OnnxRunOptions opts({"run_tag": "customer-scoring-batch"});
hash<auto> out = model.runBound(binding, opts);
    @endcode
*/
qclass OnnxRunOptions [arg=QoreOnnxRunOptions* options; ns=Qore::ML; flags=final];

//! Creates ONNX Runtime run options
/** @param options optional options hash

    Recognized keys are:
    - \c run_tag: string tag visible to ONNX Runtime logging and profiling
    - \c log_severity_level: integer ONNX Runtime severity threshold
    - \c log_verbosity_level: integer ONNX Runtime verbosity level
    - \c terminate: bool; when True, the options start in the terminated state
    - \c config: hash of string config entries passed to ONNX Runtime

    @throw ML-ONNX-RUN-OPTIONS-ERROR if the options hash is invalid
*/
OnnxRunOptions::constructor(*hash<auto> options) [flags=NAMED_ARGS] {
#ifdef HAVE_ONNXRUNTIME
    ReferenceHolder<QoreOnnxRunOptions> holder(new QoreOnnxRunOptions(options, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_ONNXRUNOPTIONS, holder.release());
#else
    xsink->raiseException("MISSING-FEATURE-ERROR", "the ml module was not compiled with ONNX "
        "Runtime support; check MLCapabilities.has_onnx before creating OnnxRunOptions");
#endif
}

//! Creates a copy of the OnnxRunOptions
/** @throw COPY-ERROR OnnxRunOptions objects cannot be copied
*/
OnnxRunOptions::copy() {
    xsink->raiseException("COPY-ERROR", "OnnxRunOptions objects cannot be copied");
}

//! Requests termination for runs using these options
/** The same object can be reused after calling unsetTerminate().
*/
nothing OnnxRunOptions::setTerminate() {
    options->setTerminate(xsink);
}

//! Clears a previous termination request
/** After this call, the same OnnxRunOptions object can be used for normal
    inference again.
*/
nothing OnnxRunOptions::unsetTerminate() {
    options->unsetTerminate(xsink);
}

//! Returns structured run option metadata
/** @return a hash containing the configured run tag, logging levels,
    termination state, and config entries
*/
hash<auto> OnnxRunOptions::getInfo() [flags=RET_VALUE_ONLY] {
    return options->getInfo(xsink);
}

//! Reusable ONNX Runtime I/O binding
/** Holds ONNX Runtime input and output bindings for a specific @ref OnnxModel.
    Bindings let production code reuse stable input tensors and output
    allocation decisions across many runs instead of rebuilding every
    Ort::Value for each call.

    Create instances with @ref OnnxModel::createBinding().

    @par Example:
    @code{.py}
OnnxIoBinding binding = model.createBinding();
binding.bindInputs({"X": input_tensor});
binding.bindOutputs();
hash<auto> out = binding.run(tensors: True);
    @endcode
*/
qclass OnnxIoBinding [arg=QoreOnnxIoBinding* binding; ns=Qore::ML; flags=final];

//! Creates an OnnxIoBinding
/** @throw ML-ONNX-BINDING-ERROR OnnxIoBinding objects must be created with
    OnnxModel::createBinding()
*/
OnnxIoBinding::constructor() {
    xsink->raiseException("ML-ONNX-BINDING-ERROR",
        "OnnxIoBinding objects must be created with OnnxModel::createBinding()");
}

//! Creates a copy of the OnnxIoBinding
/** @throw COPY-ERROR OnnxIoBinding objects cannot be copied
*/
OnnxIoBinding::copy() {
    xsink->raiseException("COPY-ERROR", "OnnxIoBinding objects cannot be copied");
}

//! Binds one input tensor
/** @param name model input tensor name
    @param value tensor data; accepts the same values as OnnxModel::run(),
        including nested lists, dense \c buffer<T>, and @ref ML::Tensor values

    @throw ML-ONNX-BINDING-ERROR if the input name is unknown or the value is invalid
*/
nothing OnnxIoBinding::bindInput(string name, auto value) [flags=NAMED_ARGS] {
    binding->bindInput(name->c_str(), value, xsink);
}

//! Binds all inputs from a hash keyed by model input tensor name
/** @param inputs hash whose keys are model input names and whose values are
    accepted input tensor data

    @throw ML-ONNX-BINDING-ERROR if any required input is missing or invalid
*/
nothing OnnxIoBinding::bindInputs(hash<auto> inputs) [flags=NAMED_ARGS] {
    binding->bindInputs(inputs, xsink);
}

//! Binds one output to ONNX Runtime-managed CPU memory
/** @param name model output tensor name
*/
nothing OnnxIoBinding::bindOutput(string name) [flags=NAMED_ARGS] {
    binding->bindOutput(name->c_str(), xsink);
}

//! Binds all model outputs to ONNX Runtime-managed CPU memory
/** This is the usual output binding mode when callers want ONNX Runtime to
    allocate output tensors according to the actual runtime shapes.
*/
nothing OnnxIoBinding::bindOutputs() {
    binding->bindOutputs(xsink);
}

//! Binds one output to a preallocated numeric Tensor
/** @param name model output tensor name
    @param output preallocated @ref ML::Tensor receiving ONNX Runtime output

    Preallocated output binding is supported for fixed-width numeric output
    tensors whose buffer layout matches ONNX Runtime. Bool and string outputs
    should use bindOutput() so ONNX Runtime can allocate the output.
*/
nothing OnnxIoBinding::bindOutputTensor(string name, Tensor output) [flags=NAMED_ARGS] {
    binding->bindOutputTensor(name->c_str(), output, xsink);
}

//! Clears all bound inputs
/** Existing bound input values are released. Bind new inputs before the next
    run() call.
*/
nothing OnnxIoBinding::clearInputs() {
    binding->clearInputs();
}

//! Clears all bound outputs
/** Existing output allocation choices are released. Bind outputs before the next
    run() call.
*/
nothing OnnxIoBinding::clearOutputs() {
    binding->clearOutputs();
}

//! Runs inference with the current bindings
/** @param options optional per-run options
    @param tensors when True, return outputs as @ref ML::Tensor objects

    @return a hash keyed by output tensor name
*/
hash<auto> OnnxIoBinding::run(*OnnxRunOptions options, bool tensors = False)
        [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return binding->run(options, tensors, xsink);
}

//! Returns currently bound input names
/** @return names in the order inputs were bound
*/
list<string> OnnxIoBinding::getBoundInputNames() [flags=RET_VALUE_ONLY] {
    return binding->getBoundInputNames(xsink);
}

//! Returns currently bound output names
/** @return names in the order outputs were bound
*/
list<string> OnnxIoBinding::getBoundOutputNames() [flags=RET_VALUE_ONLY] {
    return binding->getBoundOutputNames(xsink);
}

//! The OnnxModel class loads and runs pre-trained ONNX models for inference
/** Loads an ONNX model file and provides methods for running inference with
    Qore data types. Input data is automatically converted to the appropriate
    tensor types based on the model's input metadata.

    @par Thread Safety
    ONNX Runtime sessions are thread-safe for inference after creation, so
    concurrent run() calls from multiple threads on the same OnnxModel instance
    are safe. Metadata and diagnostic methods (getModelInfo(), getInputInfo(),
    getOutputInfo(), getProviderInfo(), getEffectiveProviderReport()) are also
    safe for concurrent use.

    @par Example:
    @code{.py}
# Load an ONNX model
OnnxModel model("/path/to/model.onnx");

# Check model info
hash<OnnxModelInfo> info = model.getModelInfo();
printf("Producer: %s, Version: %d\n", info.producer_name, info.version);

# Run inference
hash<auto> result = model.run({"input": ((1.0, 2.0, 3.0),)});
printf("Output: %y\n", result);
    @endcode

*/
qclass OnnxModel [arg=QoreOnnxModel* model; ns=Qore::ML; flags=final; dom=FILESYSTEM];

//! Creates an OnnxModel by loading the ONNX model from the given file path
/** @param model_path the filesystem path to the .onnx model file

    The best available GPU execution provider is automatically selected (CUDA on Linux,
    CoreML on macOS). Falls back to CPU if no GPU provider is available, or if an
    auto-selected provider is advertised but cannot create a session on this host.
    Explicit provider configurations still report provider initialization errors.

    @par Example:
    @code{.py}
OnnxModel model("/path/to/model.onnx");
    @endcode

    @throw ML-ONNX-ERROR if the model cannot be loaded
*/
OnnxModel::constructor(string model_path) {
#ifdef HAVE_ONNXRUNTIME
    ReferenceHolder<QoreOnnxModel> model_holder(
        new QoreOnnxModel(model_path->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_ONNXMODEL, model_holder.release());
#else
    xsink->raiseException("MISSING-FEATURE-ERROR", "the ml module was not compiled with ONNX "
        "Runtime support; check MLCapabilities.has_onnx before calling this constructor");
#endif
}

//! Creates an OnnxModel with session configuration options
/** @param model_path the filesystem path to the .onnx model file
    @param options session configuration including execution providers, threading, and optimization

    If no \c providers are specified in the config, the best available GPU execution provider
    is automatically selected (CUDA on Linux, CoreML on macOS), falling back to CPU if
    no provider is available or the auto-selected provider cannot create a session.
    An explicit empty \c providers list disables auto-detection and uses CPU only.

    @par Example:
    @code{.py}
hash<OnnxSessionConfig> config = <OnnxSessionConfig>{
    "providers": (<OnnxProviderConfig>{"name": "CUDA", "options": {"device_id": "0"}},),
    "intra_op_threads": 4,
    "graph_optimization_level": 99,
};
OnnxModel model("/path/to/model.onnx", config);
    @endcode

    @throw ML-ONNX-ERROR if the model cannot be loaded or config is invalid
    @throw ML-ONNX-PROVIDER-ERROR if an execution provider cannot be initialized

*/
OnnxModel::constructor(string model_path, hash<OnnxSessionConfig> options) {
#ifdef HAVE_ONNXRUNTIME
    ReferenceHolder<QoreOnnxModel> model_holder(
        new QoreOnnxModel(model_path->c_str(), options, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_ONNXMODEL, model_holder.release());
#else
    xsink->raiseException("MISSING-FEATURE-ERROR", "the ml module was not compiled with ONNX "
        "Runtime support; check MLCapabilities.has_onnx before calling this constructor");
#endif
}

//! Creates an OnnxModel from an in-memory byte buffer
/** @param model_data the raw ONNX model bytes (as produced by writing an ONNX
    file, or downloading one over the network)

    Use this constructor when the caller holds the model in memory and does
    not want to round-trip it through a tempfile. The buffer is copied into
    ONNX Runtime, so it may be freed immediately after the call returns.

    The best available GPU execution provider is automatically selected (CUDA
    on Linux, CoreML on macOS), falling back to CPU if no provider is available
    or the auto-selected provider cannot create a session.

    @par Example:
    @code{.py}
binary bytes = ReadOnlyFile::readBinaryFile("/path/to/model.onnx");
OnnxModel model(bytes);
    @endcode

    @throw ML-ONNX-ERROR if the model bytes cannot be parsed
*/
OnnxModel::constructor(binary model_data) {
#ifdef HAVE_ONNXRUNTIME
    ReferenceHolder<QoreOnnxModel> model_holder(
        new QoreOnnxModel(model_data->getPtr(), model_data->size(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_ONNXMODEL, model_holder.release());
#else
    xsink->raiseException("MISSING-FEATURE-ERROR", "the ml module was not compiled with ONNX "
        "Runtime support; check MLCapabilities.has_onnx before calling this constructor");
#endif
}

//! Creates an OnnxModel from an in-memory byte buffer with session configuration options
/** @param model_data the raw ONNX model bytes
    @param options session configuration including execution providers, threading, and optimization

    If no \c providers are specified in the config, the best available GPU execution provider
    is automatically selected (CUDA on Linux, CoreML on macOS), falling back to CPU if
    no provider is available or the auto-selected provider cannot create a session.
    An explicit empty \c providers list disables auto-detection and uses CPU only.

    @par Example:
    @code{.py}
binary bytes = ReadOnlyFile::readBinaryFile("/path/to/model.onnx");
hash<OnnxSessionConfig> config = <OnnxSessionConfig>{
    "intra_op_threads": 4,
    "graph_optimization_level": 99,
};
OnnxModel model(bytes, config);
    @endcode

    @throw ML-ONNX-ERROR if the model bytes cannot be parsed or config is invalid
    @throw ML-ONNX-PROVIDER-ERROR if an execution provider cannot be initialized
*/
OnnxModel::constructor(binary model_data, hash<OnnxSessionConfig> options) {
#ifdef HAVE_ONNXRUNTIME
    ReferenceHolder<QoreOnnxModel> model_holder(
        new QoreOnnxModel(model_data->getPtr(), model_data->size(), options, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_ONNXMODEL, model_holder.release());
#else
    xsink->raiseException("MISSING-FEATURE-ERROR", "the ml module was not compiled with ONNX "
        "Runtime support; check MLCapabilities.has_onnx before calling this constructor");
#endif
}

//! Creates a copy of the OnnxModel
/** @throw COPY-ERROR OnnxModel objects cannot be copied
*/
OnnxModel::copy() {
    xsink->raiseException("COPY-ERROR", "OnnxModel objects cannot be copied");
}

//! Runs inference on the model with the given input tensors
/** @param inputs a hash where keys are input tensor names and values are the tensor data;
    scalars, lists, and nested lists are supported and automatically converted to the
    appropriate tensor types

    @return a hash where keys are output tensor names and values are the output data

    @par Example:
    @code{.py}
hash<auto> outputs = model.run({"X": ((1.0, 2.0),)});
    @endcode

    @throw ML-ONNX-ERROR if the model is not loaded
    @throw ML-ONNX-INFERENCE-ERROR if inference fails or input data is invalid
*/
hash<auto> OnnxModel::run(hash<auto> inputs) {
    return model->run(inputs, xsink);
}

//! Runs inference and returns output tensors as ML::Tensor objects
/** @param inputs a hash where keys are input tensor names and values are tensor
    data; scalars, lists, nested lists, \c buffer<T>, and @ref ML::Tensor values
    are supported

    @return a hash where keys are output tensor names and values are @ref ML::Tensor
    objects preserving dtype and shape metadata

    @par Example:
    @code{.py}
ML::Tensor input(data: ((1.0, 2.0),), dtype: "float32");
hash<auto> outputs = model.runTensors({"X": input});
ML::Tensor y = outputs.Y;
buffer<float32> raw = y.getBuffer();
    @endcode

    @throw ML-ONNX-ERROR if the model is not loaded
    @throw ML-ONNX-INFERENCE-ERROR if inference fails or tensor data is invalid
*/
hash<auto> OnnxModel::runTensors(hash<auto> inputs) {
    return model->runTensors(inputs, xsink);
}

//! Saves an optimized ONNX or ORT artifact from this model's original source
/** @param output_path target path for the optimized artifact
    @param options optional session configuration to use while recreating the
        session and writing the optimized model
    @param ort_format when True, writes ONNX Runtime ORT format regardless of
        output path suffix

    If \c output_path ends in \c ".ort", ORT format is selected automatically.
    This method works for models created from paths and for models created from
    in-memory bytes.

    @return a hash containing the output path, output format, and effective
        provider report used while creating the optimized artifact

    @par Example:
    @code{.py}
OnnxModel model("/models/customer-score.onnx", <OnnxSessionConfig>{"providers": ()});
hash<auto> info = model.saveOptimized(output_path: "/models/customer-score.ort");
OnnxModel optimized("/models/customer-score.ort",
    <OnnxSessionConfig>{"providers": (), "load_model_format": "ORT"});
    @endcode

    @throw ML-ONNX-ERROR if the optimized artifact cannot be written
    @throw ML-ONNX-PROVIDER-ERROR if an execution provider cannot be initialized
*/
hash<auto> OnnxModel::saveOptimized(string output_path,
        *hash<OnnxSessionConfig> options, bool ort_format = False)
        [flags=NAMED_ARGS] {
    return model->saveOptimized(output_path->c_str(), options, ort_format, xsink);
}

//! Creates a reusable ONNX Runtime I/O binding for this model
/** @return a new @ref OnnxIoBinding tied to this model session

    @par Example:
    @code{.py}
OnnxIoBinding binding = model.createBinding();
binding.bindInputs({"X": input_tensor});
binding.bindOutputs();
hash<auto> outputs = model.runBound(binding, tensors: True);
    @endcode

    @throw ML-ONNX-ERROR if the model is not loaded
*/
OnnxIoBinding OnnxModel::createBinding() [flags=RET_VALUE_ONLY] {
    return model->createBinding(getProgram(), xsink);
}

//! Runs a reusable ONNX Runtime I/O binding
/** @param binding binding created by createBinding()
    @param options optional per-run options
    @param tensors when True, return outputs as @ref ML::Tensor objects

    @return a hash keyed by output tensor name
*/
hash<auto> OnnxModel::runBound(OnnxIoBinding binding, *OnnxRunOptions options,
        bool tensors = False) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return model->runBound(binding, options, tensors, xsink);
}

//! Runs batch inference on the model
/** @param batch a list of input hashes; each hash has the same format as run()

    @return a list of output hashes

    @par Example:
    @code{.py}
list<hash<auto>> results = model.runBatch((
    {"X": ((1.0,),)},
    {"X": ((2.0,),)},
));
    @endcode

    @throw ML-ONNX-ERROR if the model is not loaded
    @throw ML-ONNX-INFERENCE-ERROR if inference fails
*/
list<hash<auto>> OnnxModel::runBatch(list<auto> batch) {
    return model->runBatch(batch, xsink);
}

//! Returns model metadata
/** @return an @ref OnnxModelInfo hash with model information including
    producer name, description, version, and input/output tensor info

    @par Example:
    @code{.py}
hash<OnnxModelInfo> info = model.getModelInfo();
printf("Inputs: %y\n", info.inputs);
    @endcode
*/
hash<OnnxModelInfo> OnnxModel::getModelInfo() {
    return model->getModelInfo(xsink);
}

//! Returns input tensor metadata
/** @return a list of @ref OnnxTensorInfo hashes describing each input tensor

    @par Example:
    @code{.py}
list<hash<OnnxTensorInfo>> inputs = model.getInputInfo();
for (hash<OnnxTensorInfo> inp in inputs) {
    printf("Input: %s type=%s shape=%y\n", inp.name, inp.type, inp.shape);
}
    @endcode
*/
list<hash<OnnxTensorInfo>> OnnxModel::getInputInfo() {
    return model->getInputInfo(xsink);
}

//! Returns output tensor metadata
/** @return a list of @ref OnnxTensorInfo hashes describing each output tensor

    @par Example:
    @code{.py}
list<hash<OnnxTensorInfo>> outputs = model.getOutputInfo();
    @endcode
*/
list<hash<OnnxTensorInfo>> OnnxModel::getOutputInfo() {
    return model->getOutputInfo(xsink);
}

//! Returns True if the model is loaded successfully
/** @return True if the model is loaded and ready for inference
*/
bool OnnxModel::isLoaded() [flags=CONSTANT] {
    return model->isLoaded();
}

//! Returns the configured execution provider name
/** @return the name of the execution provider that was configured for this session
    (e.g. \c "CPUExecutionProvider", \c "CUDAExecutionProvider")

    @note This returns the provider that was successfully appended to the session
    options during construction. ONNX Runtime may silently fall back to a different
    provider (typically CPU) for individual operations if the configured provider
    cannot handle them. There is no ONNX Runtime API to query the actual provider
    used at runtime per operation.

    @par Example:
    @code{.py}
string provider = model.getProviderInfo();
printf("Configured provider: %s\n", provider);
    @endcode

*/
string OnnxModel::getProviderInfo() [flags=RET_VALUE_ONLY] {
    return new QoreStringNode(model->getActiveProvider());
}

//! Returns providers available in the linked ONNX Runtime build
/** @return a list of canonical ONNX Runtime execution provider names

    @par Example:
    @code{.py}
list<string> providers = model.getProviders();
printf("Available providers: %y\n", providers);
    @endcode
*/
list<string> OnnxModel::getProviders() [flags=RET_VALUE_ONLY] {
    return model->getProviders(xsink);
}

//! Returns known provider option metadata
/** @return a hash keyed by canonical provider name with aliases, availability,
    and known option descriptions

    @par Example:
    @code{.py}
hash<auto> options = model.getProviderOptions();
printf("CUDA options: %y\n", options.CUDAExecutionProvider.known_options);
    @endcode
*/
hash<auto> OnnxModel::getProviderOptions() [flags=RET_VALUE_ONLY] {
    return model->getProviderOptions(xsink);
}

//! Returns normalized provider names requested by the session config
/** @return the normalized explicit provider list; empty when providers were not
    supplied or when providers: () requested CPU-only execution
*/
list<string> OnnxModel::getRequestedProviders() [flags=RET_VALUE_ONLY] {
    return model->getRequestedProviders(xsink);
}

//! Returns structured provider diagnostics for this session
/** @return a list of @ref OnnxProviderDiagnostic hashes

    @par Example:
    @code{.py}
for (hash<OnnxProviderDiagnostic> diag in model.getProviderDiagnostics()) {
    printf("%s: available=%y appended=%y error=%y\n",
        diag.name, diag.available, diag.appended, diag.error);
}
    @endcode
*/
list<hash<OnnxProviderDiagnostic>> OnnxModel::getProviderDiagnostics() [flags=RET_VALUE_ONLY] {
    return model->getProviderDiagnostics(xsink);
}

//! Returns the effective provider report for this session
/** @return a hash containing the active provider, available providers,
    requested providers, provider diagnostics, and fallback policy

    @par Example:
    @code{.py}
hash<auto> report = model.getEffectiveProviderReport();
assertEq(False, report.cpu_fallback_used);
printf("Active provider: %s\n", report.active_provider);
    @endcode
*/
hash<auto> OnnxModel::getEffectiveProviderReport() [flags=RET_VALUE_ONLY] {
    return model->getEffectiveProviderReport(xsink);
}
