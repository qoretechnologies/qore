// Wraps a freshly-deserialized priv pointer in a QoreObject of the right qclass.
// Defined in ml-module.cpp; consumed by ml_deserialize() and ml_load_model() below.
extern QoreObject* makeMLModelObject(const std::string& algorithm, AbstractPrivateData* priv,
    QoreProgram* pgm, ExceptionSink* xsink);

//! Result of Isolation Forest anomaly scoring
/** Result of Isolation Forest anomaly scoring
*/
hashdecl Qore::ML::IsolationForestResult {
    //! anomaly score (0.0 = normal, 1.0 = anomalous)
    float anomaly_score;
    //! whether the score exceeds the configured threshold
    bool is_anomaly;
    //! average path length in the forest
    float average_path_length;
    //! expected path length for the dataset size
    float expected_path_length;
}

//! Result of DBSCAN clustering
/** Result of DBSCAN clustering
*/
hashdecl Qore::ML::DBSCANResult {
    //! cluster label (-1 = noise/outlier)
    int cluster;
    //! whether the point is a core point
    bool is_core;
    //! number of neighbors within epsilon
    int neighbor_count;
}

//! Result of K-Means clustering
/** Result of K-Means clustering
*/
hashdecl Qore::ML::KMeansResult {
    //! assigned cluster index (0-based)
    int cluster;
    //! distance to assigned centroid
    float distance;
    //! distances to all centroids
    list<float> centroid_distances;
}

//! Holt-Winters forecast result
/** Holt-Winters forecast result
*/
hashdecl Qore::ML::HoltWintersResult {
    //! forecasted value
    float forecast;
    //! current level component
    float level;
    //! current trend component
    float trend;
    //! current seasonal component
    float seasonal;
}

//! PCA transformation result
/** PCA transformation result
*/
hashdecl Qore::ML::PCAResult {
    //! transformed values (principal components)
    list<float> components;
    //! explained variance ratio per component
    list<float> explained_variance_ratio;
    //! total explained variance
    float total_explained_variance;
}

//! Seasonal decomposition result
/** Seasonal decomposition result
*/
hashdecl Qore::ML::SeasonalDecompositionResult {
    //! trend component (NOTHING at edges where the moving average cannot be computed)
    *float trend;
    //! seasonal component
    float seasonal;
    //! residual component (NOTHING at edges where the moving average cannot be computed)
    *float residual;
    //! detected period length
    int period;
}

//! Result of linear regression prediction
/** Result of linear regression prediction
*/
hashdecl Qore::ML::LinearRegressionResult {
    //! predicted target value
    float prediction;
    //! model coefficients (one per feature)
    list<float> coefficients;
    //! intercept (bias) term
    float intercept;
    //! R-squared (coefficient of determination) from training
    float r_squared;
}

//! Linear regression model information (model-level parameters independent of individual predictions)
/** Use getModelInfo() to retrieve model parameters once, instead of extracting them from each
    individual @ref LinearRegressionResult returned by predict() or predictMatrix().

*/
hashdecl Qore::ML::LinearRegressionModelInfo {
    //! model coefficients (one per feature)
    list<float> coefficients;
    //! intercept (bias) term; 0.0 if fit_intercept was False
    float intercept;
    //! R-squared (coefficient of determination) from training; 1.0 = perfect fit
    float r_squared;
    //! number of features the model was trained with
    int n_features;
}

//! Result of Ridge (L2-regularized) regression prediction
/** Result of Ridge regression prediction
*/
hashdecl Qore::ML::RidgeResult {
    //! predicted target value
    float prediction;
    //! model coefficients (one per feature)
    list<float> coefficients;
    //! intercept (bias) term
    float intercept;
    //! R-squared (coefficient of determination) from training
    float r_squared;
}

//! Ridge regression model information
/** Use getModelInfo() to retrieve model parameters once.
*/
hashdecl Qore::ML::RidgeModelInfo {
    //! model coefficients (one per feature)
    list<float> coefficients;
    //! intercept (bias) term; 0.0 if fit_intercept was False
    float intercept;
    //! R-squared (coefficient of determination) from training; 1.0 = perfect fit
    float r_squared;
    //! number of features the model was trained with
    int n_features;
    //! L2 regularization strength
    float alpha;
}

//! Result of Lasso (L1-regularized) regression prediction
/** Result of Lasso regression prediction
*/
hashdecl Qore::ML::LassoResult {
    //! predicted target value
    float prediction;
    //! model coefficients (one per feature; some may be exactly zero)
    list<float> coefficients;
    //! intercept (bias) term
    float intercept;
    //! R-squared (coefficient of determination) from training
    float r_squared;
}

//! Lasso regression model information
/** Use getModelInfo() to retrieve model parameters once.
*/
hashdecl Qore::ML::LassoModelInfo {
    //! model coefficients (one per feature; some may be exactly zero)
    list<float> coefficients;
    //! intercept (bias) term; 0.0 if fit_intercept was False
    float intercept;
    //! R-squared (coefficient of determination) from training; 1.0 = perfect fit
    float r_squared;
    //! number of features the model was trained with
    int n_features;
    //! L1 regularization strength
    float alpha;
    //! number of coordinate descent iterations executed
    int iterations_run;
}

//! Result of ElasticNet (L1+L2 regularized) regression prediction
/** Result of ElasticNet regression prediction
*/
hashdecl Qore::ML::ElasticNetResult {
    //! predicted target value
    float prediction;
    //! model coefficients (one per feature; some may be exactly zero)
    list<float> coefficients;
    //! intercept (bias) term
    float intercept;
    //! R-squared (coefficient of determination) from training
    float r_squared;
}

//! ElasticNet regression model information
/** Use getModelInfo() to retrieve model parameters once.
*/
hashdecl Qore::ML::ElasticNetModelInfo {
    //! model coefficients (one per feature; some may be exactly zero)
    list<float> coefficients;
    //! intercept (bias) term; 0.0 if fit_intercept was False
    float intercept;
    //! R-squared (coefficient of determination) from training; 1.0 = perfect fit
    float r_squared;
    //! number of features the model was trained with
    int n_features;
    //! regularization strength
    float alpha;
    //! L1/L2 mixing ratio (0 = pure Ridge, 1 = pure Lasso)
    float l1_ratio;
    //! number of coordinate descent iterations executed
    int iterations_run;
}

//! Result of logistic regression prediction
/** Result of logistic regression prediction
*/
hashdecl Qore::ML::LogisticRegressionResult {
    //! predicted class label
    float predicted_class;
    //! probability of the predicted class
    float max_probability;
    //! probabilities for each class (in the same order as \c classes)
    list<float> probabilities;
    //! sorted list of class labels
    list<float> classes;
}

//! Result of Local Outlier Factor scoring
/** Result of Local Outlier Factor scoring
*/
hashdecl Qore::ML::LOFResult {
    //! local outlier factor score (> 1.0 indicates anomaly)
    float lof_score;
    //! whether the score exceeds the configured threshold
    bool is_anomaly;
    //! distance to the k-th nearest neighbor
    float k_distance;
    //! k parameter used
    int k;
}

//! Result of Gaussian Mixture Model prediction
/** Result of Gaussian Mixture Model prediction
*/
hashdecl Qore::ML::GMMResult {
    //! most likely cluster assignment
    int cluster;
    //! probability of the most likely cluster
    float max_probability;
    //! probabilities for each cluster
    list<float> probabilities;
    //! log-likelihood of the data point
    float log_likelihood;
}

//! Result of KNN classification prediction
/** Result of KNN classification prediction
*/
hashdecl Qore::ML::KNNClassificationResult {
    //! predicted class label
    int predicted_class;
    //! confidence (proportion of voting weight for the predicted class)
    float confidence;
    //! list of k nearest neighbor details (index, distance, label)
    list<hash<auto>> neighbors;
}

//! Result of KNN regression prediction
/** Result of KNN regression prediction
*/
hashdecl Qore::ML::KNNRegressionResult {
    //! predicted target value (weighted mean of k nearest neighbors)
    float prediction;
    //! list of k nearest neighbor details (index, distance, label)
    list<hash<auto>> neighbors;
}

//! ONNX tensor metadata
/** ONNX tensor metadata
*/
hashdecl Qore::ML::OnnxTensorInfo {
    //! tensor name
    string name;
    //! element data type (e.g. "float", "double", "int64")
    string type;
    //! tensor shape dimensions (-1 for dynamic dimensions)
    list<int> shape;
    //! symbolic tensor shape dimensions; empty strings correspond to fixed numeric dimensions
    list<string> symbolic_shape;
}

//! ONNX execution provider configuration
/** Configures a single execution provider for an ONNX Runtime session.

    Providers are tried in the order specified; if a provider is not available or
    fails to initialize, the next one in the list is used. The CPU provider is
    always available as a fallback.

    @par Example:
    @code{.py}
hash<OnnxProviderConfig> cuda_cfg = <OnnxProviderConfig>{
    "name": "CUDA",
    "options": {"device_id": "0"},
};
    @endcode

*/
hashdecl Qore::ML::OnnxProviderConfig {
    //! provider name (e.g. "CUDA", "TensorRT", "OpenVINO", "CoreML", "DirectML", "CPU")
    string name;
    //! provider-specific key-value config (e.g. @code{"device_id": "0"}@endcode)
    *hash<string, string> options;
}

//! ONNX execution provider diagnostic information
/** Describes how a provider was requested and configured for an
    @ref OnnxModel session.  Diagnostics are meant for deployment validation:
    they show which providers were available in the current ONNX Runtime build,
    which ones were requested or required by the caller, and whether CPU
    fallback was used.
*/
hashdecl Qore::ML::OnnxProviderDiagnostic {
    //! normalized ONNX Runtime provider name
    string name;
    //! provider-specific options supplied in @ref OnnxProviderConfig
    *hash<string, string> options;
    //! whether the provider was explicitly requested
    bool requested;
    //! whether the provider was listed in @ref OnnxSessionConfig.required_providers
    bool required;
    //! whether the provider is available in the linked ONNX Runtime build
    bool available;
    //! whether the provider was appended to the session options
    bool appended;
    //! whether the provider was selected by Qore's automatic provider selection
    bool auto_selected;
    //! whether the provider is the effective top-level provider recorded for the session
    bool active;
    //! whether this provider was used because an automatic non-CPU provider failed
    bool cpu_fallback;
    //! provider append, initialization, or fallback error text, if any
    *string error;
}

//! ONNX device-buffer binding policy
/** Controls whether ONNX inputs/outputs are bound directly to execution-provider
    device memory (e.g. CUDA GPU buffers) instead of being copied through host
    memory.  All fields are optional; the policy only takes effect when a non-CPU
    execution provider is active.  On CPU-only builds or CPU-only sessions these
    options parse normally and requesting a device path raises an actionable
    @c ML-ONNX-DEVICE-* exception unless host fallback is allowed.

    @since %ML 2.6
*/
hashdecl Qore::ML::OnnxDeviceBindingConfig {
    //! enables device-aware input/output binding; default False
    *bool enabled;
    //! default device for provider-managed outputs: "cpu", "provider", or an explicit provider/device name; default "provider"
    *string default_output_device;
    //! allow host copies when a requested device path is unavailable; default False
    *bool allow_host_fallback;
    //! force returned device outputs to host storage before returning; default False
    *bool materialize_outputs;
    //! reject device inputs that cannot be bound without a host copy; default False
    *bool require_zero_copy_inputs;
    //! reject outputs that cannot be returned as device-backed buffers; default False
    *bool require_zero_copy_outputs;
}

//! ONNX session configuration
/** Controls ONNX Runtime session options including execution providers, threading,
    and graph optimization.

    @par Example:
    @code{.py}
hash<OnnxSessionConfig> config = <OnnxSessionConfig>{
    "providers": (<OnnxProviderConfig>{"name": "CUDA", "options": {"device_id": "0"}},),
    "intra_op_threads": 4,
    "graph_optimization_level": 99,
};
ML::OnnxModel model("/path/to/model.onnx", config);
    @endcode

*/
hashdecl Qore::ML::OnnxSessionConfig {
    //! execution providers in priority order; CPU is always available as fallback
    /** Providers are tried in order from first to last; the first one that is available
        on the system and initializes successfully is used for inference. If none succeed,
        CPU is used as the fallback.

        Common providers: \c "CUDA" (NVIDIA GPU), \c "TensorRT" (NVIDIA optimized),
        \c "OpenVINO" (Intel), \c "DirectML" (Windows GPU), \c "CoreML" (macOS/iOS)
    */
    *list<hash<OnnxProviderConfig>> providers;
    //! provider names that must be configured successfully; unavailable required providers raise ML-ONNX-PROVIDER-ERROR
    *list<string> required_providers;
    //! whether Qore may fall back to CPU when an auto-selected non-CPU provider fails; default True
    *bool allow_cpu_fallback;
    //! whether an auto-selected provider failure should raise instead of using CPU fallback; default False
    *bool fail_on_provider_fallback;
    //! number of threads for parallelism within a single operation (e.g. one large matrix multiply); default 1; must be >= 1
    *int intra_op_threads;
    //! number of threads for running independent operations in parallel (e.g. two unrelated layers); 0 = let the runtime decide; must be >= 0
    *int inter_op_threads;
    //! how aggressively to optimize the model graph before inference: 0=disabled, 1=basic, 2=extended, 99=all; default 99
    *int graph_optimization_level;
    //! diagnostic log verbosity: 0=verbose, 1=info, 2=warning, 3=error, 4=fatal; default 2 (warning)
    *int log_severity;
    //! whether to enable ONNX Runtime profiling for this session
    *bool enable_profiling;
    //! profile file prefix passed to ONNX Runtime; setting this also enables profiling
    *string profile_file_prefix;
    //! path where ONNX Runtime should save the optimized model while creating the session
    *string optimized_model_filepath;
    //! input model format for memory buffers or ambiguous paths: "ONNX" or "ORT"
    *string load_model_format;
    //! optimized model output format when optimized_model_filepath is set: "ONNX" or "ORT"
    *string save_model_format;
    //! raw ONNX Runtime session config entries; values are converted to strings
    *hash<auto> config;
    //! device-buffer binding policy for GPU/accelerator execution providers
    *hash<OnnxDeviceBindingConfig> device_binding;
}

//! ONNX model metadata
/** ONNX model metadata
*/
hashdecl Qore::ML::OnnxModelInfo {
    //! producer framework name (e.g. "pytorch", "sklearn")
    string producer_name;
    //! model description (may be @ref nothing)
    *string description;
    //! model version
    int version;
    //! input tensor metadata
    list<hash<OnnxTensorInfo>> inputs;
    //! output tensor metadata
    list<hash<OnnxTensorInfo>> outputs;
    //! active execution provider name (e.g. "CPUExecutionProvider")
    *string active_provider;
    //! available providers reported by ONNX Runtime on this host
    list<string> available_providers;
    //! normalized provider names explicitly requested by session configuration
    list<string> requested_providers;
    //! provider configuration and fallback diagnostics
    list<hash<OnnxProviderDiagnostic>> provider_diagnostics;
    //! whether CPU fallback was used after an automatic non-CPU provider failed
    bool cpu_fallback_used;
}

//! StandardScaler model information
/** StandardScaler model information
*/
hashdecl Qore::ML::StandardScalerInfo {
    //! per-feature mean values
    list<float> mean;
    //! per-feature standard deviation values
    list<float> std;
    //! number of features
    int n_features;
    //! whether centering (mean subtraction) is enabled
    bool with_mean;
    //! whether scaling (std division) is enabled
    bool with_std;
}

//! MinMaxScaler model information
/** MinMaxScaler model information
*/
hashdecl Qore::ML::MinMaxScalerInfo {
    //! per-feature minimum values from training data
    list<float> data_min;
    //! per-feature maximum values from training data
    list<float> data_max;
    //! lower bound of target range
    float feature_min;
    //! upper bound of target range
    float feature_max;
    //! number of features
    int n_features;
}

//! Imputer model information
/** Imputer model information
*/
hashdecl Qore::ML::ImputerInfo {
    //! imputation strategy ("mean", "median", "most_frequent", "constant")
    string strategy;
    //! computed fill values per feature
    list<float> fill_values;
    //! number of features
    int n_features;
}

//! Confusion matrix result
/** Contains the n_classes x n_classes confusion matrix and the class labels
*/
hashdecl Qore::ML::ConfusionMatrixResult {
    //! the confusion matrix (rows = true labels, columns = predicted labels)
    list<list<int>> matrix;
    //! sorted class labels corresponding to matrix rows/columns
    list<float> labels;
}

//! Per-class classification metrics
/** Precision, recall, F1, and support for a single class
*/
hashdecl Qore::ML::ClassMetrics {
    //! class label as a string
    string label;
    //! precision (true positives / predicted positives)
    float precision;
    //! recall (true positives / actual positives)
    float recall;
    //! F1 score (harmonic mean of precision and recall)
    float f1;
    //! number of true instances of this class
    int support;
}

//! Full classification report with per-class and aggregate metrics
/** Contains accuracy, per-class metrics, and macro/weighted averages
*/
hashdecl Qore::ML::ClassificationReport {
    //! overall accuracy (fraction of correct predictions)
    float accuracy;
    //! per-class precision, recall, F1, and support
    list<hash<ClassMetrics>> per_class;
    //! unweighted mean of per-class precision
    float macro_precision;
    //! unweighted mean of per-class recall
    float macro_recall;
    //! unweighted mean of per-class F1
    float macro_f1;
    //! support-weighted mean of per-class F1
    float weighted_f1;
}

//! Cross-validation fold with train and test indices
/** Returned by CrossValidator::split()
*/
hashdecl Qore::ML::CrossValidationFold {
    //! indices of training samples for this fold
    list<int> train_indices;
    //! indices of test samples for this fold
    list<int> test_indices;
    //! fold number (0-based)
    int fold;
}

//! ML module capability information
/** ML module capability information
*/
hashdecl Qore::ML::MLCapabilities {
    //! whether ONNX Runtime support is compiled in
    bool has_onnx;
    //! list of available native algorithm names
    list<string> native_algorithms;
    //! Eigen version string
    string eigen_version;
    //! available ONNX execution providers (empty if no ONNX Runtime)
    list<string> onnx_providers;
}

//! Decision tree classification prediction result
/** Returned by @ref DecisionTree::predict() and @ref DecisionTree::predictMatrix()
    when the tree is configured for classification.
*/
hashdecl Qore::ML::DecisionTreeClassificationResult {
    //! predicted class label
    int predicted_class;
    //! probability of the predicted class
    float max_probability;
    //! probability for each class
    list<float> probabilities;
    //! class labels (same order as probabilities)
    list<float> classes;
}

//! Decision tree regression prediction result
/** Returned by @ref DecisionTree::predict() and @ref DecisionTree::predictMatrix()
    when the tree is configured for regression.
*/
hashdecl Qore::ML::DecisionTreeRegressionResult {
    //! predicted target value
    float prediction;
}

//! Feature importance information (shared by all tree-based algorithms)
/** Returned by @ref DecisionTree::getFeatureImportances() and similar methods.
    Importances are normalized to sum to 1.0.
*/
hashdecl Qore::ML::FeatureImportanceInfo {
    //! feature names
    list<string> feature_names;
    //! normalized importance values (sum to 1.0)
    list<float> importances;
}

//! Random forest classification prediction result
/** Returned by @ref RandomForest::predict() and @ref RandomForest::predictMatrix()
    when configured for classification.
*/
hashdecl Qore::ML::RandomForestClassificationResult {
    //! predicted class label
    int predicted_class;
    //! probability of the predicted class
    float max_probability;
    //! probability for each class
    list<float> probabilities;
    //! class labels
    list<float> classes;
}

//! Random forest regression prediction result
/** Returned by @ref RandomForest::predict() and @ref RandomForest::predictMatrix()
    when configured for regression.
*/
hashdecl Qore::ML::RandomForestRegressionResult {
    //! predicted target value
    float prediction;
}

//! GBT classification prediction result
/** Returned by @ref GradientBoostedTrees::predict() and
    @ref GradientBoostedTrees::predictMatrix() when configured for classification.
*/
hashdecl Qore::ML::GBTClassificationResult {
    //! predicted class label
    int predicted_class;
    //! probability of the predicted class
    float max_probability;
    //! probability for each class
    list<float> probabilities;
    //! class labels
    list<float> classes;
}

//! GBT regression prediction result
/** Returned by @ref GradientBoostedTrees::predict() and
    @ref GradientBoostedTrees::predictMatrix() when configured for regression.
*/
hashdecl Qore::ML::GBTRegressionResult {
    //! predicted target value
    float prediction;
}

//! SVM prediction result
/** Returned by @ref SVM::predict() and @ref SVM::predictMatrix().
*/
hashdecl Qore::ML::SVMResult {
    //! predicted class label
    int predicted_class;
    //! decision function value (distance from hyperplane)
    float decision_value;
    //! confidence (sigmoid of |decision_value| for binary; vote fraction for multiclass)
    float confidence;
}

//! Naive Bayes prediction result
/** Returned by @ref NaiveBayes::predict() and @ref NaiveBayes::predictMatrix().
*/
hashdecl Qore::ML::NaiveBayesResult {
    //! predicted class label
    int predicted_class;
    //! probability of the predicted class
    float max_probability;
    //! probability for each class
    list<float> probabilities;
    //! class labels
    list<float> classes;
}

//! Hypothesis test result
/** Returned by @ref ml_t_test() and @ref ml_chi_squared_test().
*/
hashdecl Qore::ML::HypothesisTestResult {
    //! test statistic value
    float statistic;
    //! p-value (probability of observing this statistic under the null hypothesis)
    float p_value;
    //! degrees of freedom
    float df;
}

/** @defgroup ml_functions ML Functions
    ML utility functions
*/
///@{
namespace Qore::ML;

//! Returns ML module capabilities
/** @return an @ref MLCapabilities hash with module capability information

    @par Example:
    @code{.py}
hash<MLCapabilities> caps = ml_get_capabilities();
printf("Eigen version: %s\n", caps.eigen_version);
printf("ONNX support: %y\n", caps.has_onnx);
    @endcode

*/
hash<MLCapabilities> ml_get_capabilities() [flags=CONSTANT; dom=DEFAULT] {
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(hashdeclMLCapabilities, xsink), xsink);

#ifdef HAVE_ONNXRUNTIME
    rv->setKeyValue("has_onnx", true, xsink);
#else
    rv->setKeyValue("has_onnx", false, xsink);
#endif

    // Build native algorithms list
    ReferenceHolder<QoreListNode> algos(new QoreListNode(stringTypeInfo), xsink);
    algos->push(new QoreStringNode("IsolationForest"), xsink);
    algos->push(new QoreStringNode("DBSCAN"), xsink);
    algos->push(new QoreStringNode("KMeans"), xsink);
    algos->push(new QoreStringNode("HoltWinters"), xsink);
    algos->push(new QoreStringNode("PCA"), xsink);
    algos->push(new QoreStringNode("SeasonalDecomposition"), xsink);
    algos->push(new QoreStringNode("LinearRegression"), xsink);
    algos->push(new QoreStringNode("LogisticRegression"), xsink);
    algos->push(new QoreStringNode("LOF"), xsink);
    algos->push(new QoreStringNode("KNN"), xsink);
    algos->push(new QoreStringNode("GMM"), xsink);
    algos->push(new QoreStringNode("StandardScaler"), xsink);
    algos->push(new QoreStringNode("MinMaxScaler"), xsink);
    algos->push(new QoreStringNode("Imputer"), xsink);
    algos->push(new QoreStringNode("MLPipeline"), xsink);
    algos->push(new QoreStringNode("CrossValidator"), xsink);
    algos->push(new QoreStringNode("DecisionTree"), xsink);
    algos->push(new QoreStringNode("RandomForest"), xsink);
    algos->push(new QoreStringNode("GradientBoostedTrees"), xsink);
    algos->push(new QoreStringNode("SVM"), xsink);
    algos->push(new QoreStringNode("NaiveBayes"), xsink);
    algos->push(new QoreStringNode("OneHotEncoder"), xsink);
    algos->push(new QoreStringNode("LabelEncoder"), xsink);
    algos->push(new QoreStringNode("VarianceThreshold"), xsink);
    algos->push(new QoreStringNode("PolynomialFeatures"), xsink);
    algos->push(new QoreStringNode("SelectKBest"), xsink);
    algos->push(new QoreStringNode("RFE"), xsink);
    algos->push(new QoreStringNode("ADWIN"), xsink);
    algos->push(new QoreStringNode("PageHinkley"), xsink);
    algos->push(new QoreStringNode("DDM"), xsink);
    algos->push(new QoreStringNode("DateTimeFeatures"), xsink);
    algos->push(new QoreStringNode("TextFeatures"), xsink);
#ifdef HAVE_ONNXRUNTIME
    algos->push(new QoreStringNode("OnnxModel"), xsink);
    algos->push(new QoreStringNode("OnnxSessionPool"), xsink);
#endif
    rv->setKeyValue("native_algorithms", algos.release(), xsink);

    // Eigen version string
    QoreStringNode* eigen_ver = new QoreStringNode;
    eigen_ver->sprintf("%d.%d.%d", EIGEN_WORLD_VERSION, EIGEN_MAJOR_VERSION, EIGEN_MINOR_VERSION);
    rv->setKeyValue("eigen_version", eigen_ver, xsink);

    // ONNX providers
#ifdef HAVE_ONNXRUNTIME
    rv->setKeyValue("onnx_providers", qore_ml_get_onnx_providers(xsink), xsink);
#else
    ReferenceHolder<QoreListNode> providers(new QoreListNode(stringTypeInfo), xsink);
    rv->setKeyValue("onnx_providers", providers.release(), xsink);
#endif

    return rv.release();
}

//! Returns the list of available ONNX Runtime execution providers
/** @return a list of provider name strings (e.g. "CPUExecutionProvider", "CUDAExecutionProvider");
    returns an empty list if ONNX Runtime support is not available

    @par Example:
    @code{.py}
list<string> providers = ml_get_onnx_providers();
printf("Available providers: %y\n", providers);
    @endcode

*/
list<string> ml_get_onnx_providers() [flags=CONSTANT; dom=DEFAULT] {
#ifdef HAVE_ONNXRUNTIME
    return qore_ml_get_onnx_providers(xsink);
#else
    return xsink->raiseException("MISSING-FEATURE-ERROR", "the ml module was not compiled with ONNX Runtime "
        "support; check MLCapabilities.has_onnx before calling this function");
#endif
}

//! Returns known ONNX Runtime execution provider options
/** @return a hash keyed by canonical provider name; each value includes provider
    aliases, availability, and the provider options Qore knows how to pass
    through to ONNX Runtime

    @par Example:
    @code{.py}
hash<auto> opts = ml_get_onnx_provider_options();
printf("CUDA available: %y\n", opts.CUDAExecutionProvider.available);
printf("CUDA options: %y\n", opts.CUDAExecutionProvider.known_options);
    @endcode

*/
hash<auto> ml_get_onnx_provider_options() [flags=CONSTANT; dom=DEFAULT] {
#ifdef HAVE_ONNXRUNTIME
    return qore_ml_get_onnx_provider_options(xsink);
#else
    return xsink->raiseException("MISSING-FEATURE-ERROR", "the ml module was not compiled with ONNX Runtime "
        "support; check MLCapabilities.has_onnx before calling this function");
#endif
}

//! Saves an optimized ONNX or ORT model artifact
/** @param input_path source ONNX or ORT model path
    @param output_path target path for the optimized artifact
    @param options optional ONNX session configuration; providers, graph
        optimization level, threading, and raw session \c config entries are
        honored
    @param ort_format when True, writes ONNX Runtime ORT format regardless of
        output path suffix

    If \c output_path ends in \c ".ort", ORT format is selected automatically.
    Otherwise the default output format is optimized ONNX unless
    \c options.save_model_format is \c "ORT".

    @return a hash containing the input path, output path, output format, and
        effective provider report used while creating the optimized artifact

    @par Example:
    @code{.py}
hash<auto> info = onnx_optimize_model(
    input_path: "/models/customer-score.onnx",
    output_path: "/models/customer-score.ort",
    options: <OnnxSessionConfig>{"providers": ()});
OnnxModel model("/models/customer-score.ort",
    <OnnxSessionConfig>{"providers": (), "load_model_format": "ORT"});
    @endcode

    @throw ML-ONNX-ERROR if the model cannot be optimized
    @throw ML-ONNX-PROVIDER-ERROR if an execution provider cannot be initialized
*/
hash<auto> onnx_optimize_model(string input_path, string output_path, *hash<auto> options, bool ort_format = False) [dom=FILESYSTEM; flags=NAMED_ARGS] {
#ifdef HAVE_ONNXRUNTIME
    return qore_ml_onnx_optimize_model(input_path->c_str(), output_path->c_str(),
        options, ort_format, xsink);
#else
    return xsink->raiseException("MISSING-FEATURE-ERROR", "the ml module was not compiled with ONNX Runtime "
        "support; check MLCapabilities.has_onnx before calling this function");
#endif
}

//! Computes classification accuracy (fraction of correct predictions)
/** @param y_true a list of true class labels
    @param y_pred a list of predicted class labels
    @return accuracy from 0.0 (all wrong) to 1.0 (all correct)

    @par Example:
    @code{.py}
float acc = ml_accuracy((1, 0, 1, 1, 0), (1, 0, 0, 1, 0));
printf("Accuracy: %.1f%%\n", acc * 100);  # 80.0%
    @endcode

    @throw ML-METRICS-ERROR empty or mismatched inputs
*/
float ml_accuracy(list<float> y_true, list<float> y_pred) [dom=DEFAULT] {
    VectorXd yt = qoreListToVector(y_true, xsink);
    if (*xsink) { return QoreValue(); }
    VectorXd yp = qoreListToVector(y_pred, xsink);
    if (*xsink) { return QoreValue(); }
    return mlAccuracy(yt, yp, xsink);
}

