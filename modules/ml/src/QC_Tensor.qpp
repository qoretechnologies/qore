#include "qore/Qore.h"

#include "QC_Tensor.h"

//! Dense tensor value for ML model inference
/** A Tensor stores model input or output data as a dense \c buffer<T> plus
    explicit shape metadata. It is the bridge between Qore's columnar dense
    buffers and model runtimes such as ONNX Runtime.

    Tensor values do not allow nullable buffer elements because model tensors do
    not carry per-element \c NOTHING values. Impute or filter missing values
    before creating a Tensor.

    @par Example:
    @code{.py}
ML::Tensor input(data: ((1.0, 2.0), (3.0, 4.0)), dtype: "float32");
assertEq((2, 2), input.getShape());
hash<auto> outputs = model.runTensors({"X": input});
    @endcode
*/
qclass Tensor [arg=QoreTensor* tensor; ns=Qore::ML; flags=final];

//! Creates a Tensor from a list, nested list, scalar, or dense buffer
/** @param data source data; accepts numeric/bool values, nested lists, or a
    non-nullable \c buffer<T>
    @param shape optional tensor shape; inferred from nested lists and defaults
    to a one-dimensional shape for buffers
    @param dtype optional buffer element type; expected values are \c int8,
    \c int16, \c int32, \c int64, \c float32, \c float64, or \c bool

    When \c data is a buffer and \c dtype is supplied, the dtype must match the
    buffer element type. Use the buffer constructor first when a dtype conversion
    is required.

    @throw ML-TENSOR-ERROR if the source contains null values or unsupported data
    @throw ML-TENSOR-SHAPE-ERROR if the shape is invalid or does not match the
    source element count
    @throw ML-TENSOR-DTYPE-ERROR if dtype is invalid or incompatible
*/
Tensor::constructor(auto data, *list<int> shape, *string dtype) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreTensor> holder(QoreTensor::fromValue(data, shape, dtype, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_TENSOR, holder.release());
}

//! Creates a copy of the Tensor
/** @throw COPY-ERROR Tensor objects cannot be copied implicitly
*/
Tensor::copy() {
    xsink->raiseException("COPY-ERROR", "Tensor objects cannot be copied implicitly");
}

//! Creates a Tensor from a dense buffer
/** @param data non-nullable dense buffer
    @param shape tensor shape
    @return a Tensor wrapping a copy of the buffer data with the given shape
*/
static Tensor Tensor::fromBuffer(auto data, list<int> shape) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    ReferenceHolder<QoreTensor> holder(QoreTensor::fromValue(data, shape, nullptr, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return qore_ml_tensor_to_object(holder.release(), getProgram(), xsink);
}

//! Creates a row-major two-dimensional Tensor from dense column buffers
/** @param columns list of equal-length non-nullable dense buffers
    @param dtype optional tensor dtype; when omitted, the first column's buffer
        type is used and all columns must have the same type

    @return a Tensor with shape \c (rows, columns)

    This method is optimized for DataFrame and DataProvider columnar pipelines
    that need to feed multi-feature ONNX models. It packs column buffers into
    the row-major layout expected by ONNX Runtime without first materializing
    row hashes or nested Qore lists.

    @throw ML-TENSOR-ERROR if a column is not a dense buffer or contains nulls
    @throw ML-TENSOR-SHAPE-ERROR if columns have different lengths
    @throw ML-TENSOR-DTYPE-ERROR if column dtypes are unsupported or inconsistent
*/
static Tensor Tensor::fromColumns(list<auto> columns, *string dtype) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    ReferenceHolder<QoreTensor> holder(QoreTensor::fromColumns(columns, dtype, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return qore_ml_tensor_to_object(holder.release(), getProgram(), xsink);
}

//! Concatenates row-major Tensors along the first dimension
/** @param tensors list of tensors with the same dtype, rank, and all dimensions
        after the first dimension equal

    @return a Tensor with all rows from \a tensors appended in list order

    This method is intended for building ONNX mini-batches from already-dense
    tensor batches without converting through nested Qore lists.

    @throw ML-TENSOR-ERROR if \a tensors is empty or contains non-Tensor values
    @throw ML-TENSOR-SHAPE-ERROR if ranks or trailing dimensions differ
    @throw ML-TENSOR-DTYPE-ERROR if tensor dtypes differ
*/
static Tensor Tensor::concatRows(list<Tensor> tensors) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    ReferenceHolder<QoreTensor> holder(QoreTensor::concatRows(tensors, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return qore_ml_tensor_to_object(holder.release(), getProgram(), xsink);
}

//! Creates a Tensor view with a different shape
/** @param shape new tensor shape; the element count must match the current tensor

    @return a Tensor that shares the same dense backing buffer

    @throw ML-TENSOR-SHAPE-ERROR if \a shape does not match the element count
*/
Tensor Tensor::reshape(list<int> shape) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    ReferenceHolder<QoreTensor> holder(tensor->reshape(shape, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return qore_ml_tensor_to_object(holder.release(), getProgram(), xsink);
}

//! Returns a contiguous slice of rows along the first dimension
/** @param offset first row to include
    @param count number of rows to include
    @param zero_copy when True, return a view over the existing backing buffer;
        when False, copy the selected row range into a new buffer

    @return a Tensor with the same rank and trailing dimensions and \a count
        rows in the first dimension

    @throw ML-TENSOR-SHAPE-ERROR if the tensor is scalar or the requested range
        is outside the tensor's first dimension
*/
Tensor Tensor::sliceRows(int offset, int count, bool zero_copy = True) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    ReferenceHolder<QoreTensor> holder(tensor->sliceRows(offset, count, zero_copy, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return qore_ml_tensor_to_object(holder.release(), getProgram(), xsink);
}

//! Returns the tensor dtype
/** @return dtype name such as \c float32, \c float64, \c int64, or \c bool
*/
string Tensor::getDtype() [flags=CONSTANT] {
    return new QoreStringNode(qore_buffer_element_type_name(tensor->getElementType()));
}

//! Returns the tensor shape
/** @return list of dimension sizes
*/
list<int> Tensor::getShape() [flags=CONSTANT] {
    return tensor->getShapeList(xsink);
}

//! Returns the number of tensor dimensions
/** @return tensor rank
*/
int Tensor::rank() [flags=CONSTANT] {
    return tensor->getRank();
}

//! Returns the number of elements in the tensor
/** @return element count
*/
int Tensor::size() [flags=CONSTANT] {
    return static_cast<int64_t>(tensor->getElementCount());
}

//! Returns the dense backing buffer
/** @return a \c buffer<T> containing the flat tensor data
*/
auto Tensor::getBuffer() [flags=RET_VALUE_ONLY] {
    return tensor->refBuffer();
}

//! Converts the tensor to nested Qore lists using its shape
/** @return nested list representation of the tensor data
*/
auto Tensor::toList() [flags=RET_VALUE_ONLY] {
    return tensor->toList(xsink);
}
