#include "qore/Qore.h"
#include "QC_PCA.h"

extern const TypedHashDecl* hashdeclPCAResult;

//! The PCA class implements Principal Component Analysis for dimensionality reduction
/** PCA computes principal components via eigendecomposition of the covariance matrix,
    allowing projection of data onto the most important directions of variance.

    @par Example:
    @code{.py}
PCA pca({"n_components": 2});
pca.fitMatrix(training_data);
hash<PCAResult> result = pca.transform({"x": 1.0, "y": 2.0, "z": 3.0});
    @endcode

*/
qclass PCA [arg=QorePCA* pca; ns=Qore::ML; flags=final];

//! Creates a PCA instance with the given options
/** @param options a hash with the following optional keys:
    - \c n_components (int, default 0 = all): number of components to keep
    - \c variance_threshold (float, default 0.0): keep components explaining >= this ratio (0-1)
    - \c center (bool, default True): subtract mean before PCA
    - \c scale (bool, default False): scale to unit variance before PCA

    @throw ML-PCA-ERROR invalid option values
*/
PCA::constructor(*hash<auto> options) {
    int64 n_components = 0;
    double variance_threshold = 0.0;
    bool center = true;
    bool scale = false;

    if (options) {
        QoreValue v;
        v = options->getKeyValue("n_components");
        if (!v.isNullOrNothing()) {
            n_components = v.getAsBigInt();
        }
        v = options->getKeyValue("variance_threshold");
        if (!v.isNullOrNothing()) {
            variance_threshold = v.getAsFloat();
        }
        v = options->getKeyValue("center");
        if (!v.isNullOrNothing()) {
            center = v.getAsBool();
        }
        v = options->getKeyValue("scale");
        if (!v.isNullOrNothing()) {
            scale = v.getAsBool();
        }
    }

    self->setPrivate(CID_PCA,
        new QorePCA(static_cast<int>(n_components), variance_threshold, center, scale));
}

//! Creates a copy of the PCA instance
/** @throw COPY-ERROR PCA objects cannot be copied
*/
PCA::copy() {
    xsink->raiseException("COPY-ERROR", "PCA objects cannot be copied");
}

//! Fits the model on a list of hash records
/** @param data a list of hashes with numeric fields

    @par Example:
    @code{.py}
pca.fit(data_records);
    @endcode

    @throw ML-PCA-ERROR fitting failed
    @throw ML-DATA-ERROR data format errors
*/
nothing PCA::fit(list<auto> data) {
    std::vector<std::string> field_names;
    MatrixXd matrix = qoreListOfHashesToMatrix(data, field_names, xsink);
    if (*xsink) {
        return QoreValue();
    }
    pca->setFieldNames(field_names);
    pca->fitInternal(matrix, xsink);
}

//! Fits the model on a numeric matrix
/** @param matrix a list of lists of numeric values

    @throw ML-PCA-ERROR fitting failed
    @throw ML-DATA-ERROR data format errors
*/
nothing PCA::fitMatrix(list<auto> matrix) {
    MatrixXd mat = qoreListOfListsToMatrix(matrix, xsink);
    if (*xsink) {
        return QoreValue();
    }
    pca->fitInternal(mat, xsink);
}

//! Transforms a single record using the fitted model
/** @param record a hash with numeric fields
    @return a @ref PCAResult hash

    @par Example:
    @code{.py}
hash<PCAResult> result = pca.transform(record);
printf("Components: %y\n", result.components);
    @endcode

    @throw ML-PCA-ERROR model not fitted or dimension mismatch
*/
hash<PCAResult> PCA::transform(hash<auto> record) {
    const std::vector<std::string>& field_names = pca->getFieldNames();
    if (field_names.empty()) {
        xsink->raiseException("ML-PCA-ERROR",
            "model was fitted with fitMatrix(); use transformMatrix() or fit() with hash records");
        return QoreValue();
    }
    RowVectorXd point = qoreHashToRowVector(record, field_names, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return pca->transformInternal(point, xsink);
}

//! Transforms multiple rows in matrix form
/** @param matrix a list of lists of numeric values
    @return a list of @ref PCAResult hashes

    @throw ML-PCA-ERROR model not fitted or dimension mismatch
    @throw ML-DATA-ERROR data format errors
*/
list<hash<PCAResult>> PCA::transformMatrix(list<auto> matrix) {
    MatrixXd mat = qoreListOfListsToMatrix(matrix, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return pca->transformMatrix(mat, xsink);
}

//! Fits the model and transforms data in one step
/** @param data a list of hashes with numeric fields
    @return a list of @ref PCAResult hashes

    @throw ML-PCA-ERROR fitting or transformation failed
    @throw ML-DATA-ERROR data format errors
*/
list<hash<PCAResult>> PCA::fitTransform(list<auto> data) {
    std::vector<std::string> field_names;
    MatrixXd matrix = qoreListOfHashesToMatrix(data, field_names, xsink);
    if (*xsink) {
        return QoreValue();
    }
    pca->setFieldNames(field_names);
    return pca->fitTransformInternal(matrix, xsink);
}

//! Fits the model and transforms a numeric matrix in one step
/** @param matrix a list of lists of numeric values
    @return a list of @ref PCAResult hashes

    @throw ML-PCA-ERROR fitting or transformation failed
    @throw ML-DATA-ERROR data format errors
*/
list<hash<PCAResult>> PCA::fitTransformMatrix(list<auto> matrix) {
    MatrixXd mat = qoreListOfListsToMatrix(matrix, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return pca->fitTransformInternal(mat, xsink);
}

//! Returns True if the model has been fitted
/** @return True if fit() or fitMatrix() has been called successfully
*/
bool PCA::isFitted() [flags=CONSTANT] {
    return pca->isFitted();
}

//! Returns the number of components kept after fitting
/** @return the number of principal components

    @throw ML-PCA-ERROR model not fitted
*/
int PCA::getNumComponents() {
    if (!pca->isFitted()) {
        xsink->raiseException("ML-PCA-ERROR",
            "model has not been fitted: call fit() or fitMatrix() first");
        return QoreValue();
    }
    return pca->getNumComponents();
}

//! Returns the principal component vectors
/** @return a list of lists of float values (n_components x n_features)

    @throw ML-PCA-ERROR model not fitted
*/
list<auto> PCA::getComponents() {
    return pca->getComponents(xsink);
}

//! Returns the explained variance ratio per component
/** @return a list of float values

    @throw ML-PCA-ERROR model not fitted
*/
list<auto> PCA::getExplainedVarianceRatio() {
    return pca->getExplainedVarianceRatio(xsink);
}

//! Returns the mean vector used for centering
/** @return a list of float values

    @throw ML-PCA-ERROR model not fitted
*/
list<auto> PCA::getMean() {
    return pca->getMean(xsink);
}

//! Returns the standard deviation vector used for scaling
/** @return a list of float values, one per feature

    @throw ML-PCA-ERROR if the model has not been fitted
*/
list<float> PCA::getStddev() {
    return pca->getStddev(xsink);
}
