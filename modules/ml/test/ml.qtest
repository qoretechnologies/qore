    onnxBackwardCompatTest() {
        if (skipOnnx()) {
            return;
        }

        # Original single-arg constructor should still work with auto-detected provider
        ML::OnnxModel model(getTestModelPath());
        assertTrue(model.isLoaded());
        list<string> providers = ML::ml_get_onnx_providers();
        assertTrue(providers.contains(model.getProviderInfo()),
            sprintf("provider %y should be in available providers %y",
                model.getProviderInfo(), providers));

        # Inference should still work
        hash<auto> result = model.run({"X": ((2.0,),)});
        assertFloat(5.0, result.Y[0], 1e-5);

        # getModelInfo should have active_provider matching available providers
        hash<ML::OnnxModelInfo> info = model.getModelInfo();
        assertTrue(providers.contains(info.active_provider),
            sprintf("active_provider %y should be in available providers %y",
                info.active_provider, providers));
    }

