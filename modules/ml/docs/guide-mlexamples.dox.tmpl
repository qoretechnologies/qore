    @section mlexample_iforest Fraud Detection with IsolationForest

    @code{.py}
%requires ml

# Train on 30 days of legitimate transactions
Qore::ML::IsolationForest fraud_detector({"n_trees": 100, "sample_size": 256, "threshold": 0.6});
fraud_detector.fit(legitimate_transactions);

# Score an incoming transaction: {amount: 49500.0, hour: 3, merchant_category: 12}
hash<Qore::ML::IsolationForestResult> result = fraud_detector.score(transaction);
if (result.is_anomaly) {
    printf("Suspicious transaction! Score: %f\n", result.anomaly_score);
