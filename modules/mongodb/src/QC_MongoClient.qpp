#include "qore/Qore.h"
#include "QC_MongoClient.h"
#include "QC_MongoDatabase.h"

//! The MongoClient class provides MongoDB client connection management
/** This class wraps a MongoDB client connection and provides methods for
    database access and server management operations.

    @par Example:
    @code{.py}
# Connect to MongoDB
MongoClient client("mongodb://localhost:27017");

# Ping the server
if (client.ping()) {
    print("Connected successfully\n");
}

# List databases
list<string> dbs = client.listDatabaseNames();

# Get a database handle
MongoDatabase db = client.getDatabase("mydb");
    @endcode

    @since mongodb 1.0
*/
qclass MongoClient [arg=QoreMongoClient* client; ns=mongodb; flags=final];

//! Creates a MongoDB client connection from a URI string
/** @param uri the MongoDB connection URI (e.g., "mongodb://localhost:27017")

    @par Example:
    @code{.py}
# Simple connection
MongoClient client("mongodb://localhost:27017");

# Connection with authentication
MongoClient client("mongodb://user:password@localhost:27017/mydb?authSource=admin");

# Replica set connection
MongoClient client("mongodb://host1:27017,host2:27017/?replicaSet=rs0");
    @endcode

    @throw MONGODB-CLIENT-ERROR failed to parse URI or create client
    @throw INVALID-ENCODING the URI is not valid text in its encoding (it is converted to UTF-8 for the driver)
    @throw FILESYSTEM-ACCESS-DENIED the sandbox of the calling program does not allow a file named by the
    \c tlsCAFile or \c tlsCertificateKeyFile option of the URI to be read
    @throw SANDBOX-PATH-ERROR the sandbox of the calling program cannot resolve the path of such a file

    @note The files named by the \c tlsCAFile and \c tlsCertificateKeyFile options are read when the client is
    created and for each connection, on behalf of the calling program, so its filesystem sandbox applies each time; a
    connection of sandboxed code with a file the sandbox does not allow fails with a \c MONGODB-CLIENT-ERROR (or
    another operation error) whose description contains \c FILESYSTEM-ACCESS-DENIED
*/
MongoClient::constructor(string uri) {
    // the driver takes UTF-8 text
    TempEncodingHelper utf8_uri;
    if (mongo_utf8_arg(*uri, utf8_uri, "MongoClient::constructor()", "MongoDB URI", xsink)) {
        return;
    }
    // the URI is parsed as a C string, which would be cut at a NUL character; it is not shown, as it can contain a
    // password
    if (q_check_no_nul(utf8_uri->c_str(), utf8_uri->size())) {
        xsink->raiseExceptionArg("MONGODB-CLIENT-ERROR", EINVAL, new QoreStringNode("the MongoDB URI contains a NUL "
            "character; URIs cannot contain NUL characters"));
        return;
    }
    SimpleRefHolder<QoreMongoClient> holder(new QoreMongoClient(utf8_uri->c_str(), xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_MONGOCLIENT, holder.release());
}

//! Pings the MongoDB server to verify connectivity
/** @return True if the ping succeeded

    @par Example:
    @code{.py}
if (client.ping()) {
    print("Server is reachable\n");
}
    @endcode

    @throw MONGODB-CLIENT-ERROR ping failed
*/
bool MongoClient::ping() {
    return client->ping(xsink);
}

//! Returns a list of database names on the server
/** @return a list of database names

    @par Example:
    @code{.py}
list<string> dbs = client.listDatabaseNames();
foreach string db in (dbs) {
    printf("Database: %s\n", db);
}
    @endcode

    @throw MONGODB-CLIENT-ERROR failed to list databases
    @throw INVALID-ENCODING a database name from the server is not valid UTF-8; the names are tagged UTF-8
*/
list<string> MongoClient::listDatabaseNames() {
    return client->listDatabaseNames(xsink);
}

//! Returns a MongoDatabase object for the given database name
/** @param name the database name
    @return a MongoDatabase object

    @par Example:
    @code{.py}
MongoDatabase db = client.getDatabase("mydb");
    @endcode

    @throw INVALID-ENCODING the name is not valid text in its encoding (it is converted to UTF-8 for the driver)
*/
MongoDatabase MongoClient::getDatabase(string name) {
    // the driver takes UTF-8 text
    TempEncodingHelper utf8_name;
    if (mongo_utf8_arg(*name, utf8_name, "MongoClient::getDatabase()", "database name", xsink)) {
        return QoreValue();
    }
    // the name is passed to the driver as a C string, which would be cut at a NUL character
    if (q_check_no_nul(utf8_name->c_str(), utf8_name->size(), "database name", "database names",
            "MONGODB-CLIENT-ERROR", xsink)) {
        return QoreValue();
    }
    mongoc_database_t* db = client->getDatabase(utf8_name->c_str());
    if (!db) {
        // the name is added to the message with its encoding
        QoreStringNodeHolder desc(new QoreStringNode("failed to get database '"));
        desc->concat(name, xsink);
        desc->concat('\'');
        xsink->raiseException("MONGODB-CLIENT-ERROR", desc.release());
        return QoreValue();
    }
    return new QoreObject(QC_MONGODATABASE, getProgram(), new QoreMongoDatabase(db, client->refSelf()));
}

//! Returns the connection URI string
/** @return the MongoDB connection URI

    @par Example:
    @code{.py}
string uri = client.getUri();
    @endcode
*/
*string MongoClient::getUri() [flags=CONSTANT] {
    return client->getUri();
}
