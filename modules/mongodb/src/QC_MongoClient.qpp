#include "qore/Qore.h"
#include "QC_MongoClient.h"
#include "QC_MongoDatabase.h"

//! The MongoClient class provides MongoDB client connection management
/** This class wraps a MongoDB client connection and provides methods for
    database access and server management operations.

    @par Example:
    @code{.py}
# Connect to MongoDB
MongoClient client("mongodb://localhost:27017");

# Ping the server
if (client.ping()) {
    print("Connected successfully\n");
}

# List databases
list<string> dbs = client.listDatabaseNames();

# Get a database handle
MongoDatabase db = client.getDatabase("mydb");
    @endcode

    @since mongodb 1.0
*/
qclass MongoClient [arg=QoreMongoClient* client; ns=mongodb; flags=final];

//! Creates a MongoDB client connection from a URI string
/** @param uri the MongoDB connection URI (e.g., "mongodb://localhost:27017")

    @par Example:
    @code{.py}
# Simple connection
MongoClient client("mongodb://localhost:27017");

# Connection with authentication
MongoClient client("mongodb://user:password@localhost:27017/mydb?authSource=admin");

# Replica set connection
MongoClient client("mongodb://host1:27017,host2:27017/?replicaSet=rs0");
    @endcode

    @throw MONGODB-CLIENT-ERROR failed to parse URI or create client
*/
MongoClient::constructor(string uri) {
    SimpleRefHolder<QoreMongoClient> holder(new QoreMongoClient(uri->c_str(), xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_MONGOCLIENT, holder.release());
}

//! Pings the MongoDB server to verify connectivity
/** @return True if the ping succeeded

    @par Example:
    @code{.py}
if (client.ping()) {
    print("Server is reachable\n");
}
    @endcode

    @throw MONGODB-CLIENT-ERROR ping failed
*/
bool MongoClient::ping() {
    return client->ping(xsink);
}

//! Returns a list of database names on the server
/** @return a list of database names

    @par Example:
    @code{.py}
list<string> dbs = client.listDatabaseNames();
foreach string db in (dbs) {
    printf("Database: %s\n", db);
}
    @endcode

    @throw MONGODB-CLIENT-ERROR failed to list databases
*/
list<string> MongoClient::listDatabaseNames() {
    return client->listDatabaseNames(xsink);
}

//! Returns a MongoDatabase object for the given database name
/** @param name the database name
    @return a MongoDatabase object

    @par Example:
    @code{.py}
MongoDatabase db = client.getDatabase("mydb");
    @endcode
*/
MongoDatabase MongoClient::getDatabase(string name) {
    mongoc_database_t* db = client->getDatabase(name->c_str());
    if (!db) {
        xsink->raiseException("MONGODB-CLIENT-ERROR", "failed to get database '%s'", name->c_str());
        return QoreValue();
    }
    return new QoreObject(QC_MONGODATABASE, getProgram(), new QoreMongoDatabase(db, client->refSelf()));
}

//! Returns the connection URI string
/** @return the MongoDB connection URI

    @par Example:
    @code{.py}
string uri = client.getUri();
    @endcode
*/
*string MongoClient::getUri() [flags=CONSTANT] {
    return client->getUri();
}
