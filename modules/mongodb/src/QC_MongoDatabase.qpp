#include "qore/Qore.h"
#include "QC_MongoDatabase.h"
#include "QC_MongoCollection.h"

//! The MongoDatabase class provides MongoDB database operations
/** This class represents a MongoDB database and provides methods for
    collection management and database-level operations.

    @par Example:
    @code{.py}
# Get a database from a client
MongoDatabase db = client.getDatabase("mydb");

# List collections
list<string> colls = db.listCollectionNames();

# Get a collection
MongoCollection coll = db.getCollection("users");

# Run a command
hash<auto> result = db.runCommand({"ping": 1});
    @endcode

    @since mongodb 1.0
*/
qclass MongoDatabase [arg=QoreMongoDatabase* database; ns=mongodb; flags=final];

//! Returns the name of this database
/** @return the database name

    @par Example:
    @code{.py}
string name = db.getName();
    @endcode
*/
*string MongoDatabase::getName() [flags=CONSTANT] {
    return database->getName();
}

//! Returns a list of collection names in this database
/** @return a list of collection names

    @par Example:
    @code{.py}
list<string> colls = db.listCollectionNames();
foreach string coll in (colls) {
    printf("Collection: %s\n", coll);
}
    @endcode

    @throw MONGODB-DATABASE-ERROR failed to list collections
*/
list<string> MongoDatabase::listCollectionNames() {
    return database->listCollectionNames(xsink);
}

//! Returns a MongoCollection object for the given collection name
/** @param name the collection name
    @return a MongoCollection object

    @par Example:
    @code{.py}
MongoCollection coll = db.getCollection("users");
    @endcode
*/
MongoCollection MongoDatabase::getCollection(string name) {
    mongoc_collection_t* coll = database->getCollection(name->c_str());
    if (!coll) {
        xsink->raiseException("MONGODB-DATABASE-ERROR", "failed to get collection '%s'", name->c_str());
        return QoreValue();
    }
    return new QoreObject(QC_MONGOCOLLECTION, getProgram(),
        new QoreMongoCollection(coll, database->getClient()->refSelf()));
}

//! Creates a new collection in this database
/** @param name the collection name
    @return a MongoCollection object for the new collection

    @par Example:
    @code{.py}
MongoCollection coll = db.createCollection("newcollection");
    @endcode

    @throw MONGODB-DATABASE-ERROR failed to create collection
*/
MongoCollection MongoDatabase::createCollection(string name) {
    mongoc_collection_t* coll = database->createCollection(name->c_str(), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_MONGOCOLLECTION, getProgram(),
        new QoreMongoCollection(coll, database->getClient()->refSelf()));
}

//! Drops this database
/** @return True if the database was dropped successfully

    @par Example:
    @code{.py}
if (db.drop()) {
    print("Database dropped\n");
}
    @endcode

    @throw MONGODB-DATABASE-ERROR failed to drop database
*/
bool MongoDatabase::drop() {
    return database->drop(xsink);
}

//! Runs a command on this database
/** @param command the command document
    @return the command result

    @par Example:
    @code{.py}
hash<auto> result = db.runCommand({"ping": 1});
hash<auto> stats = db.runCommand({"dbStats": 1});
    @endcode

    @throw MONGODB-DATABASE-ERROR command failed
*/
hash<auto> MongoDatabase::runCommand(hash<auto> command) {
    return database->runCommand(command, xsink);
}
