#include "qore/Qore.h"
#include "QC_ObjectId.h"

//! The ObjectId class represents a MongoDB ObjectId
/** MongoDB ObjectIds are 12-byte identifiers typically used as the default value for the @c _id field
    in MongoDB documents. They consist of:
    - 4 bytes representing seconds since Unix epoch
    - 5 bytes of random value
    - 3 bytes of incrementing counter

    @par Example:
    @code{.py}
# Create a new ObjectId
ObjectId oid();
printf("New ObjectId: %s\n", oid.toString());

# Create from hex string
ObjectId oid2("507f1f77bcf86cd799439011");

# Get timestamp
date dt = oid.getTimestamp();
    @endcode

    @since mongodb 1.0
*/
qclass ObjectId [arg=QoreObjectId* oid; ns=mongodb; flags=final];

//! Creates a new ObjectId with a generated value
/** @par Example:
    @code{.py}
ObjectId oid();
    @endcode
*/
ObjectId::constructor() {
    self->setPrivate(CID_OBJECTID, new QoreObjectId());
}

//! Creates an ObjectId from a 24-character hex string
/** @param hex_string the 24-character hexadecimal string representation of the ObjectId

    @par Example:
    @code{.py}
ObjectId oid("507f1f77bcf86cd799439011");
    @endcode

    @throw MONGODB-OBJECTID-ERROR the hex string is not a valid ObjectId
*/
ObjectId::constructor(string hex_string) {
    SimpleRefHolder<QoreObjectId> holder(new QoreObjectId(hex_string->c_str(), xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_OBJECTID, holder.release());
}

//! Creates a copy of the ObjectId
/** @par Example:
    @code{.py}
ObjectId oid2 = oid.copy();
    @endcode
*/
ObjectId::copy() {
    self->setPrivate(CID_OBJECTID, new QoreObjectId(*oid->getOid()));
}

//! Returns the ObjectId as a 24-character hexadecimal string
/** @return the hexadecimal string representation

    @par Example:
    @code{.py}
string str = oid.toString();
    @endcode
*/
string ObjectId::toString() [flags=CONSTANT] {
    return oid->toString();
}

//! Returns the timestamp portion of the ObjectId as a date/time value
/** @return the timestamp when the ObjectId was created

    @par Example:
    @code{.py}
date dt = oid.getTimestamp();
    @endcode
*/
date ObjectId::getTimestamp() [flags=CONSTANT] {
    return DateTimeNode::makeAbsolute(currentTZ(), oid->getTimestamp(), 0);
}

//! Compares this ObjectId to another
/** @param other the ObjectId to compare to
    @return -1 if this ObjectId is less than @a other, 0 if equal, 1 if greater

    @par Example:
    @code{.py}
int cmp = oid1.compare(oid2);
    @endcode
*/
int ObjectId::compare(ObjectId[QoreObjectId] other) [flags=CONSTANT] {
    ReferenceHolder<QoreObjectId> holder(other, xsink);
    return oid->compare(other);
}

//! Checks if this ObjectId equals another
/** @param other the ObjectId to compare to
    @return True if the ObjectIds are equal

    @par Example:
    @code{.py}
if (oid1.equals(oid2)) {
    print("Same ObjectId\n");
}
    @endcode
*/
bool ObjectId::equals(ObjectId[QoreObjectId] other) [flags=CONSTANT] {
    ReferenceHolder<QoreObjectId> holder(other, xsink);
    return oid->equals(other);
}

//! Returns a hash code for this ObjectId
/** @return the hash code

    @par Example:
    @code{.py}
int h = oid.hashCode();
    @endcode
*/
int ObjectId::hashCode() [flags=CONSTANT] {
    return oid->hashCode();
}
