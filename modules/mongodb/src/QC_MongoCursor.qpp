#include "qore/Qore.h"
#include "QC_MongoCursor.h"

//! The MongoCursor class provides iteration over MongoDB query results
/** This class is returned by find() and aggregate() operations and allows
    iterating over the result documents one at a time.

    @par Example:
    @code{.py}
# Iterate using next()
MongoCursor cursor = coll.find({"status": "active"});
while (*hash<auto> doc = cursor.next()) {
    printf("Document: %y\n", doc);
}

# Get all results as a list
MongoCursor cursor = coll.find();
list<hash<auto>> docs = cursor.toList();
    @endcode

    @since mongodb 1.0
*/
qclass MongoCursor [arg=QoreMongoCursor* cursor; ns=mongodb; flags=final];

//! Returns the next document from the cursor
/** @return the next document, or @ref nothing if no more documents

    @par Example:
    @code{.py}
while (*hash<auto> doc = cursor.next()) {
    printf("Document: %y\n", doc);
}
    @endcode

    @throw MONGODB-CURSOR-ERROR cursor error
*/
*hash<auto> MongoCursor::next() {
    return cursor->next(xsink);
}

//! Checks if there are more documents available
/** @return True if there are more documents

    @par Example:
    @code{.py}
while (cursor.more()) {
    hash<auto> doc = cursor.next();
    // process doc
}
    @endcode

    @note This method may not be 100% accurate for all cursor types.
    It's generally better to use next() and check for @ref nothing.
*/
bool MongoCursor::more() {
    return cursor->more(xsink);
}

//! Returns all remaining documents as a list
/** @return a list of all remaining documents

    @par Example:
    @code{.py}
list<hash<auto>> docs = cursor.toList();
foreach hash<auto> doc in (docs) {
    printf("Document: %y\n", doc);
}
    @endcode

    @throw MONGODB-CURSOR-ERROR cursor error

    @note This method exhausts the cursor. After calling toList(),
    subsequent calls to next() will return @ref nothing.
*/
list<hash<auto>> MongoCursor::toList() {
    return cursor->toList(xsink);
}

//! Closes the cursor and releases resources
/** @par Example:
    @code{.py}
cursor.close();
    @endcode

    @note Cursors are automatically closed when garbage collected,
    but calling close() explicitly is recommended for long-lived
    cursor objects.
*/
nothing MongoCursor::close() {
    cursor->close();
}
