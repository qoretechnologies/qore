#include <qore_reflection.h>
#include "QC_DestructorMethod.h"
#include "QC_Class.h"

//! This class provides information about %Qore destructor methods
/**
    @see @ref Qore::Reflection::DestructorMethodVariant "DestructorMethodVariant"

    @since %Qore 0.9.0
 */
qclass DestructorMethod [ns=Qore::Reflection; arg=QoreReflectionMethod* m; vparent=AbstractMethod; dom=REFLECTION];

//! Creates the object from the class if the class implements a destructor method
/** @par Example:
    @code{.py}
DestructorMethod m(cls);
    @endcode

    @param cls the class for the method

    @throw UNKOWN-METHOD cannot find a destructor method for the class
 */
DestructorMethod::constructor(Class[QoreReflectionClass] cls) {
    // get exclusive access to program object
    QoreExternalProgramContextHelper pch(xsink, cls->pgm);
    if (*xsink) {
        return;
    }

    // the class pointer must be valid here
    ReferenceHolder<QoreReflectionMethod> m(new QoreReflectionMethod(cls->cls, "destructor", xsink), xsink);
    if (*xsink) {
        return;
    }

    assert(m->mtype == MT_Destructor);

    self->setPrivate(CID_DESTRUCTORMETHOD, m.release());
}

//! Creates the object from the class name or namespace path if the class implements a destructor method
/** @par Example:
    @code{.py}
DestructorMethod m("Thread::Mutex");
    @endcode

    @param class_name the class name or namespace path for the class

    @throw UNKNOWN-CLASS cannot find a class with the given name or path, or the class name contains a NUL character (since %Qore 3.0)
    @throw UNKOWN-METHOD cannot find a destructor method for the class
 */
DestructorMethod::constructor(string class_name) {
    // the name is looked up as a C string, which would be cut at a NUL character and name another class
    if (q_check_no_nul(class_name->c_str(), class_name->size(), "class name", "class names", "UNKNOWN-CLASS", xsink)) {
        return;
    }
    TempEncodingHelper npath(class_name, QCS_DEFAULT, xsink);
    if (*xsink) {
        return;
    }

    ReferenceHolder<QoreReflectionMethod> m(new QoreReflectionMethod(npath->c_str(), "destructor", xsink), xsink);
    if (*xsink) {
        return;
    }

    assert(m->mtype == MT_Destructor);

    self->setPrivate(CID_DESTRUCTORMETHOD, m.release());
}

//! calls the destructor on given object; destroys the object
/** @par Example:
    @code{.py}
m.call(obj);
    @endcode

    @param obj the object to destroy

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the class and method has been destroyed
    @throw METHOD-ERROR the object was not instantiated from the class implementing this method
    @throw INVALID-FUNCTION-ACCESS the calling code's or the class's Program's sandboxing restrictions do not allow the class (see @ref reflection_caller_privilege)
*/
auto DestructorMethod::call(object obj) {
    // the privileges of the calling code, captured before switching to the class's Program
    QoreReflectionCaller caller;
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    // we have to explictly test object compatibility here
    if (check_call(obj, *m->m, xsink)) {
        return QoreValue();
    }

    // the class must be allowed by the caller and the class's Program
    if (reflection_check_class_call(caller, m->m->getClass(), m->pgm, false, xsink)) {
        return QoreValue();
    }

    obj->doDelete(xsink);
}
