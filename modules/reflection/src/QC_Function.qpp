#include <qore/intern/LexicalReflection.h>
#include "qore_reflection.h"
#include "QC_Function.h"
#include "QC_FunctionVariant.h"
#include "QC_AbstractVariant.h"
#include "QC_Type.h"

static QoreReflectionFunction* get_function(ExceptionSink* xsink, const ReflectionLookupCaller& caller,
        const QoreString& path, QoreProgram* pgm) {
    TempEncodingHelper npath(path, QCS_DEFAULT, xsink);
    if (*xsink) {
        return nullptr;
    }

    const QoreNamespace* ns;
    const QoreExternalFunction* f = pgm->findFunction(npath->c_str(), ns);
    // a function that a module does not export is not found by a caller its export boundary applies to
    if (!f || !caller.canSeeDeclaration(pgm, ns, reflection_exported(f))) {
        xsink->raiseException("UNKNOWN-FUNCTION", "cannot find function '%s'", npath->c_str());
        return nullptr;
    }

    return new QoreReflectionFunction(pgm, f, ns);
}

static QoreObject* get_function_object(ExceptionSink* xsink, const ReflectionLookupCaller& caller,
        const QoreString& path, QoreProgram* pgm) {
    QoreReflectionFunction* f = get_function(xsink, caller, path, pgm);
    if (!f) {
        assert(*xsink);
        return nullptr;
    }

    return new QoreObject(QC_FUNCTION, pgm, f);
}

// Refuses a handle of a function that a user module does not export, for a caller its export boundary applies to:
// as a call through the handle is refused (QoreExternalFunction::evalFunction()), so are its variants, so a handle
// that the module created and handed out does not reveal them; returns 0 if allowed, -1 if REFLECTION-ACCESS-ERROR
// was raised
static int check_function_handle_export(const QoreReflectionCaller& caller, const QoreReflectionFunction* f,
        ExceptionSink* xsink) {
    return caller.checkModuleExport(caller.canSeeDeclaration(f->pgm, f->ns, reflection_exported(f->f)), "function",
        f->f->getName(), xsink);
}

static QoreValue find_all_funcs(const ReflectionLookupCaller& caller, const QoreString& pattern, int re_opts,
        QoreProgram* pgm, ExceptionSink* xsink) {
    func_ns_vec_t func_vec = pgm->findAllFunctionsRegexNs(pattern, re_opts, xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> l(new QoreListNode(QC_FUNCTION->getTypeInfo()), xsink);
    for (auto& i : func_vec) {
        // a function that a module does not export is not found by a caller its export boundary applies to
        if (!caller.canSeeDeclaration(pgm, i.second, reflection_exported(i.first))) {
            continue;
        }
        l->push(new QoreObject(QC_FUNCTION, pgm, new QoreReflectionFunction(pgm, i.first, i.second)), xsink);
    }

    return l.release();
}

// Both entries share the reflection authority checks; only the final invocation differs.
template <bool Lexical>
static QORE_LEXICAL_REFLECTION_INLINE QoreValue Function_call_VV_impl(LexicalSemanticPolicy policy, QoreObject* self, QoreReflectionFunction* f, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink) {
    // the privileges of the calling code, captured before switching to the function's Program
    QoreReflectionCaller caller;
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, f->pgm);
    if (*xsink) {
        return QoreValue();
    }

    // the function ptr must be valid
    if constexpr (Lexical) return qore_lexical_reflection_function(policy, *f->f, nullptr, args, f->pgm, f->ns, caller, xsink);
    else return f->f->evalFunction(nullptr, args, f->pgm, f->ns, caller, xsink);
}

static QoreValue Function_call_VV_lexical(QoreObject* self, QoreReflectionFunction* f, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink) {
    return Function_call_VV_impl<true>(qore_get_native_semantic_policy(), self, f, args, runtime_cfg, xsink);
}

static QoreValue Function_call_VV(QoreObject* self, QoreReflectionFunction* f, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink);

template <bool Lexical>
static QORE_LEXICAL_REFLECTION_INLINE QoreValue Function_callArgs_C15_softlist_auto__impl(LexicalSemanticPolicy policy, QoreObject* self, QoreReflectionFunction* f, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink, const QoreListNode* argv) {
    // the privileges of the calling code, captured before switching to the function's Program
    QoreReflectionCaller caller;
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, f->pgm);
    if (*xsink) {
        return QoreValue();
    }

    // the function ptr must be valid
    if constexpr (Lexical) return qore_lexical_reflection_function(policy, *f->f, nullptr, argv, f->pgm, f->ns, caller, xsink);
    else return f->f->evalFunction(nullptr, argv, f->pgm, f->ns, caller, xsink);
}

static QoreValue Function_callArgs_C15_softlist_auto__lexical(QoreObject* self, QoreReflectionFunction* f, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink) {
    const QoreListNode* argv = get_param_value(args, 0).get<const QoreListNode>();
    return Function_callArgs_C15_softlist_auto__impl<true>(qore_get_native_semantic_policy(), self, f, args, runtime_cfg, xsink, argv);
}

static QoreValue Function_callArgs_C15_softlist_auto_(QoreObject* self, QoreReflectionFunction* f, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink);

static const QoreLexicalMethodRegistrationHelper::Entry lexical_entries_Function[] = {
    {reinterpret_cast<q_method_t>(Function_call_VV), reinterpret_cast<q_method_t>(Function_call_VV_lexical)},
    {reinterpret_cast<q_method_t>(Function_callArgs_C15_softlist_auto_), reinterpret_cast<q_method_t>(Function_callArgs_C15_softlist_auto__lexical)},
};



//! A class representing a %Qore function
/**
    @since %Qore 0.9.0
 */
qclass Function [ns=Qore::Reflection; arg=QoreReflectionFunction* f; vparent=AbstractReflectionFunction; dom=REFLECTION];

//! Creates the function from the name or namespace-justified path supplied as an argument
/** @par Example:
    @code{.py}
Function f("Qore::printf");
    @endcode

    @param path the function name or namespace-justified path as a string

    @throw UNKNOWN-FUNCTION cannot find a function with the given name or path, or the function name contains a NUL character (since %Qore 3.0)
    @throw ENCODING-CONVERSION-ERROR this exception could be thrown if the string argument is not in the @ref default_encoding "default character encoding" and an error occurs during encoding conversion

    @see forName()
 */
Function::constructor(string path) {
    // the name is looked up as a C string, which would be cut at a NUL character and name another function
    if (q_check_no_nul(path->c_str(), path->size(), "function name", "function names", "UNKNOWN-FUNCTION", xsink)) {
        return;
    }
    QoreProgram* lookup_pgm = runtime_cfg.getProgram() ? runtime_cfg.getProgram() : getProgram();
    // the export boundary of a user module applies only to a lookup in another module's Program
    ReflectionLookupCaller caller(lookup_pgm);
    QoreReflectionFunction* f = get_function(xsink, caller, *path, lookup_pgm);
    if (f) {
        self->setPrivate(CID_FUNCTION, f);
    }
}

//! returns the variants implemented by the function
/** @par Example:
    @code{.py}
list<FunctionVariant> l = f.getVariants();
    @endcode

    @return the variants implemented by the function

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the function has been destroyed
*/
list<FunctionVariant> Function::getVariants() [flags=RET_VALUE_ONLY] {
    // the privileges of the calling code, captured before switching to the function's Program
    QoreReflectionCaller caller;
    if (check_function_handle_export(caller, f, xsink)) {
        return QoreValue();
    }
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, f->pgm);
    if (*xsink) {
        return QoreValue();
    }

    // the function ptr must be valid
    ReferenceHolder<QoreListNode> rv(new QoreListNode(QC_FUNCTIONVARIANT->getTypeInfo()), xsink);
    append_variant_objects(**rv, f->pgm, f->f, MT_None, xsink, &caller, f->ns);
    return rv.release();
}

//! Returns the given direct child function variant declared in this function or throws an exception if the function variant is not defined
/** @par Example:
    @code{.py}
FunctionVariant v = n.getVariant(IntType, StringType);
    @endcode

    @param ... type arguments for the variant; types must be compatible for the search to be successful

    @return given function variant or throws an exception if the function variant is not defined in this function

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the function has been destroyed
    @throw VARIANT-MATCH-ERROR thrown if the function variant cannot be matched to the given arguments
    @throw ENCODING-CONVERSION-ERROR this exception could be thrown if the string argument is not in the @ref default_encoding "default character encoding" and an error occurs during encoding conversion

    @see
    - getVariantArgs()
    - getExactVariant()
    - getExactVariantArgs()
*/
FunctionVariant Function::getVariant(...) [flags=RET_VALUE_ONLY] {
    // the privileges of the calling code, captured before switching to the function's Program
    QoreReflectionCaller caller;
    if (check_function_handle_export(caller, f, xsink)) {
        return QoreValue();
    }
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, f->pgm);
    if (*xsink) {
        return QoreValue();
    }

    // the function ptr must be valid
    return find_function_variant(f->pgm, f->f, args, 0, MT_None, xsink, &caller, f->ns);
}

//! Returns the given direct child function variant declared in this function or throws an exception if the function variant is not defined
/** @par Example:
    @code{.py}
FunctionVariant v = n.getVariantArgs((IntType, StringType));
    @endcode

    @param argv type arguments for the variant; types must be compatible for the search to be successful

    @return given function variant or throws an exception if the function variant is not defined in this function

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the function has been destroyed
    @throw VARIANT-MATCH-ERROR thrown if the function variant cannot be matched to the given arguments
    @throw ENCODING-CONVERSION-ERROR this exception could be thrown if the string argument is not in the @ref default_encoding "default character encoding" and an error occurs during encoding conversion

    @see
    - getVariant()
    - getExactVariant()
    - getExactVariantArgs()
*/
FunctionVariant Function::getVariantArgs(softlist<Type> argv) [flags=RET_VALUE_ONLY] {
    // the privileges of the calling code, captured before switching to the function's Program
    QoreReflectionCaller caller;
    if (check_function_handle_export(caller, f, xsink)) {
        return QoreValue();
    }
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, f->pgm);
    if (*xsink) {
        return QoreValue();
    }

    // the function ptr must be valid
    return find_function_variant(f->pgm, f->f, argv, 0, MT_None, xsink, &caller, f->ns);
}

//! calls the function with the given arguments
/** @par Example:
    @code{.py}
auto v = f.call(arg1, arg2);
    @endcode

    @param ... optional arguments to the function

    @return the return value of the function call

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the function has been destroyed
    @throw INVALID-FUNCTION-ACCESS the calling code's or the function's Program's sandboxing restrictions do not allow the variant called (see @ref reflection_caller_privilege)
    @throw REFLECTION-ACCESS-ERROR the calling code may not execute code in the target Program (see @ref reflection_caller_privilege)

    @see callArgs()
*/
auto Function::call(...) {
    return Function_call_VV_impl<false>({}, self, f, args, runtime_cfg, xsink);
}

//! calls the given function with the given arguments as a list
/** @par Example:
    @code{.py}
auto v = f.callArgs(argv);
    @endcode

    @param argv optional arguments to the function

    @return the return value of the function call

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the function has been destroyed
    @throw INVALID-FUNCTION-ACCESS the calling code's or the function's Program's sandboxing restrictions do not allow the variant called (see @ref reflection_caller_privilege)
    @throw REFLECTION-ACCESS-ERROR the calling code may not execute code in the target Program (see @ref reflection_caller_privilege)

    @see call()
*/
auto Function::callArgs(*softlist<auto> argv) {
    return Function_callArgs_C15_softlist_auto__impl<false>({}, self, f, args, runtime_cfg, xsink, argv);
}

//! Returns a %Function object from the function name or namespace-justified path as a string
/** @par Example:
    @code{.py}
Function f = Function::forName("Qore::printf");
    @endcode

    @param path the function name or namespace-justified path as a string

    @return a function object corresponding to the name or namespace-justified path provided as an argument

    @throw UNKNOWN-FUNCTION cannot find a function with the given name or path, or the function name contains a NUL character (since %Qore 3.0)
    @throw ENCODING-CONVERSION-ERROR this exception could be thrown if the string argument is not in the @ref default_encoding "default character encoding" and an error occurs during encoding conversion
 */
static Function Function::forName(string path) [flags=RET_VALUE_ONLY] {
    // the name is looked up as a C string, which would be cut at a NUL character and name another function
    if (q_check_no_nul(path->c_str(), path->size(), "function name", "function names", "UNKNOWN-FUNCTION", xsink)) {
        return QoreValue();
    }
    QoreProgram* lookup_pgm = runtime_cfg.getProgram() ? runtime_cfg.getProgram() : getProgram();
    // the export boundary of a user module applies only to a lookup in another module's Program
    ReflectionLookupCaller caller(lookup_pgm);
    return get_function_object(xsink, caller, *path, lookup_pgm);
}

//! Returns a %Function object from the function name or namespace-justified path as a string
/** @par Example:
    @code{.py}
Function f = Function::forName(pgm, "Qore::printf");
    @endcode

    @param pgm the Program object to search
    @param path the function name or namespace-justified path as a string

    @return a function object corresponding to the name or namespace-justified path provided as an argument

    @throw UNKNOWN-FUNCTION cannot find a function with the given name or path, or the function name contains a NUL character (since %Qore 3.0)
    @throw ENCODING-CONVERSION-ERROR this exception could be thrown if the string argument is not in the @ref default_encoding "default character encoding" and an error occurs during encoding conversion
 */
static Function Function::forName(Program[QoreProgram] pgm, string path) [flags=RET_VALUE_ONLY] {
    // the name is looked up as a C string, which would be cut at a NUL character and name another function
    if (q_check_no_nul(path->c_str(), path->size(), "function name", "function names", "UNKNOWN-FUNCTION", xsink)) {
        return QoreValue();
    }
    // a lookup in another Program is navigation in it
    QoreReflectionCaller caller;
    if (reflection_check_structural_access(caller, *pgm, "look up functions in", xsink)) {
        return QoreValue();
    }
    return get_function_object(xsink, caller, *path, *pgm);
}

//! Returns a list of functions matching the regular expression pattern argument or an empty list if no functions match
/** @par Example:
    @code{.py}
# return all accessible functions that start with the letter "g"
list<Function> l = Function::findAllRegex("^gg");
    @endcode

    @param pattern the regular expression pattern to match
    @param re_opts see @ref regex_constants for possible values

    @return a list of functions matching the regular expression pattern argument or an empty list if no functions match
*/
static list<Function> Function::findAllRegex(string pattern, *int re_opts) [flags=RET_VALUE_ONLY] {
    QoreProgram* lookup_pgm = runtime_cfg.getProgram() ? runtime_cfg.getProgram() : getProgram();
    // the export boundary of a user module applies only to a lookup in another module's Program
    ReflectionLookupCaller caller(lookup_pgm);
    return find_all_funcs(caller, *pattern, re_opts, lookup_pgm, xsink);
}

//! Returns a list of functions matching the regular expression pattern argument or an empty list if no functions match
/** @par Example:
    @code{.py}
# return all accessible functions that start with the letter "g"
list<Function> l = Function::findAllRegex(pgm, "^gg");
    @endcode

    @param pgm the Program object to search
    @param pattern the regular expression pattern to match
    @param re_opts see @ref regex_constants for possible values

    @return a list of functions matching the regular expression pattern argument or an empty list if no functions match
*/
static list<Function> Function::findAllRegex(Program[QoreProgram] pgm, string pattern, *int re_opts) [flags=RET_VALUE_ONLY] {
    // a lookup in another Program is navigation in it
    QoreReflectionCaller caller;
    if (reflection_check_structural_access(caller, *pgm, "look up functions in", xsink)) {
        return QoreValue();
    }
    return find_all_funcs(caller, *pattern, re_opts, *pgm, xsink);
}


//! @qppinit: QoreLexicalMethodRegistrationHelper lexical_registration(lexical_entries_Function);
