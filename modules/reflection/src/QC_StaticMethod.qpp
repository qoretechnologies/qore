#include <qore/intern/LexicalReflection.h>
#include "qore_reflection.h"
#include "QC_StaticMethod.h"
#include "QC_Class.h"

// Both entries share the reflection authority checks; only the final invocation differs.
template <bool Lexical>
static QORE_LEXICAL_REFLECTION_INLINE QoreValue StaticMethod_call_VV_impl(LexicalSemanticPolicy policy, QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink) {
    // the privileges of the calling code, captured before switching to the method's Program
    QoreReflectionCaller caller;
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    // the method's class and the variant selected for the arguments must be allowed by the caller and the
    // method's Program
    if (reflection_check_class_call(caller, m->m->getClass(), m->pgm, false, xsink)) {
        return QoreValue();
    }
    // a class that a user module does not export cannot be used by a caller its export boundary applies to
    if (reflection_check_class_export(caller, m->m->getClass(), m->pgm, xsink)) {
        return QoreValue();
    }
    // the access of the method's variants, for code that a sandbox governs or that is restricted
    if (reflection_check_method_access(caller, m->m, xsink)) {
        return QoreValue();
    }
    QoreReflectionCallCheckHelper call_check(caller, m->pgm);
    // the method ptr must be valid
    if constexpr (Lexical) return qore_lexical_reflection_method(policy, nullptr, *m->m, m->m->getClass(), nullptr, args, xsink);
    else return QoreObject::evalStaticMethod(*m->m, m->m->getClass(), args, xsink);
}

static QoreValue StaticMethod_call_VV_lexical(QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink) {
    return StaticMethod_call_VV_impl<true>(qore_get_native_semantic_policy(), self, m, args, runtime_cfg, xsink);
}

static QoreValue StaticMethod_call_VV(QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink);

template <bool Lexical>
static QORE_LEXICAL_REFLECTION_INLINE QoreValue StaticMethod_callArgs_C15_softlist_auto__impl(LexicalSemanticPolicy policy, QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink, const QoreListNode* argv) {
    // the privileges of the calling code, captured before switching to the method's Program
    QoreReflectionCaller caller;
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    // the method's class and the variant selected for the arguments must be allowed by the caller and the
    // method's Program
    if (reflection_check_class_call(caller, m->m->getClass(), m->pgm, false, xsink)) {
        return QoreValue();
    }
    // a class that a user module does not export cannot be used by a caller its export boundary applies to
    if (reflection_check_class_export(caller, m->m->getClass(), m->pgm, xsink)) {
        return QoreValue();
    }
    // the access of the method's variants, for code that a sandbox governs or that is restricted
    if (reflection_check_method_access(caller, m->m, xsink)) {
        return QoreValue();
    }
    QoreReflectionCallCheckHelper call_check(caller, m->pgm);
    // the method ptr must be valid
    if constexpr (Lexical) return qore_lexical_reflection_method(policy, nullptr, *m->m, m->m->getClass(), nullptr, argv, xsink);
    else return QoreObject::evalStaticMethod(*m->m, m->m->getClass(), argv, xsink);
}

static QoreValue StaticMethod_callArgs_C15_softlist_auto__lexical(QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink) {
    const QoreListNode* argv = get_param_value(args, 0).get<const QoreListNode>();
    return StaticMethod_callArgs_C15_softlist_auto__impl<true>(qore_get_native_semantic_policy(), self, m, args, runtime_cfg, xsink, argv);
}

static QoreValue StaticMethod_callArgs_C15_softlist_auto_(QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink);

static const QoreLexicalMethodRegistrationHelper::Entry lexical_entries_StaticMethod[] = {
    {reinterpret_cast<q_method_t>(StaticMethod_call_VV), reinterpret_cast<q_method_t>(StaticMethod_call_VV_lexical)},
    {reinterpret_cast<q_method_t>(StaticMethod_callArgs_C15_softlist_auto_), reinterpret_cast<q_method_t>(StaticMethod_callArgs_C15_softlist_auto__lexical)},
};



//! This class provides information about %Qore static class methods
/**
    @see @ref Qore::Reflection::StaticMethodVariant "StaticMethodVariant"

    @since %Qore 0.9.0
 */
qclass StaticMethod [ns=Qore::Reflection; arg=QoreReflectionMethod* m; vparent=AbstractMethod; dom=REFLECTION];

//! Creates the object from the class and static method name
/** @par Example:
    @code{.py}
StaticMethod m(cls, name);
    @endcode

    @param cls the class for the method
    @param method the static method name

    @throw UNKOWN-METHOD cannot find a static method with the given name
    @throw UNKNOWN-METHOD the method name contains a NUL character (since %Qore 3.0)
 */
StaticMethod::constructor(Class[QoreReflectionClass] cls, string method) {
    // the name is looked up as a C string, which would be cut at a NUL character and name another method
    if (q_check_no_nul(method->c_str(), method->size(), "method name", "method names", "UNKNOWN-METHOD", xsink)) {
        return;
    }
    TempEncodingHelper nmethod(method, QCS_DEFAULT, xsink);
    if (*xsink) {
        return;
    }

    // get exclusive access to program object
    QoreExternalProgramContextHelper pch(xsink, cls->pgm);
    if (*xsink) {
        return;
    }

    // the class pointer must be valid here
    ReferenceHolder<QoreReflectionMethod> m(new QoreReflectionMethod(cls->cls, nmethod->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }

    if (m->mtype != MT_Static) {
        xsink->raiseException("METHOD-ERROR", "method '%s()' in class '%s' has type '%s'; expecting 'static'", nmethod->c_str(), cls->cls->getName(), m->getType());
        return;
    }

    self->setPrivate(CID_STATICMETHOD, m.release());
}

//! Creates the object from the class name or namespace path and static method name
/** @par Example:
    @code{.py}
StaticMethod m(class_name, method_name);
    @endcode

    @param class_name the class name or namespace path for the method
    @param method the static method name

    @throw UNKNOWN-CLASS cannot find a class with the given name or path, or the class name contains a NUL character (since %Qore 3.0)
    @throw UNKOWN-METHOD cannot find a static method with the given name
    @throw UNKNOWN-METHOD the method name contains a NUL character (since %Qore 3.0)
 */
StaticMethod::constructor(string class_name, string method) {
    // the names are looked up as C strings, which would be cut at a NUL character and name another class or method
    if (q_check_no_nul(class_name->c_str(), class_name->size(), "class name", "class names", "UNKNOWN-CLASS", xsink)
        || q_check_no_nul(method->c_str(), method->size(), "method name", "method names", "UNKNOWN-METHOD", xsink)) {
        return;
    }
    TempEncodingHelper npath(class_name, QCS_DEFAULT, xsink);
    if (*xsink) {
        return;
    }

    TempEncodingHelper nmethod(method, QCS_DEFAULT, xsink);
    if (*xsink) {
        return;
    }

    ReferenceHolder<QoreReflectionMethod> m(new QoreReflectionMethod(npath->c_str(), nmethod->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }

    if (m->mtype != MT_Static) {
        xsink->raiseException("METHOD-ERROR", "method '%s()' in class '%s' has type '%s'; expecting 'static'", nmethod->c_str(), npath->c_str(), m->getType());
        return;
    }

    self->setPrivate(CID_STATICMETHOD, m.release());
}

//! calls the given method with the given arguments
/** @par Example:
    @code{.py}
auto v = m.call(arg1, arg2);
    @endcode

    @param ... optional arguments to the method

    @return the return value of the method call

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the class and method has been destroyed
    @throw INVALID-FUNCTION-ACCESS the calling code's or the method's Program's sandboxing restrictions do not allow the method's class or the variant called (see @ref reflection_caller_privilege)
    @throw REFLECTION-ACCESS-ERROR the calling code may not execute code in the target Program (see @ref reflection_caller_privilege)

    @see callArgs()
*/
auto StaticMethod::call(...) {
    return StaticMethod_call_VV_impl<false>({}, self, m, args, runtime_cfg, xsink);
}

//! calls the given method with the given arguments as a list
/** @par Example:
    @code{.py}
auto v = m.callArgs(argv);
    @endcode

    @param argv optional arguments to the method

    @return the return value of the method call

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the class and method has been destroyed
    @throw INVALID-FUNCTION-ACCESS the calling code's or the method's Program's sandboxing restrictions do not allow the method's class or the variant called (see @ref reflection_caller_privilege)
    @throw REFLECTION-ACCESS-ERROR the calling code may not execute code in the target Program (see @ref reflection_caller_privilege)

    @see call()
*/
auto StaticMethod::callArgs(*softlist<auto> argv) {
    return StaticMethod_callArgs_C15_softlist_auto__impl<false>({}, self, m, args, runtime_cfg, xsink, argv);
}


//! @qppinit: QoreLexicalMethodRegistrationHelper lexical_registration(lexical_entries_StaticMethod);
