#include <qore/intern/LexicalReflection.h>
#include <qore_reflection.h>
#include "QC_PseudoMethod.h"
#include "QC_Class.h"

int check_pseudo_call(QoreValue& val, const QoreMethod& m, ExceptionSink* xsink) {
    const QoreClass* cls = m.getClass();
    assert(cls->isPseudoClass());
    qore_type_t t = cls->getPseudoClassType();
    if (t == -1 || t == val.getType()) {
        return 0;
    }
    xsink->raiseException("METHOD-ERROR", "value has type '%s' which is not compatible with method '%s()' of pseudo-class '%s'", val.getTypeName(), m.getName(), m.getClassName());
    return -1;
}

// Both entries share the reflection authority checks; only the final invocation differs.
template <bool Lexical>
static QORE_LEXICAL_REFLECTION_INLINE QoreValue PseudoMethod_call_VAVV_impl(LexicalSemanticPolicy policy, QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink, QoreValue val) {
    // the privileges of the calling code
    QoreReflectionCaller caller;
    if (reflection_check_program_access(caller, m->pgm, "execute code in", xsink)) {
        return QoreValue();
    }
    // we have to explictly test value compatibility here, otherwise QoreClass::evalPseudoMethod() will throw
    // a confusing exception
    if (check_pseudo_call(val, *m->m, xsink)) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> call_args(xsink);

    // if there are arguments to pass
    if (num_args(args) > 1) {
        // create argument list by copying current list
        call_args = args->copyListFrom(1);
    }

    // the access of the pseudo-method's variants, for code that a sandbox governs or that is restricted
    if (reflection_check_method_access(caller, m->m, xsink)) {
        return QoreValue();
    }
    // the variant selected for the arguments must be allowed by the caller and the method's Program
    QoreReflectionCallCheckHelper call_check(caller, m->pgm);
    // pseudo-classes and pseudo-methods are always valid
    if constexpr (Lexical) return qore_lexical_reflection_pseudo(policy, *m->m->getClass(), m->m, nullptr, val, *call_args, xsink);
    else return m->m->getClass()->evalPseudoMethod(m->m, nullptr, val, *call_args, xsink);
}

static QoreValue PseudoMethod_call_VAVV_lexical(QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink) {
    QoreValue val = get_param_value(args, 0);
    return PseudoMethod_call_VAVV_impl<true>(qore_get_native_semantic_policy(), self, m, args, runtime_cfg, xsink, val);
}

static QoreValue PseudoMethod_call_VAVV(QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink);

template <bool Lexical>
static QORE_LEXICAL_REFLECTION_INLINE QoreValue PseudoMethod_callArgs_VAC15_softlist_auto__impl(LexicalSemanticPolicy policy, QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink, QoreValue val, const QoreListNode* argv) {
    // the privileges of the calling code
    QoreReflectionCaller caller;
    if (reflection_check_program_access(caller, m->pgm, "execute code in", xsink)) {
        return QoreValue();
    }
    // we have to explictly test value compatibility here, otherwise QoreClass::evalPseudoMethod() will throw
    // a confusing exception
    if (check_pseudo_call(val, *m->m, xsink)) {
        return QoreValue();
    }

    // the access of the pseudo-method's variants, for code that a sandbox governs or that is restricted
    if (reflection_check_method_access(caller, m->m, xsink)) {
        return QoreValue();
    }
    // the variant selected for the arguments must be allowed by the caller and the method's Program
    QoreReflectionCallCheckHelper call_check(caller, m->pgm);
    // pseudo-classes and pseudo-methods are always valid
    if constexpr (Lexical) return qore_lexical_reflection_pseudo(policy, *m->m->getClass(), m->m, nullptr, val, argv, xsink);
    else return m->m->getClass()->evalPseudoMethod(m->m, nullptr, val, argv, xsink);
}

static QoreValue PseudoMethod_callArgs_VAC15_softlist_auto__lexical(QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink) {
    QoreValue val = get_param_value(args, 0);
    const QoreListNode* argv = get_param_value(args, 1).get<const QoreListNode>();
    return PseudoMethod_callArgs_VAC15_softlist_auto__impl<true>(qore_get_native_semantic_policy(), self, m, args, runtime_cfg, xsink, val, argv);
}

static QoreValue PseudoMethod_callArgs_VAC15_softlist_auto_(QoreObject* self, QoreReflectionMethod* m, const QoreListNode* args, RuntimeConfig& runtime_cfg, ExceptionSink* xsink);

static const QoreLexicalMethodRegistrationHelper::Entry lexical_entries_PseudoMethod[] = {
    {reinterpret_cast<q_method_t>(PseudoMethod_call_VAVV), reinterpret_cast<q_method_t>(PseudoMethod_call_VAVV_lexical)},
    {reinterpret_cast<q_method_t>(PseudoMethod_callArgs_VAC15_softlist_auto_), reinterpret_cast<q_method_t>(PseudoMethod_callArgs_VAC15_softlist_auto__lexical)},
};



//! This class provides information about %Qore pseudo class methods
/**
    @see @ref Qore::Reflection::PseudoMethodVariant "PseudoMethodVariant"

    @since %Qore 0.9.0
 */
qclass PseudoMethod [ns=Qore::Reflection; arg=QoreReflectionMethod* m; vparent=AbstractMethod; dom=REFLECTION];

//! Throws an exception if called directly; this class can only be instantiated by builtin subclasses
/** @throw PSEUDOMETHOD-CONSTRUCTOR-ERROR this exception is thrown if this class is constructed directly (also if directly inherited by user classes)
 */
PseudoMethod::constructor() {
    xsink->raiseException("PSEUDOMETHOD-CONSTRUCTOR-ERROR", "this class is an abstract class and cannot be constructed directly or inherited directly by a user-defined class");
}

//! calls the given pseudo-method with the given value; the value must be compatible with the pseudo-class's type
/** @par Example:
    @code{.py}
auto v = m.call(val, arg1, arg2);
    @endcode

    @param val the value to make the call on; must be compatible with the pseudo-class's type or a \c METHOD-ERROR exception is thrown
    @param ... optional arguments to the method

    @return the return value of the method call

    @throw METHOD-ERROR the value is not compatible with the class implementing this method
    @throw INVALID-FUNCTION-ACCESS the calling code's or the method's Program's sandboxing restrictions do not allow the variant called (see @ref reflection_caller_privilege)
    @throw REFLECTION-ACCESS-ERROR the calling code may not execute code in the target Program (see @ref reflection_caller_privilege)

    @see callArgs()
*/
auto PseudoMethod::call(auto val, ...) {
    return PseudoMethod_call_VAVV_impl<false>({}, self, m, args, runtime_cfg, xsink, val);
}

//! calls the given pseudo-method with the given value; the value must be compatible with the pseudo-class's type
/** @par Example:
    @code{.py}
auto v = m.callArgs(val, (arg1, arg2));
    @endcode

    @param val the value to make the call on; must be compatible with the pseudo-class's type or a \c METHOD-ERROR exception is thrown
    @param argv optional arguments to the method

    @return the return value of the method call

    @throw METHOD-ERROR the value is not compatible with the class implementing this method
    @throw INVALID-FUNCTION-ACCESS the calling code's or the method's Program's sandboxing restrictions do not allow the variant called (see @ref reflection_caller_privilege)
    @throw REFLECTION-ACCESS-ERROR the calling code may not execute code in the target Program (see @ref reflection_caller_privilege)

    @see call()
*/
auto PseudoMethod::callArgs(auto val, *softlist<auto> argv) {
    return PseudoMethod_callArgs_VAC15_softlist_auto__impl<false>({}, self, m, args, runtime_cfg, xsink, val, argv);
}


//! @qppinit: QoreLexicalMethodRegistrationHelper lexical_registration(lexical_entries_PseudoMethod);
