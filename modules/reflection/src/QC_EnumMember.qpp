#include "qore_reflection.h"
#include "QC_EnumMember.h"
#include "QC_Enum.h"
#include "QC_Type.h"

//! This class provides information about %Qore enum members
/**
    @since %Qore 2.1
 */
qclass EnumMember [ns=Qore::Reflection; arg=QoreReflectionEnumMember* m; dom=REFLECTION];

//! Throws an exception; this class cannot be created directly or used in a user class hierarchy
/** @throw ENUMMEMBER-CONSTRUCTOR-ERROR the EnumMember class cannot be constructed directly or inherited directly by a user-defined class
 */
EnumMember::constructor() {
    xsink->raiseException("ENUMMEMBER-CONSTRUCTOR-ERROR", "this class cannot be constructed directly or inherited directly by a user-defined class");
}

//! returns the member name
/** @par Example:
    @code{.py}
string name = member.getName();
    @endcode

    @return the member name

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the enum has been destroyed
*/
string EnumMember::getName() [flags=RET_VALUE_ONLY] {
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    return new QoreStringNode(m->name);
}

//! returns the member value
/** @par Example:
    @code{.py}
auto val = member.getValue();
    @endcode

    @return the member value

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the enum has been destroyed
*/
auto EnumMember::getValue() [flags=RET_VALUE_ONLY] {
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    return m->member->getValue().refSelf();
}

//! Returns the type of the member (same as the enum's base type)
/** @par Example:
    @code{.py}
Type t = member.getType();
    @endcode

    @return the type object for this member

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the enum has been destroyed
*/
Type EnumMember::getType() [flags=RET_VALUE_ONLY] {
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    return new QoreObject(QC_TYPE, m->pgm, new QoreType(m->ed->getBaseTypeInfo()));
}

//! Returns the enum that this member belongs to
/** @par Example:
    @code{.py}
Enum e = member.getEnum();
    @endcode

    @return the enum that this member belongs to

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the enum has been destroyed
*/
Enum EnumMember::getEnum() [flags=RET_VALUE_ONLY] {
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    return new QoreObject(QC_ENUM, m->pgm, new QoreReflectionEnum(m->pgm, m->ed));
}

//! returns @ref True if the enum defining the member is a builtin enum
/** @par Example:
    @code{.py}
bool b = member.isBuiltin();
    @endcode

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the enum has been destroyed
*/
bool EnumMember::isBuiltin() [flags=RET_VALUE_ONLY] {
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    return m->ed->isSystem();
}

//! returns @ref True if the enum defining the member is a user enum
/** @par Example:
    @code{.py}
bool b = member.isUser();
    @endcode

    @throw PROGRAM-ERROR thrown if the @ref Qore::Program "Program" object holding the enum has been destroyed
*/
bool EnumMember::isUser() [flags=RET_VALUE_ONLY] {
    // get read access to program object
    QoreExternalProgramContextHelper tch(xsink, m->pgm);
    if (*xsink) {
        return QoreValue();
    }

    return !m->ed->isSystem();
}
