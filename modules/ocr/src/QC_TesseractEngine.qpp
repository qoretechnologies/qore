#include "TesseractEngine.h"

using namespace QoreOcr;

//! Tesseract OCR engine wrapper
/** Provides text extraction from images using the Tesseract OCR engine.
    Supports PNG, JPEG, TIFF, BMP, and GIF input formats.

    @par Example:
    @code{.py}
    %requires ocr

    Ocr::TesseractEngine engine("", "eng");
    binary img = ReadOnlyFile::readBinaryFile("document.png");
    string text = engine.extractText(img);
    printf("Extracted: %s\n", text);
    @endcode

    @note Thread-safe: concurrent calls to extractText() are serialized internally.
    @note The class can be used without filesystem access rights when the system data directory is used: only an
    explicit data directory given to the constructor needs them

    @since ocr 1.0
*/
qclass TesseractEngine [arg=QoreTesseractEngine* te; ns=Qore::Ocr];

//! Creates a new TesseractEngine
/** @param datapath path to the tessdata directory containing trained models;
        pass an empty string to use the default system path
    @param language Tesseract language code(s); use \c "+" to combine
        (e.g., \c "eng+fra" for English and French); each code may only contain ASCII letters, digits, \c "_" and
        \c "-", since it names the file <tt>\<code\>.traineddata</tt> in the data directory

    @throw OCR-INIT-ERROR if Tesseract initialization fails (e.g., missing
        trained data for the requested language), if a language code is empty or contains a character other than an
        ASCII letter, a digit, \c "_" or \c "-", or if \a datapath contains a NUL character; with a sandbox and an
        explicit \a datapath, also if a trained data file is not valid trained data or its language configuration
        sets a parameter that a sandboxed program may not load
    @throw ILLEGAL-FILESYSTEM-ACCESS if \a datapath is given and the calling program has the
        \c PO_NO_FILESYSTEM sandboxing restriction
    @throw FILESYSTEM-ACCESS-DENIED if \a datapath is given and the sandbox of the calling program does not allow a
        trained data file to be read
    @throw SANDBOX-PATH-ERROR if \a datapath is given and the sandbox of the calling program cannot resolve a path

    @note The trained data in an explicit \a datapath is read on behalf of the calling program, so it needs
    filesystem access rights and is subject to the program's filesystem sandbox; the system data directory used
    when \a datapath is empty is a system resource and needs neither.  With a sandbox, every trained data file is
    checked before Tesseract loads it, including the sub-languages that a trained data file loads, and its
    language configuration may only set the layout, segmentation and recognition parameters that the official
    trained data sets: a parameter that names a file or produces output, such as \c user_words_file or
    \c tessedit_write_params_to_file, is refused
*/
TesseractEngine::constructor(string datapath = "", string language = "eng") {
    self->setPrivate(CID_TESSERACTENGINE,
        new QoreTesseractEngine(datapath, language, xsink));
}

//! Extracts text from image binary data
/** @param image_data raw image bytes (PNG, JPEG, TIFF, BMP, GIF)
    @return the extracted text

    @throw OCR-ERROR if the image cannot be decoded or OCR fails
*/
string TesseractEngine::extractText(binary image_data) {
    return te->extractText(image_data, xsink);
}

//! Extracts text with metadata from image binary data
/** @param image_data raw image bytes (PNG, JPEG, TIFF, BMP, GIF)
    @return a @ref Qore::Ocr::OcrResultInfo "OcrResultInfo" hash with:
        - \c text: the full extracted text
        - \c confidence: overall confidence score (0.0 to 1.0)
        - \c blocks: list of block-level results with text, confidence,
          and bounding box coordinates

    @throw OCR-ERROR if the image cannot be decoded or OCR fails
*/
hash<auto> TesseractEngine::extractTextWithMetadata(binary image_data) {
    return te->extractTextWithMetadata(image_data, xsink);
}

//! Returns engine capabilities
/** @return a hash with:
        - \c has_tesseract (bool): always @ref True "True"
        - \c version (string): Tesseract version string
        - \c languages (list<string>): available language codes

    @since ocr 1.0
*/
hash<auto> TesseractEngine::getCapabilities() [flags=RET_VALUE_ONLY] {
    return te->getCapabilities();
}
