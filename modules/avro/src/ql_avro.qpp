#include "avro-module.h"
#include "AvroContainer.h"
#include "AvroDecimal.h"
#include "AvroDecoder.h"

/** @defgroup avro_constants avro Module Constants
    Limits and framing constants of the \c avro module.
*/
///@{
namespace Qore::Avro;

//! the size in bytes of an object container file sync marker
const AvroSyncSize = AVRO_SYNC_SIZE;

//! the maximum nesting depth accepted in a schema or in encoded data
/** Enforced in all builds, not only under sandboxing: a recursive schema lets the data drive
    recursion depth, so an unbounded depth would be a stack overflow rather than a policy choice.
*/
const AvroMaxNestingDepth = AVRO_MAX_NESTING_DEPTH;

//! the maximum \c precision accepted in a \c decimal logical type
const AvroMaxPrecision = AVRO_MAX_PRECISION;

//! the default number of encoded bytes buffered before a container file block is written
/** @ref Qore::Avro::AvroFileWriter "AvroFileWriter" uses this unless the \c block_size option
    says otherwise.
*/
const AvroDefaultBlockSize = AVRO_DEFAULT_BLOCK_SIZE;

//! the largest object container file block accepted, in bytes
const AvroMaxBlockSize = AVRO_MAX_BLOCK_SIZE;

//! the largest number of elements accepted in an \c array or \c map of a zero-width element type
/** For any element type that needs at least one byte the element count is bounded by the
    remaining input instead, which is both tighter and self-adjusting.
*/
const AvroMaxZeroWidthElements = AVRO_MAX_ZERO_WIDTH_ELEMENTS;
///@}
