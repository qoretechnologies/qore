# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes

module VoyageRestClient {
    version = "1.0";
    desc = "user module for calling Voyage AI REST API services";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("voyage", VoyageRestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new QoreRagUtils::VoyageEmbedderFactory());
        QoreRagUtils::RagProviderRegistry::registerRerankerFactory(
            new QoreRagUtils::VoyageRerankerFactory());
    };
}

/** @mainpage VoyageRestClient Module

    @tableofcontents

    @section voyagerestclientintro VoyageRestClient Introduction

    The %VoyageRestClient module provides an API for calling Voyage AI REST API services.

    To use this module, use \c "%requires VoyageRestClient" in your code.

    All the public symbols in the module are defined in the VoyageRestClient namespace.

    The main classes are:
    - @ref VoyageRestClient::VoyageRestClient "VoyageRestClient":
      this class provides the REST client API for communication with the Voyage AI REST
      API; it also automates authentication and authorization to the target
    - @ref VoyageRestClient::VoyageRestConnection "VoyageRestConnection":
      provides a REST connection object to Voyage AI services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires VoyageRestClient
%requires ConnectionProvider

VoyageRestClient rest({"apikey": api_key});
hash<auto> ans = rest.post("/embeddings", {
    "model": "voyage-4-large",
    "input": ("Hello, world!",),
});
printf("%Y\n", ans.body);
    @endcode

    @section VoyageRestClientRelnotes Release Notes

    @subsection VoyageRestClientv1_0 VoyageRestClient v1.0
    - initial release
    - the Voyage embedder packs each request up to Voyage's per-request input and token limits, paces all
      embedders sharing an endpoint, API key, and model through one process-wide requests- and
      tokens-per-minute limiter (configurable with the new \c requests-per-minute and \c tokens-per-minute
      connection options), and retries HTTP 429 rejections with a shared, bounded backoff that honors
      \c Retry-After before failing with \c EMBEDDER-RATE-LIMIT-ERROR
    - the Voyage reranker, the data provider and connection pings use the same limiter (reranking models
      have their own limits, configurable with the \c rerank-requests-per-minute and
      \c rerank-tokens-per-minute connection options); pings never wait long and report
      \c VOYAGE-RATE-LIMITED instead of blocking the connection monitor
*/

#! the VoyageRestClient namespace contains all the objects in the VoyageRestClient module
public namespace VoyageRestClient {
#! Common base class for VoyageRestClient functionality
public class VoyageRestClientBase {
    public {
        #! Default Voyage AI REST API URL
        const DefaultUrl = "https://api.voyageai.com";

        #! Default Voyage AI API version
        const DefaultApiVersion = "v1";

        #! Default Voyage AI embedding model
        const DefaultEmbeddingModel = "voyage-4-lite";

        #! Default Voyage AI reranking model
        const DefaultRerankModel = "rerank-2.5-lite";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "data": "json",
        };

        #! Voyage's published tier-1 requests per minute for every embedding and reranking model
        /** From https://docs.voyageai.com/docs/rate-limits */
        const PublishedRequestsPerMinute = 2000;

        #! Voyage's published tier-1 embedding tokens per minute by model
        /** From https://docs.voyageai.com/docs/rate-limits */
        const PublishedEmbeddingTokensPerMinuteByModel = {
            "voyage-4-lite": 16000000,
            "voyage-3.5-lite": 16000000,
            "voyage-4": 8000000,
            "voyage-3.5": 8000000,
            "voyage-4-large": 3000000,
            "voyage-3-large": 3000000,
            "voyage-code-3": 3000000,
        };

        #! Embedding tokens per minute for a model not in @ref PublishedEmbeddingTokensPerMinuteByModel
        /** The smallest published embedding limit */
        const DefaultPublishedEmbeddingTokensPerMinute = 3000000;

        #! Voyage's published tier-1 reranking tokens per minute by model
        /** From https://docs.voyageai.com/docs/rate-limits */
        const PublishedRerankTokensPerMinuteByModel = {
            "rerank-3-lite": 4000000,
            "rerank-2.5-lite": 4000000,
            "rerank-2-lite": 4000000,
            "rerank-lite-1": 4000000,
            "rerank-3": 2000000,
            "rerank-2.5": 2000000,
            "rerank-2": 2000000,
            "rerank-1": 2000000,
        };

        #! Reranking tokens per minute for a model not in @ref PublishedRerankTokensPerMinuteByModel
        /** The smallest published reranking limit */
        const DefaultPublishedRerankTokensPerMinute = 2000000;

        #! Percentage of the published limits used when no limit is configured
        /** Leaves room for requests that reach Voyage later than they were sent */
        const DefaultRateLimitPercent = 95;

        #! Rate-limit kind of embedding requests (\c /embeddings)
        const RateLimitEmbed = "embed";

        #! Rate-limit kind of reranking requests (\c /rerank)
        const RateLimitRerank = "rerank";

        #! Default ping method
        const DefaultPingMethod = "POST";

        #! Default ping path
        const DefaultPingPath = "embeddings";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default ping body (minimal valid request for connectivity check)
        const DefaultPingBody = {
            "model": DefaultEmbeddingModel,
            "input": ("ping",),
        };
    }

    #! Returns the default client-side rate limits for a model
    /** @param kind @ref RateLimitEmbed or @ref RateLimitRerank
        @param model the Voyage model

        @return a hash with \c requests_per_minute and \c tokens_per_minute: @ref DefaultRateLimitPercent
        percent of Voyage's published tier-1 limits for the model, or of the smallest published limit for a
        model not listed
    */
    static hash<auto> getDefaultRateLimits(string kind, string model) {
        int tpm = kind == RateLimitRerank
            ? (PublishedRerankTokensPerMinuteByModel{model} ?? DefaultPublishedRerankTokensPerMinute)
            : (PublishedEmbeddingTokensPerMinuteByModel{model} ?? DefaultPublishedEmbeddingTokensPerMinute);
        return {
            "requests_per_minute": PublishedRequestsPerMinute * DefaultRateLimitPercent / 100,
            "tokens_per_minute": tpm * DefaultRateLimitPercent / 100,
        };
    }

    #! Returns the process-wide limiter for one Voyage account, request kind, and model
    /** Voyage limits each project per model, so every client of the same account and model shares one
        limiter: embedders, rerankers, the data provider, and connection pings.  The account is identified by a
        SHA-256 digest of the endpoint host and the API key; the key itself is never part of the limiter key.

        @param kind @ref RateLimitEmbed or @ref RateLimitRerank
        @param url the Voyage endpoint (any scheme and path; only the host and port identify it)
        @param api_key the API key
        @param model the Voyage model
        @param requests_per_minute a configured limit; NOTHING uses the default (see @ref getDefaultRateLimits())
        @param tokens_per_minute a configured limit; NOTHING uses the default

        @note Configured limits apply to every client of the account and model in the process; a client
            without configured limits creates the limiter with the defaults but never replaces configured ones

        @return the shared limiter
    */
    static QoreRagUtils::EmbedderRateLimiter getRateLimiter(string kind, string url, string api_key,
            string model, *int requests_per_minute, *int tokens_per_minute) {
        hash<auto> defaults = getDefaultRateLimits(kind, model);
        # a client without configured limits never overrides the limits another client configured
        return QoreRagUtils::EmbedderRateLimiter::getShared(sprintf("voyage|%s|%s|%s", kind,
                getRateLimitAccount(url, api_key), model),
            requests_per_minute ?? defaults.requests_per_minute, tokens_per_minute ?? defaults.tokens_per_minute,
            exists requests_per_minute || exists tokens_per_minute);
    }

    #! Returns the non-secret account identity used in limiter keys
    /** @param url the Voyage endpoint
        @param api_key the API key
        @return the hex SHA-256 digest of the lower-case host, the port, and the API key
    */
    static string getRateLimitAccount(string url, string api_key) {
        hash<auto> u = parse_url(url);
        string host = tolower(u.host ?? url);
        int port = u.port ?? (u.protocol == "http" ? 80 : 443);
        return digest("sha256", sprintf("%s:%d\n%s", host, port, api_key)).toHex();
    }

    #! Estimates the tokens of one text without a tokenizer: its byte length, which no Voyage tokenization exceeds
    static int estimateTokens(string text) {
        return max(1, text.size());
    }

    #! Estimates the tokens of one rerank request
    /** Voyage counts "the number of query tokens × the number of documents + sum of the number of tokens in
        all documents" (https://docs.voyageai.com/reference/reranker-api).
    */
    static int estimateRerankTokens(string query, list<string> documents) {
        int rv = estimateTokens(query) * documents.size();
        foreach string doc in (documents) {
            rv += estimateTokens(doc);
        }
        return rv;
    }

    #! Returns the API key from a REST client's \c Authorization header, if it is a bearer token
    static *string getBearerKey(hash<auto> headers) {
        foreach string key in (keys headers) {
            if (tolower(key) == "authorization" && headers{key}.typeCode() == NT_STRING
                    && headers{key} =~ /^Bearer /i) {
                return headers{key}.substr(7);
            }
        }
        return NOTHING;
    }

    #! returns options for the constructor
    static hash<auto> getOptions(hash<auto> opts) {
        # Build via `+=` into an explicit hash<auto>.  A literal/`+` initializer
        # whose values are all strings (e.g. the reranker passes only apikey +
        # url) narrows the hash's value type to string, after which neither the
        # `headers` sub-hash nor the `headers` key itself can hold a hash.
        hash<auto> rv;
        rv += DefaultOptions;
        rv += opts;
        # set default_path for RestClientIo (uses this instead of setConnectionPath)
        if (!rv.default_path) {
            rv.default_path = "/" + (opts.api ?? DefaultApiVersion);
        }
        hash<auto> headers;
        if (rv.headers.typeCode() == NT_HASH) {
            headers += rv.headers;
        }
        # ensure Accept header is JSON (RestClientIo ignores the "data" option)
        if (!headers."Accept") {
            headers."Accept" = MimeTypeJson;
        }
        # map apikey to Authorization: Bearer header
        if (rv.apikey) {
            headers."Authorization" = "Bearer " + rv.apikey;
            remove rv.apikey;
        }
        rv.headers = headers;
        # these are connection-level options for downstream consumers (RAG embedder / reranker
        # configuration); they are not REST client options
        remove rv{"embedding-model", "rerank-model", "requests-per-minute", "tokens-per-minute",
            "rerank-requests-per-minute", "rerank-tokens-per-minute"};
        return rv;
    }
}

#! this class provides the REST client API for communication with Voyage AI servers
/** You must use an API key in the 'apikey' option to call Voyage AI APIs.
    The API key is sent as the \c Authorization: \c Bearer header.
*/
public class VoyageRestClient inherits RestClient::RestClient, VoyageRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
VoyageRestClient rest(opts);
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class; note
        that the URL is set by default if not provided (see @ref DefaultUrl)
        @param do_not_connect if \c False (the default), then a connection is returned already connected to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(VoyageRestClientBase::getOptions(opts), True) {
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(opts.api.val() ? string(opts.api) : DefaultApiVersion);
        }
    }
}

#! Class for Voyage AI REST connections; returns @ref VoyageRestClient objects
public class VoyageRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Voyage AI REST API URL
        const DefaultUrl = "voyage://api.voyageai.com";

        #! Longest a blocking connection ping waits for rate-limit admission
        /** A ping is diagnostic: it must report the account's state promptly rather than queue behind
            embedding work.  The polling monitor's ping never waits (see @ref startPollConnect()).
        */
        const PingMaxWaitMs = 1000;

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Voyage AI REST Connection",
            "short_desc": "A connection to the Voyage AI REST API",
            "desc": "A connection to the Voyage AI REST API for text embeddings and reranking.\n\n"
                "Requires an API key (set as `apikey`) from the "
                "[Voyage AI Dashboard](https://dash.voyageai.com/). "
                "The connection uses the `voyage://` URL scheme.\n\n"
                "The models used when this connection is selected for embeddings and for "
                "reranking are set independently with the `embedding-model` and "
                "`rerank-model` options",
            "cls": Class::forName("VoyageRestConnection"),
            "auto_url": True,
            "schemes": {
                "voyage": True,
            },
            "base_scheme_map": {
                "https": "voyage",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Voyage AI API key for authentication",
                    "type": "string",
                    "desc": "The Voyage AI API key used for authentication; sent as the `Authorization: Bearer` "
                        "header.\n\n"
                        "Get your API key from the [Voyage AI Dashboard](https://dash.voyageai.com/)",
                    "sensitive": True,
                    "preselected": True,
                },
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "The API version to use",
                    "desc": "The API version to use",
                    "type": "string",
                    "default_value": VoyageRestClientBase::DefaultApiVersion,
                },
                "embedding-model": <ConnectionOptionInfo>{
                    "display_name": "Embedding Model",
                    "short_desc": "Voyage AI embedding model name",
                    "desc": "The Voyage AI embedding model used by embedding clients when "
                        "this connection is selected for embeddings; sent as the `model` "
                        "parameter to the `/embeddings` endpoint.\n\n"
                        "Example values: `voyage-4-large` (highest quality), `voyage-4` "
                        "(balanced), `voyage-4-lite` (fastest; the default), `voyage-code-3` "
                        "(source code)",
                    "type": "string",
                    "default_value": VoyageRestClientBase::DefaultEmbeddingModel,
                },
                "rerank-model": <ConnectionOptionInfo>{
                    "display_name": "Reranking Model",
                    "short_desc": "Voyage AI reranking model name",
                    "desc": "The Voyage AI reranking model used by reranking clients when "
                        "this connection is selected for reranking; sent as the `model` "
                        "parameter to the `/rerank` endpoint.\n\n"
                        "Reranking models are a separate family from embedding models and "
                        "cannot be used interchangeably.\n\n"
                        "Example values: `rerank-2.5` (highest quality), `rerank-2.5-lite` "
                        "(fastest; the default), `rerank-2` (previous generation)",
                    "type": "string",
                    "default_value": VoyageRestClientBase::DefaultRerankModel,
                },
                "requests-per-minute": <ConnectionOptionInfo>{
                    "display_name": "Embedding Requests Per Minute",
                    "short_desc": "Client-side limit on embedding requests per minute",
                    "desc": "The most embedding requests per minute that embedding clients in one process "
                        "send for this connection's API key and model; requests over the limit wait "
                        "instead of failing with HTTP 429.\n\n"
                        "When unset, 95% of Voyage's published tier-1 limit (2,000 requests per minute) "
                        "is used.  Set it for a higher rate-limit tier, or to give each process its share "
                        "when several processes use the same API key",
                    "type": "int",
                },
                "tokens-per-minute": <ConnectionOptionInfo>{
                    "display_name": "Embedding Tokens Per Minute",
                    "short_desc": "Client-side limit on embedding tokens per minute",
                    "desc": "The most embedding tokens per minute that embedding clients in one process "
                        "send for this connection's API key and model; requests over the limit wait "
                        "instead of failing with HTTP 429.\n\n"
                        "When unset, 95% of Voyage's published tier-1 limit for the model is used (for "
                        "example 16M tokens per minute for `voyage-4-lite`, 8M for `voyage-4`, and 3M for "
                        "`voyage-4-large`).  Set it for a higher rate-limit tier, or to give each process "
                        "its share when several processes use the same API key",
                    "type": "int",
                },
                "rerank-requests-per-minute": <ConnectionOptionInfo>{
                    "display_name": "Reranking Requests Per Minute",
                    "short_desc": "Client-side limit on reranking requests per minute",
                    "desc": "The most reranking requests per minute that reranking clients in one process "
                        "send for this connection's API key and reranking model; requests over the limit wait "
                        "instead of failing with HTTP 429.\n\n"
                        "When unset, 95% of Voyage's published tier-1 limit (2,000 requests per minute) is used. "
                        "Reranking models are limited separately from embedding models",
                    "type": "int",
                },
                "rerank-tokens-per-minute": <ConnectionOptionInfo>{
                    "display_name": "Reranking Tokens Per Minute",
                    "short_desc": "Client-side limit on reranking tokens per minute",
                    "desc": "The most reranking tokens per minute that reranking clients in one process "
                        "send for this connection's API key and reranking model.\n\n"
                        "When unset, 95% of Voyage's published tier-1 limit for the model is used (4M tokens per "
                        "minute for the `-lite` models, 2M for the others)",
                    "type": "int",
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": VoyageRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": VoyageRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": VoyageRestClientBase::DefaultPingPath,
                },
                "ping_body": RestConnection::ConnectionScheme.options.ping_body + <ConnectionOptionInfo>{
                    "default_value": VoyageRestClientBase::DefaultPingBody,
                },
            },
            "required_options": "apikey",
        };
    }

    #! creates the VoyageRestConnection object
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the VoyageRestConnection object
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! returns \c "voyage"
    string getType() {
        return "voyage";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Starts a non-blocking polling ping, after the embedding rate limiter admits it without waiting
    /** A ping to the embeddings endpoint is an embedding request and counts against the account's limits like
        any other (see @ref VoyageRestClient::VoyageRestClientBase::getRateLimiter() "getRateLimiter()"): one
        request and a few tokens.  The polling monitor must never block, so a ping that does not fit the
        limits at once fails immediately with \c VOYAGE-RATE-LIMITED instead of waiting; the connection is
        then reported as rate limited rather than unreachable, and the next scheduled ping tries again.

        @throw VOYAGE-RATE-LIMITED the account's limits are exhausted or blocked after an HTTP 429
    */
    Qore::AbstractPollOperation startPollConnect(*Logger::LoggerInterface logger) {
        if (*hash<auto> ping = getRateLimitedPing()) {
            try {
                ping.limiter.settle(ping.limiter.admit(ping.tokens, clock_get_monotonic_us()));
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "EMBEDDER-RATE-LIMIT-ERROR") {
                    rethrow;
                }
                throw "VOYAGE-RATE-LIMITED", sprintf("ping not sent: %s", ex.desc), ex.arg;
            }
        }
        return RestConnection::startPollConnect(logger);
    }

    #! Performs a blocking ping through the embedding rate limiter
    /** The ping waits at most @ref PingMaxWaitMs for admission and is not retried after HTTP 429; a 429 still
        blocks every client sharing the limiter for the provider's \c Retry-After or backoff, so a ping never
        adds to an overload.  Either way the ping fails with \c VOYAGE-RATE-LIMITED.
    */
    private pingImpl() {
        *hash<auto> ping = getRateLimitedPing();
        if (!ping) {
            RestConnection::pingImpl();
            return;
        }
        ping.limiter.call(<QoreRagUtils::RateLimitedCallInfo>{
            "tokens": ping.tokens,
            "deadline_us": clock_get_monotonic_us() + PingMaxWaitMs * 1000,
            "max_retries": 0,
            "error_code": "VOYAGE-RATE-LIMITED",
            "error_prefix": sprintf("ping model %y", ping.model),
        }, bool sub () {
            RestConnection::pingImpl();
            return True;
        });
    }

    #! Returns the limiter and estimate of a ping that sends an embeddings request, or NOTHING
    private *hash<auto> getRateLimitedPing() {
        *string path = getPingPath();
        if (!opts.ping_method || !exists path || path !~ /embeddings$/ || !opts.apikey.val()) {
            return NOTHING;
        }
        auto body = getPingBody();
        string model = (body.typeCode() == NT_HASH && body.model.typeCode() == NT_STRING)
            ? body.model
            : VoyageRestClientBase::DefaultEmbeddingModel;
        int tokens = 1;
        if (body.typeCode() == NT_HASH) {
            foreach auto input in (body.input) {
                if (input.typeCode() == NT_STRING) {
                    tokens += VoyageRestClientBase::estimateTokens(input);
                }
            }
        }
        return {
            "model": model,
            "tokens": tokens,
            "limiter": VoyageRestClientBase::getRateLimiter(VoyageRestClientBase::RateLimitEmbed, url,
                opts.apikey, model, opts."requests-per-minute", opts."tokens-per-minute"),
        };
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the VoyageDataProvider and creates the data provider
        # object dynamically
        load_module("VoyageDataProvider");
        return create_object("VoyageDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! returns a @ref VoyageRestClient object
    private VoyageRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new VoyageRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new VoyageRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Voyage AI REST API using multiplexed HTTP connections
public class VoyageRestClientIo inherits RestClientIo::RestClientIo, VoyageRestClientBase {
    #! Creates the object with the given options
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(VoyageRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}

public namespace QoreRagUtils {
#! Voyage AI-backed embedder — calls the Voyage \c /embeddings endpoint
/** Wraps @ref VoyageRestClient::VoyageRestClientIo "VoyageRestClientIo" for
    async-capable HTTP calls to the Voyage AI API.

    @par Configuration

    - \c api_key (required): Voyage API key; passed via the \c apikey option
    - \c url (optional): override the default Voyage URL
    - \c model (optional): model name, default
      @ref VoyageRestClient::VoyageRestClientBase::DefaultEmbeddingModel "DefaultEmbeddingModel"
    - \c dimension (optional): forwarded as the \c output_dimension request
      parameter; when unset the dimension is auto-detected on first call and
      shared by every embedder in the process for the same endpoint and model
    - \c timeout (optional): default request timeout (per-call \c opts override
      takes precedence)
    - \c connect_timeout (optional): default connection timeout (per-call
      \c opts override takes precedence)
    - \c requests_per_minute, \c tokens_per_minute (optional): client-side rate
      limits; see @ref voyage_embedder_rate_limits
    - \c rate_limit_max_retries, \c rate_limit_timeout (optional): bounds on
      rate-limit retries; see @ref voyage_embedder_rate_limits

    @par Query and document roles

    @ref AbstractEmbedder::encodeQuery() forwards Voyage \c input_type
    \c "query", and @ref AbstractEmbedder::encodeDocuments() forwards
    \c "document".  Direct @ref encode() or @ref encodeBatch() calls omit the
    role unless the caller supplies one of those two values explicitly.

    @par Request packing

    @ref encodeBatch() sends as few requests as Voyage's per-request limits
    allow: at most @ref MaxInputsPerRequest inputs and at most the model's
    total tokens per request (@ref MaxTokensPerRequestByModel; 1M tokens for
    \c voyage-4-lite, 320K for \c voyage-4, 120K for \c voyage-4-large and
    models not listed).  Without a token counter (see
    @ref AbstractEmbedder::setTokenCounter()), an input is counted as its byte
    length, which no Voyage tokenization exceeds.  An input larger than the
    limit is sent alone.  Results keep the input order; an error from one
    request carries \c input_offset and \c input_count in its argument so the
    caller can tell which inputs failed.  @ref getPreferredBatchSize() returns
    @ref MaxInputsPerRequest.

    @anchor voyage_embedder_rate_limits
    @par Rate limits

    Voyage limits requests and tokens per minute for each project and model.
    Every request passes a process-wide
    @ref QoreRagUtils::EmbedderRateLimiter "EmbedderRateLimiter" shared by
    every client of the same Voyage account and model (see
    @ref VoyageRestClient::VoyageRestClientBase::getRateLimiter() "getRateLimiter()"),
    so independently created embedders, the data provider and connection pings
    cannot together exceed the limits.  A caller whose request does not fit
    waits (interruptibly) instead of failing.  The defaults are 95% of Voyage's
    published tier-1 limits (see
    @ref VoyageRestClient::VoyageRestClientBase::getDefaultRateLimits() "getDefaultRateLimits()"),
    leaving room for requests that arrive at Voyage later than they were sent; set
    \c requests_per_minute and \c tokens_per_minute for a higher tier, or to
    give each process its share when several processes use one API key.

    An HTTP 429 response is not retried by the transient-failure retry
    policy.  Instead it blocks the shared limiter for the response's
    \c Retry-After (seconds or HTTP date) plus up to 10% jitter, or, without
    one, for an exponential backoff from 1s up to 16s with equal jitter, so
    every caller sharing the limit backs off together; the request is then sent
    again.  Each request is bounded by \c rate_limit_max_retries rate-limit
    retries (default 8) and \c rate_limit_timeout (default 60s, further limited
    by a positive configured or per-call \c timeout) for admission and
    rate-limit waits.  When either bound is reached the request fails with
    \c EMBEDDER-RATE-LIMIT-ERROR (\c reason_code \c "provider_rate_limited" or
    \c "rate_limit_wait_deadline").  Each request sent gets a fresh
    transient-failure retry budget (see @ref AbstractEmbedder).  Rate-limit
    retries are reported to the telemetry observer like other retries (an
    \c "error" event with \c status_code 429), and an admission wait of a second
    or more as a \c "wait" event with \c rate_limit_wait_ms.
    The rate-limit loop itself is
    @ref QoreRagUtils::EmbedderRateLimiter::call() "EmbedderRateLimiter::call()".
*/
public class VoyageEmbedder inherits AbstractEmbedder {
    public {
        const DefaultModel = VoyageRestClient::VoyageRestClientBase::DefaultEmbeddingModel;
        const Backend = "voyage";

        #! Maximum inputs in one Voyage embeddings request
        /** "The maximum length of the list is 1,000" (Voyage embeddings API reference,
            https://docs.voyageai.com/reference/embeddings-api).
        */
        const MaxInputsPerRequest = 1000;

        #! Maximum total tokens in one Voyage embeddings request by model
        /** From the Voyage embeddings API reference (https://docs.voyageai.com/reference/embeddings-api).
        */
        const MaxTokensPerRequestByModel = {
            "voyage-4-lite": 1000000,
            "voyage-3.5-lite": 1000000,
            "voyage-4": 320000,
            "voyage-3.5": 320000,
            "voyage-2": 320000,
            "voyage-4-large": 120000,
            "voyage-3-large": 120000,
            "voyage-code-3": 120000,
            "voyage-finance-2": 120000,
            "voyage-law-2": 120000,
        };

        #! Total tokens per request for a model not in @ref MaxTokensPerRequestByModel (the smallest limit)
        const DefaultMaxTokensPerRequest = 120000;

    }

    private {
        hash<EmbedderConfig> config;
        string model_name;
        *VoyageRestClient::VoyageRestClientIo rest_client;
        *EmbedderRateLimiter rate_limiter;
        *int cached_dimension;
        Mutex init_mutex();
    }

    private:internal {
        #! Serializes the shared dimension cache
        static Mutex dimension_lock();
        #! Endpoint, model and requested dimension -> dimension learned by any embedder in the process
        static hash<string, int> dimension_cache = {};
    }

    constructor(hash<EmbedderConfig> config) {
        if (!config.api_key.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "VoyageEmbedder requires 'api_key' in EmbedderConfig";
        }
        if (config.requests_per_minute < 0 || config.tokens_per_minute < 0
                || config.rate_limit_max_retries < 0 || config.rate_limit_timeout <= 0) {
            throw "EMBEDDER-CONFIG-ERROR", "VoyageEmbedder rate limits and rate_limit_max_retries must not be "
                "negative and rate_limit_timeout must be positive";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }
        # validates the retry options before any request is sent
        hash<auto> call_opts = embedderRequestOptions(config, opts, Backend);

        hash<auto> body = {
            "model": model_name,
        };
        *string input_type = call_opts.input_type;
        if (input_type.val()) {
            if (!inlist(input_type, ("query", "document"))) {
                throw "EMBEDDER-INPUT-TYPE-ERROR", sprintf(
                    "%s: unsupported input_type %y; expected 'query' or 'document'",
                    Backend, input_type);
            }
            body.input_type = input_type;
        }
        if (exists config.dimension) {
            body.output_dimension = config.dimension;
        }

        int max_rate_limit_retries = opts.rate_limit_max_retries ?? config.rate_limit_max_retries;
        timeout rate_limit_timeout = opts.rate_limit_timeout ?? config.rate_limit_timeout;
        int rate_limit_budget_ms = rate_limit_timeout;
        *timeout req_timeout = opts.timeout ?? config.timeout;
        if (req_timeout > 0) {
            rate_limit_budget_ms = min(rate_limit_budget_ms, req_timeout);
        }
        if (max_rate_limit_retries < 0 || rate_limit_budget_ms <= 0) {
            throw "EMBEDDER-CONFIG-ERROR", "rate_limit_max_retries must not be negative and "
                "rate_limit_timeout must be positive";
        }

        VoyageRestClient::VoyageRestClientIo client = pickRestClient(call_opts);
        EmbedderRateLimiter limiter = getRateLimiter();
        list<list<float>> result = ();
        foreach hash<auto> slice in (planRequests(texts)) {
            result += sendRequest(client, limiter, body, texts[slice.offset .. slice.offset + slice.count - 1],
                slice, opts, max_rate_limit_retries, rate_limit_budget_ms);
        }
        return result;
    }

    #! Returns @ref MaxInputsPerRequest; requests are further split by the model's token limit
    int getPreferredBatchSize() {
        return MaxInputsPerRequest;
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        *int known = getKnownDimension();
        if (exists known) {
            cached_dimension = known;
            return known;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    *string getModel() {
        return model_name;
    }

    #! Returns the maximum total tokens of one request for this embedder's model
    /** @return the model's limit from @ref MaxTokensPerRequestByModel, or @ref DefaultMaxTokensPerRequest
    */
    int getMaxTokensPerRequest() {
        return MaxTokensPerRequestByModel{model_name} ?? DefaultMaxTokensPerRequest;
    }

    #! Returns the effective client-side rate limits
    /** @return a hash with \c requests_per_minute and \c tokens_per_minute: the configured values, or the
        defaults from @ref VoyageRestClient::VoyageRestClientBase::getDefaultRateLimits() "getDefaultRateLimits()"
    */
    hash<auto> getRateLimits() {
        hash<auto> defaults = VoyageRestClient::VoyageRestClientBase::getDefaultRateLimits(
            VoyageRestClient::VoyageRestClientBase::RateLimitEmbed, model_name);
        return {
            "requests_per_minute": config.requests_per_minute ?? defaults.requests_per_minute,
            "tokens_per_minute": config.tokens_per_minute ?? defaults.tokens_per_minute,
        };
    }

    #! Returns True: @ref encodeBatch() packs its inputs into requests within Voyage's per-request limits
    bool packsRequests() {
        return True;
    }

    #! Returns the process-wide limiter for this embedder's account and model
    private EmbedderRateLimiter getRateLimiter() {
        if (!rate_limiter) {
            AutoLock al(init_mutex);
            if (!rate_limiter) {
                rate_limiter = VoyageRestClient::VoyageRestClientBase::getRateLimiter(
                    VoyageRestClient::VoyageRestClientBase::RateLimitEmbed,
                    config.url ?? VoyageRestClient::VoyageRestClientBase::DefaultUrl, config.api_key, model_name,
                    config.requests_per_minute, config.tokens_per_minute);
            }
        }
        return rate_limiter;
    }

    #! Estimates the tokens of one input for request packing and rate limiting
    /** Uses the token counter when one is set; otherwise the byte length, which no Voyage tokenization
        exceeds.
    */
    private int estimateTokens(string text) {
        *object counter = getTokenCounter();
        if (counter) {
            try {
                return max(1, counter.countTokens(text));
            } catch (hash<ExceptionInfo> ex) {
                if (inlist(ex.err, ("THREAD-CANCELLED", "PROGRAM-INTERRUPTED"))) {
                    rethrow;
                }
            }
        }
        return VoyageRestClient::VoyageRestClientBase::estimateTokens(text);
    }

    #! Splits the inputs into requests within the per-request input and token limits, in order
    /** @return a list of hashes with \c offset, \c count, and estimated \c tokens
    */
    private list<hash<auto>> planRequests(list<string> texts) {
        int max_tokens = getMaxTokensPerRequest();
        list<hash<auto>> rv = ();
        int offset = 0;
        int count = 0;
        int tokens = 0;
        for (int i = 0; i < texts.size(); ++i) {
            int t = estimateTokens(texts[i]);
            if (count && (count == MaxInputsPerRequest || tokens + t > max_tokens)) {
                push rv, {"offset": offset, "count": count, "tokens": tokens};
                offset = i;
                count = 0;
                tokens = 0;
            }
            ++count;
            tokens += t;
        }
        push rv, {"offset": offset, "count": count, "tokens": tokens};
        return rv;
    }

    #! Sends one request through the shared limiter, retrying rate-limit rejections
    private list<list<float>> sendRequest(VoyageRestClient::VoyageRestClientIo client,
            EmbedderRateLimiter limiter, hash<auto> body, list<string> input, hash<auto> slice,
            *hash<auto> opts, int max_rate_limit_retries, int rate_limit_budget_ms) {
        # copy into an untyped hash: a literal holding only strings narrows its value type
        hash<auto> request = {};
        request += body;
        request.input = input;
        hash<auto> resp;
        try {
            resp = limiter.call(<RateLimitedCallInfo>{
                "tokens": slice.tokens,
                "deadline_us": clock_get_monotonic_us() + rate_limit_budget_ms * 1000,
                "max_retries": max_rate_limit_retries,
                "error_code": "EMBEDDER-RATE-LIMIT-ERROR",
                "error_prefix": sprintf("%s: model %y", Backend, model_name),
                "error_arg": {"backend": Backend, "model": model_name, "input_offset": slice.offset,
                    "input_count": slice.count},
                "observer": sub (hash<RateLimitEventInfo> event) {
                    notifyRateLimitEvent(opts ?? {}, event, slice);
                },
            }, hash<auto> sub () {
                # a fresh transient-failure budget for each request admitted
                hash<auto> req_opts = embedderRequestOptions(config, opts, Backend);
                return client.restPostWithRetry("/embeddings", request, NOTHING,
                    req_opts._embedder_retry_policy);
            }, *int sub (hash<auto> resp) {
                auto used = resp.body.usage.total_tokens;
                return used.typeCode() == NT_INT ? used : NOTHING;
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "REST-RESPONSE-ERROR" && isPermanentEmbedderConfigError(ex)) {
                throwEmbedderModelConfigError(ex, Backend, model_name);
            }
            if (inlist(ex.err, ("THREAD-CANCELLED", "PROGRAM-INTERRUPTED", "EMBEDDER-RATE-LIMIT-ERROR"))) {
                rethrow;
            }
            hash<auto> arg = ex.arg.typeCode() == NT_HASH ? {} + ex.arg
                : (exists ex.arg ? {"original_arg": ex.arg} : {});
            rethrow ex.err, ex.desc, arg + {"input_offset": slice.offset, "input_count": slice.count};
        }
        return parseResponse(resp.body, input.size(), slice);
    }

    #! Reports a rate-limit retry or a long limiter wait to the telemetry observer
    /** A retry is reported like any other retry (an \c "error" event with \c status_code 429); a wait is a
        \c "wait" event with \c rate_limit_wait_ms.  Both carry \c rate_limited @ref True.
    */
    private notifyRateLimitEvent(hash<auto> opts, hash<RateLimitEventInfo> event, hash<auto> slice) {
        if (event.type == "retry") {
            notifyEmbedderRetry(config, opts, Backend, <RestClientIo::RestRetryEvent>{
                "attempt": event.attempt,
                "status_code": event.status_code,
                "err": event.err ?? "REST-RESPONSE-ERROR",
                "delay_ms": event.delay_ms,
            });
            return;
        }
        *hash<RagTelemetryObserver> observer = opts.telemetry_observer ?? config.telemetry_observer;
        if (!observer) {
            return;
        }
        hash<RagTelemetryEvent> wait = <RagTelemetryEvent>{
            "type": "wait",
            "operation": "embed",
            "timestamp": now_us(),
            "backend": Backend,
            "model": model_name,
            "telemetry_context": opts.telemetry_context ?? config.telemetry_context,
            "attributes": {"rate_limited": True, "rate_limit_wait_ms": event.delay_ms,
                "input_count": slice.count, "attempt": event.attempt},
        };
        foreach *code<nothing(hash<RagTelemetryEvent>)> cb in ((observer.event_callback,)) {
            if (cb) {
                try {
                    cb(wait);
                } catch (hash<ExceptionInfo> observer_error) {
                    if (inlist(observer_error.err, ("THREAD-CANCELLED", "PROGRAM-INTERRUPTED"))) {
                        rethrow;
                    }
                }
            }
        }
    }

    #! Returns the vectors of one response in input order
    private list<list<float>> parseResponse(auto resp_body, int count, hash<auto> slice) {
        *list<auto> data = resp_body.data;
        if (!exists data) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing 'data' field", Backend),
                {"body": resp_body, "input_offset": slice.offset, "input_count": slice.count};
        }
        if (data.size() != count) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned %d items for %d input texts",
                    Backend, data.size(), count),
                {"body": resp_body, "input_offset": slice.offset, "input_count": slice.count};
        }
        list<auto> ordered = ();
        ordered[count - 1] = NOTHING;
        foreach auto item in (data) {
            auto idx = item."index";
            if (idx.typeCode() != NT_INT || idx < 0 || idx >= count || exists ordered[idx]) {
                throw "EMBEDDER-RESPONSE-ERROR",
                    sprintf("%s: response item has a missing, out-of-range or duplicate index %y",
                        Backend, idx),
                    {"body": resp_body, "input_offset": slice.offset, "input_count": slice.count};
            }
            ordered[idx] = item;
        }

        list<list<float>> result = ();
        foreach hash<auto> item in (ordered) {
            list<float> vec = validateAndCastVector(item.embedding, resp_body);
            if (!exists cached_dimension) {
                cached_dimension = vec.size();
                setKnownDimension(vec.size());
            }
            push result, vec;
        }
        return result;
    }

    #! Does not retry HTTP 429 in the transient-failure policy; @ref sendRequest() paces those
    private RestClientIo::RestRetryPolicy newEmbedderRetryPolicy(hash<RestClientIo::RestRetryOptions> options) {
        return new VoyageTransientRetryPolicy(options);
    }

    #! Returns the shared cache key for the learned dimension
    private string dimensionKey() {
        return sprintf("%s|%s|%y", config.url ?? VoyageRestClient::VoyageRestClientBase::DefaultUrl,
            model_name, config.dimension);
    }

    private *int getKnownDimension() {
        AutoLock al(dimension_lock);
        return dimension_cache{dimensionKey()};
    }

    private setKnownDimension(int dimension) {
        AutoLock al(dimension_lock);
        dimension_cache{dimensionKey()} = dimension;
    }

    private bool isPermanentEmbedderConfigError(hash<ExceptionInfo> ex) {
        *int status_code = ex.arg.status_code;
        if (status_code != 400 && status_code != 404) {
            return False;
        }
        auto body = ex.arg.body;
        *string error_type = body."type" ?? body.error."type" ?? body.error_type;
        if (error_type == "BadRequestError" || error_type == "InvalidModelError") {
            return True;
        }
        *string message = body.detail ?? body.message ?? body.error.message ?? body.error;
        if (!exists message && body.typeCode() == NT_STRING) {
            message = body;
        }
        if (!exists message) {
            return False;
        }
        string lower = message.lwr();
        if (lower.find("model") == -1) {
            return False;
        }
        return lower.find("not found") != -1
            || lower.find("does not exist") != -1
            || lower.find("invalid model") != -1
            || lower.find("unsupported model") != -1
            || lower.find("is not an embedding") != -1
            || lower.find("does not appear to be an embedding") != -1;
    }

    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response item missing 'embedding' field", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    private VoyageRestClient::VoyageRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new VoyageRestClient::VoyageRestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "apikey": config.api_key,
        };
        if (config.url.val()) {
            opts.url = config.url;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new VoyageRestClient::VoyageRestClientIo(buildRestOptions());
            }
        }
    }
}

#! Transient-failure retry policy for Voyage embeddings that leaves HTTP 429 to the rate limiter
/** @ref VoyageEmbedder retries rate-limit rejections through its shared
    @ref QoreRagUtils::EmbedderRateLimiter "EmbedderRateLimiter", so every caller sharing the limit backs
    off together; the other transient failures are retried as by @ref RestClientIo::RestRetryPolicy.
*/
public class VoyageTransientRetryPolicy inherits RestClientIo::RestRetryPolicy {
    constructor(*hash<RestClientIo::RestRetryOptions> options) : RestRetryPolicy(options) {
    }

    private bool isRetryableError(hash<ExceptionInfo> ex) {
        if (ex.err == "REST-RESPONSE-ERROR" && ex.arg.status_code == 429) {
            return False;
        }
        return RestRetryPolicy::isRetryableError(ex);
    }
}

#! Factory for @ref VoyageEmbedder
public class VoyageEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "voyage";
    }

    string getDisplayName() {
        return "Voyage AI embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new VoyageEmbedder(config);
    }
}

#! Voyage AI-backed reranker — calls the Voyage \c /rerank endpoint
/** Wraps @ref VoyageRestClient::VoyageRestClientIo "VoyageRestClientIo".

    @par Configuration

    - \c api_key (required): Voyage API key; passed via the \c apikey option
    - \c url (optional): override the default Voyage URL
    - \c model (optional): model name, default
      @ref VoyageRestClient::VoyageRestClientBase::DefaultRerankModel "DefaultRerankModel"
    - \c requests_per_minute, \c tokens_per_minute, \c rate_limit_max_retries,
      \c rate_limit_timeout (optional): client-side rate limits and the bounds on
      rate-limit retries

    @par Rate limits

    Every request passes the process-wide reranking limiter of its Voyage
    account and model (see
    @ref VoyageRestClient::VoyageRestClientBase::getRateLimiter() "getRateLimiter()";
    reranking models have their own limits, separate from embedding models), and
    an HTTP 429 is retried with the same shared, bounded backoff as the
    embedder's (see @ref voyage_embedder_rate_limits and
    @ref QoreRagUtils::EmbedderRateLimiter::call() "EmbedderRateLimiter::call()").
    A request's tokens are estimated as Voyage counts them, the query times the
    number of documents plus the documents, and replaced by the reported usage.
    When the retries or \c rate_limit_timeout are exhausted the request fails
    with \c RERANKER-RATE-LIMIT-ERROR.  Retries and admission waits of a second
    or more are reported to the telemetry observer (\c "error" and \c "wait"
    events with \c rate_limited @ref True).
*/
public class VoyageReranker inherits AbstractReranker {
    public {
        const DefaultModel = VoyageRestClient::VoyageRestClientBase::DefaultRerankModel;
    }

    private {
        hash<RerankerConfig> config;
        string model_name;
        *VoyageRestClient::VoyageRestClientIo rest_client;
        *EmbedderRateLimiter rate_limiter;
        Mutex init_mutex();
    }

    constructor(hash<RerankerConfig> config) {
        if (!config.api_key.val()) {
            throw "RERANKER-CONFIG-ERROR",
                "VoyageReranker requires 'api_key' in RerankerConfig";
        }
        if (config.requests_per_minute < 0 || config.tokens_per_minute < 0
                || config.rate_limit_max_retries < 0 || config.rate_limit_timeout <= 0) {
            throw "RERANKER-CONFIG-ERROR", "VoyageReranker rate limits and rate_limit_max_retries must not be "
                "negative and rate_limit_timeout must be positive";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
    }

    list<hash<RerankResult>> rerank(string query, list<string> documents, int top_k,
            *hash<auto> opts) {
        return doRerank(query, documents, top_k, opts).results;
    }

    hash<RerankOutcome> rerankEx(string query, list<string> documents, int top_k,
            *hash<auto> opts) {
        return doRerank(query, documents, top_k, opts);
    }

    #! Single Voyage \c /rerank round-trip returning results and provider usage
    private hash<RerankOutcome> doRerank(string query, list<string> documents,
            int top_k, *hash<auto> opts) {
        if (!documents) {
            return <RerankOutcome>{
                "results": (),
                "usage": AbstractReranker::estimateRerankUsage(query, documents),
            };
        }
        ensureRestClient();

        hash<auto> body = {
            "model": model_name,
            "query": query,
            "documents": documents,
            "top_k": top_k,
            "return_documents": True,
        };
        if (opts) {
            # forward Voyage-recognized per-call knobs verbatim; reserved
            # body keys above always win so callers can't accidentally
            # override the wire-level fields
            if (exists opts.truncation) {
                body."truncation" = opts.truncation;
            }
            if (exists opts.max_chunks_per_doc) {
                body."max_chunks_per_doc" = opts.max_chunks_per_doc;
            }
            if (exists opts.return_documents) {
                body."return_documents" = opts.return_documents;
            }
        }

        hash<auto> resp = getRateLimiter().call(<RateLimitedCallInfo>{
            "tokens": VoyageRestClient::VoyageRestClientBase::estimateRerankTokens(query, documents),
            "deadline_us": clock_get_monotonic_us() + rateLimitBudgetMs(opts) * 1000,
            "max_retries": opts.rate_limit_max_retries ?? config.rate_limit_max_retries,
            "error_code": "RERANKER-RATE-LIMIT-ERROR",
            "error_prefix": sprintf("voyage: rerank model %y", model_name),
            "error_arg": {"backend": "voyage", "model": model_name},
            "observer": sub (hash<RateLimitEventInfo> event) {
                notifyRateLimitEvent(opts ?? {}, event, documents.size());
            },
        }, hash<auto> sub () {
            return rest_client.restPost("/rerank", body);
        }, *int sub (hash<auto> resp) {
            auto used = resp.body.usage.total_tokens;
            return used.typeCode() == NT_INT ? used : NOTHING;
        });

        list<hash<auto>> data = resp.body.data ?? ();
        list<hash<RerankResult>> result = ();
        foreach hash<auto> item in (data) {
            int idx = item."index";
            string doc = item.document.typeCode() == NT_STRING
                ? item.document
                : (exists item.document.text ? item.document.text : documents[idx]);
            push result, <RerankResult>{
                "index": idx,
                "score": item.relevance_score.toFloat(),
                "document": doc,
            };
        }
        return <RerankOutcome>{
            "results": result,
            "usage": rerankUsageFromResponse(resp.body, query, documents),
        };
    }

    #! Builds normalized usage from the Voyage response, falling back to an estimate
    private hash<RerankUsage> rerankUsageFromResponse(*hash<auto> resp_body,
            string query, list<string> documents) {
        *int total = resp_body.usage."total_tokens";
        if (!total.val()) {
            return AbstractReranker::estimateRerankUsage(query, documents);
        }
        return <RerankUsage>{
            "total_tokens": total,
            "token_source": "provider",
        };
    }

    *string getModel() {
        return model_name;
    }

    #! Returns the effective client-side rate limits
    /** @return a hash with \c requests_per_minute and \c tokens_per_minute: the configured values, or the
        defaults from @ref VoyageRestClient::VoyageRestClientBase::getDefaultRateLimits() "getDefaultRateLimits()"
    */
    hash<auto> getRateLimits() {
        hash<auto> defaults = VoyageRestClient::VoyageRestClientBase::getDefaultRateLimits(
            VoyageRestClient::VoyageRestClientBase::RateLimitRerank, model_name);
        return {
            "requests_per_minute": config.requests_per_minute ?? defaults.requests_per_minute,
            "tokens_per_minute": config.tokens_per_minute ?? defaults.tokens_per_minute,
        };
    }

    #! Returns the process-wide reranking limiter for this reranker's account and model
    private EmbedderRateLimiter getRateLimiter() {
        if (!rate_limiter) {
            AutoLock al(init_mutex);
            if (!rate_limiter) {
                rate_limiter = VoyageRestClient::VoyageRestClientBase::getRateLimiter(
                    VoyageRestClient::VoyageRestClientBase::RateLimitRerank,
                    config.url ?? VoyageRestClient::VoyageRestClientBase::DefaultUrl, config.api_key, model_name,
                    config.requests_per_minute, config.tokens_per_minute);
            }
        }
        return rate_limiter;
    }

    #! Returns the rate-limit budget of one request in milliseconds
    private int rateLimitBudgetMs(*hash<auto> opts) {
        timeout budget = opts.rate_limit_timeout ?? config.rate_limit_timeout;
        int rv = budget;
        if (rv <= 0) {
            throw "RERANKER-CONFIG-ERROR", "rate_limit_timeout must be positive";
        }
        return rv;
    }

    #! Reports a rate-limit retry or a long limiter wait to the telemetry observer
    private notifyRateLimitEvent(hash<auto> opts, hash<RateLimitEventInfo> event, int document_count) {
        *hash<RagTelemetryObserver> observer = opts.telemetry_observer ?? config.telemetry_observer;
        if (!observer) {
            return;
        }
        bool retry = event.type == "retry";
        hash<RagTelemetryEvent> rv = <RagTelemetryEvent>{
            "type": retry ? "error" : "wait",
            "operation": "rerank",
            "timestamp": now_us(),
            "backend": "voyage",
            "model": model_name,
            "telemetry_context": opts.telemetry_context ?? config.telemetry_context,
            "status": retry ? "error" : NOTHING,
            "error": retry ? {"err": event.err, "retryable": True, "attempt": event.attempt,
                "status_code": event.status_code} : NOTHING,
            "attributes": retry
                ? {"rate_limited": True, "attempt": event.attempt, "next_attempt": event.attempt + 1,
                    "retry_delay_ms": event.delay_ms, "document_count": document_count}
                : {"rate_limited": True, "rate_limit_wait_ms": event.delay_ms, "document_count": document_count},
        };
        foreach *code<nothing(hash<RagTelemetryEvent>)> cb in
                ((observer.event_callback, retry ? observer.error_callback : NOTHING)) {
            if (cb) {
                try {
                    cb(rv);
                } catch (hash<ExceptionInfo> observer_error) {
                    if (inlist(observer_error.err, ("THREAD-CANCELLED", "PROGRAM-INTERRUPTED"))) {
                        rethrow;
                    }
                }
            }
        }
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                hash<auto> opts = {
                    "apikey": config.api_key,
                };
                if (config.url.val()) {
                    opts.url = config.url;
                }
                rest_client = new VoyageRestClient::VoyageRestClientIo(opts);
            }
        }
    }
}

#! Factory for @ref VoyageReranker
public class VoyageRerankerFactory inherits AbstractRerankerFactory {
    string getType() {
        return "voyage";
    }

    string getDisplayName() {
        return "Voyage AI rerank";
    }

    AbstractReranker create(hash<RerankerConfig> config) {
        return new VoyageReranker(config);
    }
}
}
