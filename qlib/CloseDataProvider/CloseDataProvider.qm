# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) CloseRestClient

module CloseDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Close CRM";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new CloseDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": CloseDataProvider::AppName,
            "display_name": "Close",
            "short_desc": "Close CRM for sales teams",
            "desc": "Close is a CRM platform built for sales teams, offering lead management, "
                "contact tracking, opportunities, tasks, and activity logging (calls, emails, "
                "notes, meetings, SMS).\n\n"
                "This integration supports leads, contacts, opportunities, tasks, calls, emails, "
                "notes, meetings, SMS, and event triggers.",
            "scheme": "closerest",
            "logo": CloseLogo,
            "logo_file_name": "close-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::CrmSales,),
        });

        # ========== LEAD ACTIONS ==========

        # Create a Lead
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/leads/create",
            "action": "create-lead",
            "groups": "Leads",
            "display_name": "Create a Lead",
            "short_desc": "Create a new lead",
            "desc": "Create a new lead in Close CRM",
            "action_code": DPAT_API,
            "options": {
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "The lead name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The name of the lead (typically the company or organization name)",
                    "example_value": "Acme Corporation",
                    "preselected": True,
                },
                "status_id": <ActionOptionInfo>{
                    "display_name": "Status ID",
                    "short_desc": "The lead status ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The unique identifier of the lead status to assign",
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "The lead description",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "A text description of the lead with additional context or notes",
                    "example_value": "Enterprise prospect from trade show",
                },
                "url": <ActionOptionInfo>{
                    "display_name": "URL",
                    "short_desc": "The lead URL",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The website URL associated with the lead",
                    "example_value": "https://www.example.com",
                },
                "contacts": <ActionOptionInfo>{
                    "display_name": "Contacts",
                    "short_desc": "Nested contacts to create",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "A list of contact objects to create and associate with this lead. "
                        "Each contact can include name, title, emails, and phones fields",
                },
                "addresses": <ActionOptionInfo>{
                    "display_name": "Addresses",
                    "short_desc": "Lead addresses",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of address objects for the lead",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new CloseLeadDataType(); },
        });

        # Update a Lead
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/leads/update",
            "action": "update-lead",
            "groups": "Leads",
            "display_name": "Update a Lead",
            "short_desc": "Update an existing lead",
            "desc": "Update an existing lead in Close CRM",
            "action_code": DPAT_API,
            "options": {
                "lead_id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "The lead to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "leads",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "The lead name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new name of the lead",
                    "example_value": "Acme Corporation",
                    "preselected": True,
                },
                "status_id": <ActionOptionInfo>{
                    "display_name": "Status ID",
                    "short_desc": "The lead status ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new status ID to assign to the lead",
                    "preselected": True,
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "The lead description",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new text description of the lead",
                },
                "url": <ActionOptionInfo>{
                    "display_name": "URL",
                    "short_desc": "The lead URL",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new website URL associated with the lead",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new CloseLeadDataType(); },
        });

        # Delete a Lead
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/leads/delete",
            "action": "delete-lead",
            "groups": "Leads",
            "display_name": "Delete a Lead",
            "short_desc": "Delete a lead",
            "desc": "Delete a lead from Close CRM",
            "action_code": DPAT_API,
            "options": {
                "lead_id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "The lead to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "leads",
                },
            },
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
        });

        # List Leads
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/leads",
            "action": "find-leads",
            "groups": "Leads",
            "display_name": "List Leads",
            "short_desc": "List and search leads",
            "desc": "List leads in Close CRM with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "lead_id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "Filter by lead ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "query": <ActionOptionInfo>{
                    "display_name": "Query",
                    "short_desc": "Search query text",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Search query text to filter leads by name, email, phone, or other "
                        "fields",
                    "preselected": True,
                },
                "status_id": <ActionOptionInfo>{
                    "display_name": "Status ID",
                    "short_desc": "Filter by lead status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter leads by status ID",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                    "preselected": True,
                },
            },
        });

        # Get a Lead
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/leads",
            "action": "get-lead",
            "groups": "Leads",
            "display_name": "Get a Lead",
            "short_desc": "Get a single lead by ID",
            "desc": "Retrieve a single lead by ID from Close CRM",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "lead_id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "The lead ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "leads",
                },
            },
        });

        # ========== CONTACT ACTIONS ==========

        # Create a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/contacts/create",
            "action": "create-contact",
            "groups": "Contacts",
            "display_name": "Create a Contact",
            "short_desc": "Create a new contact",
            "desc": "Create a new contact in Close CRM",
            "action_code": DPAT_API,
            "options": {
                "lead_id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "The lead to associate the contact with",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "leads",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "The contact name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The full name of the contact",
                    "example_value": "Jane Smith",
                    "preselected": True,
                },
                "title": <ActionOptionInfo>{
                    "display_name": "Title",
                    "short_desc": "The contact title",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The job title of the contact",
                    "example_value": "VP of Sales",
                },
                "emails": <ActionOptionInfo>{
                    "display_name": "Email Addresses",
                    "short_desc": "The contact email addresses",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "A list of email address objects, each with type and email fields",
                },
                "phones": <ActionOptionInfo>{
                    "display_name": "Phone Numbers",
                    "short_desc": "The contact phone numbers",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "A list of phone number objects, each with type and phone fields",
                },
                "urls": <ActionOptionInfo>{
                    "display_name": "URLs",
                    "short_desc": "Contact URLs",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of URL objects for the contact",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new CloseContactDataType(); },
        });

        # Update a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/contacts/update",
            "action": "update-contact",
            "groups": "Contacts",
            "display_name": "Update a Contact",
            "short_desc": "Update an existing contact",
            "desc": "Update an existing contact in Close CRM",
            "action_code": DPAT_API,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contacts",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "The contact name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new full name of the contact",
                    "preselected": True,
                },
                "title": <ActionOptionInfo>{
                    "display_name": "Title",
                    "short_desc": "The contact title",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new job title of the contact",
                    "preselected": True,
                },
                "emails": <ActionOptionInfo>{
                    "display_name": "Email Addresses",
                    "short_desc": "The contact email addresses",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "The new list of email address objects",
                },
                "phones": <ActionOptionInfo>{
                    "display_name": "Phone Numbers",
                    "short_desc": "The contact phone numbers",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "The new list of phone number objects",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new CloseContactDataType(); },
        });

        # Delete a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/contacts/delete",
            "action": "delete-contact",
            "groups": "Contacts",
            "display_name": "Delete a Contact",
            "short_desc": "Delete a contact",
            "desc": "Delete a contact from Close CRM",
            "action_code": DPAT_API,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contacts",
                },
            },
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
        });

        # List Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/contacts",
            "action": "find-contacts",
            "groups": "Contacts",
            "display_name": "List Contacts",
            "short_desc": "List and search contacts",
            "desc": "List contacts in Close CRM with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Filter by contact ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "lead_id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "Filter by lead ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter contacts by the lead they belong to",
                    "preselected": True,
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                    "preselected": True,
                },
            },
        });

        # Get a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/contacts",
            "action": "get-contact",
            "groups": "Contacts",
            "display_name": "Get a Contact",
            "short_desc": "Get a single contact by ID",
            "desc": "Retrieve a single contact by ID from Close CRM",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contacts",
                },
            },
        });

        # ========== OPPORTUNITY ACTIONS ==========

        # Create an Opportunity
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/opportunities/create",
            "action": "create-opportunity",
            "groups": "Opportunities",
            "display_name": "Create an Opportunity",
            "short_desc": "Create a new opportunity",
            "desc": "Create a new opportunity in Close CRM",
            "action_code": DPAT_API,
            "options": {
                "lead_id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "The lead to associate the opportunity with",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "leads",
                },
                "status_id": <ActionOptionInfo>{
                    "display_name": "Status ID",
                    "short_desc": "The opportunity status ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the opportunity status to assign",
                },
                "value": <ActionOptionInfo>{
                    "display_name": "Value",
                    "short_desc": "The opportunity value in cents",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The monetary value of the opportunity in cents (e.g., 10000 = $100.00)",
                    "preselected": True,
                },
                "value_period": <ActionOptionInfo>{
                    "display_name": "Value Period",
                    "short_desc": "The value period",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The billing period for the opportunity value",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "one_time",
                            "desc": "One-time payment",
                        },
                        <AllowedValueInfo>{
                            "value": "monthly",
                            "desc": "Monthly recurring",
                        },
                        <AllowedValueInfo>{
                            "value": "annual",
                            "desc": "Annual recurring",
                        },
                    ),
                },
                "confidence": <ActionOptionInfo>{
                    "display_name": "Confidence",
                    "short_desc": "The confidence percentage",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The confidence percentage of winning, from 0 to 100",
                    "preselected": True,
                },
                "note": <ActionOptionInfo>{
                    "display_name": "Note",
                    "short_desc": "Notes about the opportunity",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "A text note with additional context about the opportunity",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The associated contact",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The primary contact for this opportunity",
                    "ref_data": "contacts",
                },
                "value_currency": <ActionOptionInfo>{
                    "display_name": "Value Currency",
                    "short_desc": "The currency code",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "ISO 4217 currency code (e.g., `USD`, `EUR`, `GBP`)",
                    "example_value": "USD",
                },
                "user_id": <ActionOptionInfo>{
                    "display_name": "User ID",
                    "short_desc": "The assigned user",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The user to assign this opportunity to",
                    "ref_data": "users",
                },
                "date_won": <ActionOptionInfo>{
                    "display_name": "Date Won",
                    "short_desc": "Date the opportunity was won",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The date won in YYYY-MM-DD format",
                },
                "date_lost": <ActionOptionInfo>{
                    "display_name": "Date Lost",
                    "short_desc": "Date the opportunity was lost",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The date lost in YYYY-MM-DD format",
                },
            },
            "get_output_type": AbstractDataProviderType sub () {
                return new CloseOpportunityDataType();
            },
        });

        # Update an Opportunity
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/opportunities/update",
            "action": "update-opportunity",
            "groups": "Opportunities",
            "display_name": "Update an Opportunity",
            "short_desc": "Update an existing opportunity",
            "desc": "Update an existing opportunity in Close CRM",
            "action_code": DPAT_API,
            "options": {
                "opportunity_id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "The opportunity to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "opportunities",
                },
                "status_id": <ActionOptionInfo>{
                    "display_name": "Status ID",
                    "short_desc": "The opportunity status ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new status ID to assign",
                    "preselected": True,
                },
                "value": <ActionOptionInfo>{
                    "display_name": "Value",
                    "short_desc": "The opportunity value in cents",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The new monetary value in cents",
                    "preselected": True,
                },
                "value_period": <ActionOptionInfo>{
                    "display_name": "Value Period",
                    "short_desc": "The value period",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new billing period",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "one_time",
                            "desc": "One-time payment",
                        },
                        <AllowedValueInfo>{
                            "value": "monthly",
                            "desc": "Monthly recurring",
                        },
                        <AllowedValueInfo>{
                            "value": "annual",
                            "desc": "Annual recurring",
                        },
                    ),
                },
                "confidence": <ActionOptionInfo>{
                    "display_name": "Confidence",
                    "short_desc": "The confidence percentage",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The new confidence percentage, from 0 to 100",
                },
                "note": <ActionOptionInfo>{
                    "display_name": "Note",
                    "short_desc": "Notes about the opportunity",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The new text note for the opportunity",
                },
            },
            "get_output_type": AbstractDataProviderType sub () {
                return new CloseOpportunityDataType();
            },
        });

        # Delete an Opportunity
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/opportunities/delete",
            "action": "delete-opportunity",
            "groups": "Opportunities",
            "display_name": "Delete an Opportunity",
            "short_desc": "Delete an opportunity",
            "desc": "Delete an opportunity from Close CRM",
            "action_code": DPAT_API,
            "options": {
                "opportunity_id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "The opportunity to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "opportunities",
                },
            },
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
        });

        # List Opportunities
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/opportunities",
            "action": "find-opportunities",
            "groups": "Opportunities",
            "display_name": "List Opportunities",
            "short_desc": "List and search opportunities",
            "desc": "List opportunities in Close CRM with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "opportunity_id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "Filter by opportunity ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "lead_id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "Filter by lead ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter opportunities by the lead they belong to",
                    "preselected": True,
                },
                "status_type": <ActionOptionInfo>{
                    "display_name": "Status Type",
                    "short_desc": "Filter by status type",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter opportunities by status type",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "active",
                            "desc": "Active opportunities",
                        },
                        <AllowedValueInfo>{
                            "value": "won",
                            "desc": "Won opportunities",
                        },
                        <AllowedValueInfo>{
                            "value": "lost",
                            "desc": "Lost opportunities",
                        },
                    ),
                },
                "user_id": <ActionOptionInfo>{
                    "display_name": "User ID",
                    "short_desc": "Filter by assigned user",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter by assigned user ID",
                    "ref_data": "users",
                },
                "status_id": <ActionOptionInfo>{
                    "display_name": "Status ID",
                    "short_desc": "Filter by status ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter by status ID",
                },
                "query": <ActionOptionInfo>{
                    "display_name": "Query",
                    "short_desc": "Search query",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Text search query",
                    "preselected": True,
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                    "preselected": True,
                },
            },
        });

        # Get an Opportunity
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/opportunities",
            "action": "get-opportunity",
            "groups": "Opportunities",
            "display_name": "Get an Opportunity",
            "short_desc": "Get a single opportunity by ID",
            "desc": "Retrieve a single opportunity by ID from Close CRM",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "opportunity_id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "The opportunity ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "opportunities",
                },
            },
        });

        # ========== TASK ACTIONS ==========

        # Create a Task
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CloseDataProvider::AppName,
            "path": "/tasks/create",
