# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires FsUtil
%requires Util

module FileDataProvider {
    version = "2.1.2";
    desc = "User module providing a data provider API for the server filesystem";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factory
        DataProvider::registerFactory(new FileDataProviderFactory());

        # NOTE: this application is also registed in the FilePoller module
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": FileDataProvider::AppName,
            "display_name": "Server Filesystem",
            "short_desc": "Access to the server filesystem",
            "desc": "Access to the server filesystem",
            "scheme": "file",
            "logo": FileWhiteLogo,
            "logo_file_name": "generic-filesystem-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::FileSystem,),
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FileDataProvider::AppName,
            "path": "/copy",
            "action": "copy",
            "display_name": "Copy File",
            "short_desc": "Copy a file on the server filesystem",
            "desc": "Copy a file on the server filesystem",
            "action_code": DPAT_API,
            "output_type": FileTargetResponseDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FileCopyRequestDataType::Fields{"source", "target"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FileCopyRequestDataType::Fields - ("source", "target")
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FileDataProvider::AppName,
            "path": "/create",
            "action": "create",
            "display_name": "Create File",
            "short_desc": "Create a file on the server filesystem",
            "desc": "Create a file on the server filesystem",
            "action_code": DPAT_API,
            "output_type": FilePathDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FileCreateRequestDataType::Fields{"path", "data"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FileCreateRequestDataType::Fields - ("path", "data")
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FileDataProvider::AppName,
            "path": "/delete",
            "action": "delete",
            "display_name": "Delete File",
            "short_desc": "Delete a file on the server filesystem",
            "desc": "Delete a file on the server filesystem",
            "action_code": DPAT_API,
            "output_type": FilePathDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FilePathDataType::Fields{"path",}, {
                    "preselected": True,
                    "required": True,
                },
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FileDataProvider::AppName,
            "path": "/get",
            "action": "get",
            "display_name": "Get File",
            "short_desc": "Get a file on the server filesystem",
            "desc": "Get a file on the server filesystem",
            "action_code": DPAT_API,
            "output_type": FileGetResponseDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FileGetRequestDataType::Fields{"path", "text"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FileGetRequestDataType::Fields - ("path", "text")
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FileDataProvider::AppName,
            "path": "/list",
            "action": "list",
            "display_name": "List Files",
            "short_desc": "List files and subdirectories in a folder on the server filesystem",
            "desc": "List files and subdirectories in a folder on the server filesystem",
            "action_code": DPAT_API,
            "output_type": FileListResponseDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FilePathDataType::Fields{"path",}, {
                    "preselected": True,
                    "required": True,
                },
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FileDataProvider::AppName,
            "path": "/mkdir",
            "action": "mkdir",
            "display_name": "Create Directory",
            "short_desc": "Create a directory on the server filesystem",
            "desc": "Create a directory on the server filesystem",
            "action_code": DPAT_API,
            "output_type": FilePathDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FileMkdirRequestDataType::Fields{"path", "mode"}, {
                    "preselected": True,
                    "required": True,
                },
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FileDataProvider::AppName,
            "path": "/move",
            "action": "move",
            "display_name": "Move File",
            "short_desc": "Move a file or directory on the server filesystem",
            "desc": "Move a file or directory on the server filesystem",
            "action_code": DPAT_API,
            "output_type": FileTargetResponseDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FileMoveRequestDataType::Fields{"source", "target"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FileMoveRequestDataType::Fields - ("source", "target")
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FileDataProvider::AppName,
            "path": "/stat",
            "action": "stat",
            "display_name": "Get Info",
            "short_desc": "Get details about a file or directory on the server filesystem",
            "desc": "Get details about a file or directory on the server filesystem",
            "action_code": DPAT_API,
            "output_type": FileStatResponseDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FileStatRequestDataType::Fields{"path",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FileStatRequestDataType::Fields - ("path")
            ),
        });
    };
}

/** @mainpage FileDataProvider Module

    @tableofcontents

    @section filedataproviderintro Introduction to the FileDataProvider Module

    The %FileDataProvider module provides a data provider API for the server filesystem through the
    @ref dataproviderintro "DataProvider" API.

    The following classes are provided by this module:
    - @ref FileDataProvider::FileCopyDataProvider "FileCopyDataProvider"
    - @ref FileDataProvider::FileCopyRequestDataType "FileCopyRequestDataType"
    - @ref FileDataProvider::FileCreateDataProvider "FileCreateDataProvider"
    - @ref FileDataProvider::FileCreateRequestDataType "FileCreateRequestDataType"
    - @ref FileDataProvider::FileDataProviderFactory "FileDataProviderFactory"
    - @ref FileDataProvider::FileDataProvider "FileDataProvider"
    - @ref FileDataProvider::FileDeleteDataProvider "FileDeleteDataProvider"
    - @ref FileDataProvider::FileGetDataProvider "FileGetDataProvider"
    - @ref FileDataProvider::FileGetRequestDataType "FileGetRequestDataType"
    - @ref FileDataProvider::FileGetResponseDataType "FileGetResponseDataType"
    - @ref FileDataProvider::FileListDataProvider "FileListDataProvider"
    - @ref FileDataProvider::FileListResponseDataType "FileListResponseDataType"
    - @ref FileDataProvider::FileMkdirDataProvider "FileMkdirDataProvider"
    - @ref FileDataProvider::FileMkdirRequestDataType "FileMkdirRequestDataType"
    - @ref FileDataProvider::FileMoveDataProvider "FileMoveDataProvider"
    - @ref FileDataProvider::FileMoveRequestDataType "FileMoveRequestDataType"
    - @ref FileDataProvider::FilePathDataType "FilePathDataType"
    - @ref FileDataProvider::FileStatDataProvider "FileStatDataProvider"
    - @ref FileDataProvider::FileStatRequestDataType "FileStatRequestDataType"
    - @ref FileDataProvider::FileStatResponseDataType "FileStatResponseDataType"
    - @ref FileDataProvider::FileTargetResponseDataType "FileTargetResponseDataType"

    @section filedataprovider_relnotes Release Notes

    @subsection filedataprovider_v2_1_2 FileDataProvider v2.1.2
    - now respects the root directory provided by a connection
      (<a href="https://github.com/qoretechnologies/qore/issues/4949">issue 4949</a>)
    - respects environment variables in the path
      (<a href="https://github.com/qoretechnologies/qore/issues/4950">issue 4950</a>)

    @subsection filedataprovider_v2_0 FileDataProvider v2.0
    - added support for the data provider action catalog API
      (<a href="https://github.com/qoretechnologies/qore/issues/4808">issue 4808</a>)

    @subsection filedataprovider_v1_0 FileDataProvider v1.0
    - initial release of the module
*/

#! contains all public definitions in the FileDataProvider module
public namespace FileDataProvider {
public const FileWhiteLogo = File::readTextFile(get_script_dir() + "/file-logo-white.svg");

public const FileBlackLogo = File::readTextFile(get_script_dir() + "/file-logo-black.svg");
}
