# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) GraphQL >= 1.0
%requires(reexport) Mime >= 1.3
%requires(reexport) HttpServerUtil >= 1.0
%requires(reexport) WebSocketHandler >= 1.0
%requires HttpServerAsyncIo

# the json module is delivered separately from Qore; load it gracefully so deployments
# without the json binary module can still load this module (JSON operations will throw)
%try-module json >= 1.5
%define NoJson
%endtry

%ifdef NoJson
auto sub make_json(auto val, *int flags) {
    throw "JSON-ERROR", "the json module is required for this operation";
}

auto sub parse_json(string val) {
    throw "JSON-ERROR", "the json module is required for this operation";
}
%endif

module GraphQLHandler {
    version = "1.0";
    desc = "User module exposing the GraphQL engine over HTTP and WebSocket";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage GraphQLHandler Module

    @tableofcontents

    @section graphqlhandlerintro GraphQLHandler Introduction

    The %GraphQLHandler module exposes the pure-Qore <a href="https://graphql.org">GraphQL</a>
    execution engine (provided by the @ref graphqlintro "GraphQL" module, which this module
    re-exports) over HTTP through the @ref httpserverintro "HttpServer" and over WebSocket
    (subscriptions via the \c graphql-transport-ws protocol).

    The HTTP handler implements the GraphQL-over-HTTP conventions (POST and GET), document caching,
    persisted queries, request batching, and Server-Sent Events (\c "Accept: text/event-stream",
    distinct-connections mode) for streaming subscription results over plain HTTP.

    To use this module, use \c "%requires GraphQLHandler" in your code. To use just the engine
    (no HTTP dependency), use \c "%requires GraphQL" instead. To generate a schema automatically
    from a @ref dataproviderintro "DataProvider", use the @ref graphqldataproviderintro
    "GraphQLDataProvider" module.

    All the public symbols are defined in the GraphQLHandler namespace.

    @section graphqlhandlercomponents Components

    - the engine classes (@ref GraphQLHandler::GraphQLExecutor "GraphQLExecutor",
      @ref GraphQLHandler::GraphQLSchema "GraphQLSchema", etc.) come from the
      @ref graphqlintro "GraphQL" module
    - @ref GraphQLHandler::GraphQLHandler "GraphQLHandler": exposes a schema + resolvers over HTTP
    - @ref GraphQLHandler::GraphQLWsHandler "GraphQLWsHandler": exposes GraphQL operations (including
      subscriptions) over WebSocket

    @section graphqlhandlerexample Example

    @code{.py}
%requires GraphQLHandler
%requires HttpServer

# define a schema in SDL
string sdl = "
    type Query {
        hello(name: String): String
    }
";

# define resolvers: a hash keyed by type name, then field name
hash<auto> resolvers = {
    "Query": {
        "hello": string sub (auto parent, hash<auto> args, auto ctx) {
            return sprintf("Hello, %s!", args.name ?? "world");
        },
    },
};

GraphQLHandler gh(sdl, resolvers);
HttpServer server(<HttpServerOptionInfo>{});
server.setHandler("graphql", "/graphql", MimeTypeJson, gh, NOTHING, False);
int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    @endcode

    @section graphqlhandlerrelnotes Release Notes

    @subsection graphqlhandlerv1_0 GraphQLHandler v1.0
    - the initial version of the %GraphQLHandler module
*/

#! the GraphQLHandler namespace contains all the objects in the GraphQL and GraphQLHandler modules
/** the GraphQL exception-code constants (\c GRAPHQL_SYNTAX_ERROR, etc.) and the engine classes are
    provided by the re-exported @ref graphqlintro "GraphQL" module
*/
public namespace GraphQLHandler {
}
