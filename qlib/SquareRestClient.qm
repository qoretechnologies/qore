# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) ConnectionProvider >= 1.4

module SquareRestClient {
    version = "1.0";
    desc = "User module for calling Square REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("squareres", SquareRestConnection::ConnectionScheme);
    };
}

/** @mainpage SquareRestClient Module

    @tableofcontents

    @section squarerestclientintro SquareRestClient Introduction

    The %SquareRestClient module provides an API for calling Square REST API services.

    To use this module, use \c "%requires SquareRestClient" in your code.

    All the public symbols in the module are defined in the SquareRestClient namespace.

    The main classes are:
    - @ref SquareRestClient::SquareRestClient "SquareRestClient":
      this class provides the REST client API for communication with the Square API;
      it handles OAuth2 authentication
    - @ref SquareRestClient::SquareRestConnection "SquareRestConnection":
      provides a connection object to Square services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires SquareRestClient

SquareRestClient square({
    "oauth2_client_id": ENV.SQUARE_CLIENT_ID,
    "oauth2_client_secret": ENV.SQUARE_CLIENT_SECRET,
    "oauth2_refresh_token": ENV.SQUARE_REFRESH_TOKEN,
});
hash<auto> result = square.get("merchants/me");
printf("Merchant: %s\n", result.body.merchant[0].business_name);
    @endcode

    @section squarerestclientrelnotes Release Notes

    @subsection squarerestclientv1_0 SquareRestClient v1.0
    - the initial version of the %SquareRestClient module
*/

#! the SquareRestClient namespace contains all the objects in the SquareRestClient module
public namespace SquareRestClient {

#! This class provides the REST client API for communication with Square servers
/** Square uses a REST API at https://connect.squareup.com/v2 with OAuth2 authentication.

    @par Authentication:
    - OAuth2 with Bearer tokens
    - Access tokens expire and are refreshed automatically
    - Refresh tokens are long-lived

    @par API Structure:
    All endpoints are under /v2/ (included in the base URL)
*/
public class SquareRestClient inherits RestClient::RestClient {
    public {
        #! Default Square API URL
        const DefaultUrl = "https://connect.squareup.com/v2";

        #! Default authorization request URL
        const DefaultAuthUrl = "https://connect.squareup.com/oauth2/authorize";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default token request URL
        const DefaultTokenUrl = "https://connect.squareup.com/oauth2/token";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since base URL has /v2)
        const DefaultPingPath = "merchants/me";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OAuth2 scopes
        const DefaultScopes = (
            "CUSTOMERS_READ", "CUSTOMERS_WRITE",
            "ORDERS_READ", "ORDERS_WRITE",
            "PAYMENTS_READ", "PAYMENTS_WRITE",
            "INVOICES_READ", "INVOICES_WRITE",
            "INVENTORY_READ", "INVENTORY_WRITE",
            "ITEMS_READ", "ITEMS_WRITE",
            "APPOINTMENTS_READ", "APPOINTMENTS_WRITE",
            "APPOINTMENTS_ALL_READ", "APPOINTMENTS_ALL_WRITE",
            "MERCHANT_PROFILE_READ",
        );

        #! Default OAuth2 auth args to request offline access (refresh tokens)
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "headers": DefaultHeaders,
            "oauth2_auth_args": DefaultAuthArgs,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "url": DefaultUrl,
        };

        #! OAuth2 options (added when OAuth2 credentials are provided)
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_scopes": DefaultScopes,
        };
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
SquareRestClient square({
    "oauth2_client_id": "your-client-id",
    "oauth2_client_secret": "your-client-secret",
    "oauth2_refresh_token": "your-refresh-token",
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(SquareRestClient::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! returns options for @ref SquareRestClient::SquareRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Check if token-only mode (token provided without OAuth2 credentials)
        bool token_only = opts.token && !opts.oauth2_client_id && !opts.oauth2_client_secret
            && !opts.oauth2_refresh_token;

        if (!token_only && opts.oauth2_client_id) {
            rv += OAuth2Options;
        } else if (opts.token) {
            # Bearer token mode
            rv.headers.Authorization = "Bearer " + opts.token;
            # Remove token from opts so RestClient doesn't add another "Bearer" prefix
            remove rv.token;
        }

        return rv;
    }
}

#! Class for Square REST connections; returns @ref SquareRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref SquareRestClient::SquareRestClient::constructor() for more information on the above options
*/
public class SquareRestConnection inherits RestClient::RestConnection {
    public {
        #! Default connection URL
        const DefaultConnectionUrl = "squareres://connect.squareup.com/v2";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Square REST Connection",
            "short_desc": "A connection to the Square REST API",
            "desc": "A connection to the Square REST API for payments, orders, invoices, "
                "customers, inventory, and bookings",
            "cls": Class::forName("SquareRestConnection"),
            "auto_url": True,
            "schemes": {
                "squareres": True,
            },
            "base_scheme_map": {
                "https": "squareres",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultPingPath,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultScopes,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": SquareRestClient::DefaultTokenUrl,
                },
            },
            "required_options": "oauth2_client_id,oauth2_client_secret",
        };
    }

    #! creates the SquareRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = SquareRestClient::DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the SquareRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
    }

    #! returns \c "squareres"
    string getType() {
        return "squareres";
    }

    #! Returns connection options
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        # Always set OAuth2 URLs
        rv.oauth2_auth_url = SquareRestClient::DefaultAuthUrl;
        rv.oauth2_token_url = SquareRestClient::DefaultTokenUrl;
        if (!rv.oauth2_grant_type) {
            rv.oauth2_grant_type = SquareRestClient::DefaultGrantType;
        }
        if (!rv.oauth2_scopes) {
            rv.oauth2_scopes = SquareRestClient::DefaultScopes;
        }
        if (!rv.oauth2_auth_args) {
            rv.oauth2_auth_args = SquareRestClient::DefaultAuthArgs;
        }
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Square";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the SquareDataProvider and creates the data provider
        # object dynamically
        load_module("SquareDataProvider");
        return create_object("SquareDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != DefaultConnectionUrl) {
                update.url = DefaultConnectionUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref SquareRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref SquareRestClient object
    */
    private SquareRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new SquareRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
