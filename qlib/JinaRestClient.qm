%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes

module JinaRestClient {
    version = "1.1";
    desc = "user module for calling Jina AI REST services for search and content processing";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("jina",
            JinaRestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new JinaEmbedderFactory());
        QoreRagUtils::RagProviderRegistry::registerRerankerFactory(
            new JinaRerankerFactory());
    };
}

/** @mainpage JinaRestClient Module

    @tableofcontents

    @section jinarestclientintro JinaRestClient Introduction

    The %JinaRestClient module provides an API for calling
    [Jina AI](https://jina.ai) REST services — embeddings and reranking.

    Jina exposes:
    - `/v1/embeddings` — embedding models (`jina-embeddings-v3`,
      `jina-embeddings-v2-base-en`, multilingual variants)
    - `/v1/rerank` — reranker models (`jina-reranker-v2-base-multilingual`,
      `jina-colbert-v2` for late-interaction reranking)

    The module registers both an embedder and a reranker into the
    registry provided by @ref qoreragtypesintro "QoreRagTypes". RAG consumers can target Jina
    by setting the backend to \c "jina".

    @par Example:
    @code{.py}
#!/usr/bin/env qore
%modern
%requires JinaRestClient

JinaRestClient rest({"apikey": api_key});
hash<auto> ans = rest.restPost("/embeddings", {
    "model": "jina-embeddings-v3",
    "input": ("Hello, world!",),
});
printf("%Y\n", ans.body);
    @endcode

    @section JinaRestClientRelnotes Release Notes

    @subsection JinaRestClientv1_1 JinaRestClient v1.1
    - verifies API keys with the authenticated batch listing instead of the public model catalog
    - migrates existing public-model and obsolete rate-limit pings, including saved configurations
    - associates connections with the Jina AI app and provides separate embedding/reranking choices

    @subsection JinaRestClientv1_0 JinaRestClient v1.0
    - the initial version of the %JinaRestClient module
*/

%requires json

public namespace JinaRestClient {
public class JinaRestClientBase {
    public {
        const DefaultUrl = "https://api.jina.ai";

        const DefaultApiVersion = "v1";

        #! Default Jina AI embedding model
        const DefaultEmbeddingModel = "jina-embeddings-v3";

        #! Default Jina AI reranking model
        const DefaultRerankModel = "jina-reranker-v2-base-multilingual";

        #! Known model choices; custom model names are accepted for future releases
        const EmbeddingModels = (
            <AllowedValueInfo>{"value": "jina-embeddings-v2-base-en", "display_name": "Jina Embeddings V2 Base En"},
            <AllowedValueInfo>{"value": "jina-embeddings-v2-base-zh", "display_name": "Jina Embeddings V2 Base Zh"},
            <AllowedValueInfo>{"value": "jina-embeddings-v2-base-de", "display_name": "Jina Embeddings V2 Base De"},
            <AllowedValueInfo>{"value": "jina-embeddings-v2-base-es", "display_name": "Jina Embeddings V2 Base Es"},
            <AllowedValueInfo>{"value": "jina-embeddings-v2-base-code", "display_name": "Jina Embeddings V2 Base Code"},
            <AllowedValueInfo>{"value": "jina-embeddings-v3", "display_name": "Jina Embeddings V3"},
            <AllowedValueInfo>{"value": "jina-embeddings-v5-text-nano", "display_name": "Jina Embeddings V5 Text Nano"},
            <AllowedValueInfo>{"value": "jina-embeddings-v5-text-small", "display_name": "Jina Embeddings V5 Text Small"},
            <AllowedValueInfo>{"value": "jina-embeddings-v5-omni-small", "display_name": "Jina Embeddings V5 Omni Small"},
            <AllowedValueInfo>{"value": "jina-embeddings-v5-omni-nano", "display_name": "Jina Embeddings V5 Omni Nano"},
            <AllowedValueInfo>{"value": "jina-embeddings-v4", "display_name": "Jina Embeddings V4"},
            <AllowedValueInfo>{"value": "jina-code-embeddings-0.5b", "display_name": "Jina Code Embeddings 0.5B"},
            <AllowedValueInfo>{"value": "jina-code-embeddings-1.5b", "display_name": "Jina Code Embeddings 1.5B"},
            <AllowedValueInfo>{"value": "jina-clip-v1", "display_name": "Jina Clip V1"},
            <AllowedValueInfo>{"value": "jina-clip-v2", "display_name": "Jina Clip V2"},
            <AllowedValueInfo>{"value": "jina-colbert-v1-en", "display_name": "Jina Colbert V1 En"},
            <AllowedValueInfo>{"value": "jina-colbert-v2", "display_name": "Jina Colbert V2"},
            <AllowedValueInfo>{"value": "elser-v2", "display_name": "Elser V2"},
        );

        #! Known model choices; custom model names are accepted for future releases
        const RerankModels = (
            <AllowedValueInfo>{"value": "jina-reranker-v2-base-multilingual", "display_name": "Jina Reranker V2 Base Multilingual"},
            <AllowedValueInfo>{"value": "jina-reranker-v1-tiny-en", "display_name": "Jina Reranker V1 Tiny En"},
            <AllowedValueInfo>{"value": "jina-reranker-v1-turbo-en", "display_name": "Jina Reranker V1 Turbo En"},
            <AllowedValueInfo>{"value": "jina-reranker-v1-base-en", "display_name": "Jina Reranker V1 Base En"},
            <AllowedValueInfo>{"value": "jina-colbert-v1-en", "display_name": "Jina Colbert V1 En"},
            <AllowedValueInfo>{"value": "jina-colbert-v2", "display_name": "Jina Colbert V2"},
            <AllowedValueInfo>{"value": "jina-reranker-m0", "display_name": "Jina Reranker M0"},
            <AllowedValueInfo>{"value": "jina-reranker-v3", "display_name": "Jina Reranker V3"},
            <AllowedValueInfo>{"value": "jina-reranker-v3.5", "display_name": "Jina Reranker V3.5"},
        );

        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;
        if (opts.api) {
            rv.default_path = "/" + opts.api;
        }
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        # these are connection-level options for downstream consumers (RAG embedder / reranker
        # configuration); they are not REST client options
        remove rv{"embedding-model", "rerank-model"};
        return rv;
    }
}

#! REST client for Jina AI REST API (sync)
public class JinaRestClient inherits RestClient::RestClient, JinaRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(JinaRestClientBase::getOptions(opts), True) {
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(getString(opts, "api") ?? DefaultApiVersion);
        }
    }
}

#! REST client for Jina AI REST API using multiplexed HTTP connections
public class JinaRestClientIo inherits RestClientIo::RestClientIo, JinaRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(JinaRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Jina AI REST connections
public class JinaRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "jina://api.jina.ai";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Jina AI REST Connection",
            "short_desc": "A connection to Jina AI search and content processing APIs",
            "desc": "A connection to the [Jina AI](https://jina.ai) REST API for embeddings "
                "and reranking, classification, content extraction, and batch processing.\n\n"
                "Requires an API key for Bearer authentication.  Get your API key from the "
                "[Jina AI dashboard](https://jina.ai/?sui=apikey).\n\n"
                "The models used when this connection is selected for embeddings and for "
                "reranking are set independently with the `embedding-model` and "
                "`rerank-model` options. The connection ping checks authentication using a "
                "small account batch listing without generating embeddings.",
            "cls": Class::forName("JinaRestConnection"),
            "auto_url": True,
            "schemes": {"jina": True},
            "base_scheme_map": {"https": "jina"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Jina AI API key for authentication",
                    "type": "string",
                    "desc": "The Jina AI API key used for Bearer authentication. Get a key from the "
                        "[Jina AI dashboard](https://jina.ai/api-dashboard/key-manager).",
                    "sensitive": True,
                    "required": True,
                    "preselected": True,
                },
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "The API version to use",
                    "desc": "The API version to use.",
                    "type": "string",
                    "default_value": JinaRestClientBase::DefaultApiVersion,
                    "allowed_values": (<AllowedValueInfo>{"value": "v1", "display_name": "V1"},),
                },
                "embedding-model": <ConnectionOptionInfo>{
                    "display_name": "Embedding Model",
                    "short_desc": "Jina AI embedding model name",
                    "desc": "The Jina AI embedding model used by embedding clients when "
                        "this connection is selected for embeddings; sent as the `model` "
                        "parameter to the `/embeddings` endpoint.\n\n"
                        "Example values: `jina-embeddings-v3` (multilingual, task-aware; the "
                        "default), `jina-embeddings-v2-base-en` (English-only v2), "
                        "`jina-embeddings-v2-base-code` (code-specialized)",
                    "type": "string",
                    "default_value": JinaRestClientBase::DefaultEmbeddingModel,
                    "allowed_values": JinaRestClientBase::EmbeddingModels,
                    "allowed_values_creatable": True,
                },
                "rerank-model": <ConnectionOptionInfo>{
                    "display_name": "Reranking Model",
                    "short_desc": "Jina AI reranking model name",
                    "desc": "The Jina AI reranking model used by reranking clients when "
                        "this connection is selected for reranking; sent as the `model` "
                        "parameter to the `/rerank` endpoint.\n\n"
                        "Reranking models are a separate family from embedding models and "
                        "cannot be used interchangeably.\n\n"
                        "Example values: `jina-reranker-v2-base-multilingual` (multilingual "
                        "cross-encoder; the default), `jina-colbert-v2` (late-interaction, "
                        "multi-vector)",
                    "type": "string",
                    "default_value": JinaRestClientBase::DefaultRerankModel,
                    "allowed_values": JinaRestClientBase::RerankModels,
                    "allowed_values_creatable": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": DefaultPingPath,
                },
            },
            "required_options": "apikey",
        };

        const DefaultPingMethod = "GET";
        const DefaultPingHeaders = {"Accept": MimeTypeJson};
        # The account-scoped listing verifies authentication without running a paid model.
        const DefaultPingPath = "/v1/batches?limit=1";
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, JinaRestConnection::fixPingOptions(options)) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(JinaRestConnection::getConfig(config), attr) {
    }

    #! Loads existing connections with an authenticated ping instead of the old public model listing
    private static hash<auto> fixPingOptions(hash<auto> options) {
        if ((options.ping_method ?? "GET").upr() == "GET"
                && (!exists options.ping_path || options.ping_path == "models"
                    || options.ping_path == "/models" || options.ping_path == "/v1/models"
                    || options.ping_path == "rate_limit" || options.ping_path == "/v1/rate_limit")) {
            options.ping_method = DefaultPingMethod;
            options.ping_path = DefaultPingPath;
        }
        return options;
    }

    private static hash<auto> getConfig(hash<auto> config) {
        config.url = DefaultUrl;
        config.opts = JinaRestConnection::fixPingOptions(config.opts ?? {});
        return config;
    }

    #! Keeps automatically generated connection URLs at Jina's API endpoint
    /** @param update_options the callback that persists corrected connection settings */
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options && url != DefaultUrl && url != JinaRestClientBase::DefaultUrl) {
            doUpdateOptions(self, {"url": DefaultUrl});
        }
    }

    #! Associates the connection with the Jina AI application
    /** @return the registered application name */
    *string getAppName() {
        return "JinaAi";
    }

    #! Verifies the authenticated listing response on synchronous and asynchronous ping transports
    /** @param body the parsed JSON response or raw JSON bytes
        @throw REST-PING-ERROR the response is not a batch listing
    */
    validatePingResponse(auto body) {
        if (getRealOptions().ping_path != DefaultPingPath) {
            return;
        }
        try {
            if (body.typeCode() == NT_BINARY) {
                body = body.toString();
            }
            if (body.typeCode() == NT_STRING) {
                body = parse_json(body);
            }
        } catch (hash<ExceptionInfo> ex) {
            throw "REST-PING-ERROR", "Jina authentication check returned malformed JSON";
        }
        if (body.typeCode() != NT_LIST) {
            throw "REST-PING-ERROR", "Jina authentication check did not return a batch listing";
        }
    }

    string getType() {
        return "jina";
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("JinaDataProvider");
        return create_object("JinaDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private JinaRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new JinaRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new JinaRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return JinaRestClientBase::getOptions(rv);
    }
}
}

public namespace QoreRagUtils {
#! Jina AI-backed embedder — calls the Jina `/embeddings` endpoint
public class JinaEmbedder inherits AbstractEmbedder {
    public {
        const DefaultModel = JinaRestClient::JinaRestClientBase::DefaultEmbeddingModel;
        const Backend = "jina";
    }

    private {
        hash<EmbedderConfig> config;
        string model_name;
        *JinaRestClient::JinaRestClientIo rest_client;
        *int cached_dimension;
        Mutex init_mutex();
    }

    constructor(hash<EmbedderConfig> config) {
        if (!config.api_key.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "JinaEmbedder requires 'api_key' in EmbedderConfig";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }

        hash<auto> body = {
            "model": model_name,
            "input": texts,
        };
        # Jina v3 supports task hint: retrieval.query / retrieval.passage /
        # classification / clustering / separation
        if (exists opts.task) {
            body."task" = opts.task;
        }
        if (exists cached_dimension) {
            body.dimensions = cached_dimension;
        }

        hash<auto> resp = pickRestClient(opts).restPost("/embeddings", body);

        *list<auto> data = resp.body.data;
        if (!exists data) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing 'data' field", Backend),
                {"body": resp.body};
        }
        if (data.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned %d items for %d input texts",
                    Backend, data.size(), texts.size()),
                {"body": resp.body};
        }
        list<hash<auto>> sorted_data = sort(cast<list<hash<auto>>>(data),
            int sub(hash<auto> a, hash<auto> b) {
                return a."index" <=> b."index";
            });

        list<list<float>> result = ();
        foreach hash<auto> item in (sorted_data) {
            list<float> vec = validateAndCastVector(item.embedding, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = vec.size();
            }
            push result, vec;
        }
        return result;
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    *string getModel() {
        return model_name;
    }

    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response item missing 'embedding' field", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    private JinaRestClient::JinaRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new JinaRestClient::JinaRestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "apikey": config.api_key,
        };
        if (config.url.val()) {
            opts.url = config.url;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new JinaRestClient::JinaRestClientIo(buildRestOptions());
            }
        }
    }
}

#! Factory for @ref JinaEmbedder
public class JinaEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "jina";
    }

    string getDisplayName() {
        return "Jina AI embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new JinaEmbedder(config);
    }
}

#! Jina AI-backed reranker — calls the Jina `/rerank` endpoint
public class JinaReranker inherits AbstractReranker {
    public {
        const DefaultModel = JinaRestClient::JinaRestClientBase::DefaultRerankModel;
    }

    private {
        hash<RerankerConfig> config;
        string model_name;
        *JinaRestClient::JinaRestClientIo rest_client;
        Mutex init_mutex();
    }

    constructor(hash<RerankerConfig> config) {
        if (!config.api_key.val()) {
            throw "RERANKER-CONFIG-ERROR",
                "JinaReranker requires 'api_key' in RerankerConfig";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
    }

    list<hash<RerankResult>> rerank(string query, list<string> documents, int top_k,
            *hash<auto> opts) {
        if (!documents) {
            return ();
        }
        ensureRestClient();

        hash<auto> body = {
            "model": model_name,
            "query": query,
            "documents": documents,
            "top_n": top_k,
            "return_documents": True,
        };
        if (opts) {
            # forward Jina-recognized per-call knobs verbatim
            if (exists opts.return_documents) {
                body."return_documents" = opts.return_documents;
            }
        }

        hash<auto> resp = rest_client.restPost("/rerank", body);

        list<hash<auto>> data = resp.body.results ?? ();
        list<hash<RerankResult>> result = ();
        foreach hash<auto> item in (data) {
            int idx = item."index";
            string doc = item.document.typeCode() == NT_STRING
                ? item.document
                : (exists item.document.text ? item.document.text : documents[idx]);
            push result, <RerankResult>{
                "index": idx,
                "score": item.relevance_score.toFloat(),
                "document": doc,
            };
        }
        return result;
    }

    *string getModel() {
        return model_name;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                hash<auto> opts = {
                    "apikey": config.api_key,
                };
                if (config.url.val()) {
                    opts.url = config.url;
                }
                rest_client = new JinaRestClient::JinaRestClientIo(opts);
            }
        }
    }
}

#! Factory for @ref JinaReranker
public class JinaRerankerFactory inherits AbstractRerankerFactory {
    string getType() {
        return "jina";
    }

    string getDisplayName() {
        return "Jina AI rerank";
    }

    AbstractReranker create(hash<RerankerConfig> config) {
        return new JinaReranker(config);
    }
}
}
