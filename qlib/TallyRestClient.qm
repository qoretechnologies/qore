# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module TallyRestClient {
    version = "1.0";
    desc = "user module for calling Tally.so REST API services";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("tally", TallyRestConnection::ConnectionScheme);
    };
}

/** @mainpage TallyRestClient Module

    @tableofcontents

    @section tallyrestclientintro TallyRestClient Introduction

    The %TallyRestClient module provides an API for calling Tally.so REST API services.

    To use this module, use \c "%requires TallyRestClient" in your code.

    All the public symbols in the module are defined in the TallyRestClient namespace.

    The main classes are:
    - @ref TallyRestClient::TallyRestClient "TallyRestClient":
      this class provides the REST client API for communication with the Tally.so REST
      API; it also automates authentication and authorization to the target
    - @ref TallyRestClient::TallyRestConnection "TallyRestConnection":
      provides a REST connection object to Tally.so services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires TallyRestClient
%requires ConnectionProvider

TallyRestClient rest({"apikey": api_key});
hash<auto> ans = rest.get("/forms");
printf("%Y\n", ans.body);
    @endcode

    @section TallyRestClientRelnotes Release Notes

    @subsection TallyRestClientv1_0 TallyRestClient v1.0
    - the initial version of the %TallyRestClient module
*/

#! the TallyRestClient namespace contains all the objects in the TallyRestClient module
public namespace TallyRestClient {
#! Common base class for TallyRestClient functionality
public class TallyRestClientBase {
    public {
        #! Default Tally REST API URL
        const DefaultUrl = "https://api.tally.so";

        #! Default Tally API version header value
        const DefaultApiVersion = "2025-05-30";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "data": "json",
        };

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path
        const DefaultPingPath = "users/me";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };
    }

    #! returns options for the constructor
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        # ensure Accept header is JSON
        if (!rv.headers."Accept") {
            rv.headers."Accept" = MimeTypeJson;
        }
        # add Tally API version header
        if (!rv.headers."tally-version") {
            rv.headers."tally-version" = DefaultApiVersion;
        }
        # map apikey to Authorization: Bearer header
        if (rv.apikey) {
            rv.headers."Authorization" = "Bearer " + rv.apikey;
            remove rv.apikey;
        }
        return rv;
    }
}

#! this class provides the REST client API for communication with Tally.so servers
/** You must use an API key in the 'apikey' option to call Tally APIs.
    The API key is sent as the \c Authorization: \c Bearer header.
*/
public class TallyRestClient inherits RestClient::RestClient, TallyRestClientBase {
    #! creates the object with the given options
    /**
        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class; note
        that the URL is set by default if not provided (see @ref DefaultUrl)
        @param do_not_connect if \c False (the default), then a connection is returned already connected to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(TallyRestClientBase::getOptions(opts), True) {
    }
}

#! Class for Tally REST connections; returns @ref TallyRestClient objects
public class TallyRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Tally REST API URL
        const DefaultUrl = "tally://api.tally.so";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Tally REST Connection",
            "short_desc": "A connection to the Tally.so REST API",
            "desc": "A connection to the Tally.so REST API for form building and management.\n\n"
                "Requires an API key (set as `apikey`) from your "
                "[Tally account settings](https://tally.so/settings/api). "
                "The connection uses the `tally://` URL scheme",
            "cls": Class::forName("TallyRestConnection"),
            "auto_url": True,
            "schemes": {
                "tally": True,
            },
            "base_scheme_map": {
                "https": "tally",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Tally API key for authentication",
                    "type": "string",
                    "desc": "The Tally API key used for authentication; sent as the `Authorization: Bearer` "
                        "header.\n\n"
                        "Get your API key from your [Tally account settings](https://tally.so/settings/api)",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": TallyRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": TallyRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": TallyRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "apikey",
        };
    }

    #! creates the TallyRestConnection object
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the TallyRestConnection object
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! returns \c "tally"
    string getType() {
        return "tally";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the TallyDataProvider and creates the data provider
        # object dynamically
        load_module("TallyDataProvider");
        return create_object("TallyDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
        children_can_support_records = True;
        children_can_support_observers = True;
    }

    #! returns a @ref TallyRestClient object
    private TallyRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new TallyRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new TallyRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Tally REST API using multiplexed HTTP connections
public class TallyRestClientIo inherits RestClientIo::RestClientIo, TallyRestClientBase {
    #! Creates the object with the given options
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(TallyRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
