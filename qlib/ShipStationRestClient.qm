# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module ShipStationRestClient {
    version = "1.0";
    desc = "User module for calling ShipStation REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("shipstation", ShipStationRestConnection::ConnectionScheme);
    };
}

/** @mainpage ShipStationRestClient Module

    @tableofcontents

    @section shipstationrestclientintro ShipStationRestClient Introduction

    The %ShipStationRestClient module provides an API for calling ShipStation's REST API services.

    To use this module, use \c "%requires ShipStationRestClient" in your code.

    All the public symbols in the module are defined in the ShipStationRestClient namespace.

    The main classes are:
    - @ref ShipStationRestClient::ShipStationRestClient "ShipStationRestClient":
      this class provides the REST client API for communication with the ShipStation API;
      it handles authentication via HTTP Basic Auth
    - @ref ShipStationRestClient::ShipStationRestConnection "ShipStationRestConnection":
      provides a connection object to ShipStation services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires ShipStationRestClient

ShipStationRestClient shipstation({"api_key": ENV.SHIPSTATION_API_KEY, "api_secret": ENV.SHIPSTATION_API_SECRET});
hash<auto> result = shipstation.get("/stores");
printf("Stores: %Y\n", result.body);
    @endcode

    @section shipstationrestclientrelnotes Release Notes

    @subsection shipstationrestclientv1_0 ShipStationRestClient v1.0
    - the initial version of the %ShipStationRestClient module
*/

#! the ShipStationRestClient namespace contains all the objects in the ShipStationRestClient module
public namespace ShipStationRestClient {

#! Common base class for ShipStationRestClient functionality
public class ShipStationRestClientBase {
    public {
        #! ShipStation API base URL
        const DefaultApiUrl = "https://ssapi.shipstation.com";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ShipStation ping method
        const DefaultPingMethod = "GET";

        #! Default ShipStation ping path (list stores - lightweight endpoint)
        const DefaultPingPath = "/stores";

        #! Default ShipStation ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Maximum total retry time for 429 errors (75 seconds = 1 minute 15 seconds)
        const MaxRetryTime = 75s;

        #! Initial retry delay for exponential backoff
        const InitialRetryDelay = 1s;

        #! Maximum single retry delay
        const MaxRetryDelay = 30s;

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! returns options for @ref ShipStationRestClient::ShipStationRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Set URL
        rv.url = DefaultApiUrl;

        # Validate api_key is provided
        if (!opts.api_key) {
            throw "SHIPSTATION-ERROR", "missing required option 'api_key' (ShipStation API key)";
        }

        # Validate api_secret is provided
        if (!opts.api_secret) {
            throw "SHIPSTATION-ERROR", "missing required option 'api_secret' (ShipStation API secret)";
        }

        # Set HTTP Basic Auth: username=API_KEY, password=API_SECRET
        rv.username = opts.api_key;
        rv.password = opts.api_secret;

        # Remove custom options so RestClient doesn't try to use them
        remove rv.api_key;
        remove rv.api_secret;

        return rv;
    }
}

#! This class provides the REST client API for communication with ShipStation servers
/** ShipStation uses a REST API with HTTP Basic Auth authentication.

    Authentication is done via HTTP Basic Auth where:
    - Username = API Key
    - Password = API Secret

    @par API Information:
    - Base URL: https://ssapi.shipstation.com
    - Rate Limit: 40 requests per minute per credential set
    - Date Format: ISO 8601 (yyyy-mm-dd hh:mm:ss) in PST/PDT timezone

    @par Rate Limit Handling:
    This client automatically handles HTTP 429 (Too Many Requests) errors by implementing
    retry logic with exponential backoff:
    - Maximum total retry time: 75 seconds (1 minute 15 seconds)
    - Initial retry delay: 1 second
    - Backoff multiplier: 2x (1s, 2s, 4s, 8s, 16s, 30s, 30s...)
    - Maximum single retry delay: 30 seconds
    - Uses Retry-After or X-Rate-Limit-Reset headers when available
*/
public class ShipStationRestClient inherits RestClient::RestClient, ShipStationRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
ShipStationRestClient shipstation({"api_key": "your-api-key", "api_secret": "your-api-secret"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c api_key: the ShipStation API key (required)
        - \c api_secret: the ShipStation API secret (required)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw SHIPSTATION-ERROR missing required option 'api_key' or 'api_secret'
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(ShipStationRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! Makes a REST request with automatic retry on 429 (Too Many Requests) errors
    /** @param m the HTTP method to use
        @param path the URI path to use
        @param body the request body to send (if any)
        @param info an optional reference to a hash that will be used as an output variable giving the response info
        @param decode_errors if @ref True, decode error responses
        @param hdr any headers to use with the request

        @return the response from the server

        This method implements automatic retry with exponential backoff when ShipStation returns
        HTTP 429 (Too Many Requests). It will retry for up to 75 seconds before giving up.
    */
    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info, softbool decode_errors = True,
            *hash<auto> hdr) {
        date start_time = now_us();
        date current_delay = InitialRetryDelay;

        while (True) {
            hash<auto> response = RestClient::doRequest(m, path, body, \info, decode_errors, hdr);

            # Check if we got a 429 error
            if (info.response_code == 429) {
                date elapsed = now_us() - start_time;
                if (elapsed >= MaxRetryTime) {
                    # Max retry time exceeded, return the 429 error
                    return response;
                }

                # Calculate retry delay
                date retry_delay = getRetryDelay(info, current_delay);

                # Check if waiting would exceed max retry time
                if (elapsed + retry_delay > MaxRetryTime) {
                    retry_delay = MaxRetryTime - elapsed;
                    if (retry_delay <= 0s) {
                        return response;
                    }
                }

                # Wait before retrying
                sleep(retry_delay);

                # Increase delay for next retry (exponential backoff)
                current_delay = current_delay * 2;
                if (current_delay > MaxRetryDelay) {
                    current_delay = MaxRetryDelay;
                }
                continue;
            }

            return response;
        }
    }

    #! Returns the retry delay based on response headers or exponential backoff
    /** @param info the response info hash
        @param default_delay the default delay to use if no header is present

        @return the delay to use before retrying
    */
    private date getRetryDelay(hash<auto> info, date default_delay) {
        # Check for Retry-After header (standard HTTP header)
        if (info.headers."retry-after") {
            int secs = info.headers."retry-after".toInt();
            if (secs > 0) {
                return seconds(secs);
            }
        }

        # Check for X-Rate-Limit-Reset header (ShipStation specific)
        if (info.headers."x-rate-limit-reset") {
            int secs = info.headers."x-rate-limit-reset".toInt();
            if (secs > 0) {
                return seconds(secs);
            }
        }

        return default_delay;
    }
}

#! Class for ShipStation REST connections; returns @ref ShipStationRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c api_key: the ShipStation API key (used as username for Basic Auth)
    - \c api_secret: the ShipStation API secret (used as password for Basic Auth)

    @see @ref ShipStationRestClient::ShipStationRestClient::constructor() for more information on the above options
*/
public class ShipStationRestConnection inherits RestClient::RestConnection {
    public {
        #! Default ShipStation API URL
        const DefaultConnectionUrl = "shipstation://ssapi.shipstation.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "ShipStation REST Connection",
            "short_desc": "A connection to the ShipStation REST API",
            "desc": "A connection to the ShipStation REST API for shipping and fulfillment management.\n\n"
                "ShipStation is a web-based shipping software that streamlines order fulfillment for "
                "e-commerce businesses. This integration enables managing orders, shipments, carriers, "
                "products, stores, and warehouses.\n\n"
                "**Important:** This integration uses the ShipStation **V1 API** and requires V1 API "
                "credentials (API Key + API Secret pair). ShipStation V2 API keys are not compatible.",
            "cls": Class::forName("ShipStationRestConnection"),
            "auto_url": True,
            "schemes": {
                "shipstation": True,
            },
            "base_scheme_map": {
                "https": "shipstation",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": ShipStationRestClientBase::DefaultData,
                },
                "api_key": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "ShipStation V1 API key for authentication",
                    "type": "string",
                    "desc": "The ShipStation **V1** API key used as the username for HTTP Basic Auth.\n\n"
                        "**To obtain your V1 API credentials:**\n"
                        "1. Log in to ShipStation at https://app.shipstation.com\n"
                        "2. Click the gear icon (Settings) in the top right\n"
                        "3. Go to **Account > API Settings**\n"
                        "4. Click 'Generate API Keys' if you don't have any\n"
                        "5. Copy your API Key\n\n"
                        "**Important:** This must be a V1 API key (part of an API Key + API Secret pair). "
                        "ShipStation V2 API keys (single token) are not compatible with this integration. "
                        "V1 API keys are available on ShipStation Gold, Scale, or higher-tier plans.",
                    "sensitive": True,
                    "preselected": True,
                },
                "api_secret": <ConnectionOptionInfo>{
                    "display_name": "API Secret",
                    "short_desc": "ShipStation V1 API secret for authentication",
                    "type": "string",
                    "desc": "The ShipStation **V1** API secret used as the password for HTTP Basic Auth.\n\n"
                        "**To obtain your V1 API credentials:**\n"
                        "1. Log in to ShipStation at https://app.shipstation.com\n"
                        "2. Click the gear icon (Settings) in the top right\n"
                        "3. Go to **Account > API Settings**\n"
                        "4. Your API Secret is shown alongside your API Key\n\n"
                        "**Note:** The API Secret is only shown once when generated. "
                        "If you lose it, you'll need to generate new credentials.",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": ShipStationRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": ShipStationRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": ShipStationRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "api_key,api_secret",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your API Credentials",
                    "intent": "info",
                    "content": "This integration requires **ShipStation V1 API credentials** "
                        "(an API Key + API Secret pair).\n\n"
                        "**Steps to generate V1 API credentials:**\n"
                        "1. Log in to ShipStation at https://app.shipstation.com\n"
                        "2. Click the **gear icon** (Settings) in the top right corner\n"
                        "3. Navigate to **Account > API Settings**\n"
                        "4. Make sure **V1** is selected (not V2)\n"
                        "5. Click **Generate API Keys** if you don't have existing credentials\n"
                        "6. Copy both your **API Key** and **API Secret**\n\n"
                        "**Important:**\n"
                        "- The API Secret is only displayed once when generated; store your credentials "
                        "securely\n"
                        "- V1 API credentials are available on ShipStation **Gold, Scale, or higher-tier** "
                        "plans\n"
                        "- ShipStation also offers **V2 API keys** (a single token); these are **not "
                        "compatible** with this integration",
                },
            ),
        };
    }

    #! creates the ShipStationRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the ShipStationRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(ShipStationRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref ShipStationRestConnection::constructor()
    /** Constructs the connection URL (ShipStation has only one API endpoint)
    */
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": DefaultConnectionUrl,
        };
    }

    #! returns \c "shipstation"
    string getType() {
        return "shipstation";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the @ref getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        return "ShipStation";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the ShipStationDataProvider and creates the data provider
        # object dynamically
        load_module("ShipStationDataProvider");
        return create_object("ShipStationDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    /** The closure or call reference must have the following signature:
        <tt>update_options(hash<auto> options)</tt>
    */
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        # update the URL immediately if necessary
        if (update_options && url != DefaultConnectionUrl) {
            # NOTE: do not update the URL or real URL values here, or the external update will fail, because it will
            # believe that no changes are necessary
            doUpdateOptions(self, {
                "url": DefaultConnectionUrl,
            });
        }
    }

    #! returns a @ref ShipStationRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref ShipStationRestClient object
    */
    private ShipStationRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new ShipStationRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since ShipStationRestClient 1.1
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new ShipStationRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! ShipStation REST client for non-blocking I/O
public class ShipStationRestClientIo inherits RestClientIo::RestClientIo, ShipStationRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(ShipStationRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
