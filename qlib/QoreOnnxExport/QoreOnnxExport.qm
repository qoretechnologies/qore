# minimum required Qore version
%requires qore >= 2.0
%modern

%requires protobuf
%requires ml
%requires Util

module QoreOnnxExport {
    version = "1.0.0";
    desc = "user module providing ONNX model export for trained ML models";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreOnnxExport Module

    @tableofcontents

    @section qoreonnxexportintro QoreOnnxExport Module Introduction

    The %QoreOnnxExport module exports trained %Qore ML models to ONNX (Open Neural
    Network Exchange) format. The exported \c .onnx files can be loaded by any
    ONNX-compatible runtime — ONNX Runtime, TensorFlow, PyTorch, etc. — enabling
    interoperability between Qore's ML module and the broader ML ecosystem.

    The module uses the \c protobuf built-in module to serialize ONNX ModelProto
    messages in the standard protobuf binary format.

    @section qoreonnxexportalgos Supported Algorithms

    |!Algorithm|!ONNX Graph|!Notes
    |@ref ML::StandardScaler "StandardScaler"|<code>Sub</code> → <code>Div</code>|Feature normalization
    |@ref ML::MinMaxScaler "MinMaxScaler"|<code>Sub</code> → <code>Div</code> → <code>Mul</code> → <code>Add</code>|Range scaling
    |@ref ML::Imputer "Imputer"|<code>IsNaN</code> → <code>Where</code>|Missing value replacement
    |@ref ML::LinearRegression "LinearRegression"|<code>MatMul</code> → <code>Add</code>|Linear prediction
    |@ref ML::LogisticRegression "LogisticRegression"|<code>MatMul</code> → <code>Add</code> → <code>Sigmoid</code>/<code>Softmax</code>|Classification
    |@ref ML::PCA "PCA"|<code>Sub</code> [→ <code>Div</code>] → <code>MatMul</code>|Dimensionality reduction
    |@ref ML::KMeans "KMeans"|Distance computation → <code>ArgMin</code>|Cluster assignment
    |@ref ML::DecisionTree "DecisionTree"|<code>TreeEnsembleClassifier</code> or <code>TreeEnsembleRegressor</code>|Classification and regression
    |@ref ML::RandomForest "RandomForest"|<code>TreeEnsembleClassifier</code> or <code>TreeEnsembleRegressor</code>|Ensemble with averaging
    |@ref ML::GradientBoostedTrees "GradientBoostedTrees"|<code>TreeEnsembleRegressor</code> → <code>Sigmoid</code>/<code>Softmax</code>|Boosted ensemble with post-processing
    |@ref ML::IsolationForest "IsolationForest"|<code>TreeEnsembleRegressor</code> → score|Anomaly detection

    @note All tensor data is exported as \c float (32-bit). Qore ML models use
    \c double (64-bit) internally, so there is a minor precision reduction in the
    exported model. This is standard practice for ML model interchange.

    @par Example: Export to binary
    @code{.py}
%requires QoreOnnxExport
%requires ml

# Train a model
ML::LinearRegression lr({"fit_intercept": True});
lr.fitMatrix(training_X, training_y);

# Export to ONNX binary
binary onnx_data = QoreOnnxExport::OnnxExporter::export(lr, "my_model");
    @endcode

    @par Example: Export to file
    @code{.py}
QoreOnnxExport::OnnxExporter::exportToFile(lr, "model.onnx");
    @endcode

    @par Example: Export and reload with OnnxModel
    @code{.py}
# Export
QoreOnnxExport::OnnxExporter::exportToFile(lr, "/tmp/model.onnx");

# Load with ONNX Runtime (if available)
ML::OnnxModel onnx_model("/tmp/model.onnx");
list<auto> predictions = onnx_model.predict(test_X);
    @endcode

    @section qoreonnxexportrelnotes QoreOnnxExport Module Release Notes

    @subsection qoreonnxexport_1_0 QoreOnnxExport Module Version 1.0
    - Initial release with ONNX export for 8 ML algorithms
    - StandardScaler, MinMaxScaler, Imputer, LinearRegression,
      LogisticRegression, PCA, KMeans, IsolationForest
    - Uses protobuf built-in module for ONNX protobuf serialization
    - Supports ONNX opset 18 (ai.onnx) and opset 1 (ai.onnx.ml)
*/
