%requires qore >= 2.0
%modern

%requires reflection

module QoreMediaUtils {
    version = "1.0";
    desc = "user module providing the provider-neutral abstraction layer for "
        "image and video generation backends";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreMediaUtils Module

    @tableofcontents

    @section qoremediautilsintro QoreMediaUtils Module Introduction

    The %QoreMediaUtils module provides the provider-neutral abstraction
    layer for generative media (image + video) — parallel to
    @ref qoreragutilsintro "QoreRagUtils" for retrieval-augmented
    generation and @ref qorespeechutilsintro "QoreSpeechUtils" for ASR + TTS.

    Two abstract building blocks:
    - @ref QoreMediaUtils::AbstractImageGenerator — text-to-image,
      image-to-image, and image editing
    - @ref QoreMediaUtils::AbstractVideoGenerator — text-to-video,
      image-to-video, and video editing

    Each comes with a factory + registry pair mirroring the
    QoreRagUtils / QoreSpeechUtils pattern.  Provider modules register
    their factories on module load; callers select a backend by name
    via @ref ImageGeneratorConfig::backend and
    @ref VideoGeneratorConfig::backend, and the registry lazy-loads
    the providing module on first lookup.

    @par Example: generate an image via Stability AI

    @code{.py}
%modern
%requires QoreMediaUtils
%requires StabilityAiRestClient

QoreMediaUtils::AbstractImageGenerator gen =
    QoreMediaUtils::MediaProviderRegistry::createImageGenerator(
        <QoreMediaUtils::ImageGeneratorConfig>{
            "backend": "stability-ai",
            "api_key": api_key,
            "model":   "ultra",
        });
hash<QoreMediaUtils::ImageResult> r =
    gen.generateImage("a serene mountain landscape at sunrise");
File f();
f.open2("/tmp/out.png", O_CREAT | O_WRONLY | O_TRUNC);
f.write(r.image);
    @endcode

    @section qoremediautilsrelnotes Release Notes

    @subsection qoremediautils_1_0 QoreMediaUtils v1.0
    - initial version
    - detect image/audio/GLB signatures and validate response MIME agreement
    - read PNG/JPEG/WebP dimensions and WAV/MP3 duration before uploading media
*/

#! contains all public symbols of the %QoreMediaUtils module
public namespace QoreMediaUtils {

#! Identifies supported image, audio, and GLB containers by their byte signatures
/** This is a container check, not a full decoder. Callers needing dimensions or playable content must
    decode the result with the appropriate image or audio library.
    @param content media bytes
    @return detected MIME type, or @ref nothing for an unsupported or truncated signature
*/
public *string sub identifyMediaContentType(binary content) {
    string prefix = make_hex_string(content[0..31]).lwr();
    if (content.size() >= 24 && prefix =~ /^89504e470d0a1a0a0000000d49484452/) { return "image/png"; }
    if (content.size() >= 4 && prefix =~ /^ffd8ff/) { return "image/jpeg"; }
    if (content.size() >= 12 && prefix =~ /^52494646........57454250/) { return "image/webp"; }
    if (content.size() >= 12 && prefix =~ /^52494646........57415645/) { return "audio/wav"; }
    if (content.size() >= 10 && prefix =~ /^(494433|fff[23ab]|ffe[23])/) { return "audio/mpeg"; }
    if (content.size() >= 4 && prefix =~ /^664c6143/) { return "audio/flac"; }
    if (content.size() >= 27 && prefix =~ /^4f676753/) { return "audio/ogg"; }
    if (content.size() >= 12 && prefix =~ /^676c544602000000/) { return "model/gltf-binary"; }
    return NOTHING;
}

#! Reads dimensions from a PNG, JPEG, or WebP container without decompressing pixels
/** @param content image bytes
    @return width and height from the image header
    @throw MEDIA-INPUT-ERROR unsupported or truncated image header
    @note Header validation does not replace a complete image decoder.
*/
public hash<string, int> sub getImageDimensions(binary content) {
    *string type = identifyMediaContentType(content);
    int width;
    int height;
    if (type == "image/png") {
        width = make_hex_string(content[16..19]).toInt(16);
        height = make_hex_string(content[20..23]).toInt(16);
    } else if (type == "image/webp" && content.size() >= 25) {
        string chunk = binary_to_string(content[12..15], "US-ASCII");
        if (chunk == "VP8X" && content.size() >= 30) {
            width = 1 + get_byte(content, 24) + (get_byte(content, 25) << 8) + (get_byte(content, 26) << 16);
            height = 1 + get_byte(content, 27) + (get_byte(content, 28) << 8) + (get_byte(content, 29) << 16);
        } else if (chunk == "VP8 " && content.size() >= 30 && content[23..25] == <9d012a>) {
            width = (get_byte(content, 26) + (get_byte(content, 27) << 8)) & 0x3fff;
            height = (get_byte(content, 28) + (get_byte(content, 29) << 8)) & 0x3fff;
        } else if (chunk == "VP8L" && get_byte(content, 20) == 0x2f) {
            width = 1 + get_byte(content, 21) + ((get_byte(content, 22) & 0x3f) << 8);
            height = 1 + (get_byte(content, 22) >> 6) + (get_byte(content, 23) << 2)
                + ((get_byte(content, 24) & 0xf) << 10);
        }
    } else if (type == "image/jpeg") {
        int offset = 2;
        while (offset + 3 < content.size()) {
            if (get_byte(content, offset++) != 0xff) { break; }
            while (offset < content.size() && get_byte(content, offset) == 0xff) { ++offset; }
            if (offset + 2 >= content.size()) { break; }
            int marker = get_byte(content, offset++);
            if (marker == 0xd9 || marker == 0xda) { break; }
            if (marker == 0x01 || (marker >= 0xd0 && marker <= 0xd7)) { continue; }
            int length = (get_byte(content, offset) << 8) + get_byte(content, offset + 1);
            if (length < 2 || offset + length > content.size()) { break; }
            if (inlist(marker, (0xc0, 0xc1, 0xc2, 0xc3, 0xc5, 0xc6, 0xc7, 0xc9, 0xca, 0xcb, 0xcd, 0xce, 0xcf))
                    && length >= 8) {
                height = (get_byte(content, offset + 3) << 8) + get_byte(content, offset + 4);
                width = (get_byte(content, offset + 5) << 8) + get_byte(content, offset + 6);
                break;
            }
            offset += length;
        }
    }
    if (width <= 0 || height <= 0) { throw "MEDIA-INPUT-ERROR", "unsupported or truncated image dimensions"; }
    return {"width": width, "height": height};
}

#! Checks that a supported media signature agrees with the declared response MIME type
/** @param content media bytes
    @param declared_type optional HTTP content type; parameters and common audio aliases are accepted
    @return canonical detected MIME type
    @throw MEDIA-RESPONSE-ERROR unsupported, truncated, or mismatched media
*/
public string sub validateMediaContentType(binary content, *string declared_type) {
    *string actual = identifyMediaContentType(content);
    *string declared = declared_type ? trim(declared_type.split(";")[0]).lwr() : NOTHING;
    if (inlist(declared, ("audio/mp3",))) { declared = "audio/mpeg"; }
    if (inlist(declared, ("audio/x-wav", "audio/wave"))) { declared = "audio/wav"; }
    if (!actual || (declared.val() && declared != actual)) {
        throw "MEDIA-RESPONSE-ERROR", "response bytes do not match a supported media content type";
    }
    return actual;
}

#! Reads the duration of PCM/float WAV or framed MPEG Layer III audio without decoding samples
/** @param content complete WAV or MP3 bytes
    @return duration in seconds
    @throw MEDIA-INPUT-ERROR unsupported, empty, or truncated audio container
    @note This validates container framing, not decoded audio quality. MP3 duration includes encoder padding.
*/
public float sub getAudioDuration(binary content) {
    string mime = validateMediaContentType(content);
    float duration = 0.0;
    if (mime == "audio/wav") {
        code<int(int)> le32 = int sub (int offset) {
            return get_byte(content, offset) + (get_byte(content, offset + 1) << 8)
                + (get_byte(content, offset + 2) << 16) + (get_byte(content, offset + 3) << 24);
        };
        int limit = le32(4) + 8;
        if (limit > content.size()) { throw "MEDIA-INPUT-ERROR", "truncated WAV container"; }
        int offset = 12;
        int rate;
        int alignment;
        int data_size;
        while (offset + 8 <= limit) {
            string chunk = binary_to_string(content[offset..offset + 3], "US-ASCII");
            int length = le32(offset + 4);
            offset += 8;
            if (offset + length > limit) { throw "MEDIA-INPUT-ERROR", "truncated WAV chunk"; }
            if (chunk == "fmt " && length >= 16) {
                int format = get_byte(content, offset) + (get_byte(content, offset + 1) << 8);
                if (format == 65534 && length >= 40) {
                    format = get_byte(content, offset + 24) + (get_byte(content, offset + 25) << 8);
                }
                if (!inlist(format, (1, 3))) { throw "MEDIA-INPUT-ERROR", "WAV must use PCM or IEEE float samples"; }
                rate = le32(offset + 4);
                alignment = get_byte(content, offset + 12) + (get_byte(content, offset + 13) << 8);
            } else if (chunk == "data") { data_size += length; }
            offset += length + (length % 2);
        }
        if (rate > 0 && alignment > 0 && data_size % alignment == 0) {
            duration = float(data_size) / alignment / rate;
        }
    } else if (mime == "audio/mpeg") {
        int offset = 0;
        if (content[0..2] == <494433>) {
            int tag_size = 0;
            for (int i = 6; i < 10; ++i) {
                int byte = get_byte(content, i);
                if (byte & 128) { throw "MEDIA-INPUT-ERROR", "invalid ID3 tag size"; }
                tag_size = (tag_size << 7) + byte;
            }
            offset = 10 + tag_size + ((get_byte(content, 5) & 16) ? 10 : 0);
        }
        while (offset + 4 <= content.size()) {
            # ID3v1 tags can follow the final complete MPEG frame.
            if (content.size() - offset == 128 && content[offset..offset + 2] == <544147>) { break; }
            int b1 = get_byte(content, offset + 1);
            int b2 = get_byte(content, offset + 2);
            int version = (b1 >> 3) & 3;
            int bitrate_index = b2 >> 4;
            int sample_index = (b2 >> 2) & 3;
            if (get_byte(content, offset) != 255 || (b1 & 224) != 224 || version == 1
                    || ((b1 >> 1) & 3) != 1 || !bitrate_index || bitrate_index == 15 || sample_index == 3) {
                throw "MEDIA-INPUT-ERROR", "unsupported or invalid MP3 frame";
            }
            list<int> bitrates = version == 3 ? (0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320)
                : (0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160);
            int rate = int((44100, 48000, 32000)[sample_index] / (version == 3 ? 1 : version == 2 ? 2 : 4));
            int samples = version == 3 ? 1152 : 576;
            int length = int((version == 3 ? 144000 : 72000) * bitrates[bitrate_index] / rate) + ((b2 >> 1) & 1);
            if (offset + length > content.size()) { throw "MEDIA-INPUT-ERROR", "truncated MP3 frame"; }
            duration += float(samples) / rate;
            offset += length;
        }
        if (offset > content.size() || (offset != content.size() && content.size() - offset != 128)) {
            throw "MEDIA-INPUT-ERROR", "truncated MP3 data";
        }
    }
    if (duration <= 0.0) { throw "MEDIA-INPUT-ERROR", "unsupported or empty audio container"; }
    return duration;
}

#! Configuration for an image-generator backend
public hashdecl ImageGeneratorConfig {
    #! Backend identifier (e.g. \c "stability-ai", \c "bfl")
    *string backend;
    #! API key for the backend
    *string api_key;
    #! Default model / engine (provider-specific name)
    *string model;
    #! Default output format (\c "png", \c "jpeg", \c "webp")
    *string output_format;
    #! Default aspect ratio / size (provider-specific)
    *string aspect_ratio;
    #! Default request URL (overrides the backend's hardcoded default)
    *string url;
    #! Free-form backend-specific options forwarded to the underlying call
    *hash<auto> provider_options;
}

#! Configuration for a video-generator backend
public hashdecl VideoGeneratorConfig {
    #! Backend identifier (e.g. \c "bfl", \c "runway", \c "luma")
    *string backend;
    #! API key for the backend
    *string api_key;
    #! Default model / engine (provider-specific name)
    *string model;
    #! Default duration in seconds (provider-specific support varies)
    *int duration_seconds;
    #! Default frames per second (provider-specific support varies)
    *int fps;
    #! Default aspect ratio (provider-specific)
    *string aspect_ratio;
    #! Default request URL (overrides the backend's hardcoded default)
    *string url;
    #! Free-form backend-specific options forwarded to the underlying call
    *hash<auto> provider_options;
}

#! Result of an image-generation call
public hashdecl ImageResult {
    #! Raw image bytes (PNG / JPEG / WebP, per the requested format)
    binary image;
    #! MIME type of the returned image
    *string content_type;
    #! Provider-supplied seed used for this image (for reproducibility)
    *int seed;
    #! Model that produced the image
    *string model;
    #! Provider-specific metadata (request ID, finish reason, NSFW flags, ...)
    *hash<auto> metadata;
}

#! Result of a video-generation call
public hashdecl VideoResult {
    #! Raw video bytes (typically MP4)
    *binary video;
    #! URL where the video can be downloaded (some backends return URLs rather than bytes)
    *string video_url;
    #! MIME type of the returned video
    *string content_type;
    #! Duration in seconds, when reported
    *float duration_seconds;
    #! Model that produced the video
    *string model;
    #! Provider-specific metadata (job ID, finish reason, ...)
    *hash<auto> metadata;
}

#! Static info describing what a media-provider factory produces
public hashdecl MediaProviderInfo {
    #! Provider mode (e.g. \c "stability-ai", \c "bfl")
    string mode;
    #! Human-readable display name
    string display_name;
    #! The Qore module providing the factory
    *string module_name;
}

#! Abstract base for an image-generation provider
public class AbstractImageGenerator {
    #! Generates an image from a text prompt
    /** @param prompt the text prompt describing the desired image
        @param opts optional per-call options forwarded to the backend
            (e.g. \c negative_prompt, \c seed, \c steps, \c cfg_scale,
            \c aspect_ratio, \c style_preset)

        @return an @ref ImageResult with the raw image bytes
    */
    abstract hash<ImageResult> generateImage(string prompt, *hash<auto> opts);

    #! Returns the backend mode (e.g. \c "stability-ai")
    abstract string getMode();

    #! Returns the model in use, when set (informational)
    *string getModel() {
        return NOTHING;
    }
}

#! Abstract base for a video-generation provider
public class AbstractVideoGenerator {
    #! Generates a video from a text prompt
    /** @param prompt the text prompt describing the desired video
        @param opts optional per-call options forwarded to the backend
            (e.g. \c image (text-to-video can become image-to-video with
            a starting frame), \c duration_seconds, \c fps, \c seed,
            \c aspect_ratio)

        @return a @ref VideoResult with the raw video bytes or download URL
    */
    abstract hash<VideoResult> generateVideo(string prompt, *hash<auto> opts);

    #! Returns the backend mode (e.g. \c "bfl")
    abstract string getMode();

    #! Returns the model in use, when set (informational)
    *string getModel() {
        return NOTHING;
    }
}

#! Abstract factory for an image generator
public class AbstractImageGeneratorFactory {
    #! Returns the backend mode (e.g. \c "stability-ai")
    abstract string getMode();

    #! Returns a human-readable display name
    abstract string getDisplayName();

    #! Creates an image generator instance from an @ref ImageGeneratorConfig
    abstract AbstractImageGenerator create(hash<ImageGeneratorConfig> config);

    #! Returns static info about the image generator this factory creates
    hash<MediaProviderInfo> getInfo() {
        return <MediaProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
        };
    }
}

#! Abstract factory for a video generator
public class AbstractVideoGeneratorFactory {
    #! Returns the backend mode (e.g. \c "bfl")
    abstract string getMode();

    #! Returns a human-readable display name
    abstract string getDisplayName();

    #! Creates a video generator instance from a @ref VideoGeneratorConfig
    abstract AbstractVideoGenerator create(hash<VideoGeneratorConfig> config);

    #! Returns static info about the video generator this factory creates
    hash<MediaProviderInfo> getInfo() {
        return <MediaProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
        };
    }
}

#! Central registry of media-provider factories with lazy module loading
/** Each entry in @ref ImageGeneratorModuleMap / @ref VideoGeneratorModuleMap
    maps a backend name to the Qore module that ships the matching
    factory; the module is lazy-loaded on first lookup.
*/
public class MediaProviderRegistry {
    public {
        #! Map of image-generator backend names to providing modules
        const ImageGeneratorModuleMap = {
            "stability-ai": "StabilityAiRestClient",
            "bfl":          "BflRestClient",
        };

        #! Map of video-generator backend names to providing modules
        const VideoGeneratorModuleMap = {
            "bfl":          "BflRestClient",
        };
    }

    private {
        static hash<string, AbstractImageGeneratorFactory> image_cache = {};
        static hash<string, AbstractVideoGeneratorFactory> video_cache = {};
        static Mutex registry_lock();
    }

    #! Registers an image-generator factory
    /** @throw MEDIA-CONFIG-ERROR a factory for the same mode is already registered
    */
    static registerImageGeneratorFactory(AbstractImageGeneratorFactory factory) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        string mode = factory.getMode();
        if (image_cache{mode}) {
            throw "MEDIA-CONFIG-ERROR",
                sprintf("image-generator factory for %y has already been "
                    "registered", mode);
        }
        image_cache{mode} = factory;
    }

    #! Registers a video-generator factory
    /** @throw MEDIA-CONFIG-ERROR a factory for the same mode is already registered
    */
    static registerVideoGeneratorFactory(AbstractVideoGeneratorFactory factory) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        string mode = factory.getMode();
        if (video_cache{mode}) {
            throw "MEDIA-CONFIG-ERROR",
                sprintf("video-generator factory for %y has already been "
                    "registered", mode);
        }
        video_cache{mode} = factory;
    }

    #! Removes an image-generator factory (intended for tests)
    static deregisterImageGeneratorFactory(string mode) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        remove image_cache{mode};
    }

    #! Removes a video-generator factory (intended for tests)
    static deregisterVideoGeneratorFactory(string mode) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        remove video_cache{mode};
    }

    #! Returns the image-generator factory for the given mode, lazy-loading if needed
    static *AbstractImageGeneratorFactory getImageGeneratorFactory(string mode) {
        if (image_cache{mode}) {
            return image_cache{mode};
        }
        *string module_name = ImageGeneratorModuleMap{mode};
        if (!module_name) {
            return NOTHING;
        }
        try {
            load_module(module_name);
        } catch (hash<ExceptionInfo> ex) {
            throw "MEDIA-CONFIG-ERROR",
                sprintf("cannot load provider module %y for image-generator %y: %s",
                    module_name, mode, ex.desc), ex;
        }
        return image_cache{mode};
    }

    #! Returns the image-generator factory or throws
    static AbstractImageGeneratorFactory getImageGeneratorFactoryEx(string mode) {
        *AbstractImageGeneratorFactory f = getImageGeneratorFactory(mode);
        if (!f) {
            throw "MEDIA-CONFIG-ERROR",
                sprintf("image-generator backend %y is unknown; registered "
                    "backends: %y; backends available via lazy module load: %y",
                    mode, keys image_cache, keys ImageGeneratorModuleMap);
        }
        return f;
    }

    #! Returns the video-generator factory for the given mode, lazy-loading if needed
    static *AbstractVideoGeneratorFactory getVideoGeneratorFactory(string mode) {
        if (video_cache{mode}) {
            return video_cache{mode};
        }
        *string module_name = VideoGeneratorModuleMap{mode};
        if (!module_name) {
            return NOTHING;
        }
        try {
            load_module(module_name);
        } catch (hash<ExceptionInfo> ex) {
            throw "MEDIA-CONFIG-ERROR",
                sprintf("cannot load provider module %y for video-generator %y: %s",
                    module_name, mode, ex.desc), ex;
        }
        return video_cache{mode};
    }

    #! Returns the video-generator factory or throws
    static AbstractVideoGeneratorFactory getVideoGeneratorFactoryEx(string mode) {
        *AbstractVideoGeneratorFactory f = getVideoGeneratorFactory(mode);
        if (!f) {
            throw "MEDIA-CONFIG-ERROR",
                sprintf("video-generator backend %y is unknown; registered "
                    "backends: %y; backends available via lazy module load: %y",
                    mode, keys video_cache, keys VideoGeneratorModuleMap);
        }
        return f;
    }

    #! Constructs an image generator for the given @ref ImageGeneratorConfig
    /** @throw MEDIA-CONFIG-ERROR @ref ImageGeneratorConfig::backend is missing or unknown
    */
    static AbstractImageGenerator createImageGenerator(
            hash<ImageGeneratorConfig> config) {
        if (!config.backend.val()) {
            throw "MEDIA-CONFIG-ERROR",
                "ImageGeneratorConfig.backend is required for factory lookup";
        }
        return getImageGeneratorFactoryEx(config.backend).create(config);
    }

    #! Constructs a video generator for the given @ref VideoGeneratorConfig
    /** @throw MEDIA-CONFIG-ERROR @ref VideoGeneratorConfig::backend is missing or unknown
    */
    static AbstractVideoGenerator createVideoGenerator(
            hash<VideoGeneratorConfig> config) {
        if (!config.backend.val()) {
            throw "MEDIA-CONFIG-ERROR",
                "VideoGeneratorConfig.backend is required for factory lookup";
        }
        return getVideoGeneratorFactoryEx(config.backend).create(config);
    }

    #! Returns known image-generator backends (registered + lazy-loadable)
    static list<string> knownImageGeneratorBackends() {
        return sort(keys (image_cache + ImageGeneratorModuleMap));
    }

    #! Returns known video-generator backends (registered + lazy-loadable)
    static list<string> knownVideoGeneratorBackends() {
        return sort(keys (video_cache + VideoGeneratorModuleMap));
    }
}
}
