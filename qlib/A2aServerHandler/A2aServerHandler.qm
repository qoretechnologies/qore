# minimum qore version
%requires qore >= 2.0
%requires json
%requires Mime
%requires Util
%requires HttpServerUtil
%requires ServerSentEventHandler
%requires JsonRpcHandler
%requires Logger
%requires DataProvider
%requires(reexport) A2aClient
%try-module uuid
%define NoUuid
%endtry

%modern

module A2aServerHandler {
    version = "1.0";
    desc = "A2aServerHandler module for use with the Qore HttpServer module";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage A2aServerHandler Module

    @tableofcontents

    @section a2aserverhandlerintro Introduction to the A2aServerHandler Module

    The %A2aServerHandler module provides server-side support for the Agent-to-Agent (A2A)
    protocol using the HttpServer module. It enables agents to accept messages, manage tasks,
    stream responses, and handle push notification configurations via JSON-RPC 2.0 over HTTP
    and Server-Sent Events (SSE).

    This module implements the A2A protocol specification with dual-version support
    for both v0.3 and v1.0 clients simultaneously.

    The following classes are provided by this module:
    - @ref A2aServerHandler::A2aServerHandler "A2aServerHandler"
    - @ref A2aServerHandler::A2aServerConnection "A2aServerConnection"

    @subsection A2aServer_intro_basic Basic server setup
    @code{.py}
    %requires A2aServerHandler
    %requires HttpServer

    Logger logger("a2a-server", LoggerLevel::getLevelInfo());
    A2aServerHandler::A2aServerHandler handler(logger, <A2aAgentCard>{
        "name": "MyAgent",
        "description": "An example A2A agent",
        "url": "http://localhost:8080",
        "version": "1.0",
        "capabilities": <A2aAgentCapabilities>{
            "streaming": True,
            "pushNotifications": True,
        },
        "skills": (<A2aAgentSkill>{
            "id": "chat",
            "name": "Chat",
            "description": "General chat capability",
        },),
    });

    # Register a message handler
    handler.setMessageHandler(sub (hash<auto> task_info, hash<A2aMessage> msg) {
        # Process the message and return a response message
        return <A2aMessage>{
            "role": "agent",
            "parts": ({"type": "text", "text": "Hello from the agent!"},),
        };
    });

    # Start HTTP server
    HttpServer http({"logger": logger});
    http.setHandler("a2a", "", MimeTypeJson, handler);
    http.setDefaultHandler("a2a", handler);
    http.addListener({"service": 8080});
    @endcode

    @section A2aServerHandler_relnotes A2aServerHandler Release Notes

    @subsection A2aServerHandler_1_0 A2aServerHandler v1.0
    - initial release with A2A v0.3 and v1.0 dual-version protocol support
    - conformant with A2A v1.0.1
    - push notifications are delivered in the body shape the specification defines for the version the client
      registered the config with: the bare Task object with \c application/json for v0.3, and a
      \c StreamResponse object with \c application/a2a+json for v1.0; neither is wrapped in a JSON-RPC envelope
    - push notification deliveries send the client's opaque token in the \c X-A2A-Notification-Token header
    - protocol extension support: @ref A2aServerHandler::A2aServerHandler::registerExtension()
      "registerExtension()" advertises an extension in the agent card and makes it eligible for activation; the
      activated subset is echoed in the \c A2A-Extensions response header, an extension the agent does not
      implement is ignored rather than rejected, and a request that does not opt into a \c required extension is
      rejected with \c ExtensionSupportRequiredError
    - Agent Card serving at both v1.0 and v0.3 paths
    - all 11 JSON-RPC methods registered in both v0.3 and v1.0 naming
    - automatic version detection from A2A-Version header or method name
    - version-aware response formatting (states, roles, parts)
    - per-connection SSE event formatting (v0.3 JSON-RPC wrapped or v1.0 plain)
    - Task lifecycle management with state machine validation
    - Push notification config CRUD
    - Session management
*/

#! the %A2aServerHandler namespace holds all public definitions in the %A2aServerHandler module
public namespace A2aServerHandler {
#! Server name
public const A2aServerName = "QoreA2aServer";

#! Server version
public const A2aServerVersion = "1.0";
}
