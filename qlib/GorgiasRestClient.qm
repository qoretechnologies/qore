# minimum qore version
%requires qore >= 2.0

# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module GorgiasRestClient {
    version = "1.0";
    desc = "User module for calling Gorgias REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("gorgiasrest", GorgiasRestConnection::ConnectionScheme);
    };
}

/** @mainpage GorgiasRestClient Module

    @tableofcontents

    @section gorgiasrestclientintro GorgiasRestClient Introduction

    The %GorgiasRestClient module provides an API for calling Gorgias REST API services.

    To use this module, use \c "%requires GorgiasRestClient" in your code.

    All the public symbols in the module are defined in the GorgiasRestClient namespace.

    The main classes are:
    - @ref GorgiasRestClient::GorgiasRestClient "GorgiasRestClient":
      this class provides the REST client API for communication with the Gorgias API;
      it handles OAuth2 authentication
    - @ref GorgiasRestClient::GorgiasRestConnection "GorgiasRestConnection":
      provides a connection object to Gorgias services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @section gorgiasrestclientrelnotes Release Notes

    @subsection gorgiasrestclientv1_0 GorgiasRestClient v1.0
    - the initial version of the %GorgiasRestClient module
*/

#! the GorgiasRestClient namespace contains all the objects in the GorgiasRestClient module
public namespace GorgiasRestClient {

#! Common base class for GorgiasRestClient functionality
public class GorgiasRestClientBase {
    public {
        #! Default Gorgias domain
        const DefaultDomain = "gorgias.com";

        #! Default subdomain (placeholder; must be overridden per account)
        const DefaultSubdomain = "app";

        #! Default Gorgias API URL
        const DefaultUrl = "https://app.gorgias.com/api";

        #! Default authorization request URL
        const DefaultAuthUrl = "https://app.gorgias.com/oauth/authorize";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default token request URL
        const DefaultTokenUrl = "https://app.gorgias.com/oauth/token";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash)
        const DefaultPingPath = "customers?limit=1";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OAuth2 auth args to request offline access (refresh tokens)
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! Default OAuth2 scopes
        const DefaultScopes = (
            "openid",
            "offline",
            "tickets:read",
            "tickets:write",
            "customers:read",
            "customers:write",
            "tags:read",
            "tags:write",
            "users:read",
            "events:read",
        );

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "headers": DefaultHeaders,
            "oauth2_auth_args": DefaultAuthArgs,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "url": DefaultUrl,
        };

        #! OAuth2 options (added when OAuth2 credentials are provided)
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_token_use_basic_auth": True,
            "oauth2_scopes": DefaultScopes,
        };

        #! Default connection URL
        const DefaultConnectionUrl = "gorgiasrest://app.gorgias.com/api";
    }

    #! Returns the base URL for a given subdomain
    static string getBaseUrl(*string subdomain) {
        return sprintf("https://%s.%s/api", subdomain ?? DefaultSubdomain, DefaultDomain);
    }

    #! Returns the OAuth2 authorization URL for a given subdomain
    static string getAuthUrl(*string subdomain) {
        return sprintf("https://%s.%s/oauth/authorize", subdomain ?? DefaultSubdomain,
            DefaultDomain);
    }

    #! Returns the OAuth2 token URL for a given subdomain
    static string getTokenUrl(*string subdomain) {
        return sprintf("https://%s.%s/oauth/token", subdomain ?? DefaultSubdomain, DefaultDomain);
    }

    #! Returns the connection URL for a given subdomain
    static string getConnectionUrl(*string subdomain) {
        return sprintf("gorgiasrest://%s.%s/api", subdomain ?? DefaultSubdomain, DefaultDomain);
    }

    #! returns options for the GorgiasRestClient constructor
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Build URL from subdomain if provided
        if (opts.subdomain) {
            rv.url = GorgiasRestClientBase::getBaseUrl(opts.subdomain);
        }

        # Ensure URL is always set (auto_url connections may pass NOTHING)
        if (!rv.url) {
            rv.url = DefaultUrl;
        }

        if (opts.oauth2_client_id) {
            # Build OAuth2 URLs from subdomain
            *string subdomain = opts.subdomain;
            rv += {
                "oauth2_auth_url": GorgiasRestClientBase::getAuthUrl(subdomain),
                "oauth2_grant_type": DefaultGrantType,
                "oauth2_token_url": GorgiasRestClientBase::getTokenUrl(subdomain),
                "oauth2_scopes": DefaultScopes,
            };
        }

        # Ensure the /api path is set for RestClientIo which needs default_path
        if (!rv.default_path) {
            rv.default_path = "/api";
        }

        # Remove subdomain from options passed to RestClient (not a recognized option)
        remove rv.subdomain;

        return rv;
    }
}

#! This class provides the REST client API for communication with Gorgias servers
/** Gorgias uses a REST API at https://{subdomain}.gorgias.com/api with OAuth2 authentication.

    @par Authentication:
    - OAuth2 with Bearer tokens (authorization code grant)
    - Scopes: tickets, customers, tags, users, events (read/write variants)

    @par API Structure:
    All endpoints are under /api on the subdomain-specific host
*/
public class GorgiasRestClient inherits RestClient::RestClient, GorgiasRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
GorgiasRestClient gorgias({
    "subdomain": "mycompany",
    "oauth2_client_id": ENV.GORGIAS_CLIENT_ID,
    "oauth2_client_secret": ENV.GORGIAS_CLIENT_SECRET,
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient"
        class plus:
        - \c subdomain: the Gorgias account subdomain (e.g., "mycompany" for mycompany.gorgias.com)

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(GorgiasRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Gorgias REST connections; returns @ref GorgiasRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref GorgiasRestClient::GorgiasRestClient::constructor() for more information on the above
    options
*/
public class GorgiasRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Gorgias REST Connection",
            "short_desc": "A connection to the Gorgias REST API",
            "desc": "A connection to the Gorgias REST API for customer support ticket management, "
                "customer data, and helpdesk operations",
            "cls": Class::forName("GorgiasRestConnection"),
            "auto_url": True,
            "schemes": {
                "gorgiasrest": True,
            },
            "base_scheme_map": {
                "https": "gorgiasrest",
            },
            "required_options": "oauth2_client_id,oauth2_client_secret,subdomain",
            "messages": (
                <UiMessageInfo>{
                    "title": "Finding Your Gorgias Subdomain",
                    "intent": "info",
                    "content": "Your **subdomain** is the first part of your Gorgias URL.\n\n"
                        "For example, if you access Gorgias at `https://mycompany.gorgias.com`, "
                        "your subdomain is `mycompany`.\n\n"
                        "**How to find it:**\n"
                        "1. Log in to your Gorgias helpdesk\n"
                        "2. Look at the URL in your browser's address bar\n"
                        "3. Copy the part before `.gorgias.com`",
                },
            ),
            "options": RestConnection::ConnectionScheme.options + {
                "subdomain": <ConnectionOptionInfo>{
                    "display_name": "Gorgias Subdomain",
                    "short_desc": "Your Gorgias account subdomain",
                    "type": "string",
                    "desc": "The subdomain for your Gorgias account.\n\n"
                        "For example, if your Gorgias URL is `https://mycompany.gorgias.com`, "
                        "enter `mycompany` as the subdomain.\n\n"
                        "This is used to build the API base URL and OAuth2 endpoints.",
                    "preselected": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultPingPath,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultScopes,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": GorgiasRestClientBase::DefaultTokenUrl,
                },
                "oauth2_token_use_basic_auth": RestConnection::ConnectionScheme.options.oauth2_token_use_basic_auth
                + <ConnectionOptionInfo>{
                    "default_value": True,
                },
            },
        };
    }

    #! creates the GorgiasRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and
        \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = GorgiasRestClientBase::DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes,
                GorgiasRestConnection::fixOAuth2Urls(options)) {
    }

    #! creates the GorgiasRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(GorgiasRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref GorgiasRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        if (!config.url) {
            config.url = GorgiasRestClientBase::DefaultConnectionUrl;
        }
        if (config.opts) {
            config.opts = GorgiasRestConnection::fixOAuth2Urls(config.opts);
        }
        return config;
    }

    #! Rebuilds OAuth2 URLs from subdomain to ensure they always match
    private static hash<auto> fixOAuth2Urls(hash<auto> options) {
        if (options.subdomain) {
            options.oauth2_auth_url = GorgiasRestClientBase::getAuthUrl(options.subdomain);
            options.oauth2_token_url = GorgiasRestClientBase::getTokenUrl(options.subdomain);
        }
        return options;
    }

    #! returns \c "gorgiasrest"
    string getType() {
        return "gorgiasrest";
    }

    #! Returns connection options with dynamically built OAuth2 URLs from subdomain
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        # Build all URLs dynamically from subdomain
        *string subdomain = rv.subdomain;
        rv.url = GorgiasRestClientBase::getBaseUrl(subdomain);
        rv.oauth2_auth_url = GorgiasRestClientBase::getAuthUrl(subdomain);
        rv.oauth2_token_url = GorgiasRestClientBase::getTokenUrl(subdomain);
        if (!rv.oauth2_grant_type) {
            rv.oauth2_grant_type = GorgiasRestClientBase::DefaultGrantType;
        }
        if (!rv.oauth2_scopes) {
            rv.oauth2_scopes = GorgiasRestClientBase::DefaultScopes;
        }
        if (!rv.oauth2_auth_args) {
            rv.oauth2_auth_args = GorgiasRestClientBase::DefaultAuthArgs;
        }
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Gorgias";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the GorgiasDataProvider and creates
        # the data provider object dynamically
        load_module("GorgiasDataProvider");
        return create_object("GorgiasDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            # Rebuild URL from subdomain
            *string subdomain = opts.subdomain;
            string expected_url = GorgiasRestClientBase::getConnectionUrl(subdomain);
            if (url != expected_url) {
                update.url = expected_url;
            }
            # Rebuild OAuth2 URLs from subdomain
            string expected_auth_url = GorgiasRestClientBase::getAuthUrl(subdomain);
            if (opts.oauth2_auth_url != expected_auth_url) {
                update.oauth2_auth_url = expected_auth_url;
            }
            string expected_token_url = GorgiasRestClientBase::getTokenUrl(subdomain);
            if (opts.oauth2_token_url != expected_token_url) {
                update.oauth2_token_url = expected_token_url;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref GorgiasRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter
        is ignored

        @return a @ref GorgiasRestClient object
    */
    private GorgiasRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new GorgiasRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since GorgiasRestClient 1.0
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new GorgiasRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Gorgias REST API using multiplexed HTTP connections
/** @see GorgiasRestClient for more information
*/
public class GorgiasRestClientIo inherits RestClientIo::RestClientIo, GorgiasRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(GorgiasRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
