%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) MilvusRestClient
%requires RestClientIo

module MilvusDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Milvus / Zilliz vector DB";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new MilvusDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": MilvusDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Milvus",
            "short_desc": "Milvus / Zilliz Cloud open-source vector database",
            "desc": "Provides access to [Milvus](https://milvus.io) and "
                "[Zilliz Cloud](https://zilliz.com) (managed Milvus) — an "
                "open-source vector database supporting billion-scale similarity "
                "search.\n\n"
                "Use the @ref QoreRagUtils::MilvusVectorStore \"MilvusVectorStore\" "
                "backend in @ref qorerragutilsintro \"QoreRagUtils\" for the supported "
                "ingest/retrieve path through @ref QoreRagUtils::RagPipeline "
                "\"RagPipeline\".",
            "scheme": "milvus",
            "logo": MilvusLogo,
            "logo_file_name": "milvus-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Databases,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MilvusDataProvider::AppName,
            "path": "/list-collections",
            "action": "list-collections",
            "display_name": "List Collections",
            "short_desc": "List Milvus collections",
            "desc": "Calls Milvus REST v2 `POST /v2/vectordb/collections/list` to "
                "enumerate available collections.",
            "action_code": DPAT_API,
            "groups": ("Admin",),
            "options": {},
            "output_type": MilvusListCollectionsDataProvider::ResponseType,
        });
    };
}

/** @mainpage MilvusDataProvider Module

    @tableofcontents

    @section milvusdataproviderintro MilvusDataProvider Introduction

    Lightweight data-provider integration for
    [Milvus](https://milvus.io) and [Zilliz Cloud](https://zilliz.com).
    For full vector operations use the
    @ref QoreRagUtils::MilvusVectorStore "MilvusVectorStore" backend
    via @ref QoreRagUtils::RagPipeline "RagPipeline".

    @section MilvusDataProviderRelnotes Release Notes

    @subsection MilvusDataProviderv1_0 MilvusDataProvider v1.0
    - the initial version of the %MilvusDataProvider module
*/

#! contains all public definitions in the MilvusDataProvider module
public namespace MilvusDataProvider {
#! Milvus application name
public const AppName = "Milvus";
}

#! App logo loaded from file
public const MilvusLogo = File::readTextFile(get_script_dir() + "/milvus-logo.svg");
