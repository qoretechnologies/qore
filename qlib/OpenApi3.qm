#! Holds the relative paths to the individual endpoints.
/**
    The path is appended to the @ref OpenApi3Schema::basePath "basePath" in order to construct the full URL.
    The Paths may be empty, due to ACL constraints.

    This class stores a tree or a component of a path for path matching, supports wildcard matching
 */
public class PathComponent inherits Qore::Serializable {
    private {
        #! path prefix
        string pfx;

        #! current component name
        string name;

        #! if there is a wildcard to a PathComponent
        *PathComponent wildcard;

        #! the PathItemObject associated with this path (if any)
        *PathItemObject pio;

        #! hash of non-wildcard paths to the next level
        hash<string, PathComponent> paths;
    }

    #! creates the object
    constructor(hash<auto> oh, string pfx, OpenApi3Schema openapi3) {
        self.pfx = pfx;
        name = "/";
        foreach hash<auto> h in (oh.pairIterator()) {
            if (!pfx.val() && h.key !~ /^\//) {
                throw "INVALID-FIELD-FORMAT", sprintf("Paths Object: root path %y does not begin with a slash", h.key);
            }
            list<string> l = h.key.split("/");
            shift l;
            add(h.key, l, 0, h.value, openapi3);
        }
    }

    #! private constructor
    private constructor(string full_path, list<auto> l, int offset, hash<auto> oh) {
        list<auto> l0 = l;
        splice l0, offset + 1;
        pfx = l0.join("/");
        name = l[offset - 1];
    }

    #! adds a component or a Path Item Object to the tree
    private add(string full_path, list<auto> l, int offset, hash<auto> oh, OpenApi3Schema openapi3) {
        #printf("PathComponent::add(): pfx: %y name: %y: %y l: %y offset: %y\n", pfx, name, full_path, l, offset);
        if (offset == l.size()) {
            if (!pio) {
                pio = new PathItemObject(full_path, oh, openapi3);
            } else {
                throw "INVALID-PATH-COMPONENT", sprintf("Cannot terminate path %y twice", full_path);
            }
            # otherwise we merge new methods in the existing PathItemObject
            return;
        }

        PathComponent next;
        string key = l[offset];
        if (key =~ /^{/) {
            next = wildcard ?? (wildcard = new PathComponent(full_path, l, offset + 1, oh));
        } else {
            next = paths{key} ?? (paths{key} = new PathComponent(full_path, l, offset + 1, oh));
        }

        next.add(full_path, l, offset + 1, oh, openapi3);
    }

    #! returns either a PathItemObject for the path
    /** @throw SCHEMA-VALIDATION-ERROR the path could not be matched or has no API definition
    */
    PathItemObject match(list<auto> path) {
        *PathItemObject rv = tryMatch(path);
        if (!rv)
            throw "SCHEMA-VALIDATION-ERROR", sprintf("path %y is valid but has no API definition", path.join("/"));
        return rv;
    }

    #! returns either a PathItemObject for the path
    /** @throw SCHEMA-VALIDATION-ERROR the path could not be matched or has no API definition
    */
    *PathItemObject tryMatch(list<auto> path) {
        PathComponent w = self;
        for (int i = 1; i < path.size(); ++i) {
            *PathComponent next = w.paths{path[i]} ?? w.wildcard;
            if (!next) {
                if (w.paths) {
                    throw "SCHEMA-VALIDATION-ERROR", sprintf("path component %y cannot be matched in %y; expected "
                        "one of: %y", path[i], path.join("/"), keys w.paths);
                } else {
                    throw "SCHEMA-VALIDATION-ERROR", sprintf("path component %y cannot be matched in %y", path[i],
                        path.join("/"));
                }
            }
            w = next;
        }
        return w.pio;
    }

    #! populates a hash of URI paths as keys with values as lists of supported HTTP methods
    /** @param h reference to the hash to populate with URI paths as keys and lists of supported HTTP methods as values
    */
    getPathOperationHash(reference<hash<string, list<string>>> h) {
        if (pio)
            h{pfx} = pio.getMethods();
        map $1.getPathOperationHash(\h), paths.iterator();
        if (wildcard)
            wildcard.getPathOperationHash(\h);
    }
}

#! This class stores the path tree for URI path matching
public class PathsObject inherits ObjectBase {
    private {
        #! the tree of path components for path matching with wildcards
        PathComponent paths;
    }

    #! Constructor.
    /**
        @param oh deserialized hash from the source schema description describing paths to schema endpoints
        @param openapi3 the REST schema for resolving references

        @throws INVALID-FIELD-FORMAT field has invalid format
        @throws INVALID-FIELD-TYPE field has invalid type
        @throws INVALID-FIELD-VALUE field has invalid value
     */
    public constructor(hash<auto> oh, OpenApi3Schema openapi3) : ObjectBase(oh) {
        paths = new PathComponent(oh, "", openapi3);
    }

    #! matches a URI path with a PathItemObject
    /** @throw INVALID-PATH the path could not be matched
    */
    PathItemObject match(string path) {
        if (!path.equalPartial("/")) {
            path = "/" + path;
        }
        # strip query from path before matching
        path =~ s/\?.*//g;
        return paths.match(path.split("/"));
    }

    #! matches a URI path with a PathItemObject
    /** @throw INVALID-PATH the path could not be matched
    */
    *PathItemObject tryMatch(string path) {
        if (!path.equalPartial("/")) {
            path = "/" + path;
        }
        return paths.tryMatch(path.split("/"));
    }

    #! returns a hash of URI paths as keys with values as lists of supported HTTP methods
    /** @return a hash of URI paths as keys with values as lists of supported HTTP methods
    */
    hash<string, list<string>> getPathOperationHash() {
        hash<string, list<string>> rv();
        paths.getPathOperationHash(\rv);
        return rv;
    }
}

#! Describes the operations available on a single path.
/**
    A Path Item may be empty, due to ACL constraints. The path itself is still
    exposed to the documentation viewer but they will not know which operations
    and parameters are available.
 */
public class PathItemObject inherits ObjectBase, ParameterGroup, RestSchemaValidator::AbstractPathItemObject {
    public {
        #! Allows for an external definition of this path item.
        /**
            The referenced structure MUST be in the format of a @ref PathItemObject.
            If there are conflicts between the referenced definition and this
            PathItem's definition, the behavior is undefined.
         */
        *string ref;

        #! The body parameter, if defined
        ParameterObject body;
    }

    private {
        #! A hash of @ref OperationObject "OperationObjects" correspoding to different methods.
        /**
            Keys are lowercase method names, with possible values being:
            - \c "get"
            - \c "put"
            - \c "post"
            - \c "delete"
            - \c "options"
            - \c "head"
            - \c "patch"
         */
        hash<string, OperationObject> operations;
    }

    #! Constructor.
    /**
        @param path the URI path for the object
        @param oh deserialized hash from the source schema description describing the operations available on a single path
        @param openapi3 the REST schema for resolving references

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws INVALID-FIELD-VALUE field has invalid value
        @throws REQUIRED-FIELD-MISSING required field is missing
     */
    public constructor(string path, hash<auto> oh, OpenApi3Schema openapi3) : ObjectBase(oh) {
        string obj_type = "Path Item";
        optional_field(obj_type, oh, "$ref", NT_STRING, \ref);

        *hash opObj;
        if (optional_field(obj_type, oh, "get", NT_HASH, \opObj))
            operations.get = new OperationObject(path, "get", opObj, openapi3);

        delete opObj;
        if (optional_field(obj_type, oh, "put", NT_HASH, \opObj))
            operations.put = new OperationObject(path, "put", opObj, openapi3);

        delete opObj;
        if (optional_field(obj_type, oh, "post", NT_HASH, \opObj))
            operations.post = new OperationObject(path, "post", opObj, openapi3);

        delete opObj;
        if (optional_field(obj_type, oh, "delete", NT_HASH, \opObj))
            operations."delete" = new OperationObject(path, "delete", opObj, openapi3);

        delete opObj;
        if (optional_field(obj_type, oh, "options", NT_HASH, \opObj))
            operations.options = new OperationObject(path, "options", opObj, openapi3);

        delete opObj;
        if (optional_field(obj_type, oh, "head", NT_HASH, \opObj))
            operations.head = new OperationObject(path, "head", opObj, openapi3);

        delete opObj;
        if (optional_field(obj_type, oh, "patch", NT_HASH, \opObj))
            operations.patch = new OperationObject(path, "patch", opObj, openapi3);

        *list params;
        if (optional_field(obj_type, oh, "parameters", NT_LIST, \params)) {
            foreach auto param in (params) {
                if (param.typeCode() != NT_HASH)
                    throw "INVALID-FIELD-TYPE",
                        sprintf("Path Item Object: 'parameters' list value has invalid type %y",
                            param.type());
                ParameterObject p = ParameterObject::newParameter(
                    sprintf("%d/%d", $# + 1, params.lsize()), param, openapi3
                );
                if (p.inLoc == "body") {
                    if (body)
                        throw "INVALID-FIELD-VALUE", sprintf("path %y: more than one \"body\" parameter provided",
                            path);
                    body = p;
                } else {
                    addParameter(p);
                }
            }
        }
    }

    #! returns the operation object for the given method
    /** @param path the path to be used in any error message
        @param method the HTTP method name

        @return the OperationObject corresponding to the arguments

        @throws INVALID-METHOD the given path does not have any operation defined for the given method
    */
    OperationObject getOperation(string method, string path) {
        *OperationObject op = operations{method};
        if (!op)
            throw "INVALID-METHOD", sprintf("%s %s: no operation defined for this path; known methods: %y",
                method.upr(), path, keys operations), keys operations;
        return op;
    }

    #! returns a list of HTTP methods supported by this object
    /** @return a list of HTTP methods supported by this object
    */
    softlist getMethods() {
        return keys operations;
    }

    #! Returns the body parameter, if any
    *RestSchemaValidator::AbstractParameterObject getBody() {
        return body;
    }

    #! Returns the parameters hash
    hash<string, RestSchemaValidator::AbstractParameterObject> getParameters() {
        return cast<hash<string, RestSchemaValidator::AbstractParameterObject>>(parameters);
    }
}

#! Describes a single API operation on a path.
/** Inherits common operation members from
    @ref RestSchemaValidator::AbstractOperationObject "AbstractOperationObject":
    - path, method, summary, desc, consumes, produces
*/
public class OperationObject inherits ObjectBase, ParameterGroup, RestSchemaValidator::AbstractOperationObject {
    public {
        #! A list of tags (strings or @ref TagObject "TagObjects") for API documentation control.
        /**
            Tags can be used for logical grouping of operations by resources or any other qualifier.
         */
        list tags;

        #! Declares this operation to be deprecated.
        /**
            Usage of the declared operation should be refrained.
            Default value is \c false.
         */
        bool deprec = False;

        #! Additional external documentation for this operation.
        *ExternalDocumentationObject externalDocs;

        #! Unique string used to identify the operation.
        /**
            The id MUST be unique among all operations described in the API.
            Tools and libraries MAY use the operationId to uniquely identify
            an operation, therefore, it is recommended to follow common
            programming naming conventions.
         */
        *string operationId;

        #! formData parameter; if defined for this operation, body parameter will be excluded
        hash<string, ParameterObject> formData;

        #! The body parameter, if defined
        ParameterObject body;

        #! Required. The list of possible responses as they are returned from executing this operation.
        ResponsesObject responses;

        #! A declaration of which security schemes are applied for this operation.
        /**
            The list of values describes alternative security schemes that can be
            used (that is, there is a logical OR between the security requirements).
            This definition overrides any declared top-level @ref OpenApi3Schema::security "security".
            To remove a top-level security declaration, an empty array can be used.

            Individual values are hashes in the form of Security Requirement Objects.
            See https://github.com/OAI/OpenAPI-Specification/blob/master/versions/2.0.md#securityRequirementObject.
            That is, the hash keys MUST correspond to security schemes declared
            in the \c securitySchemes "Security Definitions",
            while the values are lists of scope names (strings) required for the execution.
         */
        list<hash<string, list<string>>> security;
    }

    #! Constructor.
    /** @param path the path for the operation
        @param method the HTTP method for the operation
        @param oh deserialized hash from the source schema description describing the operation
        @param openapi3 the REST schema for resolving references

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws INVALID-FIELD-VALUE field has invalid value
        @throws REQUIRED-FIELD-MISSING required field is missing
     */
    public constructor(string path, string method, hash<auto> oh, OpenApi3Schema openapi3) : ObjectBase(oh) {
        self.path = path;
        self.method = method.upr();
        string obj_type = "Operation";
        *list<auto> tagsObj;
        if (optional_field(obj_type, oh, "tags", NT_LIST, \tagsObj)) {
            foreach auto tag in (tagsObj) {
                if (tag.typeCode() == NT_STRING) {
                    tags += tag;
                } else if (tag.typeCode() == NT_HASH) {
                    tags += new TagObject(tag);
                } else {
                    error("INVALID-FIELD-TYPE", "'tags' list value has invalid type %y; expecting \"hash\" or "
                        "\"string\"", tag.fullType());
                }
            }
        }

        on_error rethrow $1.err, sprintf("%s (operation \"%s %s\")", $1.desc, method.upr(), path);

        optional_field(obj_type, oh, "summary", NT_STRING, \summary);
        optional_field(obj_type, oh, "description", (NT_STRING: True, NT_NOTHING: True), \desc);
        optional_field(obj_type, oh, "deprecated", NT_BOOLEAN, \deprec);

        *hash extDocsObj;
        if (optional_field(obj_type, oh, "externalDocs", NT_HASH, \extDocsObj)) {
            externalDocs = new ExternalDocumentationObject(extDocsObj);
        }

        optional_field(obj_type, oh, "operationId", NT_STRING, \operationId);
        # TODO check operationId uniqueness as per docs

        # use the global "consumes" definition if none is defined on the operation
        if (!optional_field(obj_type, oh, "consumes", OpenApi3ListToStringSet, \consumes) && openapi3.consumes) {
            consumes = openapi3.consumes;
        }
        foreach string mt in (keys consumes) {
            if (mt =~ /[;,]/) {
                remove consumes{mt};
                mt =~ s/[;,].*$//;
                consumes{mt} = True;
            }
        }

        # use the global "produces" definition if none is defined on the operation
        if (!optional_field(obj_type, oh, "produces", OpenApi3ListToStringSet, \produces) && openapi3.produces) {
            produces = openapi3.produces;
        }
        foreach string mt in (keys produces) {
            if (mt =~ /[;,]/) {
                remove produces{mt};
                mt =~ s/[;,].*$//;
                produces{mt} = True;
            }
        }
        {
            list listObj;
            optional_field(obj_type, oh, "parameters", NT_LIST, \listObj);
            foreach auto p in (listObj) {
                if (p.typeCode() != NT_HASH) {
                    error("INVALID-FIELD-TYPE", "invalid 'parameters' list value datatype %y; expecing \"hash\"",
                        p.fullType());
                }
                ParameterObject param = ParameterObject::newParameter(sprintf("%d/%d", $# + 1,
                    listObj.lsize()), p, openapi3);
                if (param.inLoc == "body") {
                    body = param;
                } else if (param.inLoc == "formData") {
                    formData{param.name} = param;
                } else {
                    addParameter(param);
                }
            }
        }

        # OpenAPI 3.0 style requestBody
        {
            *hash<auto> requestBodyObj;
            if (optional_field(obj_type, oh, "requestBody", NT_HASH, \requestBodyObj)) {
                # Resolve $ref if present
                if (requestBodyObj."$ref") {
                    requestBodyObj = openapi3.resolveRequestBody(requestBodyObj."$ref");
                }
                # Extract schema from requestBody.content.{mediaType}.schema
                *hash<auto> contentObj = requestBodyObj.content;
                if (contentObj) {
                    foreach hash<auto> item in (contentObj.pairIterator()) {
                        if (item.value.schema) {
                            # Create a synthetic body parameter from the requestBody (only once)
                            if (!body) {
                                hash<auto> bodyParam = {
                                    "name": "body",
                                    "in": "body",
                                    "required": requestBodyObj.required ?? False,
                                    "schema": item.value.schema,
                                };
                                if (requestBodyObj.description) {
                                    bodyParam.description = requestBodyObj.description;
                                }
                                body = ParameterObject::newParameter("requestBody", bodyParam, openapi3);
                            }
                            # Add all content types to consumes
                            if (!consumes) {
                                consumes = {};
                            }
                            consumes{item.key} = True;
                        }
                    }
                }
            }
        }

        {
            hash responsesObj;
            required_field(obj_type, oh, "responses", NT_HASH, \responsesObj);
            responses = new ResponsesObject(path, self.method, responsesObj, openapi3);
        }

        {
            list securityList;
            optional_field(obj_type, oh, "security", NT_LIST, \securityList);
            foreach auto val in (securityList) {
                if (val.typeCode() != NT_HASH) {
                    error("INVALID-FIELD-TYPE", "invalid 'security' list value datatype %y; expecting \"hash\"",
                        val.fullType());
                }
                hash<auto> h = val;
                foreach hash<auto> it in (h.pairIterator()) {
                    if (it.value.typeCode() != NT_LIST) {
                        error("INVALID-FIELD-TYPE", "invalid Security Requirement Object value type %y (should be a "
                            "list of hashes)", val.fullType());
                    }
                    if ((map True, it.value, $1.typeCode() != NT_STRING).size()) {
                        error("INVALID-FIELD-TYPE", "invalid Security Requirement Object value type %y (should be a "
                            "list of hashes with list values)", val.fullType());
                    }
                }
            }
            if (securityList) {
                security = cast<list<hash<string, list<string>>>>(securityList);
            }
        }
    }

    #! Processes a generated request
    /** @param pio the path item object
        @param body the request body
        @param headers reference to headers
        @param freeform if \c True, allow freeform validation (optional)

        @return the serialized request body data
    */
    *data getRequestBody(RestSchemaValidator::AbstractPathItemObject pio, auto body, reference<hash<auto>> headers,
            *bool freeform) {
        PathItemObject real_pio = cast<PathItemObject>(pio);
        *ParameterObject body_po = self.body ?? real_pio.body;
        if (body_po) {
            body_po.check(True, True, path, method, "body", \body);
        } else if (formData) {
            map $1.value.check(True, True, path, method, "formData." + $1.key, \body{$1.key}),
                formData.pairIterator();
        } else if (body) {
            error("SCHEMA-VALIDATION-ERROR", "No message body is accepted; body keys passed: %y", keys body);
        }

        if (!exists body) {
            return;
        }

        # get content type
        if (!consumes) {
            throw "SERIALIZATION-ERROR", sprintf("%s %s: API supports no serialization types but a \"body\" "
                "parameter is present", method.upr(), path);
        }
        string ct = consumes.firstKey();

        if (ct == MimeTypeMultipartFormData) {
            hash<string, hash<FormDataMessageInfo>> parts =
                cast<hash<string, hash<FormDataMessageInfo>>>(map {$1.key: cast<hash<FormDataMessageInfo>>({
                    "name": $1.key,
                    "filename": $1.key,
                    "hdr": {"Content-Type": MimeTypeText},
                    "body": $1.value,
                })}, body.pairIterator());

            hash<MessageInfo> mh = MultiPartFormDataMessage::makeMessage(parts).getMsgAndHeaders();
            headers."Content-Type" = mh.hdr."Content-Type";
            return mh.body;
        }

        if (MimeDataTypes{ct}) {
            headers."Content-Type" = ct;
            return MimeDataTypes{ct}.serialize(body);
        }

        throw "SERIALIZATION-ERROR", sprintf("%s %s: message body cannot be serialized; available MIME type(s): %y; "
            "available serialization modules: %y", method.upr(), path, keys consumes, SerializationModules);
    }

    #! processes a REST API client-side request to the operation
    /** @param serialize if request arguments should be processed for serialization (client-side) or not (server-side)
        @param pio the PathItemObject corresponding to the URI path
        @param h a reference to the URI query info hash
        @param body a reference to the deserialized HTTP message body data
        @param headers a reference to a hash of HTTP headers
        @param mime_types a reference to a hash of valid mime types for the operation
        @param freeform if \c True, allow freeform validation (optional, Swagger-specific)

        @throws SCHEMA-VALIDATION-ERROR invalid parameter name or location, missing parameter and parameter has no
        default value
    */
    validateRequest(bool serialize, RestSchemaValidator::AbstractPathItemObject pio, reference<hash<UriQueryInfo>> h,
            reference<auto> body, reference<hash> headers, *reference<hash<string, bool>> mime_types,
            *bool freeform) {
        PathItemObject real_pio = cast<PathItemObject>(pio);

        # check query parameters
        *string query_obj = self.query_obj ?? real_pio.query_obj;
        if (exists query_obj) {
            h.params{query_obj} = map {$1: remove h.params{$1}}, keys h.params,
                !parameters{$1} && !real_pio.parameters{$1};
        }

        foreach string key in (keys h.params) {
            # find URI parameter object
            *ParameterObject po = parameters{key} ?? real_pio.parameters{key};
            if (!po) {
                if (exists (*string op = (query_obj ?? real_pio.query_obj))) {
                    h.params{op}{key} = remove h.params{key};
                } else {
                    error("SCHEMA-VALIDATION-ERROR", "No query parameter named %y defined for this path and method; "
                        "known query parameters: %y", key, keys (parameters + real_pio.parameters));
                }
            }
            if (po.inLoc != "query") {
                error("SCHEMA-VALIDATION-ERROR", "invalid parameter %y given in the URI query; expected location %y",
                    key, po.inLoc);
            }

            po.check(serialize, True, path, method, key, \h.params{key});
        }
        # when serializing query args of type hash (OpenAPI 3+ compatibility), merge the object's keys back into the
        # hash
        if (exists query_obj && serialize) {
            h.params = remove h.params{query_obj};
        }

        # check header parameters
        foreach string key in (keys headers) {
            # find URI parameter object
            *ParameterObject po = parameters{key} ?? real_pio.parameters{key};
            # extra headers are OK
            if (!po || po.inLoc != "header") {
                continue;
            }

            po.check(serialize, True, path, method, key, \headers{key});
        }

        # check body parameters
        {
            *ParameterObject body_po = self.body ?? real_pio.body;
            if (body_po) {
                body_po.check(serialize, True, path, method, "body", \body);
            } else if (formData) {
                foreach hash<auto> i in (formData.pairIterator()) {
                    i.value.check(serialize, True, path, method, "formData." + i.key, \body{i.key});
                }
            } else if (body) {
                error("SCHEMA-VALIDATION-ERROR", "No message body is accepted; body keys passed: %y", keys body);
            }
        }

        # check path parameters
        foreach string param in (path =~ x/{([^}]+)}/g) {
            *ParameterObject po = parameters{param} ?? real_pio.parameters{param};
            if (!po) {
                error("SCHEMA-VALIDATION-ERROR", "No path parameter named %y defined for this path and method; "
                    "known parameters: %y", param, keys (parameters + real_pio.parameters));
            }

            string pattern = replace(path, "{" + param + "}", "(.*)");
            pattern =~ s/^\//\/?/;
            auto val = regex_extract(h.method, pattern)[0];

            # convert string to actual type
            switch (po.schema.type) {
                case "integer":
                    val = val.toInt();
                    break;

                case "number":
                    val = val.toNumber();
                    break;

                case "boolean":
                    val = parse_boolean(val);
                    break;
            }

            po.check(False, True, path, method, param, \val);
            h.path_params{param} = val;
        }

        # check for missing required parameters
        checkMissingParams(h, headers, body, parameters);
        checkMissingParams(h, headers, body, real_pio.parameters, parameters);

        if (consumes) {
            mime_types = consumes;
        }
    }

    #! parses and processes a REST request on the server side
    /** @param pio the PathItemObject corresponding to the URI path
        @param h a reference to the URI query info hash
        @param body a reference to the deserialized HTTP message body data
        @param headers a reference to a hash of HTTP headers

        @throw DESERIALIZATION-ERROR invalid content-type
        @throws INVALID-PARAMETER-NAME invalid parameter name
        @throws INVALID-PARAMETER-LOCATION invalid parameter location
        @throws MISSING-PARAMETER missing parameter and parameter has no default value
    */
    parseRequest(PathItemObject pio, reference<hash<UriQueryInfo>> h, reference<auto> body, reference<hash> headers) {
        # validate message
        hash<string, bool> mime_types();
        validateRequest(False, pio, \h, \body, \headers, \mime_types);

        # check content-type
        if (exists body && mime_types) {
            string content = headers."content-type" ?? headers."Content-Type";
            int pos = content.find(";");
            if (pos != -1)
                content = content.substr(0, pos);
            if (!mime_types{content} && !mime_check_equivalent_type(content, mime_types)) {
                throw "DESERIALIZATION-ERROR", sprintf("%s: invalid Content-Type: %y; valid MIME types: %y", h.method,
                    content, mime_types);
            }
        }

        # set default parameter values
        doDefaultParams(\h, \headers, \body, parameters);
        doDefaultParams(\h, \headers, \body, pio.parameters, parameters);
    }

    #! validates a response against the response definition, if any
    validateResponse(string method, string path, PathItemObject pio, int http_code, reference<auto> response_body,
            reference<hash<string, bool>> mime_types, bool deserialize = True) {
        *ResponseObject res = getResponse(http_code);
        if (res.schema) {
            res.schema.check(deserialize, False, path, method, "response body", \response_body);
        } else if (exists res && exists response_body) {
            error("SCHEMA-VALIDATION-ERROR", "Response code %y to %s %y should not have any body", http_code, method,
                path);
        }

        if (produces) {
            mime_types = produces;
        } else if (res.contentTypes) {
            # OpenAPI 3.0: use content types from response
            mime_types = res.contentTypes;
        } else {
            # Neither produces nor contentTypes defined - use defaults
            mime_types = map {$1: True}, MimeContentTypes;
        }
    }

    #! returns example Qore code for the given request
    /** @param method the HTTP method (in lower case)
        @param path the URI path of the request
        @param pio the PathItemObject corresponding to the URI path
        @param openapi3 the schema object itself

        @return a @ref RestSchemaValidator::RestQoreExampleCodeInfo "RestQoreExampleCodeInfo" hash giving example Qore code to generate the given request message
    */
    hash<RestQoreExampleCodeInfo> getQoreExampleRequest(string method, string path, PathItemObject pio, OpenApi3Schema openapi3) {
        hash<RestQoreExampleCodeInfo> rv();

        #! URI query arguments
        hash<auto> query;
        #! headers
        hash<auto> headers;

        getQoreExampleParams(\query, \headers, parameters);
        getQoreExampleParams(\query, \headers, pio.parameters, parameters);

        if (query)
            path = make_uri_query(cast<hash<UriQueryInfo>>({"method": path, "params": query}));

        rv.example = sprintf("RestClient client((\"url\": %y));\n", openapi3.getTargetUrl());

        #! get example message body
        *ParameterObject body_po = body ?? pio.body;
        if (body_po)
            rv.example += body_po.getQoreExample(\rv);

        rv.example += "hash<auto> info;\n";
        if (headers) {
            rv.example += "hash<auto> hdr = (\n";
            rv.example += foldl $1 + "\n" + $2, (map sprintf("    %y: %y,", $1.key, $1.value), headers.pairIterator());
            rv.example += "\n);\n";
        }

        rv.example += sprintf("hash<auto> res = rest.%s", method.lwr());
        rv.example += sprintf("(%y, ", path);
        # body
        rv.example += body_po ? "rest_body, " : "NOTHING, ";
        # info reference
        rv.example += "\\info";
        # headers
        if (headers)
            rv.example += ", hdr";
        rv.example += ");\n";

        return rv;
    }

    #! returns a hash of example message information for the given request
    /** @param method the HTTP method (in lower case)
        @param path the URI path of the request
        @param pio the PathItemObject corresponding to the URI path
        @param openapi3 the schema object itself
        @param rbody the output example body value, if any

        @return a @ref RestSchemaValidator::RestExampleRequestInfo "RestExampleRequestInfo" hash of example message
        information for the given request
    */
    hash<RestSchemaValidator::RestExampleRequestInfo> getExampleRequest(string method, string path,
            PathItemObject pio, OpenApi3Schema openapi3, reference rbody) {
        hash<RestExampleRequestInfo> rv();

        #! URI query arguments
        hash<auto> query;

        getQoreExampleParams(\query, \rv.hdr, parameters);
        getQoreExampleParams(\query, \rv.hdr, pio.parameters, parameters);

        rv.request_uri = sprintf("%s %s HTTP/1.1", method.upr(),
            make_uri_query(cast<hash<UriQueryInfo>>({"method": path, "params": query})));

        #! get example message body
        *ParameterObject body_po = body ?? pio.body;
        if (body_po)
            rbody = body_po.getExampleValue();

        return rv;
    }

    #! returns example Qore code for the given response
    /** @param method the HTTP method of the original request (case insensitive)
        @param path the URI path of the original request
        @param code the HTTP response code of the response

        @return a @ref RestSchemaValidator::RestQoreExampleCodeInfo "RestQoreExampleCodeInfo" hash giving example Qore
        code to generate the given response message
    */
    hash<RestQoreExampleCodeInfo> getQoreExampleResponse(string method, string path, int code) {
        hash<RestQoreExampleCodeInfo> rv();

        *ResponseObject res = getResponse(code);
        if (res.schema)
            rv.example = res.schema.getQoreExample(\rv, "body", True);

        rv.example += sprintf("return RestHandler::makeResponse(%d%s);\n", code, rv.example ? ", body" : "");

        return rv;
    }

    #! returns a hash of example message information for the given request
    /** @param method the HTTP method of the original request (case insensitive)
        @param path the URI path of the original request
        @param code the HTTP response code of the response
        @param body the output example body value, if any

        @return a @ref RestSchemaValidator::RestExampleResponseInfo "RestExampleResponseInfo" hash giving example
        response message info
    */
    hash<RestExampleResponseInfo> getExampleResponse(string method, string path, int code, reference<auto> body) {
        hash<RestExampleResponseInfo> rv();

        *ResponseObject res = getResponse(code);
        if (res.schema)
            body = res.schema.getExampleValue();

        return rv;
    }

    private getQoreExampleParams(reference<hash<auto>> query, reference<hash<auto>> headers,
            hash<string, ParameterObject> parameters, *hash<string, ParameterObject> child_params) {
        foreach hash<auto> ph in (parameters.pairIterator()) {
            # don't check if child params already checked or if it's the single message body param
            if (child_params{ph.key} || ph.value.inLoc == "body" || ph.value.inLoc == "formData")
                continue;
            switch (ph.value.inLoc) {
                case "query":
                    query{ph.key} = ph.value.getExampleValue();
                    break;
                case "header":
                    headers{ph.key} = ph.value.getExampleValue();
                    break;
            }
        }
    }

    #! add default parameters
    private doDefaultParams(reference<hash<UriQueryInfo>> h, reference<hash> headers, reference<auto> body,
            hash<string, ParameterObject> parameters, *hash<string, ParameterObject> child_params) {
        foreach hash<auto> ph in (parameters.pairIterator()) {
            # don't check if child params already checked or if it's the single message body param
            if (child_params{ph.key} || ph.value.inLoc == "body")
                continue;
            if (exists (auto val = ph.value.getDefaultValue())) {
                switch (ph.value.inLoc) {
                    case "query":
                        if (!exists h.params{ph.key})
                            h.params{ph.key} = val;
                        break;
                    case "header":
                        if (!exists headers{ph.key})
                            headers{ph.key} = val;
                        break;
                    case "formData":
                        if (!exists body{ph.key})
                            body{ph.key} = val;
                        break;
                    # NOTE: default "path" values are not possible, "body" is handled specially
                }
            }
        }
    }

    #! checks for missing params
    private checkMissingParams(hash<UriQueryInfo> h, *hash<auto> headers, auto body,
            hash<string, ParameterObject> parameters, *hash<string, ParameterObject> child_params) {
        foreach hash<auto> ph in (parameters.pairIterator()) {
            # don't check if child params already checked
            if (child_params{ph.key} || ph.value.inLoc == "body")
                continue;
            if (ph.value.required) {
                switch (ph.value.inLoc) {
                    case "query":
                        if (!exists h.params{ph.key})
                            error("SCHEMA-VALIDATION-ERROR", "request is missing required query parameter %y",
                                ph.key);
                        break;
                    case "header":
                        if (!exists headers{ph.key})
                            error("SCHEMA-VALIDATION-ERROR", "request is missing required header parameter %y",
                                ph.key);
                        break;
                    case "formData":
                        if (!exists body{ph.key})
                            error("SCHEMA-VALIDATION-ERROR", "request is missing required formData parameter %y",
                                ph.key);
                        break;
                    # NOTE: missing path parameters are not possible (path would not be matched in the first place)
                    #       "body" is handled specially
                }
            }
        }
    }

    #! returns the ResponseObject for hthe given HTTP code or @ref nothing if none is configured
    /** @return the ResponseObject for hthe given HTTP code or @ref nothing if none is configured
    */
    private *ResponseObject getResponse(int code) {
        return responses.responses{code} ?? responses.defaultResp;
    }

    #! raises an exception with context information
    private error(string err, string fmt, ...) {
        throw err, sprintf("%s %s Operation Object: %s", method.upr(), path, vsprintf(fmt, argv));
    }

    #! Returns the x-tags extension value if set.
    /** This extension provides additional tags for the operation. */
    *list<string> getXTags() {
        return vendorExtensions."x-tags";
    }

    #! Returns the x-swagger-router-controller extension value if set.
    /** This extension specifies the router controller for the operation (used by swagger-tools). */
    *string getRouterController() {
        return vendorExtensions."x-swagger-router-controller";
    }

    #! Returns the x-summary extension value if set.
    /** This extension provides an additional summary for the operation. */
    *string getXSummary() {
        return vendorExtensions."x-summary";
    }

    #! Returns the responses object
    RestSchemaValidator::AbstractResponsesObject getResponses() {
        return responses;
    }

    #! Returns the body parameter, if any
    *RestSchemaValidator::AbstractParameterObject getBody() {
        return body;
    }

    #! Returns the parameters hash
    hash<string, RestSchemaValidator::AbstractParameterObject> getParameters() {
        return cast<hash<string, RestSchemaValidator::AbstractParameterObject>>(parameters);
    }
}

#! Allows referencing an external resource for extended documentation.
public class ExternalDocumentationObject inherits ObjectBase {
    public {
        #! A short description of the target documentation. GFM syntax can be used for rich text representation.
        *string desc;

        #! Required. The URL for the target documentation. Value MUST be in the format of a URL.
        string url;
    }

    #! Constructor.
    /**
        @param oh deserialized hash from the source schema description providing a reference to external documentation

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
     */
    public constructor(hash<auto> oh) : ObjectBase(oh) {
        string obj_type = "External Documentation";
        required_field(obj_type, oh, "url", NT_STRING, \url);
        optional_field(obj_type, oh, "description", (NT_STRING: True, NT_NOTHING: True), \desc);
    }
}

#! Base class for ParameterObject and HeaderObject
/** Inherits common parameter members from
    @ref RestSchemaValidator::AbstractParameterObject "AbstractParameterObject".
*/
public class ParameterBase inherits ObjectBase, RestSchemaValidator::AbstractParameterObject {
    public {
        #! Describes how the parameter value will be serialized depending on the type of the parameter value
        /** Default values (based on value of in):
            - for query - form
            - for path - simple
            - for header - simple
            - for cookie - form
        */
        *string style;

        #! Explode when rendering
        /** When this is true, parameter values of type array or object generate separate parameters for each value of
            the array or key-value pair of the map. For other types of parameters this property has no effect. When
            style is form, the default value is true. For all other styles, the default value is false.
        */
        bool explode;

        #! Allow reserved characters without percent encoding
        /** Determines whether the parameter value SHOULD allow reserved characters, as defined by RFC3986
            :/?#[]@!$&'()*+,;= to be included without percent-encoding. This property only applies to parameters with
            an in value of query. The default value is false.
        */
        bool allowReserved;

        #! Specifies that a parameter is deprecated and SHOULD be transitioned out of usage
        /**
            Default value is false.
        */
        bool deprec = False;

        #! Content media type, if present
        *string content;

        #! Media type object for 'content'
        #MediaType media;

        #! The schema defining the type used for the parameter
        SchemaObject schema;

        #! Valid style values
        const StyleMap = {
            "matrix": True,
            "label": True,
            "form": True,
            "simple": True,
            "spaceDelimited": True,
            "pipeDelimited": True,
            "deepObject": True,
        };

        #! Default style values based on the location
        const DefaultStyles = {
            "query": "form",
            "path": "simple",
            "header": "simple",
            "cookie": "form",
        };

        #! Valid Styles per location
        const LocStyleMap = {
            "cookie": {
                "form": True,
            },
            "header": {
                "simple": True,
            },
            "path": {
                "matrix": True,
                "label": True,
                "simple": True,
            },
            "query": {
                "form": True,
                "spaceDelimited": True,
                "pipeDelimited": True,
                "deepObject": True,
            },
        };
    }

    #! Creates the object
    public constructor(hash<auto> oh) : ObjectBase(oh) {
    }

    #! Copy the object
    copy(ParameterObject old) {
    }

    #! Parse the parameter data
    private parseData(hash<auto> oh, OpenApi3Schema openapi3) {
        string obj_type = sprintf("%s parameter", inLoc);
        on_error rethrow $1.err, sprintf("%s (%s %y)", $1.desc, obj_type, name);

        optional_field(obj_type, oh, "description", (NT_STRING: True, NT_NOTHING: True), \desc);
        if (inLoc == "path") {
            required_field(obj_type, oh, "required", NT_BOOLEAN, \required);
            if (!required) {
                throw "INVALID-PARAMETER", sprintf("Path parameter %y has 'required: false'", name);
            }
        } else {
            optional_field(obj_type, oh, "required", NT_BOOLEAN, \required);
        }

        optional_field(obj_type, oh, "deprecated", NT_BOOLEAN, \deprec);

        hash<auto> schemaObj;
        if (optional_field(obj_type, oh, "schema", NT_HASH, \schemaObj)) {
            schema = SchemaObject::newSchemaObject(name, schemaObj, openapi3, True);
        }

        if (optional_field(obj_type, oh, "style", NT_STRING, \style)) {
            if (!StyleMap{style}) {
                throw "INVALID-STYLE", sprintf("Style %y is invalid; known styles: %y", style, keys StyleMap);
            }
            if (!LocStyleMap{inLoc}{style}) {
                throw "INVALID-STYLE", sprintf("Style %y is invalid for location %y; valid styles for this "
                    "location: %y", style, inLoc, keys LocStyleMap{inLoc});
            }
        } else if (exists (*string s = DefaultStyles{inLoc})) {
            style = s;
        }

        if (!optional_field(obj_type, oh, "explode", NT_BOOLEAN, \explode) && style == "form") {
            explode = True;
        }

        if (inLoc == "query") {
            optional_field(obj_type, oh, "allowReserved", NT_BOOLEAN, \allowReserved);
        }

        hash<auto> content;
        if (optional_field(obj_type, oh, "content", NT_HASH, \content)) {
            if (content.size() != 1) {
                throw "INVALID-CONTENT", sprintf("%s has %d 'content' entries; must have only 1", obj_type,
                    content.size());
            }
            self.content = content.firstKey();
            # TODO FIXME: add content media type processing
            #media = new MediaTypeObject(content.firstValue());
        }
        if (!schemaObj && !content) {
            throw "INVALID-PARAMETER", sprintf("%s parameter is missing both \"schema\" and \"content\"; at least "
                "one is required", name);
        }
    }
}

#! Describes a single operation parameter
/**
    A unique parameter is defined by a combination of a @ref ParameterObject::name "name"
    and @ref ParameterObject::inLoc "location".

    There are five possible parameter types:
    - Path: Used together with Path Templating, where the parameter value is
        actually part of the operation's URL. This does not include the host or
        base path of the API. For example, in <tt>/items/{itemId}</tt>, the path
        parameter is \c itemId.
    - Query: Parameters that are appended to the URL. For example, in <tt>/items?id=###</tt>,
        the query parameter is \c id.
    - Header: Custom headers that are expected as part of the request.
    - Body: The payload that's appended to the HTTP request. Since there can only
        be one payload, there can only be one body parameter. The name of the
        body parameter has no effect on the parameter itself and is used for
        documentation purposes only. Since Form parameters are also in the payload,
        body and form parameters cannot exist together for the same operation.
    - Form: Used to describe the payload of an HTTP request when either
        <tt>application/x-www-form-urlencoded</tt>, <tt>multipart/form-data</tt>
        or both are used as the content type of the request (in %OpenApi3's definition,
        the \c consumes property of an operation). This is the only parameter
        type that can be used to send files, thus supporting the file type.
        Since form parameters are sent in the payload, they cannot be declared
        together with a body parameter for the same operation. Form parameters
        have a different format based on the content-type used (for further details,
        consult http://www.w3.org/TR/html401/interact/forms.html#h-17.13.4):
        - <tt>application/x-www-form-urlencoded</tt> - Similar to the format
          of Query parameters but as a payload. For example,
          <tt>foo=1&bar=openapi3</tt> - both foo and bar are form parameters.
          This is normally used for simple parameters that are being transferred.
        - <tt>multipart/form-data</tt> - each parameter takes a section in
          the payload with an internal header. For example, for the header
          <tt>Content-Disposition: form-data; name="submit-name"</tt> the name
          of the parameter is \c submit-name. This type of form parameters
          is more commonly used for file transfers.
 */
public class ParameterObject inherits ParameterBase {
    public {
        #! Sets the ability to pass empty-valued parameters
        /**
            This is valid only for query parameters and allows sending a parameter with an empty value. Default value
            is false. If style is used, and if behavior is n/a (cannot be serialized), the value of allowEmptyValue
            SHALL be ignored. Use of this property is NOT RECOMMENDED, as it is likely to be removed in a later
            revision.
        */
        bool allowEmptyValue = False;

        const ParameterLocations = {
            "body": True,
            "query": True,
            "path": True,
            "header": True,
            "formData": True,
            "cookie": True,
        };
    }

    #! Constructor
    /**
        @param oh deserialized hash from the source schema description describing a single parameter
        @param openapi3 the REST schema for resolving references

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws INVALID-FIELD-VALUE field has invalid value
        @throws REQUIRED-FIELD-MISSING required field is missing
    */
    public constructor(hash<auto> oh, OpenApi3Schema openapi3) : ParameterBase(oh) {
        required_field("parameter", oh, "name", NT_STRING, \name);
        required_field("parameter", oh, "in", NT_STRING, \inLoc);
        if (!ParameterLocations{inLoc}) {
            throw "INVALID-FIELD-VALUE", sprintf("parameter %y: invalid location (\"in\") value: %y", name, oh."in");
        }
        if (inLoc == "query") {
            optional_field(inLoc + " parameter", oh, "allowEmptyValue", NT_BOOLEAN, \allowEmptyValue);
        }
        parseData(oh, openapi3);
    }

    #! Processes the value against the schema definition
    check(bool serialize, bool request, string path, string method, string name, reference<auto> value) {
        # issue #2369 ignore the parameter if it's not required
        if (!exists value && !required) {
            return;
        }

        on_error rethrow $1.err, sprintf("%s (while checking %s parameter)", $1.desc, self.name);

        # issue #2388 ensure that query parameters are converted to their target type first
        if (inLoc == "query") {
            switch (schema.type) {
                case "integer": {
                    if (value.typeCode() == NT_STRING) {
                        if (value =~ /[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-2][0-9]:[0-5][0-9]:[0-5][0-9])?/) {
                            value = date(value).getEpochSeconds();
                        } else {
                            if (value !~ /^([+-])?[0-9]+$/) {
                                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and method %y of "
                                    "type \"integer\" is invalid; value provided: %y", name, path, method, value);
                            }
                            value = value.toInt();
                        }
                    }
                    break;
                }
                case "number":
                    if (value.typeCode() == NT_STRING) {
                        value = value.toNumber();
                    }
                    break;
                case "string":
                    switch (schema.format) {
                        case "date":
                        case "date-time":
                            try {
                                value = date(value);
                            } catch (hash<ExceptionInfo> ex) {
                                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and method %y of "
                                    "type \"date\" is invalid; value provided: %y (%s)", name, path, method, value,
                                    ex.desc);
                            }
                            break;
                        case "binary":
                            try {
                                value = binary(value);
                            } catch (hash<ExceptionInfo> ex) {
                                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and method %y of "
                                    "type \"binary\" is invalid; value provided: %y (%s)", name, path, method, value,
                                    ex.desc);
                            }
                            break;
                        case "byte":
                            try {
                                value = parse_base64_string(value);
                            } catch (hash<ExceptionInfo> ex) {
                                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and method %y of "
                                    "type \"binary\" is invalid; value provided: %y (%s)", name, path, method, value,
                                    ex.desc);
                            }
                            break;
                    }
                    break;
                case "boolean":
                    value = parse_boolean(value);
                    break;
                case "array":
                    switch (value.typeCode()) {
                        case NT_STRING:
                            value = value.split(",");
                            break;
                        case NT_LIST:
                            break;
                        default:
                            value = exists value ? (value,) : ();
                            break;
                    }
                    break;
            }
        } else if (inLoc == "path" && !value && path) {
            # if we have a path and a missing value then ignore the missing value
            return;
        }
        schema.check(serialize, request, path, method, name, \value);
        if (!exists value && !allowEmptyValue) {
            throw "SCHEMA-VALIDATION-ERROR", sprintf("%s Parameter %y for path %y and method %y has empty value",
                self.name, name, path, method);
        }
    }

    #! Generates Qore example code for a REST API call
    string getQoreExample(reference<hash<RestQoreExampleCodeInfo>> rv) {
        return schema.getQoreExample(\rv, "rest_body", True);
    }

    #! Returns the default value of the parameter
    auto getDefaultValue() {
        return schema.defaultVal;
    }

    # Returns an example value for a REST API call
    auto getExampleValue() {
        return schema.getExampleValue();
    }

    #! gets a concrete instance of an ParameterObject
    static ParameterObject newParameter(string name, hash<auto> oh, OpenApi3Schema openapi3) {
        on_error rethrow $1.err, sprintf("%s (while processing parameter %y)", $1.desc, name);
        if (oh.hasKey("$ref")) {
            return openapi3.resolveParameter(name, oh."$ref", oh);
        }
        return new ParameterObject(oh, openapi3);
    }

    #! Returns the schema for this parameter
    *RestSchemaValidator::AbstractSchemaObject getSchema() {
        return schema;
    }
}

#! contains the possible responses for an operation
/** Inherits from @ref RestSchemaValidator::AbstractResponsesObject "AbstractResponsesObject".
*/
public class ResponsesObject inherits ObjectBase, RestSchemaValidator::AbstractResponsesObject {
    public {
        # The documentation of responses other than the ones declared for specific HTTP response codes.
        /**
            It can be used to cover undeclared responses.
         */
        ResponseObject defaultResp;

        # A hash mapping HTTP status codes to @ref ResponseObject "ResponseObjects".
        /**
            Any HTTP status code can be used as the property name (one property
            per HTTP status code). Describes the expected response for that HTTP status code.
         */
        hash<string, ResponseObject> responses;
    }

    #! Constructor.
    /**
        @param path the URI path for the operation
        @param method the HTTP method for the operation
        @param oh deserialized hash from the source schema description describing the responses for an operation
        @param openapi3 the REST schema for resolving references

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
        @throws EMPTY-RESPONSES no responses given
     */
    public constructor(string path, string method, hash<auto> oh, OpenApi3Schema openapi3) : ObjectBase(oh) {
        string obj_type = "Responses";
        *hash defaultObj;
        if (optional_field(obj_type, oh, "default", NT_HASH, \defaultObj))
            defaultResp = ResponseObject::newResponse("default", defaultObj, openapi3);

        *hash r = map {$1.key: $1.value}, oh.pairIterator(), $1.key =~ /^[0-9]+$/;
        foreach hash resp in (r.pairIterator()) {
            if (resp.value.typeCode() != NT_HASH)
                throw "INVALID-FIELD-TYPE", sprintf("%s %s: Responses Object: response has invalid type %y", method,
                    path, resp.value.type());
            responses{resp.key} = ResponseObject::newResponse(resp.key, resp.value, openapi3);
        }

        if (responses.empty() && !defaultObj)
            throw "EMPTY-RESPONSES", sprintf("%s %s: no valid responses provided for operation", method, path);
    }

    #! Returns the default response, if any
    *RestSchemaValidator::AbstractResponseObject getDefaultResponse() {
        return defaultResp;
    }

    #! Returns the hash of responses by HTTP status code
    *hash<string, RestSchemaValidator::AbstractResponseObject> getResponses() {
        return cast<*hash<string, RestSchemaValidator::AbstractResponseObject>>(responses);
    }
}

#! Describes a single response from an API Operation.
/** Inherits common response members from
    @ref RestSchemaValidator::AbstractResponseObject "AbstractResponseObject".
*/
public class ResponseObject inherits ObjectBase, RestSchemaValidator::AbstractResponseObject {
    public {
        #! A definition of the response structure.
        /**
            It can be a primitive, an array or an object. If this field does not exist,
            it means no content is returned as part of the response. As an extension
            to the @ref SchemaObject "SchemaObject", its root \c type value may also
            be \c "file". This SHOULD be accompanied by a relevant \c produces mime-type.
         */
        *SchemaObject schema;

        #! Content types supported by this response (OpenAPI 3.0).
        /**
            A hash where keys are content type strings from the response content field.
         */
        *hash<string, bool> contentTypes;
    }

    #! private constructor; use newResponse() instead
    /**
        @param key the response code for error reporting
        @param oh deserialized hash from the source schema description describing a single response for an API operation
        @param openapi3 the REST schema for resolving references

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
     */
    private constructor(string key, hash<auto> oh, OpenApi3Schema openapi3) : ObjectBase(oh) {
        string obj_type = key + " Response";
        required_field(obj_type, oh, "description", NT_STRING, \desc);

        *hash<auto> schemaObj;
        if (optional_field(obj_type, oh, "schema", NT_HASH, \schemaObj)) {
            # Swagger 2.0 style: schema directly in response
            schema = SchemaObject::newSchemaObject("response_" + key, schemaObj, openapi3);
        }
        if (oh.content) {
            # OpenAPI 3.0 style: extract content types and schema from content.{mediaType}
            foreach hash<auto> item in (oh.content.pairIterator()) {
                contentTypes{item.key} = True;
                # Use "exists" to handle empty schema objects {} which are falsy but valid (means "any type")
                if (exists item.value.schema && !schema) {
                    schema = SchemaObject::newSchemaObject("response_" + key, item.value.schema, openapi3);
                }
            }
        }

        *hash<auto> headersObj;
        if (optional_field(obj_type, oh, "headers", NT_HASH, \headersObj))
            headers = map {$1.key: new HeaderObject($1.key, $1.value, openapi3)}, headersObj.pairIterator();

        optional_field(obj_type, oh, "examples", NT_HASH, \examples);
        # TODO keys should be Operation 'produces' values
    }

    copy(ResponseObject old) {
    }

    #! returns a new ResponseObject corresponding to the schema definition passed
    /**
        @param key the response code for the response
        @param oh deserialized hash from the source schema description describing a single response for an API
        operation
        @param openapi3 the REST schema for resolving references

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
     */
    static ResponseObject newResponse(string key, hash<auto> oh, OpenApi3Schema openapi3) {
        if (oh.hasKey("$ref"))
            return openapi3.resolveResponse(key, oh."$ref", oh);
        return new ResponseObject(key, oh, openapi3);
    }

    #! Returns the response schema, if any
    *RestSchemaValidator::AbstractSchemaObject getSchema() {
        return schema;
    }
}

#! describes a single HTTP header
public class HeaderObject inherits ParameterBase {
    #! Constructor
    /**
        @param name the header name
        @param oh deserialized hash from the source schema description describing a single HTTP header
        @param openapi3 the REST schema for resolving references

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws INVALID-FIELD-VALUE field has invalid value
        @throws REQUIRED-FIELD-MISSING required field is missing
     */
    public constructor(string name, hash<auto> oh, OpenApi3Schema openapi3) : ParameterBase(oh) {
        self.name = name;
        inLoc = "header";
        if (oh.hasKey("in")) {
            throw "HEADER-ERROR", sprintf("Header %y must not specify the 'in' keyword (%y)", name, oh."in");
        }
        parseData(oh, openapi3);
    }

    #! Validates the header value
    check(bool serialize, bool request, string path, string method, string name, reference<auto> value) {
        if (!exists value && !required) {
            return;
        }
        if (schema) {
            schema.check(serialize, request, path, method, name, \value);
        }
    }

    #! Returns the schema for this header
    *RestSchemaValidator::AbstractSchemaObject getSchema() {
        return schema;
    }
}

#! Allows adding metadata to a single tag that is used by the @ref OperationObject. It is not mandatory to have a TagObject per tag used there.
public class TagObject inherits ObjectBase {
    public {
        #! Required. The name of the tag.
        string name;

        #! A short description for the tag. GFM syntax can be used for rich text representation.
        *string desc;

        #! Additional external documentation for this tag.
        *ExternalDocumentationObject externalDocs;
    }

    #! Constructor.
    /**
        @param oh deserialized hash from the source schema description describing a metadata tag associated with an operation

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
     */
    public constructor(hash<auto> oh) : ObjectBase(oh) {
        string obj_type = "Tag";
        required_field(obj_type, oh, "name", NT_STRING, \name);
        optional_field(obj_type, oh, "description", (NT_STRING: True, NT_NOTHING: True), \desc);

        *hash extDocsObj;
        if (optional_field(obj_type, oh, "externalDocs", NT_HASH, \extDocsObj))
            externalDocs = new ExternalDocumentationObject(extDocsObj);
    }
}

#! A hash data type that performs OpenAPI 3.0 schema validation including composition (allOf, oneOf, anyOf, not)
/** This type extends HashDataType to add validation for OpenAPI 3.0 schema composition features.
    It validates data against oneOf, anyOf, not, allOf schemas as well as readOnly/writeOnly constraints.
*/
public class OpenApi3HashDataType inherits HashDataType {
    private {
        #! Reference to the schema object for validation
        SchemaObject schema;

        #! Is this type for a request (True) or response (False)?
        bool for_request;
    }

    #! Creates the type with a reference to the schema object
    /**
        @param base_type the base Qore type
        @param name the type name
        @param schema the SchemaObject for validation
        @param for_request True if this type is for request validation, False for response validation
    */
    constructor(Type base_type, string name, SchemaObject schema, bool for_request = True)
            : HashDataType(base_type, name) {
        self.schema = schema;
        self.for_request = for_request;
    }

    #! Returns the schema object
    SchemaObject getSchema() {
        return schema;
    }

    #! Returns True if this type is for request validation
    bool isForRequest() {
        return for_request;
    }

    #! Validates the value against the schema including composition rules
    /**
        @param input_value the value to validate
        @return the validated/converted value

        @throw RUNTIME-TYPE-ERROR if the value does not match the schema
    */
    auto acceptsValue(auto input_value) {
        # First perform basic HashDataType validation
        auto value = HashDataType::acceptsValue(input_value);

        # Then perform schema composition validation
        if (value.typeCode() == NT_HASH) {
            validateSchemaComposition(value);
        }

        return value;
    }

    #! Validates schema composition rules (oneOf, anyOf, not, readOnly, writeOnly)
    private validateSchemaComposition(hash<auto> value) {
        # Check oneOf - value must match exactly one schema
        if (schema.oneOf) {
            int matches = 0;
            list<string> matched_schemas;
            foreach SchemaObject s in (schema.oneOf) {
                if (matchesSchema(s, value)) {
                    ++matches;
                    matched_schemas += s.name;
                }
            }
            if (matches == 0) {
                throw "RUNTIME-TYPE-ERROR", sprintf("Type %y: value does not match any of the oneOf schemas",
                    getName());
            }
            if (matches > 1) {
                throw "RUNTIME-TYPE-ERROR", sprintf("Type %y: value matches multiple oneOf schemas (%y); "
                    "must match exactly one", getName(), matched_schemas);
            }
        }

        # Check anyOf - value must match at least one schema
        if (schema.anyOf) {
            bool matched = False;
            foreach SchemaObject s in (schema.anyOf) {
                if (matchesSchema(s, value)) {
                    matched = True;
                    break;
                }
            }
            if (!matched) {
                throw "RUNTIME-TYPE-ERROR", sprintf("Type %y: value does not match any of the anyOf schemas",
                    getName());
            }
        }

        # Check not - value must NOT match the schema
        if (schema.notSchema) {
            if (matchesSchema(schema.notSchema, value)) {
                throw "RUNTIME-TYPE-ERROR", sprintf("Type %y: value must not match the 'not' schema", getName());
            }
        }

        # Check readOnly fields in requests
        if (for_request) {
            foreach string key in (keys value) {
                *SchemaObject prop = schema.properties{key};
                if (prop && prop.readOnly) {
                    throw "RUNTIME-TYPE-ERROR", sprintf("Type %y: property %y is read-only and cannot be "
                        "included in a request", getName(), key);
                }
            }
        }

        # Check writeOnly fields in responses
        if (!for_request) {
            foreach string key in (keys value) {
                *SchemaObject prop = schema.properties{key};
                if (prop && prop.writeOnly) {
                    throw "RUNTIME-TYPE-ERROR", sprintf("Type %y: property %y is write-only and cannot be "
                        "included in a response", getName(), key);
                }
            }
        }
    }

    #! Checks if a value matches a schema (for oneOf/anyOf/not validation)
    private bool matchesSchema(SchemaObject s, hash<auto> value) {
        # Check required properties
        if (s.required) {
            foreach string key in (keys s.required) {
                if (!value.hasKey(key)) {
                    return False;
                }
            }
        }

        # Check that all properties in the value are valid for this schema
        # By default in OpenAPI 3.0, additionalProperties is True
        # Only reject unknown properties if additionalProperties is explicitly False
        if (s.properties && s.additionalProperties === False) {
            foreach string key in (keys value) {
                if (!s.properties{key}) {
                    return False;
                }
            }
        }

        # Check property types for known properties
        foreach hash<auto> i in (value.pairIterator()) {
            *SchemaObject prop = s.properties{i.key};
            if (prop) {
                if (!matchesPropertyType(prop, i.value)) {
                    return False;
                }
            }
        }

        return True;
    }

    #! Checks if a value matches a property's expected type
    private bool matchesPropertyType(SchemaObject prop, auto value) {
        if (!exists value) {
            return prop.nullable;
        }

        switch (prop.type) {
            case "string":
                return value.typeCode() == NT_STRING;
            case "integer":
                return value.typeCode() == NT_INT;
            case "number":
                return value.typeCode() == NT_INT || value.typeCode() == NT_FLOAT;
            case "boolean":
                return value.typeCode() == NT_BOOLEAN;
            case "array":
                return value.typeCode() == NT_LIST;
            case "object":
                return value.typeCode() == NT_HASH;
            case "any":
                return True;
        }
        return True;
    }
}

#! defines an object in a schema
/** Inherits common schema members from
    @ref RestSchemaValidator::AbstractSchemaObject "AbstractSchemaObject".
*/
public class SchemaObject inherits ObjectBase, SchemaBase, RestSchemaValidator::AbstractRestSchemaObject {
    public {

        #! Relevant only for Schema \c "properties" definitions. Declares the property as "write only".
        /**
            Declares the property as "write only". This means that it MAY be sent
            as part of a request but MUST NOT be sent as part of the response.
            Properties marked as \c writeOnly being \c true SHOULD NOT be in the
            @ref SchemaObject::required "required" list of the defined schema.
            Default value is \c false.
         */
        bool writeOnly = False;

        #! Specifies that a schema is deprecated.
        /**
            Specifies that a schema is deprecated and SHOULD be transitioned out of usage.
            Default value is \c false.

            Note: stored as \c deprec because \c deprecated is a Qore keyword.
         */
        bool deprec = False;

        #! Content encoding for binary data (OpenAPI 3.1+)
        /** Specifies the Content-Encoding for the schema, such as "base64".
            Used in place of format: binary/base64 in OpenAPI 3.1+.
        */
        *string contentEncoding;

        #! Content media type for binary data (OpenAPI 3.1+)
        /** Specifies the media type of the contents, such as "image/png".
            Used in conjunction with contentEncoding for binary data in OpenAPI 3.1+.
        */
        *string contentMediaType;

        #! See https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.5.3.
        /**
            List of @ref SchemaObject "SchemaObjects"; MUST have at least one element.

            %OpenApi3 allows combining and extending model definitions using the
            \c allOf property of JSON Schema, in effect offering model composition.
            \c allOf takes in an array of object definitions that are validated
            independently but together compose a single object.
         */
        list<SchemaObject> allOf();

        #! See https://json-schema.org/understanding-json-schema/reference/combining.html#oneof
        /**
            List of @ref SchemaObject "SchemaObjects"; MUST have at least one element.

            The given data must be valid against exactly one of the given subschemas.
         */
        list<SchemaObject> oneOf();

        #! See https://json-schema.org/understanding-json-schema/reference/combining.html#anyof
        /**
            List of @ref SchemaObject "SchemaObjects"; MUST have at least one element.

            The given data must be valid against any (one or more) of the given subschemas.
         */
        list<SchemaObject> anyOf();

        #! This MAY be used only on properties schemas. It has no effect on root schemas.
        /**
            Adds Additional metadata to describe the XML representation format of this property.

            The \c xml property allows extra definitions when translating the
            JSON definition to XML. The @ref XmlObject contains additional
            information about the available options.
         */
        *XmlObject xml;

        #! Additional external documentation for this schema.
        *ExternalDocumentationObject externalDocs;

        #! An array of examples for this schema (OpenAPI 3.1 style).
        *list<auto> examples;

        #! valid scalar types
        const ScalarTypes = (
            "string": True,
            "number": True,
            "integer": True,
            "boolean": True,
            "array": True,
        );

        #! valid reference types
        const ReferenceTypes = ScalarTypes + (
            "object": True,
        );
    }

    private {
        #! Reference to the OpenApi3 schema
        OpenApi3Schema openapi3;
    }

    #! private constructor; use newSchemaObject() instead
    /**
        @param name the name of the object
        @param oh deserialized hash from the source schema description describing an object in the schema
        @param openapi3 the REST schema for resolving references
        @param hash_str the unique hash for the value being parsed
        @param require_items require items for arrays

        @throws INVALID-FIELD-FORMAT field has invalid format
        @throws INVALID-FIELD-TYPE field has invalid type
        @throws INVALID-FIELD-VALUE field has invalid value
        @throws INVALID-REFERENCE cannot resolve reference; unknown attributes in description
        @throws REQUIRED-FIELD-MISSING required field is missing
    */
    private constructor(string name, hash<auto> oh, OpenApi3Schema openapi3, *string hash_str, *bool require_items)
            : ObjectBase(oh), SchemaBase("Schema", oh) {
        self.name = name;
        self.openapi3 := openapi3;
        # add static map reference
        if (!hash_str.val()) {
            hash_str = sprintf("%y", oh).toSHA256();
        }
        openapi3.cacheSchemaObject(name, hash_str, self);
        string obj_type = "Schema";

        # Parse type - supports both string (3.0) and array (3.1) formats
        if (oh.hasKey("type")) {
            if (oh.type.typeCode() == NT_LIST) {
                # OpenAPI 3.1 style: type: ["string", "null"]
                list<auto> rawTypes = oh.type;
                # Check for "null" to set nullable and filter it out
                list<string> types = ();
                foreach auto t in (rawTypes) {
                    if (t == "null") {
                        nullable = True;
                    } else {
                        types += t;
                    }
                }
                # Get the primary type (first non-null type)
                if (types.size() > 0) {
                    type = types[0];
                    if (!ReferenceTypes{type})
                        throw "INVALID-FIELD-VALUE", sprintf("Schema Object %y: invalid schema type value passed: %y; "
                            "expected one of: %y", name, type, keys ReferenceTypes);
                } else {
                    type = "any";
                }
            } else if (oh.type.typeCode() == NT_STRING) {
                # OpenAPI 3.0 style: type: "string"
                type = oh.type;
                if (!ReferenceTypes{type})
                    throw "INVALID-FIELD-VALUE", sprintf("Schema Object %y: invalid schema type value passed: %y; "
                        "expected one of: %y", name, type, keys ReferenceTypes);
            } else {
                throw "INVALID-FIELD-TYPE", sprintf("Schema Object %y: \"type\" field has invalid type %y; "
                    "expected string or list", name, oh.type.type());
            }

            if (type == "array" && (require_items || exists oh.items)) {
                items = newSchemaObject("items", oh.items ?? {"type": "object"}, openapi3);
            }

            if (oh.hasKey("default")) {
                defaultVal = oh."default";
                SchemaObject::checkValueType(\defaultVal, type, items);
            }
        } else if (oh.properties) {
            type = "object";
        } else {
            type = "any";
        }

        # check for x-nullable (3.0 style) and nullable (standard)
        optional_field(obj_type, oh, "x-nullable", NT_BOOLEAN, \nullable);
        # Also support standard nullable keyword (OpenAPI 3.0)
        if (!nullable) {
            optional_field(obj_type, oh, "nullable", NT_BOOLEAN, \nullable);
        }

        if (optional_field(obj_type, oh, "format", NT_STRING, \format)) {
            # unrecognized format values should be ignored
            if (!format.val()) {
                throw "INVALID-FIELD-VALUE", sprintf("Schema Object: invalid %y type empty \"format\" value passed",
                    type);
            }
        }

        optional_field(obj_type, oh, "title", NT_STRING, \title);
        optional_field(obj_type, oh, "description", (NT_STRING: True, NT_NOTHING: True), \desc);

        if (optional_field(obj_type, oh, "maxProperties", NT_INT, \maxProperties)) {
            checkObjectProperty(name, "maxProperties");
            if (maxProperties < 0)
                throw "INVALID-FIELD-FORMAT", sprintf("Schema Object %y: 'maxProperties' field less than 0", name);
        }
        if (optional_field(obj_type, oh, "minProperties", NT_INT, \minProperties)) {
            checkObjectProperty(name, "minProperties");
            if (minProperties < 0)
                throw "INVALID-FIELD-FORMAT", sprintf("Schema Object %y: 'minProperties' field less than 0", name);
        }

        {
            hash props;
            if (optional_field(obj_type, oh, "properties", NT_HASH, \props)) {
                checkObjectProperty(name, "properties");
                foreach string k in (keys props) {
                    auto val = props{k};
                    if (val.typeCode() != NT_HASH)
                        throw "INVALID-FIELD-FORMAT", sprintf("Schema Object %y: 'properties' field is not a hash of "
                            "Schema Objects (got type %y; expecting \"hash\": %y)", name, val.fullType(), val);
                    properties{k} = SchemaObject::newSchemaObject(k, val, openapi3);
                    if (!properties{k}.nullable && val."x-nullable") {
                        nullable_properties{k} = True;
                    }
                }
            } else {
                additionalProperties = True;
            }
        }

        if (optional_field(obj_type, oh, "additionalProperties", (NT_BOOLEAN: True, NT_HASH: True),
            \additionalProperties)) {
            checkObjectProperty(name, "additionalProperties");
            if (additionalProperties.typeCode() == NT_HASH)
                additionalProperties = SchemaObject::newSchemaObject("additionalProperties", additionalProperties,
                    openapi3);
        }

        # process "required"
        if (optional_field(obj_type, oh, "required", OpenApi3ListToStringSet, \required)) {
            if (!required)
                throw "INVALID-FIELD-FORMAT", sprintf("Schema Object %y: field 'required' is an empty list", name);
            # make sure all required properties are defined
            if (!additionalProperties && (*list<string> missing = keys (required - keys properties))) {
                throw "INVALID-FIELD-VALUE", sprintf("Schema Object %y: the following required properties are not "
                    "defined: %y", name, missing);
            }
        }

        if (optional_field(obj_type, oh, "discriminator", NT_STRING, \discriminator)) {
            if (!required{discriminator})
                throw "INVALID-FIELD-VALUE", sprintf("Schema Object %y: 'discriminator' field value not in the "
                    "'required' list", name);
        }

        optional_field(obj_type, oh, "readOnly", NT_BOOLEAN, \readOnly);
        optional_field(obj_type, oh, "writeOnly", NT_BOOLEAN, \writeOnly);
        optional_field(obj_type, oh, "deprecated", NT_BOOLEAN, \deprec);

        # OpenAPI 3.1+: contentEncoding and contentMediaType for binary data
        optional_field(obj_type, oh, "contentEncoding", NT_STRING, \contentEncoding);
        optional_field(obj_type, oh, "contentMediaType", NT_STRING, \contentMediaType);

        {
            *list allOfList;
            if (optional_field(obj_type, oh, "allOf", NT_LIST, \allOfList)) {
                if (allOfList.size() < 1)
                    throw "INVALID-FIELD-FORMAT", sprintf("Schema Object %y: field 'allOf' is an empty list", name);
                foreach auto val in (allOfList) {
                    if (val.typeCode() != NT_HASH)
                        throw "INVALID-FIELD-TYPE", sprintf("Schema Object %y: invalid 'allOf' list value "
                            "datatype: %y", name, val.type());
                    allOf[allOf.size()] = SchemaObject::newSchemaObject(name + "AllOf", val, openapi3);
                }
            }
        }

        {
            *list oneOfList;
            if (optional_field(obj_type, oh, "oneOf", NT_LIST, \oneOfList)) {
                if (oneOfList.size() < 1)
                    throw "INVALID-FIELD-FORMAT", sprintf("Schema Object %y: field 'oneOf' is an empty list", name);
                foreach auto val in (oneOfList) {
                    if (val.typeCode() != NT_HASH)
                        throw "INVALID-FIELD-TYPE", sprintf("Schema Object %y: invalid 'oneOf' list value "
                            "datatype: %y", name, val.type());
                    oneOf[oneOf.size()] = SchemaObject::newSchemaObject(name + "OneOf", val, openapi3);
                }
            }
        }

        {
            *list anyOfList;
            if (optional_field(obj_type, oh, "anyOf", NT_LIST, \anyOfList)) {
                if (anyOfList.size() < 1)
                    throw "INVALID-FIELD-FORMAT", sprintf("Schema Object %y: field 'anyOf' is an empty list", name);
                foreach auto val in (anyOfList) {
                    if (val.typeCode() != NT_HASH)
                        throw "INVALID-FIELD-TYPE", sprintf("Schema Object %y: invalid 'anyOf' list value "
                            "datatype: %y", name, val.type());
                    anyOf[anyOf.size()] = SchemaObject::newSchemaObject(name + "AnyOf", val, openapi3);
                }
            }
        }

        {
            *hash notObj;
            if (optional_field(obj_type, oh, "not", NT_HASH, \notObj)) {
                notSchema = SchemaObject::newSchemaObject(name + "Not", notObj, openapi3);
            }
        }

        *hash xmlObj;
        if (optional_field(obj_type, oh, "xml", NT_HASH, \xmlObj))
            xml = new XmlObject(xmlObj);

        *hash extDocsObj;
        if (optional_field(obj_type, oh, "externalDocs", NT_HASH, \extDocsObj))
            externalDocs = new ExternalDocumentationObject(extDocsObj);

        # Parse example (3.0 style) and examples (3.1 style)
        if (oh.hasKey("example"))
            example = oh.example;
        if (oh.hasKey("examples")) {
            if (oh.examples.typeCode() == NT_LIST) {
                examples = oh.examples;
            } else {
                throw "INVALID-FIELD-TYPE", sprintf("Schema Object %y: 'examples' field has invalid type %y; "
                    "expected list", name, oh.examples.type());
            }
        }
    }

    copy(SchemaObject old) {
    }

    #! returns example Qore code for the object
    string getQoreExample(reference<hash<RestQoreExampleCodeInfo>> rv, string name, bool decl) {
        string typestr = get_qore_type(self.name, type, format, items);
        if (type == "array") {
            if (decl)
                return sprintf("%s %s(%s,);\n", typestr, name, cast<SchemaObject>(items).getQoreExample(\rv, name, False));
            else
                return sprintf("(%s,)", cast<SchemaObject>(items).getQoreExample(\rv, self.name, False));
        }

        if (type != "object") {
            auto val = getExampleValue();
            string example;
            switch (val.typeCode()) {
                case NT_DATE:
                    example = val.format("YYYY-MM-DDTHH:mm:SS.xxZ");
                    break;
                case NT_BINARY:
                    example = sprintf("<%s>", val.toHex());
                    break;
                default:
                    example = sprintf("%y", val);
                    break;
            }
            if (decl)
                return sprintf("%s %s = %s;\n", typestr, name, example);
            return example;
        }

        if (properties) {
            string str = sprintf("hashdecl %s {\n", self.name);
            foreach hash h in (cast<hash<string, SchemaObject>>(properties).pairIterator()) {
                str += sprintf("    %s %s", get_qore_type(h.value.name, h.value.type, h.value.format, h.value.items), h.key);
                if (exists h.value.defaultVal)
                    str += sprintf(" = %y", h.value.defaultVal);
                str += ";\n";
            }
            str += "}\n";
            rv.hashdecls{self.name} = str;
        }

        string str;
        if (properties) {
            if (decl)
                str = sprintf("hash<%s> %s(", self.name, name);
            else
                str = sprintf("new hash<%s>(", self.name);

            str += "{\n";
            foreach hash<auto> h in (cast<hash<string, SchemaObject>>(properties).pairIterator()) {
                string pstr;
                if (h.value.type == "string" && (h.value.format =~ /date(-time)?/))
                    pstr = sprintf("%y: date(%s)", h.key, h.value.getQoreExample(\rv, h.key, False));
                else
                    pstr = sprintf("%y: %s", h.key, h.value.getQoreExample(\rv, h.key, False));
                # add 4 spaces to the beginning of each line
                str += foldl $1 + "\n" + $2, (map "    " + $1, pstr.split("\n"));
                str += ",\n";
            }
            str += "})";
        } else if (additionalProperties instanceof SchemaObject) {
            string ptype = get_qore_type(additionalProperties.name, additionalProperties.type,
                additionalProperties.format, additionalProperties.items);
            if (decl)
                str = sprintf("hash<string, %s> %s()", ptype, name);
            else
                str = sprintf("new hash<string, %s>()", ptype);
        }
        if (decl)
            str += ";\n";
        return str;
    }

    #! Returns the data type for the schema
    #! Returns True if this schema has composition features that require special type handling
    /** Checks for oneOf, anyOf, not, or properties with readOnly/writeOnly attributes
    */
    bool hasSchemaCompositionFeatures() {
        if (oneOf || anyOf || notSchema) {
            return True;
        }
        # Check for readOnly/writeOnly properties
        foreach SchemaObject prop in (cast<*hash<string, SchemaObject>>(properties).iterator()) {
            if (prop.readOnly || prop.writeOnly) {
                return True;
            }
        }
        return False;
    }

    #! Returns True if this schema has composition keywords (oneOf/anyOf/not)
    bool hasCompositionKeywords() {
        return oneOf || anyOf || notSchema ? True : False;
    }

    #! Returns the data provider type for a given type/format/items path
    AbstractDataProviderType getSchemaType(string path, string typestr, *string format,
            *AbstractSchemaObject arrayItems, bool required) {
        return openapi3.getType(path, typestr, format, arrayItems, required);
    }

    #! Factory method to create a HashDataType, allowing OpenApi3 to return OpenApi3HashDataType
    HashDataType createHashDataType(Type base_type, string typename) {
        if (hasSchemaCompositionFeatures()) {
            return new OpenApi3HashDataType(base_type, typename, self, True);
        }
        return new HashDataType(base_type, typename);
    }

    # returns an example value for a REST API call
    auto getExampleValue() {
        if (exists example) {
            return example;
        }
        if (exists defaultVal) {
            return defaultVal;
        }

        # Handle allOf by merging properties from all schemas
        if (allOf) {
            hash<auto> rv = {};
            foreach SchemaObject schema in (allOf) {
                *hash<auto> schemaExample = schema.getExampleValue();
                if (schemaExample) {
                    rv += schemaExample;
                }
            }
            # Also add any local properties
            if (properties) {
                rv += map {$1.key: cast<SchemaObject>($1.value).getExampleValue()}, properties.pairIterator();
            }
            return rv;
        }

        if (type == "object") {
            return map {$1.key: cast<SchemaObject>($1.value).getExampleValue()}, properties.pairIterator();
        }

        if (type == "array") {
            return (cast<SchemaObject>(items).getExampleValue(),);
        }

        return SchemaBase::getExampleValueWithFormat(type, format, name);
    }

    #! validates the value against the schema definition
    check(bool serialize, bool request, string path, string method, string name, reference<auto> value) {
        if (request && readOnly)
            throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: property %y is read-only and therefore cannot be "
                "included in a request", method.upr(), path, name);
        if (!request && writeOnly)
            throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: property %y is write-only and therefore cannot be "
                "included in a response", method.upr(), path, name);
        if (!exists value && nullable) {
            return;
        }

        SchemaBase::check(serialize, request, type, format, items, path, method, name, \value);
    }

    private checkObjectProperty(string name, string prop) {
        if (type != "object") {
            throw "INVALID-FIELD-FORMAT", sprintf("Schema Object %y: %y cannot be given on an object of type %y",
                name, prop, type);
        }
    }

    private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
            string name, nothing v, reference<nothing> value) {
        if (type != "null" && type != "any" && !nullable) {
            throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and method %y is null, but the "
                "expected type is %y", name, path, method, type);
        }
    }

    #! validates a schema object against a value
    private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
            string name, hash<auto> v, reference<hash<auto>> value, *bool no_check_others) {
        if (type != "object" && type != "any") {
            throwInvalidType(name, "object", type, v);
        }

        # check "allOf" schemas, if any
        map $1.checkIntern(serialize, request, type, NOTHING, path, method, name, v, \value, True), allOf;

        # check "oneOf" schemas, if any - value must match exactly one schema
        if (oneOf) {
            int matches = 0;
            list<string> matched_schemas;
            foreach SchemaObject schema in (oneOf) {
                try {
                    hash<auto> test_value = value;
                    schema.checkIntern(serialize, request, schema.type ?? type, NOTHING, path, method, name, v,
                        \test_value, True);
                    ++matches;
                    matched_schemas += schema.name;
                } catch (hash<ExceptionInfo> ex) {
                    # schema didn't match, continue
                }
            }
            if (matches == 0) {
                throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: value for %y does not match any of the oneOf "
                    "schemas", method.upr(), path, name);
            }
            if (matches > 1) {
                throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: value for %y matches multiple oneOf schemas "
                    "(%y); must match exactly one", method.upr(), path, name, matched_schemas);
            }
        }

        # check "anyOf" schemas, if any - value must match at least one schema
        if (anyOf) {
            bool matched = False;
            foreach SchemaObject schema in (anyOf) {
                try {
                    hash<auto> test_value = value;
                    schema.checkIntern(serialize, request, schema.type ?? type, NOTHING, path, method, name, v,
                        \test_value, True);
                    matched = True;
                    break;
                } catch (hash<ExceptionInfo> ex) {
                    # schema didn't match, continue
                }
            }
            if (!matched) {
                throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: value for %y does not match any of the anyOf "
                    "schemas", method.upr(), path, name);
            }
        }

        # check "not" schema, if any - value must NOT match the schema
        if (notSchema) {
            try {
                hash<auto> test_value = value;
                notSchema.checkIntern(serialize, request, notSchema.type ?? type, NOTHING, path, method, name, v,
                    \test_value, True);
                # if we get here, the value matched the "not" schema, which is an error
                throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: value for %y must not match the 'not' schema",
                    method.upr(), path, name);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "SCHEMA-VALIDATION-ERROR" && ex.desc !~ /must not match/) {
                    # good - the value didn't match the "not" schema
                } else {
                    rethrow;
                }
            }
        }

        /*
            If additionalProperties is set to true, any number of additionalProperties may be present of any data
            type.
            If additionalProperties is a schema, additional properties (beyond what are defined in 'properties') are
            allowed and must match the schema
        */
        # check properties in this schema definition
        if (additionalProperties !== True && type != "any" && !no_check_others) {
            # issue #4825: write the hash keys to another hash in case values need to change type
            hash<auto> nv;
            foreach string key in (keys value) {
                *SchemaObject prop = cast<*SchemaObject>(properties{key});
                if (!prop) {
                    if (additionalProperties instanceof SchemaObject) {
                        prop = additionalProperties;
                    }
                    if (!prop) {
                        throw "SCHEMA-VALIDATION-ERROR", sprintf("Property %y is not valid for object %y "
                            "(value: %y); valid properties: %y",  key, name, value, keys properties);
                    }
                }
                if (exists value{key} || (required{key} && !nullable_properties{key})) {
                    nv{key} += value{key};
                    prop.check(serialize, request, path, method, key, \nv{key});
                }
            }
            if (nv) {
                value = nv;
            }
        }
        # check for missing required properties
        if (*list<string> missing = keys (required - keys value)) {
            throw "SCHEMA-VALIDATION-ERROR", sprintf("object %y: missing required properties: %y (have: %y)", name,
                missing, keys (required - missing));
        }
        #printf("SchemaObject::checkIntern() %y type: %y val: %y self: %Y\n", name, type, value, self);
    }

    #! validates default values
    private static checkValueType(reference<auto> value, string type, *SchemaObject items, *string loc) {
        int vt = value.typeCode();
        if (type == "array") {
            if (vt != NT_LIST)
                throw "INVALID-FIELD-TYPE", sprintf("Schema Object: 'default' value%s has invalid type %y (expecting "
                    "schema type %y)", loc, value.type(), type);
            SchemaObject::checkValueType(\value[0], items.type, items.items, loc + "[0]");
        }
        if (!SchemaBase::checkValueType(\value, type)) {
            throw "INVALID-FIELD-TYPE", sprintf("Schema Object: 'default' value%s has invalid type %y (val: %y) "
                "(expecting schema type %y)", loc, value.type(), value, type);
        }
    }

    #! returns a SchemaObject for the schema definition; resolves references
    /**
        @param name the name of the object
        @param oh deserialized hash from the source schema description describing an object in the schema
        @param openapi3 the REST schema for resolving references
        @param require_items if @ref True, require \c items for array types

        @throws INVALID-FIELD-FORMAT field has invalid format
        @throws INVALID-FIELD-TYPE field has invalid type
        @throws INVALID-FIELD-VALUE field has invalid value
        @throws INVALID-REFERENCE cannot resolve reference; unknown attributes in description
        @throws REQUIRED-FIELD-MISSING required field is missing
    */
    static SchemaObject newSchemaObject(string name, hash<auto> oh, OpenApi3Schema openapi3, *bool require_items) {
        string refstr;
        if (optional_field("Schema", oh, "$ref", NT_STRING, \refstr))
            return openapi3.resolveSchemaObject(name, refstr, oh);

        string hash_str;
        *SchemaObject rv = openapi3.tryGetSchemaObject(name, oh, \hash_str);
        if (rv) {
            return rv;
        }
        return new SchemaObject(name, oh, openapi3, hash_str, require_items);
    }

    #! throws an \c "INVALID-FIELD-TYPE" exception
    /** @throws INVALID-FIELD-TYPE due to a type error in the call
    */
    static SchemaObject newSchemaObject(string name, auto error, OpenApi3Schema openapi3) {
        throw "INVALID-FIELD-TYPE", sprintf("invalid field type %y for key %y; expecting \"hash\"", error.type(),
            name);
    }

    #! Returns the x-example extension value if set.
    /** This extension provides an additional example for the schema. */
    auto getXExample() {
        return vendorExtensions."x-example";
    }

    #! Returns the x-examples extension value if set.
    /** This extension provides multiple examples for the schema. */
    *list<auto> getXExamples() {
        return vendorExtensions."x-examples";
    }

    #! Returns the x-enum-varnames extension value if set.
    /** This extension provides variable names for enum values (used in code generation). */
    *list<string> getEnumVarnames() {
        return vendorExtensions."x-enum-varnames";
    }

    #! Returns the x-enum-descriptions extension value if set.
    /** This extension provides descriptions for each enum value. */
    *list<string> getEnumDescriptions() {
        return vendorExtensions."x-enum-descriptions";
    }

    #! Returns the x-codegen-type extension value if set.
    /** This extension overrides the generated type name in code generation. */
    *string getCodegenType() {
        return vendorExtensions."x-codegen-type";
    }

    #! Returns the x-model-name extension value if set.
    /** This extension specifies the model class name for code generation. */
    *string getModelName() {
        return vendorExtensions."x-model-name";
    }

    #! Returns the x-class-name extension value if set.
    /** This extension specifies the class name override for code generation. */
    *string getClassName() {
        return vendorExtensions."x-class-name";
    }

}

#! A metadata object that allows for more fine-tuned XML model definitions.
/**
    When using arrays, XML element names are not inferred (for singular/plural
    forms) and the @ref XmlObject::name "name" property should be used to add that information.
    See examples for expected behavior.
 */
public class XmlObject inherits ObjectBase {
    public {
        #! Replaces the name of the element/attribute used for the described schema property.
        /**
            When defined within the \c items, it will affect
            the name of the individual XML elements within the list.
            When defined alongside \c type being \c array (outside the \c items),
            it will affect the wrapping element and only if \c wrapped is \c true.
            If \c wrapped is \c false, it will be ignored.
         */
        *string name;

        #! The URL of the namespace definition. Value SHOULD be in the form of a URL.
        *string ns;

        #! The prefix to be used for the @ref XmlObject::name "name".
        *string prefix;

        #! Declares whether the property definition translates to an attribute instead of an element. Default value is \c false.
        bool attribute = False;

        #! MAY be used only for an array definition. Signifies whether the array is wrapped (for example, \c &lt;books&gt;&lt;book/&gt;&lt;book/&gt;&lt;/books&gt;) or unwrapped (\c &lt;book/&gt;&lt;book/&gt;).
        /**
            Default value is \c false. The definition takes effect only when
            defined alongside \c type being \c array (outside the \c items).
         */
        bool wrapped = False;
    }

    #! Constructor.
    /**
        @param oh deserialized hash from the source schema description describing XML model definitions

        @throws INVALID-FIELD-TYPE field has invalid type
     */
    public constructor(hash<auto> oh) : ObjectBase(oh) {
        string obj_type = "XML";
        optional_field(obj_type, oh, "name", NT_STRING, \name);
        optional_field(obj_type, oh, "namespace", NT_STRING, \ns);
        optional_field(obj_type, oh, "prefix", NT_STRING, \prefix);
        optional_field(obj_type, oh, "attribute", NT_BOOLEAN, \attribute);
        optional_field(obj_type, oh, "wrapped", NT_BOOLEAN, \wrapped);
    }
}

#! Allows the definition of a security scheme that can be used by the operations.
/**
    Supported schemes are basic authentication, an API key (either as a header
    or as a query parameter) and OAuth2's common flows (implicit, password,
    application and access code).
 */
#! Describes a single OAuth flow configuration
public class OAuthFlowObject inherits ObjectBase {
    public {
        #! The authorization URL to be used for this flow
        /** Required for implicit and authorizationCode flows */
        *string authorizationUrl;

        #! The token URL to be used for this flow
        /** Required for password, clientCredentials, and authorizationCode flows */
        *string tokenUrl;

        #! The URL to be used for obtaining refresh tokens
        *string refreshUrl;

        #! The available scopes for the OAuth2 security scheme
        /** Required. Maps scope names to short descriptions */
        ScopesObject scopes;
    }

    #! Constructor
    /**
        @param oh deserialized hash from the source schema
        @param flow_type the type of OAuth flow (implicit, password, clientCredentials, authorizationCode)

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
    */
    public constructor(hash<auto> oh, string flow_type) : ObjectBase(oh) {
        string obj_type = sprintf("OAuth Flow (%s)", flow_type);

        # authorizationUrl required for implicit and authorizationCode
        if (flow_type == "implicit" || flow_type == "authorizationCode") {
            required_field(obj_type, oh, "authorizationUrl", NT_STRING, \authorizationUrl);
        } else {
            optional_field(obj_type, oh, "authorizationUrl", NT_STRING, \authorizationUrl);
        }

        # tokenUrl required for password, clientCredentials, and authorizationCode
        if (flow_type == "password" || flow_type == "clientCredentials" || flow_type == "authorizationCode") {
            required_field(obj_type, oh, "tokenUrl", NT_STRING, \tokenUrl);
        } else {
            optional_field(obj_type, oh, "tokenUrl", NT_STRING, \tokenUrl);
        }

        optional_field(obj_type, oh, "refreshUrl", NT_STRING, \refreshUrl);

        hash<auto> scopesObj;
        required_field(obj_type, oh, "scopes", NT_HASH, \scopesObj);
        scopes = new ScopesObject(scopesObj);
    }
}

#! Describes the OAuth flows configuration for the oauth2 security scheme
public class OAuthFlowsObject inherits ObjectBase {
    public {
        #! Configuration for the OAuth Implicit flow
        *OAuthFlowObject implicit;

        #! Configuration for the OAuth Resource Owner Password flow
        *OAuthFlowObject password;

        #! Configuration for the OAuth Client Credentials flow
        *OAuthFlowObject clientCredentials;

        #! Configuration for the OAuth Authorization Code flow
        *OAuthFlowObject authorizationCode;
    }

    #! Constructor
    /**
        @param oh deserialized hash from the source schema

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
    */
    public constructor(hash<auto> oh) : ObjectBase(oh) {
        string obj_type = "OAuth Flows";

        *hash<auto> implicitObj;
        if (optional_field(obj_type, oh, "implicit", NT_HASH, \implicitObj)) {
            implicit = new OAuthFlowObject(implicitObj, "implicit");
        }

        *hash<auto> passwordObj;
        if (optional_field(obj_type, oh, "password", NT_HASH, \passwordObj)) {
            password = new OAuthFlowObject(passwordObj, "password");
        }

        *hash<auto> clientCredentialsObj;
        if (optional_field(obj_type, oh, "clientCredentials", NT_HASH, \clientCredentialsObj)) {
            clientCredentials = new OAuthFlowObject(clientCredentialsObj, "clientCredentials");
        }

        *hash<auto> authorizationCodeObj;
        if (optional_field(obj_type, oh, "authorizationCode", NT_HASH, \authorizationCodeObj)) {
            authorizationCode = new OAuthFlowObject(authorizationCodeObj, "authorizationCode");
        }
    }
}

#! Describes a security scheme that can be used by API operations
public class SecuritySchemeObject inherits ObjectBase {
    public {
        #! Required. The type of the security scheme
        /** Valid values are \c "apiKey", \c "http", \c "oauth2", or \c "openIdConnect" */
        string type;

        #! A short description for security scheme
        *string desc;

        #! The name of the header, query, or cookie parameter to be used
        /** Required when type is \c "apiKey" */
        *string name;

        #! The location of the API key
        /** Valid values are \c "query", \c "header", or \c "cookie".
            Required when type is \c "apiKey" */
        *string inLoc;

        #! The name of the HTTP Authorization scheme
        /** Required when type is \c "http".
            Values should be registered in the IANA Authentication Scheme registry */
        *string scheme;

        #! A hint to the client to identify how the bearer token is formatted
        /** Used when type is \c "http" and scheme is \c "bearer" */
        *string bearerFormat;

        #! The OAuth Flows configuration
        /** Required when type is \c "oauth2" */
        *OAuthFlowsObject flows;

        #! OpenID Connect URL to discover OAuth2 configuration values
        /** Required when type is \c "openIdConnect" */
        *string openIdConnectUrl;
    }

    #! Constructor
    /**
        @param oh deserialized hash from the source schema description describing a security scheme

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws INVALID-APIKEY-LOCATION invalid 'in' (location) value
        @throws INVALID-SCHEME-TYPE invalid security scheme type
        @throws REQUIRED-FIELD-MISSING required field is missing
    */
    public constructor(hash<auto> oh) : ObjectBase(oh) {
        string obj_type = "Security Scheme";
        required_field(obj_type, oh, "type", NT_STRING, \type);

        switch (type) {
            case "apiKey": {
                required_field(obj_type, oh, "name", NT_STRING, \name);
                required_field(obj_type, oh, "in", NT_STRING, \inLoc);
                if (inLoc != "query" && inLoc != "header" && inLoc != "cookie") {
                    throw "INVALID-APIKEY-LOCATION", sprintf("Security Scheme Object: invalid 'in' (location) "
                        "value passed: %y; valid values are 'query', 'header', 'cookie'", inLoc);
                }
                break;
            }

            case "http": {
                required_field(obj_type, oh, "scheme", NT_STRING, \scheme);
                optional_field(obj_type, oh, "bearerFormat", NT_STRING, \bearerFormat);
                break;
            }

            case "oauth2": {
                hash<auto> flowsObj;
                required_field(obj_type, oh, "flows", NT_HASH, \flowsObj);
                flows = new OAuthFlowsObject(flowsObj);
                break;
            }

            case "openIdConnect": {
                required_field(obj_type, oh, "openIdConnectUrl", NT_STRING, \openIdConnectUrl);
                break;
            }

            case "mutualTLS": {
                # OpenAPI 3.1+: Mutual TLS authentication
                # No additional required properties for mutualTLS
                break;
            }

            default:
                throw "INVALID-SCHEME-TYPE", sprintf("Security Scheme Object: invalid security scheme type "
                    "passed: %y; valid values are 'apiKey', 'http', 'oauth2', 'openIdConnect', 'mutualTLS'", type);
        }

        optional_field(obj_type, oh, "description", (NT_STRING: True, NT_NOTHING: True), \desc);
    }
}

#! Lists the available scopes for an OAuth2 security scheme.
public class ScopesObject inherits ObjectBase {
    public {
        #! Maps between a name of a scope to a short description of it (as the value of the property).
        /**
            Hash of string values.
         */
        hash<string, string> fields;
    }

    #! Constructor.
    /**
        @param oh deserialized hash from the source schema description describing the available scopes for an OAuth2
        security scheme

        @throws INVALID-FIELD-TYPE field has invalid type
     */
    public constructor(hash<auto> oh) : ObjectBase(oh) {
        foreach hash item in (oh.pairIterator()) {
            if (item.key !~ /^x-/) { # if not vendor extension
                if (item.value.typeCode() != NT_STRING) {
                    throw "INVALID-FIELD-TYPE",
                        sprintf("Scopes Object: %y field has invalid type %y, instead of 'string'",
                            item.key, item.value.type());
                }
                fields{item.key} = item.value;
            }
        }
    }
}
}

# private namespace for internal definitions
namespace Priv {
    # a set of string values
    const OpenApi3ListToStringSet = -1;
    # a set of any type that can be converted to a string
    const OpenApi3ListToAnySet = -2;
    const OpenApi3ListToHashOfStrings = -3;

    const TypeMap = (
        NT_INT: "int",
        NT_STRING: "string",
        NT_FLOAT: "float",
        NT_LIST: "list",
        NT_HASH: "hash",
        NT_NOTHING: "nothing",
        NT_BOOLEAN: "bool",
        OpenApi3ListToStringSet: "list<string>",
        OpenApi3ListToAnySet: "list<auto>",
    );

    #! Check and assign a required field.
    /**
        @param obj_type type of object (e.g. "External Documentation")
        @param oh Object hash
        @param name field name
        @param typeCode field typeCode
        @param target where to assign the field's value

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
    */
    sub required_field(string obj_type, hash<auto> oh, string name, int typeCode, reference<auto> target, *int opt_flags) {
        if (!oh.hasKey(name))
            throw "REQUIRED-FIELD-MISSING", sprintf("%s Object%s: %y field is missing; fields present: %y", obj_type,
                oh.name ? sprintf(" %y", oh.name) : "", name, keys oh);
        auto val = oh{name};
        check_type_code(obj_type, oh, name, val, typeCode, opt_flags);
        get_value(obj_type, name, typeCode, val, \target);
    }

    #! Check and assign a required field.
    /**
        @param obj_type type of object (e.g. "External Documentation")
        @param oh Object hash
        @param name field name
        @param typeCodes possible field typeCodes
        @param target where to assign the field's value

        @throws INVALID-FIELD-TYPE field has invalid type
        @throws REQUIRED-FIELD-MISSING required field is missing
    */
    sub required_field(string obj_type, hash<auto> oh, string name, hash<string, bool> typeCodes, reference<auto> target) {
        if (!oh.hasKey(name))
            throw "REQUIRED-FIELD-MISSING", sprintf("%s Object%s: %y field is missing; fields present: %y", obj_type,
                oh.name ? sprintf(" %y", oh.name) : "", name, keys oh);
        auto val = oh{name};

        if (!typeCodes{val.typeCode()})
            throw "INVALID-FIELD-TYPE", sprintf("%s Object%s: %y field has invalid type %y (val: %y)", obj_type,
                oh.name ? sprintf(" %y", oh.name) : "", name, val.type(), val);
        get_value(obj_type, name, val.typeCode(), val, \target);
    }

    #! Check and assign a field.
    /**
        @param obj_type type of object (e.g. "External Documentation" or "Parameter")
        @param oh Object hash
        @param name field name
        @param typeCode field typeCode
        @param target where to assign the field's value

        @return whether the field was assigned

        @throws INVALID-FIELD-TYPE field has invalid type
    */
    bool sub optional_field(string obj_type, *hash<auto> oh, string name, int typeCode, reference<auto> target,
            *int opt_flags) {
        if (!oh || !oh.hasKey(name))
            return False;
        auto val = oh{name};
        if (check_type_code(obj_type, oh, name, val, typeCode, opt_flags)) {
            return False;
        }
        get_value(obj_type, name, typeCode, val, \target);
        return True;
    }

    #! Check and assign a field.
    /**
        @param obj_type type of object (e.g. "External Documentation" or "Parameter")
        @param oh Object hash
        @param name field name
        @param typeCodes possible field typeCodes
        @param target where to assign the field's value

        @return whether the field was assigned

        @throws INVALID-FIELD-TYPE field has invalid type
    */
    bool sub optional_field(string obj_type, *hash<auto> oh, string name, hash<string, bool> typeCodes,
            reference<auto> target) {
        if (!oh || !oh.hasKey(name))
            return False;
        auto val = oh{name};
        if (!typeCodes{val.typeCode()})
            throw "INVALID-FIELD-TYPE", sprintf("%s Object%s: %y field has invalid type %y (val: %y)", obj_type,
                oh.name ? sprintf(" %y", oh.name) : "", name, val.type(), val);
        get_value(obj_type, name, val.typeCode(), val, \target);
        return True;
    }

    #! verifies the type of a field
    *bool sub check_type_code(string obj_type, hash<auto> oh, string name, auto val, int typeCode, *int opt_flags) {
        int vtc = val.typeCode();
        if ((typeCode == OpenApi3ListToStringSet || typeCode == OpenApi3ListToAnySet
            || typeCode == OpenApi3ListToHashOfStrings) && vtc == NT_LIST)
            return;
        if (vtc != typeCode) {
            throw "INVALID-FIELD-TYPE", sprintf("%s Object%s: %y field has invalid type %y (val: %y); expecting %y",
                obj_type, oh.name ? sprintf(" %y", oh.name) : "", name, val.type(), val, TypeMap{typeCode});
        }
    }

    #! assigns a value to a field
    sub get_value(string obj_type, string name, int typeCode, auto val, reference<auto> target) {
        if (typeCode == OpenApi3ListToStringSet) {
            foreach auto v in (val) {
                if (v.typeCode() != NT_STRING)
                    throw "INVALID-FIELD-TYPE", sprintf("%s Object: %y element %d/%d in list value has type %y "
                        "(val: %y); expecting \"string\"", obj_type, name, $# + 1, val.size(), v.type(), v);
                target{v} = True;
            }
        } else if (typeCode == OpenApi3ListToAnySet) {
            foreach auto v in (val) {
                if (!v.strp())
                    throw "INVALID-FIELD-TYPE", sprintf("%s Object: %y element %d/%d in list value has type %y which "
                        "cannot be converted to a string; the OpenApi3 module only supports types that can be "
                        "converted to a string for this field", obj_type, name, $# + 1, val.size(), v.type());
                target{v} = True;
            }
        } else if (typeCode == OpenApi3ListToHashOfStrings) {
            foreach auto v in (val) {
                int pos = $# + 1;
                if (v.typeCode() != NT_HASH)
                    throw "INVALID-FIELD-TYPE", sprintf("%s Object: %y element %d/%d value has type %y; expecting "
                        "\"hash\"", obj_type, name, pos, val.size(), v.type());
                if (v.size() > 1)
                    throw "INVALID-FIELD-TYPE", sprintf("%s Object: %y element %d/%d value has a hash with more than "
                        "one key: %y; expecting a hash with a single key", obj_type, name, pos, val.size(), v);
                string key = v.firstKey();
                if (target.hasKey(key))
                    throw "INVALID-FIELD-TYPE", sprintf("%s Object: %y element %d/%d has duplicate key %y", obj_type,
                        name, pos, val.size(), key);
                foreach auto fv in (v.firstValue()) {
                    if (fv.typeCode() != NT_STRING)
                        throw "INVALID-FIELD-TYPE", sprintf("%s Object: %y element %d/%d in %y list value has "
                            "type %y in position %d/%d; expecting \"string\"", obj_type, name, pos, val.size(), key,
                            fv.type(), $# + 1, fv.lsize());
                }
                target += v;
            }
        } else
            target = val;
    }

    #! returns the Qore type for the given schema type
    string sub get_qore_type(string name, string type, *string format, *SchemaObject items) {
        switch (type) {
            case "array": return sprintf("list<%s>", get_qore_type(items.name, items.type, items.format, items.items));
            case "integer": {
                switch (format) {
                    case "unix-time":
                        return "date";
                }
                return "int";
            }
            case "boolean": return "bool";
            case "number": return format && ValidNumberFormatsHash{format} ? "float" : "number";
            case "string": {
                switch (format) {
                    case "byte":
                    case "binary":
                        return "binary";
                    case "date":
                    case "date-time":
                        return "date";
                }
                return "string";
            }
            case "null": return "nothing";
            case "object": return sprintf("hash<%s>", name);
        }
        return sprintf("unknown<%s = %s>", name, type);
    }
}
# End of namespace Priv

# ============================================================================
# OpenAPI3 Schema Generator - Generate OpenAPI3 schemas from @SCHEMA comments
# ============================================================================

#! Reopening public namespace for schema generator classes
public namespace OpenApi3 {

#! Field information for nested types
public hashdecl FieldInfo {
    #! Field name
    string name;
    #! Type string
    string type_str;
    #! Description
    string description;
    #! Nesting depth
    int depth;
}

#! Parameter information
public hashdecl ParamInfo {
    #! Parameter name
    string name;
    #! Type string (e.g., "string", "*int", "hash<TypeName>")
    string type_str;
    #! Description
    string description;
    #! Is required (no * prefix)
    bool required;
    #! Location: "path", "query", "body", "header"
    string location;
    #! Nesting depth for parameter fields
    int depth = 0;
}

#! Return type information
public hashdecl ReturnInfo {
    #! Type string
    string type_str;
    #! Description
    *string description;
    #! Nested fields (for complex types)
    *list<hash<FieldInfo>> fields;
}

#! Parsed \@SCHEMA block information
public hashdecl SchemaBlockInfo {
    #! Summary line
    *string summary;
    #! Description
    *string desc;
    #! Parameters list
    *list<hash<ParamInfo>> params;
    #! Return type information
    *hash<ReturnInfo> return_info;
    #! Error responses: HTTP code -> description
    *hash<string, string> errors;
    #! Required permissions
    *list<string> perms;
    #! Since version
    *string since;
    #! See also references
    *list<string> see;
}

#! REST method information parsed from source
public hashdecl RestMethodInfo {
    #! HTTP method: GET, POST, PUT, DELETE, PATCH
    string http_method;
    #! Optional action name (from action=xxx)
    *string action;
    #! URI path
    string path;
    #! Parsed schema block
    hash<SchemaBlockInfo> schema;
}

#! Tokenizes and parses \@SCHEMA comment blocks from Qore source files
public class OpenApi3SchemaTokenizer {
    public {
        const TokenSchema = "@SCHEMA";
        const TokenEndSchema = "@ENDSCHEMA";
        const TokenSummary = "@summary";
        const TokenDesc = "@desc";
        const TokenParams = "@params";
        const TokenReturn = "@return";
        const TokenError = "@error";
        const TokenPerms = "@perms";
        const TokenSince = "@since";
        const TokenSee = "@see";

        #! Pattern to match \@REST method declarations with optional path
        const RestMethodPattern = "@REST\\s+(GET|POST|PUT|DELETE|PATCH|OPTIONS|HEAD)\\s*(/\\S+)?";
        #! Pattern to match action= declarations
        const ActionPattern = "action=([a-zA-Z_][a-zA-Z0-9_]*)";
    }

    #! Parse a \@SCHEMA block from comment text
    /** @param text the text between \@SCHEMA and \@ENDSCHEMA
        @return parsed schema block information
    */
    static hash<SchemaBlockInfo> parseSchemaBlock(string text) {
        hash<SchemaBlockInfo> rv = <SchemaBlockInfo>{};
        string state = "";
        *list<hash<FieldInfo>> current_fields;
        int base_depth = 0;
        int params_base_depth = 0;

        # Normalize line endings and split
        text =~ s/\r\n/\n/g;
        list<string> lines = text.split("\n");

        foreach string line in (lines) {
            # Remove leading/trailing whitespace but track indentation
            string trimmed = trim(line);
            if (!trimmed) {
                continue;
            }

            # Calculate depth based on indentation (2 spaces = 1 level)
            int leading_spaces = line.length() - ltrim(line).length();
            int depth = leading_spaces / 2;

            # Check for annotation tokens
            if (trimmed =~ /^@summary\s+/) {
                string val = regex_subst(trimmed, "^@summary\\s+", "");
                rv.summary = val;
                state = "summary";
                continue;
            }
            if (trimmed =~ /^@desc\s+/) {
                string val = regex_subst(trimmed, "^@desc\\s+", "");
                rv.desc = val;
                state = "desc";
                continue;
            }
            if (trimmed =~ /^@params/) {
                state = "params";
                rv.params = ();
                params_base_depth = depth;
                continue;
            }
            if (trimmed =~ /^@return\s+/) {
                string val = regex_subst(trimmed, "^@return\\s+", "");
                rv.return_info = parseReturnLine(val);
                state = "return";
                current_fields = ();
                base_depth = depth;
                continue;
            }
            if (trimmed =~ /^@error\s+/) {
                string val = regex_subst(trimmed, "^@error\\s+", "");
                if (!rv.errors) {
                    rv.errors = {};
                }
                # Parse error code and description: (404): description (flexible whitespace)
                *list<string> parts = (val =~ x/\(\s*([0-9]+)\s*\)\s*:\s*(.*)$/);
                if (parts && parts.size() >= 2) {
                    rv.errors{parts[0]} = parts[1];
                }
                continue;
            }
            if (trimmed =~ /^@perms\s+/) {
                string val = regex_subst(trimmed, "^@perms\\s+", "");
                rv.perms = map trim($1), val.split(",");
                continue;
            }
            if (trimmed =~ /^@since\s+/) {
                string val = regex_subst(trimmed, "^@since\\s+", "");
                rv.since = val;
                continue;
            }
            if (trimmed =~ /^@see/) {
                state = "see";
                rv.see = ();
                continue;
            }

            # Process content based on current state
            switch (state) {
                case "desc":
                    # Continue description with backslash continuation character
                    if (rv.desc =~ /\\$/) {
                        rv.desc = rtrim(rv.desc.substr(0, rv.desc.length() - 1))
                            + " " + trimmed;
                    }
                    break;

                case "params":
                    # Parse parameter line: - name (type): description
                    if (trimmed =~ /^-\s+/) {
                        *hash<ParamInfo> param = parseParamLine(trimmed, depth - params_base_depth);
                        if (param) {
                            rv.params += param;
                        }
                    } else if (rv.params) {
                        # Continue description with backslash continuation
                        int last_idx = rv.params.size() - 1;
                        if (rv.params[last_idx].description =~ /\\$/) {
                            rv.params[last_idx].description =
                                rtrim(rv.params[last_idx].description.substr(0,
                                    rv.params[last_idx].description.length() - 1))
                                + " " + trimmed;
                        }
                    }
                    break;

                case "return":
                    # Parse nested field: - name (type): description
                    if (trimmed =~ /^-\s+/) {
                        *hash<FieldInfo> field = parseFieldLine(trimmed, depth - base_depth);
                        if (field) {
                            current_fields += field;
                        }
                    } else if (current_fields) {
                        # Continue description with backslash continuation
                        int last_idx = current_fields.size() - 1;
                        if (current_fields[last_idx].description =~ /\\$/) {
                            current_fields[last_idx].description =
                                rtrim(current_fields[last_idx].description.substr(0,
                                    current_fields[last_idx].description.length() - 1))
                                + " " + trimmed;
                        }
                    }
                    break;

                case "see":
                    if (trimmed =~ /^-\s+/) {
                        string ref = regex_subst(trimmed, "^-\\s+", "");
                        rv.see += ref;
                    }
                    break;
            }
        }

        if (current_fields) {
            rv.return_info.fields = current_fields;
        }

        return rv;
    }

    #! Parse a parameter line
    static *hash<ParamInfo> parseParamLine(string line, int depth) {
        # Pattern: - [Q ]name (type): description
        # Q prefix indicates query parameter
        *list<auto> parts = (line =~ x/^-\s+(Q\s+)?([a-zA-Z_][a-zA-Z0-9_-]*)\s+\(([^)]+)\):\s*(.*)$/);
        if (!parts || parts.size() < 4) {
            return;
        }
        # parts[0] is the optional Q prefix, parts[1] is name, parts[2] is type, parts[3] is description
        string location = exists parts[0] ? "query" : "body";
        string name = parts[1].toString();
        string type_str = parts[2].toString();
        string description = parts[3].toString();

        bool required = type_str[0] != "*";

        return <ParamInfo>{
            "name": name,
            "type_str": type_str,
            "description": description,
            "required": required,
            "location": location,
            "depth": depth,
        };
    }

    #! Parse a return line
    static hash<ReturnInfo> parseReturnLine(string line) {
        # Pattern: (type): description
        *list<string> parts = (line =~ x/^\(([^)]+)\):\s*(.*)$/);
        if (!parts || parts.size() < 1) {
            return <ReturnInfo>{
                "type_str": "any",
            };
        }
        return <ReturnInfo>{
            "type_str": parts[0],
            "description": parts.size() >= 2 ? parts[1] : NOTHING,
        };
    }

    #! Parse a field line
    static *hash<FieldInfo> parseFieldLine(string line, int depth) {
        # Pattern: - name (type): description
        *list<string> parts = (line =~ x/^-\s+([a-zA-Z_][a-zA-Z0-9_-]*)\s+\(([^)]+)\):\s*(.*)$/);
        if (!parts || parts.size() < 3) {
            return;
        }
        return <FieldInfo>{
            "name": parts[0],
            "type_str": parts[1],
            "description": parts[2],
            "depth": depth,
        };
    }

    #! Parse all \@SCHEMA blocks from a source file
    /** @param filepath path to the Qore source file
        @return list of REST method info with parsed schemas
    */
    static list<hash<RestMethodInfo>> parseSourceFile(string filepath) {
        string content = File::readTextFile(filepath);
        return parseSourceContent(content);
    }

    #! Extract all \@SCHEMA blocks from source content
    static list<hash<RestMethodInfo>> parseSourceContent(string content) {
        list<hash<RestMethodInfo>> rv = ();

        # Find all /** ... */ comment blocks containing @REST
        *list<auto> matches = (content =~ x/\/\*\*\s*(@REST\s+[A-Z]+[^*]*?@SCHEMA.*?@ENDSCHEMA[^*]*?)\*\//gs);

        foreach auto match in (matches) {
            string block = match;

            # Extract HTTP method and optional path (path may appear before or after action=xxx)
            *list<string> method_match = (block =~ x/@REST\s+(GET|POST|PUT|DELETE|PATCH|OPTIONS|HEAD)\s+(?:action=\S+\s+)?(\/\S+)/i);
            if (!method_match) {
                # Try without path
                method_match = (block =~ x/@REST\s+(GET|POST|PUT|DELETE|PATCH|OPTIONS|HEAD)/i);
            }
            if (!method_match) {
                continue;
            }
            string http_method = method_match[0].upr();
            string path = method_match[1] ?? "";

            # Extract action if present
            *string action;
            *list<string> action_match = (block =~ x/action=([a-zA-Z_][a-zA-Z0-9_]*)/);
            if (action_match) {
                action = action_match[0];
            }

            # Extract @SCHEMA block
            *list<string> schema_match = (block =~ x/@SCHEMA(.*)@ENDSCHEMA/s);
            if (!schema_match) {
                continue;
            }
            string schema_text = schema_match[0];

            # Parse the schema block
            hash<SchemaBlockInfo> schema = parseSchemaBlock(schema_text);

            rv += <RestMethodInfo>{
                "http_method": http_method,
                "action": action,
                "path": path,
                "schema": schema,
            };
        }

        return rv;
    }
}

#! Maps Qore types to OpenAPI3 types
public class OpenApi3TypeMapper {
    public {
        #! Map of Qore types to OpenAPI types
        const TypeMap = {
            "int": {"type": "integer", "format": "int64"},
            "softint": {"type": "integer", "format": "int64"},
            "float": {"type": "number", "format": "double"},
            "number": {"type": "number"},
            "string": {"type": "string"},
            "softstring": {"type": "string"},
            "bool": {"type": "boolean"},
            "softbool": {"type": "boolean"},
            "date": {"type": "string", "format": "date-time"},
            "softdate": {"type": "string", "format": "date-time"},
            "binary": {"type": "string", "format": "binary"},
            "any": {},
            "auto": {},
            "nothing": {"type": "null"},
        };
    }

    #! Map a Qore type string to OpenAPI type info
    /** @param qore_type Qore type string (e.g., "string", "*int", "hash<TypeName>", "list<string>")
        @return hash with OpenAPI type information
    */
    static hash<auto> mapType(string qore_type) {
        # Handle empty string
        if (!qore_type.val()) {
            return {"type": "string", "description": "Unknown type: empty"};
        }

        # Check for nullable/optional type (leading *)
        bool nullable = qore_type[0] == "*";
        if (nullable) {
            qore_type = qore_type.substr(1);
        }

        # Check for list/array type
        *list<string> list_match = (qore_type =~ x/^list<(.+)>$/);
        if (list_match) {
            hash<auto> rv = {
                "type": "array",
                "items": mapType(list_match[0]),
                "nullable": nullable,
            };
            if (!nullable) {
                delete rv.nullable;
            }
            return rv;
        }
        # Check for generic hash type BEFORE named type to handle hash<auto>
        if (qore_type == "hash" || qore_type == "hash<auto>") {
            hash<auto> rv = {
                "type": "object",
                "additionalProperties": True,
                "nullable": nullable,
            };
            if (!nullable) {
                delete rv.nullable;
            }
            return rv;
        }
        # Check for UndefinedHash BEFORE named type checks (all forms)
        if (qore_type == "UndefinedHash" || qore_type =~ /^hash[< ]UndefinedHash>?$/) {
            hash<auto> rv = {
                "type": "object",
                "additionalProperties": True,
                "nullable": nullable,
            };
            if (!nullable) {
                delete rv.nullable;
            }
            return rv;
        }
        # Check for hash type with named type (hash<TypeName> or hash<Namespace::TypeName>)
        *list<string> hash_match = (qore_type =~ x/^hash<([A-Za-z_][\w]*(?:::[A-Za-z_][\w]*)*)>$/);
        if (hash_match) {
            # Use last component of qualified name for schema reference
            list<string> name_parts = hash_match[0].split("::");
            string schema_name = name_parts[name_parts.size() - 1];
            hash<auto> rv = {
                "\$ref": sprintf("#/components/schemas/%s", schema_name),
                "nullable": nullable,
            };
            if (!nullable) {
                delete rv.nullable;
            }
            return rv;
        }
        # Check for hash type with space-separated named type (hash TypeName)
        *list<string> hash_space_match = (qore_type =~ x/^hash\s+([A-Za-z_][\w]*(?:::[A-Za-z_][\w]*)*)$/);
        if (hash_space_match) {
            list<string> name_parts = hash_space_match[0].split("::");
            string schema_name = name_parts[name_parts.size() - 1];
            hash<auto> rv = {
                "\$ref": sprintf("#/components/schemas/%s", schema_name),
                "nullable": nullable,
            };
            if (!nullable) {
                delete rv.nullable;
            }
            return rv;
        }
        # Standard type mapping
        if (TypeMap.hasKey(qore_type)) {
            *hash<auto> base = TypeMap{qore_type};
            if (nullable) {
                return base + {"nullable": True};
            }
            return base ?? {};
        }
        # Unknown type - check if it's a named type reference
        if (qore_type =~ /^[A-Z]/) {
            hash<auto> rv = {
                "\$ref": sprintf("#/components/schemas/%s", qore_type),
                "nullable": nullable,
            };
            if (!nullable) {
                delete rv.nullable;
            }
            return rv;
        }
        # Default to string for unknown types
        return {"type": "string", "description": sprintf("Unknown type: %s", qore_type)};
    }

    #! Check if a type string is nullable
    static bool isNullable(string qore_type) {
        return qore_type.val() && qore_type[0] == "*";
    }

    #! Get the base type (without * prefix)
    static string getBaseType(string qore_type) {
        return qore_type.val() && qore_type[0] == "*" ? qore_type.substr(1) : qore_type;
    }

    #! Extract element type from list type
    static *string getElementType(string qore_type) {
        *list<string> match = (qore_type =~ x/^(?:\*)?list<(.+)>$/);
        return match ? match[0] : NOTHING;
    }

    #! Extract inner type from hash type (supports qualified names like Namespace::TypeName)
    static *string getHashType(string qore_type) {
        *list<string> match = (qore_type =~ x/^(?:\*)?hash<([A-Za-z_][\w]*(?:::[A-Za-z_][\w]*)*)>$/);
        if (match) {
            return match[0];
        }
        match = (qore_type =~ x/^(?:\*)?hash\s+([A-Za-z_][\w]*(?:::[A-Za-z_][\w]*)*)$/);
        return match ? match[0] : NOTHING;
    }
}

#! Generates OpenAPI3 schemas from parsed REST API documentation
public class OpenApi3SchemaGenerator {
    private {
        #! API metadata
        hash<auto> api_info;
        #! Collected paths: path -> method -> operation
        hash<string, hash<string, hash<auto>>> paths;
        #! Component schemas: name -> schema
        hash<string, hash<auto>> schemas;
        #! Collected security schemes
        hash<string, hash<auto>> security_schemes;
    }

    #! Create a generator with API metadata
    /** @param info API metadata with keys:
        - title (string): API title
        - version (string): API version
        - description (*string): API description
        - servers (*list&lt;hash&gt;): Server definitions
    */
    constructor(hash<auto> info) {
        api_info = info;
        paths = {};
        schemas = {};
        security_schemes = {};
    }

    #! Add a REST method to the schema
    /** @param path URI path (e.g., "/users/{id}")
        @param method_info parsed REST method info
    */
    addMethod(string path, hash<RestMethodInfo> method_info) {
        # For actions, append as sub-path (actions are served both as
        # ?action=xxx and /xxx in the REST framework)
        if (method_info.action) {
            if (path !~ /\/$/) {
                path += "/";
            }
            path += method_info.action;
        }

        string http_method = method_info.http_method.lwr();

        # Build operation object
        hash<auto!> operation = {
            "summary": method_info.schema.summary ?? "",
            "description": method_info.schema.desc ?? "",
            "operationId": generateOperationId(path, http_method, method_info.action),
            "tags": (getTagFromPath(path),),
        };

        # Add parameters
        *list<hash<auto>> params = generateParameters(path, method_info);
        if (params) {
            operation.parameters = params;
        }

        # Add request body for non-GET methods
        if (http_method != "get" && method_info.schema.params) {
            # Auto-register component schemas from body params with named hash types
            autoRegisterParamSchemas(method_info.schema.params);
            *hash<auto> request_body = generateRequestBody(method_info);
            if (request_body) {
                operation.requestBody = request_body;
            }
        }

        # Add responses
        operation.responses = generateResponses(method_info);

        # Add to paths
        if (!paths{path}) {
            paths{path} = {};
        }
        paths{path}{http_method} = operation;
    }

    #! Add multiple methods for a path
    addMethods(string base_path, list<hash<RestMethodInfo>> methods) {
        foreach hash<RestMethodInfo> method in (methods) {
            string path = method.path.val() ? method.path : base_path;
            # action sub-path is handled by addMethod()
            addMethod(path, method);
        }
    }

    #! Register a schema type
    registerSchema(string name, hash<auto> schema) {
        schemas{name} = schema;
    }

    #! Add a security scheme
    addSecurityScheme(string name, hash<auto> scheme) {
        security_schemes{name} = scheme;
    }

    #! Generate the complete OpenAPI3 specification as a hash
    hash<auto> generate() {
        hash<auto> spec = {
            "openapi": "3.0.3",
            "info": {
                "title": api_info.title ?? "API",
                "version": api_info.version ?? "1.0.0",
            },
        };

        if (api_info.description) {
            spec.info.description = api_info.description;
        }
        if (api_info.contact) {
            spec.info.contact = api_info.contact;
        }

        if (api_info.servers) {
            spec.servers = api_info.servers;
        }

        # Add tags
        hash<string, bool> tag_set;
        foreach hash<auto> path_ops in (paths.iterator()) {
            foreach hash<auto> op in (path_ops.iterator()) {
                foreach string tag in (op.tags) {
                    tag_set{tag} = True;
                }
            }
        }
        list<hash<auto>> tags = ();
        foreach string tag in (sort(keys tag_set)) {
            tags += {"name": tag, "description": sprintf("%s endpoints", tag)};
        }
        spec.tags = tags;

        # Add paths
        spec.paths = paths;

        # Add components
        hash<auto> components = {};
        if (schemas) {
            components.schemas = schemas;
        }
        if (security_schemes) {
            components.securitySchemes = security_schemes;
        }
        if (components) {
            spec.components = components;
        }

        return spec;
    }

    #! Generate YAML output
    string toYaml() {
%ifdef NoYaml
        throw "YAML-NOT-AVAILABLE", "YAML module is not available";
%else
        return make_yaml(generate(), BlockStyle);
%endif
    }

    #! Generate JSON output
    string toJson() {
%ifdef NoJson
        throw "JSON-NOT-AVAILABLE", "JSON module is not available";
%else
        return make_json(generate(), JGF_ADD_FORMATTING);
%endif
    }

    #! Generate operation ID
    private string generateOperationId(string path, string method, *string action) {
        # action is already part of the path as a sub-path segment
        string id = path;
        id =~ s/[{}\/]/_/g;
        id =~ s/__+/_/g;  # Collapse multiple underscores
        id =~ s/^_//;
        id =~ s/_$//;
        id = method + "_" + id;
        return id;
    }

    #! Get tag from path
    static string getTagFromPath(string path) {
        # Get first path segment after leading /
        *list<string> parts = path.split("/");
        if (parts.size() >= 2 && parts[1]) {
            return parts[1];
        }
        return "default";
    }

    #! Generate parameters from method info
    private *list<hash<auto>> generateParameters(string path, hash<RestMethodInfo> method_info) {
        list<hash<auto>> params = ();

        # Extract path parameters
        *list<string> path_params = (path =~ x/\{([^}]+)\}/g);
        foreach string param_name in (path_params) {
            params += {
                "name": param_name,
                "in": "path",
                "required": True,
                "schema": {"type": "string"},
                "description": sprintf("Path parameter: %s", param_name),
            };
        }

        # Build a set of path parameter names for deduplication
        hash<string, bool> path_param_set;
        foreach string pn in (path_params) {
            path_param_set{pn} = True;
        }

        # Add query parameters for GET methods
        if (method_info.http_method == "GET" && method_info.schema.params) {
            foreach hash<ParamInfo> param in (method_info.schema.params) {
                if (param.depth) {
                    continue;
                }
                # Skip params that are already defined as path parameters; use the @SCHEMA
                # description for the path param instead of the generic one
                if (path_param_set{param.name}) {
                    # Update the path parameter entry with the richer description from @SCHEMA
                    for (int i = 0; i < params.size(); ++i) {
                        if (params[i].name == param.name && params[i]."in" == "path") {
                            params[i].description = param.description;
                            params[i].schema = OpenApi3TypeMapper::mapType(param.type_str);
                            break;
                        }
                    }
                    continue;
                }
                params += {
                    "name": param.name,
                    "in": "query",
                    "required": param.required,
                    "schema": OpenApi3TypeMapper::mapType(param.type_str),
                    "description": param.description,
                };
            }
        }

        return params.size() ? params : NOTHING;
    }

    #! Builds a param tree based on nesting depth
    private static list<hash<auto>> buildParamTree(list<hash<ParamInfo>> params) {
        list<hash<auto>> roots = ();
        list<auto!> node_stack = ();
        list<int> depth_stack = ();

        foreach hash<ParamInfo> param in (params) {
            int depth = param.depth;
            list<hash<auto>> children = ();
            hash<auto> node = {
                "info": param,
                "children": children,
            };

            while (depth_stack && depth <= depth_stack.last()) {
                pop depth_stack;
                pop node_stack;
            }

            if (node_stack) {
                reference<hash<auto>> parent = node_stack.last();
                parent.children += node;
                node_stack += \parent.children[parent.children.size() - 1];
            } else {
                roots += node;
                node_stack += \roots[roots.size() - 1];
            }

            depth_stack += depth;
        }

        return roots;
    }

    #! Applies nested child schema to a base schema
    private static hash<auto> applyChildSchema(hash<auto> schema, list<hash<auto>> children) {
        hash<auto> child_schema = buildObjectSchema(children);
        if (schema.type == "array") {
            if (schema.items && schema.items."\$ref") {
                schema.items = {"allOf": (schema.items, child_schema)};
            } else {
                schema.items = child_schema;
            }
            return schema;
        }
        if (schema."\$ref") {
            hash<auto> rv = {
                "allOf": (schema, child_schema),
            };
            if (schema.nullable) {
                rv.nullable = schema.nullable;
            }
            return rv;
        }

        # build a new hash to avoid type narrowing from mapType() return values
        hash<auto> rv = {
            "type": "object",
            "properties": child_schema.properties,
        };
        if (schema.description) {
            rv.description = schema.description;
        }
        if (schema.nullable) {
            rv.nullable = schema.nullable;
        }
        if (child_schema.required) {
            rv.required = child_schema.required;
        }
        return rv;
    }

    #! Builds an object schema from a list of param nodes
    private static hash<auto> buildObjectSchema(list<hash<auto>> nodes) {
        hash<auto> properties = {};
        list<string> required_props = ();

        foreach hash<auto> node in (nodes) {
            hash<ParamInfo> param = node.info;
            hash<auto> schema = OpenApi3TypeMapper::mapType(param.type_str);
            schema.description = param.description;
            if (node.children && node.children.size()) {
                schema = applyChildSchema(schema, node.children);
            }
            properties{param.name} = schema;
            if (param.required) {
                required_props += param.name;
            }
        }

        hash<auto> obj = {
            "type": "object",
            "properties": properties,
        };
        if (required_props) {
            obj.required = required_props;
        }
        return obj;
    }

    #! Generate request body from method info
    private *hash<auto> generateRequestBody(hash<RestMethodInfo> method_info) {
        if (!method_info.schema.params) {
            return;
        }

        # Filter body parameters (not path or query)
        *list<hash<ParamInfo>> body_params = select method_info.schema.params, $1.location == "body";
        if (!body_params) {
            return;
        }

        # Build schema for request body with nested params
        hash<auto> body_schema = buildObjectSchema(buildParamTree(body_params));
        bool required_body = body_schema.required && body_schema.required.size() > 0;

        return {
            "required": required_body,
            "content": {
                "application/json": {"schema": body_schema},
                MimeTypeYamlApp: {"schema": body_schema},
            },
        };
    }

    #! Extract a schema name from a Qore type string
    /** @return the schema name, or NOTHING if the type is not a named hash reference */
    static *string extractSchemaName(string type_str) {
        # Remove leading * (nullable)
        if (type_str.val() && type_str[0] == "*") {
            type_str = type_str.substr(1);
        }

        # Direct named hash: hash<TypeName> or hash TypeName (exclude hash<auto>)
        *list<string> match = (type_str =~ x/^hash[< ]([A-Za-z_][\w]*(?:::[A-Za-z_][\w]*)*)>?$/);
        if (match && match[0] != "auto") {
            list<string> parts = match[0].split("::");
            return parts[parts.size() - 1];
        }

        # List of named hash: list<hash<TypeName>>, list<hash TypeName>, list<*hash<TypeName>>, etc.
        match = (type_str =~ x/^list<\*?hash[< ]([A-Za-z_][\w]*(?:::[A-Za-z_][\w]*)*)>?>$/);
        if (match && match[0] != "auto") {
            list<string> parts = match[0].split("::");
            return parts[parts.size() - 1];
        }

        return NOTHING;
    }

    #! Auto-register component schemas from return type field descriptions
    /** When a return type references a named hash (e.g., hash<OAuth2AppInfo>) and has field
        descriptions, this method builds the component schema from those fields and registers
        it so the \c $ref in the output resolves correctly.
    */
    private autoRegisterReturnSchemas(hash<ReturnInfo> return_info) {
        if (!return_info.fields) {
            return;
        }

        *string schema_name = extractSchemaName(return_info.type_str);
        if (schema_name) {
            registerSchemasFromFields(schema_name, return_info.fields, 0, return_info.description);
        }
    }

    #! Auto-register component schemas from request body parameters
    /** Scans body parameters for named hash types with child parameters and registers
        them as component schemas.
    */
    private autoRegisterParamSchemas(list<hash<ParamInfo>> params) {
        # Track current named type and its raw children
        *string current_schema_name;
        list<hash<ParamInfo>> current_raw_children = ();

        foreach hash<ParamInfo> param in (params) {
            if (param.depth == 0) {
                # Flush any pending child schema registration
                if (current_schema_name && current_raw_children) {
                    flushParamSchema(current_schema_name, current_raw_children);
                }
                current_schema_name = NOTHING;
                current_raw_children = ();

                # Check if this param references a named type
                current_schema_name = extractSchemaName(param.type_str);
            } else if (current_schema_name) {
                current_raw_children += param;
            }
        }

        # Flush any remaining child schema
        if (current_schema_name && current_raw_children) {
            flushParamSchema(current_schema_name, current_raw_children);
        }
    }

    #! Register a schema from raw child params, normalizing depths
    private flushParamSchema(string schema_name, list<hash<ParamInfo>> raw_children) {
        @assert(raw_children.size() > 0);
        # Find the minimum depth to use as the base for normalization
        int min_depth = raw_children[0].depth;
        foreach hash<ParamInfo> p in (raw_children) {
            if (p.depth < min_depth) {
                min_depth = p.depth;
            }
        }

        # Convert ParamInfo to FieldInfo with normalized depths (min_depth -> 0)
        list<hash<FieldInfo>> fields = map cast<hash<FieldInfo>>({
            "name": $1.name,
            "type_str": $1.type_str,
            "description": $1.description,
            "depth": $1.depth - min_depth,
        }), raw_children;

        registerSchemasFromFields(schema_name, fields, 0);
    }

    #! Build and register a component schema from a flat field list at the given depth
    /** Recursively registers nested named types from deeper fields.

        @param schema_name the component schema name to register
        @param fields the flat list of fields with depth values
        @param depth the current depth level to process (0 = top-level fields)
        @param description optional schema description
    */
    private registerSchemasFromFields(string schema_name, list<hash<FieldInfo>> fields, int depth,
            *string description) {
        # Don't re-register if already registered
        if (schemas{schema_name}) {
            return;
        }

        hash<auto> properties = {};
        *string child_schema_name;
        list<hash<FieldInfo>> child_fields = ();

        foreach hash<FieldInfo> field in (fields) {
            if (field.depth == depth) {
                # Flush any pending child schema registration
                if (child_schema_name && child_fields) {
                    registerSchemasFromFields(child_schema_name, child_fields, depth + 1);
                }
                child_schema_name = NOTHING;
                child_fields = ();

                # Map this field's type and add to properties
                hash<auto> field_type = OpenApi3TypeMapper::mapType(field.type_str);
                field_type.description = field.description;
                properties{field.name} = field_type;

                # Track if this field references a named type for nested schema registration
                child_schema_name = extractSchemaName(field.type_str);
            } else if (field.depth > depth && child_schema_name) {
                child_fields += field;
            }
        }

        # Flush any remaining child schema
        if (child_schema_name && child_fields) {
            registerSchemasFromFields(child_schema_name, child_fields, depth + 1);
        }

        # Register the component schema
        if (properties) {
            hash<auto> schema = {
                "type": "object",
                "properties": properties,
            };
            if (description) {
                schema.description = description;
            }
            registerSchema(schema_name, schema);
        }
    }

    #! Generate responses from method info
    private hash<auto> generateResponses(hash<RestMethodInfo> method_info) {
        # Build success response
        hash<auto> success_response;
        string status_code;

        if (method_info.schema.return_info) {
            hash<auto> response_schema = OpenApi3TypeMapper::mapType(method_info.schema.return_info.type_str);

            # Auto-register component schemas from field descriptions so $ref entries resolve
            if (method_info.schema.return_info.fields) {
                autoRegisterReturnSchemas(method_info.schema.return_info);
            }

            success_response = {
                "description": "Successful response",
                "content": {
                    "application/json": {"schema": response_schema},
                    MimeTypeYamlApp: {"schema": response_schema},
                },
            };

            # Use 201 Created for POST with response body
            status_code = method_info.http_method.lwr() == "post" ? "201" : "200";
        } else {
            success_response = {"description": "Successful response"};

            # Use 204 No Content for DELETE without response body, 201 for POST
            switch (method_info.http_method.lwr()) {
                case "delete":
                    status_code = "204";
                    break;
                case "post":
                    status_code = "201";
                    break;
                default:
                    status_code = "200";
            }
        }

        hash<auto> responses = {status_code: success_response};

        # Error responses
        if (method_info.schema.errors) {
            foreach hash<auto> err in (method_info.schema.errors.pairIterator()) {
                responses{err.key} = {
                    "description": err.value,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "error": {"type": "string"},
                                    "message": {"type": "string"},
                                },
                            },
                        },
                    },
                };
            }
        }

        return responses;
    }

    #! Generate schema from source files
    /** @param files list of source file paths
        @param api_info API metadata
        @return generated OpenAPI3 spec hash
    */
    static hash<auto> fromSourceFiles(list<string> files, hash<auto> api_info) {
        OpenApi3SchemaGenerator gen(api_info);

        foreach string file in (files) {
            list<hash<RestMethodInfo>> methods = OpenApi3SchemaTokenizer::parseSourceFile(file);
            if (methods) {
                # Determine base path from file name
                string base_path = "/" + basename(file);
                base_path =~ s/\.[^.]+$//;
                gen.addMethods(base_path, methods);
            }
        }

        return gen.generate();
    }
}
}
