# minimum qore version
%requires qore >= 2.0

%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires OpenAiRestClient >= 1.2
%requires QoreLlmTypes

module DeepSeekRestClient {
    version = "1.2";
    desc = "user module for calling DeepSeek REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("deepseek", DeepSeekRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(new DeepSeekLlmProviderFactory());
    };
}

/** @mainpage DeepSeekRestClient Module

    @tableofcontents

    @section deepseekrestclientintro DeepSeekRestClient Introduction

    The %DeepSeekRestClient module provides an API for calling
    <a href="https://platform.deepseek.com">DeepSeek</a> REST API services.

    DeepSeek serves an OpenAI-compatible chat-completions endpoint, so the
    @ref DeepSeekRestClient::DeepSeekLlmProvider "DeepSeekLlmProvider"
    subclasses @ref OpenAiRestClient::OpenAiLlmProvider with the DeepSeek
    default URL and mode string.

    To use this module, use \c "%requires DeepSeekRestClient" in your code.

    All the public symbols in the module are defined in the
    DeepSeekRestClient namespace.

    The main classes are:
    - @ref DeepSeekRestClient::DeepSeekRestClient "DeepSeekRestClient": REST
      client API for communication with DeepSeek (sync)
    - @ref DeepSeekRestClient::DeepSeekRestClientIo "DeepSeekRestClientIo":
      REST client using multiplexed HTTP connections (async)
    - @ref DeepSeekRestClient::DeepSeekRestConnection "DeepSeekRestConnection":
      a REST connection object to DeepSeek
    - @ref DeepSeekRestClient::DeepSeekLlmProvider "DeepSeekLlmProvider":
      @ref QoreLlmUtils::AbstractLlmProvider "language model provider" for mode \c deepseek

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires DeepSeekRestClient

DeepSeekRestClient rest({"apikey": api_key});
hash<auto> ans = rest.post("/v1/chat/completions", {
    "model": "deepseek-v4-flash",
    "messages": (
        {"role": "user", "content": "Hello!"},
    ),
});
printf("%Y\n", ans.body);
    @endcode

    @par Reasoner Models

    DeepSeek's reasoner models (e.g. \c deepseek-v4-pro) emit a
    \c reasoning_content field alongside the regular \c content on the
    assistant message and on each streaming delta.  The OpenAI-compatible
    response shape preserves this field; downstream consumers can read it
    directly off the parsed response body or off the \c raw payload of
    @ref QoreLlmUtils::ChatStreamEvent.

    @section DeepSeekRestClientRelnotes Release Notes

    @subsection DeepSeekRestClientv1_2 DeepSeekRestClient v1.2
    - Preserve thinking controls and reasoning history across synchronous, streaming and tool turns.
    - Expose current model reasoning profiles and default to DeepSeek V4.1 Flash.
    - Support forced tools in non-thinking mode and strict tool schemas through the beta endpoint.
    - Adapt requested output schemas to JSON mode with schema instructions and validate strict output locally.
    - Preserve explicit user IDs for cache and scheduling isolation.

    @subsection DeepSeekRestClientv1_1 DeepSeekRestClient v1.1
    - Fixed automatic connection URLs, associated connections with the DeepSeek app, and enabled explicit JSON encoding.
    - Updated the default chat model and API/model selections; verified valid and invalid API-key pings.
    - Honored immediate versus deferred connection construction for the synchronous client.

    @subsection DeepSeekRestClientv1_0 DeepSeekRestClient v1.0
    - initial release
*/

%requires json

#! the DeepSeekRestClient namespace contains all the objects in the DeepSeekRestClient module
public namespace DeepSeekRestClient {
#! Common base class for DeepSeekRestClient functionality
public class DeepSeekRestClientBase {
    public {
        #! Default DeepSeek REST API URL
        const DefaultUrl = "https://api.deepseek.com";

        #! Default DeepSeek API version
        const DefaultApiVersion = "v1";

        #! Default DeepSeek chat model
        const DefaultChatModel = "deepseek-flash";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "data": "json",
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    #! Returns the ordered design-policy reasoning settings for current DeepSeek models
    /** @param model exact API model ID
        @return none/low/high/max for verified IDs, or NOTHING for unknown models
        @note none means thinking.type=disabled on Chat Completions, not reasoning_effort=none.
            Retired Flash IDs currently alias deepseek-flash (verified 2026-10-07).
        @par Example
        @code{.py}
list<string> efforts = DeepSeekRestClientBase::getModelReasoningEfforts("deepseek-flash");
        @endcode
    */
    public static *list<string> getModelReasoningEfforts(string model) {
        if (inlist(model, ("deepseek-flash", "deepseek-v4-pro", "deepseek-v4-flash",
                "deepseek-v4-flash-vision-exp"))) {
            return ("none", "low", "high", "max");
        }
        return NOTHING;
    }

    #! Returns options for the DeepSeekRestClient constructors
    /** Maps the \c apikey option to \c token for Bearer authentication
        @param opts caller-supplied options
        @return normalized options with JSON serialization
    */
    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;
        if (!rv.data || rv.data == "auto") {
            rv.data = "json";
        }
        if (opts.api) {
            rv.default_path = "/" + opts.api;
        }
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        # connection-level option for downstream LLM clients; not a REST client option
        remove rv{"chat-model"};
        return rv;
    }
}

#! REST client for DeepSeek REST API
/** You must use an API key in the \c apikey option to call DeepSeek APIs.

    The API key is sent as the \c Authorization: \c Bearer header.
*/
public class DeepSeekRestClient inherits RestClient::RestClient, DeepSeekRestClientBase {
    #! Creates the object with the given options
    /** @par Example:
        @code{.py}
DeepSeekRestClient rest(opts);
        @endcode

        @param opts valid options are all the options for the
        @ref RestClient::RestClient "RestClient" class; note that the URL
        is set by default if not provided (see @ref DefaultUrl)
        @param do_not_connect if \c False (the default), then a connection
        will be immediately established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor,
        unsupported data serialization, etc
        @throw SOCKET-CONNECT-ERROR the server cannot be reached when immediate connection is requested
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(DeepSeekRestClientBase::getOptions(opts), True) {
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(getString(opts, "api") ?? DefaultApiVersion);
        }
        if (!do_not_connect) {
            connect();
        }
    }
}

#! REST client for DeepSeek REST API using multiplexed HTTP connections
/** @see DeepSeekRestClient for more information
*/
public class DeepSeekRestClientIo inherits RestClientIo::RestClientIo, DeepSeekRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(DeepSeekRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for DeepSeek REST connections; returns @ref DeepSeekRestClient objects
/** Implements all options of \c RestClient::RestConnection "RestClientConnection"

    @see @ref DeepSeekRestClient::DeepSeekRestClient::constructor() for more
    information on the connection options
*/
public class DeepSeekRestConnection inherits RestClient::RestConnection {
    public {
        #! Default DeepSeek REST API URL
        const DefaultUrl = "deepseek://api.deepseek.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "DeepSeek REST Connection",
            "short_desc": "A connection to the DeepSeek REST API",
            "desc": "A connection to the [DeepSeek](https://platform.deepseek.com) REST API.\n\n"
                "Requires an API key for Bearer authentication.  Get your API key from the "
                "[DeepSeek Platform](https://platform.deepseek.com/api_keys).",
            "cls": Class::forName("DeepSeekRestConnection"),
            "auto_url": True,
            "schemes": {
                "deepseek": True,
            },
            "base_scheme_map": {
                "https": "deepseek",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "DeepSeek API key for authentication",
                    "type": "string",
                    "desc": "The DeepSeek API key used for Bearer authentication.\n\n"
                        "Get your API key from the "
                        "[DeepSeek Platform](https://platform.deepseek.com/api_keys).",
                    "sensitive": True,
                    "preselected": True,
                },
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "The API version to use",
                    "desc": "Select the stable API or the beta API for prefix completion and strict tools.",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "v1", "display_name": "Stable API"},
                        <AllowedValueInfo>{"value": "beta", "display_name": "Beta API"},
                    ),
                    "type": "string",
                    "default_value": DeepSeekRestClientBase::DefaultApiVersion,
                },
                "chat-model": <ConnectionOptionInfo>{
                    "display_name": "Chat Model",
                    "short_desc": "DeepSeek chat model name",
                    "desc": "Model ID for chat through this connection. Use the app's `List Models` "
                        "action to inspect available models. Custom model IDs are accepted.",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "deepseek-flash", "display_name": "DeepSeek V4.1 Flash"},
                        <AllowedValueInfo>{"value": "deepseek-v4-pro", "display_name": "DeepSeek V4 Pro"},
                    ),
                    "allowed_values_creatable": True,
                    "type": "string",
                    "default_value": DeepSeekRestClientBase::DefaultChatModel,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": DefaultPingPath,
                },
            },
            "required_options": "apikey",
        };

        #! Default DeepSeek ping method
        const DefaultPingMethod = "GET";

        #! Default DeepSeek ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default DeepSeek ping path (relative to /v1)
        const DefaultPingPath = "models";
    }

    #! Creates the DeepSeekRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for
        \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! Creates the DeepSeekRestConnection object from a configuration hash
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(DeepSeekRestConnection::getConfig(config), attr) {
    }

    #! Uses the canonical endpoint for automatic connections
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {"url": DefaultUrl};
    }

    #! Returns the associated application
    /** @return the DeepSeek application name */
    *string getAppName() {
        return "DeepSeek";
    }

    #! Returns \c "deepseek"
    string getType() {
        return "deepseek";
    }

    #! Returns @ref True as this connection returns a data provider
    bool hasDataProvider() {
        return True;
    }

    #! Returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the
        # DeepSeekDataProvider and creates the data provider dynamically
        load_module("DeepSeekDataProvider");
        return create_object("DeepSeekDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! Returns a sync REST client object
    private DeepSeekRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new DeepSeekRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable REST client object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new DeepSeekRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! Returns connection options with apikey mapped to token for Bearer auth
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return DeepSeekRestClientBase::getOptions(rv);
    }

    #! Sets update options code for auto_url connections
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != DeepSeekRestClientBase::DefaultUrl && url != DefaultUrl) {
                update.url = DefaultUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }
}

#! LLM provider for DeepSeek servers
/** DeepSeek serves an OpenAI-compatible chat-completions endpoint at
    \c /v1/chat/completions on \c https://api.deepseek.com, so this provider
    reuses @ref OpenAiRestClient::OpenAiLlmProvider for body construction,
    response parsing, and SSE streaming, with DeepSeek-specific thinking,
    reasoning replay, and strict-tool routing adaptations.

    @par Configuration

    - \c url (optional): override the default \c https://api.deepseek.com
    - \c api_key (required): DeepSeek API key
    - \c model (required): DeepSeek model name, e.g. \c "deepseek-flash" or
      \c "deepseek-v4-pro"

    @par Reasoning channel

    Native @c reasoning_content is preserved as tagged @c reasoning_blocks and
    replayed on every assistant turn when tools are used. It is never visible answer text.
    Thinking defaults to enabled; @c reasoning_effort=none disables it. Forced tool calls
    require thinking to be disabled. Strict function schemas use the beta endpoint.

    @note DeepSeek supports JSON object output, but not JSON-schema response formats.
        Schema requests use JSON mode with schema instructions; strict requests are validated
        locally and strict streams are buffered until validation succeeds. The factory does not
        advertise server JSON-schema enforcement.
        Automatic prefix caching needs no explicit cache key; @c user_id, when supplied,
        retains the provider's cache/scheduling isolation semantics.
*/
public class DeepSeekLlmProvider inherits OpenAiRestClient::OpenAiLlmProvider {
    public {
        #! Default DeepSeek REST API URL
        const DefaultUrl = "https://api.deepseek.com";
    }

    #! Returns the default DeepSeek chat model
    *string getDefaultModel() {
        return DeepSeekRestClientBase::DefaultChatModel;
    }

    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : OpenAiRestClient::OpenAiLlmProvider(DeepSeekRestClient::applyDeepSeekDefaults(config)) {
    }

    string getMode() {
        return "deepseek";
    }

    #! @copydoc QoreLlmUtils::AbstractLlmProvider::applyOpenAiRequestControls()
    applyOpenAiRequestControls(reference<hash<auto!>> body_options, hash<auto> request) {
        OpenAiRestClient::OpenAiLlmProvider::applyOpenAiRequestControls(\body_options, request);
        if (request.thinking.typeCode() == NT_HASH) {
            body_options.thinking = request.thinking;
        }
        if (request.user_id.typeCode() == NT_STRING) {
            body_options.user_id = request.user_id;
        }
        # DeepSeek uses automatic prefix caching; no prompt_cache_key is documented.
    }

    #! Keeps the native reasoning channel separate from visible response text
    private hash<QoreLlmUtils::ChatResponse> parseOpenAiChatResponse(hash<auto> response) {
        hash<QoreLlmUtils::ChatResponse> rv =
            OpenAiRestClient::OpenAiLlmProvider::parseOpenAiChatResponse(response);
        if (response.choices[0].message.reasoning_content.typeCode() == NT_STRING) {
            rv.reasoning_blocks = ({"type": "deepseek_reasoning",
                "text": response.choices[0].message.reasoning_content},);
        }
        return rv;
    }

    #! @copydoc QoreLlmUtils::AbstractLlmProvider::updateOpenAiStreamStateFromRaw()
    updateOpenAiStreamStateFromRaw(reference<hash<auto>> state, *hash<auto> raw) {
        OpenAiRestClient::OpenAiLlmProvider::updateOpenAiStreamStateFromRaw(\state, raw);
        if (raw.created.typeCode() == NT_INT) {
            state.created = raw.created;
        }
        if (raw.choices[0].delta.reasoning_content.typeCode() == NT_STRING) {
            if (!exists state.deepseek_reasoning) { state.deepseek_reasoning = ""; }
            state.deepseek_reasoning += raw.choices[0].delta.reasoning_content;
        }
        if (raw.choices[0].finish_reason.val() && exists state.deepseek_reasoning) {
            state.reasoning_blocks = ({"type": "deepseek_reasoning", "text": state.deepseek_reasoning},);
        }
    }

    #! Replays reasoning on every assistant turn, including tool-only turns
    private hash<auto> buildOpenAiChatBody(list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        hash<auto> body = OpenAiRestClient::OpenAiLlmProvider::buildOpenAiChatBody(messages, tools, opts);
        for (int i = 0; i < messages.size(); ++i) {
            if (messages[i].role == "assistant") {
                # Non-thinking turns have no reasoning; the next thinking turn
                # still requires the field when tools are present.
                body.messages[i].reasoning_content = "";
            }
            foreach auto block in (messages[i].reasoning_blocks ?? ()) {
                if (messages[i].role == "assistant" && block.type == "deepseek_reasoning"
                        && block.text.typeCode() == NT_STRING) {
                    body.messages[i].reasoning_content = (body.messages[i].reasoning_content ?? "") + block.text;
                }
            }
        }
        return body;
    }

    #! Maps the neutral off setting to DeepSeek's explicit thinking switch
    private hash<auto> finalizeOpenAiRequestBody(hash<auto> body,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        body = OpenAiRestClient::OpenAiLlmProvider::finalizeOpenAiRequestBody(body, opts);
        if (body.reasoning_effort == "none") {
            body.thinking = {"type": "disabled"};
            remove body.reasoning_effort;
        }
        if (body.reasoning_effort == "medium" || body.reasoning_effort == "xhigh") {
            body.reasoning_effort = "high";
        }
        if (body.tool_choice == "required" || body.tool_choice.typeCode() == NT_HASH) {
            body.thinking = {"type": "disabled"};
            remove body.reasoning_effort;
        }
        if (body.thinking.type != "disabled") {
            remove body.temperature;
            remove body.presence_penalty;
            remove body.frequency_penalty;
            if (exists body.top_p && body.top_p < 0.95) {
                body.top_p = 0.95;
            }
        } else {
            remove body.reasoning_effort;
            remove body.top_p;
        }
        return body;
    }

    #! Uses JSON mode with local validation when the caller requests strict schema output
    private hash<auto> prepareStrictRequest(hash<auto> body) {
        hash<auto> schema_context = OpenAiRestClient::OpenAiLlmProvider::prepareStrictRequest(body);
        body = schema_context.body;
        if (body.response_format.type == "json_schema") {
            hash<auto> schema = body.response_format.json_schema.schema;
            body.response_format = {"type": "json_object"};
            body.messages = ({"role": "system", "content":
                "Return a JSON object matching this JSON schema: " + make_json(schema)},) + body.messages;
            if (schema_context.response_schema) {
                # JSON mode does not enforce the schema. Buffer strict streams
                # and validate complete output before exposing it to the caller.
                schema_context.project = True;
                schema_context.validate = True;
            }
        }
        schema_context.body = body;
        return schema_context;
    }

    #! Strict tool schemas are supported only by DeepSeek's beta endpoint
    private hash<auto> prepareOpenAiWireRequest(hash<auto> body) {
        hash<auto> wire = OpenAiRestClient::OpenAiLlmProvider::prepareOpenAiWireRequest(body);
        foreach auto tool in (body.tools ?? ()) {
            if (tool.function.strict == True) {
                wire.path = "/beta/chat/completions";
                break;
            }
        }
        return wire;
    }

}

#! Namespace-local helper: returns config with the default DeepSeek URL applied
hash<QoreLlmUtils::LlmBackendConfig> sub applyDeepSeekDefaults(
        hash<QoreLlmUtils::LlmBackendConfig> config) {
    if (!config.url.val()) {
        config.url = DeepSeekLlmProvider::DefaultUrl;
    }
    return config;
}

#! Factory for @ref DeepSeekLlmProvider
public class DeepSeekLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "deepseek";
    }

    string getDisplayName() {
        return "DeepSeek chat completions";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new DeepSeekLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": False,
            "supports_multimodal": True,
        };
    }
}
}
