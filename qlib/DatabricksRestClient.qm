# minimum qore version
%requires qore >= 2.0

# assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) ConnectionProvider >= 1.4

module DatabricksRestClient {
    version = "1.0";
    desc = "User module for calling Databricks REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("databricks", DatabricksRestConnection::ConnectionScheme);
    };
}

/** @mainpage DatabricksRestClient Module

    @tableofcontents

    @section databricksrestclientintro DatabricksRestClient Introduction

    The %DatabricksRestClient module provides an API for calling Databricks REST API services.

    To use this module, use \c "%requires DatabricksRestClient" in your code.

    All the public symbols in the module are defined in the DatabricksRestClient namespace.

    The main classes are:
    - @ref DatabricksRestClient::DatabricksRestClient "DatabricksRestClient":
      this class provides the REST client API for communication with the Databricks REST
      API; it handles authentication via Personal Access Tokens (PAT)
    - @ref DatabricksRestClient::DatabricksRestConnection "DatabricksRestConnection":
      provides a connection object to Databricks services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires DatabricksRestClient

DatabricksRestClient rest({
    "workspace": "adb-1234567890.12.azuredatabricks.net",
    "token": ENV.DATABRICKS_TOKEN,
});
hash<auto> result = rest.get("api/2.0/clusters/list");
printf("Clusters: %N\n", result.body);
    @endcode

    @section databricksrestclientrelnotes Release Notes

    @subsection databricksrestclientv1_0 DatabricksRestClient v1.0
    - the initial version of the %DatabricksRestClient module
*/

#! the DatabricksRestClient namespace contains all the objects in the DatabricksRestClient module
public namespace DatabricksRestClient {

#! This class provides the REST client API for communication with Databricks servers
/** Databricks uses a REST API with Personal Access Token (PAT) authentication.

    Authentication is done via Bearer token in the Authorization header.

    @par API Information:
    - Base URL: https://{workspace-hostname}
    - Auth: Personal Access Token (sent as Bearer token)
    - API Paths: api/2.0/... (most resources), api/2.1/... (jobs, unity-catalog),
      serving-endpoints/... (model serving)
    - Response Format: JSON
*/
public class DatabricksRestClient inherits RestClient::RestClient {
    public {
        #! Default constructor options
        const DefaultOptions = {
            "data": "json",
        };

        #! Default Databricks ping method
        const DefaultPingMethod = "GET";

        #! Default Databricks ping path (no leading slash - relative to base URL)
        const DefaultPingPath = "api/2.0/clusters/list";

        #! Default Databricks ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };
    }

    #! creates the object with the given options
    /**
        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c workspace: the Databricks workspace hostname (required) - e.g.,
          "adb-1234567890.12.azuredatabricks.net"

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw DATABRICKS-ERROR missing required option 'workspace' or 'token'
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(DatabricksRestClient::getOptions(opts), do_not_connect) {
    }

    #! returns options for the constructor
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        if (!opts.workspace) {
            throw "DATABRICKS-ERROR", "missing required option 'workspace' (Databricks workspace hostname)";
        }
        if (!opts.token) {
            throw "DATABRICKS-ERROR", "missing required option 'token' (Databricks Personal Access Token)";
        }

        # Build URL from workspace hostname - no path suffix since API versions vary by resource
        rv.url = sprintf("https://%s", opts.workspace);

        # Remove custom option so RestClient doesn't try to use it
        remove rv.workspace;

        return rv;
    }
}

#! Class for Databricks REST connections; returns @ref DatabricksRestClient objects
public class DatabricksRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Databricks connection URL
        const DefaultConnectionUrl = "databricks://localhost";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Databricks REST Connection",
            "short_desc": "A connection to the Databricks REST API",
            "desc": "A connection to the Databricks REST API for workspace management, data engineering, "
                "and ML operations.\n\n"
                "Databricks provides a unified analytics platform for data engineering, collaborative data "
                "science, machine learning, and business analytics. This integration supports managing "
                "jobs, clusters, SQL warehouses, notebooks, pipelines, Unity Catalog, secrets, and running "
                "ML inference via Model Serving endpoints.\n\n"
                "**Authentication:** Uses a Personal Access Token (PAT) sent as a Bearer token in the "
                "`Authorization` header.",
            "cls": Class::forName("DatabricksRestConnection"),
            "auto_url": True,
            "schemes": {
                "databricks": True,
            },
            "base_scheme_map": {
                "https": "databricks",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": "json",
                },
                "workspace": <ConnectionOptionInfo>{
                    "display_name": "Workspace Hostname",
                    "short_desc": "Databricks workspace hostname",
                    "type": "string",
                    "desc": "The Databricks workspace hostname.\n\n"
                        "For example, if your workspace URL is "
                        "`https://adb-1234567890.12.azuredatabricks.net`, enter "
                        "`adb-1234567890.12.azuredatabricks.net`.\n\n"
                        "**Cloud-specific patterns:**\n"
                        "- **AWS:** `adb-<workspace-id>.<random>.cloud.databricks.com` or "
                        "`dbc-<id>.cloud.databricks.com`\n"
                        "- **Azure:** `adb-<workspace-id>.<random>.azuredatabricks.net`\n"
                        "- **GCP:** `<workspace-id>.<random>.gcp.databricks.com`",
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": DatabricksRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": DatabricksRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": DatabricksRestClient::DefaultPingPath,
                },
            },
            "required_options": "token,workspace",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your Personal Access Token",
                    "intent": "info",
                    "content": "1. Log in to your Databricks workspace\n"
                        "2. Click your username in the top-right corner\n"
                        "3. Select **Settings**\n"
                        "4. Click **Developer** > **Access tokens**\n"
                        "5. Click **Manage** > **Generate new token**\n"
                        "6. Enter a comment and optional lifetime, then click **Generate**\n\n"
                        "**Important:**\n"
                        "- Each PAT is valid for only one workspace\n"
                        "- Tokens that haven't been used for 90 days are automatically revoked\n"
                        "- Databricks recommends using OAuth for production workloads",
                },
            ),
        };
    }

    #! creates the DatabricksRestConnection object
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the DatabricksRestConnection object
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(DatabricksRestConnection::getConfig(config), attr) {
    }

    #! returns config for the constructor - builds URL from workspace option
    private static hash<auto> getConfig(hash<auto> config) {
        if (config.opts.workspace) {
            return config + {
                "url": sprintf("databricks://%s", config.opts.workspace),
            };
        }
        return config + {
            "url": DefaultConnectionUrl,
        };
    }

    #! returns \c "databricks"
    string getType() {
        return "databricks";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Databricks";
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("DatabricksDataProvider");
        return create_object("DatabricksDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options && opts.workspace) {
            string expected_url = sprintf("databricks://%s", opts.workspace);
            if (url != expected_url) {
                doUpdateOptions(self, {
                    "url": expected_url,
                });
            }
        }
    }

    #! returns a @ref DatabricksRestClient object
    private DatabricksRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new DatabricksRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
