# minimum Qore version
%requires qore >= 1.10

%requires HttpServerUtil >= 1.0.12
%requires WebSocketUtil >= 1.6
%requires Util
%requires AsyncSocketIo
%requires(reexport) Logger

# Optional AsyncAPI support
%try-module AsyncApi >= 1.0
%define NoAsyncApi
%endtry

%modern

module WebSocketHandler {
    version = "2.4";
    desc = "User module for providing WebSocket server services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage WebSocketHandler Module

    @tableofcontents

    @section websockethandlerintro Introduction to the WebSocketHandler Module

    The %WebSocketHandler module provides a handler to be used with the
    <a href="../../HttpServer/html/index.html">HttpServer module</a> to provide server-side
    <a href="http://tools.ietf.org/html/rfc6455">RFC-6455 based WebSocket services</a> to clients.

    To use this module, use \c "%requires WebSocketHandler" and \c "%requires HttpServer" in your code.

    The module supports WebSocket connections over all HTTP protocol versions:
    - <b>HTTP/1.1</b>: Standard WebSocket upgrade handshake (RFC 6455)
    - <b>HTTP/2</b>: Extended CONNECT method (RFC 8441)
    - <b>HTTP/3</b>: Extended CONNECT over QUIC (RFC 9220)

    All the public symbols in the module are defined in the WebSocketHandler namespace.

    The main classes provided in this module are:
    - @ref WebSocketHandler::WebSocketConnection
    - @ref WebSocketHandler::WebSocketHandler

    @par HTTP/3 WebSocket Server Example
    To accept WebSocket connections over HTTP/3, add a QUIC listener to the HttpServer
    with \c enable_h3 set to \c True. The %WebSocketHandler automatically detects HTTP/3
    extended CONNECT requests with \c :protocol=websocket (RFC 9220):
    @code{.py}
%requires HttpServer
%requires WebSocketHandler

# Subclass WebSocketConnection to handle incoming messages
class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {}
    gotMessage(string msg) { send(msg); }
    gotMessage(binary msg) { send(msg); }
}

# Subclass WebSocketHandler to create connections
class EchoWsHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }
}

# Create server in async mode (required for HTTP/3)
EchoWsHandler ws_handler();
HttpServer server(<HttpServerOptionInfo>{"async_mode": True});
server.setHandler("ws", "", NOTHING, ws_handler);
server.setDefaultHandler("ws", ws_handler);
server.waitForAsyncIo();

# Add QUIC listener with TLS cert (QUIC requires TLS 1.3)
server.addListener(<HttpListenerOptionInfo>{
    "service": 8443,
    "cert": cert,      # SSLCertificate object
    "key": key,         # SSLPrivateKey object
    "enable_h3": True,
});
server.waitForAsyncIo();
printf("HTTP/3 WebSocket server listening on port 8443\n");
    @endcode

    WebSocket clients connecting over HTTP/3 are handled identically to HTTP/1.1 and HTTP/2
    clients — the same \c gotMessage() callbacks and
    @ref WebSocketHandler::WebSocketHandler::sendOne() "sendOne()" /
    @ref WebSocketHandler::WebSocketHandler::sendAll() "sendAll()" APIs work across all transports.

    @section websockethandler_relnotes WebSocketHandler Release History

    @subsection websockethandler_v2_4 Version 2.4
    - added support for WebSocket over HTTP/3 (RFC 9220 — Extended CONNECT over QUIC)
      - server-side detection of HTTP/3 CONNECT requests with \c :protocol=websocket
      - bidirectional WebSocket frame exchange over QUIC streams
      - backpressure handling via QUIC flow control with I/O controller wake integration
      - explicit QUIC stream close on WebSocket handler exit (essential for stream multiplexing)
    - refactored to use @ref AsyncSocketIo::AbstractStreamContext "AbstractStreamContext" for
      protocol-agnostic WebSocket I/O, eliminating per-protocol branching in \c handleRequest(),
      \c startImpl(), and \c sendFrame()
    - added @ref WebSocketHandler::WebSocketConnection::setStreamContext()
      "WebSocketConnection::setStreamContext()" and
      @ref WebSocketHandler::WebSocketConnection::getStreamContext()
      "WebSocketConnection::getStreamContext()" methods for unified stream context management
    - deprecated @ref WebSocketHandler::WebSocketConnection::setHttp2StreamContext()
      "WebSocketConnection::setHttp2StreamContext()",
      @ref WebSocketHandler::WebSocketConnection::getHttp2StreamContext()
      "WebSocketConnection::getHttp2StreamContext()",
      @ref WebSocketHandler::WebSocketConnection::setHttp3StreamContext()
      "WebSocketConnection::setHttp3StreamContext()", and
      @ref WebSocketHandler::WebSocketConnection::getHttp3StreamContext()
      "WebSocketConnection::getHttp3StreamContext()" — use \c setStreamContext() /
      \c getStreamContext() instead

    @subsection websockethandler_v2_3 Version 2.3
    - fixed @ref WebSocketHandler::WebSocketHandler::sendAll() "WebSocketHandler::sendAll()" to apply
      per-connection extension transforms (e.g., permessage-deflate) instead of pre-encoding a single frame
      for all connections
    - fixed server-side extension negotiation to properly propagate negotiated extensions from
      @ref WebSocketHandler::WebSocketHandler::handleRequest() "handleRequest()" to
      @ref WebSocketHandler::WebSocketHandler "startImpl()" so that per-connection extension transforms
      (e.g., permessage-deflate compression/decompression) are actually applied
    - added WebSocket extension support (RFC 6455 Section 9) with permessage-deflate (RFC 7692)
      (<a href="https://github.com/qoretechnologies/qore/issues/5065">issue 5065</a>)
    - added @ref WebSocketHandler::WebSocketHandler "WebSocketHandler" constructor option \c "extensions" to enable
      server-side extension support
    - added @ref WebSocketHandler::WebSocketConnection::hasPerMessageDeflate()
      "WebSocketConnection::hasPerMessageDeflate()" method
    - added @ref WebSocketHandler::WebSocketConnection::getActiveExtensions()
      "WebSocketConnection::getActiveExtensions()" method

    @subsection websockethandler_v2_2 Version 2.2
    - added optional AsyncAPI validation support via \c WebSocketHandler::WebSocketConnection::setAsyncApiValidator()
      "WebSocketConnection::setAsyncApiValidator()" for validating WebSocket messages against AsyncAPI schemas
      (<a href="https://github.com/qoretechnologies/qore/issues/5014">issue 5014</a>)

    @subsection websockethandler_v2_1 Version 2.1
    - implemented support for a variable send timeout

    @subsection websockethandler_v2_0 Version 2.0
    - implemented support for \c Logger::Logger "Logger" objects for logging

    @subsection websockethandler_v1_5_4 Version 1.5.4
    - fixed a bug in \c WebSocketHandler::WebSocketHandler::sendOne() "WebSocketHandler::sendOne()"
      (<a href="https://github.com/qoretechnologies/qore/issues/4634">issue 4634</a>)

    @subsection websockethandler_v1_5_3 Version 1.5.3
    - fixed a bug handling valid empty \c PING messages
      (<a href="https://github.com/qoretechnologies/qore/issues/4565">issue 4565</a>)

    @subsection websockethandler_v1_5_2 Version 1.5.2
    - fixed a bug handling closing server-side web sockets on demand
      (<a href="https://github.com/qoretechnologies/qore/issues/4075">issue 4075</a>)
    - fixed a bug where I/O could not be flushed before closing the socket
      (<a href="https://github.com/qoretechnologies/qore/issues/4074">issue 4074</a>)
    - added support for continuation frames
      (<a href="https://github.com/qoretechnologies/qore/issues/4073">issue 4073</a>)

    @subsection websockethandler_v1_5_1 Version 1.5.1
    - fixed a bug handling the case when a connection object is deleted in a callback method
      (<a href="https://github.com/qoretechnologies/qore/issues/4063">issue 4063</a>)

    @subsection websockethandler_v1_5 Version 1.5
    - allow the WebSocket handler to have connections added to it from outside the class

    @subsection websockethandler_v1_4_3 Version 1.4.3
    - added missing exception handling to connection registration code
      (<a href="https://github.com/qoretechnologies/qore/issues/3215">issue 3215</a>)
    - added \c WebSocketHandler::WebSocketConnection::stop() and \c WebSocketHandler::WebSocketHandler::stopOne()

    @subsection websockethandler_v1_4_2 Version 1.4.2
    - added support for heartbeat messages
      (<a href="https://github.com/qoretechnologies/qore/issues/2887">issue 2887</a>)

    @subsection websockethandler_v1_4_1 Version 1.4.1
    - fixed a bug where unsolicited \c PONG messages caused the connection to be prematurely closed
      (<a href="https://github.com/qoretechnologies/qore/issues/2566">issue 2566</a>)

    @subsection websockethandler_v1_4 Version 1.4
    - added support for complex types
    - added the @ref WebSocketHandler::WebSocketConnection::registered() method

    @subsection websockethandler_v1_3 Version 1.3
    - added timeout values to @ref Qore::Socket "Socket" calls
      (<a href="https://github.com/qoretechnologies/qore/issues/1725">issue 1725</a>)

    @subsection websockethandler_v1_2 Version 1.2
    - fixed a bug parsing and generating the websocket close status code
      (<a href="https://github.com/qoretechnologies/qore/issues/1216">issue 1216</a>)

    @subsection websockethandler_v1_1 Version 1.1
    - bug fix: do not delete the connection object when the connection closes, remove it so it can go out of scope
      naturally to avoid excess exceptions in the server code
    - added the WebSocketConnection::connectionClosed() method which is called when the connection is closed

    @subsection websockethandler_v1_0 Version 1.0
    - the initial version of the WebSocketHandler module
*/

#! the WebSocketHandler namespace contains all the objects in the WebSocketHandler module
public namespace WebSocketHandler {
/** @defgroup WSHandlerRawCallbackReturnCodes WebSocketHandler Raw Callback Return Codes
*/
#/@{
#! If the server should process the message normally
public const WSC_Process = 0;

#! If the server should continue listening (message already processed)
public const WSC_Continue = 1;

#! If the server should stop listening (message already processed)
public const WSC_Break = 2;
#/@}

#! this class represents a connection to a websocket client
/** @par Receiving WebSocket Messages from Clients
    When the @ref WebSocketHandler::WebSocketHandler "WebSocketHandler" class receives a message from the client, the
    @ref WebSocketHandler::WebSocketHandler "WebSocketHandler" class calls the
    @ref WebSocketHandler::WebSocketConnection::gotMessage() "WebSocketConnection::gotMessage()" on the object that
    represents that connection.

    @par Sending WebSocket Message to Clients
    To send a message to a websocket client, call one of the following methods:
    - @ref WebSocketHandler::WebSocketConnection::send() "WebSocketConnection::send()": to send an unencoded message
      to the client
    - @ref WebSocketHandler::WebSocketConnection::sendEncoded() "WebSocketConnection::sendEncoded()": to send an
      already-encoded message to the client
*/
public class WebSocketConnection {
    public {
        #! The parent handler object
        WebSocketHandler handler;

        #! Stop connection flag
        bool stop_flag = False;

        # wait a maximum of 1/4 second for data
        const DefaultQueuePollingInterval = 250ms;
    }

    private {
        #! the @ref Qore::Thread::Channel "Channel" object stores messages to be sent to the server
        Qore::Thread::Channel channel(-1);

        #! The TID of the I/O thread
        int tid = gettid();

%ifndef NoAsyncApi
        #! Optional AsyncAPI validator
        *AsyncApi::AsyncApi3Schema asyncapi_validator;

        #! AsyncAPI channel name for validation
        *string asyncapi_channel;
%endif

        #! Active WebSocket extensions for this connection
        /** @since WebSocketHandler 2.3
        */
        *list<AbstractWebSocketExtension> active_extensions;

        #! RSV bit mask for active extensions
        /** @since WebSocketHandler 2.3
        */
        int extension_rsv_mask = 0;

        bool async_mode = False;
        *AsyncSocketIo::AsyncSocketIoController async_ctrl;
        *AsyncSocketIo::AbstractStreamContext stream_ctx;

        #! Listener ID this connection belongs to
        string lid;
    }

    private:internal {
        #! The socket used by the server for this connection
        Socket sock;
    }

    #! the constructor is called when a new connection is made by a websocket client
    /** Called from
        @ref WebSocketHandler::WebSocketHandler::getConnectionImpl() "WebSocketHandler::getConnectionImpl()", which
        can be overridden in subclasses to allow a subclass of this class to be used as the connection object
    */
    constructor(WebSocketHandler handler) {
        self.handler = handler;
    }

    #! Sets the socket used by the server for the connection
    setSocket(Socket sock) {
        self.sock = sock;
    }

    setAsyncIo(bool async_mode, *AsyncSocketIo::AsyncSocketIoController async_ctrl) {
        self.async_mode = async_mode;
        self.async_ctrl = async_ctrl;
    }

    #! Sets the stream context for WebSocket over HTTP/2 or HTTP/3
    /** @param ctx the stream context, or @ref nothing to clear

        @since WebSocketHandler 2.4
    */
    setStreamContext(*AsyncSocketIo::AbstractStreamContext ctx) {
        self.stream_ctx = ctx;
    }

    #! Returns the stream context for WebSocket over HTTP/2 or HTTP/3
    /** @return the stream context, or @ref nothing if not using HTTP/2 or HTTP/3 WebSocket

        @since WebSocketHandler 2.4
    */
    *AsyncSocketIo::AbstractStreamContext getStreamContext() {
        return stream_ctx;
    }

    #! Sets the HTTP/2 stream context
    /** @deprecated Use @ref setStreamContext() instead
    */
    deprecated setHttp2StreamContext(*AsyncSocketIo::Http2StreamContext ctx) {
        self.stream_ctx = ctx;
    }

    #! Returns the HTTP/2 stream context
    /** @deprecated Use @ref getStreamContext() instead
    */
    deprecated *AsyncSocketIo::Http2StreamContext getHttp2StreamContext() {
        return stream_ctx instanceof AsyncSocketIo::Http2StreamContext
            ? cast<AsyncSocketIo::Http2StreamContext>(stream_ctx)
            : NOTHING;
    }

    #! Sets the HTTP/3 stream context for WebSocket over QUIC (RFC 9220)
    /** @deprecated Use @ref setStreamContext() instead
    */
    deprecated setHttp3StreamContext(*AsyncSocketIo::Http3StreamContext ctx) {
        self.stream_ctx = ctx;
    }

    #! Returns the HTTP/3 stream context for WebSocket over QUIC (RFC 9220)
    /** @deprecated Use @ref getStreamContext() instead
    */
    deprecated *AsyncSocketIo::Http3StreamContext getHttp3StreamContext() {
        return stream_ctx instanceof AsyncSocketIo::Http3StreamContext
            ? cast<AsyncSocketIo::Http3StreamContext>(stream_ctx)
            : NOTHING;
    }

    bool isAsyncMode() {
        return async_mode;
    }

    *AsyncSocketIo::AsyncSocketIoController getAsyncCtrl() {
        return async_ctrl;
    }

    #! Returns the owner ID for async I/O operations
    string getOwnerId() {
        return self.uniqueHash();
    }

    #! Sets the listener ID for this connection
    setListenerId(string lid) {
        self.lid = lid;
    }

    #! Returns the listener ID for this connection
    string getListenerId() {
        return lid;
    }

    #! This method is called to poll for messages from the client to send from the server
    /** Called by the @ref WebSocketHandler::WebSocketHandler "WebSocketHandler"
    */
    *binary pollData() {
        try {
            return channel.recv(DefaultQueuePollingInterval);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "CHANNEL-TIMEOUT") {
                rethrow;
            }
        }
    }

    #! This method is called to poll for messages from the client to send from the server
    /** Called by the @ref WebSocketHandler::WebSocketHandler "WebSocketHandler"
    */
    *binary pollDataImmediate() {
        auto result = channel.tryRecv();
        return exists result ? result.value : NOTHING;
    }

    #! Pushes an already-encoded message on the connection's message channel
    sendEncoded(binary msg) {
        try {
            channel.send(msg);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "CHANNEL-CLOSED") {
                rethrow;
            }
        }
    }

    #! Returns True if this connection requires per-connection encoding
    /** Connections with active extensions or an AsyncAPI validator cannot share a pre-encoded frame
        and must encode individually via @ref send().

        @return True if per-connection encoding is needed, False if a shared pre-encoded frame can be used

        @since WebSocketHandler 2.3
    */
    bool needsPerConnectionEncoding() {
%ifndef NoAsyncApi
        if (asyncapi_validator && asyncapi_channel) {
            return True;
        }
%endif
        return exists active_extensions;
    }

    #! Pushes an unencoded message on the connection's message channel
    /** The message will be encoded with @ref WebSocketUtil::ws_encode_message() before sending

        If an AsyncAPI validator is set, the outgoing message will be validated before sending.
    */
    send(data msg) {
%ifndef NoAsyncApi
        if (asyncapi_validator && asyncapi_channel) {
            hash<auto> headers;
            asyncapi_validator.validateOutgoingMessage(asyncapi_channel, \msg, \headers);
        }
%endif
        try {
            channel.send(sendWithExtensions(msg));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "CHANNEL-CLOSED") {
                rethrow;
            }
        }
    }

    #! Pushes an unencoded message on the connection's message channel
    /** The message will be encoded with @ref WebSocketUtil::ws_encode_message() before sending

        If an AsyncAPI validator is set, the outgoing message will be validated before sending.
    */
    send(data msg, int op, bool fin) {
%ifndef NoAsyncApi
        if (asyncapi_validator && asyncapi_channel) {
            hash<auto> headers;
            asyncapi_validator.validateOutgoingMessage(asyncapi_channel, \msg, \headers);
        }
%endif
        try {
            channel.send(sendWithExtensions(msg, op, fin));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "CHANNEL-CLOSED") {
                rethrow;
            }
        }
    }

    #! Applies extension transforms to outgoing message and encodes it
    /** @param msg the message data to send
        @param op the opcode to use (defaults to WSOP_Text for string, WSOP_Binary for binary)
        @param fin the FIN bit (default True)

        @return the encoded WebSocket frame with extension transforms applied

        @since WebSocketHandler 2.3
    */
    private binary sendWithExtensions(data msg, *int op, bool fin = True) {
        # Determine the opcode before extension transforms may change the message type
        int actual_op = op ?? (msg.typeCode() == NT_STRING ? WSOP_Text : WSOP_Binary);
        int rsv_bits = 0;

        # Apply outgoing transforms from active extensions
        # Extensions are applied in forward order (first extension first) for outgoing messages,
        # as specified in RFC 6455 Section 9.2 and RFC 7692 Section 8
        if (active_extensions) {
            hash<auto> ctx = {
                "op": actual_op,
                "fin": fin,
            };
            foreach AbstractWebSocketExtension ext in (active_extensions) {
                hash<auto> result = ext.transformOutgoing(msg, ctx);
                msg = result.data;
                rsv_bits |= result.rsv_bits;
            }
        }

        return ws_encode_message(msg, actual_op, NOTHING, fin, rsv_bits);
    }

    #! This method is called when messages from the client are received
    /** Called by the @ref WebSocketHandler::WebSocketHandler "WebSocketHandler"

        The implementation in this class is empty; implement this method in a subclass to provide custom behavior
    */
    gotMessage(string msg) {
    }

    #! This method is called when messages from the client are received
    /** Called by the @ref WebSocketHandler::WebSocketHandler "WebSocketHandler"

        The implementation in this class is empty; implement this method in a subclass to provide custom behavior
    */
    gotMessage(binary msg) {
    }

    #! This method is called when a message is received
    /** @param msg the raw message information

        @return see \c WSClientRawCallbackReturnCodes for values and meanings

        @note this base class always returns @ref WSC_Process

        @since %WebSocketHandler 1.5.2
    */
    int gotRawMessage(hash<WsMsgInfo> msg) {
        return WSC_Process;
    }

    #! This method is called when the connection is closed
    /** Called by the @ref WebSocketHandler::WebSocketHandler "WebSocketHandler"

        The implementation in this class is empty; implement this method in a subclass to provide custom behavior
    */
    connectionClosed() {
    }

    #! Called when the connection has been registered in handler and accept sending messages
    /** Can be used to send initial welcome message, for example; the default implementation does nothing

        @since %WebSocketHandler 1.4
    */
    registered() {
    }

    #! Flush all output data
    /**
        @since %WebSocketHandler 1.5.2
    */
    flush() {
        if (gettid() != tid) {
            while (!stop_flag && !channel.empty()) {
                usleep(DefaultQueuePollingInterval);
            }
        } else {
            handler.flushIo(self, sock);
        }
    }

    #! force closing socket related to connection
    stop() {
        stop_flag = True;
        # closing the channel wakes up the polling thread immediately
        channel.close();
    }

%ifndef NoAsyncApi
    #! Sets an AsyncAPI validator for message validation
    /** @param validator the AsyncAPI schema validator
        @param channel the channel name to use for validation

        When set, messages can be validated against the AsyncAPI schema for the specified channel.

        @since WebSocketHandler 2.2
    */
    setAsyncApiValidator(AsyncApi::AsyncApi3Schema validator, string channel) {
        asyncapi_validator = validator;
        asyncapi_channel = channel;
    }

    #! Returns the current AsyncAPI validator, if any
    /** @return the AsyncAPI validator or NOTHING if not set

        @since WebSocketHandler 2.2
    */
    *AsyncApi::AsyncApi3Schema getAsyncApiValidator() {
        return asyncapi_validator;
    }

    #! Returns the current AsyncAPI channel name, if any
    /** @return the channel name or NOTHING if not set

        @since WebSocketHandler 2.2
    */
    *string getAsyncApiChannel() {
        return asyncapi_channel;
    }

    #! Clears the AsyncAPI validator
    /** @since WebSocketHandler 2.2
    */
    clearAsyncApiValidator() {
        delete asyncapi_validator;
        delete asyncapi_channel;
    }

    #! Validates an incoming message against the AsyncAPI schema
    /** @param msg the message to validate (reference, may be modified)
        @param headers optional headers hash for validation

        @note If validation fails, the exception propagates to the caller. Override this method to implement
        custom error handling (e.g., logging and continuing instead of disconnecting).

        @throws SCHEMA-VALIDATION-ERROR if the message fails validation

        @since WebSocketHandler 2.2
    */
    validateIncomingMessage(reference<auto> msg, hash<auto> headers = {}) {
        if (asyncapi_validator && asyncapi_channel) {
            asyncapi_validator.validateIncomingMessage(asyncapi_channel, \msg, \headers);
        }
    }

    #! Validates an outgoing message against the AsyncAPI schema
    /** @param msg the message to validate
        @param headers reference to headers (may be modified)

        @throws SCHEMA-VALIDATION-ERROR if the message fails validation

        @since WebSocketHandler 2.2
    */
    validateOutgoingMessage(reference<auto> msg, reference<hash<auto>> headers) {
        if (asyncapi_validator && asyncapi_channel) {
            asyncapi_validator.validateOutgoingMessage(asyncapi_channel, \msg, \headers);
        }
    }
%else
    #! Stub for incoming message validation when AsyncAPI is not available
    /** @param msg the message to validate (reference, may be modified)
        @param headers optional headers hash for validation

        @note This is a no-op stub when AsyncAPI is not available

        @since WebSocketHandler 2.2
    */
    validateIncomingMessage(reference<auto> msg, hash<auto> headers = {}) {
        # no-op when AsyncAPI is not available
    }

    #! Stub for outgoing message validation when AsyncAPI is not available
    /** @param msg the message to validate
        @param headers reference to headers (may be modified)

        @note This is a no-op stub when AsyncAPI is not available

        @since WebSocketHandler 2.2
    */
    validateOutgoingMessage(reference<auto> msg, reference<hash<auto>> headers) {
        # no-op when AsyncAPI is not available
    }
%endif

    #! Sets the active extensions for this connection
    /** @param extensions the list of negotiated extensions
        @param rsv_mask the combined RSV bit mask for all active extensions

        @note Called by the handler after extension negotiation

        @since WebSocketHandler 2.3
    */
    setExtensions(*list<AbstractWebSocketExtension> extensions, int rsv_mask = 0) {
        active_extensions = extensions;
        extension_rsv_mask = rsv_mask;
    }

    #! Applies incoming extension transforms to message data
    /** @param msg reference to the message data (will be modified in place)
        @param ctx the message context with RSV bits and opcode

        @note Extensions are applied in reverse order (last extension first)

        @since WebSocketHandler 2.3
    */
    applyIncomingExtensions(reference<auto> msg, hash<auto> ctx) {
        if (!active_extensions) {
            return;
        }

        # Apply transforms in reverse order
        ListIterator i(active_extensions);
        i.last();
        while (i.prev()) {
            AbstractWebSocketExtension ext = i.getValue();
            msg = ext.transformIncoming(msg, ctx);
        }
    }

    #! Validates that the RSV bits in an incoming frame are valid for active extensions
    /** @param rsv1 RSV1 bit from the frame
        @param rsv2 RSV2 bit from the frame
        @param rsv3 RSV3 bit from the frame

        @return True if the RSV bits are valid, False otherwise

        @since WebSocketHandler 2.3
    */
    bool validateRsvBits(bool rsv1, bool rsv2, bool rsv3) {
        int rsv_bits = (rsv1 ? WS_RSV1 : 0) | (rsv2 ? WS_RSV2 : 0) | (rsv3 ? WS_RSV3 : 0);
        # RSV bits must be covered by active extensions
        return (rsv_bits & ~extension_rsv_mask) == 0;
    }

    #! Returns True if permessage-deflate extension is active
    /** @return True if permessage-deflate is active, False otherwise

        @since WebSocketHandler 2.3
    */
    bool hasPerMessageDeflate() {
        if (!active_extensions) {
            return False;
        }
        foreach AbstractWebSocketExtension ext in (active_extensions) {
            if (ext.getName() == "permessage-deflate") {
                return True;
            }
        }
        return False;
    }

    #! Returns the list of active extension names
    /** @return list of extension names or NOTHING if no extensions are active

        @since WebSocketHandler 2.3
    */
    *list<string> getActiveExtensions() {
        if (!active_extensions) {
            return NOTHING;
        }
        return map $1.getName(), active_extensions;
    }
}

#! the main web socket handler class
/** connections are represented by object descended from @ref WebSocketHandler::WebSocketConnection "WebSocketConnection".
    @ref WebSocketHandler::WebSocketHandler::getConnectionImpl() returns a suitable object for each connection, this
    method can be overridden in subclasses to return a custom object for each connection if required.

    @par Receiving WebSocket Messages from Clients
    When the @ref WebSocketHandler::WebSocketHandler "WebSocketHandler" class receives a message from the client, the
    @ref WebSocketHandler::WebSocketHandler "WebSocketHandler" class calls the
    @ref WebSocketHandler::WebSocketConnection::gotMessage() "WebSocketConnection::gotMessage()" on the object that
    represents that connection.

    @par Sending WebSocket Message to Clients
    To send a message to a websocket client, call one of the following methods:
    - \c WebSocketHandler::WebSocketHandler::sendOne() "WebSocketHandler::sendOne()": send a message to single
      connection given its connection ID
    - \c WebSocketHandler::WebSocketHandler::sendAll() "WebSocketHandler::sendAll()": send a message to all
      connected clients

    Websocket connections are identified by their HTTP connection ID as passed in
    \c WebSocketHandler::WebSocketHandler::handleRequest() "WebSocketHandler::handleRequest()" in the \c "cx.id"
    argument when the connection is first established.
*/
public class WebSocketHandler inherits HttpServer::AbstractHttpSocketHandler, Logger::LoggerWrapper {
    public {
        #! default socket send timeout
        const DefaultSocketSendTimeout = 30s;

        #! default heartbeat interval
        const DefaultHeartbeatInterval = 20s;

        #! default heartbeat message
        const DefaultHeartbeatMsg = "heartbeat";

        #! Maximum retries when HTTP/2 flow control backpressure is detected
        /** When sendFrame() encounters \c HTTP2-FLOW-CONTROL (per-stream buffer > 1MB),
            it pumps I/O to drain the buffer and retries up to this many times before
            dropping the frame.
        */
        const FlowControlMaxRetries = 10;

        #! Timeout per flow control retry iteration (milliseconds)
        /** Each retry calls @ref Qore::Socket::isDataAvailable() "Socket::isDataAvailable()"
            with this timeout to flush outgoing data and read incoming HTTP/2 frames
            (including \c WINDOW_UPDATE) from the peer.
        */
        const FlowControlRetryMs = 50ms;

        #! known constructor options
        const Options = (
            "heartbeat",
            "heartbeat_msg",
            "extensions",
            "max_message_size",
        );
    }

    private {
        #! connection read-write lock
        RWLock rwl();

        #! connection hash
        hash<string, WebSocketConnection> ch;

        #! heartbeat interval in seconds
        softint heartbeat = DefaultHeartbeatInterval;

        #! heartbeat message
        string heartbeat_msg = DefaultHeartbeatMsg;

        #! Send timeout
        date send_timeout = DefaultSocketSendTimeout;

        #! Maximum WebSocket message size in bytes (0 = unlimited)
        /** Messages (including fragmented message accumulation) exceeding this limit will
            cause the connection to be closed with status code 1009 (Message Too Big).

            @since WebSocketHandler 2.5
        */
        int max_message_size = 0;

        #! Extension registry for supported extensions
        /** @since WebSocketHandler 2.3
        */
        *WebSocketExtensionRegistry extension_registry;

        #! List of supported extension names
        /** @since WebSocketHandler 2.3
        */
        *list<string> supported_extensions;

        #! Pending negotiated extensions keyed by connection ID, to be consumed by startImpl()
        /** @since WebSocketHandler 2.3
        */
        hash<string, hash<auto>> pending_extensions;
    }

    private:internal {
        #! Thread-local key for I/O check
        string tlk = get_random_string(50);
    }

    #! create the object optionally with the given @ref HttpServer::AbstractAuthenticator "AbstractAuthenticator"
    /** @param auth the authentication object to use to authenticate connections (see
        @ref HttpServer::AbstractAuthenticator "AbstractAuthenticator"); if no
        @ref HttpServer::AbstractAuthenticator "AbstractAuthenticator" object is passed, then by default no
        authentication will be required
        @param opts options for the object with the following optional keys:
        - \c heartbeat: a positive integer value giving seconds for the heartbeat interval for the server connection
          (default: 20 seconds)
        - \c heartbeat_msg: a string giving the payload to send in heartbeat messages (default: \c "heartbeat"); may
          be an empty string meaning no message
        - \c logger: a \c Logger::Logger "Logger" object to use for logging (default: no logging)
        - \c send_timeout: a relative date/time value giving the timeout to use for sending data on the socket
          (default: 30s); if an integer is sent here, it is assumed to represent a value in milliseconds
        - \c extensions: a list of extension names to support (e.g., \c ("permessage-deflate")) or a
          @ref WebSocketUtil::WebSocketExtensionRegistry "WebSocketExtensionRegistry" instance (since WebSocketHandler
          2.3)

        @throw WEBSOCKETHANDLER-OPTION-ERROR unknown or invalid option
    */
    constructor(*HttpServer::AbstractAuthenticator auth, *hash<auto> opts)
            : HttpServer::AbstractHttpSocketHandler(auth) {
        foreach hash<auto> h in (opts.pairIterator()) {
            switch (h.key) {
                case "heartbeat": {
                    if (!h.value.intp()) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y value %y cannot be converted to an "
                            "integer giving the number of seconds in the heartbeat interval", h.key, h.value);
                    }
                    setHeartbeat(h.value);
                    break;
                }
                case "heartbeat_msg": {
                    if (h.value.typeCode() != NT_STRING) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y has type %y; expecting \"string\"",
                            h.key, h.value.fullType());
                    }
                    heartbeat_msg = h.value;
                    break;
                }
                case "logger": {
                    if (!(h.value instanceof LoggerInterface)) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y has type %y; expecting "
                            "\"LoggerInterface\"", h.key, h.value.fullType());
                    }
                    logger = h.value;
                    break;
                }
                case "send_timeout": {
                    if (h.value.typeCode() == NT_INT) {
                        h.value = milliseconds(h.value);
                    }
                    if (h.value.typeCode() != NT_DATE) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y has type %y; expecting \"date\"",
                            h.key, h.value.fullType());
                    }
                    if (h.value.absolute()) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y value %y is absolute; expecting "
                            "relative date/time value", h.key, h.value);
                    }
                    if (h.value < 0s) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y value %y is negative; expecting "
                            "non-negative relative date/time value", h.key, h.value);
                    }
                    send_timeout = h.value;
                    break;
                }
                case "extensions": {
                    if (h.value instanceof WebSocketExtensionRegistry) {
                        extension_registry = h.value;
                        supported_extensions = extension_registry.getRegisteredExtensions();
                    } else if (h.value.typeCode() == NT_LIST) {
                        supported_extensions = h.value;
                        extension_registry = new WebSocketExtensionRegistry();
                    } else if (h.value.val()) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y has type %y; expecting a list of "
                            "extension names or a WebSocketExtensionRegistry instance", h.key, h.value.fullType());
                    }
                    break;
                }
                case "max_message_size": {
                    if (!h.value.intp()) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y value %y cannot be converted to an "
                            "integer giving the maximum message size in bytes", h.key, h.value);
                    }
                    max_message_size = int(h.value);
                    if (max_message_size < 0) {
                        throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y value %d is negative; expecting "
                            "non-negative value (0 = unlimited)", h.key, max_message_size);
                    }
                    break;
                }
                default:
                    throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option %y is unknown; known options: %y", h.key,
                        Options);
            }
        }
    }

    #! returns the connection heartbeat interval as a number of seconds
    /** @return the connection heartbeat interval as a number of seconds

        @since WebSocketHandler 1.4.2
    */
    int getHeartbeat() {
        return heartbeat;
    }

    #! sets the heartbeat interval as a number of seconds
    /** @param seconds the heartbeat interval as a number of seconds

        @since WebSocketHandler 1.4.2
    */
    setHeartbeat(softint seconds) {
        if (seconds <= 0) {
            throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("option \"heartbeat\" value %y is not a positive integer "
                "giving the number of seconds in the heartbeat interval", seconds);
        }
        heartbeat = seconds;
    }

    #! Returns the maximum WebSocket message size in bytes (0 = unlimited)
    /** @return the maximum message size in bytes; 0 means unlimited

        @since WebSocketHandler 2.5
    */
    int getMaxMessageSize() {
        return max_message_size;
    }

    #! Sets the maximum WebSocket message size in bytes (0 = unlimited)
    /** @param size the maximum message size in bytes; 0 means unlimited

        @since WebSocketHandler 2.5
    */
    setMaxMessageSize(int size) {
        max_message_size = size;
    }

    #! returns the heartbeat message as a string
    /** @return the heartbeat message as a string; an empty string means no message

        @since WebSocketHandler 1.4.2
    */
    string getHeartbeatMessage() {
        return heartbeat_msg;
    }

    #! sets the heartbeat message
    /** @param msg the string payload to send with heartbeat messages; an empty string means no message

        @since WebSocketHandler 1.4.2
    */
    setHeartbeatMessage(string msg) {
        heartbeat_msg = msg;
    }

    #! Returns the send timeout value as a relative date/time value
    /** @return the send timeout value as a relative date/time value

        @since WebSocketHandler 2.1
    */
    date getSendTimeout() {
        return send_timeout;
    }

    #! Set the send timeout with a non-negative relative date/time value
    /** @param to the send timeout value as a relative date/time value

        @since WebSocketHandler 2.1
    */
    setSendTimeout(date to) {
        if (to.absolute()) {
            throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option \"send_timeout\" value %y is absolute; expecting "
                "relative date/time value", to);
        }
        if (to < 0s) {
            throw "WEBSOCKETHANDLER-OPTION-ERROR", sprintf("Option \"send_timeout\" value %y is negative; "
                "expecting non-negative relative date/time value", to);
        }
        send_timeout = to;
    }

    #! Set the send timeout with a non-negative value in milliseconds
    /** @param ms the send timeout as a non-negative value in milliseconds

        @since WebSocketHandler 2.1
    */
    setSendTimeout(int ms) {
        setSendTimeout(milliseconds(ms));
    }

    #! called by the HTTP server to handle incoming HTTP requests
    /** To accept a dedicated connection; make sure the return value hash's \c "code" key is 101 (i.e.
        \c "Switching Protocols") and the \c "close" key is not @ref False "False"

        @param cx call context hash; see @ref httpserverutil_request_context for details; note that \c id is the
        unique HTTP connection ID; this ID is also used to identify the websocket client connection in
        \c WebSocketHandler::WebSocketHandler::sendOne() "WebSocketHandler::sendOne()"
        @param hdr incoming header hash; all keys will be converted to lower-case, additionally the following keys
        will be present:
        - \c method: the HTTP method received (ie \c "GET", \c "POST", etc)
        - \c path: the HTTP path given in the request, after processing by decode_url() (Qore function)
        - \c http_version: the HTTP version number in the request (either \c "1.0" or \c "1.1")
        @param b message body, if any

        @return a hash representing the response to the client as follows; to accept a dedicated connection; make sure
        the \c "code" is 101 (ie \c "Switching Protocols") and the \c "close" key is not @ref False "False":
        - \c "code": the HTTP return code (see \c HttpServer::HttpCodes) (101 \c "Switching Protocols" to accept the
          dedicated connection, in which case the start() method will be called)
        - \c "body": the message body to return in the response
        - \c "close": (optional) set this key to @ref True "True" if the connection should be unconditionally closed
          when the handler returns
        - \c "hdr": (optional) set this key to a hash of extra header information to be returned with the response

        Websocket connections are identified by their HTTP connection ID as passed in \c "cx.id"
    */
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data b) {
        #logDebug("websocket request: cx: %N", cx);
        #logDebug("websocket request: hdr: %N", hdr);

        # RFC 8441 / RFC 9220: HTTP/2 or HTTP/3 WebSocket uses CONNECT with :protocol=websocket
        bool is_extended_connect = is_websocket_extended_connect(cx, hdr);
        if (is_extended_connect) {
            bool is_http3 = cx."header-info".http3 ?? False;
            logDebug("%s WebSocket CONNECT request received (RFC %s)",
                is_http3 ? "HTTP/3" : "HTTP/2",
                is_http3 ? "9220" : "8441");

            # Negotiate extensions if supported
            *hash<auto> ext_result = negotiateExtensions(hdr."sec-websocket-extensions");
            # HTTP/2 and HTTP/3 header field names must be lowercase
            hash<auto> rhdr = {};
            if (hdr."sec-websocket-key") {
                rhdr."sec-websocket-accept" = ws_get_response_key(hdr."sec-websocket-key");
            }
            if (ext_result.response_header) {
                rhdr."sec-websocket-extensions" = ext_result.response_header;
            }
            # Store negotiated extensions on the handler for startImpl to access
            if (ext_result.extensions) {
                string cid = cx.id.toString();
                pending_extensions{cid} = {
                    "extensions": ext_result.extensions,
                    "rsv_mask": ext_result.rsv_mask,
                };
            }

            # RFC 8441/9220: Return 200 OK for HTTP/2 or HTTP/3 WebSocket CONNECT
            return {
                "code": 200,
                "hdr": rhdr,
                "streaming": True,
                "stream_type": "websocket",
            };
        }

        # HTTP/1.1 WebSocket upgrade requires Sec-WebSocket-Key
        if (!hdr."sec-websocket-key") {
            return {
                "code": 400,
                "body": "cannot open WebSocket connection; no Sec-WebSocket-Key header found in request",
            };
        }

        hash<auto> rhdr = {
            "Upgrade": "websocket",
            "Connection": "Upgrade",
            "Sec-WebSocket-Accept": ws_get_response_key(hdr."sec-websocket-key"),
        };

        # Negotiate extensions if supported
        *hash<auto> ext_result = negotiateExtensions(hdr."sec-websocket-extensions");
        if (ext_result.response_header) {
            rhdr."Sec-WebSocket-Extensions" = ext_result.response_header;
        }
        # Store negotiated extensions on the handler for startImpl to access
        if (ext_result.extensions) {
            string cid = cx.id.toString();
            pending_extensions{cid} = {
                "extensions": ext_result.extensions,
                "rsv_mask": ext_result.rsv_mask,
            };
        }

        return {
            "code": 101,
            "hdr": rhdr,
        };
    }

    #! get list of socket connection ids
    /**
    */
    *list<string> getConnectionIds() {
        rwl.readLock();
        on_exit rwl.readUnlock();
        return keys ch;
    }

    #! called from the HTTP server after the handleRequest() method indicates that a dedicated connection should be established
    /** This method should not return until the connection is closed or the stop() method is called

        @param lid the unique HTTP listener ID
        @param cx call context hash; see @ref httpserverutil_request_context for details; note that \c id is the
        unique HTTP connection ID; this ID is also used to identify the websocket client connection in
        \c WebSocketHandler::WebSocketHandler::sendOne() "WebSocketHandler::sendOne()"
        @param hdr a hash of headers in the request
        @param sock the @ref Qore::Socket "Socket" object for the dedicated connection to the client
    */
    bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Qore::Socket sock) {
        softstring cid = cx.id;
        bool is_extended_connect = is_websocket_extended_connect(cx, hdr);
        bool is_http3 = is_extended_connect && (cx."header-info".http3 ?? False);
        bool is_http2 = is_extended_connect && (cx."header-info".http2 ?? False);
        int h2_stream_id = is_http2 ? cx."header-info".stream_id : -1;
        int h3_session_id = is_http3 ? cx."header-info".session_id : -1;
        int h3_stream_id = is_http3 ? cx."header-info".stream_id : -1;
        softstring exit_reason = "unknown";
        @debug(bool h2_ws_debug_handler = is_http2 && getenv("QORE_HTTP2_WS_DEBUG_HANDLER"));
        @debug {
            if (h2_ws_debug_handler) {
                log(LoggerLevel::INFO, "HTTP/2 WS handler start: cid=%y stream_id=%d from %s:%d", cx.id, h2_stream_id,
                    cx."peer-info".hostname_desc, cx."peer-info".port);
            } else if (is_http3) {
                logDebug("HTTP/3 WS handler start: cid=%y session_id=%d stream_id=%d from %s:%d",
                    cx.id, h3_session_id, h3_stream_id,
                    cx."peer-info".hostname_desc, cx."peer-info".port);
            } else {
                logDebug("WebSocketHandler::startImpl() cid: %y from %s:%d", cx.id, cx."peer-info".hostname_desc,
                    cx."peer-info".port);
            }
        }
        # Debug helper for HTTP/2 WS frame headers
        @debug(bool h2_ws_debug_frames = is_http2 && getenv("QORE_HTTP2_WS_DEBUG_FRAMES"));
        bool async_mode = cx."async_mode" ?? False;
        *AsyncSocketIo::AsyncSocketIoController async_ctrl;
        if (async_mode) {
            async_ctrl = cx."async_ctrl";
        }
        # get new connection object
        WebSocketConnection wsc = doNewConnection(cx, hdr, cid);
        sock.setEncoding("UTF-8");
        wsc.setSocket(sock);
        wsc.setListenerId(lid);
        wsc.setAsyncIo(async_mode, async_ctrl);
        if (is_http2) {
            @assert(h2_stream_id > 0, "missing HTTP/2 stream id for WebSocket");
            # The WebSocket handler thread owns the socket exclusively and must read
            # HTTP/2 frames directly (no I/O thread is polling this connection)
            wsc.setStreamContext(new AsyncSocketIo::Http2StreamContext(sock, h2_stream_id, True));
        } else if (is_http3) {
            @assert(h3_session_id > 0, "missing HTTP/3 session id for WebSocket");
            @assert(h3_stream_id >= 0, "missing HTTP/3 stream id for WebSocket");
            # CONNECT response was already sent by HttpServer.qm before calling start()
            # Create HTTP/3 stream context for WebSocket frame I/O
            code<nothing()> wake = sub () {
                if (async_ctrl) {
                    async_ctrl.wake();
                }
            };
            wsc.setStreamContext(new AsyncSocketIo::Http3StreamContext(
                sock, h3_session_id, h3_stream_id, wake));
        }

        # Set negotiated extensions on the connection (stored by handleRequest)
        *hash<auto> ext_data = remove pending_extensions{cid};
        if (ext_data) {
            wsc.setExtensions(ext_data.extensions, ext_data.rsv_mask ?? 0);
            logDebug("WebSocketHandler::startImpl() cid: %y extensions: %y", cx.id,
                (map $1.getName(), ext_data.extensions));
        }

        try {
            # issue #3225: handle exceptions in WebSocketHandler and remove the connection
            wsc.registered();
        } catch (hash<ExceptionInfo> ex) {
            logError("exception registering WebSocket connection: %s", get_exception_string(ex));
            rwl.writeLock();
            on_exit rwl.writeUnlock();
            remove ch{cid};
            rethrow;
        }

        on_exit {
            #logDebug("WebSocketHandler::startImpl(): close connection: cid: %y from %s:%d", cx.id,
            #    cx."peer-info".hostname_desc, cx."peer-info".port);
            # Close the stream context (no-op for HTTP/2; sends END_STREAM for HTTP/3)
            try {
                *AsyncSocketIo::AbstractStreamContext ctx = wsc.getStreamContext();
                if (ctx) {
                    ctx.close();
                }
            } catch (hash<ExceptionInfo> ex) {
                logError("exception closing WebSocket stream: %s", get_exception_string(ex));
            }
            try {
                deregisterConnectionImpl(wsc);
                wsc.connectionClosed();
            } catch (hash<ExceptionInfo> ex) {
                logError("exception deregistering WebSocket connection: %s", get_exception_string(ex));
            }
            rwl.writeLock();
            on_exit rwl.writeUnlock();
            remove ch{cid};
            # Safety net: clean up any pending extension data for this connection
            remove pending_extensions{cid};
        }

        # issue #2887 timestamp of last traffic
        int timestamp = clock_getmillis() / 1000;

        # data buffer for fragmented frames
        data buf;
        # RSV bits from first frame for fragmented messages (RFC 7692 Section 6.2.1)
        hash<auto> first_frame_rsv;
        binary stream_buf;
        while (True) {
            #logDebug("WebSocketHandler::startImpl() loop cid: %y", cx.id);
            if (stop || lsh{lid} || wsc.stop_flag) {
                logDebug("WebSocketHandler::startImpl() cid: %y stopping; stop: %y lsh{%y}: %y, "
                    "wsc.stop_flag: %y", cx.id, stop, lid, lsh{lid}, wsc.stop_flag);
                try {
                    sendClose(wsc, sock, WSCC_GoingAway);
                } catch (hash<ExceptionInfo> ex) {
                    logError("failed to send close frame: %s: %s", ex.err, ex.desc);
                }
                exit_reason = "stopping";
                break;
            }

            try {
                bool update = False;
                # send any and all messages on the channel
                *binary d = wsc.pollData();
                if (d) {
                    @debug {
                        if (h2_ws_debug_frames && d.size() >= 2) {
                            int b0 = d[0];
                            int b1 = d[1];
                            log(LoggerLevel::INFO,
                                "HTTP/2 WS send frame: b0=0x%02x b1=0x%02x fin=%y op=%d masked=%y", b0, b1,
                                (b0 & WS_FIN) != 0, b0 & 0x0f, (b1 & 0x80) != 0);
                        }
                    }
                    sendFrame(wsc, sock, d);
                    update = True;
                    flushIoIntern(wsc, sock, False);
                }

                if (wsc.stop_flag) {
                    continue;
                }
                hash<WsMsgInfo> h;
                bool have_frame = False;
                if (is_extended_connect && async_mode) {
                    # HTTP/2 and HTTP/3 WebSocket: read from stream context
                    *AsyncSocketIo::AbstractStreamContext ctx = wsc.getStreamContext();
                    *binary incoming = ctx ? ctx.readData() : NOTHING;
                    if (incoming) {
                        stream_buf = stream_buf ? stream_buf + incoming : incoming;
                    }
                    # Check WebSocket buffer size against limit
                    if (max_message_size > 0 && stream_buf.size() > max_message_size) {
                        logError("%s WebSocket buffer size %d exceeds maximum %d",
                            is_http3 ? "HTTP/3" : "HTTP/2",
                            stream_buf.size(), max_message_size);
                        sendClose(wsc, sock, WSCC_MessageTooBig,
                            sprintf("message size exceeds %d byte limit", max_message_size));
                        exit_reason = "message-too-large";
                        break;
                    }
                    *int frame_len = stream_buf ? ws_get_frame_size(stream_buf) : NOTHING;
                    if (frame_len) {
                        binary frame = stream_buf.substr(0, frame_len);
                        if (frame_len == stream_buf.size()) {
                            remove stream_buf;
                        } else {
                            stream_buf = stream_buf.substr(frame_len);
                        }
                        h = ws_parse_frame(frame, sock.getEncoding());
                        have_frame = True;
                    } else {
                        int now = clock_getmillis() / 1000;
                        if (!update) {
                            if ((now - timestamp) >= heartbeat) {
                                binary frame = ws_encode_message(heartbeat_msg, WSOP_Ping);
                                @debug {
                                    if (h2_ws_debug_frames && frame.size() >= 2) {
                                        int b0 = frame[0];
                                        int b1 = frame[1];
                                        log(LoggerLevel::INFO,
                                            "HTTP/2 WS send frame: b0=0x%02x b1=0x%02x fin=%y op=%d masked=%y",
                                            b0, b1, (b0 & WS_FIN) != 0, b0 & 0x0f, (b1 & 0x80) != 0);
                                    }
                                }
                                sendFrame(wsc, sock, frame);
                                timestamp = now;
                            }
                        } else {
                            timestamp = now;
                        }
                        continue;
                    }
                } else {
                    if (!sock.isDataAvailable(0ms)) {
                        int now = clock_getmillis() / 1000;
                        if (!update) {
                            if ((now - timestamp) >= heartbeat) {
                                binary frame = ws_encode_message(heartbeat_msg, WSOP_Ping);
                                @debug {
                                    if (h2_ws_debug_frames && frame.size() >= 2) {
                                        int b0 = frame[0];
                                        int b1 = frame[1];
                                        log(LoggerLevel::INFO,
                                            "HTTP/2 WS send frame: b0=0x%02x b1=0x%02x fin=%y op=%d masked=%y",
                                            b0, b1, (b0 & WS_FIN) != 0, b0 & 0x0f, (b1 & 0x80) != 0);
                                    }
                                }
                                sendFrame(wsc, sock, frame);
                                timestamp = now;
                            }
                        } else {
                            timestamp = now;
                        }

                        continue;
                    }
                    h = ws_read_message(sock, NOTHING, max_message_size);
                    have_frame = True;
                }
                if (!have_frame) {
                    continue;
                }

                # update ping timestamp if we have done WS I/O in a callback
                on_exit {
                    if (get_thread_data(tlk)) {
                        timestamp = clock_getmillis() / 1000;
                        delete_thread_data(tlk);
                    }
                }

                int state = wsc.gotRawMessage(h);
                if (state == WSC_Continue) {
                    continue;
                }
                if (state == WSC_Break) {
                    exit_reason = "handler-break";
                    break;
                }

                if (h.op == WSOP_Close) {
                    if (!h.close) {
                        logDebug("client sent OpClose without code; closing immediately");
                        exit_reason = "client-close-no-code";
                        break;
                    }
                    logDebug("client sent WSOP_Close code %d (%s): %s", h.close, WSCCMap.(h.close), h.msg);
                    sendClose(wsc, sock, h.close, h.msg);
                    exit_reason = "client-close";
                    break;
                }

                @debug(int b0);
                @debug(int b1);
                @debug(*hash<auto> info);
                @debug {
                    if (h2_ws_debug_frames) {
                    info = h.info;
                    b0 = info."b0" ?? -1;
                    b1 = info."b1" ?? -1;
                        log(LoggerLevel::INFO,
                            "HTTP/2 WS recv frame: b0=0x%02x b1=0x%02x fin=%y op=%d masked=%y rsv1=%y rsv2=%y rsv3=%y",
                            b0, b1, h.fin, h.op, h.masked, h.rsv1, h.rsv2, h.rsv3);
                    }
                }
                logDebug("received msg (%s: %d bytes%s%s): %s", WSOPMap{h.op} ?? "unknown", h.msg.size(),
                    h.masked ? " masked" : "", h.fin ? " FIN" : "", WebSocketHandler::getDataString(h.msg));

                if (!h.masked) {
                    if (!is_extended_connect) {
                        logError("unmasked client frame received");
                        sendClose(wsc, sock, WSCC_ProtocolError);
                        exit_reason = "protocol-error-unmasked";
                        break;
                    }
                    # HTTP/2 and HTTP/3 WebSocket frames are not masked (RFC 8441/9220)
                    logDebug("unmasked client frame received on %s WebSocket",
                        is_http3 ? "HTTP/3" : "HTTP/2");
                }

                # Validate RSV bits; control frames must not use RSV bits per RFC 6455 / RFC 7692
                bool any_rsv_set = h.rsv1 || h.rsv2 || h.rsv3;
                if (h.op == WSOP_Ping || h.op == WSOP_Pong || h.op == WSOP_Close) {
                    if (any_rsv_set) {
                        logError("invalid RSV bits on control frame: op=%d rsv1=%y rsv2=%y rsv3=%y",
                            h.op, h.rsv1, h.rsv2, h.rsv3);
                        sendClose(wsc, sock, WSCC_ProtocolError);
                        exit_reason = "protocol-error-rsv-control";
                        break;
                    }
                } else {
                    # For non-control frames, validate RSV bits against active extensions
                    if (!wsc.validateRsvBits(h.rsv1, h.rsv2, h.rsv3)) {
                        logError("invalid RSV bits received: rsv1=%y rsv2=%y rsv3=%y", h.rsv1, h.rsv2, h.rsv3);
                        sendClose(wsc, sock, WSCC_ProtocolError);
                        exit_reason = "protocol-error-rsv";
                        break;
                    }
                }

                # issue #2887 update timestamp for incoming traffic
                timestamp = clock_getmillis() / 1000;

                if (h.op == WSOP_Ping) {
                    sendFrame(wsc, sock, ws_encode_message(h.msg ?? "", WSOP_Pong));
                    continue;
                }

                # issue #2566: https://tools.ietf.org/html/rfc6455#section-5.5.3: we must ignore
                # unsolicited PONG messages
                if (h.op == WSOP_Pong) {
                    continue;
                }

                # issue #4073: handle fragmented frames
                if (!h.fin) {
                    if (!exists buf) {
                        if (h.op == WSOP_Text || h.op == WSOP_Binary) {
                            buf = h.msg;
                            # RFC 7692 Section 6.2.1: Store RSV bits from first frame
                            first_frame_rsv = {
                                "rsv1": h.rsv1,
                                "rsv2": h.rsv2,
                                "rsv3": h.rsv3,
                                "op": h.op,
                            };
                        } else {
                            logError("FIN bit not set but opcode is %d: %y", h.op, WSOPMap{h.op} ?? "unknown");
                            sendClose(wsc, sock, WSCC_ProtocolError);
                            exit_reason = "protocol-error-fin";
                            break;
                        }
                    } else {
                        if (h.op != WSOP_Continuation) {
                            logError("FIN bit not set with buffer of type %y but opcode is %d: %y", buf.type(), h.op,
                                WSOPMap{h.op} ?? "unknown");
                            sendClose(wsc, sock, WSCC_ProtocolError);
                            exit_reason = "protocol-error-continuation";
                            break;
                        } else {
                            if (buf.typeCode() == NT_STRING) {
                                buf += h.msg.toString();
                            } else {
                                buf += h.msg;
                            }
                        }
                    }
                    # Check accumulated message size against limit
                    if (max_message_size > 0 && buf.size() > max_message_size) {
                        logError("WebSocket message size %d exceeds maximum %d", buf.size(),
                            max_message_size);
                        sendClose(wsc, sock, WSCC_MessageTooBig,
                            sprintf("message size exceeds %d byte limit", max_message_size));
                        exit_reason = "message-too-large";
                        break;
                    }
                    continue;
                } else if (exists buf && h.op == WSOP_Continuation) {
                    bool is_text = buf.typeCode() == NT_STRING;
                    if (is_text) {
                        buf += h.msg.toString();
                    } else {
                        buf += h.msg;
                    }
                    auto msg = remove buf;
                    # RFC 7692 Section 6.2.1: Use RSV bits from first frame, not continuation
                    hash<auto> ext_ctx = {
                        "op": is_text ? WSOP_Text : WSOP_Binary,
                        "rsv1": h.rsv1,
                        "rsv2": h.rsv2,
                        "rsv3": h.rsv3,
                        "fin": h.fin,
                    };
                    if (first_frame_rsv) {
                        ext_ctx.op = first_frame_rsv.op ?? ext_ctx.op;
                        ext_ctx.rsv1 = first_frame_rsv.rsv1;
                        ext_ctx.rsv2 = first_frame_rsv.rsv2;
                        ext_ctx.rsv3 = first_frame_rsv.rsv3;
                        remove first_frame_rsv;
                    }
                    wsc.applyIncomingExtensions(\msg, ext_ctx);
                    wsc.validateIncomingMessage(\msg);
                    wsc.gotMessage(msg);
                    continue;
                } else if (h.op == WSOP_Text || h.op == WSOP_Binary) {
                    auto msg = h.msg;
                    # Apply incoming extension transforms
                    hash<auto> ext_ctx = {
                        "op": h.op,
                        "rsv1": h.rsv1,
                        "rsv2": h.rsv2,
                        "rsv3": h.rsv3,
                        "fin": h.fin,
                    };
                    wsc.applyIncomingExtensions(\msg, ext_ctx);
                    wsc.validateIncomingMessage(\msg);
                    wsc.gotMessage(msg);
                    continue;
                } else if (h.op == WSOP_Continuation) {
                    logError("FIN bit set with %d: %y opcode, but no data has been buffered", h.op,
                        WSOPMap{h.op} ?? "unknown");
                    sendClose(wsc, sock, WSCC_ProtocolError);
                    exit_reason = "protocol-error-continuation-without-buffer";
                    break;
                }

                # unrecognized opcode - close the connection
                sendClose(wsc, sock, WSCC_UnsupportedData);
                exit_reason = "unsupported-opcode";
                break;
            } catch (hash<ExceptionInfo> ex) {
                # error in websocket handler server, log and close the connection
                string err = sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc);
                logError(err);
                int close_code = ex.err == "WEBSOCKET-FRAME-TOO-LARGE"
                    ? WSCC_MessageTooBig
                    : WSCC_InternalServerError;
                try {
                    sendClose(wsc, sock, close_code, err);
                } catch (hash<ExceptionInfo> ex2) {
                    logError("failed to send close frame: %s: %s", ex2.err, ex2.desc);
                }
                exit_reason = ex.err == "WEBSOCKET-FRAME-TOO-LARGE"
                    ? "message-too-large"
                    : "exception";
                break;
            }
        }
        @debug {
            if (h2_ws_debug_handler) {
                log(LoggerLevel::INFO, "HTTP/2 WS handler exit: cid=%y reason=%y", cx.id, exit_reason);
            } else {
                logDebug("WebSocketHandler::startImpl() exiting, cid: %y reason: %y", cx.id, exit_reason);
            }
        }
        return False;
    }

    #! Flushes I/O in the connection channel
    /** @return True if any data was flushed, False if not
    */
    bool flushIo(WebSocketConnection wsc, Socket sock) {
        return flushIoIntern(wsc, sock, True);
    }

    private:internal bool flushIoIntern(WebSocketConnection wsc, Socket sock, bool update_tld) {
        bool rv;
        while (!wsc.stop_flag && exists (*binary d = wsc.pollDataImmediate())) {
            sendFrame(wsc, sock, d);
            if (d && !rv) {
                rv = True;
                if (update_tld) {
                    save_thread_data(tlk, True);
                }
            }
        }
        return rv ?? False;
    }

    #! called when a connection is established; the default implementation creates a WebSocketConnection object
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new WebSocketConnection(self);
    }

    #! called when a connection is established; registers the new connection internally
    WebSocketConnection doNewConnection(hash<auto> cx, hash<auto> hdr, string cid) {
        WebSocketConnection rv = getConnectionImpl(cx, hdr, cid);

        # add connection object to hash
        {
            rwl.writeLock();
            on_exit rwl.writeUnlock();
            ch{cid} = rv;
        }

        return rv;
    }

    #! called when the connection terminates; the default implementation does nothing
    deregisterConnectionImpl(WebSocketConnection wsc) {
    }

    #! sends a message to all connected clients
    /** @param d the data to send

        Connections without active extensions or an AsyncAPI validator share a single pre-encoded frame
        for efficiency.  Connections that need per-connection transforms (e.g., permessage-deflate) are
        encoded individually via @ref WebSocketHandler::WebSocketConnection::send()
        "WebSocketConnection::send()".

        @since WebSocketHandler 2.3 per-connection extension transforms are now properly applied
    */
    sendAll(data d) {
        rwl.readLock();
        on_exit rwl.readUnlock();

        # pre-encode once for connections that need no per-connection transforms
        *binary encoded;

        # push the data on all connection channels
        map (
            $1.needsPerConnectionEncoding()
                ? $1.send(d)
                : $1.sendEncoded(encoded ?? (encoded = ws_encode_message(d)))
        ), ch.iterator();

        #if (ch) logDebug("sending data to connections: %y", ch.keys());
    }

    #! sends a message to the given connection ID
    /** Websocket connections are identified by their HTTP connection ID as passed in
        \c WebSocketHandler::WebSocketHandler::handleRequest() "WebSocketHandler::handleRequest()" in the \c "cx.id"
        argument when the connection is first established.

        Messages are automatically encoded with @ref WebSocketUtil::ws_encode_message() before sending.
    */
    sendOne(softstring id, data d) {
        rwl.readLock();
        on_exit rwl.readUnlock();

        if (!exists ch{id})
            throw "WEBSOCKET-CONNECTION-ERROR", sprintf("connection %y does not exist (valid connections: %y)", id,
                keys ch);
        #logDebug("sending data to connection: %y", id);
        ch{id}.send(d);
    }

    #! stop given connection ID
    stopOne(softstring id) {
        rwl.readLock();
        on_exit rwl.readUnlock();

        if (!exists ch{id})
            throw "WEBSOCKET-CONNECTION-ERROR", sprintf("connection %y does not exist (valid connections: %y)", id,
                keys ch);
        #logDebug("stopping connection: %y", id);
        ch{id}.stop();
    }

    #! Called when a specific listener is stopped; signals all connections to wake up blocked threads
    /**
        ## Purpose

        This method is called by HttpListener::stop() when shutting down a specific listener.
        It ensures WebSocket connections don't block server shutdown by signaling them to exit.

        ## Deadlock Prevention

        WebSocket connections run in their own threads (startImpl loop) and may be blocked on:
        - pollData() waiting for messages to send (250ms timeout)
        - Socket I/O operations

        Without this method, the server shutdown sequence would hang waiting for these threads
        to notice the shutdown flag. By calling stop() on each connection, we:
        1. Set the connection's stop_flag to True
        2. Close the channel to wake up pollData() immediately

        @param lid the listener ID being stopped

        @see WebSocketConnection::stop() for how individual connections are signaled
    */
    private stopImpl(string lid) {
        # Mark this listener as stopped; connections check lsh{lid} in their main loop
        lsh{lid} = True;

        # Wake up connections for this listener immediately
        rwl.readLock();
        on_exit rwl.readUnlock();
        map $1.stop(), ch.iterator(), $1.getListenerId() == lid;
    }

    #! Called when the handler itself is stopped; signals all connections to wake up blocked threads
    /**
        ## Purpose

        This method is called when the WebSocketHandler is being removed or the server is
        shutting down. It ensures all WebSocket connections exit promptly.

        ## Shutdown Sequence

        This is called from HttpServer's handler cleanup, which happens after asyncIo.stop()
        and globalAsyncCtrl.stop(). At this point:
        1. No new connections can be accepted
        2. Existing connections need to be signaled to exit
        3. dThreads counter needs to reach zero for listener shutdown to complete

        @see stopAllConnections() for the actual signaling logic
    */
    private stopImpl() {
        stopAllConnections();
    }

    #! Signals all active WebSocket connections to stop and wake up blocked polling threads
    /**
        ## Implementation

        Iterates over all active connections (ch hash) and calls stop() on each.
        Uses a read lock since we're only reading the hash and calling methods on values.

        ## Thread Safety

        - Uses rwl.readLock() to allow concurrent access during iteration
        - Each connection's stop() is thread-safe
        - New connections can still be added during iteration (won't be signaled, but that's OK
          since they'll see the shutdown flags on their next loop iteration)

        ## WebSocketConnection::stop() Behavior

        For each connection, stop() does:
        1. Sets stop_flag = True (checked in startImpl's while loop)
        2. Closes the channel (wakes up pollData immediately)

        This ensures the startImpl loop will exit on its next iteration, allowing the
        connection thread to complete and decrement the dThreads counter.
    */
    private stopAllConnections() {
        rwl.readLock();
        on_exit rwl.readUnlock();
        map $1.stop(), ch.iterator();
    }

    private sendClose(WebSocketConnection wsc, Qore::Socket sock, int code, *string txtmsg) {
        if (!WSCCMap{code}) {
            logError("WebSocketHandler::sendClose(): invalid close code %d received; expecting one of: %y", code,
                (map $1.toInt(), WSCCMap.keyIterator()));
            code = WSCC_InternalServerError;
        }

        binary msg = code.encodeMsb(2);

        if (txtmsg)
            txtmsg = convert_encoding(txtmsg, "utf8");
        else
            txtmsg = WSCCMap{code};
        @debug {
            if (getenv("QORE_HTTP2_DEBUG")) {
                log(LoggerLevel::INFO, "HTTP/2 WS sendClose: code=%d reason=%y", code, txtmsg);
            }
        }
        msg += txtmsg;
        binary frame = ws_encode_message(msg, WSOP_Close);
        @debug {
            if (sock.isHttp2() && getenv("QORE_HTTP2_WS_DEBUG_FRAMES") && frame.size() >= 2) {
                int b0 = frame[0];
                int b1 = frame[1];
                log(LoggerLevel::INFO,
                    "HTTP/2 WS send frame: b0=0x%02x b1=0x%02x fin=%y op=%d masked=%y",
                    b0, b1, (b0 & WS_FIN) != 0, b0 & 0x0f, (b1 & 0x80) != 0);
            }
        }
        sendFrame(wsc, sock, frame);
    }

    private sendFrame(WebSocketConnection wsc, Socket sock, binary frame) {
        # HTTP/2 or HTTP/3 WebSocket: send via stream context with backpressure handling
        *AsyncSocketIo::AbstractStreamContext ctx = wsc.getStreamContext();
        if (ctx) {
            string proto = ctx.getProtocol();
            int flow_control_retry = 0;
            while (True) {
                try {
                    ctx.sendData(frame, False);
                    break;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "SOCKET-NOT-OPEN" || ex.err == "QUIC-ERROR"
                            || ex.err == "QUIC-HTTP3-ERROR") {
                        # QUIC-HTTP3-ERROR: Http3StreamContext.sendData() handles backpressure
                        # internally, so any error that escapes is fatal (e.g., session gone,
                        # stream reset)
                        wsc.stop();
                        return;
                    }
                    if (ex.err == "HTTP2-ERROR" && ex.desc =~ /no HTTP\/2 session active/) {
                        @debug {
                            logDebug("HTTP/2 WS sendFrame: stream session inactive; stopping connection");
                        }
                        wsc.stop();
                        return;
                    }
                    if (ex.err == "SOCKET-SSL-ERROR") {
                        logError("%s WS sendFrame: SSL error; stopping: %s", proto.upr(), ex.desc);
                        wsc.stop();
                        return;
                    }
                    if (ex.err == "HTTP2-FLOW-CONTROL") {
                        if (wsc.stop_flag || ++flow_control_retry > FlowControlMaxRetries) {
                            if (!wsc.stop_flag) {
                                logWarn("HTTP/2 WS sendFrame: backpressure after %d retries, frame dropped (%d bytes)",
                                    FlowControlMaxRetries, frame.size());
                            }
                            return;
                        }
                        # Pump I/O: flush outgoing buffer to TCP and read incoming HTTP/2 frames
                        # (including WINDOW_UPDATE) from the peer to free flow control window
                        try {
                            sock.isDataAvailable(FlowControlRetryMs);
                        } catch () {
                            # Socket error during I/O pump - next sendData() will detect and handle
                        }
                        continue;
                    }
                    throw ex.err, ex.desc, ex.arg;
                }
            }
            if (wsc.isAsyncMode() && wsc.getAsyncCtrl()) {
                wsc.getAsyncCtrl().wake();
            }
            return;
        }
        if (wsc.isAsyncMode()) {
            @assert(wsc.getAsyncCtrl(), "missing async controller for async mode WebSocket send");
            AbstractPollOperation op;
            try {
                op = sock.startPollSend(frame);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "SOCKET-NON-BLOCK-ERROR") {
                    # Another async send is already in progress on this socket.
                    # This can happen in HTTP/1.1 async mode when multiple threads or callbacks
                    # try to send frames concurrently (e.g., application message + control frame).
                    #
                    # WARNING: Dropping frames can cause protocol issues, especially for control frames
                    # (ping/pong/close). WebSocket clients may timeout waiting for pong responses or
                    # close acknowledgments.
                    #
                    # NOTE: HTTP/2 WebSocket doesn't have this issue since it uses a different code path
                    # (Http2StreamContext.sendData()) that handles multiplexing at the protocol level.
                    #
                    # A proper fix would require implementing a per-connection send queue and ensuring
                    # frames are sent in order after the current async operation completes. This is
                    # complex because exec() blocks waiting for the operation, so queued frames would
                    # need to be sent from the main I/O loop, not from within sendFrame().
                    log(LoggerLevel::WARN,
                        "WebSocketHandler::sendFrame(): async send already in progress; dropping frame "
                        "(size=%d bytes)", frame.size());
                    return;
                }
                throw ex.err, ex.desc, ex.arg;
            }
            hash<SocketPollResultInfo> result = wsc.getAsyncCtrl().exec(<SocketPollOperationInfo>{
                "sock": sock,
                "spop": op,
                "to": send_timeout,
                "owner": wsc.getOwnerId(),
                "other": {"goal": "ws-send"},
            });
            if (result.ex) {
                throw result.ex.err, result.ex.desc, result.ex.arg;
            }
            return;
        }
        sock.send2(frame, send_timeout);
    }

    static string getDataString(*data d) {
        if (!d)
            return "n/a";
        return sprintf("type: %s: %y", d.type(), d);
    }

    #! Negotiates extensions with the client
    /** @param client_header the client's Sec-WebSocket-Extensions header value

        @return a hash with the following keys:
        - \c extensions: list of negotiated extension objects
        - \c response_header: the Sec-WebSocket-Extensions response header value
        - \c rsv_mask: the combined RSV bit mask for all negotiated extensions

        @since WebSocketHandler 2.3
    */
    private *hash<auto> negotiateExtensions(*string client_header) {
        if (!extension_registry || !supported_extensions || !client_header) {
            return NOTHING;
        }

        # Parse client's extension offers
        list<hash<WsExtensionInfo>> client_extensions = WebSocketExtensionRegistry::parseExtensionHeader(client_header);
        if (!client_extensions) {
            return NOTHING;
        }

        list<AbstractWebSocketExtension> negotiated;
        list<string> response_parts;
        int rsv_mask = 0;

        foreach hash<WsExtensionInfo> ext_info in (client_extensions) {
            # Check if we support this extension
            if (!inlist_hard(ext_info.name, supported_extensions)) {
                continue;
            }

            # Try to create and negotiate the extension
            try {
                AbstractWebSocketExtension ext = extension_registry.createExtension(ext_info.name);
                *string response = ext.negotiateServerResponse(ext_info.params);
                if (response.val()) {
                    negotiated += ext;
                    response_parts += response;
                    rsv_mask |= ext.getRsvBits();
                }
            } catch (hash<ExceptionInfo> ex) {
                logDebug("Extension %y negotiation failed: %s", ext_info.name, ex.desc);
            }
        }

        if (!negotiated) {
            return NOTHING;
        }

        return {
            "extensions": negotiated,
            "response_header": response_parts.join(", "),
            "rsv_mask": rsv_mask,
        };
    }

    #! Returns True if extension support is enabled
    /** @return True if extensions are configured, False otherwise

        @since WebSocketHandler 2.3
    */
    bool hasExtensionSupport() {
        return extension_registry.val() && supported_extensions.val();
    }

    #! Returns the list of supported extension names
    /** @return list of supported extension names or NOTHING if no extensions are configured

        @since WebSocketHandler 2.3
    */
    *list<string> getSupportedExtensions() {
        return supported_extensions;
    }

    #! Log to the logger
    logInfo(string fmt, ...) {
        logArgs(LoggerLevel::INFO, fmt, argv);
    }

    #! Log to the logger
    logError(string fmt, ...) {
        logArgs(LoggerLevel::ERROR, fmt, argv);
    }

    #! Log to the logger
    logWarn(string fmt, ...) {
        logArgs(LoggerLevel::WARN, fmt, argv);
    }

    #! Log to the logger
    logDebug(string fmt, ...) {
        logArgs(LoggerLevel::DEBUG, fmt, argv);
    }
}
}
