%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires OpenAiRestClient
%requires QoreLlmTypes
%requires QoreRagTypes

module MistralRestClient {
    version = "1.0";
    desc = "user module for calling Mistral AI REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("mistral",
            MistralRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(
            new MistralLlmProviderFactory());
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new MistralEmbedderFactory());
    };
}

/** @mainpage MistralRestClient Module

    @tableofcontents

    @section mistralrestclientintro MistralRestClient Introduction

    The %MistralRestClient module provides an API for calling
    [Mistral AI](https://mistral.ai) REST services — chat, embeddings,
    and document OCR.

    Mistral exposes an OpenAI-compatible chat-completions API at
    `/v1/chat/completions`, an embeddings endpoint at `/v1/embeddings`,
    and a dedicated document-OCR endpoint at `/v1/ocr` that converts
    PDFs and images into structured markdown.

    @par Example:
    @code{.py}
#!/usr/bin/env qore
%modern
%requires MistralRestClient

MistralRestClient rest({"apikey": api_key});
hash<auto> ans = rest.post("/v1/chat/completions", {
    "model": "mistral-large-latest",
    "messages": ({"role": "user", "content": "Hello!"},),
});
printf("%Y\n", ans.body);
    @endcode

    @note The OCR endpoint is exposed via the
    @ref mistraldataproviderintro "MistralDataProvider"'s `ocr` action.
    Integration with @ref qoreocrutilsintro "QoreOcrUtils"'s engine
    abstraction is planned for a follow-up release once
    \c QoreOcrUtils gains a pluggable backend registry.

    @section MistralRestClientRelnotes Release Notes

    @subsection MistralRestClientv1_0 MistralRestClient v1.0
    - the initial version of the %MistralRestClient module
*/

%requires json

public namespace MistralRestClient {
public class MistralRestClientBase {
    public {
        const DefaultUrl = "https://api.mistral.ai";

        const DefaultApiVersion = "v1";

        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        if (opts.api) {
            rv.default_path = "/" + opts.api;
        }
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Mistral AI REST API (sync)
public class MistralRestClient inherits RestClient::RestClient, MistralRestClientBase {
    private {
        string api;
    }

    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(MistralRestClientBase::getOptions(opts), True) {
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(getString(opts, "api") ?? DefaultApiVersion);
        }
    }
}

#! REST client for Mistral AI REST API using multiplexed HTTP connections
public class MistralRestClientIo inherits RestClientIo::RestClientIo, MistralRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(MistralRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Mistral AI REST connections
public class MistralRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "mistral://api.mistral.ai";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Mistral AI REST Connection",
            "short_desc": "A connection to the Mistral AI REST API",
            "desc": "A connection to the [Mistral AI](https://mistral.ai) REST API for chat "
                "(Mistral Large/Small/Nemo), embeddings (mistral-embed), and document OCR "
                "(`mistral-ocr`).\n\n"
                "Requires an API key for Bearer authentication.  Get your API key from the "
                "[Mistral Console](https://console.mistral.ai/api-keys/).",
            "cls": Class::forName("MistralRestConnection"),
            "auto_url": True,
            "schemes": {"mistral": True},
            "base_scheme_map": {"https": "mistral"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Mistral AI API key for authentication",
                    "type": "string",
                    "desc": "The Mistral AI API key used for Bearer authentication.",
                    "sensitive": True,
                    "preselected": True,
                },
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "The API version to use",
                    "desc": "The API version to use.",
                    "type": "string",
                    "default_value": MistralRestClientBase::DefaultApiVersion,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": DefaultPingPath,
                },
            },
            "required_options": "apikey",
        };

        const DefaultPingMethod = "GET";
        const DefaultPingHeaders = {"Accept": MimeTypeJson};
        const DefaultPingPath = "models";
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "mistral";
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("MistralDataProvider");
        return create_object("MistralDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private MistralRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new MistralRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new MistralRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return MistralRestClientBase::getOptions(rv);
    }
}

#! LLM provider for Mistral AI
/** Mistral serves an OpenAI-compatible chat-completions endpoint at
    \c /v1/chat/completions on \c https://api.mistral.ai, so this
    provider reuses @ref OpenAiRestClient::OpenAiLlmProvider for body
    construction, response parsing, and SSE streaming.
*/
public class MistralLlmProvider inherits OpenAiRestClient::OpenAiLlmProvider {
    public {
        const DefaultUrl = "https://api.mistral.ai";
    }

    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : OpenAiRestClient::OpenAiLlmProvider(
                MistralRestClient::applyMistralDefaults(config)) {
    }

    string getMode() {
        return "mistral";
    }
}

#! Namespace-local helper: returns config with the default Mistral URL applied
hash<QoreLlmUtils::LlmBackendConfig> sub applyMistralDefaults(
        hash<QoreLlmUtils::LlmBackendConfig> config) {
    if (!config.url.val()) {
        config.url = MistralLlmProvider::DefaultUrl;
    }
    return config;
}

#! Factory for @ref MistralLlmProvider
public class MistralLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "mistral";
    }

    string getDisplayName() {
        return "Mistral AI chat completions";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new MistralLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
        };
    }
}
}

public namespace QoreRagUtils {
#! Mistral AI-backed embedder — calls the Mistral `/embeddings` endpoint
public class MistralEmbedder inherits AbstractEmbedder {
    public {
        const DefaultModel = "mistral-embed";
        const Backend = "mistral";
    }

    private {
        hash<EmbedderConfig> config;
        string model_name;
        *MistralRestClient::MistralRestClientIo rest_client;
        *int cached_dimension;
        Mutex init_mutex();
    }

    constructor(hash<EmbedderConfig> config) {
        if (!config.api_key.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "MistralEmbedder requires 'api_key' in EmbedderConfig";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }
        hash<auto> body = {
            "model": model_name,
            "input": texts,
        };

        hash<auto> resp = pickRestClient(opts).restPost("/embeddings", body);

        *list<auto> data = resp.body.data;
        if (!exists data) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing 'data' field", Backend),
                {"body": resp.body};
        }
        if (data.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned %d items for %d input texts",
                    Backend, data.size(), texts.size()),
                {"body": resp.body};
        }
        list<hash<auto>> sorted_data = sort(cast<list<hash<auto>>>(data),
            int sub(hash<auto> a, hash<auto> b) {
                return a."index" <=> b."index";
            });
        list<list<float>> result = ();
        foreach hash<auto> item in (sorted_data) {
            list<float> vec = validateAndCastVector(item.embedding, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = vec.size();
            }
            push result, vec;
        }
        return result;
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    *string getModel() {
        return model_name;
    }

    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw || raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    private MistralRestClient::MistralRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new MistralRestClient::MistralRestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "apikey": config.api_key,
        };
        if (config.url.val()) {
            opts.url = config.url;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new MistralRestClient::MistralRestClientIo(
                    buildRestOptions());
            }
        }
    }
}

#! Factory for @ref MistralEmbedder
public class MistralEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "mistral";
    }

    string getDisplayName() {
        return "Mistral AI embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new MistralEmbedder(config);
    }
}
}
