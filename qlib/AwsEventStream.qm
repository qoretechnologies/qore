%requires qore >= 2.0
%modern

module AwsEventStream {
    version = "1.1";
    desc = "AWS event-stream binary frame encoder and decoder for Bedrock, "
        "Kinesis, S3 Select, and Transcribe streaming";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage AwsEventStream Module

    @tableofcontents

    @section awseventstreamintro Introduction to the AwsEventStream Module

    The %AwsEventStream module encodes and decodes the **AWS event-stream binary framing
    format** used by Bedrock's \c InvokeModelWithResponseStream, Kinesis
    SubscribeToShard, S3 Select, and Transcribe streaming endpoints.

    Each message is framed as:
    @verbatim
+-------------------------+
|  Prelude (12 bytes)     |
|    Total length   (4)   | big-endian uint32, includes prelude + headers + payload + 4-byte CRC
|    Headers length (4)   | big-endian uint32, length of the headers block
|    Prelude CRC32  (4)   | big-endian CRC32 over the first 8 bytes
+-------------------------+
|  Headers (variable)     | sequence of (1B name-len, name UTF-8, 1B type, value)
+-------------------------+
|  Payload (variable)     | size = total_length - 16 - headers_length
+-------------------------+
|  Message CRC32 (4)      | big-endian CRC32 over the entire message excluding this final CRC
+-------------------------+
    @endverbatim

    Header value types are decoded for the families used by Bedrock + Kinesis:
    bool true/false, byte, short, integer, long, byte-array, string, timestamp
    (epoch ms), and UUID.

    @par Streaming usage

    @code{.py}
%requires AwsEventStream

AwsEventStreamDecoder dec();

while (binary chunk = read_next_http_chunk()) {
    dec.feed(chunk);
    while (*hash<AwsEventStreamFrame> f = dec.nextFrame()) {
        # f.headers — hash of header name -> typed value
        # f.payload — raw binary payload (typically UTF-8 JSON)
        on_frame(f);
    }
}
dec.finish();  # reject truncated data at EOF
    @endcode

    @section awseventstreamrelnotes Release Notes

    @subsection awseventstream_v1_1 AwsEventStream v1.1
    - adds stateless encoding of messages and typed headers for signed bidirectional streams
    - validates protocol size limits, duplicate headers, truncated header values, and partial frames at EOF

    @subsection awseventstream_v1_0 AwsEventStream v1.0
    - initial release: prelude + header + payload + CRC32 validation
*/

#! Contains all public definitions in the AwsEventStream module
public namespace AwsEventStream {
#! A single AWS event-stream frame
public hashdecl AwsEventStreamFrame {
    #! Header name to decoded value (per AWS header type encoding)
    hash<string, auto> headers;
    #! Frame payload (caller's responsibility to interpret per the headers)
    binary payload;
}

#! Maximum event payload size accepted by the AWS event-stream protocol
public const EventStreamMaxPayload = 24 * 1024 * 1024;
#! Maximum encoded header block size accepted by the AWS event-stream protocol
public const EventStreamMaxHeaders = 128 * 1024;

#! Encodes AWS event-stream messages, including the two CRC checksums
/** Header types are inferred from Qore values: boolean, signed 64-bit integer, binary, UTF-8 string,
    or absolute date (millisecond timestamp). Instances are unnecessary; all methods are stateless.

    @par Example
    Encode a model input chunk before transmitting it over an authenticated bidirectional connection:
    @code{.py}
binary frame = AwsEventStreamEncoder::encode({":message-type": "event", ":event-type": "chunk"}, payload);
    @endcode
*/
public class AwsEventStreamEncoder {
    #! Encodes one complete message
    /** @param headers typed message headers
        @param payload raw payload bytes
        @return the complete binary frame
        @throw AWS-EVENT-STREAM-FORMAT-ERROR invalid header values or protocol size limits
    */
    static binary encode(hash<string, auto> headers, binary payload) {
        if (payload.size() > EventStreamMaxPayload) {
            throw "AWS-EVENT-STREAM-FORMAT-ERROR", "event payload exceeds 24 MiB";
        }
        binary hb = encodeHeaders(headers);
        binary prelude = integerBytes(16 + hb.size() + payload.size(), 4) + integerBytes(hb.size(), 4);
        binary frame = prelude + integerBytes(AwsEventStreamDecoder::crc32(prelude), 4) + hb + payload;
        return frame + integerBytes(AwsEventStreamDecoder::crc32(frame), 4);
    }

    #! Encodes headers in insertion order, also used when signing event headers
    /** @param headers typed message headers
        @return the encoded header block
        @throw AWS-EVENT-STREAM-FORMAT-ERROR invalid names, values, or header block size
    */
    static binary encodeHeaders(hash<string, auto> headers) {
        binary result = binary();
        foreach hash<auto> item in (headers.pairIterator()) {
            binary name = binary(string(item.key, "UTF-8"));
            if (!name.size() || name.size() > 255) {
                throw "AWS-EVENT-STREAM-FORMAT-ERROR", "header names must contain 1 to 255 UTF-8 bytes";
            }
            result += integerBytes(name.size(), 1) + name;
            switch (item.value.typeCode()) {
                case NT_BOOLEAN:
                    result += item.value ? <00> : <01>;
                    break;
                case NT_INT:
                    result += <05> + integerBytes(item.value, 8);
                    break;
                case NT_DATE:
                    if (item.value.relative()) {
                        throw "AWS-EVENT-STREAM-FORMAT-ERROR", "event timestamps must be absolute dates";
                    }
                    result += <08> + integerBytes(item.value.getEpochSeconds() * 1000
                        + item.value.milliseconds(), 8);
                    break;
                case NT_STRING:
                case NT_BINARY: {
                    binary value = item.value.typeCode() == NT_BINARY
                        ? item.value : binary(string(item.value, "UTF-8"));
                    if (value.size() > 65535) {
                        throw "AWS-EVENT-STREAM-FORMAT-ERROR", "header value exceeds 65535 bytes";
                    }
                    result += (item.value.typeCode() == NT_BINARY ? <06> : <07>)
                        + integerBytes(value.size(), 2) + value;
                    break;
                }
                default:
                    throw "AWS-EVENT-STREAM-FORMAT-ERROR", "unsupported event header value type: "
                        + item.value.type();
            }
            if (result.size() > EventStreamMaxHeaders) {
                throw "AWS-EVENT-STREAM-FORMAT-ERROR", "event headers exceed 128 KiB";
            }
        }
        return result;
    }

    #! Encodes a fixed-width big-endian integer
    private static binary integerBytes(int value, int width) {
        binary result = binary();
        for (int bit_offset = (width - 1) * 8; bit_offset >= 0; bit_offset -= 8) {
            result += chr((value >> bit_offset) & 255).toBinary();
        }
        return result;
    }
}

#! Streaming decoder for the AWS event-stream binary framing format
/** Instances buffer partial bytes between @ref feed() calls so HTTP chunks
    don't have to align on frame boundaries.  Each successful
    @ref nextFrame() returns one frame and removes its bytes from the
    internal buffer.

    This class is **not** thread-safe — drive it from a single decoder
    thread per HTTP response stream.

    @par CRC validation

    Both the prelude CRC (over the first 8 bytes) and the message CRC (over
    the entire frame except the final 4 bytes) are validated on every
    frame.  Mismatches throw \c AWS-EVENT-STREAM-CRC-ERROR with the
    expected vs computed values.
*/
public class AwsEventStreamDecoder {
    public {
        #! Size of the fixed prelude (total-len + headers-len + prelude CRC)
        const PreludeSize = 12;
        #! Trailing message CRC32 size
        const MessageCrcSize = 4;
    }

    private {
        #! Internal buffer of bytes received but not yet emitted as a frame
        binary buf = binary();
    }

    private:internal {
        #! CRC-32 lookup table (lazily populated by @ref buildCrcTable())
        static list<int> crc_table = ();
        #! Has the CRC-32 table been built yet?
        static bool crc_table_built = False;
        #! Serializes lazy CRC table construction
        static Mutex crc_lock();
    }

    #! Appends bytes to the internal buffer
    /** @param chunk the next chunk of bytes from the HTTP response body
    */
    feed(binary chunk) {
        if (chunk && chunk.size()) {
            buf += chunk;
        }
    }

    #! Returns the next decoded frame, or NOTHING if the buffer is incomplete
    /** @return a populated @ref AwsEventStreamFrame, or @ref nothing if the
            buffer doesn't yet contain a full frame; the caller should
            @ref feed() more bytes and try again

        @throw AWS-EVENT-STREAM-CRC-ERROR the prelude or message CRC failed
        @throw AWS-EVENT-STREAM-FORMAT-ERROR a header could not be decoded
            or the total length is implausible
    */
    *hash<AwsEventStreamFrame> nextFrame() {
        if (buf.size() < PreludeSize) {
            return NOTHING;
        }
        int total_len    = AwsEventStreamDecoder::readU32BE(buf, 0);
        int headers_len  = AwsEventStreamDecoder::readU32BE(buf, 4);
        int prelude_crc  = AwsEventStreamDecoder::readU32BE(buf, 8);
        if (total_len < PreludeSize + MessageCrcSize) {
            throw "AWS-EVENT-STREAM-FORMAT-ERROR",
                sprintf("invalid total length %d (must be at least %d)",
                    total_len, PreludeSize + MessageCrcSize);
        }
        if (headers_len < 0
                || headers_len > total_len - PreludeSize - MessageCrcSize) {
            throw "AWS-EVENT-STREAM-FORMAT-ERROR",
                sprintf("invalid headers length %d for total %d",
                    headers_len, total_len);
        }
        if (headers_len > EventStreamMaxHeaders || total_len - headers_len - 16 > EventStreamMaxPayload) {
            throw "AWS-EVENT-STREAM-FORMAT-ERROR", "event frame exceeds protocol size limits";
        }
        int computed_prelude_crc = AwsEventStreamDecoder::crc32(buf[0..7]);
        if (computed_prelude_crc != prelude_crc) {
            throw "AWS-EVENT-STREAM-CRC-ERROR",
                sprintf("prelude CRC mismatch: expected 0x%08x got 0x%08x",
                    prelude_crc, computed_prelude_crc);
        }
        if (buf.size() < total_len) {
            return NOTHING;
        }

        int msg_crc = AwsEventStreamDecoder::readU32BE(buf, total_len - 4);
        int computed_msg_crc =
            AwsEventStreamDecoder::crc32(buf[0..total_len - 5]);
        if (computed_msg_crc != msg_crc) {
            throw "AWS-EVENT-STREAM-CRC-ERROR",
                sprintf("message CRC mismatch: expected 0x%08x got 0x%08x",
                    msg_crc, computed_msg_crc);
        }

        hash<string, auto> headers = {};
        int hpos = PreludeSize;
        int hend = PreludeSize + headers_len;
        while (hpos < hend) {
            int name_len = get_byte(buf, hpos);
            hpos += 1;
            if (!name_len || hpos + name_len >= hend) {
                throw "AWS-EVENT-STREAM-FORMAT-ERROR",
                    "header name extends past headers block";
            }
            string name = AwsEventStreamDecoder::bytesToString(
                buf[hpos..hpos + name_len - 1]);
            if (exists headers{name}) {
                throw "AWS-EVENT-STREAM-FORMAT-ERROR", "duplicate event header: " + name;
            }
            hpos += name_len;
            int type_tag = get_byte(buf, hpos);
            hpos += 1;
            auto value;
            (value, hpos) = AwsEventStreamDecoder::readHeaderValue(buf,
                hpos, type_tag, hend);
            headers{name} = value;
        }

        int payload_start = hend;
        int payload_end = total_len - MessageCrcSize - 1;
        binary payload = payload_end >= payload_start
            ? buf[payload_start..payload_end]
            : binary();

        buf = buf.size() > total_len ? buf[total_len..buf.size() - 1] : binary();
        return <AwsEventStreamFrame>{
            "headers": headers,
            "payload": payload,
        };
    }

    #! Returns the current internal buffer size (for diagnostics / tests)
    /** @return the number of unconsumed bytes */
    int getBufferSize() {
        return buf.size();
    }

    #! Verifies that the stream ended on a frame boundary after draining nextFrame()
    /** @throw AWS-EVENT-STREAM-FORMAT-ERROR unconsumed or truncated frame bytes remain */
    finish() {
        if (buf.size()) {
            throw "AWS-EVENT-STREAM-FORMAT-ERROR", sprintf("stream ended with %d unconsumed frame bytes", buf.size());
        }
    }

    #! Reads a big-endian unsigned 32-bit int from \a b at offset \a off
    private:internal static int readU32BE(binary b, int off) {
        return (get_byte(b, off) << 24)
            | (get_byte(b, off + 1) << 16)
            | (get_byte(b, off + 2) << 8)
            | get_byte(b, off + 3);
    }

    #! Reads a big-endian signed 32-bit int from \a b at offset \a off
    private:internal static int readI32BE(binary b, int off) {
        int v = AwsEventStreamDecoder::readU32BE(b, off);
        return v >= 0x80000000 ? v - 0x100000000 : v;
    }

    #! Reads a big-endian unsigned 16-bit int from \a b at offset \a off
    private:internal static int readU16BE(binary b, int off) {
        return (get_byte(b, off) << 8) | get_byte(b, off + 1);
    }

    #! Reads a big-endian signed 16-bit int from \a b at offset \a off
    private:internal static int readI16BE(binary b, int off) {
        int v = AwsEventStreamDecoder::readU16BE(b, off);
        return v >= 0x8000 ? v - 0x10000 : v;
    }

    #! Reads a big-endian signed 64-bit int from \a b at offset \a off
    private:internal static int readI64BE(binary b, int off) {
        # qore int is 64-bit signed, so the assembled value already carries
        # the correct sign for two's-complement input
        int hi = AwsEventStreamDecoder::readU32BE(b, off);
        int lo = AwsEventStreamDecoder::readU32BE(b, off + 4);
        return (hi << 32) | lo;
    }

    #! Decodes a single header value at \a off; returns (value, new_off)
    private:internal static list<auto> readHeaderValue(binary b, int off,
            int type_tag, int hend) {
        const list<int> Widths = (0, 0, 1, 2, 4, 8, 2, 2, 8, 16);
        if (type_tag < 0 || type_tag >= Widths.size() || off + Widths[type_tag] > hend) {
            throw "AWS-EVENT-STREAM-FORMAT-ERROR", "invalid or truncated event header value";
        }
        switch (type_tag) {
            case 0: # bool true
                return (True, off);
            case 1: # bool false
                return (False, off);
            case 2: { # int8
                int v = get_byte(b, off);
                if (v >= 0x80) {
                    v -= 0x100;
                }
                return (v, off + 1);
            }
            case 3: # int16
                return (AwsEventStreamDecoder::readI16BE(b, off), off + 2);
            case 4: # int32
                return (AwsEventStreamDecoder::readI32BE(b, off), off + 4);
            case 5: # int64
                return (AwsEventStreamDecoder::readI64BE(b, off), off + 8);
            case 6: { # byte array (uint16 BE length + N bytes)
                int len = AwsEventStreamDecoder::readU16BE(b, off);
                off += 2;
                if (off + len > hend) {
                    throw "AWS-EVENT-STREAM-FORMAT-ERROR",
                        "byte-array header extends past headers block";
                }
                binary v = len > 0 ? b[off..off + len - 1] : binary();
                return (v, off + len);
            }
            case 7: { # string (uint16 BE length + N bytes UTF-8)
                int len = AwsEventStreamDecoder::readU16BE(b, off);
                off += 2;
                if (off + len > hend) {
                    throw "AWS-EVENT-STREAM-FORMAT-ERROR",
                        "string header extends past headers block";
                }
                string v = len > 0
                    ? AwsEventStreamDecoder::bytesToString(b[off..off + len - 1])
                    : "";
                return (v, off + len);
            }
            case 8: { # timestamp (int64 ms since epoch)
                int ms = AwsEventStreamDecoder::readI64BE(b, off);
                # qore date constructor accepts milliseconds via 1970-01-01 + Nms
                date v = 1970-01-01Z + milliseconds(ms);
                return (v, off + 8);
            }
            case 9: { # uuid (16 bytes)
                if (off + 16 > hend) {
                    throw "AWS-EVENT-STREAM-FORMAT-ERROR",
                        "uuid header extends past headers block";
                }
                # render as canonical 8-4-4-4-12 lowercase hex form
                binary raw = b[off..off + 15];
                string hex = AwsEventStreamDecoder::binToHex(raw);
                string v = sprintf("%s-%s-%s-%s-%s",
                    hex[0..7], hex[8..11], hex[12..15], hex[16..19], hex[20..31]);
                return (v, off + 16);
            }
            default:
                throw "AWS-EVENT-STREAM-FORMAT-ERROR",
                    sprintf("unknown header value type %d at offset %d",
                        type_tag, off - 1);
        }
    }

    #! Returns the lowercase hex string for the given binary blob
    private:internal static string binToHex(binary b) {
        string s = "";
        for (int i = 0; i < b.size(); ++i) {
            s += sprintf("%02x", get_byte(b, i));
        }
        return s;
    }

    #! Decodes a UTF-8 string from a binary blob
    private:internal static string bytesToString(binary b) {
        return b.toString("UTF-8");
    }

    #! Computes the CRC-32 (reflected, polynomial 0xEDB88320) of \a b
    /** Public so external tests can verify fixture round-tripping and other
        AWS-services callers (Kinesis, S3 Select) can sign frames they emit.
        Cached internal lookup table is built on first call.
        @param b bytes to checksum
        @return unsigned 32-bit CRC value
    */
    static int crc32(binary b) {
        list<int> table = AwsEventStreamDecoder::getCrcTable();
        int crc = 0xFFFFFFFF;
        for (int i = 0; i < b.size(); ++i) {
            int idx = (crc ^ get_byte(b, i)) & 0xFF;
            crc = ((crc >> 8) & 0xFFFFFFFF) ^ table[idx];
        }
        return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
    }

    #! Returns the lazily-built CRC-32 lookup table (one entry per byte value)
    private:internal static list<int> getCrcTable() {
        if (!crc_table_built) {
            AwsEventStreamDecoder::buildCrcTable();
        }
        return crc_table;
    }

    #! Builds the CRC-32 lookup table (called once)
    private:internal static buildCrcTable() {
        crc_lock.lock();
        on_exit crc_lock.unlock();
        if (crc_table_built) {
            return;
        }
        list<int> tbl = ();
        for (int n = 0; n < 256; ++n) {
            int c = n;
            for (int k = 0; k < 8; ++k) {
                if (c & 1) {
                    c = ((c >> 1) & 0xFFFFFFFF) ^ 0xEDB88320;
                } else {
                    c = (c >> 1) & 0xFFFFFFFF;
                }
            }
            push tbl, c;
        }
        crc_table = tbl;
        crc_table_built = True;
    }
}
}
