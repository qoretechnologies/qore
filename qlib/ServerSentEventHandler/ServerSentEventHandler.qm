# minimum Qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings
%modern
%allow-weak-references

%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires Util
%requires(reexport) Logger
%requires Mime
%requires(reexport) DataProvider
%requires AsyncApi >= 1.0

%requires json

module ServerSentEventHandler {
    version = "1.2.0";
    desc = "User module for handling SSE connections";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage ServerSentEventHandler Module

    @tableofcontents

    @section serversenteventhandlerintro Introduction to the ServerSentEventHandler Module

    The %ServerSentEventHandler module provides a handler to be used with the
    <a href="../../HttpServer/html/index.html">HttpServer module</a> to provide
    <a href="https://html.spec.whatwg.org/multipage/server-sent-events.html">Server-Sent Event</a> connections.

    To use this module, use \c "%requires ServerSentEventHandler" and \c "%requires HttpServer" in your code.

    All the public symbols in the module are defined in the ServerSentEventHandler namespace.

    The main classes provided in this module are:
    - @ref ServerSentEventHandler::ServerSentEventConnection
    - @ref ServerSentEventHandler::ServerSentEventHandler
    - @ref ServerSentEventHandler::SseObservableBridge — serves an SSE stream
      backed by any @ref DataProvider::Observable "Observable"; the
      @ref ServerSentEventHandler::sseObservableResponse() helper wraps
      bridge construction for use from REST / HTTP handlers

    @par AsyncAPI Validation Example
    @code{.py}
%requires ServerSentEventHandler

hash<HttpHandlerResponseInfo> getEvents(hash<auto> cx, *hash<auto> ah) {
    DataProvider::Observable source = getEventSource(ah.id);
    return ServerSentEventHandler::sseObservableResponse(source, {
        "event_ids": ("progress", "done"),
        "terminate_on": "done",
        "asyncapi": "file:///opt/schemas/sse-events.yaml",
        "asyncapi_channel": "events",
    });
}
    @endcode

    @section serversenteventhandler_relnotes ServerSentEventHandler Release History

    @subsection serversenteventhandler_v1_2_0 Version 1.2.0
    - added a per-connection outbound queue limit (the \c max_queue_size handler option and
      @ref ServerSentEventHandler::ServerSentEventHandler::setMaxQueueSize() "setMaxQueueSize()"): a slow or
      non-reading client whose outbound event queue reaches the limit is dropped instead of growing server memory
      without bound; protects servers exposed to untrusted clients

    @subsection serversenteventhandler_v1_1_0 Version 1.1.0
    - added AsyncAPI 3.0 validation support for outbound SSE event data via the \c asyncapi,
      \c validator, and \c asyncapi_channel handler and bridge options
    - added @ref ServerSentEventHandler::SseObservableBridge and the
      @ref ServerSentEventHandler::sseObservableResponse() helper to stream
      the events of any @ref DataProvider::Observable "Observable" as an
      SSE response from a REST handler (or any other handler that returns
      an @ref HttpServer::HttpHandlerResponseInfo "HttpHandlerResponseInfo"),
      with no extra threads required

    @subsection serversenteventhandler_v1_1 Version 1.1
    - added @ref ServerSentEventHandler::ServerSentEventHandler::setupAsyncSseConnection()
      "ServerSentEventHandler::setupAsyncSseConnection()" for async SSE connection setup via the
      I/O controller, replacing the legacy synchronous \c startImpl() entry point
    - \c startImpl() now throws \c SSE-SYNC-NOT-SUPPORTED; all SSE connections are managed by
      the async I/O controller
    - async SSE heartbeats are enabled by default across HTTP/1.x, HTTP/2, and
      HTTP/3; set the handler \c heartbeat option to \c 0 to opt out

    @subsection serversenteventhandler_v1_0_2 Version 1.0.2
    - added support for customizable heartbeat messages to support JSON-RPC requests as heartbeat message in MCP
      server handlers
     (<a href="https://github.com/qoretechnologies/qore/issues/4958">issue 4958</a>)

    @subsection serversenteventhandler_v1_0_1 Version 1.0.1
    - More flexible SSE handler support

    @subsection serversenteventhandler_v1_0 Version 1.0
    - the initial version of the ServerSentEventHandler module
*/

#! the ServerSentEventHandler namespace contains all the objects in the ServerSentEventHandler module
public namespace ServerSentEventHandler {
}
