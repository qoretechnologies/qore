%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) ChromaRestClient
%requires RestClientIo

module ChromaDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Chroma vector store";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new ChromaDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ChromaDataProvider::AppName,
            "display_name": "Chroma",
            "short_desc": "Chroma local-first vector database for self-hosted RAG",
            "desc": "Provides access to [Chroma](https://www.trychroma.com) — a lightweight, "
                "local-first vector database that pairs naturally with local Ollama "
                "embeddings for fully self-hosted RAG.\n\n"
                "**Common use cases**:\n"
                "- **Local-first RAG** without per-token billing or data egress\n"
                "- **Development and testing** vector stores before scaling to managed "
                "vector DBs (Pinecone, Weaviate, Milvus)\n"
                "- **Air-gapped deployments** where cloud APIs are not an option",
            "scheme": "chroma",
            "logo": ChromaLogo,
            "logo_file_name": "chroma-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Databases,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ChromaDataProvider::AppName,
            "path": "/query",
            "action": "vector-search",
            "display_name": "Vector Search",
            "short_desc": "Search a Chroma collection by query vector",
            "desc": "Searches a Chroma collection for the K most similar vectors to a query "
                "embedding via `/api/v2/.../collections/{id}/query`.  Returns ids, distances, "
                "and metadata in Chroma's nested-list response format.",
            "action_code": DPAT_API,
            "groups": ("Vector Search",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ChromaQueryRequestDataType::Fields{"collection_id", "query_embeddings",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ChromaQueryRequestDataType::Fields{"n_results", "where",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ChromaQueryRequestDataType::Fields - (
                    "collection_id", "query_embeddings", "n_results", "where",
                )
            ),
            "output_type": ChromaQueryDataProvider::ResponseType,
        });
    };
}

/** @mainpage ChromaDataProvider Module

    @tableofcontents

    @section chromadataproviderintro ChromaDataProvider Introduction

    The %ChromaDataProvider module provides a data provider API for
    [Chroma](https://www.trychroma.com) vector databases.

    The following data providers are exposed:
    - @ref ChromaDataProvider::ChromaDataProvider "ChromaDataProvider" — root
    - @ref ChromaDataProvider::ChromaQueryDataProvider "ChromaQueryDataProvider" — vector search

    For full upsert / delete operations, use the
    @ref QoreRagUtils::ChromaVectorStore "ChromaVectorStore" backend
    in @ref qorerragutilsintro "QoreRagUtils" via the standard
    @ref QoreRagUtils::RagPipeline "RagPipeline" — that's the supported
    ingest/retrieve path.

    @section ChromaDataProviderRelnotes Release Notes

    @subsection ChromaDataProviderv1_0 ChromaDataProvider v1.0
    - the initial version of the %ChromaDataProvider module
*/

#! contains all public definitions in the ChromaDataProvider module
public namespace ChromaDataProvider {
#! Chroma application name
public const AppName = "Chroma";
}

#! App logo loaded from file
public const ChromaLogo = File::readTextFile(get_script_dir() + "/chroma-logo.svg");
