    DCC_AUTHENTICATION_FAILED: False,
    DCC_ALREADY_AUTHENTICATED: True,
    DCC_INVALID_SEQ: True,
    DCC_RATE_LIMITED: True,
    DCC_SESSION_TIMED_OUT: True,
    DCC_INVALID_SHARD: False,
    DCC_SHARDING_REQUIRED: False,
    DCC_INVALID_API: False,
    DCC_INVALID_INTENT: False,
    DCC_DISALLOWED_INTENT: False,
};

#! Maps Discord close codes to a short description string
public const CloseDescMap = {
    DCC_UNKNOWN_ERROR: "Unknown error",
    DCC_UNKNOWN_OPCODE: "Unknown opcode",
    DCC_DECODE_ERROR: "Decode error",
    DCC_NOT_AUTHENTICATED: "Not authenticated",
    DCC_AUTHENTICATION_FAILED: "Authentication failed",
    DCC_ALREADY_AUTHENTICATED: "Already authenticated",
    DCC_INVALID_SEQ: "Invalid seq",
    DCC_RATE_LIMITED: "Rate limited",
    DCC_SESSION_TIMED_OUT: "Session timed out",
    DCC_INVALID_SHARD: "Invalid shard",
    DCC_SHARDING_REQUIRED: "Sharing required",
    DCC_INVALID_API: "Invalid API version",
    DCC_INVALID_INTENT: "Invalid intent(s)",
    DCC_DISALLOWED_INTENT: "Disallowed intent(s)",
};

#! The heartbeat of one gateway connection; internal to DiscordWebSocketClient
/** Not for use outside of @ref DiscordWebSocketClient::DiscordWebSocketClient "DiscordWebSocketClient" and its
    subclasses; it may change without notice.  Each heartbeat thread has its own record, so only a stopper of that
    thread clears its state, and a heartbeat started for a newer connection is never touched by the stop of an older
    one.  Its state is changed in its synchronized methods; \c seq, \c cid and \c client are set when it is
    created.

    @since DiscordWebSocketClient 1.2
*/
public class DiscordHeartbeat {
    public {
        #! A unique number identifying the record in the client
        int seq;

        #! The ID of the connection whose HELLO started the heartbeat
        int cid;

        #! The heartbeat interval in ms; written with setInterval()
        int interval;

        #! The TID of the heartbeat thread, once started
        int tid;

        #! Set when the thread must stop; written with requestStop()
        bool stop = False;

        #! The number of running heartbeat threads of the record (0 or 1)
        Counter running();

        #! The client, by a weak reference: the heartbeat thread never keeps its client alive
        *DiscordWebSocketClient client;

        #! Set when the heartbeat thread ended; written with markEnded()
        bool ended = False;

        #! Set when the heartbeat thread runs the client's destructor and is told to stop without being waited for;
        #! written with requestStop()
        bool detached = False;
    }

    private {
        #! Wakes the heartbeat thread's wait for its next beat (a stop or a new interval)
        Queue wake();

        #! Raised when the thread is started; reaches zero once the thread ended or was detached, or its start failed:
        #! what stoppers wait for (a record whose thread was never started has nothing to wait for)
        Counter done();

        #! Set once the thread ended or was detached, or its start failed
        bool finished = False;
    }

    #! Creates the record
    constructor(int seq, int cid, int interval) {
        self.seq = seq;
        self.cid = cid;
        self.interval = interval;
    }

    # The state is changed in synchronized methods and waited for with a Queue and a Counter: the changes are made
    # also by cleanup on a cancelled thread (the end of a cancelled heartbeat thread), and neither a synchronized
    # method nor a Queue push nor a Counter decrement is a cancellation point, while a Mutex lock is (see
    # design/cooperative-cancellation.md "Cleanup Critical Sections"); a destructor running on a cancelled thread
    # takes Mutex locks before it stops the heartbeat, which it can because the destructor of a trusted class runs
    # with cancellation deferred (see "Destructors" there)

    #! Returns @ref True if the thread must stop
    synchronized bool isStopped() {
        return stop;
    }

    #! Returns the interval in ms
    synchronized int getInterval() {
        return interval;
    }

    #! Sets the interval in ms and wakes the thread
    synchronized setInterval(int interval) {
        self.interval = interval;
        wake.push(True);
    }

    #! Tells the thread to stop, and wakes it
    /** @param detach the thread is not waited for: stoppers waiting for it go on
    */
    synchronized requestStop(*bool detach) {
        stop = True;
        if (detach && !detached) {
            detached = True;
            finishUnlocked();
        }
        wake.push(True);
    }

    #! Records that the thread is about to be started: stoppers wait for it from now on
    synchronized starting() {
        running.inc();
        if (!finished) {
            done.inc();
        }
    }

    #! Records the end of the thread, or the failure of its start
    synchronized markEnded() {
        ended = True;
        finishUnlocked();
    }

    #! Waits until the thread ended or was detached, or its start failed
    waitEndedOrDetached() {
        done.waitForZero();
    }

    #! Waits until the given time or until the thread is told to stop
    /** Woken by a stop or an interval change; a wakeup before the time only checks for a stop.
    */
    waitUntil(date target) {
        while (!isStopped()) {
            # in whole milliseconds: a wait of 0 ms would not end before a wakeup
            int remaining = (target - now_us()).durationMilliseconds();
            if (remaining <= 0) {
                return;
            }
            sleep(remaining);
        }
    }

    #! Waits for a wakeup of the thread, at most for the given number of milliseconds (more than 0)
    sleep(int remaining) {
        # a timeout of 0 would wait without a limit
        if (remaining <= 0) {
            return;
        }
        try {
            wake.get(remaining);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "QUEUE-TIMEOUT") {
                rethrow;
            }
        }
    }

    private finishUnlocked() {
        if (!finished) {
            finished = True;
            if (done.getCount()) {
                done.dec();
            }
        }
    }
}

#! The Discord WebSocket client class
public class DiscordWebSocketClient inherits WebSocketClientWithSerialization {
    public {
        #! Default headers to use in the initial HTTP request after connecting
        const DefaultHeaders = {
            "Sec-WebSocket-Version": "13",
        };

        #! Default API version
        const DefaultApi = 10;

        #! Default option values
        const DefaultOptions = {
            "headers": DefaultHeaders,
            "data": "json",
            "api": DefaultApi,
        };

        #! Milliseconds to wait for the gateway HELLO after (re)connecting before forcing a reconnect
        /** The Discord gateway sends @ref DOP_HELLO immediately after the WebSocket
            handshake.  If it is not received within this window the async receive
            path has stalled (e.g. a lost first read completion after a reconnect);
            without this watchdog the connection stays silently dead forever — the
            heartbeat thread is only (re)started in handleHello(), and zombie
            detection lives in that thread, so a lost HELLO disables all recovery.
            See helloWatchdogFired().
        */
        const HelloWatchdogTimeoutMs = 30000;

        #! Consecutive missed-HELLO reconnect cycles after which the watchdog escalates logging
        const HelloWatchdogEscalateAfter = 5;

        #! Milliseconds to wait for RESUMED / INVALID_SESSION after sendResume() before falling back to IDENTIFY
        /** After @ref sendResume() the gateway must respond with either a RESUMED
            dispatch event (success, possibly preceded by replayed missed events)
            or @ref DOP_INVALID_SESSION (must re-IDENTIFY).  If neither arrives
            within this window the resume has silently failed: heartbeats keep
            flowing but no message events are delivered.  Without this watchdog
            the bot stays "connected" forever with no events; this matches the
            real-world Discord pattern where a RESUME is dropped without an op-9.
            See resumeWatchdogFired().
        */
        const ResumeWatchdogTimeoutMs = 30000;

        #! Consecutive silent-resume cycles after which the watchdog escalates logging
        const ResumeWatchdogEscalateAfter = 3;

        #! Receive: An event was dispatched
        const DOP_DISPATCH = 0;

        #! Send/Receive: Fired periodically by the client to keep the connection alive
        const DOP_HEARTBEAT = 1;

        #! Send: Starts a new session during the initial handshake
        const DOP_IDENTIFY = 2;

        #! Send: Update the client's presence
        const DOP_PRESENCE_UPDATE = 3;

        #! Send: Used to join/leave or move between voice channels
        const DOP_VOICE_STATE_UPDATE = 4;

        #! Send: Resume a previous session that was disconnected
        const DOP_RESUME = 6;

        #! Receive: You should attempt to reconnect and resume immediately
        const DOP_RECONNECT = 7;

        #! Send: Request information about offline guild members in a large guild
        const DOP_REQUEST_GUILD_MEMBERS = 8;

        #! Receive: The session has been invalidated. You should reconnect and identify/resume accordingly
        const DOP_INVALID_SESSION = 9;

        #! Receive: Sent immediately after connecting, contains the heartbeat_interval to use
        const DOP_HELLO = 10;

        #! Receive: Sent in response to receiving a heartbeat to acknowledge that it has been received
        const DOP_HEARTBEAT_ACK = 11;

        #! Opcode to string map
        const OpMap = {
            DOP_DISPATCH: "Dispatch",
            DOP_HEARTBEAT: "Heartbeat",
            DOP_IDENTIFY: "Identify",
            DOP_PRESENCE_UPDATE: "Presence Update",
            DOP_VOICE_STATE_UPDATE: "Voice State Update",
            DOP_RESUME: "Resume",
            DOP_RECONNECT: "Reconnect",
            DOP_REQUEST_GUILD_MEMBERS: "Request Guild Members",
            DOP_INVALID_SESSION: "Invalid Session",
            DOP_HELLO: "Hello",
            DOP_HEARTBEAT_ACK: "Heartbeat ACK",
        };
    }

    private {
        #! Bot token
        string token;

        #! Intents for the identify message
        int intents;

        #! The heartbeat interval in ms
        int heartbeat_interval;

        #! The last received sequence number
        int last_sequence;

        #! Current session ID
        string session_id;

        #! Resume gateway URL
        string resume_gateway_url;

        #! The heartbeat of the client's connection, if any; protected by @ref heartbeat_lock
        /** @since DiscordWebSocketClient 1.2
        */
        *DiscordHeartbeat hb;

        #! The TID of the thread running the destructor, 0 before it runs
        /** @since DiscordWebSocketClient 1.2
        */
        int destructor_tid = 0;

        #! The sequence number of the last heartbeat record; protected by @ref heartbeat_lock
        /** @since DiscordWebSocketClient 1.2
        */
        int hb_seq = 0;

        #! Heartbeat mutex
        Mutex heartbeat_lock();

        #! Heartbeat condition; unused since DiscordWebSocketClient 1.2: each heartbeat record has its own
        Condition heartbeat_cond();

        #! Set to @ref True when the gateway acknowledges a heartbeat
        /** Used to detect a zombied connection: if the gateway does not acknowledge a heartbeat
            before the next one is due, the connection is dead and must be reestablished, as
            required by the Discord gateway protocol.  Protected by @ref heartbeat_lock.
        */
        bool heartbeat_ack = True;

        #! HELLO watchdog: lock protecting the watchdog timer/state below
        Mutex hello_watchdog_lock();

        #! HELLO watchdog: active async I/O controller timer id (0 = none)
        int hello_watchdog_timer = 0;

        #! HELLO watchdog: the ID of the connection the timer was armed for (-1 = any)
        /** Protected by @ref hello_watchdog_lock.

            @since DiscordWebSocketClient 1.2
        */
        int hello_watchdog_cid = -1;

        #! HELLO watchdog: the generation of the armed timer; a fired timer of an earlier one does nothing
        /** Protected by @ref hello_watchdog_lock.

            @since DiscordWebSocketClient 1.2
        */
        int hello_watchdog_gen = 0;

        #! HELLO watchdog: set once the gateway HELLO is seen for the current connection
        /** Also set on teardown so a racing timer fire becomes a no-op.  Protected
            by @ref hello_watchdog_lock.
        */
        bool hello_received = False;

        #! HELLO watchdog: consecutive (re)connects with no HELLO (escalation/observability)
        int hello_miss_count = 0;

        #! RESUME watchdog: lock protecting the watchdog timer/state below
        Mutex resume_watchdog_lock();

        #! RESUME watchdog: active async I/O controller timer id (0 = none)
        int resume_watchdog_timer = 0;

        #! RESUME watchdog: the ID of the connection the timer was armed for (-1 = any)
        /** Protected by @ref resume_watchdog_lock.

            @since DiscordWebSocketClient 1.2
        */
        int resume_watchdog_cid = -1;

        #! RESUME watchdog: the generation of the armed timer; a fired timer of an earlier one does nothing
        /** Protected by @ref resume_watchdog_lock.

            @since DiscordWebSocketClient 1.2
        */
        int resume_watchdog_gen = 0;

        #! RESUME watchdog: set once a DOP_DISPATCH or DOP_INVALID_SESSION arrives after sendResume()
        /** Also set on teardown so a racing timer fire becomes a no-op.  Protected
            by @ref resume_watchdog_lock.
        */
        bool resume_completed = True;

        #! RESUME watchdog: consecutive silent resumes (escalation/observability)
        int resume_miss_count = 0;

        #! Stable per-instance owner tag for the HELLO/RESUME watchdog timer callbacks
        /** Both watchdog timers are armed with this owner so the destructor can
            deterministically drain a fired-but-not-yet-run watchdog callback via
            @ref AsyncSocketIo::AsyncSocketIoController::flushCallbacksByOwner()
            before members are destroyed, closing the teardown race where a timer
            fires and its callback is dispatched to a worker just as the object is
            deleted.  Set once in the constructor.
        */
        string watchdog_owner;

        #! API version
        int api = DefaultApi;
    }

    #! creates the object and optionally sets logging targets
    /** @par Example:
        @code{.py}
DiscordWebSocketClient ws();
        @endcode

        @param opts All options accepted by
        @ref WebSocketClient::WebSocketClient::constructor() "WebSocketClient::constructor()" with the following
        differences:
        - \c token: must be a bot token and is a required option
        - \c intents: optional integer intent for the identify message

        @throw WEBSOCKET-ERROR unknown scheme, missing 'url' key in option hash; invalid option value
    */
    constructor(*hash<auto> opts) : WebSocketClientWithSerialization(DiscordWebSocketClient::getOptions(opts)) {
        # stable owner tag for watchdog timer callbacks so the destructor can drain
        # an in-flight watchdog callback (see watchdog_owner)
        watchdog_owner = "dwsc-wd-" + get_random_string(16);
    }

    #! Deletes the object
    destructor() {
        # the heartbeat thread, if it runs this destructor, is detached when it is stopped (see stopHeartbeatThread())
        destructor_tid = gettid();
        # cancel watchdogs before teardown so a pending timer cannot
        # fire on an already-deleted object
        cancelHelloWatchdog();
        cancelResumeWatchdog();
        # cancelTimer() above removes a not-yet-fired timer, but a watchdog that
        # already fired may have its callback dispatched to a worker and not yet
        # run; drain those deterministically via the watchdog owner tag so a
        # callback cannot touch destroyed members.  Safe from self-deadlock: the
        # watchdog callbacks (helloWatchdogFired/resumeWatchdogFired) hold a self
        # ref while running, so the destructor cannot run on a watchdog worker
        # mid-callback, and the worker decrements the owner count before its
        # final self-deref that could trigger this destructor.
        if (watchdog_owner.val()) {
            try {
                AsyncSocketIo::AsyncSocketIoController controller =
                    AsyncSocketIo::getGlobalAsyncIoController();
                controller.flushCallbacksByOwner(watchdog_owner);
            } catch (hash<ExceptionInfo> ex) {
                # controller unavailable during shutdown — nothing left to drain
            }
        }
        # the last reference can be released on the heartbeat thread, which then runs this destructor: its heartbeat
        # is only told to stop (see stopHeartbeatThread())
        stopHeartbeatThread();
    }

    #! Disconnects from the gateway and stops the heartbeat thread
    /** Stops the heartbeat thread and the watchdogs once the disconnect holds its action (see explicitDisconnect()),
        to prevent the heartbeat thread from blocking service shutdown when it was started via \c start_thread; a
        disconnect that times out waiting for the action leaves them running with the connection.

        @param cmd the WebSocket close code to send

        @since DiscordWebSocketClient 1.1
    */
    disconnect(int cmd = WSCC_GoingAway) {
        WebSocketClientWithSerialization::disconnect(cmd);
    }

    #! Stops the watchdogs and the heartbeat thread for an explicit disconnect
    /** Called by @ref WebSocketClient::WebSocketClient::disconnect() "disconnect()" in its action, without the
        client's lock: an explicit disconnect never lets a watchdog resurrect the connection.

        @since DiscordWebSocketClient 1.2
    */
    private explicitDisconnect() {
        cancelHelloWatchdog();
        cancelResumeWatchdog();
        stopHeartbeatThread();
    }

    #! Returns performance statistics for the socket
    /** @par Example:
        @code{.py}
hash<auto> h = ws.getInfo();
        @endcode

        @return a hash with the following keys:
        - \c api: the API in use
        - \c cid: the current CID
        - \c heartbeat_tid: the heartbeat TID
        - \c session_id: the current session ID
        - \c last_sequence: the last sequence number received
        - \c resume_gateway_url: the gate URL for resumes
    */
    hash<auto> getInfo() {
        return {
            "api": api,
            "cid": cid,
            "heartbeat_tid": getHeartbeatTid(),
            "session_id": session_id,
            "last_sequence": last_sequence,
            "resume_gateway_url": resume_gateway_url,
        };
    }

    #! Returns the TID of the heartbeat thread, if any
    private *int getHeartbeatTid() {
        AutoLock al(heartbeat_lock);
        return hb ? hb.tid : NOTHING;
    }

    #! Processes options for the DiscordWebSocketClient constructor
    static hash<auto> getOptions(*hash<auto> opts) {
        if (!opts.url) {
            opts.url = DiscordWebSocketConnection::discoverUrl();
        }
        return opts + DefaultOptions;
    }

    #! Called when the WebSocket connection is closing
    /** Stops the heartbeat thread when the connection is closed and raises @ref WebSocketClient::EVENT_WS_CLOSED.  A
        connection can be reported closed after a newer connection was opened: the heartbeat and the watchdogs then
        belong to the newer connection and are left running.
        @since DiscordWebSocketClient 1.2
    */
    private closingConnection() {
        # raises EVENT_WS_CLOSED (the data provider's disconnection event), also if a step below fails
        on_exit WebSocketClientWithSerialization::closingConnection();
        # only the closed connection's watchdogs and heartbeat are stopped: a newer connection, which may be opened
        # while this close is reported, keeps its own (each is checked against the connection ID under its lock)
        int closed = getClosingConnectionId();
        # the connection is closing: cancel its watchdogs so a pending timer cannot fire a spurious reconnect during
        # teardown (the normal reconnect path handles a close-before-HELLO/RESUMED and will re-arm as needed)
        # each step is guarded, so a failing one does not skip the others
        try {
            cancelHelloWatchdog(closed);
        } catch (hash<ExceptionInfo> ex) {
            logError("closing connection %d: cannot cancel the HELLO watchdog: %s", closed, get_exception_string(ex));
        }
        try {
            cancelResumeWatchdog(closed);
        } catch (hash<ExceptionInfo> ex) {
            logError("closing connection %d: cannot cancel the RESUME watchdog: %s", closed, get_exception_string(ex));
        }
        try {
            if (!stopHeartbeatThread(closed)) {
                logDebug("connection %d closed; the heartbeat of connection %d is left running", closed,
                    getCurrentConnectionId());
            }
        } catch (hash<ExceptionInfo> ex) {
            logError("closing connection %d: cannot stop the heartbeat: %s", closed, get_exception_string(ex));
        }
    }

    #! Handles deserialized event data
    private int handleEventData(auto msgdata) {
        if (msgdata.typeCode() != NT_HASH) {
            logError("Unexpected payload data type %y (value %y); expecting \"hash\"", msgdata.fullType(), msgdata);
            return WSEDC_CONTINUE;
        }
        *int op = msgdata.op;
        if (!exists op) {
            throw "DISCORD-ERROR", sprintf("missing opcode in payload: %y", msgdata);
        }
        if (msgdata.s) {
            last_sequence = msgdata.s;
        }
        logDebug("Received %y: (%s) %y", OpMap{op}, msgdata.t ?? "n/a", msgdata.d);
        int rc = WSEDC_CONTINUE;
        switch (op) {
            case DOP_HELLO:
                handleHello(msgdata.d);
                break;

            case DOP_DISPATCH:
                # any DISPATCH event (RESUMED, READY, or a real data event) is proof
                # the gateway accepted the previous RESUME / IDENTIFY and is talking
                # to us — disarm the RESUME watchdog
                cancelResumeWatchdog(getEventConnectionId());
                if (msgdata.t == "READY") {
                    handleReadyMessage(msgdata.d);
                } else {
                    rc = handleMessage(msgdata);
                }
                break;

            case DOP_HEARTBEAT:
                # the gateway can request an immediate heartbeat at any time; we must respond right
                # away with the last sequence number received, otherwise the gateway treats the
                # connection as a zombie, closes it, and stops delivering events
                logDebug("Gateway requested an immediate heartbeat; responding with sequence %y", last_sequence);
                sendHeartbeat();
                break;

            case DOP_HEARTBEAT_ACK:
                handleHeartbeatAck();
                break;

            case DOP_RECONNECT:
                rc = WSEDC_BREAK;
                break;

            case DOP_INVALID_SESSION:
                logError("Session has been invalidated (%y); starting reconnect", OpMap{op});
                # the gateway has rejected the session; clear session state so the
                # next reconnect path uses sendIdentify() rather than retrying
                # sendResume() forever with an invalidated session
                cancelResumeWatchdog(getEventConnectionId());
                clearSessionState();
                rc = WSEDC_BREAK;
                break;

            default:
                throw "DISCORD-ERROR", sprintf("do not know how to handle opcode %d (%s)", op,
                    OpMap{op} ?? "unknown");
        }
        return rc;
    }

    #! Handle a READY message
    private handleReadyMessage(hash<auto> d) {
        session_id = d.session_id;
        resume_gateway_url = d.resume_gateway_url;
    }

    #! Handle a Heartbeat ACK
    private handleHeartbeatAck() {
        int ecid = getEventConnectionId();
        AutoLock al(heartbeat_lock);
        # the ACK of an older connection does not acknowledge the heartbeat of a newer one
        if (hb && hb.cid >= 0 && ecid >= 0 && hb.cid != ecid) {
            return;
        }
        heartbeat_ack = True;
    }

    #! Returns @ref True if the connection is zombied (the previous heartbeat was not acknowledged)
    /** otherwise marks a heartbeat as in flight (awaiting an ACK) and returns @ref False

        @note acquires @ref heartbeat_lock internally
    */
    private bool heartbeatZombieCheck() {
        AutoLock al(heartbeat_lock);
        if (!heartbeat_ack) {
            return True;
        }
        heartbeat_ack = False;
        return False;
    }

    #! Forces a reconnect from a separate thread after a zombied connection is detected
    /** The reconnect must not be driven from the heartbeat thread itself: the reconnect path
        calls @ref reconnectPreamble() -> stopHeartbeatThread(), which waits for the heartbeat
        thread to exit, so driving it from the heartbeat thread would deadlock.  This method
        starts a short-lived thread to call
        @ref WebSocketClient::WebSocketClient::reconnect() "reconnect()" and returns immediately so the heartbeat thread can exit.
    */
    /** @param cid the ID of the connection to reconnect: the reconnect is made only if it is still the client's when
        it is the reconnect's turn, so it neither closes a newer connection nor resurrects one closed by an explicit
        disconnect; -1 for the client's connection, whichever it is
        @param h the heartbeat that detected the zombie, if any: if no reconnect is made, it is cleared once its
        thread ended, so a new connection can start its own

        @since DiscordWebSocketClient 1.2 the parameters
    */
    private triggerZombieReconnect(int cid = -1, *DiscordHeartbeat h) {
        # a thread of the client, which its destructor waits for
        startLibraryThread(sub () {
            bool started;
            try {
                started = reconnectIntern(cid >= 0 ? cid : NOTHING);
            } catch (hash<ExceptionInfo> ex) {
                try {
                    logError("zombie-connection reconnect failed: %s", get_exception_string(ex));
                } catch (hash<ExceptionInfo> ex1) {
                    if (ex1.err != "OBJECT-ALREADY-DELETED") {
                        rethrow;
                    }
                }
            }
            if (!started && h) {
                heartbeatHandoffFailed(h);
            }
        }, True);
    }

    #! Clears a heartbeat whose zombie reconnect was not made, once its thread ended
    /** @param h the heartbeat record

        @since DiscordWebSocketClient 1.2
    */
    private heartbeatHandoffFailed(DiscordHeartbeat h) {
        try {
            # never waits for itself, nor for a heartbeat thread that runs the client's destructor (it is detached
            # and may be waiting for this very thread in the destructor; see stopHeartbeatThread())
            if (h.tid != gettid()) {
                DiscordWebSocketClient::waitHeartbeatEndedOrDetached(h);
            }
            AutoLock al(heartbeat_lock);
            if (hb && hb.seq == h.seq) {
                remove hb;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "OBJECT-ALREADY-DELETED") {
                rethrow;
            }
        }
    }

    #! Arms the HELLO watchdog for every connection when it becomes the client's
    /** Single choke point: every connect, reconnect and poll connect publishes its connection here, in its action
        with the client's lock held, before the connection can deliver anything, so a HELLO handled in the connect's
        callbacks disarms this connection's watchdog.  The gateway must send @ref DOP_HELLO promptly; handleHello()
        disarms the watchdog.  If HELLO never arrives (stalled async receive after a reconnect — the connection stays
        "Connected" with no heartbeat thread and thus no zombie detection), the watchdog forces a reconnect instead of
        dying silently.  A connect that waits for another one, or fails, never arms or cancels the watchdog of the
        connection the client has.

        @since DiscordWebSocketClient 1.2
    */
    private WscConnection publishConnectionUnlocked() {
        WscConnection c = WebSocketClientWithSerialization::publishConnectionUnlocked();
        # a watchdog that cannot be armed (e.g. the async I/O controller is shutting down) does not fail the connect
        try {
            armHelloWatchdog(c.cid);
        } catch (hash<ExceptionInfo> ex) {
            logError("cannot arm the HELLO watchdog of connection %d: %s: %s", c.cid, ex.err, ex.desc);
        }
        return c;
    }

    #! Cancels the watchdog of a connection that a failed connect published and released
    private hash<auto> connectIntern(*hash<auto> opts, *reference<hash<auto>> info, *bool reconnect) {
        # the destructor waits until this call returned if it waits for the action, so that the cleanup below finds
        # the client (issue #5983)
        WscActionCall action_call(action_wait_count, action_call_key);
        on_exit remove action_call;
        on_error cancelStaleHelloWatchdog();
        return WebSocketClient::connectIntern(opts, \info, reconnect);
    }

    #! Cancels the HELLO watchdog if it was armed for a connection that is no longer the client's
    /** @since DiscordWebSocketClient 1.2
    */
    private cancelStaleHelloWatchdog() {
        int current = getCurrentConnectionId();
        bool stale;
        {
            AutoLock al(hello_watchdog_lock);
            stale = hello_watchdog_timer && hello_watchdog_cid >= 0 && hello_watchdog_cid != current;
            if (stale) {
                cancelHelloWatchdogTimerUnlocked();
            }
        }
    }

    #! Cancels the HELLO watchdog's timer; must be called with @ref hello_watchdog_lock held
    private cancelHelloWatchdogTimerUnlocked() {
        if (hello_watchdog_timer) {
            AsyncSocketIo::AsyncSocketIoController controller = AsyncSocketIo::getGlobalAsyncIoController();
            try {
                controller.cancelTimer(hello_watchdog_timer);
            } catch (hash<ExceptionInfo> ex) {
            }
            hello_watchdog_timer = 0;
        }
    }

    #! Arms (or re-arms) the HELLO watchdog timer
    /** @param cid the ID of the connection that must receive HELLO; -1 for the client's connection, whichever it is

        @since DiscordWebSocketClient 1.2 the \a cid parameter
    */
    private armHelloWatchdog(int cid = -1) {
        AsyncSocketIo::AsyncSocketIoController controller = AsyncSocketIo::getGlobalAsyncIoController();
        AutoLock al(hello_watchdog_lock);
        hello_received = False;
        hello_watchdog_cid = cid;
        if (hello_watchdog_timer) {
            try {
                controller.cancelTimer(hello_watchdog_timer);
            } catch (hash<ExceptionInfo> ex) {
            }
            hello_watchdog_timer = 0;
        }
        # the timer's callback carries its generation (closures do not keep the client alive)
        int gen = ++hello_watchdog_gen;
        hello_watchdog_timer = controller.addTimer(now_us() + milliseconds(HelloWatchdogTimeoutMs),
            wrapAsyncCallback(sub () { helloWatchdogFired(gen); }), watchdog_owner);
    }

    #! Cancels the HELLO watchdog (HELLO received, or connection closing / shutting down)
    /** Idempotent; safe to call when no timer is armed.  Marks @ref hello_received
        so any timer already in flight becomes a no-op, and resets the consecutive
        miss counter (a delivered HELLO means the receive path is healthy).
    */
    /** @param cid if given and not negative, the watchdog is canceled only if it was armed for this connection

        @since DiscordWebSocketClient 1.2 the \a cid parameter
    */
    private cancelHelloWatchdog(*int cid) {
        AutoLock al(hello_watchdog_lock);
        if (exists cid && cid >= 0 && hello_watchdog_cid >= 0 && hello_watchdog_cid != cid) {
            return;
        }
        hello_received = True;
        hello_miss_count = 0;
        cancelHelloWatchdogTimerUnlocked();
    }

    #! HELLO watchdog timer callback: forces a reconnect if no gateway HELLO arrived
    /** Dispatched on an async I/O controller worker thread (never the I/O
        thread), so it is safe to drive a reconnect here.
        @ref triggerZombieReconnect() already runs the reconnect on its own
        thread and the heartbeat thread is not running pre-HELLO, so
        reconnectPreamble()->stopHeartbeatThread() is a harmless no-op.
    */
    /** @param gen the generation of the timer that fired; a timer of an earlier generation, whose callback was
        dispatched before the watchdog was re-armed, does nothing

        @since DiscordWebSocketClient 1.2 the \a gen parameter
    */
    private helloWatchdogFired(*int gen) {
        int miss;
        int cid;
        {
            AutoLock al(hello_watchdog_lock);
            if (exists gen && gen != hello_watchdog_gen) {
                return;
            }
            # disarmed in the race window (HELLO arrived / connection closing)
            if (hello_received || !hello_watchdog_timer) {
                return;
            }
            # armed for a connection that is no longer the client's: nothing to recover
            if (hello_watchdog_cid >= 0 && hello_watchdog_cid != getCurrentConnectionId()) {
                hello_watchdog_timer = 0;
                return;
            }
            hello_watchdog_timer = 0;
            miss = ++hello_miss_count;
            cid = hello_watchdog_cid;
        }
        try {
            if (miss >= HelloWatchdogEscalateAfter) {
                logError("no Discord gateway HELLO within %d ms for %d consecutive (re)connects; "
                    "the async receive path is stalled — forcing another reconnect",
                    HelloWatchdogTimeoutMs, miss);
            } else {
                logWarn("no Discord gateway HELLO within %d ms after (re)connect (miss %d); "
                    "the async receive path is stalled — forcing a reconnect",
                    HelloWatchdogTimeoutMs, miss);
            }
            triggerZombieReconnect(cid);
        } catch (hash<ExceptionInfo> ex) {
            # the client/service may have been torn down while the timer was pending
            if (ex.err != "OBJECT-ALREADY-DELETED") {
                rethrow;
            }
        }
    }

    #! Arms (or re-arms) the RESUME watchdog after sendResume()
    /** The gateway must respond with RESUMED (DOP_DISPATCH) or DOP_INVALID_SESSION
        within @ref ResumeWatchdogTimeoutMs; either signal disarms the watchdog
        via @ref cancelResumeWatchdog().  Without this, a silently-dropped RESUME
        leaves the connection "healthy" (heartbeats flow) but with no event
        delivery — see resumeWatchdogFired() for the recovery path.
    */
    /** @param cid the ID of the connection that sent the RESUME; -1 for the client's connection, whichever it is

        @since DiscordWebSocketClient 1.2 the \a cid parameter
    */
    private armResumeWatchdog(int cid = -1) {
        AsyncSocketIo::AsyncSocketIoController controller = AsyncSocketIo::getGlobalAsyncIoController();
        AutoLock al(resume_watchdog_lock);
        resume_completed = False;
        resume_watchdog_cid = cid;
        if (resume_watchdog_timer) {
            try {
                controller.cancelTimer(resume_watchdog_timer);
            } catch (hash<ExceptionInfo> ex) {
            }
            resume_watchdog_timer = 0;
        }
        # the timer's callback carries its generation (closures do not keep the client alive)
        int gen = ++resume_watchdog_gen;
        resume_watchdog_timer = controller.addTimer(now_us() + milliseconds(ResumeWatchdogTimeoutMs),
            wrapAsyncCallback(sub () { resumeWatchdogFired(gen); }), watchdog_owner);
    }

    #! Cancels the RESUME watchdog (RESUMED/DISPATCH or INVALID_SESSION received, or teardown)
    /** Idempotent; safe to call when no timer is armed.  Marks @ref resume_completed
        so any timer already in flight becomes a no-op, and resets the consecutive
        miss counter (a confirmed RESUMED/DISPATCH or a clean INVALID_SESSION both
        prove the gateway is responding).
    */
    /** @param cid if given and not negative, the watchdog is canceled only if it was armed for this connection

        @since DiscordWebSocketClient 1.2 the \a cid parameter
    */
    private cancelResumeWatchdog(*int cid) {
        AutoLock al(resume_watchdog_lock);
        if (exists cid && cid >= 0 && resume_watchdog_cid >= 0 && resume_watchdog_cid != cid) {
            return;
        }
        resume_completed = True;
        resume_miss_count = 0;
        if (resume_watchdog_timer) {
            AsyncSocketIo::AsyncSocketIoController controller = AsyncSocketIo::getGlobalAsyncIoController();
            try {
                controller.cancelTimer(resume_watchdog_timer);
            } catch (hash<ExceptionInfo> ex) {
            }
            resume_watchdog_timer = 0;
        }
    }

    #! RESUME watchdog timer callback: forces a fresh IDENTIFY when a resume silently fails
    /** Discord normally answers a RESUME with either a RESUMED dispatch or
        DOP_INVALID_SESSION; in the wild we have seen a third case where neither
        arrives, leaving the bot heartbeating into the void with no events.  When
        this fires we clear @ref session_id and @ref last_sequence so the next
        @ref doReconnect() goes through @ref sendIdentify(), and trigger the
        reconnect from a worker thread (see triggerZombieReconnect()).

        Dispatched on an async I/O controller worker thread (never the I/O
        thread), so it is safe to drive a reconnect here.
    */
    /** @param gen the generation of the timer that fired; a timer of an earlier generation, whose callback was
        dispatched before the watchdog was re-armed, does nothing

        @since DiscordWebSocketClient 1.2 the \a gen parameter
    */
    private resumeWatchdogFired(*int gen) {
        int miss;
        int cid;
        {
            AutoLock al(resume_watchdog_lock);
            if (exists gen && gen != resume_watchdog_gen) {
                return;
            }
            # disarmed in the race window (RESUMED/INVALID_SESSION arrived, or teardown)
            if (resume_completed || !resume_watchdog_timer) {
                return;
            }
            # armed for a connection that is no longer the client's: nothing to recover
            if (resume_watchdog_cid >= 0 && resume_watchdog_cid != getCurrentConnectionId()) {
                resume_watchdog_timer = 0;
                return;
            }
            resume_watchdog_timer = 0;
            miss = ++resume_miss_count;
            cid = resume_watchdog_cid;
        }
        try {
            if (miss >= ResumeWatchdogEscalateAfter) {
                logError("no Discord gateway RESUMED / INVALID_SESSION within %d ms for %d consecutive "
                    "resumes; falling back to a fresh IDENTIFY", ResumeWatchdogTimeoutMs, miss);
            } else {
                logWarn("no Discord gateway RESUMED / INVALID_SESSION within %d ms after sendResume() "
                    "(miss %d); falling back to a fresh IDENTIFY", ResumeWatchdogTimeoutMs, miss);
            }
            # force the next reconnect through sendIdentify(): without clearing
            # session state, doReconnect() would call sendResume() again with the
            # same (apparently dead) session
            clearSessionState();
            triggerZombieReconnect(cid);
        } catch (hash<ExceptionInfo> ex) {
            # the client/service may have been torn down while the timer was pending
            if (ex.err != "OBJECT-ALREADY-DELETED") {
                rethrow;
            }
        }
    }

    #! Sends a heartbeat message to the gateway with the last sequence number received
    private sendHeartbeat() {
        sendData({
            "op": DOP_HEARTBEAT,
            "d": last_sequence,
        });
    }

    #! Executes before a reconnect
    private reconnectPreamble() {
        # the heartbeat and the URL belong to the client's connection: they are changed in the reconnect's action, and
        # only if no connection was published after the teardown that the reconnect was started for
        runInReconnectAction(sub () {
            # NOTE: the hartbeat thread will be restarted automatically when the HELLO message is received in the new
            # connection
            stopHeartbeatThread();
            disconnectIntern();

            if (!resume_gateway_url) {
                logWarn("Reconnect message received, but no resume_gateway_url is present");
            } else {
                logInfo("Reconnect to %y", resume_gateway_url);
                url = setupUrl(resume_gateway_url);
                string http_url = url;
                http_url =~ s/^ws/http/;
                http_opts.url = http_url;
            }
        });
    }

    #! Connects to the server when reconnecting
    /** The Discord gateway protocol requires the client to wait for HELLO before
        sending IDENTIFY or RESUME.  We establish the WebSocket connection here
        and let @ref handleHello() drive the IDENTIFY/RESUME decision when HELLO
        arrives; sending RESUME (or IDENTIFY) pre-emptively from this method
        races the gateway and previously caused both messages to be sent on a
        session-resume reconnect (handleHello always also called sendIdentify),
        which the gateway treats as ambiguous and can silently drop.
    */
    private doReconnect(reference<hash<auto>> info) {
        connectIntern(NOTHING, \info, True);
    }

    #! Clears the resumable-session state so the next reconnect goes through sendIdentify()
    /** session_id is declared as a non-nullable string so we assign "" rather
        than NOTHING; the existing reconnect guard checks truthiness, so an empty
        string correctly routes to sendIdentify()
    */
    private clearSessionState() {
        session_id = "";
        last_sequence = 0;
    }

    #! Handle a message by raising a data event
    private int handleMessage(hash<auto> msg) {
        if (msg.d) {
            msg.d = convertData(msg.d);
        }
        return WebSocketClientWithSerialization::handleEventData(msg);
    }

    #! Handle a HELLO message
    /** Per the Discord gateway protocol HELLO is the signal that the client may
        now send IDENTIFY (new session) or RESUME (continuing session).  This
        method is the single choke point for that decision: it covers initial
        connect (constructor / connect()) and every reconnect (doReconnect()),
        so sendIdentify() / sendResume() is sent exactly once per connection.
    */
    private handleHello(hash<auto> d) {
        # the gateway responded with HELLO: the async receive path is alive for
        # this connection — disarm the HELLO watchdog (see helloWatchdogFired())
        int ecid = getEventConnectionId();
        cancelHelloWatchdog(ecid);
        *int hbi = d.heartbeat_interval;
        if (!hbi) {
            throw "DISCORD-ERROR", sprintf("Missing heartbeat interval in Hello msg: %y", d);
        }
        # a HELLO of a connection that is no longer the client's starts nothing
        if (ecid != getCurrentConnectionId()) {
            logDebug("HELLO of connection %d ignored: the client's connection is %d", ecid, getCurrentConnectionId());
            return;
        }
        # the heartbeat belongs to its connection: a heartbeat still running for an older connection (e.g. one
        # replaced by an explicit connect(), whose close can be reported after this HELLO) is stopped first, so its
        # acknowledgement state does not carry over
        *int old_cid;
        {
            AutoLock al(heartbeat_lock);
            if (hb && hb.cid != ecid) {
                old_cid = hb.cid;
            }
        }
        if (exists old_cid) {
            stopHeartbeatThread(old_cid);
        }
        {
            AutoLock al(heartbeat_lock);
            heartbeat_interval = hbi;
            if (!hb) {
                # the heartbeat thread is not running on a new connection; checked again under the lock: only the
                # client's connection gets a heartbeat
                if (ecid == getCurrentConnectionId()) {
                    hb = new DiscordHeartbeat(++hb_seq, ecid, hbi);
                    startHeartbeatThreadIntern();
                }
            } else if (hb.cid == ecid && hb.interval != hbi) {
                # in case we get a HELLO message while the connection is still up (should not happen)
                hb.setInterval(hbi);
            }
        }
        if (session_id && last_sequence) {
            sendResume();
            # the gateway must respond with RESUMED (DOP_DISPATCH) or
            # DOP_INVALID_SESSION; either signal disarms the watchdog.  A silent
            # drop (which Discord does in the wild without an op-9) is caught by
            # the timer and falls back to a fresh IDENTIFY (see
            # resumeWatchdogFired())
            armResumeWatchdog(ecid);
        } else {
            sendIdentify();
        }
    }

    #! Send an Identify message
    private sendIdentify() {
        # send Indentify message
        sendData({
            "op": DOP_IDENTIFY,
            "d": {
                "token": token,
                "properties": {
                    "os": PlatformOS == "Darwin" ? "macOS" : PlatformOS,
                    "browser": "Qore",
                    "device": "Qore",
                },
                "intents": intents,
            },
        });
    }

    #! Send a resume message
    private sendResume() {
        sendData({
            "op": DOP_RESUME,
            "d": {
                "token": token,
                "session_id": session_id,
                "seq": last_sequence,
            },
        });
    }

    #! Starts the heartbeat thread of the heartbeat record in @ref hb
    /** Must be called with the heartbeat mutex locked
    */
    private startHeartbeatThreadIntern() {
        DiscordHeartbeat h = hb;
        if (h.tid) {
            throw "DISCORD-ERROR", sprintf("Heartbeat thread already running in TID %y", h.tid);
        }
        # a fresh connection starts with no heartbeat in flight; no other heartbeat thread runs: a record is set only
        # after the previous one's thread ended
        heartbeat_ack = True;
        # the thread refers to the client only by a weak reference, and takes a strong one only while it beats, so
        # dropping the last reference to the client destroys (and disconnects) it
        h.client := self;
        h.starting();
        on_error {
            h.running.dec();
            # no thread to wait for
            h.markEnded();
            remove hb;
        }
        # the heartbeat thread sets the record's TID itself
%ifdef PO_NO_THREAD_CONTROL
        start_thread(DiscordWebSocketClient::heartbeatRunner(h));
%else
        if (start_thread) {
            start_thread(DiscordWebSocketClient::heartbeatRunner(h));
        } else {
            background DiscordWebSocketClient::heartbeatMain(h);
        }
%endif
    }

    #! Returns the code that runs the heartbeat thread of a record
    /** Created in a static method: a closure created in a method holds a strong reference to its object while it
        runs, which would keep the client alive for the life of the heartbeat thread.

        @since DiscordWebSocketClient 1.2
    */
    private static code heartbeatRunner(DiscordHeartbeat h) {
        return sub () { DiscordWebSocketClient::heartbeatMain(h); };
    }

    #! Waits until the thread of a heartbeat record ended or was detached (see stopHeartbeatThread())
    /** @since DiscordWebSocketClient 1.2
    */
    private static waitHeartbeatEndedOrDetached(DiscordHeartbeat h) {
        # a record whose start failed is marked ended (see startHeartbeatThreadIntern())
        h.waitEndedOrDetached();
    }

    #! Sets the stop flag of a heartbeat record and wakes its thread
    /** @param h the record
        @param detach mark the record detached (its thread is not waited for)
    */
    private static stopHeartbeatRecord(DiscordHeartbeat h, *bool detach) {
        # not a cancellation point; a destructor running on a cancelled thread gets here after it took the heartbeat
        # lock (a Mutex, a cancellation point), because the destructor of a trusted class runs with cancellation deferred
        h.requestStop(detach);
    }

    #! Stops a heartbeat thread and waits until it ended
    /** Only the stoppers of a given heartbeat thread clear its record, and only if it is still the client's, so a
        heartbeat started meanwhile for a newer connection is never touched.

        @param cid if given and not negative, the heartbeat is stopped only if it belongs to this connection or to a
        connection that is no longer the client's

        When called on the heartbeat thread itself, the thread is told to stop and is not waited for; before
        DiscordWebSocketClient 1.2, \c DISCORD-ERROR was raised.

        @return @ref True if a heartbeat was stopped

        @since DiscordWebSocketClient 1.2 the \a cid parameter and the return value
    */
    private bool stopHeartbeatThread(*int cid) {
        DiscordHeartbeat h;
        {
            AutoLock al(heartbeat_lock);
            if (!hb) {
                return False;
            }
            if (exists cid && cid >= 0 && hb.cid != cid && hb.cid == getCurrentConnectionId()) {
                return False;
            }
            h = hb;
            # the destructor runs on the heartbeat thread itself (the thread released the last reference): the record
            # is detached, nobody waits for its thread
            if (h.tid == gettid() && destructor_tid == gettid()) {
                remove hb;
            }
        }
        if (h.tid == gettid()) {
            # detached only when the destructor runs on this thread, which waits for the other threads of the client;
            # otherwise (e.g. the zombie-reconnect fallback, which reconnects on this thread) the record stays the
            # client's until its thread ended, so a destructor running on another thread, or the next heartbeat of a
            # new connection, waits for that thread, which ends once it returns to its loop
            stopHeartbeatRecord(h, destructor_tid == gettid());
            return True;
        }
        stopHeartbeatRecord(h);

        waitHeartbeatEnded(h);
        AutoLock al(heartbeat_lock);
        # another stopper of the same thread may have cleared it, and a new heartbeat may have been started since
        if (hb && hb.seq == h.seq) {
            remove hb;
        }
        return True;
    }

    #! Waits until the thread of the given heartbeat record ended; called without @ref heartbeat_lock held
    /** @since DiscordWebSocketClient 1.2
    */
    private waitHeartbeatEnded(DiscordHeartbeat h) {
        # a detached heartbeat thread runs the client's destructor, which may wait for this thread
        DiscordWebSocketClient::waitHeartbeatEndedOrDetached(h);
    }

    #! The heartbeat thread of a heartbeat record
    /** A static method, so the thread holds no reference to the client while it waits; it takes a strong reference
        from the record's weak one only to beat, and ends when the client is gone or the record is stopped.

        @since DiscordWebSocketClient 1.2
    */
    private static heartbeatMain(DiscordHeartbeat h) {
        # reported also when the thread is cancelled: neither call is a cancellation point
        on_exit {
            h.markEnded();
            h.running.dec();
        }
        h.tid = gettid();

        bool running;
        while (True) {
            if (h.isStopped()) {
                break;
            }
            int sleep = h.getInterval();
            # calculate the first sleep with the heartbeat interval * jitter
            if (!running) {
                sleep = (float("0." + rand()) * sleep).toInt();
                running = True;
            }
            h.waitUntil(now_us() + milliseconds(sleep));
            if (h.isStopped()) {
                break;
            }
            # a strong reference only while beating
            *DiscordWebSocketClient c = h.client;
            if (!c) {
                # the client is gone
                break;
            }
            try {
                if (!c.heartbeatBeat(h)) {
                    break;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "OBJECT-ALREADY-DELETED") {
                    break;
                }
                rethrow;
            }
            # releasing the strong reference can destroy the client on this thread (see the destructor)
            remove c;
        }
    }

    #! Makes one beat of the given heartbeat
    /** @return @ref False if the heartbeat must end (the connection is zombied and a reconnect was forced)

        @since DiscordWebSocketClient 1.2
    */
    private bool heartbeatBeat(DiscordHeartbeat h) {
        # if the gateway did not acknowledge the previous heartbeat before this one is due,
        # the connection is zombied; per the Discord gateway protocol we must tear it down
        # and reconnect (resuming the session) instead of continuing to send into the void
        if (heartbeatZombieCheck()) {
            logWarn("the gateway did not acknowledge the previous heartbeat within the "
                "heartbeat interval (%d ms); the connection is zombied, forcing a reconnect",
                h.interval);
            try {
                triggerZombieReconnect(h.cid, h);
            } catch (hash<ExceptionInfo> ex) {
                # the reconnect's thread cannot be started (e.g. the client is being destroyed): the reconnect is
                # made on this thread instead, which ends its own heartbeat without waiting for itself
                logError("cannot start the zombie-connection reconnect thread: %s; reconnecting on the heartbeat "
                    "thread", get_exception_string(ex));
                bool started;
                try {
                    started = reconnectIntern(h.cid >= 0 ? h.cid : NOTHING);
                } catch (hash<ExceptionInfo> ex1) {
                    logError("zombie-connection reconnect failed: %s", get_exception_string(ex1));
                }
                if (!started) {
                    heartbeatHandoffFailed(h);
                }
            }
            return False;
        }
        try {
            # send a heartbeat message
            sendHeartbeat();
        } catch (hash<ExceptionInfo> ex) {
            logError("Heartbeat failed: %y", get_exception_string(ex));
        }
        return True;
    }

    #! Common constructor code
    private constructorInit(hash<auto> opts) {
        token = getString(opts, "token", True);
        remove opts.token;

        intents = getInt(opts, "intents", True, 0);
        remove opts.intents;

        api = getInt(opts, "api", True, DefaultApi);
        remove opts.api;

        opts.url = setupUrl(opts.url);

        WebSocketClientWithSerialization::constructorInit(opts);
    }

    #! setup URL
    *string setupUrl(*string url) {
        # add version and encoding to URL if there are no query arguments already
        if (url && url !~ /\?/) {
            if (url !~ /\/$/) {
                url += "/";
            }
            url += sprintf("?v=%d&encoding=json", api);
        }
        return url;
    }

    static auto convertData(auto v) {
        return v;
    }

    static auto convertData(string v) {
        return v =~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+/
            ? date(v)
            : v;
    }

    static list<auto> convertData(list<auto> l) {
        return map DiscordWebSocketClient::convertData($1), l;
    }

    static hash<auto> convertData(hash<auto> h) {
        return map {$1.key: DiscordWebSocketClient::convertData($1.value)}, h.pairIterator();
    }
}

#! class for Discord websocket connections; returns an object of class @ref DiscordWebSocketClient
/** Supports all the options of the @ref WebSocketClient::WebSocketConnectionObject "WebSocketConnection" class; note that
    the \c token option is required by this class and is used as the gateway token after connecting and not as an HTTP
    authentication token
*/
public class DiscordWebSocketConnection inherits WebSocketClient::WebSocketConnectionObject {
    public {
        #! The connection URL used when the URL is generated automatically (\c auto_url)
        const DefaultConnectionUrl = "discordwss://gateway.discord.gg/";

        #! Connection entry info
        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation("DiscordWebSocketClient",
            "DiscordWebSocketConnection", "en", <ConnectionSchemeInfo>{
            "display_name": "Discord WebSocket Connection",
            "short_desc": "A connection to Discord WebSocket server services",
            "desc": "A connection to Discord WebSocket server services",
            "cls": Class::forName("DiscordWebSocketConnection"),
            "auto_url": True,
            "schemes": {
                "discordwss": True,
            },
            "base_scheme_map": {
                "wss": "discordwss",
            },
            "options": WebSocketConnectionObject::ConnectionScheme.options,
        });

        #! Default Discord gateway URL
        const DefaultGatewayUrl = "wss://gateway.discord.gg/";

        #! Discord gateway discovery URL
        const GatewayDiscoveryUrl = "https://discord.com/api/gateway";

        #! The connect timeout for gateway discovery
        /** @since DiscordWebSocketClient 1.2
        */
        const GatewayDiscoveryConnectTimeout = 60s;

        #! The response timeout for gateway discovery
        /** @since DiscordWebSocketClient 1.2
        */
        const GatewayDiscoveryTimeout = 5m;
    }

    #! creates the DiscordWebSocketConnection connection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL; if not provided, then the URL will be discovered automatically
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, *string url, hash<auto> attributes = {}, hash<auto> options = {})
            : WebSocketConnectionObject(name, description, url, attributes, options) {
    }

    #! creates the DiscordWebSocketConnection connection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : WebSocketConnectionObject(config, attr) {
    }

    #! returns \c "discordwss"
    string getType() {
        return "discordwss";
    }

    #! returns a @ref DiscordWebSocketClient object
    /** @param connect if @ref True "True", then @ref WebSocketClient::WebSocketClient::connect() is called
        @param rtopts runtime options

        @return a @ref DiscordWebSocketClient object
    */
    private DiscordWebSocketClient getImpl(bool connect = True, *hash<auto> rtopts) {
        # to avoid type issues with rtopts
        if (rtopts) {
            rtopts = {} + rtopts;
        }
        # rename "dbglog" to "debuglog" for WebSocketClient object
        if (rtopts.dbglog) {
            rtopts.debuglog = remove rtopts.dbglog;
        }
        DiscordWebSocketClient ws({"url": real_url} + rtopts{"log", "errlog", "debuglog"} + opts);
        if (connect) {
            ws.connect();
        }
        return ws;
    }

    #! Called by the constructor to set the real URL
    /** @param url the new URL

        sets the real WS URL for WebSocket-based connections
    */
    private setRealUrl(*string url) {
        if (!url) {
            real_url = discoverUrl();
        } else {
            string scheme = (url =~ x/^([^:]+)/)[0];
            real_url = regex_subst(url, "^" + scheme, "wss");
        }
    }

    #! Discover the Discord gateway URL
    /** @param discovery_url the URL of the gateway discovery endpoint; redirects are followed

        @return the gateway URL

        @throw HTTP-CLIENT-RECEIVE-ERROR the discovery endpoint returned an error response; the exception argument is
        a hash of the response headers with lower-case names plus the \c status_code, \c status_message, and
        \c body keys
        @throw DISCORD-ERROR the response does not give a gateway URL

        @note the request is sent with @ref httpclientiointro "HttpClientIo", which raises
        connection and transport errors (ex: \c HTTPCLIENT-CONNECT-ERROR, \c HTTPCLIENT-TIMEOUT)

        @since DiscordWebSocketClient 1.2 the \a discovery_url argument
    */
    static string discoverUrl(string discovery_url = GatewayDiscoveryUrl) {
        # lookup gateway address
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "connect_timeout": GatewayDiscoveryConnectTimeout,
            "request_timeout": GatewayDiscoveryTimeout,
            "enable_cookies": False,
        });
        on_exit mgr.closeAll();
        hash<auto> resp = mgr.request(discovery_url, "GET", get_http_request_target(discovery_url), {
            "Accept": MimeTypeJson,
        });
        if (resp.status_code < 200 || resp.status_code >= 300) {
            throw "HTTP-CLIENT-RECEIVE-ERROR", sprintf("HTTP status code %d received: message: %s",
                resp.status_code, resp.status_message ?? "<no message>"), (resp.headers ?? {})
                + resp{"status_code", "status_message", "body"};
        }
        *data body = resp.body;
        auto info;
        try {
            info = parse_json(body.typeCode() == NT_BINARY ? body.toString("UTF-8") : body ?? "");
        } catch (hash<ExceptionInfo> ex) {
            throw "DISCORD-ERROR", sprintf("invalid gateway discovery response from %y: %s: %s",
                get_safe_url(discovery_url), ex.err, ex.desc);
        }
        if (info.typeCode() != NT_HASH || info.url.typeCode() != NT_STRING || !info.url.val()) {
            throw "DISCORD-ERROR", sprintf("gateway discovery response from %y has no gateway URL: %y",
                get_safe_url(discovery_url), info);
        }
        return info.url;
    }
}
}
