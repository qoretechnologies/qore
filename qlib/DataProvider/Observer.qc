public namespace DataProvider {
#! This abstract class represents an observer that will get notified by the subject it observes
/** @par Failure propagation
    An exception thrown by @ref update() is <b>not</b> swallowed: it is collected by
    @ref DataProvider::Observable::notifyObservers() "notifyObservers()", which notifies every
    remaining observer and then throws an aggregate \c OBSERVER-NOTIFICATION-ERROR exception to the
    event source.

    This is a contract, not an implementation detail.  An event source with a durable cursor — every
    @ref DataProvider::AbstractWatchDataProviderBase "watch data provider" — has exactly one
    observable fact to go on: whether raising the event returned without an exception.  An observer
    that catches its own processing failure and returns normally tells the source that the item was
    delivered, so the source advances its cursor past the item and runs any post-dispatch action
    (deleting the source mail, for example).  The item is then lost silently.  An observer that
    cannot process an event must therefore let the exception out.

    An event source that genuinely does not want back-pressure — a fire-and-forget push feed with no
    cursor to protect — catches exceptions from @ref DataProvider::Observable::notifyObservers()
    "notifyObservers()" itself, where the decision to ignore a failed handler is visible in the
    source rather than hidden in each observer.
*/
public class Observer {
    #! This method is called when an event is raised
    /**
        @param event_id unique ID identifying an event type or class
        @param data_ the data generated by the Observable event source

        @note an exception thrown here propagates to the event source; see the class documentation
        for why observers must not swallow processing failures
    */
    abstract update(string event_id, hash<auto> data_);
}
}