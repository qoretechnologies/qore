#! contains all public definitions in the DataProvider module
public namespace DataProvider {
#! Data generated by a data provider from the records created with it
/** Returned by @ref AbstractDataProvider::finishCreate() "AbstractDataProvider::finishCreate()" for a data provider
    that generates a document in memory, such as a spreadsheet or JSON file with no output location

    @see GeneratedDataOutputDataType

    @since %DataProvider 3.9
*/
public hashdecl GeneratedDataInfo {
    #! The generated data
    binary data;

    #! The number of records the data was generated from
    int record_count = 0;
}

#! Describes data generated by a data provider from the records created with it
/** This is the output type of actions with the @ref DPAD_CREATE_OUTPUT "create-output" output data type; providers
    that return more information can extend it with additional fields

    @par Example
    An action that generates a report and also returns its format:
    @code{.py}
class ReportOutputDataType inherits GeneratedDataOutputDataType {
    private {
        const Fields = {
            "format": {
                "display_name": "Format",
                "type": StringType,
                "desc": "The format of the generated report",
            },
        };
    }

    constructor() : GeneratedDataOutputDataType("ReportOutput") {
        addQoreFields(Fields);
    }
}
    @endcode

    @since %DataProvider 3.9
*/
public class GeneratedDataOutputDataType inherits HashDataType {
    private {
        #! The fields of the generated data output
        const Fields = {
            "data": {
                "display_name": "Generated Data",
                "short_desc": "The data generated from the created records",
                "type": BinaryType,
                "desc": "The data generated from the created records, for example the bytes of a spreadsheet or "
                    "JSON document, ready to be sent or stored with another action",
            },
            "record_count": {
                "display_name": "Record Count",
                "short_desc": "The number of records the data was generated from",
                "type": IntType,
                "desc": "The number of records the data was generated from",
            },
        };
    }

    #! Creates the type
    /** @param name the name of the type
    */
    constructor(string name = "GeneratedDataOutput") : HashDataType(AutoHashType, name) {
        addQoreFields(Fields);
    }
}

#! Describes data generated by a data provider from the records created with it
/** @since %DataProvider 3.9
*/
public const GeneratedDataOutputDataType GeneratedDataOutputDataType = new GeneratedDataOutputDataType();
}
