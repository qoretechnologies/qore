# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# Pipelines retain weak references to their components.
%allow-weak-references
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) reflection
%requires(reexport) Util
%requires(reexport) MapperUtil
%requires(reexport) Mime
%requires(reexport) Logger
%requires(reexport) ProviderIndexUtil
%requires i18n

%requires yaml

%requires json

%try-module xml
%define NoXml
%endtry

module DataProvider {
    version = "3.11";
    desc = "user module for data integration patterns and data and API introspection";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register module-conditional expression implementations
        hash<auto> extra;
        extra += YamlExpressionImplementations;
        extra += JsonExpressionImplementations;
%ifndef NoXml
        extra += XmlExpressionImplementations;
%endif
        if (extra) {
            AbstractDataProvider::ExtraExpressionImplementations = extra;
        }

        # register the data provider factory
        DataProvider::registerFactory(new NullDataProviderFactory());

        # register the Qore processors data provider factory
        DataProvider::registerFactory(new QoreProcessorsDataProviderFactory());

        # register the Qore processors app
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": QoreApp::AppName,
            "presentation_source_locale": "en",
            "display_name": "Qore",
            "short_desc": "Built-in data pipeline processors",
            "desc": "Built-in Qore data pipeline processors for filtering, transforming, "
                "and manipulating records in data pipelines",
            "logo": QoreApp::QoreLogo,
            "logo_file_name": "Qore-Q-square.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (AppGroup::DataTransformation,),
        });

        # register filter-records action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "filter-records",
            "display_name": "Filter Records",
            "short_desc": "Filter records by expression or DPQL string",
            "desc": "Filter pipeline records using either a structured `where_cond` expression or a `dpql_where` "
                "string; matching records pass through, non-matching records are dropped",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_FILTER,
            "output_data_type": DPAD_PASS_THROUGH,
            "cls": "DataProvider::QoreFilterRecordsProcessor",
            "groups": ("Filtering",),
            "data_dependent_options": True,
            "data_provider_info": <DataProviderInfo>{
                "type": "QoreFilterRecordsProcessor",
                "supports_pipeline_processor": True,
                "expressions": DataProviderGenericExpressions,
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                {
                    "where_cond": <DataProviderOptionInfo>{
                        "display_name": "Filter Expression",
                        "short_desc": "A boolean filter expression",
                        "desc": "A boolean expression to filter records; matching records pass "
                            "through, non-matching records are dropped",
                        "type": AbstractDataProviderTypeMap."*bool",
                        "server_expression_handling": True,
                    },
                    "dpql_where": <DataProviderOptionInfo>{
                        "display_name": "DPQL Filter",
                        "short_desc": "A filter condition written in DPQL",
                        "desc": "A DPQL string expression to filter records; use this option when writing the "
                            "predicate directly as text instead of using the expression builder",
                        "type": AbstractDataProviderTypeMap."*string",
                        "example_value": "@status == \"active\" && @score >= 90",
                        # DPQL text is data: expanding templates in it would break its own template references
                        # and escapes
                        "supports_expressions": False,
                    },
                }, {
                    "loc": "constructor",
                    "default_view": UiOptionView::Expression,
                }
            ),
        });

        # register select-fields action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "select-fields",
            "display_name": "Select Fields",
            "short_desc": "Select and optionally rename fields from records",
            "desc": "Select specific fields from each record and optionally rename them; "
                "only the selected fields appear in the output.\n\n"
                "Use `name` to keep a field as-is, or `new_name=old_name` to rename it",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "output_data_type": DPAD_MODIFIED_PASS_THROUGH,
            "cls": "DataProvider::QoreSelectFieldsProcessor",
            "groups": ("Transformation",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreSelectFieldsProcessor::ConstructorOptions, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register set-fields action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "set-fields",
            "display_name": "Set Fields",
            "short_desc": "Set fields to constant values in each record",
            "desc": "Add or overwrite fields with constant values in each record passing through "
                "the pipeline",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "output_data_type": DPAD_MODIFIED_PASS_THROUGH,
            "cls": "DataProvider::QoreSetFieldsProcessor",
            "groups": ("Transformation",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreSetFieldsProcessor::ConstructorOptions, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register remove-fields action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "remove-fields",
            "display_name": "Remove Fields",
            "short_desc": "Remove specified fields from records",
            "desc": "Remove one or more fields from each record passing through the pipeline; "
                "fields not in the removal list are passed through unchanged",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "output_data_type": DPAD_MODIFIED_PASS_THROUGH,
            "cls": "DataProvider::QoreRemoveFieldsProcessor",
            "groups": ("Transformation",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreRemoveFieldsProcessor::ConstructorOptions, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register search-replace action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "search-replace",
            "display_name": "Search and Replace",
            "short_desc": "Search and replace text in a record field",
            "desc": "Perform search and replace on a string field in each record; supports both "
                "literal string matching and regular expression patterns",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "output_data_type": DPAD_PASS_THROUGH,
            "cls": "DataProvider::QoreSearchReplaceProcessor",
            "groups": ("Transformation",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreSearchReplaceProcessor::ConstructorOptions{"field", "search", "replace"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreSearchReplaceProcessor::ConstructorOptions{"is_regex", "regex_options"}, {
                    "loc": "constructor",
                }
            ),
        });

        # register record-limit action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "record-limit",
            "display_name": "Record Limit",
            "short_desc": "Limit the number of records passing through",
            "desc": "Limit the number of records passing through the pipeline; the first N records "
                "pass through and all subsequent records are dropped",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_FILTER,
            "output_data_type": DPAD_PASS_THROUGH,
            "cls": "DataProvider::QoreRecordLimitProcessor",
            "groups": ("Filtering",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreRecordLimitProcessor::ConstructorOptions, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register running-stats action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "running-stats",
            "display_name": "Running Statistics",
            "short_desc": "Compute running statistics over windows of numeric records",
            "desc": "Compute running statistics over a sliding window of records for each "
                "configured numeric field; emits one analytics event per field when each "
                "window is full.\n\n"
                "Computed statistics:\n"
                "- `count`, `sum`, `avg` (mean)\n"
                "- `min_val`, `max_val`\n"
                "- `stddev` (standard deviation), `variance`",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QoreRunningStatsProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreRunningStatsProcessor::ConstructorOptions, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register moving-average action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "moving-average",
            "display_name": "Moving Average",
            "short_desc": "Compute simple and exponential moving averages per record",
            "desc": "Compute simple moving average (`SMA`) and exponential moving average (`EMA`) "
                "for each configured numeric field; emits one analytics event per input record "
                "with the current `SMA` and `EMA` values",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QoreMovingAverageProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreMovingAverageProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreMovingAverageProcessor::ConstructorOptions{"ema_alpha",}, {
                    "loc": "constructor",
                }
            ),
        });

        # register trend-analysis action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "trend-analysis",
            "display_name": "Trend Analysis",
            "short_desc": "Detect trends using linear regression over windows of records",
            "desc": "Compute linear regression trend analysis (`slope`, `intercept`, "
                "`r_squared`, `direction`) over a window of records for each configured "
                "numeric field; emits one analytics event per field when each window is full "
                "with the trend direction (`rising`, `falling`, or `flat`)",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QoreTrendAnalysisProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreTrendAnalysisProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreTrendAnalysisProcessor::ConstructorOptions{"direction_threshold",}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ),
        });

        # register anomaly-detection action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "anomaly-detection",
            "display_name": "Anomaly Detection",
            "short_desc": "Detect anomalous values using z-score analysis per record",
            "desc": "Detect anomalous values in each configured numeric field using z-score "
                "analysis against a sliding window; emits one analytics event per input record "
                "indicating whether the value exceeds the configured `threshold`",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QoreAnomalyDetectionProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreAnomalyDetectionProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreAnomalyDetectionProcessor::ConstructorOptions{"threshold",}, {
                    "loc": "constructor",
                }
            ),
        });

        # register percentile action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "percentile",
            "display_name": "Calculate Data Distribution",
            "short_desc": "Computes median, quartiles, and spread of values",
            "desc": "Analyzes the distribution of numeric values in each window by computing "
                "percentiles (median, quartiles, and custom values), interquartile range "
                "(`iqr`), skewness (whether the data leans left or right), and kurtosis "
                "(whether values cluster tightly or spread out).\n\n"
                "For example, for transaction amounts it can show that 50% are under "
                "$100, 90% are under $500, and the spread between the 25th and 75th "
                "percentile is $200.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QorePercentileProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QorePercentileProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QorePercentileProcessor::ConstructorOptions{"percentiles",}, {
                    "loc": "constructor",
                }
            ),
        });

        # register correlation action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "correlation",
            "display_name": "Find Related Fields",
            "short_desc": "Measures how strongly fields move together",
            "desc": "Computes the Pearson correlation coefficient between all pairs of "
                "configured numeric fields to measure how strongly they move together. "
                "Values range from `-1.0` (perfect inverse relationship) to `1.0` (perfect "
                "direct relationship), with `0.0` meaning no linear relationship.\n\n"
                "For example, it can show that temperature and ice cream sales are strongly "
                "correlated (`0.92`) while humidity and sales are weakly correlated (`-0.15`).",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProvider::QoreCorrelationProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreCorrelationProcessor::ConstructorOptions, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register cross-correlation action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "cross-correlation",
            "display_name": "Find Delayed Relationships",
            "short_desc": "Discovers if changes in one field predict changes in another",
            "desc": "Computes time-lagged cross-correlation between two fields to discover "
                "whether changes in one field predict changes in another after a delay.\n\n"
                "For example, it can show that a spike in marketing spend correlates with "
                "increased revenue 3 periods later (`lag = 3`, `correlation = 0.85`).",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProvider::QoreCrossCorrelationProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreCrossCorrelationProcessor::ConstructorOptions{
                    "field_x", "field_y", "window_size",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreCrossCorrelationProcessor::ConstructorOptions{"max_lag",}, {
                    "loc": "constructor",
                }
            ),
        });

        # register histogram action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "histogram",
            "display_name": "Count Value Ranges",
            "short_desc": "Groups values into ranges and counts how many fall in each",
            "desc": "Creates a frequency distribution by dividing the range of values into "
                "bins and counting how many values fall in each bin. Supports `uniform` "
                "(equal-width) and `quantile` (equal-count) binning.\n\n"
                "For example, for response times it can show that 80% of requests complete "
                "in 0-100ms, 15% in 100-200ms, and 5% take over 200ms.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QoreHistogramProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreHistogramProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreHistogramProcessor::ConstructorOptions{"n_bins", "bin_method"}, {
                    "loc": "constructor",
                }
            ),
        });

        # register rate-of-change action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "rate-of-change",
            "display_name": "Measure Speed of Change",
            "short_desc": "Tracks how fast values are changing and accelerating",
            "desc": "Computes the `rate_of_change` (first derivative), `acceleration` "
                "(second derivative), and `percent_change` for each record relative to its "
                "sliding window history.\n\n"
                "For example, it can show that revenue is growing at $1,000/period and "
                "accelerating (the growth rate is itself increasing).",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QoreRateOfChangeProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreRateOfChangeProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreRateOfChangeProcessor::ConstructorOptions{"smoothing",}, {
                    "loc": "constructor",
                }
            ),
        });

        # register ewma-control-chart action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "ewma-control-chart",
            "display_name": "Monitor Process Stability",
            "short_desc": "Detects when values drift outside normal operating range",
            "desc": "Monitors a process using an Exponentially Weighted Moving Average (EWMA) "
                "control chart to detect when values drift outside the normal operating range. "
                "The EWMA smooths out noise while detecting sustained shifts. Each record is "
                "classified as `normal`, `upper_violation`, or `lower_violation`.\n\n"
                "For example, it can detect when a server's average response time gradually "
                "drifts upward beyond its normal range.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QoreEWMAControlChartProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreEWMAControlChartProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreEWMAControlChartProcessor::ConstructorOptions{
                    "lambda", "sigma_multiplier", "target",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register seasonality-detection action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "seasonality-detection",
            "display_name": "Detect Repeating Patterns",
            "short_desc": "Finds cyclical patterns in data automatically",
            "desc": "Detects repeating cyclical patterns in the data using autocorrelation "
                "analysis. It automatically identifies the dominant period without requiring "
                "the user to specify it upfront.\n\n"
                "For example, it can discover that sales data has a weekly pattern "
                "(`period = 7`) with a correlation of `0.85`, or that a temperature sensor "
                "shows both daily (`period = 24`) and yearly patterns.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProvider::QoreSeasonalityDetectionProcessor",
            "groups": ("Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreSeasonalityDetectionProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreSeasonalityDetectionProcessor::ConstructorOptions{
                    "max_period", "min_correlation",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register group-by action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": QoreApp::AppName,
            "path": "/",
            "action": "group-by",
            "display_name": "Group By and Aggregate",
            "short_desc": "Group records by field values and compute aggregates per group",
            "desc": "Group records by one or more field values and compute aggregate "
                "functions per group; emits one output record per group on flush with the "
                "group field values and computed aggregates.\n\n"
                "Supported aggregate functions: `count()`, `sum(field)`, `avg(field)`, "
                "`min(field)`, `max(field)`, `first(field)`, `last(field)`",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProvider::QoreGroupByProcessor",
            "groups": ("Aggregation",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreGroupByProcessor::ConstructorOptions{"aggregates",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreGroupByProcessor::ConstructorOptions{"group_by",}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ),
        });
    };
}

/** @mainpage DataProvider Module

    @tableofcontents

    @section dataproviderintro Introduction to the DataProvider Module

    <img src="Qore-Q-square.svg" width="96" alt="DataProvider module logo"/>

    The %DataProvider module provides APIs for hierarchical data structures from arbitrary sources to be described,
    queried, introspected, and updated.  It supports data providers supporting record-based APIs as well as
    request-reply semantics such as REST schemas or with SOAP messaging, as well as event-based data providers.

    The data provider module supports high-performance reading (native or simulated searching, also with advanced
    search expression support) and writing as well as record creation, upserting, and transaction management for
    record-based data providers if supported by the underlying data provider implementation as well.

    The %Qore command-line program \c qdp provides a user-friendly interface to data provider functionality.
    It auto-detects DPQL search expressions and also supports forcing DPQL parsing with the \c -q/--dpql option,
    for example:
    @code{.py}
qdp mydb/tables/users search -q '@name == "John"'
    @endcode

    @section dataprovider_qdp qdp Command-Line Usage

    The \c qdp CLI exposes the DataProvider API for inspection and data access. It supports DPQL for search criteria,
    auto-detects DPQL expressions by default, and can show DPQL syntax help with \c --dpql-help. For a full DPQL
    reference, see @ref dataprovider_dpql "DPQL - Data Provider Query Language".

    @par Example Searches
    @code{.py}
qdp mydb/tables/users search '@name == "John"'
qdp mydb/tables/users search '@age between 18 and 65'
qdp mydb/tables/users search '(@active == true) && (@age >= 21)'
qdp mydb/tables/users search '@role in ("admin", "editor")'
    @endcode
    Use \c - or \c {} as an empty expression to return all records.

    This module provides the following primary classes:
    - @ref DataProvider::AbstractDataField "AbstractDataField"
    - @ref DataProvider::AbstractDataProcessor "AbstractDataProcessor"
    - @ref DataProvider::AbstractDataProvider "AbstractDataProvider"
    - @ref DataProvider::AbstractDataProviderBulkOperation "AbstractDataProviderBulkOperation"
    - @ref DataProvider::AbstractDataProviderBulkRecordInterface "AbstractDataProviderBulkRecordInterface"
    - @ref DataProvider::AbstractDataProviderFactory "AbstractDataProviderFactory"
    - @ref DataProvider::AbstractDataProviderRecordIterator "AbstractDataProviderRecordIterator"
    - @ref DataProvider::DataProvider "DataProvider"
    - @ref DataProvider::DataProviderBulkRecordIterator "DataProviderBulkRecordIterator"
    - @ref DataProvider::DataProviderPipeline "DataProviderPipeline"
    - @ref DataProvider::DefaultBulkInserter "DefaultBulkInserter"
    - @ref DataProvider::DefaultBulkUpserter "DefaultBulkUpserter"
    - @ref DataProvider::DefaultBulkRecordInterface "DefaultBulkRecordInterface"
    - @ref DataProvider::DefaultRecordIterator "DefaultRecordIterator"
    - @ref DataProvider::QoreDataField "QoreDataField"

    Many classes for specific data types are provided as well.

    @subsection dataprovider_modules Data Provider Modules

    This module uses the \c "QORE_DATA_PROVIDERS" environment variable to register data provider
    modules.  Each data provider registration module must provide one of the following two public functions.

    @subsubsection dataprovider_dynamic_discovery Data Provider Dynamic Discovery

    Implement a public function with the following signature to support dynamic discovery of data providers:
    @code{.py}
# returns a hash of connection provider factory names to module names
public hash<string, string> sub get_data_provider_map() { ... }
    @endcode

    @subsubsection dataprovider_type_dynamic_discovery Data Provider Type Dynamic Discovery

    Implement a public function with the following signature to support dynamic discovery of data provider types:
    @code{.py}
# returns a hash of type prefix paths (ex: \c "qore/sftp") to module names
public hash<string, string> sub get_type_provider_map() { ... }
    @endcode

    Data provider registration modules declared in the \c "QORE_DATA_PROVIDERS" environment variable must
    be separated by the platform-specific @ref Qore::PathSep "PathSep" character as in the following
    examples:

    @par Unix Example
    @verbatim
export QORE_DATA_PROVIDERS=MyDataProvider:OtherDataProvider
    @endverbatim

    @par Windows CMD.EXE Example
    @verbatim
set QORE_DATA_PROVIDERS=MyDataProvider;OtherDataProvider
    @endverbatim

    @par Windows PowerShell Example
    @verbatim
$env:QORE_DATA_PROVIDERS="MyDataProvider;OtherDataProvider"
    @endverbatim

    @section dataprovider_pipelines Data Provider Pipelines

    Data provider pipelines allow for efficient processing of record or other data in multiple streams and, if
    desired, in multiple threads.

    Pipeline data can be any data type except a list, as list values are interpreted as multiple output values in
    @ref DataProvider::AbstractDataProcessor "pipeline procesor objects".

    @section dataprovider_pipeline_bulk_processing Data Provider Pipeline Bulk Processing

    Bulk processing is processing of record data that is in "hash of lists" form, so a single hash, where each key
    value is a list of values for that key.  Records can be formed as by taking each hash key and then using each
    list value in order for the values of each record.  In case a key is assigned a single value instead of a
    list, it's interpreted as constant value for all records.  Note that the first key value for bulk data must be a
    list of values in order for the bulk data to be properly detected.

    Each pipeline processor element must declare if it is compatible with bulk processing by implementing the
    @ref DataProvider::AbstractDataProcessor::supportsBulkApiImpl() "AbstractDataProcessor::supportsBulkApiImpl()"
    method.

    If a processor does not support the bulk API, but bulk data is submitted, then the bulk data will be separately
    iterated, and each record will be passed separately to the processor with a significant performance penalty when
    processing large volumes of data.

    Native bulk readers can return their most efficient runtime representation with
    @ref DataProvider::AbstractDataProviderBulkRecordInterface::getShapedValue()
    "AbstractDataProviderBulkRecordInterface::getShapedValue()".  This preserves
    \c BufferColumns and \c DataFrameBlock values for shape-aware pipelines.  The older
    @ref DataProvider::AbstractDataProviderBulkRecordInterface::getValue()
    "getValue()" method remains the compatibility API and materializes a hash-of-lists view
    when the native block is columnar.

    @subsection dataprovider_pipeline_shapes Data Provider Pipeline Shape Negotiation

    Pipelines can also negotiate explicit data shapes between processor stages with
    @ref DataProvider::DataProviderShape "DataProviderShape".  This extends the older
    \c supportsBulkApi() boolean with enough information to keep columnar data in its
    most useful representation for as long as possible.

    Supported shapes are:
    - @ref DataProvider::DataProviderShape::RowRecords "RowRecords": one logical row at a time
    - @ref DataProvider::DataProviderShape::HashOfLists "HashOfLists": bulk record blocks in hash-of-lists form
    - @ref DataProvider::DataProviderShape::BufferColumns "BufferColumns": dense column blocks represented by
      @ref Qore::SQL::ColumnarResult "ColumnarResult" objects or hashes whose values are typed \c buffer<T>
      columns
    - @ref DataProvider::DataProviderShape::DataFrameBlock "DataFrameBlock": a \c DataFrame object block from the
      \c dataframe module

    Processor classes advertise shapes with
    @ref DataProvider::AbstractDataProcessor::getSupportedInputShapes()
    "AbstractDataProcessor::getSupportedInputShapes()" and
    @ref DataProvider::AbstractDataProcessor::getSupportedOutputShapes()
    "AbstractDataProcessor::getSupportedOutputShapes()".  Pipelines keep the current shape when the next processor
    supports it; otherwise they convert with
    @ref DataProvider::AbstractDataProcessor::convertShape() "AbstractDataProcessor::convertShape()".
    Shape-aware built-in processors preserve \c DataFrameBlock and \c BufferColumns bulk blocks for filter,
    projection, update, search/replace, grouping, and analytics results when they can represent the output columns
    without row materialization.
    \c DataFrameBlock values convert to \c HashOfLists with \c df.toColumnHash() and to row records with
    \c df.toRecords().  \c DataFrameBlock values convert to \c BufferColumns with \c df.toColumnarResult().
    \c BufferColumns values convert back to rows or hash-of-lists for processors that do not yet support dense
    columns directly.

    Data providers advertise native bulk read and write shapes with \c bulk_read_shapes, \c bulk_create_shapes, and
    \c bulk_upsert_shapes in @ref DataProvider::DataProviderInfo "DataProviderInfo".  Callers can inspect these with
    @ref DataProvider::AbstractDataProvider::getBulkReadShapes() "getBulkReadShapes()",
    @ref DataProvider::AbstractDataProvider::getBulkCreateShapes() "getBulkCreateShapes()", and
    @ref DataProvider::AbstractDataProvider::getBulkUpsertShapes() "getBulkUpsertShapes()".  The shaped
    @ref DataProvider::AbstractDataProvider::createRecordsShape() "createRecordsShape()" and
    @ref DataProvider::AbstractDataProvider::upsertRecordsShape() "upsertRecordsShape()" APIs preserve native
    blocks for providers that support them and fall back to hash-of-lists compatibility otherwise.

    @par DataFrame Pipeline Example
    @code{.py}
%requires DataProviderDataFrame

DataFrame::DataFrame orders(
    ({"customer": "Acme", "status": "open", "amount": 150.0},
     {"customer": "Beta", "status": "closed", "amount": 80.0},
     {"customer": "Core", "status": "open", "amount": 220.0}));

hash<DataProviderExpression> filter_expr = <DataProviderExpression>{
    "exp": "&&",
    "args": (
        <DataProviderExpression>{
            "exp": "==",
            "args": (<DataProviderFieldReference>{"field": "status"}, "open"),
        },
        <DataProviderExpression>{
            "exp": ">",
            "args": (<DataProviderFieldReference>{"field": "amount"}, 100.0),
        },
    ),
};

list<hash<auto>> rows;
DataProviderPipeline pipeline(<PipelineOptionInfo>{
    "name": "open-large-orders",
    "output_callback": sub (auto row) {
        push rows, row;
    },
});

pipeline.append(new QoreFilterRecordsProcessor({"where_cond": filter_expr}));
pipeline.submit(orders);
pipeline.waitDone();
# rows now contains the matching DataFrame rows as record hashes.
    @endcode

    The same filter can also be written directly as DPQL:
    @code{.py}
pipeline.append(new QoreFilterRecordsProcessor({
    "dpql_where": '@status == "open" && @amount > 100.0',
}));

# The where_cond option also accepts a DPQL string for simple programmatic setup.
pipeline.append(new QoreFilterRecordsProcessor({
    "where_cond": '@status == "open" && @amount > 100.0',
}));
    @endcode

    @note
    The built-in @ref DataProvider::QoreFilterRecordsProcessor "QoreFilterRecordsProcessor" supports
    \c DataFrameBlock and \c BufferColumns directly when configured with either a structured \c where_cond
    expression, a DPQL \c where_cond string, or a DPQL \c dpql_where string.  Supported scalar comparisons,
    expression-to-expression comparisons, computed arithmetic, numeric function, trim/concat/null-handling,
    case-folding, date-part, and row-independent date arithmetic expressions, \c between, \c inRange,
    \c in, \c notIn, null checks, string predicates including \c containsAny, list membership predicates,
    list/hash accessors, ternary computed values, boolean combinations, and structured strict
    equality/inequality compile to DataFrame row masks or dense ColumnarResult \c buffer<bool> masks;
    BufferColumns temporal comparisons
    against Qore/DPQL date literals compare the dense microsecond values without materializing rows.
    String predicates support the legacy
    bool ignore-case argument and, when the \c i18n module is available, a locale options hash such as
    <tt>{"locale": "tr-TR"}</tt> or <tt>{"locale": "en-US", "strength": "primary"}</tt> for ICU-backed
    locale-sensitive comparison.  BufferColumns input also lowers
    SQL-like \c like and regular expression predicates to dense masks.  More complex expressions fall back
    to row-record evaluation while preserving the negotiated shape when possible.
    @ref DataProvider::QoreSelectFieldsProcessor "QoreSelectFieldsProcessor",
    @ref DataProvider::QoreRemoveFieldsProcessor "QoreRemoveFieldsProcessor", and
    @ref DataProvider::QoreRecordLimitProcessor "QoreRecordLimitProcessor" preserve \c DataFrameBlock and
    \c BufferColumns values for simple top-level field projection/removal and contiguous limiting.
    @ref DataProvider::QoreSetFieldsProcessor "QoreSetFieldsProcessor" and
    @ref DataProvider::QoreSearchReplaceProcessor "QoreSearchReplaceProcessor" also preserve these shapes for
    top-level constant-field and string-column updates.  For \c ColumnarResult input, these projection and
    simple-update processors rebuild the output columnar block from referenced column containers instead of
    constructing an intermediate DataFrame.
    @ref DataProvider::QoreGroupByProcessor "QoreGroupByProcessor" supports \c DataFrameBlock and
    \c BufferColumns input as well; it accumulates logical rows from the block and, when used through pipeline
    \c flush(), preserves a DataFrame, ColumnarResult, or hash-of-lists aggregate block for downstream
    shape-aware processors.
    Analytics processors, including @ref DataProvider::QoreCorrelationProcessor "QoreCorrelationProcessor" and
    @ref DataProvider::QoreCrossCorrelationProcessor "QoreCrossCorrelationProcessor", accept
    \c DataFrameBlock and \c BufferColumns input directly and emit analytics event records as hash-of-lists blocks.
    For top-level configured fields, these processors read only the selected DataFrame or dense ColumnarResult
    columns instead of materializing the full input block as hash-of-lists data.
    Direct calls to \c flushRecords() still return ordinary row records for compatibility.

    @section dataprovider_debugging Debugging Data Providers

    Data providers support an opt-in debug info collection mechanism that allows capturing technical details about
    operations such as HTTP requests, WebSocket messages, and connection events. This is useful for debugging,
    logging, and monitoring data provider interactions.

    @subsection debug_collector_classes Debug Collector Classes

    The following classes are provided for debug info collection:
    - @ref DataProvider::AbstractDebugInfoCollector "AbstractDebugInfoCollector": Abstract base class - implement
      your own collector by overriding the @ref DataProvider::AbstractDebugInfoCollector::collect "collect()" method
    - @ref DataProvider::BufferedDebugInfoCollector "BufferedDebugInfoCollector": Stores debug info in memory for
      later retrieval and analysis
    - @ref DataProvider::ConsoleDebugInfoCollector "ConsoleDebugInfoCollector": Outputs debug info to the console
      immediately, with optional colorized output

    @subsection debug_info_structure Debug Info Structure

    Debug info is captured in the @ref DataProvider::DataProviderDebugInfo "DataProviderDebugInfo" hashdecl which
    includes:
    - Operation type (request, response, connect, disconnect, send, receive)
    - Timestamps and duration
    - URL, HTTP method, and protocol (HTTP/1.1 or HTTP/2)
    - Request and response headers
    - Request and response bodies
    - Status codes and error messages
    - WebSocket message types and sizes
    - TLS/SSL information

    @subsection debug_usage Using Debug Collection

    To enable debug collection, register a debug collector with a data provider:

    @code{.py}
# Using BufferedDebugInfoCollector for programmatic access
BufferedDebugInfoCollector collector();
provider.setDebugCollector(collector);

# Make some requests
auto response = provider.doRequest(request);

# Retrieve collected debug info
list<hash<DataProviderDebugInfo>> info = collector.getAll();
foreach hash<DataProviderDebugInfo> debug in (info) {
    printf("%s %s -> %d (%dms)\n", debug.method, debug.url, debug.status_code, debug.duration_ms);
}

# Clear the buffer when done
collector.clear();
    @endcode

    @code{.py}
# Using ConsoleDebugInfoCollector for immediate output
# Verbosity: 1 = basic, 2 = headers, 3 = full with bodies
ConsoleDebugInfoCollector collector(2);
provider.setDebugCollector(collector);

# Debug info is printed to console as operations occur
auto response = provider.doRequest(request);

# Disable debug collection when done
provider.setDebugCollector();
    @endcode

    @subsection debug_custom_collector Custom Debug Collectors

    You can create custom debug collectors by inheriting from
    @ref DataProvider::AbstractDebugInfoCollector "AbstractDebugInfoCollector":

    @code{.py}
class MyDebugCollector inherits AbstractDebugInfoCollector {
    collect(hash<DataProviderDebugInfo> info) {
        # Log to a file, send to monitoring system, etc.
        logger.info("Operation: %s %s -> %d", info.method, info.url, info.status_code);
    }

    flush() {
        # Called when the data provider is done - flush any buffers
    }

    clear() {
        # Called to clear any collected data
    }
}
    @endcode

    @section dataprovider_dpql DPQL - Data Provider Query Language

    DPQL (Data Provider Query Language) is a human-readable query language for constructing DataProviderExpression
    structures. It provides a simple, intuitive syntax for writing search expressions that can be used with data
    provider search, update, and delete operations.

    @subsection dpql_syntax DPQL Syntax

    DPQL supports the following syntax elements:

    @anchor dpql_field_paths
    @par Field References
    Fields are referenced using the \c \@ prefix.  A field reference is a path: dots separate its parts, the keys
    it reads one after the other, in quoted and unquoted names alike:
    - \c \@name - simple field name: a letter of any script or \c _, then letters, combining marks, digits and
      \c _, such as <tt>\@menge_bestätigt</tt>, <tt>\@größe</tt> or <tt>\@名前</tt>
    - \c \@user.email - dotted paths for nested fields: the key \c email of the key \c user
    - <tt>\@\"field with spaces\"</tt> - quoted field names for characters that an unquoted name cannot hold, or a
      name starting with a digit; <tt>\@\"create.order-id\"</tt> is the key \c order-id of the key \c create
    - <tt>\@\"Unit\\.Price\"</tt> - a dot that is part of a key is escaped: this is the key \c Unit.Price

    In a quoted name, <tt>\\"</tt> is a quote, <tt>\\\\</tt> a backslash, <tt>\\.</tt> a dot that is part of a key,
    and <tt>\\n</tt>, <tt>\\r</tt> and <tt>\\t</tt> a line feed, a carriage return and a tab; any other escape is an
    error (\c DPQL-E003).  The \c field of a @ref DataProvider::DataProviderFieldReference "DataProviderFieldReference"
    holds the path, in which <tt>\\.</tt> is a dot and <tt>\\\\</tt> a backslash of a key (<tt>Unit\\.Price</tt>);
    @ref DataProvider::AbstractDataProvider::getFieldPath() "AbstractDataProvider::getFieldPath()" gives its keys,
    and @ref DataProvider::AbstractDataProvider::escapeFieldPathKey() "AbstractDataProvider::escapeFieldPathKey()"
    escapes a key as one part of a path, which \c getFieldPath() reads back exactly;
    @ref DataProvider::DpqlSerializer::fieldReferenceForKey() "DpqlSerializer::fieldReferenceForKey()" writes the
    field reference to one key, such as the name of a field of a record type.

    A provider that searches on its server names a field in its query language by the keys of the path, never by
    the escaped text of the path:
    @ref DataProvider::AbstractDataProvider::getFieldPathName() "AbstractDataProvider::getFieldPathName()" joins
    them with the separator of the language (\c order.id, or \c order/id in OData).  A key that has the separator
    cannot be named in that language (<tt>\@\"Unit\\.Price\"</tt> in SOQL): depending on the provider, a
    predicate on it is evaluated on the client or raises \c WHERE-ERROR.

    @par Comparison Operators
    These are standard DPQL operators; individual data providers can expose additional or different operators.
    DPQL is translated to native server-side queries whenever possible to ensure maximum performance.
    - \c == - equals
    - \c != - not equals
    - \c < - less than
    - \c <= - less than or equal
    - \c > - greater than
    - \c >= - greater than or equal
    - \c between - range comparison (\c \@age \c between \c 18 \c and \c 65)
    - \c in - set membership (\c \@status \c in <tt>("active", "pending")</tt>)
    - \c =~ - regex match (\c \@email \c =~ <tt>/example.com$/i</tt>)

    @par Logical Operators
    These are standard DPQL operators; individual data providers can expose additional or different operators.
    - \c && - logical AND
    - \c || - logical OR
    - \c ! - logical NOT

    @anchor dpql_exists
    @par Fields That a Record Does Not Have
    A field reference to a field that the record does not have raises an error; <tt>exists \@field</tt> is \c true
    when the record has the field, also when its value is \c null, and \c false when it does not, so records of
    different shapes can be told apart: <tt>exists \@type && \@type == "return"</tt> is \c false for a record
    without \c type, while <tt>\@type == "return"</tt> raises an error for it.  \c exists binds tighter than any
    other operator (<tt>!exists \@type</tt>, <tt>exists \@type == false</tt>), and its field reference can be in
    parentheses (<tt>exists(\@type)</tt>).  Its field reference is a path:
    - <tt>exists \@a.b</tt> and <tt>exists \@a{b}</tt>: the record has \c a, which is a hash with the key \c b
    - <tt>exists \@a[0]</tt>: the record has \c a, which is a list with an element at that position, or a string
      with a character there; a negative position counts from the end
    - wildcards (<tt>[*]</tt>, <tt>{*}</tt>), ranges, and several positions or keys are not accepted
      (\c DPQL-E025); each item is tested with \c any or \c all instead: <tt>any exists \@id, \@orders</tt>
    - the field reference is a path as everywhere else (@ref dpql_field_paths): <tt>exists \@"x.y"</tt> is the
      path \c x, \c y, and <tt>exists \@"a\\.b"</tt> is the key <tt>a.b</tt>

    Whether a field has a value is tested with <tt>isNotNull(\@field)</tt>, which needs the record to have the
    field.  A database cannot search with \c exists, as every row has every column: it is not pushed down, and is
    evaluated on the records read where the provider filters on the client (such as a database table with the
    \c allow_client_side_filter search option); a provider that searches only on its server reports it with
    \c DPQL-E041.

    @par Literals
    - Strings: \c "hello" or \c 'world'
    - Dates: <tt>2026-01-02</tt>, <tt>2026-01-02T15:20:11.123+01:00</tt>; a date or a time of day that does not exist
      (<tt>2026-02-30</tt>, <tt>2026-01-02T24:00</tt>) is refused with \c DPQL-E011, which says which part is out of
      its range
    - Binary: <tt>&lt;deadbeef&gt;</tt>
    - Lists: <tt>(one, two, 3)</tt>
    - Hashes: <tt>{a=1, b=two}</tt>
    - Unquoted identifiers are treated as strings: \c \@domain \c == \c example
    - Numbers: \c 123, \c 45.67, \c -10
    - Booleans: \c true, \c false
    - Null: \c null

    @anchor dpql_number_float
    @par Numbers and Floats
    A decimal literal such as \c 1.19 is a float, as are float fields; a float holds the nearest binary value
    (\c 1.19 is \c 1.18999999999999994670929481799248605966567993164062).  When an arithmetic operator
    (\c +, \c -, \c *, \c /, \c %), a comparison (\c ==, \c !=, \c <, \c <=, \c >, \c >=,
    \c between, \c inRange, \c in, <tt>not in</tt>, \c nullif) or \c toNumber() combines a float with a
    number (an arbitrary-precision field, such as a money amount), the float is converted with
    @ref DataProvider::DataProvider::floatToNumber() "DataProvider::floatToNumber()": to the number that its
    decimal representation with 15 significant digits gives.  So <tt>\@price * 1.19</tt> for a number field
    \c price of \c 2125 gives the same number as <tt>2125n * 1.19n</tt> in %Qore (\c 2528.75), and
    <tt>\@rate == 1.19</tt> is \c true for a number field \c rate of \c 1.19n.  Without this conversion, the
    float's binary value would show: <tt>2125n * number(1.19)</tt> is \c 2528.7499999999997875.
    - a float's digits after the 15th significant digit are lost; a double cannot hold them exactly anyway
    - numbers are binary floating-point values with a larger precision, not decimal values: a number literal such
      as \c 1.19n is itself the binary value nearest to the decimal value, so <tt>2125n * 1.19n</tt> prints as
      \c 2528.75 but is not equal to \c 2528.75n
    - operations on two floats, on two integers, and on an integer and a number are not affected; NaN and infinity
      are converted as with @ref Qore::number() "number()"

    @par Function Calls
    Custom functions can be used: <tt>calculate(\@score, 100)</tt> \c > \c 50
    Built-in DataProvider functions such as <tt>containsAny(\@name, "li", "av")</tt>,
    <tt>listContains(\@tags, "vip")</tt>, and
    <tt>listContainsAny(\@tags, "trial", "standard")</tt> are available when the target provider exposes them.
    The varargs form is the clearest DPQL syntax for list/string "any" predicates.

    @par Accessors
    DPQL can access nested values without changing the source record shape:
    - <tt>\@scores[0] &gt;= 90</tt> - list or string index accessor
    - <tt>\@scores[0..1]</tt> - list slice accessor
    - <tt>\@payload{region} == "EU"</tt> - hash key accessor
    - <tt>\@items[0].id</tt> - a member after an accessor: the key \c id of the first item
    - <tt>\@orders[*].id</tt> and <tt>\@prices{*}</tt> - @ref dpql_wildcards "wildcard accessors": a value from
      each item of a list or each value of a hash

    @par Expression Operators
    Operators that evaluate subexpressions in an operator-controlled context use Qore-style operator syntax
    instead of function-call syntax:
    - <tt>map \@name, \@users, \@age &gt; 28</tt> - evaluates the body expression against each element
      of the source list and optionally filters elements
    - <tt>hash_map \@name, \@age, \@users</tt> - evaluates key and value expressions against each
      element of the source list and returns a hash

    @anchor dpql_item_context
    @par The Current Item In The Template Context
    The body, filter, key, value and predicate expressions of these operators (\c map, \c hash_map, \c select,
    \c first, \c any, \c all, \c count, \c takewhile, \c takeuntil) and the expression after a
    @ref dpql_wildcards "wildcard" are evaluated for each item of the source; they are the arguments that
    @ref DataProvider::DpqlParser::isItemScopedArg() "DpqlParser::isItemScopedArg()" reports.  While they are
    evaluated, the template context holds the current item as \c item, its zero-based position in the source as
    \c index and the number of items in the source as \c size, so that a template callback that resolves
    \c $local values from the template context (as Qorus does) gives <tt>$local:item</tt>, <tt>$local:index</tt>
    and <tt>$local:size</tt>:
    - <tt>map concat($local:index, ":", $local:item), \@tags</tt> - each tag with its position
    - <tt>select \@rows, $local:index < $local:size - 1</tt> - all rows but the last
    - <tt>hash_map $local:item.key, $local:index, \@weights</tt> - for a hash source, the item is the \c key /
      \c value entry

    A nested operator's values replace the outer ones while it is evaluated, and the outer values are back once it
    is done.  The other values of the caller's template context stay available; the caller's template context is
    never changed, also when an expression raises an error.  Other arguments, such as the source and the count of
    \c take, are evaluated with the caller's template context.

    @subsection dpql_wildcards Wildcard Accessors

    The wildcard accessors \c [*] and \c {*} take a value from each item of a list and from each value of a hash.
    A wildcard is the \c map operator written as an accessor: the accessors after it are the expression that
    \c map evaluates for each item, and the wildcard evaluates exactly as that \c map expression does.

    |!Wildcard|!Same as|!Result
    |<tt>\@orders[*].id</tt>|<tt>map \@id, \@orders</tt>|the \c id of each order
    |<tt>\@orders[*].customer.name</tt>|<tt>map \@customer.name, \@orders</tt>|the customer name of each order
    |<tt>\@orders[*]{"order-id"}</tt>|<tt>map \@"order-id", \@orders</tt>|a key that is not a name
    |<tt>\@orders[*].tags[0]</tt>|<tt>map \@tags[0], \@orders</tt>|the first tag of each order
    |<tt>\@orders[*].items[*].sku</tt>|<tt>map (map \@sku, \@items), \@orders</tt>|a list with the list of SKUs of each order
    |<tt>\@prices{*}</tt>|<tt>map \@value, \@prices</tt>|the values of the hash, in key order
    |<tt>\@prices{*}.amount</tt>|<tt>map \@value.amount, \@prices</tt>|the \c amount of each value
    |<tt>\@orders[*]</tt>|<tt>\@orders</tt>|the items of the list: the list itself
    |<tt>\@matrix[*][0]</tt>|<tt>map \@value[0], \@matrix</tt>|the first element of each list

    - after \c [*], a first accessor that names a field (<tt>.name</tt>, or <tt>{"key"}</tt> with one key) reads that
      field of each item as <tt>\@name</tt> does in the body of \c map, and the <tt>.name</tt> steps right after it
      are part of the same field reference, as in <tt>\@customer.name</tt>; ordinary accessors can follow
      (<tt>\@orders[*].tags[0]</tt>, <tt>\@orders[*].customer{"name"}</tt>)
    - after \c [*], any other accessor applies to the item itself, so <tt>\@matrix[*][0]</tt> is the first element
      of each list in \c matrix; and a trailing \c [*] gives the items themselves: the list itself, or the
      \c key / \c value records of the entries of a hash, as \c select gives them
    - after \c {*}, the accessors apply to each value, which is \c \@value in the body of \c map; a trailing
      \c {*} gives the values
    - wildcards nest without flattening: each wildcard gives one list, so <tt>\@orders[*].items[*].sku</tt> is a
      list of lists
    - everything else is as \c map does it, with the same results and the same errors: an item that does not have
      the field is an \c INVALID-OPERATION error, a source that is not a list or a hash (including no value) is a
      \c DATA-PROVIDER-EXPRESSION-ERROR, and an empty list or hash gives an empty list; \c [*] over a hash goes
      through its \c key / \c value entries (<tt>\@weights[*].key</tt> is the keys), and \c {*} over a list gives
      the \c \@value of each element
    - a quoted key is never a wildcard: <tt>\@data{"*"}</tt> is the key \c *
    - a wildcard is kept as written when an expression is serialized
      (@ref DataProvider::DataProvider::serializeDpqlExpression() "serializeDpqlExpression()"); its type
      (@ref DataProvider::ExpressionTypes "ExpressionTypes") is a list of the type of the value taken from each item
      when that is known (<tt>list&lt;int&gt;</tt> for <tt>\@orders[*].id</tt> when \c id is an \c int field),
      and completion offers \c [*] after a list and \c {*} after a hash

    In a @ref DataProvider::DataProviderExpression "DataProviderExpression", a wildcard is a
    @ref DataProvider::DP_FUNC_LIST_WILDCARD "DP_FUNC_LIST_WILDCARD" or
    @ref DataProvider::DP_FUNC_HASH_WILDCARD "DP_FUNC_HASH_WILDCARD" expression whose arguments are the source and
    the expression evaluated for each item, as the body of \c map; accessors that apply to the item itself start
    from @ref DataProvider::DP_FUNC_WILDCARD_ITEM "DP_FUNC_WILDCARD_ITEM".  \c DP_FUNC_WILDCARD_ITEM is
    @ref DataProvider::DataProviderExpressionBaseInfo::internal "internal" in the expression catalog: it is never
    offered for picking and is drawn only inside the wildcard that makes it.

    @par Example
    @code{.py}
hash<auto> rec = {
    "orders": (
        {"id": 1, "items": ({"sku": "a"}, {"sku": "b"})},
        {"id": 2, "items": ({"sku": "c"},)},
    ),
};
# (1, 2)
auto ids = AbstractDataProvider::evalGenericExpressionValue(rec,
    DataProvider::parseDpqlExpression("@orders[*].id"));
# (("a", "b"), ("c",))
auto skus = AbstractDataProvider::evalGenericExpressionValue(rec,
    DataProvider::parseDpqlExpression("@orders[*].items[*].sku"));
# True
auto has_2 = AbstractDataProvider::evalGenericExpressionValue(rec,
    DataProvider::parseDpqlExpression('listContains(@orders[*].id, 2)'));
    @endcode

    @subsection dpql_examples DPQL Examples

    @par Simple Comparison
    @code{.py}
# Parse a simple equality expression
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression('@name == "John"');
# Result: {"exp": "==", "args": [{"field": "name"}, "John"]}
    @endcode

    @par Complex Query
    @code{.py}
# Parse a complex query with multiple conditions
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression(
    '@age > 18 && @status == "active" || @role == "admin"');
    @endcode

    @par Range Query
    @code{.py}
# Find records where age is between 18 and 65
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression('@age between 18 and 65');
    @endcode

    @par Set Membership
    @code{.py}
# Find records with specific status values
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression(
    '@status in ("pending", "active", "review")');
    @endcode

    @par Nested Values And Lists
    @code{.py}
# Find high-scoring EU records tagged as VIP or trial
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression(
    '@payload{region} == "EU" && @scores[0] >= 90 && listContainsAny(@tags, "vip", "trial")');
    @endcode

    @par Structured Ternary Expression
    @code{.py}
# Ternary expressions are represented directly as DataProviderExpression hashes
hash<DataProviderExpression> size_bucket = <DataProviderExpression>{
    "exp": DP_SEARCH_OP_EQ,
    "args": (
        <DataProviderExpression>{
            "exp": DP_OP_TERNARY,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_SEARCH_OP_GE,
                    "args": (<DataProviderFieldReference>{"field": "amount"}, 150.0),
                },
                "large",
                "small"
            ),
        },
        "large"
    ),
};
    @endcode

    @par Regex Matching
    @code{.py}
# Find email addresses from a specific domain (case-insensitive)
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression('@email =~ /example.com$/i');
    @endcode

    @par Date Literal
    @code{.py}
# Find records created before a specific date
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression('@created < 2026-12-01');
    @endcode

    @par Binary Literal
    @code{.py}
# Match a binary hash field
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression('@checksum == <deadbeef>');
    @endcode

    @par Negation
    @code{.py}
# Find non-deleted records
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression('!(@deleted == true)');
    @endcode

    @par Using with Data Providers
    @code{.py}
# Search a data provider using parsed DPQL
hash<DataProviderExpression> where = DataProvider::parseDpqlExpression(
    '@created > 2024-01-01 && @type == "order"');
AbstractDataProviderRecordIterator i = provider.searchRecords(where);

# Providers that support search expressions can also accept a DPQL string directly
AbstractDataProviderRecordIterator i2 = provider.searchRecords(
    '@created > 2024-01-01 && @type == "order"');
    @endcode

    @subsection dpql_round_trip Round-Trip Conversion

    DPQL expressions can be serialized back to strings:
    @code{.py}
# Parse and serialize an expression
hash<DataProviderExpression> exp = DataProvider::parseDpqlExpression('@name == "John" && @age > 18');
string dpql = DataProvider::serializeDpqlExpression(exp);
# Result: '@name == "John" && @age > 18'
    @endcode

    Accessors are written as they are read:
    - a single key that is a name, after an accessor, is written as a member: <tt>\@items[0]{id}</tt> and
      <tt>\@items[0].id</tt> are both written <tt>\@items[0].id</tt>; other keys keep their braces, quoted when
      they are not names (<tt>\@items[0]{"order id"}</tt>, <tt>\@items[0]{"true"}</tt>, <tt>\@items[0]{a, b}</tt>)
    - a key of a field reference keeps its braces (<tt>\@record{id}</tt>), since <tt>\@record.id</tt> is the field
      <tt>record.id</tt>
    - an accessor whose index or key is not a literal (<tt>index(\@items, \@i)</tt>), or that applies to a value
      that is not a field reference or another accessor, such as a wildcard (<tt>index(\@orders[*].id, 0)</tt>), a
      template reference, a call or an operation, is written as a call

    @subsection dpql_diagnostics Error Handling and Diagnostics

    The parser provides detailed diagnostics for syntax errors:
    @code{.py}
# Parse with diagnostics
hash<DpqlParseResult> result = DataProvider::parseDpqlExpressionWithInfo('@name ==');
if (!result.success) {
    foreach hash<DpqlDiagnostic> diag in (result.diagnostics) {
        printf("Error at line %d, column %d: %s (code: %s)\n",
            diag.line, diag.column, diag.message, diag.code);
    }
}
# Error at line 1, column 7: Something is missing at the end: a value after '=='. (code: DPQL-E001)
    @endcode

    A diagnostic's message is written for a person who builds an expression from lists of fields and templates:
    it says in plain words what is wrong and how to make the text valid, without naming parts of the grammar, as in
    <tt>"A `$` starts a template: pick one from the list, or remove the `$`."</tt> or
    <tt>"Something follows a complete value here: join them with an operator, such as +, == or &&."</tt>.  A
    program that reacts to a diagnostic reads its \c code and its range, which do not change when a message is
    reworded; one code can have a message for each situation that raises it.  A character or a token that a
    diagnostic has reported is not reported a second time by a diagnostic about the same text, nor is text that an
    earlier error made unreadable, such as the closing quote of a field name written on the next line.  A template
    without what it refers to after its \c ':' (<tt>$local:</tt>) is refused wherever it is written, also when
    something follows it (\c DPQL-E033).

    @ref DataProvider::DpqlParser::parse() "DpqlParser::parse()" and
    @ref DataProvider::DataProvider::parseDpqlExpression() "DataProvider::parseDpqlExpression()" throw
    \c DPQL-PARSE-ERROR with the position and the message of the first diagnostic in the description
    (<tt>DPQL parse error at line 1, column 7: Something is missing at the end: a value after '=='.</tt>) and the
    list of diagnostics as the exception argument.

    @subsection dpql_syntax_highlighting Syntax Highlighting

    For IDE integration, DPQL provides token information with position tracking:
    @code{.py}
# Get tokens for syntax highlighting
list<hash<DpqlTokenInfo>> tokens = DataProvider::getDpqlTokens('@name == "John"');
foreach hash<DpqlTokenInfo> tok in (tokens) {
    printf("Token: type=%d value='%s' at line %d, col %d\n",
        tok.type, tok.value, tok.line, tok.column);
}
    @endcode

    Token types include:
    - \c DPQL_TOK_FIELD (1) - field references
    - \c DPQL_TOK_STRING (2) - string literals
    - \c DPQL_TOK_NUMBER (3) - numeric literals
    - \c DPQL_TOK_BOOLEAN (4) - boolean values
    - \c DPQL_TOK_IDENTIFIER (6) - identifiers/keywords
    - \c DPQL_TOK_DATE (7) - date literals
    - \c DPQL_TOK_BINARY (8) - binary literals
    - \c DPQL_TOK_LIST (21) - list literals
    - \c DPQL_TOK_HASH (22) - hash literals
    - \c DPQL_TOK_OP_EQ (10) through \c DPQL_TOK_OP_REGEX (19) - operators
    - \c DPQL_TOK_REGEX (20) - regex patterns

    @subsection dpql_completions Auto-Completion

    For IDE integration, DPQL provides context-aware completions:
    @code{.py}
# Get completions at cursor position
hash<string, AbstractDataField> fields = {
    "name": new QoreDataField("name", "Name", StringType),
    "age": new QoreDataField("age", "Age", IntType),
    "email": new QoreDataField("email", "Email", StringType),
};
list<hash<DpqlCompletionItem>> items = DataProvider::getDpqlCompletions('@na', 3, fields);
# Returns completions matching "na", e.g., [{"label": "name", "kind": "field", "detail": "Text", ...}]
    @endcode

    The \c detail of a completion item says in plain words what the item is, with the type names of the
    @ref DataProvider::DataTypeCatalogue "DataTypeCatalogue": the type of a field or a template value
    (\c "Whole number"), what a function or an operator gives (\c "gives true or false"), what the argument that the
    cursor is in takes (\c "this argument takes text"), and that a template context needs a value after its \c ':'
    (\c "needs a value after ':'").  A client that needs to tell kinds of items apart reads the item's \c kind, not
    its \c detail.

    In an empty document, or one with only spaces, completion offers what can start an expression: the fields, the
    template contexts, the functions and the operators that can start a value, as after an operator.

    @subsection dpql_websocket DPQL WebSocket API

    The DPQL WebSocket API is provided by the optional @ref dpqlwebsocketintro "DpqlWebSocket" module. It exposes
    language-server services for tokenization, parsing, validation, and completion, and can be used by UI clients
    for syntax highlighting, diagnostics, and completions in the context of a data provider.

    For Creator WebSocket integrations, the action-based @ref DataProvider::DpqlActionSession "DpqlActionSession"
    class provides a transport-agnostic DPQL service with context-aware operations and token output suitable for
    editor integrations.

    @code{.py}
%requires HttpServer
%requires DpqlWebSocket

DataProvider::DpqlWebSocketHandler handler();
HttpServer server({"port": 8080});
server.addHandler("/ws/dpql", handler);
server.start();
    @endcode

    The WebSocket message protocol is defined in:
    - @c DpqlWebSocket/DpqlApi.asyncapi.yaml

    @subsection dpql_validation Expression Validation

    @ref DataProvider::AbstractDataProvider::prepareExpression() "AbstractDataProvider::prepareExpression()", which
    prepares an expression for generic evaluation (as \c filter-records does), verifies every expression in the
    tree: an expression that is unknown, or called with fewer arguments than it requires or more than it accepts,
    raises a \c DATA-PROVIDER-EXPRESSION-ERROR before any record is evaluated.

    Expressions can be validated against available fields:
    @code{.py}
# Validate expression against fields
hash<string, AbstractDataField> fields = {
    "name": new QoreDataField("name", "Name", StringType),
};
list<hash<DpqlDiagnostic>> errors = DataProvider::validateDpqlExpression(
    '@unknown_field == "test"', fields);
if (errors) {
    printf("Validation error: %s\n", errors[0].message);
    # Output: "Validation error: Unknown field 'unknown_field'"
}
    @endcode

    Validation also checks the operands of the arithmetic operators, from literals, field types and nested
    arithmetic.  DPQL arithmetic is %Qore arithmetic, which combines any two values: an operand that the operator
    cannot use is converted silently, so <tt>\@create + 1</tt> for a hash field \c create evaluates to \c 1.  Such
    a combination is reported as error \c DPQL-E050; evaluation itself is unchanged.  The combinations that are
    accepted:
    - \c +: numbers; a number and a date (seconds); a string with a string, number, date or boolean (joined as
      text); a list with any value (appended); two hashes (merged); two binary values (joined)
    - \c -: numbers; a date minus a date or a number; a hash minus a string or a list of strings (keys removed)
    - \c *, \c /, \c %: numbers
    An operand whose type can hold more than one kind of value (ex: \c data, a string or binary value) or any value
    is not checked.

    A comparison whose result is the same for every record, because it compares a value with itself
    (<tt>\@price > \@price</tt>, <tt>\@a + 1 == \@a + 1</tt>) or two literal values (<tt>1 == 1</tt>), is reported
    as warning \c DPQL-W006.

    @section dataprovider_watch Watch Data Providers

    A <b>watch data provider</b> polls an external system and raises an event for each new item it
    finds. Getting that right is mostly about one question: what happens to an item when something
    fails? The answers are contracts, not implementation details, so they are stated here.

    @subsection dataprovider_watch_template The Shared Processing Sequence

    @ref DataProvider::AbstractOrderedWatchDataProvider "AbstractOrderedWatchDataProvider" implements
    the sequence every ordered watch provider needs:

    @code
fetch
  -> discard items at or before the durable cursor
  -> sort ascending by the provider-defined ordering key
  -> optionally collapse superseded items (snapshot mode)
  -> optionally bound the batch from the oldest end (dispatch budget)
  -> for each item: fetch payload -> dispatch -> persist and advance the cursor
                    -> run the post-success hook -> apply the superseded action
    @endcode

    A provider supplies only the provider-specific pieces as typed hooks over
    @ref DataProvider::WatchItemInfo "WatchItemInfo" descriptors. Items are cheap descriptors, not
    payloads, so ordering and collapse decisions are made before anything expensive is retrieved.

    @ref DataProvider::AbstractTimestampWatchDataProvider "AbstractTimestampWatchDataProvider"
    implements the common "records changed since <i>t</i>" cursor on top of it: a timestamp plus the
    IDs already delivered at exactly that timestamp, which is what makes the cursor safe at its own
    boundary.

    @subsection dataprovider_watch_ordering Dispatch Order

    Events representing an ordered feed are dispatched in ascending source order. This is a
    correctness property, not a presentation one: a watch cursor is monotonic, so dispatching a newer
    item before an older one advances the cursor past an item that has not been delivered, and a
    failure at that point drops the older item permanently.

    Every provider declares how its upstream feed is ordered with
    @ref DataProvider::AbstractWatchDataProviderBase::getSourceOrdering() "getSourceOrdering()":

    |!Classification|!Meaning
    |@ref DataProvider::WSO_ASCENDING|the upstream API returns items in ascending source order
    |@ref DataProvider::WSO_DESCENDING|the upstream API returns items newest-first; the provider reverses them
    |@ref DataProvider::WSO_UNORDERED|the feed has no comparable source order, so no ordering can be guaranteed
    |@ref DataProvider::WSO_UNKNOWN|the upstream ordering has not been established; the provider orders items \
        itself before delivery, but makes no claim about the API

    @ref DataProvider::AbstractWatchDataProviderBase::hasAscendingDispatch() "hasAscendingDispatch()"
    answers the question a consumer actually cares about: whether events arrive oldest-first. Both
    ascending and descending upstream feeds do; an unordered feed does not.

    @subsection dataprovider_watch_failure Advance On Success Only

    The cursor advances only after an item has been dispatched successfully, and a cycle <b>stops at
    the first failure</b> rather than continuing with later items. Continuing would advance the
    monotonic cursor past the failed item and lose it. The failed item and everything after it is
    retried on the next cycle, so delivery is <b>at-least-once</b> and never at-most-once.

    The same rule applies to the checkpoint write itself: the replacement checkpoint is stored before
    the in-memory cursor changes, so a storage failure retries the item instead of silently advancing
    past it.

    An item is never skipped to unblock the feed, because skipping is exactly the loss this rule
    exists to prevent. The cost is that an item that fails permanently holds the feed indefinitely,
    so the block is reported rather than left to be inferred from a log that has gone quiet:
    @ref DataProvider::AbstractOrderedWatchDataProvider::setWatchItemBlockedHandler() "setWatchItemBlockedHandler()"
    registers a handler called once the same item has failed a configurable number of consecutive
    cycles, and called again when that item is finally delivered.

    @subsection dataprovider_watch_durability Durability

    Checkpoint persistence is optional at this layer because %Qore does not own a database:
    - <b>with</b> a callback configured through
      @ref DataProvider::AbstractWatchDataProviderBase::setCheckpointPersistence() "setCheckpointPersistence()":
      the cursor survives a host reload or restart, so an item that was never delivered is still
      delivered afterwards;
    - <b>without</b> one: the cursor lives only in memory, and behavior after a restart is
      provider-specific — typically the provider resumes from its configured start position, or from
      the restart time when it has none, which means items that arrived while it was down are never
      reported.

    The checkpoint value is opaque to the base class; each provider validates and restores its own
    format and rejects one it does not recognize, so a stored checkpoint from a different provider or
    an older format cannot be silently ignored.

    @subsection dataprovider_watch_snapshot Snapshot Collapse

    Some feeds are snapshots rather than logs: each item restates the current state, so after an
    outage only the last one is worth processing. A provider that supports snapshot mode raises one
    event per group carrying the newest item, reports what it collapsed away in the event metadata,
    and can optionally remove the superseded items — see
    @ref DataProvider::WatchSupersededAction "WatchSupersededAction". Superseded items are identified
    before their payloads are retrieved, so a large backlog costs one payload retrieval per group
    rather than one per item.

    A superseded-item removal that fails is logged and the item is left in place; it is not retried,
    because the retained event has already been raised and the cursor has already moved past it. The
    item is therefore never raised as an event again, but it is also never lost silently.

    @subsection dataprovider_watch_delivery Observer Failures Reach The Source

    @ref DataProvider::Observable::notifyObservers() "notifyObservers()" notifies every subscribed
    observer, collects the failures, and then throws an aggregate \c OBSERVER-NOTIFICATION-ERROR
    exception carrying the individual exceptions.

    Both halves of that are load-bearing. Notifying every observer means one broken handler cannot
    starve the handlers registered after it. Letting the failures out means the event source is told
    the truth: a watch provider's entire durability guarantee rests on the fact that raising an event
    returned without an exception, so an observer that catches its own processing failure and returns
    normally reports the item as delivered. The cursor then advances past it and any post-dispatch
    action runs — the item is lost, silently, and the log shows a clean cycle.

    An @ref DataProvider::Observer "Observer" that cannot process an event therefore lets the
    exception out. An event source that genuinely wants no back-pressure — a fire-and-forget push
    feed with no cursor to protect — catches around
    @ref DataProvider::Observable::notifyObservers() "notifyObservers()" itself, where the decision
    is visible in the source rather than hidden in every handler.

    @subsection dataprovider_watch_removal Removal Follows The Delivery Call

    A watch provider observes exactly one thing: that raising an event returned without an exception.
    Because observer failures reach it (see @ref dataprovider_watch_delivery), that one fact covers a
    consumer that does its work <b>in the delivery thread</b>: the consumer signals failure by
    throwing, the cycle stops without advancing the cursor, no removal runs, and the item is
    delivered again on the next cycle.

    It does not — and at this layer cannot — cover a consumer that hands the event off to another
    thread, queue, or process. There the delivery call returns as soon as the hand-off succeeds, so
    an option that removes the source item after its event has been raised (deleting mail, flagging a
    message, emptying a queue) removes it while the real work is still outstanding. Providers
    document such options in exactly those terms and must not describe them as covering an
    asynchronous consumer.

    For a workload with an asynchronous consumer, leave those options unset and act from the consumer
    once processing has succeeded: every event carries the identity of its source item, and providers
    expose first-class actions that take it.

    @section dataprovider_relnotes Release Notes

    @subsection dataprovider_v3_11 DataProvider v3.11
    - added @ref DataProvider::AbstractDataProviderType::getConfigInfo() "AbstractDataProviderType::getConfigInfo()",
      which describes a type itself (its name, path, base type, options, default value, whether it is mandatory, its
      tags and, for a hash type that declares no fields, the type of its other fields) without its fields, element
      type or union members; a field's configuration information
      (@ref DataProvider::AbstractDataField::getConfigInfo() "AbstractDataField::getConfigInfo()") now uses it, so
      reading it no longer takes time in proportion to the size of the field's type graph, which made it many times
      slower for large or cyclic types such as those of big REST schemas
    - added @ref DataProvider::ActionOptionBaseInfo::validation_regex_desc "validation_regex_desc" to the action
      option info, beside \c validation_regex: a description in plain words of the values that the pattern accepts,
      written to complete "Must be ...", so that a user interface can say why it refuses a value instead of saying
      that the value does not match the pattern; it is read from the \c validation_regex_desc attribute of a field
      and written back to it, kept in the data provider index, and set by the REST schema field overlays; the string
      format types (\c email, \c uri, \c uuid, \c hostname, \c ipv4, \c ipv6 and \c phone) give one for their
      patterns in the new \c qore.validation_regex_desc tag and
      @ref DataProvider::QoreStringFormatDataType::getValidationRegexDesc()
      "QoreStringFormatDataType::getValidationRegexDesc()"; it is translated with the other texts of an option or of
      a field of an option's type: \c qore-data-provider-i18n extracts it to the provider's catalogs, and
      @ref DataProvider::DataProviderPresentationCatalog "DataProviderPresentationCatalog" presents its translation
      in the requested locale; the translated texts are listed in the new
      @ref DataProvider::DataProviderPresentation::PresentationFields "DataProviderPresentation::PresentationFields"
    - fixed every error raised while evaluating an expression being described as an error in the return value type
      of each expression that it passed through (<tt>error in return value type "bool" for ">" expression: error in
      return value type "auto" for "/" expression: division by zero found in integer expression</tt>); an error
      keeps its own description, and only a result that an expression's return type does not accept is described
      so
    - added @ref DataProvider::DpqlSerializer::templateReference() "DpqlSerializer::templateReference()", which
      writes a template reference in the form that the parser reads back: a value with characters other than letters,
      digits, \c _, \c . and \c *, and an empty value, in braces (<tt>$local:{order id}</tt>, <tt>$var:{}</tt>);
      the serializer and @ref DataProvider::DataProvider::renderExpression() "DataProvider::renderExpression()" write
      a template reference given by its context and value this way
    - added @ref DataProvider::DataTypeCatalogue "DataTypeCatalogue" and
      @ref DataProvider::DataTypeCatalogueInfo "DataTypeCatalogueInfo", the names in plain words with which a user
      interface shows the data types to a person: a label (\c "Whole number") and the form used inside a sentence
      (\c "a whole number") for each base type and for the types of this module with a presentation of their own;
      DPQL completion names types with them
    - an allowed value or element choice that is a string with a NUL character, which cannot be a key of the set of
      allowed values, raises \c RUNTIME-TYPE-ERROR when it is set on a field or type, and a value with a NUL
      character is refused as outside the allowed values (\c FIELD-VALUE-ERROR or \c TYPE-VALUE-ERROR); before, the
      allowed values of a field and a value checked against them were cut at the NUL character, so that a value
      could be accepted that was not an allowed value.  @ref DataProvider::AbstractDataField::setAllowedValues()
      "setAllowedValues()" now leaves the previous allowed values of a field when it refuses a list
    - DPQL field completion follows field paths: after \c @ and a path of keys (<tt>\@create.</tt>,
      <tt>\@create.it</tt>), it offers the keys of the type the path reaches, each inserted as the field reference to
      its path as the serializer writes it (<tt>\@create.items</tt>, <tt>\@"create.order-id"</tt>); after accessors and
      a dot (<tt>\@create.items[*].</tt>, <tt>\@stats{*}.</tt>), it offers the keys of the value the accessors give,
      each inserted as the member after the dot (\c id, <tt>\@"Unit.Price"</tt>), also after a member written so
      (<tt>\@create.items[*].order-id.</tt>, <tt>\@create.items[*].\@"Unit.Price".</tt>) and after a quoted field
      reference (<tt>\@"create.unit price".</tt>); in an open quoted field reference (<tt>\@"create.</tt>,
      <tt>\@"create.order-</tt>), it offers the keys of the path typed in the quotes, read as the parser reads it (an
      escaped dot is part of a key), each inserted as the field reference to its path, and in an open quoted member
      (<tt>\@create.items[*].\@"Unit.</tt>) the keys that start with the text typed; as a key of a list is the key
      of each of its items at run time, a key accessor or a member after a list (<tt>\@items{</tt>,
      <tt>\@items{product}.</tt>, <tt>\@items[0..1]{</tt>) offers the keys of its items, through nested lists;
      quoted text in an accessor does not end it (<tt>\@spec{"a}b"}.</tt>); inside an accessor that has been
      opened, it offers the wildcard \c * in <tt>[</tt> after a list and in <tt>{</tt> after a hash; after a slice of
      a list (<tt>\@orders[0..1]</tt>) or a key of a list (<tt>\@items{product}</tt>), which give a list, it offers
      \c [*] and not \c {*}.  A type without known fields offers no keys.  The new
      @ref DataProvider::DpqlSerializer::fieldReferenceForPath() "DpqlSerializer::fieldReferenceForPath()" and
      @ref DataProvider::DpqlSerializer::memberNameForKey() "DpqlSerializer::memberNameForKey()" give these forms
    - added @ref DataProvider::DpqlSerializer::fieldReference() "DpqlSerializer::fieldReference()" and
      @ref DataProvider::DpqlSerializer::accessorForm() "DpqlSerializer::accessorForm()", which give the forms in
      which @ref DataProvider::DataProvider::renderExpression() "DataProvider::renderExpression()" and the DPQL
      serializer write a field reference and the accessors and wildcards on it: \c @pos,
      <tt>\@"create.order-id"</tt>, <tt>\@"Unit\\.Price"</tt>, <tt>\@orders[*].id</tt>
    - added @ref DataProvider::AbstractDataProvider::getFieldListOption() "AbstractDataProvider::getFieldListOption()",
      with which the processors read a list option of fields: each element of a list is one field, as it is given,
      so a field whose name has a comma (\c "Price, USD") can be given in a list, and a single string is a
      comma-separated list (@ref DataProvider::AbstractDataProvider::parseFieldList()
      "AbstractDataProvider::parseFieldList()")
    - @ref DataProvider::AbstractDataProvider::splitPushdownableExpression()
      "AbstractDataProvider::splitPushdownableExpression()" and
      @ref DataProvider::AbstractDataProvider::expressionPushdownable()
      "AbstractDataProvider::expressionPushdownable()" take an optional closure that gives the field reference a
      provider reads for a field reference of the expression, or no value if the provider cannot name the field, whose
      expression is then evaluated client-side; the pushdown part has the field references the closure gives; added
      @ref DataProvider::AbstractDataProvider::translateFieldReferences()
      "AbstractDataProvider::translateFieldReferences()"
    - added @ref DataProvider::AbstractDataProvider::getFieldPathName() "AbstractDataProvider::getFieldPathName()",
      which gives the keys of a field path joined with the separator of a query language (\c order.id, or
      \c order/id in OData), or no value for a key that has the separator, so that a query is never sent the
      escaped text of a field path
    - added the private method \c readLocationGrid() to
      @ref DataProvider::AbstractTabularProfileDataProvider "AbstractTabularProfileDataProvider", which a profile
      provider whose reader streams its input overrides to read a location as a stream, so that the content of a
      large file is not held in memory; by default it reads the content with \c readLocation()
    - the body, filter, key, value and predicate expressions of \c map, \c hash_map, \c select, \c first, \c any,
      \c all, \c count, \c takewhile and \c takeuntil, and the expression after a wildcard, are evaluated with the
      current item as \c item, its zero-based position as \c index and the size of the source as \c size in the
      template context, so that <tt>$local:item</tt>, <tt>$local:index</tt> and <tt>$local:size</tt> refer to them
      (see @ref dpql_item_context); for a hash source, the item is the \c key / \c value entry; a nested
      operator's values replace the outer ones while it is evaluated, and the caller's other template context
      values stay available
    - added @ref DataProvider::DataProviderExpressionBaseInfo::internal "internal" to the expression info, which
      marks an expression that is never offered for picking and is drawn only inside the construct that makes it;
      it is set for @ref DataProvider::DP_FUNC_WILDCARD_ITEM "DP_FUNC_WILDCARD_ITEM", the item of a list
      wildcard, so that user interfaces can leave it out of their lists of expressions; DPQL completion does not
      offer internal expressions
    - added the DPQL operator @ref dpql_exists "exists" (@ref DP_OP_EXISTS): <tt>exists \@field</tt> is \c true
      when the record has the field, also with no value, and \c false when it does not, without the error that a
      field reference to a missing field raises, so records of different shapes can be tested, as with
      <tt>exists \@type && \@type == "return"</tt>; the field reference can have accessors that read one key or
      one position (<tt>exists \@a.b</tt>, <tt>exists \@a[0].b</tt>); it is offered by completion, written back by
      the serializer, typed as \c bool, and evaluated locally, as databases cannot search with it
    - added @ref DataProvider::DpqlSerializer::fieldReferenceForKey() "DpqlSerializer::fieldReferenceForKey()" and
      @ref DataProvider::AbstractDataProvider::getFieldPath() "AbstractDataProvider::getFieldPath()", which write the
      field reference to a key and give the keys of a field path
    - in a field path, <tt>\\.</tt> is a dot and <tt>\\\\</tt> a backslash of a key, and any other backslash is
      itself, so a key ending with a backslash can be followed by more keys (<tt>a\\\\.b</tt> is the keys
      <tt>a\\</tt> and \c b); the new
      @ref DataProvider::AbstractDataProvider::escapeFieldPathKey() "AbstractDataProvider::escapeFieldPathKey()"
      escapes a key as one part of a path, and a path joined from escaped keys reads them back exactly; the new
      @ref DataProvider::AbstractDataProvider::isPlainFieldPath() "AbstractDataProvider::isPlainFieldPath()" tells
      whether a field path is the one key it is written as
    - added @ref DataProvider::AbstractDataProvider::setFieldValue() "AbstractDataProvider::setFieldValue()", which
      sets the value at a field path as
      @ref DataProvider::AbstractDataProvider::getFieldValue() "AbstractDataProvider::getFieldValue()" reads it,
      creating the hashes on the path that are missing; \c search-replace writes the value back at the path of its
      field
    - added @ref DataProvider::AbstractDataProvider::removeFieldValue() "AbstractDataProvider::removeFieldValue()",
      which removes the value at a field path, leaving the hashes on the path in place; a path with no value is left
      as it is; \c remove-fields reads each of its fields as a field path, so \c address.city removes the key
      \c city of \c address, and <tt>Unit\\.Price</tt> removes the key \c Unit.Price; its output type does not
      have the fields removed, also from a nested hash type
    - added @ref DataProvider::AbstractDataProvider::getFieldPathDisplayName()
      "AbstractDataProvider::getFieldPathDisplayName()", which gives a field path as it is written (the display name
      of its allowed value); \c select-fields outputs a field that is not renamed, and \c group-by a group-by field,
      under that name (<tt>Unit\\.Price</tt> as \c Unit.Price), and so is the field in the default name of a
      \c group-by aggregate; two fields, or a field and an aggregate, that give the same output name are refused when
      the processor is created, as are two aggregates with the same name
    - added @ref DataProvider::AbstractDataProvider::checkFieldPathOption()
      "AbstractDataProvider::checkFieldPathOption()": a field option of a processor names one field by its path, and
      the processors whose options take fields of the input (\c select-fields, \c remove-fields, \c search-replace,
      \c group-by, \c correlation, \c cross-correlation and the analytics processors) refuse a field with a DPQL
      wildcard (<tt>[*]</tt> or <tt>{*}</tt>) when they are created
    - fixed @ref DataProvider::DataProviderActionCatalog::getTypeForActionOptions() "getTypeForActionOptions()"
      returning a hash type without fields: the type of the options of an action has a field for each option, with
      its type (mandatory for a required option), description, default value and allowed values; other keys are
      still accepted as they are
    - fixed an action whose \c get_output_type callback fails being returned without an output type and without
      an error: the failure is now retained like a failed deferred initialization and returned by
      @ref DataProvider::DataProviderActionCatalog::getInitializationFailures() "getInitializationFailures()", the
      getters that return the action or its application's actions throw \c ACTION-OUTPUT-TYPE-ERROR, and each such
      call attempts the callback again; a thread asking for an action while another thread was resolving its output
      type could also get it without one (see @ref dataprovider_deferred_output_types)
    - the getters that return actions build only the deferred output types of the actions they return, and the
      application getters (\c getAllApps(), \c getApp(), \c getAppEx(), \c searchAppRegex(), \c searchAppSubstr())
      and \c getDataProviderForAction() no longer build deferred output types, so loading one provider module and
      reading one action no longer builds the output types of every action of every loaded module
    - <b>behavior change</b>: a field reference whose path goes through a value that is not a hash or an object
      now has no value: <tt>\@a.b</tt> is no value when \c a is \c 5, a string, a list or no value, as documented
      for @ref DataProvider::AbstractDataProvider::evalGenericExpressionValue() "evalGenericExpressionValue()";
      before, it gave that value (\c 5), so that <tt>\@a.b == 5</tt> was true.  A list is not searched by key in a
      path: use an index (<tt>\@a[0].b</tt>) or a @ref dpql_wildcards "wildcard" (<tt>\@a[*].b</tt>).  This applies
      wherever an expression is evaluated, including searches filtered by the client, \c filter-records and
      mappers that use expressions, and to the paths read by \c map and the wildcards
      (<tt>\@prices{*}.cur.code</tt>)
    - added @ref DataProvider::DpqlParser::isItemScopedArg() "DpqlParser::isItemScopedArg()", which tells whether an
      argument of an expression is evaluated for each item of a source (the body and filter of \c map, the
      predicates of the streaming operators, the expression after a wildcard), so that code that collects or
      validates the fields of a record can leave out the fields of the items, as DPQL validation does
    - added the DPQL @ref dpql_wildcards "wildcard accessors" \c [*] and \c {*}, which take a value from each item
      of a list or each value of a hash: <tt>\@orders[*].id</tt> is <tt>map \@id, \@orders</tt>,
      <tt>\@prices{*}.amount</tt> is <tt>map \@value.amount, \@prices</tt>, and <tt>\@orders[*].items[*].sku</tt>
      is a list of lists; they are parsed, evaluated, typed, serialized as written and offered by completion
      (@ref DataProvider::DP_FUNC_LIST_WILDCARD "DP_FUNC_LIST_WILDCARD",
      @ref DataProvider::DP_FUNC_HASH_WILDCARD "DP_FUNC_HASH_WILDCARD",
      @ref DataProvider::DP_FUNC_WILDCARD_ITEM "DP_FUNC_WILDCARD_ITEM", \c DPQL_TOK_WILDCARD)
    - an expression has one type wherever it is used: DPQL validation, expression verification
      (@ref DataProvider::AbstractDataProvider::verifyExpression() "AbstractDataProvider::verifyExpression()") and
      other users of expression types work out the type of an expression with the new
      @ref DataProvider::ExpressionTypes "ExpressionTypes" class, which gives the type that evaluating the
      expression gives: \c 1 \c + \c 2.5 is a \c float, any number with an arbitrary-precision number is a
      \c number, \c abs(\@qty) has the type of the field \c qty, and a field of a field (\c \@customer.name) has
      its own type; arithmetic that cannot combine its operands (a hash plus an integer) has no type, is a
      \c DPQL-E050 error, and still evaluates to %Qore's result
    - expression verification checks literal values and template references against the types of their
      arguments too, as DPQL validation does (\c DPQL-W004)
    - the messages about conditions and expressions are written in plain language: the errors of expression
      verification, the DPQL diagnostics \c DPQL-E040, \c DPQL-E042, \c DPQL-E043, \c DPQL-W004, \c DPQL-W006 and
      \c DPQL-E100, and the descriptions of the condition operators and of the filter options; the codes and
      severities of the diagnostics are unchanged
    - DPQL validation (@ref DataProvider::DataProvider::validateDpqlExpression() "validateDpqlExpression()") reports
      arithmetic operands that the operator cannot combine (\c DPQL-E050), such as a hash plus a number, which
      evaluates to the number, and comparisons whose result is the same for every record (\c DPQL-W006), such as
      <tt>\@price > \@price</tt>; see @ref dpql_validation
    - added @ref ConnectionProvider::connection_option_override() "connection_option_override()" to derive a
      connection option from the option of another connection scheme without resetting the members that are not
      changed: adding a hash cast to @ref ConnectionProvider::ConnectionOptionInfo "ConnectionOptionInfo" to a base
      option sets every member that the cast does not give to its default value, so that an option derived from a
      sensitive option (ex: a password or a client secret) would no longer be sensitive; the connection schemes of
      the modules delivered with %Qore derive their options with the new function
    - @ref DataProvider::AbstractDataProviderFactory::create() "AbstractDataProviderFactory::create()" and
      @ref DataProvider::AbstractDataProviderFactory::createWithTemplate() "createWithTemplate()" report that a data
      provider does not support a constructor from an option hash only when its class really has no such
      constructor; any other error raised while looking up the constructor (for example \c PROGRAM-ERROR when the
      @ref Qore::Program "Program" holding the class has been deleted) is now raised unchanged instead of being
      hidden behind that message
    - a DPQL field name can be written without quotes in any script: <tt>\@menge_bestätigt</tt> and
      <tt>\@größe</tt> are read like <tt>\@name</tt>, and the serializer and completion write such names bare
    - in DPQL and generic expression evaluation, a float combined with a number by an arithmetic operator, a
      comparison, or \c toNumber() is converted to the number that its 15 significant digits give, so
      <tt>\@price * 1.19</tt> for a number field gives the same number as with the number literal \c 1.19n
      instead of exposing the float's binary value (\c 2528.7499999999997875); see
      @ref dpql_number_float "Numbers and Floats" and
      @ref DataProvider::DataProvider::floatToNumber() "DataProvider::floatToNumber()", which applies the same rule
    - @ref DataProvider::AbstractDataProvider::prepareExpression() "AbstractDataProvider::prepareExpression()"
      (used by \c filter-records and other generic evaluation) verifies every expression in the tree: an unknown
      expression, such as \c nosuch in <tt>nosuch(\@a) > 1</tt>, or too few or too many arguments, such as
      <tt>substr(\@a)</tt>, raises a \c DATA-PROVIDER-EXPRESSION-ERROR when the expression is prepared instead of
      when a record is evaluated; added
      @ref DataProvider::AbstractDataProvider::verifyGenericExpression()
      "AbstractDataProvider::verifyGenericExpression()" and
      @ref DataProvider::AbstractDataProvider::getRequiredArgCount() "AbstractDataProvider::getRequiredArgCount()"
    - @ref DataProvider::AbstractDataProvider::verifyExpression() "AbstractDataProvider::verifyExpression()" with an
      expression map verifies the nested expressions in the arguments as well: with the expression map if it has
      them, otherwise for generic evaluation, as a provider with client-side filtering evaluates them
    - expression verification checks each nested expression and field reference against the type that its argument
      position requires (with
      @ref DataProvider::AbstractDataProvider::verifyGenericExpression()
      "AbstractDataProvider::verifyGenericExpression()" and
      @ref DataProvider::AbstractDataProvider::verifyExpression() "AbstractDataProvider::verifyExpression()" with an
      expression map); a field reference is checked when the new \c fields parameter gives the record's fields:
      - a condition, such as an argument of \c &&, \c || or \c !, or the condition of \c ternary, accepts a
        result of any type that converts to a boolean value, such as <tt>size(\@items) && \@active</tt>, but not a
        string or a date, such as <tt>lwr(\@status) && \@id > 1</tt>, which must be compared explicitly instead
        (ex: <tt>\@status == "open"</tt> or <tt>\@x != ""</tt>)
      - other arguments need a result of a type that they accept, so <tt>lwr(size(\@a))</tt> is rejected
      - a result of any type, such as from \c ternary or \c coalesce, is accepted everywhere

      the DPQL argument type warning \c DPQL-W004 uses the same rules, and is also given for \c !; added
      @ref DataProvider::AbstractDataProvider::isConditionType() "AbstractDataProvider::isConditionType()",
      @ref DataProvider::AbstractDataProvider::isArgTypeCompatible() "AbstractDataProvider::isArgTypeCompatible()"
      and @ref DataProvider::AbstractDataProvider::getFieldReferenceType()
      "AbstractDataProvider::getFieldReferenceType()"; expressions are prepared for evaluation without checking
      argument types, so that expressions saved before still run
    - the \c a member of an RGB color (@ref DataProvider::RgbColorDataType "RgbColorDataType") is its opacity, as
      every user interface stores it: a number from \c 0 (transparent) to \c 1 (opaque), which is \c 1 when it is
      missing or null (\c NOTHING or \c NULL); an opacity outside of this range is rejected, and the opacity is
      returned as a \c float.  It was described as a transparency from \c 0 to \c 255 with a default of \c 0,
      which no user of the type followed
    - the red, green and blue components of an RGB color (@ref DataProvider::RgbColorDataType "RgbColorDataType")
      outside of \c 0 to \c 255 are rejected instead of being changed to the nearest value in the range (ex: \c 256
      was accepted as \c 255); the components are described by the new
      @ref DataProvider::RgbColorDataTypeBase::ComponentType "RgbColorDataTypeBase::ComponentType", an \c int type
      with the range as its validation constraints
    - the tabular profile reads numbers stored as text with a currency symbol or ISO 4217 code before or after the
      number, \c "%", parentheses or a trailing minus (such as <tt>1.234,56 €</tt>, <tt>12,5 %</tt>,
      <tt>(1,234.00)</tt> or <tt>1.234,56-</tt>) as numbers, and reports how a column writes them in
      \c amount_format (@ref DataProvider::TabularAmountFormat "TabularAmountFormat")
    - the tabular profile reports, per column, the cells whose text stands for a missing value, such as \c n/a,
      \c - or \c #N/A, with their counts in \c empty_markers; the markers come from the fixed
      @ref DataProvider::TabularProfiler::EmptyMarkers "TabularProfiler::EmptyMarkers" vocabulary and are matched
      exactly as written, so they are reported unredacted
    - added @ref DataProvider::DataProviderOptionInteraction "DataProviderOptionInteraction" and
      @ref DataProvider::AbstractDataProvider::getOptionInteractions() "AbstractDataProvider::getOptionInteractions()"
      to describe how an option interacts with other options (a conflict, a default that depends on another option,
      an option that is ignored or needs another option) in the option's \c metadata, which is carried into action
      options and the data provider index
    - added \c supports_expressions to @ref DataProvider::DataProviderOptionBaseInfo "DataProviderOptionBaseInfo",
      which is passed on to action options; it has no value unless set (meaning that the option supports
      expressions), so option hashes still convert to other option hashdecls such as \c ConnectionOptionInfo; the
      \c dpql_where option of the \c filter-records action and of
      @ref DataProvider::QoreFilterRecordsProcessor "QoreFilterRecordsProcessor" sets it to @ref False, so that DPQL
      text is not evaluated or template-expanded before it is parsed
    - added @ref DataProvider::DPQL_PREC_PREFIX "DPQL_PREC_PREFIX" and
      @ref DataProvider::DpqlSerializer::getListElementContext() "DpqlSerializer::getListElementContext()"
    - @ref DataProvider::DataProviderActionCatalog::sealDiscovery() "DataProviderActionCatalog::sealDiscovery()"
      takes an optional \c record_app_failures argument, with which the failures of individual apps and actions do
      not block a discovery generation, but are returned in the new \c unavailable member of
      @ref DataProvider::DataProviderDiscoveryReportInfo "DataProviderDiscoveryReportInfo"; added
      @ref DataProvider::DataProviderActionCatalog::isAppDiscoveryFailure() "DataProviderActionCatalog::isAppDiscoveryFailure()"
    - fixed the static initializers registered after one that fails being discarded without being run; they are now
      run by the next @ref DataProvider::DataProvider::checkStaticInit() "DataProvider::checkStaticInit()"
    - added @ref DataProvider::DataProviderPresentationCatalog::getEffectiveCatalogFiles() "DataProviderPresentationCatalog::getEffectiveCatalogFiles()",
      which returns the catalog files a requested locale resolves to, and
      @ref DataProvider::DataProviderPresentationCatalog::forRequestedLocale() "DataProviderPresentationCatalog::forRequestedLocale()",
      which returns the catalog of another requested locale resolving to the same files without parsing or composing
      them again; a cache of presentation catalogs can then load the files of regional variants such as \c es-ES,
      \c es, and \c es-MX once instead of once per variant
    - added @ref DataProvider::DataProviderPresentationCatalog::getCatalogFiles() "DataProviderPresentationCatalog::getCatalogFiles()"
      and @ref DataProvider::DataProviderPresentationCatalog::getDomain() "DataProviderPresentationCatalog::getDomain()"
    - added @ref DataProvider::AbstractDataProvider::finishCreate() "AbstractDataProvider::finishCreate()", called
      once after a create action's records are created: data providers that buffer created records write them to
      their destination there, so write errors are reported to the caller instead of when the provider is destroyed
    - added the @ref DataProvider::DPAD_CREATE_OUTPUT "DPAD_CREATE_OUTPUT" (\c "create-output") action output data
      type for create actions that return the data a provider generates from the records, such as a spreadsheet
      or JSON document generated in memory, with
      @ref DataProvider::GeneratedDataOutputDataType "GeneratedDataOutputDataType" and
      @ref DataProvider::GeneratedDataInfo "GeneratedDataInfo" describing the generated data
    - errors caught while determining action options or request types are now logged with the global data provider
      logger when the data provider has no logger of its own, and no longer log option or request values, which can
      hold credentials
    - added @ref DataProvider::TabularProfiler "TabularProfiler", which deterministically profiles the raw cells of a
      spreadsheet or delimited text file supplied by a format reader as a
      @ref DataProvider::TabularWorkbookGrid "TabularWorkbookGrid": it finds the header row, title rows, data region,
      totals rows, and blank-row gaps, infers each column's type with a confidence and redacted counter-examples,
      and reports dates and numbers stored as text in a local format, leading-zero identifiers, yes/no columns
      written as text (with the values read as yes and no) and two-valued text columns that may be yes/no,
      duplicate headers, merged cells, hidden sheets, formulas, and wide period columns; the profile is described by
      @ref DataProvider::TabularWorkbookProfileDataType "TabularWorkbookProfileDataType" for \c profile application
      actions, and @ref DataProvider::AbstractTabularProfileDataProvider "AbstractTabularProfileDataProvider" and
      @ref DataProvider::TabularProfileRequestDataType "TabularProfileRequestDataType" implement such an action for
      a spreadsheet format given a reader for its raw cells; its totals row rule is public
      (@ref DataProvider::TabularProfiler::isTotalsLabel() "TabularProfiler::isTotalsLabel()",
      @ref DataProvider::TabularProfiler::isTotalsFormula() "TabularProfiler::isTotalsFormula()", and
      @ref DataProvider::TabularProfiler::hasTotalsFormula() "TabularProfiler::hasTotalsFormula()"), so that records
      read at run time with their formulas recognize totals rows as the profile does; a \c SUM, \c SUBTOTAL, or
      \c AGGREGATE formula marks a totals row only when it totals the rows above it in its own column, so a line
      total across a data row does not
    - added @ref DataProvider::DataProvider::listKnownFactories() "DataProvider::listKnownFactories()", which returns
      the factories registered, in the data provider index, or known to the module, without loading any module, and
      @ref DataProvider::DataProvider::tryGetFactoryInfoAsData() "DataProvider::tryGetFactoryInfoAsData()", which
      returns a factory's info from the registered factory or from the index, and only otherwise loads the factory's
      module; @ref DataProvider::DataProvider::listFactories() "DataProvider::listFactories()" still returns only the
      registered factories, which with a data provider index are only those whose modules have been loaded
    - omit generated examples that violate type constraints, omit optional fields without examples from object
      examples, and try later union alternatives when an example does not satisfy the union
    - stopping a watch data provider cancels its polling thread, which ends a blocking operation in it, such as an
      HTTP request, at once; observer notifications and checkpoint persistence run with cancellation deferred, so
      they are not interrupted (<a href="https://github.com/qoretechnologies/qore/issues/5469">issue 5469</a>)
    - added @ref DataProvider::DataProviderStaticMetadataHelper "DataProviderStaticMetadataHelper", which marks the
      current thread as reading static metadata, so that fields do not run context-dependent dynamic type, default
      value, or example value callbacks
    - added @ref DataProvider::DataProviderIndexedActionInfo "DataProviderIndexedActionInfo" and
      @ref DataProvider::IndexedActionOptionInfo "IndexedActionOptionInfo" for actions from the data provider index,
      whose option types are described by plain data; the fields shared with registered actions are in the new
      @ref DataProvider::DataProviderActionBaseInfo "DataProviderActionBaseInfo" and
      @ref DataProvider::ActionOptionBaseInfo "ActionOptionBaseInfo" hashdecls
    - added @ref DataProvider::DataProviderIndexedActionSummaryInfo "DataProviderIndexedActionSummaryInfo", the
      action-level record of an action from the data provider index, with the names of its options and whether it
      declares expressions, which lists and selects indexed actions without restoring their types
    - added @ref DataProvider::IndexedDataProviderInfo "IndexedDataProviderInfo", the data provider info of an action
      from the data provider index, in which the types of options, expressions, events, and messages are described
      by plain data, so an indexed action has no objects and can be serialized;
      @ref DataProvider::DataProvider::getIndexedInfo() "DataProvider::getIndexedInfo()" and
      @ref DataProvider::DataProvider::restoreIndexedInfo() "DataProvider::restoreIndexedInfo()" convert between it
      and @ref DataProvider::DataProviderInfo "DataProviderInfo", whose members without types are in the new
      @ref DataProvider::DataProviderBaseInfo "DataProviderBaseInfo" hashdecl, as are those of options and
      expressions in @ref DataProvider::DataProviderOptionBaseInfo "DataProviderOptionBaseInfo" and
      @ref DataProvider::DataProviderExpressionBaseInfo "DataProviderExpressionBaseInfo";
      @ref DataProvider::DataProviderInfoOptionMembers "DataProviderInfoOptionMembers" lists the option info members
    - a type description with neither a restorable name nor any returned types fails to restore with
      \c TYPE-ERROR instead of an internal runtime type error
    - @ref DataProvider::AbstractDataProviderType::get() "AbstractDataProviderType::get()"
      restores types from their descriptions more faithfully: class-backed named types in unions, hash types
      without fields, options of "or nothing" types, and the descriptions of union types are restored, an
      example value that the restored field does not accept is dropped instead of failing the restoration, and a
      description whose type path is registered only where its provider is loaded, such as a TypeScript action's
      option type, is restored from its structure in a process that has not loaded the provider
    - generated example values respect the field's allowed values and the formats of the string format types, so
      a field no longer publishes an example that it would reject
    - @ref DataProvider::QoreUnionDataType "QoreUnionDataType" accepts an explicit display name and descriptions
    - added validation constraints (@ref DataProvider::DataTypeConstraintInfo "DataTypeConstraintInfo"): numeric
      bounds and multiples, string lengths, patterns, and enumerations, list sizes and unique elements, hash sizes,
      and for unions whether exactly one alternative may match and a discriminator key selecting the alternative;
      the types of this module enforce them, and they are part of a type's description, so a type restored from its
      description enforces them too
    - @ref DataProvider::AbstractDataProviderType::get() "AbstractDataProviderType::get()" returns
      @ref DataProvider::QoreBoolDataTypeBase "QoreBoolDataTypeBase" for boolean types, so every soft boolean type
      validates strings: \c "x" is no longer accepted as @ref True
    - a mandatory @ref DataProvider::SoftListDataType "SoftListDataType" does not accept @ref nothing, like the Qore
      \c list type, and does not list it among its accepted types
    - a type description whose type is known only in the program defining it, such as a type based on a custom Qore
      type, is restored from the value type it returns and the values it accepts instead of failing, and keeps the
      name and presentation it is described with
    - the default bulk record adapter appends each field value as one column cell; a list-valued field had its
      elements concatenated into the column, and a field without a value was left out, so the columns of a block
      did not line up with its records
      (<a href="https://github.com/qoretechnologies/qorus/issues/542">Qorus issue 542</a>)
    - optional @ref DataProvider::SoftListDataType "soft lists" preserve absent collections as NOTHING;
      collection defaults are validated item by item, while explicit NULL and missing-valued list items
      retain their element-type validation
    - added generation-scoped provider discovery qualification with typed expected-inventory callbacks, structured
      failure reports, revision-bound single-use publication tokens, and qualified atomic ProviderIndex publication;
      healthy registrations remain usable and failures remain retryable in live processes, but a partial result cannot
      silently certify an authoritative index
    - environment-driven provider discovery now returns typed registration and provider-module failures to
      ProviderIndex qualification; failed modules remain retryable instead of being marked loaded and then silently
      skipped by later discovery generations
    - provider presentation catalogs recursively extract structured option fields, list elements, union branches, and
      nested allowed values with stable bounded IDs; anonymous nested types are action-scoped and include any stable
      producer schema path so equal-shaped objects with different semantics cannot silently share translations. New
      static @ref DataProvider::AbstractDataField::getPresentationInfo() "presentation metadata" and
      @ref DataProvider::AbstractDataField::getDeclaredType() "declared types" keep extraction deterministic without
      invoking context-dependent dynamic type, default, or example callbacks
    - fixed allowed list-element choices to use converted values for both scalar and structured items;
      replacing choices now clears stale membership rules, and a failed replacement preserves the previous choices
    - fixed short descriptions containing quoted parameter names or numbers to preserve ordinary words
      and literal braces while ignoring sentence punctuation inside quoted spans
    - fixed @ref DataProvider::QoreStringDataTypeBase "QoreStringDataTypeBase" to honor the value conversion
      implemented by a wrapped user-defined @ref Qore::Reflection::Type "Type" subclass; the generic string
      conversion silently replaced the type's own @ref Qore::Reflection::Type::acceptsValue "acceptsValue()"
      override, so a type that renders a boolean as the string \c "true" or \c "false" for a REST query
      argument produced \c "1" or \c "0" instead
    - @ref DataProvider::AbstractDataField::getDisplayName() "AbstractDataField::getDisplayName()" now renders
      acronyms, initialisms, and irregularly capitalized proper nouns in their canonical form regardless of
      the case they are written in in the technical name, so that lower-case and camel-case technical names
      produce the same display names as upper-case ones (ex: \c "api_key" -> \c "API Key",
      \c "saas_provider" -> \c "SaaS Provider", \c "ipv4_address" -> \c "IPv4 Address"); the renderings are
      given by @ref DataProvider::AbstractDataField::WordRenderings "AbstractDataField::WordRenderings"
    - @ref DataProvider::AbstractDataField::getDisplayName() "AbstractDataField::getDisplayName()" writes short
      English function words, which are listed in
      @ref DataProvider::AbstractDataField::FunctionWords "AbstractDataField::FunctionWords", in lower case in the
      middle of a display name in accordance with English title case, and does not take them for acronyms in
      upper-case technical names (ex: \c "wait_for_active_shards" -> \c "Wait for Active Shards",
      \c "CREATED_AT" -> \c "Created At")
    - @ref DataProvider::AbstractDataField::getDisplayName() "AbstractDataField::getDisplayName()" now
      produces a single word break for consecutive word separators instead of one space per separator
    - fixed @ref DataProvider::AbstractDataField::getDisplayName() "AbstractDataField::getDisplayName()"
      inserting a spurious word break after a lower-case letter with no single-character upper-case form, such as
      the German sharp s or a typographic ligature, in a word in upper case, which is case-folded like any other
      word in upper case (ex: \c "STRAßE_NAME" yielded \c "STRAß E NAME" and now yields \c "Straße Name")
    - added the DPQL operator precedence levels (@ref DPQL_PREC_PRIMARY etc),
      @ref DataProvider::DpqlOperatorPrecedence "DpqlOperatorPrecedence",
      @ref DataProvider::DpqlAssociativeOperators "DpqlAssociativeOperators",
      @ref DataProvider::DpqlSerializer::getOperatorPrecedence() "DpqlSerializer::getOperatorPrecedence()", and
      @ref DataProvider::DpqlSerializer::getArgumentContext() "DpqlSerializer::getArgumentContext()", so that
      any renderer can parenthesize expressions by the same rule the parser reads them by
    - fixed @ref DataProvider::AbstractDataProviderType::getSoftType() "soft type conversion" to convert each
      distinct type in a type graph once; a type reached by more than one path was converted once per path, which
      is exponential in the depth of the graph, so a schema with shared subtypes could not be converted in
      bounded time or memory, and a recursive type could not be converted at all
    - soft type conversion now converts the element type of a @ref DataProvider::ListDataType "list type"; a type
      reachable only through a list was left strict, so a soft record could still reject values it was meant to
      accept
    - fixed @ref DataProvider::SoftListDataType "SoftListDataType" with an element type that has no single %Qore
      type - one produced by an OpenAPI \c anyOf or \c oneOf, say -, which raised an error; its %Qore type is then
      an untyped \b soft list, since a soft list always accepts a single value in place of a list
    - generated date examples now use a fixed UTC sample instead of the current time, making repeated metadata
      reads and nested examples reproducible; explicitly supplied examples, defaults and allowed values are unchanged
    - fixed \c HashDataType required-field tracking when an optional field with a default is added after a
      mandatory field; record metadata now retains mandatory status independently of field insertion order
    - added source-owned native i18n catalog metadata and deterministic message identities for localized application,
      action, and option presentation without changing technical identities
    - added the static method
      @ref DataProvider::DataProviderPresentationCatalog::buildDomainCatalogs() "buildDomainCatalogs()", which builds
      the catalogs for several locales of one domain while parsing the files they share, such as \c root.json, only
      once, and @ref DataProvider::DataProviderPresentationCatalog::forEachDomainCatalog() "forEachDomainCatalog()" does
      the same while holding only one catalog at a time
    - @ref DataProvider::DataProviderPresentationCatalog "DataProviderPresentationCatalog" accepts an optional
      \c I18n::CatalogDiscoveryIndex so that an operation building catalogs for many domains and locales reads
      each catalog directory once instead of once per catalog; multilingual embedding population uses one index for
      each domain population
    - fixed app and action module ownership when a deferred initialization closure loads another module; apps and
      actions registered by the loaded module while its own initializer runs were attributed to the module whose
      pending app was being initialized, so
      @ref DataProvider::DataProviderActionCatalog::getModulePathsForApp() reported the wrong module for them
    - added a declarative single-file read/write mapping so that generic consumers can read and write a file
      through any application without knowing its action and option names, which differ from application to
      application; used by the \c "conn://" scheme in the \c FileLocationHandler module:
      - @ref DataProvider::DataProviderFileApiInfo "DataProviderFileApiInfo"
      - @ref DataProvider::DataProviderActionCatalog::registerAppFileApi()
        "DataProviderActionCatalog::registerAppFileApi()"
      - @ref DataProvider::DataProviderActionCatalog::getAppFileApi()
        "DataProviderActionCatalog::getAppFileApi()"
      \n
      (<a href="https://github.com/qoretechnologies/qore/issues/5386">issue 5386</a>)
    - the generic data provider APIs now preserve the exception they wrap: the provider-specific exception is
      reported under the \c "ex" key of the wrapping exception's argument, so a caller catching a generic error
      such as \c SEND-MESSAGE-ERROR can recover the original error code and any machine-readable detail the
      provider attached to it - a protocol status code, for example.  Previously several of these wrappers
      discarded the original argument entirely, leaving the rendered description as the only place that detail
      appeared, and description text cannot be parsed reliably by a caller; the keys of an argument that was
      already forwarded are still reported where they were
    - added @ref DataProvider::DataProviderActionCatalog::cacheAllRegisteredApps() "DataProviderActionCatalog::cacheAllRegisteredApps()",
      which populates the provider index app cache from all registered applications; this allows a complete app
      catalog to be recovered when the data provider index cannot be read, instead of silently degrading to the
      apps registered by already-loaded modules
      (<a href="https://github.com/qoretechnologies/qore/issues/5383">issue 5383</a>)
    - added @ref DataProvider::AbstractOrderedWatchDataProvider "AbstractOrderedWatchDataProvider", which
      implements the shared watch processing sequence — fetch, cursor filtering, ascending sort, optional
      snapshot collapse, optional dispatch budget, in-order dispatch, advance-on-success, and the post-success
      hook — with typed @ref DataProvider::WatchItemInfo "WatchItemInfo" item and cursor contracts; see
      @ref dataprovider_watch
    - added @ref DataProvider::AbstractTimestampWatchDataProvider "AbstractTimestampWatchDataProvider", which
      implements the common "records changed since <i>t</i>" cursor on top of the shared template, using a
      durable timestamp plus the record IDs delivered at that timestamp so the cursor is safe at its own
      boundary
    - a watch cycle <b>stops at the first dispatch failure</b>, so that the monotonic cursor never advances past
      an item that was not delivered, which would drop it permanently on what may well be a transient error
    - @ref DataProvider::Observable::notifyObservers() "notifyObservers()" now notifies <b>every</b>
      subscribed observer and reports any failures as a single aggregate \c OBSERVER-NOTIFICATION-ERROR
      exception carrying the individual exceptions; previously the first observer that threw silently
      skipped every observer registered after it, so one broken handler could starve the others; see
      @ref dataprovider_watch_delivery
    - documented at the @ref DataProvider::Observer "Observer" contract level that observer exceptions
      reach the event source, and that an observer must not swallow a processing failure: a watch
      provider reads a clean return as proof of delivery, advances its durable cursor, and runs any
      post-dispatch removal, so a swallowed failure loses the source item silently
    - added
      @ref DataProvider::AbstractOrderedWatchDataProvider::setWatchItemBlockedHandler() "setWatchItemBlockedHandler()",
      which reports an item that has failed a configurable number of consecutive cycles and is therefore
      holding up the whole feed, and reports again when that item is finally delivered
    - added an explicit dispatch-order contract: every watch provider declares how its upstream feed is
      ordered with @ref DataProvider::AbstractWatchDataProviderBase::getSourceOrdering() "getSourceOrdering()"
      and whether its events arrive oldest-first with
      @ref DataProvider::AbstractWatchDataProviderBase::hasAscendingDispatch() "hasAscendingDispatch()", so a
      consumer no longer has to infer either from the implementation
    - added optional snapshot collapse to the shared template: a backlog can be reduced to the latest item per
      group, with the collapsed items reported in the event metadata and optionally removed according to
      @ref DataProvider::WatchSupersededAction "WatchSupersededAction"; superseded items are identified before
      their payloads are retrieved
    - added an optional per-cycle dispatch budget, applied from the oldest end so that the durable cursor still
      advances contiguously and the remainder is delivered by later cycles rather than skipped
    - @ref DataProvider::AbstractDataField::getDisplayName() "AbstractDataField::getDisplayName()" now case-folds
      words in all upper case, so that technical names in upper case produce readable display names (ex:
      \c "PAYMENT-DISPUTE-ADJUDICATE-28" -> \c "Payment Dispute Adjudicate 28"); acronyms are preserved, and an
      explicit acronym classification can be given for domain- or language-specific words
    - fixed @ref DataProvider::AbstractDataField::getDisplayName() "AbstractDataField::getDisplayName()" to
      recognize case in all scripts; previously word breaks after acronyms were only detected in Latin script,
      and an empty name caused a \c RUNTIME-TYPE-ERROR exception
    - added semantic string-backed data types (\c email, \c uri, \c uuid, \c hostname, \c ipv4, \c ipv6, and
      \c phone) that carry a UI-renderable format identity while remaining string-compatible; Swagger and
      OpenAPI schema \c format values are mapped to these types on import and emitted on schema generation
    - @ref DataProvider::DataProviderActionCatalog::getActionOptionFromFields() "getActionOptionFromFields()"
      now propagates a source field's \c ui_type into the derived application-action option
    - class-backed named types (\c file, \c rgbcolor, and the new semantic string types) are now resolvable
      by name through @ref DataProvider::AbstractDataProviderType::get() "AbstractDataProviderType::get()",
      so fields and options can reference them by name
    - added explicit expression pushdown capability metadata so action sessions and database providers can
      distinguish backend-native expressions from generic client implementations
    - added template context, template value, and template type-resolution forwarding methods to the public
      @ref DataProvider::DataProvider "DataProvider" facade
    - made limited and exhausted @ref DataProvider::DefaultRecordIterator "DefaultRecordIterator" instances
      release wrapped iterators immediately, including their database transaction resources
    - @ref DataProvider::DefaultRecordIterator "DefaultRecordIterator" now prepares typed expressions once at
      construction for efficient repeated evaluation
    - record update and delete APIs enforce the \c max_records search option against the affected-row count and
      raise \c MAX-RECORDS-EXCEEDED when it is exceeded
    - added @ref DataProvider::DataProviderShape "DataProviderShape" and shape-aware pipeline APIs on
      @ref DataProvider::AbstractDataProcessor "AbstractDataProcessor" for row records, hash-of-lists bulk blocks,
      dense buffer-column blocks, and DataFrame blocks
    - added @ref DataProvider::AbstractDataProviderBulkRecordInterface::getShapedValue()
      "AbstractDataProviderBulkRecordInterface::getShapedValue()" and
      @ref DataProvider::AbstractDataProviderBulkRecordInterface::getValueShape()
      "getValueShape()" so native bulk readers can preserve \c BufferColumns and \c DataFrameBlock values while
      keeping @ref DataProvider::AbstractDataProviderBulkRecordInterface::getValue() "getValue()" as a
      hash-of-lists compatibility API
    - added automatic DataProvider pipeline shape routing and conversion with row-record boundary preservation for
      legacy \c submitImpl() processors
    - added DataProvider bulk read/create/upsert shape metadata and shaped create/upsert entry points so providers
      can accept \c BufferColumns or \c DataFrameBlock input without row materialization
    - updated @ref DataProvider::QoreFilterRecordsProcessor "QoreFilterRecordsProcessor" to process
      \c DataFrameBlock and \c BufferColumns input directly for supported scalar, expression-to-expression,
      and computed \c between / \c in comparisons, numeric function calls, trim/concat/null-handling functions,
      date-part functions, row-independent date arithmetic, structured strict equality/inequality,
      \c containsAny and other string predicates, list membership predicates, list/hash accessors, ternary computed values,
      boolean combinations, and null checks; BufferColumns filters also lower temporal date comparisons, \c like,
      and regular expression predicates to dense masks
    - added DPQL string support to @ref DataProvider::QoreFilterRecordsProcessor "QoreFilterRecordsProcessor"
      through \c dpql_where and string-valued \c where_cond options so pipeline filters can be configured directly
      with DPQL while retaining the DataFrame and dense BufferColumns fast paths
    - added @ref DataProvider::ColumnarExpressionFilter "ColumnarExpressionFilter" as the shared DataFrame and
      ColumnarResult expression engine used by shape-aware processors and DataFrame-backed providers
    - added DPQL/DataProvider generic expression support for Qore-style streaming prefix operators
      \c select, \c first, \c any, \c all, \c count, \c take, \c drop, \c takewhile, and
      \c takeuntil over list and hash sources; shape-aware DataFrame and BufferColumns filters preserve
      correctness for these expressions through generic row evaluation when no dense mask lowering is available
    - updated @ref DataProvider::QoreGroupByProcessor "QoreGroupByProcessor" to process hash-of-lists,
      \c BufferColumns, and DataFrame blocks directly and preserve shaped aggregate blocks on pipeline flush
    - updated @ref DataProvider::QoreSelectFieldsProcessor "QoreSelectFieldsProcessor",
      @ref DataProvider::QoreRemoveFieldsProcessor "QoreRemoveFieldsProcessor", and
      @ref DataProvider::QoreRecordLimitProcessor "QoreRecordLimitProcessor" to preserve shaped
      \c DataFrameBlock and \c BufferColumns values for simple projection/removal and limiting
    - updated @ref DataProvider::QoreSetFieldsProcessor "QoreSetFieldsProcessor" and
      @ref DataProvider::QoreSearchReplaceProcessor "QoreSearchReplaceProcessor" to preserve shaped
      \c DataFrameBlock and \c BufferColumns values for top-level constant-field and string-column updates
    - updated analytics processors, including @ref DataProvider::QoreCorrelationProcessor
      "QoreCorrelationProcessor" and @ref DataProvider::QoreCrossCorrelationProcessor
      "QoreCrossCorrelationProcessor", to accept \c DataFrameBlock and \c BufferColumns input and preserve
      shaped rectangular event blocks, including flush-time output from partial windows; this covers the full
      @ref DataProvider::AbstractAnalyticsProcessor "AbstractAnalyticsProcessor" family, and top-level configured
      fields are read directly from selected columns to avoid full-block hash-of-lists materialization
    - added framework-level auto-injection of a generic "Make an API call" action for every
      REST-capable @ref DataProvider::DataProviderActionCatalog "data provider app":
      - apps that declare a connection \c scheme automatically receive an auto-registered
        @ref DataProvider::DPAT_API "DPAT_API" action with action name
        @ref DataProvider::AbstractDataProvider::GenericApiCallActionName "make-api-call",
        accepting per-call \c method, \c path, \c query_args, \c body, and \c hdr inputs
      - the action is backed by an auto-injected virtual child provider named
        @ref DataProvider::AbstractDataProvider::GenericApiCallChildName "\"__call__\"",
        constructed lazily from the value returned by
        @ref DataProvider::AbstractDataProvider::getRestClientForGenericCall()
      - the child is injected exactly once per provider tree, at its root, matching the \c "/__call__"
        path the action is registered with; the child is built from the REST client alone and carries no
        context from its parent, so a copy on every descendant provider (each of which normally inherits
        the same \c rest member from a shared base class) would be an exact duplicate; see
        @ref DataProvider::AbstractDataProvider::hasGenericApiCallChild() for the gating rules
      - the reserved child name is always resolved by the framework and is never passed to
        @ref DataProvider::AbstractDataProvider::getChildProviderImpl(), at any level of the tree, so
        providers that resolve children with a remote lookup never issue a request for a child that
        cannot exist
      - providers belonging to an app that sets
        @ref DataProvider::DataProviderAppInfo::disable_generic_api_call "disable_generic_api_call"
        declare the same opt-out at runtime by overriding
        @ref DataProvider::AbstractDataProvider::hasGenericApiCallChildImpl()
      - REST-based data providers are auto-discovered via reflection: the default impl of
        @ref DataProvider::AbstractDataProvider::getRestClientForGenericCallImpl() walks the actual
        class hierarchy of @c self looking for either:
        - a member named
          @ref DataProvider::AbstractDataProvider::GenericApiCallRestMemberName "\"rest\""
          whose value is an object responding to @c restDoRequest() — the qore qlib convention; or
        - a member named
          @ref DataProvider::AbstractDataProvider::GenericApiCallConnectionMemberName "\"conn\""
          whose value is an @c AbstractConnection; the framework calls @c conn.get(False) to
          acquire the underlying client without establishing a network connection — the module-v8
          @c TypeScriptActionInterface convention
        This covers all REST-based providers in both ecosystems with no per-provider boilerplate.
      - providers using a non-standard member name can still override
        @ref DataProvider::AbstractDataProvider::getRestClientForGenericCallImpl() explicitly
      - apps that should not expose this action (e.g. non-REST databases, FTP, WebSocket)
        opt out via the new
        @ref DataProvider::DataProviderAppInfo::disable_generic_api_call "disable_generic_api_call"
        field
      - the underlying generic call provider implementation is supplied by the
        @c RestClientDataProvider module through the new
        @ref DataProvider::AbstractDataProvider::setGenericApiCallChildBuilder()
        and
        @ref DataProvider::DataProviderActionCatalog::setGenericApiCallActionBuilder()
        hooks, keeping the @c DataProvider module free of any direct dependency on a specific
        REST transport
    - added an optional \c module_context argument to
      @ref DataProvider::DataProviderActionCatalog::registerPendingApp() so that callers
      registering an app on behalf of another module can associate the correct module path with
      the app (reported by
      @ref DataProvider::DataProviderActionCatalog::getModulePathsForApp()); when omitted, the
      current module context is used as before, preserving backwards compatibility
    - fixed a memory leak where deregistering an app
      (@ref DataProvider::DataProviderActionCatalog::deregisterDynamicApp() and the internal
      app-deregistration path) left the app's actions - and the entire option and data-type graph
      attached to them - in the static top-level action map instead of removing them, causing
      unbounded memory growth under repeated app/connection registration and deregistration
    - fixed a memory leak where registering a dynamic app at runtime left an undischarged
      module-initialization rollback closure on the per-thread implicit module transaction list
    - added @ref DataProvider::AbstractSimulationRecorder "AbstractSimulationRecorder" and
      @ref DataProvider::AbstractDataProvider::simulateRequest() "AbstractDataProvider::simulateRequest()" for
      side-effect-free dry-run execution
    - added @ref DataProvider::AbstractDataProvider::getSimulationVolatileFields()
      "AbstractDataProvider::getSimulationVolatileFields()" for simulation signature hashing
    - added 67 generic DPQL expressions for use in data-driven contexts (arithmetic, string
      operations, type conversions, encoding, cryptographic operations, regex, date/time,
      collection operations, and serialization functions)
    - new expression categories: arithmetic (\c +, \c -, \c *, \c /), string (\c upr, \c lwr,
      \c trim, \c substr, \c join, \c replace), type conversion (\c toString, \c toInt,
      \c toFloat, \c toNumber, \c toBool, \c toDate), encoding (\c to-hex, \c to-base64,
      \c parse_hex, \c parse_base64), crypto (\c digest, \c hmac, \c encrypt, \c decrypt),
      serialization (\c make_yaml, \c parse_yaml, \c make_json, \c parse_json, \c make_xml,
      \c parse_xml)
    - added \c now() function returning current timestamp with microsecond precision
    - added @ref DataProvider::AbstractDataProvider::ExtraExpressionImplementations
      "ExtraExpressionImplementations" static member for module-conditional expression
      registration (YAML, JSON, XML expressions registered when modules are available)
    - added @ref DataProvider::dp_get_all_expression_info() "dp_get_all_expression_info()"
      public function to retrieve all available expression metadata
    - added 60+ operator alias mappings for user-friendly expression names
    - added @ref DataProvider::DPAD_PASS_THROUGH "DPAD_PASS_THROUGH" constant for pipeline processor
      actions whose output type is the same as their input type (e.g., filter processors that
      drop non-matching records but do not modify matching ones)
    - set \c output_data_type to @ref DataProvider::DPAD_PASS_THROUGH "DPAD_PASS_THROUGH" on
      \c filter-records and \c record-limit pipeline processor registrations
    - added \c input_field_names boolean field to
      @ref DataProvider::BaseOptionInfo "BaseOptionInfo" to mark pipeline processor options whose
      allowed values should be dynamically populated from the preceding pipeline state's output
      type field names
    - added @ref DataProvider::AbstractDataProviderType::getFieldNamesAsAllowedValues()
      "AbstractDataProviderType::getFieldNamesAsAllowedValues()" static method to recursively
      enumerate field names from a data provider type as allowed value entries, including
      dot-notation paths for nested hash fields
    - added @ref DataProvider::AbstractDataProvider::getFieldValue()
      "AbstractDataProvider::getFieldValue()" static method for dot-notation field access in
      record hashes (e.g. \c "address.city")
    - added @ref DataProvider::AbstractDataProvider::parseFieldList()
      "AbstractDataProvider::parseFieldList()" static method for backward-compatible parsing of
      field lists from both comma-separated strings and string lists
    - multi-field processor options (\c fields, \c group_by) take a \c softlist<string> for multi-select UI
      support, or a comma-separated string
    - added \c input_field_names marker to single-field options (\c field, \c field_x, \c field_y,
      \c target_field) for dynamic allowed value population
    - all field-name-based processor options support dot-notation for nested field access
    - added 11 streaming analytics and statistical pipeline processors:
      - @ref DataProvider::QoreRunningStatsProcessor "running-stats": compute running statistics
        (count, sum, avg, min, max, stddev, variance) over windows of records
      - @ref DataProvider::QoreMovingAverageProcessor "moving-average": compute simple and exponential
        moving averages per record
      - @ref DataProvider::QoreTrendAnalysisProcessor "trend-analysis": compute linear regression trend
        analysis (slope, intercept, r-squared, direction) over windows
      - @ref DataProvider::QoreAnomalyDetectionProcessor "anomaly-detection": z-score based anomaly
        detection per record
      - @ref DataProvider::QorePercentileProcessor "percentile": compute percentiles
        (P25, P50/median, P75, P90, P95, P99), IQR, skewness, and kurtosis over windows
      - @ref DataProvider::QoreCorrelationProcessor "correlation": compute Pearson correlation
        matrix between all pairs of configured numeric fields
      - @ref DataProvider::QoreCrossCorrelationProcessor "cross-correlation": compute time-lagged
        cross-correlation between two fields to discover delayed relationships
      - @ref DataProvider::QoreHistogramProcessor "histogram": compute frequency distributions
        with configurable uniform or quantile binning
      - @ref DataProvider::QoreRateOfChangeProcessor "rate-of-change": compute first derivative
        (rate of change), second derivative (acceleration), and percentage change per record
      - @ref DataProvider::QoreEWMAControlChartProcessor "ewma-control-chart": EWMA statistical
        process control with upper and lower control limits for drift detection
      - @ref DataProvider::QoreSeasonalityDetectionProcessor "seasonality-detection":
        autocorrelation-based detection of repeating cyclical patterns
    - added the @ref DataProvider::AbstractAnalyticsProcessor "AbstractAnalyticsProcessor" abstract base
      class for building streaming analytics processors with window and record emission modes
    - added the @ref DataProvider::DPC_ANALYTICS "DPC_ANALYTICS" processor capability constant for analytics processors
    - added analytics event hashdecls: @ref DataProvider::AnalyticsEventInfo "AnalyticsEventInfo",
      @ref DataProvider::StatisticsEventInfo "StatisticsEventInfo",
      @ref DataProvider::MovingAverageEventInfo "MovingAverageEventInfo",
      @ref DataProvider::TrendEventInfo "TrendEventInfo",
      @ref DataProvider::AnomalyEventInfo "AnomalyEventInfo",
      @ref DataProvider::PercentileEventInfo "PercentileEventInfo",
      @ref DataProvider::CorrelationEventInfo "CorrelationEventInfo",
      @ref DataProvider::CrossCorrelationEventInfo "CrossCorrelationEventInfo",
      @ref DataProvider::HistogramEventInfo "HistogramEventInfo",
      @ref DataProvider::RateOfChangeEventInfo "RateOfChangeEventInfo",
      @ref DataProvider::EWMAControlChartEventInfo "EWMAControlChartEventInfo",
      @ref DataProvider::SeasonalityDetectionEventInfo "SeasonalityDetectionEventInfo"
    - added @ref DataProvider::QoreGroupByProcessor "group-by": group records by field values and
      compute aggregate functions (count, sum, avg, min, max, first, last) per group
    - added 11 new analytics/aggregation actions to the Qore app in the "Analytics" group
    - updated @ref DataProvider::QoreProcessorsDataProvider "qore-processors" factory with 12 new
      processor children (11 analytics + 1 aggregation)
    - added the built-in "Qore" app with pipeline processor actions for filtering, transforming, and
      manipulating records in data pipelines:
      - @ref DataProvider::QoreFilterRecordsProcessor "filter-records": filter records by DPQL expression
        or field comparison
      - @ref DataProvider::QoreSelectFieldsProcessor "select-fields": select and rename fields
      - @ref DataProvider::QoreSetFieldsProcessor "set-fields": set a field to a constant value
      - @ref DataProvider::QoreRemoveFieldsProcessor "remove-fields": remove fields from records
      - @ref DataProvider::QoreSearchReplaceProcessor "search-replace": search and replace text in fields
      - @ref DataProvider::QoreRecordLimitProcessor "record-limit": limit the number of records
    - added the @ref DataProvider::QoreProcessorsDataProviderFactory "qore-processors" factory for
      navigating built-in pipeline processors
    - added a return-based API to @ref DataProvider::AbstractDataProcessor "AbstractDataProcessor"
      (@ref DataProvider::AbstractDataProcessor::processRecord() "processRecord()",
      @ref DataProvider::AbstractDataProcessor::processRecords() "processRecords()",
      @ref DataProvider::AbstractDataProcessor::processRecordsBulk() "processRecordsBulk()",
      @ref DataProvider::AbstractDataProcessor::flushRecords() "flushRecords()")
    - made @ref DataProvider::AbstractDataProcessor::submitImpl() "submitImpl()" and
      @ref DataProvider::AbstractDataProcessor::supportsBulkApiImpl() "supportsBulkApiImpl()" non-abstract
      with bidirectional defaults bridging to the new return-based API
    - added processor capability constants (@ref DataProvider::DPC_TRANSFORM "DPC_TRANSFORM", @ref DataProvider::DPC_FILTER "DPC_FILTER", @ref DataProvider::DPC_EXPAND "DPC_EXPAND",
      @ref DataProvider::DPC_AGGREGATE "DPC_AGGREGATE", @ref DataProvider::DPC_SINK "DPC_SINK") and
      @ref DataProvider::AbstractDataProcessor::getProcessorCapabilities() "getProcessorCapabilities()"
    - added utility methods @ref DataProvider::AbstractDataProcessor::hashListToRecords() "hashListToRecords()"
      and @ref DataProvider::AbstractDataProcessor::recordsToHashList() "recordsToHashList()"
    - added @ref DataProvider::AbstractDataProcessor::submitAndCollect() "submitAndCollect()" and
      @ref DataProvider::AbstractDataProcessor::flushAndCollect() "flushAndCollect()" methods
    - @ref DataProvider::AbstractDataProvider "AbstractDataProvider" now inherits
      @ref DataProvider::AbstractDataProcessor "AbstractDataProcessor" so data providers can serve as
      pipeline processors
    - added @ref DataProvider::AbstractDataProvider::supportsPipelineProcessor() "supportsPipelineProcessor()"
      query method
    - added pipeline processor type API methods:
      @ref DataProvider::AbstractDataProvider::getPipelineProcessorInputType() "getPipelineProcessorInputType()",
      @ref DataProvider::AbstractDataProvider::getPipelineProcessorInputTypeWithOptions() "getPipelineProcessorInputTypeWithOptions()",
      @ref DataProvider::AbstractDataProvider::getPipelineProcessorOutputType() "getPipelineProcessorOutputType()",
      @ref DataProvider::AbstractDataProvider::getPipelineProcessorOutputTypeWithOptions() "getPipelineProcessorOutputTypeWithOptions()"
    - added
      @ref DataProvider::AbstractDataProvider::tryGetActionOptionsForPipelineProcessorWithOptions() "tryGetActionOptionsForPipelineProcessorWithOptions()"
      method and \c DPAT_PIPELINE_PROCESSOR case in the dynamic options dispatch
    - added expression builder support to the
      @ref DataProvider::QoreFilterRecordsProcessor "filter-records" processor via the \c where_cond
      constructor option and dynamic action option with \c supports_expressions
    - added \c supports_pipeline_processor, \c processor_capabilities, and
      \c children_can_support_pipeline_processors fields to
      @ref DataProvider::DataProviderSummaryInfo "DataProviderSummaryInfo" and
      @ref DataProvider::DataProviderInfo "DataProviderInfo"
    - added \c pipeline_processor_options to @ref DataProvider::DataProviderInfo "DataProviderInfo"
    - added @ref DataProvider::DPAT_PIPELINE_PROCESSOR "DPAT_PIPELINE_PROCESSOR" action type code for pipeline processor actions
    - added \c supports_pipeline_processors to
      @ref DataProvider::DataProviderAppInfo "DataProviderAppInfo"
    - added \c processor_capabilities to
      @ref DataProvider::DataProviderActionInfo "DataProviderActionInfo"
    - updated @ref DataProvider::DataProviderPipeline "DataProviderPipeline" to use the return-based API
      internally via
      @ref DataProvider::AbstractDataProcessor::submitAndCollect() "submitAndCollect()" and
      @ref DataProvider::AbstractDataProcessor::flushAndCollect() "flushAndCollect()"
    - added the \c synchronous option to @ref DataProvider::PipelineOptionInfo "PipelineOptionInfo" for
      low-latency single-queue processor pipelines that submit data and wait for results on the caller's thread
    - added methods to return data provider types in the context of option dataprovider_message_support
    - @ref DataProvider::BaseOptionInfo "BaseOptionInfo": added @c required, @c readonly, @c disabled,
      @c preselected, @c has_dependents, @c depends_on, and @c on_change fields; these fields were previously
      defined only in child hashdecls and are now shared across all option types
    - @ref DataProvider::DataProviderAppInfo "DataProviderAppInfo": added @c connection_options and @c auto_url
      fields to support per-app connection option overrides for connection creation forms
    - moved @c ConnectionOptionInfo from the @c ConnectionProvider module to the @c DataProvider module to
      resolve circular dependency; the hashdecl remains in the @c ConnectionProvider namespace for backward
      compatibility
    - added async CRUD API to @ref DataProvider::AbstractDataProvider "AbstractDataProvider" using
      Promise/Future with background thread fallback:
      - @ref DataProvider::AbstractDataProvider::createRecordAsync() "createRecordAsync()"
      - @ref DataProvider::AbstractDataProvider::searchRecordsAsync() "searchRecordsAsync()"
      - @ref DataProvider::AbstractDataProvider::updateRecordsAsync() "updateRecordsAsync()"
      - @ref DataProvider::AbstractDataProvider::deleteRecordsAsync() "deleteRecordsAsync()"
      - @ref DataProvider::AbstractDataProvider::upsertRecordAsync() "upsertRecordAsync()"
      - @ref DataProvider::AbstractDataProvider::doRequestAsync() "doRequestAsync()"

    @subsection dataprovider_v3_2_2 DataProvider v3.2.2
    - fixed setting the mandatory flag for hashes with dynamic fields
      (<a href="https://github.com/qoretechnologies/qore/issues/4992">issue 4992</a>)
    - fixed returning dynamic options for data-dependent action options
      (<a href="https://github.com/qoretechnologies/qore/issues/4985">issue 4985</a>)
    - default values are no longer generated for optional hash types based on their fields
      (<a href="https://github.com/qoretechnologies/qore/issues/4972">issue 4972</a>)
    - fixed typos in @ref DataProvider::DataProviderActionCatalog::getTypeForActionOptions()
      "DataProviderActionCatalog::getTypeForActionOptions()"
      (<a href="https://github.com/qoretechnologies/qore/issues/4971">issue 4971</a>)

    @subsection dataprovider_v3_2_1 DataProvider v3.2.1
    - improved logic handling locked types in the type cache

    @subsection dataprovider_v3_2 DataProvider v3.2
    - added the SuperSoftStringDataType and SuperSoftStringOrNothingDataType types to support
      "soft" string types that accept almost any type and convert it to a string

    @subsection dataprovider_v3_1 DataProvider v3.1
    - added an API to retrieve event data in the context of specific option values
    - fixed handling element allowed values in fields
      (<a href="https://github.com/qoretechnologies/qore/issues/4951">issue 4951</a>)
    - fixed handling implicit default values in @ref DataProvider::HashDataType "HashDataType"
      (<a href="https://github.com/qoretechnologies/qore/issues/4941">issue 4941</a>)

    @subsection dataprovider_v3_0 DataProvider v3.0
    - added support for a data provider action catalog
      (<a href="https://github.com/qoretechnologies/qore/issues/4808">issue 4808</a>)
    - added support for automatically deregistering factories, applications, and actions if an error occurs during
      foreign module initialization
      (<a href="https://github.com/qoretechnologies/qore/issues/4816">issue 4816</a>)

    @subsection dataprovider_v2_7_5 DataProvider v2.7.5
    - fixed conversion of soft binary, bool, float, int, and number "or nothing" types from an empty string to
      @ref NOTHING
      (<a href="https://github.com/qoretechnologies/qore/issues/4836">issue 4836</a>)

    @subsection dataprovider_v2_7_4 DataProvider v2.7.4
    - added \c allowed_values to field data info
      (<a href="https://github.com/qoretechnologies/qore/issues/4762">issue 4762</a>)

    @subsection dataprovider_v2_7_3 DataProvider v2.7.3
    - added missing \c base64binary and \c hexbinary type support
      (<a href="https://github.com/qoretechnologies/qore/issues/4732">issue 4732</a>)

    @subsection dataprovider_v2_7_2 DataProvider v2.7.2
    - fixed bugs handling null hash assignments with fields with default values in
      @ref DataProvider::HashDataType "HashDataType"
      (<a href="https://github.com/qoretechnologies/qore/issues/4715">issue 4715</a>)

    @subsection dataprovider_v2_7_1 DataProvider v2.7.1
    - added
      @ref DataProvider::DataProvider::getFactoryObjectWithTemplate() "DataProvider::getFactoryObjectWithTemplate()"
      and
      @ref DataProvider::AbstractDataProviderFactory::createWithTemplate() "AbstractDataProviderFactory::createWithTemplate()"
      to allow data providers to be created from factories with template arguments
      (<a href="https://github.com/qoretechnologies/qore/issues/4624">issue 4624</a>)
    - \c AbstractDataProvider::search*() fails with record-based data providers that do not provide a record
      definition
      (<a href="https://github.com/qoretechnologies/qore/issues/4624">issue 4624</a>)
    - \c AbstractDataProvider::search*() methods fail with an empty \c where hash argument
      (<a href="https://github.com/qoretechnologies/qore/issues/4622">issue 4622</a>)

    @subsection dataprovider_v2_7 DataProvider v2.7
    - fixed a bug accepting the element type in @ref DataProvider::SoftListDataType "SoftListDataType"
      (<a href="https://github.com/qoretechnologies/qore/issues/4603">issue 4603</a>)
    - added child capability support to data provider summary info
      (<a href="https://github.com/qoretechnologies/qore/issues/4576">issue 4576</a>)

    @subsection dataprovider_v2_6 DataProvider v2.6
    - added child capability support to data provider info
      (<a href="https://github.com/qoretechnologies/qore/issues/4572">issue 4572</a>)

    @subsection dataprovider_v2_5 DataProvider v2.5
    - implemented support for the observer pattern / event API
      (<a href="https://github.com/qoretechnologies/qore/issues/4557">issue 4557</a>)

    @subsection dataprovider_v2_4 DataProvider v2.4
    - allow data providers to be introspected with additional information about children
      (<a href="https://github.com/qoretechnologies/qore/issues/4543">issue 4543</a>)

    @subsection dataprovider_v2_3 DataProvider v2.3
    - updated to use new generic expression support for searches
      (<a href="https://github.com/qoretechnologies/qore/issues/4538">issue 4538</a>)
    - addded support for data provider options to support default values
      (<a href="https://github.com/qoretechnologies/qore/issues/4532">issue 4532</a>)
    - addded \c search_operators to the data provider response to report supported search operators
      (<a href="https://github.com/qoretechnologies/qore/issues/4528">issue 4528</a>)
    - fixed a type error in \c DataProvider::search*() calls with an empty \c where hash argument
      (<a href="https://github.com/qoretechnologies/qore/issues/4511">issue 4511</a>)

    @subsection dataprovider_v2_2_1 DataProvider v2.2.1
    - made it possible to determine the default field type in @ref DataProvider::HashDataType "HashDataType"
      (<a href="https://github.com/qoretechnologies/qore/issues/4491">issue 4491</a>)

    @subsection dataprovider_v2_2 DataProvider v2.2
    - added an attribute to factories to indicate if any children can support the request-response pattern
      (<a href="https://github.com/qoretechnologies/qore/issues/4486">issue 4486</a>)
    - added the @ref DataProvider::DTT_ClientOnly "DTT_ClientOnly" type tag constant
      (<a href="https://github.com/qoretechnologies/qore/issues/4477">issue 4477</a>)

    @subsection dataprovider_v2_1_2 DataProvider v2.1.2
    - fixed a bug where %DataProvider types based on string that accept multiple input types with conversions but are
      not soft types threw spurious errors at runtime with non-string types
      (<a href="https://github.com/qoretechnologies/qore/issues/4471">issue 4471</a>)
    - added the \c desc key supporting a markdown description to data provider info
      (<a href="https://github.com/qoretechnologies/qore/issues/4465">issue 4465</a>)
    - fixed a bug where hash types incorrectly claimed compatibility with incompatible hashes
      (<a href="https://github.com/qoretechnologies/qore/issues/4463">issue 4463</a>)

    @subsection dataprovider_v2_1_1 DataProvider v2.1.1
    - fixed a type error iterating data in @ref DataProvider::DefaultBulkRecordInterface "DefaultBulkRecordInterface"
      (<a href="https://github.com/qoretechnologies/qore/issues/4457">issue 4457</a>)

    @subsection dataprovider_v2_1 DataProvider v2.1
    - added support for tags on data provider types (i.e.
      @ref DataProvider::AbstractDataProviderType "AbstractDataProviderType")
      (<a href="https://github.com/qoretechnologies/qore/issues/4442">issue 4442</a>)
    - fixed data provider factory info to provide info about the actual data provider factory instead of only provider
      info
      (<a href="https://github.com/qoretechnologies/qore/issues/4438">issue 4438</a>)
    - added "from example" APIs to data provider factories:
      - @ref DataProvider::AbstractDataProviderFactory::getProviderFromExample() "AbstractDataProviderFactory::getProviderFromExample()"
      - @ref DataProvider::AbstractDataProviderFactory::getExampleProviderRecordOutput() "AbstractDataProviderFactory::getExampleProviderRecordOutput()"
      (<a href="https://github.com/qoretechnologies/qore/issues/4430">issue 4430</a>)
    - added generic search capabilities to data providers with no native search capabilities
      (<a href="https://github.com/qoretechnologies/qore/issues/4430">issue 4430</a>)

    @subsection dataprovider_v2_0 DataProvider v2.0
    - added a logger to the @ref DataProvider::AbstractDataProvider "AbstractDataProvider" class to enable logging
      (<a href="https://github.com/qoretechnologies/qore/issues/4409">issue 4409</a>)
    - added support for creating, reading, updating, and modifying data providers
      (<a href="https://github.com/qoretechnologies/qore/issues/4395">issue 4395</a>)

    @subsection dataprovider_v1_2_3 DataProvider v1.3
    - added @ref DataProvider::DataProviderTypeCache::listParentTypes() "DataProviderTypeCache::listParentTypes()" to
      allow a list of parent types to be returned
      (<a href="https://github.com/qoretechnologies/qore/issues/4385">issue 4385</a>)

    @subsection dataprovider_v1_2_2 DataProvider v1.2.2
    - added support for starting a transaction with DataProviders that support transaction management
      (<a href="https://github.com/qoretechnologies/qore/issues/4346">issue 4346</a>)

    @subsection dataprovider_v1_2_1 DataProvider v1.2.1
    - return the \c base_type key in input type info in
      AbstractDataProviderType::getInputInfo()
      (<a href="https://github.com/qoretechnologies/qore/issues/4311">issue 4311</a>)

    @subsection dataprovider_v1_2 DataProvider v1.2
    - greatly improved dataprovider and type acquisition speed from clients requiring initialization from the environment
      (<a href="https://github.com/qoretechnologies/qore/issues/4305">issue 4305</a>)

    @subsection dataprovider_v1_1 DataProvider v1.1
    - the @ref DataProvider::DefaultRecordIterator class supports the \c limit search option

    @subsection dataprovider_v1_0_6 DataProvider v1.0.6
    - fixed a bug where the @ref data_type "data" type was not supported correctly as a data provider type
      (<a href="https://github.com/qoretechnologies/qore/issues/4232">issue 4232</a>)

    @subsection dataprovider_v1_0_5 DataProvider v1.0.5
    - fixed an issue where it was not possible for pipeline to flush any pending data or to perform reset or purge
      operations when pipeline processing is complete; for this the
      @ref DataProvider::AbstractDataProcessor::flush() "AbstractDataProcessor::flush()" and
      @ref DataProvider::AbstractDataProcessor::flushImpl() "AbstractDataProcessor::flushImpl()" methods were
      implemented
      (<a href="https://github.com/qoretechnologies/qore/issues/4107">issue 4107</a>)

    @subsection dataprovider_v1_0_4 DataProvider v1.0.4
    - fixed type-handling bugs handling data provider options
      (<a href="https://github.com/qoretechnologies/qore/issues/4062">issue 4062</a>)

    @subsection dataprovider_v1_0_3 DataProvider v1.0.3
    - fixed bugs in the default return value for
      @ref DataProvider::AbstractDataProcessor::getExpectedType() "AbstractDataProcessor::getExpectedType()" and
      @ref DataProvider::AbstractDataProcessor::getReturnType() "AbstractDataProcessor::getReturnType()"
      (<a href="https://github.com/qoretechnologies/qore/issues/4043">issue 4043</a>)

    @subsection dataprovider_v1_0_2 DataProvider v1.0.2
    - fixed a bug where @ref DataProvider::HashDataType "HashDataType" would not enforce fields or field types when
      checking for type and value compatibility
      (<a href="https://github.com/qoretechnologies/qore/issues/4037">issue 4037</a>)
    - added new %Qore base types to the data type hierarchy
    - implemented the following classes:
      - @ref DataProvider::AbstractDataProcessor "AbstractDataProcessor"
      - @ref DataProvider::DataProviderBulkRecordIterator "DataProviderBulkRecordIterator"
      - @ref DataProvider::DataProviderPipeline "DataProviderPipeline"\n
      (<a href="https://github.com/qoretechnologies/qore/issues/3876">issue 3876</a>)
    - added \c DUPLICATE-RECORD exception documentation for
      @ref DataProvider::AbstractDataProvider::createRecord() "AbstractDataProvider::createRecord()"
    - updated to allow data provider type attributes to appear as children in the type hierarchy
      (<a href="https://github.com/qoretechnologies/qore/issues/4015">issue 4015</a>)

    @subsection dataprovider_v1_0_1 DataProvider v1.0.1
    - implemented callbacks to allow for dynamic elements of request-response data providers (such as URI paths) to be
      resolved at runtime
      (<a href="https://github.com/qoretechnologies/qore/issues/3838">issue 3838</a>)
    - @ref DataProvider::AbstractDataProviderType "AbstractDataProviderType" and
      @ref DataProvider::AbstractDataField "AbstractDataField" classes made serializable
      (<a href="https://github.com/qoretechnologies/qore/issues/3809">issue 3809</a>)
    - implemented the @ref DataProvider::DataProviderTypeCache "DataProviderTypeCache" class to encapsulate reusable
      type caching logic
      (<a href="https://github.com/qoretechnologies/qore/issues/3810">issue 3810</a>)

    @subsection dataprovider_v1_0 DataProvider v1.0
    - initial release
*/

#! contains all public definitions in the DataProvider module
public namespace DataProvider {
}
