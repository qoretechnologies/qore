#! Cohere-backed reranker — calls the Cohere `/v2/rerank` endpoint
public class CohereReranker inherits AbstractReranker {
    public {
        const DefaultModel = CohereRestClient::CohereRestClientBase::DefaultRerankModel;
    }

    private {
        hash<RerankerConfig> config;
        string model_name;
        *CohereRestClient::CohereRestClientIo rest_client;
        Mutex init_mutex();
    }

    constructor(hash<RerankerConfig> config) {
        if (!config.api_key.val()) {
            throw "RERANKER-CONFIG-ERROR",
                "CohereReranker requires 'api_key' in RerankerConfig";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
    }

    list<hash<RerankResult>> rerank(string query, list<string> documents, int top_k,
            *hash<auto> opts) {
        if (!documents) {
            return ();
        }
        ensureRestClient();

        hash<auto!> body = {
            "model": model_name,
            "query": query,
            "documents": documents,
            "top_n": top_k,
            "return_documents": True,
        };
        if (opts) {
            if (exists opts.max_chunks_per_doc) {
                body."max_chunks_per_doc" = opts.max_chunks_per_doc;
            }
            if (exists opts.rank_fields) {
                body."rank_fields" = opts.rank_fields;
            }
            if (exists opts.return_documents) {
                body."return_documents" = opts.return_documents;
            }
        }

        hash<auto> resp = rest_client.restPost("/rerank", body);

        list<hash<auto>> data = resp.body.results ?? ();
        list<hash<RerankResult>> result = ();
        foreach hash<auto> item in (data) {
            int idx = item."index";
            string doc = item.document.typeCode() == NT_STRING
                ? item.document
                : (exists item.document.text ? item.document.text : documents[idx]);
            push result, <RerankResult>{
                "index": idx,
                "score": item.relevance_score.toFloat(),
                "document": doc,
            };
        }
        return result;
    }

    *string getModel() {
        return model_name;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                hash<auto> opts = {
                    "apikey": config.api_key,
                };
                if (config.url.val()) {
                    opts.url = config.url;
                }
                rest_client = new CohereRestClient::CohereRestClientIo(opts);
            }
        }
    }
}

#! Factory for @ref CohereReranker
public class CohereRerankerFactory inherits AbstractRerankerFactory {
    string getType() {
        return "cohere";
    }

    string getDisplayName() {
        return "Cohere rerank";
    }

    AbstractReranker create(hash<RerankerConfig> config) {
        return new CohereReranker(config);
    }
}
}
