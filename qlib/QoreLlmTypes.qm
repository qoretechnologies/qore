%requires qore >= 2.0
%modern
%allow-weak-references

%requires reflection
%requires json

module QoreLlmTypes {
    version = "1.0.0";
    desc = "user module providing the provider-neutral hashdecls and abstract "
        "provider classes shared by QoreLlmUtils and LLM provider modules";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
    # the module's own code waits between request retries with usleep(), and the asynchronous calls use timers of
    # the async I/O controller and the worker threads of LlmThreadPoolExecutor
    domains = "PROCESS_CONTROL,THREAD_CONTROL";
}

/** @mainpage QoreLlmTypes Module

    @tableofcontents

    @section qorellmtypesintro QoreLlmTypes Module Introduction

    The %QoreLlmTypes module provides the provider-neutral type and abstract
    class layer that @ref qorellmutilsintro "QoreLlmUtils" and individual
    LLM REST client modules (GeminiRestClient, AnthropicRestClient,
    OpenAiRestClient, SGLangRestClient) share.  It exists as a separate
    module so that REST client modules can depend on the abstract provider
    contract without forming a dependency cycle with %QoreLlmUtils.

    Symbols defined here live in the @ref qorellmutilsintro "QoreLlmUtils" namespace so callers
    that \c "%requires QoreLlmUtils" see them transparently; the split is
    purely a packaging detail.

    @section qorellmtypesmembers Public symbols

    Hashdecls describing requests and responses:

    - @ref QoreLlmUtils::LlmBackendConfig — backend configuration
    - @ref QoreLlmUtils::LlmRequestOptions — per-call request overrides
    - @ref QoreLlmUtils::LlmCompletionResult — completion result
    - @ref QoreLlmUtils::ChatMessage — multi-turn conversation message
    - @ref QoreLlmUtils::ChatToolCall — tool call requested by the model
    - @ref QoreLlmUtils::ToolDefinition — tool the model may call
    - @ref QoreLlmUtils::ContentPart — multimodal message part
    - @ref QoreLlmUtils::ChatResponse — multi-turn chat result
    - @ref QoreLlmUtils::ChatStreamEvent — streaming event delta
    - @ref QoreLlmUtils::LlmProviderInfo — provider discovery metadata

    Abstract classes:

    - @ref QoreLlmUtils::AbstractLlmProvider — provider-neutral
      complete / chat / chatStream contract plus shared helpers
    - @ref QoreLlmUtils::AbstractLlmProviderFactory — registration handle
      and capability description

    Classes:

    - @ref QoreLlmUtils::LlmCancellation — cancellation token for a request,
      set in @ref QoreLlmUtils::LlmRequestOptions::cancellation "LlmRequestOptions::cancellation"
    - @ref QoreLlmUtils::LlmAsyncOperation — an asynchronous call in flight
    - @ref QoreLlmUtils::LlmAsyncExecutor — runs the steps and callbacks of asynchronous calls, and
      @ref QoreLlmUtils::LlmThreadPoolExecutor "LlmThreadPoolExecutor", a simple implementation
    - @ref QoreLlmUtils::LlmAsyncSseRequest — a streamed request of an asynchronous call, for providers

    @section qorellmtypesasync Asynchronous Calls

    @ref QoreLlmUtils::AbstractLlmProvider::chatAsync() "AbstractLlmProvider::chatAsync()" and
    @ref QoreLlmUtils::AbstractLlmProvider::chatStreamAsync() "chatStreamAsync()" make the request of
    @ref QoreLlmUtils::AbstractLlmProvider::chat() "chat()" and @ref QoreLlmUtils::AbstractLlmProvider::chatStream()
    "chatStream()" without holding a thread while the provider is awaited, and return an
    @ref QoreLlmUtils::LlmAsyncOperation "LlmAsyncOperation".  The request waits in the async I/O controller, a retry
    waits on a timer of the controller, and every step that runs %Qore code (preparing the credentials and the body
    of a request, reading a response, delivering a stream event, the caller's callbacks) runs in a thread of the
    @ref QoreLlmUtils::LlmAsyncExecutor "executor" that the caller gives with the call.  The retry policy, the errors,
    the cancellation and the results are those of the synchronous calls.

    Providers implement the asynchronous transport by overriding
    @ref QoreLlmUtils::AbstractLlmProvider::startChatAsync() "startChatAsync()" and
    @ref QoreLlmUtils::AbstractLlmProvider::startChatStreamAsync() "startChatStreamAsync()" with
    @ref QoreLlmUtils::AbstractLlmProvider::startRequestAsync() "startRequestAsync()" and
    @ref QoreLlmUtils::LlmAsyncSseRequest "LlmAsyncSseRequest"; a provider that does not runs its synchronous call in a
    thread of the executor (@ref QoreLlmUtils::AbstractLlmProvider::supportsAsyncChat() "supportsAsyncChat()").

    @section qorellmtypesrelnotes Release Notes

    @subsection qorellmtypes_1_0 QoreLlmTypes 1.0
    - initial release
*/

#! Provider-neutral LLM types and abstract classes (shared with QoreLlmUtils)
public namespace QoreLlmUtils {

#! Configuration for the LLM backend
/** Specifies how to connect to the LLM — via an OpenAI-compatible HTTP
    endpoint, the Anthropic Messages API, the Google Gemini API, or a custom
    callback (e.g., for routing through an API gateway).
*/
public hashdecl LlmBackendConfig {
    #! Mode: "http" for OpenAI-compatible, "anthropic" for Anthropic Messages API,
    #! "sglang" for SGLang servers (OpenAI-compatible + local defaults),
    #! "gemini" for Google Gemini generateContent,
    #! "callback" for a custom API call function
    string mode;
    #! Base URL of the LLM service (required for "http", "anthropic", and "sglang" modes; optional for "gemini")
    *string url;
    #! Model name to pass in the request
    *string model;
    #! API key for authentication — this is the secret key from your LLM provider (e.g., from the OpenAI or Anthropic dashboard)
    *string api_key;
    #! Maximum provider completion/output budget; default 4096
    /** Compatibility alias for @ref max_output_tokens.  New code should use
        @ref max_output_tokens so callers express intent without depending on
        any provider's wire-field name. */
    int max_tokens = 4096;
    #! Provider-neutral maximum output/completion budget
    /** Providers map this to their own request field, for example OpenAI
        \c max_tokens or \c max_completion_tokens, Anthropic \c max_tokens,
        and Gemini \c generationConfig.maxOutputTokens.  When unset,
        @ref max_tokens is used for backward compatibility. */
    *int max_output_tokens;
    #! Optional hidden-reasoning / thinking token budget
    /** Providers that support a numeric hidden-reasoning budget map this to
        their native field.  Providers without such a control ignore it, except for zero: a budget of zero without a
        @ref reasoning_effort asks to turn reasoning off, like @ref disable_reasoning.

        @note Newer model families have removed numeric reasoning budgets in
        favor of a qualitative effort level; see @ref reasoning_effort.  On
        Anthropic this applies from Claude Opus 4.7 on, where sending a
        numeric budget is rejected outright, so the Anthropic provider
        ignores this field and uses @ref reasoning_effort instead. Gemini 3.x also omits numeric budgets
        (including -1), except that zero selects its lowest thinking level, since Gemini 3.x cannot turn thinking
        off; use @ref reasoning_effort or the model default. Gemini 2.5 retains budgets, and zero selects the
        smallest budget of Gemini 2.5 Pro, which cannot turn thinking off either.  Models that cannot turn
        reasoning off are reported with @ref LlmProviderInfo::reasoning_always_on. */
    *int reasoning_token_budget;
    #! Optional qualitative hidden-reasoning effort level
    /** One of \c "minimal", \c "low", \c "medium", \c "high", \c "xhigh", or \c "max".
        Providers that expose a qualitative reasoning control map this to
        their native field (Anthropic \c output_config.effort, Gemini 3.x \c thinkingConfig.thinkingLevel); providers
        without such a control ignore it.  Replaces
        @ref reasoning_token_budget on model families that removed numeric
        budgets. Gemini 3.x maps \c "xhigh" and \c "max" to \c "HIGH"; other levels must be supported
        by the selected model. */
    *string reasoning_effort;
    #! Disable hidden reasoning entirely when the provider supports it
    /** Some model families reason by default when no reasoning control is
        sent, and that reasoning is billed against the same output budget
        that must carry the visible response.  Set this to @ref True to ask
        the provider to turn reasoning off.

        Every provider turns reasoning off where the model can (for example the reasoning effort \c none on OpenAI,
        \c thinking \c {"type": "disabled"} on Anthropic), and selects the model's lowest reasoning setting where it
        cannot (see @ref LlmProviderInfo::reasoning_always_on).  This option wins over @ref reasoning_effort, and a
        @ref reasoning_token_budget of zero without a reasoning effort has the same meaning.  For models whose
        reasoning controls have not been verified, providers keep sending what they sent before; each provider
        module documents its models.  Leaving it unset sends no reasoning control at all, so the model's own
        default applies. */
    *bool disable_reasoning;
    #! Sampling temperature; default 0.0 (deterministic)
    /** @note Not every provider accepts sampling parameters.  Anthropic
        removed \c temperature from Claude Opus 4.7 on, and the Anthropic
        provider never sends it. Gemini 3.x also omits sampling parameters; older Gemini models retain them. */
    float temperature = 0.0;
    #! HTTP connect timeout in milliseconds; default 10000
    int connect_timeout_ms = 10000;
    #! HTTP request timeout in milliseconds; default 120000
    int timeout_ms = 120000;
    #! Optional protocol hint passed to HTTP-backed providers (for example "h2")
    *string protocol;
    #! Anthropic API version header; default "2023-06-01"
    string anthropic_version = "2023-06-01";
    #! Maximum retry attempts for transient errors (429, 5xx); default 3;
    #! set to 0 to disable retries
    int max_retries = 3;
    #! Free-form per-provider configuration not otherwise expressible in this hashdecl
    /** Allows provider subclasses to accept vendor-specific knobs without
        forcing every key into this shared hashdecl.  Examples:
        - Azure OpenAI: \c azure_deployment, \c azure_api_version,
          \c azure_auth_mode, \c azure_tenant_id, \c azure_client_id,
          \c azure_client_secret
        - Vertex AI: \c gcp_project_id, \c gcp_region, \c gcp_sa_json_path,
          \c gcp_model_publisher
        - AWS Bedrock: \c aws_region, \c aws_service overrides,
          \c bedrock_invoke_fallback table
    */
    *hash<auto> provider_options;
    #! Callback mode: a callable that performs the API call and returns
    #! the response hash in OpenAI-compatible format
    *code<hash<auto>(string, string, hash<auto>)> api_callback;
    #! Callback mode streaming dispatcher (counterpart to @ref api_callback)
    /** Caller-supplied function that performs the API call AND fires
        @a delta_cb once per upstream stream chunk (OpenAI-compatible
        shape).  Required for @ref QoreLlmUtils::CallbackLlmProvider::chatStream "CallbackLlmProvider::chatStream()"; when
        unset, the provider falls back to invoking @ref api_callback once
        (single non-streamed call surfaced as a synthetic single-delta
        event followed by a terminal @c done event) so callers that depend
        on streaming get a coherent event sequence either way.

        The signature is <tt>(method</tt>, path, body, delta_cb) → @ref nothing
        where each call to @c delta_cb passes one OpenAI-shaped
        \c chat.completion.chunk hash. */
    *code<nothing(string, string, hash<auto>, code<nothing(hash<auto>)>)> api_stream_callback;
    #! Callback mode method hint passed to @ref api_callback; default "POST"
    string callback_method = "POST";
    #! Callback mode endpoint/path hint passed to @ref api_callback; default "chat/completions"
    string callback_path = "chat/completions";
    #! Initial retry delay in milliseconds for exponential backoff; default 1000
    int retry_delay_ms = 1000;
    #! Optional telemetry observer for all calls through this backend
    /** The observer receives provider-neutral lifecycle events.  It is
        intentionally policy-free: no cost calculation, no tenancy rules, and
        no persistence are performed by QoreLlmUtils.
    */
    *hash<LlmTelemetryObserver> telemetry_observer;
    #! Optional caller-owned telemetry correlation context
    /** Copied verbatim to telemetry events unless overridden per call via
        @ref LlmRequestOptions::telemetry_context.
    */
    *hash<auto> telemetry_context;
}

#! Caller-owned cancellation token for LLM requests
/** Pass the token in @ref LlmRequestOptions::cancellation and call @ref cancel() from any thread to stop the
    request.  A request that has not been sent yet is not sent; a retry backoff wait ends at once; and a streaming
    request in flight has its connection closed immediately, so the provider stops generating (and billing) the
    response.  The interrupted call raises \c LLM-CANCELLED.

    Cancellation is event-driven: the handlers that providers register with @ref addHandler() run in the thread
    calling @ref cancel(), so a stream blocked waiting for its next event wakes at once instead of waiting for its
    request timeout.

    Stream callbacks may cancel their own request. No subsequent event is delivered, and the call raises
    \c LLM-CANCELLED even when cancellation occurs in the final callback. A callback exception is propagated
    according to the provider's error handling; cancellation does not replace that exception.

    A token stays cancelled; use a new token for each request that can be cancelled independently.

    @par Example
    @code{.py}
LlmCancellation cancellation();
# e.g. called from a UI or control thread when the user presses "stop"
code<nothing()> stop = sub () { cancellation.cancel("stopped by the user"); };
try {
    llm.chatStream(messages, sub (hash<ChatStreamEvent> event) {
        print(event.delta ?? "");
    }, NOTHING, <LlmRequestOptions>{"cancellation": cancellation});
} catch (hash<ExceptionInfo> ex) {
    if (ex.err != "LLM-CANCELLED") {
        rethrow;
    }
}
    @endcode

    @note All methods are thread-safe.
*/
public class LlmCancellation {
    private:internal {
        #! Guards the token state
        Mutex m();

        #! Signaled when the token is cancelled
        Condition cond();

        #! True once the token is cancelled
        bool cancelled = False;

        #! The reason given when the token was cancelled
        *string reason;

        #! Handlers to run on cancellation, keyed by handler ID
        hash<string, code> handlers = {};

        #! The last handler ID issued
        int handler_seq = 0;
    }

    #! Cancels the token
    /** Runs every registered handler once in the calling thread and wakes every thread waiting in
        @ref waitCancelled().  Calls after the first have no effect.

        @param reason an optional reason reported in the \c LLM-CANCELLED exception

        @throw any exception raised by a handler is rethrown after all handlers have run; when several handlers
        raise exceptions, the first one is rethrown
    */
    cancel(*string reason) {
        hash<string, code> to_run;
        {
            AutoLock al(m);
            if (cancelled) {
                return;
            }
            cancelled = True;
            self.reason = reason;
            to_run = handlers;
            handlers = {};
            cond.broadcast();
        }
        *hash<ExceptionInfo> first_error;
        foreach code handler in (to_run.iterator()) {
            try {
                handler();
            } catch (hash<ExceptionInfo> ex) {
                first_error = first_error ?? ex;
            }
        }
        if (first_error) {
            throw first_error.err, first_error.desc, first_error.arg;
        }
    }

    #! Returns @ref True if the token has been cancelled
    bool isCancelled() {
        AutoLock al(m);
        return cancelled;
    }

    #! Returns the reason given to @ref cancel(), if any
    *string getReason() {
        AutoLock al(m);
        return reason;
    }

    #! Raises \c LLM-CANCELLED if the token has been cancelled
    /** @throw LLM-CANCELLED the token has been cancelled; the exception argument is a hash with a \c reason key
    */
    check() {
        AutoLock al(m);
        if (cancelled) {
            throwCancelled();
        }
    }

    #! Registers a handler that runs when the token is cancelled
    /** @param handler the code to run; it is called with no arguments in the thread that calls @ref cancel()

        @return an ID for @ref removeHandler(); if the token is already cancelled, the handler runs immediately in
        the calling thread and 0 is returned

        @throw any exception raised by the handler when it runs immediately
    */
    int addHandler(code<nothing()> handler) {
        {
            AutoLock al(m);
            if (!cancelled) {
                int id = ++handler_seq;
                handlers{id} = handler;
                return id;
            }
        }
        handler();
        return 0;
    }

    #! Removes a handler registered with @ref addHandler()
    /** @param id the ID returned by @ref addHandler()

        @return @ref True if the handler was registered and has been removed, @ref False if it was not registered
        (for example because it has already run)
    */
    bool removeHandler(int id) {
        AutoLock al(m);
        if (!handlers{id}) {
            return False;
        }
        remove handlers{id};
        return True;
    }

    #! Waits until the token is cancelled or the timeout expires
    /** @param timeout_ms the maximum time to wait; a value <= 0 does not wait

        @return @ref True if the token is cancelled, @ref False if the timeout expired first
    */
    bool waitCancelled(timeout timeout_ms) {
        date deadline = now_us() + milliseconds(timeout_ms);
        AutoLock al(m);
        while (!cancelled) {
            int remaining = (deadline - now_us()).durationMilliseconds();
            if (remaining <= 0) {
                break;
            }
            cond.wait(m, remaining);
        }
        return cancelled;
    }

    #! Raises \c LLM-CANCELLED; the lock must be held
    private:internal throwCancelled() {
        throw "LLM-CANCELLED", sprintf("the LLM request was cancelled%s", reason.val() ? ": " + reason : ""),
            {"reason": reason};
    }
}

#! Per-call request overrides for LLM calls
/** Lets callers keep a long-lived backend for one provider/connection while
    selecting a different model for individual tasks.  This is important for
    applications that intentionally mix model tiers (for example: a low-cost
    summarization pass, a stronger planning pass, and a premium review pass)
    without rebuilding the backend object.
*/
public hashdecl LlmRequestOptions {
    #! Model name for this call; overrides @ref LlmBackendConfig::model
    *string model;
    #! Maximum tokens for this call; compatibility alias for @ref max_output_tokens
    *int max_tokens;
    #! Provider-neutral maximum output/completion budget for this call
    /** Overrides @ref LlmBackendConfig::max_output_tokens and
        @ref LlmBackendConfig::max_tokens. */
    *int max_output_tokens;
    #! Optional hidden-reasoning / thinking token budget for this call
    /** Overrides @ref LlmBackendConfig::reasoning_token_budget. */
    *int reasoning_token_budget;
    #! Optional qualitative hidden-reasoning effort for this call
    /** Overrides @ref LlmBackendConfig::reasoning_effort. */
    *string reasoning_effort;
    #! Disable hidden reasoning for this call when the provider supports it
    /** Overrides @ref LlmBackendConfig::disable_reasoning. */
    *bool disable_reasoning;
    #! Sampling temperature for this call; overrides @ref LlmBackendConfig::temperature
    *float temperature;
    #! Positive HTTP request timeout in milliseconds for this call
    /** Overrides @ref LlmBackendConfig::timeout_ms without mutating the
        backend or its shared connection pool.  HTTP-backed providers apply
        the value only to the current transport request. */
    *int timeout_ms;
    #! Maximum retry attempts for transient errors on this call
    /** Overrides @ref LlmBackendConfig::max_retries. A value of zero disables
        transport retries while preserving the initial request. */
    *int max_retries;
    #! Maximum retries of an HTTP 429 (rate limit) answer on this call
    /** Overrides @ref max_retries for a 429 alone; when not given, a 429 is retried as any other transient error.
        Zero returns a 429 at once, for a caller that asks again itself after a wait of its own choosing.
    */
    *int rate_limit_retries;
    #! The time by which this call, with every retry and repair request it makes, must be done
    /** @ref AbstractLlmProvider::getRequestTimeoutMs() gives each transport request only the time left before it,
        and @ref AbstractLlmProvider::withRetry() makes no retry whose wait would not end before it, so the call's
        timeout bounds the whole call rather than each request in it.  @ref QoreLlmUtils::LlmBackend "LlmBackend"
        sets it from the call's timeout when a call starts, unless the caller gives it.
    */
    *date deadline;
    #! JSON schema to request structured output when the backend supports it
    *hash<auto> output_schema;
    #! Provider-specific request body fields merged into the generated body
    *hash<auto> body_options;
    #! Cached content (explicit prompt cache) resource for this call
    /** For providers with explicit prompt caching, such as Gemini and Vertex AI (\c cachedContents), the name or
        ID of a cached content resource that holds the system instruction, tools and leading contents of the
        request.  The request then references it and does not send those parts again; system messages and tools
        given with the request are not sent.  Providers without explicit caching ignore it.
    */
    *string cached_content;
    #! Optional per-call telemetry observer
    /** When set, this observer receives provider-neutral call lifecycle
        events for this request.  Per-call observers override the backend
        configuration observer.  Observer failures are ignored by the backend
        so observability cannot break the LLM call.
    */
    *hash<LlmTelemetryObserver> telemetry_observer;
    #! Optional caller-owned telemetry correlation context
    /** Copied verbatim to telemetry events.  The Qore module treats this as
        opaque metadata; applications such as Qorus can use it to attach trace
        ids, span ids, tenant ids, or other policy-layer context without
        baking those concepts into QoreLlmUtils.
    */
    *hash<auto> telemetry_context;
    #! Optional cancellation token for this call
    /** When the token is cancelled, a request not yet sent is not sent, a retry backoff wait ends, and a
        streaming request in flight has its connection closed at once so the provider stops generating the
        response; the call then raises \c LLM-CANCELLED.  See @ref LlmCancellation.
    */
    *LlmCancellation cancellation;
    #! Optional observer of the raw output of a stream that the provider holds back until it is complete
    /** A provider that must validate or restore a structured response before the caller sees it, for example a
        strict schema with optional fields or a strict schema that the provider can only check locally, delivers
        that response to the stream callback once, when it is complete.  When this observer is set, the provider
        also passes it each raw event of such a response as it arrives, with any text in \c delta and the parsed
        provider event in \c raw.  This output is raw and unvalidated: it can hold placeholder values that the
        final response does not, and it never replaces the final response.  Streams that deliver their events
        directly never call it.

        An exception raised by the observer stops the response: the connection is closed, so the provider stops
        generating it, and the exception is raised to the caller unchanged.  A caller can so stop a response that
        has gone wrong, for example one that repeats itself until its output limit.

        @par Example
        @code{.py}
int chars = 0;
opts.stream_progress = sub (hash<ChatStreamEvent> event) {
    chars += (event.delta ?? "").length();
    if (chars > 200000) {
        throw "MY-RUNAWAY-OUTPUT", "the response is far longer than any valid answer";
    }
};
        @endcode
    */
    *code<nothing(hash<ChatStreamEvent>)> stream_progress;
}

#! Result from an LLM completion call
public hashdecl LlmCompletionResult {
    #! The generated text content
    string content;
    #! Token usage information (provider-specific)
    hash<auto> usage;
}

#! A single tool call returned by the LLM
public hashdecl ChatToolCall {
    #! Unique ID for this tool call (from the LLM response)
    string id;
    #! Function/tool name to call
    string name;
    #! Parsed arguments hash to pass to the tool
    *hash<auto> arguments;
    #! Opaque provider reasoning signature that must be echoed back with the call
    /** Gemini 3.x returns a \c thoughtSignature on each \c functionCall part and rejects any
        follow-up request that replays the call without it (HTTP 400, "Function call is missing a
        thought_signature in functionCall parts").  The value is provider-opaque: it is never
        inspected, only carried through the conversation and returned verbatim.  Providers that do
        not use reasoning signatures leave this unset.
    */
    *string thought_signature;
}

#! A content part in a multimodal message (text, image, or file)
public hashdecl ContentPart {
    #! Part type: "text" for text content, "image" for image data, or "file" for file data
    string type;
    #! Text content (when type is "text")
    *string text;
    #! Binary data (when type is "image" or "file")
    *binary data;
    #! MIME type (when type is "image" or "file"), e.g., "image/png", "application/pdf"
    *string mime_type;
    #! File name (when type is "file")
    *string filename;
    #! Provider-specific cache-control metadata for providers that support it
    *hash<auto> cache_control;
}

#! A message in a multi-turn conversation
public hashdecl ChatMessage {
    #! Message role: "system", "user", "assistant", or "tool"
    string role;
    #! Text content (may be empty for assistant messages that only contain tool_calls)
    *string content;
    #! Multimodal content parts (images + text); when set, takes precedence
    #! over \c content for the wire format sent to the LLM
    *list<hash<ContentPart>> content_parts;
    #! Tool calls requested by the assistant (present when role is "assistant")
    *list<hash<ChatToolCall>> tool_calls;
    #! ID of the tool call this message is responding to (when role is "tool")
    *string tool_call_id;
    #! Tool name (when role is "tool")
    *string name;
    #! Opaque provider reasoning content that must be replayed with this turn
    /** Anthropic thinking models reject a follow-up request that replays an
        assistant turn without the \c thinking blocks the model produced,
        because each block carries a signature the API verifies.  Copy
        @ref ChatResponse::reasoning_blocks here when appending an assistant
        turn to a conversation so tool loops keep working.

        The value is provider-opaque: it is never inspected or rewritten,
        only carried through the conversation and returned verbatim.
        Providers that do not use reasoning blocks leave this unset. */
    *list<auto> reasoning_blocks;
}

#! Definition of a tool the LLM can call
public hashdecl ToolDefinition {
    #! Tool name (must match ^[a-zA-Z0-9_-]{1,64}$)
    string name;
    #! Human-readable description of what the tool does
    *string description;
    #! JSON Schema describing the tool's parameters
    *hash<auto> parameters;
    #! Whether the provider must enforce the function parameter schema
    *bool strict;
    #! Provider-specific cache-control metadata for providers that support it
    *hash<auto> cache_control;
}

#! Response from a multi-turn chat call
public hashdecl ChatResponse {
    #! Provider response ID when available
    *string id;
    #! Model used by the provider when available
    *string model;
    #! Why the LLM stopped
    /** One of \c "end_turn" (normal), \c "tool_use" (wants tool calls),
        \c "max_tokens" (hit the limit), \c "stop_sequence" (a stop sequence
        was generated), or \c "content_filter" (the prompt or the response was
        filtered by the provider)
    */
    string stop_reason;
    #! Text content (if any)
    *string content;
    #! Tool calls the LLM wants executed (when stop_reason is "tool_use")
    *list<hash<ChatToolCall>> tool_calls;
    #! Token usage information
    hash<auto> usage;
    #! Raw provider response when callers need provider-specific metadata
    *hash<auto> raw;
    #! Provider-specific diagnostics suitable for surfacing through facade APIs
    *hash<auto> provider_diagnostics;
    #! Opaque provider reasoning content produced with this response
    /** Copy this to @ref ChatMessage::reasoning_blocks on the assistant turn
        appended to the conversation; Anthropic thinking models reject a
        replayed turn whose reasoning blocks were dropped.  Unset for
        providers and models that produce no reasoning blocks. */
    *list<auto> reasoning_blocks;
}

#! Provider-neutral token usage counters
/** Providers expose token accounting under different names.  This hashdecl
    is the stable normalized shape produced by
    @ref QoreLlmUtils::LlmTelemetry::normalizeUsage "normalizeUsage".
*/
public hashdecl LlmTokenUsage {
    #! Prompt / input token count
    int input_tokens = 0;
    #! Completion / output token count
    /** The count keeps the meaning of the provider's own count: it includes the reasoning tokens of providers
        that report them as part of it, such as OpenAI, and excludes the thinking tokens of providers that
        report them separately, such as Gemini
    */
    int output_tokens = 0;
    #! Total tokens reported by the provider, or derived from the counts above
    /** A derived total adds a reasoning count only when the provider reports it separately from its output
        count, so reasoning tokens are never counted twice
    */
    int total_tokens = 0;
    #! Input tokens served from a provider cache
    int cached_input_tokens = 0;
    #! Input tokens written to a provider cache
    int cache_creation_input_tokens = 0;
    #! Hidden reasoning / thinking token count
    int reasoning_tokens = 0;
    #! Whether \c reasoning_tokens are part of \c output_tokens
    /** @ref True when the provider reports its reasoning tokens as part of its output count, such as OpenAI;
        @ref False when it reports them separately, such as Gemini, in which case the generated tokens to bill
        are \c output_tokens plus \c reasoning_tokens.  Set by
        @ref QoreLlmUtils::LlmTelemetry::normalizeUsage "normalizeUsage"; no value means no usage was reported.
    */
    *bool reasoning_in_output;
    #! Embedding token count when the response came from an embedding API
    int embedding_tokens = 0;
    #! Reranker token count when the response came from a rerank API
    int reranker_tokens = 0;
}

#! LLM lifecycle telemetry event
/** This event intentionally excludes raw prompt and response text.  Callers
    that need content capture should add it explicitly in their own policy
    layer after redaction.
*/
public hashdecl LlmTelemetryEvent {
    #! Event type: "start", "stream_delta", "end", "error", or "retry"
    string type;
    #! Operation: "complete", "chat", "chat_stream", "chat_completions", etc.
    string operation;
    #! Provider mode from @ref LlmBackendConfig::mode
    string provider_mode;
    #! Configured or response model when known
    *string model;
    #! Event timestamp
    date timestamp;
    #! Caller-owned opaque correlation context
    *hash<auto> telemetry_context;
    #! Safe request summary without raw prompt text
    *hash<auto> request;
    #! Safe response summary without raw response text
    *hash<auto> response;
    #! Safe stream delta summary without raw delta text
    *hash<auto> stream_delta;
    #! Normalized provider usage counters
    *hash<LlmTokenUsage> usage;
    #! Raw provider usage hash when available
    *hash<auto> raw_usage;
    #! Status: "ok" or "error"
    *string status;
    #! Provider stop / finish reason when available
    *string stop_reason;
    #! Provider response id when available
    *string response_id;
    #! Call latency in milliseconds
    *int latency_ms;
    #! Time to first streamed delta in milliseconds
    *int time_to_first_delta_ms;
    #! Normalized error metadata
    *hash<auto> error;
    #! Additional non-sensitive attributes
    *hash<auto> attributes;
}

#! Optional observer callbacks for LLM telemetry
/** All callbacks are best-effort.  The backend catches and ignores observer
    exceptions so an observability sink cannot affect model-call behavior.
*/
public hashdecl LlmTelemetryObserver {
    #! Receives every event
    *code<nothing(hash<LlmTelemetryEvent>)> event_callback;
    #! Receives "start" events
    *code<nothing(hash<LlmTelemetryEvent>)> start_callback;
    #! Receives "stream_delta" events
    *code<nothing(hash<LlmTelemetryEvent>)> stream_delta_callback;
    #! Receives "end" events
    *code<nothing(hash<LlmTelemetryEvent>)> end_callback;
    #! Receives "error" events
    *code<nothing(hash<LlmTelemetryEvent>)> error_callback;
    #! Receives "retry" events when a backend can surface retry attempts
    *code<nothing(hash<LlmTelemetryEvent>)> retry_callback;
}

#! A streaming event from a chat completion
/** Providers deliver each provider-native stream event at most once, with the
    parsed event in \c raw; events that carry no text, such as tool-call or
    usage events, are delivered without \c delta.  The final event has \c done
    set and can also carry the last text in \c delta and the last native event
    in \c raw; a final event without \c raw is delivered when the stream ended
    without a native final event.

    Tool calls, the finish reason, and usage are read from \c raw with
    @ref AbstractLlmProvider::updateOpenAiStreamStateFromRaw() and
    @ref AbstractLlmProvider::getOpenAiToolCallDeltas(), for example by
    @ref QoreLlmUtils::LlmBackend::chatStreamCollect "LlmBackend::chatStreamCollect()".
*/
public hashdecl ChatStreamEvent {
    #! Event type from the SSE stream (e.g., "content_block_delta", "message_delta")
    *string event;
    #! Text delta (incremental text content in this chunk)
    *string delta;
    #! True when this is the final event (stream complete); the final event can also carry text
    bool done = False;
    #! Raw event data (the full parsed JSON from the SSE data field)
    *hash<auto> raw;
}

#! Static metadata describing a registered LLM provider
/** Returned by @ref AbstractLlmProviderFactory::getInfo() so tooling can
    discover provider capabilities without instantiating a backend.
*/
public hashdecl LlmProviderInfo {
    #! The mode string used to look up this provider (e.g. \c "gemini")
    string mode;
    #! Human-readable name for diagnostics and discovery UIs
    string display_name;
    #! Module that supplies this provider (e.g. \c "GeminiRestClient")
    *string module_name;
    #! True when the provider can stream chat completions
    bool supports_streaming = False;
    #! True when the provider can dispatch tool / function calls
    bool supports_tools = False;
    #! True when the provider supports structured output (JSON schema)
    bool supports_structured_output = False;
    #! True when the provider accepts multimodal content (images etc.)
    bool supports_multimodal = False;
    #! True when the provider maps @ref LlmRequestOptions::reasoning_effort for supported models
    bool supports_reasoning_effort = False;
    #! True when the provider maps @ref LlmRequestOptions::reasoning_token_budget for supported models
    bool supports_reasoning_token_budget = False;
    #! True when the model cannot turn hidden reasoning off
    /** Even the model's lowest reasoning setting spends reasoning tokens, and they come out of the same output budget
        as the visible response: a caller that limits the output tokens of a call needs to leave room for them, or the
        visible response can be cut off.  The lowest setting is what a
        @ref LlmRequestOptions::reasoning_token_budget "reasoning_token_budget" of zero or
        @ref LlmRequestOptions::disable_reasoning "disable_reasoning" selects on the providers that map them; on other
        providers, a call without a reasoning effort uses the model's default reasoning, which can spend more.

        This is a property of a model, which @ref AbstractLlmProviderFactory::getModelInfo() reports; the information
        of the provider as a whole (@ref AbstractLlmProviderFactory::getInfo()) leaves it @ref False.

        @since QoreLlmTypes 1.0
    */
    bool reasoning_always_on = False;
    #! True when the model rejects a forced tool choice
    /** A request that forces the model to call a tool (\c tool_choice \c "required", or a named function) fails:
        a caller that needs a tool call from such a model has to let it choose (\c tool_choice \c "auto"), say in
        the prompt which tool to call, and handle a response without a tool call.

        This is a property of a model, which @ref AbstractLlmProviderFactory::getModelInfo() reports; the information
        of the provider as a whole (@ref AbstractLlmProviderFactory::getInfo()) leaves it @ref False.

        @since QoreLlmTypes 1.0
    */
    bool rejects_forced_tool_choice = False;
    #! True when callers should avoid sending large unused tool catalogues
    /** Some providers use constrained decoding over the full tool/function
        declaration set; for those providers, a large stable catalogue can be
        rejected or can slow decoding even when only a few tools are relevant
        to the current turn.  Callers with a naturally ordered set of
        currently relevant tools should narrow to that set when this flag is
        @ref True. */
    bool prefers_narrow_tool_catalogue = False;
    #! Soft maximum number of tool definitions to send when narrowing
    /** \c 0 means no provider-specific soft cap is advertised.  When
        @ref prefers_narrow_tool_catalogue is @ref True, callers should use
        this as a target cap while preserving mandatory tools and local
        validation. */
    int preferred_max_tool_count = 0;
    #! True when callers should prefer one generic dispatch tool
    /** Some providers have trouble reliably producing one of many structured
        function calls even after the catalogue is narrowed.  Callers that
        can validate operation names and payloads locally should expose a
        single dispatch function with \c operation + payload fields when this
        flag is @ref True. */
    bool prefers_single_tool_dispatch = False;
    #! True when generic nested tool payloads should be encoded as JSON text
    /** Some providers can select the right tool but tend to emit empty
        objects for generic nested payload slots.  Callers that validate and
        decode locally should expose these free-form payload slots as JSON
        string fields when this flag is @ref True. */
    bool prefers_stringified_tool_payloads = False;
    #! True when the provider accepts a tool choice of type \c allowed_tools
    /** Such a choice restricts the tools one call may use while the call declares the same tools as other
        calls.  A provider caches the prefix of a request, and the declared tools are part of it: a caller
        whose calls each allow a different subset of one stable tool set keeps that prefix cached by
        declaring the whole set and allowing the subset, where declaring only the subset re-bills the whole
        request whenever the subset changes. */
    bool supports_allowed_tool_choice = False;
}

#! Abstract factory for an LLM provider
/** Concrete factories register themselves with
    @ref QoreLlmUtils::LlmProviderRegistry::registerFactory "LlmProviderRegistry::registerFactory" and the backend dispatches calls
    through them.  Factories are looked up by mode string and the heavy
    provider object is constructed lazily on demand via @ref create().

    @par Subclassing contract
    Concrete subclasses implement @ref getMode(), @ref getDisplayName(),
    @ref create(), and optionally @ref getInfo() to advertise capabilities.
*/
public class AbstractLlmProviderFactory {
    #! Returns the mode string associated with this factory
    /** For example, the Gemini factory returns \c "gemini"; the OpenAI-
        compatible factory returns \c "http".  The mode is matched against
        @ref LlmBackendConfig::mode at @ref QoreLlmUtils::LlmBackend "LlmBackend" construction.
    */
    abstract string getMode();

    #! Returns a human-readable display name
    abstract string getDisplayName();

    #! Creates a provider instance from the given backend configuration
    /** @param config the @ref LlmBackendConfig hash; the factory uses the
            relevant fields (URL, API key, retry settings, etc.) to build
            a fully initialized provider

        @return a concrete @ref AbstractLlmProvider that can service
            \c complete() / \c chat() / \c chatStream() calls
    */
    abstract AbstractLlmProvider create(hash<LlmBackendConfig> config);

    #! Returns static information about the provider this factory creates
    /** Default implementation returns the bare minimum
        (@ref LlmProviderInfo::mode and @ref LlmProviderInfo::display_name);
        concrete factories override to advertise streaming, tool, schema,
        and multimodal support.
    */
    hash<LlmProviderInfo> getInfo() {
        return <LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
        };
    }

    #! Returns information about the provider for a given model
    /** Some capabilities depend on the model that calls are made with, such as
        @ref LlmProviderInfo::reasoning_always_on and @ref LlmProviderInfo::rejects_forced_tool_choice; concrete
        factories override this method to set them.  The default
        implementation returns @ref getInfo(), the information of the provider as a whole.

        @param model the model ID or resource name that calls are made with

        @return the provider's information for the model

        @par Example
        @code{.py}
hash<LlmProviderInfo> info = LlmProviderRegistry::getFactory("vertex-ai").getModelInfo("gemini-3.7-flash");
if (info.reasoning_always_on) {
    # leave room for reasoning tokens in the output budget of a call with reasoning_token_budget = 0
}
        @endcode

        @since QoreLlmTypes 1.0
    */
    hash<LlmProviderInfo> getModelInfo(string model) {
        return getInfo();
    }
}

#! Registry of LLM provider factories keyed by mode string
/** Mirrors the FactoryMap pattern from
    @ref DataProvider::DataProvider::registerFactory "DataProvider::DataProvider::registerFactory".  Modes whose
    factory ships with a separate REST client module (e.g. \c "gemini" with
    @ref geminirestclientintro "GeminiRestClient") are listed in @ref ProviderModuleMap so the
    registry can lazy-load the providing module on demand.  Modes whose
    factory ships with @ref qorellmutilsintro "QoreLlmUtils" itself (e.g. \c "callback") are
    registered when @ref qorellmutilsintro "QoreLlmUtils"' \c init block runs.

    The registry is intentionally a separate class in @ref qorellmtypesintro "QoreLlmTypes" so
    LLM provider modules can register their factories without depending on
    @ref qorellmutilsintro "QoreLlmUtils" — which would form a module dependency cycle.
*/
public class LlmProviderRegistry {
    public {
        #! Map of mode names to the module that supplies the matching provider
        const ProviderModuleMap = {
            "http":          "OpenAiRestClient",
            "anthropic":     "AnthropicRestClient",
            "sglang":        "SGLangRestClient",
            "gemini":        "GeminiRestClient",
            "grok":          "GrokRestClient",
            "perplexity":    "PerplexityRestClient",
            "azure-openai":  "AzureOpenAiRestClient",
            "bedrock":       "BedrockRestClient",
            "vertex-ai":     "VertexAiRestClient",
            "deepseek":      "DeepSeekRestClient",
            "groq":          "GroqRestClient",
            "together":      "TogetherRestClient",
            "fireworks":     "FireworksRestClient",
            "ollama":        "OllamaRestClient",
            "cohere":        "CohereRestClient",
            "mistral":       "MistralRestClient",
        };
    }

    private:internal {
        # private:internal: the registry is process-wide, so that only this class changes it (qore#6744)
        #! Provider factories registered by mode string
        static hash<string, AbstractLlmProviderFactory> factory_cache = {};
        #! Tracks the module that registered each factory (by class name)
        static hash<string, string> factory_module_map = {};
    }

    private:internal {
        #! Serializes access to the factory cache
        static Mutex factory_cache_lock();
    }

    #! Registers a provider factory under its mode string
    /** Concrete factory classes call this from their owning module's \c init
        block.  Subsequent @ref QoreLlmUtils::LlmBackend "LlmBackend" constructions with the matching
        @ref LlmBackendConfig::mode dispatch through the registered factory.

        @param factory the new provider factory

        @throw LLM-CONFIG-ERROR a factory for the same mode is already registered
        @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot change the
            registry, which is process-wide (see @ref sandbox_process_wide_registries)
    */
    static registerFactory(AbstractLlmProviderFactory factory) [dom=PROCESS_CONTROL] {
        # the registry is process-wide: sandboxed code cannot change it (qore#6744)
        SandboxManager::checkProcessWideRegistration("change the LLM provider factory registry");
        factory_cache_lock.lock();
        on_exit factory_cache_lock.unlock();

        string mode = factory.getMode();
        if (factory_cache{mode}) {
            throw "LLM-CONFIG-ERROR",
                sprintf("LLM provider factory for mode %y has already been "
                    "registered", mode);
        }
        *string module_name = Class::getClass(factory).getModuleName();
        if (exists module_name) {
            factory_module_map{Class::getClass(factory).getName()} = module_name;
        }
        factory_cache{mode} = factory;
    }

    #! Removes a previously registered provider factory
    /** Intended primarily for tests that register a fake provider; safe to
        call when no factory is registered for the given mode (no-op).

        @param mode the mode string previously registered via @ref registerFactory()

        @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot change the
            registry, which is process-wide (see @ref sandbox_process_wide_registries)
    */
    static deregisterFactory(string mode) [dom=PROCESS_CONTROL] {
        # the registry is process-wide: sandboxed code cannot change it (qore#6744)
        SandboxManager::checkProcessWideRegistration("change the LLM provider factory registry");
        factory_cache_lock.lock();
        on_exit factory_cache_lock.unlock();

        *AbstractLlmProviderFactory factory = remove factory_cache{mode};
        if (!factory) {
            return;
        }
        try {
            remove factory_module_map{Class::getClass(factory).getName()};
        } catch (hash<ExceptionInfo> ex) {
            # Class metadata may be unavailable during program teardown
            if (ex.err != "PROGRAM-ERROR") {
                rethrow;
            }
        }
    }

    #! Returns the factory for the given mode, lazy-loading its module if needed
    /** When no factory is registered for \a mode, this consults
        @ref ProviderModuleMap and attempts to load the named module.  The
        module's \c init block is expected to call @ref registerFactory()
        for the corresponding mode.

        @param mode the @ref LlmBackendConfig::mode value to resolve

        @return the registered factory, or @ref nothing if the mode is
        unknown and no module can be loaded for it
    */
    static *AbstractLlmProviderFactory getFactory(string mode) {
        if (factory_cache{mode}) {
            return factory_cache{mode};
        }
        *string module_name = ProviderModuleMap{mode};
        if (!module_name) {
            return NOTHING;
        }
        try {
            load_module(module_name);
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-CONFIG-ERROR",
                sprintf("cannot load provider module %y for mode %y: %s",
                    module_name, mode, ex.desc), ex;
        }
        return factory_cache{mode};
    }

    #! Returns the factory for the given mode or throws an exception
    /** @param mode the @ref LlmBackendConfig::mode value to resolve

        @return the registered factory

        @throw LLM-CONFIG-ERROR the mode is unknown; the message lists the
        currently registered modes and the @ref ProviderModuleMap keys
    */
    static AbstractLlmProviderFactory getFactoryEx(string mode) {
        *AbstractLlmProviderFactory factory = LlmProviderRegistry::getFactory(mode);
        if (!factory) {
            throw "LLM-CONFIG-ERROR",
                sprintf("LLM provider mode %y is unknown; registered modes: "
                    "%y; modes available via lazy module load: %y",
                    mode, keys factory_cache, keys ProviderModuleMap);
        }
        return factory;
    }

    #! Returns the list of currently-registered mode strings
    /** @return the modes whose factories are present in the cache; modes
        that are known via @ref ProviderModuleMap but whose modules have
        not yet been lazy-loaded are not included
    */
    static list<string> knownProviderModes() {
        return keys factory_cache;
    }
}

#! Abstract base class for LLM providers
/** Concrete subclasses translate the provider-neutral
    @ref QoreLlmUtils::LlmBackend "LlmBackend" interface (\c complete, \c chat, \c chatStream) into a
    specific wire protocol (OpenAI chat completions, Anthropic Messages,
    Google Gemini generateContent, etc.).

    @par Provider responsibilities
    - Build provider-native request bodies from @ref ChatMessage and
      @ref ToolDefinition lists
    - Dispatch the request over the appropriate transport
    - Translate provider-native responses back into @ref ChatResponse /
      @ref LlmCompletionResult / @ref ChatStreamEvent shapes
    - Manage any provider-specific connection or REST client lifecycle

    @par Provider-neutral helpers
    Subclasses inherit @ref withRetry() (retry-on-transient-errors loop),
    @ref getRequestModel() / @ref getRequestMaxOutputTokens() /
    @ref getRequestReasoningTokenBudget() /
    @ref getRequestTemperature() (per-call override resolution), and
    @ref mergeRequestBodyOptions() (provider-specific body-options merge).

    @par OpenAI-compatible facade hooks
    @ref QoreLlmUtils::LlmBackend::chatCompletions "chatCompletions" and
    @ref QoreLlmUtils::LlmBackend::chatCompletionsStream "chatCompletionsStream" expose an OpenAI-shaped wire
    contract regardless of the underlying provider.  Providers that need to
    adapt OpenAI-shaped inputs (tool choice, response format) or interpret
    provider-native stream chunks override the \c applyOpenAi*() and
    \c updateOpenAiStreamStateFromRaw() / \c getOpenAiToolCallDeltas() hooks.
    Default implementations target the OpenAI wire shape directly.

    Thread-safe: implementations must allow concurrent calls.
*/
public class AbstractLlmProvider {
    private {
        #! The backend configuration passed at construction
        hash<LlmBackendConfig> config_h;
    }

    #! Stores the backend configuration for use by helpers
    /** Concrete subclasses call this from their own constructor (typically
        via <tt>:</tt> AbstractLlmProvider(config)) and then perform any
        provider-specific validation or REST client setup.
    */
    constructor(hash<LlmBackendConfig> config) {
        config_h = config;
    }

    #! Returns the mode string this provider services (e.g. \c "gemini")
    abstract string getMode();

    #! Returns the configured model name, or @ref nothing if none was set
    *string getModel() {
        return config_h.model;
    }

    #! Returns the underlying configuration hash
    hash<LlmBackendConfig> getConfig() {
        return config_h;
    }

    #! Makes a single-turn completion call
    /** @param system_prompt the system prompt
        @param user_prompt the user prompt
        @param output_schema optional JSON schema for structured output
        @param opts per-call request overrides

        @return a @ref LlmCompletionResult with the generated content and usage
    */
    abstract hash<LlmCompletionResult> complete(string system_prompt,
            string user_prompt, *hash<auto> output_schema,
            *hash<LlmRequestOptions> opts);

    #! Makes a multi-turn chat call with optional tool calling
    /** @param messages conversation history including system, user,
            assistant and tool messages
        @param tools optional tool definitions the LLM may call
        @param opts per-call request overrides

        @return a @ref ChatResponse describing the model's response
    */
    abstract hash<ChatResponse> chat(list<hash<ChatMessage>> messages,
            *list<hash<ToolDefinition>> tools,
            *hash<LlmRequestOptions> opts);

    #! Streams a chat completion via Server-Sent Events
    /** Default implementation throws \c LLM-ERROR; concrete providers
        override this when the underlying API supports streaming.

        Implementations deliver each provider-native event at most once (see
        @ref ChatStreamEvent), end with exactly one event with \c done set, and
        raise \c LLM-ERROR when the request is rejected, the stream reports an
        error, or no event arrives within the request timeout; a failure is
        never reported as a completed response.

        When @ref LlmRequestOptions::cancellation is cancelled, implementations
        close the connection of the stream at once, including while its
        response is awaited, and raise \c LLM-CANCELLED; see
        @ref addRequestCancelHandler() and @ref callCancellable(). Use @ref deliverStreamEvent() for every
        callback, including buffered output and the final event, so cancellation during delivery is reported
        before returning success or delivering another event.

        @param messages conversation history
        @param callback receives each @ref ChatStreamEvent as it arrives
        @param tools optional tool definitions
        @param opts per-call overrides

        @throw LLM-ERROR streaming is not supported by this provider
        @throw LLM-CANCELLED the request was cancelled
    */
    chatStream(list<hash<ChatMessage>> messages,
            code<nothing(hash<ChatStreamEvent>)> callback,
            *list<hash<ToolDefinition>> tools,
            *hash<LlmRequestOptions> opts) {
        throw "LLM-ERROR",
            sprintf("streaming is not supported by the %y provider; use "
                "chat() instead", getMode());
    }

    #! Returns the provider's default chat model, or @ref nothing if it has none
    /** Providers that have a sensible default model override this; the value is
        used by @ref getRequestModel() when neither the per-call options nor the
        backend config supply one, so a chat request always carries a model.

        Subclasses may narrow the return type to \c string when the provider
        always has a default.
    */
    *string getDefaultModel() {
        return NOTHING;
    }

    #! Resolves the model name for a single call
    /** per-call override > config default > @ref getDefaultModel() */
    *string getRequestModel(*hash<LlmRequestOptions> opts) {
        return opts.model ?? config_h.model ?? getDefaultModel();
    }

    #! Resolves the provider-neutral output/completion budget for a single call
    int getRequestMaxOutputTokens(*hash<LlmRequestOptions> opts) {
        return opts.max_output_tokens ?? opts.max_tokens
            ?? config_h.max_output_tokens ?? config_h.max_tokens;
    }

    #! Resolves the max-token budget for a single call
    /** Compatibility helper for existing providers and callers.  New provider
        code should call @ref getRequestMaxOutputTokens() for clarity. */
    int getRequestMaxTokens(*hash<LlmRequestOptions> opts) {
        return getRequestMaxOutputTokens(opts);
    }

    #! Reads the arguments of a tool call that a provider returned, as JSON text or as a hash
    /** Arguments given as text that is not a JSON object are returned in the \c _raw key, so the call and the
        response that has it stay visible, as the arguments of a streamed call are: a model can write broken JSON in
        its arguments, and raising the parse error lost a response that was paid for, with its usage.

        @param arguments the arguments of the call

        @return the arguments as a hash; @ref NOTHING if there are none

        @since QoreLlmTypes 1.0
    */
    static *hash<auto> parseToolCallArguments(auto arguments) {
        switch (arguments.typeCode()) {
            case NT_HASH:
                return arguments;
            case NT_STRING:
                break;
            default:
                return;
        }
        string text = arguments;
        if (!text.val()) {
            return;
        }
        try {
            auto value = parse_json(text);
            if (value.typeCode() == NT_HASH) {
                return value;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "JSON-PARSE-ERROR") {
                rethrow;
            }
        }
        return {"_raw": text};
    }

    #! Resolves the provider-neutral hidden-reasoning budget for a single call
    *int getRequestReasoningTokenBudget(*hash<LlmRequestOptions> opts) {
        return opts.reasoning_token_budget
            ?? config_h.reasoning_token_budget;
    }

    #! Resolves the provider-neutral hidden-reasoning effort for a single call
    *string getRequestReasoningEffort(*hash<LlmRequestOptions> opts) {
        return opts.reasoning_effort ?? config_h.reasoning_effort;
    }

    #! Resolves whether hidden reasoning should be disabled for a single call
    /** @return @ref True to disable, @ref False to force it on where the
        provider supports that, or @ref NOTHING when the caller expressed no
        preference and the model's own default should apply */
    *bool getRequestDisableReasoning(*hash<LlmRequestOptions> opts) {
        return exists opts.disable_reasoning
            ? opts.disable_reasoning
            : config_h.disable_reasoning;
    }

    #! Resolves whether the caller asks to turn hidden reasoning off for a single call
    /** The caller asks to turn reasoning off with @ref LlmRequestOptions::disable_reasoning, which wins over a
        @ref LlmRequestOptions::reasoning_effort "reasoning_effort", or with a
        @ref LlmRequestOptions::reasoning_token_budget "reasoning_token_budget" of zero and no reasoning effort.

        Providers turn reasoning off where the model can, and select the model's lowest reasoning setting where it
        cannot (@ref LlmProviderInfo::reasoning_always_on); for models whose reasoning controls have not been
        verified, they keep sending what they sent before.

        @param opts optional per-call request overrides

        @return @ref True if the caller asks to turn reasoning off

        @since QoreLlmTypes 1.0
    */
    bool getRequestReasoningOff(*hash<LlmRequestOptions> opts) {
        if (getRequestDisableReasoning(opts)) {
            return True;
        }
        if (getRequestReasoningEffort(opts).val()) {
            return False;
        }
        *int budget = getRequestReasoningTokenBudget(opts);
        return exists budget && budget == 0;
    }

    #! Resolves the sampling temperature for a single call
    float getRequestTemperature(*hash<LlmRequestOptions> opts) {
        return opts.temperature ?? config_h.temperature;
    }

    #! Resolves the HTTP request timeout for a single call
    /** @param opts optional per-call request overrides

        @return per-call timeout in milliseconds when supplied, otherwise the
            backend configuration default; with a @ref LlmRequestOptions::deadline, at most the time left before it

        @throw HTTPCLIENT-TIMEOUT the call's @ref LlmRequestOptions::deadline has passed
    */
    int getRequestTimeoutMs(*hash<LlmRequestOptions> opts) {
        int timeout_ms = opts.timeout_ms ?? config_h.timeout_ms;
        if (opts.deadline) {
            int remaining_ms = (opts.deadline - now_us()).durationMilliseconds();
            if (remaining_ms <= 0) {
                throw "HTTPCLIENT-TIMEOUT", "LLM call deadline exhausted";
            }
            if (remaining_ms < timeout_ms) {
                timeout_ms = remaining_ms;
            }
        }
        return timeout_ms;
    }

    #! Resolves the HTTP 429 retry budget for a single call
    /** @param opts optional per-call request overrides

        @return @ref LlmRequestOptions::rate_limit_retries when supplied, otherwise the call's transient-error
            retry budget (@ref getRequestMaxRetries())
    */
    int getRequestRateLimitRetries(*hash<LlmRequestOptions> opts) {
        return opts.rate_limit_retries ?? getRequestMaxRetries(opts);
    }

    #! Resolves the transient-error retry budget for a single call
    /** @param opts optional per-call request overrides

        @return per-call retry count when supplied, otherwise the backend
            configuration default
    */
    int getRequestMaxRetries(*hash<LlmRequestOptions> opts) {
        return opts.max_retries ?? config_h.max_retries;
    }

    #! Raises \c LLM-CANCELLED if the cancellation token of a call has been cancelled
    /** @param opts optional per-call request overrides

        @throw LLM-CANCELLED @ref LlmRequestOptions::cancellation has been cancelled
    */
    checkRequestCancelled(*hash<LlmRequestOptions> opts) {
        if (opts.cancellation) {
            opts.cancellation.check();
        }
    }

    #! Delivers one stream event while honoring request cancellation
    /** Checks the token before and after the callback. The second check covers cancellation in the final
        callback, and buffered or fallback output that is not followed by another cancellable transport read.

        @param callback receives the event in the calling thread
        @param event the event to deliver, including a final event with \c done set
        @param opts optional per-call request overrides

        @throw LLM-CANCELLED the token was cancelled before delivery or before the callback returned
        @throw any exception raised by the callback is propagated unchanged

        @par Example
        @code{.py}
deliverStreamEvent(callback, <ChatStreamEvent>{"delta": "Invoice processed"}, opts);
deliverStreamEvent(callback, <ChatStreamEvent>{"done": True}, opts);
        @endcode
    */
    deliverStreamEvent(code<nothing(hash<ChatStreamEvent>)> callback, hash<ChatStreamEvent> event,
            *hash<LlmRequestOptions> opts) {
        checkRequestCancelled(opts);
        callback(event);
        checkRequestCancelled(opts);
    }

    #! Registers a handler that runs when a call is cancelled
    /** Providers register a handler that closes the connection of a request in flight, so a cancellation stops
        the request at once.

        @param opts optional per-call request overrides
        @param handler the code to run when @ref LlmRequestOptions::cancellation is cancelled; it runs
        immediately if the token is already cancelled

        @return an ID for @ref removeRequestCancelHandler(), or 0 if there is no token or the handler has already
        run
    */
    int addRequestCancelHandler(*hash<LlmRequestOptions> opts, code<nothing()> handler) {
        return opts.cancellation ? opts.cancellation.addHandler(handler) : 0;
    }

    #! Returns a transport registration function for a request with a cancellation token
    /** The transport supplies its abort callback on submission and calls the returned cleanup on every exit. */
    private code<code<nothing()>(code<nothing()>)> getRequestCancelRegistration(*hash<LlmRequestOptions> opts) {
        LlmCancellation token = opts.cancellation;
        return code<nothing()> sub (code<nothing()> abort_request) {
            int id = token.addHandler(abort_request);
            return sub () { token.removeHandler(id); };
        };
    }

    #! Removes a handler registered with @ref addRequestCancelHandler()
    /** @param opts the per-call request overrides given to @ref addRequestCancelHandler()
        @param id the ID returned by @ref addRequestCancelHandler()
    */
    removeRequestCancelHandler(*hash<LlmRequestOptions> opts, int id) {
        if (id && opts.cancellation) {
            opts.cancellation.removeHandler(id);
        }
    }

    #! Runs a step of a call that its cancellation token can interrupt
    /** The step is not started if the call has already been cancelled.  A cancellation interrupts a running step
        by closing its connection, so the step then fails with a transport error or ends early; both are reported
        as \c LLM-CANCELLED instead.

        @param call the step to run
        @param opts optional per-call request overrides

        @return the value returned by \a call

        @throw LLM-CANCELLED @ref LlmRequestOptions::cancellation was cancelled before the step ended
    */
    auto callCancellable(code call, *hash<LlmRequestOptions> opts) {
        if (!opts.cancellation) {
            return call();
        }
        # a cancelled call does not start the step
        opts.cancellation.check();
        auto rv;
        try {
            rv = call();
        } catch (hash<ExceptionInfo> ex) {
            opts.cancellation.check();
            rethrow;
        }
        opts.cancellation.check();
        return rv;
    }

    #! Merges provider-specific body options after generic fields
    /** Default semantics: keys in \a opts.body_options overwrite top-level
        keys in \a body verbatim.  Providers that need recursive / nested
        merge semantics (e.g. Gemini \c generationConfig) override this.
    */
    hash<auto> mergeRequestBodyOptions(hash<auto> body,
            *hash<LlmRequestOptions> opts) {
        if (!opts.body_options) {
            return body;
        }
        hash<auto!> rv;
        rv += body;
        foreach string key in (keys opts.body_options) {
            rv{key} = opts.body_options{key};
        }
        return rv;
    }

    #! Retries the given call with exponential backoff on transient errors
    /** Retries on HTTP 429 (rate limit) and 5xx (server error) responses: a 429 up to
        @ref LlmRequestOptions::rate_limit_retries, any other up to @ref LlmRequestOptions::max_retries (each when
        supplied, otherwise @ref LlmBackendConfig::max_retries). Initial delay is @ref LlmBackendConfig::retry_delay_ms
        and doubles on each attempt; a @c Retry-After the response gives is taken instead.

        No wait is made, and the error is raised at once so that the caller can fail over, when the wait would not
        end before the call's @ref LlmRequestOptions::deadline, or when a @c Retry-After asks for longer than the
        request timeout (@ref LlmRequestOptions::timeout_ms or @ref LlmBackendConfig::timeout_ms).

        Every attempt is recorded: @c attempts (the requests made), @c waits_ms (each wait taken), @c failures (for
        each failed request its @c status, the provider's @c provider_code, whether the provider gave a
        @c quota_detail and the @c retry_after_ms it asked for) and, for a call that ends with an error, @c stopped:
        why no further request was made (@c not_retryable, @c retries_spent, @c deadline or
        @c retry_after_too_long).  \a retry_info receives the record whether the call succeeds or fails, and the
        error a call ends with carries it as @c retry in its argument when the argument is a hash.

        When @ref LlmRequestOptions::cancellation is set, the call is not made
        once the token is cancelled, a backoff wait ends as soon as it is
        cancelled, and an error or result of a call interrupted by the
        cancellation is reported as \c LLM-CANCELLED.

        @param call a callable that performs the request and returns the response
        @param opts optional per-call request overrides
        @param retry_info receives the record of the call's attempts

        @return the response from the successful call

        @throw LLM-CANCELLED @ref LlmRequestOptions::cancellation was cancelled
        @throw any non-retryable exception is rethrown; a retryable exception
        is rethrown after retries are exhausted, with its record as @c retry in its argument

        @par Example
        A Vertex AI call answered with HTTP 429 three times and then 200 returns the response, and \a retry_info
        holds @c attempts 4, the three waits taken and the three failures, each with its @c provider_code
        (@c RESOURCE_EXHAUSTED).
    */
    auto withRetry(code call, *hash<LlmRequestOptions> opts = NOTHING, *reference<hash<auto>> retry_info) {
        hash<auto> state = newRetryState(opts);
        while (True) {
            ++state.record.attempts;
            try {
                auto rv = callCancellable(call, opts);
                retry_info = state.record;
                return rv;
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "LLM-CANCELLED") {
                    retry_info = state.record;
                    rethrow;
                }
                *int delay = nextRetryDelay(\state, ex, opts);
                if (!exists delay) {
                    retry_info = state.record;
                    if (ex.arg.typeCode() == NT_HASH) {
                        throw ex.err, ex.desc, ex.arg + {"retry": state.record};
                    }
                    rethrow;
                }
                if (opts.cancellation) {
                    # a cancellation ends the wait at once
                    if (opts.cancellation.waitCancelled(delay)) {
                        retry_info = state.record;
                        opts.cancellation.check();
                    }
                } else {
                    usleep(delay * 1000);
                }
            }
        }
    }

    #! Returns the state of the retry policy of @ref withRetry() for a new call
    /** The state is updated by @ref nextRetryDelay() after each failed request; its \c record key holds the record
        of the call's attempts described for @ref withRetry(), whose \c attempts count the caller increments before
        each request.

        @param opts optional per-call request overrides

        @return the retry state of a call that has made no request yet

        @see @ref startWithRetryAsync(), which applies the same policy to an asynchronous call
    */
    hash<auto> newRetryState(*hash<LlmRequestOptions> opts) {
        return {
            "attempt": 0,
            "max_retries": getRequestMaxRetries(opts),
            "rate_limit_retries": getRequestRateLimitRetries(opts),
            "request_timeout_ms": opts.timeout_ms ?? config_h.timeout_ms,
            "record": {"attempts": 0, "waits_ms": (), "failures": ()},
        };
    }

    #! Applies the retry policy of @ref withRetry() to a failed request
    /** Records the failure in \c state.record and decides whether the request is retried.

        @param state the retry state from @ref newRetryState(), updated in place
        @param ex the error of the failed request
        @param opts the per-call request overrides given to @ref newRetryState()

        @return the time to wait in milliseconds before the next request, or @ref nothing if no further request is
        made, in which case \c state.record.stopped gives the reason
    */
    *int nextRetryDelay(reference<hash<auto>> state, hash<ExceptionInfo> ex, *hash<LlmRequestOptions> opts) {
        hash<auto> failure = getRetryFailureEvidence(ex);
        state.record.failures += failure;
        int status = failure.status ?? 0;
        *string stopped;
        if (status != 429 && status < 500) {
            stopped = "not_retryable";
        } else if (state.attempt >= (status == 429 ? state.rate_limit_retries : state.max_retries)) {
            stopped = "retries_spent";
        }
        int delay;
        if (!stopped) {
            delay = exists failure.retry_after_ms
                ? failure.retry_after_ms
                : config_h.retry_delay_ms * (1 << state.attempt);
            if (exists failure.retry_after_ms && failure.retry_after_ms > state.request_timeout_ms) {
                stopped = "retry_after_too_long";
            } else if (opts.deadline && now_us() + milliseconds(delay) >= opts.deadline) {
                stopped = "deadline";
            }
        }
        if (stopped) {
            state.record.stopped = stopped;
            return NOTHING;
        }
        ++state.attempt;
        state.record.waits_ms += delay;
        return delay;
    }

    #! Returns the evidence of a failed request that @ref withRetry() records
    /** @param ex the request's error

        @return @c status (the HTTP status, if the error has one), @c provider_code (the provider's own error code:
        a Google @c error.status such as @c RESOURCE_EXHAUSTED, else an @c error.code or @c error.type string),
        @c quota_detail (True when the provider's error details include a @c QuotaFailure) and @c retry_after_ms
        (a positive @c Retry-After in seconds, as milliseconds); each only when present
    */
    static hash<auto> getRetryFailureEvidence(hash<ExceptionInfo> ex) {
        hash<auto> rv = {};
        if (ex.arg.typeCode() != NT_HASH) {
            return rv;
        }
        if (exists ex.arg.status_code) {
            rv.status = ex.arg.status_code.toInt();
        }
        auto body = ex.arg.body;
        if (body.typeCode() == NT_LIST && body[0].typeCode() == NT_HASH) {
            body = body[0];
        }
        if (body.typeCode() == NT_HASH && body.error.typeCode() == NT_HASH) {
            hash<auto> error = body.error;
            if (error.status.typeCode() == NT_STRING && error.status.val()) {
                rv.provider_code = error.status;
            } else if (error.code.typeCode() == NT_STRING && error.code.val()) {
                rv.provider_code = error.code;
            } else if (error.type.typeCode() == NT_STRING && error.type.val()) {
                rv.provider_code = error.type;
            }
            if (error.details.typeCode() == NT_LIST) {
                foreach auto detail in (error.details) {
                    if (detail.typeCode() == NT_HASH && detail."@type".typeCode() == NT_STRING
                            && detail."@type" =~ /QuotaFailure$/) {
                        rv.quota_detail = True;
                        break;
                    }
                }
            }
        }
        if (ex.arg.headers.typeCode() == NT_HASH && ex.arg.headers."retry-after".val()) {
            int retry_after = ex.arg.headers."retry-after".toInt();
            if (retry_after > 0) {
                rv.retry_after_ms = retry_after * 1000;
            }
        }
        return rv;
    }

    #! Returns @ref True if the provider makes asynchronous chat calls without holding a thread
    /** Providers that override @ref startChatAsync() and @ref startChatStreamAsync() with an asynchronous transport
        return @ref True.  The asynchronous API (@ref chatAsync() and @ref chatStreamAsync()) works with every
        provider: one that returns @ref False runs its synchronous @ref chat() or @ref chatStream() in a thread of the
        call's executor, which it then holds while it waits for the provider.

        @return @ref False in the base class
    */
    bool supportsAsyncChat() {
        return False;
    }

    #! Starts a multi-turn chat call that holds no thread while it waits for the provider
    /** The request is the request of @ref chat(), with the same retry policy, errors, cancellation and result: its
        steps run in threads of the executor given in \a async_opts, and the result is available from the returned
        operation when it is done.

        @param messages conversation history including system, user, assistant and tool messages
        @param tools optional tool definitions the LLM may call
        @param opts per-call request overrides; when @ref LlmRequestOptions::cancellation is not given, the
        operation creates a token of its own, so that @ref LlmAsyncOperation::cancel() can stop the call
        @param async_opts the executor of the call and its optional completion callback

        @return the operation of the call; its result is a @ref ChatResponse

        @par Example
        @code{.py}
LlmThreadPoolExecutor executor(2);
LlmAsyncOperation op = provider.chatAsync(messages, NOTHING, NOTHING, <LlmAsyncCallOptions>{
    "executor": executor,
    "on_complete": sub (LlmAsyncOperation op) {
        if (!op.isError()) {
            hash<ChatResponse> response = op.getResult();
        }
    },
});
        @endcode
    */
    LlmAsyncOperation chatAsync(list<hash<ChatMessage>> messages, *list<hash<ToolDefinition>> tools,
            *hash<LlmRequestOptions> opts, hash<LlmAsyncCallOptions> async_opts) {
        hash<LlmRequestOptions> call_opts = opts ?? <LlmRequestOptions>{};
        LlmAsyncOperation op = LlmAsyncOperation::forCall(\call_opts, async_opts);
        op.post(sub () {
            startChatAsync(op, messages, tools, call_opts, sub (hash<ChatResponse> response) {
                op.complete(response);
            }, sub (hash<ExceptionInfo> ex) {
                op.fail(ex);
            });
        });
        return op;
    }

    #! Starts a streamed chat call that holds no thread while it waits for the provider
    /** The request is the request of @ref chatStream(), with the same events, errors and cancellation: \a callback
        receives each event in order, in a thread of the executor given in \a async_opts, and never two at once.  The
        operation is done after the final event (the one with \c done set) or when the call fails; its result is
        @ref nothing.

        @param messages conversation history
        @param callback receives each @ref ChatStreamEvent; an exception it raises stops the call, which then fails
        with that exception, as it does in @ref chatStream()
        @param tools optional tool definitions
        @param opts per-call overrides; when @ref LlmRequestOptions::cancellation is not given, the operation creates
        a token of its own
        @param async_opts the executor of the call and its optional completion callback

        @return the operation of the call
    */
    LlmAsyncOperation chatStreamAsync(list<hash<ChatMessage>> messages,
            code<nothing(hash<ChatStreamEvent>)> callback, *list<hash<ToolDefinition>> tools,
            *hash<LlmRequestOptions> opts, hash<LlmAsyncCallOptions> async_opts) {
        hash<LlmRequestOptions> call_opts = opts ?? <LlmRequestOptions>{};
        LlmAsyncOperation op = LlmAsyncOperation::forCall(\call_opts, async_opts);
        op.post(sub () {
            startChatStreamAsync(op, messages, callback, tools, call_opts, sub () {
                op.complete();
            }, sub (hash<ExceptionInfo> ex) {
                op.fail(ex);
            });
        });
        return op;
    }

    #! Starts the request of @ref chat() as a step of an asynchronous operation
    /** Called in a task of \a op (see @ref LlmAsyncOperation::post()); exactly one of \a on_response and
        \a error_cb is called later, in a task of \a op, also for an error raised before the request is sent.

        Providers with an asynchronous transport override this method and @ref supportsAsyncChat(); the default
        runs @ref chat() in the calling task, so it holds a thread of the executor while it waits.

        @param op the operation the request is a step of
        @param messages conversation history
        @param tools optional tool definitions
        @param opts per-call request overrides
        @param on_response receives the response
        @param error_cb receives the error of the request, as @ref chat() would raise it
    */
    startChatAsync(LlmAsyncOperation op, list<hash<ChatMessage>> messages, *list<hash<ToolDefinition>> tools,
            hash<LlmRequestOptions> opts, code<nothing(hash<ChatResponse>)> on_response,
            code<nothing(hash<ExceptionInfo>)> error_cb) {
        hash<ChatResponse> response;
        try {
            response = chat(messages, tools, opts);
        } catch (hash<ExceptionInfo> ex) {
            error_cb(ex);
            return;
        }
        on_response(response);
    }

    #! Starts the request of @ref chatStream() as a step of an asynchronous operation
    /** Called in a task of \a op (see @ref LlmAsyncOperation::post()); \a callback receives each event in a task of
        \a op, and exactly one of \a on_end and \a error_cb is called later, in a task of \a op.

        Providers with an asynchronous transport override this method and @ref supportsAsyncChat(); the default
        runs @ref chatStream() in the calling task, so it holds a thread of the executor while it waits.

        @param op the operation the request is a step of
        @param messages conversation history
        @param callback receives each event
        @param tools optional tool definitions
        @param opts per-call request overrides
        @param on_end called after the final event
        @param error_cb receives the error of the request, as @ref chatStream() would raise it
    */
    startChatStreamAsync(LlmAsyncOperation op, list<hash<ChatMessage>> messages,
            code<nothing(hash<ChatStreamEvent>)> callback, *list<hash<ToolDefinition>> tools,
            hash<LlmRequestOptions> opts, code<nothing()> on_end, code<nothing(hash<ExceptionInfo>)> error_cb) {
        try {
            chatStream(messages, callback, tools, opts);
        } catch (hash<ExceptionInfo> ex) {
            error_cb(ex);
            return;
        }
        on_end();
    }

    #! Returns the \c LLM-CANCELLED error of a call whose cancellation token has been cancelled
    /** @param opts optional per-call request overrides

        @return the error that @ref checkRequestCancelled() would raise, or @ref nothing if the call has not been
        cancelled
    */
    *hash<ExceptionInfo> getRequestCancelledError(*hash<LlmRequestOptions> opts) {
        if (!opts.cancellation || !opts.cancellation.isCancelled()) {
            return NOTHING;
        }
        try {
            opts.cancellation.check();
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        return NOTHING;
    }

    #! Sends a request asynchronously with the retry policy of @ref withRetry()
    /** Each attempt is made in a task of \a op; a failed attempt is retried as @ref withRetry() retries it, after a
        wait on a timer of the async I/O controller, which holds no thread.  A cancellation of the call's token aborts
        the attempt in flight or ends the wait at once, and the call then fails with \c LLM-CANCELLED; an attempt
        that ends after the token is cancelled also fails with \c LLM-CANCELLED, as with @ref callCancellable().

        Must be called in a task of \a op.

        @param op the operation the request is a step of
        @param opts per-call request overrides
        @param attempt called in a task of \a op for each attempt with the code that reports its end; it starts the
        request and returns the code that aborts it.  The request reports its end exactly once, in a task of
        \a op, with its error or with its value; an exception raised by \a attempt is the error of the attempt
        @param success_cb receives the value of the successful attempt, in a task of \a op
        @param error_cb receives the error of the call, in a task of \a op: the error of the last attempt, with the
        record of the call's attempts as \c retry in its argument when the argument is a hash, as with
        @ref withRetry(), or \c LLM-CANCELLED
    */
    startWithRetryAsync(LlmAsyncOperation op, *hash<LlmRequestOptions> opts,
            code<code<nothing()>(code<nothing(*hash<ExceptionInfo>, auto)>)> attempt,
            code<nothing(auto)> success_cb, code<nothing(hash<ExceptionInfo>)> error_cb) {
        Priv::LlmAsyncRetry retry(self, op, opts, attempt, success_cb, error_cb);
        retry.start();
    }

    #! Sends a non-streamed request asynchronously with the retry policy of @ref withRetry()
    /** Like @ref startWithRetryAsync() for a request whose end is signaled by an
        @ref Qore::EventNotifier "EventNotifier": the notifier is watched by the async I/O controller, and the
        response is read in a task of \a op.

        Must be called in a task of \a op.

        @param op the operation the request is a step of
        @param opts per-call request overrides
        @param submit called in a task of \a op for each attempt with a new notifier; it submits the request, which
        signals the notifier when it ends, and returns its @ref LlmAsyncSubmission
        @param success_cb receives the response, in a task of \a op
        @param error_cb receives the error of the call, in a task of \a op

        @par Example
        @code{.py}
startRequestAsync(op, opts, hash<LlmAsyncSubmission> sub (EventNotifier notifier) {
    RestClientIo::RestFuture future = rest.restDoRequestAsyncTargetWithNotifier("POST", target, body, hdr,
        getRequestTimeoutMs(opts), notifier);
    return <LlmAsyncSubmission>{
        "cancel": sub () { future.cancel(); },
        "is_done": bool sub () { return future.isDone(); },
        "get": auto sub () { return future.get(); },
    };
}, sub (auto response) { ... }, sub (hash<ExceptionInfo> ex) { ... });
        @endcode
    */
    startRequestAsync(LlmAsyncOperation op, *hash<LlmRequestOptions> opts,
            code<hash<LlmAsyncSubmission>(EventNotifier)> submit, code<nothing(auto)> success_cb,
            code<nothing(hash<ExceptionInfo>)> error_cb) {
        startWithRetryAsync(op, opts, code<nothing()> sub (code<nothing(*hash<ExceptionInfo>, auto)> done) {
            EventNotifier notifier();
            hash<LlmAsyncSubmission> submission = submit(notifier);
            code<nothing()> cancel_request = submission.cancel;
            code<bool()> request_done = submission.is_done;
            code<auto()> get_result = submission.get;
            try {
                Priv::LlmAsyncNotifierWatch::watch(notifier, sub () {
                    op.post(sub () {
                        auto value;
                        try {
                            # the watch also ends when the controller cancels it; the request is then aborted, so
                            # that reading its result does not wait
                            if (!request_done()) {
                                cancel_request();
                            }
                            value = get_result();
                        } catch (hash<ExceptionInfo> ex) {
                            done(ex);
                            return;
                        }
                        done(NOTHING, value);
                    });
                });
            } catch (hash<ExceptionInfo> ex) {
                cancel_request();
                rethrow;
            }
            return cancel_request;
        }, success_cb, error_cb);
    }

    #! Returns an exception hash with the given values, as a @c throw statement creates it in the calling code
    /** Used by asynchronous calls to report the same errors as their synchronous counterparts raise.

        @param err the error code
        @param desc the description
        @param arg the argument

        @return the exception
    */
    static hash<ExceptionInfo> makeException(string err, string desc, auto arg) {
        try {
            throw err, desc, arg;
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
    }

    #! OpenAI-facade hook: adapts an OpenAI tool_choice to provider-native form
    /** Called by @ref QoreLlmUtils::LlmBackend::chatCompletions "chatCompletions" when translating an
        OpenAI-shaped request body for dispatch through this provider.
        The default writes the choice unchanged into
        \c body_options.tool_choice; providers with a different native
        encoding (e.g. Gemini \c toolConfig) override.

        @param body_options the hash being accumulated for
            @ref LlmRequestOptions::body_options
        @param choice the OpenAI \c tool_choice value (string or hash)
    */
    applyOpenAiToolChoice(reference<hash<auto!>> body_options, auto choice) {
        if (exists choice) {
            body_options.tool_choice = choice;
        }
    }

    #! OpenAI-facade hook for additional provider-specific request controls
    /** Providers with an OpenAI-compatible wire format override this hook.
        Other providers must translate supported controls explicitly instead
        of receiving arbitrary OpenAI fields.

        @param body_options provider-specific body options to update
        @param request the incoming OpenAI-compatible request
    */
    applyOpenAiRequestControls(reference<hash<auto!>> body_options,
            hash<auto> request) {
    }

    #! OpenAI-facade hook: routes an OpenAI response_format to provider-native form
    /** Called when an OpenAI-shaped request specifies
        \c response_format=\c json_schema.  The default copies
        \c response_format into \c body_options so the OpenAI-compatible
        provider sees it verbatim; providers that prefer a structured-output
        side channel (e.g. Gemini \c responseSchema in
        @ref LlmRequestOptions::output_schema) override.

        @param body_options the body-options hash being built
        @param options the @ref LlmRequestOptions hash being built
        @param output_schema the parsed JSON schema (already validated by caller)
        @param response_format the raw OpenAI \c response_format hash from the request
    */
    applyOpenAiResponseFormat(reference<hash<auto!>> body_options,
            reference<hash<LlmRequestOptions>> options,
            hash<auto> output_schema, *hash<auto> response_format) {
        if (response_format) {
            body_options.response_format = response_format;
        }
    }

    #! OpenAI-facade hook: updates OpenAI stream state from a provider-native raw event
    /** Called once per streaming event from @ref chatStream() to populate
        the OpenAI-compatible stream-state hash with id, model, usage and
        finish-reason fields.  Default reads OpenAI shape (\c id, \c model,
        \c usage, \c choices[0].finish_reason); providers with native event
        shapes (e.g. Gemini \c responseId, \c usageMetadata,
        \c candidates[0].finishReason) override.  Providers whose responses
        carry reasoning blocks that must be replayed collect them as a list in
        \c state.reasoning_blocks; the state can hold further provider-specific
        keys.

        @param state the OpenAI-compatible stream-state hash being accumulated
        @param raw the parsed provider-native event hash, or @ref nothing
    */
    updateOpenAiStreamStateFromRaw(reference<hash<auto>> state,
            *hash<auto> raw) {
        if (!raw) {
            return;
        }
        if (raw.id.val()) {
            state.id = raw.id;
        }
        if (raw.model.val()) {
            state.model = raw.model;
        }
        if (raw.usage.typeCode() == NT_HASH) {
            state.usage = raw.usage;
        }
        if (raw.choices[0].finish_reason.val()) {
            state.finish_reason = raw.choices[0].finish_reason;
        }
    }

    #! OpenAI-facade hook: extracts OpenAI tool-call deltas from a provider-native raw event
    /** Returns the list of OpenAI-shaped \c tool_calls deltas (index, id,
        type, function) that should be emitted to the caller for this event.
        The default implementation accumulates OpenAI-compatible progressive
        deltas from \c choices[0].delta.tool_calls into the final response
        state, including a string \c thought_signature (see
        @ref ChatToolCall::thought_signature) when a delta carries one, and
        returns the original deltas for streaming callers. Gemini
        overrides this hook to harvest
        \c candidates[0].content.parts[].functionCall entries.

        @param state the OpenAI-compatible stream-state hash being accumulated
        @param raw the parsed provider-native event hash, or @ref nothing
    */
    list<hash<auto>> getOpenAiToolCallDeltas(reference<hash<auto>> state,
            *hash<auto> raw) {
        if (!raw || raw.choices.typeCode() != NT_LIST || !raw.choices
                || raw.choices[0].typeCode() != NT_HASH) {
            return ();
        }
        hash<auto> choice = raw.choices[0];
        if (choice.delta.typeCode() != NT_HASH
                || choice.delta.tool_calls.typeCode() != NT_LIST) {
            return ();
        }
        if (state.tool_calls.typeCode() != NT_LIST) {
            state.tool_calls = ();
        }
        list<hash<auto>> streamed = ();
        foreach auto raw_delta in (choice.delta.tool_calls) {
            if (raw_delta.typeCode() != NT_HASH) {
                continue;
            }
            hash<auto> delta = cast<hash>(raw_delta);
            # Stream indexes are mandatory in the OpenAI protocol.  Reject
            # missing, negative, and sparse indexes: accepting a large sparse
            # index would let an untrusted provider force an unbounded list
            # allocation, while an omitted index cannot be correlated safely
            # with an existing progressive tool call.
            if (delta."index".typeCode() != NT_INT) {
                continue;
            }
            int index = delta."index";
            if (index < 0 || index > state.tool_calls.size()) {
                continue;
            }
            if (state.tool_calls.size() == index) {
                state.tool_calls += {
                    "id": NOTHING,
                    "type": "function",
                    "function": {"name": "", "arguments": ""},
                };
            }

            hash<auto!> tool_call;
            tool_call += cast<hash>(state.tool_calls[index]);
            hash<auto!> function;
            if (tool_call."function".typeCode() == NT_HASH) {
                function += cast<hash>(tool_call."function");
            }
            if (delta.id.typeCode() == NT_STRING && delta.id.val()) {
                tool_call.id = delta.id;
            }
            if (delta.type.typeCode() == NT_STRING && delta.type.val()) {
                tool_call.type = delta.type;
            }
            if (delta."function".typeCode() == NT_HASH) {
                hash<auto> function_delta = cast<hash>(delta."function");
                if (function_delta.name.typeCode() == NT_STRING) {
                    function.name = (function.name ?? "").toString()
                        + function_delta.name;
                }
                if (function_delta.arguments.typeCode() == NT_STRING) {
                    function.arguments =
                        (function.arguments ?? "").toString()
                        + function_delta.arguments;
                }
            }
            tool_call."function" = function;
            # a provider reasoning signature (see ChatToolCall::thought_signature) arrives whole on
            # the delta that carries it; it must reach the final response or the replayed call is
            # rejected
            if (delta.thought_signature.typeCode() == NT_STRING && delta.thought_signature.val()) {
                tool_call.thought_signature = delta.thought_signature;
            }
            state.tool_calls[index] = tool_call;
            streamed += delta;
        }
        return streamed;
    }
}

#! Runs the steps and callbacks of asynchronous LLM calls
/** An asynchronous call (see @ref AbstractLlmProvider::chatAsync() and
    @ref QoreLlmUtils::LlmBackend::chatCompletionsAsync() "LlmBackend::chatCompletionsAsync()") holds no thread while
    it waits for the provider: the request waits in the async I/O controller, and a retry waits on a timer of the
    controller.  Every step that runs %Qore code between the waits (preparing the credentials and the body of the next
    request, reading a response, delivering a stream event, the caller's callbacks) is handed to the executor given
    with the call, so the threads that run the calls are the threads of the caller's own pool.

    An implementation runs each task later, in a thread of its own, and never in the thread that calls
    @ref execute(): tasks are handed over from the threads of the async I/O controller, which must not run them.
    Tasks may run in any order and in several threads at once: each operation runs its own tasks one at a time and in
    the order they were handed over.

    An operation calls @ref execute() with the context (sandbox restrictions and provenance) of the code that created
    the operation, whatever code posts its tasks, so that the tasks of a call run with the context of its caller.  An
    implementation that is shared by code of different contexts must run each task with at least the restrictions of
    the code that calls @ref execute(), as @ref Qore::Thread::ThreadPool::submit() "ThreadPool::submit()" and
    @ref LlmThreadPoolExecutor do (qore#7497).

    @par Example
    @code{.py}
# runs the tasks on an application's own worker pool
class MyExecutor inherits LlmAsyncExecutor {
    private { MyWorkerPool pool; }
    constructor(MyWorkerPool pool) { self.pool = pool; }
    execute(code<nothing()> task) { pool.submit(task); }
}
    @endcode

    @see @ref LlmThreadPoolExecutor, a simple implementation
*/
public class LlmAsyncExecutor {
    #! Runs a task later in a thread of the executor
    /** @param task the task to run; tasks handed over by an operation handle their own errors

        @throw any exception: the task is then not run, and the operation that handed it over fails with this
        exception
    */
    abstract execute(code<nothing()> task);
}

#! A simple @ref LlmAsyncExecutor with a fixed number of worker threads
/** The tasks run in the order they are handed over, each in the first free worker.  The workers are threads of the
    code that creates the executor, which count against the thread limit of its sandbox; each task also runs with the
    sandbox of the code that hands it over (see @ref Qore::SandboxManager::bindCall() "SandboxManager::bindCall()"),
    so that a task handed over by sandboxed code keeps that sandbox's restrictions.  An exception raised by a task is
    ignored, so that it cannot stop a worker; the tasks of an asynchronous operation handle their own errors.

    @par Example
    @code{.py}
LlmThreadPoolExecutor executor(2);
on_exit executor.shutdown();
LlmAsyncOperation op = backend.chatCompletionsAsync(body, <LlmAsyncCallOptions>{"executor": executor});
hash<auto> response = op.get();
    @endcode

    @note All methods are thread-safe.
*/
public class LlmThreadPoolExecutor inherits LlmAsyncExecutor {
    private:internal {
        #! The state shared with the workers, which do not reference the executor
        Priv::LlmThreadPoolState state;
    }

    #! Starts the worker threads
    /** @param threads the number of worker threads; at least 1

        @throw LLM-ASYNC-EXECUTOR-ERROR \a threads is less than 1
    */
    constructor(int threads = 1) [dom=THREAD_CONTROL] {
        if (threads < 1) {
            throw "LLM-ASYNC-EXECUTOR-ERROR", sprintf("an executor needs at least one thread; got %d", threads);
        }
        state = new Priv::LlmThreadPoolState(threads);
        try {
            for (int i = 0; i < threads; ++i) {
                state.startWorker();
            }
        } catch (hash<ExceptionInfo> ex) {
            state.shutdown();
            rethrow;
        }
    }

    #! Stops the worker threads; see @ref shutdown()
    destructor() {
        state.shutdown();
    }

    #! Hands a task over to the workers
    /** @param task the task to run

        @throw LLM-ASYNC-EXECUTOR-ERROR the executor has been shut down
    */
    execute(code<nothing()> task) {
        state.push(task);
    }

    #! Returns the number of worker threads
    int getThreadCount() {
        return state.getThreadCount();
    }

    #! Stops the workers once the tasks already handed over have run, and waits for them to end
    /** Tasks handed over afterwards are refused.  Called from a task of the executor, it does not wait for the
        calling worker.  Calls after the first have no effect.
    */
    shutdown() {
        state.shutdown();
    }
}

#! The options of an asynchronous LLM call
public hashdecl LlmAsyncCallOptions {
    #! Runs the steps of the call and its callbacks
    LlmAsyncExecutor executor;

    #! Called once with the operation when the call has ended, in a thread of the executor
    /** The operation's result or error is set when it is called, and @ref LlmAsyncOperation::wait() returns after it
        has returned.  An exception that it raises is ignored: the result of the operation is not changed.
    */
    *code<nothing(LlmAsyncOperation)> on_complete;
}

#! A request submitted by a step of an asynchronous call; see @ref AbstractLlmProvider::startRequestAsync()
public hashdecl LlmAsyncSubmission {
    #! Aborts the request; the request then ends with an error and signals its notifier
    code<nothing()> cancel;

    #! Returns @ref True if the request has ended
    code<bool()> is_done;

    #! Returns the response of a request that has ended, or raises its error
    code<auto()> get;
}

#! An asynchronous LLM call in flight
/** Returned by the asynchronous calls (@ref AbstractLlmProvider::chatAsync(),
    @ref AbstractLlmProvider::chatStreamAsync() and the
    @ref QoreLlmUtils::LlmBackend "LlmBackend" methods ending in \c Async).  The call holds no thread while it waits
    for the provider; its steps and callbacks run in threads of the executor of the call (see @ref LlmAsyncExecutor).

    The call ends once: with a result (@ref getResult()) or with an error (@ref getError()), which are those the
    synchronous call would return or raise for the same responses of the provider.  @ref cancel() stops the call as
    @ref LlmCancellation::cancel() stops a synchronous call: the request in flight is aborted, no retry or repair
    request follows, and the call ends with \c LLM-CANCELLED.

    @par Example
    @code{.py}
LlmThreadPoolExecutor executor(4);
LlmCancellation stop();
LlmAsyncOperation op = backend.chatCompletionsAsync(body, <LlmAsyncCallOptions>{
    "executor": executor,
    "on_complete": sub (LlmAsyncOperation op) {
        # runs in a thread of the executor
        if (*hash<ExceptionInfo> ex = op.getError()) {
            printf("failed: %s: %s\n", ex.err, ex.desc);
        } else {
            printf("usage: %y\n", op.getResult().usage);
        }
    },
}, <LlmFacadeCallOptions>{"cancellation": stop});
# another thread may call stop.cancel() or op.cancel() at any time
    @endcode

    @par The context of the tasks
    The tasks of an operation run with the context (sandbox restrictions and provenance) of the code that created the
    operation, whatever code posts them: the code that cancels a call, for example, may run with other restrictions
    than its caller, and the caller's completion callback and the steps that the operation posts still run with the
    caller's context; a stream transport reports from any thread only data, which a task made by the request's own
    task processes (qore#7515). A task keeps the restrictions of the code that
    created it as any closure or call reference does, so a task created by more restricted code stays restricted
    (qore#7497). The operation starts its tasks through a
    watch of the async I/O controller registered by the code that created it, which therefore needs a running
    controller: a task posted after the controller has dropped the watch (when it stops, or when the %Program that
    created the operation ends) does not run, and the call does not end.  Work of the module cleanup at the end of
    the process, which the controller does not serve the watch for, hands the drain of the tasks that it posts to the
    executor itself.

    @par Implementing an asynchronous step
    The steps of an operation are tasks given to @ref post(): they run one at a time, in the order given, in threads
    of the executor; an exception that a task raises ends the operation with that error.  A task that code of another
    context (a cancellation handler, for example) posts is made beforehand by code of the operation's context, so that
    it does not take the restrictions of that code.  A step that waits hands
    the wait to the async I/O controller and posts the next step when the wait ends; the last step calls
    @ref complete() or @ref fail().

    @note All methods are thread-safe.
*/
public class LlmAsyncOperation {
    private:internal {
        #! Runs the tasks
        LlmAsyncExecutor executor;

        #! The token that stops the call
        LlmCancellation cancellation;

        #! Called when the call has ended
        *code<nothing(LlmAsyncOperation)> on_complete;

        #! Guards the state
        Mutex m();

        #! Signaled when the operation is done
        Condition cond();

        #! True once the result or the error is set
        bool finished = False;

        #! True once the completion callback has returned
        bool done = False;

        #! The result of the call
        auto result;

        #! The error of the call
        *hash<ExceptionInfo> error;

        #! Tasks waiting to run, in order; each is a hash with "task", "is_final" and "handle" keys
        /** \c handle is a handle of the work of the module cleanup that posted the task (0 outside of such work),
            released once the task has run or is dropped, so that the cleanup at the end of the process waits for the
            task as for the work itself (see
            @ref Qore::AsyncIoController::holdModuleCleanupWork() "AsyncIoController::holdModuleCleanupWork()",
            qore#7339)
        */
        list<hash<auto>> pending = ();

        #! True while a drain of the pending tasks has been requested or runs
        bool draining = False;

        #! True once the requested drain has been handed to the executor
        bool drain_submitted = False;

        #! Starts the drains with the context of the code that created the operation
        Priv::LlmAsyncDrainStarter starter;

        #! The task that runs the completion callback; made by the code that created the operation, so that it does not
        #! take the restrictions of the code that ends the call
        *code<nothing()> completion_task;

        #! Code run once when the result or the error is set, keyed by ID
        hash<string, code> finish_hooks = {};

        #! The last finish hook ID issued
        int hook_seq = 0;

        #! The thread that runs the completion callback while it runs
        int completing_tid = 0;

        #! The thread that runs the tasks while it runs them
        int task_tid = 0;
    }

    #! Creates the operation of a call
    /** @param executor runs the tasks of the call
        @param cancellation the token that stops the call; a new token is created if not given
        @param on_complete called once with the operation when the call has ended, in a thread of the executor
    */
    constructor(LlmAsyncExecutor executor, *LlmCancellation cancellation,
            *code<nothing(LlmAsyncOperation)> on_complete) {
        self.executor = executor;
        self.cancellation = cancellation ?? new LlmCancellation();
        self.on_complete = on_complete;
        # the drains are started by a watch that this code registers, so that they run with its context whatever
        # code posts a task (qore#7497); the watch holds the operation weakly
        LlmAsyncOperation op := self;
        starter = new Priv::LlmAsyncDrainStarter(sub (*hash<ExceptionInfo> arm_error) {
            op.startDrain(arm_error);
        });
        # runs in a drain, which holds the operation
        completion_task = sub () {
            on_exit op.markDone();
            if (op.on_complete) {
                op.setCompleting(True);
                on_exit op.setCompleting(False);
                op.on_complete(op);
            }
        };
        starter.arm();
    }

    #! Ends the watch that starts the drains, and releases the handles of work of the module cleanup of the tasks that
    #! did not run
    /** Tasks are left only if the executor dropped the task that runs them (qore#7339): the cleanup at the end of the
        process does not then wait for them
    */
    destructor() {
        if (starter) {
            starter.close();
        }
        foreach hash<auto> item in (pending) {
            AsyncIoController::releaseModuleCleanupWork(item.handle);
        }
    }

    #! Creates the operation of a call and gives the call the operation's token
    /** @param opts the per-call options of the call; @ref LlmRequestOptions::cancellation is set to a new token if
        it is not given
        @param async_opts the executor of the call and its optional completion callback

        @return the operation of the call, whose token is @ref LlmRequestOptions::cancellation of \a opts
    */
    static LlmAsyncOperation forCall(reference<hash<LlmRequestOptions>> opts, hash<LlmAsyncCallOptions> async_opts) {
        if (!async_opts.executor) {
            throw "LLM-REQUEST-ERROR", "an asynchronous call needs an executor (LlmAsyncCallOptions::executor)";
        }
        if (!opts.cancellation) {
            opts.cancellation = new LlmCancellation();
        }
        return new LlmAsyncOperation(async_opts.executor, opts.cancellation, async_opts.on_complete);
    }

    #! Returns the executor of the call
    LlmAsyncExecutor getExecutor() {
        return executor;
    }

    #! Returns the token that stops the call
    LlmCancellation getCancellation() {
        return cancellation;
    }

    #! Stops the call
    /** Cancels the call's token (see @ref LlmCancellation::cancel()): the request in flight is aborted at once, a
        retry wait ends, no further request is made, and the call ends with \c LLM-CANCELLED unless it has already
        ended.  A token given by the caller is cancelled with it, which stops every call that it was given to.

        @param reason an optional reason reported in the \c LLM-CANCELLED error
    */
    cancel(*string reason) {
        cancellation.cancel(reason);
    }

    #! Returns @ref True if the call has ended and its completion callback has returned
    bool isDone() {
        AutoLock al(m);
        return done;
    }

    #! Returns @ref True if the call has ended with an error
    /** Valid in the completion callback, which runs once the call has ended.
    */
    bool isError() {
        AutoLock al(m);
        return finished && exists error;
    }

    #! Returns the error of a call that has ended with an error, or @ref nothing
    /** Valid in the completion callback, which runs once the call has ended.
    */
    *hash<ExceptionInfo> getError() {
        AutoLock al(m);
        return finished ? error : NOTHING;
    }

    #! Returns the result of a call that has ended
    /** Valid in the completion callback, which runs once the call has ended.

        @return the result of the call: what the synchronous call returns

        @throw LLM-ASYNC-NOT-DONE the call has not ended yet
        @throw any the error of a call that has ended with an error is raised
    */
    auto getResult() {
        AutoLock al(m);
        if (!finished) {
            throw "LLM-ASYNC-NOT-DONE", "the asynchronous LLM call has not ended yet";
        }
        if (error) {
            throw error.err, error.desc, error.arg;
        }
        return result;
    }

    #! Waits until the call has ended and its completion callback has returned
    /** For tests and for callers that are synchronous themselves; a caller of an asynchronous call normally uses
        the completion callback instead.  Called from the completion callback, it returns at once.

        @param timeout_ms the maximum time to wait; not given or negative: waits until the call has ended

        @return @ref True if the call has ended, @ref False if the timeout expired first
    */
    bool wait(*timeout timeout_ms) {
        *date deadline = exists timeout_ms && timeout_ms >= 0 ? now_us() + milliseconds(timeout_ms) : NOTHING;
        AutoLock al(m);
        # the completion callback itself (or code it calls) sees the call as ended: it is done once it returns
        if (finished && completing_tid == gettid()) {
            return True;
        }
        while (!done) {
            if (!deadline) {
                cond.wait(m);
                continue;
            }
            int remaining = (deadline - now_us()).durationMilliseconds();
            if (remaining <= 0) {
                break;
            }
            cond.wait(m, remaining);
        }
        return done;
    }

    #! Waits until the call has ended and returns its result or raises its error
    /** @param timeout_ms the maximum time to wait; not given or negative: waits until the call has ended

        @return the result of the call

        @throw LLM-ASYNC-TIMEOUT the call has not ended within \a timeout_ms
        @throw any the error of a call that has ended with an error is raised
    */
    auto get(*timeout timeout_ms) {
        if (!wait(timeout_ms)) {
            throw "LLM-ASYNC-TIMEOUT", sprintf("the asynchronous LLM call has not ended within %d ms", timeout_ms);
        }
        return getResult();
    }

    #! Returns @ref True once the result or the error of the call is set
    /** Steps of the call use it to see that the call has ended; the completion callback may not have run yet.
    */
    bool isFinished() {
        AutoLock al(m);
        return finished;
    }

    #! Runs a step of the call in a thread of the executor
    /** The tasks of an operation run one at a time, in the order they are given; an exception that a task raises
        ends the call with that error.  Tasks given after the result or the error is set are not run.  This method
        does not wait, and it can be called in any thread, also in the threads of the async I/O controller.

        @param task the step to run
    */
    post(code<nothing()> task) {
        postIntern(task, False);
    }

    #! Ends the call with a result
    /** Runs the finish hooks, then the completion callback in a thread of the executor.

        @param value the result of the call

        @return @ref True if the call has ended with this result, @ref False if it had already ended
    */
    bool complete(auto value) {
        return finish(value, NOTHING);
    }

    #! Ends the call with an error
    /** Runs the finish hooks, then the completion callback in a thread of the executor.

        @param ex the error of the call

        @return @ref True if the call has ended with this error, @ref False if it had already ended
    */
    bool fail(hash<ExceptionInfo> ex) {
        return finish(NOTHING, ex);
    }

    #! Adds code that runs once when the result or the error of the call is set
    /** Steps use it to release what they hold (a cancellation handler, a timer, a request in flight) whatever ends
        the call.  The code runs in the thread that ends the call; an exception that it raises is ignored.

        @param hook the code to run; it runs at once if the call has already ended

        @return an ID for @ref removeFinishHook(), or 0 if the hook has already run
    */
    int addFinishHook(code<nothing()> hook) {
        {
            AutoLock al(m);
            if (!finished) {
                int id = ++hook_seq;
                finish_hooks{id} = hook;
                return id;
            }
        }
        runHook(hook);
        return 0;
    }

    #! Removes a hook added with @ref addFinishHook()
    /** @param id the ID returned by @ref addFinishHook()
    */
    removeFinishHook(int id) {
        if (!id) {
            return;
        }
        AutoLock al(m);
        remove finish_hooks{id};
    }

    #! Returns @ref True if the calling thread is running a task of this operation
    /** Steps use it to tell whether they may wait: a task runs in a thread of the executor, which may wait, while
        other code of a call (a cancellation handler, a finish hook) can run in a thread of the async I/O controller,
        which must not wait.
    */
    bool inTask() {
        AutoLock al(m);
        return task_tid == gettid();
    }

    #! Runs the pending tasks in a thread of the executor
    private:internal drain() {
        {
            AutoLock al(m);
            task_tid = gettid();
        }
        on_exit {
            AutoLock al(m);
            task_tid = 0;
        }
        while (True) {
            hash<auto> item;
            {
                AutoLock al(m);
                if (!pending) {
                    draining = False;
                    drain_submitted = False;
                    return;
                }
                item = shift pending;
                # a step given after the call has ended is not run
                if (finished && !item.is_final) {
                    AsyncIoController::releaseModuleCleanupWork(item.handle);
                    continue;
                }
            }
            try {
                code<nothing()> task = item.task;
                # the task runs as the work of the module cleanup that posted it, if any, which then waits for it; the
                # handle is released when it has run (qore#7339)
                if (item.handle) {
                    AsyncIoController::runModuleCleanupWork(item.handle, task);
                } else {
                    task();
                }
            } catch (hash<ExceptionInfo> ex) {
                if (item.is_final) {
                    # the completion callback is the caller's code, whose error cannot change the result
                    markDone();
                } else {
                    fail(ex);
                }
            }
        }
    }

    #! Queues a task and starts a drain if none is running
    private:internal postIntern(code<nothing()> task, bool is_final) {
        int handle;
        {
            AutoLock al(m);
            if (done) {
                return;
            }
            # work of the module cleanup at the end of the process that posts the task (an HTTP or SSE callback of a
            # canceled request, for example) hands itself over to the thread of the executor that runs it (0 outside
            # of such work) (qore#7339)
            handle = AsyncIoController::holdModuleCleanupWork();
            pending += {"task": task, "is_final": is_final, "handle": handle};
            if (draining) {
                # work of the module cleanup does not wait for a drain requested through the watch (see below)
                if (!handle) {
                    return;
                }
            } else {
                draining = True;
            }
        }
        # the drain is handed to the executor by the starter's watch, with the context of the code that created the
        # operation, not by this thread, whose code may have another context (qore#7497)
        if (handle) {
            # work of the module cleanup at the end of the process, which waits for the task: the controller does not
            # serve the starter's watch then, so the drain is handed over from this thread (qore#7339), and has the
            # context of this work
            submitDrain();
            return;
        }
        if (*hash<ExceptionInfo> ex = starter.request(self)) {
            # no watch can start the drain
            executorFailed(ex);
        }
    }

    #! Hands the requested drain to the executor; called by the starter's watch, with the context of the code that
    #! created the operation
    /** @param arm_error the error of the watch that could not be registered again: the operation cannot start
        another drain, and the call ends with this error unless it has ended; its completion callback runs only if the
        drain handed over here runs it
    */
    private:internal startDrain(*hash<ExceptionInfo> arm_error) {
        if (!submitDrain()) {
            return;
        }
        if (arm_error) {
            fail(arm_error);
        }
    }

    #! Hands the requested drain to the executor, if one is requested and has not been handed over
    /** @return @ref False if the operation is done or the executor refused the drain, which ends the call
    */
    private:internal bool submitDrain() {
        bool submit;
        {
            AutoLock al(m);
            if (done) {
                return False;
            }
            if (draining && !drain_submitted) {
                drain_submitted = True;
                submit = True;
            }
        }
        if (submit) {
            # the executor's task references the operation, which stays alive until its tasks have run
            LlmAsyncOperation op = self;
            try {
                executor.execute(sub () { op.drain(); });
            } catch (hash<ExceptionInfo> ex) {
                executorFailed(ex);
                return False;
            }
        }
        return True;
    }

    #! Ends the call when the executor refuses its tasks; the completion callback, which needs a thread of the
    #! executor, is not run
    private:internal executorFailed(hash<ExceptionInfo> ex) {
        list<hash<auto>> dropped;
        {
            AutoLock al(m);
            dropped = pending;
            pending = ();
            draining = False;
            drain_submitted = False;
        }
        # the tasks do not run: the cleanup does not wait for them
        map AsyncIoController::releaseModuleCleanupWork($1.handle), dropped;
        setFinished(NOTHING, ex);
        markDone();
    }

    #! Sets the result or the error and runs the finish hooks; returns False if the call had already ended
    private:internal bool setFinished(auto value, *hash<ExceptionInfo> ex) {
        hash<string, code> hooks;
        {
            AutoLock al(m);
            if (finished) {
                return False;
            }
            finished = True;
            result = value;
            error = ex;
            hooks = finish_hooks;
            finish_hooks = {};
        }
        foreach code hook in (hooks.iterator()) {
            runHook(hook);
        }
        return True;
    }

    #! Ends the call
    private:internal bool finish(auto value, *hash<ExceptionInfo> ex) {
        if (!setFinished(value, ex)) {
            return False;
        }
        # the task made by the code that created the operation: this code may run with other restrictions (qore#7497)
        code<nothing()> task;
        {
            AutoLock al(m);
            task = remove completion_task;
        }
        postIntern(task, True);
        return True;
    }

    #! Records the thread that runs the completion callback
    private:internal setCompleting(bool completing) {
        AutoLock al(m);
        completing_tid = completing ? gettid() : 0;
    }

    #! Marks the operation done and wakes the waiting threads
    private:internal markDone() {
        {
            AutoLock al(m);
            if (done) {
                return;
            }
            done = True;
            cond.broadcast();
        }
        # no task runs after the call is done
        starter.close();
    }

    #! Runs a finish hook
    private:internal static runHook(code<nothing()> hook) {
        try {
            hook();
        } catch (hash<ExceptionInfo> ex) {
            # a hook releases resources; its failure cannot change how the call ended
        }
    }
}

#! A streamed request of an asynchronous call: one Server-Sent Events stream with the retry policy of the call
/** Providers use this class to implement @ref AbstractLlmProvider::startChatStreamAsync(): the transport delivers
    the start, the events and the end of each attempt's stream with @ref sseConnected(), @ref sseEvent() and
    @ref sseClosed(), from any thread; the provider's event handler runs in tasks of the operation, in order.

    A stream that fails before it starts (for example with an HTTP 429 answer) is retried as
    @ref AbstractLlmProvider::withRetry() retries it; once the stream has started, an error ends the call.  A
    cancellation of the call's token stops the stream at once, and the call ends with \c LLM-CANCELLED.  The stream
    fails when no event arrives within the idle timeout given to the transport, and with the deadline given here.

    @note All methods are thread-safe.
*/
public class LlmAsyncSseRequest {
    public {
        #! The stream has ended normally
        const ClosedEnd = "end";
        #! No event arrived within the idle timeout
        const ClosedIdleTimeout = "idle-timeout";
        #! The stream reported an error
        const ClosedError = "error";
    }

    private:internal {
        AbstractLlmProvider provider;
        LlmAsyncOperation op;
        *hash<LlmRequestOptions> opts;
        code<code<nothing()>(LlmAsyncSseRequest, int)> open;
        code<bool(hash<auto>)> on_event;
        code<nothing()> on_eof;
        code<hash<ExceptionInfo>()> timeout_error;
        code<nothing()> on_end;
        code<nothing(hash<ExceptionInfo>)> error_cb;
        code<hash<ExceptionInfo>(hash<ExceptionInfo>)> start_error;
        *int deadline_ms;
        *string start_desc;

        #! Guards the fields that cancellation handlers and finish hooks read
        Mutex m();
        #! Transport notifications waiting for the operation, in arrival order
        list<hash<auto>> reports = ();
        #! Handles one notification in the context in which the request was started
        *code<nothing()> process_report;
        #! The sequence number of the current attempt
        int attempt_seq = 0;
        #! Reports the end of the current attempt's start to the retry policy
        *code<nothing(*hash<ExceptionInfo>, auto)> attempt_done;
        #! Stops the transport of the current attempt
        *code<nothing()> stop;
        #! True once the stream of the current attempt has started
        bool streaming = False;
        #! True once the request has ended
        bool ended = False;
        int cancel_id = 0;
        int deadline_timer = 0;
        int hook_id = 0;
    }

    #! Creates the request
    /** @param provider the provider making the request
        @param op the operation the request is a step of
        @param opts per-call request overrides
        @param open opens the stream of an attempt, in a task of \a op, and returns the code that stops it; it
        receives this object and the attempt number to give to @ref sseConnected(), @ref sseEvent() and
        @ref sseClosed()
        @param on_event handles an event of the stream in a task of \a op; returns @ref True if the stream is complete,
        and may raise an exception, which ends the call with it
        @param on_eof called in a task of \a op when the stream is complete, before \a on_end; may raise an exception,
        which ends the call with it
        @param timeout_error returns the error of a stream that delivered no event in time
        @param start_error returns the error of the call when the stream could not be started, given the error of the
        last attempt (an \c LLM-CANCELLED error is never given to it)
        @param on_end called in a task of \a op when the stream is complete
        @param error_cb receives the error of the call in a task of \a op
        @param deadline_ms if given, the time in milliseconds by which the stream must be complete
        @param start_desc the method and path of the request, as in \c "POST /v1/messages", for the error of a stream
        whose response does not start in time, which is then the one that a synchronous stream reader raises
    */
    constructor(AbstractLlmProvider provider, LlmAsyncOperation op, *hash<LlmRequestOptions> opts,
            code<code<nothing()>(LlmAsyncSseRequest, int)> open, code<bool(hash<auto>)> on_event,
            code<nothing()> on_eof, code<hash<ExceptionInfo>()> timeout_error,
            code<hash<ExceptionInfo>(hash<ExceptionInfo>)> start_error, code<nothing()> on_end,
            code<nothing(hash<ExceptionInfo>)> error_cb, *int deadline_ms, *string start_desc) {
        self.provider = provider;
        self.op = op;
        self.opts = opts;
        self.open = open;
        self.on_event = on_event;
        self.on_eof = on_eof;
        self.timeout_error = timeout_error;
        self.start_error = start_error;
        self.on_end = on_end;
        self.error_cb = error_cb;
        self.deadline_ms = deadline_ms;
        self.start_desc = start_desc;
    }

    #! Returns the error of a stream whose response has not started in time
    private:internal hash<ExceptionInfo> startTimeoutError(*hash<ExceptionInfo> ex) {
        if (start_desc) {
            return AbstractLlmProvider::makeException("HTTPCLIENT-TIMEOUT",
                sprintf("timeout waiting for SSE response headers for %s", start_desc), NOTHING);
        }
        return ex ?? AbstractLlmProvider::makeException("HTTPCLIENT-TIMEOUT", "LLM call deadline exhausted", NOTHING);
    }

    #! Returns the error of a stream that an SSE observable closed
    /** @param info the data of the observable's close event: a \c reason key, absent when the stream ended normally,
        and an \c error key with the error of a stream that failed

        @return the error to give to @ref sseClosed(), or @ref nothing for a stream that ended normally or whose idle
        timeout expired
    */
    static *hash<ExceptionInfo> getCloseError(hash<auto> info) {
        if (!exists info.reason || info.reason == "idle-timeout") {
            return NOTHING;
        }
        auto error = info.error;
        if (info.reason == "stream-error") {
            # an event larger than the maximum event size, as a synchronous stream reader reports it
            if (error.typeCode() == NT_HASH && error.err == "SSE-EVENT-TOO-LARGE") {
                return AbstractLlmProvider::makeException(error.err, error.desc ?? "", NOTHING);
            }
            # the error item of the stream (a hash with "err" and "desc" keys), reported as a synchronous stream
            # reader reports it
            return AbstractLlmProvider::makeException("SSE-STREAM-ERROR", sprintf("stream error: %y", error),
                NOTHING);
        }
        if (error.typeCode() == NT_HASH && error.err.typeCode() == NT_STRING) {
            # the error itself, with its call stack and chained errors
            return cast<hash<ExceptionInfo>>(error);
        }
        return AbstractLlmProvider::makeException("SSE-STREAM-ERROR", sprintf("the event stream was closed: %s",
            info.reason), NOTHING);
    }

    #! Starts the request; must be called in a task of the operation
    start() {
        LlmAsyncSseRequest req = self;
        {
            AutoLock al(m);
            process_report = sub () { req.processReport(); };
        }
        hook_id = op.addFinishHook(sub () { req.release(); });
        if (deadline_ms) {
            LlmAsyncOperation o = op;
            deadline_timer = Qore::AsyncIoController::addTimerDelay(deadline_ms, sub () {
                o.post(sub () { req.deadlineReached(); });
            });
        }
        provider.startWithRetryAsync(op, opts, code<nothing()> sub (code<nothing(*hash<ExceptionInfo>, auto)> done) {
            return req.startAttempt(done);
        }, sub (auto v) {
            req.started();
        }, sub (hash<ExceptionInfo> ex) {
            req.startFailed(ex);
        });
    }

    #! Reports that the stream of an attempt has started; can be called in any thread
    /** @param attempt the attempt number given to the code that opened the stream
    */
    sseConnected(int attempt) {
        postReport({"attempt": attempt, "kind": "connected"});
    }

    #! Reports an event of the stream of an attempt; can be called in any thread
    /** @param attempt the attempt number given to the code that opened the stream
        @param event the event: a hash with \c event and \c data keys, as in @ref Qore::SseMessageInfo
    */
    sseEvent(int attempt, hash<auto> event) {
        postReport({"attempt": attempt, "kind": "event", "event": event});
    }

    #! Reports the end of the stream of an attempt; can be called in any thread
    /** @param attempt the attempt number given to the code that opened the stream
        @param how @ref ClosedEnd, @ref ClosedIdleTimeout or @ref ClosedError
        @param ex the error, for a stream that failed
    */
    sseClosed(int attempt, string how, *hash<ExceptionInfo> ex) {
        postReport({"attempt": attempt, "kind": "closed", "how": how, "error": ex});
    }

    #! The transport posts data; only the request's own task calls the provider.
    private:internal postReport(hash<auto> report) {
        code<nothing()> task;
        {
            AutoLock al(m);
            if (!process_report || ended || report.attempt != attempt_seq) {
                return;
            }
            push reports, report;
            task = process_report;
        }
        op.post(task);
    }

    private:internal processReport() {
        hash<auto> report;
        {
            AutoLock al(m);
            if (!reports) {
                return;
            }
            report = shift reports;
        }
        switch (report.kind) {
            case "connected":
                handleConnected(report.attempt);
                break;
            case "event":
                handleEvent(report.attempt, report.event);
                break;
            case "closed":
                handleClosed(report.attempt, report.how, report.error);
                break;
        }
    }

    #! Starts an attempt; called by the retry policy in a task of the operation
    private:internal code<nothing()> startAttempt(code<nothing(*hash<ExceptionInfo>, auto)> done) {
        int attempt;
        {
            AutoLock al(m);
            attempt = ++attempt_seq;
            attempt_done = done;
            streaming = False;
        }
        code<nothing()> stop_attempt = open(self, attempt);
        bool abandoned;
        {
            AutoLock al(m);
            abandoned = ended || attempt != attempt_seq;
            if (!abandoned) {
                stop = stop_attempt;
            }
        }
        # A finish hook may have ended the request while open() was obtaining the stopper.
        if (abandoned) {
            runStop(stop_attempt);
        }
        LlmAsyncSseRequest req = self;
        LlmAsyncOperation o = op;
        # made here, in a task of the operation: the code that stops the attempt may have another context (qore#7497)
        code<nothing()> closed = sub () { req.handleClosed(attempt, ClosedEnd); };
        return sub () {
            req.stopTransport();
            # the attempt ends even if the transport reports nothing after it was stopped
            o.post(closed);
        };
    }

    #! The stream has started: cancellation now stops it
    private:internal started() {
        LlmAsyncSseRequest req = self;
        LlmAsyncOperation o = op;
        # made here, in a task of the operation: the handler runs in the thread of the code that cancels (qore#7497)
        code<nothing()> cancelled = sub () { req.cancelled(); };
        int id = provider.addRequestCancelHandler(opts, sub () {
            req.stopTransport();
            o.post(cancelled);
        });
        {
            AutoLock al(m);
            if (!ended) {
                cancel_id = id;
                return;
            }
        }
        # the request ended while the handler was added
        provider.removeRequestCancelHandler(opts, id);
    }

    #! The stream could not be started
    private:internal startFailed(hash<ExceptionInfo> ex) {
        if (!end()) {
            return;
        }
        error_cb(ex.err == "LLM-CANCELLED" ? ex : start_error(ex));
    }

    private:internal handleConnected(int attempt) {
        *code<nothing(*hash<ExceptionInfo>, auto)> done;
        {
            AutoLock al(m);
            if (ended || attempt != attempt_seq || !attempt_done) {
                return;
            }
            done = remove attempt_done;
            streaming = True;
        }
        done(NOTHING, True);
    }

    private:internal handleEvent(int attempt, hash<auto> event) {
        {
            AutoLock al(m);
            if (ended || attempt != attempt_seq || !streaming) {
                return;
            }
        }
        bool complete;
        try {
            complete = on_event(event);
        } catch (hash<ExceptionInfo> ex) {
            failStream(ex);
            return;
        }
        if (complete) {
            completeStream();
        }
    }

    private:internal handleClosed(int attempt, string how, *hash<ExceptionInfo> ex) {
        *code<nothing(*hash<ExceptionInfo>, auto)> done;
        {
            AutoLock al(m);
            if (ended || attempt != attempt_seq) {
                return;
            }
            if (!streaming) {
                if (!attempt_done) {
                    return;
                }
                done = remove attempt_done;
            }
        }
        if (done) {
            # the stream ended before it started: an error of the attempt, which the retry policy handles
            if (ex.err == "HTTPCLIENT-TIMEOUT") {
                ex = startTimeoutError(ex);
            }
            done(ex ?? AbstractLlmProvider::makeException("HTTPCLIENT-CANCELLED",
                "the event stream was closed before it started", NOTHING));
            return;
        }
        # an error of the transport is reported as LLM-CANCELLED once the call is cancelled, as in a synchronous call
        if (*hash<ExceptionInfo> cancel_ex = provider.getRequestCancelledError(opts)) {
            failStream(cancel_ex);
            return;
        }
        switch (how) {
            case ClosedEnd:
                completeStream();
                break;
            case ClosedIdleTimeout:
                failStream(timeout_error());
                break;
            default:
                failStream(ex ?? AbstractLlmProvider::makeException("SSE-STREAM-ERROR", "the event stream failed",
                    NOTHING));
                break;
        }
    }

    #! The call's token has been cancelled while the stream runs
    private:internal cancelled() {
        if (*hash<ExceptionInfo> cancel_ex = provider.getRequestCancelledError(opts)) {
            failStream(cancel_ex);
        }
    }

    #! The deadline of the stream has passed
    private:internal deadlineReached() {
        *code<nothing(*hash<ExceptionInfo>, auto)> done;
        {
            AutoLock al(m);
            if (ended) {
                return;
            }
            deadline_timer = 0;
            if (!streaming) {
                done = remove attempt_done;
            }
        }
        if (done) {
            stopTransport();
            done(startTimeoutError());
            return;
        }
        if (!streaming) {
            # between attempts: the retry policy's own deadline ends the call
            return;
        }
        failStream(timeout_error());
    }

    #! The stream is complete
    private:internal completeStream() {
        try {
            on_eof();
        } catch (hash<ExceptionInfo> ex) {
            failStream(ex);
            return;
        }
        if (!end()) {
            return;
        }
        stopTransport();
        on_end();
    }

    #! The stream has failed
    private:internal failStream(hash<ExceptionInfo> ex) {
        if (!end()) {
            return;
        }
        stopTransport();
        error_cb(ex);
    }

    #! Ends the request; returns False if it had already ended
    private:internal bool end() {
        int id;
        int timer;
        {
            AutoLock al(m);
            if (ended) {
                return False;
            }
            ended = True;
            reports = ();
            remove process_report;
            id = cancel_id;
            cancel_id = 0;
            timer = deadline_timer;
            deadline_timer = 0;
        }
        provider.removeRequestCancelHandler(opts, id);
        if (timer) {
            Qore::AsyncIoController::cancelTimer(timer);
        }
        op.removeFinishHook(hook_id);
        return True;
    }

    #! Stops the transport of the current attempt; can be called in any thread
    /** Stopping a stream can wait until the async I/O controller has stopped reading it, so it waits only in a task
        of the operation, which runs in a thread of the executor.  Anywhere else (a cancellation handler, or a finish
        hook run in a thread of the controller when the executor refuses a task) it is stopped in a thread of its own,
        so that a thread of the controller never waits for the controller.
    */
    private:internal stopTransport() {
        bool in_task = op.inTask();
        code<nothing()> s;
        {
            AutoLock al(m);
            if (!stop) {
                return;
            }
            s = stop;
            if (!in_task) {
                # work of the module cleanup that releases the request hands itself over to the thread that stops the
                # transport (qore#7339); wrapped here, in this thread, as background evaluates its expression in the
                # new thread; the call is created by a static method, so that it does not refer to this object
                code<nothing()> c = AsyncIoController::wrapModuleCleanupWork(LlmAsyncSseRequest::getStop(s));
                try {
                    background c();
                } catch (hash<ExceptionInfo> ex) {
                    # no thread can be started (a thread limit of the caller's sandbox): the stopper stays for the
                    # task that ends the request, which stops the transport in a thread of the executor (qore#7497);
                    # the wrapped call, released unrun, releases its handle
                    return;
                }
            }
            remove stop;
        }
        if (in_task) {
            runStop(s);
        }
    }

    #! Returns a call that stops a transport; static, so that it does not refer to an object
    private:internal static code<nothing()> getStop(code<nothing()> stop_transport) {
        return sub () { LlmAsyncSseRequest::runStop(stop_transport); };
    }

    #! Stops a transport
    private:internal static runStop(code<nothing()> stop_transport) {
        try {
            stop_transport();
        } catch (hash<ExceptionInfo> ex) {
            # the stream is being abandoned; a failure to close it cannot change how the call ends
        }
    }

    #! Releases the request when the operation ends otherwise
    private:internal release() {
        if (end()) {
            stopTransport();
        }
    }
}

#! Private implementation classes of the asynchronous LLM API
namespace Priv {
#! The state of an LlmThreadPoolExecutor, shared with its workers
class LlmThreadPoolState {
    private:internal {
        Queue tasks();
        Counter running();
        Mutex m();
        bool stopped = False;
        int size;
        #! The thread IDs of the workers
        hash<string, bool> worker_tids = {};
    }

    constructor(int size) {
        self.size = size;
    }

    startWorker() {
        running.inc();
        try {
            background LlmThreadPoolState::runWorker(self);
        } catch (hash<ExceptionInfo> ex) {
            running.dec();
            rethrow;
        }
    }

    push(code<nothing()> task) {
        AutoLock al(m);
        if (stopped) {
            throw "LLM-ASYNC-EXECUTOR-ERROR", "the executor has been shut down";
        }
        # the task runs with the sandbox of the code that hands it over, besides that of the worker, which is the
        # sandbox of the code that created the executor (qore#7497)
        tasks.push(SandboxManager::bindCall(task));
    }

    int getThreadCount() {
        return size;
    }

    shutdown() {
        bool own_worker;
        {
            AutoLock al(m);
            if (stopped) {
                return;
            }
            stopped = True;
            own_worker = worker_tids{gettid()} ?? False;
        }
        for (int i = 0; i < size; ++i) {
            tasks.push(NOTHING);
        }
        if (own_worker) {
            # a worker cannot wait for itself; it ends when its task returns
            return;
        }
        running.waitForZero();
    }

    private:internal setWorker(bool active) {
        AutoLock al(m);
        if (active) {
            worker_tids{gettid()} = True;
        } else {
            remove worker_tids{gettid()};
        }
    }

    static runWorker(LlmThreadPoolState state) {
        state.setWorker(True);
        on_exit {
            state.setWorker(False);
            state.running.dec();
        }
        while (True) {
            auto task = state.tasks.get();
            if (!exists task) {
                break;
            }
            try {
                task();
            } catch (hash<ExceptionInfo> ex) {
                # a task handles its own errors; one that does not cannot stop the worker
            }
        }
    }
}

#! Starts the drains of an LlmAsyncOperation with the context of the code that created the operation (qore#7497)
/** A drain is handed to the executor by the callback of a watch of the async I/O controller, which runs with the
    context of the code that registered the watch: the code that created the operation, then the callback itself,
    which registers the next watch before it starts the drain.  Code of any context requests a drain by signaling the
    watch, so that the drain does not take the context of that code.  The starter holds the operation while a drain
    is requested, so that the operation stays alive until its tasks have run; otherwise only weakly, through the code
    that starts a drain, which is called only while the operation is held.
*/
class LlmAsyncDrainStarter {
    private:internal {
        Mutex m();
        #! The notifier of the current watch
        *EventNotifier notifier;
        #! True once the operation is done or released: no watch is registered any more
        bool closed = False;
        #! The error of the watch that could not be registered again
        *hash<ExceptionInfo> arm_error;
        #! The operation while a drain is requested: it stays alive until its tasks have run
        *object held;
        #! Hands the requested drain to the executor; holds the operation weakly
        code<nothing(*hash<ExceptionInfo>)> start;
    }

    constructor(code<nothing(*hash<ExceptionInfo>)> start) {
        self.start = start;
    }

    #! Registers a watch; called with the context of the code that created the operation
    /** @throw any error of the registration; requests then fail with it
    */
    arm() {
        {
            AutoLock al(m);
            if (closed) {
                return;
            }
        }
        LlmAsyncDrainStarter starter = self;
        try {
            EventNotifier n();
            {
                AutoLock al(m);
                # closed meanwhile: no watch, as nothing would end it
                if (closed) {
                    return;
                }
                notifier = n;
            }
            LlmAsyncNotifierWatch::watch(n, sub () { starter.fired(); });
        } catch (hash<ExceptionInfo> ex) {
            # no watch serves a request any more: requests fail with this error
            AutoLock al(m);
            remove notifier;
            arm_error = ex;
            rethrow;
        }
    }

    #! Requests a drain; called in any thread after the operation has recorded the request
    /** @param op the operation, which is held until the watch has started the drain

        @return the error of the watch that could not be registered, if no watch can start the drain; a request of an
        operation that is done or released is ignored
    */
    *hash<ExceptionInfo> request(object op) {
        AutoLock al(m);
        if (closed) {
            return;
        }
        if (!notifier) {
            return arm_error ?? AbstractLlmProvider::makeException("LLM-ASYNC-ERROR", "the operation cannot start its "
                "tasks: its watch of the async I/O controller is not registered", NOTHING);
        }
        held = op;
        notifier.notify();
    }

    #! Ends the current watch; no drain is started after it
    close() {
        *EventNotifier n;
        *object op;
        {
            AutoLock al(m);
            if (closed) {
                return;
            }
            closed = True;
            n = remove notifier;
            # released outside the lock: the operation may be destroyed with it
            op = remove held;
        }
        if (n) {
            n.notify();
        }
    }

    #! The watch was signaled or has ended: registers the next watch, then starts a requested drain
    private:internal fired() {
        # the next watch is registered before the request is taken, so that a request made meanwhile is either taken
        # here or signals the next watch
        *hash<ExceptionInfo> arm_error;
        try {
            arm();
        } catch (hash<ExceptionInfo> ex) {
            # a later request fails with this error (see request())
            arm_error = ex;
        }
        # the operation is called only while it is held for a request: a watch that ends without one (when the
        # operation is closed, also by its destructor in another thread) does not call it
        *object op;
        {
            AutoLock al(m);
            op = remove held;
        }
        if (op) {
            start(arm_error);
        }
    }
}

#! Watches an EventNotifier with the async I/O controller and calls code once when it is signaled or the watch ends
class LlmAsyncNotifierWatch inherits Qore::AbstractPollOperation<auto> {
    private:internal {
        EventNotifier notifier;
        code<nothing()> on_signal;
        bool started = False;
        bool signaled = False;
        Mutex m();
    }

    constructor(EventNotifier notifier, code<nothing()> on_signal) {
        self.notifier = notifier;
        self.on_signal = on_signal;
    }

    #! Watches the notifier; \a on_signal is called once, in a thread of the controller, and must not wait
    static watch(EventNotifier notifier, code<nothing()> on_signal) {
        LlmAsyncNotifierWatch op(notifier, on_signal);
        Qore::AsyncIoController::submit(operation_info: <SocketPollOperationInfo>{
            "sock": notifier,
            "spop": op,
            "owner": "QoreLlmUtils::LlmAsyncOperation:" + op.uniqueHash(),
            # the request that signals the notifier has its own deadline
            "to": -1s,
            "has_on_complete": True,
        });
    }

    string getGoal() {
        return "llm-request-ended";
    }

    string getState() {
        return signaled ? "signaled" : (started ? "waiting" : "pending");
    }

    bool goalReached() {
        AutoLock al(m);
        return signaled;
    }

    *hash<SocketPollInfo> continuePoll() {
        if (!started) {
            started = True;
            return <SocketPollInfo>{
                "events": SOCK_POLLIN,
                "socket": notifier,
            };
        }
        fire();
        return NOTHING;
    }

    nothing onComplete(hash<SocketPollResultInfo> result) {
        # also when the controller cancels the watch: the caller then aborts the request and reads its error
        fire();
    }

    private:internal fire() {
        {
            AutoLock al(m);
            if (signaled) {
                return;
            }
            signaled = True;
        }
        on_signal();
    }
}

#! Applies the retry policy of AbstractLlmProvider::withRetry() to an asynchronous request; all methods except the
#! cancellation handlers and the finish hook run in tasks of the operation
class LlmAsyncRetry {
    private:internal {
        AbstractLlmProvider provider;
        LlmAsyncOperation op;
        *hash<LlmRequestOptions> opts;
        code<code<nothing()>(code<nothing(*hash<ExceptionInfo>, auto)>)> attempt;
        code<nothing(auto)> success_cb;
        code<nothing(hash<ExceptionInfo>)> error_cb;
        hash<auto> state;

        #! Guards the fields that cancellation handlers and the finish hook read
        Mutex m();
        #! The sequence number of the current attempt or wait
        int seq = 0;
        #! True while an attempt is in flight
        bool in_flight = False;
        #! True while a backoff wait runs
        bool waiting = False;
        #! True once the request has ended
        bool ended = False;
        int cancel_id = 0;
        int timer_id = 0;
        int hook_id = 0;
        #! Aborts the attempt in flight
        *code<nothing()> abort;
    }

    constructor(AbstractLlmProvider provider, LlmAsyncOperation op, *hash<LlmRequestOptions> opts,
            code<code<nothing()>(code<nothing(*hash<ExceptionInfo>, auto)>)> attempt,
            code<nothing(auto)> success_cb, code<nothing(hash<ExceptionInfo>)> error_cb) {
        self.provider = provider;
        self.op = op;
        self.opts = opts;
        self.attempt = attempt;
        self.success_cb = success_cb;
        self.error_cb = error_cb;
        state = provider.newRetryState(opts);
    }

    start() {
        LlmAsyncRetry retry = self;
        hook_id = op.addFinishHook(sub () { retry.release(); });
        runAttempt();
    }

    private:internal runAttempt() {
        {
            AutoLock al(m);
            if (ended) {
                return;
            }
        }
        # a cancelled call does not start an attempt
        if (*hash<ExceptionInfo> cancel_ex = provider.getRequestCancelledError(opts)) {
            finishError(cancel_ex);
            return;
        }
        ++state.record.attempts;
        int my_seq;
        {
            AutoLock al(m);
            my_seq = ++seq;
            in_flight = True;
        }
        LlmAsyncRetry retry = self;
        code<nothing()> abort_attempt;
        try {
            abort_attempt = attempt(sub (*hash<ExceptionInfo> ex, auto value) {
                retry.attemptDone(my_seq, ex, value);
            });
        } catch (hash<ExceptionInfo> ex) {
            attemptDone(my_seq, ex);
            return;
        }
        code<nothing()> safe_abort = sub () {
            try {
                abort_attempt();
            } catch (hash<ExceptionInfo> ex) {
                # the attempt reports its end whatever the abort does
            }
        };
        bool released = False;
        {
            AutoLock al(m);
            if (!in_flight || my_seq != seq) {
                return;
            }
            # release() ran while the attempt was being started, and found no attempt to abort
            released = ended;
            if (!released) {
                abort = safe_abort;
            }
        }
        if (released) {
            safe_abort();
            return;
        }
        # runs the abort at once if the call has already been cancelled
        setCancelHandler(provider.addRequestCancelHandler(opts, safe_abort));
    }

    #! Keeps the ID of a cancellation handler, or removes the handler if the request has ended meanwhile
    private:internal setCancelHandler(int id) {
        {
            AutoLock al(m);
            if (!ended) {
                cancel_id = id;
                return;
            }
        }
        provider.removeRequestCancelHandler(opts, id);
    }

    attemptDone(int my_seq, *hash<ExceptionInfo> ex, auto value) {
        int id;
        {
            AutoLock al(m);
            if (ended || my_seq != seq || !in_flight) {
                return;
            }
            in_flight = False;
            remove abort;
            id = cancel_id;
            cancel_id = 0;
        }
        provider.removeRequestCancelHandler(opts, id);
        # an attempt that ends after the call is cancelled is reported as LLM-CANCELLED, as with callCancellable()
        if (*hash<ExceptionInfo> cancel_ex = provider.getRequestCancelledError(opts)) {
            finishError(cancel_ex);
            return;
        }
        if (!ex) {
            if (finish()) {
                success_cb(value);
            }
            return;
        }
        if (ex.err == "LLM-CANCELLED") {
            finishError(ex);
            return;
        }
        *int delay = provider.nextRetryDelay(\state, ex, opts);
        if (!exists delay) {
            finishError(ex.arg.typeCode() == NT_HASH
                ? AbstractLlmProvider::makeException(ex.err, ex.desc, ex.arg + {"retry": state.record})
                : ex);
            return;
        }
        # the wait is a timer of the async I/O controller; a cancellation ends it at once
        LlmAsyncRetry retry = self;
        LlmAsyncOperation o = op;
        int wait_seq;
        {
            AutoLock al(m);
            wait_seq = ++seq;
            waiting = True;
        }
        # made here, in a task of the operation: the cancellation handler runs in the thread of the code that cancels
        # (qore#7497)
        code<nothing()> wait_ended = sub () { retry.waitEnded(wait_seq); };
        int timer = Qore::AsyncIoController::addTimerDelay(delay, sub () {
            o.post(wait_ended);
        });
        {
            AutoLock al(m);
            if (!ended) {
                timer_id = timer;
                timer = 0;
            }
        }
        if (timer) {
            # the request ended while the timer was added
            Qore::AsyncIoController::cancelTimer(timer);
            return;
        }
        setCancelHandler(provider.addRequestCancelHandler(opts, sub () {
            o.post(wait_ended);
        }));
    }

    private:internal waitEnded(int wait_seq) {
        int id;
        int timer;
        {
            AutoLock al(m);
            if (ended || wait_seq != seq || !waiting) {
                return;
            }
            waiting = False;
            id = cancel_id;
            cancel_id = 0;
            timer = timer_id;
            timer_id = 0;
        }
        provider.removeRequestCancelHandler(opts, id);
        if (timer) {
            Qore::AsyncIoController::cancelTimer(timer);
        }
        # a cancelled wait ends the call with LLM-CANCELLED here
        runAttempt();
    }

    private:internal finishError(hash<ExceptionInfo> ex) {
        if (finish()) {
            error_cb(ex);
        }
    }

    #! Ends the request; returns False if it had already ended
    private:internal bool finish() {
        int id;
        int timer;
        {
            AutoLock al(m);
            if (ended) {
                return False;
            }
            ended = True;
            id = cancel_id;
            cancel_id = 0;
            timer = timer_id;
            timer_id = 0;
            remove abort;
        }
        provider.removeRequestCancelHandler(opts, id);
        if (timer) {
            Qore::AsyncIoController::cancelTimer(timer);
        }
        op.removeFinishHook(hook_id);
        return True;
    }

    #! Releases the request when the operation ends otherwise: aborts the attempt in flight
    release() {
        *code<nothing()> abort_attempt;
        {
            AutoLock al(m);
            abort_attempt = abort;
        }
        if (finish() && abort_attempt) {
            abort_attempt();
        }
    }
}
} # namespace Priv

} # namespace QoreLlmUtils
