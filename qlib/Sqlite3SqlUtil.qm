        private list<string> featuresImpl() {
            return (DB_TABLES, DB_VIEWS);
        }

        string getSchemaName() {
            return ds.getDBName();
        }

        private AbstractSequence makeSequenceImpl(string name, number start = 1, number increment = 1,
                *softnumber end, *hash<auto> opts) {
            throw "UNSUPPORTED";
        }

        private *AbstractSequence getSequenceImpl(string name) {
        }

        private *AbstractView getViewImpl(string name) {
            *hash<auto> row = ds.selectRow("select * from sqlite_schema where type = 'view' and name = %v", name);
            if (!row) {
                return;
            }

            return new Sqlite3View(name, row.sql);
        }

        private AbstractFunction makeFunctionImpl(string name, string src, *hash<auto> opts) {
            throw "UNSUPPORTED";
        }

        private AbstractFunction makeProcedureImpl(string name, string src, *hash<auto> opts) {
            throw "UNSUPPORTED";
        }

        private *AbstractFunction getFunctionImpl(string name) {
        }

        private *AbstractFunction getProcedureImpl(string name) {
        }

        private list<string> getDropSchemaSqlImpl(hash<auto> schema_hash, *hash<auto> opt) {
            return ();
        }

        private list<string> getAlignSqlImpl(hash schema_hash, *hash<auto> opt) {
            return ();
        }

        #! returns a list of string table names in the database
        private list<string> listTablesImpl() {
            return ds.select("select name from sqlite_schema where type = 'table'").name;
        }

        #! returns a list of string function names in the database
        /** The function names will include arguments in parentheses after the names

            @return a list of string function names in the database
        */
        private list<string> listFunctionsImpl() {
            return ();
        }

        #! returns a list of string procedure names in the database
        /** The procedure names will include arguments in parentheses after the names

            @return a list of string procedure names in the database
        */
        private list<string> listProceduresImpl() {
            return ();
        }

        private list<string> listSequencesImpl() {
            return ();
        }

        private list<string> listViewsImpl() {
            return ds.select("select name from sqlite_schema where type = 'view'").name;
        }

        private string getCreateSqlImpl(list<auto> l) {
            return Sqlite3Database::getCreateSql(l);
        }

        static string getCreateSql(list<auto> l) {
            return !l ? "" : foldl $1 + "\n" + $2, (map sprintf("%s%s", $1, $1 =~ /(;|\$)$/ ? "" : ";"), l);
        }

        #! returns the next value in the given sequence
        private softint getNextSequenceValueImpl(string name) {
            throw "SQLITE3-SEQUENCE-ERROR", "Sqlite3 does not support sequences";
        }

        #! returns the last value issued for the given sequence in the current session
        private softint getCurrentSequenceValueImpl(string name) {
            throw "SQLITE3-SEQUENCE-ERROR", "Sqlite3 does not support sequences";
        }

        #! returns @ref True "True" since we have a workaround implementation for sequences in Sqlite3
        private bool supportsSequencesImpl() {
            return False;
        }

        #! returns @ref True "True" as SQLite3 supports temporary tables (\c "create temp table")
        private bool supportsTempTablesImpl() {
            return True;
        }

        #! returns @ref True "True" if the database supports named types
        private bool supportsTypesImpl() {
            return False;
        }

        #! returns @ref True "True" if the database supports packages
        private bool supportsPackagesImpl() {
            return False;
        }

        #! rebuild index implementation. See @ref SqlUtil::AbstractDatabase::rebuildIndex()
        private bool rebuildIndexImpl(string name, *hash<auto> options) {
            throw "REBUILD-INDEX-ERROR", "Sqlite3 does not support index rebuilding";
        }

        #! compute statistics implementation. See @ref SqlUtil::AbstractDatabase::computeStatistics()
        private computeStatisticsImpl(*hash<auto> options) {
        }

        #! reclaim space implementation. See @ref SqlUtil::AbstractDatabase::reclaimSpace()
        private reclaimSpaceImpl(*hash<auto> options) {
        }

        #! @ref SqlUtil::AbstractDatabase.getPhysicalSize()
        private int getPhysicalSizeImpl() {
            throw "UNSUPPORTED";
        }
    }

    #! provides the Sqlite3-specific implementation of the AbstractTable interface
    public class Sqlite3Table inherits SqlUtil::AbstractTable {
        public {
            #! maps sqlite3 type names to type configurations
            const Sqlite3TypeMap = {
                "real": {
                    "qore": Type::Float,
                    "size": SZ_NUM,
                },
                "integer": {
                    "qore": Type::Int,
                    "ai": True,
                },
                "int": {
                    "qore": Type::Int,
                    "ai": True,
                },
                # SQLite does not limit the length of text: a size is accepted, as portable descriptions give one for
                # a string column, and is not part of the column (see @ref sqlite3_type_mapping)
                "text": {
                    "qore": Type::String,
                    "size": SZ_OPT,
                },
                "varchar": {
                    "qore": Type::String,
                    "size": SZ_OPT,
                },
                "blob": {
                    "qore": Type::Binary,
                },
            };

            #! maps qore type names to Sqlite3 type names
            const QoreTypeMap = (
                "integer": "int",
                "float": "real",
                "number": "text",
                "string": "text",
                "date": "text",
                "binary": "blob",
                "bool": "int",
                SqlUtil::CHAR: "text",
                SqlUtil::CLOB: "text",
                SqlUtil::BLOB: "blob",
            );

            #! column operator specializations for Sqlite3
            const Sqlite3CopMap = (
                COP_CAST: (
                    "code": string sub (string cve, list<auto> args) {
                        return sprintf("cast(%s as %s)", cve, QoreTypeMap{args[0]} ?? args[0]);
                    },
                ),
                COP_PREPEND: (
                    "arg": Type::String,
                    "sqlvalue": True,
                    "code": string sub (string cve, string arg) {
                        return sprintf("%s || %s", arg, cve);
                    },
                ),
                COP_APPEND: (
                    "arg": Type::String,
                    "sqlvalue": True,
                    "code": string sub (string cve, string arg) {
                        return sprintf("%s || %s", cve, arg);
                    },
                ),
            );

            #! expression map overrides for SQLite3
            const Sqlite3ExpressionMap = DefaultExpressionMap + {
                # --- Type conversions (SQLite-specific CAST types) ---
                # Inherit metadata from DefaultExpressionMap; provide SQLite-native code only.
                DP_OP_TO_STRING: DefaultExpressionMap{DP_OP_TO_STRING} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as text)", exp0);
                    },
                },
                DP_OP_TO_FLOAT: DefaultExpressionMap{DP_OP_TO_FLOAT} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as real)", exp0);
                    },
                },
                DP_OP_TO_NUMBER: DefaultExpressionMap{DP_OP_TO_NUMBER} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as numeric)", exp0);
                    },
                },
                # --- String manipulation (SQLite uses LENGTH, not CHAR_LENGTH) ---
                DP_OP_LENGTH: {
                    "exp": <DataProviderExpressionInfo>{
                        "type": DET_Operator,
                        "name": DP_OP_LENGTH,
                        "display_name": "length",
                        "short_desc": "Returns the character length of a string",
                        "desc": "Returns the number of characters in a string using SQLite length()",
                        "symbol": "length",
                        "groups": "Data Manipulation",
                        "args": (DataProviderSignatureAnyType,),
                        "return_type": AbstractDataProviderTypeMap."int",
                    },
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("length(%s)", info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any"));
                    },
                },
                # --- Date formatting (SQLite strftime) ---
                DP_FUNC_FORMAT_DATE: DefaultExpressionMap{DP_FUNC_FORMAT_DATE} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."date");
                        string fmt = Sqlite3Table::convertDateFormat(args[1]);
                        return sprintf("strftime('%s', %s)", fmt, exp0);
                    },
                },
                # SQLite LIKE is ASCII-case-insensitive by default. Use GLOB for case-sensitive LIKE semantics and
                # explicit upper() normalization when ignore-case is requested so behavior matches generic DPQL.
                DP_OP_LIKE: DefaultExpressionMap{DP_OP_LIKE} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        string glob = sprintf(
                            "replace(replace(replace(replace(replace(%s, '[', '[[]'), '*', '[*]'), "
                            "'?', '[?]'), '%%', '*'), '_', '?')", exp1);
                        return args[2]
                            ? sprintf("upper(%s) glob upper(%s)", exp0, glob)
                            : sprintf("%s glob %s", exp0, glob);
                    },
                },
                DP_OP_CONTAINS: DefaultExpressionMap{DP_OP_CONTAINS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        return args[2]
                            ? sprintf("instr(upper(%s), upper(%s)) > 0", exp0, exp1)
                            : sprintf("instr(%s, %s) > 0", exp0, exp1);
                    },
                },
                DP_OP_STARTS_WITH: DefaultExpressionMap{DP_OP_STARTS_WITH} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        return args[2]
                            ? sprintf("instr(upper(%s), upper(%s)) = 1", exp0, exp1)
                            : sprintf("instr(%s, %s) = 1", exp0, exp1);
                    },
                },
                DP_OP_ENDS_WITH: DefaultExpressionMap{DP_OP_ENDS_WITH} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        string glob = sprintf(
                            "replace(replace(replace(%s, '[', '[[]'), '*', '[*]'), '?', '[?]')", exp1);
                        return args[2]
                            ? sprintf("upper(%s) glob ('*' || upper(%s))", exp0, glob)
                            : sprintf("%s glob ('*' || %s)", exp0, glob);
                    },
                },
                # --- Regex operators (SQLite REGEXP + regexp_replace UDFs are registered
                #     by the qore sqlite3 driver). Metadata inherited from
                #     DefaultExpressionMap; only the SQL-generation code is DB-specific. ---
                DP_OP_REGEX_MATCH: DefaultExpressionMap{DP_OP_REGEX_MATCH} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        bool case_insensitive = exists args[2] && inlist("i", args[2]);
                        if (case_insensitive) {
                            return sprintf("%s REGEXP ('(?i)' || %s)", exp0, exp1);
                        }
                        return sprintf("%s REGEXP %s", exp0, exp1);
                    },
                },
                DP_OP_REGEX_NMATCH: DefaultExpressionMap{DP_OP_REGEX_NMATCH} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        bool case_insensitive = exists args[2] && inlist("i", args[2]);
                        if (case_insensitive) {
                            return sprintf("%s NOT REGEXP ('(?i)' || %s)", exp0, exp1);
                        }
                        return sprintf("%s NOT REGEXP %s", exp0, exp1);
                    },
                },
                DP_OP_REGEX_SUBST: DefaultExpressionMap{DP_OP_REGEX_SUBST} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        string exp2 = info.table.getExpressionArg(\info, role, args[2],
                            AbstractDataProviderTypeMap."string");
                        string flags = "";
                        if (exists args[3]) {
                            foreach auto opt in (args[3]) {
                                if (opt == "i" || opt == "g" || opt == "m" || opt == "s" || opt == "x") {
                                    flags += opt;
                                }
                            }
                        }
                        if (flags.val()) {
                            return sprintf("regexp_replace(%s, %s, %s, '%s')", exp0, exp1, exp2, flags);
                        }
                        return sprintf("regexp_replace(%s, %s, %s)", exp0, exp1, exp2);
                    },
                },
                # --- String functions (SQLite uses substr() not ANSI substring()) ---
                OP_SUBSTR: {
                    "exp": <DataProviderExpressionInfo>{
                        "type": DET_Operator,
                        "name": "substr",
                        "display_name": "substr",
                        "short_desc": "returns a substring from a string; args: string, int start char, "
                            "[int length]",
                        "desc": "returns a substring from a string; args: string, int start char, "
                            "[int length]",
                        "symbol": "substr",
                        "groups": "Data Manipulation",
                        "args": (
                            DataProviderSignatureStringType,
                            DataProviderSignatureIntValueType,
                            DataProviderSignatureOptionalIntValueType,
                        ),
                        "return_type": AbstractDataProviderTypeMap."string",
                    },
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."int");
                        if (!exists args[2]) {
                            return sprintf("substr(%s, %s)", exp0, exp1);
                        }
                        return sprintf("substr(%s, %s, %s)", exp0, exp1,
                            info.table.getExpressionArg(\info, role, args[2],
                                AbstractDataProviderTypeMap."int"));
                    },
                },
            };
        }

        constructor(AbstractDatasource ds, string name, *hash<auto> opts) : AbstractTable(ds, name, opts) {
        }

        #! returns the name of the table to be used in SQL (with a possible qualifiers for schema, etc)
        string getSqlName() {
            return name;
        }

        #! returns the column operator map for this object
        private hash getColumnOperatorMapImpl() {
            return Sqlite3CopMap;
        }

        #! SQLite has no row locks and no \c "for update" clause
        /** @throw FORUPDATE-NOT-SUPPORTED always: SQLite cannot lock the selected rows, and a select that asked for
            the lock must not run without it
        */
        private doForUpdate(reference<string> sql) {
            throw "FORUPDATE-NOT-SUPPORTED", sprintf("%s: database driver %y does not support row locking with the "
                "\"forupdate\" select option", getDesc(), ds.getDriverName());
        }

        #! Returns the expression map for SQLite3
        hash<auto> getExpressionMap() {
            return Sqlite3ExpressionMap;
        }

        private bool checkExistenceImpl() {
            *hash<auto> qh = ds.selectRow("select * from sqlite_schema where name = %v and type = 'table'", name);
            if (qh) {
                return inDb = True;
            }
            return False;
        }

        private softlist<auto> getDropSqlImpl(*hash<auto> opt) {
            if (opt.force || opt.cascade || opt.cascade_constraints) {
                throw "OPTION-ERROR", sprintf("%s: cascade table drop options are not supported by database driver %y",
                    getDesc(), ds.getDriverName());
            }
            return sprintf("drop table%s %s", opt.if_exists ? " if exists" : "", getSqlName());
        }

        private Columns describeImpl() {
            /*
            string sql = ds.selectRow("select sql from sqlite_master where type = 'table' and tbl_name = %v",
                name).sql;
            *string cols = (sql =~ x/\((.*)\)/)[0];
            if (cols) {
                list<string> l = cols.split(",");
                for (int i = 0; i < l.size(); ++i) {
                    string str = l[i];
                    if (str =~ /foreign key/) {
                        int pc = 0;
                        string fk = str;
                        while (True) {
                            # count to second close paren
                            int spc = (str =~ x/(\))/g).size();
                            if (spc) {
                                pc += spc;
                                if (pc == 2) {
                                    break;
                                }
                            }
                            ++i;
                            if (i == l.size()) {
                                throw "SQLITE3-ERROR", sprintf("unbalanced parens in sql: %y", sql);
                            }
                            str = l[i];
                            fk += str;
                        }
                        (string fk_cols, string other_table, string other_cols) =
                            (fk =~ x/foreign key\(([^\)]+)\) references ([^\)]+)\((.*)\)/);
                        Columns targ_columns = getReferencedTableColumnsUnlocked(other_table, opts.table_cache);
                        ForeignConstraintTarget fct(other_table, targ_columns.subset(other_cols.split(" ")));
                        list<string> fk_col_list = fk_cols.split(" ");
                        string fk_name = name + fk_col_list.join("_");
                        rv{fk_name} = new Sqlite3ForeignConstraint(fk_name, new Columns(columns{fk_col_list}), fct);
                    }
                }
            }
            */
            # get column descriptions
            *hash<auto> qh = ds.select("pragma table_info(%s)", name);
            if (!qh.name) {
                throw "TABLE-ERROR", sprintf("cannot retrieve table information for table %y in %y", name, dsdesc);
            }

            hash<string, AbstractColumn> rv;
            foreach hash<auto> row in (qh.contextIterator()) {
                row.type = row.type.lwr();
                auto defval = exists row.dflt_value && row.dflt_value !== NULL && row.dflt_value != "NULL"
                    ? row.dflt_value
                    : NOTHING;
                *hash<auto> th = Sqlite3TypeMap{row.type};
                if (exists defval) {
                    # process default value according to column type
                    switch (th.qore) {
                        case Type::Int: defval = defval.toInt(); break;
                        case Type::Float: defval = defval.toFloat(); break;
                        case Type::Number: defval = defval.toNumber(); break;
                        case Type::Date: {
                            try {
                                defval = date(defval);
                            } catch (hash<ExceptionInfo> ex) {
                                # ignore INVALID-DATE; keep text (ex: "CURRENT_TIMESTAMP")
                                if (ex.err != "INVALID-DATE") {
                                    rethrow;
                                }
                            }
                        }
                        case Type::String: {
                            if (defval =~ /^'.*'$/) {
                                defval = defval[1..(defval.size() - 2)];
                                defval =~ s/''/'/g;
                            }
                            break;
                        }
                        # don't know what to do with Type::Binary ???
                        default: break;
                    }
                    defval = getSqlValue(defval);
                }
                bool auto_increment = (row.type =~ / auto_increment/);
                if (auto_increment) {
                    row.type =~ s/ auto_increment//;
                }
                bool primary_key = (row.type =~ / primary_key/);
                if (primary_key) {
                    row.type =~ s/ primary_key//;
                }

                Sqlite3Column c(row.name, row.type, th.qore, !row.notnull, defval, auto_increment, primary_key);
                rv{row.name} = c;
            }

            return new Columns(rv);
        }

        #! returns no SQL: the primary key is created with the table (@ref getCreateTableSqlImpl())
        private *string getCreatePrimaryKeySqlUnlocked(*hash<auto> opt, bool cache = True) {
        }

        private Sqlite3PrimaryKey getPrimaryKeyImpl() {
            # pragma table_info gives each primary key column its 1-based position in the key; a table
            # without a declared primary key has none (its rowid is not one)
            *hash<auto> qh = ds.select("pragma table_info(%s)", name);
            hash<string, string> key_columns;
            foreach hash<auto> row in (qh.contextIterator()) {
                if (row.pk.toInt() > 0) {
                    key_columns{sprintf("%06d", row.pk.toInt())} = row.name;
                }
            }
            if (!key_columns) {
                return new Sqlite3PrimaryKey();
            }
            hash<auto> rv;
            foreach string position in (sort(keys key_columns)) {
                string col = key_columns{position};
                rv{col} = columns{col};
            }
            return new Sqlite3PrimaryKey(rv);
        }

        #! describes each index of the table from SQLite's index pragmas
        /** pragma index_list and index_xinfo describe every index, including those that SQLite creates itself for a
            primary key or a unique constraint, which have no SQL, so no index SQL has to be parsed

            @return a list of one hash per index: \c name, \c unique, \c origin (\c "c" for an index created by
            \c CREATE \c INDEX, \c "u" for the automatic index of a unique constraint created with the table,
            \c "pk" for the automatic index of a primary key), \c partial, \c columns (the key columns in the
            index's order), \c collations (the collation of each column that has one other than \c BINARY) and
            \c expression (@ref True "True" if a key of the index is an expression, not a column)
        */
        private list<hash<auto>> getIndexInfo() {
            list<hash<auto>> rv = ();
            *hash<auto> index_list = ds.select("pragma index_list(%s)", name);
            # by name, so that a table is described the same way whatever order SQLite keeps its indexes in
            list<hash<auto>> index_rows = map $1, index_list.contextIterator();
            foreach hash<auto> il in (sort(index_rows, int sub (hash<auto> l, hash<auto> r) {
                    return l.name <=> r.name;
                })) {
                hash<auto> ix = {
                    "name": il.name,
                    "unique": il.unique.toBool(),
                    "origin": il.origin,
                    "partial": il.partial.toBool(),
                    "columns": {},
                    "expression": False,
                };
                *hash<auto> info = ds.select("pragma index_xinfo(%s)", il.name);
                foreach hash<auto> ii in (info.contextIterator()) {
                    if (!ii.key.toInt()) {
                        continue;
                    }
                    # an expression has no column name
                    if (ii.name.typeCode() != NT_STRING) {
                        ix.expression = True;
                        continue;
                    }
                    ix.columns{ii.name} = columns{ii.name};
                    if (ii.coll.typeCode() == NT_STRING && ii.coll.upr() != "BINARY") {
                        ix.collations{ii.name} = ii.coll;
                    }
                }
                rv += ix;
            }
            return rv;
        }

        private Indexes getIndexesImpl() {
            hash<auto> rv;
            foreach hash<auto> ix in (getIndexInfo()) {
                # the automatic index of the primary key or of a unique constraint created with the table is part of
                # the key or constraint: it is described by getPrimaryKeyImpl() or getConstraintsImpl()
                if (ix.origin == "pk" || ix.origin == "u") {
                    continue;
                }
                *hash<string, string> collations = ix.collations;
                rv{ix.name} = new Sqlite3Index(ix.name, ix.unique, ix.columns, collations);
            }
            return new Indexes(rv);
        }

        #! describes the foreign constraints of the table from SQLite's foreign key pragma
        /** SQLite does not report the name of a foreign constraint, so each is named
            <tt>sqlite_fk_</tt><em>n</em> by its number in the pragma (see @ref sqlite3_foreign_constraints); a table
            is aligned to a template by the definitions of its foreign constraints, not by their names
        */
        private ForeignConstraints getForeignConstraintsImpl(*hash<auto> opts) {
            # pragma foreign_key_list gives one row per column of each constraint: its number (id), the column's
            # position in the constraint (seq), the referenced table, the column (from) and the referenced column
            # (to), which is null when the constraint references the primary key of the table
            *hash<auto> qh = ds.select("pragma foreign_key_list(%s)", name);
            hash<string, hash<auto>> fks;
            foreach hash<auto> row in (qh.contextIterator()) {
                string id = sprintf("%06d", row.id.toInt());
                string pos = sprintf("%06d", row.seq.toInt());
                fks{id}.table = row.table;
                fks{id}.columns{pos} = row.from;
                if (exists row.to && row.to !== NULL) {
                    fks{id}.target_columns{pos} = row.to;
                }
            }
            hash<string, AbstractForeignConstraint> rv;
            foreach string id in (sort(keys fks)) {
                hash<auto> fk = fks{id};
                list<string> cols = map fk.columns{$1}, sort(keys fk.columns);
                Columns targ_columns = getReferencedTableColumnsUnlocked(fk.table, opts.table_cache);
                list<string> target_cols;
                if (fk.target_columns) {
                    target_cols = map fk.target_columns{$1}, sort(keys fk.target_columns);
                } else {
                    # the constraint references the primary key of the referenced table
                    Table target(ds, fk.table);
                    target_cols = target.getPrimaryKey().keys();
                }
                string fk_name = sprintf("sqlite_fk_%d", id.toInt());
                rv{fk_name} = new Sqlite3ForeignConstraint(fk_name, columns.subset(cols),
                    new ForeignConstraintTarget(fk.table, targ_columns.subset(target_cols)));
            }
            return new ForeignConstraints(rv);
        }

        #! returns no SQL: the foreign constraints are created with the table (@ref getCreateTableSqlImpl())
        private *list<auto> getCreateForeignConstraintsSqlUnlocked(*hash<auto> opt, bool cache = True) {
        }

        #! returns no SQL: the unique constraints are created with the table or with their unique index
        /** A unique constraint is written in the table's \c CREATE \c TABLE statement (@ref getCreateTableSqlImpl()),
            and one that is a unique index of the table is created with the index
        */
        private *list<auto> getCreateConstraintsSqlUnlocked(*hash<auto> opt, bool cache = True) {
        }

        #! describes the unique constraints of the table from SQLite's index pragmas
        /** A unique constraint created with the table is enforced by an automatic unique index, which is described as
            the constraint, named as SQLite names the index
            (<tt>sqlite_autoindex_</tt><em>table</em><tt>_</tt><em>n</em>), as SQLite does not report the name of the
            constraint; it cannot be dropped.  A unique index on columns is also a unique constraint of the table,
            which has the index's name and can be dropped with the index; see @ref sqlite3_unique_constraints
        */
        private Constraints getConstraintsImpl() {
            hash<auto> rv;
            foreach hash<auto> ix in (getIndexInfo()) {
                # a partial unique index or one on an expression is not a unique constraint of its columns
                if (!ix.unique || ix.partial || ix.expression || !ix.columns) {
                    continue;
                }
                if (ix.origin == "u") {
                    rv{ix.name} = new Sqlite3UniqueConstraint(ix.name, ix.columns, True);
                } else if (ix.origin == "c") {
                    rv{ix.name} = new Sqlite3UniqueConstraint(ix.name, ix.columns, False, ix.name);
                }
            }
            return new Constraints(rv);
        }

        private Triggers getTriggersImpl() {
            hash rv;
            /*
            # get trigger description
            *hash qh = ds.select("");

            foreach hash<auto> row in (qh.contextIterator()) {
                string src = sprintf("%s %s on %s for each %s %s", row.action_timing.lwr(), row.event_manipulation.lwr(), name, row.action_orientation.lwr(), row.action_statement);
                rv{row.trigger_name} = new Sqlite3Trigger(row.trigger_name, src);
            }
            */
            return new Triggers(rv);
        }

        string getCreateTableSqlImpl(*hash<auto> opt) {
            string sql = sprintf("%s (\n", getCreateTableStartSql());
            list<string> defs = map "  " + $1.getCreateSql(self), columns.iterator();
            # SQLite cannot add a primary key to an existing table, so it is created with the table
            getPrimaryKeyUnlocked();
            if (!primaryKey.empty()) {
                defs += "  " + cast<Sqlite3PrimaryKey>(primaryKey).getTableConstraintSql();
            }
            # nor a unique constraint: one that is a unique index is created with its index
            getConstraintsUnlocked();
            defs += map "  " + cast<Sqlite3UniqueConstraint>($1).getTableConstraintSql(), constraints.iterator(),
                $1 instanceof Sqlite3UniqueConstraint && !cast<Sqlite3UniqueConstraint>($1).getIndex();
            # nor a foreign constraint
            if (!opt.omit.foreign_constraints) {
                getForeignConstraintsUnlocked(opt);
                defs += map "  " + cast<Sqlite3ForeignConstraint>($1).getTableConstraintSql(),
                    foreignConstraints.iterator();
            }
            sql += foldl $1 + ",\n" + $2, defs;
            sql += "\n)";
            sql += getCreateTableTempClauseSql();
            return sql;
        }

        #! returns \c "create temp table <name>" for temporary tables, \c "create table <name>" otherwise
        private string getCreateTableStartSql() {
            if (isTempTable()) {
                return sprintf("create temp table %s", name);
            }
            return AbstractTable::getCreateTableStartSql();
        }

        #! returns @ref False "False" because the sqlite3 driver does not support array binds / bulk DML operations
        bool hasArrayBind() {
            return False;
        }

        private *list getCreateMiscSqlImpl(*hash<auto> opt, bool cache) {
        }

        private *list getAlignSqlImpl(AbstractTable table, *hash<auto> opt) {
        }

        #! refuses the changes of an alignment that SQLite cannot make with any version, before a column is aligned
        /** SQLite cannot add a primary key or a foreign constraint to an existing table, cannot change or replace a
            unique constraint that a table was created with, and cannot change a column of an existing table other
            than its \c NOT \c NULL constraint, with any version; it can change the \c NOT \c NULL constraint from
            SQLite 3.53.0.  So these changes are refused here, before the columns are aligned, and an alignment that
            makes one of them reports it with every SQLite version, not a \c NOT \c NULL change that an older SQLite
            cannot make, such as the one that a new primary key implies for its columns; see
            @ref sqlite3_alignment_refusals

            A primary key that the template does not have, or has with other columns, and a foreign constraint or a
            unique constraint that the template does not have, have already been refused by the alignment, which
            drops them before this method is called.

            @param t the template table that the current table is aligned to
            @param opt the alignment options

            @throw UNSUPPORTED the alignment adds a primary key or a foreign constraint to the table, changes a foreign
            constraint, changes a unique constraint that the table was created with or replaces it with a unique
            index, or changes a column other than its \c NOT \c NULL constraint

            @since Sqlite3SqlUtil 1.2
        */
        private checkAlignChangesImpl(AbstractTable t, *hash<auto> opt) {
            string table_name = getSqlName();
            # the SQL of each change is requested here only for the exception that the alignment would raise for it
            # after the columns; a change that SQLite can make gives SQL, which the alignment requests again

            # a primary key in SQLite has no name, so the alignment has refused to drop a key other than the
            # template's: the table has the template's key, or none
            @assert(primaryKey.empty() || primaryKey.equal(t.primaryKey));
            if (primaryKey.empty() && !t.primaryKey.empty()) {
                t.primaryKey.getCreateSql(table_name, opt);
            }

            if (!opt.omit.foreign_constraints) {
                foreach AbstractForeignConstraint fk in (t.foreignConstraints.iterator()) {
                    string fk_name = fk.getName();
                    if (!foreignConstraints.hasKey(fk_name)) {
                        fk.getCreateSql(table_name, opt);
                    } else if (!fk.equal(foreignConstraints{fk_name})) {
                        foreignConstraints{fk_name}.getDropSql(table_name);
                    }
                }
            }

            # a unique constraint that the table was created with cannot be changed, nor be replaced by a unique index
            # of the template on its columns, which the alignment has matched it to by its columns; a unique
            # constraint that is a unique index can be (and one that the template does not have has been refused)
            foreach AbstractConstraint c in (constraints.iterator()) {
                if (!(c instanceof Sqlite3UniqueConstraint)) {
                    continue;
                }
                Sqlite3UniqueConstraint uk = cast<Sqlite3UniqueConstraint>(c);
                string uk_name = uk.getName();
                if (!uk.isTableConstraint() || !t.constraints.hasKey(uk_name)) {
                    continue;
                }
                AbstractConstraint template_uk = t.constraints{uk_name};
                if (!template_uk.equal(uk) || cast<AbstractUniqueConstraint>(template_uk).getIndex()) {
                    uk.getDropSql(table_name);
                }
            }

            foreach AbstractColumn c in (t.columns.iterator()) {
                if (columns.hasKey(c.name)) {
                    cast<Sqlite3Column>(columns{c.name}).checkModify(self, c);
                }
            }
        }

        private string getCreateSqlImpl(list l) {
            return Sqlite3Database::getCreateSql(l);
        }

        private string getRenameSqlImpl(string new_name) {
            return sprintf("alter table %s rename to %s", getSqlName(), new_name);
        }

        private AbstractColumn addColumnImpl(string cname, hash<auto> opt, bool nullable = True) {
            return new Sqlite3Column(cname, opt.native_type, opt.qore_type, nullable, opt.default_value,
                opt.auto_increment ?? False, opt.pk ?? False);
        }

        private setPrimaryKeyUnlocked(AbstractPrimaryKey pk) {
            AbstractTable::setPrimaryKeyUnlocked(pk);
            if (pk.size() == 1 && columns.hasKey(pk.getName())) {
                Sqlite3Column c = columns{pk.getName()};
                if (c.auto_increment && !c.primary_key) {
                    c.primary_key = True;
                }
            }
        }

        private addColumnToTableUnlocked(AbstractColumn c) {
            AbstractTable::addColumnToTableUnlocked(c);
            Sqlite3Column col = c;
            if (col.auto_increment) {
                Sqlite3Index ix;
                # see if a unique index already exists with this name
                if (indexes.hasKey(c.name)) {
                    ix = indexes{c.name};
                    if (!ix.unique)
                        throw "AUTO-INCREMENT-ERROR", sprintf("column %y.%y which has \"auto-increment\" set and is "
                            "also flagged as a unique index for the table does not match with the existing index's "
                            "definition which is not unique; columns: %y", name, c.name, ix.columns.keys());
                    if (ix.columns.size() > 1 || ix.columns.firstKey() != c.name)
                        throw "AUTO-INCREMENT-ERROR", sprintf("column %y.%y which has \"auto-increment\" set and is also flagged as a unique index for the table does not match with the existing index's column definition: %y", name, c.name, ix.columns.keys());
                }

                AbstractUniqueConstraint uk;
                if (col.primary_key) {
                    # add primary key if not present
                    if (!primaryKey.empty()) {
                        if (primaryKey.size() > 1 || primaryKey.firstKey() != c.name)
                            throw "AUTO-INCREMENT-ERROR", sprintf("column %y.%y which has \"auto-increment\" set and is also flagged as a primary key for the table does not match with the existing primary key column definition: %y", name, c.name, primaryKey.keys());
                    } else
                        primaryKey @= new Sqlite3PrimaryKey(columns{c.name,});
                    uk = primaryKey;
                } else {
                    # see if a unique constraint already exists with this name
                    if (constraints.hasKey(c.name)) {
                        if (!(constraints{c.name} instanceof AbstractUniqueConstraint))
                            throw "AUTO-INCREMENT-ERROR", sprintf("column %y.%y which has \"auto-increment\" set and is also flagged as a unique constraint for the table does not match with the existing constraint type: %y", name, c.name, constraints{c.name}.className());

                        uk = constraints{c.name};
                        if (uk.size() > 1 || uk.firstKey() != c.name)
                            throw "AUTO-INCREMENT-ERROR", sprintf("column %y.%y which has \"auto-increment\" set and is also flagged as a unique constraint for the table does not match with the existing unique constraint's column definition: %y", name, c.name, uk.keys());
                    } else {
                        if (!constraints)
                            constraints @= new Constraints();
                        uk = new Sqlite3UniqueConstraint(c.name, columns.(list(c.name)));
                        constraints.add(c.name, uk);
                    }
                }
                if (ix)
                    uk.setIndexBase(c.name);
            }
        }

        private AbstractPrimaryKey addPrimaryKeyImpl(string cname, hash<auto> ch, *hash<auto> opt) {
            return new Sqlite3PrimaryKey(ch);
        }

        private AbstractIndex addIndexImpl(string iname, bool enabled, hash<auto> ch, *hash<auto> opt) {
            # SQLite has no USING / WITH / opclass concept on CREATE INDEX
            if (opt.method.val() || opt.with || opt.opclass) {
                throw "INDEX-OPTION-ERROR", sprintf("index %y: generic index options method/with/opclass "
                    "are not supported on SQLite", iname);
            }
            return new Sqlite3Index(iname, enabled, ch);
        }

        private AbstractForeignConstraint addForeignConstraintImpl(string cname, hash<auto> ch, string table,
                hash<auto> tch, *hash<auto> opt) {
            ForeignConstraintTarget fct(table, new Columns(tch));
            return new Sqlite3ForeignConstraint(cname, new Columns(ch), fct);
        }

        private AbstractCheckConstraint addCheckConstraintImpl(string cname, string src, *hash<auto> opt) {
            throw "SQLITE3-CHECK-CONSTRAINT-ERROR", sprintf("Sqlite3 does not support check constraints");
        }

        private AbstractUniqueConstraint addUniqueConstraintImpl(string cname, hash<auto> ch, *hash<auto> opt) {
            return new Sqlite3UniqueConstraint(cname, ch);
        }

        private AbstractTrigger addTriggerImpl(string tname, string src, *hash<auto> opt) {
            return new Sqlite3Trigger(tname, src);
        }

        private bool tryInsertImpl(string sql, hash<auto> row) {
            try {
                ds.vexec(sql, row.values());
            } catch (hash<ExceptionInfo> ex) {
                if (isDuplicateRowError(ex)) {
                    return False;
                }
                rethrow;
            }
            return True;
        }

        #! Returns True if the exception was raised because of a duplicate row / key error
        /** @since Sqlite3SqlUtil 1.4.2
        */
        private bool isDuplicateRowErrorImpl(hash<ExceptionInfo> ex) {
            # the sqlite3 driver reports SQLite's extended result code: a primary key or unique constraint
            # violation is a duplicate row
            if (ex.arg.typeCode() == NT_HASH && exists ex.arg.extended_code) {
                return inlist(ex.arg.extended_code, (SQLITE_CONSTRAINT_PRIMARYKEY, SQLITE_CONSTRAINT_UNIQUE));
            }
            # drivers that predate the result codes report only SQLite's own (engine-defined) message
            return ex.desc.typeCode() == NT_STRING && (ex.desc =~ /UNIQUE constraint failed: /);
        }

        private hash<auto> getQoreTypeMapImpl() {
            return QoreTypeMap;
        }

        private hash<auto> getTypeMapImpl() {
            return Sqlite3TypeMap;
        }

        #! returns a string for use in SQL queries representing the DB-specific value of the argument; returns NOTHING if the type cannot be converted to an SQL string
        private *string getSqlValueImpl(auto v) {
            return Sqlite3Table::getSqlValueIntern(v);
        }

        #! returns a string for use in SQL queries representing the DB-specific value of the argument; returns NOTHING if the type cannot be converted to an SQL string
        private static *string getSqlValueIntern(auto v) {
            switch (v.typeCode()) {
                case NT_FLOAT:
                case NT_INT: return v.toString();

                case NT_NUMBER: return string(v);

                # double any single quotes in strings
                case NT_STRING: v =~ s/'/''/g; return "'" + v + "'";

                case NT_NULL:
                case NT_NOTHING: return "null";

                case NT_BOOLEAN: return v ? "true" : "false";

                case NT_DATE: {
                    # Sqlite3 does not allow us to specify the UTC offset in the timestamp literal :(
                    TimeZone tz = TimeZone::get();
                    v = tz.date(v);
                    return "timestamp " + v.format("'YYYY-MM-DDTHH:mm:SS.us'");
                }
            }
        }

        #! returns the column name for use in SQL strings; subclasses can return a special string in case the column name is a reserved word
        /** Sqlite3/MariaDB etc require column names to be enclosed in backticks instead of double quotes
        */
        string getColumnSqlName(string col) {
            return Sqlite3Database::Sqlite3ReservedWords{col.lwr()} ? ("`" + col + "`") : col;
        }

        #! returns a list of column names for use in SQL strings; subclasses can process the argument list in case a column name is a reserved word
        list<string> getColumnSqlNames(softlist<auto> cols) {
            return map getColumnSqlName($1), cols;
        }

        #! returns a string for use in SQL queries representing the DB-specific value of the argument
        /** @par Example:
            @code{.py}
string str = table.getSqlValue(date);
            @endcode

            @param v the value to convert to an SQL value

            @return a string representing the value usable in SQL strings for the given database driver

            @throw VALUE-ERROR the given value cannot be converted to an SQL string (missing rules for value)
         */
        static *string getSqlValue(auto v) {
           *string str = Sqlite3Table::getSqlValueIntern(v);
            if (!exists str)
                throw "VALUE-ERROR", sprintf("class Sqlite3Table cannot convert type %y to an SQL string (value: %y)", v.type(), v);
            return str;
        }

        #! Converts a Qore/DPQL date format string to a SQLite strftime() format string
        /** @param fmt the Qore date format string (e.g., "YYYY-MM-DD HH:mm:SS.us")
            @return the equivalent SQLite strftime() format string (e.g., "%Y-%m-%d %H:%M:%S.%f")

            @since Sqlite3SqlUtil 1.1
        */
        static string convertDateFormat(string fmt) {
            # replace longer tokens first to avoid partial matches (YYYY before YY)
            fmt = regex_subst(fmt, "YYYY", "%Y", RE_Global);
            fmt = regex_subst(fmt, "YY(?!YY)", "%y", RE_Global);
            fmt = regex_subst(fmt, "MM", "%m", RE_Global);
            fmt = regex_subst(fmt, "DD", "%d", RE_Global);
            fmt = regex_subst(fmt, "HH", "%H", RE_Global);
            fmt = regex_subst(fmt, "mm", "%M", RE_Global);
            fmt = regex_subst(fmt, "SS", "%S", RE_Global);
            fmt = regex_subst(fmt, "us", "%f", RE_Global);
            fmt = regex_subst(fmt, "ms", "%f", RE_Global);
            # escape single quotes for safe SQL embedding
            fmt = regex_subst(fmt, "'", "''", RE_Global);
            return fmt;
        }

        private bool emptyImpl() {
            return True;
        }

        private preSetupTableImpl(reference<hash> desc, *hash<auto> opt) {
            # see if there is an auto-increment column and set the primary key flag if it matches the primary key declaraion
            foreach string k in (desc.columns.keyIterator()) {
                if (desc.columns{k}.auto_increment) {
                    if (!desc.columns{k}.pk) {
                        if (desc.primary_key.columns.lsize() == 1) {
                            softlist cl = desc.primary_key.columns;
                            if (cl[0] == k) {
                                desc.columns{k}.pk = True;
                                # delete the primary key description; it will be added again when the column is added
                                delete desc.primary_key;
                            }
                        }
                    }
                    break;
                }
            }
        }

        private setupTableImpl(hash<auto> desc, *hash<auto> opt) {
        }

        #! returns @ref True "True" if the database links constraints to indexes (ie dropping the constraint drops the index, etc)
        private bool constraintsLinkedToIndexesImpl() {
            return True;
        }

        #! returns @ref False "False": SQLite drops a key or index that a foreign constraint references
        /** SQLite checks a foreign constraint's key only when a row is written, so a schema alignment does not drop
            the foreign constraints that reference a key or index before it drops or recreates it; SQLite cannot drop
            a foreign constraint of an existing table anyway
        */
        private bool foreignConstraintsDependOnKeysImpl() {
            return False;
        }

        #! returns @ref True "True" if the database automatically creates a unique constraint when a unique index is created (ex: sqlite3)
        private bool uniqueIndexCreatesConstraintImpl() {
            return True;
        }

        #! returns @ref True "True" if the database support tablespaces
        private bool supportsTablespacesImpl() {
            return False;
        }

        #! SQLite accepts non-unique orderby + offset/limit at the SQL level;
        #! the determinism check in AbstractTable is overly strict here.
        /** Pagination across orderby ties may still yield non-deterministic
            ordering — that's the caller's concern, not a SQL-validity issue.
        */
        bool requireUniqueOrderByWithOffsetLimit() {
            return False;
        }

        #! processes a string for use in SQL select statements when there is a "limit" argument, but no "orderby" or "offset" arguments
        private doSelectLimitOnlyInternImpl(reference<hash<QueryInfo>> info, reference<string> sql) {
           sql += " limit %v";
           info.args += info.query_hash.limit.toInt();
        }

        #! processes a string for use in SQL select statements when there is an "order by" and "offset" argument
        private doSelectOrderByWithOffsetSqlInternImpl(reference<hash<QueryInfo>> info, reference<string> sql,
                list<auto> coll) {
            doSelectOrderBySqlIntern(info, \sql, coll);
            if (info.query_hash.limit) {
                sql += " limit %v";
                info.args += info.query_hash.limit.toInt();
            }

            if (info.query_hash.offset) {
                sql += " offset %v";
                info.args += info.query_hash.offset.toInt();
            }
        }

        #! returns @ref True if the database requires a wildcard \c "*" to be prefixed with the table name when it appears with other column arguments in a select statement
        private bool asteriskRequiresPrefix() {
            return True;
        }

        private *hash<auto> doReturningImpl(hash<auto> opt, reference<string> sql, list<auto> args) {
            throw "RETURNING-ERROR", sprintf("table %s: the sqlite3 driver does not support the returning clause "
                "in an insert statement", getSqlName());
        }

        private list<auto> getGroupOrderByListUnlocked(hash<QueryInfo> info, string key, list<auto> coll) {
            list<auto> ce = ();
            foreach auto cv in (info.query_hash{key}) {
                switch (cv.typeCode()) {
                    case NT_STRING: {
                        if (cv.toInt() == cv) {
                            ce += cv;
                        } else {
                            ce += getColumnNameIntern(info, cv);
                        }
                        break;
                    }

                    case NT_HASH: {
                        ce += doColumnOperatorIntern(\info, cv);
                        break;
                    }

                    case NT_INT: {
                        ce += cv.toString();
                        break;
                    }

                    default:
                        throw "SELECT-ERROR", sprintf("%s: don't know how to parse argument type %y (value: %y) in "
                            "%s list, expecting \"string\" or \"hash\"", getDesc(), cv.type(), cv, key);
                }
            }
            return ce;
        }

        #! returns @ref True "True" if the current database driver supports the \c "returning" clause in insert statements, @ref False "False" if not
        bool hasReturningImpl() {
            return False;
        }

        #! db-specific copy actions
        private copyImpl(AbstractTable old) {
        }

        #! returns the type for number / numeric columns for the database so that data conversions can be handled
        private AbstractDataProviderType getNumericTypeImpl(string native_type, bool nullable, *hash<auto> options) {
            return AbstractDataProviderType::get(FloatType);
        }

        #! get DB-specific savepoint helper
        /** @param savepoint the savepoint string, if not given a unique savepoint string will be generated

            @since SqlUtil 1.6
        */
        private AbstractSavepointHelper getSavepointHelperImpl(*string savepoint) {
            return new Sqlite3SavepointHelper(ds, savepoint);
        }
    }
