%requires qore >= 2.0
%requires Util

%modern

module HttpUtil {
    version = "1.0";
    desc = "Shared HTTP client and server utilities: cookies (RFC 6265) and redirects (RFC 9110)";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage HttpUtil Module

    @tableofcontents

    @section httputilintro HttpUtil Module Introduction

    The %HttpUtil module provides shared HTTP utility functions used by both
    the HTTP server (<a href="../../HttpServerUtil/html/index.html">HttpServerUtil</a>) and HTTP client (<a href="../../HttpClientIo/html/index.html">HttpClientIo</a>)
    modules.

    Currently provides RFC 6265 cookie handling:
    - @ref HttpUtil::CookieInfo "CookieInfo" hashdecl for cookie representation
    - @ref HttpUtil::parse_cookie() "parse_cookie()" for parsing Set-Cookie headers
    - @ref HttpUtil::format_set_cookie() "format_set_cookie()" for formatting Set-Cookie headers
    - @ref HttpUtil::set_cookie_header() "set_cookie_header()" for setting cookies on response headers
    - @ref HttpUtil::domain_matches() "domain_matches()" for RFC 6265 domain matching
    - @ref HttpUtil::path_matches() "path_matches()" for RFC 6265 path matching
    - @ref HttpUtil::compute_default_path() "compute_default_path()" for computing default cookie paths

    It also provides @ref HttpUtil::HttpRedirectFollower "HttpRedirectFollower", which implements the redirect rules
    that all HTTP clients follow (RFC 9110 section 15.4), so that every client that follows redirects handles them the
    same way, and @ref HttpUtil::HttpAuthenticator "HttpAuthenticator", which answers Basic (RFC 7617) and Digest
    (RFC 7616) authentication challenges.

    @section httputilrelnotes Release Notes

    @subsection httputil_1_0 HttpUtil 1.0
    - initial release
    - added @ref HttpUtil::HttpRedirectFollower "HttpRedirectFollower" and
      @ref HttpUtil::HttpAuthenticator "HttpAuthenticator"
*/

#! Main namespace for shared HTTP utilities
public namespace HttpUtil {

#! Cookie representation (RFC 6265)
/** Used for both parsing Set-Cookie headers (client side) and formatting
    Set-Cookie headers (server side).
*/
public hashdecl CookieInfo {
    #! Cookie name (required)
    string name;

    #! Cookie value (NOTHING when deleting a cookie via Max-Age=0)
    *string value;

    #! Domain for matching (lowercase; NOTHING = origin-only)
    *string domain;

    #! Path for matching
    string path = "/";

    #! Maximum age in seconds (NOTHING = session cookie; 0 = delete)
    *int max_age;

    #! Absolute expiry time (NOTHING = session cookie)
    /** Computed from max_age during parsing, or parsed from Expires attribute.
    */
    *date expires;

    #! Only send over HTTPS
    bool secure = False;

    #! HTTP-only (not accessible to JavaScript)
    bool http_only = False;

    #! SameSite attribute (Lax, Strict, None, or NOTHING if not set)
    *string same_site;

    #! Creation timestamp (set during parsing)
    *date created;
}

#! Parses a Set-Cookie header value into a CookieInfo hash
/** @param cookie_str the Set-Cookie header value (e.g., "name=value; Path=/; Max-Age=3600")
    @param default_domain the request host (used if no Domain attribute)
    @param default_path the request path (used to compute default path per RFC 6265 Section 5.1.4)

    @return the parsed cookie info, or NOTHING if the header is invalid
*/
public *hash<CookieInfo> sub parse_cookie(string cookie_str, string default_domain,
        string default_path) {
    list<string> parts = cookie_str.split(";");
    if (!parts) {
        return NOTHING;
    }

    # First part is name=value
    string nv = trim(parts[0]);
    int eq_pos = nv.find("=");
    if (eq_pos < 0) {
        return NOTHING;
    }
    string name = trim(nv.substr(0, eq_pos));
    string value = trim(nv.substr(eq_pos + 1));
    if (!name) {
        return NOTHING;
    }

    hash<CookieInfo> entry = <CookieInfo>{
        "name": name,
        "value": value,
        "domain": default_domain.lwr(),
        "path": compute_default_path(default_path),
        "created": now_us(),
    };

    # Parse attributes
    for (int i = 1; i < parts.size(); ++i) {
        string attr = trim(parts[i]);
        int attr_eq = attr.find("=");
        string attr_name;
        *string attr_value;
        if (attr_eq >= 0) {
            attr_name = trim(attr.substr(0, attr_eq)).lwr();
            attr_value = trim(attr.substr(attr_eq + 1));
        } else {
            attr_name = attr.lwr();
        }

        if (attr_name == "domain") {
            if (exists attr_value) {
                # Remove leading dot (RFC 6265 Section 5.2.3)
                string dom = attr_value.lwr();
                if (dom[0] == ".") {
                    dom = dom.substr(1);
                }
                entry.domain = dom;
            }
        } else if (attr_name == "path") {
            if (exists attr_value && attr_value[0] == "/") {
                entry.path = attr_value;
            }
        } else if (attr_name == "max-age") {
            if (exists attr_value) {
                int max_age_val = attr_value.toInt();
                entry.max_age = max_age_val;
                if (max_age_val <= 0) {
                    entry.expires = 1970-01-01T00:00:00Z;
                } else {
                    entry.expires = now_us() + seconds(max_age_val);
                }
            }
        } else if (attr_name == "expires") {
            # Only use Expires if Max-Age wasn't set
            if (entry.expires.typeCode() != NT_DATE && exists attr_value) {
                try {
                    entry.expires = date(attr_value);
                } catch () {
                    # Ignore unparseable dates
                }
            }
        } else if (attr_name == "secure") {
            entry.secure = True;
        } else if (attr_name == "httponly") {
            entry.http_only = True;
        } else if (attr_name == "samesite") {
            if (exists attr_value) {
                entry.same_site = attr_value;
            }
        }
    }

    return entry;
}

#! Formats a CookieInfo into a Set-Cookie header string
/** @param cookie the cookie to format
    @return the Set-Cookie header value string

    @throw COOKIE-ERROR if the cookie name is empty
*/
public string sub format_set_cookie(hash<CookieInfo> cookie) {
    if (!cookie.name) {
        throw "COOKIE-ERROR", "cookie name cannot be empty";
    }

    string hdr = sprintf("%s=%s", cookie.name, cookie.value ?? "");

    if (exists cookie.same_site) {
        hdr += sprintf("; SameSite=%s", cookie.same_site);
    }
    hdr += sprintf("; Path=%s", cookie.path);
    if (cookie.secure) {
        hdr += "; Secure";
    }
    if (exists cookie.domain) {
        hdr += sprintf("; Domain=%s", cookie.domain);
    }
    if (cookie.http_only) {
        hdr += "; HttpOnly";
    }
    if (exists cookie.max_age) {
        hdr += sprintf("; Max-Age=%d", cookie.max_age);
    } else if (cookie.expires.typeCode() == NT_DATE) {
        hdr += sprintf("; Expires=%s", cookie.expires.format("Dy, DD Mon YYYY HH:mm:SS GMT"));
    }

    return hdr;
}

#! Sets a cookie on a response header hash
/** @param hdr reference to the response headers hash; the Set-Cookie header is
    appended (multiple cookies are stored as a list)
    @param cookie the cookie to set
    @param set_cache_control if True (default), sets Cache-Control to prevent caching
    of responses that set cookies
*/
public sub set_cookie_header(reference<hash<auto>> hdr, hash<CookieInfo> cookie,
        bool set_cache_control = True) {
    string cookie_str = format_set_cookie(cookie);

    # Append to existing Set-Cookie (as list for multiple cookies)
    if (exists hdr."Set-Cookie") {
        if (hdr."Set-Cookie".typeCode() == NT_LIST) {
            hdr."Set-Cookie" += cookie_str;
        } else {
            hdr."Set-Cookie" = (hdr."Set-Cookie", cookie_str);
        }
    } else {
        hdr."Set-Cookie" = cookie_str;
    }

    if (set_cache_control) {
        hdr."Cache-Control" = "no-cache=\"Set-Cookie\"";
    }
}

#! Domain matching per RFC 6265 Section 5.1.3
/** @param host the request host (should be lowercase)
    @param cookie_domain the cookie's domain attribute (lowercase)
    @return True if the host matches the cookie domain
*/
public bool sub domain_matches(string host, string cookie_domain) {
    if (host == cookie_domain) {
        return True;
    }
    # Suffix matching: host ends with ".domain"
    if (host.size() > cookie_domain.size()
            && host.substr(host.size() - cookie_domain.size()) == cookie_domain
            && host[host.size() - cookie_domain.size() - 1] == ".") {
        return True;
    }
    return False;
}

#! Path matching per RFC 6265 Section 5.1.4
/** @param request_path the request path
    @param cookie_path the cookie's path attribute
    @return True if the request path matches the cookie path
*/
public bool sub path_matches(string request_path, string cookie_path) {
    if (request_path == cookie_path) {
        return True;
    }
    if (request_path.size() > cookie_path.size()
            && request_path.substr(0, cookie_path.size()) == cookie_path) {
        if (cookie_path[cookie_path.size() - 1] == "/") {
            return True;
        }
        if (request_path[cookie_path.size()] == "/") {
            return True;
        }
    }
    return False;
}

#! Computes the default cookie path from a request path (RFC 6265 Section 5.1.4)
/** @param request_path the request-URI path
    @return the default cookie path (parent directory of the request path)
*/
public string sub compute_default_path(string request_path) {
    if (!request_path || request_path[0] != "/") {
        return "/";
    }
    int last_slash = request_path.rfind("/");
    if (last_slash <= 0) {
        return "/";
    }
    return request_path.substr(0, last_slash);
}

#! Follows HTTP redirects for a request and records them (RFC 9110 section 15.4)
/** An object of this class holds the state of one request that follows redirects: the origin, method, request
    target, headers, and body of the next request to send, and the redirects followed so far.  A client sends the
    request described by the object; when the response is a redirect to follow (see @ref isFollowed()), it calls
    @ref follow() and sends the request described by the object again.

    Redirects are followed with the following rules:
    - redirects with status 301, 302, 303, 307, and 308 are followed; 300 (no single target), 304 (not a redirect),
      305 (deprecated for security reasons), and 306 (unused) are not
    - the \c Location value is resolved against the URL of the request that received it according to RFC 3986
      section 5.2, and any fragment is removed
    - a 303 redirect is retrieved with \c GET (a \c HEAD request stays \c HEAD), a \c POST redirected with 301 or
      302 is changed to \c GET, and 307 and 308 repeat the request; a request that changes to \c GET is sent without
      its body and content headers
    - the \c Authorization, \c Cookie, and \c Host request headers are sent only to the origin (scheme, host, and
      port) of the original request; origins are compared case-insensitively and with default ports applied, so
      \c https://example.com and \c HTTPS://EXAMPLE.COM:443 are the same origin
    - user information in a redirect location is never used as credentials
    - only \c http and \c https locations are followed, and only a request on a UNIX domain socket can be
      redirected to a UNIX domain socket

    @par Example:
    @code{.py}
HttpRedirectFollower rf("https://example.com", "/docs", "GET", NOTHING, NOTHING, 5);
while (True) {
    hash<auto> resp = send(rf.getOrigin(), rf.getMethod(), rf.getPath(), rf.getHeaders(), rf.getBody());
    if (!rf.isFollowed(resp.status_code)) {
        break;
    }
    rf.follow(resp.status_code, resp.status_message, resp.headers);
}
    @endcode

    @since HttpUtil 1.0
*/
public class HttpRedirectFollower {
    public {
        #! Redirect status codes that are followed
        const FollowedStatusCodes = {
            "301": True,
            "302": True,
            "303": True,
            "307": True,
            "308": True,
        };
    }

    private {
        #! The origin of the next request: a URL without user information or a path
        string origin;
        #! The parsed URL of the origin of the next request
        hash<UrlInfo> origin_info;
        #! The request target of the next request
        string path;
        #! The method of the next request
        string method;
        #! The headers of the next request
        *hash<auto> headers;
        #! The body of the next request
        *data body;
        #! The origin key of the original request
        string original_key;
        #! Origin-bound headers of the original request
        hash<auto> origin_headers = {};
        #! The maximum number of redirects to follow
        int max_redirects;
        #! If redirects are returned to the caller instead of being followed
        bool redirect_passthru;
        #! The redirects followed
        list<hash<HttpRedirectInfo>> redirects = ();
    }

    #! Creates the object for a request
    /** @param url the URL of the request; only the scheme, host, and port are used; user information and any path
        are ignored.  A URL without a scheme is an \c https URL, except for a UNIX domain socket (a
        <tt>socket=</tt> host with a URL-encoded absolute path), which is an \c http URL.
        @param path the request target of the request; percent-encoded if necessary
        @param method the request method
        @param headers the request headers
        @param body the request body
        @param max_redirects the maximum number of redirects to follow; with 0, any redirect that would be followed
        raises an exception
        @param redirect_passthru if @ref True, redirects are not followed; see @ref isFollowed()

        @throw HTTP-CLIENT-URL-ERROR the URL is invalid or has no host
        @throw HTTP-CLIENT-REDIRECT-ERROR \a max_redirects is negative
    */
    constructor(string url, string path, string method, *hash<auto> headers, *data body, int max_redirects = 5,
            bool redirect_passthru = False) {
        if (max_redirects < 0) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("invalid maximum number of redirects %d", max_redirects);
        }
        origin_info = HttpRedirectFollower::parseOrigin(url);
        origin = HttpRedirectFollower::getOriginUrl(origin_info);
        original_key = HttpRedirectFollower::getOriginKey(origin_info);
        self.path = HttpRedirectFollower::encodeTarget(path);
        if (self.path !~ /^\//) {
            self.path = "/" + self.path;
        }
        self.method = method;
        self.headers = headers;
        self.body = body;
        origin_headers = (map {$1.key: $1.value}, headers.pairIterator(),
            HttpRedirectFollower::isOriginBoundHeader($1.key)) ?? {};
        self.max_redirects = max_redirects;
        self.redirect_passthru = redirect_passthru;
    }

    #! Returns the origin of the next request: a URL with a scheme, host, and port (if not the default port)
    string getOrigin() {
        return origin;
    }

    #! Returns the request target of the next request
    string getPath() {
        return path;
    }

    #! Returns the absolute URL of the next request, without user information
    string getRequestUrl() {
        return origin + path;
    }

    #! Returns the method of the next request
    string getMethod() {
        return method;
    }

    #! Returns the headers of the next request
    *hash<auto> getHeaders() {
        return headers;
    }

    #! Replaces the headers of the next request
    /** For example, to add a header computed for the next target; origin-bound headers set here are sent only to
        the target of the next request, as they are removed again when a redirect leads to another origin
    */
    setHeaders(*hash<auto> headers) {
        self.headers = headers;
    }

    #! Returns the body of the next request
    *data getBody() {
        return body;
    }

    #! Returns @ref True if the next request goes to the origin of the original request
    bool isOriginalOrigin() {
        return HttpRedirectFollower::getOriginKey(origin_info) == original_key;
    }

    #! Returns the redirects followed, in the order followed
    list<hash<HttpRedirectInfo>> getRedirects() {
        return redirects;
    }

    #! Returns the maximum number of redirects to follow
    int getMaxRedirects() {
        return max_redirects;
    }

    #! Returns @ref True if a response with the given status code is a redirect to follow
    /** @return @ref False if redirects are returned to the caller, otherwise the result of
        @ref isFollowedStatus()
    */
    bool isFollowed(int status_code) {
        return !redirect_passthru && HttpRedirectFollower::isFollowedStatus(status_code);
    }

    #! Updates the object for the next request to follow a redirect response
    /** @param status_code the status code of the redirect response
        @param status_message the status message of the redirect response
        @param resp_headers the headers of the redirect response with lower-case names

        @throw HTTP-CLIENT-MAXIMUM-REDIRECTS-EXCEEDED the maximum number of redirects was reached
        @throw HTTP-CLIENT-REDIRECT-ERROR the redirect cannot be followed: the response has no \c Location value or
        more than one, or the location has no host or an invalid host, or it names a UNIX domain socket and the
        request is not on one
        @throw HTTP-CLIENT-UNKNOWN-PROTOCOL the location has a scheme other than \c http or \c https
    */
    follow(int status_code, *string status_message, *hash<auto> resp_headers) {
        string request_url = getRequestUrl();
        auto location = resp_headers.location;
        if (location.typeCode() == NT_LIST) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("redirect response %d from %y has %d Location headers; "
                "expecting one", status_code, request_url, location.size());
        }
        if (!location.val()) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("no redirect location given for status code %d from %y",
                status_code, request_url);
        }
        if (redirects.size() >= max_redirects) {
            throw "HTTP-CLIENT-MAXIMUM-REDIRECTS-EXCEEDED", sprintf("maximum redirects (%d) exceeded; redirect %d "
                "from %y to %y ignored", max_redirects, status_code, request_url, location);
        }

        # resolve the location against the URL of the request that received it (RFC 3986 section 5.2) and remove
        # any fragment, which is never sent
        string target = resolve_url(request_url, location);
        target =~ s/#.*//s;
        *list<*string> parts = (target =~ x/^([A-Za-z][A-Za-z0-9+.-]*):\/\/([^\/?#]*)(.*)$/s);
        if (!parts) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("redirect location %y from %y (code %d) has no host",
                location, request_url, status_code);
        }
        string scheme = parts[0].lwr();
        if (scheme != "http" && scheme != "https") {
            throw "HTTP-CLIENT-UNKNOWN-PROTOCOL", sprintf("redirect location %y from %y (code %d) has unsupported "
                "scheme %y", location, request_url, status_code, scheme);
        }
        # user information in a redirect location is never used as credentials
        string authority = parts[1];
        authority =~ s/^.*@//s;
        if (!authority.val()) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("redirect location %y from %y (code %d) has no host",
                location, request_url, status_code);
        }
        # the host is sent in the Host header and, through a proxy, in the request line
        if (authority =~ /[\x00-\x20\x7f"<>\\^`{|}]|%(?![0-9a-fA-F]{2})/) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("redirect location %y from %y (code %d) has an invalid "
                "host", location, request_url, status_code);
        }
        hash<UrlInfo> next_info;
        try {
            next_info = HttpRedirectFollower::parseOrigin(scheme + "://" + authority);
        } catch (hash<ExceptionInfo> ex) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("redirect location %y from %y (code %d) has an invalid "
                "host: %s", location, request_url, status_code, ex.desc);
        }
        if (next_info.host =~ /[\x00-\x20\x7f]/) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("redirect location %y from %y (code %d) has an invalid "
                "host", location, request_url, status_code);
        }
        # the server chooses the location, so a network server must never be able to send the request (and a
        # repeated body) to a local UNIX domain socket; a request on a socket comes from a local server and can be
        # redirected to another socket
        if (HttpRedirectFollower::isUnixSocket(next_info) && !HttpRedirectFollower::isUnixSocket(origin_info)) {
            throw "HTTP-CLIENT-REDIRECT-ERROR", sprintf("redirect location %y from %y (code %d) names a UNIX "
                "domain socket; only a request on a UNIX domain socket can be redirected to one", location,
                request_url, status_code);
        }
        string next_origin = HttpRedirectFollower::getOriginUrl(next_info);
        string next_path = HttpRedirectFollower::encodeTarget(parts[2] ?? "");
        if (next_path !~ /^\//) {
            next_path = "/" + next_path;
        }

        # RFC 9110 sections 15.4.2 - 15.4.4: 303 is retrieved with GET, and a POST redirected with 301 or 302 is
        # changed to GET as all common user agents do; 307 and 308 repeat the request
        bool drop_body;
        if (status_code == 303) {
            if (method.upr() != "HEAD") {
                method = "GET";
            }
            drop_body = True;
        } else if ((status_code == 301 || status_code == 302) && method.upr() == "POST") {
            method = "GET";
            drop_body = True;
        }
        if (drop_body) {
            body = NOTHING;
            headers -= (map $1, keys headers, $1 =~ /^(content-|transfer-encoding$)/i);
        }

        # origin-bound headers are sent only to the origin of the original request
        headers -= (map $1, keys headers, HttpRedirectFollower::isOriginBoundHeader($1));
        if (HttpRedirectFollower::getOriginKey(next_info) == original_key && origin_headers) {
            headers += origin_headers;
        }

        redirects += <HttpRedirectInfo>{
            "request_url": request_url,
            "status_code": status_code,
            "status_message": status_message,
            "location": location,
            "target_url": next_origin + next_path,
            "headers": resp_headers ?? {},
        };

        origin = next_origin;
        origin_info = next_info;
        path = next_path;
    }

    #! Returns @ref True if the given response status code is a redirect that is followed
    /** The redirects followed are 301, 302, 303, 307, and 308 (RFC 9110 section 15.4); 300 (no single target),
        304 (not a redirect), 305 (deprecated for security reasons), and 306 (unused) are returned to the caller
    */
    static bool isFollowedStatus(int status_code) {
        return FollowedStatusCodes{status_code}.toBool();
    }

    #! Returns @ref True if the given request header is bound to the origin of the request
    /** \c Authorization, \c Cookie, and \c Host name or authenticate the origin of a request; when a redirect leads
        to another origin, they are not sent there

        @param name the header name, compared case-insensitively
    */
    static bool isOriginBoundHeader(string name) {
        return name =~ /^(authorization|cookie|host)$/i;
    }

    #! Returns the parsed origin of a URL with the default scheme and port applied
    /** A URL without a scheme is an \c https URL, except for a UNIX domain socket (a <tt>socket=</tt> host with a
        URL-encoded absolute path), which is an \c http URL and has port 0; the default port of \c https is 443,
        and 80 for any other scheme

        @param url the URL

        @return the parsed URL; the \c protocol and \c port keys are always set, and \c username, \c password, and
        \c path are removed

        @throw HTTP-CLIENT-URL-ERROR the URL is invalid or has no host
    */
    static hash<UrlInfo> parseOrigin(string url) {
        hash<UrlInfo> info;
        try {
            info = parse_url(url);
        } catch (hash<ExceptionInfo> ex) {
            # the error of parse_url() is not included, as it contains the URL with any user information
            throw "HTTP-CLIENT-URL-ERROR", sprintf("invalid URL %y", HttpRedirectFollower::removeUserInfo(url));
        }
        if (!info.host) {
            throw "HTTP-CLIENT-URL-ERROR", sprintf("invalid URL %y: missing host",
                HttpRedirectFollower::removeUserInfo(url));
        }
        info -= ("username", "password", "path");
        if (HttpRedirectFollower::isUnixSocket(info)) {
            if (!info.protocol) {
                info.protocol = "http";
            }
            info.port = 0;
            return info;
        }
        info.protocol = info.protocol ? info.protocol.lwr() : "https";
        if (!info.port) {
            info.port = info.protocol == "https" ? 443 : 80;
        }
        return info;
    }

    #! Returns the origin of a URL parsed by @ref parseOrigin() as a URL without user information or a path
    /** The port is included only if it is not the default port of the scheme
    */
    static string getOriginUrl(hash<UrlInfo> info) {
        if (HttpRedirectFollower::isUnixSocket(info)) {
            return sprintf("%s://socket=%s", info.protocol, encode_url(info.host, True));
        }
        # an IPv6 address literal must be enclosed in brackets (RFC 3986 section 3.2.2)
        string rv = info.protocol + "://" + (info.host =~ /:/ ? "[" + info.host + "]" : info.host);
        if (info.port != (info.protocol == "https" ? 443 : 80)) {
            rv += ":" + info.port;
        }
        return rv;
    }

    #! Returns a key that is equal for two URLs parsed by @ref parseOrigin() with the same origin
    /** Scheme and host names are case-insensitive (RFC 3986 section 6.2.2.1); a UNIX domain socket path is not
    */
    static string getOriginKey(hash<UrlInfo> info) {
        if (HttpRedirectFollower::isUnixSocket(info)) {
            return "socket:" + info.host;
        }
        return sprintf("%s://%s:%d", info.protocol.lwr(), info.host.lwr(), info.port);
    }

    #! Returns @ref True if two URLs have the same origin
    /** @throw HTTP-CLIENT-URL-ERROR a URL is invalid or has no host
    */
    static bool isSameOrigin(string url1, string url2) {
        return HttpRedirectFollower::getOriginKey(HttpRedirectFollower::parseOrigin(url1))
            == HttpRedirectFollower::getOriginKey(HttpRedirectFollower::parseOrigin(url2));
    }

    #! Returns @ref True if a parsed URL names a UNIX domain socket
    static bool isUnixSocket(hash<auto> info) {
        return !info.port && info.host =~ /^\//;
    }

    #! Percent-encodes the octets that cannot appear in an HTTP request target
    /** Control characters, space, octets outside of ASCII (non-ASCII text is encoded in UTF-8), and the characters
        <tt>&quot; &lt; &gt; \\ ^ &#96; { | }</tt> are percent-encoded; percent-encoded octets and URI delimiters are
        kept exactly as given, so an encoded delimiter is never decoded
    */
    static string encodeTarget(string target) {
        if (target !~ /[^\x21-\x7e]|["<>\\^`{|}]/) {
            return target;
        }
        binary octets = target.toBinary();
        string rv;
        for (int i = 0; i < octets.size(); ++i) {
            int c = octets[i];
            if (c <= 0x20 || c >= 0x7f || c == 0x22 || c == 0x3c || c == 0x3e || c == 0x5c || c == 0x5e
                    || c == 0x60 || c == 0x7b || c == 0x7c || c == 0x7d) {
                rv += sprintf("%%%02X", c);
            } else {
                rv += chr(c);
            }
        }
        return rv;
    }

    #! Returns the URL with any user information removed, for error messages
    private static string removeUserInfo(string url) {
        return url =~ x/^([^:\/?#]+:\/\/)[^\/?#]*@/ ? regex_subst(url, "^([^:/?#]+://)[^/?#]*@", "$1") : url;
    }
}

#! An authentication challenge from a \c WWW-Authenticate or \c Proxy-Authenticate header (RFC 9110 section 11.6)
/** @since HttpUtil 1.0
*/
public hashdecl HttpAuthChallengeInfo {
    #! The authentication scheme in lower case, for example \c "basic" or \c "digest"
    string scheme;

    #! The auth-params of the challenge; names are in lower case, and quoted values are unquoted
    hash<string, string> params = {};

    #! The token68 of the challenge, if it has one instead of auth-params
    *string token68;
}

#! Answers HTTP authentication challenges with the Basic and Digest schemes for one set of credentials
/** An object of this class holds the credentials of a user for one origin (or for a proxy) and the last
    challenge received from it, and returns the value of the \c Authorization (or \c Proxy-Authorization) request
    header for each request:
    - before a challenge was received, and after a \c Basic challenge, the credentials are sent with the \c Basic
      scheme (RFC 7617)
    - after a \c Digest challenge, requests are authenticated with the \c Digest scheme (RFC 7616) with the nonce of
      the challenge and an incremented nonce count, so that a server that accepts the nonce does not challenge each
      request again; the algorithms \c SHA-256, \c SHA-256-sess, \c MD5, and \c MD5-sess, the quality of protection
      values \c auth and \c auth-int, the absence of a quality of protection (RFC 2069), and \c userhash are
      supported

    A client calls @ref processChallenge() with the headers of a 401 (or 407) response; if it returns @ref True, the
    request is sent again with the value returned by @ref getAuthorization().  Credentials that were sent and
    rejected are not sent again, unless the server reports that the nonce was stale.

    @note The credentials must only be sent to the origin they belong to; see
    @ref HttpRedirectFollower "HttpRedirectFollower" for the origin-bound headers of a request

    @par Example:
    @code{.py}
HttpAuthenticator auth("user", "pass");
hash<auto> hdr = {"Authorization": auth.getAuthorization("GET", "/data")};
hash<auto> resp = send("GET", "/data", hdr);
if (resp.status_code == 401 && auth.processChallenge(resp.headers, hdr.Authorization)) {
    hdr.Authorization = auth.getAuthorization("GET", "/data");
    resp = send("GET", "/data", hdr);
}
    @endcode

    @since HttpUtil 1.0
*/
public class HttpAuthenticator {
    public {
        #! Digest algorithms supported, from the most preferred to the least preferred
        const DigestAlgorithms = ("SHA-256", "SHA-256-SESS", "MD5", "MD5-SESS");
    }

    private {
        #! The user name
        string username;
        #! The password
        string password;
        #! True for proxy authentication
        bool proxy;
        #! The last Digest challenge accepted, if any
        *hash<HttpAuthChallengeInfo> challenge;
        #! The algorithm of the Digest challenge, in upper case
        *string algorithm;
        #! The nonce count of the Digest challenge
        int nc = 0;
        #! Serializes requests that share the nonce count
        Mutex m();
    }

    #! Creates the object
    /** @param username the user name
        @param password the password
        @param proxy @ref True for proxy authentication (the \c Proxy-Authenticate and \c Proxy-Authorization
        headers)
    */
    constructor(string username, string password = "", bool proxy = False) {
        self.username = username;
        self.password = password;
        self.proxy = proxy;
    }

    #! Returns the user name
    string getUsername() {
        return username;
    }

    #! Returns the value of an authorization header with the credentials of this object in the Basic scheme
    string getBasicCredentials() {
        return HttpAuthenticator::getBasicAuthorization(username, password);
    }

    #! Returns @ref True if the object has the given credentials
    bool hasCredentials(string username, string password) {
        return self.username == username && self.password == password;
    }

    #! Returns the name of the request header with the credentials: \c "Authorization" or \c "Proxy-Authorization"
    string getHeaderName() {
        return proxy ? "Proxy-Authorization" : "Authorization";
    }

    #! Returns the lower-case name of the response header with challenges: \c "www-authenticate" or
    #! \c "proxy-authenticate"
    string getChallengeHeaderName() {
        return proxy ? "proxy-authenticate" : "www-authenticate";
    }

    #! Returns the status code of a challenge response: 401, or 407 for proxy authentication
    int getChallengeStatus() {
        return proxy ? 407 : 401;
    }

    #! Returns @ref True if requests are authenticated with a Digest challenge
    bool hasDigestChallenge() {
        AutoLock al(m);
        return exists challenge;
    }

    #! Returns the value of the authorization header for a request
    /** @param method the request method
        @param uri the request target, as sent in the request line (for a \c CONNECT request, the authority)
        @param body the request body, for the \c auth-int quality of protection

        @return the header value: a \c Digest response after a Digest challenge, otherwise \c Basic credentials
    */
    string getAuthorization(string method, string uri, *data body) {
        AutoLock al(m);
        if (!challenge) {
            return HttpAuthenticator::getBasicAuthorization(username, password);
        }
        return HttpAuthenticator::getDigestResponse(challenge, algorithm, username, password, method, uri, ++nc,
            get_random_bytes(16).toHex(), body);
    }

    #! Processes the challenges of a 401 (or 407) response
    /** @param resp_headers the response headers with lower-case names
        @param sent the value of the authorization header sent with the request that received the response, if any

        @return @ref True if the request should be sent again with the value returned by @ref getAuthorization();
        @ref False if no supported challenge was received, or if the credentials were sent already and rejected
    */
    bool processChallenge(*hash<auto> resp_headers, *string sent) {
        list<hash<HttpAuthChallengeInfo>> challenges =
            HttpAuthenticator::parseChallenges(resp_headers{getChallengeHeaderName()});
        # the strongest Digest challenge supported, else Basic
        *hash<HttpAuthChallengeInfo> best;
        *string best_alg;
        int best_rank = elements DigestAlgorithms;
        bool basic;
        foreach hash<HttpAuthChallengeInfo> c in (challenges) {
            if (c.scheme == "basic") {
                basic = True;
                continue;
            }
            if (c.scheme != "digest" || !c.params.nonce.val() || !exists c.params.realm) {
                continue;
            }
            string alg = (c.params.algorithm ?? "MD5").upr();
            int rank = HttpAuthenticator::getAlgorithmRank(alg);
            if (rank < best_rank && HttpAuthenticator::getQop(c)) {
                best = c;
                best_alg = alg;
                best_rank = rank;
            }
        }
        AutoLock al(m);
        if (best) {
            bool stale = best.params.stale =~ /^true$/i;
            # credentials rejected for the same nonce are not sent again
            if (!stale && sent =~ /^Digest /i && challenge && challenge.params.nonce == best.params.nonce) {
                return False;
            }
            challenge = best;
            algorithm = best_alg;
            nc = 0;
            return True;
        }
        remove challenge;
        remove algorithm;
        if (basic) {
            # Basic credentials that were rejected are not sent again
            return sent != HttpAuthenticator::getBasicAuthorization(username, password);
        }
        return False;
    }

    #! Returns the value of an authorization header with Basic credentials (RFC 7617)
    /** The user name and password are encoded in UTF-8

        @param username the user name
        @param password the password
    */
    static string getBasicAuthorization(string username, string password = "") {
        return "Basic " + make_base64_string(binary(convert_encoding(username + ":" + password, "UTF-8")));
    }

    #! Returns the value of an authorization header answering a Digest challenge (RFC 7616)
    /** @param challenge the Digest challenge
        @param algorithm the algorithm in upper case: \c "SHA-256", \c "SHA-256-SESS", \c "MD5", or \c "MD5-SESS"
        @param username the user name
        @param password the password
        @param method the request method
        @param uri the request target
        @param nc the nonce count
        @param cnonce the client nonce
        @param body the request body, for the \c auth-int quality of protection

        @return the header value

        @throw HTTP-AUTH-ERROR the algorithm or the quality of protection of the challenge is not supported
    */
    static string getDigestResponse(hash<HttpAuthChallengeInfo> challenge, string algorithm, string username,
            string password, string method, string uri, int nc, string cnonce, *data body) {
        code h = HttpAuthenticator::getHashFunction(algorithm);
        string realm = challenge.params.realm ?? "";
        string nonce = challenge.params.nonce ?? "";
        *string qop = HttpAuthenticator::getQop(challenge);
        if (!qop) {
            throw "HTTP-AUTH-ERROR", sprintf("the quality of protection %y of the Digest challenge is not "
                "supported", challenge.params.qop);
        }
        string ncs = sprintf("%08x", nc);
        string ha1 = h(username + ":" + realm + ":" + password);
        if (algorithm =~ /-SESS$/) {
            ha1 = h(ha1 + ":" + nonce + ":" + cnonce);
        }
        string ha2 = qop == "auth-int"
            ? h(method + ":" + uri + ":" + h(body ?? ""))
            : h(method + ":" + uri);
        string response = qop == "none"
            ? h(ha1 + ":" + nonce + ":" + ha2)
            : h(ha1 + ":" + nonce + ":" + ncs + ":" + cnonce + ":" + qop + ":" + ha2);
        bool userhash = challenge.params.userhash =~ /^true$/i;
        string user = userhash ? h(username + ":" + realm) : username;
        string rv = sprintf("Digest username=%s, realm=%s, uri=%s, algorithm=%s, nonce=%s",
            HttpAuthenticator::quote(user), HttpAuthenticator::quote(realm), HttpAuthenticator::quote(uri),
            algorithm =~ /-SESS$/ ? algorithm.substr(0, -5) + "-sess" : algorithm, HttpAuthenticator::quote(nonce));
        if (qop != "none") {
            rv += sprintf(", nc=%s, cnonce=%s, qop=%s", ncs, HttpAuthenticator::quote(cnonce), qop);
        }
        rv += ", response=" + HttpAuthenticator::quote(response);
        if (exists challenge.params.opaque) {
            rv += ", opaque=" + HttpAuthenticator::quote(challenge.params.opaque);
        }
        if (userhash) {
            rv += ", userhash=true";
        }
        return rv;
    }

    #! Parses the challenges of a \c WWW-Authenticate or \c Proxy-Authenticate header (RFC 9110 section 11.6.1)
    /** @param value the header value; a list for a header received more than once

        @return the challenges in the order received; a malformed challenge ends the list
    */
    static list<hash<HttpAuthChallengeInfo>> parseChallenges(auto value) {
        list<hash<HttpAuthChallengeInfo>> rv = ();
        if (value.typeCode() == NT_LIST) {
            foreach auto v in (value) {
                rv += HttpAuthenticator::parseChallenges(v);
            }
            return rv;
        }
        if (value.typeCode() != NT_STRING) {
            return rv;
        }
        string s = value;
        int len = s.length();
        int i = 0;
        *hash<HttpAuthChallengeInfo> cur;
        while (True) {
            # skip separators
            while (i < len && (s[i] == " " || s[i] == "\t" || s[i] == ",")) {
                ++i;
            }
            if (i >= len) {
                break;
            }
            # a token: an auth scheme, an auth-param name, or a token68
            int start = i;
            while (i < len && s[i] !~ /[ \t,=]/) {
                ++i;
            }
            string token = s.substr(start, i - start);
            int j = i;
            while (j < len && (s[j] == " " || s[j] == "\t")) {
                ++j;
            }
            if (j < len && s[j] == "=" && cur) {
                # a token followed by "=" and then "=" or the end is a token68; otherwise an auth-param
                int k = j + 1;
                while (k < len && s[k] == "=") {
                    ++k;
                }
                int m2 = k;
                while (m2 < len && (s[m2] == " " || s[m2] == "\t")) {
                    ++m2;
                }
                if (k > j + 1 || m2 >= len || s[m2] == ",") {
                    if (!cur.params && !exists cur.token68) {
                        cur.token68 = s.substr(start, k - start);
                    }
                    i = k;
                    continue;
                }
                i = m2;
                string val;
                if (s[i] == "\"") {
                    ++i;
                    while (i < len && s[i] != "\"") {
                        if (s[i] == "\\" && i + 1 < len) {
                            ++i;
                        }
                        val += s[i];
                        ++i;
                    }
                    if (i >= len) {
                        # an unterminated quoted string ends the list; the malformed challenge is not returned
                        remove cur;
                        break;
                    }
                    ++i;
                } else {
                    int vs = i;
                    while (i < len && s[i] !~ /[ \t,]/) {
                        ++i;
                    }
                    val = s.substr(vs, i - vs);
                }
                cur.params{token.lwr()} = val;
                continue;
            }
            # a new challenge
            if (cur) {
                rv += cur;
            }
            cur = <HttpAuthChallengeInfo>{"scheme": token.lwr()};
            i = j;
        }
        if (cur) {
            rv += cur;
        }
        return rv;
    }

    #! Returns the quality of protection used for a Digest challenge: \c "auth", \c "auth-int", or \c "none" if the
    #! challenge has none (RFC 2069), or @ref nothing if none of the values offered is supported
    static *string getQop(hash<HttpAuthChallengeInfo> challenge) {
        if (!exists challenge.params.qop) {
            return "none";
        }
        list<string> offered = map trim($1).lwr(), challenge.params.qop.split(",");
        if (inlist("auth", offered)) {
            return "auth";
        }
        if (inlist("auth-int", offered)) {
            return "auth-int";
        }
    }

    #! Returns the rank of a Digest algorithm: 0 for the most preferred, and the number of algorithms for one that
    #! is not supported
    private static int getAlgorithmRank(string algorithm) {
        for (int i = 0; i < elements DigestAlgorithms; ++i) {
            if (DigestAlgorithms[i] == algorithm) {
                return i;
            }
        }
        return elements DigestAlgorithms;
    }

    #! Returns the hash function of a Digest algorithm
    /** @throw HTTP-AUTH-ERROR the algorithm is not supported
    */
    private static code getHashFunction(string algorithm) {
        switch (algorithm) {
            case "SHA-256":
            case "SHA-256-SESS":
                return string sub (data d) { return SHA256(d); };
            case "MD5":
            case "MD5-SESS":
                return string sub (data d) { return MD5(d); };
        }
        throw "HTTP-AUTH-ERROR", sprintf("the Digest algorithm %y is not supported; supported algorithms: %y",
            algorithm, DigestAlgorithms);
    }

    #! Returns a quoted string (RFC 9110 section 5.6.4)
    private static string quote(string str) {
        return "\"" + regex_subst(str, "([\"\\\\])", "\\\\$1", RE_Global) + "\"";
    }
}

} # namespace HttpUtil
