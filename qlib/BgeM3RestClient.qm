# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes

module BgeM3RestClient {
    version = "1.0";
    desc = "user module for calling BGE-M3 FastAPI sidecar services";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("bge-m3", BgeM3RestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("bge-m3-fastapi", BgeM3RestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new QoreRagUtils::BgeM3FastApiEmbedderFactory());
    };
}

/** @mainpage BgeM3RestClient Module

    @tableofcontents

    @section bgem3restclientintro BgeM3RestClient Introduction

    The %BgeM3RestClient module provides an API for calling
    [BGE-M3](https://huggingface.co/BAAI/bge-m3) FastAPI sidecar services.
    The sidecar exposes a small native API:
    - `POST /embed` — dense + sparse embedding generation for one or more texts
    - `GET /health` — liveness probe with host memory pressure info
    - `GET /metrics` — Prometheus text-format metrics

    To use this module, use \c "%requires BgeM3RestClient" in your code.

    All the public symbols in the module are defined in the BgeM3RestClient namespace.

    The sidecar always serves a single embedding model (\c bge-m3); the
    \c model option is therefore optional and defaults to \c "bge-m3".  It is
    captured on the connection and exposed at runtime via
    @ref BgeM3RestClient::BgeM3RestClientBase::getModel() "getModel()".

    The main classes are:
    - @ref BgeM3RestClient::BgeM3RestClient "BgeM3RestClient":
      synchronous REST client for BGE-M3 FastAPI servers
    - @ref BgeM3RestClient::BgeM3RestClientIo "BgeM3RestClientIo":
      async-I/O REST client for BGE-M3 FastAPI servers using multiplexed
      HTTP/1.1 and HTTP/2 connections
    - @ref BgeM3RestClient::BgeM3RestConnection "BgeM3RestConnection":
      provides a REST connection object to BGE-M3 FastAPI services (based on
      the @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires BgeM3RestClient

BgeM3RestClient rest({"url": "http://localhost:30680"});
hash<auto> ans = rest.post("/embed", {
    "texts": ("hello world", "another text"),
    "return_dense": True,
    "return_sparse": False,
});
printf("%Y\n", ans.body.dense);
    @endcode

    @section BgeM3RestClientRelnotes Release Notes

    @subsection BgeM3RestClientv1_0 BgeM3RestClient v1.0
    - the initial version of the %BgeM3RestClient module
*/

#! the BgeM3RestClient namespace contains all the objects in the BgeM3RestClient module
public namespace BgeM3RestClient {
#! Common base class for BgeM3RestClient functionality
public class BgeM3RestClientBase {
    public {
        #! Default BGE-M3 sidecar URL
        const DefaultUrl = "http://localhost:30680";

        #! Default model name (the sidecar always serves \c bge-m3)
        const DefaultModel = "bge-m3";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "data": "json",
        };

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path — sidecar liveness endpoint
        const DefaultPingPath = "/health";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Native embed endpoint path
        const EmbedEndpoint = "/embed";

        #! Native health endpoint path
        const HealthEndpoint = "/health";

        #! Native metrics endpoint path (Prometheus text format)
        const MetricsEndpoint = "/metrics";
    }

    private {
        #! Model name reported by getModel() — defaults to @ref DefaultModel
        string model_name;
    }

    #! returns options for the constructor
    /** Applies BGE-M3 defaults, ensures \c Accept is \c application/json,
        maps \c apikey (if set) to an \c Authorization: \c Bearer header, and
        strips BGE-M3-specific options that the underlying REST client would
        otherwise reject.
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto!> rv = DefaultOptions + opts;
        # ensure Accept header is JSON (RestClientIo ignores the "data" option)
        if (!rv.headers."Accept") {
            rv.headers."Accept" = MimeTypeJson;
        }
        # map apikey (production-auth deployments) to Authorization: Bearer header
        if (rv.apikey) {
            rv.headers."Authorization" = "Bearer " + rv.apikey;
            remove rv.apikey;
        }
        # model is a BGE-M3-specific option; strip it from REST client options
        # (captured separately by the subclass constructor into model_name)
        remove rv.model;
        return rv;
    }

    #! Returns the model name configured on this connection
    /** @return the model name; defaults to \c "bge-m3"

        @note The BGE-M3 FastAPI sidecar always serves the \c bge-m3 model;
        this getter exists for parity with other embedder backends so that
        downstream collection metadata can record the model name without
        making a server-info call.
    */
    string getModel() {
        return model_name;
    }

    #! Captures the model option (defaults to @ref DefaultModel)
    private initModel(hash<auto> opts) {
        model_name = opts.model.val() ? opts.model : DefaultModel;
    }
}

#! this class provides the REST client API for communication with BGE-M3 FastAPI servers
/** A \c model option may be set; if absent it defaults to \c "bge-m3" — the
    only model the sidecar serves.  If the target deployment requires
    authentication, pass an \c apikey; it will be sent as the
    \c Authorization: \c Bearer header.
*/
public class BgeM3RestClient inherits RestClient::RestClient, BgeM3RestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
BgeM3RestClient rest({"url": "http://localhost:30680"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c model (optional): name reported by @ref getModel() (default \c "bge-m3")
        - \c apikey (optional): API key for deployments with authentication enabled
        @param do_not_connect if \c False (the default), then a connection is returned already connected to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(BgeM3RestClientBase::getOptions(opts), True) {
        initModel(opts);
    }
}

#! Class for BGE-M3 REST connections; returns @ref BgeM3RestClient objects
public class BgeM3RestConnection inherits RestClient::RestConnection {
    public {
        #! Default BGE-M3 REST connection URL
        const DefaultUrl = "bge-m3://localhost:30680";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "BGE-M3 FastAPI Connection",
            "short_desc": "A connection to a BGE-M3 FastAPI embedding sidecar",
            "desc": "A connection to a [BGE-M3](https://huggingface.co/BAAI/bge-m3) "
                "FastAPI embedding sidecar.\n\n"
                "BGE-M3 is a multilingual text embedding model supporting dense, "
                "sparse, and multi-vector representations.  The sidecar exposes:\n"
                "- `POST /embed` — generate dense and/or sparse embeddings\n"
                "- `GET /health` — liveness with host memory pressure info\n"
                "- `GET /metrics` — Prometheus text-format metrics\n\n"
                "The sidecar serves a single model; the `model` option defaults "
                "to `bge-m3` and is reported back via `getModel()` for "
                "collection-metadata bookkeeping.\n\n"
                "If the deployment requires authentication, set `apikey`; it is "
                "sent as the `Authorization: Bearer` header.\n\n"
                "The connection uses the `bge-m3://` URL scheme; "
                "`bge-m3-fastapi://` is accepted as an alias.",
            "cls": Class::forName("BgeM3RestConnection"),
            "auto_url": True,
            "schemes": {
                "bge-m3": True,
                "bge-m3-fastapi": True,
            },
            "base_scheme_map": {
                "http": "bge-m3",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "model": <ConnectionOptionInfo>{
                    "display_name": "Model Name",
                    "short_desc": "The model reported back via getModel()",
                    "type": "string",
                    "desc": "The model name reported back via `getModel()`.  The BGE-M3 "
                        "FastAPI sidecar always serves the `bge-m3` model; this option "
                        "exists so downstream collection metadata can record the model "
                        "name without an extra server-info round trip.",
                    "default_value": BgeM3RestClientBase::DefaultModel,
                    "preselected": True,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "API key for sidecar deployments with authentication enabled",
                    "type": "string",
                    "desc": "Optional API key for sidecar deployments that enable "
                        "authentication; sent as the `Authorization: Bearer` header.  "
                        "Local deployments typically do not require a key.",
                    "sensitive": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": BgeM3RestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": BgeM3RestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": BgeM3RestClientBase::DefaultPingPath,
                },
            },
        };
    }

    #! creates the BgeM3RestConnection object
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the BgeM3RestConnection object from a config hash
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! returns \c "bge-m3"
    string getType() {
        return "bge-m3";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the BgeM3FastApiDataProvider and creates
        # the data provider object dynamically
        load_module("BgeM3FastApiDataProvider");
        return create_object("BgeM3FastApiDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! returns a @ref BgeM3RestClient object
    private BgeM3RestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new BgeM3RestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new BgeM3RestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for BGE-M3 FastAPI servers using multiplexed HTTP connections
/** Identical surface to @ref BgeM3RestClient but backed by the async I/O
    stack in @ref RestClientIo::RestClientIo.
*/
public class BgeM3RestClientIo inherits RestClientIo::RestClientIo, BgeM3RestClientBase {
    #! Creates the object with the given options
    /** @param opts valid options are all the options for the
        @ref RestClientIo::RestClientIo "RestClientIo" class plus:
        - \c model (optional): name reported by @ref getModel() (default \c "bge-m3")
        - \c apikey (optional): API key for deployments with authentication enabled
        @param shared_mgr optional shared HTTP client connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(BgeM3RestClientBase::getOptions(opts), shared_mgr) {
        initModel(opts);
    }
}
}

public namespace QoreRagUtils {
#! BGE-M3 FastAPI sidecar embedder — calls the native \c /embed endpoint
/** Wraps @ref BgeM3RestClient::BgeM3RestClientIo "BgeM3RestClientIo" and
    posts directly to \c POST /embed with the BGE-M3 native request shape.

    The sidecar can also produce sparse vectors for hybrid retrieval, but
    @ref AbstractEmbedder::encodeBatch() returns only dense vectors.

    @par Configuration

    - \c url (optional): sidecar URL, default \c "http://localhost:30680"
    - \c model (optional): reported back via @ref getModel(); the sidecar
      always serves \c "bge-m3" so the default matches reality
    - \c api_key (optional): bearer token for sidecars with authentication
      enabled
    - \c dimension (optional): cached dimension; when unset the dimension is
      auto-detected on first call
    - \c batch_size (optional): forwarded as the \c batch_size field in the
      sidecar request when set; when unset the sidecar's own default is used
    - \c options.return_sparse (optional): when @ref True, asks the sidecar
      to return sparse vectors as well (the dense ones are still what is
      returned to callers); default @ref False
    - \c timeout (optional): default request timeout (per-call \c opts override
      takes precedence)
    - \c connect_timeout (optional): default connection timeout (per-call
      \c opts override takes precedence)
*/
public class BgeM3FastApiEmbedder inherits AbstractEmbedder {
    public {
        const DefaultUrl = "http://localhost:30680";
        const DefaultModel = "bge-m3";
        const Backend = "bge-m3-fastapi";
    }

    private {
        hash<EmbedderConfig> config;
        string model_name;
        *BgeM3RestClient::BgeM3RestClientIo rest_client;
        *int cached_dimension;
        bool return_sparse = False;
        Mutex init_mutex();
    }

    constructor(hash<EmbedderConfig> config) {
        self.config = config;
        model_name = config.model.val() ? config.model : DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
        if (config.options.return_sparse.typeCode() == NT_BOOLEAN) {
            return_sparse = config.options.return_sparse;
        }
    }

    #! bge-m3 is tokenized client-side for chunk sizing; declares the model so a
    #! resolver can supply its HuggingFace tokenizer.
    hash<TokenizerRequirement> getTokenizerRequirement() {
        return <TokenizerRequirement>{
            "required": True,
            "id": model_name,
            "desc": sprintf("bge-m3 FastAPI model %y (HuggingFace tokenizer)", model_name),
        };
    }

    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }

        hash<auto> body = {
            "texts": texts,
            "return_dense": True,
            "return_sparse": return_sparse,
        };
        if (exists config.batch_size && config.batch_size > 0) {
            body.batch_size = config.batch_size;
        }

        hash<auto> resp;
        try {
            resp = pickRestClient(opts).restPost("/embed", body);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "REST-RESPONSE-ERROR" && isPermanentEmbedderConfigError(ex)) {
                throwEmbedderModelConfigError(ex, Backend, model_name);
            }
            rethrow;
        }

        *list<auto> vectors = resp.body.dense;
        if (!exists vectors) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: /embed response missing 'dense' vector data", Backend),
                {"body": resp.body};
        }
        if (vectors.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: /embed returned %d vectors for %d input texts",
                    Backend, vectors.size(), texts.size()),
                {"body": resp.body};
        }

        list<list<float>> result = ();
        foreach auto vec in (vectors) {
            list<float> typed = validateAndCastVector(vec, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = typed.size();
            }
            push result, typed;
        }
        return result;
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    *string getModel() {
        return model_name;
    }

    private bool isPermanentEmbedderConfigError(hash<ExceptionInfo> ex) {
        *int status_code = ex.arg.status_code;
        if (status_code != 400 && status_code != 404 && status_code != 422) {
            return False;
        }
        auto body = ex.arg.body;
        *string message = body.detail.typeCode() == NT_STRING
            ? body.detail
            : (body.message ?? body.error);
        if (!exists message && body.typeCode() == NT_STRING) {
            message = body;
        }
        if (!exists message) {
            return False;
        }
        string lower = message.lwr();
        if (lower.find("model") == -1 && lower.find("embedding") == -1) {
            return False;
        }
        return lower.find("not found") != -1
            || lower.find("does not exist") != -1
            || lower.find("invalid model") != -1
            || lower.find("unsupported model") != -1
            || lower.find("is not an embedding") != -1
            || lower.find("does not appear to be an embedding") != -1;
    }

    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing embedding vector entry", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    private BgeM3RestClient::BgeM3RestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new BgeM3RestClient::BgeM3RestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "url": config.url ?? DefaultUrl,
            "model": model_name,
        };
        if (config.api_key.val()) {
            opts.apikey = config.api_key;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new BgeM3RestClient::BgeM3RestClientIo(buildRestOptions());
            }
        }
    }
}

#! Factory for @ref BgeM3FastApiEmbedder
public class BgeM3FastApiEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "bge-m3";
    }

    string getDisplayName() {
        return "BGE-M3 FastAPI sidecar embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new BgeM3FastApiEmbedder(config);
    }
}
}
