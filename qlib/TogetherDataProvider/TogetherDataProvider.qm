%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) TogetherRestClient
%requires RestClientIo
%requires OpenApi3
%requires RestSchemaActions

module TogetherDataProvider {
    version = "1.1";
    desc = "user module providing a data provider API for Together AI services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new TogetherDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": TogetherDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Together AI",
            "short_desc": "Inference, files, training, evaluation, and dedicated AI infrastructure",
            "desc": "Use [Together AI](https://www.together.ai) to run and manage AI workloads.\n\n"
                "- Generate chat, images, video, and speech; transcribe audio\n"
                "- Embed content and rerank search results\n"
                "- Manage files, batch inference, fine-tuning, and evaluations\n"
                "- Deploy models and containers, manage GPUs, and route inference traffic\n"
                "- Inspect account identity and billing usage\n\n"
                "**Usage charges apply** to inference, training, and provisioned resources. "
                "Connection pings only read the authenticated model catalog.",
            "scheme": "together",
            "logo": TogetherLogo,
            "logo_file_name": "together-ai-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm, DataProvider::AppGroup::DesignCreative,),
        });

        foreach RestSchemaActionSet set in (TogetherSchema::getActionSets()) {
            foreach hash<DataProviderActionInfo> action in (set.getActionInfoList(TogetherDataProvider::AppName)) {
                action.options = action.options ?? {};
                action.output_type = action.output_type ?? AbstractDataProviderTypeMap."nothing";
                DataProviderActionCatalog::registerAction(action);
            }
        }
    };
}

/** @mainpage TogetherDataProvider Module

    @tableofcontents

    @section togetherdataproviderintro TogetherDataProvider Introduction

    The %TogetherDataProvider module provides a data provider API for
    [Together AI](https://www.together.ai) inference, files, training, evaluation, and infrastructure APIs.

    The following data providers are exposed:
    - @ref TogetherDataProvider::TogetherDataProvider "TogetherDataProvider" — root
    - @ref TogetherDataProvider::TogetherChatCompletionDataProvider "TogetherChatCompletionDataProvider" — chat
    - @ref TogetherDataProvider::TogetherEmbeddingDataProvider "TogetherEmbeddingDataProvider" — embeddings
    - @ref TogetherDataProvider::TogetherImageGenerationDataProvider "TogetherImageGenerationDataProvider" — image generation

    @par Example:
    @code{.py}
%requires TogetherDataProvider

TogetherRestConnection rc = get_connection("together");
TogetherDataProvider::TogetherDataProvider prov(rc.getAsync());

AbstractDataProvider img = prov.getChildProvider("generate-image");
hash<auto> result = img.doRequest({
    "model": "black-forest-labs/FLUX.1-schnell",
    "prompt": "A serene mountain lake at sunrise",
    "width": 1024,
    "height": 1024,
    "steps": 4,
});
printf("Image URL: %s\n", result.data[0].url);
    @endcode

    @section TogetherDataProviderRelnotes Release Notes

    @subsection togetherdataproviderv1_1 TogetherDataProvider v1.1
    - 197 typed REST actions from the official OpenAPI description, covering v1 and v2
    - chat, text, embeddings, reranking, images, speech, transcription, translation, and video
    - files, batch inference, fine-tuning, evaluations, and code execution
    - dedicated models, endpoint deployments, adapters, rollouts, experiments, and analytics
    - containers, queues, GPU clusters, reinforcement learning, identity, and billing usage
    - task-specific model dropdowns and voice dropdowns scoped to the selected speech model
    - project, organization, file, training job, and parent-scoped resource references
    - preserves the original three action IDs and provider classes
    - transport failures are propagated without replaying potentially billable requests
    - file deletion responses accept both documented booleans and the service's textual confirmation

    @par File upload example
    @code{.q}
    TogetherDataProvider provider({"apikey": ENV.TOGETHERAI_APIKEY});
    auto file = provider.getChildProvider("upload-file").doRequest({
        "purpose": "fine-tune", "file_name": "invoices.jsonl",
        "file": {"name": "invoices.jsonl", "content": File::readBinaryFile("invoices.jsonl"),
            "mime_type": "application/jsonl"},
    });
    @endcode

    Uploads accept named FileDataType values or raw binary data. Speech and file download actions
    return binary or text as declared by their response media type. Completed-response actions hide
    SSE switches; TogetherLlmProvider continues to offer streaming chat. The two WebSocket upgrade
    operations are not ordinary request actions.

    @par Testing and costs
    Local tests use recorded responses and a local HTTP server. Set TOGETHERAI_LIVE=1 and
    TOGETHERAI_APIKEY for read-only authentication and listing checks. Paid tests additionally require
    TOGETHERAI_PAID_TESTS=1 and TOGETHERAI_CHAT_MODEL; the chat request is limited to eight output tokens.
    Optional TOGETHERAI_EMBED_MODEL and TOGETHERAI_RERANK_MODEL enable one short request each.
    TOGETHERAI_FILE_TESTS=1 uploads a temporary batch input, verifies metadata and downloaded content,
    and deletes the file on exit. It does not submit a batch job. Set TOGETHER_CONNECTION to exercise
    a saved connection instead of the environment key. Select paid models from the active serverless
    endpoints; the model catalog also includes models that require a dedicated deployment.
    Training and infrastructure provisioning are never started by the test suite.

    @par Updating the schema
    Re-import with tools/rest-schema-import.qr --spec qlib/TogetherDataProvider/together-import.json.
    The provenance records the checksum of the unmodified upstream document. The importer checks each
    declared repair and partitions operations by their explicitly declared v1 or v2 server. Review drift
    before adopting an upstream change. Dropdowns fetch one page and allow custom identifiers when an
    account lacks listing permissions. Dedicated inference and specialized training require the relevant
    account entitlements.

    @subsection TogetherDataProviderv1_0 TogetherDataProvider v1.0
    - initial release
*/

#! contains all public definitions in the TogetherDataProvider module
public namespace TogetherDataProvider {
#! Together AI application name (used as the App key in the action catalog)
public const AppName = "TogetherAi";
}

#! App logo loaded from file
namespace Priv {
const TogetherLogo = File::readTextFile(get_script_dir() + "/together-ai-logo.svg");
}
#! Original exported logo, retained for compatibility
public const TogetherLogo = Priv::TogetherLogo;
