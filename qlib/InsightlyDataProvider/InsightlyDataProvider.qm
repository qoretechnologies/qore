# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) DataProvider
%requires(reexport) InsightlyRestClient
%requires RestClientIo

module InsightlyDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Insightly CRM";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new InsightlyDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": InsightlyDataProvider::AppName,
            "display_name": "Insightly",
            "short_desc": "Insightly CRM integration",
            "desc": "Insightly is a CRM platform for managing contacts, organisations, leads, "
                "opportunities, projects, tasks, notes, calendar events, products, and emails."
                "\n\nThis integration supports full CRUD operations on core CRM objects "
                "and polling-based triggers for new records.",
            "scheme": "insightlyrest",
            "logo": InsightlyLogo,
            "logo_file_name": "insightly-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::CrmSales,),
        });

        # ========== CONTACT ACTIONS ==========

        # Create Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/contacts/create",
            "action": "create-contact",
            "groups": "Contacts",
            "display_name": "Create Contact",
            "short_desc": "Create a new contact",
            "desc": "Create a new contact in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyCreateContactDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyContactDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyCreateContactRequestDataType::Fields),
        });

        # Update Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/contacts/update",
            "action": "update-contact",
            "groups": "Contacts",
            "display_name": "Update Contact",
            "short_desc": "Update an existing contact",
            "desc": "Update an existing contact in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyUpdateContactDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyContactDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyUpdateContactRequestDataType::Fields),
        });

        # Delete Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/contacts/delete",
            "action": "delete-contact",
            "groups": "Contacts",
            "display_name": "Delete Contact",
            "short_desc": "Delete a contact",
            "desc": "Delete a contact from Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyDeleteContactDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyDeleteContactRequestDataType::Fields),
        });

        # List Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/contacts",
            "action": "list-contacts",
            "groups": "Contacts",
            "display_name": "List Contacts",
            "short_desc": "List contacts with optional pagination",
            "desc": "List contacts from Insightly CRM with optional OData pagination",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Get a specific contact",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "contacts",
                },
            } + CommonListActionOptions,
        });

        # Get Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/contacts",
            "action": "get-contact",
            "groups": "Contacts",
            "display_name": "Get Contact",
            "short_desc": "Get a single contact by ID",
            "desc": "Retrieve a single contact by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "contacts",
                },
            },
        });

        # ========== ORGANISATION ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/organisations/create",
            "action": "create-organisation",
            "groups": "Organisations",
            "display_name": "Create Organisation",
            "short_desc": "Create a new organisation",
            "desc": "Create a new organisation in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyCreateOrganisationDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyOrganisationDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyCreateOrganisationRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/organisations/update",
            "action": "update-organisation",
            "groups": "Organisations",
            "display_name": "Update Organisation",
            "short_desc": "Update an existing organisation",
            "desc": "Update an existing organisation in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyUpdateOrganisationDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyOrganisationDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyUpdateOrganisationRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/organisations/delete",
            "action": "delete-organisation",
            "groups": "Organisations",
            "display_name": "Delete Organisation",
            "short_desc": "Delete an organisation",
            "desc": "Delete an organisation from Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyDeleteOrganisationDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyDeleteOrganisationRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/organisations",
            "action": "list-organisations",
            "groups": "Organisations",
            "display_name": "List Organisations",
            "short_desc": "List organisations with optional pagination",
            "desc": "List organisations from Insightly CRM",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Organisation ID",
                    "short_desc": "Get a specific organisation",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "organisations",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/organisations",
            "action": "get-organisation",
            "groups": "Organisations",
            "display_name": "Get Organisation",
            "short_desc": "Get a single organisation by ID",
            "desc": "Retrieve a single organisation by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Organisation ID",
                    "short_desc": "The organisation ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "organisations",
                },
            },
        });

        # ========== LEAD ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/leads/create",
            "action": "create-lead",
            "groups": "Leads",
            "display_name": "Create Lead",
            "short_desc": "Create a new lead",
            "desc": "Create a new lead in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyCreateLeadDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyLeadDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyCreateLeadRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/leads/update",
            "action": "update-lead",
            "groups": "Leads",
            "display_name": "Update Lead",
            "short_desc": "Update an existing lead",
            "desc": "Update an existing lead in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyUpdateLeadDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyLeadDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyUpdateLeadRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/leads/delete",
            "action": "delete-lead",
            "groups": "Leads",
            "display_name": "Delete Lead",
            "short_desc": "Delete a lead",
            "desc": "Delete a lead from Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyDeleteLeadDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyDeleteLeadRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/leads",
            "action": "list-leads",
            "groups": "Leads",
            "display_name": "List Leads",
            "short_desc": "List leads with optional pagination",
            "desc": "List leads from Insightly CRM",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "Get a specific lead",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "leads",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/leads",
            "action": "get-lead",
            "groups": "Leads",
            "display_name": "Get Lead",
            "short_desc": "Get a single lead by ID",
            "desc": "Retrieve a single lead by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Lead ID",
                    "short_desc": "The lead ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "leads",
                },
            },
        });

        # ========== OPPORTUNITY ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/opportunities/create",
            "action": "create-opportunity",
            "groups": "Opportunities",
            "display_name": "Create Opportunity",
            "short_desc": "Create a new opportunity",
            "desc": "Create a new opportunity in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyCreateOpportunityDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyOpportunityDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyCreateOpportunityRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/opportunities/update",
            "action": "update-opportunity",
            "groups": "Opportunities",
            "display_name": "Update Opportunity",
            "short_desc": "Update an existing opportunity",
            "desc": "Update an existing opportunity in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyUpdateOpportunityDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyOpportunityDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyUpdateOpportunityRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/opportunities/delete",
            "action": "delete-opportunity",
            "groups": "Opportunities",
            "display_name": "Delete Opportunity",
            "short_desc": "Delete an opportunity",
            "desc": "Delete an opportunity from Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyDeleteOpportunityDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyDeleteOpportunityRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/opportunities",
            "action": "list-opportunities",
            "groups": "Opportunities",
            "display_name": "List Opportunities",
            "short_desc": "List opportunities with optional pagination",
            "desc": "List opportunities from Insightly CRM",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "Get a specific opportunity",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "opportunities",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/opportunities",
            "action": "get-opportunity",
            "groups": "Opportunities",
            "display_name": "Get Opportunity",
            "short_desc": "Get a single opportunity by ID",
            "desc": "Retrieve a single opportunity by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "The opportunity ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "opportunities",
                },
            },
        });

        # ========== PROJECT ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/projects/create",
            "action": "create-project",
            "groups": "Projects",
            "display_name": "Create Project",
            "short_desc": "Create a new project",
            "desc": "Create a new project in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyCreateProjectDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyProjectDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyCreateProjectRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/projects/update",
            "action": "update-project",
            "groups": "Projects",
            "display_name": "Update Project",
            "short_desc": "Update an existing project",
            "desc": "Update an existing project in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyUpdateProjectDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyProjectDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyUpdateProjectRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/projects/delete",
            "action": "delete-project",
            "groups": "Projects",
            "display_name": "Delete Project",
            "short_desc": "Delete a project",
            "desc": "Delete a project from Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyDeleteProjectDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyDeleteProjectRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/projects",
            "action": "list-projects",
            "groups": "Projects",
            "display_name": "List Projects",
            "short_desc": "List projects with optional pagination",
            "desc": "List projects from Insightly CRM",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Project ID",
                    "short_desc": "Get a specific project",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "projects",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/projects",
            "action": "get-project",
            "groups": "Projects",
            "display_name": "Get Project",
            "short_desc": "Get a single project by ID",
            "desc": "Retrieve a single project by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Project ID",
                    "short_desc": "The project ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "projects",
                },
            },
        });

        # ========== TASK ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/tasks/create",
            "action": "create-task",
            "groups": "Tasks",
            "display_name": "Create Task",
            "short_desc": "Create a new task",
            "desc": "Create a new task in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyCreateTaskDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyTaskDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyCreateTaskRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/tasks/update",
            "action": "update-task",
            "groups": "Tasks",
            "display_name": "Update Task",
            "short_desc": "Update an existing task",
            "desc": "Update an existing task in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyUpdateTaskDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyTaskDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyUpdateTaskRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/tasks/delete",
            "action": "delete-task",
            "groups": "Tasks",
            "display_name": "Delete Task",
            "short_desc": "Delete a task",
            "desc": "Delete a task from Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyDeleteTaskDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyDeleteTaskRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/tasks",
            "action": "list-tasks",
            "groups": "Tasks",
            "display_name": "List Tasks",
            "short_desc": "List tasks with optional pagination",
            "desc": "List tasks from Insightly CRM",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Task ID",
                    "short_desc": "Get a specific task",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "tasks",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/tasks",
            "action": "get-task",
            "groups": "Tasks",
            "display_name": "Get Task",
            "short_desc": "Get a single task by ID",
            "desc": "Retrieve a single task by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Task ID",
                    "short_desc": "The task ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "tasks",
                },
            },
        });

        # ========== NOTE ACTIONS ==========

        # PARENT_TYPE/PARENT_ID are registered inline so that has_dependents propagates
        # to <ActionOptionInfo> -- getActionOptionFromFields() does not propagate it
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/notes/create",
            "action": "create-note",
            "groups": "Notes",
            "display_name": "Create Note",
            "short_desc": "Create a new note",
            "desc": "Create a new note in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyCreateNoteDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyNoteDataType();
            },
            "options": {
                "PARENT_TYPE": <ActionOptionInfo>{
                    "display_name": "Parent Type",
                    "short_desc": "Parent record type",
                    "desc": "The type of record this note will be attached to. Insightly v3.1 "
                        "requires notes to be created under a parent record.",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "allowed_values": LinkSubjectTypeAllowedValues,
                    "example_value": "Contact",
                    "has_dependents": True,
                    "on_change": ("refetch",),
                },
                "PARENT_ID": <ActionOptionInfo>{
                    "display_name": "Parent ID",
                    "short_desc": "Parent record identifier",
                    "desc": "The ID of the parent record (contact, lead, opportunity, "
                        "organisation, or project) this note is attached to",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "depends_on": ("PARENT_TYPE",),
                    "ref_data": "note_parent",
                },
            } + DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyCreateNoteRequestDataType::Fields - ("PARENT_TYPE", "PARENT_ID")),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/notes/update",
            "action": "update-note",
            "groups": "Notes",
            "display_name": "Update Note",
            "short_desc": "Update an existing note",
            "desc": "Update an existing note in Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyUpdateNoteDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new InsightlyNoteDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyUpdateNoteRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InsightlyDataProvider::AppName,
            "path": "/notes/delete",
            "action": "delete-note",
            "groups": "Notes",
            "display_name": "Delete Note",
            "short_desc": "Delete a note",
            "desc": "Delete a note from Insightly CRM",
            "action_code": DPAT_API,
            "data_provider_info": InsightlyDeleteNoteDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                InsightlyDeleteNoteRequestDataType::Fields),
        });

