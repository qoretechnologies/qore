# minimum required Qore version
%requires qore >= 2.0
%requires(reexport) DebugUtil

%modern
%no-debugging
%allow-debugger
# child program won't inherit parent program options (including %allow-debugger)
%no-child-restrictions

module DebugProgramControl {
    version = "0.1.3";
    desc = "user module providing common debug server stuff";
    author = "Tomas Mandys <tomas.mandys@qoretechnologies.org>";
    url = "http://qoretechnologies.org";
    license = "MIT";
}

/** @mainpage DebugProgramControl Module

    @tableofcontents

    @section debugprogramcontrolintro Introduction to the DebugProgramControl Module

    The %DebugProgramControl module provides common functionality for implementing debugger server utilities

    @subsection dc_v0_1_3 v0.1.3
    - a stopped thread answers every command of a client, a command without a result with an empty hash, and a
      command queued for a thread that resumed is answered with an error, so that a client can wait for the answer
      without a timeout
    - a statement can be given as a function name without the types of its parameters when the function has one
      variant (<a href="https://github.com/qoretechnologies/qore/issues/5558">issue 5558</a>)
    - new commands of stopped threads: \c thread/variable/get and \c thread/variable/set read and set the values of
      variables and their elements, keys and members, also private ones, by their paths, and \c thread/evaluate
      (with \c serialize, also the whole value in \c serialized); expressions can refer to all code of the program
      (see @ref Qore::ProgramControl::createEvalProgram() "ProgramControl::createEvalProgram()")
      evaluates expressions with the variables of a frame (see
      @ref DebugProgramControl::DebugProgramControl::evaluateExpression() "evaluateExpression()")
    - added @ref DebugProgramControl::DebugProgramControl::captureOutput() "captureOutput()", which sends the output of
      the process to the clients as \c "output" events, and
      @ref DebugProgramControl::DebugProgramControl::setOutputCapture() "setOutputCapture()"; the output that a thread
      writes before an interrupt is sent before the interrupt
    - interrupt events of exceptions give \c uncaught: @ref True if no try statement of debuggable code in the call
      stack catches the exception
    - breakpoints have conditions, hit conditions and log messages, which all clients share and the thread that hits
      a breakpoint checks before it stops: the \c condition, \c hitcondition and \c log commands of
      \c program//breakpoint/<id> set and get them, \c breakpoint//create takes them in its value (\c condition,
      \c hitCondition and \c logMessage), and breakpoint lists give them with the number of \c hits; a logpoint and
      an error evaluating a condition are sent to the clients as \c "console" output events, and an interrupt of a
      breakpoint whose condition could not be evaluated gives the error in \c bkpterror; all breakpoints of the
      statement that apply to the thread are checked, and the interrupt gives those that stop it in \c bkptids; the
      \c thread/breakpoint/check command checks breakpoints for a thread that stopped at their statement for another
      reason (see @ref DebugProgramControl::DebugProgramControl::checkBreakpoint() "checkBreakpoint()")
    - at the stop at the start of a program (the \c attach interrupt), the thread has not entered the code of the
      program: expressions are evaluated with the code and the global variables of the program, and no local variables
      are read, as the frames are those of the code that started the program; reading them failed
    - the \c program/<id>/statement/stepintargets command gives the calls of a statement that can be stepped into
      (see @ref Qore::ProgramControl::getStepInTargets() "ProgramControl::getStepInTargets()"); stepping over with the
      statement of a target as the statement to run to steps into the call
    - a statement can be given by its line and its 0-based byte \c column, for a breakpoint on a statement of a line
      with more than one statement; the \c program/<id>/statement/list command gives the statements of a line with
      their columns, and interrupt events and the frames of call stacks give the columns of their statements in
      \c column and \c endcolumn where they are known
    - interrupt events give the name of the thread in \c threadname, and program lists give the current names of the
      threads of programs in \c threadNames
    - @ref DebugProgramControl::DebugProgramControl::createProgram() "createProgram()" parses a script in the mode
      that the interpreter gives its file: in @ref modern "%modern" mode unless its name ends in \c .q (see
      @ref Qore::Program::applySourceDefaults() "Program::applySourceDefaults()")

    @subsection dc_v0_1_2 v0.1.2
    - return breakpointId and statementId when creating breakpoint
    - onExit() event
    - frameId argument for thread/local command
    - source file API
    - options API

    @subsection dc_v0_1_1 v0.1.1
    - fixed bug providing programId context (<a href="https://github.com/qoretechnologies/qore/issues/2603">issue 2603</a>)
    - improved breakpoint usability (<a href="https://github.com/qoretechnologies/qore/issues/2604">issue 2604</a>)

    @subsection dc_v0_1 v0.1
    - initial release
*/

#! the DebugProgramControl namespace contains all the definitions in the DebugProgramControl module
public namespace DebugProgramControl {
    #! Class implementing @ref Qore::DebugProgram "DebugProgram" control using commands
    public class DebugProgramControl inherits DebugProgram, AbstractDebugControl {
        private {
            #! data pool related to suspended thread, key is threadId
            hash<auto> ctxThread;
            #! data pool for data related to cx.id
            hash<auto> ctxConnection;
            #! lock for @ref ctxThread access
            Qore::Thread::RWLock rwlThread();
            #! lock for @ref ctxConnection access
            Qore::Thread::RWLock rwlConnection();
            #! server name
            string serverName;
            #! source file search path
            string sourceSearchPath = "";

            #! the capture of the output of the process, which is flushed before an interrupt is sent; see
            #! captureOutput() and setOutputCapture()
            *DebugOutputCapture outputCapture;
            #! True if this object created outputCapture and sends the output to the clients
            bool ownOutputCapture;

            #! number of frames related to DebugProgramControl library when handleInterrupt() is invoked
            const frameOffset = 2;

            #! the prefix of the names of the functions that expressions are evaluated in; see evaluateExpression()
            const EvalFunction = "qore_debug_evaluate";
            #! the maximum number of expressions that are kept compiled for a Program; see evaluateExpression()
            const MaxEvalFunctions = 256;

            #! the Programs that expressions are evaluated in, by the ID of the debugged Program
            /** each with the \c program, the names of the compiled \c functions by expression and variable names,
                the number \c n of functions, and the number of evaluations that are running in the program
                (\c calls); see evaluateExpression()
            */
            hash<string, hash<auto>> evalPrograms = {};
            #! serializes the access to evalPrograms and the parsing of expressions
            Mutex evalLock();
            #! the name of the parameter of the function that an expression is evaluated in
            const EvalVars = "qore_debug_vars";

            #! the conditions, hit conditions and log messages of breakpoints, which all clients share, by breakpoint ID
            /** each with the optional \c condition, \c hitCondition and \c logMessage, and the number of \c hits of
                the breakpoint with its condition true; see checkBreakpoint()
            */
            hash<string, hash<auto>> bkptOptions = {};
            #! serializes the access to bkptOptions
            Mutex bkptLock();

            #! the options of breakpoints that are kept in bkptOptions
            const BreakpointOptions = ("condition", "hitCondition", "logMessage");
            #! the options of breakpoints by the names of their commands
            const BreakpointCommandOptions = {
                "condition": "condition",
                "hitcondition": "hitCondition",
                "log": "logMessage",
            };
        }
        public {
            #! default number of lines listed before current code position
            const DEFAULT_LINES_BEFORE = 3;
            #! default number of lines listed after current code position
            const DEFAULT_LINES_AFTER = 3;
        }

        #! creates the object
        constructor(string serverName, *LoggerInterface logger) : AbstractDebugControl(logger) {
            self.serverName = serverName;
        }

        #! Captures the output of the process and sends it to all clients as output events
        /** The standard output and standard error of the process, which debugged programs write to, are sent to the
            clients as \c "output" events (@ref DebugUtil::DebugEventCmd::Output) with the \c category (\c "stdout"
            or \c "stderr") and the \c output; the output written before an interrupt is sent before it.

            @param tee if @ref True, the output is also written to the original stdout and stderr

            @return @ref True if the output is captured, @ref False if it is already captured or cannot be captured
            on this platform

            @see stopOutputCapture()
        */
        public bool captureOutput(bool tee = True) {
            if (outputCapture) {
                return False;
            }
            DebugOutputCapture capture(\broadcastOutput(), NOTHING, tee);
            if (!capture.start()) {
                return False;
            }
            outputCapture = capture;
            ownOutputCapture = True;
            return True;
        }

        #! Returns the capture of the output, if the output is captured
        public *DebugOutputCapture getOutputCapture() {
            return outputCapture;
        }

        #! Sets the capture of the output of the process, which is flushed before an interrupt is sent
        /** For a client in this process, such as a debug adapter, that captures the output itself; the output written
            by a thread before it is interrupted reaches the client before the interrupt
        */
        public setOutputCapture(*DebugOutputCapture capture) {
            if (ownOutputCapture) {
                throw "DEBUG-ERROR", "the output is already captured by captureOutput()";
            }
            outputCapture = capture;
        }

        #! Restores stdout and stderr after captureOutput(), after the output written before has been sent
        public stopOutputCapture() {
            if (!ownOutputCapture) {
                return;
            }
            outputCapture.stop();
            remove outputCapture;
            ownOutputCapture = False;
        }

        #! Sends output of the process to all clients
        private broadcastOutput(string category, string output) {
            try {
                broadcastDataImpl({
                    "type": DebugResponseType::Event,
                    "cmd": DebugEventCmd::Output,
                    "stamp": now_us(),
                    "category": category,
                    "output": output,
                });
            } catch (hash<ExceptionInfo> ex) {
                # the output is not sent to a client that cannot be reached
            }
        }

        #! resumes any blocked threads and destroys the object
        destructor() {
            try {
                shutdown();
            } catch () {
                # suppress exceptions during program shutdown (PROGRAM-ERROR)
            }
        }

        #! resume any blocked threads
        shutdown() {
            rwlThread.writeLock();
            on_exit rwlThread.writeUnlock();

            hash<auto> qrd = {
                "data": {
                    "cmd": "thread/go",
                },
                "cx": {},
            };

            map $1.queue.push(qrd), ctxThread.iterator(), $1.queue;
        }

        #! register context for new connection
        public registerConnection(hash<auto> cx) {
            rwlConnection.writeLock();
            on_exit rwlConnection.writeUnlock();
            ctxConnection{cx.id} = {"program": {}};
            # Note: we cannot sendDataImpl/broadcaseDataImpl as cx.id not registered in WebSocketHandler
        }

        #! send welcome message
        public connectionRegistered(hash<auto> cx) {
            hash<auto> sd.type = DebugResponseType::Event;
            sd.stamp = now_us();
            sd.cmd = DebugEventCmd::Welcome;
            sd.result = serverName;
            try {
                sendDataImpl(cx, sd);
            }
            catch (hash<ExceptionInfo> ex) {
            }
        }

        #! unregister a connection context
        public unregisterConnection(hash<auto> cx) {
            rwlConnection.writeLock();
            on_exit rwlConnection.writeUnlock();

            # remove attached programs
            map removeProgram($1), ctxConnection{cx.id}.program.iterator();

            delete ctxConnection{cx.id};
            # if (!ctxConnection)  run stopped programs ?
        }

        #! unregister all connections
        public unregisterAllConnections() {
            rwlConnection.writeLock();
            on_exit rwlConnection.writeUnlock();
            foreach string id in (keys ctxConnection) {
                map removeProgram($1), ctxConnection{id}.program.iterator();
                delete ctxConnection{id};
            }
        }

        #! get list of connection ids
        /**
            Note: Calling party should consider threads calling class register/unregister methods
        */
        public list<auto> getConnectionIds() {
            rwlConnection.readLock();
            on_exit rwlConnection.readUnlock();
            return (keys ctxConnection) ?? ();
        }

        #! send data to particular client
        abstract public sendDataImpl(hash<auto> cx, auto data);
        #! send data to all clients
        abstract public broadcastDataImpl(auto data);

        private broadcastBreakpoint(hash<auto> cx, Breakpoint b, string change) {
            hash<auto> sd = {
                'type': DebugResponseType::Event,
                'cmd': DebugEventCmd::Breakpoint,
                'event': change,
                'info': getBreakpointInfo(b),
                'stamp': now_us(),
            };
            broadcastDataImpl(sd);
        }

        #! Create new program
        public Program createProgram(string fileName, *hash<auto> opts, list<auto> args, *string script) {
            debug("create program: %y", fileName);
            # must set PO_NO_CHILD_PO_RESTRICTIONS in order to avoid parse options being locked in the child
            Program pgm(PO_NO_CHILD_PO_RESTRICTIONS);
            # restore default options as we have PO_NO_CHILD_PO_RESTRICTIONS
            # note this program has PO_NO_TOP_LEVEL_STATEMENTS | PO_NEW_STYLE
            #pgm.replaceParseOptions(PO_DEFAULT);
            if (exists opts.parse_option) {
                hash<auto> poops = Qore::ParseOptionCmdStringMap;
                int oo = 0;
                foreach string o in (opts.parse_option) {
                    if (!exists poops{o}) {
                        throw "DEBUG-CREATE-PROGRAM", sprintf("Unknown parse option %y", o);
                    }
                    oo |= poops{o};
                }
                pgm.setParseOptions(oo);
            }
            if (opts.define) {
                foreach string d in (opts.define) {
                    int i = bindex(d, "=");
                    if (i >= 0) {
                        pgm.define(substr(d, 0, i), substr(d, i+1));
                    } else {
                        pgm.define(d);
                    }
                }
            }
            if (exists opts.time_zone) {
                # TODO: parse exact shifts
                pgm.setTimeZoneRegion(opts.time_zone);
            }
            # update arguments without debug options
            pgm.setGlobalVarValue('ARGV', args);
            pgm.define('QoreDebugging', True);   # TODO: vs. QoreDebug define, better name ?
            debug("add program");
            addProgram(pgm.getProgram());

            if ((script ?? '') == '') {
                if (fileName == '/dev/stdin') {  # is exception needed ??
                    debug("read stdin");
                    script = stdin.read(-1, 0);
                    debug("%s", script);
                } else {
                    debug("read file: %y", fileName);
                    script = ReadOnlyFile::readTextFile(fileName);
                }
            }
            pgm.setScriptPath(fileName);
            # the source is parsed as the interpreter would parse the file, in %modern mode unless it is a .q file
            pgm.applySourceDefaults(fileName);
            debug("parse code");
            *hash<auto> wh = pgm.parse(script, fileName, WARN_DEFAULT, NOTHING, NOTHING, False);
            if (wh) {
                warn("warning: %Y", wh);
            }
            return pgm;
        }

        #! run and remove program from debugging
        private *int runAndDetach(Program pgm) {
            *int res = pgm.run();
            removeProgram(pgm.getProgram()); # I would be called in Program::destructor() but this is more transparent
            return res;
        }

        #! process message in debugging thread, if message is related to debugged thread then put it in particular queue
        public *hash<auto> processCommand(hash<auto> cx, hash<auto> receiveData) {
            debug("processCommand: %y", receiveData);
            hash<auto> sendData;
            auto result;
            try {
                list<auto> cmd = receiveData.cmd.split('/');
                debug("command: %y", cmd);

                switch (shift cmd) {
                    case 'help':
                        result = (
                            "version",
                            "options/<name>/(get|set)",
                            "session/(get|set)",
                            "program/<pgmid>/(list|create|add|remove|stop|thread|global|define|options|file|label|statement|breakpoint)",
                            "thread/(stack|<tid>/...)",
                        );
                        break;
                    case 'version':
                        hash<auto> mods = get_module_hash();
                        result = {
                            'class': self.className(),
                            'DebugProgramControl': mods.DebugProgramControl.version ?? "n/a",
                            'DebugUtil': mods.DebugUtil.version ?? "n/a",
                            'qore': Qore::VersionString,
                        };
                        break;
                    case 'options':
                        string optionName = shift cmd;
                        bool optionSet;
                        switch (shift cmd) {
                            case 'get':
                                optionSet = False;
                                break;
                            case 'set':
                                optionSet = True;
                                break;
                        }
                        if (exists optionSet) {
                            switch (optionName) {
                                case 'fullexceptioninfo':
                                    if (optionSet) {
                                        showFullException = receiveData.value;
                                    }
                                    result = showFullException;
                                    break;
                                case 'sourcepath':
                                    if (optionSet) {
                                        sourceSearchPath = receiveData.value;
                                    }
                                    result = sourceSearchPath;
                                    break;
                                case 'verbose':
                                    if (optionSet) {
                                        logger.setLevel(receiveData.value);
                                    }
                                    result = logger.getLevel().getStr();
                                    break;
                            }
                        }
                        break;
                    case 'session':
                        switch (shift cmd) {
                            case 'get':
                                foreach ProgramControl p in (getAllPrograms()) {
                                    int pgmId = p.getProgramId();
                                    result{pgmId}.scriptName = p.getScriptName();
                                    result{pgmId}.scriptPath = p.getScriptPath();
                                    #result{pgmId}.scriptDir = p.getScriptDir();
                                    {
                                        rwlThread.readLock();
                                        on_exit rwlThread.readUnlock();
                                        foreach softint tid in (keys ctxThread) {
                                            if (ctxThread{tid}.pgmId == pgmId) {
                                                result{pgmId}.interrupted += (tid,);
                                            }
                                        }
                                    }
                                    result{pgmId}.breakpoints = ();
                                    foreach Breakpoint b2 in (p.getBreakpoints()) {
                                        push result{pgmId}.breakpoints, getBreakpointInfo(b2);
                                    }
                                    if (!result{pgmId}.breakpoints) {
                                        remove result{pgmId}.breakpoints;
                                    }
                                }
                                break;
                            case 'set':
                                debug("set session: %y", receiveData.value);
                                # go through provided list and match current programs, no sophisticated matching algorithm
                                result = hash();
                                foreach string pgmName in (keys receiveData.value) {
                                    hash<auto> pgm = receiveData.value{pgmName};
                                    try {
                                        ProgramControl p = ProgramControl::resolveProgramId(int(pgmName));
                                        if (pgm.scriptName != p.getScriptName()) {
                                            throw 'PROGRAM-ERROR', sprintf('script name does not match: %y vs. %y', pgm.scriptName, p.getScriptName());
                                        }
                                        foreach hash<auto> bkpt in (pgm.breakpoints) {
                                            Breakpoint b = new Breakpoint();
                                            if (exists bkpt.enabled) {
                                                b.setEnabled(AbstractDebugControl::boolStrings{bkpt.enabled});
                                            }
                                            if (exists bkpt.policy) {
                                                b.setPolicy(AbstractDebugControl::policyStrings{bkpt.policy});
                                            }
                                            if (bkpt.threads) {
                                                b.setThreadIds(bkpt.threads);
                                            }
                                            b.assignProgram(p);
                                            foreach hash<auto> stmt in (bkpt.statements) {
                                                # assing by id is the easiest way
                                                try {
                                                    b.assignStatement(resolveStatement(p, ('id': stmt.id)));
                                                } catch (hash<ExceptionInfo> ex) {
                                                    result{pgmName} += list(ex.desc);
                                                }
                                            }
                                        }
                                    } catch (hash<ExceptionInfo> ex) {
                                        if (ex.err == 'PROGRAM-ERROR') {
                                            result{pgmName} = ex.desc;
                                        } else {
                                        rethrow;
                                    }
                                    }
                                }
                                break;
                        }
                        break;
                    case 'program':
                        ProgramControl pgmb;
                        *string pgmName = shift cmd;
                        switch (cmd[0]) {
                            case 'list':
                                break;
                            case 'create':
                                break;
                            case 'breakpoint':
                                if (pgmName == '') {
                                    break;  # pgmId is assigned to breakpoint so it is optional
                                }
                                # nobreak;
                            default:
                                pgmb = ProgramControl::resolveProgramId(int(pgmName));
                        }
                        switch (shift cmd) {
                            case 'stop':
                                # no locking
                                switch (breakProgram(pgmb)) {
                                    case 0:
                                        result = 'ok';
                                        break;
                                    case -1:
                                        result = "ERROR: operation failed; target Program does not support debugging (PO_NO_DEBUGGING set)";
                                        break;
                                    case -2:
                                        result = "ERROR: operation failed; target Program has not yet been added as a debug target; add the program first and try again";
                                        break;
                                }
                                break;

                            case 'thread':
                                softint tid = shift cmd;
                                switch (shift cmd) {
                                    case 'stop':
                                        switch (breakProgramThread(pgmb, tid)) {
                                            case 0:
                                                result = 'ok';
                                                break;
                                            case -1:
                                                result = "ERROR: operation failed; target Program does not support debugging (PO_NO_DEBUGGING set)";
                                                break;
                                            case -2:
                                                result = "ERROR: operation failed; target Program has not yet been added as a debug target; add the program first and try again";
                                                break;
                                            case -3:
                                                result = sprintf("ERROR: operation failed; TID %d not active in target Program", tid);
                                                break;
                                        }
                                        break;
                                }
                                break;

                            case 'list':
                                foreach ProgramControl p in (ProgramControl::getAllPrograms()) {
                                    string pgmId = string(p.getProgramId());
                                    if (AbstractDebugControl::evalCondition((pgmName =~ /^=[0-9]+$/) ? pgmId : (p.getScriptName() ?? ""), pgmName)) {
                                        result{pgmId} = getProgramInfo(p, receiveData.listFiles);
                                    }
                                }
                                map result{$1.getProgramId()}.debugged = True, getAllPrograms(), exists result{$1.getProgramId()};
                                {
                                    rwlThread.readLock();
                                    on_exit rwlThread.readUnlock();
                                    foreach softint tid in (keys ctxThread) {
                                        if (exists ctxThread{tid}.pgmId && exists result{ctxThread{tid}.pgmId}) {
                                            result{ctxThread{tid}.pgmId}.interrupted += list(tid);
                                        }
                                    }
                                }
                                break;
                            case 'create':
                                Program pgm = createProgram(receiveData.filename, NOTHING, receiveData.args);
                                ProgramControl p = pgm.getProgram();
                                result{string(p.getProgramId())} = getProgramInfo(p, True, ((background runAndDetach(pgm)), ));
                                break;
                            case 'add':
                                {
                                    rwlConnection.writeLock();
                                    on_exit rwlConnection.writeUnlock();
                                    reference r = \ctxConnection{cx.id}.program{pgmb.getProgramId()};
                                    if (r) {
                                        result = sprintf('program ID %d already added', pgmb.getProgramId());
                                        break;
                                    }
                                    r = pgmb;
                                }
                                addProgram(pgmb);
                                result = 'ok';
                                break;

                            case 'remove':
                                {
                                    rwlConnection.writeLock();
                                    on_exit rwlConnection.writeUnlock();
                                    reference r = \ctxConnection{cx.id}.program{pgmb.getProgramId()};
                                    if (!r) {
                                        result = sprintf('program ID %d not added', pgmb.getProgramId());
                                        break;
                                    }
                                    remove r;
                                }
                                removeProgram(pgmb);
                                result = 'ok';
                                break;

                            case 'global':
                                string varName = shift cmd;
                                switch (shift cmd) {
                                    case 'set':
                                        pgmb.setGlobalVarValue(varName, AbstractDebugControl::unserialize(receiveData.value));
                                        result = 'ok';
                                        break;

                                    case 'get':
                                        bool existF;
                                        auto v = AbstractDebugControl::serialize(pgmb.getGlobalVariable(varName, \existF));
                                        if (existF) {
                                            result = v;
                                        }
                                        break;

                                    case 'list':
                                        softlist l  = keys pgmb.getGlobalVars();
                                        foreach my string s in (\l) {
                                            s =~ s/^Qore:://;
                                        }
                                        result = AbstractDebugControl::enumFilter(l, varName);
                                        break;
                                }
                                break;

                            case 'define':
                                string defName = shift cmd;
                                switch (shift cmd) {
                                    case 'get':
                                        if (pgmb.isDefined(defName)) {
                                            result = pgmb.getDefine(defName);
                                        }
                                        bool existF;
                                        auto v = pgmb.getGlobalVariable(defName, \existF);
                                        if (existF) {
                                            result = v;
                                        }
                                        break;

                                    case 'list':
                                        *hash<auto> defs = pgmb.getAllDefines();
                                        list<auto> dd = AbstractDebugControl::enumFilter(keys defs, defName);
                                        result = hash();
                                        map result{$1} = defs{$1}, dd;
                                        break;
                                }
                                break;

                            case 'options':
                                int opts = pgmb.getParseOptions();
                                result = ();
                                foreach string o in (keys ParseOptionCodeMap) {
                                    softint oo = o;
                                    if (oo != 0 && (oo & opts) == oo) {
                                        push result, ParseOptionCodeMap{o};
                                    }
                                }
                                break;

                            case 'file':
                                switch (shift cmd) {
                                    case 'list':
                                        result = pgmb.getSourceFileNames();
                                        break;
                                    case 'source':
                                        result = getSourceCode(pgmb, 'file', receiveData);
                                        break;
                                }
                                break;

                            case 'label':
                                switch (shift cmd) {
                                    case 'list':
                                        result = pgmb.getSourceLabels();
                                        break;
                                    case 'source':
                                        result = getSourceCode(pgmb, 'label', receiveData);
                                        break;
                                }
                                break;

                            case 'statement':
                                switch (shift cmd) {
                                    case 'list':
                                        if (!exists receiveData.value.lineno) {
                                            throw "DEBUG-HANDLER-ERROR", "the line of the statements is missing "
                                                "(value.lineno)";
                                        }
                                        result = getLineStatements(pgmb, receiveData.value.file ?? '',
                                            receiveData.value.lineno);
                                        break;
                                    case 'stepintargets':
                                        result = pgmb.getStepInTargets(resolveStatement(pgmb, receiveData.value));
                                        break;
                                    case 'get':
                                        int sid = resolveStatement(pgmb, receiveData.value);
                                        result = hash(pgmb.getStatementIdInfo(sid, True));
                                        list<auto> bkpts =remove result.breakpoints;
                                        result.id = sid;
                                        result.breakpoints = ();
                                        foreach Breakpoint b2 in (bkpts) {
                                            push result.breakpoints, getBreakpointInfo(b2, False);
                                        }
                                        break;
                                }
                                break;

                            case 'breakpoint':
                                Breakpoint b;
                                string bkptName = shift cmd;
                                switch (cmd[0]) {
                                    case 'list':
                                        break;
                                    case 'create':
                                        if (!pgmb) {
                                            throw "DEBUG-HANDLER-ERROR", "Program is not specified";
                                        }
                                        int stmt;
                                        if (receiveData.value) {
                                            stmt = resolveStatement(pgmb, receiveData.value);
                                            # the options are checked before the breakpoint is created
                                            map DebugProgramControl::validateBreakpointOption($1,
                                                receiveData.value{$1}), BreakpointOptions;
                                        }
                                        b = new Breakpoint();
                                        b.setEnabled(True);
                                        b.assignProgram(pgmb);
                                        result.bkptid = b.getBreakpointId();
                                        if (exists stmt) {
                                            b.assignStatement(stmt);
                                            result.stmtid = stmt;
                                        }
                                        # the condition, hit condition and log message of the breakpoint
                                        if (receiveData.value) {
                                            foreach string opt in (BreakpointOptions) {
                                                if (receiveData.value{opt}.val()) {
                                                    setBreakpointOption(b.getBreakpointId(), opt,
                                                        receiveData.value{opt});
                                                }
                                            }
                                        }
                                        break;
                                    default:
                                        b = Breakpoint::resolveBreakpointId(int(bkptName));
                                        if (pgmb && b.getProgram().getProgramId() != pgmb.getProgramId()) {
                                            throw "DEBUG-HANDLER-ERROR", sprintf("Program %y is not assigned to breakpoint %y", pgmb.getProgramId(), b.getBreakpointId());
                                        }
                                        break;
                                }
                                string bkptCmd = shift cmd ?? "";
                                switch (bkptCmd) {
                                    case 'list':
                                        if (pgmb) {
                                            list<auto> bkpts =pgmb.getBreakpoints();
                                            result = ();
                                            foreach Breakpoint b2 in (bkpts) {
                                                if (AbstractDebugControl::evalCondition(b2.getBreakpointId(), bkptName)) {
                                                    push result, getBreakpointInfo(b2);
                                                }
                                            }
                                        } else {
                                            result = ();
                                            foreach ProgramControl p in (ProgramControl::getAllPrograms()) {
                                                if ((p.getParseOptions() & PO_NO_DEBUGGING) == 0) {
                                                    foreach Breakpoint b2 in (p.getBreakpoints()) {
                                                        if (AbstractDebugControl::evalCondition(b2.getBreakpointId(), bkptName)) {
                                                            push result, getBreakpointInfo(b2);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        break;

                                    case 'create':
                                        # already done
                                        broadcastBreakpoint(cx, b, "create");
                                        break;

                                    case 'delete':
                                        broadcastBreakpoint(cx, b, "delete");
                                        b.unassignProgram();
                                        b.clearThreadIds();
                                        list<auto> sl = b.getStatementIds();
                                        foreach int s in (sl) {
                                            b.unassignStatement(s);
                                        }
                                        # delete b;   ??
                                        {
                                            AutoLock al(bkptLock);
                                            remove bkptOptions{b.getBreakpointId()};
                                        }
                                        result = 'ok';
                                        break;

                                    case 'enable':
                                        if (!b.getEnabled()) {
                                            b.setEnabled(True);
                                            broadcastBreakpoint(cx, b, "enabled");
                                        }
                                        result = 'ok';
                                        break;

                                    case 'disable':
                                        if (b.getEnabled()) {
                                            b.setEnabled(False);
                                            broadcastBreakpoint(cx, b, "disabled");
                                        }
                                        result = 'ok';
                                        break;

                                    case 'statement':
                                        switch (shift cmd) {
                                            case 'list':
                                                result = hash();
                                                foreach int sid in (b.getStatementIds()) {
                                                    result{sid} = b.getProgram().getStatementIdInfo(sid);
                                                }
                                                break;

                                            case 'assign':
                                                int stmt = resolveStatement(b.getProgram(), receiveData.value);
                                                b.assignStatement(stmt);
                                                result.stmtid = stmt;
                                                broadcastBreakpoint(cx, b, "statement");
                                                break;

                                            case 'unassign':
                                                int stmt = resolveStatement(b.getProgram(), receiveData.value);
                                                b.unassignStatement(stmt);
                                                result.stmtid = stmt;
                                                broadcastBreakpoint(cx, b, "statement");
                                                break;
                                        }
                                        break;

                                    case 'thread':
                                        list<auto> saveThreadIds = b.getThreadIds();
                                        switch (shift cmd) {
                                            case 'add':
                                                b.addThreadId(receiveData.value);
                                                result = 'ok';
                                                break;
                                            case 'remove':
                                                b.removeThreadId(receiveData.value);
                                                result = 'ok';
                                                break;
                                            case 'get':
                                                result = b.getThreadIds();
                                                break;
                                            case 'set':
                                                *softlist sl = receiveData.value;
                                                b.setThreadIds(sl);
                                                result = 'ok';
                                                break;
                                        }
                                        if (saveThreadIds != b.getThreadIds()) {
                                            broadcastBreakpoint(cx, b, "thread");
                                        }
                                        break;

                                    case 'condition':
                                    case 'hitcondition':
                                    case 'log': {
                                        string opt = BreakpointCommandOptions{bkptCmd};
                                        switch (shift cmd) {
                                            case 'get':
                                                # an option that is not set is empty, as for set
                                                result = getBreakpointOptions(b.getBreakpointId()){opt} ?? "";
                                                break;
                                            case 'set':
                                                setBreakpointOption(b.getBreakpointId(), opt, receiveData.value);
                                                broadcastBreakpoint(cx, b, bkptCmd);
                                                result = 'ok';
                                                break;
                                            default:
                                                throw "DEBUG-HANDLER-ERROR", sprintf("expecting get or set after %y",
                                                    bkptCmd);
                                        }
                                        break;
                                    }

                                    case 'policy':
                                        switch (shift cmd) {
                                            case 'get':
                                                result = encodeValue('policy', string(b.getPolicy()), policyStrings);
                                                break;
                                            case 'set':
                                                int savePolicy = b.getPolicy();
                                                b.setPolicy(resolveValue('policy', receiveData.value, policyStrings, b.getPolicy()));
                                                if (savePolicy != b.getPolicy()) {
                                                    broadcastBreakpoint(cx, b, "policy");
                                                }
                                                result = 'ok';
                                                break;
                                        }
                                        break;
                                }

                                break;
                        }
                        break;

                    case 'shutdown':
                        shutdown();
                        result = 'ok';
                        break;

                    case 'thread': {
                        bool break_flag = False;
                        if (!exists receiveData.tid) {
                            switch (cmd[0]) {
                                case 'stack':
                                    # the stacks are returned in an untyped hash, as the adjusted stacks are lists of
                                    # untyped frames
                                    hash<auto> stacks = {};
                                    foreach hash<auto> i in (get_all_thread_call_stacks().pairIterator()) {
                                        rwlThread.readLock();
                                        on_exit rwlThread.readUnlock();
                                        if (exists ctxThread{i.key}) {
                                            stacks{i.key} = adjustStack(i.value, ctxThread{i.key});
                                        } else {
                                            stacks{i.key} = i.value;
                                        }
                                    }
                                    result = stacks;
                                    break_flag = True;
                                    break;
                            }
                        }
                        if (break_flag) {
                            break;
                        }
                        # no break and pass to default
                    }

                    default:
                        if (exists receiveData.tid) {
                            rwlThread.readLock();
                            on_exit rwlThread.readUnlock();
                            if (ctxThread{receiveData.tid}) {
                                ctxThread{receiveData.tid}.queue.push({'cx': cx, 'data': receiveData});
                                sendData.type = DebugResponseType::Thread;
                                sendData.tid = receiveData.tid;
                            } else {
                                throw "DEBUG-HANDLER-ERROR", sprintf("threadId %y is not stopped", receiveData.tid);
                            }
                        } else {
                            throw "DEBUG-HANDLER-ERROR", sprintf("cannot process command %y", receiveData.cmd);
                        }
                }
                if (exists result) {
                    sendData.type = DebugResponseType::Response;
                }
            } catch (hash<ExceptionInfo> ex) {
                @debug(sprintf("processCommand exception: %y", ex));
                sendData.type = DebugResponseType::Error;
                result.err = ex.err;
                result.desc = ex.desc;
                if (showFullException) {
                    result.ex = ex;
                }
            }
            if (sendData) {
                sendData.uid = receiveData.uid;
                sendData.cmd = receiveData.cmd;
                sendData.stamp = now_us();
                sendData.result = result;
                return sendData;
            }
        }

        private auto resolveValue(string name, *string val, hash<auto> strings, auto defVal) {
            if (exists val) {
                if (!exists strings{val}) {
                    throw "DEBUG-HANDLER-ERROR", sprintf("%y value %y is not found in %y", name, val, keys strings);
                }
                return strings{val};
            } else {
                return defVal;
            }
        }

        private string encodeValue(string name, auto val, hash<auto> strings) {
            foreach string k in (keys strings) {
                if (strings{k} == val) {
                    return k;
                }
            }
            throw "DEBUG-HANDLER-ERROR", sprintf("Cannot encode %y value %y", name, val);
        }

        private int resolveStatement(ProgramControl pgm, *hash<auto> value) {
            if (exists value.id) {
                return value.id;
            }
            if (exists value.function) {
                if (!exists value.args) {
                    # a function given by its name only is the function's only variant
                    list<hash<auto>> variants = pgm.findFunctionVariants(value.function);
                    if (variants.size() != 1) {
                        throw "DEBUG-HANDLER-ERROR", sprintf("%y has %d variants; give the parameter types of one "
                            "of them: %s", value.function, variants.size(), (map $1.desc, variants).join(", "));
                    }
                    return pgm.findFunctionStatementId(value.function, variants[0].params);
                }
                return pgm.findFunctionStatementId(value.function, value.args);
            }
            if (exists value.lineno) {
                if (exists value.column) {
                    return findColumnStatement(pgm, value.file ?? '', value.lineno, value.column);
                }
                return pgm.findStatementId(value.file ?? '', value.lineno);
            }
            throw "DEBUG-HANDLER-ERROR", sprintf("Cannot resolve statement from %y", value);
        }

        #! Returns the ID of the statement of a column of a line
        /** @param pgm the Program
            @param file the file or the label of the source
            @param line the line
            @param column the 0-based column, counted in bytes

            @return the last statement of the line that starts at or before the column, the first statement of the
            line if none does

            @throw PROGRAM-STATEMENT-ERROR no statement is found for the line, as for a line breakpoint
        */
        private static int findColumnStatement(ProgramControl pgm, string file, int line, int column) {
            list<int> ids = pgm.findStatementIds(file, line);
            if (!ids) {
                throw "PROGRAM-STATEMENT-ERROR", sprintf("cannot find statement for \"%s:%d\"", file, line);
            }
            int rv = ids[0];
            foreach int id in (ids) {
                int start_column = pgm.getStatementIdInfo(id).start_column;
                if (start_column >= 0 && start_column <= column) {
                    rv = id;
                }
            }
            return rv;
        }

        #! Returns the statements of a line with their locations
        /** @param pgm the Program
            @param file the file or the label of the source
            @param line the line

            @return a list of the statements of the line in the order of their columns, each a hash of the
            @ref Qore::StatementInfo "StatementInfo" keys and \c id, the ID of the statement
        */
        private static list<hash<auto>> getLineStatements(ProgramControl pgm, string file, int line) {
            return map hash(pgm.getStatementIdInfo($1)) + {"id": $1}, pgm.findStatementIds(file, line);
        }

        private hash<auto> getProgramInfo(ProgramControl p, bool listFiles = False, *list<auto> threads) {
            hash<auto> result;
            result.scriptName = p.getScriptName();
            result.scriptPath = p.getScriptPath();
            result.threads = threads ?? p.getThreadList();
            # the current names of the threads
            result.threadNames = map {$1: get_thread_name($1)}, result.threads;
            result.debugging = (p.getParseOptions() & PO_NO_DEBUGGING) == 0;
            if (result.debugging && listFiles) {
                hash<auto> h;
                h = p.getSourceFileNames();
                if (h) {
                    result.files = h;
                }
                h = p.getSourceLabels();
                if (h) {
                    result.labels = h;
                }
            }
            return result;
        }

        #! Returns True if any breakpoint has a condition, hit condition or log message
        private bool hasBreakpointOptions() {
            AutoLock al(bkptLock);
            return boolean(bkptOptions);
        }

        #! Returns the IDs of the breakpoints of a statement that apply to the current thread, in their order
        /** A breakpoint applies if it is enabled and its policy accepts the thread, as the debugger checks it
        */
        private static list<int> getApplicableBreakpoints(ProgramControl pgm, int statementId) {
            int tid = gettid();
            list<int> rv = ();
            foreach Breakpoint b in (pgm.getStatementIdInfo(statementId, True).breakpoints ?? ()) {
                if (!b.getEnabled()) {
                    continue;
                }
                int policy = b.getPolicy();
                # a thread that is assigned to the breakpoint is accepted or rejected by the policy
                if (policy != BreakpointPolicyNone
                    && (policy == BreakpointPolicyAccept) != inlist(tid, b.getThreadIds())) {
                    continue;
                }
                push rv, b.getBreakpointId();
            }
            return rv;
        }

        #! Returns the condition, hit condition, log message and number of hits of a breakpoint, if any is set
        private *hash<auto> getBreakpointOptions(int id) {
            AutoLock al(bkptLock);
            return bkptOptions{id};
        }

        #! Sets or removes the condition, hit condition or log message of a breakpoint
        /** @param id the ID of the breakpoint
            @param opt \c condition, \c hitCondition or \c logMessage
            @param value the value; an empty value removes the option

            @throw BREAKPOINT-HIT-CONDITION-ERROR the hit condition is invalid
            @throw DEBUG-HANDLER-ERROR the value is not a string
        */
        private setBreakpointOption(int id, string opt, auto value) {
            *string v = DebugProgramControl::validateBreakpointOption(opt, value);
            AutoLock al(bkptLock);
            if (v) {
                bkptOptions{id}{opt} = v;
            } else {
                remove bkptOptions{id}{opt};
            }
            # a breakpoint without options is not kept; its number of hits is kept as long as it has options
            if (!(bkptOptions{id} - "hits")) {
                remove bkptOptions{id};
            }
        }

        #! Returns the value of a condition, hit condition or log message of a breakpoint, or @ref nothing for none
        /** @param opt \c condition, \c hitCondition or \c logMessage
            @param value the value; an empty value removes the option

            @throw BREAKPOINT-HIT-CONDITION-ERROR the hit condition is invalid
            @throw DEBUG-HANDLER-ERROR the value is not a string
        */
        static *string validateBreakpointOption(string opt, auto value) {
            if (exists value && value.typeCode() != NT_STRING) {
                throw "DEBUG-HANDLER-ERROR", sprintf("the %s of a breakpoint must be a string; got type %y", opt,
                    value.type());
            }
            if (!value.val()) {
                return;
            }
            # an invalid hit condition is refused when it is set
            if (opt == "hitCondition") {
                DebugProgramControl::checkHitCondition(value, 0);
            }
            return value;
        }

        #! Returns True if the given number of hits meets the hit condition of a breakpoint
        /** @param cond the hit condition: a number, which the number of hits must equal, or a number after \c "==",
            \c ">", \c ">=", \c "<", \c "<=" or \c "%", the last for every given number of hits; blanks are allowed
            before and after the number and the operator and between the characters of the operator
            @param count the number of hits, with the current one

            @throw BREAKPOINT-HIT-CONDITION-ERROR the hit condition is invalid
        */
        static bool checkHitCondition(string cond, int count) {
            # blanks are allowed also between the characters of an operator, as in "> = 4"
            *list<*string> m = (cond =~ x/^\s*(=\s*=|>\s*=|<\s*=|>|<|%)?\s*([0-9]+)\s*$/);
            if (!m) {
                throw "BREAKPOINT-HIT-CONDITION-ERROR", sprintf("invalid hit condition %y; give a number, optionally "
                    "after ==, >, >=, <, <= or %%", cond);
            }
            int n = int(m[1]);
            string op = m[0] ?? "";
            op =~ s/\s+//g;
            switch (op) {
                case ">": return count > n;
                case ">=": return count >= n;
                case "<": return count < n;
                case "<=": return count <= n;
                case "%": return n > 0 && !(count % n);
            }
            return count == n;
        }

        #! Checks the condition, hit condition and log message of a breakpoint that a thread has hit
        /** Runs in the thread that hit the breakpoint.  A breakpoint with a condition stops the thread only if the
            condition is true, and one with a hit condition only if the number of times that it was hit with its
            condition true meets the hit condition; a logpoint sends its message to all clients as a \c "console"
            output event and does not stop the thread.  A breakpoint whose condition or hit condition cannot be
            evaluated stops the thread, and the error is sent to all clients as a \c "console" output event.

            @param id the ID of the breakpoint
            @param pgm the Program of the thread
            @param lv the local variables of the frame that hit the breakpoint

            @return a hash with \c stop: @ref True if the breakpoint stops the thread, and \c error: the error of the
            evaluation, if any
        */
        private hash<auto> checkBreakpoint(int id, ProgramControl pgm, *hash<auto> lv) {
            *hash<auto> opts = getBreakpointOptions(id);
            if (!opts) {
                return {"stop": True};
            }
            try {
                if (opts.condition && !evaluateExpression(pgm, opts.condition, lv)) {
                    return {"stop": False};
                }
                int count;
                {
                    AutoLock al(bkptLock);
                    # the options may have been removed meanwhile
                    if (bkptOptions{id}) {
                        count = ++bkptOptions{id}.hits;
                    }
                }
                if (opts.hitCondition && !DebugProgramControl::checkHitCondition(opts.hitCondition, count)) {
                    return {"stop": False};
                }
            } catch (hash<ExceptionInfo> ex) {
                string error = sprintf("%s: %s", ex.err, ex.desc);
                sendConsoleOutput(sprintf("breakpoint %d: %s\n", id, error));
                return {"stop": True, "error": error};
            }
            if (opts.logMessage) {
                sendConsoleOutput(formatLogMessage(pgm, opts.logMessage, lv) + "\n");
                return {"stop": False};
            }
            return {"stop": True};
        }

        #! Sends output of the debugger to all clients, after the output that the program wrote before it
        private sendConsoleOutput(string output) {
            if (outputCapture) {
                outputCapture.flushAndWait();
            }
            broadcastOutput("console", output);
        }

        #! Returns the message of a logpoint with the values of the expressions in braces
        /** An expression that cannot be evaluated is replaced with its error in angle brackets
        */
        private string formatLogMessage(ProgramControl pgm, string msg, *hash<auto> lv) {
            string rv = "";
            int pos = 0;
            while (True) {
                int open = index(msg, "{", pos);
                int close = open >= 0 ? index(msg, "}", open) : -1;
                if (close < 0) {
                    rv += msg.substr(pos);
                    break;
                }
                rv += msg.substr(pos, open - pos);
                string expr = msg.substr(open + 1, close - open - 1);
                try {
                    auto v = evaluateExpression(pgm, expr, lv);
                    rv += v.typeCode() == NT_STRING ? v : AbstractDebugControl::describe(v).value;
                } catch (hash<ExceptionInfo> ex) {
                    rv += sprintf("<%s: %s>", ex.err, ex.desc);
                }
                pos = close + 1;
            }
            return rv;
        }

        private hash<auto> getBreakpointInfo(Breakpoint b, bool listStatements = True) {
            hash<auto> binfo.id = b.getBreakpointId();
            binfo.programId = b.getProgram().getProgramId();
            binfo.enabled = encodeValue('enabled', b.getEnabled(), boolStrings);
            binfo.threads = b.getThreadIds();
            binfo.policy = encodeValue('policy', b.getPolicy(), policyStrings);
            if (listStatements) {
                binfo.statements = ();
                foreach int sid in (b.getStatementIds()) {
                    push binfo.statements, ('id': sid) + b.getProgram().getStatementIdInfo(sid);
                }
                if (!binfo.statements) {
                    remove binfo.statements;
                }
            }
            if (!binfo.threads) {
                remove binfo.threads;
            }
            # the condition, hit condition, log message and number of hits
            binfo += getBreakpointOptions(binfo.id);
            return binfo;
        }

        # stackInfo keys: file, [source], [offset], line
        private *hash<auto> getSourceCodeFromFileOrLabel(ProgramControl pgm, hash<auto> stackInfo, int linesBefore, int linesAfter) {
            string type = 'file';
            int offset = 0;
            hash<auto> h;
            if (exists stackInfo.source) {
                # label used
                if (isSupportedSourceCodeForLabel()) {
                    # use label
                    type = 'label';
                    h{type} = stackInfo.file;
                } else {
                    # fallback to file
                    offset = stackInfo.offset;
                    h{type} = stackInfo.source;
                }
            } else {
                h{type} = stackInfo.file;
            }
            int n = stackInfo.line + offset - linesBefore;
            if (n < 1) {
                n = 1;
            }
            h.line = n;
            n = stackInfo.line + offset + linesAfter;
            if (n < h.line) {
                h.line = n;
            }
            h.count = n - h.line + 1;
            return getSourceCode(pgm, type, h).('code', 'startline', 'origin') + ('currentline': stackInfo.line + offset);
        }

        private *hash<auto> getSourceCode(ProgramControl pgmb, string type, hash<auto> rd) {
            hash<auto> res;
            if (!exists (type=='file' ? pgmb.getSourceFileNames() : pgmb.getSourceLabels() ){rd{type}}) {
                throw "DEBUG-HANDLER-ERROR", sprintf("Cannot get source for %y", rd{type});
            }
            hash<auto> sc;
            if (type=='file') {
                sc = getSourceCodeFromFile(rd{type});
            } else {
                sc = getSourceCodeForLabel(rd{type});
            }
            res.checksum.algorithm = 'sha1';
            res.checksum.cs = sc.content.toSHA1();
            res.origin = sc.origin;
            if (exists rd.count && rd.count <= 0) {
                # skip source, just checksum
            } else {
                rd.line = rd.line ?? 1;
                if (rd.line < 1) {
                    rd.line = 1;
                }
                if (rd.line > 1 || rd.count > 0) {
                    list<auto> l = sc.content.split("\n");
                    l = l[rd.line-1..rd.line+rd.count-2];
                    sc.content = l.join("\n");
                }
                res.code = sc.content;
                res.startline = rd.line;
            }
            return res;
        }

        private bool isSupportedSourceCodeForLabel() {
            return False;
        }

        private hash<auto> getSourceCodeForLabel(string name) {
            throw "DEBUG-HANDLER-ERROR", "Local debug server does not support label source code";
        }
        private hash<auto> getSourceCodeFromFile(string name) {
            if (!absolute_path(name)) {
                foreach string p in (sourceSearchPath.split(':')) {
                    if (p != "") {
                        if (p !~ /[\\\/]$/ ) {
                            p += DirSep;
                        }
                        debug("is_file(%s)", p + name);
                        if (is_file(p + name)) {
                            name = p + name;
                            break;
                        }
                    }
                }
            }
            return {
                'origin': name,
                'content': ReadOnlyFile::readTextFile(name),
            };
        }

        private *hash<auto> serializeLocal(string name, hash<auto> val) {
            val.value = AbstractDebugControl::serialize(val.value);
            return ('name': name) + val;
        }

        private *hash<auto> serializeLocals(*hash<auto> vals) {
            foreach string k in (keys vals) {
                vals{k}.value = AbstractDebugControl::serialize(vals{k}.value);
            }
            return vals;
        }

        #! returns the call stack as untyped frame hashes with the debugged statement's frame adjusted
        /** the frames of the call stack are @ref Qore::CallStackInfo "CallStackInfo" hashes; they are returned as
            untyped hashes, as the debugger adds keys of its own to them, such as \c current
        */
        private list<hash<auto>> adjustStack(list<auto> stack, *hash<auto> ctx) {
            stack = map hash($1), stack;
            if (ctx && ctx.stackSize >= frameOffset) {
                @assert(ctx.stackSize >= frameOffset);
                while (stack.size() > ctx.stackSize - frameOffset) {
                    shift stack;
                }
                # when debug injection stuff is invoked in C++ then it is not real function call which would
                # create new stack entry (and frame). Data related to statement being debugged are passed
                # as handler parameters so we need modify the stack entry (see issue #2468)
                stack[0].function = sprintf("interrupt: %s", ctx.intrInfo.func);
                if (ctx.intrInfo.statementid) {
                    stack[0].file = ctx.intrInfo.file;
                    stack[0].line = ctx.intrInfo.line;
                    stack[0].endline = ctx.intrInfo.endline;
                    if (exists ctx.intrInfo.source) {
                        stack[0].source = ctx.intrInfo.source;
                        stack[0].offset = ctx.intrInfo.offset;
                    } else {
                        remove stack[0].source;
                        remove stack[0].offset;
                    }
                }
                stack[0].programid = ctx.intrInfo.pgmid;
                if (ctx.intrInfo.statementid) {
                    stack[0].statementid = ctx.intrInfo.statementid;
                }
            }
            # the columns of the statement of each frame, where they are known
            foreach hash<auto> frame in (\stack) {
                if (!frame.statementid || !frame.programid) {
                    continue;
                }
                try {
                    hash<StatementInfo> info = ProgramControl::resolveProgramId(frame.programid)
                        .getStatementIdInfo(frame.statementid);
                    if (info.start_column >= 0) {
                        frame.column = info.start_column;
                        frame.endcolumn = info.end_column;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    # the Program of the frame cannot be debugged or no longer exists: no columns
                }
            }
            return stack;
        }

        #! Returns the value of the root of a variable path of a stopped thread
        /** @param pgm the Program of the thread
            @param root a hash with one of the following keys: \c local: the name of a local variable, \c global: the
            name of a global variable, \c debug: the name of the debug variable of the interrupt (as \c result), or
            \c eval: the ID of the value of an expression that was evaluated since the thread stopped
            @param lv the local variables of the frame, for a \c local root
            @param ctxCT the data of the interrupt
            @param refName the name of the debug variable of the interrupt, if any

            @throw DEBUG-ERROR the root does not exist
        */
        private auto getDebugRootValue(ProgramControl pgm, *hash<auto> root, *hash<auto> lv, hash<auto> ctxCT,
                *string refName) {
            if (exists root.local) {
                if (!lv.hasKey(root.local)) {
                    throw "DEBUG-ERROR", sprintf("the frame has no local variable %y", root.local);
                }
                return lv{root.local}.value;
            }
            if (exists root.global) {
                bool found;
                auto v = pgm.getGlobalVariable(root.global, \found);
                if (!found) {
                    throw "DEBUG-ERROR", sprintf("the program has no global variable %y", root.global);
                }
                return v;
            }
            if (exists root.debug) {
                if (root.debug != refName) {
                    throw "DEBUG-ERROR", sprintf("the interrupt has no debug variable %y", root.debug);
                }
                return ctxCT{refName};
            }
            if (exists root.eval) {
                int id = root.eval;
                if (id < 0 || id >= ctxCT.evals.size()) {
                    throw "DEBUG-ERROR", sprintf("no expression with ID %d was evaluated since the thread stopped", id);
                }
                return ctxCT.evals[id];
            }
            throw "DEBUG-ERROR", sprintf("invalid variable root: %y", root);
        }

        #! Sets the value of the root of a variable path of a stopped thread that is not a local variable
        /** @see getDebugRootValue()
        */
        private setDebugRootValue(ProgramControl pgm, hash<auto> root, reference<hash<auto>> ctxCT, *string refName,
                auto val) {
            if (exists root.global) {
                pgm.setGlobalVarValue(root.global, val);
            } else if (exists root.debug) {
                if (root.debug != refName) {
                    throw "DEBUG-ERROR", sprintf("the interrupt has no debug variable %y", root.debug);
                }
                ctxCT{refName} = val;
            } else if (exists root.eval) {
                ctxCT.evals[root.eval] = val;
            } else {
                throw "DEBUG-ERROR", sprintf("invalid variable root: %y", root);
            }
        }

        #! Evaluates an expression with the given local variables and the global variables of a Program
        /** The expression is evaluated in a Program with @ref Qore::PO_LOCKDOWN "PO_LOCKDOWN", which cannot access
            the file system, the network or processes, and which inherits all code of the debugged Program (see
            @ref Qore::ProgramControl::createEvalProgram() "ProgramControl::createEvalProgram()"), so the expression can
            refer to its functions, classes, constants and other code; functions and methods run in the debugged
            Program.  The expression is the body of a function whose local variables are the global variables of the
            Program and the given local variables, which hide global variables with the same names.  Values are
            copied into the variables, so assigning a variable in the expression does not change the program's
            variable; the members of objects are changed in the objects.

            The Program and the function of an expression are kept, so an expression that is evaluated again, such as
            the condition of a breakpoint, is not parsed again; code that the debugged Program parses later is not
            available.

            @param pgm the Program whose code and global variables can be used in the expression
            @param expr the expression
            @param lv the local variables, as returned by @ref Qore::get_local_vars() "get_local_vars()"

            @return the value of the expression

            @throw DEBUG-EVALUATE-ERROR the expression cannot be parsed, or the Program is being parsed
        */
        private auto evaluateExpression(ProgramControl pgm, string expr, *hash<auto> lv) {
            hash<auto> vars = {};
            foreach hash<auto> i in (pgm.getGlobalVars().pairIterator()) {
                if (i.key =~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
                    vars{i.key} = i.value;
                }
            }
            foreach hash<auto> i in (lv.pairIterator()) {
                if (i.key =~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
                    vars{i.key} = i.value.value;
                }
            }
            list<string> names = sort(keys vars);
            # the function of an expression depends on the names of the variables, which are identifiers, so the first
            # ":" ends them
            string key = names.join(",") + ":" + expr;
            Program epgm;
            string fname;
            Counter calls;
            {
                evalLock.lock();
                on_exit evalLock.unlock();
                string id = string(pgm.getProgramId());
                *string f = evalPrograms{id}.functions{key};
                # a Program is parsed only when no evaluation runs in it; another thread can evaluate an expression,
                # which can wait for a thread that is stopped
                if (!evalPrograms{id} || (!f && (evalPrograms{id}.n >= MaxEvalFunctions
                    || evalPrograms{id}.calls.getCount()))) {
                    pruneEvalPrograms();
                    try {
                        evalPrograms{id} = {
                            "program": pgm.createEvalProgram(PO_NEW_STYLE | PO_LOCKDOWN | PO_ALLOW_REPARSE),
                            "functions": {},
                            "n": 0,
                            "calls": new Counter(),
                        };
                    } catch (hash<ExceptionInfo> ex) {
                        throw "DEBUG-EVALUATE-ERROR", ex.desc;
                    }
                    f = NOTHING;
                }
                epgm = evalPrograms{id}.program;
                calls = evalPrograms{id}.calls;
                if (f) {
                    fname = f;
                } else {
                    fname = sprintf("%s_%d", EvalFunction, evalPrograms{id}.n + 1);
                    string code = sprintf("auto sub %s(hash<auto> %s) {\n", fname, EvalVars);
                    foreach string name in (names) {
                        code += sprintf("auto %s = %s{%y};\n", name, EvalVars, name);
                    }
                    code += sprintf("return (\n%s\n);\n}\n", expr);
                    try {
                        epgm.parse(code, "<expression>", WARN_NONE);
                    } catch (hash<ExceptionInfo> ex) {
                        throw "DEBUG-EVALUATE-ERROR", ex.desc;
                    }
                    evalPrograms{id}.functions{key} = fname;
                    ++evalPrograms{id}.n;
                }
                # the evaluation runs; no expression is parsed in the Program until it has ended
                calls.inc();
            }
            on_exit calls.dec();
            return epgm.callFunction(fname, vars);
        }

        #! Returns True if no statement in the call stack is in the body of a try statement
        /** The current statement of each frame with a statement of a debugged Program is checked: an exception that
            is raised there is caught by a try statement around it in its function; the frames of builtin code and of
            Programs that cannot be debugged are not, so an exception that such code catches is regarded as uncaught

            @param stack the call stack of the thread, with the statement that raised the exception in its first frame
        */
        static bool isUncaught(list<auto> stack) {
            foreach hash<auto> frame in (stack) {
                if (!frame.statementid || !frame.programid) {
                    continue;
                }
                try {
                    if (ProgramControl::resolveProgramId(frame.programid).getStatementIdInfo(frame.statementid).in_try) {
                        return False;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    # a Program that cannot be debugged or that has ended
                }
            }
            return True;
        }

        #! Removes a Program from debugging, with the Program of its expressions, which keeps its code
        /** @param program the Program to remove
        */
        nothing removeProgram(ProgramControl program) {
            DebugProgram::removeProgram(program);
            # the lock of the debugged Programs is released before evalLock is taken, which evaluateExpression() holds
            # while it takes that lock
            AutoLock al(evalLock);
            remove evalPrograms{program.getProgramId()};
        }

        #! Removes the Programs of expressions whose debugged Programs are no longer debugged; evalLock must be held
        /** A Program of expressions keeps the code of the debugged Program
        */
        private:internal pruneEvalPrograms() {
            hash<string, bool> debugged = map {$1.getProgramId(): True}, getAllPrograms();
            foreach string id in (keys evalPrograms) {
                if (!debugged{id}) {
                    remove evalPrograms{id};
                }
            }
        }

        private *hash<auto> handleInterrupt(string func, ProgramControl pgm, reference runState, reference runToStatementId, *int statementId, *string refName, *reference refValue, *int breakpointId, *hash<auto> except) {
            # serialize data, send to all websockets, break/suspend thread
            int tid = gettid();
            hash<auto> ctx = {
                "queue": new Queue(),
                "pgmId": pgm.getProgramId(),
                "stackSize": get_thread_call_stack().size(),
                "intrInfo": {
                    'type': DebugResponseType::Event,
                    'cmd': DebugEventCmd::Interrupt,
                    'pgmid': pgm.getProgramId(),
                    'tid': tid,
                    # the name of the thread, which only the thread itself can get
                    'threadname': get_thread_name(),
                    'stamp': now_us(),
                    'func': func,
                    'runstate': encodeValue('runState', runState, runStateStrings),
                    'runtostatementid': runToStatementId,
                    'frame': 0,
                },
            };
            # breakpoints that are the only reason of the stop (a step or a run to a statement gives no breakpoint) are
            # checked with their options: all breakpoints of the statement that apply to the thread, as the debugger
            # gives the first one only; if none stops the thread, it continues as it ran before
            if (breakpointId && hasBreakpointOptions()) {
                list<int> ids = statementId ? getApplicableBreakpoints(pgm, statementId) : ();
                if (!inlist(breakpointId, ids)) {
                    unshift ids, breakpointId;
                }
                *hash<auto> lv = get_local_vars(frameOffset);
                list<int> stopping = ();
                foreach int id in (ids) {
                    hash<auto> check = checkBreakpoint(id, pgm, lv);
                    if (check.stop) {
                        push stopping, id;
                    }
                    if (check.error && !ctx.intrInfo.bkpterror) {
                        ctx.intrInfo.bkpterror = check.error;
                    }
                }
                if (!stopping) {
                    return;
                }
                breakpointId = stopping[0];
                ctx.intrInfo.bkptids = stopping;
            }
            runToStatementId = 0; # reset RunToStatement
            ctx.intrInfo.framecnt = ctx.stackSize - frameOffset;
            if (exists statementId) {
                ctx.intrInfo.statementid = statementId;
            }
            if (exists breakpointId) {
                ctx.intrInfo.bkptid = breakpointId;
            }
            if (exists statementId && statementId > 0) {
                hash<auto> location = pgm.getStatementIdInfo(statementId);
                ctx.intrInfo.file = location.file;
                ctx.intrInfo.line = location.start_line;
                ctx.intrInfo.endline = location.end_line;
                if (location.start_column >= 0) {
                    ctx.intrInfo.column = location.start_column;
                    ctx.intrInfo.endcolumn = location.end_column;
                }
                if (location.source != "") {
                    ctx.intrInfo.source = location.source;
                }
                ctx.intrInfo.offset = location.offset;
                try {
                    ctx.intrInfo.linecode = getSourceCodeFromFileOrLabel(pgm, {
                        'file': location.file,
                        'line': location.start_line,
                        'source': location.source != "" ? location.source : NOTHING,
                        'offset': location.offset,
                    }, 0, 0).code;
                } catch (hash<ExceptionInfo> ex) {
                    # suppress exceptions as failure must not break main functionality
                }
            }
            if (exists except) {
                # we need make real copy as the worker thread might keep reference slightly longer and
                # C++ will complain about reference_count() > 1 when pushing new callstack item.
                ctx.intrInfo.exception = hash();
                foreach string k in (keys except) {
                    switch (k) {
                        case "callstack":
                            ctx.intrInfo.exception{k} = ();
                            foreach hash<auto> cs in (except{k}) {
                                push ctx.intrInfo.exception{k}, cs;
                            }
                            break;
                        case "next":
                            break;
                        default:
                            ctx.intrInfo.exception{k} = except{k};
                    }
                }
            }
            if (exists refName) {
                ctx.intrInfo.debugvar = refName;
                ctx.intrInfo{refName} = refValue;
            }
            # minor race issue when list of all thread stack might return internal frames till ctx is not registered in ctxThread
            {
                rwlThread.writeLock();
                on_exit rwlThread.writeUnlock();
                @assert(!exists ctxThread{tid});
                ctxThread{tid} = ctx;
            }

            # debugger client cannot ask for stack when procession message as it dead lock thread handler so we add it to original message
            ctx.intrInfo.stack = adjustStack(get_thread_call_stack(), ctx);
            # an exception that no debuggable code in the call stack catches
            if (exists except) {
                ctx.intrInfo.uncaught = isUncaught(ctx.intrInfo.stack);
            }

%ifdef DEBUG_ADD_LOCAL_VARS
            for (int i=0; i < 8; i++) {
                # to show important stack values each step
                try {
                    *hash<auto> lv = get_local_vars(i);   # the same for each dump (serializeLocals adds frame!)
                    if (i >= 2 && i < 8) {
                        ctx.intrInfo.localvars[i] = serializeLocals(lv);
                    } else {
                        ctx.intrInfo.localvars[i] = keys lv;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    # exception intentionally suppressed; local vars dump is only for debug purposes
                    @debug(sprintf("local vars dump exception: %y", ex));
                }
            }
            try {
                ctx.intrInfo.stackDump = get_thread_call_stack();
                ctx.intrInfo.dpgmid = ProgramControl::getProgram().getProgramId();
            } catch (hash<ExceptionInfo> ex) {
                # exception intentionally suppressed; stack dump is only for debug purposes
                @debug(sprintf("stack dump exception: %y", ex));
            }
%endif

            # the output that the thread wrote before the interrupt reaches the clients before it
            if (outputCapture) {
                outputCapture.flushAndWait();
            }
            try {
                broadcastDataImpl(ctx.intrInfo);
            } catch (hash<ExceptionInfo> ex) {
                # suppress exceptions
            }

            hash<auto> ctxCT;
            # at the start of the program, the thread has not entered its code: the frames are those of the code that
            # started the program, whose local variables are not read
            bool noLocals = func == "attach";
            if (exists refName) {
                ctxCT{refName} = refValue;
            }
            ctxCT.frameId = 0;
            # wait to process command passed as marshalled call from websocket thread
            bool ret = False;
            while (!ret) {
                auto qrd = ctx.queue.get();
                {
                    auto result;
                    hash<auto> sd;
                    hash<auto> cx;
                    hash<auto> rd;
                    try {
                        rd = qrd.data;
                        cx = qrd.cx;
                        list<auto> cmd = rd.cmd.split('/');
                        shift cmd;  # remove thread
                        switch (shift cmd) {
                            case 'go':
                                runState = resolveValue('runState', shift cmd, runStateStrings, runState);
                                if (exists refName) {
                                    refValue = ctxCT{refName};
                                }
                                if (rd.value) {
                                    runToStatementId = resolveStatement(pgm, rd.value);
                                }
                                ret = True;
                                break;

                            case 'local':
                                string varName = shift cmd;
                                int frameId2 = (rd.frameid ?? ctxCT.frameId) + frameOffset;
                                switch (shift cmd) {
                                    case 'get':
                                        *hash<auto> lv = noLocals ? NOTHING : get_local_vars(frameId2);
                                        if (exists lv{varName}) {
                                            result = serializeLocal(varName, lv{varName});
                                        }
                                        break;
                                    case 'set':
                                        if (noLocals) {
                                            throw "DEBUG-HANDLER-ERROR", "the thread has not started the code of the "
                                                "program, so it has no local variables";
                                        }
                                        set_local_var_value(frameId2, varName, AbstractDebugControl::unserialize(rd.value));
                                        break;
                                    case 'list':
                                        softlist l = noLocals ? () : keys get_local_vars(frameId2);
                                        result = AbstractDebugControl::enumFilter(l, varName);
                                        break;
                                }
                                break;

                            case 'debug':
                                string varName = shift cmd;
                                switch (shift cmd) {
                                    case 'get':
                                        if (varName == refName) {
                                            switch (varName) {
                                                case 'flow':
                                                    result = encodeValue(varName, ctxCT{varName}, flowStrings);
                                                    break;

                                                case 'dismiss':
                                                    result = encodeValue(varName, ctxCT{varName}, boolStrings);
                                                    break;

                                                case 'result':
                                                    result = AbstractDebugControl::serialize(ctxCT{varName});
                                                    break;
                                            }
                                        } else {
                                            switch (varName) {
                                                case 'frame':
                                                    result = ctxCT.frameId;
                                                    break;
                                                case 'event':
                                                    result = ctx.intrInfo;
                                                    break;
                                            }
                                        }
                                        break;
                                    case 'set':
                                        if (varName == refName) {
                                            switch (varName) {
                                                case 'flow':
                                                    ctxCT{varName} = resolveValue(varName, string(AbstractDebugControl::unserialize(rd.value)), flowStrings, ctxCT{rd.name});
                                                    break;

                                                case 'dismiss':
                                                    auto v = AbstractDebugControl::unserialize(rd.value);
                                                    ctxCT{varName} = v.typeCode() == NT_BOOLEAN ? v : resolveValue(varName, string(v), boolStrings, ctxCT{rd.name});
                                                    break;

                                                case 'result':
                                                    ctxCT{varName} = AbstractDebugControl::unserialize(rd.value);
                                                    break;
                                            }
                                        } else {
                                            auto v = AbstractDebugControl::unserialize(rd.value);
                                            switch (varName) {
                                                case 'frame':
                                                    if (v <= 0) {
                                                        ctxCT.frameId = 0;
                                                    } else {
                                                        ctxCT.frameId = int(v);
                                                    }
                                                    break;
                                            }
                                        }
                                        break;
                                    case 'list':
                                        list<auto> l  = list('frame', 'event');
                                        if (refName) {
                                            l += refName;
                                        }
                                        result = AbstractDebugControl::enumFilter(l, varName);
                                        break;
                                }
                                break;

                            case 'variable': {
                                # the local variables are read here, as the frame numbers count from this frame
                                int frameId2 = (rd.frameid ?? ctxCT.frameId) + frameOffset;
                                *hash<auto> lv = !noLocals && (exists rd.root.local || exists rd.expression)
                                    ? get_local_vars(frameId2)
                                    : NOTHING;
                                auto val = getDebugRootValue(pgm, rd.root, lv, ctxCT, refName);
                                switch (shift cmd) {
                                    case 'get': {
                                        auto v = AbstractDebugControl::getPath(val, rd.path);
                                        result = AbstractDebugControl::describe(v);
                                        if (rd.children) {
                                            result.children = AbstractDebugControl::describeChildren(v, rd.start ?? 0,
                                                rd.count);
                                        }
                                        break;
                                    }
                                    case 'set': {
                                        # the new value is given as a serialized value or as an expression, which is
                                        # evaluated with the variables of the frame
                                        auto new_val = AbstractDebugControl::setPath(val, rd.path, exists rd.expression
                                            ? evaluateExpression(pgm, rd.expression, lv)
                                            : AbstractDebugControl::unserialize(rd.value));
                                        if (exists rd.root.local) {
                                            set_local_var_value(frameId2, rd.root.local, new_val);
                                        } else {
                                            setDebugRootValue(pgm, rd.root, \ctxCT, refName, new_val);
                                        }
                                        result = AbstractDebugControl::describe(AbstractDebugControl::getPath(new_val,
                                            rd.path));
                                        break;
                                    }
                                }
                                break;
                            }

                            case 'breakpoint': {
                                # the breakpoints of the given IDs that stop the thread with their options, as when it
                                # hits them; for a thread that stopped at their statement for another reason
                                if (shift cmd != "check") {
                                    throw "DEBUG-HANDLER-ERROR", "expecting thread/breakpoint/check";
                                }
                                *hash<auto> lv = noLocals ? NOTHING : get_local_vars(frameOffset);
                                result = {"stop": (), "errors": {}};
                                foreach softint id in (rd.value.ids) {
                                    hash<auto> check = checkBreakpoint(id, pgm, lv);
                                    if (check.stop) {
                                        push result.stop, id;
                                    }
                                    if (check.error) {
                                        result.errors{id} = check.error;
                                    }
                                }
                                break;
                            }

                            case 'evaluate': {
                                # the local variables are read here, as the frame numbers count from this frame
                                int frameId2 = (rd.frameid ?? ctxCT.frameId) + frameOffset;
                                auto v = evaluateExpression(pgm, rd.expression,
                                    noLocals ? NOTHING : get_local_vars(frameId2));
                                # the value is kept while the thread is stopped, so that its elements can be read
                                push ctxCT.evals, v;
                                result = AbstractDebugControl::describe(v) + {
                                    "id": ctxCT.evals.size() - 1,
                                    "bool": boolean(v),
                                    "text": v.typeCode() == NT_STRING ? v : AbstractDebugControl::describe(v).value,
                                };
                                # the whole value, for clients that show it
                                if (rd.serialize) {
                                    result.serialized = AbstractDebugControl::serialize(v);
                                }
                                break;
                            }

                            case 'stack':
                                list<auto> stack = adjustStack(get_thread_call_stack(), ctx);
                                if ((rd.frameid ?? ctxCT.frameId) < stack.size()) {
                                    stack[rd.frameid ?? ctxCT.frameId].current = True;
                                }
                                result = stack;
                                break;

                            case 'source':
                                list<auto> stack = adjustStack(get_thread_call_stack(), ctx);
                                int frame = rd.frameid ?? ctxCT.frameId;
                                if (frame < stack.size()) {
                                    result = getSourceCodeFromFileOrLabel(pgm, stack[frame], rd.linesbefore ?? DEFAULT_LINES_BEFORE, rd.linesafter ?? DEFAULT_LINES_AFTER);
                                }
                                break;
                        }

                        if (exists result) {
                            sd.type = DebugResponseType::Response;
                        }

                    } catch (hash<ExceptionInfo> ex) {
                        sd.type = DebugResponseType::Error;
                        result.err = ex.err;
                        result.desc = ex.desc;
                        if (showFullException) {
                            result.ex = ex;
                        }
                    }
                    # every command of a client is answered, so that the client can wait for the answer; a command with
                    # no result, such as "go", is answered with an empty hash; the commands queued by shutdown() have
                    # no client
                    if (cx) {
                        if (!exists result) {
                            result = {};
                            sd.type = DebugResponseType::Response;
                        }
                        sd.tid = tid;
                        sd.stamp = now_us();
                        sd.cmd = rd.cmd;
                        sd.uid = rd.uid;
                        sd.result = result;
                        try {
                            sendDataImpl(cx, sd);
                        } catch (hash<ExceptionInfo> ex) {
                            break;
                        }
                    }
                }
            }
            if (exists except) {
                remove ctx.intrInfo.exception;
            }
            {
                rwlThread.writeLock();
                on_exit rwlThread.writeUnlock();
                remove ctxThread{tid};
            }
            # commands that were queued after the command that resumed the thread are not processed; no command is
            # queued any more, as the thread is no longer registered as stopped
            while (ctx.queue.size()) {
                hash<auto> qrd = ctx.queue.get();
                if (qrd.cx) {
                    try {
                        sendDataImpl(qrd.cx, {
                            "type": DebugResponseType::Error,
                            "tid": tid,
                            "stamp": now_us(),
                            "cmd": qrd.data.cmd,
                            "uid": qrd.data.uid,
                            "result": {
                                "err": "DEBUG-HANDLER-ERROR",
                                "desc": sprintf("threadId %y is not stopped", tid),
                            },
                        });
                    } catch (hash<ExceptionInfo> ex) {
                        # the client cannot be reached; the remaining commands are answered
                    }
                }
            }
            # notify program is running again
            hash<auto> sd = {
                'type': DebugResponseType::Event,
                'cmd': DebugEventCmd::Run,
                'pgmid': ctx.pgmId,
                'tid': tid,
                'stamp': now_us(),
                'runstate': encodeValue('runState', runState, runStateStrings),
                'runtostatementid': runToStatementId,
            };
            try {
                broadcastDataImpl(sd);
            } catch (hash<ExceptionInfo> ex) {
                # suppress exceptions
            }
        }

        onAttach(ProgramControl pgm, reference rs, reference runToStatementId) {
            handleInterrupt("attach", pgm, \rs, \runToStatementId);
        }

        onDetach(ProgramControl pgm, reference rs, reference runToStatementId) {
            handleInterrupt("detach", pgm, \rs, \runToStatementId);
        }

        onStep(ProgramControl pgm, int blockStatementId, *int statementId, *int breakpointId, reference flow, reference rs, reference runToStatementId) {
            statementId = statementId ?? blockStatementId;
            /*
                when a statement is parsed in non-pgm context then it is not registered in pgm and no statementId can be resolved
                Typical case is bootstrap when program is starting. If we need debug even this code then we need add relation statment->program or
                reassign statement index from original program which might be impossible. The former case seems as memory wasting as 99.9% statement are
                assigned to program being debugged and skipping bootstrap is demanded feature.
            */
            if (statementId) {
                handleInterrupt(statementId ? 'step' : 'block', pgm, \rs, \runToStatementId, statementId, "flow", \flow, breakpointId);
            }
        }

        # backward compatability only when executed with <=0.8.13.2
        onStep(ProgramControl pgm, int blockStatementId, *int statementId, reference flow, reference rs, reference runToStatementId) {
            statementId = statementId ?? blockStatementId;
            if (statementId) {
                handleInterrupt(statementId ? 'step' : 'block', pgm, \rs, \runToStatementId, statementId, "flow", \flow);
            }
        }

        onFunctionEnter(ProgramControl pgm, int statementId, reference rs, reference runToStatementId) {
            if (statementId) {
                handleInterrupt('funcEnter', pgm, \rs, \runToStatementId, statementId);
            }
        }

        onFunctionExit(ProgramControl pgm, int statementId, reference result, reference rs, reference runToStatementId) {
            if (statementId) {
                handleInterrupt('funcExit', pgm, \rs, \runToStatementId, statementId, "result", \result);
            }
        }

        onException(ProgramControl pgm, int statementId, hash<auto> ex, reference dismiss, reference rs, reference runToStatementId) {
            if (statementId) {
                handleInterrupt('exception', pgm, \rs, \runToStatementId, statementId, "dismiss", \dismiss, NOTHING, ex);
            }
        }

        onExit(ProgramControl pgm, int statementId, reference result, reference rs, reference runToStatementId) {
            handleInterrupt('exit', pgm, \rs, \runToStatementId, statementId, "result", \result);
        }
    }
}
