%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes
%requires QoreAsyncJobUtils

module LlamaParseRestClient {
    version = "1.0";
    desc = "user module for calling LlamaParse document-extraction REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("llamaparse",
            LlamaParseRestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerChunkerFactory(
            new LlamaParseChunkerFactory());
    };
}

/** @mainpage LlamaParseRestClient Module

    @tableofcontents

    @section llamaparserestclientintro LlamaParseRestClient Introduction

    The %LlamaParseRestClient module provides a REST client for
    [LlamaParse](https://docs.cloud.llamaindex.ai/llamaparse/getting_started),
    LlamaIndex's document platform: parsing documents into markdown, text and
    structured items, extracting structured data against a schema, classifying
    documents against rules, and splitting a document that holds many.

    @par Async job lifecycle

    LlamaParse is asynchronous: a parse is submitted, the job is polled, and the
    content is read back.  The
    @ref LlamaParseRestClient::LlamaParseRestClientIo::parseDocument()
    method encapsulates all three phases.  The polling loop is delegated
    to @ref qoreasyncjobutilsintro "QoreAsyncJobUtils"' \c AsyncJobPoller
    so the same machinery is shared with other async-REST providers
    (async OCR batches, image/video generation, etc.).

    @par Which API version

    \c parseDocument() runs against the **v2** parse API.  Earlier versions of this
    module posted the document URL as a JSON body to the v1
    \c /api/parsing/upload endpoint, which that endpoint does not accept - it
    wants a multipart form - so every call failed with
    \c "Either file, input_url, or input_s3_path must be provided".

    @par Submitting a document

    \c parseDocument() takes a URL LlamaParse can fetch.  To send a document that
    is not reachable at a public URL, upload it first with the
    @ref llamaparsedataproviderintro "LlamaParseDataProvider" application's
    \c upload-file action and parse it by file ID.

    @par Regions

    LlamaIndex Cloud runs in two regions, and an API key issued for one is
    rejected by the other.  The connection defaults to
    \c api.cloud.llamaindex.ai; if the key is rejected there, the ping tries the
    other known region and adopts the one that accepts it.  The ping itself is a
    cheap authenticated read, so an invalid API key fails it - this connection
    declared no ping at all until the module covered more than the v1 parsing
    API, and every ping reported \c "OK" without contacting the server.

    @par Companion chunker

    See @ref qoreragutilsintro "QoreRagUtils"'s @c LlamaParseChunker
    (lazy-loaded via the @c "llama-parse" chunker strategy) for the
    RAG-pipeline adapter that wraps `parseDocument()` and splits the
    returned markdown into `ChunkInfo` records.

    @section LlamaParseRestClientRelnotes Release Notes

    @subsection LlamaParseRestClientv1_0 LlamaParseRestClient v1.0
    - the initial version of the %LlamaParseRestClient module
*/

%requires json

public namespace LlamaParseRestClient {
public class LlamaParseRestClientBase {
    public {
        #! Default LlamaIndex Cloud REST API URL
        /** The host root, not a path below it: the API description spells every path from the
            root - \c /api/v1/... and \c /api/v2/... - so anything more here would be prepended
            to paths that already carry their own prefix.
        */
        const DefaultUrl = "https://api.cloud.llamaindex.ai";

        #! The base path of the v1 parsing API
        const ParsingApiPath = "/api/parsing";

        #! The base path of the v2 parse API used by @ref LlamaParseRestClientIo::parseDocument()
        const ParseApiPath = "/api/v2/parse";

        #! The parsing tier @ref LlamaParseRestClientIo::parseDocument() uses unless told otherwise
        /** The cheapest one: a caller that wants AI-powered parsing asks for it.
        */
        const DefaultTier = "fast";

        #! Which v2 expansion carries the content for each result type
        const ResultTypeExpandMap = {
            "markdown": "markdown",
            "text": "text",
            "json": "items",
        };

        #! Terminal job statuses
        const JobStatusSuccess   = "COMPLETED";
        const JobStatusError     = "FAILED";
        const JobStatusCancelled = "CANCELLED";

        const TerminalStatuses = (JobStatusSuccess, JobStatusError, JobStatusCancelled);

        #! Default polling interval (ms) when waiting for a job to complete
        const DefaultPollIntervalMs = 1500ms;

        #! Default overall job timeout
        const DefaultJobTimeout = 5m;

        const DefaultOptions = {
            "url": DefaultUrl,
        };
    }

    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for LlamaParse (sync)
public class LlamaParseRestClient inherits RestClient::RestClient, LlamaParseRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(LlamaParseRestClientBase::getOptions(opts), True) {
    }
}

#! REST client for LlamaParse using multiplexed HTTP connections (async)
/** Provides high-level @ref parseDocument() that owns the
    upload → poll → fetch lifecycle internally.

    The polling loop is delegated to
    @ref QoreAsyncJobUtils::AsyncJobPoller "AsyncJobPoller" so the same
    machinery can be reused by other async-REST modules.
*/
public class LlamaParseRestClientIo inherits RestClientIo::RestClientIo, LlamaParseRestClientBase {
    private {
        #! Shared async-job poller (owns the polling loop + injectable sleeper)
        QoreAsyncJobUtils::AsyncJobPoller poller;
    }

    #! Creates the object
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(LlamaParseRestClientBase::getOptions(opts), shared_mgr) {
        poller = new QoreAsyncJobUtils::AsyncJobPoller(
            hash<auto> sub (string job_id) {
                # v2 answers a job read with an envelope carrying the job under "job" alongside the
                # content expansions; the status lives there, not at the top level
                hash<auto> body = restGet(sprintf("%s/%s", ParseApiPath, job_id)).body;
                return body.job.typeCode() == NT_HASH ? body.job : body;
            },
            bool sub (hash<auto> status) {
                return status.status && inlist(status.status, TerminalStatuses);
            },
            "LlamaParse job",
            "LLAMAPARSE-ERROR",
        );
    }

    #! Injects a custom sleeper closure (test seam)
    /** Useful in tests that want to drive @ref pollUntilDone() without
        burning wall-clock time.  Pass a no-op closure to skip sleeps.

        @param s closure invoked on each poll iteration with the wait
            duration that would otherwise be passed to \c usleep()
    */
    setSleeper(code<nothing(timeout)> s) {
        poller.setSleeper(s);
    }

    #! Parses a document end-to-end: submit → poll job → return the content
    /** Runs against the **v2** parse API.  Earlier versions of this module posted the document URL
        as a JSON body to the v1 \c /api/parsing/upload endpoint, which that endpoint does not
        accept - it wants a multipart form - so every call failed with
        \c "Either file, input_url, or input_s3_path must be provided".  The v2 API takes the URL in
        a JSON body and returns the parsed content from the job itself, so the whole lifecycle is
        one submit and one read.

        @param url public URL of the document to parse
        @param options optional LlamaParse parameters
            (\c parsing_instruction, \c language, \c result_type
            (\c markdown / \c text / \c json), \c tier, \c version, \c poll_interval_ms,
            \c job_timeout)

        @return a hash with the following keys:
            - \c job_id — the LlamaParse job id
            - \c status — final job status (always \c COMPLETED at this point)
            - \c result_type — the requested result type
            - \c content — the parsed document content

        @throw LLAMAPARSE-ERROR the result type is not one of the three supported, the job did not
        start, or the job ended in a status other than \c COMPLETED
    */
    hash<auto> parseDocument(string url, *hash<auto> options) {
        string result_type = options.result_type ?? "markdown";
        if (result_type != "markdown" && result_type != "text" && result_type != "json") {
            throw "LLAMAPARSE-ERROR",
                sprintf("invalid result_type %y; expected markdown, text, or json",
                    result_type);
        }

        hash<auto> body = {
            "source_url": url,
            "tier": options.tier ?? DefaultTier,
            "version": options.version ?? "latest",
        };
        if (options.parsing_instruction.val()) {
            # v2 carries the instruction in the tier's own options rather than at the top level
            body.agentic_options = (body.agentic_options ?? {})
                + {"parsing_instruction": options.parsing_instruction};
        }
        if (options.language.val()) {
            body.processing_options = (body.processing_options ?? {})
                + {"languages": (options.language,)};
        }
        if (options.extra) {
            body += options.extra;
        }

        hash<auto> submit = restPost(ParseApiPath, body);
        *string job_id = submit.body.id;
        if (!job_id) {
            throw "LLAMAPARSE-ERROR",
                "the LlamaParse parse request did not return a job id",
                {"body": submit.body};
        }

        string expand = ResultTypeExpandMap{result_type};
        hash<auto> job = pollUntilDone(job_id,
            options.job_timeout ?? DefaultJobTimeout,
            options.poll_interval_ms ?? DefaultPollIntervalMs);

        if (job.status != JobStatusSuccess) {
            throw "LLAMAPARSE-ERROR",
                sprintf("LlamaParse job %y ended with status %y", job_id, job.status),
                {"job": job};
        }

        # the content only comes back when it is asked for; without "expand" the job is metadata
        hash<auto> result = restGet(sprintf("%s/%s?expand=%s", ParseApiPath, job_id, expand)).body;
        return {
            "job_id":      job_id,
            "status":      job.status,
            "result_type": result_type,
            "content":     LlamaParseRestClientIo::collectContent(result, result_type, expand),
        };
    }

    #! Returns the parsed content of a v2 parse result in the requested form
    /** v2 answers with the content split per page; a caller that asked for markdown or text wants
        the document, so the pages are joined.  \c json keeps the per-page structure, which is the
        point of asking for it.

        @param result the expanded parse job
        @param result_type the requested result type
        @param expand the field the content was requested in

        @return the content in the requested form
    */
    private static auto collectContent(hash<auto> result, string result_type, string expand) {
        *list<auto> pages = result{expand}.pages;
        if (!pages) {
            return result{expand} ?? result;
        }
        if (result_type == "json") {
            return pages;
        }
        # the per-page field carries the same name as the expansion
        return (map ($1{expand} ?? "").toString(), pages).join("\n\n");
    }

    #! Polls a LlamaParse job until it reaches a terminal state
    /** Thin wrapper around
        @ref QoreAsyncJobUtils::AsyncJobPoller::poll() — preserved for
        backwards compatibility with callers that previously used this
        method directly.

        @param job_id the LlamaParse job id from a prior \c /upload
        @param to overall timeout for the wait
        @param poll_interval_ms how long to wait between polls

        @return the final job status hash from
            \c GET /job/<id> (terminal state)

        @throw LLAMAPARSE-ERROR overall timeout exceeded
    */
    hash<auto> pollUntilDone(string job_id, *timeout to, *timeout poll_interval_ms) {
        return poller.poll(job_id, to ?? DefaultJobTimeout,
            poll_interval_ms ?? DefaultPollIntervalMs);
    }
}

#! Class for LlamaParse REST connections
public class LlamaParseRestConnection inherits RestClient::RestConnection {
    public {
        #! The default connection URL
        /** The host root: the API description spells every path from the root, so a base path here
            would be prepended to paths that already carry their own prefix.
        */
        const DefaultUrl = "llamaparse://api.cloud.llamaindex.ai";

        #! Every LlamaIndex Cloud region, in probe order
        /** An API key is issued for one region and is rejected with a \c 401 by the other, and the
            rejection names the region as the likely cause without saying which one the key belongs
            to - so the only way to identify it is to try them.  @ref pingImpl() does that.
        */
        const KnownApiUrls = (
            DefaultUrl,
            "llamaparse://api.cloud.eu.llamaindex.ai",
        );

        #! The base path earlier versions of this module put in the connection URL
        /** Kept so that a connection created before the application covered more than the v1
            parsing API keeps working; see @ref normalizeUrl().
        */
        const LegacyUrlPath = "/api/parsing";

        #! The path pinged to verify that the server accepts the API key
        /** A cheap authenticated read: it lists the projects the key can reach, so a key the server
            rejects fails the ping.
        */
        const PingPath = "/api/v2/projects";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "LlamaParse Connection",
            "short_desc": "A connection to the LlamaIndex Cloud document APIs",
            "desc": "A connection to [LlamaParse](https://docs.cloud.llamaindex.ai/llamaparse/getting_started), "
                "LlamaIndex's document platform: parsing documents into markdown, text and "
                "structured items, extracting structured data against a schema, classifying "
                "documents against rules, and splitting a document that holds many.\n\n"
                "Requires an API key for Bearer authentication.  Get your API key from "
                "the [LlamaCloud dashboard](https://cloud.llamaindex.ai/).\n\n"
                "An API key belongs to one region and is rejected by the other.  When the "
                "configured region rejects the key, the connection tries the other known region on "
                "the next ping and moves itself to whichever one accepts it.",
            "cls": Class::forName("LlamaParseRestConnection"),
            "auto_url": True,
            "schemes": {"llamaparse": True},
            "base_scheme_map": {"https": "llamaparse"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "LlamaParse API key (Bearer token)",
                    "type": "string",
                    "desc": "The LlamaParse API key used for Bearer authentication.",
                    "sensitive": True,
                    "preselected": True,
                },
            },
            "required_options": "apikey",
        };
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "llamaparse";
    }

    #! Returns the data provider application name this connection serves
    /** Without this the base class returns nothing, the connection is never associated with its
        app, and @ref ConnectionProvider::AbstractConnection::getInfo() "getInfo()" omits \c app
        entirely.

        @note must match @c LlamaParseDataProvider::AppName; the name is repeated here rather than
        referenced because %LlamaParseDataProvider requires this module, not the reverse
    */
    *string getAppName() {
        return "LlamaParse";
    }

    #! Declares that this connection can update its own options
    /** @ref pingImpl() moves the connection to the region that accepts its API key, and the
        corrected URL has to be persisted for that to be worth anything.  The base class declares
        the feature only for OAuth2 and custom-token connections, whose options change on their own.
    */
    private setFeatures() {
        RestConnection::setFeatures();
        features{CF_UPDATE_OPTIONS} = True;
    }

    #! Pings the server by listing the projects the API key can reach
    /** LlamaIndex serves an unauthenticated liveness endpoint, so a plain reachability ping reports
        success even when the API key is invalid or missing - which is what this connection used to
        do, by declaring no ping at all: every ping returned \c "OK" without contacting the server.
        Listing projects is a cheap authenticated read that returns \c 401 when the key is not
        accepted, so the credentials are actually verified.

        When the configured region rejects the key, the other regions in @ref KnownApiUrls are
        tried, and the connection moves to whichever one accepts it; see @ref adoptWorkingApiUrl().

        Set both the \c ping_method and \c ping_path options to use the standard
        @ref RestClient::RestConnection "RestConnection" ping instead.  Note that such a ping cannot
        detect an invalid API key unless the path it names requires one.

        @throw REST-RESPONSE-ERROR the server rejected the ping request
    */
    private pingImpl() {
        if (opts.ping_method && opts.ping_path) {
            RestConnection::pingImpl();
            return;
        }
        LlamaParseRestClientIo client = cast<LlamaParseRestClientIo>(getAsync());
        try {
            client.restGet(PingPath);
        } catch (hash<ExceptionInfo> ex) {
            # anything other than the server rejecting the key is a real failure of this ping
            if (!LlamaParseRestConnection::isApiKeyRejection(ex) || !adoptWorkingApiUrl(\client)) {
                authFailure();
                rethrow;
            }
        }
        authSuccess();
    }

    #! Returns the regions to try when the configured one rejects the API key
    /** @return @ref KnownApiUrls; override to return nothing to disable the search entirely
    */
    private *softlist<string> getKnownApiUrls() {
        return KnownApiUrls;
    }

    #! Returns @ref True if the exception is the server rejecting the API key
    /** @param ex the exception thrown by the failed request

        @return @ref True if the server rejected the API key
    */
    private static bool isApiKeyRejection(hash<ExceptionInfo> ex) {
        return ex.err == "REST-RESPONSE-ERROR"
            && (ex.arg.status_code == 401 || ex.arg.status_code == 403);
    }

    #! Moves the connection to the known region that accepts its API key
    /** A LlamaIndex Cloud API key is issued for one region and rejected by the other, and the
        rejection says only "check your region" without saying which one the key belongs to, so a
        connection pointed at the wrong region can only be identified by trying the alternative.
        Leaving it pointed at the wrong one is the worse outcome: every request fails with an
        authentication error that reads as a bad key rather than a bad URL, which is exactly the
        wrong thing to go looking at.

        @param client the client whose requests failed

        @return @ref True if the connection was moved to a region that accepts the key
    */
    private bool adoptWorkingApiUrl(reference<LlamaParseRestClientIo> client) {
        *softlist<string> urls = getKnownApiUrls();
        foreach string candidate in (urls) {
            if (candidate == url) {
                continue;
            }
            LlamaParseRestClientIo probe(getConnectionOptions() + {
                "url": LlamaParseRestConnection::normalizeUrl(candidate),
            });
            try {
                probe.restGet(PingPath);
            } catch (hash<ExceptionInfo> ex) {
                if (LlamaParseRestConnection::isApiKeyRejection(ex)) {
                    continue;
                }
                # a region that is unreachable is not evidence about the key
                continue;
            }
            setRealUrl(candidate);
            doUpdateOptions(self, {"url": candidate});
            client = probe;
            return True;
        }
        return False;
    }

    #! Returns the URL with any legacy base path removed
    /** Earlier versions of this module pointed the connection at \c /api/parsing, because the
        module only covered the v1 parsing API.  Every path in the API description is spelled from
        the host root, so that base path would now be prepended to paths that already carry their
        own prefix, and every request would 404.  Stripping it keeps a connection created then
        working without anyone having to edit it.

        @param u the configured URL

        @return the URL with a trailing \c /api/parsing removed
    */
    static string normalizeUrl(string u) {
        return replace(u, LegacyUrlPath, "");
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("LlamaParseDataProvider");
        return create_object("LlamaParseDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private LlamaParseRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new LlamaParseRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new LlamaParseRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        if (rv.url) {
            rv.url = LlamaParseRestConnection::normalizeUrl(rv.url);
        }
        return LlamaParseRestClientBase::getOptions(rv);
    }
}
}

public namespace QoreRagUtils {
#! LlamaParse-backed chunker — extracts a document via LlamaParse, then splits
/** Accepts a URL in the @ref chunk() `content` parameter, sends it to
    LlamaParse for extraction, and splits the returned markdown into
    @ref ChunkInfo records at section-header boundaries (`# `, `## `,
    `### `).

    @par Configuration

    @ref ChunkerConfig fields:

    - \c strategy must be \c "llama-parse"
    - \c target_tokens — soft cap per chunk (default 512); when a section
      exceeds this, it is further split at paragraph boundaries
    - \c options.api_key (required) — LlamaParse API key
    - \c options.url (optional) — override the default LlamaParse URL
    - \c options.parsing_instruction (optional) — natural-language hint
      passed to LlamaParse
    - \c options.language (optional) — document language hint
    - \c options.result_type (optional) — `markdown` (default), `text`,
      or `json`
    - \c options.poll_interval_ms (optional) — polling interval in ms
    - \c options.job_timeout (optional) — overall job timeout

    @par Input modes

    - URL — `content` starts with \c http:// or \c https:// → sent to
      LlamaParse for extraction
    - Inline — `content` is treated as already-extracted markdown; split
      directly without calling LlamaParse.  Useful when callers already
      have markdown they want to chunk with the same section-aware logic
*/
public class LlamaParseChunker inherits AbstractChunker {
    public {
        #! Default LlamaParse REST API URL
        const DefaultUrl = "https://api.cloud.llamaindex.ai/api/parsing";
    }

    private {
        hash<ChunkerConfig> config;
        *LlamaParseRestClient::LlamaParseRestClientIo rest_client;
        Mutex init_mutex();
    }

    constructor(hash<ChunkerConfig> config) {
        self.config = config;
    }

    list<hash<ChunkInfo>> chunk(string content, *hash<auto> metadata) {
        if (!content.val()) {
            return ();
        }

        string markdown;
        *hash<auto> chunk_metadata = metadata;
        if (content =~ /^https?:\/\//) {
            # URL — extract via LlamaParse
            if (!config.options.api_key.val()) {
                throw "LLAMAPARSE-CHUNKER-ERROR",
                    "LlamaParseChunker requires 'options.api_key' when "
                    "extracting URL content";
            }
            ensureRestClient();
            hash<auto> result = rest_client.parseDocument(content,
                config.options ?? {});
            if (result.content.typeCode() == NT_STRING) {
                markdown = result.content;
            } else {
                # JSON result — flatten to markdown best-effort
                markdown = result.content.toString();
            }
            chunk_metadata = (chunk_metadata ?? {}) + {
                "source_url": content,
                "llamaparse_job_id": result.job_id,
            };
        } else {
            # Inline — treat content as already-extracted markdown
            markdown = content;
        }

        return splitMarkdown(markdown, chunk_metadata);
    }

    string getStrategy() {
        return "llama-parse";
    }

    #! Returns the underlying REST client — useful for advanced operations
    *LlamaParseRestClient::LlamaParseRestClientIo getRestClient() {
        ensureRestClient();
        return rest_client;
    }

    #! Splits markdown into ChunkInfo records at #/##/### section boundaries
    private list<hash<ChunkInfo>> splitMarkdown(string markdown, *hash<auto> metadata) {
        int target = config.target_tokens > 0 ? config.target_tokens : 512;

        list<hash<auto>> sections = parseSections(markdown);
        list<hash<ChunkInfo>> chunks = ();
        int idx = 0;
        foreach hash<auto> section in (sections) {
            int section_tokens = approximateTokens(section.text);
            *hash<auto> sec_metadata = metadata;
            if (section.heading.val()) {
                sec_metadata = (sec_metadata ?? {}) + {"section": section.heading};
            }
            if (section_tokens <= target) {
                push chunks, <ChunkInfo>{
                    "index": idx,
                    "content": section.text,
                    "token_count": section_tokens,
                    "metadata": sec_metadata,
                };
                ++idx;
            } else {
                list<string> paragraphs = splitParagraphs(section.text);
                list<string> current = ();
                int current_tokens = 0;
                foreach string p in (paragraphs) {
                    int pt = approximateTokens(p);
                    if (current && current_tokens + pt > target) {
                        push chunks, <ChunkInfo>{
                            "index": idx,
                            "content": (foldl $1 + "\n\n" + $2, current),
                            "token_count": current_tokens,
                            "metadata": sec_metadata,
                        };
                        ++idx;
                        current = ();
                        current_tokens = 0;
                    }
                    push current, p;
                    current_tokens += pt;
                }
                if (current) {
                    push chunks, <ChunkInfo>{
                        "index": idx,
                        "content": (foldl $1 + "\n\n" + $2, current),
                        "token_count": current_tokens,
                        "metadata": sec_metadata,
                    };
                    ++idx;
                }
            }
        }
        return chunks;
    }

    private list<hash<auto>> parseSections(string markdown) {
        list<hash<auto>> sections = ();
        *string current_heading;
        list<string> current_lines = ();
        foreach string line in (markdown.split("\n")) {
            if (line =~ /^#{1,3} /) {
                if (current_lines || current_heading.val()) {
                    push sections, {
                        "heading": current_heading,
                        "text": (foldl $1 + "\n" + $2, current_lines) ?? "",
                    };
                }
                current_heading = line;
                current_heading =~ s/^#+\s+//;
                current_lines = ();
            } else {
                push current_lines, line;
            }
        }
        if (current_lines || current_heading.val()) {
            push sections, {
                "heading": current_heading,
                "text": (foldl $1 + "\n" + $2, current_lines) ?? "",
            };
        }
        list<hash<auto>> trimmed = ();
        foreach hash<auto> s in (sections) {
            string t = s.text;
            t =~ s/^\s+//;
            t =~ s/\s+$//;
            if (t.val() || s.heading.val()) {
                push trimmed, {"heading": s.heading, "text": t};
            }
        }
        return trimmed;
    }

    private list<string> splitParagraphs(string text) {
        string normalized = regex_subst(text, "\n[ \t]*\n(?:[ \t]*\n)*", "\n\n",
            Qore::RE_Global);
        list<string> paragraphs = ();
        foreach string part in (normalized.split("\n\n")) {
            string trimmed = part;
            trimmed =~ s/^\s+//;
            trimmed =~ s/\s+$//;
            if (trimmed.val()) {
                push paragraphs, trimmed;
            }
        }
        return paragraphs;
    }

    private ensureRestClient() {
        if (rest_client) {
            return;
        }
        init_mutex.lock();
        on_exit init_mutex.unlock();
        if (rest_client) {
            return;
        }
        hash<auto!> opts = {
            "url": config.options.url ?? DefaultUrl,
            "apikey": config.options.api_key,
        };
        rest_client = new LlamaParseRestClient::LlamaParseRestClientIo(opts);
    }
}

#! Factory for @ref LlamaParseChunker
public class LlamaParseChunkerFactory inherits AbstractChunkerFactory {
    string getStrategy() {
        return "llama-parse";
    }

    string getDisplayName() {
        return "LlamaParse document extraction + section-aware chunker";
    }

    AbstractChunker create(hash<ChunkerConfig> config) {
        return new LlamaParseChunker(config);
    }
}
}
