%requires qore >= 2.0

%modern

%requires astparser

module QoreCodeFormat {
    version = "1.0";
    desc = "canonical code formatter for Qore (like gofmt)";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage QoreCodeFormat Module

    @section qorecodeformatintro QoreCodeFormat Module Introduction

    The %QoreCodeFormat module provides a canonical code formatter for the Qore programming
    language, similar to \c gofmt for Go.

    It uses the AST parser (\c astparser binary module) to parse Qore source code and then
    re-emits it in a canonical format with consistent indentation, brace placement, and spacing.

    @section qorecodeformatfeatures Features

    - 4-space indentation (no tabs)
    - Opening braces on same line
    - Mandatory braces for if/while/for/foreach/do-while
    - Space around binary operators
    - Parse directives at column 0
    - One blank line between top-level declarations
    - Comment preservation
    - Source literal preservation (strings, regex, numbers)

    @section qorecodeformatusage Usage

    @code{.py}
%requires QoreCodeFormat

QoreCodeFormat::CodeFormatter fmt();
string formatted = fmt.format(source_code);
    @endcode
*/

#! Main QoreCodeFormat namespace
public namespace QoreCodeFormat {
}
