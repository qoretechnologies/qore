# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) ZohoInventoryRestClient
%try-module json
%define NoJson
%endtry

module ZohoInventoryDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Zoho Inventory";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new ZohoInventoryDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ZohoInventoryDataProvider::AppName,
            "display_name": "Zoho Inventory",
            "short_desc": "Zoho Inventory management software",
            "desc": "Zoho Inventory is an online inventory management software that helps "
                "businesses manage orders, warehousing, and shipping.\n\n"
                "This integration supports contacts, items, item groups, item adjustments, "
                "packages, purchase orders, sales orders, and shipment orders.",
            "scheme": "zohoinventory",
            "logo": ZohoInventoryLogo,
            "logo_file_name": "zohoinventory-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Ecommerce,),
        });

        # ========== CONTACT ACTIONS ==========

        # Search Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/contacts",
            "action": "list-contacts",
            "groups": "Contacts",
            "display_name": "Search Contacts",
            "short_desc": "Search and list contacts",
            "desc": "Search and retrieve a list of contacts from Zoho Inventory with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_name": <ActionOptionInfo>{
                    "display_name": "Contact Name",
                    "short_desc": "Filter by contact name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Filter by email address",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "phone": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Filter by phone number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by contact status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "active", "desc": "Active contacts"},
                        <AllowedValueInfo>{"value": "inactive", "desc": "Inactive contacts"},
                    ),
                },
                "contact_type": <ActionOptionInfo>{
                    "display_name": "Contact Type",
                    "short_desc": "Filter by contact type",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "customer", "desc": "Customer contact"},
                        <AllowedValueInfo>{"value": "vendor", "desc": "Vendor contact"},
                    ),
                },
            },
        });

        # Create Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/create-contact",
            "action": "create-contact",
            "groups": "Contacts",
            "display_name": "Create Contact",
            "short_desc": "Create a new contact",
            "desc": "Create a new contact in Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_name": <ActionOptionInfo>{
                    "display_name": "Contact Name",
                    "short_desc": "Name of the contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                },
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company Name",
                    "short_desc": "Company name for the contact",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "contact_type": <ActionOptionInfo>{
                    "display_name": "Contact Type",
                    "short_desc": "Type of contact",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The type of contact",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "customer", "desc": "Customer contact"},
                        <AllowedValueInfo>{"value": "vendor", "desc": "Vendor contact"},
                    ),
                },
                "payment_terms": <ActionOptionInfo>{
                    "display_name": "Payment Terms",
                    "short_desc": "Payment terms in days",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "currency_id": <ActionOptionInfo>{
                    "display_name": "Currency",
                    "short_desc": "Currency for the contact",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "currencies",
                },
                "website": <ActionOptionInfo>{
                    "display_name": "Website",
                    "short_desc": "Website URL of the contact",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Notes about the contact",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
            "output_type": new ZohoInventoryContactDataType(),
        });

        # Get Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/get-contact",
            "action": "get-contact",
            "groups": "Contacts",
            "display_name": "Get Contact",
            "short_desc": "Get contact details",
            "desc": "Retrieve details of a specific contact from Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact",
                    "short_desc": "The contact to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
            "output_type": new ZohoInventoryContactDataType(),
        });

        # Update Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/update-contact",
            "action": "update-contact",
            "groups": "Contacts",
            "display_name": "Update Contact",
            "short_desc": "Update an existing contact",
            "desc": "Update an existing contact in Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact",
                    "short_desc": "The contact to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
                "contact_name": <ActionOptionInfo>{
                    "display_name": "Contact Name",
                    "short_desc": "Name of the contact",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company Name",
                    "short_desc": "Company name for the contact",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "contact_type": <ActionOptionInfo>{
                    "display_name": "Contact Type",
                    "short_desc": "Type of contact",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The type of contact",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "customer", "desc": "Customer contact"},
                        <AllowedValueInfo>{"value": "vendor", "desc": "Vendor contact"},
                    ),
                },
                "payment_terms": <ActionOptionInfo>{
                    "display_name": "Payment Terms",
                    "short_desc": "Payment terms in days",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "website": <ActionOptionInfo>{
                    "display_name": "Website",
                    "short_desc": "Website URL of the contact",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Notes about the contact",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
            "output_type": new ZohoInventoryContactDataType(),
        });

        # Delete Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/delete-contact",
            "action": "delete-contact",
            "groups": "Contacts",
            "display_name": "Delete Contact",
            "short_desc": "Delete a contact",
            "desc": "Delete a contact from Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact",
                    "short_desc": "The contact to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
            "output_type": new ZohoInventoryDeleteResponseDataType(),
        });

        # Mark Contact Active/Inactive
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/mark-contact-active",
            "action": "mark-contact-active",
            "groups": "Contacts",
            "display_name": "Mark Contact Active/Inactive",
            "short_desc": "Mark a contact as active or inactive",
            "desc": "Mark a contact as active or inactive in Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact",
                    "short_desc": "The contact to mark",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
                "active": <ActionOptionInfo>{
                    "display_name": "Active",
                    "short_desc": "Active status",
                    "type": AbstractDataProviderTypeMap."bool",
                    "required": True,
                    "desc": "`True` to mark active, `False` to mark inactive",
                },
            },
            "output_type": new ZohoInventoryDeleteResponseDataType(),
        });

        # ========== CONTACT PERSON ACTIONS ==========

        # List Contact Persons
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/contactpersons",
            "action": "list-contact-persons",
            "groups": "Contact Persons",
            "display_name": "List Contact Persons",
            "short_desc": "List contact persons for a contact",
            "desc": "Retrieve a list of contact persons for a specific contact in Zoho Inventory",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact",
                    "short_desc": "The parent contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
        });

        # Create Contact Person
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/create-contact-person",
            "action": "create-contact-person",
            "groups": "Contact Persons",
            "display_name": "Create Contact Person",
            "short_desc": "Create a new contact person",
            "desc": "Create a new contact person for a contact in Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact",
                    "short_desc": "The parent contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
                "first_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "First name of the contact person",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                },
                "last_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Last name of the contact person",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Email address",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "phone": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Phone number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "designation": <ActionOptionInfo>{
                    "display_name": "Designation",
                    "short_desc": "Job title or designation",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
            "output_type": new ZohoInventoryContactPersonDataType(),
        });

        # Get Contact Person
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/get-contact-person",
            "action": "get-contact-person",
            "groups": "Contact Persons",
            "display_name": "Get Contact Person",
            "short_desc": "Get contact person details",
            "desc": "Retrieve details of a specific contact person from Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_person_id": <ActionOptionInfo>{
                    "display_name": "Contact Person",
                    "short_desc": "The contact person to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contact_persons",
                },
            },
            "output_type": new ZohoInventoryContactPersonDataType(),
        });

        # Update Contact Person
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/update-contact-person",
            "action": "update-contact-person",
            "groups": "Contact Persons",
            "display_name": "Update Contact Person",
            "short_desc": "Update an existing contact person",
            "desc": "Update an existing contact person in Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_person_id": <ActionOptionInfo>{
                    "display_name": "Contact Person",
                    "short_desc": "The contact person to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contact_persons",
                },
                "first_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "First name of the contact person",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "last_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Last name of the contact person",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Email address",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "phone": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Phone number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "designation": <ActionOptionInfo>{
                    "display_name": "Designation",
                    "short_desc": "Job title or designation",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
            "output_type": new ZohoInventoryContactPersonDataType(),
        });

        # Delete Contact Person
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/delete-contact-person",
            "action": "delete-contact-person",
            "groups": "Contact Persons",
            "display_name": "Delete Contact Person",
            "short_desc": "Delete a contact person",
            "desc": "Delete a contact person from Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_person_id": <ActionOptionInfo>{
                    "display_name": "Contact Person",
                    "short_desc": "The contact person to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contact_persons",
                },
            },
            "output_type": new ZohoInventoryDeleteResponseDataType(),
        });

        # Mark Contact Person Primary
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/mark-contact-person-primary",
            "action": "mark-contact-person-primary",
            "groups": "Contact Persons",
            "display_name": "Mark Contact Person Primary",
            "short_desc": "Mark a contact person as primary",
            "desc": "Mark a contact person as the primary contact person in Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_person_id": <ActionOptionInfo>{
                    "display_name": "Contact Person",
                    "short_desc": "The contact person to mark as primary",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contact_persons",
                },
            },
            "output_type": new ZohoInventoryDeleteResponseDataType(),
        });

        # ========== ITEM ACTIONS ==========

        # List Items
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/items",
            "action": "list-items",
            "groups": "Items",
            "display_name": "List Items",
            "short_desc": "List and search items",
            "desc": "Retrieve a list of items from Zoho Inventory with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Filter by item name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sku": <ActionOptionInfo>{
                    "display_name": "SKU",
                    "short_desc": "Filter by SKU",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "item_type": <ActionOptionInfo>{
                    "display_name": "Item Type",
                    "short_desc": "Filter by item type",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "inventory", "desc": "Inventory items"},
                        <AllowedValueInfo>{"value": "sales", "desc": "Sales items"},
                        <AllowedValueInfo>{"value": "purchases", "desc": "Purchase items"},
                        <AllowedValueInfo>{"value": "sales_and_purchases", "desc": "Sales and purchase items"},
                    ),
                },
            },
        });

        # Create Item
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/create-item",
            "action": "create-item",
            "groups": "Items",
            "display_name": "Create Item",
            "short_desc": "Create a new item",
            "desc": "Create a new item in Zoho Inventory",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Inventory organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Item name",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                },
                "rate": <ActionOptionInfo>{
                    "display_name": "Rate",
                    "short_desc": "Selling price of the item",
                    "type": AbstractDataProviderTypeMap."float",
                    "required": True,
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "Item description",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sku": <ActionOptionInfo>{
                    "display_name": "SKU",
                    "short_desc": "Stock keeping unit",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "unit": <ActionOptionInfo>{
                    "display_name": "Unit",
                    "short_desc": "Unit of measurement",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "item_type": <ActionOptionInfo>{
                    "display_name": "Item Type",
                    "short_desc": "Type of item",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The type of the item",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "inventory", "desc": "Inventory item"},
                        <AllowedValueInfo>{"value": "sales", "desc": "Sales item"},
                        <AllowedValueInfo>{"value": "purchases", "desc": "Purchase item"},
                        <AllowedValueInfo>{"value": "sales_and_purchases", "desc": "Sales and purchase item"},
                    ),
                },
                "purchase_rate": <ActionOptionInfo>{
                    "display_name": "Purchase Rate",
                    "short_desc": "Cost price of the item",
                    "type": AbstractDataProviderTypeMap."*float",
                },
                "account_id": <ActionOptionInfo>{
                    "display_name": "Sales Account",
                    "short_desc": "Sales account",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "purchase_account_id": <ActionOptionInfo>{
                    "display_name": "Purchase Account",
                    "short_desc": "Purchase account",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "inventory_account_id": <ActionOptionInfo>{
                    "display_name": "Inventory Account",
                    "short_desc": "Inventory account",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
            "output_type": new ZohoInventoryItemDataType(),
        });

        # Get Item
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInventoryDataProvider::AppName,
            "path": "/get-item",
            "action": "get-item",
            "groups": "Items",
            "display_name": "Get Item",
