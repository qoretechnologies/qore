%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) AzureOpenAiRestClient
%requires(reexport) AzureAuth
%requires RestClientIo
%requires RestSchemaActions
%requires OpenApi3

module AzureOpenAiDataProvider {
    version = "1.0";
    desc = "Azure OpenAI actions for inference, media, files, batches, evaluation, and model customization";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        DataProviderActionCatalog::registerDiscoveryInventoryProvider("AzureOpenAiDataProvider",
            list<hash<DataProviderDiscoveryExpectedIdentityInfo>> sub () {
                return (<DataProviderDiscoveryExpectedIdentityInfo>{"app": AzureOpenAiDataProvider::AppName},)
                    + (map <DataProviderDiscoveryExpectedIdentityInfo>{
                        "app": AzureOpenAiDataProvider::AppName, "action": $1.action,
                    }, AzureOpenAiManifest::Manifest + AzureOpenAiAudioManifest::Manifest)
                    + (<DataProviderDiscoveryExpectedIdentityInfo>{
                        "app": AzureOpenAiDataProvider::AppName, "action": "make-api-call",
                    },);
            });
        DataProvider::registerFactory(new AzureOpenAiDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": AzureOpenAiDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Azure OpenAI",
            "short_desc": "Microsoft Azure OpenAI Service",
            "desc": "**Azure OpenAI** connects business workflows to models deployed in your Azure resource. "
                "Use one connection to work with multiple deployments and manage their supporting data.\n\n"
                "- Generate answers, structured results, and tool calls with Chat Completions and Responses\n"
                "- Create embeddings for search and matching\n"
                "- Generate speech, images, and videos, or transcribe and translate audio\n"
                "- Upload files, run batches, and organize retrieval with vector stores\n"
                "- Manage conversations, fine-tuning, evaluations, and realtime calls\n\n"
                "**Deployment names:** Copy names from Models and endpoints in the Azure Foundry portal. "
                "They can differ from catalog model IDs. Audio uploads use the deployment-based API. Other media operations use the v1 preview API; "
                "availability depends on regional API rollout and your resource's deployments, permissions, and quota.\n\n"
                "**Conversations:** Use a Foundry project endpoint and Microsoft Entra authentication.\n\n"
                "[Azure OpenAI documentation](https://learn.microsoft.com/en-us/azure/foundry/openai/)",
            "scheme": "azure-openai",
            "logo": AzureLogo,
            "logo_file_name": "azure-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        foreach RestSchemaActionSet actions in (AzureOpenAiSchema::getActionSets()) {
            foreach hash<DataProviderActionInfo> action in (
                    actions.getActionInfoList(AzureOpenAiDataProvider::AppName)) {
                if (action.action == "embedding") {
                    action.mutates_state = False;
                }
                DataProviderActionCatalog::registerAction(action);
            }
        }
    };
}

/** @mainpage AzureOpenAiDataProvider Module

    @tableofcontents

    @section azureopenaidataproviderintro Introduction to the AzureOpenAiDataProvider Module

    The %AzureOpenAiDataProvider module exposes 99 reviewed Azure OpenAI API operations plus the
    generic API-call action. Its pinned Microsoft v1 and deployment-based audio descriptions supply typed request and response
    contracts, finite choices, and nested options. The manifest supplies stable action identities,
    user-facing presentation, deployment guidance, and resource dropdowns.

    @par Action families
    Chat Completions, Responses, embeddings, audio, images, videos, files, batches, conversations,
    containers, evaluations, fine-tuning, realtime calls, and vector stores. Retired Assistants threads
    and DALL-E 2 image variations are excluded. Speech, image, and video generation select the v1 preview API.
    Transcription and translation use deployment-based audio paths and default to <tt>2025-04-01-preview</tt>.
    Whisper supports JSON, verbose JSON, plain text, SRT, and VTT; GPT transcription deployments support
    JSON output. Word and segment timestamps require Whisper and <tt>verbose_json</tt>. Audio actions accept a
    named file with its extension, binary content, and optional MIME type.
    Conversations require a Foundry project endpoint such as
    <tt>https://my-resource.services.ai.azure.com/api/projects/my-project</tt> with Microsoft Entra authentication.
    Resource-only Azure OpenAI endpoints do not provide the project Conversations API. Other operation availability
    depends on the resource and regional rollout. Resource updates can become visible to reads asynchronously.

    @par Compatibility
    The original <tt>chat-completion</tt> and <tt>embedding</tt> action IDs and their <tt>deployment</tt> option remain
    unchanged. They now send the deployment as <tt>model</tt> to v1 endpoints. The public legacy provider
    classes and LLM client retain dated deployment routes and <tt>azure_api_version</tt>.

    @par Example
    @code{.py}
%requires AzureOpenAiDataProvider
AzureOpenAiDataProvider::AzureOpenAiDataProvider app({
    "url": ENV.AZURE_OPENAI_ENDPOINT, "api_key": ENV.AZURE_OPENAI_API_KEY,
});
auto answer = app.getChildProvider("create-response").doRequest({
    "model": ENV.AZURE_OPENAI_DEPLOYMENT, "input": "Summarize the invoice requirements.", "store": False,
});
    @endcode

    @par Audio example
    @code{.py}
auto transcript = app.getChildProvider("create-transcription").doRequest({
    "model": "my-whisper-deployment",
    "file": {"name": "customer-call.wav", "content": File::readBinaryFile("customer-call.wav"),
        "mime_type": "audio/wav"},
    "response_format": "verbose_json", "timestamp_granularities": ("word", "segment"),
});
    @endcode

    @par Live media tests
    <tt>examples/test/qlib/AzureOpenAiDataProvider/AzureOpenAiMedia.qtest</tt> uses the explicitly configured
    <tt>AZURE_MEDIA_ENDPOINT</tt>, <tt>AZURE_MEDIA_API_KEY</tt>, and deployment variables described in the test.
    It makes short billable inference requests. Normal CI uses the offline request and response fixtures.

    @par Live conversation tests
    <tt>AzureOpenAiConversations.qtest</tt> uses <tt>AZURE_FOUNDRY_ENDPOINT</tt> and <tt>AZURE_FOUNDRY_ACCESS_TOKEN</tt>.
    Obtain a short-lived development token with <tt>az account get-access-token --resource https://ai.azure.com</tt>;
    the signed-in user needs the Foundry User role on the project. Production connections use the existing
    Entra client-credentials or managed-identity modes; the token scope defaults to <tt>https://ai.azure.com/.default</tt>
    for project endpoints. Conversation actions omit <tt>api-version</tt>, which the Foundry v1 path rejects.
    The test deletes the temporary conversation and its items.

    @par Factory

    The factory name is <b><tt>azure-openai</tt></b>; resolve a connected
    provider via:
    @code{.py}
AbstractDataProvider p = DataProvider::getFactoryObjectFromString(
    "azure-openai{url=https://my-resource.openai.azure.com,api_key=...}");
    @endcode

    @section azureopenaidataproviderrelnotes Release Notes

    @subsection azureopenaidataprovider_v1_0 AzureOpenAiDataProvider v1.0
    - initial release: 99 reviewed Azure OpenAI operations plus the generic API-call action, registered
      under the \c azure-openai app + scheme, with resource dropdowns and media uploads
    - deployment-based transcription and translation with typed JSON, text, and subtitle responses
    - Foundry project paths remain intact through actions, copied clients, and connection pings
    - explicit speech formats and named image arrays retain their wire values and upload metadata
    - authenticated connection clients preserve credentials across copies and raw requests
    - pinned, pruned schema imports include checked repairs for documented upstream contract defects
    - recursive presentation catalogs, exact discovery inventory, and value/serialization regressions
*/

#! Contains all public definitions in the AzureOpenAiDataProvider module
public namespace AzureOpenAiDataProvider {
#! Azure OpenAI app name
public const AppName = "AzureOpenAI";
}

#! Module-level constants in a private namespace per the audit-changes design rule
namespace Priv {
    #! Azure logo loaded from the SVG file shipped with the module
    public const AzureLogo = File::readTextFile(get_script_dir() + "/azure-logo.svg");
}
public namespace AzureOpenAiDataProvider {
    #! Re-export the logo into the module's public namespace
    public const AzureLogo = Priv::AzureLogo;
}
