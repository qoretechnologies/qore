        # Watch Updated Order Status
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_ORDER_STATUS_UPDATED,
            "action": EVENT_ORDER_STATUS_UPDATED,
            "groups": "Triggers",
            "display_name": "Watch Updated Order Status",
            "short_desc": "Trigger when an order status changes",
            "desc": "Fires when the order status has changed in BigCommerce. "
                "Uses polling to detect status changes (V2 Orders API).",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_ORDER_STATUS_UPDATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
