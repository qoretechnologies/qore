# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) BigCommerceRestClient

module BigCommerceDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for BigCommerce e-commerce";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new BigCommerceDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": BigCommerceDataProvider::AppName,
            "display_name": "BigCommerce",
            "short_desc": "BigCommerce e-commerce platform",
            "desc": "BigCommerce is a leading e-commerce platform for online stores.\n\n"
                "This integration supports customers, products, orders, carts, "
                "shipments, blog posts, and customer addresses.",
            "scheme": "bigcommerceres",
            "logo": BigCommerceLogo,
            "logo_file_name": "bigcommerce-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Ecommerce,),
        });

        # ========== CUSTOMER ACTIONS ==========

        # Create a Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customers/create",
            "action": "create-customer",
            "groups": "Customers",
            "display_name": "Create a Customer",
            "short_desc": "Create a new customer",
            "desc": "Create a new customer in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceCreateCustomerRequestDataType::Fields),
            "output_type": new BigCommerceCustomerDataType(),
        });

        # Update a Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customers/update",
            "action": "update-customer",
            "groups": "Customers",
            "display_name": "Update a Customer",
            "short_desc": "Update an existing customer",
            "desc": "Update an existing customer in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceUpdateCustomerRequestDataType::Fields),
            "output_type": new BigCommerceCustomerDataType(),
        });

        # Delete a Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customers/delete",
            "action": "delete-customer",
            "groups": "Customers",
            "display_name": "Delete a Customer",
            "short_desc": "Delete a customer",
            "desc": "Delete a customer from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceDeleteCustomerRequestDataType::Fields),
            "output_type": new BigCommerceDeleteResponseDataType(),
        });

        # Get a Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customers/get",
            "action": "get-customer",
            "groups": "Customers",
            "display_name": "Get a Customer",
            "short_desc": "Get a single customer by ID",
            "desc": "Retrieve a single customer by ID from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceGetCustomerRequestDataType::Fields),
            "output_type": new BigCommerceCustomerDataType(),
        });

        # Search Customers
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customers",
            "action": "search-customers",
            "groups": "Customers",
            "display_name": "Search Customers",
            "short_desc": "Search for customers or list all",
            "desc": "Search for specific customers or list all customers in BigCommerce",
            "action_code": DPAT_FIND,
            "options": {
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "Filter by customer ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
                "company": <ActionOptionInfo>{
                    "display_name": "Company",
                    "short_desc": "Filter by company name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "customer_group_id": <ActionOptionInfo>{
                    "display_name": "Customer Group ID",
                    "short_desc": "Filter by customer group",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customer_groups",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Filter by email",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Filter by exact name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "name_like": <ActionOptionInfo>{
                    "display_name": "Name (Like)",
                    "short_desc": "Filter by partial name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "date_created_min": <ActionOptionInfo>{
                    "display_name": "Date Created (Min)",
                    "short_desc": "Minimum creation date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "date_modified_min": <ActionOptionInfo>{
                    "display_name": "Date Modified (Min)",
                    "short_desc": "Minimum modification date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "sort": <ActionOptionInfo>{
                    "display_name": "Sort",
                    "short_desc": "Sort order",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "date_created:asc",
                            "desc": "Sort by creation date ascending"},
                        <AllowedValueInfo>{"value": "date_created:desc",
                            "desc": "Sort by creation date descending"},
                        <AllowedValueInfo>{"value": "last_name:asc",
                            "desc": "Sort by last name ascending"},
                        <AllowedValueInfo>{"value": "last_name:desc",
                            "desc": "Sort by last name descending"},
                        <AllowedValueInfo>{"value": "date_modified:asc",
                            "desc": "Sort by modification date ascending"},
                        <AllowedValueInfo>{"value": "date_modified:desc",
                            "desc": "Sort by modification date descending"},
                    ),
                },
            },
        });

        # ========== CUSTOMER ADDRESS ACTIONS ==========

        # Create a Customer Address
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customer-addresses/create",
            "action": "create-customer-address",
            "groups": "Customers",
            "display_name": "Create a Customer Address",
            "short_desc": "Create a new address for a customer",
            "desc": "Create a new address for a customer in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceCreateCustomerAddressRequestDataType::Fields),
            "output_type": new BigCommerceCustomerAddressDataType(),
        });

        # Search Customer Addresses
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customer-addresses",
            "action": "search-customer-addresses",
            "groups": "Customers",
            "display_name": "Search Customer Addresses",
            "short_desc": "Search for customer addresses or list all",
            "desc": "Search for specific customer addresses or list them all in BigCommerce",
            "action_code": DPAT_FIND,
            "options": {
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "Filter by customer ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "ref_data": "customers",
                },
                "company": <ActionOptionInfo>{
                    "display_name": "Company",
                    "short_desc": "Filter by company",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Filter by name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "address_id": <ActionOptionInfo>{
                    "display_name": "Address ID",
                    "short_desc": "Filter by address ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customer_addresses",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Update a Customer Address
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customer-addresses/update",
            "action": "update-customer-address",
            "groups": "Customers",
            "display_name": "Update a Customer Address",
            "short_desc": "Update an existing customer address",
            "desc": "Update an existing customer address in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceUpdateCustomerAddressRequestDataType::Fields),
            "output_type": new BigCommerceCustomerAddressDataType(),
        });

        # Delete a Customer Address
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/customer-addresses/delete",
            "action": "delete-customer-address",
            "groups": "Customers",
            "display_name": "Delete a Customer Address",
            "short_desc": "Delete a customer address",
            "desc": "Delete a customer address from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceDeleteCustomerAddressRequestDataType::Fields),
            "output_type": new BigCommerceDeleteResponseDataType(),
        });

        # ========== PRODUCT ACTIONS ==========

        # Create a Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/products/create",
            "action": "create-product",
            "groups": "Products",
            "display_name": "Create a Product",
            "short_desc": "Create a new product",
            "desc": "Create a new product in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceCreateProductRequestDataType::Fields),
            "output_type": new BigCommerceProductDataType(),
        });

        # Update a Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/products/update",
            "action": "update-product",
            "groups": "Products",
            "display_name": "Update a Product",
            "short_desc": "Update an existing product",
            "desc": "Update an existing product in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceUpdateProductRequestDataType::Fields),
            "output_type": new BigCommerceProductDataType(),
        });

        # Delete a Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/products/delete",
            "action": "delete-product",
            "groups": "Products",
            "display_name": "Delete a Product",
            "short_desc": "Delete a product",
            "desc": "Delete a product from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceDeleteProductRequestDataType::Fields),
            "output_type": new BigCommerceDeleteResponseDataType(),
        });

        # Get a Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/products/get",
            "action": "get-product",
            "groups": "Products",
            "display_name": "Get a Product",
            "short_desc": "Get a single product by ID",
            "desc": "Retrieve a single product by ID from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceGetProductRequestDataType::Fields),
            "output_type": new BigCommerceProductDataType(),
        });

        # Search Products
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/products",
            "action": "search-products",
            "groups": "Products",
            "display_name": "Search Products",
            "short_desc": "Search for products or list all",
            "desc": "Search for specific products or list all products in BigCommerce",
            "action_code": DPAT_FIND,
            "options": {
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "Filter by product ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "products",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Filter by exact name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "name_like": <ActionOptionInfo>{
                    "display_name": "Name (Like)",
                    "short_desc": "Filter by partial name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sku": <ActionOptionInfo>{
                    "display_name": "SKU",
                    "short_desc": "Filter by SKU",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "keyword": <ActionOptionInfo>{
                    "display_name": "Keyword",
                    "short_desc": "Search keyword",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "brand_id": <ActionOptionInfo>{
                    "display_name": "Brand ID",
                    "short_desc": "Filter by brand",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "brands",
                },
                "condition": <ActionOptionInfo>{
                    "display_name": "Condition",
                    "short_desc": "Filter by condition",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "New", "desc": "New products"},
                        <AllowedValueInfo>{"value": "Used", "desc": "Used products"},
                        <AllowedValueInfo>{"value": "Refurbished",
                            "desc": "Refurbished products"},
                    ),
                },
                "categories": <ActionOptionInfo>{
                    "display_name": "Categories",
                    "short_desc": "Filter by category IDs",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "is_visible": <ActionOptionInfo>{
                    "display_name": "Is Visible",
                    "short_desc": "Filter by visibility",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "date_modified_min": <ActionOptionInfo>{
                    "display_name": "Date Modified (Min)",
                    "short_desc": "Minimum modification date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "sort": <ActionOptionInfo>{
                    "display_name": "Sort",
                    "short_desc": "Sort field",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "id", "desc": "Sort by product ID"},
                        <AllowedValueInfo>{"value": "name", "desc": "Sort by product name"},
                        <AllowedValueInfo>{"value": "sku", "desc": "Sort by SKU"},
                        <AllowedValueInfo>{"value": "price", "desc": "Sort by price"},
                        <AllowedValueInfo>{"value": "date_modified",
                            "desc": "Sort by modification date"},
                        <AllowedValueInfo>{"value": "date_last_imported",
                            "desc": "Sort by last import date"},
                        <AllowedValueInfo>{"value": "inventory_level",
                            "desc": "Sort by inventory level"},
                        <AllowedValueInfo>{"value": "is_visible",
                            "desc": "Sort by visibility"},
                        <AllowedValueInfo>{"value": "name:asc",
                            "desc": "Sort by name ascending"},
                        <AllowedValueInfo>{"value": "name:desc",
                            "desc": "Sort by name descending"},
                    ),
                },
                "direction": <ActionOptionInfo>{
                    "display_name": "Direction",
                    "short_desc": "Sort direction",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "desc": "Ascending order"},
                        <AllowedValueInfo>{"value": "desc", "desc": "Descending order"},
                    ),
                },
            },
        });

        # ========== BLOG POST ACTIONS ==========

        # Create a Blog Post
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/blog-posts/create",
            "action": "create-blog-post",
            "groups": "Content",
            "display_name": "Create a Blog Post",
            "short_desc": "Create a new blog post",
            "desc": "Create a new blog post in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceCreateBlogPostRequestDataType::Fields),
            "output_type": new BigCommerceBlogPostDataType(),
        });

        # Get a Blog Post
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/blog-posts/get",
            "action": "get-blog-post",
            "groups": "Content",
            "display_name": "Get a Blog Post",
            "short_desc": "Get a single blog post by ID",
            "desc": "Retrieve a single blog post by ID from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceGetBlogPostRequestDataType::Fields),
            "output_type": new BigCommerceBlogPostDataType(),
        });

        # Update a Blog Post
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/blog-posts/update",
            "action": "update-blog-post",
            "groups": "Content",
            "display_name": "Update a Blog Post",
            "short_desc": "Update an existing blog post",
            "desc": "Update an existing blog post in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceUpdateBlogPostRequestDataType::Fields),
            "output_type": new BigCommerceBlogPostDataType(),
        });

        # Delete a Blog Post
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/blog-posts/delete",
            "action": "delete-blog-post",
            "groups": "Content",
            "display_name": "Delete a Blog Post",
            "short_desc": "Delete a blog post",
            "desc": "Delete a blog post from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceDeleteBlogPostRequestDataType::Fields),
            "output_type": new BigCommerceDeleteResponseDataType(),
        });

        # Search Blog Posts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/blog-posts",
            "action": "search-blog-posts",
            "groups": "Content",
            "display_name": "Search Blog Posts",
            "short_desc": "Search for blog posts or list all",
            "desc": "Search for specific blog posts or list all blog posts in BigCommerce",
            "action_code": DPAT_FIND,
            "options": {
                "is_published": <ActionOptionInfo>{
                    "display_name": "Is Published",
                    "short_desc": "Filter by published status",
                    "type": AbstractDataProviderTypeMap."*bool",
                    "preselected": True,
                },
                "tag": <ActionOptionInfo>{
                    "display_name": "Tag",
                    "short_desc": "Filter by tag",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # ========== ORDER ACTIONS ==========

        # Get an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/orders/get",
            "action": "get-order",
            "groups": "Orders",
            "display_name": "Get an Order",
            "short_desc": "Get a single order by ID",
            "desc": "Retrieve a single order by ID from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceGetOrderRequestDataType::Fields),
            "output_type": new BigCommerceOrderDataType(),
        });

        # Update an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/orders/update",
            "action": "update-order",
            "groups": "Orders",
            "display_name": "Update an Order",
            "short_desc": "Update an existing order",
            "desc": "Update an existing order in BigCommerce (e.g., change status, add notes)",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceUpdateOrderRequestDataType::Fields),
            "output_type": new BigCommerceOrderDataType(),
        });

        # Search Orders
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/orders",
            "action": "search-orders",
            "groups": "Orders",
            "display_name": "Search Orders",
            "short_desc": "Search for orders or list all",
            "desc": "Search for specific orders or list all orders in BigCommerce",
            "action_code": DPAT_FIND,
            "options": {
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "Filter by order ID",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "orders",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                    "ref_data": "customers",
                },
                "status_id": <ActionOptionInfo>{
                    "display_name": "Status ID",
                    "short_desc": "Filter by status",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                    "desc": "Filter orders by status ID",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": 0, "desc": "Incomplete"},
                        <AllowedValueInfo>{"value": 1, "desc": "Pending"},
                        <AllowedValueInfo>{"value": 2, "desc": "Shipped"},
                        <AllowedValueInfo>{"value": 3, "desc": "Partially Shipped"},
                        <AllowedValueInfo>{"value": 4, "desc": "Refunded"},
                        <AllowedValueInfo>{"value": 5, "desc": "Cancelled"},
                        <AllowedValueInfo>{"value": 6, "desc": "Declined"},
                        <AllowedValueInfo>{"value": 7, "desc": "Awaiting Payment"},
                        <AllowedValueInfo>{"value": 8, "desc": "Awaiting Pickup"},
                        <AllowedValueInfo>{"value": 9, "desc": "Awaiting Shipment"},
                        <AllowedValueInfo>{"value": 10, "desc": "Completed"},
                        <AllowedValueInfo>{"value": 11, "desc": "Awaiting Fulfillment"},
                        <AllowedValueInfo>{"value": 12, "desc": "Manual Verification Required"},
                        <AllowedValueInfo>{"value": 13, "desc": "Disputed"},
                        <AllowedValueInfo>{"value": 14, "desc": "Partially Refunded"},
                    ),
                },
                "min_date_created": <ActionOptionInfo>{
                    "display_name": "Min Date Created",
                    "short_desc": "Minimum creation date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "max_date_created": <ActionOptionInfo>{
                    "display_name": "Max Date Created",
                    "short_desc": "Maximum creation date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "min_date_modified": <ActionOptionInfo>{
                    "display_name": "Min Date Modified",
                    "short_desc": "Minimum modification date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "min_total": <ActionOptionInfo>{
                    "display_name": "Min Total",
                    "short_desc": "Minimum order total",
                    "type": AbstractDataProviderTypeMap."*float",
                },
                "max_total": <ActionOptionInfo>{
                    "display_name": "Max Total",
                    "short_desc": "Maximum order total",
                    "type": AbstractDataProviderTypeMap."*float",
                },
                "is_deleted": <ActionOptionInfo>{
                    "display_name": "Is Deleted",
                    "short_desc": "Filter by deletion status",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "payment_method": <ActionOptionInfo>{
                    "display_name": "Payment Method",
                    "short_desc": "Filter by payment method",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sort": <ActionOptionInfo>{
                    "display_name": "Sort",
                    "short_desc": "Sort field",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "id",
                            "desc": "Sort by order ID"},
                        <AllowedValueInfo>{"value": "date_created",
                            "desc": "Sort by creation date"},
                        <AllowedValueInfo>{"value": "date_modified",
                            "desc": "Sort by modification date"},
                        <AllowedValueInfo>{"value": "customer_id",
                            "desc": "Sort by customer ID"},
                    ),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # ========== SHIPMENT ACTIONS ==========

        # Create a Shipment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/shipments/create",
            "action": "create-shipment",
            "groups": "Shipments",
            "display_name": "Create a Shipment",
            "short_desc": "Create a new shipment for an order",
            "desc": "Create a new shipment for an order in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceCreateShipmentRequestDataType::Fields),
            "output_type": new BigCommerceShipmentDataType(),
        });

        # Get a Shipment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/shipments/get",
            "action": "get-shipment",
            "groups": "Shipments",
            "display_name": "Get a Shipment",
            "short_desc": "Get a single shipment by ID",
            "desc": "Retrieve a single shipment by order ID and shipment ID from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceGetShipmentRequestDataType::Fields),
            "output_type": new BigCommerceShipmentDataType(),
        });

        # Update a Shipment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/shipments/update",
            "action": "update-shipment",
            "groups": "Shipments",
            "display_name": "Update a Shipment",
            "short_desc": "Update an existing shipment",
            "desc": "Update an existing shipment in BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceUpdateShipmentRequestDataType::Fields),
            "output_type": new BigCommerceShipmentDataType(),
        });

        # Delete a Shipment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/shipments/delete",
            "action": "delete-shipment",
            "groups": "Shipments",
            "display_name": "Delete a Shipment",
            "short_desc": "Delete a shipment",
            "desc": "Delete a shipment from BigCommerce",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigCommerceDeleteShipmentRequestDataType::Fields),
            "output_type": new BigCommerceDeleteResponseDataType(),
        });

        # Search Shipments
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/shipments",
            "action": "search-shipments",
            "groups": "Shipments",
            "display_name": "Search Shipments",
            "short_desc": "Search for shipments by order",
            "desc": "List shipments for a specific order in BigCommerce",
            "action_code": DPAT_FIND,
            "options": {
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "Order to list shipments for",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "orders",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # ========== EXECUTE API CALL ==========

        # API Request
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/execute-api-call",
            "action": "execute-api-call",
            "groups": "Other",
            "display_name": "Make an API Call",
            "short_desc": "Make a custom API call",
            "desc": "Make a custom API call to the BigCommerce API",
            "action_code": DPAT_API,
            "options": {
                "method": <ActionOptionInfo>{
                    "display_name": "HTTP Method",
                    "short_desc": "The HTTP method",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The HTTP method to use",
                    "example_value": "GET",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "GET", "desc": "Retrieve data"},
                        <AllowedValueInfo>{"value": "POST", "desc": "Create data"},
                        <AllowedValueInfo>{"value": "PUT", "desc": "Update data"},
                        <AllowedValueInfo>{"value": "DELETE", "desc": "Delete data"},
                    ),
                },
                "path": <ActionOptionInfo>{
                    "display_name": "API Path",
                    "short_desc": "The API path",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The API path relative to the store URL "
                        "(e.g., `v3/catalog/products` or `v2/orders`)",
                    "example_value": "v3/catalog/summary",
                },
                "body": <ActionOptionInfo>{
                    "display_name": "Request Body",
                    "short_desc": "Request body (JSON)",
                    "type": AbstractDataProviderTypeMap."*hash",
                    "desc": "Request body for POST/PUT requests",
                },
            },
            "output_type": AbstractDataProviderTypeMap."hash",
        });

        # ========== TRIGGERS ==========

        # Watch Abandoned Cart
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_CART_ABANDONED,
            "action": EVENT_CART_ABANDONED,
            "groups": "Triggers",
            "display_name": "Watch Abandoned Cart",
            "short_desc": "Trigger when a cart is abandoned",
            "desc": "Fires when a cart is abandoned. "
                "Uses polling to detect incomplete orders (status Incomplete).",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CART_ABANDONED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch New Cart
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_CART_CREATED,
            "action": EVENT_CART_CREATED,
            "groups": "Triggers",
            "display_name": "Watch New Cart",
            "short_desc": "Trigger when a new cart is created",
            "desc": "Fires when a new cart is created. "
                "Uses polling to detect new incomplete orders.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CART_CREATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch New Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_CUSTOMER_CREATED,
            "action": EVENT_CUSTOMER_CREATED,
            "groups": "Triggers",
            "display_name": "Watch New Customer",
            "short_desc": "Trigger when a new customer is created",
            "desc": "Fires when a new customer is created in BigCommerce. "
                "Uses polling to detect new records.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CUSTOMER_CREATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch New Customer Address
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_CUSTOMER_ADDRESS_CREATED,
            "action": EVENT_CUSTOMER_ADDRESS_CREATED,
            "groups": "Triggers",
            "display_name": "Watch New Customer Address",
            "short_desc": "Trigger when a new customer address is created",
            "desc": "Fires when a new customer address is created in BigCommerce. "
                "Uses polling to detect new records.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CUSTOMER_ADDRESS_CREATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch New Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_ORDER_CREATED,
            "action": EVENT_ORDER_CREATED,
            "groups": "Triggers",
            "display_name": "Watch New Order",
            "short_desc": "Trigger when a new order is created",
            "desc": "Fires when a new order is created from the storefront. "
                "Uses polling to detect new records (V2 Orders API).",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_ORDER_CREATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch New Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_PRODUCT_CREATED,
            "action": EVENT_PRODUCT_CREATED,
            "groups": "Triggers",
            "display_name": "Watch New Product",
            "short_desc": "Trigger when a new product is created",
            "desc": "Fires when a new product is created in BigCommerce. "
                "Uses polling to detect new records.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_PRODUCT_CREATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch New Shipment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_SHIPMENT_CREATED,
            "action": EVENT_SHIPMENT_CREATED,
            "groups": "Triggers",
            "display_name": "Watch New Shipment",
            "short_desc": "Trigger when a new shipment is created",
            "desc": "Fires when a new shipment is created in BigCommerce. "
                "Uses polling to detect new records (V2 Orders API).",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SHIPMENT_CREATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch Updated Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_CUSTOMER_UPDATED,
            "action": EVENT_CUSTOMER_UPDATED,
            "groups": "Triggers",
            "display_name": "Watch Updated Customer",
            "short_desc": "Trigger when a customer is updated",
            "desc": "Fires when a customer is updated in BigCommerce. "
                "Uses polling to detect changes.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CUSTOMER_UPDATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch Updated Customer Address
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_CUSTOMER_ADDRESS_UPDATED,
            "action": EVENT_CUSTOMER_ADDRESS_UPDATED,
            "groups": "Triggers",
            "display_name": "Watch Updated Customer Address",
            "short_desc": "Trigger when a customer address is updated",
            "desc": "Fires when a customer address is updated in BigCommerce. "
                "Uses polling to detect changes.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CUSTOMER_ADDRESS_UPDATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # Watch Updated Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigCommerceDataProvider::AppName,
            "path": "/events/" + EVENT_ORDER_UPDATED,
            "action": EVENT_ORDER_UPDATED,
            "groups": "Triggers",
            "display_name": "Watch Updated Order",
            "short_desc": "Trigger when an order is updated",
            "desc": "Fires when an order is updated in BigCommerce. "
                "Uses polling to detect changes (V2 Orders API).",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_ORDER_UPDATED,
            "options": {
                "poll_interval": <ActionOptionInfo>{
