# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) DeelRestClient

module DeelDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Deel global workforce management";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new DeelDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": DeelDataProvider::AppName,
            "display_name": "Deel",
            "short_desc": "Deel global workforce management platform",
            "desc": "Deel is a global workforce management and HR platform for hiring, managing, "
                "and paying contractors and full-time employees worldwide.\n\n"
                "This integration supports contracts, timesheets, invoice adjustments, workers, "
                "time-off requests, legal entities, invoices, and polling-based event triggers.",
            "scheme": "deel",
            "logo": DeelDataProvider::DeelLogo,
            "logo_file_name": "deel-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Hr,),
        });

        # ========== CONTRACT ACTIONS ==========

        # Create a Contract
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/contracts/create",
            "action": "create-contract",
            "groups": "Contracts",
            "display_name": "Create a Contract",
            "short_desc": "Create a new contract in Deel",
            "desc": "Create a new contractor or employee contract in Deel",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelContractDataType(); },
            "options": {
                "type": <ActionOptionInfo>{
                    "display_name": "Contract Type",
                    "short_desc": "The type of contract",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The type of contract to create",
                    "example_value": "fixed",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "pay_as_you_go_time_based",
                            "desc": "Pay-as-you-go time-based contract"},
                        <AllowedValueInfo>{"value": "fixed", "desc": "Fixed-rate contract"},
                        <AllowedValueInfo>{"value": "milestone",
                            "desc": "Milestone-based contract"},
                        <AllowedValueInfo>{"value": "employee", "desc": "Employee contract"},
                    ),
                },
                "title": <ActionOptionInfo>{
                    "display_name": "Title",
                    "short_desc": "The contract title",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "A descriptive title for the contract",
                    "example_value": "Software Engineer - Backend",
                },
                "worker_email": <ActionOptionInfo>{
                    "display_name": "Worker Email",
                    "short_desc": "The worker's email address",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The email address of the contractor or employee",
                    "example_value": "worker@example.com",
                },
                "start_date": <ActionOptionInfo>{
                    "display_name": "Start Date",
                    "short_desc": "The contract start date",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The date the contract starts (YYYY-MM-DD format)",
                    "example_value": "2026-03-01",
                },
                "currency": <ActionOptionInfo>{
                    "display_name": "Currency",
                    "short_desc": "The contract currency",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The ISO 4217 currency code for payments (e.g., `USD`, `EUR`)",
                    "example_value": "USD",
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "The contract amount",
                    "type": AbstractDataProviderTypeMap."*number",
                    "desc": "The monetary amount for the contract (rate or fixed amount)",
                    "example_value": 5000.00,
                },
                "payment_cycle": <ActionOptionInfo>{
                    "display_name": "Payment Cycle",
                    "short_desc": "How often payments are made",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The payment cycle for this contract",
                    "example_value": "monthly",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "monthly", "desc": "Monthly payments"},
                        <AllowedValueInfo>{"value": "weekly", "desc": "Weekly payments"},
                        <AllowedValueInfo>{"value": "biweekly",
                            "desc": "Biweekly (every two weeks) payments"},
                    ),
                },
                "scope_of_work": <ActionOptionInfo>{
                    "display_name": "Scope of Work",
                    "short_desc": "Description of the work",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "A description of the work to be performed under this contract",
                },
                "country": <ActionOptionInfo>{
                    "display_name": "Country",
                    "short_desc": "The worker's country",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The ISO 3166-1 alpha-2 country code for the worker's location",
                    "example_value": "US",
                },
                "job_title": <ActionOptionInfo>{
                    "display_name": "Job Title",
                    "short_desc": "The worker's job title",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The job title of the contractor or employee",
                    "example_value": "Software Engineer",
                },
                "end_date": <ActionOptionInfo>{
                    "display_name": "End Date",
                    "short_desc": "The contract end date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The date the contract ends (YYYY-MM-DD format), if applicable",
                },
            },
        });

        # Terminate a Contract
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/contracts/terminate",
            "action": "terminate-contract",
            "groups": "Contracts",
            "display_name": "Terminate a Contract",
            "short_desc": "Terminate an existing contract",
            "desc": "Terminate an existing contractor or employee contract in Deel",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelContractDataType(); },
            "options": {
                "contract_id": <ActionOptionInfo>{
                    "display_name": "Contract ID",
                    "ref_data": "contracts",
                    "short_desc": "The contract to terminate",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the contract to terminate",
                },
                "termination_reason": <ActionOptionInfo>{
                    "display_name": "Termination Reason",
                    "short_desc": "The reason for termination",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The reason for terminating the contract",
                    "example_value": "Project completed",
                },
                "last_day_of_work": <ActionOptionInfo>{
                    "display_name": "Last Day of Work",
                    "short_desc": "The worker's last working day",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The last day the worker will be active (YYYY-MM-DD format)",
                    "example_value": "2026-03-31",
                },
            },
        });

        # Sign a Contract
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/contracts/sign",
            "action": "sign-contract",
            "groups": "Contracts",
            "display_name": "Sign a Contract",
            "short_desc": "Sign a contract in Deel",
            "desc": "Sign a contract in Deel on behalf of the organization",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelContractDataType(); },
            "options": {
                "contract_id": <ActionOptionInfo>{
                    "display_name": "Contract ID",
                    "ref_data": "contracts",
                    "short_desc": "The contract to sign",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the contract to sign",
                },
            },
        });

        # Search Contracts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/contracts",
            "action": "search-contracts",
            "groups": "Contracts",
            "display_name": "Search Contracts",
            "short_desc": "Search for contracts in Deel",
            "desc": "List and search contracts in Deel with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "contract_id": <ActionOptionInfo>{
                    "display_name": "Contract ID",
                    "ref_data": "contracts",
                    "short_desc": "Filter by contract ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Get a specific contract by its ID",
                    "preselected": True,
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by contract status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter contracts by status",
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "pending", "desc": "Pending contracts"},
                        <AllowedValueInfo>{"value": "active", "desc": "Active contracts"},
                        <AllowedValueInfo>{"value": "ended", "desc": "Ended contracts"},
                        <AllowedValueInfo>{"value": "terminated",
                            "desc": "Terminated contracts"},
                    ),
                },
                "contract_type": <ActionOptionInfo>{
                    "display_name": "Contract Type",
                    "short_desc": "Filter by contract type",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter contracts by type",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "pay_as_you_go_time_based",
                            "desc": "Pay-as-you-go time-based contracts"},
                        <AllowedValueInfo>{"value": "fixed", "desc": "Fixed-rate contracts"},
                        <AllowedValueInfo>{"value": "milestone",
                            "desc": "Milestone-based contracts"},
                        <AllowedValueInfo>{"value": "employee",
                            "desc": "Employee contracts"},
                    ),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                    "preselected": True,
                },
                "offset": <ActionOptionInfo>{
                    "display_name": "Offset",
                    "short_desc": "Results offset",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Number of results to skip (for manual pagination)",
                },
            },
        });

        # Get a Contract
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/contracts",
            "action": "get-contract",
            "groups": "Contracts",
            "display_name": "Get a Contract",
            "short_desc": "Get a single contract by ID",
            "desc": "Retrieve a single contract by ID from Deel",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "contract_id": <ActionOptionInfo>{
                    "display_name": "Contract ID",
                    "ref_data": "contracts",
                    "short_desc": "The contract ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the contract",
                },
            },
        });

        # Update a Contract
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/contracts/update",
            "action": "update-contract",
            "groups": "Contracts",
            "display_name": "Update a Contract",
            "short_desc": "Update an existing contract",
            "desc": "Update the details of an existing contract in Deel",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelContractDataType(); },
            "options": {
                "contract_id": <ActionOptionInfo>{
                    "display_name": "Contract ID",
                    "ref_data": "contracts",
                    "short_desc": "The contract to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the contract to update",
                },
                "title": <ActionOptionInfo>{
                    "display_name": "Title",
                    "short_desc": "Updated contract title",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "A new descriptive title for the contract",
                    "example_value": "Senior Software Engineer",
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "Updated contract amount",
                    "type": AbstractDataProviderTypeMap."*number",
                    "desc": "The updated monetary amount for the contract",
                    "example_value": 6000.00,
                },
                "scope_of_work": <ActionOptionInfo>{
                    "display_name": "Scope of Work",
                    "short_desc": "Updated scope of work",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Updated description of the work to be performed",
                },
                "job_title": <ActionOptionInfo>{
                    "display_name": "Job Title",
                    "short_desc": "Updated job title",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The updated job title for the contract",
                    "example_value": "Senior Software Engineer",
                },
            },
        });

        # ========== TIMESHEET ACTIONS ==========

        # Submit a Timesheet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/timesheets/submit",
            "action": "submit-timesheet",
            "groups": "Timesheets",
            "display_name": "Submit a Timesheet",
            "short_desc": "Submit a timesheet entry in Deel",
            "desc": "Submit a new timesheet entry for a contract in Deel",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelTimesheetDataType(); },
            "options": {
                "contract_id": <ActionOptionInfo>{
                    "display_name": "Contract ID",
                    "ref_data": "contracts",
                    "short_desc": "The associated contract",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the contract this timesheet belongs to",
                },
                "date_submitted": <ActionOptionInfo>{
                    "display_name": "Date Submitted",
                    "short_desc": "The timesheet date",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The date for this timesheet entry (YYYY-MM-DD format)",
                    "example_value": "2026-02-24",
                },
                "quantity": <ActionOptionInfo>{
                    "display_name": "Hours (Quantity)",
                    "short_desc": "The number of hours worked",
                    "type": AbstractDataProviderTypeMap."number",
                    "required": True,
                    "desc": "The number of hours worked for this timesheet entry",
                    "example_value": 8.0,
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "Work description",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "A description of the work performed",
                    "example_value": "Developed new API endpoints",
                },
            },
        });

        # Update a Timesheet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/timesheets/update",
            "action": "update-timesheet",
            "groups": "Timesheets",
            "display_name": "Update a Timesheet",
            "short_desc": "Update an existing timesheet entry",
            "desc": "Update an existing timesheet entry in Deel",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelTimesheetDataType(); },
            "options": {
                "timesheet_id": <ActionOptionInfo>{
                    "display_name": "Timesheet ID",
                    "ref_data": "timesheets",
                    "short_desc": "The timesheet to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the timesheet entry to update",
                },
                "quantity": <ActionOptionInfo>{
                    "display_name": "Hours (Quantity)",
                    "short_desc": "The updated number of hours",
                    "type": AbstractDataProviderTypeMap."*number",
                    "desc": "The new number of hours worked",
                    "example_value": 8.0,
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "Updated work description",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The updated description of the work performed",
                },
            },
        });

        # Approve a Timesheet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/timesheets/approve",
            "action": "approve-timesheet",
            "groups": "Timesheets",
            "display_name": "Approve a Timesheet",
            "short_desc": "Approve a timesheet entry",
            "desc": "Approve a timesheet entry in Deel",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelTimesheetDataType(); },
            "options": {
                "timesheet_id": <ActionOptionInfo>{
                    "display_name": "Timesheet ID",
                    "ref_data": "timesheets",
                    "short_desc": "The timesheet to approve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the timesheet entry to approve",
                },
            },
        });

        # Reject a Timesheet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/timesheets/reject",
            "action": "reject-timesheet",
            "groups": "Timesheets",
            "display_name": "Reject a Timesheet",
            "short_desc": "Reject a timesheet entry",
            "desc": "Reject a timesheet entry in Deel with an optional rejection reason",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelTimesheetDataType(); },
            "options": {
                "timesheet_id": <ActionOptionInfo>{
                    "display_name": "Timesheet ID",
                    "ref_data": "timesheets",
                    "short_desc": "The timesheet to reject",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the timesheet entry to reject",
                },
                "rejection_reason": <ActionOptionInfo>{
                    "display_name": "Rejection Reason",
                    "short_desc": "The reason for rejection",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "An explanation for why the timesheet entry was rejected",
                    "example_value": "Incorrect hours reported",
                },
            },
        });

        # Search Timesheets
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/timesheets",
            "action": "search-timesheets",
            "groups": "Timesheets",
            "display_name": "Search Timesheets",
            "short_desc": "Search for timesheets in Deel",
            "desc": "List and search timesheet entries in Deel with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "timesheet_id": <ActionOptionInfo>{
                    "display_name": "Timesheet ID",
                    "ref_data": "timesheets",
                    "short_desc": "Filter by timesheet ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Get a specific timesheet by its ID",
                },
                "contract_id": <ActionOptionInfo>{
                    "display_name": "Contract ID",
                    "ref_data": "contracts",
                    "short_desc": "Filter by contract",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter timesheets by associated contract ID",
                    "preselected": True,
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by timesheet status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter timesheets by status",
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "pending", "desc": "Pending timesheets"},
                        <AllowedValueInfo>{"value": "approved",
                            "desc": "Approved timesheets"},
                        <AllowedValueInfo>{"value": "rejected",
                            "desc": "Rejected timesheets"},
                    ),
                },
                "date_from": <ActionOptionInfo>{
                    "display_name": "Date From",
                    "short_desc": "Start of date range",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter timesheets from this date (YYYY-MM-DD format)",
                },
                "date_to": <ActionOptionInfo>{
                    "display_name": "Date To",
                    "short_desc": "End of date range",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter timesheets up to this date (YYYY-MM-DD format)",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                    "preselected": True,
                },
                "offset": <ActionOptionInfo>{
                    "display_name": "Offset",
                    "short_desc": "Results offset",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Number of results to skip (for manual pagination)",
                },
            },
        });

        # Get a Timesheet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/timesheets",
            "action": "get-timesheet",
            "groups": "Timesheets",
            "display_name": "Get a Timesheet",
            "short_desc": "Get a single timesheet by ID",
            "desc": "Retrieve a single timesheet entry by ID from Deel",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "timesheet_id": <ActionOptionInfo>{
                    "display_name": "Timesheet ID",
                    "ref_data": "timesheets",
                    "short_desc": "The timesheet ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the timesheet entry",
                },
            },
        });

        # Delete a Timesheet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/timesheets/delete",
            "action": "delete-timesheet",
            "groups": "Timesheets",
            "display_name": "Delete a Timesheet",
            "short_desc": "Delete a timesheet entry",
            "desc": "Delete a timesheet entry in Deel",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelDeletedResponseDataType(); },
            "options": {
                "timesheet_id": <ActionOptionInfo>{
                    "display_name": "Timesheet ID",
                    "ref_data": "timesheets",
                    "short_desc": "The timesheet to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the timesheet entry to delete",
                },
            },
        });

        # ========== INVOICE ADJUSTMENT ACTIONS ==========

        # Create an Invoice Adjustment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeelDataProvider::AppName,
            "path": "/adjustments/create",
            "action": "create-invoice-adjustment",
            "groups": "Invoice Adjustments",
            "display_name": "Create an Invoice Adjustment",
            "short_desc": "Create a new invoice adjustment",
            "desc": "Create a new invoice adjustment (bonus, reimbursement, or deduction) in Deel",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () { return new DeelAdjustmentDataType(); },
            "options": {
                "contract_id": <ActionOptionInfo>{
                    "display_name": "Contract ID",
                    "ref_data": "contracts",
                    "short_desc": "The associated contract",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The unique identifier of the contract this adjustment belongs to",
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "The adjustment amount",
                    "type": AbstractDataProviderTypeMap."number",
                    "required": True,
                    "desc": "The monetary amount for this invoice adjustment",
                    "example_value": 500.00,
                },
                "currency": <ActionOptionInfo>{
                    "display_name": "Currency",
                    "short_desc": "The adjustment currency",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The ISO 4217 currency code (e.g., `USD`, `EUR`)",
                    "example_value": "USD",
                },
                "date_submitted": <ActionOptionInfo>{
                    "display_name": "Date Submitted",
                    "short_desc": "The adjustment date",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The date for this adjustment entry (YYYY-MM-DD format)",
                    "example_value": "2026-03-01",
                },
                "type": <ActionOptionInfo>{
                    "display_name": "Adjustment Type",
                    "short_desc": "The type of adjustment",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The type of invoice adjustment",
                    "example_value": "bonus",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "bonus", "desc": "Bonus payment"},
                        <AllowedValueInfo>{"value": "reimbursement",
                            "desc": "Expense reimbursement"},
