%requires qore >= 2.0
%modern

%requires(reexport) RestClient
%requires(reexport) RestClientIo
%requires(reexport) FileLocationHandler

%requires json

module GcpAuth {
    version = "1.1";
    desc = "GCP service-account JWT-bearer and Application Default Credentials "
        "token broker for Vertex AI, GCP Vision, GCP Document AI, etc.; "
        "credential files are read as FileLocationHandler locations";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage GcpAuth Module

    @tableofcontents

    @section gcpauthintro Introduction to the GcpAuth Module

    The %GcpAuth module exchanges GCP service-account credentials for
    bearer access tokens. Service-account files, authorized-user ADC, and the Google metadata
    server are supported. External-account federation files and impersonated-service-account
    files are not supported; this module does not implement every Google SDK credential type.

    1. **Service-account JSON file** — sign an RS256 JWT with the SA private
       key, exchange at <tt>oauth2.googleapis.com/token</tt> using
       <tt>grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer</tt>.  See
       @ref GcpAuth::getAccessTokenFromServiceAccountFile() "getAccessTokenFromServiceAccountFile()".

    2. **Compute metadata server** — on GCE, GKE, Cloud Run, App Engine, and
       Cloud Functions, query
       <tt>http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token</tt>
       with the <tt>Metadata-Flavor: Google</tt> header.  See
       @ref GcpAuth::getAccessTokenFromMetadataServer() "getAccessTokenFromMetadataServer()".

    3. **User (authorized_user) credentials** — the file written by
       <tt>gcloud auth application-default login</tt> (JSON
       <tt>type: "authorized_user"</tt>) is exchanged via the OAuth2
       refresh-token grant (<tt>grant_type=refresh_token</tt>).  See
       @ref GcpAuth::getAccessTokenFromAuthorizedUserFile() "getAccessTokenFromAuthorizedUserFile()".

    4. **Composite ADC chain** — explicit credential file → \c GOOGLE_APPLICATION_CREDENTIALS
       env var → \c ~/.config/gcloud/application_default_credentials.json →
       metadata server, dispatching each resolved file to the service-account or
       authorized_user grant by its \c "type".  See
       @ref GcpAuth::getAccessToken() "getAccessToken()".

    All three functions cache tokens keyed by the request parameters and
    refresh within a 5-minute safety window before expiry.

    A selected invalid file fails authentication rather than falling through to another identity.
    @ref GcpAuth::getQuotaProject() "getQuotaProject()" resolves a separate quota project from an
    explicit override, \c GOOGLE_CLOUD_QUOTA_PROJECT, or the credential file's \c quota_project_id.
    Consumers send it as \c x-goog-user-project; the resource project remains independent.

    @par Dependencies

    JWT signing uses the \c json binary module's
    @ref Qore::Json::jwt_encode() "jwt_encode()" — RS256 is supported
    natively. The \c json module is required for credential and token parsing.

    @par Example: token for Vertex AI

    @code{.py}
%requires GcpAuth

string token = GcpAuth::getAccessTokenFromServiceAccountFile(
    "/etc/gcp/sa.json",
    ("https://www.googleapis.com/auth/cloud-platform",)
);
# pass as Authorization: Bearer <token>
    @endcode

    @section gcpauthrelnotes Release Notes

    @subsection gcpauth_v1_1 GcpAuth v1.1
    - added explicit credential resolution and independent quota-project resolution
    - validated supported credential types and token response fields without exposing secrets
    - bounded token requests, disabled redirects, and isolated metadata caches by endpoint
    - preserved cooperative cancellation while sanitizing authentication failures

    @subsection gcpauth_v1_0 GcpAuth v1.0
    - initial release: GCP credential broker that mints bearer access tokens via the
      Application Default Credentials chain, supporting:
      - service-account JSON keys (\c "service_account") via the OAuth2 JWT-bearer grant
      - user credentials (\c "authorized_user") written by
        \c "gcloud auth application-default login" via the OAuth2 refresh-token grant
      - the GCE/GKE/Cloud-Run metadata server / workload identity
    - tokens are cached and reused until within a safety window of expiry
    - explicit credential files are read as @ref filelocationhandlerintro
      "FileLocationHandler" locations, so a credential location may be a bare
      filesystem path or any registered scheme (\c file://, \c http(s)://,
      \c sftp://, ...)
*/

#! Contains all public definitions in the GcpAuth module
public namespace GcpAuth {
#! Default token endpoint
public const TokenUrl = "https://oauth2.googleapis.com/token";

#! Default GCE/GKE/Cloud-Run metadata server endpoint
public const MetadataEndpoint = "http://metadata.google.internal";

#! Path on the metadata server for the default service-account token
public const MetadataTokenPath =
    "/computeMetadata/v1/instance/service-accounts/default/token";

#! Safety window (ms) before expiry at which a cached token is considered stale
public const TokenSafetyWindowMs = 5 * 60 * 1000;

#! JWT-bearer grant type per RFC 7523
public const JwtBearerGrantType = "urn:ietf:params:oauth:grant-type:jwt-bearer";

#! Cached token entry
hashdecl GcpTokenCacheEntry {
    #! The bearer token value
    string access_token;
    #! Absolute date/time when the token expires
    date expires_at;
}

#! Cache of issued tokens keyed by request parameters
class TokenCache {
    public {
        static hash<string, hash<GcpTokenCacheEntry>> cache = {};
        static Mutex cache_lock();
    }

    static *string getCached(string key) {
        cache_lock.lock();
        on_exit cache_lock.unlock();
        *hash<GcpTokenCacheEntry> entry = cache{key};
        if (!entry) {
            return NOTHING;
        }
        date now = now_us();
        date threshold = now + milliseconds(TokenSafetyWindowMs);
        if (entry.expires_at <= threshold) {
            return NOTHING;
        }
        return entry.access_token;
    }

    static put(string key, string access_token, int expires_in_seconds) {
        cache_lock.lock();
        on_exit cache_lock.unlock();
        cache{key} = <GcpTokenCacheEntry>{
            "access_token": access_token,
            "expires_at": now_us() + seconds(expires_in_seconds),
        };
    }

    static invalidate(string key) {
        cache_lock.lock();
        on_exit cache_lock.unlock();
        remove cache{key};
    }

    static clear() {
        cache_lock.lock();
        on_exit cache_lock.unlock();
        cache = {};
    }
}

#! Fetches a GCP access token from a service-account JSON key file
/** Parses the SA JSON (extracts \c private_key, \c client_email,
    \c token_uri), builds a JWT (header \c {alg:RS256, typ:JWT, kid:...},
    claims \c {iss:client_email, scope:..., aud:token_uri, iat:now,
    exp:now+1h}), signs RS256 with the SA private key via the json module's
    @ref Qore::Json::jwt_encode() "jwt_encode()", and exchanges the
    assertion at the SA's \c token_uri (typically
    \c https://oauth2.googleapis.com/token) using
    \c grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer.

    Tokens are cached keyed by (sa_json_path, scopes-joined); a second call
    with the same parameters returns the cached token unless it is within
    @ref TokenSafetyWindowMs of expiry.

    @param sa_json_path filesystem path to the SA JSON key file
    @param scopes list of OAuth2 scopes (e.g.
        <tt>("https://www.googleapis.com/auth/cloud-platform",)</tt>)
    @param opts optional overrides:
        - \c lifetime_seconds (\c int): JWT lifetime (default 3600); GCP
          allows up to 3600 for service-account JWTs
        - \c force_refresh (\c bool): bypass the cache

    @return the bearer access token (without the \c "Bearer " prefix)

    @throw GCP-AUTH-ERROR SA file unreadable, JSON malformed, JWT signing or
        token exchange failed
*/
public string sub getAccessTokenFromServiceAccountFile(string sa_json_path,
        list<string> scopes, *hash<auto> opts) {
    string scope_str = (foldl $1 + " " + $2, scopes) ?? "";
    string key = sprintf("sa|%s|%s", sa_json_path, scope_str);
    if (!opts.force_refresh) {
        *string cached = TokenCache::getCached(key);
        if (cached) {
            return cached;
        }
    }
    hash<auto> sa = readCredentialFile(sa_json_path);
    foreach string field in (("private_key", "client_email")) {
        if (sa{field}.typeCode() != NT_STRING || !sa{field}.val()) {
            throw "GCP-AUTH-ERROR", sprintf("service-account credentials require a nonempty %s", field);
        }
    }
    if ((sa.hasKey("token_uri") && (sa.token_uri.typeCode() != NT_STRING || !sa.token_uri.val()))
            || (sa.hasKey("private_key_id") && sa.private_key_id.typeCode() != NT_STRING)) {
        throw "GCP-AUTH-ERROR", "service-account token_uri and private_key_id must be strings when supplied";
    }
    string token_uri = sa.token_uri ?? TokenUrl;
    int lifetime = opts.lifetime_seconds ?? 3600;
    if (lifetime <= 0 || lifetime > 3600) {
        throw "GCP-AUTH-ERROR", "service-account JWT lifetime must be between 1 and 3600 seconds";
    }
    date now = now_us();
    int iat = int(now - 1970-01-01Z);
    # JwtClaims only carries the seven registered claim names plus an
    # "extra" hash for custom claims that should appear at the JWT payload
    # top level; GCP requires "scope" as a top-level claim, so it goes here.
    hash<Qore::Json::JwtClaims> claims = cast<hash<Qore::Json::JwtClaims>>({
        "iss": sa.client_email,
        "aud": token_uri,
        "iat": iat,
        "exp": iat + lifetime,
        "extra": {"scope": scope_str},
    });
    hash<Qore::Json::JwtHeader> hdr = cast<hash<Qore::Json::JwtHeader>>({
        "alg": "RS256",
        "typ": "JWT",
    });
    if (sa.private_key_id.val()) {
        hdr.kid = sa.private_key_id;
    }
    string assertion;
    try {
        assertion = jwt_encode(claims, sa.private_key, "RS256", hdr);
    } catch (hash<ExceptionInfo> ex) {
        rethrowCancellation(ex);
        throw "GCP-AUTH-ERROR", "RS256 JWT signing failed for the configured service account";
    }
    hash<auto> form = {
        "grant_type": JwtBearerGrantType,
        "assertion": assertion,
    };
    hash<auto> resp;
    try {
        resp = postTokenForm(token_uri, form);
    } catch (hash<ExceptionInfo> ex) {
        rethrowCancellation(ex);
        throw "GCP-AUTH-ERROR", "service-account token exchange failed";
    }
    string token;
    int expires_in;
    (token, expires_in) = parseTokenResponse(resp.body);
    TokenCache::put(key, token, expires_in);
    return token;
}

#! Fetches a GCP access token from the compute metadata server
/** GCE, GKE, Cloud Run, App Engine, and Cloud Functions all expose this
    endpoint; the scope is determined at instance creation time and the
    \a scopes argument is informational (used as the cache key, not sent in
    the request).

    @param scopes the scopes the caller intends to use; informational only
    @param opts optional overrides:
        - \c metadata_endpoint (\c string): override
          \c http://metadata.google.internal (useful for tests with a fake
          IMDS server)
        - \c force_refresh (\c bool): bypass the cache

    @return the bearer access token

    @throw GCP-AUTH-ERROR metadata server unreachable or returned an error
*/
public string sub getAccessTokenFromMetadataServer(list<string> scopes,
        *hash<auto> opts) {
    string scope_str = (foldl $1 + " " + $2, scopes) ?? "";
    string endpoint = opts.metadata_endpoint ?? MetadataEndpoint;
    string key = sprintf("mds|%s|%s", endpoint, scope_str);
    if (!opts.force_refresh) {
        *string cached = TokenCache::getCached(key);
        if (cached) {
            return cached;
        }
    }
    RestClientIo::RestClientIo rest({"url": endpoint, "timeout": 30s, "connect_timeout": 10s,
        "max_redirects": 0});
    hash<auto> resp;
    try {
        resp = rest.restGet(MetadataTokenPath, {"Metadata-Flavor": "Google"});
    } catch (hash<ExceptionInfo> ex) {
        rethrowCancellation(ex);
        throw "GCP-AUTH-ERROR", "GCP metadata-server token fetch failed";
    }
    string token;
    int expires_in;
    (token, expires_in) = parseTokenResponse(resp.body);
    TokenCache::put(key, token, expires_in);
    return token;
}

#! Fetches a GCP access token via the standard ADC resolution chain
/** Walks the supported Application Default Credentials chain:

    1. explicit \a sa_json_path argument, if provided
    2. \c GOOGLE_APPLICATION_CREDENTIALS environment variable (read via
       \c getenv() so runtime mutations are honored)
    3. \c ~/.config/gcloud/application_default_credentials.json (user
       \c gcloud auth application-default login)
    4. compute metadata server (GCE, GKE, Cloud Run, Cloud Functions)

    File-based credentials are dispatched by their \c "type": an
    \c "authorized_user" file (the credential written by
    \c "gcloud auth application-default login") is exchanged via the OAuth2
    refresh-token grant (see
    @ref GcpAuth::getAccessTokenFromAuthorizedUserFile() "getAccessTokenFromAuthorizedUserFile()"),
    while a \c "service_account" file uses the JWT-bearer grant. External-account
    federation and impersonated-service-account files are not supported. An invalid
    selected file fails rather than falling through to a different identity.

    @param sa_json_path optional explicit SA JSON file path
    @param scopes OAuth2 scopes
    @param opts forwarded to the underlying fetcher (\c metadata_endpoint,
        \c force_refresh, \c lifetime_seconds, etc.)

    @return the bearer access token

    @throw GCP-AUTH-ERROR all candidate sources failed
*/
public string sub getAccessToken(*string sa_json_path, list<string> scopes,
        *hash<auto> opts) {
    *string candidate = resolveCredentialLocation(sa_json_path);
    if (candidate.val()) {
        string type = credentialFileType(candidate);
        if (type == "authorized_user") {
            return getAccessTokenFromAuthorizedUserFile(candidate, opts);
        }
        if (type == "service_account") {
            return getAccessTokenFromServiceAccountFile(candidate, scopes, opts);
        }
        throw "GCP-AUTH-ERROR", "unsupported ADC credential type; use service_account or authorized_user";
    }
    return getAccessTokenFromMetadataServer(scopes, opts);
}

#! Resolves the supported file-based ADC chain without acquiring a token
/** @param location explicit credential location, or NOTHING for ADC
    @return the selected credential location, or NOTHING for compute metadata credentials
*/
public *string sub resolveCredentialLocation(*string location) {
    *string candidate = location;
    if (!candidate.val()) {
        *string env_path = getenv("GOOGLE_APPLICATION_CREDENTIALS");
        if (env_path.val()) {
            candidate = env_path;
        }
    }
    if (!candidate.val()) {
        # standard gcloud ADC location
        *string user_home = getenv("HOME");
        if (user_home.val()) {
            string adc = user_home + "/.config/gcloud/application_default_credentials.json";
            if (is_file(adc)) {
                candidate = adc;
            }
        }
    }
    return candidate;
}

#! Resolves the quota project independently of the project owning a resource
/** @param location explicit credential location, or NOTHING for ADC
    @param project explicit quota project override
    @return the override, GOOGLE_CLOUD_QUOTA_PROJECT, or the selected credential's quota_project_id
    @throw GCP-AUTH-ERROR invalid quota project or unreadable selected credentials
    @note No resource project is inferred. The caller needs serviceusage.services.use on this project.
*/
public *string sub getQuotaProject(*string location, *string project) {
    *string value = project ?? getenv("GOOGLE_CLOUD_QUOTA_PROJECT");
    if (!exists value) {
        *string candidate = resolveCredentialLocation(location);
        if (candidate.val()) {
            hash<auto> credentials = readCredentialFile(candidate);
            auto configured = credentials.quota_project_id;
            if (credentials.hasKey("quota_project_id") && configured.typeCode() != NT_STRING) {
                throw "GCP-AUTH-ERROR", "quota project must be a project ID or number";
            }
            value = configured;
        }
    }
    if (exists value && value !~ /^[a-zA-Z0-9][a-zA-Z0-9._:-]*$/) {
        throw "GCP-AUTH-ERROR", "quota project must be a nonempty project ID or number";
    }
    return value;
}

#! Fetches a GCP access token from a user ("authorized_user") ADC credential file
/** Handles the credential written by \c "gcloud auth application-default login"
    (JSON \c type \c "authorized_user"): the stored \c refresh_token is exchanged
    at the token endpoint using \c grant_type=refresh_token together with the
    \c client_id and \c client_secret.  The resulting access token carries
    whatever scopes the refresh token was authorized for (typically
    \c cloud-platform), so no \c scope is sent in the request and the \a scopes
    used elsewhere in the ADC chain are not needed here.

    Tokens are cached keyed by the file path; a second call returns the cached
    token unless it is within @ref TokenSafetyWindowMs of expiry.

    @param path filesystem path to the \c authorized_user JSON file
    @param opts optional overrides:
        - \c force_refresh (\c bool): bypass the cache

    @return the bearer access token (without the \c "Bearer " prefix)

    @throw GCP-AUTH-ERROR file unreadable, JSON malformed, required fields
        missing, or the token refresh failed
*/
public string sub getAccessTokenFromAuthorizedUserFile(string path, *hash<auto> opts) {
    string key = sprintf("au|%s", path);
    if (!opts.force_refresh) {
        *string cached = TokenCache::getCached(key);
        if (cached) {
            return cached;
        }
    }
    hash<auto> cred = readCredentialFile(path);
    foreach string field in (("client_id", "client_secret", "refresh_token")) {
        if (cred{field}.typeCode() != NT_STRING || !cred{field}.val()) {
            throw "GCP-AUTH-ERROR", sprintf("authorized_user credentials require a nonempty %s", field);
        }
    }
    if (cred.hasKey("token_uri") && (cred.token_uri.typeCode() != NT_STRING || !cred.token_uri.val())) {
        throw "GCP-AUTH-ERROR", "authorized_user token_uri must be a nonempty string when supplied";
    }
    string token_uri = cred.token_uri ?? TokenUrl;
    hash<auto> form = {
        "grant_type": "refresh_token",
        "client_id": cred.client_id,
        "client_secret": cred.client_secret,
        "refresh_token": cred.refresh_token,
    };
    hash<auto> resp;
    try {
        resp = postTokenForm(token_uri, form);
    } catch (hash<ExceptionInfo> ex) {
        rethrowCancellation(ex);
        throw "GCP-AUTH-ERROR", "authorized_user token refresh failed";
    }
    string token;
    int expires_in;
    (token, expires_in) = parseTokenResponse(resp.body);
    TokenCache::put(key, token, expires_in);
    return token;
}

#! Reads and parses a GCP credential JSON file, throwing a clear error on failure
hash<auto> sub readCredentialFile(string location) {
    string text;
    try {
        # read the credential as a FileLocationHandler location: a bare path reads
        # a local file, or any registered scheme (file://, http(s)://, sftp://, ...)
        text = FileLocationHandler::getTextFileFromLocation(location);
    } catch (hash<ExceptionInfo> ex) {
        rethrowCancellation(ex);
        throw "GCP-AUTH-ERROR", "cannot read the configured GCP credential location";
    }
    try {
        auto value = parse_json(text);
        if (value.typeCode() != NT_HASH) {
            throw "GCP-AUTH-ERROR", "GCP credentials must be a JSON object";
        }
        return value;
    } catch (hash<ExceptionInfo> ex) {
        rethrowCancellation(ex);
        throw "GCP-AUTH-ERROR", "GCP credentials must be a valid JSON object";
    }
}

#! POSTs url-encoded form parameters to a GCP OAuth2 token endpoint at its exact path
/** RestClientIo treats an empty relative path as the root and appends a trailing
    slash, so posting to a \c token_uri such as
    \c https://oauth2.googleapis.com/token via \c restPost("") targets
    \c /token/ — which the Google token endpoint rejects with HTTP 404.  This
    helper splits the endpoint URL so the request hits the exact path.

    @param token_uri the full token endpoint URL
    @param form the form parameters to send url-encoded

    @return the @ref RestClientIo response hash
*/
hash<auto> sub postTokenForm(string token_uri, hash<auto> form) {
    hash<auto> url = parse_url(token_uri);
    if (!url.host.val() || url.username.val() || url.password.val() || token_uri =~ /[?#@\r\n\\]/
            || (url.protocol != "https"
                && !(url.protocol == "http" && inlist(url.host, ("localhost", "127.0.0.1", "::1"))))) {
        throw "GCP-AUTH-ERROR", "token endpoint must be HTTPS without embedded credentials";
    }
    string base = sprintf("%s://%s%s", url.protocol ?? "https", url.host,
        exists url.port ? sprintf(":%d", url.port) : "");
    string req_path = url.path ?? "/token";
    RestClientIo::RestClientIo rest({
        "url": base,
        "data": "url",
        "timeout": 30s,
        "connect_timeout": 10s,
        "max_redirects": 0,
    });
    return rest.restPost(req_path, form, {
        "Content-Type": "application/x-www-form-urlencoded",
    });
}

#! Returns a credential's type; legacy files without a type retain service-account handling
string sub credentialFileType(string path) {
    hash<auto> cred = readCredentialFile(path);
    if (cred.hasKey("type") && cred.type.typeCode() != NT_STRING) {
        throw "GCP-AUTH-ERROR", "credential type must be a string";
    }
    return cred.type ?? "service_account";
}

#! Preserves cooperative cancellation while sanitizing authentication diagnostics
sub rethrowCancellation(hash<ExceptionInfo> ex) {
    if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
        throw ex.err, ex.desc, ex.arg;
    }
}

#! Clears the entire token cache (for tests)
public sub clearTokenCache() {
    TokenCache::clear();
}

#! Parses a Google OAuth2 token response and returns (access_token, expires_in_seconds)
list<auto> sub parseTokenResponse(auto body) {
    hash<auto> data;
    if (body.typeCode() == NT_STRING || body.typeCode() == NT_BINARY) {
        try {
            data = parse_json(body.toString("UTF-8"));
        } catch (hash<ExceptionInfo> ex) {
            rethrowCancellation(ex);
            throw "GCP-AUTH-ERROR", "token response must be a valid JSON object";
        }
    } else if (body.typeCode() == NT_HASH) {
        data = body;
    } else {
        throw "GCP-AUTH-ERROR",
            sprintf("unexpected token response body type %s", body.type());
    }
    if (data.access_token.typeCode() != NT_STRING || data.access_token !~ /^[A-Za-z0-9._~+\/=-]+$/) {
        throw "GCP-AUTH-ERROR", "token response requires a nonempty bearer access_token";
    }
    string token = data.access_token;
    if (data.hasKey("token_type") && (data.token_type.typeCode() != NT_STRING
            || data.token_type.lwr() != "bearer")) {
        throw "GCP-AUTH-ERROR", "token response has an unsupported token_type";
    }
    if (data.hasKey("expires_in") && data.expires_in.typeCode() != NT_INT
            && !(data.expires_in.typeCode() == NT_STRING && data.expires_in =~ /^[0-9]+$/)) {
        throw "GCP-AUTH-ERROR", "token response expires_in must be a positive integer";
    }
    int expires_in = data.expires_in.typeCode() == NT_INT
        ? data.expires_in
        : (data.expires_in.typeCode() == NT_STRING ? int(data.expires_in) : 3600);
    if (expires_in <= 0) {
        throw "GCP-AUTH-ERROR", "token response expires_in must be positive";
    }
    return (token, expires_in);
}
}
