# minimum qore version
%requires qore >= 2.0

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) ConnectionProvider >= 1.4

module GoHighLevelRestClient {
    version = "1.0";
    desc = "User module for calling GoHighLevel REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("gohighlevelres",
            GoHighLevelRestConnection::ConnectionScheme);
    };
}

/** @mainpage GoHighLevelRestClient Module

    @tableofcontents

    @section gohighlevelrestclientintro GoHighLevelRestClient Introduction

    The %GoHighLevelRestClient module provides an API for calling GoHighLevel REST API services.

    To use this module, use \c "%requires GoHighLevelRestClient" in your code.

    All the public symbols in the module are defined in the GoHighLevelRestClient namespace.

    The main classes are:
    - @ref GoHighLevelRestClient::GoHighLevelRestClient "GoHighLevelRestClient":
      this class provides the REST client API for communication with the GoHighLevel API;
      it handles OAuth2 authentication
    - @ref GoHighLevelRestClient::GoHighLevelRestConnection "GoHighLevelRestConnection":
      provides a connection object to GoHighLevel services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires GoHighLevelRestClient

GoHighLevelRestClient ghl({
    "oauth2_client_id": ENV.GHL_CLIENT_ID,
    "oauth2_client_secret": ENV.GHL_CLIENT_SECRET,
    "oauth2_refresh_token": ENV.GHL_REFRESH_TOKEN,
    "location_id": ENV.GHL_LOCATION_ID,
});
hash<auto> result = ghl.get("calendars");
printf("Calendars: %y\n", result.body.calendars);
    @endcode

    @section gohighlevelrestclientrelnotes Release Notes

    @subsection gohighlevelrestclientv1_0 GoHighLevelRestClient v1.0
    - the initial version of the %GoHighLevelRestClient module
*/

#! the GoHighLevelRestClient namespace contains all the objects in the GoHighLevelRestClient module
public namespace GoHighLevelRestClient {

#! This class provides the REST client API for communication with GoHighLevel servers
/** GoHighLevel uses a REST API at https://services.leadconnectorhq.com with OAuth2 authentication.

    @par Authentication:
    - OAuth2 with Bearer tokens (Authorization Code Grant)
    - Access tokens expire after ~24 hours
    - Refresh tokens are single-use and valid for up to 1 year

    @par API Structure:
    All endpoints are at the base URL; a \c Version header is required on every request.

    @par Important:
    All API calls require a \c locationId parameter for location-scoped operations. This client
    automatically appends the \c locationId query parameter to all requests.
*/
public class GoHighLevelRestClient inherits RestClient::RestClient {
    public {
        #! Default GoHighLevel API URL
        const DefaultUrl = "https://services.leadconnectorhq.com";

        #! Default authorization request URL
        const DefaultAuthUrl = "https://marketplace.gohighlevel.com/oauth/chooselocation";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default token request URL
        const DefaultTokenUrl = "https://services.leadconnectorhq.com/oauth/token";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (no leading slash)
        const DefaultPingPath = "calendars";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
            "Version": "2021-07-28",
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
            "Version": "2021-07-28",
        };

        #! Default OAuth2 scopes
        const DefaultScopes = (
            "contacts.readonly", "contacts.write",
            "opportunities.readonly", "opportunities.write",
            "calendars.readonly", "calendars.write",
            "calendars/events.readonly", "calendars/events.write",
            "conversations.readonly", "conversations.write",
            "conversations/message.readonly", "conversations/message.write",
            "locations.readonly", "locations.write",
            "users.readonly",
            "campaigns.readonly",
        );

        #! Default OAuth2 auth args to request offline access (refresh tokens)
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "headers": DefaultHeaders,
            "oauth2_auth_args": DefaultAuthArgs,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "url": DefaultUrl,
        };

        #! OAuth2 options (added when OAuth2 credentials are provided)
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_scopes": DefaultScopes,
        };
    }

    private {
        #! The location ID - required for location-scoped API calls
        string location_id;
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
GoHighLevelRestClient ghl({
    "oauth2_client_id": "your-client-id",
    "oauth2_client_secret": "your-client-secret",
    "oauth2_refresh_token": "your-refresh-token",
    "location_id": "your-location-id",
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the GoHighLevel API key or access token for bearer token authentication
        - \c location_id: the GoHighLevel location/sub-account ID (required for most operations)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(GoHighLevelRestClient::getOptions(opts), do_not_connect) {
        # Store location_id for all future requests
        if (opts.location_id) {
            location_id = opts.location_id;
        }
        setAssumedEncoding("UTF-8");
    }

    #! Returns the location ID
    string getLocationId() {
        return location_id;
    }

    #! Sets the location ID
    setLocationId(string loc_id) {
        location_id = loc_id;
    }

    #! Overrides doRequest to automatically add locationId parameter
    /** The locationId is automatically appended to all API paths except for
        /oauth which is used for token management, and paths that already contain locationId.
    */
    hash<auto> doRequest(string method, string path, auto body,
            *reference<hash<auto>> info, softbool decode_errors = True, *hash<auto> hdr) {
        # Append locationId to all requests except /oauth (with or without leading slash)
        # Also skip if locationId is already in the path (to avoid duplicates)
        if (location_id && path !~ /^\/?oauth($|\?)/ && path !~ /locationId=/) {
            if (path !~ /\?/) {
                path += "?locationId=" + location_id;
            } else {
                path += "&locationId=" + location_id;
            }
        }
        return RestClient::doRequest(method, path, body, \info, decode_errors, hdr);
    }

    #! returns options for @ref GoHighLevelRestClient::GoHighLevelRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Check if token-only mode (apikey provided without OAuth2 credentials)
        bool token_only = opts.apikey && !opts.oauth2_client_id && !opts.oauth2_client_secret
            && !opts.oauth2_refresh_token;

        if (!token_only && opts.oauth2_client_id) {
            rv += OAuth2Options;
        } else if (opts.apikey) {
            # Bearer token mode
            rv.headers.Authorization = "Bearer " + opts.apikey;
        }

        # Remove custom options that RestClient doesn't understand
        remove rv.location_id;
        remove rv.apikey;

        return rv;
    }
}

#! Class for GoHighLevel REST connections; returns @ref GoHighLevelRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c location_id: the GoHighLevel location/sub-account ID

    @see @ref GoHighLevelRestClient::GoHighLevelRestClient::constructor() for more information on the above options
*/
public class GoHighLevelRestConnection inherits RestClient::RestConnection {
    public {
        #! Default connection URL
        const DefaultConnectionUrl = "gohighlevelres://services.leadconnectorhq.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "GoHighLevel REST Connection",
            "short_desc": "A connection to the GoHighLevel REST API",
            "desc": "A connection to the GoHighLevel REST API for CRM, contacts, opportunities, "
                "calendars, conversations, and marketing automation",
            "cls": Class::forName("GoHighLevelRestConnection"),
            "auto_url": True,
            "schemes": {
                "gohighlevelres": True,
            },
            "base_scheme_map": {
                "https": "gohighlevelres",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "GoHighLevel API key or access token",
                    "type": "string",
                    "desc": "The GoHighLevel API key or access token for bearer token authentication. "
                        "Use this for direct API access without OAuth2. If OAuth2 credentials are "
                        "also provided, this value is ignored.",
                    "sensitive": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultData,
                },
                "location_id": <ConnectionOptionInfo>{
                    "display_name": "Location ID",
                    "short_desc": "GoHighLevel location/sub-account ID",
                    "type": "string",
                    "desc": "The GoHighLevel location (sub-account) ID for scoping API requests. "
                        "This is provided during the OAuth2 authorization flow when the user "
                        "selects their location.",
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultPingPath,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultScopes,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": GoHighLevelRestClient::DefaultTokenUrl,
                },
            },
            "required_options": "location_id",
        };
    }

    #! creates the GoHighLevelRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = GoHighLevelRestClient::DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the GoHighLevelRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
    }

    #! returns \c "gohighlevelres"
    string getType() {
        return "gohighlevelres";
    }

    #! Returns connection options
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        # Always set OAuth2 URLs
        rv.oauth2_auth_url = GoHighLevelRestClient::DefaultAuthUrl;
        rv.oauth2_token_url = GoHighLevelRestClient::DefaultTokenUrl;
        if (!rv.oauth2_grant_type) {
            rv.oauth2_grant_type = GoHighLevelRestClient::DefaultGrantType;
        }
        if (!rv.oauth2_scopes) {
            rv.oauth2_scopes = GoHighLevelRestClient::DefaultScopes;
        }
        if (!rv.oauth2_auth_args) {
            rv.oauth2_auth_args = GoHighLevelRestClient::DefaultAuthArgs;
        }
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "GoHighLevel";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the GoHighLevelDataProvider and creates the data
        # provider object dynamically
        load_module("GoHighLevelDataProvider");
        return create_object("GoHighLevelDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != DefaultConnectionUrl) {
                update.url = DefaultConnectionUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref GoHighLevelRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref GoHighLevelRestClient object
    */
    private GoHighLevelRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new GoHighLevelRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
