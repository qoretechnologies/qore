# minimum qore version
%requires qore >= 3.0

# need mime definitions
%requires Mime >= 1.9

# assume local var scope, do not use "$" for vars, members, and method calls
%modern
# require type declarations everywhere
# disallows access to backwards-compatible "noop" variants
# enables all warnings

module MailMessage {
    version = "1.5.1";
    desc = "defines the MailMessage class and supporting definitions";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage MailMessage Module

    @section mailmessageintro MailMessage Module Introduction

    The %MailMessage module provides the MailMessage class for representing represents an email message.  This module
    is used by the @ref smtpclientintro "SmtpClient" and
    @ref pop3clientintro "Pop3Client" modules.

    To use this module, use \c "%requires MailMessage" in your code.  See the
    @ref smtpclientintro "SmtpClient" and
    @ref pop3clientintro "Pop3Client" modules for examples of Qore code using this module

    All the public symbols in the module are defined in the MailMessage namespace

    The main classes are:
    - @ref MailMessage::Message "Message": wraps an email message
    - @ref MailMessage::Attachment "Attachment": used for files attached to a @ref MailMessage::Message "Message"

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires MailMessage

MailMessage::Message msg("Me, Myself, and I <me@email.com>", "My Subject");
msg.setBody("hello world!");
msg.addTO("My Best Friend <you@friend.com>");
    @endcode

    @section mailmessage_relnotes MailMessage Release Notes

    @subsection mailmessage_v1_5_1 MailMessage 1.5.1
    - Added the @ref MailMessage::ContentEncoding "ContentEncoding" enum for content transfer encodings; the
      encoding constants @ref MailMessage::EncDefault "EncDefault", @ref MailMessage::EncNone "EncNone",
      @ref MailMessage::EncBase64 "EncBase64" and @ref MailMessage::EncQuotedPrintable "EncQuotedPrintable" are
      deprecated; use the enum instead
    - Added @ref MailMessage::Message::serializeRaw() "Message::serializeRaw()": serializes the message as it is
      stored or uploaded (for example with the IMAP \c APPEND command), with no \c "." added at the start of the
      lines that start with \c "."
    - Added @ref MailMessage::Message::encodeSmtpData() "Message::encodeSmtpData()": gives message text SMTP
      transparency for the SMTP \c DATA command
    - @ref MailMessage::Message::serialize() "Message::serialize()" in SMTP mode gives the message SMTP
      transparency: every CR or LF character that is not part of a CRLF line break is written as CRLF, since a
      server can take a bare CR or LF as a line ending, and a \c "." is added at the start of every line that starts
      with \c "."; before, only a line with a single \c "." was changed, so the server removed the first \c "." of
      the other lines that start with \c "."
    - A message parsed from raw message text now returns the sender's email address from
      @ref MailMessage::Message::getFrom() "Message::getFrom()" and the \c From header from
      @ref MailMessage::Message::getSender() "Message::getSender()", as a message created to be sent does; they were
      swapped, so the decoded \c From header, which can contain a line break, was used as the SMTP sender address
    - A header name with a NUL, CR or LF character raises \c HEADER-ERROR when the message is serialized, and so
      does such a header value when headers are not encoded; a header value with a CR or LF character is encoded,
      so that it cannot end the header line (it was written with a line break before, see Mime 1.9)
    - The headers given for an attachment are now added to its MIME part; they were dropped
    - @ref MailMessage::Message::getEmailAddress() "Message::getEmailAddress()" returns the address in angle brackets
      at the end of the string when there is one, so that text in a display name that looks like an address is not
      taken as the sender's or a recipient's address
    - A message parsed from raw message text can be serialized again, for example to forward it, and a message that
      is parsed, serialized and parsed again is the same message:
      - its body is written again with its content transfer encoding; serializing it failed with
        \c MIME-TRANSFER-ENCODING-ERROR (\c "default" is not a transfer encoding)
      - the MIME headers are generated again, and the \c MIME-Version, \c Content-Type and
        \c Content-Transfer-Encoding headers parsed with it are no longer written a second time (they are still
        returned by @ref MailMessage::Message::getHeaders() "Message::getHeaders()")
      - its alternative parts (\c multipart/alternative) are written again; they were dropped
      - the preamble and epilogue of a multipart message are no longer taken as its body or as a part, a part with no
        \c Content-Type is \c text/plain (it was \c "7bit"), and an attachment with the \c 7bit, \c 8bit or
        \c binary transfer encoding no longer makes the parse fail with \c UNKNOWN-ENCODING
      - a body that ends with a line break is no longer given an empty line every time the message is serialized
    - The \c Disposition-Notification-To header of a parsed message sets
      @ref MailMessage::Message::receiptDelivery() "Message::receiptDelivery()", as a message created to be sent does;
      the header name was compared in the wrong case, so it was never recognized.  The header is therefore no
      longer returned by @ref MailMessage::Message::getHeaders() "Message::getHeaders()" for a parsed message.
    - @ref MailMessage::Message::getInfo() "Message::getInfo()" of a parsed message returns the \c From header as
      \c from and the sender's email address as \c sender, as documented; they were swapped
    - A message is serialized in the character encoding of its body, so that a body written as it is keeps the bytes
      of the charset that its \c Content-Type declares; it was converted to UTF-8 with the headers.  A charset is
      added to the \c Content-Type of a body with non-ASCII characters if it has none.
    - @ref MailMessage::Message::getHeaderString() "Message::getHeaderString()" and
      @ref MailMessage::Message::serialize() "Message::serialize()" no longer change the message: a \c Content-Type
      header was removed or taken as the type of the body, and the body encoding of a message with attachments was
      changed from \c none to \c 7bit
    - Enhanced attachment handling:
      - Added RFC 2231 filename encoding for non-ASCII filenames
      - Added RFC 2231 filename decoding for incoming messages
      - Added @ref MailMessage::Part::getSize() "Part::getSize()": returns the size of the part data
      - Added @ref MailMessage::Part::getContentId() "Part::getContentId()": returns the Content-ID if set
      - Added @ref MailMessage::Attachment::isInline() "Attachment::isInline()": returns @ref True if the attachment
        is inline
      - Added @ref MailMessage::Message::attachInline() "Message::attachInline()": attaches an inline attachment with
        a Content-ID for use in HTML emails
    - Added \c content_id field to @ref MailMessage::PartInfo "PartInfo" hashdecl
    - Improved filename validation and sanitization
      (<a href="https://github.com/qoretechnologies/qore/issues/5164">issue 5164</a>)
    - Added multipart type detection and helper methods:
      - @ref MailMessage::Message::isMultipart() "Message::isMultipart()": returns @ref True if the message is multipart
      - @ref MailMessage::Message::getMultipartType() "Message::getMultipartType()": returns the multipart subtype
      - @ref MailMessage::Message::isSigned() "Message::isSigned()": returns @ref True if the message is signed
        (multipart/signed)
      - @ref MailMessage::Message::isEncrypted() "Message::isEncrypted()": returns @ref True if the message is encrypted
        (multipart/encrypted)
      - @ref MailMessage::Message::isDigest() "Message::isDigest()": returns @ref True if the message is a digest
        (multipart/digest)
    - Added new fields to @ref MailMessage::MailMessageInfo "MailMessageInfo" hashdecl:
      - \c is_multipart, \c multipart_type, \c is_signed, \c is_encrypted, \c is_digest
    - Now requires Mime module version 1.7 or later
      (<a href="https://github.com/qoretechnologies/qore/issues/5162">issue 5162</a>)
    - The \c From header of a message created to be sent has the sender's display name; it was dropped, and the
      header had the email address alone.  @ref MailMessage::Message::getSender() "Message::getSender()" returns the
      sender in display format, a display name with RFC 5322 specials is written as a quoted string, a non-ASCII
      display name is written as an RFC 2047 encoded word, and
      @ref MailMessage::Message::getFrom() "Message::getFrom()", the sender of the SMTP envelope, is still the email
      address alone (<a href="https://github.com/qoretechnologies/qore/issues/6019">issue 6019</a>)
    - Address handling and header encoding fixes
      (<a href="https://github.com/qoretechnologies/qore/issues/6066">issue 6066</a>):
      - only the display names and the other text of the \c To, \c CC and \c BCC headers are encoded (as RFC 2047
        \c "B" encoded words), never the addresses, also in a mailbox with a comment, a group or a name without
        angle brackets; a value with a non-ASCII display name was written as one \c "Q" encoded word with its
        address, which a mail client cannot read as an address; a list of mailboxes is folded so that its lines are
        at most 76 characters long
      - @ref MailMessage::Message::getEmailAddress() "Message::getEmailAddress()" returns the whole address with
        every RFC 5322 \c atext character (ex: <tt>J.O'B\@x.com</tt> was returned as <tt>B\@x.com</tt>), accepts
        quoted local parts and non-ASCII (internationalized) addresses, which were rejected, and returns an
        address in quotes, brackets or braces (as in CSV data); an encoded word, white space (including Unicode
        white space), format characters (ex: a byte order mark) and text before an address are never part of the
        address returned, and an address in a comment or before another address in a quoted string is not the
        address of a mailbox
      - the sender and recipient addresses of a parsed message are taken from the raw headers, so that an address
        in an encoded word is not taken as the sender's or a recipient's address, and the \c From, \c To, \c CC
        and \c BCC headers of a parsed message are written again as they were parsed, or with only their text
        encoded if they have raw non-ASCII text; they were written decoded and encoded again as a whole; a header is
        always written with the address that its value gives, so that a parsed message is sent to the same address
      - every address of a \c To, \c CC or \c BCC entry with several addresses is a recipient
        (@ref MailMessage::Message::getRecipients() "Message::getRecipients()"), so that the message is sent to all of
        them: the entry is split as a list of mailboxes and its groups are expanded (see the new
        @ref MailMessage::Message::getEmailAddresses() "Message::getEmailAddresses()"), and duplicate recipients are
        removed; only the first address of an entry was a recipient
        (<a href="https://github.com/qoretechnologies/qore/issues/6134">issue 6134</a>).  The value given to
        @ref MailMessage::Message::addTO() "Message::addTO()", @ref MailMessage::Message::addCC() "addCC()" and
        @ref MailMessage::Message::addBCC() "addBCC()" is therefore parsed as a list of addresses: a display name from
        an untrusted source must be quoted, or given with the new
        @ref MailMessage::Message::addTO(string, string) "addTO(string, string)",
        @ref MailMessage::Message::addCC(string, string) "addCC(string, string)" and
        @ref MailMessage::Message::addBCC(string, string) "addBCC(string, string)" variants, which quote it
      - text that looks like an RFC 2047 encoded word but has white space, a quote, a parenthesis, an angle bracket,
        a square bracket, a backslash, a comma or a semicolon is not an encoded word, so that it cannot change how
        the rest of an address header is read; the address of a sender header (\c From) is the same after a message
        is written and parsed again (<a href="https://github.com/qoretechnologies/qore/issues/6134">issue 6134</a>)
      - encoded words are folded with the line ending given to
        @ref MailMessage::Message::getHeaderString() "Message::getHeaderString()" (it was always CRLF), and a header
        value that is not encoded cannot contain any control character other than horizontal tab (only NUL, CR and LF
        were refused)

    @subsection mailmessage_v1_4 MailMessage 1.4
    - Added the @ref MailMessage::Message::getInfo() "MailMessage::getInfo()" method

    @subsection mailmessage_v1_3_3 MailMessage 1.3.3
    - various fixes from downstream to MailMessage data handling
      (<a href="https://github.com/qoretechnologies/qore/issues/4352">issue 4352</a>)

    @subsection mailmessage_v1_3_2 MailMessage 1.3.2
    - fixed message serialization for SMTP handling; default to base64 encoding for attachments and if the message
      body has a single \c "." character on a line; convert any single \c "." characters on a line to two \c ".."
      characters if using inly quoted printable encoding
      (issue <a href="https://github.com/qoretechnologies/qore/issues/3275">issue 3275</a>)

    @subsection mailmessage_v1_3_1 MailMessage 1.3.1
    - fixed @ref MailMessage::Message::addBody() "Message::addBody()" with no body present
      (issue <a href="https://github.com/qoretechnologies/qore/issues/2360">issue 2360</a>)

    @subsection mailmessage_v1_3 MailMessage 1.3
    - added support for complex types

    @subsection mailmessage_v1_2_1 MailMessage 1.2.1
    - fixed a bug using the default encoding in @ref MailMessage::Message::attach() "Message::attach()"
      (issue <a href="https://github.com/qoretechnologies/qore/issues/1352">issue 1352</a>)

    @subsection mailmessage_v1_2 MailMessage 1.2
    - converted to @ref new-style "%new-style"

    @subsection mailmessage_v1_1 MailMessage 1.1
    - added the @ref MailMessage::Message::serialize() "Message::serialize()" method

    @subsection mailmessage_v1_0_4 MailMessage 1.0.4
    - minor doc corrections and non-functional code changes

    @subsection mailmessage_v1_0_3 MailMessage 1.0.3
    - requires Mime module 1.3 for the MultiPartMessage::parseBody() method
    - fixed a bug where the part/attachment content-type was set to the content-type of the message
    - try to get the filename of attachments from the content-type header if not set in the content-disposition header
    - message parts that themselves have parts are now supported
    - fixed recognizing mime messages with additional text after the version number
      (ex: "Mime-Version: 1.0 (Mac OS X Mail 6.2 \(1499\))")

    @subsection mailmessage_v1_0_2 MailMessage 1.0.2
    - use \c "<string>::isDataPrintableAscii()" to determine which mail headers need encoding

    @subsection mailmessage_v1_0_1 MailMessage 1.0.1
    - fixed a bug encoding mail headers where mail headers requiring encoding were not encoded and those not requiring
      encoding were encoded with Q encoding

    @subsection mailmessage_v1_0 MailMessage 1.0
    - moved from the SmtpClient module to an independent module to also support the Pop3Client class
*/

#! the %MailMessage namespace holds all public definitions in the %MailMessage module
/** This includes:
    - Message: wraps an email message
    - Attachment: used to attach files to a Message
    - Part: used to represent alternate representations of the message body
*/
public namespace MailMessage {
#! Message part info
public hashdecl PartInfo {
    #! Part name
    string name;

    #! Part MIME type
    string mime;

    #! Part data
    data part_data;

    #! Part headers, if any
    *hash<auto> headers;

    #! Part transfer encoding
    string transfer_encoding;

    #! Content-ID for inline attachments (without angle brackets)
    *string content_id;

    #! Size of the part data in bytes
    int size;
}

#! Message info
public hashdecl MailMessageInfo {
    #! The sender in display format, as returned by @ref MailMessage::Message::getSender() "Message::getSender()"
    *string from;

    #! The sender's email address
    *string sender;

    #! The message subject
    *string subject;

    #! Any To: header entries, as returned by @ref MailMessage::Message::getTO() "Message::getTO()"; an entry can
    #! have several addresses: see @ref MailMessage::Message::getRecipients() "Message::getRecipients()"
    *list<string> to;

    #! Any CC: header entries, as returned by @ref MailMessage::Message::getCC() "Message::getCC()"; an entry can
    #! have several addresses: see @ref MailMessage::Message::getRecipients() "Message::getRecipients()"
    *list<string> cc;

    #! Any BCC: header entries, as returned by @ref MailMessage::Message::getBCC() "Message::getBCC()"; an entry can
    #! have several addresses: see @ref MailMessage::Message::getRecipients() "Message::getRecipients()"
    *list<string> bcc;

    #! The message body, if any
    *data body;

    #! The encoding used for the message body, if any
    *string body_encoding;

    #! The content type of the message body
    *string body_content_type;

    #! Any message headers
    *hash<auto> headers;

    #! The important flag
    *bool important;

    #! The delivery receipt flag
    *bool delivery_receipt;

    #! The read receipt flag
    *bool read_receipt;

    #! Any message attachments
    *list<hash<PartInfo>> attachments;

    #! Any message parts
    *list<hash<PartInfo>> parts;

    #! True if the message is a multipart message
    bool is_multipart = False;

    #! The multipart subtype (e.g., "mixed", "alternative", "signed", "encrypted", "digest")
    *string multipart_type;

    #! True if the message is digitally signed (multipart/signed)
    bool is_signed = False;

    #! True if the message is encrypted (multipart/encrypted)
    bool is_encrypted = False;

    #! True if the message is a digest (multipart/digest)
    bool is_digest = False;
}

/** @defgroup MessageEncodings Message Encodings
*/
#/@{
#! Content transfer encoding for email messages and attachments
/** @since MailMessage 1.5
*/
public enum ContentEncoding : string {
    #! Default encoding: uses @ref QuotedPrintable for text data, @ref Base64 for binary data
    Default = "default",
    #! No content transfer encoding (not recommended as SMTP servers break up long lines automatically)
    None = "none",
    #! Base64 content transfer encoding
    Base64 = "base64",
    #! Quoted-printable content transfer encoding
    QuotedPrintable = "quoted-printable",
}

#! a list of all known content encoding schemes encodings
public const Encodings = (
    ContentEncoding::Default,
    ContentEncoding::None,
    ContentEncoding::Base64,
    ContentEncoding::QuotedPrintable,
);

#! default content transfer encoding depending on attachment type
/** @deprecated Use @ref ContentEncoding::Default instead
*/
public const EncDefault = ContentEncoding::Default;

#! no content transfer encoding (not recommended as SMTP servers break up long lines automatically)
/** @deprecated Use @ref ContentEncoding::None instead
*/
public const EncNone = ContentEncoding::None;

#! base-64 content transfer encoding
/** @deprecated Use @ref ContentEncoding::Base64 instead
*/
public const EncBase64 = ContentEncoding::Base64;

#! "quoted-printable" content transfer encoding
/** @deprecated Use @ref ContentEncoding::QuotedPrintable instead
*/
public const EncQuotedPrintable = ContentEncoding::QuotedPrintable;
#/@}

#! Encodes a filename for use in MIME headers according to RFC 2231
/** @param filename the filename to encode
    @return the encoded filename; if the filename contains only ASCII characters that don't need encoding,
    returns the original filename; otherwise returns RFC 2231 encoded filename (utf-8''encoded-value)

    @par Example:
    @code{.py}
string encoded = encode_mime_filename("文档.pdf");
# Returns: utf-8''%E6%96%87%E6%A1%A3.pdf
    @endcode

    @see
    - <a href="https://tools.ietf.org/html/rfc2231">RFC 2231</a>
    - decode_mime_filename()

    @since MailMessage 1.5
*/
public string sub encode_mime_filename(string filename) {
    # Check if filename needs encoding (contains non-ASCII or special characters)
    if (filename.isDataPrintableAscii() && filename !~ /[\x00-\x1f\x7f*'%\\"]/) {
        return filename;
    }

    # RFC 2231 encoding: charset'language'encoded-value
    # We use UTF-8 and no language tag
    string encoded = "utf-8''";
    binary bin = binary(filename);
    for (int i = 0; i < bin.size(); i++) {
        int byte = bin[i];
        # Safe characters per RFC 2231: A-Z a-z 0-9 - _ .
        if ((byte >= 0x41 && byte <= 0x5a) ||   # A-Z
            (byte >= 0x61 && byte <= 0x7a) ||   # a-z
            (byte >= 0x30 && byte <= 0x39) ||   # 0-9
            byte == 0x2d ||                     # -
            byte == 0x5f ||                     # _
            byte == 0x2e) {                     # .
            encoded += chr(byte);
        } else {
            encoded += sprintf("%%%02X", byte);
        }
    }
    return encoded;
}

#! Decodes a MIME filename that may be RFC 2231 encoded
/** @param filename the filename to decode; may be a plain filename, RFC 2231 encoded (charset'lang'value),
    or RFC 2047 Q/B encoded (=?charset?Q?...?= or =?charset?B?...?=)
    @return the decoded filename

    @par Example:
    @code{.py}
string decoded = decode_mime_filename("utf-8''%E6%96%87%E6%A1%A3.pdf");
# Returns: 文档.pdf
    @endcode

    @see
    - <a href="https://tools.ietf.org/html/rfc2231">RFC 2231</a>
    - encode_mime_filename()

    @since MailMessage 1.5
*/
public string sub decode_mime_filename(string filename) {
    # Check for RFC 2231 encoding: charset'language'encoded-value
    *list<*string> match = (filename =~ x/^([^']+)'([^']*)'(.+)$/);
    if (match) {
        string charset = match[0] ?? "UTF-8";
        # match[1] is language tag, which we ignore
        string encoded = match[2] ?? "";

        # Decode percent-encoded bytes
        string decoded = "";
        for (int i = 0; i < encoded.length(); i++) {
            if (encoded[i] == "%" && i + 2 < encoded.length()) {
                string hex = encoded.substr(i + 1, 2);
                if (hex =~ /^[0-9A-Fa-f]{2}$/) {
                    decoded += chr(parse_hex_string(hex)[0]);
                    i += 2;
                    continue;
                }
            }
            decoded += encoded[i];
        }

        # Convert from the specified charset to UTF-8 if needed
        if (charset.upr() != "UTF-8" && charset.upr() != "UTF8") {
            try {
                # First get bytes as binary, then interpret with target charset
                decoded = force_encoding(decoded, charset);
                decoded = convert_encoding(decoded, "UTF-8");
            } catch () {
                # If conversion fails, return as-is
            }
        }
        return decoded;
    }

    # Check for RFC 2047 encoded word (Q or B encoding)
    if (filename =~ /^=\?/) {
        return mime_decode_header(filename);
    }

    return filename;
}

#! Sanitizes a filename to remove potentially dangerous characters
/** @param filename the filename to sanitize
    @return the sanitized filename with path separators and control characters removed

    @note This function removes:
    - Path separators (/ and \\)
    - Control characters (0x00-0x1f, 0x7f)
    - Leading/trailing whitespace
    - Leading dots (to prevent hidden files)

    @since MailMessage 1.5
*/
public string sub sanitize_filename(string filename) {
    # Remove control characters, path separators, and other unsafe characters
    # Using regex substitution to reliably handle UTF-8 multibyte characters
    string result = filename;

    # Remove control characters first (0x00-0x1f, 0x7f) before path separators
    # to avoid regex corruption issues with embedded null bytes
    result =~ s/[\x00-\x1f\x7f]//g;

    # Remove path separators
    result =~ s/[\/\\]//g;

    # Trim whitespace
    trim result;

    # Remove leading dots
    result =~ s/^\.+//;

    # If empty after sanitization, return a default name
    if (result.empty()) {
        result = "attachment";
    }
    return result;
}

#! The %Message class holds the information for a single email %Message
/** @par Example:
    @code{.py}
my MailMessage::Message msg("The Sender <sender@email.com>", "My Subject");
msg.setBody(body);
msg.addTO("My Best Friend <you@friend.com>");
@endcode

    Each message must have a body and at least one destination address before it can be sent.

    Set the body text with:
    - Message::setBody(): set/replace the message body
    - Message::addBody(): or add a line to the body with

    Add recipients with:
    - Message::addTO()
    - Message::addCC()
    - Message::addBCC()

    Each of the above methods takes email addresses like the sender address in Message::constructor()

    To get a text summary of the Message; try:
    - Message::toString(): returns a multi-line summary of the message for display purposes
    - Message::toLine(): returns a single line summary of the message for display purposes

    Additional header lines (eg: \c "X-SPAM-Status: No") can be added with addHeader(string) or
    set with setHeader()

    For example, to set the messageid:
    @code{.py}
m.addHeader("Message-ID: <20090712.123456789@mail.drei.at>");@endcode

    Other useful methods:
    - attach(): add attachments
    - important(): sets the given importance or returns the current setting (depending on the variant used)
    - receiptDelivery(): sets the delivery receipt or returns the current setting (depending on the variant used)
    - receiptRead(): sets the read receipt request or returns the setting (depending on the variant used)
*/
public class Message {
    #! @cond nodoc
    private {
        # the sender
        string from;
        # subject is a header field
        string subject;

        # additional headers
        hash headers;      # hash of additional headers except the ones below
        # message statuses
        bool importance = False;
        bool deliveryReceipt = False;
        bool readReceipt = False;

        # names
        list<string> to(); # list of names for to (header only) will be prefilled (and overwritten) with the recipients
        list<string> cc(); # list of cc's
        list<string> bcc(); # list of bcc's

        # the raw (undecoded) values of the To, CC and BCC headers of a parsed message, at the same positions as the
        # decoded values in to, cc and bcc; NOTHING for a recipient that was added with addTO(), addCC() or
        # addBCC(): the addresses are taken from the raw values, and a raw value is written again as it was parsed,
        # so that its encoded words and its list of mailboxes are kept (issue #6066)
        list<*string> to_raw();
        list<*string> cc_raw();
        list<*string> bcc_raw();

        # message data itself
        *data body;

        # message body content transfer encoding
        string bodyEncoding = ContentEncoding::Default;

        # message body content type
        *string bodyContentType;

        # list of Attachments
        list<Attachment> attachments();

        # list of Parts that are not Attachments (and not the main Message body - could be alternative representations of the body, for example)
        list<Part> parts();

        string sender;

        # the display name of the sender of a message created to be sent, if it has one; the From header is then
        # written with it (a parsed message has none, and its From header is written as it was parsed)
        *string sender_name;

        # the raw (undecoded) value of the From header of a parsed message
        *string from_raw;

        # SMTP mode: do not serialize a single "." alone on a line
        bool smtp_mode = True;

        # the MIME headers of a message, in lower case: they are generated from its body, parts and attachments, so
        # headers with these names given for the message or parsed with it are not written a second time
        const MimeHeaders = {
            "mime-version": True,
            "content-type": True,
            "content-transfer-encoding": True,
        };

        # multipart type tracking
        bool isMultipartMsg = False;
        *string multipartType;
        bool isSignedMsg = False;
        bool isEncryptedMsg = False;
        bool isDigestMsg = False;
    }
    #! @endcond

    public {
        #! create a different multipart boundary string every time based on the current time
        string mpboundary = replace(make_base64_string(string(now_us())), "=", "");
    }

    #! creates a Message object from the arguments given
    /** This variant of the constructor is designed to be used to create a Message object for sending with the
        \c SmtpClient class

        Use the Message::addTo() method to add message recipients

        @param sender the sender's email address; can be in the format \c "Full Display Name <name@example.com>",
        and the display name can be a quoted string (ex: <tt>"Doe, John" \<john@example.com\></tt>); the display name
        is written in the \c From header (see @ref getHeaderString()), and the email address alone is the sender of
        the SMTP envelope (see @ref getFrom())
        @param subject the subject line for the email; the subject will be encoded with
        <a href="http://tools.ietf.org/html/rfc2047">"Q" encoding</a>
        @param smtp_mode if True then a single "." will not be serialized alone on a line

        @throw MESSAGE-CONSTRUCTOR-ERROR the sender's email address is not valid; the subject is empty

        @since MailMessage 1.5.1 the display name of the sender is kept; it was dropped, and the \c From header had
        the email address alone
    */
    constructor(string sender, string subject, bool smtp_mode = True) {
        *string se = Message::getEmailAddress(sender);
        if (!exists se)
            throw "MESSAGE-CONSTRUCTOR-ERROR", sprintf("cannot get email address out of: %y", sender);

        # subject
        if (subject.empty())
            throw "MESSAGE-CONSTRUCTOR-ERROR", "subject must be not empty string";

        self.sender = se;   # used for sending
        # used for displaying: the display name with the address, if there is a name
        *string name = Message::getDisplayName(sender, se);
        if (name.val()) {
            sender_name = name;
            from = Message::formatMailbox(name, se);
        } else {
            from = se;
        }
        self.subject = subject;
        self.smtp_mode = smtp_mode;
    }

    #! creates a Message object from raw message text from a received email message
    /** The message can be serialized again (for example to forward it) with @ref serialize() or @ref serializeRaw():
        its body is written again with its content transfer encoding, its alternative parts (\c multipart/alternative)
        and attachments are written again, and the MIME headers are generated again instead of being written twice.

        The \c From, \c To, \c CC, \c BCC, \c Subject, importance and receipt headers are settings of the message
        (see @ref getSender(), @ref getTO(), @ref getSubject(), @ref important(), @ref receiptRead() and
        @ref receiptDelivery()); the other headers are returned by @ref getHeaders().

        @param msg the raw message text as received

        @throw MESSAGE-PARSE-ERROR invalid message data

        @since MailMessage 1.5.1 the message can be serialized again; the \c Disposition-Notification-To header sets
        @ref receiptDelivery() and is no longer returned by @ref getHeaders()
    */
    constructor(string msg) {
        int pos = 0;

        # is this a MIME message?
        bool mime = False;
        # content type
        string ct;
        # content transfer encoding - default: no encoding
        string cte = Mime::ContentTransEnc7Bit;

        # first get the message headers
        while (True) {
            string hdr = Message::getLine(\msg, \pos);
            if (hdr.empty())
                break;

            # see if it's a long header field as defined in RFC 2822 section 2.2.3: http://tools.ietf.org/html/rfc2822#section-2.2.3
            while (msg =~ /^[ \t]/)
                hdr += " " + trim(Message::getLine(\msg, \pos));

            hash h = parseHeader(hdr);
            string lk = h.firstKey().lwr();
            # the raw value of an address header: the addresses are taken from it, since a decoded encoded word
            # could look like an address (issue #6066), and it is written again as it was parsed
            *string raw;
            if (inlist(lk, ("from", "to", "cc", "bcc"))) {
                raw = parseHeader(hdr, False).firstValue();
            }
            if (lk == "mime-version")
                mime = True;
            else if (lk == "content-type")
                ct = h.firstValue();
            else if (lk == "content-transfer-encoding")
                cte = h.firstValue();
            else if (lk == "from") {
                # the From header in display format, and the sender's email address, as for a message created to be
                # sent (they were swapped, so getFrom() returned the decoded header value, which could contain a
                # line break, instead of the address used in the SMTP MAIL FROM command)
                from = h.firstValue();
                from_raw = raw;
                sender = Message::getEmailAddress(raw) ?? "";
                continue;
            } else if (lk == "to") {
                to += h.firstValue();
                to_raw += raw;
                continue;
            } else if (lk == "cc") {
                cc += h.firstValue();
                cc_raw += raw;
                continue;
            } else if (lk == "bcc") {
                bcc += h.firstValue();
                bcc_raw += raw;
                continue;
            } else if (lk == "subject") {
                subject = h.firstValue();
                continue;
            } else if ((lk == "importance" && h.firstValue() =~ /^high$/i)
                        || (lk =~ /^(x-)?priority$/ && h.firstValue() =~ /^urgent$/i)) {
                importance = True;
                continue;
            } else if (lk == "return-receipt-to") {
                # FIXME: we do not check if the return receipt is the same as the sender
                deliveryReceipt = True;
                continue;
            } else if (lk == "disposition-notification-to") {
                # FIXME: we do not check if the read receipt is the same as the sender
                readReceipt = True;
                continue;
            }

            headers += h;
        }

        #printf("mime: %y ct: %y %d headers: %Y\n", mime, ct, headers.size(), headers);

        # try and parse the Content-Type header; assume any multipart type is "multipart/mixed"
        # (http://tools.ietf.org/html/rfc2046#section-5.1.3)
        if (mime && ct =~ /multipart\//i) {
            isMultipartMsg = True;
            # extract multipart subtype
            *string subtype = (ct =~ x/multipart\/([a-z0-9\-]+)/i)[0];
            if (subtype) {
                multipartType = subtype.lwr();
                # set specific multipart type flags
                switch (multipartType) {
                    case "signed":
                        isSignedMsg = True;
                        break;
                    case "encrypted":
                        isEncryptedMsg = True;
                        break;
                    case "digest":
                        isDigestMsg = True;
                        break;
                }
            }

            # get message boundary - handle both quoted and unquoted boundaries
            *list<*string> match = (ct =~ x/boundary=(?:"([^"]+)"|([^\s;]+))/);
            *string boundary = match[0] ?? match[1];
            if (!boundary)
                throw "MESSAGE-PARSE-ERROR", sprintf("cannot parse MIME Content-Type: %y; could not find message boundary", ct);

            hash<MessageInfo> mpb = MultiPartMessage::parseBody(boundary, msg, True);

            # process/decode parts; the preamble and the epilogue of the multipart body are not part of the message
            # content (RFC 2046 section 5.1.1): they were taken as the body or as another part
            map processPart($1 + {"part_index": $#}), mpb.part;
        } else {
            if (ct) {
                bodyContentType = ct;
            }
            # the rest of the message is the body, which is written again with its content transfer encoding
            if (msg.val()) {
                body = mime_decode_transfer_data(msg, cte, ct);
                bodyEncoding = Message::getParsedEncoding(cte, body);
            }
        }
    }

    #! Returns information about the message
    hash<MailMessageInfo> getInfo() {
        hash<MailMessageInfo> rv();
        if (from.val()) {
            rv.from = from;
        }
        if (sender.val()) {
            rv.sender = sender;
        }
        if (subject.val()) {
            rv.subject = subject;
        }
        if (sender.val()) {
            rv.sender = sender;
        }
        if (to) {
            rv.to = to;
        }
        if (cc) {
            rv.cc = cc;
        }
        if (bcc) {
            rv.bcc = bcc;
        }
        if (body.val()) {
            rv.body = body;

            rv.body_encoding = bodyEncoding;
            if (bodyContentType) {
                rv.body_content_type = bodyContentType;
            }
        }
        if (headers) {
            rv.headers = headers;
        }
        if (importance) {
            rv.important = True;
        }
        if (deliveryReceipt) {
            rv.delivery_receipt = True;
        }
        if (readReceipt) {
            rv.read_receipt = True;
        }
        if (attachments) {
            rv.attachments = map cast<hash<PartInfo>>($1.getInfo()), attachments;
        }
        if (parts) {
            rv.parts = map cast<hash<PartInfo>>($1.getInfo()), parts;
        }
        rv.is_multipart = isMultipartMsg;
        if (multipartType) {
            rv.multipart_type = multipartType;
        }
        rv.is_signed = isSignedMsg;
        rv.is_encrypted = isEncryptedMsg;
        rv.is_digest = isDigestMsg;
        return rv;
    }

    #! Returns @ref True if this is a multipart message
    /** @return @ref True if the message has a multipart content type
    */
    bool isMultipart() {
        return isMultipartMsg;
    }

    #! Returns the multipart subtype if this is a multipart message
    /** @return the multipart subtype (e.g., "mixed", "alternative", "signed", "encrypted", "digest"),
        or @ref nothing if this is not a multipart message
    */
    *string getMultipartType() {
        return multipartType;
    }

    #! Returns @ref True if this message is digitally signed (multipart/signed)
    /** @return @ref True if the message has content type multipart/signed as defined in
        <a href="https://tools.ietf.org/html/rfc1847">RFC 1847</a>
    */
    bool isSigned() {
        return isSignedMsg;
    }

    #! Returns @ref True if this message is encrypted (multipart/encrypted)
    /** @return @ref True if the message has content type multipart/encrypted as defined in
        <a href="https://tools.ietf.org/html/rfc1847">RFC 1847</a>
    */
    bool isEncrypted() {
        return isEncryptedMsg;
    }

    #! Returns @ref True if this message is a digest (multipart/digest)
    /** @return @ref True if the message has content type multipart/digest as defined in
        <a href="https://tools.ietf.org/html/rfc2046">RFC 2046</a>
    */
    bool isDigest() {
        return isDigestMsg;
    }

    #! serializes the message to a string that can be sent to an SMTP server, for example
    /** If the message was created in SMTP mode (the default), the string is given SMTP transparency with
        @ref encodeSmtpData(): every CR or LF character that is not part of a CRLF line break is written as CRLF,
        and a \c "." is added at the start of every line that starts with \c "."; otherwise the string is the same
        as from @ref serializeRaw().

        @throw MESSAGE-ERROR the message is incomplete and cannot be sent
        @throw HEADER-ERROR a header name contains a NUL, CR or LF character

        @note use @ref serializeRaw() for a message that is stored or uploaded rather than sent with the SMTP
        \c DATA command (for example with the IMAP \c APPEND command), since an SMTP server removes the \c "."
        added at the start of a line, but a mailbox or an API that takes a whole message does not

        @since MailMessage 1.5.1 a CR or LF character that is not part of a CRLF line break is written as CRLF in
        SMTP mode, so that a line that starts with \c "." after it is given its added \c "." as well
    */
    string serialize() {
        string str = serializeRaw();
        return smtp_mode ? Message::encodeSmtpData(str) : str;
    }

    #! serializes the message to a string in the Internet message format (RFC 5322), as it is stored or uploaded
    /** Unlike @ref serialize() in SMTP mode, no \c "." is added at the start of the lines that start with
        \c "."; use this method for a message that is stored or uploaded as a whole, for example with the IMAP
        \c APPEND command or an API that takes a raw message, rather than sent with the SMTP \c DATA command.

        @return the message with its headers, ending with CRLF

        @throw MESSAGE-ERROR the message is incomplete and cannot be sent
        @throw HEADER-ERROR a header name contains a NUL, CR or LF character

        @par Example:
        @code{.py}
imap.append("Sent", msg.serializeRaw());
        @endcode

        @since MailMessage 1.5.1
    */
    string serializeRaw() {
        # throws a MESSAGE-ERROR exception if the message cannot be sent
        checkSendPossible();

        # the message is made in the character encoding of its body, so that a body written as it is keeps the bytes
        # of the encoding that its Content-Type declares; it was converted to UTF-8 with the headers.  The headers
        # are ASCII once encoded, so they are the same bytes in any ASCII-compatible encoding.
        string enc = Message::getSerializationEncoding(body);
        string str = convert_encoding(getHeaderString(), enc);

        # is this a multipart msg?
        if (attachments || parts) {
            str += binary_to_string(getMultipartIntern(), enc);
            str += "\r\n";
        } else {
            str += "\r\n";
            if (bodyEncoding == ContentEncoding::None) {
                string b = body;
                str += b;
            } else {
                str += mime_encode_transfer_data(body, bodyEncoding);
            }
            # the message ends with a line break; one was added after a body that ended with one, so the body of a
            # parsed message grew by an empty line every time it was serialized again
            if (!Message::endsWithCrLf(str)) {
                str += "\r\n";
            }
        }

        return str;
    }

    #! returns message text with SMTP transparency, ready to be sent with the SMTP \c DATA command
    /** According to <a href="https://datatracker.ietf.org/doc/html/rfc5321#section-4.5.2">RFC 5321 section
        4.5.2</a>:
        - every CR or LF character that is not part of a CRLF line break is written as CRLF, since a server can
          take a bare CR or LF as the end of a line, and so a line with only \c "." after it as the end of the data
          (SMTP smuggling)
        - a \c "." is added at the start of every line that starts with \c ".", which the server removes, so that
          no line of the message can end the data
        - CRLF is added at the end if the text does not end with one, so that the end-of-data line \c ".\r\n" can
          follow it

        @param str the message text, for example from @ref serializeRaw()

        @return the text to send after the \c DATA command, without the end-of-data line \c ".\r\n"

        @par Example:
        @code{.py}
string data = Message::encodeSmtpData(msg.serializeRaw()) + ".\r\n";
        @endcode

        @since MailMessage 1.5.1
    */
    static string encodeSmtpData(string str) {
        string enc = get_encoding(str);
        if (!Message::isAsciiCompatEncoding(enc)) {
            str = convert_encoding(str, "UTF-8");
            enc = "UTF-8";
        }
        # the bytes of the text are kept: regular expressions work on UTF-8, so the text is processed as ISO-8859-1,
        # in which every byte is a character, and converted back to it; the text was converted to UTF-8, so a body in
        # another encoding was sent in UTF-8, contrary to its Content-Type
        string tmp = force_encoding(str, "ISO-8859-1");
        # a CRLF line break is kept; a bare CR or LF is written as CRLF
        tmp = regex_subst(tmp, "\r\n|\r|\n", "\r\n", RE_Global);
        # a "." is added at the start of every line that starts with "."
        tmp = regex_subst(tmp, "(^|\r\n)\\.", "$1..", RE_Global);
        if (tmp.size() && !Message::endsWithCrLf(tmp)) {
            tmp += "\r\n";
        }
        return force_encoding(convert_encoding(tmp, "ISO-8859-1"), enc);
    }

    #! processes a part; \c part_index in the hash is its index in the list of parts that holds it
    private processPart(hash<auto> p) {
        # a part that has parts (ex: multipart/alternative in multipart/mixed) holds no content of its own: its body
        # is the preamble and epilogue of its multipart body, which was taken as the message body or as a part
        if (p.part) {
            map processPart($1 + {"part_index": $#}), p.part;
            return;
        }

        # part content type: text/plain if no type is given (RFC 2046 section 5.1); "7bit" was used
        string pct = MimeTypeText;
        # the Content-Type value of the part, if any
        *string pct_hdr;
        # part content transfer encoding (default: no encoding)
        string pcte = ContentTransEncBinary;
        # part content disposition
        string pcd;
        # Content-ID (for inline attachments)
        *string cid;

        # process part headers
        foreach hash<auto> h in (p.hdr.pairIterator()) {
            if (h.key == "content-transfer-encoding") {
                pcte = h.value.lwr();
            } else if (h.key == "content-type") {
                pct = pct_hdr = h.value;
            } else if (h.key == "content-disposition") {
                pcd = h.value;
            } else if (h.key == "content-id") {
                # Extract Content-ID, removing angle brackets if present
                cid = (h.value =~ x/<([^>]+)>/)[0] ?? h.value;
            }
        }

        # get the part's name if possible
        *string pn;

        # First try RFC 2231 encoded filename (filename*=charset'lang'value)
        *list<*string> rfc2231_match = (pcd =~ x/filename\*=([^;\s]+)/i);
        if (rfc2231_match[0]) {
            pn = decode_mime_filename(rfc2231_match[0]);
        }

        # Fall back to regular filename parameter
        if (!pn) {
            pn = (pcd =~ x/filename="?([^"]+)"?/)[0];
            if (pn) {
                # Decode if it looks like RFC 2047 encoded
                pn = decode_mime_filename(pn);
            }
        }

        # try to get the filename from the content-type header if necessary
        if (!pn) {
            # Try RFC 2231 encoded name first
            rfc2231_match = (pct =~ x/name\*=([^;\s]+)/i);
            if (rfc2231_match[0]) {
                pn = decode_mime_filename(rfc2231_match[0]);
            } else {
                pn = (pct =~ x/name="?([^"]+)"?/)[0];
                if (pn) {
                    pn = decode_mime_filename(pn);
                }
            }
        }

        # Sanitize the filename if we have one
        if (pn.val()) {
            pn = sanitize_filename(pn);
        }

        # convert the content-type string to lower case
        pct = pct.lwr();

        # get the content type
        # strip off any additional information from the content-type
        pct =~ s/;.*$//;
        if (pct.empty()) {
            pct = MimeTypeUnknown;
        }

        #printf("DBG: got part: pcte: %y pct: %y pcd: %y body: %d bytes: %y\n", pcte, pct, pcd, p.body.size(), p.body);

        # Determine if this is an attachment:
        # - Content-Disposition: attachment
        # - Content-Disposition: inline with a filename (inline attachment)
        # - Content-Disposition: inline with Content-ID (inline attachment)
        bool is_attachment = (pcd =~ /attachment/i);
        bool is_inline_attachment = !is_attachment && (pcd =~ /inline/i) && (pn.val() || cid.val());

        if (is_attachment || is_inline_attachment) {
            # generate a name for the part if no filename is available
            if (!pn) {
                pn = "unnamed-attachment-" + (p.part_index ?? 0);
            }

            # the attachment is encoded again with its content transfer encoding if it has one for re-encoding
            # (base64 or quoted-printable), otherwise with the default for its data: "7bit", "8bit" and "binary"
            # are not encodings of an attachment, and parsing the message failed with UNKNOWN-ENCODING
            attachments += new Attachment(pn, pct, p.body, Message::getParsedAttachmentEncoding(pcte), p.hdr, cid,
                is_inline_attachment);
        } else {
            # Not an attachment - set as message body or add to parts
            if (!exists body) {
                body = p.body;
                bodyContentType = pct_hdr;
                bodyEncoding = Message::getParsedEncoding(pcte, p.body);
            } else {
                parts += new Part(pn.val() ? pn : "", pct, p.body, Message::getParsedPartEncoding(pcte, p.body),
                    p.hdr);
            }
        }
    }

    #! @cond nodoc
    # returns the encoding to serialize a message body parsed with the given content transfer encoding with: base64
    # and quoted-printable data is encoded again, other data ("7bit", "8bit", "binary") is written as it is, except
    # binary data, which is encoded with base64
    private static string getParsedEncoding(string cte, data body) {
        switch (cte.lwr()) {
            case ContentTransEncBase64: return ContentEncoding::Base64;
            case ContentTransEncQuotedPrintable: return ContentEncoding::QuotedPrintable;
        }
        return body.typeCode() == NT_BINARY ? ContentEncoding::Base64 : ContentEncoding::None;
    }

    # returns the encoding of an attachment parsed with the given content transfer encoding
    private static string getParsedAttachmentEncoding(string cte) {
        switch (cte.lwr()) {
            case ContentTransEncBase64: return ContentEncoding::Base64;
            case ContentTransEncQuotedPrintable: return ContentEncoding::QuotedPrintable;
        }
        return ContentEncoding::Default;
    }

    # returns the content transfer encoding of a part parsed with the given content transfer encoding: a transfer
    # encoding that the Mime module cannot write is replaced with base64 or quoted-printable
    private static string getParsedPartEncoding(string cte, data body) {
        cte = cte.lwr();
        if (inlist(cte, (ContentTransEnc7Bit, ContentTransEnc8Bit, ContentTransEncBinary, ContentTransEncBase64,
                ContentTransEncQuotedPrintable))) {
            return cte;
        }
        return body.typeCode() == NT_BINARY ? ContentTransEncBase64 : ContentTransEncQuotedPrintable;
    }

    # returns True if the string ends with CRLF; its bytes are checked, without a conversion of the whole string
    private static bool endsWithCrLf(string str) {
        int len = str.size();
        return len >= 2 && get_byte(str, len - 2) == 13 && get_byte(str, len - 1) == 10;
    }

    # returns True if a character encoding is ASCII-compatible, so that CR, LF and the ASCII characters of the
    # message syntax are the same bytes in it
    private static bool isAsciiCompatEncoding(string enc) {
        return enc !~ /^utf-?(16|32)/i;
    }

    # returns the character encoding of a serialized message: the encoding of its body if it is a string in an
    # ASCII-compatible encoding, otherwise the default encoding
    private static string getSerializationEncoding(*data body) {
        if (body.typeCode() == NT_STRING) {
            string enc = get_encoding(body);
            if (Message::isAsciiCompatEncoding(enc)) {
                return enc;
            }
        }
        return get_default_encoding();
    }

    # returns the content type of the body: the one set for the body, otherwise a Content-Type header given or parsed
    # with the message that is not the type of a multipart message; a charset is added for a body with non-ASCII
    # characters if the type has none, so that the encoding of the body is declared
    private *string getBodyContentTypeIntern() {
        *string ct = bodyContentType;
        if (!ct) {
            foreach string k in (keys headers) {
                if (k.lwr() == "content-type") {
                    string v = headers{k};
                    if (v !~ /^\s*multipart\//i) {
                        ct = v;
                    }
                    break;
                }
            }
        }
        if (ct && body.typeCode() == NT_STRING && ct !~ /charset=/i && !body.isDataAscii()) {
            ct += sprintf("; charset=%s", get_encoding(body));
        }
        return ct;
    }

    # returns the content transfer encoding of a body that is written as it is in a MIME part
    private static string getRawTransferEncoding(data body) {
        if (body.typeCode() == NT_BINARY) {
            return ContentTransEncBinary;
        }
        return body.isDataAscii() ? ContentTransEnc7Bit : ContentTransEnc8Bit;
    }

    # returns the multipart body of a message with alternative parts or attachments, with its MIME headers: the
    # body and its alternative parts are written as a multipart/alternative part, in a multipart/mixed part with the
    # attachments if there are any
    private binary getMultipartIntern() {
        string ct = getBodyContentTypeIntern() ?? MimeTypeText;
        string benc = bodyEncoding == ContentEncoding::None ? Message::getRawTransferEncoding(body) : bodyEncoding;

        *MultiPartAlternativeMessage mpa;
        if (parts) {
            mpa = new MultiPartAlternativeMessage();
            mpa.addEncodePart(body, benc, ct);
            map $1.add(mpa), parts;
            if (!attachments) {
                hash<MessageInfo> mi = mpa.getMsgAndHeaders();
                return MultiPartMessage::serializeHeaders({"MIME-Version": "1.0"} + mi.hdr) + mi.body;
            }
        }

        MultiPartMixedMessage mpm(mpboundary);
        if (mpa) {
            hash<MessageInfo> mi = mpa.getMsgAndHeaders();
            # the multipart/alternative part is 7bit if all of its parts are, otherwise 8bit
            bool is7bit = inlist(benc, (ContentTransEncBase64, ContentTransEncQuotedPrintable, ContentTransEnc7Bit))
                && !(select parts, !inlist($1.getTransferEncoding(), (ContentTransEncBase64,
                    ContentTransEncQuotedPrintable, ContentTransEnc7Bit)));
            mpm.addPart(mi.body, mi.hdr."Content-Type", "inline",
                {"Content-Transfer-Encoding": is7bit ? ContentTransEnc7Bit : ContentTransEnc8Bit});
        } else {
            # add the message body with content-disposition: "inline"
            mpm.addEncodePart(body, benc, ct, "inline");
        }

        # add attachments
        map $1.add(mpm), attachments;
        return mpm.serialize();
    }
    #! @endcond

    #! fetch the email address out of a sender/rcpt string
    /** An email address is an RFC 5322 \c addr-spec (section 3.4.1): a local part, which is a sequence of \c atext
        characters (letters, digits and <tt>!\#$\%&'*+-/=?^_&#96;{|}~</tt>) and dots, or a quoted string (ex:
        <tt>"John Doe"\@example.com</tt>), then \c "@" and a domain, which is a host name or a domain literal in
        square brackets (ex: \c "[192.0.2.1]").  Non-ASCII letters, marks, digits, punctuation and symbols are
        accepted in the local part and in the domain (internationalized email addresses and domain names, RFC 6531
        and RFC 6532), but no white space (such as a no-break space) or control character, so that an address
        cannot end a header or command line.

        @param str an email address, or a display name and an email address in angle brackets (ex:
        \c "John Doe <john@example.com>")

        @return the email address, or @ref nothing if there is none; RFC 2047 encoded words in the string are text,
        never part of an address, and the white space (including Unicode white space) and format characters (ex: a
        byte order mark) around the string are ignored:
        - the address in quotes, square brackets or braces, if the string is an address in them (ex:
          <tt>"j\@x.com"</tt> or <tt>'j\@x.com'</tt>, as in CSV data)
        - the address in angle brackets at the end of the string
        - the string, if it is an address
        - otherwise the first address in the string that is not in a comment (text in parentheses) or, if there is
          one, not in a quoted string (a quoted local part is part of an address), and that starts
          after white space or one of <tt>,;:<>()[]"</tt> (or at the start of the string) and ends before white
          space, one of <tt>,;:<>()[]"'/?#&{}|!*\\</tt> or the end of the string, with only format characters
          between them and the address (ex: \c "j@x.com" for <tt>"j\@x.com (John)"</tt>,
          <tt>"(v\@x.com) j\@x.com"</tt> or <tt>"j\@x.com?subject=hi"</tt>)

        @note an address with non-ASCII characters can only be sent to an SMTP server that supports the \c SMTPUTF8
        extension (RFC 6531); see @ref SmtpClient::SmtpClient::sendMessage() "SmtpClient::sendMessage()"

        @since MailMessage 1.5.1 the address in angle brackets at the end of the string is returned when there is
        one; the first text that looked like an address was returned, which could be in the display name or in an
        encoded word.  An address is returned whole with every \c atext character in its local part (ex:
        <tt>J.O'B\@x.com</tt>; the text after the last character that was not a letter, a digit or one of
        <tt>-._+=</tt> was returned: <tt>B\@x.com</tt>), and quoted local parts and non-ASCII characters are
        accepted.  Text that is not an address is no longer returned: the text before an address separated from it
        by spaces (<tt>"John Doe john\@x.com"</tt> gave <tt>"John Doe john\@x.com"</tt>, and gives
        <tt>"john\@x.com"</tt>), text with a space before the \c "@" (<tt>"j \@x.com"</tt>), and an address that is
        part of a longer word (<tt>"abc\@def\@ghi.com"</tt> gave <tt>"abc\@def"</tt>; the local part of
        <tt>"http://user\@host.com/path"</tt> is now <tt>"//user"</tt>)
    */
    static *string getEmailAddress(string str) {
        # an encoded word is text, never part of an address (issue #6066)
        if (str.find("=?") >= 0) {
            str = Message::removeEncodedWords(str);
        }
        string t = Message::trimSpace(str);
        # an address in quotes, brackets or braces
        *string inner = Message::unwrap(t);
        if (exists inner && Message::isAddrSpec(inner)) {
            return inner;
        }
        # the address of a name-addr (RFC 5322 section 3.4) is in angle brackets after the display name, which can
        # contain text that looks like another address
        *string addr = Message::getAngleAddress(t);
        if (exists addr) {
            return addr;
        }
        if (Message::isAddrSpec(t)) {
            return t;
        }
        # the first address in the string that is not part of another word or in a comment or a quoted string, as
        # a reader of the header sees it; an address in a quoted string is found if there is no other (ex: in
        # "\"John j@x.com\"", which was accepted before)
        bool has_quote = str.find("\"") >= 0;
        if (str.find("(") >= 0 || has_quote) {
            addr = AddrScanRx.extractGroups(Message::removeComments(str, True))[0];
            if (exists addr || !has_quote) {
                return addr;
            }
            if (str.find("(") >= 0) {
                str = Message::removeComments(str, False);
            }
        }
        return AddrScanRx.extractGroups(str)[0];
    }

    #! @cond nodoc
    # returns the string with every RFC 2047 encoded word replaced with a space; text that looks like an encoded
    # word but has a character that an encoded word cannot have (white space or an RFC 5322 special, such as a
    # quote, a parenthesis or a bracket) is not one, so that removing it cannot change where a quoted string, a
    # comment or a bracket starts or ends (issue #6134)
    private static string removeEncodedWords(string str) {
        return EncodedWordSubst.subst(str);
    }

    # returns the string without white space, including Unicode white space, and format characters (ex: a byte
    # order mark) at its start and end; linear in the length of the string
    private static string trimSpace(string str) {
        str = TrimStartSubst.subst(str);
        if (!TrimEndRx.match(str)) {
            return str;
        }
        list<string> chars = str.splitChars();
        int end = chars.size();
        while (end && (Message::isSpace(chars[end - 1]) || FormatCharRx.match(chars[end - 1]))) {
            --end;
        }
        return str.substr(0, end);
    }

    # returns the string with its comments (RFC 5322 section 3.2.2: text in parentheses outside quoted strings,
    # which can be nested) replaced with a space, and also its quoted strings if quotes is True, except a quoted
    # local part (a quoted string followed by "@"); an unterminated comment or quoted string is kept; linear in the
    # length of the string
    private static string removeComments(string str, bool quotes) {
        list<string> c = str.splitChars();
        int n = c.size();
        # the parts of the string returned; the text kept is added as a range of characters, not a character at a
        # time (see joinChars())
        list<string> rv = ();
        # the offset of the text to keep, or of the start of the current comment
        int start = 0;
        int depth = 0;
        bool escaped;
        for (int i = 0; i < n; ++i) {
            string ch = c[i];
            if (depth) {
                if (escaped) {
                    escaped = False;
                } else if (ch == "\\") {
                    escaped = True;
                } else if (ch == "(") {
                    ++depth;
                } else if (ch == ")" && !--depth) {
                    rv += " ";
                    start = i + 1;
                }
                continue;
            }
            if (ch == "\"") {
                int j = i + 1;
                for (; j < n; ++j) {
                    if (escaped) {
                        escaped = False;
                    } else if (c[j] == "\\") {
                        escaped = True;
                    } else if (c[j] == "\"") {
                        break;
                    }
                }
                if (j == n) {
                    # an unterminated quoted string is text
                    break;
                }
                if (quotes && (j + 1 == n || c[j + 1] != "@")) {
                    rv += Message::joinChars(c, start, i) + " ";
                    start = j + 1;
                }
                i = j;
                continue;
            }
            if (ch == "(") {
                rv += Message::joinChars(c, start, i);
                start = i;
                depth = 1;
            }
        }
        # the rest of the string, with an unterminated comment or quoted string
        rv += Message::joinChars(c, start, n);
        return rv.join("");
    }

    # returns the text in quotes, square brackets or braces if the string is in them
    private static *string unwrap(string str) {
        if (str.size() < 2) {
            return;
        }
        string first = str.substr(0, 1);
        string last = str.substr(-1);
        if ((first == "\"" && last == "\"") || (first == "'" && last == "'") || (first == "[" && last == "]")
            || (first == "{" && last == "}")) {
            return Message::trimSpace(str.substr(1, -1));
        }
    }

    # returns the address in angle brackets at the end of a trimmed string, if there is one; the last "<" is found
    # without a regular expression, so the time is linear in the length of the string
    private static *string getAngleAddress(string str) {
        if (str.substr(-1) != ">") {
            return;
        }
        int i = str.rfind("<");
        if (i < 0) {
            return;
        }
        string addr = Message::trimSpace(str.substr(i + 1, -1));
        if (addr.find(">") < 0 && Message::isAddrSpec(addr)) {
            return addr;
        }
    }
    #! @endcond

    #! returns @ref True "True" if the string contains an email address, @ref False "False" if not
    static bool checkEmailAddress(string str) {
        return !Message::getEmailAddress(str).empty();
    }

    #! returns the email addresses of an address header value, which can be a list of mailboxes
    /** @param str the value of a \c To, \c CC or \c BCC header, or of one entry of it (ex:
        <tt>Ann \<a\@x.com\>, "Doe, John" \<j\@x.com\></tt>)

        @return the email address of each mailbox of the value, in order (see @ref getEmailAddress()): the value is
        split as an RFC 5322 list of mailboxes, at the commas that are not in a quoted string, a comment, angle
        brackets or a domain literal, and the mailboxes of a group (<tt>"name: a\@x.com, b\@y.com;"</tt>) are
        returned without the name of the group (an empty group, such as <tt>"undisclosed-recipients:;"</tt>, has no
        address); an RFC 2047 encoded word is text, never part of an address.  A value that is not a list of
        mailboxes gives the address that @ref getEmailAddress() returns for it, if any.  Duplicate addresses are
        returned as they are; @ref getRecipients() removes them.

        @since MailMessage 1.5.1
    */
    static list<string> getEmailAddresses(string str) {
        # an encoded word is text, never part of an address, and its text cannot hide a separator
        if (str.find("=?") >= 0) {
            str = Message::removeEncodedWords(str);
        }
        list<string> parts = Message::splitMailboxList(str, True);
        list<string> rv = ();
        if (parts.size() > 1) {
            foreach string part in (parts) {
                # a part without "@" has no address (ex: the name of a group, or an empty part)
                if (part.find("@") < 0) {
                    continue;
                }
                *string addr = Message::getEmailAddress(part);
                if (exists addr) {
                    rv += addr;
                }
            }
        }
        if (!rv) {
            # a single mailbox, or a value that is not a list of mailboxes
            *string addr = Message::getEmailAddress(str);
            if (exists addr) {
                rv += addr;
            }
        }
        return rv;
    }

    #! @cond nodoc
    # returns the display name of a mailbox in the name-addr form ("Name <addr>", RFC 5322 section 3.4) if the
    # address in angle brackets is the given address, and the text before it is a phrase (see getPhraseText()); an
    # empty string if there is no name; NOTHING if the mailbox is not in this form
    private static *string getDisplayName(string mailbox, string addr) {
        *list<*string> m = mailbox =~ x/^\s*(.*?)\s*<([^<>]*)>\s*$/s;
        if (!m || m[1] != addr) {
            return;
        }
        return Message::getPhraseText(m[0] ?? "");
    }

    # returns the text of a display name: its words, which are atoms or quoted strings (without the quotes and the
    # backslashes that quote characters in them), separated by a space; NOTHING if it has an unterminated quoted
    # string, a '<' or '>' outside quotes, or a ',' and a '@' outside quotes: the text before the last address of a
    # list of mailboxes, where each mailbox before it has an address in angle brackets or an address alone.  A ','
    # alone is accepted, as in "Me, Myself, and I <me@email.com>", and the name is then quoted in the header.
    private static *string getPhraseText(string phrase) {
        list<string> words = ();
        string word = "";
        bool in_word;
        bool quoted;
        bool escaped;
        bool comma;
        bool at;
        foreach string c in (phrase.splitChars()) {
            if (quoted) {
                if (escaped) {
                    word += c;
                    escaped = False;
                } else if (c == "\\") {
                    escaped = True;
                } else if (c == "\"") {
                    quoted = False;
                } else {
                    word += c;
                }
                continue;
            }
            if (c == "\"") {
                quoted = True;
                in_word = True;
            } else if (c == " " || c == "\t" || c == "\r" || c == "\n") {
                if (in_word) {
                    words += word;
                    word = "";
                    in_word = False;
                }
            } else if (c == "<" || c == ">") {
                return;
            } else {
                if (c == ",") {
                    comma = True;
                } else if (c == "@") {
                    at = True;
                }
                word += c;
                in_word = True;
            }
        }
        if (quoted || (comma && at)) {
            return;
        }
        if (in_word) {
            words += word;
        }
        # white space in quoted strings is collapsed as between words, so that the name has no line break and no
        # white space that the header could not keep; an empty name is no name
        string name = words.join(" ");
        name =~ s/\s+/ /g;
        trim name;
        return name;
    }

    # returns a mailbox in display format: "Name <addr>", with the name as a quoted string if it has specials
    private static string formatMailbox(string name, string addr) {
        if (name =~ /[()<>\[\]:;@\\,."]/) {
            name = "\"" + replace(replace(name, "\\", "\\\\"), "\"", "\\\"") + "\"";
        }
        return sprintf("%s <%s>", name, addr);
    }

    # returns a header with the sender in display format: the display name is encoded as an RFC 2047 "B" encoded word
    # if it is not printable ASCII and encode is True, and the address is never encoded
    private string doSenderHeader(string hdr, string eol, bool encode) {
        # the sender of a parsed message, or of a message created with no display name
        if (!sender_name.val()) {
            return Message::doAddressHeader(hdr, from, from_raw, eol, encode, True);
        }
        if (!encode) {
            return Message::doHeaderValue(hdr, from, eol, encode);
        }
        check_line_text(hdr, "message header name", "HEADER-ERROR");
        string name = sender_name;
        # a printable ASCII name is written as it is (as a quoted string if it has specials), with the address, which
        # can have non-ASCII characters but no control character
        if (name.isDataPrintableAscii()) {
            return sprintf("%s: %s%s", hdr, from, eol);
        }
        # an encoded word cannot be in a quoted string, and the "B" encoding has no specials (RFC 2047 section 5),
        # so the name is encoded as it is; a line break in the name is encoded and cannot end the header line
        return sprintf("%s: %s <%s>%s", hdr, mime_encode_header_word_b(name, eol), sender, eol);
    }

    private {
        # white space, including Unicode white space (ex: a no-break space, a line or paragraph separator, NEL)
        const SpaceChars = "\\s\\p{Z}\\x{85}";
        # white space and format characters (ex: a byte order mark, a zero width space, a soft hyphen, a
        # directional formatting character), which are trimmed from a string and can be before or after an
        # address, but not in it
        const TrimChars = SpaceChars + "\\p{Cf}";
        # a non-ASCII character that can be in an address (RFC 6532 section 3.2): a letter, a mark, a digit, a
        # punctuation character or a symbol, not white space or a control or format character
        const NonAsciiRegex = "(?:(?=[^\\x00-\\x7f])[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S}])";
        # the local part of an address: a quoted string, or atext characters (RFC 5322 section 3.2.3) and dots, which
        # can be anywhere in the local part, as in the addresses that the module accepted before; the quantifiers
        # are possessive, so the time to match is linear in the length of the string
        const LocalPartRegex = "(?:\"(?:[\\x20\\x21\\x23-\\x5b\\x5d-\\x7e]|\\\\[\\x20-\\x7e]|" + NonAsciiRegex
            + ")*+\"|(?:[A-Za-z0-9!#$%&'*+/=?^_`{|}~.\\-]|" + NonAsciiRegex + ")++)";
        # the domain of an address: a host name, which can have non-ASCII characters (an internationalized domain
        # name), or a domain literal
        const DomainRegex = "(?:(?:[A-Za-z0-9_.\\-]|" + NonAsciiRegex + ")++|\\[[\\x21-\\x5a\\x5e-\\x7e]++\\])";
        # an address (RFC 5322 section 3.4.1 addr-spec)
        const AddrSpecRegex = LocalPartRegex + "@" + DomainRegex;
        # the characters besides white space that can be before an address in a string, and that separate the
        # words of an address header for its encoding
        const AddrStartChars = ",;:<>()\\[\\]\"";
        # the end of an address in a string: format characters, then white space, one of these characters or the
        # end of the string
        const AddrEndRegex = "\\p{Cf}*(?=\\z|[" + SpaceChars + ",;:<>()\\[\\]\"'/?#&{}|!*\\\\])";
        # an address in a string that is not part of another word: after the start of the string, white space or
        # one of AddrStartChars, and format characters
        const AddrScanRegex = "(?:\\A|[" + SpaceChars + AddrStartChars + "])\\p{Cf}*(" + AddrSpecRegex + ")"
            + AddrEndRegex;
        # an address at the start of a word, after format characters
        const AddrWordRegex = "\\A(\\p{Cf}*)(" + AddrSpecRegex + ")" + AddrEndRegex;
        # the characters that separate the words of an address header
        const AddrSpecials = {",": True, ";": True, ":": True, "<": True, ">": True, "(": True, ")": True,
            "[": True, "]": True, "\"": True};
        # ASCII white space
        const AsciiSpace = {" ": True, "\t": True, "\r": True, "\n": True, "\f": True, "\v": True};
        # an encoded word (RFC 2047 section 2): its charset and its encoded text cannot have white space or a "?",
        # and not a character that starts or ends a quoted string, a comment, an angle address or a domain literal,
        # a backslash or a separator of mailboxes (RFC 2047 section 5), so that text that only looks like an encoded
        # word, and is removed or decoded as one, cannot change how the rest of an address header is read (issue
        # #6134); a ":" or a "@" can be in one, since a reader of the header sees text that is not an address
        const EncodedWordPattern = "=\\?[^?\\s\"()<>\\[\\],;\\\\]+\\?[QqBb]\\?[^?\\s\"()<>\\[\\],;\\\\]*\\?=";
        const EncodedWordRegex = "\\A" + EncodedWordPattern + "\\z";
        # the longest line of an address header that is folded (RFC 5322 section 2.1.1: 78 characters)
        const MaxHeaderLineLen = 76;
    }

    # the regular expressions above, compiled once: a pattern given as a string is compiled every time it is used
    # (issue #6134)
    private:internal {
        static Regex AddrSpecRx("\\A" + AddrSpecRegex + "\\z");
        static RegexExtract AddrScanRx(AddrScanRegex);
        static RegexExtract AddrWordRx(AddrWordRegex);
        static Regex EncodedWordRx(EncodedWordRegex);
        static RegexSubst EncodedWordSubst(EncodedWordPattern, " ", RE_Global);
        static RegexSubst TrimStartSubst("\\A[" + TrimChars + "]+", "");
        static Regex TrimEndRx("[" + TrimChars + "]\\z");
        static Regex FormatCharRx("\\A\\p{Cf}\\z");
        static Regex SpaceRx("\\A[" + SpaceChars + "]\\z");
        # a dot-atom (RFC 5322 section 3.2.3), which can have non-ASCII characters (RFC 6532 section 3.2)
        static Regex DotAtomRx("\\A(?:[A-Za-z0-9!#$%&'*+/=?^_`{|}~\\-]|" + NonAsciiRegex
            + ")++(?:\\.(?:[A-Za-z0-9!#$%&'*+/=?^_`{|}~\\-]|" + NonAsciiRegex + ")++)*+\\z");
    }

    # returns True if the string is an email address (an RFC 5322 addr-spec)
    private static bool isAddrSpec(string str) {
        return AddrSpecRx.match(str);
    }

    # returns True if the character is white space; an ASCII character is looked up without a regular expression
    private static bool isSpace(string ch) {
        if (ch.isDataAscii()) {
            return AsciiSpace{ch} ?? False;
        }
        return SpaceRx.match(ch);
    }

    # splits a list of mailboxes at the commas that are not in a quoted string, a comment, angle brackets or a
    # domain literal; NOTHING if a quoted string is not terminated.  If groups is True, the value is split for its
    # addresses (issue #6134): also at the semicolons there and at the colons after a phrase, so that the display
    # name of a group (RFC 5322 section 3.4: "name: a@x.com, b@y.com;") is a part of its own, and a quoted string,
    # comment, angle address or domain literal that is not terminated is not one: the part where it starts is split
    # again without it, so that it cannot hide the separators after it.  The time is linear in the length of the
    # value: a part is split again at most once for each of the four kinds of construct.
    private static *list<string> splitMailboxList(string value, bool groups = False) {
        list<string> c = value.splitChars();
        int n = c.size();
        list<string> rv = ();
        # the offset of the start of the current part
        int start = 0;
        # the kinds of construct that are not recognized, after one that was not terminated
        hash<string, bool> off = {};
        bool quoted;
        bool escaped;
        bool angle;
        bool literal;
        # True if the current part has a "@" or a "<" outside quoted strings and comments: a colon after it is not
        # the end of the name of a group, which is a phrase (ex: in "j@x.com\r\nBcc: v@x.com")
        bool addr;
        int comment = 0;
        int i = 0;
        while (True) {
            if (i == n) {
                if (!groups) {
                    if (quoted) {
                        return;
                    }
                    break;
                }
                *string open = quoted ? "\"" : (comment ? "(" : (angle ? "<" : (literal ? "[" : NOTHING)));
                if (!exists open) {
                    break;
                }
                off{open} = True;
                i = start;
                quoted = escaped = angle = literal = addr = False;
                comment = 0;
                continue;
            }
            string ch = c[i++];
            if (escaped) {
                escaped = False;
            } else if (quoted) {
                if (ch == "\\") {
                    escaped = True;
                } else if (ch == "\"") {
                    quoted = False;
                }
            } else if (comment) {
                if (ch == "\\") {
                    escaped = True;
                } else if (ch == "(") {
                    ++comment;
                } else if (ch == ")") {
                    --comment;
                }
            } else if (ch == "\"" && !off{ch}) {
                quoted = True;
            } else if (ch == "(" && !off{ch}) {
                ++comment;
            } else if (ch == "<" && !off{ch}) {
                angle = addr = True;
            } else if (ch == "@") {
                addr = True;
            } else if (ch == ">") {
                angle = False;
            } else if (ch == "[" && !off{ch}) {
                literal = True;
            } else if (ch == "]") {
                literal = False;
            } else if (!angle && !literal && (ch == "," || (groups && ((ch == ":" && !addr) || ch == ";")))) {
                rv += Message::joinChars(c, start, i - 1);
                start = i;
                addr = False;
            }
        }
        rv += Message::joinChars(c, start, n);
        return rv;
    }

    # returns the characters from offset start to end (exclusive) as a string; a string is not built with a
    # character appended at a time, which takes a time that is not linear in its length in some execution modes
    private static string joinChars(list<string> c, int start, int end) {
        return start < end ? c[start..end - 1].join("") : "";
    }

    # returns a mailbox (an address alone, or a display name and an address in angle brackets, RFC 5322 section
    # 3.4) as a hash with "addr", "name" and "angle" (True if the address is in angle brackets), or NOTHING if the
    # string is not a mailbox; the encoded words of the name are decoded if decode is True (for the raw value of a
    # parsed header).  The address is found without a regular expression on the whole string, so the time is
    # linear in its length.
    private static *hash<auto> parseMailbox(string mailbox, bool decode) {
        # format characters are trimmed for the address only: they are part of a display name (ex: a directional
        # formatting character)
        string trimmed = Message::trimSpace(mailbox);
        if (Message::isAddrSpec(trimmed)) {
            return {"addr": trimmed};
        }
        *string addr = Message::getAngleAddress(trimmed);
        if (!exists addr) {
            return;
        }
        *string name = Message::getPhraseText(mailbox.substr(0, mailbox.rfind("<")));
        if (!exists name) {
            return;
        }
        if (decode && name.val()) {
            name = mime_decode_header(name);
        }
        return {"addr": addr, "name": name, "angle": True};
    }

    # returns the mailboxes of an address header value, or NOTHING if it is not a list of mailboxes
    private static *list<hash<auto>> parseMailboxList(string value, bool decode) {
        *list<string> parts = Message::splitMailboxList(value);
        if (parts && parts.size() > 1) {
            list<hash<auto>> rv = ();
            foreach string part in (parts) {
                *hash<auto> mb = Message::parseMailbox(part, decode);
                if (!mb) {
                    remove rv;
                    break;
                }
                rv += mb;
            }
            if (rv) {
                return rv;
            }
        }
        # a single mailbox, whose display name can have a comma outside quotes (ex: "Doe, John <j@x.com>")
        *hash<auto> mb = Message::parseMailbox(value, decode);
        if (mb) {
            return (mb,);
        }
    }

    # returns an address header (From, To, CC, BCC) with only the display names and the other text of its mailboxes
    # encoded (issue #6066): text that is not printable ASCII is encoded as RFC 2047 "B" encoded words, and the
    # addresses are never encoded, since an encoded word is not an address (RFC 2047 section 5); a printable ASCII
    # value is written as it is.  The raw value of a parsed header is used if given: it is written as it was parsed
    # if it is printable ASCII (with its encoded words), and its encoded words cannot hide the commas between
    # mailboxes.
    private static string doAddressHeader(string hdr, string val, *string raw, string eol, bool encode,
            bool sender = False) {
        if (!encode) {
            return Message::doHeaderValue(hdr, val, eol, encode);
        }
        string src = raw ?? val;
        if (src.isDataPrintableAscii()) {
            return Message::doHeaderValue(hdr, src, eol, encode);
        }
        check_line_text(hdr, "message header name", "HEADER-ERROR");
        int start = hdr.size() + 2;
        *list<hash<auto>> mailboxes = Message::parseMailboxList(src, exists raw);
        string value = mailboxes
            ? Message::foldMailboxes((map Message::formatHeaderMailbox($1.name, $1.addr, $1.angle, eol),
                mailboxes), eol, start)
            : Message::encodeAddressText(src, exists raw, eol, start);
        # a sender header (From, Return-Receipt-To, Disposition-Notification-To) gives the address that the value
        # gives, which is the sender of the envelope, so that a message that is parsed again has the same sender;
        # otherwise the value is written as the display name of that address (a sender is a mailbox, never a group)
        if (sender) {
            *string addr = Message::getEmailAddress(src);
            if (Message::getEmailAddress(value) !== addr) {
                value = mime_encode_header_word_b(val, eol);
                if (exists addr) {
                    value += sprintf(" <%s>", addr);
                }
            }
            return sprintf("%s: %s%s", hdr, value, eol);
        }
        # a recipient header gives the addresses that the value gives, so that a message that is parsed again (for
        # example to forward it) is sent to the same addresses (issue #6134); otherwise the value is written as the
        # display name of that address, or of a group with those addresses
        list<string> addrs = Message::getEmailAddresses(src);
        if (Message::getEmailAddresses(value) != addrs) {
            value = mime_encode_header_word_b(val, eol);
            if (addrs.size() == 1) {
                value += sprintf(" <%s>", addrs[0]);
            } else if (addrs) {
                (int first, int last) = Message::getLineLengths(value, eol);
                value += ": " + Message::foldMailboxes(addrs, eol, (value.find(eol) < 0 ? start + first : last) + 2)
                    + ";";
            }
        }
        return sprintf("%s: %s%s", hdr, value, eol);
    }

    # returns a mailbox for a header: the address alone (in angle brackets if it was in them) if it has no display
    # name, otherwise the display name, as a quoted string if it has specials, or as a "B" encoded word if it is not
    # printable ASCII, and the address
    private static string formatHeaderMailbox(*string name, string addr, *bool angle, string eol) {
        if (!name.val()) {
            return angle ? sprintf("<%s>", addr) : addr;
        }
        if (name.isDataPrintableAscii()) {
            return Message::formatMailbox(name, addr);
        }
        return sprintf("%s <%s>", mime_encode_header_word_b(name, eol), addr);
    }

    # returns the length of the first line of a string, and the length of its last line
    private static list<int> getLineLengths(string str, string eol) {
        int first = str.find(eol);
        int last = str.rfind(eol);
        int len = str.length();
        return (first < 0 ? len : first, last < 0 ? len : len - last - eol.length());
    }

    # returns the mailboxes separated by commas, with a folded line before a mailbox that would make the line
    # longer than MaxHeaderLineLen characters (RFC 5322 section 2.2.3)
    private static string foldMailboxes(list<string> mailboxes, string eol, int start) {
        string rv = "";
        int len = start;
        foreach string mb in (mailboxes) {
            (int first, int last) = Message::getLineLengths(mb, eol);
            if ($#) {
                if ((len + 2 + first) > MaxHeaderLineLen) {
                    rv += "," + eol + " ";
                    len = 1;
                } else {
                    rv += ", ";
                    len += 2;
                }
            }
            rv += mb;
            len = mb.find(eol) < 0 ? len + first : last;
        }
        return rv;
    }

    # returns the text of an address header that is not a list of mailboxes (ex: a group, a mailbox with a
    # comment, or a display name without angle brackets) with only the text that is not printable ASCII encoded
    # as RFC 2047 "B" encoded words: the addresses (an address in angle brackets, or at the start of a word), the
    # specials (,;:<>()[]") and the printable ASCII text are written as they are, white space is written as a space
    # or a folded line break, and a quoted string or a word that is not printable ASCII is encoded; encoded words
    # separated by white space are one encoded word, since the white space between encoded words is dropped when
    # they are decoded (RFC 2047 section 6.2).  The time is linear in the length of the value.
    private static string encodeAddressText(string src, bool decode, string eol, int start) {
        list<string> c = src.splitChars();
        int n = c.size();
        # the words of the value: hashes with "t" ("ws": white space, "lit": written as it is, "enc": text to
        # encode) and "s" (the text)
        list<hash<auto>> words = ();
        # no quoted string or angle brackets after an unterminated one, so that every character is read once or
        # twice
        bool no_quote;
        bool no_angle;
        # the offset of the character that ended an unterminated domain literal: a domain literal that starts before
        # it is unterminated too, so that every character is read at most twice
        int literal_end = -1;
        string word = "";
        # the last character added to the word
        string word_last = "";
        int i = 0;
        while (i < n) {
            string ch = c[i];
            if (Message::isSpace(ch)) {
                Message::addAddressWord(\words, \word, decode);
                if (!words || words.last().t != "ws") {
                    words += {"t": "ws", "s": " "};
                }
                ++i;
                continue;
            }
            if (ch == "\"" && !no_quote) {
                string quoted = "\"";
                string text = "";
                bool escaped;
                int j = i + 1;
                for (; j < n; ++j) {
                    quoted += c[j];
                    if (escaped) {
                        text += c[j];
                        escaped = False;
                    } else if (c[j] == "\\") {
                        escaped = True;
                    } else if (c[j] == "\"") {
                        break;
                    } else {
                        text += c[j];
                    }
                }
                if (j < n) {
                    i = j + 1;
                    # a quoted local part: the quoted string is the start of the word after it
                    if (i < n && c[i] == "@") {
                        word += quoted;
                        word_last = "\"";
                        continue;
                    }
                    Message::addAddressWord(\words, \word, decode);
                    words += quoted.isDataPrintableAscii() ? {"t": "lit", "s": quoted} : {"t": "enc", "s": text};
                    continue;
                }
                no_quote = True;
            } else if (ch == "<" && !no_angle) {
                string inner = "";
                int j = i + 1;
                for (; j < n && c[j] != ">" && c[j] != "<"; ++j) {
                    inner += c[j];
                }
                if (j < n && c[j] == ">") {
                    Message::addAddressWord(\words, \word, decode);
                    string addr = Message::trimSpace(inner);
                    if (Message::isAddrSpec(addr)) {
                        words += {"t": "lit", "s": "<" + addr + ">"};
                    } else {
                        words += {"t": "lit", "s": "<"};
                        Message::addAddressText(\words, inner, decode);
                        words += {"t": "lit", "s": ">"};
                    }
                    i = j + 1;
                    continue;
                }
                if (j == n) {
                    no_angle = True;
                }
            } else if (ch == "[" && i > literal_end && word.val() && word_last == "@") {
                # a domain literal is part of the address
                int j = i;
                string literal = "";
                for (; j < n && c[j] != "]" && !Message::isSpace(c[j]); ++j) {
                    literal += c[j];
                }
                if (j < n && c[j] == "]") {
                    word += literal + "]";
                    word_last = "]";
                    i = j + 1;
                    continue;
                }
                literal_end = j;
            }
            if (AddrSpecials{ch}) {
                Message::addAddressWord(\words, \word, decode);
                words += {"t": "lit", "s": ch};
            } else {
                word += ch;
                word_last = ch;
            }
            ++i;
        }
        Message::addAddressWord(\words, \word, decode);

        # encoded words separated by white space are one encoded word; the white space between two encoded words of
        # a parsed header ("dec") is not text (RFC 2047 section 6.2), so it is not added, and a value that is parsed
        # and written again is the same
        list<hash<auto>> merged = ();
        # True for a word of merged that ends with an encoded word of a parsed header
        list<bool> merged_dec = ();
        foreach hash<auto> w in (words) {
            int k = merged.size();
            bool dec = w.dec ?? False;
            if (w.t == "enc" && k >= 2 && merged[k - 1].t == "ws" && merged[k - 2].t == "enc") {
                merged[k - 2].s += (merged_dec[k - 2] && dec ? "" : " ") + w.s;
                merged_dec[k - 2] = dec;
                pop merged;
                pop merged_dec;
                continue;
            }
            merged += w;
            merged_dec += dec;
        }

        string rv = "";
        int len = start;
        bool space;
        *hash<auto> prev;
        foreach hash<auto> w in (merged) {
            if (w.t == "ws") {
                space = True;
                continue;
            }
            string s = w.t == "enc" ? mime_encode_header_word_b(w.s, eol) : w.s;
            # an encoded word is separated from the words beside it by white space or a special
            if (prev && !space && (w.t == "enc" || prev.t == "enc")
                && !AddrSpecials{prev.s.substr(-1)} && !AddrSpecials{s.substr(0, 1)}) {
                space = True;
            }
            (int first, int last) = Message::getLineLengths(s, eol);
            if (space && rv.val()) {
                if ((len + 1 + first) > MaxHeaderLineLen) {
                    rv += eol + " ";
                    len = 1;
                } else {
                    rv += " ";
                    ++len;
                }
            }
            rv += s;
            len = s.find(eol) < 0 ? len + first : last;
            space = False;
            prev = w;
        }
        return rv;
    }

    # adds a word of an address header to the words to write: an address at its start is written as it is, and the
    # rest is text
    private static addAddressWord(reference<list<hash<auto>>> words, reference<string> word, bool decode) {
        if (!word.val()) {
            return;
        }
        *list<*string> m = AddrWordRx.extractGroups(word);
        if (m) {
            # format characters before the address are text
            string prefix = m[0] ?? "";
            Message::addAddressText(\words, prefix, decode);
            words += {"t": "lit", "s": m[1]};
            # the offset is in characters
            Message::addAddressText(\words, word.substr(prefix.length() + m[1].length()), decode);
        } else {
            Message::addAddressText(\words, word, decode);
        }
        word = "";
    }

    # adds text of an address header to the words to write: printable ASCII text is written as it is, other text
    # is encoded; an encoded word of a parsed header is decoded to be encoded again with the text beside it
    private static addAddressText(reference<list<hash<auto>>> words, string text, bool decode) {
        if (!text.val()) {
            return;
        }
        if (decode && EncodedWordRx.match(text)) {
            words += {"t": "enc", "s": mime_decode_header(text), "dec": True};
        } else if (text.isDataPrintableAscii()) {
            words += {"t": "lit", "s": text};
        } else {
            words += {"t": "enc", "s": text};
        }
    }
    #! @endcond

    #! add a recipient to the Message's recipient list
    /** @param recipient the email address to send the message to; an address with a display name, or several
        addresses (a list of mailboxes or a group, ex: <tt>a\@x.com, Ann \<b\@y.com\></tt>), each of which is a
        recipient (see @ref getRecipients())
        @return the list of "To:" addresses

        @throw MESSAGE-ADDTO-ERROR the recipient's email address is invalid

        @note The value is parsed as a list of addresses: every address in it outside quoted strings and comments
        is a recipient.  A display name that comes from an untrusted source must therefore not be written into the
        value as it is (ex: with <tt>sprintf("%s <%s>", name, addr)</tt>, the name <tt>"attacker\@evil.com,"</tt>
        makes <tt>attacker\@evil.com</tt> a recipient too); use @ref addTO(string, string) "addTO(string, string)",
        which quotes the name.  If an address of a value cannot be sent in an SMTP command (an address with a
        quoted local part with white space, a \c "<" or a \c ">"), the whole message is refused by
        @ref SmtpClient::SmtpClient::sendMessage() "SmtpClient::sendMessage()" with \c MESSAGE-ERROR; it is not
        sent to the other addresses either
    */
    list<string> addTO(string recipient) {
        if (!Message::checkEmailAddress(recipient))
            throw "MESSAGE-ADDTO-ERROR", sprintf("cannot determine email address in %y", recipient);

        to_raw += NOTHING;
        return to += recipient;
    }

    #! add a recipient to the Message's cc list
    /** @param recipient the email address to send the message to (cc); an address with a display name, or several
        addresses (a list of mailboxes or a group, ex: <tt>a\@x.com, Ann \<b\@y.com\></tt>), each of which is a
        recipient (see @ref getRecipients())
        @return the list of "CC:" addresses

        @throw MESSAGE-ADDCC-ERROR the recipient's email address is invalid

        @note The value is parsed as a list of addresses: every address in it outside quoted strings and comments
        is a recipient.  A display name that comes from an untrusted source must therefore not be written into the
        value as it is (ex: with <tt>sprintf("%s <%s>", name, addr)</tt>, the name <tt>"attacker\@evil.com,"</tt>
        makes <tt>attacker\@evil.com</tt> a recipient too); use @ref addCC(string, string) "addCC(string, string)",
        which quotes the name.  If an address of a value cannot be sent in an SMTP command (an address with a
        quoted local part with white space, a \c "<" or a \c ">"), the whole message is refused by
        @ref SmtpClient::SmtpClient::sendMessage() "SmtpClient::sendMessage()" with \c MESSAGE-ERROR; it is not
        sent to the other addresses either
    */
    list<string> addCC(string recipient) {
        if (!Message::checkEmailAddress(recipient))
            throw "MESSAGE-ADDCC-ERROR", sprintf("cannot determine email address in %y", recipient);

        cc_raw += NOTHING;
        return cc += recipient;
    }

    #! add a recipient to the Message's bcc list
    /** @param recipient the email address to send the message to (bcc); an address with a display name, or several
        addresses (a list of mailboxes or a group, ex: <tt>a\@x.com, Ann \<b\@y.com\></tt>), each of which is a
        recipient (see @ref getRecipients())
        @return the list of "BCC:" addresses

        @throw MESSAGE-ADDBCC-ERROR the recipient's email address is invalid

        @note The value is parsed as a list of addresses: every address in it outside quoted strings and comments
        is a recipient.  A display name that comes from an untrusted source must therefore not be written into the
        value as it is (ex: with <tt>sprintf("%s <%s>", name, addr)</tt>, the name <tt>"attacker\@evil.com,"</tt>
        makes <tt>attacker\@evil.com</tt> a recipient too); use @ref addBCC(string, string) "addBCC(string, string)",
        which quotes the name.  If an address of a value cannot be sent in an SMTP command (an address with a
        quoted local part with white space, a \c "<" or a \c ">"), the whole message is refused by
        @ref SmtpClient::SmtpClient::sendMessage() "SmtpClient::sendMessage()" with \c MESSAGE-ERROR; it is not
        sent to the other addresses either
    */
    list<string> addBCC(string recipient) {
        if (!Message::checkEmailAddress(recipient))
            throw "MESSAGE-ADDBCC-ERROR", sprintf("cannot determine email address in %y", recipient);

        bcc_raw += NOTHING;
        return bcc += recipient;
    }

    #! adds a recipient with a display name and an email address
    /** @param name the display name, which can have any characters (ex: a name from an untrusted source): it is
        written as a quoted string, so that it cannot add a recipient; an empty name adds the address alone
        @param address the email address, which must be an address alone (an RFC 5322 \c addr-spec, ex:
        <tt>j\@x.com</tt>)
        @return the list of "To:" addresses

        @throw MESSAGE-ADDTO-ERROR the email address is not an address alone

        @par Example:
        @code{.py}
msg.addTO(untrusted_name, "j@x.com");
        @endcode

        @since MailMessage 1.5.1
    */
    list<string> addTO(string name, string address) {
        return addTO(Message::makeMailbox(name, address, "MESSAGE-ADDTO-ERROR"));
    }

    #! adds a recipient (cc) with a display name and an email address
    /** @param name the display name, which can have any characters (ex: a name from an untrusted source): it is
        written as a quoted string, so that it cannot add a recipient; an empty name adds the address alone
        @param address the email address, which must be an address alone (an RFC 5322 \c addr-spec, ex:
        <tt>j\@x.com</tt>)
        @return the list of "CC:" addresses

        @throw MESSAGE-ADDCC-ERROR the email address is not an address alone

        @par Example:
        @code{.py}
msg.addCC(untrusted_name, "j@x.com");
        @endcode

        @since MailMessage 1.5.1
    */
    list<string> addCC(string name, string address) {
        return addCC(Message::makeMailbox(name, address, "MESSAGE-ADDCC-ERROR"));
    }

    #! adds a recipient (bcc) with a display name and an email address
    /** @param name the display name, which can have any characters (ex: a name from an untrusted source): it is
        written as a quoted string, so that it cannot add a recipient; an empty name adds the address alone
        @param address the email address, which must be an address alone (an RFC 5322 \c addr-spec, ex:
        <tt>j\@x.com</tt>)
        @return the list of "BCC:" addresses

        @throw MESSAGE-ADDBCC-ERROR the email address is not an address alone

        @par Example:
        @code{.py}
msg.addBCC(untrusted_name, "j@x.com");
        @endcode

        @since MailMessage 1.5.1
    */
    list<string> addBCC(string name, string address) {
        return addBCC(Message::makeMailbox(name, address, "MESSAGE-ADDBCC-ERROR"));
    }

    #! @cond nodoc
    # returns a mailbox with the name as a quoted string, which cannot have a separator or an address outside
    # quotes; the address must be an addr-spec
    private static string makeMailbox(string name, string address, string err) {
        string addr = Message::trimSpace(address);
        if (!Message::isAddrSpec(addr)) {
            throw err, sprintf("%y is not an email address", address);
        }
        if (!name.val()) {
            return addr;
        }
        return sprintf("\"%s\" <%s>", replace(replace(name, "\\", "\\\\"), "\"", "\\\""), addr);
    }
    #! @endcond

    #! returns the sender's address in display format
    /** @return the sender's address in display format: for a message created to be sent, the display name and the
        email address (ex: \c "Qorus Cloud <notifications@mail.qorus.cloud>"), with the name as a quoted string if it
        has characters that a display name cannot have outside quotes (RFC 5322 \c specials, ex:
        <tt>"Doe, John" \<john@example.com\></tt>), or the email address alone if the sender has no display name; for
        a parsed message, the decoded \c From header.  The value is not encoded, so it must not be written as it is
        into a header: it can have non-ASCII characters and line breaks; @ref getHeaderString() encodes it.  Use
        @ref getFrom() for the email address alone.

        @since MailMessage 1.5.1 a message created to be sent returns the display name with the address; it returned
        the email address alone
    */
    *string getSender() {
        return from;
    }

    #! returns the sender's email address
    /** @return the sender's email address alone; this is the sender of the SMTP envelope (the \c MAIL \c FROM
        command); use @ref getSender() for the sender in display format
    */
    *string getFrom() {
        return sender;
    }

    #! returns the list of "To:" addresses
    /** @return the entries of the \c To header, as they were added or parsed; an entry can have several
        addresses (a list of mailboxes or a group); @ref getRecipients() returns the email addresses
    */
    list<string> getTO() {
        return to;
    }

    #! returns the list of "CC:" addresses
    /** @return the entries of the \c CC header, as they were added or parsed; an entry can have several
        addresses (a list of mailboxes or a group); @ref getRecipients() returns the email addresses
    */
    list<string> getCC() {
        return cc;
    }

    #! returns the list of "BCC:" addresses
    /** @return the entries of the \c BCC header, as they were added or parsed; an entry can have several
        addresses (a list of mailboxes or a group); @ref getRecipients() returns the email addresses
    */
    list<string> getBCC() {
        return bcc;
    }

    #! returns the subject of the Message
    string getSubject() {
        return subject;
    }

    #! return all the email addresses the message will be sent to, a combination of the "To:", "CC:", and "BCC:" lists
    /** @return the email addresses of the recipients, the recipients of the SMTP envelope: every address of every
        \c To, \c CC and \c BCC entry, which can be a list of mailboxes or a group (see @ref getEmailAddresses()), in
        order, without duplicates; addresses that differ only in the case of their domain are the same address (the
        case of the local part is kept: it can be significant).  The addresses of a recipient of a parsed message
        are taken from the raw header, before its encoded words are decoded.

        @since MailMessage 1.5.1 the address of a recipient of a parsed message is taken from the raw header, and
        every address of an entry with several addresses is returned (only the first was:
        <a href="https://github.com/qoretechnologies/qore/issues/6134">issue 6134</a>)
    */
    list<string> getRecipients() {
        list<string> rv = ();
        hash<string, bool> seen = {};
        foreach hash<auto> i in ({"l": to, "r": to_raw}, {"l": cc, "r": cc_raw}, {"l": bcc, "r": bcc_raw}) {
            foreach string v in (i.l) {
                foreach string addr in (Message::getEmailAddresses(i.r[$#] ?? v)) {
                    string key = Message::getAddressKey(addr);
                    if (!seen{key}) {
                        seen{key} = True;
                        rv += addr;
                    }
                }
            }
        }
        return rv;
    }

    #! @cond nodoc
    # returns the address with its domain in lower case, to compare addresses: the domain is not case-sensitive,
    # but the local part can be (RFC 5321 section 2.4); a quoted local part that needs no quotes is written without
    # them (RFC 5321 section 4.1.2: "a"@x.com is a@x.com)
    private static string getAddressKey(string addr) {
        int i = addr.substr(-1) == "]" ? addr.rfind("@[") : addr.rfind("@");
        if (i < 0) {
            return addr;
        }
        string local = addr.substr(0, i);
        if (local.size() > 2 && local.substr(0, 1) == "\"" && local.substr(-1) == "\"") {
            string inner = local.substr(1, -1);
            inner =~ s/\\(.)/$1/gs;
            if (DotAtomRx.match(inner)) {
                local = inner;
            }
        }
        return local + addr.substr(i).lwr();
    }
    #! @endcond

    #! returns @ref True "True" if the message can be sent, @ref False "False" if not
    /** To be able to send a message, there must be at least one recipient in the "To:" or the "CC:" or the "BCC:" lists
        and there must be a message body

        @return @ref True "True" if the message can be sent, @ref False "False" if not

        @see checkSendPossible()
    */
    bool sendPossible() {
        if (to.empty() && cc.empty() && bcc.empty())
            return False;

        return body.empty() ? False : True;
    }

    #! throws a \c MESSAGE-ERROR exception if the Message cannot be sent
    /** To be able to send a message, there must be at least one recipient in the "To:" or the "CC:" or the "BCC:" lists
        and there must be a message body

        @see sendPossible()

        @throw MESSAGE-ERROR the message is incomplete and cannot be sent
    */
    checkSendPossible() {
        if (!to && !cc && !bcc)
            throw "MESSAGE-ERROR", "the Message cannot be sent because there is no target address (To, Cc, and Bcc are all empty)";

        if (!body)
            throw "MESSAGE-ERROR", "the Message cannot be sent because there is no message body set";
    }

    #! sets or replaces the Message body
    /** @param body the Message body to set
        @param enc the encoding type for the message (see @ref MessageEncodings for possible values)
        @param content_type the Content-Type for the message body, if any

        @throw UNKNOWN-ENCODING the message encoding value passed is unknown/unimplemented
    */
    setBody(data body, string enc = ContentEncoding::Default, *string content_type) {
        bodyEncoding = Message::checkEncoding(body, enc, True);
        if (content_type)
            bodyContentType = content_type;
        self.body = body;
    }

    #! concatenates a string to the message body
    /** @param str the string to concatenate to the Message body

        @throw BODY-ERROR cannot concatenate a string to a binary body
    */
    addBody(string str) {
        if (body.typeCode() == NT_BINARY)
            throw "BODY-ERROR", sprintf("cannot concatenate a string to a binary body");
        # issue #2360 check if encoding is set
        if (bodyEncoding == ContentEncoding::Default)
            bodyEncoding = ContentEncoding::QuotedPrintable;

        body += str;
    }

    #! concatenates a binary object to the message body
    /** @param bin the binary object to concatenate to the Message body

        @throw BODY-ERROR cannot concatenate a binary object to a string body
    */
    addBody(binary bin) {
        if (body.typeCode() == NT_STRING)
            throw "BODY-ERROR", sprintf("cannot concatenate a binary object to a string body");
        # issue #2360 check if encoding is set
        if (bodyEncoding == ContentEncoding::Default)
            bodyEncoding = ContentEncoding::Base64;
        body += bin;
    }

    #! returns the Message body
    *data getBody() {
        return body;
    }

    #! returns the transfer encoding for the mssage body (see @ref MessageEncodings for possible values)
    string getBodyTransferEncoding() {
        return bodyEncoding;
    }

    #! parses the given string representing a header line and returns a single key - value hash for the header
    /** @param hdr a string representing a single line in a Message header
        @param decode decode any Q or B encoded header words (<a href="http://tools.ietf.org/html/rfc2047">RFC 2047</a>)

        @return a single key - value hash for the header

        @throw HEADER-ERROR no ':' separator character found in header, no key or value found
    */
    static hash parseHeader(string hdr, bool decode = True) {
        trim hdr;
        int i = hdr.find(":");
        if (i == -1)
            throw "HEADER-ERROR", sprintf("no ':' separator character found in header: %y", hdr);
        if (!i)
            throw "HEADER-ERROR", sprintf("no header name found in header: %y", hdr);
        if (i == (hdr.size() - 1))
            throw "HEADER-ERROR", sprintf("no header value found in header: %y", hdr);

        string val = trim(hdr.substr(i + 1));
        if (decode)
            val = mime_decode_header(val);
        hash rv.(hdr.substr(0, i)) = val;
        return rv;
    }

    #! sets/replaces the Message headers
    /** @param hdr a single string giving a single Message header to set (replaces all message headers with the given string)

        @throw HEADER-ERROR no ':' separator character found in header string

        @note headers for importance, delivery receipt and read receipt will be added automatically and should not be included here
    */
    setHeader(string hdr) {
        headers = parseHeader(hdr, False);
    }

    #! sets/replaces the list of Message headers from a list of header strings
    /** @param hdrs a list of Message header strings to set (replaces all message headers with the given list of strings)

        @throw HEADER-ERROR no ':' separator character found in header string

        @note headers for importance, delivery receipt and read receipt will be added automatically and should not be included here
        */
    setHeader(list hdrs) {
        headers = {};
        map headers += parseHeader($1, False), hdrs;
    }

    #! sets/replaces the list of Message headers from a hash of header info
    /** @param hdrs a hash of Message headers to set (replaces all message headers with the given hash)

        @note headers for importance, delivery receipt and read receipt will be added automatically and should not be included here
    */
    setHeader(hash hdrs) {
        headers = hdrs;
    }

    #! adds a header to the Message
    /** @param hdr a header to add to the Message

        @note headers for importance, delivery receipt and read receipt will be added automatically and should not be included here
    */
    addHeader(string hdr) {
        headers += parseHeader(hdr, False);
    }

    #! adds a list of headers to the Message
    /** @param hdrs a list of headers to add to the Message

        @note headers for importance, delivery receipt and read receipt will be added automatically and should not be included here
    */
    addHeader(list<auto> hdrs) {
        headers += map parseHeader($1, False), hdrs;
    }

    #! adds a hash of headers to the Message
    /** @param hdrs a hash of headers to add to the Message

        @note headers for importance, delivery receipt and read receipt will be added automatically and should not be included here
    */
    addHeader(hash<auto> hdrs) {
        headers += hdrs;
    }

    #! returns the current Message headers as a list of strings
    softlist getHeader() {
        return map sprintf("%s: %s", $1, headers.$1), keys headers;
    }

    #! returns the current Message headers as a hash
    *hash<auto> getHeaders() {
        return headers;
    }

    #! returns the current importance setting
    /** if this is @ref True "True", then the following headers will be sent:
        - \c Importance: high
        - \c X-Priority: 1
        - \c Priority: Urgent
    */
    bool important() {
        return importance;
    }

    #! sets the importance setting
    /** if this is @ref True "True", then the following headers will be sent:
        - \c Importance: high
        - \c X-Priority: 1
        - \c Priority: Urgent
    */
    important(softbool i) {
        importance = i;
    }

    #! returns the current read delivery receipt setting
    /** if this is @ref True "True", then the following header will be sent:
        - \c Return-Receipt-To: the sender in display format (see @ref getSender())
    */
    bool receiptRead() {
        return deliveryReceipt;
    }

    #! sets the read delivery receipt setting
    /** if this is @ref True "True", then the following header will be sent:
        - \c Return-Receipt-To: the sender in display format (see @ref getSender())
    */
    receiptRead(bool arg) {
        deliveryReceipt = arg;
    }

    #! returns the delivery receipt setting
    /** if this is @ref True "True", then the following header will be sent:
        - \c Disposition-Notification-To: the sender in display format (see @ref getSender())
    */
    bool receiptDelivery() {
        return readReceipt;
    }

    #! sets the delivery receipt setting
    /** if this is @ref True "True", then the following header will be sent:
        - \c Disposition-Notification-To: the sender in display format (see @ref getSender())
    */
    receiptDelivery(bool arg) {
        readReceipt = arg;
    }

    #! creates an attachment for the Message
    /** @param name the name of the attachment to be displayed in the message, normally a file name without any path
        @param mime the mime type for the message
        @param att the attachment itself
        @param enc the encoding type for the message (see @ref MessageEncodings for possible values)
        @param hdr optional headers for the MIME part for the attachment

        @throw UNKNOWN-ENCODING the message encoding value passed is unknown/unimplemented
        @throw INVALID-ENCODING the encoding given cannot be used with data given
    */
    attach(string name, string mime, data att, string enc = ContentEncoding::Base64, *hash<auto> hdr) {
        attachments += new MailMessage::Attachment(name, mime, att, enc, hdr);
    }

    #! adds an Attachment to the Message
    /** @param att the Attachment to add to the Message
    */
    attach(Attachment att) {
        attachments += att;
    }

    #! creates an inline attachment for the Message with a Content-ID
    /** Use this method to attach images or other content that will be referenced in HTML email bodies
        using the \c "cid:" URL scheme.

        @param name the name of the attachment to be displayed in the message, normally a file name without any path
        @param mime the mime type for the message (e.g., \c MimeTypePng, \c MimeTypeJpeg)
        @param att the attachment data itself
        @param content_id the Content-ID for the attachment (without angle brackets); this ID is used to reference
        the attachment in the HTML body as \c "cid:content_id"
        @param enc the encoding type for the message (see @ref MessageEncodings for possible values)
        @param hdr optional additional headers for the MIME part for the attachment

        @par Example:
        @code{.py}
Message msg("sender@example.com", "HTML Email with Image");
msg.addTO("recipient@example.com");
msg.setBody("<html><body><img src=\"cid:logo123\"></body></html>", ContentEncoding::QuotedPrintable, MimeTypeHtml);
msg.attachInline("logo.png", MimeTypePng, logo_data, "logo123");
        @endcode

        @throw UNKNOWN-ENCODING the message encoding value passed is unknown/unimplemented
        @throw INVALID-ENCODING the encoding given cannot be used with data given

        @since MailMessage 1.5
    */
    attachInline(string name, string mime, data att, string content_id, string enc = ContentEncoding::Base64, *hash<auto> hdr) {
        attachments += new MailMessage::Attachment(name, mime, att, enc, hdr, content_id);
    }

    #! returns a list of Attachment objects for the Message
    list<Attachment> getAttachments() {
        return attachments;
    }

    #! returns a list of non-attachment Part objects for the Message
    /** these could represent alternative representations of the message body, for example
*/
    list<Part> getParts() {
        return parts;
    }

    #! encodes a header value according to the parameters
    /** @param hdr the header to encode (ex: \c "Subject")
        @param val the value to encode
        @param eol the End-Of-Line marker for the string
        @param encode encode values that are not printable ASCII, including values with CR or LF characters, with
        quoted printable encoding (http://tools.ietf.org/html/rfc2047), so that a value cannot end the header line

        @return a header string (ex: \c "Subject: =?UTF-8?Q?testing?=\r\n")

        @throw HEADER-ERROR the header name contains a NUL, CR or LF character, or \a encode is @ref False and the
        value contains one; such a character would end the header line and start another header (header injection);
        or \a encode is @ref False and the value contains another control character than horizontal tab

        @since MailMessage 1.5.1 a header name with a NUL, CR or LF character, or such a value that is not encoded,
        raises \c HEADER-ERROR, and so does a value that is not encoded with another control character than
        horizontal tab; an encoded value is folded with \a eol
    */
    static string doHeaderValue(string hdr, string val, string eol = "\r\n", bool encode = True) {
        check_line_text(hdr, "message header name", "HEADER-ERROR");
        if (encode) {
            # a value with a control character is not printable ASCII, so a CR or LF is encoded with the rest
            if (!val.isDataPrintableAscii()) {
                val = mime_encode_header_word_q(val, eol);
            }
        } else {
            check_line_text(val, sprintf("message header %y value", hdr), "HEADER-ERROR");
            # no other control character than horizontal tab can be in a header value (RFC 5322 section 2.2)
            *string c = (val =~ x/([\x01-\x08\x0b\x0c\x0e-\x1f\x7f])/)[0];
            if (c) {
                throw "HEADER-ERROR", sprintf("message header %y value %y contains a control character (\\x%02x); "
                    "a header value that is not encoded cannot contain control characters other than horizontal tab",
                    hdr, val, ord(c));
            }
        }
        return sprintf("%s: %s%s", hdr, val, eol);
    }

    #! returns a string of the message headers
    /** If the message has a MIME structure (a body with a content transfer encoding, alternative parts or
        attachments), its MIME headers are generated, and \c MIME-Version, \c Content-Type and
        \c Content-Transfer-Encoding headers given or parsed with the message are not written; a \c Content-Type
        header given for the message is then the type of the body unless a type is set for the body.  The multipart
        MIME headers of a message with alternative parts or attachments are not included.

        The \c From header (and the \c Return-Receipt-To and \c Disposition-Notification-To headers) has the sender
        in display format (see @ref getSender()).  For a message created to be sent, a display name that is not
        printable ASCII is encoded as an <a href="http://tools.ietf.org/html/rfc2047">RFC 2047</a> \c "B" encoded
        word when \a encode is @ref True "True", and the email address is never encoded.

        The \c To, \c CC and \c BCC headers, and the \c From header of a parsed message or of a message created
        with no display name, are written with their addresses as they are when \a encode is @ref True "True":
        only their other text that is not printable ASCII (display names, comments, group names) is encoded as
        \c "B" encoded words, and a list of mailboxes is folded between mailboxes so that its lines are at most 76
        characters long.  A header of a parsed message is written as it was parsed if it is printable ASCII.  The
        address that a header gives (see @ref getEmailAddress()) is the address that its value gives, so that a
        message that is parsed again is sent to the same addresses.

        @param eol the End-Of-Line marker for the string, also used to fold long headers
        @param encode encode non-ASCII values with RFC 2047 encoded words (http://tools.ietf.org/html/rfc2047)

        @return a string with all the message headers separated by the EOL marker

        @since MailMessage 1.5.1 the message is not changed: a \c Content-Type header was removed or taken as the
        type of the body; the \c From header has the display name of the sender, and only the display name is
        encoded; only the text of the address headers is encoded, never their addresses, and encoded words are
        folded with \a eol
    */
    string getHeaderString(string eol = "\r\n", bool encode = True) {
        string hdr = doSenderHeader("From", eol, encode);

        # To:
        foreach string l in (to)
            hdr += Message::doAddressHeader("To", l, to_raw[$#], eol, encode);

        # CC:
        foreach string l in (cc)
            hdr += Message::doAddressHeader("CC", l, cc_raw[$#], eol, encode);

        # BCC:
        foreach string l in (bcc)
            hdr += Message::doAddressHeader("BCC", l, bcc_raw[$#], eol, encode);

        # add the subject - use "QP" encoding to ensure correct transmission & display of special characters through all SMTP servers
        hdr += Message::doHeaderValue("Subject", subject, eol, encode);

        # importance
        if (importance)
            hdr += sprintf("Importance: high%sX-Priority: 1%sPriority: Urgent%s", eol, eol, eol);

        if (deliveryReceipt)
            hdr += doSenderHeader("Return-Receipt-To", eol, encode);

        if (readReceipt)
            hdr += doSenderHeader("Disposition-Notification-To", eol, encode);

        # the MIME headers are generated if the message has a MIME structure (a body with a content transfer encoding,
        # alternative parts or attachments); MIME headers given or parsed with the message are then not written,
        # since a parsed message had them twice (a Content-Type header given for the message is the type of the body,
        # unless a type is set for the body)
        bool mime = attachments || parts || bodyEncoding != ContentEncoding::None;

        # additional headers
        foreach string k in (keys headers) {
            if (mime && MimeHeaders{k.lwr()}) {
                continue;
            }
            hdr += Message::doHeaderValue(k, headers{k}, eol, encode);
        }

        # include MIME headers for msg body if necessary
        if (!attachments && !parts && bodyEncoding != ContentEncoding::None) {
            hdr += Message::doHeaderValue("MIME-Version", "1.0", eol, encode);
            *string ct = getBodyContentTypeIntern();
            if (ct) {
                hdr += Message::doHeaderValue("Content-Type", ct, eol, encode);
            }
            hdr += Message::doHeaderValue("Content-Transfer-Encoding", bodyEncoding, eol, encode);
        }

        return hdr;
    }

    #! returns a multi-line string representing the Message
    /** @param include_body if @ref True "True" the Message body will be included in the string output
    */
    string toString(bool include_body = False) {
        list<string> attarr();
        foreach Attachment att in (attachments)
            attarr += sprintf("%s (%s,%d)", att.getName(), att.getMime(), att.getData().size());

        # sending envelope: from, to, subject
        list<string> env = getEnvelopeList();

        # the main string
        string str = sprintf("Message (%s)\n", sendPossible() ? "ok": "unfinished");

        # from/to/subject
        foreach string l in (env)
            str += "  " + trim(l) + "\n";

        # important or not...
        str += sprintf("%s%s%s",
                        important() ? "  Important\n": "",
                        receiptDelivery() ? "  ReceiptDelivery\n": "",
                        receiptRead() ? "  ReceiptRead\n": "");

        # add headers
        map str += sprintf("  %s: %s\n", $1, headers.$1), keys headers;

        # add attachments
        if (!attarr.empty()) {
            str += "  Attachments:\n";
            foreach string l in (attarr) {
                str += "    " + trim(l) + "\n";
            }
        }

        # the user wants to see the body also...
        if (include_body) {
            str += "--\n";
            if (body.empty())
                str += "<empty message body>";
            else if (body.typeCode() == NT_STRING)
                str += trim(body);
            else
                str += sprintf("<binary body: %d bytes>", body.size());

            str += "\n";
        }

        return str;
    }

    #! returns a single line string summarizing the Message
    /** @return a single line string summarizing the Message
    */
    string toLine() {
        # sending envelope: from, to, subject
        list<string> env = getEnvelopeList();

        # the main string
        string str = sprintf("[Message (%s), %s, %simportant, %sdelivery, %sread",
                        sendPossible()? "ok": "unfinished",
                        join(", ", env),
                        important()? "": "not ",
                        receiptDelivery()? "": "not ",
                        receiptRead()? "": "not "
            );

        # add headers
        if (headers.val())
            str += sprintf(", %s", join(", ", (map sprintf("%s: %s", $1, headers.$1), headers.keyIterator())));

        # attachments
        foreach Attachment att in (attachments)
            str += sprintf(", %s (%s,%d)", att.getName(), att.getMime(), att.getData().size());

        str += "]";

        return str;
    }

    #! checks the data against the encoding and returns the new encoding (if the encoding is @ref ContentEncoding::Default for example)
    /** @param data the data to be encoded
        @param enc the encoding type for the data (see @ref MessageEncodings for possible values)
        @param noneok if this argument is True, then @ref ContentEncoding::None may be given as an argument

        @return the new encoding to use in case the input data was @ref ContentEncoding::Default

        @throw UNKNOWN-ENCODING the message encoding value passed is unknown/unimplemented
        @throw INVALID-ENCODING the encoding given cannot be used with data given
    */
    static string checkEncoding(data data, string enc, bool noneok = False) {
        if (enc == ContentEncoding::Default) {
            # issue #3275: if the data has a line with a single dot, then encode it with base64 encoding
            if (data.typeCode() == NT_STRING) {
                if (data =~ /^.\r?$/m) {
                    enc = ContentEncoding::Base64;
                } else {
                    enc = ContentEncoding::QuotedPrintable;
                }
            } else {
                enc = ContentEncoding::Base64;
            }
        }
        else if (!noneok && enc == ContentEncoding::None)
            throw "INVALID-ENCODING", "\"none\" may not be used; a valid encoding is required in this context";
        else if (!inlist(enc, Encodings))
            throw "UNKNOWN-ENCODING", sprintf("%y is not a known encoding; known encodings: %y", enc, Encodings);
        else if (data.typeCode() == NT_BINARY && enc == ContentEncoding::None)
            throw "INVALID-ENCODING", sprintf("%y cannot be used with binary data", enc);

        return enc;
    }

    #! returns a string of message data according to the encoding passed
    /** @param data the data to encode
        @param enc the encoding type for the data (see @ref MessageEncodings for possible values)
        @param hdr a reference to a hash for header information

        @throw ENCODE-TRANSFER-DATA-ERROR unknown encoding passed
    */
    static string encodeTransferData(data data, string enc, reference<hash> hdr) {
        switch (enc) {
            case ContentEncoding::Base64: {
                hdr."Content-Transfer-Encoding" = enc;
                return mime_encode_base64(data, 72);
            }

            case ContentEncoding::None:
                return data;

            case ContentEncoding::QuotedPrintable: {
                hdr."Content-Transfer-Encoding" = enc;
                return mime_encode_quoted_printable(data);
            }
        }

        throw "ENCODE-TRANSFER-DATA-ERROR", sprintf("unknown Content-Transfer-Encoding: %y", enc);
    }

    #! returns a string of message data according to the encoding passed
    static string encodeData(data data, string mime, string disp, string enc) {
        string str = sprintf("Content-Type: %s\r\nContent-Disposition: %s\r\n", mime, disp);
        switch (enc) {
            case ContentEncoding::Base64: {
                str += "Content-Transfer-Encoding: base64\r\n\r\n";
                str += mime_encode_base64(data, 72);
                str += "\r\n";
                break;
            }
            case ContentEncoding::None: {
                str += "\r\n";
                str += data;
                str += "\r\n";
                break;
            }
            case ContentEncoding::QuotedPrintable: {
                str += sprintf("Content-Transfer-Encoding: quoted-printable\r\n\r\n");
                str += mime_encode_quoted_printable(data);
                str += "\r\n";
                break;
            }
        }

        return str;
    }

    #! returns the first \c "\r\n" terminated line from the argument, updates the byte position argument
    /** @param msg the text to process; the first line found will be removed from this argument as well
        @param pos the byte position to update
        @return the first \c "\r\n" terminated line from the argument

        @throw MESSAGE-PARSE-ERROR invalid message data
    */
    static string getLine(reference<string> msg, reference<int> pos) {
        int i = msg.find("\r\n");
        if (i == -1)
            throw "MESSAGE-PARSE-ERROR", sprintf("cannot find end of line in message at byte position %d", pos);

        pos += i + 2;
        # get header string
        string hdr = extract msg, 0, i;
        # remove \r\n
        splice msg, 0, 2;
        trim hdr;
        return hdr;
    }

    #! @cond nodoc
    private list<string> getEnvelopeList() {
        list<string> env = (sprintf("Sender: '%s'", from), sprintf("Subject: '%s'", subject));
        # add To addresses
        map env += sprintf("To: %s", $1), to;
        # add CC addresses
        map env += sprintf("CC: %s", $1), cc;
        # add BCC addresses
        map env += sprintf("BCC: %s", $1), bcc;
        return env;
    }
    #! @endcond
}

#! class representing a MIME part of a Message
/** this class wraps all the data for the Part, including:
    - the part's name if any is known or can be derived
    - the mime type of the Part (ex: @ref Mime::MimeTypeJpeg ie \c "image/jpeg")
    - the data for the Part; either binary object or as a string
    - the encoding type for the attachment
*/
public class Part {
    # no public members
    public {}

    private {
        string name;
        string mime;
        data part_data;
        #! content-transfer encoding
        string enc;
        # any extra headers for the message
        *hash<auto> headers;
        #! Content-ID for inline parts (without angle brackets)
        *string content_id;
    }

    # will only be called internally when parsing a Message
    constructor(string filename, string mimetype, data filedata, string encoding = ContentEncoding::Default, *hash<auto> hdr) {
        name = filename;
        mime = mimetype;
        part_data = filedata;
        enc = encoding;
        # += to keep "hash<auto>"
        headers += hdr;

        # Extract Content-ID from headers if present; header names are case-insensitive, and a repeated field
        # (a list) gives its first value
        foreach hash<auto> i in (hdr.pairIterator()) {
            if (i.key.lwr() == "content-id") {
                string cid = sprintf("%s", i.value.typeCode() == NT_LIST ? i.value[0] : i.value);
                if (cid.val()) {
                    # Remove angle brackets if present
                    content_id = (cid =~ x/<([^>]+)>/)[0] ?? cid;
                }
                break;
            }
        }
    }

    #! Returns information about the part
    hash<auto> getInfo() {
        return <PartInfo>{
            "name": name,
            "mime": mime,
            "part_data": getData(),
            "headers": getHeaders(),
            "transfer_encoding": getTransferEncoding(),
            "content_id": content_id,
            "size": getSize(),
        };
    }

    #! returns the name of the Part
    string getName() {
        return name;
    }

    #! returns the mime type of the Part
    string getMime() {
        return mime;
    }

    #! returns the data of the Part
    data getData() {
        return part_data;
    }

    #! returns the size of the Part data in bytes
    /** @return the size of the part data in bytes

        @since MailMessage 1.5
    */
    int getSize() {
        return part_data.size();
    }

    #! returns the transfer encoding of the Part
    string getTransferEncoding() {
        return enc;
    }

    #! returns any headers for the Part
    *hash<auto> getHeaders() {
        return headers;
    }

    #! returns the Content-ID if set
    /** @return the Content-ID without angle brackets, or @ref nothing if not set

        @since MailMessage 1.5
    */
    *string getContentId() {
        return content_id;
    }

    #! adds itself to a multipart/alternative message
    add(MultiPartAlternativeMessage mpa) {
            mpa.addEncodePart(part_data, enc, mime);
    }
}

#! class representing a MIME Attachment for the Message
/** this class wraps all the data for the attachment, including:
    - the attachment's name; ie the file name which will be shown
    - the mime type of the Attachment (ex: @ref Mime::MimeTypeJpeg ie \c "image/jpeg")
    - the data for the attachment; either binary object or as a string
    - the encoding type for the attachment

    @par Example:
    @code{.py}
File f();
f.open2("file.jpg");
Attachment att("file.jpg", MimeTypeJpeg, f.readBinary(-1));
f.close();
msg.attach(att);
    @endcode

    @par Example: Inline attachment with Content-ID:
    @code{.py}
File f();
f.open2("logo.png");
Attachment att("logo.png", MimeTypePng, f.readBinary(-1), ContentEncoding::Base64, NOTHING, "logo123");
f.close();
msg.attach(att);
# Reference in HTML body as: <img src="cid:logo123">
    @endcode
*/
public class Attachment inherits Part {
    # no public members
    public {}

    private {
        #! True if this is an inline attachment
        bool inline_attachment = False;

        #! the part headers generated for an attachment, in lower case; headers with these names given for the
        #! attachment are not added to its part
        const GeneratedPartHeaders = {
            "content-type": True,
            "content-disposition": True,
            "content-disposition-encoded": True,
            "content-transfer-encoding": True,
            "content-length": True,
            "content-id": True,
        };
    }

    #! creates an Attachment object for a Message object
    /** @param name the name of the attachment to be displayed in the message, normally a file name without any
        path
        @param mime the mime type for the message
        @param part_data the attachment data itself
        @param enc the encoding type for the message (see \c MessageEncodings for possible values)
        @param hdr optional headers for the MIME part for the attachment
        @param cid optional Content-ID for inline attachments (without angle brackets); use this for images
        embedded in HTML emails that are referenced as \c "cid:content-id"
        @param is_inline if @ref True, the attachment is treated as inline

        @throw UNKNOWN-ENCODING the message encoding value passed is unknown/unimplemented
        @throw INVALID-ENCODING the encoding given cannot be used with data given

        @note If \a cid is provided, the attachment will be treated as an inline attachment

        @since MailMessage 1.5: added \a cid parameter
        @since MailMessage 1.5: added \a is_inline parameter
    */
    constructor(string name, string mime, data part_data, string enc = ContentEncoding::Base64, *hash<auto> hdr,
            *string cid, bool is_inline = False)
            : Part(sanitize_filename(name), mime, part_data, enc, hdr) {
        self.enc = Message::checkEncoding(part_data, enc);
        if (cid.val()) {
            content_id = cid;
            inline_attachment = True;
        } else if (is_inline) {
            inline_attachment = True;
        }
    }

    #! Returns @ref True if this is an inline attachment
    /** @return @ref True if the attachment has a Content-ID and is meant to be displayed inline

        @since MailMessage 1.5
    */
    bool isInline() {
        return inline_attachment;
    }

    #! adds itself to a multipart/mixed message
    /** The headers given for the attachment are added to its MIME part, except the \c Content-Type,
        \c Content-Disposition, \c Content-Transfer-Encoding, \c Content-Length and \c Content-ID headers (in any
        case), which are generated from the attachment

        @throw PART-ERROR a header name or value contains a NUL, CR or LF character

        @since MailMessage 1.5.1 the headers given for the attachment are added to its MIME part; they were dropped
    */
    add(MultiPartMixedMessage mpm) {
        # Use RFC 2231 encoding for non-ASCII filenames
        string encoded_name = encode_mime_filename(name);
        bool use_rfc2231 = (encoded_name != name);

        # the headers given for the attachment (or parsed with it), without those generated for the part
        hash<auto> extra_hdr = {};
        foreach hash<auto> i in (headers.pairIterator()) {
            if (!GeneratedPartHeaders{i.key.lwr()}) {
                extra_hdr{i.key} = i.value;
            }
        }
        if (use_rfc2231) {
            # RFC 2231 encoded filename
            extra_hdr."Content-Type" = "";
            extra_hdr."Content-Disposition" = name;
            extra_hdr."Content-Disposition-Encoded" = encoded_name;
        } else {
            extra_hdr."Content-Type" = "";
            extra_hdr."Content-Disposition" = name;
        }

        # Add Content-ID for inline attachments
        if (content_id.val()) {
            extra_hdr."Content-ID" = sprintf("<%s>", content_id);
        }

        string disp = inline_attachment ? "inline" : "attachment";
        mpm.addEncodePart(part_data, enc, mime, disp, extra_hdr);
    }
}
}
