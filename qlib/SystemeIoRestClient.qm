# minimum qore version
%requires qore >= 2.0

# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module SystemeIoRestClient {
    version = "1.0";
    desc = "User module for calling Systeme.io REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("systemeio",
            SystemeIoRestConnection::ConnectionScheme);
    };
}

/** @mainpage SystemeIoRestClient Module

    @tableofcontents

    @section systemeiorestclientintro SystemeIoRestClient Introduction

    The %SystemeIoRestClient module provides an API for calling Systeme.io REST API services.

    To use this module, use \c "%requires SystemeIoRestClient" in your code.

    All the public symbols in the module are defined in the SystemeIoRestClient namespace.

    The main classes are:
    - @ref SystemeIoRestClient::SystemeIoRestClient "SystemeIoRestClient":
      this class provides the REST client API for communication with the Systeme.io API;
      it handles API key authentication
    - @ref SystemeIoRestClient::SystemeIoRestConnection "SystemeIoRestConnection":
      provides a connection object to Systeme.io services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @section systemeiorestclientrelnotes Release Notes

    @subsection systemeiorestclientv1_0 SystemeIoRestClient v1.0
    - the initial version of the %SystemeIoRestClient module
*/

#! the SystemeIoRestClient namespace contains all the objects in the SystemeIoRestClient module
public namespace SystemeIoRestClient {

#! Common base class for SystemeIoRestClient functionality
public class SystemeIoRestClientBase {
    public {
        #! Systeme.io API base URL
        const DefaultApiUrl = "https://api.systeme.io/api";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (lightweight endpoint, no leading slash since base URL has path)
        const DefaultPingPath = "tags";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default API path
        const DefaultApiPath = "/api";

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "default_path": DefaultApiPath,
            "headers": DefaultHeaders,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };

        #! Default connection URL
        const DefaultConnectionUrl = "systemeio://api.systeme.io/api";
    }

    #! returns options for the SystemeIoRestClient constructor
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Set URL
        if (!rv.url) {
            rv.url = DefaultApiUrl;
        }

        # Set API key authentication via X-API-Key header
        if (opts.apikey) {
            rv.headers."X-API-Key" = opts.apikey;
            remove rv.apikey;
        }

        return rv;
    }
}

#! This class provides the REST client API for communication with Systeme.io servers
/** Systeme.io uses a REST API at https://api.systeme.io/api with API key authentication
    via the \c X-API-Key header.

    @par Authentication:
    - API key via X-API-Key header
    - API key obtained from: Profile Settings > Public API keys in Systeme.io

    @par API Structure:
    - Base URL: https://api.systeme.io/api
    - Cursor-based pagination with \c startingAfter, \c limit, \c order parameters
    - PATCH updates use \c application/merge-patch+json content type

    @par Rate Limiting:
    Plan-based rate limits with headers:
    - \c X-RateLimit-Limit: maximum requests allowed
    - \c X-RateLimit-Remaining: remaining requests
    - \c X-RateLimit-Refill: when quota resets
    - HTTP 429 with \c Retry-After header when exceeded
*/
public class SystemeIoRestClient inherits RestClient::RestClient, SystemeIoRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
SystemeIoRestClient systemeio({"apikey": ENV.SYSTEMEIO_API_KEY});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient"
        class plus:
        - \c apikey: the Systeme.io API key

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(SystemeIoRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Systeme.io REST connections; returns @ref SystemeIoRestClient objects
public class SystemeIoRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Systeme.io REST Connection",
            "short_desc": "A connection to the Systeme.io REST API",
            "desc": "A connection to the Systeme.io REST API for managing contacts, tags, courses, "
                "communities, and subscriptions.\n\n"
                "Systeme.io is an all-in-one online marketing platform for building sales funnels, "
                "running email campaigns, managing courses and communities, and handling affiliate "
                "programs.\n\n"
                "**To obtain your API key:**\n"
                "1. Log in to your Systeme.io account\n"
                "2. Go to **Profile Settings**\n"
                "3. Navigate to the **Public API keys** section\n"
                "4. Click **Create** to generate a new key\n"
                "5. Copy the key immediately (it cannot be retrieved later)\n\n"
                "**Note:** Maximum 3 API keys per account. Keys are shared across all API "
                "integrations.",
            "cls": Class::forName("SystemeIoRestConnection"),
            "auto_url": True,
            "schemes": {
                "systemeio": True,
            },
            "base_scheme_map": {
                "https": "systemeio",
            },
            "required_options": "apikey",
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Systeme.io API key for authentication",
                    "type": "string",
                    "desc": "The Systeme.io API key used for authentication via the "
                        "`X-API-Key` header.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Systeme.io account\n"
                        "2. Go to **Profile Settings**\n"
                        "3. Navigate to the **Public API keys** section\n"
                        "4. Click **Create** to generate a new key\n"
                        "5. Copy the key immediately (it cannot be retrieved later)\n\n"
                        "**Important:** API keys are only visible immediately after creation. "
                        "If you lose a key, you must delete it and create a new one.",
                    "sensitive": True,
                    "preselected": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": SystemeIoRestClientBase::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": SystemeIoRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": SystemeIoRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": SystemeIoRestClientBase::DefaultPingPath,
                },
            },
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your API Key",
                    "intent": "info",
                    "content": "This integration requires a **Systeme.io API key**.\n\n"
                        "**Steps to generate an API key:**\n"
                        "1. Log in to your Systeme.io account\n"
                        "2. Go to **Profile Settings**\n"
                        "3. Navigate to the **Public API keys** section\n"
                        "4. Click **Create** and give the key a name\n"
                        "5. Copy the key immediately\n\n"
                        "**Important:**\n"
                        "- API keys are only shown once at creation time\n"
                        "- Maximum 3 API keys per account\n"
                        "- Rate limits are plan-based and shared across all keys",
                },
            ),
        };
    }

    #! creates the SystemeIoRestConnection object
    constructor(string name, string description,
            string url = SystemeIoRestClientBase::DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the SystemeIoRestConnection object
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(SystemeIoRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref SystemeIoRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": SystemeIoRestClientBase::DefaultConnectionUrl,
        };
    }

    #! returns \c "systemeio"
    string getType() {
        return "systemeio";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "SystemeIo";
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the SystemeIoDataProvider and creates
        # the data provider object dynamically
        load_module("SystemeIoDataProvider");
        return create_object("SystemeIoDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options && url != SystemeIoRestClientBase::DefaultConnectionUrl) {
            doUpdateOptions(self, {
                "url": SystemeIoRestClientBase::DefaultConnectionUrl,
            });
        }
    }

    #! returns a @ref SystemeIoRestClient object
    private SystemeIoRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new SystemeIoRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new SystemeIoRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Systeme.io REST API using multiplexed HTTP connections
public class SystemeIoRestClientIo inherits RestClientIo::RestClientIo, SystemeIoRestClientBase {
    #! Creates the object with the given options
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(SystemeIoRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
