# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module ConstantContactRestClient {
    version = "1.1";
    desc = "User module for calling Constant Contact REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("constantcontactres",
            ConstantContactRestConnection::ConnectionScheme);
    };
}

/** @mainpage ConstantContactRestClient Module

    @tableofcontents

    @section constantcontactrestclientintro ConstantContactRestClient Introduction

    The %ConstantContactRestClient module provides an API for calling Constant Contact REST API services.

    To use this module, use \c "%requires ConstantContactRestClient" in your code.

    All the public symbols in the module are defined in the ConstantContactRestClient namespace.

    The main classes are:
    - @ref ConstantContactRestClient::ConstantContactRestClient "ConstantContactRestClient":
      this class provides the REST client API for communication with the Constant Contact API;
      it handles OAuth2 authentication
    - @ref ConstantContactRestClient::ConstantContactRestConnection "ConstantContactRestConnection":
      provides a connection object to Constant Contact services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires ConstantContactRestClient

ConstantContactRestClient cc({
    "oauth2_client_id": ENV.CONSTANTCONTACT_CLIENT_ID,
    "oauth2_client_secret": ENV.CONSTANTCONTACT_CLIENT_SECRET,
    "oauth2_refresh_token": ENV.CONSTANTCONTACT_REFRESH_TOKEN,
});
hash<auto> result = cc.get("account/summary");
printf("Organization: %s\n", result.body.organization_name);
    @endcode

    @section constantcontactrestclientrelnotes Release Notes

    @subsection constantcontactrestclientv1_1 ConstantContactRestClient v1.1
    - added \c ConstantContactRestClientBase and \c ConstantContactRestClientIo classes for async I/O support

    @subsection constantcontactrestclientv1_0 ConstantContactRestClient v1.0
    - the initial version of the %ConstantContactRestClient module
*/

#! the ConstantContactRestClient namespace contains all the objects in the ConstantContactRestClient module
public namespace ConstantContactRestClient {

#! Common base class for ConstantContactRestClient functionality
/** Contains all constants and static methods shared between the sync and async REST clients.
*/
public class ConstantContactRestClientBase {
    public {
        #! Default Constant Contact API URL
        const DefaultUrl = "https://api.cc.email/v3";

        #! Default authorization request URL
        const DefaultAuthUrl = "https://authz.constantcontact.com/oauth2/default/v1/authorize";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default token request URL
        const DefaultTokenUrl = "https://authz.constantcontact.com/oauth2/default/v1/token";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since base URL has /v3)
        const DefaultPingPath = "account/summary";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OAuth2 scopes
        const DefaultScopes = (
            "account_read", "account_update",
            "contact_data", "campaign_data",
            "offline_access",
        );

        #! Default OAuth2 auth args to request offline access (refresh tokens)
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "default_path": "/v3",
            "headers": DefaultHeaders,
            "oauth2_auth_args": DefaultAuthArgs,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "protocol": "h1",
            "url": DefaultUrl,
        };

        #! OAuth2 options (added when OAuth2 credentials are provided)
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_scopes": DefaultScopes,
        };
    }

    #! returns options for the REST client constructors
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Check if apikey-only mode (apikey provided without OAuth2 credentials)
        bool apikey_only = opts.apikey && !opts.oauth2_client_id && !opts.oauth2_client_secret
            && !opts.oauth2_refresh_token;

        if (!apikey_only && opts.oauth2_client_id) {
            rv += OAuth2Options;
        } else if (opts.apikey) {
            # Bearer token mode using apikey
            rv.headers.Authorization = "Bearer " + opts.apikey;
            remove rv.apikey;
        }

        return rv;
    }
}

#! This class provides the REST client API for communication with Constant Contact servers
/** Constant Contact uses a REST API at https://api.cc.email/v3 with OAuth2 authentication.

    @par Authentication:
    - OAuth2 with Bearer tokens (Authorization Code flow)
    - Access tokens expire after 24 hours
    - Refresh tokens expire after 180 days if unused

    @par API Structure:
    All endpoints are under /v3/ (included in the base URL)
*/
public class ConstantContactRestClient inherits RestClient::RestClient, ConstantContactRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
ConstantContactRestClient cc({
    "oauth2_client_id": "your-client-id",
    "oauth2_client_secret": "your-client-secret",
    "oauth2_refresh_token": "your-refresh-token",
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(ConstantContactRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! REST client for Constant Contact REST API using multiplexed HTTP connections
/** @see ConstantContactRestClient for more information
*/
public class ConstantContactRestClientIo inherits RestClientIo::RestClientIo, ConstantContactRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(ConstantContactRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Constant Contact REST connections; returns @ref ConstantContactRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref ConstantContactRestClient::ConstantContactRestClient::constructor() for more information on the above
    options
*/
public class ConstantContactRestConnection inherits RestClient::RestConnection {
    public {
        #! Default connection URL
        const DefaultConnectionUrl = "constantcontactres://api.cc.email/v3";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Constant Contact REST Connection",
            "short_desc": "A connection to the Constant Contact REST API",
            "desc": "A connection to the Constant Contact REST API for email marketing, contacts, "
                "lists, campaigns, and segments",
            "cls": Class::forName("ConstantContactRestConnection"),
            "auto_url": True,
            "schemes": {
                "constantcontactres": True,
            },
            "base_scheme_map": {
                "https": "constantcontactres",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key / Access Token",
                    "short_desc": "A Constant Contact API key or access token for Bearer auth",
                    "type": "string",
                    "desc": "A Constant Contact API key or access token used for Bearer token "
                        "authentication as an alternative to OAuth2",
                    "sensitive": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultPingPath,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultScopes,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": ConstantContactRestClientBase::DefaultTokenUrl,
                },
            },
            "required_options": "oauth2_client_id,oauth2_client_secret",
        };
    }

    #! creates the ConstantContactRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = ConstantContactRestClientBase::DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the ConstantContactRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
    }

    #! returns \c "constantcontactres"
    string getType() {
        return "constantcontactres";
    }

    #! Returns connection options
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        # Always set OAuth2 URLs
        rv.oauth2_auth_url = ConstantContactRestClientBase::DefaultAuthUrl;
        rv.oauth2_token_url = ConstantContactRestClientBase::DefaultTokenUrl;
        rv.oauth2_grant_type = ConstantContactRestClientBase::DefaultGrantType;
        rv.oauth2_scopes = ConstantContactRestClientBase::DefaultScopes;
        rv.oauth2_auth_args = ConstantContactRestClientBase::DefaultAuthArgs;
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Constant Contact";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the ConstantContactDataProvider and creates the data
        # provider object dynamically
        load_module("ConstantContactDataProvider");
        return create_object("ConstantContactDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != DefaultConnectionUrl) {
                update.url = DefaultConnectionUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref ConstantContactRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref ConstantContactRestClient object
    */
    private ConstantContactRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new ConstantContactRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new ConstantContactRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
