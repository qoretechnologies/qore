    #! returns the current validator object
    /** @return the current validator object

        @since %RestClient 1.4
    */
    RestSchemaValidator::AbstractRestSchemaValidator getValidator() {
        return validator;
    }

    #! Sets a new REST schema validator
    /** @since %RestClient 2.0
    */
    setValidator(RestSchemaValidator::AbstractRestSchemaValidator validator) {
        self.validator = validator;
    }

    #! Returns True if the client is configured for authentication with OAuth2
    /** @since %RestClient 2.0
    */
    bool usingOAuth2() {
        return oauth2_grant_type.val() && oauth2_grant_type != "none";
    }

    #! Returns True if the client uses custom token authentication
    /** @since %RestClient 2.4
    */
    bool hasCustomTokenAuth() {
        return custom_token_auth.val();
    }

    #! Returns True if the client requires an OAuth2 token
    /** @since %RestClient 2.0
    */
    bool requiresOAuth2Token() {
        return oauth2_grant_type && oauth2_grant_type != "none" && !exists token;
    }

    #! Returns True if the client requires a tokenm refresh
    /** @since %RestClient 2.2
    */
    bool requiresRefresh() {
        return token.val() && (refresh_token.val() || custom_token_auth) && oauth2_token_expiry
            && ((now_us() - Oauth2TokenRefreshWindow) > oauth2_token_expiry);
    }

    #! Sets a token for authentication
    /** @since %RestClient 2.0
    */
    setToken(string token_type, string token, *string refresh_token, *date token_expiry) {
        if (token_type == "bearer") {
            token_type = "Bearer";
        }
        self.token_type = token_type;
        self.token = token;
        addDefaultHeaders({"Authorization": sprintf("%s %s", token_type, token)});
        if (refresh_token) {
            self.refresh_token = refresh_token;
        }
        if (token_expiry) {
            oauth2_token_expiry = token_expiry;
        } else if (oauth2_token_expiry_hint) {
            oauth2_token_expiry = now_us() + minutes(oauth2_token_expiry_hint);
        }
    }

    #! Returns the token type for any token
    /** @since %RestClient 2.0
    */
    string getTokenType() {
        return token_type ?? "Bearer";
    }

    #! Returns any token set for the connection
    /** @since %RestClient 2.0
    */
    *string getToken() {
        return token;
    }

    #! Starts an OAuth2 token request in a non-blocking I/O operation
    /** @since %RestClient 2.0
    */
    AbstractPollOperation startOAuth2PollSendRecv() {
        return startOAuth2AuthPoll(getOAuth2LoginInfo(oauth2_grant_type));
    }

    #! Starts a custom token refresh request in a non-blocking I/O operation
    /** @since %RestClient 2.3
    */
    AbstractPollOperation startPollCustomGetToken() {
        *hash<auto> auth_hdr;
        auto body = setupCustomGetToken(\auth_hdr);
        prepareMsg(custom_token_method, custom_token_path, \body, \auth_hdr);
        return startPollSendRecv(custom_token_method, custom_token_path, body, auth_hdr);
    }

    #! Starts an OAuth2 refresh token request in a non-blocking I/O operation
    /** @since %RestClient 2.0
    */
    AbstractPollOperation startOAuth2PollRefreshToken() {
        return refresh_token
            ? startOAuth2AuthPoll(getOAuth2RefreshInfo())
            : startOAuth2PollSendRecv();
    }

    #! sends an HTTP request to the REST server and returns the response
    /** @par Example:
        @code{.py}
hash<auto> ans = rest.doRequest("DELETE", "/orders/1");
        @endcode

        @param m the HTTP method to be used; case is ignored (if not a valid method an \c HTTP-CLIENT-METHOD-ERROR
        exception is raised)
        @param path the URI path to add (will be appended to any root path given in the constructor)
        @param body an optional message body to be included in the request; if a value for this parameter is passed to
        the method, then the body will be serialized according to the serialization rules set in
        \c RestClient::RestClient::constructor() "RestClient::constructor()"
        @param info an optional reference to a hash that will be used as an output variable giving a hash of request
        headers and other information about the HTTP request; see \c rest-info-format for information about the
        structure of the hash written to the reference supplied here
        @param decode_errors decode the message body with HTTP error responses and throw an exception based on the
        message body
        @param hdr any headers to be sent with the request; headers here will override default headers for the
        object as well

        @return A hash of headers received from the HTTP server with all key names converted to lower-case; if any
        message body is included in the response, it will be deserialized to %Qore data and assigned to the value
        of the \c "body" key

        @throw DESERIALIZATION-ERROR the response body could not be deserialized (unknown \c Content-Type or
        invalid serialization)
        @throw HTTP-CLIENT-METHOD-ERROR invalid HTTP method argument passed
        @throw REST-RESPONSE-ERROR if this exception is thrown by the @ref Qore::HTTPClient::send() call in case
        of an HTTP response code < 100 or >= 300, the message body is still deserialized if possible and the
        response information can be retrieved in the \a info hash output keys as follows:
        - \c "response-body": the decoded response body
        - \c "response-body-raw": the raw message body in the response (after any content decoding)
        - \c "response-code": the HTTP response code given
        - \c "response-headers": a hash of processed response headers
        - \c "response-headers-raw": a hash of raw unprocessed response headers
        .
        Note that this exception is not raised for HTTP status codes indicating an error if the \c error_passthru
        option is set to @ref True "True"
        @throw REST-ACCEPT-ERROR if the message has a validator that indicates that the response message only
        supports types not supported by the current options or environment

        Other exceptions can be thrown by the @ref Qore::HTTPClient::send() call used to make the HTTP request.

        @see
        - @ref RestClient::RestClient::getSerialization() "RestClient::getSerialization()"
        - @ref RestClient::RestClient::setSerialization() "RestClient::setSerialization()"
        - @ref httpclient_get_with_body
    */
    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info, softbool decode_errors = True,
            *hash<auto> hdr) {
        checkLogin(\info);
        return doRequestIntern(m, path, body, \info, decode_errors, hdr);
    }

    #! sends a signed HTTP request to the REST server and returns the response
    /** @par Example:
        @code{.py}
hash<auto> ans = rest.doSignedRequest("X-Signature", signer, "DELETE", "/orders/1");
        @endcode

        @param shdr the name of the header that will have the signature
        @param signer the code that will return a signature string to put in the header identified by \a shdr, the
        argument to this closure will be a hash with the following keys:
        - \c path: the URI path that will be used for the request
        - \c body: the serialized message body string
        - \c hdr: the headers used for the request (without the header identified by \a shdr)
        @param m the HTTP method to be used; case is ignored (if not a valid method an \c HTTP-CLIENT-METHOD-ERROR
        exception is raised)
        @param path the URI path to add (will be appended to any root path given in the constructor)
        @param body an optional message body to be included in the request; if a value for this parameter is passed to
        the method, then the body will be serialized according to the serialization rules set in
        \c RestClient::RestClient::constructor() "RestClient::constructor()"
        @param info an optional reference to a hash that will be used as an output variable giving a hash of request
        headers and other information about the HTTP request; see \c rest-info-format for information about the
        structure of the hash written to the reference supplied here
        @param decode_errors decode the message body with HTTP error responses and throw an exception based on the
        message body
        @param hdr any headers to be sent with the request; headers here will override default headers for the
        object as well

        @return A hash of headers received from the HTTP server with all key names converted to lower-case; if any
        message body is included in the response, it will be deserialized to %Qore data and assigned to the value
        of the \c "body" key

        @throw DESERIALIZATION-ERROR the response body could not be deserialized (unknown \c Content-Type or
        invalid serialization)
        @throw HTTP-CLIENT-METHOD-ERROR invalid HTTP method argument passed
        @throw REST-RESPONSE-ERROR if this exception is thrown by the @ref Qore::HTTPClient::send() call in case
        of an HTTP response code < 100 or >= 300, the message body is still deserialized if possible and the
        response information can be retrieved in the \a info hash output keys as follows:
        - \c "response-body": the decoded response body
        - \c "response-body-raw": the raw message body in the response (after any content decoding)
        - \c "response-code": the HTTP response code given
        - \c "response-headers": a hash of processed response headers
        - \c "response-headers-raw": a hash of raw unprocessed response headers
        .
        Note that this exception is not raised for HTTP status codes indicating an error if the \c error_passthru
        option is set to @ref True "True"
        @throw REST-ACCEPT-ERROR if the message has a validator that indicates that the response message only
        supports types not supported by the current options or environment

        Other exceptions can be thrown by the @ref Qore::HTTPClient::send() call used to make the HTTP request.

        @note if a signRequest() method is implemented, the request will be signed with both algorhithms

        @see
        - @ref RestClient::RestClient::getSerialization() "RestClient::getSerialization()"
        - @ref RestClient::RestClient::setSerialization() "RestClient::setSerialization()"
        - @ref httpclient_get_with_body
    */
    hash<auto> doSignedRequest(string shdr, code signer, string m, string path, auto body,
            *reference<hash<auto>> info, softbool decode_errors = True, *hash<auto> hdr) {
        checkLogin(\info);
        return doRequestIntern(m, path, body, \info, decode_errors, hdr, NOTHING, shdr, signer);
    }

    #! Returns True if the request error indicates that a refresh operation should be performed
    private bool needsRefresh(*hash<ExceptionInfo> ex, *hash<auto> info, *bool body_deserialized, auto body) {
        if (!custom_token_method && (!oauth2_grant_type || oauth2_grant_type == "none")) {
            debug("RestClient: not retrying; oauth2_grant_type: %y", oauth2_grant_type);
            return False;
        }
        if (!oauth2_auto_refresh) {
            debug("RestClient: not retrying; oauth2_auto_refresh: False");
            return False;
        }
        if ((now_us() - token_timestamp) < MinimumTokenRefresh) {
            debug("RestClient: not retrying; last token acquired %y; minimum refresh interval is %y",
                token_timestamp, MinimumTokenRefresh);
            return False;
        }
        *int status_code = info."response-code" ?? info."response-header".status_code;
        if (!exists status_code) {
            debug("RestClient: not retrying; no HTTP response code available");
            return False;
        }
        if (!isAuthTokenError(status_code, info."response-headers", body_deserialized, info."body-content-type",
            info."response-body")) {
            debug("RestClient: isAuthTokenError() returned False");
            return False;
        }
        return True;
    }

    #! Returns @ref True if the response was related to an authorization token error
    /** @return @ref True if the response was related to an authorization token error

        @since RestClient 2.2
    */
    bool isAuthTokenError(int status_code, hash<auto> headers, *bool body_deserialized, *string body_content_type,
            auto body) {
        if (status_code == 401) {
            return True;
        }
        if (rest_body_auth_error_check && body_deserialized
            && (body{keys rest_body_auth_error_check} == rest_body_auth_error_check)) {
            return True;
        }
        return False;
    }

    #! Get a new token from the server either with an OAuth2 token request or using the refresh token
    /** @return The response from the token call

        @throw AUTH-CONFIG-ERROR The RestClient is not configured for token retrieval

        The \ oauth2_grant_type option must be set on the client, or an exception will be thrown

        @throw AUTH-CONFIG-ERROR cannot retrieve an OAuth2 token without OAuth2 option configuration

        @since RestClient 2.2
    */
    hash<auto> getNewToken() {
        if (!oauth2_grant_type && !custom_token_auth) {
            throw "AUTH-CONFIG-ERROR", "Not all of 'oauth2_grant_type', 'oauth2_token_url', 'oauth2_client_id' are "
                "set; also custom token refresh options are not set; cannot request a new token";
        }
        return getNewTokenIntern();
    }

    #! Sets up a custom token refresh request
    /** @since %RestClient 2.3
    */
    private *hash<auto> setupCustomGetToken(reference<hash<auto>> auth_hdr) {
        hash<auto> body;
        if (!custom_token_method) {
            throw "REST-LOGIN-ERROR", "Custom token refresh method is not set";
        }
        switch (custom_token_auth) {
            case "body-user-pass":
                body = {
                    "username": username,
                    "password": password,
                };
                break;

            default:
                throw "REST-CUSTOM-TOKEN-ERROR", sprintf("Invalid custom token auth method: %y",
                    custom_token_auth);
        }
        return body;
    }

    #! Get a new token from the server
    /**
        @since RestClient 2.2
    */
    private hash<auto> getNewTokenIntern(*reference<hash<auto>> info) {
        if (refresh_token) {
            return refreshTokenIntern(\info);
        }
        if (custom_token_auth) {
            return customGetTokenIntern(\info);
        }
        if (oauth2_grant_type == "authorization_code" || oauth2_grant_type == "implicit") {
            throw "REST-TOKEN-ERROR", sprintf("The current token is invalid; no refresh token is in place, and the "
                "grant type is %y", oauth2_grant_type);
        }
        # try to get a new token
        return loginIntern(\info);
    }

    #! Gets a new token using the custom token refresh method
    /** @return a hash with the new token

        @since RestClient 2.3
    */
    private hash<auto> customGetTokenIntern(*reference<hash<auto>> info, *bool refresh) {
        hash<auto> auth_hdr;
        *hash<auto> body = setupCustomGetToken(\auth_hdr);
        hash<auto> resp;
        if (custom_token_location == "body-plain") {
            # restore the old serialization option on exit
            string old_ds = getSerialization();
            on_exit setSerialization(old_ds);
            # clear serialization for the request
            setSerialization("text");

            resp = doRequestIntern(custom_token_method, custom_token_path, body, \info, True, auth_hdr);
            trim resp.body;
            if (!resp.body) {
                throw "REST-TOKEN-ERROR", "No body returned from custom get token operation";
            }
        } else if (custom_token_location == "body-direct") {
            auth_hdr = {
                "Accept": MimeTypeJson,
            };
            resp = doRequestIntern(custom_token_method, custom_token_path, body, \info, True, auth_hdr);
            if (resp.body.typeCode() != NT_STRING) {
                throw "REST-TOKEN-ERROR", sprintf("REST body type expected to be \"string\"; got %y instead",
                    resp.body.fullType());
            }
        } else {
            throw "REST-TOKEN-ERROR", sprintf("Invalid / unknown custom token location: %y",
                custom_token_location);
        }
        hash<auto> rv = {
            "token_type": "Bearer",
            "access_token": resp.body,
        };
        return gotOAuth2LoginInfo(rv, refresh);
    }

    #! Gets a new token using the refresh token
    /** @return the response from the refresh token call

        @since RestClient 2.2
    */
    private hash<auto> refreshTokenIntern(*reference<hash<auto>> info) {
        # get a new token with the refresh token
        hash<auto> rv = oauth2Auth(getOAuth2RefreshInfo(), \info, True);
        if (token && update_options) {
            hash<auto> new_opts += {
                "token": token,
                "token_type": token_type,
            };
            if (refresh_token) {
                new_opts.oauth2_refresh_token = refresh_token;
            }
            if (oauth2_token_expiry) {
                new_opts.oauth2_token_expiry = oauth2_token_expiry;
            } else if (oauth2_token_expiry_hint) {
                new_opts.oauth2_token_expiry = now_us() + minutes(oauth2_token_expiry_hint);
            }
            doUpdateOptions(self, new_opts);
        }
        return rv;
    }

    #! Makes a REST request and returns the result
    private hash<auto> doRequestIntern(string m, string path, auto body, *reference<hash<auto>> info,
            softbool decode_errors = True, *hash<auto> hdr, *string assume_content_type, *string shdr, *code signer,
            *bool no_auth_retry) {
        prepareMsg(m, path, \body, \hdr);
        on_exit if (exists body) {
            info += {
                "request-body": body,
                "request-serialization": ds,
            };
        }

        # prepare path
        preparePath(\path);

        on_error {
            hash<UrlInfo> url_info = parse_url(getSafeURL());
            string url = sprintf("%s://", url_info.protocol);
            if (url_info.username.val()) {
                url += sprintf("%s@", url_info.username);
            }
            if (url_info.host.val()) {
                url += url_info.host;
            }
            if (url_info.port && (url_info.port != 80 || url_info.protocol != "http") && (url_info.port != 443
                || url_info.protocol != "https")) {
                url += sprintf(":%d", url_info.port);
            }
            url += path;
            rethrow $1.err, sprintf("%s (REST URL %y)", $1.desc, url);
        }

        return sendAndDecodeResponse(body, m, path, hdr, \info, decode_errors, assume_content_type, shdr, signer,
            no_auth_retry);
    }

    #! Prepares and processes message parameters for sending without sending the message
    /** @param method the HTTP method to use
        @param path a reference to the URI path
        @param body a reference to any message body
        @param hdr a reference to any headers to send

        @since %RestClient 1.10.2
    */
    prepareToSend(string method, reference<string> path, reference<auto> body, *reference<hash<auto>> hdr) {
        prepareMsg(method, path, \body, \hdr);
        preparePath(\path);
        signRequest(method, path, body, \hdr);
    }

    #! The same as doRequest() except no schema validation is performed on the request
    /** @since RestClient 1.7.2
    */
    hash<auto> doValidatedRequest(string m, string path, auto body, *reference<hash<auto>> info,
            softbool decode_errors = True, *hash<auto> hdr) {
        # use {} + ... here to ensure that hdr stays "hash<auto>"
        hdr = {} + headers + hdr;

        on_exit if (exists body) {
            info += {
                "request-body": body,
                "request-serialization": ds,
            };
        }

        return sendAndDecodeResponse(body, m, path, hdr, \info, decode_errors);
    }

    #! Process the raw REST response received
    /** @param resp the return value from HTTPClient::send()
        @param method the HTTP method used
        @param path the URI path used
        @param info an optional info hash reference for information about the call

        @return \a resp with additional or processed information
    */
    hash<auto> processRestResponse(hash<auto> resp, string method, string path, *reference<hash<auto>> info) {
        hash<RestResponseClientInfo> sh;
        try {
            sh = validator.parseResponse(method, path, resp.status_code, resp.body, resp);
        } catch (hash<ExceptionInfo> ex) {
            if (allow_any_response && (ex.err == "DESERIALIZATION-ERROR") && resp.body.val()) {
                if (!is_mime_text(resp."content-type")) {
                    resp.body = binary(resp.body);
                }
                info."response-body" = resp.body;
                return resp;
            }
            rethrow;
        }

        if (exists resp.body) {
            resp.body = sh.body;
            info += {
                "response-serialization": sh.info."code"
                    ?? NullRestSchemaValidator::DataDeserializationSupport{resp."content-type"}."code"
                    ?? "unknown",
                "response-body": resp.body,
            };
        }

        return resp;
    }

    #! Called when OAuth2 login information has been received
    /** @param h the OAuth2 login response hash
        @param refresh used to distinguish an initial login or new information from a token refresh

        @since %RestClient 2.0
    */
    hash<auto> gotOAuth2LoginInfo(hash<auto> h, *bool refresh) {
        if (h.OAuth) {
            h = h.OAuth;
        }
        debug("login info: %y", h);
        if (h.token_type.typeCode() != NT_STRING || h.access_token.typeCode() != NT_STRING) {
            throw "REST-LOGIN-ERROR", sprintf("OAuth2 response for grant type %y is invalid, needs both "
                "token_type (%y) and access_token (%y): %y", oauth2_grant_type, h.token_type, h.access_token, h);
        }
        *hash<auto> new_opts = update_options ? getUpdateOptionsAfterLogin(h, refresh) : NOTHING;
        # set the token
        setOAuth2LoginInfo(h);
        if (update_options && new_opts) {
            doUpdateOptions(self, new_opts);
        }
        token_timestamp = now_us();
        return h;
    }

    #! Preprocesses the request body before serialization
    /** The default is to return the request body unchanged

        @since %RestClient 2.2
    */
    auto preprocessRequestBody(auto request_body) {
        return request_body;
    }

    #! Returns the logger interface for logging
    *LoggerInterface getLogger() {
        return logger;
    }

    #! Returns a scope string URI argument
    /** @param scopes the list of scopes to use
        @param separator the separator string to use

        @since %RestClient 2.2
    */
    static *string getScopeString(*list<auto> scopes, string separator = " ") {
        return scopes ? (foldl $1 + separator + $2, scopes) : NOTHING;
    }

    #! Sets alt token signer code and the header for it
    /** @since %RestClient 2.2
    */
    setAltTokenSigner(code signer, string signer_header) {
        alt_token_signer = signer;
        alt_token_signer_header = signer_header;
    }

    #! Clears alt token signer code and the header for it
    /** @since %RestClient 2.2
    */
    clearAltTokenSigner() {
        remove self{"alt_token_signer", "alt_token_signer_header"};
    }

    #! Sets options from the OAuth2 login response on the local object
    /** @since %RestClient 2.0
    */
    private setOAuth2LoginInfo(hash<auto> h) {
        if (h.hasKey("expires_in") && !h.expires_in.intp()) {
            warn("Ignoring invalid 'expires_in' value with type %y; value: %y", h.expires_in.fullType(),
                h.expires_in);
            remove h.expires_in;
        }
        setToken(h.token_type, h.access_token, h.refresh_token,
            h.expires_in ? (now_us() + minutes(h.expires_in)) : NOTHING);
        debug("RestClient: set OAuth2 auth header: %s %s; refresh_token: %s; expires in: %s", h.token_type,
            h.access_token, h.refresh_token ?? "n/a", h.expires_in ?? "n/a");
    }

    #! Returns options to update after an OAuth2 login
    /** @since %RestClient 2.0
    */
    private *hash<auto> getUpdateOptionsAfterLogin(hash<auto> h, *bool refresh) {
        hash<auto> new_opts;
        # do not update "Bearer" -> "bearer"; it can break oauth2 refresh for apps like HubSpot
        if (h.token_type && (!token_type || (h.token_type.lwr() != token_type.lwr()))) {
            new_opts.token_type = h.token_type;
        }
        if (h.access_token && h.access_token != token) {
            new_opts.token = h.access_token;
        }
        if (h.refresh_token && h.refresh_token != refresh_token) {
            new_opts.oauth2_refresh_token = h.refresh_token;
        }
        if (h.hasKey("expires_in") && !h.expires_in.intp()) {
            warn("Ignoring invalid 'expires_in' value with type %y; value: %y", h.expires_in.fullType(),
                h.expires_in);
            remove h.expires_in;
        }
        if (*softint expires_in = h.expires_in ?? oauth2_token_expiry_hint) {
            new_opts.oauth2_token_expiry = now_us() + minutes(expires_in);
        }
        if (h.url && h.url != getURL()) {
            new_opts.url = h.url;
        }
        return new_opts;
    }

    #! Sets up authentication info
    /** @since %RestClient 2.0
    */
    private setupAuth(hash<auto> opts, *bool no_exceptions) {
        # set any token
        if (opts.token.val()) {
            if (opts.token_api_key_header.val()) {
                headers{opts.token_api_key_header} = opts.token;
            } else {
                setToken(opts.token_type ?? "Bearer", opts.token, opts.oauth2_refresh_token, opts.oauth2_token_expiry);
            }
            if (opts.custom_token_auth) {
                setupUserPassword(opts);
            }
        } else {
            setupUserPassword(opts);
        }

        # check any OAuth2 options
        try {
            checkOAuth2Options(opts);
        } catch (hash<ExceptionInfo> ex) {
            if (no_exceptions) {
                error("Error setting up OAuth2 options: %s: %s", ex.err, ex.desc);
                return;
            }
            rethrow;
        }
    }

    #! Setup username and password consistently
    setupUserPassword(hash<auto> opts) {
        if (!exists getUsername() && !exists getPassword() && exists opts.username) {
            setUserPassword(opts.username, opts.password ?? "");
            username = opts.username;
            if (exists opts.password) {
                password = opts.password;
            } else {
                remove opts.password;
            }
        } else {
            if (*string u = getUsername()) {
                username = u;
            }
            if (*string p = getPassword()) {
                password = p;
            }
        }
    }

    #! Validates and sets any OAuth2 options
    /** @since %RestClient 2.0
    */
    private checkOAuth2Options(hash<auto> opts, *bool no_exceptions) {
        *string grant_type = opts.oauth2_grant_type;
        if (!exists grant_type || grant_type == "none") {
            return;
        }
        *list<string> req_opts = OAuth2GrantOptions{grant_type};
        if (!req_opts) {
            throw "OAUTH2-ERROR", sprintf("OAuth2 grant type %y is unknown; known grant types: %y", grant_type,
                keys OAuth2GrantOptions);
        }
        oauth2_grant_type = grant_type;
        foreach string req_opt in (req_opts) {
            if (!opts.hasKey(req_opt)) {
                throw "OAUTH2-ERROR", sprintf("OAuth2 grant type %y requires option %y, but this option is not "
                    "set; options provided: %y", grant_type, req_opt, keys opts);
            }
            if (opts{req_opt}.typeCode() != NT_STRING) {
                throw "OAUTH2-ERROR", sprintf("OAuth2 grant type %y requires option %y to be set with a string; "
                    "type provided: %y (value: %y)", grant_type, req_opt, opts{req_opt}.fullType(), opts{req_opt});
            }
            self{req_opt} = opts{req_opt};
        }
        if (grant_type == "password") {
            # requires username and password
            if (!exists username) {
                throw "OAUTH2-ERROR", "the 'password' OAuth2 grant type requires a username and password; no "
                    "username is set for the current connection";
            }
            if (!exists password) {
                throw "OAUTH2-ERROR", "the 'password' OAuth2 grant type requires a username and password; no "
                    "password is set for the current connection";
            }
        }
    }

    #! Authenticates with OAuth2 or a custom token method if configured
    /** @since %RestClient 2.0
    */
    private hash<auto> loginIntern(*reference<hash<auto>> info) {
        if (custom_token_auth) {
            return customGetTokenIntern(\info);
        }
        return oauth2Auth(getOAuth2LoginInfo(oauth2_grant_type), \info);
    }

    #! Starts a non-blocking I/O operation to authenticate with an OAuth2 server and acquire an auth token
    /** @since %RestClient 2.0
    */
    private AbstractPollOperation startOAuth2AuthPoll(hash<auto> login) {
        # do not send a basic auth header with the username and password in the request
        clearUserPassword();
        hash<auto> auth_hdr = getOAuth2AuthHeaders() + {
            "Content-Type": MimeTypeFormUrlEncoded,
        };
        *hash<auto> as;
        if (!oauth2_alt_token_url) {
            if (oauth2_token_use_basic_auth && oauth2_client_id.val() && oauth2_client_secret.val()) {
                auth_hdr.Authorization = "Basic " + sprintf("%s:%s", oauth2_client_id, oauth2_client_secret).toBase64();
                login -= ("client_id", "client_secret");
            } else if (oauth2_token_auth_secret_only && oauth2_client_secret.val()) {
                auth_hdr.Authorization = "Basic " + sprintf("%s:", oauth2_client_secret).toBase64();
                login -= ("client_id", "client_secret");
            }
        } else {
            as = self{"alt_token_signer", "alt_token_signer_header"};
        }
        # restore the username and password on exit
        on_exit if (username) {
            setUserPassword(username, self.password ?? "");
        }
        string request_body = mime_get_form_urlencoded_string(login);
        string path = oauth2_alt_token_url ?? oauth2_token_url;
        # check if the path is a URL
        if (path =~ /^http/) {
            setURL(path);
            path = "";
        }

        # include signed request header if necessary
        if (as.alt_token_signer) {
            auth_hdr{as.alt_token_signer_header} = as.alt_token_signer({
                "method": "POST",
                "path": path,
                "body": request_body,
                "hdr": auth_hdr,
            });
        }
        return startPollSendRecv("POST", path, request_body, auth_hdr);
    }

    #! Perform OAuth2 authentication
    /** @since %RestClient 2.0
    */
    private hash<auto> oauth2Auth(hash<auto> login, *reference<hash<auto>> info, *bool refresh) {
        # do not send a basic auth header in the request
        clearUserPassword();
        # restore the username and password on exit
        on_exit if (username) {
            setUserPassword(username, password ?? "");
        }

        return oauth2AuthIntern(login, \info, refresh);
    }

    #! Perform OAuth2 authentication
    /** @since %RestClient 2.0
    */
    private hash<auto> oauth2AuthIntern(hash<auto> login, *reference<hash<auto>> info, *bool refresh) {
        # clear connection path for login call
        *string path = getConnectionPath();
        on_exit setConnectionPath(path);
        setConnectionPath();

        # remove tokens and Authorization header; make sure and restore on error so that refreshes can be retried
        *string old_token = remove token;
        on_error if (old_token.val()) token = old_token;
        *string old_auth = remove headers.Authorization;
        on_error if (old_auth.val()) headers.Authorization = old_auth;

        # temporarily remove any schema for the OAuth2 call
        AbstractRestSchemaValidator v;
        if (!(validator instanceof NullRestSchemaValidator)) {
            v = remove self.validator;
            validator = new NullRestSchemaValidator(logger);
        }
        on_exit if (v) {
            validator = v;
        }

        # save URL in case the token URL is on a completely different server
        string orig_url = getURL();
        # use oauth2_alt_token_url if it's set
        string oauth2_token_url = oauth2_alt_token_url ?? self.oauth2_token_url;
        bool set_url = oauth2_token_url =~ /^http/;
        # set the full URL if the token URL is possibly on another server
        if (set_url) {
            setURL(oauth2_token_url);
        }
        # restore the URL on exit if necessary
        on_exit if (set_url) {
            setURL(orig_url);
        }

        # restore the old serialization option on exit
        string old_ds = ds;
        on_exit setSerialization(old_ds);
        # use URL form encoding for the message body
        setSerialization("url");

        # make the authorization call
        return gotOAuth2LoginInfo(doOAuth2LoginRequest(set_url ? "/" : oauth2_token_url, login, \info,
            set_url ? oauth2_token_url : NOTHING), refresh);
    }

    #! Returns the deserialized response body of an OAuth2 authorization / token request
    /** @since %RestClient 2.0
    */
    private hash<auto> doOAuth2LoginRequest(string url, hash<auto> login, *reference<hash<auto>> info,
            *string real_url) {
        on_success debug("OAuth2: POST to %y successful", real_url ?? url);
        on_error debug("OAuth2: POST to %y failed: %s: %s request: %y headers: %y body: %y response: %y headers: %y "
            "body: %y", real_url ?? url, $1.err, $1.desc, info."request-uri", info.headers, info."request-body",
            info."response-uri", info."response-headers-raw", info."response-body");

        # get auth headers
        *hash<auto> hdr = getOAuth2AuthHeaders();
        # include signed request header if necessary
        *hash<auto> as;
        if (oauth2_alt_token_url) {
            as = self{"alt_token_signer", "alt_token_signer_header"};
            if (!as.alt_token_signer) {
                remove as;
            }
        } else {
            if (oauth2_token_use_basic_auth && oauth2_client_id.val() && oauth2_client_secret.val()) {
                hdr.Authorization = "Basic " + sprintf("%s:%s", oauth2_client_id, oauth2_client_secret).toBase64();
                login -= ("client_id", "client_secret");
            } else if (oauth2_token_auth_secret_only && oauth2_client_secret.val()) {
                hdr.Authorization = "Basic " + sprintf("%s:", oauth2_client_secret).toBase64();
                login -= ("client_id", "client_secret");
            }
        }
        return RestClient::doRequestIntern("POST", url, login, \info, NOTHING, hdr, NOTHING,
            as.alt_token_signer_header, as.alt_token_signer, True).body;
    }

    #! Returns headers to use with OAuth2 authorization / token requests
    /** @since %RestClient 2.0
    */
    private *hash<auto> getOAuth2AuthHeaders() {
        return OAuth2AuthHeaders;
    }

    #! Returns an OAuth2 login hash
    /** @since %RestClient 2.0
    */
    private hash<auto> getOAuth2LoginInfo(string grant_type) {
        if (grant_type == "authorization_code" || grant_type == "implicit") {
            throw "OAUTH2-ERROR", sprintf("This connection is using the '%s' grant type and must be manually "
                "authorized before it can be used", grant_type);
        }
        hash<auto> login = {
            "client_id": oauth2_client_id,
            "client_secret": oauth2_client_secret,
            "grant_type": grant_type,
        } + oauth2_token_args;
        if (oauth2_alt_token_url) {
            string uri = oauth2_token_url;
            if (uri !~ /^http/) {
                string url = uri =~ /^\// ? getURL(UC_TARGET) : getURL(UC_TARGET | UC_PATH);
                if (url !~ /\/$/) {
                    url += "/";
                }
                if (uri =~ /^\//) {
                    uri = uri[1..];
                }
                uri = url + uri;
                printf("URI: %y\n", uri);
            }
            login.oauth2_token_url = uri;
            if (oauth2_token_use_basic_auth) {
                login.oauth2_token_use_basic_auth = True;
            } else if (oauth2_token_auth_secret_only) {
                login.oauth2_token_auth_secret_only = True;
            }
        }
        if (oauth2_scopes) {
            login += {
                "scope": getScopeString(oauth2_scopes, oauth2_scope_separator_char),
            };
        }
        if (grant_type == "password") {
            login += {
                "username": username ?? getUsername(),
                "password": password ?? getPassword() ?? "",
            };
        }
        return login;
    }

    #! Returns an OAuth2 refresh hash
    /** @since %RestClient 2.0
    */
    private hash<auto> getOAuth2RefreshInfo() {
        hash<auto> rv = {
            "client_id": oauth2_client_id,
            "client_secret": oauth2_client_secret,
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
        } + oauth2_token_args;
        if (oauth2_alt_token_url) {
            rv.oauth2_token_url = oauth2_token_url;
        }
        return rv;
    }

    #! sets up the Content-Type header and encodes any body for sending
    private nothing prepareMsg(string method, string path, reference<auto> body, reference<hash<auto>> hdr,
            string ct = "Content-Type") {
        # use {} + ... here to ensure that hdr stays "hash<auto>"
        hdr = {} + headers + hdr;

        # we need to prepend any connection path to the path before validation to ensure correct matches
        # must get the path from the HTTPClient object if not given in the request
        if (!validator.managesUriPath() && (*string p = getConnectionPath()).val()) {
            if (p =~ /\/$/) {
                splice p, -1, 1;
            }
            if (path.val() && path[0] != "/") {
                path = "/" + path;
            }
            path = p + path;
        }

        body = preprocessRequestBody(body);
        hash<RestRequestClientInfo> req = validator.processRequest(method, path, body, hdr, sct);
        if (exists body) {
            body = req.body;
            if (!hdr{ct}) {
                hdr{ct} = req.content;
            }
            if (!noCharset && body.typeCode() == NT_STRING && hdr{ct} !~ /;charset=/) {
                hdr{ct} += ";charset=" + body.encoding();
            }
            if (seh.ce && body.size() > CompressionThreshold) {
                hdr."Content-Encoding" = seh.ce;
                body = seh.func(body);
            }
        }
    }

    #! sets up the path for the HTTP request URI
    private nothing preparePath(reference<string> path) {
        # strip leading "/" off the given path
        path =~ s/^\/+//;

        # prepare path = connection path (if the validator does not manage the base path) + base path + path
        *string p;
        if (!validator.managesUriPath()) {
            p = getConnectionPath();
        }
        string base_path = validator.getBasePath();
        if (base_path.val()) {
            if (base_path[0] != "/") {
                base_path = "/" + base_path;
            }
            if (base_path != "/" && path.comparePartial(base_path[1..])) {
                # strip trailing "/" off the base path
                base_path =~ s/\/+$//;
                path = base_path + (path.val() ? ("/" + path) : "");
            }
        }
        if (p.val() && p != "/") {
            # strip trailing "/" off the connection path
            p =~ s/\/+$//;
            path = p + (path.val() ? ("/" + path) : "");
        }

        # ensure path is absolute
        if (path !~ /^\//) {
            splice path, 0, 0, "/";
        }

        # NOTE: Qore will perform URL encoding on the URL + path
    }

    #! Checks if a login is necessary; if so, then the login is performed
    private checkLogin(*reference<hash<auto>> info) {
        if (!token && ((oauth2_grant_type && oauth2_grant_type != "none") || custom_token_auth)) {
            loginIntern(\info);
        }
    }

    #! sends the outgoing HTTP message and recodes the response to data
    private hash<auto> sendAndDecodeResponse(*data body, string m, string path, hash<auto> hdr,
            *reference<hash<auto>> info, *softbool decode_errors, *string assume_content_type, *string shdr,
            *code signer, *bool no_auth_retry) {
        hash<auto> h;

        bool retry = !no_auth_retry;
        hash<auto> rv;
        while (True) {
            # if we are in the token expiry window; get a new token first
            if (retry && requiresRefresh()) {
                detail("RestClient in the token expiry window; acquiring a new token");
                getNewTokenIntern();
                # only retry once
                retry = False;
                detail("RestClient got a new token");
                hdr.Authorization = headers.Authorization;
                continue;
            }
            try {
                if (signer && shdr.val()) {
                    hdr{shdr} = signer({
                        "path": path ?* getConnectionPath() ?* getDefaultPath() ?* "/",
                        "body": body,
                        "hdr": hdr - shdr,
                    });
                    debug("sending (signed) %y: path: %y body: %d bytes hdr: %y", m, path, body.size(), hdr);
                }
                # in case of any "signer" and "shdr" args, the request could be signed twice
                signRequest(m, path, body, \hdr);
                debug("sending %y: path: %y body: %d bytes hdr: %y", m, path, body.size(), hdr);
                h = send(body, m, path, hdr, False, \info);
                info."response-code" = h.status_code;
                debug("RestClient sent: %y received: %y (%y: %s bytes%s)", info."request-uri", info."response-uri",
                    (h.body ? h.body.encoding() : "n/a"), h.body.size(), h.body.size() && h."content-type" ? (" " +
                        h."content-type") : "");
                if (!h."content-type".val() && assume_content_type.val()) {
                    debug("missing content-type from response; assuming %y", assume_content_type);
                    h."content-type" = assume_content_type;
                }
                info."response-body-raw" = h.body;
            } catch (hash<ExceptionInfo> ex) {
                error("RestClient sent: %y received: %y err: %s: %s", info."request-uri", info."response-uri", ex.err,
                    ex.desc);
                info."response-code" = info."response-headers".status_code;
                if (retry && needsRefresh(ex, info)) {
                    on_error rethrow;
                    detail("RestClient: authorization error; trying to acquire a new token");
                    getNewTokenIntern();
                    # only retry once
                    retry = False;
                    detail("RestClient retrying with new token");
                    hdr.Authorization = headers.Authorization;
                    continue;
                }
                if (ex.arg) {
                    if (decode_errors && ex.arg.body) {
                        decodeError(ex.arg, \info);
                        ex.arg.deserialized_body = info."response-body";
                    }
                }
                rethrow ex.err, ex.desc, ex.arg;
            }

            on_error {
                if (exists h.body && !exists info."response-body") {
                    info."response-body" = h.body;
                }
            }

            rv = processRestResponse(h, m, path, \info);
            if (rest_body_auth_error_check && retry && needsRefresh(NOTHING, info, True, rv.body)) {
                on_error rethrow;
                detail("RestClient: authorization error; trying to acquire a new token");
                getNewTokenIntern();
                # only retry once
                retry = False;
                detail("RestClient retrying with new token");
                hdr.Authorization = headers.Authorization;
                continue;
            }
            break;
        }

        return rv;
    }

    #! Starts an async REST request and returns a Future that will be resolved with the deserialized response
    /** @par Example:
        @code{.py}
Future f = rest.asyncGet("/api/resource");
hash<auto> result = f.get();
        @endcode

        @param m the HTTP method to use
        @param path the URI path to send the request to
        @param body an optional message body to send with the request
        @param decode_errors decode error responses (default: True)
        @param hdr an optional hash of headers to send with the request

        @return a @ref RestRequestPollOperation for the async request

        @since %RestClient 2.4
    */
    RestRequestPollOperation startPollDoRequest(string m, string path, auto body,
            softbool decode_errors = True, *hash<auto> hdr) {
        hash<auto> info = {};
        checkLogin(\info);
        # Phase 1: Prepare (synchronous — runs all subclass hooks)
        prepareMsg(m, path, \body, \hdr);
        if (exists body) {
            info += {
                "request-body": body,
                "request-serialization": ds,
            };
        }

        # prepare path
        preparePath(\path);

        # allow subclasses to sign / modify the request
        prepareAsyncSend(m, path, body, \hdr);

        # Phase 2: Create poll operation
        return new RestRequestPollOperation(self, m, path, body, hdr, decode_errors, info);
    }

    #! Starts an async GET request
    /** @par Example:
        @code{.py}
RestRequestPollOperation poller = rest.startPollGet("/api/resource");
        @endcode

        @param path the URI path to send the request to
        @param body an optional message body to send with the request
        @param hdr an optional hash of headers to send with the request

        @return a @ref RestRequestPollOperation for the async request

        @since %RestClient 2.4
    */
    RestRequestPollOperation startPollGet(string path, auto body, *hash<auto> hdr) {
        return startPollDoRequest("GET", path, body, True, hdr);
    }

    #! Starts an async POST request
    /** @par Example:
        @code{.py}
RestRequestPollOperation poller = rest.startPollPost("/api/resource", body);
        @endcode

        @param path the URI path to send the request to
        @param body an optional message body to send with the request
        @param hdr an optional hash of headers to send with the request

        @return a @ref RestRequestPollOperation for the async request

        @since %RestClient 2.4
    */
    RestRequestPollOperation startPollPost(string path, auto body, *hash<auto> hdr) {
        return startPollDoRequest("POST", path, body, True, hdr);
    }

    #! Starts an async PUT request
    /** @par Example:
        @code{.py}
RestRequestPollOperation poller = rest.startPollPut("/api/resource", body);
        @endcode

        @param path the URI path to send the request to
        @param body an optional message body to send with the request
        @param hdr an optional hash of headers to send with the request

        @return a @ref RestRequestPollOperation for the async request

        @since %RestClient 2.4
    */
    RestRequestPollOperation startPollPut(string path, auto body, *hash<auto> hdr) {
        return startPollDoRequest("PUT", path, body, True, hdr);
    }

    #! Starts an async DELETE request
    /** @par Example:
        @code{.py}
RestRequestPollOperation poller = rest.startPollDel("/api/resource");
        @endcode

        @param path the URI path to send the request to
        @param body an optional message body to send with the request
        @param hdr an optional hash of headers to send with the request

        @return a @ref RestRequestPollOperation for the async request

        @since %RestClient 2.4
    */
    RestRequestPollOperation startPollDel(string path, auto body, *hash<auto> hdr) {
        return startPollDoRequest("DELETE", path, body, True, hdr);
    }

    #! Starts an async PATCH request
    /** @par Example:
        @code{.py}
RestRequestPollOperation poller = rest.startPollPatch("/api/resource", body);
        @endcode

        @param path the URI path to send the request to
        @param body an optional message body to send with the request
        @param hdr an optional hash of headers to send with the request

        @return a @ref RestRequestPollOperation for the async request

        @since %RestClient 2.4
    */
    RestRequestPollOperation startPollPatch(string path, auto body, *hash<auto> hdr) {
        return startPollDoRequest("PATCH", path, body, True, hdr);
    }

    #! Called after prepareMsg() + preparePath(), before creating the async poll operation
    /** Default implementation calls signRequest(). Subclasses can override to add custom signing
        (e.g., AWS Signature V4).

        @param method the HTTP method
        @param path the prepared URI path
        @param body the prepared message body
        @param hdr a reference to the headers hash, which can be modified

        @since %RestClient 2.4
    */
    private prepareAsyncSend(string method, string path, *data body, reference<hash<auto>> hdr) {
        signRequest(method, path, body, \hdr);
    }

    #! Called to process the raw HTTP response from the async poll operation
    /** Default implementation calls processRestResponse(). Subclasses can override for custom
        error wrapping (e.g., CDS or ServiceNow error extraction).

        @param resp the raw HTTP response hash
        @param method the HTTP method used
        @param path the URI path used
        @param info a reference to the info hash
        @param decode_errors whether to decode error responses

        @return the processed response hash

        @since %RestClient 2.4
    */
    hash<auto> processAsyncResponse(hash<auto> resp, string method, string path,
            reference<hash<auto>> info, bool decode_errors) {
        return processRestResponse(resp, method, path, \info);
    }

    #! Tries to decode an error response for async operations
    /** @param h a reference to the response hash
        @param info a reference to the info hash

        @since %RestClient 2.4
    */
    static decodeAsyncError(hash<auto> h, *reference<hash<auto>> info) {
        decodeError(h, \info);
    }

    #! Signs requests before sending
    private signRequest(string method, *string path, *data body, reference<hash<auto>> hdr) {
        # override in child classes to implement request signing
    }

    #! decode any REST errors returned if possible
    static private decodeError(hash<auto> h, *reference<hash<auto>> info) {
        try {
            RestClient::tryDecodeErrorResponse(\h, \info);
        } catch (hash<ExceptionInfo> ex) {
            # ignore decoding exceptions
        }
        info."response-body-raw" = info."response-body";
        info."response-body" = h.body;
        if (h.body.err) {
            if (h.body.desc.typeCode() == NT_STRING)
                trim h.body.desc;
            throw h.body.err, h.body.desc, h.body.arg;
        }
        if (h.body && h.body.typeCode() == NT_STRING) {
            trim h.body;
            throw "REST-RESPONSE-ERROR", h.body, h - "body";
        }
    }

    #! tries to decode an error response
    static private:internal tryDecodeErrorResponse(reference<hash<auto>> h, *reference<hash<auto>> info) {
        string ct = (h."content-type".typeCode() == NT_LIST
            ? h."content-type"[0]
            : h."content-type");
        *hash<auto> dh = NullRestSchemaValidator::DataDeserializationSupport{ct};
        if (!dh) {
            throw "DESERIALIZATION-ERROR", sprintf("cannot deserialize response body; content-type is: %y; types "
                "supported: %y; response body: %y", h."content-type",
                NullRestSchemaValidator::DataDeserializationSupport.keys(), h.body);
        }

        string code = dh."code";
        h.body = dh.arg
            ? dh.in(h.body, \code)
            : dh.in(h.body);

        info."response-serialization" = code;
    }
} # class RestClient

#! class for REST HTTP connections; returns @ref RestClient::RestClient objects
/** supports the following options:
    - \c "connect_timeout": connection timeout to use in milliseconds
    - \c "content_encoding": this sets the send encoding (if the \c "send_encoding" option is not set) and the
      requested response encoding; for possible values, see
      \c RestClient::RestClient::EncodingSupport "EncodingSupport"
    - \c "data": see \c RestClient::RestClient::DataSerializationOptions for possible values when used with the
      null REST schema validator; the default is \c "auto"
    - \c "error_passthru": if @ref True "True" then HTTP status codes indicating errors will not cause a
      \c REST-RESPONSE-ERROR exception to be raised, rather such responses will be passed through to the caller
      like any other response
    - \c "headers": an optional hash of headers to send with every request, these can also be overridden in
      request method calls; also a string giving headers can be given in the format:
      <tt>header1=value, header2=value</tt>; the value will be parsed with
      \c Util::parse_to_qore_value() "parse_to_qore_value()"
    - \c "http_version": HTTP version to use (\c "auto" (default), \c "1.0", \c "1.1", \c "2.0", or \c "3.0")
    - \c "max_redirects": maximum redirects to support
    - \c "oauth2_app": An OAuth2 app name for external programs handling OAuth2 calls for this client
    - \c "oauth2_auth_url": The OAuth2 authorization URL for the \c authorization_code grant type; ignored if the
      \c token option is set.  Note that the \c authorization_code grant type requires external user authorization to
      acquire an access token
    - \c "oauth2_client_id": The OAuth2 client ID; ignored if the \c token option is set
    - \c "oauth2_client_secret": the OAuth2 client secret; ignored if the \c token option is set
    - \c "oauth2_grant_type": the OAuth2 grant type; ignored if the \c token option is set; possible values:
      - \c "authorization_code": requires \c oauth2_client_id, \c oauth2_client_secret, \c oauth2_auth_url, as well as
        \c oauth2_token_url; note that this grant type cannot be handled automatically but rather must be handled by
        external code that redirects the user to the authentication server and then updates the connection with token
        information retrieved
      - \c "client_credentials": requires \c oauth2_client_id, \c oauth2_client_secret, as well as
        \c oauth2_token_url
      - \c "password": requires a username, password, \c oauth2_client_id, \c oauth2_client_secret, as well as
        \c oauth2_token_url
      - \c "none": same as if this option is not set; it means that no OAuth2 grant flow will be used
    - \c "oauth2_pkce": Use PKCE (Proof Key Code Exchange) when using the OAuth2 \c authorization_code flow; this
      value specifies the code challenge method
    - \c "oauth2_redirect_url": The OAuth2 redirect URL for the \c authorization_code grant type; ignored if the
      \c token option is set.  Note that the \c authorization_code grant type requires external user authorization to
      acquire an access token; the special value \c "auto" (the default) is meant to be interpreted by servers
      that implement OAuth2 authorization code client handling
    - \c "oauth2_refresh_token": An OAuth2 refresh token (complements option \c "token")
    - \c "oauth2_scopes": A list of OAuth2 scopes to request; ignored if the \c token option is set
    - \c "oauth2_scope_separator_char": A separator character for OAuth2 scopes in URI arguments
    - \c "oauth2_token_args": Extra arguments for OAuth2 authentication requests to \c oauth2_token_url; if this
      option is set as well as \c oauth2_alt_token_url, then the \c oauth2_token_url value will be added to this as
      well when the request is made to the \c oauth2_alt_token_url
    - \c "oauth2_token_expiry": The expiry date of the token, if known
    - \c "oauth2_token_expiry_hint": A integer value in minutes giving the expected lifetime of the token
    - \c "oauth2_token_url": The token URL for OAuth2 flows; ignored if the \c token option is set
    - \c "oauth2_token_use_basic_auth": Use basic authentication for the OAuth2 token request
    - \c "openapi3": the path to a <a href="https://swagger.io/">OpenApi 3</a> REST schema file for API
      validation; only used if \a validator not provided (see the @ref openapi3intro "OpenApi3" module)
    - \c "password": The password for authentication; only used if no username or password is set in the URL and if
      the \c username option is also used
    - \c "proxy": proxy URL to use
    - \c "redirect_passthru": if @ref True "True" then redirect responses wil0l be passed to the caller instead of
      processed
    - \c "send_encoding": a \c RestClient::RestClient::EncodingSupport "send data encoding option" or the value
      \c "auto" which means to use automatic encoding; if not present defaults to no content-encoding on sent
      message bodies
    - \c "swagger": the path to a <a href="https://swagger.io/">Swagger 2.0</a> REST schema file for runtime API
      validation (see the @ref swaggerintro "Swagger" module); conflicts with \a validator
    - \c "swagger_base_path": in case a REST validator is used, the base path in the schema can be overridden
      with this option (applies to any REST validator; not just Swagger validators)
    - \c "swagger_lax_parsing": try to parse invalid Swagger schemas
    - \c "timeout": transfer timeout to use in milliseconds
    - \c "token": Any bearer token to use for the connection; will be passed as <tt>Authorization: Bearer ...</tt>
      in request headers; cannot be used with username and password options or authentication information in the URL;
      if this option is set then any OAuth2 options are ignored
    - \c "token_api_key_header": The name of a header where to send the token as an API key
    - \c "username": The username for authentication; only used if no username or password is set in the URL
    - \c "validator": an \c RestSchemaValidator::AbstractRestSchemaValidator "AbstractRestSchemaValidator"
      object to validate request and response messages; conflicts with \a swagger

    @note additionally supports the following runtime option in getImpl():
    - \c "validator": an \c RestSchemaValidator::AbstractRestSchemaValidator "AbstractRestSchemaValidator"
      object for REST message validation (if present, overrides any REST schema validation option provided as a
      connection option)

    @see \c RestClient::RestClient::constructor() "RestClient::constructor()" for more information on the above
    options

    @since %RestConnection 1.4
*/
public class RestConnection inherits ConnectionProvider::HttpBasedConnection,
        ConnectionProvider::UpdateOptionsInterface {
    public {
        #! real options used when creating an object
        hash<auto> real_opts;

        #! Connections needs authorization?
        bool needs_auth;

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "REST Connection",
            "short_desc": "A connection to a REST server",
            "desc": "A connection to a REST server",
            "cls": Class::forName("RestConnection"),
            "schemes": {
                "rests": True,
                "rest": True,
            },
            "base_scheme_map": {
                "https": "rests",
                "http": "rest",
            },
            "options": HttpConnection::ConnectionScheme.options + {
                "allow_any_response": <ConnectionOptionInfo>{
                    "display_name": "Allow Any Response?",
                    "short_desc": "If set, undeserializable responses will be returned as-is",
                    "type": "bool",
                    "desc": "If set, undeserializable responses will be returned as-is; this is useful when making "
                        "REST-like requests that return HTML or file data",
                },
                "content_encoding": <ConnectionOptionInfo>{
                    "display_name": "Compression",
                    "short_desc": "Sets data compression / encoding",
                    "type": "string",
                    "desc": "Sets the data compression / send encoding (if the `send_encoding` option is not set) "
                        "and the response encoding used",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "gzip",
                            "desc": "use GNU zip encoding ([RFC 1952](https://tools.ietf.org/html/rfc1952))",
                        }, <AllowedValueInfo>{
                            "value": "bzip2",
                            "desc": "use bzip2 encoding",
                        }, <AllowedValueInfo>{
                            "value": "deflate",
                            "desc": "use the deflate algorithm ([RFC 1951](https://tools.ietf.org/html/rfc1951))",
                        }, <AllowedValueInfo>{
                            "value": "identity",
                            "desc": "use no content encoding",
                        },
                    ),
                },
                "custom_token_auth": <ConnectionOptionInfo>{
                    "display_name": "Custom Token Refresh Auth Method",
                    "short_desc": "Sets the auth method for custom token refresh actions",
                    "desc": "Sets the auth method for custom token refresh actions",
                    "type": "string",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "body-user-pass",
                            "desc": "Include the username and password in the message body; cannot be used with "
                                "`custom_token_method` = `GET`",
                        },
                    ),
                },
                "custom_token_location": <ConnectionOptionInfo>{
                    "display_name": "Custom Token Refresh Location",
                    "short_desc": "Provides the location of the new token in the response",
                    "desc": "Provides the location of the new token in the response",
                    "type": "string",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "body-direct",
                            "desc": "Take the token from the response body directly",
                        },
                        <AllowedValueInfo>{
                            "value": "body-plain",
                            "desc": "Take the token from the response body without any deserialization",
                        },
                    ),
                },
                "custom_token_method": <ConnectionOptionInfo>{
                    "display_name": "Custom Token Refresh Method",
                    "short_desc": "Sets the HTTP method for custom token refresh actions",
                    "desc": "Sets the HTTP method for custom token refresh actions",
                    "type": "string",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "display_name": "GET",
                            "short_desc": "HTTP GET method",
                            "desc": "HTTP `GET` method",
                            "value": "GET",
                        },
                        <AllowedValueInfo>{
                            "display_name": "PATCH",
                            "short_desc": "HTTP PATCH method",
                            "desc": "HTTP `PATCH` method",
                            "value": "PATCH",
                        },
                        <AllowedValueInfo>{
                            "display_name": "POST",
                            "short_desc": "HTTP POST method",
                            "desc": "HTTP `POST` method",
                            "value": "POST",
                        },
                        <AllowedValueInfo>{
                            "display_name": "PUT",
                            "short_desc": "HTTP GET method",
                            "desc": "HTTP `GET` method",
                            "value": "GET",
                        },
                    ),
                },
                "custom_token_path": <ConnectionOptionInfo>{
                    "display_name": "Custom Token Refresh URI Path",
                    "short_desc": "Sets the URI path for the request for custom token refresh actions",
                    "desc": "Sets the URI path for the request for custom token refresh actions",
                    "type": "string",
                },
                "data": <ConnectionOptionInfo>{
                    "display_name": "Data Serialization",
                    "short_desc": "Sets how data is serialized",
                    "type": "string",
                    "desc": "Sets how data is serialized in requests",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "auto",
                            "desc": "prefers in this order: `json`, `yaml`, `rawxml`, `xml`, `url`, and `text`",
                        }, <AllowedValueInfo>{
                            "value": "bin",
                            "desc": "for binary message bodies without data serialization",
                        }, <AllowedValueInfo>{
                            "value": "json",
                            "desc": "use JSON serialization",
                        }, <AllowedValueInfo>{
                            "value": "rawxml",
                            "desc": "use raw XML serialization",
                        }, <AllowedValueInfo>{
                            "value": "text",
                            "desc": "use only plain text; no serialization is used",
                        }, <AllowedValueInfo>{
                            "value": "url",
                            "desc": "for URL-encoded message bodies",
                        }, <AllowedValueInfo>{
                            "value": "xml",
                            "desc": "use only XML-RPC serialization",
                        }, <AllowedValueInfo>{
                            "value": "yaml",
                            "desc": "use only YAML serialization",
                        },
                    ),
                    "default_value": "auto",
                },
                "headers": <ConnectionOptionInfo>{
                    "display_name": "HTTP Headers",
                    "short_desc": "Sets headers to send in each request",
                    "type": "hash",
                    "desc": "Sets an optional hash of headers to send with every request, these can also be "
                        "overridden in request method calls",
                },
                "oauth2_alt_token_url": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Alternate Token URL",
                    "short_desc": "An alternate token URL which will be used to wrap the call to get the token",
                    "type": "string",
                    "desc": "An alternate token URL which will be used to wrap the call to get the token; if this is "
                        "set, then it takes precedence over `oauth2_token_url`",
                },
                "oauth2_alt_url_subst": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Alternate URL Substitution Info",
                    "short_desc": "Optional URL substitution info for token requests to the alternate server",
                    "type": "hash",
                    "desc": "Optional URL substitution info for token requests to the alternate server",
                },
                "oauth2_app": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Application",
                    "short_desc": "Sets a hint to external programs for the OAuth2 config",
                    "type": "string",
                    "desc": "This is a hint to external programs processing OAuth2 requests to external "
                        "configuration for the OAuth2 configuration",
                },
                "oauth2_auth_args": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Authorization Args",
                    "short_desc": "Optional arguments for authentication requests for the authorization_code grant type",
                    "type": "hash",
                    "desc": "Optional arguments for authentication requests for the `authorization_code` grant type; "
                        "ignored if the `token` option is set.  Note that the `authorization_code` grant type "
                        "requires external user authorization to acquire an access token",
                },
                "oauth2_auth_url": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Auth URL",
                    "short_desc": "Sets the OAuth2 authorization URL for the authorization_code grant type",
                    "type": "string",
                    "desc": "The OAuth2 authorization URL for the `authorization_code` grant type; ignored "
                        "if the `token` option is set.  Note that the `authorization_code` grant type requires "
                        "external user authorization to acquire an access token",
                },
                "oauth2_auto_refresh": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Auto Refresh",
                    "short_desc": "Sets if OAuth2 tokens should be automatically refreshed; also enables any custom "
                        "token refresh in case pure OAuth2 is not in use",
                    "type": "bool",
                    "desc": "If OAuth2 tokens should be automatically refreshed",
                    "default_value": True,
                },
                "oauth2_client_id": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Client ID",
                    "short_desc": "Sets the OAuth2 client ID",
                    "type": "string",
                    "desc": "The OAuth2 client ID; ignored for logins if the `token` option is set (but possibly "
                        "used when refreshing tokens)",
                },
                "oauth2_client_secret": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Client Secret",
                    "short_desc": "Sets the OAuth2 client secret",
                    "type": "string",
                    "desc": "Sets the OAuth2 client secret; ignored for logins if the `token` option is set (but "
                        "possibly used when refreshing tokens)",
                    "sensitive": True,
                },
                "oauth2_grant_type": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Grant Type",
                    "short_desc": "Sets the OAuth2 grant type",
                    "type": "string",
                    "desc": "The OAuth2 grant type; ignored for logins if the `token` option is set",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "authorization_code",
                            "desc": "OAuth2 2.0 authorization code grant "
                                "([RFC 6749 authorization code grant]"
                                "(https://datatracker.ietf.org/doc/html/rfc6749#section-4.1)); this grant type "
                                "requires external user authorization to acquire an access token; the "
                                "`oauth2_auth_url` must be set to inform external code where to request "
                                "authorization from the external authorization server",
                        }, <AllowedValueInfo>{
                            "value": "implicit",
                            "desc": "OAuth2 2.0 implicit grant "
                                "([RFC 6749 implicit grant]"
                                "(https://datatracker.ietf.org/doc/html/rfc6749#section-4.2)); this grant type "
                                "returns the access token directly in the redirect URL fragment without a code "
                                "exchange step; requires external user authorization; the `oauth2_auth_url` must "
                                "be set; no `oauth2_token_url` is required",
                        }, <AllowedValueInfo>{
                            "value": "client_credentials",
                            "desc": "OAuth2 2.0 client credentials grant "
                                "([RFC 6749 client credentials grant]"
                                "(https://datatracker.ietf.org/doc/html/rfc6749#section-1.3.4))",
                        }, <AllowedValueInfo>{
                            "value": "password",
                            "desc": "OAuth2 2.0 legacy password grant "
                                "([RFC 6749 password grant]"
                                "(https://datatracker.ietf.org/doc/html/rfc6749#section-1.3.3))",
                        }, <AllowedValueInfo>{
                            "value": "none",
                            "desc": "No OAuth2 grant flow will be used",
                        },
                    ),
                },
                "oauth2_pkce": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 PKCE",
                    "short_desc": "Sets a hint to external applications to use PKCE (Proof Key Code Exchange) with "
                        "the authorization code flow",
                    "type": "string",
                    "desc": "The code challenge method for PKCE (Proof Key Code Exchange) with the "
                        "`authorization_code` flow",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "none",
                            "desc": "PKCE will not be used",
                        }, <AllowedValueInfo>{
                            "value": "plain",
                            "desc": "No encoding will be made with the code challenge when PKCE is used",
                        }, <AllowedValueInfo>{
                            "value": "S256",
                            "desc": "The code challenge will be sent as a URL-encoded SHA-256 digest when PKCE is "
                                "used",
                        },
                    ),
                    "default_value": "none",
                    # set for backwards compatibility since the type changed from bool -> string
                    "ignore_types": {
                        Type::Boolean: True,
                    },
                },
                "oauth2_redirect_url": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Redirect URL",
                    "short_desc": "The OAuth2 redirect URL for the authorization code grant type",
                    "type": "string",
                    "desc": "The OAuth2 redirect URL for the `authorization_code` grant type; ignored "
                        "if the `token` option is set.  Note that the `authorization_code` grant type requires "
                        "external user authorization to acquire an access token; the special value `auto` (the "
                        "default) is meant to be interpreted by servers that implement OAuth2 authorization code "
                        "client handling",
                    "default_value": "auto",
                },
                "oauth2_refresh_token": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Refresh Token",
                    "short_desc": "Sets the OAuth2 refresh token",
                    "type": "string",
                    "desc": "Sets the OAuth2 refresh token, if any (complements option `token`)",
                    "sensitive": True,
                },
                "oauth2_scopes": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Scopes",
                    "short_desc": "List of OAuth2 scopes to request",
                    "type": "list",
                    "desc": "List of OAuth2 scope strings to request; ignored if the `token` option is set",
                },
                "oauth2_scope_separator_char": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Scope Separator",
                    "short_desc": "A separator character for OAuth2 scopes in URI arguments",
                    "type": "string",
                    "desc": "A separator character for OAuth2 scopes in URI arguments",
                },
                "oauth2_token_args": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Token Refresh Args",
                    "short_desc": "Optional extra arguments for token requests",
                    "type": "hash",
                    "desc": "Optional extra arguments for token refresh requests; if this option is set as well as "
                        "`oauth2_alt_token_url`, then the `oauth2_token_url` value will be added to this as well "
                        "when the request is made to the `oauth2_alt_token_url`",
                },
                "oauth2_token_auth_secret_only": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Token Auth Client Secret Only?",
                    "short_desc": "Use basic authorization with the client secret only when making token requests",
                    "type": "bool",
                    "desc": "Use basic authorization with the client secret only when making token requests",
                },
                "oauth2_token_expiry": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Token Expiry Date",
                    "short_desc": "The expiry date for the token",
                    "type": "date",
                    "desc": "The expiry date for the token",
                },
                "oauth2_token_expiry_hint": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Token Lifetime Hint in Minutes",
                    "short_desc": "The expected number of minutes that a token will remain valid before it must be "
                        "refreshed",
                    "type": "int",
                    "desc": "The expected number of minutes that a token will remain valid before it must be "
                        "refreshed. This option is only used when the connection has a refresh token and the server "
                        "does not indicate the lifetime of the token in token responses",
                },
                "oauth2_token_url": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Token URL",
                    "short_desc": "The token URL for OAuth2 flows",
                    "type": "string",
                    "desc": "The token URL for OAuth2 flows; ignored for logins if the `token` option is set",
                },
                "oauth2_token_use_basic_auth": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Token Use Basic Auth?",
                    "short_desc": "Use basic authorization with the client ID and client secret when making token "
                        "requests",
                    "type": "bool",
                    "desc": "Use basic authorization with the client ID and client secret when making token "
                        "requests",
                },
                "oauth2_redirect_passthrough_state": <ConnectionOptionInfo>{
                    "display_name": "OAuth2 Redirect Passthrough State?",
                    "short_desc": "If False, embed state in redirect_uri for non-compliant OAuth2 providers",
                    "type": "bool",
                    "default_value": True,
                    "desc": "Per OAuth2 spec (RFC 6749), the state parameter should be returned by the "
                        "authorization server. Some providers (like Trello) do not pass through the state "
                        "parameter. Set this to False to embed the state in the redirect_uri as a workaround "
                        "for non-compliant providers. Default: True (spec-compliant behavior).",
                },
                "openapi3": <ConnectionOptionInfo>{
                    "display_name": "OpenApi 3 Schema",
                    "short_desc": "Sets the location of an OpenApi 3 schema to use for the connection",
                    "type": "file-as-string",
                    "desc": "Sets the location of an OpenApi 3 schema to use for message validation; processed with "
                        "`FileLocationHandler::getTextFileFromLocation()` "
                        "(ex: `file:///path/to/swagger-schema.json`); conflicts with `swagger` and `validator`",
                    "freeform": True,
                },
                "password": <ConnectionOptionInfo>{
                    "display_name": "Password",
                    "short_desc": "The password for authentication",
                    "type": "string",
                    "desc": "The password for authentication; only used if no username or password is set in the URL "
                        "and if the `username` option is also used; conflicts with the `token` option",
                    "sensitive": True,
                },
                "ping_method": <ConnectionOptionInfo>{
                    "display_name": "Ping Method",
                    "short_desc": "The HTTP method to use for pings",
                    "type": "string",
                    "desc": "The HTTP method to use for an advanced ping; this and `ping_path` must be set to make "
                        "an HTTP request as a part of the socket polling ping operation; must be a valid HTTP method "
                        "name",
                },
                "ping_path": <ConnectionOptionInfo>{
                    "display_name": "Ping Path",
                    "short_desc": "The URI path to use for pings",
                    "type": "string",
                    "desc": "The URI path to use for an advanced ping; this and `ping_method` must be set to make "
                        "an HTTP request as a part of the socket polling ping operation.  If the value for this "
                        "option begins with a `/` character, then it replaces any connection path for the REST "
                        "client, otherwise the value is appended to the connection path for the REST client.",
                },
                "ping_headers": <ConnectionOptionInfo>{
                    "display_name": "Ping Headers",
                    "short_desc": "Any HTTP headers to send with pings",
                    "type": "hash",
                    "desc": "Any HTTP headers to send when performing an advanced ping operation; ignored if either "
                        "one of `ping_method` and `ping_path` are not set",
                },
                "ping_body": <ConnectionOptionInfo>{
                    "display_name": "Ping Body",
                    "short_desc": "The message body to send with pings",
                    "type": "auto",
                    "desc": "Any message body to send when performing an advanced ping operation; ignored if either "
                        "one of `ping_method` and `ping_path` are not set or if `ping_method` is `GET`",
                },
                "rest_body_auth_error_check": <ConnectionOptionInfo>{
                    "display_name": "REST Body Auth Error Check",
                    "short_desc": "A hash to check all deserialized bodies in 200 OK server responses for "
                        "authentication errors",
                    "type": "hash",
                    "desc": "A hash to check all deserialized bodies from the server to check for authentication "
                        "errors",
                },
                "send_encoding": <ConnectionOptionInfo>{
                    "display_name": "Send Compression",
                    "short_desc": "Sets the compression algorithm to use when sending messages",
                    "type": "string",
                    "desc": "Sets the compression algorithm to use when sending messages",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "gzip",
                            "desc": "use GNU zip encoding ([RFC 1952](https://tools.ietf.org/html/rfc1952))",
                        }, <AllowedValueInfo>{
                            "value": "bzip2",
                            "desc": "use bzip2 encoding",
                        }, <AllowedValueInfo>{
                            "value": "deflate",
                            "desc": "use the deflate algorithm ([RFC 1951](https://tools.ietf.org/html/rfc1951))",
                        }, <AllowedValueInfo>{
                            "value": "identity",
                            "desc": "use no content encoding",
                        },
                    ),
                },
                "swagger": <ConnectionOptionInfo>{
                    "display_name": "Swagger Schema",
                    "short_desc": "Sets the location of a Swagger schema to use for the connection",
                    "type": "file-as-string",
                    "desc": "Sets the location of a Swagger schema to use for message validation; processed with "
                        "`FileLocationHandler::getTextFileFromLocation()` "
                        "(ex: `file:///path/to/swagger-schema.json`); conflicts with `openapi3` and `validator`",
                    "freeform": True,
                },
                "swagger_base_path": <ConnectionOptionInfo>{
                    "display_name": "Override Schema Base Path",
                    "short_desc": "Overrides the base path for REST / Swagger schemas",
                    "type": "string",
                    "desc": "In case a REST validator is used, the base path in the schema can be overridden "
                        "with this option (applies to any REST validator; not just Swagger validators)",
                },
                "swagger_lax_parsing": <ConnectionOptionInfo>{
                    "display_name": "Swagger Lax Parsing",
                    "short_desc": "Sets lax parsing for Swagger schemas",
                    "type": "bool",
                    "desc": "Try to parse invalid Swagger schemas; this option is not recommended; it will not parse "
                        "all bad Swagger schemas; schemas should be corrected instead of setting this option",
                },
                "token": <ConnectionOptionInfo>{
                    "display_name": "Authorization Token",
                    "short_desc": "Set an authorization token to be included in requests",
                    "type": "string",
                    "desc": "Any authorization token to use for the connection; will be passed as "
                        "`Authorization: Bearer ...` (assuming that `token_type` is `Bearer`) in request headers; "
                        "this option cannot be used with username "
                        "and password options or authentication information in the URL; if this option is set then "
                        "most OAuth2 options are ignored for logins",
                    "sensitive": True,
                },
                "token_api_key_header": <ConnectionOptionInfo>{
                    "display_name": "API Key Header",
                    "short_desc": "The name of the HTTP header where the token will be sent as an API key",
                    "type": "string",
                    "desc": "The name of the HTTP header where `token` will be sent as an API key; this option is "
                        "incompatible with OAuth2 options",
                },
                "token_type": <ConnectionOptionInfo>{
                    "display_name": "Authorization Token Type",
                    "short_desc": "The type of authorization token",
                    "type": "string",
                    "desc": "The type of `token` to use for the `Authorization` header; ignored if no `token` "
                        "option is set",
                    "default_value": "Bearer",
                },
                "username": <ConnectionOptionInfo>{
                    "display_name": "Username",
                    "short_desc": "Sets the username for authentication",
                    "type": "string",
                    "desc": "The username for authentication; only used if no username or password is set in the "
                        "URL; conflicts with the `token` option",
                },
                "validator": <ConnectionOptionInfo>{
                    "display_name": "Schema Validator",
                    "short_desc": "Sets a schema validator object",
                    "type": "auto",
                    "desc": "Sets an `AbstractRestSchemaValidator` object for REST message validation; conflicts with "
                        "`openapi3` and `swagger`",
                },
            },
        };

        #! object connection options
        const Options = map {$1: True}, keys ConnectionScheme.options;

        #! object connection option list
        const OptionList = keys ConnectionScheme.options;

        #! Options required for an OAuth2 authorization_code authorization request
        const OAuth2AuthRequestOptions = (
            "oauth2_auth_url",
            "oauth2_token_url",
            "oauth2_client_id",
            "oauth2_client_secret",
            "oauth2_redirect_url",
        );

        #! Options required for an OAuth2 implicit authorization request
        /** @note oauth2_token_url and oauth2_client_secret are not required for implicit grant
            since the token is returned directly in the URL fragment
        */
        const OAuth2ImplicitAuthRequestOptions = (
            "oauth2_auth_url",
            "oauth2_client_id",
            "oauth2_redirect_url",
        );

        #! All OAuth2 options
        const OAuth2Options = (
            "oauth2_alt_token_url",
            "oauth2_alt_url_subst",
            "oauth2_app",
            "oauth2_auto_refresh",
            "oauth2_auth_args",
            "oauth2_auth_url",
            "oauth2_client_id",
            "oauth2_client_secret",
            "oauth2_grant_type",
            "oauth2_pkce",
            "oauth2_redirect_url",
            "oauth2_redirect_passthrough_state",
            "oauth2_refresh_token",
            "oauth2_scopes",
            "oauth2_token_args",
            "oauth2_token_expiry",
            "oauth2_token_expiry_hint",
            "oauth2_token_url",
            "oauth2_token_auth_secret_only",
            "oauth2_token_use_basic_auth",
            "password",
            "username",
        );

        #! RestClient feature: OAuth2 Auth Code support
        /** Returned as a connection feature if the connection is configured for the oauth2 authorization_code grant
            flow
        */
        const RCF_OAUTH2_AUTH_CODE = "oauth2-auth-code";

        #! RestClient feature: OAuth2 Implicit Grant support
        /** Returned as a connection feature if the connection is configured for the oauth2 implicit grant flow

            @since %RestClient 2.3.3
        */
        const RCF_OAUTH2_IMPLICIT = "oauth2-implicit";

        #! RestClient feature: OAuth2 Authorization support (any grant type requiring user authorization)
        /** Returned as a connection feature if the connection is configured for oauth2 authorization_code or
            implicit grant flow

            @since %RestClient 2.3.3
        */
        const RCF_OAUTH2_AUTH = "oauth2-auth";

        #! Validator options
        const ValOpts = (
            "openapi3",
            "swagger",
            "validator",
        );
    }

    private {
        #! To use to sign requests to the any alt token URL
        transient *code alt_token_signer;
        #! The header for the alt token signer
        transient *string alt_token_signer_header;

        #! Hash of supported features
        hash<string, bool> features = {
            CF_LOGGER: True,
        };
    }

    #! creates the RestConnection connection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options; see class documentation for information on supported options

        See \c AbstractConnection::constructor() for \c attributes and \c options reference.

        @par Additional Attributes
        - \c error a custom error string

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url, hash<auto> attributes = {}, hash<auto> options = {})
            : HttpBasedConnection(name, description, url, attributes, RestConnection::processOptions(name, options)) {
        setupRest();
    }

    #! creates the RestConnection connection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : HttpBasedConnection(config, attr) {
        setupRest();
    }

    #! Accepts a LoggerInterface object for logging (or clears it)
    setLogger(*LoggerInterface logger) {
        LoggerWrapper::setLogger(logger);
        if (real_opts.validator instanceof AbstractRestSchemaValidator) {
            real_opts.validator.setLogger(logger);
        }
    }

    #! Returns the logger interface for logging
    *LoggerInterface getLogger() {
        return logger;
    }

    #! Returns True if the connection requires OAuth2 authorization before it can be used
    /** @return @ref True if the connection requires OAuth2 authorization, @ref False if already authorized, or the
        connection does not support authorization

        @since RestClient 2.2
    */
    bool needsAuth() {
        return needs_auth || ((opts.oauth2_grant_type == "authorization_code"
                || opts.oauth2_grant_type == "implicit")
            && (!opts.token.val() || (opts.oauth2_token_expiry && now_us() > opts.oauth2_token_expiry))
            && (!opts.oauth2_refresh_token.val() || !opts.oauth2_auto_refresh));
    }

    #! Returns connection info plus any extended information returned by the connection
    /** The default implementation in the base class returns the same value as getInfo(*hash<auto>)

        @param opts connection information options; options are connection-specific; the only universal option is
        \c with_passwords: if @ref True, then passwords are returned in the info hash

        @return Connection info plus any extended information returned by the connection

        @note Some of the information in this hash may be non-serializable objects, for a method that returns only
        serializable information about the connection, see @ref getExtendedInfoAsData()
    */
    hash<auto> getExtendedInfo(*hash<auto> opts) {
        return AbstractConnection::getExtendedInfo(opts) + {
            "oauth2_auth_code": features{RCF_OAUTH2_AUTH_CODE} ? True : False,
            "oauth2_implicit": features{RCF_OAUTH2_IMPLICIT} ? True : False,
            "oauth2_auth": features{RCF_OAUTH2_AUTH} ? True : False,
        };
    }

    #! Returns connection info plus any extended information returned by the connection
    /** The default implementation in the base class returns the same value as getInfoAsData(*hash<auto>)

        @param opts connection information options; options are connection-specific; the only universal option is
        \c with_passwords: if @ref True, then passwords are returned in the info hash

        @return Connection info plus any extended information returned by the connection

        @note All the information in this hash is data; some info in the output of @ref getExtendedInfo() may be objects
    */
    hash<auto> getExtendedInfoAsData(*hash<auto> opts) {
        return AbstractConnection::getExtendedInfoAsData(opts) + {
            "oauth2_auth_code": features{RCF_OAUTH2_AUTH_CODE} ? True : False,
            "oauth2_implicit": features{RCF_OAUTH2_IMPLICIT} ? True : False,
            "oauth2_auth": features{RCF_OAUTH2_AUTH} ? True : False,
        };
    }

    #! Flags an authorization failure
    /**
        @since RestClient 2.2
    */
    authFailure() {
        if (!needs_auth && (opts.oauth2_grant_type == "authorization_code"
                || opts.oauth2_grant_type == "implicit")) {
            needs_auth = True;
        }
    }

    #! Flags a successful connection
    /**
        @since RestClient 2.2
    */
    authSuccess() {
        if (needs_auth && (opts.oauth2_grant_type == "authorization_code"
                || opts.oauth2_grant_type == "implicit")) {
            remove needs_auth;
        }
    }

    #! Returns the OAuth2 option name for this connection
    /** @since %RestClient 2.0
    */
    string getOAuth2OptionName(string opt) {
        return opt;
    }

    #! Returns an unconnected object for a non-blocking poll operation
    /** @return an unconnected object for a non-blocking poll operation

        @since %RestClient 1.9.1
    */
    object getPollImpl() {
        # ensure that no validator is used, as loading the schema cannot be done in a nonblocking way in the polling
        # thread
        hash<auto> new_opts;
        if (real_opts.validator instanceof AbstractRestSchemaValidator) {
            new_opts.validator = real_opts.validator;
        } else {
            new_opts.validator = new NullRestSchemaValidator(logger);
        }
        return setupRestClientConfig(getImpl(False, new_opts));
    }

    #! gets options
    /** @return returns a hash with supported options

        @see class documentation for information on supported options
    */
    hash<auto> getOptions() {
        return Options;
    }

    #! returns \c "rest"
    string getType() {
        return "rest";
    }

    #! Returns OAuth2 options in a standard format
    /** @since %RestClient 2.0
    */
    hash<auto> getOAuth2Options() {
        return real_opts{OAuth2Options};
    }

    #! Processes the OAuth2 token response
    /** @since %RestClient 2.0
    */
    hash<auto> processOAuth2TokenResponse(hash<auto> resp) {
        *hash<auto> new_opts = processOAuth2TokenResponseImpl(resp);
        if (new_opts && update_options) {
            doUpdateOptions(self, new_opts);
        }
        if (needs_auth && (new_opts.token || new_opts.oauth2_refresh_token)) {
            remove needs_auth;
        }
        return (real_opts - "url") + new_opts;
    }

    #! Returns headers to use with OAuth2 authorization / token requests
    /** @since %RestClient 2.2
    */
    *hash<auto> getOAuth2AuthHeaders() {
        return RestClient::OAuth2AuthHeaders;
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection; the data provider is:
        - \c SwaggerDataProvider: if an appropriate schema is configured
        - \c RestClientDataProvider: if there is no schema configured

        @throw DATA-PROVIDER-ERROR this object does not support the data provider API
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        if (opts.validator || opts.swagger || opts.openapi3) {
            # get a REST client object without connecting
            RestClient rest = get(False);
            # get the validator and return the provider
            return rest.getValidator().getDataProvider(rest);
        }

        # to avoid circular dependencies, this object loads the RestClientDataProvider and creates the data provider
        # object dynamically
        load_module("RestClientDataProvider");
        return create_object("RestClientDataProvider", get());
    }

    #! returns @ref True, as this connection always returns a data provider with the \c getDataProvider() method
    /** @return @ref True, as this connection always returns a data provider with the \c getDataProvider() method

        @see \c getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Called to start a non-blocking polling ping operation on the remote REST server
    /**
        @return a socket poll operation object that will allow the connection goal to be reached with polling

        @see supportsPollingApi()
    */
    Qore::AbstractPollOperation startPollConnect(*Logger::LoggerInterface logger) {
        *string ping_path;
        if (!real_opts.ping_method || !exists (ping_path = getPingPath())) {
            return HttpBasedConnection::startPollConnect(logger);
        }
        auto ping_body = getPingBody();

        RestClient client = getPollImpl();
        if (logger) {
            client.setLogger(logger);
        }

        # returns a RestClient option without connecting and without retrieving any external schemas with I/O
        return new RestPingPollOperation(self, client, real_opts + {
            "ping_path": ping_path,
            "ping_body": ping_body,
        });
    }

    #! Called after a new connection object is created from an existing connection
    /** @param old the old connection object
    */
    persistInfo(RestConnection old) {
        if (old.needs_auth) {
            needs_auth = True;
        }
    }

    #! processes options for the constructor
    /** In particular it parses any string as a value of the \c "headers" option to return a hash
    */
    static hash<auto> processOptions(string name, *hash<auto> opts) {
        on_error rethrow $1.err, sprintf("Connection %y: %s", name, $1.desc);
        hash<auto> rv = {} + opts;
        switch (opts.headers.typeCode()) {
            case NT_NOTHING:
            case NT_HASH:
                break;
            case NT_STRING: {
                auto v = parse_to_qore_value(opts.headers);
                if (v.typeCode() != NT_HASH) {
                    throw "REST-CONNECTION-ERROR", sprintf("\"headers\" option string parsed to "
                        "type %y (value: %y); expecting \"hash\"", v.type(), v);
                }
                v = map {$1.key: $1.value.toString()}, v.pairIterator();
                rv.headers = v;
                break;
            }
            default:
                throw "REST-CONNECTION-ERROR", sprintf("\"headers\" option is type %y; expecting \"hash\"",
                    opts.headers.type());
        }
        # prefer "validator" over "swagger"
        if ((*list<string> l = keys opts{ValOpts}).size() > 1) {
            throw "REST-CONNECTION-ERROR", sprintf("cannot include %y options at the same time; only one option for a "
                "validator can be provided", l);
        }
        if (opts.validator && !(opts.validator instanceof AbstractRestSchemaValidator)) {
            throw "REST-CONNECTION-ERROR", sprintf("\"validator\" is type %y; expecting an "
                "AbstractRestSchemaValidator object", opts.validator.fullType());
        }
        return rv;
    }

    #! Returns a URI for an OAuth2 authorization request
    /** The \c oauth2_grant_type must be \c authorization_code or \c implicit.

        For \c authorization_code: \c oauth2_client_id, \c oauth2_auth_url, \c oauth2_token_url,
        \c oauth2_client_secret, and \c oauth2_redirect_url must be set.

        For \c implicit: \c oauth2_client_id, \c oauth2_auth_url, and \c oauth2_redirect_url must be set.
        The \c oauth2_token_url and \c oauth2_client_secret are not required for implicit grant since the
        token is returned directly in the URL fragment.

        @param info context information for the authorization request; the PKCE verifier must be set by the
        caller if the \c oauth2_pkce option is set to a value other than \c none; the @ref generatePkceChallenge()
        method can be used to generate a valid verifier value

        @since %RestClient 2.0
    */
    string getAuthorizationCodeRequest(hash<AuthCodeInfo> info = <AuthCodeInfo>{}) {
        if (opts.oauth2_grant_type != "authorization_code" && opts.oauth2_grant_type != "implicit") {
            throw "OAUTH2-ERROR", sprintf("oauth2_grant_type is %y; must be \"authorization_code\" or \"implicit\" "
                "to get an authorization request URI", opts.oauth2_grant_type);
        }
        # Use appropriate options list based on grant type
        list<string> req_opts = opts.oauth2_grant_type == "implicit"
            ? OAuth2ImplicitAuthRequestOptions
            : OAuth2AuthRequestOptions;
        foreach string key in (req_opts) {
            string optname = getOAuth2OptionName(key);
            if (!opts{optname}.val()) {
                throw "OAUTH2-ERROR", sprintf("option %y is not set; this option must be set to retrieve an "
                    "authorization request URI", optname);
            }
        }
        # get local names for options
        string oauth2_client_id_opt = getOAuth2OptionName("oauth2_client_id");
        *list<auto> scopes = info.hasKey("scopes") ? info.scopes : real_opts.oauth2_scopes;
        *string scope = RestClient::getScopeString(scopes, real_opts.oauth2_scope_separator_char);
        if (scope.val()) {
            scope = encode_url(scope);
        }
        string uri = getAuthUrl();
        if (uri =~ /\?/) {
            uri += "&";
        } else {
            uri += "?";
        }
        # For implicit grant, response_type should be "token" per RFC 6749 section 4.2.1
        # Default to "token" if the caller hasn't explicitly set a different value
        string response_type = info.response_type;
        if (opts.oauth2_grant_type == "implicit" && response_type == "code") {
            response_type = "token";
        }
        # For implicit grant with non-compliant providers, embed state in the redirect_uri
        # since some providers (like Trello) don't pass through the state parameter.
        # This is controlled by oauth2_redirect_passthrough_state option (default: True = spec-compliant)
        string redirect_uri = info.redirect_uri ?? opts.oauth2_redirect_url;
        bool embed_state = opts.oauth2_grant_type == "implicit"
            && !(opts.oauth2_redirect_passthrough_state ?? True);
        if (embed_state && info.state) {
            # Append state as a query parameter to the redirect_uri (URL-encoded for safety)
            string encoded_state = encode_url(info.state, True);
            if (redirect_uri =~ /\?/) {
                redirect_uri += "&state=" + encoded_state;
            } else {
                redirect_uri += "?state=" + encoded_state;
            }
        }
        uri += sprintf("scope=%s&redirect_uri=%s&client_id=%s&response_type=%s", scope,
            encode_url(redirect_uri, True), opts{oauth2_client_id_opt},
            response_type);
        # For implicit grant, also add return_url since some providers (like Trello) use that instead of redirect_uri
        if (opts.oauth2_grant_type == "implicit") {
            uri += sprintf("&return_url=%s", encode_url(redirect_uri, True));
        }
        # add any optional auth args (skip return_url if we already added it for implicit grant)
        foreach hash<auto> arg in (opts.oauth2_auth_args.pairIterator()) {
            if (opts.oauth2_grant_type == "implicit" && arg.key == "return_url") {
                continue;
            }
            # Handle template substitution for oauth2_auth_args values
            # Template format: {{option_name}} - substitutes with the option value
            auto val = arg.value;
            if (val.typeCode() == NT_STRING) {
                # Check for {{option_name}} template pattern
                *list<*string> match = (val =~ x/^\{\{(\w+)\}\}$/);
                if (match) {
                    string opt_name = match[0];
                    # Try to get the option value (check both with and without oauth2_ prefix)
                    if (opts{opt_name}.val()) {
                        val = opts{opt_name};
                    } else if (opts{"oauth2_" + opt_name}.val()) {
                        val = opts{"oauth2_" + opt_name};
                    }
                }
            }
            uri += sprintf("&%s=%s", arg.key, getUriValue(val, real_opts.oauth2_scope_separator_char));
        }
        # Always add state as a separate parameter per RFC 6749 for CSRF protection
        # For implicit grant with non-compliant providers, state is also embedded in redirect_uri above
        if (info.state) {
            uri += sprintf("&state=%s", info.state);
        }
        if (info.code_verifier.val() && opts.oauth2_pkce && (opts.oauth2_pkce != "none")) {
            string code_challenge;
            if (opts.oauth2_pkce == "S256") {
                code_challenge = make_base64_url_string(digest("sha256", info.code_verifier));
            } else {
                code_challenge = info.code_verifier;
            }
            uri += sprintf("&code_challenge=%s&code_challenge_method=%s", code_challenge, opts.oauth2_pkce);
        }
        return uri;
    }

    #! Generates a random 64-byte PKCE verifier string
    static string generatePkceChallenge() {
        return make_base64_url_string(get_random_bytes(48));
    }

    #! Returns the OAuth2 authorization URL or throws an exception if not set
    /*  @param allow_relative if @ref True then a relative URL (path only) can be returned; the default (@ref False)
        is to return a full URL

        @since %RestClient 2.0
    */
    string getAuthUrl(*bool allow_relative) {
        return getUrlOption("oauth2_auth_url", allow_relative);
    }

    #! Returns the OAuth2 token URL or throws an exception if not set
    /*  @param allow_relative if @ref True then a relative URL (path only) can be returned; the default (@ref False)
        is to return a full URL

        @since %RestClient 2.0
    */
    string getTokenUrl(*bool allow_relative) {
        string url_opt = getOAuth2OptionName("oauth2_alt_token_url");
        *string uri = opts{url_opt};
        if (!uri) {
            url_opt = getOAuth2OptionName("oauth2_token_url");
            uri = opts{url_opt};
            if (!uri) {
                throw "OAUTH2-AUTH-ERROR", sprintf("neither \"oauth2_alt_token_url\" nor \"oauth2_token_url\" is set "
                    "on connection %y", name);
            }
        }
        return getUrlOptionIntern(uri, allow_relative);
    }

    #! Returns options for creating a new connection
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        return real_opts + (rtopts.validator ? {"validator": rtopts.validator} : NOTHING + {
            "logger": logger,
            "update_options": update_options,
        });
    }

    #! Sets alt token signer code and the header for it
    /** @since %RestClient 2.2
    */
    setAltTokenSigner(code signer, string signer_header) {
        alt_token_signer = signer;
        alt_token_signer_header = signer_header;
    }

    #! Clears alt token signer code and the header for it
    /** @since %RestClient 2.2
    */
    clearAltTokenSigner() {
        remove self{"alt_token_signer", "alt_token_signer_header"};
    }

    #! returns the underlying connection object
    /** calls @ref getImpl() to actually acquire the connection object
    */
    RestClient get(bool connect = True, *hash<auto> rtopts) {
        RestClient rest = HttpBasedConnection::get(connect, rtopts);
        return setupRestClientConfig(rest);
    }

    #! Common REST client initialization
    /** @since RestClient 2.2.0
    */
    private setupRest() {
        real_opts = {"url": real_url} + opts;
        if (urlh.username.val() && !opts.username) {
            real_opts.username = urlh.username;
        }
        if (urlh.password.val() && !opts.password) {
            real_opts.password = urlh.password;
        }

        # setup feature list appropriately
        setFeatures();

        # check if the connection can theoretically communicate, if not, sets the connection as down
        checkCanConnect();
    }

    #! Sets features during REST client initialization
    /** @since RestClient 2.2.0
    */
    private setFeatures() {
        if ((opts.oauth2_grant_type && opts.oauth2_grant_type != "none") || (opts.custom_token_auth)) {
            features{CF_UPDATE_OPTIONS} = True;
        }
        if (opts.oauth2_grant_type == "authorization_code" || opts.oauth2_grant_type == "implicit") {
            checkAuthCodeFeature();
        }
    }

    #! Checks if the connection can theoretically communicate, if not, sets the connection as down
    /** Connections are assumed to be up when created; this method call is made during constructor initialization and
        should set the \c up flag to @ref False and set the \c status key appropriately in case the connection has an
        incomplete or invalid configuration

        @since RestClient 2.2.0
    */
    private checkCanConnect() {
        try {
            if (opts.oauth2_grant_type && opts.oauth2_grant_type != "none") {
                *list<string> req_opts = RestClient::OAuth2GrantOptions{opts.oauth2_grant_type};
                if (!req_opts) {
                    throw "OAUTH2-ERROR", sprintf("OAuth2 grant type %y is unknown; known grant types: %y",
                        opts.oauth2_grant_type, keys RestClient::OAuth2GrantOptions);
                }

                if (*list<string> missing = keys ((map {$1: True}, req_opts) - keys opts)) {
                    throw "OAUTH2-ERROR", sprintf("OAuth2 grant type %y requires the following options to be "
                        "set: %y; the following are not set on this connection: %y",
                        opts.oauth2_grant_type, req_opts, missing);
                }

                switch (opts.oauth2_grant_type) {
                    case "authorization_code":
                    case "implicit": {
                        if (!opts.token && (!opts.oauth2_refresh_token || !opts.oauth2_auto_refresh)) {
                            throw "OAUTH2-ERROR", sprintf("connection %y uses OAuth2 grant type %y but is not yet "
                                "authorized to communicate with the server", name, opts.oauth2_grant_type);
                        }
                        break;
                    }

                    case "password": {
                        if (!opts.username && !urlh.username) {
                            throw "OAUTH2-ERROR", "the 'password' OAuth2 grant type requires a username and "
                                "password; no username is set for the current connection";
                        }
                        break;
                    }
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            info("connection %y cannot connect: %s: %s", name, ex.err, ex.desc);
            up = False;
            status = ex.desc;
        }
    }

    #! Returns the value of a URL option or throws an exception if not set
    /*  @param opt the URL option name
        @param allow_relative if @ref True then a relative URL (path only) can be returned; the default (@ref False)
        is to return a full URL

        @since %RestClient 2.1.1
    */
    private string getUrlOption(string opt, *bool allow_relative) {
        string url_opt = getOAuth2OptionName(opt);
        *string uri = url_opt == "url" ? url : opts{url_opt};
        if (!uri) {
            throw "OAUTH2-AUTH-ERROR", sprintf("no %y option is set on connection %y", url_opt, name);
        }
        return getUrlOptionIntern(uri, allow_relative);
    }

    #! Returns the value of a URL option
    /*  @param uri the URL value
        @param allow_relative if @ref True then a relative URL (path only) can be returned; the default (@ref False)
        is to return a full URL

        @since %RestClient 2.2
    */
    private string getUrlOptionIntern(string uri, *bool allow_relative) {
        if (!allow_relative && uri !~ /^http/) {
            string url = real_url;
            if (url !~ /\/$/) {
                url += "/";
            }
            if (uri =~ /^\//) {
                uri = uri[1..];
            }
            uri = url + uri;
        }
        return uri;
    }

    #! Returns a value for use as a URI parameter
    /*
        @since %RestClient 2.0
    */
    private static softstring getUriValue(auto v, string separator = " ") {
        switch (v.typeCode()) {
            case NT_BOOLEAN:
                return v ? "true" : "false";

            case NT_LIST:
                return RestClient::getScopeString(v, separator);
        }
        return v;
    }

    #! Processes OAuth2 login responses and returns updated options
    private *hash<auto> processOAuth2TokenResponseImpl(hash<auto> resp) {
        hash<auto> new_opts;
        if (resp.hasKey("access_token") && resp.access_token != real_opts.token) {
            new_opts.token = resp.access_token;
        }
        if (resp.expires_in) {
            if (!resp.expires_in.intp()) {
                warn("Ignoring invalid 'expires_in' value with type %y; value: %y", resp.expires_in.fullType(),
                    resp.expires_in);
            } else {
                new_opts.oauth2_token_expiry = now_us() + minutes(resp.expires_in);
            }
        }
        if (resp.refresh_token && resp.refresh_token != real_opts.oauth2_refresh_token) {
            new_opts.oauth2_refresh_token = resp.refresh_token;
        }
        if (resp.url && resp.url != url) {
            new_opts.url = resp.url;
        }
        return new_opts;
    }

    #! Sets the OAuth2 authorization features if supported
    /** Sets the appropriate feature flags based on grant type:
        - \c RCF_OAUTH2_AUTH_CODE for authorization_code grant
        - \c RCF_OAUTH2_IMPLICIT for implicit grant
        - \c RCF_OAUTH2_AUTH for either grant type (general authorization support)

        @since %RestClient 2.3.3 added RCF_OAUTH2_IMPLICIT and RCF_OAUTH2_AUTH features
    */
    private checkAuthCodeFeature() {
        if (opts.oauth2_grant_type == "authorization_code"
                && opts{OAuth2AuthRequestOptions}.size() == OAuth2AuthRequestOptions.size()) {
            features{RCF_OAUTH2_AUTH_CODE} = True;
            features{RCF_OAUTH2_AUTH} = True;
        } else if (opts.oauth2_grant_type == "implicit"
                && opts{OAuth2ImplicitAuthRequestOptions}.size() == OAuth2ImplicitAuthRequestOptions.size()) {
            features{RCF_OAUTH2_IMPLICIT} = True;
            features{RCF_OAUTH2_AUTH} = True;
        }
    }

    #! returns a @ref RestClient::RestClient "RestClient" object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts supports the following runtime option in getImpl():
        - \c "validator": an \c RestSchemaValidator::AbstractRestSchemaValidator "AbstractRestSchemaValidator"
          object for REST message validation (if present, overrides any REST schema validation option provided as a
          connection option)

        @return a @ref RestClient::RestClient "RestClient" object
    */
    private RestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return RestClient rest(getConnectionOptions(rtopts), !connect);
    }

    #! Sets the alt token signer code and header on a RestClient object if applicable
    /** @param rest the RestClient object to set the alt token signer on
        @since %RestClient 2.2
    */
    private RestClient setupRestClientConfig(RestClient rest) {
        if (alt_token_signer) {
            rest.setAltTokenSigner(alt_token_signer, alt_token_signer_header);
        }
        return rest;
    }

    #! performs the internal ping
    /** Uses the ping options to make a request to the server
    */
    private pingImpl() {
        RestClient client = get();
        *string ping_path;
        if (!opts.ping_method || !exists (ping_path = getPingPath())) {
            return;
        }

        auto ping_body;
        if (opts.ping_method != "GET") {
            ping_body = getPingBody();
        }

        if (ping_path =~ /^http/) {
            client.setURL(ping_path);
            ping_path = "";
        } else if (ping_path[0] == "/") {
            client.clearConnectionPath();
        }

        hash<auto> info;
        hash<auto> h = client.doRequest(opts.ping_method, ping_path, ping_body, \info, NOTHING, opts.ping_headers);
        if ((h.status_code / 100) != 2) {
            authFailure();
            throw "REST-PING-ERROR", sprintf("%y returned from %y", info."response-uri", info."request-uri");
        }
        authSuccess();
    }

    #! Returns the ping path from the \c ping_path option
    private *string getPingPath() {
        return opts.ping_path;
    }

    #! Returns the ping body from the \c ping_body option
    private auto getPingBody() {
        return opts.ping_body;
    }

    #! Returns a list of connection-defined features
    /** @since RestClient 2.0
    */
    private *hash<string, bool> getFeaturesImpl() {
        return features;
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
        if (exists opts.validator || exists opts.swagger || exists opts.openapi3) {
            children_can_support_records = True;
        }
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST ping polling I/O class with OAuth2 authentication
/** Ensures a 200 response to the polling send/receive operation
*/
public class RestPingPollOperation inherits Qore::AbstractPollOperation {
    public {
        #! Retrieve Swagger schema
        const SPS_GET_SWAGGER = 'get-swagger';

        #! Retrieve OpenApi 3 schema
        const SPS_GET_OPENAPI3 = 'get-openapi3';

        #! OAuth2 get token state
        const SPS_OAUTH2_GET_TOKEN = "oauth2-get-token";

        #! OAuth2 refresh token state
        const SPS_OAUTH2_REFRESH_TOKEN = "oauth2-refresh-token";

        #! Custom refresh token state
        const SPS_CUSTOM_GET_TOKEN = "custom-refresh";

        #! Execute ping request
        const SPS_REST_PING = "rest-ping";

        #! Complete state
        const SPS_COMPLETE = "complete";
    }

    private {
        #! The REST connection
        RestConnection conn;

        #! The RestClient object to use for polling I/O
        RestClient rc;

        #! RestClient options
        hash<auto> real_opts;

        #! The polling object
        AbstractPollOperation poller;

        #! Goal reached flag
        bool goal_reached = False;

        #! The HTTP method to use
        string method;

        #! The URI path to use
        string path;

        #! The message body to send
        *auto body;

        #! Headers to send
        *hash<auto> headers;

        #! Current state
        string state;

        #! Lock for atomicity
        Mutex m();

        #! token refresh flag
        bool in_refresh;

        #! Use path directly / ping path already prepared
        bool use_path_as_is;
    }

    #! Creates the poller with the REST client and option hash
    constructor(RestConnection conn, RestClient rc, hash<auto> real_opts) {
        self.conn := conn;
        self.rc = rc;
        self.real_opts = real_opts;
        method = real_opts.ping_method ?? "GET";
        path = real_opts.ping_path ?? "/";
        body = method != "GET" ? real_opts.ping_body : NOTHING;
        headers += real_opts.ping_headers;

        rc.postponeUpdateOptions(rc.getLogger());

        if (real_opts.ping_path[0] == "/") {
            # use the path directly if it's an absolute path
            use_path_as_is = True;
        }

        if (real_opts.openapi3 && !rc.getValidator().managesUriPath()) {
            rc.debug("RestConnection ping: get OpenApi 3 schema: %y", real_opts.openapi3);
            state = SPS_GET_OPENAPI3;
            poller = FileLocationHandler::getIoPollerForLocation(real_opts.openapi3);
        } else if (real_opts.swagger && !rc.getValidator().managesUriPath()) {
            rc.debug("RestConnection ping: get Swagger schema: %y", real_opts.swagger);
            state = SPS_GET_SWAGGER;
            poller = FileLocationHandler::getIoPollerForLocation(real_opts.swagger);
        } else if (rc.requiresOAuth2Token()) {
            doStartGetToken();
        } else if (rc.requiresRefresh()) {
            doStartRefresh();
        } else {
            doStartPing();
        }
    }

    #! Destroys the object and makes any connection option updates
    destructor() {
        rc.flushOptionUpdates();
    }

    #! Returns the goal
    /** @return the goal set in the constructor
    */
    string getGoal() {
        return "ping";
    }

    #! Returns the current state
    /** @return the current state
    */
    string getState() {
        AutoLock al(m);
        return state + (poller ? ("-" + poller.getState()) : NOTHING);
    }

    #! Returns @ref True when the goal as been reached
    /** @return @ref True when the goal as been reached
    */
    bool goalReached() {
        return goal_reached;
    }

    #! Returns a hash to be used for I/O polling or @ref nothing in case the poll operation is complete
    *hash<SocketPollInfo> continuePoll() {
        AutoLock al(m);
        if (!poller) {
            return;
        }

        while (True) {
            *hash<SocketPollInfo> pinfo = poller.continuePoll();
            if (pinfo) {
                return pinfo;
            }

            if (state == SPS_GET_OPENAPI3) {
                # create OpenAPI 3 validator from file
                rc.setValidator(OpenApi3Loader::fromString(poller.getOutput().toString()));
                rc.debug("RestConnection ping: set OpenApi 3 schema for %y", rc.getValidator().getTargetUrl());
                if (rc.requiresOAuth2Token()) {
                    doStartGetToken();
                } else if (rc.requiresRefresh()) {
                    doStartRefresh();
                } else {
                    doStartPing();
                }
                continue;
            }

            if (state == SPS_GET_SWAGGER) {
                # create Swagger validator from file
                rc.setValidator(SwaggerLoader::fromString(poller.getOutput().toString()));
                rc.debug("RestConnection ping: set Swagger schema for %y", rc.getValidator().getTargetUrl());
                if (rc.requiresOAuth2Token()) {
                    doStartGetToken();
                } else if (rc.requiresRefresh()) {
                    doStartRefresh();
                } else {
                    doStartPing();
                }
                continue;
            }

            if (state == SPS_CUSTOM_GET_TOKEN) {
                hash<auto> resp = poller.getOutput();
                string body = resp."response-body"
                    ? resp."response-body".toString(resp.info.charset ?? "ISO-8859-1")
                    : "";
                if ((resp."code" / 100) == 2) {
                    if (real_opts.custom_token_location == "body-direct") {
                        if (!body) {
                            throw "REST-PING-ERROR", "No body returned from custom token refresh operation";
                        }
%ifndef NoJson
                        auto b = parse_json(body);
                        if (b.typeCode() != NT_STRING) {
                            throw "REST-PING-ERROR", "Expecting \"string\" as the body type of the custom token "
                                "refresh operation; got type %y instead", b.fullType();
                        }
                        gotOAuth2LoginInfo({
                            "token_type": "Bearer",
                            "access_token": b,
                        });
                        continue;
%else
                        throw "REST-PING-ERROR", sprintf("Cannot decode REST body; missing 'json' module: %y",
                            LoggerUtil::getArgSummary(body));
%endif
                    }
                    if (real_opts.custom_token_location == "body-plain") {
                        trim body;
                        if (!body) {
                            throw "REST-PING-ERROR", "No body returned from custom token refresh operation";
                        }
                        gotOAuth2LoginInfo({
                            "token_type": "Bearer",
                            "access_token": body,
                        });
                        continue;
                    }
                }
                conn.authFailure();
                throw "REST-PING-ERROR", sprintf("%y returned from %y; response body: %y", resp.info."response-uri",
                    resp.info."request-uri", LoggerUtil::getArgSummary(body));
            }

            if (state == SPS_OAUTH2_GET_TOKEN || state == SPS_OAUTH2_REFRESH_TOKEN) {
                hash<auto> resp = poller.getOutput();
                string body = resp."response-body"
                    ? resp."response-body".toString(resp.info.charset ?? "ISO-8859-1")
                    : "";
%ifndef NoJson
                if ((resp."code" / 100) == 2) {
                    auto parsed_body;
                    # remove modifiers from the content type
                    resp.info."response-headers"."content-type" =~ s/;.*//;
                    switch (resp.info."response-headers"."content-type") {
                        case MimeTypeJson:
                            parsed_body = parse_json(body);
                            break;

                        case MimeTypeFormUrlEncoded:
                            parsed_body = mime_parse_form_urlencoded_string(body);
                            break;

                        default:
                            throw "REST-PING-ERROR", sprintf("Cannot parse OAuth2 token response with Content-Type: %y",
                                resp.info."response-headers"."content-type");
                    }
                    gotOAuth2LoginInfo(parsed_body);
                    continue;
                }
%endif
                conn.authFailure();
                throw "REST-PING-ERROR", sprintf("%y returned from %y; response body: %y", resp.info."response-uri",
                    resp.info."request-uri", LoggerUtil::getArgSummary(body));
            }

            if (state == SPS_REST_PING) {
                hash<auto> resp = poller.getOutput();
                string body = resp."response-body"
                    ? resp."response-body".toString(resp.info.charset ?? "ISO-8859-1")
                    : "";
                bool oauth2_token = rc.getToken() && rc.usingOAuth2();
                bool check_auth = oauth2_token && real_opts.oauth2_auto_refresh
                    && (real_opts.oauth2_refresh_token || real_opts.custom_token_auth) && !in_refresh;
                if (check_auth && rc.isAuthTokenError(resp."code",
                        resp.info."response-headers", False, resp.info."body-content-type", body)) {
                    rc.detail("Found auth error in response with code: %d Content-Type: %y body: %y", resp."code",
                        resp.info."body-content-type", LoggerUtil::getArgSummary(body));
                    doStartRefresh();
                    continue;
                }
                if (in_refresh) {
                    in_refresh = False;
                }
                if ((resp."code" / 100) == 2) {
                    AbstractRestSchemaValidator validator = rc.getValidator();
                    on_error rethrow $1.err, sprintf("%s: info: %y", $1.desc, resp.info{"request-uri",
                        "response-uri"});
                    # remove any excess info from the body content type
                    resp.info."body-content-type" =~ s/;.*//;
                    #hash<RestResponseClientInfo> info =
                    hash<RestResponseClientInfo> respinfo = validator.parseResponse(method, path, resp."code", body,
                        resp.info."response-headers" + {"content-type": resp.info."body-content-type"});
                    # enforce rest_body_auth_error_check
                    *bool err;
                    if (rc.needsRestBodyAuthErrorCheck() && rc.isAuthTokenError(resp."code",
                        resp.info."response-headers", True, resp.info."body-content-type", respinfo.body)) {
                        if (check_auth) {
                            doStartRefresh();
                            rc.detail("Found auth error in response with code: %d Content-Type: %y body: %y",
                                resp."code", resp.info."body-content-type", respinfo.body);
                        }
                        err = True;
                    }
                    if (!err) {
                        rc.debug("RestConnection ping: ping successful");
                        conn.authSuccess();
                        goal_reached = True;
                        state = SPS_COMPLETE;
                        delete poller;
                        break;
                    }
                }

                conn.authFailure();
                throw "REST-PING-ERROR", sprintf("%y returned from %y; response body: %y", resp.info."response-uri",
                    resp.info."request-uri", LoggerUtil::getArgSummary(body));
            }

            checkOtherStates();
        }
    }

    abort() {
        if (poller) {
            poller.abort();
        }
    }

    private checkOtherStates() {
        throw "INVALID-STATE", sprintf("invalid state %y; aborting", state);
    }

    private gotOAuth2LoginInfo(hash<auto> h) {
        rc.gotOAuth2LoginInfo(h, True);
        doStartPing();
    }

    private doStartGetToken() {
%ifdef NoJson
        throw "REST-PING-ERROR", "cannot retrieve an OAuth2 token without the json module";
%else
        rc.debug("RestConnection ping: get auth token");
        if (real_opts.custom_token_auth) {
            state = SPS_CUSTOM_GET_TOKEN;
            poller = rc.startPollCustomGetToken();
        } else {
            state = SPS_OAUTH2_GET_TOKEN;
            poller = rc.startOAuth2PollSendRecv();
        }
%endif
    }

    private doStartRefresh() {
%ifdef NoJson
        throw "REST-PING-ERROR", "cannot retrieve an OAuth2 token without the json module";
%else
        # remove the Authorization header, so it can be set from the new token
        headers -= "Authorization";
        rc.debug("RestConnecton ping: refresh auth token");
        if (real_opts.custom_token_auth) {
            state = SPS_CUSTOM_GET_TOKEN;
            poller = rc.startPollCustomGetToken();
        } else {
            state = SPS_OAUTH2_REFRESH_TOKEN;
            poller = rc.startOAuth2PollRefreshToken();
        }
        in_refresh = True;
%endif
    }

    private doStartPing() {
        # if the path has already been prepared, use it directly
        if (use_path_as_is) {
            checkUrl();
            string p = path;
            rc.prepareToSend(method, \p, \body, \headers);
            rc.debug("Connection %y using ping path: %y", conn.name, path);
        } else {
            use_path_as_is = True;
            # check if the path is a URL
            if (path =~ /^http/) {
                rc.setURL(path);
                rc.debug("Setting ping URL: %y", path);
                path = "";
            } else {
                checkUrl();
                rc.debug("Connection %y using ping path: %y", conn.name, path);
            }
            rc.prepareToSend(method, \path, \body, \headers);
            rc.debug("Prepared ping path: %y", path);
        }

        string http_version = real_opts.http_version ?? "auto";
        rc.debug("RestConnecton ping: start ping: %s %y path: %y http_version: %y hdr: %y", method, rc.getURL(),
            path, http_version, headers);
        state = SPS_REST_PING;
        poller = rc.startPollSendRecv(method, path, body, headers);
    }

    private checkUrl() {
        if (*string url = rc.getURL()) {
            int len = min(url.length(), conn.real_url.length()) - 1;
            if (url[0..len] != conn.real_url[0..len]) {
                *string username = rc.getUsername();
                *string password = rc.getPassword();
                rc.setURL(conn.real_url);
                if (username.val()) {
                    rc.setUserPassword(username, password);
                }
            }
        }
    }
}

#! Poll operation for async REST requests
/** Encapsulates a full REST request lifecycle including OAuth2 token refresh and auth retry.

    The state machine follows:
    - \c SEND_REQUEST: Send the HTTP request and receive the response
    - \c AUTH_REFRESH: Refresh the OAuth2 token (if needed after a 401 response)
    - \c AUTH_RETRY: Retry the request with the new token
    - \c COMPLETE: The request is complete

    @since %RestClient 2.4
*/
public class RestRequestPollOperation inherits Qore::AbstractPollOperation {
    public {
        #! Send request state
        const SPS_SEND_REQUEST = "send-request";
        #! OAuth2 token refresh state
        const SPS_AUTH_REFRESH = "auth-refresh";
        #! Auth retry state (re-send with new token)
        const SPS_AUTH_RETRY = "auth-retry";
        #! Complete state
        const SPS_COMPLETE = "complete";
    }

    private {
        #! The RestClient used for the request
        RestClient rc;
        #! HTTP method
        string method;
        #! URI path
        string path;
        #! Message body (serialized)
        *data body;
        #! Request headers
        hash<auto> hdr;
        #! Whether to decode error responses
        bool decode_errors;
        #! Request info hash
        hash<auto> info;
        #! Inner poll operation for the HTTP I/O
        AbstractPollOperation poller;
        #! Goal reached flag
        bool goal_reached = False;
        #! Output (deserialized response)
        auto output;
        #! Current state
        string state;
        #! Mutex for thread safety
        Mutex m();
        #! Auth refresh already attempted
        bool auth_refreshed = False;
    }

    #! Creates a new RestRequestPollOperation
    /** @param rc the RestClient object
        @param method the HTTP method
        @param path the prepared URI path
        @param body the prepared (serialized) message body
        @param hdr the prepared request headers
        @param decode_errors whether to decode error responses
        @param info the info hash from the prepare phase
    */
    constructor(RestClient rc, string method, string path, *data body, hash<auto> hdr,
            bool decode_errors, hash<auto> info) {
        self.rc = rc;
        self.method = method;
        self.path = path;
        self.body = body;
        self.hdr = hdr;
        self.decode_errors = decode_errors;
        self.info = info;

        # check if OAuth2 token refresh is needed before sending
        if (rc.requiresRefresh()) {
            rc.detail("RestRequestPollOperation: token in expiry window; refreshing before request");
            doStartAuthRefresh();
        } else {
            doStartSendRequest();
        }
    }

    #! Returns the goal description
    string getGoal() {
        return sprintf("REST %s %s", method, path);
    }

    #! Returns the current state
    string getState() {
        return state + (poller ? ("-" + poller.getState()) : "");
    }

    #! Returns True if the goal has been reached
    bool goalReached() {
        return goal_reached;
    }

    #! Drives the poll operation forward
    /** @return a @ref Qore::SocketPollInfo "SocketPollInfo" hash if the operation needs more I/O,
        or @ref nothing if complete
    */
    *hash<SocketPollInfo> continuePoll() {
        AutoLock al(m);

        while (True) {
            *hash<SocketPollInfo> pinfo = poller.continuePoll();
            if (pinfo) {
                return pinfo;
            }

            if (state == SPS_AUTH_REFRESH) {
%ifdef NoJson
                throw "REST-ASYNC-ERROR", "cannot process OAuth2 token without the json module";
%else
                # Auth token refresh completed; update headers with new token and retry
                hash<auto> resp = poller.getOutput();
                if ((resp."code" / 100) == 2) {
                    string rbody = resp."response-body"
                        ? resp."response-body".toString(resp.info.charset ?? "ISO-8859-1")
                        : "";
                    resp.info."response-headers"."content-type" =~ s/;.*//;
                    auto parsed_body;
                    switch (resp.info."response-headers"."content-type") {
                        case MimeTypeJson:
                            parsed_body = parse_json(rbody);
                            break;
                        case MimeTypeFormUrlEncoded:
                            parsed_body = mime_parse_form_urlencoded_string(rbody);
                            break;
                        default:
                            throw "REST-ASYNC-ERROR", sprintf("cannot parse OAuth2 token response with "
                                "Content-Type: %y", resp.info."response-headers"."content-type");
                    }
                    rc.gotOAuth2LoginInfo(parsed_body, True);
                    rc.detail("RestRequestPollOperation: got new token; sending request");
                } else {
                    throw "REST-ASYNC-ERROR", sprintf("OAuth2 token refresh failed: %d %y returned",
                        resp."code", resp.info."response-uri");
                }
                # update authorization header from new token
                hdr.Authorization = rc.getDefaultHeaders().Authorization;
                doStartSendRequest();
                continue;
%endif
            }

            if (state == SPS_SEND_REQUEST || state == SPS_AUTH_RETRY) {
                hash<auto> resp = poller.getOutput();
                string rbody = resp."response-body"
                    ? resp."response-body".toString(resp.info.charset ?? "ISO-8859-1")
                    : "";

                # check for auth errors and retry if possible
                if (!auth_refreshed && rc.usingOAuth2() && rc.getToken()
                        && (rc.getOAuth2Options().oauth2_auto_refresh ?? True)
                        && rc.isAuthTokenError(resp."code", resp.info."response-headers", False,
                            resp.info."body-content-type", rbody)) {
                    rc.detail("RestRequestPollOperation: auth error in response; refreshing token");
                    doStartAuthRefresh();
                    continue;
                }

                # build response hash compatible with processRestResponse()
                hash<auto> h = {
                    "status_code": resp."code",
                    "body": rbody,
                    "content-type": resp.info."body-content-type",
                } + resp.info."response-headers";

                info."response-code" = resp."code";
                info."response-body-raw" = rbody;
                info += resp.info{"request-uri", "response-uri", "response-headers"};

                # handle HTTP error codes when error_passthru is not set
                if ((resp."code" / 100) != 2 && !rc.getErrorPassthru()) {
                    if (decode_errors && rbody.val()) {
                        RestClient::decodeAsyncError(h, \info);
                    }
                    throw "REST-RESPONSE-ERROR", sprintf("%d %s: %s (REST URL %s %s)", resp."code",
                        resp.info."response-uri", rbody.val() ? rbody : "<empty>", method, path),
                        h + {"decoded_body": info."response-body"};
                }

                try {
                    output = rc.processAsyncResponse(h, method, path, \info, decode_errors);
                } catch (hash<ExceptionInfo> ex) {
                    if (decode_errors && ex.arg.body) {
                        RestClient::decodeAsyncError(ex.arg, \info);
                        ex.arg.deserialized_body = info."response-body";
                    }
                    rethrow ex.err, ex.desc, ex.arg;
                }

                # check deserialized body for auth errors
                if (!auth_refreshed && rc.needsRestBodyAuthErrorCheck()
                        && rc.isAuthTokenError(resp."code", resp.info."response-headers", True,
                            resp.info."body-content-type", output.body)) {
                    rc.detail("RestRequestPollOperation: auth error in response body; refreshing token");
                    doStartAuthRefresh();
                    continue;
                }

                goal_reached = True;
                state = SPS_COMPLETE;
                delete poller;
                break;
            }

            throw "INVALID-STATE", sprintf("RestRequestPollOperation: invalid state %y", state);
        }
    }

    #! Returns the deserialized response hash
    /** Only valid after goalReached() returns True
    */
    auto getOutput() {
        return output;
    }

    #! Returns the info hash with request/response details
    hash<auto> getInfo() {
        return info;
    }

    #! Aborts the operation
    abort() {
        if (poller) {
            poller.abort();
        }
    }

    private doStartSendRequest() {
        state = auth_refreshed ? SPS_AUTH_RETRY : SPS_SEND_REQUEST;
        rc.debug("RestRequestPollOperation: sending %s %s", method, path);
        poller = rc.startPollSendRecv(method, path, body, hdr);
    }

    private doStartAuthRefresh() {
        auth_refreshed = True;
%ifdef NoJson
        throw "REST-ASYNC-ERROR", "cannot refresh OAuth2 token without the json module";
%else
        state = SPS_AUTH_REFRESH;
        if (rc.hasCustomTokenAuth()) {
            poller = rc.startPollCustomGetToken();
        } else {
            poller = rc.startOAuth2PollRefreshToken();
        }
%endif
    }
}
}
