        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/products",
            "action": "list-products",
            "groups": "Products",
            "display_name": "List Products",
            "short_desc": "List all products",
            "desc": "List products in Keap with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "Filter by product ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get a Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/products",
            "action": "get-product",
            "groups": "Products",
            "display_name": "Get a Product",
            "short_desc": "Get a single product by ID",
            "desc": "Retrieve a single product by ID from Keap",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "The product ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # ========== CAMPAIGN ACTIONS ==========

        # List Campaigns
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/campaigns",
            "action": "list-campaigns",
            "groups": "Campaigns",
            "display_name": "List Campaigns",
            "short_desc": "List all campaigns",
            "desc": "List campaigns in Keap with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "order_by": <ActionOptionInfo>{
                    "display_name": "Order By",
                    "short_desc": "Sort field",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "order_direction": <ActionOptionInfo>{
                    "display_name": "Order Direction",
                    "short_desc": "Sort direction",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Sort direction",
                    "allowed_values": (<AllowedValueInfo>{"value": "ASCENDING"}, <AllowedValueInfo>{"value": "DESCENDING"}),
                    "preselected": True,
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # ========== AFFILIATE ACTIONS ==========

        # List Affiliates
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/affiliates",
            "action": "list-affiliates",
            "groups": "Affiliates",
            "display_name": "List Affiliates",
            "short_desc": "List all affiliates",
            "desc": "List affiliates in Keap",
            "action_code": DPAT_FIND,
            "options": {
                "order_by": <ActionOptionInfo>{
                    "display_name": "Order By",
                    "short_desc": "Sort field",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # ========== GENERIC API ACTION ==========

        # Execute API Call
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/execute-api-call",
            "action": "execute-api-call",
            "groups": "API",
            "display_name": "Execute API Call",
            "short_desc": "Execute a raw API call",
            "desc": "Execute a raw API call against the Keap REST API",
            "action_code": DPAT_API,
            "output_type": AbstractDataProviderTypeMap."hash",
            "options": {
                "method": <ActionOptionInfo>{
                    "display_name": "HTTP Method",
                    "short_desc": "HTTP method",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "desc": "HTTP method to use for the API call",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "GET", "desc": "Retrieve data"},
                        <AllowedValueInfo>{"value": "POST", "desc": "Create a resource"},
                        <AllowedValueInfo>{"value": "PUT", "desc": "Replace a resource"},
                        <AllowedValueInfo>{"value": "PATCH", "desc": "Partially update a resource"},
                        <AllowedValueInfo>{"value": "DELETE", "desc": "Delete a resource"},
                    ),
                },
                "path": <ActionOptionInfo>{
                    "display_name": "API Path",
                    "short_desc": "API path",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "desc": "API path relative to /crm/rest/v2",
                },
                "body": <ActionOptionInfo>{
                    "display_name": "Request Body",
                    "short_desc": "Request body",
                    "type": AbstractDataProviderTypeMap."*hash",
                    "desc": "Request body for POST/PUT/PATCH",
                },
            },
        });

        # ========== EVENT ACTIONS ==========

        # Contact Added
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/events/contact-added",
            "action": "contact-added",
            "groups": "Events",
            "display_name": "Contact Added",
            "short_desc": "Watch for new contacts",
            "desc": "Triggers when a new contact is created in Keap",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CONTACT_ADDED,
        });

        # Contact Updated
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/events/contact-updated",
            "action": "contact-updated",
            "groups": "Events",
            "display_name": "Contact Updated",
            "short_desc": "Watch for contact updates",
            "desc": "Triggers when a contact is updated in Keap",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CONTACT_UPDATED,
        });

        # Tag Applied
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/events/tag-applied",
            "action": "tag-applied",
            "groups": "Events",
            "display_name": "Tag Applied",
            "short_desc": "Watch for tag applications",
            "desc": "Triggers when a tag is applied to a contact in Keap",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_TAG_APPLIED,
        });

        # Opportunity Added
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/events/opportunity-added",
            "action": "opportunity-added",
            "groups": "Events",
            "display_name": "Opportunity Added",
            "short_desc": "Watch for new opportunities",
            "desc": "Triggers when a new opportunity is created in Keap",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_OPPORTUNITY_ADDED,
        });

        # Order Added
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/events/order-added",
            "action": "order-added",
            "groups": "Events",
            "display_name": "Order Added",
            "short_desc": "Watch for new orders",
            "desc": "Triggers when a new order is created in Keap",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_ORDER_ADDED,
        });

        # Task Created
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/events/task-created",
            "action": "task-created",
            "groups": "Events",
            "display_name": "Task Created",
            "short_desc": "Watch for new tasks",
            "desc": "Triggers when a new task is created in Keap",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_TASK_CREATED,
        });

        # Note Added
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/events/note-added",
            "action": "note-added",
            "groups": "Events",
            "display_name": "Note Added",
            "short_desc": "Watch for new notes",
            "desc": "Triggers when a new note is added in Keap",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NOTE_ADDED,
        });
    };
}

/** @mainpage KeapDataProvider Module

    @tableofcontents

    @section keapdataproviderintro KeapDataProvider Introduction

    The %KeapDataProvider module provides a data provider API for the Keap CRM
    and marketing automation platform.

    To use this module, use \c "%requires KeapDataProvider" in your code.

    All the public symbols in the module are defined in the KeapDataProvider namespace.

    The main classes are:
    - @ref KeapDataProvider::KeapDataProvider "KeapDataProvider":
      the root data provider for Keap
    - @ref KeapDataProvider::KeapDataProviderFactory "KeapDataProviderFactory":
      the data provider factory for Keap

    @section keapdataproviderrelnotes Release Notes

    @subsection keapdataproviderv1_0 KeapDataProvider v1.0
    - the initial version of the %KeapDataProvider module
*/

#! Contains all public definitions in the KeapDataProvider module
public namespace KeapDataProvider {
}
