# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) KeapRestClient
%requires uuid
%try-module json
%define NoJson
%endtry

module KeapDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Keap CRM and marketing automation";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new KeapDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": KeapDataProvider::AppName,
            "display_name": "Keap",
            "short_desc": "Keap CRM and marketing automation platform",
            "desc": "Keap (formerly Infusionsoft) is a CRM and marketing automation platform "
                "for contacts, companies, opportunities, orders, tags, tasks, and email.\n\n"
                "This integration supports full CRUD operations on core CRM resources, "
                "tag management, and event-based triggers.",
            "scheme": "keaprest",
            "logo": KeapLogo,
            "logo_file_name": "keap-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::CrmSales, DataProvider::AppGroup::Marketing),
        });

        # ========== CONTACT ACTIONS ==========

        # Create a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/contacts/create",
            "action": "create-contact",
            "groups": "Contacts",
            "display_name": "Create a Contact",
            "short_desc": "Create a new contact",
            "desc": "Create a new contact in Keap",
            "action_code": DPAT_API,
            "output_type": new KeapContactDataType(),
            "options": {
                "given_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Contact first name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "desc": "First name of the contact",
                    "example_value": "John",
                },
                "family_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Contact last name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "desc": "Last name of the contact",
                    "example_value": "Smith",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Contact email",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "desc": "Email address of the contact",
                    "example_value": "john@example.com",
                },
                "phone1": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Phone number",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Phone number of the contact",
                },
                "company_id": <ActionOptionInfo>{
                    "display_name": "Company ID",
                    "short_desc": "Associated company",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "ID of the associated company",
                    "ref_data": "companies",
                },
                "job_title": <ActionOptionInfo>{
                    "display_name": "Job Title",
                    "short_desc": "Contact job title",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "lead_source_id": <ActionOptionInfo>{
                    "display_name": "Lead Source ID",
                    "short_desc": "Lead source",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "opt_in_reason": <ActionOptionInfo>{
                    "display_name": "Opt-in Reason",
                    "short_desc": "Reason for opting in",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Update a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/contacts/update",
            "action": "update-contact",
            "groups": "Contacts",
            "display_name": "Update a Contact",
            "short_desc": "Update an existing contact",
            "desc": "Update an existing contact in Keap",
            "action_code": DPAT_API,
            "output_type": new KeapContactDataType(),
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
                "given_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Contact first name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "family_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Contact last name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Contact email",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "phone1": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Phone number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "company_id": <ActionOptionInfo>{
                    "display_name": "Company ID",
                    "short_desc": "Associated company",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "companies",
                },
                "job_title": <ActionOptionInfo>{
                    "display_name": "Job Title",
                    "short_desc": "Contact job title",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Delete a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/contacts/delete",
            "action": "delete-contact",
            "groups": "Contacts",
            "display_name": "Delete a Contact",
            "short_desc": "Delete a contact",
            "desc": "Delete a contact from Keap",
            "action_code": DPAT_API,
            "output_type": AbstractDataProviderTypeMap."hash",
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
        });

        # Merge Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/contacts/merge",
            "action": "merge-contacts",
            "groups": "Contacts",
            "display_name": "Merge Contacts",
            "short_desc": "Merge two contacts",
            "desc": "Merge a duplicate contact into a surviving contact in Keap",
            "action_code": DPAT_API,
            "output_type": new KeapContactDataType(),
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Surviving Contact ID",
                    "short_desc": "The contact that survives",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
                "duplicate_contact_id": <ActionOptionInfo>{
                    "display_name": "Duplicate Contact ID",
                    "short_desc": "The contact to merge and delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
        });

        # List Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/contacts",
            "action": "list-contacts",
            "groups": "Contacts",
            "display_name": "List Contacts",
            "short_desc": "List all contacts",
            "desc": "List contacts in Keap with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Filter by contact ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Filter by email",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "given_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Filter by first name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "family_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Filter by last name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "order_by": <ActionOptionInfo>{
                    "display_name": "Order By",
                    "short_desc": "Sort field",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "order_direction": <ActionOptionInfo>{
                    "display_name": "Order Direction",
                    "short_desc": "Sort direction",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Sort direction",
                    "allowed_values": (<AllowedValueInfo>{"value": "ASCENDING"}, <AllowedValueInfo>{"value": "DESCENDING"}),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/contacts",
            "action": "get-contact",
            "groups": "Contacts",
            "display_name": "Get a Contact",
            "short_desc": "Get a single contact by ID",
            "desc": "Retrieve a single contact by ID from Keap",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
        });

        # ========== COMPANY ACTIONS ==========

        # Create a Company
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/companies/create",
            "action": "create-company",
            "groups": "Companies",
            "display_name": "Create a Company",
            "short_desc": "Create a new company",
            "desc": "Create a new company in Keap",
            "action_code": DPAT_API,
            "output_type": new KeapCompanyDataType(),
            "options": {
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company Name",
                    "short_desc": "Name of the company",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "desc": "Name of the company",
                    "example_value": "Acme Corp",
                },
                "email_address": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Company email",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "phone_number": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Company phone",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "website": <ActionOptionInfo>{
                    "display_name": "Website",
                    "short_desc": "Company website",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Update a Company
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/companies/update",
            "action": "update-company",
            "groups": "Companies",
            "display_name": "Update a Company",
            "short_desc": "Update an existing company",
            "desc": "Update an existing company in Keap",
            "action_code": DPAT_API,
            "output_type": new KeapCompanyDataType(),
            "options": {
                "company_id": <ActionOptionInfo>{
                    "display_name": "Company ID",
                    "short_desc": "The company to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "companies",
                },
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company Name",
                    "short_desc": "Name of the company",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email_address": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Company email",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "phone_number": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Company phone",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "website": <ActionOptionInfo>{
                    "display_name": "Website",
                    "short_desc": "Company website",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Delete a Company
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/companies/delete",
            "action": "delete-company",
            "groups": "Companies",
            "display_name": "Delete a Company",
            "short_desc": "Delete a company",
            "desc": "Delete a company from Keap",
            "action_code": DPAT_API,
            "output_type": AbstractDataProviderTypeMap."hash",
            "options": {
                "company_id": <ActionOptionInfo>{
                    "display_name": "Company ID",
                    "short_desc": "The company to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "companies",
                },
            },
        });

        # List Companies
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/companies",
            "action": "list-companies",
            "groups": "Companies",
            "display_name": "List Companies",
            "short_desc": "List all companies",
            "desc": "List companies in Keap with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "company_id": <ActionOptionInfo>{
                    "display_name": "Company ID",
                    "short_desc": "Filter by company ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company Name",
                    "short_desc": "Filter by company name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "order_by": <ActionOptionInfo>{
                    "display_name": "Order By",
                    "short_desc": "Sort field",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "order_direction": <ActionOptionInfo>{
                    "display_name": "Order Direction",
                    "short_desc": "Sort direction",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Sort direction",
                    "allowed_values": (<AllowedValueInfo>{"value": "ASCENDING"}, <AllowedValueInfo>{"value": "DESCENDING"}),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get a Company
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/companies",
            "action": "get-company",
            "groups": "Companies",
            "display_name": "Get a Company",
            "short_desc": "Get a single company by ID",
            "desc": "Retrieve a single company by ID from Keap",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "company_id": <ActionOptionInfo>{
                    "display_name": "Company ID",
                    "short_desc": "The company ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "companies",
                },
            },
        });

        # ========== OPPORTUNITY ACTIONS ==========

        # Create an Opportunity
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/opportunities/create",
            "action": "create-opportunity",
            "groups": "Opportunities",
            "display_name": "Create an Opportunity",
            "short_desc": "Create a new opportunity",
            "desc": "Create a new opportunity in Keap",
            "action_code": DPAT_API,
            "output_type": new KeapOpportunityDataType(),
            "options": {
                "opportunity_title": <ActionOptionInfo>{
                    "display_name": "Title",
                    "short_desc": "Opportunity title",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "desc": "Title of the opportunity",
                    "example_value": "New Deal",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Associated contact",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "ref_data": "contacts",
                },
                "stage_id": <ActionOptionInfo>{
                    "display_name": "Stage ID",
                    "short_desc": "Pipeline stage",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "estimated_close_date": <ActionOptionInfo>{
                    "display_name": "Estimated Close Date",
                    "short_desc": "Expected close date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "projected_revenue_high": <ActionOptionInfo>{
                    "display_name": "Projected Revenue High",
                    "short_desc": "High revenue estimate",
                    "type": AbstractDataProviderTypeMap."*float",
                },
                "projected_revenue_low": <ActionOptionInfo>{
                    "display_name": "Projected Revenue Low",
                    "short_desc": "Low revenue estimate",
                    "type": AbstractDataProviderTypeMap."*float",
                },
                "opportunity_notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Opportunity notes",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Update an Opportunity
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/opportunities/update",
            "action": "update-opportunity",
            "groups": "Opportunities",
            "display_name": "Update an Opportunity",
            "short_desc": "Update an existing opportunity",
            "desc": "Update an existing opportunity in Keap",
            "action_code": DPAT_API,
            "output_type": new KeapOpportunityDataType(),
            "options": {
                "opportunity_id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "The opportunity to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "opportunities",
                },
                "opportunity_title": <ActionOptionInfo>{
                    "display_name": "Title",
                    "short_desc": "Opportunity title",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "stage_id": <ActionOptionInfo>{
                    "display_name": "Stage ID",
                    "short_desc": "Pipeline stage",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "estimated_close_date": <ActionOptionInfo>{
                    "display_name": "Estimated Close Date",
                    "short_desc": "Expected close date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "projected_revenue_high": <ActionOptionInfo>{
                    "display_name": "Projected Revenue High",
                    "short_desc": "High revenue estimate",
                    "type": AbstractDataProviderTypeMap."*float",
                },
                "projected_revenue_low": <ActionOptionInfo>{
                    "display_name": "Projected Revenue Low",
                    "short_desc": "Low revenue estimate",
                    "type": AbstractDataProviderTypeMap."*float",
                },
                "opportunity_notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Opportunity notes",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Delete an Opportunity
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/opportunities/delete",
            "action": "delete-opportunity",
            "groups": "Opportunities",
            "display_name": "Delete an Opportunity",
            "short_desc": "Delete an opportunity",
            "desc": "Delete an opportunity from Keap",
            "action_code": DPAT_API,
            "output_type": AbstractDataProviderTypeMap."hash",
            "options": {
                "opportunity_id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "The opportunity to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "opportunities",
                },
            },
        });

        # List Opportunities
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/opportunities",
            "action": "list-opportunities",
            "groups": "Opportunities",
            "display_name": "List Opportunities",
            "short_desc": "List all opportunities",
            "desc": "List opportunities in Keap with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "opportunity_id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "Filter by opportunity ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "opportunities",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Filter by contact",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "contacts",
                    "preselected": True,
                },
                "stage_id": <ActionOptionInfo>{
                    "display_name": "Stage ID",
                    "short_desc": "Filter by stage",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "order_by": <ActionOptionInfo>{
                    "display_name": "Order By",
                    "short_desc": "Sort field",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "order_direction": <ActionOptionInfo>{
                    "display_name": "Order Direction",
                    "short_desc": "Sort direction",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Sort direction",
                    "allowed_values": (<AllowedValueInfo>{"value": "ASCENDING"}, <AllowedValueInfo>{"value": "DESCENDING"}),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get an Opportunity
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/opportunities",
            "action": "get-opportunity",
            "groups": "Opportunities",
            "display_name": "Get an Opportunity",
            "short_desc": "Get a single opportunity by ID",
            "desc": "Retrieve a single opportunity by ID from Keap",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "opportunity_id": <ActionOptionInfo>{
                    "display_name": "Opportunity ID",
                    "short_desc": "The opportunity ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "opportunities",
                },
            },
        });

        # ========== ORDER ACTIONS ==========

        # Create an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KeapDataProvider::AppName,
            "path": "/orders/create",
            "action": "create-order",
            "groups": "Orders",
            "display_name": "Create an Order",
            "short_desc": "Create a new order",
            "desc": "Create a new order in Keap",
            "action_code": DPAT_API,
            "output_type": new KeapOrderDataType(),
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Associated contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
                "order_title": <ActionOptionInfo>{
                    "display_name": "Order Title",
                    "short_desc": "Title of the order",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "example_value": "New Order",
                },
                "order_items": <ActionOptionInfo>{
                    "display_name": "Order Items",
                    "short_desc": "Items in the order",
                    "type": AbstractDataProviderTypeMap."list",
                    "required": True,
                    "preselected": True,
                    "desc": "List of order item hashes",
                },
                "order_date": <ActionOptionInfo>{
                    "display_name": "Order Date",
                    "short_desc": "Date of the order",
                    "type": AbstractDataProviderTypeMap."*date",
