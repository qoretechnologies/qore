            "interval day(1) to second(9)": ("qore": Type::Date,),
            "interval day(2) to second(0)": ("qore": Type::Date,),
            "interval day(2) to second(1)": ("qore": Type::Date,),
            "interval day(2) to second(2)": ("qore": Type::Date,),
            "interval day(2) to second(3)": ("qore": Type::Date,),
            "interval day(2) to second(4)": ("qore": Type::Date,),
            "interval day(2) to second(5)": ("qore": Type::Date,),
            "interval day(2) to second(6)": ("qore": Type::Date,),
            "interval day(2) to second(7)": ("qore": Type::Date,),
            "interval day(2) to second(8)": ("qore": Type::Date,),
            "interval day(2) to second(9)": ("qore": Type::Date,),
            "clob": ("qore": Type::String,),
            "blob": ("qore": Type::Binary,),
            "long": ("qore": Type::Binary,),
            "raw": ("qore": Type::Binary, "size": SZ_MAND, "size_range": (1, 2000)),
            "bfile": ("qore": Type::Binary,),
            "binary_float": ("qore": Type::Float,),
            "binary_double": ("qore": Type::Float,),
            "rowid": ("qore": Type::String,),
            "urowid": ("qore": Type::String, "size": SZ_OPT, "size_range": (1, 4000)),
        };

        #! maps qore type names to an oracle type
        const QoreTypeMap = {
            "integer": "number",
            "float": "number",
            "number": "number",
            "string": "varchar2",
            "date": "timestamp(6)",
            "binary": "blob",
            SqlUtil::CHAR: "char",
            SqlUtil::CLOB: "clob",
            SqlUtil::BLOB: "blob",
        };

        const OraColumnOpts = {
            "character_semantics": Type::Boolean,
        };

        #! Oracle-specific column options
        /** this constant extends @ref SqlUtil::AbstractTable::ColumnOptions as returned by \c OracleSqlUtilBase::OracleTable::getColumnOptions() with the following keys:
            - \c character_semantics: adds "char" to the column type name for applicable character columns to use character semantics for the column
        */
        const OraColumnOptions = AbstractTable::ColumnOptions + OraColumnOpts;

        #! Oracle-specific column options
        /** this constant extends @ref SqlUtil::AbstractTable::ColumnDescOptions as returned by \c OracleSqlUtilBase::OracleTable::getColumnDescOptions() with the following keys:
            - \c character_semantics: to specify that applicable character columns use character semantics in the column definition
        */
        const OraColumnDescOptions = AbstractTable::ColumnDescOptions + OraColumnOpts;

        #! Oracle-specific index options
        /** this constant extends @ref SqlUtil::AbstractTable::IndexOptions as returned by \c OracleSqlUtilBase::OracleTable::getIndexOptions() with the following keys:
            - \c compute_statistics: adds "compute statistics" to index creation strings
            - \c partition_scope: physical index scope on a partitioned table; one of \c "local" or \c "global";
              the internal value \c "default" selects Oracle's default behavior
        */
        const OracleIndexOptions = AbstractTable::IndexOptions + {
            "compute_statistics": Type::Boolean,
            "partition_scope": Type::String,
        };

        #! Oracle-specific constraint options
        /** this constant extends @ref OracleIndexOptions as returned by \c OracleSqlUtilBase::OracleTable::getConstraintOptions() with the following keys:
            - \c index: adds "using index <indexname>" to the constraint creation string
        */
        const OracleConstraintOptions = OracleIndexOptions + {
            "index": Type::String,
        };

        #! Oracle table creation options
        const OracleTableCreationOptions = AbstractTable::TableCreationOptions
            + OracleConstraintOptions
            + OraColumnOptions
            ;

        const OracleAlignTableOptions = AbstractTable::AlignTableOptions + OracleTableCreationOptions;

        #! Oracle partition exchange options
        /** This constant extends @ref SqlUtil::AbstractTable::PartitionExchangeOptions with:
            - \c including_indexes: use Oracle's \c INCLUDING \c INDEXES mode; omitted or @ref False "False" uses
              \c EXCLUDING \c INDEXES
            - \c update_indexes: append \c UPDATE \c INDEXES so usable global indexes are maintained

            @since OracleSqlUtilBase 3.0.0
        */
        const OraclePartitionExchangeOptions = AbstractTable::PartitionExchangeOptions + {
            "including_indexes": Type::Boolean,
            "update_indexes": Type::Boolean,
        };

        #! Oracle select options
        /** This compatibility constant includes the generic \c partition option from
            @ref SqlUtil::AbstractTable::SelectOptions and is returned by
            @ref OracleSqlUtilBase::OracleTable::getSelectOptions().
        */
        const OracleSelectOptions = AbstractTable::SelectOptions;

        #! Oracle Expression map
        const OracleExpressionMap = DefaultExpressionMap + {
            # Oracle server-side digest via STANDARD_HASH (returns RAW); supports MD5, SHA1, SHA256,
            # SHA384, and SHA512 (SHA224 is not supported by STANDARD_HASH).  base64 output is not
            # available portably in pure SQL and is rejected.
            DP_FUNC_DIGEST: DefaultExpressionMap{DP_FUNC_DIGEST} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string alg = sqlutil_normalize_digest_algorithm(args[1]);
                    string enc = sqlutil_normalize_digest_encoding(args[2]);
                    string v = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    hash<string, string> algmap = {
                        "md5": "MD5", "sha1": "SHA1", "sha256": "SHA256", "sha384": "SHA384",
                        "sha512": "SHA512",
                    };
                    *string oalg = algmap{alg};
                    if (!oalg) {
                        throw "DIGEST-ERROR", sprintf("digest algorithm %y is not supported by the "
                            "Oracle driver; supported algorithms: md5, sha1, sha256, sha384, sha512",
                            alg);
                    }
                    string core = sprintf("standard_hash(%s, '%s')", v, oalg);
                    switch (enc) {
                        case "binary":
                            return core;
                        case "hex":
                            return sprintf("lower(rawtohex(%s))", core);
                        case "base64":
                            throw "DIGEST-ERROR", "base64 digest output encoding is not supported by "
                                "the Oracle driver";
                    }
                    throw "DIGEST-ERROR", sprintf("invalid digest output encoding %y", enc);
                },
            },
            OP_SUBSTR: DefaultExpressionMap{OP_SUBSTR} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."int");
                    if (!exists args[2]) {
                        return sprintf("substr(%s,%s)", exp0, exp1);
                    }
                    return sprintf("substr(%s,%s,%s)", exp0, exp1,
                        info.table.getExpressionArg(\info, role, args[2], AbstractDataProviderTypeMap."int"));
                },
            },
            COP_CAST: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": COP_CAST,
                    "display_name": "cast",
                    "short_desc": "cast operator",
                    "desc": "cast operator",
                    "symbol": "cast",
                    "groups": "Data Conversion",
                    "args": (
                        DataProviderSignatureAnyType,
                        DataProviderSignatureStringValueType,
                        DataProviderSignatureOptionalIntValueType,
                        DataProviderSignatureOptionalIntValueType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."any",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any");
                    # the arguments are the expression, the type, and an optional size and scale
                    string name = QoreTypeMap{args[1]} ?? args[1];
                    *hash<auto> desc = OraTypeMap{name};
                    string sql = sprintf ("cast (%s as %s", exp0, name);
                    if (desc.size == SZ_MAND) {
                        if (!exists args[2] && !exists desc.size_range)
                            throw "OPERATOR-ERROR", sprintf ("cast operator missing size for type %s",
                                name);
                        sql += sprintf("(%d)", args[2] ?? desc.size_range[1]);
                    } else if (desc.size == SZ_NUM && exists args[2]) {
                        sql += sprintf("(%d", args[2]);
                        sql += exists args[3] ? sprintf(",%d)", args[3]) : ")";
                    } else if (desc.size == SZ_OPT && exists args[2]) {
                        sql += sprintf("(%d)", args[2]);
                    }
                    sql += ")";
                    return sql;
                },
            },
            COP_YEAR: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": COP_YEAR,
                    "display_name": COP_YEAR,
                    "short_desc": "returns the year component of a date as a string (ex: 2022)",
                    "desc": "returns the year component of a date as a string (ex: `2022`)",
                    "symbol": COP_YEAR,
                    "groups": "Date/Time",
                    "args": (
                        DataProviderSignatureDateType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."string",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."date");
                    return sprintf("to_char(%s, 'YYYY')", exp0);
                }
            },
            COP_YEAR_MONTH: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": COP_YEAR_MONTH,
                    "display_name": COP_YEAR_MONTH,
                    "short_desc": "returns the year and month components of a date as a string (ex: 2022-06)",
                    "desc": "returns the year and month components of a date as a string (ex: `2022-06`)",
                    "symbol": COP_YEAR_MONTH,
                    "groups": "Date/Time",
                    "args": (
                        DataProviderSignatureDateType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."string",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."date");
                    return sprintf("to_char(%s, 'YYYY-MM')", exp0);
                }
            },
            COP_YEAR_DAY: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": COP_YEAR_DAY,
                    "display_name": COP_YEAR_DAY,
                    "short_desc": "returns the year, month, and day components of a date as a string (ex: "
                        "2022-06-29)",
                    "desc": "returns the year, month, and day components of a date as a string (ex: "
                        "`2022-06-29`)",
                    "symbol": COP_YEAR_DAY,
                    "groups": "Date/Time",
                    "args": (
                        DataProviderSignatureDateType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."string",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."date");
                    return sprintf("to_char(%s, 'YYYY-MM-DD')", exp0);
                }
            },
            COP_YEAR_HOUR: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": COP_YEAR_HOUR,
                    "display_name": COP_YEAR_HOUR,
                    "short_desc": "returns the year, month, day, and hour components of a date as a string "
                        "(ex: 2022-06-29 15)",
                    "desc": "returns the year, month, day, and hour components of a date as a string "
                        "(ex: `2022-06-29 15`)",
                    "symbol": COP_YEAR_HOUR,
                    "groups": "Date/Time",
                    "args": (
                        DataProviderSignatureDateType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."string",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."date");
                    return sprintf("to_char(%s, 'YYYY-MM-DD HH24')", exp0);
                }
            },
            COP_TRUNC_DATE: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": COP_TRUNC_DATE,
                    "display_name": COP_TRUNC_DATE,
                    "short_desc": "truncates the given date to the given resolution; args: date, string code: Y: year, "
                        "M: month, D: day, H: hour, m: minute, S: second",
                    "desc": "truncates the given date to the given resolution; args: date, string code: Y: year, "
                        "M: month, D: day, H: hour, m: minute, S: second",
                    "symbol": COP_TRUNC_DATE,
                    "groups": "Date/Time",
                    "args": (
                        DataProviderSignatureDateType,
                        DataProviderSignatureStringValueType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."date",
                },
                "code": string sub(reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    *string str = OracleTruncDate{args[1]};
                    if (!str && !OracleTruncDate.hasKey(args[1])) {
                        throw "TRUNC-DATE-ERROR", sprintf("unknown date truncation format argument %y; "
                            "supported date format arguments: %y", args[1], keys OracleTruncDate);
                    }
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."date");
                    if (str) {
                        return sprintf("trunc(%s, %s)", exp0, str);
                    }
                    # for timestamps
                    return sprintf("cast (%s as date)", exp0);
                },
            },
            OP_IN: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": OP_IN,
                    "display_name": OP_IN,
                    "short_desc": "Returns True if the first argument is found in the second argument",
                    "desc": "Returns True if the first argument is found in the second argument",
                    "symbol": OP_IN,
                    "groups": "Comparison",
                    "args": (
                        DataProviderSignatureAnyType,
                        DataProviderSignatureAnyType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."bool",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
%ifndef NO_ORACLE
                    auto val = args[0];
                    # Qorus bug #989 SqlUtil: oracle op_in can fail in large amount of input elements
                    # There is no support for CLOBs in WHERE clause in Oracle at all.
                    # Binding large strings (over 4000 chars is performed by a CLOB in Qore driver.
                    # Result of op_in operator can be "ORA-00932: inconsistent datatypes" if is
                    # the list longer or if it contains large items with:
                    # return cn + " in (select regexp_substr(%v,'[^,]+', 1, level) from dual connect by
                    # regexp_substr(%v, '[^,]+', 1, level) is not null)";

                    # determine list members type. Let's assume the 1st non NULL/NOTHING
                    # element gives the type code for all elements.
                    # get list type code
                    int ltype;
                    foreach auto v in (args[1]) {
                        int t = v.typeCode();
                        switch (t) {
                            case NT_NULL:
                            case NT_NOTHING:
                                continue;
                            case NT_DATE:
                            case NT_INT:
                            case NT_FLOAT:
                            case NT_NUMBER:
                            case NT_STRING:
                                ltype = t;
                                break;
                            default:
                                throw "ORACLE-IN-OPERATOR-ERROR", sprintf("the \"in\" operator unexpected list "
                                    "element type: %s; only simple types are supported", v.fullType());
                        }
                        if (ltype) {
                            break;
                        }
                    }

                    # make a copy of "info" before modifying
                    hash<QueryInfo> info0 = info;

                    # add column argument first
                    string exp0;
                    if (val.typeCode() == NT_STRING) {
                        # assume column name
                        exp0 = val;
                    } else {
                        exp0 = info.table.getExpressionArg(\info, role, val,
                            AbstractDataProviderTypeMap."any");
                    }

                    # Split long array to chunks of no more than 32767 elements due to Oracle limitation
                    # "ORA-22165: OCI-22165: given index [32767] must be in the range of [0] to [32766]"
                    int count;
                    while (args[1]) {
                        ++count;
                        list<auto> chunk = extract args[1], 0, 32767;

                        # Bind to Oracle by expected type
                        switch (ltype) {
                            case NT_DATE:
                                info.args += bindOracleCollection("SYS.ODCIDATELIST", chunk);
                                break;
                            case NT_INT:
                            case NT_FLOAT:
                            case NT_NUMBER:
                                info.args += bindOracleCollection("SYS.ODCINUMBERLIST", chunk);
                                break;
                            default:
                                info.args += bindOracleCollection("SYS.ODCIVARCHAR2LIST", chunk);
                        }
                    }

                    if (count) {
                        return exp0 + " in (" + (map "select column_value from table(%v)",
                            xrange(count)).join(" union all ") + ")";
                    }
                    # restore original info
                    info = info0;
                    # return an expression that returns false
                    return "1 != 1";
%else
                    throw "MISSING-ORACLE-DRIVER", "requires the oracle driver";
%endif
                },
            },
            COP_SEQ: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": COP_SEQ,
                    "display_name": COP_SEQ,
                    "short_desc": "returns the next value in the given sequence; args: sequence name",
                    "desc": "returns the next value in the given sequence; args: sequence name",
                    "symbol": COP_SEQ,
                    "groups": "Sequence",
                    "args": (
                        DataProviderSignatureStringValueType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."int",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("%s.nextval", oracle_get_sql_object_name(args[0]));
                },
            },
            COP_SEQ_CURRVAL: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": COP_SEQ_CURRVAL,
                    "display_name": COP_SEQ_CURRVAL,
                    "short_desc": "returns the current value in the given sequence; args: sequence name",
                    "desc": "returns the current value in the given sequence; args: sequence name",
                    "symbol": COP_SEQ_CURRVAL,
                    "groups": "Sequence",
                    "args": (
                        DataProviderSignatureStringValueType,
                    ),
                    "return_type": AbstractDataProviderTypeMap."int",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("%s.currval", oracle_get_sql_object_name(args[0]));
                }
            },
            # --- Date/Time functions for Oracle ---
            # Inherit metadata from DefaultExpressionMap; provide Oracle-native code only.
            DP_FUNC_NOW: DefaultExpressionMap{DP_FUNC_NOW} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return "systimestamp";
                },
            },
            # --- Duration functions for Oracle ---
            DP_FUNC_YEARS: DefaultExpressionMap{DP_FUNC_YEARS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtoyminterval(%s, 'year')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            DP_FUNC_MONTHS: DefaultExpressionMap{DP_FUNC_MONTHS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtoyminterval(%s, 'month')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            DP_FUNC_WEEKS: DefaultExpressionMap{DP_FUNC_WEEKS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtodsinterval(%s * 7, 'day')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            DP_FUNC_DAYS: DefaultExpressionMap{DP_FUNC_DAYS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtodsinterval(%s, 'day')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            DP_FUNC_HOURS: DefaultExpressionMap{DP_FUNC_HOURS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtodsinterval(%s, 'hour')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            DP_FUNC_MINUTES: DefaultExpressionMap{DP_FUNC_MINUTES} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtodsinterval(%s, 'minute')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            DP_FUNC_SECONDS: DefaultExpressionMap{DP_FUNC_SECONDS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtodsinterval(%s, 'second')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            DP_FUNC_MILLISECONDS: DefaultExpressionMap{DP_FUNC_MILLISECONDS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtodsinterval(%s / 1000, 'second')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            DP_FUNC_MICROSECONDS: DefaultExpressionMap{DP_FUNC_MICROSECONDS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("numtodsinterval(%s / 1000000, 'second')",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                },
            },
            # --- Date extraction functions for Oracle ---
            DP_FUNC_GET_YEAR: DefaultExpressionMap{DP_FUNC_GET_YEAR} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("extract(year from %s)",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                },
            },
            DP_FUNC_GET_MONTH: DefaultExpressionMap{DP_FUNC_GET_MONTH} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("extract(month from %s)",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                },
            },
            DP_FUNC_GET_DAY: DefaultExpressionMap{DP_FUNC_GET_DAY} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("extract(day from %s)",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                },
            },
            DP_FUNC_GET_HOUR: DefaultExpressionMap{DP_FUNC_GET_HOUR} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("extract(hour from cast(%s as timestamp))",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                },
            },
            DP_FUNC_GET_MINUTE: DefaultExpressionMap{DP_FUNC_GET_MINUTE} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("extract(minute from cast(%s as timestamp))",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                },
            },
            DP_FUNC_GET_SECOND: DefaultExpressionMap{DP_FUNC_GET_SECOND} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("floor(extract(second from cast(%s as timestamp)))",
                        info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                },
            },
            # --- Comparison operators for Oracle ---
            DP_OP_LIKE: DefaultExpressionMap{DP_OP_LIKE} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."string");
                    if (args[2]) {
                        return sprintf("upper(%s) like upper(%s)", exp0, exp1);
                    }
                    return sprintf("%s like %s", exp0, exp1);
                },
            },
            # Inherit metadata from DefaultExpressionMap; provide Oracle-native code only.
            DP_OP_REGEX_MATCH: DefaultExpressionMap{DP_OP_REGEX_MATCH} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."string");
                    bool case_insensitive = exists args[2] && inlist("i", args[2]);
                    if (case_insensitive) {
                        return sprintf("regexp_like(%s, %s, 'i')", exp0, exp1);
                    }
                    return sprintf("regexp_like(%s, %s)", exp0, exp1);
                },
            },
            DP_OP_REGEX_NMATCH: DefaultExpressionMap{DP_OP_REGEX_NMATCH} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."string");
                    bool case_insensitive = exists args[2] && inlist("i", args[2]);
                    if (case_insensitive) {
                        return sprintf("not regexp_like(%s, %s, 'i')", exp0, exp1);
                    }
                    return sprintf("not regexp_like(%s, %s)", exp0, exp1);
                },
            },
            DP_OP_REGEX_SUBST: DefaultExpressionMap{DP_OP_REGEX_SUBST} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."string");
                    string exp2 = info.table.getExpressionArg(\info, role, args[2],
                        AbstractDataProviderTypeMap."string");
                    # Oracle REGEXP_REPLACE is global by default; "i" maps to 'i' match param
                    string flags = "";
                    if (exists args[3]) {
                        foreach auto opt in (args[3]) {
                            if (opt == "i") {
                                flags += "i";
                            }
                        }
                    }
                    if (flags.val()) {
                        return sprintf("regexp_replace(%s, %s, %s, 1, 0, '%s')", exp0, exp1, exp2, flags);
                    }
                    return sprintf("regexp_replace(%s, %s, %s)", exp0, exp1, exp2);
                },
            },
            DP_OP_CONTAINS: DefaultExpressionMap{DP_OP_CONTAINS} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."string");
                    if (args[2]) {
                        return sprintf("upper(%s) like '%%' || upper(%s) || '%%'", exp0, exp1);
                    }
                    return sprintf("%s like '%%' || %s || '%%'", exp0, exp1);
                },
            },
            DP_OP_STARTS_WITH: DefaultExpressionMap{DP_OP_STARTS_WITH} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."any");
                    if (args[2]) {
                        return sprintf("upper(%s) like upper(%s) || '%%'", exp0, exp1);
                    }
                    return sprintf("%s like %s || '%%'", exp0, exp1);
                },
            },
            DP_OP_ENDS_WITH: DefaultExpressionMap{DP_OP_ENDS_WITH} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."any");
                    if (args[2]) {
                        return sprintf("upper(%s) like '%%' || upper(%s)", exp0, exp1);
                    }
                    return sprintf("%s like '%%' || %s", exp0, exp1);
                },
            },
            # --- String manipulation operators for Oracle ---
            DP_OP_REPLACE: DefaultExpressionMap{DP_OP_REPLACE} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."string");
                    string exp2 = info.table.getExpressionArg(\info, role, args[2],
                        AbstractDataProviderTypeMap."string");
                    return sprintf("replace(%s, %s, %s)", exp0, exp1, exp2);
                },
            },
            # --- Type conversion operators for Oracle ---
            DP_OP_TO_STRING: DefaultExpressionMap{DP_OP_TO_STRING} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any");
                    return sprintf("to_char(%s)", exp0);
                },
            },
            DP_OP_TO_INT: DefaultExpressionMap{DP_OP_TO_INT} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any");
                    return sprintf("cast(%s as integer)", exp0);
                },
            },
            DP_OP_TO_FLOAT: DefaultExpressionMap{DP_OP_TO_FLOAT} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any");
                    return sprintf("cast(%s as binary_double)", exp0);
                },
            },
            DP_OP_TO_NUMBER: DefaultExpressionMap{DP_OP_TO_NUMBER} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any");
                    return sprintf("to_number(%s)", exp0);
                },
            },
            DP_OP_TO_DATE: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": DP_OP_TO_DATE,
                    "display_name": "to date",
                    "short_desc": "Converts a value to a date/time",
                    "desc": "Converts a value to a timestamp using Oracle CAST(x AS TIMESTAMP); "
                        "if a format mask is given, uses TO_TIMESTAMP(x, mask) instead",
                    "symbol": "toDate",
                    "groups": "Data Conversion",
                    "args": (DataProviderSignatureAnyType, DataProviderSignatureOptionalStringType),
                    "return_type": AbstractDataProviderTypeMap."date",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any");
                    if (exists args[1]) {
                        string fmt = OracleTable::convertDateFormat(args[1]);
                        return sprintf("to_timestamp(%s, '%s')", exp0, fmt);
                    }
                    return sprintf("cast(%s as timestamp)", exp0);
                },
            },
            DP_OP_TO_LOWER: DefaultExpressionMap{DP_OP_TO_LOWER} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("lower(%s)", info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string"));
                },
            },
            DP_OP_TO_UPPER: DefaultExpressionMap{DP_OP_TO_UPPER} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("upper(%s)", info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string"));
                },
            },
            DP_OP_LENGTH: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": DP_OP_LENGTH,
                    "display_name": "length",
                    "short_desc": "Returns the character length of a string",
                    "desc": "Returns the number of characters in a string using Oracle LENGTH()",
                    "symbol": "length",
                    "groups": "Data Manipulation",
                    "args": (DataProviderSignatureAnyType,),
                    "return_type": AbstractDataProviderTypeMap."int",
                },
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("length(%s)", info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any"));
                },
            },
            # --- Control flow operators for Oracle ---
            DP_OP_TERNARY: DefaultExpressionMap{DP_OP_TERNARY} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string cond = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."bool");
                    string true_val = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."any");
                    string false_val = info.table.getExpressionArg(\info, role, args[2],
                        AbstractDataProviderTypeMap."any");
                    return sprintf("case when %s then %s else %s end", cond, true_val, false_val);
                },
            },
            DP_OP_HAS_VALUE: DefaultExpressionMap{DP_OP_HAS_VALUE} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    return sprintf("%s is not null", info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."any"));
                },
            },
            # --- Additional date/string functions for Oracle ---
            DP_FUNC_FORMAT_DATE: DefaultExpressionMap{DP_FUNC_FORMAT_DATE} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."date");
                    string fmt = OracleTable::convertDateFormat(args[1]);
                    return sprintf("to_char(%s, '%s')", exp0, fmt);
                },
            },
        };

        #! where operator specializations for Oracle
        const OracleOpMap = DefaultOpMap + (
            OP_IN: (
                "code": string sub (reference<hash<QueryInfo>> info, string cn, softlist arg) {
%ifndef NO_ORACLE
                    # Qorus bug #989 SqlUtil: oracle op_in can fail in large amount of input elements
                    # There is no support for CLOBs in WHERE clause in Oracle at all.
                    # Binding large strings (over 4000 chars is performed by a CLOB in Qore driver.
                    # Result of op_in operator can be "ORA-00932: inconsistent datatypes" if is
                    # the list longer or if it contains large items with:
                    # return cn + " in (select regexp_substr(%v,'[^,]+', 1, level) from dual connect by regexp_substr(%v, '[^,]+', 1, level) is not null)";

                    # determine list members type. Let's assume the 1st non NULL/NOTHING
                    # element gives the type code for all elements.
                    ListIterator it(arg);
                    int ltype;
                    while (it.next()) {
                        switch (it.getValue().typeCode()) {
                            case NT_NULL:
                            case NT_NOTHING:
                                continue;
                            case NT_DATE:
                            case NT_INT:
                            case NT_FLOAT:
                            case NT_NUMBER:
                            case NT_STRING:
                                ltype = it.getValue().typeCode();
                                break;
                            default:
                                throw "ORACLE-DRIVER-ERROR", sprintf("op_in operator unexpected list member type: %s. Only simple types are supported.", it.getValue().type());
                        }
                        if (ltype) break;
                    }

                    # Split long array to chunks of no more than 32767 elements due to Oracle limitation
                    # "ORA-22165: OCI-22165: given index [32767] must be in the range of [0] to [32766]"
                    int count;
                    while (arg.size()) {
                        ++count;
                        list chunk = extract arg, 0, 32767;

                        # Bind to Oracle by expected type
                        switch (ltype) {
                            case NT_DATE:
                                info.args += bindOracleCollection("SYS.ODCIDATELIST", chunk);
                                break;
                            case NT_INT:
                            case NT_FLOAT:
                            case NT_NUMBER:
                                info.args += bindOracleCollection("SYS.ODCINUMBERLIST", chunk);
                                break;
                            default:
                                info.args += bindOracleCollection("SYS.ODCIVARCHAR2LIST", chunk);
                        }
                    }

                    if (count)
                        return cn + " in (" + (map "select column_value from table(%v)",
                            xrange(count)).join(" union all ") + ")";
                    else
                        return "1 != 1";
%else
                    throw "MISSING-ORACLE-DRIVER", "op_in requires oracle driver";
%endif
                },
            ),
            OP_SUBSTR: (
                "code": string sub (reference<hash<QueryInfo>> info, string cn, softlist arg) {
                    info.args += arg[0]; # start
                    if (!exists arg[1]) {
                        info.args += arg[2]; # text
                        return sprintf("substr(%s,%v) = %v", cn);
                    }
                    info.args += arg[1]; # count
                    info.args += arg[2]; # text
                    return sprintf("substr(%s,%v,%v) = %v", cn);
                },
            ),
        );

        #! column operator specializations for Oracle
        const OracleCopMap = (
            COP_CAST: (
                "code": string sub (string cve, list<auto> args) {
                    string name = QoreTypeMap{args[0]} ?? args[0];
                    hash desc = OraTypeMap{name};
                    string sql = sprintf ("cast (%s as %s", cve, name);
                    switch (name) {
                        default:
                            if (desc.size == SZ_MAND) {
                                if (!exists args[1] && !exists desc.size_range)
                                    throw "OPERATOR-ERROR", sprintf ("op_cast operator missing size for type %s", name);
                                sql += sprintf("(%d)", args[1] ?? desc.size_range[1]);
                            } else if (desc.size == SZ_NUM && exists args[1]) {
                                sql += args[1] == "*" ? "(*" : sprintf("(%d", args[1]);
                                sql += exists args[2] ? sprintf(",%d)", args[2]) : ")";
                            } else if (desc.size == SZ_OPT && exists args[1]) {
                                sql += sprintf("(%d)", args[1]);
                            }
                    }
                    sql += ")";
                    return sql;
                },
            ),
            COP_SUBSTR: (
                "code": string sub (string cve, list<auto> args) {
                    if (!exists args[1])
                        return sprintf("substr(%s,%d)", cve, args[0]);
                    return sprintf("substr(%s,%d,%d)", cve, args[0], args[1]);
                },
            ),
            COP_YEAR: (
                "code": string sub (string arg1, auto arg) {
                    return sprintf("to_char(%s, 'YYYY')", arg1);
                }
            ),
            COP_YEAR_MONTH: (
                "code": string sub (string arg1, auto arg) {
                    return sprintf("to_char(%s, 'YYYY-MM')", arg1);
                }
            ),
            COP_YEAR_DAY: (
                "code": string sub (string arg1, auto arg) {
                    return sprintf("to_char(%s, 'YYYY-MM-DD')", arg1);
                }
            ),
            COP_YEAR_HOUR: (
                "code": string sub (string arg1, auto arg) {
                    return sprintf("to_char(%s, 'YYYY-MM-DD HH24')", arg1);
                }
            ),
            COP_SEQ: (
                "nocolumn": True,
                "withalias": True,
                "code": string sub (*string cve, hash arg, reference<hash> psch) {
                    string sql = sprintf("%s.nextval", oracle_get_sql_object_name(arg.seq));
                    if (arg.as) {
                        psch{arg.as} = sql;
                        sql += " " + arg.as;
                    }
                    return sql;
                }
            ),
            COP_SEQ_CURRVAL: (
                "nocolumn": True,
                "withalias": True,
                "code": string sub (*string cve, hash arg, reference<hash> psch) {
                    string sql = sprintf("%s.currval", oracle_get_sql_object_name(arg.seq));
                    if (arg.as) {
                        psch{arg.as} = sql;
                        sql += " " + arg.as;
                    }
                    return sql;
                }
            ),
            COP_TRUNC_DATE: (
                "code": string sub(string arg1, auto arg) {
                    if (!OracleTruncDate.hasKey(arg)) {
                        throw "COP-TRUNC-DATE-ERROR", sprintf("Not allowed format argument: %y: allowed: %y", arg,
                            OracleTruncDate.keys());
                    }
                    # seconds are not part of TRUNC() in oracle
                    if (exists OracleTruncDate{arg}) {
                        return sprintf("trunc(%s, %s)", arg1, OracleTruncDate{arg});
                    }
                    # for timestamps
                    return sprintf("cast (%s as date)", arg1);
                }
            )
        );

        #! Map @ref SqlUtil::cop_trunc_date() constants to Oracle internal masks
        const OracleTruncDate = (
            DT_YEAR     : "'YYYY'",
            DT_MONTH    : "'MM'",
            DT_DAY      : "'DD'",
            DT_HOUR     : "'HH24'",
            DT_MINUTE   : "'MI'",
            DT_SECOND   : NOTHING,
        );

        #! a hash of default value operator descriptions for Oracle
        const OracleIopMap = DefaultIopMap + (
            IOP_SEQ: (
                "arg": Type::String,
                "immediate": True,
                # the sequence name is validated by AbstractTable before; a name that is not an ordinary name, such
                # as a reserved word, is quoted
                "code": string sub (string cve, string arg) {
                    return sprintf("%s.nextval", oracle_get_sql_object_name(arg));
                },
            ),
            IOP_SEQ_CURRVAL: (
                "arg": Type::String,
                "immediate": True,
                "code": string sub (string cve, string arg) {
                    return sprintf("%s.currval", oracle_get_sql_object_name(arg));
                },
            ),
        );

        #! a hash of default update operator definitions for Oracle
        const OracleUopMap = DefaultUopMap + (
            COP_SEQ: (
                "nocolumn": True,
                "code": string sub (*string cve, string arg) {
                    return sprintf("%s.nextval", oracle_get_sql_object_name(arg));
                }
            ),
            COP_SEQ_CURRVAL: (
                "nocolumn": True,
                "code": string sub (*string cve, string arg) {
                    return sprintf("%s.currval", oracle_get_sql_object_name(arg));
                }
            ),
        );

        #! a hash of valid pseudocolumns
        const OraclePseudoColumnHash = {
            "rowid": True,
            "rownum": True,
            "object_id": True,
            "object_value": True,
            "ora_rowscn": True,
        };
    }

    private {
        # schema name
        string schema;

        # tablespace name
        *string tablespace;

        # is the table read only?
        bool readonly;

        # table comment
        *string comment;

        # dblink
        *string dblink;

        # Oracle server major version
        int ora_major;

        # helper flag to indicate if is the OracleTable real table or a view
        bool m_isView = False;

        # oraclesqlutilbase: allow to use DBA_* views instead of ALL_* if possible #2418
        # An internal cache to find the highest priority available
        # system dictionary object. Priority: DBA > ALL
        hash<string, string> m_sys_views = {
            "dba_col_comments"      : "all_col_comments",
            "dba_cons_columns"      : "all_cons_columns",
            "dba_constraints"       : "all_constraints",
            "dba_db_links"          : "all_db_links",
            "dba_ind_columns"       : "all_ind_columns",
            "dba_ind_expressions"   : "all_ind_expressions",
            "dba_ind_partitions"    : "all_ind_partitions",
            "dba_indexes"           : "all_indexes",
            "dba_objects"           : "all_objects",
            "dba_part_indexes"      : "all_part_indexes",
            "dba_part_key_columns"  : "all_part_key_columns",
            "dba_part_tables"       : "all_part_tables",
            "dba_sequences"         : "all_sequences",
            "dba_synonyms"          : "all_synonyms",
            "dba_tab_columns"       : "all_tab_columns",
            "dba_tab_comments"      : "all_tab_comments",
            "dba_tab_partitions"    : "all_tab_partitions",
            "dba_tables"            : "all_tables",
            "dba_triggers"          : "all_triggers",
            "dba_views"             : "all_views",
        };
    }

    constructor(AbstractDatasource nds, string nname, *hash opts) : AbstractTable(nds, nname, opts) {
        # see if there is a dblink in the name
        *string dbl = (nname =~ x/@(.*)/)[0];
        if (dbl) {
            # the database link is part of SQL without quotes
            dblink = oracle_check_dblink(dbl.upr());
            splice nname, nname.size() - (dbl.size() + 1);
            name = nname;
            setDblinkSchema();
        } else {
            # see if there is a schema in the name
            *string sstr = (nname =~ x/^(\w+)\.\w+/)[0];
            if (sstr) {
                schema = sstr;
                splice nname, 0, schema.size() + 1;
                name = nname;
            } else {
                schema = ds.getUserName();
            }
        }

        # the oracle driver >= 3.0 supports selecting from LONG columns
        if (compare_version("3.0", get_module_hash().oracle.version) > 0) {
            throw "ORACLE-DRIVER-ERROR", sprintf("OracleSqlUtilBase requires oracle module 3.0+ to query system "
                "catalogs since LONG support was added in oracle module version 3.0; current module version: %s; "
                "upgrade your oracle module to at least 3.0 to use OracleSqlUtilBase",
                get_module_hash().oracle.version);
        }

        ora_major = (nds.getServerVersion() =~ x/([0-9]+)/)[0].toInt();

        introspectSystemViews();
    }

    private introspectSystemViews() {
%ifndef NO_ORACLE
        # validate presence of DBA_* views for this connection/user
        hash dba_in = bindOracleCollection("SYS.ODCIVARCHAR2LIST", map $1.upr(), m_sys_views.keys());
        hash dba_sys = ds.select("select /* OracleSqlUtilBase::OracleTable::constructor */
                object_name
            from all_objects
            where owner = %v
                and object_name in (select column_value from table(%v))
                and object_type = %v",
            "SYS", dba_in, "VIEW");
        context (dba_sys) {
            string n = %object_name.lwr();
            m_sys_views{n} = n;
        }
%endif
%ifdef NO_ORACLE
        throw "MISSING-ORACLE-DRIVER", "system catalogue/dictionary access requires oracle driver";
%endif
    }

    # oraclesqlutil: allow to use DBA_* views instead of ALL_* if possible #2418
    # get the most appropriate system catalogue/dictinary view available
    private string systemView(string name) {
        name = name.lwr();
        if (!m_sys_views.hasKey(name)) {
            throw "TABLE-ERROR", sprintf("Unknown system view %s, known: %y", name, m_sys_views.keys());
        }
        return m_sys_views{name};
    }

    private bool checkExistenceImpl() {
        try {
            setTableInfoIntern();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "TABLE-ERROR") {
                return False;
            }
            rethrow;
        }
        return True;
    }

    private softlist<auto> getDropSqlImpl(*hash<auto> opt) {
        return sprintf("drop table %s%s", getSqlName(),
            (opt.force || opt.cascade || opt.cascade_constraints) ? " cascade constraints" : "");
    }

    private list<auto> getSetStatsPreferencesSqlImpl(hash<auto> preferences) {
        string owner = native_case ? schema : schema.upr();
        string table_name = native_case ? name : name.upr();
        string sql = "begin";

        foreach string pref in (preferences.keyIterator()) {
            sql += sprintf("\n    dbms_stats.set_table_prefs(ownname => %s, tabname => %s, pname => %s, "
                "pvalue => %s);", getSqlValue(owner), getSqlValue(table_name), getSqlValue(pref.upr()),
                getOracleStatsPreferenceSqlValue(preferences{pref}));
        }

        sql += "\nend;";
        list<auto> rv = ();
        rv += sql;
        return rv;
    }

    private string getOracleStatsPreferenceSqlValue(auto value) {
        switch (value.typeCode()) {
            case NT_BOOLEAN:
                return getSqlValue(value ? "TRUE" : "FALSE");

            case NT_NULL:
            case NT_NOTHING:
                return "null";

            default:
                return getSqlValue(string(value));
        }
    }

    private setTableInfoIntern() {
        hash<auto> row = (schema.lwr() == ds.getUserName().lwr()) ? setTable() : setSchemaTable();

        tablespace = row.tablespace_name;
        readonly = row.read_only == "YES";
        if (!native_case && tablespace)
            tablespace = tablespace.lwr();

        # get any comment
        if (!m_isView) {
            auto cm = ds.selectRow("select * from " + systemView("dba_tab_comments") + (dblink ? "@" + dblink : "") + " where owner = %v and table_name = %v", schema.upr(), name.upr()).comments;
            comment = cm ? cm : NOTHING;
        }

        inDb = True;
    }

    #! returns the schema and table name in dot notation
    /** The schema and the name of the table are SQL identifiers as getSqlIdentifier() returns them, followed by
        any database link

        @since OracleSqlUtilBase 1.7 a schema or table name that is not an ordinary name is quoted in upper case
    */
    string getSqlName() {
        return oracle_get_sql_identifier(schema) + "." + oracle_get_sql_object_name(name)
            + (dblink ? "@" + dblink : "");
    }

    #! returns a name as an SQL identifier for Oracle
    /** @copydetails OracleDatabase::getSqlIdentifier()
    */
    string getSqlIdentifier(string name) {
        return oracle_get_sql_identifier(name);
    }

    #! returns the name of the table without its schema for SQL
    private string getSqlTableName() {
        return oracle_get_sql_object_name(name);
    }

    #! returns a column alias for SQL
    /** An alias names no object in the catalog, so it keeps its case: an ordinary name that is not a reserved word is
        returned as given, and any other name in double quotes with its case as given; the \c oracle driver gives
        the names of result columns in lower case

        @param alias the alias of a column in a query

        @return the alias for SQL

        @throw IDENTIFIER-ERROR the alias is empty, or has a double quote or a NUL character, which Oracle does not
        allow in an identifier

        @since OracleSqlUtilBase 1.7
    */
    string getAliasSqlName(string alias) {
        if (alias =~ /\A\p{L}[\p{L}\p{N}_$#]*\z/) {
            return oracle_get_sql_identifier(alias);
        }
        # an alias with a double quote is refused, as any other name is
        if (alias.find("\"") >= 0) {
            return oracle_get_sql_identifier(alias);
        }
        return AbstractSqlUtilBase::getDelimitedIdentifier(alias, "\"", "\"", "Oracle");
    }

    #! This method can change itself or disappear in the near future. Do not use it.
    bool isView() {
        return m_isView;
    }

    private hash<auto> setSchemaTable() {
        # get the table information if possible
        *hash<auto> row = ds.selectRow("select * from " + systemView("dba_tables") + (dblink ? "@" + dblink : "") + " where owner = %v and table_name = %v", schema.upr(), name.upr());
        if (row)
            return row;

        row = ds.selectRow("select * from " + systemView("dba_views") + (dblink ? "@" + dblink : "") + " where owner = %v and view_name = %v", schema.upr(), name.upr());
        if (row) {
            m_isView = True;
            return row;
        }

        throw "TABLE-ERROR", sprintf("table %y.%y does not exist or is not accessible to this user (%s)", schema, name, getDBString());
    }

    private setDblinkSchema() {
        *hash<auto> dblr = ds.selectRow("select * from " + systemView("dba_db_links") + " where owner in "
            "('PUBLIC', %v) and db_link = %v and rownum = 1", ds.getUserName().upr(), dblink);
        if (!dblr)
            throw "TABLE-ERROR", sprintf("dblink %y is unknown", dblink);
        schema = dblr.username;
        if (!native_case)
            schema = schema.lwr();
    }

    # Oracle has supprt for unlimitted synonym loops. There
    # can be mo relevels of synonyms before the real object
    # is listed.
    private *hash resolveSynonym(string s_owner, string s_name) {
        *hash ret;

        # dbms_utility.name_resolve handled some Oracle EBS
        # cryptic aliases and view-hideouts out of the box.
        # select(), no exec(), is used here for reason:
        # we don't want to grab the transaction lock here.
        try {
            hash<auto> plsql = ds.select("declare
                    o_owner varchar2(30);
                    o_table varchar2(30);
                    o_db_link varchar2(30);
                    o_tmp1 varchar2(30);
                    o_tmp2 number;
                    o_tmp3 number;
                begin
                dbms_utility.name_resolve(%v, 0, o_owner, o_table, o_db_link, o_tmp1, o_tmp2, o_tmp3);
                :owner := o_owner;
                :table := o_table;
                :link := o_db_link;
                end;",
                # the name is read as SQL names an object, so a name that needs quotes is given quoted
                sprintf("%s.%s", oracle_get_sql_identifier(s_owner.upr()), oracle_get_sql_identifier(s_name.upr())),
                Type::String, Type::String, Type::String
            );
            # simulate resultset from all_synonyms output
            return {
                "owner": s_owner,
                "synonym_name" : s_name,
                "table_owner" : plsql.owner,
                "table_name" : plsql.table,
                "db_link" : plsql.link,
            };
        } catch (hash<ExceptionInfo> ex) {
            # exceptions are silently ignored - session can miss
            # dbms_utility grants, requested object can be missing etc.
            #printf("resolveSynonym dbms_utility.name_resolve error: %s\n", get_exception_string(ex));
        }

        # fallback synonym resolution if there is no dbms_utility available
        do {
            # TODO/FIXME: db link handling
            ret = ds.selectRow("select s.*, o.object_type
                                from " + systemView("dba_synonyms") + " s
                                    join " + systemView("dba_objects") + " o
                                    on
                                    (
                                            s.table_owner = o.owner
                                        and s.table_name = o.object_name
                                    )
                                where s.owner = %v
                                    and s.synonym_name = %v
                                    and o.object_type in ('TABLE', 'VIEW', 'SYNONYM')",
                            s_owner.upr(), s_name.upr());

            # ret can be NOTHING in case:
            #  - no such synonym exists
            #  - there is a broken synonym eg. pointing to non-existing object
            if (!ret) break;

            s_owner = ret.table_owner;
            s_name = ret.table_name;
        }
        while (ret && ret.object_type == 'SYNONYM');

        return ret;
    }

    private hash<auto> setTable() {
        # see if the current user has the table
        *hash<auto> row = ds.selectRow("select * from user_tables where table_name = %v", name.upr());
        if (row) {
            schema = getUserSchema();
            return row;
        }

        row = ds.selectRow("select * from user_views where view_name = %v", name.upr());
        if (row) {
            m_isView = True;
            schema = getUserSchema();
            return row;
        }

        bool pub = False;
        # see if there is a user synonym with this name
        row = resolveSynonym(schema, name);
        if (!row) {
            # see if there is a public synonym with this name
            row = resolveSynonym("PUBLIC", name);
            if (!row) {
                throw "TABLE-ERROR", sprintf("table %y or synonym %y does not exist or is not accessible to this "
                    "user (%s)", name, name, getDBString());
            }
            pub = True;
        }

        # update the table name if necessary
        string orig_name = name;
        if (name.upr() != row.table_name) {
            name = row.table_name;
            if (!native_case)
                name = name.lwr();
        }

        if (row.db_link) {
            dblink = oracle_check_dblink(row.db_link);

            setDblinkSchema();

            if (!native_case)
                dblink = dblink.lwr();
        }

        if (row.table_owner) {
            schema = row.table_owner;
            if (!native_case)
                schema = schema.lwr();
        }

        # get the table information if possible
        row = ds.selectRow("select * from " + systemView("dba_tables") + (dblink ? "@" + dblink : "") +
            " where owner = %v and table_name = %v", schema.upr(), name.upr());
        if (row) {
            return row;
        }

        row = ds.selectRow("select * from " + systemView("dba_views") + (dblink ? "@" + dblink : "") +
            " where owner = %v and view_name = %v", schema.upr(), name.upr());
        if (row) {
            m_isView = True;
            return row;
        }

        throw "TABLE-ERROR", sprintf("%y is a %ssynonym pointing to table %y.%y which does not exist or is not "
            "accessible to this user (%s)", orig_name, pub ? "public " : "", schema, name, getDBString());
    }

    private string getUserSchema() {
        string rv = ds.getUserName();
        if (native_case)
            rv = rv.upr();
        return rv;
    }

    private string getDBString() {
        return sprintf("%s@%s", ds.getUserName(), ds.getDBName());
    }

    #! returns the schema name
    string getSchemaName() {
        return schema;
    }

    #! returns the data tablespace name for the table if any or @ref nothing if none is known
    *string getTablespaceName() {
        return tablespace;
    }

    #! returns any table comment or @ref nothing if none is known
    *string getComment() {
        return comment;
    }

    bool readOnly() {
        return readonly;
    }

    private hash<auto> getColumnOptions() {
        return OraColumnOptions;
    }

    private hash<auto> getColumnDescOptions() {
        return OraColumnDescOptions;
    }

    #! override in subclasses to return driver-specific options
    private hash<auto> getSelectOptions() {
        return OracleSelectOptions;
    }

    #! Returns True if the current connection supports optimized \c limit option handling
    /** @note <tt>FETCH NEXT x ROWS ONLY</tt> is not supported with <tt>FOR UPDATE</tt>
    */
    private bool optimizedLimit(*hash<auto> qh) {
        # Oracle 12c+ supports limit (fetch) and offset
        if (ora_major >= 12 && !qh.forupdate) {
            return True;
        }
        return False;
    }

    private insertLimitOptimizerHint(hash<auto> qh, reference<string> sql) {
        # http://www.oracle.com/technetwork/issue-archive/2006/06-sep/o56asktom-086197.html
        # /*+ first_rows(n) */ is an optimizer hint that we want the first rows as fast as possible
        # NOTE: an optimizer hint is only recognized directly after the leading SQL keyword; when placed anywhere
        # else (such as after the "from" clause) Oracle silently treats it as a plain comment and ignores it
        splice sql, SelectKeyword.size(), 0, sprintf(" /*+ first_rows(%d) */", qh.limit);
    }

    #! Oracle accepts non-unique orderby + offset/limit at the SQL level;
    #! the determinism check in AbstractTable is overly strict here.
    /** Pagination across orderby ties may still yield non-deterministic
        ordering — that's the caller's concern, not a SQL-validity issue.
    */
    bool requireUniqueOrderByWithOffsetLimit() {
        return False;
    }

    private doSelectOrderByWithOffsetSqlInternImpl(reference<hash<QueryInfo>> info, reference<string> sql,
            list<auto> coll) {
        # Oracle 12c+ supports limit (fetch) and offset
        softint limit = info.query_hash.limit ?? 0;
        softint offset = info.query_hash.offset ?? 0;
        if (optimizedLimit(info.query_hash)) {
            doSelectOrderBySqlIntern(info, \sql, coll);

            if (info.query_hash.offset) {
                sql += " offset %v rows";
                info.args += offset;
            }

            if (limit) {
                sql += " fetch next %v rows only";
                info.args += limit;
            }

            return;
        }

        string sort = getOrderByExpressionIntern(info, coll);

        if (info.query_hash.forupdate) {
            doSelectForUpdateWithLimitSqlIntern(\info, \sql, sort, limit, offset);
            return;
        }

        # http://www.oracle.com/technetwork/issue-archive/2006/06-sep/o56asktom-086197.html
        # /*+ first_rows(n) */ is an optimizer hint that we want the first rows as fast as possible
        # NOTE: the subquery is necessary because the ORDER BY clause is enforced *after* the ROWNUM
        # is calculated; see:
        # - https://docs.oracle.com/en/database/oracle/oracle-database/21/sqlrf/ROWNUM-Pseudocolumn.html#GUID-2E40EC12-3FCF-4A4F-B5F2-6BC669021726
        # - https://stackoverflow.com/questions/15091849/how-to-use-oracle-order-by-and-rownum-correctly/15091900
        sql = sprintf("select * from (select /*+ first_rows(%d) */ a.*, rownum rnum from (%s order by %s) a "
            "where rownum <= %v) where rnum > %v", limit, sql, sort);
        if (offset) {
            limit += offset;
        }
        info.args += limit;
        info.args += offset;
    }

    #! Returns the \c ORDER BY expression list of an ordered page with the sort direction of every column
    /** Applies the global \c desc option, the \c "-column" prefix and the qualifier-hash \c desc and \c nulls
        settings to each column, exactly as @ref SqlUtil::AbstractTable::doSelectOrderBySqlIntern() does for a query
        without \c limit or \c offset.

        @param info the query being generated
        @param coll the columns selected, for numeric \c orderby references

        @return the comma-separated \c ORDER BY expressions, without the \c "order by" keywords
    */
    private string getOrderByExpressionIntern(hash<QueryInfo> info, list<auto> coll) {
        list<auto> ce = getOrderByListIntern(info, coll);
        list<string> ol;
        for (int i = 0; i < ce.size(); ++i) {
            string entry = ce[i];
            if (info.query_hash.desc || info.query_hash.orderbydesc{entry} || info.query_hash.orderbydescidx{i}) {
                entry += " desc";
            }
            if (info.query_hash.orderbynulls{i}) {
                entry += " nulls " + info.query_hash.orderbynulls{i};
            }
            ol += entry;
        }
        return foldl $1 + ", " + $2, ol;
    }

    #! Rewrites an ordered, paged query so that the selected rows can be locked with \c FOR UPDATE
    /** An ordered page has to be produced with an inline view, because \c ROWNUM is assigned before \c ORDER BY is
        applied.  Oracle rejects a plain \c FOR UPDATE against an inline view (\c ORA-02014), and also rejects it in
        combination with <tt>FETCH NEXT ... ROWS ONLY</tt> (see @ref optimizedLimit()), so the rows of the page
        cannot be locked by the query that selects them.

        Instead the page is reduced to the \c ROWIDs of its rows in an inline view, which is joined to the base
        table by \c ROWID; @ref doForUpdate() then locks only the rows of the base table with
        <tt>FOR UPDATE OF</tt>, which Oracle allows.

        The page view must be joined rather than used as a <tt>rowid in (subquery)</tt> predicate: the optimizer
        may unnest such a subquery into a hash semi-join driven by a full scan of the base table or of one of its
        indexes, and when the statement is parsed while the table is empty or has no statistics (a new schema),
        that plan is cached and reused after the table has grown, so every execution reads the whole table.  An
        inline view containing \c ROWNUM cannot be merged or unnested, so the join is always driven by the page
        and the base table is always accessed by \c ROWID, whatever its size.

        @param info the query being generated
        @param sql the query SQL generated so far; the leading \c "select" keyword and the \c "from" clause are
            reused as-is, so any bind arguments in the column list and in the \c where clause keep their positions
        @param sort the \c ORDER BY expression list, with the sort direction of every column
        @param limit the maximum number of rows in the page
        @param offset the number of rows to skip before the page

        @throw ORACLE-SELECT-ERROR the query selects from more than one table; the rows to lock cannot be
            attributed to a single base table in that case
    */
    private doSelectForUpdateWithLimitSqlIntern(reference<hash<QueryInfo>> info, reference<string> sql, string sort,
            softint limit, softint offset) {
        int fpos = sql.find(FromKeyword);
        if (fpos < 0) {
            throw "ORACLE-SELECT-ERROR", sprintf("cannot generate a 'for update' query with 'limit' or 'offset' "
                "from %y; no 'from' clause found", sql);
        }
        if (info.query_hash.join) {
            throw "ORACLE-SELECT-ERROR", sprintf("%s: 'forupdate' cannot be combined with 'limit' or 'offset' in a "
                "query with joins; Oracle cannot lock rows selected through an inline view (ORA-02014), and the "
                "rows of the page cannot be attributed to a single base table", getDesc());
        }

        # the column list (with the leading "select" keyword) and the "from" clause are reused unchanged, so that
        # any bind arguments they contain keep the same relative order as the arguments added for limit / offset;
        # the page view's only column has a reserved name, so unqualified column references still resolve to the
        # base table, except for a bare "*", which would also return the page view's column
        string collist = sql.substr(0, fpos);
        if (collist =~ /^select\s+\*\s*$/) {
            collist = SelectKeyword + " " + ForUpdatePageTableAlias + ".*";
        }
        string from = sql.substr(fpos);

        sql = sprintf("%s from %s %s, (select %s from (select /*+ first_rows(%d) */ %s, rownum rnum from "
            "(select rowid %s%s order by %s) where rownum <= %v) where rnum > %v) %s%s%s",
            collist, getSqlName(), ForUpdatePageTableAlias, ForUpdatePageRowidColumn, limit,
            ForUpdatePageRowidColumn, ForUpdatePageRowidColumn, from, sort, ForUpdatePageViewAlias,
            ForUpdatePageJoin, sort);

        if (offset) {
            limit += offset;
        }
        info.args += limit;
        info.args += offset;
    }

    #! Appends the \c FOR UPDATE clause to a select query
    /** A locked page (see doSelectForUpdateWithLimitSqlIntern()) joins the base table to an inline view, which
        a plain \c FOR UPDATE would also try to lock (\c ORA-02014), so only the base table's rows are locked
        with <tt>FOR UPDATE OF</tt> there.
    */
    private doForUpdate(reference<string> sql) {
        if (sql.find(ForUpdatePageJoin) >= 0) {
            sql += sprintf(" for update of %s.%s", ForUpdatePageTableAlias, getColumnSqlName(describe().keys()[0]));
            return;
        }
        sql += " for update";
    }

    #! processes a string for use in SQL select statements when there is a "limit" argument, but no "orderby" or "offset" arguments
    private doSelectLimitOnlyInternImpl(reference<hash<QueryInfo>> info, reference<string> sql) {
        if (!info.query_hash.limit)
            return;

        # Oracle 12c+ supports limit (fetch) and offset
        if (optimizedLimit(info.query_hash)) {
            sql += " fetch next %v rows only";
            info.args += info.query_hash.limit.toInt();
            return;
        }

        if (!info.query_hash."where") {
            sql += " where ";
        } else {
            int i = sql.find(" where ");
            splice sql, i + 7, 0, "(";
            sql += ") and ";
        }
        sql += "rownum <= %v";
        info.args += info.query_hash.limit.toInt();
        if (sql.find(" /*+ first_rows(") == -1) {
            insertLimitOptimizerHint(info.query_hash, \sql);
        }
    }

    private Columns describeImpl() {
        if (!tablespace)
            setTableInfoIntern();

        # get column descriptions
        *hash qh = ds.select("select col.column_name, data_type, data_length, data_precision, data_scale, "
            "nullable, data_default, char_length, char_used, comments from " + systemView("dba_tab_columns")
            + (dblink ? "@" + dblink : "") + " col, " + systemView("dba_col_comments")
            + (dblink ? "@" + dblink : "") + " com where col.owner = %v and col.table_name = %v and "
            "com.owner = col.owner and com.table_name = col.table_name and com.column_name = col.column_name "
            "order by column_id", schema.upr(), name.upr());
        if (!qh.column_name) {
            throw "TABLE-ERROR", sprintf("cannot retrieve table information for table %y.%y in %y", schema, name,
                dsdesc);
        }

        # now we have to find unvalidated but enabled not null constraints - because these cause the column to
        # appear to be "nullable" when it really isn't
        # also we can't filter by search_condition, because it's a LONG, otherwise we could make a left join
        # above :(
        *hash nnq = ds.select("select * from " + systemView("dba_constraints") + (dblink ? "@" + dblink : "") +
            " where owner = %v and table_name = %v and generated = 'GENERATED NAME' and constraint_type = 'C' "
            "and status = 'ENABLED' and validated != 'VALIDATED'", schema.upr(), name.upr());
        hash cnh;
        context (nnq) {
            *string cn = (%search_condition =~ x/"([^"]+)" IS NOT NULL$/)[0];
            if (cn)
                cnh{cn} = True;
        }

        hash rv;
        foreach hash<auto> row in (qh.contextIterator()) {
            #if (row.column_name == "TAX_AMOUNT")
            #    printf("DBG: %y\n", row);
            *hash th = OraTypeMap.(row.data_type.lwr());
            int size = row.data_type == "NUMBER" && row.data_precision ? row.data_precision : row.data_length;
            switch (row.data_type) {
                case "ROWID":
                case "UROWID":
                case "DATE":
                case "BINARY_FLOAT":
                case "BINARY_DOUBLE":
                case =~ /^TIMESTAMP/:
                case =~ /^INTERVAL/:
                case "BFILE":
                case "BLOB":
                case "CLOB": size = 0; break;
            }
            # there is no size for NTY objects (not listed in registered types in OraTypeMap)
            if (!exists th) {
                size = 0;
            }

            # set default numeric precision to 0 if not given
            if (row.data_precision === NULL && row.data_type == "NUMBER") {
                row.data_precision = 0;
                row.data_scale = 0;
            }

            bool nullable = row.nullable == "Y" && !cnh{row.column_name};
            if (!native_case) {
                row.column_name = row.column_name.lwr();
                row.data_type = row.data_type.lwr();
            }
            trim row.data_default;

            bool char_used;
            if (row.char_used == "C") {
                char_used = True;
                size = row.char_length;
            } else
                char_used = False;

            OracleColumn c;
            if (row.data_precision || row.data_type == "number")
                c = new OracleNumberColumn(row.column_name, row.data_type, th.qore, row.data_precision, nullable,
                    row.data_default, row.comments ? row.comments : NOTHING, row.data_length, row.data_scale);
            else
                c = new OracleColumn(row.column_name, row.data_type, th.qore, size, nullable, row.data_default,
                    row.comments ? row.comments : NOTHING, th.is_char, row.char_used == "C", row.data_length);

            rv.(row.column_name) = c;
        }

        return new Columns(rv);
    }

    private OraclePrimaryKey getPrimaryKeyImpl() {
        if (!tablespace)
            setTableInfoIntern();

        hash rv;

        # get primary key description
        *hash qh = ds.select("select cons.constraint_name, cols.column_name, cols.position, cons.status, cons.index_name from " + systemView("dba_constraints") + (dblink ? "@" + dblink : "") + " cons, " + systemView("dba_cons_columns") + (dblink ? "@" + dblink : "") + " cols where cols.owner = %v and cols.table_name = %v and cons.constraint_type = 'P' and cons.owner = cols.owner and cons.constraint_name = cols.constraint_name order by cols.position", schema.upr(), name.upr());
        if (!qh.constraint_name)
            return new OraclePrimaryKey();

        foreach string col in (qh.column_name) {
            string cn = native_case ? col : col.lwr();
            rv{cn} = columns{cn};
        }

        string pkname = qh.constraint_name[0];
        if (!native_case)
            pkname = pkname.lwr();

        OraclePrimaryKey pk(pkname, rv, NOTHING, NOTHING, False, getPartitionKeyColumns());
        # set the base index if present
        if (qh.index_name[0]) {
            if (!native_case)
                qh.index_name[0] = qh.index_name[0].lwr();
            pk.setIndexBase(qh.index_name[0]);
        }
        return pk;
    }

    private Indexes getIndexesImpl() {
        if (!tablespace)
            setTableInfoIntern();

        hash rv;

        # get index description
        *hash qh = ds.select("select i.index_name, i.index_type, i.uniqueness, i.tablespace_name, c.constraint_name,
    pi.locality
from " + systemView("dba_indexes") + (dblink ? "@" + dblink : "") + " i left join " + systemView("dba_constraints") + (dblink ? "@" + dblink : "") + " c on (i.index_name = c.index_name and i.owner = c.owner and i.table_name = c.table_name)
left join " + systemView("dba_part_indexes") + (dblink ? "@" + dblink : "") + " pi on (i.index_name = pi.index_name and i.owner = pi.owner and i.table_name = pi.table_name)
where i.owner = %v and i.table_name = %v", schema.upr(), name.upr());
        if (qh.index_name) {
            hash<auto> ih;
            softlist<string> partition_columns = getPartitionKeyColumns();

            # A local index has no single physical tablespace in DBA_INDEXES.  Preserve the tablespace only when
            # every physical index partition uses the same one, since that is the only value that can be recreated
            # faithfully with a single table-description option.
            hash<string, string> partition_tablespaces;
            if (partition_columns) {
                *hash<auto> ptqh = ds.select("select p.index_name, min(p.tablespace_name) min_tablespace_name,
    max(p.tablespace_name) max_tablespace_name
from " + systemView("dba_ind_partitions") + (dblink ? "@" + dblink : "") + " p, "
                    + systemView("dba_indexes") + (dblink ? "@" + dblink : "") + " i
where p.index_owner = i.owner and p.index_name = i.index_name and i.table_owner = %v and i.table_name = %v
group by p.index_name", schema.upr(), name.upr());
                foreach hash<auto> row in (ptqh.contextIterator()) {
                    if (row.min_tablespace_name && row.min_tablespace_name == row.max_tablespace_name) {
                        string index_name = native_case ? row.index_name : row.index_name.lwr();
                        partition_tablespaces{index_name} = native_case
                            ? row.min_tablespace_name
                            : row.min_tablespace_name.lwr();
                    }
                }
            }

            # get column info for all indexes in 1 query
            *hash<auto> iqh = ds.select("select c.index_name, c.column_name, e.column_expression from " + systemView("dba_ind_columns") + (dblink ? "@" + dblink : "") + " c left join " + systemView("dba_ind_expressions") + (dblink ? "@" + dblink : "") + " e on (c.table_owner = e.index_owner and c.index_name = e.index_name and c.table_name = e.table_name) where c.table_owner = %v and c.table_name = %v order by c.index_name, c.column_position", schema.upr(), name.upr());
            foreach hash<auto> row in (iqh.contextIterator()) {
                if (!native_case)
                    map row.$1 = row.$1.lwr(), ("index_name", "column_name", "column_expression"), row.$1;
                # process function indexes
                if (row.column_expression) {
                    row.column_expression =~ s/"//g;
                    ih{row.index_name}{row.column_expression} = {};
                }
                else
                    ih{row.index_name}{row.column_name} = columns{row.column_name};
            }

            foreach hash<auto> row in (qh.contextIterator()) {
                if (!native_case)
                    map row.$1 = row.$1.lwr(), ("index_name", "tablespace_name", "constraint_name"), row.$1;

                # skip system indexes
                if (!ih{row.index_name})
                    continue;
                string scope = partition_columns
                    ? (row.locality == "LOCAL" ? "local" : "global")
                    : "default";
                *string index_tablespace = scope == "local" && partition_tablespaces.hasKey(row.index_name)
                    ? partition_tablespaces{row.index_name}
                    : row.tablespace_name;
                rv.(row.index_name) = new OracleIndex(row.index_name, row.uniqueness == "UNIQUE",
                    ih{row.index_name}, row.index_type, index_tablespace, NOTHING, NOTHING, scope, False,
                    partition_columns);
                if (row.constraint_name) {
                    *AbstractUniqueConstraint uk = findUniqueConstraintUnlocked(row.constraint_name);
                    if (uk) {
                        if (uk instanceof OraclePrimaryKey) {
                            cast<OraclePrimaryKey>(uk).setPartitionScope(scope);
                        } else {
                            cast<OracleUniqueConstraint>(uk).setPartitionScope(scope);
                        }
                        rv.(row.index_name).setSupportingConstraint(uk);
                        uk.setIndexBase(row.index_name);
                    }
                }
            }

        }

        return new Indexes(rv);
    }

    #! Converts a Qore/DPQL date format string to an Oracle TO_CHAR() format string
    /** @param fmt the Qore date format string (e.g., "YYYY-MM-DD HH:mm:SS.us")
        @return the equivalent Oracle format string (e.g., "YYYY-MM-DD HH24:MI:SS.FF6")

        @since %Qore 3.0
    */
    static string convertDateFormat(string fmt) {
        # use negative lookahead to avoid double-replacing "HH24" -> "HH2424"
        fmt = regex_subst(fmt, "HH(?!24)", "HH24", RE_Global);
        fmt = regex_subst(fmt, "mm", "MI", RE_Global);
        fmt = regex_subst(fmt, "us", "FF6", RE_Global);
        fmt = regex_subst(fmt, "ms", "FF3", RE_Global);
        # escape single quotes for safe SQL embedding
        fmt = regex_subst(fmt, "'", "''", RE_Global);
        return fmt;
    }

    private ForeignConstraints getForeignConstraintsImpl(*hash opts) {
        if (!tablespace)
            setTableInfoIntern();

        hash ch;

        # get foreign referential constraints
        # the constraints of the table's schema, which can be another user's
        *hash qh = ds.select("select constraint_name, status, deferrable, deferred, delete_rule from "
            + systemView("dba_constraints") + (dblink ? "@" + dblink : "")
            + " where owner = %v and table_name = %v and constraint_type = 'R'", schema.upr(), name.upr());
        if (qh.status) {
            hash rv;
            foreach hash<auto> row in (qh.contextIterator()) {
                if (!native_case)
                    row.constraint_name = row.constraint_name.lwr();
                rv.(row.constraint_name) = (
                    "enabled": row.status == "ENABLED",
                    "deferrable": row.deferrable == "DEFERRABLE",
                    "initially_deferred": row.deferred == "DEFERRED",
                    "on_delete": OracleForeignConstraint::actionFromCatalog(row.delete_rule),
                    );
            }
            qh = ds.select("select c.constraint_name, status, cols1.column_name source_column, cols1.position, cols2.owner target_owner, cols2.table_name target_table, cols2.column_name target_column from " + systemView("dba_constraints") + (dblink ? "@" + dblink : "") + " c, " + systemView("dba_cons_columns") + (dblink ? "@" + dblink : "") + " cols1, " + systemView("dba_cons_columns") + (dblink ? "@" + dblink : "") + " cols2 where c.owner = %v and c.table_name = %v and c.constraint_name = cols1.constraint_name and constraint_type = 'R' and c.r_constraint_name = cols2.constraint_name and cols1.position = cols2.position and cols1.owner = c.owner and cols2.owner = c.owner order by cols1.position", schema.upr(), name.upr());
            # a target table in another schema than the connection's is given with its schema, as SQL names it
            string user = ds.getUserName().upr();
            foreach hash<auto> row in (qh.contextIterator()) {
                if (!native_case) {
                    row.constraint_name = row.constraint_name.lwr();
                    row.source_column = row.source_column.lwr();
                    row.target_column = row.target_column.lwr();
                    row.target_table = row.target_table.lwr();
                }
                if (row.target_owner != user) {
                    row.target_table = (native_case ? row.target_owner : row.target_owner.lwr()) + "."
                        + row.target_table;
                }
                reference<hash> c = \rv.(row.constraint_name);
                #if (!columns.hasKey(row.source_column))# && c.target.columns.(row.target_column)) {
                #    printf("ERROR: %y.%y ->  %y.%y (%y): %y\n", name, row.source_column, row.target_table, row.target_column, row.constraint_name, columns.keys());
                c.columns.(row.source_column) = columns{row.source_column};
                c.target.table = row.target_table;
                c.target.columns.(row.target_column) = True;
            }

            foreach hash<auto> c in (rv.pairIterator()) {
                # get a description of the target table's columns
                Columns targ_columns = getReferencedTableColumnsUnlocked(c.value.target.table, opts.table_cache);
                ForeignConstraintTarget fct(c.value.target.table, targ_columns.subset(c.value.target.columns.keys()));
                ch.(c.key) = new OracleForeignConstraint(c.key, new Columns(c.value.columns), fct, c.value.enabled,
                    c.value.deferrable, c.value.initially_deferred, c.value.on_delete);
            }
        }

        return new ForeignConstraints(ch);
    }

    private Constraints getConstraintsImpl() {
        if (!tablespace)
            setTableInfoIntern();

        # get only user check constraints
        *hash qh = ds.select("select constraint_name, search_condition, status from " + systemView("dba_constraints") + (dblink ? "@" + dblink : "") + " where owner = %v and table_name = %v and constraint_type = 'C' and generated != 'GENERATED NAME'", schema.upr(), name.upr());
        hash rv;
        foreach hash<auto> row in (qh.contextIterator()) {
            if (!native_case)
                row.constraint_name = row.constraint_name.lwr();
            rv.(row.constraint_name) = new OracleCheckConstraint(row.constraint_name, row.search_condition, row.status == "ENABLED");
        }

        Constraints c(rv);

        # now get unique constraints
        qh = ds.select("select c.constraint_name, status, cols.column_name, cols.position, status, c.index_name from " + systemView("dba_constraints") + (dblink ? "@" + dblink : "") + " c, " + systemView("dba_cons_columns") + (dblink ? "@" + dblink : "") + " cols where c.owner = %v and c.table_name = %v and c.constraint_name = cols.constraint_name and constraint_type = 'U' and cols.owner = c.owner and generated != 'GENERATED NAME' order by cols.position", schema.upr(), name.upr());
        delete rv;
        foreach hash<auto> row in (qh.contextIterator()) {
            if (!native_case)
                map row.$1 = row.$1.lwr(), ("constraint_name", "column_name", "index_name"), row.$1;
            reference<OracleUniqueConstraint> ch = \rv.(row.constraint_name);
            if (!ch) {
                ch = new OracleUniqueConstraint(row.constraint_name, {}, row.status == "ENABLED", NOTHING,
                    NOTHING, False, getPartitionKeyColumns());
                if (row.index_name)
                    ch.setIndexBase(row.index_name);
            }
            ch.add(row.column_name, columns{row.column_name});
        }

        # add unique constraints to constraint hash
        map c.add($1.key, $1.value), rv.pairIterator();

        return c;
    }

    private Triggers getTriggersImpl() {
        if (!tablespace)
            setTableInfoIntern();

        hash<string, OracleTrigger> rv;

        # get trigger description
        *hash<auto> qh = ds.select("select * from " + systemView("dba_triggers") + (dblink ? "@" + dblink : "") + " where owner = %v and table_name = %v", schema.upr(), name.upr());
        foreach hash<auto> row in (qh.contextIterator()) {
            if (!native_case)
                map row.$1 = row.$1.lwr(), ("trigger_name", "trigger_type", "triggering_event", "referencing_names");
            #printf("%y: %s\n", row.trigger_name, row.description);

            # replace newlines with spaces
            row.description =~ s/\n/ /g;
            trim row.description;

            # remove trigger name from description line
            row.description = regex_subst(row.description, "^.*" + row.trigger_name + ".", "", RE_Caseless);
            rv{row.trigger_name} = new OracleTrigger(row.trigger_name, row.description + "\n" + row.trigger_body, row.status == "ENABLED");
        }

        return new Triggers(rv);
    }

    string getCreateTableSqlImpl(*hash opt) {
        string sql = sprintf("%s (\n", getCreateTableStartSql());

        sql += foldl $1 + ",\n" + $2, (map sprintf("  %s", $1.getCreateSql(self)), columns.iterator());
        sql += "\n)";

        # temporary-table "on commit ... definition" clause must precede any tablespace/partition clause
        sql += getCreateTableTempClauseSql();

        *string ts = opt.data_tablespace ? opt.data_tablespace : tablespace;
        if (ts) {
            sql += sprintf(" tablespace %s", oracle_get_sql_identifier(ts));
        }

        sql += getOraclePartitionCreateClause();

        return sql;
    }

    #! returns \c "create private temporary table <name>" for runtime temporary tables, \c "create table <name>" otherwise
    /** runtime temporary tables use Oracle 18c+ private temporary tables; pre-created (schema-managed) global
        temporary tables never emit runtime DDL and so use the normal create prefix
    */
    private string getCreateTableStartSql() {
        if (isTempTable() && !isPreCreatedTempTable()) {
            return sprintf("create private temporary table %s", getSqlTableName());
        }
        return AbstractTable::getCreateTableStartSql();
    }

    #! returns the Oracle private-temporary-table \c "on commit ... definition" clause based on the scope
    /** transaction-scoped private temporary tables use \c "on commit drop definition"; session-scoped ones use
        \c "on commit preserve definition"
    */
    private string getCreateTableTempClauseSql() {
        if (isTempTable() && !isPreCreatedTempTable()) {
            return getTempScope() == SqlUtil::TT_Transaction
                ? " on commit drop definition"
                : " on commit preserve definition";
        }
        return "";
    }

    private string getOraclePartitionCreateClause() {
        if (!partitionStrategy) {
            return "";
        }
        getPartitionsUnlocked();
        if (partitions.empty()) {
            throw "PARTITION-ERROR", sprintf("%s: Oracle %s-partitioned tables require at least one partition "
                "definition in the table description", getDesc(), partitionStrategy.method);
        }

        string sql = sprintf(" partition by %s (%s)", partitionStrategy.method, (foldl $1 + ", " + $2,
            getColumnSqlNames(partitionStrategy.columns)));
        if (partitionStrategy.auto) {
            *string expr = partitionStrategy.auto.expression ?? partitionStrategy.auto.interval;
            if (expr) {
                sql += sprintf(" interval (%s)", expr);
            }
        }

        list<string> defs = ();
        foreach hash<PartitionInfo> pi in (partitions.iterator()) {
            defs += "  " + getOraclePartitionDefinitionSql(pi);
        }
        return sql + " (\n" + (foldl $1 + ",\n" + $2, defs) + "\n)";
    }

    #! Returns the expression map for Oracle
    hash<auto> getExpressionMap() {
        return OracleExpressionMap;
    }

    #! returns the "where" operator map for Oracle
    hash<auto> getWhereOperatorMap() {
        return OracleOpMap;
    }

    private *list getCreateMiscSqlImpl(*hash opt, bool cache) {
        if (cache)
            getColumnsUnlocked();
        # the table is named as the SQL that creates it names it
        return map AbstractDatabase::doCallback(opt, sprintf("comment on column %s.%s is %s", getSqlTableName(),
            $1.ddl_name, getSqlValueImpl($1.comment)), AbstractDatabase::AC_Add, "column comment", $1.name, name),
            columns.iterator(), $1.comment;
    }

    private string getCreateSqlImpl(list l) {
        return OracleDatabase::getCreateSql(l);
    }

    private string getRenameSqlImpl(string new_name) {
        return sprintf("alter table %s rename to %s", getSqlName(), oracle_get_sql_identifier(new_name));
    }

    private AbstractColumn addColumnImpl(string cname, hash opt, bool nullable = True) {
        if (opt.precision)
            return new OracleNumberColumn(cname, opt.native_type, opt.qore_type, opt.precision, nullable, opt.default_value, opt.comment, 0, opt.scale);
        return new OracleColumn(cname, opt.native_type, opt.qore_type, opt.size, nullable, opt.default_value, opt.comment, opt.local_def.is_char, opt.character_semantics, 0);
    }

    private softlist<string> getPartitionKeyColumns() {
        *hash<PartitionStrategy> strategy = getPartitionStrategy();
        return strategy ? strategy.columns : NOTHING;
    }

    private OracleIndex getConstraintIndex(string cname, hash<auto> ch, string iname, *string requested_scope) {
        Indexes all_indexes = getIndexes();
        if (!all_indexes.hasKey(iname)) {
            throw "CONSTRAINT-OPTION-ERROR", sprintf("Oracle constraint %y references unknown index %y", cname,
                iname);
        }

        OracleIndex ix = cast<OracleIndex>(all_indexes{iname});
        if (!ix.columns.matchKeys(ch)) {
            throw "CONSTRAINT-OPTION-ERROR", sprintf("Oracle constraint %y columns %y do not match index %y "
                "columns %y", cname, ch.keys(), iname, ix.columns.keys());
        }

        if (requested_scope.val() && requested_scope.lwr() != "default"
            && ((requested_scope.lwr() == "local") != (ix.getEffectivePartitionScope() == "local"))) {
            throw "CONSTRAINT-OPTION-ERROR", sprintf("Oracle constraint %y partition_scope %y conflicts with "
                "index %y partition_scope %y", cname, requested_scope, iname, ix.getEffectivePartitionScope());
        }
        return ix;
    }

    private AbstractPrimaryKey addPrimaryKeyImpl(string cname, hash ch, *hash opt) {
        OraclePrimaryKey pk(cname, ch, opt.index_tablespace, opt.partition_scope, opt.compute_statistics,
            getPartitionKeyColumns());
        if (opt.index) {
            OracleIndex ix = getConstraintIndex(cname, ch, opt.index, opt.partition_scope);
            pk.setPartitionScope(ix.getEffectivePartitionScope());
            pk.setIndexBase(opt.index);
        }
        return pk;
    }

    private AbstractIndex addIndexImpl(string iname, bool enabled, hash ch, *hash opt) {
        # Oracle has no per-column operator class concept (domain indexes bind operators differently);
        # reject the generic opclass option with a clear message
        if (opt.opclass) {
            throw "INDEX-OPTION-ERROR", sprintf("index %y: the generic 'opclass' option is not supported "
                "on Oracle", iname);
        }
        # "with" is only meaningful for domain indexes (PARAMETERS clause)
        if (opt.with && !opt.method.val()) {
            throw "INDEX-OPTION-ERROR", sprintf("index %y: the generic 'with' option on Oracle requires "
                "the 'method' option to name a domain indextype", iname);
        }
        return new OracleIndex(iname, enabled, ch, "normal", opt.index_tablespace, opt.method, opt.with,
            opt.partition_scope, opt.compute_statistics, getPartitionKeyColumns());
    }

    private AbstractForeignConstraint addForeignConstraintImpl(string cname, hash ch, string table, hash tch, *hash opt) {
        ForeignConstraintTarget fct(table, new Columns(tch));
        return new OracleForeignConstraint(cname, new Columns(ch), fct, True, opt.deferrable,
            opt.initially_deferred, opt.on_delete, opt.on_update);
    }

    private AbstractCheckConstraint addCheckConstraintImpl(string cname, string src, *hash opt) {
        return new OracleCheckConstraint(cname, src);
    }

    private AbstractUniqueConstraint addUniqueConstraintImpl(string cname, hash ch, *hash opt) {
        OracleUniqueConstraint uk(cname, ch, True, opt.index_tablespace, opt.partition_scope,
            opt.compute_statistics, getPartitionKeyColumns());
        if (opt.index) {
            OracleIndex ix = getConstraintIndex(cname, ch, opt.index, opt.partition_scope);
            uk.setPartitionScope(ix.getEffectivePartitionScope());
            uk.setIndexBase(opt.index);
        }
        return uk;
    }

    private AbstractTrigger addTriggerImpl(string tname, string src, *hash opt) {
        return new OracleTrigger(tname, src);
    }

    private bool tryInsertImpl(string sql, hash<auto> row) {
        try {
            ds.vexec(sql, row.values());
        } catch (hash<ExceptionInfo> ex) {
            if (isDuplicateRowError(ex)) {
                return False;
            }
            rethrow;
        }
        return True;
    }

    #! Returns True if the exception was raised because of a duplicate row / key error
    /** @since OracleSqlUtilBase 1.4.3
    */
    private bool isDuplicateRowErrorImpl(hash<ExceptionInfo> ex) {
        return ex.desc =~ /ORA-00001/;
    }

    #! Returns True if the exception indicates that the partition already exists
    /** Oracle range partitioning is append-only at the high end, so a concurrent roll-forward manifests in one of
        three ways when the losing instance re-issues its \c ADD \c PARTITION:
        - ORA-14013 (duplicate partition name) when the name already exists with a higher bound;
        - ORA-00955 (name is already used by an existing object) for the CREATE/interval partition path;
        - ORA-14074 (partition bound must collate higher than the last partition) when the winner already extended
          the range to the requested bound, so the bound is no longer higher than the last partition.

        ORA-14074 is ambiguous (it also indicates a genuinely out-of-order bound), but treating it as a possible
        concurrent create is safe: ensurePartition() only returns success if the partition then re-resolves by
        bounds or by canonical name; a real ordering error resolves to neither and is re-raised as a
        \c PARTITION-ERROR.

        @since OracleSqlUtilBase 1.6
    */
    private bool isPartitionExistsErrorImpl(hash<ExceptionInfo> ex) {
        return ex.desc =~ /ORA-14013|ORA-00955|ORA-14074/;
    }

    private *list getAlignSqlImpl(AbstractTable t, *hash opt) {
    }

    private hash<auto> getQoreTypeMapImpl() {
        return QoreTypeMap;
    }

    private hash<auto> getTypeMapImpl() {
        return OraTypeMap;
    }

    private *hash<auto> getIndexDescriptionOptionsImpl(AbstractIndex index) {
        OracleIndex ix = cast<OracleIndex>(index);
        hash<auto> rv;
        string scope = ix.getEffectivePartitionScope();
        if (scope != "default") {
            rv.partition_scope = scope;
        }
        if (ix.tablespace) {
            rv.index_tablespace = ix.tablespace;
        }
        if (ix.compute_statistics) {
            rv.compute_statistics = True;
        }
        if (ix.method) {
            rv.method = ix.method;
        } else if (ix.native_type.lwr() == "bitmap") {
            rv.method = "bitmap";
        }
        if (ix.with_options) {
            rv.with = ix.with_options;
        }
        return rv ? rv : NOTHING;
    }

    private *hash<auto> getPrimaryKeyDescriptionOptionsImpl(AbstractPrimaryKey primary_key) {
        OraclePrimaryKey pk = cast<OraclePrimaryKey>(primary_key);
        hash<auto> rv;
        if (pk.getIndex()) {
            rv.index = pk.getIndex();
        } else {
            string scope = pk.getEffectivePartitionScope();
            if (scope != "default") {
                rv.partition_scope = scope;
            }
            if (pk.getTablespace()) {
                rv.index_tablespace = pk.getTablespace();
            }
            if (pk.compute_statistics) {
                rv.compute_statistics = True;
            }
        }
        return rv ? rv : NOTHING;
    }

    private *hash<auto> getUniqueConstraintDescriptionOptionsImpl(AbstractUniqueConstraint constraint) {
        OracleUniqueConstraint uk = cast<OracleUniqueConstraint>(constraint);
        hash<auto> rv;
        if (uk.getIndex()) {
            rv.index = uk.getIndex();
        } else {
            string scope = uk.getEffectivePartitionScope();
            if (scope != "default") {
                rv.partition_scope = scope;
            }
            if (uk.getTablespace()) {
                rv.index_tablespace = uk.getTablespace();
            }
            if (uk.compute_statistics) {
                rv.compute_statistics = True;
            }
        }
        return rv ? rv : NOTHING;
    }

    #! maps the portable partition-aligned intent to an Oracle LOCAL index
    private preparePartitionAlignedOptionsImpl(string err, string object_kind, string object_name, bool unique,
            hash<auto> object_columns, reference<hash<auto>> opt) {
        *string requested_scope = opt.partition_scope;
        if (requested_scope.val() && requested_scope.lwr() != "default" && requested_scope.lwr() != "local") {
            throw err, sprintf("Oracle %s %y cannot combine partition_aligned = True with partition_scope %y",
                object_kind, object_name, requested_scope);
        }
        opt.partition_scope = "local";
    }

    private hash<auto> getIndexOptions() {
        return OracleIndexOptions;
    }

    private hash<auto> getConstraintOptions() {
        return OracleConstraintOptions;
    }

    private hash<auto> getTableCreationOptions() {
        return OracleTableCreationOptions;
    }

    private hash<auto> getAlignTableOptions() {
        return OracleAlignTableOptions;
    }

    #! returns the column operator map for this object
    private hash<auto> getColumnOperatorMapImpl() {
        return OracleCopMap;
    }

    #! returns the insert operator map for this object
    private hash<auto> getInsertOperatorMap() {
        return OracleIopMap;
    }

    #! returns the raw (default) update operator map for this object
    private hash<auto> getRawUpdateOperatorMap() {
        return OracleUopMap;
    }

    #! returns a hash of valid pseudocolumns
    private *hash<auto> getPseudoColumnHash() {
        return OraclePseudoColumnHash;
    }

    #! returns a string for use in SQL queries representing the DB-specific value of the argument; returns NOTHING if the type cannot be converted to an SQL string
    private *string getSqlValueImpl(auto v) {
        switch (v.typeCode()) {
            case NT_FLOAT:
            case NT_NUMBER:
            case NT_INT: return v.toString();

            # double any single quotes in strings
            case NT_STRING: v =~ s/'/''/g; return "'" + v + "'";

            case NT_NULL:
            case NT_NOTHING: return "null";

            case NT_BOOLEAN: return v ? "1" : "0";

            case NT_DATE: return sprintf("to_timestamp('%s', 'YYYYMMDDHH24MISSFF6')", v.format("YYYYMMDDHHmmSSus"));
        }
    }

    #! returns the column name for use in SQL strings; subclasses can return a special string in case the column name is a reserved word
    string getColumnSqlName(string col) {
        return oracle_get_sql_identifier(col);
    }

    #! returns a list of column names for use in SQL strings; subclasses can process the argument list in case a column name is a reserved word
    list getColumnSqlNames(softlist cols) {
        return map oracle_get_sql_identifier($1), cols;
    }

    private bool supportsPartitionsImpl() {
        # Oracle table partitioning is enabled from 12c onwards (per the SqlUtil partition design)
        return getOracleServerMajorVersion() >= 12;
    }

    private bool supportsDeferrableForeignConstraintsImpl() {
        return True;
    }

    private bool supportsPartitionMethodImpl(string method, bool subpartition) {
        return !subpartition && inlist(method, ("range", "list"));
    }

    private bool supportsPartitionReadImpl() {
        return True;
    }

    private bool supportsTargetedPartitionLookupImpl() {
        return True;
    }

    private bool supportsPartitionExchangeImpl() {
        return getOracleServerMajorVersion() >= 12;
    }

    private bool supportsAutoPartitioningImpl() {
        # Oracle interval (auto-create) range partitioning, enabled from 12c onwards
        return getOracleServerMajorVersion() >= 12;
    }

    #! returns the Oracle server major version (e.g. 12, 19, 23)
    /** @since OracleSqlUtilBase 1.6
    */
    private int getOracleServerMajorVersion() {
        return (ds.getServerVersion() =~ x/([0-9]+)/)[0].toInt();
    }

    private bool createPartitionsInCreateTableImpl() {
        return True;
    }

    private *hash<PartitionStrategy> getPartitionStrategyImpl() {
        *hash<auto> row = ds.selectRow("select partitioning_type, interval from "
            + systemView("dba_part_tables") + (dblink ? "@" + dblink : "")
            + " where owner = %v and table_name = %v", schema.upr(), name.upr());
        if (!row) {
            return;
        }
        if (!inlist(row.partitioning_type, ("RANGE", "LIST"))) {
            return;
        }

        *hash<auto> qh = ds.select("select column_name from " + systemView("dba_part_key_columns")
            + (dblink ? "@" + dblink : "")
            + " where owner = %v and name = %v and object_type = %v order by column_position",
            schema.upr(), name.upr(), "TABLE");
        if (!qh.column_name) {
            return;
        }

        list<string> cols = ();
        foreach string col in (qh.column_name) {
            cols += native_case ? col : col.lwr();
        }

        hash<PartitionStrategy> rv({
            "method": row.partitioning_type.lwr(),
            "columns": cols,
        });
        if (row.partitioning_type == "RANGE" && row.interval) {
            rv.auto = {
                "type": "interval",
                "expression": row.interval,
            };
        }
        return rv;
    }

    private *hash<auto> normalizePartitionAutoPolicyForAlignmentImpl(*hash<auto> policy) {
        if (!policy) {
            return;
        }

        *string expression = policy.expression ?? policy.interval;
        if (!expression) {
            return {} + policy;
        }
        trim expression;
        expression = regex_subst(expression, "\\s+", " ", RE_Global).upr();
        expression = regex_subst(expression, "\\s*,\\s*", ",", RE_Global);
        expression = regex_subst(expression, "\\(\\s+", "(", RE_Global);
        expression = regex_subst(expression, "\\s+\\)", ")", RE_Global);
        return {
            "type": "interval",
            "expression": expression,
        };
    }

    #! Oracle interval configuration is represented by the normalized automatic-partition policy
    private *hash<auto> normalizePartitionStrategyDriverForAlignmentImpl(hash<PartitionStrategy> strategy) {
        return;
    }

    private hash<string, PartitionInfo> getPartitionsImpl() {
        hash<string, PartitionInfo> rv();

        *PartitionStrategy strategy = getPartitionStrategyUnlocked();
        if (!strategy) {
            return rv;
        }
        getColumnsUnlocked();

        string dblink_suffix = dblink ? "@" + dblink : "";
        *hash<auto> qh = ds.select("select p.partition_name, p.partition_position, p.high_value, "
            "p.num_rows estimated_row_count from " + systemView("dba_tab_partitions") + dblink_suffix
            + " p where p.table_owner = %v and p.table_name = %v order by p.partition_position",
            schema.upr(), name.upr());

        *string prev_bound_sql;
        *auto prev_bound;
        foreach hash<auto> row in (qh.contextIterator()) {
            string pname = native_case ? row.partition_name : row.partition_name.lwr();
            string high_value = row.high_value;
            trim high_value;

            hash<PartitionInfo> info({
                "name": pname,
                "method": strategy.method,
                "columns": strategy.columns,
                "ordinal": row.partition_position - 1,
                "schema": schema,
                "relation_name": pname,
                "sql_name": sprintf("%s partition (%s)", getSqlName(), getColumnSqlName(pname)),
                "is_default": strategy.method == "range" ? high_value =~ /^MAXVALUE$/i
                    : high_value =~ /^DEFAULT$/i,
            });
            if (exists row.estimated_row_count) {
                info.estimated_row_count = row.estimated_row_count;
            }

            if (!info.is_default) {
                if (strategy.method == "list") {
                    populateOracleListPartitionValues(\info, high_value);
                } else {
                    info.bound_sql = sprintf("values less than (%s)", high_value);
                    info.bound_to_sql = high_value;
                    if (exists prev_bound_sql) {
                        info.bound_from_sql = prev_bound_sql;
                    }

                    *auto bound_to = parseOraclePartitionBoundValues(high_value, info.columns);
                    if (exists bound_to) {
                        info.bound_to = bound_to;
                    }
                    if (exists prev_bound) {
                        info.bound_from = prev_bound;
                    }

                    prev_bound_sql = high_value;
                    if (exists bound_to) {
                        prev_bound = bound_to;
                    } else {
                        delete prev_bound;
                    }
                }
            }

            rv{info.name} = info;
        }

        return rv;
    }

    private *hash<PartitionInfo> getPartitionByNameImpl(string partition_name) {
        string pname = native_case ? partition_name : partition_name.lwr();
        string dblink_suffix = dblink ? "@" + dblink : "";
        *hash<auto> row = ds.selectRow("select p.partition_name, p.partition_position, p.high_value, "
            "p.num_rows estimated_row_count from " + systemView("dba_tab_partitions") + dblink_suffix
            + " p where p.table_owner = %v and p.table_name = %v and p.partition_name = %v",
            schema.upr(), name.upr(), native_case ? pname : pname.upr());
        if (!row) {
            return;
        }

        *PartitionStrategy strategy = getPartitionStrategyUnlocked();
        if (!strategy) {
            return;
        }
        getColumnsUnlocked();

        pname = native_case ? row.partition_name : row.partition_name.lwr();
        string high_value = row.high_value;
        trim high_value;
        hash<PartitionInfo> info({
            "name": pname,
            "method": strategy.method,
            "columns": strategy.columns,
            "ordinal": row.partition_position - 1,
            "schema": schema,
            "relation_name": pname,
            "sql_name": sprintf("%s partition (%s)", getSqlName(), getColumnSqlName(pname)),
            "is_default": strategy.method == "range" ? high_value =~ /^MAXVALUE$/i
                : high_value =~ /^DEFAULT$/i,
        });
        if (exists row.estimated_row_count) {
            info.estimated_row_count = row.estimated_row_count;
        }

        if (!info.is_default) {
            if (strategy.method == "list") {
                populateOracleListPartitionValues(\info, high_value);
            } else {
                info.bound_sql = sprintf("values less than (%s)", high_value);
                info.bound_to_sql = high_value;
                *auto bound_to = parseOraclePartitionBoundValues(high_value, info.columns);
                if (exists bound_to) {
                    info.bound_to = bound_to;
                }

                if (row.partition_position > 1) {
                    *hash<auto> prev = ds.selectRow("select high_value from "
                        + systemView("dba_tab_partitions") + (dblink ? "@" + dblink : "")
                        + " where table_owner = %v and table_name = %v and partition_position = %v",
                        schema.upr(), name.upr(), row.partition_position - 1);
                    if (prev) {
                        string prev_high_value = prev.high_value;
                        trim prev_high_value;
                        info.bound_from_sql = prev_high_value;
                        *auto bound_from = parseOraclePartitionBoundValues(prev_high_value, info.columns);
                        if (exists bound_from) {
                            info.bound_from = bound_from;
                        }
                    }
                }
            }
        }
        return info;
    }

    private hash<PartitionInfo> resolveOraclePartitionInfoUnlocked(string partition_name) {
        *hash<PartitionInfo> info = getPartitionByNameUnlocked(partition_name);
        if (!info) {
            throw "PARTITION-ERROR", sprintf("%s: partition %y does not exist", getDesc(), partition_name);
        }
        return info;
    }

    private string getPartitionReadSqlNameImpl(string partition_name) {
        hash<PartitionInfo> info = resolveOraclePartitionInfoUnlocked(partition_name);
        return sprintf("%s partition (%s)", getSqlName(), getColumnSqlName(info.name));
    }

    private string getAddPartitionSqlImpl(hash<PartitionSpec> spec, *hash<auto> opt) {
        assertNoOracleDefaultPartitionForAddUnlocked(spec);
        return sprintf("alter table %s add %s", getSqlName(), getOraclePartitionDefinitionSql(spec));
    }

    private validatePartitionCreationImpl(hash<PartitionSpec> spec, string err) {
        if (spec.method != "range" || spec.is_default) {
            return;
        }

        hash<string, PartitionInfo> ph = getPartitionsUnlocked();
        if (!ph) {
            # Oracle's first RANGE partition starts at MINVALUE.  A finite typed lower bound would describe a
            # logical range that Oracle does not physically create.
            if (exists spec.bound_from) {
                throw err, sprintf("%s: first Oracle range partition %y cannot declare finite lower bound %y; "
                    "use a native %y expression so its physical lower bound is MINVALUE", getDesc(), spec.name,
                    spec.bound_from, "bound_sql");
            }
            if (exists spec.bound_from_sql && !(spec.bound_from_sql =~ /^\s*minvalue(?:\s*,\s*minvalue)*\s*$/i)) {
                throw err, sprintf("%s: first Oracle range partition %y must start at MINVALUE, got %y", getDesc(),
                    spec.name, spec.bound_from_sql);
            }
            return;
        }

        if (exists spec.bound_from) {
            *auto preceding;
            foreach hash<PartitionInfo> pi in (ph.iterator()) {
                if (pi.is_default) {
                    continue;
                }
                *auto upper = getOraclePartitionTypedUpperBoundUnlocked(pi);
                if (exists upper && (!exists preceding || preceding < upper)) {
                    preceding = upper;
                }
            }
            if (!exists preceding) {
                throw err, sprintf("%s: cannot compare lower bound for Oracle partition %y with existing partition "
                    "metadata", getDesc(), spec.name);
            }
            if (spec.bound_from != preceding) {
                throw err, sprintf("%s: Oracle partition %y must start at the preceding upper bound %y; got %y",
                    getDesc(), spec.name, preceding, spec.bound_from);
            }
            return;
        }

        if (exists spec.bound_from_sql) {
            *string preceding_sql = getLastOraclePartitionUpperSqlUnlocked(ph);
            string requested_sql = spec.bound_from_sql;
            if (!preceding_sql) {
                throw err, sprintf("%s: cannot resolve the preceding Oracle partition upper SQL bound for %y",
                    getDesc(), spec.name);
            }
            trim preceding_sql;
            trim requested_sql;
            if (requested_sql != preceding_sql) {
                throw err, sprintf("%s: Oracle partition %y must start at preceding upper SQL bound %y; got %y",
                    getDesc(), spec.name, preceding_sql, requested_sql);
            }
            return;
        }

        throw err, sprintf("%s: cannot add Oracle partition %y with %y after existing partitions because the "
            "logical lower bound cannot be verified", getDesc(), spec.name, "bound_sql");
    }

    private *auto getOraclePartitionTypedUpperBoundUnlocked(hash<PartitionInfo> pi) {
        if (exists pi.bound_to) {
            return pi.bound_to;
        }
        *string sql = getOraclePartitionUpperSqlUnlocked(pi);
        return sql ? parseOraclePartitionBoundValues(sql, pi.columns) : NOTHING;
    }

    private *string getOraclePartitionUpperSqlUnlocked(hash<PartitionInfo> pi) {
        if (exists pi.bound_to_sql) {
            return pi.bound_to_sql;
        }
        if (exists pi.bound_sql) {
            *string upper = (pi.bound_sql =~ x/^\s*values\s+less\s+than\s*\((.*)\)\s*$/i)[0];
            return upper;
        }
        return;
    }

    private *string getLastOraclePartitionUpperSqlUnlocked(hash<string, PartitionInfo> ph) {
        *hash<PartitionInfo> last;
        foreach hash<PartitionInfo> pi in (ph.iterator()) {
            if (!pi.is_default && (!last || pi.ordinal > last.ordinal)) {
                last = pi;
            }
        }
        return last ? getOraclePartitionUpperSqlUnlocked(last) : NOTHING;
    }

    private string getDropPartitionSqlImpl(string partition_name, *hash<auto> opt) {
        hash<PartitionInfo> info = resolveOraclePartitionInfoUnlocked(partition_name);
        return sprintf("alter table %s drop partition %s", getSqlName(), getColumnSqlName(info.name));
    }

    private string getTruncatePartitionSqlImpl(string partition_name, *hash<auto> opt) {
        hash<PartitionInfo> info = resolveOraclePartitionInfoUnlocked(partition_name);
        return sprintf("alter table %s truncate partition %s", getSqlName(), getColumnSqlName(info.name));
    }

    private string getExchangePartitionSqlImpl(string partition_name, AbstractTable exchange_table,
            *hash<auto> opt) {
        hash<PartitionInfo> info = resolveOraclePartitionInfoUnlocked(partition_name);
        string sql = sprintf("alter table %s exchange partition %s with table %s", getSqlName(),
            getColumnSqlName(info.name), exchange_table.getSqlName());
        sql += opt.including_indexes ? " including indexes" : " excluding indexes";
        sql += exists opt.validate && !opt.validate ? " without validation" : " with validation";
        if (opt.update_indexes) {
            sql += " update indexes";
        }
        return sql;
    }

    private hash<auto> getExchangePartitionOptionsImpl() {
        return {
            "including_indexes": Type::Boolean,
            "update_indexes": Type::Boolean,
        };
    }

    private bool partitionAutoStrategyCoversSpecImpl(hash<PartitionSpec> spec) {
        *PartitionStrategy strategy = getPartitionStrategyUnlocked();
        if (!strategy || !strategy.auto || spec.is_default || !partitionSpecsHaveComparableBounds(spec)) {
            return False;
        }

        *auto upper;
        foreach hash<PartitionInfo> pi in (getPartitionsUnlocked().iterator()) {
            if (pi.is_default || !exists pi.bound_to) {
                continue;
            }
            if (!exists upper || upper < pi.bound_to) {
                upper = pi.bound_to;
            }
        }
        return !exists upper || upper < spec.bound_to;
    }

    private assertNoOracleDefaultPartitionForAddUnlocked(hash<PartitionSpec> spec) {
        if (spec.is_default) {
            return;
        }
        foreach hash<PartitionInfo> pi in (getPartitionsUnlocked().iterator()) {
            if (pi.is_default) {
                throw "PARTITION-ERROR", sprintf("%s: cannot add partition %y after catch-all partition %y; "
                    "split the catch-all partition explicitly", getDesc(), spec.name, pi.name);
            }
        }
    }

    private string getOraclePartitionDefinitionSql(hash<PartitionSpec> spec) {
        if (!spec.name) {
            throw "PARTITION-ERROR", sprintf("%s: Oracle partition name is required", getDesc());
        }
        return sprintf("partition %s %s", getColumnSqlName(spec.name), getOraclePartitionBoundSql(spec));
    }

    private string getOraclePartitionBoundSql(hash<PartitionSpec> spec) {
        if (spec.method == "list") {
            if (spec.is_default) {
                return "values (default)";
            }
            if (spec.values_sql) {
                string sql = spec.values_sql;
                trim sql;
                return sql =~ /^values\b/i ? sql : sprintf("values (%s)", sql);
            }
            return sprintf("values (%s)", (foldl $1 + ", " + $2,
                map getOraclePartitionBoundValuesSql($1), spec.values));
        }
        if (spec.is_default) {
            return "values less than (maxvalue)";
        }
        if (spec.bound_sql) {
            string sql = spec.bound_sql;
            trim sql;
            if (sql =~ /^values\s+less\s+than\b/i) {
                return sql;
            }
            return "values less than (" + sql + ")";
        }
        if (spec.bound_to_sql) {
            return sprintf("values less than (%s)", spec.bound_to_sql);
        }
        return sprintf("values less than (%s)", getOraclePartitionBoundValuesSql(spec.bound_to));
    }

    private string getOraclePartitionBoundValuesSql(auto value) {
        if (value.typeCode() != NT_LIST) {
            return getSqlValue(value);
        }
        return foldl $1 + ", " + $2, (map getSqlValue($1), value);
    }

    private populateOracleListPartitionValues(reference<hash<PartitionInfo>> info, string sql) {
        info.values_sql = sql;
        list<auto> values = ();
        foreach string part in (splitPartitionSqlValues(sql)) {
            if (info.columns.size() > 1) {
                trim part;
                (*string tuple) = (part =~ x/^\((.*)\)$/);
                if (!exists tuple) {
                    return;
                }
                part = tuple;
            }
            *auto value = parseOraclePartitionBoundValues(part, info.columns);
            if (!exists value) {
                return;
            }
            values += value;
        }
        info.values = values;
    }

    private *auto parseOraclePartitionBoundValues(string sql, softlist<string> pcols) {
        if (pcols.size() == 1) {
            return parseOraclePartitionBoundValue(sql, columns{pcols[0]});
        }

        list<string> parts = splitPartitionSqlValues(sql);
        if (parts.size() != pcols.size()) {
            return;
        }

        list<auto> values = ();
        foreach string part in (parts) {
            *auto value = parseOraclePartitionBoundValue(part, columns{pcols[$#]});
            if (!exists value) {
                return;
            }
            values += value;
        }
        return values;
    }

    private *auto parseOraclePartitionBoundValue(string sql, *AbstractColumn col) {
        trim sql;
        if (sql =~ /^MAXVALUE$/i) {
            return;
        }

        *string value = (sql =~ x/^TIMESTAMP'\s*(.*)'$/i)[0];
        if (!exists value) {
            value = (sql =~ x/^TO_DATE\('\s*([^']+)'.*$/i)[0];
        }
        if (!exists value) {
            value = (sql =~ x/^TO_TIMESTAMP\('\s*([^']+)'.*$/i)[0];
        }
        if (!exists value) {
            value = (sql =~ x/^'(.*)'$/)[0];
        }

        if (exists value) {
            value =~ s/''/'/g;
            return parseOraclePartitionTypedLiteral(value, col) ?? value;
        }
        if (*auto typed = parseOraclePartitionTypedLiteral(sql, col)) {
            return typed;
        }
        if (sql =~ /^-?\d+$/) {
            return sql.toInt();
        }
        if (sql =~ /^-?\d+\.\d+$/) {
            return number(sql);
        }
    }

    private *auto parseOraclePartitionTypedLiteral(string value, *AbstractColumn col) {
        if (!col || !col.qore_type) {
            return;
        }
        try {
            switch (col.qore_type) {
                case Type::Int: {
                    if (value =~ /^-?\d+$/) {
                        return value.toInt();
                    }
                    break;
                }
                case Type::Float: {
                    if (value =~ /^-?\d+(\.\d+)?$/) {
                        return value.toFloat();
                    }
                    break;
                }
                case Type::Number: {
                    if (value =~ /^-?\d+(\.\d+)?$/) {
                        return number(value);
                    }
                    break;
                }
                case Type::Date: {
                    return date(value);
                }
            }
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    #! returns the base type of the underlying object (either \"table\" or \c "view")
    /**
        @since OracleSqlUtilBase 1.2
    */
    string getBaseType() {
        return m_isView ? "view" : "table";
    }

    #! Oracle always supports bulk merging
    code getBulkUpsertClosure(hash<auto> example_row, int upsert_strategy = AbstractTable::UpsertAuto,
            *hash<auto> opt) {
        return getUpsertClosure(example_row, upsert_strategy, opt);
    }

    #! Returns a closure for performing upserts
    /** If the \a upsert_strategy argument is \c UpsertInsertFirst or \c UpsertUpdateFirst, then this argument is
        ignored and a closure using an Oracle merge statement is returned
    */
    code getUpsertClosure(hash<auto> row, int upsert_strategy = UpsertAuto, *hash<auto> opt) {
        # check upsert options
        validateOptionsIntern("OPTION-ERROR", getUpsertOptions(), \opt);

        hash<auto> upsert_row;
        if (opt.upsert_columns) {
            hash<auto> uch = map {$1: True}, opt.upsert_columns;
            if (*hash<auto> invalid_cols = (uch - keys row)) {
                throw "UPSERT-ERROR", sprintf("%s: 'upsert_columns' contains the following columns not referenced in "
                    "the row data: %y", getDesc(), keys invalid_cols);
            }
            upsert_row = map {$1: NOTHING}, opt.upsert_columns;
        } else {
            upsert_row = row;
        }

        Columns cols = checkUpsertRow(upsert_row, \upsert_strategy);

        switch (upsert_strategy) {
            case UpsertInsertOnly:
                # if the strategy is "insert only", then respect this strategy (no updates)
                return getUpsertInsertOnly(cols, row, opt);

            case UpsertSelectFirst:
                # if the strategy is "select first", then respect this strategy; this is a slow upsert method anyway
                return getUpsertSelectFirst(cols, row, opt);

            case UpsertUpdateOnly:
                # if the strategy is "update only", then respect this strategy
                return getUpsertUpdateOnly(cols, row, opt);
        }

        # get update columns
        list<string> updc = ();
        # hash of columns to skip on update if applicable
        *hash<string, bool> suh = map {$1: True}, opt.omit_update;
        map updc += $1, keys row, !cols.hasKey($1) && !suh.$1;
        # cannot use merge where only the join columns are present
        if (!updc)
            return getUpsertInsertOnly(cols, row, opt);

        string sql = sprintf("merge into %s t using (select ", getSqlName());
        sql += foldl $1 + "," + $2, (map sprintf("%v as %s", getColumnSqlName($1)), keys row);
        sql += " from dual) source on (";
        sql += foldl $1 + " and " + $2, (map sprintf("t.%s = source.%s", $1, $1), getColumnSqlNames(cols.keys()));
        sql += sprintf(") when not matched then insert (");
        sql += foldl $1 + "," + $2, getColumnSqlNames(keys row);
        sql += ") values (";
        sql += foldl $1 + "," + $2, (map sprintf("source.%s", $1), getColumnSqlNames(keys row));
        sql += sprintf(") when matched then update set ");
        sql += (foldl $1 + "," + $2, (map sprintf("%s = source.%s", $1, $1), getColumnSqlNames(updc)));

        #printf("sql: %s\n", sql);

        return int sub (hash<auto> crow) {
            list<auto> args = crow.values();
            #on_error rethrow $1.err, sprintf("%s (SQL: %s args: %y)", $1.desc, sql, args);
            ds.vexec(sql, args);
            return UR_Verified;
        };
    }

    #! high-performance "insert only" upsert supporting bulk DML
    private code getUpsertInsertOnly(Columns cols, hash<auto> row, *hash<auto> opt) {
        string sql = sprintf("merge into %s t using (select ", getSqlName());
        sql += foldl $1 + "," + $2, (map sprintf("%v as %s", $1), getColumnSqlNames(row.keys()));
        sql += " from dual) source on (";
        sql += foldl $1 + " and " + $2, (map sprintf("t.%s = source.%s", $1, $1), getColumnSqlNames(cols.keys()));
        sql += sprintf(") when not matched then insert (");
        sql += foldl $1 + "," + $2, getColumnSqlNames(row.keys());
        sql += ") values (";
        sql += foldl $1 + "," + $2, (map sprintf("source.%s", $1), getColumnSqlNames(row.keys()));
        sql += ")";

        #printf("sql: %s\n", sql);

        return int sub (hash<auto> crow) {
            list<auto> args = crow.values();
            #on_error printf("SQL: %s args: %y\n", sql, args);
            int rc = ds.vexec(sql, args);
            return crow.firstValue().lsize() > 1 ? UR_Verified : (rc ? UR_Inserted : UR_Unchanged);
        };
    }

    #! high-performance "update only" upsert supporting bulk DML
    private code getUpsertUpdateOnly(Columns cols, hash<auto> row, *hash opt) {
        # get update columns
        list updc = ();
        # hash of columns to skip on update if applicable
        *hash suh = map {$1: True}, opt.omit_update;
        map updc += $1, row.keyIterator(), !cols.hasKey($1) && !suh.$1;
        # cannot use merge where only the join columns are present
        if (!updc)
            throw "UPSERT-ERROR", sprintf("cannot use the UpsertUpdateOnly upsert option on table %y when the only "
                "columns present are the columns for the unique key used for the update: %y", getSqlName(), keys row);

        string sql = sprintf("merge into %s t using dual on (", getSqlName());
        sql += foldl $1 + " and " + $2, (map sprintf("%s=%v", $1), getColumnSqlNames(cols.keys()));
        sql += sprintf(") when matched then update set ");

        # get update columns
        sql += (foldl $1 + "," + $2, (map sprintf("%s=%v", $1), getColumnSqlNames(updc)));

        #printf("sql: %s\n", sql);

        return int sub (hash crow) {
            list<auto> args = crow.(cols.keys()).values() + crow{updc}.values();
            #on_error printf("SQL: %s args: %y\n", sql, args);
            int rc = ds.vexec(sql, args);
            return crow.firstValue().lsize() > 1 ? UR_Verified : (rc ? UR_Verified : UR_Unchanged);
        };
    }

    #! returns @ref True "True" because the oracle driver supports array binds / bulk DML operations
    bool hasArrayBind() {
        return True;
    }

    #! returns @ref True because Oracle treats empty strings like @ref NULL on insert
    /** @since OracleSqlUtilBase 1.2
    */
    bool bindEmptyStringsAsNull() {
        return True;
    }

    #! returns @ref True if the database requires a wildcard \c "*" to be prefixed with the table name when it appears with other column arguments in a select statement
    private bool asteriskRequiresPrefix() {
        return True;
    }

    private *hash doReturningImpl(hash<auto> opt, reference<string> sql, list<auto> args) {
        list l = ();
        foreach auto v in (opt.returning) {
            hash rh;
            switch (v.typeCode()) {
                case NT_STRING: rh.key = v; break;
                case NT_HASH: rh = v; break;
                default: throw "RETURNING-ERROR", sprintf("got type %y in \"returning\" option; expected \"string\" or \"hash\"", v.type());
            }
            if (!rh.key.val() || rh.key.typeCode() != NT_STRING)
                throw "RETURNING-ERROR", sprintf("got %y for \"returning\" option key value instead of name of output column", rh.key.type());

            *OracleColumn c = columns{rh.key};
            if (!c)
                throw "COLUMN-ERROR", sprintf("%s.%s is not a valid column for the \"returning\" clause (valid columns: %y)", name, rh.key, columns.keys());
            l += rh.key;
            args += rh.type ?* c.qore_type ?* Type::String;
        }
        # each column is returned into a placeholder of its name; a column whose name is not a placeholder name
        # (a letter, then letters, digits and underscores) is returned into a placeholder of another name, which is
        # renamed to the column's name in the result
        hash<string, string> placeholder_map;
        list<string> placeholders = ();
        foreach string col in (l) {
            if (col =~ /\A[A-Za-z][A-Za-z0-9_]*\z/) {
                placeholders += ":" + col;
            } else {
                string ph = sprintf("qore_returning_%d", $#);
                placeholder_map{ph} = col;
                placeholders += ":" + ph;
            }
        }
        sql += sprintf(" returning %s into %s", (foldl $1 + "," + $2, getColumnSqlNames(l)),
            (foldl $1 + "," + $2, placeholders));

        auto rv = execData(opt, sql, args);
        if (placeholder_map && rv.typeCode() == NT_HASH) {
            rv = map {placeholder_map{$1.key} ?? $1.key: $1.value}, rv.pairIterator();
        }
        return rv;
    }

    private bool emptyImpl() {
        return True;
    }

    private setupTableImpl(hash<auto> desc, *hash<auto> opt) {
    }

    #! returns @ref True "True" if the database links constraints to indexes (ie dropping the constraint drops the index, etc)
    private bool constraintsLinkedToIndexesImpl() {
        return False;
    }

    #! returns @ref True "True" if the database automatically creates a unique constraint when a unique index is created (ex: mysql)
    private bool uniqueIndexCreatesConstraintImpl() {
        return False;
    }

    #! returns @ref True "True" if the database support tablespaces
    private bool supportsTablespacesImpl() {
        return True;
    }

    #! db-specific copy actions
    private copyImpl(AbstractTable old) {
    }

    #! returns the type for number / numeric columns for the database so that data conversions can be handled properly
    private AbstractDataProviderType getNumericTypeImpl(string native_type, bool nullable, *hash<auto> options) {
        return new OracleNumberDataType(native_type, nullable, options);
    }

    #! get DB-specific savepoint helper
    /** @param savepoint the savepoint string, if not given a unique savepoint string will be generated

        @since SqlUtil 1.6
    */
    private AbstractSavepointHelper getSavepointHelperImpl(*string savepoint) {
        return new OracleSavepointHelper(ds, savepoint);
    }
}
