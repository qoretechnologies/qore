# minimum required Qore version
%requires qore >= 1.14

# requires the SqlUtil module
%requires(reexport) SqlUtil >= 1.9

# requires the Util module
%requires Util >= 1.0

# for bindOracleCollection
%try-module oracle
%define NO_ORACLE
%endtry

# don't use "$" signs for variables and class members, assume local variable scope
%modern

# require type definitions everywhere

# enable all warnings

module OracleSqlUtilBase {
    version = "1.7";
    desc = "user module for working with Oracle SQL data";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/*  Version History: see docs below
*/

/** @mainpage OracleSqlUtilBase Module

    @tableofcontents

    @section oraclesqlutilbaseintro OracleSqlUtilBase Module Introduction

    The %OracleSqlUtilBase module provides a high level API for working with Oracle database objects.

    Usually this module is loaded on demand from the SqlUtil module, however to use this module
    directly, use \c "%requires OracleSqlUtilBase" in your code.

    All the public symbols in the module are defined in the OracleSqlUtilBase namespace

    @note This module requires the <a href="https://github.com/qoretechnologies/module-oracle">oracle</a> binary module
    for communication with Oracle databases

    @section ora_sql_operations SQL Operations on Oracle

    @subsection ora_paging Select With Paging on Oracle

    Select with paging on Oracle is more complicated than on some databases due to the lack of direct \c limit and
    \c offset support (applies to Oracle pre 12c).

    For example, for the following select:
    @code{.py}
*list<auto> rows = $table.selectRows({"where": {"type": "user"}, "limit": 100, "offset": 200});
    @endcode
    the following SQL is generated for Oracle with a pre 12c server:
    @code{.py}
ds.vselectRows("select * from (select /*+ first_rows(100) *<!--%%-->/ a.*, rownum rnum from
    (select * from schema.table where type = %v order by type) a
        where rownum <= %v) where rnum > %v", ("user", 300, 200));
    @endcode
    note that the following simpler SQL is generated for Oracle 12c+ servers:
    @code{.py}
ds.vselectRows("select * from schema.table where type = %v order by type offset %v rows
    fetch next %v rows only", ("user", 200, 100));
    @endcode

    @subsection ora_in_operator IN Operator on Oracle

    In order to avoid dynamic SQL and better manage the server's shared pool (in particular, the number of parsed
    statements), the %OracleSqlUtilBase module uses bind by value with the SQL \c IN operator.

    For example, the following query:
    @code{.py}
*hash<auto> q = table.select({"where": {"col1": op_in(1, 2, 3, 4)}});
    @endcode

    Results in the equivalent of the following SQL:
    @code{.py}
*hash<auto> q = ds.select("select * from schema.table where col1 in (select column_value from table(%v))",
    bindOracleCollection("SYS.ODCIVARCHAR2LIST", (1,2,3,4)));
    @endcode

    |!Qore Type|!Oracle Collection
    |Date|\c SYS.ODCIDATELIST
    |Float|\c SYS.ODCINUMBERLIST
    |Integer|\c SYS.ODCINUMBERLIST
    |Number|\c SYS.ODCINUMBERLIST
    |String|\c SYS.ODCIVARCHAR2LIST

    There universal collections are limited to 32767 elements. And \c SYS.ODCIVARCHAR2LIST element size is
    \c VARCHAR2(4000).

    @subsection ora_partitioning_select Partition Support in Selects

    The generic @ref SqlUtil::AbstractTable::SelectOptions "select options" define the \c "partition" key;
    %OracleSqlUtilBase advertises support through
    @ref SqlUtil::AbstractTable::supportsPartitionRead() "supportsPartitionRead()" and validates the canonical
    partition name before generating Oracle's partition extension:
    @code{.py}
*list<auto> rows = $table.selectRows(("created": op_gt(2012-05-01), "partition": "p1"));
    @endcode
    Which generates an SQL command like the following:
    @code{.py}
*list<auto> rows = ds.vselectRows("select * from schema.table partition(p1) where created > %v", (2012-05-01));
    @endcode

    @subsection ora_partitioning_join Partition Support in Joins

    It's possible to perform a join on a particular partition of a table with %OracleSqlUtilBase; the join option
    \c "partition" is supported to specify the partition to join on as in the following example:
    @code{.py}
*list<auto> $rows = table.selectRows({"join": join_inner($table2, "t2", ("id": "altid"), NOTHING,
    {"partition": "p2"})});
    @endcode
    Which generates an SQL command like the following:
    @code{.py}
*list<auto> $rows = ds.vselectRows("select * from schema.table inner join schema.table2 partition(p2) t2 on
    (schema.table.id = t2.altid)");
    @endcode

    @section ora_schema_management Schema Management on Oracle

    Note that when getting an object description from an Oracle database, if the object cannot be found in the
    connection schema, then if a synonym of the same type exists and the target object is accessible, then the target
    object is read  automatically and the owning schema name is also set to the actual owner of the object.

    @subsection ora_identifiers Identifiers on Oracle

    Names of tables, columns, indexes, constraints, sequences, views, triggers, partitions, schemas, tablespaces,
    savepoints and column aliases are given in SQL as follows (see @ref SqlUtil::AbstractSqlUtilBase::getSqlIdentifier()
    "AbstractSqlUtilBase::getSqlIdentifier()"):
    - a name that Oracle reads as one unquoted identifier (a letter, then letters, digits, \c "_", \c "$" or
      \c "#") that is not a reserved word is given as it is, so that Oracle stores it in upper case, as before
    - a reserved word is given in double quotes with its case as given, as before
    - any other name, such as one with spaces, punctuation or a leading digit or underscore, is given in double
      quotes <b>in upper case</b>, as Oracle stores an unquoted name, so that it names the object that %SqlUtil looks
      up in upper case and describes in lower case; for example, a column \c "Order Date" is created as
      <tt>"ORDER DATE"</tt> and described as \c "order date"; a column alias, which names no object, keeps its case
      in double quotes
    - a name with a double quote or a NUL character, which Oracle does not allow in an identifier, even a quoted one,
      and an empty name, are refused with \c IDENTIFIER-ERROR
    - a database link name (<tt>table@dblink</tt>) is given without quotes and must be of letters, digits, \c "_",
      \c "$", \c "#", \c "." and \c "@"; any other is refused with \c IDENTIFIER-ERROR

    Function, procedure, package, type and materialized view names, like their source, and SQL expressions given
    in descriptions (default values, check constraint sources, index expressions, partition bounds) are SQL and are
    used as given.

    @subsection ora_fk_actions Foreign Constraint Referential Actions on Oracle

    Oracle supports only these @ref SqlUtil::fk_actions "referential actions" of a foreign constraint (the
    \c on_delete and \c on_update foreign constraint options):
    - \c on_delete: @ref SqlUtil::FK_CASCADE "FK_CASCADE" (<tt>ON DELETE CASCADE</tt>),
      @ref SqlUtil::FK_SET_NULL "FK_SET_NULL" (<tt>ON DELETE SET NULL</tt>), or no value or
      @ref SqlUtil::FK_NO_ACTION "FK_NO_ACTION" for the default
    - \c on_update: Oracle has no <tt>ON UPDATE</tt> clause, so only no value or
      @ref SqlUtil::FK_NO_ACTION "FK_NO_ACTION" is accepted

    Any other action (@ref SqlUtil::FK_RESTRICT "FK_RESTRICT" or @ref SqlUtil::FK_SET_DEFAULT "FK_SET_DEFAULT" for
    \c on_delete, or any action for \c on_update) is refused with \c FOREIGN-CONSTRAINT-ERROR.  The
    <tt>ON DELETE</tt> action of a foreign constraint is read from the database, so a schema alignment drops and
    adds a foreign constraint again only when its template gives another action.

    @subsection ora_sequences Sequences on Oracle

    The \c start, \c increment, \c max (or \c end), \c min, \c cycle and \c cache keys of a
    @ref SqlUtil::AbstractDatabase::SequenceDescriptionOptions "sequence description" are supported.  When a
    schema is aligned, an existing sequence is changed with <tt>ALTER SEQUENCE</tt> for the increment, maximum,
    minimum, cycle option and cache that differ, so that it keeps its current value; a parameter that the
    description does not give is not changed.  The starting value of an existing sequence is not changed: Oracle
    can change it only by resetting the current value (<tt>RESTART</tt>), or by dropping and creating the sequence,
    which SqlUtil does not do.  A cache of 0 is \c NOCACHE; Oracle caches 20 values when no cache is given, and
    does not accept a cache of 1.

    The default maximum of an ascending sequence and the default minimum of a descending one are beyond the
    integer range, so a sequence is described without them (no \c max or \c min value) when they are beyond
    &plusmn;9000000000000000000; to align a sequence back to its default maximum or minimum, give a value beyond
    that, such as 9223372036854775807, or the default of the other end (a minimum of 1 for an ascending sequence,
    a maximum of -1 for a descending one).

    @subsection ora_type_mapping Type Mapping

    Column types are mapped from %Qore types as follows:

    <b>Oracle Column Type Mappings</b>
    |!Generic Type Name|!Oracle Type Used
    |\c float|\c number
    |\c integer|\c number
    |\c number|\c number
    |\c string|\c varchar2
    |\c date|\c timestamp(6)
    |\c binary|\c blob
    |@ref SqlUtil::BLOB|\c blob
    |@ref SqlUtil::CHAR|\c char
    |@ref SqlUtil::CLOB|\c clob
    |@ref SqlUtil::NUMERIC|\c number
    |@ref SqlUtil::VARCHAR|\c varchar2

    To use other types, use the \c "native_type"
    @ref SqlUtil::AbstractTable::ColumnDescOptions "column description option" with the native Oracle type name
    instead (under the \c "driver" and \c "oracle" keys for schemas supporting multiple databases).

    @subsection ora_other_objects Additional Object Types Supported

    The following additional schema objects can be managed with %OracleSqlUtilBase:
    - @ref ora_materialized_views "materialized views"
    - @ref ora_packages "packages"
    - @ref ora_types "types"

    @subsection ora_materialized_views Materialized Views

    The @ref schema_desc_hash takes an optional key, \c "materialized_views" that allows materialized views in Oracle
    schemas to be managed along with other objects.

    The \c "materialized_views" should be assigned to a hash, each key name is the name of the materialized view, and
    the values are hashes with the
    following keys:
    - \c "logging": (@ref bool_type "bool") if the materialized view should be logged
    - \c "use_index": (@ref bool_type "bool") if the materialized view should be indexed
    - \c "src": (@ref bool_type "bool") the source of the materialized view

    The \c "materialized_views" key can go in the top level of the @ref schema_desc_hash for Oracle-only schemas, or,
    for schemas targeting multiple database types, under the \c "driver" and \c "oracle" keys as in the following
    example:

    @code{.py}
hash schema = (
    "driver": (
        "oracle": (
            "materialized_views": (
                "example_mv": (
                    "logging": False,
                    "use_index": False,
                    "src": "select type, count(1) total_count from table group by type",
                ),
            ),
        ),
    ),
);
    @endcode

    @subsection ora_packages Packages

    The @ref schema_desc_hash takes an optional key, \c "packages" that allows packages in Oracle schemas to be
    managed along with other objects.

    The \c "packages" should be assigned to a hash, each key name is the name of the package, and the values are
    hashes with the following key:
    - \c "src": (@ref bool_type "bool") the source of the package

    The \c "packages" key can go in the top level of the @ref schema_desc_hash for Oracle-only schemas, or, for
    schemas targeting multiple database types, under the \c "driver" and \c "oracle" keys as in the following example:

    @code{.py}
hash schema = (
    "driver": (
        "oracle": (
            "packages": (
                "example_pkg": (
                    "src": "types as
type cursorType is ref cursor;
MYSTATCOMPLETE constant order_status.orderstatus%type := 'C';
MYSTATERROR constant order_status.orderstatus%type := 'E';
",
                ),
            ),
        ),
    ),
);
    @endcode

    @subsection ora_types Types

    The @ref schema_desc_hash takes an optional key, \c "types" that allows types in Oracle schemas to be managed
    along with other objects.

    The \c "types" should be assigned to a hash, each key name is the name of the type, and the values are strings
    giving the type definition.

    The \c "types" key can go in the top level of the @ref schema_desc_hash for Oracle-only schemas, or, for schemas
    targeting multiple database types, under the \c "driver" and \c "oracle" keys as in the following example:

    @code{.py}
hash schema = (
    "driver": (
        "oracle": (
            "types": (
                "num_array": "table of number",
                "str_array": "table of varchar2(240)",
            ),
        ),
    ),
);
    @endcode

    @see OracleSqlUtilBase::OracleDatabase::OracleSchemaDescriptionOptions for a list of Oracle-specific schema
    description hash keys.

    @section ora_relnotes Release Notes

    @subsection oracle17 OracleSqlUtilBase v1.7
    - names that are not ordinary identifiers, such as table or column names from files or data providers with
      spaces, quotes, semicolons or comment markers, are quoted in all generated SQL, so a name can no longer change
      the SQL statement that it is part of; such a name is quoted in upper case, as Oracle stores an unquoted name,
      and a name that Oracle cannot have in an identifier (with a double quote or a NUL character) or a database
      link name with characters other than letters, digits, \c "_", \c "$", \c "#", \c "." and \c "@" is refused
      with \c IDENTIFIER-ERROR; ordinary names and reserved words are given in SQL as before, except that a table
      or schema whose name is a reserved word (such as \c USER) is now quoted in the name of a table, as a column
      name is; see @ref ora_identifiers
    - fixed the names of sequences in the @ref SqlUtil::cop_seq() "cop_seq()", @ref SqlUtil::cop_seq_currval()
      "cop_seq_currval()", @ref SqlUtil::uop_seq() "uop_seq()" and @ref SqlUtil::uop_seq_currval()
      "uop_seq_currval()" operators and in @ref SqlUtil::AbstractDatabase::getNextSequenceValue()
      "AbstractDatabase::getNextSequenceValue()", and the names of tables in
      @ref SqlUtil::AbstractDatabase::reclaimSpace() "AbstractDatabase::reclaimSpace()", being inserted in SQL as
      given
    - added support for the \c on_delete foreign constraint option (<tt>ON DELETE CASCADE</tt> and
      <tt>ON DELETE SET NULL</tt>), which is also read from the database, so that a schema alignment changes a
      foreign constraint's action; Oracle has no <tt>ON UPDATE</tt> action and no <tt>ON DELETE RESTRICT</tt> or
      <tt>ON DELETE SET DEFAULT</tt>, so the \c on_update option and these actions are refused with
      \c FOREIGN-CONSTRAINT-ERROR; see @ref ora_fk_actions
    - an existing sequence is aligned with <tt>ALTER SEQUENCE</tt> for its increment, maximum, minimum, cycle
      option and cache, keeping its current value, and the \c min, \c cycle and \c cache sequence options are
      supported; the starting value of an existing sequence is not changed, and a cache of 1, which Oracle does not
      accept, is refused with \c SEQUENCE-ERROR; see @ref ora_sequences
    - fixed describing a descending sequence with the default maximum value, which failed with
      \c SEQUENCE-ERROR
    - fixed describing the foreign constraints of a table in another user's schema, which were not found, and of
      a foreign constraint that references a table in another schema, whose table was looked up in the
      connection's schema
    - fixed the \c returning insert option with a column whose name is not a placeholder name (letters, digits and
      \c "_" after a letter): the column was given as the name of its output placeholder; it is returned into a
      placeholder of another name and given with its name in the result
    - added the size of the current schema (see @ref SqlUtil::AbstractDatabase::getCurrentSchemaPhysicalSize()
      "AbstractDatabase::getCurrentSchemaPhysicalSize()"): the segments of the user's own schema, or, when the
      session's current schema is another one, that schema's segments if the user can read \c dba_segments
    - fixed the sort direction of a select with \c limit or \c offset on a server older than Oracle 12c: a
      \c "-column" \c orderby was sorted ascending, and the \c desc option sorted only the last \c orderby column
      descending
    - fixed modifying a column named like a clause of <tt>ALTER TABLE ... MODIFY</tt>, such as \c scope, in table
      alignment: the column is now given in parentheses, since Oracle otherwise fails with \c ORA-03050
    - added temporary-table support: pre-created global temporary tables (the \c "precreated" option; no runtime
      DDL, supported on all Oracle versions) and, on Oracle 18c and later, runtime private temporary tables
      (\c "ORA$PTT_" name prefix; \c NOT \c NULL column constraints are not supported and are dropped); see
      @ref SqlUtil::AbstractDatabase::createTempTable() "AbstractDatabase::createTempTable()"
    - fixed a \c cast data provider expression with a size, or with a precision and a scale: the size was ignored
      and the precision was given as the scale, so that the cast failed or changed the value
    - added portable list-partition creation, introspection, lookup, lifecycle, and schema round-trip support
    - added statistics-dependent estimated partition row counts to partition introspection
    - implemented range-partitioned table DDL, introspection, and lifecycle operations through the generic
      @ref SqlUtil::AbstractTable "AbstractTable" partition APIs
    - implemented the generic validated named-partition select qualifier for primary and joined table references
    - added targeted canonical-name partition metadata lookup with the preceding range bound

    @subsection oracle161 OracleSqlUtilBase v1.6.1
    - fixed a bug where a select combining \c forupdate with \c limit or \c offset and an \c orderby failed with
      \c ORA-02014; the rows of the page are now located and locked in the base table with their \c ROWIDs, as
      Oracle cannot lock rows selected through an inline view
    - fixed a bug where the \c first_rows optimizer hint used with \c limit was placed after the \c "from" clause,
      where Oracle ignores it as a plain comment

    @subsection oracle16 OracleSqlUtilBase v1.6
    - fixed a bug in the IN operator
      (<a href="https://github.com/qoretechnologies/qore/issues/4901">issue 4901</a>)
    - fixed space management on Oracle
      (<a href="https://github.com/qoretechnologies/qore/issues/4897">issue 4897</a>)
    - reintroduced as the base module for all Oracle SqlUtil modules

    @subsection oracle15 OracleSqlUtilBase v1.5
    - implemented support for generating queries based on generic expressions using the DataProvider module's generic
      expression support
      (<a href="https://github.com/qoretechnologies/qore/issues/4538">issue 4538</a>)

    @subsection oracle144 OracleSqlUtilBase v1.4.4
    - allow a \c VARCHAR column to be created without a size, assume a default size
      (<a href="https://github.com/qoretechnologies/qore/issues/4399">issue 4399</a>)

    @subsection oraclev143 OracleSqlUtilBase v1.4.3
    - added APIs to enable duplicate record creation errors to be detected
      (<a href="https://github.com/qoretechnologies/qore/issues/4308">issue 4308</a>)

    @subsection v142 OracleSqlUtilBase v1.4.2
    - fixed a bug where keywords were not properly quoted in merge / upsert statements
      (<a href="https://github.com/qoretechnologies/qore/issues/4297">issue 4297</a>)

    @subsection v141 OracleSqlUtilBase v1.4.1
    - fixed a bug where pseudocolumn references were used ambiguously in joins
      (<a href="https://github.com/qoretechnologies/qore/issues/4214">issue 4214</a>)
    - fixed a bug where pseudocolumn names were quoted in queries leading to errors
      (<a href="https://github.com/qoretechnologies/qore/issues/4210">issue 4210</a>)
    - fixed a bug generating queries with \c limit and \c forupdate
      (<a href="https://github.com/qoretechnologies/qore/issues/4206">issue 4206</a>)

    @subsection v14 OracleSqlUtilBase v1.4
    - added support for the DataProvider module
      (<a href="https://github.com/qoretechnologies/qore/issues/3545">issue 3545</a>)

    @subsection v131 OracleSqlUtilBase v1.3.1
    - fixed quoting of reserved words in column names in table alignment
      (<a href="https://github.com/qoretechnologies/qore/issues/3400">issue 3400</a>)

    @subsection v13 OracleSqlUtilBase v1.3
    - added support for serializing and deserializing @ref SqlUtil::AbstractTable "AbstractTable" objects
      (<a href="https://github.com/qoretechnologies/qore/issues/2663">issue 2663</a>)

    @subsection v125 OracleSqlUtilBase v1.2.5
    - worked around an Oracle bug in materialized view creation where when the schema user is missing the
      <tt>CREATE MATERIALIZED VIEW</tt> grant the table backing the view is created but the materialized view itself
      is not created causing future creation actions to fail
      (<a href="https://github.com/qoretechnologies/qore/issues/2643">issue 2643</a>)

    @subsection v124 OracleSqlUtilBase v1.2.4
    - implemented support for custom column operators
      (<a href="https://github.com/qoretechnologies/qore/issues/2314">issue 2314</a>)
    - implemented support for chained synonyms
      (<a href="https://github.com/qoretechnologies/qore/issues/2408">issue 2408</a>)
    - allow to use DBA_* views instead of ALL_* if possible
      (<a href="https://github.com/qoretechnologies/qore/issues/2418">issue 2418</a>)

    @subsection v123 OracleSqlUtilBase v1.2.3
    - fixed a bug in \c character_semantics for standalone column
      (<a href="https://github.com/qoretechnologies/qore/issues/1688">issue 1688</a>)
    - implemented @ref SqlUtil::cop_trunc_date() operator
      (<a href="https://github.com/qoretechnologies/qore/issues/2032">issue 2032</a>)

    @subsection v122 OracleSqlUtilBase v1.2.2
    - fixed a bug in the \a force option (i.e. cascade) for dropping types
      (<a href="https://github.com/qoretechnologies/qore/issues/1683">issue 1683</a>)

    @subsection v121 OracleSqlUtilBase v1.2.1
    - implemented the \a force option (i.e. cascade) for dropping code objects
      (<a href="https://github.com/qoretechnologies/qore/issues/1314">issue 1314</a>)
    - worked around ORA-22165 from op_in() caused by Oracle's limit on number of collection elements
      (<a href="https://github.com/qoretechnologies/qore/issues/1660">issue 1660</a>)

    @subsection v12 OracleSqlUtilBase v1.2
    - implemented support for the \c "returning" clause as an insert option
    - implemented support for views for DML in the @ref OracleSqlUtilBase::OracleTable class
    - implemented @ref OracleSqlUtilBase::OracleTable::getBaseType()
    - implemented support for Oracle pseudocolumns in queries
    - implemented support for @ref SqlUtil::cop_cast() operator
    - fixed bugs in @ref SqlUtil::cop_seq() and @ref SqlUtil::cop_seq_currval()
      (<a href="https://github.com/qoretechnologies/qore/issues/624">issue 624</a>)
    - return lists from Oracle's data dictionary ordered
    - implemented @ref OracleSqlUtilBase::OracleTable::bindEmptyStringsAsNull()
    - implemented high-performance "upsert" (merge) support also supporting bulk DML
    - implemented @ref SqlUtil::cop_substr() and @ref SqlUtil::uop_substr() operators
      (<a href="https://github.com/qoretechnologies/qore/issues/801">issue 801</a>)
    - implemented @ref SqlUtil::op_substr() where operator
      (<a href="https://github.com/qoretechnologies/qore/issues/883">issue 883</a>)

    @subsection v11 OracleSqlUtilBase v1.1
    - fixed selects with "limit" but no "offset"
    - convert date/time values to timestamps with microseconds resolution instead of dates with second resolution when
      dynamically inserting values as strings in SQL (binding by value not affected)
    - fixed schema information classes when the "string-numbers" driver option is enabled

    @subsection v10 OracleSqlUtilBase v1.0
    - initial release
*/

# returns a name as an SQL identifier for Oracle: as given if Oracle reads it as one unquoted identifier (a letter,
# then letters, digits, underscores, dollar signs or pound signs) that is not a reserved word; a reserved word is quoted
# with its case as given, as before; any other name is quoted in upper case, as Oracle stores an unquoted name, so
# that it names the object that SqlUtil looks up in upper case and describes in lower case, and so that the name can
# never change the SQL that it is part of; Oracle allows no double quote and no NUL character in an identifier, even
# a quoted one
string sub oracle_get_sql_identifier(string name) {
    if (name =~ /\A\p{L}[\p{L}\p{N}_$#]*\z/) {
        return OracleDatabase::OracleReservedWords{name.lwr()} ? ("\"" + name + "\"") : name;
    }
    if (name.find("\"") >= 0) {
        AbstractSqlUtilBase::checkIdentifier(name, "Oracle");
        throw "IDENTIFIER-ERROR", sprintf("Oracle: the name %y has a double quote, which Oracle does not allow in "
            "an identifier", name);
    }
    return AbstractSqlUtilBase::getDelimitedIdentifier(name.upr(), "\"", "\"", "Oracle");
}

# returns a name in the form "name" or "schema.name", where the schema is a name of word characters, for SQL, each part
# as oracle_get_sql_identifier() returns it
string sub oracle_get_sql_object_name(string name) {
    *list<*string> l = (name =~ x/^(\w+)\.(.+)$/s);
    if (l) {
        return oracle_get_sql_identifier(l[0]) + "." + oracle_get_sql_identifier(l[1]);
    }
    return oracle_get_sql_identifier(name);
}

# returns a database link name for SQL, where it is not quoted: letters, digits, underscores, dollar and pound signs,
# periods and at signs, as in a database link's global name
string sub oracle_check_dblink(string dblink) {
    if (dblink !~ /\A[A-Za-z0-9_$#.@]+\z/) {
        AbstractSqlUtilBase::checkIdentifier(dblink, "Oracle");
        throw "IDENTIFIER-ERROR", sprintf("Oracle: the database link name %y is not of letters, digits, \"_\", "
            "\"$\", \"#\", \".\" and \"@\"", dblink);
    }
    return dblink;
}

#! the OracleSqlUtilBase namespace contains all the objects in the OracleSqlUtilBase module
public namespace OracleSqlUtilBase {
#! returns an OracleTable object corresponding to the arguments
public OracleTable sub get_table(AbstractDatasource nds, string nname, *hash opts) {
    return new OracleTable(nds, nname, opts);
}

#! returns an OracleDatabase object corresponding to the arguments
public OracleDatabase sub get_database(AbstractDatasource nds, *hash opts) {
    return new OracleDatabase(nds, opts);
}

#! Oracle savepoint helper
public class OracleSavepointHelper inherits AbstractSavepointHelper {
    #! Creates the object
    /** @note Oracle identifiers cannot be longer than 30 character by default; the default savepoint value uses
        the unique hash for the object, which is 40 characters long, so we have to use another algorithm to create
        the savepoint string on Oracle
    */
    constructor(AbstractDatasource ds, *string savepoint = "x" + get_random_string(29))
            : AbstractSavepointHelper(ds, savepoint) {
    }

    #! Creates the savepoint
    private createSavepointImpl() {
        ds.exec("savepoint " + oracle_get_sql_identifier(savepoint));
    }

    #! Rolls back to the savepoint
    private rollbackImpl() {
        ds.exec("rollback to " + oracle_get_sql_identifier(savepoint));
    }

    #! Deletes the savepoint
    private deleteSavepointImpl() {
        # this method intentionally left blank
    }
}

#! the data type for Oracle NUMBER columns
public class OracleNumberDataType inherits SqlUtil::AbstractNumericDataType {
    #! creates the object
    constructor(string native_type, bool nullable, *hash<auto> options)
            : AbstractNumericDataType(native_type, nullable, options) {
    }
}

#! represents an Oracle column
public class OracleColumn inherits SqlUtil::AbstractColumn {
    public {
        #! the column uses character semantics
        bool char_used;
        #! byte size of the column
        int byte_size;
    }

    #! empty constructor for subclasses
    private constructor() {
    }

    constructor(string n, string nt, *string qt, *softint sz, bool nul, *string dv, *string cm,
            bool is_char = False, bool cu = False, *softint bs, *int scale)
            : AbstractColumn(n, nt, qt, sz, nul, dv, cm, scale) {
        if (!exists bs) { bs = 0; }
        # only set "char_used" if we are dealing with a char column
        char_used = is_char && cu;
        byte_size = bs;
    }

    #! returns the string describing the native type that can be used in SQL
    /** This method can be used, for example, to add the colunn to a table or when creating the table
    */
    string getNativeTypeString() {
        if (char_used) {
            return sprintf("%s(%d char)", native_type, size);
        }
        return AbstractColumn::getNativeTypeString();
    }

    #! returns a list of sql strings that can be used to add the column to an existing table
    /** @par Example:
        @code{.py}
list<string> l = col.getAddColumnSql(t);
        @endcode

        @param t the AbstractTable object to modify
    */
    list<string> getAddColumnSql(AbstractTable t) {
        list<string> l += sprintf("alter table %s add %s", t.getSqlName(), AbstractColumn::getCreateSql(t));
        if (comment)
            l += sprintf("comment on column %s.%s is %s", t.getSqlName(), ddl_name, t.getSqlValue(comment));
        return l;
    }

    #! returns a list of sql strings that can be used to modify the column to the new definition
    /**
        @par Example:
        @code{.py}
list<string> l = col.getModifySql(t, newcol);
        @endcode

        The column names are assumed to be equal

        @param t the AbstractTable object to modify
        @param col the new column definition
        @param opt ignored

        @return a list of sql strings that can be used to modify the column to the new definition; if the column
        definitions are identical then an empty list is returned
    */
    list<string> getModifySqlImpl(AbstractTable t, AbstractColumn col, *hash opt) {
        list<string> l = ();
        OracleColumn c = col;

        bool modified;
        # the column is given in parentheses: without them, a column named like an ALTER TABLE MODIFY keyword
        # (for example "scope", as in MODIFY SCOPE FOR (ref_column)) is parsed as that clause and fails with
        # ORA-03050
        string sql = sprintf("alter table %s modify (%s", t.getSqlName(), ddl_name);

        # get new native type declaration string
        string nts = c.getNativeTypeString();
        if (getNativeTypeString() != nts) {
            sql += sprintf(" %s", nts);
            modified = True;
        }

        if (def_val != c.def_val) {
            sql += sprintf(" default %s", exists c.def_val ? c.def_val : "null");
            modified = True;
        }

        if (nullable != c.nullable) {
            sql += sprintf(" %snull", c.nullable ? "" : "not ");
            modified = True;
        }
        if (modified) {
            l += sql + ")";
        }

        # to remove a comment we set it to the empty string ('')
        # http://docs.oracle.com/cd/B28359_01/server.111/b28286/statements_4009.htm
        if (c.comment != comment) {
            l += sprintf("comment on column %s.%s is %s", t.getSqlName(), ddl_name,
                c.comment ? t.getSqlValue(c.comment) : "''");
        }
        return l;
    }

    #! returns a string that can be used to rename the column
    /** @par Example:
        @code{.py}
string str = col.getRenameSql(t, "new_name");
        @endcode

        @param t the AbstractTable object to modify
        @param new_name the new name for the column

        @return a string that can be used to rename the column
    */
    string getRenameSql(AbstractTable t, string new_name) {
        return sprintf("alter table %s rename column %s to %s", t.getSqlName(), ddl_name, getDdlName(new_name));
    }

    #! returns @ref True "True" if the argument is equal to the current object, @ref False "False" if not
    bool equalImpl(AbstractColumn c) {
        return char_used == cast<OracleColumn>(c).char_used;
    }

    #! returns the column name as an SQL identifier for DDL
    /** the name returned here will be used when executing DDL

        @since OracleSqlUtilBase 1.7 a name that is not an ordinary name is quoted in upper case; before, only a
        reserved word was quoted
    */
    string getDdlName(string name) {
        return oracle_get_sql_identifier(name);
    }
}

#! represents an Oracle number column
public class OracleNumberColumn inherits OracleColumn {
    constructor(string n, string nt, *string qt, *softint sz, bool nul, *string dv, *string cm, *softint bs,
            *softint scale) : OracleColumn(n, nt, qt, sz, nul, dv, cm, False, False, bs, scale) {
    }
}

#! shared Oracle partition-scope state for indexes and index-backed constraints
class OraclePartitionScopeSupport inherits Qore::Serializable {
    public {
        #! physical partition scope: \c "default", \c "local", or \c "global"
        string partition_scope;

        #! emit \c COMPUTE \c STATISTICS when creating the index
        bool compute_statistics;
    }

    private {
        list<string> partition_columns;
    }

    constructor() {
        partition_scope = "default";
    }

    constructor(*string scope, bool compute, *softlist<string> pcols) {
        partition_scope = scope.val() ? scope.lwr() : "default";
        compute_statistics = compute;
        if (pcols) {
            partition_columns = pcols;
        }
    }

    #! validates and returns the effective Oracle index partition scope
    /** @param requested_scope an optional operation-specific override
        @param unique whether the index enforces uniqueness
        @param key_columns the index or constraint key columns
        @param method the optional Oracle index method
        @param err the exception code to raise on invalid input
        @param object_kind the object kind for diagnostic messages
        @param object_name the object name for diagnostic messages

        @return the normalized effective scope

        @throw INDEX-OPTION-ERROR for invalid or unsupported index combinations
        @throw CONSTRAINT-OPTION-ERROR for invalid or unsupported constraint combinations
    */
    string validatePartitionScope(*string requested_scope, bool unique, softlist<string> key_columns,
            *string method, string err, string object_kind, string object_name) {
        string scope = requested_scope.val() ? requested_scope.lwr() : partition_scope;
        if (!inlist(scope, ("default", "local", "global"))) {
            throw err, sprintf("Oracle %s %y has invalid partition_scope %y; expected one of %y", object_kind,
                object_name, scope, ("default", "local", "global"));
        }
        if (scope != "default" && partition_columns.empty()) {
            throw err, sprintf("Oracle %s %y cannot use partition_scope %y on a nonpartitioned table", object_kind,
                object_name, scope);
        }
        if (scope == "local" && unique) {
            hash<string, bool> key_hash = map {$1: True}, key_columns;
            *hash<string, bool> missing = (map {$1: True}, partition_columns) - key_hash.keys();
            if (missing) {
                throw err, sprintf("Oracle local unique %s %y must include partition key column(s): %y",
                    object_kind, object_name, missing.keys());
            }
        }
        if (partition_columns && method && method.lwr() == "bitmap" && scope != "local") {
            throw err, sprintf("Oracle bitmap index %y on a partitioned table requires partition_scope %y",
                object_name, "local");
        }
        return scope;
    }

    #! returns whether the argument has the same physical local/global behavior
    /** @param other the other partition-scope state

        @return @ref True "True" if both objects have the same physical local/global behavior
    */
    bool equalPartitionScope(OraclePartitionScopeSupport other) {
        return (partition_scope == "local") == (other.partition_scope == "local");
    }

    #! returns the effective physical scope, resolving \c "default" to \c "global" for a partitioned table
    /** @return the effective physical scope
    */
    string getEffectivePartitionScope() {
        return partition_scope == "default" && partition_columns ? "global" : partition_scope;
    }
}

#! represents an Oracle index
public class OracleIndex inherits SqlUtil::AbstractIndex, OraclePartitionScopeSupport {
    public {
        #! the native type of the index (if supported); mirrors \c ALL_INDEXES.INDEX_TYPE (e.g.
        #! \c "NORMAL", \c "BITMAP", \c "FUNCTION-BASED NORMAL", or a domain-index name)
        string native_type;

        #! the tablespace name of the index (if supported)
        *string tablespace;

        #! the explicit access method requested via the generic \c method index option (e.g. \c "bitmap"
        #! or a domain-index \c INDEXTYPE name); \c NOTHING means the driver default (a normal B-tree)
        *string method;

        #! method-specific storage parameters rendered into a \c PARAMETERS('k1=v1 k2=v2 ...') clause
        #! for Oracle domain indexes
        *hash<auto> with_options;
    }

    #! creates the object from the arguments
    constructor(string n, bool u, hash c, string nt, *string t, *string n_method, *hash<auto> n_with,
            *string n_partition_scope = NOTHING, bool n_compute_statistics = False,
            *softlist<string> n_partition_columns = NOTHING)
            : AbstractIndex(n, u, c),
                OraclePartitionScopeSupport(n_partition_scope, n_compute_statistics, n_partition_columns) {
        native_type = nt;
        tablespace = t;
        method = n_method;
        with_options = n_with;
        validatePartitionScope(NOTHING, unique, columns.keys(), method, "INDEX-OPTION-ERROR", "index", name);
    }

    #! returns a string that can be used to create the index in the database
    string getCreateSql(string table_name, *hash opt) {
        string scope = validatePartitionScope(opt.partition_scope, unique, columns.keys(), method,
            "INDEX-OPTION-ERROR", "index", name);
        # determine method: explicit overrides native_type for emission
        *string m = method.val() ? method.lwr() : NOTHING;

        # decide whether this is a bitmap prefix or an INDEXTYPE IS domain-index creation
        string prefix;
        *string indextype;
        if (m == "bitmap" || (!m && native_type.lwr() == "bitmap")) {
            prefix = "bitmap ";
        } else if (m.val() && m != "btree" && m != "normal") {
            # anything other than bitmap/btree/normal is treated as a domain-index type name
            indextype = m;
        }

        # an index "column" that is not a column of the table is an SQL expression (see AbstractTable::addIndex())
        string sql = sprintf("create %s%sindex %s on %s (%s)",
            unique ? "unique " : "", prefix ?? "", oracle_get_sql_identifier(name), table_name,
            (foldl $1 + ", " + $2, columns.getSqlColumnNameIterator()));

        if (indextype.val()) {
            sql += sprintf(" indextype is %s", indextype);
            if (with_options) {
                list<string> parts = ();
                HashIterator wi(with_options);
                while (wi.next()) {
                    parts += sprintf("%s=%s", wi.getKey(), wi.getValue());
                }
                sql += sprintf(" parameters('%s')", parts.join(" "));
            }
        }

        *string ts = opt.index_tablespace ? opt.index_tablespace : tablespace;
        if (ts)
            sql += sprintf(" tablespace %s", oracle_get_sql_identifier(ts));

        if (opt.compute_statistics || compute_statistics)
            sql += " compute statistics";

        if (scope == "local") {
            sql += " local";
        }

        return sql;
    }

    #! returns @ref True "True" if the argument is equal to the current index, @ref False "False" if not
    bool equalImpl(AbstractIndex ix) {
        OracleIndex oix = cast<OracleIndex>(ix);
        # normalize method comparison: NOTHING / "normal" / "btree" are all the default B-tree
        string m1 = (method.val() ? method.lwr() : native_type.lwr());
        string m2 = (oix.method.val() ? oix.method.lwr() : oix.native_type.lwr());
        if (m1 == "btree") {
            m1 = "normal";
        }
        if (m2 == "btree") {
            m2 = "normal";
        }
        if (m1 != m2) {
            return False;
        }
        # unordered hash comparison for WITH options
        if (!AbstractIndex::hashesEqualUnordered(with_options, oix.with_options)) {
            return False;
        }
        if (!equalPartitionScope(oix)) {
            return False;
        }
        if (tablespace && oix.tablespace && tablespace.upr() != oix.tablespace.upr()) {
            return False;
        }
        return True;
    }


    #! returns the SQL statement that renames the index in the database
    softlist<string> getRenameSql(string table_name, string new_name) {
        return sprintf("alter index %s rename to %s", oracle_get_sql_identifier(name),
            oracle_get_sql_identifier(new_name));
    }

    #! returns a string that can be used to drop the index from the database, by its name in the database
    /** @since OracleSqlUtilBase 1.7 the name of the index is quoted if it is not an ordinary name
    */
    string getDropSql(string table_name) {
        return sprintf("drop index %s", oracle_get_sql_identifier(getDbName()));
    }
}

#! represents an Oracle foreign constraint
public class OracleForeignConstraint inherits SqlUtil::AbstractForeignConstraint {
    public {
        #! @ref True "True" if the constraint is enabled, @ref False "False" if not
        bool enabled;
    }

    #! creates the constraint from the arguments
    /** @param n the name of the constraint
        @param c the source columns
        @param t the target table and columns
        @param e @ref True "True" if the constraint is enabled
        @param deferrable @ref True "True" if checks can be deferred until transaction commit
        @param initially_deferred @ref True "True" if checks are deferred by default
        @param on_delete the \c ON \c DELETE referential action: @ref SqlUtil::FK_CASCADE "FK_CASCADE",
            @ref SqlUtil::FK_SET_NULL "FK_SET_NULL", or NOTHING or @ref SqlUtil::FK_NO_ACTION "FK_NO_ACTION" for
            the database default
        @param on_update the \c ON \c UPDATE referential action; Oracle has none, so only NOTHING or
            @ref SqlUtil::FK_NO_ACTION "FK_NO_ACTION" is accepted

        @throw FOREIGN-CONSTRAINT-ERROR a referential action that Oracle does not support (see
            @ref ora_fk_actions)

        @note \a on_delete and \a on_update are available since OracleSqlUtilBase 1.7
    */
    constructor(string n, Columns c, ForeignConstraintTarget t, bool e, bool deferrable = False,
            bool initially_deferred = False, *string on_delete, *string on_update)
            : AbstractForeignConstraint(n, c, t, deferrable, initially_deferred, on_delete, on_update) {
        enabled = e;
        checkActions();
    }

    #! maps a \c DELETE_RULE value of the Oracle catalog to a referential action, or NOTHING for the default
    /** @param rule the \c DELETE_RULE of the constraint in \c ALL_CONSTRAINTS: \c "CASCADE", \c "SET NULL" or
        \c "NO ACTION"

        @return the referential action (see @ref SqlUtil::fk_actions "fk_actions"), or NOTHING for the database
        default (\c "NO ACTION")

        @since OracleSqlUtilBase 1.7
    */
    static *string actionFromCatalog(*string rule) {
        switch (rule) {
            case "CASCADE": return FK_CASCADE;
            case "SET NULL": return FK_SET_NULL;
        }
    }

    #! returns a string that can be used to create the constraint in the database
    /** @throw FOREIGN-CONSTRAINT-ERROR the constraint has a referential action that Oracle does not support (see
        @ref ora_fk_actions)

        @since OracleSqlUtilBase 1.7 the \c ON \c DELETE action is given if it is not the default
    */
    string getCreateSql(string table_name, *hash opt) {
        # the actions are public members that can be set after the constraint is created (as a table does from
        # the foreign constraint options), so they are checked here
        checkActions();
        return sprintf("alter table %s add constraint %s foreign key (%s) references %s (%s)%s%s", table_name,
            oracle_get_sql_identifier(name), (foldl $1 + ", " + $2, getSqlColumnNameIterator()),
            oracle_get_sql_object_name(target.table),
            (foldl $1 + ", " + $2, target.columns.getSqlColumnNameIterator()),
            on_delete ? " on delete " + on_delete.lwr() : "", getDeferrabilitySql());
    }

    #! checks that Oracle supports the referential actions of the constraint
    private checkActions() {
        if (on_update.val()) {
            throw "FOREIGN-CONSTRAINT-ERROR", sprintf("foreign constraint %y: Oracle does not support ON UPDATE "
                "referential actions; got on_update %y", name, on_update);
        }
        if (on_delete.val() && on_delete != FK_CASCADE && on_delete != FK_SET_NULL) {
            throw "FOREIGN-CONSTRAINT-ERROR", sprintf("foreign constraint %y: Oracle does not support the ON DELETE "
                "referential action %y; Oracle supports %y and %y, or no action (the default)", name, on_delete,
                FK_CASCADE, FK_SET_NULL);
        }
    }

    #! returns a string that can be used to drop the constraint from the database
    /** @since OracleSqlUtilBase 1.7 the name of the constraint is quoted if it is not an ordinary name
    */
    string getDropSql(string table_name) {
        return sprintf("alter table %s drop constraint %s", table_name, oracle_get_sql_identifier(name));
    }

    softlist getRenameSql(string table_name, string new_name) {
        return sprintf("alter table %s rename constraint %s to %s", table_name,
            oracle_get_sql_identifier(name), oracle_get_sql_identifier(new_name));
    }

    #! returns a string that can be used to temporarily disable the constraint from the database
    string getDisableSql(string table_name) {
        return sprintf("alter table %s disable constraint %s", table_name,
            oracle_get_sql_identifier(name));
    }

    #! returns a string that can be used to enable the constraint in the database
    string getEnableSql(string table_name, *hash opt) {
        return sprintf("alter table %s enable constraint %s", table_name,
            oracle_get_sql_identifier(name));
    }
}

