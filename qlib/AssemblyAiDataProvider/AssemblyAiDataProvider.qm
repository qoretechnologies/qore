%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) AssemblyAiRestClient
%requires(reexport) RestSchemaActions
%requires OpenApi3

module AssemblyAiDataProvider {
    version = "1.0";
    desc = "typed AssemblyAI transcription, language model, and voice agent actions";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        DataProviderActionCatalog::registerDiscoveryInventoryProvider("AssemblyAiDataProvider",
            list<hash<DataProviderDiscoveryExpectedIdentityInfo>> sub () {
                list<hash<DataProviderDiscoveryExpectedIdentityInfo>> ids = (
                    <DataProviderDiscoveryExpectedIdentityInfo>{"app": AssemblyAiDataProvider::AppName},
                    <DataProviderDiscoveryExpectedIdentityInfo>{"app": AssemblyAiDataProvider::AppName, "action": "transcribe"},
                    <DataProviderDiscoveryExpectedIdentityInfo>{"app": AssemblyAiDataProvider::AppName, "action": "make-api-call"},
                );
                foreach list<hash<RestSchemaActionInfo>> manifest in (AssemblyAiSchema::Manifests.iterator()) {
                    ids += map <DataProviderDiscoveryExpectedIdentityInfo>{
                        "app": AssemblyAiDataProvider::AppName, "action": $1.action,
                    }, manifest;
                }
                return ids;
            });
        DataProvider::registerFactory(new AssemblyAiDataProviderFactory());
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": AssemblyAiDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "AssemblyAI",
            "short_desc": "Transcription, speech understanding, and voice agents",
            "desc": "Use [AssemblyAI](https://www.assemblyai.com) to turn recordings into searchable text "
                "and automate speech workflows.\n\n**Capabilities**\n"
                "- Transcribe recorded or short audio, produce captions, and redact personal information\n"
                "- Analyze transcripts and generate model responses with LLM Gateway\n"
                "- Manage voice agents, sessions, and event subscriptions\n"
                "- Issue temporary tokens for real-time client applications\n\n"
                "**Regions:** choose US or EU endpoints for regional services. Voice Agents uses its global endpoint.",
            "scheme": "assemblyai",
            "logo": Priv::AssemblyAiLogo,
            "logo_file_name": "assemblyai-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm, DataProvider::AppGroup::Speech),
        });
        AssemblyAiActions::registerActions();
    };
}

/** @mainpage AssemblyAiDataProvider Module

    @tableofcontents

    @section assemblyaidataproviderintro AssemblyAI Data Provider

    The module exposes 31 REST operations, the submit-and-wait \c transcribe helper, and
    the shared \c make-api-call action. Requests and responses derive from eight committed
    OpenAPI descriptions. Updates use \c tools/rest-schema-import.qr with the adjacent
    \c assemblyai-import.json specification; checked repairs and source checksums make the import reviewable.

    |!Capability|!Actions
    |Recorded speech|Upload audio, create/list/get/delete transcripts, captions, sentences, paragraphs, word search, redacted audio
    |Language models|Completed chat responses, speech understanding, model discovery
    |Real-time credentials|Temporary streaming and voice agent tokens
    |Voice agents|Create/list/get/update/delete agents; list/get/delete sessions
    |Webhooks|Create/list/get/update/delete voice agent event subscriptions
    |Short audio|Sync STT, finite live uploads, and dictation with cleaned-up text

    @par Configuration
    Use an AssemblyAI connection with a sensitive \c apikey option. Authentication sends the bare
    API key in \c Authorization. The \c region option selects US or EU regional services.
    Voice Agents currently has a global endpoint. List transcripts is the authenticated connection ping.

    @par Models and value handling
    The recorded transcription API routes through \c speech_models, currently Universal-3.5 Pro and
    Universal-2. The deprecated \c speech_model option remains schema-described for compatibility with
    supported wire values; retired aliases such as \c nano are rejected. LLM models come from the
    service's model listing. Omitted, null, empty, false, and zero values retain their distinct API meanings.

    @par Streaming
    Completed-value actions return a final result. Use AssemblyAiRestClientIo::openWebSocket() for
    real-time speech and voice agent sessions, openChatStream() for SSE chat, and openAudioUpload()
    to send audio while recording. These native sessions expose transport lifetime and cancellation;
    they are not represented as completed-value actions. The /warm Sync endpoint is a connection
    prewarming optimization rather than a workflow action. Retired LeMUR endpoints are not exported.

    @section AssemblyAiDataProviderRelnotes Release Notes
    @subsection AssemblyAiDataProviderv1_0 AssemblyAiDataProvider v1.0
    - complete current REST action coverage with recursively typed requests and responses
    - regional authentication, resource dropdowns, discovery qualification, and translated presentation
    - schema-backed transcription options and local polling controls
*/

#! Public definitions in the AssemblyAI provider module
public namespace AssemblyAiDataProvider {
#! Stable application identity
public const AppName = "AssemblyAI";
}

namespace Priv {
#! Application logo, loaded during module initialization
const AssemblyAiLogo = File::readTextFile(get_script_dir() + "/assemblyai-logo.svg");
}

#! Existing public logo alias
public const AssemblyAiLogo = Priv::AssemblyAiLogo;
