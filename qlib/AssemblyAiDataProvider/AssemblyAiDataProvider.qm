%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) AssemblyAiRestClient
%requires RestClientIo

module AssemblyAiDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for AssemblyAI speech-to-text";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new AssemblyAiDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": AssemblyAiDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "AssemblyAI",
            "short_desc": "AssemblyAI speech-to-text with rich analytics",
            "desc": "Provides access to [AssemblyAI](https://www.assemblyai.com) "
                "— a speech AI platform offering high-accuracy transcription with "
                "the Universal-2 and Slam-1 model families plus an extensive "
                "analytics layer.\n\n"
                "**Common use cases**:\n"
                "- **Recorded transcription**: convert podcasts, meeting "
                "recordings, voicemails, and customer-service calls into "
                "searchable text\n"
                "- **Conversation intelligence**: speaker diarization, "
                "sentiment analysis, topic detection, and entity extraction "
                "from multi-party recordings\n"
                "- **Compliance and moderation**: content-safety classification "
                "for flagging sensitive material in recorded audio\n"
                "- **Automatic summarization**: generate `bullets`, `gist`, "
                "`headline`, or `paragraph` summaries alongside the transcript",
            "scheme": "assemblyai",
            "logo": AssemblyAiLogo,
            "logo_file_name": "assemblyai-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (
                DataProvider::AppGroup::AiLlm,
                DataProvider::AppGroup::Speech,
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AssemblyAiDataProvider::AppName,
            "path": "/transcribe",
            "action": "transcribe",
            "display_name": "Transcribe Audio",
            "short_desc": "Transcribe an audio URL via AssemblyAI (async)",
            "desc": "Submits a public audio URL to AssemblyAI's `/v2/transcript` "
                "endpoint and waits for the transcript to complete.  Internally "
                "drives the upload → poll → fetch lifecycle via "
                "@ref QoreAsyncJobUtils::AsyncJobPoller \"AsyncJobPoller\".\n\n"
                "All analytics are opt-in — `speaker_labels`, `summarization`, "
                "`sentiment_analysis`, `entity_detection`, `iab_categories`, and "
                "`content_safety` add corresponding fields to the response when "
                "set to `True`.",
            "action_code": DPAT_API,
            "groups": ("Speech Recognition",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                AssemblyAiTranscribeRequestDataType::Fields{"audio_url",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                AssemblyAiTranscribeRequestDataType::Fields{
                    "speech_model", "language_code", "speaker_labels",
                    "summarization",
                }, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                AssemblyAiTranscribeRequestDataType::Fields - (
                    "audio_url", "speech_model", "language_code", "speaker_labels",
                    "summarization",
                )
            ),
            "output_type": AssemblyAiTranscribeDataProvider::ResponseType,
        });
    };
}

/** @mainpage AssemblyAiDataProvider Module

    @tableofcontents

    @section assemblyaidataproviderintro AssemblyAiDataProvider Introduction

    The %AssemblyAiDataProvider module provides a data provider API for
    [AssemblyAI](https://www.assemblyai.com) speech-to-text services.

    A single DPAT_API action is registered:
    - `transcribe` — submit an audio URL to `/v2/transcript`, wait for
      the job to reach a terminal status via
      @ref QoreAsyncJobUtils::AsyncJobPoller "AsyncJobPoller", and
      return the completed transcript

    The full async lifecycle (submit → poll → fetch result) is hidden
    inside the action; callers see a synchronous request/response shape.

    @par Analytics

    AssemblyAI's analytics features (`summarization`, `speaker_labels`,
    `sentiment_analysis`, `entity_detection`, `iab_categories`,
    `content_safety`) are all opt-in via boolean flags on the request.
    Each enabled feature populates a corresponding field on the response.

    @section AssemblyAiDataProviderRelnotes Release Notes

    @subsection AssemblyAiDataProviderv1_0 AssemblyAiDataProvider v1.0
    - the initial version of the %AssemblyAiDataProvider module
*/

#! contains all public definitions in the AssemblyAiDataProvider module
public namespace AssemblyAiDataProvider {
#! AssemblyAI application name
public const AppName = "AssemblyAI";
}

#! App logo loaded from file
public const AssemblyAiLogo = File::readTextFile(get_script_dir() + "/assemblyai-logo.svg");
