# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module OneDriveRestClient {
    version = "1.0";
    desc = "user module for calling Microsoft OneDrive REST API services via Microsoft Graph";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("onedrive", OneDriveRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("sharepoint", SharePointRestConnection::ConnectionScheme);
    };
}

/** @mainpage OneDriveRestClient Module

    @tableofcontents

    @section onedriverestclientintro OneDriveRestClient Introduction

    The %OneDriveRestClient module provides an API for calling Microsoft OneDrive REST API services
    via the Microsoft Graph API.

    To use this module, use \c "%requires OneDriveRestClient" in your code.

    All the public symbols in the module are defined in the OneDriveRestClient namespace.

    The main classes are:
    - @ref OneDriveRestClient::OneDriveRestClient "OneDriveRestClient":
      this class provides the REST client API for communication with the Microsoft Graph REST
      API for OneDrive; it also automates authentication and authorization to the target
    - @ref OneDriveRestClient::OneDriveRestConnection "OneDriveRestConnection":
      provides a REST connection object to Microsoft OneDrive services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires OneDriveRestClient

hash<auto> opts = {
    "oauth2_client_id": client_id,
    "oauth2_client_secret": client_secret,
};

OneDriveRestClient rest(opts);
hash<auto> ans = rest.get("me/drive");
printf("%Y\n", ans.body);
    @endcode

    @section onedriverestclientrelnotes Release Notes

    @subsection onedriverestclientv1_0 OneDriveRestClient v1.0
    - the initial version of the %OneDriveRestClient module
*/

#! the OneDriveRestClient namespace contains all the objects in the OneDriveRestClient module
public namespace OneDriveRestClient {
#! Common base class for OneDriveRestClient functionality
public class OneDriveRestClientBase {
    public {
        #! Default Microsoft Graph API URL
        const DefaultUrl = "https://graph.microsoft.com";

        #! Default API version
        const DefaultApiVersion = "v1.0";

        #! Default data serialization
        const DefaultData = "json";

        #! OAuth2 base URL for Microsoft identity platform
        const OAuth2BaseUrl = "https://login.microsoftonline.com/";

        #! OAuth2 auth URI path suffix
        const OAuth2AuthUriPathSuffix = "/oauth2/v2.0/authorize";

        #! OAuth2 token URI path suffix
        const OAuth2TokenUriPathSuffix = "/oauth2/v2.0/token";

        #! Default OAuth2 auth URL (using "common" tenant)
        const DefaultAuthUrl = sprintf("%scommon%s", OAuth2BaseUrl, OAuth2AuthUriPathSuffix);

        #! Default OAuth2 token URL (using "common" tenant)
        const DefaultTokenUrl = sprintf("%scommon%s", OAuth2BaseUrl, OAuth2TokenUriPathSuffix);

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default OAuth2 scopes
        const DefaultOAuth2Scopes = (
            "offline_access",
            "Files.ReadWrite.All",
            "User.Read",
        );

        #! Default OAuth2 auth args
        /** @note Microsoft does not support \c "access_type"; use the \c "offline_access" scope instead
            (already included in @ref DefaultOAuth2Scopes)
        */
        const DefaultAuthArgs = {
            "prompt": "consent",
        };

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path
        const DefaultPingPath = "me/drive";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! OAuth2 scopes for the \c "sharepoint" API profile
        /** SharePoint needs site scopes that OneDrive does not, and does not need
            \c Files.ReadWrite.All, which grants access to every drive in the tenant; a document
            library is reached through its site instead.
        */
        const SharePointOAuth2Scopes = (
            "openid",
            "email",
            "profile",
            "offline_access",
            "Sites.Manage.All",
            "Sites.Read.All",
            "Files.ReadWrite",
            "User.Read",
        );

        #! Ping path for the \c "sharepoint" API profile
        /** \c "me/drive" is the signed-in user's OneDrive, which says nothing about whether
            SharePoint is reachable; the tenant's root site does.
        */
        const SharePointPingPath = "sites/root";

        #! API profiles
        /** Microsoft Graph serves OneDrive and SharePoint from one host with one OAuth2 flow, so
            the two differ only in which scopes they ask for and what a meaningful ping is.  A
            profile carries that difference, which is why there is no separate SharePoint client
            class: duplicating the Graph auth layer would mean fixing every Microsoft OAuth2 bug
            twice.

            Profile values are **defaults, not overrides**: an option the caller set explicitly
            always wins.

            @since %OneDriveRestClient 1.1
        */
        const ApiProfiles = {
            "onedrive": {
                "oauth2_scopes": DefaultOAuth2Scopes,
                "ping_method": DefaultPingMethod,
                "ping_path": DefaultPingPath,
                "ping_headers": DefaultPingHeaders,
            },
            "sharepoint": {
                "oauth2_scopes": SharePointOAuth2Scopes,
                "ping_method": DefaultPingMethod,
                "ping_path": SharePointPingPath,
                "ping_headers": DefaultPingHeaders,
            },
        };

        #! The API profile used when none is given
        /** \c "onedrive" reproduces the behaviour this module had before profiles existed, so an
            existing connection resolves to exactly the same options.
        */
        const DefaultApiProfile = "onedrive";

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "default_path": "/" + DefaultApiVersion,
            "oauth2_auth_args": DefaultAuthArgs,
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_scopes": DefaultOAuth2Scopes,
            "oauth2_token_url": DefaultTokenUrl,
            "url": DefaultUrl,
        };
    }

    #! returns options for the OneDriveRestClient constructors
    /** @param opts0 the caller's options; the \c api_profile option selects an entry in
        @ref ApiProfiles and is consumed here rather than passed on to the client

        @throw ONEDRIVE-API-PROFILE-ERROR the named profile is not known
    */
    static hash<auto> getOptions(hash<auto> opts0) {
        hash<auto> opts += opts0;
        # the API profile is resolved before the module defaults, so that a profile value counts
        # as "already set" and the defaults do not overwrite it
        string profile = (remove opts.api_profile) ?? DefaultApiProfile;
        *hash<auto> conf = ApiProfiles{profile};
        if (!exists conf) {
            throw "ONEDRIVE-API-PROFILE-ERROR", sprintf("unknown api_profile %y; known profiles: "
                "%y", profile, keys ApiProfiles);
        }
        # profile values fill in only where the caller has not set the option itself
        map opts{$1.key} = $1.value, conf.pairIterator(), !opts.hasKey($1.key);
        # set defaults for options not already set
        map opts{$1.key} = $1.value, DefaultOptions.pairIterator(), !opts.hasKey($1.key);
        # resolve tenant-aware OAuth2 URLs
        *string tenant = opts.tenant;
        if (tenant && tenant != "common") {
            if (opts.oauth2_auth_url == DefaultAuthUrl) {
                opts.oauth2_auth_url = OAuth2BaseUrl + tenant + OAuth2AuthUriPathSuffix;
            }
            if (opts.oauth2_token_url == DefaultTokenUrl) {
                opts.oauth2_token_url = OAuth2BaseUrl + tenant + OAuth2TokenUriPathSuffix;
            }
        }
        return opts;
    }
}

#! this class provides the REST client API for communication with Microsoft OneDrive via Graph API
/** This class requires the following options for Microsoft OneDrive authentication and
    authorization:
    - \c oauth2_client_id: the OAuth2 client ID
    - \c oauth2_client_secret: the OAuth2 client secret

    Errors returned from Microsoft Graph will have the following format:
    - \c err: the error code from Graph (e.g., \c itemNotFound)
    - \c desc: the error message
    - \c arg: the error hash from the server
*/
public class OneDriveRestClient inherits RestClient::RestClient, OneDriveRestClientBase {
    private:internal {
        #! Tenant ID
        *string tenant;
    }

    #! creates the object with the given options
    /**
        @param opts valid options are the same as @ref RestClient::RestClient "RestClient" with the following
        differences:
        - \c tenant: the Azure AD tenant ID (default: "common")
        - \c data: see @ref RestClient::RestClient::DataSerializationOptions "DataSerializationOptions" for possible
        values; the default is \c "json"
        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw ONEDRIVERESTCLIENT-ERROR missing or invalid required option for REST
        authentication or communication
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(OneDriveRestClientBase::getOptions(opts), True) {
        tenant = opts.tenant ?? "common";

        if (oauth2_token_url == "auto") {
            oauth2_token_url = OAuth2BaseUrl + tenant + OAuth2TokenUriPathSuffix;
        }
        if (oauth2_auth_url == "auto") {
            oauth2_auth_url = OAuth2BaseUrl + tenant + OAuth2AuthUriPathSuffix;
        }

        if (!do_not_connect) {
            if (!token) {
                loginIntern();
            } else {
                connect();
            }
        }
    }

    #! Returns the tenant ID
    *string getTenant() {
        return tenant;
    }

    #! sends the outgoing HTTP message and recodes the response to data
    private hash<auto> sendAndDecodeResponse(*data body, string m, string path, hash<auto> hdr,
            *reference<hash<auto>> info, *softbool decode_errors, *string assume_content_type, *string shdr,
            *code signer) {
        try {
            return RestClient::sendAndDecodeResponse(body, m, path, hdr, \info, decode_errors, assume_content_type,
                shdr, signer);
        } catch (hash<ExceptionInfo> ex) {
            # throw an exception for the Graph error
            if (info."response-body".error && info."response-body".error."code".typeCode() == NT_STRING
                    && info."response-body".error.message.typeCode() == NT_STRING) {
                hash<auto> error = info."response-body".error;
                string errcode = remove error."code";
                string msg = remove error.message;
                throw errcode, msg, error + ex.arg + {"decoded_body": info."response-body"};
            }
            rethrow;
        }
    }
}

#! class for Microsoft OneDrive REST connections; returns @ref OneDriveRestClient objects
public class OneDriveRestConnection inherits RestClient::RestConnection {
    public {
        #! Default OneDrive REST API URL
        const DefaultUrl = "onedrive://graph.microsoft.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Microsoft OneDrive",
            "short_desc": "A connection to the Microsoft OneDrive REST API via Microsoft Graph",
            "desc": "A connection to the Microsoft OneDrive REST API via Microsoft Graph for cloud file "
                "storage and management.\n\n"
                "Requires OAuth2 credentials (`oauth2_client_id` and `oauth2_client_secret`) from your "
                "[Azure app registration](https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps). "
                "The connection uses the `onedrive://` URL scheme",
            "cls": Class::forName("OneDriveRestConnection"),
            "auto_url": True,
            "schemes": {
                "onedrive": True,
            },
            "base_scheme_map": {
                "https": "onedrive",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data" + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::DefaultData,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                        + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url + <ConnectionOptionInfo>{
                    "default_value": "auto",
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                        + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                        + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::DefaultOAuth2Scopes,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url + <ConnectionOptionInfo>{
                    "default_value": "auto",
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::DefaultPingPath,
                },
                "tenant": <ConnectionOptionInfo>{
                    "display_name": "Tenant ID",
                    "short_desc": "Azure AD tenant ID",
                    "type": "string",
                    "desc": "Azure AD tenant ID for authentication; use `common` for multi-tenant apps, "
                        "`organizations` for work/school accounts only, `consumers` for personal accounts "
                        "only, or provide a specific tenant ID or domain name",
                    "default_value": "common",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "common",
                            "display_name": "Common (All Account Types)",
                        },
                        <AllowedValueInfo>{
                            "value": "organizations",
                            "display_name": "Organizations (Work/School Only)",
                        },
                        <AllowedValueInfo>{
                            "value": "consumers",
                            "display_name": "Consumers (Personal Only)",
                        },
                    ),
                },
            },
            "required_options": "oauth2_client_id,oauth2_client_secret",
        };

        #! options required to support the OAuth2 authorization code grant flow
        const OAuth2AuthRequestOptions = (
            "oauth2_client_id",
            "oauth2_client_secret",
            "oauth2_auth_url",
            "oauth2_token_url",
            "oauth2_redirect_url",
        );
    }

    #! creates the OneDriveRestConnection object
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the OneDriveRestConnection object
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(OneDriveRestConnection::getConfig(config, DefaultUrl), attr) {
    }

    #! creates a subclass of this connection serving a different scheme on the same host
    /** @param config the connection configuration
        @param attr the connection attributes
        @param default_url the URL the subclass normalizes to

        A subclass cannot rely on the two-argument constructor above: the URL normalization is
        necessarily \c static (it runs while evaluating the base constructor's arguments, before
        there is an object to dispatch on), so a \c static that read \a DefaultUrl would always read
        *this* class's constant and rewrite the subclass's scheme back to \c "onedrive://".  The
        subclass therefore passes the URL it wants to normalize to.

        @since %OneDriveRestClient 1.1
    */
    constructor(hash<auto> config, *hash<auto> attr, string default_url)
            : RestConnection(OneDriveRestConnection::getConfig(config, default_url), attr) {
    }

    #! returns config with the correct URL
    /** @param config the connection configuration
        @param default_url the URL to normalize to

        @note \a default_url is a parameter rather than a read of @ref DefaultUrl so that a
        subclass keeps its own scheme; see the three-argument constructor above
    */
    private static hash<auto> getConfig(hash<auto> config, string default_url) {
        if (!config.url || config.url != default_url) {
            config.url = default_url;
        }
        return config;
    }

    #! returns \c "onedrive"
    string getType() {
        return "onedrive";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "OneDrive";
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the OneDriveDataProvider and creates the data provider
        # object dynamically
        load_module("OneDriveDataProvider");
        return create_object("OneDriveDataProvider", getAsync());
    }

    #! Returns a URI for an authorization code request
    string getAuthorizationCodeRequest(hash<AuthCodeInfo> info = <AuthCodeInfo>{}) {
        return RestConnection::getAuthorizationCodeRequest(info) + "&response_mode=query";
    }

    #! Returns the OAuth2 auth URL or throws an exception if not set
    string getAuthUrl(*bool allow_relative) {
        *string rv = opts.oauth2_auth_url;
        if (!rv.val()) {
            throw "OAUTH2-ERROR", sprintf("connection %y has no \"oauth2_auth_url\" option set", name);
        }
        if (rv == "auto") {
            string tenant = opts.tenant ?? "common";
            rv = OneDriveRestClientBase::OAuth2BaseUrl + tenant + OneDriveRestClientBase::OAuth2AuthUriPathSuffix;
        } else if (!allow_relative && rv !~ /^http/) {
            string url = real_url;
            if (url !~ /\/$/) {
                url += "/";
            }
            if (rv =~ /^\//) {
                rv = rv[1..];
            }
            rv = url + rv;
        }
        return rv;
    }

    #! Returns the OAuth2 token URL or throws an exception if not set
    string getTokenUrl(*bool allow_relative) {
        *string rv = opts.oauth2_token_url;
        if (!rv.val()) {
            throw "OAUTH2-ERROR", sprintf("connection %y has no \"oauth2_token_url\" option set", name);
        }
        if (rv == "auto") {
            string tenant = opts.tenant ?? "common";
            rv = OneDriveRestClientBase::OAuth2BaseUrl + tenant + OneDriveRestClientBase::OAuth2TokenUriPathSuffix;
        } else if (!allow_relative && rv !~ /^http/) {
            string url = real_url;
            if (url !~ /\/$/) {
                url += "/";
            }
            rv = url + rv;
        }
        return rv;
    }

    #! Returns @ref True if the response was related to an authorization token error
    /** Any 401 from the Microsoft Graph API indicates an expired or invalid token
        that should trigger a refresh
    */
    bool isAuthTokenError(int status_code, hash<auto> headers, bool body_deserialized, *string body_content_type,
            auto body) {
        return status_code == 401;
    }

    #! Returns the canonical URL for this connection type
    /** Read through a method rather than as the @ref DefaultUrl constant because a constant
        reference is resolved **lexically**, at parse time, to the constant of the class whose body
        contains it: it does not dispatch on the subclass.  An inherited method that read
        \c DefaultUrl directly therefore saw OneDrive's value even for a SharePoint connection.

        That matters most in @ref setUpdateOptionsCode(), which is how a connection writes corrected
        options **back to the configuration store**: reading the wrong constant there did not merely
        misreport the URL, it persisted \c "onedrive://graph.microsoft.com" over the connection's own
        scheme every time the connection was loaded, so the correction survived restarts and came
        back after any manual edit.

        @return the canonical URL for this connection type

        @since %OneDriveRestClient 1.1
    */
    string getDefaultUrl() {
        return DefaultUrl;
    }

    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            string default_url = getDefaultUrl();
            if (url != default_url) {
                update.url = default_url;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! Sets the auth code feature if supported
    private checkAuthCodeFeature() {
        if (opts{OAuth2AuthRequestOptions}.size() == OAuth2AuthRequestOptions.size()) {
            setOAuth2AuthFeature(RCF_OAUTH2_AUTH_CODE);
        }
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
        children_can_support_records = True;
        children_can_support_observers = True;
    }

    #! returns a @ref OneDriveRestClient object
    private OneDriveRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new OneDriveRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new OneDriveRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! class for Microsoft SharePoint REST connections; returns @ref OneDriveRestClientIo objects
/** SharePoint is served by the same Microsoft Graph host, and authorized by the same OAuth2 flow, as
    OneDrive; the two differ only in which scopes they ask for and what a meaningful ping is.  That
    difference is carried by the \c "sharepoint" entry in
    @ref OneDriveRestClientBase::ApiProfiles "ApiProfiles", which this connection pins, so there is no
    separate SharePoint client class to keep in step with Microsoft's OAuth2 handling.

    @since %OneDriveRestClient 1.1
*/
public class SharePointRestConnection inherits OneDriveRestConnection {
    public {
        #! Default SharePoint REST API URL
        const DefaultUrl = "sharepoint://graph.microsoft.com";

        #! The URL used when a connection for this app is created with a generated URL
        /** A consuming platform creates an app connection with \c auto_url by reading a URL constant off the
            connection class **by reflection**, and it looks for \c DefaultConnectionUrl before
            \c DefaultUrl - precisely so that a class in a hierarchy where \c DefaultUrl is
            shadowed can state its URL unambiguously rather than depending on which of the two
            constants a hierarchy walk happens to return.

            This class shadows @ref OneDriveRestConnection::DefaultUrl, so it says so explicitly
            here instead of relying on that resolution.

            @since %OneDriveRestClient 1.1
        */
        const DefaultConnectionUrl = DefaultUrl;

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Microsoft SharePoint",
            "short_desc": "A connection to Microsoft SharePoint via the Microsoft Graph API",
            "desc": "A connection to Microsoft SharePoint via the Microsoft Graph API, for document "
                "libraries and lists.\n\n"
                "Requires OAuth2 credentials (`oauth2_client_id` and `oauth2_client_secret`) from your "
                "[Azure app registration](https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps). "
                "The connection uses the `sharepoint://` URL scheme",
            "cls": Class::forName("SharePointRestConnection"),
            "auto_url": True,
            "schemes": {
                "sharepoint": True,
            },
            "base_scheme_map": {
                "https": "sharepoint",
            },
            "options": OneDriveRestConnection::ConnectionScheme.options + {
                "oauth2_scopes": OneDriveRestConnection::ConnectionScheme.options.oauth2_scopes
                        + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::SharePointOAuth2Scopes,
                },
                "ping_path": OneDriveRestConnection::ConnectionScheme.options.ping_path
                        + <ConnectionOptionInfo>{
                    "default_value": OneDriveRestClientBase::SharePointPingPath,
                },
            },
            "required_options": "oauth2_client_id,oauth2_client_secret",
        };
    }

    #! creates the SharePointRestConnection object
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : OneDriveRestConnection(name, description, url, attributes, options) {
    }

    #! creates the SharePointRestConnection object
    /** The URL to normalize to is passed explicitly: the base class normalizes in a \c static, so
        it would otherwise rewrite this connection's scheme back to \c "onedrive://"
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : OneDriveRestConnection(config, attr, SharePointRestConnection::DefaultUrl) {
    }

    #! Returns \c "sharepoint://graph.microsoft.com"
    /** Overridden because the inherited implementation reads a constant, and a constant reference
        resolves lexically to the class whose body contains it rather than dispatching on the
        subclass; without this a SharePoint connection has its URL rewritten to OneDrive's and
        persisted by @ref setUpdateOptionsCode()
    */
    string getDefaultUrl() {
        return DefaultUrl;
    }

    #! returns \c "sharepoint"
    string getType() {
        return "sharepoint";
    }

    #! Returns the data provider application name this connection serves
    *string getAppName() {
        return "SharePoint";
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the SharePointDataProvider and creates the
        # data provider object dynamically
        load_module("SharePointDataProvider");
        return create_object("SharePointDataProvider", getAsync());
    }

    #! Returns the connection options with the SharePoint API profile pinned
    /** The profile supplies the scopes and ping that SharePoint needs, and only where the connection
        has not set the option itself.
    */
    private hash<auto> getSharePointConnectionOptions(*hash<auto> rtopts) {
        return getConnectionOptions(rtopts) + {
            "api_profile": "sharepoint",
        };
    }

    #! returns a @ref OneDriveRestClient object configured for SharePoint
    private OneDriveRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new OneDriveRestClient(getSharePointConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object configured for SharePoint
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new OneDriveRestClientIo(getSharePointConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Microsoft OneDrive REST API using multiplexed HTTP connections
/** @see OneDriveRestClient for more information
*/
public class OneDriveRestClientIo inherits RestClientIo::RestClientIo, OneDriveRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(OneDriveRestClientBase::getOptions(opts), shared_mgr) {
        # resolve "auto" OAuth2 URLs from tenant
        string tenant = opts.tenant ?? "common";
        if (oauth2_token_url == "auto") {
            oauth2_token_url = OAuth2BaseUrl + tenant + OAuth2TokenUriPathSuffix;
        }
        if (oauth2_auth_url == "auto") {
            oauth2_auth_url = OAuth2BaseUrl + tenant + OAuth2AuthUriPathSuffix;
        }
    }
}
}
