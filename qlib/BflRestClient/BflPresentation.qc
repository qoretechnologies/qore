        "mode": ("Mode", "Choose the operation mode and provide its required inputs."),
        "draft_cache": ("Draft Cache", "Encrypted bundle from a previous draft result. Supply its bytes, base64, file, or unexpired URL to reproduce the video at full quality."),
        "resolution": ("Resolution", "Video resolution class. Exact dimensions depend on the aspect ratio. Drafts require HD."),
        "duration": ("Duration", "Whole seconds: 5–20 for text or image input, 5–15 for video continuation. `auto` lets the service choose."),
