# minimum required Qore version
%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) BigMLRestClient

module BigMLDataProvider {
    version = "1.0.0";
    desc = "user module providing BigML data pipeline processors for ML predictions, "
        "anomaly detection, clustering, and topic modeling via the BigML API";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # register the BigML data provider factory
        DataProvider::registerFactory(new BigMLDataProviderFactory());

        # register the BigML app
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": BigMLApp::AppName,
            "display_name": "BigML",
            "short_desc": "Machine learning platform for predictions, anomaly detection, "
                "clustering, and topic modeling",
            "desc": "BigML provides a cloud-based machine learning platform with scalable, "
                "automated ML capabilities. Use BigML pipeline processors to enrich your "
                "data with predictions from trained models, anomaly scores from anomaly "
                "detectors, cluster assignments, and topic distributions — all via the "
                "BigML REST API.",
            "scheme": "bigml",
            "logo": BigMLApp::BigMLLogo,
            "logo_file_name": "bigml-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (AppGroup::AiLlm, AppGroup::Analytics),
        });

        # register predict action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/predict",
            "action": "predict",
            "display_name": "Get Prediction",
            "short_desc": "Get a prediction from a BigML model for each record",
            "desc": "Sends each record in the pipeline to the BigML prediction API using a "
                "trained model, ensemble, or deepnet. Each record is enriched with the "
                "prediction result and confidence score. For example, a model trained on "
                "housing data can predict property prices from features like square footage "
                "and location.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLPredictionProcessor",
            "groups": ("Predictions",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLPredictionProcessor::ConstructorOptions{
                    "model", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register anomaly-score action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/anomaly-score",
            "action": "anomaly-score",
            "display_name": "Score for Anomalies",
            "short_desc": "Score records for anomalies using a BigML anomaly detector",
            "desc": "Sends each record to the BigML anomaly score API using a trained anomaly "
                "detector. Each record is enriched with an anomaly score (0.0 = normal, "
                "1.0 = highly anomalous) and an is_anomaly flag based on the configured "
                "threshold.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLAnomalyScoreProcessor",
            "groups": ("Anomaly Detection",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLAnomalyScoreProcessor::ConstructorOptions{
                    "anomaly", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                {"threshold": BigMLAnomalyScoreProcessor::ConstructorOptions.threshold}, {
                    "loc": "constructor",
                }
            ),
        });

        # register centroid action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/centroid",
            "action": "centroid",
            "display_name": "Assign to Cluster",
            "short_desc": "Assign records to clusters using a BigML cluster model",
            "desc": "Sends each record to the BigML centroid API using a trained cluster model. "
                "Each record is enriched with the cluster name, cluster ID, and distance to "
                "the cluster center.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLCentroidProcessor",
            "groups": ("Clustering",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLCentroidProcessor::ConstructorOptions{
                    "cluster", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register topic-distribution action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/topic-distribution",
            "action": "topic-distribution",
            "display_name": "Get Topic Distribution",
            "short_desc": "Get topic distributions from a BigML topic model",
            "desc": "Sends each record to the BigML topic distribution API using a trained "
                "topic model. Each record is enriched with a list of topic probabilities.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLTopicDistributionProcessor",
            "groups": ("Topic Modeling",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLTopicDistributionProcessor::ConstructorOptions{
                    "topicmodel", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register train-and-predict action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/train-and-predict",
            "action": "train-and-predict",
            "display_name": "Train Model & Predict",
            "short_desc": "Train a model on pipeline data and predict in one step",
            "desc": "Combines model training and prediction into a single pipeline step. "
                "Buffers records, uploads them to BigML to create a training dataset, trains "
                "a model of the selected type, then runs predictions on each record. Supports "
                "decision tree, random forest, anomaly detection, and clustering. The trained "
                "model is kept in your BigML account for future reuse with the predict action "
                "unless 'Delete Model After Use' is enabled.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "BigMLDataProvider::BigMLTrainAndPredictProcessor",
            "groups": ("Training",),
            "data_dependent_options": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLTrainAndPredictProcessor::ConstructorOptions{
                    "model_type",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                    "has_dependents": True,
                    "on_change": ("refetch",),
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BigMLTrainAndPredictProcessor::ConstructorOptions{
                    "input_fields", "window_size",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BigMLTrainAndPredictProcessor::ConstructorOptions{
                    "objective_field",
                }, {
                    "preselected": True,
                    "loc": "constructor",
                    "depends_on": ("model_type",),
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BigMLTrainAndPredictProcessor::ConstructorOptions{
                    "model_name", "cleanup_model", "poll_interval_ms", "timeout_ms",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register batch-predict action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/batch-predict",
            "action": "batch-predict",
            "display_name": "Batch Prediction",
            "short_desc": "Create batch predictions for multiple records",
            "desc": "Accumulates records in a window and sends them as a batch to BigML for "
                "prediction. More efficient than per-record predictions for large volumes. "
                "Creates a temporary source and dataset in BigML, runs the batch prediction, "
                "and emits enriched records.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "BigMLDataProvider::BigMLBatchPredictionProcessor",
            "groups": ("Predictions",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLBatchPredictionProcessor::ConstructorOptions{
                    "model", "input_fields", "window_size",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BigMLBatchPredictionProcessor::ConstructorOptions{
                    "poll_interval_ms", "timeout_ms",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register batch-anomaly-score action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/batch-anomaly-score",
            "action": "batch-anomaly-score",
            "display_name": "Batch Anomaly Score",
            "short_desc": "Create batch anomaly scores for multiple records",
            "desc": "Accumulates records in a window and sends them as a batch to BigML for "
                "anomaly scoring. More efficient than per-record scoring for large volumes.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "BigMLDataProvider::BigMLBatchAnomalyScoreProcessor",
            "groups": ("Anomaly Detection",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLBatchAnomalyScoreProcessor::ConstructorOptions{
                    "anomaly", "input_fields", "window_size",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BigMLBatchAnomalyScoreProcessor::ConstructorOptions{
                    "threshold", "poll_interval_ms", "timeout_ms",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register batch-centroid action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/batch-centroid",
            "action": "batch-centroid",
            "display_name": "Batch Cluster Assignment",
            "short_desc": "Create batch centroid assignments for multiple records",
            "desc": "Accumulates records in a window and sends them as a batch to BigML for "
                "cluster assignment. More efficient than per-record assignment for large volumes.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "BigMLDataProvider::BigMLBatchCentroidProcessor",
            "groups": ("Clustering",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLBatchCentroidProcessor::ConstructorOptions{
                    "cluster", "input_fields", "window_size",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BigMLBatchCentroidProcessor::ConstructorOptions{
                    "poll_interval_ms", "timeout_ms",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register projection action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/projection",
            "action": "projection",
            "display_name": "PCA Projection",
            "short_desc": "Project records using a BigML PCA model for dimensionality reduction",
            "desc": "Sends each record in the pipeline to the BigML projection API using a "
                "pre-trained PCA model. Each record is enriched with principal component values, "
                "reducing high-dimensional data to its most important features.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLProjectionProcessor",
            "groups": ("Dimensionality Reduction",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLProjectionProcessor::ConstructorOptions{
                    "pca", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register batch-projection action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/batch-projection",
            "action": "batch-projection",
            "display_name": "Batch PCA Projection",
            "short_desc": "Create batch PCA projections for multiple records",
            "desc": "Accumulates records in a window and sends them as a batch to BigML for "
                "PCA projection. More efficient than per-record projection for large volumes. "
                "Creates a temporary source and dataset in BigML, runs the batch projection, "
                "and emits enriched records.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "BigMLDataProvider::BigMLBatchProjectionProcessor",
            "groups": ("Dimensionality Reduction",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLBatchProjectionProcessor::ConstructorOptions{
                    "pca", "input_fields", "window_size",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BigMLBatchProjectionProcessor::ConstructorOptions{
                    "poll_interval_ms", "timeout_ms",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register linear-regression action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/linear-regression",
            "action": "linear-regression",
            "display_name": "Linear Regression Prediction",
            "short_desc": "Get predictions from a BigML linear regression model",
            "desc": "Sends each record in the pipeline to the BigML prediction API using a "
                "pre-trained linear regression model. Each record is enriched with the predicted "
                "numeric value and confidence score. Use this for continuous value prediction "
                "tasks like price estimation or demand forecasting.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLLinearRegressionProcessor",
            "groups": ("Predictions",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLLinearRegressionProcessor::ConstructorOptions{
                    "linearregression", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register forecast action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/forecast",
            "action": "forecast",
            "display_name": "Time Series Forecast",
            "short_desc": "Get time series forecasts from a BigML model",
            "desc": "Sends each record in the pipeline to the BigML forecast API using a "
                "pre-trained time series model. Each record is enriched with forecast "
                "predictions and confidence intervals. Use this for time series forecasting "
                "tasks like sales projections or capacity planning.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLForecastProcessor",
            "groups": ("Time Series",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLForecastProcessor::ConstructorOptions{
                    "timeseries", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BigMLForecastProcessor::ConstructorOptions{
                    "horizon",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register logistic-regression action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/logistic-regression",
            "action": "logistic-regression",
            "display_name": "Logistic Regression Classification",
            "short_desc": "Classify records using a BigML logistic regression model",
            "desc": "Sends each record in the pipeline to the BigML prediction API using a "
                "pre-trained logistic regression model. Each record is enriched with the "
                "predicted class and per-class probability distribution. Use this for "
                "classification tasks like spam detection, churn prediction, or sentiment "
                "analysis.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLLogisticRegressionProcessor",
            "groups": ("Classification",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLLogisticRegressionProcessor::ConstructorOptions{
                    "logisticregression", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });

        # register association-set action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BigMLApp::AppName,
            "path": "/association-set",
            "action": "association-set",
            "display_name": "Association Rule Matching",
            "short_desc": "Match records against association rules from a BigML model",
            "desc": "Sends each record in the pipeline to the BigML association set API using a "
                "pre-trained association model. Each record is enriched with matching association "
                "rules and their confidence scores. Use this for market basket analysis, "
                "recommendation systems, and discovering item co-occurrence patterns.",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "BigMLDataProvider::BigMLAssociationSetProcessor",
            "groups": ("Association Rules",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BigMLAssociationSetProcessor::ConstructorOptions{
                    "association", "input_fields",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });
    };
}

/** @mainpage BigMLDataProvider Module

    @tableofcontents

    @section bigmldataproviderintro BigMLDataProvider Module Introduction

    The %BigMLDataProvider module provides data pipeline processors that connect to the
    BigML cloud machine learning platform for predictions, anomaly detection, clustering,
    and topic modeling.

    These processors send data to BigML's REST API and return enriched records:
    - <b>Predictions</b>: Use trained models, ensembles, or deepnets to predict target values
    - <b>Anomaly Detection</b>: Score records for unusual patterns using anomaly detectors
    - <b>Clustering</b>: Assign records to clusters discovered by cluster models
    - <b>Topic Modeling</b>: Get topic probability distributions for text data

    Both per-record and batch processing modes are available.

    @section bigmldataprovider_relnotes Release Notes

    @subsection bigmldataprovider_v1_0 BigMLDataProvider v1.0
    - initial release with 4 per-record processors, 3 batch processors, and 1 train-and-predict processor
*/

#! Contains all public definitions in the BigMLDataProvider module
public namespace BigMLDataProvider {
    #! Contains constants for the BigML data pipeline processors app
    public namespace BigMLApp {
        #! The application name — must match the TS app name exactly
        public const AppName = "BigMl";
        #! Logo SVG data
        public const BigMLLogo = File::readTextFile(get_script_dir() + "/bigml-logo.svg");
    }

    #! BigML prediction event hashdecl
    /** @since %BigMLDataProvider 1.0
    */
    public hashdecl BigMLPredictionEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-predict";
        #! The prediction result; the type depends on the model's objective field
        auto prediction;
        #! The confidence score for the prediction (0.0 to 1.0)
        float confidence;
        #! The name of the objective field that was predicted
        string objective_field;
        #! The BigML resource ID of the prediction
        string resource;
        #! The original input values sent to the model
        hash<auto> record_values;
    }

    #! BigML anomaly score event hashdecl
    /** @since %BigMLDataProvider 1.0
    */
    public hashdecl BigMLAnomalyScoreEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-anomaly-score";
        #! The anomaly score from 0.0 (normal) to 1.0 (highly anomalous)
        float anomaly_score;
        #! True if the anomaly score met or exceeded the configured threshold
        bool is_anomaly;
        #! The BigML resource ID of the anomaly score
        string resource;
        #! The original input values sent to the anomaly detector
        hash<auto> record_values;
    }

    #! BigML centroid event hashdecl
    /** @since %BigMLDataProvider 1.0
    */
    public hashdecl BigMLCentroidEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-centroid";
        #! The name of the cluster this record was assigned to
        string centroid_name;
        #! The internal ID of the centroid
        string centroid_id;
        #! The distance from the record to the centroid center
        float distance;
        #! The BigML resource ID of the centroid
        string resource;
        #! The original input values sent to the cluster model
        hash<auto> record_values;
    }

    #! BigML topic distribution event hashdecl
    /** @since %BigMLDataProvider 1.0
    */
    public hashdecl BigMLTopicDistributionEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-topic-distribution";
        #! The topic probability distribution; each entry contains topic name and probability
        list<auto> topic_distribution;
        #! The BigML resource ID of the topic distribution
        string resource;
        #! The original input values sent to the topic model
        hash<auto> record_values;
    }

    #! BigML train-and-predict event hashdecl
    /** Emitted by the train-and-predict processor; contains prediction results that vary
        by model type along with the trained model's resource ID for potential reuse.

        @since %BigMLDataProvider 1.0
    */
    public hashdecl BigMLTrainAndPredictEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-train-and-predict";
        #! The model type that was trained (model, ensemble, anomaly, cluster, linearregression, logisticregression, timeseries, pca)
        string model_type;
        #! The BigML resource ID of the trained model (can be reused with predict processor)
        string model_resource;
        #! The prediction result (for model/ensemble/linearregression/logisticregression types)
        auto prediction;
        #! The confidence score for the prediction (for model/ensemble types)
        *float confidence;
        #! The name of the objective field (for model/ensemble/linearregression/logisticregression types)
        *string objective_field;
        #! The anomaly score from 0.0 to 1.0 (for anomaly type)
        *float anomaly_score;
        #! The name of the assigned cluster (for cluster type)
        *string centroid_name;
        #! The internal ID of the assigned centroid (for cluster type)
        *string centroid_id;
        #! The distance from the record to the centroid (for cluster type)
        *float distance;
        #! The probability of the predicted class (for logisticregression type)
        *float probability;
        #! Per-class probabilities (for logisticregression type)
        *hash<auto> probabilities;
        #! The projection results (for pca type)
        *hash<auto> projection;
        #! The forecast results (for timeseries type)
        *hash<auto> forecast;
        #! The BigML resource ID of the individual prediction/score/centroid result
        string resource;
        #! The original input values used for prediction
        hash<auto> record_values;
    }

    #! BigML projection event hashdecl
    /** Emitted by the projection processor when using a BigML PCA model
        to reduce dimensionality of input records.

        @since %BigMLDataProvider 1.1
    */
    public hashdecl BigMLProjectionEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-projection";
        #! The projected values from PCA (component values)
        hash<auto> projection;
        #! The BigML resource ID of the projection
        string resource;
        #! The original input values sent to the PCA model
        hash<auto> record_values;
    }

    #! BigML linear regression event hashdecl
    /** Emitted by the linear regression processor when using a BigML
        linear regression model for predictions.

        @since %BigMLDataProvider 1.1
    */
    public hashdecl BigMLLinearRegressionEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-linear-regression";
        #! The predicted value
        auto prediction;
        #! The confidence score for the prediction (0.0 to 1.0)
        float confidence;
        #! The name of the objective field that was predicted
        string objective_field;
        #! The BigML resource ID of the prediction
        string resource;
        #! The original input values sent to the model
        hash<auto> record_values;
    }

    #! BigML forecast event hashdecl
    /** Emitted by the forecast processor when using a BigML time series
        model for time series forecasting.

        @since %BigMLDataProvider 1.1
    */
    public hashdecl BigMLForecastEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-forecast";
        #! The forecast results keyed by field name; each contains point forecasts
        #! and confidence intervals
        hash<auto> forecast;
        #! The BigML resource ID of the forecast
        string resource;
        #! The original input values sent to the time series model
        hash<auto> record_values;
    }

    #! BigML logistic regression event hashdecl
    /** Emitted by the logistic regression processor when using a BigML
        logistic regression model for classification.

        @since %BigMLDataProvider 1.1
    */
    public hashdecl BigMLLogisticRegressionEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-logistic-regression";
        #! The predicted class
        auto prediction;
        #! The probability of the predicted class (0.0 to 1.0)
        float probability;
        #! Per-class probabilities keyed by class name
        hash<auto> probabilities;
        #! The name of the objective field that was predicted
        string objective_field;
        #! The BigML resource ID of the prediction
        string resource;
        #! The original input values sent to the model
        hash<auto> record_values;
    }

    #! BigML association set event hashdecl
    /** Emitted by the association set processor when using a BigML
        association model for market basket analysis / association rule matching.

        @since %BigMLDataProvider 1.1
    */
    public hashdecl BigMLAssociationSetEventInfo {
        #! The type of analysis that produced this result
        string event_type = "bigml-association-set";
        #! The matching association rules with confidence and support scores
        list<auto> rules;
        #! The BigML resource ID of the association set
        string resource;
        #! The original input values sent to the association model
        hash<auto> record_values;
    }
}
