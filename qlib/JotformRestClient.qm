# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) ConnectionProvider >= 1.4

module JotformRestClient {
    version = "1.0";
    desc = "User module for calling JotForm REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("jotform", JotformRestConnection::ConnectionScheme);
    };
}

/** @mainpage JotformRestClient Module

    @tableofcontents

    @section jotformrestclientintro JotformRestClient Introduction

    The %JotformRestClient module provides an API for calling JotForm's REST API services.

    To use this module, use \c "%requires JotformRestClient" in your code.

    All the public symbols in the module are defined in the JotformRestClient namespace.

    The main classes are:
    - @ref JotformRestClient::JotformRestClient "JotformRestClient":
      this class provides the REST client API for communication with the JotForm API;
      it handles authentication via API key
    - @ref JotformRestClient::JotformRestConnection "JotformRestConnection":
      provides a connection object to JotForm services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires JotformRestClient

JotformRestClient jotform({"apikey": ENV.JOTFORM_TOKEN});
hash<auto> result = jotform.get("/user");
printf("User: %s <%s>\n", result.body.content.name, result.body.content.email);
    @endcode

    @section jotformrestclientrelnotes Release Notes

    @subsection jotformrestclientv1_0 JotformRestClient v1.0
    - the initial version of the %JotformRestClient module
*/

#! the JotformRestClient namespace contains all the objects in the JotformRestClient module
public namespace JotformRestClient {

#! This class provides the REST client API for communication with JotForm servers
/** JotForm uses a REST API. This client wraps RestClient to handle API key authentication.

    Authentication is done via API key passed in the APIKEY header.

    @par API Domains:
    - Standard: https://api.jotform.com
    - EU: https://eu-api.jotform.com (for GDPR compliance)
    - HIPAA: https://hipaa-api.jotform.com (for healthcare data)
*/
public class JotformRestClient inherits RestClient::RestClient {
    public {
        #! Default JotForm API domain
        const DefaultApiDomain = "api.jotform.com";

        #! API domain options for dropdown
        const ApiDomains = {
            "api.jotform.com": "Standard (Global)",
            "eu-api.jotform.com": "European Union (EU)",
            "hipaa-api.jotform.com": "HIPAA Compliant",
        };

        #! Default "data" option value
        const DefaultData = "json";

        #! Default JotForm ping method
        const DefaultPingMethod = "GET";

        #! Default JotForm ping path
        const DefaultPingPath = "/user";

        #! Default JotForm ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
JotformRestClient jotform({"apikey": "your-api-key"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the JotForm API key (required)
        - \c api_domain: the API domain to use (default: api.jotform.com)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(JotformRestClient::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! returns options for @ref JotformRestClient::JotformRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        # Validate and build URL from api_domain option
        string domain = opts.api_domain ?? DefaultApiDomain;
        if (!ApiDomains.hasKey(domain)) {
            throw "JOTFORM-ERROR", sprintf("invalid api_domain %y; allowed values: %y", domain, keys ApiDomains);
        }
        rv.url = sprintf("https://%s", domain);
        # Validate apikey is provided
        if (!opts.apikey) {
            throw "JOTFORM-ERROR", "missing required option 'apikey' (JotForm API key)";
        }
        # Set API key header authentication
        rv.headers.APIKEY = opts.apikey;
        # Remove apikey from opts so RestClient doesn't try to use it
        remove rv.apikey;
        # Remove api_domain from options as it's not a RestClient option
        remove rv.api_domain;
        return rv;
    }
}

#! Class for JotForm REST connections; returns @ref JotformRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c apikey: the JotForm API key
    - \c api_domain: the API domain to use (default: api.jotform.com)

    @see @ref JotformRestClient::JotformRestClient::constructor() for more information on the above options
*/
public class JotformRestConnection inherits RestClient::RestConnection {
    public {
        #! Default JotForm API URL
        const DefaultConnectionUrl = "jotform://api.jotform.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "JotForm REST Connection",
            "short_desc": "A connection to the JotForm REST API",
            "desc": "A connection to the JotForm REST API for form and submission management.\n\n"
                "**To obtain your API key:**\n"
                "1. Log in to your JotForm account\n"
                "2. Go to Settings > API\n"
                "3. Click 'Create New Key' or copy your existing key\n\n"
                "**Domain Selection:**\n"
                "- **Standard**: For global users (api.jotform.com)\n"
                "- **EU**: For European Union data residency/GDPR compliance (eu-api.jotform.com)\n"
                "- **HIPAA**: For HIPAA-compliant healthcare data (hipaa-api.jotform.com)",
            "cls": Class::forName("JotformRestConnection"),
            "auto_url": True,
            "schemes": {
                "jotform": True,
            },
            "base_scheme_map": {
                "https": "jotform",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": JotformRestClient::DefaultData,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "JotForm API key for authentication",
                    "type": "string",
                    "desc": "The JotForm API key for authentication.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your JotForm account at https://www.jotform.com\n"
                        "2. Go to Settings (gear icon) > API\n"
                        "3. Click 'Create New Key' or copy your existing key\n\n"
                        "**Note:** Keep your API key secure and never share it publicly.",
                    "sensitive": True,
                    "preselected": True,
                },
                "api_domain": <ConnectionOptionInfo>{
                    "display_name": "API Domain",
                    "short_desc": "JotForm API domain/region",
                    "type": "string",
                    "desc": "Select the JotForm API domain based on your account location or compliance requirements:\n\n"
                        "- **Standard**: For global users (default)\n"
                        "- **EU**: For European Union data residency (GDPR compliance)\n"
                        "- **HIPAA**: For HIPAA-compliant healthcare data",
                    "default_value": JotformRestClient::DefaultApiDomain,
                    "preselected": True,
                    "allowed_values_creatable": True,
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "api.jotform.com",
                            "display_name": "Standard (Global)",
                            "short_desc": "Standard JotForm API",
                            "desc": "Standard JotForm API for global users - api.jotform.com",
                        },
                        <AllowedValueInfo>{
                            "value": "eu-api.jotform.com",
                            "display_name": "European Union (EU)",
                            "short_desc": "EU-based API for GDPR",
                            "desc": "EU-based API for GDPR compliance - eu-api.jotform.com",
                        },
                        <AllowedValueInfo>{
                            "value": "hipaa-api.jotform.com",
                            "display_name": "HIPAA Compliant",
                            "short_desc": "HIPAA-compliant API",
                            "desc": "HIPAA-compliant API for healthcare data - hipaa-api.jotform.com",
                        },
                    ),
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": JotformRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": JotformRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": JotformRestClient::DefaultPingPath,
                },
            },
            "required_options": "apikey,api_domain",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your API Key",
                    "intent": "info",
                    "content": "1. Log in to your JotForm account\n"
                        "2. Go to [Account > API](https://www.jotform.com/myaccount/api)\n"
                        "3. Click **Create New Key**\n"
                        "4. Label your key for easy identification\n"
                        "5. Set **Full Access** permission for read/write operations, or **Read Access** "
                            "for read-only\n\n"
                        "**Note:** Keep your API key secure and never share it publicly.",
                },
                <UiMessageInfo>{
                    "title": "Selecting the Right API Domain",
                    "intent": "info",
                    "content": "Choose your API domain based on your data residency requirements:\n\n"
                        "- **Standard (api.jotform.com)**: Default for most users worldwide\n"
                        "- **EU (eu-api.jotform.com)**: For European Union data residency and GDPR "
                            "compliance\n"
                        "- **HIPAA (hipaa-api.jotform.com)**: For HIPAA-compliant healthcare data in "
                            "the US\n\n"
                        "Select the domain that matches where your JotForm account data is stored.",
                },
            ),
        };
    }

    #! creates the JotformRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the JotformRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(JotformRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref JotformRestConnection::constructor()
    /** Constructs the connection URL from the api_domain option
    */
    private static hash<auto> getConfig(hash<auto> config) {
        # Get api_domain from options, default to standard domain
        string domain = config.opts.api_domain ?? JotformRestClient::DefaultApiDomain;
        # Build URL from domain: jotform://api.jotform.com
        string url = "jotform://" + domain;
        return config + {
            "url": url,
        };
    }

    #! returns \c "jotform"
    string getType() {
        return "jotform";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the @ref getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        return "JotForm";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the JotformDataProvider and creates the data provider
        # object dynamically
        load_module("JotformDataProvider");
        return create_object("JotformDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    /** The closure or call reference must have the following signature:
        <tt>update_options(hash<auto> options)</tt>
    */
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        # update the URL immediately if necessary
        if (update_options && url != DefaultConnectionUrl) {
            # NOTE: do not update the URL or real URL values here, or the external update will fail, because it will
            # believe that no changes are necessary
            doUpdateOptions(self, {
                "url": DefaultConnectionUrl,
            });
        }
    }

    #! returns a @ref JotformRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref JotformRestClient object
    */
    private JotformRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new JotformRestClient(getConnectionOptions(), !connect);
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
