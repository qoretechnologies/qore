%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) JinaRestClient
%requires RestClientIo
%requires(reexport) RestSchemaActions
%requires json

module JinaDataProvider {
    version = "1.1";
    desc = "user module providing Jina AI search and content processing actions";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new JinaDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": JinaDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Jina AI",
            "short_desc": "Search, embed, rerank, and classify content with Jina AI",
            "desc": "Use [Jina AI](https://jina.ai) to prepare content for search and improve "
                "retrieval quality.\n\n"
                "- Create multilingual and multimodal embeddings.\n"
                "- Rank search results and classify business content.\n"
                "- Process large document collections with batch embeddings.\n"
                "- Read web pages and search for relevant sources.\n"
                "- Inspect model capabilities and manage reusable classifiers.",
            "scheme": "jina",
            "logo": Priv::JinaLogo,
            "logo_file_name": "jina-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        (JinaSchema::getActionSet()).registerActions(JinaDataProvider::AppName);

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "action": "read-url",
            "path": "/read-url",
            "display_name": "Read Web Page or Document",
            "short_desc": "Convert web pages, HTML, PDF, and Office files into usable content",
            "desc": "Extract content from a `url`, raw `html`, or a document `file` for search and analysis. Select `region` for EU processing, filter page elements, and choose how content and links are returned.",
            "action_code": DPAT_API,
            "groups": ("Reader",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(JinaReaderRequestDataType::Fields),
            "output_type": JinaReaderResponseDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "action": "search-web",
            "path": "/search-web",
            "display_name": "Search the Web",
            "short_desc": "Find relevant web sources and retrieve their content",
            "desc": "Search for `q` and return source URLs, descriptions, and readable content. Set `respond_with` to `no-content` for fast result metadata, or use content extraction options to prepare sources for analysis.",
            "action_code": DPAT_API,
            "groups": ("Search",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(JinaSearchRequestDataType::Fields),
            "output_type": JinaSearchResponseDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "action": "segment-text",
            "path": "/segment-text",
            "display_name": "Segment Text",
            "short_desc": "Count tokens and split text into manageable chunks",
            "desc": "Prepare long documents for embeddings or language models by splitting `content` into chunks. Request token IDs when needed and use `head` or `tail` to select part of the text.",
            "action_code": DPAT_API,
            "groups": ("Text Processing",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(JinaSegmentRequestDataType::Fields),
            "output_type": JinaSegmentResponseDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "action": "chat",
            "path": "/chat",
            "display_name": "Chat with Vision Model",
            "short_desc": "Answer questions about text and images with Jina OCR",
            "desc": "Generate a completed answer from conversation `messages`, including image content. **Experimental:** Jina does not guarantee production availability of this endpoint.",
            "action_code": DPAT_API,
            "groups": ("Vision",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(JinaChatRequestDataType::Fields),
            "output_type": JinaChatResponseDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "action": "deep-search",
            "path": "/deep-search",
            "display_name": "Deep Search",
            "short_desc": "Research a question across web sources and return a grounded answer",
            "desc": "Research a question in `messages` using web search and source reading. Control `budget_tokens` and `reasoning_effort` to manage cost and latency. Use `response_format` for structured answers or fact-checking. **Long requests:** this action returns a completed response and may reach the service timeout; reduce the research budget when necessary.",
            "action_code": DPAT_API,
            "groups": ("Search",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(JinaDeepSearchRequestDataType::Fields),
            "output_type": JinaChatResponseDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "action": "download-batch-output",
            "path": "/download-batch-output",
            "display_name": "Download Batch Output",
            "short_desc": "Download and parse completed batch embeddings",
            "desc": "Download the JSONL output for `batch_id` as an ordered list of records. Each record retains its `custom_id` for matching embeddings to the original documents.",
            "action_code": DPAT_API,
            "groups": ("Batch Embeddings",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(JinaBatchDownloadRequestDataType::Fields),
            "output_type": JinaBatchDownloadResponseDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "action": "download-batch-errors",
            "path": "/download-batch-errors",
            "display_name": "Download Batch Errors",
            "short_desc": "Download and parse errors from batch embedding jobs",
            "desc": "Inspect failed records for `batch_id` and use their `custom_id` to correct the source data before resubmitting it.",
            "action_code": DPAT_API,
            "groups": ("Batch Embeddings",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(JinaBatchDownloadRequestDataType::Fields),
            "output_type": JinaBatchDownloadResponseDataType,
        });

    };
}

/** @mainpage JinaDataProvider Module

    @tableofcontents

    @section jinadataproviderintro JinaDataProvider Introduction

    The %JinaDataProvider module provides 19 actions for [Jina AI](https://jina.ai) search,
    content extraction, classification, and multimodal inference. The existing \c create-embeddings and
    \c rerank action IDs and provider classes remain available.

    |!Actions|!Use
    |create-embeddings, rerank|Multilingual, multimodal, sparse, and multi-vector retrieval
    |classify, train-classifier, list-classifiers, delete-classifier|Zero-shot classification and reusable classifiers
    |list-models, get-model|Model capabilities, context limits, pricing, and model dropdowns
    |create-batch-embeddings, list-batches, get-batch, cancel-batch|Asynchronous bulk embedding jobs
    |download-batch-output, download-batch-errors|Ordered JSONL result and error records
    |read-url, search-web|Web pages, HTML, PDF/Office documents, and web search; global or EU processing
    |segment-text|Token counting, token IDs, and semantic text chunks
    |chat|Experimental Jina vision-language inference
    |deep-search|Web research, source citations, and structured grounding answers

    Twelve actions derive their contracts from the pinned vendor OpenAPI schema. The remaining seven
    use documented contracts not described completely by that schema. The schema is installed with the
    module; requests never download it. Model dropdowns use the live model catalog and return the short
    IDs expected by inference endpoints. Classifier and batch dropdowns accept IDs from earlier workflow
    steps, including IDs outside the most recent listing.

    @par Example: classify incoming support requests
    @code{.py}
%modern
%requires JinaDataProvider
JinaDataProvider provider({"apikey": ENV.JINAAI_APIKEY});
hash<auto> result = provider.getChildProvider("classify").doRequest({
    "model": "jina-embeddings-v3",
    "input": ("My package has not arrived",),
    "labels": ("delivery", "billing", "technical support"),
});
printf("Route to: %s\n", result.data[0].prediction);
    @endcode

    @par Example: prepare a document for indexing
    @code{.py}
hash<auto> page = provider.getChildProvider("read-url").doRequest({
    "url": "https://example.com",
    "region": "global",
    "return_format": "markdown",
});
hash<auto> chunks = provider.getChildProvider("segment-text").doRequest({
    "content": page.data.content,
    "return_chunks": True,
    "max_chunk_length": 1000,
});
hash<auto> vectors = provider.getChildProvider("create-embeddings").doRequest({
    "model": "jina-embeddings-v3",
    "input": chunks.chunks,
    "task": "retrieval.passage",
});
    @endcode

    @note Embedding output formats are selected with \c embedding_type. The existing provider also
    accepts \c encoding_format as an alias, translating it to the API's actual field. Conflicting aliases
    are rejected. A model's own schema validates its supported tasks, dimensions, and input modalities.

    @note Batch processing is asynchronous. Supply \c webhook_url to receive a completion notification
    and confirm the status with \c get-batch before downloading. Download URLs expire after 24 hours.
    Inline batch records must contain \c custom_id and a \c body object containing \c input. The upstream
    schema's flat input example is rejected by the batch worker after submission. The download actions
    return parsed JSONL records, retaining every record's \c custom_id.

    @par Live verification
    Set \c JINAAI_APIKEY or pass \c --connection to the module tests. The default live suite exercises
    catalog lookup, inference, Reader, Search, Segmenter, vision chat, and batch submission. Set
    \c JINA_TEST_DEEPSEARCH for the bounded research test and \c JINA_BATCH_ID for a completed batch
    created by the test. Set \c JINA_KEEP_BATCH when submitting a fixture for later download; otherwise
    the test cancels its unfinished batch. Neither test waits for a batch to complete. Set \c JINA_TEST_CLASSIFIERS for
    the classifier lifecycle test, which verifies training, listing, prediction, updating, and deletion,
    and deletes its own classifier on exit if an assertion fails.

    During live verification on September 7-8, 2026, public classifier listing and training returned
    HTTP 500 for documented requests, including direct HTTP requests without Qore. The same API key
    successfully listed classifiers through Jina's dashboard API and performed zero-shot classification.
    The public API's generic error does not reveal the internal classifier failure; its request IDs are
    needed to investigate Jina's server logs.

    Minimal batches for both supported text models failed because Jina's worker passed an unexpected
    \c batch_size argument to \c process_batch_inputs(). The submitted requests contained no such
    argument or optional processing fields. This internal call-signature failure prevents live
    completed-output verification. The documented experimental EU Reader and Search hosts also returned
    DNS NXDOMAIN. These service failures are propagated; no alternate endpoint is substituted.

    @par Schema maintenance
    Re-import with \c tools/rest-schema-import.qr using the module's \c jina-import.yaml spec, then run
    the drift and action tests before committing. The provenance records the original download's SHA-256,
    byte size, operation counts, and version. Jina alternates the listing operation ID between GET and
    POST spellings, so this one action is pinned by method and path; the other operation IDs are checked.

    @section JinaDataProviderRelnotes Release Notes

    @subsection JinaDataProviderv1_1 JinaDataProvider v1.1
    - orders required inputs before optional controls, provides readable model and image-retention choices,
      and formats API literals consistently in all presentation catalogs
    - declares the JSON dependency directly so source loading can resolve the batch JSONL parser
    - expands the app from two to 19 actions with schema-derived inference and batch forms
    - adds live model and account dropdowns, finite choices, sensitive fields, and input validation
    - preserves embedding/reranking providers and fixes the legacy embedding encoding option
    - adds offline wire tests and optional live API integration tests

    @subsection JinaDataProviderv1_0 JinaDataProvider v1.0
    - the initial version of the %JinaDataProvider module
*/

#! contains all public definitions in the JinaDataProvider module
public namespace JinaDataProvider {
#! Jina AI application name
public const AppName = "JinaAi";
}

#! App logo loaded from file
namespace Priv {
const JinaLogo = File::readTextFile(get_script_dir() + "/jina-logo.svg");
}
