%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) JinaRestClient
%requires RestClientIo

module JinaDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Jina AI embeddings + rerank";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new JinaDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": JinaDataProvider::AppName,
            "display_name": "Jina AI",
            "short_desc": "Jina AI embeddings and reranking for multilingual semantic search",
            "desc": "Provides access to [Jina AI](https://jina.ai) embedding and reranking "
                "services for production semantic search and RAG.\n\n"
                "**Common use cases**:\n"
                "- **Multilingual embeddings** with `jina-embeddings-v3` (89+ languages)\n"
                "- **Cross-encoder reranking** with `jina-reranker-v2-base-multilingual` "
                "or late-interaction `jina-colbert-v2`\n"
                "- **Closes the cloud-reranker gap** alongside Voyage in `QoreRagUtils`",
            "scheme": "jina",
            "logo": JinaLogo,
            "logo_file_name": "jina-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "path": "/create-embeddings",
            "action": "create-embeddings",
            "display_name": "Create Embeddings",
            "short_desc": "Generate embedding vectors from a Jina AI embedding model",
            "desc": "Converts text inputs into embedding vectors via Jina's `/v1/embeddings` "
                "endpoint.  Supports the task-aware `task` parameter for query / passage / "
                "classification / clustering / separation tasks.",
            "action_code": DPAT_API,
            "groups": ("Embeddings",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                JinaEmbeddingRequestDataType::Fields{"input", "model",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                JinaEmbeddingRequestDataType::Fields{"task", "dimensions",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                JinaEmbeddingRequestDataType::Fields - (
                    "input", "model", "task", "dimensions",
                )
            ),
            "output_type": JinaEmbeddingDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JinaDataProvider::AppName,
            "path": "/rerank",
            "action": "rerank",
            "display_name": "Rerank Documents",
            "short_desc": "Rerank candidate documents against a query for RAG retrieval",
            "desc": "Reranks a list of candidate documents against a user query using a "
                "Jina cross-encoder or late-interaction reranker.  Returns documents "
                "sorted by relevance score with the top `top_n` results.",
            "action_code": DPAT_API,
            "groups": ("Rerank",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                JinaRerankRequestDataType::Fields{"query", "documents", "model",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                JinaRerankRequestDataType::Fields{"top_n",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                JinaRerankRequestDataType::Fields - (
                    "query", "documents", "model", "top_n",
                )
            ),
            "output_type": JinaRerankDataProvider::ResponseType,
        });
    };
}

/** @mainpage JinaDataProvider Module

    @tableofcontents

    @section jinadataproviderintro JinaDataProvider Introduction

    The %JinaDataProvider module provides a data provider API for
    [Jina AI](https://jina.ai) embeddings and reranking services.

    The following data providers are exposed:
    - @ref JinaDataProvider::JinaDataProvider "JinaDataProvider" — root
    - @ref JinaDataProvider::JinaEmbeddingDataProvider "JinaEmbeddingDataProvider" — embeddings
    - @ref JinaDataProvider::JinaRerankDataProvider "JinaRerankDataProvider" — reranking

    @section JinaDataProviderRelnotes Release Notes

    @subsection JinaDataProviderv1_0 JinaDataProvider v1.0
    - the initial version of the %JinaDataProvider module
*/

#! contains all public definitions in the JinaDataProvider module
public namespace JinaDataProvider {
#! Jina AI application name
public const AppName = "JinaAi";
}

#! App logo loaded from file
public const JinaLogo = File::readTextFile(get_script_dir() + "/jina-logo.svg");
