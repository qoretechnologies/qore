        "connection.SmluYVJlc3RDbGllbnQ.scheme.SmluYVJlc3RDb25uZWN0aW9u.option.cmVyYW5rLW1vZGVs.allowed_values.c3RyaW5nOmppbmEtcmVyYW5rZXItdjMuNQ.display_name": {
