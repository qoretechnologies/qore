        "connection.SmluYVJlc3RDbGllbnQ.scheme.SmluYVJlc3RDb25uZWN0aW9u.option.ZW1iZWRkaW5nLW1vZGVs.desc": {
          "source": "The Jina AI embedding model used by embedding clients when this connection is selected for embeddings; sent as the `model` parameter to the `/embeddings` endpoint.\n\nExample values: `jina-embeddings-v3` (multilingual, task-aware; the default), `jina-embeddings-v2-base-en` (English-only v2), `jina-embeddings-v2-base-code` (code-specialized)",
          "message": "Vstupný model Jina AI pre vektorizáciu, ktorý sa používa klientmi vektorizácie, keď je toto spojenie vybrané pre vektorizáciu; odoslaný ako parameter `model` na koncový bod `/embeddings`.\n\nPríklad hodnôt: `jina-embeddings-v3` (multilungválny, úloha-vedomý; predvolený), `jina-embeddings-v2-base-en` (len angličtina v2), `jina-embeddings-v2-base-code` (kód-specializovaný)"
        },
        "connection.SmluYVJlc3RDbGllbnQ.scheme.SmluYVJlc3RDb25uZWN0aW9u.option.ZW1iZWRkaW5nLW1vZGVs.display_name": {
          "source": "Embedding Model",
          "message": "Model pre vektorizáciu"
        },
        "connection.SmluYVJlc3RDbGllbnQ.scheme.SmluYVJlc3RDb25uZWN0aW9u.option.ZW1iZWRkaW5nLW1vZGVs.short_desc": {
          "source": "Jina AI embedding model name",
          "message": "Názov modelu Jina AI pre vektorizáciu"
        },
