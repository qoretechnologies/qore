# minimum required Qore version
%requires qore >= 2.0

%requires(reexport) Logger
%requires reflection

%modern
%no-debugging

module DebugUtil {
    version = "0.2";
    desc = "user module providing common debug stuff";
    author = "Tomas Mandys <tomas.mandys@qoretechnologies.org>";
    url = "http://qoretechnologies.org";
    license = "MIT";
}

/** @mainpage DebugUtil Module

    @tableofcontents

    @section debugutilintro Introduction to the DebugUtil Module

    The %DebugUtil module provides common functionality for implementing debugger utilities

    @subsection du_v0_2 v0.2
    - added string enums: @ref DebugUtil::DebugResponseType, @ref DebugUtil::DebugRunStateName, @ref DebugUtil::DebugFlowName,
      @ref DebugUtil::DebugPolicyName, @ref DebugUtil::DebugEventCmd for type-safe debug protocol constants
    - added @ref DebugUtil::ResponseSync class for thread-safe single-response synchronization, matching responses by
      the unique ID of the command and waiting without a timeout
    - added @ref DebugUtil::AbstractDebugControl::describe() "AbstractDebugControl::describe()",
      @ref DebugUtil::AbstractDebugControl::describeChildren() "AbstractDebugControl::describeChildren()",
      @ref DebugUtil::AbstractDebugControl::getPath() "AbstractDebugControl::getPath()" and
      @ref DebugUtil::AbstractDebugControl::setPath() "AbstractDebugControl::setPath()" to show lists, hashes and
      objects as trees whose elements and members, also private ones, are read and changed on demand
    - added @ref DebugUtil::AbstractDebugControl::formatValue() "AbstractDebugControl::formatValue()" and
      @ref DebugUtil::AbstractDebugControl::formatTree() "AbstractDebugControl::formatTree()", which write values as
      the \c "%y" and \c "%Y" formats, but with @ref NOTHING and @ref NULL written as in %Qore, as they are shown in
      debuggers
    - added @ref DebugUtil::DebugOutputCapture "DebugOutputCapture", which captures the standard output and standard
      error of the process, so that the output of debugged programs can be sent to debugger clients, and the
      @ref DebugUtil::DebugEventCmd::Output "output" event

    @subsection du_v0_1_1 v0.1.1
    - fixed issues with debug logging
      (<a href="https://github.com/qoretechnologies/qore/issues/4635">issue 4635</a>)

    @subsection du_v0_1 v0.1
    - initial release
*/

#! the DebugUtil namespace contains all the definitions in the DebugUtil module
public namespace DebugUtil {
    #! Thread-safe single-response synchronization helper
    /**
        A thread that sends a command prepares to wait for the response with the command's unique ID, sends the
        command, and waits; the thread that receives the responses delivers each one, and only the response with the
        ID that is waited for is delivered.

        @par Example:
        @code{.py}
        ResponseSync sync();
        # sender thread:
        data.uid = uid;
        sync.prepare(uid);
        sendCommand(data);
        *auto result = sync.waitForResponse();

        # receiver thread:
        if (!sync.deliver(responseData)) {
            # not a response that is waited for
        }
        @endcode
    */
    public class ResponseSync {
        private {
            Mutex m();
            Condition cond();
            bool pending = False;
            #! the unique ID of the command whose response is waited for
            *string uid;
            auto responseData;
        }

        #! Prepare to wait for a response (call before sending the command)
        /** @param n_uid the unique ID of the command; only a response with this ID is delivered; if not given, any
            response is delivered
        */
        prepare(*string n_uid) {
            AutoLock al(m);
            pending = True;
            uid = n_uid;
            responseData = NOTHING;
        }

        #! Stops waiting for a response, for a command that was answered without being sent to the receiver
        cancel() {
            AutoLock al(m);
            pending = False;
            remove uid;
        }

        #! Waits for the response
        /** @param to an optional timeout; if not given, waits until the response is delivered

            @return the response, or @ref nothing if the timeout expired
        */
        *auto waitForResponse(*timeout to) {
            AutoLock al(m);
            if (!exists to) {
                while (pending) {
                    cond.wait(m);
                }
                return responseData;
            }
            date deadline = now_us() + milliseconds(to);
            while (pending) {
                int remaining = (deadline - now_us()).durationMilliseconds();
                if (remaining <= 0 || cond.wait(m, remaining)) {
                    if (pending) {
                        # timeout
                        pending = False;
                        remove uid;
                        return NOTHING;
                    }
                }
            }
            return responseData;
        }

        #! Delivers a response (called from the receiver thread)
        /** @return True if the response was delivered, False if no one waits for it
        */
        bool deliver(auto data) {
            AutoLock al(m);
            if (!pending || (exists uid && data.uid != uid)) {
                return False;
            }
            responseData = data;
            pending = False;
            remove uid;
            cond.signal();
            return True;
        }

        #! Check if a response is currently pending
        bool isPending() {
            AutoLock al(m);
            return pending;
        }
    }

    #! class supporting argument parsing for executing programs to debug
    /**
        When implementing a wrapper that executes a program whose name is passed on the command line, we can divide
        the arguments usually into 3 groups:
        - internal wrapper arguments
        - target program filename
        - program arguments

        The class supports argument parsing for such a case.

        Examples:
        @verbatim
            (   # GetOpt options
                'help': 'h,help',
                'verbose': 'v,verbose',
                'listen': 'l,listen=s@',
            );
            wrapper-prog -v -l xxx trg -v -l    # trg is the target program name
            wrapper-prog -v -h trg xxx          # trg is the target program name
            wrapper-prog -v --listen=xxx trg    # trg is the target program name
            wrapper-prog -v --listen xxx trg    # trg is the target program name
        @endverbatim
    **/
    public class WrapperGetOpt inherits GetOpt {
        #! create the object with the given @ref Qore::GetOpt "GetOpt" option hash
        public constructor(hash<auto> options) : GetOpt(options: options) {
        }

        #! Parses input arguments until a standalone argument is found.
        /**
            @param args @ref list of arguments passed to wrapper, typically ARGV
            @param wrp_args returns list of wrapper arguments
            @param pgm_name returns the target program filename; "" is considered a special file name (meaning \c stdin), NOTHING when no name provided
            @param pgm_args return @ref list of target program arguments

            @par Example:
            @code{.py}
            hash opts = (
                'help': 'h,help',
                'verbose': 'v,verbose',
                'listen': 'l,listen=s@',
            );
            WrapperGetOpt g(options: opts);
            list dargs;
            hash opt;
            *string fileName;
            g.split(ARGV, \dargs, \fileName, \ARGV);

            try {
                opt = g.parse2(arguments: \dargs);
            } catch (hash<ExceptionInfo> ex) {
                stderr.printf("%s: %s\n", ex.err, ex.desc);
                help(-1);
            }

            if (!exists fileName) {
                stderr.print("No input file\n");
                exit(-1);
            }
            @endcode
        **/
        public split(list<string> args, reference<list<string>> wrp_args, reference<*string> pgm_name,
                reference<list<string>> pgm_args) {
            pgm_name = NOTHING;
            wrp_args = new list<string>();
            pgm_args = new list<string>();
            while (args) {
                string s = shift args;
                push wrp_args, s;
                if (s !~ /^\-/ ) {
                    list<auto> a = wrp_args;
                    parse(\a);
                    if (a) {
                        # last arg is filename
                        pgm_name = s;
                        pop wrp_args;
                        break;
                    }
                } else if (s == '--') {
                    pgm_name = '';
                    pop wrp_args;
                    break;
                }
            }
            pgm_args = args;
        }
    }

    #! The HTTP header string for the %Qore debug protocol version
    public const QoreDebugWsProtocolHeader = "QoreDebugWsProtocol";

    #! The debug protocol version implemented
    public const QoreDebugProtocolVersion = "0.1";

    #! Debug protocol response/message type
    public enum DebugResponseType : string {
        #! Normal response to a command
        Response = "response",
        #! Error response
        Error = "error",
        #! Asynchronous event (interrupt, run, breakpoint change, etc.)
        Event = "event",
        #! Thread-specific response (sent to blocked debug thread)
        Thread = "thread",
    }

    #! Debug run state names (user-facing strings for run state control)
    public enum DebugRunStateName : string {
        #! Detach from debugging
        Detach = "detach",
        #! Continue running
        Run = "run",
        #! Step to next statement
        Step = "step",
        #! Step over (don't enter functions)
        StepOver = "stepover",
        #! Run until return from current function
        UntilReturn = "untilreturn",
    }

    #! Debug flow control names (user-facing strings for flow control)
    public enum DebugFlowName : string {
        #! No flow override
        None = "none",
        #! Force return from function
        Return = "return",
        #! Break out of loop
        Break = "break",
        #! Continue to next loop iteration
        Continue = "continue",
    }

    #! Breakpoint policy names
    public enum DebugPolicyName : string {
        #! No policy
        None = "none",
        #! Accept (whitelist) threads
        Accept = "accept",
        #! Reject (blacklist) threads
        Reject = "reject",
    }

    #! Debug event command names
    public enum DebugEventCmd : string {
        #! Program execution interrupted (breakpoint, step, etc.)
        Interrupt = "interrupt",
        #! Program resumed execution
        Run = "run",
        #! Breakpoint created/modified/deleted
        Breakpoint = "breakpoint",
        #! Welcome message on connection
        Welcome = "welcome",
        #! Output of the program; see DebugOutputCapture
        Output = "output",
    }

    #! base class for controlling debugging
    public class AbstractDebugControl inherits Logger::LoggerWrapper {
        public {
            #! the maximum number of characters of the text of a value in describe()
            const MaxValueTextSize = 256;
        }

        public {
            #! for debugging of debug library to see where exception is raised
            bool showFullException = False;

            #! maps run state name strings to Qore debug run state constants
            const runStateStrings = {
                DebugRunStateName::Detach: DebugDetach,
                DebugRunStateName::Run: DebugRun,
                DebugRunStateName::Step: DebugStep,
                DebugRunStateName::StepOver: DebugStepOver,
                DebugRunStateName::UntilReturn: DebugUntilReturn,
            };
            #! maps flow control name strings to Qore debug flow constants
            const flowStrings = {
                DebugFlowName::None: 0,
                DebugFlowName::Return: DebugFlowReturn,
                DebugFlowName::Break: DebugFlowBreak,
                DebugFlowName::Continue: DebugFlowContinue,
            };
            #! maps boolean name strings to boolean values
            const boolStrings = {
                "false": False,
                "true": True,
            };
            #! maps breakpoint policy name strings to Qore breakpoint policy constants
            const policyStrings = {
                DebugPolicyName::None: BreakpointPolicyNone,
                DebugPolicyName::Accept: BreakpointPolicyAccept,
                DebugPolicyName::Reject: BreakpointPolicyReject,
            };
        }

        constructor(*LoggerInterface logger) {
            setLogger(logger);
        }

        static public list<auto> enumFilter(softlist items, *string path) {
            if (path.size() == 0) {
                return items;
            }
            return map $1, items, AbstractDebugControl::evalCondition($1, path);
        }

        static public bool evalCondition(softstring value, *string cond) {
            if (!cond.val()) {
                return True;
            }
            if (cond =~ /^=/) {
                return substr(cond, 1) == value;
            } else {
                # default is matching prefix
                return bindex(value, cond) == 0;
            }
        }

        # make_json/yaml does not support object code etc. so we need somehow process values
        static public hash<auto> serialize(auto val) {
            auto v;
            switch (val.typeCode()) {
            case NT_NOTHING:
            case NT_NULL:
                break;
            case NT_INT:
            case NT_FLOAT:
            case NT_STRING:
            case NT_DATE:
            case NT_BOOLEAN:
            case NT_BINARY:
            case NT_NUMBER:
                v = val;
                break;
            case NT_LIST:
                v = ();
                foreach auto i in (val) {
                    push v, AbstractDebugControl::serialize(i);
                }
                break;
            case NT_HASH:
            case NT_OBJECT:
                v = hash();
                if (val.typeCode() == NT_OBJECT) {
                    v.class = val.className();
                }
                foreach string k in (keys val) {
                    if (val{k}.typeCode() == NT_OBJECT) {
                        v{k}.type = val{k}.className();
                        v{k}.value = sprintf("%Y", val{k});  # TODO: to avoid circular references between objects
                    } else {
                        v{k} = AbstractDebugControl::serialize(val{k});
                    }
                }
                break;
            default:
                # unsupported types, no value passed
            }
            hash<auto> sv.type = val.type();
            if (exists v) {
                sv.value = v;
            }
            return sv;
        }

        #! Returns a description of a value for a debugger client
        /** @param val the value

            @return a hash with the following keys:
            - \c type: the type of the value: the full type of a list or hash, as \c "hash<string, int>" or the name of
              a typed hash, and the class of an object
            - \c value: the value as text, at most @ref MaxValueTextSize characters; a summary for lists, hashes and
              objects
            - \c indexed: the number of elements of a list
            - \c named: the number of keys of a hash or of members of an object

            @see describeChildren()
        */
        #! Returns the text of a value for a debugger: as the \c "%y" format, but with @ref NOTHING and @ref NULL
        #! written as in %Qore
        /** The \c "%y" format writes YAML, where \c null is no value; in %Qore, @ref NOTHING (no value) and @ref NULL
            (an SQL null) are different values, which are easily confused

            @par Example:
            @code{.py}
string text = AbstractDebugControl::formatValue({"a": NOTHING, "b": NULL}); # {a: NOTHING, b: NULL}
            @endcode

            @since DebugUtil 0.2
        */
        static public string formatValue(auto val) {
            switch (val.typeCode()) {
                case NT_NOTHING:
                    return "NOTHING";
                case NT_NULL:
                    return "NULL";
                case NT_LIST:
                    return "[" + ((map AbstractDebugControl::formatValue($1), val) ?? ()).join(", ") + "]";
                case NT_HASH:
                    return "{" + ((map sprintf("%s: %s", $1.key, AbstractDebugControl::formatValue($1.value)),
                        val.pairIterator()) ?? ()).join(", ") + "}";
            }
            return sprintf("%y", val);
        }

        #! Returns the lines of a value for a debugger: as the \c "%Y" format, but with @ref NOTHING and @ref NULL
        #! written as in %Qore; see formatValue()
        /** @since DebugUtil 0.2
        */
        static public list<string> formatTree(auto val) {
            list<string> rv = ();
            switch (val.typeCode()) {
                case NT_HASH:
                    if (!val) {
                        break;
                    }
                    foreach hash<auto> i in (val.pairIterator()) {
                        if (AbstractDebugControl::isNonEmptyContainer(i.value)) {
                            push rv, i.key + ":";
                            rv += map "  " + $1, AbstractDebugControl::formatTree(i.value);
                        } else {
                            push rv, sprintf("%s: %s", i.key, AbstractDebugControl::formatValue(i.value));
                        }
                    }
                    return rv;
                case NT_LIST:
                    if (!val) {
                        break;
                    }
                    foreach auto e in (val) {
                        if (AbstractDebugControl::isNonEmptyContainer(e)) {
                            list<string> lines = AbstractDebugControl::formatTree(e);
                            # the first line of a hash follows the dash, as with "%Y"; a list starts on the next line
                            if (e.typeCode() == NT_HASH) {
                                push rv, "- " + shift lines;
                                rv += map "  " + $1, lines;
                            } else {
                                push rv, "-";
                                rv += map "  " + $1, lines;
                            }
                        } else {
                            push rv, "- " + AbstractDebugControl::formatValue(e);
                        }
                    }
                    return rv;
            }
            return (AbstractDebugControl::formatValue(val),);
        }

        #! Returns True if the value is a hash or a list with elements
        private static bool isNonEmptyContainer(auto val) {
            return (val.typeCode() == NT_HASH || val.typeCode() == NT_LIST) && val.size() > 0;
        }

        static public hash<auto> describe(auto val) {
            switch (val.typeCode()) {
                case NT_LIST:
                    return {"type": val.fullType(), "value": sprintf("list (%d)", val.size()), "indexed": val.size()};
                case NT_HASH: {
                    string t = val.fullType();
                    return {"type": t, "value": sprintf("%s (%d)", t, val.size()), "named": val.size()};
                }
                case NT_OBJECT: {
                    string cls = val.className();
                    return {"type": cls, "value": cls, "named": AbstractDebugControl::getMemberNames(val).size()};
                }
            }
            string text = AbstractDebugControl::formatValue(val);
            if (text.size() > MaxValueTextSize) {
                text = text.substr(0, MaxValueTextSize) + "...";
            }
            return {"type": val.type(), "value": text};
        }

        #! Returns descriptions of the elements of a list, the keys of a hash or the members of an object
        /** @param val the list, hash or object
            @param start the index of the first element, key or member that is returned
            @param count the maximum number of elements, keys or members that are returned; all are returned if not
            given

            @return a list of descriptions as returned by describe(), each with a \c name key, the text that the
            element, key or member is shown with, and a \c key key, the key of the element, key or member in a path
            (see getPath()); members of objects are given also if they are private

            @throw DEBUG-ERROR the value is not a list, hash or object
        */
        static public list<hash<auto>> describeChildren(auto val, int start = 0, *int count) {
            list<auto> child_keys;
            switch (val.typeCode()) {
                case NT_LIST:
                    int end = exists count ? min(val.size(), start + count) : val.size();
                    child_keys = start < end ? range(start, end) : ();
                    break;
                case NT_HASH:
                    child_keys = keys val;
                    break;
                case NT_OBJECT:
                    child_keys = AbstractDebugControl::getMemberNames(val);
                    break;
                default:
                    throw "DEBUG-ERROR", sprintf("a value of type %y has no elements", val.type());
            }
            if (val.typeCode() != NT_LIST) {
                child_keys = exists count ? child_keys[start..(start + count - 1)] : child_keys[start..];
            }
            return map AbstractDebugControl::describe(AbstractDebugControl::getChild(val, $1))
                + {"name": string($1), "key": $1}, child_keys;
        }

        #! Returns the value at the given path in a value
        /** @param val the value
            @param path the keys of the elements, hash keys or object members that lead to the value, as given by
            describeChildren()

            @return the value at the path

            @throw DEBUG-ERROR the path does not lead to a value
        */
        static public auto getPath(auto val, *list<auto> path) {
            foreach auto key in (path) {
                val = AbstractDebugControl::getChild(val, key);
            }
            return val;
        }

        #! Returns the given value with the value at the given path changed
        /** Lists and hashes are copied with the change; the members of objects are changed in the objects

            @param val the value
            @param path the keys of the elements, hash keys or object members that lead to the value to change, as
            given by describeChildren(); with an empty path, the new value is returned
            @param new_val the new value

            @return the value with the change

            @throw DEBUG-ERROR the path does not lead to a value
        */
        static public auto setPath(auto val, *list<auto> path, auto new_val) {
            if (!path) {
                return new_val;
            }
            auto key = shift path;
            auto child = AbstractDebugControl::setPath(AbstractDebugControl::getChild(val, key), path, new_val);
            switch (val.typeCode()) {
                case NT_LIST:
                    val[int(key)] = child;
                    break;
                case NT_HASH:
                    val{key} = child;
                    break;
                case NT_OBJECT: {
                    NormalMember member = AbstractDebugControl::getMember(val, key);
                    member.setValue(val, child);
                    break;
                }
            }
            return val;
        }

        #! Returns the names of the members of an object, also of private members and of members of parent classes
        static public list<string> getMemberNames(object obj) {
            hash<string, bool> seen = {};
            list<string> rv = ();
            foreach Class cls in (Class::getClass(obj).getClassHierarchy()) {
                foreach AbstractClassMember member in (cls.getMembers()) {
                    if (member instanceof NormalMember && !seen{member.getName()}) {
                        seen{member.getName()} = True;
                        push rv, member.getName();
                    }
                }
            }
            return rv;
        }

        #! Returns the element of a list, the value of a hash key or the value of a member of an object
        /** @throw DEBUG-ERROR the value has no such element, key or member
        */
        static auto getChild(auto val, auto key) {
            switch (val.typeCode()) {
                case NT_LIST: {
                    int i = int(key);
                    if (i < 0 || i >= val.size()) {
                        throw "DEBUG-ERROR", sprintf("the list has no element %d", i);
                    }
                    return val[i];
                }
                case NT_HASH:
                    if (!val.hasKey(key)) {
                        throw "DEBUG-ERROR", sprintf("the hash has no key %y", key);
                    }
                    return val{key};
                case NT_OBJECT:
                    return AbstractDebugControl::getMember(val, key).getValue(val);
            }
            throw "DEBUG-ERROR", sprintf("a value of type %y has no elements", val.type());
        }

        #! Returns the member of the class of an object or of its parent classes with the given name
        /** @throw DEBUG-ERROR the object has no member with the name
        */
        private static NormalMember getMember(object obj, string name) {
            foreach Class cls in (Class::getClass(obj).getClassHierarchy()) {
                foreach AbstractClassMember member in (cls.getMembers()) {
                    if (member instanceof NormalMember && member.getName() == name) {
                        return cast<NormalMember>(member);
                    }
                }
            }
            throw "DEBUG-ERROR", sprintf("an object of class %y has no member %y", obj.className(), name);
        }

        static public auto unserialize(auto sv) {
            if (sv.typeCode() == NT_HASH) {
                switch (TypeNameMap{sv.type}) {
                case NT_NOTHING:
                    return NOTHING;
                case NT_NULL:
                    return NULL;
                case NT_LIST:
                    list<auto> ret;
                    foreach auto i in (sv.value) {
                        push ret, AbstractDebugControl::unserialize(i);
                    }
                    return ret;
                case NT_HASH:
                    hash<auto> ret;
                    foreach string k in (keys sv.value) {
                        ret{k} = AbstractDebugControl::unserialize(sv.value{k});
                    }
                    return ret;
                case NT_INT:
                case NT_FLOAT:
                case NT_STRING:
                case NT_DATE:
                case NT_BOOLEAN:
                case NT_BINARY:
                case NT_NUMBER:
                    return sv.value;
                default:
                    throw "DEBUG-ERROR", sprintf("Cannot assign value of type: %y", sv.type);
                }
            } else {
                return sv;
            }
        }

    }


    #! Captures the standard output and standard error of the process, for sending the output of debugged programs
    /** stdout and stderr are redirected to pipes; a thread for each pipe passes the output that it reads to a
        callback, in complete UTF-8 characters, and can also write it to the original stdout or stderr.

        Marks are written to the pipes to find the end of the output that was written before a point in time, also
        when processes that a program started keep the pipes open: the mark is a random value, which the output does
        not contain, followed by a command, and it is written with one write, which is atomic for a pipe:
        - flush(): the flush callback is called for each pipe after the output before the mark
        - flushAndWait(): returns when the output before the mark has been passed to the output callback
        - stop(): the threads end after the output before the mark

        Not supported on Windows, where start() returns @ref False

        @par Example:
        @code{.py}
DebugOutputCapture capture(sub (string category, string output) {
    send_to_client(category, output);
});
capture.start();
on_exit capture.stop();
        @endcode

        @since DebugUtil 0.2
    */
    public class DebugOutputCapture {
        public {
            #! the beginning of the marks in the output
            const MarkPrefix = "\0qore-debug-output-mark-";
            #! the command of a mark after which the flush callback is called
            const MarkFlush = "F";
            #! the command of a mark that flushAndWait() waits for
            const MarkWait = "W";
            #! the command of a mark that ends the threads
            const MarkStop = "S";
        }

        private:internal {
            code m_output;
            *code m_flushed;
            bool m_tee;
            *File m_savedStdout;
            *File m_savedStderr;
            *Counter m_forwarders;
            binary m_mark;
            #! serializes flushAndWait()
            Mutex m_waitLock();
            #! counts the pipes whose output before the mark of flushAndWait() has not yet been passed
            *Counter m_waiting;
        }

        #! Creates the object; call start() to capture the output
        /** @param output called with the category, \c "stdout" or \c "stderr", and the output, in the thread of the
            pipe
            @param flushed called with the category when the output before a mark of flush() has been passed, in the
            thread of the pipe
            @param tee if @ref True, the output is also written to the original stdout or stderr
        */
        constructor(code<nothing(string, string)> output, *code<nothing(string)> flushed, bool tee = False) {
            m_output = output;
            m_flushed = flushed;
            m_tee = tee;
        }

        #! Redirects stdout and stderr to the pipes and starts the threads that read them
        /** @return @ref True if the output is captured, @ref False if it is already captured or if stdout and
            stderr cannot be duplicated on this platform
        */
        bool start() {
            if (PlatformOS == "Windows" || m_forwarders) {
                return False;
            }
            # stdout and stderr are kept with duplicates of their descriptors: the end of a pipe takes the descriptor
            # of each; "/dev/stdout" cannot be opened when stdout is a socket
            File saved_out = DebugOutputCapture::duplicate(stdout);
            File saved_err = DebugOutputCapture::duplicate(stderr);
            hash<PipeInfo> out_pipe = File::getPipe();
            hash<PipeInfo> err_pipe = File::getPipe();
            m_savedStdout = saved_out;
            m_savedStderr = saved_err;
            m_mark = binary(MarkPrefix) + binary(get_random_bytes(16).toHex());
            stdout.redirect(out_pipe.write);
            stderr.redirect(err_pipe.write);
            # stdout and stderr are now the only writers of the pipes
            out_pipe.write.close();
            err_pipe.write.close();
            m_forwarders = new Counter(2);
            background forward(out_pipe.read, "stdout", saved_out);
            background forward(err_pipe.read, "stderr", saved_err);
            return True;
        }

        #! Returns True if the output is captured
        bool isCapturing() {
            return exists m_forwarders;
        }

        #! Returns the original stdout while the output is captured, otherwise stdout
        File getStdout() {
            return m_savedStdout ?? stdout;
        }

        #! Returns the original stderr while the output is captured, otherwise stderr
        File getStderr() {
            return m_savedStderr ?? stderr;
        }

        #! Restores stdout and stderr, after the output written before has been passed to the callback
        stop() {
            if (!m_forwarders) {
                return;
            }
            writeMarks(MarkStop);
            m_forwarders.waitForZero();
            stdout.redirect(m_savedStdout);
            stderr.redirect(m_savedStderr);
            remove m_forwarders;
            remove m_savedStdout;
            remove m_savedStderr;
        }

        #! Calls the flush callback for each pipe after the output written before has been passed to the callback
        /** @return @ref True if the marks were written, @ref False if the output is not captured
        */
        bool flush() {
            if (!m_forwarders) {
                return False;
            }
            writeMarks(MarkFlush);
            return True;
        }

        #! Returns when the output written before has been passed to the output callback
        flushAndWait() {
            if (!m_forwarders) {
                return;
            }
            m_waitLock.lock();
            on_exit m_waitLock.unlock();
            Counter waiting(2);
            m_waiting = waiting;
            on_exit remove m_waiting;
            writeMarks(MarkWait);
            waiting.waitForZero();
        }

        #! Returns the number of leading bytes of the output that are not a part of a mark
        /** The output before a mark, or before the end of the output that can be the beginning of a mark, is not a
            part of a mark
        */
        static int getOutputSize(binary data, binary mark) {
            int i = data.find(mark);
            if (i >= 0) {
                return i;
            }
            # the longest end of the data that is the beginning of the mark
            int size = data.size();
            for (int k = min(mark.size() - 1, size); k > 0; --k) {
                if (data.substr(size - k) == mark.substr(0, k)) {
                    return size - k;
                }
            }
            return size;
        }

        #! Returns the size of the leading part of the data that ends with a complete UTF-8 character
        /** @param data UTF-8 data, which can end with a part of a character

            @return the size of the data without a trailing incomplete character
        */
        static int getCompleteUtf8Size(binary data) {
            int size = data.size();
            # a character has at most 4 bytes; find the first byte of the last character
            for (int i = size - 1; i >= 0 && i >= size - 4; --i) {
                int c = data[i];
                if ((c & 0xc0) != 0x80) {
                    int len = c < 0xc0 ? 1 : (c < 0xe0 ? 2 : (c < 0xf0 ? 3 : 4));
                    return i + len <= size ? size : i;
                }
            }
            return size;
        }

        #! Returns a new File with a duplicate of the descriptor of the given File
        private static File duplicate(File f) {
            hash<PipeInfo> pipe = File::getPipe();
            pipe.read.close();
            # the descriptor of the write end of the pipe becomes a duplicate of the given File's descriptor (dup2())
            pipe.write.redirect(f);
            return pipe.write;
        }

        #! Writes a mark with the given command to the pipes
        private:internal writeMarks(string cmd) {
            binary mark = m_mark + binary(cmd);
            stdout.write(mark);
            stderr.write(mark);
        }

        #! Passes the output read from a pipe to the callback until a stop mark or the end of the input
        private:internal forward(ReadOnlyFile reader, string category, File saved) {
            on_exit m_forwarders.dec();
            binary mark = m_mark;
            binary pending;
            while (True) {
                # waits for the next output; the rest of what is available is read with it
                *binary b = reader.readBinary(1);
                if (!exists b) {
                    break;
                }
                pending += b;
                while (pending.size() < 65536 && reader.isDataAvailable(0)) {
                    *binary more = reader.readBinary(1);
                    if (!exists more) {
                        break;
                    }
                    pending += more;
                }
                while (True) {
                    int size = DebugOutputCapture::getOutputSize(pending, mark);
                    # the output before a mark is passed with the end of an incomplete character
                    if (size + mark.size() < pending.size()) {
                        pass(category, saved, pending.substr(0, size));
                        string cmd = pending.substr(size + mark.size(), 1).toString();
                        splice pending, 0, size + mark.size() + 1;
                        switch (cmd) {
                            case MarkStop:
                                pass(category, saved, pending);
                                return;
                            case MarkWait:
                                m_waiting.dec();
                                break;
                            default:
                                if (m_flushed) {
                                    call_function(m_flushed, category);
                                }
                                break;
                        }
                        continue;
                    }
                    size = DebugOutputCapture::getCompleteUtf8Size(pending.substr(0, size));
                    if (size) {
                        pass(category, saved, pending.substr(0, size));
                        splice pending, 0, size;
                    }
                    break;
                }
            }
            pass(category, saved, pending);
        }

        #! Passes output to the callback and writes it to the original file, if any
        private:internal pass(string category, File saved, *binary output) {
            if (!output) {
                return;
            }
            if (m_tee) {
                saved.write(output);
            }
            call_function(m_output, category, output.toString("UTF-8"));
        }
    }

}
