# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module MailgunRestClient {
    version = "1.0";
    desc = "User module for calling Mailgun REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("mailgun", MailgunRestConnection::ConnectionScheme);
    };
}

/** @mainpage MailgunRestClient Module

    @tableofcontents

    @section mailgunrestclientintro MailgunRestClient Introduction

    The %MailgunRestClient module provides an API for calling Mailgun's REST API services.

    To use this module, use \c "%requires MailgunRestClient" in your code.

    All the public symbols in the module are defined in the MailgunRestClient namespace.

    The main classes are:
    - @ref MailgunRestClient::MailgunRestClient "MailgunRestClient":
      this class provides the REST client API for communication with the Mailgun API;
      it handles authentication via HTTP Basic Auth
    - @ref MailgunRestClient::MailgunRestConnection "MailgunRestConnection":
      provides a connection object to Mailgun services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires MailgunRestClient

MailgunRestClient mailgun({"apikey": ENV.MAILGUN_API_KEY, "api_domain": "mg.example.com"});
hash<auto> result = mailgun.get("/domains");
printf("Domains: %N\n", result.body);
    @endcode

    @section mailgunrestclientrelnotes Release Notes

    @subsection mailgunrestclientv1_0 MailgunRestClient v1.0
    - the initial version of the %MailgunRestClient module
*/

#! the MailgunRestClient namespace contains all the objects in the MailgunRestClient module
public namespace MailgunRestClient {

#! Common base class for MailgunRestClient functionality
public class MailgunRestClientBase {
    public {
        #! Default Mailgun API region
        const DefaultApiRegion = "US";

        #! API region base URLs (without version - version is added per-endpoint)
        const ApiRegionUrls = {
            "US": "https://api.mailgun.net",
            "EU": "https://api.eu.mailgun.net",
        };

        #! Default "data" option value
        const DefaultData = "json";

        #! Default Mailgun ping method
        const DefaultPingMethod = "GET";

        #! Default Mailgun ping path
        const DefaultPingPath = "/v3/domains";

        #! Default Mailgun ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! returns options for @ref MailgunRestClient::MailgunRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Determine base URL from api_region option
        string region = opts.api_region ?? DefaultApiRegion;
        if (!ApiRegionUrls.hasKey(region)) {
            throw "MAILGUN-ERROR", sprintf("invalid api_region %y; allowed values: %y", region, keys ApiRegionUrls);
        }
        rv.url = ApiRegionUrls{region};

        # Validate apikey is provided
        if (!opts.apikey) {
            throw "MAILGUN-ERROR", "missing required option 'apikey' (Mailgun API key)";
        }

        # Set HTTP Basic Auth: username=api, password=API_KEY
        rv.username = "api";
        rv.password = opts.apikey;

        # Remove custom options so RestClient doesn't try to use them
        remove rv.apikey;
        remove rv.api_region;
        remove rv.api_domain;

        return rv;
    }
}

#! This class provides the REST client API for communication with Mailgun servers
/** Mailgun uses a REST API. This client wraps RestClient to handle HTTP Basic Auth authentication.

    Authentication is done via HTTP Basic Auth with username "api" and the API key as password.

    @par API Regions:
    - US: https://api.mailgun.net/v3
    - EU: https://api.eu.mailgun.net/v3 (for EU data residency)
*/
public class MailgunRestClient inherits RestClient::RestClient, MailgunRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
MailgunRestClient mailgun({"apikey": "your-api-key", "api_domain": "mg.example.com"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the Mailgun API key (required)
        - \c api_region: the API region to use (US or EU, default: US)
        - \c api_domain: the sending domain (required for most operations)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(MailgunRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Mailgun REST connections; returns @ref MailgunRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c apikey: the Mailgun API key
    - \c api_region: the API region to use (US or EU)
    - \c api_domain: the sending domain

    @see @ref MailgunRestClient::MailgunRestClient::constructor() for more information on the above options
*/
public class MailgunRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Mailgun API URL
        const DefaultConnectionUrl = "mailgun://api.mailgun.net";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Mailgun REST Connection",
            "short_desc": "A connection to the Mailgun REST API",
            "desc": "A connection to the Mailgun REST API for email sending and management.\n\n"
                "**To obtain your API key:**\n"
                "1. Log in to your Mailgun account at https://app.mailgun.com\n"
                "2. Go to API Security in the settings\n"
                "3. Create a new API key or copy your existing private key\n\n"
                "**Region Selection:**\n"
                "- **US**: For US-hosted accounts (api.mailgun.net)\n"
                "- **EU**: For EU-hosted accounts with EU data residency (api.eu.mailgun.net)",
            "cls": Class::forName("MailgunRestConnection"),
            "auto_url": True,
            "schemes": {
                "mailgun": True,
            },
            "base_scheme_map": {
                "https": "mailgun",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": MailgunRestClientBase::DefaultData,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Mailgun API key for authentication",
                    "type": "string",
                    "desc": "The Mailgun API key for authentication.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Mailgun account at https://app.mailgun.com\n"
                        "2. Go to Settings > API Security\n"
                        "3. Create a new API key or copy your existing private key\n\n"
                        "**Note:** Keep your API key secure and never share it publicly.",
                    "sensitive": True,
                    "preselected": True,
                },
                "api_region": <ConnectionOptionInfo>{
                    "display_name": "API Region",
                    "short_desc": "Mailgun API region",
                    "type": "string",
                    "desc": "Select the Mailgun API region based on where your account is hosted:\n\n"
                        "- **US**: For US-hosted accounts (default)\n"
                        "- **EU**: For EU-hosted accounts with EU data residency",
                    "default_value": MailgunRestClientBase::DefaultApiRegion,
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "US",
                            "display_name": "United States",
                            "short_desc": "US region API",
                            "desc": "US API endpoint - https://api.mailgun.net/v3",
                        },
                        <AllowedValueInfo>{
                            "value": "EU",
                            "display_name": "European Union",
                            "short_desc": "EU region API",
                            "desc": "EU API endpoint - https://api.eu.mailgun.net/v3",
                        },
                    ),
                },
                "api_domain": <ConnectionOptionInfo>{
                    "display_name": "Sending Domain",
                    "short_desc": "Mailgun sending domain",
                    "type": "string",
                    "desc": "The Mailgun sending domain to use for email operations.\n\n"
                        "This is typically a subdomain like mg.example.com that you have verified "
                        "in your Mailgun account.",
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": MailgunRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": MailgunRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": MailgunRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your API Key",
                    "intent": "info",
                    "content": "1. Log in to your Mailgun account at https://app.mailgun.com\n"
                        "2. Navigate to **Settings > API Security**\n"
                        "3. Click **Add new key** or copy your existing private API key\n\n"
                        "**Important:**\n"
                        "- Use your **Private API key**, not a Domain Sending Key\n"
                        "- Keep your API key secure and never share it publicly",
                },
                <UiMessageInfo>{
                    "title": "Selecting the Right API Region",
                    "intent": "info",
                    "content": "Choose your API region based on where your Mailgun account is hosted:\n\n"
                        "- **US (api.mailgun.net)**: Default for most accounts\n"
                        "- **EU (api.eu.mailgun.net)**: For EU data residency requirements\n\n"
                        "If you're unsure, check your Mailgun dashboard URL:\n"
                        "- US accounts: app.mailgun.com\n"
                        "- EU accounts: app.eu.mailgun.com",
                },
                <UiMessageInfo>{
                    "title": "When is Sending Domain Required?",
                    "intent": "info",
                    "content": "The **Sending Domain** is required for:\n"
                        "- Sending emails\n"
                        "- Registering webhooks for email events\n\n"
                        "It is **not required** for:\n"
                        "- Listing domains\n"
                        "- Managing mailing lists\n"
                        "- Creating routes\n"
                        "- Validating email addresses\n\n"
                        "You can find your verified domains in the Mailgun dashboard under "
                        "**Sending > Domains**.",
                },
            ),
        };
    }

    #! creates the MailgunRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the MailgunRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(MailgunRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref MailgunRestConnection::constructor()
    /** Constructs the connection URL from the api_region option
    */
    private static hash<auto> getConfig(hash<auto> config) {
        # Get api_region from options, default to US
        string region = config.opts.api_region ?? MailgunRestClientBase::DefaultApiRegion;
        # Build URL from region
        string url;
        switch (region) {
            case "EU":
                url = "mailgun://api.eu.mailgun.net";
                break;
            default:
                url = "mailgun://api.mailgun.net";
        }
        return config + {
            "url": url,
        };
    }

    #! returns \c "mailgun"
    string getType() {
        return "mailgun";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the @ref getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        return "Mailgun";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the MailgunDataProvider and creates the data provider
        # object dynamically
        load_module("MailgunDataProvider");
        return create_object("MailgunDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    /** The closure or call reference must have the following signature:
        <tt>update_options(hash<auto> options)</tt>
    */
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        # update the URL immediately if necessary
        if (update_options && url != DefaultConnectionUrl) {
            # NOTE: do not update the URL or real URL values here, or the external update will fail, because it will
            # believe that no changes are necessary
            doUpdateOptions(self, {
                "url": DefaultConnectionUrl,
            });
        }
    }

    #! returns a @ref MailgunRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref MailgunRestClient object
    */
    private MailgunRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new MailgunRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since MailgunRestClient 1.1
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new MailgunRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Mailgun REST API using multiplexed HTTP connections
/** @see MailgunRestClient for more information
*/
public class MailgunRestClientIo inherits RestClientIo::RestClientIo, MailgunRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(MailgunRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
