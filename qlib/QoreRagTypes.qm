%requires qore >= 2.0
%modern

%requires reflection
%requires RestClientIo

module QoreRagTypes {
    version = "1.0.0";
    desc = "user module providing the provider-neutral hashdecls and abstract "
        "provider classes shared by QoreRagUtils and RAG provider modules";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreRagTypes Module

    @tableofcontents

    @section qoreragtypesintro QoreRagTypes Module Introduction

    The %QoreRagTypes module provides the provider-neutral type and abstract
    class layer that @ref qoreragutilsintro "QoreRagUtils" and individual
    RAG REST client modules (OpenAiRestClient, GeminiRestClient,
    VoyageRestClient, SGLangRestClient, BgeM3RestClient) share.  It exists
    as a separate module so that REST client modules can depend on the
    abstract provider contract without forming a dependency cycle with
    %QoreRagUtils.

    Symbols defined here live in the @ref QoreRagUtils namespace so callers
    that \c "%requires QoreRagUtils" see them transparently; the split is
    purely a packaging detail.

    @section qoreragtypesmembers Public symbols

    Hashdecls describing configuration and results:

    - @ref QoreRagUtils::EmbedderConfig — embedder configuration
    - @ref QoreRagUtils::VectorStoreConfig — vector-store configuration
    - @ref QoreRagUtils::RerankerConfig — reranker configuration
    - @ref QoreRagUtils::ChunkerConfig — chunker configuration
    - @ref QoreRagUtils::RagConfig — top-level pipeline configuration
    - @ref QoreRagUtils::RagPipelineOptions — optional pipeline hooks
    - @ref QoreRagUtils::ChunkInfo — single chunk produced by a chunker
    - @ref QoreRagUtils::VectorRecord — vector record in a store
    - @ref QoreRagUtils::VectorSearchResult — vector search hit
    - @ref QoreRagUtils::RerankResult — reranker result
    - @ref QoreRagUtils::RetrievalHit — pipeline retrieval hit
    - @ref QoreRagUtils::RagProviderInfo — provider discovery metadata

    Abstract building blocks:

    - @ref QoreRagUtils::AbstractEmbedder — converts text into vectors
    - @ref QoreRagUtils::AbstractVectorStore — persists vectors and searches
    - @ref QoreRagUtils::AbstractReranker — re-orders candidates by relevance
    - @ref QoreRagUtils::AbstractChunker — splits documents into chunks
    - @ref QoreRagUtils::AbstractEmbeddingCache — query embedding cache
    - @ref QoreRagUtils::EmbedderRateLimiter — process-wide requests/tokens-per-minute limiter

    Provider factory abstractions:

    - @ref QoreRagUtils::AbstractEmbedderFactory — factory for embedders
    - @ref QoreRagUtils::AbstractRerankerFactory — factory for rerankers
    - @ref QoreRagUtils::AbstractVectorStoreFactory — factory for vector stores
    - @ref QoreRagUtils::RagProviderRegistry — central registry of factories,
      with FactoryMap lazy-load by config \c type / \c backend

    @section qoreragtypesrelnotes Release Notes

    @subsection qoreragtypes_1_0 QoreRagTypes 1.0
    - initial release
    - HTTP embedders share RestClientIo's bounded transient-failure retries, configurable per embedder
      and per call, with RAG retry telemetry (issue 5475)
    - added @ref QoreRagUtils::EmbedderRateLimiter "EmbedderRateLimiter", a process-wide requests- and
      tokens-per-minute limiter for provider requests, and the \c requests_per_minute,
      \c tokens_per_minute, \c rate_limit_max_retries, and \c rate_limit_timeout
      @ref QoreRagUtils::EmbedderConfig "EmbedderConfig" fields honored by embedders that pace their requests
*/

#! Provider-neutral RAG types and abstract classes (shared with QoreRagUtils)
public namespace QoreRagUtils {

#! Provider-neutral RAG usage and quality-adjacent metrics
public hashdecl RagUsageMetrics {
    #! Number of input documents
    int document_count = 0;
    #! Number of chunks produced or processed
    int chunk_count = 0;
    #! Approximate text tokens processed
    int token_count = 0;
    #! Number of texts passed to an embedder
    int embedding_input_count = 0;
    #! Number of vectors produced or stored
    int vector_count = 0;
    #! Vector dimensionality
    int vector_dimensions = 0;
    #! Requested vector-search candidate count
    int requested_top_k = 0;
    #! Number of candidates examined before reranking
    int candidate_count = 0;
    #! Number of results returned to the caller
    int returned_count = 0;
    #! Embedding cache hit count
    int embedding_cache_hits = 0;
    #! Embedding cache miss count
    int embedding_cache_misses = 0;
    #! Approximate storage bytes affected when known
    int storage_bytes = 0;
    #! Number of vector stores tried in a fallback chain
    int vector_store_attempts = 0;
    #! Number of vector stores that failed before a result was returned
    int vector_store_failures = 0;
}

#! RAG lifecycle telemetry event
/** Events contain operation metadata and counts only.  Raw query, document,
    chunk, and embedding content is intentionally excluded by default.
*/
public hashdecl RagTelemetryEvent {
    #! Event type: "start", "end", "error", or "wait" (a long client-side rate-limit admission wait)
    string type;
    #! Operation: "ingest", "retrieve", "rerank", "embed", "chunk", etc.
    string operation;
    #! Event timestamp
    date timestamp;
    #! Backend or component name when known
    *string backend;
    #! Model name when known
    *string model;
    #! Vector collection / table when known
    *string collection;
    #! Caller-owned opaque correlation context
    *hash<auto> telemetry_context;
    #! Safe request summary
    *hash<auto> request;
    #! Safe response summary
    *hash<auto> response;
    #! Provider-neutral metrics
    *hash<RagUsageMetrics> metrics;
    #! Status: "ok" or "error"
    *string status;
    #! Latency in milliseconds
    *int latency_ms;
    #! Normalized error metadata
    *hash<auto> error;
    #! Additional non-sensitive attributes
    *hash<auto> attributes;
}

#! Optional observer callbacks for RAG telemetry
/** All callbacks are best-effort.  The RAG pipeline catches and ignores
    observer failures so instrumentation cannot affect retrieval or ingest
    behavior.
*/
public hashdecl RagTelemetryObserver {
    #! Receives every event
    *code<nothing(hash<RagTelemetryEvent>)> event_callback;
    #! Receives "start" events
    *code<nothing(hash<RagTelemetryEvent>)> start_callback;
    #! Receives "end" events
    *code<nothing(hash<RagTelemetryEvent>)> end_callback;
    #! Receives "error" events
    *code<nothing(hash<RagTelemetryEvent>)> error_callback;
}

#! Configuration for an embedder backend
public hashdecl EmbedderConfig {
    #! Backend identifier — implementation-specific (e.g. "local-onnx", "openai", "voyage", "gemini", "sglang", "bge-m3")
    *string backend;
    #! Path to a local model file (used by ONNX embedder)
    *string model_path;
    #! REST URL for HTTP-based embedders
    *string url;
    #! Model name to send in API requests
    *string model;
    #! API key for HTTP-based embedders
    *string api_key;
    #! Output embedding dimension (where the backend supports it)
    /** When set and smaller than the model's native output dimension, asymmetric/
        Matryoshka-capable embedders (e.g. SGLang-served Qwen3-Embedding) truncate
        the native vector to this length and L2-renormalize it (client-side MRL).
    */
    *int dimension;
    #! Instruction prefix prepended to \b query texts (asymmetric / instruction-tuned models)
    /** Instruction-tuned embedders (e.g. Qwen3-Embedding, E5, GTE) expect a
        task instruction on the query side only; the verbatim prefix is prepended
        to each text encoded with \c input_type "query" (see
        @ref AbstractEmbedder::encodeQuery()).  Leave unset for symmetric models.
        Example (Qwen3): \c "Instruct: Given a user request, retrieve the operation that fulfills it\nQuery:"
    */
    *string query_instruction;
    #! Instruction prefix prepended to \b document/passage texts (asymmetric models)
    /** Usually unset; some models (e.g. E5) want a \c "passage: " prefix on the
        document side.  Prepended to each text encoded with \c input_type
        "document" (see @ref AbstractEmbedder::encodeDocuments()).
    */
    *string document_instruction;
    #! Batch size for bulk encoding
    int batch_size = 32;
    #! Default request timeout for HTTP-based embedders (per-call \c opts override takes precedence)
    /** Forwarded to the underlying REST client at construction; ignored by
        non-HTTP backends.  Use Qore's \c timeout type literals (e.g. \c 10s,
        \c 5000ms).  See @ref AbstractEmbedder::encodeBatch() "encodeBatch()"
        for per-call override semantics.
    */
    *timeout timeout;
    #! Default connection timeout for HTTP-based embedders (per-call \c opts override takes precedence)
    /** Forwarded to the underlying REST client at construction; ignored by
        non-HTTP backends.  Note: @ref restclientiointro "RestClientIo" only applies a connection
        timeout to NEW connections, so a per-call \c connect_timeout in
        @ref AbstractEmbedder::encodeBatch() "encodeBatch()" causes the
        embedder to use a transient REST client for that call.
    */
    *timeout connect_timeout;
    #! Maximum retries per HTTP request after the initial attempt; zero disables retries
    int max_retries = 3;
    #! Maximum exponential-backoff delay (default 8s); Retry-After is a minimum and is not capped
    timeout retry_max_delay = 8s;
    #! Total HTTP embedding budget, including requests and backoff (default 30s)
    /** A positive configured or per-call \c timeout further limits this budget.
        Per-call options can override all three retry settings.
    */
    timeout retry_timeout = 30s;
    #! Client-side requests-per-minute limit for embedders that pace their requests
    /** Honored by embedders with a client-side rate limiter (currently
        @ref QoreRagUtils::VoyageEmbedder "VoyageEmbedder"); when unset, the backend's default for the model
        applies.  The limit is enforced per process for every embedder sharing the same endpoint, API key,
        and model; processes that share one provider limit must each be given their share.
    */
    *int requests_per_minute;
    #! Client-side tokens-per-minute limit for embedders that pace their requests
    /** See @ref requests_per_minute.
    */
    *int tokens_per_minute;
    #! Maximum retries of one request rejected by the provider's rate limit (HTTP 429); default 8
    /** Honored by embedders with a client-side rate limiter.  Zero disables rate-limit retries.
    */
    int rate_limit_max_retries = 8;
    #! Longest time one request may wait for rate-limit admission and rate-limit retries (default 60s)
    /** Honored by embedders with a client-side rate limiter.  A positive configured or per-call
        \c timeout further limits it.
    */
    timeout rate_limit_timeout = 60s;
    #! Free-form backend-specific options
    *hash<auto> options;
    #! Optional observer for direct embedder usage
    *hash<RagTelemetryObserver> telemetry_observer;
    #! Optional caller-owned telemetry correlation context
    *hash<auto> telemetry_context;
}

#! A request admitted by an @ref QoreRagUtils::EmbedderRateLimiter "EmbedderRateLimiter"
public hashdecl EmbedderRateLimitTicket {
    #! The ticket identifier
    int id;
    #! When the request was admitted, in monotonic microseconds
    int admitted_us;
    #! The request's estimated tokens, replaced by its actual usage when it is settled
    int tokens;
    #! True once the request has finished
    bool settled = False;
}

#! One rate-limit event reported by @ref QoreRagUtils::EmbedderRateLimiter::call() "EmbedderRateLimiter::call()"
public hashdecl RateLimitEventInfo {
    #! \c "retry" after a provider rejection (HTTP 429), \c "wait" after a long admission wait
    string type;
    #! The number of the attempt the event follows (one-based); 0 for a wait before the first attempt
    int attempt;
    #! The delay before the next attempt (\c "retry"), or the time waited for admission (\c "wait"), in ms
    int delay_ms;
    #! HTTP status of the rejection, for \c "retry"
    *int status_code;
    #! The provider's \c Retry-After in milliseconds, when it sent one
    *int retry_after_ms;
    #! Exception code of the rejection, for \c "retry"
    *string err;
}

#! Options for @ref QoreRagUtils::EmbedderRateLimiter::call() "EmbedderRateLimiter::call()"
public hashdecl RateLimitedCallInfo {
    #! The request's estimated tokens
    int tokens = 0;
    #! The latest monotonic time at which the request may be admitted or retried after a rejection
    int deadline_us;
    #! Maximum retries after HTTP 429 rejections; zero disables them
    int max_retries = 8;
    #! The exception code raised when the request cannot be admitted or its rate-limit retries are exhausted
    string error_code = "EMBEDDER-RATE-LIMIT-ERROR";
    #! A prefix for the exception description, such as the provider and model
    *string error_prefix;
    #! Members added to the exception argument
    *hash<auto> error_arg;
    #! Called for each 429 retry and for each admission wait of at least \c wait_report_ms; must not throw
    *code<nothing(hash<RateLimitEventInfo>)> observer;
    #! The shortest admission wait reported to \c observer
    int wait_report_ms = 1000;
}

#! Paces provider requests against requests-per-minute and tokens-per-minute limits
/** Keeps a trailing window of admitted requests and holds a new request until it fits under both limits,
    so the provider is never asked for more than the limits allow in any trailing window.  A request is
    admitted with its estimated tokens; @ref settle() replaces the estimate with the provider's reported
    usage.  @ref block() stops all admissions for a time, as after an HTTP 429 from the provider, so every
    caller sharing the limiter backs off together.

    Waiting uses a condition variable: settling a request or a block change wakes waiters, and a wait
    otherwise ends exactly when the oldest window entry expires.  Condition waits are cooperative
    cancellation check points, so a cancelled thread leaves its wait with \c THREAD-CANCELLED.

    A request with more tokens than the token limit is admitted alone, once the window is empty.

    @ref getShared() returns one process-wide limiter per key, so independently constructed clients for the
    same provider account (for example, a new embedder per request) share one window.

    @par Example
    @code{.py}
EmbedderRateLimiter limiter = EmbedderRateLimiter::getShared("provider|key-digest|model", 2000, 3000000);
int ticket = limiter.admit(estimated_tokens, clock_get_monotonic_us() + 60000000);
try {
    hash<auto> resp = send();
    limiter.settle(ticket, resp.usage.total_tokens);
} catch (hash<ExceptionInfo> ex) {
    limiter.settle(ticket);
    rethrow;
}
    @endcode
*/
public class EmbedderRateLimiter {
    public {
        #! Default window length: one minute
        const DefaultWindowMs = 60000;

        #! Initial rate-limit backoff in @ref call() when the provider sends no \c Retry-After
        const InitialRateLimitBackoffMs = 1000;

        #! Maximum rate-limit backoff in @ref call() when the provider sends no \c Retry-After
        const MaxRateLimitBackoffMs = 16000;
    }

    private {
        #! Window length in microseconds
        int window_us;
        #! Requests admitted per window; NOTHING = not limited
        *int requests_per_window;
        #! Tokens admitted per window; NOTHING = not limited
        *int tokens_per_window;
        #! Serializes window state
        Mutex m();
        #! Signalled when a request is settled, limits change, or a block changes
        Condition cond();
        #! Admitted requests in the trailing window, oldest first
        list<hash<EmbedderRateLimitTicket>> window = ();
        #! Monotonic time before which nothing is admitted
        int blocked_until_us = 0;
        #! Last issued ticket identifier
        int last_id = 0;
    }

    private:internal {
        #! Serializes the shared limiter registry
        static Mutex registry_lock();
        #! Key -> process-wide limiter
        static hash<string, EmbedderRateLimiter> registry = {};
    }

    #! Creates a limiter
    /** @param requests_per_window the requests admitted per window; NOTHING or 0 means no request limit
        @param tokens_per_window the tokens admitted per window; NOTHING or 0 means no token limit
        @param window_ms the trailing window in milliseconds (default one minute)

        @throw EMBEDDER-RATE-LIMIT-CONFIG-ERROR a limit is negative or the window is not positive
    */
    constructor(*int requests_per_window, *int tokens_per_window, int window_ms = DefaultWindowMs) {
        if (window_ms <= 0) {
            throw "EMBEDDER-RATE-LIMIT-CONFIG-ERROR", sprintf("window must be positive; got %d ms",
                window_ms);
        }
        window_us = window_ms * 1000;
        setLimitsIntern(requests_per_window, tokens_per_window);
    }

    #! Returns the process-wide limiter for a key, creating it with the given limits when needed
    /** With \a replace, an existing limiter takes the given limits, so a changed configuration applies to every
        client sharing the key; a client without a configuration of its own passes default limits with
        \a replace @ref False, so it never overrides limits another client configured.

        @param key identifies one provider account and model; must not contain secrets in clear text
        @param requests_per_minute the requests admitted per minute; NOTHING or 0 means no request limit
        @param tokens_per_minute the tokens admitted per minute; NOTHING or 0 means no token limit
        @param replace apply the limits to an existing limiter

        @return the shared limiter

        @throw EMBEDDER-RATE-LIMIT-CONFIG-ERROR a limit is negative
    */
    static EmbedderRateLimiter getShared(string key, *int requests_per_minute, *int tokens_per_minute,
            bool replace = True) {
        AutoLock al(registry_lock);
        *EmbedderRateLimiter limiter = registry{key};
        if (limiter) {
            if (replace) {
                limiter.setLimits(requests_per_minute, tokens_per_minute);
            }
            return limiter;
        }
        limiter = new EmbedderRateLimiter(requests_per_minute, tokens_per_minute);
        registry{key} = limiter;
        return limiter;
    }

    #! Changes the limits and wakes waiters
    /** @param requests_per_window the requests admitted per window; NOTHING or 0 means no request limit
        @param tokens_per_window the tokens admitted per window; NOTHING or 0 means no token limit

        @throw EMBEDDER-RATE-LIMIT-CONFIG-ERROR a limit is negative
    */
    setLimits(*int requests_per_window, *int tokens_per_window) {
        AutoLock al(m);
        setLimitsIntern(requests_per_window, tokens_per_window);
        cond.broadcast();
    }

    #! Returns the current limits as a hash with \c requests and \c tokens (NOTHING = not limited)
    hash<auto> getLimits() {
        AutoLock al(m);
        return {"requests": requests_per_window, "tokens": tokens_per_window};
    }

    #! Admits one request, waiting until it fits in the window
    /** @param tokens the request's estimated tokens
        @param deadline_us the latest monotonic time (see @ref Qore::clock_get_monotonic_us()
            "clock_get_monotonic_us()") at which the request may be admitted

        @return the ticket identifier to pass to @ref settle()

        @throw EMBEDDER-RATE-LIMIT-ERROR the request cannot be admitted before the deadline; raised at once
            when nothing in flight can free capacity sooner; the argument has \c reason_code
            \c "rate_limit_wait_deadline", \c retryable @ref True, and \c wait_ms
        @throw THREAD-CANCELLED the waiting thread was cancelled
    */
    int admit(int tokens, int deadline_us) {
        tokens = max(tokens, 0);
        AutoLock al(m);
        while (True) {
            int now = nowUs();
            prune(now);
            int ready = max(now, blocked_until_us);
            *int fits = earliestFit(tokens);
            if (exists fits && fits > ready) {
                ready = fits;
            }
            if (ready <= now) {
                hash<EmbedderRateLimitTicket> ticket = <EmbedderRateLimitTicket>{
                    "id": ++last_id,
                    "admitted_us": now,
                    "tokens": tokens,
                };
                push window, ticket;
                return ticket.id;
            }
            if (ready > deadline_us) {
                # settling an in-flight request can replace its estimate with lower usage and free capacity
                # before the window does, so wait for that until the deadline
                bool in_flight = False;
                foreach hash<EmbedderRateLimitTicket> entry in (window) {
                    if (!entry.settled) {
                        in_flight = True;
                        break;
                    }
                }
                if (!in_flight || ready <= blocked_until_us || now >= deadline_us) {
                    throw "EMBEDDER-RATE-LIMIT-ERROR", sprintf("the request cannot be admitted under the "
                        "client-side rate limit within its deadline (needs %d ms more)",
                        (ready - now) / 1000), {
                        "reason_code": "rate_limit_wait_deadline",
                        "retryable": True,
                        "wait_ms": (ready - now) / 1000,
                    };
                }
                ready = deadline_us;
            }
            # round up so a wait never ends before the time it waits for
            cond.wait(m, max(1, (ready - now + 999) / 1000));
        }
    }

    #! Marks an admitted request as finished and wakes waiters
    /** @param id the ticket from @ref admit()
        @param tokens the actual tokens; NOTHING keeps the estimate (a failed request, or a response
            without usage)
    */
    settle(int id, *int tokens) {
        AutoLock al(m);
        for (int i = 0; i < window.size(); ++i) {
            if (window[i].id == id) {
                if (exists tokens) {
                    window[i].tokens = max(tokens, 0);
                }
                window[i].settled = True;
                break;
            }
        }
        cond.broadcast();
    }

    #! Blocks all admissions for the given time, as after an HTTP 429; an existing later block is kept
    /** @param ms the time to block in milliseconds
    */
    block(int ms) {
        AutoLock al(m);
        int until = nowUs() + max(ms, 0) * 1000;
        if (until > blocked_until_us) {
            blocked_until_us = until;
        }
        cond.broadcast();
    }

    #! Returns the requests and tokens currently in the window
    /** @return a hash with \c requests and \c tokens
    */
    hash<auto> usage() {
        AutoLock al(m);
        prune(nowUs());
        int tokens = 0;
        foreach hash<EmbedderRateLimitTicket> entry in (window) {
            tokens += entry.tokens;
        }
        return {"requests": window.size(), "tokens": tokens};
    }

    #! Sends one provider request under the limits, retrying HTTP 429 rejections
    /** Each attempt is admitted first (see @ref admit()).  A rejection with HTTP 429 (a \c REST-RESPONSE-ERROR
        whose argument has \c status_code 429) blocks every caller sharing this limiter (see @ref block()) for
        the provider's \c Retry-After (seconds or HTTP date) plus up to 10% jitter, or, without one, for an
        exponential backoff from @ref InitialRateLimitBackoffMs to @ref MaxRateLimitBackoffMs with equal jitter;
        the request is then admitted and sent again.  Any other exception propagates unchanged.  A rejected or
        failed attempt keeps its estimated tokens in the window, since the provider may have counted it.

        @param info the request's estimate, deadline, retry limit, error identity and observer
        @param send sends one attempt and returns its response; it must bound its own I/O
        @param usage optional; returns the provider-reported tokens of a response, which replace the estimate

        @return the response of the successful attempt

        @throw <info.error_code> the request could not be admitted before the deadline (\c reason_code
            \c "rate_limit_wait_deadline") or was still rejected with HTTP 429 after \c max_retries retries or
            when the next wait would pass the deadline (\c reason_code \c "provider_rate_limited", with
            \c status_code, \c attempts, \c retry_after_ms and the provider's \c body); the argument is
            extended with \c error_arg
        @throw THREAD-CANCELLED the waiting thread was cancelled

        @par Example
        @code{.py}
hash<auto> resp = limiter.call(<RateLimitedCallInfo>{
    "tokens": 1200,
    "deadline_us": clock_get_monotonic_us() + 60000000,
    "error_code": "RERANKER-RATE-LIMIT-ERROR",
}, auto sub () { return client.restPost("/rerank", body); },
    *int sub (auto resp) { return resp.body.usage.total_tokens; });
        @endcode
    */
    auto call(hash<RateLimitedCallInfo> info, code<auto()> send, *code<*int(auto)> usage) {
        int attempts = 0;
        int own_delay_ms = 0;
        int backoff_ms = InitialRateLimitBackoffMs;
        string prefix = info.error_prefix ? info.error_prefix + ": " : "";
        while (True) {
            int ticket;
            int wait_started = nowUs();
            try {
                ticket = admit(info.tokens, info.deadline_us);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "EMBEDDER-RATE-LIMIT-ERROR") {
                    rethrow;
                }
                throw info.error_code, prefix + ex.desc,
                    ex.arg + {"attempts": attempts} + (info.error_arg ?? {});
            }
            # the wait for this call's own retry delay was already reported with the retry
            int waited_ms = (nowUs() - wait_started) / 1000;
            if (waited_ms - own_delay_ms >= info.wait_report_ms) {
                report(info, <RateLimitEventInfo>{"type": "wait", "attempt": attempts, "delay_ms": waited_ms});
            }
            ++attempts;
            auto response;
            try {
                response = send();
            } catch (hash<ExceptionInfo> ex) {
                settle(ticket);
                if (ex.err != "REST-RESPONSE-ERROR" || ex.arg.typeCode() != NT_HASH || ex.arg.status_code != 429) {
                    rethrow;
                }
                *int advised_ms = retryAfterMs(ex.arg.headers);
                int delay_ms;
                if (exists advised_ms) {
                    int advised = advised_ms;
                    delay_ms = advised + jitter(advised / 10);
                } else {
                    delay_ms = backoff_ms / 2 + jitter(backoff_ms / 2);
                }
                # every caller sharing this limit waits, so the provider is not asked again early
                block(delay_ms);
                if (attempts > info.max_retries || nowUs() + delay_ms * 1000 > info.deadline_us) {
                    throw info.error_code, sprintf("%sthe provider rejected the request with HTTP 429 after %d "
                        "attempt(s): %s", prefix, attempts, ex.desc), {
                        "reason_code": "provider_rate_limited",
                        "retryable": True,
                        "status_code": 429,
                        "attempts": attempts,
                        "retry_after_ms": advised_ms,
                        "body": ex.arg.body,
                    } + (info.error_arg ?? {});
                }
                report(info, <RateLimitEventInfo>{"type": "retry", "attempt": attempts, "delay_ms": delay_ms,
                    "status_code": 429, "retry_after_ms": advised_ms, "err": ex.err});
                own_delay_ms = delay_ms;
                backoff_ms = min(MaxRateLimitBackoffMs, backoff_ms * 2);
                continue;
            }
            *int used;
            if (usage) {
                try {
                    used = usage(response);
                } catch (hash<ExceptionInfo> ex) {
                    settle(ticket);
                    rethrow;
                }
            }
            settle(ticket, used);
            return response;
        }
    }

    #! Reads Retry-After (seconds or HTTP date) from response headers in milliseconds
    /** @param headers the response headers; header names are matched without regard to case
        @return the delay, or NOTHING when the header is absent or malformed
    */
    static *int retryAfterMs(auto headers) {
        if (headers.typeCode() != NT_HASH) {
            return NOTHING;
        }
        foreach string key in (keys headers) {
            if (tolower(key) != "retry-after") {
                continue;
            }
            auto value = headers{key};
            if (value.typeCode() != NT_STRING) {
                return NOTHING;
            }
            string header = trim(value);
            if (header =~ /^[0-9]+$/) {
                # saturate an untrusted value before converting it
                return int(min(number(header), 9223372036854n)) * 1000;
            }
            try {
                return max(0, (date(header) - now_us()).durationMilliseconds());
            } catch () {
                return NOTHING;
            }
        }
        return NOTHING;
    }

    #! Returns a random delay between 0 and the limit; overridable for deterministic tests
    private int jitter(int limit_ms) {
        return limit_ms > 0 ? rand() % (limit_ms + 1) : 0;
    }

    #! Passes an event to the observer without letting it change the request
    private report(hash<RateLimitedCallInfo> info, hash<RateLimitEventInfo> event) {
        if (!info.observer) {
            return;
        }
        try {
            info.observer(event);
        } catch (hash<ExceptionInfo> ex) {
            if (inlist(ex.err, ("THREAD-CANCELLED", "PROGRAM-INTERRUPTED"))) {
                rethrow;
            }
        }
    }

    #! Monotonic clock; overridable for deterministic tests
    private int nowUs() {
        return clock_get_monotonic_us();
    }

    #! Validates and sets limits; the lock must be held or the object not yet shared
    private:internal setLimitsIntern(*int requests_per_window, *int tokens_per_window) {
        if (requests_per_window < 0 || tokens_per_window < 0) {
            throw "EMBEDDER-RATE-LIMIT-CONFIG-ERROR", sprintf("rate limits must not be negative; got "
                "requests %y, tokens %y", requests_per_window, tokens_per_window);
        }
        self.requests_per_window = requests_per_window ? requests_per_window : NOTHING;
        self.tokens_per_window = tokens_per_window ? tokens_per_window : NOTHING;
    }

    #! Removes entries older than the window; the lock must be held
    private:internal prune(int now) {
        int window_start = now - window_us;
        int i = 0;
        while (i < window.size() && window[i].admitted_us <= window_start) {
            ++i;
        }
        if (i) {
            splice window, 0, i;
        }
    }

    #! Returns when a request fits in the window, or NOTHING if it fits now; the lock must be held
    private:internal *int earliestFit(int tokens) {
        if (!window) {
            return NOTHING;
        }
        *int rv;
        if (requests_per_window && window.size() >= requests_per_window) {
            # the request fits once enough of the oldest requests have left the window
            rv = window[window.size() - requests_per_window].admitted_us + window_us;
        }
        if (tokens_per_window) {
            int used = 0;
            foreach hash<EmbedderRateLimitTicket> entry in (window) {
                used += entry.tokens;
            }
            if (used + tokens > tokens_per_window) {
                # an oversized request waits for an empty window
                int excess = min(used + tokens - tokens_per_window, used);
                int freed = 0;
                foreach hash<EmbedderRateLimitTicket> entry in (window) {
                    freed += entry.tokens;
                    if (freed >= excess) {
                        int fits = entry.admitted_us + window_us;
                        if (!exists rv || fits > rv) {
                            rv = fits;
                        }
                        break;
                    }
                }
            }
        }
        return rv;
    }
}

#! Declares whether an embedder needs a client-side tokenizer, and which one
/** Returned by @ref AbstractEmbedder::getTokenizerRequirement().  An embedder
    "needs" a client-side tokenizer when token-based chunk sizing should use the
    embedding model's own tokenizer rather than a character heuristic (e.g.
    HuggingFace-tokenized models served over HTTP, or local ONNX models).  A
    consumer-supplied @ref AbstractTokenizerResolver turns the requirement into a
    parsed \c tokenizer.json.  Retrieval/installation of the tokenizer is
    deliberately out of scope here (a network/deployment concern); \c source_uri
    is reserved so an opt-in fetching resolver can be added without an interface
    change.
*/
public hashdecl TokenizerRequirement {
    #! whether a client-side tokenizer is needed for token-based chunk sizing
    bool required = False;
    #! stable identifier of the required tokenizer (e.g. the served/HF model name), when known
    *string id;
    #! optional hint for where the tokenizer.json can be retrieved (reserved; not used by the core)
    *string source_uri;
    #! human-readable description
    *string desc;
}

#! Resolves a @ref TokenizerRequirement to a parsed \c tokenizer.json
/** Pluggable contract implemented by consumers, which know where
    tokenizers are installed/bundled.  The core performs no network or filesystem
    installation; an implementation may consult pre-installed/bundled tokenizers
    and (optionally, on its own terms) retrieve missing ones.
*/
public class AbstractTokenizerResolver {
    #! Returns a token counter for the requirement, or @ref NOTHING when unavailable
    /** Implementations map the requirement to a tokenizer they have access to
        (typically a pre-installed/bundled \c tokenizer.json) and return a ready
        token counter — an object with an <tt>int countTokens(string)</tt> method
        (e.g. @ref QoreTokenizerUtils::TokenCounter "TokenCounter").  The return type is \c *object
        so this provider-neutral module does not depend on the tokenizer module;
        the result is suitable for @ref AbstractEmbedder::setTokenCounter().

        @param req the tokenizer requirement declared by an embedder

        @return a token counter, or @ref NOTHING when no tokenizer is available
        (callers then fall back to a heuristic)
    */
    abstract *object resolve(hash<TokenizerRequirement> req);

    #! Returns @ref True if a tokenizer for the requirement is available
    /** Default implementation probes @ref resolve(); override for a cheaper check.
    */
    bool isAvailable(hash<TokenizerRequirement> req) {
        return exists resolve(req);
    }
}

#! Configuration for a vector-store backend
public hashdecl VectorStoreConfig {
    #! Backend identifier (e.g. "qdrant", "pgvector")
    *string backend;
    #! Collection or table name
    *string collection;
    #! Connection URL or DSN
    *string url;
    #! Free-form backend-specific options (filters, payload schema, etc.)
    *hash<auto> options;
    #! Optional observer for direct vector-store usage
    *hash<RagTelemetryObserver> telemetry_observer;
    #! Optional caller-owned telemetry correlation context
    *hash<auto> telemetry_context;
}

#! Configuration for a reranker backend
public hashdecl RerankerConfig {
    #! Backend identifier (e.g. "local-onnx", "voyage", "http-gateway", "sglang")
    *string backend;
    #! Path to a local model file (ONNX reranker)
    *string model_path;
    #! REST URL for HTTP rerankers
    *string url;
    #! Model name to send
    *string model;
    #! Maximum documents sent per reranker request; default 50
    int batch_size = 50;
    #! API key
    *string api_key;
    #! Client-side requests-per-minute limit for rerankers that pace their requests
    /** Honored by rerankers with a client-side rate limiter (currently
        @ref QoreRagUtils::VoyageReranker "VoyageReranker"); when unset, the backend's default for the model
        applies; see @ref EmbedderConfig::requests_per_minute.
    */
    *int requests_per_minute;
    #! Client-side tokens-per-minute limit for rerankers that pace their requests
    *int tokens_per_minute;
    #! Maximum retries of one request rejected by the provider's rate limit (HTTP 429); default 8
    int rate_limit_max_retries = 8;
    #! Longest time one request may wait for rate-limit admission and rate-limit retries (default 60s)
    timeout rate_limit_timeout = 60s;
    #! Free-form backend-specific options
    *hash<auto> options;
    #! Optional observer for direct reranker usage
    *hash<RagTelemetryObserver> telemetry_observer;
    #! Optional caller-owned telemetry correlation context
    *hash<auto> telemetry_context;
}

#! Configuration for a chunker backend
public hashdecl ChunkerConfig {
    #! Strategy name: "structured" (default), "semantic", "fixed"
    string strategy = "structured";
    #! Target token count per chunk
    int target_tokens = 512;
    #! Overlap tokens between consecutive chunks (for "fixed" strategy)
    int overlap_tokens = 50;
    #! Similarity threshold (used by "semantic" chunker)
    float similarity_threshold = 0.7;
    #! Free-form backend-specific options
    *hash<auto> options;
    #! Optional observer for direct chunker usage
    *hash<RagTelemetryObserver> telemetry_observer;
    #! Optional caller-owned telemetry correlation context
    *hash<auto> telemetry_context;
}

#! Top-level RAG pipeline configuration
public hashdecl RagConfig {
    #! Embedder configuration
    hash<EmbedderConfig> embedder;
    #! Vector store configuration
    hash<VectorStoreConfig> vector_store;
    #! Reranker configuration (optional — when omitted, retrieval returns vector-search ordering)
    *hash<RerankerConfig> reranker;
    #! Chunker configuration (used by ingest)
    hash<ChunkerConfig> chunker;
    #! Default top-K for retrieval (final returned count)
    int top_k = 10;
    #! Initial vector-search top-K before reranking (only when reranker is configured)
    int initial_retrieval_k = 50;
}

#! Optional hooks passed to RagPipeline::constructor()
/** Every field is optional and strictly additive — omitting the options hash
    preserves the behavior of earlier module versions.
*/
public hashdecl RagPipelineOptions {
    #! Optional query transformer (e.g. HyDE-style hypothetical-answer generation)
    /** When set, the raw query is passed through this callable and the result
        is used for embedding.  The reranker still sees the <b>original</b> query
        so that scoring semantics stay stable.
    */
    *code<string(string)> query_transformer;

    #! Optional cache for query embeddings
    /** When set, RagPipeline::retrieve() consults this cache before calling
        @ref AbstractEmbedder::encode() and populates it on cache misses.
        Cache keys are the exact string that would otherwise be passed to
        \c encode() — the transformer output when a \c query_transformer is
        configured, otherwise the raw query.
    */
    *AbstractEmbeddingCache embedding_cache;

    #! Explicit vector-search K before reranking
    /** When set <b>and</b> a reranker is configured, overrides the pipeline's
        \c initial_retrieval_k for the vector-store call.  The reranker still
        emits \c top_k results.  Use this to implement an over-retrieval
        multiplier (e.g. 5x top_k) without changing the pipeline default.
    */
    *int pre_rerank_top_k;

    #! Optional observer for pipeline operations
    *hash<RagTelemetryObserver> telemetry_observer;

    #! Optional caller-owned telemetry correlation context
    *hash<auto> telemetry_context;
}

#! A single chunk produced by a chunker
public hashdecl ChunkInfo {
    #! Sequential index of this chunk in the source document
    int index;
    #! The chunk text content
    string content;
    #! Approximate token count
    int token_count;
    #! Free-form metadata inherited from the source (page, heading, slide, etc.)
    *hash<auto> metadata;
}

#! A vector record stored in a vector store
public hashdecl VectorRecord {
    #! Unique record id
    string id;
    #! The dense vector
    list<float> vector;
    #! Free-form payload (stored alongside the vector for retrieval-time access)
    *hash<auto> payload;
}

#! A search hit returned by a vector store
public hashdecl VectorSearchResult {
    #! Record id
    string id;
    #! Similarity score (backend-defined; typically cosine in [0,1])
    float score;
    #! Stored payload
    *hash<auto> payload;
}

#! A reranker result
public hashdecl RerankResult {
    #! Original index in the input documents list
    int index;
    #! Relevance score (higher = more relevant)
    float score;
    #! The document text (echoed back for caller convenience)
    string document;
}

#! Normalized token usage for a reranker call
/** Populated by @ref AbstractReranker::rerankEx().  Cloud rerankers that
    report usage (Voyage, Cohere, Jina, an SGLang/gateway server that returns a
    \c usage block) set \c token_source to \c "provider"; local or
    non-reporting backends fall back to a length-based estimate and set
    \c token_source to \c "estimated".  \c total_tokens is the billable input
    token count (query + all candidate documents); reranker calls have no
    generated ("completion") tokens.
*/
public hashdecl RerankUsage {
    #! Total billable input tokens (query + candidate documents)
    int total_tokens = 0;
    #! Query-only token count when separable, otherwise @ref nothing
    *int query_tokens;
    #! Candidate-document token count when separable, otherwise @ref nothing
    *int document_tokens;
    #! \c "provider" when reported by the backend; \c "estimated" otherwise
    string token_source = "estimated";
}

#! The full outcome of a reranker call: ordered results plus token usage
/** Returned by @ref AbstractReranker::rerankEx() so callers that must account
    for reranking cost (token accounting / observability) get usage alongside
    the ranked results without a second call.  @ref AbstractReranker::rerank()
    remains available for callers that only need the ranked results.
*/
public hashdecl RerankOutcome {
    #! Reranked results ordered by descending score (see @ref RerankResult)
    list<hash<RerankResult>> results;
    #! Normalized token usage for the call (see @ref RerankUsage)
    hash<RerankUsage> usage;
}

#! A retrieval hit returned by RagPipeline::retrieve()
public hashdecl RetrievalHit {
    #! Stored chunk id
    string id;
    #! Final relevance score (post-reranking when a reranker is configured)
    float score;
    #! Chunk content
    string content;
    #! Free-form payload (typically the chunk's metadata)
    *hash<auto> payload;
}

#! Static metadata describing a registered RAG provider factory
/** Returned by @ref AbstractEmbedderFactory::getInfo(),
    @ref AbstractRerankerFactory::getInfo(), and
    @ref AbstractVectorStoreFactory::getInfo().
*/
public hashdecl RagProviderInfo {
    #! The backend / type string used to look up this provider
    string type;
    #! Human-readable name for diagnostics and discovery UIs
    string display_name;
    #! Module that supplies this provider (e.g. \c "OpenAiRestClient")
    *string module_name;
}

#! Abstract base class for text embedders
/** Concrete subclasses wrap a specific backend (local ONNX, OpenAI HTTP API,
    Voyage HTTP API, SGLang, BGE-M3 FastAPI, etc.) and translate text to
    fixed-dimension dense vectors.

    Implementations must be thread-safe — multiple threads may call
    @ref encode() and @ref encodeBatch() concurrently.

    @par Per-call options

    @ref encode() and @ref encodeBatch() accept an optional \c opts hash that
    can override per-call defaults; HTTP-backed embedders recognize:

    - \c timeout (\c *timeout) — request timeout for this call only
    - \c connect_timeout (\c *timeout) — connection timeout for this call only
    - \c max_retries (\c int) — retries per HTTP request after the initial attempt (default three)
    - \c retry_max_delay (\c timeout) — exponential-backoff cap (default 8s)
    - \c retry_timeout (\c timeout) — total budget for HTTP requests and backoff (default 30s)
    - \c telemetry_observer and \c telemetry_context — overrides for direct-call retry telemetry

    The effective total budget is the smaller of retry_timeout and a positive timeout. Batch slices
    and endpoint fallback share that budget, and successful slices are not replayed. Retry-After is
    honored as a minimum delay; when it cannot fit the remaining budget, the last error is propagated.
    The underlying RestRetryPolicy documents synchronous credential-acquisition timeout limitations.

    @par Example
    Disable retries for an interactive lookup or limit an ingestion batch to two retries:
    @code{.py}
    list<float> query = embedder.encodeQuery("invoice lookup", {"max_retries": 0, "timeout": 2s});
    list<list<float>> vectors = embedder.encodeDocuments(documents,
        {"max_retries": 2, "retry_max_delay": 1s, "timeout": 10s});
    @endcode

    Precedence: per-call \c opts > @ref EmbedderConfig defaults > REST client
    / connection default.

    @par Permanent vs transient backend errors

    HTTP backends classify their own \c REST-RESPONSE-ERROR exceptions via the
    private @ref isPermanentEmbedderConfigError() override.  When that returns
    @ref True (e.g. unknown model, model is not an embedding model), the
    embedder rethrows as @c EMBEDDER-MODEL-CONFIG-ERROR via
    @ref throwEmbedderModelConfigError() so callers can distinguish permanent
    misconfiguration from transient infrastructure failures (5xx, timeouts,
    rate limits) without parsing backend-specific JSON shapes.
*/
public class AbstractEmbedder {
    private {
        #! Optional token counter for chunk sizing (an object with int countTokens(string)); see @ref setTokenCounter()
        *object token_counter;
    }

    #! Encodes a single piece of text into a vector
    /** @param text the input text
        @param opts optional per-call options; recognized HTTP keys are
        \c timeout and \c connect_timeout (both \c *timeout), plus the retry and telemetry
        options documented on @ref AbstractEmbedder. Non-HTTP
        backends ignore \c opts.

        @return a dense vector of floats with length equal to @ref getDimension()
    */
    abstract list<float> encode(string text, *hash<auto> opts);

    #! Encodes a batch of texts into vectors
    /** @param texts the input texts
        @param opts optional per-call options; recognized HTTP keys are
        \c timeout and \c connect_timeout (both \c *timeout), plus the retry and telemetry
        options documented on @ref AbstractEmbedder. Non-HTTP
        backends ignore \c opts.

        @return a list of vectors in the same order as the input
    */
    abstract list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts);

    #! Creates a shared REST retry budget for all HTTP requests in one encodeBatch() call
    private hash<auto> embedderRequestOptions(hash<EmbedderConfig> config, *hash<auto> opts, string backend) {
        hash<auto!> rv = opts ?? {};
        hash<RestClientIo::RestRetryOptions> policy = <RestClientIo::RestRetryOptions>{
            "max_retries": opts.max_retries ?? config.max_retries,
            "retry_max_delay": opts.retry_max_delay ?? config.retry_max_delay,
            "retry_timeout": opts.retry_timeout ?? config.retry_timeout,
            "timeout": opts.timeout ?? config.timeout,
            "retry_callback": sub (hash<RestClientIo::RestRetryEvent> event) {
                notifyEmbedderRetry(config, opts ?? {}, backend, event);
            },
        };
        rv._embedder_retry_policy = newEmbedderRetryPolicy(policy);
        return rv;
    }

    #! Creates the transient-failure retry policy used by @ref embedderRequestOptions()
    /** Backends that handle some failures themselves (for example, rate-limit rejections paced by a
        client-side limiter) override this to return a policy that does not retry those failures.

        @param options the effective retry options

        @return a new retry policy whose total budget starts now
    */
    private RestClientIo::RestRetryPolicy newEmbedderRetryPolicy(hash<RestClientIo::RestRetryOptions> options) {
        return new RestClientIo::RestRetryPolicy(options);
    }

    #! Reports safe retry metadata through the existing observer contract
    private notifyEmbedderRetry(hash<EmbedderConfig> config, hash<auto> opts, string backend,
            hash<RestClientIo::RestRetryEvent> retry) {
        *hash<RagTelemetryObserver> observer = opts.telemetry_observer ?? config.telemetry_observer;
        if (!observer) {
            return;
        }
        hash<RagTelemetryEvent> event = <RagTelemetryEvent>{
            "type": "error",
            "operation": "embed",
            "timestamp": now_us(),
            "backend": backend,
            "model": config.model ?? getModel(),
            "telemetry_context": opts.telemetry_context ?? config.telemetry_context,
            "status": "error",
            "error": {"err": retry.err, "retryable": True, "attempt": retry.attempt,
                "status_code": retry.status_code},
            "attributes": {"attempt": retry.attempt, "next_attempt": retry.attempt + 1,
                "retry_delay_ms": retry.delay_ms},
        };
        foreach *code<nothing(hash<RagTelemetryEvent>)> cb in
                ((observer.event_callback, observer.error_callback)) {
            if (cb) {
                try {
                    cb(event);
                } catch (hash<ExceptionInfo> observer_error) {
                    if (inlist(observer_error.err, ("THREAD-CANCELLED", "PROGRAM-INTERRUPTED"))) {
                        rethrow;
                    }
                }
            }
        }
    }

    #! Returns the preferred number of texts per bulk embedding request
    /** This is an advisory provider-request size for callers that own a large
        corpus and need to split it before calling @ref encodeBatch().  It is
        deliberately conservative by default: concrete providers should
        override it only when their documented service limits support a larger
        request.  It is independent of vector-store write batch sizes.

        @return a positive preferred input count; the default is 10
    */
    int getPreferredBatchSize() {
        return 10;
    }

    #! Returns True if @ref encodeBatch() splits its inputs into provider requests by the provider's limits
    /** An embedder that packs and paces its own requests (for example
        @ref QoreRagUtils::VoyageEmbedder "VoyageEmbedder") can be given a whole corpus step, up to
        @ref getPreferredBatchSize() inputs, so callers need not choose a request size for it.

        @return False by default
    */
    bool packsRequests() {
        return False;
    }

    #! Returns the embedding dimension produced by this backend
    /** Used by callers to size vector store columns / Qdrant collections.

        @return the vector dimension
    */
    abstract int getDimension();

    #! Returns the model name in use (informational)
    *string getModel() {
        return NOTHING;
    }

    #! Declares whether this embedder needs a client-side tokenizer for chunk sizing, and which one
    /** Default: not required.  HuggingFace-tokenized backends (e.g. SGLang-served
        Qwen3-Embedding, bge-m3, local ONNX models) override this to declare
        \c required and the tokenizer \c id (typically the model name); a
        consumer-supplied @ref AbstractTokenizerResolver maps it to a parsed
        \c tokenizer.json that becomes this embedder's token counter (see
        @ref setTokenCounter()).  Providers without a usable client-side tokenizer
        (e.g. Voyage, Gemini) keep the default so callers fall back to a heuristic.

        @return the tokenizer requirement for this embedder
    */
    hash<TokenizerRequirement> getTokenizerRequirement() {
        return <TokenizerRequirement>{"required": False};
    }

    #! Returns the token counter for chunk sizing, or @ref NOTHING if none is set
    /** When set (typically a @ref QoreTokenizerUtils::TokenCounter "TokenCounter", but any object
        with an <tt>int countTokens(string)</tt> method works), a chunker can size
        chunks in this embedding model's own tokens — see
        @ref AbstractChunker::setTokenCounter().  Typed as \c *object so this
        provider-neutral module does not depend on the tokenizer module.  The
        counter must be safe for concurrent \c countTokens() calls or owned
        per-pipeline (callers typically build a fresh one per pipeline).
    */
    *object getTokenCounter() {
        return token_counter;
    }

    #! Sets the token counter used for chunk sizing
    /** @param tc the token counter (an object with <tt>int countTokens(string)</tt>),
        or @ref NOTHING to clear it
    */
    setTokenCounter(*object tc) {
        token_counter = tc;
    }

    #! Encodes a query, signalling the query role for asymmetric/instruction-tuned models
    /** Forces \c input_type "query" in the per-call opts and delegates to
        @ref encode().  Asymmetric embedders (e.g. SGLang-served Qwen3-Embedding)
        prepend @ref EmbedderConfig::query_instruction; symmetric embedders ignore
        the hint and behave exactly like @ref encode().  The pipeline calls this on
        the query side so query/document asymmetry is honored end-to-end.

        @param text the query text
        @param opts optional per-call options (merged; \c input_type is forced to "query")

        @return a dense vector of length @ref getDimension()
    */
    list<float> encodeQuery(string text, *hash<auto> opts) {
        return encode(text, (opts ?? {}) + {"input_type": "query"});
    }

    #! Encodes documents/passages, signalling the document role for asymmetric models
    /** Forces \c input_type "document" in the per-call opts and delegates to
        @ref encodeBatch().  Asymmetric embedders prepend
        @ref EmbedderConfig::document_instruction (usually unset); symmetric
        embedders ignore the hint and behave exactly like @ref encodeBatch().

        @param texts the document/passage texts
        @param opts optional per-call options (merged; \c input_type is forced to "document")

        @return a list of vectors in input order
    */
    list<list<float>> encodeDocuments(list<string> texts, *hash<auto> opts) {
        return encodeBatch(texts, (opts ?? {}) + {"input_type": "document"});
    }

    #! Truncates a vector to \a dim and L2-renormalizes it (Matryoshka / MRL output reduction)
    /** Helper for Matryoshka-capable subclasses that emit a larger native
        dimension than @ref EmbedderConfig::dimension requests.  A no-op when
        \a dim is @ref NOTHING or not smaller than the vector length.

        @param vec the native vector
        @param dim the desired output dimension (@ref EmbedderConfig::dimension)

        @return the truncated, renormalized vector (or \a vec unchanged)
    */
    private list<float> truncateAndRenormalize(list<float> vec, *int dim) {
        if (!dim || dim >= vec.size()) {
            return vec;
        }
        list<float> t = vec[0..(dim - 1)];
        float sumsq = 0.0;
        foreach float x in (t) {
            sumsq += x * x;
        }
        float n = sqrt(sumsq);
        list<float> out = ();
        foreach float x in (t) {
            push out, n > 0.0 ? x / n : x;
        }
        return out;
    }

    #! Classifies a backend exception as a permanent model/configuration failure
    /** Concrete subclasses for HTTP backends override this to recognize
        backend-specific permanent-failure shapes (e.g. unknown model,
        model is not an embedding model, body type \c BadRequestError or
        \c InvalidModelError).  The default implementation returns @ref False
        so that any exception propagates as a transient REST error unless the
        subclass classifies it.

        Called from each subclass's @ref encodeBatch() catch block; when this
        returns @ref True, the subclass calls
        @ref throwEmbedderModelConfigError() to rethrow as
        @c EMBEDDER-MODEL-CONFIG-ERROR with a normalized \c arg shape.

        @param ex the original exception (typically \c REST-RESPONSE-ERROR)

        @return @ref True if the error is permanent (block create / surface
        misconfiguration); @ref False if transient (warn and continue)
    */
    private bool isPermanentEmbedderConfigError(hash<ExceptionInfo> ex) {
        return False;
    }

    #! Rethrows a backend exception as a normalized \c EMBEDDER-MODEL-CONFIG-ERROR
    /** Subclasses call this from their @ref encodeBatch() catch block once
        @ref isPermanentEmbedderConfigError() has returned @ref True.

        The thrown exception preserves the original error metadata so callers
        can construct a usable error message:

        - \c arg.backend — backend identifier (e.g. \c "openai", \c "voyage")
        - \c arg.model — model name (or @ref NOTHING)
        - \c arg.status_code — HTTP status code from the original error
        - \c arg.body — response body from the original error
        - \c arg.original_err — \c ex.err of the original exception
        - \c arg.original_desc — \c ex.desc of the original exception

        @param orig the original \c REST-RESPONSE-ERROR exception
        @param backend backend identifier
        @param model model name (or @ref NOTHING)

        @throw EMBEDDER-MODEL-CONFIG-ERROR always
    */
    private throwEmbedderModelConfigError(hash<ExceptionInfo> orig,
            string backend, *string model) {
        *int status_code = orig.arg.status_code;
        auto body = orig.arg.body;
        throw "EMBEDDER-MODEL-CONFIG-ERROR",
            sprintf("%s: model %y rejected by backend (HTTP %s): %s",
                backend, model ?? "<unset>",
                exists status_code ? string(status_code) : "?",
                orig.desc),
            {
                "backend": backend,
                "model": model,
                "status_code": status_code,
                "body": body,
                "original_err": orig.err,
                "original_desc": orig.desc,
                "attempts": orig.arg.attempts ?? 1,
            };
    }
}

#! Abstract base class for cross-encoder rerankers
/** Concrete subclasses wrap a specific backend (local ONNX cross-encoder,
    Voyage rerank API, gateway HTTP endpoint, etc.) and score a list of
    candidate documents against a query.

    Implementations must be thread-safe.
*/
public class AbstractReranker {
    #! Re-ranks a list of documents against a query and returns the top-K
    /** @param query the query text
        @param documents the candidate documents (typically from a first-stage vector search)
        @param top_k how many results to return after reranking; if greater than
            \c documents.size(), all documents are returned
        @param opts optional per-call backend-specific options.  Concrete
            rerankers free to ignore unknown keys.  Reserved keys recognized
            by the cloud reranker family (Cohere, Voyage, Jina):
            - \c max_chunks_per_doc (\c int): when documents are longer than
              the model context, the maximum number of chunks the backend
              should split a document into; backend-defined default
            - \c rank_fields (\c list<string>): when documents are
              structured (passed as JSON strings or hashes), the fields the
              backend should attend to during scoring
            - \c truncation (\c string): backend-specific truncation
              strategy (e.g. Voyage's \c "STRING", \c "NONE")
            - \c return_documents (\c bool): when explicitly \c False, the
              caller is signalling it doesn't need document text echoed
              back; concrete implementations are free to echo it anyway

        @return list of @ref RerankResult hashes ordered by descending score; the
            \c index field maps each result back to its position in the input
    */
    abstract list<hash<RerankResult>> rerank(string query, list<string> documents,
            int top_k, *hash<auto> opts);

    #! Re-ranks documents and returns the results together with token usage
    /** Same contract as @ref rerank(), but returns a @ref RerankOutcome so
        callers that must account for reranking cost (token accounting,
        observability) receive normalized token usage alongside the ranked
        results without issuing a second call.

        The base implementation calls @ref rerank() and reports a length-based
        token estimate (\c token_source \c "estimated").  Backends that receive
        a provider-reported \c usage block (Voyage, Cohere, Jina, an
        SGLang/gateway server that returns usage) override this method to return
        the real counts with \c token_source \c "provider".

        @param query the query text
        @param documents the candidate documents
        @param top_k how many results to return after reranking
        @param opts optional per-call backend-specific options (see @ref rerank())

        @return a @ref RerankOutcome with the ranked results and token usage

        @since %QoreRagTypes 1.0
    */
    hash<RerankOutcome> rerankEx(string query, list<string> documents,
            int top_k, *hash<auto> opts) {
        list<hash<RerankResult>> results = rerank(query, documents, top_k, opts);
        return <RerankOutcome>{
            "results": results,
            "usage": estimateRerankUsage(query, documents),
        };
    }

    #! Returns the model name in use (informational)
    *string getModel() {
        return NOTHING;
    }

    #! Estimates reranker token usage from query + candidate document lengths
    /** Uses the module-wide 4-byte-per-token heuristic; the same estimate the
        RAG telemetry summaries use.  Backends without a provider-reported usage
        block use this so every reranker call still yields a non-zero billable
        token count for token accounting.

        @param query the query text
        @param documents the candidate documents

        @return a @ref RerankUsage with \c token_source \c "estimated"
    */
    static hash<RerankUsage> estimateRerankUsage(string query, list<string> documents) {
        int query_tokens = (query.length() + 3) / 4;
        int doc_bytes = 0;
        foreach string doc in (documents) {
            doc_bytes += doc.length();
        }
        int doc_tokens = (doc_bytes + 3) / 4;
        return <RerankUsage>{
            "total_tokens": query_tokens + doc_tokens,
            "query_tokens": query_tokens,
            "document_tokens": doc_tokens,
            "token_source": "estimated",
        };
    }
}

#! Abstract base class for document chunkers
/** Concrete subclasses split text content into chunks using a specific
    strategy (structured, semantic, fixed-size).

    Implementations must be thread-safe.
*/
public class AbstractChunker {
    private {
        #! Optional token counter (an object with int countTokens(string)); see @ref setTokenCounter()
        *object token_counter;
    }

    #! Splits content into chunks
    /** @param content the source document text
        @param metadata optional metadata that should be inherited by every chunk
            (page, heading, slide, source filename, etc.)

        @return list of @ref ChunkInfo hashes; chunk indices are 0-based and
            ascending in source order
    */
    abstract list<hash<ChunkInfo>> chunk(string content, *hash<auto> metadata);

    #! Returns the strategy name (e.g. "structured", "semantic", "fixed")
    abstract string getStrategy();

    #! Sets the token counter used to size chunks
    /** When set, @ref approximateTokens() counts tokens with this counter (the
        embedding model's own tokenizer) instead of the character heuristic, so
        chunks are sized in the right model's tokens.  A @ref QoreRagUtils::RagPipeline "RagPipeline"
        auto-injects its embedder's counter (@ref AbstractEmbedder::getTokenCounter())
        here at construction.

        @param tc the token counter (an object with <tt>int countTokens(string)</tt>),
        or @ref NOTHING to clear it
    */
    setTokenCounter(*object tc) {
        token_counter = tc;
    }

    #! Returns the token counter, or @ref NOTHING if none is set
    *object getTokenCounter() {
        return token_counter;
    }

    #! Token count for a string
    /** Uses the configured token counter (see @ref setTokenCounter()) for an exact
        count in the embedding model's tokens; falls back to a 4-chars-per-token
        heuristic when no counter is set.  Subclasses backed by their own tokenizer
        may still override.
    */
    int approximateTokens(string text) {
        if (token_counter) {
            return token_counter.countTokens(text);
        }
        return (text.length() / 4) ?? 0;
    }
}

#! Abstract base class for query-embedding caches
/** A RagPipeline that is wired with an AbstractEmbeddingCache will consult
    the cache for the query vector before calling
    @ref AbstractEmbedder::encode() and will populate the cache with every
    miss.  Cache keys are the raw query strings (or transformer outputs,
    when a \c query_transformer is configured — whichever string is about
    to be encoded).

    Implementations must be thread-safe; the pipeline may call
    @ref get() and @ref put() from multiple threads concurrently.
*/
public class AbstractEmbeddingCache {
    #! Looks up a cached embedding for the given key
    /** @param key the cache key (the exact string that would otherwise be
            passed to @ref AbstractEmbedder::encode())

        @return the cached embedding, or @ref NOTHING if not present
    */
    abstract *list<float> get(string key);

    #! Stores an embedding under the given key
    /** @param key the cache key
        @param vector the embedding vector to cache
    */
    abstract put(string key, list<float> vector);

    #! Optional size hint — returns the current number of cached entries
    /** Default returns -1, meaning "unknown".

        @return the entry count or -1 if the implementation does not track it
    */
    int size() {
        return -1;
    }
}

#! Abstract base class for vector stores (Qdrant, pgvector, etc.)
/** Concrete subclasses wrap a specific backend and translate calls into
    upserts and similarity searches.

    Implementations must be thread-safe.
*/
public class AbstractVectorStore {
    #! Upserts a batch of vector records
    /** @param records the records to insert or update (keyed by \c id)
    */
    abstract upsert(list<hash<VectorRecord>> records);

    #! Deletes records by id
    /** @param ids the record ids to remove
    */
    abstract deleteByIds(list<string> ids);

    #! Searches for the K most similar vectors to a query vector
    /** @param query_vector the query embedding
        @param k how many results to return
        @param filter optional payload filter.  Implementations should support
            the portable \c payload_eq form, for example:
            @code{.py}
{"payload_eq": {"group_namespace": 123, "index_id": "log-errors"}}
            @endcode
            Backend-native filters remain supported by concrete providers for
            advanced callers.

        @return list of @ref VectorSearchResult hashes ordered by descending similarity
    */
    abstract list<hash<VectorSearchResult>> search(list<float> query_vector,
        int k, *hash<auto> filter);

    #! Returns the configured collection / table name
    abstract string getCollection();

    #! Returns the vector dimension this store expects
    abstract int getDimension();
}

#! Abstract factory for an embedder
public class AbstractEmbedderFactory {
    #! Returns the backend identifier (e.g. \c "openai")
    abstract string getType();

    #! Returns a human-readable display name
    abstract string getDisplayName();

    #! Creates an embedder instance from an @ref EmbedderConfig
    abstract AbstractEmbedder create(hash<EmbedderConfig> config);

    #! Returns static information about the embedder this factory creates
    hash<RagProviderInfo> getInfo() {
        return <RagProviderInfo>{
            "type": getType(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
        };
    }
}

#! Abstract factory for a reranker
public class AbstractRerankerFactory {
    #! Returns the backend identifier (e.g. \c "voyage")
    abstract string getType();

    #! Returns a human-readable display name
    abstract string getDisplayName();

    #! Creates a reranker instance from a @ref RerankerConfig
    abstract AbstractReranker create(hash<RerankerConfig> config);

    #! Returns static information about the reranker this factory creates
    hash<RagProviderInfo> getInfo() {
        return <RagProviderInfo>{
            "type": getType(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
        };
    }
}

#! Abstract factory for a vector store
public class AbstractVectorStoreFactory {
    #! Returns the backend identifier (e.g. \c "qdrant")
    abstract string getType();

    #! Returns a human-readable display name
    abstract string getDisplayName();

    #! Creates a vector store instance from a @ref VectorStoreConfig
    abstract AbstractVectorStore create(hash<VectorStoreConfig> config);

    #! Returns static information about the vector store this factory creates
    hash<RagProviderInfo> getInfo() {
        return <RagProviderInfo>{
            "type": getType(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
        };
    }
}

#! Abstract factory for a chunker
public class AbstractChunkerFactory {
    #! Returns the strategy identifier (e.g. \c "structured", \c "llama-parse")
    /** Matches @ref ChunkerConfig::strategy for registry lookup.
    */
    abstract string getStrategy();

    #! Returns a human-readable display name
    abstract string getDisplayName();

    #! Creates a chunker instance from a @ref ChunkerConfig
    abstract AbstractChunker create(hash<ChunkerConfig> config);

    #! Returns static information about the chunker this factory creates
    hash<RagProviderInfo> getInfo() {
        return <RagProviderInfo>{
            "type": getStrategy(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
        };
    }
}

#! Central registry of RAG provider factories (embedders, rerankers, vector stores)
/** Mirrors the FactoryMap pattern from
    @ref DataProvider::DataProvider::registerFactory "DataProvider::DataProvider::registerFactory" and the LLM-side
    @ref QoreLlmUtils::LlmProviderRegistry "LlmProviderRegistry".  Each of the three role-specific
    factory maps points a backend / type string at the Qore module that
    supplies the matching factory; the module is lazy-loaded on first lookup.

    Backends whose factory ships with @ref QoreRagUtils itself (e.g.
    \c "local-onnx", \c "http-gateway") are registered when QoreRagUtils'
    \c init block runs.
*/
public class RagProviderRegistry {
    public {
        #! Map of embedder backend names to providing modules
        const hash<string, string> EmbedderModuleMap = {
            "openai":     "OpenAiRestClient",
            "gemini":     "GeminiRestClient",
            "voyage":     "VoyageRestClient",
            "sglang":     "SGLangRestClient",
            "bge-m3":     "BgeM3RestClient",
            "local-onnx": "QoreRagUtils",
            "bedrock":    "BedrockRestClient",
            "vertex-ai":  "VertexAiRestClient",
            "together":   "TogetherRestClient",
            "fireworks":  "FireworksRestClient",
            "ollama":     "OllamaRestClient",
            "jina":       "JinaRestClient",
            "cohere":     "CohereRestClient",
            "mistral":    "MistralRestClient",
        };

        #! Map of reranker backend names to providing modules
        const hash<string, string> RerankerModuleMap = {
            "voyage":       "VoyageRestClient",
            "local-onnx":   "QoreRagUtils",
            "http-gateway": "QoreRagUtils",
            "sglang":       "QoreRagUtils",
            "jina":         "JinaRestClient",
            "cohere":       "CohereRestClient",
        };

        #! Map of vector-store backend names to providing modules
        /** Each entry maps a backend / type string to the Qore module that
            supplies the matching factory.  Additional vector stores can be
            registered at runtime via @ref registerVectorStoreFactory().
        */
        const hash<string, string> VectorStoreModuleMap = {
            "chroma":      "ChromaRestClient",
            "milvus":      "MilvusRestClient",
            "mongo-atlas": "MongoDbDataProvider",
            "opensearch":  "OpenSearchDataProvider",
            "pgvector":    "QoreRagUtils",
            "pinecone":    "PineconeRestClient",
            "qdrant":      "QdrantDataProvider",
            "weaviate":    "WeaviateRestClient",
        };

        #! Map of chunker strategy names to providing modules
        /** Each entry maps a strategy string to the Qore module that
            supplies the matching factory.  Additional chunkers can be
            registered at runtime via @ref registerChunkerFactory().
        */
        const hash<string, string> ChunkerModuleMap = {
            "structured":   "QoreRagUtils",
            "fixed":        "QoreRagUtils",
            "llama-parse":  "LlamaParseRestClient",
            "unstructured": "UnstructuredRestClient",
        };
    }

    private {
        static hash<string, AbstractEmbedderFactory> embedder_cache = {};
        static hash<string, AbstractRerankerFactory> reranker_cache = {};
        static hash<string, AbstractVectorStoreFactory> vector_store_cache = {};
        static hash<string, AbstractChunkerFactory> chunker_cache = {};
        static Mutex registry_lock();
    }

    #! Registers an embedder factory
    /** @param factory the new embedder factory

        @throw RAG-CONFIG-ERROR a factory for the same backend is already registered
    */
    static registerEmbedderFactory(AbstractEmbedderFactory factory) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        string type = factory.getType();
        if (embedder_cache{type}) {
            throw "RAG-CONFIG-ERROR",
                sprintf("embedder factory for %y has already been registered",
                    type);
        }
        embedder_cache{type} = factory;
    }

    #! Registers a reranker factory
    static registerRerankerFactory(AbstractRerankerFactory factory) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        string type = factory.getType();
        if (reranker_cache{type}) {
            throw "RAG-CONFIG-ERROR",
                sprintf("reranker factory for %y has already been registered",
                    type);
        }
        reranker_cache{type} = factory;
    }

    #! Registers a vector-store factory
    static registerVectorStoreFactory(AbstractVectorStoreFactory factory) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        string type = factory.getType();
        if (vector_store_cache{type}) {
            throw "RAG-CONFIG-ERROR",
                sprintf("vector-store factory for %y has already been "
                    "registered", type);
        }
        vector_store_cache{type} = factory;
    }

    #! Registers a chunker factory
    /** @param factory the new chunker factory

        @throw RAG-CONFIG-ERROR a factory for the same strategy is already registered
    */
    static registerChunkerFactory(AbstractChunkerFactory factory) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        string type = factory.getStrategy();
        if (chunker_cache{type}) {
            throw "RAG-CONFIG-ERROR",
                sprintf("chunker factory for %y has already been registered",
                    type);
        }
        chunker_cache{type} = factory;
    }

    #! Removes an embedder factory (intended for tests)
    static deregisterEmbedderFactory(string type) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        remove embedder_cache{type};
    }

    #! Removes a reranker factory (intended for tests)
    static deregisterRerankerFactory(string type) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        remove reranker_cache{type};
    }

    #! Removes a vector-store factory (intended for tests)
    static deregisterVectorStoreFactory(string type) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        remove vector_store_cache{type};
    }

    #! Removes a chunker factory (intended for tests)
    static deregisterChunkerFactory(string type) {
        registry_lock.lock();
        on_exit registry_lock.unlock();
        remove chunker_cache{type};
    }

    #! Returns the embedder factory for the given backend, lazy-loading its module if needed
    static *AbstractEmbedderFactory getEmbedderFactory(string type) {
        if (embedder_cache{type}) {
            return embedder_cache{type};
        }
        *string module_name = EmbedderModuleMap{type};
        if (!module_name) {
            return NOTHING;
        }
        try {
            load_module(module_name);
        } catch (hash<ExceptionInfo> ex) {
            throw "RAG-CONFIG-ERROR",
                sprintf("cannot load provider module %y for embedder %y: %s",
                    module_name, type, ex.desc), ex;
        }
        return embedder_cache{type};
    }

    #! Returns the reranker factory for the given backend, lazy-loading its module if needed
    static *AbstractRerankerFactory getRerankerFactory(string type) {
        if (reranker_cache{type}) {
            return reranker_cache{type};
        }
        *string module_name = RerankerModuleMap{type};
        if (!module_name) {
            return NOTHING;
        }
        try {
            load_module(module_name);
        } catch (hash<ExceptionInfo> ex) {
            throw "RAG-CONFIG-ERROR",
                sprintf("cannot load provider module %y for reranker %y: %s",
                    module_name, type, ex.desc), ex;
        }
        return reranker_cache{type};
    }

    #! Returns the vector-store factory for the given backend, lazy-loading its module if needed
    static *AbstractVectorStoreFactory getVectorStoreFactory(string type) {
        if (vector_store_cache{type}) {
            return vector_store_cache{type};
        }
        *string module_name = VectorStoreModuleMap{type};
        if (!module_name) {
            return NOTHING;
        }
        try {
            load_module(module_name);
        } catch (hash<ExceptionInfo> ex) {
            throw "RAG-CONFIG-ERROR",
                sprintf("cannot load provider module %y for vector store %y: %s",
                    module_name, type, ex.desc), ex;
        }
        return vector_store_cache{type};
    }

    #! Returns the chunker factory for the given strategy, lazy-loading its module if needed
    static *AbstractChunkerFactory getChunkerFactory(string type) {
        if (chunker_cache{type}) {
            return chunker_cache{type};
        }
        *string module_name = ChunkerModuleMap{type};
        if (!module_name) {
            return NOTHING;
        }
        try {
            load_module(module_name);
        } catch (hash<ExceptionInfo> ex) {
            throw "RAG-CONFIG-ERROR",
                sprintf("cannot load provider module %y for chunker %y: %s",
                    module_name, type, ex.desc), ex;
        }
        return chunker_cache{type};
    }

    #! Returns the embedder factory or throws an exception
    static AbstractEmbedderFactory getEmbedderFactoryEx(string type) {
        *AbstractEmbedderFactory f = getEmbedderFactory(type);
        if (!f) {
            throw "RAG-CONFIG-ERROR",
                sprintf("embedder backend %y is unknown; registered backends: "
                    "%y; backends available via lazy module load: %y",
                    type, keys embedder_cache, keys EmbedderModuleMap);
        }
        return f;
    }

    #! Returns the reranker factory or throws an exception
    static AbstractRerankerFactory getRerankerFactoryEx(string type) {
        *AbstractRerankerFactory f = getRerankerFactory(type);
        if (!f) {
            throw "RAG-CONFIG-ERROR",
                sprintf("reranker backend %y is unknown; registered backends: "
                    "%y; backends available via lazy module load: %y",
                    type, keys reranker_cache, keys RerankerModuleMap);
        }
        return f;
    }

    #! Returns the vector-store factory or throws an exception
    static AbstractVectorStoreFactory getVectorStoreFactoryEx(string type) {
        *AbstractVectorStoreFactory f = getVectorStoreFactory(type);
        if (!f) {
            throw "RAG-CONFIG-ERROR",
                sprintf("vector-store backend %y is unknown; registered "
                    "backends: %y", type, keys vector_store_cache);
        }
        return f;
    }

    #! Returns the chunker factory or throws an exception
    static AbstractChunkerFactory getChunkerFactoryEx(string type) {
        *AbstractChunkerFactory f = getChunkerFactory(type);
        if (!f) {
            throw "RAG-CONFIG-ERROR",
                sprintf("chunker strategy %y is unknown; registered "
                    "strategies: %y; strategies available via lazy module "
                    "load: %y",
                    type, keys chunker_cache, keys ChunkerModuleMap);
        }
        return f;
    }

    #! Constructs an embedder for the given @ref EmbedderConfig
    /** Convenience wrapper that resolves the backend via
        @ref EmbedderConfig::backend, looks up the factory (lazy-loading
        its module if needed), and calls its \c create() method.

        @param config the embedder configuration

        @return a concrete @ref AbstractEmbedder

        @throw RAG-CONFIG-ERROR @ref EmbedderConfig::backend is missing or unknown
    */
    static AbstractEmbedder createEmbedder(hash<EmbedderConfig> config) {
        if (!config.backend.val()) {
            throw "RAG-CONFIG-ERROR",
                "EmbedderConfig.backend is required for factory lookup";
        }
        return getEmbedderFactoryEx(config.backend).create(config);
    }

    #! Constructs a reranker for the given @ref RerankerConfig
    static AbstractReranker createReranker(hash<RerankerConfig> config) {
        if (!config.backend.val()) {
            throw "RAG-CONFIG-ERROR",
                "RerankerConfig.backend is required for factory lookup";
        }
        return getRerankerFactoryEx(config.backend).create(config);
    }

    #! Constructs a vector store for the given @ref VectorStoreConfig
    static AbstractVectorStore createVectorStore(hash<VectorStoreConfig> config) {
        if (!config.backend.val()) {
            throw "RAG-CONFIG-ERROR",
                "VectorStoreConfig.backend is required for factory lookup";
        }
        return getVectorStoreFactoryEx(config.backend).create(config);
    }

    #! Constructs a chunker for the given @ref ChunkerConfig
    /** Convenience wrapper that resolves the strategy via
        @ref ChunkerConfig::strategy, looks up the factory (lazy-loading
        its module if needed), and calls its \c create() method.

        @param config the chunker configuration

        @return a concrete @ref AbstractChunker

        @throw RAG-CONFIG-ERROR @ref ChunkerConfig::strategy is missing or unknown
    */
    static AbstractChunker createChunker(hash<ChunkerConfig> config) {
        if (!config.strategy.val()) {
            throw "RAG-CONFIG-ERROR",
                "ChunkerConfig.strategy is required for factory lookup";
        }
        return getChunkerFactoryEx(config.strategy).create(config);
    }

    #! Returns the list of currently-registered embedder backend strings
    static list<string> knownEmbedderBackends() {
        return keys embedder_cache;
    }

    #! Returns the list of currently-registered reranker backend strings
    static list<string> knownRerankerBackends() {
        return keys reranker_cache;
    }

    #! Returns the list of currently-registered vector-store backend strings
    static list<string> knownVectorStoreBackends() {
        return keys vector_store_cache;
    }

    #! Returns the list of currently-registered chunker strategy strings
    static list<string> knownChunkerStrategies() {
        return keys chunker_cache;
    }
}

} # namespace QoreRagUtils
