%modern

%requires Logger
%requires AsyncSocketIo
%requires HttpUtil
%requires Mime

module HttpClientIo {
    version = "1.0";
    desc = "Unified HTTP/1.1, HTTP/2, and HTTP/3 client I/O";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Module initialization
    };
}

/** @mainpage HttpClientIo Module

    @tableofcontents

    @section httpclientiointro Introduction

    The %HttpClientIo module provides a unified API for HTTP/1.1, HTTP/2, and HTTP/3 client I/O,
    enabling multiple concurrent streams on a single connection (HTTP/2, HTTP/3) or serial
    request/response exchanges (HTTP/1.1) regardless of the underlying transport protocol.

    Features:
    - **Protocol auto-selection**: race HTTP/3 and HTTP/2 with happy eyeballs for HTTPS,
      preferring HTTP/3 when available, and falling back to HTTP/1.1 for endpoints that
      complete the TLS handshake but refuse HTTP/2 via ALPN
    - **HTTP/1.1 support**: Serial request/response with keep-alive; connection manager creates
      multiple connections for concurrent requests
    - **True multiplexing**: Multiple concurrent streams on a single connection (HTTP/2, HTTP/3)
    - **Connection pooling**: Shared connections across multiple clients
    - **Async I/O**: All I/O driven by AsyncSocketIoController (epoll/kqueue); sync \c request()
      blocks the caller via Future while the controller event loop handles actual I/O
    - **Sync and async APIs**: Blocking and Future-based interfaces
    - **Streaming support**: WebSocket and SSE over HTTP/1.1, HTTP/2, and HTTP/3
    - **Connection migration**: QUIC connection migration for HTTP/3
    - **UNIX domain sockets**: plain HTTP/1.1 to a local server listening on a UNIX domain socket, addressed
      like @ref Qore::HTTPClient "HTTPClient" with a \c socket= URL

    @section httpclientio_components Components

    - @ref HttpClientIo::HttpClientConnectionManager "HttpClientConnectionManager" - Unified connection pool with protocol auto-selection
    - @ref HttpClientIo::HttpClientConnection "HttpClientConnection" - Abstract base for protocol connections
    - @ref HttpClientIo::Http1ClientConnection "Http1ClientConnection" - HTTP/1.1 connection (TCP, optionally TLS)
    - @ref HttpClientIo::Http2ClientConnection "Http2ClientConnection" - HTTP/2 connection (TCP + TLS)
    - @ref HttpClientIo::Http3ClientConnection "Http3ClientConnection" - HTTP/3 connection (QUIC)
    - @ref HttpClientIo::HttpClientStreamHandle "HttpClientStreamHandle" - Abstract base for stream handles
    - @ref HttpClientIo::Http1ClientStreamHandle "Http1ClientStreamHandle" - HTTP/1.1 stream handle
    - @ref HttpClientIo::Http2ClientStreamHandle "Http2ClientStreamHandle" - HTTP/2 stream handle (+ streaming)
    - @ref HttpClientIo::Http3ClientStreamHandle "Http3ClientStreamHandle" - HTTP/3 stream handle
    - @ref HttpClientIo::HttpClientPollOperation "HttpClientPollOperation" - Abstract base for poll operations
    - @ref HttpClientIo::Http1ClientPollOperation "Http1ClientPollOperation" - HTTP/1.1 poll operation (serial)
    - @ref HttpClientIo::Http2ClientPollOperation "Http2ClientPollOperation" - HTTP/2 poll operation
    - @ref HttpClientIo::Http3ClientPollOperation "Http3ClientPollOperation" - HTTP/3 poll operation

    @section httpclientio_usage Usage

    @par Basic Usage (sync API, auto protocol selection)
    @code{.py}
%requires HttpClientIo

# Create a connection manager (default: auto protocol selection)
# The manager auto-creates an AsyncSocketIoController with autostop=True
HttpClientConnectionManager manager();

# Synchronous request - protocol selected automatically
# I/O is driven by the controller's event loop; request() blocks via Future
hash<HttpClientResponseInfo> resp = manager.request(
    "https://example.com", "GET", "/api/resource");
printf("Status: %d, Protocol: %s\n", resp.status_code, resp.protocol);

manager.closeAll();
    @endcode

    @par Async Usage (Future API)
    @code{.py}
%requires HttpClientIo

# Create manager (controller auto-created)
HttpClientConnectionManager manager();

# Submit async request — returns a Future
hash<auto> result = manager.submitRequestAsync("https://example.com", "GET", "/api/resource");
hash<auto> response = result.future.get(30s);
printf("Status: %d\n", response.status_code);

manager.closeAll();
    @endcode

    @par Forced Protocol Selection
    @code{.py}
%requires HttpClientIo

# Force HTTP/1.1
auto mgr_h1 = new HttpClientConnectionManager({"protocol": "h1"});

# Force HTTP/2 only
auto mgr_h2 = new HttpClientConnectionManager({"protocol": "h2"});

# Force HTTP/3 only (HTTPS required)
auto mgr_h3 = new HttpClientConnectionManager({"protocol": "h3"});
    @endcode

    @par UNIX Domain Sockets
    Give the URL-encoded absolute socket path as the host of a \c socket= URL.  Connections are pooled by
    socket path, and requests carry the encoded path in the \c Host header.  Only plain HTTP/1.1 is available
    over a UNIX domain socket: an \c https URL, a forced \c h2 or \c h3 protocol, and a proxy are rejected with
    \c HTTPCLIENT-URL-ERROR or \c HTTPCLIENT-PROXY-ERROR.
    @code{.py}
%requires HttpClientIo

HttpClientConnectionManager manager();
string url = "http://socket=" + encode_url("/var/run/app/rest.sock", True);
hash<auto> resp = manager.request(url, "GET", "/api/status");
manager.closeAll();
    @endcode

    @section httpclientio_relnotes Release Notes

    @subsection httpclientio_v1_0 Version 1.0
    Initial (not yet released) version of the unified %HttpClientIo module —
    HTTP/1.1, HTTP/2, and HTTP/3 client I/O behind a single API, as currently
    implemented:
    - Async-only I/O: all managers share the process-wide global
      @ref AsyncSocketIo::AsyncSocketIoController singleton with
      \c autostop = @ref True; the synchronous \c request() API blocks the
      caller via a \c Future while the controller event loop drives the actual
      I/O; the single-controller architecture eliminates cross-controller
      deadlocks
    - Protocol auto-selection for HTTPS via an HTTP/3-preferred happy-eyeballs
      race.  The synchronous request path runs the race inline; poll-operation
      callers use @ref HttpClientIo::HttpClientConnectionManager::acquireConnectionAsync()
      for a fully non-blocking, immediately cancelable happy-eyeballs race
      (winner / error / protocol-cache semantics identical to the synchronous
      path) and @ref HttpClientIo::HttpClientConnectionManager::abandonAsyncHEForUrl() to
      tear an in-flight race down with no leaked socket or stagger timer.
      When both legs lose and HTTP/2 was refused via ALPN, the endpoint speaks
      neither HTTP/3 nor HTTP/2 and the race falls back to HTTP/1.1 instead of
      failing; the result is cached per host and re-probed periodically.
      Alt-Svc advertisements supply the UDP port for future races without
      overriding the negotiated protocol or draining working connections.
      Fresh automatic H3 connections and expired fallback entries race both
      protocols, selecting H3 only after its handshake succeeds
    - HTTP/1.1 serial request/response with keep-alive; the connection manager
      creates multiple connections for concurrent requests
    - @ref HttpClientIo::HttpClientConnectionManager::request() "HttpClientConnectionManager::request()" follows
      301, 302, 303, 307, and 308 redirects: \c Location values are resolved according to RFC 3986 with
      @ref Qore::resolve_url() "resolve_url()" and fragments are removed; \c Authorization, \c Cookie, and
      \c Host request headers are only sent to the origin of the original request; and the response reports the
      effective URL and the redirects followed (see @ref HttpClientIo::HttpClientResponseInfo "HttpClientResponseInfo")
    - Connection pooling with configurable limits, HTTP-proxy support,
      configurable automatic request retry, and QUIC connection migration for
      HTTP/3
    - Sync and async (\c Future / \c EventNotifier) request APIs
    - Streaming support (WebSocket, SSE) over HTTP/1.1, HTTP/2, and HTTP/3
*/

#! Main namespace for HttpClientIo module
public namespace HttpClientIo {
    #! Default maximum connections per host (0 = unlimited)
    public const DefaultMaxConnectionsPerHost = 0;

    #! Default maximum streams per connection (0 = unlimited; the server's SETTINGS_MAX_CONCURRENT_STREAMS is
    #! enforced at the C++ Socket level regardless of this value)
    public const DefaultMaxStreamsPerConnection = 0;

    #! Default connection idle timeout (60 seconds)
    public const DefaultConnectionIdleTimeout = 60s;

    #! Default connect timeout (30 seconds)
    public const DefaultConnectTimeout = 30s;

    #! Default request timeout (60 seconds)
    public const DefaultRequestTimeout = 60s;

    #! Default maximum request retries for retryable connection and capacity errors
    public const DefaultMaxRequestRetries = 3;

    #! Default born-at TTL (\c max_age) for pooled connections — \c 0s = disabled
    /** When set on @ref HttpClientConnectionManagerOptions::max_age, a pooled connection
        whose age exceeds this value is evicted at the next pool checkout instead of
        being reused.  Catches the "long-running daemon held a connection across
        server-side firewall idle-timeout / NAT rebind" class of bug.

        The age — like the @ref HttpClientConnectionManagerOptions::idle_timeout age — is
        measured with @ref Qore::clock_get_monotonic_us(), not the wall clock, so a system
        time step (NTP correction, VM resume) can neither hide an expired connection from
        eviction nor evict the whole pool at once.

        Default \c 0s = disabled (existing behaviour: pooled connections live until
        \c idle_timeout or close).
    */
    public const DefaultMaxConnectionAge = 0s;

    #! Default \c TCP_USER_TIMEOUT applied to manager-created TCP sockets (30 seconds)
    /** Kernel-level safety net for TCP-layer death.  Bounds how long unacknowledged
        TCP data may sit before the kernel reports the connection dead with
        \c ETIMEDOUT, instead of hanging in the kernel's full TCP retransmit window
        (~15 minutes default on Linux).

        NOT a half-open HTTP detector — see @ref HttpClientConnectionManagerOptions::tcp_user_timeout
        for details.  Set to \c 0s in @ref HttpClientConnectionManagerOptions to disable.
        No effect on platforms without \c TCP_USER_TIMEOUT (BSD/macOS/Windows).
    */
    public const DefaultTcpUserTimeout = 30s;

    #! Maximum pending stream reservations on a Connecting connection
    /** Limits the blast radius when a QUIC handshake fails — once this many
        threads are waiting on one connection's handshake, additional threads
        create new connections instead of all blocking on the same one.
    */
    public const DefaultMaxPendingPerConnection = 10;

    #! Protocol selection enum
    public enum HttpClientProtocol {
        #! Auto-detect protocol (HTTP/3-first happy eyeballs for HTTPS)
        Auto = 0,
        #! Force HTTP/2
        H2 = 1,
        #! Force HTTP/3 (QUIC)
        H3 = 2,
        #! Force HTTP/1.1
        H1 = 3,
    }

    #! Maps protocol string identifiers to enum values
    public const HttpClientProtocolMap = {
        "auto": HttpClientProtocol::Auto,
        "h2": HttpClientProtocol::H2,
        "h3": HttpClientProtocol::H3,
        "h1": HttpClientProtocol::H1,
    };

    #! Maps protocol enum values to string identifiers (reverse)
    public const HttpClientProtocolReverseMap = {
        HttpClientProtocol::Auto: "auto",
        HttpClientProtocol::H2: "h2",
        HttpClientProtocol::H3: "h3",
        HttpClientProtocol::H1: "h1",
    };

    #! Connection state enum
    public enum HttpClientConnectionState {
        #! Connection is connecting
        Connecting = 0,
        #! Connection is ready for requests
        Ready = 1,
        #! Connection is draining (GOAWAY received)
        Draining = 2,
        #! Connection is closed
        Closed = 3,
    }

    #! Stream state enum
    public enum HttpClientStreamState {
        #! Stream is pending (not yet submitted)
        Pending = 0,
        #! Stream is open (request submitted, awaiting response)
        Open = 1,
        #! Stream has received headers
        HeadersReceived = 2,
        #! Stream is receiving body data
        ReceivingBody = 3,
        #! Stream is complete (response fully received)
        Complete = 4,
        #! Stream was cancelled
        Cancelled = 5,
        #! Stream encountered an error
        Error = 6,
    }

    #! Canonical response shape for HTTP client async / conn_mgr requests.
    /** This hashdecl is the **single authoritative shape** for responses
        returned by the C++ HTTP connection manager and consumed by
        pure-async callers (@ref HttpClientConnectionManager,
        @ref HttpClientIo, \c RestClientIo, their DataProviders).
        Any new async code must read fields off this shape directly —
        no ad-hoc response hashes, no legacy-style flattening.

        @par Provenance
        Fields @c status_code, @c status_message, @c http_version,
        @c headers, @c headers_raw, and @c body come directly from the
        C++ connection manager (produced in
        @c Http1/Http2/Http3ClientPollOperationPriv and returned via
        @c HttpClientConnectionManagerBase::request /
        @c submitRequestWithAction).  Fields @c content_type,
        @c stream_id, @c protocol, and @c timing are populated by the
        Qore-level @ref HttpClientStreamHandle / @ref HttpClientConnection
        layers on top.

        @par Legacy adapters
        Two legacy callers still expect different response shapes:

        - **Sync HTTPClient** (`hc.send()`, `hc.get()`, …) expects a
          flattened hash where the response headers are top-level keys
          alongside @c status_code and @c body, matching the pre-conn_mgr
          @c readHTTPHeader format.  Adapted from this shape by
          @c transformConnMgrResponse in @c lib/QoreHttpClientObject.cpp.

        - **Legacy HTTPClient poll API** (`hc.startPollSendRecv(...)` +
          @c spop.getOutput() ) expects @c {code, info: {response-headers,
          response-headers-raw, response-body}, response-body}, matching
          the pre-conn_mgr \c HttpClientConnectSendRecvPollOperation
          output format (where @c response-body is intentionally present
          at BOTH locations for backward compatibility with existing
          consumers).  Adapted from this shape by
          @c HttpClientConnMgrPollOp::getOutput in the same file.

        Those adapters are LEGACY COMPATIBILITY LAYERS — new code must
        NOT add fields, shapes, or duplication to them.  Any new async
        API reads this @ref HttpClientResponseInfo hashdecl directly.
    */
    public hashdecl HttpClientResponseInfo {
        #! HTTP response status code (e.g. 200, 404, 500).
        int status_code;

        #! HTTP response status message (e.g. "OK", "Not Found").
        /** Populated for HTTP/1.x responses; @ref nothing for HTTP/2
            and HTTP/3 (neither protocol carries a reason phrase on the
            wire).
        */
        *string status_message;

        #! HTTP version string (e.g. "1.1", "2", "3").
        /** Present for all protocols; callers that only need to know
            the protocol family should prefer @ref protocol below.
        */
        *string http_version;

        #! Response headers with lowercase keys.
        /** Multi-value headers are handled per RFC 7230 §3.2.2:
            - @c cookie is joined with @c "; " into a single string.
            - Other multi-value headers (@c set-cookie, custom
              @c x-multi, etc.) are stored as a @ref list_type.
            - Single-value headers are stored as plain strings.
        */
        hash<auto> headers;

        #! Response headers with original-case keys (HTTP/1.x only).
        /** HTTP/2 and HTTP/3 mandate lowercase on the wire, so
            @c headers_raw is typically @ref nothing for those
            protocols; consumers that need case-preserving access
            (for example to pass headers through unchanged) should
            prefer this field when set and fall back to @c headers.
        */
        *hash<auto> headers_raw;

        #! Response body (binary or string depending on content-type).
        auto body;

        #! Bare MIME type from the response \c Content-Type header, with parameters stripped
        /** Populated by @ref HttpClientStreamHandle::normalizeResponseBody() from
            \c headers."content-type" using \c Mime::mime_get_base_type().  Downstream
            consumers (REST schema validator, DataStream client, etc.) should prefer this
            field for MIME type lookups so they don't each have to strip
            \c ";charset=utf-8" and other parameters themselves.
        */
        *string content_type;

        #! Stream ID used for this request
        int stream_id;

        #! Protocol used: "h1", "h2", or "h3"
        string protocol;

        #! HTTP/2-only: timing info (NOTHING for HTTP/1.1 and HTTP/3)
        *hash<auto> timing;

        #! The effective request URL that produced this response, after following any redirects
        /** When the request was redirected (301, 302, 303, 307, 308), this is the
            final URL whose response is returned here; with no redirect it is the
            originally-requested URL.  Callers should resolve relative references
            (links in an HTML body, etc.) against this URL rather than the URL they
            originally requested, exactly as a browser does (RFC 3986 section 5.1.3; see
            @ref Qore::resolve_url() "resolve_url()").  In \c redirect_passthru
            mode (redirects returned to the caller instead of being followed) this is
            the requested URL that returned the redirect response.

            The URL never contains user information or a fragment.  It has the same meaning as the
            \c effective-url key of the @ref Qore::HTTPClient "HTTPClient" request information hash.

            @note Only set by @ref HttpClientConnectionManager::request(), the API that follows redirects; the
            lower-level request, streaming, and asynchronous APIs send a single request to the URL given and leave
            this field unset
        */
        *string effective_url;

        #! The redirects followed to produce this response, from the first response to the last redirect
        /** Only set by @ref HttpClientConnectionManager::request(), and only if at least one redirect was
            followed

            @since HttpClientIo 1.0
        */
        *list<hash<HttpRedirectInfo>> redirects;
    }

    #! Unified error info for HTTP client operations
    public hashdecl HttpClientErrorInfo {
        #! Error code
        string err;

        #! Error description
        string desc;

        #! Stream ID (if stream-level error)
        *int stream_id;

        #! HTTP/2-only: protocol error code (NOTHING for HTTP/3)
        *int h2_error_code;
    }

    #! Unified connection info for HTTP client connections
    public hashdecl HttpClientConnectionInfo {
        #! Host name
        string host;

        #! Port number
        int port;

        #! Connection state
        HttpClientConnectionState state;

        #! Number of active streams
        int active_streams;

        #! Maximum concurrent streams
        int max_concurrent_streams;

        #! Connection ID
        int connection_id;

        #! Protocol used: "h1", "h2", or "h3"
        string protocol;

        #! Whether SSL/TLS is used (always True for HTTP/3; optional for HTTP/1.1 and HTTP/2)
        *bool ssl;
    }

    #! Unified request options for HTTP client requests
    public hashdecl HttpClientRequestOptions {
        #! Request timeout
        *timeout timeout;

        #! HTTP/2-only: priority weight (1-256)
        *int priority_weight;

        #! HTTP/2-only: stream dependency (stream ID)
        *int depends_on;

        #! HTTP/2-only: exclusive dependency flag
        *bool exclusive_dependency;
    }

    #! Unified connection manager options
    public hashdecl HttpClientConnectionManagerOptions {
        #! Maximum connections per host
        int max_connections_per_host = DefaultMaxConnectionsPerHost;

        #! Maximum streams per connection
        int max_streams_per_connection = DefaultMaxStreamsPerConnection;

        #! Connection idle timeout
        timeout idle_timeout = DefaultConnectionIdleTimeout;

        #! Born-at TTL for pooled connections — evict on next checkout when exceeded
        /** Curl analog: \c CURLOPT_MAXAGE_CONN.  Bounds the wall-clock age of a
            pooled connection.  When set, a connection whose age (now − creation
            time) reaches this value is treated as ineligible for reuse and is
            evicted at the next pool checkout.

            Useful when the path between client and server has middleboxes
            (load balancers, NAT, stateful firewalls) that silently expire
            long-lived TCP sessions — without \c max_age, the next request on
            that session fails and forces a retry; with \c max_age set below
            the middlebox idle window, the manager refreshes the connection
            proactively.

            Default \c 0s = disabled.  Skipped for connections with active
            streams (an in-flight request is not a candidate for max-age
            eviction).
        */
        timeout max_age = DefaultMaxConnectionAge;

        #! \c TCP_USER_TIMEOUT for manager-created TCP sockets
        /** Kernel-level safety net for TCP-layer death.  Bounds how long
            unacknowledged TCP data may sit before the kernel reports the
            connection dead with \c ETIMEDOUT, instead of hanging in the
            kernel's full TCP retransmit window (~15 minutes default on Linux).
            Catches peer reboots, NIC failures, network partitions, and NAT
            rebinds.

            \b NOT a half-open HTTP detector — if the peer's TCP stack ack's
            bytes but the HTTP server stops generating responses,
            \c TCP_USER_TIMEOUT never fires (nothing is unack'd).
            \c request_timeout is the application-level backstop for that case.

            No effect on platforms without \c TCP_USER_TIMEOUT (BSD/macOS/Windows)
            or on UDP/UNIX sockets.  Set to \c 0s to disable (kernel default).
        */
        timeout tcp_user_timeout = DefaultTcpUserTimeout;

        #! Connect timeout (also used as stale detection timeout for reused pooled connections)
        /** For fresh connections, this is the TCP/TLS establishment timeout.  For reused
            pooled connections, this is also used as the request timeout — if a reused
            connection doesn't respond within \c connect_timeout, the connection is assumed
            stale, evicted, and the request is retried on a fresh connection.

            Dead connections where the server sent FIN/RST are detected instantly by the
            async I/O thread (epoll/kqueue + recv(MSG_PEEK)) and evicted before reuse.
            This timeout only applies to the "half-open" case where the server goes silent.
        */
        timeout connect_timeout = DefaultConnectTimeout;

        #! Default request timeout
        timeout request_timeout = DefaultRequestTimeout;

        #! Maximum request retries for retryable connection and capacity errors
        /** Set to 0 to disable automatic request retries.  This applies to
            synchronous requests, connection-manager async requests, and
            streaming request startup.  Non-idempotent requests are retried only
            before stream submission.
        */
        int max_request_retries = DefaultMaxRequestRetries;

        #! SSL/TLS verification mode
        /** @see Qore::SSL_VERIFY_NONE, Qore::SSL_VERIFY_PEER, etc.
        */
        *int ssl_verify_mode;

        #! Accept all SSL certificates including self-signed certificates
        bool accept_all_certs = False;

        #! Logger for connection manager
        *LoggerInterface logger;

        #! Protocol selection: "auto" (default), "h1", "h2", or "h3"
        /** @see HttpClientProtocol, HttpClientProtocolMap
        */
        string protocol = "auto";

        #! Proxy URL (e.g., "http://proxy:8080")
        /** When set, all connections are routed through this HTTP proxy.
            For HTTPS targets, the proxy tunnel is established via HTTP CONNECT.
            For plain HTTP targets, requests use absolute URLs through the proxy.

            @note HTTP/3 (QUIC) cannot tunnel through HTTP proxies — when a proxy is
            configured, HTTP/3 is automatically downgraded to HTTP/2 in auto mode,
            or an error is thrown if HTTP/3 is explicitly forced.
        */
        *string proxy_url;

        #! HTTP/3-only: client certificate for mutual TLS (mTLS)
        *SSLCertificate client_cert;

        #! HTTP/3-only: client private key for mutual TLS (mTLS)
        *SSLPrivateKey client_pk;

        #! Enable automatic cookie handling (default: True)
        /** When True, the connection manager automatically processes Set-Cookie
            headers from responses and injects matching Cookie headers into
            requests. This enables session-based authentication, OAuth2 token
            endpoints, and other flows that depend on HTTP cookies.

            Set to False to disable automatic cookie handling (e.g., when the
            application manages cookies manually).
        */
        bool enable_cookies = True;

        #! Maximum number of HTTP redirects to follow (default: 5)
        /** A redirect response beyond this limit raises \c HTTP-REDIRECT-ERROR; with 0, any redirect response
            that would be followed raises the error.  Use \c redirect_passthru to receive redirect responses
            instead.

            Redirects with status 301, 302, 303, 307, and 308 are followed; the \c Location value is resolved
            against the URL of the request that received it according to RFC 3986 section 5.2, and any fragment
            is removed.  A 303 redirect is retrieved with \c GET, a \c POST redirected with 301 or 302 is
            changed to \c GET, and 307 and 308 repeat the request; a request that changes to \c GET is sent
            without its body and content headers.  The \c Authorization, \c Cookie, and \c Host request headers
            are sent only to the origin (scheme, host, and port) of the original request, and user information in
            a redirect location is never used.  Set-Cookie headers in redirect responses are processed before
            following the redirect (when cookies are enabled), and the cookie jar supplies the cookies for each
            target.
        */
        int max_redirects = 5;

        #! The maximum size in bytes of a response body that is returned whole; 0 (the default) means no limit
        /** The limit applies to the body as received and after its content encoding is decoded, over HTTP/1.x,
            HTTP/2, and HTTP/3; a larger body fails the request with \c HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE as soon
            as the limit is exceeded, so a huge body or a small compressed body that expands to a huge size (a
            "decompression bomb") cannot exhaust memory.  A body delivered incrementally to a streaming consumer is
            not limited; see @ref HttpClientStreamingIo::SseStreamReader "SseStreamReader" for the limits of an
            event stream.
        */
        int max_response_body_size = 0;

        #! The character encoding assumed for text response bodies whose encoding is not determined otherwise
        /** Response bodies are decoded by the rules documented for @ref Qore::get_http_body_encoding()
            "get_http_body_encoding()", the same for all HTTP clients: the assumed encoding applies to text types
            without a default encoding of their own and without an encoding declaration.  The default is ISO-8859-1,
            the default character set of text media types in HTTP/1.1 (RFC 2616).
        */
        string assume_encoding = "ISO-8859-1";

        #! Pass redirect responses to the caller instead of following them
        /** When True, 3xx responses are returned as-is without following
            the Location header.  Overrides \c max_redirects.
        */
        bool redirect_passthru = False;
    }

    #! Returns the given request target (a path with an optional query) with the characters percent-encoded that it may not contain
    /** A request target may only contain the characters of a URI (RFC 3986, RFC 9112 section 3.2); the following are
        percent-encoded:
        - control characters, space, and octets outside of ASCII (non-ASCII text is encoded in UTF-8)
        - the characters <tt>&quot; &lt; &gt; \\ ^ &#96; { | }</tt>
        - \c #, as a request target cannot carry a fragment
        - a \c % that does not start a percent-encoded octet; percent-encoded octets are kept, so a target that is
          already encoded is not encoded again
        - the characters in \a encode_chars

        @param target the request target
        @param pre_encoded if @ref True, the target must already be encoded: it is only validated, and a character
        that must be encoded raises an exception
        @param encode_chars additional characters to encode

        @return the encoded request target

        @throw URL-ENCODING-ERROR \a pre_encoded is @ref True and the target contains a character that must be
        encoded

        @par Example:
        @code{.py}
string target = encode_http_request_target("/files/my report.txt?q=a|b");
# target is "/files/my%20report.txt?q=a%7Cb"
        @endcode

        @since HttpClientIo 1.0
    */
    public string sub encode_http_request_target(string target, bool pre_encoded = False, *string encode_chars) {
        if (target !~ /[^\x21-\x7e]|["<>\\^`{|}#%]/ && !encode_chars) {
            return target;
        }
        if (target.encoding() != "UTF-8") {
            target = convert_encoding(target, "UTF-8");
        }
        hash<string, bool> extra = map {$1: True}, (encode_chars ?? "").split("");
        binary octets = target.toBinary();
        string rv;
        for (int i = 0; i < octets.size(); ++i) {
            int c = octets[i];
            bool encode;
            if (c == 0x25) {
                # a percent-encoded octet is kept
                encode = !(i + 2 < octets.size() && is_hex_digit(octets[i + 1]) && is_hex_digit(octets[i + 2]));
            } else {
                encode = c <= 0x20 || c >= 0x7f || c == 0x22 || c == 0x23 || c == 0x3c || c == 0x3e || c == 0x5c
                    || c == 0x5e || c == 0x60 || c == 0x7b || c == 0x7c || c == 0x7d || extra{chr(c)};
            }
            if (encode) {
                if (pre_encoded) {
                    throw "URL-ENCODING-ERROR", sprintf("request target %y contains character %y at offset %d, "
                        "which must be percent-encoded", target, c < 0x80 ? chr(c) : sprintf("\\x%02x", c), i);
                }
                rv += sprintf("%%%02X", c);
            } else {
                rv += chr(c);
            }
        }
        return rv;
    }

    #! Returns True if the given octet is a hexadecimal digit
    bool sub is_hex_digit(int c) {
        return (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66);
    }
}
