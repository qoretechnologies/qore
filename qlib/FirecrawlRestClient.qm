# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module FirecrawlRestClient {
    version = "1.0";
    desc = "user module for calling Firecrawl REST API services";
    author = "Qore Technologies, s.r.o.";
    url = "https://qoretechnologies.com";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("firecrawlrest", FirecrawlRestConnection::ConnectionScheme);
    };
}

/** @mainpage FirecrawlRestClient Module

    @tableofcontents

    @section firecrawlrestclientintro FirecrawlRestClient Introduction

    The %FirecrawlRestClient module provides an API for calling
    <a href="https://docs.firecrawl.dev">Firecrawl REST API</a> services.

    To use this module, use \c "%requires FirecrawlRestClient" in your code.

    All the public classes provided in this module are listed here:
    - @ref FirecrawlRestClient::FirecrawlRestClientBase "FirecrawlRestClientBase"
    - @ref FirecrawlRestClient::FirecrawlRestClient "FirecrawlRestClient"
    - @ref FirecrawlRestClient::FirecrawlRestClientIo "FirecrawlRestClientIo"
    - @ref FirecrawlRestClient::FirecrawlRestConnection "FirecrawlRestConnection"

    @section firecrawlrestclientrelnotes Release Notes

    @subsection firecrawlrestclientv1_0 FirecrawlRestClient v1.0
    - initial release of the module
*/

#! the FirecrawlRestClient namespace contains all the objects in the FirecrawlRestClient module
public namespace FirecrawlRestClient {
#! Common base class for FirecrawlRestClient functionality
public class FirecrawlRestClientBase {
    public {
        #! Default Firecrawl REST API URL
        const DefaultUrl = "https://api.firecrawl.dev";

        #! Default API version
        const DefaultApiVersion = "v2";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "default_path": "/" + DefaultApiVersion,
        };

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default ping path - uses credit-usage endpoint for connectivity and auth check
        #! Relative to default_path (/v2), so resolves to /v2/team/credit-usage
        const DefaultPingPath = "team/credit-usage";
    }

    #! Returns options for the FirecrawlRestClient constructor
    /** Maps the \c apikey option to a Bearer token header
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = cast<hash<auto>>(DefaultOptions + opts);
        # Map apikey to Authorization Bearer header
        if (rv.apikey) {
            rv.headers."Authorization" = "Bearer " + rv.apikey;
            remove rv.apikey;
        }
        return rv;
    }
}

#! This class provides the REST client API for communication with Firecrawl servers
/** You must use an API key in the \c apikey option to call Firecrawl APIs.

    The API key is sent as a Bearer token in the \c Authorization header.
*/
public class FirecrawlRestClient inherits RestClient::RestClient, FirecrawlRestClientBase {
    #! Creates the object with the given options
    /**
        @par Example:
        @code{.py}
FirecrawlRestClient rest({"apikey": api_key});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class; note
        that the URL is set by default if not provided (see @ref DefaultUrl).
        Additional options:
        - \c apikey: the Firecrawl API key (required)
        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(FirecrawlRestClientBase::getOptions(opts), do_not_connect) {
    }
}

#! REST client for Firecrawl REST API using multiplexed HTTP connections
/** @see FirecrawlRestClient for more information
*/
public class FirecrawlRestClientIo inherits RestClientIo::RestClientIo, FirecrawlRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(FirecrawlRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Firecrawl REST connections; returns @ref FirecrawlRestClient objects
/** This class implements all options of \c RestClient::RestConnection "RestClientConnection"

    @see @ref FirecrawlRestClient::FirecrawlRestClient::constructor() for more information on the above options
*/
public class FirecrawlRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Firecrawl REST API URL
        const DefaultUrl = "firecrawlrest://api.firecrawl.dev";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Firecrawl REST Connection",
            "short_desc": "A connection to the Firecrawl REST API",
            "desc": "A connection to the Firecrawl REST API for web scraping, crawling, and data extraction",
            "cls": Class::forName("FirecrawlRestConnection"),
            "auto_url": True,
            "schemes": {
                "firecrawlrest": True,
            },
            "base_scheme_map": {
                "https": "firecrawlrest",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Firecrawl API key for authentication",
                    "type": "string",
                    "desc": "The Firecrawl API key used for authentication; sent as a Bearer token in the "
                        "`Authorization` header. To obtain a key, sign in at "
                        "[firecrawl.dev](https://www.firecrawl.dev) and navigate to your dashboard",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": FirecrawlRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": FirecrawlRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": FirecrawlRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Get Your Firecrawl API Key",
                    "intent": "info",
                    "content": "To connect to Firecrawl, you need an API key:\n\n"
                        "1. Sign in to your account at [firecrawl.dev](https://www.firecrawl.dev)\n"
                        "2. Navigate to your **Dashboard**\n"
                        "3. Find or generate your API key\n"
                        "4. Copy the key (it starts with `fc-`)\n\n"
                        "Keep your API key secure and never share it publicly.",
                },
            ),
        };
    }

    #! Creates the FirecrawlRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! Creates the FirecrawlRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(FirecrawlRestConnection::getConfig(config), attr) {
    }

    #! Returns the config hash with the correct URL
    /** Firecrawl has a single fixed API endpoint, so the URL is always overridden
    */
    private static hash<auto> getConfig(hash<auto> config) {
        # Firecrawl has a single fixed API endpoint — always override
        config.url = DefaultUrl;
        return config;
    }

    #! Returns \c "firecrawlrest"
    string getType() {
        return "firecrawlrest";
    }

    #! Returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the \c getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the FirecrawlDataProvider and creates the data provider
        # object dynamically
        load_module("FirecrawlDataProvider");
        return create_object("FirecrawlDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! Returns a @ref FirecrawlRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref FirecrawlRestClient object
    */
    private FirecrawlRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new FirecrawlRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new FirecrawlRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
