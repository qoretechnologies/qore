    TOPT_SUPO : "SUPDUPOutput",
    TOPT_SNDL : "SendLocation",
    TOPT_TERM : "TerminalType",
    TOPT_EOR : "EndofRecord",
    TOPT_TACACS : "TACACSUserIdent",
    TOPT_OM : "OutputMarking",
