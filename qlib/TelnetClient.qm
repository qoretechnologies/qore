# minimum required Qore version
%requires qore >= 2.0

# assume local var scope, do not use "$" for vars, members, and method calls
%modern

%requires(reexport) ConnectionProvider >= 1.4

module TelnetClient {
    version = "1.7";
    desc = "allows connections to a Telnet server, to remotely execute commands and read their output";
    author = "Pavol Potancok <ppotancok@gmail.com>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("telnet", TelnetConnection::ConnectionScheme);
    };
}

/** @mainpage TelnetClient Module

    @tableofcontents

    @section telnetclientintro Introduction to the TelnetClient Module

    The %TelnetClient module provides a telnet client class for communicating with a server using the telnet protocol

    To use this module, use \c "%requires TelnetClient" in your code.  See examples/telnet.qr for an example program using this module.

    All the public symbols in the module are defined in the TelnetClient namespace

    The main classes are:
    - @ref TelnetClient::TelnetClient "TelnetClient": the telnet client class
    - @ref TelnetClient::TelnetConnection "TelnetConnection": provides a connection object to a REST server (based on the @ref connectionproviderintro "ConnectionProvider" module)

    The main definitions are:
    - @ref TelnetCommandCodes "TelnetCommandCodes": telnet protocol command codes and a lookup map
    - \c TelnetDefaults "TelnetDefaults": default values for the @ref TelnetClient::TelnetClient "TelnetClient" class
    - @ref TelnetOptionCodes "TelnetOptionCodes": telnet protocol option codes and a lookup map

    @section telnetclient_relnotes TelnetClient Module Release Notes

    @subsection telnetclient_v1_7 TelnetClient v1.7
    - implemented support for a data provider scheme cache and rich option information for connections
      (<a href="https://github.com/qoretechnologies/qore/issues/4025">issue 4025</a>)

    @subsection telnetclient_v1_6 TelnetClient v1.6
    - removed the \c TelnetConnection::getConstructorInfo() and \c TelnetConnection::getConstructorInfoImpl() methods
      (<a href="https://github.com/qoretechnologies/qore/issues/3696">issue 3696</a>)
    - added support for socket events
      (<a href="https://github.com/qoretechnologies/qore/issues/3425">issue 3425</a>)

    @subsection telnetclient_v1_5 TelnetClient v1.5
    - all connection clases have unified constructor

    @subsection telnetclient_v1_4 TelnetClient v1.4
    - added the \c TelnetConnection::getConstructorInfo()
      method to allow connections to be created dynamically, potentially in another process from a network
      call (removed in TelnetClient 1.6)
      (<a href="https://github.com/qoretechnologies/qore/issues/2628">issue 2628</a>)

    @subsection telnetclient_v1_3 TelnetClient v1.3
    - added the @ref TelnetClient::TelnetConnection "TelnetConnection" class to support the <a href="../../ConnectionProvider/html/index.html">ConnectionProvider</a> module
    - added the @ref TelnetClient::TelnetClient::getTarget() "TelnetClient::getTarget()" method
    - added support for URLs in the constructor()
    - updated for complex types

    @subsection telnetclient_v1_2 TelnetClient v1.2
    - converted to @ref new-style "%new-style"

    @subsection telnetclient_v1_1 TelnetClient v1.1
    - added socket instrumention support from Qore 0.8.9

    @subsection telnetclient_v1_0 TelnetClient v1.0
    - updated to a user module

    @subsection telnetclient_v0_9 TelnetClient v0.9
    - initial version
*/

#! contains constant definitions and the definition of the TelnetClient class
public namespace TelnetClient {
/** @defgroup TelnetDefaults Default Values
*/
#/@{
# default telnet port
public const DefaultTelnetPort = 23;

# default connection timeout
public const DefaultConnTimeout = 15s;

# default poll timeout
const DefaultTimeout = 100ms;

# default terminal type
const DefaultTerminalType = "xterm";

# default terminal speed
const DefaultTerminalSpeed = 38400;
#/@}

/** @defgroup TelnetCommandCodes Telnet Protocol Command Codes
*/
#/@{
public const IAC  = 255; #!< IAC
public const DONT = 254; #!< DONT
public const DO   = 253; #!< DO
public const WONT = 252; #!< WONT
public const WILL = 251; #!< WILL
public const SE  = 240;  #!< Subnegotiation End
public const NOP = 241;  #!< No Operation
public const DM  = 242;  #!< Data Mark
public const BRK = 243;  #!< Break
public const IP  = 244;  #!< Interrupt process
public const AO  = 245;  #!< Abort output
public const AYT = 246;  #!< Are You There
public const EC  = 247;  #!< Erase Character
public const EL  = 248;  #!< Erase Line
public const GA  = 249;  #!< Go Ahead
public const SB =  250;  #!< Subnegotiation Begin

#! command name map
public const CmdMap = (
    IAC : "IAC",
    DONT : "DONT",
    DO : "DO",
    WONT : "WONT",
    WILL: "WILL",
    SE : "SubnegotiationEnd",
    NOP : "NoOperation",
    DM: "DataMark",
    BRK : "Break",
    IP : "Interruptprocess",
    AO : "Abortoutput",
    AYT : "AreYouThere",
    EC : "EraseCharacter",
    EL : "EraseLine",
    GA : "GoAhead",
    SB : "SubnegotiationBegin",
    );
#/@}|

public const SUPDUP_OPT = 21; # SUPDUP_OPT display protocol

/** @defgroup TelnetOptionCodes Telnet Command Option Codes
*/
#/@{
public const TOPT_BIN = 0;         #!< BinaryTransmission
public const TOPT_ECHO = 1;        #!< Echo|Is|Send
