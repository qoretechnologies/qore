# minimum qore version
%requires qore >= 2.0
%modern

%allow-weak-references

module HttpStreamClient {
    version = "1.0";
    desc = "user module for HTTP streaming support";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage HttpStreamClient Module

    @tableofcontents

    @section httpstreamclientintro HttpStreamClient Introduction

    The %HttpStreamClient module provides a convenience API for reading HTTP streaming responses,
    primarily designed for Server-Sent Events (SSE) responses with Content-Type \c text/event-stream.

    To use this module, use \c "%requires HttpStreamClient" in your code.

    All the public symbols in the module are defined in the HttpStreamClient namespace.

    The main classes are:
    - @ref HttpStreamClient::HTTPResponseStream "HTTPResponseStream": provides streaming access to HTTP response bodies
    - @ref HttpStreamClient::HTTPResponseStreamInfo "HTTPResponseStreamInfo": response information hashdecl

    @section httpstreamclient_example Usage Example

    @code{.py}
%modern
%requires HttpStreamClient

HTTPClient client({"url": "https://api.example.com"});

# Start streaming request
hash<auto> info;
HTTPResponseStream stream = HttpStreamClient::sendAndStream(client, "POST", "/events",
    "{\"subscribe\":\"updates\"}",
    {"Accept": "text/event-stream", "Content-Type": "application/json"},
    \info);

# Check response
hash<HTTPResponseStreamInfo> resp = stream.getInfo();
if (resp.status_code != 200) {
    throw "HTTP-ERROR", sprintf("HTTP %d: %s", resp.status_code, resp.status_message);
}

# Read SSE events
if (resp.content_type == "text/event-stream") {
    while (!stream.isEof()) {
        *hash<SseMessageInfo> evt = stream.readServerSentEvent(30s);
        if (!evt) {
            break;
        }
        printf("Event: %y, Data: %y\n", evt.event, evt.data);
    }
} else {
    # Read entire body
    *binary body;
    while (*binary chunk = stream.readChunk(30s)) {
        body += chunk;
    }
    printf("Response: %s\n", body.toString());
}

stream.close();
    @endcode

    @section httpstreamclient_relnotes Release Notes

    @subsection httpstreamclient_v1_0 HttpStreamClient v1.0
    - initial release
*/

#! The HttpStreamClient namespace contains all the public definitions in the HttpStreamClient module
public namespace HttpStreamClient {
    #! Response stream information hashdecl
    /** Contains metadata about the HTTP response received before reading the body
    */
    public hashdecl HTTPResponseStreamInfo {
        #! HTTP status code
        int status_code;

        #! HTTP status message
        string status_message;

        #! HTTP version (e.g., "HTTP/1.1")
        string http_version;

        #! Response headers with lowercase keys
        hash<auto> headers;

        #! Raw response headers with original case
        hash<auto> headers_raw;

        #! Content-Type without parameters, lowercase
        *string content_type;

        #! Charset from Content-Type, if present
        *string charset;

        #! Content-Encoding value, lowercase
        *string content_encoding;

        #! True if Transfer-Encoding is "chunked"
        bool chunked;

        #! Content-Length if known
        *int content_length;
    }

    #! HTTP response stream for incremental body reading
    /** This class provides streaming access to HTTP response bodies after headers have been received.

        It supports:
        - Server-Sent Events (SSE) with readServerSentEvent()
        - Chunked transfer encoding with automatic decompression
        - Raw chunk reading for non-SSE responses

        @par Example:
        @code{.py}
HTTPClient client({"url": "https://api.example.com"});
hash<auto> info;
HTTPResponseStream stream = HttpStreamClient::sendAndStream(client, "GET", "/stream", NOTHING, NOTHING, \info);
while (*binary chunk = stream.readChunk()) {
    process(chunk);
}
stream.close();
        @endcode
    */
    #! @private Holds data written to it up to a maximum size until it is taken
    class BoundedOutputStream inherits Qore::OutputStream {
        private {
            #! Buffered data
            BinaryOutputStream buf();

            #! The maximum size of the data held at once; <= 0 means no limit
            int max_size;

            #! The size of the data held
            int size = 0;
        }

        #! Creates the stream
        constructor(int max_size) {
            self.max_size = max_size;
        }

        #! Closes the stream
        close() {
        }

        #! Buffers data
        /** @throw DECOMPRESSION-LIMIT-EXCEEDED the buffered data would exceed the maximum size
        */
        write(binary data) {
            if (max_size > 0 && data.size() > max_size - size) {
                throw "DECOMPRESSION-LIMIT-EXCEEDED", sprintf("the data decompressed from one chunk exceeds the "
                    "maximum size of %d bytes", max_size);
            }
            buf.write(data);
            size += data.size();
        }

        #! Returns and clears the buffered data
        binary take() {
            size = 0;
            return buf.getData();
        }
    }

    public class HTTPResponseStream {
        private {
            #! The HTTP client
            HTTPClient client;

            #! Response information
            hash<HTTPResponseStreamInfo> info;

            #! True if stream has been closed
            bool closed = False;

            #! True if end of stream reached
            bool eof = False;

            #! Default read timeout
            timeout read_timeout = 30s;

            #! Holds the output of chunk decompression, limited to the data decompressed from one chunk
            BoundedOutputStream bostream;

            #! Decompression transform stream for binary chunks (wraps bostream)
            TransformOutputStream bdstream;

            #! True if decompression is enabled
            bool use_decompressor = False;
        }

        #! Creates the stream from an HTTPClient after headers have been received
        /** @param http_client the HTTPClient that has already sent the request with \c getbody=False
            @param response_info the response information hash from HTTPClient::send()
            @param default_timeout the default timeout for read operations
        */
        constructor(HTTPClient http_client, hash<auto> response_info, timeout default_timeout = 30s) {
            client = http_client;
            read_timeout = default_timeout;
            initInfo(response_info);
            setupDecompression();
        }

        #! Gets response information including headers
        /** @return the response stream information

            The response information is available immediately after construction.
        */
        hash<HTTPResponseStreamInfo> getInfo() {
            return info;
        }

        #! Reads the next SSE event from the stream
        /** @param to optional timeout; uses the default timeout if not specified
            @return the SSE event or @ref nothing if EOF reached

            This method reads and parses the next Server-Sent Event from the stream, decompressing it according to
            its content encoding.  An event is limited to the maximum response body size of the client if set, and
            otherwise to 128 MiB; see HTTPClient::readServerSentEvent().

            @throw COMPRESS-ERROR if content encoding is not supported
            @throw SSE-EVENT-TOO-LARGE the event exceeds the maximum event size
        */
        *hash<SseMessageInfo> readServerSentEvent(*timeout to) {
            if (closed || eof) {
                return;
            }
            timeout use_to = to ?? read_timeout;

            # the client decodes the stream, including chunked transfer encoding and the content encoding, and
            # limits the size of an event
            *hash<SseMessageInfo> evt;
            try {
                evt = client.readServerSentEvent(info.content_encoding, use_to);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "SOCKET-CLOSED") {
                    # Remote end closed — normal EOF for SSE streams
                    eof = True;
                    return NOTHING;
                }
                rethrow;
            }
            if (!evt) {
                eof = True;
            }
            return evt;
        }

        #! Reads a chunk from the stream with optional decompression
        /** @param to optional timeout; uses the default timeout if not specified
            @param decompress if True (the default), automatically decompress the data based on
                Content-Encoding; if False, return raw (possibly compressed) bytes
            @return the chunk data as binary or @ref nothing if EOF reached

            For non-SSE responses, this method reads chunks. For chunked transfer encoding,
            it reads individual chunks. For content-length responses, it reads the entire body
            in one call.

            By default, this method handles decompression (gzip, deflate, bzip2, br, zstd) transparently,
            consistent with readServerSentEvent(). Set \a decompress to False to get raw bytes.

            The data held in memory is limited: the data decompressed from one chunk is limited to the value of
            HTTPClient::getMaxSseEventSize() of the client, and a body read at once, as received and decoded, to the
            maximum response body size of the client if set (see HTTPClient::setMaxResponseBodySize()); the stream is
            closed when a limit is exceeded.

            @throw ENCODING-ERROR if content encoding is not supported and decompress is True
            @throw DECOMPRESSION-LIMIT-EXCEEDED the data decompressed from one chunk exceeds its limit
            @throw HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE a body read at once exceeds the maximum response body size
        */
        *binary readChunk(*timeout to, bool decompress = True) {
            if (closed || eof) {
                return;
            }
            timeout use_to = to ?? read_timeout;

            if (info.chunked) {
                while (True) {
                    hash<auto> chunk = client.readHTTPChunk(use_to);
                    if (!chunk.body) {
                        eof = True;
                        if (decompress && use_decompressor) {
                            # Return any remaining decompressed data
                            *binary remaining = bostream.take();
                            if (remaining) {
                                return remaining;
                            }
                        }
                        return;
                    }
                    if (decompress && use_decompressor) {
                        try {
                            bdstream.write(chunk.body);
                        } catch (hash<ExceptionInfo> ex) {
                            if (ex.err == "DECOMPRESSION-LIMIT-EXCEEDED") {
                                close();
                            }
                            rethrow;
                        }
                        *binary result = bostream.take();
                        # Decompressor may need more input before producing output
                        if (result) {
                            return result;
                        }
                        continue;
                    }
                    return chunk.body;
                }
            }

            # For non-chunked, read the entire body at once; it is received into memory, so it is limited like a
            # body that is returned whole
            int max_size = client.getMaxResponseBodySize();
            if (max_size > 0 && info.content_length > max_size) {
                close();
                throw "HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", sprintf("the response body of %d bytes declared by "
                    "Content-Length exceeds the maximum response body size of %d bytes", info.content_length,
                    max_size);
            }
            binary body;
            if (info.content_length) {
                body = client.recvBinary(info.content_length, use_to);
                eof = True;
            } else {
                # No content-length, try to read until connection closes
                try {
                    body = client.recvBinary(-1, use_to);
                    if (!body) {
                        eof = True;
                        return;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "SOCKET-NOT-OPEN" || ex.err == "SOCKET-CLOSED") {
                        eof = True;
                        return;
                    }
                    rethrow;
                }
            }

            # Handle decompression for non-chunked responses
            if (decompress && info.content_encoding) {
                try {
                    return decompressBody(body, max_size);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "DECOMPRESSION-LIMIT-EXCEEDED") {
                        throw "HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", sprintf("the decoded response body exceeds the "
                            "maximum response body size of %d bytes", max_size);
                    }
                    rethrow;
                }
            }
            return body;
        }

        #! Reads a raw chunk from the stream without decompression
        /** @param to optional timeout; uses the default timeout if not specified
            @return the raw chunk data as binary or @ref nothing if EOF reached

            This is a convenience method equivalent to calling readChunk(to, False).
            Use this when you need the raw (possibly compressed) bytes.

            @see readChunk()
        */
        *binary readRawChunk(*timeout to) {
            return readChunk(to, False);
        }

        #! Checks if the stream has reached EOF
        /** @return True if no more data is available
        */
        bool isEof() {
            return eof;
        }

        #! Checks if the stream has been closed
        /** @return True if the stream has been closed by calling close()
        */
        bool isClosed() {
            return closed;
        }

        #! Sets the default read timeout
        /** @param to the timeout value
        */
        setReadTimeout(timeout to) {
            read_timeout = to;
        }

        #! Gets the default read timeout
        /** @return the current default read timeout
        */
        timeout getReadTimeout() {
            return read_timeout;
        }

        #! Closes the stream and disconnects the client
        /** After calling close(), no more data can be read from the stream.
        */
        close() {
            if (!closed) {
                closed = True;
                client.disconnect();
            }
        }

        #! Destructor ensures the connection is closed
        destructor() {
            close();
        }

        #! @private
        private initInfo(hash<auto> resp) {
            *int cl;
            if (resp."content-length".val()) {
                cl = int(resp."content-length");
            }
            info = <HTTPResponseStreamInfo>{
                "status_code": resp.status_code,
                "status_message": resp.status_message,
                "http_version": resp.http_version,
                "headers": resp."response-headers",
                "headers_raw": resp."response-headers-raw",
                "content_type": normalizeContentType(resp."content-type"),
                "charset": resp.charset,
                "content_encoding": resp."content-encoding".val()
                    ? tolower(resp."content-encoding")
                    : NOTHING,
                "chunked": tolower(resp."transfer-encoding" ?? "") == "chunked",
                "content_length": cl,
            };
        }

        #! @private
        private setupDecompression() {
            if (!info.chunked) {
                return;
            }

            *string alg = getAlgorithm(info.content_encoding);
            if (!alg) {
                return;
            }
            use_decompressor = True;
            # the data decompressed from one chunk is limited
            bostream = new BoundedOutputStream(client.getMaxSseEventSize());
            bdstream = new TransformOutputStream(bostream, get_decompressor(alg));
        }

        #! @private Returns the decompression algorithm for a content coding, or NOTHING for no decompression
        private static *string getAlgorithm(*string content_encoding) {
            switch (content_encoding) {
                case "deflate":
                case "x-deflate":
                    return Qore::COMPRESSION_ALG_ZLIB;
                case "gzip":
                case "x-gzip":
                    return Qore::COMPRESSION_ALG_GZIP;
                case "bzip2":
                case "x-bzip2":
                    return Qore::COMPRESSION_ALG_BZIP2;
                case "br":
                    return Qore::COMPRESSION_ALG_BROTLI;
                case "zstd":
                    return Qore::COMPRESSION_ALG_ZSTD;
                case "lz4":
                    return Qore::COMPRESSION_ALG_LZ4;
                case NOTHING:
                case "identity":
                    return;
            }
            throw "ENCODING-ERROR", sprintf("Don't know how to handle Content-Encoding %y", content_encoding);
        }

        #! @private
        private static string normalizeContentType(*string content_type) {
            if (!content_type.val()) {
                return "";
            }
            string rv = content_type;
            rv =~ s/\s*;.*$//;
            rv =~ s/^\s+//;
            rv =~ s/\s+$//;
            return tolower(rv);
        }

        #! @private Decompress a binary body based on content encoding
        /** @param body the compressed body
            @param max_size the maximum size of the decoded body; <= 0 means no limit
        */
        private binary decompressBody(binary body, int max_size) {
            if (max_size < 0) {
                max_size = 0;
            }
            switch (info.content_encoding) {
                case "deflate":
                case "x-deflate":
                    return uncompress_to_binary(body, max_size);
                case "gzip":
                case "x-gzip":
                    return gunzip_to_binary(body, max_size);
                case "bzip2":
                case "x-bzip2":
                    return bunzip2_to_binary(body, max_size);
                case "br":
                    return unbrotli_to_binary(body, max_size);
                case "zstd":
                    return unzstd_to_binary(body, max_size);
                case "lz4":
                    # an LZ4 block has no size header, so it is decompressed into a buffer of the maximum size, and a
                    # larger block fails with LZ4-ERROR
                    return unlz4_to_binary(body, max_size);
                case NOTHING:
                case "identity":
                    return body;
                default:
                    throw "ENCODING-ERROR", sprintf("Don't know how to handle Content-Encoding %y",
                        info.content_encoding);
            }
        }
    }

    #! Sends an HTTP request and returns a stream for reading the response body
    /** @param client the HTTPClient to use for the request
        @param method the HTTP method (GET, POST, etc.)
        @param path the request path
        @param body optional request body
        @param headers optional additional headers
        @param info reference to receive extended response information
        @param default_timeout optional default timeout for stream read operations

        @return an HTTPResponseStream object for reading the response body

        This function sends an HTTP request with \c getbody=False so that only the headers
        are received. The body can then be read incrementally using the returned stream.

        @par Example:
        @code{.py}
HTTPClient client({"url": "https://api.example.com"});
hash<auto> info;
HTTPResponseStream stream = HttpStreamClient::sendAndStream(client, "GET", "/events",
    NOTHING, {"Accept": "text/event-stream"}, \info);
# Read events...
stream.close();
        @endcode
    */
    public HTTPResponseStream sub sendAndStream(HTTPClient client, string method, *string path,
            *data body, *hash<auto> headers, *reference<hash<auto>> info, timeout default_timeout = 30s) {
        # Enable error passthrough to allow handling of error responses in the stream
        # Note: This temporarily modifies the client state. If the client is shared across threads,
        # consider using a dedicated client instance for streaming requests.
        bool old_error_passthru = client.setErrorPassthru(True);
        on_exit {
            client.setErrorPassthru(old_error_passthru);
        }
        hash<auto> resp = client.sendAndStream(method, path, body, headers, \info);

        # Build clean response-headers hash containing only actual HTTP headers
        # (not status_code, status_message, http_version which are metadata injected by HTTPClient)
        hash<auto> response_headers = info."response-headers" ?? {};
        # Remove non-header metadata keys that HTTPClient adds to response-headers
        remove response_headers.status_code;
        remove response_headers.status_message;
        remove response_headers.http_version;
        # Add any header values from resp that might not be in response-headers
        if (resp."content-type") {
            response_headers."content-type" = resp."content-type";
        }
        if (resp."content-encoding") {
            response_headers."content-encoding" = resp."content-encoding";
        }
        if (resp."transfer-encoding") {
            response_headers."transfer-encoding" = resp."transfer-encoding";
        }
        if (resp."content-length") {
            response_headers."content-length" = resp."content-length";
        }

        return new HTTPResponseStream(client, info + {
            "status_code": resp.status_code,
            "status_message": resp.status_message,
            "http_version": resp.http_version,
            "content-type": resp."content-type" ?? response_headers."content-type",
            "content-encoding": resp."content-encoding" ?? response_headers."content-encoding",
            "transfer-encoding": resp."transfer-encoding" ?? response_headers."transfer-encoding",
            "content-length": resp."content-length" ?? response_headers."content-length",
            "charset": info.charset,
            "response-headers": response_headers,
            "response-headers-raw": info."response-headers-raw",
        }, default_timeout);
    }
}
