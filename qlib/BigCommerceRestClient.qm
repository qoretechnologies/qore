# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) ConnectionProvider >= 1.4

module BigCommerceRestClient {
    version = "1.1";
    desc = "User module for calling BigCommerce REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("bigcommerceres",
            BigCommerceRestConnection::ConnectionScheme);
    };
}

/** @mainpage BigCommerceRestClient Module

    @tableofcontents

    @section bigcommercerestclientintro BigCommerceRestClient Introduction

    The %BigCommerceRestClient module provides an API for calling BigCommerce REST API services.

    To use this module, use \c "%requires BigCommerceRestClient" in your code.

    All the public symbols in the module are defined in the BigCommerceRestClient namespace.

    The main classes are:
    - @ref BigCommerceRestClient::BigCommerceRestClient "BigCommerceRestClient":
      this class provides the REST client API for communication with the BigCommerce API;
      it handles OAuth2 and X-Auth-Token authentication
    - @ref BigCommerceRestClient::BigCommerceRestConnection "BigCommerceRestConnection":
      provides a connection object to BigCommerce services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example (OAuth2):
    @code{.py}
#!/usr/bin/env qore

%requires BigCommerceRestClient

BigCommerceRestClient bc({
    "oauth2_client_id": ENV.BIGCOMMERCE_CLIENT_ID,
    "oauth2_client_secret": ENV.BIGCOMMERCE_CLIENT_SECRET,
    "store_hash": ENV.BIGCOMMERCE_STORE_HASH,
});
hash<auto> result = bc.get("v3/catalog/summary");
printf("Product count: %d\n", result.body.data.product_count);
    @endcode

    @par Example (Manual Token):
    @code{.py}
BigCommerceRestClient bc({
    "store_hash": ENV.BIGCOMMERCE_STORE_HASH,
    "access_token": ENV.BIGCOMMERCE_ACCESS_TOKEN,
});
hash<auto> result = bc.get("v3/catalog/summary");
printf("Product count: %d\n", result.body.data.product_count);
    @endcode

    @section bigcommercerestclientrelnotes Release Notes

    @subsection bigcommercerestclientv1_1 BigCommerceRestClient v1.1
    - added OAuth2 authentication support (dual mode: OAuth2 or manual X-Auth-Token)
    - added @ref BigCommerceRestClient::BigCommerceRestClient::gotOAuth2LoginInfo()
      "BigCommerceRestClient::gotOAuth2LoginInfo()" override for X-Auth-Token header support
    - added @ref BigCommerceRestClient::BigCommerceRestConnection::processOAuth2TokenResponseImpl()
      "BigCommerceRestConnection::processOAuth2TokenResponseImpl()" to extract store_hash from
      OAuth2 response context

    @subsection bigcommercerestclientv1_0 BigCommerceRestClient v1.0
    - the initial version of the %BigCommerceRestClient module
*/

#! the BigCommerceRestClient namespace contains all the objects in the BigCommerceRestClient module
public namespace BigCommerceRestClient {

#! This class provides the REST client API for communication with BigCommerce servers
/** BigCommerce uses a REST API at https://api.bigcommerce.com/stores/{store_hash} with
    X-Auth-Token authentication.

    @par Authentication:
    - **OAuth2 mode**: uses BigCommerce OAuth2 endpoints (authorization_code grant) to obtain
      an access token; tokens are applied as \c X-Auth-Token headers (BigCommerce requirement)
    - **Manual token mode**: accepts a pre-generated API access token from the BigCommerce
      admin panel and applies it as the \c X-Auth-Token header
    - BigCommerce OAuth2 tokens are permanent (no refresh flow needed)

    @par API Structure:
    - V3 endpoints under /v3/ (customers, products, catalog, blog, carts)
    - V2 endpoints under /v2/ (orders, shipments)
    - The base URL includes /stores/{store_hash} but no version prefix
*/
public class BigCommerceRestClient inherits RestClient::RestClient {
    public {
        #! Default BigCommerce API URL base
        const DefaultApiHost = "https://api.bigcommerce.com";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since base URL has /stores/{hash})
        const DefaultPingPath = "v3/catalog/summary";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default BigCommerce OAuth2 authorization URL
        const DefaultAuthUrl = "https://login.bigcommerce.com/oauth2/authorize";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default BigCommerce OAuth2 token URL
        const DefaultTokenUrl = "https://login.bigcommerce.com/oauth2/token";

        #! Default OAuth2 scopes for BigCommerce
        const DefaultScopes = (
            "store_v2_customers",
            "store_v2_orders",
            "store_v2_products",
            "store_v2_content",
            "store_v2_marketing",
            "store_v2_information",
        );

        #! Default OAuth2 auth args for refresh token support
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! OAuth2 options added when OAuth2 credentials are provided
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_scopes": DefaultScopes,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "headers": DefaultHeaders,
            "oauth2_auth_args": DefaultAuthArgs,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! creates the object with the given options
    /**
        @par Example (OAuth2):
        @code{.py}
BigCommerceRestClient bc({
    "oauth2_client_id": "your-client-id",
    "oauth2_client_secret": "your-client-secret",
    "store_hash": "g3uz5c7jx",
});
        @endcode

        @par Example (Manual Token):
        @code{.py}
BigCommerceRestClient bc({
    "store_hash": "g3uz5c7jx",
    "access_token": "your-access-token",
});
        @endcode

        @param opts valid options are:
        - \c store_hash: the BigCommerce store hash (required for manual mode; optional for
          OAuth2 mode if the token response includes the \c context field)
        - \c access_token: the API access token (manual mode)
        - \c oauth2_client_id: OAuth2 client ID (OAuth2 mode)
        - \c oauth2_client_secret: OAuth2 client secret (OAuth2 mode)
        - plus all options for the @ref RestClient::RestClient "RestClient" class

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(BigCommerceRestClient::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! Called when OAuth2 login information has been received
    /** Overrides the default behavior to use the \c X-Auth-Token header instead of
        \c "Authorization: Bearer", as required by the BigCommerce API.

        Also extracts the \c store_hash from the OAuth2 response \c context field
        (e.g., \c "stores/g5cd38") and updates the URL if needed.

        @param h the OAuth2 login response hash
        @param refresh used to distinguish an initial login from a token refresh
    */
    hash<auto> gotOAuth2LoginInfo(hash<auto> h, *bool refresh) {
        # BigCommerce may not return token_type in the response
        if (!h.token_type) {
            h.token_type = "Bearer";
        }

        # Call parent — sets Authorization header + token state + update_options
        hash<auto> rv = RestClient::gotOAuth2LoginInfo(h, refresh);

        # Replace Authorization with X-Auth-Token (BigCommerce requirement)
        # In Qore, headers += {"key": NOTHING} removes the key
        addDefaultHeaders({"X-Auth-Token": h.access_token, "Authorization": NOTHING});

        # Extract store_hash from context field (e.g., "stores/g5cd38")
        # Use .val() to handle empty strings (proxy may return context: "")
        if (h.context.val()) {
            *string store_hash = (h.context =~ x/stores\/(.+)/)[0];
            if (store_hash) {
                setURL(sprintf("%s/stores/%s", DefaultApiHost, store_hash));
            }
        }

        return rv;
    }

    #! returns options for @ref BigCommerceRestClient::BigCommerceRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Build URL from store_hash
        if (opts.store_hash) {
            rv.url = sprintf("%s/stores/%s", DefaultApiHost, opts.store_hash);
            remove rv.store_hash;
        }

        if (opts.oauth2_client_id) {
            # OAuth2 mode: merge OAuth2 options
            rv += OAuth2Options;
            # If access_token is present (from previous OAuth2 exchange), apply as X-Auth-Token
            if (opts.access_token) {
                rv.headers."X-Auth-Token" = opts.access_token;
                remove rv.access_token;
            }
        } else if (opts.access_token) {
            # Manual access_token mode: set X-Auth-Token header directly
            rv.headers."X-Auth-Token" = opts.access_token;
            remove rv.access_token;
        } else if (opts.token) {
            # Token from connection storage: route to X-Auth-Token
            # Remove from opts so RestClient doesn't set Authorization: Bearer
            rv.headers."X-Auth-Token" = opts.token;
            remove rv.token;
        }

        return rv;
    }
}

#! Class for BigCommerce REST connections; returns @ref BigCommerceRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref BigCommerceRestClient::BigCommerceRestClient::constructor() for more information
    on the above options
*/
public class BigCommerceRestConnection inherits RestClient::RestConnection {
    public {
        #! Default connection URL
        const DefaultConnectionUrl = "bigcommerceres://api.bigcommerce.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "BigCommerce REST Connection",
            "short_desc": "A connection to the BigCommerce REST API",
            "desc": "A connection to the BigCommerce REST API for e-commerce management "
                "including customers, products, orders, carts, shipments, and blog posts",
            "cls": Class::forName("BigCommerceRestConnection"),
            "auto_url": True,
            "schemes": {
                "bigcommerceres": True,
            },
            "base_scheme_map": {
                "https": "bigcommerceres",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultPingPath,
                },
                "store_hash": <ConnectionOptionInfo>{
                    "display_name": "Store Hash",
                    "short_desc": "BigCommerce store hash",
                    "type": "string",
                    "desc": "The store hash identifying your BigCommerce store. "
                        "You can find it in the BigCommerce admin under Settings > "
                        "API Accounts > API Path (e.g., "
                        "https://api.bigcommerce.com/stores/<store_hash>/v3)",
                    "preselected": True,
                },
                "access_token": <ConnectionOptionInfo>{
                    "display_name": "Access Token",
                    "short_desc": "BigCommerce API access token",
                    "type": "string",
                    "desc": "The API access token stored after OAuth2 authorization. "
                        "This field is managed automatically and does not need to be "
                        "filled in manually.",
                    "sensitive": True,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultScopes,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": BigCommerceRestClient::DefaultTokenUrl,
                },
            },
            "required_options": "oauth2_client_id,oauth2_client_secret,store_hash",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Find Your Store Hash",
                    "intent": "warning",
                    "content": "The **Store Hash** is required to connect to your BigCommerce store.\n\n"
                        "**How to find it:**\n"
                        "1. Log in to your BigCommerce admin panel\n"
                        "2. Look at the URL: `https://store-**XXXXX**.mybigcommerce.com`\n"
                        "3. The store hash is the `XXXXX` part after `store-`\n\n"
                        "**Alternative:** Go to **Settings > API Accounts** and check the "
                        "**API Path**, e.g., `https://api.bigcommerce.com/stores/**XXXXX**/v3`",
                },
            ),
        };
    }

    #! creates the BigCommerceRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes
        and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = BigCommerceRestClient::DefaultApiHost,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the BigCommerceRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(BigCommerceRestConnection::getConfig(config), attr) {
    }

    #! returns \c "bigcommerceres"
    string getType() {
        return "bigcommerceres";
    }

    #! Returns connection options
    /** Always injects BigCommerce OAuth2 URLs so they are available when OAuth2 mode is used
    */
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        # Always set OAuth2 URLs (they are fixed for BigCommerce)
        rv.oauth2_auth_url = BigCommerceRestClient::DefaultAuthUrl;
        rv.oauth2_token_url = BigCommerceRestClient::DefaultTokenUrl;
        if (!rv.oauth2_grant_type) {
            rv.oauth2_grant_type = BigCommerceRestClient::DefaultGrantType;
        }
        if (!rv.oauth2_scopes) {
            rv.oauth2_scopes = BigCommerceRestClient::DefaultScopes;
        }
        if (!rv.oauth2_auth_args) {
            rv.oauth2_auth_args = BigCommerceRestClient::DefaultAuthArgs;
        }
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "BigCommerce";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the BigCommerceDataProvider and
        # creates the data provider object dynamically
        load_module("BigCommerceDataProvider");
        return create_object("BigCommerceDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Processes OAuth2 login responses and returns updated options
    /** Extracts the \c store_hash from the BigCommerce OAuth2 response's \c context field
        and stores the \c access_token for manual-mode compatibility.

        Also updates the connection URL when \c store_hash is discovered from the response.
    */
    private *hash<auto> processOAuth2TokenResponseImpl(hash<auto> resp) {
        *hash<auto> new_opts = RestConnection::processOAuth2TokenResponseImpl(resp);
        # Store access_token as our custom option for manual-mode compatibility
        if (resp.access_token && resp.access_token != real_opts.access_token) {
            new_opts.access_token = resp.access_token;
        }
        # Extract store_hash from context (e.g., "stores/g5cd38") if available
        # NOTE: BigCommerce requires `context` in the token exchange request body,
        # but the generic OAuth2 proxy may not forward it; in that case BigCommerce
        # returns context: "" and store_hash must be provided as a connection option
        if (resp.context.val()) {
            *string store_hash = (resp.context =~ x/stores\/(.+)/)[0];
            if (store_hash && store_hash != real_opts.store_hash) {
                new_opts.store_hash = store_hash;
                # Update the connection URL with the discovered store_hash
                new_opts.url = sprintf("bigcommerceres://api.bigcommerce.com/stores/%s",
                    store_hash);
            }
        }
        return new_opts;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            # Auto-correct URL from store_hash
            if (opts.store_hash) {
                string expected_url = sprintf("bigcommerceres://api.bigcommerce.com/stores/%s",
                    opts.store_hash);
                if (url != expected_url) {
                    update.url = expected_url;
                }
            }
            # Auto-correct ping path - remove leading slash
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            # Auto-correct OAuth2 URLs (ensure they always point to BigCommerce)
            if (opts.oauth2_auth_url.val()
                    && opts.oauth2_auth_url != BigCommerceRestClient::DefaultAuthUrl) {
                update.oauth2_auth_url = BigCommerceRestClient::DefaultAuthUrl;
            }
            if (opts.oauth2_token_url.val()
                    && opts.oauth2_token_url != BigCommerceRestClient::DefaultTokenUrl) {
                update.oauth2_token_url = BigCommerceRestClient::DefaultTokenUrl;
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref BigCommerceRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this
        parameter is ignored

        @return a @ref BigCommerceRestClient object
    */
    private BigCommerceRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new BigCommerceRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! Builds the connection configuration from options
    private static hash<auto> getConfig(hash<auto> config) {
        if (config.opts.store_hash) {
            config.url = sprintf("bigcommerceres://api.bigcommerce.com/stores/%s",
                config.opts.store_hash);
        }
        return config;
    }
}
}
