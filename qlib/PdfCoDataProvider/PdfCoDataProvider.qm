# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) PdfCoRestClient
%requires json

module PdfCoDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for PDF.co document processing";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new PdfCoDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": PdfCoDataProvider::AppName,
            "display_name": "PDF.co",
            "short_desc": "PDF.co document processing platform",
            "desc": "PDF.co provides APIs for document processing including PDF conversion, "
                "manipulation, data extraction, barcode generation and reading, document "
                "classification, and more.\n\n"
                "This integration supports 26 actions covering conversion, document operations, "
                "search and editing, AI-powered extraction, barcodes, security, and email.",
            "scheme": "pdfco",
            "logo": PdfCoDataProvider::PdfCoLogo,
            "logo_file_name": "pdfco-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::DataTransformation,),
        });

        # ============================================================
        # Conversion Actions
        # ============================================================

        # convert-from-pdf
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/convert-from-pdf",
            "action": "convert-from-pdf",
            "display_name": "Convert from PDF",
            "short_desc": "Convert a PDF to another format (CSV, JSON, text, HTML, images, etc.)",
            "desc": "Converts a PDF document to the specified output format.\n\n"
                "Supported formats: CSV, JSON, JSON-AI, Text, XLS, XLSX, XML, HTML, JPG, PNG, TIFF.\n\n"
                "The `output_format` option determines which conversion endpoint is used.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertFromPdfRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertFromPdfRequestDataType::Fields{"output_format",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertFromPdfRequestDataType::Fields - ("file", "output_format"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Conversion",),
        });

        # convert-from-pdf-to-images
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/convert-from-pdf-to-images",
            "action": "convert-from-pdf-to-images",
            "display_name": "Convert from PDF into Images",
            "short_desc": "Convert a PDF into JPG or PNG images",
            "desc": "Converts a PDF document into images.\n\n"
                "Supported output formats: JPG, PNG.\n\n"
                "The `output_format` option determines the image format.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertFromPdfToImagesRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertFromPdfToImagesRequestDataType::Fields{"output_format",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertFromPdfToImagesRequestDataType::Fields - ("file", "output_format"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Conversion",),
        });

        # convert-html-to-pdf
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/convert-html-to-pdf",
            "action": "convert-html-to-pdf",
            "display_name": "Convert HTML to PDF",
            "short_desc": "Convert HTML content or a web page URL to PDF",
            "desc": "Converts HTML content or a web page URL to a PDF document.\n\n"
                "Use `source_type` = `html` to convert raw HTML content, or `url` to convert "
                "a web page.\n\n"
                "Supports margins, paper size, orientation, headers, footers, and background printing.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertHtmlToPdfRequestDataType::Fields{"file", "source_type"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertHtmlToPdfRequestDataType::Fields - ("file", "source_type"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Conversion",),
        });

        # convert-images-to-pdf
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/convert-images-to-pdf",
            "action": "convert-images-to-pdf",
            "display_name": "Convert from Images into PDF",
            "short_desc": "Convert one or more images into a PDF document",
            "desc": "Converts images to a PDF document.\n\n"
                "The `url` parameter should contain the image URL(s). "
                "Multiple images can be provided as comma-separated URLs.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertImagesToPdfRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertImagesToPdfRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Conversion",),
        });

        # convert-to-pdf
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/convert-to-pdf",
            "action": "convert-to-pdf",
            "display_name": "Convert into PDF",
            "short_desc": "Convert a document (DOC, DOCX, XLS, etc.) into PDF",
            "desc": "Converts a document file to PDF format.\n\n"
                "Supported input formats include DOC, DOCX, XLS, XLSX, RTF, TXT, and more.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertToPdfRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoConvertToPdfRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Conversion",),
        });

        # ============================================================
        # Document Operations
        # ============================================================

        # merge-pdf
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/merge-pdf",
            "action": "merge-pdf",
            "display_name": "Merge a PDF",
            "short_desc": "Merge multiple PDF documents into one",
            "desc": "Merges multiple PDF documents into a single PDF.\n\n"
                "Provide multiple source URLs as comma-separated values in the `url` field.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoMergePdfRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoMergePdfRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Document Operations",),
        });

        # split-pdf
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/split-pdf",
            "action": "split-pdf",
            "display_name": "Split a PDF",
            "short_desc": "Split a PDF document into multiple parts",
            "desc": "Splits a PDF document into multiple separate PDFs based on page ranges.\n\n"
                "Specify page ranges in the `pages` option (e.g., `1-3,4-6`).",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSplitPdfRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSplitPdfRequestDataType::Fields{"pages",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSplitPdfRequestDataType::Fields - ("file", "pages"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoSplitResponseDataType();
            },
            "groups": ("Document Operations",),
        });

        # compress-pdf
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/compress-pdf",
            "action": "compress-pdf",
            "display_name": "Compress and Optimize PDF",
            "short_desc": "Compress and optimize a PDF document to reduce file size",
            "desc": "Compresses and optimizes a PDF document to reduce its file size.\n\n"
                "Supports JPEG quality settings and custom compression profiles.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoCompressPdfRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoCompressPdfRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Document Operations",),
        });

        # add-text-images
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/add-text-images",
            "action": "add-text-images",
            "display_name": "Add Text and Images to a PDF",
            "short_desc": "Add text annotations and images to a PDF document",
            "desc": "Adds text annotations and/or images to an existing PDF document.\n\n"
                "Use `annotations` and `images` for structured input, or "
                "`annotationsString` and `imagesString` for simplified string input.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoAddTextImagesRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoAddTextImagesRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Document Operations",),
        });

        # create-fillable-form
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/create-fillable-form",
            "action": "create-fillable-form",
            "display_name": "Create Fillable PDF Form",
            "short_desc": "Create a fillable PDF form with form fields",
            "desc": "Creates a fillable PDF form by adding form field definitions "
                "to an existing PDF document.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoCreateFillableFormRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoCreateFillableFormRequestDataType::Fields{"annotations",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoCreateFillableFormRequestDataType::Fields - ("file", "annotations"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Document Operations",),
        });

        # fill-pdf-form
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/fill-pdf-form",
            "action": "fill-pdf-form",
            "display_name": "Fill a PDF Form",
            "short_desc": "Fill form fields in an existing PDF form",
            "desc": "Fills form fields in an existing PDF form document.\n\n"
                "Provide field name-value pairs in the `fields` parameter, or "
                "use `fieldsString` for simplified string input.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoFillPdfFormRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoFillPdfFormRequestDataType::Fields{"fields",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoFillPdfFormRequestDataType::Fields - ("file", "fields"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Document Operations",),
        });

        # get-pdf-info
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/get-pdf-info",
            "action": "get-pdf-info",
            "display_name": "Get PDF Information",
            "short_desc": "Get metadata and information about a PDF document",
            "desc": "Retrieves detailed information about a PDF document including "
                "page count, author, title, creation date, permissions, and other metadata.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoGetPdfInfoRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoGetPdfInfoRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoPdfInfoResponseDataType();
            },
            "groups": ("Document Operations",),
        });

        # ============================================================
        # Search & Edit Actions
        # ============================================================

        # search-text
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/search-text",
            "action": "search-text",
            "display_name": "Search Text in PDF",
            "short_desc": "Search for text in a PDF document",
            "desc": "Searches for text occurrences in a PDF document and returns "
                "the locations where the text was found.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchTextRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchTextRequestDataType::Fields{"searchString",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchTextRequestDataType::Fields - ("file", "searchString"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoSearchTextResponseDataType();
            },
            "groups": ("Search & Edit",),
        });

        # search-and-delete-text
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/search-and-delete-text",
            "action": "search-and-delete-text",
            "display_name": "Search and Delete Found Text in PDF",
            "short_desc": "Find and delete text from a PDF document",
            "desc": "Searches for text in a PDF document and deletes all occurrences.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndDeleteTextRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndDeleteTextRequestDataType::Fields{"searchString",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndDeleteTextRequestDataType::Fields - ("file", "searchString"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Search & Edit",),
        });

        # search-and-replace-text
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/search-and-replace-text",
            "action": "search-and-replace-text",
            "display_name": "Search and Replace Text in PDF",
            "short_desc": "Find and replace text in a PDF document",
            "desc": "Searches for text in a PDF document and replaces all occurrences "
                "with the specified replacement text.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndReplaceTextRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndReplaceTextRequestDataType::Fields{"searchString", "replaceString"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndReplaceTextRequestDataType::Fields - ("file", "searchString", "replaceString"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Search & Edit",),
        });

        # search-and-replace-with-image
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/search-and-replace-with-image",
            "action": "search-and-replace-with-image",
            "display_name": "Search and Replace With Image in PDF",
            "short_desc": "Find text and replace it with an image in a PDF document",
            "desc": "Searches for text in a PDF document and replaces all occurrences "
                "with the specified image.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndReplaceWithImageRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndReplaceWithImageRequestDataType::Fields{"searchString", "replaceImage"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSearchAndReplaceWithImageRequestDataType::Fields
                    - ("file", "searchString", "replaceImage"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Search & Edit",),
        });

        # ============================================================
        # Extraction & AI Actions
        # ============================================================

        # ai-invoice-parser
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/ai-invoice-parser",
            "action": "ai-invoice-parser",
            "display_name": "AI Invoice Parser",
            "short_desc": "Parse invoices using AI to extract structured data",
            "desc": "Uses AI to parse invoice documents and extract structured data "
                "including vendor information, customer details, invoice metadata, "
                "and line items.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoAiInvoiceParserRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoAiInvoiceParserRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoInvoiceParserResponseDataType();
            },
            "groups": ("Extraction & AI",),
        });

        # parse-document
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/parse-document",
            "action": "parse-document",
            "display_name": "Parse a Document",
            "short_desc": "Parse a document using templates to extract structured data",
            "desc": "Parses a document using predefined or custom templates "
                "to extract structured data.\n\n"
                "Supports JSON, CSV, and XML output formats.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoParseDocumentRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoParseDocumentRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoDocumentParserResponseDataType();
            },
            "groups": ("Extraction & AI",),
        });

        # document-classifier
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/document-classifier",
            "action": "document-classifier",
            "display_name": "Document Classifier",
            "short_desc": "Classify a document based on custom rules",
            "desc": "Classifies a document based on custom classification rules.\n\n"
                "Rules can be provided as inline CSV data (`rulescsv`) or as a URL "
                "to a CSV file (`rulescsvurl`).",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoDocumentClassifierRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoDocumentClassifierRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoDocumentClassifierResponseDataType();
            },
            "groups": ("Extraction & AI",),
        });

        # ============================================================
        # Barcode Actions
        # ============================================================

        # generate-barcode
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/generate-barcode",
            "action": "generate-barcode",
            "display_name": "Generate a Barcode",
            "short_desc": "Generate a barcode image (QR code, Code128, etc.)",
            "desc": "Generates a barcode image in the specified format.\n\n"
                "Supported types: QRCode, Code128, Code39, Datamatrix, PDF417, "
                "EAN13, EAN8, UPCA, UPCE.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoGenerateBarcodeRequestDataType::Fields{"type", "value"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoGenerateBarcodeRequestDataType::Fields - ("type", "value"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Barcodes",),
        });

        # read-barcode
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/read-barcode",
            "action": "read-barcode",
            "display_name": "Read a Barcode",
            "short_desc": "Read and decode barcodes from a document or image",
            "desc": "Reads and decodes barcodes from a document or image file.\n\n"
                "Supports multiple barcode types: QRCode, Code128, Code39, Datamatrix, "
                "PDF417, EAN13, EAN8, UPCA, UPCE.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoReadBarcodeRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoReadBarcodeRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoBarcodeReadResponseDataType();
            },
            "groups": ("Barcodes",),
        });

        # ============================================================
        # Security Actions
        # ============================================================

        # add-password
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/add-password",
            "action": "add-password",
            "display_name": "Add Password and Security into PDF",
            "short_desc": "Add password protection and encryption to a PDF",
            "desc": "Adds password protection and encryption to a PDF document.\n\n"
                "Supports AES128 and AES256 encryption algorithms.\n\n"
                "- `ownerPassword`: Controls document permissions (required)\n"
                "- `userPassword`: Required to open the document (optional)",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoAddPasswordRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoAddPasswordRequestDataType::Fields{"ownerPassword",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoAddPasswordRequestDataType::Fields - ("file", "ownerPassword"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Security",),
        });

        # remove-password
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/remove-password",
            "action": "remove-password",
            "display_name": "Remove Password and Security from PDF",
            "short_desc": "Remove password protection from a PDF document",
            "desc": "Removes password protection and security from a PDF document.\n\n"
                "Requires the current document `password` to decrypt.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoRemovePasswordRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoRemovePasswordRequestDataType::Fields{"password",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoRemovePasswordRequestDataType::Fields - ("file", "password"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("Security",),
        });

        # ============================================================
        # Email Actions
        # ============================================================

        # send-email
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/send-email",
            "action": "send-email",
            "display_name": "Send Email With Attachments",
            "short_desc": "Send an email with optional file attachments via SMTP",
            "desc": "Sends an email with optional file attachments.\n\n"
                "Requires SMTP server configuration (server, port, username, password).\n\n"
                "The `url` field is optional and specifies the attachment file URL.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSendEmailRequestDataType::Fields{"from", "to", "subject", "smtpserver",
                    "smtpport", "smtpusername", "smtppassword"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoSendEmailRequestDataType::Fields - ("from", "to", "subject", "smtpserver",
                    "smtpport", "smtpusername", "smtppassword"),
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoSendEmailResponseDataType();
            },
            "groups": ("Email",),
        });

        # ============================================================
        # System Actions
        # ============================================================

        # upload-file
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/upload-file",
            "action": "upload-file",
            "display_name": "Upload a File",
            "short_desc": "Upload a file to PDF.co temporary storage",
            "desc": "Uploads a file from a URL to PDF.co temporary storage.\n\n"
                "Returns a temporary URL that can be used as input for other PDF.co actions.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoUploadFileRequestDataType::Fields{"file",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoUploadFileRequestDataType::Fields - "file",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoUrlResponseDataType();
            },
            "groups": ("System",),
        });

        # job-check
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AppName,
            "path": "/job-check",
            "action": "job-check",
            "display_name": "Job Check",
            "short_desc": "Check the status of an asynchronous job",
            "desc": "Checks the status of an asynchronous job.\n\n"
                "Use this action to poll for the result of any action submitted "
                "with `async` = `true`.\n\n"
                "Returns the job status (`working`, `success`, or `failed`) and the "
                "result URL when complete.",
            "action_code": DPAT_API,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoJobCheckRequestDataType::Fields{"jobId",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                PdfCoJobCheckRequestDataType::Fields - "jobId",
            ),
            "get_output_type": AbstractDataProviderType sub () {
                return new PdfCoJobCheckResponseDataType();
            },
            "groups": ("System",),
        });

    };
}

/** @mainpage PdfCoDataProvider Module

    @tableofcontents

    @section pdfcodataproviderintro PdfCoDataProvider Introduction

    The %PdfCoDataProvider module provides a data provider API for the PDF.co document
    processing platform.

    To use this module, use \c "%requires PdfCoDataProvider" in your code.

    All the public symbols in the module are defined in the PdfCoDataProvider namespace.

    The main classes are:
    - @ref PdfCoDataProvider::PdfCoDataProvider "PdfCoDataProvider":
      the root data provider for PDF.co
    - @ref PdfCoDataProvider::PdfCoDataProviderFactory "PdfCoDataProviderFactory":
      the data provider factory for PDF.co

    @section pdfcodataproviderrelnotes Release Notes

    @subsection pdfcodataproviderv1_0 PdfCoDataProvider v1.0
    - the initial version of the %PdfCoDataProvider module
*/

#! Contains all public definitions in the PdfCoDataProvider module
public namespace PdfCoDataProvider {
}
