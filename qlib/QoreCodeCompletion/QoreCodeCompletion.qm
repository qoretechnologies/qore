%requires qore >= 2.0

%modern

module QoreCodeCompletion {
    version = "1.0";
    desc = "shared code completion engine for Qore";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage QoreCodeCompletion Module

    @section qorecodecompletionintro Introduction to the QoreCodeCompletion Module

    The %QoreCodeCompletion module provides a shared code completion engine for %Qore tools.
    It extracts common completion logic (context detection, keyword filtering, dispatch, deduplication,
    sorting) into a reusable module with an abstract provider interface for pluggable symbol resolution
    backends.

    The module provides:
    - @ref QoreCodeCompletion::CompletionItem "CompletionItem" hashdecl for structured completion data
    - @ref QoreCodeCompletion::AbstractCompletionProvider "AbstractCompletionProvider" abstract class for
      symbol resolution backends
    - @ref QoreCodeCompletion::CompletionEngine "CompletionEngine" class for context-aware completion dispatch

    @par Completion Contexts

    The engine detects the following completion contexts from cursor position:
    - @ref QoreCodeCompletion::CC_IDENTIFIER "CC_IDENTIFIER": bare identifier (keywords, types, all symbols)
    - @ref QoreCodeCompletion::CC_NEW "CC_NEW": after @c new keyword (class names only)
    - @ref QoreCodeCompletion::CC_DOT "CC_DOT": after @c . (instance members/methods)
    - @ref QoreCodeCompletion::CC_SCOPE "CC_SCOPE": after @c :: (namespace/class static/enum members)

    @par Provider Interface

    Consumers implement @ref QoreCodeCompletion::AbstractCompletionProvider "AbstractCompletionProvider"
    to supply symbol resolution from their backend (e.g., Reflection API for runtime, CSTSearcher for
    static analysis).

    @section qorecodecompletion_relnotes Release Notes

    @subsection qorecodecompletion_v1_0 v1.0
    - initial release: shared code completion engine for %Qore
    - context-aware completion: identifiers, @c new, dot-access (@c .), scope (@c ::)
    - abstract provider interface for pluggable symbol resolution backends
    - %Qore keyword and built-in type completions
*/

#! Main namespace for the QoreCodeCompletion module
public namespace QoreCodeCompletion {
}
