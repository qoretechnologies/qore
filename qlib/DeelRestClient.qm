# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere
# enable all warnings
# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module DeelRestClient {
    version = "1.1";
    desc = "User module for calling Deel REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("deel", DeelRestConnection::ConnectionScheme);
    };
    # the module registers process-wide functionality in its initialization (connection schemes, LLM provider factories)
    domains = "PROCESS_CONTROL";
}

/** @mainpage DeelRestClient Module

    @tableofcontents

    @section deelrestclientintro DeelRestClient Introduction

    The %DeelRestClient module provides an API for calling Deel's REST API services.

    To use this module, use \c "%requires DeelRestClient" in your code.

    All the public symbols in the module are defined in the DeelRestClient namespace.

    The main classes are:
    - @ref DeelRestClient::DeelRestClient "DeelRestClient":
      this class provides the REST client API for communication with the Deel API;
      it authenticates with OAuth2 or with an API token
    - @ref DeelRestClient::DeelRestConnection "DeelRestConnection":
      provides a connection object to Deel services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires DeelRestClient

DeelRestClient deel({"apikey": ENV.DEEL_API_TOKEN});
hash<auto> result = deel.get("legal-entities");
printf("Legal Entities: %Y\n", result.body);
    @endcode

    @section deelrestclient_auth Authentication

    |!Method|!What it is|!Options
    |OAuth2|the authorization code flow, with refresh tokens, against an app registered in Deel's Developer \
Center|\c oauth2_client_id, \c oauth2_client_secret
    |API token|a personal or organization token created in Deel's Developer Center|\c apikey

    OAuth2 is the first alternative of the connection.  Deel authorizes at
    \c https://app.deel.com/oauth2/authorize and issues and refreshes tokens at \c https://app.deel.com/oauth2/tokens,
    which takes the client ID and secret by HTTP basic authentication; both are set by default.  Every API call made
    with an OAuth2 token must also send the client ID in the \c x-client-id header, which the client adds to its
    default headers (see <a href="https://developer.deel.com/api/oauth">Deel OAuth2</a>).

    When an \c apikey is given, it is sent as a Bearer token and the OAuth2 options are removed, so that the
    client does not try to run the OAuth2 flow.

    @section deelrestclientrelnotes Release Notes

    @subsection deelrestclientv1_1 DeelRestClient v1.1
    - added OAuth2 authorization code authentication with refresh tokens as the first alternative of the
      connection, with the API token kept as the fallback; OAuth2 requests send the client ID in the
      \c x-client-id header (<a href="https://github.com/qoretechnologies/qore/issues/6896">issue 6896</a>)

    @subsection deelrestclientv1_0 DeelRestClient v1.0
    - initial release
*/

#! the DeelRestClient namespace contains all the objects in the DeelRestClient module
public namespace DeelRestClient {

#! Common base class for DeelRestClient functionality
public class DeelRestClientBase {
    public {
        #! Deel API base URL
        const DefaultApiUrl = "https://api.letsdeel.com/rest/v2";

        #! Deel sandbox API base URL
        const SandboxApiUrl = "https://api-sandbox.demo.deel.com/rest/v2";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default Deel ping method
        const DefaultPingMethod = "GET";

        #! Default Deel ping path (list legal entities - lightweight, always available)
        const DefaultPingPath = "legal-entities";

        #! Default Deel ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OAuth2 authorization request URL
        const DefaultAuthUrl = "https://app.deel.com/oauth2/authorize";

        #! Default OAuth2 token request URL
        /** Used for both the authorization code exchange and refreshes; Deel takes the client ID and secret by
            HTTP basic authentication here.
        */
        const DefaultTokenUrl = "https://app.deel.com/oauth2/tokens";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default OAuth2 scopes
        /** The token scopes that Deel's API reference names for the endpoints the
            @ref deeldataproviderintro "DeelDataProvider" module calls: contracts, timesheets, invoice adjustments,
            people, time off, invoices (\c accounting:read), legal entities (\c organizations:read) and webhooks.
            Deel accepts only scopes that the registered app holds.
        */
        const DefaultScopes = (
            "contracts:read",
            "contracts:write",
            "timesheets:read",
            "timesheets:write",
            "invoice-adjustments:read",
            "invoice-adjustments:write",
            "people:read",
            "people:write",
            "time-off:read",
            "time-off:write",
            "accounting:read",
            "organizations:read",
            "webhooks:read",
            "webhooks:write",
        );

        #! The header that carries the OAuth2 client ID on every API call
        const ClientIdHeader = "x-client-id";

        #! OAuth2 options set by default when the OAuth2 client ID is given
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_scopes": DefaultScopes,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_token_use_basic_auth": True,
        };

        #! Options that only apply to OAuth2; removed when an API token is given
        const OAuth2OptionNames = (
            "oauth2_auth_args",
            "oauth2_auth_url",
            "oauth2_client_id",
            "oauth2_client_secret",
            "oauth2_grant_type",
            "oauth2_redirect_url",
            "oauth2_refresh_token",
            "oauth2_scopes",
            "oauth2_token_url",
            "oauth2_token_use_basic_auth",
        );

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! returns options for DeelRestClient constructors
    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;
        # the headers are set in an "auto!" local: a caller's headers option may be narrowed (e.g. hash<string, int>
        # for {"X-Count": 1}), and adding a string header would throw
        *hash<auto!> hdr = rv.headers;

        # Set API URL (use default unless caller provided an override)
        if (!rv.url) {
            rv.url = rv.use_sandbox ? SandboxApiUrl : DefaultApiUrl;
        }
        remove rv.use_sandbox;

        if (opts.apikey.val()) {
            # Set Bearer token Authorization header and remove apikey from opts
            # so that RestClient does not attempt to handle it specially
            hdr.Authorization = "Bearer " + opts.apikey;
            remove rv.apikey;
            # a client authenticating with an API token does not use OAuth2; the OAuth2 options are removed after
            # the defaults are applied, or a defaulted grant type would make the client demand a client ID and
            # secret.  The test is whether an API token was given: an authorized OAuth2 connection also has a
            # token and keeps its OAuth2 options so that the token can be refreshed
            rv -= OAuth2OptionNames;
        } else if (opts.oauth2_client_id.val()) {
            # set the OAuth2 defaults for the options not given
            map rv{$1.key} = $1.value, OAuth2Options.pairIterator(), !exists rv{$1.key};
            # Deel rejects an OAuth2 request without the client ID in this header
            hdr{ClientIdHeader} = opts.oauth2_client_id;
        } else if (!opts.token.val()) {
            throw "DEEL-ERROR", "missing required option 'apikey' (Deel API access token) or the OAuth2 options "
                "'oauth2_client_id' and 'oauth2_client_secret'";
        }

        if (exists hdr) {
            rv.headers = hdr;
        }
        return rv;
    }
}

#! This class provides the REST client API for communication with Deel servers
/** Deel uses a REST API with Bearer token authentication.

    The Bearer token is either an OAuth2 access token, acquired with the authorization code flow, or an API
    access token given with the \c apikey option; API tokens can be personal tokens (linked to a user) or
    organization tokens (service-level access).  With OAuth2, every request also sends the client ID in the
    \c x-client-id header.  See @ref deelrestclient_auth.

    @par API Information:
    - Base URL: https://api.letsdeel.com/rest/v2
    - Generate tokens at: https://app.deel.com/developer-center
*/
public class DeelRestClient inherits RestClient::RestClient, DeelRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
DeelRestClient deel({"apikey": "your-api-token"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the Deel API access token; if given, the OAuth2 options are removed

        Without \c apikey, the OAuth2 options are used (\c oauth2_client_id and \c oauth2_client_secret, with
        \c token and \c oauth2_refresh_token once authorized); the other OAuth2 options default to Deel's
        endpoints, and the client ID is sent in the \c x-client-id header of every request.

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw DEEL-ERROR neither the \c apikey option nor the OAuth2 client ID or a token is given
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(DeelRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Deel REST connections; returns @ref DeelRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c apikey: the Deel API access token, the fallback to OAuth2

    The OAuth2 options default to Deel's authorization code flow; see @ref deelrestclient_auth.

    @see @ref DeelRestClient::DeelRestClient::constructor() for more information on the above options
*/
public class DeelRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Deel connection URL
        const DefaultConnectionUrl = "deel://api.letsdeel.com/rest/v2";

        #! Deel sandbox connection URL
        const SandboxConnectionUrl = "deel://api-sandbox.demo.deel.com/rest/v2";

        #! Connection entry info
        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation("DeelRestClient",
            "DeelRestConnection", "en", <ConnectionSchemeInfo>{
            "display_name": "Deel REST Connection",
            "short_desc": "A connection to the Deel REST API",
            "desc": "A connection to the Deel REST API for global workforce management.\n\n"
                "Deel is a global HR platform for hiring, managing, and paying contractors "
                "and full-time employees worldwide. This integration supports contracts, "
                "timesheets, invoice adjustments, workers, time-off, legal entities, "
                "invoices, and event triggers.\n\n"
                "**Authentication** is OAuth2 (authorization code with refresh tokens) with an app "
                "registered in Deel's Developer Center, or an **API token** as the fallback.",
            "cls": Class::forName("DeelRestConnection"),
            "auto_url": True,
            "schemes": {
                "deel": True,
            },
            "base_scheme_map": {
                "https": "deel",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": connection_option_override(RestConnection::ConnectionScheme.options."data", {
                    "default_value": DeelRestClientBase::DefaultData,
                }),
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Token",
                    "short_desc": "Deel API access token",
                    "type": "string",
                    "desc": "The Deel API access token used for authentication.\n\n"
                        "Generate a token in the **Developer Center** at "
                        "https://app.deel.com/developer-center\n\n"
                        "Both **personal tokens** (linked to a user account) and "
                        "**organization tokens** (service-level access) are supported.",
                    "sensitive": True,
                },
                "oauth2_auth_url": connection_option_override(
                    RestConnection::ConnectionScheme.options.oauth2_auth_url, {
                        "default_value": DeelRestClientBase::DefaultAuthUrl,
                    }),
                "oauth2_grant_type": connection_option_override(
                    RestConnection::ConnectionScheme.options.oauth2_grant_type, {
                        "default_value": DeelRestClientBase::DefaultGrantType,
                    }),
                "oauth2_scopes": connection_option_override(RestConnection::ConnectionScheme.options.oauth2_scopes, {
                    "default_value": DeelRestClientBase::DefaultScopes,
                }),
                "oauth2_token_url": connection_option_override(
                    RestConnection::ConnectionScheme.options.oauth2_token_url, {
                        "default_value": DeelRestClientBase::DefaultTokenUrl,
                    }),
                "oauth2_token_use_basic_auth": connection_option_override(
                    RestConnection::ConnectionScheme.options.oauth2_token_use_basic_auth, {
                        "default_value": True,
                    }),
                "use_sandbox": <ConnectionOptionInfo>{
                    "display_name": "Use Sandbox",
                    "short_desc": "Use Deel sandbox environment for testing",
                    "type": "bool",
                    "desc": "If `True`, API calls target the Deel sandbox environment "
                        "(`https://api-sandbox.demo.deel.com/rest/v2`) for safe testing.\n\n"
                        "If `False` (default), API calls target the production environment "
                        "(`https://api.letsdeel.com/rest/v2`).\n\n"
                        "**Note:** Sandbox and production use separate API tokens. Generate "
                        "a sandbox token from the Developer Center when using this option.",
                    "default_value": False,
                    "preselected": True,
                },
                "ping_headers": connection_option_override(RestConnection::ConnectionScheme.options."ping_headers", {
                    "default_value": DeelRestClientBase::DefaultPingHeaders,
                }),
                "ping_method": connection_option_override(RestConnection::ConnectionScheme.options."ping_method", {
                    "default_value": DeelRestClientBase::DefaultPingMethod,
                }),
                "ping_path": connection_option_override(RestConnection::ConnectionScheme.options."ping_path", {
                    "default_value": DeelRestClientBase::DefaultPingPath,
                }),
            },
            # OAuth2 is the first alternative; an API token is the fallback
            "required_options": "oauth2_client_id,oauth2_client_secret|apikey",
            "messages": (
                <UiMessageInfo>{
                    "presentation_id": "setup-1",
                    "title": "How to Generate Your API Token",
                    "intent": "info",
                    "content": "1. Log in to Deel at https://app.deel.com\n"
                        "2. Go to the **Developer Center**: "
                        "https://app.deel.com/developer-center\n"
                        "3. Click **Create Token** and choose the token type:\n"
                        "   - **Personal Token**: Linked to your user account and inherits "
                        "your permissions\n"
                        "   - **Organization Token**: Service-level access not tied to a "
                        "specific user\n"
                        "4. Copy the token value and paste it into the **API Token** field\n\n"
                        "**Important:**\n"
                        "- Only Org Admins or IT Developer Admins can create tokens\n"
                        "- Store your token securely; treat it like a password",
                },
                <UiMessageInfo>{
                    "presentation_id": "setup-2",
                    "title": "Sandbox vs Production",
                    "intent": "info",
                    "content": "**Sandbox environment** is available for safe testing without "
                        "affecting real data.\n\n"
                        "- Enable **Use Sandbox** to connect to "
                        "`https://api-sandbox.demo.deel.com/rest/v2`\n"
                        "- Sandbox tokens are separate from production tokens — generate one "
                        "at https://app.deel.com/developer-center\n"
                        "- Leave **Use Sandbox** disabled for production use",
                },
            ),
        });
    }

    #! creates the DeelRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the DeelRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(DeelRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref DeelRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": config.opts.use_sandbox ? SandboxConnectionUrl : DefaultConnectionUrl,
        };
    }

    #! returns \c "deel"
    string getType() {
        return "deel";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the @ref getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        return "Deel";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the DeelDataProvider and creates the data provider
        # object dynamically
        load_module("DeelDataProvider");
        return create_object("DeelDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Returns the OAuth2 grant type this connection authenticates with, if any
    /** A connection with an API token does not use OAuth2, although the OAuth2 options have default values
    */
    private *string getOAuth2GrantType() {
        if (!opts.apikey.val()) {
            return RestConnection::getOAuth2GrantType();
        }
    }

    #! Checks if the connection can communicate
    /** A connection with an API token does not need the OAuth2 options that the defaulted grant type requires
    */
    private checkCanConnect() {
        if (!opts.apikey.val()) {
            RestConnection::checkCanConnect();
        }
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        *string target_url = opts.use_sandbox ? SandboxConnectionUrl : DefaultConnectionUrl;
        if (update_options && url != target_url) {
            doUpdateOptions(self, {"url": target_url});
        }
    }

    #! returns a @ref DeelRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref DeelRestClient object
    */
    private DeelRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new DeelRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since DeelRestClient 1.0
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new DeelRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Deel REST API using multiplexed HTTP connections
/** @see DeelRestClient for more information
*/
public class DeelRestClientIo inherits RestClientIo::RestClientIo, DeelRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(DeelRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
