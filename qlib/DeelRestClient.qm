# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere
# enable all warnings
# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) ConnectionProvider >= 1.4

module DeelRestClient {
    version = "1.0";
    desc = "User module for calling Deel REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("deel", DeelRestConnection::ConnectionScheme);
    };
}

/** @mainpage DeelRestClient Module

    @tableofcontents

    @section deelrestclientintro DeelRestClient Introduction

    The %DeelRestClient module provides an API for calling Deel's REST API services.

    To use this module, use \c "%requires DeelRestClient" in your code.

    All the public symbols in the module are defined in the DeelRestClient namespace.

    The main classes are:
    - @ref DeelRestClient::DeelRestClient "DeelRestClient":
      this class provides the REST client API for communication with the Deel API;
      it handles authentication via Bearer token
    - @ref DeelRestClient::DeelRestConnection "DeelRestConnection":
      provides a connection object to Deel services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires DeelRestClient

DeelRestClient deel({"apikey": ENV.DEEL_API_TOKEN});
hash<auto> result = deel.get("legal-entities");
printf("Legal Entities: %N\n", result.body);
    @endcode

    @section deelrestclientrelnotes Release Notes

    @subsection deelrestclientv1_0 DeelRestClient v1.0
    - the initial version of the %DeelRestClient module
*/

#! the DeelRestClient namespace contains all the objects in the DeelRestClient module
public namespace DeelRestClient {

#! This class provides the REST client API for communication with Deel servers
/** Deel uses a REST API with Bearer token authentication.

    Authentication is done via an API access token passed as a Bearer token in the
    Authorization header. Tokens can be personal tokens (linked to a user) or
    organization tokens (service-level access).

    @par API Information:
    - Base URL: https://api.letsdeel.com/rest/v2
    - Generate tokens at: https://app.deel.com/developer-center
*/
public class DeelRestClient inherits RestClient::RestClient {
    public {
        #! Deel API base URL
        const DefaultApiUrl = "https://api.letsdeel.com/rest/v2";

        #! Deel sandbox API base URL
        const SandboxApiUrl = "https://api-sandbox.demo.deel.com/rest/v2";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default Deel ping method
        const DefaultPingMethod = "GET";

        #! Default Deel ping path (list legal entities - lightweight, always available)
        const DefaultPingPath = "legal-entities";

        #! Default Deel ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
DeelRestClient deel({"apikey": "your-api-token"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the Deel API access token (required)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw DEEL-ERROR missing required option 'apikey'
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(DeelRestClient::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! returns options for @ref DeelRestClient::DeelRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Set API URL (use default unless caller provided an override)
        if (!rv.url) {
            rv.url = rv.use_sandbox ? SandboxApiUrl : DefaultApiUrl;
        }
        remove rv.use_sandbox;

        # Validate apikey is provided
        if (!opts.apikey) {
            throw "DEEL-ERROR", "missing required option 'apikey' (Deel API access token)";
        }

        # Set Bearer token Authorization header and remove apikey from opts
        # so that RestClient does not attempt to handle it specially
        rv.headers.Authorization = "Bearer " + opts.apikey;
        remove rv.apikey;

        return rv;
    }
}

#! Class for Deel REST connections; returns @ref DeelRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c apikey: the Deel API access token

    @see @ref DeelRestClient::DeelRestClient::constructor() for more information on the above options
*/
public class DeelRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Deel connection URL
        const DefaultConnectionUrl = "deel://api.letsdeel.com/rest/v2";

        #! Deel sandbox connection URL
        const SandboxConnectionUrl = "deel://api-sandbox.demo.deel.com/rest/v2";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Deel REST Connection",
            "short_desc": "A connection to the Deel REST API",
            "desc": "A connection to the Deel REST API for global workforce management.\n\n"
                "Deel is a global HR platform for hiring, managing, and paying contractors "
                "and full-time employees worldwide. This integration supports contracts, "
                "timesheets, invoice adjustments, workers, time-off, legal entities, "
                "invoices, and event triggers.",
            "cls": Class::forName("DeelRestConnection"),
            "auto_url": True,
            "schemes": {
                "deel": True,
            },
            "base_scheme_map": {
                "https": "deel",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": DeelRestClient::DefaultData,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Token",
                    "short_desc": "Deel API access token",
                    "type": "string",
                    "desc": "The Deel API access token used for authentication.\n\n"
                        "Generate a token in the **Developer Center** at "
                        "https://app.deel.com/developer-center\n\n"
                        "Both **personal tokens** (linked to a user account) and "
                        "**organization tokens** (service-level access) are supported.",
                    "sensitive": True,
                    "preselected": True,
                },
                "use_sandbox": <ConnectionOptionInfo>{
                    "display_name": "Use Sandbox",
                    "short_desc": "Use Deel sandbox environment for testing",
                    "type": "bool",
                    "desc": "If `True`, API calls target the Deel sandbox environment "
                        "(`https://api-sandbox.demo.deel.com/rest/v2`) for safe testing.\n\n"
                        "If `False` (default), API calls target the production environment "
                        "(`https://api.letsdeel.com/rest/v2`).\n\n"
                        "**Note:** Sandbox and production use separate API tokens. Generate "
                        "a sandbox token from the Developer Center when using this option.",
                    "default_value": False,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": DeelRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": DeelRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": DeelRestClient::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Generate Your API Token",
                    "intent": "info",
                    "content": "1. Log in to Deel at https://app.deel.com\n"
                        "2. Go to the **Developer Center**: "
                        "https://app.deel.com/developer-center\n"
                        "3. Click **Create Token** and choose the token type:\n"
                        "   - **Personal Token**: Linked to your user account and inherits "
                        "your permissions\n"
                        "   - **Organization Token**: Service-level access not tied to a "
                        "specific user\n"
                        "4. Copy the token value and paste it into the **API Token** field\n\n"
                        "**Important:**\n"
                        "- Only Org Admins or IT Developer Admins can create tokens\n"
                        "- Store your token securely; treat it like a password",
                },
                <UiMessageInfo>{
                    "title": "Sandbox vs Production",
                    "intent": "info",
                    "content": "**Sandbox environment** is available for safe testing without "
                        "affecting real data.\n\n"
                        "- Enable **Use Sandbox** to connect to "
                        "`https://api-sandbox.demo.deel.com/rest/v2`\n"
                        "- Sandbox tokens are separate from production tokens — generate one "
                        "at https://app.deel.com/developer-center\n"
                        "- Leave **Use Sandbox** disabled for production use",
                },
            ),
        };
    }

    #! creates the DeelRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the DeelRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(DeelRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref DeelRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": config.opts.use_sandbox ? SandboxConnectionUrl : DefaultConnectionUrl,
        };
    }

    #! returns \c "deel"
    string getType() {
        return "deel";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the @ref getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        return "Deel";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the DeelDataProvider and creates the data provider
        # object dynamically
        load_module("DeelDataProvider");
        return create_object("DeelDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        *string target_url = opts.use_sandbox ? SandboxConnectionUrl : DefaultConnectionUrl;
        if (update_options && url != target_url) {
            doUpdateOptions(self, {"url": target_url});
        }
    }

    #! returns a @ref DeelRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref DeelRestClient object
    */
    private DeelRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new DeelRestClient(getConnectionOptions(), !connect);
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
