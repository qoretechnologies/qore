# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires Mime >= 1.3
%requires(reexport) DataProvider
%requires(reexport) RestSchemaActions
%requires StripeRestClient
%requires RestClientIo

%requires json

module StripeDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Stripe";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factory
        DataProvider::registerFactory(new StripeDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": StripeDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Stripe",
            "short_desc": "Take payments and manage customers, invoices and payouts in Stripe",
            "desc": "Provides access to [Stripe](https://stripe.com), the payments platform, for taking "
                "money and managing everything around it.\n\n"
                "**Common use cases**:\n"
                "- **Payments**: start a payment, refund it in full or in part, and look up what was "
                "charged and what it cost\n"
                "- **Customers**: create and update customers, attach payment sources to them, and credit "
                "or debit their balance\n"
                "- **Billing**: raise invoices and subscribe customers to recurring prices\n"
                "- **Reconciliation**: read the balance and the transactions behind each payout, so a "
                "deposit can be matched against the payments that made it up\n"
                "- **Connect**: onboard connected accounts, add their payout destinations and the people "
                "on their legal entity, and act on their behalf\n\n"
                "Actions are generated from Stripe's own OpenAPI 3 schema, pinned to one API version, so "
                "the fields an action offers and the shape it returns are the ones Stripe documents for "
                "that version.\n\n"
                "Authentication is a Stripe secret or restricted key, or an access token from Stripe "
                "Connect's OAuth2 flow. A **restricted key**, limited to the resources the integration "
                "needs, is the better choice in production.\n\n"
                "Stripe is a trademark of Stripe, Inc.",
            "scheme": "stripe",
            "logo": Priv::StripeLogo,
            "logo_file_name": "stripe-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Payments,),
        });

        # register every action in the manifest
        RestSchemaActionSet action_set = StripeSchema::getActionSet();
        action_set.registerActions(StripeDataProvider::AppName);

        # register the webhook event actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_CHARGE_SUCCEEDED,
            "action": EVENT_CHARGE_SUCCEEDED,
            "display_name": "Charge Succeeded",
            "short_desc": "React to a charge succeeding",
            "desc": "Fires when a charge succeeds and the money has been taken.\n\nThis is the signal to fulfil an order. `amount` is in the currency's smallest unit, and `payment_intent` links back to the payment that produced the charge.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CHARGE_SUCCEEDED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_CHARGE_REFUNDED,
            "action": EVENT_CHARGE_REFUNDED,
            "display_name": "Charge Refunded",
            "short_desc": "React to a charge being refunded",
            "desc": "Fires when a charge is refunded, in full or in part.\n\n`amount_refunded` is how much has been returned in total, which is not necessarily the whole `amount`: a charge can be refunded repeatedly until it is exhausted.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CHARGE_REFUNDED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_CHARGE_DISPUTE_CREATED,
            "action": EVENT_CHARGE_DISPUTE_CREATED,
            "display_name": "Dispute Created",
            "short_desc": "React to a customer disputing a charge",
            "desc": "Fires when a cardholder disputes a charge.\n\n**This is time-critical.** The disputed amount and a fee are withdrawn immediately, and evidence must be submitted by `evidence_details.due_by` or the dispute is lost by default.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CHARGE_DISPUTE_CREATED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_CHECKOUT_SESSION_COMPLETED,
            "action": EVENT_CHECKOUT_SESSION_COMPLETED,
            "display_name": "Checkout Session Completed",
            "short_desc": "React to a customer completing Stripe Checkout",
            "desc": "Fires when a customer finishes a Stripe Checkout session.\n\nCompletion means the customer got through the flow; check `payment_status` before fulfilling, because a session using a delayed payment method can complete while the payment is still pending.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CHECKOUT_SESSION_COMPLETED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_CUSTOMER_CREATED,
            "action": EVENT_CUSTOMER_CREATED,
            "display_name": "Customer Created",
            "short_desc": "React to a customer being created",
            "desc": "Fires when a customer is created, however it happened — through the API, the dashboard, or a Checkout session.\n\nUseful for keeping a CRM in step with Stripe without polling.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_CUSTOMER_CREATED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_INVOICE_CREATED,
            "action": EVENT_INVOICE_CREATED,
            "display_name": "Invoice Created",
            "short_desc": "React to an invoice being created",
            "desc": "Fires when an invoice is created.\n\nA new invoice is a **draft**, so this is the moment to add line items or a discount before it is finalized and sent.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_INVOICE_CREATED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_INVOICE_PAYMENT_FAILED,
            "action": EVENT_INVOICE_PAYMENT_FAILED,
            "display_name": "Invoice Payment Failed",
            "short_desc": "React to an invoice payment failing",
            "desc": "Fires when payment of an invoice fails.\n\nFor a subscription this is the start of dunning, not the end of it: Stripe will retry on the account's schedule, so treat this as a prompt to ask the customer for a new payment method rather than as a cancellation.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_INVOICE_PAYMENT_FAILED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_PAYMENT_INTENT_SUCCEEDED,
            "action": EVENT_PAYMENT_INTENT_SUCCEEDED,
            "display_name": "Payment Succeeded",
            "short_desc": "React to a payment succeeding",
            "desc": "Fires when a payment intent succeeds.\n\nThis is the reliable signal that a payment completed, including one that needed the customer to authenticate; it arrives whether or not the customer stayed on the page.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_PAYMENT_INTENT_SUCCEEDED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_PAYMENT_INTENT_FAILED,
            "action": EVENT_PAYMENT_INTENT_FAILED,
            "display_name": "Payment Failed",
            "short_desc": "React to a payment failing",
            "desc": "Fires when a payment intent fails.\n\n`last_payment_error` says why. A failure is not always final — the same payment intent can be confirmed again with a different payment method.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_PAYMENT_INTENT_FAILED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_PAYMENT_LINK_CREATED,
            "action": EVENT_PAYMENT_LINK_CREATED,
            "display_name": "Payment Link Created",
            "short_desc": "React to a payment link being created",
            "desc": "Fires when a payment link is created.\n\nA payment link is a reusable URL that takes payments without any integration code, so this is useful for recording links colleagues create in the dashboard.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_PAYMENT_LINK_CREATED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_SUBSCRIPTION_CREATED,
            "action": EVENT_SUBSCRIPTION_CREATED,
            "display_name": "Subscription Created",
            "short_desc": "React to a subscription being created",
            "desc": "Fires when a customer subscribes.\n\nCheck `status` before granting access: a subscription can start as `trialing`, or as `incomplete` when its first payment has not gone through yet.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SUBSCRIPTION_CREATED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_SUBSCRIPTION_UPDATED,
            "action": EVENT_SUBSCRIPTION_UPDATED,
            "display_name": "Subscription Updated",
            "short_desc": "React to a subscription changing",
            "desc": "Fires whenever a subscription changes — an upgrade or downgrade, a quantity change, a trial ending, or a payment failure moving it to `past_due`.\n\nThe event's `data.previous_attributes` holds only the fields that changed, which is the reliable way to tell what actually happened.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SUBSCRIPTION_UPDATED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": StripeDataProvider::AppName,
            "path": "/events/" + EVENT_SUBSCRIPTION_CANCELED,
            "action": EVENT_SUBSCRIPTION_CANCELED,
            "display_name": "Subscription Canceled",
            "short_desc": "React to a subscription ending",
            "desc": "Fires when a subscription ends and billing stops.\n\nThis is the signal to revoke access. A subscription set to cancel at the end of its period stays active until then, and this fires when that moment arrives — not when the cancellation was requested.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SUBSCRIPTION_CANCELED,
            "groups": ("Events",),
            "output_type": StripeEventDataType,
        });

    };
}

/** @mainpage StripeDataProvider Module

    @tableofcontents

    @section stripedataproviderintro StripeDataProvider Introduction

    The %StripeDataProvider module provides a @ref dataproviderintro "data provider" API for
    [Stripe](https://stripe.com), the payments platform.

    @section stripedataprovider_generated Generated, Not Hand-Written

    The actions this application exports are **generated from Stripe's own OpenAPI 3 schema** by the
    @ref restschemaactionsintro "RestSchemaActions" module, rather than being hand-written.  A schema
    describes the transport contract precisely and is maintained by Stripe; duplicating several hundred
    request and response fields in %Qore would mean finding and reproducing every upstream change by
    hand.

    What a schema cannot say is which of an operation's fields a user should see first, which
    identifiers should be selectable rather than typed, or that a wire-level integer is really a date.
    Those come from an application-owned manifest and UX overlay in
    @ref StripeDataProvider::StripeManifest "StripeManifest".

    @section stripedataprovider_pinned The Pinned Schema

    The schema is committed to this module rather than fetched at run time, so an upstream change
    cannot alter the contract of an action that existing workflows already call:

    |!Property|!Value
    |Source|https://raw.githubusercontent.com/stripe/openapi/master/openapi/spec3.json
    |SHA-256|\c 3653ad45bbec54fcbe461c541c908355b715018bdf455a0e11b27bedb2cbdee5
    |Stripe API version|\c 2026-07-29.dahlia
    |Imported|2026-08-08

    The committed copy is pruned to the exported operations and everything they reference — 21 of 416
    paths and 1022 of 1440 component schemas.  That is not only a size reduction: parsing the full
    document takes around 45 seconds, which is not a reasonable cost for an application exposing a few
    dozen operations.

    The @ref StripeRestClient::StripeRestClientBase::DefaultApiVersion "Stripe-Version" header sent by
    the @ref striperestclientintro "StripeRestClient" module is pinned to the same release, so what the
    actions declare and what Stripe returns describe the same API.  **The schema and that header must
    be updated together.**

    @section stripedataprovider_actions Actions

    38 operations are exported, in these groups:

    |!Group|!What it covers
    |Account|the account the credentials belong to
    |Balance|funds Stripe holds, and the ledger behind each payout
    |Charges|charges, including the legacy direct-charge API
    |Customers|customers, their payment sources, balance entries and subscriptions
    |Invoices|invoices
    |Payment Intents|starting a payment
    |Refunds|refunding a payment
    |Connected Accounts|Stripe Connect onboarding and management

    Identifier options are dropdowns wherever the application exports an operation that can list the
    values, so a user picks a customer rather than pasting a \c cus_ ID.

    @section stripedataprovider_amounts Amounts and Timestamps

    Two conventions are worth knowing before using these actions:

    - **Amounts are integers in the currency's smallest unit.** \c 2000 is $20.00 in USD, but ¥2000 in
      JPY, which has no minor unit.
    - **Stripe's timestamps are counts of seconds since the epoch.** Every one of them is presented as
      a %Qore @ref date "date" and converted on the way out, so the unit is decided once rather than by
      each caller.

    @section stripedataprovider_events Events

    13 webhook events are reported, covering payments, refunds, disputes, checkout, customers, invoices,
    payment links and subscriptions.  Subscribing to one registers a webhook endpoint with Stripe pinned
    to the same API version as the actions, so event payloads are formatted to the release this module
    documents rather than to the account's default.

    **Every delivery is verified.**  A webhook endpoint is a URL anyone on the internet can post to;
    without verification it would accept a fabricated \c charge.succeeded, which is enough to make an
    integration ship goods that were never paid for, or a fabricated \c invoice.payment_failed, enough to
    suspend a paying customer's account.  A delivery whose \c Stripe-Signature does not verify against the
    endpoint's signing secret is dropped, as is one old enough to be a replay of a captured delivery.
    There is no option that turns this off.

    Two things are worth knowing when handling these events:

    - **Stripe can deliver the same event more than once.**  Record the event \c id and ignore one already
      processed, so that handling is idempotent.
    - **For an update, \c data.previous_attributes holds only the fields that changed**, which is the
      reliable way to tell what actually happened — a \c customer.subscription.updated event fires for an
      upgrade, a quantity change, a trial ending and a failed payment alike.

    @section stripedataproviderrelnotes Release Notes

    @subsection stripedataproviderv1_0 StripeDataProvider v1.0
    - the initial version of the %StripeDataProvider module
*/

#! contains all public definitions in the StripeDataProvider module
public namespace StripeDataProvider {
}
