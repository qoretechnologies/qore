# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires Mime >= 1.3
%requires(reexport) DataProvider
%requires(reexport) RestSchemaActions
%requires PaddleRestClient
%requires RestClientIo

%requires json

module PaddleDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Paddle";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factory
        DataProvider::registerFactory(new PaddleDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": PaddleDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Paddle",
            "short_desc": "Sell software through Paddle and manage the billing around it",
            "desc": "Provides access to [Paddle](https://www.paddle.com), the billing platform for "
                "software businesses.\n\n"
                "Paddle is a **merchant of record**: it sells on your behalf, which means it — not you — "
                "handles payment processing, sales tax registration and remittance, invoicing and "
                "chargebacks, and then pays out the balance.\n\n"
                "**Common use cases**:\n"
                "- **Catalog**: create and update the products you sell and the prices they are sold at, "
                "including per-country pricing\n"
                "- **Customers**: create and update customers, and read the credit they hold\n"
                "- **Billing**: raise transactions, bill them, and read what was actually collected\n"
                "- **Subscriptions**: read subscriptions and what they are billing for\n"
                "- **Reporting**: request a report and download the CSV Paddle generates\n\n"
                "Actions are generated from Paddle's own OpenAPI 3.1 description, so the fields an action "
                "offers and the shape it returns are the ones Paddle documents.\n\n"
                "Authentication is a Paddle API key, granted an explicit set of permissions in the Paddle "
                "dashboard. **Sandbox and production are separate environments** with separate data and "
                "separate keys.\n\n"
                "Paddle is a trademark of Paddle.com Market Ltd.",
            "scheme": "paddle",
            "logo": Priv::PaddleLogo,
            "logo_file_name": "paddle-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Payments,),
        });

        # register every action in the manifest
        RestSchemaActionSet action_set = PaddleSchema::getActionSet();
        action_set.registerActions(PaddleDataProvider::AppName);

        # register the webhook event actions
        foreach hash<PaddleEventRegistrationInfo> event in (PaddleEvents) {
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": PaddleDataProvider::AppName,
                "path": "/" + PaddleDataProvider::EventsChildName + "/" + event.event,
                "action": event.event,
                "display_name": event.display_name,
                "short_desc": event.short_desc,
                "desc": event.desc,
                "action_code": DPAT_EVENT,
                "action_val": event.event,
                "groups": ("Events",),
                "output_type": PaddleEventDataType,
            });
        }
    };
}

/** @mainpage PaddleDataProvider Module

    @tableofcontents

    @section paddledataproviderintro PaddleDataProvider Introduction

    The %PaddleDataProvider module provides a @ref dataproviderintro "data provider" API for
    [Paddle](https://www.paddle.com), the billing platform for software businesses.

    Paddle is a **merchant of record**: it sells your software on your behalf, so it handles payment
    processing, sales tax and invoicing, and pays out the balance.  An integration works with catalog
    products and prices, customers, transactions, subscriptions and reports.

    @section paddledataprovider_generated Generated, Not Hand-Written

    The actions this application exports are **generated from Paddle's own OpenAPI 3.1 description** by
    the @ref restschemaactionsintro "RestSchemaActions" module, rather than being hand-written.  A schema
    describes the transport contract precisely and is maintained by Paddle; duplicating several hundred
    request and response fields in %Qore would mean finding and reproducing every upstream change by
    hand.

    What a schema cannot say is which of an operation's fields a user should see first, which
    identifiers should be selectable rather than typed, or which of several endpoints is the one to
    reach for.  Those come from an application-owned manifest and UX overlay in
    @ref PaddleDataProvider::PaddleManifest "PaddleManifest".

    @section paddledataprovider_pinned The Pinned Schema

    The schema is committed to this module rather than fetched at run time, so an upstream change
    cannot alter the contract of an action that existing workflows already call:

    |!Property|!Value
    |Source|https://github.com/PaddleHQ/paddle-openapi \c v1/openapi.yaml
    |SHA-256|\c e1ac347eb3c5ff208fdbd6af9c4b3f7e9e4e9212be881468ee4f97792058734b
    |Upstream updated|2026-07-09
    |Imported|2026-08-09

    The committed copy is pruned to the exported operations, the two \c /notification-settings
    operations the webhook event providers call, and everything they reference — 17 of 70 paths and
    244 of 519 component schemas.  That is not only a size reduction: the full 7.4 MB document
    takes around a second to parse, which is not a reasonable cost to pay on every data provider
    construction.

    @section paddledataprovider_actions Actions

    24 actions are exported over 23 operations, in these groups:

    |!Group|!What it covers
    |Customers|customers and the credit balances held against them
    |Prices|the prices a product is sold at
    |Products|the catalog of what is sold
    |Reports|requesting a report and downloading the file
    |Subscriptions|recurring billing relationships
    |Transactions|the records that calculate and capture revenue

    Identifier options are dropdowns wherever the application exports an operation that can list the
    values, so a user picks a customer rather than pasting a \c ctm_ ID.  Every dropdown also accepts a
    value typed or chained in from a previous step, because an identifier usually comes from earlier in
    a workflow and a narrowly scoped key may not be able to list the values at all.

    @section paddledataprovider_conventions Amounts, Timestamps and the Response Envelope

    Three conventions are worth knowing before using these actions:

    - **Amounts are strings in the currency's smallest unit.**  \c "1000" is $10.00 in USD, but ¥1000 in
      JPY, which has no minor unit.  They are strings rather than numbers so that no precision is lost
      in transit.
    - **Timestamps are RFC 3339 strings**, not epoch counts, so they need no conversion — unlike Stripe,
      this application has no timestamp codec anywhere.
    - **Every response is an envelope.**  A listing action returns Paddle's \c {data, meta} envelope
      whole, because \c meta.pagination carries the cursor without which the next page cannot be
      fetched.  A single-entity action returns just the entity: its \c meta holds only a request ID,
      so there is nothing to keep.

    @section paddledataprovider_pagination Paging Through a Listing

    A listing returns at most 200 records.  \c meta.pagination.has_more says whether another page
    exists, and \c meta.pagination.next is the URL of that page, with its \c after cursor already set —
    pass that cursor to the same action's \c after option to continue.

    \c next is returned even on the last page, so paging on its presence never terminates; page on
    \c has_more.

    @section paddledataprovider_events Events

    16 webhook events are reported, covering customers, catalog changes, the subscription lifecycle,
    payment outcomes and report generation.  Subscribing to one registers a notification destination
    with Paddle and deletes it again when the subscription stops.

    These replace the five polling triggers of the application this module supersedes.  Polling a
    listing ordered by creation time cannot see an entity created and removed between two runs, cannot
    see an update at all, and costs a request per interval whether or not anything happened.

    **Every delivery is verified.**  A notification destination is a URL anyone on the internet can post
    to; without verification it would accept a fabricated \c transaction.completed, which is enough to
    make an integration provision a paid plan nobody paid for, or a fabricated
    \c subscription.canceled, enough to cut off a paying customer.  A delivery whose
    \c Paddle-Signature does not verify against the destination's signing secret is dropped, as is one
    old enough to be a replay of a captured delivery.  There is no option that turns this off.

    Two things are worth knowing when handling these events:

    - **Paddle can deliver the same event more than once.**  Record the \c event_id and ignore one
      already processed, so that handling is idempotent.  \c notification_id differs per delivery and is
      what distinguishes a redelivery from the original.
    - **Paddle sends the entity in full, not a diff.**  An update event does not say which field
      changed, so compare against what you hold if that matters.

    @section paddledataprovider_examples Examples

    @subsection paddledataprovider_ex_provider Getting the Data Provider

    From a connection, which is how a Qorus interface reaches it:

    @code{.py}
%requires ConnectionProvider
%requires PaddleDataProvider

AbstractDataProvider paddle = get_connection("paddle-sandbox").getDataProvider();
    @endcode

    Or directly from an API key, for a script:

    @code{.py}
%requires PaddleDataProvider
%requires PaddleRestClient

PaddleDataProvider paddle(new PaddleRestClientIo({
    "token": ENV.PADDLE_API_KEY,
    "instance_type": "sandbox-api",
}));
    @endcode

    @subsection paddledataprovider_ex_list Listing, and Paging Through a Listing

    A listing returns Paddle's envelope, so \c meta.pagination is what drives the loop.  Page on
    \c has_more: \c next is returned even on the last page, so a loop that tests for its presence never
    terminates.

    @code{.py}
AbstractDataProvider list_customers = paddle.getChildProviderEx("list_customers");

*string after;
list<hash<auto>> all = ();
while (True) {
    hash<auto> page = list_customers.doRequest({
        "per_page": 200,
        "status": ("active",),
    } + (after ? {"after": after} : {}));
    all += page.data;
    if (!page.meta.pagination.has_more) {
        break;
    }
    # the cursor for the next page is the "after" argument of the URL Paddle returns
    after = (page.meta.pagination.next =~ x/after=([^&]+)/)[0];
}
printf("%d active customers\n", all.size());
    @endcode

    Set \c skip_count when walking a large collection: it asks Paddle to skip the count query it would
    otherwise run for every page.

    @subsection paddledataprovider_ex_catalog Creating a Product and a Price

    A product carries no price of its own, so selling anything takes both.  \c unit_price.amount is a
    string in the **smallest unit** of its currency.

    @code{.py}
hash<auto> product = paddle.getChildProviderEx("create_product").doRequest({
    "name": "Acme Pro",
    "tax_category": "standard",
    "description": "The professional plan",
    "custom_data": {"internal_sku": "ACME-PRO"},
});

hash<auto> price = paddle.getChildProviderEx("create_price").doRequest({
    "product_id": product.id,
    "description": "Acme Pro monthly",
    # "9900" is $99.00; in JPY the same string would be 9900 yen
    "unit_price": {"amount": "9900", "currency_code": "USD"},
    "billing_cycle": {"interval": "month", "frequency": 1},
});
printf("created price %y for product %y\n", price.id, product.id);
    @endcode

    A catalog object cannot be deleted, only withdrawn from sale:

    @code{.py}
paddle.getChildProviderEx("archive_product").doRequest({"product_id": product.id});
    @endcode

    @subsection paddledataprovider_ex_events Reacting to an Event

    Subscribing registers a notification destination with Paddle and removes it again when the
    subscription stops; every delivery is signature-verified before an observer sees it.

    @code{.py}
class PaymentObserver inherits DataProvider::Observer {
    update(string event_id, hash<auto> data) {
        printf("%s: transaction %y for %s %s\n", event_id, data.data.id,
            data.data.details.totals.total, data.data.currency_code);
    }
}

AbstractDataProvider event = paddle.getChildProviderEx("events")
    .getChildProviderEx("transaction-completed");
event.registerObserver(new PaymentObserver());
cast<DelayedObservable>(event).observersReady();
    @endcode

    @subsection paddledataprovider_ex_call Calling an Endpoint the Manifest Does Not Export

    The application exports a reviewed subset of Paddle's API.  For anything else, the generic API call
    action reaches the rest of it with the same connection and authentication:

    @code{.py}
hash<auto> res = paddle.getChildProviderEx("__call__").doRequest({
    "method": "GET",
    "path": "/event-types",
});
printf("%d event types\n", res.body.data.size());
    @endcode

    @section paddledataproviderrelnotes Release Notes

    @subsection paddledataproviderv1_0 PaddleDataProvider v1.0
    - the initial version of the %PaddleDataProvider module
*/

#! contains all public definitions in the PaddleDataProvider module
public namespace PaddleDataProvider {
}
