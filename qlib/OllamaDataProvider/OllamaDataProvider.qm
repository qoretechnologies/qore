%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) OllamaRestClient
%requires RestClientIo

module OllamaDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Ollama local-first LLM runtimes";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new OllamaDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": OllamaDataProvider::AppName,
            "display_name": "Ollama",
            "short_desc": "Ollama local-first runtime for open-weight LLMs",
            "desc": "Provides access to [Ollama](https://ollama.com) — a local-first runtime "
                "that serves open-weight LLMs (Llama, Qwen, Mistral, DeepSeek, Gemma, Phi) "
                "from your own machine via HTTP.\n\n"
                "Ollama exposes both an OpenAI-compatible API and its own native API.  "
                "Chat and OpenAI-compatible embeddings work through "
                "`/v1/chat/completions` and `/v1/embeddings`; this data provider also "
                "exposes Ollama's native `/api/embed` (richer embedding shape), "
                "`/api/tags` (list installed models), and `/api/pull` (download new models) "
                "endpoints.\n\n"
                "**Common use cases**:\n"
                "- **On-device chat** with full data residency — no data leaves the machine\n"
                "- **RAG embeddings** with local models (`nomic-embed-text`, `mxbai-embed-large`)\n"
                "- **Air-gapped deployments** where cloud APIs are not an option\n"
                "- **Development and testing** without per-token billing",
            "scheme": "ollama",
            "logo": OllamaLogo,
            "logo_file_name": "ollama-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OllamaDataProvider::AppName,
            "path": "/chat-completion",
            "action": "chat-completion",
            "display_name": "Chat Completion",
            "short_desc": "Generate a chat completion from a locally-running Ollama model",
            "desc": "Sends a list of chat messages to a local Ollama model via the "
                "OpenAI-compatible `/v1/chat/completions` endpoint.",
            "action_code": DPAT_API,
            "groups": ("Chat",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OllamaChatCompletionRequestDataType::Fields{"messages", "model",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OllamaChatCompletionRequestDataType::Fields{"temperature", "max_tokens",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OllamaChatCompletionRequestDataType::Fields - (
                    "messages", "model", "temperature", "max_tokens",
                )
            ),
            "output_type": OllamaChatCompletionDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OllamaDataProvider::AppName,
            "path": "/create-embeddings",
            "action": "create-embeddings",
            "display_name": "Create Embeddings",
            "short_desc": "Generate embedding vectors from a local Ollama embedding model",
            "desc": "Converts text inputs into embedding vectors using a local Ollama embedding "
                "model (e.g. `nomic-embed-text`, `mxbai-embed-large`, `snowflake-arctic-embed`) "
                "via Ollama's native `/api/embed` endpoint.",
            "action_code": DPAT_API,
            "groups": ("Embeddings",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OllamaEmbedRequestDataType::Fields{"input", "model",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OllamaEmbedRequestDataType::Fields - ("input", "model")
            ),
            "output_type": OllamaEmbedDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OllamaDataProvider::AppName,
            "path": "/list-models",
            "action": "list-models",
            "display_name": "List Installed Models",
            "short_desc": "List models currently installed on the Ollama runtime",
            "desc": "Returns the list of models installed in the local Ollama runtime, with "
                "size, family, parameter count, and modification timestamps.",
            "action_code": DPAT_API,
            "groups": ("Admin",),
            "options": {},
            "output_type": OllamaListModelsDataProvider::ResponseType,
        });
    };
}

/** @mainpage OllamaDataProvider Module

    @tableofcontents

    @section ollamadataproviderintro OllamaDataProvider Introduction

    The %OllamaDataProvider module provides a data provider API for
    [Ollama](https://ollama.com) — a local-first runtime that serves
    open-weight LLMs via HTTP.

    The following data providers are exposed:
    - @ref OllamaDataProvider::OllamaDataProvider "OllamaDataProvider" — root
    - @ref OllamaDataProvider::OllamaChatCompletionDataProvider "OllamaChatCompletionDataProvider" — chat
    - @ref OllamaDataProvider::OllamaEmbedDataProvider "OllamaEmbedDataProvider" — embeddings via native `/api/embed`
    - @ref OllamaDataProvider::OllamaListModelsDataProvider "OllamaListModelsDataProvider" — `/api/tags`

    @section OllamaDataProviderRelnotes Release Notes

    @subsection OllamaDataProviderv1_0 OllamaDataProvider v1.0
    - the initial version of the %OllamaDataProvider module
*/

#! contains all public definitions in the OllamaDataProvider module
public namespace OllamaDataProvider {
#! Ollama application name
public const AppName = "Ollama";
}

#! App logo loaded from file
public const OllamaLogo = File::readTextFile(get_script_dir() + "/ollama-logo.svg");
