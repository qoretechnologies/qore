%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) BflRestClient
%requires RestClientIo

module BflDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Black Forest Labs (FLUX)";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new BflDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": BflDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Black Forest Labs",
            "short_desc": "Black Forest Labs FLUX text-to-image generation",
            "desc": "Provides access to [Black Forest Labs](https://bfl.ai) — "
                "the company behind the FLUX image generation models.\n\n"
                "**Image models** (selectable via the `model` action option):\n"
                "- `flux-pro-1.1` (default) — production text-to-image\n"
                "- `flux-pro-1.1-ultra` — highest quality, 4MP output\n"
                "- `flux-pro` — original FLUX Pro\n"
                "- `flux-dev` — faster + cheaper development model\n"
                "- `flux-kontext-pro` / `flux-kontext-max` — image-to-image "
                "edit (needs an `input_image`)\n\n"
                "**Video generation** is exposed only via the "
                "@ref qoremediautilsintro \"QoreMediaUtils\" "
                "`bfl` video-generator backend or the "
                "@ref bflrestclientintro \"BflRestClient\" `submitAndWait()` "
                "method directly — not as an action in this data provider.",
            "scheme": "bfl",
            "logo": BflLogo,
            "logo_file_name": "bfl-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (
                DataProvider::AppGroup::AiLlm,
                DataProvider::AppGroup::DesignCreative,
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BflDataProvider::AppName,
            "path": "/generate-image",
            "action": "generate-image",
            "display_name": "Generate Image",
            "short_desc": "Generate an image from a text prompt (async)",
            "desc": "Generates an image from a text prompt via the BFL FLUX "
                "API.  BFL is asynchronous: submit returns a `polling_url`, "
                "and this action drives the polling loop via "
                "@ref qoreasyncjobutilsintro \"QoreAsyncJobUtils\" until the "
                "job reaches the `Ready` terminal state.\n\n"
                "The response contains `result.sample` — a CDN URL of the "
                "generated image.  Download the image promptly; BFL CDN URLs "
                "are temporary.",
            "action_code": DPAT_API,
            "groups": ("Image Generation",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BflGenerateImageRequestDataType::Fields{"prompt",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BflGenerateImageRequestDataType::Fields{
                    "model", "aspect_ratio",
                }, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                BflGenerateImageRequestDataType::Fields - (
                    "prompt", "model", "aspect_ratio",
                )
            ),
            "output_type": BflGenerateImageDataProvider::ResponseType,
        });
    };
}

/** @mainpage BflDataProvider Module

    @tableofcontents

    @section bfldataproviderintro BflDataProvider Introduction

    The %BflDataProvider module provides a data provider API for
    [Black Forest Labs](https://bfl.ai) — the company behind FLUX image
    and video models.

    A single DPAT_API action is registered:
    - `generate-image` — submit a text prompt + model + size, wait for
      the async job to complete, and receive a result hash with the
      generated image URL

    Video generation is available via the
    @ref bflrestclientintro "BflRestClient" module's
    `BflVideoGenerator` (registered with @ref qoremediautilsintro
    "QoreMediaUtils") — exposed as a `bfl` video-generator backend
    in `MediaProviderRegistry`.

    @section BflDataProviderRelnotes Release Notes

    @subsection BflDataProviderv1_0 BflDataProvider v1.0
    - the initial version of the %BflDataProvider module
*/

#! contains all public definitions in the BflDataProvider module
public namespace BflDataProvider {
#! Black Forest Labs application name
public const AppName = "BlackForestLabs";
}

#! App logo loaded from file
public const BflLogo = File::readTextFile(get_script_dir() + "/bfl-logo.svg");
