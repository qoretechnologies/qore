# minimum qore version
%requires qore >= 1.10

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module AwsRestClient {
    version = "1.3";
    desc = "user module for calling AWS REST services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("awsrests", AwsRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("s3", AwsS3RestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("s3compatible", AwsS3CompatibleRestConnection::ConnectionScheme);
    };
}

/** @mainpage AwsRestClient Module

    @tableofcontents

    @section awsrestclientintro AwsRestClient Introduction

    The %AwsRestClient module provides an API for calling AWS REST services.

    To use this module, use \c "%requires AwsRestClient" in your code.

    All the public symbols in the module are defined in the AwsRestClient namespace.

    The main classes are:
    - @ref AwsRestClient::AwsRestClient "AwsRestClient": this class provides the REST client API for communuication
      with the AWS REST API; it also automates authentication and authorization
    - @ref AwsRestClient::AwsRestConnection "AwsRestConnection": provides a REST connection object to a the AWS server
      (based on the @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires AwsRestClient

hash<auto> opts = {
    "url": "https://iam.amazonaws.com",
    "aws_keyid": ENV.AWS_KEY_ID,
    "aws_secret": ENV.AWS_SECRET,
    "aws_region": "eu-central-1",
    "aws_service": "iotevents",
};

AwsRestClient rest(opts);
hash<auto> ans = rest.get(...);
printf("%Y\n", ans.body);
    @endcode

    @section Awsrestclientrelnotes Release Notes

    @subsection awsrestclientv1_3 AwsRestClient v1.3
    - added @ref AwsRestClient::AwsS3RestConnection "AwsS3RestConnection" for Amazon S3, which needs no URL -
      the endpoint is derived from the region - and offers the AWS regions as a list
      (<a href="https://github.com/qoretechnologies/qore/issues/5386">issue 5386</a>)
    - added @ref AwsRestClient::AwsS3CompatibleRestConnection "AwsS3CompatibleRestConnection" for S3-compatible
      storage that is not Amazon, such as MinIO and Ceph, which is reached at a URL of its own
      (<a href="https://github.com/qoretechnologies/qore/issues/5386">issue 5386</a>)
    - bounded the IMDS credential probe with its own timeout (\c aws_imds_timeout, default
      @ref AwsRestClient::AwsRestClientBase::ImdsTimeoutMs "ImdsTimeoutMs"); off AWS the
      link-local metadata address is routed rather than rejected on some platforms, so the probe
      previously blocked for the full 60-second HTTP connect timeout whenever
      @ref AwsRestClient::AwsRestClientBase::isEc2Compute() "isEc2Compute()" could not answer
    - added \c prepareAsyncSend() override for AWS Signature V4 signing in async REST requests

    @subsection awsrestclientv2_0 AwsRestClient v1.2
    - added support for the DataProvider API
      (<a href="https://github.com/qoretechnologies/qore/issues/4564">issue 4564</a>)

    @subsection awsrestclientv1_1 AwsRestClient v1.1
    - implemented support for a data provider scheme cache and rich option information for connections
      (<a href="https://github.com/qoretechnologies/qore/issues/4025">issue 4025</a>)

    @subsection awsrestclientv1_0 AwsRestClient v1.0
    - the initial version of the %AwsRestClient module
*/

#! the AwsRestClient namespace contains all the objects in the AwsRestClient module
public namespace AwsRestClient {
#! Common base class for AwsRestClient functionality
public class AwsRestClientBase {
    public {
        #! required options
        const RequiredOptions = (
            "aws_keyid",
            "aws_secret",
            "aws_region",
            "aws_service",
        );

        #! full set of AWS-specific options consumed by @ref AwsRestClientBase subclasses
        /** Used to strip AWS-specific keys before forwarding option hashes to a REST client
            base class that does not accept them.
        */
        const AwsOptions = {
            "aws_keyid": True,
            "aws_secret": True,
            "aws_region": True,
            "aws_service": True,
            "aws_s3": True,
            "aws_token": True,
            # credential-provider extensions (env vars / IMDS / STS AssumeRole)
            "aws_role_arn": True,
            "aws_role_session_name": True,
            "aws_external_id": True,
            "aws_imds_disabled": True,
            "aws_imds_url": True,
            "aws_imds_timeout": True,
        };

        #! Standard AWS environment-variable names recognized by the credential chain
        /** Mirrors the AWS CLI / SDK convention so existing user environments
            and CI runners work without code changes.  Used by
            @ref applyEnvCredentials() before the existing
            @ref RequiredOptions check fires.
        */
        const AwsEnvVarMap = {
            "aws_keyid":  "AWS_ACCESS_KEY_ID",
            "aws_secret": "AWS_SECRET_ACCESS_KEY",
            "aws_token":  "AWS_SESSION_TOKEN",
            "aws_region": "AWS_REGION",
        };

        #! Qore digest algorithm to use for HMAC calculations; must match AwsSignatureAlgorithm
        const QoreDigest = CRYPTO_DIGEST_SHA256;

        #! AWS signature algorithm used; must match QoreDigest
        const AwsSignatureAlgorithm = "AWS4-HMAC-SHA256";

        #! Fixed termination string
        const AwsTermination = "aws4_request";
    }

    static private string trimall(string str) {
        # remove leading and trailing whitespace
        trim str;
        # collapse multiple spaces to a single space
        str =~ s/ +/ /g;
        return str;
    }

    #! Fills in AWS credential/region keys from environment variables where unset
    /** Reads \c AWS_ACCESS_KEY_ID, \c AWS_SECRET_ACCESS_KEY,
        \c AWS_SESSION_TOKEN, \c AWS_REGION, and \c AWS_DEFAULT_REGION
        (fallback for \c aws_region) — the standard AWS SDK / CLI convention.
        Values explicitly passed in \a opts always win over the environment.

        @return \a opts with any missing AWS credential keys filled in from
        the environment
    */
    static hash<auto> applyEnvCredentials(hash<auto> opts) {
        # Read via getenv() rather than the ENV hash: ENV is a snapshot
        # captured at module load, while getenv() always queries the live
        # process environment so callers that bridge env state at runtime
        # (tests, frameworks) see their updates here.
        foreach hash<auto> i in (AwsEnvVarMap.pairIterator()) {
            string opt_key = i.key;
            string env_key = i.value;
            if (!opts{opt_key}) {
                *string v = getenv(env_key);
                if (v.val()) {
                    opts{opt_key} = v;
                }
            }
        }
        # AWS_DEFAULT_REGION is the older variant, kept for compatibility
        if (!opts.aws_region) {
            *string v = getenv("AWS_DEFAULT_REGION");
            if (v.val()) {
                opts.aws_region = v;
            }
        }
        return opts;
    }

    #! Performs an AWS STS AssumeRole call and returns temporary credentials
    /** Builds a one-shot @ref AwsRestClient bound to the STS service with
        the supplied base credentials, posts the AssumeRole action, parses
        the XML response, and returns the temporary credentials in a hash.
        Auto-refresh is the caller's responsibility — credentials carry an
        \c expires date so callers can re-call when within a safety window.

        @param opts hash containing:
        - \c aws_keyid (required): base access key ID
        - \c aws_secret (required): base secret access key
        - \c aws_token (optional): session token if the base creds are
          themselves temporary
        - \c aws_role_arn (required): ARN of the role to assume
        - \c aws_role_session_name (optional): RoleSessionName (default
          \c "qore-sdk-session")
        - \c aws_external_id (optional): external ID for cross-account assume
        - \c aws_sts_region (optional): STS region (default \c "us-east-1")
        - \c aws_sts_endpoint (optional): STS endpoint override (default
          <tt>https://sts.{region}.amazonaws.com</tt>; useful for testing
          against a fake endpoint)
        - \c aws_duration_seconds (optional): session lifetime, 900–43200
          (default per AWS — 3600)

        @return hash with keys:
        - \c aws_keyid, \c aws_secret, \c aws_token: the temporary credentials
        - \c expires: absolute date when the credentials expire

        @throw AWSRESTCLIENT-STS-ERROR the AssumeRole call failed or the
        response could not be parsed
    */
    static hash<auto> assumeRole(hash<auto> opts) {
        foreach string field in (("aws_keyid", "aws_secret", "aws_role_arn")) {
            if (!opts{field}.val()) {
                throw "AWSRESTCLIENT-STS-ERROR",
                    sprintf("assumeRole requires %y in opts", field);
            }
        }
        string region = opts.aws_sts_region ?? "us-east-1";
        string url = opts.aws_sts_endpoint
            ?? sprintf("https://sts.%s.amazonaws.com", region);
        string session_name = opts.aws_role_session_name ?? "qore-sdk-session";
        int duration = opts.aws_duration_seconds ?? 3600;

        # Build the STS Query API parameters as a hash so RestClient's
        # built-in "url" data mode form-encodes them on the wire.
        hash<auto> form = {
            "Action": "AssumeRole",
            "Version": "2011-06-15",
            "RoleArn": opts.aws_role_arn,
            "RoleSessionName": session_name,
            "DurationSeconds": duration,
        };
        if (opts.aws_external_id.val()) {
            form.ExternalId = opts.aws_external_id;
        }

        # Use a one-shot AwsRestClient bound to the STS service; explicitly
        # drop aws_role_arn so we don't recurse into another AssumeRole call.
        hash<auto> sts_opts = {
            "url": url,
            "aws_keyid": opts.aws_keyid,
            "aws_secret": opts.aws_secret,
            "aws_region": region,
            "aws_service": "sts",
        };
        if (opts.aws_token.val()) {
            sts_opts.aws_token = opts.aws_token;
        }
        AwsRestClient sts(sts_opts, True);
        hash<auto> resp;
        try {
            # switch serialization to "url" so RestClient form-encodes the
            # hash body for the STS Query API (AwsRestClient hardcodes
            # data="json" on its parent at construction; we restore on exit)
            string saved_ds = sts.getSerialization();
            on_exit sts.setSerialization(saved_ds);
            sts.setSerialization("url");
            resp = sts.post("/", form);
        } catch (hash<ExceptionInfo> ex) {
            throw "AWSRESTCLIENT-STS-ERROR",
                sprintf("AssumeRole call to %y failed: %s", url, ex.desc), ex;
        }
        return AwsRestClientBase::parseAssumeRoleResponse(resp.body);
    }

    #! Parses an STS AssumeRole response body
    /** Accepts either a string/binary XML body (e.g. captured from a test
        fixture) or a hash already deserialized by RestClient's XML parser
        when the response Content-Type is \c text/xml.  No external XML
        module dependency is required.

        @param raw the response body (hash, binary, or string)

        @return hash with \c aws_keyid, \c aws_secret, \c aws_token, \c expires
    */
    static hash<auto> parseAssumeRoleResponse(auto raw) {
        *hash<auto> creds_hash;
        if (raw.typeCode() == NT_HASH) {
            creds_hash = raw.AssumeRoleResponse.AssumeRoleResult.Credentials;
        } else {
            string body;
            if (raw.typeCode() == NT_BINARY) {
                body = raw.toString("UTF-8");
            } else if (raw.typeCode() == NT_STRING) {
                body = raw;
            } else {
                throw "AWSRESTCLIENT-STS-ERROR",
                    sprintf("AssumeRole response body has unexpected type %s",
                        raw.type());
            }
            *string key = (body =~ x/<AccessKeyId>([^<]+)<\/AccessKeyId>/)[0];
            *string secret = (body =~ x/<SecretAccessKey>([^<]+)<\/SecretAccessKey>/)[0];
            *string token = (body =~ x/<SessionToken>([^<]+)<\/SessionToken>/)[0];
            *string expires_str = (body =~ x/<Expiration>([^<]+)<\/Expiration>/)[0];
            creds_hash = {
                "AccessKeyId": key,
                "SecretAccessKey": secret,
                "SessionToken": token,
                "Expiration": expires_str,
            };
        }
        if (!creds_hash.AccessKeyId.val() || !creds_hash.SecretAccessKey.val()) {
            throw "AWSRESTCLIENT-STS-ERROR",
                sprintf("AssumeRole response missing required fields: %y",
                    creds_hash);
        }
        date expires = creds_hash.Expiration.val()
            ? date(creds_hash.Expiration)
            : now_us() + 1h;
        hash<auto> rv = {
            "aws_keyid": creds_hash.AccessKeyId,
            "aws_secret": creds_hash.SecretAccessKey,
            "expires": expires,
        };
        if (creds_hash.SessionToken.val()) {
            rv.aws_token = creds_hash.SessionToken;
        }
        return rv;
    }

    #! If \a opts requests STS AssumeRole, performs it and overlays the temp credentials
    /** Honored when \c aws_role_arn is present in \a opts.  The original
        base credentials are replaced with the temporary ones returned by
        STS.  Refresh-on-expiry is a follow-up; v1 is a one-shot at
        construction time so the client must be recreated when the
        temporary session expires (default 1h).
    */
    static hash<auto> applyAssumeRole(hash<auto> opts) {
        if (!opts.aws_role_arn.val()) {
            return opts;
        }
        hash<auto> creds = AwsRestClientBase::assumeRole(opts);
        opts.aws_keyid = creds.aws_keyid;
        opts.aws_secret = creds.aws_secret;
        if (creds.aws_token.val()) {
            opts.aws_token = creds.aws_token;
        }
        # leave aws_role_arn / aws_role_session_name / aws_external_id in
        # the option hash for diagnostic purposes; AwsOptions strips them
        # from any subset forwarded to the RestClient base
        return opts;
    }

    #! Default IMDS v2 endpoint (EC2 link-local)
    const ImdsV2Endpoint = "http://169.254.169.254";

    #! ECS task-role credentials endpoint (used when AWS_CONTAINER_CREDENTIALS_RELATIVE_URI is set)
    const EcsCredentialsEndpoint = "http://169.254.170.2";

    #! IMDS v2 session-token TTL in seconds (6 hours, the documented maximum)
    const ImdsTokenTtlSeconds = 21600;

    #! Connect and response timeout in milliseconds for IMDS requests
    /** IMDS is a link-local service answered in under a millisecond by the hypervisor when it
        exists at all, so a short timeout costs nothing on a real instance.  It matters off AWS,
        where 169.254.169.254 is normally routed like any other address: the SYN goes unanswered
        rather than being rejected, and the probe blocks for the full
        \c HTTPCLIENT_DEFAULT_CONNECT_TIMEOUT (60 seconds) instead of failing fast.

        @ref isEc2Compute() suppresses the doomed probe wherever it can answer, but it reads Linux
        sysfs and returns @ref NOTHING elsewhere, which callers must treat as "maybe" - a macOS
        host is not necessarily off AWS, since EC2 Mac instances run macOS and do serve IMDS.  This
        timeout is what bounds the cost of that unavoidable "maybe".

        The AWS SDKs use one second for the same reason.  Override with \c aws_imds_timeout.
    */
    const ImdsTimeoutMs = 1000;

    #! Returns credentials from the EC2/EKS Instance Metadata Service v2
    /** Implements the IMDSv2 token-protected flow:
        - PUT \c /latest/api/token (with \c X-aws-ec2-metadata-token-ttl-seconds)
          → returns a session token in the response body
        - GET \c /latest/meta-data/iam/security-credentials/ with the session
          token header → returns the role name
        - GET \c /latest/meta-data/iam/security-credentials/{role} with the
          session token header → returns the JSON-shaped credentials hash

        @param opts optional overrides:
        - \c aws_imds_url (\c string): override the default
          @ref ImdsV2Endpoint (useful for tests with a fake IMDS server)
        - \c aws_imds_token_ttl_seconds (\c int): override
          @ref ImdsTokenTtlSeconds
        - \c aws_imds_timeout (\c int): connect and response timeout in
          milliseconds; overrides @ref ImdsTimeoutMs

        @return hash with \c aws_keyid, \c aws_secret, \c aws_token, \c expires

        @throw AWSRESTCLIENT-IMDS-ERROR IMDS unreachable or returned an error
    */
    static hash<auto> getImdsCredentials(*hash<auto> opts) {
        string endpoint = opts.aws_imds_url ?? ImdsV2Endpoint;
        int ttl = opts.aws_imds_token_ttl_seconds ?? ImdsTokenTtlSeconds;
        int timeout_ms = opts.aws_imds_timeout ?? ImdsTimeoutMs;

        # IMDS speaks plain HTTP with no special framing; a plain
        # RestClientIo with data="text" is sufficient.  Both timeouts are set
        # explicitly: the default 60s would otherwise be spent in full on every
        # host where the link-local address is routed rather than rejected.
        RestClientIo::RestClientIo imds({
            "url": endpoint,
            "data": "text",
            "connect_timeout": timeout_ms,
            "timeout": timeout_ms,
        });

        # Step 1: obtain a session token via IMDSv2 PUT
        hash<auto> token_resp;
        try {
            token_resp = imds.restDoRequest("PUT", "/latest/api/token", "",
                {"X-aws-ec2-metadata-token-ttl-seconds": ttl.toString()});
        } catch (hash<ExceptionInfo> ex) {
            throw "AWSRESTCLIENT-IMDS-ERROR",
                sprintf("IMDSv2 token request to %y failed: %s",
                    endpoint, ex.desc), ex;
        }
        string token = AwsRestClientBase::extractTextBody(token_resp.body,
            "IMDSv2 token response");
        if (!token.val()) {
            throw "AWSRESTCLIENT-IMDS-ERROR",
                sprintf("IMDSv2 token response from %y was empty", endpoint);
        }

        # Step 2: list available roles (returns one role per line as text)
        hash<auto> roles_resp;
        try {
            roles_resp = imds.restGet("/latest/meta-data/iam/security-credentials/",
                {"X-aws-ec2-metadata-token": token});
        } catch (hash<ExceptionInfo> ex) {
            throw "AWSRESTCLIENT-IMDS-ERROR",
                sprintf("IMDS role-list request failed: %s", ex.desc), ex;
        }
        string roles_body = AwsRestClientBase::extractTextBody(roles_resp.body,
            "IMDS role-list response");
        list<string> role_lines = roles_body.split("\n");
        # filter empty lines
        list<string> roles = ();
        foreach string r in (role_lines) {
            trim r;
            if (r.val()) {
                push roles, r;
            }
        }
        if (!roles) {
            throw "AWSRESTCLIENT-IMDS-ERROR",
                sprintf("IMDS reports no instance roles at %y; instance has "
                    "no attached IAM role", endpoint);
        }
        string role = roles[0];

        # Step 3: fetch the credentials JSON for the role
        hash<auto> creds_resp;
        try {
            creds_resp = imds.restGet(
                "/latest/meta-data/iam/security-credentials/"
                    + encode_url(role, True),
                {"X-aws-ec2-metadata-token": token});
        } catch (hash<ExceptionInfo> ex) {
            throw "AWSRESTCLIENT-IMDS-ERROR",
                sprintf("IMDS credentials request for role %y failed: %s",
                    role, ex.desc), ex;
        }
        return AwsRestClientBase::parseImdsCredentialsBody(creds_resp.body);
    }

    #! Returns credentials from the ECS task-role endpoint
    /** ECS/EKS-on-Fargate exposes task-role credentials via a different
        link-local address (no token required, the relative URI itself is
        the credential).  Triggered when the
        \c AWS_CONTAINER_CREDENTIALS_RELATIVE_URI env var is set.

        @return hash with \c aws_keyid, \c aws_secret, \c aws_token, \c expires
        @throw AWSRESTCLIENT-IMDS-ERROR endpoint unreachable or response unparseable
    */
    static hash<auto> getEcsCredentials() {
        *string rel = getenv("AWS_CONTAINER_CREDENTIALS_RELATIVE_URI");
        *string full = getenv("AWS_CONTAINER_CREDENTIALS_FULL_URI");
        string url;
        if (full.val()) {
            url = full;
        } else if (rel.val()) {
            url = EcsCredentialsEndpoint + (rel =~ /^\// ? rel : "/" + rel);
        } else {
            throw "AWSRESTCLIENT-IMDS-ERROR",
                "neither AWS_CONTAINER_CREDENTIALS_RELATIVE_URI nor "
                "AWS_CONTAINER_CREDENTIALS_FULL_URI is set; ECS task-role "
                "credentials are unavailable in this environment";
        }
        hash<UrlInfo> url_info = parse_url(url);
        string base = sprintf("%s://%s", url_info.protocol ?? "http",
            url_info.host + (url_info.port ? ":" + url_info.port : ""));
        string path = url_info.path ?? "/";
        RestClientIo::RestClientIo client({"url": base, "data": "text"});
        hash<auto> resp;
        try {
            resp = client.restGet(path);
        } catch (hash<ExceptionInfo> ex) {
            throw "AWSRESTCLIENT-IMDS-ERROR",
                sprintf("ECS credentials request to %y failed: %s",
                    url, ex.desc), ex;
        }
        return AwsRestClientBase::parseImdsCredentialsBody(resp.body);
    }

    #! Parses the JSON credentials body returned by IMDSv2 or the ECS endpoint
    /** RestClient may auto-deserialize the response into a hash when the
        Content-Type is \c application/json; otherwise the caller passes a
        binary or string and we parse it.

        @return hash with \c aws_keyid, \c aws_secret, \c aws_token, \c expires
    */
    static hash<auto> parseImdsCredentialsBody(auto raw) {
        hash<auto> data;
        if (raw.typeCode() == NT_HASH) {
            data = raw;
        } else {
            # RestClient auto-deserializes application/json responses to a
            # hash; if we get here the IMDS endpoint sent us back something
            # else, which is a real protocol error
            throw "AWSRESTCLIENT-IMDS-ERROR",
                sprintf("IMDS credentials body has unexpected type %s; "
                    "expected RestClient-deserialized hash (Content-Type "
                    "application/json)", raw.type());
        }
        *string key = data.AccessKeyId;
        *string secret = data.SecretAccessKey;
        *string token = data.Token;
        if (!key.val() || !secret.val()) {
            throw "AWSRESTCLIENT-IMDS-ERROR",
                sprintf("IMDS credentials response missing required fields: %y",
                    data);
        }
        date expires = data.Expiration.val()
            ? date(data.Expiration)
            : now_us() + 1h;
        hash<auto> rv = {
            "aws_keyid": key,
            "aws_secret": secret,
            "expires": expires,
        };
        if (token.val()) {
            rv.aws_token = token;
        }
        return rv;
    }

    #! Reads a small local file, returning @ref NOTHING instead of throwing on any error
    /** Used for the sysfs/DMI probes in @ref isEc2Compute(); missing files,
        permission errors, and FILESYSTEM-domain sandboxing violations are all
        treated the same way: inconclusive.
    */
    private:internal static *string tryReadLocalFile(string path) {
        try {
            string data = ReadOnlyFile::readTextFile(path, NOTHING, 4096);
            trim data;
            if (data.val()) {
                return data;
            }
        } catch () {
        }
    }

    #! Cheaply and locally determines whether this process is running on real AWS EC2 compute
    /** Reads local DMI/sysfs data only; no network round-trip is made, so this
        is safe to call before deciding whether an IMDS probe (which, off AWS,
        typically stalls for a full \c connect_timeout instead of failing
        fast; see @ref applyInstanceCredentials()) is worth attempting.

        Uses the methods documented by AWS itself
        (<a href="https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/identify_ec2_instances.html">Detect
        whether a host is an EC2 instance</a>):
        - instances built on the Nitro system (all current instance families)
          expose their own instance ID via \c /sys/devices/virtual/dmi/id/board_asset_tag
        - legacy Xen-based (PV) instance families instead expose a UUID
          starting with \c "ec2" via \c /sys/hypervisor/uuid

        Both files are plain world-readable sysfs entries (no \c dmidecode /
        root privilege needed) present on essentially every Linux host,
        virtualized or not, which is what makes a negative result trustworthy.

        @return @ref True if EC2 hardware is positively detected; @ref False
        if the \c board_asset_tag probe is readable and does \b not match an
        EC2 instance ID (positive evidence this is not EC2 hardware); or
        @ref NOTHING if neither probe is available (non-Linux, no DMI data,
        FILESYSTEM domain restricted, etc.) -- callers should treat
        @ref NOTHING the same as @ref True, to avoid a false negative
        disabling credential auto-discovery on a real instance
    */
    static *bool isEc2Compute() {
        *string asset_tag = AwsRestClientBase::tryReadLocalFile(
            "/sys/devices/virtual/dmi/id/board_asset_tag");
        if (asset_tag.val()) {
            return asset_tag =~ /^i-[0-9a-f]+$/;
        }
        *string hv_uuid = AwsRestClientBase::tryReadLocalFile("/sys/hypervisor/uuid");
        if (hv_uuid.val()) {
            return hv_uuid.lwr() =~ /^ec2/;
        }
    }

    #! If \a opts has no static credentials, tries ECS then IMDS to fill them in
    /** Triggered after @ref applyEnvCredentials() but before the
        RequiredOptions check.  Honored only when:
        - \c aws_keyid is still missing, AND
        - \c aws_imds_disabled is not @ref True

        Tries the ECS task-role endpoint first (when the
        \c AWS_CONTAINER_CREDENTIALS_RELATIVE_URI / \c _FULL_URI env var is
        set), then falls through to IMDSv2.  Failures are non-fatal: when
        both providers fail the function returns \a opts unchanged so the
        existing RequiredOptions check produces the canonical error.

        Before probing the \b default IMDS endpoint (no \c aws_imds_url
        override given), @ref isEc2Compute() is consulted: off AWS, \c
        169.254.169.254 is normally routed like any other address rather than
        rejected, so a doomed probe burns a full \c connect_timeout instead of
        failing fast. An explicit \c aws_imds_url override is always honored
        regardless (e.g. tests pointing at a fake IMDS server).
    */
    static hash<auto> applyInstanceCredentials(hash<auto> opts) {
        if (opts.aws_keyid.val()) {
            return opts;
        }
        if (opts.aws_imds_disabled) {
            return opts;
        }
        # ECS first: it only takes one HTTP round trip and is the common path
        # in Fargate / EKS-on-Fargate / App Runner.
        if (getenv("AWS_CONTAINER_CREDENTIALS_RELATIVE_URI").val()
                || getenv("AWS_CONTAINER_CREDENTIALS_FULL_URI").val()) {
            try {
                hash<auto> creds = AwsRestClientBase::getEcsCredentials();
                opts.aws_keyid = creds.aws_keyid;
                opts.aws_secret = creds.aws_secret;
                if (creds.aws_token.val()) {
                    opts.aws_token = creds.aws_token;
                }
                return opts;
            } catch () {
                # fall through to IMDS
            }
        }
        if (!opts.aws_imds_url.val()) {
            *bool ec2 = AwsRestClientBase::isEc2Compute();
            if (exists ec2 && !ec2) {
                return opts;
            }
        }
        try {
            hash<auto> creds = AwsRestClientBase::getImdsCredentials(opts);
            opts.aws_keyid = creds.aws_keyid;
            opts.aws_secret = creds.aws_secret;
            if (creds.aws_token.val()) {
                opts.aws_token = creds.aws_token;
            }
        } catch () {
            # IMDS unreachable — common off-AWS; leave opts unchanged so
            # the canonical "missing required option" error fires
        }
        return opts;
    }

    #! Extracts a text body from a RestClient response (hash, binary, or string)
    private:internal static string extractTextBody(auto raw, string ctx) {
        if (raw.typeCode() == NT_STRING) {
            return raw;
        }
        if (raw.typeCode() == NT_BINARY) {
            return raw.toString("UTF-8");
        }
        if (raw.typeCode() == NT_NOTHING) {
            return "";
        }
        throw "AWSRESTCLIENT-IMDS-ERROR",
            sprintf("%s has unexpected type %s", ctx, raw.type());
    }
}

#! this class provides the REST client API for communication with AWS
/** This class requires the following options:
    - \c aws_keyid
    - \c aws_secret
    - \c aws_region
    - \c aws_service
*/
public class AwsRestClient inherits RestClient::RestClient, AwsRestClientBase {
    private:internal {
        # the AWS access key ID
        string aws_keyid;
        # the AWS secret access key
        string aws_secret;
        # the AWS region
        string aws_region;
        # the AWS service
        string aws_service;
        # is this request for AWS S3?
        bool aws_s3 = False;
        # temporary session token
        string aws_token;
        # credential scope suffix
        string credential_scope_suffix;
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
AwsRestClient rest({
"url": "https://apigateway.eu-central-1.amazonaws.com",
"aws_keyid": aws_keyid,
"aws_secret": aws_secret.
});
        @endcode

        @param opts valid options are:
        - \c additional_methods: Optional hash with more but not-HTTP-standardized methods to handle. It allows
            HTTP extensions like e.g. WebDAV to work. The hash takes the method name as a key, and the value is a
            boolean @ref True "True" or @ref False "False": indicating if the method requires a message
            body as well. Example:
            @code{.py}
# add new HTTP methods for WebDAV. Both of them require body posting to the server
{"additional_methods": {"PROPFIND": True, "MKCOL": True}};
            @endcode
        - \c aws_keyid: (required) the AWS key ID
        - \c aws_region: the AWS region to use (ex: \c "us-east-1"); if it cannot be derived from the URL then it
            is a required option
        - \c was_service: the AWS service to use (ex: \c "iam"); if it cannot be derived from the URL then it is a
            required option
        - \c aws_secret: (required) the AWS secret access key value
        - \c aws_token: a temporary session token from AWS Security Token Service for this HTTP session
        - \c content_encoding: for possible values, see @ref EncodingSupport; this sets the send encoding (if the
            \c "send_encoding" option is not set) and the requested response encoding (note that the
            @ref RestClient::RestClient "RestClient" class will only compress outgoing message bodies over
            \c CompressionThreshold bytes in size)
        - \c default_path: The default path to use for new connections if a path is not otherwise specified in the
            connection URL
        - \c default_port: The default port number to connect to if none is given in the URL
        - \c error_passthru: if @ref True "True" then HTTP status codes indicating errors will not cause a
            \c REST-RESPONSE-ERROR exception to be raised, rather such responses will be passed through to the caller
            like any other response
        - \c headers: an optional hash of headers to send with every request, these can also be overridden in
            request method calls
        - \c http_version: Either '1.0' or '1.1' (default) for the claimed HTTP protocol version compliancy in
            outgoing message headers
        - \c max_redirects: The maximum number of redirects before throwing an exception (the default is 5)
        - \c proxy: The proxy URL for connecting through a proxy
        - \c redirect_passthru: if @ref True "True" then redirect responses will be passed to the caller
            instead of processed
        - \c aws_s3: set to True to flag this object for use with AWS aws_s3, which requires special message encoding
        - \c send_encoding: a @ref EncodingSupport "send data encoding option" or the value \c "auto" which means
            to use automatic encoding; if not present defaults to \c "gzip" content encoding on sent message bodies
            (note that the @ref RestClient::RestClient "RestClient" class will only compress outgoing message bodies
            over \c CompressionThreshold bytes in size)
        - \c swagger: the path to a <a href="https://swagger.io/">Swagger 2.0</a> REST schema file for API
            validation; only used if \a validator not provided (see the \c Swagger module)
        - \c timeout: The timeout value in milliseconds (also can be a relative date-time value for clarity, ex:
            \c 30s)
        - \c url: a string giving the URL to connect to; if not given then the target URL will be taken from any
            \c validator option, if given by calling
            @ref RestSchemaValidator::AbstractRestSchemaValidator::getTargetUrl() "AbstractRestSchemaValidator::getTargetUrl()"
        - \c validator: an @ref RestSchemaValidator::AbstractRestSchemaValidator "AbstractRestSchemaValidator"
            object to validate request and response messages; overrides \a swagger
        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw AWSRESTCLIENT-ERROR missing or invalid required option for AWS REST authentication or communication

        @note the \c data option is always set to \c "json"
    */
    constructor(hash<auto> opts, *softbool do_not_connect) : RestClient(opts + {"data": "json"}, do_not_connect) {
        # AWS does not support basic authentication
        hash<UrlInfo> url_info = parse_url(opts.url);
        if (url_info{"username", "password"}) {
            throw "AWSRESTCLIENT-ERROR", sprintf("AWS URL must not contain a username or password; URL: %y",
                get_safe_url(opts.url));
        }

        # set the region automatically from the URL if not provided in an option
        *list<string> url_components = (url_info.host =~ x/([^\.]+)/g);
        if (url_components.size() != 4 || url_components[2] != "amazonaws" || url_components[3] != "com") {
            url_components = ();
        }
        if (!opts.aws_service && url_components) {
            opts.aws_service = url_components[0];
        }
        if (!opts.aws_region && url_components) {
            opts.aws_region = url_components[1];
        }

        # fill missing credential/region keys from standard AWS environment variables
        opts = AwsRestClientBase::applyEnvCredentials(opts);
        # if no static credentials are available, try ECS task-role and
        # IMDSv2 in that order (no-op when aws_imds_disabled is True)
        opts = AwsRestClientBase::applyInstanceCredentials(opts);
        # if aws_role_arn is set, perform a one-shot STS AssumeRole and
        # overlay the temporary credentials onto opts
        opts = AwsRestClientBase::applyAssumeRole(opts);

        # check required options
        foreach string key in (RequiredOptions) {
            auto v = opts{key};
            if (!exists v || v == "") {
                throw "AWSRESTCLIENT-ERROR", sprintf("missing required option %y in option argument", key);
            }
            if (v.typeCode() != NT_STRING) {
                throw "AWSRESTCLIENT-ERROR", sprintf("required option %y was passed as a %s (%y); expecting "
                    "\"string\"", key, v.type(), v);
            }

            self{key} = v;
        }

        # get credential scope suffix
        credential_scope_suffix = sprintf("%s/%s/%s", aws_region, aws_service, AwsTermination);

        if (exists opts.aws_s3 && parse_boolean(opts.aws_s3)) {
            aws_s3 = True;
        }
        if (opts.aws_token) {
            aws_token = opts.aws_token;
            headers."X-Amz-Security-Token" = aws_token;
        }
    }

    #! Returns the AWS region this client signs requests for
    /** @return the AWS region this client signs requests for

        Callers that must include the region in a request payload rather than in the signature need this; the
        S3 \c CreateBucket operation carries the region in its body, for example.

        @since AwsRestClient 1.3
    */
    string getAwsRegion() {
        return aws_region;
    }

    #! Returns the AWS service this client signs requests for
    /** @return the AWS service this client signs requests for

        @since AwsRestClient 1.3
    */
    string getAwsService() {
        return aws_service;
    }

    hash<auto> sendAndDecodeResponse(*data body, string m, string path, hash<auto> hdr, *reference<hash<auto>> info,
            *softbool decode_errors, *string assume_content_type, *string shdr, *code signer) {
        # get request time
        date gmtime = Qore::gmtime();
        # get credential scope
        string scope = sprintf("%s/%s", gmtime.format("YYYYMMDD"), credential_scope_suffix);

        # get signature and signed header string
        string signed_headers;

        # add configured headers without overriding
        hdr = headers + hdr;

        # get signature
        string sig = getSignature(m, path, \hdr, body, gmtime, scope, \signed_headers);

        # add authorization header
        hdr.Authorization = sprintf("%s Credential=%s/%s, SignedHeaders=%s, Signature=%s",
            AwsSignatureAlgorithm, aws_keyid, scope, signed_headers, sig);

        return RestClient::sendAndDecodeResponse(body, m, path, hdr, \info, decode_errors, assume_content_type, shdr,
            signer);
    }

    #! Signs the request with AWS Signature V4 for async operations
    /** @since AwsRestClient 1.3
    */
    private prepareAsyncSend(string method, string path, *data body, reference<hash<auto>> hdr) {
        # get request time
        date gmtime = Qore::gmtime();
        # get credential scope
        string scope = sprintf("%s/%s", gmtime.format("YYYYMMDD"), credential_scope_suffix);

        # get signature and signed header string
        string signed_headers;

        # add configured headers without overriding
        hdr = headers + hdr;

        # get signature
        string sig = getSignature(method, path, \hdr, body, gmtime, scope, \signed_headers);

        # add authorization header
        hdr.Authorization = sprintf("%s Credential=%s/%s, SignedHeaders=%s, Signature=%s",
            AwsSignatureAlgorithm, aws_keyid, scope, signed_headers, sig);
    }

    string getSignature(string http_method, string path, reference<hash<auto>> hdr, *data body, date gmtime,
            string scope, reference<string> signed_headers) {
        string req_string = getRequestString(http_method, path, \hdr, body, gmtime, scope, \signed_headers);

        # calculate a signature
        string gmdate = gmtime.format("YYYYMMDD");
        # 1: key, date
        binary signing_key = hmac(QoreDigest, gmdate, "AWS4" + aws_secret);
        # 2: hash, region
        signing_key = hmac(QoreDigest, aws_region, signing_key);
        # 3: hash, service
        signing_key = hmac(QoreDigest, aws_service, signing_key);
        # 4: hash, termination
        signing_key = hmac(QoreDigest, AwsTermination, signing_key);

        string sig = hmac(QoreDigest, req_string, signing_key).toHex();

        return sig;
    }

    private string getRequestString(string http_method, string path, reference<hash<auto>> hdr, *data body,
            date gmtime, string scope, reference<string> signed_headers) {
        # get AWS date value
        string aws_date = gmtime.format("YYYYMMDDTHHmmSS") + "Z";
        hdr."X-Amz-Date" = aws_date;
        string csig = getCanonicalSignature(http_method, path, hdr, body, \signed_headers);

        string msg = AwsSignatureAlgorithm + "\n"
            + aws_date + "\n"
            + scope + "\n"
            + csig;

        return msg;
    }

    private string getCanonicalSignature(string http_method, string path, hash<auto> hdr, *data body,
        reference<string> signed_headers) {
        # create the canonical string
        # 1: HTTP request method
        string cstr = http_method + "\n";

        # make canonical URI
        hash<UriQueryInfo> uri_info = parse_uri_query(path);

        # 2: canonical URI parameter
        string uri = uri_info.method ?? "/";

        # normalize the path if not an S3 request
        if (!aws_s3) {
            uri = normalize_dir_unix(uri, "/");
        }

        # URI-encode the path
        uri = encode_url(uri, False);
        # non-AWS-S3 requests must be URI-encoded twice
        # https://docs.aws.amazon.com/general/latest/gr/sigv4-create-canonical-request.html
        if (!aws_s3) {
            uri = encode_url(uri, False);
        }
        # add to canonical string
        cstr += uri + "\n";

        # 3: canonical query string
        if (uri_info.params) {
            # process sorted query parameters in order
            cstr += (
                foldl $1 + "&" + $2, (
                    map
                        sprintf("%s=%s", encode_url($1, True),
                            uri_info.params{$1} === True ? "" : encode_url(uri_info.params{$1}, True)),
                        sort(keys uri_info.params)
                )
            );
        }
        cstr += "\n";

        # 4: canonical headers
        # convert header keys to lowercase
        hdr = map {$1.key.lwr(): $1.value}, hdr.pairIterator();
        # add host header
        hdr += {"host": getHostHeaderValue()};

        # sort headers
        hdr = map {$1: hdr{$1}}, sort(keys hdr);

        cstr += (
            foldl $1 + $2, (
                map
                    sprintf("%s:%s\n", $1, AwsRestClientBase::trimall(hdr.$1)),
                    sort(keys hdr)
            )
        ) + "\n";

        # 5: signed headers
        signed_headers = (foldl $1 + ";" + $2, keys hdr);
        cstr += signed_headers + "\n";

        # 6: digest
        cstr += digest(QoreDigest, body ?? "").toHex();

        #printf("CSTR:\n%s\n", cstr);

        return digest(QoreDigest, cstr).toHex();
    }
}

#! class for AWS REST connections; returns @ref AwsRestClient::AwsRestClient objects
/** supports the following options:
    - \c "aws_keyid": (required) AWS key ID
    - \c "aws_region": (required) the AWS region to use (ex: \c "us-east-1")
    - \c "aws_s3": (optional) set to True to flag this object for use with AWS S3, which requires special message
        encoding
    - \c "aws_secret": (required) the AWS secret access key value
    - \c "aws_service": (required) the AWS service to use (ex: \c "iam")
    - \c "aws_token": (optional) a temporary session token from AWS Security Token Service for this HTTP session
    - \c "connect_timeout": connection timeout to use in milliseconds
    - \c "content_encoding": this sets the send encoding (if the \c "send_encoding" option is not set) and the
        requested response encoding; for possible values, see
        @ref RestClient::RestClient::EncodingSupport "EncodingSupport"
    - \c "error_passthru": if @ref True "True" then HTTP status codes indicating errors will not cause a
        \c REST-RESPONSE-ERROR exception to be raised, rather such responses will be passed through to the caller
        like any other response
    - \c "http_version": HTTP version to use (\c "1.0" or \c "1.1", defaults to \c "1.1")
    - \c "max_redirects": maximum redirects to support
    - \c "proxy": proxy URL to use
    - \c "redirect_passthru": if @ref True "True" then redirect responses will be passed to the caller
        instead of processed
    - \c "send_encoding": a @ref RestClient::RestClient::EncodingSupport "send data encoding option" or the value
        \c "auto" which means to use automatic encoding; if not present defaults to no content-encoding on sent
        message bodies
    - \c "timeout": transfer timeout to use in milliseconds

    @note the \c data option is always set to \c "json"

    @see @ref AwsRestClient::AwsRestClient::constructor() "AwsRestClient::constructor()" for more information on
    the above options
*/
public class AwsRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "AWS REST Connection",
            "short_desc": "A connection to AWS cloud REST API services",
            "desc": "A connection to AWS cloud REST API services",
            "cls": Class::forName("AwsRestConnection"),
            "schemes": {
                "awsrests": True,
            },
            "base_scheme_map": {
                "https": "awsrests",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": <ConnectionOptionInfo>{
                    "display_name": "Data Serialization",
                    "short_desc": "The data serialization to use",
                    "type": "string",
                    "desc": "Data serialization options are limited to `json` with this object",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "json",
                            "desc": "use JSON serialization",
                        },
                    ),
                    "default_value": "json",
                },
                "aws_keyid": <ConnectionOptionInfo>{
                    "display_name": "AWS Key ID",
                    "short_desc": "The AWS key ID",
                    "type": "string",
                    "desc": "The AWS key ID",
                },
                "aws_secret": <ConnectionOptionInfo>{
                    "display_name": "AWS Secret",
                    "short_desc": "The AWS secret access key value",
                    "type": "string",
                    "desc": "The AWS secret access key value",
                    "sensitive": True,
                },
                "aws_region": <ConnectionOptionInfo>{
                    "display_name": "AWS Region",
                    "short_desc": "The AWS region to use",
                    "type": "string",
                    "desc": "The AWS region to use (ex: `us-east-1`)",
                    "example_value": "us-east-1",
                },
                "aws_service": <ConnectionOptionInfo>{
                    "display_name": "AWS Service",
                    "short_desc": "The AWS service to use",
                    "type": "string",
                    "desc": "The AWS service to use (ex: `iam`)",
                    "example_value": "iam",
                },
                "aws_s3": <ConnectionOptionInfo>{
                    "display_name": "AWS S3",
                    "short_desc": "Flag for use with AWS S3",
                    "type": "bool",
                    "desc": "Set to `True` to flag this object for use with AWS S3, which requires special "
                        "message encoding",
                    "default_value": False,
                },
                "aws_token": <ConnectionOptionInfo>{
                    "display_name": "AWS Token",
                    "short_desc": "A temporary session token",
                    "type": "string",
                    "desc": "A temporary session token from AWS Security Token Service for this HTTP session",
                    "sensitive": True,
                },
            },
            "required_options": foldl $1 + "," + $2, AwsRestClientBase::RequiredOptions,
        };
    }

    #! creates the AwsRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url, hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the AwsRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
    }

    #! returns \c "awsrest"
    string getType() {
        return "awsrest";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection; the data provider is:
        - \c SwaggerDataProvider: if an appropriate schema is configured
        - \c RestClientDataProvider: if there is no schema configured

        @throw DATA-PROVIDER-ERROR this object does not support the data provider API
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        if (opts.validator || opts.swagger) {
            # get a REST client object without connecting
            AwsRestClient rest = get(False);
            # get any validator
            *AbstractRestSchemaValidator validator = rest.getValidator();
            if (validator) {
                # if there's a validator, return the provider
                return validator.getDataProvider(rest);
            }
        }

        # to avoid circular dependencies, this object loads the RestClientDataProvider and creates the data provider
        # object dynamically
        load_module("AwsRestClientDataProvider");
        return create_object("AwsRestClientDataProvider", get());
    }

    #! returns @ref True, as this connection always returns a data provider with the \c getDataProvider() method
    /** @return @ref True, as this connection always returns a data provider with the \c getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! returns a @ref AwsRestClient::AwsRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref AwsRestClient::AwsRestClient "AwsRestClient" object
    */
    private AwsRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new AwsRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since AwsRestClient 1.4
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new AwsRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for AWS REST API services using multiplexed HTTP connections
/** This class provides AWS Signature V4 signing for requests made via
    @ref RestClientIo::RestClientIo multiplexed connections.

    @see AwsRestClient for more information
*/
public class AwsRestClientIo inherits RestClientIo::RestClientIo, AwsRestClientBase {
    private:internal {
        #! the AWS access key ID
        string aws_keyid;
        #! the AWS secret access key
        string aws_secret;
        #! the AWS region
        string aws_region;
        #! the AWS service
        string aws_service;
        #! is this request for AWS S3?
        bool aws_s3 = False;
        #! temporary session token
        string aws_token;
        #! credential scope suffix
        string credential_scope_suffix;
        #! parsed host from URL
        string aws_host;
    }

    #! Creates the object with the given options
    /** @param opts constructor options (same as AwsRestClient plus HttpClientIo options)
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(AwsRestClientIo::stripAwsOptions(opts) + {"data": "json"}, shared_mgr) {
        hash<UrlInfo> url_info = parse_url(opts.url);
        if (url_info{"username", "password"}) {
            throw "AWSRESTCLIENT-ERROR", sprintf("AWS URL must not contain a username or password; URL: %y",
                get_safe_url(opts.url));
        }

        aws_host = url_info.host;
        if (url_info.port && url_info.port != 443 && url_info.port != 80) {
            aws_host += ":" + string(url_info.port);
        }

        # set the region automatically from the URL if not provided
        *list<string> url_components = (url_info.host =~ x/([^\.]+)/g);
        if (url_components.size() != 4 || url_components[2] != "amazonaws" || url_components[3] != "com") {
            url_components = ();
        }
        if (!opts.aws_service && url_components) {
            opts.aws_service = url_components[0];
        }
        if (!opts.aws_region && url_components) {
            opts.aws_region = url_components[1];
        }

        # fill missing credential/region keys from standard AWS environment variables
        opts = AwsRestClientBase::applyEnvCredentials(opts);
        # if no static credentials are available, try ECS task-role and
        # IMDSv2 in that order (no-op when aws_imds_disabled is True)
        opts = AwsRestClientBase::applyInstanceCredentials(opts);
        # if aws_role_arn is set, perform a one-shot STS AssumeRole and
        # overlay the temporary credentials onto opts
        opts = AwsRestClientBase::applyAssumeRole(opts);

        # check required options
        foreach string key in (AwsRestClientBase::RequiredOptions) {
            auto v = opts{key};
            if (!exists v || v == "") {
                throw "AWSRESTCLIENT-ERROR", sprintf("missing required option %y in option argument", key);
            }
            if (v.typeCode() != NT_STRING) {
                throw "AWSRESTCLIENT-ERROR", sprintf("required option %y was passed as a %s (%y); expecting "
                    "\"string\"", key, v.type(), v);
            }
            self{key} = v;
        }

        credential_scope_suffix = sprintf("%s/%s/%s", aws_region, aws_service, AwsRestClientBase::AwsTermination);

        if (exists opts.aws_s3 && parse_boolean(opts.aws_s3)) {
            aws_s3 = True;
        }
        if (opts.aws_token) {
            aws_token = opts.aws_token;
            addDefaultHeaders({"X-Amz-Security-Token": aws_token});
        }
    }

    #! Returns a copy of \a opts with AWS-specific keys removed, suitable for the RestClientIo base
    static hash<auto> stripAwsOptions(hash<auto> opts) {
        return opts - (keys AwsRestClientBase::AwsOptions);
    }

    #! Sends a generic REST request with AWS Signature V4 signing
    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body,
            *hash<auto> hdr) {
        # Prepare request (serialize body, merge headers)
        hash<auto> prepared = prepareRequest(method, \path, body, \hdr);

        # Sign the request
        signRequest(method, path, prepared.serialized_body, \hdr);

        # Make HTTP request via multiplexed connection manager
        hash<auto> raw = getConnectionManager().request(getUrl(), method, path, hdr,
            prepared.serialized_body);

        # Deserialize and return
        return buildResponse(raw, prepared.error_passthru,
            prepared.allow_any_response, method, path, hdr,
            prepared.serialized_body);
    }

    #! Internal: adds AWS Signature V4 to the request headers
    private signRequest(string method, string path, *data body, reference<*hash<auto>> hdr) {
        date gmtime = Qore::gmtime();
        string scope = sprintf("%s/%s", gmtime.format("YYYYMMDD"), credential_scope_suffix);
        string signed_headers;

        # Ensure hdr is not NOTHING
        if (!hdr) {
            hdr = {};
        }

        # Add host header for signing
        hdr.host = aws_host;

        # Get AWS date value
        string aws_date = gmtime.format("YYYYMMDDTHHmmSS") + "Z";
        hdr."x-amz-date" = aws_date;

        # Build canonical signature
        string csig = getCanonicalSignature(method, path, hdr, body, \signed_headers);

        string msg = AwsRestClientBase::AwsSignatureAlgorithm + "\n"
            + aws_date + "\n"
            + scope + "\n"
            + csig;

        # Calculate signing key
        string gmdate = gmtime.format("YYYYMMDD");
        binary signing_key = hmac(AwsRestClientBase::QoreDigest, gmdate, "AWS4" + aws_secret);
        signing_key = hmac(AwsRestClientBase::QoreDigest, aws_region, signing_key);
        signing_key = hmac(AwsRestClientBase::QoreDigest, aws_service, signing_key);
        signing_key = hmac(AwsRestClientBase::QoreDigest, AwsRestClientBase::AwsTermination, signing_key);

        string sig = hmac(AwsRestClientBase::QoreDigest, msg, signing_key).toHex();

        hdr.authorization = sprintf("%s Credential=%s/%s, SignedHeaders=%s, Signature=%s",
            AwsRestClientBase::AwsSignatureAlgorithm, aws_keyid, scope, signed_headers, sig);
    }

    #! Internal: builds canonical signature for AWS Signature V4
    private string getCanonicalSignature(string http_method, string path, hash<auto> hdr, *data body,
            reference<string> signed_headers) {
        string cstr = http_method + "\n";

        hash<UriQueryInfo> uri_info = parse_uri_query(path);
        string uri = uri_info.method ?? "/";

        if (!aws_s3) {
            uri = normalize_dir_unix(uri, "/");
        }
        uri = encode_url(uri, False);
        if (!aws_s3) {
            uri = encode_url(uri, False);
        }
        cstr += uri + "\n";

        if (uri_info.params) {
            cstr += (
                foldl $1 + "&" + $2, (
                    map
                        sprintf("%s=%s", encode_url($1, True),
                            uri_info.params{$1} === True ? "" : encode_url(uri_info.params{$1}, True)),
                        sort(keys uri_info.params)
                )
            );
        }
        cstr += "\n";

        # Convert header keys to lowercase and sort
        hdr = map {$1.key.lwr(): $1.value}, hdr.pairIterator();
        hdr = map {$1: hdr{$1}}, sort(keys hdr);

        cstr += (
            foldl $1 + $2, (
                map
                    sprintf("%s:%s\n", $1, regex_subst(trim(hdr.$1), " +", " ", RE_Global)),
                    sort(keys hdr)
            )
        ) + "\n";

        signed_headers = (foldl $1 + ";" + $2, keys hdr);
        cstr += signed_headers + "\n";

        cstr += digest(AwsRestClientBase::QoreDigest, body ?? "").toHex();

        return digest(AwsRestClientBase::QoreDigest, cstr).toHex();
    }
}

#! Common base class for Amazon S3 and S3-compatible connections
/** Pins the AWS service to \c s3 and enables the S3 request-encoding mode, so that a connection can be created
    without the caller having to know which AWS options S3 requires.

    S3 signs requests differently from every other AWS service: request URIs are URI-encoded once rather than
    twice and paths are not normalized.  @ref AwsRestClient implements that rule; it is selected by the
    \c aws_s3 option, which this class sets and does not allow to be overridden.

    Two connection types are built on this: @ref AwsS3RestConnection for Amazon S3 itself, which needs no URL
    and offers a list of AWS regions, and @ref AwsS3CompatibleRestConnection for an S3-compatible service such
    as MinIO or Ceph, which is reached at a URL of its own.

    @since AwsRestClient 1.3
*/
public class AwsS3RestConnectionBase inherits AwsRestConnection {
    public {
        #! The AWS service name for S3
        const AwsService = "s3";
    }

    #! creates the object
    constructor(string name, string description, string url, hash<auto> attributes = {}, hash<auto> options = {})
            : AwsRestConnection(name, description, url, attributes, options) {
    }

    #! creates the object
    constructor(hash<auto> config, *hash<auto> attr) : AwsRestConnection(config, attr) {
    }

    #! Returns the data provider application name this connection serves
    *string getAppName() {
        return "AmazonS3";
    }

    #! returns @ref True, as this connection returns a data provider
    bool hasDataProvider() {
        return True;
    }

    #! returns an AwsS3DataProvider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return an AwsS3DataProvider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, the data provider module is loaded and the object created dynamically
        load_module("AwsS3DataProvider");
        return create_object("AwsS3DataProvider", {
            "restclient": get(),
            "path_style": opts.path_style ?? True,
        } + constructor_options);
    }

    #! Returns client options with the AWS service and S3 encoding options pinned
    /** @param rtopts runtime options

        @return the client options with the S3-specific values applied

        @note \c aws_service and \c aws_s3 are set unconditionally; a connection of this type is by definition an
        S3 connection, and allowing either to be overridden would produce requests signed for the wrong service
        or with the wrong URI encoding, which fail with an opaque signature mismatch

        @note They are applied here, where the client is configured, rather than stored in the connection's own
        options: these classes remove both from their declared option set so that neither appears as something a
        user may set, and a connection option that is not declared is rejected as unknown when the connection is
        validated
    */
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        return AwsRestConnection::getConnectionOptions(rtopts) + {
            "aws_service": AwsService,
            "aws_s3": True,
        };
    }
}

#! Class for Amazon S3 connections; returns @ref AwsRestClient objects configured for S3
/** Creating one of these needs an access key ID, a secret access key, and the region the buckets live in;
    everything else is supplied by this class.  In particular **no URL is required**: Amazon serves every region
    at a well-known endpoint, so the URL is derived from the region rather than asked for.  The region is offered
    as a list of the AWS regions, and a region not in the list is still accepted, since AWS adds regions over
    time.

    Use @ref AwsS3CompatibleRestConnection instead for an S3-compatible service that is not Amazon; those are
    reached at a URL of their own, which this class does not accept.

    @since AwsRestClient 1.3
*/
public class AwsS3RestConnection inherits AwsS3RestConnectionBase {
    public {
        #! The AWS regions offered when creating a connection
        /** Not exhaustive by design: AWS adds regions, so \c allowed_values_creatable is set on the option and a
            region that is not listed here is still accepted
        */
        const AwsRegions = (
            <AllowedValueInfo>{"value": "us-east-1", "display_name": "US East (N. Virginia)",
                "desc": "US East (N. Virginia)"},
            <AllowedValueInfo>{"value": "us-east-2", "display_name": "US East (Ohio)",
                "desc": "US East (Ohio)"},
            <AllowedValueInfo>{"value": "us-west-1", "display_name": "US West (N. California)",
                "desc": "US West (N. California)"},
            <AllowedValueInfo>{"value": "us-west-2", "display_name": "US West (Oregon)",
                "desc": "US West (Oregon)"},
            <AllowedValueInfo>{"value": "af-south-1", "display_name": "Africa (Cape Town)",
                "desc": "Africa (Cape Town)"},
            <AllowedValueInfo>{"value": "ap-east-1", "display_name": "Asia Pacific (Hong Kong)",
                "desc": "Asia Pacific (Hong Kong)"},
            <AllowedValueInfo>{"value": "ap-south-1", "display_name": "Asia Pacific (Mumbai)",
                "desc": "Asia Pacific (Mumbai)"},
            <AllowedValueInfo>{"value": "ap-south-2", "display_name": "Asia Pacific (Hyderabad)",
                "desc": "Asia Pacific (Hyderabad)"},
            <AllowedValueInfo>{"value": "ap-northeast-1", "display_name": "Asia Pacific (Tokyo)",
                "desc": "Asia Pacific (Tokyo)"},
            <AllowedValueInfo>{"value": "ap-northeast-2", "display_name": "Asia Pacific (Seoul)",
                "desc": "Asia Pacific (Seoul)"},
            <AllowedValueInfo>{"value": "ap-northeast-3", "display_name": "Asia Pacific (Osaka)",
                "desc": "Asia Pacific (Osaka)"},
            <AllowedValueInfo>{"value": "ap-southeast-1", "display_name": "Asia Pacific (Singapore)",
                "desc": "Asia Pacific (Singapore)"},
            <AllowedValueInfo>{"value": "ap-southeast-2", "display_name": "Asia Pacific (Sydney)",
                "desc": "Asia Pacific (Sydney)"},
            <AllowedValueInfo>{"value": "ap-southeast-3", "display_name": "Asia Pacific (Jakarta)",
                "desc": "Asia Pacific (Jakarta)"},
            <AllowedValueInfo>{"value": "ap-southeast-4", "display_name": "Asia Pacific (Melbourne)",
                "desc": "Asia Pacific (Melbourne)"},
            <AllowedValueInfo>{"value": "ca-central-1", "display_name": "Canada (Central)",
                "desc": "Canada (Central)"},
            <AllowedValueInfo>{"value": "ca-west-1", "display_name": "Canada West (Calgary)",
                "desc": "Canada West (Calgary)"},
            <AllowedValueInfo>{"value": "eu-central-1", "display_name": "Europe (Frankfurt)",
                "desc": "Europe (Frankfurt)"},
            <AllowedValueInfo>{"value": "eu-central-2", "display_name": "Europe (Zurich)",
                "desc": "Europe (Zurich)"},
            <AllowedValueInfo>{"value": "eu-west-1", "display_name": "Europe (Ireland)",
                "desc": "Europe (Ireland)"},
            <AllowedValueInfo>{"value": "eu-west-2", "display_name": "Europe (London)",
                "desc": "Europe (London)"},
            <AllowedValueInfo>{"value": "eu-west-3", "display_name": "Europe (Paris)",
                "desc": "Europe (Paris)"},
            <AllowedValueInfo>{"value": "eu-north-1", "display_name": "Europe (Stockholm)",
                "desc": "Europe (Stockholm)"},
            <AllowedValueInfo>{"value": "eu-south-1", "display_name": "Europe (Milan)",
                "desc": "Europe (Milan)"},
            <AllowedValueInfo>{"value": "eu-south-2", "display_name": "Europe (Spain)",
                "desc": "Europe (Spain)"},
            <AllowedValueInfo>{"value": "il-central-1", "display_name": "Israel (Tel Aviv)",
                "desc": "Israel (Tel Aviv)"},
            <AllowedValueInfo>{"value": "me-south-1", "display_name": "Middle East (Bahrain)",
                "desc": "Middle East (Bahrain)"},
            <AllowedValueInfo>{"value": "me-central-1", "display_name": "Middle East (UAE)",
                "desc": "Middle East (UAE)"},
            <AllowedValueInfo>{"value": "sa-east-1", "display_name": "South America (São Paulo)",
                "desc": "South America (São Paulo)"},
        );

        #! The default AWS region
        const DefaultRegion = "us-east-1";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Amazon S3",
            "short_desc": "A connection to Amazon S3 object storage",
            "desc": "A connection to [Amazon S3](https://aws.amazon.com/s3/) object storage.\n\n"
                "Requires an AWS access key ID and secret access key with permission for the buckets to be "
                "used, plus the region the buckets live in.  The URL is derived from the region, and the AWS "
                "service and S3 request-encoding options are set automatically.\n\n"
                "Use an **S3-Compatible Storage** connection instead for MinIO, Ceph, or another service that "
                "speaks the S3 protocol but is not Amazon",
            "cls": Class::forName("AwsS3RestConnection"),
            # the URL is derived from the region, so the user is never asked for one
            "auto_url": True,
            "schemes": {
                "s3": True,
            },
            "base_scheme_map": {
                "https": "s3",
            },
            # "path_style" is not offered: path-style addressing is currently the only mode the data provider
            # module implements, so it is not a choice the user can meaningfully make
            "options": AwsRestConnection::ConnectionScheme.options - ("aws_service", "aws_s3") + {
                "aws_region": AwsRestConnection::ConnectionScheme.options.aws_region + <ConnectionOptionInfo>{
                    "desc": "The AWS region holding the buckets to be used; this also selects the endpoint the "
                        "connection is made to, so a region other than the one the buckets live in produces "
                        "redirects and signature errors",
                    "default_value": DefaultRegion,
                    "allowed_values": AwsRegions,
                    # AWS adds regions, so a region not in the list must still be accepted
                    "allowed_values_creatable": True,
                },
            },
            "required_options": "aws_keyid,aws_secret,aws_region",
        };

        #! The URL used when no region is set
        const DefaultUrl = "https://s3.amazonaws.com";
    }

    #! creates the AwsS3RestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url this argument is ignored; the URL is derived from the \c aws_region option
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl, hash<auto> attributes = {},
            hash<auto> options = {})
            : AwsS3RestConnectionBase(name, description, AwsS3RestConnection::getRegionUrl(options.aws_region),
                attributes, options) {
    }

    #! creates the AwsS3RestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (optional string): ignored; the URL is derived from the \c aws_region option
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : AwsS3RestConnectionBase(config + {
                "url": AwsS3RestConnection::getRegionUrl(config.opts.aws_region),
            }, attr) {
    }

    #! returns \c "s3"
    string getType() {
        return "s3";
    }

    #! Returns the Amazon S3 endpoint URL for the given region
    /** Amazon serves every region at a well-known endpoint, so asking the user for a URL adds a way to get the
        connection wrong without adding anything they can usefully choose.  The regional endpoint is used rather
        than the global \c s3.amazonaws.com one, which answers a request for a bucket in another region with a
        redirect that has to be re-signed.

        @param region the AWS region, if set

        @return the endpoint URL for the region
    */
    static string getRegionUrl(*string region) {
        return region.val()
            ? sprintf("https://s3.%s.amazonaws.com", region)
            : DefaultUrl;
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! Class for connections to S3-compatible storage that is not Amazon S3
/** For MinIO, Ceph, and other services that speak the S3 protocol.  Unlike @ref AwsS3RestConnection these are
    reached at a URL of their own, so a URL is required; the region is free-form, since such a service accepts
    whatever region it was configured with, and path-style addressing is offered because most of them require it.

    @since AwsRestClient 1.3
*/
public class AwsS3CompatibleRestConnection inherits AwsS3RestConnectionBase {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "S3-Compatible Storage",
            "short_desc": "A connection to S3-compatible object storage such as MinIO or Ceph",
            "desc": "A connection to object storage that speaks the Amazon S3 protocol but is not Amazon S3, "
                "such as [MinIO](https://min.io) or [Ceph](https://ceph.io).\n\n"
                "Requires the URL the service is reached at, plus an access key ID and secret access key.  The "
                "region is whatever the service was configured with, and is often left at `us-east-1`, which is "
                "what most S3-compatible services default to.\n\n"
                "Use an **Amazon S3** connection instead for Amazon S3 itself; that one derives its URL from "
                "the region and needs no URL at all",
            "cls": Class::forName("AwsS3CompatibleRestConnection"),
            "schemes": {
                "s3compatible": True,
            },
            "base_scheme_map": {
                "https": "s3compatible",
            },
            "options": AwsRestConnection::ConnectionScheme.options - ("aws_service", "aws_s3") + {
                "aws_region": AwsRestConnection::ConnectionScheme.options.aws_region + <ConnectionOptionInfo>{
                    "desc": "The region the service was configured with; most S3-compatible services default to "
                        "`us-east-1` and ignore the value beyond using it to sign requests",
                    "default_value": "us-east-1",
                },
                "path_style": <ConnectionOptionInfo>{
                    "display_name": "Path-Style Addressing",
                    "short_desc": "Address buckets in the URI path rather than in the hostname",
                    "type": "bool",
                    "desc": "Address buckets in the URI path (`https://<host>/<bucket>/<key>`) rather than in "
                        "the hostname (`https://<bucket>.<host>/<key>`).\n\n"
                        "This is the default and currently the only supported mode: virtual-host addressing "
                        "needs a separate endpoint per bucket, which the data provider module does not yet "
                        "create.  Most S3-compatible services require path-style addressing in any case",
                    "default_value": True,
                },
            },
            "required_options": "aws_keyid,aws_secret",
        };
    }

    #! creates the AwsS3CompatibleRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url the URL the S3-compatible service is reached at
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url, hash<auto> attributes = {},
            hash<auto> options = {})
            : AwsS3RestConnectionBase(name, description, url, attributes, options) {
    }

    #! creates the AwsS3CompatibleRestConnection object
    /** @param config the connection configuration hash
        @param attr optional connection attributes

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : AwsS3RestConnectionBase(config, attr) {
    }

    #! returns \c "s3compatible"
    string getType() {
        return "s3compatible";
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
