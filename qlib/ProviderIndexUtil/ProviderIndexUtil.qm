# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%try-module yaml
%define NoYaml
%endtry

%try-module msgpack
%define NoMsgPack
%endtry

%requires(reexport) Logger
%requires Util
%requires reflection

module ProviderIndexUtil {
    version = "1.2";
    desc = "user module for indexing data providers";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage ProviderIndexUtil Module

    @tableofcontents

    @section providerindexutilintro Introduction to the ProviderIndexUtil Module

    The %ProviderIndexUtil module providers APIs to index data providers, so that they can support
    on-demand initialization.

    @section providerindexutil_relnotes Release Notes

    @subsection providerindexutil_v1_2 ProviderIndexUtil v1.2
    - the routing index and the metadata cache are the published index; the canonical index file
      (\c qore-data-index.yaml), a YAML copy of the complete index that can be hundreds of megabytes, is only
      written if requested with the new \c write_canonical_yaml argument of
      @ref ProviderIndexUtil::ProviderIndexUtil::writeDataProviderIndex() "ProviderIndexUtil::writeDataProviderIndex()"
      and @ref ProviderIndexUtil::ProviderIndexUtil::writeDataProviderIndexByApp() "ProviderIndexUtil::writeDataProviderIndexByApp()",
      or with the @ref ProviderIndexUtil::ProviderIndexCanonicalYamlEnvVar "QORE_PROVIDER_INDEX_CANONICAL_YAML"
      environment variable, or if MessagePack support is not available; a canonical index file left by an earlier
      index is removed when an index is published without one; indexes published with it are still read, with or
      without the file; earlier versions of this module cannot read an index published without it
    - added @ref ProviderIndexUtil::ProviderIndexUtil::dumpIndexYaml() "ProviderIndexUtil::dumpIndexYaml()", which
      writes a published index, or one app of it, as YAML in the format of the canonical index file
    - the routing index records the actions declaring an alternative to their app's scheme connection (routing
      index version 4), returned by the new
      @ref ProviderIndexUtil::ProviderIndexUtil::tryGetConnectionAlternativeActions() "ProviderIndexUtil::tryGetConnectionAlternativeActions()"
      without reading any app's metadata;
      @ref ProviderIndexUtil::ProviderIndexUtil::hasConnectionAlternatives() "ProviderIndexUtil::hasConnectionAlternatives()"
      reports whether an index published by an earlier version records them; such indexes are still read
    - each metadata cache file is named after the digest of its contents (routing index version 3, metadata cache
      version 5), so that publishing an index never changes a file that the previous index references, and the
      routing index, which is written last, publishes the new index atomically; the files that it no longer
      references are then removed; indexes written with metadata cache version 4 are still read
    - errors reading the routing index or the metadata cache are reported by
      @ref ProviderIndexUtil::ProviderIndexUtil::getIndexReadError() "ProviderIndexUtil::getIndexReadError()";
      the canonical index file is only read if there is one, and an app whose metadata cannot be read is
      unavailable without affecting the other apps
    - a canonical index file larger than
      @ref ProviderIndexUtil::ProviderIndexUtil::getMaxCanonicalIndexSize() "ProviderIndexUtil::getMaxCanonicalIndexSize()"
      (128 MiB by default, set with the
      @ref ProviderIndexUtil::ProviderIndexMaxCanonicalSizeEnvVar "QORE_PROVIDER_INDEX_MAX_CANONICAL_BYTES"
      environment variable) is not read, since it takes several times its size in memory to parse; this is
      reported as a \c PROVIDER-INDEX-TOO-LARGE error
    - @ref ProviderIndexUtil::ProviderIndexUtil::readDataProviderIndex() "ProviderIndexUtil::readDataProviderIndex()"
      reads the index currently published, instead of the metadata cache of an index that the process read earlier
    - added index build mode
      (@ref ProviderIndexUtil::ProviderIndexUtil::setBuildMode() "ProviderIndexUtil::setBuildMode()" and the
      @ref ProviderIndexUtil::ProviderIndexBuildEnvVar "QORE_PROVIDER_INDEX_BUILD" environment variable), in which
      the published index is never read, so a process building the index neither loads the provider modules listed
      in the index it replaces nor holds its metadata in memory
    - the index is written one app at a time, so the complete serialized index is no longer held in memory while it
      is written; added
      @ref ProviderIndexUtil::ProviderIndexUtil::writeDataProviderIndexByApp() "ProviderIndexUtil::writeDataProviderIndexByApp()"
    - index files are written deterministically, with apps, actions, and map entries in sorted order
    - listing or searching the cached apps no longer loads the actions of every app, which took many times the
      memory of the app info and stayed in memory for the life of the process; each app's actions are loaded when
      they are first needed
    - added @ref ProviderIndexUtil::ProviderIndexUtil::readSerializedDataProviderIndex() "ProviderIndexUtil::readSerializedDataProviderIndex()"
      and @ref ProviderIndexUtil::ProviderIndexUtil::getSerializedDataProviderIndexSource() "ProviderIndexUtil::getSerializedDataProviderIndexSource()",
      which read and verify a published index from its compact routing index and metadata cache instead of the much
      larger canonical index file, and identify it by the digest of its routing index
    - the canonical index file, which can be hundreds of megabytes, is no longer read to validate the routing index
      unless it may have changed since the routing index was written (its size is different, or it is newer than
      the routing index); it was read in full by every process that used the index; when it is read, it is read as
      binary data
    - listing the apps of a published index reads only the metadata cache manifest, which now holds the info of
      each app, instead of reading the metadata of every app with its actions, which took about 1 GB of memory for
      a large index; the metadata cache format version is 4, so a cache written by an earlier version is not used
      until the index is updated
    - added @ref ProviderIndexUtil::ProviderIndexUtil::hasMessagePack() "ProviderIndexUtil::hasMessagePack()",
      which reports if the compact index files can be written and read, and index workers used
    - indexed actions are returned as \c DataProvider::DataProviderIndexedActionInfo hashes, in which each
      option's type is described by plain data in \c type_info; reading them never loads the provider modules
      that implement an app, and output types are not indexed
    - added @ref ProviderIndexUtil::ProviderIndexUtil::tryGetActionMetadataForApp() "ProviderIndexUtil::tryGetActionMetadataForApp()"
      and @ref ProviderIndexUtil::ProviderIndexUtil::tryGetActionMetadata() "ProviderIndexUtil::tryGetActionMetadata()";
      they replace \c tryGetApproximateActionsForApp() and \c tryGetApproximateAppAction(), which returned
      action types restored from the index and have been removed
    - primitive option type names from earlier indexes are converted to type descriptions; types serialized by
      development versions of this module are not restored, and such indexes must be recreated
    - an action whose metadata cannot be read is logged and omitted instead of being returned in serialized form
    - fixed a complete load of a deferred index bringing back metadata for apps that had already been loaded,
      which returned the actions of removed apps
    - fixed @ref ProviderIndexUtil::ProviderIndexUtil::removeCachedApp() "ProviderIndexUtil::removeCachedApp()"
      leaving the removed app's actions available

    @subsection providerindexutil_v1_1 ProviderIndexUtil v1.1
    - loaded dependency filtering recognizes exact module names and loaded artifact paths, including compiled
      modules with API-version suffixes; legacy explicit-path indexes remain readable

    @subsection providerindexutil_v1_0 ProviderIndexUtil v1.0
    - added an optional, versioned, app-sharded MessagePack metadata cache with per-shard integrity validation and
      canonical YAML fallback
    - initial release of the module
*/

#! contains all public definitions in the ProviderIndexUtil module
public namespace ProviderIndexUtil {
}
