            "groups": "Workspace Group Members",
            "display_name": "List Workspace Group Members",
            "short_desc": "List and search workspace group members",
            "desc": "Retrieve a list of members in a workspace group.",
            "action_code": DPAT_FIND,
            "data_provider_info": InstantlyWorkspaceGroupMembersDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("WorkspaceGroupMemberList", new InstantlyWorkspaceGroupMemberDataType(), True);
            },
            "options": {
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum number of results to return",
                    "desc": "The maximum number of results to return per page",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # Create Workspace Group Member
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/create-workspace-group-member",
            "action": "create-workspace-group-member",
            "groups": "Workspace Group Members",
            "display_name": "Create Workspace Group Member",
            "short_desc": "Add a member to a workspace group",
            "desc": "Add an existing workspace member to a workspace group.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyCreateWorkspaceGroupMemberDataProvider::ProviderInfo,
            "output_type": InstantlyCreateWorkspaceGroupMemberDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyCreateWorkspaceGroupMemberRequestDataType::Fields),
        });

        # Get Workspace Group Member
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-workspace-group-member",
            "action": "get-workspace-group-member",
            "groups": "Workspace Group Members",
            "display_name": "Get Workspace Group Member",
            "short_desc": "Get a single workspace group member by ID",
            "desc": "Retrieve detailed information about a specific workspace group member.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetWorkspaceGroupMemberDataProvider::ProviderInfo,
            "output_type": InstantlyGetWorkspaceGroupMemberDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetWorkspaceGroupMemberRequestDataType::Fields),
        });

        # Delete Workspace Group Member
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/delete-workspace-group-member",
            "action": "delete-workspace-group-member",
            "groups": "Workspace Group Members",
            "display_name": "Delete Workspace Group Member",
            "short_desc": "Remove a member from a workspace group",
            "desc": "Remove a member from a workspace group. This action cannot be undone.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyDeleteWorkspaceGroupMemberDataProvider::ProviderInfo,
            "output_type": InstantlyDeleteWorkspaceGroupMemberDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyDeleteWorkspaceGroupMemberRequestDataType::Fields),
        });

        # ========== AUDIT LOG ACTIONS ==========

        # List Audit Logs
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/audit-logs",
            "action": "list-audit-logs",
            "groups": "Audit Log",
            "display_name": "List Audit Logs",
            "short_desc": "List and search audit logs",
            "desc": "Retrieve a list of audit log entries from Instantly for tracking workspace activity.",
            "action_code": DPAT_FIND,
            "data_provider_info": InstantlyAuditLogsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("AuditLogList", new InstantlyAuditLogDataType(), True);
            },
            "options": {
                "user_id": <ActionOptionInfo>{
                    "display_name": "User ID",
                    "short_desc": "Filter by user UUID",
                    "desc": "Filter audit logs by the user UUID who performed the action",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "action": <ActionOptionInfo>{
                    "display_name": "Action",
                    "short_desc": "Filter by action type",
                    "desc": "Filter audit logs by the action that was performed",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "resource_type": <ActionOptionInfo>{
                    "display_name": "Resource Type",
                    "short_desc": "Filter by resource type",
                    "desc": "Filter audit logs by the type of resource affected",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "start_date": <ActionOptionInfo>{
                    "display_name": "Start Date",
                    "short_desc": "Filter from date",
                    "desc": "Filter audit logs from this date (inclusive)",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "end_date": <ActionOptionInfo>{
                    "display_name": "End Date",
                    "short_desc": "Filter to date",
                    "desc": "Filter audit logs up to this date (inclusive)",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum number of results to return",
                    "desc": "The maximum number of results to return per page",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # ========== EVENT TRIGGERS ==========

        # Reply Received Event
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/events/reply_received",
            "action": "reply-received",
            "action_val": "reply_received",
            "groups": "Events",
            "display_name": "Reply Received",
            "short_desc": "Triggered when a reply is received",
            "desc": "This event is triggered when a reply is received to a campaign email.",
            "action_code": DPAT_EVENT,
            "data_provider_info": InstantlyReplyReceivedEventDataProvider::ProviderInfo,
        });

        # Email Bounced Event
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/events/email_bounced",
            "action": "email-bounced",
            "action_val": "email_bounced",
            "groups": "Events",
            "display_name": "Email Bounced",
            "short_desc": "Triggered when an email bounces",
            "desc": "This event is triggered when a campaign email bounces.",
            "action_code": DPAT_EVENT,
            "data_provider_info": InstantlyEmailBouncedEventDataProvider::ProviderInfo,
        });

        # Lead Interested Event
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/events/lead_interested",
            "action": "lead-interested",
            "action_val": "lead_interested",
            "groups": "Events",
            "display_name": "Lead Interested",
            "short_desc": "Triggered when a lead shows interest",
            "desc": "This event is triggered when a lead's interest status changes to interested.",
            "action_code": DPAT_EVENT,
            "data_provider_info": InstantlyLeadInterestedEventDataProvider::ProviderInfo,
        });

        # Campaign Completed Event
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/events/campaign_completed",
            "action": "campaign-completed",
            "action_val": "campaign_completed",
            "groups": "Events",
            "display_name": "Campaign Completed",
            "short_desc": "Triggered when a campaign completes",
            "desc": "This event is triggered when a campaign finishes sending all its emails.",
            "action_code": DPAT_EVENT,
            "data_provider_info": InstantlyCampaignCompletedEventDataProvider::ProviderInfo,
        });
    };
}

/** @mainpage InstantlyDataProvider Module

    @tableofcontents

    @section instantlydataproviderintro InstantlyDataProvider Introduction

    The %InstantlyDataProvider module provides a data provider API for Instantly's email outreach
    and sales automation platform.

    The following classes are provided by this module:
    - @ref InstantlyDataProvider::InstantlyDataProvider "InstantlyDataProvider"
    - @ref InstantlyDataProvider::InstantlyDataProviderFactory "InstantlyDataProviderFactory"

    @section instantlydataprovider_actions Supported Actions

    This data provider supports the following action groups:
    - **Accounts** - manage email accounts, warmup, and tracking domains
    - **Campaigns** - create, manage, and analyze email campaigns
    - **Campaign Subsequences** - manage subsequences within campaigns
    - **Leads** - manage leads including CRUD, merging, moving, and bulk operations
    - **Lead Lists** - organize leads into lists
    - **Lead Labels** - categorize leads with labels
    - **Emails** - manage emails, replies, and threads
    - **Block List** - manage blocked email addresses and domains
    - **Custom Tags** - organize resources with custom tags
    - **Inbox Placement Tests** - test email deliverability
    - **Inbox Placement Analytics** - analyze deliverability metrics
    - **Email Verification** - verify email addresses
    - **Background Jobs** - monitor background processing jobs
    - **Workspace** - manage workspace settings
    - **Workspace Members** - manage workspace team members
    - **Workspace Group Members** - manage workspace group memberships
    - **Audit Log** - track workspace activity

    @section instantlydataprovider_auth Authentication

    Instantly uses API key authentication. You need an API key which can be obtained from your
    Instantly workspace settings.

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires InstantlyDataProvider

InstantlyDataProvider instantly({"apikey": ENV.INSTANTLY_API_KEY});

# List campaigns
map printf("Campaign: %s (Status: %d)\n", $1.name, $1.status),
    instantly.getChildProvider("campaigns").searchRecords({"status": 1});

# Create a lead
hash<auto> result = instantly.getChildProvider("create-lead").doRequest({
    "email": "test@example.com",
    "first_name": "John",
    "last_name": "Doe",
    "campaign_id": "your-campaign-uuid",
});
printf("Created lead: %s\n", result.id);
    @endcode

    @section instantlydataproviderrelnotes Release Notes

    @subsection instantlydataproviderv1_0 InstantlyDataProvider v1.0
    - the initial version of the %InstantlyDataProvider module
*/

#! Contains all public definitions in the InstantlyDataProvider module
public namespace InstantlyDataProvider {
}
