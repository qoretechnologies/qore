# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) InstantlyRestClient
%try-module json
%define NoJson
%endtry

module InstantlyDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Instantly email outreach and sales automation";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new InstantlyDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": InstantlyDataProvider::AppName,
            "display_name": "Instantly",
            "short_desc": "Instantly email outreach and sales automation",
            "desc": "Instantly.ai is a comprehensive platform for cold email outreach and sales automation. "
                "It provides tools for managing email accounts, running multi-step campaigns, tracking leads, "
                "and analyzing deliverability.\n\n"
                "**Features:**\n"
                "- Email account management and warmup\n"
                "- Multi-step campaign creation and automation\n"
                "- Lead management with lists, labels, and interest tracking\n"
                "- Email deliverability and inbox placement testing\n"
                "- Campaign analytics and reporting\n"
                "- Workspace and team collaboration\n"
                "- Block list management\n"
                "- Custom tags for organizing resources",
            "scheme": "instantly",
            "logo": InstantlyLogo,
            "logo_file_name": "instantly-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Email, DataProvider::AppGroup::Marketing,),
        });

        # ========== ACCOUNT ACTIONS ==========

        # List Accounts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/accounts",
            "action": "list-accounts",
            "groups": "Accounts",
            "display_name": "List Accounts",
            "short_desc": "List and search email accounts",
            "desc": "Retrieve a list of email accounts from Instantly with optional filtering by status.",
            "action_code": DPAT_FIND,
            "data_provider_info": InstantlyAccountsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("AccountList", new InstantlyAccountDataType(), True);
            },
            "options": {
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum number of results to return",
                    "desc": "The maximum number of results to return per page",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by account status",
                    "desc": "Filter accounts by status: `1` = Active, `2` = Paused, `3` = Maintenance, "
                        "`-1` = Connection Error, `-2` = Soft Bounce, `-3` = Sending Error",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": 1, "display_name": "Active"},
                        <AllowedValueInfo>{"value": 2, "display_name": "Paused"},
                        <AllowedValueInfo>{"value": 3, "display_name": "Maintenance"},
                        <AllowedValueInfo>{"value": -1, "display_name": "Connection Error"},
                        <AllowedValueInfo>{"value": -2, "display_name": "Soft Bounce"},
                        <AllowedValueInfo>{"value": -3, "display_name": "Sending Error"},
                    ),
                },
            },
        });

        # Create Account
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/create-account",
            "action": "create-account",
            "groups": "Accounts",
            "display_name": "Create Account",
            "short_desc": "Create a new email account",
            "desc": "Add a new email account to Instantly for use in campaigns and warmup.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyCreateAccountDataProvider::ProviderInfo,
            "output_type": InstantlyCreateAccountDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyCreateAccountRequestDataType::Fields),
        });

        # Get Account
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-account",
            "action": "get-account",
            "groups": "Accounts",
            "display_name": "Get Account",
            "short_desc": "Get a single account by ID",
            "desc": "Retrieve detailed information about a specific email account.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetAccountDataProvider::ProviderInfo,
            "output_type": InstantlyGetAccountDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetAccountRequestDataType::Fields),
        });

        # Patch Account
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/patch-account",
            "action": "patch-account",
            "groups": "Accounts",
            "display_name": "Patch Account",
            "short_desc": "Update an existing account",
            "desc": "Update properties of an existing email account in Instantly.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyPatchAccountDataProvider::ProviderInfo,
            "output_type": InstantlyPatchAccountDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyPatchAccountRequestDataType::Fields),
        });

        # Delete Account
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/delete-account",
            "action": "delete-account",
            "groups": "Accounts",
            "display_name": "Delete Account",
            "short_desc": "Delete an email account",
            "desc": "Remove an email account from Instantly. This action cannot be undone.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyDeleteAccountDataProvider::ProviderInfo,
            "output_type": InstantlyDeleteAccountDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyDeleteAccountRequestDataType::Fields),
        });

        # Pause Account
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/pause-account",
            "action": "pause-account",
            "groups": "Accounts",
            "display_name": "Pause Account",
            "short_desc": "Pause an email account",
            "desc": "Pause an email account to temporarily stop sending and warmup activities.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyPauseAccountDataProvider::ProviderInfo,
            "output_type": InstantlyPauseAccountDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyPauseAccountRequestDataType::Fields),
        });

        # Resume Account
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/resume-account",
            "action": "resume-account",
            "groups": "Accounts",
            "display_name": "Resume Account",
            "short_desc": "Resume a paused account",
            "desc": "Resume a paused email account to restart sending and warmup activities.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyResumeAccountDataProvider::ProviderInfo,
            "output_type": InstantlyResumeAccountDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyResumeAccountRequestDataType::Fields),
        });

        # Mark Account Fixed
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/mark-account-fixed",
            "action": "mark-account-fixed",
            "groups": "Accounts",
            "display_name": "Mark Account Fixed",
            "short_desc": "Mark an account as fixed",
            "desc": "Mark an email account as fixed after resolving connection or sending issues.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyMarkAccountFixedDataProvider::ProviderInfo,
            "output_type": InstantlyMarkAccountFixedDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyMarkAccountFixedRequestDataType::Fields),
        });

        # Test Account Vitals
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/test-account-vitals",
            "action": "test-account-vitals",
            "groups": "Accounts",
            "display_name": "Test Account Vitals",
            "short_desc": "Test account vitals and health",
            "desc": "Run a diagnostic test on an email account to check its health, deliverability, and "
                "connection status.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyTestAccountVitalsDataProvider::ProviderInfo,
            "output_type": InstantlyTestAccountVitalsDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyTestAccountVitalsRequestDataType::Fields),
        });

        # Get Warmup Analytics
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-warmup-analytics",
            "action": "get-warmup-analytics",
            "groups": "Accounts",
            "display_name": "Get Warmup Analytics",
            "short_desc": "Get warmup analytics for an account",
            "desc": "Retrieve warmup analytics data for an email account, including reputation scores "
                "and warmup progress.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetWarmupAnalyticsDataProvider::ProviderInfo,
            "output_type": InstantlyGetWarmupAnalyticsDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetWarmupAnalyticsRequestDataType::Fields),
        });

        # Get Custom Tracking Domain Status
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-custom-tracking-domain-status",
            "action": "get-custom-tracking-domain-status",
            "groups": "Accounts",
            "display_name": "Get Custom Tracking Domain Status",
            "short_desc": "Get custom tracking domain status",
            "desc": "Check the status of a custom tracking domain configured for an email account.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetCustomTrackingDomainStatusDataProvider::ProviderInfo,
            "output_type": InstantlyGetCustomTrackingDomainStatusDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetCustomTrackingDomainStatusRequestDataType::Fields),
        });

        # ========== CAMPAIGN ACTIONS ==========

        # List Campaigns
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/campaigns",
            "action": "list-campaigns",
            "groups": "Campaigns",
            "display_name": "List Campaigns",
            "short_desc": "List and search campaigns",
            "desc": "Retrieve a list of campaigns from Instantly with optional filtering by status and name.",
            "action_code": DPAT_FIND,
            "data_provider_info": InstantlyCampaignsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("CampaignList", new InstantlyCampaignDataType(), True);
            },
            "options": {
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum number of results to return",
                    "desc": "The maximum number of results to return per page",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by campaign status",
                    "desc": "Filter campaigns by status: `0` = Draft, `1` = Active, `2` = Paused, "
                        "`3` = Completed, `4` = Running Subsequences",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": 0, "display_name": "Draft"},
                        <AllowedValueInfo>{"value": 1, "display_name": "Active"},
                        <AllowedValueInfo>{"value": 2, "display_name": "Paused"},
                        <AllowedValueInfo>{"value": 3, "display_name": "Completed"},
                        <AllowedValueInfo>{"value": 4, "display_name": "Running Subsequences"},
                    ),
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Filter by campaign name",
                    "desc": "Filter campaigns by name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
            },
        });

        # Create Campaign
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/create-campaign",
            "action": "create-campaign",
            "groups": "Campaigns",
            "display_name": "Create Campaign",
            "short_desc": "Create a new campaign",
            "desc": "Create a new email outreach campaign in Instantly with specified settings and sequences.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyCreateCampaignDataProvider::ProviderInfo,
            "output_type": InstantlyCreateCampaignDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyCreateCampaignRequestDataType::Fields),
        });

        # Get Campaign
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-campaign",
            "action": "get-campaign",
            "groups": "Campaigns",
            "display_name": "Get Campaign",
            "short_desc": "Get a single campaign by ID",
            "desc": "Retrieve detailed information about a specific campaign.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetCampaignDataProvider::ProviderInfo,
            "output_type": InstantlyGetCampaignDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetCampaignRequestDataType::Fields),
        });

        # Patch Campaign
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/patch-campaign",
            "action": "patch-campaign",
            "groups": "Campaigns",
            "display_name": "Patch Campaign",
            "short_desc": "Update an existing campaign",
            "desc": "Update properties of an existing campaign in Instantly.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyPatchCampaignDataProvider::ProviderInfo,
            "output_type": InstantlyPatchCampaignDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyPatchCampaignRequestDataType::Fields),
        });

        # Delete Campaign
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/delete-campaign",
            "action": "delete-campaign",
            "groups": "Campaigns",
            "display_name": "Delete Campaign",
            "short_desc": "Delete a campaign",
            "desc": "Delete a campaign from Instantly. This action cannot be undone.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyDeleteCampaignDataProvider::ProviderInfo,
            "output_type": InstantlyDeleteCampaignDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyDeleteCampaignRequestDataType::Fields),
        });

        # Update Campaign Status
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/update-campaign-status",
            "action": "update-campaign-status",
            "groups": "Campaigns",
            "display_name": "Update Campaign Status",
            "short_desc": "Update campaign status",
            "desc": "Change the status of a campaign (e.g., activate, pause, or complete).",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyUpdateCampaignStatusDataProvider::ProviderInfo,
            "output_type": InstantlyUpdateCampaignStatusDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyUpdateCampaignStatusRequestDataType::Fields),
        });

        # Share Campaign
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/share-campaign",
            "action": "share-campaign",
            "groups": "Campaigns",
            "display_name": "Share Campaign",
            "short_desc": "Share a campaign with team members",
            "desc": "Share a campaign with other workspace members for collaboration.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyShareCampaignDataProvider::ProviderInfo,
            "output_type": InstantlyShareCampaignDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyShareCampaignRequestDataType::Fields),
        });

        # Get Campaign Analytics
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-campaign-analytics",
            "action": "get-campaign-analytics",
            "groups": "Campaigns",
            "display_name": "Get Campaign Analytics",
            "short_desc": "Get analytics for a campaign",
            "desc": "Retrieve analytics data for a specific campaign including open rates, click rates, "
                "and reply rates.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetCampaignAnalyticsDataProvider::ProviderInfo,
            "output_type": InstantlyGetCampaignAnalyticsDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetCampaignAnalyticsRequestDataType::Fields),
        });

        # Get Campaign Analytics Overview
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-campaign-analytics-overview",
            "action": "get-campaign-analytics-overview",
            "groups": "Campaigns",
            "display_name": "Get Campaign Analytics Overview",
            "short_desc": "Get campaign analytics overview",
            "desc": "Retrieve a high-level analytics overview for a campaign.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetCampaignAnalyticsOverviewDataProvider::ProviderInfo,
            "output_type": InstantlyGetCampaignAnalyticsOverviewDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetCampaignAnalyticsOverviewRequestDataType::Fields),
        });

        # Get Campaign Daily Analytics
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-campaign-daily-analytics",
            "action": "get-campaign-daily-analytics",
            "groups": "Campaigns",
            "display_name": "Get Campaign Daily Analytics",
            "short_desc": "Get daily analytics for a campaign",
            "desc": "Retrieve day-by-day analytics data for a specific campaign.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetCampaignDailyAnalyticsDataProvider::ProviderInfo,
            "output_type": InstantlyGetCampaignDailyAnalyticsDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetCampaignDailyAnalyticsRequestDataType::Fields),
        });

        # Get Campaign Step Analytics
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-campaign-step-analytics",
            "action": "get-campaign-step-analytics",
            "groups": "Campaigns",
            "display_name": "Get Campaign Step Analytics",
            "short_desc": "Get step-by-step analytics for a campaign",
            "desc": "Retrieve analytics data broken down by each step in a campaign sequence.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetCampaignStepAnalyticsDataProvider::ProviderInfo,
            "output_type": InstantlyGetCampaignStepAnalyticsDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetCampaignStepAnalyticsRequestDataType::Fields),
        });

        # ========== CAMPAIGN SUBSEQUENCE ACTIONS ==========

        # List Campaign Subsequences
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/campaign-subsequences",
            "action": "list-campaign-subsequences",
            "groups": "Campaign Subsequences",
            "display_name": "List Campaign Subsequences",
            "short_desc": "List and search campaign subsequences",
            "desc": "Retrieve a list of subsequences for a campaign with optional filtering.",
            "action_code": DPAT_FIND,
            "data_provider_info": InstantlyCampaignSubsequencesDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("CampaignSubsequenceList", new InstantlyCampaignSubsequenceDataType(), True);
            },
            "options": {
                "parent_campaign": <ActionOptionInfo>{
                    "display_name": "Parent Campaign",
                    "short_desc": "Filter by parent campaign UUID",
                    "desc": "The parent campaign UUID to list subsequences for (required)",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "campaigns",
                },
                "search": <ActionOptionInfo>{
                    "display_name": "Search",
                    "short_desc": "Search subsequences",
                    "desc": "Filter subsequences by search query",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum number of results to return",
                    "desc": "The maximum number of results to return per page",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # Create Campaign Subsequence
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/create-campaign-subsequence",
            "action": "create-campaign-subsequence",
            "groups": "Campaign Subsequences",
            "display_name": "Create Campaign Subsequence",
            "short_desc": "Create a new campaign subsequence",
            "desc": "Create a new subsequence within an existing campaign.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyCreateCampaignSubsequenceDataProvider::ProviderInfo,
            "output_type": InstantlyCreateCampaignSubsequenceDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyCreateCampaignSubsequenceRequestDataType::Fields),
        });

        # Get Campaign Subsequence
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/get-campaign-subsequence",
            "action": "get-campaign-subsequence",
            "groups": "Campaign Subsequences",
            "display_name": "Get Campaign Subsequence",
            "short_desc": "Get a single campaign subsequence by ID",
            "desc": "Retrieve detailed information about a specific campaign subsequence.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyGetCampaignSubsequenceDataProvider::ProviderInfo,
            "output_type": InstantlyGetCampaignSubsequenceDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyGetCampaignSubsequenceRequestDataType::Fields),
        });

        # Patch Campaign Subsequence
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/patch-campaign-subsequence",
            "action": "patch-campaign-subsequence",
            "groups": "Campaign Subsequences",
            "display_name": "Patch Campaign Subsequence",
            "short_desc": "Update an existing campaign subsequence",
            "desc": "Update properties of an existing campaign subsequence.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyPatchCampaignSubsequenceDataProvider::ProviderInfo,
            "output_type": InstantlyPatchCampaignSubsequenceDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyPatchCampaignSubsequenceRequestDataType::Fields),
        });

        # Delete Campaign Subsequence
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/delete-campaign-subsequence",
            "action": "delete-campaign-subsequence",
            "groups": "Campaign Subsequences",
            "display_name": "Delete Campaign Subsequence",
            "short_desc": "Delete a campaign subsequence",
            "desc": "Delete a campaign subsequence. This action cannot be undone.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyDeleteCampaignSubsequenceDataProvider::ProviderInfo,
            "output_type": InstantlyDeleteCampaignSubsequenceDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyDeleteCampaignSubsequenceRequestDataType::Fields),
        });

        # Pause Subsequence
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/pause-subsequence",
            "action": "pause-subsequence",
            "groups": "Campaign Subsequences",
            "display_name": "Pause Subsequence",
            "short_desc": "Pause a campaign subsequence",
            "desc": "Pause a running campaign subsequence to temporarily stop its execution.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyPauseCampaignSubsequenceDataProvider::ProviderInfo,
            "output_type": InstantlyPauseCampaignSubsequenceDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyPauseCampaignSubsequenceRequestDataType::Fields),
        });

        # Resume Subsequence
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
            "path": "/resume-subsequence",
            "action": "resume-subsequence",
            "groups": "Campaign Subsequences",
            "display_name": "Resume Subsequence",
            "short_desc": "Resume a paused subsequence",
            "desc": "Resume a paused campaign subsequence to restart its execution.",
            "action_code": DPAT_API,
            "data_provider_info": InstantlyResumeCampaignSubsequenceDataProvider::ProviderInfo,
            "output_type": InstantlyResumeCampaignSubsequenceDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(InstantlyResumeCampaignSubsequenceRequestDataType::Fields),
        });

        # Duplicate Subsequence
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": InstantlyDataProvider::AppName,
