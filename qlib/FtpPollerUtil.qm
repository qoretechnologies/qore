%modern

# make sure we have the required qore version
%requires qore >= 1.0
%requires DataProvider

module FtpPollerUtil {
    version = "1.0";
    desc = "user module providing definitions for the FtpPoller module";
    author = "Alzhan Turlybekov <alzhan.turlybekov@qoretechnologies.com>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the event data type
        DataProvider::registerType("qore/ftp/event", FtpPollerFileEventInfoDataType);
    };
}

/*  Version History
    * 2019-10-16 v1.0: Alzhan Turlybekov <alzhan.turlybekov@qoretechnologies.com>
*/

/** @mainpage FtpPollerUtil Module

    @section ftppollerutilintro Introduction to the FtpPollerUtil Module

    The FtpPollerUtil module defines types for the \c FtpPoller module.

    @section ftppollerutilrelnotes FtpPollerUtil Module Release Notes

    @section ftppollerutilv1_0 Version 1.0
    - initial release
*/

#! main FtpPoller namespace
public namespace FtpPoller {
#! Single file event data description
public class FtpPollerFileEventInfoDataType inherits HashDataType {
    public {
        #! Markdown descriptions for hashdecl members
        const Fields = {
            "name": {
                "display_name": "Name",
                "short_desc": "The name of the file, link, or directory",
                "desc": "The name of the file, link, or directory",
                "example_value": "example-file.txt",
            },
            "size":  {
                "display_name": "Size",
                "short_desc": "The size of the file in bytes",
                "desc": "The size of the file in bytes",
                "example_value": 915,
            },
            "mtime":  {
                "display_name": "Modified Timestamp",
                "short_desc": "The last modified date/time of the file",
                "desc": "The last modified date/time of the file",
            },
            "data":  {
                "display_name": "File Data",
                "short_desc": "The file data if present and applicable",
                "desc": "The file's data if `local_dir` is not set; this will be a string unless the `binary` option is "
                  "set to `True`, in which case this key is assigned to the file's binary data; when `local_dir` is "
                    "set, file data is not included in the event but is rather transferred to the local directory",
            },
            "filepath":  {
                "display_name": "File Path",
                "short_desc": "The remote filepath relative to the remote root directory",
                "desc": "The remote filepath relative to the remote root directory",
                "example_value": "./example-file.txt",
            },
            "transfer_time":  {
                "display_name": "Transfer Time",
                "short_desc": "The relative date/time value giving the time taken to transfer the file",
                "desc": "The relative date/time value giving the time taken to transfer the file",
                "example_value": 0.154947s,
            },
            "local_path":  {
                "display_name": "Local Path",
                "short_desc": "The target path for the file if applicable",
                "desc": "Only included when `local_dir` is set; the target path for the file where the file will "
                    "be moved to in the post event action",
            },
            "remote_status":  {
                "display_name": "Remote Status",
                "short_desc": "The status of the remote file after processing",
                "desc": "The status of the remote file after processing",
                "allowed_values": (
                    <AllowedValueInfo>{
                        "display_name": RS_DELETED,
                        "short_desc": "The remote file was deleted",
                        "desc": "The remote file was deleted",
                        "value": RS_DELETED,
                    },
                    <AllowedValueInfo>{
                        "display_name": RS_MOVED,
                        "short_desc": "The remote file was moved",
                        "desc": "The remote file was moved",
                        "value": RS_MOVED,
                    },
                    <AllowedValueInfo>{
                        "display_name": RS_NONE,
                        "short_desc": "The remote file was not moved or deleted",
                        "desc": "The remote file was not moved or deleted",
                        "value": RS_NONE,
                    },
                ),
            },
        };
    }

    #! Creates the type
    constructor() {
        addQoreFields(map {$1.getName(): Fields{$1.getName()} + {
            "type": $1.getType(),
        }}, TypedHash::forName("FtpPoller::FtpPollerFileEventInfo").getMembers());
    }

    #! Returns the description
    string getDesc() {
        return "FTP polling event data type";
    }
}

/** @defgroup ftp_remote_status_constants FTP Remote Status Constants
*/
#/@{
#! remote status: deleted
public const RS_DELETED = "DELETED";

#! remote status: moved
public const RS_MOVED = "MOVED";

#! remote status: none
public const RS_NONE = "NONE";
#/@}

#! Constant providing the single file event data type
public const FtpPollerFileEventInfoDataType = new FtpPollerFileEventInfoDataType();

#! FtpPoller file event hash
public hashdecl FtpPollerFileEventInfo {
    #! The name of the file, link, or directory
    string name;

    #! The size of the file in bytes
    int size;

    #! The last modified date/time of the file
    date mtime;

    #! The file's data
    /** this will be a string unless the \a "binary" option is set to @ref Qore::True "True", in which case this
        key is assigned to the file's binary data
    */
    data data;

    #! The remote filepath relative to the FTP root directory
    string filepath;

    #! The relative date/time value giving the time taken to transfer the file
    date transfer_time;

    #! Only included when `local_dir` is set; the target path for the file
    *string local_path;

    #! Remote status; one of @ref ftp_remote_status_constants
    string remote_status;
}
}
