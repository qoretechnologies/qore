# minimum required Qore version
%requires qore >= 2.0

%modern

%requires Util

module SshCredentialProvider {
    version = "1.0";
    desc    = "API for pluggable SSH credential and host-key trust providers";
    author  = "David Nichols <david.nichols@qoretechnologies.com>";
    url     = "http://qore.org";
    license = "MIT";
}

/** @mainpage SshCredentialProvider Module

    @tableofcontents

    @section sshcredentialproviderintro SshCredentialProvider Module Introduction

    The %SshCredentialProvider module defines a generic Qore contract for SSH client identity providers,
    SSH server host-key providers, and SSH remote host-key trust stores.  The contract is intentionally
    expressed only in SSH terms and contains no application-specific storage or policy assumptions.

    @section sshcredentialproviderrelnotes Release Notes

    @subsection sshcredentialprovider100 SshCredentialProvider 1.0
    - initial provider contract with typed hashes, string-backed enums, abstract provider classes,
      host normalization helpers, descriptor-only filesystem/agent providers, and a thread-safe registry
*/

#! Contains all public declarations in the SshCredentialProvider module.
public namespace SshCredentialProvider {
#! Host-key decision values.
public enum SshHostKeyDecision : string {
    #! The observed host key matched an existing trusted record.
    Matched = "matched",
    #! Persistent TOFU accepted and durably stored the observed host key.
    Added = "added",
    #! Explicit session-only TOFU accepted the key without durable persistence.
    AcceptedSession = "accepted-session",
    #! No trusted record matched the observed host key.
    Unknown = "unknown",
    #! A trusted record exists for the host, but the observed key is different.
    Mismatch = "mismatch",
    #! The observed host key matched a revoked key.
    Revoked = "revoked",
    #! The backing host-key store failed.
    StoreError = "store-error",
    #! A provider/store returned a malformed response.
    InvalidResponse = "invalid-response",
    #! A provider callback failed.
    ProviderError = "provider-error",
    #! Verification or persistence exceeded the operation deadline.
    Timeout = "timeout",
}

#! Client authentication ordering.
public enum SshClientAuthOrder : string {
    #! Explicit caller keys are tried before provider candidates.
    ExplicitFirst = "explicit-first",
    #! Provider candidates are tried before explicit caller keys.
    ProviderFirst = "provider-first",
}

#! Process-user credential fallback policy used when a client identity provider is configured.
public enum SshClientIdentityFallbackPolicy : string {
    #! Do not use process-user SSH agent or default key discovery.
    Disabled = "disabled",
    #! Allow process-user SSH agent fallback.
    Agent = "agent",
    #! Allow process-user default key discovery fallback.
    DefaultKeys = "default-keys",
    #! Allow process-user SSH agent and default key discovery fallback.
    AgentAndDefaultKeys = "agent-and-default-keys",
}

#! Provider callback purpose values.
public enum SshProviderPurpose : string {
    #! Client identity candidate lookup or secret retrieval.
    ClientIdentity = "client-identity",
    #! Server host-key lookup or secret retrieval.
    ServerHostKey = "server-host-key",
    #! Remote server host-key verification.
    HostKeyVerify = "host-key-verify",
    #! Remote server host-key TOFU acceptance.
    HostKeyAccept = "host-key-accept",
    #! Explicit remote server host-key approval.
    HostKeyApprove = "host-key-approve",
}

#! Client identity candidate kinds.
public enum SshClientIdentityCandidateKind : string {
    #! Process-user SSH agent candidate.
    Agent = "agent",
    #! Filesystem private-key path candidate.
    File = "file",
    #! Provider-backed in-memory key candidate.
    InMemory = "in-memory",
    #! Provider-specific non-secret key reference.
    Reference = "reference",
}

#! Private key material kinds.
public enum SshPrivateKeyMaterialKind : string {
    #! Private key material is available as in-memory text.
    Text = "text",
    #! Private key material is available as in-memory binary data.
    Data = "data",
    #! Private key material is available as a filesystem path.
    File = "file",
    #! Private key material is identified by a non-secret reference.
    Reference = "reference",
}

#! Maps string values to SshHostKeyDecision enum values.
public const SshHostKeyDecisionMap = {
    "matched": SshHostKeyDecision::Matched,
    "added": SshHostKeyDecision::Added,
    "accepted-session": SshHostKeyDecision::AcceptedSession,
    "unknown": SshHostKeyDecision::Unknown,
    "mismatch": SshHostKeyDecision::Mismatch,
    "revoked": SshHostKeyDecision::Revoked,
    "store-error": SshHostKeyDecision::StoreError,
    "invalid-response": SshHostKeyDecision::InvalidResponse,
    "provider-error": SshHostKeyDecision::ProviderError,
    "timeout": SshHostKeyDecision::Timeout,
};

#! Maps host-key decision values to exception suffixes.
public const SshHostKeyDecisionExceptionSuffixMap = {
    SshHostKeyDecision::Unknown: "HOSTKEY-UNKNOWN",
    SshHostKeyDecision::Mismatch: "HOSTKEY-MISMATCH",
    SshHostKeyDecision::Revoked: "HOSTKEY-REVOKED",
    SshHostKeyDecision::StoreError: "HOSTKEY-STORE-ERROR",
    SshHostKeyDecision::InvalidResponse: "HOSTKEY-INVALID-RESPONSE",
    SshHostKeyDecision::ProviderError: "HOSTKEY-PROVIDER-ERROR",
    SshHostKeyDecision::Timeout: "HOSTKEY-TIMEOUT",
};

#! Public key metadata.  No field contains private key data.
public hashdecl SshPublicKeyInfo {
    #! SSH public-key algorithm name.
    string algorithm;

    #! Raw SSH public-key blob when available.
    *binary public_key_blob;

    #! OpenSSH public-key text when available.
    *string openssh_public_key;

    #! SHA256 fingerprint without private key material.
    *string sha256_fingerprint;

    #! Optional SHA1 fingerprint.
    *string sha1_fingerprint;

    #! Optional MD5 fingerprint.
    *string md5_fingerprint;

    #! Optional non-secret comment.
    *string comment;

    #! Generic non-secret source kind such as "file", "agent", "provider", or "transport".
    *string source_kind;

    #! Generic non-secret source identifier, if any.
    *string source_id;
}

#! Client identity candidate descriptor.  This hash never contains private key data or passphrases.
public hashdecl SshClientIdentityCandidate {
    #! Candidate kind.
    enum<SshClientIdentityCandidateKind> kind;

    #! Optional public key information.
    *hash<SshPublicKeyInfo> public_key_info;

    #! Filesystem path, for default filesystem implementations.
    *string path;

    #! Provider-specific non-secret reference.
    *string reference;

    #! Optional algorithm hint.
    *string algorithm_hint;

    #! Non-fatal candidate flag; key retrieval/import failures are otherwise fatal.
    bool optional = False;

    #! Optional non-secret comment.
    *string comment;
}

#! Short-lived private key material returned at point of need.
public hashdecl SshPrivateKeyMaterial {
    #! Material kind.
    enum<SshPrivateKeyMaterialKind> kind;

    #! Private key text, if returned in memory.
    *string private_key_text;

    #! Private key binary data, if returned in memory.
    *binary private_key_data;

    #! Public key text, if returned with the private key.
    *string public_key_text;

    #! Filesystem path, for default filesystem implementations.
    *string path;

    #! Provider-specific non-secret reference.
    *string reference;

    #! Optional passphrase reference.  This is not the passphrase value.
    *string passphrase_ref;

    #! Optional secret reference.  This is not the secret value.
    *string secret_ref;

    #! Optional key format hint.
    *string format;

    #! Optional algorithm hint.
    *string algorithm_hint;

    #! Optional non-secret source kind.
    *string source_kind;
}

#! Host-key trust record descriptor.
public hashdecl SshHostKeyRecord {
    #! Original or pattern host value.
    string host;

    #! SSH port.
    int port;

    #! Normalized host or host pattern, if applicable.
    *string normalized_host;

    #! Trusted public key information.
    hash<SshPublicKeyInfo> key_info;

    #! Optional OpenSSH marker such as "@revoked".
    *string marker;

    #! Optional time when the record was added.
    *date added;

    #! Optional time when the record was updated.
    *date updated;

    #! Optional policy name.
    *string policy;

    #! Optional non-secret comment.
    *string comment;
}

#! Structured host-key decision info suitable for exception payloads and audit.
public hashdecl SshHostKeyDecisionInfo {
    #! Host-key decision.
    enum<SshHostKeyDecision> decision;

    #! Observed server public key.
    hash<SshPublicKeyInfo> observed_key;

    #! Matched trusted record, if any.
    *hash<SshHostKeyRecord> matched_record;

    #! Non-secret diagnostic string.
    *string diagnostic;

    #! Non-secret provider/store diagnostic code.
    *string diagnostic_code;
}

#! Generic provider ctxt.  Application-specific data belongs only in opaque_context.
public hashdecl SshProviderContext {
    #! Provider callback purpose.
    enum<SshProviderPurpose> purpose;

    #! Optional connection name.
    *string connection_name;

    #! Optional listener name.
    *string listener_name;

    #! Original logical host supplied by the caller.
    *string original_host;

    #! Normalized logical host.
    *string normalized_host;

    #! SSH port.
    *int port;

    #! SSH username.
    *string username;

    #! Host-key policy name.
    *string host_key_policy;

    #! Client authentication ordering policy.
    *enum<SshClientAuthOrder> client_auth_order;

    #! Client identity fallback policy.
    *enum<SshClientIdentityFallbackPolicy> client_identity_fallback_policy;

    #! Absolute monotonic deadline in clock_getnanos() nanoseconds.
    int deadline_ns;

    #! Remaining operation budget in nanoseconds, recomputed per callback.
    int remaining_ns;

    #! Opaque application ctxt.  Generic modules must not inspect, persist, branch on, or log it.
    *hash<auto> opaque_context;
}

#! Provider/store set used by higher-level connection code as an aggregate convenience only.
public hashdecl SshProviderSet {
    #! Client identity provider object.
    *AbstractSshClientIdentityProvider client_identity_provider;

    #! Client identity provider registry name.
    *string client_identity_provider_name;

    #! Server host-key provider object.
    *AbstractSshServerHostKeyProvider server_host_key_provider;

    #! Server host-key provider registry name.
    *string server_host_key_provider_name;

    #! Host-key store object.
    *AbstractSshHostKeyStore host_key_store;

    #! Host-key store registry name.
    *string host_key_store_name;
}

#! Normalizes a logical SSH host according to the v1 OpenSSH-compatible baseline.
/** The function strips at most one trailing root dot and lowercases ASCII A-Z only.  Non-ASCII
    bytes are preserved verbatim; no IDNA or punycode conversion is performed.
*/
public string sub normalize_ssh_host(string host) {
    host =~ s/\.$//;

    for (int i = 0; i < 26; ++i) {
        host = replace(host, chr(65 + i), chr(97 + i));
    }
    return host;
}

#! Formats a logical host and port for OpenSSH known_hosts host matching.
/** Port 22 with a non-IPv6 host is returned as the normalized host.  Non-default ports and IPv6
    literals are returned in \c "[host]:port" form.
*/
public string sub format_known_hosts_host(string host, int port = 22) {
    host = normalize_ssh_host(host);
    if (port == 22 && host.find(":") == -1) {
        return host;
    }
    return sprintf("[%s]:%d", host, port);
}

#! Returns the stable exception name for a non-success host-key decision.
/** @return an exception name such as \c "SSH2-HOSTKEY-UNKNOWN", or @ref nothing for success decisions
*/
public *string sub get_host_key_decision_exception_name(enum<SshHostKeyDecision> decision, string prefix = "SSH2") {
    *string suffix = SshHostKeyDecisionExceptionSuffixMap{decision};
    return suffix ? sprintf("%s-%s", prefix, suffix) : NOTHING;
}

hash<SshProviderContext> sub coerce_provider_context(hash<auto> ctxt) {
    if (ctxt{"purpose"}.type() == Type::String) {
        ctxt{"purpose"} = cast<enum<SshProviderPurpose>>(ctxt{"purpose"});
    }
    if (ctxt{"client_auth_order"}.type() == Type::String) {
        ctxt{"client_auth_order"} = cast<enum<SshClientAuthOrder>>(ctxt{"client_auth_order"});
    }
    if (ctxt{"client_identity_fallback_policy"}.type() == Type::String) {
        ctxt{"client_identity_fallback_policy"} =
            cast<enum<SshClientIdentityFallbackPolicy>>(ctxt{"client_identity_fallback_policy"});
    }
    return cast<hash<SshProviderContext>>(ctxt);
}

hash<SshClientIdentityCandidate> sub coerce_client_identity_candidate(hash<auto> candidate) {
    if (candidate{"kind"}.type() == Type::String) {
        candidate{"kind"} = cast<enum<SshClientIdentityCandidateKind>>(candidate{"kind"});
    }
    return cast<hash<SshClientIdentityCandidate>>(candidate);
}

hash<SshPrivateKeyMaterial> sub coerce_private_key_material(hash<auto> material) {
    if (material{"kind"}.type() == Type::String) {
        material{"kind"} = cast<enum<SshPrivateKeyMaterialKind>>(material{"kind"});
    }
    return cast<hash<SshPrivateKeyMaterial>>(material);
}

hash<SshHostKeyDecisionInfo> sub coerce_host_key_decision_info(hash<auto> decision) {
    if (decision{"decision"}.type() == Type::String) {
        decision{"decision"} = cast<enum<SshHostKeyDecision>>(decision{"decision"});
    }
    return cast<hash<SshHostKeyDecisionInfo>>(decision);
}

#! Abstract client identity provider.
public class AbstractSshClientIdentityProvider {
    #! Returns ordered client authentication candidates for the given ctxt.
    /** Binary modules pass generic hashes at the Qore boundary; this wrapper validates and narrows
        them to the typed provider vocabulary before dispatching to the implementation hook.
    */
    list<hash<SshClientIdentityCandidate>> getClientIdentityCandidates(hash<auto> ctxt) {
        return getClientIdentityCandidatesImpl(coerce_provider_context(ctxt));
    }

    #! Returns short-lived private key material for a candidate at point of need.
    *hash<SshPrivateKeyMaterial> getPrivateKeyMaterial(hash<auto> ctxt, hash<auto> candidate) {
        *hash<auto> material = getPrivateKeyMaterialImpl(coerce_provider_context(ctxt),
            coerce_client_identity_candidate(candidate));
        return material ? coerce_private_key_material(material) : NOTHING;
    }

    private abstract list<hash<SshClientIdentityCandidate>> getClientIdentityCandidatesImpl(
        hash<SshProviderContext> ctxt);

    private *hash<SshPrivateKeyMaterial> getPrivateKeyMaterialImpl(hash<SshProviderContext> ctxt,
            hash<SshClientIdentityCandidate> candidate) {
        return NOTHING;
    }
}

#! Abstract server host-key provider.
public class AbstractSshServerHostKeyProvider {
    #! Returns ordered server host-key material descriptors for a listener.
    list<hash<SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        return map coerce_private_key_material($1), getServerHostKeyMaterialImpl(coerce_provider_context(ctxt));
    }

    private abstract list<hash<SshPrivateKeyMaterial>> getServerHostKeyMaterialImpl(hash<SshProviderContext> ctxt);
}

#! Abstract remote host-key trust store.
public class AbstractSshHostKeyStore {
    #! Verifies an observed remote server host key.
    hash<SshHostKeyDecisionInfo> verifyHostKey(hash<auto> ctxt, hash<auto> observed_key) {
        return coerce_host_key_decision_info(verifyHostKeyImpl(coerce_provider_context(ctxt),
            cast<hash<SshPublicKeyInfo>>(observed_key)));
    }

    #! Atomically accepts an observed remote server host key only if no record exists.
    hash<SshHostKeyDecisionInfo> acceptHostKeyIfAbsent(hash<auto> ctxt, hash<auto> observed_key) {
        return coerce_host_key_decision_info(acceptHostKeyIfAbsentImpl(coerce_provider_context(ctxt),
            cast<hash<SshPublicKeyInfo>>(observed_key)));
    }

    #! Explicit manual approval operation with compare-and-set semantics.
    hash<SshHostKeyDecisionInfo> approveHostKey(hash<auto> ctxt, hash<auto> expected_observed_key,
            hash<auto> record) {
        return coerce_host_key_decision_info(approveHostKeyImpl(coerce_provider_context(ctxt),
            cast<hash<SshPublicKeyInfo>>(expected_observed_key), cast<hash<SshHostKeyRecord>>(record)));
    }

    private abstract hash<SshHostKeyDecisionInfo> verifyHostKeyImpl(hash<SshProviderContext> ctxt,
        hash<SshPublicKeyInfo> observed_key);

    private abstract hash<SshHostKeyDecisionInfo> acceptHostKeyIfAbsentImpl(hash<SshProviderContext> ctxt,
        hash<SshPublicKeyInfo> observed_key);

    private abstract hash<SshHostKeyDecisionInfo> approveHostKeyImpl(hash<SshProviderContext> ctxt,
        hash<SshPublicKeyInfo> expected_observed_key, hash<SshHostKeyRecord> record);
}

#! Descriptor-only default client identity provider for filesystem keys and SSH agent fallback.
public class FilesystemSshClientIdentityProvider inherits AbstractSshClientIdentityProvider {
    private {
        list<string> key_paths;
        bool agent;
        bool optional;
    }

    #! Creates the provider.
    /** @param key_paths private-key paths to expose as ordered filesystem candidates
        @param agent include an SSH agent candidate before file candidates
        @param optional mark returned candidates optional
    */
    constructor(*list<string> key_paths = NOTHING, bool agent = False, bool optional = False) {
        self.key_paths = key_paths ?? ();
        self.agent = agent;
        self.optional = optional;
    }

    private list<hash<SshClientIdentityCandidate>> getClientIdentityCandidatesImpl(hash<SshProviderContext> ctxt) {
        list<hash<SshClientIdentityCandidate>> rv = ();
        if (agent) {
            rv += <SshClientIdentityCandidate>{
                "kind": SshClientIdentityCandidateKind::Agent,
                "optional": optional,
                "comment": "ssh-agent",
            };
        }
        foreach string path in (key_paths) {
            rv += <SshClientIdentityCandidate>{
                "kind": SshClientIdentityCandidateKind::File,
                "path": path,
                "optional": optional,
            };
        }
        return rv;
    }
}

#! Descriptor-only default server host-key provider preserving filesystem path behavior.
public class FilesystemSshServerHostKeyProvider inherits AbstractSshServerHostKeyProvider {
    private {
        list<string> key_paths;
        *string passphrase_ref;
    }

    #! Creates the provider.
    /** @param key_paths private-key paths to expose as ordered server host-key material descriptors
        @param passphrase_ref optional non-secret passphrase reference for encrypted keys
    */
    constructor(list<string> key_paths, *string passphrase_ref = NOTHING) {
        self.key_paths = key_paths;
        self.passphrase_ref = passphrase_ref;
    }

    private list<hash<SshPrivateKeyMaterial>> getServerHostKeyMaterialImpl(hash<SshProviderContext> ctxt) {
        return map <SshPrivateKeyMaterial>{
            "kind": SshPrivateKeyMaterialKind::File,
            "path": $1,
            "passphrase_ref": passphrase_ref,
            "source_kind": "file",
        }, key_paths;
    }
}

#! Thread-safe registry for provider/store objects.
public class SshCredentialProviderRegistry {
    private {
        static Mutex lck();
        static hash<string, AbstractSshClientIdentityProvider> client_identity_providers;
        static hash<string, AbstractSshServerHostKeyProvider> server_host_key_providers;
        static hash<string, AbstractSshHostKeyStore> host_key_stores;
    }

    private static checkName(string name) {
        if (!name || name =~ /\s/) {
            throw "SSH-CREDENTIAL-PROVIDER-REGISTRY-ERROR",
                sprintf("invalid provider/store registry name: %y", name);
        }
    }

    #! Registers a client identity provider.
    static registerClientIdentityProvider(string name, AbstractSshClientIdentityProvider provider,
            bool replace = False) {
        checkName(name);
        lck.lock();
        on_exit lck.unlock();
        if (client_identity_providers{name} && !replace) {
            throw "SSH-CREDENTIAL-PROVIDER-REGISTRY-ERROR",
                sprintf("client identity provider %y is already registered", name);
        }
        client_identity_providers{name} = provider;
    }

    #! Deregisters a client identity provider.
    static *AbstractSshClientIdentityProvider deregisterClientIdentityProvider(string name) {
        lck.lock();
        on_exit lck.unlock();
        return remove client_identity_providers{name};
    }

    #! Returns a client identity provider by registry name.
    static *AbstractSshClientIdentityProvider getClientIdentityProvider(string name) {
        lck.lock();
        on_exit lck.unlock();
        return client_identity_providers{name};
    }

    #! Returns the registered client identity provider names.
    static list<string> listClientIdentityProviders() {
        lck.lock();
        on_exit lck.unlock();
        return sort(keys client_identity_providers);
    }

    #! Registers a server host-key provider.
    static registerServerHostKeyProvider(string name, AbstractSshServerHostKeyProvider provider,
            bool replace = False) {
        checkName(name);
        lck.lock();
        on_exit lck.unlock();
        if (server_host_key_providers{name} && !replace) {
            throw "SSH-CREDENTIAL-PROVIDER-REGISTRY-ERROR",
                sprintf("server host-key provider %y is already registered", name);
        }
        server_host_key_providers{name} = provider;
    }

    #! Deregisters a server host-key provider.
    static *AbstractSshServerHostKeyProvider deregisterServerHostKeyProvider(string name) {
        lck.lock();
        on_exit lck.unlock();
        return remove server_host_key_providers{name};
    }

    #! Returns a server host-key provider by registry name.
    static *AbstractSshServerHostKeyProvider getServerHostKeyProvider(string name) {
        lck.lock();
        on_exit lck.unlock();
        return server_host_key_providers{name};
    }

    #! Returns the registered server host-key provider names.
    static list<string> listServerHostKeyProviders() {
        lck.lock();
        on_exit lck.unlock();
        return sort(keys server_host_key_providers);
    }

    #! Registers a host-key store.
    static registerHostKeyStore(string name, AbstractSshHostKeyStore store, bool replace = False) {
        checkName(name);
        lck.lock();
        on_exit lck.unlock();
        if (host_key_stores{name} && !replace) {
            throw "SSH-CREDENTIAL-PROVIDER-REGISTRY-ERROR",
                sprintf("host-key store %y is already registered", name);
        }
        host_key_stores{name} = store;
    }

    #! Deregisters a host-key store.
    static *AbstractSshHostKeyStore deregisterHostKeyStore(string name) {
        lck.lock();
        on_exit lck.unlock();
        return remove host_key_stores{name};
    }

    #! Returns a host-key store by registry name.
    static *AbstractSshHostKeyStore getHostKeyStore(string name) {
        lck.lock();
        on_exit lck.unlock();
        return host_key_stores{name};
    }

    #! Returns the registered host-key store names.
    static list<string> listHostKeyStores() {
        lck.lock();
        on_exit lck.unlock();
        return sort(keys host_key_stores);
    }
}
} # SshCredentialProvider namespace
