# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%try-module yaml
%define NoYaml
%endtry

%requires(reexport) ProviderIndexUtil >= 1.2
%requires DataProvider >= 3.8
%requires ConnectionProvider
%requires reflection

module ProviderIndex {
    version = "1.2";
    desc = "user module for indexing data providers";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage ProviderIndex Module

    @tableofcontents

    @section providerindexintro Introduction to the ProviderIndex Module

    The %ProviderIndex module providers APIs to index data providers, so that they can support
    on-demand initialization.

    @section providerindex_relnotes Release Notes

    @subsection providerindex_v1_2 ProviderIndex v1.2
    - each action option's type is published as its complete plain-data description in \c type_info, including
      nested fields, unions, allowed values, and tags, so that reading the index never loads the provider modules
      that define the types
    - output types are not indexed, since no index consumer uses them
    - an option type whose description does not restore an equivalent type is reported in the
      \c type_info_mismatches key of the index summary
    - action metadata that is not plain data blocks publication with structured action evidence
    - indexes written by this version require ProviderIndexUtil 1.2 or later

    @subsection providerindex_v1_1 ProviderIndex v1.1
    - rebuilding an existing index now includes provider inventories introduced during deferred initialization,
      without incorrectly rejecting the rebuild as stale; inventory changes during qualification still block
      publication and preserve the previous index
    - index dependencies now use exact registered module names rather than source or compiled artifact paths,
      so installing an equivalent compiled module does not change its dependency identity
    - explicit seeded paths are resolved against loaded module metadata; unresolved paths fail before publication
    - authoritative index publication now requires a complete generation-scoped DataProvider discovery report and a
      current single-use qualification token; requested factory, environment, TypeScript, scheme, module-path, and
      expected-inventory failures remain structured and leave the previous index untouched

    @subsection providerindex_v1_0 ProviderIndex v1.0
    - initial release of the module
    - added @ref ProviderIndex::ProviderIndexCreateOptions "ProviderIndexCreateOptions" to allow callers to
      create scoped, deterministic indices without loading external provider discovery sources
*/

#! contains all public definitions in the ProviderIndex module
public namespace ProviderIndex {
}
