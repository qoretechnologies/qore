# minimum required Qore version
%requires qore >= 1.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings
# allow the use of the weak reference assignment operator: ':='
%allow-weak-references

%requires(reexport) DataProvider
%requires(reexport) RestSchemaValidator
%requires(reexport) RestClient
%requires(reexport) Swagger
%requires(reexport) OpenApi3

module RestSchemaDataProvider {
    version = "2.3";
    desc = "user module providing a data provider API for REST schemas (Swagger 2.0 and OpenAPI 3.0)";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factory
        DataProvider::registerFactory(new RestSchemaDataProviderFactory());
    };
}

/** @mainpage RestSchemaDataProvider Module

    @tableofcontents

    @section restschemadataproviderintro Introduction to the RestSchemaDataProvider Module

    The %RestSchemaDataProvider module provides a \c dataproviderintro "data provider" API for REST schemas
    including both Swagger 2.0 and OpenAPI 3.0 schemas.

    The @ref RestSchemaDataProvider::RestSchemaDataProvider "RestSchemaDataProvider" class allows for introspecting
    REST schemas, while the @ref RestSchemaDataProvider::RestSchemaRequestDataProvider "RestSchemaRequestDataProvider"
    class supports the \c dataproviderintro "data provider" request-reply API for communication with REST servers.

    REST schema paths can be introspected with the following format:
    - REST operation path: <tt><i>uri_path</i>/<i>HTTP_method</i></tt>
      - ex: <tt><b>pet/PUT</b></tt>
      - results in a
        @ref RestSchemaDataProvider::RestSchemaRequestDataProvider "RestSchemaRequestDataProvider" object where the
        request and response messages can be queried and requests can be sent to the server

    The following classes are provided by this module:
    - @ref RestSchemaDataProvider::RestSchemaDataProvider "RestSchemaDataProvider"
    - @ref RestSchemaDataProvider::RestSchemaDataProviderBase "RestSchemaDataProviderBase"
    - @ref RestSchemaDataProvider::RestSchemaDataProviderFactory "RestSchemaDataProviderFactory"
    - @ref RestSchemaDataProvider::RestSchemaRequestDataProvider "RestSchemaRequestDataProvider"

    @section restschemamdataprovider_relnotes Release Notes

    @subsection restschemamdataprovider_v2_3 RestSchemaDataProvider v2.3
    - initial release of the module supporting both Swagger 2.0 and OpenAPI 3.0 schemas
    - uses abstract base classes from RestSchemaValidator module for polymorphic access to
      operation and path item objects
      (<a href="https://github.com/qorelanguage/qore/issues/5006">issue 5006</a>)
*/

#! contains all public definitions in the RestSchemaDataProvider module
public namespace RestSchemaDataProvider {
}
