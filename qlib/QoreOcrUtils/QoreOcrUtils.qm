# minimum required Qore version
%requires qore >= 2.0
%modern

%try-module ocr
%define NoOcr
%endtry

%try-module RestClient
%define NoRestClient
%endtry

%try-module json
%define NoJson
%endtry

module QoreOcrUtils {
    version = "1.0.0";
    desc = "user module providing an OCR abstraction layer with native "
        "(Tesseract) and HTTP backends, plus scanned PDF detection";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreOcrUtils Module

    @tableofcontents

    @section qoreocrutilsintro QoreOcrUtils Module Introduction

    The %QoreOcrUtils module provides an OCR abstraction layer supporting
    two backends:
    - \b native: Uses the \c ocr binary module (Tesseract) for local OCR
    - \b http: Calls an HTTP OCR endpoint for remote OCR processing

    Also includes @ref QoreOcrUtils::ScannedPdfDetector "ScannedPdfDetector"
    for heuristic detection of scanned (image-based) PDF pages.

    @par Example: OCR with native backend
    @code{.py}
%requires QoreOcrUtils
%modern

OcrEngine engine(<OcrConfig>{"mode": "native", "language": "eng"});
binary img = ReadOnlyFile::readBinaryFile("document.png");
hash<OcrResult> result = engine.extractText(img);
printf("Text: %s (confidence: %.0f%%)\n", result.text, result.confidence * 100);
    @endcode

    @section qoreocrutilsrelnotes QoreOcrUtils Module Release Notes

    @subsection qoreocrutilsrelnotes_1_0 QoreOcrUtils Module Version 1.0
    - Initial release with @ref QoreOcrUtils::OcrEngine "OcrEngine" (native + HTTP)
      and @ref QoreOcrUtils::ScannedPdfDetector "ScannedPdfDetector"
*/
