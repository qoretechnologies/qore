%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) DeepgramRestClient
%requires RestClientIo

module DeepgramDataProvider {
    version = "1.1";
    desc = "user module providing a data provider API for Deepgram speech services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new DeepgramDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": DeepgramDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Deepgram",
            "short_desc": "Deepgram speech (ASR + TTS) services",
            "desc": "Provides access to [Deepgram](https://deepgram.com) — a "
                "speech AI platform offering automatic speech recognition (ASR) "
                "and text-to-speech (TTS) APIs.\n\n"
                "**Common use cases**:\n"
                "- **Transcription**: convert recorded audio (PSTN calls, meeting "
                "recordings, podcasts) into searchable text with the Nova model "
                "family\n"
                "- **Voice synthesis**: generate natural-sounding speech from "
                "text via the Aura voice models — for voice agents, IVR, and "
                "accessibility\n"
                "- **Conversational AI**: pair Deepgram TTS with any LLM to "
                "build end-to-end voice conversation pipelines",
            "scheme": "deepgram",
            "logo": DeepgramLogo,
            "logo_file_name": "deepgram-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (
                DataProvider::AppGroup::AiLlm,
                DataProvider::AppGroup::Speech,
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeepgramDataProvider::AppName,
            "path": "/transcribe-file",
            "action": "transcribe-file",
            "display_name": "Transcribe File",
            "short_desc": "Transcribe an audio file by URL or upload via Deepgram ASR",
            "desc": "Submits audio to Deepgram's `/v1/listen` endpoint and returns the "
                "JSON transcript.  The audio is given either as a public `url` that "
                "Deepgram fetches or as an `audio` file whose bytes are uploaded as "
                "the request body; exactly one of the two must be provided.  Supports "
                "the Nova model family with smart formatting, diarization, "
                "summarization, and language detection.",
            "action_code": DPAT_API,
            "groups": ("Speech Recognition",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                DeepgramTranscribeFileRequestDataType::Fields{
                    "url", "audio", "model", "language", "smart_format", "diarize",
                }, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                DeepgramTranscribeFileRequestDataType::Fields - (
                    "url", "audio", "model", "language", "smart_format", "diarize",
                )
            ),
            "output_type": DeepgramTranscribeFileDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeepgramDataProvider::AppName,
            "path": "/synthesize-speech",
            "action": "synthesize-speech",
            "display_name": "Synthesize Speech",
            "short_desc": "Synthesize speech from text via Deepgram TTS (Aura models)",
            "desc": "Posts text to Deepgram's `/v1/speak` endpoint and returns the "
                "audio bytes in the requested encoding.  Uses the Aura voice model "
                "family (12+ voices in English plus other languages).",
            "action_code": DPAT_API,
            "groups": ("Speech Synthesis",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                DeepgramSynthesizeSpeechRequestDataType::Fields{"text",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                DeepgramSynthesizeSpeechRequestDataType::Fields{
                    "model", "encoding",
                }, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                DeepgramSynthesizeSpeechRequestDataType::Fields - (
                    "text", "model", "encoding",
                )
            ),
            "output_type": DeepgramSynthesizeSpeechDataProvider::ResponseType,
        });
    };
}

/** @mainpage DeepgramDataProvider Module

    @tableofcontents

    @section deepgramdataproviderintro DeepgramDataProvider Introduction

    The %DeepgramDataProvider module provides a data provider API for
    [Deepgram](https://deepgram.com) speech services.

    Two DPAT_API actions are registered:
    - `transcribe-file` — submit an audio URL, or upload the audio bytes
      directly, to `/v1/listen` and receive a JSON transcript (Nova model
      family, smart format, diarization, summarization, language detection)
    - `synthesize-speech` — submit text to `/v1/speak` and receive audio
      bytes (Aura voice models, MP3/WAV/Opus/FLAC encodings)

    @par WebSocket streaming

    Deepgram's realtime streaming endpoints (live transcription and live
    TTS) are not exposed via this data provider; they require WebSocket
    connectivity rather than request/response REST.  See
    @ref deepgramrestclientintro "DeepgramRestClient" for direct API access.

    @section DeepgramDataProviderRelnotes Release Notes

    @subsection DeepgramDataProviderv1_1 DeepgramDataProvider v1.1
    - the `transcribe-file` action accepts the audio to transcribe as a new
      `audio` input option — a file value (or raw audio bytes) uploaded as the
      request body with its MIME type sent as the `Content-Type` — as an
      alternative to the `url` option, which is now optional; exactly one of
      the two must be given

    @subsection DeepgramDataProviderv1_0 DeepgramDataProvider v1.0
    - the initial version of the %DeepgramDataProvider module
*/

#! contains all public definitions in the DeepgramDataProvider module
public namespace DeepgramDataProvider {
#! Deepgram application name
public const AppName = "Deepgram";
}

#! App logo loaded from file
public const DeepgramLogo = File::readTextFile(get_script_dir() + "/deepgram-logo.svg");
