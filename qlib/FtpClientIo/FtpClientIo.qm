%modern

module FtpClientIo {
    version = "1.0";
    desc = "Async FTP client I/O via poll operations";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Module initialization
    };
}

/** @mainpage FtpClientIo Module

    @tableofcontents

    @section ftpclientiointro Introduction

    The %FtpClientIo module provides async FTP client I/O via poll operations
    suitable for use with the @ref Qore::Thread::AsyncIoController.

    Features:
    - Non-blocking FTP control channel (connect, login, command execution)
    - Non-blocking data channel (PASV/EPSV connect, data transfer)
    - FTPS support (AUTH TLS, encrypted data channel)
    - Composite orchestrator for high-level operations (get, put, list)

    @section ftpclientio_classes Classes

    - @ref FtpClientIo::FtpClientPollOperation "FtpClientPollOperation" — composite
      orchestrator for complete FTP operations (connect + login + data transfer)
*/

public namespace FtpClientIo {

#! FTP data transfer mode
public const FTP_MODE_EPSV = "epsv";
public const FTP_MODE_PASV = "pasv";

#! EPSV response regex: "229 Entering Extended Passive Mode (|||<port>|)"
const EpsvRegex = "\\|\\|\\|(\\d+)\\|";
#! PASV response regex: "227 Entering Passive Mode (h1,h2,h3,h4,p1,p2)"
const PasvRegex = "\\((\\d+),(\\d+),(\\d+),(\\d+),(\\d+),(\\d+)\\)";

} # namespace FtpClientIo
