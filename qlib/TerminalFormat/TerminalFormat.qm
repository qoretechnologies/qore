%requires qore >= 2.0

%modern

%requires Util

module TerminalFormat {
    version = "1.0";
    desc = "user module for rendering markdown and rich text to ANSI terminals";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage TerminalFormat Module

    @tableofcontents

    @section terminalformatintro Introduction to the TerminalFormat Module

    The %TerminalFormat module provides APIs for rendering markdown and rich text
    to ANSI-compatible terminals. It converts standard markdown syntax into
    ANSI escape sequences for bold, italic, color, and structural formatting.

    The main classes provided by this module:
    - @ref TerminalFormat::TerminalMarkdownRenderer "TerminalMarkdownRenderer": converts
      markdown text to ANSI-formatted terminal output
    - @ref TerminalFormat::TerminalTableRenderer "TerminalTableRenderer": formats tabular
      data with Unicode box-drawing characters and column alignment

    @section terminalformatusage Usage

    @code{.py}
    %requires TerminalFormat

    TerminalMarkdownRenderer md();
    string formatted = md.render("# Hello\n\nThis is **bold** and `code`.");
    printf("%s\n", formatted);

    TerminalTableRenderer tbl();
    printf("%s\n", tbl.render(
        ("Name", "Status", "ID"),
        (("svc-1", "loaded", "42"), ("svc-2", "unloaded", "43")),
    ));
    @endcode

    @section terminalformat_relnotes Release Notes

    @subsection terminalformat_v1_0 TerminalFormat v1.0
    - initial release with markdown and table rendering
*/

public namespace TerminalFormat {
}
