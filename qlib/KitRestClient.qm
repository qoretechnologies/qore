# minimum qore version
%requires qore >= 2.0

# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module KitRestClient {
    version = "1.0";
    desc = "User module for calling Kit REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("kitrest", KitRestConnection::ConnectionScheme);
    };
}

/** @mainpage KitRestClient Module

    @tableofcontents

    @section kitrestclientintro KitRestClient Introduction

    The %KitRestClient module provides an API for calling Kit REST API services.

    To use this module, use \c "%requires KitRestClient" in your code.

    All the public symbols in the module are defined in the KitRestClient namespace.

    The main classes are:
    - @ref KitRestClient::KitRestClient "KitRestClient":
      this class provides the REST client API for communication with the Kit API;
      it handles OAuth2 and API key authentication
    - @ref KitRestClient::KitRestConnection "KitRestConnection":
      provides a connection object to Kit services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires KitRestClient

KitRestClient kit({
    "apikey": ENV.KIT_API_KEY,
});
hash<auto> result = kit.get("subscribers?per_page=10");
printf("Subscribers: %y\n", result.body.subscribers);
    @endcode

    @section kitrestclientrelnotes Release Notes

    @subsection kitrestclientv1_0 KitRestClient v1.0
    - the initial version of the %KitRestClient module
*/

#! the KitRestClient namespace contains all the objects in the KitRestClient module
public namespace KitRestClient {

#! This class provides the REST client API for communication with Kit servers
/** Kit uses a REST API at https://api.kit.com/v4 with OAuth2 or API key authentication.

    @par Authentication:
    - OAuth2 with Bearer tokens (authorization code grant)
    - API key via X-Kit-Api-Key header
    - Access tokens expire and are refreshed automatically (OAuth2 mode)
    - Scope: public

    @par API Structure:
    All endpoints are under /v4 (included in the base URL)
*/
public class KitRestClient inherits RestClient::RestClient {
    public {
        #! Default Kit API URL
        const DefaultUrl = "https://api.kit.com/v4";

        #! Default authorization request URL
        const DefaultAuthUrl = "https://api.kit.com/v4/oauth/authorize";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default token request URL
        const DefaultTokenUrl = "https://api.kit.com/v4/oauth/token";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since base URL has /v4)
        const DefaultPingPath = "account";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OAuth2 scopes
        const DefaultScopes = (
            "public",
        );

        #! Default OAuth2 auth args to request offline access (refresh tokens)
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "headers": DefaultHeaders,
            "oauth2_auth_args": DefaultAuthArgs,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "url": DefaultUrl,
        };

        #! OAuth2 options (added when OAuth2 credentials are provided)
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_scopes": DefaultScopes,
        };
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
KitRestClient kit({
    "oauth2_client_id": "your-client-id",
    "oauth2_client_secret": "your-client-secret",
    "oauth2_refresh_token": "your-refresh-token",
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the Kit API key (alternative to OAuth2)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(KitRestClient::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! returns options for @ref KitRestClient::KitRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Check if token-only mode (token provided without OAuth2 credentials)
        bool token_only = opts.token && !opts.oauth2_client_id && !opts.oauth2_client_secret
            && !opts.oauth2_refresh_token;

        if (!token_only && opts.oauth2_client_id) {
            rv += OAuth2Options;
        } else if (opts.apikey) {
            # API key mode - use X-Kit-Api-Key header
            rv.headers."X-Kit-Api-Key" = opts.apikey;
        } else if (opts.token) {
            # Bearer token mode
            rv.headers.Authorization = "Bearer " + opts.token;
            remove rv.token;
        }

        # Always remove apikey from options to prevent RestClient misinterpretation
        remove rv.apikey;

        return rv;
    }
}

#! Class for Kit REST connections; returns @ref KitRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref KitRestClient::KitRestClient::constructor() for more information on the above options
*/
public class KitRestConnection inherits RestClient::RestConnection {
    public {
        #! Default connection URL
        const DefaultConnectionUrl = "kitrest://api.kit.com/v4";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Kit REST Connection",
            "short_desc": "A connection to the Kit REST API",
            "desc": "A connection to the Kit REST API for email marketing including subscribers, tags, "
                "custom fields, broadcasts, forms, sequences, and purchases",
            "cls": Class::forName("KitRestConnection"),
            "auto_url": True,
            "schemes": {
                "kitrest": True,
            },
            "base_scheme_map": {
                "https": "kitrest",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Kit API key for authentication",
                    "type": "string",
                    "desc": "The Kit API key used for API key authentication via the `X-Kit-Api-Key` header.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Kit account\n"
                        "2. Go to **Settings** > **Developer**\n"
                        "3. Create a new V4 API key\n\n"
                        "Rate limit: 120 requests per 60 seconds with API key authentication",
                    "sensitive": True,
                    "preselected": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultPingPath,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultScopes,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": KitRestClient::DefaultTokenUrl,
                },
            },
        };
    }

    #! creates the KitRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = KitRestClient::DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the KitRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
    }

    #! returns \c "kitrest"
    string getType() {
        return "kitrest";
    }

    #! Returns connection options
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        # Always set OAuth2 URLs
        rv.oauth2_auth_url = KitRestClient::DefaultAuthUrl;
        rv.oauth2_token_url = KitRestClient::DefaultTokenUrl;
        if (!rv.oauth2_grant_type) {
            rv.oauth2_grant_type = KitRestClient::DefaultGrantType;
        }
        if (!rv.oauth2_scopes) {
            rv.oauth2_scopes = KitRestClient::DefaultScopes;
        }
        if (!rv.oauth2_auth_args) {
            rv.oauth2_auth_args = KitRestClient::DefaultAuthArgs;
        }
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Kit";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the KitDataProvider and creates the data provider
        # object dynamically
        load_module("KitDataProvider");
        return create_object("KitDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != DefaultConnectionUrl) {
                update.url = DefaultConnectionUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref KitRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref KitRestClient object
    */
    private KitRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new KitRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since KitRestClient 1.1
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new KitRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Kit REST API using multiplexed HTTP connections
/** @see KitRestClient for more information
*/
public class KitRestClientIo inherits RestClientIo::RestClientIo {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(KitRestClient::getOptions(opts), shared_mgr) {
    }
}
}
