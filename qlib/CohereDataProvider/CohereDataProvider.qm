%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) CohereRestClient
%requires RestClientIo
%requires RestSchemaActions
%requires OpenApi3

module CohereDataProvider {
    version = "1.1";
    desc = "user module providing a data provider API for Cohere services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new CohereDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": CohereDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Cohere",
            "short_desc": "Chat, search, document extraction, audio transcription, and batch inference",
            "desc": "Use [Cohere](https://cohere.com) to understand and retrieve business content.\n\n"
                "- Generate grounded answers and call tools with chat models\n"
                "- Embed text and images, and rerank search results\n"
                "- Extract document images and transcribe recorded speech\n"
                "- Upload datasets and manage embedding or inference batches\n"
                "- Discover models and inspect model-specific tokens\n\n"
                "A Cohere API key is required. Trial keys have a monthly quota; connection pings "
                "verify authentication separately from inference availability.",
            "scheme": "cohere",
            "logo": CohereLogo,
            "logo_file_name": "cohere-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        (CohereSchema::getActionSet()).registerActions(CohereDataProvider::AppName);
    };
}

/** @mainpage CohereDataProvider Module

    @tableofcontents

    @section coheredataproviderintro CohereDataProvider Introduction

    The %CohereDataProvider module provides a data provider API for
    <a href="https://cohere.com">Cohere</a> chat, embeddings, reranking, and
    classification services, plus model discovery, tokenization, document image parsing, audio
    transcription, datasets, and batch jobs.

    The following data providers are exposed:
    - @ref CohereDataProvider::CohereDataProvider "CohereDataProvider" — root
    - @ref CohereDataProvider::CohereChatDataProvider "CohereChatDataProvider" — chat (Command R/R+)
    - @ref CohereDataProvider::CohereEmbedDataProvider "CohereEmbedDataProvider" — embeddings
    - @ref CohereDataProvider::CohereRerankDataProvider "CohereRerankDataProvider" — reranking
    - @ref CohereDataProvider::CohereClassifyDataProvider "CohereClassifyDataProvider" — classification

    @section CohereDataProviderRelnotes Release Notes

    @subsection coheredataproviderv1_1 CohereDataProvider v1.1
    - 24 schema-derived actions, including model discovery, tokenization, datasets, embedding jobs,
      batch inference, document image parsing, and audio transcription
    - task-filtered model dropdowns and references to existing datasets and jobs
    - complete current v2 request contracts, including multimodal embeddings and grounded chat
    - v1 and v2 paths are routed explicitly rather than appended to the connection API prefix
    - named multipart files preserve extensions and media types for audio and dataset uploads
    - classification guidance reflects Cohere's retirement of classification fine-tuning and existing fine-tuned models

    @par Example
    @code{.q}
    CohereDataProvider provider({"apikey": ENV.COHERE_APIKEY});
    auto models = provider.getChildProvider("list-models").doRequest({"endpoint": "embed"});
    auto vectors = provider.getChildProvider("embed").doRequest({
        "model": "embed-multilingual-v3.0",
        "texts": ("A customer asked to reschedule delivery.",),
        "input_type": "search_document",
    });
    @endcode

    Upload actions accept <tt>FileDataType</tt> values. Supply the original filename so Cohere can determine
    the audio or dataset format; <tt>content</tt> accepts raw binary data or base64-encoded data.
    @par Audio upload example
    @code{.q}
    auto transcript = provider.getChildProvider("transcribe").doRequest({
        "language": "en",
        "file": {"name": "delivery-note.wav", "content": File::readBinaryFile("delivery-note.wav"),
            "mime_type": "audio/wav"},
    });
    @endcode

    The vendored schema is pinned to a reviewed upstream revision. Re-import it with
    <tt>tools/rest-schema-import.qr --spec qlib/CohereDataProvider/cohere-import.yaml</tt> and review drift.
    Classify remains for compatibility, but Cohere has retired classification fine-tuning and
    previously fine-tuned models. See Cohere's
    <a href="https://docs.cohere.com/changelog/2025-09-15-major-command-deprecations">September 2025 deprecation notice</a>.
    Use Chat with structured output for new classification workflows. The Chat action returns a
    completed response and does not expose the streaming transport switch.

    @subsection CohereDataProviderv1_0 CohereDataProvider v1.0
    - initial release
*/

#! contains all public definitions in the CohereDataProvider module
public namespace CohereDataProvider {
#! Cohere application name
public const AppName = "Cohere";
}

namespace Priv {
#! App logo loaded from its module resource
const CohereLogo = File::readTextFile(get_script_dir() + "/cohere-logo.svg");
}
#! The original public logo constant, retained for source compatibility
public const CohereLogo = Priv::CohereLogo;
