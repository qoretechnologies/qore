# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%new-style
# require type definitions everywhere
%require-types
# enable all warnings
%enable-all-warnings
# strict argument handling
%strict-args
# do not require child data providers to be present
%no-child-restrictions

%requires(reexport) DataProvider
%requires(reexport) RestClient
%requires(reexport) RestClientIo
%requires EasyPostRestClient
%requires json

module EasyPostDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for EasyPost shipping and logistics services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new EasyPostDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": EasyPostDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "EasyPost",
            "short_desc": "EasyPost shipping and logistics platform",
            "desc": "EasyPost is a unified shipping API that connects to dozens of carriers including USPS, "
                "UPS, FedEx, DHL, and more. This integration enables creating addresses, parcels, shipments, "
                "trackers, insurance records, pickups, and orders, as well as managing carrier accounts and "
                "subscribing to webhook events.\n\n"
                "**Features:**\n"
                "- Address creation, verification, and lookup\n"
                "- Shipment lifecycle (create, buy, refund, label, rerate, insure)\n"
                "- Tracker creation (single and bulk) and lookup\n"
                "- Insurance creation and refund\n"
                "- Pickup scheduling, buying, and cancellation\n"
                "- Multi-shipment orders\n"
                "- Customs information and customs items\n"
                "- Refunds and batches\n"
                "- Webhook and carrier-account management\n"
                "- Real-time webhook events for tracker, batch, insurance, refund, and payment updates",
            "scheme": "easypostrest",
            "logo": EasyPostDataProvider::EasyPostLogo,
            "logo_file_name": "easypost-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Shipping,),
        });

        # ========== ADDRESS ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/addresses",
            "action": "list-addresses",
            "groups": "Addresses",
            "display_name": "List Addresses",
            "short_desc": "List EasyPost addresses",
            "desc": "Retrieve a paginated list of addresses, or fetch a single address by ID.",
            "action_code": DPAT_FIND,
            "data_provider_info": EasyPostAddressesDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("EasyPostAddressList", new EasyPostAddressType(), True);
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-address",
            "action": "create-address",
            "groups": "Addresses",
            "display_name": "Create Address",
            "short_desc": "Create a new EasyPost address",
            "desc": "Create a new address. Optionally request lenient or strict verification of the address.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreateAddressDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreateAddressDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCreateAddressRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-address",
            "action": "get-address",
            "groups": "Addresses",
            "display_name": "Get Address",
            "short_desc": "Retrieve an address by ID",
            "desc": "Retrieve an EasyPost address by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetAddressDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetAddressDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetAddressRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/verify-address",
            "action": "verify-address",
            "groups": "Addresses",
            "display_name": "Verify Address",
            "short_desc": "Verify an existing address",
            "desc": "Run carrier-side address verification on an existing address.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostVerifyAddressDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostVerifyAddressDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostVerifyAddressRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-and-verify-address",
            "action": "create-and-verify-address",
            "groups": "Addresses",
            "display_name": "Create and Verify Address",
            "short_desc": "Create and verify an address in one call",
            "desc": "Create a new address and verify it in a single API call.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreateAndVerifyAddressDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreateAndVerifyAddressDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCreateAddressRequestDataType::Fields),
        });

        # ========== PARCEL ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-parcel",
            "action": "get-parcel",
            "groups": "Parcels",
            "display_name": "Get Parcel",
            "short_desc": "Retrieve a parcel by ID",
            "desc": "Retrieve an EasyPost parcel by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetParcelDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetParcelDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetParcelRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-parcel",
            "action": "create-parcel",
            "groups": "Parcels",
            "display_name": "Create Parcel",
            "short_desc": "Create a new parcel",
            "desc": "Create a new EasyPost parcel by dimensions and weight, or with a `predefined_package`.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreateParcelDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreateParcelDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCreateParcelRequestDataType::Fields),
        });

        # ========== SHIPMENT ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/shipments",
            "action": "list-shipments",
            "groups": "Shipments",
            "display_name": "List Shipments",
            "short_desc": "List shipments",
            "desc": "Retrieve a paginated list of shipments. Optionally fetch by ID or filter by purchased status.",
            "action_code": DPAT_FIND,
            "data_provider_info": EasyPostShipmentsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("EasyPostShipmentList", new EasyPostShipmentType(), True);
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-shipment",
            "action": "create-shipment",
            "groups": "Shipments",
            "display_name": "Create Shipment",
            "short_desc": "Create a new shipment (returns rate options)",
            "desc": "Create a new shipment. The response contains a list of available rates that can be used "
                "to purchase a label via `buy-shipment`.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreateShipmentDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreateShipmentDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCreateShipmentRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-shipment",
            "action": "get-shipment",
            "groups": "Shipments",
            "display_name": "Get Shipment",
            "short_desc": "Retrieve a shipment by ID",
            "desc": "Retrieve an EasyPost shipment by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetShipmentDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetShipmentDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetShipmentRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/buy-shipment",
            "action": "buy-shipment",
            "groups": "Shipments",
            "display_name": "Buy Shipment",
            "short_desc": "Purchase a shipping label",
            "desc": "Purchase a shipping label by selecting one of the rates returned by `create-shipment`.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostBuyShipmentDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostBuyShipmentDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostBuyShipmentRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/refund-shipment",
            "action": "refund-shipment",
            "groups": "Shipments",
            "display_name": "Refund Shipment",
            "short_desc": "Refund a purchased shipment",
            "desc": "Submit a refund request for a previously purchased shipment.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostRefundShipmentDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostRefundShipmentDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostRefundShipmentRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-shipment-label",
            "action": "get-shipment-label",
            "groups": "Shipments",
            "display_name": "Get Shipment Label",
            "short_desc": "Retrieve a shipment label",
            "desc": "Retrieve a shipment label in a specific format (PDF, ZPL, EPL2, or PNG).",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetShipmentLabelDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetShipmentLabelDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetShipmentLabelRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-shipment-smartrates",
            "action": "get-shipment-smartrates",
            "groups": "Shipments",
            "display_name": "Get Shipment SmartRates",
            "short_desc": "Retrieve SmartRates for a shipment",
            "desc": "Retrieve SmartRates for a shipment. Each rate includes a `time_in_transit` "
                "object with percentile-based estimated transit business days "
                "(`percentile_50` through `percentile_99`) for SLA-aware rate selection.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetShipmentSmartratesDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("EasyPostShipmentSmartRateList", new EasyPostSmartRateType(), True);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                EasyPostGetShipmentSmartratesRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/rerate-shipment",
            "action": "rerate-shipment",
            "groups": "Shipments",
            "display_name": "Rerate Shipment",
            "short_desc": "Re-rate a shipment",
            "desc": "Re-fetch rate quotes for an existing shipment.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostRerateShipmentDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostRerateShipmentDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostRerateShipmentRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/insure-shipment",
            "action": "insure-shipment",
            "groups": "Shipments",
            "display_name": "Insure Shipment",
            "short_desc": "Insure a shipment",
            "desc": "Add insurance to an already-purchased shipment.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostInsureShipmentDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostInsureShipmentDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostInsureShipmentRequestDataType::Fields),
        });

        # ========== TRACKER ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/trackers",
            "action": "list-trackers",
            "groups": "Trackers",
            "display_name": "List Trackers",
            "short_desc": "List trackers",
            "desc": "Retrieve a paginated list of trackers. Optionally filter by tracking code or carrier.",
            "action_code": DPAT_FIND,
            "data_provider_info": EasyPostTrackersDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("EasyPostTrackerList", new EasyPostTrackerType(), True);
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-tracker",
            "action": "create-tracker",
            "groups": "Trackers",
            "display_name": "Create Tracker",
            "short_desc": "Create a tracker",
            "desc": "Create a new tracker for a carrier tracking code.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreateTrackerDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreateTrackerDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCreateTrackerRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-tracker",
            "action": "get-tracker",
            "groups": "Trackers",
            "display_name": "Get Tracker",
            "short_desc": "Retrieve a tracker by ID",
            "desc": "Retrieve an EasyPost tracker by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetTrackerDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetTrackerDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetTrackerRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/delete-tracker",
            "action": "delete-tracker",
            "groups": "Trackers",
            "display_name": "Delete Tracker",
            "short_desc": "Delete a tracker by ID",
            "desc": "Delete an EasyPost tracker by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostDeleteTrackerDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostDeleteTrackerDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostDeleteTrackerRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/bulk-create-trackers",
            "action": "bulk-create-trackers",
            "groups": "Trackers",
            "display_name": "Bulk Create Trackers",
            "short_desc": "Bulk-create trackers",
            "desc": "Create up to 100 trackers in a single request.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostBulkCreateTrackersDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashOrNothingType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostBulkCreateTrackersRequestDataType::Fields),
        });

        # ========== INSURANCE ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/insurances",
            "action": "list-insurances",
            "groups": "Insurance",
            "display_name": "List Insurance Records",
            "short_desc": "List insurance records",
            "desc": "Retrieve a paginated list of insurance records.",
            "action_code": DPAT_FIND,
            "data_provider_info": EasyPostInsuranceListDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("EasyPostInsuranceList", new EasyPostInsuranceType(), True);
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-insurance",
            "action": "create-insurance",
            "groups": "Insurance",
            "display_name": "Create Insurance",
            "short_desc": "Create a standalone insurance record",
            "desc": "Create a standalone insurance record for a tracking code.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreateInsuranceDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreateInsuranceDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCreateInsuranceRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-insurance",
            "action": "get-insurance",
            "groups": "Insurance",
            "display_name": "Get Insurance",
            "short_desc": "Retrieve an insurance record by ID",
            "desc": "Retrieve an EasyPost insurance record by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetInsuranceDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetInsuranceDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetInsuranceRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/refund-insurance",
            "action": "refund-insurance",
            "groups": "Insurance",
            "display_name": "Refund Insurance",
            "short_desc": "Refund an insurance record",
            "desc": "Submit a refund request for an insurance record.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostRefundInsuranceDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostRefundInsuranceDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostRefundInsuranceRequestDataType::Fields),
        });

        # ========== PICKUP ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/pickups",
            "action": "list-pickups",
            "groups": "Pickups",
            "display_name": "List Pickups",
            "short_desc": "List pickups",
            "desc": "Retrieve a paginated list of pickups.",
            "action_code": DPAT_FIND,
            "data_provider_info": EasyPostPickupsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("EasyPostPickupList", new EasyPostPickupType(), True);
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-pickup",
            "action": "create-pickup",
            "groups": "Pickups",
            "display_name": "Create Pickup",
            "short_desc": "Schedule a pickup",
            "desc": "Schedule a new pickup for a shipment.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreatePickupDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreatePickupDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCreatePickupRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-pickup",
            "action": "get-pickup",
            "groups": "Pickups",
            "display_name": "Get Pickup",
            "short_desc": "Retrieve a pickup by ID",
            "desc": "Retrieve an EasyPost pickup by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetPickupDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetPickupDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetPickupRequestDataType::Fields),
        });

        # pickup_id drives carrier dropdown via pickup_rates; has_dependents/on_change are not
        # propagated by getActionOptionFromFields() — augment manually.
        {
            hash<string, hash<ActionOptionInfo>> opts =
                DataProviderActionCatalog::getActionOptionFromFields(
                    EasyPostBuyPickupRequestDataType::Fields);
            opts.pickup_id += {"has_dependents": True, "on_change": ("refetch",)};
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": EasyPostDataProvider::AppName,
                "path": "/buy-pickup",
                "action": "buy-pickup",
                "groups": "Pickups",
                "display_name": "Buy Pickup",
                "short_desc": "Confirm a pickup",
                "desc": "Confirm/buy a previously scheduled pickup.",
                "action_code": DPAT_API,
                "data_provider_info": EasyPostBuyPickupDataProvider::ProviderInfo,
                "get_output_type": AbstractDataProviderType sub () { return EasyPostBuyPickupDataProvider::ResponseType; },
                "options": opts,
            });
        }

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/cancel-pickup",
            "action": "cancel-pickup",
            "groups": "Pickups",
            "display_name": "Cancel Pickup",
            "short_desc": "Cancel a pickup",
            "desc": "Cancel a scheduled pickup.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCancelPickupDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCancelPickupDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCancelPickupRequestDataType::Fields),
        });

        # ========== ORDER ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-order",
            "action": "get-order",
            "groups": "Orders",
            "display_name": "Get Order",
            "short_desc": "Retrieve an order",
            "desc": "Retrieve an EasyPost order by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetOrderDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetOrderDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetOrderRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-order",
            "action": "create-order",
            "groups": "Orders",
            "display_name": "Create Order",
            "short_desc": "Create a multi-shipment order",
            "desc": "Create a new multi-shipment order.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreateOrderDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreateOrderDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostCreateOrderRequestDataType::Fields),
        });

        # order_id drives carrier dropdown via order rates; has_dependents/on_change are not
        # propagated by getActionOptionFromFields() — augment manually.
        {
            hash<string, hash<ActionOptionInfo>> opts =
                DataProviderActionCatalog::getActionOptionFromFields(
                    EasyPostBuyOrderRequestDataType::Fields);
            opts.order_id += {"has_dependents": True, "on_change": ("refetch",)};
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": EasyPostDataProvider::AppName,
                "path": "/buy-order",
                "action": "buy-order",
                "groups": "Orders",
                "display_name": "Buy Order",
                "short_desc": "Buy an order",
                "desc": "Buy all shipments in an order with a single carrier and service.",
                "action_code": DPAT_API,
