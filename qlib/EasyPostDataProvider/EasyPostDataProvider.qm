        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-event",
            "action": "get-event",
            "groups": "Events",
            "display_name": "Get Event",
            "short_desc": "Retrieve an event",
            "desc": "Retrieve a webhook event by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetEventDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetEventDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetEventRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/list-event-payloads",
            "action": "list-event-payloads",
            "groups": "Events",
            "display_name": "List Event Payloads",
            "short_desc": "List event payloads",
            "desc": "List webhook delivery payloads (attempts) for an event.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetEventPayloadsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetEventPayloadsDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetEventPayloadsRequestDataType::Fields),
        });

        # event_id drives payload_id dropdown; has_dependents/on_change are not
        # propagated by getActionOptionFromFields() — augment manually.
        {
            hash<string, hash<ActionOptionInfo>> opts =
                DataProviderActionCatalog::getActionOptionFromFields(
                    EasyPostGetEventPayloadRequestDataType::Fields);
            opts.event_id += {"has_dependents": True, "on_change": ("refetch",)};
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": EasyPostDataProvider::AppName,
                "path": "/get-event-payload",
                "action": "get-event-payload",
                "groups": "Events",
                "display_name": "Get Event Payload",
                "short_desc": "Retrieve a single payload",
                "desc": "Retrieve a single webhook delivery payload.",
                "action_code": DPAT_API,
                "data_provider_info": EasyPostGetEventPayloadDataProvider::ProviderInfo,
                "get_output_type": AbstractDataProviderType sub () { return EasyPostGetEventPayloadDataProvider::ResponseType; },
                "options": opts,
            });
        }

        # ========== CARRIER ACCOUNT ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/carrier-accounts",
            "action": "list-carrier-accounts",
            "groups": "Carrier Accounts",
            "display_name": "List Carrier Accounts",
            "short_desc": "List carrier accounts",
            "desc": "Retrieve all carrier accounts configured on the EasyPost account.",
            "action_code": DPAT_FIND,
            "data_provider_info": EasyPostCarrierAccountsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("EasyPostCarrierAccountList", new EasyPostCarrierAccountType(), True);
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/get-carrier-account",
            "action": "get-carrier-account",
            "groups": "Carrier Accounts",
            "display_name": "Get Carrier Account",
            "short_desc": "Retrieve a carrier account",
            "desc": "Retrieve a carrier account by ID.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostGetCarrierAccountDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostGetCarrierAccountDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(EasyPostGetCarrierAccountRequestDataType::Fields),
        });

        # `type` controls the shape of `credentials`/`test_credentials`; mark it as
        # structural_determinate + on_change refetch so the UI re-fetches the request type
        # whenever the user picks a new carrier.
        hash<auto> create_carrier_account_opts = DataProviderActionCatalog::getActionOptionFromFields(
            EasyPostCreateCarrierAccountRequestDataType::Fields);
        create_carrier_account_opts."type" += {
            "has_dependents": True,
            "structural_determinate": True,
            "on_change": ("refetch",),
        };
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/create-carrier-account",
            "action": "create-carrier-account",
            "groups": "Carrier Accounts",
            "display_name": "Create Carrier Account",
            "short_desc": "Create a carrier account",
            "desc": "Create a new carrier account. Selecting a carrier type populates the `credentials` and "
                "`test_credentials` fields with that carrier's specific schema.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostCreateCarrierAccountDataProvider::ProviderInfo,
            "data_dependent_options": True,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostCreateCarrierAccountDataProvider::ResponseType; },
            "options": create_carrier_account_opts,
        });

        # Selecting a carrier_account_id triggers a refetch so the credentials fields can be typed
        # for the chosen account's carrier.
        hash<auto> update_carrier_account_opts = DataProviderActionCatalog::getActionOptionFromFields(
            EasyPostUpdateCarrierAccountRequestDataType::Fields);
        update_carrier_account_opts."carrier_account_id" += {
            "has_dependents": True,
            "structural_determinate": True,
            "on_change": ("refetch",),
        };
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/update-carrier-account",
            "action": "update-carrier-account",
            "groups": "Carrier Accounts",
            "display_name": "Update Carrier Account",
            "short_desc": "Update a carrier account",
            "desc": "Update an existing carrier account. Selecting a carrier account populates the "
                "`credentials` and `test_credentials` fields with that carrier's specific schema.",
            "action_code": DPAT_API,
            "data_provider_info": EasyPostUpdateCarrierAccountDataProvider::ProviderInfo,
            "data_dependent_options": True,
            "get_output_type": AbstractDataProviderType sub () { return EasyPostUpdateCarrierAccountDataProvider::ResponseType; },
            "options": update_carrier_account_opts,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": EasyPostDataProvider::AppName,
            "path": "/delete-carrier-account",
            "action": "delete-carrier-account",
            "groups": "Carrier Accounts",
