%modern

%allow-weak-references

%requires Logger
%requires(reexport) RestClient >= 2.4
%requires(reexport) HttpClientIo
%requires(reexport) RestSchemaValidator >= 1.0
%requires Swagger >= 2.0
%requires OpenApi3 >= 1.0
%requires Mime >= 1.7

%try-module yaml >= 0.5
%define NoYaml
%endtry

%try-module xml >= 1.3
%define NoXml
%endtry

%try-module json >= 1.5
%define NoJson
%endtry

%try-module json >= 1.12
%define NoCbor
%endtry

module RestClientIo {
    version = "1.0";
    desc = "REST client over HTTP/1.1, HTTP/2, and HTTP/3 connections";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage RestClientIo Module

    @tableofcontents

    @section restclientio_intro Introduction

    The %RestClientIo module provides a REST client API built on top of the @ref HttpClientIo module,
    enabling HTTP/1.1, HTTP/2, and HTTP/3 connections for REST API calls.

    Unlike @ref RestClient::RestClient "RestClient" which uses a single HTTP/1.1 connection,
    %RestClientIo uses the @ref HttpClientIo::HttpClientConnectionManager "HttpClientConnectionManager"
    for multiplexed connections — multiple concurrent requests share connections without serialization.

    @par Example
    @code{.py}
%requires RestClientIo

RestClientIo rest({"url": "https://api.example.com", "data": "json"});
hash<RestResponseInfo> resp = rest.restPost("/v1/data", {"key": "value"});
printf("Status: %d, Body: %y\n", resp.status_code, resp.body);
    @endcode

    @par Async Usage
    @code{.py}
%requires RestClientIo

RestClientIo rest({"url": "https://api.example.com", "data": "json"});

# Fire multiple requests concurrently
RestFuture f1 = rest.restGetAsync("/v1/users");
RestFuture f2 = rest.restPostAsync("/v1/data", {"key": "value"});

# Collect results
hash<RestResponseInfo> resp1 = f1.get(30s);
hash<RestResponseInfo> resp2 = f2.get(30s);
    @endcode

    @section restclientio_oauth2 OAuth2 Support

    %RestClientIo supports OAuth2 token acquisition and automatic refresh:
    - \c client_credentials and \c password grant types with automatic login
    - Token refresh via refresh tokens (proactive for stale tokens, reactive via 401 retry)
    - Concurrent refresh serialization — only one thread refreshes at a time
    - Configurable basic auth for token requests

    @par OAuth2 Example
    @code{.py}
%requires RestClientIo

RestClientIo rest({
    "url": "https://api.example.com",
    "data": "json",
    "oauth2_grant_type": "client_credentials",
    "oauth2_client_id": "my-client-id",
    "oauth2_client_secret": "my-client-secret",
    "oauth2_token_url": "https://auth.example.com/oauth/token",
});
# Token is acquired automatically on first request
hash<RestResponseInfo> resp = rest.restGet("/v1/data");
    @endcode

    @section restclientio_pool Connection Pooling

    The @ref RestClientIoPool class inherits both @ref RestClientIo and
    @ref Qore::Thread::AbstractConnectionPool "AbstractConnectionPool", so it can be
    used both as a REST client and as a pool.  Since @ref RestClientIo already multiplexes
    concurrent requests over shared HTTP/2 and HTTP/3 connections, \c acquire() simply
    returns the pool object itself and \c release() is a no-op.

    @par Pool Example
    @code{.py}
%requires RestClientIo

# Create — the pool IS the client
RestClientIoPool pool({"url": "https://api.example.com", "data": "json"});

# Use directly (multiplexing handles concurrency)
hash<RestResponseInfo> resp = pool.restGet("/api/data");

# Or use the acquire/release pattern for pool-expecting code
RestClientIo rc = pool.acquire();
on_exit pool.release();
resp = rc.restGet("/api/data");
    @endcode

    @section restclientio_relnotes Release Notes

    @subsection restclientio_v1_2 Version 1.2
    - Added \c getLogger() to expose the client's logger
    - Added \c setAllowAnyResponse() / \c getAllowAnyResponse() for controlling deserialization
      error handling
    - Added \c setContentEncoding() for setting both send and accept encoding
    - Added \c getValidator() / \c setValidator() for runtime schema validator access
    - Added \c setConnectionPath() / \c getConnectionPath() / \c clearConnectionPath() for
      connection path management (\c default_path constructor option)
    - Added \c setUserPassword() / \c clearUserPassword() for HTTP Basic authentication
      (\c username / \c password constructor options without OAuth2)
    - Added \c doSignedRequest() / \c doSignedRequestAsync() for request signing support
    - Added proxy support via \c proxy constructor option (passed through to
      HttpClientConnectionManager)
    - Constructor now accepts \c validator option for custom REST schema validators
    - Constructor now accepts \c allow_any_response, \c content_encoding, \c default_path options

    @subsection restclientio_v1_2 Version 1.2
    - added \c RestClientIoPingPollOperation class for async REST connection pings via startPollConnect()

    @subsection restclientio_v1_1 Version 1.1
    - OAuth2 support: \c client_credentials and \c password grant types
    - Automatic token acquisition on first request via \c checkLogin()
    - Proactive token refresh for stale tokens plus 401 retry for edge cases
    - Concurrent refresh serialization — only one thread refreshes at a time
    - Public API: \c setOAuth2Options(), \c getOAuth2Options(), \c getNewToken()
    - Token URL can be absolute (different server) or relative (same server)
    - Support for \c oauth2_token_use_basic_auth and \c oauth2_token_auth_secret_only
    - \c bin/rest updated with OAuth2 CLI options

    @subsection restclientio_v1_0 Version 1.0
    - Initial release of RestClientIo module
    - Implements @ref RestClient::AbstractRestClient "AbstractRestClient" interface
    - HTTP/1.1, HTTP/2, and HTTP/3 support via @ref HttpClientIo::HttpClientConnectionManager
    - Data serialization/deserialization via @ref RestSchemaValidator::NullRestSchemaValidator
    - Support for JSON, YAML, XML, CBOR, URL-encoded, text, and binary formats
    - Opt-in shared @ref HttpClientIo::HttpClientConnectionManager for connection sharing across
      multiple RestClientIo instances
    - Async API: \c restGetAsync(), \c restPostAsync(), etc. returning Future for non-blocking calls
    - @ref RestClientIoPool for thread-safe connection pooling; options-based constructor
      automatically creates a shared @ref HttpClientIo::HttpClientConnectionManager so all
      pooled instances multiplex over the same connections
*/

#! Main namespace for the RestClientIo module
public namespace RestClientIo {
    #! Future wrapper that deserializes HTTP responses into RestResponseInfo
    /** Wraps a raw HTTP response Future from @ref HttpClientIo and applies
        response deserialization when @ref get() is called.

        @par Usage
        @code{.py}
RestFuture f = rest.restGetAsync("/api/users");
hash<RestResponseInfo> resp = f.get(30s);
        @endcode

        @since RestClientIo 1.0
    */
    public class RestFuture {
        private {
            #! The raw HTTP response Future
            Future raw_future;

            #! Stream handle reference (kept alive to retain the internal Promise)
            HttpClientIo::HttpClientStreamHandle stream;

            #! Closure that deserializes raw HTTP response to RestResponseInfo
            code<hash<RestClient::RestResponseInfo>(hash<auto>)> response_builder;
        }

        #! Creates a new RestFuture
        /** @param raw_future the raw HTTP response Future
            @param stream the stream handle (held to keep the internal Promise alive)
            @param response_builder closure that deserializes the raw response
        */
        constructor(Future raw_future, HttpClientIo::HttpClientStreamHandle stream,
                code<hash<RestClient::RestResponseInfo>(hash<auto>)> response_builder) {
            self.raw_future = raw_future;
            self.stream = stream;
            self.response_builder = response_builder;
        }

        #! Gets the deserialized REST response, blocking until available
        /** @param timeout_ms timeout for the operation (default 30s)

            @return the deserialized @ref RestClient::RestResponseInfo hash

            @throw HTTPCLIENT-TIMEOUT if the request times out
            @throw REST-RESPONSE-ERROR if error_passthru is False and status >= 300
            @throw FUTURE-TIMEOUT if the Future times out
        */
        hash<RestClient::RestResponseInfo> get(timeout timeout_ms = 30s) {
            hash<auto> raw = raw_future.get(timeout_ms);
            return response_builder(raw);
        }

        #! Returns True if the response is available
        bool isDone() {
            return raw_future.isDone();
        }

        #! Returns True if the Future has been rejected with an error
        bool isError() {
            return raw_future.isError();
        }

        #! Cancels the in-flight HTTP request
        /** Calls @ref HttpClientIo::HttpClientStreamHandle::cancel() "cancel()" on the
            underlying stream handle to send a protocol-level cancellation (RST_STREAM,
            STOP_SENDING, etc.) and reject the internal Promise.

            @return True if the cancellation was initiated, False if already complete

            @since %RestClientIo 1.3
        */
        bool cancel() {
            if (raw_future.isDone()) {
                return False;
            }
            stream.cancel();
            return True;
        }
    }

    #! REST client using multiplexed HTTP/2 and HTTP/3 connections
    /** This class implements the @ref RestClient::AbstractRestClient "AbstractRestClient" interface
        using @ref HttpClientIo::HttpClientConnectionManager "HttpClientConnectionManager" for
        multiplexed HTTP/2 and HTTP/3 connections.

        Multiple concurrent requests are multiplexed over shared connections rather than serializing
        through a single HTTP/1.1 connection as @ref RestClient::RestClient "RestClient" does.

        @par Constructor Options
        - \c url (required): the target URL (e.g., \c "https://api.example.com")
        - \c data: data serialization format (default: \c "auto"); see
          \c DataSerializationOptions
        - \c send_encoding: send encoding (compression) format (e.g., \c "gzip")
        - \c headers: additional default headers to send with each request; these override the
          built-in defaults (\c Accept and \c User-Agent)
        - \c token: authentication token
        - \c token_type: authentication token type (default: \c "Bearer")
        - \c error_passthru: if \c True, HTTP error responses are returned rather than throwing
          exceptions (default: \c False)
        - \c connect_timeout: connection timeout
        - \c timeout: request timeout
        - \c protocol: protocol selection: \c "auto" (default), \c "h2", or \c "h3"
        - \c max_connections_per_host: maximum connections per host (0 = unlimited)
        - \c max_streams_per_connection: maximum streams per connection (0 = unlimited)
        - \c ssl_verify_mode: SSL verification mode
        - \c accept_all_certs: if \c True, accept all certificates including self-signed
        - \c no_charset: if \c True, do not add charset to Content-Type header
        - \c allow_any_response: if \c True, return raw body on deserialization errors instead
          of throwing
        - \c content_encoding: content encoding option (e.g., \c "auto", \c "gzip")
        - \c default_path: connection path prepended to all request paths
        - \c proxy: proxy URL (e.g., \c "http://proxy:port")
        - \c validator: a @ref RestSchemaValidator::AbstractRestSchemaValidator instance for
          request/response processing
        - \c oauth2_grant_type: OAuth2 grant type (\c "client_credentials", \c "password",
          \c "authorization_code", \c "implicit", or \c "none")
        - \c oauth2_client_id: OAuth2 client ID
        - \c oauth2_client_secret: OAuth2 client secret
        - \c oauth2_token_url: OAuth2 token endpoint URL (absolute or relative)
        - \c oauth2_alt_token_url: alternate token URL; if set, token requests are routed here and \c oauth2_token_url is included as a body arg (useful for proxy-based token services)
        - \c oauth2_scopes: OAuth2 scopes (list of strings)
        - \c oauth2_scope_separator_char: separator for scopes (default: space)
        - \c oauth2_auth_args: additional authorization arguments
        - \c oauth2_token_args: additional token request arguments
        - \c oauth2_auth_url: OAuth2 authorization URL
        - \c oauth2_redirect_url: OAuth2 redirect URL
        - \c oauth2_auto_refresh: if \c True (default), automatically refresh expired tokens
        - \c oauth2_token_use_basic_auth: if \c True, use HTTP Basic auth for token requests
        - \c oauth2_token_auth_secret_only: if \c True, use only the secret for Basic auth
        - \c oauth2_token_expiry_hint: hint for token expiry in seconds
        - \c oauth2_token_expiry: known expiry timestamp for an initial token; enables proactive pre-expiry refresh
        - \c oauth2_refresh_token: initial refresh token
        - \c username: username for \c password grant type
        - \c password: password for \c password grant type

        @par Shared Connection Manager
        An optional @ref HttpClientIo::HttpClientConnectionManager "HttpClientConnectionManager" can
        be passed to the constructor to share connections across multiple RestClientIo instances:
        @code{.py}
HttpClientIo::HttpClientConnectionManager shared_mgr();
RestClientIo rest1({"url": "https://api.example.com", "data": "json"}, shared_mgr);
RestClientIo rest2({"url": "https://api.example.com", "data": "xml"}, shared_mgr);
        @endcode
        When a shared manager is used, @ref close() does not close the manager — the caller
        retains ownership.

        @par Thread Safety
        This class is thread-safe. All mutable state is protected and the underlying
        @ref HttpClientIo::HttpClientConnectionManager "HttpClientConnectionManager" is thread-safe.

        @since RestClientIo 1.0
    */
    public class RestClientIo inherits RestClient::AbstractRestClient {
        private {
            #! Connection manager for HTTP/2 and HTTP/3 connections
            HttpClientIo::HttpClientConnectionManager mgr;

            #! True if this instance owns the connection manager (should close on close())
            bool owns_mgr = True;

            #! Target URL
            string url;

            #! Schema validator for serialization/deserialization
            RestSchemaValidator::AbstractRestSchemaValidator validator;

            #! RWLock protecting mutable config state below; readers (requests) take a shared
            #! lock so they run concurrently; writers (config methods) take an exclusive lock
            RWLock config_lock();

            #! If True, HTTP error responses are returned rather than throwing exceptions
            bool error_passthru = False;

            #! If True, allow any response content type (don't throw on deserialization errors)
            bool allow_any_response = False;

            #! Connection path prepended to all request paths
            *string connection_path;

            #! Basic auth username
            *string basic_auth_user;

            #! Basic auth password
            *string basic_auth_pass;

            #! Default headers to send with each request
            hash<auto> headers = {};

            #! Data serialization code (e.g., "json", "auto")
            string ds = "auto";

            #! Serialization content type (set from setSerialization)
            *string sct;

            #! Send encoding hash (set from setSendEncoding)
            *hash<auto> seh;

            #! If True, do not add charset to Content-Type header
            bool noCharset = False;

            #! Token type (e.g., "Bearer")
            *string token_type_val;

            #! Authentication token
            *string token_val;

            #! Logger
            *LoggerInterface logger;

            # --- OAuth2 config (protected by config_lock) ---

            #! OAuth2 grant type (e.g., "client_credentials", "password")
            *string oauth2_grant_type;
            #! OAuth2 client ID
            *string oauth2_client_id;
            #! OAuth2 client secret
            *string oauth2_client_secret;
            #! OAuth2 scopes
            *softlist<string> oauth2_scopes;
            #! OAuth2 scope separator character (default: space)
            string oauth2_scope_separator_char = " ";
            #! OAuth2 additional auth args
            *hash<auto> oauth2_auth_args;
            #! OAuth2 additional token request args
            *hash<auto> oauth2_token_args;
            #! OAuth2 authorization URL
            *string oauth2_auth_url;
            #! OAuth2 redirect URL
            *string oauth2_redirect_url;
            #! OAuth2 token URL
            *string oauth2_token_url;
            #! Alternate OAuth2 token URL; if set, token requests are routed here and oauth2_token_url is sent as a body arg
            *string oauth2_alt_token_url;
            #! Whether to auto-refresh tokens
            bool oauth2_auto_refresh = True;
            #! Whether to use only the secret for token auth
            bool oauth2_token_auth_secret_only = False;
            #! Whether to use basic auth for token requests
            bool oauth2_token_use_basic_auth = False;
            #! Hint for token expiry in seconds
            *int oauth2_token_expiry_hint;

            # --- Token state (protected by config_lock) ---

            #! Refresh token
            *string refresh_token;
            #! Token expiry timestamp
            *date oauth2_token_expiry;
            #! Timestamp of last token acquisition
            date token_timestamp;
            #! Username for password grant
            *string username;
            #! Password for password grant
            *string password;

            # --- OAuth2 refresh serialization (separate locking) ---

            #! Mutex for OAuth2 token refresh serialization
            Mutex oauth2_mutex();
            #! Condition variable for OAuth2 refresh serialization
            Condition oauth2_cond();
            #! True if a thread is currently refreshing the OAuth2 token
            bool oauth2_refreshing = False;

            # --- Alt token signer for proxy-based OAuth2 ---

            #! Callback for signing token requests to an alternate token URL (proxy)
            transient *code alt_token_signer;
            #! Header name for the alt token signer signature
            transient *string alt_token_signer_header;

            # --- Option update callback ---

            #! Callback to notify the connection when options (tokens) are updated
            transient *code update_options;
        }

        public {
            #! Accept header list
            const AcceptList = (
%ifndef NoYaml
                MimeTypeYamlApp, MimeTypeYaml, MimeTypeYamlRpc,
%endif
%ifndef NoXml
                MimeTypeXml, MimeTypeXmlApp,
%endif
%ifndef NoJson
                MimeTypeJsonRpc,
%endif
%ifndef NoCbor
                MimeTypeCbor,
%endif
                MimeTypeFormUrlEncoded,
                MimeTypeText,
                MimeTypeOctetStream,
            );

            #! Accept header value
            const Accept = AcceptList.join(",");

            #! Map of acceptable Mime types
            const AcceptMap = map {$1: True}, AcceptList;

            #! RestClientIo Version
            const Version = "1.0";

            #! RestClientIo Version String
            const VersionString = sprintf("Qore-RestClientIo/%s", RestClientIo::Version);

            #! default HTTP headers (Content-Type is added before sending)
            const DefaultHeaders = {
                "Accept": Accept,
                "User-Agent": RestClientIo::VersionString,
            };
        }

        #! Creates a new RestClientIo with the given options
        /** @param opts constructor options; see class documentation for valid keys
            @param shared_mgr an optional shared @ref HttpClientIo::HttpClientConnectionManager
                "HttpClientConnectionManager" to use instead of creating a new one. When provided,
                the manager is not closed by @ref close() — the caller retains ownership.
                This allows multiple RestClientIo instances to share a single connection pool,
                reducing connection overhead for services that talk to the same host.

            @throw RESTCLIENTIO-ERROR if the \c url option is missing or invalid
        */
        constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr) {
            if (!opts.url) {
                throw "RESTCLIENTIO-ERROR", "url option is required";
            }
            url = opts.url;
            @assert(url.val());

            # Extract username/password from URL if not provided as explicit options
            if (!opts.username) {
                hash<UrlInfo> url_info = parse_url(url);
                if (url_info.username) {
                    opts.username = url_info.username;
                    opts.password = url_info.password;
                }
            }

            # Initialize logger first so it's available for other components
            if (opts.logger instanceof LoggerInterface) {
                logger = cast<LoggerInterface>(opts.logger);
            }

            if (opts.validator instanceof RestSchemaValidator::AbstractRestSchemaValidator) {
                validator = cast<RestSchemaValidator::AbstractRestSchemaValidator>(opts.validator);
            } else {
                validator = new RestSchemaValidator::NullRestSchemaValidator();
            }

            headers += DefaultHeaders + opts.headers;

            setSerialization(opts.data ?? "auto");

            if (opts.send_encoding) {
                setSendEncoding(opts.send_encoding);
            }

            if (opts.token) {
                string tt = opts.token_type ?? "Bearer";
                setToken(tt, opts.token, NOTHING, opts.oauth2_token_expiry);
                # Clear token_timestamp — the token was loaded from connection options,
                # not freshly acquired via OAuth2; the MinimumTokenRefresh guard in
                # canRetryAuth() must not prevent a refresh when the server rejects
                # this pre-existing token with 401
                {
                    AutoWriteLock al(config_lock);
                    token_timestamp = 1970-01-01Z;
                }
            }

            error_passthru = opts.error_passthru.toBool();
            allow_any_response = opts.allow_any_response.toBool();
            noCharset = opts.no_charset.toBool();

            # Content encoding
            if (opts.content_encoding) {
                setContentEncoding(opts.content_encoding);
            }

            # Connection path: use explicit default_path if provided, otherwise extract from URL
            if (opts.default_path) {
                connection_path = opts.default_path;
            } else {
                *string url_path = parse_url(url).path;
                if (url_path.val() && url_path != "/") {
                    connection_path = url_path;
                }
            }

            # OAuth2 options
            if (opts.oauth2_grant_type) {
                oauth2_grant_type = opts.oauth2_grant_type;
            }
            if (opts.oauth2_client_id) {
                oauth2_client_id = opts.oauth2_client_id;
            }
            if (opts.oauth2_client_secret) {
                oauth2_client_secret = opts.oauth2_client_secret;
            }
            if (opts.oauth2_token_url) {
                oauth2_token_url = opts.oauth2_token_url;
            }
            if (opts.oauth2_alt_token_url) {
                oauth2_alt_token_url = opts.oauth2_alt_token_url;
            }
            if (opts.oauth2_scopes) {
                oauth2_scopes = opts.oauth2_scopes;
            }
            if (opts.oauth2_scope_separator_char) {
                oauth2_scope_separator_char = opts.oauth2_scope_separator_char;
            }
            if (opts.oauth2_auth_args) {
                oauth2_auth_args = opts.oauth2_auth_args;
            }
            if (opts.oauth2_token_args) {
                oauth2_token_args = opts.oauth2_token_args;
            }
            if (opts.oauth2_auth_url) {
                oauth2_auth_url = opts.oauth2_auth_url;
            }
            if (opts.oauth2_redirect_url) {
                oauth2_redirect_url = opts.oauth2_redirect_url;
            }
            if (exists opts.oauth2_auto_refresh) {
                oauth2_auto_refresh = opts.oauth2_auto_refresh.toBool();
            }
            if (exists opts.oauth2_token_use_basic_auth) {
                oauth2_token_use_basic_auth = opts.oauth2_token_use_basic_auth.toBool();
            }
            if (exists opts.oauth2_token_auth_secret_only) {
                oauth2_token_auth_secret_only = opts.oauth2_token_auth_secret_only.toBool();
            }
            if (exists opts.oauth2_token_expiry_hint) {
                oauth2_token_expiry_hint = opts.oauth2_token_expiry_hint.toInt();
            }
            if (opts.oauth2_refresh_token) {
                refresh_token = opts.oauth2_refresh_token;
            }
            if (opts.username) {
                username = opts.username;
            }
            if (opts.password) {
                password = opts.password;
            }
            # Option update callback for notifying the connection about token changes
            update_options = remove opts.update_options;
            checkOAuth2Options(opts);

            # HTTP Basic auth: set if username provided and no OAuth2 grant type configured
            if (opts.username && (!oauth2_grant_type || oauth2_grant_type == "none")) {
                setUserPassword(opts.username, opts.password);
            }

            if (shared_mgr) {
                # Use shared manager — caller retains ownership
                mgr = shared_mgr;
                owns_mgr = False;
            } else {
                mgr = buildConnectionManager(opts);
            }

            # Acquire initial OAuth2 token if configured; skip_login defers to the first
            # request (for non-blocking ping operations that use the existing token as-is)
            if (!opts.skip_login) {
                checkLogin();
            }
        }

        #! Copying is not supported
        private copy() {
            throw "COPY-ERROR", "RestClientIo objects cannot be copied";
        }

        #! Returns the target URL
        string getUrl() {
            return url;
        }

        #! Returns the target URL with any password masked for safe display/logging
        string getSafeUrl() {
            return regex_subst(url, "://([^:/@]+):([^@]+)@", "://$1:***@");
        }

        #! Returns the underlying connection manager
        HttpClientIo::HttpClientConnectionManager getConnectionManager() {
            return mgr;
        }

        #! Returns the logger for this client
        *LoggerInterface getLogger() {
            return logger;
        }

        #! Sets the logger for this client
        setLogger(*LoggerInterface logger) {
            self.logger = logger;
            mgr.setLogger(logger);
        }

        #! Sets whether any response content type is allowed
        /** When True, deserialization errors are silently ignored and the raw body is
            returned instead of throwing a \c DESERIALIZATION-ERROR exception.
        */
        setAllowAnyResponse(bool allow = True) {
            AutoWriteLock al(config_lock);
            allow_any_response = allow;
        }

        #! Returns True if any response content type is allowed
        bool getAllowAnyResponse() {
            AutoReadLock al(config_lock);
            return allow_any_response;
        }

        #! Sets the content encoding and accept-encoding header
        /** @param enc the encoding option (e.g., "auto", "gzip", "bzip2", "deflate", "identity")
        */
        setContentEncoding(string enc = "auto") {
            setSendEncoding(enc);
            AutoWriteLock al(config_lock);
            headers."accept-encoding" = seh.ce ?? "identity";
        }

        #! Returns the current REST schema validator
        RestSchemaValidator::AbstractRestSchemaValidator getValidator() {
            AutoReadLock al(config_lock);
            return validator;
        }

        #! Sets the REST schema validator
        /** @param new_validator the new validator to use for request/response processing
        */
        setValidator(RestSchemaValidator::AbstractRestSchemaValidator new_validator) {
            AutoWriteLock al(config_lock);
            validator = new_validator;
        }

        #! Sets the connection path prepended to all request paths
        /** @param path the connection path (e.g., \c "/api/v2")
        */
        setConnectionPath(*string path) {
            AutoWriteLock al(config_lock);
            connection_path = path;
        }

        #! Returns the current connection path
        *string getConnectionPath() {
            AutoReadLock al(config_lock);
            return connection_path;
        }

        #! Clears the connection path
        clearConnectionPath() {
            setConnectionPath();
        }

        #! Sets the username and password for HTTP Basic authentication
        /** @param user the username
            @param pass the password (optional)
        */
        setUserPassword(string user, *string pass) {
            AutoWriteLock al(config_lock);
            basic_auth_user = user;
            basic_auth_pass = pass ?? "";
            headers."authorization" = "Basic " + make_base64_string(user + ":" + (pass ?? ""));
        }

        #! Clears the username and password for HTTP Basic authentication
        clearUserPassword() {
            AutoWriteLock al(config_lock);
            remove basic_auth_user;
            remove basic_auth_pass;
            remove headers."authorization";
        }

        #! Returns connection pool statistics
        hash<auto> getStats() {
            return mgr.getStats();
        }

        #! Sends an HTTP \c GET request and returns a @ref RestClient::RestResponseInfo hash
        hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
            return restDoRequest("GET", path, NOTHING, hdr);
        }

        #! Sends an HTTP \c HEAD request and returns a @ref RestClient::RestResponseInfo hash
        hash<RestClient::RestResponseInfo> restHead(string path, *hash<auto> hdr) {
            return restDoRequest("HEAD", path, NOTHING, hdr);
        }

        #! Sends an HTTP \c OPTIONS request and returns a @ref RestClient::RestResponseInfo hash
        hash<RestClient::RestResponseInfo> restOptions(string path, *hash<auto> hdr) {
            return restDoRequest("OPTIONS", path, NOTHING, hdr);
        }

        #! Sends an HTTP \c POST request and returns a @ref RestClient::RestResponseInfo hash
        hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
            return restDoRequest("POST", path, body, hdr);
        }

        #! Sends an HTTP \c PUT request and returns a @ref RestClient::RestResponseInfo hash
        hash<RestClient::RestResponseInfo> restPut(string path, auto body, *hash<auto> hdr) {
            return restDoRequest("PUT", path, body, hdr);
        }

        #! Sends an HTTP \c PATCH request and returns a @ref RestClient::RestResponseInfo hash
        hash<RestClient::RestResponseInfo> restPatch(string path, auto body, *hash<auto> hdr) {
            return restDoRequest("PATCH", path, body, hdr);
        }

        #! Sends an HTTP \c DELETE request and returns a @ref RestClient::RestResponseInfo hash
        hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
            return restDoRequest("DELETE", path, body, hdr);
        }

        #! Sends a generic async REST request and returns a cancellable Future
        /** Prepares the request (OAuth2 token refresh, body serialization, auth headers)
            and submits it via the multiplexed connection manager. Returns an
            @ref HttpClientIo::HttpCancellableFuture that the caller can cancel to abort
            the in-flight HTTP request at the protocol level.

            Unlike @ref restDoRequestAsync() which returns a @ref RestFuture with response
            deserialization, this method returns a raw
            @ref HttpClientIo::HttpCancellableFuture — the caller receives the raw HTTP
            response hash and is responsible for deserialization.

            @param method HTTP method
            @param path request path
            @param body request body (optional)
            @param hdr request headers (optional)

            @return an @ref HttpClientIo::HttpCancellableFuture that resolves to the raw
            HTTP response hash and supports
            @ref HttpClientIo::HttpCancellableFuture::cancel() "cancel()"

            @since %RestClientIo 1.3
        */
        HttpClientIo::HttpCancellableFuture restDoRequestCancellableAsync(string method,
                string path, auto body, *hash<auto> hdr) {
            ensureToken();

            hash<auto> prepared = prepareRequest(method, \path, body, \hdr);

            log(LoggerLevel::DEBUG, "restDoRequestCancellableAsync() %s %s%s", method, url, path);

            return mgr.requestAsync(url, method, path, hdr, prepared.serialized_body);
        }

        #! Sends a generic REST request and returns a @ref RestClient::RestResponseInfo hash
        hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body,
                *hash<auto> hdr) {
            ensureToken();

            # 1. Snapshot config state and serialize body
            hash<auto> prepared = prepareRequest(method, \path, body, \hdr);

            log(LoggerLevel::DEBUG, "restDoRequest() %s %s%s", method, url, path);

            # 2. Make HTTP request via multiplexed connection manager
            hash<auto> raw = mgr.request(url, method, path, hdr, prepared.serialized_body);

            # 3. If 401 and OAuth2 configured, try to refresh token and retry once
            if (raw.status_code == 401 && canRetryAuth()) {
                try {
                    getNewTokenIntern();
                } catch () {
                    # If refresh fails, return the original 401 response
                    return buildResponse(raw, prepared.error_passthru,
                        prepared.allow_any_response, method, path, hdr,
                        prepared.serialized_body);
                }
                # Strip stale authorization from hdr — prepareRequest() merges as
                # hdr = {} + headers + hdr, so the old value would override the
                # freshly-refreshed token in headers
                hdr -= "authorization";
                # Re-snapshot headers with new token
                prepared = prepareRequest(method, \path, body, \hdr);
                raw = mgr.request(url, method, path, hdr, prepared.serialized_body);
            }

            # 4. Deserialize and return — pass request context for info fields
            return buildResponse(raw, prepared.error_passthru,
                prepared.allow_any_response, method, path, hdr,
                prepared.serialized_body);
        }

        #! Sends an async generic REST request and returns a RestFuture
        /** The returned @ref RestFuture wraps a raw HTTP response Future and
            deserializes the response when \c get() is called.

            @param method HTTP method
            @param path request path
            @param body request body (optional)
            @param hdr request headers (optional)

            @return a RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture restDoRequestAsync(string method, string path, auto body, *hash<auto> hdr) {
            ensureToken();

            # 1. Snapshot config state and serialize body
            hash<auto> prepared = prepareRequest(method, \path, body, \hdr);
            bool req_error_passthru = prepared.error_passthru;
            bool req_allow_any_response = prepared.allow_any_response;

            log(LoggerLevel::DEBUG, "restDoRequestAsync() %s %s%s", method, url, path);

            # 2. Submit async request — returns a Future for the raw HTTP response
            #    The stream handle keeps the Promise alive internally via request_promise
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
            Future raw_future = stream.requestAsync(method, path, hdr, prepared.serialized_body);

            # 3. Wrap in RestFuture with a closure that deserializes on get()
            #    Capture request context for info fields
            *hash<auto> req_hdr = hdr;
            *data req_body = prepared.serialized_body;
            code<hash<RestClient::RestResponseInfo>(hash<auto>)> builder =
                hash<RestClient::RestResponseInfo> sub (hash<auto> raw) {
                    return buildResponse(raw, req_error_passthru, req_allow_any_response,
                        method, path, req_hdr, req_body);
                };

            return new RestFuture(raw_future, stream, builder);
        }

        #! Submits a non-blocking REST request and returns a Future
        /** Prepares the request (OAuth2 token, serialization, auth headers) and submits it
            via the multiplexed connection manager. The result is delivered via the returned
            Future — resolved by a C++ PromiseAction on the I/O thread (no user code on I/O
            thread).

            @note This method may block for OAuth2 token refresh unless
            \a skip_ensure_token is \c True.

            @param method HTTP method
            @param path request path
            @param body request body (optional)
            @param hdr request headers (optional)
            @param skip_ensure_token if True, skip synchronous OAuth2 token check (use existing token as-is)

            @return a Future that resolves to the response hash

            @since %RestClientIo 1.1
        */
        Future restDoRequestAsync(string method, string path, auto body, *hash<auto> hdr,
                *bool skip_ensure_token) {
            if (!skip_ensure_token) {
                ensureToken();
            }

            hash<auto> prepared = prepareRequest(method, \path, body, \hdr);

            log(LoggerLevel::DEBUG, "restDoRequestAsync() %s %s%s", method, url, path);

            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
            hash<auto> result = stream.submitAsync(method, path, hdr,
                prepared.serialized_body);
            return result.future;
        }

        #! Submits an async REST request and signals an EventNotifier on completion
        /** Like restDoRequestAsync() but uses CompositeAction (Promise + EventNotifier) so
            the I/O thread signals @a notifier when the response arrives.  The caller's
            continuePoll() can then call Future::get() non-blockingly — no background thread.

            The caller is responsible for ensuring the token is fresh before calling
            (check requiresRefresh(), call startOAuth2PollRefreshToken() if needed).

            @param method HTTP method
            @param path request path
            @param body request body (optional)
            @param hdr request headers (optional)
            @param notifier EventNotifier to signal on response completion

            @return hash with "future" (Future) and "stream_id" (int)

            @since %RestClientIo 1.2
        */
        hash<auto> restDoRequestAsyncWithNotifier(string method, string path, auto body,
                *hash<auto> hdr, EventNotifier notifier) {
            hash<auto> prepared = prepareRequest(method, \path, body, \hdr);

            log(LoggerLevel::DEBUG, "restDoRequestAsyncWithNotifier() %s %s%s", method, url, path);

            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
            return stream.submitAsyncWithNotifier(method, path, hdr,
                prepared.serialized_body, notifier);
        }

        #! Submits a raw async request with a pre-serialized body and signals an EventNotifier
        /** Like restDoRequestAsyncWithNotifier() but skips prepareRequest() — the body
            and headers are sent as-is.  Used for OAuth2 token requests where the body
            is already form-urlencoded.

            @param method HTTP method
            @param path request path
            @param hdr request headers
            @param body pre-serialized request body
            @param notifier EventNotifier to signal on response completion

            @return hash with "future" (Future) and "stream_id" (int)

            @since %RestClientIo 1.2
        */
        hash<auto> doRequestRawAsyncWithNotifier(string method, string path, *hash<auto> hdr,
                *data body, EventNotifier notifier) {
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
            return stream.submitAsyncWithNotifier(method, path, hdr, body, notifier);
        }

        #! Returns True if the current OAuth2 token needs to be refreshed
        /** @return True if the token exists, has a refresh token, and is within the expiry window

            @since %RestClientIo 1.2
        */
        bool tokenRequiresRefresh() {
            return requiresRefresh();
        }

        #! Starts an async OAuth2 token refresh poll operation
        /** Returns an AbstractPollOperation that drives an HTTP POST to the token endpoint
            using socket-level polling (no background threads, no blocking I/O on the I/O thread).
            When the poll operation completes, call updateOAuth2Token() with the parsed response.

            @return an AbstractPollOperation for the token refresh HTTP request

            @since %RestClientIo 1.2
        */
        hash<auto> startOAuth2PollRefreshToken() {
            # Read OAuth2 config under lock — mirrors doOAuth2TokenRequest() setup
            string token_url_str;
            hash<auto> login;
            bool use_basic_auth;
            bool auth_secret_only;
            bool has_alt_token_url;
            {
                AutoReadLock al(config_lock);
                token_url_str = oauth2_alt_token_url ?? oauth2_token_url;
                has_alt_token_url = oauth2_alt_token_url.val();
                use_basic_auth = oauth2_token_use_basic_auth;
                auth_secret_only = oauth2_token_auth_secret_only;
                login = refresh_token.val()
                    ? getOAuth2RefreshInfo()
                    : getOAuth2LoginInfo(oauth2_grant_type);
            }

            # Determine base URL and request path (same logic as doOAuth2TokenRequest)
            string base_url_str;
            string req_path;
            if (token_url_str =~ /^https?:\/\//) {
                hash<UrlInfo> ui = parse_url(token_url_str);
                base_url_str = sprintf("%s://%s", ui.protocol, ui.host);
                if (ui.port) {
                    base_url_str += sprintf(":%d", ui.port);
                }
                req_path = ui.path ?? "/";
            } else {
                base_url_str = url;
                req_path = token_url_str;
            }

            # Build request headers — same logic as doOAuth2TokenRequest()
            hash<auto> auth_hdr = {
                "accept": MimeTypeFormUrlEncoded + "," + MimeTypeJson,
                "content-type": MimeTypeFormUrlEncoded,
            };
            if (!has_alt_token_url) {
                if (use_basic_auth && login.client_id.val() && login.client_secret.val()) {
                    auth_hdr."authorization" = "Basic "
                        + make_base64_string(login.client_id + ":" + login.client_secret);
                    login -= ("client_id", "client_secret");
                } else if (auth_secret_only && login.client_secret.val()) {
                    auth_hdr."authorization" = "Basic "
                        + make_base64_string(":" + login.client_secret);
                    login -= ("client_id", "client_secret");
                }
            }
            if (has_alt_token_url && alt_token_signer && alt_token_signer_header) {
                string body_str = mime_get_form_urlencoded_string(login);
                auth_hdr{alt_token_signer_header} = alt_token_signer({
                    "method": "POST", "path": req_path,
                    "body": body_str, "hdr": auth_hdr,
                });
            }

            # Serialize body as form-urlencoded
            string body_str = mime_get_form_urlencoded_string(login);

            # Return a RestClientIo pointing at the token endpoint plus the request
            # parameters. The caller starts the connection async and submits the
            # request once the connection is ready — fully event-driven.
            return {
                "rcio": new RestClientIo({"url": base_url_str}),
                "path": req_path,
                "headers": auth_hdr,
                "body": body_str,
            };
        }

        #! Updates the stored OAuth2 token from a parsed token response
        /** Called after startOAuth2PollRefreshToken() completes to store the new token.

            @param h the parsed OAuth2 token response hash

            @since %RestClientIo 1.2
        */
        updateOAuth2Token(hash<auto> h) {
            gotOAuth2LoginInfo(h);
        }

        #! Initiates the underlying HTTP connection asynchronously
        /** Ensures a connection to the configured URL is being established without
            blocking.  Returns an EventNotifier that fires when the connection becomes
            ready (or closes due to an error).  Returns NOTHING if the connection is
            already ready.

            Use this to pre-warm the connection concurrently with other async work
            (e.g., an OAuth2 token refresh) so that \c restDoRequestAsyncWithNotifier()
            can submit the request immediately after both complete.

            @return an EventNotifier to poll for connection readiness, or NOTHING if
            the connection is already ready

            @since %RestClientIo 1.2
        */
        *EventNotifier startConnectionAsync() {
            return mgr.ensureConnectionAsync(url);
        }

        #! Sends a signed REST request
        /** The signer callback receives a hash with \c path (effective, including connection_path),
            \c body (serialized), and \c hdr (merged headers minus the signature header).
            It returns the signature value to place in \c hdr{shdr}.

            @param shdr the header name for the signature
            @param signer callback that computes the signature
            @param method HTTP method
            @param path request path
            @param body request body (optional)
            @param hdr request headers (optional)

            @return the deserialized @ref RestClient::RestResponseInfo hash
        */
        hash<RestClient::RestResponseInfo> doSignedRequest(string shdr, code signer,
                string method, string path, auto body, *hash<auto> hdr) {
            ensureToken();

            # 1. Snapshot config state and serialize body
            hash<auto> prepared = prepareRequest(method, \path, body, \hdr);

            # 2. Call signer with request context
            auto sig = signer({"path": path, "body": prepared.serialized_body,
                "hdr": hdr - shdr});
            hdr{shdr} = sig;

            log(LoggerLevel::DEBUG, "doSignedRequest() %s %s%s", method, url, path);

            # 3. Make HTTP request
            hash<auto> raw = mgr.request(url, method, path, hdr, prepared.serialized_body);

            # 4. If 401 and OAuth2 configured, try to refresh token and retry once
            if (raw.status_code == 401 && canRetryAuth()) {
                try {
                    getNewTokenIntern();
                } catch () {
                    return buildResponse(raw, prepared.error_passthru,
                        prepared.allow_any_response, method, path, hdr,
                        prepared.serialized_body);
                }
                # Strip stale authorization from hdr (see restDoRequest comment)
                hdr -= "authorization";
                # Re-snapshot headers with new token
                prepared = prepareRequest(method, \path, body, \hdr);
                sig = signer({"path": path, "body": prepared.serialized_body,
                    "hdr": hdr - shdr});
                hdr{shdr} = sig;
                raw = mgr.request(url, method, path, hdr, prepared.serialized_body);
            }

            # 5. Deserialize and return
            return buildResponse(raw, prepared.error_passthru,
                prepared.allow_any_response, method, path, hdr,
                prepared.serialized_body);
        }

        #! Sends an async signed REST request and returns a RestFuture
        /** The signer callback receives a hash with \c path (effective, including connection_path),
            \c body (serialized), and \c hdr (merged headers minus the signature header).
            It returns the signature value to place in \c hdr{shdr}.

            @param shdr the header name for the signature
            @param signer callback that computes the signature
            @param method HTTP method
            @param path request path
            @param body request body (optional)
            @param hdr request headers (optional)

            @return a @ref RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture doSignedRequestAsync(string shdr, code signer, string method,
                string path, auto body, *hash<auto> hdr) {
            ensureToken();

            # 1. Snapshot config state and serialize body
            hash<auto> prepared = prepareRequest(method, \path, body, \hdr);
            bool req_error_passthru = prepared.error_passthru;
            bool req_allow_any_response = prepared.allow_any_response;

            # 2. Call signer with request context
            auto sig = signer({"path": path, "body": prepared.serialized_body,
                "hdr": hdr - shdr});
            hdr{shdr} = sig;

            log(LoggerLevel::DEBUG, "doSignedRequestAsync() %s %s%s", method, url, path);

            # 3. Submit async request
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
            Future raw_future = stream.requestAsync(method, path, hdr,
                prepared.serialized_body);

            # 4. Wrap in RestFuture
            *hash<auto> req_hdr = hdr;
            *data req_body = prepared.serialized_body;
            code<hash<RestClient::RestResponseInfo>(hash<auto>)> builder =
                hash<RestClient::RestResponseInfo> sub (hash<auto> raw) {
                    return buildResponse(raw, req_error_passthru, req_allow_any_response,
                        method, path, req_hdr, req_body);
                };

            return new RestFuture(raw_future, stream, builder);
        }

        #! Sends an async HTTP \c GET request and returns a RestFuture
        /** @return a @ref RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture restGetAsync(string path, *hash<auto> hdr) {
            return restDoRequestAsync("GET", path, NOTHING, hdr);
        }

        #! Sends an async HTTP \c POST request and returns a RestFuture
        /** @return a @ref RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture restPostAsync(string path, auto body, *hash<auto> hdr) {
            return restDoRequestAsync("POST", path, body, hdr);
        }

        #! Sends an async HTTP \c PUT request and returns a RestFuture
        /** @return a @ref RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture restPutAsync(string path, auto body, *hash<auto> hdr) {
            return restDoRequestAsync("PUT", path, body, hdr);
        }

        #! Sends an async HTTP \c PATCH request and returns a RestFuture
        /** @return a @ref RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture restPatchAsync(string path, auto body, *hash<auto> hdr) {
            return restDoRequestAsync("PATCH", path, body, hdr);
        }

        #! Sends an async HTTP \c DELETE request and returns a RestFuture
        /** @return a @ref RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture restDelAsync(string path, auto body, *hash<auto> hdr) {
            return restDoRequestAsync("DELETE", path, body, hdr);
        }

        #! Sends an async HTTP \c HEAD request and returns a RestFuture
        /** @return a @ref RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture restHeadAsync(string path, *hash<auto> hdr) {
            return restDoRequestAsync("HEAD", path, NOTHING, hdr);
        }

        #! Sends an async HTTP \c OPTIONS request and returns a RestFuture
        /** @return a @ref RestFuture that resolves to a @ref RestClient::RestResponseInfo hash
        */
        RestFuture restOptionsAsync(string path, *hash<auto> hdr) {
            return restDoRequestAsync("OPTIONS", path, NOTHING, hdr);
        }

        #! Internal: snapshots config state and serializes the request body
        /** @param method HTTP method
            @param path request path
            @param body request body (optional)
            @param hdr reference to headers hash (merged with defaults)

            @return a hash with \c serialized_body and \c error_passthru keys
        */
        private hash<auto> prepareRequest(string method, reference<string> path, auto body,
                reference<*hash<auto>> hdr) {
            # Normalize path to be absolute (HTTP/2/3 :path pseudo-header requires leading "/")
            if (path.val() && path[0] != "/") {
                path = "/" + path;
            } else if (!path.val()) {
                path = "/";
            }

            *string req_sct;
            *hash<auto> req_seh;
            bool req_no_charset;
            bool req_error_passthru;
            bool req_allow_any_response;
            *string req_connection_path;
            RestSchemaValidator::AbstractRestSchemaValidator req_validator;
            {
                AutoReadLock al(config_lock);
                hdr = {} + headers + hdr;
                req_sct = sct;
                req_seh = seh;
                req_no_charset = noCharset;
                req_error_passthru = error_passthru;
                req_allow_any_response = allow_any_response;
                req_connection_path = connection_path;
                req_validator = validator;
            }

            # Apply connection path (avoid double-prepending)
            if (req_connection_path.val()
                    && path.substr(0, req_connection_path.length()) != req_connection_path) {
                path = req_connection_path + path;
            }

            # Normalize header keys to lowercase for HTTP/2 and HTTP/3 compatibility
            hdr = map {$1.key.lwr(): $1.value}, hdr.pairIterator();

            *data serialized_body;
            if (exists body) {
                hash<RestSchemaValidator::RestRequestClientInfo> req = req_validator.processRequest(
                    method, path, body, hdr, req_sct);
                serialized_body = req.body;
                # Use lowercase header keys for HTTP/2 and HTTP/3 compatibility
                if (!hdr."content-type") {
                    hdr."content-type" = req.content;
                }
                if (!req_no_charset && serialized_body.typeCode() == NT_STRING
                        && hdr."content-type" !~ /;charset=/) {
                    hdr."content-type" += ";charset=" + serialized_body.encoding();
                }
                if (req_seh.ce && serialized_body.size() > RestClient::RestClient::CompressionThreshold) {
                    hdr."content-encoding" = req_seh.ce;
                    serialized_body = req_seh.func(serialized_body);
                }
            }

            return {
                "serialized_body": serialized_body,
                "error_passthru": req_error_passthru,
                "allow_any_response": req_allow_any_response,
            };
        }

        #! Internal: deserializes a raw HTTP response into a RestResponseInfo hash
        /** @param raw the raw HTTP response hash (status_code, headers, body)
            @param req_error_passthru if False, throw on HTTP error responses
            @param method HTTP method (for validator)
            @param path request path (for validator)

            @return the deserialized RestResponseInfo hash

            @throw REST-RESPONSE-ERROR if \a req_error_passthru is False and status >= 300
        */
        private hash<RestClient::RestResponseInfo> buildResponse(hash<auto> raw,
                bool req_error_passthru, bool req_allow_any_response, string method,
                string path, *hash<auto> request_headers, *data request_body) {
            @assert(raw.hasKey("status_code"));
            @assert(raw.hasKey("headers"));

            # Snapshot validator for thread-safe access
            RestSchemaValidator::AbstractRestSchemaValidator resp_validator;
            {
                AutoReadLock al(config_lock);
                resp_validator = validator;
            }

            auto resp_body = raw.body;
            # Convert binary body to string for text-based content types so that
            # deserialization (JSON, XML, etc.) works correctly — HTTP/2 and HTTP/3
            # responses return binary bodies from the C++ layer
            *string content_type = raw.headers."content-type";
            if (resp_body && resp_body.typeCode() == NT_BINARY && content_type) {
                if (content_type =~ /^text\// || content_type =~ /\/(json|xml|yaml|html)/
                        || content_type =~ /\+(json|xml)/ || content_type =~ /charset=/) {
                    resp_body = resp_body.toString();
                }
            }
            *data response_body_raw = raw.body;
            if (exists resp_body && content_type) {
                try {
                    hash<RestSchemaValidator::RestResponseClientInfo> parsed =
                        resp_validator.parseResponse(
                            method, path, raw.status_code, resp_body, raw.headers);
                    resp_body = parsed.body;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "DESERIALIZATION-ERROR" || !req_allow_any_response) {
                        rethrow;
                    }
                    # allow_any_response: deserialization failed, keep raw body
                }
            }

            if (!req_error_passthru && raw.status_code >= 300) {
                throw "REST-RESPONSE-ERROR",
                    sprintf("HTTP %d response received", raw.status_code),
                    <RestClient::RestResponseInfo>{
                        "status_code": raw.status_code,
                        "headers": raw.headers,
                        "body": resp_body,
                        "content_type": content_type,
                        "response_body_raw": response_body_raw,
                        "request_method": method,
                        "request_path": path,
                        "request_headers": request_headers,
                        "request_body": request_body,
                        "protocol": raw.protocol,
                    };
            }

            return <RestClient::RestResponseInfo>{
                "status_code": raw.status_code,
                "headers": raw.headers,
                "body": resp_body,
                "content_type": content_type,
                "response_body_raw": response_body_raw,
                "request_method": method,
                "request_path": path,
                "request_headers": request_headers,
                "request_body": request_body,
                "protocol": raw.protocol,
            };
        }

        #! Sets the data serialization format
        /** @param data the serialization option (e.g., "auto", "json", "yaml", "xml", "cbor", "url",
            "text", "bin")

            @throw RESTCLIENT-ERROR invalid or unsupported serialization option
        */
        setSerialization(string data = "auto") {
            if (!RestClient::RestClient::DataSerializationOptions{data}) {
                throw "RESTCLIENT-ERROR",
                    sprintf("data serialization option %y is unknown; valid options: %y", data,
                        RestClient::RestClient::DataSerializationOptions.keys());
            }
            log(LoggerLevel::DEBUG, "setSerialization() %y", data);
            AutoWriteLock al(config_lock);
            if (data == "auto" && RestClient::RestClient::DataSerializationSupport) {
                delete sct;
            } else {
                if (!RestClient::RestClient::DataSerializationSupport{data}) {
                    throw "RESTCLIENT-ERROR",
                        sprintf("data serialization option %y is not supported because the required "
                            "module could not be loaded; currently supported options: %y", data,
                            keys RestClient::RestClient::DataSerializationSupport);
                }
                sct = RestClient::RestClient::DataSerializationSupport{data};
            }
            ds = data;
        }

        #! Returns the current data serialization format
        string getSerialization() {
            AutoReadLock al(config_lock);
            return ds;
        }

        #! Sets the send encoding (compression) format
        /** @param enc the encoding option (e.g., "auto", "gzip", "bzip2", "deflate", "identity")

            @throw RESTCLIENT-ERROR invalid or unsupported encoding option
        */
        setSendEncoding(string enc = "auto") {
            AutoWriteLock al(config_lock);
            if (enc == "auto") {
                seh = RestClient::RestClient::EncodingSupport.firstValue();
            } else {
                if (!RestClient::RestClient::EncodingSupport{enc}) {
                    throw "RESTCLIENT-ERROR",
                        sprintf("send content encoding option %y is unknown; valid options: %y",
                            enc, keys RestClient::RestClient::EncodingSupport);
                }
                seh = RestClient::RestClient::EncodingSupport{enc};
            }
        }

        #! Returns the current send encoding format
        *string getSendEncoding() {
            AutoReadLock al(config_lock);
            return seh.ce;
        }

        #! Adds default headers to each request
        addDefaultHeaders(hash<auto> h) {
            AutoWriteLock al(config_lock);
            headers += h;
        }

        #! Returns the hash of default headers
        hash<auto> getDefaultHeaders() {
            AutoReadLock al(config_lock);
            return headers;
        }

        #! Replaces default headers
        replaceDefaultHeaders(*hash<auto> hdr) {
            AutoWriteLock al(config_lock);
            remove headers;
            headers += DefaultHeaders + hdr;
        }

        #! Sets a token for authentication
        /** @param token_type the token type (e.g., "Bearer")
            @param token the access token
            @param new_refresh_token an optional refresh token
            @param token_expiry an optional token expiry timestamp
        */
        setToken(string token_type, string token, *string new_refresh_token, *date token_expiry) {
            if (token_type == "bearer") {
                token_type = "Bearer";
            }
            AutoWriteLock al(config_lock);
            token_type_val = token_type;
            token_val = token;
            headers += {"authorization": sprintf("%s %s", token_type, token)};
            if (new_refresh_token) {
                self.refresh_token = new_refresh_token;
            }
            if (token_expiry) {
                oauth2_token_expiry = token_expiry;
            } else if (oauth2_token_expiry_hint) {
                oauth2_token_expiry = now_us() + seconds(oauth2_token_expiry_hint);
            }
            token_timestamp = now_us();
        }

        #! Returns any token set for the connection
        *string getToken() {
            AutoReadLock al(config_lock);
            return token_val;
        }

        #! Returns the token type
        string getTokenType() {
            AutoReadLock al(config_lock);
            return token_type_val ?? "Bearer";
        }

        #! Sets OAuth2 options
        /** @param new_opts a hash of OAuth2 options to set

            @throw OAUTH2-ERROR if the options are invalid
        */
        setOAuth2Options(hash<auto> new_opts) {
            {
                AutoWriteLock al(config_lock);
                if (new_opts.oauth2_grant_type) {
                    oauth2_grant_type = new_opts.oauth2_grant_type;
                }
                if (new_opts.oauth2_client_id) {
                    oauth2_client_id = new_opts.oauth2_client_id;
                }
                if (new_opts.oauth2_client_secret) {
                    oauth2_client_secret = new_opts.oauth2_client_secret;
                }
                if (new_opts.oauth2_token_url) {
                    oauth2_token_url = new_opts.oauth2_token_url;
                }
                if (new_opts.oauth2_alt_token_url) {
                    oauth2_alt_token_url = new_opts.oauth2_alt_token_url;
                }
                if (new_opts.oauth2_scopes) {
                    oauth2_scopes = new_opts.oauth2_scopes;
                }
                if (new_opts.oauth2_scope_separator_char) {
                    oauth2_scope_separator_char = new_opts.oauth2_scope_separator_char;
                }
                if (new_opts.oauth2_auth_args) {
                    oauth2_auth_args = new_opts.oauth2_auth_args;
                }
                if (new_opts.oauth2_token_args) {
                    oauth2_token_args = new_opts.oauth2_token_args;
                }
                if (new_opts.oauth2_auth_url) {
                    oauth2_auth_url = new_opts.oauth2_auth_url;
                }
                if (new_opts.oauth2_redirect_url) {
                    oauth2_redirect_url = new_opts.oauth2_redirect_url;
                }
                if (exists new_opts.oauth2_auto_refresh) {
                    oauth2_auto_refresh = new_opts.oauth2_auto_refresh.toBool();
                }
                if (exists new_opts.oauth2_token_use_basic_auth) {
                    oauth2_token_use_basic_auth = new_opts.oauth2_token_use_basic_auth.toBool();
                }
                if (exists new_opts.oauth2_token_auth_secret_only) {
                    oauth2_token_auth_secret_only = new_opts.oauth2_token_auth_secret_only.toBool();
                }
                if (exists new_opts.oauth2_token_expiry_hint) {
                    oauth2_token_expiry_hint = new_opts.oauth2_token_expiry_hint.toInt();
                }
                if (new_opts.oauth2_token_expiry) {
                    oauth2_token_expiry = new_opts.oauth2_token_expiry;
                }
                if (new_opts.username) {
                    username = new_opts.username;
                }
                if (new_opts.password) {
                    password = new_opts.password;
                }
            }
            checkOAuth2Options(new_opts);
        }

        #! Returns the current OAuth2 options
        /** @return a hash of OAuth2 option values
        */
        hash<auto> getOAuth2Options() {
            AutoReadLock al(config_lock);
            return {
                "username": username,
                "password": password,
                "token": token_val,
                "token_type": token_type_val,
                "oauth2_auth_args": oauth2_auth_args,
                "oauth2_auth_url": oauth2_auth_url,
                "oauth2_auto_refresh": oauth2_auto_refresh,
                "oauth2_client_id": oauth2_client_id,
                "oauth2_client_secret": oauth2_client_secret,
                "oauth2_grant_type": oauth2_grant_type,
                "oauth2_redirect_url": oauth2_redirect_url,
                "oauth2_refresh_token": refresh_token,
                "oauth2_scopes": oauth2_scopes,
                "oauth2_scope_separator_char": oauth2_scope_separator_char,
                "oauth2_token_args": oauth2_token_args,
                "oauth2_token_auth_secret_only": oauth2_token_auth_secret_only,
                "oauth2_token_expiry": oauth2_token_expiry,
                "oauth2_token_expiry_hint": oauth2_token_expiry_hint,
                "oauth2_token_url": oauth2_token_url,
                "oauth2_alt_token_url": oauth2_alt_token_url,
                "oauth2_token_use_basic_auth": oauth2_token_use_basic_auth,
            };
        }

        #! Sets the callback for option updates (token changes)
        /** @param update_options the callback to set, or NOTHING to clear

            @since %RestClientIo 1.0
        */
        setUpdateOptionsCode(*code update_options) {
            self.update_options = update_options;
        }

        #! Sets the alt token signer callback and header for proxy-based OAuth2 token requests
        /** When set, the signer is called for token requests to the \c oauth2_alt_token_url (proxy),
            and the return value is set in the specified header.

            @param signer the signer callback; receives a hash with \c method, \c path, \c body, and \c hdr keys
            @param signer_header the header name for the signature

            @since %RestClientIo 1.0
        */
        setAltTokenSigner(code signer, string signer_header) {
            alt_token_signer = signer;
            alt_token_signer_header = signer_header;
        }

        #! Clears the alt token signer callback and header
        /** @since %RestClientIo 1.0
        */
        clearAltTokenSigner() {
            remove alt_token_signer;
            remove alt_token_signer_header;
        }

        #! Forces acquisition of a new OAuth2 token
        /** @return the OAuth2 token response hash

            @throw OAUTH2-ERROR if OAuth2 is not configured or token acquisition fails
        */
        hash<auto> getNewToken() {
            date ts;
            {
                AutoReadLock al(config_lock);
                if (!oauth2_grant_type || oauth2_grant_type == "none") {
                    throw "OAUTH2-ERROR", "OAuth2 is not configured; cannot acquire a new token";
                }
                ts = token_timestamp;
            }
            # Check minimum refresh interval for public API
            if (ts.val() && (now_us() - ts) < RestClient::RestClient::MinimumTokenRefresh) {
                throw "OAUTH2-ERROR", "token refresh rate limit exceeded; minimum interval between "
                    "token acquisitions is 1 minute";
            }
            return getNewTokenIntern();
        }

        #! Closes all connections managed by this client
        /** If a shared connection manager was provided to the constructor, this method
            does nothing — the caller retains ownership of the shared manager.
        */
        close() {
            if (owns_mgr) {
                mgr.closeAll();
            }
        }

        #! Internal: logging helper
        private log(int level, string fmt) {
            if (logger) {
                call_function_args(\logger.log(), (level, "RestClientIo: " + fmt) + argv);
            }
        }

        #! Validates OAuth2 options
        /** @param opts the options hash to validate

            @throw OAUTH2-ERROR if the options are invalid
        */
        private checkOAuth2Options(hash<auto> opts) {
            *string grant_type = opts.oauth2_grant_type;
            if (!exists grant_type || grant_type == "none") {
                return;
            }
            *list<string> req_opts = RestClient::RestClient::OAuth2GrantOptions{grant_type};
            if (!req_opts) {
                throw "OAUTH2-ERROR", sprintf("OAuth2 grant type %y is unknown; known grant types: %y",
                    grant_type, keys RestClient::RestClient::OAuth2GrantOptions);
            }
            foreach string req_opt in (req_opts) {
                if (!opts.hasKey(req_opt)) {
                    throw "OAUTH2-ERROR", sprintf("OAuth2 grant type %y requires option %y, but this "
                        "option is not set; options provided: %y", grant_type, req_opt, keys opts);
                }
            }
            if (grant_type == "password") {
                if (!opts.username && !username) {
                    throw "OAUTH2-ERROR", "the 'password' OAuth2 grant type requires a username and "
                        "password; no username is set";
                }
                if (!opts.password && !password) {
                    throw "OAUTH2-ERROR", "the 'password' OAuth2 grant type requires a username and "
                        "password; no password is set";
                }
            }
        }

        #! Returns True if the token needs to be refreshed
        private bool requiresRefresh() {
            AutoReadLock al(config_lock);
            return token_val.val() && refresh_token.val() && oauth2_token_expiry.val()
                && ((now_us() + RestClient::RestClient::Oauth2TokenRefreshWindow) > oauth2_token_expiry);
        }

        #! Checks if an initial OAuth2 login is needed
        private checkLogin() {
            *string grant_type;
            bool has_token;
            {
                AutoReadLock al(config_lock);
                grant_type = oauth2_grant_type;
                has_token = token_val.val();
            }
            if (!has_token && grant_type && grant_type != "none") {
                loginIntern();
            }
        }

        #! Ensures a valid OAuth2 token is available before making a request
        private ensureToken() {
            checkLogin();
            if (!requiresRefresh()) {
                return;
            }
            {
                AutoLock al(oauth2_mutex);
                if (oauth2_refreshing) {
                    oauth2_cond.wait(oauth2_mutex);
                    return;
                }
                oauth2_refreshing = True;
            }
            on_exit {
                AutoLock al(oauth2_mutex);
                oauth2_refreshing = False;
                oauth2_cond.broadcast();
            }
            # Double-check after acquiring the refresh flag
            if (!requiresRefresh()) {
                return;
            }
            getNewTokenIntern();
        }

        #! Returns True if a 401 retry is possible
        private bool canRetryAuth() {
            AutoReadLock al(config_lock);
            return oauth2_grant_type.val() && oauth2_grant_type != "none"
                && oauth2_auto_refresh
                && (now_us() - token_timestamp) >= RestClient::RestClient::MinimumTokenRefresh;
        }

        #! Performs an OAuth2 token request
        /** @param login the login parameters (form-urlencoded body)

            @return the parsed token response hash

            @throw OAUTH2-ERROR if the token request fails
        */
        private hash<auto> doOAuth2TokenRequest(hash<auto> login) {
            # Read token URL and auth config under config lock
            string token_url;
            bool use_basic_auth;
            bool auth_secret_only;
            bool has_alt_token_url;
            {
                AutoReadLock al(config_lock);
                # Use alt token URL if set (routes through a proxy that holds the real client secret)
                token_url = oauth2_alt_token_url ?? oauth2_token_url;
                has_alt_token_url = oauth2_alt_token_url.val();
                use_basic_auth = oauth2_token_use_basic_auth;
                auth_secret_only = oauth2_token_auth_secret_only;
            }

            # Determine base URL and request path
            string base_url;
            string req_path;
            if (token_url =~ /^https?:\/\//) {
                hash<UrlInfo> url_info = parse_url(token_url);
                base_url = sprintf("%s://%s", url_info.protocol, url_info.host);
                if (url_info.port) {
                    base_url += sprintf(":%d", url_info.port);
                }
                req_path = url_info.path ?? "/";
            } else {
                base_url = url;
                req_path = token_url;
            }

            # Build headers (lowercase for HTTP/2/3)
            hash<auto> hdr = {
                "accept": MimeTypeFormUrlEncoded + "," + MimeTypeJson,
                "content-type": MimeTypeFormUrlEncoded,
            };

            # Handle basic auth for token request
            # When using oauth2_alt_token_url, the proxy handles auth — skip local basic auth
            if (!has_alt_token_url) {
                if (use_basic_auth && login.client_id.val() && login.client_secret.val()) {
                    hdr."authorization" = "Basic "
                        + make_base64_string(login.client_id + ":" + login.client_secret);
                    login -= ("client_id", "client_secret");
                } else if (auth_secret_only && login.client_secret.val()) {
                    hdr."authorization" = "Basic "
                        + make_base64_string(":" + login.client_secret);
                    login -= ("client_id", "client_secret");
                }
            }

            # Include signed request header if necessary (for proxy-based token requests)
            if (has_alt_token_url && alt_token_signer && alt_token_signer_header) {
                string body_str = mime_get_form_urlencoded_string(login);
                hdr{alt_token_signer_header} = alt_token_signer({
                    "method": "POST",
                    "path": req_path,
                    "body": body_str,
                    "hdr": hdr,
                });
            }

            # Serialize body as form-urlencoded
            string body = mime_get_form_urlencoded_string(login);

            log(LoggerLevel::DEBUG, "doOAuth2TokenRequest() POST %s%s", base_url, req_path);

            # Make the token request — no locks held during network I/O
            hash<auto> raw = mgr.request(base_url, "POST", req_path, hdr, body);

            # Check for errors
            if (raw.status_code >= 300) {
                auto resp_body = raw.body;
                if (resp_body.typeCode() == NT_BINARY) {
                    resp_body = resp_body.toString();
                }
                if (resp_body.typeCode() == NT_STRING && raw.headers."content-type" =~ /json/i) {
                    try {
                        resp_body = parse_json(resp_body);
                    } catch () {
                        # keep as string
                    }
                }
                throw "OAUTH2-ERROR",
                    sprintf("OAuth2 token request failed with HTTP %d", raw.status_code),
                    {"status_code": raw.status_code, "body": resp_body, "headers": raw.headers};
            }

            # Parse response body
            auto resp_body = raw.body;
            if (resp_body.typeCode() == NT_BINARY) {
                resp_body = resp_body.toString();
            }
            if (resp_body.typeCode() == NT_STRING) {
                if (raw.headers."content-type" =~ /json/i) {
                    return parse_json(resp_body);
                }
                if (raw.headers."content-type" =~ /form-urlencoded/i) {
                    return parse_uri_query("?" + resp_body).params;
                }
                # Default: try JSON
                try {
                    return parse_json(resp_body);
                } catch () {
                    # fall through
                }
            }
            throw "OAUTH2-ERROR", sprintf("Cannot parse OAuth2 token response with content-type %y",
                raw.headers."content-type");
        }

        #! Builds login parameters for an OAuth2 token request
        /** @param grant_type the OAuth2 grant type

            @return the login parameters hash

            @throw OAUTH2-ERROR if the grant type requires browser interaction
        */
        private hash<auto> getOAuth2LoginInfo(string grant_type) {
            if (grant_type == "authorization_code" || grant_type == "implicit") {
                throw "OAUTH2-ERROR", sprintf("This connection is using the '%s' grant type and must "
                    "be manually authorized before it can be used", grant_type);
            }
            string client_id;
            string client_secret;
            *hash<auto> token_args;
            *softlist<string> scopes;
            string scope_sep;
            *string uname;
            *string pwd;
            *string alt_token_url;
            *string token_url;
            bool use_basic_auth;
            bool auth_secret_only;
            {
                AutoReadLock al(config_lock);
                client_id = oauth2_client_id;
                client_secret = oauth2_client_secret;
                token_args = oauth2_token_args;
                scopes = oauth2_scopes;
                scope_sep = oauth2_scope_separator_char;
                uname = username;
                pwd = password;
                alt_token_url = oauth2_alt_token_url;
                token_url = oauth2_token_url;
                use_basic_auth = oauth2_token_use_basic_auth;
                auth_secret_only = oauth2_token_auth_secret_only;
            }
            hash<auto> login = {
                "client_id": client_id,
                "client_secret": client_secret,
                "grant_type": grant_type,
            } + token_args;
            # When using alt token URL, pass the real token URL and auth flags as body args for the proxy
            if (alt_token_url) {
                login.oauth2_token_url = token_url;
                if (use_basic_auth) {
                    login.oauth2_token_use_basic_auth = True;
                } else if (auth_secret_only) {
                    login.oauth2_token_auth_secret_only = True;
                }
            }
            if (scopes) {
                login.scope = (foldl $1 + scope_sep + $2, scopes);
            }
            if (grant_type == "password") {
                login += {
                    "username": uname,
                    "password": pwd ?? "",
                };
            }
            return login;
        }

        #! Builds refresh token parameters for an OAuth2 token refresh request
        /** @return the refresh parameters hash
        */
        private hash<auto> getOAuth2RefreshInfo() {
            string client_id;
            string client_secret;
            *string ref_token;
            *hash<auto> token_args;
            *string alt_token_url;
            *string token_url;
            bool use_basic_auth;
            bool auth_secret_only;
            {
                AutoReadLock al(config_lock);
                client_id = oauth2_client_id;
                client_secret = oauth2_client_secret;
                ref_token = refresh_token;
                token_args = oauth2_token_args;
                alt_token_url = oauth2_alt_token_url;
                token_url = oauth2_token_url;
                use_basic_auth = oauth2_token_use_basic_auth;
                auth_secret_only = oauth2_token_auth_secret_only;
            }
            hash<auto> rv = {
                "client_id": client_id,
                "client_secret": client_secret,
                "grant_type": "refresh_token",
                "refresh_token": ref_token,
            } + token_args;
            # When using alt token URL, pass the real token URL and auth flags as body args for the proxy
            if (alt_token_url) {
                rv.oauth2_token_url = token_url;
                if (use_basic_auth) {
                    rv.oauth2_token_use_basic_auth = True;
                } else if (auth_secret_only) {
                    rv.oauth2_token_auth_secret_only = True;
                }
            }
            return rv;
        }

        #! Performs an initial OAuth2 login
        /** @return the token response hash
        */
        private hash<auto> loginIntern() {
            string grant_type;
            {
                AutoReadLock al(config_lock);
                grant_type = oauth2_grant_type;
            }
            hash<auto> resp = doOAuth2TokenRequest(getOAuth2LoginInfo(grant_type));
            return gotOAuth2LoginInfo(resp);
        }

        #! Acquires a new OAuth2 token (via refresh or re-login)
        /** @return the token response hash

            @throw OAUTH2-ERROR if the token cannot be acquired
        */
        private hash<auto> getNewTokenIntern() {
            bool has_refresh;
            string grant_type;
            {
                AutoReadLock al(config_lock);
                has_refresh = refresh_token.val();
                grant_type = oauth2_grant_type;
            }
            if (has_refresh) {
                hash<auto> resp = doOAuth2TokenRequest(getOAuth2RefreshInfo());
                return gotOAuth2LoginInfo(resp);
            }
            if (grant_type == "authorization_code" || grant_type == "implicit") {
                throw "OAUTH2-ERROR", sprintf("The current token is invalid; no refresh token is in "
                    "place, and the grant type is %y", grant_type);
            }
            # Try to get a new token via login
            return loginIntern();
        }

        #! Processes an OAuth2 login response
        /** @param h the parsed token response hash

            @return the response hash

            @throw OAUTH2-ERROR if the response is invalid
        */
        private hash<auto> gotOAuth2LoginInfo(hash<auto> h) {
            if (h.token_type.typeCode() != NT_STRING || h.access_token.typeCode() != NT_STRING) {
                throw "OAUTH2-ERROR", sprintf("OAuth2 response is invalid, needs both token_type "
                    "(%y) and access_token (%y): %y", h.token_type, h.access_token, h);
            }
            *hash<auto> new_opts = update_options ? getUpdateOptionsAfterLogin(h) : NOTHING;
            setOAuth2LoginInfo(h);
            if (update_options && new_opts) {
                try {
                    update_options(new_opts);
                } catch (hash<ExceptionInfo> ex) {
                    log(LoggerLevel::ERROR, "Error updating options: %s: %s", ex.err, ex.desc);
                }
            }
            return h;
        }

        #! Returns options to update in the connection after an OAuth2 login/refresh
        private *hash<auto> getUpdateOptionsAfterLogin(hash<auto> h) {
            hash<auto> new_opts;
            string token_val;
            string token_type_val;
            *string cur_refresh_token;
            *int expiry_hint;
            {
                AutoReadLock al(config_lock);
                token_val = self.token_val;
                token_type_val = self.token_type_val;
                cur_refresh_token = refresh_token;
                expiry_hint = oauth2_token_expiry_hint;
            }
            # do not update "Bearer" -> "bearer"; it can break oauth2 refresh for apps like HubSpot
            if (h.token_type && (!token_type_val || (h.token_type.lwr() != token_type_val.lwr()))) {
                new_opts.token_type = h.token_type;
            }
            if (h.access_token && h.access_token != token_val) {
                new_opts.token = h.access_token;
            }
            if (h.refresh_token && h.refresh_token != cur_refresh_token) {
                new_opts.oauth2_refresh_token = h.refresh_token;
            }
            if (h.hasKey("expires_in") && !h.expires_in.intp()) {
                log(LoggerLevel::WARN, "Ignoring invalid 'expires_in' value with type %y; value: %y",
                    h.expires_in.fullType(), h.expires_in);
                remove h.expires_in;
            }
            if (*softint expires_in = h.expires_in ?? expiry_hint) {
                new_opts.oauth2_token_expiry = now_us() + seconds(expires_in);
            }
            return new_opts;
        }

        #! Sets the token from an OAuth2 login response
        /** @param h the parsed token response hash
        */
        private setOAuth2LoginInfo(hash<auto> h) {
            if (h.hasKey("expires_in") && !h.expires_in.intp()) {
                log(LoggerLevel::WARN, "Ignoring invalid 'expires_in' value with type %y; value: %y",
                    h.expires_in.fullType(), h.expires_in);
                remove h.expires_in;
            }
            setToken(h.token_type, h.access_token, h.refresh_token,
                h.expires_in ? (now_us() + seconds(h.expires_in)) : NOTHING);
            log(LoggerLevel::DEBUG, "set OAuth2 auth: %s %s; refresh_token: %s; expires_in: %s",
                h.token_type, h.access_token, h.refresh_token ?? "n/a",
                h.expires_in ?? "n/a");
        }

        #! Builds a HttpClientConnectionManager from RestClientIo client options
        /** Extracts connection-manager-relevant options from the client options hash
            and creates a new manager.  Used internally by @ref RestClientIoPool to
            create a shared manager automatically.

            @param opts the same options hash accepted by the constructor
            @return a new HttpClientConnectionManager configured from the options
        */
        static HttpClientIo::HttpClientConnectionManager buildConnectionManager(hash<auto> opts) {
            hash<HttpClientIo::HttpClientConnectionManagerOptions> mgr_opts();
            if (opts.connect_timeout) {
                mgr_opts.connect_timeout = opts.connect_timeout;
            }
            if (opts.timeout) {
                mgr_opts.request_timeout = opts.timeout;
            }
            if (opts.protocol) {
                mgr_opts.protocol = opts.protocol;
            }
            if (exists opts.max_connections_per_host) {
                mgr_opts.max_connections_per_host = opts.max_connections_per_host;
            }
            if (exists opts.max_streams_per_connection) {
                mgr_opts.max_streams_per_connection = opts.max_streams_per_connection;
            }
            if (exists opts.ssl_verify_mode) {
                mgr_opts.ssl_verify_mode = opts.ssl_verify_mode;
            }
            if (opts.accept_all_certs) {
                mgr_opts.accept_all_certs = opts.accept_all_certs.toBool();
            }
            if (opts.logger instanceof LoggerInterface) {
                mgr_opts.logger = cast<LoggerInterface>(opts.logger);
            }
            if (opts.proxy) {
                mgr_opts.proxy_url = opts.proxy;
            }
            if (exists opts.max_redirects) {
                mgr_opts.max_redirects = opts.max_redirects;
            }
            if (opts.redirect_passthru) {
                mgr_opts.redirect_passthru = opts.redirect_passthru.toBool();
            }
            if (exists opts.enable_cookies && !opts.enable_cookies) {
                mgr_opts.enable_cookies = False;
            }
            return new HttpClientIo::HttpClientConnectionManager(mgr_opts);
        }
    }

    #! Thread-safe REST client with connection pool API compatibility
    /** The pool IS the client — \c acquire() returns \c self and \c release() is a no-op.
        All requests are dispatched via an
        @ref HttpClientIo::HttpClientConnectionManager "HttpClientConnectionManager" which
        handles connection creation and reuse for all protocols:

        - **HTTP/2 and HTTP/3**: requests are multiplexed over shared connections
        - **HTTP/1.1**: the connection manager creates separate TCP connections for each
          concurrent request (\c max_concurrent_streams=1), providing the same thread-safe
          concurrent access pattern without requiring per-thread RestClientIo instances

        @par Connection Sharing
        When using the options-based constructor, the pool automatically creates a shared
        @ref HttpClientIo::HttpClientConnectionManager "HttpClientConnectionManager" that
        handles connection pooling for all protocols.  An external shared manager can also
        be provided to the constructor — in that case, the caller retains ownership.

        @par Pool Example
        @code{.py}
# Create with pool options — the pool IS the client
RestClientIoPool pool({"url": "https://api.example.com", "data": "json"});

# Use directly as a REST client (connection manager handles concurrency)
hash<RestResponseInfo> resp = pool.restGet("/api/data");

# Or use the acquire/release pattern for code that expects a pool
RestClientIo rc = pool.acquire();
on_exit pool.release();
resp = rc.restGet("/api/data");
        @endcode

        @par HTTP/1.1 Example
        @code{.py}
# Force HTTP/1.1 — the connection manager creates multiple TCP connections as needed
RestClientIoPool pool({"url": "http://legacy-api.example.com", "data": "json",
    "protocol": "h1"});
hash<RestResponseInfo> resp = pool.restGet("/api/data");
        @endcode

        @par External Shared Connection Manager Example
        @code{.py}
HttpClientIo::HttpClientConnectionManager shared_mgr();
RestClientIoPool pool({"url": "https://api.example.com", "data": "json"},
    NOTHING, shared_mgr);
hash<RestResponseInfo> resp = pool.restGet("/api/data");
        @endcode

        @since RestClientIo 1.0
    */
    public class RestClientIoPool inherits RestClientIo, Qore::Thread::AbstractConnectionPool {
        private {
            #! Saved client options for potential future pool expansion
            hash<auto> saved_client_opts;
        }

        #! Creates a new pool/client with the given options
        /** @param client_opts options passed to the @ref RestClientIo::constructor()
                "RestClientIo constructor"
            @param pool_opts pool configuration options (optional; the pool machinery
                is present for API compatibility but \c acquire() always returns \c self)
            @param shared_mgr an optional external shared
                @ref HttpClientIo::HttpClientConnectionManager "HttpClientConnectionManager";
                when provided, the caller retains ownership.  When omitted, the client
                creates and owns a manager automatically.
        */
        constructor(hash<auto> client_opts,
                *hash<Qore::Thread::ConnectionPoolOptions> pool_opts,
                *HttpClientIo::HttpClientConnectionManager shared_mgr)
                : RestClientIo(client_opts, shared_mgr),
                  AbstractConnectionPool(pool_opts) {
            saved_client_opts = client_opts;
        }

        #! Shuts down the pool and closes the connection
        shutdown() {
            AbstractConnectionPool::shutdown();
            close();
        }

        #! Returns self — the connection manager handles concurrency for all protocols
        /** For HTTP/2 and HTTP/3, requests are multiplexed over shared connections.
            For HTTP/1.1, the connection manager creates separate TCP connections for
            each concurrent request (max_concurrent_streams=1).
        */
        Qore::Thread::AbstractPoolableResource createResource() {
            return self;
        }

        #! No-op — the shared client is never destroyed via the pool
        nothing destroyResource(Qore::Thread::AbstractPoolableResource resource) {
        }

        #! No-op — no per-request state to reset
        nothing resetResource(Qore::Thread::AbstractPoolableResource resource) {
        }

        #! Returns self — the connection manager handles concurrent access for all protocols
        /** @return this pool/client instance
        */
        RestClientIo acquire() {
            return self;
        }

        #! No-op — the connection manager handles per-request connection allocation
        nothing release() {
        }
    }
}

#! REST ping poll operation using RestClientIo for native HTTP/2 and HTTP/3 support
/** Pure async state machine — no background threads.  Uses CompositeAction
    (PromiseAction + EventNotifierAction) so the C++ I/O thread signals the
    EventNotifier when the HTTP response arrives, making Future::get() non-blocking
    in continuePoll().

    State machine:
    - \c oauth2-refresh: refreshing the OAuth2 token via startOAuth2PollRefreshToken()
    - \c io-waiting: HTTP ping submitted; polling EventNotifier for completion
    - \c complete: ping finished

    OAuth2 token refresh is attempted once before the first request (if the token is
    in the expiry window) and once after a 401 response (if not already retried).

    @since %RestClientIo 1.2
*/
public namespace RestClientIo {

public class RestClientIoPingPollOperation inherits Qore::AbstractPollOperation {
    public {
        #! Waiting for the OAuth2 token endpoint connection to become ready
        const SPS_OAUTH2_CONNECTING = "oauth2-connecting";
        #! Waiting for the OAuth2 token refresh response via EventNotifier
        const SPS_OAUTH2_REFRESH = "oauth2-refresh";
        #! Waiting for the underlying TCP/TLS connection to become ready
        const SPS_CONNECTING = "connecting";
        #! Waiting for HTTP ping response via EventNotifier
        const SPS_IO_WAITING = "io-waiting";
        #! Complete
        const SPS_COMPLETE = "complete";
    }

    private {
        #! REST connection (weak reference)
        RestClient::RestConnection conn;

        #! Ping options
        hash<auto> ping_opts;

        #! Logger
        *Logger::LoggerInterface logger;

        #! EventNotifier — signaled by C++ CompositeAction (PromiseAction + EventNotifierAction)
        /** The I/O thread resolves the Future AND signals this notifier atomically.
            continuePoll() polls this FD and calls Future::get() non-blockingly when it fires.
        */
        EventNotifier notifier();

        #! Loaded schema validator
        *RestSchemaValidator::AbstractRestSchemaValidator schema_validator;

        #! RestClientIo instance (kept alive for the connection manager + stream)
        RestClientIo rcio;

        #! Current state
        string state;

        #! Goal reached
        bool goal_reached = False;

        #! Raw HTTP response Future (resolved by C++ PromiseAction on I/O thread)
        *Future pending_future;

        #! EventNotifier for OAuth2 token refresh (signaled when response arrives)
        *EventNotifier oauth2_notifier;

        #! EventNotifier for OAuth2 endpoint connection readiness
        *EventNotifier oauth2_conn_notifier;

        #! True after the first continuePoll() in SPS_OAUTH2_CONNECTING
        bool waiting_for_oauth2_conn = False;

        #! Future for OAuth2 token refresh response
        *Future oauth2_future;

        #! RestClientIo for OAuth2 token endpoint (kept alive for connection lifetime)
        *RestClientIo oauth2_rcio;

        #! Pending OAuth2 request parameters (set in doStartOAuth2Refresh, used after connection ready)
        *hash<auto> oauth2_req;

        #! Whether we have already attempted an OAuth2 refresh + retry after a 401
        bool auth_retried = False;

        #! EventNotifier for connection-readiness polling in SPS_CONNECTING state
        *EventNotifier connection_ready_notifier;

        #! True after the first continuePoll() call in SPS_CONNECTING (poll info returned)
        bool waiting_for_connection = False;

        #! HTTP method for the ping request
        string ping_method;

        #! HTTP path for the ping request
        string ping_path;

        #! HTTP body for the ping request
        auto ping_body;

        #! HTTP headers for the ping request
        *hash<auto> ping_headers;
    }

    #! Creates the poll operation and submits the first ping (or queues a token refresh)
    /** @param conn the REST connection to ping
        @param ping_opts ping options (ping_method, ping_path, ping_body, ping_headers,
            openapi3, swagger, oauth2_auto_refresh, etc.)
        @param logger optional logger
    */
    constructor(RestClient::RestConnection conn, hash<auto> ping_opts, *Logger::LoggerInterface logger) {
        self.conn := conn;
        self.ping_opts = ping_opts;
        self.logger = logger;

        ping_method = ping_opts.ping_method ?? "GET";
        ping_path = ping_opts.ping_path ?? "/";
        ping_body = ping_method != "GET" ? ping_opts.ping_body : NOTHING;
        ping_headers = ping_opts.ping_headers;

        # Load schema synchronously in the constructor (safe: constructor runs on a user
        # thread, not the I/O event thread).
        if (ping_opts.openapi3) {
            schema_validator = OpenApi3Loader::fromUrl(ping_opts.openapi3);
        } else if (ping_opts.swagger) {
            schema_validator = SwaggerLoader::fromUrl(ping_opts.swagger);
        }

        # Create RestClientIo with skip_login to avoid blocking OAuth2 I/O in the
        # constructor — token refresh is handled by the state machine if needed.
        rcio = cast<RestClientIo>(conn.getAsync(False, {"skip_login": True}));

        if (schema_validator) {
            rcio.setValidator(schema_validator);
        }

        # Update real_url from the RestClientIo's actual URL (fixes auto_url placeholders)
        conn.real_url = rcio.getUrl().toString();

        # If the token is in the expiry window, refresh it before the first request
        if (rcio.tokenRequiresRefresh()) {
            doStartOAuth2Refresh();
            # Pre-warm the connection concurrently with the OAuth2 refresh — discard the
            # notifier here; doStartConnecting() will get a fresh one after the refresh
            rcio.startConnectionAsync();
        } else {
            # Start connecting asynchronously — never block in the constructor.
            # doSubmitPing() is called by continuePoll() once the connection is ready.
            doStartConnecting();
        }
    }

    string getGoal() {
        return "ping";
    }

    string getState() {
        return state;
    }

    bool goalReached() {
        return goal_reached;
    }

    *hash<SocketPollInfo> continuePoll() {
        while (True) {
            if (state == SPS_OAUTH2_CONNECTING) {
                if (!waiting_for_oauth2_conn) {
                    # First call — return poll info for the connection notifier
                    waiting_for_oauth2_conn = True;
                    return <SocketPollInfo>{
                        "events": SOCK_POLLIN,
                        "socket": oauth2_conn_notifier,
                    };
                }
                # Notifier fired — connection ready or closed
                oauth2_conn_notifier.acknowledge();
                delete oauth2_conn_notifier;
                waiting_for_oauth2_conn = False;
                # Re-check: start a new connection if closed/failed
                oauth2_conn_notifier = oauth2_rcio.startConnectionAsync();
                if (oauth2_conn_notifier) {
                    # Still not ready — retry with new notifier
                    continue;
                }
                # Connection ready — submit the OAuth2 token request
                doSubmitOAuth2Request();
                # Fall through to SPS_OAUTH2_REFRESH below
            }

            if (state == SPS_OAUTH2_REFRESH) {
                if (!oauth2_future.isDone()) {
                    return <SocketPollInfo>{
                        "events": SOCK_POLLIN,
                        "socket": oauth2_notifier,
                    };
                }
                # Notifier fired — acknowledge and retrieve the OAuth2 response
                oauth2_notifier.acknowledge();
                processOAuth2RefreshResult();
                # Start connecting (or submit ping immediately if already connected)
                doStartConnecting();
                # Fall through to SPS_CONNECTING or SPS_IO_WAITING handling below
            }

            if (state == SPS_CONNECTING) {
                if (!waiting_for_connection) {
                    # First call in SPS_CONNECTING — return poll info to the PollingConnectionMonitor
                    waiting_for_connection = True;
                    return <SocketPollInfo>{
                        "events": SOCK_POLLIN,
                        "socket": connection_ready_notifier,
                    };
                }
                # Notifier fired — connection became READY or CLOSED/DRAINING.
                # Call doStartConnecting() to re-evaluate: if the connection is now
                # READY, it submits the ping immediately (transitions to SPS_IO_WAITING).
                # If it is CLOSED or DRAINING (e.g., connection failed or received
                # GOAWAY), doStartConnecting() acquires a replacement connection and
                # registers a new notifier, keeping state at SPS_CONNECTING for retry.
                connection_ready_notifier.acknowledge();
                delete connection_ready_notifier;
                waiting_for_connection = False;
                on_error conn.authFailure();
                doStartConnecting();
                # Re-evaluate from the top of the loop: if doStartConnecting() transitioned
                # to SPS_IO_WAITING (connection was ready), the SPS_IO_WAITING handler below
                # processes it.  If still SPS_CONNECTING (replacement connection), the
                # SPS_CONNECTING handler returns the new poll info for the next notifier.
                continue;
            }

            if (state == SPS_IO_WAITING) {
                # Non-blocking check: has the C++ I/O thread resolved the Future?
                if (!pending_future.isDone()) {
                    return <SocketPollInfo>{
                        "events": SOCK_POLLIN,
                        "socket": notifier,
                    };
                }

                # Notifier has fired — acknowledge it and retrieve the response
                notifier.acknowledge();
                # Future::get() is non-blocking here: isDone() confirmed it is resolved
                hash<auto> resp = pending_future.get();
                delete pending_future;

                int status_code = resp.status_code.toInt();
                if ((status_code / 100) == 2) {
                    # Run schema validation if configured (mirrors buildResponse() logic)
                    if (schema_validator) {
                        auto resp_body = resp.body;
                        *string content_type = resp.headers."content-type";
                        # Convert binary body to string for text-based content types
                        if (resp_body && resp_body.typeCode() == NT_BINARY && content_type) {
                            if (content_type =~ /^text\// || content_type =~ /\/(json|xml|yaml|html)/
                                    || content_type =~ /\+(json|xml)/ || content_type =~ /charset=/) {
                                resp_body = resp_body.toString();
                            }
                        }
                        on_error {
                            conn.authFailure();
                            rethrow $1.err, sprintf("%s: url: %y %s %y", $1.desc, conn.real_url,
                                ping_method, ping_path);
                        }
                        schema_validator.parseResponse(ping_method, ping_path, status_code,
                            resp_body, resp.headers);
                    }
                    goal_reached = True;
                    state = SPS_COMPLETE;
                    conn.authSuccess();
                    return;
                }

                # 401: attempt OAuth2 token refresh + retry once
                if (status_code == 401 && !auth_retried
                        && (ping_opts.oauth2_auto_refresh ?? True)) {
                    auth_retried = True;
                    doStartOAuth2Refresh();
                    continue;
                }

                conn.authFailure();
                throw "REST-PING-ERROR", sprintf("HTTP %d from RestClientIo ping %s %y",
                    status_code, ping_method, ping_path);
            }

            break;
        }
        return;
    }

    #! Starts an OAuth2 token refresh using a fully async RestClientIo request
    /** Creates the RestClientIo for the token endpoint and starts the connection
        async. If the connection is immediately ready, submits the request and
        enters SPS_OAUTH2_REFRESH. Otherwise enters SPS_OAUTH2_CONNECTING to
        wait for the connection notifier.
    */
    private doStartOAuth2Refresh() {
        hash<auto> refresh_info = rcio.startOAuth2PollRefreshToken();
        oauth2_rcio = refresh_info.rcio;
        oauth2_req = refresh_info{"path", "headers", "body"};

        # Start connection to the token endpoint asynchronously
        oauth2_conn_notifier = oauth2_rcio.startConnectionAsync();
        if (!oauth2_conn_notifier) {
            # Connection already ready — submit request immediately
            doSubmitOAuth2Request();
        } else {
            state = SPS_OAUTH2_CONNECTING;
        }
    }

    #! Submits the OAuth2 token request after the connection is ready
    private doSubmitOAuth2Request() {
        state = SPS_OAUTH2_REFRESH;
        oauth2_notifier = new EventNotifier();
        hash<auto> result = oauth2_rcio.doRequestRawAsyncWithNotifier("POST", oauth2_req.path,
            oauth2_req.headers, oauth2_req.body, oauth2_notifier);
        oauth2_future = result.future;
        delete oauth2_req;
    }

    #! Parses the OAuth2 token refresh response and stores the new token
    private processOAuth2RefreshResult() {
        hash<auto> resp = oauth2_future.get();
        delete oauth2_future;
        delete oauth2_notifier;
        delete oauth2_rcio;

%ifndef NoJson
        int status_code = resp.status_code.toInt();
        if ((status_code / 100) == 2) {
            *string content_type = resp.headers."content-type";
            if (content_type) {
                content_type =~ s/;.*//;
            }
            string body = resp.body ? resp.body.toString() : "";
            auto parsed_body;
            switch (content_type) {
                case MimeTypeJson:
                    parsed_body = parse_json(body);
                    break;
                case MimeTypeFormUrlEncoded:
                    parsed_body = mime_parse_form_urlencoded_string(body);
                    break;
                default:
                    throw "REST-PING-ERROR",
                        sprintf("cannot parse OAuth2 token response with Content-Type: %y",
                            content_type);
            }
            rcio.updateOAuth2Token(parsed_body);
        } else {
            conn.authFailure();
            throw "REST-PING-ERROR", sprintf("OAuth2 token refresh failed: HTTP %d",
                status_code);
        }
%else
        throw "REST-PING-ERROR", "cannot process OAuth2 token response without the json module";
%endif
    }

    #! Checks connection readiness and either submits the ping or enters SPS_CONNECTING
    /** Called from the constructor (always) and after OAuth2 refresh completes.
        If the connection is already ready, delegates to doSubmitPing() directly.
        If not, registers a connection-readiness EventNotifier and sets state to
        SPS_CONNECTING so continuePoll() can poll without blocking.

        @note Never blocks — this is safe to call from any context including a task
        thread spawned by the PollingConnectionMonitor.
    */
    private doStartConnecting() {
        connection_ready_notifier = rcio.startConnectionAsync();
        if (!connection_ready_notifier) {
            # startConnectionAsync() returns NOTHING for both "already READY" and
            # "already CLOSED/terminal" states.  Attempt to submit the ping; if the
            # connection was actually closed (stale pool connection), catch the error
            # and retry with a self-signaling notifier so continuePoll() re-enters.
            try {
                doSubmitPing();
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "HTTPCLIENT-NOT-READY") {
                    # Connection was closed — create a self-signaling notifier so the
                    # poll loop calls continuePoll() again for retry
                    connection_ready_notifier = new EventNotifier();
                    connection_ready_notifier.notify();
                    state = SPS_CONNECTING;
                    waiting_for_connection = False;
                    return;
                }
                rethrow;
            }
            return;
        }
        # Connection still establishing — enter connecting state
        state = SPS_CONNECTING;
    }

    #! Submits the ping request with EventNotifier signaling — no background thread
    /** Uses restDoRequestAsyncWithNotifier() so the C++ I/O thread signals @c notifier
        when the response arrives.  continuePoll() then calls Future::get() non-blockingly.

        @note Safe to call from continuePoll(): connection is always established before
        this method is called (via SPS_CONNECTING wait in doStartConnecting()).
    */
    private doSubmitPing() {
        state = SPS_IO_WAITING;
        hash<auto> result = rcio.restDoRequestAsyncWithNotifier(
            ping_method, ping_path, ping_body, ping_headers, notifier);
        pending_future = result.future;
    }
}

} # namespace RestClientIo
