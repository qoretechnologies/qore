%requires qore >= 1.0
# need mime definitions
%requires Mime >= 1.0
%requires Util >= 1.0
%requires(reexport) HttpServerUtil >= 1.0
%requires Logger
%requires AsyncSocketIo
%requires HttpServerAsyncIo

%try-module sysconf
%define NO_SYSCONF
%endtry

%modern
%allow-weak-references
%enable-debug

module HttpServer {
    version = "1.6";
    desc = "HttpServer module for a multi-threaded HTTP server";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage HttpServer Module

    @tableofcontents

    @section httpserverintro HttpServer Introduction

    The %HttpServer module provides a multi-threaded HTTP server to Qore programs.

    The %HttpServer implemented is designed for serving REST, RPC-style, and file-system-based requests as well as
    other types of traffic with an appropriate handler (for example handlers requiring protocol changes such as with
    the WebSocket protocol are supported as well).

    The HttpServer module uses async I/O for all connection handling and supports HTTP/1.x, HTTP/2, and HTTP/3.
    Async I/O uses a non-blocking I/O controller to accept connections and read headers efficiently, then dispatches
    request processing to the thread pool. See the \c httpserverasynciointro "HttpServerAsyncIo" module for
    additional details.

    To use this module, use \c "%requires HttpServer" in your code.  See examples/httpserver.qr for an example program
    using this module

    All the public symbols in the module are defined in the HttpServer namespace.

    The main classes is (see @ref httpserverutilintro "HttpServerUtil" for supporting definitions; note that the
    @ref httpserverutilintro "HttpServerUtil" module's definitions are also imported into @ref Qore::Program "Program"
    objects @ref requires "requiring" this module):
    - @ref HttpServer::HttpServer "HttpServer": this class implements the main interface to the HTTP server provided
      by this module

    See also:
    - <a href="../../RestHandler/html/index.html">RestHandler</a>: a module providing a handler framework for this
      module for implementing server-side REST services
    - <a href="../../WebSocketHandler/html/index.html">WebSocketHandler</a>: a module providing a handler framework
      for this module for implementing server-side WebSocket services
    - <a href="../../WebUtil/html/index.html">WebUtil</a>: a module providing higher-level HTTP services using this
      module as a base as well as providing support for dynamic template-based HTML rendering (ie rendering qhtml
      files which are a mix of HTML and Qore code)
    - <a href="http://www.qore.org/manual/modules/json/current/JsonRpcHandler/html/index.html">JsonRpcHandler</a>:
      provides infrastructure for implementing JSON-RPC server-side services using the HttpServer module
    - <a href="http://www.qore.org/manual/modules/yaml/current/YamlRpcHandler/html/index.html">YamlRpcHandler</a>:
      provides infrastructure for implementing YAML-RPC server-side services using the HttpServer module
    - <a href="http://www.qore.org/manual/modules/xml/current/XmlRpcHandler/html/index.html">XmlRpcHandler</a>:
      provides infrastructure for implementing XML-RPC server-side services using the HttpServer module
    - <a href="http://www.qore.org/manual/modules/xml/current/SoapHandler/html/index.html">SoapHandler</a>: provides
      infrastructure for implementing SOAP server-side services using the HttpServer module

    @section httpserverhttp3 HTTP/3 (QUIC) Support

    When a TLS listener is added with \c enable_h3 (or when
    \c enable_h3 defaults to \c True), the server automatically creates a paired QUIC/UDP
    listener on the \b same port as the TCP listener.  This follows the standard HTTP/3
    deployment model where TCP (HTTP/1.1 and HTTP/2) and UDP (HTTP/3 over QUIC) share the
    same port number; browsers discover HTTP/3 availability via the \c Alt-Svc response header.

    @par Paired Listener Architecture
    - Each TCP/TLS listener with HTTP/3 enabled gets a paired QUIC listener
    - The QUIC listener binds to the same port on UDP
    - Handlers added via @ref HttpServer::HttpServer::addHandlerToListenerID()
      "addHandlerToListenerID()" are automatically propagated to the paired QUIC listener
      (with a \c "-h3" suffix on the handler name)
    - Handler removal via @ref HttpServer::HttpServer::removeHandlerFromListenerID()
      "removeHandlerFromListenerID()" also removes the propagated handler from the paired
      QUIC listener
    - Stopping a TCP listener also stops its paired QUIC listener
    - The \c Alt-Svc header is set per-listener so each TCP listener only advertises its own
      QUIC counterpart

    @par Configuration
    - \c enable_h3: set to \c True in @ref HttpListenerOptionInfo to enable HTTP/3 for a
      listener (defaults to \c True for TLS listeners when QUIC support is available)
    - \c alt_svc_max_age: the \c max-age value for the \c Alt-Svc header in seconds
      (default: 86400)

    @par Example
    @code{.py}
%requires HttpServer

HttpServer server();
server.setDefaultHandler("api", my_handler);
# HTTPS listener with automatic HTTP/3 — QUIC binds to the same port on UDP
server.addListener({"service": 8443, "cert": cert, "key": key});
    @endcode

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires HttpServer
%requires Mime

class MyHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # NOTE: change "%y" to "%Y" to get a more readable multi-line output format for container values
        log("request received on %s from %s: context: %y hdr: %y body size: %d byte%s", cx."peer-info".desc,
            cx."socket-info".desc, cx, hdr, body.size(), body.size() == 1 ? "" : "s");
        return {
            "code": 200,
            "body": sprintf("<title>Test Page</title><body><h1>Qore HTTP server v%s</h1><p>%y on %s PID %s TID %d "
                "connection %d</p><p>Qore %s</p></body>", HttpServer::Version, now_us(), gethostname(), getpid(),
                gettid(), cx.id, Qore::VersionString),
            "close": True,
        };
    }
}

sub log(string str, ...) {
    printf("%y: %s\n", now_us(), vsprintf(str, argv));
}

const MyHttpPort = 19001;

# create our handler object
MyHandler myHandler();

# create the http server object
HttpServer hs(\log(), \log());

# add our handler to the server
hs.setHandler("my-handler", "/", MimeTypeHtml, myHandler);

# set our handler as the default handler
hs.setDefaultHandler("my-handler", myHandler);

# start a listener
hash<auto> lh = hs.addListener(MyHttpPort);

# output a log message
log("started listener on %s", lh.desc);
    @endcode

    @section http_relnotes HttpServer Module Release Notes

    @subsection http1_6 HttpServer 1.6
    - added HTTP/3 (QUIC) support with automatic listener creation for TLS listeners
    - added per-listener \c Alt-Svc header support for advertising HTTP/3 availability; each TCP
      listener only advertises its own QUIC counterpart to prevent browsers from confusing origins
    - QUIC listeners inherit all configuration from their parent TCP listener (\c additional_info)
      including cookie names, cookie domains, OIDC flags, and public URLs
    - added \c enable_h3 and \c alt_svc_max_age configuration options
    - added maximum HTTP request body size enforcement (\c max_request_body_size)
    - added \c sync option to allow non-blocking listener addition
    - added Brotli (\c br) and Zstandard (\c zstd) Content-Encoding support
      (<a href="https://github.com/qoretechnologies/qore/issues/5071">issue 5071</a>)
      - responses can be compressed with Brotli or Zstd when clients send appropriate \c Accept-Encoding headers
      - requires Qore built with Brotli and/or Zstd support
    - return HTTP 204 when a handler returns code 200 with no response body
    - fixed I/O thread blocking on \c Socket::getPeerInfo() calls that could cause the server to become unresponsive
      - disabled DNS hostname lookups in \c getPeerInfo() calls to prevent blocking the I/O thread
      - moved \c getPeerInfo() calls to after SSL handshake completion when socket is stable
      - peer info now shows IP addresses instead of hostnames in logs
    - removed high-frequency INFO log messages from async I/O hot paths to reduce log spam
    - fixed async I/O cache leak when clients disconnect during SSL handshake
    - fixed a shutdown crash when HttpServer instances created with the deprecated logger callback constructor were
      torn down while async logging was still active

    @subsection http1_5 HttpServer 1.5
    - introduced async I/O for HttpServer (now the only mode)

    @subsection http1_4 HttpServer 1.4
    - allow the listener class to be overridden and added \c "listener-name" to the context hash
    - allow authentication methods to set the call context
      (<a href="https://github.com/qoretechnologies/qore/issues/4970">issue 4970</a>)

    @subsection http1_3 HttpServer 1.3
    - fixed a bug where idle connections were never disconnected
      (<a href="https://github.com/qoretechnologies/qore/issues/4878">issue 4878</a>)

    @subsection http1_2 HttpServer 1.2
    - allow handlers to remove thread-local auth information after requests have been handled

    @subsection http1_1_2 HttpServer 1.1.2
    - allow context info to be cleared after handling each request to ensure that context info (like thread-local
      data) does not leak into other connections on the same thread
      (<a href="https://github.com/qoretechnologies/qore/issues/4802">issue 4802</a>)

    @subsection http1_1_1 HttpServer 1.1.1
    - fixed a bug reloading X.509 certificates on running listeners
      (<a href="https://github.com/qoretechnologies/qore/issues/4720">issue 4720</a>)

    @subsection http1_1 HttpServer 1.1
    - implemented support for reloading X.509 certificate information without manually restarting listeners
      (<a href="https://github.com/qoretechnologies/qore/issues/4574">issue 4574</a>)

    @subsection http1_0_12 HttpServer 1.0.12
    - fixed a bug where incorrect URI decoding was applied to URLs in received HTTP messages instead of URL decoding
      (<a href="https://github.com/qoretechnologies/qore/issues/4363">issue 4363</a>)

    @subsection http1_0_2 HttpServer 1.0.2
    - @ref HttpServer::HttpServer::addListeners() "HttpServer::addListeners()" has no mechanism for returning errors
      to the caller
      (<a href="https://github.com/qoretechnologies/qore/issues/4312">issue 4312</a>)

    @subsection http1_0_1 HttpServer 1.0.1
    - allow dynamic handlers to be removed without waiting for all connections to terminate
      (<a href="https://github.com/qoretechnologies/qore/issues/4273">issue 4273</a>)
    - allow for full logging of authentication errors if HTTP server debugging is enabled
      (<a href="https://github.com/qoretechnologies/qore/issues/4217">issue 4217</a>)

    @subsection http1_0 HttpServer 1.0
    - allow dynamic handlers to be disabled before being removed
      (<a href="https://github.com/qoretechnologies/qore/issues/4173">issue 4173</a>)
    - added support for the Logger module for logging
      (<a href="https://github.com/qoretechnologies/qore/issues/4157">issue 4157</a>)
    - removed deprecated APIs

    @subsection http0911 HttpServer 0.9.11
    - fixed a bug shutting down dedicated socket I/O handlers
      (<a href="https://github.com/qoretechnologies/qore/issues/4130">issue 4130</a>)
    - fixed a bug where invalid HTTP responses were send with error messages and chunked transfer encoding
      (<a href="https://github.com/qoretechnologies/qore/issues/4124">issue 4124</a>)
    - fixed a bug where it was not possible for an HTTP stream handler to support switching protocols
      (<a href="https://github.com/qoretechnologies/qore/issues/4111">issue 4111</a>)

    @subsection http095 HttpServer 0.9.5
    - fixed a bug where the HTTP server would not always stop the ThreadPool which caused process shutdowns to hang
      (<a href="https://github.com/qoretechnologies/qore/issues/3999">issue 3999</a>)

    @subsection http094 HttpServer 0.9.4
    - added support for sending chunked replies from an @ref Qore::InputStream "InputStream"
      (<a href="https://github.com/qoretechnologies/qore/issues/3702">issue 3702</a>)

    @subsection http03131 HttpServer 0.3.13.1
    - enable remote certificates to be retrieved in listeners and handlers by default; added new API entry points for
      listeners and handlers with more flexible and saner parameters, deprecated old complex methods
      (<a href="https://github.com/qoretechnologies/qore/issues/3512">issue 3512</a>)
    - shut down dedicated socket conenctions last in order to allow for effective keep-alive implementations with
      WebSocket for example
      (<a href="https://github.com/qoretechnologies/qore/issues/3488">issue 3488</a>)
    - fixed certificate and key errors for HTTPS listeners to generate user-friendly exceptions
      (<a href="https://github.com/qoretechnologies/qore/issues/3397">issue 3397</a>)

    @subsection http0313 HttpServer 0.3.13
    - added the \c "header-info" hash to the context argument when calling handlers
      (<a href="https://github.com/qoretechnologies/qore/issues/3026">issue 3026</a>)
    - added support for adding new HTTP methods to the server with the
      @ref HttpServer::HttpServer::addHttpMethod() "HttpServer::addHttpMethod()" method
      (<a href="https://github.com/qoretechnologies/qore/issues/2805">issue 2805</a>)

    @subsection http03121 HttpServer 0.3.12.1
    - fixed \c HEAD and other responses that cannot have a message body
      (<a href="https://github.com/qoretechnologies/qore/issues/3116">bug 3116</a>)

    @subsection http0312 HttpServer 0.3.12
    - added a minimal substring of string bodies received to the log message when logging HTTP requests
    - added logic to allow sensitive data to be masked in log messages (<a href="https://github.com/qoretechnologies/qore/issues/1086">issue 1086</a>)
    - added support for the HTTP \c "PATCH" method

    @subsection http03111 HttpServer 0.3.11.1
    - fixed a bug where @ref HttpServer::HttpServer::addListener() would not accept port 0 meaning bind on any random open port (<a href="https://github.com/qoretechnologies/qore/issues/1284">bug 1284</a>)

    @subsection http0311 HttpServer 0.3.11
    - fixed a bug setting the response encoding in @ref HttpServer::HttpServer::setReplyHeaders() where the Socket encoding was not set properly and therefore the encoding in the \c Content-Type in the response header did not necessarily match the encoding of the response
    - added support for private keys with passwords
    - added the @ref HttpServer::PermissiveAuthenticator "PermissiveAuthenticator" class
    - moved base code to the @ref httpserverutilintro "HttpServerUtil" module (imported with the \c reexport option) and santized APIs, made HttpListener class private/internal again
    - fixed a socket / connection performance problem with HTTPS listeners where the SSL connection was being negotiated inline with the accept instead of in the connection thread, thereby blocking new connections from being accepted
    - new methods implemented in HttpServer:
      - @ref HttpServer::HttpServer::setListenerLogOptions()
      - @ref HttpServer::HttpServer::setListenerLogOptionsID()
    - performance improvement of matching handlers to request URIs (not used for RegExp matching)
    - changed the order of path-based handler matching:
      - the old implementation selects the first (in order of their registration) handler whose path matches the request URI, regexp and path matching have the same priority
      - the new implementation has two stages:
        - first, handlers without regexp are considered - if there are some handler with their path matching the request, the one with the longest path is selected
        - otherwise, the first (in order of their registration) handler with regexp that matches the request URI is chosen
      - if no path matches the request, the same logic as before applies
    - added @ref HttpServer::HttpServer::addListeners() "HttpServer::addListeners(string, hash, *code, *code, *code, *string, int)"
    - fixed a bug in @ref HttpServer::HttpServer::addListener() with an integer argument; a UNIX socket was opened instead of a wildcard listener on the given port
    - added the @ref HttpServer::HttpServer::listenerStarted() method to allow for reporting when listeners are actually running since they are started asynchronously
    - added the \c "ssl" key to the listener socket info hash
    - fixed typos causing bugs in HTTP error logging (<a href="https://github.com/qoretechnologies/qore/issues/308">bug 308</a>)
    - fixed bugs handling persistent connections

    @subsection http0310 HttpServer 0.3.10
    - if an error occurs receiving a message with chunked transfer encoding, send the response immediately before reading the rest of the chunked transfer

    @subsection http039 HttpServer 0.3.9
    - when binding a wildcard address with @ref Qore::AF_UNSPEC "AF_UNSPEC" on Windows with \c HttpServer::HttpServer::addListeners()
      and both IPv6 and IPv4 addresses are returned, bind both addresses since Windows doesn't direct the IPv4 requests to the wildcard-bound IPv6 listener

    @subsection http038 HttpServer 0.3.8
    - moved more message handling code to HttpServer::AbstractHttpRequestHandler so that chunked transfers can be efficiently supported by handlers
    - added a minimum body size threshold for \c Content-Encoding compression to HttpServer
    - added the following classes to facilitate handling chunked requests and responses:
      - HttpServer::AbstractStreamRequestHandler
      - HttpServer::AbstractStreamRequest
    - added support for persistent connections to a given handler to the HTTP server

    @subsection http037 HttpServer 0.3.7
    - fixed a bug in parsing arguments in @ref HttpServer::parse_uri_query() "parse_uri_query()"
    - updated @ref HttpServer::parse_uri_query() "parse_uri_query()" to accept both \c "&" and \c ";" as argument separators
    - added support for the \c PUT and \c DELETE methods and for optional message bodies independent of the HTTP method
    - fixed handler matching to use a score for each handler and to check dynamic handlers also for a match if the fixed handlers don't provide a perfect match
    - fixed response handling to not overwrite the \c Connection header if present from the handler
    - fixed response handling to only return error reponses with codes >= 400
    - implemented the  @ref HttpServer::AbstractHttpSocketHandler "AbstractHttpSocketHandler" handler class to support dedicated socket connections when switching protocols in handlers
    - do not add HTML to the msg body from explicit error responses from handlers
    - improved HTTP server log messages
    - added "family" argument to HttpServer::add*Listener*() methods
    - turned of \c TCP_NODELAY by default and use socket shutdown when closing sockets instead
    - set the listen backlog queue size to 100 by default (previously was hardcoded internally in %Qore to 5)
    - use the new @ref Qore::Thread::ThreadPool "ThreadPool" class introduced in %Qore 0.8.8 to pre-allocate threads to reduce latency for new socket connections
    - improved handler matching algorithm
    - implemented many performance improvements
    - implemented support for simple string path matching when finding a handler for a request
    - added static @ref HttpServer::AbstractHttpRequestHandler::redirect() to help in generating 301 Moved Permanently messages

    @subsection http036 HttpServer 0.3.6
    - fixed a race condition in tracking active requests in dynamic HTTP handlers and removing dynamic HTTP handlers

    @subsection http035 HttpServer 0.3.5
    - fixed bugs in regexes in the @ref HttpServer::HttpServer::addListeners() "HttpServer::addListeners()" and
      \c HttpServer::addListenersWithHandler() methods
    - updated module example code in summary
    - added \c "listener-id" to request context hash

    @subsection http034 HttpServer 0.3.4
    - added public @ref HttpServer::parse_uri_query() "parse_uri_query()" function

    @subsection http033 HttpServer 0.3.3
    - updated to a user module
    - added support for custom redirects from user handlers
    - use the <a href="../../Mime/html/index.html">Mime</a> module for mime definitions

    @subsection http032 HttpServer 0.3.2
    - added support for listeners with specific handler lists
    - added the ability to manage dynamic content handlers
    - implemented content-encoding handling flags in @ref HttpServer::AbstractHttpRequestHandler "AbstractHttpRequestHandler"
    - implemented support for \c "identity" encoding (if anyone ever sends it)

    @subsection http031 HttpServer 0.3.1
    - added IPv6 support in qore 0.8.2

    @subsection http030 HttpServer 0.3.0
    - added the ability to start and stop listeners on demand

    @subsection http029 HttpServer 0.2.9
    - updates for new SSL and timeout behavior with with @ref Qore::Socket "Socket" class with qore 0.8.1+
    - set socket encoding to UTF-8 by default
    - add \c "charset=utf-8" to \c Content-Type header if not already present
    - add \c "text/html" to \c Content-Type header if no content-type is given by the handler
    - fixed setting X.509 certificate and private key for HTTPS listeners
    - require qore >= 0.8.1 for new Socket features

    @subsection http028 HttpServer 0.2.8
    - converted to hard typing for use with %require-types
    - require qore >= 0.8.0 for new @ref Qore::Socket "Socket" features

    @subsection http027 HttpServer 0.2.7
    - set \c TCP_NODELAY on all sockets to ensure that clients get all data before closing the socket, especially in case of errors
    - require qore >= 0.7.4 for new @ref Qore::Socket "Socket" features

    @subsection http026 HttpServer 0.2.6
    - minor fixes for SOAP support
    - improved handler matching

    @subsection http025 HttpServer 0.2.5
    - minor fixes for SOAP support

    @subsection http024 HttpServer 0.2.4
    - improved \c Content-Type handling
    - improved URL/path support

    @subsection http023 HttpServer 0.2.3
    - bzip2 \c Content-Encoding support

    @subsection http022 HttpServer 0.2.2
    - basic authentication

    @subsection http021 HttpServer 0.2.1
    - implementing logic to handle \c "deflate" and \c "gzip" content-encoding
    - chunked content-encoding supported for POSTs
    - Date: header always sent as per HTTP 1.1 spec

    @subsection http020 HttpServer 0.2.0
    - modular/multiple listener support added
    - https support added
 */

#! the main namespace for the HttpServer module
/** To use this module, use \c "%requires HttpServer" in your code.

    See examples/httpserver.qr for an example program using this module

    All the public symbols in the module are defined in this namespace
 */
public namespace HttpServer {
#! returns a multi-line string from the exception hash argument suitable for logging or output on the console
/** @param ex the exception hash to process

    @return a multi-line string from the exception hash argument suitable for logging or output on the console

    @note reexported from the Util module
*/
public string sub get_exception_string(hash<auto> ex) {
    return Util::get_exception_string(ex);
}

#! Hash for HttpServer options
public hashdecl HttpServerOptionInfo {
    #! HTTP server name
    string name = HttpServer::HttpServerString;

    #! Debug flag
    bool debug = False;

    #! Do not allow the last listener to be stopped
    bool protect_last_listener = False;

    #! Headers to add in responses
    hash<auto> hdr = {
        "X-Powered-By": "Qore/" + Qore::VersionString,
    };

    #! Idle disconnect time; the default is 75 seconds
    date ttl = HttpServer::DefaultTtl;

    #! HTTP server logger
    *LoggerInterface logger;

    #! Idle thread count for the connection thread pool
    int idle_threads =
%ifndef NO_SYSCONF
        sysconf(SC_NPROCESSORS_ONLN) * 2
%else
        HttpServer::DefaultIdleThreads
%endif
        ;

    #! Maximum number of handler threads for the async I/O thread pool (0 = unlimited)
    /** Controls the maximum number of concurrent threads that can be used for request processing.
        Set to 0 (default) for unlimited.

        @since HttpServer 1.6
    */
    int max_handler_threads = 0;

    #! Minimum idle handler threads kept alive in the async I/O thread pool
    /**
        @since HttpServer 1.6
    */
    int min_idle_handler_threads = 0;

    #! Maximum idle handler threads in the async I/O thread pool
    /**
        @since HttpServer 1.6
    */
    int max_idle_handler_threads = 0;

    #! Maximum HTTP request body size in bytes (0 = unlimited)
    /** Requests with Content-Length exceeding this value, or chunked/HTTP/2 bodies
        that grow beyond this value, receive HTTP 413 (Content Too Large) and the
        connection is closed.

        @since HttpServer 1.6
    */
    int max_request_body_size = 0;

    #! Enable automatic HTTP/3 (QUIC) listener creation for TLS listeners
    /** When \c True (the default), QUIC listeners are automatically created alongside TLS TCP listeners.
        The server advertises HTTP/3 availability via the \c Alt-Svc response header.

        Set to \c False to disable automatic QUIC listener creation server-wide.

        @note Individual listeners can override this via the \c enable_h3 field in
        @ref HttpListenerOptionInfo.

        @since HttpServer 1.6
    */
    bool enable_h3 = True;

    #! Default max-age value for the Alt-Svc header (seconds)
    /** Controls how long clients should cache the HTTP/3 Alt-Svc advertisement.

        Default: 3600 (1 hour).

        @since HttpServer 1.6
    */
    int alt_svc_max_age = 3600;

    #! QUIC GOAWAY drain timeout — duration to wait for in-flight requests during graceful shutdown
    /** Per RFC 9114 Section 5.2, the server sends a GOAWAY notice first, then waits
        for in-flight requests to complete before sending the final GOAWAY.  This
        timeout controls that waiting period.

        The default (5s) allows sufficient time for remote clients to receive the
        GOAWAY notice and for in-flight requests to complete.  For localhost or
        low-latency testing, a shorter value (e.g. 100ms) may be used.

        @since HttpServer 1.6
    */
    timeout quic_drain_timeout = 5s;

    #! Enable HTTP/3 headers-only dispatch mode
    /** When @ref True "True", HTTP/3 (and HTTP/2) requests are dispatched to handlers as
        soon as headers arrive, before the full body is received.  Handlers that override
        @ref AbstractHttpRequestHandler::wantsBodyStreaming() "wantsBodyStreaming()" and
        return @ref True "True" can read body data incrementally via
        @ref Qore::Socket::readQuicStreamDataBlock() (HTTP/3) or
        @ref Qore::Socket::readHttp2StreamDataBlock() (HTTP/2).

        Handlers that do @b not override \c wantsBodyStreaming() are unaffected — the
        framework automatically buffers the full body before calling \c handleRequest(),
        maintaining backward compatibility.

        This enables bidirectional streaming for gRPC-style, Connect protocol, and
        chunked upload use cases where processing should begin before the full body arrives.

        @par Example
        @code{.py}
        HttpServer server(<HttpServerOptionInfo>{
            "quic_headers_only": True,
        });
        server.setHandler("upload", "/upload", NOTHING, new MyStreamingHandler());
        server.addListener(<HttpListenerOptionInfo>{
            "service": 8443,
            "cert": cert,
            "key": key,
            "enable_h3": True,
        });
        @endcode

        @see @ref AbstractHttpRequestHandler::wantsBodyStreaming()

        @since HttpServer 1.6
    */
    bool quic_headers_only = False;
}

#! The HttpServer class implements a multithreaded HTTP server
/**
    ## Lifecycle

    HttpServer instances are NOT designed to be restartable. Once stop() is called,
    the server enters a stopped state and cannot be restarted. To create a new server,
    instantiate a new HttpServer object.

    The design is intentionally non-restartable because:
    - Internal I/O controllers set shutdown flags that prevent restart
    - Thread pools and counters are not reset after stop()
    - Listeners are not designed to be restarted after being stopped

    @see HttpServerAsyncIo::HttpAsyncSocketIoController for callback-based async I/O
*/
public class HttpServer inherits HttpServer::AbstractLogger {
    public {
        #! version of the HttpServer's implementation
        const Version = HttpServer::HttpServerVersion;
        #! default read timeout in ms
        const ReadTimeout = HttpServer::ReadTimeout;  # recvs timeout after 30 seconds
        #! default poll timeout in ms
        const PollTimeout = 250ms;

        # logging options
        const LP_LOGPARAMS = HttpServer::LP_LOGPARAMS;
        const LP_LEVELMASK = HttpServer::LP_LEVELMASK;

        #! address info flags
        const AIFlags = AI_PASSIVE | AI_ADDRCONFIG;

        #! HTTP methods supported by default
        const HttpMethods = {
            "HEAD": True,
            "POST": True,
            "PUT": True,
            "DELETE": True,
            "GET": True,
            "OPTIONS": True,
            "PATCH": True,
            #"TRACE": True,
            "CONNECT": True,  # RFC 8441: HTTP/2 extended CONNECT for WebSocket
        };

        #! map of HTTP result codes and text messages
        const HttpCodes = HttpServer::HttpCodes;

        #! content-encodings supported; this is a hash to simulate a set with O(ln(n)) access times
        const ContentEncodings = {
            "br": "br",
            "zstd": "zstd",
            "gzip": "gzip",
            "deflate": "deflate",
            "bzip2": "bzip2",
            "x-gzip": "gzip",
            "x-deflate": "deflate",
            "x-bzip2": "bzip2",
        };

        #! default number of idle threads to have waiting for new connections (accross all listeners)
        const DefaultIdleThreads = 10;

        #! default threadhold for data compressions; transfers smaller than this size will not be compressed
        const CompressionThreshold = 1024;

        /** @defgroup ListenerLogOptions Listener Log Options
            Options to control how listener headers and body options are logged
            @see
            - HttpServer::getListenerLogOptions()
            - HttpServer::getListenerLogOptionsID()
            - HttpServer::setListenerLogOptions()
            - HttpServer::setListenerLogOptionsID()
         */
        #/@{
        #! listener log option: log recv headers
        const LLO_RECV_HEADERS = (1 << 0);

        #! listener log option: log recv message body
        const LLO_RECV_BODY = (1 << 1);

        #! listener log option: log send headers
        const LLO_SEND_HEADERS = (1 << 2);

        #! listener log option: log sent message body
        const LLO_SEND_BODY = (1 << 3);
        #/@}

        #! Default connection time-to-live
        const DefaultTtl = 75s;
    }

    #! @cond nodoc
    private {
        # for masking HTTP request log msgs
        *code maskfunc;

        # quit server flag
        bool exit = False;

        # if True then verbose exception info will be logged
        bool debug;

        Sequence seqSessions();
        Sequence seqListeners();

        bool stopped = False;

        #! Stop guard
        Mutex stop_m();

        #! True while stop() is in progress
        bool stopping = False;

        # permanent handlers; these handlers are never removed
        HttpHandlerList handlers();

        # default handler
        *HandlerInfo defaultHandler;

        # hash of listeners keyed by listener ID
        hash<string, HttpListener> listeners;

        # map of bind addresses to listener IDs
        hash<string, int> smap;

        # map of listener names to listener IDs
        hash<string, int> nmap;

        # listener Gate
        Gate lm();

        # running listener WaitGroup
        WaitGroup c();

        # dynamic handlers
        DynamicHttpHandlerList dhandlers();

        # connection thread pool
        ThreadPool threadPool;

        # other misc response headers
        hash<auto> hdr;

        #! override message body encoding if none is received from the sender
        /** @note http://tools.ietf.org/html/rfc2616#section-3.7.1 states that it must be iso-8850-1
        */
        *string override_encoding;

        #! the name the HTTP server will report itself as
        string http_server_string;

        #! valid HTTP methods
        hash<string, bool> http_methods = HttpMethods;

        #! logger
        *LoggerInterface logger;
        #! callback logger appender for the deprecated constructor (if used)
        *LoggerAppender callback_appender;

        #! Do not allow last listener to be stopped
        bool protect_last_listener = False;

        #! Idle disconnect (TTL) for connections
        date ttl = DefaultTtl;

        #! Maximum HTTP request body size in bytes (0 = unlimited)
        int max_request_body_size = 0;

        #! Enable automatic HTTP/3 (QUIC) listener creation
        bool enable_h3 = True;

        #! Default max-age for Alt-Svc header (seconds)
        int alt_svc_max_age = 3600;

        #! Map of TCP listener ID -> auto-created QUIC listener ID
        /** Keys are string listener IDs (Qore auto-converts int keys to strings
            in hashes).  Values are the corresponding QUIC listener ID.
        */
        hash<string, int> quic_listener_map;

        #! Map of TCP listener ID -> QUIC port
        /** Keys are string listener IDs (same auto-conversion as quic_listener_map).
            Values are the UDP port of the QUIC listener.
        */
        hash<string, int> quic_port_map;

        #! Map of TCP listener ID -> per-listener Alt-Svc max-age
        /** Keys are string listener IDs.  Values are the max-age value for Alt-Svc headers.
        */
        hash<string, int> quic_alt_svc_max_age;

        #! Map of TCP listener ID -> per-listener Alt-Svc header value
        /** Each TCP listener advertises only its own QUIC counterpart, not all QUIC ports.
        */
        hash<string, string> listener_alt_svc;

        #! Async I/O controller
        *HttpServerAsyncIo::HttpAsyncSocketIoController asyncIo;

        #! Native async target for callback-based async I/O
        *Priv::HttpServerNativeAsyncTarget asyncTarget;

        #! Cached HTTP date header value
        static string cached_date_header;

        #! Epoch second when cache was last updated
        static int cached_date_epoch = 0;

    }
    #! @endcond

    #! @cond nodoc
    #! Returns the global async socket I/O controller (internal use only)
    AsyncSocketIo::AsyncSocketIoController getGlobalAsyncCtrl() {
        return AsyncSocketIo::getGlobalAsyncIoController();
    }

    #! Returns the HTTP async socket I/O controller (useful for testing cache cleanup)
    *HttpServerAsyncIo::HttpAsyncSocketIoController getHttpAsyncIo() {
        return asyncIo;
    }

    #! Returns the owner ID for this server (used to tag async I/O operations)
    string getOwnerId() {
        return self.uniqueHash();
    }

    #! Signals all active streaming handlers (SSE, WebSocket) to stop their polling loops
    /** Called by the async I/O controller during shutdown before waiting for the handler pool
        to complete.  This allows handler tasks to exit deterministically so that
        \c ThreadPool::stopWait() "stopWait()" does not block indefinitely.

        @since HttpServer 1.6
    */
    signalStreamingHandlersToStop() {
        # Copy listeners under lock, then iterate outside to avoid holding lm
        # while calling handler.stop(), which could block or re-enter server state
        *hash<string, HttpListener> llist;
        {
            lm.enter();
            on_exit lm.exit();
            llist = listeners;
        }
        map $1.signalHandlersToStop(), llist.iterator();
    }

    #! Returns the handler for inline check from global handler lists (no side effects)
    /** Looks up the handler from the permanent global handler list only.
        Dynamic handlers are not returned since they require lifecycle tracking
        that is incompatible with the inline path.

        @param hdr parsed HTTP headers
        @return the handler info if found, NOTHING otherwise
    */
    *HandlerInfo findGlobalHandler(hash<auto> hdr) {
        int score = 0;
        string root_path;
        *HandlerInfo hi = handlers.findHandler(hdr, \score, False, \root_path);
        if (!hi && defaultHandler) {
            hi = defaultHandler;
        }
        return hi;
    }
    #! @endcond

    #! creates the HttpServer
    /** call @ref addListener() to add and start listeners

        @param logfunc an optional closure or call reference that will be called with logging information; must take
        an initial string with optional arguments; ex:
        @code{.py} code log = sub (string fmt, ...) { vprintf(fmt, argv); }@endcode
        @param errlogfunc an optional closure or call reference that will be called with error information; must
        take an initial string with optional arguments; ex:
        @code{.py} code errloglog = sub (string fmt, ...) { vprintf(fmt, argv); }@endcode
        @param dbg if this parameter is set to @ref True "True", then additional information will be logged when
        errors occur; note that this parameter is only used if \a log is not provided
        @param name the name of the HTTP server as returned in the Server header (should be formatted according to
        <a href="http://tools.ietf.org/html/rfc2616#section-3.8">RFC 2616 section 3.8</a>)
        @param hdr a hash of headers to return in every response by default; to clear the default send an empty hash
        as the argument here

        @note A new Logger object is created for the HTTP server using either \a logfunc or \a errfunc; if both are
        given then only \a logfunc is used and all log messages (including errors) are directed to \a logfunc.  The
        Logger object's logging level is set according to which of these parameters is included.  If neither are
        included, then no logging is performed

        @deprecated use constructor(hash<HttpServerOptionInfo>) instead
    */
    deprecated constructor(*code logfunc, *code errlogfunc, bool dbg = False,
            string name = HttpServer::HttpServerString,
            hash<auto> hdr = {"X-Powered-By": "Qore/" + Qore::VersionString}) {
        logger = new Logger(name);
        if (logfunc || errlogfunc) {
            callback_appender = new HttpServerCallbackAppender(logfunc ?? errlogfunc);
            logger.addAppender(callback_appender);
            if (logfunc) {
                logger.setLevel(LoggerLevel::INFO);
            } else {
                logger.setLevel(LoggerLevel::ERROR);
            }
        } else {
            logger.setLevel(LoggerLevel::INFO);
        }
        init(<HttpServerOptionInfo>{
            "name": name,
            "debug": dbg,
            "hdr": hdr,
            "logger": logger,
        });
    }

    #! Creates the server with the given options
    /** @param opts see @ref HttpServerOptionInfo for more info
    */
    constructor(hash<HttpServerOptionInfo> opts) {
        init(opts);
    }

    #! Creates the server with default options and an empty logger
    constructor() {
        init(<HttpServerOptionInfo>{});
    }

    #! calls stop() and destroys the object
    destructor() {
        stop();
    }

    #! Returns default response headers
    *hash<auto> getDefaultResponseHeaders() {
        return hdr;
    }

    #! Returns the TTL value
    date getTtl() {
        return ttl;
    }

    #! Sets the connection TTL value
    setTtl(date ttl) {
        if (ttl.absolute()) {
            throw "TTL-ARG-ERROR", sprintf("Idle disconnect (ttl) value is an absolute date: %y; it must be "
                "relative", ttl);
        }
        if (ttl <= 0us) {
            throw "TTL-ARG-ERROR", sprintf("Idle disconnect (ttl) value is not greater then zero: %y", ttl);
        }
        self.ttl = ttl;
    }

    #! Returns the maximum request body size in bytes (0 = unlimited)
    /** @return the maximum request body size in bytes; 0 means unlimited

        @since HttpServer 1.6
    */
    int getMaxRequestBodySize() {
        return max_request_body_size;
    }

    #! Sets the maximum request body size in bytes (0 = unlimited)
    /** @param size the maximum request body size in bytes; 0 means unlimited

        @since HttpServer 1.6
    */
    setMaxRequestBodySize(int size) {
        max_request_body_size = size;
    }

    #! add a new supported HTTP method
    /** @param m the HTTP method to add; the string is converted to upper case if necessary
    */
    addHttpMethod(string m) {
        http_methods{m.upr()} = True;
    }

    #! returns the HTTP server version string
    static string getHttpServerVersionString() {
        return HttpServer::HttpServerVersion;
    }

    setDefaultTextEncoding(string enc) {
        override_encoding = enc;
    }

    string getDefaultTextEncoding() {
        return override_encoding ? override_encoding : "iso-8859-1";
    }

    #! To call a listener's stop callback
    callListenerStopCallback(code stopc, string name, hash<auto> socket_info) {
        try {
            call_function(stopc, name);
        } catch (hash<ExceptionInfo> ex) {
            logError("%y (%s): error calling stop notification closure: %s: %s: %s", name, socket_info.desc,
                get_ex_pos(ex), ex.err, ex.desc);
        }
    }

    #! adds one or more dedicated listeners to the server with the given bind address
    /** @param bind the bind address for the dedicated listener; this can be a port number or an address (or
        hostname) and a port number separated by a colon (ex: \c "192.168.20.4:8021"); the bind address will overwrite
        any \a node and \a service addresses in the \a info hash; all possible addresses will be bound to new
        listeners
        @param info a listener information hash
        @param errmap an optional reference to a hash of error information keyed by bind address

        @return a list of listener info hashes; see the return value of HttpServer::getListenerInfo() for the
        description of each hash element in the list returned by this method

        @throw HTTPSERVER-ADDLISTENER-ERROR missing bind info, duplicate bind address, or duplicate listener name
        @throw SOCKET-BIND-ERROR the socket could not be bound to the given address
        @throw HTTPLISTENER-BIND-ERROR the listener could not bind on the given address

        @note if \c bind begins with a "/" character then it is assumed to be a UNIX socket path and the \a family
        key of the \a info hash is ignored

        @note By default (\c sync: \c True), this method blocks until async I/O is ready to accept connections.
        Set \c sync: \c False in \a info to add multiple listeners without blocking, then call
        @ref waitForAsyncIo() manually.

        @since HttpServer 0.3.13.1
    */
    list<hash<auto>> addListeners(string bind, hash<HttpListenerOptionInfo> info,
            *reference<hash<string, string>> errmap) {
        list<hash<auto>> rv;
        if (bind !~ /:\w+/) {
            if (bind =~ /^\//) {
                info.node = bind;
                remove info.service;
                rv = list(addListenerIntern(info).getInfo());
            } else {
                # assume service only
                remove info.node;
                info.service = bind;
                rv = addINETListenersIntern(info, \errmap);
            }
        } else {
            # add node and service
            (info.node, info.service) = (bind =~ x/(.+):(\w+)/);
            rv = addINETListenersIntern(info, \errmap);
        }
        if (info.sync) {
            waitForAsyncIo();
        }
        return rv;
    }

    #! adds one or more dedicated listeners to the server with the given bind address
    /** @param info a listener information hash
        @param errmap an optional reference to a hash of error information keyed by bind address

        @return a list of listener info hashes; see the return value of HttpServer::getListenerInfo() for the
        description of each hash element in the list returned by this method

        @throw HTTPSERVER-ADDLISTENER-ERROR missing bind info, duplicate bind address, or duplicate listener name
        @throw SOCKET-BIND-ERROR the socket could not be bound to the given address
        @throw HTTPLISTENER-BIND-ERROR the listener could not bind on the given address

        @note if \c bind begins with a "/" character then it is assumed to be a UNIX socket path and the \a family
        key of the \a info hash is ignored

        @note By default (\c sync: \c True), this method blocks until async I/O is ready to accept connections.
        Set \c sync: \c False in \a info to add multiple listeners without blocking, then call
        @ref waitForAsyncIo() manually.

        @since HttpServer 0.3.13.1
    */
    list<hash<auto>> addListeners(hash<HttpListenerOptionInfo> info, *reference<hash<string, string>> errmap) {
        list<hash<auto>> rv;
        if (exists info.node && !exists info.service) {
            # try to bind without a service, can be a UNIX domain socket
            rv = list(addListenerIntern(info).getInfo());
        } else {
            rv = addINETListenersIntern(info, \errmap);
        }
        if (info.sync) {
            waitForAsyncIo();
        }
        return rv;
    }

    #! adds a single global listener to the server
    /** @param port the port number

        @return a listener info hash; see the return value of HttpServer::HttpServer::getListenerInfo() for the
        description of the hash returned by this method

        @throw HTTPSERVER-ADDLISTENER-ERROR missing bind info, duplicate bind address, or duplicate listener name
        @throw SOCKET-BIND-ERROR the socket could not be bound to the given address
        @throw HTTPLISTENER-BIND-ERROR the listener could not bind on the given address

        @note This method blocks until async I/O is ready to accept connections.
        Use @ref HttpServer::HttpServer::addListener "addListener(hash<HttpListenerOptionInfo>)" with \c sync: \c False to add listeners without blocking.
     */
    hash<auto> addListener(int port) {
        hash<auto> rv = addListenerIntern(<HttpListenerOptionInfo>{
            "service": port,
        }).getInfo();
        # sync defaults to True, so wait for async I/O to be ready
        waitForAsyncIo();
        return rv;
    }

    #! adds a single global listener to the server
    /** @param opts the listener options

        @return a listener info hash; see the return value of HttpServer::HttpServer::getListenerInfo() for the
        description of the hash returned by this method

        @throw HTTPSERVER-ADDLISTENER-ERROR missing bind info, duplicate bind address, or duplicate listener name
        @throw SOCKET-BIND-ERROR the socket could not be bound to the given address
        @throw HTTPLISTENER-BIND-ERROR the listener could not bind on the given address

        @note if \a sock begins with a "/" character then it is assumed to be a UNIX socket path and the \a family
        key is ignored

        @note By default (\c sync: \c True), this method blocks until async I/O is ready to accept connections.
        Set \c sync: \c False in \a opts to add multiple listeners without blocking, then call
        @ref waitForAsyncIo() manually.
     */
    hash<auto> addListener(hash<HttpListenerOptionInfo> opts) {
        hash<auto> rv = addListenerIntern(opts).getInfo();
        if (opts.sync) {
            waitForAsyncIo();
        }
        return rv;
    }

    #! Adds an HTTP/3 QUIC listener on the given UDP port
    /** The QUIC listener inherits \c additional_info from the options (if provided), ensuring
        that custom listener configuration (cookie names, OIDC flags, public URLs, etc.) is
        propagated from the parent TCP listener.

        @param opts listener options; \c cert and \c key are required for QUIC TLS 1.3;
        \c additional_info is passed through to the underlying HttpListener
        @param port the UDP port to bind for QUIC (0 for random port)

        @return a hash with \c port and \c name keys

        @throw HTTP3-ERROR if certificate/key missing

        @since Qore 2.3
    */
    hash<auto> addQuicListener(hash<HttpListenerOptionInfo> opts, int port = 0) {
        if (!opts.cert || !opts.key) {
            throw "HTTP3-ERROR", "QUIC requires SSL certificate and private key for TLS 1.3";
        }

        # Create a UDP socket and bind it
        Socket udp_sock();
        on_error try { udp_sock.close(); } catch () {}
        string bind_addr = opts.node ?? "0.0.0.0";
        string bind_port = port > 0 ? string(port) : (opts.service ?? "0");
        # Resolve the address family: use the explicitly requested family, or detect from
        # the bind address ("::" is IPv6, anything else defaults to IPv4)
        int family;
        if (opts.family != AF_UNSPEC) {
            family = opts.family;
        } else if (bind_addr == "::" || bind_addr =~ /^[0-9a-fA-F]*:/) {
            family = AF_INET6;
        } else {
            family = AF_INET;
        }
        udp_sock.bindINET(bind_addr, bind_port, True, family, SOCK_DGRAM);

        # Get the actual port that was bound
        hash<auto> sock_info = udp_sock.getSocketInfo();
        int actual_port = sock_info.port;

        # Set up SSL certificate and key for QUIC
        udp_sock.setCertificate(opts.cert);
        udp_sock.setPrivateKey(opts.key);

        string name = opts.name ?? sprintf("quic-%d", actual_port);

        # Create an HttpListener for handler dispatch (no TCP bind);
        # pass UDP socket info via ext_info so getInfo() includes address/family details
        int lid = seqListeners.next();
        string lname = name + sprintf("-%d", lid);
        hash<HttpListenerOptionInfo> listener_opts = <HttpListenerOptionInfo>{
            "name": lname,
            "cert": opts.cert,
            "key": opts.key,
            "ssl_verify_flags": opts.ssl_verify_flags,
            "get_remote_certs": opts.get_remote_certs,
            "no_bind": True,
            "ext_info": sock_info{"address", "address_desc", "family", "familystr", "port",
                "hostname", "hostname_desc"},
        };
        if (opts.additional_info) {
            listener_opts.additional_info = opts.additional_info;
        }
        HttpListener http_listener = getListener(self, lid, listener_opts);
        # Increment listener counter; decremented by HttpListener::listenerStopped()
        # when the listener is stopped/deleted (on_error handles setup failures)
        c.add();
        on_error c.done();

        # Register with the async I/O controller
        if (!asyncIo) {
            throw "HTTP3-ERROR", "async I/O controller not initialized";
        }
        asyncIo.addQuicListener(udp_sock, asyncTarget, opts.cert, opts.key, http_listener,
            opts.ssl_verify_flags, opts.ssl_accept_all_certs, opts.get_remote_certs);

        listeners{lid} = http_listener;
        nmap{lname} = lid;
        # NOTE: QUIC listeners are not added to smap (bind-address map) because
        # they use UDP sockets with a different address format than TCP listeners.
        # Use getListeners() or nmap (by name) to find QUIC listeners.

        log("QUIC/HTTP/3 listener started on UDP port %d (name: %s)",
            actual_port, name);

        return {
            "port": actual_port,
            "name": name,
            "protocol": "h3",
            "id": lid,
            "alt_svc_max_age": opts.alt_svc_max_age ?? alt_svc_max_age,
        };
    }

    #! throws an exception; these objects do not support copying
    copy() {
        throw "COPY-ERROR", "this object cannot be copied";
    }

    #! returns a hash of listener information
    /** @return a hash of listener info hashes keyed by listener ID; see the return value of HttpServer::getListenerInfo() for the description of each hash value
     */
    hash<string, hash<auto>> getListeners() {
        return (map {$1.key: $1.value.getInfo()}, listeners.pairIterator()) ?? {};
    }

    #! returns a hash of information about the listener given the listener ID
    /** @param id the listener ID

        @return a hash of listener information with the following keys:
        - \c name: the listener name
        - \c hostname: the listening interface name if available (ex: "localhost"; note that this key is not present when retrieving information about UNIX sockets)
        - \c hostname_desc: a descriptive string giving the hostname and the address family if the hostname is available (ex: "ipv6[localhost]"; note that this key is not present when retrieving information about UNIX sockets)
        - \c address: a string giving the address (ex: "::ffff:0.0.0.0")
        - \c address_desc: a descriptive string giving the address and the address family (ex: "ipv6[::ffff:0.0.0.0]")
        - \c port: an integer port number if available (note that this key is not present when retrieving information about UNIX sockets)
        - \c family: the network address family (see @ref network_address_family_constants "Network Address Family Constants")
        - \c familystr: a string describing the network address family (ex: "ipv4")
        - \c proto: the protocol used; either \c "http" or \c "https" for secure listeners
        - \c id: the listener ID
        - \c bind: the bind specification used

        @throw INVALID-LISTENER-ERROR invalid listener ID
     */
    hash<auto> getListenerInfo(softint id) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id)) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);
        }

        return listeners{id}.getInfo();
    }

    #! returns a hash of information about the listener given the listener name or bind ID
    /** @param name the listener name or bind ID

        @return a hash of listener information with the following keys:
        - \c name: the listener name
        - \c hostname: the listening interface name if available (ex: "localhost"; note that this key is not present
          when retrieving information about UNIX sockets)
        - \c hostname_desc: a descriptive string giving the hostname and the address family if the hostname is
          available (ex: "ipv6[localhost]"; note that this key is not present when retrieving information about UNIX
          sockets)
        - \c address: a string giving the address (ex: "::ffff:0.0.0.0")
        - \c address_desc: a descriptive string giving the address and the address family (ex: "ipv6[::ffff:0.0.0.0]")
        - \c port: an integer port number if available (note that this key is not present when retrieving information
          about UNIX sockets)
        - \c family: the network address family (see
          @ref network_address_family_constants "Network Address Family Constants")
        - \c familystr: a string describing the network address family (ex: "ipv4")
        - \c proto: the protocol used; either \c "http" or \c "https" for secure listeners
        - \c id: the listener ID
        - \c bind: the bind specification used

        @throw INVALID-LISTENER-ERROR invalid listener name or bind ID
     */
    hash<auto> getListenerInfoName(string name) {
        lm.enter();
        on_exit lm.exit();

        softstring id = getListenerIdFromBindUnlocked(name);
        return listeners{id}.getInfo();
    }

    #! Reloads an HTTPS certificate from the original location for the given listener from the listener ID
    /** @param id the listener ID

        Subsequent connections will use the new certificate definition; the listener must have been started with the
        location information for the X.509 certificate and private key, or a REFRESH-CERTIFICATE-ERROR exception is
        raised

        @throw REFRESH-CERTIFICATE-ERROR not an HTTPS listener or certificate location information not present

        @since HttpServer 1.1
    */
    reloadListenerCertificate(int id) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id)) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);
        }

        listeners{id}.reloadCertificate();
    }

    #! Reloads an HTTPS certificate from the original location for the given listener from the listener name
    /** @param name the listener name or bind address

        Subsequent connections will use the new certificate definition; the listener must have been started with the
        location information for the X.509 certificate and private key, or a REFRESH-CERTIFICATE-ERROR exception is
        raised

        @throw REFRESH-CERTIFICATE-ERROR not an HTTPS listener or certificate location information not present

        @since HttpServer 1.1
    */
    reloadListenerCertificateName(string name) {
        lm.enter();
        on_exit lm.exit();

        listeners{getListenerIdFromBindUnlocked(name)}.reloadCertificate();
    }

    #! returns the number of running HTTP listeners
    int getListenerCount() {
        return listeners.size();
    }

    #! stops all listeners; does not wait for all connections on the listeners to close
    stopNoWait() {
        # stop all listeners
        {
            lm.enter();
            on_exit lm.exit();

            map $1.stopNoWait(), listeners.iterator();
        }

        threadPool.stop();
    }

    #! waits for all listeners to be stopped; call after calling HttpServer::stopNoWait()
    waitStop() {
        c.wait();
    }

    #! called from listener when the actual listener thread is running
    /** @param id the listener ID
        @param sinfo a socket information hash as returned by @ref Qore::Socket::getSocketInfo()

        @since HttpServer 0.3.11
     */
    listenerStarted(int id, hash<auto> sinfo) {
        log("HTTP listener %d started on %s", id, sinfo.desc);
    }

    #! Removes a listener from the async I/O controller before the socket is closed
    /** Called from HttpListener::stop() to cancel pending accept operations on
        the listener's fd BEFORE the fd is closed.  This ensures the I/O thread
        sees clean cancellation (canceled=True callbacks) rather than error
        callbacks on a closed fd that trigger failed replenishment attempts.

        Safe to call multiple times — listenerStopped() handles the redundant
        removeListener() gracefully.
    */
    removeAsyncListener(HttpListener l) {
        if (asyncIo) {
            try {
                asyncIo.removeListener(l);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "CONTROLLER-REMOVE-LISTENER-ERROR"
                        && ex.err != "ASYNCSOCKETIO-CANCEL-ERROR") {
                    rethrow;
                }
            }
        }
    }

    # only called from the listeners - do not call externally
    listenerStopped(HttpListener l) {
        # decrement listener count (guard against double-call from async cleanup + stop)
        on_exit {
            try {
                c.done();
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "WAITGROUP-ERROR") {
                    rethrow;
                }
            }
        }

        lm.enter();
        on_exit {
            lm.exit();
        }

        # Remove listener from async I/O controller if running
        if (asyncIo) {
            try {
                asyncIo.removeListener(l);
            } catch (hash<ExceptionInfo> ex) {
                # Ignore error if listener was not registered (can happen during shutdown)
                if (ex.err != "CONTROLLER-REMOVE-LISTENER-ERROR"
                        && ex.err != "ASYNCSOCKETIO-CANCEL-ERROR") {
                    rethrow;
                }
            }
        }

        string lid = string(l.getID());

        # If this TCP listener had an auto-created QUIC listener, stop it too
        if (quic_listener_map.hasKey(lid)) {
            int quic_lid = remove quic_listener_map{lid};
            remove quic_port_map{lid};
            remove quic_alt_svc_max_age{lid};
            updateAltSvcHeader();
            # Stop the QUIC listener if it still exists.
            # NOTE: stop() triggers the QUIC listener's own listenerStopped()
            # flow which removes it from listeners{}, nmap{}, and smap{}.
            if (listeners.hasKey(string(quic_lid))) {
                try {
                    listeners{quic_lid}.stop();
                } catch (hash<ExceptionInfo> ex) {
                    # Best-effort cleanup
                }
            }
        }

        delete smap.(l.getAddress());
        remove listeners.(l.getID());
        remove nmap.(l.getName());
        #printf("stopped %s c=%y\n", l.getAddress(), c.getCount());
    }

    #! Stops the HTTP server and releases all resources
    /** Performs a synchronous, ordered shutdown:
        -# Signals streaming handlers (SSE, WebSocket) to stop
        -# Stops the async I/O controller (cancels all accept, connection, and streaming
           operations and waits for in-flight handler tasks to complete)
        -# Cancels remaining ops by owner on the global async I/O controller
        -# Stops listeners and waits for all listener-stopped callbacks
        -# Flushes any remaining async callbacks and stops the internal thread pool

        This method blocks until all connections are closed and handler tasks complete.

        @note HttpServer instances are not restartable after \c stop(). Create a new
        HttpServer if a restart is needed.
    */
    stop() {
        {
            AutoLock al(stop_m);
            if (stopped || stopping) {
                return;
            }
            stopping = True;
        }
        if (callback_appender) {
            try {
                logger.removeAppender(callback_appender);
            } catch (hash<ExceptionInfo> ex) {
            }
            callback_appender = NOTHING;
        }
        # Cancel operations owned by this server on the global controller FIRST
        # (e.g. HTTP/2 and HTTP/3 poll operations from execAsyncPollOperation).
        # This must happen before asyncIo.stop() because that method calls
        # handler_pool.stopWait() which blocks until all handler tasks complete.
        # Handler tasks waiting in execAsyncPollOperation() (done.waitForZero())
        # will only unblock once their operations are cancelled and the onComplete
        # callback decrements the counter.
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        string ownerId = self.uniqueHash();
        @debug(log("stop: calling cancelByOwner(%s)", ownerId));
        int canceled = ctrl.cancelByOwner(ownerId);
        @debug(log("stop: cancelByOwner() canceled %d operations", canceled));

        # Flush callbacks from the cancelByOwner above so that handler tasks
        # blocked in execAsyncPollOperation() are unblocked before we stop
        # the handler pool
        ctrl.flushCallbacks();

        # Stop the callback-based async I/O controller
        # The new HttpAsyncSocketIoController.stop() cancels all HTTP operations it manages
        # (accept, header reads, idle connections) on the global async I/O controller
        if (asyncIo) {
            # Signal streaming handlers before stopping the controller so handler tasks
            # exit promptly (done here instead of in HttpServerNativeAsyncTarget.stopStreaming()
            # to avoid a reference cycle between the target and HttpServer)
            signalStreamingHandlersToStop();
            asyncIo.stop();
        }

        # Shutdown all listeners - stop accepting new connections
        {
            lm.enter();
            on_exit {
                lm.exit();
            }

            map $1.stop(), listeners.iterator();
        }

        # Wait for all listener stopped callbacks outside of lm scope to avoid deadlock
        # with background listener stop threads from stopNoWait() that need lm to call
        # listenerStopped() -> c.done()
        c.wait();

        # Flush any remaining async callbacks (from listener stops)
        ctrl.flushCallbacks();

        threadPool.stop();

        {
            AutoLock al(stop_m);
            stopped = True;
            stopping = False;
        }
    }

    #! stops a single listener based on its name or bind address; does not return until all connections on the listener have closed
    /** @param bind listener bind address

        @throw INVALID-LISTENER-ERROR invalid listener bind address
        @throw HTTP-SERVER-ERROR cannot stop last listener
    */
    stopListener(softstring bind) {
        lm.enter();
        on_exit lm.exit();

        *int id = smap{bind};
        if (!id) {
            id = nmap{bind};
        }

        if (!id) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with name or bind address %y", bind);
        }

        if (protect_last_listener && (elements smap == 1)) {
            throw "HTTP-SERVER-ERROR", "cannot stop last listener";
        }

        listeners{id}.stop();
    }

    #! stops a single listener based on its listener ID; does not return until all connections on the listener have closed
    /** @param id listener id

        @throw INVALID-LISTENER-ERROR invalid listener ID
        @throw HTTP-SERVER-ERROR cannot stop last listener
    */
    stopListenerID(softint id) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id)) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);
        }

        if (protect_last_listener && (smap.size() == 1)) {
            throw "HTTP-SERVER-ERROR", "cannot stop last listener";
        }

        listeners{id}.stop();
    }

    #! starts the shutdown process for a listener based on its listener ID; returns immediately
    /** @param id listener id

        @throw INVALID-LISTENER-ERROR invalid listener ID
        @throw HTTP-SERVER-ERROR cannot stop last listener
    */
    stopListenerIDNoWait(softint id) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id)) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);
        }

        if (protect_last_listener && (smap.size() == 1)) {
            throw "HTTP-SERVER-ERROR", "cannot stop last listener";
        }

        background listeners{id}.stop();
    }

    #! sets the default request handler when no other handler can be matched
    setDefaultHandler(string name, HttpServer::AbstractHttpRequestHandler obj) {
        defaultHandler = new HandlerInfo(name, <HttpHandlerConfigInfo>{
            "handler": obj,
        });
    }

    #! sets a request handler according to the arguments given
    setHandler(string name, hash<HttpHandlerConfigInfo> info) {
        handlers.setHandler(name, info);
    }

    #! sets a request handler according to the arguments given
    setHandler(string name, string path, *softlist<softstring> content_types, HttpServer::AbstractHttpRequestHandler obj, *softlist<softstring> special_headers, bool isregex = True) {
        handlers.setHandler(name, <HttpHandlerConfigInfo>{
            "path": path,
            "isregex": isregex,
            "content_types": content_types,
            "handler": obj,
            "headers": special_headers,
        });
    }

    #! sets a dynamic request handler according to the arguments given
    setDynamicHandler(string name, hash<HttpHandlerConfigInfo> info) {
        dhandlers.setHandler(name, info);
    }

    #! sets a dynamic request handler according to the arguments given
    setDynamicHandler(string name, string path, *softlist<softstring> content_types,
            HttpServer::AbstractHttpRequestHandler obj, *softlist<softstring> special_headers, bool isregex = True) {
        dhandlers.setHandler(name, <HttpHandlerConfigInfo>{
            "path": path,
            "isregex": isregex,
            "content_types": content_types,
            "handler": obj,
            "headers": special_headers,
        });
    }

    #! sets a request handler according to the arguments given
    setHandler(string name, HttpServer::AbstractUrlHandler obj) {
        handlers.setHandler(name, <HttpHandlerConfigInfo>{
            "path": obj.url_root,
            "isregex": False,
            "handler": obj,
        });
    }

    #! sets a dynamic request handler according to the arguments given
    setDynamicHandler(string name, HttpServer::AbstractUrlHandler obj) {
        dhandlers.setHandler(name, <HttpHandlerConfigInfo>{
            "path": obj.url_root,
            "isregex": False,
            "handler": obj,
        });
    }

    #! adds a request handler to a listener given the listener's name or bind address
    addHandlerToListener(softstring bind, string name, hash<HttpHandlerConfigInfo> info) {
        lm.enter();
        on_exit lm.exit();

        softstring id = getListenerIdFromBindUnlocked(bind);
        listeners{id}.addHandlers({name: info});
    }

    #! adds a request handler to a listener given the listener's id
    /** @param id listener id
        @param name handler name
        @param info the handler configuration info to add to the listener

        @note If the listener has a paired QUIC/HTTP3 listener, the handler is automatically
        propagated to it with a \c "-h3" suffix on the name.

        @throw INVALID-LISTENER-ERROR invalid listener id passed
    */
    addHandlerToListenerID(softint id, string name, hash<HttpHandlerConfigInfo> info) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id)) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);
        }

        listeners{id}.addHandlers({name: info});

        # propagate handler to the paired QUIC/HTTP3 listener if one exists
        if (*int quic_id = quic_listener_map{id}) {
            if (listeners.hasKey(quic_id)) {
                listeners{quic_id}.addHandlers({name + "-h3": info});
            }
        }
    }

    #! adds a request handler to a listener given the listener's id
    /** @param id listener id
        @param name handler name
        @param path handler path
        @param content_type handler's content type
        @param obj handler object
        @param special_headers headers to match
        @param isregex is the path a regular expression

        @throw INVALID-LISTENER-ERROR invalid listener id passed
    */
    addHandlerToListenerID(softint id, string name, string path, *softlist content_type,
            HttpServer::AbstractHttpRequestHandler obj, *softlist special_headers, bool isregex = True) {
        addHandlerToListenerID(id, name, <HttpHandlerConfigInfo>{
            "path": path,
            "isregex": isregex,
            "content_types": content_type,
            "handler": obj,
            "headers": special_headers,
        });
    }

    #! adds a request handler to a listener given the listener's name or bind address
    addHandlerToListener(softstring bind, string name, HttpServer::AbstractUrlHandler obj) {
        lm.enter();
        on_exit lm.exit();

        softstring id = getListenerIdFromBindUnlocked(bind);

        hash<string, hash<HttpHandlerConfigInfo>> h = {
            name: <HttpHandlerConfigInfo>{
                "path": obj.url_root,
                "isregex": False,
                "handler": obj,
            },
        };
        listeners{id}.addHandlers(h);
    }

    #! adds a request handler to a listener given the listener's id
    /** @param id listener id
        @param name handler name
        @param obj handler object

        @throw INVALID-LISTENER-ERROR invalid listener id passed
    */
    addHandlerToListenerID(softint id, string name, HttpServer::AbstractUrlHandler obj) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id)) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);
        }

        hash<string, hash<HttpHandlerConfigInfo>> h = {
            name: <HttpHandlerConfigInfo>{
                "path": obj.url_root,
                "isregex": False,
                "handler": obj,
            },
        };
        listeners{id}.addHandlers(h);

        # propagate handler to the paired QUIC/HTTP3 listener if one exists
        if (*int quic_id = quic_listener_map{id}) {
            if (listeners.hasKey(quic_id)) {
                listeners{quic_id}.addHandlers({name + "-h3": h{name}});
            }
        }
    }

    #! remove request handler from a listener given the listener's id
    /** @param id listener id
        @param handler_name name of handler to remove
        @return whether listener was stopped

        @note If the listener has a paired QUIC/HTTP3 listener, the propagated handler
        (with \c "-h3" suffix) is also removed from it.

        @throw INVALID-LISTENER-ERROR invalid listener id passed
    */
    bool removeHandlerFromListenerID(softstring id, string handler_name) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id)) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);
        }
        listeners{id}.removeHandler(handler_name);

        # also remove the propagated handler from the paired QUIC listener
        if (*int quic_id = quic_listener_map{id}) {
            if (listeners.hasKey(quic_id)) {
                try {
                    listeners{quic_id}.removeHandler(handler_name + "-h3");
                } catch () {
                    # handler may not exist on the QUIC listener (e.g., added before QUIC pairing)
                }
                HttpServer::HttpListener::stopIfNoHandlers(listeners{quic_id});
            }
        }

        return HttpServer::HttpListener::stopIfNoHandlers(listeners{id});
    }

    #! remove request handler from a listener given the listener's id
    /** @param id listener id
        @param handler handler to remove
        @return whether listener was stopped

        @note If the listener has a paired QUIC/HTTP3 listener, the handler is also removed
        from it.

        @throw INVALID-LISTENER-ERROR invalid listener id passed
    */
    bool removeHandlerFromListenerID(softstring id, HttpServer::AbstractHttpRequestHandler handler) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id)) {
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);
        }
        listeners{id}.removeHandler(handler);

        # also remove the same handler from the paired QUIC listener
        if (*int quic_id = quic_listener_map{id}) {
            if (listeners.hasKey(quic_id)) {
                try {
                    listeners{quic_id}.removeHandler(handler);
                } catch () {
                    # handler may not exist on the QUIC listener
                }
                HttpServer::HttpListener::stopIfNoHandlers(listeners{quic_id});
            }
        }

        return HttpServer::HttpListener::stopIfNoHandlers(listeners{id});
    }

    #! turns on or off header and body logging options for receive operations for the given listener
    /** @par Example:
        @code{.py}
http.setListenerLogOptions("app", LLO_RECV_HEADERS|LLO_SEND_HEADERS);
        @endcode

        @param bind the name of the listener or bind string
        @param code a binary-or'ed product of @ref ListenerLogOptions "listener log options"; bits set enable logging; bits not set disable logging

        @since HttpServer 0.3.11
     */
    setListenerLogOptions(softstring bind, softint code) {
        lm.enter();
        on_exit lm.exit();

        setListenerLogOptionsUnlocked(getListenerIdFromBindUnlocked(bind), code);
    }

    #! turns on or off header and body logging options for receive operations for the given listener
    /** @par Example:
        @code{.py}
http.setListenerLogOptionsID(0, LLO_RECV_HEADERS|LLO_SEND_HEADERS);
        @endcode

        @param id the unique listener ID
        @param code a binary-or'ed product of @ref ListenerLogOptions "listener log options"; bits set enable logging; bits not set disable logging

        @throw INVALID-LISTENER-ERROR invalid listener id passed

        @since HttpServer 0.3.11
     */
    setListenerLogOptionsID(softint id, softint code) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id))
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);

        setListenerLogOptionsUnlocked(id, code);
    }

    #! returns a binary-or'ed product of @ref ListenerLogOptions "listener log options" corresponding to enabled log options for the given listener
    /**
        @throw INVALID-LISTENER-ERROR invalid listener id passed

        @since HttpServer 0.3.11
    */
    int getListenerLogOptions(softstring bind) {
        lm.enter();
        on_exit lm.exit();

        return getListenerLogOptionsUnlocked(getListenerIdFromBindUnlocked(bind));
    }

    #! returns a binary-or'ed product of @ref ListenerLogOptions "listener log options" corresponding to enabled log options for the given listener
    /**
        @throw INVALID-LISTENER-ERROR invalid listener id passed

        @since HttpServer 0.3.11
    */
    int getListenerLogOptionsID(softint id) {
        lm.enter();
        on_exit lm.exit();

        if (!listeners.hasKey(id))
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with ID %d", id);

        return getListenerLogOptionsUnlocked(id);
    }

    #! Disable dynamic handler
    /** @throw DISABLEHANDLER-ERROR if the given dynamic handler does not exist
    */
    disableDynamicHandler(string name) {
        dhandlers.disableHandler(name);
    }

    #! remove dynamic handler
    /** @throw REMOVEHANDLER-ERROR if the given dynamic handler does not exist
    */
    removeDynamicHandler(string name, *bool force_immediate) {
        dhandlers.removeHandler(name, force_immediate);
    }

    #! called to log information to the registered log code
    log(string fmt, ...) {
        logger.logArgs(LoggerLevel::INFO, "HttpServer: " + fmt, argv);
    }

    #! called to log error information to the registered error log code
    logError(string fmt, ...) {
        logger.logArgs(LoggerLevel::ERROR, "HttpServer: " + fmt, argv);
    }

    #! sends an HTTP error message on the socket
    sendHttpError(HttpListener listener, hash<auto> cx, Socket s, int status_code, *data msg, *InputStream chunked_msg,
            *hash<auto> extra_hdrs, *string encoding, bool head) {
        if (!s.isOpen()) {
            listener.log("cid %d: connection closed by peer", cx.id);
            return;
        }

        bool is_http2 = cx."header-info".http2 ?? False;
        bool is_multiplexed = is_http2 || (cx."header-info".http3 ?? False);
        data response_msg;
        if (msg || !chunked_msg) {
            # issue #3116: do not send a reply body if the response code does not allow it
            /** http://tools.ietf.org/html/rfc2616#section-4.4
                1.Any response message which "MUST NOT" include a message-body (such
                as the 1xx, 204, and 304 responses and any response to a HEAD
                request) is always terminated by the first empty line after the
                header fields, regardless of the entity-header fields present in
                the message.
            */
            if (!head && (status_code >= 200) && (status_code != 204) && (status_code != 304)) {
                if (msg.typeCode() == NT_STRING) {
                    response_msg = !extra_hdrs."Content-Type" && acceptsHtml(cx)
                        ? getHtmlErrorMessage(status_code, msg)
                        : msg;
                } else {
                    response_msg = msg;
                }
            }
        } else {
            if (chunked_msg instanceof StringInputStream) {
                # ignore any encoding passed in case of a string input stream response body, and use its encoding
                encoding = cast<StringInputStream>(chunked_msg).getEncoding();
            }
            if (is_multiplexed) {
                # Keep the InputStream for HTTP/2 and HTTP/3 streaming - don't buffer
            } else {
                extra_hdrs."Transfer-Encoding" = "chunked";
            }
        }

        # restore encoding on exit
        string old_encoding = s.getEncoding();
        on_exit if (old_encoding != s.getEncoding())
            s.setEncoding(old_encoding);

        if (!encoding) {
            encoding = s.getEncoding().lwr();
        } else if (encoding != s.getEncoding().lwr()) {
            s.setEncoding(encoding);
        }

        hash<auto> hdr += getResponseHeaders(cx."listener-id");

        if (!extra_hdrs."Content-Type") {
            hdr."Content-Type" = MimeTypeHtml + ";charset=" + encoding;
        } else if (extra_hdrs."Content-Type" !~ /charset=/) {
            extra_hdrs."Content-Type" += ";charset=" + encoding;
        }

        if (!is_multiplexed) {
            hdr.Connection = cx.close ? "close" : "Keep-Alive";
        }

        if (extra_hdrs) {
            hdr += extra_hdrs;
        }

        hdr.Date = getDateHeader();
        if (is_multiplexed) {
            # HTTP/2 and HTTP/3 prohibit connection-specific headers (RFC 9113 Section 8.2.2,
            # RFC 9114 Section 4.2)
            remove hdr.Connection;
            remove hdr.connection;
            remove hdr."Keep-Alive";
            remove hdr."keep-alive";
            remove hdr."Proxy-Connection";
            remove hdr."proxy-connection";
            remove hdr."Transfer-Encoding";
            remove hdr."transfer-encoding";
            remove hdr.Upgrade;
            remove hdr.upgrade;
            remove hdr.TE;
            remove hdr.te;
        }

        # log exceptions if not "SOCKET-SEND-ERROR" (probably broken pipe)
        try {
            if (is_http2) {
                # HTTP/2: send response via HTTP/2 DATA frames
                int stream_id = cx."header-info".stream_id;
                auto send_body = response_msg ?? chunked_msg;
                AbstractPollOperation op;
                if (send_body instanceof InputStream) {
                    # Use streaming response for InputStream bodies
                    op = s.startPollSendHttp2StreamingResponse(stream_id, status_code, hdr,
                        send_body);
                } else {
                    if (send_body && !hdr."Content-Length") {
                        hdr."Content-Length" = string(send_body.size());
                    }
                    op = s.startPollSendHttp2Response(stream_id, status_code, hdr, send_body);
                }
                execAsyncPollOperation(s, op);
            } else if (cx."header-info".http3) {
                # HTTP/3: send response via QUIC stream (NOT the HTTP/1.x sendHTTPResponse path)
                int session_id = cx."header-info".session_id;
                int stream_id = cx."header-info".stream_id;
                auto send_body = response_msg ?? chunked_msg;
                if (send_body instanceof InputStream) {
                    # HTTP/3: stream InputStream response incrementally to avoid buffering
                    AbstractPollOperation op = s.startPollQuicSendStreamingResponse(
                        session_id, stream_id, status_code, hdr, send_body);
                    execAsyncPollOperation(s, op);
                } else {
                    s.submitQuicResponse(session_id, stream_id, status_code, hdr, send_body);
                }
            } else {
                s.sendHTTPResponse(status_code, HttpServer::HttpCodes{status_code}, "1.1", hdr,
                    response_msg ?? chunked_msg);
            }
            listener.logResponse(cx, status_code, response_msg ?? chunked_msg, hdr);
            if (status_code >= 200) {
                cx."response-sent" = True;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "SOCKET-SEND-ERROR") {
                string estr = sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc);
                logError("%s", estr);
            }
        }
    }

    string getHtmlErrorMessage(int status_code, string msg) {
        return sprintf("<html><head><title>%s %s</title></head><body><h1>%s</h1><pre>%s</pre><p><hr><address>%s on "
            "%s</address></body></html>",
                status_code, HttpServer::HttpCodes{status_code}, HttpServer::HttpCodes{status_code},
                html_encode(msg), http_server_string, gethostname());
    }

    static bool acceptsHtml(hash<auto> cx) {
        if (!cx.hdr.accept.val() || cx.hdr.accept =~ /\btext\/html\b/i || cx.hdr.accept =~ /\b\*\/\*\b/
            || cx.hdr.accept =~ /\btext\/\*\b/i) {
            return True;
        }
        return False;
    }

    #! masks log messages by removing sensitive data
    /** @see setMaskCode()

        @since %HttpServer 0.3.12
    */
    string maskData(string msg) {
        return maskfunc ? maskfunc(msg) : http_mask_data(msg);
    }

    #! sets the @ref closure "closure" or @ref call_reference "call reference" that will be used to mask sensitive data in log messages
    /** @par Example
        @code{.py}
        http_server.setMaskCode(string sub (string msg) { return do_mask(msg); });
        @endcode

        @param maskfunc a @ref closure "closure" or @ref call_reference "call reference" that takes a single string argument and returns the masked string

        @see maskData()

        @since %HttpServer 0.3.12
    */
    setMaskCode(code maskfunc) {
        self.maskfunc = maskfunc;
    }

    #! returns a complete URL from a bind address
    /** @param bind the bind address; if for any reason there is a path in the bind address, it will be ignored
        @param host the hostname to use in case the bind string is only a port number; if none is passed or the value passed is equal to the return value of @ref Qore::gethostname(), then \c "localhost" is used

        @note reexported from @ref HttpServer::http_get_url_from_bind()
     */
    static string getURLFromBind(softstring bind, *string host) {
        return HttpServer::http_get_url_from_bind(bind, host);
    }

    #! turns on or off debugging; when debugging is enabled more verbose error messages are reported
    setDebug(bool dbg = True) {
        debug = dbg;
    }

    #! returns the current status of the debug flag
    bool getDebug() {
        return debug;
    }

    #! Returns a connection to the async I/O controller for keep-alive handling
    /** @param sock the socket to return
        @param cx the connection context
        @param listener the listener for this connection

        @since HttpServer 1.5
    */
    returnConnectionToAsyncIo(Socket sock, hash<auto> cx, HttpListener listener) {
        if (asyncIo && asyncTarget) {
            asyncIo.addIdleConnection(sock, listener, cx, asyncTarget, ttl);
        }
    }

    #! Waits for async I/O to be ready to accept connections
    /** This method blocks until the async I/O controller and its coordinator thread are ready
        to process connections. Call this after @ref addListener() (with \c sync: \c False) to
        ensure the server is fully ready before clients connect.

        When \c sync is \c True (the default), @ref addListener() calls this method automatically,
        so an explicit call is only needed when adding multiple listeners with \c sync: \c False
        for batch setup efficiency.

        Common use cases:
        - Test setup: call after \c addListener() to guarantee the server is accepting before
          clients connect
        - Batch listener setup: add several listeners with \c sync: \c False, then call this
          once to wait for all of them
        - Orchestration: ensure the server is fully operational before advertising its address
          to service registries, load balancers, or health checks

        @param timeout maximum time to wait; use @ref NOTHING for no timeout (default: 5 seconds)

        @return @ref True if async I/O is ready, @ref False if the timeout expired

        @since HttpServer 1.1.4
    */
    bool waitForAsyncIo(*timeout timeout) {
        if (!asyncIo) {
            return False;
        }
        timeout = timeout ?? 5s;
        # Wait for the global async I/O controller's I/O thread to be ready
        return AsyncSocketIo::getGlobalAsyncIoController().waitForProcessing(timeout);
    }

    startConnection(code c) {
        threadPool.submit(c);
    }

    #! This method is called after each request to clear context info so that it does not leak into other requests
    /** Reimplement in subclasses if necessarily

        @since HttpServer 1.1.2
    */
    clearContextInfo() {
        # this method left intentionally blank
    }

    #! Calculate the Date header only once per second
    static string getDateHeader() {
        int now = clock_getseconds();
        if (now != cached_date_epoch) {
            # Update header BEFORE epoch to avoid a race: if epoch is set first,
            # a concurrent thread sees epoch == now and returns the stale (or
            # uninitialized NOTHING) cached_date_header before we assign it.
            cached_date_header = gmtime().format("Dy, DD Mon YYYY HH:mm:SS") + " GMT";
            cached_date_epoch = now;
        }
        return cached_date_header;
    }

    #! Common constructor code
    private init(hash<HttpServerOptionInfo> opts) {
        if (opts.idle_threads < 1) {
            throw "HTTP-SERVER-INIT-ERROR", sprintf("idle_threads (%d) must be greater than zero", opts.idle_threads);
        }
        threadPool = new ThreadPool(-1, opts.idle_threads);
        http_server_string = opts.name;
        debug = opts.debug;
        hdr = opts.hdr;
        protect_last_listener = opts.protect_last_listener ?? False;
        logger = opts.logger ?? new Logger(http_server_string, LoggerLevel::getLevelInfo());
        if (opts.ttl) {
            setTtl(opts.ttl);
        }
        max_request_body_size = opts.max_request_body_size ?? 0;
        enable_h3 = opts.enable_h3 ?? True;
        alt_svc_max_age = opts.alt_svc_max_age ?? 3600;
        # Initialize async I/O
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        # Set logger on the global controller for async I/O logging
        ctrl.setLogger(logger);
        asyncTarget = new Priv::HttpServerNativeAsyncTarget(logger);
        asyncIo = new HttpServerAsyncIo::HttpAsyncSocketIoController(ctrl, logger, {
            "max_handler_threads": opts.max_handler_threads,
            "min_idle_handler_threads": opts.min_idle_handler_threads,
            "max_idle_handler_threads": opts.max_idle_handler_threads,
            "quic_drain_timeout": opts.quic_drain_timeout,
            "quic_headers_only": opts.quic_headers_only,
        });
        asyncIo.start();
    }

    #! Updates the per-listener Alt-Svc response headers based on active QUIC listeners
    /** Rebuilds the \c Alt-Svc header for each TCP listener that has a QUIC counterpart.
        Each TCP listener only advertises its own QUIC port (not all QUIC ports) to prevent
        browsers from connecting to the wrong QUIC listener when multiple listeners are active.
        Called whenever QUIC listeners are added or removed.

        @since HttpServer 1.6
    */
    private updateAltSvcHeader() {
        # Build per-listener Alt-Svc headers.  Each TCP listener advertises
        # only its own QUIC counterpart so browsers don't confuse origins.
        # NOTE: thread-safe because Qore hash/string value assignments are
        # atomic (reference-counted); readers get the old or new value,
        # never a partial/corrupt value.
        foreach string lid in (keys quic_port_map) {
            int quic_port = quic_port_map{lid};
            int ma = quic_alt_svc_max_age{lid} ?? alt_svc_max_age;
            listener_alt_svc{lid} = sprintf("h3=\":%d\"; ma=%d", quic_port, ma);
        }
        # Remove entries for TCP listeners that no longer have QUIC counterparts
        foreach string lid in (keys listener_alt_svc) {
            if (!quic_port_map.hasKey(lid)) {
                remove listener_alt_svc{lid};
            }
        }
        # Keep global hdr clean (no Alt-Svc) — it's injected per-listener
        remove hdr."Alt-Svc";
    }

    #! Returns response headers with per-listener Alt-Svc injected
    /** @param listener_id the TCP listener ID (from cx."listener-id")
        @return the base response headers with Alt-Svc for this listener's QUIC counterpart
    */
    private hash<auto> getResponseHeaders(int listener_id) {
        hash<auto> rv = self.hdr;
        if (*string alt_svc = listener_alt_svc{listener_id}) {
            rv."Alt-Svc" = alt_svc;
        }
        return rv;
    }

    #! returns the listener ID from the bind name or throws an exception if not valid
    /** @throw INVALID-LISTENER-ERROR invalid listener bind address
    */
    private int getListenerIdFromBindUnlocked(string bind) {
        *int id;
        if (!(id = (smap{bind} ?? nmap{bind}))){
            throw "INVALID-LISTENER-ERROR", sprintf("there is no listener with name or bind address %y", bind);
        }
        return id;
    }

    #! turns on or off header and body logging options for the given listener according to the option code
    private setListenerLogOptionsUnlocked(softstring id, int code) {
        HttpListener l = listeners{id};
        l.logRecvHeaders(code & LLO_RECV_HEADERS);
        l.logRecvBody(code & LLO_RECV_BODY);
        l.logSendHeaders(code & LLO_SEND_HEADERS);
        l.logSendBody(code & LLO_RECV_BODY);
    }

    #! returns header and body logging options for the given listener as a binary-or'ed value of @ref ListenerLogOptions "listener log option codes"
    private int getListenerLogOptionsUnlocked(softstring id) {
        HttpListener l = listeners{id};
        hash<auto> h = l.getLogOptions();
        return
            (h.recv_headers ? LLO_RECV_HEADERS : 0)
            | (h.recv_body ? LLO_RECV_BODY : 0)
            | (h.send_headers ? LLO_SEND_HEADERS : 0)
            | (h.send_body ? LLO_SEND_BODY : 0);
    }

    #! helper method to set HTTP response headers
    static nothing setReplyHeaders(Socket s, hash<auto> cx, reference<hash<auto>> rv) {
        HttpServer::http_set_reply_headers(s, cx, \rv);
    }

    #! Creates a new HttpListener object; reimplement in subclasses to override the listener class
    private HttpListener getListener(HttpServer server, int id, hash<HttpListenerOptionInfo> info) {
        return new HttpListener(server, \handleRequest(), id, seqSessions, info);
    }

    #! @cond nodoc
    private HttpListener addListenerIntern(*string node, *softstring service, *Qore::SSLCertificate cert,
            *Qore::SSLPrivateKey key, *hash<string, hash<HttpHandlerConfigInfo>> handler_info, *LoggerInterface logger,
            *code stopc, *string name, int family = AF_UNSPEC) {
        return addListenerIntern(<HttpListenerOptionInfo>{
            "node": node,
            "service": service,
            "cert": cert,
            "key": key,
            "handler_info": handler_info,
            "logger": logger,
            "stopc": stopc,
            "family": family,
        });
    }

    private HttpListener addListenerIntern(hash<HttpListenerOptionInfo> info) {
        if (!exists info.node && !exists info.service) {
            throw "HTTPSERVER-ADDLISTENER-ERROR", sprintf("missing both \"node\" and \"service\" from listener option hash: %y", info);
        }

        string sock = (exists info.service ? sprintf("%s:%s", info.node ?? "*", info.service) : info.node);

        lm.enter();
        on_exit lm.exit();

        if (smap{sock}) {
            throw "HTTPSERVER-ADDLISTENER-ERROR", sprintf("cannot add listener on %y; there is already an existing listener with this bind address", sock);
        }

        int id = seqListeners.next();
        if (!info.name) {
            info.name = "listener";
        }
        info.name += sprintf("-%d", id);

        if (nmap{info.name}) {
            throw "HTTPSERVER-ADDLISTENER-ERROR", sprintf("there is already an active listener with name %y", info.name);
        }

        c.add();
        #printf("HttpServer::addListenerIntern() %y c=%y\n", sock, c.getCount());
        on_error c.done();

        HttpListener l = getListener(self, id, info);

        # Register listener in maps BEFORE adding to async I/O controller
        # This prevents a race where an accept could arrive before registration is complete
        listeners{id} = l;
        smap{sock} = id;
        nmap{info.name} = id;

        # rename listener if a wildcard service was provided
        if (info.service == "0") {
            int port = l.getInfo().port;
            string nsock = sprintf("%s:%s", info.node ?? "*", port);
            smap{nsock} = remove smap{sock};
        }

        # Add the listener to the async I/O controller
        # Must be done AFTER registration to avoid race condition
        asyncIo.addListener(l, asyncTarget, l.isSsl(), l.getSslCertificateObject(),
            l.getSslPrivateKeyObject(), l.getHttpVersion(), l.getSslVerifyFlags(),
            l.getSslAcceptAllCerts(), l.getGetRemoteCerts(), l.getMaxRequestBodySize(), l);

        # Auto-create QUIC listener for TLS listeners
        if (enable_h3 && info.cert && info.key && (info.enable_h3 ?? True)) {
            try {
                # Use the actual listener socket info to get the resolved address
                # and family, since the original info may have AF_UNSPEC / no node
                hash<auto> linfo = l.getInfo();
                hash<HttpListenerOptionInfo> quic_opts = <HttpListenerOptionInfo>{
                    "cert": info.cert,
                    "key": info.key,
                    "node": linfo.address ?? info.node,
                    "family": linfo.family,
                    "alt_svc_max_age": info.alt_svc_max_age,
                };
                if (info.additional_info) {
                    quic_opts.additional_info = info.additional_info;
                }
                hash<auto> quic_info = addQuicListener(quic_opts, linfo.port);
                quic_port_map{id} = quic_info.port;
                quic_alt_svc_max_age{id} = quic_info.alt_svc_max_age;
                quic_listener_map{id} = quic_info.id;
                updateAltSvcHeader();
                log("Auto-created QUIC/HTTP/3 listener on UDP port %d for TCP listener %d",
                    quic_info.port, id);
            } catch (hash<ExceptionInfo> ex) {
                # QUIC auto-creation is best-effort; log and continue with TCP-only
                log("WARNING: Failed to auto-create QUIC listener for TCP listener %d: %s: %s",
                    id, ex.err, ex.desc);
            }
        }

        return l;
    }

    private list<hash<auto>> addINETListenersIntern(hash<HttpListenerOptionInfo> info,
            *reference<hash<string, string>> errmap) {
        list<auto> al = getaddrinfo(info.node, info.service, info.family, AIFlags);

        # sort ipv6 addresses first in list
        al = sort(al, int sub (hash<auto> l, hash<auto> r) {
            return l.family === AF_INET6 ? -1 : 0;
        });

        list<hash<auto>> rv = ();
        foreach hash<auto> h in (al) {
            try {
                hash<HttpListenerOptionInfo> new_info = info;
                new_info += {
                    "node": h.address,
                    "service": h.port,
                };
                rv += addListenerIntern(new_info).getInfo();
%ifdef Windows
                if (!info.node && (info.family != AF_UNSPEC)) {
                    break;
                }
%else
                # exit after the first listener is bound if the node address is missing (= bind on all addresses)
                if (!info.node) {
                    break;
                }
%endif
            } catch (hash<ExceptionInfo> ex) {
                string errstr = sprintf("%s:%s: %s: %s: %s", h.address_desc, h.port, get_ex_pos(ex), ex.err, ex.desc);
                string bind;
                if (exists info.node) {
                    if (exists info.service) {
                        bind = sprintf("%s:%s", info.node, info.service);
                    } else {
                        bind = info.node;
                    }
                } else {
                    bind = info.service;
                }
                errmap{bind ?* "unknown"} = errstr;
                if (ex.err != "HTTPLISTENER-BIND-ERROR" && ex.err != "SOCKET-BIND-ERROR") {
                    logError("add listener %s", errstr);
                    rethrow;
                }

                log("cannot add listener on %s", errstr);
            }
        }

        return rv;
    }

    private hash<HttpResponseInfo> noHandlerError(hash<auto> cx, hash<auto> hdr, auto body) {
        string str = "";
        if (hdr.path)
            str = sprintf("url=%y", hdr.path);
        else
            str = "<no URL>";

        if (hdr."content-type")
            str += sprintf(", content-type=%y", hdr."content-type");
        else
            str += ", <no content-type>";

        log("no handler for %s (from %s) hdr: %y", str, cx."peer-info".address_desc, hdr);
        return new hash<HttpResponseInfo>({
            "code" : 501,
            "body" : sprintf("no handler has been registered for %s", str),
        });
    }

    #! @cond nodoc
    #! Handles incoming requests
    /** This method is called by listeners when a request is received.

        If async_response_out is provided, captures response info instead of sending
    */
    private handleRequest(RequestHelper request_helper, HttpListener listener, Socket s,
            reference<hash<auto>> cx, hash<auto> hdr, bool head = False, HttpPersistentHandlerInfo phi,
            hash<auto> info, *reference<hash<HttpAsyncResponseInfo>> async_response_out) {
        remove cx."response-sent";
        bool is_http2 = cx."header-info".http2 ?? False;
        bool is_multiplexed = is_http2 || (cx."header-info".http3 ?? False);
        if (is_http2) {
            s.setHttp2ActiveStream(cx."header-info".stream_id);
            on_exit s.setHttp2ActiveStream(-1);
        }
        # Check for HTTP/2 connection preface (RFC 7540 Section 3.5)
        # The preface is "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
        # HTTP parser separates this into method="PRI", path="*", protocol="HTTP/2.0" or "2.0"
        if (hdr.method == "PRI") {
            string err;
            # Check if this is an HTTP/2 preface: path="*" and version starts with "2" or "HTTP/2"
            if (hdr.path == "*" && (hdr.http_version =~ /^2\./ || hdr.http_version =~ /^HTTP\/2\./)) {
                err = "HTTP/2 cleartext (h2c) direct connection preface is not supported; "
                    "use HTTP/2 over TLS with ALPN negotiation or HTTP/1.1 Upgrade";
                listener.logError("HTTP/2 cleartext connection preface received from %s - not supported; "
                    "client should use HTTPS with ALPN or HTTP/1.1 Upgrade", info.address_desc);
            } else {
                err = sprintf("unknown / unsupported HTTP method %n", hdr.method);
                listener.logError("%s: received from %s via %s", err, info.address_desc,
                    listener.getListenerSocketInfo().address_desc);
            }
            cx.close = True;
            # Mark response as sent before calling sendHttpError to prevent double response
            cx."response-sent" = True;
            sendHttpError(listener, cx, s, 501, err, NOTHING, NOTHING, cx."response-encoding", head);
            return;
        }

        if (!http_methods{hdr.method}) {
            string err = sprintf("unknown / unsupported HTTP method %n", hdr.method);
            string str = sprintf("%s: received from %s via %s", err, info.address_desc,
                listener.getListenerSocketInfo().address_desc);
            listener.logError("%s", str);
            cx.close = True;
            sendHttpError(listener, cx, s, 501, err, NOTHING, NOTHING, cx."response-encoding", head);
            return;
        }

        # get first supported encoding for response
        foreach string enc in (cx."header-info"."accept-encoding") {
            *string e = ContentEncodings{enc};
            if (!e)
                continue;
            cx.encoding = e;
            break;
        }

        # convert "accept-encoding" to a hash
        cx."header-info"."accept-encoding" = map {$1: True}, cx."header-info"."accept-encoding";

        # erase the encoding string on exit
        on_exit remove cx.encoding;

        hash<auto> url += {
            "path": hdr.path,
        };

        # add logging functions and url
        cx += {
            "logger": logger,
            "url": url,
            "debug": debug,
        };

        # clear any context info set during handling the request so it does not leak into other requests
        on_exit try {
            clearContextInfo();
        } catch (hash<ExceptionInfo> ex) {
            # log the error
            string desc = "error clearing request context data: " + !debug
                ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                : get_exception_string(ex);
            desc += sprintf(": received from %s", cx."peer-info".address_desc);
            listener.logError("%s", desc);
        }

        HttpServer::AbstractHttpRequestHandler handler;
        # the dynamic handler helper maintains the request count for dynamic handlers so any call to remove the
        # handler will only return after all in-progress requests are completed; the object is only allocated if
        # needed
        DynamicHandlerHelper dhh;

        if (phi.handler) {
            handler = phi.handler;
        } else {
            # find a handler for the request
            *HandlerInfo hi;
            int score = 0;
            string root_path;
            if (listener.hasHandlers()) {
                hi = listener.findHandler(hdr, \score, True, \root_path);
                if (!hi) {
                    if (listener.defaultHandler) {
                        hi = listener.defaultHandler;
                    } else if (async_response_out) {
                        # Capture the 404 response for the async I/O controller to send
                        async_response_out = buildAsyncErrorResponse(404, "Not found", cx,
                            listener, s, !is_multiplexed);
                        return;
                    } else {
                        sendHttpError(listener, cx, s, 404, "Not found", NOTHING, NOTHING,
                            cx."response-encoding", head);
                        return;
                    }
                }
            } else {
                hi = handlers.findHandler(hdr, \score, False, \root_path);
                if (score < 3) {
                    *HandlerInfo dhi = dhandlers.findHandler(hdr, \score, \dhh, \root_path);
                    if (dhi)
                        hi = dhi;
                }
            }

            if (hi) {
                handler = hi.obj;
                cx.handler_name = hi.name;
                if (root_path)
                    cx.root_path = root_path;
            }
        }

        try {
            if (!handler && defaultHandler) {
                handler = defaultHandler.obj;
                cx.handler_name = defaultHandler.name;
            }

            if (handler && hdr.expect) {
                if (hdr.expect == "100-continue") {
                    hash<HttpResponseInfo> resp = handler.handleExpectHeader(cx, hdr);
                    # 100-continue is an intermediate response that must be sent directly on the
                    # socket before the client sends the body.  Do NOT route through sendReply()
                    # or doResponse() because those capture to async_response_out, which would
                    # replace the eventual main response and never reach the client.
                    if (resp."code" == 100) {
                        if (cx."header-info".http2) {
                            # HTTP/2: no 100-continue mechanism; the body is already being sent
                            # by the client on the stream — nothing to do
                        } else {
                            s.send("HTTP/1.1 100 Continue\r\n\r\n");
                        }
                    } else {
                        # Handler rejected the request (non-100 response)
                        sendReply(request_helper, listener, s, handler, resp, \cx, hdr, head,
                            \async_response_out);
                        return;
                    }
                } else {
                    string etxt = sprintf("unrecognized 'Expect' header: %y", hdr.expect);
                    string str = sprintf("%s: received from %s via %s (header: %y)", etxt,
                        cx."peer-info".address_desc, cx."socket-info".address_desc, hdr);
                    listener.logError("%s", str);
                    cx.close = True;
                    sendHttpError(listener, cx, s, 400, etxt, NOTHING, NOTHING, cx."response-encoding",
                        hdr.method == "HEAD");
                    return;
                }
            }

            # Get effective max body size for this listener
            int max_body = listener.getMaxRequestBodySize();

            # Set body size limits on socket before any body reads
            s.setMaxChunkedBodySize(max_body);
            s.setHttp2MaxRequestBodySize(max_body);

            # Check if handler wants body streaming (bidi) for HTTP/2 or HTTP/3
            bool want_streaming = cx."header-info".body_streaming
                && handler
                && handler.wantsBodyStreaming(cx, hdr);

            *data body;
            if (cx."header-info".body_streaming && !want_streaming) {
                # Handler doesn't support streaming — buffer body on handler thread
                # for backward compatibility (body was previously read by I/O thread)
                #
                # Resume the h2/h3 poll operation on the I/O thread when this block exits
                # (normal flow, early return on error, or exception).  This ensures the
                # connection stays alive (PING, SETTINGS, WINDOW_UPDATE) while the handler
                # processes the request — critical for long-running handlers like bulk
                # object creation.  The controller also has a safety-net resume after
                # handler return to cover wantsBodyStreaming() handlers that skip this block.
                on_exit {
                    if (cx."header-info".resume_body_streaming) {
                        cx."header-info".resume_body_streaming();
                    }
                }
                int sid = cx."header-info".stream_id;
                binary body_data = binary();
                if (cx."header-info".http3) {
                    # HTTP/3: use QUIC stream data methods (CV-based; I/O thread stays active)
                    int session_id = cx."header-info".session_id;
                    try {
                        while (True) {
                            *binary chunk = s.readQuicStreamDataBlock(session_id, sid, 30s);
                            if (!chunk) {
                                break;
                            }
                            body_data += chunk;
                            # Incremental size check: reject early instead of buffering the full body
                            if (max_body > 0 && body_data.size() > max_body) {
                                break;
                            }
                        }
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err == "QUIC-STREAM-TIMEOUT") {
                            listener.logError("HTTP/3 request body read timeout from %s",
                                cx."peer-info".address_desc);
                            cx.close = True;
                            if (async_response_out) {
                                async_response_out = buildAsyncErrorResponse(408,
                                    "Request Timeout", cx, listener, s, !is_multiplexed);
                            } else {
                                sendHttpError(listener, cx, s, 408, "Request Timeout",
                                    NOTHING, NOTHING, cx."response-encoding",
                                    hdr.method == "HEAD");
                            }
                            return;
                        }
                        rethrow;
                    }
                    # NOTE: cleanupQuicStream is called by the controller's on_exit handler
                } else {
                    # HTTP/2: use H2 stream data methods
                    # Use readHttp2StreamDataBlock() return value as loop control:
                    # it returns data if available (even if stream is already complete),
                    # and NOTHING when no more data is available. This handles the case
                    # where DATA+END_STREAM arrived in the same batch as HEADERS.
                    while (True) {
                        *binary chunk = s.readHttp2StreamDataBlock(sid, 30s);
                        if (!chunk) {
                            break;
                        }
                        body_data += chunk;
                        # Incremental size check: reject early instead of buffering the full body
                        if (max_body > 0 && body_data.size() > max_body) {
                            break;
                        }
                    }
                    # readHttp2StreamDataBlock() returns NOTHING on both timeout and stream
                    # completion — check isHttp2StreamComplete() to distinguish.
                    # Only treat as timeout if we didn't exit due to max_body.
                    bool h2_complete = s.isHttp2StreamComplete(sid);
                    s.cleanupHttp2Stream(sid);
                    if (!h2_complete && !(max_body > 0 && body_data.size() > max_body)) {
                        listener.logError("HTTP/2 request body read timeout from %s",
                            cx."peer-info".address_desc);
                        cx.close = True;
                        if (async_response_out) {
                            async_response_out = buildAsyncErrorResponse(408,
                                "Request Timeout", cx, listener, s, !is_multiplexed);
                        } else {
                            sendHttpError(listener, cx, s, 408, "Request Timeout",
                                NOTHING, NOTHING, cx."response-encoding",
                                hdr.method == "HEAD");
                        }
                        return;
                    }
                }
                # Apply max body size check
                if (max_body > 0 && body_data.size() > max_body) {
                    string etxt = sprintf("%s request body size %d exceeds maximum allowed body size %d",
                        cx."header-info".http3 ? "HTTP/3" : "HTTP/2",
                        body_data.size(), max_body);
                    listener.logError("%s: from %s", etxt, cx."peer-info".address_desc);
                    cx.close = True;
                    if (async_response_out) {
                        async_response_out = buildAsyncErrorResponse(413, etxt, cx,
                            listener, s, !is_multiplexed);
                    } else {
                        sendHttpError(listener, cx, s, 413, etxt, NOTHING, NOTHING,
                            cx."response-encoding", hdr.method == "HEAD");
                    }
                    return;
                }
                if (body_data.size()) {
                    if (hdr."content-encoding" || hdr."content-type" == MimeTypeOctetStream
                            || hdr."content-type" =~ /^application\/connect\+/) {
                        body = body_data;
                    } else {
                        body = body_data.toString();
                    }
                }
            } else if ((cx."header-info".http2 || cx."header-info".http3) && cx."header-info".body) {
                # For HTTP/2 and HTTP/3, body is already read by poll operation and stored in header-info
                # Check body size against limit (body was already read by the C++
                # layer; this is a secondary check in case the C++ limit was not set)
                if (max_body > 0 && cx."header-info".body.size() > max_body) {
                    string etxt = sprintf("%s request body size %d exceeds maximum allowed body size %d",
                        cx."header-info".http3 ? "HTTP/3" : "HTTP/2",
                        cx."header-info".body.size(), max_body);
                    listener.logError("%s: from %s", etxt, cx."peer-info".address_desc);
                    cx.close = True;
                    sendHttpError(listener, cx, s, 413, etxt, NOTHING, NOTHING,
                        cx."response-encoding", hdr.method == "HEAD");
                    return;
                }
                if (want_streaming) {
                    # Save pre-read body for the stream handler; don't pass to REST handler
                    cx."stream-body" = cx."header-info".body;
                } else {
                    # HTTP/2 and HTTP/3 body is always binary - convert to string if text content type
                    if (hdr."content-encoding" || hdr."content-type" == MimeTypeOctetStream
                            || hdr."content-type" =~ /^application\/connect\+/) {
                        body = cx."header-info".body;
                    } else {
                        body = cx."header-info".body.toString();
                    }
                }
            } else if (hdr."content-length") {
                # Pre-read Content-Length check against max body size limit
                if (max_body > 0 && hdr."content-length" > max_body) {
                    string etxt = sprintf("Content-Length %d exceeds maximum allowed body size %d",
                        hdr."content-length", max_body);
                    listener.logError("%s: from %s", etxt, cx."peer-info".address_desc);
                    cx.close = True;
                    sendHttpError(listener, cx, s, 413, etxt, NOTHING, NOTHING,
                        cx."response-encoding", hdr.method == "HEAD");
                    return;
                }
                # HTTP/1.x: read body from socket
                try {
                    if (hdr."content-encoding" || hdr."content-type" == MimeTypeOctetStream) {
                        body = s.recvBinary(hdr."content-length", HttpServer::ReadTimeout);
                    } else {
                        body = s.recv(hdr."content-length", HttpServer::ReadTimeout);
                    }
                    #printf("HTTP DEBUG: %s\n", body);
                } catch (hash<ExceptionInfo> ex) {
                    string etxt = sprintf("error reading body in %s (Content-Length: %d): %s: %s", hdr.method,
                        hdr."content-length", ex.err, ex.desc);
                    string str = sprintf("%s: received from %s via %s (header: %y)", etxt,
                        cx."peer-info".address_desc, cx."socket-info".address_desc, hdr);
                    listener.logError("%s", str);
                    cx.close = True;
                    sendHttpError(listener, cx, s, 400, etxt, NOTHING, NOTHING, cx."response-encoding",
                        hdr.method == "HEAD");
                    return;
                }
            }

            # override assumed "iso-8859-1" character encoding if necessary
            if (body.typeCode() == NT_STRING && override_encoding && hdr."_qore_orig_content_type" !~ /charset=/) {
                body = force_encoding(body, override_encoding);
            }

            listener.doLogRecvBody(body, cx, hdr, info);

            hash<HttpResponseInfo> rv;

            #printf("HTTP DEBUG: B: handler: %y strict-bool-eval: %y\n", cx.handler_name, get_parse_options() & PO_STRICT_BOOLEAN_EVAL);
            #printf("HTTP DEBUG: B: handler: %y: context: %y, hdr: %y, body: %y\n", cx.handler_name, cx, hdr, body);
            #printf("HTTP DEBUG: BEFORE handler=%s", dbg_node_info(handlers.(cx.handler_name)));

            #printf("HTTP DEBUG: A: cid: %d handler: %y auth: %y\n", cx.id, cx.handler_name, boolean(handler.auth));

            if (!handler) {
                cx.handler_name = "error";
                rv = noHandlerError(cx, hdr, body);
            } else {
                # check for authentication info
                #printf("HTTP DEBUG: handler: %y (auth: %y) hdr: %y\n", cx.handler_name,
                #    exists handler.auth && handler.auth.requiresAuthentication(), hdr);

                # allow the handler to remove any authentication information in thread-local data, for example
                on_exit if (handler.auth) {
                    handler.auth.endRequest();
                }

                *hash<auto> tld_save = handler.saveThreadLocalData();
                on_exit handler.restoreThreadLocalData(tld_save);

                # preform any pre-processing on the request that can aid in authentication and has to be performed to
                # handle the request anyway
                *hash<HttpResponseInfo> ah;
                try {
                    ah = handler.preprocessRequest(listener, \hdr, \cx);
                } catch (hash<ExceptionInfo> ex) {
                    # log the error
                    string desc = sprintf("Handler %y preprocessing error from %s: ", cx.handler_name,
                        cx."peer-info".address_desc) + (
                            !debug
                                ? sprintf("%s: %s: %s", cx.handler_name, get_ex_pos(ex), ex.err, ex.desc)
                                : get_exception_string(ex)
                        );
                    listener.logError("%s", desc);
                    ah = <HttpResponseInfo>{
                        "code": 501,
                        "body": "Server Preprocessing Error",
                    };
                }

                if (!ah) {
                    try {
                        ah = handler.authenticateRequest(listener, hdr, \cx);
                    } catch (hash<ExceptionInfo> ex) {
                        # log the error
                        string desc = sprintf("Handler %y authentication error from %s: ", cx.handler_name,
                            cx."peer-info".address_desc) + (
                                !debug
                                    ? sprintf("%s: %s: %s", cx.handler_name, get_ex_pos(ex), ex.err, ex.desc)
                                    : get_exception_string(ex)
                            );
                        listener.logError("%s", desc);
                        ah = <HttpResponseInfo>{
                            "code": 501,
                            "body": "Server Authentication Error",
                        };
                    }
                }

                # return an error if authentication failed
                if (ah) {
                    if (!ah."code") {
                        ah."code" = 401;
                        cx.close = True;
                    } else if ((ah."code" / 100) >= 4) {
                        cx.close = True;
                    }
                    if (!ah.body.val() && !ah.hasKeyValue("chunked_body")) {
                        ah.body = "Authentication is required to access this server";
                    }
                    rv = ah;
                } else {
                    # decode body if applicable
                    if (body && hdr."content-encoding" && handler.decompress)
                        body = AbstractHttpRequestHandler::decodeBody(hdr."content-encoding", body,
                            handler.decompress_to_string ? s.getEncoding() : NOTHING);

                    hash<auto!> hrv = handler.handleRequest(listener, s, cx, hdr, body);
                    if (hrv.hasKey("raw_response")) {
                        delete hrv."raw_response";
                    }
                    rv = cast<hash<HttpResponseInfo>>(hrv);

                    # manage persistent handler info, if applicable
                    if (!phi.handler) {
                        if (handler.isPersistent()) {
                            phi.assign(dhh, handler);
                            if (!cx.persistent && !rv.close) {
                                cx.persistent = True;
                            }
                        }
                    } else if (!handler.isPersistent()) {
                        phi.clear();
                    } else if (!cx.persistent && !rv.close) {
                        cx.persistent = True;
                    }
                }
            }

            # Handle HTTP/2 bidirectional streaming: the handler managed the stream
            # lifecycle directly (read body data, sent response).  Mark as dedicated
            # so the controller leaves the stream alone.
            if (want_streaming && cx."response-sent") {
                request_helper.setDedicatedExternal();
                if (async_response_out) {
                    delete async_response_out;
                }
                return;
            }

            if (rv.reply_sent) {
                if (is_multiplexed && async_response_out) {
                    if (rv.streaming) {
                        # Streaming handler already sent response directly via protocol-specific
                        # APIs (e.g., HTTP/3 QUIC submitQuicResponseStreaming + submitQuicStreamData
                        # for SSE).  Signal the controller to acknowledge and continue.
                        async_response_out = <HttpAsyncResponseInfo>{
                            "streaming": True,
                            "stream_type": rv.stream_type,
                        };
                    } else {
                        # Async multiplexed mode: the handler claimed reply_sent but didn't actually
                        # send a response; generate a 500 error for the controller to send
                        string err = sprintf("handler %y set reply_sent without sending a response",
                            cx.handler_name);
                        logError("%s", err);
                        async_response_out = buildAsyncErrorResponse(500, err, cx, listener, s, False);
                    }
                } else if (!is_multiplexed && rv."code" >= 200) {
                    cx."response-sent" = True;
                }
                return;
            }

            sendReply(request_helper, listener, s, handler, rv, \cx, hdr, head, \async_response_out);
        } catch (hash<ExceptionInfo> ex) {
            string desc = !debug
                ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                : get_exception_string(ex);

            string str = sprintf("handler: %s: %s", cx.handler_name, desc);

            if (ex.err == "ENCODING-CONVERSION-ERROR") {
                s.setEncoding("utf8");
                cx."response-encoding" = "utf8";
            }

            cx.close = True;
            remove cx.persistent;

            # Clean up leaked persistent state when the handler became persistent
            # during a failed request.  handler.setPersistent() is called in
            # RestStreamRequest::constructor() BEFORE stream data is read, so if
            # stream I/O fails (e.g., HTTP2-STREAM-TIMEOUT), the handler is
            # persistent but phi.handler was never set (phi.assign() at line 2806
            # is after handler.handleRequest()).  Without this cleanup, the
            # SqlUtilPersistentDataHelper and its DB transaction leak in
            # thread-local data and are never rolled back.
            if (handler && handler.isPersistent() && !phi.handler) {
                phi.assign(dhh, handler);
                phi.clear();
            }

            # if there is a pending chunked body that has not yet been read on exit, then read it and discard before sending any response
            on_exit if (s.pendingHttpChunkedBody())
                s.readHTTPChunkedBodyBinary(HttpServer::ReadTimeout);

            int err_code = ex.err == "HTTP-BODY-TOO-LARGE" ? 413 : 500;
            if (async_response_out) {
                # Capture the error response for the async I/O controller to send
                # Sending synchronously from the handler thread races with the
                # I/O controller on multiplexed (HTTP/2, HTTP/3) connections
                async_response_out = buildAsyncErrorResponse(err_code, str, cx, listener, s, !is_multiplexed);
            } else {
                sendHttpError(listener, cx, s, err_code, str, NOTHING, NOTHING, cx."response-encoding", head);
            }
            logError("%s", str);
        }
    }
    #! @endcond

    # Builds an async error response for the controller to send
    # Builds an async error response to avoid synchronous sends that race with the I/O controller
    hash<HttpAsyncResponseInfo> buildAsyncErrorResponse(int status_code, string msg,
            hash<auto> cx, HttpListener listener, Socket s, bool close) {
        *string encoding = cx."response-encoding";
        if (!encoding) {
            encoding = s.getEncoding().lwr();
        }
        string err_body = acceptsHtml(cx) ? getHtmlErrorMessage(status_code, msg) : msg;
        hash<auto> err_hdr = getResponseHeaders(cx."listener-id") + {
            "Content-Type": MimeTypeHtml + ";charset=" + encoding,
            "Date": getDateHeader(),
        };
        return <HttpAsyncResponseInfo>{
            "code": status_code,
            "hdr": err_hdr,
            "body": err_body,
            "close": close,
            "cx": cx,
            "listener": listener,
        };
    }

    # sends a reply to a request
    # If async_response_out is provided, capture response info instead of sending
    private sendReply(RequestHelper request_helper, HttpListener listener, Socket s,
            *HttpServer::AbstractHttpRequestHandler handler, hash<auto> rv, reference<hash> cx, hash<auto> hdr,
            bool head, *reference<hash<HttpAsyncResponseInfo>> async_response_out) {
        listener.log("sendReply: code=%d async_response_out=%y http2=%y http3=%y",
            rv."code", exists async_response_out, cx."header-info".http2, cx."header-info".http3);
        if (exists rv.close)
            cx.close = boolean(rv.close);

        rv.close = cx.close;

        # if there is a pending chunked body that has not yet been read on exit, then read it and discard before sending any response
        on_exit if (s.pendingHttpChunkedBody())
            s.readHTTPChunkedBodyBinary(HttpServer::ReadTimeout);

        if (!HttpCodes{rv."code"}) { # if the handler returns an invalid hash
            string str = sprintf("%s handler returned an invalid response rv: %y", cx.handler_name, rv);
            cx.close = True;
            remove cx.persistent;

            sendHttpError(listener, cx, s, 500, str, NOTHING, NOTHING, cx."response-encoding", head);
            return;
        }

        #printf("HTTP DEBUG: handler %s returned: %n\n", cx.handler_name, rv);

        # currently enforced by the handlers:
        # RFC 2616 section 4.3: http://tools.ietf.org/html/rfc2616#section-4.3
        # All 1xx (informational), 204 (no content), and 304 (not modified) responses
        # MUST NOT include a message-body. All other responses do include a
        # message-body, although it MAY be of zero length.

        rv.hdr = getResponseHeaders(cx."listener-id") + rv.hdr;

        if ((exists rv.body || (bool chunked_body = rv.hasKeyValue("chunked_body")))
            && (head
                || (rv."code" < 200
                    || (rv."code" == 204
                    || rv."code" == 304)))) {
            remove rv.body;
            if (chunked_body) {
                remove rv.chunked_body;
            }
        }

        bool is_sse = False;
        if (rv.hdr."Content-Type") {
            string ct = rv.hdr."Content-Type".lwr();
            if (ct.startsWith(MimeTypeSse)) {
                is_sse = True;
            }
        }

        if (!head && rv."code" == 200 && hdr.method != "OPTIONS" && !rv.streaming && !is_sse
            && !rv.hasKey("chunked_body") && !(rv.body instanceof InputStream) && !rv.send_callback) {
            bool empty_body = !rv.hasKey("body");
            if (!empty_body) {
                int body_tc = rv.body.typeCode();
                if (body_tc == NT_NOTHING || body_tc == NT_NULL) {
                    empty_body = True;
                } else if ((body_tc == NT_STRING || body_tc == NT_BINARY) && rv.body.size() == 0) {
                    empty_body = True;
                }
            }
            if (empty_body) {
                rv."code" = 204;
                remove rv.body;
            }
        }

        rv.hdr.Date = getDateHeader();

        HttpServer::http_set_reply_headers(s, cx, \rv);

        # Detect HTTP/2 or HTTP/3 extended CONNECT (RFC 8441 / RFC 9220)
        bool ext_connect = is_extended_connect(cx, hdr);

        if (rv."code" >= 300 && rv."code" < 400) {
            # handle redirect msgs (RFC 2616 section 10.3 http://tools.ietf.org/html/rfc2616#section-10.3)
            doResponse(listener, s, cx, rv, \async_response_out);
        } else if (rv."code" >= 400) {
            if (!head && !rv.body && !rv.hasKeyValue("chunked_body")) {
                rv.body = sprintf("unknown error in %s handler", cx.handler_name);
            }
            if (async_response_out) {
                # Capture the error response for the async I/O controller to send
                # through h2op (HTTP/2) or sendHTTPResponse (HTTP/1.x), rather than
                # sending directly on the socket which would bypass the poll operation
                # state machine and corrupt the connection lifecycle
                doResponse(listener, s, cx, rv, \async_response_out);
            } else {
                sendHttpError(listener, cx, s, rv."code", rv.body,
                    rv.hasKey("chunked_body") ? rv.chunked_body : NOTHING,
                    rv.hdr, cx."response-encoding", head);
                cx."response-sent" = True;
            }
            remove cx.persistent;
        } else {
            #printf("**** RESPONSE: %d ct: %s (te: %y) encoding: %y: %Y\n", rv."code", rv.hdr."Content-Type",
            #    rv.hdr."Transfer-Encoding", cx.encoding, rv.body);

            # compress body if eligible for compression; skip InputStream bodies (streaming),
            # send_callback responses, and handlers that manage their own content encoding
            if (rv.body && !(rv.body instanceof InputStream) && !rv.send_callback
                && !rv.no_content_encoding && !rv.hdr."Content-Encoding"
                && rv.body.size() > CompressionThreshold) {
                int orig_size = rv.body.size();
                if (cx.encoding == "br") {
                    rv.hdr."Content-Encoding" = "br";
                    rv.body = brotli(rv.body);
                } else if (cx.encoding == "zstd") {
                    rv.hdr."Content-Encoding" = "zstd";
                    rv.body = zstd(rv.body);
                } else if (cx.encoding == "deflate") {
                    rv.hdr."Content-Encoding" = "deflate";
                    rv.body = compress(rv.body);
                } else if (cx.encoding == "gzip") {
                    rv.hdr."Content-Encoding" = "gzip";
                    rv.body = gzip(rv.body);
                } else if (cx.encoding == "bzip2") {
                    rv.hdr."Content-Encoding" = "bzip2";
                    rv.body = bzip2(rv.body);
                }
                if (rv.hdr."Content-Encoding") {
                    listener.log("cid %d: %s compressed %s: %d -> %d bytes (type: %s)", cx.id,
                        cx."header-info".http3 ? "HTTP/3" : cx."header-info".http2 ? "HTTP/2" : "HTTP/1.x",
                        rv.hdr."Content-Encoding", orig_size, rv.body.size(), rv.body.type());
                }
            }

            if ((rv.body instanceof InputStream || rv.send_callback || rv.body.val()
                || rv.chunked_body.val()) && !rv.hdr."Content-Type") {
                rv.hdr."Content-Type" = MimeTypeHtml + ";charset=" + (cx."response-encoding"
                    ?? s.getEncoding().lwr());
            }

            # For HTTP/2 and HTTP/3 extended CONNECT streaming, don't send response here -
            # it's handled in the dedicated socket section
            if (!rv.streaming || !ext_connect) {
                doResponse(listener, s, cx, rv, \async_response_out);
            }
        }

        if (rv.log)
            listener.log("cid %d: %s (from %s): %s", cx.id, cx.handler_name, cx."peer-info".address_desc, rv.log);
        if (rv.errlog)
            listener.logError("cid %d: %s (from %s): %s", cx.id, cx.handler_name, cx."peer-info".address_desc,
                rv.errlog);

        if (!rv.close && rv.user_state) {
            cx.user_state += rv.user_state;
        }

        # Check for dedicated socket handlers: HTTP/1.1 WebSocket (101), SSE,
        # HTTP/2 extended CONNECT (200 + streaming), or HTTP/3 extended CONNECT (200 + streaming)
        bool is_http3 = ext_connect && (cx."header-info".http3 ?? False);
        if (rv.streaming && ext_connect) {
            string proto_label = is_http3 ? "HTTP/3" : "HTTP/2";
            string sock_id = sprintf("%y:%d", cx.id, cx."header-info".stream_id);
            if (rv.close) {
                listener.logError("cid %d: %s extended CONNECT returned from handler %y, but the close "
                    "flag is set", cx.id, proto_label, cx.handler_name);
            } else if (!(handler instanceof HttpServer::AbstractHttpSocketHandlerInterface)) {
                listener.logError("cid %d: %s extended CONNECT returned from handler %y, but the handler "
                    "does not inherit AbstractHttpSocketHandlerInterface (class: %y)", cx.id, proto_label,
                    cx.handler_name, handler.className());
                self.sendHttpError(listener, cx, s, 501,
                    "extended CONNECT handler must inherit AbstractHttpSocketHandlerInterface",
                    NOTHING, NOTHING, cx."response-encoding", False);
                return;
            } else {
                AbstractHttpSocketHandlerInterface sockhandler
                    = cast<HttpServer::AbstractHttpSocketHandlerInterface>(handler);
                if (listener.registerDedicatedSocket(request_helper, sock_id, sockhandler)) {
                    try {
                        int stream_id = cx."header-info".stream_id;
                        hash<auto> resp_hdr = rv.hdr ?? {};

                        if (is_http3) {
                            # HTTP/3 (RFC 9220): submit CONNECT response via QUIC session
                            int session_id = cx."header-info".session_id;
                            s.submitQuicConnectResponse(session_id, stream_id,
                                rv."code" ?? 200, resp_hdr);
                            *AsyncSocketIo::AsyncSocketIoController ctrl = cx.async_ctrl;
                            if (ctrl) {
                                ctrl.wakeSocket(s);
                            }
                        } else {
                            # HTTP/2 multiplexed mode: submit CONNECT response directly
                            # to the nghttp2 session.  h2op on the I/O thread will flush it.
                            s.submitHttp2ConnectResponse(stream_id, rv."code" ?? 200, resp_hdr);
                            # Wake the I/O controller so h2op's continuePoll() flushes
                            # the pending CONNECT response
                            *AsyncSocketIo::AsyncSocketIoController ctrl = cx.async_ctrl;
                            if (ctrl) {
                                ctrl.wakeSocket(s);
                            }
                        }

                        hash<auto> sock_cx = cx + {"listener": listener, "id": sock_id};
                        if (sockhandler.start(listener.getID(), sock_cx, hdr, s)) {
                            request_helper.setDedicatedExternal();
                        }
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err == "SOCKET-NOT-OPEN") {
                            listener.logError("cid %d: %s extended CONNECT handler %y: socket closed by "
                                "remote", cx.id, proto_label, cx.handler_name);
                        } else {
                            string desc = !debug
                                ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                                : get_exception_string(ex);
                            listener.logError("cid %d: error in %s extended CONNECT handler %y: %s",
                                cx.id, proto_label, cx.handler_name, desc);
                        }
                    }
                    if (request_helper.isDedicatedExternal()) {
                        listener.log("cid %d: %s extended CONNECT handler %y managed externally",
                            cx.id, proto_label, cx.handler_name);
                    } else {
                        listener.removeDedicatedSocket(sock_id);
                        listener.log("cid %d: stopped %s extended CONNECT handler: %y",
                            cx.id, proto_label, cx.handler_name);
                    }
                } else {
                    listener.logError("cid %d: cannot start %s extended CONNECT handler %y because the "
                        "listener is shutting down", cx.id, proto_label, cx.handler_name);
                }
            }
            return;
        }
        if (rv.hdr."Content-Type" == MimeTypeSse) {
            # SSE response — set up async SSE connection via the I/O controller
            if (rv.close) {
                listener.logError("cid %d: SSE response returned from handler %y, but the connection "
                    "close flag is set", cx.id, cx.handler_name);
            } else if (!(handler instanceof HttpServer::AbstractHttpSocketHandlerInterface)) {
                listener.logError("cid %d: SSE response returned from handler %y, but the handler does "
                    "not inherit AbstractHttpSocketHandlerInterface (class: %y)", cx.id, cx.handler_name,
                    handler.className());
            } else if (async_response_out) {
                # Use call_object_method since HttpServer doesn't require ServerSentEventHandler
                try {
                    HttpServerAsyncIo::HttpSseStreamPollOperation poll_op =
                        call_object_method(handler, "setupAsyncSseConnection", s, cx, hdr,
                            string(cx.id));
                    # Tell the async controller to manage this socket as an SSE stream
                    async_response_out.code = rv."code";
                    async_response_out.hdr = rv.hdr;
                    async_response_out.streaming = True;
                    async_response_out.stream_type =
                        HttpServerAsyncIo::HttpConnectionState::Sse;
                    async_response_out.stream_operation = poll_op;
                } catch (hash<ExceptionInfo> ex) {
                    listener.logError("cid %d: error setting up async SSE connection for handler %y: %s: %s",
                        cx.id, cx.handler_name, ex.err, ex.desc);
                }
            }
        } else if (rv."code" == 101) {
            # WebSocket upgrade — use async I/O controller
            if (rv.close) {
                listener.logError("cid %d: 101 Switching Protocols returned from handler %y, but the connection "
                    "close flag is set", cx.id, cx.handler_name);
            } else if (!(handler instanceof HttpServer::AbstractHttpSocketHandlerInterface)) {
                listener.logError("cid %d: 101 Switching Protocols returned from handler %y, but the handler does "
                    "not inherit AbstractHttpSocketHandlerInterface (class: %y)", cx.id, cx.handler_name,
                    handler.className());
            } else {
                if (listener.registerDedicatedSocket(request_helper, cx.id, handler)) {
                    on_exit {
                        cx.close = True;
                        listener.removeDedicatedSocket(cx.id);
                        listener.log("cid %d: stopped dedicated socket handler: %y", cx.id, cx.handler_name);
                    }
                    AbstractHttpSocketHandlerInterface sockhandler = cast<HttpServer::AbstractHttpSocketHandlerInterface>(handler);

                    if (async_response_out) {
                        s.sendHTTPResponse(async_response_out."code",
                            HttpServer::HttpCodes{async_response_out."code"}, "1.1",
                            async_response_out.hdr ?? {}, async_response_out.body);
                        delete async_response_out;
                    }

                    # Create WebSocket poll operation (submitted by startImpl after
                    # setConnection/registered, ensuring echo mode is set before any
                    # frames arrive on the I/O thread)
                    *HttpServerAsyncIo::HttpWebSocketPollOperation ws_poll_op;
                    if (asyncIo) {
                        ws_poll_op = new HttpServerAsyncIo::HttpWebSocketPollOperation(s);
                    }
                    on_exit {
                        if (ws_poll_op) {
                            asyncIo.deregisterH1WebSocketConnection(s);
                        }
                    }

                    # Pass poll_op and async I/O context to handler via header-info
                    hash<auto> ws_cx = cx + {"listener": listener};
                    if (ws_poll_op) {
                        ws_cx."header-info".ws_poll_op = ws_poll_op;
                        ws_cx."header-info".async_io_controller = asyncIo;
                        ws_cx."header-info".async_target = asyncTarget;
                    }

                    try {
                        sockhandler.start(listener.getID(), ws_cx, hdr, s);
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err == "SOCKET-NOT-OPEN") {
                            listener.logError("cid %d: dedicated socket handler %y: socket closed by remote", cx.id,
                                cx.handler_name);
                        } else {
                            string desc = !debug
                                ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                                : get_exception_string(ex);
                            listener.logError("cid %d: error in dedicated socket handler %y: %s", cx.id,
                                cx.handler_name, desc);
                        }
                    }
                } else {
                    listener.logError("cid %d: cannot start dedicated socket handler %y because the listener is "
                        "shutting down", cx.id, cx.handler_name);
                }
            }
        }
    }

    #! Executes an async poll operation using the global async I/O controller
    /** @par Internal Method
        This method is for internal use only and should not be called directly by user code.

        This method sends a response via the shared AsyncSocketIoController for efficient
        I/O multiplexing. It blocks until the response is fully sent, but the underlying I/O is
        handled asynchronously by the controller's I/O thread.

        Used for both HTTP/2 and HTTP/3 (QUIC) poll operations.

        @param s the socket to send on
        @param op the poll operation to execute

        @throw any exception raised during the I/O operation
    */
    execAsyncPollOperation(Socket s, AbstractPollOperation op) {
        # Wrap the operation with a DelegatingPollOperation that signals a Counter
        # when complete.  The handler thread waits on the Counter — this has no
        # dependency on the I/O thread's ability to process commands (only on it
        # completing the poll operation), eliminating deadlock risk.
        Counter done(1);
        *hash<auto> op_ex;
        auto wrapped_op = new DelegatingPollOperation(op,
            sub (hash<SocketPollResultInfo> result) {
                if (result.ex) {
                    op_ex = result.ex;
                }
                done.dec();
            });
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        ctrl.submit(<SocketPollOperationInfo>{
            "sock": s,
            "spop": wrapped_op,
            "to": 30s,
            "owner": self.uniqueHash(),
        });
        done.waitForZero();
        if (op_ex) {
            throw op_ex.err, op_ex.desc, op_ex.arg;
        }
    }

    # rv is "hash" to strip types
    # If async_response_out is provided, capture response info instead of sending
    # Assumes stream yields homogeneous chunk types (string or binary) per read loop.
    private:internal data readAllStream(InputStream is, *int chunk_size) {
        int size = chunk_size ?? 8192;
        *string sout;
        *binary bout;
        while (True) {
            *data chunk = is.read(size);
            if (!chunk || !chunk.size()) {
                break;
            }
            if (chunk.typeCode() == NT_STRING) {
                if (sout) {
                    sout += chunk;
                } else {
                    sout = chunk;
                }
            } else {
                binary b = binary(chunk);
                if (bout) {
                    bout += b;
                } else {
                    bout = b;
                }
            }
        }
        return sout ? sout : (bout ? bout : "");
    }

    private:internal doResponse(HttpListener listener, Socket s, hash<auto> cx, hash rv,
            *reference<hash<HttpAsyncResponseInfo>> async_response_out) {
        # Handle send_callback responses (e.g. DataStream protocol)
        if (rv.send_callback) {
            if (cx."header-info".http2) {
                # HTTP/2: wrap send_callback in a CallbackInputStream and send via HTTP/2
                # DATA frames; this handles Connect protocol streaming correctly
                hash<auto> hdr = rv.hdr ?? {};
                remove hdr."Transfer-Encoding";
                # Create a dummy owner object to prevent premature GC of the callback
                auto cb = rv.send_callback;
                InputStream is = new CallbackInputStream(
                    auto sub() { return cb(); }, cx.socketobject);
                is.unassignThread();
                async_response_out = <HttpAsyncResponseInfo>{
                    "code": rv."code",
                    "hdr": hdr,
                    "input_stream": is,
                    "close": cx.close ?? False,
                    "cx": cx,
                    "listener": listener,
                };
                listener.logResponse(cx, rv);
                return;
            }
            # Capture callback for the response-sending code
            async_response_out = <HttpAsyncResponseInfo>{
                "code": rv."code",
                "hdr": rv.hdr ?? {},
                "send_callback": rv.send_callback,
                "send_timeout": rv.send_timeout,
                "close": cx.close ?? False,
                "cx": cx,
                "listener": listener,
            };
            listener.logResponse(cx, rv);
            return;
        }

        # RFC 9113 §8.2.2 / RFC 9114 §4.2: Transfer-Encoding is prohibited in HTTP/2 and HTTP/3;
        # strip it before the chunked check to prevent the body from being needlessly converted
        # to a BinaryInputStream (which would trigger the streaming response path)
        if (cx."header-info".http2 || cx."header-info".http3) {
            remove rv.hdr."Transfer-Encoding";
            remove rv.hdr."transfer-encoding";
        }

        bool chunked = rv.chunked_body || (rv.body && (rv.hdr."Transfer-Encoding"
            || (rv.body instanceof InputStream && !rv.hdr."Content-Length")));
        auto body = rv.body;

        if (chunked) {
            body = rv.chunked_body ?? rv.body;
            if (body instanceof StringInputStream) {
                StringInputStream input_stream = cast<StringInputStream>(body);
                if ((string stream_encoding = input_stream.getEncoding()) != s.getEncoding()) {
                    body = new EncodingConversionInputStream(input_stream, stream_encoding, s.getEncoding());
                }
            } else if ((body instanceof string) || (body instanceof binary)) {
                body = new BinaryInputStream(body);
            }
            rv.hdr."Transfer-Encoding" = "chunked";
        }

        # Capture response info for async sending
        # Preserve InputStream so the controller can send it
        # with proper chunked framing; the controller handles thread reassignment
        *InputStream is;
        if (body instanceof InputStream) {
            is = body;
            # Unassign thread affinity while still on the handler thread
            # so the I/O controller thread can access it later
            is.unassignThread();
            body = NOTHING;
        }
        listener.log("doResponse: capturing async response code=%d body_size=%d has_stream=%y",
            rv."code", body ? body.size() : 0, exists is);
        async_response_out = <HttpAsyncResponseInfo>{
            "code": rv."code",
            "hdr": rv.hdr ?? {},
            "body": body,
            "input_stream": is,
            "chunked": chunked,
            "close": cx.close ?? False,
            "cx": cx,
            "listener": listener,
        };
        listener.logResponse(cx, rv);
    }
    #! @endcond
}

class HttpPersistentHandlerInfo {
    public {
        *DynamicHandlerHelper dhh;
        *HttpServer::AbstractHttpRequestHandler handler;
    }

    destructor() {
        try {
            clear();
        } catch (hash<ExceptionInfo> ex) {
            # ignore PROGRAM-ERROR exceptions in the destructor
            if (ex.err != "PROGRAM-ERROR") {
                rethrow;
            }
        }
    }

    assign(*DynamicHandlerHelper n_dhh, HttpServer::AbstractHttpRequestHandler n_handler) {
        dhh = n_dhh;
        handler = n_handler;
    }

    clear() {
        if (handler) {
            if (handler.isPersistent()) {
                handler.persistentClosed();
                # Clear the per-thread persistence state so that subsequent
                # requests on this thread do not appear persistent on the
                # handler.  persistentClosed() calls the notification callback
                # but does not clear _persistent_threads, which would cause
                # the next request on this thread to incorrectly opt into
                # persistence.
                handler.clearPersistentThread();
            }
            remove handler;
            remove dhh;
        }
    }
}

#! Implements listeners for the @ref HttpServer::HttpServer "HttpServer" class
public class HttpListener inherits Qore::Socket, HttpServer::HttpListenerInterface {
    public {
        # TID of the background listener thread
        int tid;

        # default handler info
        *HandlerInfo defaultHandler;
    }

    private {
        HttpServer serv;
        #! private request-handling method from the server
        code<nothing(...)> handleRequest;
        Sequence ss;

        *hash<HttpListenerOptionInfo> opts;

        #*SSLCertificate cert;
        #*SSLPrivateKey key;
        bool ssl = False;
        auto socket;
        hash socket_info;

        # connection WaitGroup for normal connection threads
        WaitGroup cThreads();
        # connection WaitGroup for dedicated socket threads
        WaitGroup dThreads();

        bool exit = False;
        bool stopped = False;
        int id;

        # socket handler hash
        hash<string, AbstractHttpSocketHandlerInterface> shh;

        # mutex
        Mutex m();

        #! listener-specific logger; if not present, then the server's logger will be used
        *LoggerInterface logger;

        # stop notification closure
        *code stopc;

        string name;

        # log recv headers flag
        bool log_recv_headers = False;

        # log recv body flag
        bool log_recv_body = False;

        # log send headers flag
        bool log_send_headers = False;

        # log send body flag
        bool log_send_body = False;

        #! get remote certificates
        bool get_remote_certs = False;

        #! SSL verify flags
        int ssl_verify_flags = SSL_VERIFY_NONE;

        #! accept all certificates
        bool ssl_accept_all_certs = True;

        #! thread waiting on lock
        int lock_waiting;


        const PollInterval = 250ms;
        const ListenQueue = 1024;
        const BodyLogLimit = 40;

        # handler ref count
        int handler_ref_cnt = 0;

        # listener-specific handlers
        HttpHandlerList handlers();

        #! map for converting ssl verify flags to strings
        const SslVerifyMap = {
            SSL_VERIFY_PEER: "SSL_VERIFY_PEER",
            SSL_VERIFY_FAIL_IF_NO_PEER_CERT: "SSL_VERIFY_FAIL_IF_NO_PEER_CERT",
            SSL_VERIFY_CLIENT_ONCE: "SSL_VERIFY_CLIENT_ONCE",
        };
    }

    #! Creates the object with the given parameters
    /**
        @param server the HTTP server
        @param handleRequest the server's request handling code reference
        @param id the listener ID
        @param ss the listener connection sequence
        @param opts listener options
    */
    constructor(HttpServer server, code<nothing(...)> handleRequest,int id, Sequence ss,
            *hash<HttpListenerOptionInfo> opts) {
        if (!opts.name.val()) {
            throw "HTTPLISTENER-CONSTRUCTOR-ERROR", "Missing required listener option: name";
        }
        self.name = opts.name;
        self.handleRequest = handleRequest;
        if (opts.cert_loc && !opts.cert) {
            opts += http_get_ssl_objects(opts.cert_loc, opts.key_loc, opts.key_password);
        }
        self.opts = opts;

        # we originally set for utf-8 and then per-connection the encoding is set according to the client's
        # content-type header (with iso-8859-1 as the default)
        # according to RFC 2616 section 3.7.1 (http://tools.ietf.org/html/rfc2616#section-3.7.1)
        setEncoding("utf-8");

        # save a weak reference to the server object
        serv := server;

        # set other params
        self.id = id;
        self.ss = ss;
        self.logger = opts.logger;
        self.stopc = opts.stopc;

        if (opts.handler_info) {
            addHandlers(opts.handler_info);
        }

        # create SSL certificate and private key objects from PEM files if passed
        # Don't configure SSL on the listener socket because async I/O uses
        # startPollAccept() which doesn't properly handle client certificate
        # verification. Instead, each accepted connection is manually upgraded to SSL.
        if (opts.cert) {
            if (opts.get_remote_certs) {
                # issue #3512: enable remote certificates to be retrieved by default for HTTPS listeners
                # get certificates from peers
                ssl_verify_flags = opts.ssl_verify_flags |= SSL_VERIFY_PEER;
                get_remote_certs = True;
            }
            if (opts.ssl_verify_flags) {
                ssl_verify_flags = opts.ssl_verify_flags;
            }
            if (exists opts.ssl_accept_all_certs) {
                ssl_accept_all_certs = opts.ssl_accept_all_certs;
            }
            ssl = True;
        }

        if (opts.no_bind) {
            # QUIC listener mode: skip bind/listen (network I/O uses a separate UDP socket)
            socket = opts.name;
            socket_info = {
                "ssl": True,
                "name": name,
                "id": id,
            } + opts.ext_info;
            socket_info.desc = name;
        } else {
            # make INET (tcp) bind
            if (exists opts.service) {
                bindINET(opts.node, opts.service, True, opts.family);
                socket = sprintf("%s:%s", opts.node ?? "*", opts.service);
            } else {
                socket = opts.node;
                if (opts.node =~ /^\//) {
                    # try to unlink the file first if it's a UNIX domain socket
                    unlink(opts.node);
                    bindUNIX(opts.node);
                } else {
                    if (bind(opts.node, True)) {
                        throw "HTTPLISTENER-BIND-ERROR", strerror();
                    }
                }
            }

            # save socket port/path
            socket_info = getSocketInfo() + {
                "ssl": ssl,
                "name": name,
                "id": id,
            } + opts.ext_info;

            # make 'desc' key for logging
            socket_info.desc = socket_info.address_desc;
            if (socket_info.port) {
                socket_info.desc += ":" + socket_info.port;
            }

            # set listening state on socket
            if (listen(ListenQueue)) {
                throw "HTTP-LISTEN-ERROR", sprintf("listen error %d on socket %s: %s", errno(), socket, strerror());
            }
        }

    }

    #! Returns a hash of extra headers to be added to all responses from this listener
    *hash<auto> getDefaultResponseHeaders() {
        return serv.getDefaultResponseHeaders();
    }

    #! Reloads the HTTPS certificate from the original location
    /** Subsequent connections will use the new certificate definition; the listener must have been started with the
        location information for the X.509 certificate and private key, or a REFRESH-CERTIFICATE error is raised

        @throw REFRESH-CERTIFICATE-ERROR not an HTTPS listener or certificate location information not present

        @since HttpServer 1.1
    */
    reloadCertificate() {
        if (!ssl) {
            throw "REFRESH-CERTIFICATE-ERROR", sprintf("listener %y (id %d) is not an HTTPS listener", name, id);
        }
        if (!opts.cert_loc) {
            throw "REFRESH-CERTIFICATE-ERROR", sprintf("listener %y (id %d) cannot reload the certificate from the "
                "source location as no source location was provided for the current certificate; the certificate was "
                "provided in binary format when the listener was started; in order to reload certificates at "
                "runtime, make sure to use APIs that provide the certificate location when starting the listener",
                name, id);
        }

        on_error rethrow "REFRESH-CERTIFICATE-ERROR", sprintf("%s: %s", $1.err, $1.desc);
        hash<HttpCertInfo> info = http_get_ssl_objects(opts.cert_loc, opts.key_loc, opts.key_password);
        # signal to connection thread that it should allow the lock to be acquired by this thread
        ++lock_waiting;
        on_exit --lock_waiting;
        setCertificateAndPrivateKey(info.cert, info.key);
    }

    #! add handlers to the listener
    addHandlers(hash<string, hash<HttpHandlerConfigInfo>> handler_info) {
        AutoLock al(m);
        #printf("HttpListener::addHandlers() hi: %y\n", hi);
        bool def = handlers.empty();
        map handlers.setHandler($1.key, $1.value), handler_info.pairIterator();
        map ++handler_ref_cnt, handler_info.iterator();
        if (def) {
            setDefaultHandler(handler_info.firstKey());
        }
    }

    /** Remove handler from the listener.
        @throw INVALID-HANDLER-ERROR handler is not present in the listener's handler list
    */
    removeHandler(string handler_name) {
        AutoLock al(m);
        --handler_ref_cnt;

        if (defaultHandler && defaultHandler.name == handler_name) {
            remove defaultHandler;
        }
        handlers.removeHandler(handler_name);
    }

    /** Remove handler from the listener.
        @throw INVALID-HANDLER-ERROR handler is not present in the listener's handler list
    */
    removeHandler(HttpServer::AbstractHttpRequestHandler handler) {
        AutoLock al(m);
        --handler_ref_cnt;

        if (defaultHandler && defaultHandler.obj == handler) {
            remove defaultHandler;
        }
        handlers.removeHandler(handler);
    }

    setDefaultHandler(string name) {
        if (!handlers.handlers{name})
            throw "HTTPLISTENER-SETDEFAULTHANDLER-ERROR", sprintf("handler %y is unknown (known handlers: %y)", name,
                handlers.handlers.keys());

        defaultHandler = handlers.handlers{name};
    }

    *HandlerInfo findHandler(hash<auto> hdr, reference<int> score, bool finalv = False, *reference<string> root_path) {
        return handlers.findHandler(hdr, \score, finalv, root_path ? \root_path : NOTHING);
    }

    bool hasHandlers() {
        return !handlers.empty();
    }

    #! Returns the handler for inline check (no side effects)
    /** Looks up the handler for the given request headers without creating
        DynamicHandlerHelper objects or modifying any state.

        @param hdr parsed HTTP headers
        @return the handler if found, NOTHING otherwise

        @note Only returns permanent (non-dynamic) handlers. Dynamic handlers
        require lifecycle tracking that is incompatible with the inline path.

        @since HttpServer 1.6
    */
    *AbstractHttpRequestHandler findHandlerForInlineCheck(hash<auto> hdr) {
        int score = 0;
        string root_path;
        *HandlerInfo hi;
        if (hasHandlers()) {
            hi = findHandler(hdr, \score, True, \root_path);
            if (!hi) {
                hi = defaultHandler;
            }
        } else {
            hi = serv.findGlobalHandler(hdr);
        }
        if (hi) {
            return hi.obj;
        }
        return NOTHING;
    }

    #! Lightweight inline request processing — no context setup, logging, auth
    /** This method processes a request inline in the I/O thread, bypassing
        the full processNativeRequest() path. It is only called when the handler's
        canHandleInline() returns True.

        @param sock the client socket
        @param cx the connection context (peer info only)
        @param hdr parsed HTTP headers
        @param handler the handler to use
        @param header_info header parsing info including the \c close flag for connection semantics

        @return result info for the controller to act on

        @since HttpServer 1.6
    */
    hash<HttpServerAsyncIo::HttpRequestResultInfo> processInlineRequest(Socket sock, hash<auto> cx,
            hash<auto> hdr, AbstractHttpRequestHandler handler, hash<auto> header_info) {
        try {
            hash<HttpResponseInfo> resp = handler.handleInlineRequest(cx, hdr, NOTHING);
            bool req_close = header_info.close.toBool();
            return <HttpServerAsyncIo::HttpRequestResultInfo>{
                "code": resp.code,
                "status_message": HttpCodes{resp.code},
                "hdr": resp.hdr,
                "body": resp.body,
                "close": resp.close ?? req_close ?? !sock.isOpen(),
                "return_to_idle": !resp.close && !req_close && sock.isOpen(),
                "ttl": serv.getTtl(),
            };
        } catch (hash<ExceptionInfo> ex) {
            return <HttpServerAsyncIo::HttpRequestResultInfo>{"close": True};
        }
    }

    #! stop listeners if there are no handlers
    /** @param listener listener to stop
        @return whether listener was stopped
    */
    static bool stopIfNoHandlers(HttpServer::HttpListener listener) {
        listener.m.lock();
        on_error listener.m.unlock();

        if (listener.handler_ref_cnt == 0) {
            listener.m.unlock();
            listener.stop();
            return True;
        }
        listener.m.unlock();
        return False;
    }

    hash getListenerSocketInfo() {
        return socket_info;
    }

    copy() {
        throw "COPY-ERROR", "this object cannot be copied";
    }

    destructor() {
        stop();
    }

    logRecvHeaders(softbool flag = True) {
        log_recv_headers = flag;
    }

    logRecvBody(softbool flag = True) {
        log_recv_body = flag;
    }

    logSendHeaders(softbool flag = True) {
        log_send_headers = flag;
    }

    logSendBody(softbool flag = True) {
        log_send_body = flag;
    }

    doLogRecvBody(*data body, hash<auto> cx, hash<auto> hdr, hash<auto> info) {
        if (body) {
            string http_ver = hdr.http_version =~ /^HTTP\// ? hdr.http_version : "HTTP/" + hdr.http_version;
            string lstr = sprintf("cid %d src %y: %s %s %s body (%db): ", cx.id, cx."peer-info".address_desc,
                hdr.method, cx.masked_path, http_ver, body.size());
            if (body.typeCode() == NT_STRING) {
                try {
                    string bstr = body.size() > BodyLogLimit ? body.substr(0, BodyLogLimit) + "..." : body;
                    # attempt to mask sensitive data in the message body
                    bstr = serv.maskData(bstr);
                    bstr = replace(bstr, "\n", "\\n");
                    bstr = replace(bstr, "\r", "\\r");
                    bstr = replace(bstr, "\t", "\\t");
                    lstr += sprintf("'%s'", bstr);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "INVALID-ENCODING") {
                        lstr += sprintf("error logging msg body: %s: %s", ex.err, ex.desc);
                        string etxt = serv.getDebug()
                            ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                            : get_exception_string(ex);
                        string str = sprintf("%s: received from %s via %s", etxt, info.address_desc,
                            socket_info.address_desc);
                        logError("%s", str);
                        logError("hdr=%y", hdr);
                    }
                }
            } else {
                lstr += "<bin>";
            }
            log("%s", lstr);
        }

        if (log_recv_body) {
            if (body && (hdr."content-type" == MimeTypeOctetStream || hdr."content-encoding")) {
                log("cid %d: RECV BODY: <%s>", cx.id, body.toHex());
            } else {
                log("cid %d: RECV BODY: %y", cx.id, body);
            }
        }
    }

    hash<auto> getLogOptions() {
        return {
            "recv_headers": log_recv_headers,
            "recv_body": log_recv_body,
            "send_headers": log_send_headers,
            "send_body": log_send_body,
        };
    }

    string getName() {
        return name;
    }

    auto getAddress() {
        return socket;
    }

    int getID() {
        return id;
    }

    bool isSecure() {
        return ssl;
    }

    #! Returns the effective maximum request body size for this listener
    /** Returns the listener-specific limit if set, otherwise the server-level default.

        @return the maximum body size in bytes; 0 means unlimited

        @since HttpServer 1.6
    */
    int getMaxRequestBodySize() {
        int rv = opts.max_request_body_size ?? 0;
        if (!rv) {
            rv = serv.getMaxRequestBodySize();
        }
        return rv;
    }

    #! Returns the SSL certificate object if configured
    /** @return the SSL certificate or NOTHING if not an SSL listener
    */
    *SSLCertificate getSslCertificate() {
        return opts.cert;
    }

    #! Returns the SSL private key object if configured
    /** @return the SSL private key or NOTHING if not an SSL listener
    */
    *SSLPrivateKey getSslPrivateKey() {
        return opts.key;
    }

    hash<auto> getInfo() {
        return {
            "name": name,
         } + socket_info + {
            "proto": ssl ? "https" : "http",
            "id": id,
            "bind": socket,
            "get_remote_certs": get_remote_certs,
            "ssl_verify_flags": getSslVerifyModeList(),
            "ssl_accept_all_certs": ssl_accept_all_certs,
         };
    }

    private setupSslIntern() {
        if (!opts.key) {
            throw "HTTP-ADDLISTENER-ERROR", sprintf("SSL certificate given without private key for listener %y",
                name);
        }
        # set SSL cert and key
        setCertificate(opts.cert);
        setPrivateKey(opts.key);
    }

    private softlist<string> getSslVerifyModeList() {
        return (map $1.value, SslVerifyMap.pairIterator(), ssl_verify_flags & $1.key.toInt()) ?* "SSL_VERIFY_NONE";
    }

    #! Returns the SSL verify flags
    /** @return the SSL verification flags (e.g. SSL_VERIFY_PEER)

        @since HttpServer 1.5
    */
    int getSslVerifyFlags() {
        return ssl_verify_flags;
    }

    #! Returns the SSL certificate object
    /** @return the SSL certificate object, or NOTHING if not configured

        @since HttpServer 1.5
    */
    *SSLCertificate getSslCertificateObject() {
        return opts.cert;
    }

    #! Returns the SSL private key object
    /** @return the SSL private key object, or NOTHING if not configured

        @since HttpServer 1.5
    */
    *SSLPrivateKey getSslPrivateKeyObject() {
        return opts.key;
    }

    #! Returns whether to accept all client certificates (including self-signed)
    /** @return True if all client certificates should be accepted

        @since HttpServer 1.5
    */
    bool getSslAcceptAllCerts() {
        return ssl_accept_all_certs;
    }

    #! Returns whether remote (client) certificate capture is enabled
    /** @return True if remote certificates should be captured during the SSL handshake

        @since HttpServer 1.6
    */
    bool getGetRemoteCerts() {
        return get_remote_certs;
    }

    #! Returns whether this listener is configured for SSL/TLS
    /** @return True if this listener uses SSL/TLS

        @note This returns the configured SSL status, not whether the socket has SSL configured.
        SSL is configured per-connection rather than on the listener socket, so this method
        should be used instead of isSecure() for checking SSL status.

        @since HttpServer 1.5
    */
    bool isSsl() {
        return ssl;
    }

    #! Returns the HTTP version mode for this listener
    /** @return the HTTP version mode: "auto", "1.0", "1.1", "2.0", or "3.0"

        @note If get_global_http2_mode() returns "disabled", HTTP/2 is not offered even if the listener is
        configured with "auto" or "2.0"

        @since HttpServer 1.6
    */
    string getHttpVersion() {
        string http_version = opts.http_version ?? "auto";
        # Check global HTTP/2 mode - if disabled, don't offer HTTP/2
        if (http_version == "auto" || http_version == "2.0" || http_version == "2") {
            if (get_global_http2_mode() == "disabled") {
                return "1.1";
            }
        }
        return http_version;
    }

    auto removeUserThreadContext(*string k) {
        if (!exists k) {
            remove_thread_data("uctx");
            return;
        }
        *hash<auto> h = get_thread_data("uctx");
        auto rv = remove h{k};
        save_thread_data("uctx", h);
        return rv;
    }

    addUserThreadContext(hash<auto> uctx) {
        save_thread_data("uctx", get_thread_data("uctx") + uctx);
    }

    stopNoWait() {
        background stop();
    }

    stop(*bool silent) {
        {
            m.lock();
            on_exit m.unlock();

            if (stopped) {
                return;
            }

            if (exit) {
                return;
            }

            exit = True;
        }

        # wait for all connection threads to terminate
        cThreads.wait();

        # Cancel async accept operations BEFORE closing the listener socket.
        #
        # The I/O controller has pending accept operations on this
        # listener's fd.  If we close the fd first, the I/O thread sees errors on
        # the closed fd and fires error callbacks that attempt to replenish accept
        # ops on the dead socket.  Those replenishments fail, but the error path
        # runs on the shared I/O thread and can interfere with operations for OTHER
        # listeners on the same controller.
        #
        # By cancelling first, the callbacks fire with canceled=True (clean path,
        # no replenishment), and the fd is removed from the event loop before close.
        # listenerStopped() will skip the redundant removeListener() call.
        if (serv) {
            serv.removeAsyncListener(self);
        }

        # Close the listener socket to release the bound port.
        shutdown();
        close();

        # stop all dedicated socket connections
        {
            *hash<string, AbstractHttpSocketHandlerInterface> shh_copy;
            {
                m.lock();
                on_exit m.unlock();

                shh_copy = remove shh;
            }

            foreach AbstractHttpSocketHandlerInterface handler in (shh_copy.iterator()) {
                try {
                    handler.stop(id);
                } catch (hash<ExceptionInfo> ex) {
                    if (!silent) {
                        logError("error stopping handler on listener %d: %s: %s", id, ex.err, ex.desc);
                    }
                }
            }
        }

        # wait for all dedicated connection threads to terminate
        dThreads.wait();

        stopped = True;

        # Notify the server BEFORE logging, because log() may access the server
        # via the weak 'serv' reference, and if the server's last strong reference
        # has been dropped externally (e.g. stopNoWait() + caller scope exit), the
        # log call can trigger server destruction.  The server destructor calls
        # stop() -> c.wait(), so c.done() (inside listenerStopped) must complete
        # first to avoid a deadlock.
        if (serv) {
            serv.listenerStopped(self);
            if (stopc) {
                serv.callListenerStopCallback(stopc, name, socket_info);
            }
        }

        if (!silent) {
            log("stopped listener");
        }
    }

    string getResponseLogString(hash<auto> cx, int status_code, *data body, *hash<auto> hdr) {
        # do log msg
        string http_ver = cx."header-info".http3 ? "HTTP/3"
            : cx."header-info".http2 ? "HTTP/2" : "HTTP/1.1";
        string lstr = sprintf("cid %d: %s %d %s", cx.id, http_ver, status_code, HttpServer::HttpCodes{status_code});
        if (cx.handler_name)
            lstr += sprintf(" handler: %y", cx.handler_name);
        if (cx.user)
            lstr += sprintf(" user: %y", cx.user);
        if (body)
            lstr += sprintf(" size: %d", body.size());
        if (hdr."Content-Type")
            lstr += sprintf(" CT: %y", hdr."Content-Type");
        return lstr;
    }

    logResponse(hash<auto> cx, int status_code, *data body, *hash<auto> hdr) {
        # do log msg
        string lstr = getResponseLogString(cx, status_code, body, hdr);
        log("%s", lstr);

        if (log_send_headers)
            log("cid %d: SEND HDR: HTTP code %d: %y", cx.id, status_code, hdr);
        if (log_send_body)
            log("cid %d: SEND BODY: %y", cx.id, body);
    }

    logResponse(hash<auto> cx, int code, InputStream body, *hash<auto> hdr) {
        # do log msg
        string http_ver = cx."header-info".http3 ? "HTTP/3"
            : cx."header-info".http2 ? "HTTP/2" : "HTTP/1.1";
        string lstr = sprintf("cid %d: %s %d %s", cx.id, http_ver, code, HttpServer::HttpCodes{code});
        if (cx.handler_name)
            lstr += sprintf(" handler: %y", cx.handler_name);
        if (cx.user)
            lstr += sprintf(" user: %y", cx.user);
        if (hdr."Content-Type")
            lstr += sprintf(" CT: %y", hdr."Content-Type");
        log("%s", lstr);

        if (log_send_headers)
            log("cid %d: SEND HDR: HTTP code %d: %y", cx.id, code, hdr);
        if (log_send_body)
            log("cid %d: SENT CHUNKED BODY (%s)", cx.id, body.className());
    }

    logResponse(hash<auto> cx, hash<auto> rv) {
        #  "rv" can be a "HttpHandlerResponseInfo", so we can't access "chunked_body" directly
        if (rv.body || !rv.hasKeyValue("chunked_body")) {
            logResponse(cx, rv."code", rv.body, rv.hdr);
        } else {
            logResponse(cx, rv."code", rv.chunked_body, rv.hdr);
        }
    }

    # Called when an HTTP response could not be sent
    logResponseError(hash<auto> cx, hash<auto> rv, hash<ExceptionInfo> ex) {
        # do log msg
        string lstr = sprintf("ERROR: %s: Could not send response: %s",
            getResponseLogString(cx, rv."code", rv.chunked_body ?? rv.body, rv.hdr),
            !serv.getDebug()
                ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                : get_exception_string(ex));
        log("%s", lstr);

        if (log_send_headers) {
            log("ERROR: cid %d: FAILED TO SEND HDR: HTTP code %d: %y", cx.id, rv."code", rv.hdr);
        }
        if (log_send_body) {
            log("ERROR: cid %d: FAILED TO SEND BODY: %y", cx.id, rv.chunked_body ?? rv.body);
        }
    }

    log(string fmt, ...) {
        softlist<auto> args = fmt;
        if (argv) {
            args += argv;
        }
        args[0] = sprintf("%y (%s): %s", name, socket_info.desc, args[0]);
        if (logger) {
            args[0] = "HTTP" + (ssl ? "S" : "") + " " + args[0];
            try {
                logger.logArgs(LoggerLevel::INFO, args[0], args[1..]);
            } catch (hash<ExceptionInfo> ex) {
                if (serv) {
                    args[0] = sprintf("cannot write to listener log: %s: %s: msg: %s", ex.err, ex.desc, args[0]);
                    try {
                        serv.logErrorArgs(args);
                    } catch () {
                        # ignore if server was deleted
                    }
                }
            }
        } else if (serv) {
            try {
                serv.logArgs(args);
            } catch () {
                # ignore if server was deleted
            }
        }
    }

    logError(string fmt, ...) {
        softlist<auto> args = fmt;
        if (argv) {
            args += argv;
        }
        args[0] = sprintf("%y (%s): %s", name, socket_info.desc, args[0]);
        if (logger) {
            args[0] = "HTTP " + args[0];
            try {
                logger.logArgs(LoggerLevel::ERROR, args[0], args[1..]);
            } catch (hash<ExceptionInfo> ex) {
                if (serv) {
                    args[0] = sprintf("cannot write to listener log: %s: %s: msg: %s", ex.err, ex.desc, args[0]);
                    try {
                        serv.logErrorArgs(args);
                    } catch () {
                        # ignore if server was deleted
                    }
                }
            }
        } else if (serv) {
            try {
                serv.logErrorArgs(args);
            } catch () {
                # ignore if server was deleted
            }
        }
    }

    bool registerDedicatedSocket(RequestHelper request_helper, softstring id,
            HttpServer::AbstractHttpSocketHandlerInterface h) {
        m.lock();
        on_exit m.unlock();

        if (exit) {
            return False;
        }

        # handover counter value and set dedicated flag
        request_helper.setDedicated();

        # save handler
        shh{id} = h;

        return True;
    }

    removeExternalDedicatedSocket(softstring id) {
        removeDedicatedSocket(id, True);
    }

    removeDedicatedSocket(softstring id, *bool managed_externally) {
        m.lock();
        on_exit m.unlock();

        remove shh{id};
    }

    #! Signals all active dedicated socket handlers to stop without closing the listener
    /** Called during async I/O controller shutdown to ensure streaming handler tasks
        (SSE, WebSocket) exit their polling loops before the handler pool is stopped.

        Unlike @ref stop(), this does not shut down the listener socket or wait for
        connection threads; it only sets the handler-level stop flags.

        @since HttpServer 1.6
    */
    signalHandlersToStop() {
        *hash<string, AbstractHttpSocketHandlerInterface> shh_copy;
        {
            m.lock();
            on_exit m.unlock();
            shh_copy = shh;
        }
        foreach AbstractHttpSocketHandlerInterface handler in (shh_copy.iterator()) {
            try {
                handler.stop(id);
            } catch (hash<ExceptionInfo> ex) {
                log("signalHandlersToStop: error stopping handler: %s: %s", ex.err, ex.desc);
            }
        }
    }

    #! Returns the context template for new connections
    /** @param info peer info hash with "address", "address_desc", "port" keys
        @return context hash for new connection
    */
    hash<auto> getContextTemplate(hash<auto> info) {
        return {
            "socket": socket,
            "socket-info": socket_info,
            "peer-info": info,
            "id": ss.next(),
            "ssl": ssl,
            "listener-id": id,
            "listener-name": name,
            "async_ctrl": serv.getGlobalAsyncCtrl(),
        };
    }

    #! Returns the listener ID
    int getId() {
        return id;
    }

    #! Processes an HTTP request natively for async I/O
    /** This method performs context setup, calls handleRequest() with async response capture,
        and translates the result to HttpRequestResultInfo for the controller to send.

        Response data is returned in the result for the controller to send (HTTP/1.x or
        HTTP/2); this method does not send responses itself.

        @param s the client socket
        @param cx the connection context (will be modified)
        @param hdr the parsed HTTP header (will be modified)
        @param header_info header parsing info

        @return result info for the controller to act on

        @since HttpServer 1.6
    */
    hash<HttpServerAsyncIo::HttpRequestResultInfo> processNativeRequest(Socket s, hash<auto> cx,
            hash<auto> hdr, hash<auto> header_info) {
        cThreads.add();
        RequestHelper request_helper(cThreads, dThreads);

        bool is_multiplexed = (header_info.http2 ?? False) || (header_info.http3 ?? False);
        string sock_key;
        HttpPersistentHandlerInfo phi();
        if (is_multiplexed) {
            # HTTP/3 uses "hash:quic:session_id" to isolate each QUIC session;
            # the UDP listener socket is shared by all sessions
            sock_key = header_info.http3
                ? s.uniqueHash() + ":quic:" + header_info.session_id
                : s.uniqueHash();
        }

        # Get peer info for handleRequest
        hash<auto> info = cx."peer-info";
        info.desc = info.address_desc;
        if (info.port) {
            info.desc += ":" + info.port;
        }

        # Process path: decode URL-encoded characters
        cx.raw_path = hdr.path;
        hdr.path = decode_url(hdr.path);
        cx += {
            "orig_path": hdr.path,
            "masked_path": serv.maskData(hdr.path),
        };

        # Remove leading / if present in path
        if (hdr.path =~ /^\//) {
            splice hdr.path, 0, 1;
        }

        # Set authorization if present
        if (hdr.authorization) {
            cx.auth = hdr.authorization;
        }

        # Save original content-type and process content-type header
        if (hdr."content-type") {
            hdr."_qore_orig_content_type" = hdr."content-type";
        }
        # only overwrite content-type if body-content-type is set (HTTP/2 may not set it)
        if (header_info."body-content-type".val()) {
            hdr."content-type" = header_info."body-content-type";
            if (hdr."content-type".typeCode() == NT_LIST) {
                hdr."content-type" = hdr."content-type"[0];
            }
        }

        # Copy headers to the context
        cx.hdr = hdr;

        # Set encoding info
        cx.char_encoding = s.getEncoding();
        cx."response-encoding" = header_info."accept-charset";

        # Check if we need to close the connection (from HTTP version negotiation)
        cx.close = header_info.close;

        # Log the request
        {
            string http_ver = hdr.http_version =~ /^HTTP\// ? hdr.http_version : "HTTP/" + hdr.http_version;
            string lstr = sprintf("cid %d src %y: %s %s %s (agent: %y", cx.id,
                cx."peer-info".address_desc, hdr.method, cx.masked_path, http_ver, hdr."user-agent");
            if (hdr."transfer-encoding" == "chunked") {
                lstr += " body: chunked";
            }
            if (hdr."_qore_orig_content_type") {
                lstr += sprintf(" Content-Type: %y", hdr."_qore_orig_content_type");
            }
            if (ssl) {
                lstr += sprintf(" %s %s", s.getSSLCipherName(), s.getSSLCipherVersion());
            }
            lstr += ")";
            log("%s", lstr);
        }

        # Set user context and header info
        cx.uctx = get_thread_data("uctx");
        # For body_streaming, expose the socket so handlers can read body data
        # incrementally via readQuicStreamDataBlock()
        if (header_info.body_streaming) {
            header_info.sock = s;
        }
        cx."header-info" = header_info;

        # Add client certificate if requested and available
        if (get_remote_certs) {
            if (header_info.http3) {
                # For HTTP/3 (QUIC), the TLS handshake is in the QuicSession, not
                # the listener socket — use getQuicPeerCertificate() with the session ID
                cx."client-cert" = s.getQuicPeerCertificate(header_info.session_id);
            } else {
                cx."client-cert" = s.getRemoteCertificate();
            }
        }

        # Capture the response for the controller to send
        hash<HttpAsyncResponseInfo> async_response = <HttpAsyncResponseInfo>{};

        # Call handleRequest with async capture
        handleRequest(request_helper, self, s, \cx, hdr, hdr.method == "HEAD", phi, info, \async_response);

        # Manage persistent handler state after request processing
        if (is_multiplexed && phi.handler && phi.handler.isPersistent()
                && !request_helper.isDedicated()) {
            # For multiplexed connections, dedicate this handler pool thread to the
            # persistent session.  Subsequent requests on the same connection will be
            # routed to this thread via a Queue, ensuring thread affinity for
            # thread-local resources (e.g. database transactions).
            log("cid %d: handler opted into persistence for %s %s (multiplexed), "
                "switching to dedicated thread mode", cx.id, hdr.method, cx.masked_path);
            # Register the persistent queue BEFORE resuming h2op to avoid a race
            # condition: once h2op is resumed, the I/O thread can receive the next
            # request immediately. If the queue isn't registered yet, the request
            # won't be routed to this dedicated thread and will go to the pool instead.
            Queue pq();
            code register_fn = header_info.register_persistent_queue;
            code deregister_fn = header_info.deregister_persistent_queue;
            register_fn(sock_key, pq, phi.handler.getPersistentQueueFilter());
            # Resume h2op for body_streaming requests — the handler has finished reading
            # the body, but the h2op was never resumed because the handler pool task code
            # at lines after onHttpRequest() will never execute (we block here instead)
            if (header_info.resume_body_streaming) {
                header_info.resume_body_streaming();
            }
            on_exit deregister_fn(sock_key);
            # Send initial response via HTTP/2 submit
            if (async_response.code) {
                sendMultiplexedResponse(s, header_info, async_response);
            }
            # Enter dedicated persistent loop
            handleMultiplexedPersistentSync(request_helper, pq, s, \cx, phi, info,
                deregister_fn, sock_key);
            return <HttpServerAsyncIo::HttpRequestResultInfo>{};
        } else if (!is_multiplexed && phi.handler && phi.handler.isPersistent()
                && !request_helper.isDedicated()) {
            # For HTTP/1.x, switch to synchronous mode for thread affinity
            log("cid %d: handler opted into persistence for %s %s, switching to sync mode",
                cx.id, hdr.method, cx.masked_path);
            # Handler requires thread affinity - send current response synchronously first
            if (async_response.code) {
                sendResponseSync(s, async_response);
            }
            # Continue handling requests on this thread until persistence ends
            handlePersistentConnectionSync(request_helper, s, \cx, phi, info);
            # Persistent handler managed the socket lifecycle; return empty result
            return <HttpServerAsyncIo::HttpRequestResultInfo>{};
        }

        # If handler consumed the response (e.g., WebSocket/SSE upgrade sent the 101
        # response directly and deleted async_response), the connection is now managed
        # by a dedicated handler
        if (!async_response) {
            if (request_helper.isDedicated()) {
                return <HttpServerAsyncIo::HttpRequestResultInfo>{"dedicated": True};
            }
            # Response was sent directly by the handler
            return <HttpServerAsyncIo::HttpRequestResultInfo>{};
        }

        # Translate result to HttpRequestResultInfo for the controller
        return translateToRequestResult(async_response, request_helper, cx, s);
    }

    #! Translates async response data into HttpRequestResultInfo for the controller
    /** @param async_response the captured async response data
        @param request_helper the request lifecycle helper
        @param cx the connection context
        @param s the client socket

        @return result info for the controller to act on
    */
    private hash<HttpServerAsyncIo::HttpRequestResultInfo> translateToRequestResult(
            hash<HttpAsyncResponseInfo> async_response, RequestHelper request_helper,
            hash<auto> cx, Socket s) {
        bool is_multiplexed = (cx."header-info".http2 ?? False) || (cx."header-info".http3 ?? False);

        # Handler set up a streaming connection (SSE or WebSocket)
        if (async_response.streaming) {
            return <HttpServerAsyncIo::HttpRequestResultInfo>{
                "streaming": True,
                "stream_type": async_response.stream_type,
                "stream_operation": async_response.stream_operation,
                "code": async_response.code,
                "status_message": HttpServer::HttpCodes{async_response.code},
                "hdr": async_response.hdr,
            };
        }

        if (async_response.code && !request_helper.isDedicated()) {
            # Normal response - return response data for controller to send
            hash<auto> hdr = async_response.hdr ?? {};
            if (is_multiplexed) {
                # HTTP/2 and HTTP/3 use DATA frames, not chunked Transfer-Encoding
                remove hdr."Transfer-Encoding";
            }
            if (async_response.body && !hdr."Content-Length" && !hdr."Transfer-Encoding") {
                hdr."Content-Length" = string(async_response.body.size());
            }
            # Log the response
            logResponse(cx, async_response);

            # For multiplexed protocols (HTTP/2, HTTP/3), don't close the connection
            # based on cx.close — the stream is closed independently
            bool do_close = !is_multiplexed && (async_response.close || !s.isOpen());
            return <HttpServerAsyncIo::HttpRequestResultInfo>{
                "code": async_response.code,
                "status_message": HttpServer::HttpCodes{async_response.code},
                "hdr": hdr,
                "body": async_response.body,
                "input_stream": async_response.input_stream,
                "send_callback": async_response.send_callback,
                "send_timeout": async_response.send_timeout,
                "chunked": async_response.chunked && !is_multiplexed,
                "close": do_close,
                "return_to_idle": !do_close,
                "ttl": serv.getTtl(),
            };
        }

        if (request_helper.isDedicated()) {
            # Connection was handed to a dedicated handler (WebSocket/SSE)
            return <HttpServerAsyncIo::HttpRequestResultInfo>{"dedicated": True};
        }

        # No response captured - handler may have sent response directly or failed
        bool response_sent = cx."response-sent" ?? False;
        if (!response_sent) {
            # Handler failed to send response - send 500 error
            string err = sprintf("handler %y returned without sending a response", cx.handler_name);
            logError("%s", err);
            if (is_multiplexed) {
                # Multiplexed: return the error response for the controller to send asynchronously
                # Do NOT call sendHttpError synchronously - it races with the async I/O controller
                hash<HttpAsyncResponseInfo> err_resp = serv.buildAsyncErrorResponse(500, err, cx,
                    self, s, False);
                if (err_resp.body && !err_resp.hdr."Content-Length") {
                    err_resp.hdr."Content-Length" = string(err_resp.body.size());
                }
                logResponse(cx, err_resp);
                return <HttpServerAsyncIo::HttpRequestResultInfo>{
                    "code": 500,
                    "status_message": HttpServer::HttpCodes{500},
                    "hdr": err_resp.hdr,
                    "body": err_resp.body,
                    "close": False,
                    "return_to_idle": True,
                    "ttl": serv.getTtl(),
                };
            }
            cx.close = True;
            serv.sendHttpError(self, cx, s, 500, err, NOTHING, NOTHING, cx."response-encoding", False);
        }

        if ((!cx.close || is_multiplexed) && s.isOpen()) {
            return <HttpServerAsyncIo::HttpRequestResultInfo>{
                "return_to_idle": True,
                "ttl": serv.getTtl(),
            };
        }
        return <HttpServerAsyncIo::HttpRequestResultInfo>{"close": True};
    }

    #! Sends a response synchronously (used when switching from async to sync mode for persistent handlers)
    private sendResponseSync(Socket s, hash<HttpAsyncResponseInfo> response) {
        @assert(response.code, "response.code must be set");
        @debug {
            auto body_size = response.body ? response.body.size() : 0;
            log("DEBUG: sendResponseSync: code=%d body_size=%d chunked=%y http2=%y http3=%y",
                response.code, body_size, response.chunked, response.cx."header-info".http2,
                response.cx."header-info".http3);
        }
        try {
            if (response.cx."header-info".http2) {
                # HTTP/2: send via HTTP/2 DATA frames
                int stream_id = response.cx."header-info".stream_id;
                hash<auto> hdr = response.hdr ?? {};
                remove hdr."Transfer-Encoding";
                AbstractPollOperation op;
                if (response.input_stream) {
                    # Use streaming response to avoid memory buffering
                    # Stream was unassigned in doResponse(); reassign to current thread so
                    # startPollSendHttp2StreamingResponse() can access it (it will unassign again)
                    response.input_stream.reassignThread();
                    op = s.startPollSendHttp2StreamingResponse(stream_id, response.code, hdr,
                        response.input_stream);
                } else {
                    if (response.body && !hdr."Content-Length") {
                        hdr."Content-Length" = string(response.body.size());
                    }
                    op = s.startPollSendHttp2Response(stream_id, response.code, hdr,
                        response.body);
                }
                serv.execAsyncPollOperation(s, op);
            } else if (response.cx."header-info".http3) {
                # HTTP/3: send via QUIC stream
                int session_id = response.cx."header-info".session_id;
                int stream_id = response.cx."header-info".stream_id;
                hash<auto> hdr = response.hdr ?? {};
                remove hdr."Transfer-Encoding";
                if (response.input_stream) {
                    # HTTP/3: stream InputStream response incrementally
                    # Stream was unassigned in doResponse(); reassign to current thread so
                    # startPollQuicSendStreamingResponse() can access it (it will unassign again)
                    response.input_stream.reassignThread();
                    AbstractPollOperation op = s.startPollQuicSendStreamingResponse(
                        session_id, stream_id, response.code, hdr, response.input_stream);
                    serv.execAsyncPollOperation(s, op);
                } else {
                    s.submitQuicResponse(session_id, stream_id, response.code, hdr,
                        response.body);
                }
            } else if (response.send_callback) {
                if (response.cx."header-info".http2) {
                    # HTTP/2: wrap send_callback in CallbackInputStream and stream via DATA frames
                    int stream_id = response.cx."header-info".stream_id;
                    hash<auto> hdr = response.hdr ?? {};
                    remove hdr."Transfer-Encoding";
                    auto cb = response.send_callback;
                    InputStream is = new CallbackInputStream(
                        auto sub() { return cb(); }, response.cx.socketobject);
                    AbstractPollOperation op = s.startPollSendHttp2StreamingResponse(
                        stream_id, response.code, hdr, is);
                    serv.execAsyncPollOperation(s, op);
                } else {
                    # HTTP/1.x: send callback-based chunked response (e.g. DataStream protocol)
                    s.sendHTTPResponseWithCallback(response.send_callback, response.code,
                        HttpServer::HttpCodes{response.code}, "1.1",
                        response.hdr ?? {}, response.send_timeout ?? -1);
                }
            } else if (response.input_stream) {
                # HTTP/1.x: send InputStream-based chunked response
                response.input_stream.reassignThread();
                s.sendHTTPResponse(response.code, HttpServer::HttpCodes{response.code}, "1.1",
                    response.hdr ?? {}, response.input_stream);
            } else {
                # HTTP/1.x: send normal response
                s.sendHTTPResponse(response.code, HttpServer::HttpCodes{response.code}, "1.1",
                    response.hdr ?? {}, response.body);
            }
        } catch (hash<ExceptionInfo> ex) {
            log("ERROR: Failed to send response synchronously: %s: %s", ex.err, ex.desc);
            rethrow;
        }
        logResponse(response.cx, response);
    }

    #! Handles a persistent connection synchronously after the async I/O controller detected persistence
    /** This method is called when a handler opts into persistence via setPersistent(True).
        It handles all subsequent requests on the current thread until:
        - The handler releases persistence (isPersistent() returns False)
        - The connection is closed
        - An error occurs

        @param request_helper the request helper for parsing HTTP requests
        @param s the socket for the connection
        @param cx the connection context
        @param phi the persistent handler info
        @param info peer info for logging
    */
    private handlePersistentConnectionSync(RequestHelper request_helper, Socket s, reference<hash<auto>> cx,
            HttpPersistentHandlerInfo phi, hash<auto> info) {
        @assert(phi.handler, "phi.handler must be set when entering persistent sync mode");
        @assert(phi.handler.isPersistent(), "handler must be persistent when entering persistent sync mode");
        log("cid %d: switching to synchronous mode for persistent handler", cx.id);

        # Static listener context template
        hash<auto> cx_listener = getContextTemplate(info);

        # Clean up persistent handler state and thread-local data when this function
        # exits for any reason.  This is critical because this runs on a handler pool
        # thread that will be reused - stale thread-local data from a persistent
        # session (e.g., from an abnormal disconnect) would corrupt subsequent requests.
        on_exit {
            phi.clear();
            removeUserThreadContext();
            remove_thread_data("svc_listener");
        }

        try {
            while (!exit && s.isOpen()) {
                # NOTE: persistence may have ended between requests (e.g., between
                # DataStream SELECT and ROLLBACK), but we continue processing on this
                # thread to preserve thread affinity for thread-bound resources (e.g.,
                # database transactions).  The idle timeout in the wait loop below
                # handles the case where no more requests arrive after persistence ends.

                # Wait for next request with idle timeout
                date poll_interval = HttpServer::PollTimeout;
                date ttl = serv.getTtl();
                if (poll_interval > ttl) {
                    poll_interval = ttl;
                }

                date start = now_us();
                while (!exit && s.isOpen() && !s.isDataAvailable(poll_interval)) {
                    # Check for idle timeout only if persistence has been released
                    # (persistent connections have no idle timeout while active)
                    if (!phi.handler || !phi.handler.isPersistent()) {
                        if ((now_us() - start) > ttl) {
                            log("cid %d: persistent sync idle timeout, returning to async I/O",
                                cx.id);
                            if (!cx.close && s.isOpen()) {
                                serv.returnConnectionToAsyncIo(s, cx, self);
                            }
                            return;
                        }
                    }
                }
                # Check if we exited due to shutdown
                if (exit) {
                    return;
                }

                # Reset context for new request
                cx = cx_listener;

                # Read HTTP header
                hash<auto> header_info;
                hash<auto> hdr;
                try {
                    hdr = s.readHTTPHeader(HttpServer::ReadTimeout, \header_info);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "SOCKET-CLOSED") {
                        # Connection closed by peer
                        return;
                    } else if (ex.err == "SOCKET-TIMEOUT") {
                        string err = sprintf("timed out reading HTTP header after %d ms", HttpServer::ReadTimeout);
                        logError("cid %d: %s", cx.id, err);
                        cx.close = True;
                        serv.sendHttpError(self, cx, s, 400, err, NOTHING, NOTHING, NOTHING, False);
                        return;
                    }
                    string etxt = sprintf("ERROR reading HTTP header: %s: %s", ex.err, ex.desc);
                    logError("cid %d: %s", cx.id, etxt);
                    cx.close = True;
                    serv.sendHttpError(self, cx, s, 400, etxt, NOTHING, NOTHING, NOTHING, False);
                    return;
                }

                # Process path
                cx.raw_path = hdr.path;
                hdr.path = decode_url(hdr.path);
                cx += {
                    "orig_path": hdr.path,
                    "masked_path": serv.maskData(hdr.path),
                };

                if (hdr.path =~ /^\//) {
                    splice hdr.path, 0, 1;
                }

                if (hdr.authorization) {
                    cx.auth = hdr.authorization;
                }

                # Process content-type
                if (hdr."content-type") {
                    hdr."_qore_orig_content_type" = hdr."content-type";
                }
                # only overwrite content-type if body-content-type is set (HTTP/2 may not set it)
                if (header_info."body-content-type".val()) {
                    hdr."content-type" = header_info."body-content-type";
                    if (hdr."content-type".typeCode() == NT_LIST) {
                        hdr."content-type" = hdr."content-type"[0];
                    }
                }

                cx.hdr = hdr;
                cx.char_encoding = s.getEncoding();
                cx."response-encoding" = header_info."accept-charset";
                cx.close = header_info.close;

                # Check for end-persistent signal — client is explicitly ending
                # the persistent session.  Send a 200 OK response and clear
                # persistence so the connection can be reused.  The loop
                # continues to handle any subsequent requests on the same
                # keep-alive connection (e.g., a new streaming session);
                # if no more requests arrive, the idle timeout will return
                # the connection to async I/O.
                if (hdr."qorus-connection" =~ /^end-persistent$/i) {
                    log("cid %d: received end-persistent signal, terminating "
                        "persistent session", cx.id);
                    s.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain"},
                        "OK");
                    # Clear persistence so the idle timeout can fire and the
                    # connection can be returned to async I/O if no more
                    # requests arrive
                    phi.clear();
                    continue;
                }

                # Log the request
                {
                    string http_ver = hdr.http_version =~ /^HTTP\// ? hdr.http_version : "HTTP/" + hdr.http_version;
                    string lstr = sprintf("cid %d src %y: %s %s %s (agent: %y", cx.id,
                        cx."peer-info".address_desc, hdr.method, cx.masked_path, http_ver, hdr."user-agent");
                    if (hdr."transfer-encoding" == "chunked") {
                        lstr += " body: chunked";
                    }
                    if (hdr."_qore_orig_content_type") {
                        lstr += sprintf(" Content-Type: %y", hdr."_qore_orig_content_type");
                    }
                    if (ssl) {
                        lstr += sprintf(" %s %s", s.getSSLCipherName(), s.getSSLCipherVersion());
                    }
                    lstr += " [persistent-sync]";
                    lstr += ")";
                    log("%s", lstr);
                }

                cx.uctx = get_thread_data("uctx");
                cx."header-info" = header_info;

                if (get_remote_certs) {
                    cx."client-cert" = s.getRemoteCertificate();
                }

                # Process request
                hash<HttpAsyncResponseInfo> async_response = <HttpAsyncResponseInfo>{};
                handleRequest(request_helper, self, s, \cx, hdr, hdr.method == "HEAD", phi, info,
                    \async_response);

                # If handler took over the socket (dedicated), we're done
                # Note: isDedicatedExternal() implies isDedicated(), so checking isDedicated() covers both
                if (request_helper.isDedicated()) {
                    return;
                }

                # Send response synchronously
                if (async_response && async_response.code) {
                    sendResponseSync(s, async_response);
                }

                # Check if connection should be closed
                if (cx.close) {
                    break;
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            string etxt = serv.getDebug()
                ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                : get_exception_string(ex);
            logError("cid %d: persistent handler error: %s", cx.id, etxt);
            cx.close = True;
            try {
                serv.sendHttpError(self, cx, s, 500, etxt, NOTHING, NOTHING, cx."response-encoding", False);
            } catch () {
                # Ignore errors sending error response
            }
        }

        # Close connection
        if (s.isOpen()) {
            try {
                s.shutdown();
                s.close();
            } catch () {
                # Ignore close errors
            }
        }
    }

    #! Sends a multiplexed response from a handler pool thread using the protocol-appropriate submit API
    /** Uses the thread-safe submit APIs that queue data for the I/O thread, avoiding conflicts
        with the I/O thread's poll operation.  Supports both HTTP/2 and HTTP/3 (QUIC).

        @param s the socket
        @param header_info the request header info containing protocol details (http2/http3,
            stream_id, session_id, io_wake)
        @param response the async response data
    */
    private sendMultiplexedResponse(Socket s, hash<auto> header_info,
            hash<HttpAsyncResponseInfo> response) {
        int stream_id = header_info.stream_id;
        code io_wake = header_info.io_wake;
        hash<auto> hdr = response.hdr ?? {};
        remove hdr."Transfer-Encoding";

        # Convert send_callback to InputStream
        if (response.send_callback && !response.input_stream) {
            auto cb = response.send_callback;
            response.input_stream = new CallbackInputStream(
                auto sub() { return cb(); }, s);
        }

        if (header_info.http3) {
            int session_id = header_info.session_id;
            if (response.input_stream) {
                # Try I/O-thread-safe streaming first
                int rv = s.submitQuicStreamingResponseWithStream(
                    session_id, stream_id, response.code, hdr, response.input_stream);
                if (!rv) {
                    io_wake();
                    logResponse(response.cx, response);
                    return;
                }
                # Fall back to handler-thread chunking
                s.submitQuicResponseStreaming(session_id, stream_id, response.code, hdr);
                io_wake();
                response.input_stream.reassignThread();
                on_exit response.input_stream.unassignThread();
                while (*binary chunk = response.input_stream.read(65536)) {
                    int retries = 0;
                    while (s.submitQuicStreamData(session_id, stream_id, chunk) == 1) {
                        if (++retries > 200) {
                            throw "HTTP3-FLOW-CONTROL", sprintf("stream %d: buffer not draining "
                                "after %d retries", stream_id, retries);
                        }
                        io_wake();
                        int drain_rv = s.waitForQuicStreamDrain(session_id, stream_id, 50ms);
                        if (drain_rv == -1) {
                            throw "HTTP3-STREAM-ERROR", sprintf("stream %d: stream removed "
                                "while waiting for drain", stream_id);
                        }
                    }
                    io_wake();
                }
                s.submitQuicStreamData(session_id, stream_id, NOTHING, True);
                io_wake();
            } else {
                s.submitQuicResponse(session_id, stream_id, response.code, hdr, response.body);
                io_wake();
            }
        } else {
            # HTTP/2
            if (response.input_stream) {
                # Try I/O-thread-safe streaming first
                int rv = s.submitHttp2StreamingResponseWithStream(
                    stream_id, response.code, hdr, response.input_stream);
                if (!rv) {
                    io_wake();
                    logResponse(response.cx, response);
                    return;
                }
                # Fall back to handler-thread chunking
                s.submitHttp2StreamingResponseHeaders(stream_id, response.code, hdr);
                io_wake();
                response.input_stream.reassignThread();
                on_exit response.input_stream.unassignThread();
                while (*binary chunk = response.input_stream.read(65536)) {
                    while (True) {
                        try {
                            s.sendHttp2StreamData(stream_id, chunk);
                            io_wake();
                            break;
                        } catch (hash<ExceptionInfo> ex) {
                            if (ex.err == "HTTP2-FLOW-CONTROL") {
                                # Buffer full — wake I/O thread to drain, then wait
                                # deterministically for the CV signal
                                io_wake();
                                if (s.waitForHttp2StreamDrain(stream_id, 10s)) {
                                    # Timed out or stream gone — give up
                                    rethrow;
                                }
                                continue;
                            }
                            rethrow;
                        }
                    }
                }
                s.sendHttp2StreamData(stream_id, NOTHING, True);
                io_wake();
            } else {
                s.submitHttp2Response(stream_id, response.code, hdr, response.body);
                io_wake();
            }
        }
        logResponse(response.cx, response);
    }

    #! Handles persistent multiplexed connections via a dedicated handler pool thread
    /** This method is called when a handler opts into persistence for an HTTP/2 or HTTP/3
        multiplexed connection.  It enters a loop reading subsequent requests from a Queue
        (populated by the I/O controller) and processes them on the current thread, ensuring
        thread affinity for thread-local resources like database transactions.

        @param request_helper the request lifecycle helper
        @param pq the Queue to receive subsequent requests from
        @param s the socket
        @param cx the connection context (reference, modified per request)
        @param phi the persistent handler info
        @param info peer info for logging
        @param deregister_fn callback to deregister the persistent queue
        @param sock_key the socket unique hash identifying the connection
    */
    private handleMultiplexedPersistentSync(RequestHelper request_helper, Queue pq, Socket s,
            reference<hash<auto>> cx, HttpPersistentHandlerInfo phi, hash<auto> info,
            code<nothing(string)> deregister_fn, string sock_key) {
        @assert(phi.handler, "phi.handler must be set when entering multiplexed persistent mode");
        @assert(phi.handler.isPersistent(), "handler must be persistent when entering "
            "multiplexed persistent mode");
        log("cid %d: entering multiplexed persistent sync loop", cx.id);

        # Static listener context template
        hash<auto> cx_listener = getContextTemplate(info);

        # Clean up persistent handler state and thread-local data on exit
        on_exit {
            phi.clear();
            removeUserThreadContext();
            remove_thread_data("svc_listener");
        }

        try {
            while (!exit && s.isOpen()) {
                # Wait for next request from Queue with idle timeout
                date ttl = serv.getTtl();
                *hash<auto> entry;
                try {
                    entry = pq.get(ttl);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "QUEUE-TIMEOUT") {
                        if (!phi.handler || !phi.handler.isPersistent()) {
                            # Non-persistent handler timed out; exit the loop.
                            # For persistent handlers, the client must
                            # explicitly end the session via the
                            # End-Persistent header, or TCP connection close
                            # triggers cleanup via
                            # signalPersistentQueuesForConnection().
                            log("cid %d: multiplexed persistent idle timeout, "
                                "exiting dedicated mode", cx.id);
                            deregister_fn(sock_key);
                            drainOrphanedPersistentRequests(request_helper, pq,
                                s, \cx, cx_listener, phi, info);
                            return;
                        }
                        continue;
                    }
                    rethrow;
                }

                # Check for close signal or empty entry
                if (!entry || entry.type == "close") {
                    log("cid %d: multiplexed persistent connection closed", cx.id);
                    return;
                }

                # Extract request data from queue entry
                hash<auto> conn_info = entry.conn_info;
                hash<auto> req_hdr = conn_info.hdr;

                # Check for end-persistent signal — the client is explicitly
                # ending the persistent session (e.g., before clearing its
                # client-side persistent flag).  Send a 200 OK response and
                # exit the loop; the on_exit block will call phi.clear() →
                # persistentClosed() → rollback any open transaction.
                if (req_hdr."qorus-connection" =~ /^end-persistent$/i) {
                    log("cid %d: received end-persistent signal, terminating "
                        "persistent session", cx.id);
                    sendMultiplexedResponse(s, conn_info.header_info,
                        <HttpAsyncResponseInfo>{
                            "code": 200,
                            "hdr": {"content-type": "text/plain"},
                            "body": "OK",
                            "cx": cx,
                        });
                    if (entry.resume_reading) {
                        try {
                            entry.resume_reading();
                        } catch () {
                            # already resumed — ignore
                        }
                    }
                    deregister_fn(sock_key);
                    drainOrphanedPersistentRequests(request_helper, pq, s,
                        \cx, cx_listener, phi, info);
                    return;
                }

                # Reset context for new request
                cx = cx_listener;

                # Context setup — mirrors processNativeRequest()
                cx.raw_path = req_hdr.path;
                req_hdr.path = decode_url(req_hdr.path);
                cx += {
                    "orig_path": req_hdr.path,
                    "masked_path": serv.maskData(req_hdr.path),
                };
                if (req_hdr.path =~ /^\//) {
                    splice req_hdr.path, 0, 1;
                }
                if (req_hdr.authorization) {
                    cx.auth = req_hdr.authorization;
                }
                if (req_hdr."content-type") {
                    req_hdr."_qore_orig_content_type" = req_hdr."content-type";
                }
                if (conn_info.header_info."body-content-type".val()) {
                    req_hdr."content-type" = conn_info.header_info."body-content-type";
                    if (req_hdr."content-type".typeCode() == NT_LIST) {
                        req_hdr."content-type" = req_hdr."content-type"[0];
                    }
                }
                cx.hdr = req_hdr;
                cx.char_encoding = s.getEncoding();
                cx."response-encoding" = conn_info.header_info."accept-charset";
                cx.close = conn_info.header_info.close;

                # Log the request
                {
                    string http_ver = req_hdr.http_version =~ /^HTTP\//
                        ? req_hdr.http_version : "HTTP/" + req_hdr.http_version;
                    string lstr = sprintf("cid %d src %y: %s %s %s (agent: %y", cx.id,
                        cx."peer-info".address_desc, req_hdr.method, cx.masked_path,
                        http_ver, req_hdr."user-agent");
                    if (req_hdr."_qore_orig_content_type") {
                        lstr += sprintf(" Content-Type: %y", req_hdr."_qore_orig_content_type");
                    }
                    if (ssl) {
                        lstr += sprintf(" %s %s", s.getSSLCipherName(), s.getSSLCipherVersion());
                    }
                    lstr += " [persistent-mux-sync]";
                    lstr += ")";
                    log("%s", lstr);
                }

                cx.uctx = get_thread_data("uctx");
                if (conn_info.header_info.body_streaming) {
                    conn_info.header_info.sock = s;
                }
                cx."header-info" = conn_info.header_info;

                if (get_remote_certs) {
                    if (conn_info.header_info.http3) {
                        cx."client-cert" = s.getQuicPeerCertificate(
                            conn_info.header_info.session_id);
                    } else {
                        cx."client-cert" = s.getRemoteCertificate();
                    }
                }

                # Process request
                hash<HttpAsyncResponseInfo> async_response = <HttpAsyncResponseInfo>{};
                # Ensure h2op is resumed even if handleRequest() or response
                # sending throws — otherwise the connection is stuck.
                on_exit {
                    if (entry.resume_reading) {
                        try {
                            entry.resume_reading();
                        } catch () {
                            # already resumed — ignore
                        }
                    }
                }
                handleRequest(request_helper, self, s, \cx, req_hdr,
                    req_hdr.method == "HEAD", phi, info, \async_response);

                # If handler took over the socket (dedicated), we're done
                if (request_helper.isDedicated()) {
                    return;
                }

                # Send response via HTTP/2 submit
                if (async_response && async_response.code) {
                    sendMultiplexedResponse(s, conn_info.header_info, async_response);
                }

                # For body_streaming requests where the handler returned early
                # (e.g., error before reading all client data), clean up the
                # dispatched stream now that the handler is done.  The response
                # has already been queued via sendMultiplexedResponse() which
                # uses nghttp2's internal state, not our streams map.
                if (conn_info.header_info.body_streaming) {
                    s.cleanupHttp2Stream(conn_info.header_info.stream_id);
                    conn_info.header_info.io_wake();
                }

                # Check if persistence was cleared by this request (e.g. commit/rollback).
                # We check both the handler's internal flag and the user thread context,
                # since persistenceThreadTerminate() clears the uctx but not the handler's
                # internal persistence flag.
                *hash<auto> uctx = get_thread_data("uctx");
                if (!phi.handler || !phi.handler.isPersistent()
                        || !uctx.persistent_data) {
                    log("cid %d: persistence cleared after request, exiting "
                        "dedicated mode", cx.id);
                    # Deregister the persistent queue BEFORE returning to prevent
                    # a race condition: the I/O thread could receive and dispatch
                    # a new request to this queue between our return and the
                    # caller's on_exit deregistration.  After deregistration, any
                    # new requests go through the normal handler pool.
                    deregister_fn(sock_key);
                    # Process any requests that were pushed to the queue during the
                    # brief window between the last pq.get() and the deregistration
                    drainOrphanedPersistentRequests(request_helper, pq, s, \cx,
                        cx_listener, phi, info);
                    return;
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            string etxt = serv.getDebug()
                ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                : get_exception_string(ex);
            logError("cid %d: multiplexed persistent handler error: %s", cx.id, etxt);
        }
    }

    #! Drains and processes any orphaned requests from a persistent queue
    /** Called after the persistent queue has been deregistered to handle requests
        that were pushed during the brief race window between the persistent loop's
        last \c pq.get() and the deregistration.  After deregistration, no new items
        can be added, so this loop is bounded.

        Orphaned requests are processed as non-persistent requests since persistence
        has already been cleared.

        @param request_helper the request lifecycle helper
        @param pq the persistent queue to drain
        @param s the socket
        @param cx the connection context (reference, modified per request)
        @param cx_listener the listener context template
        @param phi the persistent handler info (persistence already cleared)
        @param info peer info for logging
    */
    private drainOrphanedPersistentRequests(RequestHelper request_helper, Queue pq,
            Socket s, reference<hash<auto>> cx, hash<auto> cx_listener,
            HttpPersistentHandlerInfo phi, hash<auto> info) {
        while (True) {
            *hash<auto> entry;
            try {
                entry = pq.get(-1);
            } catch () {
                # QUEUE-TIMEOUT — queue is empty
                break;
            }
            if (!entry || entry.type == "close") {
                break;
            }

            log("cid %d: processing orphaned request from persistent queue race window",
                cx.id);

            # Context setup — mirrors the persistent loop processing
            hash<auto> conn_info = entry.conn_info;
            hash<auto> req_hdr = conn_info.hdr;

            cx = cx_listener;
            cx.raw_path = req_hdr.path;
            req_hdr.path = decode_url(req_hdr.path);
            cx += {
                "orig_path": req_hdr.path,
                "masked_path": serv.maskData(req_hdr.path),
            };
            if (req_hdr.path =~ /^\//) {
                splice req_hdr.path, 0, 1;
            }
            if (req_hdr.authorization) {
                cx.auth = req_hdr.authorization;
            }
            if (req_hdr."content-type") {
                req_hdr."_qore_orig_content_type" = req_hdr."content-type";
            }
            if (conn_info.header_info."body-content-type".val()) {
                req_hdr."content-type" = conn_info.header_info."body-content-type";
                if (req_hdr."content-type".typeCode() == NT_LIST) {
                    req_hdr."content-type" = req_hdr."content-type"[0];
                }
            }
            cx.hdr = req_hdr;
            cx.char_encoding = s.getEncoding();
            cx."response-encoding" = conn_info.header_info."accept-charset";
            cx.close = conn_info.header_info.close;

            # Log the request
            {
                string http_ver = req_hdr.http_version =~ /^HTTP\//
                    ? req_hdr.http_version : "HTTP/" + req_hdr.http_version;
                string lstr = sprintf("cid %d src %y: %s %s %s (agent: %y",
                    cx.id, cx."peer-info".address_desc, req_hdr.method,
                    cx.masked_path, http_ver, req_hdr."user-agent");
                if (req_hdr."_qore_orig_content_type") {
                    lstr += sprintf(" Content-Type: %y",
                        req_hdr."_qore_orig_content_type");
                }
                if (ssl) {
                    lstr += sprintf(" %s %s", s.getSSLCipherName(),
                        s.getSSLCipherVersion());
                }
                lstr += " [orphaned-persistent-drain]";
                lstr += ")";
                log("%s", lstr);
            }

            cx.uctx = get_thread_data("uctx");
            if (conn_info.header_info.body_streaming) {
                conn_info.header_info.sock = s;
            }
            cx."header-info" = conn_info.header_info;

            if (get_remote_certs) {
                if (conn_info.header_info.http3) {
                    cx."client-cert" = s.getQuicPeerCertificate(
                        conn_info.header_info.session_id);
                } else {
                    cx."client-cert" = s.getRemoteCertificate();
                }
            }

            # Process request
            hash<HttpAsyncResponseInfo> async_response = <HttpAsyncResponseInfo>{};
            on_exit {
                if (entry.resume_reading) {
                    try {
                        entry.resume_reading();
                    } catch () {
                        # already resumed — ignore
                    }
                }
            }

            try {
                handleRequest(request_helper, self, s, \cx, req_hdr,
                    req_hdr.method == "HEAD", phi, info, \async_response);

                if (request_helper.isDedicated()) {
                    return;
                }

                if (async_response && async_response.code) {
                    sendMultiplexedResponse(s, conn_info.header_info, async_response);
                }

                if (conn_info.header_info.body_streaming) {
                    conn_info.header_info.io_wake();
                }
            } catch (hash<ExceptionInfo> ex) {
                string etxt = serv.getDebug()
                    ? sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc)
                    : get_exception_string(ex);
                logError("cid %d: error processing orphaned request: %s", cx.id,
                    etxt);
            }
        }
    }
}
}

#! Private namespace
namespace Priv {
# class containing handler info
class HandlerInfo {
    public {
        string name;
        HttpServer::AbstractHttpRequestHandler obj;
        string path;
        bool isregex;
        # content type map
        *hash<string, bool> content_type_map;
        *list<string> special_header_list;
    }

    #! Creates the object from the parameters
    /** @throw HANDLER-ERROR the handler is missing from the \a info argument
    */
    constructor(string name, hash<HttpHandlerConfigInfo> info) {
        self.name = name;
        if (!info.handler) {
            throw "HANDLER-ERROR", sprintf("missing \"handler\" from handler config: %y", info);
        }
        obj = info.handler;
        path = info.path;
        isregex = info.isregex;
        content_type_map = map {$1: True}, info.content_types;
        special_header_list = map $1.lwr(), info.headers;
    }

    bool matchContentType(string ct) {
        return content_type_map{ct} ? True : False;
    }

    #! called when matching a request; returns a code giving the match level; 0 = no match, 1 = only the Content-Type matches, 2 = special header matches, 3 = URL matches
    int matchRequest(hash<auto> hdr, int score) {
        if (path && hdr.path && isregex && regex(hdr.path, path)) {
            return 3;
        }
        # the case where isregex is False was already handled by HttpHandlerList::findHandler using TreeMap
        # we get here only if the path does not match

        if (score >= 2) {
            return 0;
        }

        if (hdr{special_header_list}) {
            return 2;
        }

        if (score || !content_type_map) {
            return 0;
        }

        return content_type_map.(hdr."content-type") ? 1 : 0;
    }

    stop() {
        # stop handler if it is a dedicated socket handler
        if (obj instanceof HttpServer::AbstractHttpSocketHandlerInterface) {
            cast<HttpServer::AbstractHttpSocketHandlerInterface>(obj).stop();
        }
    }
}

# class to implement handler-handling (private)
class HttpHandlerList {
    public {
        hash<string, HandlerInfo> handlers;
        TreeMap treeMap();
    }

    /*
    private static checkSpecialHeaders(reference sh) {
        foreach auto h in (\sh) {
            if (h.typeCode() != NT_STRING)
                throw "SETHANDLER-ERROR", sprintf("entry %d in the special header list is not a string; type: %s", $#, h.type());
            # make sure header is in lower case for matching
            h = tolower(h);
        }
    }
    */

    #! sets a request handler according to the arguments given
    setHandler(string name, hash<HttpHandlerConfigInfo> info) {
        if (handlers{name}) {
            throw "SETHANDLER-ERROR", sprintf("HTTP request handler %y already exists", name);
        }
        # paths are passed without the leading "/", so they have to be like this in the treemap
        if (info.path =~ /^\//) {
            info.path = info.path.substr(1);
        }
        # for backwards-compatibility, isregex = True if not set
        if (!exists info.isregex) {
            info.isregex = True;
        }

        HandlerInfo handlerInfo(name, info);
        handlers{name} = handlerInfo;

        if (!info.isregex && info.path) {
            treeMap.put(info.path, handlerInfo);
        }
    }

    #! remove handler from the list by its name
    /**
        @throw INVALID-HANDLER-ERROR invalid handler name passed
    */
    removeHandler(string handler_name) {
        if (!handlers.hasKey(handler_name)) {
            throw "INVALID-HANDLER-ERROR", sprintf("handler with name %y is not present", handler_name);
        }

        HandlerInfo hi = handlers{handler_name};
        treeMap.take(hi.path);
        remove handlers{handler_name};
        hi.stop();
    }

    #! remove handler from the list
    /**
        @throw INVALID-HANDLER-ERROR invalid handler passed
    */
    removeHandler(HttpServer::AbstractHttpRequestHandler handler) {
        *string name;
        foreach hash<auto> h in (handlers.pairIterator()) {
            if (h.value.obj == handler) {
                name = h.key;
                break;
            }
        }
        if (name == NOTHING) {
            throw "INVALID-HANDLER-ERROR", "handler not present";
        }

        HandlerInfo hi = handlers{name};
        treeMap.take(hi.path);
        remove handlers{name};
        hi.stop();
    }

    # matches a handler to the request
    *HandlerInfo findHandler(hash<auto> hdr, reference<int> score, bool finalv = False,
            *reference<string> root_path) {
        if (!handlers)
            return;

        # if there is only one handler and final is true, then return the only handler
        if (finalv && handlers.size() == 1)
            return handlers.firstValue();

        *HandlerInfo handlerInfo = treeMap.get(hdr.path);
        if (handlerInfo) {
            # must set score to 3 to stop searching; a path match trumps all other matches
            score = 3;
            root_path = handlerInfo.path;
            return handlerInfo;
        }

        # find a handler for the request
        HandlerInfo rv;

        foreach HandlerInfo hi in (handlers.iterator()) {
            int scr = hi.matchRequest(hdr, score);
            #printf("findHandler() path: %s ct: %y %y score: %d (regex: %y)\n", hdr.path, hdr."content-type", hi.name,
            #    scr, hi.isregex);
            if (scr > score) {
                rv = hi;
                score = scr;
                if (scr == 3)
                    break;
            }
        }
        return rv;
    }

    bool empty() {
        return handlers.empty();
    }

    int size() {
        return handlers.size();
    }
}

# class containing dynamic handler info
class DynamicHandlerInfo inherits HandlerInfo {
    public {
        WaitGroup counter();
    }

    constructor(string name, hash<HttpHandlerConfigInfo> info) : HandlerInfo(name, info) {
    }
}

# maintains the request count for dynamic handlers (private)
class DynamicHandlerHelper {
    public {}

    private {
        WaitGroup c;
    }

    constructor(WaitGroup n_c) {
        c = n_c;
        c.add();
    }

    destructor() {
        c.done();
    }
}

# for dynamic handler-handling (private)
class DynamicHttpHandlerList inherits HttpHandlerList {
    private {
        RWLock dhl();

        # issue #4173: allow dynamic handlers to be disabled before being removed
        hash<string, bool> disable_map;
    }

    #! sets a dynamic request handler according to the arguments given
    setHandler(string name, hash<HttpHandlerConfigInfo> info) {
        # paths are passed without the leading "/", so they have to be like this in the treemap
        if (info.path =~ /^\//) {
            info.path = info.path.substr(1);
        }
        # for backwards-compatibility, isregex = True if not set
        if (!exists info.isregex) {
            info.isregex = True;
        }

        DynamicHandlerInfo dhi(name, info);

        {
            dhl.writeLock();
            on_exit dhl.writeUnlock();

            if (handlers{name}) {
                throw "SETHANDLER-ERROR", sprintf("dynamic HTTP request handler %y already exists (dynamic "
                    "handlers: %y)", name, keys handlers);
            }

            handlers{name} = dhi;
        }

        if (!info.isregex && info.path) {
            treeMap.put(info.path, dhi);
        }
    }

    #! remove dynamic handler
    /** @throw REMOVEHANDLER-ERROR if the given dynamic handler does not exist
    */
    removeHandler(string name, *bool force_immediate) {
        WaitGroup c;
        {
            # grab exclusive lock
            dhl.writeLock();
            on_exit dhl.writeUnlock();

            # if no such handler exists, throw an exception
            if (!handlers{name}) {
                throw "REMOVEHANDLER-ERROR", sprintf("dynamic request handler %y does not exist", name);
            }

            # remove the handler from the list
            DynamicHandlerInfo dhi = remove handlers{name};

            # remove handler from treemap if applicable
            if (!dhi.isregex && exists dhi.path)
                treeMap.take(dhi.path);

            # take a copy of a reference to the WaitGroup
            c = dhi.counter;

            # stop handler if it is a dedicated socket handler
            dhi.stop();

            # issue #4173: remove disabled entry, if any
            remove disable_map{name};
        }

        # wait for the call counter to reach zero
        if (!force_immediate) {
            c.wait();
        }
    }

    #! Disable dynamic handler
    /** @throw DISABLEHANDLER-ERROR if the given dynamic handler does not exist
    */
    disableHandler(string name) {
        # grab exclusive lock
        dhl.writeLock();
        on_exit dhl.writeUnlock();

        # if no such handler exists, throw an exception
        if (!handlers{name}) {
            throw "DISABLEHANDLER-ERROR", sprintf("dynamic request handler %y does not exist", name);
        }

        disable_map{name} = True;
    }

    *DynamicHandlerInfo findHandler(hash<auto> hdr, reference<int> score, reference<DynamicHandlerHelper> dhh,
            *reference<string> root_path) {
        dhl.readLock();
        on_exit dhl.readUnlock();

        *DynamicHandlerInfo h = HttpHandlerList::findHandler(hdr, \score, False, \root_path);
        if (!h || disable_map{h.name}) {
            return;
        }

        dhh = new DynamicHandlerHelper(h.counter);
        return h;
    }
}

class HttpServerCallbackAppender inherits LoggerAppenderWithLayout {
    private {
        code logfunc;
    }

    constructor(code logfunc) : LoggerAppenderWithLayout("HttpServer", new LoggerLayoutPattern("%d T%t [%p]: %m")) {
        self.logfunc = logfunc;
        open();
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
                call_function(logfunc, params);
                break;
        }
    }
}

#! Native async target implementing HttpAsyncTarget for the callback-based HttpAsyncSocketIoController
/** Request dispatch uses a two-path model:
    -# @ref tryInlineRequest() runs on the I/O callback thread for lightweight requests
       (HTTP/1.x only, no body, handler opts in via @ref AbstractHttpRequestHandler::canHandleInline()
       "canHandleInline()"); returns the response immediately without a thread hop
    -# If @ref tryInlineRequest() returns @ref nothing, the request is dispatched to the
       handler thread pool via @ref onHttpRequest() which calls
       HttpListener::processNativeRequest() for full context setup, body reading, and handler
       dispatch

    @since HttpServer 1.6
    @private
*/
class HttpServerNativeAsyncTarget inherits HttpServerAsyncIo::HttpAsyncTarget {
    private {
        #! Logger interface
        *LoggerInterface logger;
    }

    #! Creates the native async target
    /** @param logger optional logger interface
    */
    constructor(*LoggerInterface logger) {
        self.logger = logger;
    }

    #! Attempts to handle a request inline in the I/O thread
    /** Looks up the handler and, if it supports inline processing and the request
        has no body, processes it directly without thread pool dispatch.

        Only for HTTP/1.x — HTTP/2 and HTTP/3 always return @ref nothing. Requests with a
        body (Content-Length or Transfer-Encoding) are rejected because the inline
        path does not read the body; unread bytes would corrupt the next header
        parse on keep-alive connections.

        @param info connection and request information
        @return result hash if handled inline, or @ref nothing to dispatch to thread pool

        @since HttpServer 1.6
    */
    *hash<HttpServerAsyncIo::HttpRequestResultInfo> tryInlineRequest(
            hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        # Only for HTTP/1.x — HTTP/2 and HTTP/3 always use thread pool
        if (info.header_info.http2 || info.header_info.http3) {
            return NOTHING;
        }
        # Reject requests with a body — the inline path does not read the body
        if (info.hdr."content-length" || info.hdr."transfer-encoding") {
            return NOTHING;
        }
        HttpListener listener = cast<HttpListener>(info.listener);
        *AbstractHttpRequestHandler handler = listener.findHandlerForInlineCheck(info.hdr);
        if (!handler || !handler.canHandleInline(info.cx, info.hdr)) {
            return NOTHING;
        }
        return listener.processInlineRequest(info.sock, info.cx, info.hdr, handler, info.header_info);
    }

    #! Called when an HTTP request is ready (header fully parsed)
    /** Dispatches the request to HttpListener.processNativeRequest() which handles
        context setup, request processing, and returns response data for the controller
        to send.

        @param info connection and request information
        @return instructions for connection handling including response data
    */
    hash<HttpServerAsyncIo::HttpRequestResultInfo> onHttpRequest(hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        HttpListener listener = cast<HttpListener>(info.listener);
        # Full path — build proper connection context using the listener's template
        # The controller's cx only has "peer" and "socket" keys; the listener's
        # getContextTemplate() builds the full context with "peer-info", "id",
        # "ssl", "listener-id", "listener-name", "async_ctrl"
        hash<auto> cx = listener.getContextTemplate(info.cx.peer);
        return listener.processNativeRequest(info.sock, cx, info.hdr, info.header_info);
    }

    #! Called when an idle connection times out
    /** Closes the socket when the keep-alive TTL expires.

        @param sock the socket that timed out
        @param listener the listener that accepted this connection
        @param cx connection context
    */
    onIdleTimeout(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        log(LoggerLevel::DEBUG, "idle timeout for connection %y", sock.uniqueHash());
        try {
            sock.close();
        } catch () {
            # Ignore close errors
        }
    }

    #! Called on I/O errors
    /** Logs the error and closes the socket.

        @param sock the socket where the error occurred
        @param ex exception information
        @param listener the listener for this connection
        @param cx connection context
    */
    onError(Socket sock, hash<ExceptionInfo> ex, *HttpServer::HttpListenerInterface listener, *hash<auto> cx) {
        log(LoggerLevel::ERROR, "async I/O error for %y: %s: %s", sock.uniqueHash(), ex.err, ex.desc);
        try {
            sock.close();
        } catch () {
            # Ignore close errors
        }
    }

    #! Called when an SSE client disconnects
    /** Closes the socket.

        @param sock the socket that disconnected
        @param listener the listener for this connection
        @param cx connection context
    */
    onSseDisconnect(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        log(LoggerLevel::DEBUG, "SSE disconnect for %y", sock.uniqueHash());
        try {
            sock.close();
        } catch () {
            # Ignore close errors
        }
    }

    #! Called when a WebSocket frame is received
    /** Not used in the current HttpServer flow - WebSocket connections are managed
        by dedicated handler threads, not by the async I/O controller.
    */
    onWebSocketFrame(Socket sock, hash<HttpServerAsyncIo::WebSocketFrameInfo> frame,
            *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        # WebSocket frames are handled by dedicated handler threads
    }

    #! Called when a WebSocket connection closes
    /** Closes the socket.

        @param sock the WebSocket socket
        @param code close status code
        @param reason close reason text
        @param listener the listener for this connection
        @param cx connection context
    */
    onWebSocketClose(Socket sock, int code, string reason, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        log(LoggerLevel::DEBUG, "WebSocket close for %y: code=%d reason=%y", sock.uniqueHash(), code, reason);
        try {
            sock.close();
        } catch () {
            # Ignore close errors
        }
    }

    #! Logs a message
    private log(int level, string fmt) {
        if (logger) {
            logger.log(level, vsprintf(fmt, argv));
        }
    }
}

#! Internal hashdecl for async response data
/** Used to capture response data for async sending instead of synchronous send.
    @private
*/
hashdecl HttpAsyncResponseInfo {
    #! HTTP status code
    int code;

    #! Response headers
    hash<auto> hdr;

    #! Response body (NOTHING if no body)
    *data body;

    #! InputStream for streaming response body (used for HTTP/2 streaming)
    /** When set, the body is read from this stream incrementally instead of
        being buffered in memory. Takes precedence over \c body for HTTP/2 responses.

        @since HttpServer 1.6
    */
    *InputStream input_stream;

    #! Whether this is a chunked response
    bool chunked = False;

    #! Whether to close the connection after sending
    bool close = False;

    #! Connection context (for keep-alive)
    hash<auto> cx;

    #! Listener reference
    HttpListener listener;

    #! callback for sending chunked response data where each callback return is one HTTP chunk
    /** @since HttpServer 1.6

        @see send_timeout
    */
    *code send_callback;

    #! timeout for send_callback responses
    /** @since HttpServer 1.6

        @see send_callback
    */
    *timeout send_timeout;

    #! Whether this is a streaming response already sent by the handler
    /** Set when a handler sends a streaming response (e.g., HTTP/3 SSE) directly
        via protocol-specific APIs and sets \c reply_sent in the response.
        The controller should not send a response — it just acknowledges and continues.

        @since HttpServer 1.6
    */
    bool streaming = False;

    #! The type of streaming connection: "sse" or "websocket"
    /** Only used when \c streaming is @ref True.

        @since HttpServer 1.6
    */
    *string stream_type;

    #! The poll operation for the streaming connection
    /** Only used when \c streaming is @ref True. Set to an
        @ref HttpServerAsyncIo::HttpSseStreamPollOperation for H1 SSE connections.

        @since HttpServer 1.7
    */
    *AbstractPollOperation stream_operation;
}
} # namespace Priv

namespace Priv {
#! Helper class for managing HTTP request lifecycle and thread counter tracking
/**
    This class manages the lifecycle of HTTP connections and ensures proper counter
    management for graceful server shutdown. It tracks two types of connections:

    1. **Normal connections (cThreads)**: Regular HTTP request/response connections
       that are handled by the thread pool and released after the response is sent.

    2. **Dedicated connections (dThreads)**: Long-lived connections like WebSocket
       or SSE that take over the socket for bidirectional communication.

    ## WaitGroup Management

    The server uses WaitGroups to track active connections so that shutdown can wait
    for all connections to complete. The flow is:

    1. When a request starts: `cThreads.add()` is called (before RequestHelper is created)
    2. RequestHelper stores a reference to cThreads in `c`
    3. If the connection becomes dedicated (WebSocket/SSE):
       - `setDedicated()` is called: adds to dThreads, marks cThreads done, switches `c` to dThreads
    4. When RequestHelper is destroyed: `c.done()` decrements the appropriate WaitGroup

    ## Dedicated External Mode

    When a handler takes full control of the socket (e.g., WebSocket handler returns True
    from start()), `setDedicatedExternal()` is called. This:
    - Sets `dedicated_external = True` so the destructor won't close the socket
    - The handler is responsible for socket cleanup
    - The WaitGroup is still decremented in the destructor

    ## Important: WaitGroup Balance

    The WaitGroup add() happens BEFORE RequestHelper is created (in processNativeRequest
    or similar). The done() happens in the destructor. This ensures:
    - Every add() has a matching done()
    - Server shutdown can wait for all WaitGroups to reach zero

    @see HttpListener::cThreads
    @see HttpListener::dThreads
*/
class RequestHelper {
    private {
        #! WaitGroup for normal connection threads (decremented if we stay in normal mode)
        WaitGroup cThreads;
        #! WaitGroup for dedicated connection threads (decremented if we switch to dedicated mode)
        WaitGroup dThreads;
        #! Reference to the active WaitGroup (either cThreads or dThreads) - decremented in destructor
        WaitGroup c;
        #! Socket to manage (may be null for async connections where socket is managed elsewhere)
        Socket s;
        #! If True, socket is managed externally (e.g., by WebSocket handler) and won't be closed in destructor
        bool dedicated_external = False;
    }

    /**
        @param cThreads the counter for normal connection threads
        @param dThreads the counter for dedicated connection threads (WebSocket, SSE)
        @param s optional socket to manage (not passed for async connections where socket lifecycle
               is managed by the async I/O controller)

        @note The caller must have already called cThreads.add() before creating this object.
              The destructor will call c.done() to balance this.
    */
    constructor(WaitGroup cThreads, WaitGroup dThreads, *Socket s) {
        @assert(cThreads.getCount() > 0, "cThreads must be incremented before creating RequestHelper");
        self.cThreads = cThreads;
        self.dThreads = dThreads;
        c = cThreads;
        if (s) {
            self.s = s;
        }
    }

    #! Destructor ensures counter is decremented and socket is cleaned up if needed
    /**
        - If not dedicated_external and socket exists and is open: shutdown and close the socket
        - Always decrements the active counter (c) to signal this connection is complete

        This allows HttpListener::stop() to wait for all connections to finish via
        cThreads.wait() and dThreads.wait().

        @note We check isOpen() to avoid double-close if the socket was already closed
        (e.g., by handlePersistentConnectionSync())
    */
    destructor() {
        if (s && !dedicated_external && s.isOpen()) {
            try {
                s.shutdown();
                s.close();
            } catch () {
                # Ignore close errors - socket may already be in error state
            }
        }
        c.done();
    }

    #! Switches from normal connection mode to dedicated connection mode
    /**
        Called when a connection is upgraded to a dedicated socket handler (WebSocket, SSE).
        This transfers the counter tracking from cThreads to dThreads so that:
        - Normal requests can complete (cThreads reaches zero)
        - Dedicated connections are tracked separately (dThreads)
        - Server shutdown waits for dedicated connections after normal connections

        @note Must only be called once, when c === cThreads (asserted)
    */
    setDedicated() {
        @assert(c === cThreads);
        dThreads.add();
        cThreads.done();
        c = dThreads;
    }

    #! Marks this connection as dedicated and externally managed
    /**
        Called when a dedicated socket handler (e.g., WebSocket) takes full control
        of the connection and will manage the socket lifecycle itself.

        This method:
        1. Switches to dedicated mode if not already (handles race where setDedicated()
           may have been called first in registerDedicatedSocket)
        2. Sets dedicated_external = True so destructor won't close the socket

        The handler that called this is responsible for:
        - Closing the socket when done
        - The connection counter is still decremented in destructor

        @note This fixes a bug where calling setDedicatedExternal() after setDedicated()
              would double-increment dThreads. The check `c === cThreads` prevents this.
    */
    setDedicatedExternal() {
        # Only adjust counters if not already in dedicated mode
        # (setDedicated() may have been called first in registerDedicatedSocket)
        if (c === cThreads) {
            dThreads.add();
            cThreads.done();
            c = dThreads;
        }
        dedicated_external = True;
    }

    #! Returns True if this connection is in dedicated mode (WebSocket, SSE)
    /**
        @return True if setDedicated() or setDedicatedExternal() was called

        @note This returns True for BOTH internally and externally managed dedicated connections.
              To check specifically for external management, use isDedicatedExternal().
              When checking shutdown behavior, isDedicatedExternal() is usually what you want.
    */
    bool isDedicated() {
        return c === dThreads;
    }

    #! Returns True if the socket is managed externally by the dedicated handler
    /**
        @return True if setDedicatedExternal() was called

        @note If this returns True, isDedicated() also returns True.
              This method specifically indicates the socket won't be closed by the destructor.
    */
    bool isDedicatedExternal() {
        return dedicated_external;
    }
}
}
