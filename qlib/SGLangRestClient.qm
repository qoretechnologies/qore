# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires OpenAiRestClient
%requires QoreLlmTypes
%requires QoreRagTypes

module SGLangRestClient {
    version = "1.0";
    desc = "user module for calling SGLang REST API services";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("sglang", SGLangRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(new SGLangLlmProviderFactory());
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new QoreRagUtils::SGLangEmbedderFactory());
    };
}

/** @mainpage SGLangRestClient Module

    @tableofcontents

    @section sglangrestclientintro SGLangRestClient Introduction

    The %SGLangRestClient module provides an API for calling SGLang REST API services.
    SGLang (<https://github.com/sgl-project/sglang>) is a fast serving framework for
    large language models and vision language models; it exposes an OpenAI-compatible
    HTTP API at `/v1/*` plus SGLang-native endpoints for constrained decoding
    (<tt>/generate</tt>), server introspection (<tt>/get_server_info</tt>), and cache
    management (<tt>/flush_cache</tt>).

    To use this module, use \c "%requires SGLangRestClient" in your code.

    All the public symbols in the module are defined in the SGLangRestClient namespace.

    Each SGLang server instance serves exactly one model; the \c model must be
    configured on the connection and is enforced via the connection scheme's
    \c required_options.  The configured model is exposed at runtime via
    @ref SGLangRestClient::SGLangRestClientBase::getModel() "getModel()".

    The main classes are:
    - @ref SGLangRestClient::SGLangRestClient "SGLangRestClient":
      synchronous REST client for SGLang servers
    - @ref SGLangRestClient::SGLangRestClientIo "SGLangRestClientIo":
      async-I/O REST client for SGLang servers using multiplexed HTTP/1.1
      and HTTP/2 connections
    - @ref SGLangRestClient::SGLangRestConnection "SGLangRestConnection":
      provides a REST connection object to SGLang services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires SGLangRestClient
%requires ConnectionProvider

SGLangRestClient rest({
    "url": "http://localhost:30000",
    "model": "qwen3-30b-a3b",
});
hash<auto> ans = rest.post("/v1/chat/completions", {
    "model": rest.getModel(),
    "messages": ({"role": "user", "content": "Hello!"},),
});
printf("%Y\n", ans.body);
    @endcode

    @section SGLangRestClientRelnotes Release Notes

    @subsection SGLangRestClientv1_0 SGLangRestClient v1.0
    - the initial version of the %SGLangRestClient module
*/

#! the SGLangRestClient namespace contains all the objects in the SGLangRestClient module
public namespace SGLangRestClient {
#! Common base class for SGLangRestClient functionality
public class SGLangRestClientBase {
    public {
        #! Default SGLang server URL
        const DefaultUrl = "http://localhost:30000";

        #! Default SGLang OpenAI-compatible API version segment
        const DefaultApiVersion = "v1";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "data": "json",
        };

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path — lightweight native endpoint, no body required
        const DefaultPingPath = "/get_server_info";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Native SGLang constrained-decoding endpoint path
        const GenerateEndpoint = "/generate";

        #! Native SGLang server info endpoint path
        const ServerInfoEndpoint = "/get_server_info";

        #! Native SGLang cache flush endpoint path
        const FlushCacheEndpoint = "/flush_cache";
    }

    private {
        #! Model name configured for this connection (required)
        string model_name;
    }

    #! returns options for the constructor
    /** Applies SGLang defaults, sets the REST default_path from the \c api option,
        ensures \c Accept is \c application/json, maps \c apikey to an
        \c Authorization: \c Bearer header, and strips the SGLang-specific
        options that would otherwise be rejected by the underlying REST client.
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto!> rv = DefaultOptions + opts;
        # set default_path for RestClientIo (uses this instead of setConnectionPath)
        if (!rv.default_path) {
            rv.default_path = "/" + (opts.api ?? DefaultApiVersion);
        }
        # ensure Accept header is JSON (RestClientIo ignores the "data" option)
        if (!rv.headers."Accept") {
            rv.headers."Accept" = MimeTypeJson;
        }
        # map apikey (production-auth deployments) to Authorization: Bearer header
        if (rv.apikey) {
            rv.headers."Authorization" = "Bearer " + rv.apikey;
            remove rv.apikey;
        }
        # model is an SGLang-specific option; strip it from REST client options
        # (captured separately by the subclass constructor into model_name)
        remove rv.model;
        return rv;
    }

    #! Returns the model name configured on this connection
    /** @return the model name

        @note SGLang serves exactly one model per instance; the model is
        configured on the connection and is not passed per-request by the
        SGLang server itself — callers still typically pass it in
        OpenAI-compatible request bodies for compatibility with the wire
        format.
    */
    string getModel() {
        return model_name;
    }

    #! Validates and captures the required model option
    /** Called by subclass constructors after the underlying REST client has
        initialized so that the belt-and-braces check surfaces a clear error
        if the caller bypassed the connection layer (which normally enforces
        \c model via \c required_options).

        @throw SGLANG-OPTION-ERROR if the required \c model option is missing or empty
    */
    private initModel(hash<auto> opts) {
        if (!opts.model.val()) {
            throw "SGLANG-OPTION-ERROR",
                "required 'model' option is missing from SGLangRestClient options";
        }
        model_name = opts.model;
    }
}

#! this class provides the REST client API for communication with SGLang servers
/** A \c model option is required; it names the model served by the target
    SGLang instance and is exposed via @ref SGLangRestClientBase::getModel()
    "getModel()".  If the target deployment requires authentication, pass an
    \c apikey; it will be sent as the \c Authorization: \c Bearer header.
*/
public class SGLangRestClient inherits RestClient::RestClient, SGLangRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
SGLangRestClient rest({"url": "http://localhost:30000", "model": "qwen3-30b-a3b"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c model (required): name of the model served by the target SGLang instance
        - \c apikey (optional): API key for deployments with authentication enabled
        - \c api (optional): OpenAI-compatible API version segment (default \c "v1")
        @param do_not_connect if \c False (the default), then a connection is returned already connected to the
        remote server

        @throw SGLANG-OPTION-ERROR if the required \c model option is missing
        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(SGLangRestClientBase::getOptions(opts), True) {
        initModel(opts);
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(opts.api.val() ? string(opts.api) : DefaultApiVersion);
        }
    }
}

#! Class for SGLang REST connections; returns @ref SGLangRestClient objects
public class SGLangRestConnection inherits RestClient::RestConnection {
    public {
        #! Default SGLang REST connection URL
        const DefaultUrl = "sglang://localhost:30000";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "SGLang REST Connection",
            "short_desc": "A connection to an SGLang model server",
            "desc": "A connection to an [SGLang](https://github.com/sgl-project/sglang) "
                "model server.\n\n"
                "SGLang exposes an OpenAI-compatible API at `/v1/*` plus SGLang-native "
                "endpoints (`/generate` for constrained decoding, `/get_server_info`, "
                "`/flush_cache`).\n\n"
                "The target instance serves exactly one model; the `model` option is "
                "required.  If the deployment requires authentication, set `apikey`.\n\n"
                "The connection uses the `sglang://` URL scheme.",
            "cls": Class::forName("SGLangRestConnection"),
            "auto_url": True,
            "schemes": {
                "sglang": True,
            },
            # AbstractConnection::getRealUrl() reverses this map (value -> key) to resolve
            # the "sglang://" URL to a real transport; mapping BOTH "http" and "https" to
            # the single "sglang" scheme made that reverse lookup ambiguous, and hash
            # last-wins resolved "sglang" -> "https", so the connection ping did an
            # SSL_connect() against the plain-HTTP SGLang server ("packet length too long")
            # and reported the connection down.  SGLang serves plain HTTP (and the embedder
            # normalizes sglang:// -> http://), so map the single scheme to http only.
            "base_scheme_map": {
                "http": "sglang",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "model": <ConnectionOptionInfo>{
                    "display_name": "Model Name",
                    "short_desc": "The model served by the target SGLang instance",
                    "type": "string",
                    "desc": "The model name served by the target SGLang instance; SGLang "
                        "serves exactly one model per server, so the connection captures "
                        "it here.  Used by client code (e.g. via `getModel()`) to populate "
                        "the `model` field of OpenAI-compatible request bodies.",
                    "preselected": True,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "API key for SGLang servers with authentication enabled",
                    "type": "string",
                    "desc": "Optional API key for SGLang deployments that enable "
                        "authentication; sent as the `Authorization: Bearer` header.  "
                        "Local inference deployments typically do not require a key.",
                    "sensitive": True,
                },
                "api": <ConnectionOptionInfo>{
                    "display_name": "OpenAI-Compatible API Version",
                    "short_desc": "The OpenAI-compatible API version segment",
                    "desc": "The OpenAI-compatible API version segment used for "
                        "`/v1/*` routing.  Defaults to `v1`; SGLang currently exposes "
                        "only `v1` but this option allows forward compatibility.",
                    "type": "string",
                    "default_value": SGLangRestClientBase::DefaultApiVersion,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": SGLangRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": SGLangRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": SGLangRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "model",
        };
    }

    #! creates the SGLangRestConnection object
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the SGLangRestConnection object from a config hash
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! returns \c "sglang"
    string getType() {
        return "sglang";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the SGLangDataProvider and creates the data provider
        # object dynamically
        load_module("SGLangDataProvider");
        return create_object("SGLangDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! returns an @ref SGLangRestClient object
    private SGLangRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new SGLangRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new SGLangRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for SGLang servers using multiplexed HTTP connections
/** Identical surface to @ref SGLangRestClient but backed by the async I/O
    stack in @ref RestClientIo::RestClientIo; the \c model option is required
    and captured via @ref SGLangRestClientBase::getModel() "getModel()".
*/
public class SGLangRestClientIo inherits RestClientIo::RestClientIo, SGLangRestClientBase {
    #! Creates the object with the given options
    /** @param opts valid options are all the options for the
        @ref RestClientIo::RestClientIo "RestClientIo" class plus:
        - \c model (required): name of the model served by the target SGLang instance
        - \c apikey (optional): API key for deployments with authentication enabled
        - \c api (optional): OpenAI-compatible API version segment (default \c "v1")
        @param shared_mgr optional shared HTTP client connection manager

        @throw SGLANG-OPTION-ERROR if the required \c model option is missing
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(SGLangRestClientBase::getOptions(opts), shared_mgr) {
        initModel(opts);
    }
}

#! LLM provider for SGLang servers
/** SGLang exposes an OpenAI-compatible chat-completions endpoint, so this
    provider reuses @ref OpenAiRestClient::OpenAiLlmProvider for body
    construction, response parsing, and streaming.  Only the mode string
    differs so the @ref QoreLlmUtils::LlmProviderRegistry can route
    \c mode=sglang requests through this class.
*/
public class SGLangLlmProvider inherits OpenAiRestClient::OpenAiLlmProvider {
    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : OpenAiRestClient::OpenAiLlmProvider(config) {
    }

    string getMode() {
        return "sglang";
    }
}

#! Factory for @ref SGLangLlmProvider
public class SGLangLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "sglang";
    }

    string getDisplayName() {
        return "SGLang OpenAI-compatible chat completions";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new SGLangLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
        };
    }
}
}

public namespace QoreRagUtils {
#! SGLang-backed embedder — calls the SGLang OpenAI-compatible \c /v1/embeddings endpoint
/** Wraps @ref SGLangRestClient::SGLangRestClientIo "SGLangRestClientIo"
    which captures the \c model at construction time (SGLang serves exactly
    one model per instance).

    The configured URL may also point at a dedicated bge-m3 sidecar that
    serves the native \c /embed endpoint instead of \c /v1/embeddings; the
    embedder auto-detects which style the server speaks on the first
    \ref encodeBatch() call (a 404 from \c /v1/embeddings switches to
    \c /embed) and pins the result for the lifetime of the embedder.

    @par Permanent vs transient errors

    A 404 from \c /v1/embeddings is treated as "wrong endpoint, try the native
    fallback" and is not a permanent model error.  A 400 from
    \c /v1/embeddings — typical when a chat model is loaded without embedding
    support — is classified by @ref isPermanentEmbedderConfigError() and
    rethrown as @c EMBEDDER-MODEL-CONFIG-ERROR; the embedder does not fall
    back to \c /embed in that case.

    @par Configuration

    - \c model (required): the model name served by the target SGLang instance
    - \c url (optional): SGLang server URL, default \c "http://localhost:30000"
    - \c api_key (optional): bearer token for SGLang deployments with
      authentication enabled
    - \c dimension (optional): cached dimension; when unset the dimension is
      auto-detected on first call
    - \c timeout (optional): default request timeout (per-call \c opts override
      takes precedence)
    - \c connect_timeout (optional): default connection timeout (per-call
      \c opts override takes precedence)
*/
public class SGLangEmbedder inherits AbstractEmbedder {
    public {
        const DefaultUrl = "http://localhost:30000";
        const StyleOpenAi = "openai";
        const StyleNative = "native";
        const Backend = "sglang";
    }

    private {
        hash<EmbedderConfig> config;
        string model_name;
        *SGLangRestClient::SGLangRestClientIo rest_client;
        *int cached_dimension;
        *string endpoint_style;
        Mutex init_mutex();
    }

    constructor(hash<EmbedderConfig> config) {
        if (!config.model.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "SGLangEmbedder requires 'model' in EmbedderConfig "
                "(SGLang serves exactly one model per instance)";
        }
        self.config = config;
        model_name = config.model;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }
        # asymmetric / instruction-tuned models (e.g. Qwen3-Embedding): prepend the
        # role-specific instruction.  encodeQuery()/encodeDocuments() set input_type;
        # symmetric callers leave it unset, so no prefix is applied (backward compatible).
        *string instr = (opts.input_type == "query")
            ? config.query_instruction
            : ((opts.input_type == "document") ? config.document_instruction : NOTHING);
        list<string> in_texts = texts;
        if (instr.val()) {
            in_texts = ();
            foreach string t in (texts) {
                push in_texts, instr + t;
            }
        }

        SGLangRestClient::SGLangRestClientIo client = pickRestClient(opts);
        list<list<float>> raw = encodeRaw(client, in_texts);

        # client-side Matryoshka (MRL) reduction to the configured output dimension
        # when the model emits a larger native vector (SGLang has no server-side
        # 'dimensions' param); getDimension() already reports config.dimension
        if (config.dimension && raw && raw[0].size() > config.dimension) {
            list<list<float>> truncated = ();
            foreach list<float> v in (raw) {
                push truncated, truncateAndRenormalize(v, config.dimension);
            }
            return truncated;
        }
        return raw;
    }

    #! Issues the SGLang embedding request (OpenAI-compat or native endpoint, auto-detected)
    private list<list<float>> encodeRaw(
            SGLangRestClient::SGLangRestClientIo client, list<string> texts) {
        switch (endpoint_style) {
            case StyleOpenAi:
                return encodeBatchOpenAi(client, texts);
            case StyleNative:
                return encodeBatchNative(client, texts);
        }

        try {
            list<list<float>> rv = encodeBatchOpenAi(client, texts);
            pinEndpointStyle(StyleOpenAi);
            return rv;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "REST-RESPONSE-ERROR" && ex.arg.status_code == 404) {
                # try the native endpoint
            } else if (ex.err == "REST-RESPONSE-ERROR"
                    && isPermanentEmbedderConfigError(ex)) {
                throwEmbedderModelConfigError(ex, Backend, model_name);
            } else {
                rethrow;
            }
        }
        list<list<float>> rv = encodeBatchNative(client, texts);
        pinEndpointStyle(StyleNative);
        return rv;
    }

    *string getEndpointStyle() {
        return endpoint_style;
    }

    private list<list<float>> encodeBatchOpenAi(
            SGLangRestClient::SGLangRestClientIo client, list<string> texts) {
        hash<auto> body = {
            "model": model_name,
            "input": texts,
        };
        hash<auto> resp = client.restPost("/v1/embeddings", body);

        *list<auto> data = resp.body.data;
        if (!exists data) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: /v1/embeddings response missing 'data' field", Backend),
                {"body": resp.body};
        }
        if (data.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: /v1/embeddings returned %d items for %d input texts",
                    Backend, data.size(), texts.size()),
                {"body": resp.body};
        }
        list<hash<auto>> sorted_data = sort(cast<list<hash<auto>>>(data),
            int sub(hash<auto> a, hash<auto> b) {
                return a."index" <=> b."index";
            });

        list<list<float>> result = ();
        foreach hash<auto> item in (sorted_data) {
            list<float> vec = validateAndCastVector(item.embedding, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = vec.size();
            }
            push result, vec;
        }
        return result;
    }

    private list<list<float>> encodeBatchNative(
            SGLangRestClient::SGLangRestClientIo client, list<string> texts) {
        hash<auto> body = {"texts": texts};
        hash<auto> resp = client.restPost("/embed", body);

        *list<auto> vectors = resp.body.dense ?? resp.body.embeddings;
        if (!exists vectors) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: /embed response missing 'dense'/'embeddings' vector data",
                    Backend),
                {"body": resp.body};
        }
        if (vectors.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: /embed returned %d vectors for %d input texts",
                    Backend, vectors.size(), texts.size()),
                {"body": resp.body};
        }

        list<list<float>> result = ();
        foreach auto vec in (vectors) {
            list<float> typed = validateAndCastVector(vec, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = typed.size();
            }
            push result, typed;
        }
        return result;
    }

    private pinEndpointStyle(string style) {
        init_mutex.lock();
        on_exit init_mutex.unlock();
        if (!endpoint_style) {
            endpoint_style = style;
        }
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    *string getModel() {
        ensureRestClient();
        return rest_client.getModel();
    }

    private bool isPermanentEmbedderConfigError(hash<ExceptionInfo> ex) {
        *int status_code = ex.arg.status_code;
        if (status_code != 400 && status_code != 404) {
            return False;
        }
        auto body = ex.arg.body;
        *string error_type = body.object;
        if (error_type == "error") {
            # SGLang OpenAI-compat error envelope: treat as permanent only
            # if the message is model-related (checked below)
        }
        *string message = body.message ?? body.error.message ?? body.detail ?? body.error;
        if (!exists message && body.typeCode() == NT_STRING) {
            message = body;
        }
        if (!exists message) {
            return False;
        }
        string lower = message.lwr();
        return lower.find("is not an embedding") != -1
            || lower.find("does not appear to be an embedding") != -1
            || lower.find("does not support embeddings") != -1
            || lower.find("not an embedding model") != -1
            || lower.find("unsupported model") != -1
            || lower.find("invalid model") != -1
            || lower.find("model not found") != -1;
    }

    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response item missing embedding vector", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    private SGLangRestClient::SGLangRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            SGLangRestClient::SGLangRestClientIo per_call =
                new SGLangRestClient::SGLangRestClientIo(
                    buildRestOptions(opts.timeout, opts.connect_timeout));
            per_call.clearConnectionPath();
            return per_call;
        }
        ensureRestClient();
        return rest_client;
    }

    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "url": config.url ?? DefaultUrl,
            "model": model_name,
        };
        if (config.api_key.val()) {
            opts.apikey = config.api_key;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new SGLangRestClient::SGLangRestClientIo(buildRestOptions());
                rest_client.clearConnectionPath();
            }
        }
    }
}

#! Factory for @ref SGLangEmbedder
public class SGLangEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "sglang";
    }

    string getDisplayName() {
        return "SGLang embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new SGLangEmbedder(config);
    }
}
}
