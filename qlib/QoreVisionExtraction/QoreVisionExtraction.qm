# minimum required Qore version
%requires qore >= 2.0
%modern

%try-module RestClient
%define NoRestClient
%endtry

%try-module json
%define NoJson
%endtry

module QoreVisionExtraction {
    version = "1.0.0";
    desc = "user module providing multimodal LLM vision extraction for "
        "image description, table extraction, and text extraction from images";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreVisionExtraction Module

    @tableofcontents

    @section qorevisionextractionintro QoreVisionExtraction Module Introduction

    The %QoreVisionExtraction module provides multimodal LLM calls for
    extracting information from images.  It sends images as base64-encoded
    content blocks to vision-capable LLMs (OpenAI GPT-4o, Anthropic Claude)
    and returns extracted text, descriptions, or markdown tables.

    @par Example: Describe an image
    @code{.py}
%requires QoreVisionExtraction

VisionLlmClient client(<VisionLlmConfig>{
    "mode": "openai",
    "url": "https://api.openai.com",
    "model": "gpt-4o",
    "api_key": ENV.OPENAI_API_KEY,
});
binary img = ReadOnlyFile::readBinaryFile("chart.png");
hash<VisionExtractionResult> result = client.describeImage(img, "image/png");
printf("Description: %s\n", result.text);
    @endcode

    @section qorevisionextractionrelnotes QoreVisionExtraction Module Release Notes

    @subsection qorevisionextraction_1_0 QoreVisionExtraction Module Version 1.0
    - Initial release with @ref QoreVisionExtraction::VisionLlmClient "VisionLlmClient"
      supporting OpenAI and Anthropic multimodal APIs
*/
