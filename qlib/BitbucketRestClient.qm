# minimum qore version
%requires qore >= 2.0

# assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module BitbucketRestClient {
    version = "1.0";
    desc = "User module for calling Bitbucket Cloud REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("bitbucket", BitbucketRestConnection::ConnectionScheme);
    };
}

/** @mainpage BitbucketRestClient Module

    @tableofcontents

    @section bitbucketrestclientintro BitbucketRestClient Introduction

    The %BitbucketRestClient module provides an API for calling
    [Bitbucket Cloud](https://bitbucket.org)'s REST API services.

    To use this module, use \c "%requires BitbucketRestClient" in your code.

    All the public symbols in the module are defined in the BitbucketRestClient namespace.

    The main classes are:
    - @ref BitbucketRestClient::BitbucketRestClient "BitbucketRestClient": the REST client for the
      Bitbucket API
    - @ref BitbucketRestClient::BitbucketRestClientIo "BitbucketRestClientIo": the same client on the
      asynchronous I/O transport, which is what data providers use
    - @ref BitbucketRestClient::BitbucketRestConnection "BitbucketRestConnection": a connection object to
      Bitbucket (based on the @ref connectionproviderintro "ConnectionProvider" module)

    @note This module targets **Bitbucket Cloud**.  Bitbucket Data Center is a different product with a
    different API (\c /rest/api/1.0 rather than \c /2.0) and is not supported here.

    @section bitbucketrestclient_auth Authentication

    Bitbucket Cloud accepts three credentials, and this module supports all of them:

    |!Credential|!Set|!Notes
    |An access token|\c token|A repository, project or workspace access token, or an OAuth2 access token; sent as a bearer token. The narrowest option, and the one to prefer
    |An app password|\c username and \c password|Sent as HTTP basic authentication. The username is the **Atlassian account username**, not the email address
    |The OAuth2 authorization code flow|\c oauth2_client_id and \c oauth2_client_secret|From an OAuth consumer created in workspace settings; this is what an interactive integration uses

    The application this module was written for supported only the OAuth2 flow, which forces a workspace
    administrator to create a consumer before a script can read one repository.  An access token needs no
    consumer and can be scoped to a single repository.

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires BitbucketRestClient

BitbucketRestClientIo bb({"token": ENV.BITBUCKET_TOKEN});
hash<auto> result = bb.get("/2.0/user");
printf("User: %Y\n", result.body);
    @endcode

    @section bitbucketrestclient_paths Paths Include the API Version

    Bitbucket's API description places \c /2.0 in its server URL rather than in its paths, so the client's
    URL is the bare host and a request path written by hand carries the version: \c "/2.0/user", not
    \c "/user".

    @section bitbucketrestclient_pagination Pagination

    Every Bitbucket collection is returned in the same envelope: the records are in \c values, \c pagelen
    is the page size, \c size is the total where Bitbucket can compute it, and \c next is the URL of the
    following page.  Page on the presence of \c next; \c size is absent for some collections and is never
    the thing to loop on.

    @section bitbucketrestclientrelnotes Release Notes

    @subsection bitbucketrestclientv1_0 BitbucketRestClient v1.0
    - the initial version of the %BitbucketRestClient module
*/

#! the BitbucketRestClient namespace contains all the objects in the BitbucketRestClient module
public namespace BitbucketRestClient {
#! Common base class for BitbucketRestClient functionality
public class BitbucketRestClientBase {
    public {
        #! The Bitbucket Cloud API host
        /** The API version lives in the path, not the host, because that is where Bitbucket's own
            description puts it: its \c servers entry is \c "https://api.bitbucket.org/2.0", so the
            schema's base path supplies \c "/2.0" and the client must not also carry it.
        */
        const DefaultUrl = "https://api.bitbucket.org";

        #! The API version prefix, as the schema's server URL declares it
        const ApiPrefix = "/2.0";

        #! Default OAuth2 authorization request URL
        const DefaultAuthUrl = "https://bitbucket.org/site/oauth2/authorize";

        #! Default OAuth2 token request URL
        const DefaultTokenUrl = "https://bitbucket.org/site/oauth2/access_token";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default OAuth2 scopes
        /** Empty: a Bitbucket OAuth consumer's scopes are configured on the consumer itself, and asking
            for them in the authorization request as well is rejected.
        */
        const DefaultScopes = ();

        #! Default data serialization
        const DefaultData = "json";

        #! Default authorization token type
        const DefaultTokenType = "Bearer";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path
        /** Reading the authenticated user is the cheapest call that proves the credential is accepted.
        */
        const DefaultPingPath = ApiPrefix + "/user";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Bitbucket's maximum page size for a collection
        const MaxPageLen = 100;

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "token_type": DefaultTokenType,
            "url": DefaultUrl,
        };
    }

    #! Returns options for the BitbucketRestClient constructors
    /** @param opts0 the caller's options

        @return the options to pass to the client constructor
    */
    static hash<auto> getOptions(*hash<auto> opts0) {
        # "auto!" because a caller's literal option hash whose values happen to share a type narrows to
        # that type, and adding a hash-valued or list-valued default would then throw at run time
        hash<auto!> opts = opts0 ?? {};

        # the OAuth2 endpoints are Bitbucket's own and are only meaningful when the flow is used at all
        if (opts.oauth2_client_id.val()) {
            if (!opts.oauth2_grant_type.val()) {
                opts.oauth2_grant_type = DefaultGrantType;
            }
            if (!opts.oauth2_auth_url.val()) {
                opts.oauth2_auth_url = DefaultAuthUrl;
            }
            if (!opts.oauth2_token_url.val()) {
                opts.oauth2_token_url = DefaultTokenUrl;
            }
        }

        # set defaults for options not already set
        map opts{$1.key} = $1.value, DefaultOptions.pairIterator(), !opts.hasKey($1.key);
        return opts;
    }
}

#! Bitbucket REST client
public class BitbucketRestClient inherits RestClient::RestClient, BitbucketRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options; see
        @ref BitbucketRestClient::BitbucketRestClientBase::getOptions() "getOptions()"
        @param do_not_connect if @ref False the object will immediately attempt to connect
    */
    constructor(*hash<auto> opts, *softbool do_not_connect)
            : RestClient(BitbucketRestClientBase::getOptions(opts), do_not_connect) {
    }
}

#! Bitbucket REST client for non-blocking I/O
public class BitbucketRestClientIo inherits RestClientIo::RestClientIo, BitbucketRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(*hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(BitbucketRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Bitbucket REST connections
public class BitbucketRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Bitbucket connection URL
        const DefaultConnectionUrl = "bitbucket://api.bitbucket.org";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Bitbucket REST Connection",
            "short_desc": "A connection to the Bitbucket Cloud REST API",
            "desc": "A connection to [Bitbucket Cloud](https://bitbucket.org) for repositories, commits, "
                "pull requests, deployments and code search.\n\n"
                "**Authentication** is any one of three credentials:\n"
                "- an **access token** in `token` - a repository, project or workspace access token, "
                "created under the relevant **Settings > Access tokens**. The narrowest option, and the "
                "one to prefer;\n"
                "- an **app password** in `username` and `password`, sent as basic authentication. The "
                "username is the Atlassian account username, **not** the email address;\n"
                "- the **OAuth2 authorization code flow**, with `oauth2_client_id` and "
                "`oauth2_client_secret` from an OAuth consumer created in workspace settings.\n\n"
                "This connection targets Bitbucket **Cloud**. Bitbucket Data Center is a different "
                "product with a different API and is not supported.\n\n"
                "Bitbucket is a trademark of Atlassian Pty Ltd.",
            "cls": Class::forName("BitbucketRestConnection"),
            "auto_url": True,
            "schemes": {
                "bitbucket": True,
            },
            "base_scheme_map": {
                "https": "bitbucket",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": BitbucketRestClientBase::DefaultData,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": BitbucketRestClientBase::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": BitbucketRestClientBase::DefaultGrantType,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": BitbucketRestClientBase::DefaultTokenUrl,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": BitbucketRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": BitbucketRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": BitbucketRestClientBase::DefaultPingPath,
                },
                "token": RestConnection::ConnectionScheme.options."token"
                + <ConnectionOptionInfo>{
                    "display_name": "Access Token",
                    "short_desc": "A Bitbucket repository, project or workspace access token",
                    "desc": "A Bitbucket access token, sent as a bearer token.\n\n"
                        "**To obtain one:** open the repository, project or workspace **Settings > "
                        "Access tokens**, create a token, and grant it only the scopes the integration "
                        "needs.\n\n"
                        "Leave this unset to authenticate with an app password or the OAuth2 flow "
                        "instead.",
                    
                    # deliberately NOT preselected: the platform supplies an OAuth2 client for this
                    # application, so the authorization flow is the default and an access token is the
                    # fallback.  A preselected token field puts "paste a credential here" at the top of the
                    # connection form, which is the opposite of what the flow being default means, and it is
                    # what the form showed before this was removed
                    "sensitive": True,
                },
                "token_type": RestConnection::ConnectionScheme.options."token_type"
                + <ConnectionOptionInfo>{
                    "default_value": BitbucketRestClientBase::DefaultTokenType,
                },
                "username": RestConnection::ConnectionScheme.options."username"
                + <ConnectionOptionInfo>{
                    "desc": "The Atlassian account username to use with an app password.\n\n"
                        "**Not** the email address: Bitbucket rejects an email address here. The username "
                        "is shown under **Personal settings > Account settings**.",
                },
                "password": RestConnection::ConnectionScheme.options."password"
                + <ConnectionOptionInfo>{
                    "desc": "An app password created under **Personal settings > App passwords**, used "
                        "with `username`.\n\n"
                        "This is not the account password, which Bitbucket does not accept for API "
                        "access.",
                },
            },
            # any one of the three credentials is enough
            # OAuth2 is named first because it is the flow this connection should default to whenever the
            # platform can supply a client; an access token or an app password is the fallback for a
            # credential that is not tied to a user's authorization
            "required_options": "oauth2_client_id,oauth2_client_secret|token|username,password",
        };
    }

    #! Creates the BitbucketRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL
        @param attributes various attributes
        @param options connection options
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! Creates the BitbucketRestConnection object
    /** @param config the connection configuration
        @param attr optional connection attributes
    */
    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
    }

    #! Returns the connection type name
    string getType() {
        return "bitbucket";
    }

    #! Returns the name of the application this connection serves
    *string getAppName() {
        return "Bitbucket";
    }

    #! Returns @ref True, as the connection returns a data provider
    bool hasDataProvider() {
        return True;
    }

    #! Returns the Bitbucket data provider for this connection
    DataProvider::AbstractDataProvider getDataProvider(*string subtype, *hash<auto> options) {
        # the data provider module is loaded on demand, so that a connection can be created and pinged
        # without it
        load_module("BitbucketDataProvider");
        return create_object("BitbucketDataProvider", getAsync());
    }

    #! Returns a BitbucketRestClient object
    private BitbucketRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new BitbucketRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new BitbucketRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
