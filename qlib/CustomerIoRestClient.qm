# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) ConnectionProvider >= 1.4

module CustomerIoRestClient {
    version = "1.0";
    desc = "User module for calling Customer.io REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("customerio", CustomerIoRestConnection::ConnectionScheme);
    };
}

/** @mainpage CustomerIoRestClient Module

    @tableofcontents

    @section customeriorestclientintro CustomerIoRestClient Introduction

    The %CustomerIoRestClient module provides an API for calling Customer.io REST API services.

    To use this module, use \c "%requires CustomerIoRestClient" in your code.

    All the public symbols in the module are defined in the CustomerIoRestClient namespace.

    The main classes are:
    - @ref CustomerIoRestClient::CustomerIoRestClient "CustomerIoRestClient":
      this class provides the REST client API for communication with the Customer.io App API;
      it handles Bearer token authentication and regional URL routing
    - @ref CustomerIoRestClient::CustomerIoRestConnection "CustomerIoRestConnection":
      provides a connection object to Customer.io services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires CustomerIoRestClient

CustomerIoRestClient cio({
    "app_api_key": ENV.CUSTOMERIO_APP_API_KEY,
    "site_id": ENV.CUSTOMERIO_SITE_ID,
    "tracking_api_key": ENV.CUSTOMERIO_TRACKING_API_KEY,
    "region": "us",
});
hash<auto> result = cio.get("/activities");
printf("Activities: %y\n", result.body);
    @endcode

    @section customeriorestclientrelnotes Release Notes

    @subsection customeriorestclientv1_0 CustomerIoRestClient v1.0
    - the initial version of the %CustomerIoRestClient module
*/

#! the CustomerIoRestClient namespace contains all the objects in the CustomerIoRestClient module
public namespace CustomerIoRestClient {

#! This class provides the REST client API for communication with Customer.io App API servers
/** Customer.io uses two separate REST APIs:
    - App API (this client): Bearer token auth, for reading data and triggering messages
    - Track API (handled in DataProvider base class): Basic auth, for writing customer data and tracking events

    @par Regional URLs:
    - US: https://api.customer.io/v1 (App API), https://track.customer.io/api/v1 (Track API)
    - EU: https://api-eu.customer.io/v1 (App API), https://track-eu.customer.io/api/v1 (Track API)

    @par Rate Limits:
    - App API: 10 requests per second (standard), 100/s (transactional), 1/10s (broadcasts)
    - Track API: 100 requests per second
*/
public class CustomerIoRestClient inherits RestClient::RestClient {
    public {
        #! Default US App API URL
        const DefaultAppApiUrl = "https://api.customer.io/v1/api";

        #! EU App API URL
        const EuAppApiUrl = "https://api-eu.customer.io/v1/api";

        #! Default US Track API URL
        const DefaultTrackApiUrl = "https://track.customer.io/api/v1";

        #! EU Track API URL
        const EuTrackApiUrl = "https://track-eu.customer.io/api/v1";

        #! Default region
        const DefaultRegion = "us";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (activities endpoint - lightweight, no leading slash since base URL has /v1 path)
        const DefaultPingPath = "activities";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Maximum total retry time for 429 errors (75 seconds)
        const MaxRetryTime = 75s;

        #! Initial retry delay for exponential backoff
        const InitialRetryDelay = 1s;

        #! Maximum single retry delay
        const MaxRetryDelay = 30s;

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
CustomerIoRestClient cio({
    "app_api_key": "your-app-api-key",
    "site_id": "your-site-id",
    "tracking_api_key": "your-tracking-api-key",
    "region": "us",
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c app_api_key: the Customer.io App API key (required for App API access)
        - \c site_id: the Customer.io Site ID (required for Track API access)
        - \c tracking_api_key: the Customer.io Tracking API key (required for Track API access)
        - \c region: the data center region ("us" or "eu")

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw CUSTOMERIO-ERROR missing required option 'app_api_key'
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(CustomerIoRestClient::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! Makes a REST request with automatic retry on 429 (Too Many Requests) errors
    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info, softbool decode_errors = True,
            *hash<auto> hdr) {
        date start_time = now_us();
        date current_delay = InitialRetryDelay;

        while (True) {
            hash<auto> response = RestClient::doRequest(m, path, body, \info, decode_errors, hdr);

            if (info.response_code == 429) {
                date elapsed = now_us() - start_time;
                if (elapsed >= MaxRetryTime) {
                    return response;
                }

                date retry_delay = getRetryDelay(info, current_delay);

                if (elapsed + retry_delay > MaxRetryTime) {
                    retry_delay = MaxRetryTime - elapsed;
                    if (retry_delay <= 0s) {
                        return response;
                    }
                }

                sleep(retry_delay);

                current_delay = current_delay * 2;
                if (current_delay > MaxRetryDelay) {
                    current_delay = MaxRetryDelay;
                }
                continue;
            }

            return response;
        }
    }

    #! Returns the retry delay based on response headers or exponential backoff
    private date getRetryDelay(hash<auto> info, date default_delay) {
        if (info.headers."retry-after") {
            int secs = info.headers."retry-after".toInt();
            if (secs > 0) {
                return seconds(secs);
            }
        }
        return default_delay;
    }

    #! Returns the App API URL for the given region
    static string getAppApiUrl(string region) {
        return region == "eu" ? EuAppApiUrl : DefaultAppApiUrl;
    }

    #! Returns the Track API URL for the given region
    static string getTrackApiUrl(string region) {
        return region == "eu" ? EuTrackApiUrl : DefaultTrackApiUrl;
    }

    #! returns options for @ref CustomerIoRestClient::CustomerIoRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Validate region
        string region = opts.region ?? DefaultRegion;
        if (region !~ /^(us|eu)$/) {
            throw "CUSTOMERIO-ERROR", sprintf("invalid region %y; allowed values: \"us\", \"eu\"", region);
        }

        # Build App API URL from region
        rv.url = getAppApiUrl(region);

        # Set Bearer token authentication
        if (opts.app_api_key) {
            rv.token = opts.app_api_key;
        }

        # Remove custom options so RestClient doesn't try to use them
        remove rv.app_api_key;
        remove rv.site_id;
        remove rv.tracking_api_key;
        remove rv.region;

        return rv;
    }
}

#! Class for Customer.io REST connections; returns @ref CustomerIoRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c app_api_key: the Customer.io App API key (Bearer token)
    - \c site_id: the Customer.io Site ID (for Track API)
    - \c tracking_api_key: the Customer.io Tracking API key (for Track API)
    - \c region: the data center region ("us" or "eu")

    @see @ref CustomerIoRestClient::CustomerIoRestClient::constructor() for more information on the above options
*/
public class CustomerIoRestConnection inherits RestClient::RestConnection {
    public {
        #! Default connection URL
        const DefaultConnectionUrl = "customerio://api.customer.io";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Customer.io REST Connection",
            "short_desc": "A connection to the Customer.io REST API",
            "desc": "A connection to the Customer.io REST API for marketing automation, messaging, and customer "
                "engagement.\n\n"
                "Customer.io helps you send targeted emails, push notifications, SMS messages, and more based on "
                "customer behavior and attributes.\n\n"
                "**APIs:**\n"
                "- App API (Bearer token): Read data, trigger broadcasts and transactional messages\n"
                "- Track API (Basic auth): Create/update customers, track events\n\n"
                "**Rate Limits:**\n"
                "- App API: 10 requests/second (standard)\n"
                "- Track API: 100 requests/second",
            "cls": Class::forName("CustomerIoRestConnection"),
            "auto_url": True,
            "schemes": {
                "customerio": True,
            },
            "base_scheme_map": {
                "https": "customerio",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": CustomerIoRestClient::DefaultData,
                },
                "app_api_key": <ConnectionOptionInfo>{
                    "display_name": "App API Key",
                    "short_desc": "Customer.io App API key for Bearer token authentication",
                    "type": "string",
                    "desc": "The Customer.io App API key used for Bearer token authentication with the App API.\n\n"
                        "**To obtain your App API key:**\n"
                        "1. Log in to [Customer.io](https://fly.customer.io)\n"
                        "2. Go to [Settings > API Credentials](https://fly.customer.io/settings/api_credentials?keyType=app)\n"
                        "3. Create or copy your App API Key\n\n"
                        "**Note:** App API keys are used for reading data and triggering messages.",
                    "sensitive": True,
                    "preselected": True,
                },
                "site_id": <ConnectionOptionInfo>{
                    "display_name": "Site ID",
                    "short_desc": "Customer.io Site ID for Track API authentication",
                    "type": "string",
                    "desc": "The Customer.io Site ID used as the username for Track API Basic authentication.\n\n"
                        "**To find your Site ID:**\n"
                        "1. Log in to [Customer.io](https://fly.customer.io)\n"
                        "2. Go to [Settings > API Credentials](https://fly.customer.io/settings/api_credentials)\n"
                        "3. Your Site ID is listed under Tracking API Keys",
                    "sensitive": True,
                    "preselected": True,
                },
                "tracking_api_key": <ConnectionOptionInfo>{
                    "display_name": "Tracking API Key",
                    "short_desc": "Customer.io Tracking API key for Track API authentication",
                    "type": "string",
                    "desc": "The Customer.io Tracking API key used as the password for Track API Basic "
                        "authentication.\n\n"
                        "**To find your Tracking API key:**\n"
                        "1. Log in to [Customer.io](https://fly.customer.io)\n"
                        "2. Go to [Settings > API Credentials](https://fly.customer.io/settings/api_credentials)\n"
                        "3. Your API Key is listed under Tracking API Keys",
                    "sensitive": True,
                    "preselected": True,
                },
                "region": <ConnectionOptionInfo>{
                    "display_name": "Region",
                    "short_desc": "Customer.io data center region",
                    "type": "string",
                    "desc": "Select the Customer.io data center region for your account.\n\n"
                        "Your region is determined when you create your Customer.io account and cannot be changed.",
                    "default_value": CustomerIoRestClient::DefaultRegion,
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "us",
                            "display_name": "US",
                            "short_desc": "United States",
                            "desc": "US data center (api.customer.io / track.customer.io)",
                        },
                        <AllowedValueInfo>{
                            "value": "eu",
                            "display_name": "EU",
                            "short_desc": "European Union",
                            "desc": "EU data center (api-eu.customer.io / track-eu.customer.io)",
                        },
                    ),
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": CustomerIoRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": CustomerIoRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": CustomerIoRestClient::DefaultPingPath,
                },
            },
            "required_options": "app_api_key,site_id,tracking_api_key",
            "messages": (
                <UiMessageInfo>{
                    "title": "Customer.io API Credentials",
                    "intent": "info",
                    "content": "Customer.io requires three credentials:\n"
                        "1. **App API Key**: For reading data and triggering messages (Bearer token auth)\n"
                        "2. **Site ID**: For tracking customer data (Basic auth username)\n"
                        "3. **Tracking API Key**: For tracking customer data (Basic auth password)\n\n"
                        "Find all credentials at: **[Settings > API Credentials]"
                        "(https://fly.customer.io/settings/api_credentials)**",
                },
                <UiMessageInfo>{
                    "title": "Select Your Region",
                    "intent": "info",
                    "content": "Choose the region that matches your Customer.io account:\n"
                        "- **US**: United States data center (default)\n"
                        "- **EU**: European Union data center\n\n"
                        "Your region was set when you created your account and cannot be changed.",
                },
            ),
        };
    }

    #! creates the CustomerIoRestConnection object
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the CustomerIoRestConnection object
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(CustomerIoRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref CustomerIoRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        string region = config.opts.region ?? CustomerIoRestClient::DefaultRegion;
        string url = sprintf("customerio://api%s.customer.io",
            region == "eu" ? "-eu" : "");
        return config + {
            "url": url,
        };
    }

    #! returns \c "customerio"
    string getType() {
        return "customerio";
    }

    #! Returns connection options with dynamically built URLs from region
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "CustomerIo";
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the CustomerIoDataProvider and creates the data provider
        # object dynamically
        load_module("CustomerIoDataProvider");
        return create_object("CustomerIoDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            string region = opts.region ?? CustomerIoRestClient::DefaultRegion;
            string correct_url = sprintf("customerio://api%s.customer.io",
                region == "eu" ? "-eu" : "");
            hash<auto> updates;
            if (url != correct_url) {
                updates.url = correct_url;
            }
            # Fix ping_path if it has a leading slash (would bypass base path /v1)
            if (opts.ping_path =~ /^\//) {
                updates.ping_path = opts.ping_path[1..];
            }
            if (updates) {
                doUpdateOptions(self, updates);
            }
        }
    }

    #! returns a @ref CustomerIoRestClient object
    private CustomerIoRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new CustomerIoRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
