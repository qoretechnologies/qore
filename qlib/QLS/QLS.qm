%requires qore >= 2.0

%modern

%disable-warning unreferenced-variable

%requires json
%requires Mime
%requires Util
%requires astparser
%requires QoreCodeCompletion
%requires QoreCodeFormat

module QLS {
    version = "1.0";
    desc = "Qore Language Server (LSP) implementation";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage QLS Module

    @section qlsintro QLS Module Introduction

    The %QLS module provides a Language Server Protocol (LSP) implementation for
    %Qore, offering code intelligence features for any editor:
    - Hover information and go-to-definition
    - Find references and document/workspace symbols
    - Diagnostics (parse errors)

    @section qlsusage Usage

    The module is invoked via the @c qls launcher script installed to the system PATH.

    @section qlsrelnotes Release Notes

    @subsection qls_v1_0 v1.0
    - initial release as part of the %Qore repository
    - migrated from standalone qls repository
    - added code completion support (@c textDocument/completion)
    - @c CSTCompletionProvider uses CSTSearcher for static analysis completion
    - supports identifier, @c new, dot-access, and scope (@c ::) completion contexts
    - trigger characters: @c . and @c :
    - added @c textDocument/onTypeFormatting support for auto-indentation on Enter
      and auto-dedent on @c }
    - added @c textDocument/formatting for whole-document formatting using QoreCodeFormat
    - added @c textDocument/documentHighlight to highlight all occurrences of symbol under cursor
    - added @c textDocument/signatureHelp for function/method parameter hints (triggers: @c ( and @c ,)
    - added @c textDocument/foldingRange for code folding of declarations, blocks, and comments
*/

#! Main namespace for the QLS module
public namespace QLS {
}
