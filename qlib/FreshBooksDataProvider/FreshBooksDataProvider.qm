# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) FreshBooksRestClient
%try-module json
%define NoJson
%endtry

module FreshBooksDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for FreshBooks accounting and invoicing";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new FreshBooksDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": FreshBooksDataProvider::AppName,
            "display_name": "FreshBooks",
            "short_desc": "FreshBooks cloud accounting software",
            "desc": "FreshBooks is cloud-based accounting software designed for small businesses "
                "and freelancers.\n\n"
                "This integration supports clients, invoices, expenses, estimates, items, "
                "and services.",
            "scheme": "freshbooks",
            "logo": FreshBooksLogo,
            "logo_file_name": "freshbooks-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AccountingErp,),
        });

        # ========== CLIENT ACTIONS ==========

        # Create Client
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/create-client",
            "action": "create-client",
            "groups": "Clients",
            "display_name": "Create Client",
            "short_desc": "Create a new client",
            "desc": "Create a new client in FreshBooks",
            "action_code": DPAT_API,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "fname": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Client first name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "First name of the client",
                    "example_value": "John",
                },
                "lname": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Client last name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Last name of the client",
                    "example_value": "Doe",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Client email",
                    "type": AbstractDataProviderTypeMap."*string",
                    "required": True,
                    "desc": "Email address of the client (at least one of fname, lname, email, "
                        "organization is required)",
                    "example_value": "john@example.com",
                },
                "organization": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Company name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Organization or company name",
                    "example_value": "Acme Corp",
                },
                "phone": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Business phone",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "note": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Notes about the client",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_street": <ActionOptionInfo>{
                    "display_name": "Street",
                    "short_desc": "Street address",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_city": <ActionOptionInfo>{
                    "display_name": "City",
                    "short_desc": "City",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_province": <ActionOptionInfo>{
                    "display_name": "Province/State",
                    "short_desc": "Province or state",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_code": <ActionOptionInfo>{
                    "display_name": "Postal Code",
                    "short_desc": "Postal/zip code",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_country": <ActionOptionInfo>{
                    "display_name": "Country",
                    "short_desc": "Country",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Update Client
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/update-client",
            "action": "update-client",
            "groups": "Clients",
            "display_name": "Update Client",
            "short_desc": "Update an existing client",
            "desc": "Update an existing client in FreshBooks",
            "action_code": DPAT_API,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Client ID",
                    "short_desc": "The client to update",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "clients",
                },
                "fname": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Client first name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "lname": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Client last name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Client email",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "organization": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Company name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "phone": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Business phone",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "note": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Notes about the client",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_street": <ActionOptionInfo>{
                    "display_name": "Street",
                    "short_desc": "Street address",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_city": <ActionOptionInfo>{
                    "display_name": "City",
                    "short_desc": "City",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_province": <ActionOptionInfo>{
                    "display_name": "Province/State",
                    "short_desc": "Province or state",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_code": <ActionOptionInfo>{
                    "display_name": "Postal Code",
                    "short_desc": "Postal/zip code",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "p_country": <ActionOptionInfo>{
                    "display_name": "Country",
                    "short_desc": "Country",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Search Clients
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/clients",
            "action": "search-clients",
            "groups": "Clients",
            "display_name": "Search Clients",
            "short_desc": "Search for clients",
            "desc": "Search for clients in FreshBooks with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Client ID",
                    "short_desc": "Filter by client ID",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Filter by email",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Search for clients by email address",
                },
                "organization": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Filter by organization name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Search for clients by organization name (partial match)",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return (max 100)",
                },
            },
        });

        # Get Client
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/clients",
            "action": "get-client",
            "groups": "Clients",
            "display_name": "Get Client",
            "short_desc": "Get a single client by ID",
            "desc": "Retrieve a single client by ID from FreshBooks",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Client ID",
                    "short_desc": "The client ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "clients",
                },
            },
        });

        # Delete Client
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/delete-client",
            "action": "delete-client",
            "groups": "Clients",
            "display_name": "Delete Client",
            "short_desc": "Delete a client",
            "desc": "Soft-delete a client in FreshBooks by setting vis_state to 1",
            "action_code": DPAT_API,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Client ID",
                    "short_desc": "The client to delete",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "clients",
                },
            },
        });

        # ========== SERVICE ACTIONS ==========

        # Create Service
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/create-service",
            "action": "create-service",
            "groups": "Services",
            "display_name": "Create Service",
            "short_desc": "Create a new service",
            "desc": "Create a new service in FreshBooks for time tracking",
            "action_code": DPAT_API,
            "options": {
                "business_id": <ActionOptionInfo>{
                    "display_name": "Business ID",
                    "short_desc": "FreshBooks business ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks business ID for time tracking API endpoints",
                    "ref_data": "businesses",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Service name",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The name of the service",
                    "example_value": "Development",
                },
                "billable": <ActionOptionInfo>{
                    "display_name": "Billable",
                    "short_desc": "Whether the service is billable",
                    "type": AbstractDataProviderTypeMap."*bool",
                    "desc": "Whether this service is billable to clients",
                },
            },
        });

        # Update Service
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/update-service",
            "action": "update-service",
            "groups": "Services",
            "display_name": "Update Service",
            "short_desc": "Update an existing service",
            "desc": "Update an existing service in FreshBooks",
            "action_code": DPAT_API,
            "options": {
                "business_id": <ActionOptionInfo>{
                    "display_name": "Business ID",
                    "short_desc": "FreshBooks business ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks business ID for time tracking API endpoints",
                    "ref_data": "businesses",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Service ID",
                    "short_desc": "The service to update",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "services",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Service name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "billable": <ActionOptionInfo>{
                    "display_name": "Billable",
                    "short_desc": "Whether the service is billable",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
            },
        });

        # Search Services
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/services",
            "action": "search-services",
            "groups": "Services",
            "display_name": "Search Services",
            "short_desc": "Search for services",
            "desc": "Search for services in FreshBooks",
            "action_code": DPAT_FIND,
            "options": {
                "business_id": <ActionOptionInfo>{
                    "display_name": "Business ID",
                    "short_desc": "FreshBooks business ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks business ID for time tracking API endpoints",
                    "ref_data": "businesses",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Service ID",
                    "short_desc": "Filter by service ID",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get Service
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/services",
            "action": "get-service",
            "groups": "Services",
            "display_name": "Get Service",
            "short_desc": "Get a single service by ID",
            "desc": "Retrieve a single service by ID from FreshBooks",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "business_id": <ActionOptionInfo>{
                    "display_name": "Business ID",
                    "short_desc": "FreshBooks business ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks business ID for time tracking API endpoints",
                    "ref_data": "businesses",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Service ID",
                    "short_desc": "The service ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "services",
                },
            },
        });

        # Delete Service
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/delete-service",
            "action": "delete-service",
            "groups": "Services",
            "display_name": "Delete Service",
            "short_desc": "Delete a service",
            "desc": "Delete a service in FreshBooks",
            "action_code": DPAT_API,
            "options": {
                "business_id": <ActionOptionInfo>{
                    "display_name": "Business ID",
                    "short_desc": "FreshBooks business ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks business ID for time tracking API endpoints",
                    "ref_data": "businesses",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Service ID",
                    "short_desc": "The service to delete",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "services",
                },
            },
        });

        # ========== ESTIMATE ACTIONS ==========

        # Create Estimate
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/create-estimate",
            "action": "create-estimate",
            "groups": "Estimates",
            "display_name": "Create Estimate",
            "short_desc": "Create a new estimate",
            "desc": "Create a new estimate/quote in FreshBooks",
            "action_code": DPAT_API,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "customerid": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer for the estimate",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "clients",
                },
                "estimate_number": <ActionOptionInfo>{
                    "display_name": "Estimate Number",
                    "short_desc": "Unique estimate number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "create_date": <ActionOptionInfo>{
                    "display_name": "Date",
                    "short_desc": "Estimate date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "required": True,
                    "desc": "Estimate date in YYYY-MM-DD format",
                },
                "currency_code": <ActionOptionInfo>{
                    "display_name": "Currency",
                    "short_desc": "Currency code",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Currency code (e.g. USD, CAD, EUR)",
                    "example_value": "USD",
                },
                "lines": <ActionOptionInfo>{
                    "display_name": "Line Items",
                    "short_desc": "Estimate line items",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of line items with fields: description, quantity, unit_cost, taxName1, taxPercent1",
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Customer notes",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "terms": <ActionOptionInfo>{
                    "display_name": "Terms",
                    "short_desc": "Terms and conditions",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "po_number": <ActionOptionInfo>{
                    "display_name": "PO Number",
                    "short_desc": "Purchase order number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Search Estimates
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/estimates",
            "action": "search-estimates",
            "groups": "Estimates",
            "display_name": "Search Estimates",
            "short_desc": "Search for estimates",
            "desc": "Search for estimates in FreshBooks",
            "action_code": DPAT_FIND,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Estimate ID",
                    "short_desc": "Filter by estimate ID",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "customerid": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "clients",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by status",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get Estimate
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/estimates",
            "action": "get-estimate",
            "groups": "Estimates",
            "display_name": "Get Estimate",
            "short_desc": "Get a single estimate by ID",
            "desc": "Retrieve a single estimate by ID from FreshBooks",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Estimate ID",
                    "short_desc": "The estimate ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "estimates",
                },
            },
        });

        # Update Estimate
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/update-estimate",
            "action": "update-estimate",
            "groups": "Estimates",
            "display_name": "Update Estimate",
            "short_desc": "Update an existing estimate",
            "desc": "Update an existing estimate in FreshBooks",
            "action_code": DPAT_API,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The FreshBooks account ID for accounting API endpoints",
                    "ref_data": "accounts",
                },
                "id": <ActionOptionInfo>{
                    "display_name": "Estimate ID",
                    "short_desc": "The estimate to update",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "preselected": True,
                    "ref_data": "estimates",
                },
                "customerid": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer for the estimate",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "clients",
                },
                "estimate_number": <ActionOptionInfo>{
                    "display_name": "Estimate Number",
                    "short_desc": "The estimate number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "create_date": <ActionOptionInfo>{
                    "display_name": "Date",
                    "short_desc": "Estimate date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Estimate date in YYYY-MM-DD format",
                },
                "currency_code": <ActionOptionInfo>{
                    "display_name": "Currency",
                    "short_desc": "Currency code",
                    "type": AbstractDataProviderTypeMap."*string",
                    "example_value": "USD",
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Estimate notes",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "terms": <ActionOptionInfo>{
                    "display_name": "Terms",
                    "short_desc": "Terms and conditions",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "po_number": <ActionOptionInfo>{
                    "display_name": "PO Number",
                    "short_desc": "Purchase order number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Delete Estimate
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FreshBooksDataProvider::AppName,
            "path": "/delete-estimate",
            "action": "delete-estimate",
            "groups": "Estimates",
            "display_name": "Delete Estimate",
            "short_desc": "Delete an estimate",
            "desc": "Soft-delete an estimate in FreshBooks by setting vis_state to 1",
            "action_code": DPAT_API,
            "options": {
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account ID",
                    "short_desc": "FreshBooks account ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
