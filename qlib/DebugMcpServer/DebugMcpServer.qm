# minimum required Qore version
%requires qore >= 3.0
%requires(reexport) DebugCmdLine
%requires(reexport) DebugProgramControl
%requires(reexport) McpServerHandler
%requires HttpServer
%requires DataProvider
%requires WebSocketClient
%requires Logger
%requires yaml
%requires json

%modern
%no-debugging
%allow-debugger
# child program won't inherit parent program options (including %allow-debugger)
%no-child-restrictions

module DebugMcpServer {
    version = "1.0";
    desc = "user module providing an MCP server that debugs Qore programs for coding agents";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage DebugMcpServer Module

    @tableofcontents

    @section debugmcpserverintro Introduction to the DebugMcpServer Module

    The %DebugMcpServer module provides an <a href="https://modelcontextprotocol.io">MCP</a> server that lets coding
    agents, such as Claude Code, debug %Qore programs: launch a script or attach to a debug server, set breakpoints with
    conditions, run until a thread pauses or a time passes, and read the call stack, the variables and the values of
    expressions.  The \c qdbg-mcp tool runs it; see @ref debugging_mcp.

    A debugged program runs in the server's process, like with \c qdbg, or in a debug server, such as \c qdbg-server or
    Qorus, that the server attaches to.  Each tool answers with a JSON object that tells what happened: the stops and
    other events of the debugger with their text, such as <tt>Paused at breakpoint 1 at main.q:3 (thread 2)</tt>, the
    output of the program, the end of the program, and the state of the debugger.  A command that resumes a thread
    returns when a thread pauses, when the program ends, or when its time passes; then the program is paused.  An
    exception that matches a common pitfall of %Qore is given with a hint (see @ref common_pitfalls).

    A stop is given with its \c reason: \c start, \c "thread start", \c breakpoint, \c step, \c pause (a pause that was requested,
    as when the time of a command passed),
    \c "function entry", \c "function exit", \c exception, \c "end of code" or \c "thread end", and a thread that
    was paused before \c qore_debug_attach attached, as by another client, is given with \c paused, or with \c start
    at the start of its program.  When the session ends, \c qore_debug_terminate reports the end of each thread of
    a launched program, and a detach tells that the paused threads of the debug server continue.  A value is given
    with its type and a short \c value, and with its whole value in \c text, written as in %Qore, when it says more,
    as for a list, a hash or an object with at most @ref DebugMcpServer::DebugMcpSession::MaxInlineSize "MaxInlineSize"
    elements, or the string itself for a string.  The messages of logpoints are given in \c logOutput, apart from the
    output of the program in \c programOutput, each line with its thread, as in <tt>[thread 3] count=4</tt>;
    consecutive identical messages are given once with their count, as <tt>[thread 3] count=4 (x20)</tt>.  The
    \c finish mode of \c qore_debug_continue pauses the thread at the next statement of the caller, and the stop gives
    the function and the value that it returned in \c returned.  When \c qore_debug_continue pauses the program
    after its timeout, and with \c qore_debug_pause, the report gives where the current thread is paused, its call
    stack in \c frames, and the local variables of its top frame in \c variables, unless \c details is \c false.  \c qore_debug_launch, \c qore_debug_attach and
    \c qore_debug_exception_filter give the exceptions that pause threads in \c exceptionFilters.  A tool rejects an
    argument that it does not have, so that a misspelled option, as \c log for \c log_message, is not ignored.

    |!Tool|!Description
    |\c qore_debug_launch|launches a %Qore script in the debugger; it pauses at its start
    |\c qore_debug_attach|attaches to a debug server, such as \c qdbg-server or Qorus
    |\c qore_debug_set_breakpoint|sets a breakpoint on a line, a statement of a line or a function, with an optional condition, hit condition or log message
    |\c qore_debug_delete_breakpoint|deletes a breakpoint
    |\c qore_debug_exception_filter|sets the exceptions that pause threads
    |\c qore_debug_continue|resumes a thread: runs it, steps into or over a statement, or runs it until its function returns; it returns when a thread pauses, the program ends or the time passes
    |\c qore_debug_pause|pauses the program
    |\c qore_debug_stack|returns the call stack of a thread
    |\c qore_debug_variables|returns the local variables of a frame, or the elements, keys or members of a value
    |\c qore_debug_evaluate|evaluates an expression with the variables of a frame
    |\c qore_debug_command|runs a command of the \c qdbg command-line debugger, for everything else
    |\c qore_debug_status|returns the state of the debugger and what happened since the last tool
    |\c qore_debug_terminate|ends the debugged program, or detaches from the debug server

    @par Example:
    @code{.py}
%requires DebugMcpServer
%requires HttpServer

DebugMcpServer handler(new Logger(), new PermissiveAuthenticator());
HttpServer http({});
http.setHandler("mcp", "", MimeTypeJson, handler);
http.setDefaultHandler("mcp", handler);
int port = http.addListener(http_get_listener_options_from_bind("127.0.0.1:0")).port;
    @endcode

    @note A debugger client can evaluate expressions and change the program, and a launched script runs with the
    permissions of the server; the server should only be reachable by its own user, as with a listener on
    \c 127.0.0.1 and a token (see \c qdbg-mcp \c -k).

    @section debugmcpserver_relnotes Release Notes

    @subsection debugmcpserver_v1_0 v1.0
    - initial release
*/

#! the DebugMcpServer namespace contains all the definitions in the DebugMcpServer module
public namespace DebugMcpServer {
}
