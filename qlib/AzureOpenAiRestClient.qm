%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires OpenAiRestClient
%requires AzureAuth
%requires QoreLlmTypes

module AzureOpenAiRestClient {
    version = "1.0";
    desc = "Authenticated synchronous and asynchronous Azure OpenAI REST clients and LLM provider "
        "with API key, Entra client credentials, and managed identity authentication";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("azure-openai",
            AzureOpenAiRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(
            new AzureOpenAiLlmProviderFactory());
    };
}

/** @mainpage AzureOpenAiRestClient Module

    @tableofcontents

    @section azureopenairestclientintro Introduction to the AzureOpenAiRestClient Module

    The %AzureOpenAiRestClient module provides authenticated synchronous and asynchronous REST clients,
    the `azure-openai` connection scheme, and an LLM provider for the
    [QoreLlmUtils](../../QoreLlmUtils/html/index.html) agent stack. The connection supports the
    [AzureOpenAiDataProvider](../../AzureOpenAiDataProvider/html/index.html) v1 actions. The separate LLM provider
    retains deployment URLs for compatibility:

    - **URL routing**: chat completions are published per-deployment at
      <tt>/openai/deployments/{deployment}/chat/completions?api-version=...</tt>
      rather than the OpenAI global <tt>/v1/chat/completions</tt>
    - **Authentication**: supports three modes — \c api-key header,
      Entra ID client-credentials bearer, and managed-identity bearer (the
      latter two via @ref azureauthintro "AzureAuth")

    The provider is a thin subclass of
    @ref OpenAiRestClient::OpenAiLlmProvider so all body construction,
    response parsing, streaming, and tool-call handling are inherited from
    the OpenAI-compatible base.  Only @c getChatCompletionsPath() and the
    auth-header helper are overridden.

    @par Connection options

    - \c url (required): the Azure resource endpoint, e.g.
      \c "https://my-resource.openai.azure.com"
    - \c azure_deployment (required for the LLM provider): the deployment name; v1 actions choose it per action
    - \c azure_api_version (optional): default \c "2024-10-21"
    - \c azure_auth_mode (optional, default \c "api_key"):
      \c "api_key", \c "entra_client_credentials", or
      \c "entra_managed_identity"
    - \c api_key (required when \c azure_auth_mode = \c "api_key"): the
      resource's primary or secondary key
    - For \c entra_client_credentials: \c azure_tenant_id,
      \c azure_client_id, \c azure_client_secret
    - For \c entra_managed_identity: optional \c azure_managed_identity_client_id (for
      user-assigned identities); legacy \c azure_client_id remains supported

    Foundry Conversations use a project URL such as
    `https://my-resource.services.ai.azure.com/api/projects/my-project`, with Microsoft Entra authentication.
    The default token scope follows the endpoint: `https://ai.azure.com/.default` for projects and
    `https://cognitiveservices.azure.com/.default` for resources. `azure_entra_scope` can override it.
    The project path is preserved when clients
    are copied; the default ping lists one conversation from that project.

    @par REST example
    @code{.py}
%requires AzureOpenAiRestClient
AzureOpenAiRestClientIo client({
    "url": ENV.AZURE_OPENAI_ENDPOINT, "api_key": ENV.AZURE_OPENAI_API_KEY,
});
auto models = client.restDoRequest("GET", "/openai/v1/models");
    @endcode

    @par Capability gating

    @ref AzureOpenAiRestClient::AzureOpenAiLlmProviderFactory::getInfo() returns a
    @ref QoreLlmUtils::LlmProviderInfo computed statically from
    \c azure_api_version: features only present in newer API versions are
    advertised only when the configured version meets the minimum.

    @par Example

    @code{.py}
%requires AzureOpenAiRestClient

# api-key auth
AzureOpenAiLlmProvider p(<LlmBackendConfig>{
    "url": "https://my-resource.openai.azure.com",
    "model": "gpt-4o",  # deployment name
    "api_key": "<resource-key>",
    "provider_options": {
        "azure_deployment": "gpt-4o",
        "azure_api_version": "2024-10-21",
    },
});
hash<ChatResponse> r = p.chat((<ChatMessage>{"role": "user", "content": "hi"},));
    @endcode

    @section azureopenairestclientrelnotes Release Notes

    @subsection azureopenairestclient_v1_0 AzureOpenAiRestClient v1.0
    - initial release: authenticated synchronous and asynchronous REST clients, including raw requests
      and client copies, with api-key + Entra client_credentials + managed-identity auth modes and the
      LLM provider registered under mode \c "azure-openai"
    - connections expose the Azure OpenAI app and verify credentials with the v1 model listing
    - Foundry project endpoints preserve their resource path and use the project conversation listing for pings
    - conditional required credentials and a dedicated optional managed-identity client ID clarify setup
    - the dated API version remains scoped to the legacy deployment-routed LLM interface
*/

#! Contains all public definitions in the AzureOpenAiRestClient module
public namespace AzureOpenAiRestClient {
#! Default Azure OpenAI API version
public const DefaultAzureApiVersion = "2024-10-21";

#! Authentication mode constants
public const AuthModeApiKey = "api_key";
public const AuthModeEntraClientCredentials = "entra_client_credentials";
public const AuthModeEntraManagedIdentity = "entra_managed_identity";

#! Default Entra OAuth2 scope for Azure Cognitive Services
/** This is the resource URL Azure issues tokens for; suffixed with \c "/.default"
    per the v2 endpoint convention.
*/
public const DefaultEntraScope = "https://cognitiveservices.azure.com/.default";

#! Microsoft Entra scope for Foundry project APIs
public const DefaultFoundryEntraScope = "https://ai.azure.com/.default";

#! Shared configuration and request authentication for Azure OpenAI clients
/** Authentication configuration is immutable after construction. Entra tokens are obtained through
    AzureAuth's synchronized cache for each request, so copied clients retain automatic token refresh.
*/
public class AzureOpenAiRestClientBase {
    public {
        #! Options owned by this module rather than by the generic REST transport
        const AzureOptions = ("azure_deployment", "azure_api_version", "azure_auth_mode", "api_key",
            "azure_tenant_id", "azure_client_id", "azure_client_secret", "azure_entra_scope",
            "azure_managed_identity_client_id");
    }

    private {
        #! Immutable authentication and deployment configuration
        hash<auto> azure_options;

        #! Default audience for this client's endpoint; recalculated when a client is copied to another URL
        string default_entra_scope;
    }

    #! Captures the Azure configuration for authentication and transport copies
    /** @param options Azure client options */
    constructor(hash<auto> options) {
        azure_options = options{AzureOptions};
        default_entra_scope = options.url.val() && AzureOpenAiRestClientBase::getProjectPath(options.url).val()
            ? DefaultFoundryEntraScope : DefaultEntraScope;
    }

    #! Validates the credentials required by the selected authentication mode
    /** @param options Azure client or connection options
        @throw AZURE-OPENAI-AUTH-ERROR missing credentials or unknown authentication mode
    */
    static validateOptions(hash<auto> options) {
        string mode = options.azure_auth_mode ?? AuthModeApiKey;
        list<string> required;
        switch (mode) {
            case AuthModeApiKey:
                required = ("api_key",);
                break;
            case AuthModeEntraClientCredentials:
                required = ("azure_tenant_id", "azure_client_id", "azure_client_secret");
                break;
            case AuthModeEntraManagedIdentity:
                return;
            default:
                throw "AZURE-OPENAI-AUTH-ERROR", sprintf("Unknown authentication mode %y", mode);
        }
        foreach string name in (required) {
            if (options{name}.typeCode() != NT_STRING || !trim(options{name})) {
                throw "AZURE-OPENAI-AUTH-ERROR", sprintf("Authentication mode %y requires %s", mode, name);
            }
        }
    }

    #! Returns the resource-addressing prefix of a Foundry project endpoint
    /** @param url the resource or project endpoint, optionally ending in /openai/v1
        @return the project path without an API suffix, or nothing for a resource endpoint
        @throw PARSE-URL-ERROR the URL cannot be parsed
    */
    static *string getProjectPath(string url) {
        *list<string> parts = regex_extract(parse_url(url).path ?? "",
            "^(/api/projects/[^/]+)(?:/openai(?:/v1)?)?/?$");
        return parts ? parts[0] : NOTHING;
    }

    #! Returns generic transport options with explicit JSON serialization
    /** @param options Azure client options
        @return options understood by RestClient or RestClientIo
        @throw AZURE-OPENAI-AUTH-ERROR invalid authentication configuration
    */
    static hash<auto> getOptions(hash<auto> options) {
        AzureOpenAiRestClientBase::validateOptions(options);
        hash<auto> rv = options - AzureOptions;
        if (!rv.data || rv.data == "auto") {
            rv.data = "json";
        }
        rv.headers = {"accept": MimeTypeJson} + rv.headers;
        # Authentication is applied per request, independently of generic OAuth2/token options.
        rv -= ("token", "token_type", "token_api_key_header", "oauth2_grant_type");
        return rv;
    }

    #! Returns the authentication header for the next request
    /** @return API-key or refreshed Entra Bearer authentication
        @throw any AzureAuth token acquisition error
    */
    private hash<auto> getAzureAuthHeader() {
        string mode = azure_options.azure_auth_mode ?? AuthModeApiKey;
        if (mode == AuthModeApiKey) {
            return {"api-key": azure_options.api_key};
        }
        string scope = getEntraScope();
        string token;
        if (mode == AuthModeEntraClientCredentials) {
            token = AzureAuth::getEntraTokenClientCredentials(azure_options.azure_tenant_id,
                azure_options.azure_client_id, azure_options.azure_client_secret, scope);
        } else {
            string resource = scope;
            resource =~ s/\/\.default$//;
            token = AzureAuth::getEntraTokenManagedIdentity(resource,
                azure_options.azure_managed_identity_client_id ?? azure_options.azure_client_id);
        }
        return {"authorization": "Bearer " + token};
    }

    #! Returns an explicit audience override or the default for this endpoint
    private string getEntraScope() {
        return azure_options.azure_entra_scope.val() ? azure_options.azure_entra_scope : default_entra_scope;
    }
}

#! Synchronous Azure OpenAI REST client
/** Provides authenticated JSON and binary requests to the resource endpoint. */
public class AzureOpenAiRestClient inherits RestClient::RestClient, AzureOpenAiRestClientBase {
    #! Creates an authenticated client, optionally deferring the connection
    /** @param options Azure client and RestClient options
        @param do_not_connect if True, connect only when requested
        @throw AZURE-OPENAI-AUTH-ERROR invalid authentication configuration
        @throw any transport construction or connection error
    */
    constructor(hash<auto> options, *softbool do_not_connect)
            : RestClient(AzureOpenAiRestClientBase::getOptions(options), True),
                AzureOpenAiRestClientBase(options) {
        *string project = AzureOpenAiRestClientBase::getProjectPath(getUrl());
        if (project) {
            setConnectionPath(project);
        }
        if (!do_not_connect) {
            connect();
        }
    }

    private signRequest(string method, *string path, *data body, reference<hash<auto>> hdr) {
        hdr += getAzureAuthHeader();
    }

    private AbstractRestClient copySelf(hash<auto> options) {
        return new AzureOpenAiRestClient(options + azure_options, True);
    }
}

#! Multiplexed Azure OpenAI REST client
/** Authentication is applied to ordinary, asynchronous, streaming, and pre-serialized requests. */
public class AzureOpenAiRestClientIo inherits RestClientIo::RestClientIo, AzureOpenAiRestClientBase {
    #! Creates an authenticated client using an optional shared connection manager
    /** @param options Azure client and RestClientIo options
        @param shared_mgr an optional shared connection manager
        @throw AZURE-OPENAI-AUTH-ERROR invalid authentication configuration
        @throw any transport construction error
    */
    constructor(hash<auto> options, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(AzureOpenAiRestClientBase::getOptions(options), shared_mgr),
            AzureOpenAiRestClientBase(options) {
        *string project = AzureOpenAiRestClientBase::getProjectPath(getUrl());
        if (project) {
            setConnectionPath(project);
        }
    }

    private hash<auto> prepareRequestIntern(string method, reference<string> path, auto body,
            reference<*hash<auto>> hdr, bool raw) {
        hdr = (hdr ?? {}) + getAzureAuthHeader();
        return RestClientIo::prepareRequestIntern(method, \path, body, \hdr, raw);
    }

    private AbstractRestClient copySelf(hash<auto> options) {
        return new AzureOpenAiRestClientIo(options + azure_options, getConnectionManager());
    }
}

#! Azure OpenAI REST connection (registered under the \c "azure-openai" scheme)
public class AzureOpenAiRestConnection inherits RestClient::RestConnection {
    public {
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Azure OpenAI Connection",
            "short_desc": "A connection to an Azure OpenAI Service resource",
            "desc": "Connect to an Azure OpenAI resource for model inference, files, batches, and retrieval. "
                "Authenticate with a resource API key or Microsoft Entra ID. Connection pings verify "
                "authentication without generating content.",
            "cls": Class::forName("AzureOpenAiRestConnection"),
            "schemes": {"azure-openai": True},
            "base_scheme_map": {"https": "azure-openai"},
            "options": RestConnection::ConnectionScheme.options + {
                "azure_deployment": <ConnectionOptionInfo>{
                    "display_name": "Default Model Deployment",
                    "short_desc": "Azure OpenAI deployment name",
                    "type": "string",
                    "desc": "Deployment used by the LLM provider. In the Azure Foundry portal, open Models and "
                        "endpoints and copy the deployment name. Actions can choose another deployment.",
                    "example_value": "my-chat-deployment",
                },
                "azure_api_version": <ConnectionOptionInfo>{
                    "display_name": "Legacy API Version",
                    "short_desc": "Azure OpenAI REST API version",
                    "type": "string",
                    "desc": "API version for the LLM provider and legacy deployment URLs. The v1 actions do not "
                        "require an API version. Use a supported date or preview version.",
                    "allowed_values": (<AllowedValueInfo>{"value": "2024-10-21",
                        "display_name": "2024-10-21 (Stable)"},),
                    "allowed_values_creatable": True,
                    "default_value": DefaultAzureApiVersion,
                },
                "azure_auth_mode": <ConnectionOptionInfo>{
                    "display_name": "Authentication",
                    "short_desc": "Authentication mode",
                    "type": "string",
                    "desc": "Use a resource API key for development, a registered Entra application for a service, "
                        "or the identity assigned to an Azure host.",
                    "preselected": True,
                    "has_dependents": True,
                    "default_value": AuthModeApiKey,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": AuthModeApiKey,
                            "display_name": "API Key",
                            "desc": "Azure resource api-key header"},
                        <AllowedValueInfo>{"value": AuthModeEntraClientCredentials,
                            "display_name": "Entra Client Credentials",
                            "desc": "Entra (Azure AD) client_credentials grant"},
                        <AllowedValueInfo>{"value": AuthModeEntraManagedIdentity,
                            "display_name": "Entra Managed Identity",
                            "desc": "Azure managed-identity (IMDS-for-Azure)"},
                    ),
                },
                "api_key": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Azure OpenAI resource api-key",
                    "type": "string",
                    "desc": "Key 1 or Key 2 from the Azure resource Keys and Endpoint page. Either key works.",
                    "required": True,
                    "depends_on": ("azure_auth_mode=api_key",),
                    "sensitive": True,
                    "preselected": True,
                },
                "azure_tenant_id": <ConnectionOptionInfo>{
                    "display_name": "Entra Tenant ID",
                    "short_desc": "Tenant ID for Entra auth",
                    "type": "string",
                    "desc": "Tenant ID or domain of the Entra application used for authentication.",
                    "required": True,
                    "depends_on": ("azure_auth_mode=entra_client_credentials",),
                },
                "azure_client_id": <ConnectionOptionInfo>{
                    "display_name": "Entra Client ID",
                    "short_desc": "Client ID for Entra auth",
                    "type": "string",
                    "desc": "Application (client) ID of the Entra application. Assign it access to this Azure OpenAI resource.",
                    "required": True,
                    "depends_on": ("azure_auth_mode=entra_client_credentials",),
                },
                "azure_client_secret": <ConnectionOptionInfo>{
                    "display_name": "Entra Client Secret",
                    "short_desc": "Client secret for Entra auth",
                    "type": "string",
                    "desc": "Client secret value of the Entra application, not the secret identifier.",
                    "required": True,
                    "depends_on": ("azure_auth_mode=entra_client_credentials",),
                    "sensitive": True,
                },
                "azure_entra_scope": <ConnectionOptionInfo>{
                    "display_name": "Entra Scope",
                    "short_desc": "OAuth2 scope to request",
                    "type": "string",
                    "desc": "Leave empty to select the token scope for this endpoint automatically. "
                        "Foundry projects use `https://ai.azure.com/.default`; Azure OpenAI resources use "
                        "`https://cognitiveservices.azure.com/.default`.",
                },
                "azure_managed_identity_client_id": <ConnectionOptionInfo>{
                    "display_name": "Managed Identity Client ID",
                    "short_desc": "Optional client ID of a user-assigned managed identity",
                    "type": "string",
                    "desc": "Leave empty to use the host's system-assigned identity. For a user-assigned "
                        "identity, supply its client ID. The host must provide Azure managed identity access.",
                    "depends_on": ("azure_auth_mode=entra_managed_identity",),
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method
                    + <ConnectionOptionInfo>{"default_value": "GET"},
                "ping_path": RestConnection::ConnectionScheme.options.ping_path
                    + <ConnectionOptionInfo>{"default_value": "/openai/v1/models"},
            },
        };
    }

    constructor(string name, string description, string url, hash<auto> attributes = {},
            hash<auto> options = {}) : RestConnection(name, description, url,
                attributes, options) {
        AzureOpenAiRestClientBase::validateOptions(opts);
    }

    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
        AzureOpenAiRestClientBase::validateOptions(opts);
    }

    string getType() {
        return "azure-openai";
    }

    #! Returns the application associated with this connection
    /** @return the Azure OpenAI app identity */
    *string getAppName() {
        return "AzureOpenAI";
    }

    #! Checks the project conversation endpoint when the connection addresses a Foundry project
    private *string getPingPath() {
        *string path = RestConnection::getPingPath();
        *string project = AzureOpenAiRestClientBase::getProjectPath(getUrl());
        if (project && path == "/openai/v1/models") {
            return project + "/openai/v1/conversations?limit=1";
        }
        return path;
    }

    #! Returns the Azure OpenAI action provider with this connection's authenticated transport
    /** @param constructor_options additional provider constructor options
        @return a connected AzureOpenAiDataProvider
        @throw any provider loading or construction error
    */
    AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("AzureOpenAiDataProvider");
        return create_object("AzureOpenAiDataProvider", (constructor_options ?? {}) + {
            "restclient": getAsync(False),
            "azure_api_version": opts.azure_api_version,
        });
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private AzureOpenAiRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new AzureOpenAiRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new AzureOpenAiRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! Returns the OAuth2 grant type this connection authenticates with, if any
    /** The Entra credentials live under this connection's own \c azure_* option names and are exchanged for a
        token by @ref azureauthintro "AzureAuth" rather than by the OAuth2 machinery in
        @ref RestClient::RestConnection "RestConnection", so without this the connection would report that it does
        not use OAuth2 at all.  Only \c entra_client_credentials names an OAuth2 grant; the managed identity mode
        takes its token from the platform, and the api-key mode is not OAuth2.
    */
    private *string getOAuth2GrantType() {
        if (opts.azure_auth_mode == AuthModeEntraClientCredentials) {
            return "client_credentials";
        }
    }
}

#! Azure OpenAI LLM provider — subclasses @ref OpenAiRestClient::OpenAiLlmProvider
/** Inherits the OpenAI-compatible body construction, response parsing, and
    streaming pump.  Overrides:

    - @ref getChatCompletionsPath() to emit
      <tt>/openai/deployments/{deployment}/chat/completions?api-version=...</tt>
    - @ref buildAuthHeader() to dispatch between the three auth modes

    Tokens for Entra modes are cached and refreshed by @ref azureauthintro
    "AzureAuth" so per-request overhead is minimal.

    @par LlmBackendConfig consumed

    - \c url (required): Azure resource endpoint
    - \c model (optional, informational): typically equals the deployment
      name; passed in the OpenAI body's \c model field where Azure ignores it
    - \c api_key (optional): for \c api_key auth
    - \c options.azure_deployment (required): deployment name for the URL
    - \c options.azure_api_version (optional, default 2024-10-21)
    - \c options.azure_auth_mode (optional, default "api_key")
    - \c options.azure_tenant_id, \c azure_client_id, \c azure_client_secret,
      \c azure_entra_scope: as documented above
*/
public class AzureOpenAiLlmProvider inherits OpenAiRestClient::OpenAiLlmProvider {
    private:internal {
        string deployment;
        string api_version;
        string auth_mode;
        *string tenant_id;
        *string client_id;
        *string client_secret;
        string entra_scope;
    }

    #! Azure routes by deployment name, so there is no default chat model
    /** the model is selected by the \c azure_deployment connection option and
        encoded in the request URL; this override keeps the inherited OpenAI
        default from being sent as a model name
    */
    *string getDefaultModel() {
        return NOTHING;
    }

    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : OpenAiRestClient::OpenAiLlmProvider(config) {
        *string dep = config.provider_options.azure_deployment;
        if (!dep.val()) {
            throw "LLM-CONFIG-ERROR",
                "AzureOpenAiLlmProvider requires options.azure_deployment in "
                "LlmBackendConfig";
        }
        deployment = dep;
        api_version = config.provider_options.azure_api_version
            ?? AzureOpenAiRestClient::DefaultAzureApiVersion;
        auth_mode = config.provider_options.azure_auth_mode
            ?? AzureOpenAiRestClient::AuthModeApiKey;
        tenant_id = config.provider_options.azure_tenant_id;
        client_id = config.provider_options.azure_auth_mode == AuthModeEntraManagedIdentity
            ? (config.provider_options.azure_managed_identity_client_id ?? config.provider_options.azure_client_id)
            : config.provider_options.azure_client_id;
        client_secret = config.provider_options.azure_client_secret;
        entra_scope = config.provider_options.azure_entra_scope
            ?? AzureOpenAiRestClient::DefaultEntraScope;

        switch (auth_mode) {
            case AzureOpenAiRestClient::AuthModeApiKey:
                if (!config.api_key.val()) {
                    throw "LLM-CONFIG-ERROR",
                        "AzureOpenAiLlmProvider auth_mode='api_key' requires "
                        "api_key in LlmBackendConfig";
                }
                break;
            case AzureOpenAiRestClient::AuthModeEntraClientCredentials:
                foreach string field in (("azure_tenant_id", "azure_client_id",
                        "azure_client_secret")) {
                    if (!config.provider_options{field}.val()) {
                        throw "LLM-CONFIG-ERROR",
                            sprintf("AzureOpenAiLlmProvider "
                                "auth_mode='entra_client_credentials' requires "
                                "provider_options.%s", field);
                    }
                }
                break;
            case AzureOpenAiRestClient::AuthModeEntraManagedIdentity:
                # azure_client_id is optional (system-assigned vs user-assigned)
                break;
            default:
                throw "LLM-CONFIG-ERROR",
                    sprintf("unknown azure_auth_mode %y; expected one of "
                        "%y, %y, %y", auth_mode,
                        AzureOpenAiRestClient::AuthModeApiKey,
                        AzureOpenAiRestClient::AuthModeEntraClientCredentials,
                        AzureOpenAiRestClient::AuthModeEntraManagedIdentity);
        }
    }

    string getMode() {
        return "azure-openai";
    }

    #! Returns the Azure-deployment-routed chat completions path
    string getChatCompletionsPath() {
        return sprintf("/openai/deployments/%s/chat/completions?api-version=%s",
            encode_url(deployment, True), encode_url(api_version, True));
    }

    #! Returns the configured deployment name
    string getDeployment() {
        return deployment;
    }

    #! Returns the configured API version
    string getApiVersion() {
        return api_version;
    }

    #! Returns the configured auth mode
    string getAuthMode() {
        return auth_mode;
    }

    #! Builds the auth header according to the configured auth mode
    /** Overrides the OpenAI-compatible default (Authorization: Bearer).
        Cached Entra tokens are refreshed by AzureAuth automatically when
        within the safety window.
    */
    private *hash<auto> buildAuthHeader() {
        switch (auth_mode) {
            case AzureOpenAiRestClient::AuthModeApiKey:
                return {"api-key": getConfig().api_key};
            case AzureOpenAiRestClient::AuthModeEntraClientCredentials: {
                string token = AzureAuth::getEntraTokenClientCredentials(
                    tenant_id, client_id, client_secret, entra_scope);
                return {"Authorization": "Bearer " + token};
            }
            case AzureOpenAiRestClient::AuthModeEntraManagedIdentity: {
                # extract resource URL from scope (drop "/.default" suffix)
                string resource = entra_scope;
                resource =~ s/\/\.default$//;
                string token = AzureAuth::getEntraTokenManagedIdentity(
                    resource, client_id);
                return {"Authorization": "Bearer " + token};
            }
        }
        # unreachable — auth_mode was validated in the constructor
        return NOTHING;
    }
}

#! Factory for @ref AzureOpenAiLlmProvider
public class AzureOpenAiLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "azure-openai";
    }

    string getDisplayName() {
        return "Azure OpenAI Service";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new AzureOpenAiLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            # all features available in API version 2024-10-21 (current default)
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
        };
    }
}
}
