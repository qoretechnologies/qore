# minimum required Qore version
%requires qore >= 2.0
%requires DebugCmdLine
%requires linenoise

%modern
%no-debugging

module DebugLinenoiseCmdLine {
    version = "0.1";
    desc = "user module providing common Linenoise command line debug stuff";
    author = "Tomas Mandys <tomas.mandys@qoretechnologies.org>";
    url = "http://qoretechnologies.org";
    license = "MIT";
}

/** @mainpage DebugLinenoiseCmdLine Module

    @section debuglinenoisecmdlineintro Introduction to the DebugLinenoiseCmdLine Module

    The %DebugLinenoiseCmdLine module provides <a href="https://github.com/antirez/linenoise">linenoise</a> command-line
    editing/history support for %Qore debugging; it is dependent on the binary
    <a href="https://github.com/qoretechnologies/module-linenoise">linenoise</a> module.

    @subsection dlcl_v0_1 v0.1
    - the initial version of the DebugLinenoiseCmdLine module
*/

#! the DebugLinenoiseCmdLine namespace contains all the definitions in the DebugLinenoiseCmdLine module
public namespace DebugLinenoiseCmdLine {
    #! debug linenoise command line class
    public class DebugLinenoiseCommandLine inherits DebugCommandLine {
        public {
            string ln_prompt;
            const defaultHistoryFileName = '.qdbg.history';
            const defaultIndent = "  ";
        }

        #! Creates the object
        constructor() {
            ln_prompt = tc.enabled ? "\033[1;36mqdbg>\033[0m " : "qdbg> ";
        }

        #! Returns all commands from the subclass plus history commands added by this module
        private hash<auto> getCommands() {
            hash<auto> cmds = DebugCommandLine::getCommands();
            cmds.'>' += (
                'history': (
                    '>': (
                        'load': (
                            'desc': 'load command line history from file, args: filename',
                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                *string fn = shift args;
                                if (exists fn) {
                                    Linenoise::history_load(fn);
                                }
                            },
                        ),
                        'save': (
                            'desc': 'save command line history to file, args: filename',
                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                *string fn = shift args;
                                if (exists fn) {
                                    Linenoise::history_save(fn);
                                }
                            },
                        ),

                    ),
                    'desc': 'load or save history to file. The history is implicitly loaded when program starting "
                        "and saved when exiting. See command line parameters.',
                ),
                'quit': (
                    'desc': 'quit debugger',
                    'action': bool sub(DebugCommandLine dcl, softlist path, softlist args) {
                        return True;
                    },
                ),

            );
            return cmds;
        }

        #! Updates the right-side prompt to show current context
        private updateRightPrompt() {
            string rp = "";
            *auto pgmId = getContextValue('programId');
            *auto tid = getContextValue('threadId');
            if (exists pgmId || exists tid) {
                rp = tc.enabled ? "\033[2m[" : "[";
                if (exists pgmId) {
                    rp += sprintf("pgm:%s", pgmId);
                }
                if (exists tid) {
                    if (exists pgmId) {
                        rp += " ";
                    }
                    rp += sprintf("tid:%s", tid);
                }
                rp += tc.enabled ? "]\033[0m" : "]";
            }
            Linenoise::set_right_prompt(rp);
        }

        #! Hints callback for inline argument display
        private *hash<auto> getHints(string input) {
            if (!input.val()) {
                return NOTHING;
            }
            try {
                list<auto> args = splitCmd(input).args;
                if (!args) {
                    return NOTHING;
                }
                *hash<auto> cmd = findCmd(args, fcHelp | fcExpandUniqueCmd);
                if (cmd.cmd.desc) {
                    return {
                        "text": "  " + cmd.cmd.desc,
                        "color": 90,
                        "bold": False,
                    };
                }
            } catch () {
                # suppress exceptions in hints
            }
            return NOTHING;
        }

        #! Syntax highlighting callback
        private string syntaxHighlight(string input) {
            if (!input.val() || !tc.enabled) {
                return input;
            }
            try {
                hash<auto> h = splitCmd(input);
                if (!h.args) {
                    return input;
                }
                *hash<auto> cmd = findCmd(h.args, fcExpandUniqueCmd);
                # colorize recognized command (first token)
                if (h.pos && h.pos.size() > 0) {
                    int cmdStart = h.pos[0].start;
                    int cmdEnd = h.pos[0].end;
                    string cmdText = input.substr(cmdStart, cmdEnd - cmdStart);
                    string prefix = cmdStart > 0 ? input.substr(0, cmdStart) : "";
                    string suffix = cmdEnd < input.size() ? input.substr(cmdEnd) : "";
                    if (cmd.cmd) {
                        return prefix + tc.success(cmdText) + suffix;
                    } else {
                        return prefix + tc.error(cmdText) + suffix;
                    }
                }
            } catch () {
                # suppress exceptions in highlighting
            }
            return input;
        }

        #! Key binding: Ctrl+G — show current program/thread context
        private *hash<auto> keyCtrlG(hash<auto> state) {
            *auto pgmId = getContextValue('programId');
            *auto tid = getContextValue('threadId');
            printfImpl("program: %y, thread: %y", pgmId, tid);
            return NOTHING;
        }

        #! Sets up command-line handling with linenoise
        public runCmdLine() {
            Linenoise::history_set_max_len(1000);
            Linenoise::set_callback(\getLineCompletions());
            Linenoise::set_hints_callback(\getHints());
            Linenoise::set_menu_complete(True);
            Linenoise::set_completion_case_insensitive(True);
            if (tc.enabled) {
                Linenoise::set_syntax_callback(\syntaxHighlight());
            }
            # key bindings
            Linenoise::bind_key("ctrl-g", \keyCtrlG());
            updateRightPrompt();
            string lastLine = '';
            while (True) {
                *string line = Linenoise::line(ln_prompt);
                if (!exists line) {
                    printfImpl("\n^C signal caught. Exiting.\n");
                    break;
                }
                if (line != '') {
                    if (line !~ /^ /) {
                        Linenoise::history_add(line);
                    }
                    lastLine = line;
                } else {
                    line = lastLine;
                }
                try {
                    if (!processCmdLine(line)) {
                        break;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    printfImpl("%s: %s", ex.err, ex.desc);
                }
                updateRightPrompt();
            }
            if (historyFileName) {
                try {
                    Linenoise::history_save(historyFileName);
                } catch (hash<ExceptionInfo> ex) {
                    printfImpl("Cannot save history to %y (%s)\n", historyFileName, ex.desc);
                }
            }
        }

        #! Initializes the history and command-line session
        public init(hash<auto> opt) {
            DebugCommandLine::init(opt);
            # update prompt with current color setting
            ln_prompt = tc.enabled ? "\033[1;36mqdbg>\033[0m " : "qdbg> ";
            if (!exists opt.history) {
                # use file name in home dir
                foreach string k in (('HOME', 'USERPROFILE')) {
                    if (exists ENV{k}) {
                        historyFileName = ENV{k} + DirSep + defaultHistoryFileName;
                        break;
                    }
                }
            } else if (opt.history != '.') {
                historyFileName = opt.history;
            }
            if (historyFileName) {
                try {
                    Linenoise::history_load(historyFileName);
                } catch (hash<ExceptionInfo> ex) {
                    printfImpl("Cannot load history from %y (%s)\n", historyFileName, ex.desc);
                }
            }
            if (opt.session) {
                try {
                    loadSession(opt.session);
                } catch (hash<ExceptionInfo> ex) {
                    printfImpl("Cannot load session from %y (%s)\n", opt.session, ex.desc);
                }
            }
        }

        #! Outputs data to a linenoise-configured terminal
        public printfImpl(string fmt, ...) {
            string outs = vsprintf(fmt, argv);
            # linenoise terminal has somehow redefined CRLF so force \r (TODO: what is Qore line delimiter on Windows ?)
            outs = replace(outs, "\n", "\r\n");
            if (outs !~ /\n$/) {
                outs += "\r\n";
            }
            stdout.print(outs);
            # TODO: how refresh linenoise command line ?
        }
    }
}
