# minimum required Qore version
%requires qore >= 2.0
%requires DebugCmdLine
%requires linenoise

%modern
%no-debugging

module DebugLinenoiseCmdLine {
    version = "0.2";
    desc = "user module providing common Linenoise command line debug stuff";
    author = "Tomas Mandys <tomas.mandys@qoretechnologies.org>";
    url = "http://qoretechnologies.org";
    license = "MIT";
}

/** @mainpage DebugLinenoiseCmdLine Module

    @section debuglinenoisecmdlineintro Introduction to the DebugLinenoiseCmdLine Module

    The %DebugLinenoiseCmdLine module provides <a href="https://github.com/antirez/linenoise">linenoise</a> command-line
    editing/history support for %Qore debugging; it is dependent on the binary
    <a href="https://github.com/qoretechnologies/module-linenoise">linenoise</a> module.

    @subsection dlcl_v0_2 v0.2
    - files of commands: the init file (\c .qdbginit in the home folder, or the file of \c -i, unless \c -n is given)
      and the files of \c -x are run at the start; see
      @ref DebugLinenoiseCmdLine::DebugLinenoiseCommandLine::getStartupCommandFiles() "getStartupCommandFiles()"
    - with input that is not a terminal, a command that resumes a thread returns when a thread pauses, or when the
      thread stops being debugged (see \c waitsForStops)
    - \c history \c load and \c history \c save without a file name show an error
    - JSON output (see @ref DebugCmdLine::DebugCommandLine::jsonOutput "jsonOutput"): the commands are read without
      a prompt and written to
      @ref DebugLinenoiseCmdLine::DebugLinenoiseCommandLine::outputFile "outputFile"
    - the wait of a command that resumes a thread is limited by
      @ref DebugCmdLine::DebugCommandLine::waitTimeout "waitTimeout"; then the program is paused

    @subsection dlcl_v0_1 v0.1
    - initial release
*/

#! the DebugLinenoiseCmdLine namespace contains all the definitions in the DebugLinenoiseCmdLine module
public namespace DebugLinenoiseCmdLine {
    #! debug linenoise command line class
    public class DebugLinenoiseCommandLine inherits DebugCommandLine {
        public {
            string ln_prompt;
            const defaultHistoryFileName = '.qdbg.history';
            #! the name of the file of commands in the home folder that the debugger runs at its start; see
            #! getStartupCommandFiles()
            const defaultInitFileName = '.qdbginit';
            const defaultIndent = "  ";
        }

        private {
            #! guards the wait for a thread to stop; see waitsForStops
            Mutex stopLock();
            #! signaled when a thread pauses, or when the thread that is waited for stops being debugged
            Condition stopCond();
            #! True while a thread is waited for to stop
            bool stopPending;
            #! the thread that is waited for to stop; any thread if not set
            *int stopTid;
            #! serializes the lines of the output; see writeOutputLine()
            Mutex writeLock();
        }

        public {
            #! the file of the output; stdout if not set, as when the output of the debugged program is captured
            /** @since DebugLinenoiseCmdLine 0.2
            */
            *File outputFile;
        }

        #! Creates the object
        constructor() {
            ln_prompt = tc.enabled ? "\033[1;36mqdbg>\033[0m " : "qdbg> ";
        }

        #! Returns True if a command resumes a thread and returns when it stops again; see waitsForStops
        /** A command with \c "wait" @ref False, as of a thread that continues with another one, does not wait
        */
        bool resumesWithWait(hash<auto> data) {
            return waitsForStops && data.cmd =~ /^thread\/go(\/|$)/ && data.wait !== False;
        }

        #! Starts waiting for a thread to stop; for any thread if \a tid is not given
        /** The wait starts before the command that resumes the thread is sent, as the thread can stop again before the
            answer to the command is received
        */
        expectStop(*int tid) {
            AutoLock al(stopLock);
            stopTid = tid;
            stopPending = True;
        }

        #! Stops waiting for a thread to stop
        cancelStop() {
            AutoLock al(stopLock);
            stopPending = False;
            stopCond.broadcast();
        }

        #! Waits until a thread pauses, the thread that is waited for stops being debugged, or the program ends
        /** With a wait timeout (see DebugCommandLine::waitTimeout), the program is paused when no thread pauses in
            time, and the wait for the pause takes as long at most; a thread that waits, as for a lock or I/O, pauses
            only when it continues
        */
        waitForStop() {
            bool paused;
            {
                AutoLock al(stopLock);
                paused = waitForStopIntern();
            }
            if (!paused) {
                pauseAfterTimeout();
            }
            # when all threads stop together, the next command is processed when the other threads are requested to
            # stop
            waitForStopRequests();
        }

        #! Waits for the stop that is expected, as long as the wait timeout at most; returns @ref False if the time
        #! passed, and the stop is no longer expected; stopLock must be held
        private bool waitForStopIntern() {
            if (!waitTimeout) {
                while (stopPending) {
                    stopCond.wait(stopLock);
                }
                return True;
            }
            int deadline = clock_getmicros() + waitTimeout * 1000;
            while (stopPending) {
                int remaining = deadline - clock_getmicros();
                if (remaining <= 0) {
                    stopPending = False;
                    return False;
                }
                stopCond.wait(stopLock, microseconds(remaining));
            }
            return True;
        }

        #! Pauses the current program after no thread paused in time, and waits for the pause; see waitForStop()
        private pauseAfterTimeout() {
            setCommandTimedOut();
            *softint pgm_id = getContextValue('programId');
            if (!exists pgm_id) {
                printfImpl("%s\n", tc.warning(sprintf("No thread paused within %d ms", waitTimeout)));
                return;
            }
            printfImpl("%s\n", tc.warning(sprintf("No thread paused within %d ms; pausing the program",
                waitTimeout)));
            expectStop();
            bool paused;
            {
                on_error cancelStop();
                doCommand({"cmd": "program/" + pgm_id + "/stop"}, False);
                AutoLock al(stopLock);
                paused = waitForStopIntern();
            }
            if (!paused) {
                printfImpl("%s\n", tc.warning(sprintf("No thread paused within %d ms after the request; a thread "
                    "that waits, as for a lock or I/O, pauses when it continues", waitTimeout)));
            }
        }

        #! Processes an event of the debug server: a thread that is waited for stops or stops being debugged
        eventReceived(hash<auto> data) {
            # a thread that starts, or that the debugger resumes, does not pause; see DebugCommandLine::processEvent(),
            # which handles the event before
            if (DebugCommandLine::isThreadStart(data)
                || (data.cmd == DebugEventCmd::Interrupt && data.func != "detach" && isAutoResumed(data.tid))) {
                return;
            }
            if (data.type != DebugResponseType::Event
                || (data.cmd != DebugEventCmd::Interrupt
                    && (data.cmd != DebugEventCmd::Run || data.runstate != "detach"))) {
                return;
            }
            AutoLock al(stopLock);
            if (!stopPending) {
                return;
            }
            # the wait ends when any thread pauses, as in other debuggers, as a thread that is resumed can wait for one
            # that pauses; it also ends when the thread that is waited for leaves the program or is no longer debugged;
            # the end of the code of a thread is not a pause, as the thread is resumed (see
            # DebugCommandLine::processEvent())
            if (data.cmd == DebugEventCmd::Interrupt && data.func == "exit") {
                return;
            }
            bool pause = data.cmd == DebugEventCmd::Interrupt && data.func != "detach";
            if (pause || !exists stopTid || data.tid == stopTid) {
                stopPending = False;
                stopCond.broadcast();
            }
        }

        #! Writes a line of the output as it is, as a line of JSON output
        /** @since DebugLinenoiseCmdLine 0.2
        */
        public writeOutputLine(string line) {
            AutoLock al(writeLock);
            (outputFile ?? stdout).print(line + "\n");
        }

        #! Returns all commands from the subclass plus history commands added by this module
        private hash<auto> getCommands() {
            hash<auto> cmds = DebugCommandLine::getCommands();
            cmds.'>' += (
                'history': (
                    '>': (
                        'load': (
                            'desc': 'Load the commands that the up and down arrow keys recall from a file. Usage: '
                                'history load <file>',
                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                *string fn = shift args;
                                if (!exists fn) {
                                    throw "DEBUG-COMMAND", "the name of the file is missing: history load <file>";
                                }
                                Linenoise::history_load(fn);
                            },
                        ),
                        'save': (
                            'desc': 'Save the commands that the up and down arrow keys recall to a file. Usage: '
                                'history save <file>',
                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                *string fn = shift args;
                                if (!exists fn) {
                                    throw "DEBUG-COMMAND", "the name of the file is missing: history save <file>";
                                }
                                Linenoise::history_save(fn);
                            },
                        ),

                    ),
                    'desc': 'Load or save the commands that the up and down arrow keys recall. They are loaded when '
                        'the debugger starts and saved when it ends, in the file of the -y (--history) option.',
                ),
                'quit': (
                    'desc': 'End the debugger.',
                    'action': bool sub(DebugCommandLine dcl, softlist path, softlist args) {
                        return True;
                    },
                ),

            );
            return cmds;
        }

        #! Updates the right-side prompt to show current context
        private updateRightPrompt() {
            string rp = "";
            *auto pgmId = getContextValue('programId');
            *auto tid = getContextValue('threadId');
            if (exists pgmId || exists tid) {
                rp = tc.enabled ? "\033[2m[" : "[";
                if (exists pgmId) {
                    rp += sprintf("pgm:%s", pgmId);
                }
                if (exists tid) {
                    if (exists pgmId) {
                        rp += " ";
                    }
                    rp += sprintf("tid:%s", tid);
                }
                rp += tc.enabled ? "]\033[0m" : "]";
            }
            Linenoise::set_right_prompt(rp);
        }

        #! Hints callback for inline argument display
        private *hash<auto> getHints(string input) {
            if (!input.val()) {
                return NOTHING;
            }
            try {
                list<auto> args = splitCmd(input).args;
                if (!args) {
                    return NOTHING;
                }
                *hash<auto> cmd = findCmd(args, fcHelp | fcExpandUniqueCmd);
                if (cmd.cmd.desc) {
                    return {
                        "text": "  " + cmd.cmd.desc,
                        "color": 90,
                        "bold": False,
                    };
                }
            } catch () {
                # suppress exceptions in hints
            }
            return NOTHING;
        }

        #! Syntax highlighting callback
        private string syntaxHighlight(string input) {
            if (!input.val() || !tc.enabled) {
                return input;
            }
            try {
                hash<auto> h = splitCmd(input);
                if (!h.args) {
                    return input;
                }
                *hash<auto> cmd = findCmd(h.args, fcExpandUniqueCmd);
                # colorize recognized command (first token)
                if (h.pos && h.pos.size() > 0) {
                    int cmdStart = h.pos[0].start;
                    int cmdEnd = h.pos[0].end;
                    string cmdText = input.substr(cmdStart, cmdEnd - cmdStart);
                    string prefix = cmdStart > 0 ? input.substr(0, cmdStart) : "";
                    string suffix = cmdEnd < input.size() ? input.substr(cmdEnd) : "";
                    if (cmd.cmd) {
                        return prefix + tc.success(cmdText) + suffix;
                    } else {
                        return prefix + tc.error(cmdText) + suffix;
                    }
                }
            } catch () {
                # suppress exceptions in highlighting
            }
            return input;
        }

        #! Key binding: Ctrl+G — show current program/thread context
        private *hash<auto> keyCtrlG(hash<auto> state) {
            *auto pgmId = getContextValue('programId');
            *auto tid = getContextValue('threadId');
            printfImpl("program: %y, thread: %y", pgmId, tid);
            return NOTHING;
        }

        #! Sets up command-line handling with linenoise
        public runCmdLine() {
            Linenoise::history_set_max_len(1000);
            Linenoise::set_callback(\getLineCompletions());
            Linenoise::set_hints_callback(\getHints());
            Linenoise::set_menu_complete(True);
            Linenoise::set_completion_case_insensitive(True);
            if (tc.enabled) {
                Linenoise::set_syntax_callback(\syntaxHighlight());
            }
            # key bindings
            Linenoise::bind_key("ctrl-g", \keyCtrlG());
            updateRightPrompt();
            string lastLine = '';
            while (True) {
                # the display expressions of a thread that stopped since the last command
                showPendingDisplays();
                # JSON output is for programs, which write commands without a prompt and without editing
                *string line = jsonOutput ? stdin.readLine(False) : Linenoise::line(ln_prompt);
                # the end of the input, or Ctrl+D or Ctrl+C in a terminal
                if (!exists line) {
                    if (stdin.isTty()) {
                        printfImpl("\n");
                    }
                    break;
                }
                if (jsonOutput) {
                    # an empty line does not repeat the last command for a program
                    trim line;
                    if (line == '') {
                        continue;
                    }
                } else if (line != '') {
                    if (line !~ /^ /) {
                        Linenoise::history_add(line);
                    }
                    lastLine = line;
                } else {
                    line = lastLine;
                }
                try {
                    if (!processCmdLine(line)) {
                        break;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    printfImpl("%s %s", tc.error("Error:"), DebugCommandLine::getErrorText(ex));
                }
                updateRightPrompt();
            }
            if (historyFileName) {
                try {
                    Linenoise::history_save(historyFileName);
                } catch (hash<ExceptionInfo> ex) {
                    printfImpl("Cannot save history to %y (%s)\n", historyFileName, ex.desc);
                }
            }
        }

        #! Returns the files of commands that the debugger runs at its start
        /** @param opt the options of the command line: \c init_file (\c -i: a file of commands instead of the file in
            the home folder), \c no_init (\c -n: no such file), and \c execute (\c -x: files of commands that are run
            after it)

            @return the init file, which is the file of \c -i or \c .qdbginit in the home folder if it exists, unless
            \c no_init is set, and the files of \c execute

            @since DebugLinenoiseCmdLine 0.2
        */
        static list<string> getStartupCommandFiles(hash<auto> opt) {
            list<string> rv = ();
            if (!opt.no_init) {
                if (opt.init_file) {
                    push rv, opt.init_file;
                } else {
                    foreach string k in (('HOME', 'USERPROFILE')) {
                        if (exists ENV{k}) {
                            string fn = ENV{k} + DirSep + defaultInitFileName;
                            if (is_file(fn)) {
                                push rv, fn;
                            }
                            break;
                        }
                    }
                }
            }
            foreach string fn in (opt.execute) {
                push rv, fn;
            }
            return rv;
        }

        #! Runs the files of commands of the start of the debugger; see getStartupCommandFiles() and runCommandFile()
        /** An error of a command ends its file, and the next file is run

            @return @ref False if a command ended the debugger, as \c quit

            @since DebugLinenoiseCmdLine 0.2
        */
        bool runStartupCommandFiles(list<string> files) {
            foreach string fn in (files) {
                try {
                    if (!runCommandFile(fn)) {
                        return False;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    # a command that failed has been shown with the line of the file
                    if (ex.err != "DEBUG-COMMAND-FILE") {
                        printfImpl("%s %s\n", tc.error("Error:"), DebugCommandLine::getErrorText(ex));
                    }
                }
            }
            return True;
        }

        #! Initializes the history and command-line session
        public init(hash<auto> opt) {
            DebugCommandLine::init(opt);
            # update prompt with current color setting
            ln_prompt = tc.enabled ? "\033[1;36mqdbg>\033[0m " : "qdbg> ";
            if (!exists opt.history) {
                # use file name in home dir
                foreach string k in (('HOME', 'USERPROFILE')) {
                    if (exists ENV{k}) {
                        historyFileName = ENV{k} + DirSep + defaultHistoryFileName;
                        break;
                    }
                }
            } else if (opt.history != '.') {
                historyFileName = opt.history;
            }
            if (historyFileName) {
                try {
                    Linenoise::history_load(historyFileName);
                } catch (hash<ExceptionInfo> ex) {
                    printfImpl("Cannot load history from %y (%s)\n", historyFileName, ex.desc);
                }
            }
            if (opt.session) {
                try {
                    loadSession(opt.session);
                } catch (hash<ExceptionInfo> ex) {
                    printfImpl("Cannot load session from %y (%s)\n", opt.session, ex.desc);
                }
            }
        }

        #! Outputs data to a linenoise-configured terminal; with JSON output, the text is a part of the output of the
        #! current command; see DebugCommandLine::printJsonText()
        public printfImpl(string fmt, ...) {
            string outs = vsprintf(fmt, argv);
            if (jsonOutput) {
                printJsonText(outs);
                return;
            }
            # linenoise terminal has somehow redefined CRLF so force \r (TODO: what is Qore line delimiter on Windows ?)
            outs = replace(outs, "\n", "\r\n");
            if (outs !~ /\n$/) {
                outs += "\r\n";
            }
            AutoLock al(writeLock);
            (outputFile ?? stdout).print(outs);
            # TODO: how refresh linenoise command line ?
        }
    }
}
