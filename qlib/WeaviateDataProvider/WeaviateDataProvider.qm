%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) WeaviateRestClient
%requires RestClientIo

module WeaviateDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Weaviate vector DB";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new WeaviateDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": WeaviateDataProvider::AppName,
            "display_name": "Weaviate",
            "short_desc": "Weaviate open-source vector database with hybrid search",
            "desc": "Provides access to [Weaviate](https://weaviate.io) — an open-source "
                "vector database supporting hybrid search (vector + keyword), "
                "multi-tenancy, and a wide range of vectorizer modules.\n\n"
                "Use the @ref QoreRagUtils::WeaviateVectorStore \"WeaviateVectorStore\" "
                "backend in @ref qorerragutilsintro \"QoreRagUtils\" for the supported "
                "ingest/retrieve path through @ref QoreRagUtils::RagPipeline "
                "\"RagPipeline\".",
            "scheme": "weaviate",
            "logo": WeaviateLogo,
            "logo_file_name": "weaviate-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Databases,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WeaviateDataProvider::AppName,
            "path": "/list-classes",
            "action": "list-classes",
            "display_name": "List Schema Classes",
            "short_desc": "List Weaviate schema classes",
            "desc": "Calls `GET /v1/schema` to enumerate the configured Weaviate classes "
                "(name, properties, vectorizer, sharding config).",
            "action_code": DPAT_API,
            "groups": ("Admin",),
            "options": {},
            "output_type": WeaviateListClassesDataProvider::ResponseType,
        });
    };
}

/** @mainpage WeaviateDataProvider Module

    @tableofcontents

    @section weaviatedataproviderintro WeaviateDataProvider Introduction

    Lightweight data-provider integration for
    [Weaviate](https://weaviate.io).  For full vector operations use the
    @ref QoreRagUtils::WeaviateVectorStore "WeaviateVectorStore" backend
    via @ref QoreRagUtils::RagPipeline "RagPipeline".

    @section WeaviateDataProviderRelnotes Release Notes

    @subsection WeaviateDataProviderv1_0 WeaviateDataProvider v1.0
    - the initial version of the %WeaviateDataProvider module
*/

#! contains all public definitions in the WeaviateDataProvider module
public namespace WeaviateDataProvider {
#! Weaviate application name
public const AppName = "Weaviate";
}

#! App logo loaded from file
public const WeaviateLogo = File::readTextFile(get_script_dir() + "/weaviate-logo.svg");
