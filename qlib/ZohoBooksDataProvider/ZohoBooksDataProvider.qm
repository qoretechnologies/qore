# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) ZohoBooksRestClient
%try-module json
%define NoJson
%endtry

module ZohoBooksDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Zoho Books accounting and invoicing";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new ZohoBooksDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ZohoBooksDataProvider::AppName,
            "display_name": "Zoho Books",
            "short_desc": "Zoho Books online accounting software",
            "desc": "Zoho Books is online accounting software that manages your finances, "
                "automates business workflows, and helps you work collectively across departments.\n\n"
                "This integration supports invoices, bills, payments, contacts, expenses, estimates, "
                "sales orders, purchase orders, and items.",
            "scheme": "zohobooks",
            "logo": ZohoBooksLogo,
            "logo_file_name": "zohobooks-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AccountingErp,),
        });

        # ========== INVOICE ACTIONS ==========

        # Create Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-invoice",
            "action": "create-invoice",
            "groups": "Invoices",
            "display_name": "Create Invoice",
            "short_desc": "Create a new invoice",
            "desc": "Create a new invoice in Zoho Books for a customer",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "Customer identifier",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
            } + DataProviderActionCatalog::getActionOptionFromFields(
                ZohoBooksCreateInvoiceRequestDataType::Fields{"line_items",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ZohoBooksCreateInvoiceRequestDataType::Fields - ("customer_id", "line_items",)
            ),
            "get_output_type": AbstractDataProviderType sub () { return new ZohoBooksInvoiceDataType(); },
        });

        # Update Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/update-invoice",
            "action": "update-invoice",
            "groups": "Invoices",
            "display_name": "Update Invoice",
            "short_desc": "Update an existing invoice",
            "desc": "Update an existing invoice in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
            } + DataProviderActionCatalog::getActionOptionFromFields(
                ZohoBooksUpdateInvoiceRequestDataType::Fields{"invoice_id",}, {
                    "preselected": True,
                    "required": True,
                    "ref_data": "invoices",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ZohoBooksUpdateInvoiceRequestDataType::Fields - ("invoice_id",)
            ),
            "get_output_type": AbstractDataProviderType sub () { return new ZohoBooksInvoiceDataType(); },
        });

        # Delete Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/delete-invoice",
            "action": "delete-invoice",
            "groups": "Invoices",
            "display_name": "Delete Invoice",
            "short_desc": "Delete an invoice",
            "desc": "Delete an invoice from Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "invoices",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return ZohoBooksDeleteInvoiceDataProvider::ResponseType; },
        });

        # Get Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/get-invoice",
            "action": "get-invoice",
            "groups": "Invoices",
            "display_name": "Get Invoice",
            "short_desc": "Get invoice details",
            "desc": "Retrieve details of a specific invoice",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "invoices",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ZohoBooksInvoiceDataType(); },
        });

        # List Invoices
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/invoices",
            "action": "list-invoices",
            "groups": "Invoices",
            "display_name": "List Invoices",
            "short_desc": "List all invoices",
            "desc": "Retrieve a list of invoices with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by invoice status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "draft", "desc": "Draft invoices"},
                        <AllowedValueInfo>{"value": "sent", "desc": "Sent invoices"},
                        <AllowedValueInfo>{"value": "overdue", "desc": "Overdue invoices"},
                        <AllowedValueInfo>{"value": "paid", "desc": "Paid invoices"},
                        <AllowedValueInfo>{"value": "void", "desc": "Voided invoices"},
                        <AllowedValueInfo>{"value": "unpaid", "desc": "Unpaid invoices"},
                        <AllowedValueInfo>{"value": "partially_paid", "desc": "Partially paid invoices"},
                    ),
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
            },
        });

        # Email Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/email-invoice",
            "action": "email-invoice",
            "groups": "Invoices",
            "display_name": "Email Invoice",
            "short_desc": "Send an invoice by email",
            "desc": "Send an invoice to the customer via email",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to email",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "invoices",
                },
                "to_mail_ids": <ActionOptionInfo>{
                    "display_name": "To",
                    "short_desc": "Recipient email addresses",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "Email addresses to send the invoice to",
                },
                "subject": <ActionOptionInfo>{
                    "display_name": "Subject",
                    "short_desc": "Email subject",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "body": <ActionOptionInfo>{
                    "display_name": "Body",
                    "short_desc": "Email body",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return ZohoBooksEmailInvoiceDataProvider::ResponseType; },
        });

        # ========== BILL ACTIONS ==========

        # Create Bill
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-bill",
            "action": "create-bill",
            "groups": "Bills",
            "display_name": "Create Bill",
            "short_desc": "Create a new bill",
            "desc": "Create a new bill from a vendor in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "vendor_id": <ActionOptionInfo>{
                    "display_name": "Vendor",
                    "short_desc": "The vendor for the bill",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "vendors",
                },
                "bill_number": <ActionOptionInfo>{
                    "display_name": "Bill Number",
                    "short_desc": "Unique bill identifier",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "A unique sequential identifier for the bill",
                },
                "date": <ActionOptionInfo>{
                    "display_name": "Bill Date",
                    "short_desc": "Bill issue date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Bill issue date in `yyyy-mm-dd` format",
                },
                "due_date": <ActionOptionInfo>{
                    "display_name": "Due Date",
                    "short_desc": "Payment due date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Payment due date in `yyyy-mm-dd` format",
                },
                "reference_number": <ActionOptionInfo>{
                    "display_name": "Reference Number",
                    "short_desc": "External vendor reference",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Vendor's reference number for this bill",
                },
                "line_items": <ActionOptionInfo>{
                    "display_name": "Line Items",
                    "short_desc": "Bill line items",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of line items with fields: `item_id`, `name`, `description`, `quantity`, `rate`, `account_id`, `tax_id`",
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Additional notes",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "terms": <ActionOptionInfo>{
                    "display_name": "Terms",
                    "short_desc": "Payment and delivery terms",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ZohoBooksBillDataType(); },
        });

        # Update Bill
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/update-bill",
            "action": "update-bill",
            "groups": "Bills",
            "display_name": "Update Bill",
            "short_desc": "Update an existing bill",
            "desc": "Update an existing bill in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "bill_id": <ActionOptionInfo>{
                    "display_name": "Bill ID",
                    "short_desc": "The bill to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "bills",
                },
                "vendor_id": <ActionOptionInfo>{
                    "display_name": "Vendor",
                    "short_desc": "The vendor for the bill",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "vendors",
                },
                "bill_number": <ActionOptionInfo>{
                    "display_name": "Bill Number",
                    "short_desc": "Unique bill identifier",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "date": <ActionOptionInfo>{
                    "display_name": "Bill Date",
                    "short_desc": "Bill issue date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Bill issue date in `yyyy-mm-dd` format",
                },
                "due_date": <ActionOptionInfo>{
                    "display_name": "Due Date",
                    "short_desc": "Payment due date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Payment due date in `yyyy-mm-dd` format",
                },
                "reference_number": <ActionOptionInfo>{
                    "display_name": "Reference Number",
                    "short_desc": "External vendor reference",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "line_items": <ActionOptionInfo>{
                    "display_name": "Line Items",
                    "short_desc": "Bill line items",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of line items with fields: `item_id`, `name`, `description`, `quantity`, `rate`, `account_id`, `tax_id`",
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Additional notes",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "terms": <ActionOptionInfo>{
                    "display_name": "Terms",
                    "short_desc": "Payment and delivery terms",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ZohoBooksBillDataType(); },
        });

        # Delete Bill
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/delete-bill",
            "action": "delete-bill",
            "groups": "Bills",
            "display_name": "Delete Bill",
            "short_desc": "Delete a bill",
            "desc": "Delete a bill from Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "bill_id": <ActionOptionInfo>{
                    "display_name": "Bill ID",
                    "short_desc": "The bill to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "bills",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderTypeMap."hash"; },
        });

        # Get Bill
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/get-bill",
            "action": "get-bill",
            "groups": "Bills",
            "display_name": "Get Bill",
            "short_desc": "Get bill details",
            "desc": "Retrieve details of a specific bill",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "bill_id": <ActionOptionInfo>{
                    "display_name": "Bill ID",
                    "short_desc": "The bill to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "bills",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ZohoBooksBillDataType(); },
        });

        # List Bills
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/bills",
            "action": "list-bills",
            "groups": "Bills",
            "display_name": "List Bills",
            "short_desc": "List all bills",
            "desc": "Retrieve a list of bills with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by bill status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "open", "desc": "Open bills"},
                        <AllowedValueInfo>{"value": "overdue", "desc": "Overdue bills"},
                        <AllowedValueInfo>{"value": "paid", "desc": "Paid bills"},
                        <AllowedValueInfo>{"value": "void", "desc": "Voided bills"},
                        <AllowedValueInfo>{"value": "partially_paid", "desc": "Partially paid bills"},
                    ),
                },
                "vendor_id": <ActionOptionInfo>{
                    "display_name": "Vendor",
                    "short_desc": "Filter by vendor",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "vendors",
                },
            },
        });

        # ========== PAYMENT ACTIONS ==========

        # Create Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-payment",
            "action": "create-payment",
            "groups": "Payments",
            "display_name": "Create Payment",
            "short_desc": "Create a new payment",
            "desc": "Record a payment received from a customer",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer making the payment",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "Payment amount",
                    "type": AbstractDataProviderTypeMap."float",
                    "required": True,
                    "preselected": True,
                },
                "date": <ActionOptionInfo>{
                    "display_name": "Payment Date",
                    "short_desc": "Date of payment",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Payment date in `yyyy-mm-dd` format",
                },
                "payment_mode": <ActionOptionInfo>{
                    "display_name": "Payment Mode",
                    "short_desc": "Mode of payment",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The mode of payment used",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "cash", "desc": "Cash payment"},
                        <AllowedValueInfo>{"value": "check", "desc": "Check payment"},
                        <AllowedValueInfo>{"value": "creditcard", "desc": "Credit card payment"},
                        <AllowedValueInfo>{"value": "banktransfer", "desc": "Bank transfer"},
                        <AllowedValueInfo>{"value": "bankremittance", "desc": "Bank remittance"},
                        <AllowedValueInfo>{"value": "autotransaction", "desc": "Auto transaction"},
                    ),
                },
                "reference_number": <ActionOptionInfo>{
                    "display_name": "Reference Number",
                    "short_desc": "Transaction reference",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Reference number for the payment transaction",
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "Payment description",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "invoices": <ActionOptionInfo>{
                    "display_name": "Invoices",
                    "short_desc": "Invoices to apply payment to",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of invoices with fields: `invoice_id`, `amount_applied`",
                },
                "account_id": <ActionOptionInfo>{
                    "display_name": "Deposit Account",
                    "short_desc": "Account to deposit payment",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "ID of the account where the payment will be deposited",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ZohoBooksPaymentDataType(); },
        });

        # Update Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/update-payment",
            "action": "update-payment",
            "groups": "Payments",
            "display_name": "Update Payment",
            "short_desc": "Update an existing payment",
            "desc": "Update an existing payment record",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "payment_id": <ActionOptionInfo>{
                    "display_name": "Payment ID",
                    "short_desc": "The payment to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "payments",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer making the payment",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "Payment amount",
                    "type": AbstractDataProviderTypeMap."*float",
                },
                "date": <ActionOptionInfo>{
                    "display_name": "Payment Date",
                    "short_desc": "Date of payment",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Payment date in `yyyy-mm-dd` format",
                },
                "payment_mode": <ActionOptionInfo>{
                    "display_name": "Payment Mode",
                    "short_desc": "Mode of payment",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "reference_number": <ActionOptionInfo>{
                    "display_name": "Reference Number",
                    "short_desc": "Transaction reference",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "Payment description",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "invoices": <ActionOptionInfo>{
                    "display_name": "Invoices",
                    "short_desc": "Invoices to apply payment to",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of invoices with fields: `invoice_id`, `amount_applied`",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ZohoBooksPaymentDataType(); },
        });

        # Delete Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/delete-payment",
            "action": "delete-payment",
            "groups": "Payments",
            "display_name": "Delete Payment",
            "short_desc": "Delete a payment",
            "desc": "Delete a payment record from Zoho Books",
