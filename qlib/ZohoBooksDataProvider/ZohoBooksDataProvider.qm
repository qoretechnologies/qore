                    "ref_data": "organizations",
                },
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "How often to check for new vendors (seconds)",
                    "type": AbstractDataProviderTypeMap."int",
                    "default_value": DefaultPollInterval,
                },
            },
        });
    };
}

/** @mainpage ZohoBooksDataProvider Module

    @tableofcontents

    @section zohobooksdataproviderintro ZohoBooksDataProvider Introduction

    The %ZohoBooksDataProvider module provides a data provider API for Zoho Books accounting
    and invoicing through the Zoho Books REST API.

    To use this module, use \c "%requires ZohoBooksDataProvider" in your code.

    All the public symbols in the module are defined in the ZohoBooksDataProvider namespace.

    The main classes are:
    - @ref ZohoBooksDataProvider::ZohoBooksDataProvider "ZohoBooksDataProvider":
      the root data provider for Zoho Books with child providers for invoices, bills, payments, etc.

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires ZohoBooksDataProvider
%requires ZohoBooksRestClient

# Create a REST client with credentials
ZohoBooksRestClient rest({
    "oauth2_client_id": ENV.ZOHOBOOKS_CLIENT_ID,
    "oauth2_client_secret": ENV.ZOHOBOOKS_CLIENT_SECRET,
    "oauth2_refresh_token": ENV.ZOHOBOOKS_REFRESH_TOKEN,
    "organization_id": ENV.ZOHOBOOKS_ORGANIZATION_ID,
    "subdomain": "zoho",
    "domain": ".com",
});

# Create a data provider from the REST client
ZohoBooksDataProvider zoho(rest);

# List invoices
map printf("Invoice: %s - %s\n", $1.invoice_number, $1.total),
    zoho.getChildProvider("invoices").searchRecords();
    @endcode

    @section zohobooksdataproviderrelnotes Release Notes

    @subsection zohobooksdataproviderv1_0 ZohoBooksDataProvider v1.0
    - the initial version of the %ZohoBooksDataProvider module
*/

#! Contains all public definitions in the ZohoBooksDataProvider module
public namespace ZohoBooksDataProvider {
}
