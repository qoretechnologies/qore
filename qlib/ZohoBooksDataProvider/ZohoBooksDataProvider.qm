# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%new-style
# require type definitions everywhere
%require-types
# strict argument handling
%strict-args
# enable all warnings
%enable-all-warnings

%requires(reexport) DataProvider
%requires(reexport) ZohoBooksRestClient
%requires json

module ZohoBooksDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Zoho Books accounting and invoicing";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new ZohoBooksDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ZohoBooksDataProvider::AppName,
            "display_name": "Zoho Books",
            "short_desc": "Zoho Books online accounting software",
            "desc": "Zoho Books is online accounting software that manages your finances, "
                "automates business workflows, and helps you work collectively across departments.\n\n"
                "This integration supports invoices, bills, payments, contacts, expenses, estimates, "
                "sales orders, purchase orders, and items.",
            "scheme": "zohobooks",
            "logo": ZohoBooksLogo,
            "logo_file_name": "zohobooks-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AccountingErp,),
        });

        # ========== INVOICE ACTIONS ==========

        # Create Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-invoice",
            "action": "create-invoice",
            "groups": "Invoices",
            "display_name": "Create Invoice",
            "short_desc": "Create a new invoice",
            "desc": "Create a new invoice in Zoho Books for a customer",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer for the invoice",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
            },
        });

        # Update Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/update-invoice",
            "action": "update-invoice",
            "groups": "Invoices",
            "display_name": "Update Invoice",
            "short_desc": "Update an existing invoice",
            "desc": "Update an existing invoice in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Delete Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/delete-invoice",
            "action": "delete-invoice",
            "groups": "Invoices",
            "display_name": "Delete Invoice",
            "short_desc": "Delete an invoice",
            "desc": "Delete an invoice from Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Get Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/get-invoice",
            "action": "get-invoice",
            "groups": "Invoices",
            "display_name": "Get Invoice",
            "short_desc": "Get invoice details",
            "desc": "Retrieve details of a specific invoice",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # List Invoices
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/invoices",
            "action": "list-invoices",
            "groups": "Invoices",
            "display_name": "List Invoices",
            "short_desc": "List all invoices",
            "desc": "Retrieve a list of invoices with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by invoice status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "draft", "desc": "Draft invoices"},
                        <AllowedValueInfo>{"value": "sent", "desc": "Sent invoices"},
                        <AllowedValueInfo>{"value": "overdue", "desc": "Overdue invoices"},
                        <AllowedValueInfo>{"value": "paid", "desc": "Paid invoices"},
                        <AllowedValueInfo>{"value": "void", "desc": "Voided invoices"},
                        <AllowedValueInfo>{"value": "unpaid", "desc": "Unpaid invoices"},
                        <AllowedValueInfo>{"value": "partially_paid", "desc": "Partially paid invoices"},
                    ),
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
            },
        });

        # Email Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/email-invoice",
            "action": "email-invoice",
            "groups": "Invoices",
            "display_name": "Email Invoice",
            "short_desc": "Send an invoice by email",
            "desc": "Send an invoice to the customer via email",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to email",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "to_mail_ids": <ActionOptionInfo>{
                    "display_name": "To",
                    "short_desc": "Recipient email addresses",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "Email addresses to send the invoice to",
                },
                "subject": <ActionOptionInfo>{
                    "display_name": "Subject",
                    "short_desc": "Email subject",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "body": <ActionOptionInfo>{
                    "display_name": "Body",
                    "short_desc": "Email body",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # ========== BILL ACTIONS ==========

        # Create Bill
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-bill",
            "action": "create-bill",
            "groups": "Bills",
            "display_name": "Create Bill",
            "short_desc": "Create a new bill",
            "desc": "Create a new bill from a vendor in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "vendor_id": <ActionOptionInfo>{
                    "display_name": "Vendor",
                    "short_desc": "The vendor for the bill",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "vendors",
                },
            },
        });

        # Update Bill
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/update-bill",
            "action": "update-bill",
            "groups": "Bills",
            "display_name": "Update Bill",
            "short_desc": "Update an existing bill",
            "desc": "Update an existing bill in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "bill_id": <ActionOptionInfo>{
                    "display_name": "Bill ID",
                    "short_desc": "The bill to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Delete Bill
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/delete-bill",
            "action": "delete-bill",
            "groups": "Bills",
            "display_name": "Delete Bill",
            "short_desc": "Delete a bill",
            "desc": "Delete a bill from Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "bill_id": <ActionOptionInfo>{
                    "display_name": "Bill ID",
                    "short_desc": "The bill to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Get Bill
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/get-bill",
            "action": "get-bill",
            "groups": "Bills",
            "display_name": "Get Bill",
            "short_desc": "Get bill details",
            "desc": "Retrieve details of a specific bill",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "bill_id": <ActionOptionInfo>{
                    "display_name": "Bill ID",
                    "short_desc": "The bill to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # List Bills
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/bills",
            "action": "list-bills",
            "groups": "Bills",
            "display_name": "List Bills",
            "short_desc": "List all bills",
            "desc": "Retrieve a list of bills with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by bill status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "open", "desc": "Open bills"},
                        <AllowedValueInfo>{"value": "overdue", "desc": "Overdue bills"},
                        <AllowedValueInfo>{"value": "paid", "desc": "Paid bills"},
                        <AllowedValueInfo>{"value": "void", "desc": "Voided bills"},
                        <AllowedValueInfo>{"value": "partially_paid", "desc": "Partially paid bills"},
                    ),
                },
                "vendor_id": <ActionOptionInfo>{
                    "display_name": "Vendor",
                    "short_desc": "Filter by vendor",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "vendors",
                },
            },
        });

        # ========== PAYMENT ACTIONS ==========

        # Create Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-payment",
            "action": "create-payment",
            "groups": "Payments",
            "display_name": "Create Payment",
            "short_desc": "Create a new payment",
            "desc": "Record a payment received from a customer",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer making the payment",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "Payment amount",
                    "type": AbstractDataProviderTypeMap."float",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Update Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/update-payment",
            "action": "update-payment",
            "groups": "Payments",
            "display_name": "Update Payment",
            "short_desc": "Update an existing payment",
            "desc": "Update an existing payment record",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "payment_id": <ActionOptionInfo>{
                    "display_name": "Payment ID",
                    "short_desc": "The payment to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Delete Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/delete-payment",
            "action": "delete-payment",
            "groups": "Payments",
            "display_name": "Delete Payment",
            "short_desc": "Delete a payment",
            "desc": "Delete a payment record from Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "payment_id": <ActionOptionInfo>{
                    "display_name": "Payment ID",
                    "short_desc": "The payment to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Get Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/get-payment",
            "action": "get-payment",
            "groups": "Payments",
            "display_name": "Get Payment",
            "short_desc": "Get payment details",
            "desc": "Retrieve details of a specific payment",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "payment_id": <ActionOptionInfo>{
                    "display_name": "Payment ID",
                    "short_desc": "The payment to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # ========== CONTACT ACTIONS ==========

        # Create Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-contact",
            "action": "create-contact",
            "groups": "Contacts",
            "display_name": "Create Contact",
            "short_desc": "Create a new contact",
            "desc": "Create a new customer or vendor contact in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_name": <ActionOptionInfo>{
                    "display_name": "Contact Name",
                    "short_desc": "Name of the contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "contact_type": <ActionOptionInfo>{
                    "display_name": "Contact Type",
                    "short_desc": "Type of contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "customer", "desc": "Customer contact"},
                        <AllowedValueInfo>{"value": "vendor", "desc": "Vendor contact"},
                    ),
                },
            },
        });

        # Update Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/update-contact",
            "action": "update-contact",
            "groups": "Contacts",
            "display_name": "Update Contact",
            "short_desc": "Update an existing contact",
            "desc": "Update an existing contact's information",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
        });

        # List Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/contacts",
            "action": "list-contacts",
            "groups": "Contacts",
            "display_name": "List Contacts",
            "short_desc": "List all contacts",
            "desc": "Retrieve a list of contacts (customers and vendors)",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_type": <ActionOptionInfo>{
                    "display_name": "Contact Type",
                    "short_desc": "Filter by contact type",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "customer", "desc": "Customer contacts only"},
                        <AllowedValueInfo>{"value": "vendor", "desc": "Vendor contacts only"},
                    ),
                },
            },
        });

        # ========== EXPENSE ACTIONS ==========

        # Create Expense
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-expense",
            "action": "create-expense",
            "groups": "Expenses",
            "display_name": "Create Expense",
            "short_desc": "Create a new expense",
            "desc": "Record a new expense in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account",
                    "short_desc": "Expense account",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "Expense amount",
                    "type": AbstractDataProviderTypeMap."float",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Update Expense
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/update-expense",
            "action": "update-expense",
            "groups": "Expenses",
            "display_name": "Update Expense",
            "short_desc": "Update an existing expense",
            "desc": "Update an existing expense record",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "expense_id": <ActionOptionInfo>{
                    "display_name": "Expense ID",
                    "short_desc": "The expense to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # ========== ITEM ACTIONS ==========

        # Create Item
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoBooksDataProvider::AppName,
            "path": "/create-item",
            "action": "create-item",
            "groups": "Items",
            "display_name": "Create Item",
            "short_desc": "Create a new item",
            "desc": "Create a new product or service item in Zoho Books",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Books organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Item Name",
                    "short_desc": "Name of the item",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "rate": <ActionOptionInfo>{
