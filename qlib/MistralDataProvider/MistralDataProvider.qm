%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) MistralRestClient
%requires RestClientIo
%requires RestSchemaActions
%requires OpenApi3

module MistralDataProvider {
    version = "1.1";
    desc = "user module providing a data provider API for Mistral AI services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new MistralDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": MistralDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Mistral AI",
            "short_desc": "Chat, documents, audio, assistants, batch inference and AI operations",
            "desc": "Use [Mistral AI](https://mistral.ai) to automate work with business content.\n\n"
                "- Generate answers, structured output, code and embeddings\n"
                "- Extract documents, transcribe recordings and generate speech\n"
                "- Manage files, models, batch jobs, assistants and conversations\n"
                "- Ground answers in document libraries and connect external tools\n"
                "- Evaluate AI responses and manage workflow executions\n\n"
                "Preview APIs depend on account permissions. Inference calls consume your Mistral quota.",
            "scheme": "mistral",
            "logo": Priv::MistralLogo,
            "logo_file_name": "mistral-ai-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm, DataProvider::AppGroup::Documents,),
        });

        (MistralSchema::getActionSet()).registerActions(MistralDataProvider::AppName);
    };
}

/** @mainpage MistralDataProvider Module

    @tableofcontents

    @section mistraldataproviderintro MistralDataProvider Introduction

    The %MistralDataProvider module exposes 161 completed-response actions from the pinned official
    <a href="https://mistral.ai">Mistral AI</a> OpenAPI description. Request options, validation, and response types
    come from that description; the reviewed manifest adds presentation, finite choices and resource
    dropdowns. The schema is installed with the module and is never downloaded during an action call.

    - Generate chat responses, code, embeddings, moderation and classification results
    - Extract document content, transcribe audio and generate speech
    - Manage files, custom models, batch jobs, agents, conversations and document libraries
    - Manage connectors, evaluation datasets, judges, campaigns and workflow executions

    Preview operations require the corresponding account access. An authenticated connection ping
    verifies the API key with a model listing; individual models and batch inference can require billing.
    Dropdowns return one page and allow custom identifiers. Document and agent-version dropdowns are
    scoped by the selected library or agent. The original three action IDs and public provider classes
    remain available, and the legacy chat response still converts \c created to a date.

    @par Example: retrieve available models and summarize an invoice
    @code{.py}
%modern
%requires MistralDataProvider

MistralDataProvider::MistralDataProvider root({"apikey": ENV.MISTRALAI_APIKEY});
auto models = root.getChildProvider("list-models").doRequest({});
auto answer = root.getChildProvider("chat-completion").doRequest({
    "model": "mistral-small-latest",
    "messages": ({"role": "user", "content": "Summarize: Invoice 42 has been paid."},),
    "max_tokens": 128,
});
printf("%Y\n", answer.choices[0].message.content);
    @endcode

    @par Example: transcribe a named audio upload
    @code{.py}
auto transcript = root.getChildProvider("transcribe-audio").doRequest({
    "file": {"name": "meeting.wav", "mime_type": "audio/wav",
        "content": File::readBinaryFile("meeting.wav")},
    "language": "en",
});
    @endcode

    @note Actions send each request once. A failed write or inference request can already have been
    processed by the service, so callers must decide whether it is safe to retry. Streaming-only and
    deprecated operations are excluded from this action set. Use the Mistral LLM provider for streaming
    chat. Public legacy request \c Fields constants describe the original subset; use \c getFields()
    on the request types or the action catalog for the complete current contract.

    The following data providers are exposed:
    - @ref MistralDataProvider::MistralDataProvider "MistralDataProvider" — root
    - @ref MistralDataProvider::MistralChatCompletionDataProvider "MistralChatCompletionDataProvider" — chat
    - @ref MistralDataProvider::MistralEmbeddingDataProvider "MistralEmbeddingDataProvider" — embeddings
    - @ref MistralDataProvider::MistralOcrDataProvider "MistralOcrDataProvider" — document OCR

    @section MistralDataProviderRelnotes Release Notes

    @subsection MistralDataProviderv1_1 MistralDataProvider v1.1
    - expose 161 typed actions from a pinned official OpenAPI description
    - add model and resource dropdowns, including dependent document and agent-version choices
    - preserve the original chat, embedding and OCR action IDs and public provider classes
    - send each request once; callers decide whether a failed operation can safely be retried

    @subsection MistralDataProviderv1_0 MistralDataProvider v1.0
    - the initial version of the %MistralDataProvider module
*/

#! contains all public definitions in the MistralDataProvider module
public namespace MistralDataProvider {
#! Mistral AI application name
public const AppName = "MistralAi";
}

namespace Priv {
#! Trusted module resource loaded once for application presentation
const MistralLogo = File::readTextFile(get_script_dir() + "/mistral-ai-logo.svg");
}
#! Application logo retained for source compatibility
public const MistralLogo = Priv::MistralLogo;
