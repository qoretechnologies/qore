%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires OpenAiRestClient
%requires QoreLlmTypes
%requires QoreRagTypes

module TogetherRestClient {
    version = "1.0";
    desc = "user module for calling Together AI REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("together",
            TogetherRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(
            new TogetherLlmProviderFactory());
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new TogetherEmbedderFactory());
    };
}

/** @mainpage TogetherRestClient Module

    @tableofcontents

    @section togetherrestclientintro TogetherRestClient Introduction

    The %TogetherRestClient module provides an API for calling
    [Together AI](https://www.together.ai) REST API services.

    Together AI serves an OpenAI-compatible API surface (chat completions,
    embeddings, image generation) over a wide selection of open-weight
    models — Llama, Qwen, DeepSeek, Mixtral, FLUX, Stable Diffusion, etc.

    The main classes are:
    - @ref TogetherRestClient::TogetherRestClient "TogetherRestClient": REST
      client API for communication with Together AI (sync)
    - @ref TogetherRestClient::TogetherRestClientIo "TogetherRestClientIo":
      REST client using multiplexed HTTP connections (async)
    - @ref TogetherRestClient::TogetherRestConnection "TogetherRestConnection":
      a REST connection object to Together AI
    - @ref TogetherRestClient::TogetherLlmProvider "TogetherLlmProvider":
      @ref qorellmutilsintro "QoreLlmUtils" provider for mode \c together
    - @ref QoreRagUtils::TogetherEmbedder "TogetherEmbedder":
      @ref qorerragutilsintro "QoreRagUtils" embedder for backend \c together

    @par Example:
    @code{.py}
#!/usr/bin/env qore
%modern
%requires TogetherRestClient

TogetherRestClient rest({"apikey": api_key});
hash<auto> ans = rest.post("/v1/chat/completions", {
    "model": "meta-llama/Llama-3.3-70B-Instruct-Turbo",
    "messages": ({"role": "user", "content": "Hello!"},),
});
printf("%Y\n", ans.body);
    @endcode

    @section TogetherRestClientRelnotes Release Notes

    @subsection TogetherRestClientv1_0 TogetherRestClient v1.0
    - the initial version of the %TogetherRestClient module
*/

%requires json

#! the TogetherRestClient namespace contains all the objects in the TogetherRestClient module
public namespace TogetherRestClient {
#! Common base class for TogetherRestClient functionality
public class TogetherRestClientBase {
    public {
        #! Default Together AI REST API URL
        const DefaultUrl = "https://api.together.xyz";

        #! Default Together API version
        const DefaultApiVersion = "v1";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    #! Returns options for the TogetherRestClient constructors
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        if (opts.api) {
            rv.default_path = "/" + opts.api;
        }
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Together AI REST API
public class TogetherRestClient inherits RestClient::RestClient, TogetherRestClientBase {
    private {
        string api;
    }

    #! Creates the object with the given options
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(TogetherRestClientBase::getOptions(opts), True) {
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(getString(opts, "api") ?? DefaultApiVersion);
        }
    }
}

#! REST client for Together AI REST API using multiplexed HTTP connections
public class TogetherRestClientIo inherits RestClientIo::RestClientIo, TogetherRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(TogetherRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Together AI REST connections
public class TogetherRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "together://api.together.xyz";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Together AI REST Connection",
            "short_desc": "A connection to the Together AI REST API",
            "desc": "A connection to the [Together AI](https://www.together.ai) REST API.\n\n"
                "Together serves OSS chat (Llama, Qwen, DeepSeek, Mixtral), embedding "
                "(`BAAI/bge-*`, `togethercomputer/m2-bert-*`), and image-generation "
                "(FLUX, Stable Diffusion XL) models via an OpenAI-compatible API.\n\n"
                "Requires an API key for Bearer authentication.  Get your API key from the "
                "[Together AI Console](https://api.together.ai/settings/api-keys).",
            "cls": Class::forName("TogetherRestConnection"),
            "auto_url": True,
            "schemes": {"together": True},
            "base_scheme_map": {"https": "together"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Together AI API key for authentication",
                    "type": "string",
                    "desc": "The Together AI API key used for Bearer authentication.\n\n"
                        "Get your API key from the "
                        "[Together AI Console](https://api.together.ai/settings/api-keys).",
                    "sensitive": True,
                    "preselected": True,
                },
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "The API version to use",
                    "desc": "The API version to use.",
                    "type": "string",
                    "default_value": TogetherRestClientBase::DefaultApiVersion,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": DefaultPingPath,
                },
            },
            "required_options": "apikey",
        };

        const DefaultPingMethod = "GET";
        const DefaultPingHeaders = {"Accept": MimeTypeJson};
        const DefaultPingPath = "models";
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "together";
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("TogetherDataProvider");
        return create_object("TogetherDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private TogetherRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new TogetherRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new TogetherRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return TogetherRestClientBase::getOptions(rv);
    }

    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != TogetherRestClientBase::DefaultUrl && url != DefaultUrl) {
                update.url = DefaultUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }
}

#! LLM provider for Together AI
/** Together's chat-completions endpoint at
    \c /v1/chat/completions on \c https://api.together.xyz is
    OpenAI-compatible, so this provider reuses
    @ref OpenAiRestClient::OpenAiLlmProvider for body construction,
    response parsing, and SSE streaming.

    @par Configuration

    - \c url (optional): override the default \c https://api.together.xyz
    - \c api_key (required): Together API key
    - \c model (required): Together model identifier, e.g.
      \c "meta-llama/Llama-3.3-70B-Instruct-Turbo"
*/
public class TogetherLlmProvider inherits OpenAiRestClient::OpenAiLlmProvider {
    public {
        const DefaultUrl = "https://api.together.xyz";
    }

    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : OpenAiRestClient::OpenAiLlmProvider(
                TogetherRestClient::applyTogetherDefaults(config)) {
    }

    string getMode() {
        return "together";
    }
}

#! Namespace-local helper: returns config with the default Together URL applied
hash<QoreLlmUtils::LlmBackendConfig> sub applyTogetherDefaults(
        hash<QoreLlmUtils::LlmBackendConfig> config) {
    if (!config.url.val()) {
        config.url = TogetherLlmProvider::DefaultUrl;
    }
    return config;
}

#! Factory for @ref TogetherLlmProvider
public class TogetherLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "together";
    }

    string getDisplayName() {
        return "Together AI chat completions";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new TogetherLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
        };
    }
}
}

#! Together AI embedder + embedder factory, registered into @ref QoreRagUtils
public namespace QoreRagUtils {
#! Together AI-backed embedder — calls the Together \c /embeddings endpoint
/** Wraps @ref TogetherRestClient::TogetherRestClientIo "TogetherRestClientIo" for
    async-capable HTTP calls to the Together AI API.

    @par Configuration

    - \c api_key (required): Together API key; passed via the \c apikey option
    - \c url (optional): override the default Together URL
    - \c model (optional): model name, default \c "BAAI/bge-base-en-v1.5"
    - \c timeout (optional): default request timeout
    - \c connect_timeout (optional): default connection timeout
*/
public class TogetherEmbedder inherits AbstractEmbedder {
    public {
        const DefaultModel = "BAAI/bge-base-en-v1.5";
        const Backend = "together";
    }

    private {
        hash<EmbedderConfig> config;
        string model_name;
        *TogetherRestClient::TogetherRestClientIo rest_client;
        *int cached_dimension;
        Mutex init_mutex();
    }

    constructor(hash<EmbedderConfig> config) {
        if (!config.api_key.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "TogetherEmbedder requires 'api_key' in EmbedderConfig";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }

        hash<auto> body = {
            "model": model_name,
            "input": texts,
        };

        hash<auto> resp = pickRestClient(opts).restPost("/embeddings", body);

        *list<auto> data = resp.body.data;
        if (!exists data) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing 'data' field", Backend),
                {"body": resp.body};
        }
        if (data.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned %d items for %d input texts",
                    Backend, data.size(), texts.size()),
                {"body": resp.body};
        }
        list<hash<auto>> sorted_data = sort(cast<list<hash<auto>>>(data),
            int sub(hash<auto> a, hash<auto> b) {
                return a."index" <=> b."index";
            });

        list<list<float>> result = ();
        foreach hash<auto> item in (sorted_data) {
            list<float> vec = validateAndCastVector(item.embedding, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = vec.size();
            }
            push result, vec;
        }
        return result;
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    *string getModel() {
        return model_name;
    }

    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response item missing 'embedding' field", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    private TogetherRestClient::TogetherRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new TogetherRestClient::TogetherRestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "apikey": config.api_key,
        };
        if (config.url.val()) {
            opts.url = config.url;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new TogetherRestClient::TogetherRestClientIo(
                    buildRestOptions());
            }
        }
    }
}

#! Factory for @ref TogetherEmbedder
public class TogetherEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "together";
    }

    string getDisplayName() {
        return "Together AI embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new TogetherEmbedder(config);
    }
}
}
