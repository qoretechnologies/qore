#! Resource names covered by generated FHIR R4 HashDataType definitions
public const FhirR4GeneratedResourceTypeList = (
    "Bundle",
    "Observation",
    "Patient",
);

# private generated helpers
namespace Priv {
    AbstractDataProviderType sub getFhirR4GeneratedFieldType(hash<auto> field) {
        if (field.repeating) {
            switch (field.qore_type) {
                case "bool": return new ListDataType(BoolType, !field.required);
                case "int": return new ListDataType(SoftIntType, !field.required);
                case "number": return new ListDataType(NumberType, !field.required);
                case "string": return new ListDataType(StringType, !field.required);
                default: return new ListDataType(AutoHashType, !field.required);
            }
        }

        switch (field.qore_type) {
            case "bool": return AbstractDataProviderType::get(field.required ? BoolType : BoolOrNothingType);
            case "int": return AbstractDataProviderType::get(field.required ? SoftIntType : SoftIntOrNothingType);
            case "number": return AbstractDataProviderType::get(field.required ? NumberType : NumberOrNothingType);
            case "string": return AbstractDataProviderType::get(field.required ? StringType : StringOrNothingType);
            default: return AbstractDataProviderType::get(field.required ? AutoHashType : AutoHashOrNothingType);
        }
    }

    hash<auto> sub getFhirR4GeneratedFieldInfo(hash<auto> field) {
        hash<auto> rv = {
            "type": getFhirR4GeneratedFieldType(field),
            "display_name": field.display_name,
            "short_desc": field.short_desc,
            "desc": field.desc,
        };
        if (exists field.example_value) {
            rv.example_value = field.example_value;
        }
        if (exists field.allowed_values) {
            rv.allowed_values = field.allowed_values;
        }
        return rv;
    }
}

#! Generated FHIR R4 resource HashDataType backed by StructureDefinition field metadata
public class FhirR4GeneratedResourceDataType inherits HashDataType {
    private {
        hash<auto> resource_metadata;
    }

    #! Creates the generated resource data type
    constructor(hash<auto> resource_metadata) : HashDataType(AutoHashType, resource_metadata.resource_type) {
        self.resource_metadata = resource_metadata;
        hash<auto> fields;
        foreach hash<auto> field in (resource_metadata.fields) {
            fields{field.name} = Priv::getFhirR4GeneratedFieldInfo(field);
        }
        addQoreFields(fields);
        setDefaultOtherFieldType(AbstractDataProviderTypeMap."any");
    }

    #! Returns the generated source metadata for this resource data type
    hash<auto> getResourceMetadata() {
        return resource_metadata;
    }
}

