# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module AftershipRestClient {
    version = "1.0";
    desc = "user module for calling Aftership REST API services";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("aftership", AftershipRestConnection::ConnectionScheme);
    };
}

/** @mainpage AftershipRestClient Module

    @tableofcontents

    @section aftershiprestclientintro AftershipRestClient Introduction

    The %AftershipRestClient module provides an API for calling Aftership REST API services.

    To use this module, use \c "%requires AftershipRestClient" in your code.

    All the public symbols in the module are defined in the AftershipRestClient namespace.

    The main classes are:
    - @ref AftershipRestClient::AftershipRestClient "AftershipRestClient":
      this class provides the REST client API for communication with the Aftership REST
      API; it also automates authentication and authorization to the target
    - @ref AftershipRestClient::AftershipRestConnection "AftershipRestConnection":
      provides a REST connection object to Aftership cloud services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires AftershipRestClient
%requires ConnectionProvider

AftershipRestClient rest = get_connection("my-aftership-connection");
hash<auto> ans = rest.get("/tracking/2026-01/couriers");
printf("%N\n", ans.body);
    @endcode

    @section AftershipRestClientRelnotes Release Notes

    @subsection AftershipRestClientv1_0 AftershipRestClient v1.0
    - the initial version of the %AftershipRestClient module
*/

#! the AftershipRestClient namespace contains all the objects in the AftershipRestClient module
public namespace AftershipRestClient {
#! Common base class for AftershipRestClient functionality
public class AftershipRestClientBase {
    public {
        #! Default Aftership REST API URL
        const DefaultUrl = "https://api.aftership.com";

        #! Default data format
        const DefaultData = "json";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "data": DefaultData,
        };

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (no leading slash - ping bypasses API base path)
        const DefaultPingPath = "tracking/2026-01/couriers";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };
    }

    #! returns options for the constructor
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        # ensure Accept header is JSON
        if (!rv.headers."Accept") {
            rv.headers."Accept" = MimeTypeJson;
        }
        # map apikey to as-api-key header so RestClient does not apply special token handling
        if (rv.apikey) {
            rv.headers."as-api-key" = rv.apikey;
            remove rv.apikey;
        }
        return rv;
    }
}

#! this class provides the REST client API for communication with Aftership servers
/** You must use an API key in the 'apikey' option to call Aftership APIs.
    The API key is sent as the \c as-api-key header.
*/
public class AftershipRestClient inherits RestClient::RestClient, AftershipRestClientBase {
    #! creates the object with the given options
    /**
        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class; note
        that the URL is set by default if not provided (see @ref DefaultUrl)
        @param do_not_connect if \c False (the default), then a connection is returned already connected to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(AftershipRestClientBase::getOptions(opts), do_not_connect) {
    }
}

#! Class for Aftership REST connections; returns @ref AftershipRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref AftershipRestClient::AftershipRestClient::constructor() for more information on the above options
*/
public class AftershipRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Aftership REST API URL
        const DefaultUrl = "aftership://api.aftership.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Aftership REST Connection",
            "short_desc": "A connection to the Aftership REST API",
            "desc": "A connection to the Aftership REST API for package tracking and returns management.\n\n"
                "Requires an API key (set as `apikey`) from the "
                "[Aftership Dashboard](https://admin.aftership.com/). "
                "The connection uses the `aftership://` URL scheme and automatically "
                "sets the required `as-api-key` header on all API requests",
            "cls": Class::forName("AftershipRestConnection"),
            "auto_url": True,
            "schemes": {
                "aftership": True,
            },
            "base_scheme_map": {
                "https": "aftership",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Aftership API key for authentication",
                    "type": "string",
                    "desc": "The Aftership API key used for authentication; sent as the `as-api-key` header.\n\n"
                        "Get your API key from the [Aftership Dashboard](https://admin.aftership.com/)",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": AftershipRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": AftershipRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": AftershipRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Get Your Aftership API Key",
                    "intent": "info",
                    "content": "To connect to Aftership, you need an API key:\n\n"
                        "1. Sign up or sign in at the [Aftership Dashboard](https://accounts.aftership.com)\n"
                        "2. Go to **Settings** > **API Keys** (or visit "
                        "[admin.aftership.com/settings/api-keys](https://admin.aftership.com/settings/api-keys) "
                        "directly)\n"
                        "3. Click **Create API key**\n"
                        "4. Enter a descriptive name, select the `as-api-key` signature type, and set permissions\n"
                        "5. Click **Save** and copy your new API key\n\n"
                        "Keep your API key secure and rotate it periodically.",
                },
            ),
        };
    }

    #! creates the AftershipRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the AftershipRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! returns \c "aftership"
    string getType() {
        return "aftership";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the \c getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the AftershipDataProvider and creates the data provider
        # object dynamically
        load_module("AftershipDataProvider");
        return create_object("AftershipDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! returns an @ref AftershipRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return an @ref AftershipRestClient object
    */
    private AftershipRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new AftershipRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new AftershipRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! Fixes URL for auto_url connections
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != AftershipRestClientBase::DefaultUrl) {
                update.url = AftershipRestClientBase::DefaultUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }
}

#! REST client for Aftership REST API using multiplexed HTTP connections
/** @see AftershipRestClient for more information
*/
public class AftershipRestClientIo inherits RestClientIo::RestClientIo, AftershipRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(AftershipRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
