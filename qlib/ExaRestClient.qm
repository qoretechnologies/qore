%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreLlmTypes

module ExaRestClient {
    version = "1.0";
    desc = "user module for calling Exa (Metaphor) neural-search REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("exa",
            ExaRestConnection::ConnectionScheme);
    };
}

/** @mainpage ExaRestClient Module

    @tableofcontents

    @section exarestclientintro ExaRestClient Introduction

    The %ExaRestClient module provides a REST client and connection for
    [Exa](https://exa.ai) (formerly Metaphor) — a web-search API built for programs, where the query
    is meaning rather than keywords and the result can be the answer itself rather than a list of
    links.

    The API is grouped as follows:
    - \c POST \c /search — search the web, optionally returning the contents of each result
    - \c POST \c /answer — answer a question from the web, citing the pages used
    - \c POST \c /contents — fetch the text, matching passages or a summary of known pages
    - \c POST \c /findSimilar — find pages similar to a seed URL (deprecated by Exa in favour of a
      search query describing the page)
    - \c /research/v1 — start, read, stop and delete research runs
    - \c /batches — enqueue many requests to run asynchronously in one job
    - \c /monitors — search monitors that re-run a search on a schedule and deliver what is new to a
      webhook

    For the data-provider application built on this client, see
    @ref exadataproviderintro "ExaDataProvider".

    @par Authentication

    Exa authenticates with the \c x-api-key header rather than \c {Authorization: Bearer}, so the
    \c apikey connection option is required and is rewritten into that header by
    @ref ExaRestClient::ExaRestClientBase::getOptions() "ExaRestClientBase::getOptions()".  The
    connection ping issues an authenticated read (see
    @ref ExaRestClient::ExaRestConnection::PingPath "ExaRestConnection::PingPath"), so a ping fails
    for a key the server rejects rather than merely proving the host is reachable.

    @par Agent integration

    The @ref ExaRestClient::ExaAgentTools namespace exports `ToolDefinition` factories
    and a dispatch callable for plugging Exa into
    @ref QoreAgentStrategies::SimpleAgentStrategy "SimpleAgentStrategy".

    @section ExaRestClientRelnotes Release Notes

    @subsection ExaRestClientv1_0 ExaRestClient v1.0
    - initial release
*/

%requires json

public namespace ExaRestClient {
public class ExaRestClientBase {
    public {
        const DefaultUrl = "https://api.exa.ai";

        const DefaultOptions = {
            "url": DefaultUrl,
        };
    }

    #! Exa uses the `x-api-key` header (NOT Authorization: Bearer)
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto!> rv;
        rv += DefaultOptions + opts;
        if (rv.apikey) {
            hash<auto!> dh;
            if (rv.headers) {
                dh += rv.headers;
            }
            dh."x-api-key" = rv.apikey;
            rv.headers = dh;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Exa (sync)
public class ExaRestClient inherits RestClient::RestClient, ExaRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(ExaRestClientBase::getOptions(opts), True) {
    }
}

#! REST client for Exa using multiplexed HTTP connections (async)
public class ExaRestClientIo inherits RestClientIo::RestClientIo, ExaRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(ExaRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Exa REST connections
public class ExaRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "exa://api.exa.ai";

        #! The path pinged to verify that the server accepts the API key
        /** A cheap authenticated read: the monitor listing answers \c 200 for a key Exa accepts and
            \c 401 for one it does not.

            \c "GET /v0/teams/me" would read better - it is literally "which team is this key for" -
            but that path answers \c 404 on \c api.exa.ai, as does every other path the API
            description puts under \c /v0.
        */
        const PingPath = "/monitors?limit=1";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Exa Connection",
            "short_desc": "A connection to the Exa web search and research API",
            "desc": "A connection to [Exa](https://exa.ai) (formerly Metaphor) — a neural web-search "
                "API providing embedding-based semantic retrieval alongside keyword search, plus "
                "answers with citations, an autonomous research agent, and websets: structured, "
                "verified lists of things found on the web.\n\n"
                "Requires an API key sent as the `x-api-key` header (NOT "
                "`Authorization: Bearer`).  Get your API key from the "
                "[Exa dashboard](https://dashboard.exa.ai/).",
            "cls": Class::forName("ExaRestConnection"),
            "auto_url": True,
            "schemes": {"exa": True},
            "base_scheme_map": {"https": "exa"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Exa API key (x-api-key header)",
                    "type": "string",
                    "desc": "The Exa API key — sent as the `x-api-key` header.",
                    "sensitive": True,
                    "preselected": True,
                },
            },
            "required_options": "apikey",
        };
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "exa";
    }

    #! Returns the data provider application name this connection serves
    /** Without this the base class returns nothing, the connection is never associated with its app,
        and @ref ConnectionProvider::AbstractConnection::getInfo() "getInfo()" omits \c app entirely.

        @note must match @c ExaDataProvider::AppName; the name is repeated here rather than referenced
        because %ExaDataProvider requires this module, not the reverse
    */
    *string getAppName() {
        return "Exa";
    }

    #! Pings the server by asking which team the API key belongs to
    /** This connection declared no ping at all until the application covered more than three actions,
        so every ping returned \c "OK" in a few milliseconds without contacting the server - including
        with an API key Exa would reject.  \c "GET /v0/teams/me" is the cheapest authenticated read the
        API offers: it answers with the team the key belongs to, and \c 401 when the key is not
        accepted, so the credentials are actually verified.

        Set both the \c ping_method and \c ping_path options to use the standard
        @ref RestClient::RestConnection "RestConnection" ping instead.  Note that such a ping cannot
        detect an invalid API key unless the path it names requires one.

        @throw REST-RESPONSE-ERROR the server rejected the ping request
    */
    private pingImpl() {
        if (opts.ping_method && opts.ping_path) {
            RestConnection::pingImpl();
            return;
        }
        try {
            cast<ExaRestClientIo>(getAsync()).restGet(PingPath);
        } catch (hash<ExceptionInfo> ex) {
            authFailure();
            rethrow;
        }
        authSuccess();
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("ExaDataProvider");
        return create_object("ExaDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private ExaRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new ExaRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new ExaRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return ExaRestClientBase::getOptions(rv);
    }
}

#! Agent-tool helpers for Exa
public namespace ExaAgentTools {
    #! Returns a @ref QoreLlmUtils::ToolDefinition describing the
    #! `exa_search` tool that agents can choose to invoke
    public hash<QoreLlmUtils::ToolDefinition> sub makeSearchTool() {
        return <QoreLlmUtils::ToolDefinition>{
            "name": "exa_search",
            "description": "Search the web using Exa's neural / embedding-based "
                "search.  Excellent for semantic queries where keyword matching falls "
                "short (e.g., 'companies similar to Anthropic', 'papers about Mamba "
                "state-space models').  Returns ranked results with title, url, and "
                "optional text content / highlights.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "The search query in natural language.",
                    },
                    "type": {
                        "type": "string",
                        "enum": ("neural", "keyword", "auto"),
                        "description": "Search type: 'neural' (semantic), 'keyword' "
                            "(traditional), or 'auto' (Exa picks).  Default: auto.",
                    },
                    "num_results": {
                        "type": "integer",
                        "description": "Number of results to return.  Default 10.",
                    },
                    "include_domains": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Restrict results to these domains.",
                    },
                    "exclude_domains": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Exclude results from these domains.",
                    },
                    "start_published_date": {
                        "type": "string",
                        "description": "ISO date — only include pages published on or "
                            "after this date.",
                    },
                    "end_published_date": {
                        "type": "string",
                        "description": "ISO date — only include pages published on or "
                            "before this date.",
                    },
                },
                "required": ("query",),
            },
        };
    }

    #! Returns a @ref QoreLlmUtils::ToolDefinition for the `exa_find_similar` tool
    public hash<QoreLlmUtils::ToolDefinition> sub makeFindSimilarTool() {
        return <QoreLlmUtils::ToolDefinition>{
            "name": "exa_find_similar",
            "description": "Find web pages similar to a seed URL using Exa's neural "
                "search.  Use this when the agent has already identified a relevant "
                "page and wants to discover related ones.",
            "parameters": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "The seed URL to find similar pages for.",
                    },
                    "num_results": {
                        "type": "integer",
                        "description": "Number of similar results to return.  Default 10.",
                    },
                    "exclude_source_domain": {
                        "type": "boolean",
                        "description": "When True, exclude pages from the seed URL's "
                            "own domain from the results.",
                    },
                },
                "required": ("url",),
            },
        };
    }

    #! Returns a @ref QoreLlmUtils::ToolDefinition for the `exa_contents` tool
    public hash<QoreLlmUtils::ToolDefinition> sub makeContentsTool() {
        return <QoreLlmUtils::ToolDefinition>{
            "name": "exa_contents",
            "description": "Fetch full content / highlights / summaries for one or "
                "more URLs (typically from a prior `exa_search` or "
                "`exa_find_similar` result).",
            "parameters": {
                "type": "object",
                "properties": {
                    "ids": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "List of Exa result IDs (or absolute URLs) to "
                            "fetch content for.",
                    },
                    "text": {
                        "type": "boolean",
                        "description": "Include full text content.",
                    },
                    "highlights": {
                        "type": "object",
                        "description": "Highlight configuration (num_sentences, "
                            "highlights_per_url, query).",
                    },
                    "summary": {
                        "type": "object",
                        "description": "Summary configuration (query for guided "
                            "summarization).",
                    },
                },
                "required": ("ids",),
            },
        };
    }

    #! Builds a tool-dispatcher callable wired to the given Exa REST client
    /** Recognised tool names: `exa_search`, `exa_find_similar`, `exa_contents`.
        Other tool names cause the dispatcher to throw \c AGENT-TOOL-ERROR.

        @param client the @ref ExaRestClient::ExaRestClientIo to use

        @return a callable that invokes the relevant Exa endpoint
    */
    public code sub makeDispatcher(ExaRestClient::ExaRestClientIo client) {
        return auto sub (string tool_name, hash<auto> args) {
            switch (tool_name) {
                case "exa_search": {
                    return client.restPost("/search", args + {}).body;
                }
                case "exa_find_similar": {
                    return client.restPost("/findSimilar", args + {}).body;
                }
                case "exa_contents": {
                    return client.restPost("/contents", args + {}).body;
                }
                default:
                    throw "AGENT-TOOL-ERROR",
                        sprintf("Exa dispatcher does not handle tool %y; expected "
                            "one of: exa_search, exa_find_similar, exa_contents",
                            tool_name);
            }
        };
    }
}
}
