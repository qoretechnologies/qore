%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) dataframe

module DataProviderDataFrame {
    version = "1.0.0";
    desc = "user module providing DataProvider integration for the DataFrame module";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new DataFrameDataProviderFactory());
    };
}

#! @mainpage DataProviderDataFrame Module
/**
    @section dataproviderdataframeintro DataProviderDataFrame Module Introduction

    Provides DataProvider integration for the @ref dataframe "dataframe" binary module,
    enabling DataFrames to participate in Qorus data pipelines.

    The module registers a \c dataframe data provider factory that creates DataFrames
    from records and exposes them as searchable data providers.
*/
