# minimum required Qore version
%requires qore >= 2.0
%modern

%requires tokenizer

%try-module RestClient
%define NoRestClient
%endtry

%try-module json
%define NoJson
%endtry

%try-module ml
%define NoMl
%endtry

module QoreTokenizerUtils {
    version = "1.1.0";
    desc = "user module providing document chunking, token counting, embeddings, and "
        "re-ranking for RAG pipelines";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreTokenizerUtils Module

    @tableofcontents

    @section qoretokenizerutilsintro QoreTokenizerUtils Module Introduction

    The %QoreTokenizerUtils module provides convenience utilities for RAG (Retrieval
    Augmented Generation) text ingestion on top of the \c tokenizer binary module:

    - @ref QoreTokenizerUtils::DocumentChunker "DocumentChunker" — splits documents into
      overlapping token-bounded chunks for embedding and vector store ingestion
    - @ref QoreTokenizerUtils::StructuredDocumentChunker "StructuredDocumentChunker" —
      structure-aware chunker that preserves paragraph boundaries and propagates metadata
      from format-specific extractors
    - @ref QoreTokenizerUtils::TokenCounter "TokenCounter" — counts tokens and manages
      LLM context window limits with truncation support
    - @ref QoreTokenizerUtils::EmbeddingModel "EmbeddingModel" — calls dense embedding
      endpoints (HTTP or ONNX) for vector generation
    - @ref QoreTokenizerUtils::CrossEncoderReranker "CrossEncoderReranker" — re-ranks
      retrieval candidates using a cross-encoder model for improved precision
    - @ref QoreTokenizerUtils::SemanticDocumentChunker "SemanticDocumentChunker" — chunks
      documents at semantic boundaries detected by embedding similarity

    All classes accept a HuggingFace `tokenizer.json` configuration and produce output
    compatible with any ONNX embedding model or LLM API.

    @par Example: Chunk a document for RAG
    @code{.py}
%requires QoreTokenizerUtils

hash<auto> config = parse_json(ReadOnlyFile::readTextFile("tokenizer.json"));
DocumentChunker chunker(config, {"chunk_size": 512, "chunk_overlap": 64});

list<hash<auto>> chunks = chunker.chunkText(long_document);
foreach hash<auto> chunk in (chunks) {
    printf("Chunk %d: %d tokens, offset %d-%d\n",
        $#, chunk.token_count, chunk.start_offset, chunk.end_offset);
    # chunk.text contains the text for this chunk
    # chunk.input_ids contains token IDs for embedding
}
    @endcode

    @section qoretokenizerutilsrelnotes QoreTokenizerUtils Module Release Notes

    @subsection qoretokenizerutils_1_1 QoreTokenizerUtils Module Version 1.1
    - Added @ref QoreTokenizerUtils::StructuredDocumentChunker "StructuredDocumentChunker"
      for structure-aware chunking with metadata propagation
    - Added @ref QoreTokenizerUtils::EmbeddingModel "EmbeddingModel" for HTTP and ONNX
      dense embedding support
    - Added @ref QoreTokenizerUtils::CrossEncoderReranker "CrossEncoderReranker" for
      two-stage retrieval with re-ranking
    - Added @ref QoreTokenizerUtils::SemanticDocumentChunker "SemanticDocumentChunker"
      for embedding-similarity-based semantic chunking

    @subsection qoretokenizerutils_1_0 QoreTokenizerUtils Module Version 1.0
    - Initial release with DocumentChunker and TokenCounter
*/
