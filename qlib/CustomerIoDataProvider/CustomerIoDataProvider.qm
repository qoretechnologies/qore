            "action": "watch-" + EVENT_PUSH_FAILED,
            "groups": "Triggers",
            "display_name": "Watch Push Failed",
            "short_desc": "Watch for push failed events",
            "desc": "Receive a notification when a push notification fails to send via Customer.io.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_PUSH_FAILED,
            "data_provider_info": CustomerIoPushFailedEventDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return new CustomerIoWebhookEventDataType(); },
        });

        # Watch Slack Sent
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/events/" + EVENT_SLACK_SENT,
