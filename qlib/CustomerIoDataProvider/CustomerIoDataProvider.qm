        });

        # Watch Slack Failed
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/events/" + EVENT_SLACK_FAILED,
            "action": "watch-" + EVENT_SLACK_FAILED,
            "groups": "Triggers",
            "display_name": "Watch Slack Failed",
            "short_desc": "Watch for Slack failed events",
