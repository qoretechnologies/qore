            "data_provider_info": CustomerIoSlackFailedEventDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return new CustomerIoWebhookEventDataType(); },
        });

        # Watch Subscribed
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/events/" + EVENT_SUBSCRIBED,
            "action": "watch-" + EVENT_SUBSCRIBED,
            "groups": "Triggers",
            "display_name": "Watch Subscribed",
            "short_desc": "Watch for customer subscribed events",
            "desc": "Receive a notification when a customer subscribes via Customer.io.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SUBSCRIBED,
