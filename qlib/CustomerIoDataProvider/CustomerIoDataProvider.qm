        });
    }; # end init
} # end module

/** @mainpage CustomerIoDataProvider Module

    @tableofcontents

    @section customeriodataproviderintro CustomerIoDataProvider Introduction

    The %CustomerIoDataProvider module provides a data provider API for Customer.io marketing
    automation services through the Customer.io REST API (both App API and Track API).

    To use this module, use \c "%requires CustomerIoDataProvider" in your code.

    All the public symbols in the module are defined in the CustomerIoDataProvider namespace.

    The main classes are:
    - @ref CustomerIoDataProvider::CustomerIoDataProvider "CustomerIoDataProvider":
      the root data provider for Customer.io with child providers for people, campaigns,
      segments, broadcasts, collections, snippets, exports, messages, activities, newsletters,
      events, objects, and devices

    @par Authentication:
    Customer.io uses API key-based authentication. You need a Site ID and API Key for the Track API,
    and an App API Key for the App API. These can be obtained from the Customer.io Settings >
    Account Settings > API Credentials page.

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires CustomerIoDataProvider

CustomerIoDataProvider cio({"api_key": ENV.CUSTOMERIO_APP_API_KEY});

# List people
map printf("Person: %s (Email: %s)\n", $1.id, $1.email),
    cio.getChildProvider("people").searchRecords({"email": "user@example.com"});

# Create/update a customer
hash<auto> result = cio.getChildProvider("create-update-customer").doRequest({
    "customer_id": "user-123",
    "email": "user@example.com",
    "attributes": {
        "first_name": "John",
        "last_name": "Doe",
        "plan": "premium",
    },
});
printf("Customer updated: %y\n", result);

# Track an event
cio.getChildProvider("track-event").doRequest({
    "customer_id": "user-123",
    "name": "purchase",
    "data": {
        "product": "Widget",
        "amount": 29.99,
    },
});
    @endcode

    @section customeriodataproviderrelnotes Release Notes

    @subsection customeriodataproviderv1_0 CustomerIoDataProvider v1.0
    - the initial version of the %CustomerIoDataProvider module
*/

#! Contains all public definitions in the CustomerIoDataProvider module
public namespace CustomerIoDataProvider {
}
