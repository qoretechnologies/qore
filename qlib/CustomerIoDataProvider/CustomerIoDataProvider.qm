# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) CustomerIoRestClient
%try-module json
%define NoJson
%endtry

module CustomerIoDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Customer.io marketing automation services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new CustomerIoDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": CustomerIoDataProvider::AppName,
            "display_name": "Customer.io",
            "short_desc": "Customer.io marketing automation platform",
            "desc": "Customer.io is a marketing automation platform for sending targeted emails, push notifications, "
                "SMS messages, and Slack messages based on customer behavior and attributes.\n\n"
                "**Features:**\n"
                "- Customer management (create, update, delete, suppress)\n"
                "- Campaign and broadcast management\n"
                "- Transactional email and push notification sending\n"
                "- Event tracking and page view tracking\n"
                "- Segment management\n"
                "- Collection and snippet management\n"
                "- Real-time webhooks for email, SMS, push, and Slack events",
            "scheme": "customerio",
            "logo": CustomerIoLogo,
            "logo_file_name": "customerio-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Email, DataProvider::AppGroup::Marketing, DataProvider::AppGroup::Analytics),
        });

        # ========== PEOPLE ACTIONS ==========

        # List People
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/people",
            "action": "list-people",
            "groups": "People",
            "display_name": "List People",
            "short_desc": "List and search people",
            "desc": "Retrieve a list of people from Customer.io with optional filtering by email, ID, "
                "or Customer.io internal ID.",
            "action_code": DPAT_FIND,
            "data_provider_info": CustomerIoPeopleDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("PersonList", new CustomerIoPersonDataType(), True);
            },
            "options": {
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Filter by email address",
                    "desc": "Filter people by email address",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "id": <ActionOptionInfo>{
                    "display_name": "ID",
                    "short_desc": "Filter by customer ID",
                    "desc": "Filter people by customer ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "cio_id": <ActionOptionInfo>{
                    "display_name": "CIO ID",
                    "short_desc": "Filter by Customer.io ID",
                    "desc": "Filter people by Customer.io internal ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Get Person
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-person",
            "action": "get-person",
            "groups": "People",
            "display_name": "Get Person",
            "short_desc": "Get a person by ID",
            "desc": "Retrieve a person's attributes from Customer.io by customer ID, email, or cio_id.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetPersonDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoGetPersonDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetPersonRequestDataType::Fields),
        });

        # Create/Update Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/create-update-customer",
            "action": "create-update-customer",
            "groups": "People",
            "display_name": "Create/Update Customer",
            "short_desc": "Create or update a customer",
            "desc": "Create a new customer or update an existing customer in Customer.io via the Track API. "
                "Sets the customer's email, attributes, and other properties.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoCreateUpdateCustomerDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoCreateUpdateCustomerRequestDataType::Fields),
        });

        # Delete Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/delete-customer",
            "action": "delete-customer",
            "groups": "People",
            "display_name": "Delete Customer",
            "short_desc": "Delete a customer",
            "desc": "Delete a customer from Customer.io via the Track API. This action cannot be undone.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoDeleteCustomerDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoDeleteCustomerRequestDataType::Fields),
        });

        # Suppress Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/suppress-customer",
            "action": "suppress-customer",
            "groups": "People",
            "display_name": "Suppress Customer",
            "short_desc": "Suppress a customer",
            "desc": "Suppress a customer in Customer.io, blocking all messaging to the customer.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoSuppressCustomerDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoSuppressCustomerRequestDataType::Fields),
        });

        # Unsuppress Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/unsuppress-customer",
            "action": "unsuppress-customer",
            "groups": "People",
            "display_name": "Unsuppress Customer",
            "short_desc": "Unsuppress a customer",
            "desc": "Unsuppress a customer in Customer.io, re-enabling messaging to the customer.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoUnsuppressCustomerDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoUnsuppressCustomerRequestDataType::Fields),
        });

        # Merge Customers
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/merge-customers",
            "action": "merge-customers",
            "groups": "People",
            "display_name": "Merge Customers",
            "short_desc": "Merge two customer profiles",
            "desc": "Merge two customer profiles in Customer.io. The primary profile is kept and the "
                "secondary profile's data is merged into it.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoMergeCustomersDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoMergeCustomersRequestDataType::Fields),
        });

        # ========== SEGMENTS ACTIONS ==========

        # List Segments
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/segments",
            "action": "list-segments",
            "groups": "Segments",
            "display_name": "List Segments",
            "short_desc": "List segments",
            "desc": "Retrieve a list of segments from Customer.io.",
            "action_code": DPAT_FIND,
            "data_provider_info": CustomerIoSegmentsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("SegmentList", new CustomerIoSegmentDataType(), True);
            },
            "options": {
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "desc": "Page number for pagination (starting at 1)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page_size": <ActionOptionInfo>{
                    "display_name": "Page Size",
                    "short_desc": "Results per page",
                    "desc": "Number of results per page",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get Segment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-segment",
            "action": "get-segment",
            "groups": "Segments",
            "display_name": "Get Segment",
            "short_desc": "Get a segment by ID",
            "desc": "Retrieve a segment's details from Customer.io by segment ID.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetSegmentDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoGetSegmentDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetSegmentRequestDataType::Fields),
        });

        # Get Segment People
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-segment-people",
            "action": "get-segment-people",
            "groups": "Segments",
            "display_name": "Get Segment People",
            "short_desc": "Get people in a segment",
            "desc": "Retrieve the list of people belonging to a Customer.io segment.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetSegmentPeopleDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetSegmentPeopleRequestDataType::Fields),
        });

        # ========== CAMPAIGNS ACTIONS ==========

        # List Campaigns
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/campaigns",
            "action": "list-campaigns",
            "groups": "Campaigns",
            "display_name": "List Campaigns",
            "short_desc": "List campaigns",
            "desc": "Retrieve a list of campaigns from Customer.io.",
            "action_code": DPAT_FIND,
            "data_provider_info": CustomerIoCampaignsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("CampaignList", new CustomerIoCampaignDataType(), True);
            },
            "options": {
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "desc": "Page number for pagination (starting at 1)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page_size": <ActionOptionInfo>{
                    "display_name": "Page Size",
                    "short_desc": "Results per page",
                    "desc": "Number of results per page",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get Campaign
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-campaign",
            "action": "get-campaign",
            "groups": "Campaigns",
            "display_name": "Get Campaign",
            "short_desc": "Get a campaign by ID",
            "desc": "Retrieve a campaign's details from Customer.io by campaign ID.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetCampaignDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoGetCampaignDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetCampaignRequestDataType::Fields),
        });

        # Get Campaign Metrics
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-campaign-metrics",
            "action": "get-campaign-metrics",
            "groups": "Campaigns",
            "display_name": "Get Campaign Metrics",
            "short_desc": "Get metrics for a campaign",
            "desc": "Retrieve metrics and performance data for a Customer.io campaign.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetCampaignMetricsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetCampaignMetricsRequestDataType::Fields),
        });

        # Get Campaign Actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-campaign-actions",
            "action": "get-campaign-actions",
            "groups": "Campaigns",
            "display_name": "Get Campaign Actions",
            "short_desc": "Get actions for a campaign",
            "desc": "Retrieve the list of actions (messages) configured for a Customer.io campaign.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetCampaignActionsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetCampaignActionsRequestDataType::Fields),
        });

        # ========== BROADCASTS ACTIONS ==========

        # List Broadcasts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/broadcasts",
            "action": "list-broadcasts",
            "groups": "Broadcasts",
            "display_name": "List Broadcasts",
            "short_desc": "List broadcasts",
            "desc": "Retrieve a list of broadcasts from Customer.io.",
            "action_code": DPAT_FIND,
            "data_provider_info": CustomerIoBroadcastsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("BroadcastList", new CustomerIoBroadcastDataType(), True);
            },
            "options": {
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "desc": "Page number for pagination (starting at 1)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page_size": <ActionOptionInfo>{
                    "display_name": "Page Size",
                    "short_desc": "Results per page",
                    "desc": "Number of results per page",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get Broadcast
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-broadcast",
            "action": "get-broadcast",
            "groups": "Broadcasts",
            "display_name": "Get Broadcast",
            "short_desc": "Get a broadcast by ID",
            "desc": "Retrieve a broadcast's details from Customer.io by broadcast ID.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetBroadcastDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoGetBroadcastDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetBroadcastRequestDataType::Fields),
        });

        # Trigger Broadcast
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/trigger-broadcast",
            "action": "trigger-broadcast",
            "groups": "Broadcasts",
            "display_name": "Trigger Broadcast",
            "short_desc": "Trigger a broadcast",
            "desc": "Trigger a Customer.io broadcast, optionally targeting specific recipients with custom data.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoTriggerBroadcastDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoTriggerBroadcastRequestDataType::Fields),
        });

        # ========== TRANSACTIONAL ACTIONS ==========

        # Send Transactional Email
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/send-transactional-email",
            "action": "send-transactional-email",
            "groups": "Transactional",
            "display_name": "Send Transactional Email",
            "short_desc": "Send a transactional email",
            "desc": "Send a transactional email via Customer.io using a pre-defined transactional message template.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoSendTransactionalEmailDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoSendTransactionalEmailDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoSendTransactionalEmailRequestDataType::Fields),
        });

        # Send Transactional Push
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/send-transactional-push",
            "action": "send-transactional-push",
            "groups": "Transactional",
            "display_name": "Send Transactional Push",
            "short_desc": "Send a transactional push notification",
            "desc": "Send a transactional push notification via Customer.io using a pre-defined transactional "
                "message template.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoSendTransactionalPushDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoSendTransactionalPushDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoSendTransactionalPushRequestDataType::Fields),
        });

        # ========== COLLECTIONS ACTIONS ==========

        # List Collections
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/collections",
            "action": "list-collections",
            "groups": "Collections",
            "display_name": "List Collections",
            "short_desc": "List collections",
            "desc": "Retrieve a list of collections from Customer.io.",
            "action_code": DPAT_FIND,
            "data_provider_info": CustomerIoCollectionsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("CollectionList", new CustomerIoCollectionDataType(), True);
            },
            "options": {
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "desc": "Page number for pagination (starting at 1)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
                "page_size": <ActionOptionInfo>{
                    "display_name": "Page Size",
                    "short_desc": "Results per page",
                    "desc": "Number of results per page",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get Collection
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-collection",
            "action": "get-collection",
            "groups": "Collections",
            "display_name": "Get Collection",
            "short_desc": "Get a collection by ID",
            "desc": "Retrieve a collection's details from Customer.io by collection ID.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetCollectionDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoGetCollectionDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetCollectionRequestDataType::Fields),
        });

        # Create Collection
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/create-collection",
            "action": "create-collection",
            "groups": "Collections",
            "display_name": "Create Collection",
            "short_desc": "Create a new collection",
            "desc": "Create a new collection in Customer.io for storing and managing data.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoCreateCollectionDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoCreateCollectionDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoCreateCollectionRequestDataType::Fields),
        });

        # Update Collection
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/update-collection",
            "action": "update-collection",
            "groups": "Collections",
            "display_name": "Update Collection",
            "short_desc": "Update an existing collection",
            "desc": "Update an existing collection in Customer.io.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoUpdateCollectionDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoUpdateCollectionDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoUpdateCollectionRequestDataType::Fields),
        });

        # Delete Collection
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/delete-collection",
            "action": "delete-collection",
            "groups": "Collections",
            "display_name": "Delete Collection",
            "short_desc": "Delete a collection",
            "desc": "Delete a collection from Customer.io. This action cannot be undone.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoDeleteCollectionDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoDeleteCollectionRequestDataType::Fields),
        });

        # ========== SNIPPETS ACTIONS ==========

        # List Snippets
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/snippets",
            "action": "list-snippets",
            "groups": "Snippets",
            "display_name": "List Snippets",
            "short_desc": "List snippets",
            "desc": "Retrieve a list of all snippets from Customer.io.",
            "action_code": DPAT_FIND,
            "data_provider_info": CustomerIoSnippetsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("SnippetList", new CustomerIoSnippetDataType(), True);
            },
        });

        # Get Snippet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/get-snippet",
            "action": "get-snippet",
            "groups": "Snippets",
            "display_name": "Get Snippet",
            "short_desc": "Get a snippet by name",
            "desc": "Retrieve a snippet's details from Customer.io by snippet name.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoGetSnippetDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoGetSnippetDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoGetSnippetRequestDataType::Fields),
        });

        # Create Snippet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/create-snippet",
            "action": "create-snippet",
            "groups": "Snippets",
            "display_name": "Create Snippet",
            "short_desc": "Create a new snippet",
            "desc": "Create a new snippet in Customer.io for reusable content in messages.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoCreateSnippetDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoCreateSnippetDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoCreateSnippetRequestDataType::Fields),
        });

        # Update Snippet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/update-snippet",
            "action": "update-snippet",
            "groups": "Snippets",
            "display_name": "Update Snippet",
            "short_desc": "Update an existing snippet",
            "desc": "Update an existing snippet in Customer.io.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoUpdateSnippetDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return CustomerIoUpdateSnippetDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoUpdateSnippetRequestDataType::Fields),
        });

        # Delete Snippet
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/delete-snippet",
            "action": "delete-snippet",
            "groups": "Snippets",
            "display_name": "Delete Snippet",
            "short_desc": "Delete a snippet",
            "desc": "Delete a snippet from Customer.io. This action cannot be undone.",
            "action_code": DPAT_API,
            "data_provider_info": CustomerIoDeleteSnippetDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
            "options": DataProviderActionCatalog::getActionOptionFromFields(CustomerIoDeleteSnippetRequestDataType::Fields),
        });

        # ========== EXPORTS ACTIONS ==========

        # Create Export
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CustomerIoDataProvider::AppName,
            "path": "/create-export",
            "action": "create-export",
            "groups": "Exports",
            "display_name": "Create Export",
            "short_desc": "Create a data export",
