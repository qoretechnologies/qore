# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module LemlistRestClient {
    version = "1.0";
    desc = "User module for calling Lemlist REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("lemlist", LemlistRestConnection::ConnectionScheme);
    };
}

/** @mainpage LemlistRestClient Module

    @tableofcontents

    @section lemlistrestclientintro LemlistRestClient Introduction

    The %LemlistRestClient module provides an API for calling Lemlist's REST API services.

    To use this module, use \c "%requires LemlistRestClient" in your code.

    All the public symbols in the module are defined in the LemlistRestClient namespace.

    The main classes are:
    - @ref LemlistRestClient::LemlistRestClient "LemlistRestClient":
      this class provides the REST client API for communication with the Lemlist API;
      it handles authentication via HTTP Basic Auth (empty username, API key as password)
    - @ref LemlistRestClient::LemlistRestConnection "LemlistRestConnection":
      provides a connection object to Lemlist services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires LemlistRestClient

LemlistRestClient lemlist({"apikey": ENV.LEMLIST_API_KEY});
hash<auto> result = lemlist.get("/campaigns?version=v2");
printf("Campaigns: %N\n", result.body);
    @endcode

    @section lemlistrestclientrelnotes Release Notes

    @subsection lemlistrestclientv1_0 LemlistRestClient v1.0
    - the initial version of the %LemlistRestClient module
*/

#! the LemlistRestClient namespace contains all the objects in the LemlistRestClient module
public namespace LemlistRestClient {

#! This class provides the REST client API for communication with Lemlist servers
/** Lemlist uses a REST API with HTTP Basic Auth authentication.

    Authentication is done via HTTP Basic Auth where:
    - Username = empty string
    - Password = API key

    All requests require the \c version=v2 query parameter.

    @par API Information:
    - Base URL: https://api.lemlist.com/api
    - Rate Limit: 20 requests per 2 seconds per API key
*/
public class LemlistRestClient inherits RestClient::RestClient {
    public {
        #! Lemlist API base URL
        const DefaultApiUrl = "https://api.lemlist.com/api";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default Lemlist ping method
        const DefaultPingMethod = "GET";

        #! Default Lemlist ping path (get team info - lightweight endpoint)
        const DefaultPingPath = "team?version=v2";

        #! Default Lemlist ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
LemlistRestClient lemlist({"apikey": "your-api-key"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the Lemlist API key (required)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw LEMLIST-ERROR missing required option 'apikey'
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(LemlistRestClient::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! Makes a REST request, automatically appending ?version=v2 to the path if not already present
    /** @param m the HTTP method to use
        @param path the URI path to use
        @param body the request body to send (if any)
        @param info an optional reference to a hash that will be used as an output variable giving the response info
        @param decode_errors if @ref True, decode error responses
        @param hdr any headers to use with the request

        @return the response from the server
    */
    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info, softbool decode_errors = True,
            *hash<auto> hdr) {
        # Append version=v2 if not already present
        if (path !~ /version=v2/) {
            if (path =~ /\?/) {
                path += "&version=v2";
            } else {
                path += "?version=v2";
            }
        }
        return RestClient::doRequest(m, path, body, \info, decode_errors, hdr);
    }

    #! returns options for @ref LemlistRestClient::LemlistRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Set URL
        rv.url = DefaultApiUrl;

        # Validate apikey is provided
        if (!opts.apikey) {
            throw "LEMLIST-ERROR", "missing required option 'apikey' (Lemlist API key)";
        }

        # Set HTTP Basic Auth: empty username, API key as password
        # Use Authorization header directly since RestClient ignores empty-string usernames (username.val() == False)
        rv.headers = (rv.headers ?? {}) + {
            "Authorization": "Basic " + (":" + opts.apikey).toBase64(),
        };

        # Remove custom option so RestClient doesn't try to use it
        remove rv.apikey;

        return rv;
    }
}

#! Class for Lemlist REST connections; returns @ref LemlistRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c apikey: the Lemlist API key (used as password for Basic Auth)

    @see @ref LemlistRestClient::LemlistRestClient::constructor() for more information on the above options
*/
public class LemlistRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Lemlist API URL
        const DefaultConnectionUrl = "lemlist://api.lemlist.com/api";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Lemlist REST Connection",
            "short_desc": "A connection to the Lemlist REST API",
            "desc": "A connection to the Lemlist REST API for sales outreach and email campaign management.\n\n"
                "Lemlist is a sales engagement platform enabling personalized outreach campaigns, lead "
                "management, and email automation.\n\n"
                "**Rate Limits:**\n"
                "- 20 requests per 2 seconds per API key\n"
                "- Rate limit headers are included in all responses",
            "cls": Class::forName("LemlistRestConnection"),
            "auto_url": True,
            "schemes": {
                "lemlist": True,
            },
            "base_scheme_map": {
                "https": "lemlist",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": LemlistRestClient::DefaultData,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Lemlist API key for authentication",
                    "type": "string",
                    "desc": "The Lemlist API key used for authentication.\n\n"
                        "To find your API key, log in to Lemlist and go to **Settings** → "
                        "**Integrations** → **API & Webhooks**, then click **Generate Key**.",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": LemlistRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": LemlistRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": LemlistRestClient::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "Where to find your API key",
                    "intent": "info",
                    "content": "1. Log in to Lemlist\n"
                        "2. Go to **Settings** (bottom left corner)\n"
                        "3. Click **Integrations** → **API & Webhooks**\n"
                        "4. Click **Generate Key** and copy the key",
                },
                <UiMessageInfo>{
                    "title": "Rate Limits",
                    "intent": "warning",
                    "content": "Lemlist enforces a rate limit of **20 requests per 2 seconds** per API key.\n\n"
                        "Exceeding this limit will result in HTTP 429 (Too Many Requests) responses.\n"
                        "Wait briefly before retrying if you encounter rate limit errors.",
                },
            ),
        };
    }

    #! creates the LemlistRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the LemlistRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(LemlistRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref LemlistRestConnection::constructor()
    /** Constructs the connection URL (Lemlist has only one API endpoint)
    */
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": DefaultConnectionUrl,
        };
    }

    #! returns \c "lemlist"
    string getType() {
        return "lemlist";
    }

    #! Returns the app name for this connection
    *string getAppName() {
        return "Lemlist";
    }

    #! returns a @ref LemlistRestClient object
    /** @param connect if @ref True, a connection is made immediately
        @param rtopts runtime options (ignored)

        @return a @ref LemlistRestClient object
    */
    #! Returns connection options with apikey translated to username/password for HTTP Basic Auth
    /** This ensures the polling ping mechanism gets proper Basic Auth credentials.
    */
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> opts = AbstractConnection::getConnectionOptions(rtopts);
        return LemlistRestClient::getOptions(opts);
    }

    private LemlistRestClient::LemlistRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new LemlistRestClient::LemlistRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since LemlistRestClient 1.1
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new LemlistRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}


#! REST client for Lemlist REST API using multiplexed HTTP connections
/** @see LemlistRestClient for more information
*/
public class LemlistRestClientIo inherits RestClientIo::RestClientIo {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(LemlistRestClient::getOptions(opts), shared_mgr) {
    }
}
} # namespace LemlistRestClient
