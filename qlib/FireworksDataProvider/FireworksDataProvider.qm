%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) FireworksRestClient
%requires RestClientIo
%requires RestSchemaActions

module FireworksDataProvider {
    version = "1.1";
    desc = "user module providing a data provider API for Fireworks AI services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new FireworksDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": FireworksDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Fireworks AI",
            "short_desc": "Fireworks AI hosted open-weight LLMs and embeddings",
            "desc": "Provides access to [Fireworks AI](https://fireworks.ai) — a managed "
                "platform for model inference and training.\n\n"
                "- Generate chat, text, and agent responses with open-weight models\n"
                "- Create embeddings and rerank documents for search\n"
                "- Manage models, datasets, deployments, and batch inference\n"
                "- Fine-tune models and evaluate their quality\n"
                "- Inspect account usage, limits, and billing",
            "scheme": "fireworks",
            "logo": Priv::FireworksLogo,
            "logo_file_name": "fireworks-ai-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        RestSchemaActionCodecs::registerCodec(<RestSchemaWireCodecInfo>{
            "name": "fireworks-resource-id",
            "type": AbstractDataProviderTypeMap."*string",
            "to_wire": auto sub(auto value) {
                if (!exists value) {
                    return NOTHING;
                }
                string id = value;
                if (!id || id =~ /\/$/) {
                    throw "FIREWORKS-RESOURCE-ID-ERROR", "resource ID must not be empty or end with a slash";
                }
                return (split("/", id)).last();
            },
            "from_wire": auto sub(auto value) { return value; },
            "desc": "Accept a resource ID or full resource name and send the final ID segment.",
        });
        foreach RestSchemaActionSet aset in (FireworksSchema::getActionSets()) {
            aset.registerActions(FireworksDataProvider::AppName);
        }

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FireworksDataProvider::AppName,
            "path": "/create-embeddings",
            "action": "create-embeddings",
            "display_name": "Create Embeddings",
            "short_desc": "Generate embedding vectors from a Fireworks-hosted model",
            "desc": "Converts text inputs into embedding vectors using a Fireworks-hosted "
                "embedding model via the OpenAI-compatible `/v1/embeddings` endpoint.",
            "action_code": DPAT_API,
            "groups": ("Embeddings",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FireworksEmbeddingRequestDataType::Fields{"input", "model",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FireworksEmbeddingRequestDataType::Fields - ("input", "model")
            ),
            "output_type": FireworksEmbeddingDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FireworksDataProvider::AppName, "path": "/rerank", "action": "rerank", "display_name": "Rerank Documents",
            "short_desc": "Rank documents by relevance to a search query",
            "desc": "Improve search results by scoring candidate documents against a query. "
                "Use `top_n` to keep the most relevant results. **Inference is billed by Fireworks.**",
            "action_code": DPAT_API, "groups": ("Embeddings",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FireworksRerankRequestDataType::Fields{"query", "documents",},
                {"preselected": True, "required": True})
                + DataProviderActionCatalog::getActionOptionFromFields(
                    FireworksRerankRequestDataType::Fields{"model", "top_n",}, {"preselected": True})
                + DataProviderActionCatalog::getActionOptionFromFields(
                    FireworksRerankRequestDataType::Fields - ("query", "documents", "model", "top_n")),
            "output_type": FireworksRerankResponseType,
        });
    };
}

/** @mainpage FireworksDataProvider Module

    @tableofcontents

    @section fireworksdataproviderintro FireworksDataProvider Introduction

    The %FireworksDataProvider module provides a data provider API for
    <a href="https://fireworks.ai">Fireworks AI</a> hosted model inference.

    The following data providers are exposed:
    - @ref FireworksDataProvider::FireworksDataProvider "FireworksDataProvider" — root
    - @ref FireworksDataProvider::FireworksChatCompletionDataProvider "FireworksChatCompletionDataProvider" — chat
    - @ref FireworksDataProvider::FireworksEmbeddingDataProvider "FireworksEmbeddingDataProvider" — embeddings

    @section FireworksDataProviderRelnotes Release Notes

    @subsection FireworksDataProviderv1_1 FireworksDataProvider v1.1
    - keep reranking registered under Fireworks AI when other providers have already loaded
    - add pinned schema actions for models, deployments, datasets, batch inference, fine-tuning,
      evaluations, billing, text completions, Responses, and Anthropic-compatible messages
    - add account and resource dropdowns with custom ID support
    - preserve the original chat completion and embedding action names

    @par Example:
    @code{.py}
FireworksDataProvider provider({"apikey": api_key});
auto accounts = provider.getChildProvider("list-accounts").doRequest({"pageSize": 20});
auto models = provider.getChildProvider("list-models").doRequest({
    "account_id": "fireworks", "pageSize": 20,
});
    @endcode

    @note Inference, training, and deployment creation can incur charges. Connection pings and
    catalog lookups do not generate tokens. Listings return one page; use the returned page token
    to retrieve more results.

    @subsection FireworksDataProviderv1_0 FireworksDataProvider v1.0
    - initial release
*/

#! contains all public definitions in the FireworksDataProvider module
public namespace FireworksDataProvider {
#! Fireworks AI application name (used as the App key in the action catalog)
public const AppName = "FireworksAi";
}

#! Compatibility alias for the application logo
public const FireworksLogo = Priv::FireworksLogo;
