            DP_OP_TO_DATE: {
                "exp": <DataProviderExpressionInfo>{
                    "type": DET_Operator,
                    "name": DP_OP_TO_DATE,
                    "display_name": "to date",
                    "short_desc": "Converts a value to a date/time",
                    "desc": "Converts a value to a timestamp using PostgreSQL CAST(x AS timestamp); "
                        "if a format mask is given, uses to_timestamp(x, mask) instead",
                    "symbol": "toDate",
                    "groups": "Data Conversion",
                    "args": (DataProviderSignatureAnyType, DataProviderSignatureOptionalStringType),
                    "return_type": AbstractDataProviderTypeMap."date",
