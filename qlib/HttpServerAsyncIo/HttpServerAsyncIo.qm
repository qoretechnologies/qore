%modern
%enable-debug

%requires Logger

module HttpServerAsyncIo {
    version = "1.1";
    desc = "Async I/O support for HttpServer";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Module initialization
    };
}

/** @mainpage HttpServerAsyncIo Module

    @tableofcontents

    @section httpserverasyncio_intro Introduction

    The %HttpServerAsyncIo module provides async I/O poll operations for the HttpServer module,
    enabling high-performance non-blocking I/O for HTTP, SSE, and WebSocket connections.

    This module leverages the @ref Qore::AbstractPollOperation pattern and integrates with
    @ref AsyncSocketIoController for efficient multiplexed I/O handling.

    @section httpserverasyncio_components Components

    - @ref HttpServerAsyncIo::HttpAcceptPollOperation "HttpAcceptPollOperation" - Composite operation for accept + SSL + ALPN negotiation
    - @ref HttpServerAsyncIo::Http2PollOperation "Http2PollOperation" - HTTP/2 server connection handling
    - @ref HttpServerAsyncIo::HttpIdlePollOperation "HttpIdlePollOperation" - Monitors idle keep-alive connections
    - @ref HttpServerAsyncIo::HttpKeepAlivePollOperation "HttpKeepAlivePollOperation" - Combined idle + header read for HTTP/1.x keep-alive
    - @ref HttpServerAsyncIo::HttpSseStreamPollOperation "HttpSseStreamPollOperation" - SSE streaming support (HTTP/1.x)
    - @ref HttpServerAsyncIo::HttpWebSocketPollOperation "HttpWebSocketPollOperation" - WebSocket bidirectional I/O (HTTP/1.x)
    - @ref HttpServerAsyncIo::HttpAsyncTarget "HttpAsyncTarget" - Callback interface for HTTP events
    - @ref HttpServerAsyncIo::HttpAsyncSocketIoController "HttpAsyncSocketIoController" - HTTP-aware I/O controller

    @subsection httpserverasyncio_abstract Protocol-Agnostic Abstractions

    These abstract classes provide a unified interface for SSE and WebSocket connections
    regardless of the underlying HTTP protocol version (HTTP/1.x or HTTP/2):

    - @ref HttpServerAsyncIo::AbstractSseConnection "AbstractSseConnection" - Protocol-agnostic SSE interface
    - @ref HttpServerAsyncIo::AbstractWebSocketConnection "AbstractWebSocketConnection" - Protocol-agnostic WebSocket interface
    - @ref HttpServerAsyncIo::Http1SseConnection "Http1SseConnection" - HTTP/1.x SSE wrapper
    - @ref HttpServerAsyncIo::Http1WebSocketConnection "Http1WebSocketConnection" - HTTP/1.x WebSocket wrapper

    @section httpserverasyncio_relnotes Release Notes

    @subsection httpserverasyncio_v1_1 Version 1.1
    - Refactored @ref HttpServerAsyncIo::HttpAsyncSocketIoController "HttpAsyncSocketIoController"
      to delegate all I/O polling to @ref AsyncSocketIo::AsyncSocketIoController "AsyncSocketIoController"
      via callback-based result delivery, eliminating the duplicate I/O thread and EventLoop
    - Added @ref HttpServerAsyncIo::HttpConnectionState "HttpConnectionState" enum for type-safe connection states
    - Added @ref HttpServerAsyncIo::HttpPollType "HttpPollType" enum for type-safe poll operation types
    - Added @ref HttpServerAsyncIo::HttpVersionMode "HttpVersionMode" enum for type-safe HTTP version modes
    - Added constructor overload accepting a shared AsyncSocketIoController instance

    @subsection httpserverasyncio_v1_0 Version 1.0
    - Initial release of HttpServer async I/O and HTTP/2 support
*/

#! Main namespace for HttpServerAsyncIo module
public namespace HttpServerAsyncIo {
    #! WebSocket opcodes
    public const WS_OP_CONTINUATION = 0x0;
    public const WS_OP_TEXT = 0x1;
    public const WS_OP_BINARY = 0x2;
    public const WS_OP_CLOSE = 0x8;
    public const WS_OP_PING = 0x9;
    public const WS_OP_PONG = 0xA;

    #! Default header read timeout (30 seconds)
    public const DefaultHeaderReadTimeout = 30s;

    #! Default idle connection timeout (75 seconds)
    public const DefaultIdleTimeout = 75s;

    #! Result info for HTTP request callbacks
    public hashdecl HttpRequestResultInfo {
        #! Close the connection after handling
        bool close = False;

        #! Return socket to idle pool for keep-alive
        bool return_to_idle = False;

        #! Enable streaming mode (SSE or WebSocket)
        bool streaming = False;

        #! Stream type: "sse" or "websocket"
        *string stream_type;

        #! Stream poll operation (when streaming=True)
        *AbstractPollOperation stream_operation;

        #! Keep-alive timeout
        *timeout ttl;

        #! HTTP response code (for HTTP/2 streaming responses like WebSocket CONNECT)
        *int code;

        #! Response headers (for HTTP/2 streaming responses)
        *hash<auto> hdr;
    }

    #! Connection info passed to callbacks
    /** For HTTP/2 connections, \c header_info contains:
        - \c http2: True for HTTP/2 requests
        - \c stream_id: The HTTP/2 stream ID (needed for sending response)
        - \c push_resource: Callback for HTTP/2 Server Push (PUSH_PROMISE); signature:
          \c int sub(string path, *hash<auto> headers) returns the promised stream ID
        - \c h2op: The Http2PollOperation for sending pushed responses

        For HTTP/2, the \c hdr hash also includes:
        - \c method: The HTTP method
        - \c path: The request path
        - \c :authority: The :authority pseudo-header value
        - \c :scheme: The :scheme pseudo-header value

        @par Example: Using HTTP/2 Server Push
        @code{.py}
# In your request handler:
hash<HttpResponseInfo> handleRequest(hash<HttpConnectionInfo> conn_info) {
    if (conn_info.header_info.http2) {
        code push_resource = conn_info.header_info.push_resource;
        if (push_resource) {
            # Push CSS file to client
            int css_stream = push_resource("/style.css", {"content-type": "text/css"});
            if (css_stream > 0) {
                # Send the pushed content
                conn_info.header_info.h2op.startSendPushedResponse(css_stream, 200,
                    {"content-type": "text/css"}, css_content);
            }
        }
    }
    # Return main response
    return makeResponse(200, html_content);
}
        @endcode

        @since HttpServerAsyncIo 1.1
    */
    public hashdecl HttpConnectionInfo {
        #! The socket for this connection
        Socket sock;

        #! Parsed HTTP headers (for HTTP/2, includes method, path, :authority, :scheme)
        hash<auto> hdr;

        #! Header parsing info (for HTTP/2, includes http2=True and stream_id)
        hash<auto> header_info;

        #! The listener that accepted this connection
        object listener;

        #! Connection context
        hash<auto> cx;

        #! True if this is a keep-alive request (not first on connection)
        bool keep_alive = False;

        #! True if SSL/TLS connection
        bool ssl = False;
    }

    #! WebSocket frame info
    public hashdecl WebSocketFrameInfo {
        #! Frame type: "text", "binary", "ping", "pong", "close", "disconnect"
        string type;

        #! Frame data (string for text, binary for binary/ping/pong)
        auto data;

        #! Close code (for close frames)
        *int code;

        #! Close reason (for close frames)
        *string reason;
    }
}
