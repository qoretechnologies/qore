%modern

# the type caches of schema objects hold their types through opaque references while their schema lives; see
# AbstractRestSchemaValidator::holdTypeCacheOpaquely()
%allow-opaque-references
# the schema keeps weak references to the schema objects holding such caches
%allow-weak-references

# make sure we have the required qore version
%requires qore >= 2.0

# requires the HttpServerUtil module
%requires(reexport) HttpServerUtil >= 0.3.12

# need mime definitions
%requires(reexport) Mime >= 1.7

# supports using the DataProvider module to describe input and output records
%requires(reexport) DataProvider

# supports loading files from URLs
%requires(reexport) FileLocationHandler

# supports logging with the Logger module
%requires(reexport) Logger

# supports reflection for dynamic schema loading
%requires reflection

%requires yaml

%try-module xml >= 1.3
%define NoXml
%endtry

%requires json

module RestSchemaValidator {
    version = "2.5";
    desc = "RestSchemaValidator module providing an abstract REST schema validation API";
    author = "David Nichols <david.nichols@qoretechnologies.com>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage RestSchemaValidator module

    @tableofcontents

    @section restschemavalidatorintro RestSchemaValidator Module Introduction

    The %RestSchemaValidator module provides an abstract <a href="https://en.wikipedia.org/wiki/Representational_state_transfer">REST</a> schema validation API to %Qore.

    Primary classes provided by this module:
    - @ref RestSchemaValidator::AbstractRestSchemaValidator "AbstractRestSchemaValidator"
    - @ref RestSchemaValidator::NullRestSchemaValidator "NullRestSchemaValidator"

    @section restschemavalidator_relnotes RestSchemaValidator Module Release Notes

    @subsection restschemavalidator_2_5 RestSchemaValidator v2.5
    - added @ref RestSchemaValidator::AbstractRestSchemaObject::getSchemaIdentity() "getSchemaIdentity()", the
      location of a schema in its document; an object type built from the schema has it as its
      @ref DataProvider::AbstractDataProviderType::getSchemaIdentity() "schema identity", so that two schemas with
      the same name and properties that describe their properties differently have their own presentation catalog
      messages
    - the data types of a large schema whose types refer back to each other are built faster: the first output type
      of a Stripe action is built in about half the time it took before.  The schema objects of a parsed
      OpenAPI 3 document hold the types they build through references that the garbage collector does not follow
      (see @ref RestSchemaValidator::AbstractRestSchemaValidator::holdTypeCacheOpaquely() "holdTypeCacheOpaquely()"),
      so building them no longer makes the collector walk the whole document.  The document releases them when it is
      destroyed, after which its schema objects no longer give the types they cached, and when it is given a type
      with @ref RestSchemaValidator::AbstractRestSchemaValidator::replaceTypeForReference() "replaceTypeForReference()",
      after which the types of its other schemas are built again when they are next asked for, with the replacement
    - added @ref RestSchemaValidator::AbstractRestSchemaValidator::runTypeBuild() "runTypeBuild()", which runs a
      type build of a schema as one transaction: the type builds of the schema are serialized, and a build that
      fails part of the way through leaves the schema's type caches as they were; OpenAPI 3 schemas build their
      types through it
    - fixed schema data types and fields depending on the order in which they were first requested: the mandatory
      and optional variants of a type or field are each built from the schema instead of one being copied from the
      other, so their names, null handling, constraints and required attributes are always what the schema
      specifies
    - schema fields give the schema's example or default value as their example value when it is valid for the
      field type, and give no generated example that the field type would reject
    - JSON and YAML response bodies in another encoding than UTF-8 are converted to UTF-8 before they are parsed,
      instead of relabeling ISO-8859-1 text as UTF-8; HTTP bodies are decoded with their actual encoding (see
      @ref Qore::decode_http_body() "decode_http_body()"), and YAML with a UTF-16 byte order mark is parsed correctly
    - schema data types describe and enforce the schema's validation constraints (bounds, lengths, patterns,
      enumerations, and item and property counts), so a value violating them is rejected when it is accepted by the
      type rather than only when a request is validated
    - accept unconstrained array elements when <tt>items</tt> is absent while retaining bounds and uniqueness
    - compare unique JSON array values with structural typed keys instead of loose equality
    - preserve decimal numeric boundaries so exact fractional endpoints validate consistently
      (public minimum/maximum and numeric exclusive bounds now use Qore numbers instead of floats)
    - accept opaque GLB model responses as binary media
    - enforce boolean enumerations and preserve false values in generated enumeration examples
    - preserve opaque audio, image, and video response bytes in the null schema validator
    - retain nullable value types and independent presence requirements across cached field uses
    - extracted shared base classes for schema validation across Swagger, OpenApi3, and AsyncApi modules:
      - @ref RestSchemaValidator::AbstractObjectBase "AbstractObjectBase": vendor extensions support
      - @ref RestSchemaValidator::AbstractSchemaBaseValidator "AbstractSchemaBaseValidator": shared validation methods
      - @ref RestSchemaValidator::AbstractComposableSchemaObject "AbstractComposableSchemaObject": allOf/oneOf/anyOf/not composition
      - @ref RestSchemaValidator::AbstractRestSchemaObject "AbstractRestSchemaObject": shared REST schema object methods
    - fixed Swagger min/max error messages that incorrectly reported maximum instead of minimum values
    - fixed two parameters that share a name and a schema sharing one another's documentation: the derived
      field was cached under the parameter name alone, although a field also carries what the <b>use</b>
      supplies - its own description and default value - so whichever operation was registered second
      published the first one's.  The cached field is still shared, because it is also what stops a
      recursive property from recursing forever, and a use whose description or default differs from it now
      gets its own copy over the same type
    - fixed a parameter description being joined to its schema's when one already contains the other, which
      published a repeated sentence such as \c "Agent run ID.: Agent run ID. New run IDs are returned with
      the \c agent_run_ prefix."; whichever says more is now kept
    - added abstract \c check() method to @ref RestSchemaValidator::AbstractSchemaObject "AbstractSchemaObject"
    - added CBOR serialization/deserialization support (\c "application/cbor") when the \c json module
      version 1.12+ is available (RFC 8949)
    - added official YAML MIME type \c "application/yaml" (RFC 9512) to serialization/deserialization
      support (alongside existing \c "text/x-yaml" and \c "application/x-yaml")
    - added query date serialization option accessors to
      @ref RestSchemaValidator::AbstractRestSchemaValidator "AbstractRestSchemaValidator"
    - added uniform reusable-schema reference type accessors to
      @ref RestSchemaValidator::AbstractRestSchemaValidator "AbstractRestSchemaValidator" so that referenced
      types can be retrieved and replaced polymorphically across Swagger 2.0 and OpenAPI 3.x schemas:
      - @ref RestSchemaValidator::AbstractRestSchemaValidator::getTypeForReference() "AbstractRestSchemaValidator::getTypeForReference()"
      - @ref RestSchemaValidator::AbstractRestSchemaValidator::replaceTypeForReference() "AbstractRestSchemaValidator::replaceTypeForReference()"
      along with @ref RestSchemaValidator::AbstractRestSchemaObject::replaceType() "AbstractRestSchemaObject::replaceType()"
    - added @ref RestSchemaValidator::RestSchemaLoader "RestSchemaLoader" class for auto-detecting and loading
      Swagger 2.0 or OpenAPI 3.x schemas without needing to know the format in advance
      (<a href="https://github.com/qorelanguage/qore/issues/5006">issue 5006</a>)
    - added abstract methods to enable polymorphic access for data providers:
      - @ref RestSchemaValidator::AbstractSchemaObject::getField() "AbstractSchemaObject::getField()"
      - @ref RestSchemaValidator::AbstractRestSchemaValidator::getFieldFromSchema() "AbstractRestSchemaValidator::getFieldFromSchema()"
      - @ref RestSchemaValidator::AbstractRestSchemaValidator::getFieldForHeaders() "AbstractRestSchemaValidator::getFieldForHeaders()"
      (<a href="https://github.com/qorelanguage/qore/issues/5006">issue 5006</a>)
    - added abstract base classes for REST schema objects to enable polymorphic usage:
      - @ref RestSchemaValidator::AbstractSchemaBase "AbstractSchemaBase": base class for schema validation constraints
      - @ref RestSchemaValidator::AbstractSchemaObject "AbstractSchemaObject": base class for JSON schema objects
      - @ref RestSchemaValidator::AbstractParameterObject "AbstractParameterObject": base class for parameter objects
      - @ref RestSchemaValidator::AbstractResponseObject "AbstractResponseObject": base class for response objects
      - @ref RestSchemaValidator::AbstractResponsesObject "AbstractResponsesObject": base class for responses container
      - @ref RestSchemaValidator::AbstractPathItemObject "AbstractPathItemObject": base class for path item objects
      - @ref RestSchemaValidator::AbstractOperationObject "AbstractOperationObject": base class for operation objects

    @subsection restschemavalidator_2_2_1 RestSchemaValidator v2.2.1
    - assume UTF-8 encoding for JSON and YAML payloads, as otherwise deserialization errors occur

    @subsection restschemavalidator_2_2 RestSchemaValidator v2.2
    - parse and report path arguments when processing REST requests on the server side
      (<a href="https://github.com/qoretechnologies/qore/issues/4661">issue 4661</a>)

    @subsection restschemavalidator_2_1_3 RestSchemaValidator v2.1.3
    - REST handlers must throw a \c DESERIALIZATION-ERROR when deserialization errors occur, so that a
      <tt>400 Bad Request</tt> response is returned
      (<a href="https://github.com/qoretechnologies/qore/issues/4647">issue 4647</a>)
    - allow for the client's time zone locale to be set for data serialization / deserialization
      (<a href="https://github.com/qoretechnologies/qore/issues/4639">issue 4639</a>)

    @subsection restschemavalidator_2_1_2 RestSchemaValidator v2.1.2
    - allow a logger to be set in validators
      (<a href="https://github.com/qoretechnologies/qore/issues/4509">issue 4509</a>)

    @subsection restschemavalidator_2_1_1 RestSchemaValidator v2.1.1
    - better fixes to REST URI path handling with schema validation; allow REST validator objects to declare if they
      manage the URI path in requests or not
      (<a href="https://github.com/qoretechnologies/qore/issues/4059">issue 4059</a>)

    @subsection restschemavalidator_2_1 RestSchemaValidator v2.1
    - fixed a bug handling complex \c Content-Type headers in responses
      (<a href="https://github.com/qoretechnologies/qore/issues/4019">issue 4019</a>)
    - fixed a bug where the \c Expect header was not supported and where binary message bodies were read as strings
      (<a href="https://github.com/qoretechnologies/qore/issues/4035">issue 4035</a>)

    @subsection restschemavalidator_2_0 RestSchemaValidator v2.0
    - implemented support for the DataProvider API
      (<a href="https://github.com/qoretechnologies/qore/issues/3545">issue 3545</a>)

    @subsection restschemavalidator_1_1_2 RestSchemaValidator v1.1.2
    - fixed \c NullRestSchemaValidator to report serialization errors instead of ignoring them and returning about
      <tt>200 OK</tt> response
      (<a href="https://github.com/qoretechnologies/qore/issues/3547">issue 3547</a>)

    @subsection restschemavalidator_1_1_1 RestSchemaValidator v1.1.1
    - fixed \c NullRestSchemaValidator not respecting set Content-Type header from RestClass
      (<a href="https://github.com/qoretechnologies/qore/issues/3427">issue 3427</a>)

    @subsection restschemavalidator_1_1 RestSchemaValidator v1.1
    - updated the default validator to try all serialization methods if multiple methods are available and one fails
      (<a href="https://github.com/qoretechnologies/qore/issues/2831">issue 2831</a>)

    @subsection restschemavalidator_1_0_2 RestSchemaValidator v1.0.2
    - fixed the null validator to handle binary message bodies; fixed issues with \c "text"
      serialization with binary message bodies
      (<a href="https://github.com/qoretechnologies/qore/issues/2816">issue 2816</a>)

    @subsection restschemavalidator_1_0_1 RestSchemaValidator v1.0.1
    - updated docs for @ref RestSchemaValidator::AbstractRestSchemaValidator::parseRequest() "AbstractRestSchemaValidator::parseRequest()" to reflect how validation exceptions should be raised for proper error reporting (<a href="https://github.com/qoretechnologies/qore/issues/2344">issue 2344</a>)
    - fixed handling of messages with non-object (i.e. non-hash) bodies (<a href="https://github.com/qoretechnologies/qore/issues/2366">issue 2366</a>)

    @subsection restschemavalidator_1_0 RestSchemaValidator v1.0
    - initial release
*/

#! main namespace for all public RestSchemaValidator declarations
public namespace RestSchemaValidator {
    #! a hash of information about a client-side request
    public hashdecl RestRequestClientInfo {
        #! the URI path for the request
        string uri_path;
        #! the Content-Type for the message
        string content;
        #! Content-Type for the response message if available
        /** to be used for the Accept header
        */
        *list<string> response_content;
        #! the serialized message body hash
        *data body;
    }

    #! a hash of information about a server-side request
    public hashdecl RestRequestServerInfo {
        #! the URI path without query arguments
        string path;
        #! any query arguments
        *hash<auto> query;
        #! any path arguments
        *hash<auto> path_args;
        #! the deserialized message body data
        auto body;
        #! miscellaneous free-form info about the parsed request
        hash<auto> info;
    }

    #! a hash of information about a response from the server
    public hashdecl RestResponseClientInfo {
        #! the HTTP status code
        int code;
        #! the deserialized message body
        auto body;
        #! the HTTP headers received
        hash<auto> hdr;
        #! miscellaneous free-form info about the parsed response
        hash<auto> info;
    }

    #! a hash giving example info for example HTTP request messages
    public hashdecl RestExampleRequestInfo {
        #! the HTTP request URI
        string request_uri;
        #! the HTTP request header hash
        hash<auto> hdr;
        #! the HTTP request body
        string body;
    }

    #! a hash giving example info for example HTTP response messages
    public hashdecl RestExampleResponseInfo {
        #! the HTTP response URI
        string response_uri;
        #! the HTTP status code
        int code;
        #! the HTTP response header hash
        hash<auto> hdr;
        #! the HTTP response body
        string body;
    }

    #! a hash giving example information for building a request or response in Qore
    public hashdecl RestQoreExampleCodeInfo {
        #! a hash giving example hashdecl declarations for hash objects in the message; keys are hashdecl names; string values are Qore example code declarations of the given hashdecl
        hash<string, string> hashdecls();

        #! a string giving the example code generation
        string example;
    }

    #! Abstract base class for objects with vendor extensions
    /** This class provides common vendor extension support shared across
        Swagger 2.0, OpenAPI 3.0, and AsyncAPI 3.0 schema definitions.

        @since RestSchemaValidator 2.5
    */
    public class AbstractObjectBase inherits Qore::Serializable {
        public {
            #! Allows extensions to the schema
            /**
                The field name MUST begin with \c x-, for example, \c x-internal-id.
                The value can be \c null, a primitive, an array or an object.
            */
            hash<auto> vendorExtensions;
        }

        #! Constructor
        public constructor() {
        }

        #! Constructor
        /**
            @param oh deserialized hash from the source schema description describing the object
        */
        public constructor(hash<auto> oh) {
            initialize(oh);
        }

        #! Copy constructor
        constructor(AbstractObjectBase other) {
            vendorExtensions = other.vendorExtensions;
        }

        #! Initialize
        /**
            @param oh deserialized hash from the source schema description
        */
        public initialize(hash<auto> oh) {
            vendorExtensions = map {$1.key: $1.value}, oh.pairIterator(), $1.key =~ /^x-/;
        }

        #! Returns True if this object has the x-deprecated extension set
        *bool isXDeprecated() {
            return vendorExtensions."x-deprecated";
        }

        #! Returns True if this object has the x-internal extension set
        *bool isInternal() {
            return vendorExtensions."x-internal";
        }

        #! Returns True if this object has the x-hidden extension set
        *bool isHidden() {
            return vendorExtensions."x-hidden";
        }

        #! Returns the x-displayName extension value if set
        *string getDisplayName() {
            return vendorExtensions."x-displayName";
        }
    }

    #! Abstract base class for schema validation constraints (JSON Schema)
    /** This class provides common validation constraint members shared by both
        Swagger 2.0 and OpenAPI 3.0 schema definitions.
    */
    public class AbstractSchemaBase inherits Qore::Serializable {
        #! Keeps decimal schema bounds independent of binary floating point expansion
        /** Parsers validate member types before calling this helper. JSON decimal literals and Qore
            decimal values must compare identically at inclusive and exclusive boundaries.
            @param source original schema properties
        */
        private normalizeNumericBounds(hash<auto> source) {
            if (exists source.minimum) { minimum = decimalBound(source.minimum); }
            if (exists source.maximum) { maximum = decimalBound(source.maximum); }
        }

        private static number decimalBound(auto value) {
            return value.typeCode() == NT_FLOAT ? number(value.toString()) : number(value);
        }
        public {
            #! Maximum value constraint
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.1.2
            */
            *softnumber maximum;

            #! Minimum value constraint
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.1.3
            */
            *softnumber minimum;

            #! Exclusive maximum flag
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.1.2
            */
            *bool exclusiveMax;

            #! Exclusive minimum flag
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.1.3
            */
            *bool exclusiveMin;

            #! Maximum string length
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.2.1
            */
            *int maxLength;

            #! Minimum string length
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.2.2
            */
            *int minLength;

            #! Regex pattern constraint
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.2.3
            */
            *string pattern;

            #! Maximum array items
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.3.2
            */
            *int maxItems;

            #! Minimum array items
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.3.3
            */
            *int minItems;

            #! Unique items constraint
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.3.4
            */
            *bool uniqueItems;

            #! Enum values as a hash for fast lookup
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.5.1

                @note enums can be of any type, but we only support enums of simple types that can be
                converted to a string for fast lookups in a hash
            */
            hash<string, bool> enumValues;

            #! Multiple-of constraint
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.1.1
            */
            *float multipleOf;
        }

        #! Returns the validation constraints of the schema for its data type
        /** @return the constraints of the schema that its data type enforces and describes, if any

            @since RestSchemaValidator 2.5
        */
        *hash<DataTypeConstraintInfo> getConstraintInfo() {
            hash<auto> rv;
            if (exists maximum) {
                rv{exclusiveMax ? "exclusive_maximum" : "maximum"} = maximum;
            }
            if (exists minimum) {
                rv{exclusiveMin ? "exclusive_minimum" : "minimum"} = minimum;
            }
            if (multipleOf) {
                # a float converted directly to a number carries its binary rounding error
                rv.multiple_of = number(multipleOf.toString());
            }
            if (exists minLength) {
                rv.min_length = minLength;
            }
            if (exists maxLength) {
                rv.max_length = maxLength;
            }
            if (pattern.val()) {
                rv.pattern = pattern;
            }
            if (exists minItems) {
                rv.min_items = minItems;
            }
            if (exists maxItems) {
                rv.max_items = maxItems;
            }
            if (uniqueItems) {
                rv.unique_items = True;
            }
            if (enumValues) {
                # validation compares enum values as strings
                rv.enum_values = keys enumValues;
            }
            return rv ? cast<hash<DataTypeConstraintInfo>>(rv) : NOTHING;
        }
    }

    #! Abstract base class for schema validation with shared check methods
    /** This class provides the common validation methods shared across
        Swagger 2.0, OpenAPI 3.0, and AsyncAPI 3.0 schema definitions.

        Subclasses must implement @ref getPathLabel() and @ref getMethodLabel()
        to provide context-appropriate error message terminology.

        @since RestSchemaValidator 2.5
    */
    public class AbstractSchemaBaseValidator inherits AbstractSchemaBase {
        public {
            #! Numeric exclusiveMaximum value (JSON Schema draft-07+ / OpenAPI 3.1)
            /** In JSON Schema draft-07+, exclusiveMaximum is a direct numeric value (not a boolean modifier)
            */
            *softnumber exclusiveMaxValue;

            #! Numeric exclusiveMinimum value (JSON Schema draft-07+ / OpenAPI 3.1)
            /** In JSON Schema draft-07+, exclusiveMinimum is a direct numeric value (not a boolean modifier)
            */
            *softnumber exclusiveMinValue;
        }

        #! Returns the validation constraints of the schema for its data type
        /** @return the constraints of the schema that its data type enforces and describes, including numeric
            exclusive bounds, if any

            @since RestSchemaValidator 2.5
        */
        *hash<DataTypeConstraintInfo> getConstraintInfo() {
            hash<auto> rv = AbstractSchemaBase::getConstraintInfo() ?? {};
            if (exists exclusiveMaxValue) {
                rv.exclusive_maximum = exclusiveMaxValue;
            }
            if (exists exclusiveMinValue) {
                rv.exclusive_minimum = exclusiveMinValue;
            }
            return rv ? cast<hash<DataTypeConstraintInfo>>(rv) : NOTHING;
        }

        #! Returns the label for path/channel in error messages
        /** @return \c "path" for REST APIs, \c "channel" for AsyncAPI
        */
        abstract string getPathLabel();

        #! Returns the label for method/operation in error messages
        /** @return \c "method" for REST APIs, \c "operation" for AsyncAPI
        */
        abstract string getMethodLabel();

        #! Returns a candidate example for the given type; callers validate it against the finished field type
        private auto getExampleValueWithFormat(string type, *string format, *string fname) {
            if (enumValues) {
                auto rv = enumValues.firstKey();
                switch (type) {
                    case "integer": {
                        rv = rv.toInt();
                        switch (format) {
                            case "unix-time":
                                rv = localtime(rv);
                                break;
                        }
                        break;
                    }
                    case "number": rv = (format && ValidNumberFormatsHash{format} ? rv.toFloat() : rv.toNumber()); break;
                    case "boolean": rv = parse_boolean(rv); break;
                    case "string": {
                        switch (format) {
                            case "byte": return parse_base64_string(rv);
                            case "date":
                            case "date-time":
                            default:
                                break;
                        }
                    }
                }
                return rv;
            }
            switch (type) {
                case "string": {
                    switch (format) {
                        case "byte":
                        case "binary": return <feedface>;
                        case "date": return 1987-05-23;
                        case "date-time": return 1987-05-23T07:45:30Z;
                        case "uuid": return "d242e639-4ed6-4930-a375-b139c13f89da";
                        default:
                            return sprintf("Example %s", fname ?? "string");
                    }
                }
                case "integer": {
                    switch (format) {
                        case "unix-time": return 1726733382;
                    }
                    if (exists minimum)
                        return exclusiveMin ? minimum + 1 : minimum;
                    if (exists maximum)
                        return exclusiveMax ? maximum - 1 : maximum;
                    return 1;
                }
                case "number": {
                    number rv;
                    if (exists minimum)
                        rv = exclusiveMin ? minimum + 0.1 : minimum;
                    else if (exists maximum)
                        rv = exclusiveMax ? maximum - 0.1 : maximum;
                    else
                        rv = 1.1n;
                    if (format && ValidNumberFormatsHash{format})
                        return rv.toFloat();
                    return rv;
                }
                case "boolean":
                    return True;
                case "null":
                    return NOTHING;
                case "any": {
                    return "any value";
                }
            }
        }

        #! Returns True if date/date-time string values should be converted to date objects during serialization
        /** Override to return False if date-time strings should be kept as-is during serialization */
        bool serializeDateTimeStrings() {
            return True;
        }

        #! Validates the value against the schema definition
        private check(bool serialize, bool request, string type, *string format, *AbstractSchemaObject items,
                string path, string method, string name, reference<auto> value) {
            # accept a single value for an array (= one-element list)
            if (type == "array") {
                # convert to a list before checking
                if (exists value && value.typeCode() != NT_LIST) {
                    value = (value,);
                }
                checkArrayParam(serialize, request, items, path, method, name, \value);
            } else {
                on_error rethrow $1.err, sprintf("%s (while checking parameter %y)", $1.desc, name);
                # SQL NULL and "no value" are the same thing to a REST schema, and a record-based data
                # provider returns NULL for every unset column, so any API serving a value read from a
                # database presents them.  NULL is a type of its own with no checkIntern() variant, so
                # it is dispatched on the no-value variant to get a verdict from the schema; the value
                # itself is left alone, as validating it must not rewrite it
                if (value === NULL) {
                    checkIntern(serialize, request, type, format, path, method, name, NOTHING, \value);
                    return;
                }
                checkIntern(serialize, request, type, format, path, method, name, value, \value);
            }
        }

        private checkStringIntern(string path, string method, string name, string value) {
            string pl = getPathLabel();
            string ml = getMethodLabel();
            # minLength and maxLength are based on the number of characters in the string, not bytes
            if (exists maxLength && value.length() > maxLength)
                throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y is too long (maxLength: %d, actual: %d)",
                        name, pl, path, ml, method, maxLength, value.length());
            if (exists minLength && value.length() < minLength)
                throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y is too short (minLength: %d, actual: %d)",
                        name, pl, path, ml, method, minLength, value.length());
            if (exists pattern && !value.regex(pattern))
                throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y does not fit the parameter string pattern "
                        "(pattern: %y, value: %y)", name, pl, path, ml, method, pattern, value);
            if (enumValues && !enumValues{value})
                throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y does not fit the enumerated values (enum: %y, "
                        "actual: %y)", name, pl, path, ml, method, keys enumValues, value);
        }

        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, list<auto> v, reference<list> value) {
            if (type != "list" && type != "any")
                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for %s %y and %s %y is an array (%y), but "
                    "the expected type is %y", name, getPathLabel(), path, getMethodLabel(), method, v, type);
        }

        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, hash<auto> v, reference<hash> value) {
            if (type != "file" && type != "any" && type != "object")
                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for %s %y and %s %y is an object (%y), but "
                    "the expected type is %y", name, getPathLabel(), path, getMethodLabel(), method, v, type);
        }

        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, int v, reference<auto> value) {
            # NOTE: "number" also accepts "int"
            if (type == "number") {
                checkIntern(serialize, request, type, format, path, method, name, v.toNumber(), \value);
                return;
            }
            if (type != "integer" && type != "any")
                throwInvalidType(name, "integer", type, v);

            if (!serialize) {
                switch (format) {
                    case "unix-time":
                        value = localtime(v);
                        break;
                }
            }

            string pl = getPathLabel();
            string ml = getMethodLabel();

            # Check maximum constraint (boolean exclusiveMax)
            if (exists maximum) {
                if (exclusiveMax) {
                    if (value >= maximum)
                        throw "SCHEMA-VALIDATION-ERROR",
                            sprintf("Parameter %y for %s %y and %s %y is too big (maximum: %f, actual: %d)",
                                name, pl, path, ml, method, maximum, value);
                } else {
                    if (value > maximum)
                        throw "SCHEMA-VALIDATION-ERROR",
                            sprintf("Parameter %y for %s %y and %s %y is too big (maximum: %f, actual: %d)",
                                name, pl, path, ml, method, maximum, value);
                }
            }

            # Check exclusiveMaximum constraint (numeric value, JSON Schema draft-07+)
            if (exists exclusiveMaxValue) {
                if (value >= exclusiveMaxValue)
                    throw "SCHEMA-VALIDATION-ERROR",
                        sprintf("Parameter %y for %s %y and %s %y is too big (exclusiveMaximum: %f, actual: %d)",
                            name, pl, path, ml, method, exclusiveMaxValue, value);
            }

            # Check minimum constraint (boolean exclusiveMin)
            if (exists minimum) {
                if (exclusiveMin) {
                    if (value <= minimum)
                        throw "SCHEMA-VALIDATION-ERROR",
                            sprintf("Parameter %y for %s %y and %s %y is too small (minimum: %f, actual: %d)",
                                name, pl, path, ml, method, minimum, value);
                } else {
                    if (value < minimum)
                        throw "SCHEMA-VALIDATION-ERROR",
                            sprintf("Parameter %y for %s %y and %s %y is too small (minimum: %f, actual: %d)",
                                name, pl, path, ml, method, minimum, value);
                }
            }

            # Check exclusiveMinimum constraint (numeric value, JSON Schema draft-07+)
            if (exists exclusiveMinValue) {
                if (value <= exclusiveMinValue)
                    throw "SCHEMA-VALIDATION-ERROR",
                        sprintf("Parameter %y for %s %y and %s %y is too small (exclusiveMinimum: %f, actual: %d)",
                            name, pl, path, ml, method, exclusiveMinValue, value);
            }

            if (enumValues && !enumValues{value})
                throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y does not fit the enumerated values (enum: %y, "
                        "actual: %d)", name, pl, path, ml, method, keys enumValues, value);
        }

        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, number v, reference<number> value) {
            checkInternNumber(serialize, request, type, format, path, method, name, v, \value);
        }

        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, float v, reference<number> value) {
            checkInternNumber(serialize, request, type, format, path, method, name, v, \value);
        }

        private checkInternNumber(bool serialize, bool request, string type, *string format, string path,
                string method, string name, auto v, reference<auto> value) {
            if (type != "number" && type != "any")
                throwInvalidType(name, "number", type, v);

            string pl = getPathLabel();
            string ml = getMethodLabel();

            # Compare the original decimal value, before the transport's final float conversion.
            value = decimalBound(v);

            # Check maximum constraint (boolean exclusiveMax)
            if (exists maximum) {
                if (exclusiveMax) {
                    if (value >= maximum)
                        throw "SCHEMA-VALIDATION-ERROR",
                            sprintf("Parameter %y for %s %y and %s %y is too big (maximum: %f, actual: %f)",
                                name, pl, path, ml, method, maximum, value);
                } else {
                    if (value > maximum)
                        throw "SCHEMA-VALIDATION-ERROR",
                            sprintf("Parameter %y for %s %y and %s %y is too big (maximum: %f, actual: %f)",
                                name, pl, path, ml, method, maximum, value);
                }
            }

            # Check exclusiveMaximum constraint (numeric value)
            if (exists exclusiveMaxValue) {
                if (value >= exclusiveMaxValue)
                    throw "SCHEMA-VALIDATION-ERROR",
                        sprintf("Parameter %y for %s %y and %s %y is too big (exclusiveMaximum: %f, actual: %f)",
                            name, pl, path, ml, method, exclusiveMaxValue, value);
            }

            # Check minimum constraint (boolean exclusiveMin)
            if (exists minimum) {
                if (exclusiveMin) {
                    if (value <= minimum)
                        throw "SCHEMA-VALIDATION-ERROR",
                            sprintf("Parameter %y for %s %y and %s %y is too small (minimum: %f, actual: %f)",
                                name, pl, path, ml, method, minimum, value);
                } else {
                    if (value < minimum)
                        throw "SCHEMA-VALIDATION-ERROR",
                            sprintf("Parameter %y for %s %y and %s %y is too small (minimum: %f, actual: %f)",
                                name, pl, path, ml, method, minimum, value);
                }
            }

            # Check exclusiveMinimum constraint (numeric value)
            if (exists exclusiveMinValue) {
                if (value <= exclusiveMinValue)
                    throw "SCHEMA-VALIDATION-ERROR",
                        sprintf("Parameter %y for %s %y and %s %y is too small (exclusiveMinimum: %f, actual: %f)",
                            name, pl, path, ml, method, exclusiveMinValue, value);
            }

            if (enumValues && !enumValues{value}) {
                throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y does not fit the enumerated values (enum: %y, "
                        "actual: %f)", name, pl, path, ml, method, keys enumValues, value);
            }

            switch (format) {
                case "float":
                case "double":
                case NOTHING:
                    value = v.toFloat();
                    break;

                default:
                    throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y has an invalid format: %y; expecting (\"float\", "
                        "\"double\", or no value; value provided: %y)", name, pl, path, ml, method, format, value);
            }
        }

        #! Converts binary values to strings for supported formats
        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, binary v, reference value) {
            if (type != "string" && type != "any")
                throwInvalidType(name, "string", type, v);

            if (serialize) {
                switch (format) {
                    case "byte":
                        value = make_base64_string(v);
                        break;
                    case "binary":
                        value = v;
                        return;
                    default:
                        throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: parameters %y: cannot serialize a binary "
                            "value to a string value with format %y", method.upr(), path, name, format);
                }
                checkStringIntern(path, method, name, value);
            }
        }

        #! Validates string values
        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, string v, reference<auto> value) {
            if (type != "string" && type != "any") {
                throwInvalidType(name, "string", type, v);
            }

            string pl = getPathLabel();
            string ml = getMethodLabel();

            if (serialize) {
                switch (format) {
                    case "byte":
                        value = make_base64_string(v);
                        break;
                    case "binary":
                        value = binary(v);
                        break;
                    case "date":
                    case "date-time":
                        if (serializeDateTimeStrings()) {
                            # issue #3847: with non-YAML serialization, this will always be a string
                            value = date(v);
                        }
                        break;
                }
            } else {
                switch (format) {
                    # NOTE: deserializes to a binary object
                    case "byte":
                        try {
                            value = parse_base64_string(v);
                        } catch (hash<ExceptionInfo> ex) {
                            throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for %s %y and %s %y of type %y "
                                "is invalid; value provided: %y (%s)", name, pl, path, ml, method, format, v,
                                ex.desc);
                        }
                        break;
                    # NOTE: deserializes to a binary object
                    case "binary":
                        try {
                            value = binary(v);
                        } catch (hash<ExceptionInfo> ex) {
                            throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for %s %y and %s %y of type %y "
                                "is invalid; value provided: %y (%s)", name, pl, path, ml, method, format, v,
                                ex.desc);
                        }
                        break;
                    # NOTE: deserializes to a date/time value
                    case "date":
                    case "date-time":
                        try {
                            # https://xml2rfc.tools.ietf.org/public/rfc/html/rfc3339.html#anchor14
                            value = date(v);
                        } catch (hash<ExceptionInfo> ex) {
                            throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for %s %y and %s %y of type %y "
                                "is invalid; value provided: %y (%s)", name, pl, path, ml, method, format, v,
                                ex.desc);
                        }
                        break;
                }
            }
            if (value.typeCode() == NT_STRING) {
                checkStringIntern(path, method, name, value);
            }
        }

        #! Converts dates to/from string or int values for supported formats
        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, date v, reference<auto> value) {
            if (type != "string" && type != "any" && (type != "integer" || format != "unix-time"))
                throwInvalidType(name, "string", type, v);

            if (serialize) {
                if (type == "integer" && format == "unix-time") {
                    value = v.getEpochSeconds();
                } else {
                    switch (format) {
                        case "date":
                            # https://xml2rfc.tools.ietf.org/public/rfc/html/rfc3339.html#anchor14
                            value = v.format("YYYY-MM-DD");
                            break;
                        case "date-time":
                            # https://xml2rfc.tools.ietf.org/public/rfc/html/rfc3339.html#anchor14
                            if (v.milliseconds() != 0)
                                value = v.format("YYYY-MM-DDTHH:mm:SS.yZ");
                            else
                                value = v.format("YYYY-MM-DDTHH:mm:SSZ");
                            break;
                        default:
                            throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: parameters %y: cannot serialize a "
                                "date/time value to a string value with format %y", method.upr(), path, name, format);
                    }
                    checkStringIntern(path, method, name, value);
                }
            }
        }

        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, bool v, reference<bool> value) {
            if (type != "boolean" && type != "any") {
                throwInvalidType(name, "boolean", type, v);
            }
            if (enumValues && !enumValues{value.toString()}) {
                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for %s %y and %s %y does not fit the "
                    "enumerated values (enum: %y, actual: %y)", name, getPathLabel(), path, getMethodLabel(),
                    method, keys enumValues, value);
            }
        }

        # NOTE: the reference is deliberately untyped: the value being checked can be a hash member or
        #       any other "auto" lvalue, and a "reference<nothing>" parameter binds neither, which made
        #       this variant unreachable for every value that is not already declared to hold nothing
        private checkIntern(bool serialize, bool request, string type, *string format, string path, string method,
                string name, nothing v, reference value) {
            if (type != "null" && type != "any")
                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for %s %y and %s %y is null, but the "
                    "expected type is %y", name, getPathLabel(), path, getMethodLabel(), method, type);
        }

        #! Validates the value against the schema definition
        private checkArrayParam(bool serialize, bool request, *AbstractSchemaObject items, string path, string method,
                string name, reference<list<auto>> value) {
            string pl = getPathLabel();
            string ml = getMethodLabel();
            if (exists maxItems && value.size() > maxItems) {
                throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y has too many items (maxItems: %d, actual: %d)",
                        name, pl, path, ml, method, maxItems, value.size());
            }
            if (exists minItems && value.size() < minItems) {
                throw "SCHEMA-VALIDATION-ERROR",
                    sprintf("Parameter %y for %s %y and %s %y has too few items (minItems: %d, actual: %d)",
                        name, pl, path, ml, method, minItems, value.size());
            }

            if (!value) {
                return;
            }

            hash<string, bool> seen;
            foreach auto val in (\value) {
                if (items) { items.check(serialize, request, path, method, name, \val); }
                if (uniqueItems) {
                    string key = AbstractSchemaBaseValidator::uniqueValueKey(val);
                    if (seen{key}) {
                        throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: Array parameter %y does not have unique items",
                            method, path, name);
                    }
                    seen{key} = True;
                }
            }
        }

        #! Canonical typed key for JSON equality without scalar coercion or quadratic list scans
        private static string uniqueValueKey(auto value, int depth = 0) {
            if (depth > 128) { throw "SCHEMA-VALIDATION-ERROR", "array element exceeds the supported nesting depth"; }
            int tc = value.typeCode();
            if (inlist(tc, (NT_INT, NT_FLOAT, NT_NUMBER))) { return "number:" + number(value).toString(); }
            if (tc == NT_NULL || tc == NT_NOTHING) { return "null"; }
            if (tc == NT_LIST) {
                return "list:" + make_json(map AbstractSchemaBaseValidator::uniqueValueKey($1, depth + 1), value);
            }
            if (tc == NT_HASH) {
                hash<string, string> sorted = {};
                foreach string key in (sort(keys value)) {
                    sorted{key} = AbstractSchemaBaseValidator::uniqueValueKey(value{key}, depth + 1);
                }
                return "object:" + make_json(sorted);
            }
            return value.type() + ":" + make_json(value);
        }

        #! Throws an \c SCHEMA-VALIDATION-ERROR exception
        static private throwInvalidType(string name, string actual, string expected, auto value) {
            throw "SCHEMA-VALIDATION-ERROR",
                sprintf("Parameter %y has invalid type %y (should be %y); value: %y", name, actual, expected, value);
        }

        #! Checks the value against the type
        /** @return True if the value is OK, False if not
        */
        static bool checkValueType(reference<auto> value, string type) {
            if (type == "any") {
                return True;
            }
            int vt = value.typeCode();

            # check for string values
            if (vt == NT_STRING) {
                if (type == "boolean") {
                    if (value == "true") {
                        value = True;
                        return True;
                    } else if (value == "false") {
                        value = False;
                        return True;
                    }
                } else if (type == "int" && value =~ /^[0-9]+$/) {
                    value = value.toInt();
                    return True;
                }
            }

            # check for number values
            if (vt == NT_INT && type == "number") {
                value = value.toFloat();
                return True;
            }

            if ((vt == NT_BOOLEAN && type != "boolean") ||
                (vt == NT_INT && type != "integer") ||
                (vt == NT_FLOAT && type != "number") ||
                (vt == NT_STRING && (type != "string" && type != "file")) ||
                (vt == NT_LIST && type != "array")) {
                return False;
            }
            return True;
        }

        #! Valid number type formats
        const ValidNumberFormats = ("double", "float");

        #! A hash of valid number type formats
        const ValidNumberFormatsHash = map {$1: True}, ValidNumberFormats;
    }

    #! Abstract base class for schema objects (JSON Schema)
    /** This class provides the common interface for schema objects shared by both
        Swagger 2.0 and OpenAPI 3.0 specifications.
    */
    public class AbstractSchemaObject inherits AbstractSchemaBase {
        public {
            #! The name of this object for documentation and example purposes
            string name;

            #! The data type (string, integer, boolean, object, array, etc.)
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.5.2

                MUST be either a string or an array (list). If it's an array,
                its elements MUST be strings and MUST be unique.
            */
            string type;

            #! The extending format for the type (date-time, int64, etc.)
            /** See Data Type Formats for further details.
            */
            *string format;

            #! Title for documentation
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-6.1
            */
            *string title;

            #! Description
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-6.1
            */
            *string desc;

            #! Default value
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-6.2
            */
            auto defaultVal;

            #! Maximum number of properties (for objects)
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.4.1
            */
            *int maxProperties;

            #! Minimum number of properties (for objects)
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.4.2
            */
            *int minProperties;

            #! Whether the value can be null
            /** Extension that allows types to be nullable; the OpenAPI specification 2.0
                otherwise does not allow for nullable types.
            */
            bool nullable = False;

            #! Required properties (for objects)
            /** @see https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-5.4.3

                Set of strings. Must have at least one element.
            */
            hash<string, bool> required;

            #! Discriminator for polymorphism
            /** The discriminator is the schema property name that is used to
                differentiate between other schemas that inherit this schema.
            */
            *string discriminator;

            #! Read-only flag
            /** Declares the property as "read only". This means that it MAY be sent
                as part of a response but MUST NOT be sent as part of the request.
            */
            bool readOnly = False;
        }

        #! Returns the validation constraints of the schema for its data type
        /** @return the constraints of the schema that its data type enforces and describes, including the number
            of properties of objects, if any

            @since RestSchemaValidator 2.5
        */
        *hash<DataTypeConstraintInfo> getConstraintInfo() {
            hash<auto> rv = AbstractSchemaBase::getConstraintInfo() ?? {};
            if (exists minProperties) {
                rv.min_properties = minProperties;
            }
            if (exists maxProperties) {
                rv.max_properties = maxProperties;
            }
            return rv ? cast<hash<DataTypeConstraintInfo>>(rv) : NOTHING;
        }

        #! Validates the value against the schema definition
        /** @param serialize if serializing the value
            @param request if processing a request (vs response)
            @param path the URI path or channel name
            @param method the HTTP method or operation name
            @param name the parameter name
            @param value reference to the value to validate/transform
        */
        abstract check(bool serialize, bool request, string path, string method,
            string name, reference<auto> value);

        #! Returns the items schema for arrays
        abstract *AbstractSchemaObject getItems();

        #! Returns a hash of property schemas for objects
        abstract *hash<string, AbstractSchemaObject> getProperties();

        #! Returns a data field definition from this schema
        /** @param name the name of the field
            @param desc optional description for the field
            @param required if the field is required
            @param rest optional REST client for URL resolution
            @param default_value optional default value

            @return the data field definition
        */
        abstract AbstractDataField getField(string name, *string desc, bool required = True, *object rest,
            auto default_value);
    }

    #! Abstract base class for schema objects with composition support (allOf/oneOf/anyOf/not)
    /** This class provides composition validation for JSON Schema composition keywords
        shared across OpenAPI 3.0 and AsyncAPI 3.0 specifications. Swagger 2.0 only uses allOf.

        @since RestSchemaValidator 2.5
    */
    public class AbstractComposableSchemaObject inherits AbstractSchemaObject {
        public {
            #! allOf schemas - value must match all schemas
            *list<AbstractSchemaObject> allOfSchemas;

            #! oneOf schemas - value must match exactly one schema
            *list<AbstractSchemaObject> oneOfSchemas;

            #! anyOf schemas - value must match at least one schema
            *list<AbstractSchemaObject> anyOfSchemas;

            #! not schema - value must NOT match this schema
            *AbstractSchemaObject notSchema;
        }

        #! Validates composition constraints (allOf/oneOf/anyOf/not)
        /** @param serialize if serializing the value
            @param request if processing a request (vs response)
            @param path the URI path or channel name
            @param method the HTTP method or operation name
            @param name the parameter name
            @param value reference to the value to validate/transform
        */
        validateComposition(bool serialize, bool request, string path, string method,
                string name, reference<auto> value) {
            # check "allOf" schemas, if any - all must match
            if (allOfSchemas) {
                foreach AbstractSchemaObject schema in (allOfSchemas) {
                    schema.check(serialize, request, path, method, name, \value);
                }
            }

            # check "oneOf" schemas, if any - value must match exactly one schema
            if (oneOfSchemas) {
                int matches = 0;
                list<string> matched_schemas;
                foreach AbstractSchemaObject schema in (oneOfSchemas) {
                    try {
                        auto test_value = value;
                        schema.check(serialize, request, path, method, name, \test_value);
                        ++matches;
                        matched_schemas += schema.name;
                    } catch (hash<ExceptionInfo> ex) {
                        # schema didn't match, continue
                    }
                }
                if (matches == 0) {
                    throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: value for %y does not match any of the oneOf "
                        "schemas", method.upr(), path, name);
                }
                if (matches > 1) {
                    throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: value for %y matches multiple oneOf schemas "
                        "(%y); must match exactly one", method.upr(), path, name, matched_schemas);
                }
            }

            # check "anyOf" schemas, if any - value must match at least one schema
            if (anyOfSchemas) {
                bool matched = False;
                foreach AbstractSchemaObject schema in (anyOfSchemas) {
                    try {
                        auto test_value = value;
                        schema.check(serialize, request, path, method, name, \test_value);
                        matched = True;
                        break;
                    } catch (hash<ExceptionInfo> ex) {
                        # schema didn't match, continue
                    }
                }
                if (!matched) {
                    throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: value for %y does not match any of the anyOf "
                        "schemas", method.upr(), path, name);
                }
            }

            # check "not" schema, if any - value must NOT match the schema
            if (notSchema) {
                try {
                    auto test_value = value;
                    notSchema.check(serialize, request, path, method, name, \test_value);
                    # if we get here, the value matched the "not" schema, which is an error
                    throw "SCHEMA-VALIDATION-ERROR", sprintf("%s %s: value for %y must not match the 'not' schema",
                        method.upr(), path, name);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "SCHEMA-VALIDATION-ERROR" && ex.desc !~ /must not match/) {
                        # good - the value didn't match the "not" schema
                    } else {
                        rethrow;
                    }
                }
            }
        }
    }

    #! Abstract base class for REST API schema objects (shared by Swagger and OpenApi3)
    /** Provides shared methods for data type generation, field generation, example code generation,
        and object property validation. AsyncApi uses a simpler schema object and does not inherit
        this class.
    */
    public class AbstractRestSchemaObject inherits AbstractComposableSchemaObject {
        public {
            #! Items schema for arrays
            *AbstractSchemaObject items;

            #! Properties for objects
            hash<string, AbstractSchemaObject> properties;

            #! Extension to allow properties to be nullable
            hash<string, bool> nullable_properties;

            #! Additional properties - MUST be a bool or an AbstractSchemaObject
            auto additionalProperties;

            #! A free-form property to include an example of an instance for this schema
            auto example;

            #! The data type of the schema (required)
            *AbstractDataProviderType dataType;

            #! The data type of the schema (not required)
            *AbstractDataProviderType orNothingDataType;
        }

        private {
            #! maps fields: name -> {Y,N} -> field
            /** The canonical field for a name, and also the <b>recursion cut</b>:
                @ref getFieldIntern() registers a field here before building its type and then updates
                that same field in place, so a property on the far side of a cycle is handed the very
                same object and still ends up with the real type.

                It is therefore keyed by the name alone and has to stay that way: keying it by anything a
                *use* supplies means a recursive re-entry with a different description misses the
                placeholder, and the type built at that depth is the incomplete one.  Per-use differences
                live in @ref usemap instead.

                The canonical field is the field of the bare use, with no description or default of its own,
                which is what a property of a schema is, whichever use asks for the name first: a use building
                it with its own documentation would hand that documentation to every property reached through
                the cut while it is being built, so a field would depend on which use came first.
            */
            hash<string, hash<string, AbstractDataField>> fieldmap;

            #! maps per-use fields: use key -> {Y,N} -> field
            /** A schema object is interned by its content, so two parameters with the same name and the
                same schema are one object.  That is right for the type, which the schema determines
                completely, and wrong for the field: a field also carries what the <b>use</b> supplies - its
                own description and default value.  Publishing the canonical field for every use gave
                whichever operation was registered second the first one's documentation.

                A use with a description or default of its own gets a copy carrying them over the canonical
                (finished) type.
            */
            hash<string, hash<string, AbstractDataField>> usemap;

            #! Canonical fields being built right now: name -> {Y,N} -> @ref True
            /** A field in here is the recursion cut and is deliberately incomplete: its type is a
                placeholder that is replaced in place once the build finishes.  Copying one would keep the
                placeholder forever, so a use that arrives while its variant is in here takes the canonical
                field, exactly as every use did before per-use copies existed.

                Keyed by variant as well, because building one variant can build the other one of the same name
                when a schema refers back to itself, and the inner build finishing does not finish the outer one.
            */
            hash<string, hash<string, bool>> building;

            #! The type given to replaceType(), from which a variant not cached when it was given is derived
            *AbstractDataProviderType replacedDataType;

            #! @ref True if this object holds types it caches through opaque references
            /** Set when the schema first lets this object hold a cache entry through an opaque reference; see
                @ref RestSchemaValidator::AbstractRestSchemaValidator::holdTypeCacheOpaquely()
                "AbstractRestSchemaValidator::holdTypeCacheOpaquely()"
            */
            bool holds_opaque_type_caches;

            #! The location of the schema in its document, if known; see getSchemaIdentity()
            *string schema_identity;
        }

        #! Returns the data provider type for a given type/format/items path
        /** Must be implemented by each module to delegate to the module-specific schema's getType() method.
        */
        abstract AbstractDataProviderType getSchemaType(string path, string typestr, *string format,
            *AbstractSchemaObject arrayItems, bool required);

        #! Returns True if this schema has composition features that require special type handling
        /** Override in modules that support oneOf/anyOf/not to check for composition features.
            Default returns False (Swagger behavior).
        */
        bool hasSchemaCompositionFeatures() {
            return False;
        }

        #! Returns True if this schema has composition keywords (oneOf/anyOf/not) that require
        #! relaxed additionalProperties handling
        /** Override in modules that support composition keywords.
            Default returns False.

            @note This is separate from hasSchemaCompositionFeatures() which also considers
            readOnly/writeOnly for data type creation purposes.
        */
        bool hasCompositionKeywords() {
            return False;
        }

        #! Factory method to create a HashDataType
        /** Override in modules that need specialized hash data types (e.g., OpenApi3HashDataType).
        */
        HashDataType createHashDataType(Type base_type, string typename) {
            return new HashDataType(base_type, typename);
        }

        #! Returns the location of the schema in its document, if known
        /** The location identifies the schema among the schemas of its document: a schema declared under a name
            of its own, such as an OpenAPI component, is identified by that name, a schema that only refers to one
            by the schema it refers to, and a schema declared in place by its location below the schema or
            parameter that declares it.  An object type built from the schema has it as its
            @ref DataProvider::AbstractDataProviderType::getSchemaIdentity() "schema identity", so that two schemas
            with the same name and properties, which can describe their properties differently, give types with
            their own catalog messages.  It never depends on a description.

            @return the location of the schema in its document, or @ref nothing if the module that parsed the
            schema does not track it

            @since RestSchemaValidator 2.5
        */
        *string getSchemaIdentity() {
            return schema_identity;
        }

        #! Appends a JSON Pointer reference token to a schema location
        /** @param location the location of the schema that declares the child, or @ref nothing if unknown
            @param token the reference token of the child, unescaped

            @return the location of the child, or @ref nothing if \a location is unknown

            @since RestSchemaValidator 2.5
        */
        static *string childSchemaIdentity(*string location, string token) {
            if (!location.val()) {
                return;
            }
            return location + "/" + AbstractRestSchemaObject::schemaIdentityToken(token);
        }

        #! Escapes a JSON Pointer reference token
        /** @param token the reference token, unescaped

            @return the token as written in a JSON Pointer: \c "~" as \c "~0" and \c "/" as \c "~1"
            (<a href="https://www.rfc-editor.org/rfc/rfc6901#section-3">RFC 6901 section 3</a>)

            @since RestSchemaValidator 2.5
        */
        static string schemaIdentityToken(string token) {
            return replace(replace(token, "~", "~0"), "/", "~1");
        }

        #! Returns the schema whose type builds this schema object takes part in, if it serializes them
        /** The base class returns @ref nothing, so that the types of a schema that does not serialize its type
            builds are built as they were before; see
            @ref RestSchemaValidator::AbstractRestSchemaValidator::runTypeBuild()

            @since RestSchemaValidator 2.5
        */
        *AbstractRestSchemaValidator getTypeBuildSchema() {
            return NOTHING;
        }

        #! Returns the data type for this schema
        AbstractDataProviderType getDataType(bool required = True, *object rest) {
            *AbstractRestSchemaValidator schema = getTypeBuildSchema();
            if (schema && !schema.isTypeBuildActive()) {
                return schema.runTypeBuild(AbstractDataProviderType sub () {
                    return getDataType(required, rest);
                });
            }
            if (*AbstractDataProviderType t = getReplacedDataType(required)) {
                return t;
            }
            # each variant is built from the schema and never derived from the other one: a derived variant is not
            # the type the schema gives, so a type would depend on which variant was built first
            if (required) {
                if (!dataType) {
                    # "dataType" is assigned in the call below
                    getDataTypeIntern("/", True, rest);
                }
                return dataType;
            }
            if (!orNothingDataType) {
                # "orNothingDataType" is assigned in the call below
                getDataTypeIntern("/", False, rest);
            }
            return orNothingDataType;
        }

        #! Returns the given variant of the type given to replaceType(), or @ref nothing if it has not been called
        /** A variant that was not cached when the type was replaced is derived from the replacement, because the
            replacement and not the schema gives this schema's type from then on.

            @param required @ref True for the mandatory type, @ref False for the "or nothing" type

            @since RestSchemaValidator 2.5
        */
        private *AbstractDataProviderType getReplacedDataType(bool required) {
            if (!replacedDataType) {
                return NOTHING;
            }
            if (required) {
                if (!dataType) {
                    setCachedDataType(True, replacedDataType.getMandatoryType());
                }
                return dataType;
            }
            if (!orNothingDataType) {
                setCachedDataType(False, replacedDataType.getOrNothingType());
            }
            return orNothingDataType;
        }

        #! Replaces the cached data type(s) for this schema with the given type
        /** Updates the mandatory and/or "or nothing" cached data types from the given type, preserving the
            required/optional cardinality already present in the schema.  A variant that is asked for later is
            derived from the given type rather than built from the schema.

            Has no effect if neither variant of this schema's type has been built.

            @param t the new data type to use for this schema

            @since RestSchemaValidator 2.5
        */
        replaceType(AbstractDataProviderType t) {
            *AbstractRestSchemaValidator schema = getTypeBuildSchema();
            if (schema && !schema.isTypeBuildActive()) {
                schema.runTypeBuild(sub () {
                    replaceType(t);
                });
                return;
            }
            if (!dataType && !orNothingDataType) {
                return;
            }
            if (schema) {
                # the given type is not built by the schema, so the schema cannot know what it refers to; see
                # AbstractRestSchemaValidator::stopOpaqueTypeCaches()
                schema.stopOpaqueTypeCaches();
            }
            if (schema && schema.isTypeBuildActive()) {
                *AbstractDataProviderType prev = replacedDataType;
                schema.recordTypeBuildWrite(sub () {
                    replacedDataType = prev;
                });
            }
            replacedDataType = t;
            if (t.isOrNothingType()) {
                if (dataType) {
                    setCachedDataType(True, t.getMandatoryType());
                }
                if (orNothingDataType) {
                    setCachedDataType(False, t);
                }
            } else {
                if (dataType) {
                    setCachedDataType(True, t);
                }
                if (orNothingDataType) {
                    setCachedDataType(False, t.getOrNothingType());
                }
            }
        }

        #! Sets a cached data type of this schema, recording the write in the type build in progress
        /** @param required @ref True for the mandatory type, @ref False for the "or nothing" type
            @param t the type to cache

            @since RestSchemaValidator 2.5
        */
        private setCachedDataType(bool required, AbstractDataProviderType t) {
            *AbstractRestSchemaValidator schema = getTypeBuildSchema();
            bool opaque;
            if (schema && schema.isTypeBuildActive()) {
                opaque = holdCacheEntryOpaquely(schema);
                *AbstractDataProviderType prev = required ? dataType : orNothingDataType;
                schema.recordTypeBuildWrite(sub () {
                    # the schema can have stopped opaque type caches since the write
                    bool opaque_undo = holdCacheEntryOpaquely(schema);
                    if (required) {
                        if (opaque_undo) {
                            dataType @= prev;
                        } else {
                            dataType = prev;
                        }
                    } else if (opaque_undo) {
                        orNothingDataType @= prev;
                    } else {
                        orNothingDataType = prev;
                    }
                });
            }
            if (required) {
                if (opaque) {
                    dataType @= t;
                } else {
                    dataType = t;
                }
            } else if (opaque) {
                orNothingDataType @= t;
            } else {
                orNothingDataType = t;
            }
        }

        #! Returns @ref True if this object holds a type it caches in the type build in progress through an opaque reference
        /** @param schema the schema whose type build is in progress in the calling thread

            @return @ref True if the cache entry is to be assigned with the opaque assignment operator (\c \@=)

            @see @ref RestSchemaValidator::AbstractRestSchemaValidator::holdTypeCacheOpaquely()
            "AbstractRestSchemaValidator::holdTypeCacheOpaquely()"

            @since RestSchemaValidator 2.5
        */
        private bool holdCacheEntryOpaquely(AbstractRestSchemaValidator schema) {
            if (!schema.holdTypeCacheOpaquely(self)) {
                return False;
            }
            if (!holds_opaque_type_caches) {
                holds_opaque_type_caches = True;
            }
            return True;
        }

        #! Releases the types and fields that this object caches
        /** Called by the schema for every schema object it let hold a cache entry through an opaque reference (see
            @ref RestSchemaValidator::AbstractRestSchemaValidator::holdTypeCacheOpaquely()
            "AbstractRestSchemaValidator::holdTypeCacheOpaquely()") when it is destroyed, or when it stops letting
            schema objects do so (see @ref RestSchemaValidator::AbstractRestSchemaValidator::stopOpaqueTypeCaches()
            "AbstractRestSchemaValidator::stopOpaqueTypeCaches()").  The garbage collector does not follow those
            references, so a cycle running through one, as from a schema object to the type it caches and from a
            union alternative of that type back to the schema object, is only released here.

            A type that is still referenced keeps its fields and the schema objects it validates with, so values are
            validated as before.  A schema object of a schema that still exists builds the types again when they are
            next asked for; one whose schema has been destroyed cannot build types, so it no longer gives the types
            it cached.

            @since RestSchemaValidator 2.5
        */
        releaseTypeCaches() {
            remove dataType;
            remove orNothingDataType;
            fieldmap = {};
            usemap = {};
            holds_opaque_type_caches = False;
        }

        #! Copies the object without the type caches it holds through opaque references
        /** A copy is not known to the schema, which releases the opaque type caches of the objects it knows (see
            releaseTypeCaches()), so a copy of an object holding such caches builds its own types.

            @param old the object copied

            @since RestSchemaValidator 2.5
        */
        copy(AbstractRestSchemaObject old) {
            if (holds_opaque_type_caches) {
                releaseTypeCaches();
            }
        }

        #! Sets a cached canonical field or per-use field, recording the write in the type build in progress
        /** @param use @ref True for a per-use field (keyed by the use key), @ref False for a canonical field (keyed
            by the field name)
            @param key the field name or use key
            @param rstr the requiredness key: \c "Y" or \c "N"
            @param field the field to cache

            @since RestSchemaValidator 2.5
        */
        private setCachedField(bool use, string key, string rstr, AbstractDataField field) {
            *AbstractRestSchemaValidator schema = getTypeBuildSchema();
            bool opaque;
            if (schema && schema.isTypeBuildActive()) {
                opaque = holdCacheEntryOpaquely(schema);
                *AbstractDataField prev = use ? usemap{key}{rstr} : fieldmap{key}{rstr};
                schema.recordTypeBuildWrite(sub () {
                    # the schema can have stopped opaque type caches since the write
                    bool opaque_undo = prev && holdCacheEntryOpaquely(schema);
                    if (use) {
                        if (prev) {
                            if (opaque_undo) {
                                usemap{key}{rstr} @= prev;
                            } else {
                                usemap{key}{rstr} = prev;
                            }
                        } else {
                            remove usemap{key}{rstr};
                            if (!usemap{key}) {
                                remove usemap{key};
                            }
                        }
                    } else if (prev) {
                        if (opaque_undo) {
                            fieldmap{key}{rstr} @= prev;
                        } else {
                            fieldmap{key}{rstr} = prev;
                        }
                    } else {
                        remove fieldmap{key}{rstr};
                        if (!fieldmap{key}) {
                            remove fieldmap{key};
                        }
                    }
                });
            }
            if (use) {
                if (opaque) {
                    usemap{key}{rstr} @= field;
                } else {
                    usemap{key}{rstr} = field;
                }
            } else if (opaque) {
                fieldmap{key}{rstr} @= field;
            } else {
                fieldmap{key}{rstr} = field;
            }
        }

        #! Returns the data type for the given schema
        private AbstractDataProviderType getDataTypeIntern(string path, bool required = True, *object rest) {
            if (type == "string") {
                AbstractDataProviderType t = AbstractDataProviderType::get((required ? "" : "*") + "string")
                    .copyWithConstraints(getConstraintInfo());
                setCachedDataType(required, t);
                return t;
            }

            # For "any" type schemas without properties and without composition features, return an auto type
            if (type == "any" && !properties && !hasSchemaCompositionFeatures()) {
                AbstractDataProviderType t = AbstractDataProviderType::get(required ? "auto" : "*auto")
                    .copyWithConstraints(getConstraintInfo());
                setCachedDataType(required, t);
                return t;
            }

            auto def_body;
            if (rest) {
                # preprocessRequestBody is now on AbstractRestClient (identity default);
                # MewsRestClient-family subclasses override it to return the default body
                # with injected auth-token fields used as required field defaults here
                def_body = rest.preprocessRequestBody();
                if (exists def_body && def_body.typeCode() != NT_HASH) {
                    remove def_body;
                }
                # the values become the default values of the fields, which the schema does not build
                if (def_body && !AbstractRestSchemaObject::isPlainData(def_body)) {
                    *AbstractRestSchemaValidator schema = getTypeBuildSchema();
                    if (schema) {
                        schema.stopOpaqueTypeCaches();
                    }
                }
            }

            string typename = required
                ? name
                : "*" + name;

            HashDataType t = createHashDataType(required ? AutoHashType : AutoHashOrNothingType, typename);
            if (schema_identity) {
                t.setSchemaIdentity(schema_identity);
            }
            # set before the type is referenced by any field, which a recursive schema does
            if (*hash<DataTypeConstraintInfo> constraints = getConstraintInfo()) {
                t = cast<HashDataType>(t.copyWithConstraints(constraints));
            }

            setCachedDataType(required, t);
            getSchemaObjectFields(t, path, def_body);
            if (additionalProperties === True) {
                t.setDefaultOtherFieldType(AbstractDataProviderTypeMap."auto");
            } else if (additionalProperties) {
                string new_path = path == "/"
                    ? "/" + additionalProperties.type
                    : path + "/" + additionalProperties.type;
                t.setDefaultOtherFieldType(getSchemaType(new_path,
                    additionalProperties.type, additionalProperties.format,
                    additionalProperties.items,
                    !additionalProperties.nullable));
            } else if (hasCompositionKeywords()) {
                # For schema composition (oneOf/anyOf/not), allow additional properties since
                # the composition validation will handle checking
                t.setDefaultOtherFieldType(AbstractDataProviderTypeMap."auto");
            } else {
                # make sure that extra fields are not supported
                t.setDefaultOtherFieldType();
            }

            return t;
        }

        #! Returns a field definition from the schema parameter
        AbstractDataField getField(string name, *string desc, bool required = True, *object rest,
                auto default_value) {
            return getFieldForUse(name, name, desc, required, rest, default_value);
        }

        #! Returns a field definition from the schema parameter
        AbstractDataField getField(string path, string name, *string desc, bool required = True, *object rest,
                auto default_value) {
            return getFieldForUse(path, name, desc, required, rest, default_value);
        }

        #! Returns the field for one use of this schema, building or decorating it as needed
        private AbstractDataField getFieldForUse(string path, string name, *string desc, bool required,
                *object rest, auto default_value) {
            *AbstractRestSchemaValidator schema = getTypeBuildSchema();
            if (schema && !schema.isTypeBuildActive()) {
                return schema.runTypeBuild(AbstractDataField sub () {
                    return getFieldForUse(path, name, desc, required, rest, default_value);
                });
            }
            string rstr = required ? "Y" : "N";
            string ukey = AbstractRestSchemaObject::getFieldUseKey(name, desc, default_value);
            if (*AbstractDataField rv = getCacheField(True, ukey, rstr)) {
                return rv;
            }
            if (*AbstractDataField rv = getCacheField(False, name, rstr)) {
                return decorateField(rv, ukey, name, desc, required, default_value, rstr);
            }
            # the canonical field is built for the bare use, whichever use asks for it first; see fieldmap
            return decorateField(getFieldIntern(path, name, NOTHING, required, rest, NOTHING, rstr), ukey, name,
                desc, required, default_value, rstr);
        }

        #! Returns @ref True if the value consists of scalar values only, also in its lists and hashes
        /** Such a value cannot refer to a schema; see
            @ref RestSchemaValidator::AbstractRestSchemaValidator::stopOpaqueTypeCaches()
            "AbstractRestSchemaValidator::stopOpaqueTypeCaches()"

            @since RestSchemaValidator 2.5
        */
        private static bool isPlainData(auto v) {
            switch (v.typeCode()) {
                case NT_NOTHING:
                case NT_NULL:
                case NT_INT:
                case NT_FLOAT:
                case NT_NUMBER:
                case NT_STRING:
                case NT_CHAR:
                case NT_DATE:
                case NT_BOOLEAN:
                case NT_BINARY:
                    return True;
                case NT_HASH:
                    foreach auto e in (v.iterator()) {
                        if (!AbstractRestSchemaObject::isPlainData(e)) {
                            return False;
                        }
                    }
                    return True;
                case NT_LIST:
                    foreach auto e in (v) {
                        if (!AbstractRestSchemaObject::isPlainData(e)) {
                            return False;
                        }
                    }
                    return True;
            }
            # an object, a closure, a call reference or any other value that can refer to something else
            return False;
        }

        #! Returns the key identifying one <b>use</b> of this schema as a field
        /** @param name the field name
            @param desc the description supplied by the use, before this schema's own is merged into it
            @param default_value the default value supplied by the use

            @return the use key

            @note The common case - no description and no default - keeps the name as its own key rather
            than paying for a digest; the two forms cannot collide because each carries its own prefix.
        */
        private static string getFieldUseKey(string name, *string desc, auto default_value) {
            if (!desc.val() && !exists default_value) {
                return "n:" + name;
            }
            return "h:" + sprintf("%y\n%y\n%y", name, desc, default_value).toSHA256();
        }

        #! Returns the field a use should see, which is a copy when it differs from the canonical one
        /** @param canonical the field cached under this name
            @param ukey the use key
            @param name the field name
            @param desc the description supplied by the use, before this schema's own is merged into it
            @param required whether the use declares the field required
            @param default_value the default value supplied by the use
            @param rstr the requiredness cache key

            @return the field for this use

            @note A use that arrives while the canonical field is still being built takes it as it is; see
            @ref building.
        */
        private AbstractDataField decorateField(AbstractDataField canonical, string ukey, string name,
                *string desc, bool required, auto default_value, string rstr) {
            if (building{name}{rstr} || ukey == AbstractRestSchemaObject::getFieldUseKey(name, NOTHING, NOTHING)) {
                return canonical;
            }
            # built exactly as getFieldIntern() builds the canonical field, and given its finished type the
            # same way: the schema's enum values are hash keys and therefore strings, and it is
            # updateFieldType() that converts them to the type they belong to.  Constructing the copy with
            # the final type instead leaves an integer enum published as a list of strings.
            RestSchemaExampleDataField rv({
                "name": name,
                "desc": getMergedFieldDesc(desc),
                "type": AutoType,
                "allowed_values": getFieldEnumValues(),
                "default_value": default_value,
            } + getFieldPresenceInfo(required), getValidatedExampleCandidates(), getConstraintInfo());
            rv.updateFieldType(canonical.getType());
            setCachedField(True, ukey, rstr, rv);
            return rv;
        }

        #! Returns the field attributes of a use requiring an object, composition or nullable field
        /** A use requiring such a field marks it required and preselected.  A required use of a nullable schema
            has the value type of an optional use, because only the presence of the property is required and an
            explicit \c null is valid, so for it these attributes are the only thing saying the field is required.

            getFieldIntern() and decorateField() both take the attributes from here, so that a field is the same
            whichever use built the canonical field.

            @param required whether the use declares the field required

            @return the attributes to add to the field's info, or @ref nothing if it needs none

            @since RestSchemaValidator 2.5
        */
        private *hash<auto> getFieldPresenceInfo(bool required) {
            if (required && (nullable || type == "object" || hasSchemaCompositionFeatures())) {
                return {
                    "attr": {
                        "preselected": True,
                        "required": True,
                    },
                };
            }
        }

        #! Returns the description a field carries, with this schema's own merged into the use's
        /** @param desc the description supplied by the use

            @return the description to give the field, never @ref nothing
        */
        private string getMergedFieldDesc(*string desc) {
            if (self.desc.val()) {
                # a parameter and the schema it points at often carry the same text - every document
                # FastAPI generates does this - and joining those gives "X: X", which is what the
                # user then reads on the option.  One being a prefix of the other is the same case
                # with one side merely saying more: Exa documents an agent run id as "Agent run ID."
                # on the parameter and "Agent run ID. New run IDs are returned with the `agent_run_`
                # prefix." on the schema, and joining those repeats the first sentence.  Keep
                # whichever says more instead
                string schema_desc = trim(self.desc);
                string param_desc = desc.val() ? trim(desc) : "";
                if (!param_desc.val()) {
                    desc = self.desc;
                } else if (param_desc == schema_desc || schema_desc.find(param_desc) == 0) {
                    desc = self.desc;
                } else if (param_desc.find(schema_desc) != 0) {
                    desc += ": " + self.desc;
                }
            }
            return desc.val() ? desc.getDecoded(CE_XHTML) : "";
        }

        #! Returns enumeration values for field construction
        /** Subclasses can attach structured presentation metadata. updateFieldType() restores
            each value's declared scalar type after the placeholder field is constructed.
        */
        private *list<auto> getFieldEnumValues() {
            return keys enumValues;
        }

        #! Returns schema examples followed by the default
        /** @return candidate values in preference order; each is validated against the finished field type
        */
        private list<auto> getExampleCandidates() {
            return (example, defaultVal);
        }

        #! Checks declared candidates against the schema before they are attached to a field
        private list<auto> getValidatedExampleCandidates() {
            list<auto> rv = ();
            foreach auto candidate in (getExampleCandidates()) {
                if (exists candidate) {
                    try {
                        check(False, True, "/", "POST", name, \candidate);
                        push rv, candidate;
                    } catch (hash<ExceptionInfo> ex) {
                        # Specifications can contain invalid examples, including invalid nested properties.
                    }
                }
            }
            return rv;
        }

        #! Returns a field object from the given cache
        /** @param use @ref True for the per-use cache (keyed by the use key), @ref False for the canonical cache
            (keyed by the field name)
            @param cache_key the field name or use key
            @param key the requiredness key: \c "Y" or \c "N"
        */
        private *AbstractDataField getCacheField(bool use, string cache_key, string key) {
            # a variant that is not cached is built from the schema by getFieldIntern() and never derived from the
            # other one: a derived field is not the field the schema gives, so a field would depend on which
            # variant was built first
            return use ? usemap{cache_key}{key} : fieldmap{cache_key}{key};
        }

        #! Sets fields of a schema object
        private getSchemaObjectFields(HashDataType t, string path, auto def_body) {
            map t.addField($1.value.getField(path + "/" + $1.key, $1.key, NOTHING,
                required{$1.key} ?? False, NOTHING, def_body{$1.key})), properties.pairIterator();
        }

        #! Returns a field definition from the schema parameter
        private AbstractDataField getFieldIntern(string path, string name, *string desc, bool required = True,
                *object rest, auto default_value, *string rstr) {
            if (!rstr) {
                rstr = required ? "Y" : "N";
            }
            string field_desc = getMergedFieldDesc(desc);
            # the field registered below is handed to anything that re-enters this schema while its type
            # is being built, so it must not be copied until that build has finished; the other variant of the
            # name can be built inside this build, so only this variant is marked and unmarked here
            building{name}{rstr} = True;
            on_exit {
                remove building{name}{rstr};
                if (!building{name}) {
                    remove building{name};
                }
            }
            # create the field with a placeholder type
            RestSchemaExampleDataField field({
                "name": name,
                "desc": field_desc,
                "type": AutoType,
                "allowed_values": getFieldEnumValues(),
                "default_value": default_value,
            } + getFieldPresenceInfo(required), getValidatedExampleCandidates(), getConstraintInfo());
            setCachedField(False, name, rstr, field);
            # a required use of a nullable schema has the value type of an optional use; only the presence of the
            # property is required (see getFieldPresenceInfo())
            bool required_value = required && !nullable;
            if (type == "object" || hasSchemaCompositionFeatures()) {
                field.updateFieldType(getDataType(required_value, rest));
            } else {
                field.updateFieldType(getSchemaType(path, type, format, items, required_value));
            }
            return field;
        }

        #! Validates default values
        private static checkValueType(reference<auto> value, string type, *AbstractSchemaObject items, *string loc) {
            int vt = value.typeCode();
            if (type == "array") {
                if (vt != NT_LIST)
                    throw "INVALID-FIELD-TYPE", sprintf("Schema Object: 'default' value%s has invalid type %y "
                        "(expecting schema type %y)", loc, value.type(), type);
                AbstractRestSchemaObject::checkValueType(\value[0], items.type, items.getItems(), loc + "[0]");
            }
            if (!AbstractSchemaBaseValidator::checkValueType(\value, type)) {
                throw "INVALID-FIELD-TYPE", sprintf("Schema Object: 'default' value%s has invalid type %y (val: %y) "
                    "(expecting schema type %y)", loc, value.type(), value, type);
            }
        }

        #! Returns the items schema for arrays
        *AbstractSchemaObject getItems() {
            return items;
        }

        #! Returns a hash of property schemas for objects
        *hash<string, AbstractSchemaObject> getProperties() {
            return properties;
        }
    }

    #! A schema field whose example candidates are validated after its type is complete
    /** Schema fields initially carry placeholder types to break recursive graphs. Validation is deferred until
        an example is requested so that it sees the finished type, including any action-specific conversions.
        Candidates are immutable and copied with the field when its type or presentation changes.

        @par Example:
        A product identifier constrained by a pattern uses the vendor's valid example identifier; an invalid
        placeholder is omitted instead of preventing the action's input fields from being constructed.

        @since RestSchemaValidator 2.5
    */
    public class RestSchemaExampleDataField inherits QoreDataField {
        private {
            list<auto> candidates;
            AbstractDataProviderType example_constraints;
        }

        #! Creates a schema field with candidate example values
        /** @param info field construction information
            @param candidates schema examples, defaults, and scalar examples in preference order
            @param constraints schema constraints to check even when the field type does not describe them
            @throw QORE-DATA-FIELD-ERROR invalid field construction information
            @throw RUNTIME-TYPE-ERROR a supplied field value violates its type
        */
        constructor(hash<auto> info, list<auto> candidates, *hash<DataTypeConstraintInfo> constraints)
                : QoreDataField(info) {
            self.candidates = candidates;
            example_constraints = AbstractDataProviderTypeMap."auto".copyWithConstraints(constraints);
        }

        #! Returns the first accepted schema example or a generated example
        /** @param emap types already visited by the example traversal
            @param fname field context for generated values
            @return an accepted example, or @ref nothing when no example can be generated
        */
        auto getExampleValue(*hash<string, bool> emap, *string fname) {
            foreach auto candidate in (candidates) {
                if (exists candidate) {
                    try {
                        auto value = acceptsValue(candidate);
                        example_constraints.checkConstraints(value);
                        return value;
                    } catch (hash<ExceptionInfo> ex) {
                        # An invalid example in a specification must not invalidate its field metadata.
                    }
                }
            }
            auto candidate = QoreDataField::getExampleValue(emap, fname);
            if (exists candidate) {
                try {
                    auto value = acceptsValue(candidate);
                    example_constraints.checkConstraints(value);
                    return value;
                } catch (hash<ExceptionInfo> ex) {
                    # Field defaults and choices can have been attached to the original placeholder type.
                }
            }
        }
    }

    #! Abstract base class for parameter objects
    /** This class provides the common interface for parameter objects shared by both
        Swagger 2.0 and OpenAPI 3.0 specifications.
    */
    public class AbstractParameterObject inherits Qore::Serializable {
        public {
            #! The name of the parameter (case sensitive)
            /** - If @ref inLoc is \c "path", the \c name field MUST correspond to the
                  associated path segment from the path field in the Paths Object.
                - For all other cases, the name corresponds to the parameter name
                  used based on the @ref inLoc property.
            */
            string name;

            #! The location of the parameter
            /** Possible values are \c "query", \c "header", \c "path", \c "formData" or \c "body".
            */
            string inLoc;

            #! Description of the parameter
            /** This could contain examples of use. GFM/CommonMark syntax can be used for
                rich text representation.
            */
            *string desc;

            #! Whether the parameter is required
            /** If the parameter is in "path", this property is required and its value
                MUST be \c True. Otherwise, the property MAY be included and its default
                value is \c False.
            */
            bool required = False;
        }

        #! Validates the parameter value
        /** @param serialize if serializing the value
            @param request if processing a request (vs response)
            @param path the URI path
            @param method the HTTP method
            @param name the parameter name
            @param value reference to the value to validate/transform
        */
        abstract check(bool serialize, bool request, string path, string method,
            string name, reference value);

        #! Returns the schema for this parameter, if any
        abstract *AbstractSchemaObject getSchema();

        #! Converts one query argument to the type its schema declares for it
        /** A query argument travels in the URI as a string and is read back out of it as one, so a
            parameter declared as anything else has to be converted before it is checked, or every request
            carrying it is rejected for sending the value in the only form a URI can carry.

            An <b>array</b> is converted element by element as well.  The element schema is checked strictly,
            so an array of integers would otherwise be rejected for holding the strings it must be sent as,
            and the parameter would be unusable: this is what made a search on a list of identifiers fail
            with <tt>invalid type "string" (should be "integer")</tt>.

            @param type the schema type to convert to
            @param format the schema format, where the type alone does not say what the value is
            @param items the element schema, required when \a type is \c "array"
            @param path the URI path, for error messages
            @param method the HTTP method, for error messages
            @param name the parameter name, for error messages
            @param value the value to convert

            @return the converted value; a value the schema does not describe is returned unchanged

            @throw SCHEMA-VALIDATION-ERROR the value cannot be read as the type declared for it

            @since RestSchemaValidator 2.5
        */
        static auto convertQueryArg(*string type, *string format, *AbstractSchemaObject items, string path,
                string method, string name, auto value) {
            if (type != "array") {
                return AbstractParameterObject::convertQueryScalar(type, format, path, method, name, value);
            }
            switch (value.typeCode()) {
                case NT_STRING:
                    value = value.split(",");
                    break;
                case NT_LIST:
                    break;
                default:
                    value = exists value ? (value,) : ();
                    break;
            }
            if (!items) {
                return value;
            }
            list<auto> rv = ();
            foreach auto v in (value) {
                rv += AbstractParameterObject::convertQueryScalar(items.type, items.format, path, method,
                    name, v);
            }
            return rv;
        }

        #! Converts one scalar query argument value to the type its schema declares for it
        /** @see @ref convertQueryArg()
        */
        private static auto convertQueryScalar(*string type, *string format, string path, string method,
                string name, auto value) {
            switch (type) {
                case "integer": {
                    if (value.typeCode() == NT_STRING) {
                        if (value =~ /[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-2][0-9]:[0-5][0-9]:[0-5][0-9])?/) {
                            return date(value).getEpochSeconds();
                        }
                        if (value !~ /^([+-])?[0-9]+$/) {
                            throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and method "
                                "%y of type \"integer\" is invalid; value provided: %y", name, path, method,
                                value);
                        }
                        return value.toInt();
                    }
                    break;
                }
                case "number":
                    if (value.typeCode() == NT_STRING) {
                        return value.toNumber();
                    }
                    break;
                case "string":
                    switch (format) {
                        case "date":
                        case "date-time":
                            try {
                                return date(value);
                            } catch (hash<ExceptionInfo> ex) {
                                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and "
                                    "method %y of type \"date\" is invalid; value provided: %y (%s)", name,
                                    path, method, value, ex.desc);
                            }
                        case "binary":
                            try {
                                return binary(value);
                            } catch (hash<ExceptionInfo> ex) {
                                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and "
                                    "method %y of type \"binary\" is invalid; value provided: %y (%s)",
                                    name, path, method, value, ex.desc);
                            }
                        case "byte":
                            try {
                                return parse_base64_string(value);
                            } catch (hash<ExceptionInfo> ex) {
                                throw "SCHEMA-VALIDATION-ERROR", sprintf("Parameter %y for path %y and "
                                    "method %y of type \"binary\" is invalid; value provided: %y (%s)",
                                    name, path, method, value, ex.desc);
                            }
                    }
                    break;
                case "boolean":
                    return parse_boolean(value);
            }
            return value;
        }
    }

    #! Abstract base class for response objects
    /** This class provides the common interface for response objects shared by both
        Swagger 2.0 and OpenAPI 3.0 specifications.
    */
    public class AbstractResponseObject inherits Qore::Serializable {
        public {
            #! A short description of the response
            /** GFM/CommonMark syntax can be used for rich text representation.
            */
            string desc;

            #! A hash of headers that can be sent with the response
            /** Keys are header names.
            */
            hash<auto> headers;

            #! A hash of example response messages
            hash examples;
        }

        #! Returns the response schema, if any
        abstract *AbstractSchemaObject getSchema();
    }

    #! Abstract base class for responses container
    /** This class provides the common interface for the responses object shared by both
        Swagger 2.0 and OpenAPI 3.0 specifications.
    */
    public class AbstractResponsesObject inherits Qore::Serializable {
        #! Returns the default response, if any
        abstract *AbstractResponseObject getDefaultResponse();

        #! Returns the hash of responses by HTTP status code
        abstract *hash<string, AbstractResponseObject> getResponses();
    }

    #! Abstract base class for path item objects
    /** This class provides the common interface for path item objects shared by both
        Swagger 2.0 and OpenAPI 3.0 specifications.
    */
    public class AbstractPathItemObject inherits Qore::Serializable {
        #! Returns the operation for the given HTTP method
        /** @param method the HTTP method name (case insensitive)
            @param path the path for error reporting

            @return the operation object for the given method

            @throws INVALID-METHOD the given path does not have any operation defined for the given method
        */
        abstract AbstractOperationObject getOperation(string method, string path);

        #! Returns a list of HTTP methods supported by this path
        abstract softlist getMethods();

        #! Returns the body parameter defined at the path level, if any
        abstract *AbstractParameterObject getBody();

        #! Returns a hash of parameters defined at the path level
        abstract *hash<string, AbstractParameterObject> getParameters();
    }

    #! Abstract base class for operation objects
    /** This class provides the common interface for operation objects shared by both
        Swagger 2.0 and OpenAPI 3.0 specifications.
    */
    public class AbstractOperationObject inherits Qore::Serializable {
        public {
            #! The URI path for the operation
            string path;

            #! The HTTP method (uppercase)
            string method;

            #! A short summary of what the operation does
            *string summary;

            #! A verbose explanation of the operation behavior
            /** GFM/CommonMark syntax can be used for rich text representation.
            */
            *string desc;

            #! MIME types the operation can consume
            hash<string, bool> consumes;

            #! MIME types the operation can produce
            hash<string, bool> produces;
        }

        #! Returns the responses object for this operation
        abstract AbstractResponsesObject getResponses();

        #! Returns the body parameter, if any
        abstract *AbstractParameterObject getBody();

        #! Returns a hash of parameters for this operation
        abstract *hash<string, AbstractParameterObject> getParameters();

        #! Validates the request against the schema
        /** @param serialize if \c True, serialize the body
            @param pio the path item object
            @param h reference to URI query info
            @param body reference to the request body
            @param headers reference to headers
            @param mime_types reference to accepted MIME types
            @param freeform if \c True, allow freeform validation (optional, Swagger-specific)
        */
        abstract validateRequest(bool serialize, AbstractPathItemObject pio,
            reference<hash<UriQueryInfo>> h, reference<auto> body,
            reference<hash> headers, *reference<hash<string, bool>> mime_types,
            *bool freeform);

        #! Returns the serialized request body
        /** @param pio the path item object
            @param body the request body
            @param headers reference to headers
            @param freeform if \c True, allow freeform validation (optional)

            @return the serialized request body data
        */
        abstract *data getRequestBody(AbstractPathItemObject pio, auto body,
            reference<hash<auto>> headers, *bool freeform);
    }

    #! abstract REST schema validation classes
    public class AbstractRestSchemaValidator inherits Logger::LoggerWrapper, Qore::Serializable {
        private:internal {
            #! Serializes the type builds of this schema; the thread holding it is the one building
            transient Mutex type_build_lock();

            #! How to undo the cache writes of the type build in progress, in the order they were made
            transient list<code> type_build_undo = ();

            #! Whether schema objects may hold the types they cache through opaque references; see holdTypeCacheOpaquely()
            transient bool opaque_type_caches;

            #! The schema objects holding types they cache through opaque references: unique hash -> weak reference
            transient hash<auto> opaque_type_cache_holders = {};

            #! Whether the opaque type caches are to be released once the type build in progress has finished
            transient bool release_opaque_type_caches;
        }

        #! Creates the object without a logger
        constructor() {
        }

        #! Creates the object with the given logger
        constructor(Logger::LoggerInterface logger) : LoggerWrapper(logger) {
        }

        #! Releases the types that the schema objects of the schema cache through opaque references
        /** @see holdTypeCacheOpaquely()
        */
        destructor() {
            releaseTypeCaches();
        }

        #! Runs a type build of this schema as one transaction
        /** Schema objects cache the data types and fields they derive, and a build fills those caches as it goes:
            a recursive schema is cut by a placeholder field that is completed in place once its type is built, and
            the types built meanwhile refer to it.  A build that throws part of the way through would leave such
            placeholders, and the types that refer to them, in caches that every later build reads.

            The schema methods that build types therefore run their outermost call through this method, which holds
            the schema's type build lock for the build and records how to undo each cache write
            (@ref recordTypeBuildWrite()); if the build throws, every write it made is undone before the exception
            propagates, so the caches are as they were before it started, and a later build starts from them.
            The type builds of the schema are serialized, so a thread never reads a placeholder another thread is
            still completing; builds of different schemas run in parallel.

            If the calling thread is already building types of this schema, the code runs as part of that build.

            @param build the code that builds types

            @return the value returned by @p build

            @note @p build must not wait for another thread that builds types of this schema, which would deadlock

            @par Example:
            @code{.py}
AbstractDataProviderType type = schema.runTypeBuild(AbstractDataProviderType sub () {
    return schema.getTypeForReference("Customer");
});
            @endcode

            @since RestSchemaValidator 2.5
        */
        auto runTypeBuild(code build) {
            if (type_build_lock.lockOwner()) {
                return build();
            }
            type_build_lock.lock();
            on_exit type_build_lock.unlock();
            on_exit type_build_undo = ();
            # run first, while the lock is held; see stopOpaqueTypeCaches()
            on_exit if (release_opaque_type_caches) {
                release_opaque_type_caches = False;
                releaseOpaqueTypeCacheHolders();
            }
            try {
                return build();
            } catch (hash<ExceptionInfo> ex) {
                # undo the writes of the build, the latest first
                while (type_build_undo) {
                    code undo_write = pop type_build_undo;
                    undo_write();
                }
                rethrow;
            }
        }

        #! Returns @ref True if the calling thread is building types of this schema
        /** @see runTypeBuild()

            @since RestSchemaValidator 2.5
        */
        bool isTypeBuildActive() {
            return type_build_lock.lockOwner();
        }

        #! Returns @ref True if the given schema object may hold a type it caches in the type build in progress through an opaque reference
        /** A schema object caches the types and fields it builds, and the types of a schema can refer back to schema
            objects: a union validates each value with the schemas of its alternatives, for example.  With ordinary
            references a schema object and the types it caches are then part of one strongly connected graph with the
            parsed document, and every cache write of a type build adds an edge inside it, which makes the garbage
            collector walk that graph again (see the "Opaque references" section of the garbage collector's design
            notes).  A cache entry held through an opaque reference is not an edge the collector follows, so the
            document stays out of the type graph and the collector only walks the types being built.

            The collector cannot release a cycle running through an opaque reference, so the schema records each
            schema object that holds one and releases their caches when it is destroyed (see
            @ref RestSchemaValidator::AbstractRestSchemaObject::releaseTypeCaches() "releaseTypeCaches()").  That is
            only sufficient while nothing a schema object caches can refer to the schema itself, so schema objects
            hold their caches through opaque references only:
            - in a schema whose subclass enables it for the documents it parses (see enableOpaqueTypeCaches()), and
              not in one restored from its serialized form, whose types own their documents
            - in the type build in progress in the calling thread (see runTypeBuild())
            - until the schema is given a value that it did not build: a type given to replaceTypeForReference(), or
              a request body default that is not plain data (see stopOpaqueTypeCaches())

            @param so the schema object making a cache entry

            @return @ref True if the cache entry is to be held through an opaque reference, in which case the schema
            object is recorded for its cache to be released when the schema is destroyed

            @par Example:
            A schema object subclass caching a type it built in the type build in progress:
            @code{.py}
*AbstractRestSchemaValidator schema = getTypeBuildSchema();
if (schema && schema.isTypeBuildActive() && schema.holdTypeCacheOpaquely(self)) {
    cached_type @= t;
} else {
    cached_type = t;
}
            @endcode

            @since RestSchemaValidator 2.5
        */
        bool holdTypeCacheOpaquely(AbstractRestSchemaObject so) {
            if (!opaque_type_caches || !type_build_lock.lockOwner()) {
                return False;
            }
            string key = so.uniqueHash();
            # a weak reference to an object that has been destroyed gives no object, and an object created since can
            # have the same unique hash
            *AbstractRestSchemaObject holder = opaque_type_cache_holders{key};
            if (holder != so) {
                opaque_type_cache_holders{key} := so;
            }
            return True;
        }

        #! Makes the schema objects of this schema hold the types and fields they cache through ordinary references from now on
        /** Called when the schema is given a value that it did not build, such as a type by
            replaceTypeForReference().  The schema cannot know what such a value refers to, and a schema object
            caching it is reachable from the types that other schema objects hold through opaque references, through
            the union alternatives that refer to it.  If the value referred to the schema, the schema would then be
            part of a cycle that the garbage collector cannot see and would never be destroyed, so the opaque type
            caches are released (see @ref RestSchemaValidator::AbstractRestSchemaObject::releaseTypeCaches()
            "AbstractRestSchemaObject::releaseTypeCaches()") once the type build in progress has finished, or now if
            there is none, and the types they held are built again when they are next asked for, through ordinary
            references.

            @par Example:
            A schema subclass letting an application give the type of a schema object from its own catalog, which
            refers to the schema:
            @code{.py}
setCatalogType(AbstractRestSchemaObject so, AbstractDataProviderType t) {
    stopOpaqueTypeCaches();
    catalog_types{so.uniqueHash()} = t;
}
            @endcode

            @since RestSchemaValidator 2.5
        */
        stopOpaqueTypeCaches() {
            if (type_build_lock.lockOwner()) {
                if (opaque_type_caches) {
                    opaque_type_caches = False;
                    # the build in progress refers to the caches; they are released when it has finished
                    release_opaque_type_caches = True;
                }
                return;
            }
            # a type build of another thread finishes first
            type_build_lock.lock();
            on_exit type_build_lock.unlock();
            if (opaque_type_caches) {
                opaque_type_caches = False;
                releaseOpaqueTypeCacheHolders();
            }
        }

        #! Lets the schema objects of this schema hold the types and fields they build through opaque references
        /** Called by a subclass once it has parsed its document; see holdTypeCacheOpaquely()

            @since RestSchemaValidator 2.5
        */
        private enableOpaqueTypeCaches() {
            opaque_type_caches = True;
        }

        #! Releases the types that the schema objects of this schema cache through opaque references
        /** Called when the schema is destroyed; see holdTypeCacheOpaquely()

            @since RestSchemaValidator 2.5
        */
        private releaseTypeCaches() {
            # a thread building types of the schema finishes first; one that starts after this makes no opaque entries
            bool locked = !type_build_lock.lockOwner();
            if (locked) {
                type_build_lock.lock();
            }
            on_exit if (locked) {
                type_build_lock.unlock();
            }
            opaque_type_caches = False;
            releaseOpaqueTypeCacheHolders();
        }

        #! Releases the type caches of the schema objects holding types through opaque references
        /** Must be called with the type build lock held, outside a type build or at its end.

            @since RestSchemaValidator 2.5
        */
        private releaseOpaqueTypeCacheHolders() {
            hash<auto> holders = opaque_type_cache_holders;
            opaque_type_cache_holders = {};
            foreach string key in (keys holders) {
                # a holder that has been destroyed has released its cache already, and its weak reference gives no
                # object
                *AbstractRestSchemaObject so = holders{key};
                if (so) {
                    so.releaseTypeCaches();
                }
            }
        }

        #! Records how to undo a cache write of the type build of this schema in progress on the calling thread
        /** Has no effect if the calling thread is not building types of this schema.

            @param undo_write restores what the write replaced; must not throw

            @see runTypeBuild()

            @since RestSchemaValidator 2.5
        */
        recordTypeBuildWrite(code undo_write) {
            if (type_build_lock.lockOwner()) {
                push type_build_undo, undo_write;
            }
        }

        #! Returns the data type corresponding to the given reusable schema reference
        /** @param rstr the name of the reusable schema reference (ex: a \c "#/definitions/..." entry for Swagger 2.0
            or a \c "#/components/schemas/..." entry for OpenAPI 3.x)
            @param required if @ref True "True" then the mandatory type is returned, otherwise the "or nothing" type
            @param rest an optional REST client object used for type resolution

            @return the data type corresponding to the given reusable schema reference

            @throw INVALID-REFERENCE-TYPE the given reference is not a known type in the schema

            @since RestSchemaValidator 2.5
        */
        AbstractDataProviderType getTypeForReference(string rstr, bool required = True, *object rest) {
            *AbstractRestSchemaObject ref = getSchemaObjectForReferenceImpl(rstr);
            if (!ref) {
                throw "INVALID-REFERENCE-TYPE", sprintf("%y is not a known type", rstr);
            }
            return ref.getDataType(required, rest);
        }

        #! Replaces the cached data type for the given reusable schema reference
        /** @param rstr the name of the reusable schema reference (ex: a \c "#/definitions/..." entry for Swagger 2.0
            or a \c "#/components/schemas/..." entry for OpenAPI 3.x)
            @param t the new data type to use for the given reference

            @throw INVALID-REFERENCE-TYPE the given reference is not a known type in the schema

            @since RestSchemaValidator 2.5
        */
        replaceTypeForReference(string rstr, AbstractDataProviderType t) {
            *AbstractRestSchemaObject ref = getSchemaObjectForReferenceImpl(rstr);
            if (!ref) {
                throw "INVALID-REFERENCE-TYPE", sprintf("%y is not a known type", rstr);
            }
            ref.replaceType(t);
        }

        #! Returns the reusable schema object for the given reference name or @ref nothing if there is none
        /** Each schema type stores reusable schemas in a type-specific member (ex: \c definitions for Swagger 2.0,
            \c components.schemas for OpenAPI 3.x); this method abstracts the lookup so that
            getTypeForReference() and replaceTypeForReference() can be implemented uniformly in the base class.

            @param rstr the name of the reusable schema reference

            @return the reusable schema object for the given reference name or @ref nothing if there is none

            @since RestSchemaValidator 2.5
        */
        private abstract *AbstractRestSchemaObject getSchemaObjectForReferenceImpl(string rstr);

        #! returns a unique hash for the schema that can be used to compare schemas
        /** @return a unique hash for the schema that can be used to compare schemas

            @since RestSchemaValidator 2.0
        */
        string getHash() {
            return getHashImpl();
        }

        #! returns the target URL for the schema
        /** @return the target URL for the schema

            @throws MISSING-TARGET-URL no target URL provided for the schema
        */
        string getTargetUrl() {
            return getTargetUrlImpl();
        }

        #! processes a client-side REST request and returns a hash that can be used to make the outgoing client-side HTTP request
        /** @param method the HTTP method (case-insensitive)
            @param path the URI path with any query arguments
            @param body the unserialized message body data
            @param headers any headers to include in the request; note that the \c Content-Type header should not be sent here as it will be overridden when the message is serialized
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestRequestClientInfo hash with information about the request

            @throws SERIALIZATION-ERROR unsupported message body MIME type requested or missing serialization module
        */
        hash<RestRequestClientInfo> processRequest(string method, string path, auto body, *hash<auto> headers,
                *softlist<string> content_types) {
            return processRequestImpl(method, path, body, headers, content_types);
        }

        #! processes and parses a client request and returns the deserialized message body (if any)
        /** @param method the HTTP method (case-insensitive)
            @param path the URI path with any query arguments
            @param http_body the serialized message body
            @param headers a reference to the hash of HTTP headers received; any default header values to be assumed
            by the server for the request will be added here

            @return a @ref RestRequestServerInfo hash of request information

            @throw DESERIALIZATION-ERROR the request body could not be deserialized, results in a
            <tt>400 Bad Request</tt> response returned to the caller
            @throw SCHEMA-VALIDATION-ERROR this exception should be thrown if there is a validation error in the
            request so that a <tt>400 Bad Request</tt> response can be returned to the caller
            @throw INVALID-METHOD invalid HTTP method for the request; the \c arg argument should have a list of
            acceptable HTTP methods for this request
        */
        hash<RestRequestServerInfo> parseRequest(string method, string path, *data http_body,
                reference<hash<auto>> headers) {
            return parseRequestImpl(method, path, http_body, \headers);
        }

        #! Processes a REST response with a serialized message body
        /** Validates any response data against schema definitions if possible

            @param method the HTTP method of the original request
            @param path the URI path of the original request (without query arguments)
            @param code the HTTP response code
            @param response_body the response body data (if any)
            @param headers HTTP headers to include in the response
            @param content_types the desired MIME types for serialization in order of preference; if none are usable
            then an exception is thrown; if this argument is not present, then json is preferred over yaml

            @return an @ref HttpServer::HttpResponseInfo hash for the response

            @throw ACCEPT-ERROR the response body could not be serialized because the client does not accept a
            supported type
            @throw SERIALIZATION-ERROR the response body could not be serialized due to an error

            @note <a href="http://www.w3.org/Protocols/rfc2616/rfc2616-sec14.html>RFC 2616 section 14</a>: If an
            \c Accept header field is present, and if the server cannot send a response which is acceptable according
            to the combined \c Accept field value, then the server SHOULD send a 406 (not acceptable) response.  To
            ensure this happens, if an \c Accept error of this nature occurs in this call, an \c "ACCEPT-ERROR" must
            be thrown
        */
        hash<HttpResponseInfo> processResponse(string method, string path, int code, auto response_body,
                *hash<auto> headers, *softlist<string> content_types) {
            return processResponseImpl(method, path, code, response_body, headers, content_types);
        }

        #! parses and validates the response from the server and returns a hash of the processed info
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the original request (without any query arguments)
            @param code the HTTP response code
            @param response_body the HTTP response body data (if any)
            @param hdr as hash of HTTP headers received

            @throw DESERIALIZATION-ERROR the request body could not be deserialized or had an invalid \c Content-Type
        */
        hash<RestResponseClientInfo> parseResponse(string method, string path, int code, *data response_body,
                hash<auto> hdr) {
            # strip any query arguments from the path when validating
            path =~ s/\?.*//;
            return parseResponseImpl(method, path, code, response_body, hdr);
        }

        #! returns a hash of example Qore code for the given request
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the request

            @return a @ref RestSchemaValidator::RestQoreExampleCodeInfo "RestQoreExampleCodeInfo" hash giving example Qore code to generate the given request message
        */
        hash<RestQoreExampleCodeInfo> getQoreExampleRequest(string method, string path) {
            return getQoreExampleRequestImpl(method, path);
        }

        #! returns a hash of example message information for the given request
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the request
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestExampleRequestInfo of example message information for the given request
        */
        hash<RestExampleRequestInfo> getExampleRequest(string method, string path, *softlist<string> content_types) {
            return getExampleRequestImpl(method, path, content_types);
        }

        #! returns example Qore code for the given response
        /** @param method the HTTP method of the original request (case insensitive)
            @param path the URI path of the original request
            @param code the HTTP response code of the response

            @return a @ref RestSchemaValidator::RestQoreExampleCodeInfo "RestQoreExampleCodeInfo" hash giving example Qore code to generate the given response message
        */
        hash<RestQoreExampleCodeInfo> getQoreExampleResponse(string method, string path, int code) {
            return getQoreExampleResponseImpl(method, path, code);
        }

        #! returns a hash of example message information for the given request
        /** @param method the HTTP method of the original request (case insensitive)
            @param path the URI path of the original request
            @param code the HTTP response code of the response
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestSchemaValidator::RestExampleResponseInfo "RestExampleResponseInfo" hash giving example response message info
        */
        hash<RestExampleResponseInfo> getExampleResponse(string method, string path, int code,
                *softlist<string> content_types) {
            hash<RestExampleResponseInfo> rv = getExampleResponseImpl(method, path, code, content_types);
            if (!rv.response_uri)
                rv.response_uri = sprintf("HTTP/1.1 %d %s", code, HttpCodes{code} ?? "Unknown");
            return rv;
        }

        #! returns a hash of URI paths as keys with values as lists of supported HTTP methods
        /** @return a hash of URI paths as keys with values as lists of supported HTTP methods
        */
        hash<string, list<string>> getPathOperationHash() {
            return getPathOperationHashImpl();
        }

        #! returns the base path prefix for all requests in this schema
        /** @return the base path prefix for all requests in this schema
        */
        string getBasePath() {
            return getBasePathImpl();
        }

        #! overrides the basePath value
        /** @param basePath the new base path value; use an empty string here to clear the basePath
        */
        setBasePath(string basePath) {
            setBasePathImpl(basePath);
        }

        #! returns a data provider object for this connection, if supported by any REST schema validator object
        /** @param rest the \c RestClient object to make the connection

            @return a data provider object for this connection, if supported by any REST schema validator object

            @throw DATA-PROVIDER-ERROR this class does not support the data provider API

            @note \a rest must be a \c RestClient object; this parameter is declared with a base class to avoid a
            circular dependency between modules
        */
        DataProvider::AbstractDataProvider getDataProvider(object rest) {
            return getDataProviderImpl(rest);
        }

        #! returns @ref True if the provider manages the URI path
        /** The base class method returns @ref True by default, override in child classes to return @ref False
        */
        bool managesUriPath() {
            return True;
        }

        #! Allows the time zone locale to be set for serialization / deserialization
        /** @param tz the time zone locale to set

            @since RestSchemaValidator 2.1.3
        */
        setTimeZoneLocale(*TimeZone tz) {
            # must be performed in the implementing module's Program container
            setTimeZoneLocaleImpl(tz);
        }

        #! Returns the time zone locale used for serialization / deserialization
        /** @return the time zone locale to set

            @since RestSchemaValidator 2.1.3
        */
        *TimeZone getTimeZoneLocale() {
            # must be performed in the implementing module's Program container
            return getTimeZoneLocaleImpl();
        }

        #! Returns @ref True if date/time values in query arguments should be serialized in UTC
        /** The base class returns NOTHING by default; schema implementations can override this method to expose
            schema-specific serialization options.

            @return @ref True if date/time values in query arguments should be serialized in UTC

            @since RestSchemaValidator 2.5
        */
        *bool getUtcDates() {
            return NOTHING;
        }

        #! Returns the format string for serializing date/time values in query arguments
        /** The base class returns NOTHING by default; schema implementations can override this method to expose
            schema-specific serialization options.

            @return the format string for serializing date/time values in query arguments

            @since RestSchemaValidator 2.5
        */
        *string getQueryDateFormat() {
            return NOTHING;
        }

        #! returns a data provider object for this connection, if supported by any REST schema validator object
        /** @param rest the \c RestClient object to make the connection

            @return a data provider object for this connection, if supported by any REST schema validator object

            @throw DATA-PROVIDER-ERROR this class does not support the data provider API

            @note \a rest must be a \c RestClient object; this parameter is declared with a base class to avoid a
            circular dependency between modules
        */
        private DataProvider::AbstractDataProvider getDataProviderImpl(object rest) {
            throw "DATA-PROVIDER-ERROR", sprintf("the %s class does not support the data provider API",
                self.className());
        }

        #! returns a unique hash for the schema that can be used to compare schemas
        /** @return a unique hash for the schema that can be used to compare schemas

            @since RestSchemaValidator 2.0
        */
        private abstract string getHashImpl();

        #! returns the target URL for the schema
        /** @return the target URL for the schema

            @throws MISSING-TARGET-URL no target URL provided for the schema
        */
        private abstract string getTargetUrlImpl();

        #! processes a client-side REST request and returns a hash that can be used to make the outgoing client-side HTTP request
        /** @param method the HTTP method (case-insensitive)
            @param path the URI path with any query arguments
            @param body the unserialized message body data
            @param headers any headers to include in the request; note that the \c Content-Type header should not be sent here as it will be overridden when the message is serialized
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestRequestClientInfo hash with information about the request

            @throws SERIALIZATION-ERROR unsupported message body MIME type requested or missing serialization module
        */
        private abstract hash<RestRequestClientInfo> processRequestImpl(string method, string path, auto body,
                *hash<auto> headers, *softlist<string> content_types);

        #! processes and parses a client request and returns the deserialized message body (if any)
        /** @param method the HTTP method (case-insensitive)
            @param path the URI path with any query arguments
            @param http_body the serialized message body
            @param headers a reference to the hash of HTTP headers received; any default header values to be assumed by the server for the request will be added here

            @return a @ref RestRequestServerInfo hash of request information

            @throw DESERIALIZATION-ERROR the request body could not be deserialized, results in a <tt>400 Bad Request</tt> response returned to the caller
            @throw SCHEMA-VALIDATION-ERROR this exception should be thrown if there is a validation error in the request so that a <tt>400 Bad Request</tt> response can be returned to the caller
            @throw INVALID-METHOD invalid HTTP method for the request; the \c arg argument should have a list of acceptable HTTP methods for this request
        */
        private abstract hash<RestRequestServerInfo> parseRequestImpl(string method, string path, *data http_body,
                reference<hash> headers);

        #! processes a REST response with a serialized message body, validates any response data against schema definitions if possible
        /** @param method the HTTP method of the original request
            @param path the URI path of the original request (without query arguments)
            @param code the HTTP response code
            @param response_body the response body data (if any)
            @param headers HTTP headers to include in the response
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown; if this argument is not present, then json is preferred over yaml

            @return an HttpResponseInfo hash for the response

            @throw ACCEPT-ERROR the response body could not be serialized because the client does not accept a supported type
            @throw SERIALIZATION-ERROR the response body could not be serialized due to an error

            @note <a href="http://www.w3.org/Protocols/rfc2616/rfc2616-sec14.html>RFC 2616 section 14</a>: If an Accept header field is present, and if the server cannot send a response which is acceptable according to the combined Accept field value, then the server SHOULD send a 406 (not acceptable) response.  To ensure this happens, if
            an Accept error of this nature occurs in this call, an \c "ACCEPT-ERROR" must be thrown
        */
        private abstract hash<HttpResponseInfo> processResponseImpl(string method, string path, int code,
                auto response_body, *hash<auto> headers, *softlist<string> content_types);

        #! parses and validates the response from the server and returns a hash of the processed info
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the original request (without any query arguments)
            @param code the HTTP response code
            @param response_body the HTTP response body data (if any)
            @param hdr as hash of HTTP headers received

            @throw DESERIALIZATION-ERROR the request body could not be deserialized or had an invalid \c Content-Type
        */
        private abstract hash<RestResponseClientInfo> parseResponseImpl(string method, string path, int code,
                *data response_body, hash<auto> hdr);

        #! returns a hash of URI paths as keys with values as lists of supported HTTP methods
        /** @return a hash of URI paths as keys with values as lists of supported HTTP methods
        */
        private abstract hash<string, list<string>> getPathOperationHashImpl();

        #! returns the base path prefix for all requests in this schema
        /** @return the base path prefix for all requests in this schema
        */
        private abstract string getBasePathImpl();

        #! overrides the basePath value
        /** @param basePath the new base path value; use an empty string here to clear the basePath
        */
        private abstract setBasePathImpl(string basePath);

        #! returns a hash of example Qore code for the given request
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the request

            @return a @ref RestSchemaValidator::RestQoreExampleCodeInfo "RestQoreExampleCodeInfo" hash giving example Qore code to generate the given request message
        */
        private abstract hash<RestQoreExampleCodeInfo> getQoreExampleRequestImpl(string method, string path);

        #! returns a hash of example message information for the given request
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the request
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestExampleRequestInfo of example message information for the given request
        */
        private abstract hash<RestExampleRequestInfo> getExampleRequestImpl(string method, string path,
                *softlist<string> content_types);

        #! returns example Qore code for the given response
        /** @param method the HTTP method of the original request (case insensitive)
            @param path the URI path of the original request
            @param code the HTTP response code of the response

            @return a @ref RestSchemaValidator::RestQoreExampleCodeInfo "RestQoreExampleCodeInfo" hash giving example Qore code to generate the given response message
        */
        private abstract hash<RestQoreExampleCodeInfo> getQoreExampleResponseImpl(string method, string path,
                int code);

        #! returns a hash of example message information for the given request
        /** @param method the HTTP method of the original request (case insensitive)
            @param path the URI path of the original request
            @param code the HTTP response code of the response
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestSchemaValidator::RestExampleResponseInfo "RestExampleResponseInfo" hash giving example response message info
        */
        private abstract hash<RestExampleResponseInfo> getExampleResponseImpl(string method, string path, int code,
                *softlist<string> content_types);

        #! Allows the time zone locale to be set for serialization / deserialization
        /** @param tz the time zone locale to set

            @since RestSchemaValidator 2.1.3
        */
        private abstract setTimeZoneLocaleImpl(*TimeZone tz);

        #! Returns the time zone locale used for serialization / deserialization
        /** @return the time zone locale to set

            @since RestSchemaValidator 2.1.3
        */
        private abstract *TimeZone getTimeZoneLocaleImpl();

        #! Returns a field definition from a schema object
        /** @param name the name of the field
            @param desc optional description for the field
            @param schema the schema object
            @param required if the field is required
            @param rest optional REST client for URL resolution

            @return the data field definition

            @since RestSchemaValidator 2.4
        */
        abstract AbstractDataField getFieldFromSchema(string name, *string desc, AbstractSchemaObject schema,
            bool required = True, *object rest);

        #! Returns a field for header fields
        /** @param name the name of the field
            @param headers a hash of header definitions

            @return a data field for the headers

            @since RestSchemaValidator 2.4
        */
        abstract AbstractDataField getFieldForHeaders(string name, hash<auto> headers);
    }

    #! null REST validator; no schema is used but default serialization and deserialization is performed
    public class NullRestSchemaValidator inherits AbstractRestSchemaValidator {
        public {
            #! Data serialization support mapping codes to MIME types and de/serialization functions
            const SupportsCbor =
                exists_function("make_cbor") && exists_function("parse_cbor")
            ;

            const DataSerializationSupport =
                # JSON-compatible MIME types from centralized list - use foldl to merge into single hash
                (foldl $1 + $2, (map {$1: \make_json()}, keys MimeTypesJson)) +
                (SupportsCbor ? {MimeTypeCbor: get_call_reference("make_cbor")} : {}) +
            {
                MimeTypeYamlRpc: \make_yaml(),
                MimeTypeYaml: \make_yaml(),
                "text/x-yaml": \make_yaml(),
%ifndef NoXml
                MimeTypeXml: \make_xmlrpc_value(),
                MimeTypeXmlApp: string sub (auto v) {
                    switch (v.typeCode()) {
                        case NT_LIST: return make_xml(("list": ("element": v)));
                        case NT_HASH: return v.size() == 1 && v.firstValue().lsize() == 1 ? make_xml(v) : make_xml(("value": v));
                    }
                    return make_xml(("value": v));
                },
%endif
                MimeTypeFormUrlEncoded: string sub (auto v) {
                    if (v.typeCode() == NT_HASH)
                        return mime_get_form_urlencoded_string(v);
                    throw "FORMURLENCODING-ERROR", sprintf("form URL encoding can only encode hashes; type %y requested", v.type());
                },
                MimeTypeText: data sub (auto s) {
                    switch (s.typeCode()) {
                        case NT_STRING:
                        case NT_BINARY:
                            return s;
                        default:
                            # issue #3547: send as a YAML-serialized string if possible to catch unserializable data
                            return make_yaml(s);
                    }
                },
                MimeTypeOctetStream: binary sub (auto s) {
                    switch (s.typeCode()) {
                        case NT_STRING:
                            return binary(s);
                        case NT_BINARY:
                            return s;
                        default:
                            # issue #3547: send as a YAML-serialized string if possible to catch unserializable data
                            return binary(make_yaml(s));
                    }
                },
            };

            const DataSerializationSupportList = keys DataSerializationSupport;

            const DeserializeYaml = (
                "code": "yaml",
                "in": \parse_yaml(),
            );
%ifndef NoXml
            const DeserializeXml = (
                "code": "xml",
                "arg": True,
                "in": auto sub (string xml, reference<string> type) {
                    try {
                        on_success type = "xml";
                        return parse_xmlrpc_value(xml);
                    } catch (hash<ExceptionInfo> ex) {
                        try {
                            on_success type = "rawxml";
                            return parse_xml(xml);
                        } catch () {
                        }
                        rethrow;
                    }
                },
            );
%endif

            #! Data deserialization support MIME types to codes and de/serialization functions
            const DataDeserializationSupport = {
                MimeTypeFormUrlEncoded: (
                    "code": "url",
                    "in": \mime_parse_form_urlencoded_string(),
                ),
            } +
                # JSON-compatible MIME types from centralized list - use foldl to merge into single hash
                (foldl $1 + $2, (map {$1: {"code": "json", "in": \parse_json()}}, keys MimeTypesJson)) +
                (SupportsCbor ? {MimeTypeCbor: {"code": "cbor", "in": get_call_reference("parse_cbor")}} : {}) +
            {
                MimeTypeYamlRpc: DeserializeYaml,
                MimeTypeYaml: DeserializeYaml,
                "text/x-yaml": DeserializeYaml,
%ifndef NoXml
                MimeTypeXml: DeserializeXml,
                MimeTypeXmlApp: DeserializeXml,
%endif
                MimeTypeText: (
                    "code": "text",
                    "in": data sub (data s) { return s; },
                ),

                MimeTypeOctetStream: {
                    "code": "bin",
                    "in": binary sub (data s) {
                        return s.typeCode() == NT_BINARY ? s : binary(s);
                    },
                },
            };

            #! a unique hash for the null schema
            /** @since RestSchemaValidator 2.0
            */
            const NullSchemaHashStr = "<null rest schema>";
        }

        #! Creates the object without a logger
        constructor() {
        }

        #! Creates the object with the given logger
        constructor(Logger::LoggerInterface logger) : AbstractRestSchemaValidator(logger) {
        }

        #! returns @ref True if the provider manages the URI path
        /** This method returns @ref False
        */
        bool managesUriPath() {
            return False;
        }

        #! returns a unique hash for the schema that can be used to compare schemas
        /** @return a unique hash for the schema that can be used to compare schemas

            @since RestSchemaValidator 2.0
        */
        private string getHashImpl() {
            return NullSchemaHashStr;
        }

        #! the null validator has no reusable schema references
        private *AbstractRestSchemaObject getSchemaObjectForReferenceImpl(string rstr) {
        }

        #! returns the target URL for the schema
        /** @return the target URL for the schema

            @throws MISSING-TARGET-URL no target URL provided for the schema
        */
        private string getTargetUrlImpl() {
            throw "MISSING-TARGET-URL", "no target URL provided";
        }

        #! processes a client-side REST request and returns a hash that can be used to make the outgoing client-side HTTP request
        /** @param method the HTTP method (case-insensitive)
            @param path the URI path with any query arguments
            @param body the unserialized message body data
            @param headers any headers to include in the request; note that the \c Content-Type header should not be sent here as it will be overridden when the message is serialized
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestRequestClientInfo hash with information about the request

            @throws SERIALIZATION-ERROR unsupported message body MIME type requested or missing serialization module
        */
        private hash<RestRequestClientInfo> processRequestImpl(string method, string path, auto body, *hash<auto> headers, *softlist<string> content_types) {
            string ct = content_types[0] ?? DataSerializationSupportList[0];
            return cast<hash<RestRequestClientInfo>>((
                "uri_path": path,
                "content": ct,
                "body": exists body ? DataSerializationSupport{ct}(body) : NOTHING,
            ));
        }

        #! processes and parses a client request and returns the deserialized message body (if any)
        /** @param method the HTTP method (case-insensitive)
            @param path the URI path with any query arguments
            @param http_body the serialized message body
            @param headers a reference to the hash of HTTP headers received; any default header values to be assumed by the server for the request will be added here

            @return a @ref RestRequestServerInfo hash of request information

            @throw DESERIALIZATION-ERROR the request body could not be deserialized, results in a <tt>400 Bad Request</tt> response returned to the caller
            @throw SCHEMA-VALIDATION-ERROR this exception should be thrown if there is a validation error in the request so that a <tt>400 Bad Request</tt> response can be returned to the caller
            @throw INVALID-METHOD invalid HTTP method for the request; the \c arg argument should have a list of acceptable HTTP methods for this request
        */
        private hash<RestRequestServerInfo> parseRequestImpl(string method, string path, *data http_body,
                reference<hash> headers) {
            hash<UriQueryInfo> h = parse_uri_query(path);

            hash<RestRequestServerInfo> rv({
                "path": h.method,
                "query": h.params,
            });

            *string ct = mime_get_base_type(headers."content-type");

            if (exists http_body) {
                *hash<auto> dh = DataDeserializationSupport{ct};
                if (!dh) {
                    throw "DESERIALIZATION-ERROR", sprintf("cannot deserialize request body; content-type is: %y; "
                        "types supported: %y; response body: %y", ct, keys DataDeserializationSupport, http_body);
                }

                # Convert body to binary for non-text content types (e.g. CBOR)
                if (!is_mime_text(ct) && http_body.typeCode() == NT_STRING) {
                    http_body = binary(http_body);
                }

                string ds_code = dh.code;
                try {
                    rv.body = dh.arg
                        ? dh.in(http_body, \ds_code)
                        : dh.in(http_body);
                } catch (hash<ExceptionInfo> ex) {
                    rethrow "DESERIALIZATION-ERROR", sprintf("%s: %s", ex.err, ex.desc);
                }

                rv.info.code = ds_code;
            }

            return rv;
        }

        #! processes a REST response with a serialized message body, validates any response data against schema definitions if possible
        /** @param method the HTTP method of the original request
            @param path the URI path of the original request (without query arguments)
            @param code the HTTP response code
            @param response_body the response body data (if any)
            @param headers HTTP headers to include in the response; note that if this value contains a \c Content-Type
            key, this type will be used for the response serialization if it is supported and if the client can accept
            it, otherwise an \c ACCEPT-ERROR exception is raised resulting in a <tt>406 Not Acceptable</tt> error
            being returned to the client
            @param content_types the desired MIME types for serialization in order of preference; if none are usable
            then an exception is thrown; if this argument is not present, then json is preferred over yaml

            @return an HttpResponseInfo hash for the response

            @throw ACCEPT-ERROR the response body could not be serialized because the client does not accept a
            supported type; results in a <tt>406 Not Acceptable</tt> error being returned to the client
            @throw SERIALIZATION-ERROR the response body could not be serialized due to an error

            @note <a href="http://www.w3.org/Protocols/rfc2616/rfc2616-sec14.html>RFC 2616 section 14</a>: If an
            \c Accept header field is present, and if the server cannot send a response which is acceptable according
            to the combined Accept field value, then the server SHOULD send a 406 (not acceptable) response.  To
            ensure this happens, if an \c Accept error of this nature occurs in this call, an \c "ACCEPT-ERROR" must
            be thrown
        */
        private hash<HttpResponseInfo> processResponseImpl(string method, string path, int code, auto response_body,
                *hash<auto> headers, *softlist<string> content_types) {
            hash<HttpResponseInfo> rv((
                "code": code,
                "hdr": headers,
            ));

            if (exists response_body) {
                if (checkResponseContentTypeHeader(\rv, response_body, headers, content_types)) {
                    return rv;
                }

                list<string> ctl;
                if (*string ct = headers."Content-Type" ?? headers."content-type") {
                    # strip parameters (e.g. ";charset=utf-8") for MIME type lookup — the
                    # keys in DataSerializationSupport are bare MIME types
                    string base_ct = mime_get_base_type(ct);
                    ctl = (base_ct,);
                    if (!DataSerializationSupport{base_ct}) {
                        log(LoggerLevel::ERROR, "error serializing response with unsupported "
                            "Content-Type %y required by the REST handler response: failed with response body: %Y",
                            ct, response_body);
                        throw "ACCEPT-ERROR", sprintf("cannot serialize response; you claim to accept only: %y; "
                            "types supported: %y (required by REST response handler); discarding response: %y",
                            content_types, keys DataSerializationSupport, response_body),
                            {"types": ctl};
                    }
                } else {
                    ctl = !content_types
                        ? keys DataSerializationSupport
                        : map $1, content_types, DataSerializationSupport{$1};
                }

                if (!ctl) {
                    throw "ACCEPT-ERROR", sprintf("cannot serialize response; you claim to accept only: %y; types "
                        "supported: %y; discarding response: %y", content_types, keys DataSerializationSupport,
                        response_body), {"types": keys DataSerializationSupport};
                }
                bool ok;
                hash<ExceptionInfo> ex;
                # last serializer used
                code last_serializer;
                foreach string ct in (ctl) {
                    try {
                        code serializer = DataSerializationSupport{ct};
                        if (serializer == last_serializer) {
                            continue;
                        }
                        last_serializer = serializer;
                        response_body = serializer(response_body);
                        headers."Content-Type" = ct;
                        ok = True;
                        break;
                    } catch (hash<ExceptionInfo> ex1) {
                        log(LoggerLevel::ERROR, "error serializing response with Content-Type %y (%d/%d): "
                            "%s; failed with response body: %Y", ct, $#, ctl.size(), get_exception_string(ex1),
                            response_body);
                        # ignore serialization exceptions
                        ex = ex1;
                    }
                }
                # rethrow last exception if the response cannot be serialized
                if (!ok) {
                    throw "ACCEPT-ERROR", sprintf("error serializing response; tried: %y; last error: %s: %s", ctl,
                        ex.err, ex.desc), ex.arg;
                }
            }

            rv.body = response_body;
            rv.hdr = headers;
            return rv;
        }

        #! parses and validates the response from the server and returns a hash of the processed info
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the original request (without any query arguments)
            @param code the HTTP response code
            @param response_body the HTTP response body data (if any)
            @param hdr as hash of HTTP headers received

            @throw DESERIALIZATION-ERROR the request body could not be deserialized or had an invalid \c Content-Type
        */
        private hash<RestResponseClientInfo> parseResponseImpl(string method, string path, int code,
                *data response_body, hash<auto> hdr) {
            hash<RestResponseClientInfo> rv({
                "code": code,
                "hdr": hdr,
            });

            if (response_body.val()) {
                string raw_ct = (hdr."content-type".typeCode() == NT_LIST
                    ? hdr."content-type"[0]
                    : hdr."content-type") ?? "";
                if (!raw_ct.val()) {
                    throw "DESERIALIZATION-ERROR", sprintf("cannot deserialize response body without a content-type; "
                        "response body: %y; headers: %y", response_body, hdr);
                }
                *string ct = mime_get_base_type(raw_ct);
                *hash<auto> dh = ct ? DataDeserializationSupport{ct} : NOTHING;
                # Media responses have no structured deserializer: preserve their bytes as for
                # application/octet-stream. This includes generated audio returned by inference APIs.
                if (!dh && (ct =~ /^(audio|image|video)\// || inlist(ct,
                        ("application/pdf", "model/gltf-binary"))) && !is_mime_text(ct)) {
                    dh = DataDeserializationSupport{MimeTypeOctetStream};
                }
                if (!dh) {
                    throw "DESERIALIZATION-ERROR", sprintf("cannot deserialize response body; content-type is: %y; "
                        "types supported: %y; response body: %y", hdr."content-type",
                        keys DataDeserializationSupport, response_body);
                }

                # Convert the body to binary for non-text content types (e.g. CBOR, octet-stream); binary formats
                # need the raw bytes.
                #
                # The transport determines the type the body arrives as: the synchronous HTTPClient::send() path
                # returns every body as a string, so binary formats have to be converted here, while the
                # asynchronous HttpClientIo path used by RestClientIo delivers binary bodies unchanged.  Both are
                # valid; every deserializer registered for a non-text type in DataDeserializationSupport accepts
                # binary as well as string input.  Rejecting binary here made any binary response impossible over
                # RestClientIo (issue #5386).
                if (!is_mime_text(ct)) {
                    if (response_body.typeCode() == NT_STRING) {
                        response_body = binary(response_body);
                    } else if (response_body.typeCode() != NT_BINARY) {
                        throw "DESERIALIZATION-ERROR", sprintf("cannot deserialize response body; content-type is: "
                            "%y but body type is %y", ct, response_body.type());
                    }
                } else if (response_body.typeCode() != NT_STRING) {
                    throw "DESERIALIZATION-ERROR", sprintf("cannot deserialize response body; content-type is: %y but "
                        "body type is %y", ct, response_body.type());
                }

                # the parsers need UTF-8; HTTP bodies are decoded with their actual encoding (see
                # decode_http_body()), which is UTF-8 for JSON and UTF-8 or a byte-order-mark encoding for YAML, so
                # text in another encoding is converted
                if ((ct == MimeTypeJson || ct == MimeTypeYaml)
                    && response_body.typeCode() == NT_STRING
                    && response_body.encoding() != "UTF-8") {
                    response_body = convert_encoding(response_body, "UTF-8");
                }

                string ds_code = dh."code";
                try {
                    rv.body = dh.arg
                        ? dh.in(response_body, \ds_code)
                        : dh.in(response_body);
                } catch (hash<ExceptionInfo> ex) {
                    rethrow "DESERIALIZATION-ERROR", sprintf("%s: %s (response body encoding: %s Content-Type: %y)",
                        ex.err, ex.desc, response_body.encoding(), ct);
                }

                rv.info."code" = ds_code;
            }

            return rv;
        }

        #! Check if the headers contain a content-type header which is accepted and if so, modify the response hash.
        /** @param resp response hash
            @param body response body data (if any)
            @param headers HTTP headers to include in the response
            @param content_types the accepted MIME types in order of preference

            @return whether the headers contained a \c Content-Type header and the rv was modified

            @note if there are more \c Content-Type headers, then @ref False is returned and response is not modified
        */
        private:internal bool checkResponseContentTypeHeader(reference<hash<HttpResponseInfo>> resp, auto body,
                *hash<auto> headers, *softlist<string> content_types) {
            # quickly return if body is not in data format
            if (body.typeCode() != NT_BINARY && body.typeCode() != NT_STRING)
                return False;

            # Find the \c Content-Type header by exact case-insensitive match — prior
            # substring match of \c /content-type/i also matched unrelated headers such
            # as \c X-Content-Type-Options and \c DataStream-Content-Type, which caused
            # this function to fall through to serialization and re-wrap already-
            # serialized bodies.
            *list<string> ct = map $1, keys headers, $1 =~ /^content-type$/i;

            # if found and it is accepted, use it and don't serialize the body
            if (ct && ct.size() == 1) {
                if (!content_types) { # no content types means */* is accepted
                    resp.body = body;
                    resp.hdr = resp.hdr + ("Content-Type": remove resp.hdr{ct[0]});
                    return True;
                }
                # Compare against the bare MIME type (parameters like ";charset=utf-8"
                # stripped) so a response with Content-Type "text/x-yaml;charset=utf-8"
                # matches an accept entry of "text/x-yaml".
                string contentType = headers{ct[0]};
                string base_ct = mime_get_base_type(contentType) ?? "";
                foreach string accepted in (content_types) {
                    accepted =~ s/\*/.*/;
                    if (base_ct.regex(accepted) || contentType.regex(accepted)) {
                        resp.body = body;
                        resp.hdr = resp.hdr + ("Content-Type": remove resp.hdr{ct[0]});
                        return True;
                    }
                }
            }
            return False;
        }

        #! returns a hash of URI paths as keys with values as lists of supported HTTP methods
        /** @return a hash of URI paths as keys with values as lists of supported HTTP methods
        */
        private hash<string, list<string>> getPathOperationHashImpl() {
            return new hash<string, list<string>>();
        }

        #! returns the base path prefix for all requests in this schema
        /** @return the base path prefix for all requests in this schema
        */
        private string getBasePathImpl() {
            return "";
        }

        #! overrides the basePath value
        /** @param basePath the new base path value; use an empty string here to clear the basePath
        */
        private setBasePathImpl(string basePath) {
            throw "UNSUPPORTED-OPERATION", sprintf("the basePath cannot be overridden in the NullRestSchemaValidator class");
        }

        #! returns a hash of example Qore code for the given request
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the request

            @return a @ref RestSchemaValidator::RestQoreExampleCodeInfo "RestQoreExampleCodeInfo" hash giving example Qore code to generate the given request message
        */
        private hash<RestQoreExampleCodeInfo> getQoreExampleRequestImpl(string method, string path) {
            return new hash<RestQoreExampleCodeInfo>();
        }

        #! returns a hash of example message information for the given request
        /** @param method the HTTP method (case insensitive)
            @param path the URI path of the request
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestExampleRequestInfo of example message information for the given request
        */
        private hash<RestExampleRequestInfo> getExampleRequestImpl(string method, string path,
                *softlist<string> content_types) {
            return new hash<RestExampleRequestInfo>();
        }

        #! returns example Qore code for the given response
        /** @param method the HTTP method of the original request (case insensitive)
            @param path the URI path of the original request
            @param code the HTTP response code of the response

            @return a @ref RestSchemaValidator::RestQoreExampleCodeInfo "RestQoreExampleCodeInfo" hash giving example Qore code to generate the given response message
        */
        private hash<RestQoreExampleCodeInfo> getQoreExampleResponseImpl(string method, string path, int code) {
            return new hash<RestQoreExampleCodeInfo>();
        }

        #! returns a hash of example message information for the given request
        /** @param method the HTTP method of the original request (case insensitive)
            @param path the URI path of the original request
            @param code the HTTP response code of the response
            @param content_types the desired MIME types for serialization in order of preference; if none are usable then an exception is thrown

            @return a @ref RestSchemaValidator::RestExampleResponseInfo "RestExampleResponseInfo" hash giving example response message info
        */
        private hash<RestExampleResponseInfo> getExampleResponseImpl(string method, string path, int code,
                *softlist<string> content_types) {
            return new hash<RestExampleResponseInfo>();
        }

        #! Allows the time zone locale to be set for serialization / deserialization
        /** @param tz the time zone locale to set

            @since RestSchemaValidator 2.1.3
        */
        private setTimeZoneLocaleImpl(*TimeZone tz) {
            set_thread_tz(tz);
        }

        #! Returns the time zone locale used for serialization / deserialization
        /** @return the time zone locale to set

            @since RestSchemaValidator 2.1.3
        */
        private *TimeZone getTimeZoneLocaleImpl() {
            return get_thread_tz();
        }

        #! Returns a field definition from a schema object
        /** @param name the name of the field
            @param desc optional description for the field
            @param schema the schema object
            @param required if the field is required
            @param rest optional REST client for URL resolution

            @return the data field definition

            @since RestSchemaValidator 2.4

            @throws UNSUPPORTED-OPERATION the NullRestSchemaValidator does not support schema operations
        */
        AbstractDataField getFieldFromSchema(string name, *string desc, AbstractSchemaObject schema,
                bool required = True, *object rest) {
            throw "UNSUPPORTED-OPERATION", "the NullRestSchemaValidator class does not support schema operations";
        }

        #! Returns a field for header fields
        /** @param name the name of the field
            @param headers a hash of header definitions

            @return a data field for the headers

            @since RestSchemaValidator 2.4

            @throws UNSUPPORTED-OPERATION the NullRestSchemaValidator does not support schema operations
        */
        AbstractDataField getFieldForHeaders(string name, hash<auto> headers) {
            throw "UNSUPPORTED-OPERATION", "the NullRestSchemaValidator class does not support schema operations";
        }
    }

    #! Generic REST schema loader that auto-detects Swagger 2.0 vs OpenAPI 3.x schemas
    /** This class provides a unified interface for loading REST API schemas without needing
        to know the schema format in advance. It automatically detects the schema type and
        loads the appropriate module (Swagger or OpenApi3) dynamically.

        @since RestSchemaValidator 2.4
    */
    public class RestSchemaLoader {
        #! Load a REST schema definition from a string, auto-detecting the format
        /**
            @param schemaSource the REST API schema specification (JSON or YAML)
            @param json whether the specification is in JSON or YAML format; if not given the source encoding will be
            detected automatically
            @param opts options passed to the schema constructor

            @return the loaded schema object

            @throws JSON-MODULE-MISSING trying to parse a JSON schema with JSON module unavailable
            @throws UNKNOWN-SCHEMA-TYPE unable to detect schema type from parsed content
        */
        static AbstractRestSchemaValidator fromString(string schemaSource, *bool json, *hash<auto> opts) {
            string ser;
            if (!exists json) {
                ser = RestSchemaLoader::detectSourceEncoding(schemaSource);
            } else {
                ser = json ? "json" : "yaml";
            }
            hash<auto> parsed = RestSchemaLoader::parseSchemaSource(schemaSource, ser);
            string schemaType = RestSchemaLoader::detectSchemaType(parsed);
            return RestSchemaLoader::loadSchema(schemaType, schemaSource, json, opts);
        }

        #! Load a REST schema definition from a file, auto-detecting the format
        /**
            @param filepath path to the REST schema file
            @param opts options passed to the schema constructor

            @return the loaded schema object

            @throws EMPTY-SCHEMA-FILE schema file is empty
            @throws JSON-MODULE-MISSING trying to parse a JSON schema with the json module unavailable
            @throws XML-MODULE-MISSING trying to parse an XML schema with the xml module unavailable
            @throws UNKNOWN-SCHEMA-TYPE unable to detect schema type from parsed content
        */
        static AbstractRestSchemaValidator fromFile(string filepath, *hash<auto> opts) {
            string file_data = ReadOnlyFile::readTextFile(filepath);
            if (!file_data) {
                throw "EMPTY-SCHEMA-FILE", sprintf("%y: file is empty", filepath);
            }
            hash<auto> parsed = RestSchemaLoader::parseSchemaContent(filepath, file_data);
            string schemaType = RestSchemaLoader::detectSchemaType(parsed);
            return RestSchemaLoader::loadSchemaFromFile(schemaType, filepath, opts);
        }

        #! Load a REST schema definition from a URL or file path, auto-detecting the format
        /**
            @param url URL to the REST schema file; uses the FileLocationHandler to load the file
            @param json whether the specification is in JSON or YAML format; if not given the source encoding will be
            detected automatically
            @param opts options passed to the schema constructor

            @return the loaded schema object

            @throws EMPTY-SCHEMA-FILE schema file is empty
            @throws JSON-MODULE-MISSING trying to parse a JSON schema with the json module unavailable
            @throws XML-MODULE-MISSING trying to parse an XML schema with the xml module unavailable
            @throws UNKNOWN-SCHEMA-TYPE unable to detect schema type from parsed content
        */
        static AbstractRestSchemaValidator fromUrl(string url, *bool json, *hash<auto> opts) {
            if (!exists json) {
                if (url =~ /\.yaml$/i) {
                    json = False;
                } else if (url =~ /\.json$/i) {
                    json = True;
                }
            }
            on_error {
                rethrow $1.err, sprintf("%s (from URL %y)", $1.desc, get_safe_url(url));
            }
            return RestSchemaLoader::fromString(FileLocationHandler::getTextFileFromLocation(url), json, opts);
        }

        #! Detects whether the source is JSON, YAML, or XML
        /** @param str the schema source string

            @return either "json", "yaml", or "xml"
        */
        static string detectSourceEncoding(string str) {
            # strip leading whitespace
            str =~ s/^[\s\n]+//;
            # check for XML declaration or root element
            if (str =~ /^<(\?xml|[a-zA-Z])/) {
                return "xml";
            }
            # check for JSON: a JSON object always has a double-quoted key (or is empty) immediately
            # after the opening brace.  YAML flow style (e.g. "{openapi: ...}") uses unquoted keys and
            # is not valid JSON, so it must be parsed as YAML.
            if (str =~ /^\{\s*["}]/) {
                return "json";
            }
            # default to YAML (covers block style and flow style with unquoted keys)
            return "yaml";
        }

        #! Parses schema source from a string
        /** @param str the schema source string
            @param ser the serialization type ("json", "yaml", or "xml")

            @return the parsed schema as a hash

            @throws JSON-MODULE-MISSING trying to parse a JSON schema with json module unavailable
            @throws XML-MODULE-MISSING trying to parse an XML schema with xml module unavailable
        */
        static hash<auto> parseSchemaSource(string str, string ser) {
            auto rv;
            switch (ser) {
                case "json": {
                    rv = parse_json(str);
                    break;
                }
                case "yaml": {
                    rv = parse_yaml(str);
                    break;
                }
                case "xml": {
%ifdef NoXml
                    throw "XML-MODULE-MISSING", "Trying to parse an XML schema, but the xml module is unavailable";
%else
                    rv = parse_xml(str);
                    break;
%endif
                }
            }
            if (rv.typeCode() != NT_HASH) {
                throw "INVALID-SCHEMA", sprintf("REST schema must be a hash; parsed %s document has top-level type %y",
                    ser.upr(), rv.type());
            }
            return rv;
        }

        #! Parses schema content from a file
        /** @param filepath path to the schema file
            @param str the file content to parse

            @return the parsed schema as a hash

            @throws EMPTY-SCHEMA-FILE schema file is empty
            @throws JSON-MODULE-MISSING trying to parse a JSON schema with the json module unavailable
            @throws XML-MODULE-MISSING trying to parse an XML schema with the xml module unavailable
        */
        static hash<auto> parseSchemaContent(string filepath, string str) {
            if (!str) {
                throw "EMPTY-SCHEMA-FILE", sprintf("%y: file is empty", filepath);
            }

            string ser;
            string filename = basename(filepath);
            if (filename =~ /.*\.json$/i) {
                ser = "json";
            } else if (filename =~ /.*\.yaml$/i) {
                ser = "yaml";
            } else if (filename =~ /.*\.xml$/i) {
                ser = "xml";
            } else {
                ser = RestSchemaLoader::detectSourceEncoding(str);
            }

            if (ser == "xml") {
%ifdef NoXml
                throw "XML-MODULE-MISSING", "Trying to parse an XML schema, but the xml module is unavailable";
%else
                auto rv = parse_xml(str);
                if (rv.typeCode() != NT_HASH) {
                    throw "INVALID-SCHEMA", sprintf("REST schema must be a hash; parsed XML document has top-level "
                        "type %y", rv.type());
                }
                return rv;
%endif
            }
            return RestSchemaLoader::parseSchemaSource(str, ser);
        }

        #! Detects the schema type from parsed content
        /** @param parsed the parsed schema hash

            @return either "swagger" or "openapi3"

            @throws UNKNOWN-SCHEMA-TYPE unable to detect schema type from parsed content
        */
        static string detectSchemaType(hash<auto> parsed) {
            # Check for Swagger 2.0: has "swagger" key with value "2.0"
            if (parsed.swagger.typeCode() == NT_STRING && parsed.swagger == "2.0") {
                return "swagger";
            }
            # Check for OpenAPI 3.x: has "openapi" key starting with "3."
            if (parsed.openapi.typeCode() == NT_STRING && parsed.openapi =~ /^3\./) {
                return "openapi3";
            }
            # Provide more specific error messages for malformed version values
            if (parsed.hasKey("swagger")) {
                throw "UNKNOWN-SCHEMA-TYPE", sprintf("unsupported Swagger version %y; only version \"2.0\" is "
                    "supported", parsed.swagger);
            }
            if (parsed.hasKey("openapi")) {
                throw "UNKNOWN-SCHEMA-TYPE", sprintf("unsupported OpenAPI version %y; only versions \"3.x.x\" are "
                    "supported", parsed.openapi);
            }
            throw "UNKNOWN-SCHEMA-TYPE", sprintf("unable to detect REST schema type; expected 'swagger: \"2.0\"' or "
                "'openapi: \"3.x.x\"' key; got keys: %y", keys parsed);
        }

        #! Loads the appropriate schema module and creates a schema object from a string
        private static AbstractRestSchemaValidator loadSchema(string schemaType, string schemaSource, *bool json,
                *hash<auto> opts) {
            string className = schemaType == "swagger"
                ? "Swagger::SwaggerLoader"
                : "OpenApi3::OpenApi3Loader";
            load_module(schemaType == "swagger" ? "Swagger" : "OpenApi3");
            Reflection::Class cls = Reflection::Class::forName(className);
            Reflection::StaticMethod method = cls.getMethod("fromString");
            return method.call(schemaSource, json, opts);
        }

        #! Loads the appropriate schema module and creates a schema object from a file
        private static AbstractRestSchemaValidator loadSchemaFromFile(string schemaType, string filepath,
                *hash<auto> opts) {
            string className = schemaType == "swagger"
                ? "Swagger::SwaggerLoader"
                : "OpenApi3::OpenApi3Loader";
            load_module(schemaType == "swagger" ? "Swagger" : "OpenApi3");
            Reflection::Class cls = Reflection::Class::forName(className);
            Reflection::StaticMethod method = cls.getMethod("fromFile");
            return method.call(filepath, opts);
        }
    }
}
