# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) WooCommerceRestClient
%try-module json
%define NoJson
%endtry

module WooCommerceDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for WooCommerce e-commerce services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new WooCommerceDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": WooCommerceDataProvider::AppName,
            "display_name": "WooCommerce",
            "short_desc": "WooCommerce e-commerce platform",
            "desc": "WooCommerce is the most popular open-source e-commerce platform built on WordPress. "
                "This integration enables managing orders, products, customers, coupons, webhooks, reports, "
                "shipping, taxes, and store settings via the WooCommerce REST API v3.\n\n"
                "**Features:**\n"
                "- Order management (CRUD, notes, refunds, status updates)\n"
                "- Product management (CRUD, variations, categories, tags, stock)\n"
                "- Customer management (CRUD, search, filter)\n"
                "- Coupon management (CRUD with discount types)\n"
                "- Webhook management for real-time triggers\n"
                "- Reports (sales, top sellers, totals)\n"
                "- Shipping zones and methods\n"
                "- Tax rate management\n"
                "- Store settings and system status",
            "scheme": "woocommerce",
            "logo": WooCommerceLogo,
            "logo_file_name": "woocommerce-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Ecommerce,),
        });

        # ==========================================
        # ORDER ACTIONS (11)
        # ==========================================

        # 1. list-orders (DPAT_FIND)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/orders",
            "action": "list-orders",
            "groups": "Orders",
            "display_name": "List Orders",
            "short_desc": "List and search orders",
            "desc": "Retrieve a list of orders with optional filtering by status, customer, date range, "
                "and more.",
            "action_code": DPAT_FIND,
            "data_provider_info": WooCommerceOrdersDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("OrderList", new WooCommerceOrderDataType(), True);
            },
            "options": {
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by order status",
                    "desc": "Filter orders by their status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "allowed_values": OrderStatusAllowedValues,
                },
                "customer": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "Filter by customer ID",
                    "desc": "Filter orders by customer ID",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "customers",
                },
                "product": <ActionOptionInfo>{
                    "display_name": "Product",
                    "short_desc": "Filter by product ID",
                    "desc": "Filter orders that contain a specific product ID",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "after": <ActionOptionInfo>{
                    "display_name": "After",
                    "short_desc": "Filter by date (after)",
                    "desc": "Limit response to orders placed after a given ISO8601 date string",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "before": <ActionOptionInfo>{
                    "display_name": "Before",
                    "short_desc": "Filter by date (before)",
                    "desc": "Limit response to orders placed before a given ISO8601 date string",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "search": <ActionOptionInfo>{
                    "display_name": "Search",
                    "short_desc": "Search orders",
                    "desc": "Limit results to those matching a search string",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "per_page": <ActionOptionInfo>{
                    "display_name": "Per Page",
                    "short_desc": "Results per page",
                    "desc": "Maximum number of items to return per page (max 100)",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "desc": "Current page of the collection (starting at 1)",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "order": <ActionOptionInfo>{
                    "display_name": "Order",
                    "short_desc": "Sort order",
                    "desc": "Sort ascending or descending",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "desc": "Ascending"},
                        <AllowedValueInfo>{"value": "desc", "desc": "Descending"},
                    ),
                },
                "orderby": <ActionOptionInfo>{
                    "display_name": "Order By",
                    "short_desc": "Sort by field",
                    "desc": "Sort collection by the given attribute",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "date", "desc": "Date created"},
                        <AllowedValueInfo>{"value": "id", "desc": "Order ID"},
                        <AllowedValueInfo>{"value": "include", "desc": "Include"},
                        <AllowedValueInfo>{"value": "title", "desc": "Title"},
                        <AllowedValueInfo>{"value": "slug", "desc": "Slug"},
                    ),
                },
            },
        });

        # 2. get-order (DPAT_FIND_SINGLE)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/orders",
            "action": "get-order",
            "groups": "Orders",
            "display_name": "Get Order",
            "short_desc": "Get an order by ID",
            "desc": "Retrieve a single order by its ID.",
            "action_code": DPAT_FIND_SINGLE,
            "data_provider_info": WooCommerceOrdersDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return new WooCommerceOrderDataType(); },
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "The order ID",
                    "desc": "The unique identifier of the order to retrieve",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                },
            },
        });

        # 3. create-order (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/create-order",
            "action": "create-order",
            "groups": "Orders",
            "display_name": "Create Order",
            "short_desc": "Create a new order",
            "desc": "Create a new order in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceCreateOrderDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceCreateOrderDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceCreateOrderRequestDataType::Fields),
        });

        # 4. update-order (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/update-order",
            "action": "update-order",
            "groups": "Orders",
            "display_name": "Update Order",
            "short_desc": "Update an existing order",
            "desc": "Update an existing order in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceUpdateOrderDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceUpdateOrderDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceUpdateOrderRequestDataType::Fields),
        });

        # 5. delete-order (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/delete-order",
            "action": "delete-order",
            "groups": "Orders",
            "display_name": "Delete Order",
            "short_desc": "Delete an order",
            "desc": "Delete an order in WooCommerce. By default the order is moved to trash; set `force` to "
                "`True` to permanently delete.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceDeleteOrderDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceDeleteOrderDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceDeleteOrderRequestDataType::Fields),
        });

        # 6. update-order-status (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/update-order-status",
            "action": "update-order-status",
            "groups": "Orders",
            "display_name": "Update Order Status",
            "short_desc": "Update an order's status",
            "desc": "Update the status of an existing order in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceUpdateOrderStatusDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceUpdateOrderStatusDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceUpdateOrderStatusRequestDataType::Fields) + {
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "New order status",
                    "desc": "The new status for the order",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "allowed_values": OrderStatusAllowedValues,
                },
            },
        });

        # 7. create-order-note (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/create-order-note",
            "action": "create-order-note",
            "groups": "Orders",
            "display_name": "Create Order Note",
            "short_desc": "Add a note to an order",
            "desc": "Add a note to an existing order in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceCreateOrderNoteDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceCreateOrderNoteDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceCreateOrderNoteRequestDataType::Fields),
        });

        # 8. list-order-notes (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/list-order-notes",
            "action": "list-order-notes",
            "groups": "Orders",
            "display_name": "List Order Notes",
            "short_desc": "List notes for an order",
            "desc": "Retrieve all notes for a specific order in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceListOrderNotesDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceListOrderNotesDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceListOrderNotesRequestDataType::Fields),
        });

        # 9. delete-order-note (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/delete-order-note",
            "action": "delete-order-note",
            "groups": "Orders",
            "display_name": "Delete Order Note",
            "short_desc": "Delete a note from an order",
            "desc": "Delete a specific note from an order in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceDeleteOrderNoteDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceDeleteOrderNoteDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceDeleteOrderNoteRequestDataType::Fields),
        });

        # 10. create-refund (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/create-refund",
            "action": "create-refund",
            "groups": "Orders",
            "display_name": "Create Refund",
            "short_desc": "Create a refund for an order",
            "desc": "Create a refund for an existing order in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceCreateRefundDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceCreateRefundDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceCreateRefundRequestDataType::Fields),
        });

        # 11. list-refunds (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/list-refunds",
            "action": "list-refunds",
            "groups": "Orders",
            "display_name": "List Refunds",
            "short_desc": "List refunds for an order",
            "desc": "Retrieve all refunds for a specific order in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceListRefundsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceListRefundsDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceListRefundsRequestDataType::Fields),
        });

        # ==========================================
        # PRODUCT ACTIONS (14)
        # ==========================================

        # 12. list-products (DPAT_FIND)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/products",
            "action": "list-products",
            "groups": "Products",
            "display_name": "List Products",
            "short_desc": "List and search products",
            "desc": "Retrieve a list of products with optional filtering by status, category, tag, price, "
                "stock status, and more.",
            "action_code": DPAT_FIND,
            "data_provider_info": WooCommerceProductsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("ProductList", new WooCommerceProductDataType(), True);
            },
            "options": {
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by product status",
                    "desc": "Filter products by their status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "allowed_values": ProductStatusAllowedValues,
                },
                "category": <ActionOptionInfo>{
                    "display_name": "Category",
                    "short_desc": "Filter by category ID",
                    "desc": "Filter products by category ID",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                    "ref_data": "categories",
                },
                "tag": <ActionOptionInfo>{
                    "display_name": "Tag",
                    "short_desc": "Filter by tag ID",
                    "desc": "Filter products by tag ID",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "tags",
                },
                "sku": <ActionOptionInfo>{
                    "display_name": "SKU",
                    "short_desc": "Filter by SKU",
                    "desc": "Filter products by SKU",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "search": <ActionOptionInfo>{
                    "display_name": "Search",
                    "short_desc": "Search products",
                    "desc": "Limit results to those matching a search string",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "min_price": <ActionOptionInfo>{
                    "display_name": "Min Price",
                    "short_desc": "Minimum price filter",
                    "desc": "Filter products with a price greater than or equal to this value",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "max_price": <ActionOptionInfo>{
                    "display_name": "Max Price",
                    "short_desc": "Maximum price filter",
                    "desc": "Filter products with a price less than or equal to this value",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "stock_status": <ActionOptionInfo>{
                    "display_name": "Stock Status",
                    "short_desc": "Filter by stock status",
                    "desc": "Filter products by stock status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": StockStatusAllowedValues,
                },
                "type": <ActionOptionInfo>{
                    "display_name": "Type",
                    "short_desc": "Filter by product type",
                    "desc": "Filter products by type",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": ProductTypeAllowedValues,
                },
                "featured": <ActionOptionInfo>{
                    "display_name": "Featured",
                    "short_desc": "Filter by featured status",
                    "desc": "Filter featured products",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "per_page": <ActionOptionInfo>{
                    "display_name": "Per Page",
                    "short_desc": "Results per page",
                    "desc": "Maximum number of items to return per page (max 100)",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "page": <ActionOptionInfo>{
                    "display_name": "Page",
                    "short_desc": "Page number",
                    "desc": "Current page of the collection (starting at 1)",
                    "type": AbstractDataProviderTypeMap."*int",
                },
                "order": <ActionOptionInfo>{
                    "display_name": "Order",
                    "short_desc": "Sort order",
                    "desc": "Sort ascending or descending",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "desc": "Ascending"},
                        <AllowedValueInfo>{"value": "desc", "desc": "Descending"},
                    ),
                },
                "orderby": <ActionOptionInfo>{
                    "display_name": "Order By",
                    "short_desc": "Sort by field",
                    "desc": "Sort collection by the given attribute",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "date", "desc": "Date created"},
                        <AllowedValueInfo>{"value": "id", "desc": "ID"},
                        <AllowedValueInfo>{"value": "include", "desc": "Include"},
                        <AllowedValueInfo>{"value": "title", "desc": "Title"},
                        <AllowedValueInfo>{"value": "slug", "desc": "Slug"},
                        <AllowedValueInfo>{"value": "price", "desc": "Price"},
                        <AllowedValueInfo>{"value": "popularity", "desc": "Popularity (total sales)"},
                        <AllowedValueInfo>{"value": "rating", "desc": "Average rating"},
                    ),
                },
            },
        });

        # 13. get-product (DPAT_FIND_SINGLE)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/products",
            "action": "get-product",
            "groups": "Products",
            "display_name": "Get Product",
            "short_desc": "Get a product by ID",
            "desc": "Retrieve a single product by its ID.",
            "action_code": DPAT_FIND_SINGLE,
            "data_provider_info": WooCommerceProductsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return new WooCommerceProductDataType(); },
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "The product ID",
                    "desc": "The unique identifier of the product to retrieve",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                },
            },
        });

        # 14. create-product (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/create-product",
            "action": "create-product",
            "groups": "Products",
            "display_name": "Create Product",
            "short_desc": "Create a new product",
            "desc": "Create a new product in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceCreateProductDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceCreateProductDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceCreateProductRequestDataType::Fields),
        });

        # 15. update-product (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/update-product",
            "action": "update-product",
            "groups": "Products",
            "display_name": "Update Product",
            "short_desc": "Update an existing product",
            "desc": "Update an existing product in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceUpdateProductDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceUpdateProductDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceUpdateProductRequestDataType::Fields),
        });

        # 16. delete-product (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/delete-product",
            "action": "delete-product",
            "groups": "Products",
            "display_name": "Delete Product",
            "short_desc": "Delete a product",
            "desc": "Delete a product in WooCommerce. By default the product is moved to trash; set `force` "
                "to `True` to permanently delete.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceDeleteProductDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceDeleteProductDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceDeleteProductRequestDataType::Fields),
        });

        # 17. update-stock-quantity (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/update-stock-quantity",
            "action": "update-stock-quantity",
            "groups": "Products",
            "display_name": "Update Stock Quantity",
            "short_desc": "Update a product's stock quantity",
            "desc": "Update the stock quantity for a product in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceUpdateStockQuantityDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceUpdateStockQuantityDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceUpdateStockQuantityRequestDataType::Fields),
        });

        # 18. create-variation (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/create-variation",
            "action": "create-variation",
            "groups": "Products",
            "display_name": "Create Variation",
            "short_desc": "Create a product variation",
            "desc": "Create a new variation for a variable product in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceCreateVariationDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceCreateVariationDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceCreateVariationRequestDataType::Fields) + {
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product",
                    "short_desc": "The parent product",
                    "desc": "Select the parent variable product for this variation",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "products",
                },
            },
        });

        # 19. update-variation (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/update-variation",
            "action": "update-variation",
            "groups": "Products",
            "display_name": "Update Variation",
            "short_desc": "Update a product variation",
            "desc": "Update an existing variation for a variable product in WooCommerce.",
            "action_code": DPAT_API,
            "data_provider_info": WooCommerceUpdateVariationDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return WooCommerceUpdateVariationDataProvider::ResponseType; },
            "options": DataProviderActionCatalog::getActionOptionFromFields(WooCommerceUpdateVariationRequestDataType::Fields) + {
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product",
                    "short_desc": "The parent product",
                    "desc": "Select the parent variable product",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "products",
                },
            },
        });

        # 20. list-variations (DPAT_API)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/list-variations",
            "action": "list-variations",
            "groups": "Products",
            "display_name": "List Variations",
            "short_desc": "List variations for a product",
            "desc": "Retrieve all variations for a specific variable product in WooCommerce.",
            "action_code": DPAT_API,
