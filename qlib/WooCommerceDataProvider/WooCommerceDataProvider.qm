            "action_code": DPAT_EVENT,
            "action_val": EVENT_ORDER_STATUS_CANCELLED,
            "data_provider_info": WooCommerceOrderStatusCancelledEventDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return new WooCommerceOrderEventDataType(); },
        });

        # add-to-cart
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/events/add-to-cart",
            "action": EVENT_ADD_TO_CART,
            "groups": "Triggers",
            "display_name": "Product Added to Cart",
            "short_desc": "Trigger when a product is added to cart",
            "desc": "Fires when a product is added to a customer's cart. Payload only contains `action` "
                "and `arg` (cart item key).",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_ADD_TO_CART,
            "data_provider_info": WooCommerceAddToCartEventDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return new WooCommerceAddToCartEventDataType(); },
        });

        # low-stock
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/events/low-stock",
            "action": EVENT_LOW_STOCK,
            "groups": "Triggers",
            "display_name": "Product Low Stock",
            "short_desc": "Trigger when a product reaches low stock",
            "desc": "Fires when a product's stock quantity reaches the low stock threshold configured in "
                "WooCommerce.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_LOW_STOCK,
            "data_provider_info": WooCommerceLowStockEventDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return new WooCommerceProductEventDataType(); },
        });

        # no-stock
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WooCommerceDataProvider::AppName,
            "path": "/events/no-stock",
            "action": EVENT_NO_STOCK,
            "groups": "Triggers",
            "display_name": "Product Out of Stock",
            "short_desc": "Trigger when a product goes out of stock",
            "desc": "Fires when a product's stock quantity reaches zero.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NO_STOCK,
            "data_provider_info": WooCommerceNoStockEventDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () { return new WooCommerceProductEventDataType(); },
        });
    };
}

/** @mainpage WooCommerceDataProvider Module

    @tableofcontents

    @section woocommercedataproviderintro WooCommerceDataProvider Introduction

    The %WooCommerceDataProvider module provides a data provider API for WooCommerce e-commerce services.

    To use this module, use \c "%requires WooCommerceDataProvider" in your code.

    All the public symbols in the module are defined in the WooCommerceDataProvider namespace.

    The following classes are provided by this module:
    - @ref WooCommerceDataProvider::WooCommerceDataProvider "WooCommerceDataProvider"
    - @ref WooCommerceDataProvider::WooCommerceDataProviderFactory "WooCommerceDataProviderFactory"

    @section woocommercedataprovideractions WooCommerceDataProvider Actions

    The following actions are provided:

    <b>Orders:</b>
    |!Action|!Type|!Description
    |list-orders|DPAT_FIND|List and search orders with filtering
    |get-order|DPAT_FIND_SINGLE|Get an order by ID
    |create-order|DPAT_API|Create a new order
    |update-order|DPAT_API|Update an existing order
    |delete-order|DPAT_API|Delete an order
    |update-order-status|DPAT_API|Update an order's status
    |create-order-note|DPAT_API|Add a note to an order
    |list-order-notes|DPAT_API|List notes for an order
    |delete-order-note|DPAT_API|Delete a note from an order
    |create-refund|DPAT_API|Create a refund for an order
    |list-refunds|DPAT_API|List refunds for an order

    <b>Products:</b>
    |!Action|!Type|!Description
    |list-products|DPAT_FIND|List and search products with filtering
    |get-product|DPAT_FIND_SINGLE|Get a product by ID
    |create-product|DPAT_API|Create a new product
    |update-product|DPAT_API|Update an existing product
    |delete-product|DPAT_API|Delete a product
    |update-stock-quantity|DPAT_API|Update a product's stock quantity
    |create-variation|DPAT_API|Create a product variation
    |update-variation|DPAT_API|Update a product variation
    |list-variations|DPAT_API|List variations for a product
    |create-category|DPAT_API|Create a product category
    |update-category|DPAT_API|Update a product category
    |list-categories|DPAT_FIND|List product categories
    |create-tag|DPAT_API|Create a product tag
    |list-tags|DPAT_FIND|List product tags

    <b>Customers:</b>
    |!Action|!Type|!Description
    |list-customers|DPAT_FIND|List and search customers
    |get-customer|DPAT_FIND_SINGLE|Get a customer by ID
    |create-customer|DPAT_API|Create a new customer
    |update-customer|DPAT_API|Update an existing customer
    |delete-customer|DPAT_API|Delete a customer

    <b>Coupons:</b>
    |!Action|!Type|!Description
    |list-coupons|DPAT_FIND|List and search coupons
    |get-coupon|DPAT_FIND_SINGLE|Get a coupon by ID
    |create-coupon|DPAT_API|Create a new coupon
    |update-coupon|DPAT_API|Update an existing coupon
    |delete-coupon|DPAT_API|Delete a coupon

    <b>Webhooks:</b>
    |!Action|!Type|!Description
    |list-webhooks|DPAT_FIND|List webhooks
    |create-webhook|DPAT_API|Create a new webhook
    |update-webhook|DPAT_API|Update an existing webhook
    |delete-webhook|DPAT_API|Delete a webhook

    <b>Reports:</b>
    |!Action|!Type|!Description
    |sales-report|DPAT_API|Get a sales report
    |top-sellers-report|DPAT_API|Get a top sellers report
    |orders-totals|DPAT_API|Get orders totals by status
    |products-totals|DPAT_API|Get products totals by type
    |customers-totals|DPAT_API|Get customers totals by role

    <b>Shipping/Tax/Settings/System:</b>
    |!Action|!Type|!Description
    |list-shipping-zones|DPAT_API|List shipping zones
    |list-shipping-methods|DPAT_API|List shipping methods
    |create-tax-rate|DPAT_API|Create a new tax rate
    |list-tax-rates|DPAT_FIND|List tax rates
    |get-setting|DPAT_API|Get a store setting
    |update-setting|DPAT_API|Update a store setting
    |system-status|DPAT_API|Get system status

    @section woocommercedataprovidertriggers WooCommerceDataProvider Triggers

    The following event triggers are provided:

    |!Trigger|!Description
    |order-created|Fires when a new order is created
    |order-updated|Fires when an order is updated
    |order-deleted|Fires when an order is deleted
    |order-restored|Fires when an order is restored from trash
    |product-created|Fires when a new product is created
    |product-updated|Fires when a product is updated
    |product-deleted|Fires when a product is deleted
    |product-restored|Fires when a product is restored from trash
    |customer-created|Fires when a new customer is created
    |customer-updated|Fires when a customer is updated
    |customer-deleted|Fires when a customer is deleted
    |coupon-created|Fires when a new coupon is created
    |coupon-updated|Fires when a coupon is updated
    |coupon-deleted|Fires when a coupon is deleted
    |coupon-restored|Fires when a coupon is restored from trash
    |payment-complete|Fires when an order payment is completed
    |order-status-pending|Fires when order status changes to pending
    |order-status-processing|Fires when order status changes to processing
    |order-status-completed|Fires when order status changes to completed
    |order-status-on-hold|Fires when order status changes to on-hold
    |order-status-refunded|Fires when order status changes to refunded
    |order-status-failed|Fires when order status changes to failed
    |order-status-cancelled|Fires when order status changes to cancelled
    |add-to-cart|Fires when a product is added to cart
    |low-stock|Fires when a product reaches low stock
    |no-stock|Fires when a product goes out of stock

    @section woocommercedataproviderrelnotes Release Notes

    @subsection woocommercedataproviderv1_0 WooCommerceDataProvider v1.0
    - the initial version of the %WooCommerceDataProvider module
*/
