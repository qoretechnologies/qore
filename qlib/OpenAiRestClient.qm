# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires HttpClientStreamingIo
%requires QoreLlmTypes
%requires QoreRagTypes

module OpenAiRestClient {
    version = "1.1";
    desc = "user module for calling OpenAi REST API services";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("openai", OpenAiRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(new OpenAiLlmProviderFactory());
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new QoreRagUtils::OpenAiEmbedderFactory());
    };
}

/** @mainpage OpenAiRestClient Module

    @tableofcontents

    @section openairestclientintro OpenAiRestClient Introduction

    The %OpenAiRestClient module provides an API for calling OpenAi REST API services.

    To use this module, use \c "%requires OpenAiRestClient" in your code.

    All the public symbols in the module are defined in the OpenAiRestClient namespace.

    The main classes are:
    - @ref OpenAiRestClient::OpenAiRestClient "OpenAiRestClient":
      this class provides the REST client API for communuication with the OpenAi REST
      API; it also automates authentication and authorization to the target
    - @ref OpenAiRestClient::OpenAiRestConnection "OpenAiRestConnection":
      provides a REST connection object to OpenAi cloud services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires OpenAiRestClient
%requires ConnectionProvider

OpenAiRestClient rest = get_connection("my-openai-connection");
hash<auto> ans = rest.get("/calendar/users/me/calendarList");
printf("%Y\n", ans.body);
    @endcode

    @par Streaming Example:
    @code{.py}
OpenAiRestClient rest = get_connection("my-openai-connection");
OpenAiResponseSseStream stream = rest.openResponsesStream({
    "model": "gpt-4o-mini",
    "stream": True,
    "input": (
        {
            "input_item": {
                "role": "user",
                "content": (
                    {
                        "type": "input_text",
                        "text": "Stream a response",
                    },
                ),
            },
        },
    ),
});
while (hash<SseMessageInfo> evt = stream.readEvent(5s)) {
    if (evt.data == "[DONE]") {
        break;
    }
    printf("%s\n", evt.data);
}
stream.close();
    @endcode

    @section OpenAiRestClientRelnotes Release Notes

    @subsection OpenAiRestClientv1_1 OpenAiRestClient v1.1

    - Per-call LLM timeouts now govern synchronous requests and stream setup;
      explicit streaming deadlines include all response chunks without changing
      concurrent calls' client settings.
    - Interrupted chat streams without a completion frame now raise an error
      instead of returning a successful partial answer.
    - strict LLM output and tool schemas automatically adapt optional fields to
      OpenAI's required nullable representation; returned JSON and tool arguments
      restore the caller's original optional-field semantics
    - adapted structured streams emit their JSON after it is complete so callers
      never receive temporary null placeholders; ordinary text streams are unchanged
    - unsupported strict-schema constraints report a local error before an API call
    - added SSE helper for streaming responses
    - fixed streaming chat completions to preserve function-call-only deltas

    @subsection OpenAiRestClientv1_0 OpenAiRestClient v1.0
    - the initial version of the %OpenAiRestClient module
*/

%requires json >= 1.11

#! the OpenAiRestClient namespace contains all the objects in the OpenAiRestClient module
public namespace OpenAiRestClient {
#! Common base class for OpenAiRestClient functionality
public class OpenAiRestClientBase {
    public {
        #! Default OpenAi REST API URL
        const DefaultUrl = "https://api.openai.com";

        #! Default OpenAi API version
        const DefaultApiVersion = "v1";

        #! Default OpenAI chat model
        const DefaultChatModel = "gpt-4o-mini";

        #! Default embedding model
        const DefaultEmbeddingModel = "text-embedding-3-small";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    #! returns options for @ref OpenAiRestClient::OpenAiRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        if (!opts.swagger && !opts.validator && opts.use_schema) {
            string path = dirname(get_module_hash().OpenAiRestClient.filename)
                + "/OpenAiDataProvider/openai-swagger-2.0.yaml";
            if (is_file(path)) {
                opts.swagger = path;
            }
        }
        remove opts{"chat-model", "embedding-model"};
        return DefaultOptions + opts;
    }
}

#! this class provides the REST client API for communication with OpenAi servers
/** You must use an API key in the 'token' option to call OpenAi APIs
*/
public class OpenAiRestClient inherits RestClient::RestClient, OpenAiRestClientBase {
    private {
        #! The API version in use
        string api;
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
OpenAiRestClient rest(opts);
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class; note
        that the URL is set by default if not provided (see @ref DefaultUrl)
        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(OpenAiRestClientBase::getOptions(opts), True) {
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(getString(opts, "api") ?? DefaultApiVersion);
        }
    }

    #! Opens a Server-Sent Events stream for responses
    OpenAiResponseSseStream openResponsesStream(hash<auto> req, *hash<auto> hdr, *timeout to) {
        return new OpenAiResponseSseStream(self, "responses", req, hdr, to);
    }
}

#! SSE connection for OpenAI responses streams
public class OpenAiResponseSseStream {
    private {
        OpenAiRestClient rest;
        bool chunked;
        string content_encoding;
        StringOutputStream ostream;
        TransformOutputStream dstream;
        bool use_decompressor;
        timeout timeout_ms = 15s;
        bool closed;

        const SseMimeType = "text/event-stream";
    }

    #! Creates the stream connection
    constructor(OpenAiRestClient rest, string path, *auto body, *hash<auto> hdr, *timeout to) {
        self.rest = rest;
        if (to) {
            timeout_ms = to;
        }
        hash<auto> headers = rest.getDefaultHeaders() + (hdr ?? {});
        headers.Accept = SseMimeType;
        data payload;
        if (exists body) {
            payload = getSerializedBody(body, \headers);
        }
        string full_path = buildPath(path);
        hash<auto> info;
        hash<auto> resp = rest.send(payload, "POST", full_path, headers, False, \info);
        if (resp.status_code != 200) {
            throw "SSE-ERROR", sprintf("unexpected status code %d %s", resp.status_code, resp.status_message);
        }
        string content_type = normalizeContentType(resp."content-type");
        if (content_type != SseMimeType) {
            throw "SSE-ERROR", sprintf("expected Content-Type %y but got %y", SseMimeType, resp."content-type");
        }
        if (resp."content-encoding".val()) {
            content_encoding = tolower(resp."content-encoding");
        }
        if (resp."transfer-encoding".val()) {
            string transfer_encoding = tolower(resp."transfer-encoding");
            if (transfer_encoding == "chunked") {
                chunked = True;
            } else {
                throw "SSE-ERROR", sprintf("unsupported Transfer-Encoding: %y", resp."transfer-encoding");
            }
        }
        setupDecompression();
    }

    #! Reads the next SSE message
    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (closed) {
            return;
        }
        timeout use_to = to ?? timeout_ms;
        if (chunked) {
            hash<auto> hh = rest.readHTTPChunk(use_to);
            if (!hh.body) {
                return;
            }
            if (use_decompressor) {
                dstream.write(hh.body);
            } else {
                ostream.write(hh.body);
            }
            return rest.parseServerSentEvent(ostream.getData());
        }
        return rest.readServerSentEvent(content_encoding, use_to);
    }

    #! Closes the stream connection
    close() {
        if (!closed) {
            closed = True;
            rest.disconnect();
        }
    }

    private string buildPath(string path) {
        string rv = path;
        rv =~ s/^\/+//;
        rv = "/" + rv;
        *string base = rest.getConnectionPath();
        if (base.val() && base != "/") {
            base =~ s/\/+$//;
            if (base !~ /^\//) {
                base = "/" + base;
            }
            rv = base + rv;
        }
        *string defp = rest.getDefaultPath();
        if (defp.val() && defp != "/") {
            defp =~ s/\/+$//;
            if (defp !~ /^\//) {
                defp = "/" + defp;
            }
            rv = defp + rv;
        }
        return rv;
    }

    private data getSerializedBody(data body, reference<hash<auto>> headers) {
        if (body.typeCode() == NT_STRING) {
            if (!headers."Content-Type") {
                headers."Content-Type" = "application/json";
            }
            return body;
        }
        if (!headers."Content-Type") {
            headers."Content-Type" = "application/json";
        }
        return call_function_args("to_json", (body,));
    }

    private setupDecompression() {
        if (!chunked) {
            return;
        }
        ostream = new StringOutputStream();
        Transform decompressor;
        switch (content_encoding) {
            case "deflate":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_ZLIB);
                break;
            case "gzip":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_GZIP);
                break;
            case "bzip2":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_BZIP2);
                break;
            case NOTHING:
            case "identity":
                use_decompressor = False;
                break;

            default:
                throw "ENCODING-ERROR", sprintf("Don't know how to handle Content-Encoding %y", content_encoding);
        }
        if (use_decompressor) {
            dstream = new TransformOutputStream(ostream, decompressor);
        }
    }

    private static string normalizeContentType(*string content_type) {
        if (!content_type.val()) {
            return "";
        }
        string rv = content_type;
        rv =~ s/\s*;.*$//;
        rv =~ s/^\s+//;
        rv =~ s/\s+$//;
        return tolower(rv);
    }
}

#! Class for OpenAi REST connections; returns @ref OpenAiRestClient objects
/** This class implements all options of \c RestClient::RestConnection "RestClientConnection"

    @see @ref OpenAiRestClient::OpenAiRestClient::constructor() for more information on the above options
*/
public class OpenAiRestConnection inherits RestClient::RestConnection {
    public {
        #! Default OpenAi REST API URL
        const DefaultUrl = "openai://api.openai.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "OpenAi REST Connection",
            "short_desc": "A connection to the OpenAi REST API",
            "desc": "A connection to the OpenAi REST API",
            "cls": Class::forName("OpenAiRestConnection"),
            "auto_url": True,
            "schemes": {
                "openai": True,
            },
            "base_scheme_map": {
                "https": "openai",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "The API version to use",
                    "desc": "The API version to use",
                    "type": "string",
                    "default_value": OpenAiRestClientBase::DefaultApiVersion,
                },
                "chat-model": <ConnectionOptionInfo>{
                    "display_name": "Chat Model",
                    "short_desc": "OpenAI chat model name",
                    "desc": "The OpenAI chat model used by LLM clients when this connection is "
                        "selected for chat.\n\n"
                        "Chat models are a separate family from embedding models and cannot "
                        "be used interchangeably."
                        "\n\nExample values: `gpt-4o-mini` (the default), `gpt-4o`, `o3-mini`",
                    "type": "string",
                    "default_value": OpenAiRestClientBase::DefaultChatModel,
                },
                "use_schema": <ConnectionOptionInfo>{
                    "display_name": "Use OpenAPI Schema",
                    "short_desc": "Use the OpenAPI schema for API validation",
                    "desc": "Use the OpenAPI schema for API validation; OpenAI can change the schema at any time, so "
                        "the schema may be out of date and may cause valid API calls to fail",
                    "type": "bool",
                    "default_value": False,
                },
                "embedding-model": <ConnectionOptionInfo>{
                    "display_name": "Embedding Model",
                    "short_desc": "OpenAI embedding model name",
                    "desc": "The OpenAI embedding model used by embedding clients when this "
                        "connection is selected for embeddings",
                    "type": "string",
                    "default_value": OpenAiRestClientBase::DefaultEmbeddingModel,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": DefaultPingPath,
                },
            },
            "required_options": "token",
        };

        #! Default OpenAi ping method
        const DefaultPingMethod= "GET";

        #! Default OpenAi ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OpenAi ping path
        const DefaultPingPath = "models";
    }

    #! creates the OpenAiRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the OpenAiRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! returns \c "openai"
    string getType() {
        return "openai";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the \c getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the OpenAiDataProvider and creates the data provider
        # object dynamically
        load_module("OpenAiDataProvider");
        return create_object("OpenAiDataProvider", getAsync());
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != DefaultUrl) {
                update.url = DefaultUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! returns a @ref OpenAiRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref OpenAiRestClient object
    */
    private OpenAiRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new OpenAiRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since OpenAiRestClient 1.2
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new OpenAiRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for OpenAi REST API using multiplexed HTTP connections
/** @see OpenAiRestClient for more information
*/
public class OpenAiRestClientIo inherits RestClientIo::RestClientIo, OpenAiRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(OpenAiRestClientBase::getOptions(opts), shared_mgr) {
    }

    #! Opens a Server-Sent Events stream for responses using async I/O
    /** Uses HttpClientIo and SseStreamReader for incremental SSE event delivery
        across HTTP/1.x, HTTP/2, and HTTP/3.

        @param req the request body (will be serialized to JSON)
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading

        @return an SSE stream object for reading events incrementally

        @par Example:
        @code{.py}
OpenAiRestClientIo rest({"url": "https://api.openai.com", "token": api_key, "data": "json"});
OpenAiResponseSseStreamIo stream = rest.openResponsesStream({
    "model": "gpt-4o-mini",
    "stream": True,
    "input": ({"role": "user", "content": "Hello!"},),
});
while (*hash<SseMessageInfo> evt = stream.readEvent()) {
    printf("Event: %y\n", evt.data);
}
        @endcode
    */
    OpenAiResponseSseStreamIo openResponsesStream(hash<auto> req, *hash<auto> hdr, *timeout to) {
        return new OpenAiResponseSseStreamIo(self, "responses", req, hdr, to);
    }
}

#! SSE stream for OpenAI responses using async I/O (HttpClientIo + SseStreamReader)
/** Works across HTTP/1.x, HTTP/2, and HTTP/3 via HttpClientIo's multiplexed
    connection manager.

    @note This class is \b not thread-safe.  Use from a single reader thread.
*/
public class OpenAiResponseSseStreamIo {
    private {
        #! SSE stream reader
        HttpClientStreamingIo::SseStreamReader reader;

        #! Timeout for SSE event reading
        timeout timeout_ms = 15s;

        #! True when the stream has been closed
        bool closed = False;
    }

    #! Creates the SSE stream connection
    /** @param rest the OpenAiRestClientIo instance
        @param path the API endpoint path (e.g., "responses")
        @param body the request body (serialized to JSON)
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading
    */
    constructor(OpenAiRestClientIo rest, string path, *auto body, *hash<auto> hdr, *timeout to) {
        if (to) {
            timeout_ms = to;
        }
        hash<auto> headers = rest.getDefaultHeaders() + (hdr ?? {});
        headers.Accept = "text/event-stream";

        # Serialize body to JSON
        *data payload;
        if (exists body) {
            if (body.typeCode() != NT_STRING) {
                if (!headers."Content-Type") {
                    headers."Content-Type" = "application/json";
                }
                payload = call_function_args("to_json", (body,));
            } else {
                if (!headers."Content-Type") {
                    headers."Content-Type" = "application/json";
                }
                payload = body;
            }
        }

        # Build full path
        string full_path = buildPath(rest, path);

        # Acquire stream and start SSE streaming
        HttpClientIo::HttpClientConnectionManager mgr = rest.getConnectionManager();
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(rest.getUrl());
        stream.startStreaming("POST", full_path, headers, False, payload);

        reader = new HttpClientStreamingIo::SseStreamReader(stream);
    }

    #! Reads the next SSE event
    /** @param to optional timeout override
        @return the parsed SSE event, or NOTHING on timeout or stream end
    */
    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (closed) {
            return NOTHING;
        }
        return reader.readEvent(to ?? timeout_ms);
    }

    #! Returns True if the stream has ended
    bool isDone() {
        return closed || reader.isDone();
    }

    #! Closes the stream
    close() {
        if (!closed) {
            closed = True;
            reader.cancel();
        }
    }

    #! Builds the full API path from connection path + relative path
    private static string buildPath(RestClientIo::RestClientIo rest, string path) {
        string rv = path;
        rv =~ s/^\/+//;
        rv = "/" + rv;
        *string base = rest.getConnectionPath();
        if (base.val() && base != "/") {
            base =~ s/\/+$//;
            if (base !~ /^\//) {
                base = "/" + base;
            }
            rv = base + rv;
        }
        return rv;
    }
}

#! Request-local conversion between caller schemas and OpenAI strict schemas
/** Only optional, originally non-nullable fields use null as an absence
    marker. Explicitly nullable fields retain their null values. Schema
    validators and projection state belong to one request, never the provider.
*/
class OpenAiStrictOutputSchema {
    private {
        hash<auto> original;
        hash<auto> wire;
        JsonSchema original_validator;
        JsonSchema wire_validator;
        hash<string, JsonSchema> validators;
        hash<string, string> schema_paths;
        bool projection = False;
        int nodes = 0;
        const MaxDepth = 64;
        const MaxNodes = 10000;
        const RootDefinition = "__qore_strict_schema_root";
    }

    constructor(hash<auto> schema) {
        original = transform(schema, False, "#", "#", 0);
        original = rebaseRefs(original, 0, True);
        schema_paths = {};
        nodes = 0;
        wire = transform(original, True, "#", "#", 0);
        wire = rebaseRefs(wire, 0, True);
        schema_paths = {};
        if (wire.type != "object" || exists wire.anyOf) {
            schemaError("$", "the root must be an object");
        }
        original_validator = new JsonSchema(original);
        wire_validator = new JsonSchema(wire);
    }

    hash<auto> getSchema() {
        return wire;
    }

    bool needsProjection() {
        return projection;
    }

    string restoreJson(string content) {
        if (!projection) {
            return content;
        }
        auto value = parse_json(content);
        if (!wire_validator.validate(value)) {
            throw "OPENAI-STRUCTURED-OUTPUT-ERROR",
                "the response does not match the strict wire schema";
        }
        value = restore(value, original, wire, 0);
        if (!original_validator.validate(value)) {
            throw "OPENAI-STRUCTURED-OUTPUT-ERROR",
                "the response does not match the caller's schema";
        }
        return make_json(value);
    }

    private static schemaError(string path, string reason) {
        throw "OPENAI-STRICT-SCHEMA-ERROR",
            sprintf("cannot convert strict output schema at %s: %s", path,
                reason);
    }

    # Copy schema nodes only; enum/default data must never be walked as schemas.
    private hash<auto> transform(hash<auto> schema, bool strict,
            string path, string target_path, int depth) {
        if (depth > MaxDepth || ++nodes > MaxNodes) {
            schemaError(path, "schema traversal limit exceeded");
        }
        hash<auto!> rv = {};
        rv += schema;
        schema_paths{path} = target_path;
        # Nullable annotations wrap this schema; optional properties instead
        # wrap its use site. References must continue identifying the schema.
        string child_target = rv.nullable == True
            ? target_path + "/anyOf/0" : target_path;
        bool object_schema = rv.type == "object"
            || (rv.type.typeCode() == NT_LIST && inlist("object", rv.type));
        if (strict && exists rv.properties && !object_schema) {
            schemaError(path, "properties require an explicit object type");
        }
        hash<string, bool> was_required;
        if (strict && object_schema) {
            if (exists rv.required && rv.required.typeCode() != NT_LIST) {
                schemaError(path + ".required", "expected a list of property names");
            }
            foreach auto key in (rv.required ?? ()) {
                if (key.typeCode() != NT_STRING) {
                    schemaError(path + ".required", "invalid property name");
                }
                was_required{key} = True;
            }
        }
        if (strict) {
            foreach string key in (("allOf", "oneOf", "not", "if", "then",
                    "else", "dependentRequired", "dependentSchemas",
                    "patternProperties", "unevaluatedProperties",
                    "propertyNames", "prefixItems", "contains",
                    "minContains", "maxContains", "uniqueItems",
                    "minProperties", "maxProperties", "$dynamicRef",
                    "$recursiveRef", "$id", "$anchor")) {
                if (exists rv{key}) {
                    schemaError(path + "." + key,
                        "unsupported constraint; it cannot be discarded");
                }
            }
        }
        if (strict && (exists rv."$ref" || exists rv.anyOf)) {
            foreach string key in (keys rv) {
                if (!inlist(key, ("$ref", "anyOf", "$defs", "definitions",
                        "$schema", "description", "title", "name", "default",
                        "examples", "nullable", "$comment"))) {
                    schemaError(path + "." + key,
                        "reference/union sibling constraints require explicit schema branches");
                }
            }
            if (exists rv."$ref" && exists rv.anyOf) {
                schemaError(path, "a reference cannot also declare a union");
            }
        }
        if (exists rv."$ref") {
            if (rv."$ref".typeCode() != NT_STRING
                    || (rv."$ref" != "#" && rv."$ref" !~ /^#\//)) {
                schemaError(path, "only local JSON-pointer references are supported");
            }
        }
        foreach string key in (("$defs", "definitions", "properties")) {
            if (!exists rv{key}) {
                continue;
            }
            if (rv{key}.typeCode() != NT_HASH) {
                schemaError(path + "." + key, "expected an object");
            }
            hash<auto!> children = {};
            foreach hash<auto> entry in (rv{key}.pairIterator()) {
                if (entry.value.typeCode() != NT_HASH) {
                    schemaError(path + "." + key + "." + entry.key,
                        "expected a schema object");
                }
                string suffix = "/" + key + "/" + pointerToken(entry.key);
                string child_path = child_target + suffix;
                if (strict && key == "properties" && object_schema
                        && !was_required{entry.key}) {
                    child_path += "/anyOf/0";
                }
                children{entry.key} = transform(entry.value, strict,
                    path + suffix, child_path, depth + 1);
            }
            rv{key} = children;
        }
        if (exists rv.items) {
            if (rv.items.typeCode() != NT_HASH) {
                schemaError(path + ".items", "expected a schema object");
            }
            rv.items = transform(rv.items, strict, path + "/items",
                child_target + "/items", depth + 1);
        }
        if (exists rv.anyOf) {
            if (rv.anyOf.typeCode() != NT_LIST || !rv.anyOf) {
                schemaError(path + ".anyOf", "expected a nonempty schema list");
            }
            list<auto> branches = ();
            int index = 0;
            foreach auto branch in (rv.anyOf) {
                if (branch.typeCode() != NT_HASH) {
                    schemaError(path + ".anyOf", "expected a schema object");
                }
                string suffix = "/anyOf/" + index++;
                branches += transform(branch, strict, path + suffix,
                    child_target + suffix, depth + 1);
            }
            rv.anyOf = branches;
        }
        if (strict && object_schema) {
            if (exists rv.additionalProperties
                    && (rv.additionalProperties.typeCode() != NT_BOOLEAN
                        || rv.additionalProperties)) {
                schemaError(path + ".additionalProperties",
                    "open-ended properties cannot be represented in strict output");
            }
            rv.additionalProperties = False;
            hash<auto> properties = rv.properties ?? {};
            rv.properties = properties;
            list<string> required = ();
            foreach string key in (keys was_required) {
                if (!properties.hasKey(key)) {
                    schemaError(path + ".required", "undeclared or invalid property name");
                }
            }
            foreach hash<auto> entry in (properties.pairIterator()) {
                required += entry.key;
                if (!was_required{entry.key}) {
                    # A null branch also works for enums, refs, and constrained
                    # objects; changing type alone would leave enum rejecting null.
                    rv.properties{entry.key} = nullableSchema(entry.value);
                    projection = True;
                }
            }
            rv.required = required;
        }
        # Qore-generated tool schemas can use the OpenAPI nullable convention.
        if (rv.nullable == True) {
            remove rv.nullable;
            rv = nullableSchema(rv);
        } else {
            remove rv.nullable;
        }
        # These are annotations, not validation constraints or provider options.
        foreach string key in (("$schema", "name", "default", "examples")) {
            remove rv{key};
        }
        return rv;
    }

    private static hash<auto> nullableSchema(hash<auto> schema) {
        return {"anyOf": (schema, {"type": "null"})};
    }

    private static string pointerToken(string key) {
        key =~ s/~/~0/g;
        key =~ s/\//~1/g;
        return key;
    }

    private static hash<auto> resolveRef(hash<auto> schema, hash<auto> root) {
        string ref = schema."$ref";
        if (ref == "#") {
            return root;
        }
        auto target = root;
        string pointer = decode_url(ref.substr(1));
        foreach string part in (pointer.substr(1).split("/")) {
            part =~ s/~1/\//g;
            part =~ s/~0/~/g;
            if (target.typeCode() == NT_LIST && part =~ /^(0|[1-9][0-9]*)$/
                    && part.length() < 16 && part.toInt() < target.size()) {
                target = target[part.toInt()];
            } else if (target.typeCode() == NT_HASH && target.hasKey(part)) {
                target = target{part};
            } else {
                schemaError(ref, "unresolved local reference");
            }
        }
        if (target.typeCode() != NT_HASH) {
            schemaError(ref, "reference does not identify a schema object");
        }
        return target;
    }

    # Rebase schema references so validating a subschema retains the meaning of
    # both root-recursive refs and refs into the original document's definitions.
    private hash<auto> rebaseRefs(hash<auto> schema, int depth = 0,
            bool relocate = False) {
        if (depth > MaxDepth) {
            schemaError("$", "schema reference traversal limit exceeded");
        }
        hash<auto!> rv = {};
        rv += schema;
        if (rv."$ref".val()) {
            if (relocate) {
                string pointer = decode_url(rv."$ref");
                if (!schema_paths.hasKey(pointer)) {
                    schemaError(rv."$ref", "reference does not identify a supported schema node");
                }
                rv."$ref" = "#" + encode_url(schema_paths{pointer}.substr(1));
            } else {
                rv."$ref" = "#/$defs/" + RootDefinition
                    + rv."$ref".substr(1);
            }
        }
        foreach string key in (("properties", "$defs", "definitions")) {
            if (rv{key}.typeCode() == NT_HASH) {
                hash<auto!> children = {};
                foreach hash<auto> entry in (rv{key}.pairIterator()) {
                    children{entry.key} = rebaseRefs(entry.value, depth + 1,
                        relocate);
                }
                rv{key} = children;
            }
        }
        if (rv.items.typeCode() == NT_HASH) {
            rv.items = rebaseRefs(rv.items, depth + 1, relocate);
        }
        if (rv.anyOf.typeCode() == NT_LIST) {
            rv.anyOf = map rebaseRefs($1, depth + 1, relocate), rv.anyOf;
        }
        return rv;
    }

    private bool matches(auto value, hash<auto> schema, bool use_wire) {
        string key = (use_wire ? "wire:" : "original:") + make_json(schema);
        if (!validators{key}) {
            if (!hasRefs(schema)) {
                validators{key} = new JsonSchema(schema);
                return validators{key}.validate(value);
            }
            hash<auto!> standalone = {};
            standalone += rebaseRefs(schema);
            # All refs are rebased, so local definitions can be replaced by
            # the complete schema document under a collision-free root.
            standalone."$defs" = {
                RootDefinition: rebaseRefs(use_wire ? wire : original),
            };
            validators{key} = new JsonSchema(standalone);
        }
        return validators{key}.validate(value);
    }

    # Avoid embedding the whole document for ordinary scalar/enum validators.
    private static bool hasRefs(hash<auto> schema) {
        if (exists schema."$ref") {
            return True;
        }
        foreach string key in (("properties", "$defs", "definitions")) {
            foreach hash<auto> child in ((schema{key} ?? {}).iterator()) {
                if (hasRefs(child)) {
                    return True;
                }
            }
        }
        if (schema.items.typeCode() == NT_HASH && hasRefs(schema.items)) {
            return True;
        }
        foreach hash<auto> branch in (schema.anyOf ?? ()) {
            if (hasRefs(branch)) {
                return True;
            }
        }
        return False;
    }

    private auto restore(auto value, hash<auto> schema, hash<auto> wire_schema,
            int depth) {
        if (depth > MaxDepth) {
            throw "OPENAI-STRUCTURED-OUTPUT-ERROR",
                "structured response nesting limit exceeded";
        }
        if (exists schema."$ref") {
            value = restore(value, resolveRef(schema, original),
                resolveRef(wire_schema, wire), depth + 1);
        }
        if (schema.anyOf.typeCode() == NT_LIST) {
            # Preserve an already-valid branch, including explicit nullable
            # fields, before considering branches that need absence projection.
            foreach hash<auto> branch in (schema.anyOf) {
                if (matches(value, branch, False)) {
                    return value;
                }
            }
            int index = 0;
            foreach hash<auto> branch in (schema.anyOf) {
                hash<auto> wire_branch = wire_schema.anyOf[index++];
                if (matches(value, wire_branch, True)) {
                    auto candidate = restore(value, branch, wire_branch,
                        depth + 1);
                    if (matches(candidate, branch, False)) {
                        return candidate;
                    }
                }
            }
            throw "OPENAI-STRUCTURED-OUTPUT-ERROR",
                "structured response has no matching union branch";
        }
        if (value.typeCode() == NT_HASH && schema.properties.typeCode() == NT_HASH) {
            hash<auto!> object_value = {};
            object_value += value;
            hash<string, bool> required;
            foreach string key in (schema.required ?? ()) {
                required{key} = True;
            }
            foreach hash<auto> entry in (schema.properties.pairIterator()) {
                if (!object_value.hasKey(entry.key)) {
                    continue;
                }
                bool optional = !required{entry.key};
                if (optional && (object_value{entry.key}.typeCode() == NT_NULL
                        || object_value{entry.key}.typeCode() == NT_NOTHING)
                        && !matches(NOTHING, entry.value, False)) {
                    remove object_value{entry.key};
                    continue;
                }
                hash<auto> child_wire = wire_schema.properties{entry.key};
                if (optional) {
                    child_wire = child_wire.anyOf[0];
                }
                object_value{entry.key} = restore(object_value{entry.key},
                    entry.value, child_wire, depth + 1);
            }
            return object_value;
        }
        if (value.typeCode() == NT_LIST && schema.items.typeCode() == NT_HASH) {
            list<auto> items = ();
            foreach auto item in (value) {
                items += (restore(item, schema.items, wire_schema.items,
                    depth + 1),);
            }
            return items;
        }
        return value;
    }
}

#! LLM provider that dispatches to OpenAI-compatible \c /v1/chat/completions endpoints
/** Implements the @ref QoreLlmUtils::AbstractLlmProvider contract for any
    backend that speaks the OpenAI chat-completions wire format (OpenAI,
    Azure OpenAI, vLLM, SGLang via <a href="../../SGLangRestClient/html/index.html">SGLangLlmProvider</a>, any compatible
    gateway).  Owns its own @ref RestClientIo::RestClientIo and uses the
    standard \c Authorization: \c Bearer header for authentication.

    Strict structured-output and function schemas are adapted at this boundary:
    all declared properties become required, and optional properties gain a null
    alternative. Completed responses remove null only for fields that were
    optional and non-nullable in the caller's schema. Explicitly nullable fields
    preserve null. Caller-owned schemas are never modified. The same behavior is
    available through the generic LLM API and the OpenAI-compatible facade.

    Nested objects, arrays, enums, unions, and local JSON-pointer references are
    supported. Reference/union branches must carry their own constraints; schema
    IDs and anchors that change reference scope are unsupported. Explicitly
    open-ended properties and unsupported constraints such as \c allOf raise \c OPENAI-STRICT-SCHEMA-ERROR before HTTP dispatch instead
    of being discarded. Omitted \c additionalProperties becomes false for strict
    objects. Provider-specific model limits still apply.

    Adapted structured streams buffer up to 16 MiB and emit one restored JSON or
    tool-argument delta before the terminal event. Schemas without optional fields,
    ordinary text streams, and non-strict requests retain their existing streaming
    behavior. Refusals and truncated outputs bypass schema restoration;
    incomplete streams fail with \c OPENAI-STRUCTURED-OUTPUT-ERROR. This adaptation
    belongs to the LLM provider; generic REST and raw SSE APIs retain their raw wire
    contract.

    Thread-safe: the REST client is lazy-initialized behind a mutex.

    @par Reuse as the OpenAI-compatible base class

    This class is the reusable base for **any** OpenAI-compatible chat
    backend that speaks the OpenAI wire shape (\c messages, \c tools,
    \c response_format, \c usage, SSE \c data: deltas with \c [DONE]
    terminator) with \c Authorization: \c Bearer authentication.  Concrete
    subclasses register a distinct
    @ref QoreLlmUtils::AbstractLlmProviderFactory under a vendor-specific
    mode string and either inherit the default \c /v1/chat/completions
    endpoint or override @ref getChatCompletionsPath() to point at a
    vendor-specific URL.

    Existing in-repo subclasses:
    - <a href="../../SGLangRestClient/html/index.html">SGLangLlmProvider</a> — mode \c "sglang"
    - <a href="../../GrokRestClient/html/index.html">GrokLlmProvider</a> — mode \c "grok"
    - <a href="../../PerplexityRestClient/html/index.html">PerplexityLlmProvider</a> — mode \c "perplexity"
      (overrides @ref getChatCompletionsPath() since Perplexity's path is
      \c /chat/completions, not \c /v1/chat/completions)
*/
public class OpenAiLlmProvider inherits QoreLlmUtils::AbstractLlmProvider {
    private {
        #! Lazy-initialized REST client
        *RestClientIo::RestClientIo rest_client;
        #! Serializes lazy initialization
        Mutex rest_mutex();
    }

    #! Returns the default OpenAI chat model
    *string getDefaultModel() {
        return OpenAiRestClientBase::DefaultChatModel;
    }

    #! Constructs the provider from an @ref QoreLlmUtils::LlmBackendConfig
    /** @param config the backend configuration; @ref QoreLlmUtils::LlmBackendConfig::url
            is required

        @throw LLM-CONFIG-ERROR \c url is missing
        @throw LLM-DEPENDENCY-ERROR the \c json module is not available
    */
    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : QoreLlmUtils::AbstractLlmProvider(config) {
        if (!config.url.val()) {
            throw "LLM-CONFIG-ERROR",
                sprintf("url is required for %y mode", getMode());
        }
    }

    string getMode() {
        return "http";
    }

    #! Returns the chat-completions endpoint path (subclass override hook)
    /** The default \c /v1/chat/completions matches OpenAI, xAI Grok,
        Together, Fireworks, Groq, DeepSeek, Mistral, Ollama, vLLM, and
        SGLang.  Backends that publish at a different path (e.g. Perplexity
        at \c /chat/completions) override this method.

        @return the URL path for chat-completions POST requests
    */
    string getChatCompletionsPath() {
        return "/v1/chat/completions";
    }

    #! Preserves supported OpenAI wire controls at the generic facade boundary
    /** @param body_options provider-specific body options to update
        @param request the incoming OpenAI-compatible request
    */
    applyOpenAiRequestControls(reference<hash<auto!>> body_options,
            hash<auto> request) {
        foreach string key in (("parallel_tool_calls", "service_tier",
                "stream_options", "response_format", "top_p")) {
            if (exists request{key}) {
                body_options{key} = request{key};
            }
        }
    }

    hash<QoreLlmUtils::LlmCompletionResult> complete(string system_prompt,
            string user_prompt, *hash<auto> output_schema,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> body = {
            "messages": (
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt},
            ),
            "temperature": getRequestTemperature(opts),
        };
        *string request_model = getRequestModel(opts);
        if (request_model.val()) {
            body.model = request_model;
        }
        body = applyOpenAiOutputTokenBudget(body, opts);
        if (output_schema) {
            body.response_format = {
                "type": "json_schema",
                "json_schema": {
                    "name": output_schema.name ?? "output",
                    "strict": True,
                    "schema": output_schema,
                },
            };
        }
        body = finalizeOpenAiRequestBody(body, opts);
        hash<auto> strict_context = prepareStrictRequest(body);
        body = strict_context.body;

        hash<auto> resp;
        try {
            resp = withRetry(hash<auto> sub () {
                return rest_client.restPostWithTimeout(getChatCompletionsPath(), body,
                    buildAuthHeader(), getRequestTimeoutMs(opts));
            }, opts);
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR", sprintf("HTTP completion request failed: %s",
                OpenAiLlmProvider::requestErrorDetail(ex)), ex;
        }

        hash<auto> response = restoreStrictResponse(resp.body, strict_context);
        return <QoreLlmUtils::LlmCompletionResult>{
            "content": openAiContentText(response.choices[0].message.content) ?? "",
            "usage": resp.body.usage ?? {},
        };
    }

    hash<QoreLlmUtils::ChatResponse> chat(
            list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> strict_context = prepareStrictRequest(
            buildOpenAiChatBody(messages, tools, opts));
        hash<auto> body = strict_context.body;

        hash<auto> resp;
        try {
            resp = withRetry(hash<auto> sub () {
                return rest_client.restPostWithTimeout(getChatCompletionsPath(), body,
                    buildAuthHeader(), getRequestTimeoutMs(opts));
            }, opts);
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR", sprintf("chat request failed: %s",
                OpenAiLlmProvider::requestErrorDetail(ex)), ex;
        }

        return parseOpenAiChatResponse(restoreStrictResponse(resp.body,
            strict_context));
    }

    chatStream(list<hash<QoreLlmUtils::ChatMessage>> messages,
            code<nothing(hash<QoreLlmUtils::ChatStreamEvent>)> callback,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> strict_context = prepareStrictRequest(
            buildOpenAiChatBody(messages, tools, opts));
        hash<auto> body = strict_context.body;
        body.stream = True;
        # a streamed response reports its usage only when it is requested; a caller that set the option in
        # QoreLlmUtils::LlmRequestOptions::body_options keeps its own value
        if (streamIncludesUsage() && !body.hasKey("stream_options")) {
            body.stream_options = {"include_usage": True};
        }

        # subclasses such as the Azure OpenAI provider supply their own
        # credential headers
        hash<auto> hdr = (buildAuthHeader() ?? {}) + {
            "Accept": "text/event-stream",
            "Content-Type": "application/json",
        };

        string json_body = make_json(body);
        *date request_deadline = exists opts.timeout_ms
            ? now_us() + milliseconds(getRequestTimeoutMs(opts)) : NOTHING;
        HttpClientStreamingIo::SseStreamReader reader;
        try {
            reader = withRetry(HttpClientStreamingIo::SseStreamReader sub () {
                return rest_client.restSseReaderWithTimeout("POST",
                    getChatCompletionsPath(), hdr, json_body,
                    remainingStreamTimeout(getRequestTimeoutMs(opts), request_deadline));
            }, opts);
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR", sprintf("streaming chat request failed: %s",
                OpenAiLlmProvider::requestErrorDetail(ex)), ex;
        }
        # a stream left before its end must not keep the server sending
        on_exit reader.cancel();

        int timeout_ms = getRequestTimeoutMs(opts);
        *hash<auto> terminal;
        hash<auto> stream_usage;
        *string served_service_tier;
        hash<auto!> structured_state = {"content": ""};
        int structured_bytes = 0;
        while (True) {
            *hash<SseMessageInfo> evt = reader.readEvent(
                remainingStreamTimeout(timeout_ms, request_deadline));
            if (!evt) {
                # the reader also returns nothing when the wait times out,
                # which must not be reported as a complete response
                if (!reader.isDone()) {
                    throw "LLM-ERROR", sprintf("streaming chat response "
                        "timed out: no event arrived within %d ms",
                        timeout_ms), {"err": "HTTPCLIENT-TIMEOUT"};
                }
                break;
            }
            if (evt.data == "[DONE]") {
                break;
            }

            *hash<auto> parsed;
            try {
                parsed = parse_json(evt.data);
            } catch () {
                continue;
            }

            if (parsed.usage.typeCode() == NT_HASH) {
                stream_usage = parsed.usage;
            }
            if (parsed.service_tier.typeCode() == NT_STRING) {
                served_service_tier = parsed.service_tier;
            }
            if (parsed.choices[0].finish_reason.val()) {
                terminal = parsed;
            }

            if (strict_context.project) {
                # JSON member deletion cannot be expressed as an append-only
                # delta. Buffer adapted structured calls until their JSON is
                # complete, then emit one canonical delta before the terminal.
                structured_bytes += evt.data.length();
                if (structured_bytes > 16 * 1024 * 1024) {
                    throw "OPENAI-STRUCTURED-OUTPUT-ERROR",
                        "structured response exceeds the 16 MiB buffer limit";
                }
                updateOpenAiStreamStateFromRaw(\structured_state, parsed);
                getOpenAiToolCallDeltas(\structured_state, parsed);
                if (parsed.choices[0].delta.content.val()) {
                    structured_state.content += openAiContentText(parsed.choices[0].delta.content) ?? "";
                }
                if (parsed.choices[0].delta.refusal.val()) {
                    structured_state.refusal += parsed.choices[0].delta.refusal;
                }
                continue;
            }

            *string delta;
            if (parsed.choices[0].delta.content.val()) {
                delta = openAiContentText(parsed.choices[0].delta.content);
            }
            bool has_tool_call_delta =
                parsed.choices[0].delta.tool_calls.typeCode() == NT_LIST
                && parsed.choices[0].delta.tool_calls.size() > 0;
            # OpenAI-compatible providers normally emit function calls in
            # tool-call-only deltas. Dropping a chunk merely because it has no
            # text loses the function name/argument stream and makes the final
            # response look like a clean no-call completion to every caller.
            # The usage of the response arrives in a chunk of its own after the
            # chunk with the finish reason, so the stream ends with "[DONE]" or
            # with the end of the response, not with the finish reason.
            if (delta.val() || has_tool_call_delta
                    || parsed.choices[0].delta.content.typeCode() == NT_LIST
                    || parsed.choices[0].finish_reason.val()
                    || parsed.usage.typeCode() == NT_HASH) {
                callback(<QoreLlmUtils::ChatStreamEvent>{
                    "event": evt.event,
                    "delta": delta,
                    "raw": parsed,
                });
            }
        }
        if (!strict_context.project) {
            if (!terminal) {
                throw "LLM-ERROR",
                    "streaming chat response ended without a terminal frame";
            }
            callback(<QoreLlmUtils::ChatStreamEvent>{"done": True});
            return;
        }
        hash<auto> final_raw = terminal ?? {};
        if (strict_context.project) {
            if (!terminal) {
                throw "OPENAI-STRUCTURED-OUTPUT-ERROR",
                    "structured response stream ended without a terminal frame";
            }
            hash<auto> response = restoreStrictResponse({
                "choices": ({
                    "finish_reason": terminal.choices[0].finish_reason,
                    "message": {"content": structured_state.content,
                        "refusal": structured_state.refusal,
                        "tool_calls": structured_state.tool_calls},
                },),
            }, strict_context);
            hash<auto!> delta = {};
            if (response.choices[0].message.content.val()) {
                delta.content = response.choices[0].message.content;
            }
            if (response.choices[0].message.refusal.val()) {
                delta.refusal = response.choices[0].message.refusal;
            }
            if (response.choices[0].message.tool_calls) {
                list<auto> calls = ();
                int index = 0;
                foreach hash<auto> call in (response.choices[0].message.tool_calls) {
                    call."index" = index++;
                    calls += call;
                }
                delta.tool_calls = calls;
            }
            if (delta) {
                callback(<QoreLlmUtils::ChatStreamEvent>{
                    "delta": delta.content,
                    "raw": {"id": structured_state.id,
                        "model": structured_state.model,
                        "choices": ({"index": 0, "delta": delta,
                            "finish_reason": NOTHING},)},
                });
            }
        }
        if (stream_usage) {
            final_raw.usage = stream_usage;
        }
        if (structured_state.reasoning_blocks) {
            final_raw.reasoning_blocks = structured_state.reasoning_blocks;
        }
        if (served_service_tier.typeCode() == NT_STRING) {
            final_raw.service_tier = served_service_tier;
        }
        # Deltas from the terminal frame were already emitted above.
        if (final_raw.choices[0].delta) {
            final_raw.choices[0].delta = {};
        }
        callback(<QoreLlmUtils::ChatStreamEvent>{
            "done": True, "raw": final_raw,
        });
    }

    #! Returns True if a streaming request asks the server for the usage of the response
    /** OpenAI-compatible servers report the token usage of a streamed response only
        when \c stream_options.include_usage is requested, so token accounting and
        telemetry are empty without it.  A server that rejects the option is handled
        by overriding this method, or by setting \c stream_options in
        @ref QoreLlmUtils::LlmRequestOptions::body_options.

        @return @ref True unless a subclass disables the option
    */
    bool streamIncludesUsage() {
        return True;
    }

    #! Returns an exception description with the error message of the provider's error response
    /** OpenAI-compatible servers report errors as \c {"error": {"message": ...}}
        or \c {"message": ...}

        @param ex the exception raised by the request

        @return \a ex.desc, followed by the provider's error message when the
        response contains one
    */
    private static string requestErrorDetail(hash<ExceptionInfo> ex) {
        auto body = ex.arg.typeCode() == NT_HASH ? ex.arg.body : NOTHING;
        if (body.typeCode() == NT_BINARY) {
            body = body.toString("UTF-8");
        }
        if (body.typeCode() == NT_STRING && body =~ /^\s*\{/) {
            try {
                body = parse_json(body);
            } catch () {
            }
        }
        *string msg;
        if (body.typeCode() == NT_HASH) {
            switch (body.error.typeCode()) {
                case NT_HASH:
                    msg = body.error.message;
                    break;
                case NT_STRING:
                    msg = body.error;
                    break;
            }
            if (!msg.val() && body.message.typeCode() == NT_STRING) {
                msg = body.message;
            }
        }
        return msg.val() ? sprintf("%s: %s", ex.desc, msg) : ex.desc;
    }

    #! Explicit call deadlines cover the whole stream, not a fresh wait per chunk
    private static int remainingStreamTimeout(int timeout_ms, *date deadline) {
        if (!deadline) { return timeout_ms; }
        int remaining = (deadline - now_us()).durationMilliseconds();
        if (remaining <= 0) {
            throw "LLM-ERROR", "streaming request deadline exhausted",
                {"err": "HTTPCLIENT-TIMEOUT"};
        }
        return min(timeout_ms, remaining);
    }

    #! Returns headers with the OpenAI \c Authorization: \c Bearer credential
    private *hash<auto> buildAuthHeader() {
        *hash<auto> hdr;
        if (getConfig().api_key.val()) {
            hdr."Authorization" = "Bearer " + getConfig().api_key;
        }
        return hdr;
    }

    #! Lazy-initializes the underlying REST client
    private ensureRestClient() {
        if (!rest_client) {
            rest_mutex.lock();
            on_exit rest_mutex.unlock();
            if (!rest_client) {
                hash<auto!> opts = {
                    "url": getConfig().url,
                    "connect_timeout": getConfig().connect_timeout_ms,
                    "timeout": getConfig().timeout_ms,
                    "data": "json",
                };
                if (getConfig().protocol.val()) {
                    opts.protocol = getConfig().protocol;
                }
                rest_client = new RestClientIo::RestClientIo(opts);
            }
        }
    }

    #! Builds an OpenAI-shaped chat-completions request body
    private hash<auto> buildOpenAiChatBody(
            list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        list<hash<auto>> api_messages = ();
        foreach hash<QoreLlmUtils::ChatMessage> msg in (messages) {
            hash<auto!> api_msg();
            api_msg.role = msg.role;
            if (msg.content_parts) {
                list<auto> parts = ();
                foreach hash<QoreLlmUtils::ContentPart> part in (msg.content_parts) {
                    if (part.type == "image" && part.data) {
                        string b64 = make_base64_string(part.data);
                        push parts, {
                            "type": "image_url",
                            "image_url": {
                                "url": sprintf("data:%s;base64,%s",
                                    part.mime_type ?? "image/png", b64),
                            },
                        };
                    } else if (part.type == "file" && part.data) {
                        string b64 = make_base64_string(part.data);
                        push parts, {
                            "type": "file",
                            "file": {
                                "filename": part.filename ?? "attachment",
                                "file_data": sprintf("data:%s;base64,%s",
                                    part.mime_type ?? "application/octet-stream",
                                    b64),
                            },
                        };
                    } else if (part.type == "text" && part.text.val()) {
                        push parts, {"type": "text", "text": part.text};
                    }
                }
                api_msg.content = parts;
            } else if (msg.content.val()) {
                api_msg.content = msg.content;
            }
            if (msg.tool_calls) {
                list<auto> tc_list = ();
                foreach hash<QoreLlmUtils::ChatToolCall> tc in (msg.tool_calls) {
                    push tc_list, {
                        "id": tc.id,
                        "type": "function",
                        "function": {
                            "name": tc.name,
                            "arguments": make_json(tc.arguments ?? {}),
                        },
                    };
                }
                api_msg.tool_calls = tc_list;
            }
            if (msg.tool_call_id.val()) {
                api_msg.tool_call_id = msg.tool_call_id;
            }
            if (msg.name.val() && msg.role == "tool") {
                api_msg.name = msg.name;
            }
            push api_messages, api_msg;
        }

        hash<auto> body = {
            "messages": api_messages,
            "temperature": getRequestTemperature(opts),
        };
        *string request_model = getRequestModel(opts);
        if (request_model.val()) {
            body.model = request_model;
        }
        body = applyOpenAiOutputTokenBudget(body, opts);
        if (tools) {
            list<auto> tool_defs = ();
            foreach hash<QoreLlmUtils::ToolDefinition> td in (tools) {
                hash<auto> tool = {
                    "type": "function",
                    "function": {
                        "name": td.name,
                        "description": td.description ?? "",
                        "parameters": td.parameters
                            ?? {"type": "object", "properties": {}},
                    },
                };
                if (exists td.strict) {
                    tool.function.strict = td.strict;
                }
                push tool_defs, tool;
            }
            body.tools = tool_defs;
        }
        if (opts.output_schema) {
            body.response_format = {
                "type": "json_schema",
                "json_schema": {"name": opts.output_schema.name ?? "output",
                    "strict": True, "schema": opts.output_schema},
            };
        }
        return finalizeOpenAiRequestBody(body, opts);
    }

    #! Compiles strict schemas and keeps restoration metadata off the wire
    private static hash<auto> prepareStrictRequest(hash<auto> body) {
        hash<auto!> rv = {"tools": {}, "project": False};
        if (body.response_format.type == "json_schema"
                && body.response_format.json_schema.strict == True) {
            OpenAiStrictOutputSchema schema(body.response_format.json_schema.schema);
            body.response_format.json_schema.schema = schema.getSchema();
            rv.response_schema = schema;
            rv.project = schema.needsProjection();
        }
        if (body.tools.typeCode() == NT_LIST) {
            list<auto> tools = ();
            foreach hash<auto> tool in (body.tools) {
                if (tool.type == "function" && tool.function.strict == True) {
                    OpenAiStrictOutputSchema schema(tool.function.parameters
                        ?? {"type": "object", "properties": {}});
                    tool.function.parameters = schema.getSchema();
                    rv.tools{tool.function.name} = schema;
                    rv.project = rv.project || schema.needsProjection();
                }
                tools += tool;
            }
            body.tools = tools;
        }
        rv.body = body;
        return rv;
    }

    #! Restores optional fields only in complete structured outputs
    private static hash<auto> restoreStrictResponse(hash<auto> response,
            hash<auto> schema_context) {
        if (!schema_context.project || response.choices.typeCode() != NT_LIST) {
            return response;
        }
        list<auto> choices = ();
        foreach hash<auto> choice in (response.choices) {
            # Refusals and truncated JSON retain the provider's failure shape.
            if ((choice.finish_reason == "stop" || choice.finish_reason == "tool_calls")
                    && !choice.message.refusal.val()) {
                if (schema_context.response_schema && choice.message.content.val()) {
                    string restored = schema_context.response_schema.restoreJson(
                        openAiContentText(choice.message.content) ?? "");
                    if (choice.message.content.typeCode() == NT_LIST) {
                        # Keep native reasoning for replay while projecting the
                        # complete visible JSON, even when text spans blocks.
                        list<auto> parts = ();
                        bool wrote_text = False;
                        foreach auto part in (choice.message.content) {
                            if (part.typeCode() == NT_HASH && part.type == "text") {
                                if (wrote_text) {
                                    continue;
                                }
                                part.text = restored;
                                wrote_text = True;
                            }
                            push parts, part;
                        }
                        choice.message.content = parts;
                    } else {
                        choice.message.content = restored;
                    }
                }
                if (choice.message.tool_calls.typeCode() == NT_LIST) {
                    list<auto> calls = ();
                    foreach hash<auto> call in (choice.message.tool_calls) {
                        if (schema_context.tools{call.function.name}) {
                            call.function.arguments = schema_context.tools{call.function.name}
                                .restoreJson(call.function.arguments);
                        }
                        calls += call;
                    }
                    choice.message.tool_calls = calls;
                }
            }
            choices += choice;
        }
        response.choices = choices;
        return response;
    }

    #! Preserves reasoning controls and avoids unsupported sampling defaults
    private hash<auto> finalizeOpenAiRequestBody(hash<auto> body,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        *string effort = getRequestReasoningEffort(opts);
        if (effort.val()) {
            body.reasoning_effort = effort;
        }
        body = mergeRequestBodyOptions(body, opts);
        if (body.model.val() && openAiModelUsesMaxCompletionTokens(body.model)
                && body.reasoning_effort != "none") {
            remove body.temperature;
        }
        return body;
    }

    #! Applies the provider-neutral output budget to OpenAI-compatible wire fields
    private hash<auto> applyOpenAiOutputTokenBudget(hash<auto> body,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        int budget = getRequestMaxOutputTokens(opts);
        *string model_id = body.model ?? getRequestModel(opts);
        if (model_id.val() && openAiModelUsesMaxCompletionTokens(model_id)) {
            body.max_completion_tokens = budget;
        } else {
            body.max_tokens = budget;
        }
        return body;
    }

    #! True for OpenAI model families that require max_completion_tokens
    private static bool openAiModelUsesMaxCompletionTokens(string model_id) {
        string lower = regex_subst(model_id.lwr(), "^models/", "");
        if (lower =~ /^gpt-[56]/) {
            return True;
        }
        if (lower =~ /^o[0-9]/) {
            return True;
        }
        return False;
    }

    #! Extracts visible text without rendering provider reasoning or other content blocks
    private static *string openAiContentText(auto content) {
        if (content.typeCode() == NT_STRING) {
            return content;
        }
        if (content.typeCode() != NT_LIST) {
            return NOTHING;
        }
        string text;
        foreach auto part in (content) {
            if (part.typeCode() == NT_HASH && part.type == "text"
                    && part.text.typeCode() == NT_STRING) {
                text += part.text;
            }
        }
        return text.val() ? text : NOTHING;
    }

    #! Parses an OpenAI-shaped chat-completions response into a @ref QoreLlmUtils::ChatResponse
    private hash<QoreLlmUtils::ChatResponse> parseOpenAiChatResponse(
            hash<auto> response_data) {
        hash<auto> choice = response_data.choices[0];
        hash<auto> msg = choice.message;

        string stop_reason;
        switch (choice.finish_reason) {
            case "stop":
                stop_reason = "end_turn";
                break;
            case "tool_calls":
                stop_reason = "tool_use";
                break;
            case "length":
                stop_reason = "max_tokens";
                break;
            default:
                stop_reason = choice.finish_reason ?? "end_turn";
        }

        *list<hash<QoreLlmUtils::ChatToolCall>> parsed_tool_calls;
        # A terminal output limit or content filter can leave even the first
        # argument object unfinished.  Preserve status, usage and raw evidence
        # without exposing any calls from this incomplete response for execution.
        if (msg.tool_calls && choice.finish_reason != "length"
                && choice.finish_reason != "content_filter") {
            parsed_tool_calls = ();
            foreach hash<auto> tc in (msg.tool_calls) {
                *hash<auto> args;
                if (tc.function.arguments.val()) {
                    if (tc.function.arguments.typeCode() == NT_STRING) {
                        args = parse_json(tc.function.arguments);
                    } else {
                        args = tc.function.arguments;
                    }
                }
                push parsed_tool_calls, <QoreLlmUtils::ChatToolCall>{
                    "id": tc.id,
                    "name": tc.function.name,
                    "arguments": args,
                };
            }
        }

        return <QoreLlmUtils::ChatResponse>{
            "id": response_data.id,
            "model": response_data.model,
            "stop_reason": stop_reason,
            "content": openAiContentText(msg.content),
            "tool_calls": parsed_tool_calls,
            "usage": response_data.usage ?? {},
            "raw": response_data,
        };
    }
}

#! Factory for @ref OpenAiLlmProvider
public class OpenAiLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "http";
    }

    string getDisplayName() {
        return "OpenAI-compatible chat completions";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new OpenAiLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
        };
    }
}
}

public namespace QoreRagUtils {
#! OpenAI-backed embedder — calls the OpenAI \c /embeddings endpoint
/** Wraps @ref OpenAiRestClient::OpenAiRestClientIo "OpenAiRestClientIo" for
    async-capable HTTP calls.

    @par Configuration

    - \c api_key (required): OpenAI API key; passed via the \c token option
    - \c url (optional): override the default OpenAI URL
    - \c model (optional): model name, default \c "text-embedding-3-small"
    - \c dimension (optional): forwarded as the \c dimensions request
      parameter; when unset the dimension is auto-detected on first call
    - \c timeout (optional): default request timeout (per-call \c opts override
      takes precedence)
    - \c connect_timeout (optional): default connection timeout (per-call
      \c opts override takes precedence)
*/
public class OpenAiEmbedder inherits AbstractEmbedder {
    public {
        #! Default model name
        const DefaultModel = "text-embedding-3-small";

        #! Backend identifier reported in @c EMBEDDER-MODEL-CONFIG-ERROR
        const Backend = "openai";
    }

    private {
        #! Captured configuration
        hash<EmbedderConfig> config;
        #! Resolved model name (never empty)
        string model_name;
        #! Lazily-created REST client
        *OpenAiRestClient::OpenAiRestClientIo rest_client;
        #! Cached embedding dimension (from config or auto-detected)
        *int cached_dimension;
        #! Guard for lazy initialization
        Mutex init_mutex();
    }

    #! Creates the embedder
    /** @param config embedder configuration; \c api_key must be set

        @throw EMBEDDER-CONFIG-ERROR if required fields are missing
    */
    constructor(hash<EmbedderConfig> config) {
        if (!config.api_key.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "OpenAiEmbedder requires 'api_key' in EmbedderConfig";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    #! Encodes a single piece of text into a vector
    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    #! Encodes a batch of texts into vectors
    /** @param texts input texts
        @param opts optional per-call overrides; recognized keys:
        - \c timeout (\c *timeout) — request timeout
        - \c connect_timeout (\c *timeout) — connection timeout

        @throw EMBEDDER-RESPONSE-ERROR if the response is missing data, has
        a vector count mismatch, contains an empty vector, or contains
        non-numeric vector elements
        @throw EMBEDDER-MODEL-CONFIG-ERROR if the backend reports a permanent
        model/configuration failure (see @ref isPermanentEmbedderConfigError())
        @throw REST-RESPONSE-ERROR for transient infrastructure failures
        (5xx, rate limits, network)
    */
    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }

        hash<auto> body = {
            "model": model_name,
            "input": texts,
        };
        if (exists cached_dimension) {
            body.dimensions = cached_dimension;
        }

        hash<auto> resp;
        try {
            resp = pickRestClient(opts).restPost("/embeddings", body);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "REST-RESPONSE-ERROR" && isPermanentEmbedderConfigError(ex)) {
                throwEmbedderModelConfigError(ex, Backend, model_name);
            }
            rethrow;
        }

        # sort by index to align with input order
        *list<auto> data = resp.body.data;
        if (!exists data) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing 'data' field", Backend),
                {"body": resp.body};
        }
        if (data.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned %d items for %d input texts",
                    Backend, data.size(), texts.size()),
                {"body": resp.body};
        }
        list<hash<auto>> sorted_data = sort(cast<list<hash<auto>>>(data),
            int sub(hash<auto> a, hash<auto> b) {
                return a."index" <=> b."index";
            });

        list<list<float>> result = ();
        foreach hash<auto> item in (sorted_data) {
            list<float> vec = validateAndCastVector(item.embedding, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = vec.size();
            }
            push result, vec;
        }
        return result;
    }

    #! Returns the embedding dimension produced by this backend
    /** If the dimension was not provided in the config, performs a one-shot
        probe call and caches the result.
    */
    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    #! Returns the configured model name
    *string getModel() {
        return model_name;
    }

    #! Classifies an OpenAI \c REST-RESPONSE-ERROR as a permanent model/config failure
    /** Recognizes:
        - HTTP 400 / 404 with response body containing OpenAI's
          \c error.code or \c error.type indicating a model issue
          (\c model_not_found, \c invalid_request_error referencing the model)
        - HTTP 400 / 404 with response body containing keywords
          \c "model" + (\c "not found" | \c "does not exist" | \c "invalid" |
          \c "is not an embedding" | \c "does not support embeddings")
    */
    private bool isPermanentEmbedderConfigError(hash<ExceptionInfo> ex) {
        *int status_code = ex.arg.status_code;
        if (status_code != 400 && status_code != 404) {
            return False;
        }
        auto body = ex.arg.body;
        *string code = body.error.code;
        if (code == "model_not_found" || code == "invalid_model") {
            return True;
        }
        *string error_type = body.error.type;
        *string message = body.error.message ?? body.message ?? body.detail;
        if (!exists message && body.typeCode() == NT_STRING) {
            message = body;
        }
        if (!exists message) {
            return False;
        }
        string lower = message.lwr();
        if (lower.find("model") == -1) {
            return False;
        }
        return lower.find("not found") != -1
            || lower.find("does not exist") != -1
            || lower.find("invalid model") != -1
            || lower.find("unsupported model") != -1
            || lower.find("is not an embedding") != -1
            || lower.find("does not appear to be an embedding") != -1
            || lower.find("does not support embeddings") != -1
            || error_type == "invalid_request_error";
    }

    #! Validates an embedding vector value and casts to \c list<float>
    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response item missing 'embedding' field", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    #! Returns a REST client suitable for this call
    /** When \c opts provides per-call \c timeout or \c connect_timeout, a
        transient REST client is built so the override does not leak into
        other concurrent calls.  Otherwise the cached client is returned.
    */
    private OpenAiRestClient::OpenAiRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new OpenAiRestClient::OpenAiRestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    #! Builds the constructor option hash for the underlying REST client
    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "token": config.api_key,
        };
        if (config.url.val()) {
            opts.url = config.url;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    #! Ensures the cached REST client is initialized with config defaults
    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new OpenAiRestClient::OpenAiRestClientIo(buildRestOptions());
            }
        }
    }
}

#! Factory for @ref OpenAiEmbedder
public class OpenAiEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "openai";
    }

    string getDisplayName() {
        return "OpenAI embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new OpenAiEmbedder(config);
    }
}
}
