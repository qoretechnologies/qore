# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires HttpClientStreamingIo
%requires QoreLlmTypes
%requires QoreRagTypes

module OpenAiRestClient {
    version = "1.1";
    desc = "user module for calling OpenAi REST API services";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("openai", OpenAiRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(new OpenAiLlmProviderFactory());
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new QoreRagUtils::OpenAiEmbedderFactory());
    };
}

/** @mainpage OpenAiRestClient Module

    @tableofcontents

    @section openairestclientintro OpenAiRestClient Introduction

    The %OpenAiRestClient module provides an API for calling OpenAi REST API services.

    To use this module, use \c "%requires OpenAiRestClient" in your code.

    All the public symbols in the module are defined in the OpenAiRestClient namespace.

    The main classes are:
    - @ref OpenAiRestClient::OpenAiRestClient "OpenAiRestClient":
      this class provides the REST client API for communuication with the OpenAi REST
      API; it also automates authentication and authorization to the target
    - @ref OpenAiRestClient::OpenAiRestConnection "OpenAiRestConnection":
      provides a REST connection object to OpenAi cloud services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires OpenAiRestClient
%requires ConnectionProvider

OpenAiRestClient rest = get_connection("my-openai-connection");
hash<auto> ans = rest.get("/calendar/users/me/calendarList");
printf("%Y\n", ans.body);
    @endcode

    @par Streaming Example:
    @code{.py}
OpenAiRestClient rest = get_connection("my-openai-connection");
OpenAiResponseSseStream stream = rest.openResponsesStream({
    "model": "gpt-4o-mini",
    "stream": True,
    "input": (
        {
            "input_item": {
                "role": "user",
                "content": (
                    {
                        "type": "input_text",
                        "text": "Stream a response",
                    },
                ),
            },
        },
    ),
});
while (hash<SseMessageInfo> evt = stream.readEvent(5s)) {
    if (evt.data == "[DONE]") {
        break;
    }
    printf("%s\n", evt.data);
}
stream.close();
    @endcode

    @section OpenAiRestClientRelnotes Release Notes

    @subsection OpenAiRestClientv1_1 OpenAiRestClient v1.1
    - added SSE helper for streaming responses

    @subsection OpenAiRestClientv1_0 OpenAiRestClient v1.0
    - the initial version of the %OpenAiRestClient module
*/

%try-module json
%define NoJson
%endtry

#! the OpenAiRestClient namespace contains all the objects in the OpenAiRestClient module
public namespace OpenAiRestClient {
#! Common base class for OpenAiRestClient functionality
public class OpenAiRestClientBase {
    public {
        #! Default OpenAi REST API URL
        const DefaultUrl = "https://api.openai.com";

        #! Default OpenAi API version
        const DefaultApiVersion = "v1";

        #! Default embedding model
        const DefaultEmbeddingModel = "text-embedding-3-small";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    #! returns options for @ref OpenAiRestClient::OpenAiRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        if (!opts.swagger && !opts.validator && opts.use_schema) {
            string path = dirname(get_module_hash().OpenAiRestClient.filename)
                + "/OpenAiDataProvider/openai-swagger-2.0.yaml";
            if (is_file(path)) {
                opts.swagger = path;
            }
        }
        remove opts{"embedding-model"};
        return DefaultOptions + opts;
    }
}

#! this class provides the REST client API for communication with OpenAi servers
/** You must use an API key in the 'token' option to call OpenAi APIs
*/
public class OpenAiRestClient inherits RestClient::RestClient, OpenAiRestClientBase {
    private {
        #! The API version in use
        string api;
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
OpenAiRestClient rest(opts);
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class; note
        that the URL is set by default if not provided (see @ref DefaultUrl)
        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(OpenAiRestClientBase::getOptions(opts), True) {
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(getString(opts, "api") ?? DefaultApiVersion);
        }
    }

    #! Opens a Server-Sent Events stream for responses
    OpenAiResponseSseStream openResponsesStream(hash<auto> req, *hash<auto> hdr, *timeout to) {
        return new OpenAiResponseSseStream(self, "responses", req, hdr, to);
    }
}

#! SSE connection for OpenAI responses streams
public class OpenAiResponseSseStream {
    private {
        OpenAiRestClient rest;
        bool chunked;
        string content_encoding;
        StringOutputStream ostream;
        TransformOutputStream dstream;
        bool use_decompressor;
        timeout timeout_ms = 15s;
        bool closed;

        const SseMimeType = "text/event-stream";
    }

    #! Creates the stream connection
    constructor(OpenAiRestClient rest, string path, *auto body, *hash<auto> hdr, *timeout to) {
        self.rest = rest;
        if (to) {
            timeout_ms = to;
        }
        hash<auto> headers = rest.getDefaultHeaders() + (hdr ?? {});
        headers.Accept = SseMimeType;
        data payload;
        if (exists body) {
            payload = getSerializedBody(body, \headers);
        }
        string full_path = buildPath(path);
        hash<auto> info;
        hash<auto> resp = rest.send(payload, "POST", full_path, headers, False, \info);
        if (resp.status_code != 200) {
            throw "SSE-ERROR", sprintf("unexpected status code %d %s", resp.status_code, resp.status_message);
        }
        string content_type = normalizeContentType(resp."content-type");
        if (content_type != SseMimeType) {
            throw "SSE-ERROR", sprintf("expected Content-Type %y but got %y", SseMimeType, resp."content-type");
        }
        if (resp."content-encoding".val()) {
            content_encoding = tolower(resp."content-encoding");
        }
        if (resp."transfer-encoding".val()) {
            string transfer_encoding = tolower(resp."transfer-encoding");
            if (transfer_encoding == "chunked") {
                chunked = True;
            } else {
                throw "SSE-ERROR", sprintf("unsupported Transfer-Encoding: %y", resp."transfer-encoding");
            }
        }
        setupDecompression();
    }

    #! Reads the next SSE message
    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (closed) {
            return;
        }
        timeout use_to = to ?? timeout_ms;
        if (chunked) {
            hash<auto> hh = rest.readHTTPChunk(use_to);
            if (!hh.body) {
                return;
            }
            if (use_decompressor) {
                dstream.write(hh.body);
            } else {
                ostream.write(hh.body);
            }
            return rest.parseServerSentEvent(ostream.getData());
        }
        return rest.readServerSentEvent(content_encoding, use_to);
    }

    #! Closes the stream connection
    close() {
        if (!closed) {
            closed = True;
            rest.disconnect();
        }
    }

    private string buildPath(string path) {
        string rv = path;
        rv =~ s/^\/+//;
        rv = "/" + rv;
        *string base = rest.getConnectionPath();
        if (base.val() && base != "/") {
            base =~ s/\/+$//;
            if (base !~ /^\//) {
                base = "/" + base;
            }
            rv = base + rv;
        }
        *string defp = rest.getDefaultPath();
        if (defp.val() && defp != "/") {
            defp =~ s/\/+$//;
            if (defp !~ /^\//) {
                defp = "/" + defp;
            }
            rv = defp + rv;
        }
        return rv;
    }

    private data getSerializedBody(data body, reference<hash<auto>> headers) {
        if (body.typeCode() == NT_STRING) {
            if (!headers."Content-Type") {
                headers."Content-Type" = "application/json";
            }
            return body;
        }
%ifdef NoJson
        throw "SSE-ERROR", "json module is required to serialize SSE request body";
%else
        if (!headers."Content-Type") {
            headers."Content-Type" = "application/json";
        }
        return call_function_args("to_json", (body,));
%endif
    }

    private setupDecompression() {
        if (!chunked) {
            return;
        }
        ostream = new StringOutputStream();
        Transform decompressor;
        switch (content_encoding) {
            case "deflate":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_ZLIB);
                break;
            case "gzip":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_GZIP);
                break;
            case "bzip2":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_BZIP2);
                break;
            case NOTHING:
            case "identity":
                use_decompressor = False;
                break;

            default:
                throw "ENCODING-ERROR", sprintf("Don't know how to handle Content-Encoding %y", content_encoding);
        }
        if (use_decompressor) {
            dstream = new TransformOutputStream(ostream, decompressor);
        }
    }

    private static string normalizeContentType(*string content_type) {
        if (!content_type.val()) {
            return "";
        }
        string rv = content_type;
        rv =~ s/\s*;.*$//;
        rv =~ s/^\s+//;
        rv =~ s/\s+$//;
        return tolower(rv);
    }
}

#! Class for OpenAi REST connections; returns @ref OpenAiRestClient objects
/** This class implements all options of \c RestClient::RestConnection "RestClientConnection"

    @see @ref OpenAiRestClient::OpenAiRestClient::constructor() for more information on the above options
*/
public class OpenAiRestConnection inherits RestClient::RestConnection {
    public {
        #! Default OpenAi REST API URL
        const DefaultUrl = "openai://api.openai.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "OpenAi REST Connection",
            "short_desc": "A connection to the OpenAi REST API",
            "desc": "A connection to the OpenAi REST API",
            "cls": Class::forName("OpenAiRestConnection"),
            "auto_url": True,
            "schemes": {
                "openai": True,
            },
            "base_scheme_map": {
                "https": "openai",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "The API version to use",
                    "desc": "The API version to use",
                    "type": "string",
                    "default_value": OpenAiRestClientBase::DefaultApiVersion,
                },
                "use_schema": <ConnectionOptionInfo>{
                    "display_name": "Use OpenAPI Schema",
                    "short_desc": "Use the OpenAPI schema for API validation",
                    "desc": "Use the OpenAPI schema for API validation; OpenAI can change the schema at any time, so "
                        "the schema may be out of date and may cause valid API calls to fail",
                    "type": "bool",
                    "default_value": False,
                },
                "embedding-model": <ConnectionOptionInfo>{
                    "display_name": "Embedding Model",
                    "short_desc": "OpenAI embedding model name",
                    "desc": "The OpenAI embedding model used by embedding clients when this "
                        "connection is selected for embeddings",
                    "type": "string",
                    "default_value": OpenAiRestClientBase::DefaultEmbeddingModel,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": DefaultPingPath,
                },
            },
            "required_options": "token",
        };

        #! Default OpenAi ping method
        const DefaultPingMethod= "GET";

        #! Default OpenAi ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OpenAi ping path
        const DefaultPingPath = "models";
    }

    #! creates the OpenAiRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the OpenAiRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! returns \c "openai"
    string getType() {
        return "openai";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the \c getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the OpenAiDataProvider and creates the data provider
        # object dynamically
        load_module("OpenAiDataProvider");
        return create_object("OpenAiDataProvider", getAsync());
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != DefaultUrl) {
                update.url = DefaultUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! returns a @ref OpenAiRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref OpenAiRestClient object
    */
    private OpenAiRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new OpenAiRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since OpenAiRestClient 1.2
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new OpenAiRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for OpenAi REST API using multiplexed HTTP connections
/** @see OpenAiRestClient for more information
*/
public class OpenAiRestClientIo inherits RestClientIo::RestClientIo, OpenAiRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(OpenAiRestClientBase::getOptions(opts), shared_mgr) {
    }

    #! Opens a Server-Sent Events stream for responses using async I/O
    /** Uses HttpClientIo and SseStreamReader for incremental SSE event delivery
        across HTTP/1.x, HTTP/2, and HTTP/3.

        @param req the request body (will be serialized to JSON)
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading

        @return an SSE stream object for reading events incrementally

        @par Example:
        @code{.py}
OpenAiRestClientIo rest({"url": "https://api.openai.com", "token": api_key, "data": "json"});
OpenAiResponseSseStreamIo stream = rest.openResponsesStream({
    "model": "gpt-4o-mini",
    "stream": True,
    "input": ({"role": "user", "content": "Hello!"},),
});
while (*hash<SseMessageInfo> evt = stream.readEvent()) {
    printf("Event: %y\n", evt.data);
}
        @endcode
    */
    OpenAiResponseSseStreamIo openResponsesStream(hash<auto> req, *hash<auto> hdr, *timeout to) {
        return new OpenAiResponseSseStreamIo(self, "responses", req, hdr, to);
    }
}

#! SSE stream for OpenAI responses using async I/O (HttpClientIo + SseStreamReader)
/** Works across HTTP/1.x, HTTP/2, and HTTP/3 via HttpClientIo's multiplexed
    connection manager.

    @note This class is \b not thread-safe.  Use from a single reader thread.
*/
public class OpenAiResponseSseStreamIo {
    private {
        #! SSE stream reader
        HttpClientStreamingIo::SseStreamReader reader;

        #! Timeout for SSE event reading
        timeout timeout_ms = 15s;

        #! True when the stream has been closed
        bool closed = False;
    }

    #! Creates the SSE stream connection
    /** @param rest the OpenAiRestClientIo instance
        @param path the API endpoint path (e.g., "responses")
        @param body the request body (serialized to JSON)
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading
    */
    constructor(OpenAiRestClientIo rest, string path, *auto body, *hash<auto> hdr, *timeout to) {
        if (to) {
            timeout_ms = to;
        }
        hash<auto> headers = rest.getDefaultHeaders() + (hdr ?? {});
        headers.Accept = "text/event-stream";

        # Serialize body to JSON
        *data payload;
        if (exists body) {
%ifdef NoJson
            throw "SSE-ERROR", "json module is required to serialize SSE request body";
%else
            if (body.typeCode() != NT_STRING) {
                if (!headers."Content-Type") {
                    headers."Content-Type" = "application/json";
                }
                payload = call_function_args("to_json", (body,));
            } else {
                if (!headers."Content-Type") {
                    headers."Content-Type" = "application/json";
                }
                payload = body;
            }
%endif
        }

        # Build full path
        string full_path = buildPath(rest, path);

        # Acquire stream and start SSE streaming
        HttpClientIo::HttpClientConnectionManager mgr = rest.getConnectionManager();
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(rest.getUrl());
        stream.startStreaming("POST", full_path, headers, False, payload);

        reader = new HttpClientStreamingIo::SseStreamReader(stream);
    }

    #! Reads the next SSE event
    /** @param to optional timeout override
        @return the parsed SSE event, or NOTHING on timeout or stream end
    */
    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (closed) {
            return NOTHING;
        }
        return reader.readEvent(to ?? timeout_ms);
    }

    #! Returns True if the stream has ended
    bool isDone() {
        return closed || reader.isDone();
    }

    #! Closes the stream
    close() {
        if (!closed) {
            closed = True;
            reader.cancel();
        }
    }

    #! Builds the full API path from connection path + relative path
    private static string buildPath(RestClientIo::RestClientIo rest, string path) {
        string rv = path;
        rv =~ s/^\/+//;
        rv = "/" + rv;
        *string base = rest.getConnectionPath();
        if (base.val() && base != "/") {
            base =~ s/\/+$//;
            if (base !~ /^\//) {
                base = "/" + base;
            }
            rv = base + rv;
        }
        return rv;
    }
}

#! LLM provider that dispatches to OpenAI-compatible \c /v1/chat/completions endpoints
/** Implements the @ref QoreLlmUtils::AbstractLlmProvider contract for any
    backend that speaks the OpenAI chat-completions wire format (OpenAI,
    Azure OpenAI, vLLM, SGLang via @ref SGLangLlmProvider, any compatible
    gateway).  Owns its own @ref RestClientIo::RestClientIo and uses the
    standard \c Authorization: \c Bearer header for authentication.

    The provider's default OpenAI-facade hooks (inherited from
    @ref QoreLlmUtils::AbstractLlmProvider) are sufficient because this
    provider already speaks OpenAI shape natively — no overrides needed
    for \c tool_choice, \c response_format, stream raw shape, or tool-call
    deltas.

    Thread-safe: the REST client is lazy-initialized behind a mutex.

    @par Reuse as the OpenAI-compatible base class

    This class is the reusable base for **any** OpenAI-compatible chat
    backend that speaks the OpenAI wire shape (\c messages, \c tools,
    \c response_format, \c usage, SSE \c data: deltas with \c [DONE]
    terminator) with \c Authorization: \c Bearer authentication.  Concrete
    subclasses register a distinct
    @ref QoreLlmUtils::AbstractLlmProviderFactory under a vendor-specific
    mode string and either inherit the default \c /v1/chat/completions
    endpoint or override @ref getChatCompletionsPath() to point at a
    vendor-specific URL.

    Existing in-repo subclasses:
    - @ref SGLangRestClient::SGLangLlmProvider — mode \c "sglang"
    - @ref GrokRestClient::GrokLlmProvider — mode \c "grok"
    - @ref PerplexityRestClient::PerplexityLlmProvider — mode \c "perplexity"
      (overrides @ref getChatCompletionsPath() since Perplexity's path is
      \c /chat/completions, not \c /v1/chat/completions)
*/
public class OpenAiLlmProvider inherits QoreLlmUtils::AbstractLlmProvider {
    private {
        #! Lazy-initialized REST client
        *RestClientIo::RestClientIo rest_client;
        #! Serializes lazy initialization
        Mutex rest_mutex();
    }

    #! Constructs the provider from an @ref QoreLlmUtils::LlmBackendConfig
    /** @param config the backend configuration; @ref QoreLlmUtils::LlmBackendConfig::url
            is required

        @throw LLM-CONFIG-ERROR \c url is missing
        @throw LLM-DEPENDENCY-ERROR the \c json module is not available
    */
    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : QoreLlmUtils::AbstractLlmProvider(config) {
        if (!config.url.val()) {
            throw "LLM-CONFIG-ERROR",
                sprintf("url is required for %y mode", getMode());
        }
%ifdef NoJson
        throw "LLM-DEPENDENCY-ERROR",
            "json module is required for HTTP mode but is not available";
%endif
    }

    string getMode() {
        return "http";
    }

    #! Returns the chat-completions endpoint path (subclass override hook)
    /** The default \c /v1/chat/completions matches OpenAI, xAI Grok,
        Together, Fireworks, Groq, DeepSeek, Mistral, Ollama, vLLM, and
        SGLang.  Backends that publish at a different path (e.g. Perplexity
        at \c /chat/completions) override this method.

        @return the URL path for chat-completions POST requests
    */
    string getChatCompletionsPath() {
        return "/v1/chat/completions";
    }

    hash<QoreLlmUtils::LlmCompletionResult> complete(string system_prompt,
            string user_prompt, *hash<auto> output_schema,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> body = {
            "messages": (
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt},
            ),
            "temperature": getRequestTemperature(opts),
        };
        *string request_model = getRequestModel(opts);
        if (request_model.val()) {
            body.model = request_model;
        }
        body = applyOpenAiOutputTokenBudget(body, opts);
        if (output_schema) {
            body.response_format = {
                "type": "json_schema",
                "json_schema": {
                    "name": output_schema.name ?? "output",
                    "strict": True,
                    "schema": output_schema,
                },
            };
        }
        body = mergeRequestBodyOptions(body, opts);

        hash<auto> resp;
        try {
            resp = withRetry(hash<auto> sub () {
                return rest_client.restPost(getChatCompletionsPath(), body,
                    buildAuthHeader());
            });
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR", sprintf("HTTP completion request failed: %s",
                ex.desc), ex;
        }

        return <QoreLlmUtils::LlmCompletionResult>{
            "content": resp.body.choices[0].message.content ?? "",
            "usage": resp.body.usage ?? {},
        };
    }

    hash<QoreLlmUtils::ChatResponse> chat(
            list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> body = buildOpenAiChatBody(messages, tools, opts);

        hash<auto> resp;
        try {
            resp = withRetry(hash<auto> sub () {
                return rest_client.restPost(getChatCompletionsPath(), body,
                    buildAuthHeader());
            });
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR", sprintf("chat request failed: %s",
                ex.desc), ex;
        }

        return parseOpenAiChatResponse(resp.body);
    }

    chatStream(list<hash<QoreLlmUtils::ChatMessage>> messages,
            code<nothing(hash<QoreLlmUtils::ChatStreamEvent>)> callback,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> body = buildOpenAiChatBody(messages, tools, opts);
        body.stream = True;

        hash<auto> hdr = {"Accept": "text/event-stream"};
        if (getConfig().api_key.val()) {
            hdr."Authorization" = "Bearer " + getConfig().api_key;
        }
        hdr."Content-Type" = "application/json";

        HttpClientIo::HttpClientConnectionManager mgr =
            rest_client.getConnectionManager();
        HttpClientIo::HttpClientStreamHandle stream =
            mgr.acquireStream(getConfig().url);

        string json_body = make_json(body);
        stream.startStreaming("POST", getChatCompletionsPath(), hdr, False,
            json_body);

        HttpClientStreamingIo::SseStreamReader reader(stream);

        while (True) {
            *hash<SseMessageInfo> evt = reader.readEvent(
                getConfig().timeout_ms);
            if (!evt) {
                callback(<QoreLlmUtils::ChatStreamEvent>{"done": True});
                break;
            }
            if (evt.data == "[DONE]") {
                callback(<QoreLlmUtils::ChatStreamEvent>{"done": True});
                break;
            }

            *hash<auto> parsed;
            try {
                parsed = parse_json(evt.data);
            } catch () {
                continue;
            }

            *string delta;
            if (parsed.choices[0].delta.content.val()) {
                delta = parsed.choices[0].delta.content;
            }
            if (parsed.choices[0].finish_reason.val()) {
                callback(<QoreLlmUtils::ChatStreamEvent>{
                    "done": True,
                    "delta": delta,
                    "raw": parsed,
                });
                break;
            }
            if (delta.val()) {
                callback(<QoreLlmUtils::ChatStreamEvent>{
                    "event": evt.event,
                    "delta": delta,
                    "raw": parsed,
                });
            }
        }
    }

    #! Returns headers with the OpenAI \c Authorization: \c Bearer credential
    private *hash<auto> buildAuthHeader() {
        *hash<auto> hdr;
        if (getConfig().api_key.val()) {
            hdr."Authorization" = "Bearer " + getConfig().api_key;
        }
        return hdr;
    }

    #! Lazy-initializes the underlying REST client
    private ensureRestClient() {
        if (!rest_client) {
            rest_mutex.lock();
            on_exit rest_mutex.unlock();
            if (!rest_client) {
                hash<auto!> opts = {
                    "url": getConfig().url,
                    "connect_timeout": getConfig().connect_timeout_ms,
                    "timeout": getConfig().timeout_ms,
                    "data": "json",
                };
                if (getConfig().protocol.val()) {
                    opts.protocol = getConfig().protocol;
                }
                rest_client = new RestClientIo::RestClientIo(opts);
            }
        }
    }

    #! Builds an OpenAI-shaped chat-completions request body
    private hash<auto> buildOpenAiChatBody(
            list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        list<hash<auto>> api_messages = ();
        foreach hash<QoreLlmUtils::ChatMessage> msg in (messages) {
            hash<auto!> api_msg();
            api_msg.role = msg.role;
            if (msg.content_parts) {
                list<auto> parts = ();
                foreach hash<QoreLlmUtils::ContentPart> part in (msg.content_parts) {
                    if (part.type == "image" && part.data) {
                        string b64 = make_base64_string(part.data);
                        push parts, {
                            "type": "image_url",
                            "image_url": {
                                "url": sprintf("data:%s;base64,%s",
                                    part.mime_type ?? "image/png", b64),
                            },
                        };
                    } else if (part.type == "file" && part.data) {
                        string b64 = make_base64_string(part.data);
                        push parts, {
                            "type": "file",
                            "file": {
                                "filename": part.filename ?? "attachment",
                                "file_data": sprintf("data:%s;base64,%s",
                                    part.mime_type ?? "application/octet-stream",
                                    b64),
                            },
                        };
                    } else if (part.type == "text" && part.text.val()) {
                        push parts, {"type": "text", "text": part.text};
                    }
                }
                api_msg.content = parts;
            } else if (msg.content.val()) {
                api_msg.content = msg.content;
            }
            if (msg.tool_calls) {
                list<auto> tc_list = ();
                foreach hash<QoreLlmUtils::ChatToolCall> tc in (msg.tool_calls) {
                    push tc_list, {
                        "id": tc.id,
                        "type": "function",
                        "function": {
                            "name": tc.name,
                            "arguments": make_json(tc.arguments ?? {}),
                        },
                    };
                }
                api_msg.tool_calls = tc_list;
            }
            if (msg.tool_call_id.val()) {
                api_msg.tool_call_id = msg.tool_call_id;
            }
            if (msg.name.val() && msg.role == "tool") {
                api_msg.name = msg.name;
            }
            push api_messages, api_msg;
        }

        hash<auto> body = {
            "messages": api_messages,
            "temperature": getRequestTemperature(opts),
        };
        *string request_model = getRequestModel(opts);
        if (request_model.val()) {
            body.model = request_model;
        }
        body = applyOpenAiOutputTokenBudget(body, opts);
        if (tools) {
            list<auto> tool_defs = ();
            foreach hash<QoreLlmUtils::ToolDefinition> td in (tools) {
                push tool_defs, {
                    "type": "function",
                    "function": {
                        "name": td.name,
                        "description": td.description ?? "",
                        "parameters": td.parameters
                            ?? {"type": "object", "properties": {}},
                    },
                };
            }
            body.tools = tool_defs;
        }
        return mergeRequestBodyOptions(body, opts);
    }

    #! Applies the provider-neutral output budget to OpenAI-compatible wire fields
    private hash<auto> applyOpenAiOutputTokenBudget(hash<auto> body,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        int budget = getRequestMaxOutputTokens(opts);
        *string model_id = body.model ?? getRequestModel(opts);
        if (model_id.val() && openAiModelUsesMaxCompletionTokens(model_id)) {
            body.max_completion_tokens = budget;
        } else {
            body.max_tokens = budget;
        }
        return body;
    }

    #! True for OpenAI model families that require max_completion_tokens
    private static bool openAiModelUsesMaxCompletionTokens(string model_id) {
        string lower = regex_subst(model_id.lwr(), "^models/", "");
        if (lower =~ /^gpt-5/) {
            return True;
        }
        if (lower =~ /^o[0-9]/) {
            return True;
        }
        return False;
    }

    #! Parses an OpenAI-shaped chat-completions response into a @ref QoreLlmUtils::ChatResponse
    private static hash<QoreLlmUtils::ChatResponse> parseOpenAiChatResponse(
            hash<auto> response_data) {
        hash<auto> choice = response_data.choices[0];
        hash<auto> msg = choice.message;

        string stop_reason;
        switch (choice.finish_reason) {
            case "stop":
                stop_reason = "end_turn";
                break;
            case "tool_calls":
                stop_reason = "tool_use";
                break;
            case "length":
                stop_reason = "max_tokens";
                break;
            default:
                stop_reason = choice.finish_reason ?? "end_turn";
        }

        *list<hash<QoreLlmUtils::ChatToolCall>> parsed_tool_calls;
        if (msg.tool_calls) {
            parsed_tool_calls = ();
            foreach hash<auto> tc in (msg.tool_calls) {
                *hash<auto> args;
                if (tc.function.arguments.val()) {
                    if (tc.function.arguments.typeCode() == NT_STRING) {
                        args = parse_json(tc.function.arguments);
                    } else {
                        args = tc.function.arguments;
                    }
                }
                push parsed_tool_calls, <QoreLlmUtils::ChatToolCall>{
                    "id": tc.id,
                    "name": tc.function.name,
                    "arguments": args,
                };
            }
        }

        return <QoreLlmUtils::ChatResponse>{
            "id": response_data.id,
            "model": response_data.model,
            "stop_reason": stop_reason,
            "content": msg.content,
            "tool_calls": parsed_tool_calls,
            "usage": response_data.usage ?? {},
            "raw": response_data,
        };
    }
}

#! Factory for @ref OpenAiLlmProvider
public class OpenAiLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "http";
    }

    string getDisplayName() {
        return "OpenAI-compatible chat completions";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new OpenAiLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
        };
    }
}
}

public namespace QoreRagUtils {
#! OpenAI-backed embedder — calls the OpenAI \c /embeddings endpoint
/** Wraps @ref OpenAiRestClient::OpenAiRestClientIo "OpenAiRestClientIo" for
    async-capable HTTP calls.

    @par Configuration

    - \c api_key (required): OpenAI API key; passed via the \c token option
    - \c url (optional): override the default OpenAI URL
    - \c model (optional): model name, default \c "text-embedding-3-small"
    - \c dimension (optional): forwarded as the \c dimensions request
      parameter; when unset the dimension is auto-detected on first call
    - \c timeout (optional): default request timeout (per-call \c opts override
      takes precedence)
    - \c connect_timeout (optional): default connection timeout (per-call
      \c opts override takes precedence)
*/
public class OpenAiEmbedder inherits AbstractEmbedder {
    public {
        #! Default model name
        const DefaultModel = "text-embedding-3-small";

        #! Backend identifier reported in @c EMBEDDER-MODEL-CONFIG-ERROR
        const Backend = "openai";
    }

    private {
        #! Captured configuration
        hash<EmbedderConfig> config;
        #! Resolved model name (never empty)
        string model_name;
        #! Lazily-created REST client
        *OpenAiRestClient::OpenAiRestClientIo rest_client;
        #! Cached embedding dimension (from config or auto-detected)
        *int cached_dimension;
        #! Guard for lazy initialization
        Mutex init_mutex();
    }

    #! Creates the embedder
    /** @param config embedder configuration; \c api_key must be set

        @throw EMBEDDER-CONFIG-ERROR if required fields are missing
    */
    constructor(hash<EmbedderConfig> config) {
        if (!config.api_key.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "OpenAiEmbedder requires 'api_key' in EmbedderConfig";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    #! Encodes a single piece of text into a vector
    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    #! Encodes a batch of texts into vectors
    /** @param texts input texts
        @param opts optional per-call overrides; recognized keys:
        - \c timeout (\c *timeout) — request timeout
        - \c connect_timeout (\c *timeout) — connection timeout

        @throw EMBEDDER-RESPONSE-ERROR if the response is missing data, has
        a vector count mismatch, contains an empty vector, or contains
        non-numeric vector elements
        @throw EMBEDDER-MODEL-CONFIG-ERROR if the backend reports a permanent
        model/configuration failure (see @ref isPermanentEmbedderConfigError())
        @throw REST-RESPONSE-ERROR for transient infrastructure failures
        (5xx, rate limits, network)
    */
    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }

        hash<auto> body = {
            "model": model_name,
            "input": texts,
        };
        if (exists cached_dimension) {
            body.dimensions = cached_dimension;
        }

        hash<auto> resp;
        try {
            resp = pickRestClient(opts).restPost("/embeddings", body);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "REST-RESPONSE-ERROR" && isPermanentEmbedderConfigError(ex)) {
                throwEmbedderModelConfigError(ex, Backend, model_name);
            }
            rethrow;
        }

        # sort by index to align with input order
        *list<auto> data = resp.body.data;
        if (!exists data) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing 'data' field", Backend),
                {"body": resp.body};
        }
        if (data.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned %d items for %d input texts",
                    Backend, data.size(), texts.size()),
                {"body": resp.body};
        }
        list<hash<auto>> sorted_data = sort(cast<list<hash<auto>>>(data),
            int sub(hash<auto> a, hash<auto> b) {
                return a."index" <=> b."index";
            });

        list<list<float>> result = ();
        foreach hash<auto> item in (sorted_data) {
            list<float> vec = validateAndCastVector(item.embedding, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = vec.size();
            }
            push result, vec;
        }
        return result;
    }

    #! Returns the embedding dimension produced by this backend
    /** If the dimension was not provided in the config, performs a one-shot
        probe call and caches the result.
    */
    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    #! Returns the configured model name
    *string getModel() {
        return model_name;
    }

    #! Classifies an OpenAI \c REST-RESPONSE-ERROR as a permanent model/config failure
    /** Recognizes:
        - HTTP 400 / 404 with response body containing OpenAI's
          \c error.code or \c error.type indicating a model issue
          (\c model_not_found, \c invalid_request_error referencing the model)
        - HTTP 400 / 404 with response body containing keywords
          \c "model" + (\c "not found" | \c "does not exist" | \c "invalid" |
          \c "is not an embedding" | \c "does not support embeddings")
    */
    private bool isPermanentEmbedderConfigError(hash<ExceptionInfo> ex) {
        *int status_code = ex.arg.status_code;
        if (status_code != 400 && status_code != 404) {
            return False;
        }
        auto body = ex.arg.body;
        *string code = body.error.code;
        if (code == "model_not_found" || code == "invalid_model") {
            return True;
        }
        *string error_type = body.error.type;
        *string message = body.error.message ?? body.message ?? body.detail;
        if (!exists message && body.typeCode() == NT_STRING) {
            message = body;
        }
        if (!exists message) {
            return False;
        }
        string lower = message.lwr();
        if (lower.find("model") == -1) {
            return False;
        }
        return lower.find("not found") != -1
            || lower.find("does not exist") != -1
            || lower.find("invalid model") != -1
            || lower.find("unsupported model") != -1
            || lower.find("is not an embedding") != -1
            || lower.find("does not appear to be an embedding") != -1
            || lower.find("does not support embeddings") != -1
            || error_type == "invalid_request_error";
    }

    #! Validates an embedding vector value and casts to \c list<float>
    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response item missing 'embedding' field", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    #! Returns a REST client suitable for this call
    /** When \c opts provides per-call \c timeout or \c connect_timeout, a
        transient REST client is built so the override does not leak into
        other concurrent calls.  Otherwise the cached client is returned.
    */
    private OpenAiRestClient::OpenAiRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new OpenAiRestClient::OpenAiRestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    #! Builds the constructor option hash for the underlying REST client
    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "token": config.api_key,
        };
        if (config.url.val()) {
            opts.url = config.url;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    #! Ensures the cached REST client is initialized with config defaults
    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new OpenAiRestClient::OpenAiRestClientIo(buildRestOptions());
            }
        }
    }
}

#! Factory for @ref OpenAiEmbedder
public class OpenAiEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "openai";
    }

    string getDisplayName() {
        return "OpenAI embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new OpenAiEmbedder(config);
    }
}
}
