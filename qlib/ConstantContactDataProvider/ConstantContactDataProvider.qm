# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) ConstantContactRestClient

module ConstantContactDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Constant Contact email marketing";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new ConstantContactDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ConstantContactDataProvider::AppName,
            "display_name": "Constant Contact",
            "short_desc": "Constant Contact email marketing platform",
            "desc": "Constant Contact is an email marketing platform for creating campaigns, "
                "managing contacts, and tracking engagement.\n\n"
                "This integration supports contacts, contact lists, tags, custom fields, "
                "segments, email campaigns, bulk activities, reports, and events.",
            "scheme": "constantcontactres",
            "logo": ConstantContactLogo,
            "logo_file_name": "constantcontact-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Email, DataProvider::AppGroup::Marketing),
        });

        # ========== CONTACT ACTIONS ==========

        # Create a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contacts/create",
            "action": "create-contact",
            "groups": "Contacts",
            "display_name": "Create a Contact",
            "short_desc": "Create a new contact",
            "desc": "Create a new contact in Constant Contact",
            "action_code": DPAT_API,
            "options": {
                "email_address": <ActionOptionInfo>{
                    "display_name": "Email Address",
                    "short_desc": "Email address object",
                    "type": new ConstantContactEmailAddressDataType(AutoHashOrNothingType),
                    "desc": "Email address object with `address` and optional `permission_to_send`",
                    "preselected": True,
                },
                "first_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Contact first name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "First name of the contact",
                    "preselected": True,
                },
                "last_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Contact last name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Last name of the contact",
                    "preselected": True,
                },
                "job_title": <ActionOptionInfo>{
                    "display_name": "Job Title",
                    "short_desc": "Contact job title",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Job title of the contact",
                },
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company Name",
                    "short_desc": "Contact company name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Company name of the contact",
                },
                "create_source": <ActionOptionInfo>{
                    "display_name": "Create Source",
                    "short_desc": "Source of the contact creation",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The source of the contact creation",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "Account",
                            "display_name": "Account",
                            "desc": "Created by the account owner",
                        },
                        <AllowedValueInfo>{
                            "value": "Contact",
                            "display_name": "Contact",
                            "desc": "Created by the contact themselves",
                        },
                    ),
                },
                "list_memberships": <ActionOptionInfo>{
                    "display_name": "List Memberships",
                    "short_desc": "Contact list IDs to add the contact to",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of contact list IDs to add the contact to",
                },
                "taggings": <ActionOptionInfo>{
                    "display_name": "Taggings",
                    "short_desc": "Tag IDs to apply to the contact",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of tag IDs to apply to the contact",
                },
                "birthday_month": <ActionOptionInfo>{
                    "display_name": "Birthday Month",
                    "short_desc": "Birthday month (1-12)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The birthday month of the contact (`1`-`12`)",
                },
                "birthday_day": <ActionOptionInfo>{
                    "display_name": "Birthday Day",
                    "short_desc": "Birthday day (1-31)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The birthday day of the contact (`1`-`31`)",
                },
                "anniversary": <ActionOptionInfo>{
                    "display_name": "Anniversary",
                    "short_desc": "Anniversary date (YYYY-MM-DD)",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The anniversary date of the contact in `YYYY-MM-DD` format",
                },
                "phone_numbers": <ActionOptionInfo>{
                    "display_name": "Phone Numbers",
                    "short_desc": "Contact phone numbers",
                    "type": new ListDataType("PhoneNumberList",
                        new ConstantContactPhoneNumberDataType(), True),
                    "desc": "A list of phone number objects for the contact",
                },
                "street_addresses": <ActionOptionInfo>{
                    "display_name": "Street Addresses",
                    "short_desc": "Contact street addresses",
                    "type": new ListDataType("StreetAddressList",
                        new ConstantContactStreetAddressDataType(), True),
                    "desc": "A list of street address objects for the contact",
                },
                "custom_fields": <ActionOptionInfo>{
                    "display_name": "Custom Fields",
                    "short_desc": "Custom field values",
                    "type": new ListDataType("CustomFieldValueList",
                        new ConstantContactCustomFieldValueDataType(), True),
                    "desc": "A list of custom field value objects for the contact",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ConstantContactContactDataType(); },
        });

        # Update a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contacts/update",
            "action": "update-contact",
            "groups": "Contacts",
            "display_name": "Update a Contact",
            "short_desc": "Update an existing contact",
            "desc": "Update an existing contact in Constant Contact.\n\n"
                "**Important**: This uses PUT semantics (full replace). Any fields not included "
                "in the request will be cleared to their default values. Include all fields you "
                "want to preserve",
            "action_code": DPAT_API,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contacts",
                },
                "email_address": <ActionOptionInfo>{
                    "display_name": "Email Address",
                    "short_desc": "Email address object",
                    "type": new ConstantContactEmailAddressDataType(AutoHashOrNothingType),
                    "desc": "Email address object with `address` and optional `permission_to_send`",
                    "preselected": True,
                },
                "first_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Contact first name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "last_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Contact last name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "job_title": <ActionOptionInfo>{
                    "display_name": "Job Title",
                    "short_desc": "Contact job title",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company Name",
                    "short_desc": "Contact company name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "update_source": <ActionOptionInfo>{
                    "display_name": "Update Source",
                    "short_desc": "Source of the contact update",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The source of the contact update",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "Account",
                            "display_name": "Account",
                            "desc": "Updated by the account owner",
                        },
                        <AllowedValueInfo>{
                            "value": "Contact",
                            "display_name": "Contact",
                            "desc": "Updated by the contact themselves",
                        },
                    ),
                },
                "list_memberships": <ActionOptionInfo>{
                    "display_name": "List Memberships",
                    "short_desc": "Contact list IDs",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of contact list IDs",
                },
                "taggings": <ActionOptionInfo>{
                    "display_name": "Taggings",
                    "short_desc": "Tag IDs",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of tag IDs",
                },
                "birthday_month": <ActionOptionInfo>{
                    "display_name": "Birthday Month",
                    "short_desc": "Birthday month (1-12)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The birthday month of the contact (`1`-`12`)",
                },
                "birthday_day": <ActionOptionInfo>{
                    "display_name": "Birthday Day",
                    "short_desc": "Birthday day (1-31)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The birthday day of the contact (`1`-`31`)",
                },
                "anniversary": <ActionOptionInfo>{
                    "display_name": "Anniversary",
                    "short_desc": "Anniversary date (YYYY-MM-DD)",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The anniversary date of the contact in `YYYY-MM-DD` format",
                },
                "phone_numbers": <ActionOptionInfo>{
                    "display_name": "Phone Numbers",
                    "short_desc": "Contact phone numbers",
                    "type": new ListDataType("PhoneNumberList",
                        new ConstantContactPhoneNumberDataType(), True),
                    "desc": "A list of phone number objects for the contact",
                },
                "street_addresses": <ActionOptionInfo>{
                    "display_name": "Street Addresses",
                    "short_desc": "Contact street addresses",
                    "type": new ListDataType("StreetAddressList",
                        new ConstantContactStreetAddressDataType(), True),
                    "desc": "A list of street address objects for the contact",
                },
                "custom_fields": <ActionOptionInfo>{
                    "display_name": "Custom Fields",
                    "short_desc": "Custom field values",
                    "type": new ListDataType("CustomFieldValueList",
                        new ConstantContactCustomFieldValueDataType(), True),
                    "desc": "A list of custom field value objects for the contact",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ConstantContactContactDataType(); },
        });

        # Delete a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contacts/delete",
            "action": "delete-contact",
            "groups": "Contacts",
            "display_name": "Delete a Contact",
            "short_desc": "Delete a contact",
            "desc": "Delete a contact from Constant Contact",
            "action_code": DPAT_API,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contacts",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
        });

        # List Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contacts",
            "action": "list-contacts",
            "groups": "Contacts",
            "display_name": "List Contacts",
            "short_desc": "List all contacts",
            "desc": "List contacts in Constant Contact with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Filter by contact ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Filter by email address",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter contacts by email address",
                    "preselected": True,
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by contact status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter contacts by status",
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "all",
                            "display_name": "All",
                            "desc": "All contacts",
                        },
                        <AllowedValueInfo>{
                            "value": "active",
                            "display_name": "Active",
                            "desc": "Active contacts",
                        },
                        <AllowedValueInfo>{
                            "value": "deleted",
                            "display_name": "Deleted",
                            "desc": "Deleted contacts",
                        },
                        <AllowedValueInfo>{
                            "value": "not_set",
                            "display_name": "Not Set",
                            "desc": "Contacts with no status set",
                        },
                        <AllowedValueInfo>{
                            "value": "pending_confirmation",
                            "display_name": "Pending Confirmation",
                            "desc": "Contacts pending confirmation",
                        },
                        <AllowedValueInfo>{
                            "value": "temp_hold",
                            "display_name": "Temporary Hold",
                            "desc": "Contacts on temporary hold",
                        },
                        <AllowedValueInfo>{
                            "value": "unsubscribed",
                            "display_name": "Unsubscribed",
                            "desc": "Unsubscribed contacts",
                        },
                    ),
                },
                "list_id": <ActionOptionInfo>{
                    "display_name": "List ID",
                    "short_desc": "Filter by contact list ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter contacts by contact list membership",
                    "ref_data": "contact_lists",
                },
                "updated_after": <ActionOptionInfo>{
                    "display_name": "Updated After",
                    "short_desc": "Filter by update date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter contacts updated after this date (ISO-8601)",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                    "preselected": True,
                },
            },
        });

        # Get a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contacts",
            "action": "get-contact",
            "groups": "Contacts",
            "display_name": "Get a Contact",
            "short_desc": "Get a single contact by ID",
            "desc": "Retrieve a single contact by ID from Constant Contact",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contacts",
                },
            },
        });

        # ========== CONTACT LIST ACTIONS ==========

        # Create a Contact List
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contact-lists/create",
            "action": "create-contact-list",
            "groups": "Contact Lists",
            "display_name": "Create a Contact List",
            "short_desc": "Create a new contact list",
            "desc": "Create a new contact list in Constant Contact",
            "action_code": DPAT_API,
            "options": {
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Contact list name",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The name of the contact list",
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "Contact list description",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Description of the contact list",
                    "preselected": True,
                },
                "favorite": <ActionOptionInfo>{
                    "display_name": "Favorite",
                    "short_desc": "Mark as favorite",
                    "type": AbstractDataProviderTypeMap."*bool",
                    "desc": "Whether to mark this list as a favorite",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ConstantContactContactListDataType(); },
        });

        # Update a Contact List
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contact-lists/update",
            "action": "update-contact-list",
            "groups": "Contact Lists",
            "display_name": "Update a Contact List",
            "short_desc": "Update an existing contact list",
            "desc": "Update an existing contact list in Constant Contact",
            "action_code": DPAT_API,
            "options": {
                "list_id": <ActionOptionInfo>{
                    "display_name": "List ID",
                    "short_desc": "The contact list to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contact_lists",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Contact list name",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The name of the contact list",
                },
                "description": <ActionOptionInfo>{
                    "display_name": "Description",
                    "short_desc": "Contact list description",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Description of the contact list",
                },
                "favorite": <ActionOptionInfo>{
                    "display_name": "Favorite",
                    "short_desc": "Mark as favorite",
                    "type": AbstractDataProviderTypeMap."*bool",
                    "desc": "Whether to mark this list as a favorite",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ConstantContactContactListDataType(); },
        });

        # Delete a Contact List
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contact-lists/delete",
            "action": "delete-contact-list",
            "groups": "Contact Lists",
            "display_name": "Delete a Contact List",
            "short_desc": "Delete a contact list",
            "desc": "Delete a contact list from Constant Contact",
            "action_code": DPAT_API,
            "options": {
                "list_id": <ActionOptionInfo>{
                    "display_name": "List ID",
                    "short_desc": "The contact list to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contact_lists",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
        });

        # List Contact Lists
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contact-lists",
            "action": "list-contact-lists",
            "groups": "Contact Lists",
            "display_name": "List Contact Lists",
            "short_desc": "List all contact lists",
            "desc": "List contact lists in Constant Contact",
            "action_code": DPAT_FIND,
            "options": {
                "list_id": <ActionOptionInfo>{
                    "display_name": "List ID",
                    "short_desc": "Filter by list ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                    "preselected": True,
                },
            },
        });

        # Get a Contact List
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/contact-lists",
            "action": "get-contact-list",
            "groups": "Contact Lists",
            "display_name": "Get a Contact List",
            "short_desc": "Get a single contact list by ID",
            "desc": "Retrieve a single contact list by ID from Constant Contact",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "list_id": <ActionOptionInfo>{
                    "display_name": "List ID",
                    "short_desc": "The contact list ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contact_lists",
                },
            },
        });

        # ========== TAG ACTIONS ==========

        # Create a Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/tags/create",
            "action": "create-tag",
            "groups": "Tags",
            "display_name": "Create a Tag",
            "short_desc": "Create a new tag",
            "desc": "Create a new tag in Constant Contact",
            "action_code": DPAT_API,
            "options": {
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Tag name",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The name of the tag",
                },
                "tag_source": <ActionOptionInfo>{
                    "display_name": "Tag Source",
                    "short_desc": "Source of the tag",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The source of the tag",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "Account",
                            "display_name": "Account",
                            "desc": "Tag created by the account owner",
                        },
                        <AllowedValueInfo>{
                            "value": "Contact",
                            "display_name": "Contact",
                            "desc": "Tag created by the contact",
                        },
                    ),
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ConstantContactTagDataType(); },
        });

        # Update a Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/tags/update",
            "action": "update-tag",
            "groups": "Tags",
            "display_name": "Update a Tag",
            "short_desc": "Update an existing tag",
            "desc": "Update an existing tag in Constant Contact",
            "action_code": DPAT_API,
            "options": {
                "tag_id": <ActionOptionInfo>{
                    "display_name": "Tag ID",
                    "short_desc": "The tag to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "tags",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Tag name",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The new name of the tag",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ConstantContactTagDataType(); },
        });

        # Delete a Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/tags/delete",
            "action": "delete-tag",
            "groups": "Tags",
            "display_name": "Delete a Tag",
            "short_desc": "Delete a tag",
            "desc": "Delete a tag from Constant Contact",
            "action_code": DPAT_API,
            "options": {
                "tag_id": <ActionOptionInfo>{
                    "display_name": "Tag ID",
                    "short_desc": "The tag to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "tags",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return AbstractDataProviderType::get(AutoHashType); },
        });

        # List Tags
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/tags",
            "action": "list-tags",
            "groups": "Tags",
            "display_name": "List Tags",
            "short_desc": "List all tags",
            "desc": "List tags in Constant Contact",
            "action_code": DPAT_FIND,
            "options": {
                "tag_id": <ActionOptionInfo>{
                    "display_name": "Tag ID",
                    "short_desc": "Filter by tag ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                    "preselected": True,
                },
            },
        });

        # Get a Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/tags",
            "action": "get-tag",
            "groups": "Tags",
            "display_name": "Get a Tag",
            "short_desc": "Get a single tag by ID",
            "desc": "Retrieve a single tag by ID from Constant Contact",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "tag_id": <ActionOptionInfo>{
                    "display_name": "Tag ID",
                    "short_desc": "The tag ID",
