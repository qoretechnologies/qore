                    "type": AbstractDataProviderTypeMap."*string",
                },
                "country_code": <ActionOptionInfo>{
                    "display_name": "Country Code",
                    "short_desc": "Two-letter country code",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The two-letter ISO country code",
                },
                "state_code": <ActionOptionInfo>{
                    "display_name": "State Code",
                    "short_desc": "State or province code",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The state or province code",
                },
                "time_zone_id": <ActionOptionInfo>{
                    "display_name": "Time Zone",
                    "short_desc": "Account time zone ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The time zone ID (e.g., `US/Eastern`)",
                },
            },
            "get_output_type": AbstractDataProviderType sub () { return new ConstantContactAccountDataType(); },
        });

        # ========== TRIGGERS ==========

        # New Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/events/new-contact",
            "action": "new-contact",
            "groups": "Triggers",
            "display_name": "New Contact",
            "short_desc": "Trigger when a new contact is created",
            "desc": "Fires when a new contact is created in Constant Contact. "
                "Uses polling to detect new records.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NEW_CONTACT,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # New Email Campaign
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/events/new-email-campaign",
            "action": "new-email-campaign",
            "groups": "Triggers",
            "display_name": "New Email Campaign",
            "short_desc": "Trigger when a new email campaign is created",
            "desc": "Fires when a new email campaign is created in Constant Contact. "
                "Uses polling to detect new records.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NEW_EMAIL_CAMPAIGN,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # New Contact List
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ConstantContactDataProvider::AppName,
            "path": "/events/new-contact-list",
            "action": "new-contact-list",
            "groups": "Triggers",
            "display_name": "New Contact List",
            "short_desc": "Trigger when a new contact list is created",
            "desc": "Fires when a new contact list is created in Constant Contact. "
                "Uses polling to detect new records.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NEW_CONTACT_LIST,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });
    };
}

/** @mainpage ConstantContactDataProvider Module

    @tableofcontents

    @section constantcontactdataproviderintro ConstantContactDataProvider Introduction

    The %ConstantContactDataProvider module provides a data provider API for the Constant Contact
    email marketing platform.

    To use this module, use \c "%requires ConstantContactDataProvider" in your code.

    All the public symbols in the module are defined in the ConstantContactDataProvider namespace.

    The main classes are:
    - @ref ConstantContactDataProvider::ConstantContactDataProvider "ConstantContactDataProvider":
      the root data provider for Constant Contact
    - @ref ConstantContactDataProvider::ConstantContactDataProviderFactory "ConstantContactDataProviderFactory":
      the data provider factory for Constant Contact

    @section constantcontactdataproviderrelnotes Release Notes

    @subsection constantcontactdataproviderv1_0 ConstantContactDataProvider v1.0
