            "national": True,
            "nocheck": True,
            "nonclustered": True,
            "not": True,
            "null": True,
            "nullif": True,
            "of": True,
            "off": True,
            "offsets": True,
            "on": True,
            "open": True,
            "opendatasource": True,
            "openquery": True,
            "openrowset": True,
            "openxml": True,
            "option": True,
