            "while": True,
            "with": True,
            "within group": True,
            "writetext": True,
        );

        #! Maximum precision
        const MaxPrecision = 38;
    }

    constructor(AbstractDatasource nds, *hash opts) : AbstractDatabase(nds, opts) {
        is_sybase = MssqlDatabase::isSybase(ds);
        if (!is_sybase) {
            default_schema = nds.selectRow("select schema_name() as \"schema\"").schema;
        }
    }

    #! Returns @ref True if the driver requires a scale to support decimal values in numeric or decimal columns
    /** @return @ref True if the driver requires a scale to support decimal values in numeric or decimal columns

        @since %FreeSqlUtil 1.4.2
    */
    bool requiresScale() {
        return True;
    }

    #! Returns the maximum precision for numeric or decimal columns
    /** @return -1 means, no maximum

        @since %FreeSqlUtil 1.4.2
    */
    int getMaximumPrecision() {
        return MaxPrecision;
    }

    private list<string> featuresImpl() {
        return (DB_TABLES, DB_VIEWS, DB_SEQUENCES,
                DB_FUNCTIONS, DB_PROCEDURES);
    }

    private MssqlSequence makeSequenceImpl(string name, number start = 1, number increment = 1, *softnumber end, *hash opts) {
        return new MssqlSequence(name, start, increment, end);
    }

    private *AbstractSequence getSequenceImpl(string name) {
        return new MssqlSequence(name);
    }

    private *AbstractView getViewImpl(string name) {
        string schema;
        parse_schema_name(name, \schema, \name, default_schema);

        # information_schema will return NULL if the view definition > 4000 chars, so we use system tables
        *hash<auto> row = ds.selectRow("select smv.definition from sys.all_views v join sys.sql_modules smv on smv.object_id = v.object_id join sys.schemas s on s.schema_id = v.schema_id where s.name = %v and v.name = %v", schema, name);

        if (!row)
            return;

        if (!row.definition)
            throw "VIEW-ERROR", sprintf("view %y exists but the current user does not have permission to read the view", name);

        row.definition =~ s/create view .* as //ig;

        return new MssqlView(name, row.definition, schema);
    }

    private MssqlFunction makeFunctionImpl(string name, string src, *hash opts) {
        throw "UNIMPLEMENTED", "unimplemented";
    }

    private MssqlFunction makeProcedureImpl(string name, string src, *hash opts) {
        return makeFunctionImpl(name, src, opts);
    }

    private *AbstractFunction getFunctionImpl(string name) {
        throw "UNIMPLEMENTED", "unimplemented";
    }

    private AbstractFunction getProcedureImpl(string name) {
        return getFunctionImpl(name);
    }

    private list getDropSchemaSqlImpl(hash schema_hash, *hash opt) {
        return ();
    }

    private list getAlignSqlImpl(hash schema_hash, *hash opt) {
        return ();
    }

    #! returns a list of string table names in the database
    private softlist<string> listTablesImpl() {
        return ds.select("select name from sysobjects where type = %v", "U").name;
        #return ds.select("select table_name from information_schema.tables").table_name;
    }

    #! returns a list of string function names in the database
    /** The function names will include arguments in parentheses after the names

        @return a list of string function names in the database
    */
    private list<string> listFunctionsImpl() {
        return ds.select("select routine_name from information_schema.routines").routine_name;
    }

    #! since Mssql only supports functions, this method is identical to listFunctionsImpl()
    /** @see listFunctionsImpl()
    */
    private list<string> listProceduresImpl() {
        return listFunctionsImpl();
    }

    private list<string> listSequencesImpl() {
        throw "UNIMPLEMENTED", "unimplemented";
    }

    private list<string> listViewsImpl() {
        return ds.select("select name from sysobjects where type = %v", "V").name;
        #return ds.select("select table_name from information_schema.views").table_name;
    }

    #! returns a string that can be used to create the schema in the database
    private string getCreateSqlImpl(list l) {
        return MssqlDatabase::getCreateSql(l);
    }

    #! returns @ref True if the DB is a Sybase database
    static bool isSybase(AbstractDatasource ds) {
        return ds.getServerVersion() =~ /Adaptive Server/;
    }

    #! returns a string that can be used to create the schema in the database
    static string getCreateSql(list l) {
        return !l ? "" : foldl $1 + "\n" + $2, l;
    }

    #! returns driver-specific options to the base abstract class
    private hash getSchemaDescriptionOptions() {
        return MssqlSchemaDescriptionOptions;
    }

    #! returns driver-specific options to the base abstract class
    private hash getReclaimSpaceOptions() {
        return MssqlReclaimSpaceOptions;
    }

    #! returns the next value in the given sequence
    private softint getNextSequenceValueImpl(string name) {
        return ds.selectRow("select next value for %v as nextval", name).nextval;
    }

    #! returns the last value issued for the given sequence in the current session
    private softint getCurrentSequenceValueImpl(string name) {
        return ds.selectRow("select current_value from sys.sequences where name = %v", name).current_value;
    }

    #! returns @ref True "True" if the database supports sequences
    private bool supportsSequencesImpl() {
        # MS SQL Server 2012+ supports sequences
        if (isSybase(ds)) {
            return False;
        }
        # set vars for MS SQL Server
        *softint ver = (ds.getServerVersion() =~ x/Microsoft SQL Server ([0-9]+)/)[0];
        return ver >= 2012;
    }

    #! returns @ref True "True" if the database supports named types
    private bool supportsTypesImpl() {
        return True;
    }

    #! returns @ref True "True" if the database supports packages
    private bool supportsPackagesImpl() {
        return False;
    }

    #! rebuild index implementation. See @ref SqlUtil::AbstractDatabase::rebuildIndex()
    private bool rebuildIndexImpl(string name, *hash options) {
        ds.select("alter index %v on %v reorganize", name, options.table_name);
        return True;
    }

    #! compute statistics implementation. See @ref SqlUtil::AbstractDatabase::computeStatistics()
    private computeStatisticsImpl(*hash options) {
        if (options.tables)
            map ds.select("update statistics %v", $1), options.tables;
        else # otherwise update all statistics in the DB
            ds.select("exec sp_updatestats");
    }

    #! reclaim space implementation. See @ref SqlUtil::AbstractDatabase::reclaimSpace()
    private reclaimSpaceImpl(*hash options) {
        ds.select("dbcc shrinkdatabase");
    }

    #! @ref SqlUtil::AbstractDatabase.getPhysicalSize()
    private int getPhysicalSizeImpl() {
        *string dbname = ds.getDBName();
        if (!exists dbname) {
            return GET_PHYSICAL_DB_SIZE_NOVAL;
        }
        return ds.selectRow("select f.size * 8 as val -- to bytes
                                from sys.master_files f
                                inner join sys.databases d on d.database_id = f.database_id
                                where d.name = %v", dbname).val ?? GET_PHYSICAL_DB_SIZE_NOVAL;
    }

    #! tries to execute a command so that if an error occurs the current transaction status is not lost
    private auto tryExecArgsImpl(string sql, *softlist<auto> args) {
        return MssqlDatabase::tryExecArgs(ds, sql, args);
    }

    #! tries to execute a command so that if an error occurs the current transaction status is not lost
    private auto tryExecRawImpl(string sql, *softlist<auto> args) {
        return MssqlDatabase::tryExecRaw(ds, sql);
    }

    #! tries to execute a command so that if an error occurs the current transaction status is not lost
    static auto tryExecArgs(AbstractDatasource ds, string sql, *softlist<auto> args) {
        ds.exec("save tran " + mssql_TempSavepoint);

        auto rv;
        try {
            rv = ds.vexec(sql, args);
        }
        catch (hash<ExceptionInfo> ex) {
            ds.exec("rollback transaction " + mssql_TempSavepoint);
            rethrow;
        }
        return rv;
    }

    #! tries to execute a command so that if an error occurs the current transaction status is not lost
    static auto tryExecRaw(AbstractDatasource ds, string sql) {
        ds.exec("save tran " + mssql_TempSavepoint);

        auto rv;
        try {
            rv = ds.execRaw(sql);
        }
        catch (hash<ExceptionInfo> ex) {
            ds.exec("rollback transaction " + mssql_TempSavepoint);
            rethrow;
        }
        return rv;
    }
}

#! provides the Mssql-specific implementation of the SqlUtil::AbstractTable interface
public class MssqlTable inherits SqlUtil::AbstractTable {
    public {
        #! sybase flag
        bool is_sybase;

        #! "has merge" flag for SQL server
        bool ss_has_merge = False;

        #! "has sequences" flag for SQL server
        bool ss_has_sequences = False;

        #! maps postgresql type names to type configurations
        const MssqlTypeMap = (
            "numeric": ("qore": Type::Number, "size": SZ_NUM,),
            "decimal": ("qore": Type::Number, "size": SZ_NUM,),
            "tinyint": ("qore": Type::Int,),
            "smallint": ("qore": Type::Int,),
            "int": ("qore": Type::Int,),
            "bigint": ("qore": Type::Int,),
            "double": ("qore": Type::Float,),
            "float": ("qore": Type::Float,), # NOTE: optional precision
            "real": ("qore": Type::Float,),
            "money": ("qore": Type::Number,),
            "smallmoney": ("qore": Type::Number,),

            "datetime2": ("qore": Type::Date,),
            "datetime": ("qore": Type::Date,),
            "smalldatetime": ("qore": Type::Date,),
            "date": ("qore": Type::Date,),
            "time": ("qore": Type::Date,),

            # NOTE: "size_range" is different between MS SQL Server and Sybase SQL Anywhere Server
            # MS SQL: range is (1, 8000) or special keyword "max" for varchar types
            # Sybase: range is (1, 32767) and size is mandatory for character-length semantics
            "char": ("qore": Type::String, "size": SZ_OPT),
            "char varying": ("qore": Type::String, "size": SZ_OPT),
            "character varying": ("qore": Type::String, "size": SZ_OPT),
            "varchar": ("qore": Type::String, "size": SZ_OPT, "default_size": 80),

            # The following uni* types are used in Sybase Adaptive Server
            "unichar": ("qore": Type::String, "size": SZ_MAND,),
            "univarchar": ("qore": Type::String, "size": SZ_MAND,),
            "unitext": ("qore": Type::String,),

            # NOTE: "size_range" is different between MS SQL Server and Sybase SQL Anywhere Server
            # MS SQL: range is (1, 8000) or special keyword "max" for varbinary types
            # Sybase: range is (1, 32767)
            "binary": {
                "qore": Type::Binary,
                "size": SZ_OPT,
            },
            "binary varying": ("qore": Type::Binary, "size": SZ_OPT),
            "varbinary": {
                "qore": Type::Binary,
                "size": SZ_OPT,
                "default_size": 80,
            },
            "varbinary(max)": ("qore": Type::Binary,),

            # The following are used in Sybase, supported & deprecated in MS SQL
            "text": ("qore": Type::String,), # domain, implemented as "long varchar"
            "image": ("qore": Type::Binary,), # domain, implemented as "long binary"
            # The following are Sybase specific
            "long binary": ("qore": Type::Binary,),
            "long varchar": ("qore": Type::String,),
        );

        #! maps qore type names to DB type names
        const QoreTypeMap = (
            "integer": "bigint",
            "float": "float",
            "number": "numeric",
            "string": "varchar",
            "binary": "varbinary",
            "bool": "tinyint",
            SqlUtil::CHAR: "char",
            SqlUtil::CLOB: "text",
        );

        #! maps qore type names to MS SQL Server type names
        const MsQoreTypeMap = QoreTypeMap + {
            SqlUtil::BLOB: "varbinary(max)",
            "date": "datetime2",
        };

        #! maps qore type names to Sybase/SAP type names
        const SybaseQoreTypeMap = QoreTypeMap + {
            "date": "datetime",
        };

        #! equal to @ref SqlUtil::AbstractTable::TableDescriptionHashOptions
        const MssqlTableDescriptionHashOptions = AbstractTable::TableDescriptionHashOptions;

        const MssqlColumnDescOptions = AbstractTable::ColumnDescOptions;

        const MssqlIndexOptions = AbstractTable::IndexOptions;

        const MssqlConstraintOptions = AbstractTable::ConstraintOptions + MssqlIndexOptions;

        const MssqlTableCreationOptions = AbstractTable::TableCreationOptions + MssqlConstraintOptions;

        const MssqlAlignTableOptions = AbstractTable::AlignTableOptions + MssqlTableCreationOptions;

        #! select options supported by MssqlSqlUtilBase
        const MssqlSelectOptions = AbstractTable::SelectOptions + (
            "tablehint": "softstringlist",
        );

        #! query hints
        const MsSqlServerTableHints = (
            "fastfirstrow": True,
            "holdlock": True,
            "nolock": True,
            "paglock": True,
            "readcommitted": True,
            "readpast": True,
            "readuncommitted": True,
            "repeatableread": True,
            "rowlock": True,
            "serializable": True,
            "tablock": True,
            "tablockx": True,
            "updlock": True,
            "xlock": True,
        );

        #! Mssql Expression map
        const MssqlExpressionMap = DefaultExpressionMap + {
            OP_SUBSTR: DefaultExpressionMap{OP_SUBSTR} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."int");
                    if (!exists args[2]) {
                        return sprintf("substring(%s,%s,32767)", exp0, exp1);
                    }
                    return sprintf("substring(%s,%s,%s)", exp0, exp1,
                        info.table.getExpressionArg(\info, role, args[2], AbstractDataProviderTypeMap."int"));
                },
            },
            COP_PREPEND: DefaultExpressionMap{COP_PREPEND} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],
                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."string");
                    return sprintf("concat(%s, %s)", exp1, exp0);
                },
            },
            COP_APPEND: DefaultExpressionMap{COP_APPEND} + {
                "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                    string exp0 = info.table.getExpressionArg(\info, role, args[0],

                        AbstractDataProviderTypeMap."string");
                    string exp1 = info.table.getExpressionArg(\info, role, args[1],
                        AbstractDataProviderTypeMap."string");
                    return sprintf("concat(%s, %s)", exp0, exp1);
                },
            },
        };

        #! where operator specializations for Mssql
        const MssqlOpMap = DefaultOpMap + {
            OP_SUBSTR: {
                "code": string sub (reference<hash<QueryInfo>> info, string cn, softlist arg) {
                    info.args += arg[0]; # start
                    if (!exists arg[1]) {
                        info.args += arg[2]; # text
                        return sprintf("substring(%s,%v,32767) = %v", cn); # NOTE: length arg is required
                    }
                    info.args += arg[1]; # count
                    info.args += arg[2]; # text
                    return sprintf("substring(%s,%v,%v) = %v", cn);
                },
            },
        };

        #! column operator specializations for Mssql
        const MssqlCopMap = (
            COP_CAST: (
                "code": string sub (string cve, list<auto> args) {
                    string name = QoreTypeMap{args[0]} ?? args[0];
                    hash desc = MssqlTypeMap{name};
                    string sql = sprintf ("cast (%s as %s", cve, name);
                    switch (name) {
                        default:
                            if (desc.size == SZ_MAND) {
                                if (!exists args[1] && !exists desc.size_range)
                                    throw "OPERATOR-ERROR", sprintf ("op_cast operator missing size for type %s",
                                        name);
                                sql += sprintf("(%d)", args[1] ?? desc.size_range[1]);
                            } else if (desc.size == SZ_NUM && exists args[1]) {
                                sql += sprintf("(%d", args[1]);
                                sql += exists args[2] ? sprintf(",%d)", args[2]) : ")";
                            } else if (desc.size == SZ_OPT && exists args[1]) {
                                sql += sprintf("(%d)", args[1]);
                            }
                    }
                    sql += ")";
                    return sql;
                },
            ),
            COP_PREPEND: {
                "arg": Type::String,
                "sqlvalue": True,
                "code": string sub (string cve, string arg) {
                    return sprintf("concat(%s, %s)", arg, cve);
                },
            },
            COP_APPEND: {
                "arg": Type::String,
                "sqlvalue": True,
                "code": string sub (string cve, string arg) {
                    return sprintf("concat(%s, %s)", cve, arg);
                },
            },
            COP_SUBSTR: (
                "code": string sub (string cve, list<auto> args) {
                    if (!exists args[1])
                        return sprintf("substring(%s,%d,32767)", cve, args[0]); # NOTE: length arg is required
                    return sprintf("substring(%s,%d,%d)", cve, args[0], args[1]);
                },
            ),
            COP_YEAR: (
                "code": string sub (string arg1, auto arg) {
                    return sprintf("substring(convert(varchar, dt, 120), 1, 4)", arg1);
                }
            ),
            COP_YEAR_MONTH: (
                "code": string sub (string arg1, auto arg) {
                    return sprintf("substring(convert(varchar, dt, 120), 1, 7)", arg1);
                }
            ),
            COP_YEAR_DAY: (
                "code": string sub (string arg1, auto arg) {
                    return sprintf("substring(convert(varchar, dt, 120), 1, 10)", arg1);
                }
            ),
            COP_YEAR_HOUR: (
                "code": string sub (string arg1, auto arg) {
                    return sprintf("substring(convert(varchar, dt, 120), 1, 13)", arg1);
                }
            ),
            COP_SEQ: (
                "nocolumn": True,
                "withalias": True,
                "code": string sub (*string cve, hash arg, reference<hash<auto>> psch) {
                    string sql = sprintf("next value for %s", arg.seq);
                    if (arg.as) {
                        psch{arg.as} = sql;
                        sql += " as " + arg.as;
                    }
                    return sql;
                }
            ),
            COP_SEQ_CURRVAL: (
                "nocolumn": True,
                "code": string sub (*string cve, hash arg) {
                    throw "SEQUENCE-ERROR", sprintf("cannot select the current value of sequence %y because this "
                        "database does not support this operation", arg.seq);
                }
            ),
            COP_LENGTH: (
                "code": string sub (string cve, auto arg) {
                    return sprintf("len(%s)", cve);
                },
            ),
            COP_TRUNC_DATE: (
                "code": string sub(string arg1, auto arg) {
                    if (!MssqlTruncDate.hasKey(arg)) {
                        throw "COP-TRUNC-DATE-ERROR", sprintf("Not allowed format argument: %n: allowed: %n", arg,
                            MssqlTruncDate.keys());
                    }
                    string cmd = MssqlTruncDate{arg};
                    return replace(cmd, "%s", arg1);
                }
            )
        );

        #! Map @ref SqlUtil::cop_trunc_date() constants to Mssql internal masks
        /*  Impl. note here. There is shorter workaround for this, but it does not work with seconds
            and with dates older than 1.1.1970. (minutes will overflow later too etc.).
            So no usage for: dateadd(ss, datediff(ss, 0, %s), 0) for example
            */
        const MssqlTruncDate = (
            DT_YEAR     : "datetimefromparts(datepart(year, %s), 1, 1, 0, 0, 0, 0)",
            DT_MONTH    : "datetimefromparts(datepart(year, %s), datepart(month, %s), 1, 0, 0, 0, 0)",
            DT_DAY      : "datetimefromparts(datepart(year, %s), datepart(month, %s), datepart(day, %s), "
                "0, 0, 0, 0)",
            DT_HOUR     : "datetimefromparts(datepart(year, %s), datepart(month, %s), datepart(day, %s), "
                "datepart(hour, %s), 0, 0, 0)",
            DT_MINUTE   : "datetimefromparts(datepart(year, %s), datepart(month, %s), datepart(day, %s), "
                "datepart(hour, %s), datepart(minute, %s), 0, 0)",
            DT_SECOND   : "datetimefromparts(datepart(year, %s), datepart(month, %s), datepart(day, %s), "
                "datepart(hour, %s), datepart(minute, %s), datepart(second, %s), 0)",
        );

        #! a hash of default value operator descriptions for Mssql
        const MssqlIopMap = DefaultIopMap + (
            IOP_SEQ: (
                "arg": Type::String,
                "placeholder": "next value for %v",
            ),
        );

        #! a hash of default update operator definitions for Mssql
        const MssqlUopMap = DefaultUopMap + (
            COP_SEQ: (
                "nocolumn": True,
                "withalias": True,
                "code": string sub (*string cve, string arg) {
                    return sprintf("next value for %s", arg);
                }
            ),
            COP_SEQ_CURRVAL: (
                "nocolumn": True,
                "code": string sub (*string cve, string arg) {
                    throw "SEQUENCE-ERROR", sprintf("cannot select the current value of sequence %y because this "
                        "database does not support this operation", arg);
                }
            ),
        );
    }

    private {
        #! filegroup name for the table, if known
        *string filegroup;

        #! schema name for the table
        string schema;

        #! contains any trigger functions supporting triggers on the table
        Functions triggerFunctions;

        #! the default schema for the user
        string default_schema = "dbo";
    }

    constructor(AbstractDatasource nds, string nname, *hash opts) : AbstractTable(nds, nname, opts) {
        is_sybase = MssqlDatabase::isSybase(ds);
        # set vars for MS SQL Server
        if (!is_sybase) {
            *softint ver = (ds.getServerVersion() =~ x/Microsoft SQL Server ([0-9]+)/)[0];
            if (ver >= 2008) {
                ss_has_merge = True;
                if (ver >= 2012) {
                    ss_has_sequences = True;
                }
            }
            default_schema = nds.selectRow("select schema_name() as \"schema\"").schema;
        }
        # see if there is a schema in the name
        parse_schema_name(nname, \schema, \name, default_schema);
    }

    #! returns the schema name
    string getSchemaName() {
        return schema;
    }

    #! returns the data filegroup name for the table or @ref nothing if none is known
    *string getTablespaceName() {
        return filegroup;
    }

    #! returns a closure for performing upserts
    /** if the underlying dataserver supports an optimized \c MERGE statement (Microsoft SQL Server 2008+), the
        \a upsert_strategy argument is ignored and a closure using a merge statement is returned, otherwise the
        standard upsert closure is returned according to @ref SqlUtil::AbstractTable::getUpsertClosure()
    */
    code getUpsertClosure(hash<auto> row, int upsert_strategy = UpsertAuto, *hash<auto> opt) {
        if (!ss_has_merge)
            return AbstractTable::getUpsertClosure(row, upsert_strategy, opt);

        # check upsert options
        validateOptionsIntern("OPTION-ERROR", getUpsertOptions(), \opt);

        hash<auto> upsert_row;
        if (opt.upsert_columns) {
            hash<auto> uch = map {$1: True}, opt.upsert_columns;
            if (*hash<auto> invalid_cols = (uch - keys row)) {
                throw "UPSERT-ERROR", sprintf("%s: 'upsert_columns' contains the following columns not referenced in "
                    "the row data: %y", getDesc(), keys invalid_cols);
            }
            upsert_row = map {$1: NOTHING}, opt.upsert_columns;
        } else {
            upsert_row = row;
        }

        Columns cols = checkUpsertRow(upsert_row, \upsert_strategy);

        # if the strategy is "select first", then respect this strategy; this is a slow upsert method anyway
        if (upsert_strategy == UpsertSelectFirst) {
            return getUpsertSelectFirst(cols, row, opt);
        }

        # get update columns
        list updc = ();
        # hash of columns to skip on update if applicable
        *hash suh = map {$1: True}, opt.omit_update;
        map updc += $1, keys row, !cols.hasKey($1) && !suh.$1;
        # cannot use merge where only the join columns are present
        if (!updc) {
            return getUpsertInsertOnly(cols, row, opt);
        }

        string sql = sprintf("merge %s t using (select ", getSqlName());
        sql += foldl $1 + "," + $2, (map "%v", keys row);
        sql += ") as source (";
        sql += foldl $1 + "," + $2, row.keyIterator();
        sql += ") on (";
        sql += foldl $1 + " and " + $2, (map sprintf("t.%s=source.%s", $1, $1), getColumnSqlNames(cols.keys()));
        sql += ")";
        if (upsert_strategy != UpsertInsertOnly) {
            sql += sprintf(" when matched then update set ");
            # get update columns
            sql += (foldl $1 + "," + $2, (map sprintf("t.%s=source.%s", $1, $1), getColumnSqlNames(updc)));
        }
        if (upsert_strategy != UpsertUpdateOnly) {
            sql += sprintf(" when not matched then insert (");
            sql += (foldl $1 + "," + $2, getColumnSqlNames(row.keys()));
            sql += ") values (";
            sql += (foldl $1 + "," + $2, (map "source." + $1, keys row));
            sql += ")";
        }
        sql += ";";

        #printf("sql: %s\n", sql);

        if (upsert_strategy == UpsertInsertOnly) {
            return int sub (hash crow) {
                list<auto> args = crow.values();
                #on_error printf("SQL: %s args: %y\n", sql, args);
                return ds.vexec(sql, args) ? UR_Inserted : UR_Unchanged;
            };
        }

        if (upsert_strategy == UpsertUpdateOnly) {
            return int sub (hash crow) {
                list<auto> args = crow.values();
                #on_error printf("SQL: %s args: %y\n", sql, args);
                return ds.vexec(sql, args) ? UR_Verified : UR_Unchanged;
            };
        }

        return int sub (hash crow) {
            list<auto> args = crow.values();
            #on_error printf("SQL: %s args: %y\n", sql, args);
            ds.vexec(sql, args);
            return UR_Verified;
        };
    }

    #! returns @ref False "False" because the Mssql driver does not support array binds / bulk DML operations
    bool hasArrayBind() {
        return False;
    }

    #! returns the name of the table to be used in SQL (with a possible qualifiers for schema, etc)
    string getSqlName() {
        return schema + "." + name;
    }

    #! Returns the expression map for Mssql
    hash<auto> getExpressionMap() {
        return MssqlExpressionMap;
    }

    #! returns the "where" operator map for Mssql
    hash<auto> getWhereOperatorMap() {
        return MssqlOpMap;
    }

    private string getFromIntern(string from, *hash qh) {
        # grep from clause with optional hints
        string hstr = from;
        *hash hh = !is_sybase ? MsSqlServerTableHints : NOTHING;
        list l;
        foreach string hint in (qh.tablehint) {
            # explicit support for index() hints
            if (hint =~ /^index/) {
                # remove whitespace
                string istr = replace(hint, " ", "");
                # get index list
                *string ilstr = (istr =~ x/^index\((.*)\)$/)[0];
                if (!ilstr.val())
                    throw "TABLEHINT-ERROR", sprintf("\"index\" table hint is missing the index arguments in "
                        "parentheses: %y", hint);
                # manually process hints as integers to ensure there are no SQL injections
                l += ("index(" + (foldl $1 + "," + $2, (map $1.toInt(), ilstr.split(","))) + ")");
                continue;
            }

            if (!hh{hint})
                throw "TABLEHINT-ERROR", sprintf("unknown hint %y; known hints: %y", hint, hh.keys());
            l += hint;
        }
        if (l)
            hstr += " with (" + (foldl $1 + "," + $2, l) + ")";
        #printf("from: %y opt: %y hstr: %y\n", from, qh, hstr);
        return hstr;
    }

