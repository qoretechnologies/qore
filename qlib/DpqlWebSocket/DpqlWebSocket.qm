%requires qore >= 2.0

%modern

%requires DataProvider
%requires ConnectionProvider
%requires WebSocketHandler >= 2.0
%requires json
%requires HttpServerUtil

module DpqlWebSocket {
    version = "1.0";
    desc = "DPQL WebSocket language services for DataProvider";
    author = "Qore Technologies, s.r.o.";
    url = "https://qoretechnologies.com";
    license = "MIT";
}

/** @mainpage DpqlWebSocket Module

    @section dpqlwebsocketintro Introduction to the DpqlWebSocket Module

    The %DpqlWebSocket module provides WebSocket-based DPQL language services
    for DataProvider-aware clients. It exposes a JSON message protocol for
    tokenization, parsing, validation, completion, and serialization.

    The module provides:
    - @ref DataProvider::DpqlWebSocketHandler "DataProvider::DpqlWebSocketHandler": WebSocket handler for HttpServer
    - @ref DataProvider::DpqlWebSocketConnection "DataProvider::DpqlWebSocketConnection": Per-client session handler

    @section dpqlws_usage Basic Usage

    @code{.py}
%requires HttpServer
%requires DpqlWebSocket

DataProvider::DpqlWebSocketHandler handler();

HttpServer server({"port": 8080});
server.addHandler("/ws/dpql", handler);
server.start();
    @endcode

    Clients connect to \c ws://localhost:8080/ws/dpql. The full message schema
    is defined in @c DpqlWebSocket/DpqlApi.asyncapi.yaml.

    @subsection dpqlws_v1_0 v1.0
    - initial release of DPQL WebSocket language services
*/

#! Main namespace for the DpqlWebSocket module
public namespace DpqlWebSocket {
}
