# minimum required Qore version
%requires qore >= 2.0
%requires(reexport) DebugUtil
%requires Util
%requires yaml

%modern
%no-debugging

module DebugCmdLine {
    version = "0.1.3";
    desc = "user module providing common command line debug stuff";
    author = "Tomas Mandys <tomas.mandys@qoretechnologies.org>";
    url = "http://qoretechnologies.org";
    license = "MIT";
}

/** @mainpage DebugCmdLine Module

    @tableofcontents

    @section debugcmdlineintro Introduction to the DebugCmdLine Module

    The %DebugCmdLine module provides common functionality for implementing debugger client utilities

    @subsection dcl_v0_1_3 v0.1.3
    - a statement can be given as a function name without the types of its parameters when the function has one
      variant (<a href="https://github.com/qoretechnologies/qore/issues/5558">issue 5558</a>)
    - the results of commands and the values of variables are printed in YAML style (the \c "%Y" format of
      @ref Qore::printf() "printf()")
    - added the \c eval command, which evaluates an expression with the variables of the current frame
    - \c thread \c list shows the names of threads
    - the output of programs of a debug server is printed as the programs wrote it
    - added the \c break \c condition, \c break \c hitcondition and \c break \c log commands, which set the
      condition, the hit condition and the log message of a breakpoint; \c break \c list shows them with the number
      of hits
    - added the \c exception \c filter command, which selects the exceptions that stop threads: all user exceptions,
      all system exceptions, exceptions that no try statement of debuggable code catches, and exceptions with given
      codes
    - a statement can be given by its line and its column as <tt>line:column</tt>, counted in characters from 1, for a
      breakpoint on a statement of a line with more than one statement; added the \c statement \c line command,
      which lists the statements of a line with their columns
    - added the \c thread \c targets command, which lists the calls of the current statement, and
      <tt>go stepinto <n></tt>, which steps into one of them
    - added the \c thread \c var command, which shows a variable or an element, key or member of it, also a private
      one, with its elements, keys and members, or sets it to the value of an expression
    - added the \c options \c stopall option: all threads of a program stop when one of them stops, and continue
      together
    - added the \c display and \c undisplay commands: expressions that are shown at each stop
    - <tt>thread var <path> from <index></tt> shows the elements, keys or members of a value from an index, and the
      call stack gives the columns of the statements of its frames
    - fixed \c qdbg not ending when it quits while a thread of the program is stopped before the end of the program
    - fixed \c qdbg-remote failing at its start (a command whose hash had string values only), and not starting with
      the debugged program and its stopped thread as the current ones; with input that is not a terminal,
      \c qdbg-remote processes each command at the stop that it is written for, as \c qdbg does
    - \c help lists the commands with what they do and a quick start; the descriptions are written in plain language;
      errors are shown as <tt>Error: description (CODE)</tt>
    - added the \c continue (\c c), \c step (\c s), \c next (\c n), \c finish, \c print and \c locals commands
    - events are shown in plain words, such as <tt>Paused at breakpoint 1 at main.q:3 (thread 2)</tt>; the frames of
      call stacks are named after their functions, without the frames and threads of the debugger; \c thread \c list
      shows whether each thread is paused
    - a thread that a program starts runs until a breakpoint, and its end does not pause it; a thread that pauses
      while the current thread runs becomes the current thread
    - added the \c up, \c down, \c b and \c kill commands; a thread that starts while all threads of its program are
      stopped together stays stopped with them
    - added the \c script command and runCommandFile(), which run files of commands; session files keep the display
      expressions, the exception filters and the \c stopall option with the breakpoints, and \c session \c save and
      \c session \c load without a file name show an error; the \c session command showed the number of stopped
      threads twice

    @subsection dcl_v0_1_2 v0.1.2
    - removed Linenoise stuff to new module
    - options API
    - source API

    @subsection dcl_v0_1_1 v0.1.1
    - fixed a bug parsing call signatures when setting breakpoints (<a href="https://github.com/qoretechnologies/qore/issues/2601">issue 2601</a>)
    - improved breakpoint usability (<a href="https://github.com/qoretechnologies/qore/issues/2604">issue 2604</a>)

    @subsection dcl_v0_1 v0.1
    - initial release
*/

#! the DebugCmdLine namespace contains all the definitions in the DebugCmdLine module
public namespace DebugCmdLine {
    #! debug command line class
    public class DebugCommandLine inherits AbstractDebugControl {
        public {
            hash<auto> cx;
            const defaultIndent = "  ";
            #! the exception filters of the debugger; see the \c exception \c filter command
            const ExceptionFilterNames = ("user", "system", "uncaught");
            #! the maximum number of elements, keys or members of a value that \c thread \c var shows
            const MaxShownChildren = 100;
            #! True if all threads of a program stop when one of them stops, and continue together; see processEvent()
            bool stopAllThreads = False;
            #! True if the commands are read from input that is not a terminal, and a command that resumes a thread
            #! returns when it stops again; the display expressions are then shown before the next command
            bool waitsForStops = False;
            #! Terminal color support for colorized output
            TerminalColor tc;
        }

        public {
            #! The name of the frame of the code of a program outside of functions
            const TopLevelFrameName = "<top level>";

            #! The quick start that \c help shows after the list of commands
            const QuickStart = "Quick start:
  break create <line>    pause the program when it reaches a line of the current file
  continue (c)           continue until a breakpoint, an exception or the end
  step (s), next (n)     run to the next line, into called functions or over them
  finish                 run until the current function returns
  bt, locals             show the call stack and the local variables
  print <expression>     show the value of an expression
  quit                   end the debugger
Commands can be shortened while they stay unique, such as \"br cr 10\" for \"break create 10\".
";
        }

        private {
            #! the error of the last command that processCmdLine() processed, if any; see runCommandFile()
            *string commandError;
            #! the number of files of commands that are run, one in another; see runCommandFile()
            int commandFileDepth = 0;
            #! the maximum number of files of commands that are run one in another, as a file that runs itself
            const MaxCommandFileDepth = 16;
            #! the description of the exception of a file of commands that ended at a command that failed
            const CommandFileFailed = "a command of a file of commands failed";

            const fcHelp = 0x01;
            const fcExpandUniqueCmd = 0x02;
            const fcValidate = 0x04;
            const fcFallback = 0x08;
            *string historyFileName;

            Qore::Thread::RWLock rwlContext();

            #! the threads that are stopped, by program ID and TID; see processEvent()
            hash<string, hash<string, bool>> stoppedThreads = {};
            #! the threads that were requested to stop as another thread stopped, by program ID and TID
            hash<string, hash<string, bool>> stopAllRequests = {};
            #! the threads that the user stepped or paused, by program ID and TID
            hash<string, hash<string, bool>> userStops = {};
            #! serializes the access to the state of stopping all threads
            Mutex stopAllLock();
            #! incremented when stopped threads continue, so that the threads are no longer requested to stop for an
            #! earlier stop; see stopOtherThreads()
            int stopAllGeneration = 0;
            #! the threads that the debugger resumes as they start or end, by TID, whose run events are not shown; see
            #! processEvent()
            hash<string, bool> autoResumed = {};
            #! the requests to stop the other threads of a program that are being sent; see stopOtherThreads()
            Counter stopAllPending();

            #! the expressions that are shown at each stop; see the \c display command
            list<string> displays = ();
            #! the thread whose display expressions are shown before the next command; see showPendingDisplays()
            *int pendingDisplayTid;
            #! serializes the access to the display expressions
            Mutex displayLock();
        }

        #! Creates the object with optional logger and color control
        /** @param logger optional logger interface
            @param enable_color if True, auto-detect terminal color support; if False, disable color
        */
        constructor(*LoggerInterface logger, bool enable_color = True) : AbstractDebugControl(logger) {
            tc = new TerminalColor(enable_color);
        }

        private hash<auto> getCommands() {
            code fallbackGetSetInt = sub(DebugCommandLine dcl, softlist path, reference args) {
                switch (args[0] ?? '') {
                    case '':
                        unshift args, 'get';
                        break;
                    case /^[0-9]+$/:
                        unshift args, 'set';
                        break;
                }
            };
            code fallbackGetSetString = sub(DebugCommandLine dcl, softlist path, reference args) {
                switch (args[0] ?? '') {
                    case '':
                        unshift args, 'get';
                        break;
                    default:
                        unshift args, 'set';
                        break;
                }
            };
            return (
                '>': (
                    'help': (
                        '**': (
                            'desc': 'Show the help of a command. Usage: help <command> [subcommand ...]',
                            'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                shift path;
                                if (path[0] == 'help') return ();
                                *hash<auto> cmd = dcl.findCmd(path + args, fcHelp | fcExpandUniqueCmd);
                                if (!cmd.variants) return ();
                                return keys cmd.variants;
                            },
                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                shift path; # remove help arg
                                int last_param;
                                # get full path list
                                list<auto> fl = path + args;
                                *hash<auto> cmd = dcl.findCmd(fl, fcHelp | fcExpandUniqueCmd, \last_param);
                                # see if we have an unknown command or option
                                if (last_param < fl.size()) {
                                    if (!last_param) {
                                        printfImpl("%s: unknown command; try \"help\"\n", fl[0]);
                                    } else {
                                        string ctxt = fl[0..(last_param - 1)].join(' ');
                                        printfImpl("%s: unknown argument %y; try \"help %s\"\n", ctxt, fl[last_param], ctxt);
                                    }
                                    return;
                                }
                                string full_cmd = fl[0..(last_param - 1)].join(" ");
                                @debug {
                                    printfImpl("fl: %y lp: %y full_cmd: %Y\n", fl, last_param, full_cmd);
                                }
                                if (cmd.cmd) {
                                    *string desc = DebugCommandLine::getCmdDesc(cmd.cmd);
                                    # the usage on its own line
                                    if (desc) {
                                        desc =~ s/ Usage: /\nUsage: /;
                                    }
                                    printfImpl("%s: %s\n", full_cmd, desc ?? "");
                                }
                                if (cmd.cmd.aliases) {
                                    printfImpl("Aliases of %s: %s\n", cmd.cmd.name, sort(cmd.cmd.aliases).join(', '));
                                }
                                cmd = dcl.findCmd(fl + '', fcHelp);
                                if (cmd.variants.typeCode() == NT_HASH) {
                                    printfImpl("\nSubcommands; \"help %s <subcommand>\" shows the details of one:\n%s",
                                        full_cmd, dcl.getVariantHelp(cmd.variants));
                                }
                            },
                        ),
                        'desc': 'Show all commands, or the help of a command. Usage: help [command ...]',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            shift path; # remove help arg
                            *hash<auto> cmd = dcl.findCmd(list('') , fcHelp);
                            printfImpl("Commands; \"help <command>\" shows the details of one:\n%s\n%s",
                                dcl.getVariantHelp(cmd.variants), QuickStart);
                        },
                    ),
                    'version': (
                        'desc': 'Show the versions of the debugger and of the debug server.',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            hash<auto> mods = get_module_hash();
                            hash<auto> res.client = {
                                'class': dcl.className(),
                                'DebugCmdLine': mods.DebugCmdLine.version ?? "n/a",
                                'DebugUtil': mods.DebugUtil.version ?? "n/a",
                                'qore': Qore::VersionString,
                            };
                            try {
                                hash<auto> data.cmd = 'version';
                                res.host = dcl.doCommand(data, False).result;
                            } catch (hash<ExceptionInfo> ex) {
                            }
                            dcl.printHuman(res);
                        },
                    ),
                    'eval': (
                        'desc': 'Show the value of an expression, with the variables of the current stack frame. '
                            'Usage: eval <expression>',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            string expr = args.join(" ");
                            if (!expr.val()) {
                                printfImpl("syntax: eval <expression>\n");
                                return;
                            }
                            *hash<auto> r = dcl.doCommand({
                                "cmd": "thread/evaluate",
                                "tid": dcl.checkThreadId(),
                                "expression": expr,
                                "serialize": True,
                            }, False).result;
                            dcl.printVar(expr, r.serialized);
                        },
                    ),
                    'script': (
                        'desc': 'Run the commands of a file, one on each line; lines that start with "#" are comments. A '
                            'command that resumes a thread waits until a thread pauses, and the first command that '
                            'fails ends the file. Usage: script <file>',
                        'action': bool sub(DebugCommandLine dcl, softlist path, softlist args) {
                            *string fn = shift args;
                            if (!exists fn) {
                                throw "DEBUG-COMMAND", "the name of the file is missing: script <file>";
                            }
                            # a command of the file, as quit, can end the debugger
                            return !dcl.runCommandFile(fn);
                        },
                    ),
                    'cmd': (
                        'desc': 'Advanced: send a command of the debug server protocol and show the result. Usage: '
                            'cmd <command> [<hash>]',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            @debug {
                                printfImpl("path: %y args: %y\n", path, args);
                            }
                            hash<auto> data;
                            try {
                                foreach string str in (args) {
                                    auto v = parse_to_qore_value(str);
                                    if (v.typeCode() == NT_STRING && !data) {
                                        data.cmd = v;
                                        continue;
                                    }
                                    if (v.typeCode() != NT_HASH)
                                        throw "CMD-ARG-ERROR", sprintf("arg must be a hash; got type %y instead", v.type());
                                    data += v;
                                }
                                if (!data) {
                                    printfImpl("syntax: cmd <hash>\n");
                                } else {
                                    auto res = dcl.doCommand(data, False).result;
                                    printfImpl("Result:\n");
                                    dcl.printHuman(res);
                                }
                            }
                            catch (hash<ExceptionInfo> ex) {
                                printfImpl("ERROR: cmd cannot be parsed: %s: %s\n", ex.err, ex.desc);
                            }
                        },
                    ),
                    'options': (
                        '>': (
                            'verbose': (
                                '>': {
                                    'set': (
                                        'desc': 'Change how much the debugger logs. Usage: options verbose set '
                                            '<level>',
                                        '*': (
                                            'validate': \DebugCommandLine::validateInt(),
                                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                                logger.setLevel(pop path);
                                            },
                                        ),
                                    ),
                                    'get': (
                                        'desc': 'Show how much the debugger logs.',
                                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            printfImpl("Logging level: %s\n", logger.getLevel().getStr());
                                        },
                                    ),
                                },
                                'fallback': fallbackGetSetInt,
                                'desc': 'Show or change how much the debugger logs.',
                            ),

                            'rverbose': (
                                '>': {
                                    'set': (
                                        'desc': 'Change how much the debug server logs. Usage: options rverbose set '
                                            '<level>',
                                        '*': (
                                            'validate': \DebugCommandLine::validateInt(),
                                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                                doCommand((
                                                    'cmd': 'options/verbose/set',
                                                    'value': int(pop path),
                                                ), True);
                                            },
                                        ),
                                    ),
                                    'get': (
                                        'desc': 'Show how much the debug server logs.',
                                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            *hash<auto> vh = doCommand((
                                                'cmd': 'options/verbose/get',
                                            ), False);
                                            printfImpl("Remote Logging level: %y\n", vh.result);
                                        },
                                    ),
                                },
                                'fallback': fallbackGetSetInt,
                                'desc': 'Show or change how much the debug server logs.',
                            ),

                            'stopall': (
                                '>': {
                                    'set': (
                                        'desc': 'Choose whether all threads of a program pause when one of them '
                                            'pauses, and continue together (1: yes, 0: no). Usage: options stopall set '
                                            '0|1',
                                        '*': (
                                            'validate': \DebugCommandLine::validateInt(),
                                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                                dcl.stopAllThreads = int(pop path) > 0;
                                            },
                                        ),
                                    ),
                                    'get': (
                                        'desc': 'Show whether all threads of a program pause together.',
                                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            printfImpl("stop all threads: %d\n", dcl.stopAllThreads ? 1 : 0);
                                        },
                                    ),
                                },
                                'fallback': fallbackGetSetInt,
                                'desc': 'Show or change whether all threads of a program pause when one of them '
                                    'pauses.',
                            ),

                            'fullexceptioninfo': (
                                '>': {
                                    'set': (
                                        'desc': 'Choose whether exceptions are shown with all their details, such as '
                                            'their call stacks (1: yes, 0: no). Usage: options fullexceptioninfo set '
                                            '0|1',
                                        '*': (
                                            'validate': \DebugCommandLine::validateInt(),
                                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                                doCommand((
                                                    'cmd': 'options/fullexceptioninfo/set',
                                                    'value': int(pop path) > 0,
                                                ), True);
                                            },
                                        ),
                                    ),
                                    'get': (
                                        'desc': 'Show whether exceptions are shown with all their details.',
                                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            doCommand((
                                                'cmd': 'options/fullexceptioninfo/get',
                                            ), True);
                                        },
                                    ),
                                },
                                'fallback': fallbackGetSetInt,
                                'desc': 'Show or change whether exceptions are shown with all their details.',
                            ),
                            'sourcepath': (
                                '>': {
                                    'set': (
                                        'desc': 'Change the folders where the debug server looks for source files, '
                                            'separated by ":". Usage: options sourcepath set <folders>',
                                        '*': (
                                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                                doCommand((
                                                    'cmd': 'options/sourcepath/set',
                                                    'value': pop path,
                                                ), True);
                                            },
                                        ),
                                    ),
                                    'get': (
                                        'desc': 'Show the folders where the debug server looks for source files.',
                                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            doCommand((
                                                'cmd': 'options/sourcepath/get',
                                            ), True);
                                        },
                                    ),
                                },
                                'fallback': fallbackGetSetString,
                                'desc': 'Show or change the folders where the debug server looks for source files.',
                            ),
                        ),
                        'desc': 'Show or change the settings of the debugger.',
                    ),
                    'frame': (
                        '>': {
                            'set': (
                                'desc': 'Select the current stack frame, by its number in the call stack ("bt"). '
                                    'Usage: frame set <number>',
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'thread/stack';
                                        data.tid = dcl.checkThreadId();
                                        *hash<auto> th = dcl.doCommand(data, False);
                                        return th.result.size() > 1 ? range(0, th.result.size() - 1) : ();   # TODO: is removing bottom item reliable rule ?
                                    },
                                    'validate': \DebugCommandLine::validateInt(),
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        dcl.selectFrame(int(pop path));
                                    },
                                ),
                            ),
                            'get': (
                                'desc': 'Show the number of the current stack frame.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data = (
                                        "cmd": "thread/debug/frame/get",
                                        "tid": dcl.checkThreadId(),
                                    );
                                    dcl.doCommand(data, True);
                                },
                            ),
                        },
                        'fallback': fallbackGetSetInt,
                        'desc': 'Show or select the current stack frame, whose variables are shown and used in '
                            'expressions.',
                    ),
                    'session': (
                        'desc': 'Show the programs that are debugged, their paused threads and their breakpoints.',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            hash<auto> data.cmd = 'session/get';
                            *hash<auto> sh = dcl.doCommand(data, False).result;
                            if (sh) {
                                foreach hash<auto> ph in (sh.pairIterator()) {
                                    string bs = '';
                                    if (ph.value.breakpoints) {
                                        bs = sprintf(", %s (enabled: %d)", plural(ph.value.breakpoints.size(), "breakpoint"), (select ph.value.breakpoints, AbstractDebugControl::boolStrings{$1.enabled}).size());
                                    }
                                    if (ph.value.interrupted) {
                                        # plural() gives the number with the word
                                        printfImpl("+ %y (program %d, %s paused%s)\n", ph.value.scriptName, ph.key,
                                            plural(ph.value.interrupted.size(), "thread"), bs);
                                        printfImpl("  - paused threads: %s\n", (foldl $1 + ", " + $2,
                                            ph.value.interrupted));
                                    }
                                    else
                                        printfImpl("+ %y (program %d, no paused threads%s)\n", ph.value.scriptName,
                                            ph.key, bs);
                                }
                            }
                            else
                                printfImpl("no programs are currently being debugged\n");
                        },
                        '>': (
                            'load': (
                                'desc': 'Load the breakpoints, display expressions, exception filters and the stopall '
                                    'option that "session save" saved to a file. Usage: session load <file>',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    *string fn = shift args;
                                    if (!exists fn) {
                                        throw "DEBUG-COMMAND", "the name of the file is missing: session load <file>";
                                    }
                                    dcl.loadSession(fn);
                                },
                            ),
                            'save': (
                                'desc': 'Save the breakpoints, display expressions, exception filters and the stopall '
                                    'option to a file, for "session load" or the -s option. Usage: session save '
                                    '<file>',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    *string fn = shift args;
                                    if (!exists fn) {
                                        throw "DEBUG-COMMAND", "the name of the file is missing: session save <file>";
                                    }
                                    dcl.saveSession(fn);
                                    printfImpl("The session is saved to %y\n", fn);
                                },
                            ),
                        ),
                    ),
                    'program': (
                        'alias': 'pgm',
                    ),
                    'pgm': (
                        '>': (
                            'load': (
                                'desc': 'Load a script and run it in the debugger. Usage: pgm load <file> [arguments '
                                    '...]',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program//create';
                                    data.filename = shift args;
                                    if (!exists data.filename) {
                                        throw "DEBUG-COMMAND", "Missing file name";
                                    }
                                    data.args = args;
                                    dcl.doCommand(data, True);
                                },
                            ),
                            'search': (
                                'desc': 'Find the programs whose names match a regular expression. Usage: pgm search '
                                    '<regex>',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    if (!args[0].val()) {
                                        printfImpl("usage: pgm search <regex>\n");
                                        return;
                                    }
                                    hash<auto> data.cmd = 'program//list';
                                    *hash<auto> pgm_info = dcl.doCommand(data, False);
                                    hash<auto> rh;
                                    foreach hash<auto> h in (pgm_info.result.pairIterator()) {
                                        if (regex(h.value.scriptName ?? "", args[0]))
                                            rh{h.key} = h.value;
                                    }
                                    if (!rh) {
                                        printfImpl("no program matching %y found out of %d programs\n", args[0], pgm_info.result.size());
                                    } else {
                                        dcl.showPrograms(rh, False);
                                    }
                                },
                            ),
                            'list': (
                                '>': (
                                    'full': (
                                        'desc': 'List the programs with more details.',
                                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            hash<auto> data.cmd = 'program//list';
                                            data.listFiles = True;
                                            dcl.doCommand(data, True);
                                        },
                                    ),
                                ),
                                'desc': 'List the programs; "full" shows more details. Usage: pgm list [full]',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program//list';
                                    *hash<auto> pgm_info = dcl.doCommand(data, False);
                                    if (pgm_info.result) {
                                        dcl.showPrograms(pgm_info.result, False);
                                    } else {
                                        printfImpl("no results returned from server\n");
                                    }
                                },
                            ),
                            'set': (
                                'desc': 'Select the current program, by its number or the name of its script. Usage: '
                                    'pgm set <number|name>',
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        string name = pop path;
                                        if (bindex(name, '/') >= 0) {  # conflict with delimiter
                                            return ();
                                        }
                                        hash<auto> data.cmd = 'program/'+name+'/list';
                                        *hash<auto> sd = dcl.doCommand(data, False);
                                        if (sd.result) {
                                            if (name =~ /^[0-9]+$/) {
                                                # programIds
                                                return keys sd.result;
                                            } else {
                                                # scriptNames
                                                list<auto> l = ();
                                                map l += (sd.result{$1}.scriptName, ), keys sd.result;
                                                return l;
                                            }
                                        } else {
                                            return ();
                                        }
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        string val = pop path;
                                        if (val !~ /^[0-9]+$/ ) {
                                            if (bindex(val, '/') >= 0) {  # conflict with delimiter
                                                throw "DEBUG-COMMAND", "Invalid character '/'";
                                            }
                                            hash<auto> data.cmd = 'program/='+val+'/list';
                                            *hash<auto> sd = dcl.doCommand(data, False);
                                            if (!sd.result) {
                                                throw "DEBUG-COMMAND", "Cannot resolve program name";
                                            }
                                            if (sd.result.size() > 1) {
                                                throw "DEBUG-COMMAND", sprintf("Ambiguous program name, pgmIds: %y", keys sd.result);
                                            }
                                            val = sd.result.firstKey();
                                        }
                                        dcl.setContextValue('programId', val);
                                        printfImpl("Program %y is now the current program\n", val);
                                    },
                                ),
                            ),
                            'get': (
                                'desc': 'Show the current program.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    auto v = dcl.getContextValue('programId');
                                    if (!exists v) {
                                        printfImpl("no current program set (pgm set <id> to set)\n");
                                    } else {
                                        dcl.printHuman(v);
                                    }
                                },
                            ),
                            'add': (
                                'desc': 'Start debugging the current program.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/add';
                                    dcl.doCommand(data, True);
                                },
                            ),
                            'remove': (
                                'desc': 'Stop debugging the current program; its threads continue without stopping.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/remove';
                                    dcl.doCommand(data, True);
                                },
                            ),
                            'stop': (
                                'desc': 'Pause the threads of the current program, or only one of them. Usage: pgm '
                                    'stop [thread]',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId();
                                    if (exists args[0]) {
                                        data.cmd += '/thread/'+args[0];
                                        # the stop of the thread is the user's
                                        dcl.noteUserStop(dcl.checkProgramId(), args[0]);
                                    }
                                    data.cmd += '/stop';
                                    dcl.doCommand(data, True);
                                },
                            ),
                            'global': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/global/'+pop path+'/list';
                                        *hash<auto> sd = dcl.doCommand(data, False);
                                        return sd.result ?? ();
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        string varName = pop path;
                                        hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/global/'+varName+'/';
                                        if (args) {
                                            data.cmd += 'set';
                                            data.value = call_function_args(\dcl.parseValue(), args);
                                            dcl.doCommand(data, True);
                                        } else {
                                            data.cmd += 'get';
                                            *hash<auto> vh = dcl.doCommand(data, False);
                                            if (!vh) {
                                                printfImpl("there is no global var %y; use \"pgm global\" to list global vars in this program\n", varName);
                                            }
                                            else {
                                                dcl.printVar(varName, vh.result);
                                            }
                                        }
                                    },
                                ),
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/global//list';
                                    *list<auto> tl = dcl.doCommand(data, False).result;
                                    printfImpl("global vars: %s\n", (foldl $1 + ", " + $2, tl));
                                },
                                'desc': 'List the global variables, or show or change one. Usage: pgm global [<name> '
                                    '[<value>]]',
                            ),
                            'define': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/define/'+pop path+'/list';
                                        *hash<auto> sd = dcl.doCommand(data, False);
                                        return keys sd.result ?? ();
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/define/'+pop path+'/get';
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/define//list';
                                    dcl.doCommand(data, True);
                                },
                                'desc': 'Show the parse defines of the current program, or one of them. Usage: pgm '
                                    'define [name]',
                            ),
                            'options': (
                                'desc': 'Show the parse options of the current program.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/options';
                                    dcl.doCommand(data, True);
                                },
                            ),
                            'label': (
                                '*': (
                                    'desc': 'Show the code of a label. Usage: pgm label <label> [<first line> '
                                        '[<number of lines>]]',
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/label/list';
                                        return DebugCommandLine::enumFilter(keys dcl.doCommand(data, False).result, pop path);
                                    },
                                    'validate': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        if (args.size() > 1) {
                                            push path, shift args;
                                            DebugCommandLine::validateInt(dcl, path, args);
                                            if (args[0] != "") {
                                                push path, shift args;
                                                DebugCommandLine::validateInt(dcl, path, args);
                                            }
                                        }
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        dcl.processGetSource('label', path, args);
                                    },
                                ),
                                'desc': 'List the labels of the code of the current program that was not read from '
                                    'files.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/label/list';
                                    showFileNames(dcl.doCommand(data, False).result);
                                },
                            ),
                            'file': (
                                '*': (
                                    'desc': 'Show the code of a source file. Usage: pgm file <file> [<first line> '
                                        '[<number of lines>]]',
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/file/list';
                                        return DebugCommandLine::enumFilter(keys dcl.doCommand(data, False).result, pop path);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        dcl.processGetSource('file', path, args);
                                    },
                                ),
                                'desc': 'List the source files of the current program.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/file/list';
                                    showFileNames(dcl.doCommand(data, False).result);
                                },
                            ),
                            'info': (
                                'desc': 'Show the details of the current program and its threads.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/='+dcl.checkProgramId()+'/list';
                                    dcl.doCommand(data, True);
                                },
                            ),
                        ),
                        'desc': 'Commands for the programs that are debugged.',
                        /* TODO: what is intended enumeration ?
                        'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                            hash<auto> data.cmd = 'program//list';
                            *hash<auto> pgm_info = dcl.doCommand(data, False);
                            list<auto> rv = ();
                            *string p = shift path;
                            bool id = p =~ /^[0-9]+$/;
                            foreach hash<auto> h in (pgm_info.pairIterator()) {
                                if (!p.val())
                                    rv += h.key.toInt();
                                else {
                                    if (id) {
                                        if (regex(h.key, "^" + p))
                                            rv += h.key.toInt();
                                    }
                                    else if (h.value.scriptName.val() && regex(h.value.scriptName, "^" + p))
                                        rv += h.value.scriptName();
                                }
                            }
                            return rv;
                        },
                        */
                        'fallback': sub(DebugCommandLine dcl, softlist path, reference args) {
                            switch (args[0] ?? '') {
                            case '':
                                unshift args, 'info';
                                break;
                            case /^[0-9]+$/:
                                unshift args, 'set';
                                break;
                            }
                        },
                    ),
                    'break': (
                        '>': (
                            'list': (
                                'desc': 'List the breakpoints of the current program with their conditions; "all" '
                                    'lists those of all programs.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/breakpoint//list';
                                    *hash<auto> sd = dcl.doCommand(data, False);
                                    if (sd.result) {
                                        dcl.showBreakpoints(sd.result);
                                    }
                                },
                                '>': (
                                    'all': (
                                        'desc': 'List the breakpoints of all programs.',
                                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            hash<auto> data.cmd = 'program//breakpoint//list';
                                            *hash<auto> sd = dcl.doCommand(data, False);
                                            if (sd.result) {
                                                dcl.showBreakpoints(sd.result);
                                            }
                                        },
                                    ),
                                ),
                            ),
                            'create': (
                                'desc': 'Add a breakpoint and show its number. Usage: break create [<file>] '
                                    '<line>[:<column>] | <function>[(<parameter types>)] | #<statement>. Without a '
                                    'location, add one later with "stmt assign".',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/breakpoint//create';
                                    if (args) {
                                        data.value = dcl.getStatementValue(args);
                                    }
                                    # the event of the new breakpoint shows its number and place
                                    dcl.doCommand(data, False);
                                },
                            ),
                            'delete': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/delete';
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'Delete a breakpoint. Usage: break delete <number>',
                            ),
                            'enable': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/enable';
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'Turn a breakpoint on again. Usage: break enable <number>',
                            ),
                            'disable': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/disable';
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'Turn a breakpoint off without deleting it. Usage: break disable <number>',
                            ),
                            'condition': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        dcl.setBreakpointOption(pop path, "condition", args);
                                    },
                                ),
                                'desc': 'Pause only when an expression is true; without an expression, the condition '
                                    'is removed. Usage: break condition <number> [<expression>]',
                            ),
                            'hitcondition': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        dcl.setBreakpointOption(pop path, "hitcondition", args);
                                    },
                                ),
                                'desc': 'Pause only at some hits of a breakpoint: N (the Nth hit), ==N, >N, >=N, <N, '
                                    '<=N or %N (every Nth hit); without one, it is removed. Usage: break hitcondition '
                                    '<number> [<hit condition>]',
                            ),
                            'log': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        dcl.setBreakpointOption(pop path, "log", args);
                                    },
                                ),
                                'desc': 'Write a message instead of pausing; {expression} is replaced with its value. '
                                    'Without a message, the breakpoint pauses again. Usage: break log <number> '
                                    '[<message>]',
                            ),
                            'policy': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    '*': (
                                        'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            return DebugCommandLine::enumFilter(keys policyStrings, pop path);
                                        },
                                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                            hash<auto> data.cmd = 'program//breakpoint/'+path[path.size()-2]+'/policy/set';
                                            data.value = pop path;
                                            dcl.doCommand(data, True);
                                        },
                                    ),
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/policy/get';
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'Choose the threads that a breakpoint pauses: none (all threads), accept '
                                    '(only its threads), reject (all but its threads); see "break thread". Usage: '
                                    'break policy <number> [none|accept|reject]',
                            ),
                            'thread': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {

                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/thread/';

                                        if (args) {
                                            string a = shift args;
                                            if (a == '+') {
                                                data.cmd += 'add';
                                                data.value = int(shift args);
                                            } else if (a == '-') {
                                                data.cmd += 'remove';
                                                data.value = int(shift args);
                                            } else {
                                                data.value = ();
                                                push data.value, int(a);
                                                map (push data.value, int($1)), args;
                                                data.cmd += 'set';
                                            }
                                        } else {
                                            data.cmd += 'get';
                                        }
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'Show or change the threads of a breakpoint, for its policy. Usage: break '
                                    'thread <number> [+<thread> | -<thread> | <thread> ...]',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/thread/get';
                                        dcl.doCommand(data, True);
                                },
                            ),
                            'statement': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/statement/list';
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'List the places in the code where a breakpoint is. Usage: break statement '
                                    '<number>',
                            ),
                        ),
                        'desc': 'Commands for breakpoints, which pause the program when it reaches them. Start with: '
                            'break create <line>',
                    ),
                    'statement': (
                        'alias': 'stmt',
                    ),
                    'stmt': (
                        '>': (
                            'list': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/statement/list';
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'List the places in the code where a breakpoint is (as "break statement"). '
                                    'Usage: stmt list <breakpoint>', # duplicate to breakpoint/statement
                            ),
                            'assign': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/statement/assign';
                                        data.value = dcl.getStatementValue(args);
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'Add a place in the code to a breakpoint. Usage: stmt assign <breakpoint> '
                                    '[<file>] <line>[:<column>] | <function> | #<statement>',
                            ),
                            'unassign': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        return DebugCommandLine::enumBreakpointId(dcl, path, args);
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program//breakpoint/'+pop path+'/statement/unassign';
                                        data.value = dcl.getStatementValue(args);
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'Remove a place in the code from a breakpoint. Usage: stmt unassign '
                                    '<breakpoint> [<file>] <line>[:<column>] | <function> | #<statement>',
                            ),
                            'get': (
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/statement/get';
                                    data.value = dcl.getStatementValue(args);
                                    *hash<auto> sd = dcl.doCommand(data, False);
                                    if (exists sd.result) {
                                        printfImpl(formatStatement(sd.result));
                                        if (sd.result.breakpoints) {
                                            printfImpl(" Breakpoints:\n");
                                            foreach hash<auto> b in (sd.result.breakpoints) {
                                                printfImpl("  "+formatBreakpoint(b));
                                            }
                                        }
                                    }
                                },
                                'desc': 'Show a statement and its breakpoints. Usage: stmt get [<file>] '
                                    '<line>[:<column>] | <function> | #<statement>',
                            ),
                            'line': (
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> value = dcl.getStatementValue(args);
                                    if (!exists value.lineno) {
                                        throw "DEBUG-COMMAND", "expecting a line: [file] lineno";
                                    }
                                    list<auto> stmts = dcl.doCommand({
                                        "cmd": sprintf("program/%d/statement/list", dcl.checkProgramId()),
                                        "value": value - "column",
                                    }, False).result ?? ();
                                    if (!stmts) {
                                        printfImpl("no statement on the line\n");
                                    }
                                    foreach hash<auto> stmt in (stmts) {
                                        if (stmt.start_column >= 0) {
                                            stmt.column = DebugCommandLine::getCharColumn(dcl.getSourceLine(
                                                value.file, stmt.start_line), stmt.start_column);
                                        }
                                        printfImpl(dcl.formatStatement(stmt));
                                    }
                                },
                                'desc': 'List the statements of a line with their columns, for a breakpoint on one of '
                                    'them. Usage: stmt line [<file>] <line>',
                            ),
                        ),
                        'desc': 'Commands for statements, the places in the code where breakpoints can be.',
                    ),

                    'display': (
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            if (args) {
                                dcl.addDisplay(args.join(" "));
                            } else {
                                dcl.listDisplays();
                            }
                        },
                        'desc': 'Show the value of an expression at every pause; without an expression, list them. '
                            'Usage: display [<expression>]',
                    ),
                    'undisplay': (
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            if (args && args[0] !~ /^[0-9]+$/) {
                                throw "DEBUG-COMMAND", "expecting the number of a display expression";
                            }
                            dcl.removeDisplay(args ? int(args[0]) : NOTHING);
                        },
                        'desc': 'Stop showing an expression at every pause, or all of them. Usage: undisplay '
                            '[<number>]',
                    ),

                    'exception': (
                        '>': (
                            'filter': (
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    if (!args) {
                                        *list<auto> filters = dcl.doCommand({"cmd": "exception/filter/get"}, False)
                                            .result;
                                        printfImpl("exceptions that stop threads: %s\n",
                                            filters ? filters.join(", ") : "none");
                                        return;
                                    }
                                    list<string> filters = args.size() == 1 && args[0] == "none"
                                        ? ()
                                        : (args.size() == 1 && args[0] == "all"
                                            ? ExceptionFilterNames
                                            : args);
                                    dcl.doCommand({"cmd": "exception/filter/set", "value": filters}, True);
                                },
                                'desc': 'Choose the exceptions that pause the program: user, system, uncaught (not '
                                    'caught by a try statement), exception codes such as FILE-OPEN-ERROR, all or none; '
                                    'without arguments, show them. Usage: exception filter [<filter> ...]',
                            ),
                        ),
                        'desc': 'Commands for exceptions.',
                    ),

                    'thread': (
                        '>': (
                            'set': (
                                '*': (
                                    'desc': 'Select the current thread. Usage: thread set <thread>',
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'program/='+dcl.checkProgramId()+'/list';
                                        *hash<auto> sd = dcl.doCommand(data, False);
                                        if (sd.result) {
                                            return DebugCommandLine::enumFilter(sd.result{dcl.checkProgramId()}.threads, pop path);
                                        } else {
                                            return ();
                                        }
                                    },
                                    'validate': \DebugCommandLine::validateInt(),
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        softint val = pop path;
                                        dcl.setContextValue('threadId', val);
                                        printfImpl("Thread %y is now the current thread\n", val);
                                    },
                                ),
                            ),
                            'get': (
                                'desc': 'Show the current thread.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    *softint threadId = dcl.getContextValue('threadId');
                                    if (!exists threadId) {
                                        printfImpl("no current thread set; \"pgm info\" to list threads; \"thread set <id>\" to set the current thread\n");
                                    } else {
                                        printfImpl("TID context: %d\n", threadId);
                                    }
                                },
                            ),
                            'local': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'thread/local/'+pop path+'/list';
                                        data.tid = dcl.checkThreadId();
                                        *hash<auto> sd = dcl.doCommand(data, False);
                                        return sd.result ?? ();
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        string var = pop path;
                                        hash<auto> data.cmd = 'thread/local/'+var+'/';
                                        data.tid = dcl.checkThreadId();
                                        if (args) {
                                            data.cmd += 'set';
                                            data.value = call_function_args(\dcl.parseValue(), args);
                                            dcl.doCommand(data, True);
                                            printfImpl("%s: value set to:\n", var);
                                            dcl.printHuman(AbstractDebugControl::unserialize(data.value));
                                        } else {
                                            data.cmd += 'get';
                                            *hash<auto> vh = dcl.doCommand(data, False);
                                            # a variable that does not exist is answered without a value
                                            if (!vh.result) {
                                                printfImpl("there is no local var %y; use \"thread local\" to list local vars in this frame\n", var);
                                            }
                                            else {
                                                dcl.printVar(var, vh.result.value);
                                            }
                                        }
                                    },
                                ),

                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'thread/local//list';
                                    data.tid = dcl.checkThreadId();
                                    *list<auto> tl = dcl.doCommand(data, False).result;
                                    if (tl) {
                                        printfImpl("local vars in frame: %s\n", (foldl $1 + ", " + $2, tl));
                                    } else {
                                        printfImpl("no local vars in frame\n");
                                    }
                                },
                                'desc': 'List the local variables of the current stack frame, or show or change one. '
                                    'Usage: thread local [<name> [<value>]]',
                            ),
                            'targets': (
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    list<auto> stack = dcl.doCommand({"cmd": "thread/stack",
                                        "tid": dcl.checkThreadId()}, False).result ?? ();
                                    if (!stack[0].statementid) {
                                        throw "DEBUG-COMMAND", "the thread is not paused at a statement; \"go step\" "
                                            "runs it to the next one";
                                    }
                                    list<auto> targets = dcl.doCommand({
                                        "cmd": sprintf("program/%d/statement/stepintargets", dcl.checkProgramId()),
                                        "value": {"id": stack[0].statementid},
                                    }, False).result ?? ();
                                    if (!targets) {
                                        printfImpl("the statement makes no call to step into\n");
                                    }
                                    foreach hash<auto> t in (targets) {
                                        printfImpl("  %d: %s (%s)\n", $# + 1, t.name, dcl.formatLocation(stack[0].file,
                                            t.start_line, t.start_column));
                                    }
                                },
                                'desc': 'List the calls of the current statement that "go stepinto <n>" can step '
                                    'into.',
                            ),
                            'var': (
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    dcl.variableCommand(args);
                                },
                                'desc': 'Show a variable, or an element, key or member of it, with its contents, also '
                                    'private members, or change it. Usage: thread var <name>[.member|[index]|{key}] '
                                    '[from <index> | = <expression>]',
                            ),
                            'debug': (
                                '*': (
                                    'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        hash<auto> data.cmd = 'thread/debug/'+pop path+'/list';
                                        data.tid = dcl.checkThreadId();
                                        *hash<auto> sd = dcl.doCommand(data, False);
                                        return sd.result ?? ();
                                    },
                                    'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                        string varName = pop path;
                                        hash<auto> data.cmd = 'thread/debug/'+varName+'/';
                                        data.tid = dcl.checkThreadId();
                                        if (args) {
                                            data.cmd += 'set';
                                            data.value = call_function_args(\dcl.parseValue(), args);
                                        } else {
                                            data.cmd += 'get';
                                            if (varName == 'result') {
                                                *hash<auto> vh = dcl.doCommand(data, False);
                                                if (vh.result) {
                                                    dcl.printVar(varName, vh.result);
                                                } else {
                                                    dcl.printData(vh);
                                                }
                                                return;
                                            }
                                        }
                                        dcl.doCommand(data, True);
                                    },
                                ),
                                'desc': 'Show or change a variable of the pause, such as the result of a function at '
                                    'its return ("thread debug" lists them). Usage: thread debug [<name> [<value>]]',
                            ),
                            'pgmlist': (
                                'desc': 'List the threads and their programs; "S" marks a program where a thread is '
                                    'paused.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'program//list';
                                    *hash<auto> pgm_info = dcl.doCommand(data, False).result;
                                    if (pgm_info) {
                                        hash<auto> tl;
                                        foreach softint pgmId in (keys pgm_info) {
                                            foreach int tid in (pgm_info{pgmId}.threads) {
                                                tl{tid}.programs{pgmId} = pgm_info{pgmId};
                                                if (exists pgm_info{pgmId}.interrupted) {
                                                    if (inlist(tid, pgm_info{pgmId}.interrupted)) {
                                                        tl{tid}.interrupted = pgmId;
                                                    }
                                                }
                                            }
                                        }
                                        foreach softint tid in (sort(keys tl, int sub(softint l, softint h) {return l<=>h; })) {
                                            # do not output a trailing blank line
                                            if ($#) {
                                                printfImpl("\n");
                                            }
                                            printfImpl("TID %d program list:\n", tid);
                                            dcl.showPrograms(tl{tid}.programs, True);
                                        }
                                    }
                                },
                            ),
                            'list': (
                                'desc': 'List the threads of the current program, whether they are paused, and '
                                    'where each one is; the current one is marked with "*".',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'thread/stack';
                                    *hash<auto> threads = dcl.doCommand(data, False).result;
                                    if (threads) {
                                        # the current names of the threads of the debugged programs
                                        hash<string, *string> names = dcl.getThreadNames();
                                        *softint current = dcl.getContextValue('threadId');
                                        int pgm_id = dcl.checkProgramId();
                                        foreach softint tid in (keys threads) {
                                            # the threads of the current program; not those of the debugger itself
                                            list<hash<auto>> frames = DebugCommandLine::getShownFrames(threads{tid});
                                            if (!frames || frames[0].programid != pgm_id) {
                                                continue;
                                            }
                                            *string name = names{tid};
                                            printfImpl("%s thread %d%s, %s: %s\n", tid == current ? "*" : " ", tid,
                                                name ? sprintf(" (%s)", name) : "",
                                                dcl.isThreadPaused(frames[0].programid, tid) ? "paused" : "running",
                                                dcl.formatFrame(frames[0]));
                                        }
                                    }
                                },
                            )
                        ),
                        'desc': 'Commands for threads.',
                        'fallback': fallbackGetSetInt,
                    ),
                    'stack': (
                        'alias': 'bt',
                    ),
                    'backtrace': (
                        'alias': 'bt',
                    ),
                    'bt': (
                        'desc': 'Show the call stack of the current thread.',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            hash<auto> data.cmd = 'thread/stack';
                            data.tid = dcl.checkThreadId();
                            *hash<auto> th = dcl.doCommand(data, False);
                            if (th) {
                                dcl.showThreadStack(th.tid, th.result);
                            }
                            else
                                printfImpl("server returned no response\n");
                        },
                        '>': (
                            'all': (
                                'desc': 'Show the call stacks of all threads of the current program.',
                                'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                    hash<auto> data.cmd = 'thread/stack';
                                    *hash<auto> threads = dcl.doCommand(data, False).result;
                                    # the threads of the current program; not those of the debugger itself
                                    int pgm_id = dcl.checkProgramId();
                                    bool shown;
                                    foreach softint tid in (keys threads) {
                                        if (threads{tid}[0].programid != pgm_id) {
                                            continue;
                                        }
                                        # a blank line between the threads
                                        if (shown) {
                                            printfImpl("\n");
                                        }
                                        if (dcl.showThreadStack(tid, threads{tid})) {
                                            shown = True;
                                        }
                                    }
                                },
                            ),
                        ),
                    ),
                    'source': (
                        'desc': 'Show the code around the current line. Usage: source [<lines before> [<lines '
                            'after>]]',
                        'validate': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            if (args.size() > 0) {
                                DebugCommandLine::validateInt(dcl, path, args);
                                if (args[0] != "") {
                                    push path, shift args;
                                    DebugCommandLine::validateInt(dcl, path, args);
                                }
                            }
                        },
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            hash<auto> data.cmd = 'thread/source';
                            data.tid = dcl.checkThreadId();
                            if (args.size() > 1) {
                                data.linesbefore = int(args[0]);
                                data.linesafter = int(args[1]);
                            } else if (args.size() > 0) {
                                data.linesbefore = int(args[0]);
                                data.linesafter = data.linesbefore;
                            }
                            dcl.printfImpl("%s", dcl.formatSource(dcl.doCommand(data, False).result));
                        },
                    ),
                    # shortcuts as in other debuggers; they are not commands in the debug console of an IDE, where
                    # they can be the names of variables
                    'continue': (
                        'shortcut': True,
                        'desc': 'Continue the current thread until a breakpoint, an exception or the end, as "go". '
                            'Usage: continue [<place to run to>]',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.runCommand(("go", "run") + args);
                        },
                    ),
                    'c': ('alias': 'continue', 'shortcut': True),
                    'b': (
                        'shortcut': True,
                        'desc': 'Add a breakpoint, as "break create". Usage: b [<file>] <line>[:<column>] | <function> '
                            '| #<statement>',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.runCommand(("break", "create") + args);
                        },
                    ),
                    'up': (
                        'shortcut': True,
                        'desc': 'Select the frame that called the current frame, or the frame that many frames up. '
                            'Usage: up [<number of frames>]',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.moveFrame(DebugCommandLine::getFrameCount(args));
                        },
                    ),
                    'down': (
                        'shortcut': True,
                        'desc': 'Select the frame that the current frame called, or the frame that many frames down. '
                            'Usage: down [<number of frames>]',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.moveFrame(-DebugCommandLine::getFrameCount(args));
                        },
                    ),
                    'kill': (
                        'desc': 'End the current program: its threads end with a THREAD-CANCELLED exception, also those '
                            'that wait, as for a lock or for input.',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.doCommand({"cmd": sprintf("program/%d/terminate", dcl.checkProgramId())}, False);
                            printfImpl("The program ends\n");
                        },
                    ),
                    'step': (
                        'shortcut': True,
                        'desc': 'Run the current thread to the next line, also into the functions that it calls, as '
                            '"go step".',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.runCommand(("go", "step") + args);
                        },
                    ),
                    's': ('alias': 'step', 'shortcut': True),
                    'next': (
                        'shortcut': True,
                        'desc': 'Run the current thread to the next line of the current function, as "go stepover".',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.runCommand(("go", "stepover") + args);
                        },
                    ),
                    'n': ('alias': 'next', 'shortcut': True),
                    'finish': (
                        'shortcut': True,
                        'desc': 'Run the current thread until the current function returns, as "go untilreturn".',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.runCommand(("go", "untilreturn") + args);
                        },
                    ),
                    'print': (
                        'shortcut': True,
                        'desc': 'Show the value of an expression, as "eval". Usage: print <expression>',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.runCommand(("eval",) + args);
                        },
                    ),
                    'locals': (
                        'shortcut': True,
                        'desc': 'Show the local variables of the current stack frame with their values.',
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            dcl.showLocals();
                        },
                    ),
                    'go': (
                        '*': (
                            'enum': list sub(DebugCommandLine dcl, softlist path, softlist args) {
                                return DebugCommandLine::enumFilter((keys runStateStrings) + ("stepinto",), pop path);
                            },
                            'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                                string runState = pop path;
                                hash<auto> data.cmd = 'thread/go/' + runState;
                                data.tid = dcl.checkThreadId();
                                if (runState == "stepinto") {
                                    # the number of a call that "thread targets" lists; the only call of the statement
                                    # without a number
                                    if (!args) {
                                        args = (dcl.getOnlyStepInTarget(),);
                                    }
                                    if (args.size() != 1 || args[0] !~ /^[0-9]+$/ || int(args[0]) < 1) {
                                        throw "DEBUG-COMMAND", "expecting the number of a call that \"thread targets\" "
                                            "lists";
                                    }
                                    data.value = {"target": int(args[0]) - 1};
                                } else if (args) {
                                    data.value = dcl.getStatementValue(args);
                                }
                                dcl.goThread(data, runState);
                            },
                        ),
                        'desc': "Resume the current thread.\n"
                            "  go, go run         continue until a breakpoint, an exception or the end\n"
                            "  go step            run to the next line, also into the functions that it calls\n"
                            "  go stepover        run to the next line of the current function\n"
                            "  go untilreturn     run until the current function returns\n"
                            "  go stepinto [<n>]  run into a call of the current line (\"thread targets\" lists them)\n"
                            "  go detach          stop debugging the thread; it continues without pausing\n"
                            "A place to run to can follow the mode: [<file>] <line>[:<column>] | <function> | "
                            "#<statement>",
                        'action': sub(DebugCommandLine dcl, softlist path, softlist args) {
                            # without a mode, the thread continues to its next breakpoint, as "go run"
                            hash<auto> data.cmd = 'thread/go/run';
                            data.tid = dcl.checkThreadId();
                            dcl.goThread(data, "run");
                        },
                    ),
                ),
            );
        }

        # to implement print to terminal
        abstract public printfImpl(string fmt, ...);

        #! To be implemented to execute remote (via websocket) or local command
        /** (via @ref DebugProgramControl::DebugProgramControl "DebugProgramControl")
        */
        abstract public *hash<auto> doCommandImpl(hash<auto> data);

        public *hash<auto> doCommand(hash<auto> data, bool print) {
            debug("Cmd: %y", data);
            *hash<auto> ret = doCommandImpl(data);
            if (ret) {
                debug("Response: %y", ret);
                if (ret.type == DebugResponseType::Error) {
                    # the error of the debug server, with its code
                    throw ret.result.err, ret.result.desc;
                }
                if (print) {
                    printData(ret);
                }
            }
            return ret;
        }

        public showFileNames(*hash<auto> fn) {
            foreach string k in (keys fn) {
                printfImpl("%s", k);
                if (fn{k}) {
                    foreach string k2 in (keys fn{k}) {
                        printfImpl("  @%5d %s", fn{k}{k2}, k2);
                    }
                    printfImpl("");
                }
            }
        }

        public showPrograms(hash<auto> ph, bool show_interrupted) {
            # get max name width
            int max = 1;
            foreach hash<auto> h in (ph.pairIterator()) {
                if (!h.value.scriptName.val()) {
                    @debug {
                        printfImpl("MISSING: %y = %y\n", h.key, h.value);
                    }
                    delete ph{h.key};
                    continue;
                }
                int len;
                if (!h.value.scriptName.val())
                    len = (ph{h.key}.scriptName = sprintf("n/a path %y", h.value.scriptPath)).length();
                else
                    len = h.value.scriptName.length();
                if (len > max) {
                    max = len;
                }
            }
            string fmt = sprintf("%%s%%4d%%s: %%-%ds thr: %%2d dbg: %%d/%%d\n", max);
            auto pgmId = getContextValue('programId');
            foreach string id in (sort(keys ph, int sub (string l, string r) { return l.toInt() <=> r.toInt(); })) {
                printfImpl(fmt,
                    (show_interrupted && ph{id}.interrupted) ? 'S':' ', id, id == pgmId ? "*" : " ",
                    ph{id}.scriptName, ph{id}.threads.size(), ph{id}.debugging, ph{id}.debugged);
            }
        }

        public string formatBreakpoint(hash<auto> b) {
            string enabledStr = b.enabled == "true" ? tc.success("true") : tc.warning(b.enabled ?? "");
            string rv = sprintf(" id: %s  pgmId: %s enabled: %-5s policy: %-6s threads: %y",
                tc.number(sprintf("%-4d", b.id)),
                tc.number(sprintf("%-4d", b.programId)),
                enabledStr, b.policy, b.threads);
            # the condition, hit condition, log message and number of hits of the breakpoint
            if (b.condition) {
                rv += sprintf(" condition: %s", tc.value(b.condition));
            }
            if (b.hitCondition) {
                rv += sprintf(" hitcondition: %s", tc.value(b.hitCondition));
            }
            if (b.logMessage) {
                rv += sprintf(" log: %s", tc.value(b.logMessage));
            }
            if (exists b.hits) {
                rv += sprintf(" hits: %s", tc.number(string(b.hits)));
            }
            return rv + "\n";
        }

        #! Sets or removes the condition, hit condition or log message of a breakpoint
        /** @param id the ID of the breakpoint
            @param cmd the command of the option: \c condition, \c hitcondition or \c log
            @param args the words of the value; without words, the option is removed
        */
        public setBreakpointOption(softint id, string cmd, softlist args) {
            doCommand({
                "cmd": sprintf("program//breakpoint/%d/%s/set", id, cmd),
                "value": args ? args.join(" ") : NOTHING,
            }, True);
        }

        #! Returns a location of a file of the current program with a 1-based character column
        /** @param file the file
            @param line the line
            @param byteColumn the 0-based byte column, or a negative value if unknown
        */
        public string formatLocation(string file, int line, int byteColumn) {
            if (byteColumn < 0) {
                return sprintf("%s:%d", file, line);
            }
            return sprintf("%s:%d:%d", file, line,
                DebugCommandLine::getCharColumn(getSourceLine(file, line), byteColumn));
        }

        #! Shows a variable or an element, key or member of it, or sets it to the value of an expression
        /** @param args the words of the command: the path of the value, and optionally \c "=" and an expression
        */
        public variableCommand(softlist args) {
            string text = args.join(" ");
            # the index of the first element, key or member that is shown
            int start = 0;
            *list<*string> page = (text =~ x/^\s*([^=\s]+)\s+from\s+([0-9]+)\s*$/);
            if (page) {
                text = page[0];
                start = int(page[1]);
            }
            *list<*string> m = (text =~ x/^\s*([^=\s]+)\s*(?:=\s*(.*))?$/s);
            if (!m) {
                throw "DEBUG-COMMAND", "syntax: thread var name[.member|[index]|{key}...] [= expression]";
            }
            hash<auto> pv = DebugCommandLine::parseVariablePath(m[0]);
            int tid = checkThreadId();
            # a local variable of the current frame, or a global variable
            *list<auto> locals = doCommand({"cmd": "thread/local//list", "tid": tid}, False).result;
            hash<auto> cmd = {
                "tid": tid,
                "root": inlist(pv.name, locals) ? {"local": pv.name} : {"global": pv.name},
                "path": pv.path,
            };
            if (exists m[1]) {
                if (!m[1].val()) {
                    throw "DEBUG-COMMAND", "the expression of the value is missing";
                }
                cmd.cmd = "thread/variable/set";
                cmd.expression = m[1];
                hash<auto> r = doCommand(cmd, False).result;
                printfImpl("%s = %s %s\n", m[0], r.type, r.value);
                return;
            }
            cmd.cmd = "thread/variable/get";
            hash<auto> r = doCommand(cmd, False).result;
            # the elements, keys and members of a list, hash or object
            if (r.indexed || r.named) {
                r = doCommand(cmd + {"children": True, "start": start, "count": MaxShownChildren}, False).result;
            }
            printfImpl("%s: %s %s\n", m[0], r.type, r.value);
            foreach hash<auto> c in (r.children) {
                printfImpl("  %s: %s %s\n", c.name, c.type, c.value);
            }
            int total = r.indexed ?? r.named ?? 0;
            int rest = total - start - r.children.size();
            if (rest > 0) {
                printfImpl("  ... %d more (thread var %s from %d)\n", rest, m[0], start + r.children.size());
            }
        }

        #! Returns the name of the variable and the keys of a path of a value, as \c "h.lines[1]" or \c "h{key}"
        /** @param p the path: a variable name and optionally \c .member, \c [index], \c {key} or \c {"key"} parts

            @return a hash with \c name, the name of the variable, and \c path, the list of the keys

            @throw DEBUG-COMMAND the path is invalid
        */
        static hash<auto> parseVariablePath(string p) {
            *list<*string> m = (p =~ x/^([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(.*)$/);
            if (!m) {
                throw "DEBUG-COMMAND", sprintf("invalid variable path %y; expecting a variable name", p);
            }
            list<auto> path = ();
            string rest = m[1] ?? "";
            while (rest.val()) {
                *list<*string> k = (rest =~ x/^\.([A-Za-z_][A-Za-z0-9_]*)(.*)$/);
                if (k) {
                    push path, k[0];
                } else {
                    k = (rest =~ x/^\[([0-9]+)\](.*)$/);
                    if (k) {
                        push path, int(k[0]);
                    } else {
                        k = (rest =~ x/^\{"([^"]*)"\}(.*)$/) ?? (rest =~ x/^\{([^}"]*)\}(.*)$/);
                        if (!k) {
                            throw "DEBUG-COMMAND", sprintf("invalid variable path %y at %y; expecting .member, "
                                "[index] or {key}", p, rest);
                        }
                        push path, k[0];
                    }
                }
                rest = k[1] ?? "";
            }
            return {"name": m[0], "path": path};
        }

        #! Resumes a stopped thread; with stopAllThreads, the other stopped threads of the program continue with it
        /** @param data the go command
            @param runState the run state, if given; a step of the thread is noted, so that its next stop is not taken
            for a stop that another thread requested
        */
        public goThread(hash<auto> data, *string runState) {
            string pid = string(checkProgramId());
            string tid = string(data.tid);
            if (stopAllThreads) {
                list<string> others;
                {
                    AutoLock al(stopAllLock);
                    # a thread that stops later for a stop requested before is resumed (see processEvent()), and no
                    # thread is requested to stop for an earlier stop any more (see stopOtherThreads())
                    ++stopAllGeneration;
                    remove stopAllRequests{pid};
                    others = (keys stoppedThreads{pid}) ?? ();
                }
                foreach string other in (others) {
                    if (other == tid) {
                        continue;
                    }
                    try {
                        # the command does not wait for the thread to stop again
                        doCommand({"cmd": "thread/go/run", "tid": int(other), "wait": False}, False);
                    } catch (hash<ExceptionInfo> ex) {
                        # a thread that is no longer stopped
                        debug("thread %s not resumed: %s: %s", other, ex.err, ex.desc);
                    }
                }
            }
            if (runState && runState != "run") {
                AutoLock al(stopAllLock);
                userStops{pid}{tid} = True;
            }
            doCommand(data, True);
        }

        #! Adds a display expression and shows it for the current thread, if it is stopped
        public addDisplay(string expr) {
            {
                AutoLock al(displayLock);
                push displays, expr;
            }
            *softint tid = getContextValue("threadId");
            if (exists tid) {
                showDisplays(tid, displays.size() - 1);
            }
        }

        #! Removes a display expression by its number, or all of them
        public removeDisplay(*int n) {
            AutoLock al(displayLock);
            if (!exists n) {
                displays = ();
                return;
            }
            if (n < 1 || n > displays.size()) {
                throw "DEBUG-COMMAND", sprintf("there is no display expression %d", n);
            }
            splice displays, n - 1, 1;
        }

        #! Lists the display expressions
        public listDisplays() {
            list<string> l;
            {
                AutoLock al(displayLock);
                l = displays;
            }
            if (!l) {
                printfImpl("no display expressions\n");
            }
            foreach string e in (l) {
                printfImpl("%d: %s\n", $# + 1, e);
            }
        }

        #! Shows the display expressions for a stopped thread
        /** @param tid the thread
            @param only the index of the only expression that is shown, if given
        */
        public showDisplays(int tid, *int only) {
            list<string> l;
            {
                AutoLock al(displayLock);
                l = displays;
            }
            foreach string e in (l) {
                if (exists only && $# != only) {
                    continue;
                }
                try {
                    *hash<auto> r = doCommand({"cmd": "thread/evaluate", "tid": tid, "expression": e}, False)
                        .result;
                    printfImpl("%d: %s = %s\n", $# + 1, e, r.value);
                } catch (hash<ExceptionInfo> ex) {
                    # as an expression with a variable of another frame or before the variable is declared
                    printfImpl("%d: %s: cannot be shown: %s\n", $# + 1, e, ex.desc);
                }
            }
        }

        #! Shows the display expressions of the thread that stopped since the last command, before the next command
        public showPendingDisplays() {
            *int tid;
            {
                AutoLock al(displayLock);
                tid = remove pendingDisplayTid;
            }
            if (exists tid) {
                showDisplays(tid);
            }
        }

        #! Returns the number of the only call of the statement of the current thread that can be stepped into
        /** @throw DEBUG-COMMAND the statement makes no call, or more than one, which are listed
        */
        public string getOnlyStepInTarget() {
            list<auto> stack = doCommand({"cmd": "thread/stack", "tid": checkThreadId()}, False).result ?? ();
            if (!stack[0].statementid) {
                throw "DEBUG-COMMAND", "the thread is not paused at a statement; \"go step\" runs it to the next one";
            }
            list<auto> targets = doCommand({
                "cmd": sprintf("program/%d/statement/stepintargets", checkProgramId()),
                "value": {"id": stack[0].statementid},
            }, False).result ?? ();
            if (targets.size() == 1) {
                return "1";
            }
            if (!targets) {
                throw "DEBUG-COMMAND", "the current statement makes no call to step into";
            }
            foreach hash<auto> t in (targets) {
                printfImpl("  %d: %s (%s)\n", $# + 1, t.name, formatLocation(stack[0].file, t.start_line,
                    t.start_column));
            }
            throw "DEBUG-COMMAND", "the statement makes more than one call; choose one: go stepinto <n>";
        }

        #! Notes a stop of a thread that the user requested, so that it is not taken for a stop of another thread
        public noteUserStop(softstring pgmId, softstring tid) {
            AutoLock al(stopAllLock);
            userStops{pgmId}{tid} = True;
        }

        #! Processes an event of the debugger for stopping all threads together; see stopAllThreads
        /** Called for each event that the client receives, in the thread that delivers it; the commands to other
            threads are sent in a background thread, as the thread that delivers the event can be a stopped thread of
            the program or the thread that receives the responses of the debug server.

            When a thread stops, the other running threads of its program are requested to stop; a thread that stops
            for such a request after the threads continued is resumed.
        */
        public processEvent(hash<auto> data) {
            if (data.type != DebugResponseType::Event || !data.pgmid || !data.tid) {
                return;
            }
            # a thread that starts in a program that has started runs until a breakpoint, as without the debugger, and a
            # thread that ends its code or leaves the program continues, as there is no code to debug
            if (DebugCommandLine::isThreadStart(data) || DebugCommandLine::isThreadEnd(data)) {
                {
                    AutoLock al(stopAllLock);
                    # a thread that starts while all threads of its program are stopped together stays stopped with
                    # them, and continues with them (see goThread())
                    if (stopAllThreads && DebugCommandLine::isThreadStart(data)
                        && (select keys stoppedThreads{data.pgmid}, $1 != string(data.tid))) {
                        stoppedThreads{data.pgmid}{data.tid} = True;
                        return;
                    }
                    autoResumed{data.tid} = True;
                }
                background resumeThreadInBackground(data.tid);
                return;
            }
            string pid = string(data.pgmid);
            string tid = string(data.tid);
            if (data.cmd == DebugEventCmd::Run) {
                AutoLock al(stopAllLock);
                remove stoppedThreads{pid}{tid};
                return;
            }
            if (data.cmd != DebugEventCmd::Interrupt) {
                return;
            }
            # the display expressions of the stopped thread
            {
                AutoLock al(displayLock);
                if (displays) {
                    if (waitsForStops) {
                        pendingDisplayTid = data.tid;
                    } else {
                        background showDisplays(data.tid);
                    }
                }
            }
            bool requested;
            bool userStop;
            int generation;
            {
                AutoLock al(stopAllLock);
                generation = stopAllGeneration;
                stoppedThreads{pid}{tid} = True;
                requested = boolean(remove stopAllRequests{pid}{tid});
                userStop = boolean(remove userStops{pid}{tid});
            }
            if (!stopAllThreads || inlist(data.func, ("attach", "detach", "exit")) || requested) {
                return;
            }
            # a stop for a stop that was requested before the threads continued: the thread continues
            if (data.func == "step" && !data.bkptid && !userStop) {
                {
                    AutoLock al(stopAllLock);
                    autoResumed{tid} = True;
                }
                background resumeThreadInBackground(int(tid));
                return;
            }
            # counted before the event ends the wait of a command, so that the next command is processed when the
            # other threads are requested to stop; see waitForStopRequests()
            stopAllPending.inc();
            on_error stopAllPending.dec();
            background stopOtherThreads(pid, tid, generation);
        }

        #! Waits until the requests to stop the other threads of a program, after a thread stopped, have been sent
        public waitForStopRequests() {
            stopAllPending.waitForZero();
        }

        #! Resumes a thread that stopped for a stop that is no longer requested
        private resumeThreadInBackground(int tid) {
            try {
                doCommand({"cmd": "thread/go/run", "tid": tid, "wait": False}, False);
            } catch (hash<ExceptionInfo> ex) {
                debug("thread %d not resumed: %s: %s", tid, ex.err, ex.desc);
            }
        }

        #! Requests the other running threads of a program to stop
        /** @param pid the program
            @param tid the thread that stopped
            @param generation the generation of the stop; when the threads have continued since, which increments the
            generation, no thread is requested to stop
        */
        private stopOtherThreads(string pid, string tid, int generation) {
            on_exit stopAllPending.dec();
            try {
                *list<auto> threads = doCommand({"cmd": "program//list"}, False).result{pid}.threads;
                foreach softstring other in (threads) {
                    {
                        AutoLock al(stopAllLock);
                        if (generation != stopAllGeneration) {
                            return;
                        }
                        if (other == tid || stoppedThreads{pid}{other} || stopAllRequests{pid}{other}) {
                            continue;
                        }
                        # noted before the request, as the thread can stop before the command returns
                        stopAllRequests{pid}{other} = True;
                    }
                    try {
                        doCommand({"cmd": sprintf("program/%s/thread/%s/stop", pid, other)}, False);
                    } catch (hash<ExceptionInfo> ex) {
                        # a thread that has ended in the meantime
                        AutoLock al(stopAllLock);
                        remove stopAllRequests{pid}{other};
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                debug("the threads of program %s not stopped: %s: %s", pid, ex.err, ex.desc);
            }
        }

        public string formatStatement(hash<auto> stmt) {
            string res = sprintf(" @ %s %s:%s-%s",
                tc.number(sprintf("%-5d", stmt.id)),
                tc.value(stmt.file),
                tc.number(string(stmt.start_line + stmt.offset)),
                tc.number(string(stmt.end_line + stmt.offset)));
            # the 1-based character column, if given
            if (exists stmt.column) {
                res += sprintf(" column %s", tc.number(string(stmt.column)));
            }
            if (stmt.source) {
                res += sprintf(" (%s:%s-%s)",
                    tc.value(stmt.source),
                    tc.number(string(stmt.start_line)),
                    tc.number(string(stmt.end_line)));
            }
            return res + "\n";
        }

        public showBreakpoints(*list<auto> bkpts) {
            foreach hash<auto> b in (sort(bkpts, int sub (hash l, hash r) { return l.id <=> r.id; })) {
                printfImpl(formatBreakpoint(b));
                if (b.statements) {
                    foreach hash<auto> stmt in (b.statements) {
                        printfImpl("  "+formatStatement(stmt));
                    }
                    printfImpl("\n");
                }
            }
        }

        public string getThreadStackStr(hash<auto> frame) {
            # a frame of a call stack that the program gives as a typed hash has no keys of the debugger
            hash<auto!> lh = frame;
            string str;
            if (lh.function.val())
                str += sprintf("%s()", lh.function);
            else
                str += "<unknown function>";
            str += " (";
            string loc;
            if (lh.source) {
                loc += sprintf("%s:%d", lh.source, lh.line + lh.offset);
            } else {
                loc += sprintf("%s", lh.file ?? "<unknown>");
                if (lh.line > 0) {
                    loc += sprintf(":%d", lh.line);
                    # the 1-based character column of the statement of the frame, if known
                    if (lh.column >= 0 && exists lh.column && lh.file) {
                        loc += sprintf(":%d", DebugCommandLine::getCharColumn(getSourceLine(lh.file, lh.line),
                            lh.column));
                    }
                }
            }
            if (lh.endline > 0) {
                loc += sprintf("-%d", lh.endline + lh.offset);
            }
            if (loc) {
                str += loc + " ";
            }
            str += lh.type;
            str += ")";
            if (lh.programid) {
                str += sprintf(" pgm:%d", lh.programid);
            }
            if (lh.statementid) {
                str += sprintf(" stmtid:%d", lh.statementid);
            }
            return str;
        }

        #! Returns the frames of a call stack that are shown, with the names of their functions
        /** Each frame of a call stack gives a function and the location of its call, which is in the function of the
            next frame; the location of the first frame is the statement that the thread is paused at, so each frame is
            named after the function of the next one.  The frames at the end that are not in the program of the first
            frame, as of the debugger, are not shown, nor the call of the code of a thread by the operator that started
            it, whose location is in another thread.

            @return the frames that are shown, with the \c name key; their indexes are the frame numbers
        */
        static list<hash<auto>> getShownFrames(list<auto> stack) {
            *int pgm_id = stack[0].programid;
            int n = stack.size();
            while (n > 0 && exists pgm_id && exists stack[n - 1].programid && stack[n - 1].programid != pgm_id) {
                --n;
            }
            int shown = n;
            if (shown > 1 && stack[shown - 1].type == "new-thread") {
                --shown;
            }
            list<hash<auto>> rv = ();
            for (int i = 0; i < shown; ++i) {
                hash<auto!> frame = stack[i];
                frame.name = (i + 1 < n && stack[i + 1].function.val()) ? stack[i + 1].function : TopLevelFrameName;
                push rv, frame;
            }
            return rv;
        }

        #! Returns the text of a frame of getShownFrames(), such as <tt>add() at main.q:3:5</tt>
        public string formatFrame(hash<auto> frame) {
            string loc;
            if (frame.source) {
                loc = sprintf("%s:%d", frame.source, frame.line + frame.offset);
            } else if (frame.file) {
                loc = frame.file;
                if (frame.line > 0) {
                    loc += sprintf(":%d", frame.line);
                    # the 1-based character column of the statement of the frame, if known
                    if (exists frame.column && frame.column >= 0) {
                        loc += sprintf(":%d", DebugCommandLine::getCharColumn(getSourceLine(frame.file, frame.line),
                            frame.column));
                    }
                }
            }
            string name = frame.name == TopLevelFrameName ? frame.name : frame.name + "()";
            return loc ? sprintf("%s at %s", tc.value(name), loc) : tc.value(name);
        }

        #! Shows the call stack of a thread; the current frame is marked with \c *
        /** @return True if the thread has frames to show; see getShownFrames()
        */
        public bool showThreadStack(softint tid, list<auto> stack) {
            list<hash<auto>> frames = DebugCommandLine::getShownFrames(stack);
            if (!frames) {
                return False;
            }
            printfImpl("Call stack of thread %d:\n", tid);
            foreach hash<auto> frame in (frames) {
                printfImpl("%s %-2d %s\n", frame.current ? "*" : " ", $#, formatFrame(frame));
            }
            return True;
        }

        # src keys: code, [startLine], [currentLine]
        public *string formatSource(*hash<auto> src) {
            if (exists src.code) {
                if (src.startline > 0) {
                    # add line numbers with color
                    list<auto> l = src.code.split("\n");
                    int numWidth = int(log10(src.startline + l.size())) + 1;
                    string fmt = sprintf("%%%dd", numWidth);
                    foreach string s in (\l) {
                        string lineNum = sprintf(fmt, src.startline + $#);
                        bool isCurrent = exists src.currentline && src.currentline == src.startline + $#;
                        string mark = "";
                        if (exists src.currentline) {
                            mark = isCurrent ? tc.error(">") : " ";
                        }
                        s = tc.dim(lineNum) + mark + ": " + s;
                    }
                    return l.join("\n");
                } else {
                    return src.code;
                }
            }
        }
        public processGetSource(string type, list<auto> path, list<auto> args) {
            hash<auto> data.cmd = 'program/'+checkProgramId()+'/'+type+'/source';
            data{type} = pop path;
            if (args[0] != "") {
                data.line = int(args[0]);
                if (args[1] != "") {
                    data.count = int(args[1]);
                }
            }
            *hash<auto> src = doCommand(data, False).result;
            if (src.checksum) {
                printfImpl("%s: %s", src.checksum.algorithm, src.checksum.cs);
            }
            printfImpl("%s", formatSource(src));
        }

        static public validateInt(DebugCommandLine dcl, softlist path, softlist val) {
            if (val[0] =~ /[^0-9]/) {
                throw "CMD-ARG-ERROR", sprintf("%s: parameter %y is not integer", path.join(' '), val[0]);
            }
        }

        public auto parseValue() {
            return AbstractDebugControl::serialize(parse_to_qore_value(argv.lsize() == 1 ? argv[0] : argv));
        }

        public auto getContextValue(string key) {
            rwlContext.readLock();
            on_exit rwlContext.readUnlock();
            return cx{key};
        }

        public setContextValue(string key, auto value) {
            rwlContext.writeLock();
            on_exit rwlContext.writeUnlock();
            cx{key} = value;
        }

        public hash<auto> getStatementValue(list<auto> args) {
            if (!args) {
                throw "DEBUG-PROGRAM-HELPER", sprintf("Statement description is missing");
            }
            string s;
            s = trim(shift args);
            if (s =~ /^[0-9]+$/) {
                return {'file': '', 'lineno': int(s)};
            }
            # a line and a column, for a statement of a line with more than one statement
            *list<*string> lc = (s =~ x/^([0-9]+):([0-9]+)$/);
            if (lc && !args) {
                return getLineColumnValue('', int(lc[0]), int(lc[1]));
            }
            *list<auto> l = s =~ x/^(.+)\((.*)\)$/;
            if (l) {
                list<auto> la = ();
                foreach string s2 in (split(',', l[1])) {
                    s2 = trim(s2);
                    if (s2 != "") {
                        push la, s2;
                    }
                }
                return {'function': l[0], 'args': la};
            }
            l = s =~ x/^#([0-9]+)$/;
            if (l) {
                return {'id': int(l[0])};
            }
            if (args[0] =~ /^[0-9]+$/) {
                return {'file': s, 'lineno': int(args[0])};
            }
            lc = (args[0] =~ x/^([0-9]+):([0-9]+)$/);
            if (lc) {
                return getLineColumnValue(s, int(lc[0]), int(lc[1]));
            }
            # a function given by its name only, which must have one variant
            if (!args && s =~ /^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$/) {
                return {'function': s};
            }
            throw "DEBUG-PROGRAM-HELPER", sprintf("Wrong statement identification %y; expecting <line>[:<column>], "
                "<file> <line>[:<column>], <function>, <function>(<param types>) or #<statement id>", s);
        }

        #! Returns the statement value of a line and a column
        /** @param file the file, or an empty string for the only file of the program
            @param line the line
            @param column the 1-based column, counted in characters; the debugger counts bytes from 0, which are
            counted with the text of the line, or one byte per character if the text is not available
        */
        private hash<auto> getLineColumnValue(string file, int line, int column) {
            return {
                'file': file,
                'lineno': line,
                'column': DebugCommandLine::getByteColumn(getSourceLine(file, line), column),
            };
        }

        #! Returns the 0-based byte column of a 1-based character column of a line
        /** @param line the text of the line, if known; without it, a character is a byte
            @param column the 1-based column, counted in characters
        */
        static int getByteColumn(*string line, int column) {
            if (column <= 1) {
                return 0;
            }
            if (!exists line) {
                return column - 1;
            }
            int len = line.length();
            # a column after the end of the line
            if (column - 1 > len) {
                return line.size() + column - 1 - len;
            }
            return line.substr(0, column - 1).size();
        }

        #! Returns the 1-based character column of a 0-based byte column of a line
        /** @param line the text of the line, if known; without it, a character is a byte
            @param byteColumn the 0-based column, counted in bytes
        */
        static int getCharColumn(*string line, int byteColumn) {
            if (!exists line || byteColumn <= 0) {
                return byteColumn + 1;
            }
            int bytes = 0;
            int chars = 0;
            int len = line.length();
            for (int i = 0; i < len && bytes < byteColumn; ++i) {
                bytes += line[i].size();
                ++chars;
            }
            return chars + 1 + (bytes < byteColumn ? byteColumn - bytes : 0);
        }

        #! Returns a line of a file of the current program as the debugger gives it, or @ref nothing
        /** @param file the file, also given by the end of its path, or an empty string for the only file of the
            program
            @param line the line
        */
        public *string getSourceLine(string file, int line) {
            try {
                int pgmId = checkProgramId();
                *hash<auto> files = doCommand({"cmd": sprintf("program/%d/file/list", pgmId)}, False).result;
                *string name;
                foreach string f in (keys files) {
                    if ((!file.val() && files.size() == 1) || f == file
                        || (file.val() && f.size() > file.size() && f.substr(-(file.size() + 1)) == "/" + file)) {
                        name = f;
                        break;
                    }
                }
                if (!name) {
                    return;
                }
                return doCommand({
                    "cmd": sprintf("program/%d/file/source", pgmId),
                    "file": name,
                    "line": line,
                    "count": 1,
                }, False).result.code;
            } catch (hash<ExceptionInfo> ex) {
                # the text of the line is not available
            }
        }


        private hash<auto> splitCmd(string line) {
            hash<auto> ret = {'args': (), 'pos': ()};
            int i = 0;
            int q = 0;
            string s = '';
            int start = -1;
            StringIterator it = line.iterator();
            while (it.next()) {
                char c = it.getValue();
                if (start < 0 && s == '' && c != c' ') {
                    start = i;
                }
                switch (c) {
                case c' ':
                    if (q == 0) {
                        if (s != '') {
                            push ret.args, s;
                            push ret.pos, {'start': start, 'end': i};
                            s = '';
                        }
                        start = -1;
                    } else {
                        s += c;
                    }
                    break;
                case c"'":
                    if (q == 0) {
                        q = 1;
                    } else if (q == 1) {
                        q = 0;
                    } else {
                        s += c;
                    }
                    break;
                case c"\"":
                    if (q == 0) {
                        q = 2;
                    } else if (q == 2) {
                        q = 0;
                    } else {
                        s += c;
                    }
                    break;
                case c"\\":
                    ++i;
                    if (it.next()) {
                        c = it.getValue();
                        switch (c) {
                        case c'n':
                            s += "\n";
                            break;
                        case c'r':
                            s += "\r";
                            break;
                        case c't':
                            s += "\t";
                            break;
                        case c'0':
                            s += "\0";
                            break;
                        default:
                            s += c;
                        }
                    } else {
                        s += c"\\";
                    }
                    break;
                default:
                    s += c;
                }
                i++;
            }
            if (q != 0) {
                throw "DEBUG-PROGRAM-HELPER", sprintf("Unmatched quotes in %y", line);
            }
            if (s != '') {
                push ret.args, s;
                push ret.pos, {'start': start, 'end': i};
            }
            return ret;
        }

        private string escapeArg(softstring s) {
            string rv = "";
            foreach char c in (iterate s) {
                switch (c) {
                    case c'\n':
                        rv += "\\n";
                        break;
                    case c'\r':
                        rv += "\\r";
                        break;
                    case c'\t':
                        rv += "\\t";
                        break;
                    case c'\0':
                        rv += "\\0";
                        break;
                    case c"\\":
                    case c' ':
                    case c"\"":
                    case c"'":
                        rv += c"\\";
                        rv += c;
                        break;
                    default:
                        rv += c;
                }
            }
            return rv;
        }

        #! Returns the number of frames of the \c up and \c down commands: the first argument, 1 by default
        static int getFrameCount(softlist args) {
            if (!args) {
                return 1;
            }
            if (args.size() > 1 || args[0] !~ /^[0-9]+$/ || int(args[0]) < 1) {
                throw "DEBUG-COMMAND", sprintf("expecting a number of frames; got %y", args.join(" "));
            }
            return int(args[0]);
        }

        #! Selects the frame that is the given number of frames up (positive) or down (negative) from the current one
        public moveFrame(int frames) {
            int current = doCommand({"cmd": "thread/debug/frame/get", "tid": checkThreadId()}, False).result ?? 0;
            selectFrame(current + frames, frames > 0 ? "the call stack has no frame further up"
                : "the current frame is the innermost frame");
        }

        #! Selects a frame of the call stack of the current thread and shows it with its line of code
        /** @param n the number of the frame, as \c bt shows it
            @param range_error the error if the frame does not exist; the range of the frames by default
        */
        public selectFrame(int n, *string range_error) {
            int tid = checkThreadId();
            list<hash<auto>> frames = DebugCommandLine::getShownFrames(doCommand({"cmd": "thread/stack", "tid": tid},
                False).result ?? ());
            if (n < 0 || n >= frames.size()) {
                throw "DEBUG-COMMAND", range_error ?? sprintf("there is no frame %d; the frames are numbered from 0 "
                    "to %d (\"bt\")", n, frames.size() - 1);
            }
            doCommand({"cmd": "thread/debug/frame/set", "tid": tid, "value": n}, False);
            printfImpl("Frame %d: %s\n", n, formatFrame(frames[n]));
            hash<auto> frame = frames[n];
            if (frame.file && frame.line > 0) {
                *string line = getSourceLine(frame.file, frame.line);
                if (exists line) {
                    printfImpl("%s\n", formatSource({"code": line, "startline": frame.line,
                        "currentline": frame.line}));
                }
            }
        }

        #! Runs the commands of a file, one on each line
        /** Empty lines and lines that start with \c # are ignored.  A command that resumes a thread returns when a
            thread pauses again, as with a script of commands on the input, so the next command is processed at the
            pause that it is written for.  The first command that fails ends the file.

            @param fn the file
            @return @ref False if a command ended the debugger, as \c quit

            @throw DEBUG-COMMAND-FILE a command failed; its error and the line of the file are shown
            @throw DEBUG-COMMAND the file cannot be read; the files run one another more than MaxCommandFileDepth times
        */
        public bool runCommandFile(string fn) {
            if (commandFileDepth >= MaxCommandFileDepth) {
                throw "DEBUG-COMMAND", sprintf("%s: more than %d files of commands run one another", fn,
                    MaxCommandFileDepth);
            }
            string text;
            try {
                text = ReadOnlyFile::readTextFile(fn);
            } catch (hash<ExceptionInfo> ex) {
                throw "DEBUG-COMMAND", sprintf("cannot read the commands of %y: %s", fn, ex.desc);
            }
            ++commandFileDepth;
            bool waits = waitsForStops;
            waitsForStops = True;
            on_exit {
                waitsForStops = waits;
                --commandFileDepth;
            }
            foreach string line in (text.split("\n")) {
                trim line;
                if (!line.val() || line =~ /^#/) {
                    continue;
                }
                # the display expressions of a thread that paused at the last command
                showPendingDisplays();
                if (!processCmdLine(line)) {
                    return False;
                }
                # the error of the command is shown; the file ends at it, which is shown once, by the file of the
                # command, also for files that run this file
                if (exists commandError) {
                    string err = remove commandError;
                    if (err != CommandFileFailed) {
                        printfImpl("%s %s:%d: the command failed, so the rest of the file is not run\n",
                            tc.error("Error:"), fn, $# + 1);
                    }
                    throw "DEBUG-COMMAND-FILE", CommandFileFailed;
                }
            }
            return True;
        }

        #! Returns the settings of the debugger that a session file keeps; see saveSession()
        public hash<auto> getSessionSettings() {
            hash<auto> rv = {
                "stopall": stopAllThreads,
                "exceptionFilters": doCommand({"cmd": "exception/filter/get"}, False).result ?? (),
            };
            {
                AutoLock al(displayLock);
                rv.displays = displays;
            }
            return rv;
        }

        #! Saves the breakpoints of the debugged programs and the settings of the debugger to a file
        /** @see loadSession()
        */
        public saveSession(string fn) {
            hash<auto> sh.session.programs = doCommand({"cmd": "session/get"}, False).result ?? {};
            sh.settings = getSessionSettings();
            File f();
            f.open2(fn, O_CREAT | O_TRUNC | O_WRONLY);
            f.write(make_yaml(sh));
        }

        #! Runs a command given by its words, as the shortcut commands do
        public runCommand(list<auto> words) {
            processCmdLine(words.join(" "));
        }

        #! Shows the local variables of the current frame with their values
        public showLocals() {
            int tid = checkThreadId();
            *list<auto> names = doCommand({"cmd": "thread/local//list", "tid": tid}, False).result;
            if (!names) {
                printfImpl("no local vars in frame\n");
                return;
            }
            foreach string name in (names) {
                *hash<auto> vh = doCommand({"cmd": "thread/local/" + name + "/get", "tid": tid}, False);
                printVar(name, vh.result.value);
            }
        }

        #! Returns the text of an error for the user: its description, and its code unless it is an error of a command
        static string getErrorText(hash<ExceptionInfo> ex) {
            return (ex.err == "DEBUG-COMMAND" || ex.err == "CMD-ARG-ERROR")
                ? ex.desc
                : sprintf("%s (%s)", ex.desc, ex.err);
        }

        #! Returns the description of a command, or of its argument if the command has none
        static *string getCmdDesc(hash<auto> cmd) {
            return cmd.desc ?? cmd."*".desc ?? cmd."**".desc;
        }

        #! Returns a line for each command of the given commands, with its aliases and the first sentence of its
        #! description
        public string getVariantHelp(hash<auto> v) {
            hash<string, string> names;
            foreach string k in (sort(keys(v))) {
                if (!exists v{k}.aliasOf) {
                    names{k} = v{k}.aliases ? sprintf("%s (%s)", k, sort(v{k}.aliases).join(', ')) : k;
                }
            }
            int width = max(map $1.length(), names.iterator()) ?? 0;
            string rv;
            foreach hash<auto> i in (names.pairIterator()) {
                *string desc = DebugCommandLine::getCmdDesc(v{i.key});
                # the description without its usage, which "help <command>" shows
                if (desc) {
                    desc =~ s/(\.)[ \n].*/$1/s;
                }
                rv += sprintf("  %s%s  %s\n", i.value, strmul(" ", width - i.value.length()), desc ?? "");
            }
            return rv;
        }

        public string listVariantCmds(hash<auto> v) {
            list<auto> r;
            foreach string k in (sort(keys(v))) {
                if (!exists v{k}.aliasOf) {
                    if (v{k}.aliases) {
                        push r, sprintf("%s (%s)", k, sort(v{k}.aliases).join(', '));
                    } else {
                        push r, k;
                    }
                }
            }
            return r.join(', ');
        }

        public *hash<auto> findCmd(list<auto> args, int opts = 0, *reference<int> last_param) {  /* public because it is needed from closure */
            hash<auto> result;
            result.path = ();
            # the nodes of the command tree are copied as untyped hashes, as a node whose values are all hashes is a
            # typed hash, and the name, aliases and variants are added to them
            hash<auto!> c = getCommands();
            last_param = 0;
            while (args) {
                bool doBreak = False;
                while (args) {
                    if ((opts & fcHelp) && exists c."*") {
                        # skip
                        c = c."*";
                    } else if (exists c.">") {
                        # static enum
                        # check for partial matches
                        hash<auto> aliases;
                        foreach string k in (keys c.">") {
                            if (c.">"{k}.alias) {
                                aliases{c.">"{k}.alias} += (k,);
                            }
                        }
                        if (!c.">"{args[0]}) {
                            list<auto> pm;
                            string arg;
                            # scan through the list and see if we have one possible match
                            foreach string k in (keys c.">") {
                                if (k.substr(0, args[0].size()) == args[0]) {
                                    pm += k;
                                    if (!exists arg) {
                                        arg = k;
                                    }
                                    else {
                                        # check if the second match is the same as the first through aliases
                                        # and only reset the argument if it is different
                                        if (c.">"{k}.alias != arg && c.">"{arg}.alias != k) {
                                            arg = "";
                                        }
                                    }
                                }
                            }

                            if (pm) {
                                # if there is only one variant, then use it immediately
                                if (arg.val() && (opts & fcExpandUniqueCmd)) {
                                    args[0] = arg;
                                }
                                if (args.size() == 1) { # only set variants on the last argument
                                    foreach string c2 in (pm) {
                                        hash<auto!> variant;
                                        if (!exists c.">"{c2}.alias) {
                                            variant = c.">"{c2};
                                            variant.aliases = aliases{c2};
                                        } else {
                                            variant = c.">"{c.">"{c2}.alias};
                                            variant.aliasOf = c.">"{c2}.alias;
                                            variant.aliases = aliases{variant.aliasOf};
                                        }
                                        result.variants{c2} = variant;
                                    }
                                }
                            }
                        }
                        if (exists c.">"{args[0]}) {
                            #remove result.cmd.">";
                            # follow aliases
                            if (*string alias = c.">"{args[0]}.alias) {
                                c = c.">"{alias};
                                c.name = alias;
                                push result.path, alias;
                                shift args;
                            }
                            else {
                                c = c.">"{args[0]};
                                c.name = args[0];
                                push result.path, shift args;
                            }
                            if (args[0] != "" && exists c.validate && (opts & fcValidate)) {
                                c.validate(self, result.path, args);
                            }
                            c.aliases = aliases{c.name};
                            result.cmd = c;
                            ++last_param;
                        } else {
                            if (exists c.fallback && (opts & fcFallback)) {
                                list<auto> sa = args;
                                c.fallback(self, result.path, \args);
                                if (args != sa) {
                                    continue;  # reprocess
                                }
                            }
                            if (exists result.variants) {
                                push result.path, shift args;
                                ++last_param;
                            }
                            doBreak = True;
                            break;
                        }
                    } else if (exists c."*") {
                        # dynamically enumerated
                        c = c."*";
                        if (args[0] != "" && exists c.validate && (opts & fcValidate)) {
                            c.validate(self, result.path, args);
                        }
                        if (args.size() == 1 && exists c{"enum"}) {
                            result.variants = c{"enum"};
                        }
                        push result.path, shift args;
                        ++last_param;
                        result.cmd = c;
                    } else if (exists c."**") {
                        c = c."**";
                        if (exists c{"enum"}) {
                            result.variants = c{"enum"};
                        }
                        push result.path, shift args;
                        ++last_param;
                        result.cmd = c;
                        doBreak = True;
                        break;
                    } else {
                        doBreak = True;
                        break;
                    }
                }
                if (doBreak) {
                    break;
                }
                if (exists c.fallback && (opts & fcFallback)) {
                    # last chance to modify args and continue
                    c.fallback(self, result.path, \args);
                }
            }
            result.args = args;
            return result;
        }

        public list<auto> getLineCompletions(string line) {
            hash<auto> h = splitCmd(line);
            if (line == '' || (h.pos && h.pos.last().end < line.size())) {
                h.args += '';
            } else {
                if (h.pos) {
                    # strip last args
                    splice line, h.pos.last().start;
                }
            }
            *hash<auto> cmd = findCmd(h.args, fcExpandUniqueCmd);
            if (cmd.variants) {
                *list<auto> v;
                switch (cmd.variants.typeCode()) {
                case NT_CLOSURE:
                case NT_CALLREF:
                    try {
                        v = cmd.variants(self, cmd.path, cmd.args);
                    } catch (hash<ExceptionInfo> ex) {
                    }
                    break;
                default:
                    v = keys cmd.variants;
                }
                list<auto> res = ();
                map (push res, line+escapeArg($1)), sort(v);
                return res;
            } else {
                return ();
            }
        }

        public bool processCmdLine(string line) {
            # the error of this command; a command that runs other commands, as a shortcut, reports theirs
            commandError = NOTHING;
            int last_param;
            list<auto> args = splitCmd(line).args;
            *hash<auto> cmd = findCmd(args, fcExpandUniqueCmd | fcValidate | fcFallback, \last_param);
            if (cmd.cmd) {
                @debug {
                    printfImpl("line:%y\n", line);
                }
                if (cmd.cmd.action) {
                    @debug {
                        printfImpl("exec:%y\n", cmd);
                    }
                    try {
                        auto rc = cmd.cmd.action(self, cmd.path, cmd.args);
                        if (rc) {
                            return False;
                        }
                    } catch (hash<ExceptionInfo> ex) {
                        # a file of commands that ended at a command that failed, which it has shown
                        if (ex.err == "DEBUG-COMMAND-FILE") {
                            commandError = ex.desc;
                        } else {
                            commandError = DebugCommandLine::getErrorText(ex);
                            showFullException ? printfImpl("%Y\n", ex)
                                : printfImpl("%s %s\n", tc.error("Error:"), commandError);
                        }
                    }
                } else {
                    if (cmd.variants.size() > 1) {
                        commandError = sprintf("%y: ambiguous subcommand", args[0]);
                        printfImpl("%s: %s, use more characters to specify among (%y)\n",
                            tc.error(sprintf("%y", args[0])), tc.warning("Ambiguous subcommand"),
                            keys cmd.variants);
                    } else if (last_param < args.size()) {
                        commandError = sprintf("%y: unknown parameter %y", args[0], args[last_param]);
                        string ctxt = (foldl $1 + " " + $2, (map $1, args, $# < last_param));
                        printfImpl("%s: %s %y; use <TAB> or \"help %s\" for more info\n",
                            tc.error(sprintf("%y", args[0])), tc.warning("Unknown parameter"),
                            args[last_param], ctxt);
                    } else {
                        string cmdstr = args.join(" ");
                        commandError = sprintf("%y: missing required parameter", cmdstr);
                        # list available subcommands in the error message
                        string hint = "";
                        *hash<auto> sub_cmd = findCmd(args + '', fcHelp);
                        if (sub_cmd.variants.typeCode() == NT_HASH) {
                            hint = sprintf("; expected: %s", listVariantCmds(sub_cmd.variants));
                        }
                        printfImpl("%s: %s%s; use <TAB> or \"help %s\" for more info\n",
                            tc.error(sprintf("%y", cmdstr)), tc.warning("missing required parameter"),
                            hint, cmdstr);
                    }
                }
            } else {
                if (cmd.variants.size() > 1) {
                    commandError = sprintf("%y: ambiguous command", args[0]);
                    printfImpl("%s: %s, use more characters to specify among (%y)\n",
                        tc.error(sprintf("%y", args[0])), tc.warning("Ambiguous command"),
                        keys cmd.variants);
                } else {
                    commandError = sprintf("%y: unknown command", args[0]);
                    printfImpl("%s: %s, use <TAB> key or \"help\" to get list of commands\n",
                        tc.error(sprintf("%y", args[0])), tc.warning("Unknown command"));
                }
            }
            return True;
        }

        #! Prints the value of a variable; a list or hash is printed in YAML style (the \c "%Y" format)
        public printVar(string name, hash<auto> value) {
            auto v = AbstractDebugControl::unserialize(value);
            if (v.typeCode() == NT_HASH || v.typeCode() == NT_LIST) {
                printfImpl("%s %s =\n", value.type, name);
                printHuman(v);
            } else {
                printfImpl("%s %s = %y\n", value.type, name, v);
            }
        }

        #! Prints a value in YAML style (the \c "%Y" format), with each line indented
        public printHuman(auto x, string indent = defaultIndent) {
            foreach string line in (sprintf("%Y", x).split("\n")) {
                printfImpl("%s%s\n", indent, line);
            }
        }

        public printData(auto data) {
            string outs;
            if (data.typeCode() == NT_HASH) {
                switch (data.type) {
                case DebugResponseType::Response:
                    # an empty result, as of a command that resumes a thread, and an acknowledgement are not shown
                    if (data.result.val() && data.result !== "ok") {
                        printHuman(data.result);
                    }
                    return; # already printed
                case DebugResponseType::Event:
                    if (data.cmd == DebugEventCmd::Output) {
                        # the output of a program of the debug server, as the program wrote it
                        printfImpl("%s", data.output);
                        return;
                    }
                    *string text = formatEvent(data);
                    # an event that is not shown, as the end of the code of a thread
                    if (!exists text) {
                        return;
                    }
                    outs = text;
                    break;

                case DebugResponseType::Error:
                    if (data.result.ex) {
                        outs = sprintf("cmd %y %s: %s\n", data.cmd, tc.error("server-side error"),
                            get_exception_string(data.result.ex));
                    } else {
                        outs = sprintf("cmd %y %s: %s: %s\n", data.cmd, tc.error("server-side error"),
                            tc.error(data.result.err), data.result.desc);
                    }
                    break;

                case DebugResponseType::Thread:
                    # no output for "thread" messages
                    return;
                }

                if (!exists outs) {
                    outs = sprintf("%Y", data);
                }
            } else {
                outs = sprintf("%Y", data);
            }
            printfImpl("%s\n", outs);
        }

        #! Returns the text of an event of the debug server, such as <tt>Paused at breakpoint 1 at main.q:3 (thread 2)</tt>
        /** An interrupt sets the current program and thread when none is set, and its text is followed by the source
            line of the thread
        */
        public *string formatEvent(hash<auto> data) {
            switch (data.cmd) {
                case DebugEventCmd::Interrupt:
                    return formatInterrupt(data);

                case DebugEventCmd::Run: {
                    # the other threads continue with the current one, and the debugger resumes threads that start or
                    # end
                    {
                        AutoLock al(stopAllLock);
                        if (remove autoResumed{data.tid}) {
                            return NOTHING;
                        }
                    }
                    if (data.tid != getContextValue('threadId')) {
                        return NOTHING;
                    }
                    switch (data.runstate) {
                        case DebugRunStateName::Run:
                            return tc.success(sprintf("Thread %d continues", data.tid));
                        case DebugRunStateName::Detach:
                            return tc.success(sprintf("Thread %d is no longer debugged", data.tid));
                        case DebugRunStateName::UntilReturn:
                            return tc.success(sprintf("Thread %d runs until its function returns", data.tid));
                    }
                    # a step is followed by the pause at the next statement
                    return tc.success(sprintf("Thread %d steps", data.tid));
                }

                case DebugEventCmd::Breakpoint: {
                    string text = sprintf("Breakpoint %d", data.info.id);
                    switch (data.event) {
                        case "create":
                            text += " created";
                            if (*hash<auto> st = data.info.statements[0]) {
                                text += sprintf(" at %s:%d", st.file ?? "<unknown>", st.start_line + st.offset);
                            }
                            break;
                        case "delete":
                            text += " deleted";
                            break;
                        case "enabled":
                        case "disabled":
                            text += " " + data.event;
                            break;
                        default:
                            text += sprintf(" changed (%s)", data.event);
                            break;
                    }
                    return tc.info(text);
                }

                case DebugEventCmd::Welcome:
                    return tc.info(sprintf("Connected to the debug server %y", data.result));
            }
            return sprintf("%Y", data);
        }

        #! Returns True for the stop of a thread that starts in a program that has started, which the debugger resumes
        /** A debug server that does not tell the start of a program stops each thread when it starts
        */
        static bool isThreadStart(hash<auto> data) {
            return data.type == DebugResponseType::Event && data.cmd == DebugEventCmd::Interrupt
                && data.func == "attach" && data.programstart === False;
        }

        #! Returns True for the stop of a thread that ends its code or leaves the program, which the debugger resumes
        static bool isThreadEnd(hash<auto> data) {
            return data.type == DebugResponseType::Event && data.cmd == DebugEventCmd::Interrupt
                && (data.func == "exit" || data.func == "detach");
        }

        #! Returns the text of an interrupt event; see formatEvent()
        private *string formatInterrupt(hash<auto> data) {
            if (DebugCommandLine::isThreadStart(data)) {
                return tc.info(sprintf("Thread %d started", data.tid));
            }
            if (!exists getContextValue('programId')) {
                setContextValue('programId', data.pgmid);
            }
            # the end of the code of a thread is followed by the thread leaving the program
            if (data.func == "exit") {
                return NOTHING;
            }
            if (data.func == "detach") {
                # a thread that ends is no longer the current thread
                if (getContextValue('threadId') == data.tid) {
                    setContextValue('threadId', NOTHING);
                    # the next thread that pauses becomes the current thread
                    setContextValue('threadEnded', True);
                }
                return tc.info(sprintf("Thread %d ended", data.tid));
            }
            # a thread that pauses while the current thread runs becomes the current thread, as the commands are for
            # a paused thread
            bool switched;
            *softint current = getContextValue('threadId');
            if (!exists current) {
                setContextValue('threadId', data.tid);
                # after the current thread ended; not for the first thread that pauses
                switched = boolean(getContextValue('threadEnded'));
                setContextValue('threadEnded', NOTHING);
            } else if (current != data.tid) {
                bool current_paused;
                {
                    AutoLock al(stopAllLock);
                    current_paused = boolean(stoppedThreads{data.pgmid}{current});
                }
                if (!current_paused) {
                    setContextValue('threadId', data.tid);
                    switched = True;
                }
            }
            string what;
            if (data.func == "exception") {
                what = sprintf("Paused at %sexception %s: %s", data.uncaught ? "uncaught " : "",
                    data.exception.err ?? "", data.exception.desc ?? "");
            } else if (data.bkptids.size() > 1) {
                what = sprintf("Paused at breakpoints %s", (map string($1), data.bkptids).join(", "));
            } else if (data.bkptid) {
                what = sprintf("Paused at breakpoint %d", data.bkptid);
            } else {
                switch (data.func) {
                    case "attach":
                        what = "Paused at the start of the program";
                        break;
                    case "funcEnter":
                        what = "Paused at the start of a function";
                        break;
                    case "funcExit":
                        what = "Paused before the function returns";
                        break;
                    default:
                        what = "Paused";
                        break;
                }
            }
            if (data.line) {
                what += sprintf(" at %s:%d", data.file.val() ? data.file : "<unknown>", data.line);
            }
            string outs = tc.error(what) + sprintf(" (thread %d%s)", data.tid,
                switched ? ", now the current thread" : "");
            if (data.bkpterror) {
                outs += "\n" + tc.warning(sprintf("A breakpoint could not be checked: %s", data.bkpterror));
            }
            if (exists data.linecode) {
                outs += "\n" + formatSource({
                    'code': data.linecode,
                    'startline': data.line,
                    'currentline': data.line,
                });
            }
            return outs;
        }

        #! Returns the current names of the threads of the debugged programs, if the debug server gives them
        #! Returns True if the debugger resumes a thread that stopped, as when it starts, ends, or stops for a stop of
        #! all threads that is no longer requested; see processEvent()
        public bool isAutoResumed(softint tid) {
            AutoLock al(stopAllLock);
            return boolean(autoResumed{tid});
        }

        #! Returns True if a thread is paused, as known from the events of the debug server
        public bool isThreadPaused(softint pgm_id, softint tid) {
            AutoLock al(stopAllLock);
            return boolean(stoppedThreads{pgm_id}{tid});
        }

        public hash<string, *string> getThreadNames() {
            *hash<auto> pgm_info = doCommand({"cmd": "program//list"}, False).result;
            hash<string, *string> rv = {};
            map rv += $1.threadNames, pgm_info.iterator(), $1.threadNames;
            return rv;
        }

        public int checkProgramId() {
            *softint pgmId = getContextValue('programId');
            if (!exists pgmId) {
                throw "DEBUG-COMMAND", "there is no current program; \"pgm list\" lists the programs and \"pgm set "
                    "<program>\" selects one";
            }
            return pgmId;
        }

        public int checkThreadId() {
            *softint threadId = getContextValue('threadId');
            if (!exists threadId) {
                throw "DEBUG-COMMAND", "there is no current thread; \"thread list\" lists the threads and \"thread set "
                    "<thread>\" selects one";
            }
            return threadId;
        }

        static public softlist enumBreakpointId(DebugCommandLine dcl, softlist path, softlist args) {
            hash<auto> data.cmd = 'program/'+dcl.checkProgramId()+'/breakpoint/'+pop path+'/list';
            *hash<auto> sd = dcl.doCommand(data, False);
            return map $1.id, sd.result;
        }

        public loadSession(*string fn) {
            if (exists fn) {
                @debug {
                    printfImpl("Load session: %y\n", fn);
                }
                auto d;
                try {
                    d = parse_yaml(ReadOnlyFile::readTextFile(fn));
                } catch (hash<ExceptionInfo> ex) {
                    throw "DEBUG-COMMAND", sprintf("%y is not a session file of the debugger: %s", fn, ex.desc);
                }
                @debug {
                    printfImpl("Load session data:\n%Y\n", d);
                }
                if (d.typeCode() != NT_HASH || (!exists d.session && !exists d.settings)) {
                    throw "DEBUG-COMMAND", sprintf("%y is not a session file of the debugger", fn);
                }
                if (d.session.programs) {
                    hash<auto> data.cmd = 'session/set';
                    data.value = d.session.programs;
                    *hash<auto> ret = doCommand(data, False);
                    if (ret.result) {
                        printData(ret);
                    }
                }
                # the settings of the debugger; see getSessionSettings()
                if (exists d.settings.stopall) {
                    stopAllThreads = parse_boolean(d.settings.stopall);
                }
                if (exists d.settings.exceptionFilters) {
                    doCommand({"cmd": "exception/filter/set", "value": (map string($1), d.settings.exceptionFilters)
                        ?? ()}, False);
                }
                if (exists d.settings.displays) {
                    list<string> l = ();
                    foreach auto e in (d.settings.displays) {
                        push l, string(e);
                    }
                    AutoLock al(displayLock);
                    displays = l;
                }
            }
        }

        public init(hash<auto> opt) {
            if (opt.color) {
                tc = new TerminalColor(True);
            } else if (opt.no_color) {
                tc = new TerminalColor(False);
            }
        }

    }
}
