# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module ClickFunnelsRestClient {
    version = "1.0";
    desc = "User module for calling ClickFunnels REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("clickfunnelsrest",
            ClickFunnelsRestConnection::ConnectionScheme);
    };
}

/** @mainpage ClickFunnelsRestClient Module

    @tableofcontents

    @section clickfunnelsrestclientintro ClickFunnelsRestClient Introduction

    The %ClickFunnelsRestClient module provides an API for calling ClickFunnels 2.0 REST API
    services.

    To use this module, use \c "%requires ClickFunnelsRestClient" in your code.

    All the public symbols in the module are defined in the ClickFunnelsRestClient namespace.

    The main classes are:
    - @ref ClickFunnelsRestClient::ClickFunnelsRestClient "ClickFunnelsRestClient":
      this class provides the REST client API for communication with the ClickFunnels API;
      it handles Bearer token authentication
    - @ref ClickFunnelsRestClient::ClickFunnelsRestConnection "ClickFunnelsRestConnection":
      provides a connection object to ClickFunnels services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires ClickFunnelsRestClient

ClickFunnelsRestClient cf({
    "team": "myteam",
    "apikey": ENV.CLICKFUNNELS_API_TOKEN,
});
hash<auto> result = cf.get("teams");
printf("Teams: %y\n", result.body);
    @endcode

    @section clickfunnelsrestclientrelnotes Release Notes

    @subsection clickfunnelsrestclientv1_0 ClickFunnelsRestClient v1.0
    - the initial version of the %ClickFunnelsRestClient module
*/

#! the ClickFunnelsRestClient namespace contains all the objects in the ClickFunnelsRestClient module
public namespace ClickFunnelsRestClient {

#! Common base class for ClickFunnelsRestClient functionality
public class ClickFunnelsRestClientBase {
    public {
        #! Default ClickFunnels API URL template base
        const DefaultApiBase = "https://%s.myclickfunnels.com/api/v2";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since base URL has /api/v2)
        const DefaultPingPath = "teams";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
            "User-Agent": "Qore ClickFunnels Integration/1.0",
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "headers": DefaultHeaders,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! returns options for @ref ClickFunnelsRestClient::ClickFunnelsRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Build URL from team subdomain
        if (opts.team) {
            rv.url = sprintf(DefaultApiBase, opts.team);
            remove rv.team;
        }

        # Set Bearer token authentication
        if (opts.apikey) {
            rv.headers.Authorization = "Bearer " + opts.apikey;
            remove rv.apikey;
        }

        return rv;
    }
}

#! This class provides the REST client API for communication with ClickFunnels servers
/** ClickFunnels 2.0 uses a REST API at https://{team}.myclickfunnels.com/api/v2 with Bearer
    token authentication.

    @par Authentication:
    - Bearer token provided via the \c apikey option
    - The token is set as the \c Authorization header with "Bearer" prefix

    @par API Structure:
    All endpoints are under /api/v2 (included in the base URL).
    Workspace-scoped endpoints use /workspaces/{workspace_id}/... paths.
*/
public class ClickFunnelsRestClient inherits RestClient::RestClient, ClickFunnelsRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
ClickFunnelsRestClient cf({
    "team": "myteam",
    "apikey": "your-api-token",
});
        @endcode

        @param opts valid options are:
        - \c team: the ClickFunnels team subdomain (e.g., "myteam" for myteam.myclickfunnels.com)
        - \c apikey: the API Bearer token
        - plus all options for the @ref RestClient::RestClient "RestClient" class

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(ClickFunnelsRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for ClickFunnels REST connections; returns @ref ClickFunnelsRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref ClickFunnelsRestClient::ClickFunnelsRestClient::constructor() for more information
    on the above options
*/
public class ClickFunnelsRestConnection inherits RestClient::RestConnection {
    public {
        #! Default connection URL
        const DefaultConnectionUrl = "clickfunnelsrest://myclickfunnels.com/api/v2";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "ClickFunnels REST Connection",
            "short_desc": "A connection to the ClickFunnels REST API",
            "desc": "A connection to the ClickFunnels REST API for managing contacts, orders, "
                "products, funnels, courses, forms, and fulfillments",
            "cls": Class::forName("ClickFunnelsRestConnection"),
            "auto_url": True,
            "schemes": {
                "clickfunnelsrest": True,
            },
            "base_scheme_map": {
                "https": "clickfunnelsrest",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": ClickFunnelsRestClientBase::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": ClickFunnelsRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": ClickFunnelsRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": ClickFunnelsRestClientBase::DefaultPingPath,
                },
                "team": <ConnectionOptionInfo>{
                    "display_name": "Team Subdomain",
                    "short_desc": "ClickFunnels team subdomain",
                    "type": "string",
                    "desc": "The ClickFunnels team subdomain used to build the API URL. "
                        "For example, if your ClickFunnels URL is "
                        "`https://myteam.myclickfunnels.com`, the team value is `myteam`",
                    "preselected": True,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "ClickFunnels API Bearer token",
                    "type": "string",
                    "desc": "The ClickFunnels API Bearer token for authentication. "
                        "Generate this token in ClickFunnels under "
                        "**Teams List > Your Team > Team Settings > Developer Portal**",
                    "sensitive": True,
                    "preselected": True,
                },
            },
            "required_options": "team,apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Find Your Team Subdomain",
                    "intent": "warning",
                    "content": "The **Team Subdomain** is required to connect to your "
                        "ClickFunnels account.\n\n"
                        "**How to find it:**\n"
                        "1. Log in to your ClickFunnels 2.0 account\n"
                        "2. Look at the URL in your browser: "
                        "`https://**myteam**.myclickfunnels.com`\n"
                        "3. The team subdomain is the part before `.myclickfunnels.com`",
                },
                <UiMessageInfo>{
                    "title": "How to Generate an API Token",
                    "intent": "info",
                    "content": "An **API Token** is required for authentication.\n\n"
                        "**How to generate one:**\n"
                        "1. Log in to your ClickFunnels 2.0 account\n"
                        "2. Go to **Teams List > Your Team > Team Settings > Developer Portal**\n"
                        "3. Click **Add new platform application** and fill in the required "
                        "information\n"
                        "4. Copy the **API access token** from the platform application "
                        "details\n\n"
                        "**Note:** Store this token securely; it provides full API access "
                        "to your ClickFunnels account. API access requires a Scale, Optimize, "
                        "or Dominate plan",
                },
            ),
        };
    }

    #! creates the ClickFunnelsRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes
        and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description,
            string url = ClickFunnelsRestClientBase::DefaultApiBase,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the ClickFunnelsRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(ClickFunnelsRestConnection::getConfig(config), attr) {
    }

    #! returns \c "clickfunnelsrest"
    string getType() {
        return "clickfunnelsrest";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "ClickFunnels";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the ClickFunnelsDataProvider and
        # creates the data provider object dynamically
        load_module("ClickFunnelsDataProvider");
        return create_object("ClickFunnelsDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            # Auto-correct URL from team subdomain
            if (opts.team) {
                string expected_url = sprintf("clickfunnelsrest://%s.myclickfunnels.com/api/v2",
                    opts.team);
                if (url != expected_url) {
                    update.url = expected_url;
                }
            }
            # Auto-correct ping path - remove leading slash
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref ClickFunnelsRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this
        parameter is ignored

        @return a @ref ClickFunnelsRestClient object
    */
    private ClickFunnelsRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new ClickFunnelsRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since ClickFunnelsRestClient 1.0
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new ClickFunnelsRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! Builds the connection configuration from options
    private static hash<auto> getConfig(hash<auto> config) {
        if (config.opts.team) {
            config.url = sprintf("clickfunnelsrest://%s.myclickfunnels.com/api/v2",
                config.opts.team);
        }
        return config;
    }
}

#! ClickFunnels REST client for non-blocking I/O
/** @see ClickFunnelsRestClient for more information
*/
public class ClickFunnelsRestClientIo inherits RestClientIo::RestClientIo,
        ClickFunnelsRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(ClickFunnelsRestClientBase::getOptions(opts), shared_mgr) {
        # DO NOT call setAssumedEncoding() - not available on RestClientIo
    }
}
}
