%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires OpenAiRestClient
%requires QoreLlmTypes
%requires QoreRagTypes

module OllamaRestClient {
    version = "1.0";
    desc = "user module for calling Ollama local-first LLM REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("ollama",
            OllamaRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(
            new OllamaLlmProviderFactory());
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new OllamaEmbedderFactory());
    };
}

/** @mainpage OllamaRestClient Module

    @tableofcontents

    @section ollamarestclientintro OllamaRestClient Introduction

    The %OllamaRestClient module provides an API for calling
    [Ollama](https://ollama.com) — a local-first LLM runtime that serves
    open-weight models from your own machine via HTTP.

    Ollama exposes two HTTP surfaces side by side:

    - **OpenAI-compatible** endpoints at `/v1/chat/completions` and
      `/v1/embeddings` — used by @ref OllamaRestClient::OllamaLlmProvider
      "OllamaLlmProvider" (a thin @ref OpenAiRestClient::OpenAiLlmProvider
      subclass) so existing OpenAI-shape consumers work unchanged
    - **Native** endpoints at `/api/embed`, `/api/tags`, `/api/pull` —
      surfaced by the @ref OllamaDataProvider for embeddings (with
      Ollama's richer native body shape) and model management

    @par Configuration

    - \c url (optional): defaults to \c http://localhost:11434
    - \c apikey (optional): Bearer token for hosted / Ollama-Cloud deployments

    @section OllamaRestClientRelnotes Release Notes

    @subsection OllamaRestClientv1_0 OllamaRestClient v1.0
    - the initial version of the %OllamaRestClient module
*/

%requires json

public namespace OllamaRestClient {
public class OllamaRestClientBase {
    public {
        #! Default Ollama REST API URL
        const DefaultUrl = "http://localhost:11434";

        #! Default Ollama API version (used for the OpenAI-compatible surface)
        const DefaultApiVersion = "v1";

        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
        };
    }

    #! Returns options for the OllamaRestClient constructors
    /** Unlike the other AI provider modules, Ollama does NOT default the
        connection path to \c /v1 — the native endpoints (\c /api/tags,
        \c /api/embed, \c /api/pull) live at the root, and the
        OpenAI-compat path is reached by passing the full path on each
        call.  This keeps both surfaces accessible from a single client.

        Maps the \c apikey option to \c token for Bearer authentication
        when present (hosted / Ollama-Cloud deployments).
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Ollama REST API (sync)
public class OllamaRestClient inherits RestClient::RestClient, OllamaRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(OllamaRestClientBase::getOptions(opts), True) {
    }
}

#! REST client for Ollama REST API using multiplexed HTTP connections
public class OllamaRestClientIo inherits RestClientIo::RestClientIo, OllamaRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(OllamaRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Ollama REST connections
public class OllamaRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "ollama://localhost:11434";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Ollama Local LLM Connection",
            "short_desc": "A connection to a local Ollama runtime",
            "desc": "A connection to a local [Ollama](https://ollama.com) runtime serving "
                "open-weight LLMs from the local machine.\n\n"
                "Ollama runs locally by default at `http://localhost:11434`.  No "
                "authentication is required for local deployments; pass an `apikey` only "
                "for hosted Ollama Cloud or reverse-proxied deployments.",
            "cls": Class::forName("OllamaRestConnection"),
            "auto_url": True,
            "schemes": {"ollama": True},
            "base_scheme_map": {"http": "ollama", "https": "ollama"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Optional Bearer token (Ollama Cloud / proxied deployments)",
                    "type": "string",
                    "desc": "Optional Bearer token.  Local Ollama deployments do not require "
                        "authentication; supply only for hosted Ollama Cloud or "
                        "reverse-proxied deployments.",
                    "sensitive": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": DefaultPingPath,
                },
            },
        };

        const DefaultPingMethod = "GET";
        const DefaultPingHeaders = {"Accept": MimeTypeJson};
        const DefaultPingPath = "api/tags";
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "ollama";
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("OllamaDataProvider");
        return create_object("OllamaDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private OllamaRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new OllamaRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new OllamaRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return OllamaRestClientBase::getOptions(rv);
    }
}

#! LLM provider for Ollama local-first servers
/** Routes chat through Ollama's OpenAI-compatible
    \c /v1/chat/completions endpoint, so the inherited
    @ref OpenAiRestClient::OpenAiLlmProvider body construction, response
    parsing, and SSE streaming all work unchanged.

    @par Configuration

    - \c url (optional): override the default \c http://localhost:11434
    - \c api_key (optional): Bearer token for hosted Ollama Cloud /
      proxied deployments (local Ollama needs no auth)
    - \c model (required): Ollama model name, e.g. \c "llama3.3",
      \c "qwen2.5:14b", \c "mistral-nemo"

    @note Embeddings for Ollama are exposed through the
    @ref QoreRagUtils::OllamaEmbedder which calls Ollama's native
    \c /api/embed endpoint (richer response shape than the
    OpenAI-compat variant).
*/
public class OllamaLlmProvider inherits OpenAiRestClient::OpenAiLlmProvider {
    public {
        const DefaultUrl = "http://localhost:11434";
    }

    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : OpenAiRestClient::OpenAiLlmProvider(
                OllamaRestClient::applyOllamaDefaults(config)) {
    }

    string getMode() {
        return "ollama";
    }
}

#! Namespace-local helper: returns config with the default Ollama URL applied
hash<QoreLlmUtils::LlmBackendConfig> sub applyOllamaDefaults(
        hash<QoreLlmUtils::LlmBackendConfig> config) {
    if (!config.url.val()) {
        config.url = OllamaLlmProvider::DefaultUrl;
    }
    return config;
}

#! Factory for @ref OllamaLlmProvider
public class OllamaLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "ollama";
    }

    string getDisplayName() {
        return "Ollama local-first chat completions";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new OllamaLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
        };
    }
}
}

public namespace QoreRagUtils {
#! Ollama-backed embedder — calls Ollama's native `/api/embed` endpoint
/** Uses the native (not OpenAI-compatible) endpoint to get richer
    response detail.  The native shape returns embeddings as
    `{embeddings: [[float, ...], ...]}` rather than the OpenAI shape.
*/
public class OllamaEmbedder inherits AbstractEmbedder {
    public {
        const DefaultModel = "nomic-embed-text";
        const Backend = "ollama";
    }

    private {
        hash<EmbedderConfig> config;
        string model_name;
        *OllamaRestClient::OllamaRestClientIo rest_client;
        *int cached_dimension;
        Mutex init_mutex();
    }

    constructor(hash<EmbedderConfig> config) {
        self.config = config;
        model_name = config.model ?? DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }

        hash<auto> body = {
            "model": model_name,
            "input": texts,
        };

        hash<auto> resp = pickRestClient(opts).restPost("/api/embed", body);

        # Ollama native response shape: {embeddings: [[float, ...], ...]}
        *list<auto> vectors = resp.body.embeddings;
        if (!exists vectors) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing 'embeddings' field", Backend),
                {"body": resp.body};
        }
        if (vectors.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned %d vectors for %d input texts",
                    Backend, vectors.size(), texts.size()),
                {"body": resp.body};
        }

        list<list<float>> result = ();
        foreach auto vec in (vectors) {
            list<float> typed = validateAndCastVector(vec, resp.body);
            if (!exists cached_dimension) {
                cached_dimension = typed.size();
            }
            push result, typed;
        }
        return result;
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        encode(" ");
        return cached_dimension ?? -1;
    }

    *string getModel() {
        return model_name;
    }

    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response item missing embedding vector", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector", Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    private OllamaRestClient::OllamaRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new OllamaRestClient::OllamaRestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "url": config.url ?? OllamaRestClient::OllamaRestClientBase::DefaultUrl,
        };
        if (config.api_key.val()) {
            opts.apikey = config.api_key;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new OllamaRestClient::OllamaRestClientIo(
                    buildRestOptions());
            }
        }
    }
}

#! Factory for @ref OllamaEmbedder
public class OllamaEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "ollama";
    }

    string getDisplayName() {
        return "Ollama local embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new OllamaEmbedder(config);
    }
}
}
