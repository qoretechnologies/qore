# minimum required Qore version
%requires qore >= 2.0
%modern

%requires ml

module QoreMLUtils {
    version = "1.0.0";
    desc = "user module providing hyperparameter optimization and model explainability for Qore ML";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreMLUtils Module

    @tableofcontents

    @section qoremlutilsintro QoreMLUtils Module Introduction

    The %QoreMLUtils module provides utilities for hyperparameter tuning and model
    explainability on top of the core \c ml binary module:

    - @ref QoreMLUtils::GridSearch "GridSearch" — exhaustive search over a hyperparameter grid
      with k-fold cross-validation
    - @ref QoreMLUtils::RandomSearch "RandomSearch" — random sampling from hyperparameter
      distributions with k-fold cross-validation
    - @ref QoreMLUtils::PermutationImportance "PermutationImportance" — model-agnostic feature
      importance via column-shuffling
    - @ref QoreMLUtils::MLScoringUtils "MLScoringUtils" — default scoring functions for
      regression and classification

    @section qoremlutilsrelnotes QoreMLUtils Module Release Notes

    @subsection qoremlutils_1_0 QoreMLUtils Module Version 1.0
    - Initial release with GridSearch, RandomSearch, PermutationImportance, MLScoringUtils
*/
