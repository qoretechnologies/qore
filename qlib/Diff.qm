# minimum Qore version
%requires qore >= 0.9.5
%modern
%requires Util

module Diff {
    version = "1.0";
    desc    = "looking for differences between various data";
    author  = "Jiri Vaclavik <jiri.vaclavik@qoretechnologies.com>";
    url     = "http://qore.org";
    license = "MIT";
}

/** @mainpage Diff Module

    @tableofcontents

    @section diffintro Diff Module Introduction

    The %Diff module provides some routines for comparing data structures.

    To use this module, use \c "%requires Diff" in your code.

    All the public symbols in the module are defined in the Diff namespace

    Functions:
    - @ref Diff::diff()

    @section diffrelnotes Release Notes

    @subsection diff_1_0
    - the initial version of the Diff module
*/

#! the Diff namespace contains all the objects in the Diff module
public namespace Diff {
    #! returns differences in two lists
    /** @par Example:
        @code{.py}
list diff = diff((1, 2, 3, 4), (2, 3, 5));
        @endcode
        @param old some list
        @param neww another list
    */
    public list<auto> sub diff(softlist<auto> old, softlist<auto> neww) {
        list<auto> matrix = ();
        int maxlen = 0;
        int old_max;
        int new_max;
        if (!old.empty() && !neww.empty()) {
            foreach int old_index in (xrange(0, old.size())) {
                auto old_value = old[old_index];
                list<auto> nkeys = select xrange(0, neww.size()), neww[$1] == old_value;
                foreach int new_index in (nkeys) {
                    matrix[old_index][new_index] = exists matrix[old_index - 1][new_index - 1] ? matrix[old_index - 1][new_index - 1] + 1 : 1;
                    if (matrix[old_index][new_index] > maxlen) {
                        maxlen = matrix[old_index][new_index];
                        old_max = old_index + 1 - maxlen;
                        new_max = new_index + 1 - maxlen;
                    }
                }
            }
        }
        if (old.empty() && neww.empty()) {
            return ();
        }

        if (maxlen == 0) {
            return list({'d': old, 'i': neww});
        }

        list<auto> e1_old = slice(old, old_max != 0 ? range(0, old_max) : ());
        list<auto> e1_new = slice(neww, new_max != 0 ? range(0, new_max) : ());
        list<auto> e_eq   = slice(neww, maxlen > 0 ? range(new_max, new_max + maxlen) : ());
        list<auto> e2_old = slice(old, old.size() > old_max + maxlen ? range(old_max + maxlen, old.size()) : ());
        list<auto> e2_new = slice(neww, neww.size() > new_max + maxlen ? range(new_max + maxlen, neww.size()) : ());
        return
            diff(e1_old, e1_new)
            + e_eq
            + diff(e2_old, e2_new);
    }

    #! shows differences between two strings considering lines as elementary unit. This function clones standard unix diff
    /** @par Example:
        @code{.py}
string diff = diff_text(str1, str2);
        @endcode
        @param s1 some string
        @param s2 another string
    */
    public string sub diff_text(string s1, string s2) {
        list lines1 = split("\n", s1);
        list lines2 = split("\n", s2);

        list results = diff(lines1, lines2);
        string diff = '';

        int line1 = 1;
        int line2 = 1;
        foreach any line in (results) {
            if (line.type() == 'hash') {
                list insert = line.i;
                list del = line.d;
                if (insert.size() && del.size()) {
                    diff += line_range(line2, line2 + del.size() - 1) + 'c' + line_range(line1, line1 + insert.size() - 1) + "\n";
                } else if (insert.size()) {
                    diff += (line2 - 1) + "a" + line_range(line1, line1 + insert.size() - 1) + "\n";
                } else if (del.size()) {
                    diff += line_range(line2, line2 + del.size() - 1) + "d" + (line1 - 1) + "\n";
                }

                if (del.size()) {
                    diff += join("\n", map "< " + $1, del) + "\n";
                }
                if (insert.size() && del.size()) {
                    diff += "---\n";
                }
                if (insert.size()) {
                    diff += join("\n", map "> " + $1, insert) + "\n";
                }
                line1 += insert.size();
                line2 += del.size();
            } else {
                ++line1;
                ++line2;
            }
        }
        return diff;
    }

    string sub line_range(int from, int to) {
        if (from == to) {
            return string(from);
        }
        return from + ',' + to;
    }

    #! produces unified diff output between two strings, similar to \c "diff -u"
    /** @par Example:
        @code{.py}
string result = diff_unified(old_text, new_text);
# or with file labels:
string result = diff_unified(old_text, new_text, "a/file.txt", "b/file.txt");
        @endcode

        @param s1 the original string
        @param s2 the modified string
        @param label1 label for the original file (default: \c "a")
        @param label2 label for the modified file (default: \c "b")
        @param ctx_lines number of context lines around each change (default: 3)

        @return unified diff string; empty string if inputs are identical

        @since Diff 1.1
    */
    public string sub diff_unified(string s1, string s2, string label1 = "a", string label2 = "b",
            int ctx_lines = 3) {
        if (s1 == s2) {
            return "";
        }

        list<string> old_lines = s1.split("\n");
        list<string> new_lines = s2.split("\n");

        # Get the raw diff result (list of matched lines and {d:, i:} hashes)
        list<auto> results = diff(old_lines, new_lines);

        # Build a list of edit operations with line numbers
        # Each entry: {type: "equal"|"delete"|"insert", old_line: int, new_line: int, text: string}
        list<hash<auto>> ops = ();
        int old_idx = 0;
        int new_idx = 0;
        foreach auto item in (results) {
            if (item.typeCode() == NT_HASH) {
                list<auto> del = item.d;
                list<auto> ins = item.i;
                foreach auto d in (del) {
                    ops += {"type": "delete", "old_line": old_idx, "new_line": new_idx, "text": string(d)};
                    ++old_idx;
                }
                foreach auto i in (ins) {
                    ops += {"type": "insert", "old_line": old_idx, "new_line": new_idx, "text": string(i)};
                    ++new_idx;
                }
            } else {
                ops += {"type": "equal", "old_line": old_idx, "new_line": new_idx, "text": string(item)};
                ++old_idx;
                ++new_idx;
            }
        }

        # Group changes into hunks with context
        list<list<hash<auto>>> hunks = ();
        int i = 0;
        while (i < ops.size()) {
            if (ops[i].type == "equal") {
                ++i;
                continue;
            }
            # Found a change — expand to include context
            int hunk_start = i - ctx_lines;
            if (hunk_start < 0) {
                hunk_start = 0;
            }
            # Find the end of this change group (including merging nearby changes)
            int hunk_end = i;
            while (hunk_end < ops.size()) {
                if (ops[hunk_end].type != "equal") {
                    hunk_end++;
                    continue;
                }
                # Count consecutive equal lines
                int eq_count = 0;
                int j = hunk_end;
                while (j < ops.size() && ops[j].type == "equal") {
                    ++eq_count;
                    ++j;
                }
                if (j < ops.size() && eq_count <= ctx_lines * 2) {
                    # Merge with next change
                    hunk_end = j;
                } else {
                    # End this hunk with context after the last change
                    hunk_end += ctx_lines;
                    if (hunk_end > ops.size()) {
                        hunk_end = ops.size();
                    }
                    break;
                }
            }
            if (hunk_end > ops.size()) {
                hunk_end = ops.size();
            }
            hunks += (ops[hunk_start..hunk_end - 1],);
            i = hunk_end;
        }

        # Format output
        string output = sprintf("--- %s\n+++ %s\n", label1, label2);
        foreach list<hash<auto>> hunk in (hunks) {
            # Calculate hunk header
            int old_count = 0;
            int new_count = 0;
            foreach hash<auto> op in (hunk) {
                switch (op.type) {
                    case "equal":
                        ++old_count;
                        ++new_count;
                        break;
                    case "delete":
                        ++old_count;
                        break;
                    case "insert":
                        ++new_count;
                        break;
                }
            }
            # For pure insertions/deletions, use start line 0 for the empty side
            # per unified diff convention (e.g., @@ -0,0 +1,3 @@)
            int old_start = old_count ? hunk[0].old_line + 1 : 0;
            int new_start = new_count ? hunk[0].new_line + 1 : 0;
            output += sprintf("@@ -%d,%d +%d,%d @@\n", old_start, old_count, new_start, new_count);
            foreach hash<auto> op in (hunk) {
                switch (op.type) {
                    case "equal":
                        output += " " + op.text + "\n";
                        break;
                    case "delete":
                        output += "-" + op.text + "\n";
                        break;
                    case "insert":
                        output += "+" + op.text + "\n";
                        break;
                }
            }
        }
        return output;
    }
}
