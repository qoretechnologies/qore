# minimum qore version
%requires qore >= 2.0

%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires OpenAiRestClient
%requires QoreLlmTypes

module GroqRestClient {
    version = "1.0";
    desc = "user module for calling Groq REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("groq", GroqRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(new GroqLlmProviderFactory());
    };
}

/** @mainpage GroqRestClient Module

    @tableofcontents

    @section groqrestclientintro GroqRestClient Introduction

    The %GroqRestClient module provides an API for calling
    [Groq](https://groq.com) REST API services.

    Groq runs Llama, Mixtral, Gemma, Qwen, and other open-weight models on
    its custom LPU inference engine at exceptionally high token-per-second
    throughput.  The API is OpenAI-compatible, so
    @ref GroqRestClient::GroqLlmProvider "GroqLlmProvider" subclasses
    @ref OpenAiRestClient::OpenAiLlmProvider with the Groq default URL and
    mode string.

    To use this module, use \c "%requires GroqRestClient" in your code.

    All the public symbols in the module are defined in the
    GroqRestClient namespace.

    The main classes are:
    - @ref GroqRestClient::GroqRestClient "GroqRestClient": REST client API
      for communication with Groq (sync)
    - @ref GroqRestClient::GroqRestClientIo "GroqRestClientIo": REST client
      using multiplexed HTTP connections (async)
    - @ref GroqRestClient::GroqRestConnection "GroqRestConnection": a REST
      connection object to Groq
    - @ref GroqRestClient::GroqLlmProvider "GroqLlmProvider":
      @ref qorellmutilsintro "QoreLlmUtils" provider for mode \c groq

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires GroqRestClient

GroqRestClient rest({"apikey": api_key});
hash<auto> ans = rest.post("/v1/chat/completions", {
    "model": "llama-3.3-70b-versatile",
    "messages": (
        {"role": "user", "content": "Hello!"},
    ),
});
printf("%Y\n", ans.body);
    @endcode

    @note The module name \c GroqRestClient is distinct from
    @ref grokrestclientintro "GrokRestClient" (xAI's Grok product) —
    note the spelling: Groq (LPU inference, OSS models) vs. Grok (xAI).

    @section GroqRestClientRelnotes Release Notes

    @subsection GroqRestClientv1_0 GroqRestClient v1.0
    - the initial version of the %GroqRestClient module
*/

%try-module json
%define NoJson
%endtry

#! the GroqRestClient namespace contains all the objects in the GroqRestClient module
public namespace GroqRestClient {
#! Common base class for GroqRestClient functionality
public class GroqRestClientBase {
    public {
        #! Default Groq REST API URL
        /** Groq's API is rooted at \c /openai on its production host;
            the OpenAI-compatible endpoints live at e.g.
            \c /openai/v1/chat/completions.
        */
        const DefaultUrl = "https://api.groq.com/openai";

        #! Default Groq API version
        const DefaultApiVersion = "v1";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    #! Returns options for the GroqRestClient constructors
    /** Maps the \c apikey option to \c token for Bearer authentication
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        if (opts.api) {
            rv.default_path = "/" + opts.api;
        }
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Groq REST API
/** You must use an API key in the \c apikey option to call Groq APIs.

    The API key is sent as the \c Authorization: \c Bearer header.
*/
public class GroqRestClient inherits RestClient::RestClient, GroqRestClientBase {
    private {
        #! The API version in use
        string api;
    }

    #! Creates the object with the given options
    /** @par Example:
        @code{.py}
GroqRestClient rest(opts);
        @endcode

        @param opts valid options are all the options for the
        @ref RestClient::RestClient "RestClient" class; note that the URL
        is set by default if not provided (see @ref DefaultUrl)
        @param do_not_connect if \c False (the default), then a connection
        will be immediately established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor,
        unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(GroqRestClientBase::getOptions(opts), True) {
        if (validator instanceof NullRestSchemaValidator) {
            setConnectionPath(getString(opts, "api") ?? DefaultApiVersion);
        }
    }
}

#! REST client for Groq REST API using multiplexed HTTP connections
/** @see GroqRestClient for more information
*/
public class GroqRestClientIo inherits RestClientIo::RestClientIo, GroqRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(GroqRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Groq REST connections; returns @ref GroqRestClient objects
public class GroqRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Groq REST API URL
        const DefaultUrl = "groq://api.groq.com/openai";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Groq REST Connection",
            "short_desc": "A connection to the Groq LPU inference REST API",
            "desc": "A connection to the [Groq](https://groq.com) LPU inference REST API.\n\n"
                "Groq serves OSS models (Llama, Mixtral, Gemma, Qwen, Whisper, etc.) at "
                "exceptionally high throughput on its custom LPU hardware via an "
                "OpenAI-compatible API surface.\n\n"
                "Requires an API key for Bearer authentication.  Get your API key from the "
                "[Groq Console](https://console.groq.com/keys).",
            "cls": Class::forName("GroqRestConnection"),
            "auto_url": True,
            "schemes": {
                "groq": True,
            },
            "base_scheme_map": {
                "https": "groq",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Groq API key for authentication",
                    "type": "string",
                    "desc": "The Groq API key used for Bearer authentication.\n\n"
                        "Get your API key from the "
                        "[Groq Console](https://console.groq.com/keys).",
                    "sensitive": True,
                    "preselected": True,
                },
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "The API version to use",
                    "desc": "The API version to use.",
                    "type": "string",
                    "default_value": GroqRestClientBase::DefaultApiVersion,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": DefaultPingPath,
                },
            },
            "required_options": "apikey",
        };

        #! Default Groq ping method
        const DefaultPingMethod = "GET";

        #! Default Groq ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default Groq ping path (relative to /v1, /openai/v1/models on Groq)
        const DefaultPingPath = "models";
    }

    #! Creates the GroqRestConnection object
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! Creates the GroqRestConnection object from a configuration hash
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! Returns \c "groq"
    string getType() {
        return "groq";
    }

    #! Returns @ref True as this connection returns a data provider
    bool hasDataProvider() {
        return True;
    }

    #! Returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("GroqDataProvider");
        return create_object("GroqDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! Returns a sync REST client object
    private GroqRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new GroqRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable REST client object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new GroqRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! Returns connection options with apikey mapped to token for Bearer auth
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return GroqRestClientBase::getOptions(rv);
    }

    #! Sets update options code for auto_url connections
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != GroqRestClientBase::DefaultUrl && url != DefaultUrl) {
                update.url = DefaultUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }
}

#! LLM provider for Groq servers
/** Groq serves an OpenAI-compatible chat-completions endpoint at
    \c /v1/chat/completions under the \c /openai path on
    \c https://api.groq.com, so this provider reuses
    @ref OpenAiRestClient::OpenAiLlmProvider for body construction,
    response parsing, and SSE streaming.  Only the mode string and default
    URL differ.

    @par Configuration

    - \c url (optional): override the default \c https://api.groq.com/openai
    - \c api_key (required): Groq API key
    - \c model (required): Groq model name, e.g. \c "llama-3.3-70b-versatile"
*/
public class GroqLlmProvider inherits OpenAiRestClient::OpenAiLlmProvider {
    public {
        #! Default Groq REST API URL
        const DefaultUrl = "https://api.groq.com/openai";
    }

    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : OpenAiRestClient::OpenAiLlmProvider(GroqRestClient::applyGroqDefaults(config)) {
    }

    string getMode() {
        return "groq";
    }
}

#! Namespace-local helper: returns config with the default Groq URL applied
hash<QoreLlmUtils::LlmBackendConfig> sub applyGroqDefaults(
        hash<QoreLlmUtils::LlmBackendConfig> config) {
    if (!config.url.val()) {
        config.url = GroqLlmProvider::DefaultUrl;
    }
    return config;
}

#! Factory for @ref GroqLlmProvider
public class GroqLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "groq";
    }

    string getDisplayName() {
        return "Groq LPU inference (OpenAI-compatible)";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new GroqLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
        };
    }
}
}
