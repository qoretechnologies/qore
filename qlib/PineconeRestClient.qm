%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes

module PineconeRestClient {
    version = "1.0";
    desc = "user module for calling Pinecone vector DB REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("pinecone",
            PineconeRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("pinecone-admin", PineconeAdminRestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerVectorStoreFactory(
            new PineconeVectorStoreFactory());
    };
}

/** @mainpage PineconeRestClient Module

    @tableofcontents

    @section pineconerestclientintro PineconeRestClient Introduction

    The %PineconeRestClient module provides a REST client and a connection for
    <a href="https://www.pinecone.io">Pinecone</a> — a managed vector database — and registers \c pinecone as a
    vector-store backend in @ref qoreragutilsintro "QoreRagUtils".

    For the data-provider application generated from Pinecone's own API descriptions, see
    @ref pineconedataproviderintro "PineconeDataProvider".

    @section pineconerestclientplanes Two Planes, Two Hosts

    Pinecone has a <b>control plane</b> that manages indexes and a <b>data plane</b> that reads and writes
    their contents, and the two do not share a host: the control plane is at
    \c https://api.pinecone.io, while each index's data is served from <b>its own host</b>, which only
    the control plane knows.

    Which side resolves that host depends on which side you are using:

    |!Using|!How the data-plane host is reached
    |@ref pineconedataproviderintro "PineconeDataProvider"|declaratively, by the action framework's host router, with the index as an ordinary action option
    |@ref QoreRagUtils::PineconeVectorStore "PineconeVectorStore"|by this module, which calls \c "GET /indexes/{name}" once per index and caches the host

    Both follow the same rule about where the credentials may go:
    @ref QoreRagUtils::PineconeVectorStore::checkIndexHost() "checkIndexHost()" refuses a resolved host
    that is not \c pinecone.io or a subdomain of it, matched label by label, and refuses one that
    names a scheme other than \c https or carries credentials.  A host that comes out of a <b>response</b>
    is outside the bound the configured URL would otherwise set, so it is checked rather than trusted.

    @section pineconerestclientauth Authentication and API Version

    Pinecone authenticates with its own \c Api-Key header rather than with
    \c "Authorization: Bearer", and selects a dated API version with \c X-Pinecone-Api-Version.  Both
    are set by @ref PineconeRestClient::PineconeRestClientBase::getOptions() "getOptions()" as default
    headers on the client, so every call carries them.

    The version is <b>pinned</b> by this module — see
    @ref PineconeRestClient::PineconeRestClientBase::ApiVersion "ApiVersion".  The header is declared
    required on every operation Pinecone publishes, but the server accepts a request without one and
    answers it under whatever version it currently defaults to, which would let the same integration
    change behaviour without anything in the request or the response saying so.  A caller that sets the
    header explicitly keeps its own value.

    @section pineconerestclientping The Connection Ping

    @ref PineconeRestClient::PineconeRestConnection::PingPath "GET /indexes" is the cheapest
    authenticated read Pinecone offers, and is what the connection pings: it answers \c 200 for a key
    the server accepts and \c 401 for one it does not, and it names no object, so it works against a
    project with no indexes in it.

    @section pineconerestclientadmin Organization Administration

    The separate \c pinecone-admin scheme uses PineconeAdminRestConnection and the synchronous or
    asynchronous PineconeAdminRestClient / PineconeAdminRestClientIo. Supply the service account's
    \c oauth2_client_id and \c oauth2_client_secret. Both are sensitive connection options.

    Tokens come from \c https://login.pinecone.io/oauth/token using \c client_credentials and the fixed
    audience \c https://api.pinecone.io/. Expiring tokens are renewed with another client-credentials
    request. There is no interactive authorization step and no refresh token. The connection ping makes
    an authenticated \c GET /admin/projects request; invalid credentials fail the ping.

    Database operations continue to use the project's API key through the \c pinecone scheme.

    @section PineconeRestClientRelnotes Release Notes

    @subsection PineconeRestClientv1_0 PineconeRestClient v1.0
    - the initial version of the %PineconeRestClient module
*/

%requires json

public namespace PineconeRestClient {
public class PineconeRestClientBase {
    public {
        #! Default Pinecone control-plane URL
        const DefaultControlPlaneUrl = "https://api.pinecone.io";

        #! The header carrying the API key
        /** Pinecone authenticates with its own header rather than with \c "Authorization: Bearer".
        */
        const ApiKeyHeader = "Api-Key";

        #! The header selecting the dated API version
        const VersionHeader = "X-Pinecone-Api-Version";

        #! The API version this module's vendored descriptions describe
        /** Pinecone versions its API by date and selects the version with a header.  The header is
            declared <b>required</b> on every operation in all three of its published descriptions, but the
            server accepts a request without one and answers it under whatever version it currently
            defaults to - which is the dangerous case rather than the safe one, because the same
            integration then changes behaviour when Pinecone moves that default, with nothing in the
            request or the response saying so.

            So the version is pinned here and sent on every call, and every generated action drops the
            header rather than asking for it; the two are asserted equal in this module's tests, because
            an action generated from one version and sent against another makes a request the description
            does not describe.

            @see @ref PineconeDataProvider::PineconeSchema "PineconeSchema" for the descriptions this
            names
        */
        const ApiVersion = "2026-07";

        const DefaultOptions = {
            "url": DefaultControlPlaneUrl,
        };
    }

    static hash<auto> getOptions(hash<auto> opts) {
        # "auto!" because a caller's literal option hash whose values happen to share a type narrows to
        # that type, and adding a hash-valued default would then throw at run time
        hash<auto!> rv;
        rv += DefaultOptions + opts;
        # the version travels as a header on every call, so it is merged into the client's headers rather
        # than passed per request; a caller adding a header of its own does not drop it, and a caller that
        # set the header explicitly keeps its own value
        rv.headers = {VersionHeader: ApiVersion} + (rv.headers ?? {});
        # Pinecone uses the Api-Key header, not Bearer
        if (rv.apikey) {
            hash<auto!> dh;
            dh += rv.headers;
            dh{ApiKeyHeader} = rv.apikey;
            rv.headers = dh;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Pinecone control plane (sync)
public class PineconeRestClient inherits RestClient::RestClient, PineconeRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(PineconeRestClientBase::getOptions(opts), True) {
    }
}

#! REST client for Pinecone using multiplexed HTTP connections (async)
public class PineconeRestClientIo inherits RestClientIo::RestClientIo, PineconeRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(PineconeRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Pinecone REST connections
public class PineconeRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "pinecone://api.pinecone.io";

        #! The path pinged to verify that the server accepts the API key
        /** The index listing is the cheapest authenticated read the control plane offers: it answers
            \c 200 with the project's indexes for a key Pinecone accepts and \c 401 for one it does not,
            and it names no object, so it works against an empty project.

            This connection declared no ping at all until the application covered more than one action,
            so every ping returned \c "OK" in a few milliseconds without contacting the server - measured
            at 5356 microseconds for a <b>deliberately invalid</b> key, against 962 for a valid one, both
            reported as \c ok.  A ping that cannot fail reports a broken credential as a working
            connection.
        */
        const PingPath = "/indexes";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Pinecone Vector Database Connection",
            "short_desc": "A connection to the Pinecone managed vector database",
            "desc": "A connection to [Pinecone](https://www.pinecone.io) — a managed vector database "
                "for semantic search, hybrid search and retrieval-augmented generation.\n\n"
                "Requires an API key, sent as the `Api-Key` header (NOT `Authorization: Bearer`).  "
                "Create one in the [Pinecone console](https://app.pinecone.io/); a key is scoped to a "
                "single project, so the connection reaches the indexes of that project only.\n\n"
                "Pinecone has a **two-plane architecture**, and this connection addresses both.  The "
                "control plane at `https://api.pinecone.io` creates and describes indexes, backups and "
                "collections.  The data plane — searching, upserting and fetching, which is to say the "
                "operations that *are* Pinecone — lives on a **separate host per index**, which only "
                "the control plane knows.  Actions that reach it take the index as an option and the "
                "host is resolved and cached automatically, so nothing here has to be configured per "
                "index.\n\n"
                "The dated API version is pinned by this module and sent on every call, so a change to "
                "the server-side default cannot alter the behaviour of a flow that is already running.",
            "cls": Class::forName("PineconeRestConnection"),
            "auto_url": True,
            "schemes": {"pinecone": True},
            "base_scheme_map": {"https": "pinecone"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "The Pinecone API key",
                    "type": "string",
                    "desc": "The Pinecone API key, sent as the `Api-Key` header (NOT "
                        "`Authorization: Bearer`).\n\n"
                        "Create one in the [Pinecone console](https://app.pinecone.io/) under "
                        "**API keys**.  A key belongs to one project and carries its own permissions, "
                        "so a key that can read may not be able to create or delete an index.",
                    "sensitive": True,
                    "preselected": True,
                },
            },
            "required_options": "apikey",
        };
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "pinecone";
    }

    #! Returns the data provider application name this connection serves
    /** Without this the base class returns nothing, the connection is never associated with its app, and
        @ref ConnectionProvider::AbstractConnection::getInfo() "getInfo()" omits \c app entirely.

        @note must match @c PineconeDataProvider::AppName; the name is repeated here rather than
        referenced because %PineconeDataProvider requires this module, not the reverse
    */
    *string getAppName() {
        return "Pinecone";
    }

    #! Pings the server by listing the project's indexes
    /** @ref PingPath "GET /indexes" is the cheapest authenticated read Pinecone offers: it answers with
        the project's indexes for a key the server accepts and \c 401 for one it does not, so the
        credential is actually verified rather than assumed.  It names no object, so it works against a
        project with no indexes in it.

        Set both the \c ping_method and \c ping_path options to use the standard
        @ref RestClient::RestConnection "RestConnection" ping instead.  Note that such a ping cannot
        detect an invalid API key unless the path it names requires one.

        @throw REST-RESPONSE-ERROR the server rejected the ping request
    */
    private pingImpl() {
        if (opts.ping_method && opts.ping_path) {
            RestConnection::pingImpl();
            return;
        }
        try {
            cast<PineconeRestClientIo>(getAsync()).restGet(PingPath);
        } catch (hash<ExceptionInfo> ex) {
            authFailure();
            rethrow;
        }
        authSuccess();
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("PineconeDataProvider");
        return create_object("PineconeDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private PineconeRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new PineconeRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new PineconeRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return PineconeRestClientBase::getOptions(rv);
    }
}

#! OAuth2 defaults for Pinecone organization administration
public class PineconeAdminRestClientBase {
    public {
        #! The endpoint issuing short-lived service-account access tokens
        const TokenUrl = "https://login.pinecone.io/oauth/token";

        #! The only audience accepted by Pinecone's client-credentials endpoint
        const Audience = "https://api.pinecone.io/";

        #! Defaults shared by synchronous, asynchronous and connection-based clients
        const DefaultOptions = {
            "url": PineconeRestClientBase::DefaultControlPlaneUrl,
            "oauth2_grant_type": "client_credentials",
            "oauth2_token_url": TokenUrl,
            "oauth2_token_args": {"audience": Audience},
        };
    }

    #! Adds the fixed grant, audience and version to Admin client options
    /** @param options REST options including the service account's client ID and secret
        @return complete Admin REST options
        @throw PINECONE-ADMIN-OPTION-ERROR an API key or another OAuth grant was supplied
        @note Token renewal uses client credentials again; Pinecone does not issue a refresh token.
    */
    static hash<auto> getOptions(hash<auto> options) {
        hash<auto!> rv = DefaultOptions + options;
        if (options.apikey || rv.oauth2_grant_type != "client_credentials") {
            throw "PINECONE-ADMIN-OPTION-ERROR", "Pinecone Admin requires OAuth2 client credentials";
        }
        rv.oauth2_token_args = (rv.oauth2_token_args ?? {}) + {"audience": Audience};
        rv.headers = {PineconeRestClientBase::VersionHeader: PineconeRestClientBase::ApiVersion}
            + (rv.headers ?? {});
        return rv;
    }
}

#! Synchronous REST client for Pinecone's Admin API
/** @par Example
    @code{.py}
PineconeAdminRestClient admin({
    "oauth2_client_id": ENV.PINECONE_CLIENT_ID,
    "oauth2_client_secret": ENV.PINECONE_CLIENT_SECRET,
});
hash<auto> projects = admin.restGet("/admin/projects").body;
    @endcode
*/
public class PineconeAdminRestClient inherits RestClient::RestClient, PineconeAdminRestClientBase {
    #! Creates an Admin client
    /** @param opts REST options including client credentials
        @param do_not_connect retained for the standard REST client constructor contract
        @throw OAUTH2-ERROR required credentials are missing or token acquisition fails
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(PineconeAdminRestClientBase::getOptions(opts), True) {
    }
}

#! Multiplexed REST client for Pinecone's Admin API
public class PineconeAdminRestClientIo inherits RestClientIo::RestClientIo, PineconeAdminRestClientBase {
    #! Creates an asynchronous Admin client
    /** @param opts REST options including client credentials
        @param shared_mgr an optional shared HTTP connection manager
        @throw OAUTH2-ERROR required credentials are missing or token acquisition fails
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(PineconeAdminRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Service-account connection for Pinecone organization provisioning
/** Keeps organization credentials separate from the project API key used by PineconeRestConnection.
    The connection authenticates by listing projects and publishes the noninteractive OAuth2 capability.
*/
public class PineconeAdminRestConnection inherits RestClient::RestConnection {
    public {
        #! The Admin connection URL
        const DefaultUrl = "pinecone-admin://api.pinecone.io";

        #! Cheap authenticated read that also works for an organization without projects
        const PingPath = "/admin/projects";

        #! Connection options and discovery metadata
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Pinecone Admin Connection",
            "short_desc": "Manage Pinecone organizations with a service account",
            "desc": "Connect to [Pinecone Admin](https://docs.pinecone.io/guides/organizations/manage-service-accounts) "
                "to provision projects and manage access.\n\n"
                "- Uses the service account's **Client ID** and **Client Secret**\n"
                "- Acquires and renews OAuth2 bearer tokens automatically\n"
                "- Verifies credentials by listing accessible projects\n\n"
                "Create the service account in your Pinecone organization and grant the roles its workflows need.",
            "cls": Class::forName("PineconeAdminRestConnection"),
            "auto_url": True,
            "schemes": {"pinecone-admin": True},
            "base_scheme_map": {"https": "pinecone-admin"},
            "required_options": "oauth2_grant_type,oauth2_token_url,oauth2_client_id,oauth2_client_secret",
            "options": RestConnection::ConnectionScheme.options + {
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                    + <ConnectionOptionInfo>{"default_value": "client_credentials", "allowed_values": (
                        <AllowedValueInfo>{"value": "client_credentials", "display_name": "Client Credentials"},)},
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                    + <ConnectionOptionInfo>{"default_value": PineconeAdminRestClientBase::TokenUrl},
                "oauth2_client_id": RestConnection::ConnectionScheme.options.oauth2_client_id
                    + <ConnectionOptionInfo>{"display_name": "Client ID", "preselected": True, "sensitive": True,
                        "desc": "The OAuth2 client ID of a service account in your Pinecone organization. "
                            "This differs from the service account's resource ID."},
                "oauth2_client_secret": RestConnection::ConnectionScheme.options.oauth2_client_secret
                    + <ConnectionOptionInfo>{"display_name": "Client Secret", "preselected": True, "sensitive": True,
                        "desc": "The secret issued when the service account is created or rotated."},
                "ping_method": RestConnection::ConnectionScheme.options.ping_method
                    + <ConnectionOptionInfo>{"default_value": "GET"},
                "ping_path": RestConnection::ConnectionScheme.options.ping_path
                    + <ConnectionOptionInfo>{"default_value": PingPath},
            },
        };
    }

    #! Creates a named service-account connection
    /** @param name connection name
        @param description connection description
        @param url Admin connection URL
        @param attributes connection attributes
        @param options service-account credentials and optional REST settings
        @throw CONNECTION-OPTION-ERROR the options are invalid
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! Creates a connection from its configuration
    /** @param config connection configuration
        @param attr attribute overrides
        @throw CONNECTION-OPTION-ERROR the options are invalid
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! Returns the registered connection type
    /** @return pinecone-admin
    */
    string getType() {
        return "pinecone-admin";
    }

    #! Returns the application served by this connection
    /** @return PineconeAdmin
    */
    *string getAppName() {
        return "PineconeAdmin";
    }

    #! Returns whether the connection provides an application
    /** @return True
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the Admin data provider
    /** @param constructor_options optional provider options
        @return the Admin application root using this connection's asynchronous client
        @throw LOAD-MODULE-ERROR PineconeDataProvider could not be loaded
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("PineconeDataProvider");
        return create_object("PineconeAdminDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private PineconeAdminRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new PineconeAdminRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new PineconeAdminRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! Returns REST options with the fixed Admin OAuth2 configuration
    /** @param rtopts per-request REST options
        @return complete REST client options
        @throw PINECONE-ADMIN-OPTION-ERROR incompatible authentication was supplied
    */
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        return PineconeAdminRestClientBase::getOptions(RestConnection::getConnectionOptions(rtopts));
    }
}

}

public namespace QoreRagUtils {
#! Pinecone-backed vector store with lazy control-plane host resolution
/** Wraps Pinecone's two-plane API: the control plane at
    \c https://api.pinecone.io resolves the per-index data-plane host
    on first use, then subsequent operations route to that host, which
    is checked against @ref AllowedHostSuffix before any credentialed
    request is sent to it.

    @par Configuration

    @ref VectorStoreConfig fields:

    - \c collection (required): the Pinecone index name
    - \c options.api_key (required): Pinecone API key
    - \c options.namespace (optional): Pinecone namespace (default \c "")
    - \c options.url (optional): override control-plane URL
    - \c options.index_host (optional): pre-resolved data-plane host
      (skips the control-plane lookup)
    - \c options.dimension (optional): vector dimension; auto-probed
      from the index description on first call if omitted
*/
public class PineconeVectorStore inherits AbstractVectorStore {
    public {
        const Backend = "pinecone";

        #! The only host suffix a resolved data-plane host may have
        /** @see @ref checkIndexHost()
        */
        const AllowedHostSuffix = "pinecone.io";
    }

    private {
        hash<VectorStoreConfig> config;
        string index_name;
        string namespace_name;
        *string index_host;
        *PineconeRestClient::PineconeRestClientIo control_client;
        *PineconeRestClient::PineconeRestClientIo data_client;
        *int cached_dimension;
        Mutex init_mutex();
    }

    constructor(hash<VectorStoreConfig> config) {
        self.config = config;
        if (!config.collection.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "PineconeVectorStore requires 'collection' (Pinecone index name)";
        }
        if (!config.options.api_key.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "PineconeVectorStore requires 'options.api_key'";
        }
        index_name = config.collection;
        namespace_name = config.options.namespace ?? "";
        if (config.options.index_host.val()) {
            index_host = config.options.index_host;
        }
        if (exists config.options.dimension) {
            cached_dimension = config.options.dimension;
        }
    }

    upsert(list<hash<VectorRecord>> records) {
        if (!records) {
            return;
        }
        ensureDataClient();
        hash<auto!> body;
        body.vectors = map (
            "id": $1.id,
            "values": $1.vector,
            "metadata": $1.payload ?? {},
        ), records;
        if (namespace_name.val()) {
            body."namespace" = namespace_name;
        }
        data_client.restPost("/vectors/upsert", body);
        if (!exists cached_dimension && records[0].vector) {
            cached_dimension = records[0].vector.size();
        }
    }

    deleteByIds(list<string> ids) {
        if (!ids) {
            return;
        }
        ensureDataClient();
        hash<auto!> body;
        body.ids = ids;
        if (namespace_name.val()) {
            body."namespace" = namespace_name;
        }
        data_client.restPost("/vectors/delete", body);
    }

    list<hash<VectorSearchResult>> search(list<float> query_vector, int k,
            *hash<auto> filter) {
        ensureDataClient();
        hash<auto> body = {
            "vector": query_vector,
            "topK": k,
            "includeMetadata": True,
            "includeValues": False,
        };
        if (namespace_name.val()) {
            body."namespace" = namespace_name;
        }
        if (filter && filter.typeCode() == NT_HASH) {
            body.filter = filter;
        }
        hash<auto> resp = data_client.restPost("/query", body);

        *list<auto> matches = resp.body.matches;
        list<hash<VectorSearchResult>> result = ();
        foreach hash<auto> m in (matches ?? ()) {
            push result, <VectorSearchResult>{
                "id": (m.id ?? "").toString(),
                "score": (m.score ?? 0.0).toFloat(),
                "payload": m.metadata.typeCode() == NT_HASH ? m.metadata : NOTHING,
            };
        }
        return result;
    }

    string getCollection() {
        return index_name;
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        init_mutex.lock();
        on_exit init_mutex.unlock();
        if (exists cached_dimension) {
            return cached_dimension;
        }
        ensureControlClient();
        try {
            hash<auto> resp = control_client.restGet(
                sprintf("/indexes/%s", index_name));
            if (resp.body.dimension) {
                cached_dimension = resp.body.dimension.toInt();
                # also cache the host while we have the index description
                if (!exists index_host && resp.body.host) {
                    index_host = resp.body.host;
                }
                return cached_dimension;
            }
        } catch (hash<ExceptionInfo> ex) {
            # ignore — return -1 below
        }
        return -1;
    }

    private ensureControlClient() {
        if (!control_client) {
            hash<auto!> opts = {
                "url": config.options.url
                    ?? PineconeRestClient::PineconeRestClientBase::DefaultControlPlaneUrl,
                "apikey": config.options.api_key,
            };
            control_client = new PineconeRestClient::PineconeRestClientIo(opts);
        }
    }

    private ensureDataClient() {
        if (data_client) {
            return;
        }
        init_mutex.lock();
        on_exit init_mutex.unlock();
        if (data_client) {
            return;
        }
        if (!exists index_host) {
            # lazy control-plane lookup: GET /indexes/<name> → describes the
            # index and returns its data-plane host
            ensureControlClient();
            hash<auto> resp = control_client.restGet(
                sprintf("/indexes/%s", index_name));
            if (!resp.body.host) {
                throw "VECTOR-STORE-ERROR",
                    sprintf("Pinecone control-plane GET /indexes/%s did not "
                        "return a 'host' field; cannot route data-plane "
                        "requests", index_name),
                    {"body": resp.body};
            }
            index_host = resp.body.host;
            if (resp.body.dimension && !exists cached_dimension) {
                cached_dimension = resp.body.dimension.toInt();
            }
        }
        # build a data-plane client at https://<host>
        string data_url = "https://" + PineconeVectorStore::checkIndexHost(index_host);
        hash<auto!> opts = {
            "url": data_url,
            "apikey": config.options.api_key,
        };
        data_client = new PineconeRestClient::PineconeRestClientIo(opts);
    }

    #! Returns the bare host of a resolved data-plane host, refusing one outside Pinecone
    /** The data-plane host is followed out of a control-plane <b>response</b>, which means sending the
        API key somewhere the configuration never named - so it is checked rather than trusted.  The
        equivalent check in the schema-driven application is
        @ref RestSchemaActions::RestSchemaHostSourceInfo::allowed_host_suffixes "allowed_host_suffixes",
        and this is the same rule applied to the hand-written path.

        The suffix is matched <b>label by label</b>, so \c "evil-pinecone.io" is refused where
        \c "idx-1234.svc.aped-1234-a56b.pinecone.io" is accepted; a plain string-suffix test accepts
        both.  A value carrying credentials, naming no host, or naming a scheme other than \c https is
        refused as well: the scheme is fixed here and never taken from the response, so a
        misconfigured or compromised service cannot move a credentialed request onto cleartext.

        @param host the \c host member of the index description

        @return the bare host, without a scheme, port or path

        @throw VECTOR-STORE-ERROR the host is not a plain host under \c pinecone.io

        @note This class talks to Pinecone directly rather than through
        @ref RestSchemaActions::RestSchemaHostRouter "RestSchemaHostRouter": the router lives in
        \c RestSchemaActions, and %PineconeDataProvider requires this module rather than the reverse, so
        using it here would invert the dependency and make a program that only wants a vector store load
        the whole action framework.  What is shared is the <b>rule</b>, which is why it is spelled out
        above.
    */
    static string checkIndexHost(string host) {
        string h = host;
        # a scheme is accepted only if it is the one this client uses
        if (h =~ /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//) {
            if (h !~ /^https:\/\//) {
                throw "VECTOR-STORE-ERROR", sprintf("Pinecone returned the index host %y, which names a "
                    "scheme other than \"https\"; refusing to send the API key over it", host);
            }
            h = replace(h, "https://", "");
        }
        # credentials in the authority would send the key to whoever the response names
        if (h =~ /@/) {
            throw "VECTOR-STORE-ERROR", sprintf("Pinecone returned the index host %y, which carries "
                "credentials; refusing to use it", host);
        }
        # drop any path and port, leaving the bare host
        h = (h =~ x/^([^\/]*)/)[0] ?? "";
        h = (h =~ x/^([^:]*)/)[0] ?? "";
        if (!h.val()) {
            throw "VECTOR-STORE-ERROR", sprintf("Pinecone returned the index host %y, which names no "
                "host", host);
        }
        # matched label by label: "pinecone.io" admits a subdomain of it and nothing else, so
        # "evil-pinecone.io" is refused where a plain string-suffix test would accept it
        if (h != AllowedHostSuffix
            && h.substr(-(AllowedHostSuffix.size() + 1)) != "." + AllowedHostSuffix) {
            throw "VECTOR-STORE-ERROR", sprintf("Pinecone returned the index host %y, which is not %y or "
                "a subdomain of it; refusing to send the API key to it", host, AllowedHostSuffix);
        }
        return h;
    }
}

#! Factory for @ref PineconeVectorStore
public class PineconeVectorStoreFactory inherits AbstractVectorStoreFactory {
    string getType() {
        return "pinecone";
    }

    string getDisplayName() {
        return "Pinecone vector database";
    }

    AbstractVectorStore create(hash<VectorStoreConfig> config) {
        return new PineconeVectorStore(config);
    }
}
}
