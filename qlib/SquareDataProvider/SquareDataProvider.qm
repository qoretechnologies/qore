                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # New Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/events/" + EVENT_NEW_INVOICE,
            "action": EVENT_NEW_INVOICE,
            "groups": "Triggers",
            "display_name": "New Invoice",
            "short_desc": "Trigger when a new invoice is created",
            "desc": "Fires when a new invoice is created in Square. "
                "Uses polling to detect new records.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NEW_INVOICE,
            "options": {
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new records (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });

        # New Events
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/events/" + EVENT_NEW_EVENTS,
            "action": EVENT_NEW_EVENTS,
            "groups": "Triggers",
            "display_name": "New Events",
            "short_desc": "Trigger when new events occur",
            "desc": "Fires when new events are detected via the Square Events API. "
                "Supports filtering by event type. Uses polling with 28-day event retention.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NEW_EVENTS,
            "options": {
                "event_types": <ActionOptionInfo>{
                    "display_name": "Event Types",
                    "short_desc": "Event types to watch",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of Square event types to watch (e.g. 'payment.created'). "
                        "Defaults to all supported event types.",
                },
                "poll_interval": <ActionOptionInfo>{
                    "display_name": "Poll Interval",
                    "short_desc": "Polling interval in seconds",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "How often to check for new events (minimum 30 seconds)",
                    "default_value": DefaultPollInterval,
                },
            },
        });
    };
}

