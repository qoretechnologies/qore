# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) SquareRestClient
%requires uuid
%try-module json
%define NoJson
%endtry

module SquareDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Square payments and commerce";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new SquareDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": SquareDataProvider::AppName,
            "display_name": "Square",
            "short_desc": "Square payments and commerce platform",
            "desc": "Square is a comprehensive commerce platform for payments, online stores, "
                "invoicing, and business management.\n\n"
                "This integration supports customers, orders, payments, invoices, bookings, "
                "catalog items, inventory, refunds, and events.",
            "scheme": "squareres",
            "logo": SquareLogo,
            "logo_file_name": "square-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Payments, DataProvider::AppGroup::Ecommerce),
        });

        # ========== CUSTOMER ACTIONS ==========

        # Create a Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/customers/create",
            "action": "create-customer",
            "groups": "Customers",
            "display_name": "Create a Customer",
            "short_desc": "Create a new customer",
            "desc": "Create a new customer in Square",
            "action_code": DPAT_API,
            "options": {
                "given_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Customer first name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "First name of the customer",
                    "example_value": "John",
                },
                "family_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Customer last name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Last name of the customer",
                    "example_value": "Smith",
                },
                "email_address": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Customer email",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Email address of the customer",
                    "example_value": "john@example.com",
                },
                "phone_number": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Phone number",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Phone number of the customer",
                },
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company",
                    "short_desc": "Company name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Company name of the customer",
                },
                "note": <ActionOptionInfo>{
                    "display_name": "Note",
                    "short_desc": "Customer note",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "A note about the customer",
                },
                "reference_id": <ActionOptionInfo>{
                    "display_name": "Reference ID",
                    "short_desc": "External reference",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "An external reference ID for the customer",
                },
            },
        });

        # Update a Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/customers/update",
            "action": "update-customer",
            "groups": "Customers",
            "display_name": "Update a Customer",
            "short_desc": "Update an existing customer",
            "desc": "Update an existing customer in Square",
            "action_code": DPAT_API,
            "options": {
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "The customer to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
                "given_name": <ActionOptionInfo>{
                    "display_name": "First Name",
                    "short_desc": "Customer first name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "family_name": <ActionOptionInfo>{
                    "display_name": "Last Name",
                    "short_desc": "Customer last name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "email_address": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Customer email",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "phone_number": <ActionOptionInfo>{
                    "display_name": "Phone",
                    "short_desc": "Phone number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "company_name": <ActionOptionInfo>{
                    "display_name": "Company",
                    "short_desc": "Company name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "note": <ActionOptionInfo>{
                    "display_name": "Note",
                    "short_desc": "Customer note",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Add Customer to Group
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/customers/add-to-group",
            "action": "add-customer-to-group",
            "groups": "Customers",
            "display_name": "Add Customer to Group",
            "short_desc": "Add a customer to a group",
            "desc": "Add a customer to a customer group in Square",
            "action_code": DPAT_API,
            "options": {
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "The customer",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
                "group_id": <ActionOptionInfo>{
                    "display_name": "Group ID",
                    "short_desc": "The group to add to",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The ID of the customer group",
                    "ref_data": "customer_groups",
                },
            },
        });

        # Remove Customer From Group
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/customers/remove-from-group",
            "action": "remove-customer-from-group",
            "groups": "Customers",
            "display_name": "Remove Customer From Group",
            "short_desc": "Remove a customer from a group",
            "desc": "Remove a customer from a customer group in Square",
            "action_code": DPAT_API,
            "options": {
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "The customer",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
                "group_id": <ActionOptionInfo>{
                    "display_name": "Group ID",
                    "short_desc": "The group to remove from",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The ID of the customer group",
                    "ref_data": "customer_groups",
                },
            },
        });

        # List Customers
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/customers",
            "action": "list-customers",
            "groups": "Customers",
            "display_name": "List Customers",
            "short_desc": "List all customers",
            "desc": "List customers in Square with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "Filter by customer ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Maximum number of results to return",
                },
                "sort_field": <ActionOptionInfo>{
                    "display_name": "Sort Field",
                    "short_desc": "Field to sort by",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Field to sort by (DEFAULT, CREATED_AT)",
                },
                "sort_order": <ActionOptionInfo>{
                    "display_name": "Sort Order",
                    "short_desc": "Sort direction",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Sort direction (ASC, DESC)",
                },
            },
        });

        # Get a Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/customers",
            "action": "get-customer",
            "groups": "Customers",
            "display_name": "Get a Customer",
            "short_desc": "Get a single customer by ID",
            "desc": "Retrieve a single customer by ID from Square",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "The customer ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
            },
        });

        # Delete a Customer
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/customers/delete",
            "action": "delete-customer",
            "groups": "Customers",
            "display_name": "Delete a Customer",
            "short_desc": "Delete a customer",
            "desc": "Delete a customer from Square",
            "action_code": DPAT_API,
            "options": {
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "The customer to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
                "version": <ActionOptionInfo>{
                    "display_name": "Version",
                    "short_desc": "Customer version",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The current version of the customer profile (for optimistic concurrency)",
                },
            },
        });

        # ========== ORDER ACTIONS ==========

        # Create an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/orders/create",
            "action": "create-order",
            "groups": "Orders",
            "display_name": "Create an Order",
            "short_desc": "Create a new order",
            "desc": "Create a new order in Square",
            "action_code": DPAT_API,
            "options": {
                "location_id": <ActionOptionInfo>{
                    "display_name": "Location ID",
                    "short_desc": "The location for the order",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "locations",
                },
                "line_items": <ActionOptionInfo>{
                    "display_name": "Line Items",
                    "short_desc": "Order line items",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of line item hashes: name, quantity (string), "
                        "base_price_money (hash with amount in cents and currency)",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "The customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
                "reference_id": <ActionOptionInfo>{
                    "display_name": "Reference ID",
                    "short_desc": "External reference",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Create Paid Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/orders/create-paid",
            "action": "create-paid-order",
            "groups": "Orders",
            "display_name": "Create Paid Order",
            "short_desc": "Create and pay an order",
            "desc": "Create a new order in Square and immediately mark it as paid",
            "action_code": DPAT_API,
            "options": {
                "location_id": <ActionOptionInfo>{
                    "display_name": "Location ID",
                    "short_desc": "The location for the order",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "locations",
                },
                "line_items": <ActionOptionInfo>{
                    "display_name": "Line Items",
                    "short_desc": "Order line items",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of line item hashes",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "The customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
                "payment_ids": <ActionOptionInfo>{
                    "display_name": "Payment IDs",
                    "short_desc": "Existing payment IDs",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of payment IDs to apply. If empty, uses external payment.",
                },
            },
        });

        # Get Orders (Batch)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/orders/batch-get",
            "action": "get-orders",
            "groups": "Orders",
            "display_name": "Get Orders",
            "short_desc": "Get multiple orders by ID",
            "desc": "Retrieve multiple orders by their IDs in a single request",
            "action_code": DPAT_API,
            "options": {
                "order_ids": <ActionOptionInfo>{
                    "display_name": "Order IDs",
                    "short_desc": "List of order IDs",
                    "type": AbstractDataProviderTypeMap."list",
                    "required": True,
                    "desc": "List of order ID strings to retrieve",
                },
                "location_id": <ActionOptionInfo>{
                    "display_name": "Location ID",
                    "short_desc": "Filter by location",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "locations",
                },
            },
        });

        # Search Orders
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/orders",
            "action": "search-orders",
            "groups": "Orders",
            "display_name": "Search Orders",
            "short_desc": "Search for orders",
            "desc": "Search for orders in Square with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "Filter by order ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "location_ids": <ActionOptionInfo>{
                    "display_name": "Location IDs",
                    "short_desc": "Filter by locations",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "List of location IDs to search (auto-detected if not provided)",
                },
                "state": <ActionOptionInfo>{
                    "display_name": "State",
                    "short_desc": "Filter by order state",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Order state filter (OPEN, COMPLETED, CANCELED, DRAFT)",
                },
                "created_at_start": <ActionOptionInfo>{
                    "display_name": "Created After",
                    "short_desc": "Created after date",
                    "type": AbstractDataProviderTypeMap."*date",
                    "desc": "Return orders created at or after this timestamp (RFC 3339)",
                },
                "created_at_end": <ActionOptionInfo>{
                    "display_name": "Created Before",
                    "short_desc": "Created before date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "updated_at_start": <ActionOptionInfo>{
                    "display_name": "Updated After",
                    "short_desc": "Updated after date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "updated_at_end": <ActionOptionInfo>{
                    "display_name": "Updated Before",
                    "short_desc": "Updated before date",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/orders",
            "action": "get-order",
            "groups": "Orders",
            "display_name": "Get an Order",
            "short_desc": "Get a single order by ID",
            "desc": "Retrieve a single order by ID from Square",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "The order ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "orders",
                },
            },
        });

        # Cancel an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/orders/cancel",
            "action": "cancel-order",
            "groups": "Orders",
            "display_name": "Cancel an Order",
            "short_desc": "Cancel an order",
            "desc": "Cancel an open order in Square",
            "action_code": DPAT_API,
            "options": {
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "The order to cancel",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "orders",
                },
                "version": <ActionOptionInfo>{
                    "display_name": "Version",
                    "short_desc": "Order version",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "The current version of the order (for optimistic concurrency)",
                },
            },
        });

        # ========== PAYMENT ACTIONS ==========

        # Create a Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/payments/create",
            "action": "create-payment",
            "groups": "Payments",
            "display_name": "Create a Payment",
            "short_desc": "Create a new payment",
            "desc": "Create a new payment in Square",
            "action_code": DPAT_API,
            "options": {
                "source_id": <ActionOptionInfo>{
                    "display_name": "Source ID",
                    "short_desc": "Payment source",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "desc": "The source of funds (payment token, card ID, or 'EXTERNAL')",
                    "example_value": "EXTERNAL",
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "Payment amount in cents",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "desc": "The amount in the smallest currency unit (cents for USD)",
                    "example_value": 1000,
                },
                "currency": <ActionOptionInfo>{
                    "display_name": "Currency",
                    "short_desc": "Currency code",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The currency code (default: USD)",
                    "default_value": "USD",
                },
                "location_id": <ActionOptionInfo>{
                    "display_name": "Location ID",
                    "short_desc": "The location",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "locations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "The customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "The order",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "orders",
                },
                "reference_id": <ActionOptionInfo>{
                    "display_name": "Reference ID",
                    "short_desc": "External reference",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "note": <ActionOptionInfo>{
                    "display_name": "Note",
                    "short_desc": "Payment note",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "autocomplete": <ActionOptionInfo>{
                    "display_name": "Autocomplete",
                    "short_desc": "Complete immediately",
                    "type": AbstractDataProviderTypeMap."*bool",
                    "desc": "If true (default), payment completes immediately. If false, "
                        "must be completed later with complete-payment.",
                },
            },
        });

        # Complete Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/payments/complete",
            "action": "complete-payment",
            "groups": "Payments",
            "display_name": "Complete Payment",
            "short_desc": "Complete a payment",
            "desc": "Complete a pending payment in Square",
            "action_code": DPAT_API,
            "options": {
                "payment_id": <ActionOptionInfo>{
                    "display_name": "Payment ID",
                    "short_desc": "The payment to complete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "payments",
                },
                "version_token": <ActionOptionInfo>{
                    "display_name": "Version Token",
                    "short_desc": "Version token for concurrency",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Refund Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/payments/refund",
            "action": "refund-payment",
            "groups": "Payments",
            "display_name": "Refund Payment",
            "short_desc": "Refund a payment",
            "desc": "Create a refund for a payment in Square",
            "action_code": DPAT_API,
            "options": {
                "payment_id": <ActionOptionInfo>{
                    "display_name": "Payment ID",
                    "short_desc": "The payment to refund",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "payments",
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "Refund amount in cents",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "desc": "The refund amount in the smallest currency unit (cents for USD)",
                    "example_value": 1000,
                },
                "currency": <ActionOptionInfo>{
                    "display_name": "Currency",
                    "short_desc": "Currency code",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "The currency code (default: USD)",
                    "default_value": "USD",
                },
                "reason": <ActionOptionInfo>{
                    "display_name": "Reason",
                    "short_desc": "Reason for refund",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # List Payments
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/payments",
            "action": "list-payments",
            "groups": "Payments",
            "display_name": "List Payments",
            "short_desc": "List payments",
            "desc": "List payments in Square with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "payment_id": <ActionOptionInfo>{
                    "display_name": "Payment ID",
                    "short_desc": "Filter by payment ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "begin_time": <ActionOptionInfo>{
                    "display_name": "Begin Time",
                    "short_desc": "Start of time range",
                    "type": AbstractDataProviderTypeMap."*date",
                    "desc": "Return payments created at or after this timestamp (RFC 3339)",
                },
                "end_time": <ActionOptionInfo>{
                    "display_name": "End Time",
                    "short_desc": "End of time range",
                    "type": AbstractDataProviderTypeMap."*date",
                },
                "sort_order": <ActionOptionInfo>{
                    "display_name": "Sort Order",
                    "short_desc": "Sort direction",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Sort direction (ASC, DESC)",
                },
                "location_id": <ActionOptionInfo>{
                    "display_name": "Location ID",
                    "short_desc": "Filter by location",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "locations",
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                },
            },
        });

        # Get a Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SquareDataProvider::AppName,
            "path": "/payments",
            "action": "get-payment",
            "groups": "Payments",
            "display_name": "Get a Payment",
            "short_desc": "Get a single payment by ID",
            "desc": "Retrieve a single payment by ID from Square",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "payment_id": <ActionOptionInfo>{
                    "display_name": "Payment ID",
