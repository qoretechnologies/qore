#! Contains all public definitions in the SquareDataProvider module
public namespace SquareDataProvider {

#! Request type for creating a payment
public class SquareCreatePaymentRequestDataType inherits HashDataType {
    private {
        const Fields = {
            "source_id": {
                "type": StringType,
                "display_name": "Source ID",
                "short_desc": "Payment source (nonce or card ID)",
                "desc": "The ID for the source of funds for this payment. This can be a payment "
                    "token generated by the Web Payments SDK, a card on file ID, or 'EXTERNAL' "
                    "for recording external payments.",
                "required": True,
            },
            "amount": {
                "type": IntType,
                "display_name": "Amount",
                "short_desc": "Payment amount in cents",
                "desc": "The amount to charge in the smallest currency unit (cents for USD)",
                "required": True,
            },
            "currency": {
                "type": StringOrNothingType,
                "display_name": "Currency",
                "short_desc": "Currency code",
                "desc": "The currency code (default: USD)",
                "default_value": "USD",
            },
            "location_id": {
                "type": StringOrNothingType,
                "display_name": "Location ID",
                "short_desc": "The location",
                "desc": "The location ID to associate with the payment",
            },
            "customer_id": {
                "type": StringOrNothingType,
                "display_name": "Customer ID",
                "short_desc": "The customer",
                "desc": "The customer ID to associate with the payment",
            },
            "order_id": {
                "type": StringOrNothingType,
                "display_name": "Order ID",
                "short_desc": "The order",
                "desc": "The order ID to associate with the payment",
            },
            "reference_id": {
                "type": StringOrNothingType,
                "display_name": "Reference ID",
                "short_desc": "External reference",
                "desc": "An optional external reference ID for the payment",
            },
            "note": {
                "type": StringOrNothingType,
                "display_name": "Note",
                "short_desc": "Payment note",
                "desc": "An optional note to include with the payment",
            },
            "autocomplete": {
                "type": SoftBoolOrNothingType,
                "display_name": "Autocomplete",
                "short_desc": "Autocomplete the payment",
                "desc": "If true (default), the payment is completed immediately. If false, "
                    "the payment must be completed later with complete-payment.",
            },
        };
    }

    constructor() {
        addQoreFields(Fields);
    }
}

#! Square create payment action data provider
public class SquareCreatePaymentDataProvider inherits SquareDataProviderBase {
    public {
        const ProviderInfo = <DataProviderInfo>{
            "name": "create",
            "desc": "Create a new payment in Square",
            "type": "SquareCreatePaymentDataProvider",
            "supports_request": True,
            "constructor_options": ConstructorOptions,
        };

        const ConstructorOptions = BaseConstructorOptions;
    }

    constructor(SquareRestClient::SquareRestClient rest) : SquareDataProviderBase(rest) {
    }

    string getName() {
        return "create";
    }

    *string getDesc() {
        return "Create a new payment in Square";
    }

    private *AbstractDataProviderType getRequestTypeImpl() {
        return new SquareCreatePaymentRequestDataType();
    }

    private *AbstractDataProviderType getResponseTypeImpl() {
        return new SquarePaymentDataType();
    }

    private auto doRequestImpl(auto req, *hash<auto> request_options) {
        hash<auto> body = {
            "idempotency_key": generateIdempotencyKey(),
            "source_id": req.source_id,
            "amount_money": {
                "amount": req.amount,
                "currency": req.currency ?? "USD",
            },
        };
        if (req.location_id) {
            body.location_id = req.location_id;
        }
        if (req.customer_id) {
            body.customer_id = req.customer_id;
        }
        if (req.order_id) {
            body.order_id = req.order_id;
        }
        if (req.reference_id) {
            body.reference_id = req.reference_id;
        }
        if (req.note) {
            body.note = req.note;
        }
        if (exists req.autocomplete) {
            body.autocomplete = req.autocomplete;
        }
        return doPost("payments", body).payment;
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }
}

} # namespace SquareDataProvider
