#! the %McpServerHandler namespace holds all public definitions in the %McpServerHandler module
public namespace McpServerHandler {
#! MCP task status enum
public enum McpTaskStatus : string {
    #! Task is currently being processed
    Working = "working",
    #! Task requires additional input from the client
    InputRequired = "input_required",
    #! Task completed successfully
    Completed = "completed",
    #! Task failed with an error
    Failed = "failed",
    #! Task was cancelled
    Cancelled = "cancelled",
}

#! MCP task information
public hashdecl McpTaskInfo {
    #! Unique task identifier
    string taskId;

    #! Current task status
    string status;

    #! Human-readable status message
    *string statusMessage;

    #! When the task was created
    date createdAt;

    #! When the task was last updated
    date lastUpdatedAt;

    #! Time-to-live in milliseconds
    int ttl;

    #! Suggested poll interval in milliseconds
    int pollInterval;

    #! The method that created this task
    string method;

    #! Original request parameters
    *hash<auto> params;

    #! Task result (when completed)
    *hash<auto> result;

    #! Error information (when failed)
    *hash<auto> error;

    #! Session that owns this task
    string sessionId;

    #! The request ID that created this task (for cancellation tracking)
    *auto requestId;

    #! Optional progress token for notifications
    *string progressToken;

    #! Optional caller-provided idempotency key for task creation
    *string clientOperationId;

    #! Condition variable for blocking waits
    *Qore::Thread::Condition cond;

    #! Mutex for condition variable
    *Qore::Thread::Mutex lck;

    #! Whether the task has been cancelled
    bool cancelled = False;
}

#! MCP resource subscription information
public hashdecl McpResourceSubscription {
    #! URI of the subscribed resource
    string uri;

    #! Session that subscribed
    string sessionId;

    #! When the subscription was created
    date subscribedAt;
}

#! MCP resource template information
public hashdecl McpResourceTemplateInfo {
    #! URI template (RFC 6570)
    string uriTemplate;

    #! Name of the template
    string name;

    #! Optional human-readable title
    *string title;

    #! Description of the template
    *string description;

    #! MIME type of resources generated by this template
    *string mimeType;

    #! Optional annotations
    *hash<auto> annotations;

    #! Code to read the resource content
    *code reader;
}

#! MCP progress notification information
public hashdecl McpProgressInfo {
    #! Progress token identifying the operation
    string progressToken;

    #! Current progress value
    int progress;

    #! Total progress value (if known)
    *int total;

    #! Human-readable progress message
    *string message;
}

#! MCP pending request (server to client) information
public hashdecl McpPendingRequest {
    #! Request ID
    auto requestId;

    #! Method name
    string method;

    #! When the request was sent
    date sentAt;

    #! Timeout in milliseconds
    int timeout_ms;

    #! Condition variable for blocking waits
    Qore::Thread::Condition cond;

    #! Mutex for condition variable
    Qore::Thread::Mutex lck;

    #! Response from client (when received)
    *hash<auto> response;

    #! Error from client (when received)
    *hash<auto> error;

    #! Whether response has been received
    bool completed = False;
}

#! MCP cancellation information
public hashdecl McpCancellationInfo {
    #! Request ID that was cancelled
    auto requestId;

    #! Reason for cancellation
    *string reason;

    #! Whether the cancellation has been processed
    bool processed = False;

    #! When the cancellation was received
    date receivedAt;
}

#! MCP tool declaration
public hashdecl McpToolInfo {
    #! The name of the tool
    string name;

    #! The description of the tool
    string description;

    #! The input type of the tool
    *hash<auto> input;

    #! If the input type has been fully initialized
    *bool input_initialized;

    #! If the tool call requires mapping from a "data" property
    *bool needs_map;

    #! The code to call the tool
    code tool;

    #! Extra free-form info to store for the tool
    *hash<auto> extra;
}

#! MCP resource declaration
public hashdecl McpResourceInfo {
    #! The URI of the resource
    string uri;

    #! The name of the resource
    string name;

    #! The description of the resource
    string description;

    #! The MIME type of the resource
    string mimeType;

    #! The code to read the resource content
    *code reader;
}

#! MCP prompt declaration
public hashdecl McpPromptInfo {
    #! The name of the prompt
    string name;

    #! The description of the prompt
    string description;

    #! The arguments to the prompt
    *list<hash<auto>> arguments;

    #! The code to generate the prompt messages
    *code handler;
}

#! MCP tool call context
public hashdecl McpToolCallContext {
    #! The name of the tool
    string name;

    #! The description of the tool
    string description;

    #! The arguments to the tool
    *hash<auto> arguments;

    #! MCP session ID
    *string sid;

    #! Network context
    hash<auto> cx;

    #! The MCP server handler (for cancellation checks)
    *McpServerHandler handler;
}

# NOTE: MCP protocol constants (McpVersion, McpLogLevel, McpCompletionRefType enums,
# MCP_Version_Latest, AllMcpVersions, AllMcpLogLevels, McpSessionHeader)
# are imported and re-exported from the McpClient module

#! McpServer class definition; to be registered as a handler in the HttpServer class
/**
*/
public class McpServerHandler inherits JsonRpcHandler, ServerSentEventHandler {
    public {
        const IdTypeMap = {
            NT_STRING: True,
            NT_NUMBER: True,
            NT_FLOAT: True,
        };

        const McpSessionHeaderLwr = McpSessionHeader.lwr();

        const ServerInfo = {
            "protocolVersion": MCP_Version_Latest,
            "capabilities": {
                "logging": {},
                "prompts": {
                    "listChanged": True,
                },
                "resources": {
                    "subscribe": True,
                    "listChanged": True,
                },
                "tools": {
                    "listChanged": True,
                },
                "completions": {},
                "tasks": {
                    "list": {},
                    "cancel": {},
                    "requests": {
                        "tools": {
                            "call": {},
                        },
                    },
                },
            },
            "serverInfo": {
                "name": McpServerName,
                "version": McpServerVersion,
            }
        };

        #! The input description for tools that do not require any input
        const NoInputDescription = {
            "type": "object",
        };

        #! Default SSE handler options
        const SseHandlerOpts = {
            # JSON serialization is performed by this object when needed
            "data": "none",
        };

        #! Maximum name length for an MCP tool
        const MaxMcpToolNameLength = 60;

        #! Default session timeout in seconds (1 hour)
        const DefaultSessionTimeoutSecs = 3600;
    }

    private {
        #! Session timeout in seconds
        int session_timeout_secs = DefaultSessionTimeoutSecs;
        #! Registered tools: name -> tool
        hash<string, hash<McpToolInfo>> tmap;

        #! Registered resources: URI -> resource info
        hash<string, hash<McpResourceInfo>> rmap;

        #! Registered prompts: name -> prompt info
        hash<string, hash<McpPromptInfo>> pmap;

        #! Registered resource templates: uriTemplate -> template info
        hash<string, hash<McpResourceTemplateInfo>> rtmap;

        #! Session map; session ID -> session info
        hash<string, hash<McpSessionInfo>> smap;

        #! Session ID map
        hash<string, int> sidmap;

        #! Cancellation markers retained after a session is removed while
        #! its background tool calls are still unwinding.
        hash<string, hash<string, bool>> cancelledRequestTombstones;

        #! Session created by the last initialize() call (read by handleRequest)
        *string last_init_session;

        #! Request ID counter
        int rid = 0;

        #! Task ID counter
        int taskIdCounter = 0;

        #! Default task TTL in milliseconds (5 minutes)
        int defaultTaskTtl = 300000;

        #! Default poll interval in milliseconds (5 seconds)
        int defaultPollInterval = 5000;

        #! Maximum tasks per session
        int maxTasksPerSession = 100;

        #! Sampling request timeout in milliseconds (60 seconds)
        int samplingTimeout = 60000;

        #! Elicitation request timeout in milliseconds (5 minutes)
        int elicitationTimeout = 300000;
    }

    #! Creates the handler
    /**
    */
    constructor(Logger::LoggerInterface logger, HttpServer::AbstractAuthenticator auth)
            : JsonRpcHandler(logger, auth), ServerSentEventHandler(auth, SseHandlerOpts) {
        setupMethods();
    }

    #! Creates the handler
    /**
    */
    constructor(HttpServer::AbstractAuthenticator auth) : JsonRpcHandler(auth),
            ServerSentEventHandler(auth, SseHandlerOpts) {
        setupMethods();
    }

    #! Creates the handler
    /**
    */
    constructor() : ServerSentEventHandler(SseHandlerOpts) {
        setupMethods();
    }

    #! Registers a tool
    registerTool(string name, string desc, *AbstractDataProviderType input, code tool, *bool input_initialized,
            *hash<auto> extra, *AbstractDataProvider prov) {
        tmap{name} = getTool(name, desc, input, tool, input_initialized, extra, prov);
    }

    #! Unregisters a tool
    /** @param name the name of the tool to unregister
        @return True if the tool was unregistered, False if it was not found
    */
    bool unregisterTool(string name) {
        return exists remove tmap{name};
    }

    #! Returns a list of registered tool names
    list<string> getToolNames() {
        return keys tmap;
    }

    #! Checks if a tool is registered
    /** @param name the name of the tool
        @return True if the tool is registered
    */
    bool hasTools(string name) {
        return exists tmap{name};
    }

    #! Registers a resource
    /** @param uri the URI of the resource
        @param name the name of the resource
        @param desc the description of the resource
        @param mimeType the MIME type of the resource
        @param reader optional code to read the resource content; if not provided, the resource is not readable
    */
    registerResource(string uri, string name, string desc, string mimeType, *code reader) {
        rmap{uri} = <McpResourceInfo>{
            "uri": uri,
            "name": name,
            "description": desc,
            "mimeType": mimeType,
            "reader": reader,
        };
    }

    #! Unregisters a resource
    /** @param uri the URI of the resource to unregister
        @return True if the resource was unregistered, False if it was not found
    */
    bool unregisterResource(string uri) {
        return exists remove rmap{uri};
    }

    #! Registers a prompt
    /** @param name the name of the prompt
        @param desc the description of the prompt
        @param arguments optional list of argument definitions for the prompt
        @param handler optional code to generate prompt messages; receives (context, arguments) and should return
            a list of message hashes with "role" and "content" keys
    */
    registerPrompt(string name, string desc, *list<hash<auto>> arguments, *code handler) {
        pmap{name} = <McpPromptInfo>{
            "name": name,
            "description": desc,
            "arguments": arguments,
            "handler": handler,
        };
    }

    #! Unregisters a prompt
    /** @param name the name of the prompt to unregister
        @return True if the prompt was unregistered, False if it was not found
    */
    bool unregisterPrompt(string name) {
        return exists remove pmap{name};
    }

    #! Returns the next request ID and increments the internal counter
    string getNextRequestId() {
        AutoWriteLock al(rwl);
        return "s" + rid++;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data b) {
        *string session;
        # Track whether this is an SSE client (session from query param) vs streamable (session from header)
        bool sse_session = False;
        if (((cx.hdr.method == "GET") || (cx.hdr.method == "POST") || (cx.hdr.method == "DELETE"))
            && (session = hdr{McpSessionHeaderLwr}).val()) {
            AutoReadLock al(rwl);
            if (!smap{session}) {
                return AbstractHttpRequestHandler::makeResponse(404, "Session %y is invalid", session);
            }
        }
        if (!session.val() && cx.url.path =~ /\?/) {
            hash<UriQueryInfo> info = parse_uri_query(cx.url.path);
            if (info.params.session.val()) {
                session = info.params.session;
                # Session from query parameter indicates an SSE client (2024-11-05 protocol)
                sse_session = True;
                # Validate session from query parameter
                AutoReadLock al(rwl);
                if (!smap{session}) {
                    return AbstractHttpRequestHandler::makeResponse(404, "Session %y is invalid", session);
                }
            }
        }
        if (session.val()) {
            cx.mcp_session = session;
        }
        if (cx.hdr.method == "DELETE") {
            if (!session.val()) {
                return AbstractHttpRequestHandler::makeResponse(400, "Missing session ID in %y header to delete",
                    McpSessionHeader);
            }
            # The client has explicitly deleted the session: cancel any
            # in-progress tool execution so cooperative tools stop and any
            # waiters are released.  cancelSessionRequests() takes the write
            # lock itself and no-ops if the session is gone, so it must run
            # before the removal block.
            cancelSessionRequests(session, "session deleted by client");
            {
                AutoWriteLock al(rwl);
                # close all connections
                map $1.stop(), smap{session}.ssemap.iterator();
                # remove session
                remove smap{session};
            }
            return AbstractHttpRequestHandler::makeResponse(200, "Session %y deleted", session);
        }

        if (cx.hdr.method == "GET") {
            # make sure the client can accept an SSE stream response
            if (clientAcceptsSse(hdr)) {
                return ServerSentEventHandler::handleRequest(cx, hdr, b);
            }
            return AbstractHttpRequestHandler::makeResponse(405, "Client does not accept SSE responses");
        }
        last_init_session = NOTHING;
        hash<HttpResponseInfo> rv = JsonRpcHandler::handleRequest(cx, hdr, b);
        # Pick up session created by initialize() for streamable HTTP clients
        if (!session.val() && last_init_session.val()) {
            session = last_init_session;
            cx.mcp_session = session;
        }
        # Include session ID in response headers so client can track it
        if (session.val()) {
            rv.hdr{McpSessionHeader} = session;
        }
        # For SSE clients (2024-11-05 protocol), the response must be sent via the SSE
        # event stream, not in the HTTP response body.  SSE clients are identified by
        # having the session in the URL query parameter (not the Mcp-Session-Id header).
        # Streamable HTTP clients may also have SSE connections for notifications, but
        # their POST responses must still be returned in the HTTP body.
        if (sse_session) {
            *McpServerConnection conn;
            {
                AutoReadLock al(rwl);
                conn = smap{session}.ssemap.firstValue();
            }
            if (conn) {
                # Send the JSON-RPC response as a "message" event on the SSE stream
                conn.send(<SseMessageInfo>{
                    "event": "message",
                    "data": rv.body,
                });
                return AbstractHttpRequestHandler::makeResponse(202, "");
            }
        }
        # For streamable HTTP sessions, return the response in the HTTP body per the
        # MCP streamable HTTP spec.
        return rv;
    }

    #! Returns the 2024-11-05 JSON-RPC compatible endpoint, if any
    /** For SSE clients using the 2024-11-05 protocol, this returns the URL path where
        clients should POST JSON-RPC requests. The default implementation returns "/"
        since the McpServerHandler handles POST requests at the same path as SSE
        connections.

        @param cx the HTTP context
        @param hdr the HTTP headers

        @return the relative URL path for posting JSON-RPC requests, or NOTHING to disable
        SSE support for 2024-11-05 protocol
    */
    *string getCompatV1Endpoint(hash<auto> cx, hash<auto> hdr) {
        # By default, POST endpoint is the same as the SSE endpoint
        return "/";
    }

    int getNextIdForSession(string session) {
        *AutoWriteLock al = rwl.writeLockOwner() ? NOTHING : new AutoWriteLock(rwl);
        return ++sidmap{session};
    }

    #! Called when a connection is established; the default implementation creates a ServerSentEventConnection object
    /** SSE connections use the 2024-11-05 protocol version.
    */
    ServerSentEventConnection getConnectionImpl(Socket sock, hash<auto> cx, hash<auto> hdr, string cid) {
        # SSE connections use the 2024-11-05 protocol
        return new McpServerConnection(self, sock, cx, hdr, cid, McpVersion::V2024_11_05);
    }

    string getSessionId(hash<auto> hdr) {
        if ((*string s = hdr{McpSessionHeaderLwr}).val()) {
            # update last activity for existing session
            AutoWriteLock al(rwl);
            if (smap{s}) {
                smap{s}.last_activity = now_us();
            }
            return s;
        }
        string session;
%ifdef NoUuid
        session = get_random_string(50);
%else
        session = UUID::get();
%endif
        AutoWriteLock al(rwl);
        smap{session} = <McpSessionInfo>{
            "session": session,
            "last_activity": now_us(),
        };
        return session;
    }

    #! Sets the session timeout in seconds
    /** @param timeout_secs the timeout in seconds; 0 disables session timeout
    */
    setSessionTimeout(int timeout_secs) {
        session_timeout_secs = timeout_secs;
    }

    #! Returns the session timeout in seconds
    int getSessionTimeout() {
        return session_timeout_secs;
    }

    #! Cleans up expired sessions
    /** @return the number of sessions cleaned up
    */
    int cleanupExpiredSessions() {
        if (!session_timeout_secs) {
            return 0;
        }

        date cutoff = now_us() - seconds(session_timeout_secs);
        list<string> expired;

        {
            AutoReadLock al(rwl);
            foreach string sid in (keys smap) {
                if (smap{sid}.last_activity < cutoff) {
                    expired += sid;
                }
            }
        }

        if (!expired) {
            return 0;
        }

        # Cancel in-progress work for genuinely-expired sessions before removing
        # them.  cancelSessionRequests() acquires the write lock itself and
        # no-ops if the session is gone, so it must run outside the removal
        # write lock.  Re-verify expiry first so a session that became active
        # between the scan and now is left untouched (matching the removal
        # double-check below).
        foreach string sid in (expired) {
            bool still_expired;
            {
                AutoReadLock al(rwl);
                still_expired = smap{sid} && smap{sid}.last_activity < cutoff;
            }
            if (still_expired) {
                cancelSessionRequests(sid, "session expired");
            }
        }

        AutoWriteLock al(rwl);
        foreach string sid in (expired) {
            # double-check in case session was updated between locks
            if (smap{sid} && smap{sid}.last_activity < cutoff) {
                # close all connections
                map $1.stop(), smap{sid}.ssemap.iterator();
                remove smap{sid};
                remove sidmap{sid};
            }
        }
        return expired.size();
    }

    #! Returns the number of active sessions
    int getSessionCount() {
        AutoReadLock al(rwl);
        return smap.size();
    }

    #! Returns information about active sessions (for debugging/monitoring)
    list<hash<auto>> getSessionInfo() {
        AutoReadLock al(rwl);
        return map (
            "session": $1.session,
            "last_activity": $1.last_activity,
            "connection_count": $1.ssemap.size(),
        ), smap.iterator();
    }

    #! Returns the heartbeat message to send as a keep-alive
    /** Uses the default SSE comment format (":hb") which is properly ignored by SSE
        parsers, rather than a JSON-RPC ping which would require SSE-formatted encoding.
    */

    #! Called while holding the write lock to register the new connection
    private registerNewConnectionIntern(string cid, ServerSentEventConnection conn) {
        ServerSentEventHandler::registerNewConnectionIntern(cid, conn);
        McpServerConnection mcp_conn = cast<McpServerConnection>(conn);
        smap{mcp_conn.getSession()}.ssemap{mcp_conn.uniqueHash()} = mcp_conn;
    }

    #! Called when an SSE connection terminates
    deregisterConnectionImpl(ServerSentEventConnection conn) {
        McpServerConnection mcp_conn = cast<McpServerConnection>(conn);
        string sessionId = mcp_conn.getSession();
        info("SSE connection closed for session %y", sessionId);

        # Remove from session's SSE map
        {
            AutoWriteLock al(rwl);
            remove smap{sessionId}.ssemap{mcp_conn.uniqueHash()};
        }
    }

    private static bool clientAcceptsSse(hash<auto> hdr) {
        *string astr = hdr.accept;
        hash<auto> aih;
        if (!astr.val()) {
            # http://www.w3.org/Protocols/rfc2616/rfc2616-sec14.html: If no Accept header field is present, then
            # it is assumed that the client accepts all media types
            return True;
        }

        do {
            astr =~ s/;[^,]*//;
        } while (astr.rfind(";") != -1);
        astr =~ s/ +//g;
        map aih.$1 = True, astr.split(",");
        return aih{MimeTypeSse} || aih."*/*";
    }

    private hash<auto> toolsList(hash<auto> cx, *hash<auto> params) {
        return {
            "tools": getToolList(cx),
        };
    }

    private *list<hash<auto>> getToolList(hash<auto> cx) {
        list<hash<auto>> rv = ();
        foreach hash<McpToolInfo> tool in (tmap.iterator()) {
            hash<auto!> info = {
                "name": tool.name,
                "description": tool.description,
                "inputSchema": tool.input,
            };
            if (tool.extra.execution) {
                info.execution = tool.extra.execution;
            }
            push rv, info;
        }
        return rv;
    }

    private *hash<auto> toolsCall(hash<auto> cx, *hash<auto> params) {
        try {
            return toolsCallIntern(cx, params);
        } catch (hash<ExceptionInfo> ex) {
            error("Error executing tool with params %y: %s", params, get_exception_string(ex));
            return {
                "content": ({
                    "type": "text",
                    "text": make_json(ex{"err", "desc"}),
                },),
                "isError": True,
            };
        }
    }

    private hash<auto> resourcesList(hash<auto> cx, *hash<auto> params) {
        return {
            "resources": getResourceList(cx),
        };
    }

    private *list<hash<auto>> getResourceList(hash<auto> cx) {
        return map (
            "uri": $1.uri,
            "name": $1.name,
            "description": $1.description,
            "mimeType": $1.mimeType,
        ), rmap.iterator();
    }

    private *hash<auto> resourcesRead(hash<auto> cx, *hash<auto> params) {
        return resourcesReadIntern(cx, params);
    }

    private *hash<auto> resourcesReadIntern(hash<auto> cx, *hash<auto> params) {
        *hash<McpResourceInfo> info = rmap{params.uri};
        if (!info) {
            throw "MCP-SERVER-ARG-ERROR", sprintf("Resource %y is unknown; known resources: %y", params.uri,
                keys rmap);
        }
        if (!info.reader) {
            throw "MCP-SERVER-ARG-ERROR", sprintf("Resource %y does not have a reader defined", params.uri);
        }
        auto content = info.reader(cx, params.uri);
        # handle different content types
        hash<auto> result;
        if (content.typeCode() == NT_BINARY) {
            result = {
                "uri": params.uri,
                "mimeType": info.mimeType,
                "blob": content.toBase64(),
            };
        } else {
            result = {
                "uri": params.uri,
                "mimeType": info.mimeType,
                "text": content.typeCode() == NT_STRING ? content : make_json(content),
            };
        }
        return {
            "contents": (result,),
        };
    }

    private hash<auto> promptsList(hash<auto> cx, *hash<auto> params) {
        return {
            "prompts": getPromptList(cx),
        };
    }

    private *list<hash<auto>> getPromptList(hash<auto> cx) {
        return map (
            "name": $1.name,
            "description": $1.description,
            "arguments": $1.arguments,
        ), pmap.iterator();
    }

    private *hash<auto> promptsGet(hash<auto> cx, *hash<auto> params) {
        try {
            return promptsGetIntern(cx, params);
        } catch (hash<ExceptionInfo> ex) {
            error("Error getting prompt with params %y: %s", params, get_exception_string(ex));
            throw "MCP-PROMPT-ERROR", sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    private *hash<auto> promptsGetIntern(hash<auto> cx, *hash<auto> params) {
        *hash<McpPromptInfo> info = pmap{params.name};
        if (!info) {
            throw "MCP-SERVER-ARG-ERROR", sprintf("Prompt %y is unknown; known prompts: %y", params.name,
                keys pmap);
        }
        list<hash<auto>> messages;
        if (info.handler) {
            messages = info.handler(cx, params.arguments);
        } else {
            # default: return a simple user message with the prompt description
            messages = ({
                "role": "user",
                "content": {
                    "type": "text",
                    "text": info.description,
                },
            },);
        }
        return {
            "description": info.description,
            "messages": messages,
        };
    }

    private hash<auto> initialize(hash<auto> cx, *hash<auto> params) {
        if (params.protocolVersion.typeCode() != NT_STRING) {
            throw "MCP-SERVER-ARG-ERROR", "Missing or invalid protocolVersion";
        }
        hash<auto> rv = ServerInfo;
        if (AllMcpVersions{params.protocolVersion}) {
            rv.protocolVersion = params.protocolVersion;
        }
        # Create a session for streamable HTTP clients that don't have one yet;
        # stored in last_init_session so handleRequest() can include it in response headers
        # (cx is copied by JsonRpcHandler::callMethod so changes don't propagate back)
        if (!cx.mcp_session.val()) {
            cx.mcp_session = getSessionId(cx.hdr);
            last_init_session = cx.mcp_session;
        }
        # Store client capabilities if we have a session
        if (cx.mcp_session.val() && params.capabilities) {
            AutoWriteLock al(rwl);
            if (smap{cx.mcp_session}) {
                smap{cx.mcp_session}.clientCapabilities = params.capabilities;
            }
        }
        return rv;
    }

    *hash<auto> initialized(hash<auto> cx, *hash<auto> params) {
    }

    hash<auto> ping(hash<auto> cx, *hash<auto> params) {
        return {};
    }

    #! Handle completion/complete requests for autocompletion
    /** @param cx the context hash
        @param params the completion parameters including:
            - ref: hash with type (ref/prompt or ref/resource) and name/uri
            - argument: hash with name and value for the argument being completed
        @return hash with completion results including values array
    */
    private hash<auto> completionComplete(hash<auto> cx, *hash<auto> params) {
        try {
            return completionCompleteIntern(cx, params);
        } catch (hash<ExceptionInfo> ex) {
            error("Error in completion/complete with params %y: %s", params, get_exception_string(ex));
            return {
                "completion": {
                    "values": (),
                    "hasMore": False,
                },
            };
        }
    }

    #! Internal completion handler - can be overridden by subclasses
    private hash<auto> completionCompleteIntern(hash<auto> cx, *hash<auto> params) {
        *hash<auto> ref = params."ref";
        if (!ref) {
            throw "MCP-SERVER-ARG-ERROR", "Missing 'ref' parameter in completion request";
        }

        list<string> values = ();
        int total;
        bool hasMore = False;

        if (ref.type == McpCompletionRefType::Prompt) {
            # Complete prompt argument
            *hash<McpPromptInfo> info = pmap{ref.name};
            if (info && info.arguments) {
                # Find matching argument names
                string prefix = params.argument.value ?? "";
                foreach hash<auto> arg in (info.arguments) {
                    if (arg.name.find(prefix) == 0) {
                        values += arg.name;
                    }
                }
            }
        } else if (ref.type == McpCompletionRefType::Resource) {
            # Complete resource URI
            string prefix = params.argument.value ?? "";
            foreach string uri in (keys rmap) {
                if (uri.find(prefix) == 0) {
                    values += uri;
                }
            }
        }

        # Limit to 100 values as per spec
        if (values.size() > 100) {
            total = values.size();
            values = values[0..99];
            hasMore = True;
        }

        return {
            "completion": {
                "values": values,
                "total": total,
                "hasMore": hasMore,
            },
        };
    }

    #! Send a log message to connected clients
    /** @param level the log level (debug, info, notice, warning, error, critical, alert, emergency)
        @param logger optional logger name
        @param data the log message data
    */
    sendLogMessage(string level, *string logger, auto data) {
        hash<auto> params = {
            "level": level,
            "data": data,
        };
        if (logger.val()) {
            params.logger = logger;
        }
        # Collect connections under read lock to avoid lock upgrade deadlocks
        list<McpServerConnection> conns;
        {
            AutoReadLock al(rwl);
            foreach string sid in (keys smap) {
                if (*McpServerConnection conn = smap{sid}.ssemap.firstValue()) {
                    conns += conn;
                }
            }
        }
        foreach McpServerConnection conn in (conns) {
            conn.sendNotification("notifications/message", params);
        }
    }

    #! Handle logging/setLevel requests
    private *hash<auto> loggingSetLevel(hash<auto> cx, *hash<auto> params) {
        # This is a notification from the client about desired log level
        # The server can use this to filter what log messages to send
        # params.level contains the desired level
        return;
    }

    static *hash<McpToolCallContext> getToolCallContext() {
        return McpCallContextHelper::get();
    }

    private *hash<McpToolInfo> findToolForCall(hash<auto> cx, string name) {
        return tmap{name};
    }

    private *list<string> getKnownToolNames(hash<auto> cx) {
        return keys tmap;
    }

    private *hash<auto> makeToolCall(*hash<McpToolInfo> info, *hash<auto> params,
            *hash<McpToolCallContext> call_info) {
        try {
            auto rv = info.needs_map ? info.tool(params.arguments."data") : info.tool(params.arguments);
            # If the tool returns a list, treat as pre-formatted MCP content parts
            if (rv.typeCode() == NT_LIST) {
                return {"content": rv};
            }
            # If the tool returns a hash with a "content" key, pass through as-is
            if (rv.typeCode() == NT_HASH && rv.hasKey("content")) {
                return rv;
            }
            return {
                "content": ({
                    "type": "text",
                    "text": rv.typeCode() == NT_STRING ? rv : make_json(rv),
                },),
            };
        } catch (hash<ExceptionInfo> ex) {
            # put any response body data in the exception description
            if (ex.arg.typeCode() == NT_HASH) {
                if (ex.arg.hasKey("response-body")) {
                    rethrow ex.err, sprintf("%s (%y)", ex.desc, ex.arg."response-body");
                }
                if (ex.arg.hasKey("response_body_raw")) {
                    rethrow ex.err, sprintf("%s (%y)", ex.desc, ex.arg.response_body_raw);
                }
            }
            rethrow;
        }
    }

    private hash<McpToolInfo> getTool(string name, string desc, *AbstractDataProviderType input, code tool,
            *bool input_initialized, *hash<auto> extra, *AbstractDataProvider prov) {
        if (name.length() > MaxMcpToolNameLength) {
            throw "MCP-SERVER-ARG-ERROR", sprintf("Tool name %y is too long (max %y)", name,
                MaxMcpToolNameLength);
        }
        *hash<auto> input_desc;
        bool needs_map;
        if (input) {
            input_desc = getTypeDescriptionIntern("input", input, prov);
            debug("Creating tool %y (%y) input: %y (%s: %y) -> %y", name, desc, input ? input.getName() : "n/a",
                input ? input.className() : "n/a", keys (input ? input.getFields() : NOTHING), input_desc);
            if (input_desc.type.val() && input_desc.type != "object") {
                needs_map = True;
                input_desc = {
                    "type": "object",
                    "properties": {
                        "data": input_desc,
                    },
                };
                if (input.isMandatory()) {
                    input_desc.required = ("data",);
                }
            }
        }
        return <McpToolInfo>{
            "name": name,
            "description": getToolDescription(name, input_initialized, extra, desc),
            "input": input_desc ?? getNoInputDescription(name, input_initialized, extra),
            "input_initialized": input_initialized,
            "needs_map": needs_map,
            "tool": tool,
            "extra": extra,
        };
    }

    private string getToolDescription(string name, *bool input_initialized, *hash<auto> extra, string desc) {
        return desc;
    }

    private hash<auto> getNoInputDescription(string name, *bool input_initialized, *hash<auto> extra) {
        return NoInputDescription;
    }

    private hash<auto> getObjectDescription(hash<string, AbstractDataField> fields, *AbstractDataProvider prov,
            *hash<string, bool> tmap) {
        hash<auto> rv += {
            "type": "object",
        };
        list<string> required;
        foreach AbstractDataField field in (fields.iterator()) {
            AbstractDataProviderType t = field.getType();
            *hash<auto> info = getTypeDescription(field.getName(), field.getShortDescription(), t, prov, tmap);
            if (!info) {
                continue;
            }
            string name = field.getName();
            if (field.isMandatory()) {
                required += name;
            }
            if (*list<hash<AllowedValueInfo>> av = getAllowedValues(field, prov)) {
                info."enum" = map $1.value, av;
            }
            if (exists (auto v = field.getDefaultValue())) {
                info."default" = v;
            }
            rv.properties{name} = info;
        }
        if (required) {
            rv.required = required;
        }
        return rv;
    }

    private *list<hash<AllowedValueInfo>> getAllowedValues(AbstractDataField field,
            *AbstractDataProvider prov) {
        if ((*list<hash<AllowedValueInfo>> rv = field.getAllowedValues()) || !prov) {
            return rv;
        }
        *hash<auto> attr = field.getAttributes();
        if (attr.ref_data.val()) {
            return prov.getReferenceDataSafe(attr.ref_data);
        }
    }

    private *hash<auto> getTypeDescription(string name, *string desc, AbstractDataProviderType t,
            *AbstractDataProvider prov, *hash<string, bool> tmap) {
        *hash<auto> info += getTypeDescriptionIntern(name, t, prov, tmap);
        if (info && desc.val()) {
            info.description = desc;
        }
        return info;
    }

    private *hash<auto> getTypeDescriptionIntern(string name, AbstractDataProviderType t,
            *AbstractDataProvider prov, *hash<string, bool> tmap) {
        # "tmap" is passed by value, so it only tracks types on the current path; a type object reachable from more
        # than one parent (i.e. any shared subtype in a type DAG) would therefore have its description rebuilt at
        # every occurrence, which is exponential in the depth of the graph.  Memoize each type's description for
        # the duration of the traversal instead; descriptions are shared by reference, so this bounds both the time
        # and the memory by the number of distinct types in the graph
        bool toplevel = !exists tmap;
        on_exit if (toplevel) {
            remove _mcp_tdmap;
            remove _mcp_tdtrunc;
        }
        string ck = t.uniqueHash() + "-" + name;
        if (*hash<auto!> cached = _mcp_tdmap{ck}) {
            return cached.value;
        }

        int trunc0 = _mcp_tdtrunc ?? 0;
        *hash<auto> rv = getTypeDescriptionImpl(name, t, prov, tmap);
        # a description truncated by a cycle depends on the path taken to reach the type, so it cannot be memoized
        if ((_mcp_tdtrunc ?? 0) == trunc0) {
            _mcp_tdmap{ck} = {"set": True, "value": rv};
        }
        return rv;
    }

    #! Returns the JSON-schema description of the given type; cycle detection and memoization are done by the caller
    private *hash<auto> getTypeDescriptionImpl(string name, AbstractDataProviderType t,
            *AbstractDataProvider prov, *hash<string, bool> tmap) {
        if (*hash<string, AbstractDataField> fields = t.getFields()) {
            string uh = t.uniqueHash();
            if (tmap{uh}) {
                # count the truncation so that every type on the cycle's path is excluded from the cache as well
                _mcp_tdtrunc = (_mcp_tdtrunc ?? 0) + 1;
                return {
                    "type": "object",
                };
            }
            tmap{uh} = True;
            return getObjectDescription(fields, prov, tmap);
        }
        int type = t.getBaseTypeCode();
        if ((type == NT_LIST) && (*AbstractDataProviderType et = t.getElementType())
            && exists (*hash<auto> h = getTypeDescriptionIntern("items", et, prov, tmap))) {
            return {
                "type": "array",
                "items": getTypeDescription("items", "array items", et, prov, tmap),
            };
        }

        hash<auto> info;

        switch (type) {
            case NT_DATE:
            case NT_STRING:
                info.type = "string";
                break;

            case NT_INT:
                info.type = "integer";
                break;

            case NT_BOOLEAN:
                info.type = "boolean";
                break;

            case NT_NUMBER:
            case NT_FLOAT:
                info.type = "number";
                break;

            case NT_LIST:
                info = {
                    "type": "array",
                    "items": {
                    },
                };
                break;

            case NT_HASH:
                info.type = "object";
                break;

            case NT_BINARY:
                info = {
                    "type": "string",
                    "format": "base64",
                };
                break;

            case NT_ALL:
                info = {};

            case NT_OBJECT:
                if (!t.isMandatory()) {
                    return;
                }
                throw "TOOL-ARG-ERROR", sprintf("Tool parameter %y requires a value of type %y", name,
                    t.getBaseTypeName());

            case NT_NOTHING:
            case NT_NULL:
                return;

            default:
                throw "TOOL-ARG-ERROR", sprintf("Tool parameter %y has unsupported type %y (%s)", name,
                    t.getBaseTypeName(), t.className());
        }

        if (exists (auto v = t.getDefaultValue())) {
            info."default" = v;
        }
        return info;
    }

    #
    # Task Management Methods
    #

    #! Generates a unique task ID
    private string generateTaskId() {
        AutoWriteLock al(rwl);
        return sprintf("task-%d-%d", getpid(), ++taskIdCounter);
    }

    #! Creates a new task for background execution
    /** @param sessionId the session ID
        @param method the method that created this task
        @param params the original request parameters
        @param ttl optional TTL in milliseconds (defaults to defaultTaskTtl)
        @param requestId optional request ID from the original request
        @return the new task info
    */
    private hash<McpTaskInfo> createTask(string sessionId, string method, *hash<auto> params, *int ttl,
            *auto requestId, *string clientOperationId) {
        string taskId = generateTaskId();
        date now = now_us();

        hash<McpTaskInfo> task = <McpTaskInfo>{
            "taskId": taskId,
            "status": McpTaskStatus::Working,
            "createdAt": now,
            "lastUpdatedAt": now,
            "ttl": ttl ?? defaultTaskTtl,
            "pollInterval": defaultPollInterval,
            "method": method,
            "params": params,
            "sessionId": sessionId,
            "requestId": requestId,
            "progressToken": params._meta.progressToken,
            "clientOperationId": clientOperationId,
            "cond": new Qore::Thread::Condition(),
            "lck": new Qore::Thread::Mutex(),
        };

        {
            AutoWriteLock al(rwl);
            if (!smap{sessionId}) {
                throw "MCP-SESSION-ERROR", sprintf("Session %y not found", sessionId);
            }
            if (smap{sessionId}.tasks.size() >= maxTasksPerSession) {
                throw "MCP-TASK-ERROR", sprintf("Maximum tasks per session (%d) exceeded", maxTasksPerSession);
            }
            smap{sessionId}.tasks{taskId} = task;
            if (clientOperationId.val()) {
                smap{sessionId}.taskOperationIds{clientOperationId} = taskId;
            }
        }

        return task;
    }

    #! Updates a task's status
    /** @param sessionId the session ID
        @param taskId the task ID
        @param status the new status
        @param message optional status message
    */
    private updateTaskStatus(string sessionId, string taskId, string status, *string message) {
        {
            AutoWriteLock al(rwl);
            if (!smap{sessionId}.tasks{taskId}) {
                throw "MCP-TASK-ERROR", sprintf("Task %y not found in session %y", taskId, sessionId);
            }
            hash<McpTaskInfo> task = smap{sessionId}.tasks{taskId};
            task.status = status;
            task.statusMessage = message;
            task.lastUpdatedAt = now_us();
            smap{sessionId}.tasks{taskId} = task;
        }
        sendTaskStatusNotification(sessionId, taskId);
    }

    #! Sets the task result (on completion or error)
    /** @param sessionId the session ID
        @param taskId the task ID
        @param result optional result (for successful completion)
        @param error optional error (for failure)
    */
    private setTaskResult(string sessionId, string taskId, *hash<auto> result, *hash<auto> error) {
        *hash<McpTaskInfo> task = getTaskInfo(sessionId, taskId);
        if (!task) {
            throw "MCP-TASK-ERROR", sprintf("Task %y not found in session %y", taskId, sessionId);
        }

        {
            task.lck.lock();
            on_exit task.lck.unlock();

            {
                AutoWriteLock al(rwl);
                if (!smap{sessionId}.tasks{taskId}) {
                    throw "MCP-TASK-ERROR", sprintf("Task %y not found in session %y", taskId, sessionId);
                }
                task = smap{sessionId}.tasks{taskId};

                if (task.status == McpTaskStatus::Cancelled
                        || task.cancelled) {
                    task.status = McpTaskStatus::Cancelled;
                    task.cancelled = True;
                } else if (error) {
                    task.status = McpTaskStatus::Failed;
                    task.error = error;
                } else {
                    task.status = McpTaskStatus::Completed;
                    task.result = result;
                }
                task.lastUpdatedAt = now_us();
                smap{sessionId}.tasks{taskId} = task;
            }

            # Signal waiters while holding the condition lock so tasks/result
            # cannot miss completion between checking status and waiting.
            task.cond.broadcast();
        }

        sendTaskStatusNotification(sessionId, taskId);
    }

    #! Stores a background task's result, tolerating a session/task removed mid-execution
    /** A session can be torn down (HTTP \c DELETE or idle expiry) while a tool is still
        executing in the background.  When that happens there is no task to update and no
        client waiting for the result, so it is a benign condition: it is logged and
        ignored rather than allowed to escape as an unhandled exception in the background
        thread.  This keeps session teardown a fast, safe \c remove with no dependency on
        in-progress tasks.

        @param sessionId the session ID
        @param taskId the task ID
        @param result optional result (for successful completion)
        @param error optional error (for failure)
    */
    private reportTaskResult(string sessionId, string taskId, *hash<auto> result, *hash<auto> error_info) {
        try {
            setTaskResult(sessionId, taskId, result, error_info);
        } catch (hash<ExceptionInfo> ex) {
            if (!getTaskInfo(sessionId, taskId)) {
                info("Task %y (session %y) was removed before its result could be stored "
                    "(session torn down during execution); discarding result", taskId, sessionId);
            } else {
                error("Failed to store result for task %y (session %y): %s", taskId, sessionId,
                    get_exception_string(ex));
            }
        }
    }

    #! Sends a task status notification to the client
    /** @param sessionId the session ID
        @param taskId the task ID
    */
    private sendTaskStatusNotification(string sessionId, string taskId) {
        hash<McpTaskInfo> task;
        *McpServerConnection conn;
        {
            AutoReadLock al(rwl);
            if (!smap{sessionId}.tasks{taskId}) {
                return;
            }
            task = smap{sessionId}.tasks{taskId};
            conn = smap{sessionId}.ssemap.firstValue();
        }
        if (!conn) {
            return;
        }
        hash<auto> params = getTaskResponse(task);
        conn.sendNotification("notifications/tasks/status", params);
    }

    #! Sends a notification to a session's SSE connection
    /** @param sessionId the session ID
        @param method the notification method (e.g., "notifications/progress")
        @param params optional notification parameters
    */
    sendSessionNotification(string sessionId, string method, *hash<auto> params) {
        *McpServerConnection conn;
        {
            AutoReadLock al(rwl);
            if (smap{sessionId}) {
                conn = smap{sessionId}.ssemap.firstValue();
            }
        }
        if (!conn) {
            return;
        }
        try {
            conn.sendNotification(method, params);
        } catch (hash<ExceptionInfo> ex) {
            # Best-effort: a closed/broken stream should not break request handling.
        }
    }

    #! Gets a task's current information
    /** @param sessionId the session ID
        @param taskId the task ID
        @return the task info or NOTHING if not found
    */
    private *hash<McpTaskInfo> getTaskInfo(string sessionId, string taskId) {
        AutoReadLock al(rwl);
        return smap{sessionId}.tasks{taskId};
    }

    #! Cleans up expired tasks for a session
    /** @param sessionId the session ID
        @return the number of tasks cleaned up
    */
    private int cleanupExpiredTasks(string sessionId) {
        date now = now_us();
        list<string> expired;

        {
            AutoReadLock al(rwl);
            if (!smap{sessionId}) {
                return 0;
            }
            foreach string tid in (keys smap{sessionId}.tasks) {
                hash<McpTaskInfo> task = smap{sessionId}.tasks{tid};
                # Only clean up terminal tasks
                if (task.status == McpTaskStatus::Completed || task.status == McpTaskStatus::Failed
                        || task.status == McpTaskStatus::Cancelled) {
                    if ((now - task.lastUpdatedAt).durationMilliseconds() > task.ttl) {
                        expired += tid;
                    }
                }
            }
        }

        if (!expired) {
            return 0;
        }

        AutoWriteLock al(rwl);
        foreach string tid in (expired) {
            hash<McpTaskInfo> task = smap{sessionId}.tasks{tid};
            remove smap{sessionId}.tasks{tid};
            if (task.clientOperationId.val()) {
                remove smap{sessionId}.taskOperationIds{task.clientOperationId};
            }
        }
        return expired.size();
    }

    #
    # Task API Methods
    #

    #! Handle tasks/get request - get task status by ID
    private *hash<auto> tasksGet(hash<auto> cx, *hash<auto> params) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            throw "MCP-SESSION-ERROR", "No session ID in request";
        }
        if (!params.taskId.val()) {
            throw "MCP-TASK-ERROR", "Missing required parameter: taskId";
        }

        *hash<McpTaskInfo> task = getTaskInfo(sessionId, params.taskId);
        if (!task) {
            throw "MCP-TASK-ERROR", sprintf("Task %y not found", params.taskId);
        }

        return getTaskResponse(task);
    }

    #! Handle tasks/result request - block until task completes and return result
    private *hash<auto> tasksResult(hash<auto> cx, *hash<auto> params) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            throw "MCP-SESSION-ERROR", "No session ID in request";
        }
        if (!params.taskId.val()) {
            throw "MCP-TASK-ERROR", "Missing required parameter: taskId";
        }

        *hash<McpTaskInfo> task = getTaskInfo(sessionId, params.taskId);
        if (!task) {
            throw "MCP-TASK-ERROR", sprintf("Task %y not found", params.taskId);
        }

        # Calculate deadline based on timeout or TTL
        int timeout_ms = params.timeout ?? task.ttl;
        date deadline = now_us() + milliseconds(timeout_ms);

        while (True) {
            # Re-fetch before every wait.  The background task may complete
            # between the first lookup and the condition wait; using a stale
            # hash copy would then miss the broadcast and wait until timeout.
            task = getTaskInfo(sessionId, params.taskId);
            if (!task) {
                throw "MCP-TASK-ERROR", sprintf("Task %y was removed", params.taskId);
            }
            if (task.status != McpTaskStatus::Working
                    && task.status != McpTaskStatus::InputRequired) {
                break;
            }

            # Check for cancellation
            if (task.cancelled) {
                throw "MCP-TASK-CANCELLED", sprintf("Task %y was cancelled", params.taskId);
            }

            # Calculate remaining time until deadline
            int remaining_ms = (deadline - now_us()).durationMilliseconds();
            if (remaining_ms <= 0) {
                throw "MCP-TASK-TIMEOUT", sprintf("Task %y did not complete within timeout", params.taskId);
            }

            {
                task.lck.lock();
                on_exit task.lck.unlock();

                # Re-check while holding the condition lock.  setTaskResult()
                # updates status and broadcasts under the same lock, avoiding
                # the lost-wakeup race where completion lands between the
                # status check and wait().
                task = getTaskInfo(sessionId, params.taskId);
                if (!task) {
                    throw "MCP-TASK-ERROR", sprintf("Task %y was removed", params.taskId);
                }
                if (task.status != McpTaskStatus::Working
                        && task.status != McpTaskStatus::InputRequired) {
                    continue;
                }
                if (task.cond.wait(task.lck, remaining_ms)) {
                    task = getTaskInfo(sessionId, params.taskId);
                    if (task && task.status != McpTaskStatus::Working
                            && task.status != McpTaskStatus::InputRequired) {
                        continue;
                    }
                    throw "MCP-TASK-TIMEOUT", sprintf("Task %y did not complete within timeout", params.taskId);
                }
            }

        }

        # Return result or error based on status
        if (task.status == McpTaskStatus::Completed) {
            return task.result;
        } else if (task.status == McpTaskStatus::Failed) {
            throw "MCP-TASK-FAILED", sprintf("Task %y failed: %y", params.taskId, task.error);
        } else if (task.status == McpTaskStatus::Cancelled) {
            throw "MCP-TASK-CANCELLED", sprintf("Task %y was cancelled", params.taskId);
        }
        throw "MCP-TASK-ERROR", sprintf("Task %y has unexpected status: %y", params.taskId, task.status);
    }

    #! Handle tasks/cancel request - cancel a running task
    private *hash<auto> tasksCancel(hash<auto> cx, *hash<auto> params) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            throw "MCP-SESSION-ERROR", "No session ID in request";
        }
        if (!params.taskId.val()) {
            throw "MCP-TASK-ERROR", "Missing required parameter: taskId";
        }

        hash<McpTaskInfo> task;
        {
            AutoWriteLock al(rwl);
            if (!smap{sessionId}.tasks{params.taskId}) {
                throw "MCP-TASK-ERROR", sprintf("Task %y not found", params.taskId);
            }
            task = smap{sessionId}.tasks{params.taskId};

            # Can only cancel running tasks
            if (task.status != McpTaskStatus::Working && task.status != McpTaskStatus::InputRequired) {
                throw "MCP-TASK-ERROR", sprintf("Task %y cannot be cancelled (status: %y)",
                    params.taskId, task.status);
            }

            task.status = McpTaskStatus::Cancelled;
            task.cancelled = True;
            task.statusMessage = params.reason ?? "Cancelled by client";
            task.lastUpdatedAt = now_us();
            smap{sessionId}.tasks{params.taskId} = task;
            if (task.requestId) {
                smap{sessionId}.cancellations{task.requestId} = <McpCancellationInfo>{
                    "requestId": task.requestId,
                    "reason": params.reason ?? "Cancelled by client",
                    "receivedAt": now_us(),
                };
                rememberCancellationTombstoneIntern(sessionId,
                    task.requestId);
            }
        }

        # Signal any waiters
        {
            task.lck.lock();
            on_exit task.lck.unlock();
            task.cond.broadcast();
        }

        sendTaskStatusNotification(sessionId, params.taskId);

        return getTaskResponse(getTaskInfo(sessionId, params.taskId));
    }

    #! Handle tasks/list request - list all tasks for session
    private hash<auto> tasksList(hash<auto> cx, *hash<auto> params) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            throw "MCP-SESSION-ERROR", "No session ID in request";
        }

        # Clean up expired tasks first
        cleanupExpiredTasks(sessionId);

        list<hash<auto>> tasks;
        {
            AutoReadLock al(rwl);
            if (smap{sessionId}) {
                foreach string tid in (keys smap{sessionId}.tasks) {
                    hash<McpTaskInfo> task = smap{sessionId}.tasks{tid};
                    # Filter by status if requested
                    if (params.status.val() && task.status != params.status) {
                        continue;
                    }
                    tasks += getTaskResponse(task);
                }
            }
        }

        return {
            "tasks": tasks,
        };
    }

    #! Builds a task response hash
    private hash<auto> getTaskResponse(hash<McpTaskInfo> task) {
        hash<auto> rv = {
            "taskId": task.taskId,
            "status": task.status,
            "createdAt": task.createdAt.format("YYYY-MM-DDTHH:mm:ss.xxxZ"),
            "lastUpdatedAt": task.lastUpdatedAt.format("YYYY-MM-DDTHH:mm:ss.xxxZ"),
            "ttl": task.ttl,
            "pollInterval": task.pollInterval,
        };
        if (task.statusMessage.val()) {
            rv.statusMessage = task.statusMessage;
        }
        if (task.clientOperationId.val()) {
            rv.clientOperationId = task.clientOperationId;
        }
        return rv;
    }

    #
    # Resource Subscription Methods
    #

    #! Handle resources/subscribe request
    private *hash<auto> resourcesSubscribe(hash<auto> cx, *hash<auto> params) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            throw "MCP-SESSION-ERROR", "No session ID in request";
        }
        if (!params.uri.val()) {
            throw "MCP-ARG-ERROR", "Missing required parameter: uri";
        }

        # Verify resource exists
        if (!rmap{params.uri} && !matchResourceTemplate(params.uri)) {
            throw "MCP-RESOURCE-ERROR", sprintf("Resource %y not found", params.uri);
        }

        {
            AutoWriteLock al(rwl);
            if (!smap{sessionId}) {
                throw "MCP-SESSION-ERROR", sprintf("Session %y not found", sessionId);
            }
            smap{sessionId}.subscriptions{params.uri} = <McpResourceSubscription>{
                "uri": params.uri,
                "sessionId": sessionId,
                "subscribedAt": now_us(),
            };
        }

        return {};
    }

    #! Handle resources/unsubscribe request
    private *hash<auto> resourcesUnsubscribe(hash<auto> cx, *hash<auto> params) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            throw "MCP-SESSION-ERROR", "No session ID in request";
        }
        if (!params.uri.val()) {
            throw "MCP-ARG-ERROR", "Missing required parameter: uri";
        }

        {
            AutoWriteLock al(rwl);
            if (!smap{sessionId}) {
                throw "MCP-SESSION-ERROR", sprintf("Session %y not found", sessionId);
            }
            remove smap{sessionId}.subscriptions{params.uri};
        }

        return {};
    }

    #! Notifies all subscribers of a resource update
    /** @param uri the URI of the updated resource
    */
    notifyResourceUpdated(string uri) {
        # Collect connections under read lock
        list<McpServerConnection> conns;
        {
            AutoReadLock al(rwl);
            foreach string sid in (keys smap) {
                if (smap{sid}.subscriptions{uri}) {
                    if (*McpServerConnection conn = smap{sid}.ssemap.firstValue()) {
                        conns += conn;
                    }
                }
            }
        }
        foreach McpServerConnection conn in (conns) {
            conn.sendNotification("notifications/resources/updated", {"uri": uri});
        }
    }

    #! Matches a URI against resource templates
    private *hash<McpResourceTemplateInfo> matchResourceTemplate(string uri) {
        foreach string tpl in (keys rtmap) {
            if (matchUriTemplate(tpl, uri)) {
                return rtmap{tpl};
            }
        }
        return NOTHING;
    }

    #! Simple URI template matching (RFC 6570 basic)
    private bool matchUriTemplate(string template, string uri) {
        # Convert template to regex pattern
        string pattern = template;
        pattern =~ s/\{[^}]+\}/[^\/]+/g;
        pattern = "^" + pattern + "$";
        return uri.regex(pattern);
    }

    #
    # Resource Template Methods
    #

    #! Registers a resource template
    /** @param uriTemplate the URI template (RFC 6570)
        @param name the name of the template
        @param desc the description of the template
        @param mimeType the MIME type of resources generated by this template
        @param reader optional code to read the resource content
        @param annotations optional annotations
    */
    registerResourceTemplate(string uriTemplate, string name, *string desc, *string mimeType, *code reader,
            *hash<auto> annotations) {
        rtmap{uriTemplate} = <McpResourceTemplateInfo>{
            "uriTemplate": uriTemplate,
            "name": name,
            "description": desc,
            "mimeType": mimeType,
            "reader": reader,
            "annotations": annotations,
        };
    }

    #! Unregisters a resource template
    /** @param uriTemplate the URI template to unregister
        @return True if the template was unregistered, False if it was not found
    */
    bool unregisterResourceTemplate(string uriTemplate) {
        return exists remove rtmap{uriTemplate};
    }

    #! Handle resources/templates/list request
    private hash<auto> resourcesTemplatesList(hash<auto> cx, *hash<auto> params) {
        return {
            "resourceTemplates": getResourceTemplateList(cx),
        };
    }

    private *list<hash<auto>> getResourceTemplateList(hash<auto> cx) {
        return map (
            "uriTemplate": $1.uriTemplate,
            "name": $1.name,
            "description": $1.description,
            "mimeType": $1.mimeType,
        ) + ($1.annotations ? {"annotations": $1.annotations} : {}), rtmap.iterator();
    }

    #
    # Progress Methods
    #

    #! Sends a progress notification to the client
    /** @param sessionId the session ID
        @param progressToken the progress token
        @param progress the current progress value
        @param total optional total progress value
        @param message optional progress message
    */
    sendProgress(string sessionId, string progressToken, int progress, *int total, *string message) {
        *McpServerConnection conn;
        {
            AutoReadLock al(rwl);
            if (!smap{sessionId}) {
                return;
            }
            conn = smap{sessionId}.ssemap.firstValue();
        }
        if (!conn) {
            return;
        }
        hash<auto> params = {
            "progressToken": progressToken,
            "progress": progress,
        };
        if (exists total) {
            params.total = total;
        }
        if (message.val()) {
            params.message = message;
        }
        conn.sendNotification("notifications/progress", params);
    }

    #! Extracts the progress token from request params
    private *string getProgressToken(*hash<auto> params) {
        return params._meta.progressToken;
    }

    #! Extracts standard MCP task augmentation parameters from a request
    private *hash<auto> getTaskAugmentation(*hash<auto> params) {
        if (!params) {
            return NOTHING;
        }
        if (params.hasKey("task")) {
            if (!params.task) {
                return {};
            }
            if (params.task.typeCode() != NT_HASH) {
                throw "MCP-TASK-ERROR", "tools/call task parameter must be an object";
            }
            return params.task;
        }
        # Backwards compatibility for older Qore clients.  The current MCP
        # Tasks spec uses params.task; _meta.task is accepted only so older
        # clients do not break while they migrate.
        if (params._meta.task) {
            return {};
        }
        return NOTHING;
    }

    #! Extracts optional task TTL from the standard task augmentation hash
    private *int getTaskTtl(*hash<auto> task_params) {
        if (!task_params || !task_params.ttl.val()) {
            return NOTHING;
        }
        int ttl = int(task_params.ttl);
        if (ttl <= 0) {
            throw "MCP-TASK-ERROR", "task.ttl must be a positive integer";
        }
        return ttl;
    }

    #! Extracts a caller idempotency key from request metadata
    private *string getClientOperationId(*hash<auto> params) {
        *string id = params._meta.clientOperationId;
        return id.val() ? id : NOTHING;
    }

    #! Returns an existing task for a caller idempotency key, if it is still retained
    private *hash<McpTaskInfo> getTaskByClientOperationId(string sessionId,
            string clientOperationId) {
        AutoReadLock al(rwl);
        *string taskId = smap{sessionId}.taskOperationIds{clientOperationId};
        return taskId.val() ? smap{sessionId}.tasks{taskId} : NOTHING;
    }

    #
    # Cancellation Methods
    #

    #! Handles cancellation notification
    private cancelRequest(hash<auto> cx, hash<auto> params) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            return;
        }

        # Validate requestId - must be present
        if (!exists params.requestId) {
            return;
        }

        # Collect cancelled task IDs and their condition/mutex for signaling after lock release
        list<hash<McpTaskInfo>> cancelledTasks;
        list<string> cancelledTaskIds;

        # Record the cancellation
        {
            AutoWriteLock al(rwl);
            if (smap{sessionId}) {
                smap{sessionId}.cancellations{params.requestId} = <McpCancellationInfo>{
                    "requestId": params.requestId,
                    "reason": params.reason,
                    "receivedAt": now_us(),
                };
                rememberCancellationTombstoneIntern(sessionId,
                    params.requestId);

                # Find and cancel ONLY tasks associated with this specific requestId
                foreach string tid in (keys smap{sessionId}.tasks) {
                    hash<McpTaskInfo> task = smap{sessionId}.tasks{tid};
                    # Only cancel if task's requestId matches AND task is still running
                    if (task.requestId == params.requestId
                            && (task.status == McpTaskStatus::Working
                                || task.status == McpTaskStatus::InputRequired)) {
                        # Mark task as cancelled
                        task.cancelled = True;
                        task.status = McpTaskStatus::Cancelled;
                        task.statusMessage = params.reason ?? "Request cancelled";
                        task.lastUpdatedAt = now_us();
                        smap{sessionId}.tasks{tid} = task;

                        # Collect for signaling after lock release
                        cancelledTasks += task;
                        cancelledTaskIds += tid;
                    }
                }

                # Cancel any pending server-to-client requests with matching requestId
                if (smap{sessionId}.pendingRequests{params.requestId}) {
                    hash<McpPendingRequest> req = smap{sessionId}.pendingRequests{params.requestId};
                    smap{sessionId}.pendingRequests{params.requestId}.error = {
                        "code": -32800,
                        "message": params.reason ?? "Request cancelled",
                    };
                    smap{sessionId}.pendingRequests{params.requestId}.completed = True;

                    # Signal waiters
                    req.lck.lock();
                    on_exit req.lck.unlock();
                    req.cond.broadcast();
                }
            }
        }

        # Signal waiters and send notifications outside the write lock
        foreach hash<McpTaskInfo> task in (cancelledTasks) {
            {
                task.lck.lock();
                on_exit task.lck.unlock();
                task.cond.broadcast();
            }
        }

        # Send status notifications for cancelled tasks
        foreach string tid in (cancelledTaskIds) {
            sendTaskStatusNotification(sessionId, tid);
        }
    }

    #! Checks if a request has been cancelled
    /** @param sessionId the session ID
        @param requestId the request ID
        @return True if the request has been cancelled
    */
    bool isRequestCancelled(string sessionId, auto requestId) {
        AutoReadLock al(rwl);
        return smap{sessionId}.cancellations{requestId}.val()
            || cancelledRequestTombstones{sessionId}{requestId.toString()};
    }

    private rememberCancellationTombstoneIntern(string sessionId,
            auto requestId) {
        if (!requestId) {
            return;
        }
        cancelledRequestTombstones{sessionId}{requestId.toString()} = True;
    }

    private clearCancellationTombstone(string sessionId, auto requestId) {
        if (!requestId) {
            return;
        }
        AutoWriteLock al(rwl);
        if (!cancelledRequestTombstones{sessionId}) {
            return;
        }
        remove cancelledRequestTombstones{sessionId}{requestId.toString()};
        if (!cancelledRequestTombstones{sessionId}) {
            remove cancelledRequestTombstones{sessionId};
        }
    }

    #! Marks a cancellation as processed
    /** @param sessionId the session ID
        @param requestId the request ID
    */
    markCancellationProcessed(string sessionId, auto requestId) {
        AutoWriteLock al(rwl);
        if (smap{sessionId}.cancellations{requestId}) {
            smap{sessionId}.cancellations{requestId}.processed = True;
        }
    }

    #! Cancels all in-progress tasks and pending requests for a session
    /** Invoked automatically on explicit session teardown — an HTTP \c DELETE of the
        session and idle session expiry — so cooperative tools stop promptly and any
        \c tasks/result waiters are released instead of blocking until timeout.  It is
        deliberately \b not invoked on routine SSE notification-stream disconnects:
        clients reconnect their listener while background tasks keep running, so a
        listener drop must not cancel work (see @ref reportTaskResult(), which keeps
        result storage safe if the session is removed mid-execution).  May also be
        called directly for explicit, application-driven teardown.

        Acquires the @ref rwl write lock internally, so it must be called \b before
        (not nested inside) any caller-held write lock.

        @param sessionId the session ID
        @param reason the cancellation reason
    */
    cancelSessionRequests(string sessionId, string reason = "session disconnected") {
        list<hash<McpTaskInfo>> cancelledTasks;
        list<string> cancelledTaskIds;
        int syncCount;

        {
            AutoWriteLock al(rwl);
            if (!smap{sessionId}) {
                return;
            }

            # Cancel all working tasks
            foreach string tid in (keys smap{sessionId}.tasks) {
                hash<McpTaskInfo> task = smap{sessionId}.tasks{tid};
                if (task.status == McpTaskStatus::Working
                        || task.status == McpTaskStatus::InputRequired) {
                    task.cancelled = True;
                    task.status = McpTaskStatus::Cancelled;
                    task.statusMessage = reason;
                    task.lastUpdatedAt = now_us();
                    smap{sessionId}.tasks{tid} = task;
                    cancelledTasks += task;
                    cancelledTaskIds += tid;

                    # Also record as a cancellation for isRequestCancelled() checks
                    if (task.requestId) {
                        smap{sessionId}.cancellations{task.requestId} = <McpCancellationInfo>{
                            "requestId": task.requestId,
                            "reason": reason,
                            "receivedAt": now_us(),
                        };
                        rememberCancellationTombstoneIntern(sessionId,
                            task.requestId);
                    }
                }
            }

            # Cancel active synchronous requests (non-task tools/call in progress)
            foreach string rid in (keys smap{sessionId}.activeRequests) {
                smap{sessionId}.cancellations{rid} = <McpCancellationInfo>{
                    "requestId": rid,
                    "reason": reason,
                    "receivedAt": now_us(),
                };
                rememberCancellationTombstoneIntern(sessionId, rid);
            }
            syncCount = smap{sessionId}.activeRequests.size();

            # Complete all pending server-to-client requests
            foreach string rid in (keys smap{sessionId}.pendingRequests) {
                if (!smap{sessionId}.pendingRequests{rid}.completed) {
                    smap{sessionId}.pendingRequests{rid}.error = {
                        "code": -32800,
                        "message": reason,
                    };
                    smap{sessionId}.pendingRequests{rid}.completed = True;
                }
            }
        }

        # Signal waiters outside the write lock
        foreach hash<McpTaskInfo> task in (cancelledTasks) {
            {
                task.lck.lock();
                on_exit task.lck.unlock();
                task.cond.broadcast();
            }
        }

        if (cancelledTaskIds || syncCount) {
            info("Session %y: cancelled %d task(s) and %d synchronous request(s): %s", sessionId,
                cancelledTaskIds.size(), syncCount, reason);
        }
    }

    #! Checks if the current tool call has been cancelled
    /** Can be called from within a tool implementation to check if the client has disconnected
        or sent a cancellation notification.

        @return True if the current call has been cancelled

        @note this method uses the thread-local \c McpToolCallContext to find the session and request IDs
    */
    static bool isCallCancelled() {
        *hash<McpToolCallContext> ctx = McpCallContextHelper::get();
        if (!ctx) {
            return False;
        }
        if (!ctx.handler || !ctx.sid || !ctx.cx.id) {
            ctx.handler.info("isCallCancelled: missing context: handler=%y sid=%y cx.id=%y",
                exists ctx.handler, ctx.sid, ctx.cx.id);
            return False;
        }
        bool rv = ctx.handler.isRequestCancelled(ctx.sid, ctx.cx.id);
        if (rv) {
            ctx.handler.info("isCallCancelled: request %y in session %y IS cancelled", ctx.cx.id, ctx.sid);
        }
        return rv;
    }

    #
    # Server-to-Client Request Methods
    #

    #! Sends a request to the client and waits for a response
    /** @param sessionId the session ID
        @param conn the SSE connection to use
        @param method the method name
        @param params the request parameters
        @param timeout_ms the timeout in milliseconds
        @return the response from the client
        @throw MCP-TIMEOUT if the request times out
        @throw MCP-CLIENT-ERROR if the client returns an error
    */
    private hash<auto> sendClientRequestAndWait(string sessionId, McpServerConnection conn, string method,
            hash<auto> params, int timeout_ms) {
        string requestId = getNextRequestId();

        hash<McpPendingRequest> pending = <McpPendingRequest>{
            "requestId": requestId,
            "method": method,
            "sentAt": now_us(),
            "timeout_ms": timeout_ms,
            "cond": new Qore::Thread::Condition(),
            "lck": new Qore::Thread::Mutex(),
        };

        {
            AutoWriteLock al(rwl);
            if (!smap{sessionId}) {
                throw "MCP-SESSION-ERROR", sprintf("Session %y not found", sessionId);
            }
            smap{sessionId}.pendingRequests{requestId} = pending;
        }

        on_exit {
            AutoWriteLock al(rwl);
            remove smap{sessionId}.pendingRequests{requestId};
        }

        # Send the request
        conn.sendRequest(method, params);

        # Wait for response
        pending.lck.lock();
        on_exit pending.lck.unlock();

        if (pending.cond.wait(pending.lck, timeout_ms)) {
            throw "MCP-TIMEOUT", sprintf("Client request %y timed out after %d ms", method, timeout_ms);
        }

        # Re-fetch from session map to get updated response
        hash<McpPendingRequest> result;
        {
            AutoReadLock al(rwl);
            result = smap{sessionId}.pendingRequests{requestId};
        }

        if (result.error) {
            throw "MCP-CLIENT-ERROR", sprintf("Client returned error: %y", result.error);
        }

        return result.response ?? {};
    }

    #! Handles a client response to a server-initiated request
    /** This should be called when receiving a response with an ID that matches a pending request
        @param cx the context
        @param response the response hash
    */
    handleClientResponse(hash<auto> cx, hash<auto> response) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            return;
        }

        auto requestId = response.id;
        if (!exists requestId) {
            return;
        }

        hash<McpPendingRequest> pending;
        {
            AutoWriteLock al(rwl);
            if (!smap{sessionId}.pendingRequests{requestId}) {
                return;
            }
            pending = smap{sessionId}.pendingRequests{requestId};

            if (response.error) {
                smap{sessionId}.pendingRequests{requestId}.error = response.error;
            } else {
                smap{sessionId}.pendingRequests{requestId}.response = response.result;
            }
            smap{sessionId}.pendingRequests{requestId}.completed = True;
        }

        # Signal waiters
        pending.lck.lock();
        on_exit pending.lck.unlock();
        pending.cond.broadcast();
    }

    #
    # Sampling Methods
    #

    #! Requests an LLM completion from the client
    /** @param sessionId the session ID
        @param request the sampling request with messages, modelPreferences, etc.
        @param timeout_ms optional timeout (defaults to samplingTimeout)
        @return the sampling response
        @throw MCP-CAPABILITY-ERROR if client does not support sampling
    */
    hash<auto> requestSampling(string sessionId, hash<auto> request, *int timeout_ms) {
        # Check client capabilities
        *hash<auto> clientCaps;
        *McpServerConnection conn;
        {
            AutoReadLock al(rwl);
            if (!smap{sessionId}) {
                throw "MCP-SESSION-ERROR", sprintf("Session %y not found", sessionId);
            }
            clientCaps = smap{sessionId}.clientCapabilities;
            conn = smap{sessionId}.ssemap.firstValue();
        }

        if (!clientCaps.sampling) {
            throw "MCP-CAPABILITY-ERROR", "Client does not support sampling";
        }
        if (!conn) {
            throw "MCP-CONNECTION-ERROR", "No active connection for session";
        }

        return sendClientRequestAndWait(sessionId, conn, "sampling/createMessage", request,
            timeout_ms ?? samplingTimeout);
    }

    #
    # Elicitation Methods
    #

    #! Requests form input from the client
    /** @param sessionId the session ID
        @param message the message to display to the user
        @param schema the JSON Schema for the form
        @param timeout_ms optional timeout (defaults to elicitationTimeout)
        @return the elicitation response with action and content
        @throw MCP-CAPABILITY-ERROR if client does not support elicitation
    */
    hash<auto> requestElicitationForm(string sessionId, string message, hash<auto> schema, *int timeout_ms) {
        # Check client capabilities
        *hash<auto> clientCaps;
        *McpServerConnection conn;
        {
            AutoReadLock al(rwl);
            if (!smap{sessionId}) {
                throw "MCP-SESSION-ERROR", sprintf("Session %y not found", sessionId);
            }
            clientCaps = smap{sessionId}.clientCapabilities;
            conn = smap{sessionId}.ssemap.firstValue();
        }

        if (!clientCaps.elicitation) {
            throw "MCP-CAPABILITY-ERROR", "Client does not support elicitation";
        }
        if (!conn) {
            throw "MCP-CONNECTION-ERROR", "No active connection for session";
        }

        hash<auto> params = {
            "message": message,
            "requestedSchema": schema,
        };

        return sendClientRequestAndWait(sessionId, conn, "elicitation/create", params,
            timeout_ms ?? elicitationTimeout);
    }

    #! Modified toolsCallIntern to support task-based execution
    private *hash<auto> toolsCallIntern(hash<auto> cx, *hash<auto> params) {
        # Check if this should be a task-based call.  The standard MCP
        # 2025-11-25 shape is params.task; params._meta.task is accepted only
        # for backwards compatibility.
        *hash<auto> task_params = getTaskAugmentation(params);
        if (task_params) {
            # Pass the requestId from context for cancellation tracking
            return toolsCallAsTask(cx, params, task_params, cx.id);
        }

        *hash<McpToolInfo> info = findToolForCall(cx, params.name);
        if (!info) {
            throw "MCP-SERVER-ARG-ERROR", sprintf("Tool %y is unknown; known tools: %y", params.name,
                getKnownToolNames(cx));
        }
        hash<McpToolCallContext> call_info = <McpToolCallContext>{
            "name": info.name,
            "description": info.description,
            "sid": cx.mcp_session,
            "arguments": params.arguments,
            "cx": cx,
            "handler": self,
        };
        McpCallContextHelper mcch(call_info);

        # Track this synchronous request for cancellation support
        *string sessionId = cx.mcp_session;
        *string requestId = exists cx.id ? cx.id.toString() : NOTHING;
        if (sessionId.val() && requestId.val()) {
            AutoWriteLock al(rwl);
            if (smap{sessionId}) {
                smap{sessionId}.activeRequests{requestId} = True;
            }
        }
        on_exit {
            if (sessionId.val() && requestId.val()) {
                AutoWriteLock al(rwl);
                if (smap{sessionId}) {
                    remove smap{sessionId}.activeRequests{requestId};
                }
            }
            if (sessionId.val() && requestId.val()) {
                clearCancellationTombstone(sessionId, requestId);
            }
        }

        return makeToolCall(info, params, call_info);
    }

    #! Executes a tool call as a background task
    private hash<auto> toolsCallAsTask(hash<auto> cx, *hash<auto> params,
            *hash<auto> task_params, *auto requestId) {
        string sessionId = cx.mcp_session;
        if (!sessionId.val()) {
            throw "MCP-SESSION-ERROR", "No session ID for task-based call";
        }

        *hash<McpToolInfo> info = findToolForCall(cx, params.name);
        if (!info) {
            throw "MCP-SERVER-ARG-ERROR", sprintf("Tool %y is unknown; known tools: %y", params.name,
                getKnownToolNames(cx));
        }

        *string clientOperationId = getClientOperationId(params);
        if (clientOperationId.val()) {
            if (*hash<McpTaskInfo> existing =
                    getTaskByClientOperationId(sessionId, clientOperationId)) {
                return {
                    "task": getTaskResponse(existing),
                };
            }
        }

        # Create the task with the requestId for cancellation tracking
        hash<McpTaskInfo> task = createTask(sessionId, "tools/call", params,
            getTaskTtl(task_params), requestId, clientOperationId);

        # Start background execution
        background self.executeToolInBackground(sessionId, task.taskId, info, params, cx);

        # Return task info
        return {
            "task": getTaskResponse(task),
        };
    }

    #! Executes a tool in the background and sets the task result
    private executeToolInBackground(string sessionId, string taskId, hash<McpToolInfo> info, hash<auto> params,
            hash<auto> cx) {
        *auto requestId = cx.id;
        on_exit {
            if (requestId) {
                clearCancellationTombstone(sessionId, requestId);
            }
        }
        try {
            hash<McpToolCallContext> call_info = <McpToolCallContext>{
                "name": info.name,
                "description": info.description,
                "sid": sessionId,
                "arguments": params.arguments,
                "cx": cx,
                "handler": self,
            };
            McpCallContextHelper mcch(call_info);

            # Check if cancelled before starting
            *hash<McpTaskInfo> task = getTaskInfo(sessionId, taskId);
            if (!task || task.cancelled) {
                return;
            }

            hash<auto> result = makeToolCall(info, params, call_info);
            reportTaskResult(sessionId, taskId, result);
        } catch (hash<ExceptionInfo> ex) {
            reportTaskResult(sessionId, taskId, NOTHING, {
                "err": ex.err,
                "desc": ex.desc,
            });
        }
    }

    private setupMethods() {
        addMethods((
            {
                "name": "^initialize$",
                "text": "initialize",
                "function": \initialize(),
                "help": "MCP server initialization request handler",
                "include_context": True,
            },
            {
                "name": "^ping$",
                "text": "ping",
                "function": \ping(),
                "help": "MCP server client ping",
                "include_context": True,
            },
            {
                "name": "^notifications/initialized$",
                "text": "notifications/initialized",
                "function": \initialized(),
                "help": "MCP server client initialized notification",
                "include_context": True,
            },
            {
                "name": "^tools/list$",
                "text": "tools/list",
                "function": \toolsList(),
                "help": "MCP server list available tools",
                "include_context": True,
            },
            {
                "name": "^tools/call$",
                "text": "tools/call",
                "function": \toolsCall(),
                "help": "MCP server call tool",
                "include_context": True,
            },
            {
                "name": "^resources/list$",
                "text": "resources/list",
                "function": \resourcesList(),
                "help": "MCP server list available resources",
                "include_context": True,
            },
            {
                "name": "^resources/read$",
                "text": "resources/read",
                "function": \resourcesRead(),
                "help": "MCP server read resource content",
                "include_context": True,
            },
            {
                "name": "^prompts/list$",
                "text": "prompts/list",
                "function": \promptsList(),
                "help": "MCP server list available prompts",
                "include_context": True,
            },
            {
                "name": "^prompts/get$",
                "text": "prompts/get",
                "function": \promptsGet(),
                "help": "MCP server get prompt messages",
                "include_context": True,
            },
            {
                "name": "^notifications/cancelled$",
                "text": "notifications/cancelled",
                "function": \cancelRequest(),
                "help": "Try to cancel an in-progress request",
                "include_context": True,
            },
            {
                "name": "^completion/complete$",
                "text": "completion/complete",
                "function": \completionComplete(),
                "help": "MCP server autocompletion for prompts and resources",
                "include_context": True,
            },
            {
                "name": "^logging/setLevel$",
                "text": "logging/setLevel",
                "function": \loggingSetLevel(),
                "help": "Set the logging level for the server",
                "include_context": True,
            },
            # Task API methods
            {
                "name": "^tasks/get$",
                "text": "tasks/get",
                "function": \tasksGet(),
                "help": "Get task status by ID",
                "include_context": True,
            },
            {
                "name": "^tasks/result$",
                "text": "tasks/result",
                "function": \tasksResult(),
                "help": "Block until task completes and return result",
                "include_context": True,
            },
            {
                "name": "^tasks/cancel$",
                "text": "tasks/cancel",
                "function": \tasksCancel(),
                "help": "Cancel a running task",
                "include_context": True,
            },
            {
                "name": "^tasks/list$",
                "text": "tasks/list",
                "function": \tasksList(),
                "help": "List all tasks for session",
                "include_context": True,
            },
            # Resource subscription methods
            {
                "name": "^resources/subscribe$",
                "text": "resources/subscribe",
                "function": \resourcesSubscribe(),
                "help": "Subscribe to resource updates",
                "include_context": True,
            },
            {
                "name": "^resources/unsubscribe$",
                "text": "resources/unsubscribe",
                "function": \resourcesUnsubscribe(),
                "help": "Unsubscribe from resource updates",
                "include_context": True,
            },
            {
                "name": "^resources/templates/list$",
                "text": "resources/templates/list",
                "function": \resourcesTemplatesList(),
                "help": "List resource templates",
                "include_context": True,
            },
        ));
    }
}
}

namespace Priv {
hashdecl McpSessionInfo {
    # Session ID
    string session;

    # Active SSE connections; first is always primary
    hash<string, McpServerConnection> ssemap;

    # Last activity timestamp
    date last_activity;

    # Active tasks: taskId -> task info
    hash<string, hash<McpTaskInfo>> tasks;

    # Caller idempotency keys: clientOperationId -> taskId
    hash<string, string> taskOperationIds;

    # Resource subscriptions: uri -> subscription info
    hash<string, hash<McpResourceSubscription>> subscriptions;

    # Pending server-to-client requests: requestId -> pending request info
    hash<string, hash<McpPendingRequest>> pendingRequests;

    # Active cancellations: requestId -> cancellation info
    hash<string, hash<McpCancellationInfo>> cancellations;

    # Active synchronous request IDs (for cancellation tracking)
    hash<string, bool> activeRequests;

    # Client capabilities from initialize
    *hash<auto> clientCapabilities;

    # Logging level set by the client
    *string logLevel;
}

thread_local *hash<McpToolCallContext> _mcp_call_context;

#! Memoizes type descriptions for the duration of a single tool input-schema traversal
/** Keyed by type object identity and name; without this, a type object shared by multiple parents in a type DAG has
    its description rebuilt once per path, which is exponential in the depth of the graph
*/
thread_local hash<string, hash<auto!>> _mcp_tdmap;

#! Counts cycle truncations during a type-description traversal, so that path-dependent results are not memoized
thread_local int _mcp_tdtrunc;
class McpCallContextHelper {
    private {
        *hash<McpToolCallContext> old;
    }

    constructor(hash<McpToolCallContext> call_info) {
        old = _mcp_call_context;
        _mcp_call_context = call_info;
    }

    destructor() {
        _mcp_call_context = old;
    }

    static *hash<McpToolCallContext> get() {
        return _mcp_call_context;
    }
}
}
