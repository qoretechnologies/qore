# minimum qore version
%requires qore >= 2.0
%requires json
%requires Mime
%requires Util
%requires HttpServerUtil
%requires ServerSentEventHandler
# McpSubscriptionStream closes its stream through HttpServerAsyncIo::AbstractSseConnection;
# ServerSentEventHandler does not reexport the module, so it must be required here for the
# type to resolve when this module is loaded from source
%requires HttpServerAsyncIo
%requires JsonRpcHandler
%requires Logger
%requires DataProvider
%requires(reexport) McpClient
%try-module uuid
%define NoUuid
%endtry

%modern

module McpServerHandler {
    version = "1.0";
    desc = "McpServerHandler module for use with the Qore HttpServer module";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage McpServerHandler Module

    @tableofcontents

    @section mcpserverhandlerintro Introduction to the McpServerHandler Module

    The %McpServerHandler module provides server-side support for the Model Context Protocol (MCP)
    using the HttpServer module. It exposes tools, resources, prompts, and
    notifications via JSON-RPC over HTTP and Server-Sent Events (SSE).

    This module implements MCP <b>2026-07-28</b> and every earlier protocol revision back to
    2024-11-05, serving both from the same endpoint.

    @section McpServerHandler_eras Protocol Eras

    MCP changed shape fundamentally in revision
    \c 2026-07-28, which made the protocol stateless.
    This handler serves both shapes and selects between them per request, never per connection:

    |!Aspect|!Modern (2026-07-28)|!Legacy (2025-11-25 and earlier)
    |handshake|none; every request carries its protocol version, client identity, and \
        capabilities in \c _meta|\c initialize + \c notifications/initialized
    |sessions|none; the \c Mcp-Session-Id header is ignored and never minted|server-minted \
        session ID, torn down with HTTP \c DELETE
    |discovery|\c server/discover|the \c initialize result
    |change notifications|\c subscriptions/listen, whose response is a long-lived SSE stream|\
        a standalone \c GET SSE stream
    |resource subscriptions|the \c resourceSubscriptions filter of \c subscriptions/listen|\
        \c resources/subscribe / \c resources/unsubscribe
    |server-to-client requests|Multi Round-Trip Requests: the server returns an \
        \c InputRequiredResult and the client retries|the server sends a JSON-RPC request on \
        the event stream
    |tasks|the \c io.modelcontextprotocol/tasks extension: server-decided handles, \
        \c tasks/get polling, \c tasks/update|core \c tasks/get, \c tasks/result, \
        \c tasks/cancel, \c tasks/list
    |removed methods|\c ping, \c logging/setLevel, \c tasks/result, \c tasks/list|—

    A request that carries
    \c io.modelcontextprotocol/protocolVersion in its
    \c _meta member is served statelessly; an \c initialize request selects legacy semantics.
    Either era can be turned off with
    @ref McpServerHandler::McpServerHandler::setModernEnabled() "setModernEnabled()" and
    @ref McpServerHandler::McpServerHandler::setLegacyEnabled() "setLegacyEnabled()".

    @subsection McpServer_intro_mrtr Requesting input from the client

    Ask the client for an elicitation, an LLM completion, or its root list with
    @ref McpServerHandler::McpServerHandler::requestInput() "requestInput()".  The calling code
    is identical in both eras — with a modern client the call suspends the request and resumes
    when the client retries it with the answers attached:

    @code{.py}
    handler.registerTool("deploy", "Deploy a build", input, sub (hash<auto> args) {
        hash<auto> answers = McpServerHandler::getToolCallContext().handler.requestInput({
            "confirm": {
                "method": "elicitation/create",
                "params": {
                    "mode": "form",
                    "message": sprintf("Really deploy %y?", args.build),
                    "requestedSchema": ConfirmSchema,
                },
            },
        });
        if (answers.confirm.action != "accept") {
            return {"content": ({"type": "text", "text": "cancelled"},)};
        }
        return deploy(args.build);
    });
    @endcode

    The following classes are provided by this module:
    - @ref McpServerHandler::McpServerHandler "McpServerHandler"
    - @ref McpServerHandler::McpServerConnection "McpServerConnection"

    @subsection McpServer_intro_basic Basic server setup
    @code{.py}
    %requires McpServerHandler
    %requires HttpServer

    Logger logger("mcp-server", LoggerLevel::getLevelInfo());
    McpServerHandler::McpServerHandler handler(logger);

    # register a tool
    handler.registerTool("echo", "Echo a message", NOTHING, sub (hash<auto> args) {
        return {
            "content": [ { "type": "text", "text": args.message } ],
        };
    });

    # register a resource
    handler.registerResource("file:///hello.txt", "Hello", "Simple text resource", "text/plain",
        sub (hash<auto> cx, hash<auto> params) {
            return { "contents": [ { "uri": params.uri, "text": "Hello from MCP" } ] };
        });

    # register a prompt
    handler.registerPrompt("greeting", "Greeting prompt", (
        { "name": "name", "description": "Name to greet", "required": True }
    ), sub (hash<auto> cx, hash<auto> params) {
        return {
            "messages": [
                { "role": "user", "content": [ { "type": "text", "text": "Hello " + params.arguments.name } ] }
            ]
        };
    });

    # start HTTP server
    HttpServer http({"logger": logger});
    http.setHandler("mcp", "", MimeTypeJson, handler);
    http.setDefaultHandler("mcp", handler);
    http.addListener({"service": 8080});
    @endcode

    @subsection McpServer_intro_notifications Notifications
    The handler supports MCP notifications over SSE. Clients can open a GET request with an
    \c Accept: \c text/event-stream header to receive notifications and streamed responses.

    @subsection McpServer_intro_tasks Tasks API
    The handler supports the MCP Tasks API for background task execution:
    - \c tasks/get: Get task status by ID
    - \c tasks/result: Block until task completes and return result
    - \c tasks/cancel: Cancel a running task
    - \c tasks/list: List all tasks for the session

    To execute a tool call as a background task, include \c _meta.task: \c true in the request.

    @subsection McpServer_intro_resources Resource Features
    The handler supports:
    - Resource subscriptions via \c resources/subscribe and \c resources/unsubscribe
    - Resource templates via \c resources/templates/list
    - Resource update notifications via \c notifications/resources/updated

    @subsection McpServer_intro_progress Progress Notifications
    The server can send progress notifications using the \c sendProgress() method.
    Include \c _meta.progressToken in requests to enable progress tracking.

    @subsection McpServer_intro_sampling Sampling and Elicitation
    The server can request LLM completions from the client using \c requestSampling()
    and user input using \c requestElicitationForm() (requires client capability support).

    @section McpServerHandler_relnotes McpServerHandler Release Notes

    @subsection McpServerHandler_1_0 McpServerHandler v1.0
    - added support for the @ref mcp_apps "MCP Apps extension" (\c io.modelcontextprotocol/ui): a server can
      register a \c ui:// user interface resource with
      @ref McpServerHandler::McpServerHandler::registerUiResource() "registerUiResource()" and attach it to a tool
      with @ref McpServerHandler::McpServerHandler::registerUiTool() "registerUiTool()"; the extension is
      advertised only when the server actually ships an interface, and the extension's graceful-degradation
      requirement is enforced on every call
    - added @ref McpServerHandler::McpServerHandler::setServerInfo() "setServerInfo()" and
      @ref McpServerHandler::McpServerHandler::getServerInfo() "getServerInfo()": without them every embedding
      server identified itself to clients as \c QoreMcpServer
    - the mandatory connection bookkeeping moved out of
      @ref McpServerHandler::McpServerHandler::deregisterConnectionImpl() "deregisterConnectionImpl()" and
      \c getConnectionImpl(), which are documented customization points; a subclass using either as documented
      used to break the handler with no error reported anywhere
    - the \c notify*() methods are now safe to call with the handler's write lock held, so a server can mutate
      its catalog and announce the change in the same critical section
    - initial release
    - MCP 2026-07-28 protocol support, served from the same endpoint as every earlier
      revision (see @ref McpServerHandler_eras):
      - stateless request handling: the protocol version, client identity, and client
        capabilities are read from each request's \c _meta field, and no session is minted,
        echoed, or required
      - mandatory \c server/discover reporting supported versions, capabilities, and identity
      - \c subscriptions/listen: a POST whose response is a long-lived SSE stream carrying only
        the notification types the client opted in to, each tagged with its subscription ID,
        and closed gracefully with the request's own JSON-RPC response
      - Multi Round-Trip Requests via
        @ref McpServerHandler::McpServerHandler::requestInput() "requestInput()", with opaque
        \c requestState integrity-protected by @ref McpServerHandler::McpRequestState
        "McpRequestState" and bound to the principal, the originating request, and a TTL
      - the \c io.modelcontextprotocol/tasks extension: server-decided task handles,
        \c tasks/get polling, \c tasks/update for mid-flight input, and \c notifications/tasks
      - required \c resultType, \c _meta.serverInfo, and \c ttlMs / \c cacheScope members on
        results, and deterministic \c tools/list ordering
      - \c MCP-Protocol-Version / \c Mcp-Method / \c Mcp-Name / \c Mcp-Param-* header
        validation against the request body, with \c -32020, \c -32021, and \c -32022 errors
        and their required HTTP status codes
      - methods removed in 2026-07-28 (\c ping, \c logging/setLevel, \c resources/subscribe,
        \c resources/unsubscribe, \c tasks/result, \c tasks/list) remain available to clients
        using earlier protocol revisions and return \c -32601 to modern clients
    - fixed two defects that prevented a server-to-client request (sampling, elicitation,
      roots) from ever completing on handshake-based protocol revisions:
      - the client's JSON-RPC response, posted back to the MCP endpoint, was dispatched as if
        it were a method call instead of being routed to the waiting request
      - the waiter was registered under a different ID than the request was sent with, so an
        answer could never be matched to it
    - full MCP 2025-11-25 protocol support:
      - Tasks API (\c tasks/get, \c tasks/result, \c tasks/cancel, \c tasks/list)
      - task-augmented tool calls using the standard \c params.task shape; the
        legacy \c _meta.task parameter is also accepted for backwards
        compatibility with older Qore clients
      - caller idempotency via \c _meta.clientOperationId: repeating a
        task-based \c tools/call with the same id returns the existing task
        instead of creating a duplicate; the id is echoed back in the task
        response and tracked (and cleaned up) per session
      - \c tools/list advertises a tool's \c execution metadata (e.g.
        \c taskSupport) when provided
      - Resource subscriptions (\c resources/subscribe, \c resources/unsubscribe)
      - Resource templates (\c resources/templates/list)
      - Progress notifications (\c notifications/progress)
      - Full request cancellation support
      - Server-to-client sampling requests
      - Server-to-client elicitation requests
      - in-progress tasks survive SSE notification-stream disconnects: a routine
        listener reconnect no longer cancels running work; explicit teardown
        (HTTP \c DELETE / idle expiry) remains a fast, safe session removal and any
        still-running background task unwinds cleanly without affecting teardown
      - \c tasks/cancel now propagates cooperative cancellation to the running
        tool call and preserves the task's terminal \c cancelled state even if
        the tool returns after the cancel request
    - new data structures: \c McpTaskStatus enum, \c McpTaskInfo, \c McpResourceSubscription,
      \c McpResourceTemplateInfo, \c McpProgressInfo, \c McpPendingRequest, \c McpCancellationInfo
*/

#! the %McpServerHandler namespace holds all public definitions in the %McpServerHandler module
public namespace McpServerHandler {
#! Server name
public const McpServerName = "QoreMcpServer";

#! Server version
public const McpServerVersion = "1.0";
}
