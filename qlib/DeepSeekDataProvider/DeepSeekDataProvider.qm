%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) DeepSeekRestClient
%requires RestClientIo

module DeepSeekDataProvider {
    version = "1.1";
    desc = "user module providing a data provider API for DeepSeek AI services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factory
        DataProvider::registerFactory(new DeepSeekDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": DeepSeekDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "DeepSeek",
            "short_desc": "DeepSeek frontier and reasoning LLMs via an OpenAI-compatible API",
            "desc": "Use [DeepSeek](https://platform.deepseek.com) to automate language and image tasks.\n\n"
                "- Generate chat and reasoning responses\n"
                "- Extract structured data and call tools\n"
                "- Complete code between a prompt and suffix\n"
                "- Upload images for reuse in vision requests\n"
                "- Inspect available models and account credit",
            "scheme": "deepseek",
            "logo": DeepSeekLogo,
            "logo_file_name": "deepseek-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        # register chat-completion action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DeepSeekDataProvider::AppName,
            "path": "/chat-completion",
            "action": "chat-completion",
            "display_name": "Chat Completion",
            "short_desc": "Generate a chat completion from a DeepSeek model",
            "desc": "Generate answers, analyze images, or call functions from a conversation history.\n\n"
                "Use `thinking` to control reasoning and `response_format` for JSON output. "
                "For JSON mode, also instruct the model to produce JSON. "
                "Prefix messages and strict tools automatically use the beta endpoint.",
            "action_code": DPAT_API,
            "mutates_state": False,
            "groups": ("Chat",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                DeepSeekChatCompletionRequestDataType::Fields{"messages", "model",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                DeepSeekChatCompletionRequestDataType::Fields{
                    "temperature", "max_tokens",
                }, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                DeepSeekChatCompletionRequestDataType::Fields - (
                    "messages", "model", "temperature", "max_tokens", "stream",
                )
            ),
            "output_type": DeepSeekChatCompletionDataProvider::ResponseType,
        });
        DeepSeekActions::registerActions();
    };
}

/** @mainpage DeepSeekDataProvider Module

    @tableofcontents

    @section deepseekdataproviderintro DeepSeekDataProvider Introduction

    The %DeepSeekDataProvider module provides a data provider API for
    <a href="https://platform.deepseek.com">DeepSeek</a> chat models.

    The following data providers are exposed:
    - @ref DeepSeekDataProvider::DeepSeekDataProvider "DeepSeekDataProvider"
      — the root provider
    - @ref DeepSeekDataProvider::DeepSeekChatCompletionDataProvider
      "DeepSeekChatCompletionDataProvider" — OpenAI-compatible chat

    @par Example:
    @code{.py}
%requires DeepSeekDataProvider

DeepSeekRestConnection rc = get_connection("deepseek");
DeepSeekDataProvider::DeepSeekDataProvider prov(rc.getAsync());

AbstractDataProvider chat = prov.getChildProvider("chat-completion");
hash<auto> result = chat.doRequest({
    "model": "deepseek-v4-flash",
    "messages": (
        {"role": "user", "content": "Hello!"},
    ),
});
printf("Response: %s\n", result.choices[0].message.content);
    @endcode

    @section deepseekdataprovidercoverage API Coverage

    Contracts follow the <a href="https://api-docs.deepseek.com/api/create-chat-completion">DeepSeek API reference</a>
    verified in September 2026. Available models are queried at runtime.

    |!Action|!Endpoint|!Purpose
    |Chat Completion|POST /v1/chat/completions|Chat, reasoning, vision, JSON output, function calls
    |Fill in the Middle|POST /beta/completions|Insert text between a prompt and suffix
    |Create Response|POST /v1/responses|Stateless responses, JSON Schema output, web search, functions, vision
    |List Models|GET /v1/models|Available models and model dropdowns
    |Get Balance|GET /v1/user/balance|Credit availability and balances
    |Upload Image File|POST /v1/files|JPEG, PNG, GIF, or WebP images with optional expiration
    |List Image Files|GET /v1/files|Paginated file listing
    |Get Image File|GET /v1/files/{file_id}|File metadata and expiration
    |Delete Image File|DELETE /v1/files/{file_id}|Remove an uploaded image

    @note
    - Generation actions return completed responses. For streaming chat, use
      @ref DeepSeekRestClient::DeepSeekLlmProvider "DeepSeekLlmProvider".
    - Prefix messages and strict function tools use <tt>/beta/chat/completions</tt> automatically.
    - Chat JSON output supports <tt>text</tt> or <tt>json_object</tt>; JSON Schema output is available through Create Response.
    - Responses are stateless: send the entire conversation on every call. There are no stored-response actions.
    - File content downloads are not documented by DeepSeek; images are referenced by their uploaded IDs.
    - Deprecated <tt>frequency_penalty</tt> and <tt>presence_penalty</tt>, and unsupported <tt>seed</tt> and <tt>user</tt> chat options
      are no longer advertised. Use <tt>user_id</tt> for chat isolation; Responses uses <tt>user</tt>.
    - API failures propagate without replaying requests that may already have generated billable tokens.
    - For Responses JSON Schema output, <tt>schema: {}</tt> accepts any JSON value. The <tt>schema</tt> field must still be
      present and non-null. The <tt>name</tt> field must be a string; empty and whitespace-only names are preserved.

    @par Example: Structured invoice extraction
    @code{.py}
AbstractDataProvider response = prov.getChildProvider("create-response");
hash<auto> invoice = response.doRequest({
    "model": "deepseek-v4-flash",
    "input": "Extract the total from: Invoice total USD 42.50",
    "reasoning": {"effort": "none"},
    "text": {"format": {
        "type": "json_schema", "name": "invoice",
        "schema": {"type": "object", "properties": {"total": {"type": "number"}}, "required": ("total",)},
    }},
    "max_output_tokens": 128,
});
    @endcode

    @section DeepSeekDataProviderRelnotes Release Notes

    @subsection DeepSeekDataProviderv1_1 DeepSeekDataProvider v1.1
    - Completed the documented API actions with typed inputs and outputs, model and file dropdowns,
      reasoning and vision support, multipart image uploads, and local validation.
    - Corrected chat option contracts and beta routing; added regression and opt-in live tests.
    - Accept valid empty Responses JSON Schemas and schema names while rejecting missing or null fields.
    - Updated the presentation catalog and all twelve existing translation locales.


    @subsection DeepSeekDataProviderv1_0 DeepSeekDataProvider v1.0
    - the initial version of the %DeepSeekDataProvider module
*/

#! contains all public definitions in the DeepSeekDataProvider module
public namespace DeepSeekDataProvider {
#! DeepSeek application name
public const AppName = "DeepSeek";
}

#! App logo loaded from file
namespace Priv {
const DeepSeekLogo = File::readTextFile(get_script_dir() + "/deepseek-logo.svg");
}
