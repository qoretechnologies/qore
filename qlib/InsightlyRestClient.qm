# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module InsightlyRestClient {
    version = "1.0";
    desc = "User module for calling Insightly CRM REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("insightlyrest",
            InsightlyRestConnection::ConnectionScheme);
    };
}

/** @mainpage InsightlyRestClient Module

    @tableofcontents

    @section insightlyrestclientintro InsightlyRestClient Introduction

    The %InsightlyRestClient module provides an API for calling Insightly CRM REST API services.

    To use this module, use \c "%requires InsightlyRestClient" in your code.

    All the public symbols in the module are defined in the InsightlyRestClient namespace.

    The main classes are:
    - @ref InsightlyRestClient::InsightlyRestClient "InsightlyRestClient":
      this class provides the REST client API for communication with the Insightly API;
      it handles API key authentication via HTTP Basic Auth
    - @ref InsightlyRestClient::InsightlyRestConnection "InsightlyRestConnection":
      provides a connection object to Insightly services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires InsightlyRestClient

InsightlyRestClient insightly({
    "apikey": ENV.INSIGHTLY_API_KEY,
    "pod": "na1",
});
hash<auto> result = insightly.get("Contacts?top=1");
printf("Contact: %N\n", result.body);
    @endcode

    @section insightlyrestclientrelnotes Release Notes

    @subsection insightlyrestclientv1_0 InsightlyRestClient v1.0
    - the initial version of the %InsightlyRestClient module
*/

#! the InsightlyRestClient namespace contains all the objects in the InsightlyRestClient module
public namespace InsightlyRestClient {

#! Common base class for InsightlyRestClient functionality
public class InsightlyRestClientBase {
    public {
        #! Default Insightly pod
        const DefaultPod = "na1";

        #! Known Insightly pods/regions
        const KnownPods = ("na1", "eu1", "au1");

        #! Default Insightly API URL (na1 pod)
        const DefaultUrl = "https://api.na1.insightly.com";

        #! Default API version path
        const DefaultApiVersion = "v3.1";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since default_path provides /v3.1)
        const DefaultPingPath = "Contacts?top=1";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "default_path": "/" + DefaultApiVersion,
            "headers": DefaultHeaders,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };

        #! Default connection URL
        const DefaultConnectionUrl = "insightlyrest://api.na1.insightly.com";
    }

    #! Returns the API base URL for a given pod
    /** @param pod the Insightly pod/region (e.g., \c "na1", \c "eu1", \c "au1")
        @return the base URL for the given pod
    */
    static string getUrlForPod(string pod) {
        return "https://api." + pod + ".insightly.com";
    }

    #! Returns the connection URL for a given pod
    /** @param pod the Insightly pod/region (e.g., \c "na1", \c "eu1", \c "au1")
        @return the connection URL for the given pod using the insightlyrest scheme
    */
    static string getConnectionUrlForPod(string pod) {
        return "insightlyrest://api." + pod + ".insightly.com";
    }

    #! returns options for the InsightlyRestClient constructor
    /** @param opts constructor options including:
        - \c apikey: the Insightly API key (used as HTTP Basic Auth username)
        - \c pod: the Insightly pod/region (\c "na1", \c "eu1", or \c "au1"); optional,
          defaults to \c "na1"

        @return processed options suitable for RestClient/RestClientIo constructors
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Build URL from pod
        string pod = opts.pod ?? DefaultPod;
        rv.url = InsightlyRestClientBase::getUrlForPod(pod);

        # Insightly uses HTTP Basic Auth: API key as username, empty password
        if (opts.apikey) {
            rv.username = opts.apikey;
            rv.password = "";
            remove rv.apikey;
        }

        # Remove raw options to prevent RestClient misinterpretation
        remove rv.pod;

        return rv;
    }
}

#! This class provides the REST client API for communication with Insightly CRM servers
/** Insightly uses a REST API at https://api.{pod}.insightly.com/v3.1 with HTTP Basic Auth
    authentication using the API key as the username and an empty password.

    @par Authentication:
    - API key via HTTP Basic Auth (apikey as username, empty password)
    - API key obtained from: User Settings > API in Insightly

    @par Pods/Regions:
    Insightly operates on three pods:
    - \c na1 - North America (default)
    - \c eu1 - Europe
    - \c au1 - Australia

    @par Rate Limiting:
    - 10 requests per second
    - Daily request caps based on plan
    - Rate limit headers: \c X-RateLimit-Limit, \c X-RateLimit-Remaining

    @par API Structure:
    All endpoints are under /v3.1 (set via default_path)
*/
public class InsightlyRestClient inherits RestClient::RestClient, InsightlyRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
InsightlyRestClient insightly({
    "apikey": ENV.INSIGHTLY_API_KEY,
    "pod": "na1",
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient"
        class plus:
        - \c apikey: the Insightly API key (used as HTTP Basic Auth username)
        - \c pod: the Insightly pod/region (\c "na1", \c "eu1", or \c "au1"); optional,
          defaults to \c "na1"

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(InsightlyRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Insightly REST connections; returns @ref InsightlyRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref InsightlyRestClient::InsightlyRestClient::constructor() for more information on the
    above options
*/
public class InsightlyRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Insightly CRM REST Connection",
            "short_desc": "A connection to the Insightly CRM REST API",
            "desc": "A connection to the Insightly CRM REST API for managing contacts, organizations, "
                "opportunities, projects, tasks, leads, and other CRM data.\n\n"
                "**To obtain your API key:**\n"
                "1. Log in to your Insightly account\n"
                "2. Click your profile avatar in the top-right corner\n"
                "3. Go to **User Settings**\n"
                "4. Find the **API** section and copy your API key\n\n"
                "**Pod/Region:**\n"
                "Your pod determines the API endpoint URL. It is visible in your Insightly URL "
                "(e.g., `na1.insightly.com` means pod `na1`). If not provided, the connection "
                "will default to `na1`.\n\n"
                "**Rate limits:** 10 requests/second with daily caps based on your plan. "
                "Rate limit info is returned in `X-RateLimit-Limit` and `X-RateLimit-Remaining` "
                "response headers.",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your API Key",
                    "intent": "info",
                    "content": "1. Log in to your Insightly account\n"
                        "2. Click your profile avatar in the top-right corner\n"
                        "3. Go to **User Settings**\n"
                        "4. Find the **API** section and copy your API key\n\n"
                        "**Important:** The API key provides full access to your Insightly "
                        "data. Keep it secure and never share it publicly.",
                },
                <UiMessageInfo>{
                    "title": "Select Your Pod/Region",
                    "intent": "info",
                    "content": "Your Insightly pod determines the API endpoint URL. It is "
                        "visible in your Insightly URL (e.g., `na1.insightly.com` means "
                        "pod `na1`).\n\n"
                        "- **na1** — North America (default)\n"
                        "- **eu1** — Europe\n"
                        "- **au1** — Australia\n\n"
                        "If not sure, check the URL bar when logged into Insightly.",
                },
            ),
            "cls": Class::forName("InsightlyRestConnection"),
            "auto_url": True,
            "schemes": {
                "insightlyrest": True,
            },
            "base_scheme_map": {
                "https": "insightlyrest",
            },
            "required_options": "apikey",
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Insightly API key for authentication",
                    "type": "string",
                    "desc": "The Insightly API key used for HTTP Basic Auth authentication.\n\n"
                        "The API key is sent as the username with an empty password.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Insightly account\n"
                        "2. Click your profile avatar in the top-right corner\n"
                        "3. Go to **User Settings**\n"
                        "4. Find the **API** section and copy your API key",
                    "sensitive": True,
                    "preselected": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": InsightlyRestClientBase::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": InsightlyRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": InsightlyRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": InsightlyRestClientBase::DefaultPingPath,
                },
                "pod": <ConnectionOptionInfo>{
                    "display_name": "Pod/Region",
                    "short_desc": "Insightly pod/region (auto-detected if not provided)",
                    "type": "string",
                    "desc": "The Insightly pod/region that determines the API endpoint URL.\n\n"
                        "Available pods:\n"
                        "- `na1` - North America (default)\n"
                        "- `eu1` - Europe\n"
                        "- `au1` - Australia\n\n"
                        "Your pod is visible in your Insightly URL (e.g., `na1.insightly.com` "
                        "means pod `na1`). If not provided, defaults to `na1`.",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "display_name": "North America",
                            "value": "na1",
                            "desc": "North America pod (api.na1.insightly.com)",
                        },
                        <AllowedValueInfo>{
                            "display_name": "Europe",
                            "value": "eu1",
                            "desc": "Europe pod (api.eu1.insightly.com)",
                        },
                        <AllowedValueInfo>{
                            "display_name": "Australia",
                            "value": "au1",
                            "desc": "Australia pod (api.au1.insightly.com)",
                        },
                    ),
                    "preselected": True,
                },
            },
        };
    }

    #! creates the InsightlyRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and
        \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description,
            string url = InsightlyRestClientBase::DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the InsightlyRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(InsightlyRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref InsightlyRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        if (!config.url || config.url == InsightlyRestClientBase::DefaultConnectionUrl) {
            string pod = config.opts.pod ?? InsightlyRestClientBase::DefaultPod;
            config.url = InsightlyRestClientBase::getConnectionUrlForPod(pod);
        }
        return config;
    }

    #! returns \c "insightlyrest"
    string getType() {
        return "insightlyrest";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Insightly";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the InsightlyDataProvider and creates
        # the data provider object dynamically
        load_module("InsightlyDataProvider");
        return create_object("InsightlyDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            # Rebuild URL from pod option when connection is loaded
            string pod = opts.pod ?? InsightlyRestClientBase::DefaultPod;
            string expected_url = InsightlyRestClientBase::getConnectionUrlForPod(pod);
            if (url != expected_url) {
                update.url = expected_url;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref InsightlyRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter
        is ignored

        @return a @ref InsightlyRestClient object
    */
    private InsightlyRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new InsightlyRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since InsightlyRestClient 1.0
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new InsightlyRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Insightly CRM REST API using multiplexed HTTP connections
/** @see InsightlyRestClient for more information
*/
public class InsightlyRestClientIo inherits RestClientIo::RestClientIo, InsightlyRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(InsightlyRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
