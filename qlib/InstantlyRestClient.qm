# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) ConnectionProvider >= 1.4

module InstantlyRestClient {
    version = "1.0";
    desc = "User module for calling Instantly REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("instantly", InstantlyRestConnection::ConnectionScheme);
    };
}

/** @mainpage InstantlyRestClient Module

    @tableofcontents

    @section instantlyrestclientintro InstantlyRestClient Introduction

    The %InstantlyRestClient module provides an API for calling Instantly's REST API v2 services.

    To use this module, use \c "%requires InstantlyRestClient" in your code.

    All the public symbols in the module are defined in the InstantlyRestClient namespace.

    The main classes are:
    - @ref InstantlyRestClient::InstantlyRestClient "InstantlyRestClient":
      this class provides the REST client API for communication with the Instantly API;
      it handles authentication via Bearer token
    - @ref InstantlyRestClient::InstantlyRestConnection "InstantlyRestConnection":
      provides a connection object to Instantly services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires InstantlyRestClient

InstantlyRestClient instantly({"apikey": ENV.INSTANTLY_API_KEY});
hash<auto> result = instantly.get("/campaigns");
printf("Campaigns: %N\n", result.body);
    @endcode

    @section instantlyrestclientrelnotes Release Notes

    @subsection instantlyrestclientv1_0 InstantlyRestClient v1.0
    - the initial version of the %InstantlyRestClient module
*/

#! the InstantlyRestClient namespace contains all the objects in the InstantlyRestClient module
public namespace InstantlyRestClient {

#! This class provides the REST client API for communication with Instantly servers
/** Instantly uses a REST API v2 at https://api.instantly.ai/api/v2 with Bearer token authentication.

    @par Authentication:
    - Bearer token via API key in the Authorization header

    @par API Information:
    - Base URL: https://api.instantly.ai/api/v2
    - Pagination: Cursor-based using starting_after parameter

    @par Rate Limit Handling:
    This client automatically handles HTTP 429 (Too Many Requests) errors by implementing
    retry logic with exponential backoff:
    - Maximum total retry time: 75 seconds
    - Initial retry delay: 1 second
    - Backoff multiplier: 2x
    - Maximum single retry delay: 30 seconds
    - Uses Retry-After header when available
*/
public class InstantlyRestClient inherits RestClient::RestClient {
    public {
        #! Instantly API base URL
        const DefaultApiUrl = "https://api.instantly.ai/api/v2";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default Instantly ping method
        const DefaultPingMethod = "GET";

        #! Default Instantly ping path (list campaigns - lightweight endpoint)
        const DefaultPingPath = "campaigns";

        #! Default Instantly ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Maximum total retry time for 429 errors (75 seconds)
        const MaxRetryTime = 75s;

        #! Initial retry delay for exponential backoff
        const InitialRetryDelay = 1s;

        #! Maximum single retry delay
        const MaxRetryDelay = 30s;

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
InstantlyRestClient instantly({"apikey": "your-api-key"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the Instantly API key (required)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw INSTANTLY-ERROR missing required option 'apikey'
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(InstantlyRestClient::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! Makes a REST request with automatic retry on 429 (Too Many Requests) errors
    /** @param m the HTTP method to use
        @param path the URI path to use
        @param body the request body to send (if any)
        @param info an optional reference to a hash that will be used as an output variable giving the response info
        @param decode_errors if @ref True, decode error responses
        @param hdr any headers to use with the request

        @return the response from the server
    */
    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info, softbool decode_errors = True,
            *hash<auto> hdr) {
        date start_time = now_us();
        date current_delay = InitialRetryDelay;

        while (True) {
            try {
                return RestClient::doRequest(m, path, body, \info, decode_errors, hdr);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REST-RESPONSE-ERROR" || info.response_code != 429) {
                    rethrow;
                }

                date elapsed = now_us() - start_time;
                if (elapsed >= MaxRetryTime) {
                    rethrow;
                }

                # Calculate retry delay
                date retry_delay = getRetryDelay(info, current_delay);

                # Check if waiting would exceed max retry time
                if (elapsed + retry_delay > MaxRetryTime) {
                    retry_delay = MaxRetryTime - elapsed;
                    if (retry_delay <= 0s) {
                        rethrow;
                    }
                }

                sleep(retry_delay);

                # Increase delay for next retry (exponential backoff)
                current_delay = current_delay * 2;
                if (current_delay > MaxRetryDelay) {
                    current_delay = MaxRetryDelay;
                }
            }
        }
    }

    #! Returns the retry delay based on response headers or exponential backoff
    private date getRetryDelay(hash<auto> info, date default_delay) {
        if (info.headers."retry-after") {
            int secs = info.headers."retry-after".toInt();
            if (secs > 0) {
                return seconds(secs);
            }
        }

        return default_delay;
    }

    #! returns options for @ref InstantlyRestClient::InstantlyRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Set URL
        rv.url = DefaultApiUrl;

        # Validate apikey is provided
        if (!opts.apikey) {
            throw "INSTANTLY-ERROR", "missing required option 'apikey' (Instantly API key)";
        }

        # Set Bearer token authentication
        rv.headers.Authorization = "Bearer " + opts.apikey;

        # Remove custom options so RestClient doesn't try to use them
        remove rv.apikey;

        return rv;
    }
}

#! Class for Instantly REST connections; returns @ref InstantlyRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c apikey: the Instantly API key (used as Bearer token for authentication)

    @see @ref InstantlyRestClient::InstantlyRestClient::constructor() for more information on the above options
*/
public class InstantlyRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Instantly API URL
        const DefaultConnectionUrl = "instantly://api.instantly.ai/api/v2";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Instantly REST Connection",
            "short_desc": "A connection to the Instantly REST API",
            "desc": "A connection to the Instantly REST API for email outreach and sales automation.\n\n"
                "Instantly is a platform for cold email outreach that enables managing campaigns, "
                "leads, email accounts, and tracking engagement metrics.\n\n"
                "**API Version:** v2\n"
                "**Authentication:** Bearer token (API key)",
            "cls": Class::forName("InstantlyRestConnection"),
            "auto_url": True,
            "schemes": {
                "instantly": True,
            },
            "base_scheme_map": {
                "https": "instantly",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": InstantlyRestClient::DefaultData,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Instantly API key for Bearer token authentication",
                    "type": "string",
                    "desc": "The Instantly API key used for Bearer token authentication.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Instantly account at https://app.instantly.ai\n"
                        "2. Go to Settings > Integrations > API\n"
                        "3. Create a new API key with the required scopes\n\n"
                        "**Note:** API access requires a Growth plan or higher.",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": InstantlyRestClient::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": InstantlyRestClient::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": InstantlyRestClient::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your API Key",
                    "intent": "info",
                    "content": "1. Log in to Instantly at https://app.instantly.ai\n"
                        "2. Navigate to **Settings > Integrations > API**\n"
                        "3. Click **Create API Key**\n"
                        "4. Select the required scopes for your use case\n"
                        "5. Copy the generated API key\n\n"
                        "**Important:**\n"
                        "- API access requires a Growth plan or higher\n"
                        "- Store your API key securely\n"
                        "- You can create multiple keys with different scopes",
                },
            ),
        };
    }

    #! creates the InstantlyRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the InstantlyRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(InstantlyRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref InstantlyRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": DefaultConnectionUrl,
        };
    }

    #! returns \c "instantly"
    string getType() {
        return "instantly";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Instantly";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the InstantlyDataProvider and creates the data provider
        # object dynamically
        load_module("InstantlyDataProvider");
        return create_object("InstantlyDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options && url != DefaultConnectionUrl) {
            doUpdateOptions(self, {
                "url": DefaultConnectionUrl,
            });
        }
    }

    #! returns a @ref InstantlyRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref InstantlyRestClient object
    */
    private InstantlyRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new InstantlyRestClient(getConnectionOptions(), !connect);
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
