# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern

%requires Mime
%requires(reexport) RestClient
%requires(reexport) RestClientIo
%requires(reexport) QoreTokenizerUtils
%requires(reexport) OpenAiRestClient
%requires(reexport) VoyageRestClient
%requires(reexport) SGLangRestClient
%requires(reexport) BgeM3RestClient
%requires(reexport) GeminiRestClient

module QoreRagUtils {
    version = "1.0.1";
    desc = "user module providing a composable RAG abstraction layer";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreRagUtils Module

    @tableofcontents

    @section qoreragutilsintro QoreRagUtils Introduction

    The %QoreRagUtils module provides a composable abstraction layer for
    retrieval-augmented generation (RAG) pipelines.  It defines four
    abstract building blocks — embedder, vector store, reranker, chunker —
    and a @ref QoreRagUtils::RagPipeline "RagPipeline" orchestrator that
    composes them declaratively from a @ref QoreRagUtils::RagConfig "RagConfig" hash.

    Concrete backends are pluggable: callers can use a built-in
    implementation, register their own subclass, or pass a fully-constructed
    object directly into @ref RagPipeline.

    @par Design rationale

    Without this abstraction, every consumer of the underlying primitives
    (@ref QoreTokenizerUtils for ONNX embeddings/rerankers, @ref OpenAiRestClient,
    @ref VoyageRestClient, @ref SGLangRestClient, Qdrant, pgvector, etc.)
    has to write its own backend-selection ladder and orchestration logic.
    %QoreRagUtils centralises that pattern so multiple consumers — Qorus
    instances, the AI Gateway, standalone tools — converge on the same
    pluggable composition.

    @par Abstract building blocks

    - @ref QoreRagUtils::AbstractEmbedder "AbstractEmbedder" — converts text into vectors
    - @ref QoreRagUtils::AbstractVectorStore "AbstractVectorStore" — persists vectors and searches by similarity
    - @ref QoreRagUtils::AbstractReranker "AbstractReranker" — re-orders candidate documents by relevance
    - @ref QoreRagUtils::AbstractChunker "AbstractChunker" — splits documents into retrievable units

    @par Built-in concrete implementations

    - Embedders: @ref QoreRagUtils::LocalOnnxEmbedder "LocalOnnxEmbedder",
      @ref QoreRagUtils::OpenAiEmbedder "OpenAiEmbedder",
      @ref QoreRagUtils::VoyageEmbedder "VoyageEmbedder",
      @ref QoreRagUtils::GeminiEmbedder "GeminiEmbedder",
      @ref QoreRagUtils::SGLangEmbedder "SGLangEmbedder",
      @ref QoreRagUtils::BgeM3FastApiEmbedder "BgeM3FastApiEmbedder"
    - Rerankers: @ref QoreRagUtils::LocalOnnxReranker "LocalOnnxReranker",
      @ref QoreRagUtils::VoyageReranker "VoyageReranker",
      @ref QoreRagUtils::HttpGatewayReranker "HttpGatewayReranker"
    - Chunkers: @ref QoreRagUtils::StructuredChunker "StructuredChunker",
      @ref QoreRagUtils::FixedChunker "FixedChunker"
    - Embedding caches: @ref QoreRagUtils::LruEmbeddingCache "LruEmbeddingCache"
      (bounded, thread-safe LRU)
    - Vector stores are not bundled here — use the abstract interface and
      provide a concrete impl that wraps your backend (Qdrant, pgvector,
      etc.); callers typically construct stores directly with the appropriate
      external module.

    @par Example: end-to-end RAG flow

    @code{.py}
%modern
%requires QoreRagUtils
%requires QoreTokenizerUtils

# Build a pipeline from concrete components
RagPipeline pipe(
    new LocalOnnxEmbedder(<EmbedderConfig>{"model_path": "/models/bge-m3"}),
    my_vector_store_obj,
    new LocalOnnxReranker(<RerankerConfig>{"model_path": "/models/ms-marco"}),
    new StructuredChunker(<ChunkerConfig>{"target_tokens": 512}),
);

# Ingest a document
pipe.ingest("doc-1", "Long document content here...", {"source": "manual.pdf"});

# Retrieve relevant chunks for a query
list<hash<RetrievalHit>> hits = pipe.retrieve("How do I reset my password?", 5);
foreach hash<RetrievalHit> hit in (hits) {
    printf("[%.3f] %s\n", hit.score, hit.content);
}
    @endcode

    @section QoreRagUtilsRelnotes Release Notes

    @subsection QoreRagUtilsv1_0_1 QoreRagUtils v1.0.1
    - added optional @ref RagPipelineOptions hooks to
      @ref QoreRagUtils::RagPipeline "RagPipeline" so external retrievers
      can absorb the abstraction without feature regression:
      - @ref RagPipelineOptions::query_transformer "query_transformer" for
        HyDE-style query expansion
      - @ref RagPipelineOptions::embedding_cache "embedding_cache" for
        per-pipeline query-vector caching, with a bundled
        @ref QoreRagUtils::LruEmbeddingCache "LruEmbeddingCache" default
      - @ref RagPipelineOptions::pre_rerank_top_k "pre_rerank_top_k" for
        explicit over-retrieval before reranking
      - a fallback vector-store chain overload (Qdrant → pgvector, etc.)
    - documented the existing payload-filter passthrough on
      @ref QoreRagUtils::RagPipeline::retrieve() "retrieve()"
    - every new feature is strictly additive — pre-existing callers keep
      working unchanged

    @subsection QoreRagUtilsv1_0 QoreRagUtils v1.0
    - the initial version of the %QoreRagUtils module
*/

#! Public namespace for QoreRagUtils
public namespace QoreRagUtils {
#! Configuration for an embedder backend
public hashdecl EmbedderConfig {
    #! Backend identifier — implementation-specific (e.g. "local-onnx", "openai", "voyage", "gemini", "sglang")
    *string backend;
    #! Path to a local model file (used by ONNX embedder)
    *string model_path;
    #! REST URL for HTTP-based embedders
    *string url;
    #! Model name to send in API requests
    *string model;
    #! API key for HTTP-based embedders
    *string api_key;
    #! Output embedding dimension (where the backend supports it)
    *int dimension;
    #! Batch size for bulk encoding
    int batch_size = 32;
    #! Default request timeout for HTTP-based embedders (per-call \c opts override takes precedence)
    /** Forwarded to the underlying REST client at construction; ignored by
        non-HTTP backends.  Use Qore's \c timeout type literals (e.g. \c 10s,
        \c 5000ms).  See @ref AbstractEmbedder::encodeBatch() "encodeBatch()"
        for per-call override semantics.
    */
    *timeout timeout;
    #! Default connection timeout for HTTP-based embedders (per-call \c opts override takes precedence)
    /** Forwarded to the underlying REST client at construction; ignored by
        non-HTTP backends.  Note: @ref RestClientIo only applies a connection
        timeout to NEW connections, so a per-call \c connect_timeout in
        @ref AbstractEmbedder::encodeBatch() "encodeBatch()" causes the
        embedder to use a transient REST client for that call.
    */
    *timeout connect_timeout;
    #! Free-form backend-specific options
    *hash<auto> options;
}

#! Configuration for a vector-store backend
public hashdecl VectorStoreConfig {
    #! Backend identifier (e.g. "qdrant", "pgvector")
    *string backend;
    #! Collection or table name
    *string collection;
    #! Connection URL or DSN
    *string url;
    #! Free-form backend-specific options (filters, payload schema, etc.)
    *hash<auto> options;
}

#! Configuration for a reranker backend
public hashdecl RerankerConfig {
    #! Backend identifier (e.g. "local-onnx", "voyage", "http-gateway")
    *string backend;
    #! Path to a local model file (ONNX reranker)
    *string model_path;
    #! REST URL for HTTP rerankers
    *string url;
    #! Model name to send
    *string model;
    #! API key
    *string api_key;
    #! Free-form backend-specific options
    *hash<auto> options;
}

#! Configuration for a chunker backend
public hashdecl ChunkerConfig {
    #! Strategy name: "structured" (default), "semantic", "fixed"
    string strategy = "structured";
    #! Target token count per chunk
    int target_tokens = 512;
    #! Overlap tokens between consecutive chunks (for "fixed" strategy)
    int overlap_tokens = 50;
    #! Similarity threshold (used by "semantic" chunker)
    float similarity_threshold = 0.7;
    #! Free-form backend-specific options
    *hash<auto> options;
}

#! Top-level RAG pipeline configuration
public hashdecl RagConfig {
    #! Embedder configuration
    hash<EmbedderConfig> embedder;
    #! Vector store configuration
    hash<VectorStoreConfig> vector_store;
    #! Reranker configuration (optional — when omitted, retrieval returns vector-search ordering)
    *hash<RerankerConfig> reranker;
    #! Chunker configuration (used by ingest)
    hash<ChunkerConfig> chunker;
    #! Default top-K for retrieval (final returned count)
    int top_k = 10;
    #! Initial vector-search top-K before reranking (only when reranker is configured)
    int initial_retrieval_k = 50;
}

#! Optional hooks passed to @ref RagPipeline::constructor()
/** Every field is optional and strictly additive — omitting the options hash
    preserves the behavior of earlier module versions.
*/
public hashdecl RagPipelineOptions {
    #! Optional query transformer (e.g. HyDE-style hypothetical-answer generation)
    /** When set, the raw query is passed through this callable and the result
        is used for embedding.  The reranker still sees the **original** query
        so that scoring semantics stay stable.
    */
    *code<string(string)> query_transformer;

    #! Optional cache for query embeddings
    /** When set, @ref RagPipeline::retrieve() "retrieve()" consults this cache
        before calling @ref AbstractEmbedder::encode() "encode()" and populates
        it on cache misses.  Cache keys are the exact string that would
        otherwise be passed to \c encode() — the transformer output when a
        \c query_transformer is configured, otherwise the raw query.
    */
    *AbstractEmbeddingCache embedding_cache;

    #! Explicit vector-search K before reranking
    /** When set **and** a reranker is configured, overrides the pipeline's
        \c initial_retrieval_k for the vector-store call.  The reranker still
        emits \c top_k results.  Use this to implement an over-retrieval
        multiplier (e.g. 5x top_k) without changing the pipeline default.
    */
    *int pre_rerank_top_k;
}

#! A single chunk produced by a chunker
public hashdecl ChunkInfo {
    #! Sequential index of this chunk in the source document
    int index;
    #! The chunk text content
    string content;
    #! Approximate token count
    int token_count;
    #! Free-form metadata inherited from the source (page, heading, slide, etc.)
    *hash<auto> metadata;
}

#! A vector record stored in a vector store
public hashdecl VectorRecord {
    #! Unique record id
    string id;
    #! The dense vector
    list<float> vector;
    #! Free-form payload (stored alongside the vector for retrieval-time access)
    *hash<auto> payload;
}

#! A search hit returned by a vector store
public hashdecl VectorSearchResult {
    #! Record id
    string id;
    #! Similarity score (backend-defined; typically cosine in [0,1])
    float score;
    #! Stored payload
    *hash<auto> payload;
}

#! A reranker result
public hashdecl RerankResult {
    #! Original index in the input documents list
    int index;
    #! Relevance score (higher = more relevant)
    float score;
    #! The document text (echoed back for caller convenience)
    string document;
}

#! A retrieval hit returned by RagPipeline::retrieve()
public hashdecl RetrievalHit {
    #! Stored chunk id
    string id;
    #! Final relevance score (post-reranking when a reranker is configured)
    float score;
    #! Chunk content
    string content;
    #! Free-form payload (typically the chunk's metadata)
    *hash<auto> payload;
}

#! Composes an embedder, vector store, optional reranker, and chunker into an end-to-end RAG flow
/** Construct a pipeline from already-built component objects, then call
    @ref ingest() to add documents and @ref retrieve() to query.

    @par Composition

    The pipeline does not own its components — callers may share embedders
    / vector stores / rerankers across multiple pipelines or wire them
    differently for different collections.

    @par Threading

    Each component is responsible for its own thread-safety; this class
    holds only references and dispatches calls — it adds no locking.

    @par Retrieval Filters

    @ref retrieve() accepts an optional \a filter hash that is forwarded
    verbatim to every
    @ref AbstractVectorStore::search() "AbstractVectorStore::search()" call.
    The pipeline itself is backend-agnostic and does not inspect the hash —
    callers pass backend-native payload predicates (Qdrant filter clauses,
    pgvector \c WHERE fragments, etc.) that the concrete store understands.
    When a @ref fallback_stores "fallback vector store chain" is configured,
    the same filter is forwarded to every store in the chain until one
    returns results.
*/
public class RagPipeline {
    public {
        #! Fixed namespace UUID used to derive deterministic v5-style chunk IDs.
        /** Use this in combination with a caller-supplied \c doc_id +
            \c chunk_index to produce a UUID that:
            - is accepted by every vector-store backend (Qdrant requires
              UUIDs or unsigned integers; pgvector accepts any string)
            - is deterministic so that re-ingesting the same document
              overwrites rather than duplicates
            - does not leak the original identifier into wire-format
              storage keys
        */
        const ChunkIdNamespace = "qore-rag-utils-chunk-id-v1";
    }

    private {
        AbstractEmbedder embedder;
        #! Primary vector store — always equal to @ref vector_stores[0]
        AbstractVectorStore vector_store;
        #! Fallback vector store chain
        /** A list of at least one vector store.  @ref retrieve() iterates
            the chain in order and falls through to the next store on any
            exception raised by @ref AbstractVectorStore::search() "search()"
            or when a store returns an empty result.  A pipeline constructed
            with a single store has a one-element list here.
        */
        list<AbstractVectorStore> vector_stores;
        *AbstractReranker reranker;
        AbstractChunker chunker;
        int top_k = 10;
        int initial_retrieval_k = 50;

        #! Optional HyDE-style query transformer
        *code<string(string)> query_transformer;

        #! Optional cache for query embeddings
        *AbstractEmbeddingCache embedding_cache;

        #! Optional explicit over-retrieval K before reranking
        *int pre_rerank_top_k;
    }

    #! Derives a deterministic UUIDv5-style chunk id from \a doc_id and \a chunk_index
    /** Uses SHA1 over a namespace-prefixed concatenation and formats the
        first 16 bytes as an RFC 4122 UUID (version 5, variant 10xx).  Two
        calls with the same arguments always produce the same UUID.

        @param doc_id the caller-supplied document identifier
        @param chunk_index zero-based index of the chunk within the document
        @return a lowercase UUID string suitable for every AbstractVectorStore backend
    */
    static string deriveChunkId(string doc_id, int chunk_index) {
        binary sha = SHA1_bin(ChunkIdNamespace + "|" + doc_id + ":"
            + chunk_index);
        # Take the first 16 bytes and stamp version/variant bits per RFC 4122
        binary b = sha[0..15];
        # set version = 5 (byte 6: clear high 4 bits, set to 0x50)
        int b6 = (b[6] & 0x0f) | 0x50;
        # set variant = 10xx (byte 8: clear top 2 bits, set to 0x80)
        int b8 = (b[8] & 0x3f) | 0x80;
        return sprintf("%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-"
            "%02x%02x%02x%02x%02x%02x",
            b[0], b[1], b[2], b[3], b[4], b[5], b6, b[7], b8, b[9],
            b[10], b[11], b[12], b[13], b[14], b[15]);
    }

    #! Constructs a RagPipeline from concrete components
    /** @param embedder the embedder to use
        @param vector_store the vector store to use
        @param reranker optional reranker; when omitted, retrieve() returns vector-search ordering
        @param chunker the chunker to use for ingest()
        @param top_k default top-K for retrieve() — final returned count
        @param initial_retrieval_k initial vector-search top-K before reranking
            (only relevant when a reranker is configured); typically 5x top_k
        @param opts optional hash of additional hooks — see
            @ref RagPipelineOptions for the full list.  Every field is optional
            and strictly additive; omit \a opts to preserve the v1.0 behavior.
    */
    constructor(AbstractEmbedder embedder, AbstractVectorStore vector_store,
            *AbstractReranker reranker, AbstractChunker chunker,
            int top_k = 10, int initial_retrieval_k = 50,
            *hash<RagPipelineOptions> opts) {
        initPipeline(embedder, (vector_store,), reranker, chunker, top_k,
            initial_retrieval_k, opts);
    }

    #! Constructs a RagPipeline with a fallback vector-store chain
    /** @param embedder the embedder to use
        @param vector_stores an ordered list of vector stores — e.g.
            \c "Qdrant → pgvector"; @ref retrieve() iterates the chain in
            order and falls through to the next store on any exception from
            @ref AbstractVectorStore::search() "search()" or when a store
            returns an empty result
        @param reranker optional reranker
        @param chunker the chunker to use for ingest()
        @param top_k default top-K for retrieve()
        @param initial_retrieval_k initial vector-search top-K before reranking
        @param opts optional hash of additional hooks — see @ref RagPipelineOptions

        @throw RAG-PIPELINE-ERROR if \a vector_stores is empty

        @par Example: Qdrant → pgvector fallback chain
        @code{.py}
RagPipeline pipe(
    embedder,
    (qdrant_store, pgvector_store),
    reranker,
    chunker,
);
        @endcode
    */
    constructor(AbstractEmbedder embedder,
            list<AbstractVectorStore> vector_stores,
            *AbstractReranker reranker, AbstractChunker chunker,
            int top_k = 10, int initial_retrieval_k = 50,
            *hash<RagPipelineOptions> opts) {
        if (!vector_stores) {
            throw "RAG-PIPELINE-ERROR",
                "vector_stores list must contain at least one vector store";
        }
        initPipeline(embedder, vector_stores, reranker, chunker, top_k,
            initial_retrieval_k, opts);
    }

    private initPipeline(AbstractEmbedder embedder,
            list<AbstractVectorStore> vector_stores,
            *AbstractReranker reranker, AbstractChunker chunker,
            int top_k, int initial_retrieval_k,
            *hash<RagPipelineOptions> opts) {
        self.embedder = embedder;
        self.vector_stores = vector_stores;
        self.vector_store = vector_stores[0];
        self.reranker = reranker;
        self.chunker = chunker;
        self.top_k = top_k;
        self.initial_retrieval_k = initial_retrieval_k;
        self.query_transformer = opts.query_transformer;
        self.embedding_cache = opts.embedding_cache;
        self.pre_rerank_top_k = opts.pre_rerank_top_k;
    }

    #! Ingests a document — chunks, embeds, and stores it
    /** @param doc_id stable identifier for the source document
        @param content the document text
        @param metadata optional metadata to attach to every chunk

        @return list of chunk ids that were stored
    */
    list<string> ingest(string doc_id, string content, *hash<auto> metadata) {
        list<hash<ChunkInfo>> chunks = chunker.chunk(content, metadata);
        if (!chunks) {
            return ();
        }
        list<string> texts = map $1.content, chunks;
        list<list<float>> vectors = embedder.encodeBatch(texts);
        list<hash<VectorRecord>> records = ();
        list<string> ids = ();
        for (int i = 0; i < chunks.size(); ++i) {
            # deterministic UUIDv5-style id derived from doc_id + index;
            # accepted by every AbstractVectorStore backend (Qdrant
            # requires UUIDs/uints; pgvector accepts any string).  The
            # original doc_id / chunk_index stay in the payload for
            # retrieval-time access.
            string id = deriveChunkId(doc_id, chunks[i].index);
            push ids, id;
            hash<auto> payload = {
                "doc_id": doc_id,
                "chunk_index": chunks[i].index,
                "content": chunks[i].content,
                "token_count": chunks[i].token_count,
            };
            if (chunks[i].metadata) {
                payload += chunks[i].metadata;
            }
            push records, <VectorRecord>{
                "id": id,
                "vector": vectors[i],
                "payload": payload,
            };
        }
        vector_store.upsert(records);
        return ids;
    }

    #! Retrieves the top-K most relevant chunks for a query
    /** @param query the user's query text — passed verbatim to the reranker
            (when configured) and, when no query_transformer is set, also
            passed to the embedder
        @param k optional override for the final top-K; defaults to the constructor's \c top_k
        @param filter optional vector-store filter; forwarded verbatim to
            every @ref AbstractVectorStore::search() "search()" call in the
            fallback chain — see @ref RagPipeline's "Retrieval Filters"
            section for semantics

        @return list of @ref RetrievalHit hashes, ordered by descending relevance

        @par Hook order
        1. The raw query is optionally transformed via
           @ref RagPipelineOptions::query_transformer "query_transformer"
           (HyDE-style query expansion).
        2. The embedding for the transformed (or raw) query is fetched from
           the @ref RagPipelineOptions::embedding_cache "embedding_cache"
           when set; on miss, @ref AbstractEmbedder::encode() "encode()" is
           called and the result is cached.
        3. Vector search is dispatched to the first store in the fallback
           chain.  On a search exception or an empty result, the next store
           in the chain is tried.  \a filter is forwarded to each store.
        4. When a reranker is configured, the vector-search K is
           @ref RagPipelineOptions::pre_rerank_top_k "pre_rerank_top_k"
           (when set) or \c initial_retrieval_k (the default); the reranker
           is always fed the **original** \a query, not the transformer
           output, to keep score semantics stable.
    */
    list<hash<RetrievalHit>> retrieve(string query, *int k, *hash<auto> filter) {
        int final_k = k ?? top_k;
        int search_k;
        if (exists reranker) {
            search_k = pre_rerank_top_k ?? initial_retrieval_k;
        } else {
            search_k = final_k;
        }

        # Step 1: optional HyDE-style query transformation — the reranker
        # still sees the *original* query for stable scoring
        string embed_query = query_transformer ? query_transformer(query) : query;

        # Step 2: embedding cache lookup + encode-on-miss
        list<float> query_vec;
        if (embedding_cache) {
            *list<float> cached = embedding_cache.get(embed_query);
            if (exists cached) {
                query_vec = cached;
            } else {
                query_vec = embedder.encode(embed_query);
                embedding_cache.put(embed_query, query_vec);
            }
        } else {
            query_vec = embedder.encode(embed_query);
        }

        # Step 3: fallback vector-store chain
        list<hash<VectorSearchResult>> hits = searchWithFallback(query_vec,
            search_k, filter);

        if (!exists reranker || hits.size() <= 1) {
            list<hash<RetrievalHit>> rv = ();
            int upper = hits.size() < final_k ? hits.size() : final_k;
            for (int i = 0; i < upper; ++i) {
                push rv, <RetrievalHit>{
                    "id": hits[i].id,
                    "score": hits[i].score,
                    "content": hits[i].payload.content,
                    "payload": hits[i].payload,
                };
            }
            return rv;
        }

        # Step 4: rerank phase — uses the original query
        list<string> docs = map $1.payload.content, hits;
        list<hash<RerankResult>> reranked = reranker.rerank(query, docs, final_k);
        list<hash<RetrievalHit>> rv = ();
        foreach hash<RerankResult> r in (reranked) {
            hash<VectorSearchResult> vh = hits[r.index];
            push rv, <RetrievalHit>{
                "id": vh.id,
                "score": r.score,
                "content": vh.payload.content,
                "payload": vh.payload,
            };
        }
        return rv;
    }

    #! Walks the configured fallback vector-store chain
    /** Tries each store in order; on a search exception or an empty result,
        advances to the next store.  Returns the first non-empty result, or
        an empty list if every store is exhausted.  The last exception is
        rethrown only if every store raised one (i.e. no store returned a
        clean empty result and at least one error occurred) — this lets
        callers distinguish "no matches" from "all backends down".

        @param query_vector the pre-computed query embedding
        @param k how many results the store should return
        @param filter optional backend-specific filter, forwarded verbatim

        @return hits from the first store that succeeded with a non-empty
            result, or () if every store returned empty cleanly
    */
    private list<hash<VectorSearchResult>> searchWithFallback(
            list<float> query_vector, int k, *hash<auto> filter) {
        *hash<ExceptionInfo> last_err;
        foreach AbstractVectorStore store in (vector_stores) {
            try {
                list<hash<VectorSearchResult>> hits = store.search(query_vector,
                    k, filter);
                if (hits) {
                    return hits;
                }
            } catch (hash<ExceptionInfo> ex) {
                last_err = ex;
            }
        }
        if (last_err) {
            # every store we tried raised; rethrow the last one so callers
            # see a real error rather than silently empty results
            throw last_err.err, last_err.desc, last_err.arg;
        }
        return ();
    }

    #! Re-rank an arbitrary list of documents using the configured reranker
    /** @param query the query text
        @param documents the candidate documents to score
        @param k optional top-K (defaults to the configured \c top_k)

        @return reranked results in descending score order

        @throw RAG-PIPELINE-ERROR if no reranker is configured
    */
    list<hash<RerankResult>> rerank(string query, list<string> documents, *int k) {
        if (!exists reranker) {
            throw "RAG-PIPELINE-ERROR", "no reranker is configured on this pipeline";
        }
        return reranker.rerank(query, documents, k ?? top_k);
    }

    #! Returns the embedder
    AbstractEmbedder getEmbedder() { return embedder; }

    #! Returns the primary vector store (the first element of the fallback chain)
    AbstractVectorStore getVectorStore() { return vector_store; }

    #! Returns the full vector-store fallback chain in search order
    /** A pipeline constructed with a single store returns a one-element list.
    */
    list<AbstractVectorStore> getVectorStores() { return vector_stores; }

    #! Returns the configured embedding cache, if any
    *AbstractEmbeddingCache getEmbeddingCache() { return embedding_cache; }

    #! Returns the reranker, if configured
    *AbstractReranker getReranker() { return reranker; }

    #! Returns the chunker
    AbstractChunker getChunker() { return chunker; }
}
}
