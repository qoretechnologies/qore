# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) CdsRestClient

module CdsRestDataProvider {
    version = "2.1.0";
    desc = "user module providing a data provider API for Microsoft Common Data Service instances through a REST API";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factories
        DataProvider::registerFactory(new CdsRestDataProviderFactory());
        DataProvider::registerFactory(new BcRestDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": CdsRestDataProvider::DynamicsAppName,
            "display_name": "Microsoft Dynamics 365",
            "short_desc": "Microsoft Dynamics 365® enterprise application",
            "desc": "Microsoft Dynamics 365 access enables Qorus to easily access and manipulate data in Microsoft "
                "Dynamics 365 application instances. Microsoft, Microsoft 365, and Microsoft Dynamics 365 are "
                "trademarks of the Microsoft group of companies",
            "scheme": "dynamics",
            "logo": DynamicsLogo,
            "logo_file_name": "dynamics-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::CrmSales,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::DynamicsAppName,
            "path": "/tables/{table}",
            "action": "create-record",
            "display_name": "Create Record",
            "short_desc": "Create a record in a Dynamics table",
            "desc": "Create a record in a Dynamics table using the Dynamics REST API",
            "action_code": DPAT_CREATE,
            "data_dependent_options": True,
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Dynamics table",
                    "desc": "The name of the Dynamics table, ex: `account`",
                    "example_value": "account",
                },
            },
            "data_provider_info": ODataEntityDataProvider::CdsProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::DynamicsAppName,
            "path": "/tables/{table}",
            "action": "find-single-record",
            "display_name": "Find Single Record",
            "short_desc": "Find a specific record in Dynamics",
            "desc": "Find a specific record in a Dynamics table using the Dynamics REST API",
            "action_code": DPAT_FIND_SINGLE,
            "data_dependent_options": True,
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Dynamics table",
                    "desc": "The name of the Dynamics table, ex: `account`",
                    "example_value": "account",
                },
            },
            "data_provider_info": ODataEntityDataProvider::CdsProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::DynamicsAppName,
            "path": "/tables/{table}",
            "action": "find-records",
            "display_name": "Find Records",
            "short_desc": "Find records in Dynamics",
            "desc": "Find records in a Dynamics table using the Dynamics REST API",
            "action_code": DPAT_FIND,
            "data_dependent_options": True,
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Dynamics table",
                    "desc": "The name of the Dynamics table, ex: `account`",
                    "example_value": "account",
                },
            },
            "data_provider_info": ODataEntityDataProvider::CdsProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::DynamicsAppName,
            "path": "/tables/{table}",
            "action": "update-records",
            "display_name": "Update Records",
            "short_desc": "Update records in Dynamics",
            "desc": "Update records in a Dynamics table using the Dynamics REST API",
            "action_code": DPAT_UPDATE,
            "data_dependent_options": True,
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Dynamics table",
                    "desc": "The name of the Dynamics table, ex: `account`",
                    "example_value": "account",
                },
            },
            "data_provider_info": ODataEntityDataProvider::CdsProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::DynamicsAppName,
            "path": "/tables/{table}",
            "action": "delete-records",
            "display_name": "Delete Records",
            "short_desc": "Delete records in Dynamics",
            "desc": "Delete records in a Dynamics table using the Dynamics REST API",
            "action_code": DPAT_DELETE,
            "data_dependent_options": True,
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Dynamics table",
                    "desc": "The name of the Dynamics table, ex: `account`",
                    "example_value": "account",
                },
            },
            "data_provider_info": ODataEntityDataProvider::CdsProviderInfo,
        });

        # Register Business Central app and actions
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": CdsRestDataProvider::BusinessCentralAppName,
            "display_name": "Microsoft Dynamics 365 Business Central",
            "short_desc": "Microsoft Dynamics 365 Business Central ERP",
            "desc": "Microsoft Dynamics 365 Business Central is a cloud-based business management solution for small "
                "and medium-sized organizations. Microsoft, Microsoft 365, and Microsoft Dynamics 365 are "
                "trademarks of the Microsoft group of companies",
            "scheme": "bcrests",
            "logo": BusinessCentralLogo,
            "logo_file_name": "business-central-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AccountingErp,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::BusinessCentralAppName,
            "path": "/companies/{company}/tables/{table}",
            "action": "create-record",
            "display_name": "Create Record",
            "short_desc": "Create a record in a Business Central table",
            "desc": "Create a record in a Business Central table using the Business Central REST API",
            "action_code": DPAT_CREATE,
            "data_dependent_options": True,
            "path_vars": {
                "company": <DataProviderPathVarInfo>{
                    "display_name": "Company",
                    "short_desc": "The Business Central company ID or name",
                    "desc": "The Business Central company ID or name",
                    "example_value": "CRONUS USA, Inc.",
                },
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Business Central table",
                    "desc": "The name of the Business Central table, ex: `customers`",
                    "example_value": "customers",
                },
            },
            "data_provider_info": ODataEntityDataProvider::BcProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::BusinessCentralAppName,
            "path": "/companies/{company}/tables/{table}",
            "action": "find-single-record",
            "display_name": "Find Single Record",
            "short_desc": "Find a specific record in Business Central",
            "desc": "Find a specific record in a Business Central table using the Business Central REST API",
            "action_code": DPAT_FIND_SINGLE,
            "data_dependent_options": True,
            "path_vars": {
                "company": <DataProviderPathVarInfo>{
                    "display_name": "Company",
                    "short_desc": "The Business Central company ID or name",
                    "desc": "The Business Central company ID or name",
                    "example_value": "CRONUS USA, Inc.",
                },
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Business Central table",
                    "desc": "The name of the Business Central table, ex: `customers`",
                    "example_value": "customers",
                },
            },
            "data_provider_info": ODataEntityDataProvider::BcProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::BusinessCentralAppName,
            "path": "/companies/{company}/tables/{table}",
            "action": "find-records",
            "display_name": "Find Records",
            "short_desc": "Find records in Business Central",
            "desc": "Find records in a Business Central table using the Business Central REST API",
            "action_code": DPAT_FIND,
            "data_dependent_options": True,
            "path_vars": {
                "company": <DataProviderPathVarInfo>{
                    "display_name": "Company",
                    "short_desc": "The Business Central company ID or name",
                    "desc": "The Business Central company ID or name",
                    "example_value": "CRONUS USA, Inc.",
                },
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Business Central table",
                    "desc": "The name of the Business Central table, ex: `customers`",
                    "example_value": "customers",
                },
            },
            "data_provider_info": ODataEntityDataProvider::BcProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::BusinessCentralAppName,
            "path": "/companies/{company}/tables/{table}",
            "action": "update-records",
            "display_name": "Update Records",
            "short_desc": "Update records in Business Central",
            "desc": "Update records in a Business Central table using the Business Central REST API",
            "action_code": DPAT_UPDATE,
            "data_dependent_options": True,
            "path_vars": {
                "company": <DataProviderPathVarInfo>{
                    "display_name": "Company",
                    "short_desc": "The Business Central company ID or name",
                    "desc": "The Business Central company ID or name",
                    "example_value": "CRONUS USA, Inc.",
                },
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Business Central table",
                    "desc": "The name of the Business Central table, ex: `customers`",
                    "example_value": "customers",
                },
            },
            "data_provider_info": ODataEntityDataProvider::BcProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdsRestDataProvider::BusinessCentralAppName,
            "path": "/companies/{company}/tables/{table}",
            "action": "delete-records",
            "display_name": "Delete Records",
            "short_desc": "Delete records in Business Central",
            "desc": "Delete records in a Business Central table using the Business Central REST API",
            "action_code": DPAT_DELETE,
            "data_dependent_options": True,
            "path_vars": {
                "company": <DataProviderPathVarInfo>{
                    "display_name": "Company",
                    "short_desc": "The Business Central company ID or name",
                    "desc": "The Business Central company ID or name",
                    "example_value": "CRONUS USA, Inc.",
                },
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the Business Central table",
                    "desc": "The name of the Business Central table, ex: `customers`",
                    "example_value": "customers",
                },
            },
            "data_provider_info": ODataEntityDataProvider::BcProviderInfo,
        });
    };
}

/** @mainpage CdsRestDataProvider Module

    @tableofcontents

    @section cdsrestdataproviderintro Introduction to the CdsRestDataProvider Module

    The %CdsRestDataProvider module provides a \c dataproviderintro "data provider" API for Microsoft Dynamics 365
    Common Data Service REST services.  The
    @ref CdsRestDataProvider::CdsRestDataProvider "CdsRestDataProvider" class allows for
    introspecting a Microsoft Common Data Service application instance (such as Dynamics 365, for example), while the
    @ref CdsRestDataProvider::ODataEntityDataProvider "ODataEntityDataProvider" class
    supports the \c dataproviderintro "data provider" record-based API for querying and manipulating entity data in
    the application.

    CDS instances can be introspected with the following format:
    - REST operation path: <tt><i>uri_path</i></tt>
      - ex: <tt><b>account</b></tt>
      - results in a
        @ref CdsRestDataProvider::ODataEntityDataProvider "ODataEntityDataProvider" object
        where record operations supported on the object can be executed

    The following classes are provided by this module for Dynamics 365:
    - @ref CdsRestDataProvider::CdsRestDataProvider "CdsRestDataProvider"
    - @ref CdsRestDataProvider::CdsRestDataProviderFactory "CdsRestDataProviderFactory"
    - \c CdsRestDataProvider::CdsEntityDataProvider "CdsEntityDataProvider"
    - \c CdsRestDataProvider::CdsRestRecordIterator "CdsRestRecordIterator"

    The following classes are provided for Business Central:
    - @ref CdsRestDataProvider::BcRestDataProvider "BcRestDataProvider"
    - @ref CdsRestDataProvider::BcRestDataProviderFactory "BcRestDataProviderFactory"
    - @ref CdsRestDataProvider::BcCompaniesDataProvider "BcCompaniesDataProvider"
    - @ref CdsRestDataProvider::BcCompanyDataProvider "BcCompanyDataProvider"
    - @ref CdsRestDataProvider::BcTablesDataProvider "BcTablesDataProvider"
    - \c CdsRestDataProvider::BcEntityDataProvider "BcEntityDataProvider"
    - \c CdsRestDataProvider::BcRecordIterator "BcRecordIterator"

    @subsection cdsrestdataprovider_v2_1 CdsRestDataProvider v2.1
    - added support for Microsoft Dynamics 365 Business Central
      - new data provider classes for Business Central CRUD operations
      - company-scoped entity access
      - full CRUD support (create, read, update, upsert, delete)
    - added support for the DataProvider expression framework for OData queries
      - supports logical operators: AND, OR, NOT
      - supports comparison operators: eq, ne, lt, le, gt, ge, between, in
      - added OData-specific string operators: contains, startsWith, endsWith
      - added null/notNull comparison operators

    @subsection cdsrestdataprovider_v2_0 CdsRestDataProvider v2.0
    - added support for the data provider action catalog API
      (<a href="https://github.com/qoretechnologies/qore/issues/4808">issue 4808</a>)

    @subsection cdsrestdataprovider_v1_0 CdsRestDataProvider v1.0
    - initial release of the module
*/

#! contains all public definitions in the CdsRestDataProvider module
public namespace CdsRestDataProvider {
#! Application name for Dynamics
public const DynamicsAppName = "Dynamics";

#! Application name for Business Central
public const BusinessCentralAppName = "BusinessCentral";

# used in accordance with: https://learn.microsoft.com/en-us/dynamics365/get-started/icons#icon-updates
public const DynamicsLogo = File::readTextFile(get_script_dir() + "/dynamics-logo.svg");

# Business Central logo - simplified building/chart icon based on Microsoft BC branding
public const BusinessCentralLogo = File::readTextFile(get_script_dir() + "/business-central-logo.svg");
}
