# minimum qore version
%requires qore >= 2.0

# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module BitlyRestClient {
    version = "1.0";
    desc = "User module for calling Bitly REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("bitlyrest", BitlyRestConnection::ConnectionScheme);
    };
}

/** @mainpage BitlyRestClient Module

    @tableofcontents

    @section bitlyrestclientintro BitlyRestClient Introduction

    The %BitlyRestClient module provides an API for calling Bitly REST API services.

    To use this module, use \c "%requires BitlyRestClient" in your code.

    All the public symbols in the module are defined in the BitlyRestClient namespace.

    The main classes are:
    - @ref BitlyRestClient::BitlyRestClient "BitlyRestClient":
      this class provides the REST client API for communication with the Bitly API;
      it handles OAuth2 and API key authentication
    - @ref BitlyRestClient::BitlyRestConnection "BitlyRestConnection":
      provides a connection object to Bitly services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @section bitlyrestclientrelnotes Release Notes

    @subsection bitlyrestclientv1_0 BitlyRestClient v1.0
    - the initial version of the %BitlyRestClient module
*/

#! the BitlyRestClient namespace contains all the objects in the BitlyRestClient module
public namespace BitlyRestClient {

#! Common base class for BitlyRestClient functionality
public class BitlyRestClientBase {
    public {
        #! Default Bitly API URL
        const DefaultUrl = "https://api-ssl.bitly.com";

        #! Default API version
        const DefaultApiVersion = "v4";

        #! Default authorization request URL
        const DefaultAuthUrl = "https://bitly.com/oauth/authorize";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default token request URL
        const DefaultTokenUrl = "https://api-ssl.bitly.com/oauth/access_token";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since default_path provides /v4)
        const DefaultPingPath = "user";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OAuth2 auth args to request offline access (refresh tokens)
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "default_path": "/" + DefaultApiVersion,
            "headers": DefaultHeaders,
            "oauth2_auth_args": DefaultAuthArgs,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "url": DefaultUrl,
        };

        #! OAuth2 options (added when OAuth2 credentials are provided)
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
        };

        #! Default connection URL
        const DefaultConnectionUrl = "bitlyrest://api-ssl.bitly.com";
    }

    #! returns options for the BitlyRestClient constructor
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Ensure URL is always set (auto_url connections may pass NOTHING)
        if (!rv.url) {
            rv.url = DefaultUrl;
        }

        if (opts.oauth2_client_id) {
            rv += OAuth2Options;
        } else if (opts.apikey) {
            # API key / Bearer token mode
            rv.headers.Authorization = "Bearer " + opts.apikey;
        }

        # Always remove apikey from options to prevent RestClient misinterpretation
        remove rv.apikey;

        return rv;
    }
}

#! This class provides the REST client API for communication with Bitly servers
/** Bitly uses a REST API at https://api-ssl.bitly.com/v4 with OAuth2 or Bearer token
    authentication.

    @par Authentication:
    - OAuth2 with Bearer tokens (authorization code grant)
    - API key / Bearer token via Authorization header
    - Scope: N/A (Bitly does not use granular scopes)

    @par API Structure:
    All endpoints are under /v4 (set via default_path)
*/
public class BitlyRestClient inherits RestClient::RestClient, BitlyRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
BitlyRestClient bitly({
    "apikey": ENV.BITLY_ACCESS_TOKEN,
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the Bitly API access token (alternative to OAuth2)

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(BitlyRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Bitly REST connections; returns @ref BitlyRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref BitlyRestClient::BitlyRestClient::constructor() for more information on the above
    options
*/
public class BitlyRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Bitly REST Connection",
            "short_desc": "A connection to the Bitly REST API",
            "desc": "A connection to the Bitly REST API for URL shortening, branded links, "
                "QR codes, campaigns, and click analytics",
            "cls": Class::forName("BitlyRestConnection"),
            "auto_url": True,
            "schemes": {
                "bitlyrest": True,
            },
            "base_scheme_map": {
                "https": "bitlyrest",
            },
            "required_options": "oauth2_client_id,oauth2_client_secret",
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Access Token",
                    "short_desc": "Bitly API access token for authentication",
                    "type": "string",
                    "desc": "The Bitly API access token used for Bearer token authentication.\n\n"
                        "**To obtain your access token:**\n"
                        "1. Log in to your Bitly account\n"
                        "2. Go to **Settings** > **Developer settings** > **API**\n"
                        "3. Generate a new access token\n\n"
                        "Rate limit: 5 concurrent connections, hourly and monthly limits "
                        "based on plan",
                    "sensitive": True,
                    "preselected": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": BitlyRestClientBase::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": BitlyRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": BitlyRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": BitlyRestClientBase::DefaultPingPath,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": BitlyRestClientBase::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": BitlyRestClientBase::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": BitlyRestClientBase::DefaultGrantType,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": BitlyRestClientBase::DefaultTokenUrl,
                },
            },
        };
    }

    #! creates the BitlyRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and
        \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = BitlyRestClientBase::DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the BitlyRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(BitlyRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref BitlyRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        if (!config.url) {
            config.url = BitlyRestClientBase::DefaultConnectionUrl;
        }
        return config;
    }

    #! returns \c "bitlyrest"
    string getType() {
        return "bitlyrest";
    }

    #! Returns connection options
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        # Always set OAuth2 URLs
        rv.oauth2_auth_url = BitlyRestClientBase::DefaultAuthUrl;
        rv.oauth2_token_url = BitlyRestClientBase::DefaultTokenUrl;
        if (!rv.oauth2_grant_type) {
            rv.oauth2_grant_type = BitlyRestClientBase::DefaultGrantType;
        }
        if (!rv.oauth2_auth_args) {
            rv.oauth2_auth_args = BitlyRestClientBase::DefaultAuthArgs;
        }
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Bitly";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the BitlyDataProvider and creates
        # the data provider object dynamically
        load_module("BitlyDataProvider");
        return create_object("BitlyDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != BitlyRestClientBase::DefaultConnectionUrl) {
                update.url = BitlyRestClientBase::DefaultConnectionUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref BitlyRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter
        is ignored

        @return a @ref BitlyRestClient object
    */
    private BitlyRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new BitlyRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since BitlyRestClient 1.0
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new BitlyRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Bitly REST API using multiplexed HTTP connections
/** @see BitlyRestClient for more information
*/
public class BitlyRestClientIo inherits RestClientIo::RestClientIo, BitlyRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(BitlyRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
