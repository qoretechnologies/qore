# minimum Qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings
%modern

%requires Util >= 1.0
%requires(reexport) ConnectionProvider >= 1.4
%requires(reexport) DataProvider
%requires(reexport) Logger
%requires Mime

%try-module json >= 1.5
%define NoJson
%endtry

module ServerSentEventClient {
    version = "1.1";
    desc = "User module for handling SSE events on the client side";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register connections
        ConnectionSchemeCache::registerScheme("sse", ServerSentEventConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("sses", ServerSentEventConnection::ConnectionScheme);

        # register the data provider factory
        DataProvider::registerFactory(new ServerSentEventClientDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ServerSentEventClient::AppName,
            "display_name": "Server Sent Events (SSE)",
            "short_desc": "Receive Server Sent Events",
            "desc": "Receive Server Sent Events",
            "scheme": "sse",
            "logo": ServerSentEventsLogo,
            "logo_file_name": "sse-generic-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Messaging,),
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ServerSentEventClient::AppName,
            "path": "/",
            "action": "msg-received",
            "display_name": "Server Sent Event (SSE) Message",
            "short_desc": "A Server Sent Event (SSE) is received",
            "desc": "Receive a Server Sent Event (SSE) message",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SSE_DATA,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ServerSentEventClientDataProviderBase::ConstructorOptions
            ),
            "output_type": ServerSentEventClientEventDataType,
        });
    };
}

/** @mainpage ServerSentEventClient Module

    @tableofcontents

    @section serversenteventclientintro Introduction to the ServerSentEventClient Module

    The %ServerSentEventClient module provides a client to be used with the
    <a href="../../HttpServer/html/index.html">HttpServer module</a> to provide
    <a href="ç">Server-Sent Event</a> connections.

    To use this module, use \c "%requires ServerSentEventClient" in your code.

    All the public symbols in the module are defined in the ServerSentEventClient namespace.

    @section serversenteventclient_relnotes ServerSentEventClient Release History

    @subsection serversenteventclient_v1_1 Version 1.1
    - added \c SseConnectPollOperation for async connect
      support
    - added \c ServerSentEventConnection::supportsPollingApi()
      and
      \c ServerSentEventConnection::startPollConnect()
      for connection monitoring

    @subsection serversenteventclient_v1_0 Version 1.0
    - the initial version of the ServerSentEventClient module
*/

#! the ServerSentEventClient namespace contains all the objects in the ServerSentEventClient module
public namespace ServerSentEventClient {
#! SSE connection schemes
public const SseSchemes = {
    "sse": {
        "ssl": False,
    },
    "sses": {
        "ssl": True,
    },
};

/** @defgroup WSClientRawCallbackReturnCodes ServerSentEventClient Raw Callback Return Codes
*/
#! Application name
public const AppName = "ServerSentEvents";

#! Logo for the ServerSentEvents app
public const ServerSentEventsLogo = File::readTextFile(get_script_dir() + "/sse-generic-logo.svg");
}
