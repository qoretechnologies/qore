# minimum required Qore version
%requires qore >= 2.1
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

# supports using the DataProvider module
%requires(reexport) DataProvider

# supports using the SqlUtil module
%requires(reexport) SqlUtil

# supports using the BulkSqlUtil module
%requires(reexport) BulkSqlUtil

# supports using the ConnectionProvider module
%requires(reexport) ConnectionProvider

module DbDataProvider {
    version = "2.4";
    desc = "User module providing a data provider API for databases";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the connection scheme
        ConnectionSchemeCache::registerScheme("db", DatasourceConnection::ConnectionScheme);

        # register the data provider factory
        DataProvider::registerFactory(new DbDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": DbDataProvider::AppName,
            "display_name": "DB",
            "short_desc": "DB operations on connected datasources",
            "desc": "DB operations on connected datasources.",
            "scheme": "db",
            "logo": DbLogo,
            "logo_file_name": "db-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Databases,),
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DbDataProvider::AppName,
            "path": "/",
            "action": "select-sql",
            "display_name": "Execute an SQL Select Statement",
            "short_desc": "Execute an SQL select statement",
            "desc": "Execute an SQL select statement",
            "action_code": DPAT_FIND,
            "data_dependent_options": True,
            "data_provider_info": DbDataProvider::ProviderInfo,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DbDataProvider::AppName,
            "path": "/exec-sql",
            "action": "exec-sql",
            "display_name": "Execute an SQL Statement",
            "short_desc": "Execute an SQL statement",
            "desc": "Execute an SQL statement",
            "action_code": DPAT_API,
            "data_dependent_options": True,
            "data_provider_info": DbDataProvider::ProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DbDataProvider::AppName,
            "path": "/tables/{table}",
            "action": "create",
            "display_name": "Create Record",
            "short_desc": "Create a record in the table",
            "desc": "Create a record in the table",
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the table",
                    "desc": "The name of the table",
                },
            },
            "action_code": DPAT_CREATE,
            "data_dependent_options": True,
            "data_provider_info": DbTableDataProvider::ProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DbDataProvider::AppName,
            "path": "/tables/{table}",
            "action": "find_single",
            "display_name": "Find Single Record",
            "short_desc": "Find a single record in the table",
            "desc": "Find a single record in the table",
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the table",
                    "desc": "The name of the table",
                },
            },
            "action_code": DPAT_FIND_SINGLE,
            "data_dependent_options": True,
            "data_provider_info": DbTableDataProvider::ProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DbDataProvider::AppName,
            "path": "/tables/{table}",
            "action": "find",
            "display_name": "Find Matching Records",
            "short_desc": "Find records in the table",
            "desc": "Find records in the table",
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the table",
                    "desc": "The name of the table",
                },
            },
            "action_code": DPAT_FIND,
            "data_dependent_options": True,
            "data_provider_info": DbTableDataProvider::ProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DbDataProvider::AppName,
            "path": "/tables/{table}",
            "action": "update",
            "display_name": "Update Records",
            "short_desc": "Update records in the table",
            "desc": "Update records in the table",
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the table",
                    "desc": "The name of the table",
                },
            },
            "action_code": DPAT_UPDATE,
            "data_dependent_options": True,
            "data_provider_info": DbTableDataProvider::ProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DbDataProvider::AppName,
            "path": "/tables/{table}",
            "action": "upsert",
            "display_name": "Upsert Records",
            "short_desc": "Upsert records in the table",
            "desc": "Upsert records in the table",
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the table",
                    "desc": "The name of the table",
                },
            },
            "action_code": DPAT_UPSERT,
            "data_dependent_options": True,
            "data_provider_info": DbTableDataProvider::ProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": DbDataProvider::AppName,
            "path": "/tables/{table}",
            "action": "delete",
            "display_name": "Delete Records",
            "short_desc": "Delete records in the table",
            "desc": "Delete records in the table",
            "path_vars": {
                "table": <DataProviderPathVarInfo>{
                    "display_name": "Table",
                    "short_desc": "The name of the table",
                    "desc": "The name of the table",
                },
            },
            "action_code": DPAT_DELETE,
            "data_dependent_options": True,
            "data_provider_info": DbTableDataProvider::ProviderInfo,
        });

        # register per-vendor database applications
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "PostgreSQL",
            "short_desc": "PostgreSQL database server",
            "logo": DbDriverLogos.pgsql.logo,
            "logo_file_name": "pgsql-logo.svg",
            "native_driver": "pgsql",
            "default_port": 5432,
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "MySQL",
            "short_desc": "MySQL database server",
            "logo": DbDriverLogos.mysql.logo,
            "logo_file_name": "mysql-logo.svg",
            "native_driver": "mysql",
            "default_port": 3306,
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "Oracle",
            "short_desc": "Oracle database server",
            "logo": DbDriverLogos.oracle.logo,
            "logo_file_name": "oracle-logo.svg",
            "native_driver": "oracle",
            "default_port": 1521,
            "jdbc_jar": "ojdbc11.jar",
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "SQL-Server",
            "short_desc": "Microsoft SQL Server database",
            "logo": DbDriverLogos.freetds.logo,
            "logo_file_name": "freetds-logo.svg",
            "native_driver": "freetds",
            "default_port": 1433,
            "jdbc_jar": "mssql-jdbc.jar",
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "SQLite",
            "short_desc": "SQLite embedded database",
            "logo": DbDriverLogos.sqlite3.logo,
            "logo_file_name": "sqlite3-logo.svg",
            "native_driver": "sqlite3",
            "supports_jdbc": False,
            "supports_odbc": False,
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "CockroachDB",
            "short_desc": "CockroachDB distributed SQL database",
            "logo": DbDriverLogos.cockroachdb.logo,
            "logo_file_name": "cockroachdb-logo.svg",
            "native_driver": "pgsql",
            "default_port": 26257,
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "Amazon-Redshift",
            "short_desc": "Amazon Redshift data warehouse",
            "logo": DbDriverLogos.redshift.logo,
            "logo_file_name": "redshift-logo.svg",
            "native_driver": "pgsql",
            "default_port": 5439,
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "MariaDB",
            "short_desc": "MariaDB database server",
            "logo": DbDriverLogos.mariadb.logo,
            "logo_file_name": "mariadb-logo.svg",
            "native_driver": "mysql",
            "default_port": 3306,
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "Snowflake",
            "short_desc": "Snowflake cloud data warehouse",
            "logo": DbDriverLogos.snowflake.logo,
            "logo_file_name": "snowflake-logo.svg",
            "default_port": 443,
            "supports_odbc": False,
            "jdbc_jar": "snowflake-jdbc.jar",
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "ClickHouse",
            "short_desc": "ClickHouse analytics database",
            "logo": DbDriverLogos.clickhouse.logo,
            "logo_file_name": "clickhouse-logo.svg",
            "default_port": 8123,
            "supports_odbc": False,
            "jdbc_jar": "clickhouse-jdbc.jar",
        });
        registerDbVendorApp(<DbVendorInfo>{
            "display_name": "H2",
            "short_desc": "H2 embedded Java SQL database",
            "logo": DbDriverLogos.h2.logo,
            "logo_file_name": "h2-logo.svg",
            "supports_odbc": False,
            "jdbc_jar": "h2.jar",
        });
    };
}

/** @mainpage DbDataProvider Module

    @tableofcontents

    @section dbdataproviderintro Introduction to the DbDataProvider Module

    The %DbDataProvider module provides a data provider API for databases and supports creating, reading, updating,
    and deleting DB records, as well as high-performance bulk operations as well as upserts through the
    @ref dataproviderintro "DataProvider" API.

    The following classes are provided by this module:
    - @ref DbDataProvider::AbstractDbTableBulkOperation "AbstractDbTableBulkOperation"
    - @ref DbDataProvider::DatasourceConnection "DatasourceConnection"
    - @ref DbDataProvider::DbDataProvider "DbDataProvider"
    - @ref DbDataProvider::DbDataProviderFactory "DbDataProviderFactory"
    - @ref DbDataProvider::DbIndexDataType "DbIndexDataType"
    - @ref DbDataProvider::DbIndexesDataType "DbIndexesDataType"
    - @ref DbDataProvider::DbTableBulkInserter "DbTableBulkInserter"
    - @ref DbDataProvider::DbTableBulkRecordInterface "DbTableBulkRecordInterface"
    - @ref DbDataProvider::DbTableBulkUpserter "DbTableBulkUpserter"
    - @ref DbDataProvider::DbTableDataProvider "DbTableDataProvider"
    - @ref DbDataProvider::DbTableRecordIterator "DbTableRecordIterator"

    @section dbdataprovider_relnotes Release Notes

    @subsection dbdataprovider_v2_4 DbDataProvider v2.4
    - added the @ref DbDataProvider::DbVendorInfo "DbVendorInfo" hashdecl for per-vendor database app configuration
    - added @ref DbDataProvider::registerDbVendorApp() "registerDbVendorApp()" for registering per-vendor database
      applications with individual connection form fields (driver, host, port, db, user, pass, etc.)
    - registered per-vendor database applications for PostgreSQL, MySQL, Oracle, SQL Server, and SQLite
    - added per-vendor database applications for CockroachDB, Amazon Redshift, MariaDB, Snowflake, ClickHouse, and H2
    - added @c jdbc_jar field to @ref DbDataProvider::DbVendorInfo "DbVendorInfo" for JDBC auto-classpath support
    - added SVG logos for CockroachDB, Amazon Redshift, MariaDB, Snowflake, ClickHouse, and H2

    @subsection dbdataprovider_v2_3 DbDataProvider v2.3
    - added the @ref DbDataProvider::DatasourceConnection "DatasourceConnection" class providing database connectivity
      using the @c db:// URL scheme with automatic connection scheme registration
    - added per-database-driver SVG logo registry with logos for PostgreSQL, MySQL, Oracle, SQL Server (FreeTDS),
      SQLite, and ODBC; unknown drivers fall back to the generic database logo

    @subsection dbdataprovider_v2_2 DbDataProvider v2.2
    - optimized the data provider structure, added support for app actions, made the API more AI-friendly

    @subsection dbdataprovider_v2_1_1 DbDataProvider v2.1.1
    - @ref DbDataProvider::DbDataProvider "DbDataProvider" was missing search options
      (<a href="https://github.com/qoretechnologies/qore/issues/4713">issue 4713</a>)

    @subsection dbdataprovider_v2_1 DbDataProvider v2.1
    - enabled browsing the data provider hierarchy according to transactional support
      (<a href="https://github.com/qoretechnologies/qore/issues/4699">issue 4699</a>)

    @subsection dbdataprovider_v2_0_1 DbDataProvider v2.0.1
    - fixed \c sequence and \c sequence_currval mapper options in
      @ref DbDataProvider::DbTableDataProvider "DbTableDataProvider"
      (<a href="https://github.com/qoretechnologies/qore/issues/4628">issue 4628</a>)

    @subsection dbdataprovider_v2_0 DbDataProvider v2.0
    - added the @ref DbDataProvider::DbTransactionHelper "DbTransactionHelper" class
    - added support for creating, reading, updating, and modifying data providers
      (<a href="https://github.com/qoretechnologies/qore/issues/4395">issue 4395</a>)

    @subsection dbdataprovider_v1_0_1 DbDataProvider v1.0.1
    - added support for starting a transaction in @ref DbDataProvider::DbDataProvider "DbDataProvider" and
      @ref DbDataProvider::DbTableDataProvider "DbTableDataProvider"
      (<a href="https://github.com/qoretechnologies/qore/issues/4346">issue 4346</a>)

    @subsection dbdataprovider_v1_0 DbDataProvider v1.0
    - initial release of the module
*/

