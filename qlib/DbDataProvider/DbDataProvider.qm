#! Default logo info for unknown database drivers
public const DbDefaultLogo = {
    "logo": DbLogo,
    "logo_file_name": "db-logo.svg",
    "logo_mime_type": MimeTypeSvg,
};

#! Returns logo info for the given database driver
/** @param driver the database driver name (e.g. @c "pgsql", @c "mysql", etc.)
    @return a hash with @c logo, @c logo_file_name, and @c logo_mime_type keys
*/
public hash<auto> sub getDriverLogo(*string driver) {
    return DbDriverLogos{driver} ?? DbDefaultLogo;
}

#! Per-vendor database app information
/** Provides the configuration for registering a per-vendor database application with individual
    connection form fields.

    @since %DbDataProvider 2.4
*/
public hashdecl DbVendorInfo {
    #! Vendor display name (used as app name, e.g. "PostgreSQL")
    string display_name;

    #! Short description
    string short_desc;

    #! Logo SVG content
    string logo;

    #! Logo file name
    string logo_file_name;

    #! Native DBI driver name (e.g. "pgsql"), NOTHING if no native driver
    *string native_driver;

    #! Default port for this vendor
    *int default_port;

    #! Whether JDBC can be used (default True)
    bool supports_jdbc = True;

    #! Whether ODBC can be used (default True)
    bool supports_odbc = True;

    #! JDBC JAR filename for auto-classpath (e.g. "ojdbc11.jar"), NOTHING if not applicable
    *string jdbc_jar;

    #! Extra vendor-specific connection options (merged after standard fields)
    *hash<string, hash<ConnectionOptionInfo>> extra_options;
}

#! Registers a per-vendor database application with individual connection fields
/** Checks which DBI drivers are installed for the vendor, builds connection options
    (driver, host, port, db, user, pass, charset, min, max, plus optional JDBC classpath),
    and registers the app with \c DataProviderActionCatalog plus standard DB actions.

    Silently skips registration if no usable driver is installed.

    @param vendor the vendor information

    @since %DbDataProvider 2.4
*/
public sub registerDbVendorApp(hash<DbVendorInfo> vendor) {
    # build allowed driver values from vendor capabilities
    # NOTE: we do not check dbi_get_driver_list() here because DBI drivers may not be loaded yet
    # at module init time; driver availability is validated at connection creation time
    list<hash<AllowedValueInfo>> driver_values = ();

    # add native driver
    if (vendor.native_driver) {
        driver_values += <AllowedValueInfo>{
            "value": vendor.native_driver,
            "display_name": vendor.native_driver,
            "short_desc": "Native " + vendor.native_driver + " driver",
        };
    }

    # add JDBC
    if (vendor.supports_jdbc) {
        driver_values += <AllowedValueInfo>{
            "value": "jdbc",
            "display_name": "jdbc",
            "short_desc": "JDBC driver",
        };
    }

    # add ODBC
    if (vendor.supports_odbc) {
        driver_values += <AllowedValueInfo>{
            "value": "odbc",
            "display_name": "odbc",
            "short_desc": "ODBC driver",
        };
    }

    @assert(driver_values);

    # build connection options
    bool single_driver = driver_values.size() == 1;
    hash<string, hash<ConnectionOptionInfo>> conn_opts;

    # only show the driver option when there are multiple choices; when there is only one driver,
    # it is omitted from the form and the backend applies the default automatically
    if (!single_driver) {
        conn_opts.driver = <ConnectionOptionInfo>{
            "display_name": "Driver",
            "short_desc": "Database driver",
            "desc": "The database driver to use for the connection",
            "type": "string",
            "required": True,
            "allowed_values": driver_values,
            # default priority: native > jdbc > odbc (matches driver_values order)
            "default_value": driver_values[0].value,
            "has_dependents": True,
            "on_change": ("refetch",),
            "preselected": True,
        };
    }

    conn_opts.host = <ConnectionOptionInfo>{
        "display_name": "Host",
        "short_desc": "Database server hostname",
        "desc": "The hostname or IP address of the database server",
        "type": "string",
    };

    conn_opts.port = <ConnectionOptionInfo>{
        "display_name": "Port",
        "short_desc": "Database server port",
        "desc": "The port number of the database server",
        "type": "int",
        "default_value": vendor.default_port,
    };

    conn_opts.db = <ConnectionOptionInfo>{
        "display_name": "Database",
        "short_desc": "Database name",
        "desc": "The name of the database to connect to",
        "type": "string",
        "required": True,
    };

    conn_opts.user = <ConnectionOptionInfo>{
        "display_name": "User",
        "short_desc": "Database user",
        "desc": "The database user name for authentication",
        "type": "string",
    };

    conn_opts.pass = <ConnectionOptionInfo>{
        "display_name": "Password",
        "short_desc": "Database password",
        "desc": "The password for database authentication",
        "type": "string",
        "sensitive": True,
    };

    conn_opts.charset = <ConnectionOptionInfo>{
        "display_name": "Character Set",
        "short_desc": "Connection character set",
        "desc": "The character set to use for the connection (e.g. utf8)",
        "type": "string",
    };

    # JDBC classpath (only if JDBC is an option)
    if (vendor.supports_jdbc) {
        conn_opts.classpath = <ConnectionOptionInfo>{
            "display_name": "JDBC Classpath",
            "short_desc": "JDBC driver classpath",
            "desc": "The path to the JDBC driver JAR file(s)",
            "type": "string",
            "depends_on": ("driver=jdbc",),
        };
    }

    conn_opts.min = <ConnectionOptionInfo>{
        "display_name": "Min Pool Size",
        "short_desc": "Minimum pool connections",
        "desc": "Minimum number of connections in the pool",
        "type": "int",
    };

    conn_opts.max = <ConnectionOptionInfo>{
        "display_name": "Max Pool Size",
        "short_desc": "Maximum pool connections",
        "desc": "Maximum number of connections in the pool",
        "type": "int",
    };

    # merge vendor-specific extra options
    if (vendor.extra_options) {
        conn_opts += vendor.extra_options;
    }

    string app_name = vendor.display_name;

    # register the app
    DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
        "name": app_name,
        "display_name": vendor.display_name,
        "short_desc": vendor.short_desc,
        "desc": "Create and manage connections to a " + vendor.short_desc,
        "scheme": "db",
        "logo": vendor.logo,
        "logo_file_name": vendor.logo_file_name,
        "logo_mime_type": MimeTypeSvg,
        "groups": (DataProvider::AppGroup::Databases,),
        "connection_options": conn_opts,
        "auto_url": True,
        # store default driver and JDBC JAR for backend URL construction
        "info": {
            "default_driver": driver_values[0].value,
        } + (vendor.jdbc_jar ? {"jdbc_jar": vendor.jdbc_jar} : {}),
    });

}
}
