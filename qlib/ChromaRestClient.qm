%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes

module ChromaRestClient {
    version = "1.0";
    desc = "user module for calling Chroma vector store REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("chroma",
            ChromaRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("chromas", ChromaRestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerVectorStoreFactory(
            new ChromaVectorStoreFactory());
    };
    # the module registers process-wide functionality in its initialization (connection schemes, LLM provider factories)
    domains = "PROCESS";
}

/** @mainpage ChromaRestClient Module

    @tableofcontents

    @section chromarestclientintro ChromaRestClient Introduction

    The %ChromaRestClient module provides a REST client for
    <a href="https://www.trychroma.com">Chroma</a> — a lightweight, local-first
    vector database — and registers <tt>chroma</tt> as a vector-store backend
    in @ref qoreragutilsintro "QoreRagUtils".

    @par Configuration

    - \c url (optional): defaults to \c http://localhost:8000
    - \c apikey (optional): Bearer token (Chroma Cloud / reverse-proxied)
    - \c tenant (optional): Chroma tenant (defaults to \c "default_tenant")
    - \c database (optional): Chroma database (defaults to \c "default_database")

    @section ChromaRestClientRelnotes Release Notes

    @subsection ChromaRestClientv1_0 ChromaRestClient v1.0
    - initial release
*/

%requires json

public namespace ChromaRestClient {
public class ChromaRestClientBase {
    public {
        const DefaultUrl = "http://localhost:8000";
        const DefaultTenant = "default_tenant";
        const DefaultDatabase = "default_database";

        const DefaultOptions = {
            "url": DefaultUrl,
        };
    }

    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Chroma (sync)
public class ChromaRestClient inherits RestClient::RestClient, ChromaRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(ChromaRestClientBase::getOptions(opts), True) {
    }
}

#! REST client for Chroma using multiplexed HTTP connections
public class ChromaRestClientIo inherits RestClientIo::RestClientIo, ChromaRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(ChromaRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Chroma REST connections
public class ChromaRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "chroma://localhost:8000";

        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation("ChromaRestClient",
            "ChromaRestConnection", "en", <ConnectionSchemeInfo>{
            "display_name": "Chroma Vector Store Connection",
            "short_desc": "A connection to a Chroma vector database",
            "desc": "A connection to a [Chroma](https://www.trychroma.com) vector database.\n\n"
                "Chroma is a lightweight, local-first vector database that pairs naturally "
                "with local Ollama embeddings for self-hosted RAG.\n\n"
                "Local deployments don't require authentication; supply an `apikey` for "
                "Chroma Cloud or reverse-proxied deployments.\n\n"
                "The connection uses the `chroma://` URL scheme for plain HTTP and "
                "`chromas://` for servers behind TLS.",
            "cls": Class::forName("ChromaRestConnection"),
            # Chroma is self-hosted: the server URL must be supplied by the user; with auto_url the URL is
            # generated from options, and as there is no host option, it fell back to "chroma://localhost"
            "auto_url": False,
            "schemes": {"chroma": True, "chromas": True},
            # a single scheme for both transports would make the reverse lookup in getRealUrl() ambiguous
            "base_scheme_map": {"http": "chroma", "https": "chromas"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Optional Bearer token (Chroma Cloud / proxied)",
                    "type": "string",
                    "desc": "Optional Bearer token.  Local Chroma servers do not require "
                        "authentication; supply only for hosted Chroma Cloud or "
                        "reverse-proxied deployments.",
                    "sensitive": True,
                    "preselected": True,
                },
                "tenant": <ConnectionOptionInfo>{
                    "display_name": "Tenant",
                    "short_desc": "Chroma tenant",
                    "desc": "Chroma tenant name.",
                    "type": "string",
                    "default_value": ChromaRestClientBase::DefaultTenant,
                },
                "database": <ConnectionOptionInfo>{
                    "display_name": "Database",
                    "short_desc": "Chroma database",
                    "desc": "Chroma database name.",
                    "type": "string",
                    "default_value": ChromaRestClientBase::DefaultDatabase,
                },
            },
        });
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "chroma";
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("ChromaDataProvider");
        return create_object("ChromaDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private ChromaRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new ChromaRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new ChromaRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return ChromaRestClientBase::getOptions(rv);
    }
}
}

public namespace QoreRagUtils {
#! Chroma-backed vector store
/** Connects to a Chroma server (local or remote) and operates on a
    specific collection identified by collection ID.

    @par Configuration

    @ref VectorStoreConfig fields:
    - \c collection (required): the Chroma collection ID (UUID, not name)
    - \c url (optional): Chroma server URL (default \c http://localhost:8000)
    - \c options.tenant (optional): Chroma tenant (default \c default_tenant)
    - \c options.database (optional): Chroma database (default \c default_database)
    - \c options.api_key (optional): Bearer token for hosted/proxied Chroma
    - \c options.dimension (optional): expected vector dimension
*/
public class ChromaVectorStore inherits AbstractVectorStore {
    public {
        const Backend = "chroma";

        #! Records fetched per request by countByFilter() and summarizeBy()
        const GetPageSize = 1000;
    }

    private {
        hash<VectorStoreConfig> config;
        string collection_id;
        string tenant;
        string database;
        *ChromaRestClient::ChromaRestClientIo rest_client;
        *int cached_dimension;
        Mutex init_mutex();
    }

    constructor(hash<VectorStoreConfig> config) {
        self.config = config;
        if (!config.collection.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "ChromaVectorStore requires 'collection' (Chroma collection ID)";
        }
        init();
    }

    #! Creates the vector store with a pre-built REST client (for example a client with a custom transport)
    /** @param config the store configuration
        @param rest_client the Chroma REST client to use

        @throw VECTOR-STORE-CONFIG-ERROR \c collection is missing
    */
    constructor(hash<VectorStoreConfig> config, ChromaRestClient::ChromaRestClientIo rest_client) {
        self.config = config;
        if (!config.collection.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "ChromaVectorStore requires 'collection' (Chroma collection ID)";
        }
        self.rest_client = rest_client;
        init();
    }

    private init() {
        collection_id = config.collection;
        tenant = config.options.tenant
            ?? ChromaRestClient::ChromaRestClientBase::DefaultTenant;
        database = config.options.database
            ?? ChromaRestClient::ChromaRestClientBase::DefaultDatabase;
        if (exists config.options.dimension) {
            cached_dimension = config.options.dimension;
        }
    }

    upsert(list<hash<VectorRecord>> records) {
        if (!records) {
            return;
        }
        ensureRestClient();
        list<string> ids = map $1.id, records;
        list<list<float>> embeddings = map $1.vector, records;
        list<*hash<auto>> metadatas = map $1.payload ?? {}, records;
        hash<auto> body = {
            "ids": ids,
            "embeddings": embeddings,
            "metadatas": metadatas,
        };
        rest_client.restPost(collectionPath("/upsert"), body);
        if (!exists cached_dimension && records[0].vector) {
            cached_dimension = records[0].vector.size();
        }
    }

    deleteByIds(list<string> ids) {
        if (!ids) {
            return;
        }
        ensureRestClient();
        rest_client.restPost(collectionPath("/delete"), {"ids": ids});
    }

    list<hash<VectorSearchResult>> search(list<float> query_vector, int k,
            *hash<auto> filter) {
        ensureRestClient();
        hash<auto> body = {
            "query_embeddings": (query_vector,),
            "n_results": k,
            "include": ("metadatas", "distances"),
        };
        if (filter && filter.typeCode() == NT_HASH) {
            # Chroma filters use the 'where' (metadata) and 'where_document'
            # (full-text) keys; pass through verbatim
            if (exists filter.where) {
                body."where" = filter.where;
            }
            if (exists filter.where_document) {
                body."where_document" = filter.where_document;
            }
        }
        hash<auto> resp = rest_client.restPost(collectionPath("/query"), body);

        # Chroma v2 returns ids: [[...]], distances: [[...]], metadatas: [[...]]
        # (one nested list per query embedding; we only ever send one).
        *list<auto> id_rows = resp.body.ids;
        *list<auto> dist_rows = resp.body.distances;
        *list<auto> meta_rows = resp.body.metadatas;
        list<string> ids = id_rows && id_rows[0] ? id_rows[0] : ();
        list<auto> dists = dist_rows && dist_rows[0] ? dist_rows[0] : ();
        list<auto> metas = meta_rows && meta_rows[0] ? meta_rows[0] : ();
        list<hash<VectorSearchResult>> result = ();
        int n = ids.size();
        for (int i = 0; i < n; ++i) {
            *hash<auto> payload = (i < metas.size() && metas[i].typeCode() == NT_HASH)
                ? metas[i]
                : NOTHING;
            float dist = (i < dists.size()) ? dists[i].toFloat() : 0.0;
            push result, <VectorSearchResult>{
                "id": ids[i].toString(),
                # Chroma reports distance; smaller = closer.  Surface as
                # similarity = 1 - distance for cosine; for L2/IP we leave the
                # raw distance as a negative score so larger = closer.
                "score": 1.0 - dist,
                "payload": payload,
            };
        }
        return result;
    }

    #! Counts the records that match a payload filter
    /** Without a filter, calls \c GET \c /count.  With one, pages the matching ids with \c POST \c /get, because
        the count endpoint takes no filter.

        @param filter optional filter: the portable \c payload_eq form (equality on metadata keys, combined with
            \c $and), or \c where, a Chroma metadata filter

        @return the number of matching records
    */
    int countByFilter(*hash<auto> filter) {
        ensureRestClient();
        *hash<auto> wf = ChromaVectorStore::makeWhere(filter);
        if (!wf) {
            return rest_client.restGet(collectionPath("/count")).body.toInt();
        }
        int total = 0;
        while (True) {
            int n = getPage(wf, total, ("metadatas",)).ids.size();
            total += n;
            if (n < GetPageSize) {
                return total;
            }
        }
    }

    #! Deletes the records that match a payload filter
    /** Counts the matching records, then calls \c POST \c /delete with the filter, because Chroma does not report
        the number of records removed.

        @param filter the filter; see countByFilter()

        @return the number of records that matched immediately before the delete

        @throw VECTOR-STORE-FILTER-ERROR the filter is empty
    */
    int deleteByFilter(hash<auto> filter) {
        *hash<auto> wf = ChromaVectorStore::makeWhere(filter);
        AbstractVectorStore::requireFilterCriteria(exists wf);
        int matched = countByFilter(filter);
        if (matched) {
            rest_client.restPost(collectionPath("/delete"), {"where": wf});
        }
        return matched;
    }

    #! Summarizes the records by the distinct values of a metadata key
    /** Pages through the matching records with \c POST \c /get, fetching only metadata, and groups them here.

        @param field the metadata key to group by
        @param filter optional filter; see countByFilter()
        @param timestamp_field optional metadata key holding a date or an ISO 8601 string

        @return the groups ordered by descending count and then by value
    */
    list<hash<VectorFieldSummary>> summarizeBy(string field, *hash<auto> filter, *string timestamp_field) {
        ensureRestClient();
        *hash<auto> wf = ChromaVectorStore::makeWhere(filter);
        hash<string, hash<auto>> groups = {};
        int offset = 0;
        while (True) {
            hash<auto> page = getPage(wf, offset, ("metadatas",));
            list<auto> metas = page.metadatas ?? ();
            int n = page.ids.size();
            for (int i = 0; i < n; ++i) {
                hash<auto> meta = metas[i].typeCode() == NT_HASH ? metas[i] : {};
                AbstractVectorStore::addToSummary(\groups, meta{field}, timestamp_field ? meta{timestamp_field} : NOTHING);
            }
            offset += n;
            if (n < GetPageSize) {
                break;
            }
        }
        return AbstractVectorStore::finishSummary(groups);
    }

    string getCollection() {
        return collection_id;
    }

    #! Fetches one page of records with \c POST \c /get
    private hash<auto> getPage(*hash<auto> wf, int offset, list<string> include) {
        hash<auto!> body = {"limit": GetPageSize, "offset": offset, "include": include};
        if (wf) {
            body."where" = wf;
        }
        return rest_client.restPost(collectionPath("/get"), body).body;
    }

    #! Returns the Chroma \c where filter for a filter, or NOTHING for no filter
    private static *hash<auto> makeWhere(*hash<auto> filter) {
        if (!filter) {
            return;
        }
        if (filter."where" instanceof hash && filter."where") {
            return filter."where";
        }
        if (!(filter.payload_eq instanceof hash) || filter.payload_eq.empty()) {
            return;
        }
        list<hash<auto>> terms = ();
        foreach string key in (keys filter.payload_eq) {
            push terms, {key: {"$eq": filter.payload_eq{key}}};
        }
        return terms.size() == 1 ? terms[0] : {"$and": terms};
    }

    int getDimension() {
        if (exists cached_dimension) {
            return cached_dimension;
        }
        init_mutex.lock();
        on_exit init_mutex.unlock();
        if (exists cached_dimension) {
            return cached_dimension;
        }
        ensureRestClient();
        try {
            hash<auto> resp = rest_client.restGet(collectionPath(""));
            if (resp.body.dimension) {
                cached_dimension = resp.body.dimension.toInt();
                return cached_dimension;
            }
        } catch (hash<ExceptionInfo> ex) {
            # ignore — return -1 below
        }
        return -1;
    }

    private string collectionPath(string subpath) {
        return sprintf("/api/v2/tenants/%s/databases/%s/collections/%s%s",
            tenant, database, collection_id, subpath);
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                hash<auto!> opts = {
                    "url": config.url
                        ?? ChromaRestClient::ChromaRestClientBase::DefaultUrl,
                };
                if (config.options.api_key.val()) {
                    opts.apikey = config.options.api_key;
                }
                rest_client = new ChromaRestClient::ChromaRestClientIo(opts);
            }
        }
    }
}

#! Factory for @ref ChromaVectorStore
public class ChromaVectorStoreFactory inherits AbstractVectorStoreFactory {
    string getType() {
        return "chroma";
    }

    string getDisplayName() {
        return "Chroma vector store";
    }

    AbstractVectorStore create(hash<VectorStoreConfig> config) {
        return new ChromaVectorStore(config);
    }
}
}
