# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere
# enable all warnings
# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module PdfCoRestClient {
    version = "1.0";
    desc = "User module for calling PDF.co REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("pdfco", PdfCoRestConnection::ConnectionScheme);
    };
}

/** @mainpage PdfCoRestClient Module

    @tableofcontents

    @section pdfcorestclientintro PdfCoRestClient Introduction

    The %PdfCoRestClient module provides an API for calling PDF.co's REST API services.

    To use this module, use \c "%requires PdfCoRestClient" in your code.

    All the public symbols in the module are defined in the PdfCoRestClient namespace.

    The main classes are:
    - @ref PdfCoRestClient::PdfCoRestClient "PdfCoRestClient":
      this class provides the REST client API for communication with the PDF.co API;
      it handles authentication via API key
    - @ref PdfCoRestClient::PdfCoRestConnection "PdfCoRestConnection":
      provides a connection object to PDF.co services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires PdfCoRestClient

PdfCoRestClient pdfco({"apikey": ENV.PDFCO_API_KEY});
hash<auto> result = pdfco.post("pdf/info", {"url": "https://example.com/sample.pdf"});
printf("PDF Info: %Y\n", result.body);
    @endcode

    @section pdfcorestclientrelnotes Release Notes

    @subsection pdfcorestclientv1_0 PdfCoRestClient v1.0
    - the initial version of the %PdfCoRestClient module
*/

#! the PdfCoRestClient namespace contains all the objects in the PdfCoRestClient module
public namespace PdfCoRestClient {

#! Common base class for PdfCoRestClient functionality
public class PdfCoRestClientBase {
    public {
        #! PDF.co API base URL
        const DefaultApiUrl = "https://api.pdf.co/v1";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default PDF.co ping method
        const DefaultPingMethod = "GET";

        #! Default PDF.co ping path (account credit balance - lightweight, always available)
        const DefaultPingPath = "account/credit/balance";

        #! Default PDF.co ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! returns options for @ref PdfCoRestClient::PdfCoRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Set API URL (use default unless caller provided an override)
        if (!rv.url) {
            rv.url = DefaultApiUrl;
        }

        # Validate apikey is provided
        if (!opts.apikey) {
            throw "PDFCO-ERROR", "missing required option 'apikey' (PDF.co API key)";
        }

        # Set x-api-key header and remove apikey from opts
        # so that RestClient does not attempt to handle it specially
        rv.headers."x-api-key" = opts.apikey;
        remove rv.apikey;

        return rv;
    }
}

#! This class provides the REST client API for communication with PDF.co servers
/** PDF.co uses a REST API with API key authentication via the \c x-api-key header.

    @par API Information:
    - Base URL: https://api.pdf.co/v1
    - Get API key at: https://app.pdf.co/
*/
public class PdfCoRestClient inherits RestClient::RestClient, PdfCoRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
PdfCoRestClient pdfco({"apikey": "your-api-key"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the PDF.co API key (required)

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw PDFCO-ERROR missing required option 'apikey'
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(PdfCoRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for PDF.co REST connections; returns @ref PdfCoRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c apikey: the PDF.co API key

    @see @ref PdfCoRestClient::PdfCoRestClient::constructor() for more information on the above options
*/
public class PdfCoRestConnection inherits RestClient::RestConnection {
    public {
        #! Default PDF.co connection URL
        const DefaultConnectionUrl = "pdfco://api.pdf.co/v1";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "PDF.co REST Connection",
            "short_desc": "A connection to the PDF.co REST API",
            "desc": "A connection to the PDF.co REST API for document processing.\n\n"
                "PDF.co provides APIs for PDF conversion, manipulation, data extraction, "
                "barcode generation/reading, document classification, and more.",
            "cls": Class::forName("PdfCoRestConnection"),
            "auto_url": True,
            "schemes": {
                "pdfco": True,
            },
            "base_scheme_map": {
                "https": "pdfco",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": PdfCoRestClientBase::DefaultData,
                },
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "PDF.co API key",
                    "type": "string",
                    "desc": "The PDF.co API key used for authentication.\n\n"
                        "Get your API key from your PDF.co dashboard at "
                        "https://app.pdf.co/",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": PdfCoRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": PdfCoRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": PdfCoRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Get Your API Key",
                    "intent": "info",
                    "content": "1. Sign up or log in at https://app.pdf.co/\n"
                        "2. Navigate to the **API Keys** section in your dashboard\n"
                        "3. Copy your API key and paste it into the **API Key** field\n\n"
                        "**Note:** PDF.co uses a credit-based billing system. "
                        "Check your remaining credits in the dashboard.",
                },
            ),
        };
    }

    #! creates the PdfCoRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the PdfCoRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(PdfCoRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref PdfCoRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": DefaultConnectionUrl,
        };
    }

    #! returns \c "pdfco"
    string getType() {
        return "pdfco";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the @ref getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        return "PdfCo";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the PdfCoDataProvider and creates the data provider
        # object dynamically
        load_module("PdfCoDataProvider");
        return create_object("PdfCoDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! returns a @ref PdfCoRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref PdfCoRestClient object
    */
    private PdfCoRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new PdfCoRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since PdfCoRestClient 1.1
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new PdfCoRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for PDF.co REST API using multiplexed HTTP connections
/** @see PdfCoRestClient for more information
*/
public class PdfCoRestClientIo inherits RestClientIo::RestClientIo, PdfCoRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(PdfCoRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
