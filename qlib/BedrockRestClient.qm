%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires(reexport) AwsRestClient >= 1.4
%requires AwsEventStream >= 1.1
%requires QoreLlmTypes
%requires QoreRagTypes

%requires json

module BedrockRestClient {
    version = "1.1";
    desc = "REST client and LLM provider for AWS Bedrock — speaks the unified "
        "Converse API across Anthropic, Llama, Mistral, "
        "Cohere, AI21, Titan, and DeepSeek-on-Bedrock model families";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("bedrock",
            BedrockRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(
            new BedrockLlmProviderFactory());
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new BedrockRestClient::BedrockEmbedderFactory());
    };
}

/** @mainpage BedrockRestClient Module

    @tableofcontents

    @section bedrockrestclientintro Introduction to the BedrockRestClient Module

    The %BedrockRestClient module wraps AWS Bedrock for use with the
    <a href="../../QoreLlmUtils/html/index.html">QoreLlmUtils</a> agent stack and the
    <a href="../../QoreRagUtils/html/index.html">QoreRagUtils</a> RAG pipeline.  Both the unified
    Converse API (chat + tool use, covering the Anthropic /
    Llama / Mistral / Cohere / AI21 / Titan / DeepSeek model families) and
    Titan / Cohere embeddings are supported.

    Native `ConverseStream` and `InvokeModelWithResponseStream` responses are delivered incrementally by
    @ref BedrockRestClient::BedrockRestClientIo "BedrockRestClientIo". Full-duplex
    `InvokeModelWithBidirectionalStream` sessions support concurrent
    model input and output over HTTP/2, chained event signatures, and upload half-close.

    SigV4 signing, region detection, and the standard AWS credential
    resolution chain (static -> env vars -> ECS task-role -> IMDSv2 ->
    STS AssumeRole) are inherited from
    @ref awsrestclientintro "AwsRestClient".

    @par Connection options

    - \c url (optional): override the default
      \c https://bedrock-runtime.{region}.amazonaws.com (set automatically
      from \c aws_region when omitted)
    - \c aws_region (required when not derivable from URL): the AWS region
      (e.g. \c "us-east-1")
    - \c aws_keyid / \c aws_secret / \c aws_token: see @ref awsrestclientintro
      — all four credential paths (static, env, ECS/IMDS, STS) are honored

    @par LlmBackendConfig options

    @ref BedrockLlmProvider uses the following options:

    - \c url (optional): same as above
    - \c model (required): the Bedrock model ID, e.g.
      \c "anthropic.claude-3-5-sonnet-20240620-v1:0",
      \c "amazon.nova-pro-v1:0", \c "meta.llama3-1-70b-instruct-v1:0",
      \c "mistral.mistral-large-2402-v1:0"
    - \c api_key: unused by Bedrock (auth via SigV4); included for
      LlmBackendConfig schema compatibility
    - \c provider_options.aws_region (recommended): the AWS region
    - \c provider_options.aws_keyid / .aws_secret / .aws_token: optional
      static credentials (env vars / IMDS pickup runs automatically when
      these are omitted)
    - \c provider_options.aws_role_arn: optional STS AssumeRole

    @par Example

    @code{.py}
%requires BedrockRestClient

BedrockLlmProvider p(<LlmBackendConfig>{
    "model": "anthropic.claude-3-5-sonnet-20240620-v1:0",
    "provider_options": {
        "aws_region": "us-east-1",
    },
});
hash<ChatResponse> r = p.chat((
    <ChatMessage>{"role": "user", "content": "Hello!"},
));
    @endcode

    @section bedrockrestclientrelnotes Release Notes

    @subsection bedrockrestclient_v1_1 BedrockRestClient v1.1
    - implements all three native runtime event-stream operations with CRC validation, timeouts, and cancellation
    - emits incremental Converse text and tool-call fragments, with final stop reason and usage metadata
    - signs bidirectional input events and terminal envelopes over HTTP/2 without buffering either direction
    - associates Bedrock connections with the AWS Bedrock data provider app
    - derives persistent runtime endpoints from the configured AWS region
    - verifies credentials without inference by listing foundation models
    - signs the encoded model identifiers in Converse and embedding requests without extra URI escaping

    @subsection bedrockrestclient_v1_0 BedrockRestClient v1.0
    - initial release: BedrockRestConnection + BedrockRestClient(Io),
      BedrockLlmProvider (Converse), BedrockEmbedder (Titan + Cohere)
*/

#! Contains all public definitions in the BedrockRestClient module
public namespace BedrockRestClient {
#! Default Bedrock service identifier (used for SigV4 scope)
public const BedrockService = "bedrock";

#! Default Bedrock runtime service hostname pattern
public const BedrockRuntimeHostPattern = "bedrock-runtime.%s.amazonaws.com";

#! Bedrock runtime client with native response and bidirectional event streams
/** Uses the same credential chain and encoded-path signing as ordinary Bedrock requests.
    The returned streams are incremental and must be closed when abandoned.

    @par Example
    @code{.py}
BedrockRestClientIo client({"url": "https://bedrock-runtime.us-east-1.amazonaws.com",
    "aws_region": "us-east-1"});
BedrockEventStream stream = client.openConverseStream("amazon.nova-micro-v1:0", {
    "messages": ({"role": "user", "content": ({"text": "Summarize this order."},)},),
});
on_exit stream.close();
while (*hash<auto> event = stream.readEvent()) {
    if (exists event.contentBlockDelta.delta.text) {
        print(event.contentBlockDelta.delta.text);
    }
}
    @endcode
*/
public class BedrockRestClientIo inherits AwsRestClient::AwsRestClientIo {
    #! Creates a regional Bedrock runtime client
    /** @param opts AWS and HTTP client options; `url` identifies the runtime endpoint
        @param shared_mgr optional caller-owned connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : AwsRestClient::AwsRestClientIo(opts + {"aws_service": BedrockService}, shared_mgr) {
    }

    #! Opens the unified Converse event stream
    /** @param model_id model ID or ARN
        @param body native ConverseStream request, including optional streaming guardrail settings
        @return an incremental stream of native, single-member Bedrock event hashes
        @throw BEDROCK-STREAM-ERROR the model ID is empty
    */
    BedrockEventStream openConverseStream(string model_id, hash<auto> body) {
        return new BedrockEventStream(startEncodedEventStream("POST", streamPath(model_id, "converse-stream"),
            binary(make_json(body)), {"content-type": MimeTypeJson, "accept": "application/vnd.amazon.eventstream"}));
    }

    #! Opens a model-specific inference response stream
    /** @param model_id model ID or ARN
        @param body pre-serialized model-specific JSON request
        @param headers optional Bedrock headers, including guardrail, trace, and response content type
        @return a stream whose `chunk.bytes` values are decoded binary payloads
        @throw BEDROCK-STREAM-ERROR the model ID is empty
    */
    BedrockEventStream openInvokeModelWithResponseStream(string model_id, data body, *hash<auto> headers) {
        return new BedrockEventStream(startEncodedEventStream("POST",
            streamPath(model_id, "invoke-with-response-stream"), binary(body), {
                "content-type": MimeTypeJson,
                "accept": "application/vnd.amazon.eventstream",
                "x-amzn-bedrock-accept": MimeTypeJson,
            } + (headers ?? {})));
    }

    #! Opens a full-duplex model session with chained SigV4 event signatures
    /** @param model_id model ID or ARN supporting bidirectional inference
        @return a session supporting concurrent `send()`, `readEvent()`, and upload half-close
        @throw BEDROCK-STREAM-ERROR the model ID is empty or HTTP/2 was not negotiated
        @note Configure `http_version` as `2.0` if the endpoint does not negotiate HTTP/2 automatically.
    */
    BedrockEventStream openInvokeModelWithBidirectionalStream(string model_id) {
        AwsRestClient::AwsSignedEventStream stream = startEncodedEventStream("POST",
            streamPath(model_id, "invoke-with-bidirectional-stream"), NOTHING,
            {"accept": "application/vnd.amazon.eventstream"}, True);
        if (stream.getProtocol() != "h2") {
            stream.close();
            throw "BEDROCK-STREAM-ERROR", "bidirectional Bedrock streaming requires HTTP/2";
        }
        return new BedrockEventStream(stream);
    }

    #! Encodes a model ID as exactly one URI segment
    private static string streamPath(string model_id, string operation) {
        if (!model_id.val()) {
            throw "BEDROCK-STREAM-ERROR", "a nonempty Bedrock model ID is required";
        }
        return "/model/" + encode_url(model_id, True) + "/" + operation;
    }
}

#! Native Bedrock event reader and optional bidirectional writer
/** Events have the same single-member shape as the AWS SDK: `messageStart`, `contentBlockDelta`, `metadata`,
    or `chunk`, for example. Model-specific `chunk.bytes` values are decoded to binary; application JSON is
    deliberately left to the caller. Transport and service exceptions never appear as successful EOF.

    @par Bidirectional model sessions
    Send model-native input from one thread while another reads events. Before ending the upload, send
    the model's own closing events (for Nova Sonic, `contentEnd`, `promptEnd`, and `sessionEnd`), then
    call @ref writesDone(). Continue reading until EOF and always close an abandoned session.
    The library frames and signs bytes; the caller owns the model's audio format and event ordering.
    @note Long-lived sessions retain the credentials used to authenticate their initial request. Credential
    renewal applies to new clients, not an in-flight signature chain.
*/
public class BedrockEventStream {
    private {
        AwsRestClient::AwsSignedEventStream stream;
    }

    #! Wraps an authenticated AWS event stream
    /** @param stream authenticated transport session */
    constructor(AwsRestClient::AwsSignedEventStream stream) {
        self.stream = stream;
    }

    #! Reads the next native Bedrock event
    /** @param timeout_ms idle timeout; omitted to use the HTTP client timeout
        @return the event hash, or @ref nothing at clean EOF
        @throw BEDROCK-STREAM-EXCEPTION the service emitted an exception or error event
        @throw BEDROCK-STREAM-FORMAT-ERROR malformed event metadata or JSON
        @note Framing, transport, and timeout exceptions from the AWS stream are propagated unchanged.
    */
    *hash<auto> readEvent(*timeout timeout_ms) {
        try {
            *hash<AwsEventStream::AwsEventStreamFrame> frame = stream.readFrame(timeout_ms);
            if (!frame) {
                return NOTHING;
            }
            string message_type = frame.headers.":message-type" ?? "";
            string event_type = frame.headers.":event-type" ?? "";
            if (message_type == "exception" || message_type == "error") {
                string exception_type = frame.headers.":exception-type" ?? frame.headers.":error-code" ?? "Unknown";
                *string message = frame.headers.":error-message";
                hash<auto> detail = {};
                if (frame.payload.size()) {
                    try { detail = parse_json(frame.payload.toString("UTF-8")); } catch () {}
                }
                throw "BEDROCK-STREAM-EXCEPTION", exception_type + ": "
                    + (message ?? detail.message ?? detail.Message ?? "Bedrock stream failed"), detail;
            }
            if (message_type != "event" || !event_type.val()) {
                throw "BEDROCK-STREAM-FORMAT-ERROR", "missing or invalid Bedrock event type";
            }
            auto payload;
            try {
                payload = frame.payload.size() ? parse_json(frame.payload.toString("UTF-8")) : {};
            } catch (hash<ExceptionInfo> ex) {
                throw "BEDROCK-STREAM-FORMAT-ERROR", "event payload is not valid JSON", ex;
            }
            if (payload.typeCode() != NT_HASH) {
                throw "BEDROCK-STREAM-FORMAT-ERROR", "event payload must be a JSON object";
            }
            if (event_type == "chunk") {
                if (payload.bytes.typeCode() != NT_STRING) {
                    throw "BEDROCK-STREAM-FORMAT-ERROR", "chunk.bytes must be a base64 string";
                }
                payload.bytes = parse_base64_string(payload.bytes);
            }
            return {event_type: payload};
        } catch (hash<ExceptionInfo> ex) {
            stream.close();
            rethrow;
        }
    }

    #! Sends a model-native input payload on a bidirectional session
    /** @param payload model-native bytes, typically a serialized Nova Sonic JSON event
        @throw AWS-EVENT-STREAM-CLOSED this session does not have an open upload
    */
    send(data payload) {
        stream.sendEvent({":message-type": "event", ":event-type": "chunk", ":content-type": MimeTypeJson},
            binary(make_json({"bytes": binary(payload).toBase64()})));
    }

    #! Half-closes the upload after signing its terminal event; responses remain readable
    /** @throw AWS-EVENT-STREAM-CLOSED the session is closed or response-only */
    writesDone() {
        stream.writesDone();
    }

    #! Returns the HTTP response metadata
    /** @return HTTP status and response headers available so far */
    hash<auto> getResponseInfo() {
        return stream.getResponseInfo();
    }

    #! Cancels the session, including a blocked read; safe to call repeatedly
    close() {
        stream.close();
    }
}

#! Bedrock REST connection (registered under the \c "bedrock" scheme)
public class BedrockRestConnection inherits AwsRestClient::AwsRestConnection {
    public {
        #! Default AWS region
        const DefaultRegion = "us-east-1";

        #! Default persistent connection URL
        /** The connection scheme is preserved so a saved connection reloads as
            a Bedrock connection instead of a generic HTTPS connection.
        */
        const DefaultUrl = "bedrock://bedrock-runtime.us-east-1.amazonaws.com";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "AWS Bedrock Connection",
            "short_desc": "A connection to the AWS Bedrock runtime",
            "desc": "A connection to [AWS Bedrock](https://aws.amazon.com/bedrock/) "
                "for chat, embeddings, and model-management actions through "
                "SigV4-signed REST calls.\n\n"
                "The runtime endpoint is derived from `aws_region`. Authentication "
                "uses explicit access keys when supplied, otherwise the standard "
                "AWS environment, ECS task-role, or IMDSv2 credential chain. An "
                "optional role ARN applies STS AssumeRole after resolving the base "
                "credential. The connection ping makes an authenticated, "
                "inference-free `ListFoundationModels` request.",
            "cls": Class::forName("BedrockRestConnection"),
            "auto_url": True,
            "schemes": {"bedrock": True},
            "base_scheme_map": {"https": "bedrock"},
            "options": AwsRestClient::AwsRestConnection::ConnectionScheme.options
                - ("data", "aws_service", "aws_s3", "ping_body", "ping_headers",
                    "ping_method", "ping_path") + {
                "aws_region": AwsRestClient::AwsRestConnection::ConnectionScheme.options.aws_region
                    + <ConnectionOptionInfo>{
                        "display_name": "AWS Region",
                        "short_desc": "AWS region hosting the Bedrock resources",
                        "desc": "AWS region used for Bedrock runtime and control-plane "
                            "requests. The connection derives both service endpoints "
                            "from this value.",
                        "default_value": DefaultRegion,
                        "allowed_values": AwsRestClient::AwsS3RestConnection::AwsRegions,
                        "allowed_values_creatable": True,
                        "preselected": True,
                    },
                "aws_keyid": AwsRestClient::AwsRestConnection::ConnectionScheme.options.aws_keyid
                    + <ConnectionOptionInfo>{
                        "display_name": "AWS Access Key ID",
                        "short_desc": "Optional access key ID for SigV4 authentication",
                        "desc": "AWS access key ID for explicit credentials. Leave this "
                            "and `aws_secret` empty to use the AWS environment, ECS "
                            "task-role, or IMDSv2 credential chain.",
                        "sensitive": True,
                    },
                "aws_secret": AwsRestClient::AwsRestConnection::ConnectionScheme.options.aws_secret
                    + <ConnectionOptionInfo>{
                        "display_name": "AWS Secret Access Key",
                        "short_desc": "Optional secret key for SigV4 authentication",
                        "desc": "AWS secret access key paired with `aws_keyid`. Leave "
                            "both fields empty to use the standard AWS credential chain.",
                        "sensitive": True,
                    },
                "aws_token": AwsRestClient::AwsRestConnection::ConnectionScheme.options.aws_token
                    + <ConnectionOptionInfo>{
                        "display_name": "AWS Session Token",
                        "short_desc": "Optional token for temporary AWS credentials",
                        "desc": "AWS session token supplied with temporary access-key "
                            "credentials.",
                        "sensitive": True,
                    },
                "aws_role_arn": <ConnectionOptionInfo>{
                    "display_name": "STS Role ARN",
                    "short_desc": "Optional AWS role to assume",
                    "type": "string",
                    "desc": "AWS role ARN to assume after resolving the base credential. "
                        "The resulting temporary credential signs Bedrock requests.",
                },
                "aws_role_session_name": <ConnectionOptionInfo>{
                    "display_name": "STS Role Session Name",
                    "short_desc": "Optional name for the assumed-role session",
                    "type": "string",
                    "desc": "Session name sent to AWS STS when `aws_role_arn` is set.",
                    "default_value": "qore-sdk-session",
                },
                "aws_external_id": <ConnectionOptionInfo>{
                    "display_name": "STS External ID",
                    "short_desc": "Optional external ID required by the role",
                    "type": "string",
                    "desc": "External ID sent to AWS STS when the target role requires one.",
                    "sensitive": True,
                },
            },
            "required_options": "aws_region",
        };
    }

    #! Creates a Bedrock connection
    /** @param name connection name
        @param description connection description
        @param url ignored; the endpoint is derived from <tt>options.aws_region</tt>
        @param attributes connection attributes
        @param options connection options

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : AwsRestClient::AwsRestConnection(name, description,
                BedrockRestConnection::getRuntimeUrl(options.aws_region), attributes,
                options) {
    }

    #! Creates a Bedrock connection from a saved configuration
    /** @param config saved connection configuration
        @param attr optional connection attributes

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : AwsRestClient::AwsRestConnection(BedrockRestConnection::getConfig(config), attr) {
    }

    #! Returns the associated data provider application
    /** @return <tt>AWSBedrock</tt> */
    *string getAppName() {
        return "AWSBedrock";
    }

    #! Returns the connection type
    /** @return <tt>bedrock</tt> */
    string getType() {
        return "bedrock";
    }

    #! Reports that this connection provides the Bedrock data provider
    /** @return @ref True */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the Bedrock data provider backed by this connection
    /** @param constructor_options additional Bedrock data provider constructor options
        @return a Bedrock root data provider

        @throw LOAD-MODULE-ERROR if the BedrockDataProvider module cannot be loaded
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("BedrockDataProvider");
        return create_object("BedrockDataProvider",
            (constructor_options ?? {}) + {"restclient": getAsync()});
    }

    #! Returns client options with the Bedrock SigV4 service pinned
    /** @param rtopts optional runtime options
        @return normalized AWS REST client options
    */
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        return AwsRestClient::AwsRestConnection::getConnectionOptions(rtopts) + {
            "aws_service": BedrockService,
        };
    }

    #! Returns the persistent runtime URL for the given region
    /** @param region AWS region; defaults to @ref DefaultRegion
        @return a persistent <tt>bedrock</tt> connection URL
    */
    static string getRuntimeUrl(*string region) {
        return sprintf("bedrock://" + BedrockRuntimeHostPattern,
            region.val() ? region : DefaultRegion);
    }

    #! Returns the control-plane URL corresponding to a runtime client URL
    /** @param runtime_url Bedrock runtime endpoint URL
        @return the matching Bedrock control-plane URL
    */
    static string getControlPlaneUrl(string runtime_url) {
        return regex_subst(runtime_url, "bedrock-runtime\\.", "bedrock.");
    }

    #! Normalizes a saved connection configuration
    private static hash<auto> getConfig(hash<auto> config) {
        hash<auto> opts = config.opts ?? {};
        return config + {
            "url": BedrockRestConnection::getRuntimeUrl(opts.aws_region),
            "opts": opts,
        };
    }

    #! Marks Bedrock child providers as API-capable
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! Verifies credentials with an inference-free control-plane request
    private pingImpl() {
        AbstractRestClient runtime = cast<AbstractRestClient>(getAsync());
        AbstractRestClient control = new AwsRestClient::AwsRestClientIo(
            getConnectionOptions() + {
                "url": BedrockRestConnection::getControlPlaneUrl(runtime.getUrl()),
            });
        try {
            hash<RestClient::RestResponseInfo> response = control.restGet("/foundation-models");
            if ((response.status_code / 100) != 2 || !exists response.body.modelSummaries) {
                authFailure();
                throw "REST-PING-ERROR", sprintf(
                    "invalid response to Bedrock ListFoundationModels ping: HTTP %d",
                    response.status_code);
            }
        } catch (hash<ExceptionInfo> ex) {
            authFailure();
            rethrow;
        }
        authSuccess();
    }

    #! Returns a runtime client with native event-stream support
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new BedrockRestClientIo(getConnectionOptions(rtopts));
    }

    #! Keeps the derived endpoint synchronized with connection option updates
    /** @param update_options callback used to persist corrected options */
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            string runtime_url = BedrockRestConnection::getRuntimeUrl(opts.aws_region);
            if (url != runtime_url) {
                doUpdateOptions(self, {"url": runtime_url});
            }
        }
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! Bedrock LLM provider — speaks the unified Converse API
/** Implements @ref QoreLlmUtils::AbstractLlmProvider for any model
    available via Bedrock's Converse endpoint.  A streamed request is
    delivered incrementally through Bedrock's ConverseStream endpoint, including text,
    tool-call fragments, stop reasons, and usage metadata.

    @par Authentication

    Pure SigV4 — pass AWS credentials via \c provider_options or rely on
    the AwsRestClient credential chain (env vars / ECS task-role / IMDSv2 /
    STS AssumeRole).  No \c api_key is consumed.

    @par Model ID

    The \c LlmBackendConfig::model field must be a Bedrock model identifier
    (e.g. \c "anthropic.claude-3-5-sonnet-20240620-v1:0").  When omitted, a
    safe default of \c "amazon.nova-lite-v1:0" is used.
*/
public class BedrockLlmProvider inherits QoreLlmUtils::AbstractLlmProvider {
    public {
        const DefaultModel = "amazon.nova-lite-v1:0";
    }

    #! Returns the default Bedrock chat model
    *string getDefaultModel() {
        return DefaultModel;
    }

    private {
        *BedrockRestClientIo rest_client;
        Mutex rest_mutex();
    }

    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : QoreLlmUtils::AbstractLlmProvider(config) {
        # validate region resolution at construction so we fail fast
        BedrockLlmProvider::resolveRegion(config);
    }

    string getMode() {
        return "bedrock";
    }

    hash<QoreLlmUtils::LlmCompletionResult> complete(string system_prompt,
            string user_prompt, *hash<auto> output_schema,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        list<hash<QoreLlmUtils::ChatMessage>> messages = (
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": user_prompt},
        );
        hash<auto> body = buildConverseBody(messages, NOTHING, opts,
            system_prompt, output_schema);
        hash<auto> resp = postConverse(body, opts);
        return <QoreLlmUtils::LlmCompletionResult>{
            "content": extractConverseText(resp.body),
            "usage": normalizeUsage(resp.body.usage),
        };
    }

    hash<QoreLlmUtils::ChatResponse> chat(
            list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        hash<auto> body = buildConverseBody(messages, tools, opts);
        hash<auto> resp = postConverse(body, opts);
        return parseConverseResponse(resp.body, opts);
    }

    #! Streams text, tool-call fragments, stop reason, and usage from ConverseStream
    /** Each native event is delivered immediately. Exactly one final `done` event follows clean EOF,
        after the message stop and usage metadata; errors or callback failures cancel the stream without
        retrying a partially delivered generation.

        @param messages conversation history
        @param callback receives each incremental event
        @param tools optional tool definitions
        @param opts per-call overrides

        @throw LLM-ERROR the request failed
    */
    chatStream(list<hash<QoreLlmUtils::ChatMessage>> messages,
            code<nothing(hash<QoreLlmUtils::ChatStreamEvent>)> callback,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();
        hash<auto> body = buildConverseBody(messages, tools, opts);
        *BedrockEventStream stream;
        bool stopped = False;
        try {
            stream = rest_client.openConverseStream(getBedrockModelId(opts), body);
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR", "Bedrock ConverseStream failed: " + ex.desc, ex;
        }
        on_exit stream.close();
        while (True) {
            *hash<auto> raw;
            try {
                raw = stream.readEvent(getRequestTimeoutMs(opts));
            } catch (hash<ExceptionInfo> ex) {
                throw "LLM-ERROR", "Bedrock ConverseStream failed: " + ex.desc, ex;
            }
            if (!raw) {
                break;
            }
            string event_name = (keys raw)[0];
            raw = raw + {"requestId": stream.getResponseInfo().headers."x-amzn-requestid"};
            if (exists raw.messageStop) {
                stopped = True;
            }
            hash<QoreLlmUtils::ChatStreamEvent> event = <QoreLlmUtils::ChatStreamEvent>{
                "event": event_name,
                "raw": raw,
            };
            if (exists raw.contentBlockDelta.delta.text) {
                event.delta = raw.contentBlockDelta.delta.text;
            }
            callback(event);
        }
        if (!stopped) {
            throw "LLM-ERROR", "Bedrock ConverseStream ended without messageStop";
        }
        stream.close();
        callback(<QoreLlmUtils::ChatStreamEvent>{"done": True});
    }

    #! Updates OpenAI stream state from a native Converse stream event
    /** @param state the OpenAI-compatible stream state
        @param raw the native event delivered by @ref chatStream(), or a legacy completed response
    */
    updateOpenAiStreamStateFromRaw(reference<hash<auto>> state,
            *hash<auto> raw) {
        if (!raw) {
            return;
        }
        *string request_id = raw.requestId ?? raw.responseMetadata.requestId;
        if (request_id.val()) {
            state.id = request_id;
        }
        *hash<auto> usage = raw.metadata.usage ?? raw.usage;
        if (usage) {
            state.usage = normalizeUsage(usage);
        }
        *string stop_reason = raw.messageStop.stopReason ?? raw.stopReason;
        if (stop_reason.val()) {
            state.finish_reason =
                BedrockLlmProvider::stopReasonToOpenAi(stop_reason);
        }
    }

    #! Returns incremental OpenAI tool-call deltas from native Converse events
    /** @param state the OpenAI-compatible stream state
        @param raw the native event delivered by @ref chatStream(), or a legacy completed response

        @return OpenAI-shaped tool starts and argument fragments with stable contiguous indices
        @throw LLM-ERROR a tool argument fragment arrived before its tool start
    */
    list<hash<auto>> getOpenAiToolCallDeltas(reference<hash<auto>> state,
            *hash<auto> raw) {
        list<hash<auto>> streamed = ();
        if (!raw) {
            return streamed;
        }
        if (raw.contentBlockStart.start.toolUse.typeCode() == NT_HASH) {
            hash<auto> tool_use = raw.contentBlockStart.start.toolUse;
            if (state.tool_calls.typeCode() != NT_LIST) {
                state.tool_calls = ();
            }
            int idx = state.tool_calls.size();
            state.bedrock_tool_indices{string(raw.contentBlockStart.contentBlockIndex)} = idx;
            hash<auto> tool_call = {
                "id": tool_use.toolUseId,
                "type": "function",
                "function": {"name": tool_use.name, "arguments": ""},
            };
            state.tool_calls += tool_call;
            return ({"index": idx} + tool_call,);
        }
        if (raw.contentBlockDelta.delta.toolUse.typeCode() == NT_HASH) {
            string block_index = string(raw.contentBlockDelta.contentBlockIndex);
            if (!exists state.bedrock_tool_indices{block_index}) {
                throw "LLM-ERROR", "Bedrock tool delta arrived before its contentBlockStart";
            }
            int idx = state.bedrock_tool_indices{block_index};
            string args = raw.contentBlockDelta.delta.toolUse.input;
            state.tool_calls[idx].function.arguments += args;
            return ({"index": idx, "function": {"arguments": args}},);
        }
        foreach auto block in (raw.output.message.content ?? ()) {
            if (block.typeCode() != NT_HASH
                    || block.toolUse.typeCode() != NT_HASH) {
                continue;
            }
            if (state.tool_calls.typeCode() != NT_LIST) {
                state.tool_calls = ();
            }
            hash<auto> tool_use = cast<hash>(block.toolUse);
            int idx = state.tool_calls.size();
            hash<auto> tool_call = {
                "id": tool_use.toolUseId,
                "type": "function",
                "function": {
                    "name": tool_use.name,
                    "arguments": make_json(tool_use.input ?? {}),
                },
            };
            state.tool_calls += tool_call;
            streamed += {"index": idx} + tool_call;
        }
        return streamed;
    }

    #! Maps a Converse stop reason to an OpenAI finish reason
    private static string stopReasonToOpenAi(string stop_reason) {
        switch (stop_reason) {
            case "tool_use":
                return "tool_calls";
            case "max_tokens":
                return "length";
            case "content_filtered":
            case "guardrail_intervened":
                return "content_filter";
            default:
                return "stop";
        }
    }

    #! Returns the configured (or default) Bedrock model ID
    string getBedrockModelId(*hash<QoreLlmUtils::LlmRequestOptions> opts) {
        return getRequestModel(opts);
    }

    #! Builds a Bedrock Converse request body from the provider-neutral inputs
    private:internal hash<auto> buildConverseBody(
            list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts,
            *string extra_system_prompt,
            *hash<auto> output_schema) {
        list<hash<auto>> wire_messages = ();
        list<hash<auto>> system_blocks = ();

        if (extra_system_prompt.val()) {
            push system_blocks, {"text": extra_system_prompt};
        }

        foreach hash<QoreLlmUtils::ChatMessage> msg in (messages) {
            if (msg.role == "system") {
                if (msg.content.val()) {
                    push system_blocks, {"text": msg.content};
                }
                continue;
            }

            list<hash<auto>> content_blocks = ();
            if (msg.role == "tool") {
                push content_blocks, {
                    "toolResult": {
                        "toolUseId": msg.tool_call_id
                            ?? msg.name ?? "tool_result",
                        "content": ({"text": msg.content ?? ""},),
                    },
                };
                push wire_messages, {"role": "user", "content": content_blocks};
                continue;
            }

            if (msg.content_parts) {
                foreach hash<QoreLlmUtils::ContentPart> part
                        in (msg.content_parts) {
                    if (part.type == "image" && part.data) {
                        push content_blocks, {
                            "image": {
                                "format": BedrockLlmProvider::mimeToBedrockImageFormat(
                                    part.mime_type),
                                "source": {"bytes": part.data},
                            },
                        };
                    } else if (part.type == "file" && part.data) {
                        push content_blocks, {
                            "document": {
                                "format": BedrockLlmProvider::mimeToBedrockDocFormat(
                                    part.mime_type),
                                "name": part.filename ?? "attachment",
                                "source": {"bytes": part.data},
                            },
                        };
                    } else if (part.type == "text" && part.text.val()) {
                        push content_blocks, {"text": part.text};
                    }
                }
            } else if (msg.content.val()) {
                push content_blocks, {"text": msg.content};
            }

            if (msg.role == "assistant" && msg.tool_calls) {
                foreach hash<QoreLlmUtils::ChatToolCall> tc
                        in (msg.tool_calls) {
                    push content_blocks, {
                        "toolUse": {
                            "toolUseId": tc.id,
                            "name": tc.name,
                            "input": tc.arguments ?? {},
                        },
                    };
                }
            }

            if (!content_blocks) {
                content_blocks = ({"text": ""},);
            }
            push wire_messages, {
                "role": msg.role == "assistant" ? "assistant" : "user",
                "content": content_blocks,
            };
        }

        hash<auto!> body = {
            "messages": wire_messages,
            "inferenceConfig": {
                "maxTokens": getRequestMaxOutputTokens(opts),
                "temperature": getRequestTemperature(opts),
            },
        };
        if (system_blocks) {
            body.system = system_blocks;
        }

        if (tools && tools.size()) {
            list<hash<auto>> tool_specs = ();
            foreach hash<QoreLlmUtils::ToolDefinition> td in (tools) {
                push tool_specs, {
                    "toolSpec": {
                        "name": td.name,
                        "description": td.description ?? "",
                        "inputSchema": {
                            "json": td.parameters
                                ?? {"type": "object", "properties": {}},
                        },
                    },
                };
            }
            body.toolConfig = {"tools": tool_specs};
        }

        if (output_schema) {
            # Bedrock Converse does not have a native response_format field;
            # callers wanting strict JSON should use a tool with a single
            # required structured-output tool.  For v1 we surface the schema
            # to the model as a system-prompt hint.
            push system_blocks, {
                "text": "Respond with JSON matching the following schema: "
                    + make_json(output_schema),
            };
            body.system = system_blocks;
        }

        return mergeRequestBodyOptions(body, opts);
    }

    #! Posts a Converse request and returns the deserialized response
    private:internal hash<auto> postConverse(hash<auto> body,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();
        string path = sprintf("/model/%s/converse",
            encode_url(getBedrockModelId(opts), True));
        try {
            return withRetry(hash<auto> sub () {
                return rest_client.restDoEncodedRawRequest("POST", path, binary(make_json(body)),
                    {"Content-Type": MimeTypeJson, "Accept": MimeTypeJson});
            }, opts);
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR",
                sprintf("Bedrock Converse request to %y failed: %s",
                    path, ex.desc), ex;
        }
    }

    #! Parses a Bedrock Converse response into the provider-neutral shape
    private:internal hash<QoreLlmUtils::ChatResponse> parseConverseResponse(
            hash<auto> body, *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        hash<auto> out_msg = body.output.message ?? {};
        list<string> text_parts = ();
        *list<hash<QoreLlmUtils::ChatToolCall>> tool_calls;
        foreach hash<auto> block in (out_msg.content ?? ()) {
            if (block.text.val()) {
                push text_parts, block.text;
            } else if (block.toolUse) {
                if (!tool_calls) {
                    tool_calls = ();
                }
                push tool_calls, <QoreLlmUtils::ChatToolCall>{
                    "id": block.toolUse.toolUseId,
                    "name": block.toolUse.name,
                    "arguments": block.toolUse.input ?? {},
                };
            }
        }
        return <QoreLlmUtils::ChatResponse>{
            "id": body.requestId ?? body.responseMetadata.requestId,
            "model": getBedrockModelId(opts),
            "stop_reason": BedrockLlmProvider::mapStopReason(body.stopReason,
                tool_calls),
            "content": text_parts ? text_parts.join("") : NOTHING,
            "tool_calls": tool_calls,
            "usage": normalizeUsage(body.usage),
            "raw": body,
        };
    }

    #! Extracts concatenated text from a Bedrock Converse response body
    private:internal string extractConverseText(hash<auto> body) {
        list<string> parts = ();
        foreach hash<auto> block in (body.output.message.content ?? ()) {
            if (block.text.val()) {
                push parts, block.text;
            }
        }
        return parts.join("");
    }

    #! Maps Bedrock \c usage to the OpenAI-style counters
    private:internal hash<auto> normalizeUsage(*hash<auto> usage) {
        if (!usage) {
            return {};
        }
        int prompt_tokens = usage.inputTokens ?? 0;
        int completion_tokens = usage.outputTokens ?? 0;
        return {
            "prompt_tokens": prompt_tokens,
            "completion_tokens": completion_tokens,
            "total_tokens": usage.totalTokens
                ?? (prompt_tokens + completion_tokens),
            "input_tokens": prompt_tokens,
            "output_tokens": completion_tokens,
        };
    }

    #! Maps Bedrock \c stopReason values to the QoreLlmUtils stop-reason vocabulary
    private:internal static string mapStopReason(*string reason,
            *list<hash<QoreLlmUtils::ChatToolCall>> tool_calls) {
        switch (reason) {
            case "end_turn":         return "end_turn";
            case "tool_use":         return "tool_use";
            case "max_tokens":       return "max_tokens";
            case "stop_sequence":    return "stop_sequence";
            case "content_filtered": return "content_filter";
            case "guardrail_intervened": return "content_filter";
            default:
                return tool_calls ? "tool_use" : (reason ?? "end_turn");
        }
    }

    #! Returns a Bedrock image-block format string from a MIME type
    private:internal static string mimeToBedrockImageFormat(*string mime) {
        switch (mime ?? "image/png") {
            case "image/png":  return "png";
            case "image/jpeg": case "image/jpg": return "jpeg";
            case "image/gif":  return "gif";
            case "image/webp": return "webp";
            default:           return "png";
        }
    }

    #! Returns a Bedrock document-block format string from a MIME type
    private:internal static string mimeToBedrockDocFormat(*string mime) {
        switch (mime) {
            case "application/pdf":  return "pdf";
            case "text/csv":         return "csv";
            case "text/html":        return "html";
            case "text/plain":       return "txt";
            case "text/markdown":    return "md";
            case "application/vnd.openxmlformats-officedocument.wordprocessingml.document":
                return "docx";
            case "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet":
                return "xlsx";
            default:                 return "pdf";
        }
    }

    #! Resolves the AWS region from LlmBackendConfig
    private:internal static string resolveRegion(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        *string region = config.provider_options.aws_region
            ?? (config.url.val() ? BedrockLlmProvider::regionFromUrl(config.url)
                : NOTHING);
        if (!region.val()) {
            *string env_region = getenv("AWS_REGION") ?? getenv("AWS_DEFAULT_REGION");
            if (env_region.val()) {
                region = env_region;
            }
        }
        if (!region.val()) {
            throw "LLM-CONFIG-ERROR",
                "BedrockLlmProvider requires an AWS region — set "
                "provider_options.aws_region, supply a region-qualified url, "
                "or set AWS_REGION / AWS_DEFAULT_REGION in the environment";
        }
        return region;
    }

    #! Extracts a region segment from a Bedrock runtime URL (best-effort)
    /** the extraction operator yields @ref nothing when the URL does not match,
        so the target must be nullable; a non-nullable \c list<string> made a
        non-matching URL raise \c RUNTIME-TYPE-ERROR instead of returning
        @ref nothing, which defeated the region fallbacks in
        @ref resolveRegion()
    */
    private:internal static *string regionFromUrl(string url) {
        *list<string> m = (url =~ x/bedrock-runtime\.([^\.]+)\.amazonaws\.com/);
        return m ? m[0] : NOTHING;
    }

    #! Lazy-builds the AwsRestClientIo
    private:internal ensureRestClient() {
        if (!rest_client) {
            rest_mutex.lock();
            on_exit rest_mutex.unlock();
            if (!rest_client) {
                string region = BedrockLlmProvider::resolveRegion(getConfig());
                hash<auto!> opts;
                opts.url = getConfig().url
                    ?? "https://" + sprintf(BedrockRuntimeHostPattern, region);
                opts.aws_region = region;
                opts.aws_service = BedrockService;
                # forward optional credential knobs from provider_options
                foreach string key in (("aws_keyid", "aws_secret", "aws_token",
                        "aws_role_arn", "aws_role_session_name",
                        "aws_external_id", "aws_imds_disabled",
                        "aws_imds_url", "aws_sts_endpoint")) {
                    if (exists getConfig().provider_options{key}) {
                        opts{key} = getConfig().provider_options{key};
                    }
                }
                opts.request_timeout = getConfig().timeout_ms;
                opts.connect_timeout = getConfig().connect_timeout_ms;
                rest_client = new BedrockRestClientIo(opts);
            }
        }
    }
}

#! Factory for @ref BedrockLlmProvider
public class BedrockLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "bedrock";
    }

    string getDisplayName() {
        return "AWS Bedrock (Converse API)";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new BedrockLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": False,  # no native response_format in Converse
            "supports_multimodal": True,
        };
    }
}

#! Bedrock embedder — supports Titan (amazon.titan-embed-text-*) and Cohere
/** Uses Bedrock's \c InvokeModel for embedding requests; the body shape
    differs by model family so callers must select an appropriate model.

    @par Configuration

    - \c model (required): the Bedrock embedding model ID, e.g.
      \c "amazon.titan-embed-text-v2:0" or \c "cohere.embed-english-v3"
    - \c options.aws_region (recommended)
    - \c options.aws_keyid / .aws_secret / .aws_token: optional static creds
*/
public class BedrockEmbedder inherits QoreRagUtils::AbstractEmbedder {
    public {
        const TitanV2DefaultDimension = 1024;
    }

    private {
        hash<QoreRagUtils::EmbedderConfig> config;
        *AwsRestClient::AwsRestClientIo rest_client;
        Mutex rest_mutex();
        *int cached_dimension;
    }

    constructor(hash<QoreRagUtils::EmbedderConfig> config) {
        if (!config.model.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "BedrockEmbedder requires 'model' in EmbedderConfig (the "
                "Bedrock model ID, e.g. amazon.titan-embed-text-v2:0)";
        }
        self.config = config;
        if (exists config.options.dimension) {
            cached_dimension = config.options.dimension;
        }
    }

    list<float> encode(string text, *hash<auto> opts) {
        ensureRestClient();
        hash<auto> body = BedrockEmbedder::buildEmbedBody(config.model, text);
        string path = sprintf("/model/%s/invoke",
            encode_url(config.model, True));
        hash<auto> resp;
        try {
            resp = rest_client.restDoEncodedRawRequest("POST", path, binary(make_json(body)),
                {"Content-Type": MimeTypeJson, "Accept": MimeTypeJson});
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-ERROR",
                sprintf("Bedrock InvokeModel embed request for %y failed: %s",
                    config.model, ex.desc), ex;
        }
        list<float> v = BedrockEmbedder::extractEmbedding(config.model, resp.body);
        if (!cached_dimension && v) {
            cached_dimension = v.size();
        }
        return v;
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }
        # Titan invoke is single-text; Cohere supports batch.  For simplicity
        # we sequentialize here; future work can switch Cohere to its native
        # batch call.
        list<list<float>> rv = ();
        foreach string t in (texts) {
            push rv, encode(t, opts);
        }
        return rv;
    }

    int getDimension() {
        if (cached_dimension) {
            return cached_dimension;
        }
        # probe with a tiny embed call
        encode(" ");
        return cached_dimension ?? TitanV2DefaultDimension;
    }

    *string getModel() {
        return config.model;
    }

    private:internal ensureRestClient() {
        if (!rest_client) {
            rest_mutex.lock();
            on_exit rest_mutex.unlock();
            if (!rest_client) {
                *string region = config.options.aws_region
                    ?? getenv("AWS_REGION") ?? getenv("AWS_DEFAULT_REGION");
                if (!region.val()) {
                    throw "EMBEDDER-CONFIG-ERROR",
                        "BedrockEmbedder requires an AWS region — set "
                        "options.aws_region or AWS_REGION in the environment";
                }
                hash<auto!> opts;
                opts.url = config.url
                    ?? "https://" + sprintf(BedrockRuntimeHostPattern, region);
                opts.aws_region = region;
                opts.aws_service = BedrockService;
                foreach string key in (("aws_keyid", "aws_secret", "aws_token",
                        "aws_role_arn", "aws_imds_disabled", "aws_imds_url")) {
                    if (exists config.options{key}) {
                        opts{key} = config.options{key};
                    }
                }
                rest_client = new AwsRestClient::AwsRestClientIo(opts);
            }
        }
    }

    private:internal static hash<auto> buildEmbedBody(string model, string text) {
        if (model =~ /^amazon\.titan-embed/) {
            return {"inputText": text};
        }
        if (model =~ /^cohere\.embed/) {
            return {
                "texts": (text,),
                "input_type": "search_document",
            };
        }
        # default to Titan-shaped body
        return {"inputText": text};
    }

    private:internal static list<float> extractEmbedding(string model,
            hash<auto> body) {
        if (model =~ /^amazon\.titan-embed/) {
            return body.embedding ?? ();
        }
        if (model =~ /^cohere\.embed/) {
            # Cohere returns embeddings as a list of vectors
            list<list<float>> embeddings = body.embeddings ?? ();
            return embeddings ? embeddings[0] : ();
        }
        return body.embedding ?? ();
    }
}

#! Factory for @ref BedrockEmbedder
public class BedrockEmbedderFactory inherits QoreRagUtils::AbstractEmbedderFactory {
    string getType() {
        return "bedrock";
    }

    string getDisplayName() {
        return "AWS Bedrock embedder (Titan + Cohere)";
    }

    QoreRagUtils::AbstractEmbedder create(hash<QoreRagUtils::EmbedderConfig> config) {
        return new BedrockEmbedder(config);
    }
}
}
