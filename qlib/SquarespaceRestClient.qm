# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module SquarespaceRestClient {
    version = "1.0";
    desc = "User module for calling Squarespace Commerce REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("squarespaceres",
            SquarespaceRestConnection::ConnectionScheme);
    };
}

/** @mainpage SquarespaceRestClient Module

    @tableofcontents

    @section squarespacerestclientintro SquarespaceRestClient Introduction

    The %SquarespaceRestClient module provides an API for calling Squarespace Commerce REST API
    services.

    To use this module, use \c "%requires SquarespaceRestClient" in your code.

    All the public symbols in the module are defined in the SquarespaceRestClient namespace.

    The main classes are:
    - @ref SquarespaceRestClient::SquarespaceRestClient "SquarespaceRestClient":
      this class provides the REST client API for communication with the Squarespace Commerce API;
      it handles OAuth2 authentication
    - @ref SquarespaceRestClient::SquarespaceRestConnection "SquarespaceRestConnection":
      provides a connection object to Squarespace services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires SquarespaceRestClient

SquarespaceRestClient squarespace({
    "oauth2_client_id": ENV.SQUARESPACE_CLIENT_ID,
    "oauth2_client_secret": ENV.SQUARESPACE_CLIENT_SECRET,
    "oauth2_refresh_token": ENV.SQUARESPACE_REFRESH_TOKEN,
});
hash<auto> result = squarespace.get("1.0/authorization/website");
printf("Site: %s\n", result.body.website.siteTitle);
    @endcode

    @section squarespacerestclientrelnotes Release Notes

    @subsection squarespacerestclientv1_0 SquarespaceRestClient v1.0
    - the initial version of the %SquarespaceRestClient module
*/

#! the SquarespaceRestClient namespace contains all the objects in the SquarespaceRestClient module
public namespace SquarespaceRestClient {

#! Common base class for SquarespaceRestClient functionality
public class SquarespaceRestClientBase {
    public {
        #! Default Squarespace API URL (no version - mixed API versions)
        const DefaultUrl = "https://api.squarespace.com";

        #! Default authorization request URL
        const DefaultAuthUrl = "https://login.squarespace.com/api/1/login/oauth/provider/authorize";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default token request URL
        const DefaultTokenUrl = "https://login.squarespace.com/api/1/login/oauth/provider/tokens";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (no leading slash - base URL has no path component)
        const DefaultPingPath = "1.0/authorization/website";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default OAuth2 scopes
        const DefaultScopes = (
            "website.orders",
            "website.products",
            "website.inventory",
            "website.transactions.read",
        );

        #! Default OAuth2 auth args to request offline access (refresh tokens)
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "headers": DefaultHeaders,
            "oauth2_auth_args": DefaultAuthArgs,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "url": DefaultUrl,
        };

        #! OAuth2 options (added when OAuth2 credentials are provided)
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_scopes": DefaultScopes,
            "oauth2_scope_separator_char": ",",
            "oauth2_token_use_basic_auth": True,
        };
    }

    #! returns options for @ref SquarespaceRestClient::SquarespaceRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Check if token-only mode (token provided without OAuth2 credentials)
        bool token_only = opts.token && !opts.oauth2_client_id && !opts.oauth2_client_secret
            && !opts.oauth2_refresh_token;

        if (!token_only && opts.oauth2_client_id) {
            rv += OAuth2Options;
        } else if (opts.token) {
            # Bearer token mode
            rv.headers.Authorization = "Bearer " + opts.token;
            # Remove token from opts so RestClient doesn't add another "Bearer" prefix
            remove rv.token;
        }

        return rv;
    }
}

#! This class provides the REST client API for communication with Squarespace servers
/** Squarespace uses a REST API at https://api.squarespace.com with OAuth2 authentication.
    The API uses mixed versioning: Orders/Inventory/Transactions use v1.0, Products use v2.
    Version is embedded in paths (e.g., 1.0/commerce/orders, v2/commerce/products).

    @par Authentication:
    - OAuth2 with Bearer tokens
    - Access tokens expire after 30 minutes
    - Refresh tokens expire after 7 days (rolling)
    - Token endpoint uses Basic auth (base64 client_id:client_secret)
*/
public class SquarespaceRestClient inherits RestClient::RestClient, SquarespaceRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
SquarespaceRestClient squarespace({
    "oauth2_client_id": "your-client-id",
    "oauth2_client_secret": "your-client-secret",
    "oauth2_refresh_token": "your-refresh-token",
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(SquarespaceRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Squarespace REST connections; returns @ref SquarespaceRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref SquarespaceRestClient::SquarespaceRestClient::constructor() for more information on the above options
*/
public class SquarespaceRestConnection inherits RestClient::RestConnection {
    public {
        #! Default connection URL
        const DefaultConnectionUrl = "squarespaceres://api.squarespace.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Squarespace REST Connection",
            "short_desc": "A connection to the Squarespace Commerce REST API",
            "desc": "A connection to the Squarespace Commerce REST API for orders, products, "
                "inventory, and transactions",
            "cls": Class::forName("SquarespaceRestConnection"),
            "auto_url": True,
            "schemes": {
                "squarespaceres": True,
            },
            "base_scheme_map": {
                "https": "squarespaceres",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultPingPath,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultAuthArgs,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultScopes,
                },
                "oauth2_scope_separator_char": RestConnection::ConnectionScheme.options.oauth2_scope_separator_char
                + <ConnectionOptionInfo>{
                    "default_value": ",",
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": SquarespaceRestClientBase::DefaultTokenUrl,
                },
                "oauth2_token_use_basic_auth": RestConnection::ConnectionScheme.options.oauth2_token_use_basic_auth
                + <ConnectionOptionInfo>{
                    "default_value": True,
                },
            },
            "required_options": "oauth2_client_id,oauth2_client_secret",
        };
    }

    #! creates the SquarespaceRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = SquarespaceRestClientBase::DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the SquarespaceRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
    }

    #! returns \c "squarespaceres"
    string getType() {
        return "squarespaceres";
    }

    #! Returns connection options
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        # Always set OAuth2 URLs (single region, no domain variation)
        rv.oauth2_auth_url = SquarespaceRestClientBase::DefaultAuthUrl;
        rv.oauth2_token_url = SquarespaceRestClientBase::DefaultTokenUrl;
        if (!rv.oauth2_grant_type) {
            rv.oauth2_grant_type = SquarespaceRestClientBase::DefaultGrantType;
        }
        if (!rv.oauth2_scopes) {
            rv.oauth2_scopes = SquarespaceRestClientBase::DefaultScopes;
        }
        if (!rv.oauth2_auth_args) {
            rv.oauth2_auth_args = SquarespaceRestClientBase::DefaultAuthArgs;
        }
        if (!rv.oauth2_scope_separator_char) {
            rv.oauth2_scope_separator_char = ",";
        }
        return rv;
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Squarespace";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the SquarespaceDataProvider and creates
        # the data provider object dynamically
        load_module("SquarespaceDataProvider");
        return create_object("SquarespaceDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != DefaultConnectionUrl) {
                update.url = DefaultConnectionUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref SquarespaceRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref SquarespaceRestClient object
    */
    private SquarespaceRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new SquarespaceRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since SquarespaceRestClient 1.1
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new SquarespaceRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Squarespace REST API using multiplexed HTTP connections
/** @see SquarespaceRestClient for more information
*/
public class SquarespaceRestClientIo inherits RestClientIo::RestClientIo, SquarespaceRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(SquarespaceRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
