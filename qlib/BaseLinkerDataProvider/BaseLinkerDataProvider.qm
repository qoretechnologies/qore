# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) DataProvider
%requires(reexport) BaseLinkerRestClient
%requires RestClientIo
%requires json
%requires Util
%requires Logger
%requires Mime

module BaseLinkerDataProvider {
    version = "1.0";
    desc = "BaseLinker e-commerce multichannel integration data provider";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new BaseLinkerDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": BaseLinkerDataProvider::AppName,
            "display_name": BaseLinkerDataProvider::AppDisplayName,
            "short_desc": "BaseLinker multichannel e-commerce integration",
            "desc": "BaseLinker is a Polish multichannel e-commerce platform that unifies orders, "
                "inventory, shipping labels, and courier packages across marketplaces such as "
                "Allegro, Amazon, eBay, and Shopify.\n\n"
                "**Features:**\n"
                "- Manage orders across all connected marketplaces and shops\n"
                "- Update order statuses, payments, and line items\n"
                "- Handle order returns with refunds\n"
                "- Maintain inventory catalogs, products, stock levels, and prices\n"
                "- Create courier packages and retrieve shipping labels\n"
                "- Poll BaseLinker's journal for event-based workflow triggers\n\n"
                "**Authentication:**\n"
                "BaseLinker uses a static API token passed in the `X-BLToken` HTTP header. "
                "Tokens can be generated in the BaseLinker panel under "
                "*My Account → API → Generate a new token*.\n\n"
                "**Rate limit:** 100 requests per minute per token. The module retries "
                "rate-limited calls with exponential backoff (up to 3 attempts).",
            "scheme": "baselinkerrest",
            "logo": BaseLinkerDataProvider::BaseLinkerLogo,
            "logo_file_name": "baselinker-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Ecommerce,),
        });

        # ============================================================
        # ORDERS
        # ============================================================

        # List Orders
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/orders",
            "action": "list-orders",
            "groups": "Orders",
            "display_name": "List Orders",
            "short_desc": "List BaseLinker orders with cursor pagination",
            "desc": "Returns a stream of BaseLinker orders via `getOrders`. Supports cursor "
                "pagination through `id_from`/`date_from` and filters by status, email, and "
                "source channel. Page size is fixed by BaseLinker at 100 orders per call.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerOrdersDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("OrdersList", new BaseLinkerOrderDataType(), True);
            },
        });

        # Get Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/orders",
            "action": "get-order",
            "groups": "Orders",
            "display_name": "Get Order",
            "short_desc": "Get a single order by ID",
            "desc": "Retrieve a single BaseLinker order by its `order_id` via `getOrders`.",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "BaseLinker order identifier",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "orders",
                },
            },
        });

        # Add Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/add-order",
            "action": "add-order",
            "groups": "Orders",
            "display_name": "Add Order",
            "short_desc": "Create a new order",
            "desc": "Create a new order in BaseLinker via `addOrder`. Returns the new "
                "`order_id` on success.",
            "action_code": DPAT_API,
            "action_val": "addOrder",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerAddOrderRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # Set Order Fields
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/set-order-fields",
            "action": "set-order-fields",
            "groups": "Orders",
            "display_name": "Set Order Fields",
            "short_desc": "Update fields on an existing order",
            "desc": "Update one or more fields on an existing BaseLinker order via "
                "`setOrderFields`. Only supplied fields are modified.",
            "action_code": DPAT_API,
            "action_val": "setOrderFields",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerSetOrderFieldsRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # Set Order Status
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/set-order-status",
            "action": "set-order-status",
            "groups": "Orders",
            "display_name": "Set Order Status",
            "short_desc": "Change the status of an order",
            "desc": "Change the status of a BaseLinker order via `setOrderStatus`. The new "
                "`status_id` must be one of the statuses configured in BaseLinker.",
            "action_code": DPAT_API,
            "action_val": "setOrderStatus",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerSetOrderStatusRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # Set Order Payment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/set-order-payment",
            "action": "set-order-payment",
            "groups": "Orders",
            "display_name": "Set Order Payment",
            "short_desc": "Record a payment against an order",
            "desc": "Record a payment for a BaseLinker order via `setOrderPayment`.",
            "action_code": DPAT_API,
            "action_val": "setOrderPayment",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerSetOrderPaymentRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # Delete Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/delete-order",
            "action": "delete-order",
            "groups": "Orders",
            "display_name": "Delete Order",
            "short_desc": "Delete one or more orders",
            "desc": "Delete a BaseLinker order (or list of orders) via `deleteOrders`.",
            "action_code": DPAT_API,
            "action_val": "deleteOrders",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerDeleteOrdersRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # ============================================================
        # ORDER PRODUCTS (Line Items)
        # ============================================================

        # Add Order Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/add-order-product",
            "action": "add-order-product",
            "groups": "Orders / Line Items",
            "display_name": "Add Order Product",
            "short_desc": "Add a product line to an order",
            "desc": "Add a product line item to an existing BaseLinker order via "
                "`addOrderProduct`.",
            "action_code": DPAT_API,
            "action_val": "addOrderProduct",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerAddOrderProductRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # Set Order Product Fields — order_id drives order_product_id dropdown;
        # mark with has_dependents/on_change (not propagated by getActionOptionFromFields).
        {
            hash<string, hash<ActionOptionInfo>> opts =
                DataProviderActionCatalog::getActionOptionFromFields(
                    BaseLinkerSetOrderProductFieldsRequestDataType::Fields);
            opts.order_id += {"has_dependents": True, "on_change": ("refetch",)};
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": BaseLinkerDataProvider::AppName,
                "path": "/set-order-product-fields",
                "action": "set-order-product-fields",
                "groups": "Orders / Line Items",
                "display_name": "Set Order Product Fields",
                "short_desc": "Update a product line on an order",
                "desc": "Update fields on a specific product line of a BaseLinker order via "
                    "`setOrderProductFields`.",
                "action_code": DPAT_API,
                "action_val": "setOrderProductFields",
                "options": opts,
                "get_output_type": AbstractDataProviderType sub () {
                    return new BaseLinkerSuccessIdResponseDataType();
                },
            });
        }

        # Delete Order Product — order_id drives order_product_id dropdown.
        {
            hash<string, hash<ActionOptionInfo>> opts =
                DataProviderActionCatalog::getActionOptionFromFields(
                    BaseLinkerDeleteOrderProductRequestDataType::Fields);
            opts.order_id += {"has_dependents": True, "on_change": ("refetch",)};
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": BaseLinkerDataProvider::AppName,
                "path": "/delete-order-product",
                "action": "delete-order-product",
                "groups": "Orders / Line Items",
                "display_name": "Delete Order Product",
                "short_desc": "Remove a product line from an order",
                "desc": "Remove a product line from a BaseLinker order via `deleteOrderProduct`.",
                "action_code": DPAT_API,
                "action_val": "deleteOrderProduct",
                "options": opts,
                "get_output_type": AbstractDataProviderType sub () {
                    return new BaseLinkerSuccessIdResponseDataType();
                },
            });
        }

        # ============================================================
        # ORDER RETURNS
        # ============================================================

        # List Order Returns
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/order-returns",
            "action": "list-order-returns",
            "groups": "Order Returns",
            "display_name": "List Order Returns",
            "short_desc": "List BaseLinker order returns",
            "desc": "Returns a stream of BaseLinker order returns via `getOrderReturns`. "
                "Supports cursor pagination through `id_from` and filters by status and "
                "confirmation date.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerOrderReturnsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("OrderReturnsList", new BaseLinkerOrderReturnDataType(),
                    True);
            },
        });

        # Get Order Return
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/order-returns",
            "action": "get-order-return",
            "groups": "Order Returns",
            "display_name": "Get Order Return",
            "short_desc": "Get a single order return by ID",
            "desc": "Retrieve a single BaseLinker order return by its `return_id`.",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "return_id": <ActionOptionInfo>{
                    "display_name": "Return ID",
                    "short_desc": "BaseLinker order return identifier",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "order_returns",
                },
            },
        });

        # Add Order Return
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/add-order-return",
            "action": "add-order-return",
            "groups": "Order Returns",
            "display_name": "Add Order Return",
            "short_desc": "Create a new order return",
            "desc": "Create a new BaseLinker order return via `addOrderReturn`. Returns the new "
                "`return_id` on success.",
            "action_code": DPAT_API,
            "action_val": "addOrderReturn",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerAddOrderReturnRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # Set Order Return Fields
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/set-order-return-fields",
            "action": "set-order-return-fields",
            "groups": "Order Returns",
            "display_name": "Set Order Return Fields",
            "short_desc": "Update fields on an existing order return",
            "desc": "Update one or more fields on a BaseLinker order return via "
                "`setOrderReturnFields`.",
            "action_code": DPAT_API,
            "action_val": "setOrderReturnFields",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerSetOrderReturnFieldsRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # Set Order Return Status
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/set-order-return-status",
            "action": "set-order-return-status",
            "groups": "Order Returns",
            "display_name": "Set Order Return Status",
            "short_desc": "Change the status of an order return",
            "desc": "Change the status of a BaseLinker order return via "
                "`setOrderReturnStatus`.",
            "action_code": DPAT_API,
            "action_val": "setOrderReturnStatus",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerSetOrderReturnStatusRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # Set Order Return Refund
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/set-order-return-refund",
            "action": "set-order-return-refund",
            "groups": "Order Returns",
            "display_name": "Set Order Return Refund",
            "short_desc": "Record a refund against an order return",
            "desc": "Record a refund on a BaseLinker order return via "
                "`setOrderReturnRefund`.",
            "action_code": DPAT_API,
            "action_val": "setOrderReturnRefund",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerSetOrderReturnRefundRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # ============================================================
        # INVENTORY
        # ============================================================

        # List Inventories
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/inventories",
            "action": "list-inventories",
            "groups": "Inventory",
            "display_name": "List Inventories",
            "short_desc": "List BaseLinker inventories (catalogs)",
            "desc": "List all BaseLinker inventories (catalogs) via `getInventories`.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerInventoriesDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("InventoryList", new BaseLinkerInventoryDataType(),
                    True);
            },
        });

        # List Inventory Products
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/inventory-products",
            "action": "list-inventory-products",
            "groups": "Inventory",
            "display_name": "List Inventory Products",
            "short_desc": "List products in a BaseLinker inventory",
            "desc": "List products in a BaseLinker inventory via "
                "`getInventoryProductsList`. Supports page-number pagination and filters by "
                "category, EAN, SKU, name, price range, and stock range.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerInventoryProductsDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("InventoryProductList",
                    new BaseLinkerInventoryProductDataType(), True);
            },
        });

        # Get Inventory Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/inventory-products",
            "action": "get-inventory-product",
            "groups": "Inventory",
            "display_name": "Get Inventory Product",
            "short_desc": "Get a single inventory product by ID",
            "desc": "Retrieve a single BaseLinker inventory product by its `product_id`.",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "inventory_id": <ActionOptionInfo>{
                    "display_name": "Inventory ID",
                    "short_desc": "BaseLinker inventory identifier",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "inventories",
                    "has_dependents": True,
                    "on_change": ("refetch",),
                },
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "BaseLinker inventory product identifier",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "inventory_products",
                    "depends_on": ("inventory_id",),
                },
            },
        });

        # Add Inventory Product (single upsert) — inventory_id drives the
        # product_id dropdown; mark it with has_dependents/on_change because
        # getActionOptionFromFields() does not propagate those keys.
        {
            hash<string, hash<ActionOptionInfo>> opts =
                DataProviderActionCatalog::getActionOptionFromFields(
                    BaseLinkerAddInventoryProductRequestDataType::Fields);
            opts.inventory_id += {"has_dependents": True, "on_change": ("refetch",)};
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": BaseLinkerDataProvider::AppName,
                "path": "/add-inventory-product",
                "action": "add-inventory-product",
                "groups": "Inventory",
                "display_name": "Add / Update Inventory Product",
                "short_desc": "Create or update a BaseLinker inventory product",
                "desc": "Upsert a BaseLinker inventory product via `addInventoryProduct`. Omit "
                    "`product_id` to create a new product; supply it (together with "
                    "`inventory_id`) to update an existing product.",
                "action_code": DPAT_API,
                "action_val": "addInventoryProduct",
                "options": opts,
                "get_output_type": AbstractDataProviderType sub () {
                    return new BaseLinkerSuccessIdResponseDataType();
                },
            });
        }

        # Delete Inventory Product
        {
            hash<string, hash<ActionOptionInfo>> opts =
                DataProviderActionCatalog::getActionOptionFromFields(
                    BaseLinkerDeleteInventoryProductRequestDataType::Fields);
            opts.inventory_id += {"has_dependents": True, "on_change": ("refetch",)};
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": BaseLinkerDataProvider::AppName,
                "path": "/delete-inventory-product",
                "action": "delete-inventory-product",
                "groups": "Inventory",
                "display_name": "Delete Inventory Product",
                "short_desc": "Delete a BaseLinker inventory product",
                "desc": "Delete a BaseLinker inventory product via `deleteInventoryProduct`.",
                "action_code": DPAT_API,
                "action_val": "deleteInventoryProduct",
                "options": opts,
                "get_output_type": AbstractDataProviderType sub () {
                    return new BaseLinkerSuccessIdResponseDataType();
                },
            });
        }

        # List Inventory Stock
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/inventory-stock",
            "action": "list-inventory-stock",
            "groups": "Inventory",
            "display_name": "List Inventory Stock",
            "short_desc": "List stock levels for inventory products",
            "desc": "List BaseLinker inventory product stock levels via "
                "`getInventoryProductsStock`. Each row contains a `product_id` keyed hash of "
                "warehouse → quantity.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerInventoryStockDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("InventoryStockList",
                    new BaseLinkerInventoryStockDataType(), True);
            },
        });

        # Update Inventory Stock (bulk)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/update-inventory-stock",
            "action": "update-inventory-stock",
            "groups": "Inventory",
            "display_name": "Update Inventory Stock",
            "short_desc": "Bulk update stock levels (up to 1000 products per call)",
            "desc": "Bulk-update BaseLinker inventory stock via "
                "`updateInventoryProductsStock`. Accepts up to 1000 product entries per call.",
            "action_code": DPAT_API,
            "action_val": "updateInventoryProductsStock",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerUpdateInventoryProductsStockRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # List Inventory Prices
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/inventory-prices",
            "action": "list-inventory-prices",
            "groups": "Inventory",
            "display_name": "List Inventory Prices",
            "short_desc": "List prices for inventory products",
            "desc": "List BaseLinker inventory product prices via "
                "`getInventoryProductsPrices`. Each row contains a `product_id` keyed hash of "
                "price-group → price.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerInventoryPricesDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("InventoryPriceList",
                    new BaseLinkerInventoryPriceDataType(), True);
            },
        });

        # Update Inventory Prices (bulk)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/update-inventory-prices",
            "action": "update-inventory-prices",
            "groups": "Inventory",
            "display_name": "Update Inventory Prices",
            "short_desc": "Bulk update prices (up to 1000 products per call)",
            "desc": "Bulk-update BaseLinker inventory prices via "
                "`updateInventoryProductsPrices`. Accepts up to 1000 product entries per "
                "call.",
            "action_code": DPAT_API,
            "action_val": "updateInventoryProductsPrices",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerUpdateInventoryProductsPricesRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
                return new BaseLinkerSuccessIdResponseDataType();
            },
        });

        # List Inventory Manufacturers
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/inventory-manufacturers",
            "action": "list-inventory-manufacturers",
            "groups": "Inventory",
            "display_name": "List Inventory Manufacturers",
            "short_desc": "List inventory manufacturers",
            "desc": "List BaseLinker inventory manufacturers via "
                "`getInventoryManufacturers`.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerInventoryManufacturersDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("InventoryManufacturerList",
                    new BaseLinkerInventoryManufacturerDataType(), True);
            },
        });

        # List Inventory Categories
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/inventory-categories",
            "action": "list-inventory-categories",
            "groups": "Inventory",
            "display_name": "List Inventory Categories",
            "short_desc": "List inventory categories",
            "desc": "List BaseLinker inventory categories via `getInventoryCategories`. "
                "When `inventory_id` is supplied, results are scoped to that catalog.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerInventoryCategoriesDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("InventoryCategoryList",
                    new BaseLinkerInventoryCategoryDataType(), True);
            },
        });

        # ============================================================
        # SHIPPING
        # ============================================================

        # List Order Packages
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/order-packages",
            "action": "list-order-packages",
            "groups": "Shipping",
            "display_name": "List Order Packages",
            "short_desc": "List courier packages for an order",
            "desc": "List courier packages (shipments) associated with a BaseLinker order "
                "via `getOrderPackages`.",
            "action_code": DPAT_FIND,
            "data_provider_info": BaseLinkerCourierPackagesDataProvider::ProviderInfo,
            "get_output_type": AbstractDataProviderType sub () {
                return new ListDataType("CourierPackageList",
                    new BaseLinkerCourierPackageDataType(), True);
            },
        });

        # Add Package — courier_code drives account_id dropdown; mark with
        # has_dependents/on_change (not propagated by getActionOptionFromFields).
        {
            hash<string, hash<ActionOptionInfo>> opts =
                DataProviderActionCatalog::getActionOptionFromFields(
                    BaseLinkerCreatePackageRequestDataType::Fields);
            opts.courier_code += {"has_dependents": True, "on_change": ("refetch",)};
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": BaseLinkerDataProvider::AppName,
                "path": "/add-package",
                "action": "add-package",
                "groups": "Shipping",
                "display_name": "Add Courier Package",
                "short_desc": "Create a courier package (shipment)",
                "desc": "Create a courier package for a BaseLinker order via `createPackage`. "
                    "Returns the courier package identifier on success.",
                "action_code": DPAT_API,
                "action_val": "createPackage",
                "options": opts,
                "get_output_type": AbstractDataProviderType sub () {
                    return new BaseLinkerSuccessIdResponseDataType();
                },
            });
        }

        # Get Label
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": BaseLinkerDataProvider::AppName,
            "path": "/get-label",
            "action": "get-label",
            "groups": "Shipping",
            "display_name": "Get Courier Label",
            "short_desc": "Retrieve a shipping label",
            "desc": "Retrieve a shipping label for a courier package via `getLabel`. "
                "The label is returned as a base64-encoded blob (typically a PDF).",
            "action_code": DPAT_API,
            "action_val": "getLabel",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                BaseLinkerGetLabelRequestDataType::Fields),
            "get_output_type": AbstractDataProviderType sub () {
