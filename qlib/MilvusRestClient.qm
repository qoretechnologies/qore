%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes

module MilvusRestClient {
    version = "1.0";
    desc = "user module for calling Milvus / Zilliz Cloud REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("milvus",
            MilvusRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("milvuss", MilvusRestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerVectorStoreFactory(
            new MilvusVectorStoreFactory());
    };
}

/** @mainpage MilvusRestClient Module

    @tableofcontents

    @section milvusrestclientintro MilvusRestClient Introduction

    The %MilvusRestClient module provides a REST client for
    <a href="https://milvus.io">Milvus</a> and <a href="https://zilliz.com">Zilliz Cloud</a>
    (managed Milvus) — and registers <tt>milvus</tt> as a vector-store backend
    in @ref qoreragutilsintro "QoreRagUtils".

    Targets Milvus REST v2 only — gRPC is intentionally NOT used.

    @section MilvusRestClientRelnotes Release Notes

    @subsection MilvusRestClientv1_0 MilvusRestClient v1.0
    - initial release
*/

%requires json

public namespace MilvusRestClient {
public class MilvusRestClientBase {
    public {
        const DefaultUrl = "http://localhost:19530";
        const DefaultApiVersion = "v2/vectordb";

        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;
        if (opts.api) {
            rv.default_path = "/" + opts.api;
        }
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Milvus (sync)
public class MilvusRestClient inherits RestClient::RestClient, MilvusRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(MilvusRestClientBase::getOptions(opts), True) {
    }
}

#! REST client for Milvus using multiplexed HTTP connections (async)
public class MilvusRestClientIo inherits RestClientIo::RestClientIo, MilvusRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(MilvusRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Milvus REST connections
public class MilvusRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "milvus://localhost:19530";

        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation("MilvusRestClient",
            "MilvusRestConnection", "en", <ConnectionSchemeInfo>{
            "display_name": "Milvus Vector DB Connection",
            "short_desc": "A connection to a Milvus / Zilliz Cloud vector database",
            "desc": "A connection to a [Milvus](https://milvus.io) or "
                "[Zilliz Cloud](https://zilliz.com) (managed Milvus) vector database via "
                "the REST v2 API.\n\n"
                "Authentication: Bearer token (Milvus / Zilliz token).\n\n"
                "The connection uses the `milvus://` URL scheme for plain HTTP and "
                "`milvuss://` for servers behind TLS.",
            "cls": Class::forName("MilvusRestConnection"),
            # Milvus is self-hosted: the server URL must be supplied by the user; with auto_url the URL is
            # generated from options, and as there is no host option, it fell back to "milvus://localhost"
            "auto_url": False,
            "schemes": {"milvus": True, "milvuss": True},
            # a single scheme for both transports would make the reverse lookup in getRealUrl() ambiguous
            "base_scheme_map": {"http": "milvus", "https": "milvuss"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Milvus / Zilliz token (Bearer)",
                    "type": "string",
                    "desc": "Bearer token.  For local Milvus this is the `<user>:<password>` "
                        "auth combo; for Zilliz Cloud it's the cluster API key.",
                    "sensitive": True,
                    "preselected": True,
                },
            },
        });
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "milvus";
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("MilvusDataProvider");
        return create_object("MilvusDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private MilvusRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new MilvusRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new MilvusRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return MilvusRestClientBase::getOptions(rv);
    }
}
}

public namespace QoreRagUtils {
#! Milvus / Zilliz-backed vector store via REST v2
/** @par Configuration

    @ref VectorStoreConfig fields:

    - \c collection (required): the Milvus collection name
    - \c url (optional): Milvus URL (default \c http://localhost:19530)
    - \c options.api_key (required): Bearer token
    - \c options.dimension (optional): vector dimension
    - \c options.id_field (optional): primary key field (default \c "id")
    - \c options.vector_field (optional): vector field name (default \c "vector")
*/
public class MilvusVectorStore inherits AbstractVectorStore {
    public {
        const Backend = "milvus";

        #! Largest <tt>offset + limit</tt> a Milvus query accepts
        const MaxQueryWindow = 16384;

        #! Entities fetched per query request by summarizeBy()
        const QueryPageSize = 1000;
    }

    private {
        hash<VectorStoreConfig> config;
        string coll_name;
        string id_field;
        string vector_field;
        *MilvusRestClient::MilvusRestClientIo rest_client;
        *int cached_dimension;
        Mutex init_mutex();
    }

    constructor(hash<VectorStoreConfig> config) {
        self.config = config;
        if (!config.collection.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "MilvusVectorStore requires 'collection' (Milvus collection name)";
        }
        if (!config.options.api_key.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "MilvusVectorStore requires 'options.api_key'";
        }
        init();
    }

    #! Creates the vector store with a pre-built REST client (for example a client with a custom transport)
    /** @param config the store configuration; \c options.api_key is not required because the client is supplied
        @param rest_client the Milvus REST client to use

        @throw VECTOR-STORE-CONFIG-ERROR \c collection is missing
    */
    constructor(hash<VectorStoreConfig> config, MilvusRestClient::MilvusRestClientIo rest_client) {
        self.config = config;
        if (!config.collection.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "MilvusVectorStore requires 'collection' (Milvus collection name)";
        }
        self.rest_client = rest_client;
        init();
    }

    private init() {
        coll_name = config.collection;
        id_field = config.options.id_field ?? "id";
        vector_field = config.options.vector_field ?? "vector";
        if (exists config.options.dimension) {
            cached_dimension = config.options.dimension;
        }
    }

    upsert(list<hash<VectorRecord>> records) {
        if (!records) {
            return;
        }
        ensureRestClient();
        # Milvus expects "data" as a list of hashes with field names mapped
        list<auto> data = map (
            (id_field): $1.id,
            (vector_field): $1.vector,
        ) + ($1.payload ?? {}), records;
        hash<auto!> body;
        body.collectionName = coll_name;
        body.data = data;
        rest_client.restPost("/entities/upsert", body);
        if (!exists cached_dimension && records[0].vector) {
            cached_dimension = records[0].vector.size();
        }
    }

    deleteByIds(list<string> ids) {
        if (!ids) {
            return;
        }
        ensureRestClient();
        # Milvus uses an expression DSL for filters
        string id_list = "(" + (foldl $1 + "," + $2,
            (map sprintf("\"%s\"", $1), ids)) + ")";
        hash<auto!> body;
        body.collectionName = coll_name;
        body.filter = sprintf("%s in %s", id_field, id_list);
        rest_client.restPost("/entities/delete", body);
    }

    list<hash<VectorSearchResult>> search(list<float> query_vector, int k,
            *hash<auto> filter) {
        ensureRestClient();
        hash<auto!> body;
        body.collectionName = coll_name;
        body.data = (query_vector,);
        body.limit = k;
        body.outputFields = ("*",);
        if (filter && filter.typeCode() == NT_HASH && exists filter.expr) {
            body.filter = filter.expr;
        }
        hash<auto> resp = rest_client.restPost("/entities/search", body);

        # Milvus returns data: [[{id, distance, ...}, ...]] one inner list per query
        *list<auto> outer = resp.body."data";
        list<auto> rows = outer && outer[0] ? outer[0] : ();
        list<hash<VectorSearchResult>> result = ();
        foreach hash<auto> row in (rows) {
            *hash<auto> payload = row - ("id", "distance", "_score");
            push result, <VectorSearchResult>{
                "id": (row.id ?? "").toString(),
                # Milvus returns distance — for cosine/IP scores are
                # similarity-style already; pass through as score
                "score": (row.distance ?? row._score ?? 0.0).toFloat(),
                "payload": payload,
            };
        }
        return result;
    }

    #! Counts the entities that match a payload filter
    /** Calls \c POST \c /entities/query with <tt>count(*)</tt>.

        @param filter optional filter: the portable \c payload_eq form (each key an equality on a field, joined by
            \c and) or \c expr, a Milvus filter expression

        @return the number of matching entities

        @throw MILVUS-VECTOR-STORE-ERROR a \c payload_eq key is not a valid field name or a value cannot be written
            as a Milvus literal
    */
    int countByFilter(*hash<auto> filter) {
        ensureRestClient();
        return queryCount(MilvusVectorStore::makeExpr(filter) ?? "");
    }

    #! Deletes the entities that match a payload filter
    /** Counts the matching entities, then calls \c POST \c /entities/delete with the filter expression, because
        the REST API does not reliably report the number of entities removed.

        @param filter the filter; see countByFilter()

        @return the number of entities that matched immediately before the delete

        @throw VECTOR-STORE-FILTER-ERROR the filter is empty
    */
    int deleteByFilter(hash<auto> filter) {
        *string expr = MilvusVectorStore::makeExpr(filter);
        AbstractVectorStore::requireFilterCriteria(expr.val());
        ensureRestClient();
        int matched = queryCount(expr);
        if (matched) {
            rest_client.restPost("/entities/delete", {"collectionName": coll_name, "filter": expr});
        }
        return matched;
    }

    #! Summarizes the entities by the distinct values of a payload field
    /** Pages through the matching entities with \c POST \c /entities/query, fetching only the requested fields,
        and groups them here.  Milvus limits <tt>offset + limit</tt> of a query to @ref MaxQueryWindow entities, so
        a filter that matches more is refused rather than silently truncated.

        @param field the payload field to group by
        @param filter optional filter; see countByFilter()
        @param timestamp_field optional payload field holding a date or an ISO 8601 string

        @return the groups ordered by descending count and then by value

        @throw MILVUS-VECTOR-STORE-ERROR more than @ref MaxQueryWindow entities match; narrow the filter
    */
    list<hash<VectorFieldSummary>> summarizeBy(string field, *hash<auto> filter, *string timestamp_field) {
        ensureRestClient();
        string expr = MilvusVectorStore::makeExpr(filter) ?? "";
        int total = queryCount(expr);
        if (total > MaxQueryWindow) {
            throw "MILVUS-VECTOR-STORE-ERROR", sprintf("%d entities match, more than the %d that a Milvus query can "
                "page through; narrow the filter", total, MaxQueryWindow);
        }
        hash<string, hash<auto>> groups = {};
        list<string> fields = timestamp_field ? (field, timestamp_field) : (field,);
        for (int offset = 0; offset < total; offset += QueryPageSize) {
            hash<auto> resp = rest_client.restPost("/entities/query", {
                "collectionName": coll_name,
                "filter": expr,
                "outputFields": fields,
                "limit": QueryPageSize,
                "offset": offset,
            });
            list<auto> rows = resp.body."data" ?? ();
            foreach hash<auto> row in (rows) {
                AbstractVectorStore::addToSummary(\groups, row{field}, timestamp_field ? row{timestamp_field} : NOTHING);
            }
            if (rows.size() < QueryPageSize) {
                break;
            }
        }
        return AbstractVectorStore::finishSummary(groups);
    }

    string getCollection() {
        return coll_name;
    }

    int getDimension() {
        return cached_dimension ?? -1;
    }

    #! Runs a <tt>count(*)</tt> query for a filter expression ("" for all entities)
    private int queryCount(string expr) {
        hash<auto> resp = rest_client.restPost("/entities/query", {
            "collectionName": coll_name,
            "filter": expr,
            "outputFields": ("count(*)",),
        });
        return (resp.body."data"[0]."count(*)" ?? 0).toInt();
    }

    #! Returns the Milvus filter expression for a filter, or NOTHING for no filter
    private static *string makeExpr(*hash<auto> filter) {
        if (!filter) {
            return;
        }
        if (filter.expr.typeCode() == NT_STRING) {
            return filter.expr;
        }
        if (!(filter.payload_eq instanceof hash) || filter.payload_eq.empty()) {
            return;
        }
        list<string> terms = ();
        foreach string key in (keys filter.payload_eq) {
            if (key !~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
                throw "MILVUS-VECTOR-STORE-ERROR", sprintf("the payload_eq filter key %y is not a valid Milvus field "
                    "name", key);
            }
            push terms, sprintf("%s == %s", key, MilvusVectorStore::literal(filter.payload_eq{key}));
        }
        return terms.join(" and ");
    }

    #! Writes a value as a Milvus filter literal
    private static string literal(auto value) {
        switch (value.typeCode()) {
            case NT_STRING: {
                string esc = value;
                esc =~ s/\\/\\\\/g;
                esc =~ s/"/\\"/g;
                return "\"" + esc + "\"";
            }
            case NT_INT:
            case NT_FLOAT:
                return value.toString();
            case NT_BOOLEAN:
                return value ? "true" : "false";
        }
        throw "MILVUS-VECTOR-STORE-ERROR", sprintf("a %s value cannot be used in a Milvus payload_eq filter",
            value.type());
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                hash<auto!> opts = {
                    "url": config.url
                        ?? MilvusRestClient::MilvusRestClientBase::DefaultUrl,
                    "apikey": config.options.api_key,
                };
                rest_client = new MilvusRestClient::MilvusRestClientIo(opts);
            }
        }
    }
}

#! Factory for @ref MilvusVectorStore
public class MilvusVectorStoreFactory inherits AbstractVectorStoreFactory {
    string getType() {
        return "milvus";
    }

    string getDisplayName() {
        return "Milvus / Zilliz Cloud vector database";
    }

    AbstractVectorStore create(hash<VectorStoreConfig> config) {
        return new MilvusVectorStore(config);
    }
}
}
