%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes

module MilvusRestClient {
    version = "1.0";
    desc = "user module for calling Milvus / Zilliz Cloud REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("milvus",
            MilvusRestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerVectorStoreFactory(
            new MilvusVectorStoreFactory());
    };
}

/** @mainpage MilvusRestClient Module

    @tableofcontents

    @section milvusrestclientintro MilvusRestClient Introduction

    The %MilvusRestClient module provides a REST client for
    [Milvus](https://milvus.io) and [Zilliz Cloud](https://zilliz.com)
    (managed Milvus) — and registers `milvus` as a vector-store backend
    in @ref qorerragutilsintro "QoreRagUtils".

    Targets Milvus REST v2 only — gRPC is intentionally NOT used.

    @section MilvusRestClientRelnotes Release Notes

    @subsection MilvusRestClientv1_0 MilvusRestClient v1.0
    - the initial version of the %MilvusRestClient module
*/

%try-module json
%define NoJson
%endtry

public namespace MilvusRestClient {
public class MilvusRestClientBase {
    public {
        const DefaultUrl = "http://localhost:19530";
        const DefaultApiVersion = "v2/vectordb";

        const DefaultOptions = {
            "url": DefaultUrl,
            "api": DefaultApiVersion,
            "default_path": "/" + DefaultApiVersion,
        };
    }

    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        if (opts.api) {
            rv.default_path = "/" + opts.api;
        }
        if (rv.apikey) {
            rv.token = rv.apikey;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Milvus (sync)
public class MilvusRestClient inherits RestClient::RestClient, MilvusRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(MilvusRestClientBase::getOptions(opts), True) {
    }
}

#! REST client for Milvus using multiplexed HTTP connections (async)
public class MilvusRestClientIo inherits RestClientIo::RestClientIo, MilvusRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(MilvusRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Class for Milvus REST connections
public class MilvusRestConnection inherits RestClient::RestConnection {
    public {
        const DefaultUrl = "milvus://localhost:19530";

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Milvus Vector DB Connection",
            "short_desc": "A connection to a Milvus / Zilliz Cloud vector database",
            "desc": "A connection to a [Milvus](https://milvus.io) or "
                "[Zilliz Cloud](https://zilliz.com) (managed Milvus) vector database via "
                "the REST v2 API.\n\n"
                "Authentication: Bearer token (Milvus / Zilliz token).",
            "cls": Class::forName("MilvusRestConnection"),
            "auto_url": True,
            "schemes": {"milvus": True},
            "base_scheme_map": {"http": "milvus", "https": "milvus"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Milvus / Zilliz token (Bearer)",
                    "type": "string",
                    "desc": "Bearer token.  For local Milvus this is the `<user>:<password>` "
                        "auth combo; for Zilliz Cloud it's the cluster API key.",
                    "sensitive": True,
                },
            },
        };
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "milvus";
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("MilvusDataProvider");
        return create_object("MilvusDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    private MilvusRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new MilvusRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new MilvusRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return MilvusRestClientBase::getOptions(rv);
    }
}
}

public namespace QoreRagUtils {
#! Milvus / Zilliz-backed vector store via REST v2
/** @par Configuration

    @ref VectorStoreConfig fields:

    - \c collection (required): the Milvus collection name
    - \c url (optional): Milvus URL (default \c http://localhost:19530)
    - \c options.api_key (required): Bearer token
    - \c options.dimension (optional): vector dimension
    - \c options.id_field (optional): primary key field (default \c "id")
    - \c options.vector_field (optional): vector field name (default \c "vector")
*/
public class MilvusVectorStore inherits AbstractVectorStore {
    public {
        const Backend = "milvus";
    }

    private {
        hash<VectorStoreConfig> config;
        string coll_name;
        string id_field;
        string vector_field;
        *MilvusRestClient::MilvusRestClientIo rest_client;
        *int cached_dimension;
        Mutex init_mutex();
    }

    constructor(hash<VectorStoreConfig> config) {
        self.config = config;
        if (!config.collection.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "MilvusVectorStore requires 'collection' (Milvus collection name)";
        }
        if (!config.options.api_key.val()) {
            throw "VECTOR-STORE-CONFIG-ERROR",
                "MilvusVectorStore requires 'options.api_key'";
        }
        coll_name = config.collection;
        id_field = config.options.id_field ?? "id";
        vector_field = config.options.vector_field ?? "vector";
        if (exists config.options.dimension) {
            cached_dimension = config.options.dimension;
        }
    }

    upsert(list<hash<VectorRecord>> records) {
        if (!records) {
            return;
        }
        ensureRestClient();
        # Milvus expects "data" as a list of hashes with field names mapped
        list<auto> data = map (
            (id_field): $1.id,
            (vector_field): $1.vector,
        ) + ($1.payload ?? {}), records;
        hash<auto!> body;
        body.collectionName = coll_name;
        body.data = data;
        rest_client.restPost("/entities/upsert", body);
        if (!exists cached_dimension && records[0].vector) {
            cached_dimension = records[0].vector.size();
        }
    }

    deleteByIds(list<string> ids) {
        if (!ids) {
            return;
        }
        ensureRestClient();
        # Milvus uses an expression DSL for filters
        string id_list = "(" + (foldl $1 + "," + $2,
            (map sprintf("\"%s\"", $1), ids)) + ")";
        hash<auto!> body;
        body.collectionName = coll_name;
        body.filter = sprintf("%s in %s", id_field, id_list);
        rest_client.restPost("/entities/delete", body);
    }

    list<hash<VectorSearchResult>> search(list<float> query_vector, int k,
            *hash<auto> filter) {
        ensureRestClient();
        hash<auto!> body;
        body.collectionName = coll_name;
        body.data = (query_vector,);
        body.limit = k;
        body.outputFields = ("*",);
        if (filter && filter.typeCode() == NT_HASH && exists filter.expr) {
            body.filter = filter.expr;
        }
        hash<auto> resp = rest_client.restPost("/entities/search", body);

        # Milvus returns data: [[{id, distance, ...}, ...]] one inner list per query
        *list<auto> outer = resp.body."data";
        list<auto> rows = outer && outer[0] ? outer[0] : ();
        list<hash<VectorSearchResult>> result = ();
        foreach hash<auto> row in (rows) {
            *hash<auto> payload = row - ("id", "distance", "_score");
            push result, <VectorSearchResult>{
                "id": (row.id ?? "").toString(),
                # Milvus returns distance — for cosine/IP scores are
                # similarity-style already; pass through as score
                "score": (row.distance ?? row._score ?? 0.0).toFloat(),
                "payload": payload,
            };
        }
        return result;
    }

    string getCollection() {
        return coll_name;
    }

    int getDimension() {
        return cached_dimension ?? -1;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                hash<auto!> opts = {
                    "url": config.url
                        ?? MilvusRestClient::MilvusRestClientBase::DefaultUrl,
                    "apikey": config.options.api_key,
                };
                rest_client = new MilvusRestClient::MilvusRestClientIo(opts);
            }
        }
    }
}

#! Factory for @ref MilvusVectorStore
public class MilvusVectorStoreFactory inherits AbstractVectorStoreFactory {
    string getType() {
        return "milvus";
    }

    string getDisplayName() {
        return "Milvus / Zilliz Cloud vector database";
    }

    AbstractVectorStore create(hash<VectorStoreConfig> config) {
        return new MilvusVectorStore(config);
    }
}
}
