# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) ConnectionProvider
%requires(reexport) DataProvider
%requires mongodb
%requires QoreRagTypes

module MongoDbDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for MongoDB servers";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the connection schemes; Atlas clusters are reached with "mongodb+srv", where
        # the hosts come from DNS and TLS is implied, and a connection could not use one at all
        # until the scheme was registered
        ConnectionSchemeCache::registerScheme("mongodb", MongoDbConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme(MongoDbConnection::SrvScheme,
            MongoDbConnection::ConnectionScheme);

        # register the data provider factory
        DataProvider::registerFactory(new MongoDbDataProviderFactory());

        # register the MongoDB Atlas Vector Search vector-store factory in
        # QoreRagUtils so RagPipeline can target Atlas via backend "mongo-atlas"
        QoreRagUtils::RagProviderRegistry::registerVectorStoreFactory(
            new QoreRagUtils::MongoAtlasVectorStoreFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": MongoDbDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "MongoDB Server",
            "short_desc": "MongoDB NoSQL database",
            "desc": "MongoDB is a document-oriented NoSQL database for high volume data storage",
            "scheme": "mongodb",
            "logo": MongoDbLogo,
            "logo_file_name": "mongodb-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Databases,),
        });

        # path variable definitions for collection actions
        hash<string, hash<DataProviderPathVarInfo>> collection_path_vars = {
            "database": <DataProviderPathVarInfo>{
                "display_name": "Database",
                "short_desc": "MongoDB database name",
                "desc": "The name of the MongoDB database",
            },
            "collection": <DataProviderPathVarInfo>{
                "display_name": "Collection",
                "short_desc": "MongoDB collection name",
                "desc": "The name of the MongoDB collection",
            },
        };

        # register CRUD actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/insert",
            "path_vars": collection_path_vars,
            "action": "insert",
            "display_name": "Insert Document",
            "short_desc": "Insert a document into a collection",
            "desc": "Insert one or more documents into a MongoDB collection",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/find",
            "path_vars": collection_path_vars,
            "action": "find",
            "display_name": "Find Documents",
            "short_desc": "Query documents in a collection",
            "desc": "Find documents in a MongoDB collection using query filters",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/update",
            "path_vars": collection_path_vars,
            "action": "update",
            "display_name": "Update Documents",
            "short_desc": "Update documents in a collection",
            "desc": "Update one or more documents in a MongoDB collection",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/delete",
            "path_vars": collection_path_vars,
            "action": "delete",
            "display_name": "Delete Documents",
            "short_desc": "Delete documents from a collection",
            "desc": "Delete one or more documents from a MongoDB collection",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/aggregate",
            "path_vars": collection_path_vars,
            "action": "aggregate",
            "display_name": "Aggregation Pipeline",
            "short_desc": "Run aggregation pipeline",
            "desc": "Execute an aggregation pipeline on a MongoDB collection",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/bulk",
            "path_vars": collection_path_vars,
            "action": "bulk",
            "display_name": "Bulk Operations",
            "short_desc": "Execute bulk write operations",
            "desc": "Execute bulk insert, update, and delete operations on a MongoDB collection",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/find-one",
            "path_vars": collection_path_vars,
            "action": "find-one",
            "display_name": "Find One Document",
            "short_desc": "Return the first document matching a filter",
            "desc": "Returns the first document in a MongoDB collection matching a filter, as the "
                "document itself rather than as a list holding it.\n\n"
                "Use this where at most one document is wanted - a lookup by `_id`, say - and "
                "**Find Documents** where several are.  The result reports `found` separately, so "
                "a flow can branch on whether anything matched without testing the document.",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/count",
            "path_vars": collection_path_vars,
            "action": "count",
            "display_name": "Count Documents",
            "short_desc": "Count the documents matching a filter",
            "desc": "Counts the documents in a MongoDB collection matching a filter, without "
                "returning any of them.\n\n"
                "This takes the same filter as **Find Documents**, so it is the cheap way to ask "
                "how large a result would be before asking for the result itself.",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MongoDbDataProvider::AppName,
            "path": "/databases/{database}/{collection}/vector-search",
            "path_vars": collection_path_vars,
            "action": "vector-search",
            "display_name": "Vector Search",
            "short_desc": "Find the documents nearest a query vector",
            "desc": "Runs an [Atlas Vector Search](https://www.mongodb.com/docs/atlas/atlas-vector-search/) "
                "query: given a query vector, returns the documents whose stored embeddings are "
                "nearest to it, each with its similarity `score`.\n\n"
                "This is the retrieval step of a RAG pipeline done in the database, so the "
                "documents and their embeddings stay in one place instead of being copied into a "
                "separate vector store.\n\n"
                "**Requires an Atlas vector search index** on the collection, naming the field "
                "that holds the embeddings; `index_name` and `path` must match it.  Available on "
                "Atlas clusters only, not on a self-managed server.",
            "action_code": DPAT_API,
            "data_dependent_options": True,
        });
    };
}

/** @mainpage MongoDbDataProvider Module

    @tableofcontents

    @section mongodbdataproviderintro Introduction to the MongoDbDataProvider Module

    <img src="mongodb-logo.svg" width="96" alt="MongoDbDataProvider module logo"/>

    The %MongoDbDataProvider module provides a @ref dataproviderintro "data provider" API for
    MongoDB servers. It uses the builtin \c mongodb module which wraps libmongoc for efficient
    communication and provides full CRUD operations, aggregation pipelines, and bulk operations.

    This data provider provides MongoDB API access to:
    - databases: <b><tt>databases/{@ref MongoDbDataProvider::MongoDbDatabaseDataProvider "database_name"}</tt></b>
    - collections: <b><tt>databases/db_name/{@ref MongoDbDataProvider::MongoDbCollectionDataProvider "collection_name"}</tt></b>
    - CRUD operations: <b><tt>databases/db_name/coll_name/{@ref MongoDbDataProvider::MongoDbInsertDataProvider "insert",
      @ref MongoDbDataProvider::MongoDbFindDataProvider "find",
      @ref MongoDbDataProvider::MongoDbUpdateDataProvider "update",
      @ref MongoDbDataProvider::MongoDbDeleteDataProvider "delete"}</tt></b>
    - aggregation: <b><tt>databases/db_name/coll_name/{@ref MongoDbDataProvider::MongoDbAggregateDataProvider "aggregate"}</tt></b>
    - bulk: <b><tt>databases/db_name/coll_name/{@ref MongoDbDataProvider::MongoDbBulkDataProvider "bulk"}</tt></b>
    - single-document reads: <b><tt>databases/db_name/coll_name/{@ref MongoDbDataProvider::MongoDbFindOneDataProvider "find-one",
      @ref MongoDbDataProvider::MongoDbCountDataProvider "count"}</tt></b>
    - Atlas Vector Search: <b><tt>databases/db_name/coll_name/{@ref MongoDbDataProvider::MongoDbVectorSearchDataProvider "vector-search"}</tt></b>

    @note The path to an operation is <tt>databases/<i>db</i>/<i>collection</i>/<i>operation</i></tt>:
    a database's children are its collections directly, with no intervening <tt>collections</tt>
    segment.

    @section mongodbdataprovider_atlas MongoDB Atlas

    Atlas clusters are reached with a <tt>mongodb+srv://</tt> URL, where the hosts come from a DNS
    seed list and TLS is implied:

    @verbatim mongodb+srv://cluster0.abcde.mongodb.net
    @endverbatim

    Give the credentials as the connection's \c username and \c password options rather than
    writing them into the URL.  The password is then stored and rendered as a password, and both are
    URL-encoded when the client is created, so a password containing \c "@", \c ":" or \c "/"
    needs no encoding of its own.  \c appname is worth setting as well: Atlas reports it against
    every operation in the cluster's monitoring.

    @ref MongoDbDataProvider::MongoDbVectorSearchDataProvider "Vector Search" is Atlas-only and needs
    a vector search index on the collection; \c index_name and \c path must match that index.  A
    field named in the index as a \c filter field can then be used in the action's \c filter option
    to narrow the candidate set, and \c exact runs the search over every vector rather than
    approximately.

    @section mongodbdataprovider_factory MongoDB Data Provider Factory

    The name of the MongoDB data provider factory is <b><tt>mongodb</tt></b>.

    @section mongodbdataprovider_examples MongoDB Data Provider Examples

    These examples are with \c qdp, the command-line interface to the Data Provider API.

    @par API Example: Insert a Document
    @verbatim qdp 'mongodb{url=mongodb://localhost:27017}/databases/mydb/mycoll/insert' document='{"name": "test", "value": 42}'
    @endverbatim

    @par API Example: Find Documents
    @verbatim qdp 'mongodb{url=mongodb://localhost:27017}/databases/mydb/mycoll/find' filter='{"name": "test"}'
    @endverbatim

    @par API Example: Update Documents
    @verbatim qdp 'mongodb{url=mongodb://localhost:27017}/databases/mydb/mycoll/update' filter='{"name": "test"}',update='{"$set": {"value": 100}}'
    @endverbatim

    @par API Example: Delete Documents
    @verbatim qdp 'mongodb{url=mongodb://localhost:27017}/databases/mydb/mycoll/delete' filter='{"name": "test"}'
    @endverbatim

    @par API Example: Aggregation Pipeline
    @verbatim qdp 'mongodb{url=mongodb://localhost:27017}/databases/mydb/mycoll/aggregate' pipeline='[{"$group": {"_id": "$category", "total": {"$sum": "$value"}}}]'
    @endverbatim

    @par Record-Based Example: Search Collection
    @verbatim qdp 'mongodb{url=mongodb://localhost:27017}/databases/mydb/mycoll' name=test
    @endverbatim

    @par Typed Iterator Example
    @code{.py}
%requires MongoDbDataProvider
%requires mongodb

MongoClient client("mongodb://localhost:27017");
MongoDatabase db = client.getDatabase("mydb");
MongoDbDataProvider::MongoDbCollectionDataProvider collection_provider(
    client, db, "mycoll");
AbstractDataProviderRecordIterator<hash<auto>> iter = collection_provider.searchRecords();
while (iter.next()) {
    hash<auto> doc = iter.getValue();
    printf("Document: %y\n", doc);
}
    @endcode

    @section mongodbdataprovider_relnotes Release Notes

    @subsection mongodbdataprovider_v1_0 MongoDbDataProvider v1.0
    - initial release
*/

public namespace MongoDbDataProvider {
public const MongoDbLogo = File::readTextFile(get_script_dir() + "/mongodb-logo.svg");
}
