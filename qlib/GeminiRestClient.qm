# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires HttpClientStreamingIo
%requires QoreLlmTypes
%requires QoreRagTypes

module GeminiRestClient {
    version = "1.0";
    desc = "user module for calling Google Gemini REST API services";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("gemini", GeminiRestConnection::ConnectionScheme);
        QoreLlmUtils::LlmProviderRegistry::registerFactory(new GeminiLlmProviderFactory());
        QoreRagUtils::RagProviderRegistry::registerEmbedderFactory(
            new QoreRagUtils::GeminiEmbedderFactory());
    };
}

/** @mainpage GeminiRestClient Module

    @tableofcontents

    @section geminirestclientintro GeminiRestClient Module Introduction

    The %GeminiRestClient module provides an API for calling Google Gemini REST API services.

    To use this module, use \c "%requires GeminiRestClient" in your code.

    All the public symbols in the module are defined in the GeminiRestClient namespace.

    The main classes are:
    - @ref GeminiRestClient::GeminiRestClient "GeminiRestClient":
      this class provides the REST client API for communication with the Google Gemini REST
      API; it also automates authentication and authorization to the target
    - @ref GeminiRestClient::GeminiRestConnection "GeminiRestConnection":
      provides a REST connection object to Google Gemini cloud services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires GeminiRestClient
%requires ConnectionProvider

GeminiRestClient rest({"apikey": api_key});
hash<auto> ans = rest.get("v1beta/models");
printf("%Y\n", ans.body);
    @endcode

    @par Streaming Example:
    @code{.py}
GeminiRestClientIo rest({"apikey": api_key});
GeminiResponseSseStreamIo stream = rest.openStreamingConnection("gemini-2.5-flash", {
    "contents": (
        {"role": "user", "parts": ({"text": "Stream a response"},)},
    ),
});
while (*hash<SseMessageInfo> evt = stream.readEvent(5s)) {
    printf("%s\n", evt.data);
}
stream.close();
    @endcode

    @section GeminiRestClientRelnotes Release Notes

    @subsection GeminiRestClientv1_0 GeminiRestClient v1.0
    - the initial version of the %GeminiRestClient module
*/

%try-module json
%define NoJson
%endtry

#! the GeminiRestClient namespace contains all the objects in the GeminiRestClient module
public namespace GeminiRestClient {
#! Common base class for GeminiRestClient functionality
public class GeminiRestClientBase {
    public {
        #! Default Gemini REST API URL
        const DefaultUrl = "https://generativelanguage.googleapis.com";

        #! Default Gemini API version
        const DefaultApiVersion = "v1beta";

        #! Default data serialization
        const DefaultData = "json";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "data": DefaultData,
            "default_path": "/" + DefaultApiVersion,
        };

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default ping path
        const DefaultPingPath = "models";
    }

    #! Returns options for the constructor
    /** Maps the \c apikey option to the \c x-goog-api-key header
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        # Map apikey to x-goog-api-key header
        if (rv.apikey) {
            hash<auto> hdr = rv.headers ?? {};
            hdr."x-goog-api-key" = rv.apikey;
            rv += {"headers": hdr};
            delete rv.apikey;
        }
        return rv;
    }
}

#! This class provides the REST client API for communication with Google Gemini servers
/** You must use an API key in the \c apikey option to call Gemini APIs.

    The API key is sent as the \c x-goog-api-key header.
*/
public class GeminiRestClient inherits RestClient::RestClient, GeminiRestClientBase {
    #! Creates the object with the given options
    /**
        @par Example:
        @code{.py}
GeminiRestClient rest({"apikey": api_key});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class; note
        that the URL is set by default if not provided (see @ref DefaultUrl).
        Additional options:
        - \c apikey: the Google Gemini API key (required)
        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(GeminiRestClientBase::getOptions(opts), do_not_connect) {
    }

    #! Opens a Server-Sent Events stream for streaming content generation
    /** @param model the model name (e.g., "gemini-2.5-flash")
        @param req the request body
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading

        @return an SSE stream object for reading events incrementally
    */
    GeminiResponseSseStream openStreamingConnection(string model, hash<auto> req, *hash<auto> hdr, *timeout to) {
        return new GeminiResponseSseStream(self, model, req, hdr, to);
    }
}

#! SSE connection for Gemini streaming content generation
public class GeminiResponseSseStream {
    private {
        GeminiRestClient rest;
        bool chunked;
        string content_encoding;
        StringOutputStream ostream;
        TransformOutputStream dstream;
        bool use_decompressor;
        timeout timeout_ms = 15s;
        bool closed;

        const SseMimeType = "text/event-stream";
    }

    #! Creates the stream connection
    constructor(GeminiRestClient rest, string model, *auto body, *hash<auto> hdr, *timeout to) {
        self.rest = rest;
        if (to) {
            timeout_ms = to;
        }
        hash<auto> headers = rest.getDefaultHeaders() + (hdr ?? {});
        headers.Accept = SseMimeType;
        data payload;
        if (exists body) {
            payload = getSerializedBody(body, \headers);
        }
        string full_path = buildPath("models/" + model + ":streamGenerateContent?alt=sse");
        hash<auto> info;
        hash<auto> resp = rest.send(payload, "POST", full_path, headers, False, \info);
        if (resp.status_code != 200) {
            throw "SSE-ERROR", sprintf("unexpected status code %d %s", resp.status_code, resp.status_message);
        }
        string content_type = normalizeContentType(resp."content-type");
        if (content_type != SseMimeType) {
            throw "SSE-ERROR", sprintf("expected Content-Type %y but got %y", SseMimeType, resp."content-type");
        }
        if (resp."content-encoding".val()) {
            content_encoding = tolower(resp."content-encoding");
        }
        if (resp."transfer-encoding".val()) {
            string transfer_encoding = tolower(resp."transfer-encoding");
            if (transfer_encoding == "chunked") {
                chunked = True;
            } else {
                throw "SSE-ERROR", sprintf("unsupported Transfer-Encoding: %y", resp."transfer-encoding");
            }
        }
        setupDecompression();
    }

    #! Reads the next SSE message
    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (closed) {
            return;
        }
        timeout use_to = to ?? timeout_ms;
        if (chunked) {
            hash<auto> hh = rest.readHTTPChunk(use_to);
            if (!hh.body) {
                return;
            }
            if (use_decompressor) {
                dstream.write(hh.body);
            } else {
                ostream.write(hh.body);
            }
            return rest.parseServerSentEvent(ostream.getData());
        }
        return rest.readServerSentEvent(content_encoding, use_to);
    }

    #! Closes the stream connection
    close() {
        if (!closed) {
            closed = True;
            rest.disconnect();
        }
    }

    private string buildPath(string path) {
        string rv = path;
        rv =~ s/^\/+//;
        rv = "/" + rv;
        *string defp = rest.getDefaultPath();
        if (defp.val() && defp != "/") {
            defp =~ s/\/+$//;
            if (defp !~ /^\//) {
                defp = "/" + defp;
            }
            rv = defp + rv;
        }
        return rv;
    }

    private data getSerializedBody(data body, reference<hash<auto>> headers) {
        if (body.typeCode() == NT_STRING) {
            if (!headers."Content-Type") {
                headers."Content-Type" = "application/json";
            }
            return body;
        }
%ifdef NoJson
        throw "SSE-ERROR", "json module is required to serialize SSE request body";
%else
        if (!headers."Content-Type") {
            headers."Content-Type" = "application/json";
        }
        return make_json(body);
%endif
    }

    private setupDecompression() {
        if (!chunked) {
            return;
        }
        ostream = new StringOutputStream();
        Transform decompressor;
        switch (content_encoding) {
            case "deflate":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_ZLIB);
                break;
            case "gzip":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_GZIP);
                break;
            case "bzip2":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_BZIP2);
                break;
            case NOTHING:
            case "identity":
                use_decompressor = False;
                break;

            default:
                throw "ENCODING-ERROR", sprintf("Don't know how to handle Content-Encoding %y", content_encoding);
        }
        if (use_decompressor) {
            dstream = new TransformOutputStream(ostream, decompressor);
        }
    }

    private static string normalizeContentType(*string content_type) {
        if (!content_type.val()) {
            return "";
        }
        string rv = content_type;
        rv =~ s/\s*;.*$//;
        rv =~ s/^\s+//;
        rv =~ s/\s+$//;
        return tolower(rv);
    }
}

#! REST client for Google Gemini REST API using multiplexed HTTP connections
/** @see GeminiRestClient for more information
*/
public class GeminiRestClientIo inherits RestClientIo::RestClientIo, GeminiRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(GeminiRestClientBase::getOptions(opts), shared_mgr) {
    }

    #! Opens a Server-Sent Events stream for streaming content generation using async I/O
    /** Uses HttpClientIo and SseStreamReader for incremental SSE event delivery
        across HTTP/1.x, HTTP/2, and HTTP/3.

        @param model the model name (e.g., "gemini-2.5-flash")
        @param req the request body (will be serialized to JSON)
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading

        @return an SSE stream object for reading events incrementally

        @par Example:
        @code{.py}
GeminiRestClientIo rest({"apikey": api_key});
GeminiResponseSseStreamIo stream = rest.openStreamingConnection("gemini-2.5-flash", {
    "contents": ({"role": "user", "parts": ({"text": "Hello!"},)},),
});
while (*hash<SseMessageInfo> evt = stream.readEvent()) {
    printf("Event: %y\n", evt.data);
}
        @endcode
    */
    GeminiResponseSseStreamIo openStreamingConnection(string model, hash<auto> req, *hash<auto> hdr, *timeout to) {
        return new GeminiResponseSseStreamIo(self, model, req, hdr, to);
    }
}

#! SSE stream for Gemini streaming content generation using async I/O (HttpClientIo + SseStreamReader)
/** Works across HTTP/1.x, HTTP/2, and HTTP/3 via HttpClientIo's multiplexed
    connection manager.

    @note This class is \b not thread-safe.  Use from a single reader thread.
*/
public class GeminiResponseSseStreamIo {
    private {
        #! SSE stream reader
        HttpClientStreamingIo::SseStreamReader reader;

        #! Timeout for SSE event reading
        timeout timeout_ms = 15s;

        #! True when the stream has been closed
        bool closed = False;
    }

    #! Creates the SSE stream connection
    /** @param rest the GeminiRestClientIo instance
        @param model the model name (e.g., "gemini-2.5-flash")
        @param body the request body (serialized to JSON)
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading
    */
    constructor(GeminiRestClientIo rest, string model, *auto body, *hash<auto> hdr, *timeout to) {
        if (to) {
            timeout_ms = to;
        }
        hash<auto> headers = rest.getDefaultHeaders() + (hdr ?? {});
        headers.Accept = "text/event-stream";

        # Serialize body to JSON
        *data payload;
        if (exists body) {
%ifdef NoJson
            throw "SSE-ERROR", "json module is required to serialize SSE request body";
%else
            if (body.typeCode() != NT_STRING) {
                if (!headers."Content-Type") {
                    headers."Content-Type" = "application/json";
                }
                payload = make_json(body);
            } else {
                if (!headers."Content-Type") {
                    headers."Content-Type" = "application/json";
                }
                payload = body;
            }
%endif
        }

        # Build full path: /v1beta/models/{model}:streamGenerateContent?alt=sse
        string full_path = buildPath(rest, "models/" + model + ":streamGenerateContent?alt=sse");

        # Acquire stream and start SSE streaming
        HttpClientIo::HttpClientConnectionManager mgr = rest.getConnectionManager();
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(rest.getUrl());
        stream.startStreaming("POST", full_path, headers, False, payload);

        reader = new HttpClientStreamingIo::SseStreamReader(stream);
    }

    #! Reads the next SSE event
    /** @param to optional timeout override
        @return the parsed SSE event, or NOTHING on timeout or stream end
    */
    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (closed) {
            return NOTHING;
        }
        return reader.readEvent(to ?? timeout_ms);
    }

    #! Returns True if the stream has ended
    bool isDone() {
        return closed || reader.isDone();
    }

    #! Closes the stream
    close() {
        if (!closed) {
            closed = True;
            reader.cancel();
        }
    }

    #! Builds the full API path from connection path + relative path
    private static string buildPath(RestClientIo::RestClientIo rest, string path) {
        string rv = path;
        rv =~ s/^\/+//;
        rv = "/" + rv;
        *string base = rest.getConnectionPath();
        if (base.val() && base != "/") {
            base =~ s/\/+$//;
            if (base !~ /^\//) {
                base = "/" + base;
            }
            rv = base + rv;
        }
        return rv;
    }
}

#! Class for Gemini REST connections; returns @ref GeminiRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestConnection"

    @see @ref GeminiRestClient::GeminiRestClient::constructor() for more information on the above options
*/
public class GeminiRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Gemini REST API URL
        const DefaultUrl = "gemini://generativelanguage.googleapis.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Google Gemini REST Connection",
            "short_desc": "A connection to the Google Gemini REST API",
            "desc": "A connection to the [Google Gemini](https://ai.google.dev) REST API for generative AI "
                "services including text generation, embeddings, and multimodal content.\n\n"
                "An API key is required for authentication. To obtain one, visit the "
                "[Google AI Studio](https://aistudio.google.com/apikey) and create a new API key",
            "cls": Class::forName("GeminiRestConnection"),
            "auto_url": True,
            "schemes": {
                "gemini": True,
            },
            "base_scheme_map": {
                "https": "gemini",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Google Gemini API key for authentication",
                    "type": "string",
                    "desc": "The Google Gemini API key used for authentication; sent as the `x-goog-api-key` "
                        "header. To obtain a key, visit "
                        "[Google AI Studio](https://aistudio.google.com/apikey)",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": GeminiRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": GeminiRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": GeminiRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Get Your Google Gemini API Key",
                    "intent": "info",
                    "content": "To connect to Google Gemini, you need an API key:\n\n"
                        "1. Go to [Google AI Studio](https://aistudio.google.com/apikey)\n"
                        "2. Sign in with your Google account\n"
                        "3. Click **Create API Key**\n"
                        "4. Copy the generated key\n\n"
                        "Keep your API key secure and never share it publicly.",
                },
            ),
        };
    }

    #! Creates the GeminiRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! Creates the GeminiRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! Returns \c "gemini"
    string getType() {
        return "gemini";
    }

    #! Returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the GeminiDataProvider and creates the data provider
        # object dynamically
        load_module("GeminiDataProvider");
        return create_object("GeminiDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            # Auto-correct ping path - remove leading slash
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! Returns connection options with apikey translated to x-goog-api-key header
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> opts = RestConnection::getConnectionOptions(rtopts);
        return GeminiRestClientBase::getOptions(opts);
    }

    #! Returns a @ref GeminiRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref GeminiRestClient object
    */
    private GeminiRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new GeminiRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new GeminiRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! LLM provider that dispatches requests to the Google Gemini \c generateContent API
/** Implements the @ref QoreLlmUtils::AbstractLlmProvider contract using
    @ref GeminiRestClientIo for transport.  The provider handles
    Gemini-native body construction, response parsing, schema sanitization
    (Gemini's JSON Schema subset is stricter than OpenAI's — see
    @ref sanitizeGeminiSchema()), tool-call extraction, finish-reason mapping,
    and OpenAI-compatible facade adapter hooks (\c toolConfig in place of
    \c tool_choice, \c responseSchema in place of \c response_format,
    \c usageMetadata + \c candidates[].finishReason on stream events).

    Thread-safe: the underlying @ref GeminiRestClientIo is lazy-initialized
    behind a mutex.
*/
public class GeminiLlmProvider inherits QoreLlmUtils::AbstractLlmProvider {
    private {
        #! Lazy-initialized REST client
        *GeminiRestClientIo rest_client;
        #! Serializes lazy initialization
        Mutex rest_mutex();
    }

    #! Constructs the provider from an @ref QoreLlmUtils::LlmBackendConfig
    /** @param config the backend configuration; @ref QoreLlmUtils::LlmBackendConfig::api_key
            is required

        @throw LLM-CONFIG-ERROR \c api_key is missing
        @throw LLM-DEPENDENCY-ERROR the \c json module is not available
    */
    constructor(hash<QoreLlmUtils::LlmBackendConfig> config)
            : QoreLlmUtils::AbstractLlmProvider(config) {
        if (!config.api_key.val()) {
            throw "LLM-CONFIG-ERROR",
                "api_key is required for \"gemini\" mode";
        }
%ifdef NoJson
        throw "LLM-DEPENDENCY-ERROR",
            "json module is required for Gemini mode but is not available";
%endif
    }

    string getMode() {
        return "gemini";
    }

    hash<QoreLlmUtils::LlmCompletionResult> complete(string system_prompt,
            string user_prompt, *hash<auto> output_schema,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> body = buildGeminiBody((
            <QoreLlmUtils::ChatMessage>{"role": "system", "content": system_prompt},
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": user_prompt},
        ), NOTHING, output_schema, opts);

        hash<auto> resp;
        try {
            resp = withRetry(hash<auto> sub () {
                return rest_client.restPost(getGeminiGeneratePath(opts), body);
            });
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR", sprintf("Gemini completion request failed: %s",
                ex.desc), ex;
        }

        return <QoreLlmUtils::LlmCompletionResult>{
            "content": extractGeminiText(resp.body),
            "usage": normalizeGeminiUsage(resp.body.usageMetadata),
        };
    }

    hash<QoreLlmUtils::ChatResponse> chat(
            list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> body = buildGeminiBody(messages, tools,
            opts.output_schema, opts);
        hash<auto> resp;
        try {
            resp = withRetry(hash<auto> sub () {
                return rest_client.restPost(getGeminiGeneratePath(opts), body);
            });
        } catch (hash<ExceptionInfo> ex) {
            throw "LLM-ERROR", sprintf("Gemini chat request failed: %s",
                ex.desc), ex;
        }

        hash<QoreLlmUtils::ChatResponse> rv = parseGeminiChatResponse(resp.body);
        rv.model = getGeminiModelName(opts);
        return rv;
    }

    chatStream(list<hash<QoreLlmUtils::ChatMessage>> messages,
            code<nothing(hash<QoreLlmUtils::ChatStreamEvent>)> callback,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        ensureRestClient();

        hash<auto> body = buildGeminiBody(messages, tools,
            opts.output_schema, opts);
        GeminiResponseSseStreamIo stream =
            rest_client.openStreamingConnection(
                getGeminiBareModelName(getGeminiModelName(opts)), body,
                NOTHING, getConfig().timeout_ms);
        on_exit stream.close();

        while (True) {
            *hash<SseMessageInfo> evt = stream.readEvent(getConfig().timeout_ms);
            if (!evt) {
                callback(<QoreLlmUtils::ChatStreamEvent>{"done": True});
                break;
            }
            if (!evt.data.val() || evt.data == "[DONE]") {
                callback(<QoreLlmUtils::ChatStreamEvent>{"done": True});
                break;
            }

            *hash<auto> parsed;
            try {
                parsed = parse_json(evt.data);
            } catch () {
                continue;
            }

            string delta = extractGeminiText(parsed);
            *string finish_reason = parsed.candidates[0].finishReason;
            if (delta.val()) {
                callback(<QoreLlmUtils::ChatStreamEvent>{
                    "event": evt.event,
                    "delta": delta,
                    "raw": parsed,
                });
            }
            if (finish_reason.val()) {
                callback(<QoreLlmUtils::ChatStreamEvent>{
                    "done": True, "raw": parsed,
                });
                break;
            }
        }
    }

    #! Merges \c body_options with Gemini-specific nested \c generationConfig semantics
    hash<auto> mergeRequestBodyOptions(hash<auto> body,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        if (!opts.body_options) {
            return body;
        }
        hash<auto!> rv;
        rv += body;
        foreach string key in (keys opts.body_options) {
            if (key == "generationConfig"
                    && rv.generationConfig.typeCode() == NT_HASH
                    && opts.body_options{key}.typeCode() == NT_HASH) {
                hash<auto!> gc;
                gc += rv.generationConfig;
                gc += opts.body_options{key};
                rv.generationConfig = gc;
            } else {
                rv{key} = opts.body_options{key};
            }
        }
        return rv;
    }

    #! Translates an OpenAI \c tool_choice into Gemini's \c toolConfig form
    applyOpenAiToolChoice(reference<hash<auto!>> body_options, auto choice) {
        *hash<auto> tool_cfg = openAiToolChoiceToGeminiConfig(choice);
        if (tool_cfg) {
            body_options.toolConfig = tool_cfg;
        }
    }

    #! Routes an OpenAI \c response_format=json_schema to Gemini's
    #! @ref QoreLlmUtils::LlmRequestOptions::output_schema
    applyOpenAiResponseFormat(reference<hash<auto!>> body_options,
            reference<hash<QoreLlmUtils::LlmRequestOptions>> options,
            hash<auto> output_schema, *hash<auto> response_format) {
        options.output_schema = output_schema;
    }

    #! Updates OpenAI stream state from a Gemini-native event
    updateOpenAiStreamStateFromRaw(reference<hash<auto>> state,
            *hash<auto> raw) {
        if (!raw) {
            return;
        }
        if (raw.responseId.val()) {
            state.id = raw.responseId;
        } else if (raw.id.val()) {
            state.id = raw.id;
        }
        if (raw.model.val()) {
            state.model = raw.model;
        }
        if (raw.usageMetadata.typeCode() == NT_HASH) {
            state.usage = normalizeGeminiUsage(raw.usageMetadata);
        } else if (raw.usage.typeCode() == NT_HASH) {
            state.usage = raw.usage;
        }
        *string finish_reason = raw.candidates[0].finishReason;
        if (finish_reason.val()) {
            state.finish_reason = state.tool_calls
                ? "tool_calls" : geminiFinishReasonToOpenAi(finish_reason);
        } else if (raw.choices[0].finish_reason.val()) {
            state.finish_reason = raw.choices[0].finish_reason;
        }
    }

    #! Harvests OpenAI-shaped \c tool_calls deltas from Gemini \c functionCall parts
    list<hash<auto>> getOpenAiToolCallDeltas(reference<hash<auto>> state,
            *hash<auto> raw) {
        if (!raw) {
            return ();
        }
        list<hash<auto>> streamed = ();
        foreach hash<auto> part in (raw.candidates[0].content.parts ?? ()) {
            if (!part.functionCall) {
                continue;
            }
            int idx = state.tool_calls.size();
            hash<auto> tc = {
                "id": part.functionCall.id ?? sprintf("tool-%d", idx + 1),
                "type": "function",
                "function": {
                    "name": part.functionCall.name,
                    "arguments": make_json(part.functionCall.args ?? {}),
                },
            };
            state.tool_calls += tc;
            streamed += {
                "index": idx,
                "id": tc.id,
                "type": "function",
                "function": tc.function,
            };
        }
        return streamed;
    }

    #! Lazy-initializes the GeminiRestClientIo
    private ensureRestClient() {
        if (!rest_client) {
            rest_mutex.lock();
            on_exit rest_mutex.unlock();
            if (!rest_client) {
                hash<auto!> opts = {
                    "apikey": getConfig().api_key,
                    "connect_timeout": getConfig().connect_timeout_ms,
                    "timeout": getConfig().timeout_ms,
                };
                if (getConfig().url.val()) {
                    opts.url = getConfig().url;
                }
                if (getConfig().protocol.val()) {
                    opts.protocol = getConfig().protocol;
                }
                rest_client = new GeminiRestClientIo(opts);
            }
        }
    }

    #! Resolves the Gemini model, defaulting to the stable Flash model
    private string getGeminiModelName(*hash<QoreLlmUtils::LlmRequestOptions> opts) {
        return getRequestModel(opts) ?? "gemini-2.5-flash";
    }

    #! Returns the Gemini \c generateContent REST path
    private string getGeminiGeneratePath(*hash<QoreLlmUtils::LlmRequestOptions> opts) {
        return getGeminiModelResource(getGeminiModelName(opts))
            + ":generateContent";
    }

    #! Returns the Gemini model resource for REST calls
    private static string getGeminiModelResource(string model) {
        return model =~ /^models\// ? model : "models/" + model;
    }

    #! Returns the bare Gemini model name required by streaming helper APIs
    private static string getGeminiBareModelName(string model) {
        return regex_subst(model, "^models/", "");
    }

    #! Builds a Gemini \c generateContent request body
    private hash<auto> buildGeminiBody(
            list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<auto> output_schema,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        list<hash<auto>> contents = ();
        list<hash<auto>> system_parts = ();

        foreach hash<QoreLlmUtils::ChatMessage> msg in (messages) {
            if (msg.role == "system") {
                list<hash<auto>> parts = buildGeminiContentParts(msg);
                if (parts) {
                    system_parts += parts;
                }
                continue;
            }

            list<hash<auto>> parts;
            if (msg.role == "tool") {
                parts = ({
                    "functionResponse": {
                        "name": msg.name ?? msg.tool_call_id ?? "tool_result",
                        "response": parseGeminiToolResponse(msg.content),
                    },
                },);
                push contents, {"role": "user", "parts": parts};
                continue;
            }

            parts = buildGeminiContentParts(msg);
            if (msg.role == "assistant" && msg.tool_calls) {
                foreach hash<QoreLlmUtils::ChatToolCall> tc in (msg.tool_calls) {
                    push parts, {
                        "functionCall": {
                            "name": tc.name,
                            "args": tc.arguments ?? {},
                        },
                    };
                }
            }
            if (!parts) {
                parts = ({"text": msg.content ?? ""},);
            }
            push contents, {
                "role": msg.role == "assistant" ? "model" : "user",
                "parts": parts,
            };
        }

        hash<auto!> body;
        body.contents = contents;
        if (system_parts) {
            body.systemInstruction = {"parts": system_parts};
        }

        hash<auto!> generation_config = {
            "maxOutputTokens": getRequestMaxOutputTokens(opts),
            "temperature": getRequestTemperature(opts),
        };
        *int reasoning_budget = getRequestReasoningTokenBudget(opts);
        if (reasoning_budget.typeCode() != NT_NOTHING) {
            generation_config.thinkingConfig = {
                "thinkingBudget": reasoning_budget,
            };
        }
        if (output_schema) {
            generation_config.responseMimeType = "application/json";
            generation_config.responseSchema = sanitizeGeminiSchema(
                output_schema);
        }
        body.generationConfig = generation_config;

        if (tools && tools.size()) {
            list<hash<auto>> declarations = ();
            foreach hash<QoreLlmUtils::ToolDefinition> td in (tools) {
                push declarations, {
                    "name": td.name,
                    "description": td.description ?? "",
                    "parameters": sanitizeGeminiSchema(td.parameters)
                        ?? {"type": "object", "properties": {}},
                };
            }
            body.tools = ({"functionDeclarations": declarations},);
        }
        return mergeRequestBodyOptions(body, opts);
    }

    #! Returns a Gemini-compatible copy of a JSON schema
    /** Gemini's function declarations and response schemas accept only a
        subset of JSON Schema / OpenAPI.  In particular,
        \c additionalProperties causes \c generateContent to reject the
        request with HTTP 400 even when it is a boolean.  Strip unsupported
        schema keywords at the provider boundary so callers can keep using
        stricter OpenAI/Anthropic schemas and local validators.
    */
    private static *hash<auto> sanitizeGeminiSchema(*hash<auto> schema) {
        if (!schema) {
            return NOTHING;
        }
        return cast<hash<auto>>(sanitizeGeminiSchemaValue(schema));
    }

    private static auto sanitizeGeminiSchemaValue(auto value) {
        if (value.typeCode() == NT_HASH) {
            hash<auto> rv;
            foreach string key in (keys value) {
                if (key == "additionalProperties") {
                    continue;
                }
                rv{key} = sanitizeGeminiSchemaValue(value{key});
            }
            return rv;
        }
        if (value.typeCode() == NT_LIST) {
            list<auto> rv = ();
            foreach auto item in (value) {
                push rv, sanitizeGeminiSchemaValue(item);
            }
            return rv;
        }
        return value;
    }

    #! Builds Gemini content parts from a generic @ref QoreLlmUtils::ChatMessage
    private static list<hash<auto>> buildGeminiContentParts(
            hash<QoreLlmUtils::ChatMessage> msg) {
        list<hash<auto>> parts = ();
        if (msg.content_parts) {
            foreach hash<QoreLlmUtils::ContentPart> part in (msg.content_parts) {
                if (part.type == "image" && part.data) {
                    push parts, {
                        "inlineData": {
                            "mimeType": part.mime_type ?? "image/png",
                            "data": make_base64_string(part.data),
                        },
                    };
                } else if (part.type == "file" && part.data) {
                    push parts, {
                        "inlineData": {
                            "mimeType": part.mime_type
                                ?? "application/octet-stream",
                            "data": make_base64_string(part.data),
                        },
                    };
                } else if (part.type == "text" && part.text.val()) {
                    push parts, {"text": part.text};
                }
            }
        } else if (msg.content.val()) {
            push parts, {"text": msg.content};
        }
        return parts;
    }

    #! Parses an OpenAI-style tool-result string into Gemini \c functionResponse.response
    private static hash<auto> parseGeminiToolResponse(*string content) {
        if (!content.val()) {
            return {};
        }
        try {
            auto parsed = parse_json(content);
            return parsed.typeCode() == NT_HASH
                ? cast<hash<auto>>(parsed)
                : {"result": parsed};
        } catch () {
            return {"result": content};
        }
    }

    #! Parses a Gemini response into a generic @ref QoreLlmUtils::ChatResponse
    private static hash<QoreLlmUtils::ChatResponse> parseGeminiChatResponse(
            hash<auto> body) {
        hash<auto> cand = body.candidates[0] ?? {};
        list<string> text_parts = ();
        *list<hash<QoreLlmUtils::ChatToolCall>> tool_calls;
        int tc_index;
        foreach hash<auto> part in (cand.content.parts ?? ()) {
            if (part.text.val()) {
                push text_parts, part.text;
            } else if (part.functionCall) {
                if (!tool_calls) {
                    tool_calls = ();
                }
                push tool_calls, <QoreLlmUtils::ChatToolCall>{
                    "id": part.functionCall.id ?? sprintf("gemini-tool-%d",
                        ++tc_index),
                    "name": part.functionCall.name,
                    "arguments": part.functionCall.args ?? {},
                };
            }
        }

        return <QoreLlmUtils::ChatResponse>{
            "id": body.responseId ?? body.id,
            "model": body.model,
            "stop_reason": tool_calls ? "tool_use"
                : mapGeminiFinishReason(cand.finishReason),
            "content": text_parts ? text_parts.join("") : NOTHING,
            "tool_calls": tool_calls,
            "usage": normalizeGeminiUsage(body.usageMetadata),
            "raw": body,
            "provider_diagnostics": getGeminiProviderDiagnostics(body, cand),
        };
    }

    #! Extracts Gemini-specific diagnostics for provider-neutral callers
    private static *hash<auto> getGeminiProviderDiagnostics(
            hash<auto> body, hash<auto> cand) {
        hash<auto!> rv;
        if (body.responseId.val()) {
            rv.response_id = body.responseId;
        }
        if (body.promptFeedback.typeCode() == NT_HASH) {
            rv.prompt_feedback = body.promptFeedback;
        }
        if (body.usageMetadata.typeCode() == NT_HASH) {
            rv.usage_metadata = body.usageMetadata;
        }
        if (cand.finishReason.val()) {
            rv.finish_reason = cand.finishReason;
        }
        if (cand.finishMessage.val()) {
            rv.finish_message = cand.finishMessage;
        }
        if (cand.safetyRatings.typeCode() == NT_LIST) {
            rv.safety_ratings = cand.safetyRatings;
        }
        return rv ? rv : NOTHING;
    }

    #! Extracts text parts from a Gemini response/chunk
    private static string extractGeminiText(hash<auto> body) {
        list<string> parts = ();
        foreach hash<auto> part in (body.candidates[0].content.parts ?? ()) {
            if (part.text.val()) {
                push parts, part.text;
            }
        }
        return parts.join("");
    }

    #! Maps Gemini usage metadata to the OpenAI-style counters
    private static hash<auto> normalizeGeminiUsage(auto usage) {
        int prompt_tokens = usage.promptTokenCount ?? 0;
        int completion_tokens = usage.candidatesTokenCount ?? 0;
        int total_tokens = usage.totalTokenCount
            ?? (prompt_tokens + completion_tokens);
        return {
            "prompt_tokens": prompt_tokens,
            "completion_tokens": completion_tokens,
            "total_tokens": total_tokens,
            "input_tokens": prompt_tokens,
            "output_tokens": completion_tokens,
        };
    }

    #! Maps Gemini \c finishReason values to QoreLlmUtils stop reasons
    private static string mapGeminiFinishReason(*string reason) {
        switch (reason) {
            case "STOP":
                return "end_turn";
            case "MAX_TOKENS":
                return "max_tokens";
            case "SAFETY":
            case "RECITATION":
                return "stop_sequence";
            default:
                return reason ?? "end_turn";
        }
    }

    #! Maps Gemini \c finishReason values to OpenAI \c finish_reason values
    private static string geminiFinishReasonToOpenAi(*string reason) {
        switch (reason) {
            case "STOP":
                return "stop";
            case "MAX_TOKENS":
                return "length";
            case "SAFETY":
            case "RECITATION":
                return "content_filter";
            default:
                return reason ?? "stop";
        }
    }

    #! Translates an OpenAI \c tool_choice value to a Gemini \c toolConfig
    private static *hash<auto> openAiToolChoiceToGeminiConfig(auto choice) {
        if (!exists choice) {
            return NOTHING;
        }
        hash<auto!> cfg;
        if (choice == "none") {
            cfg.functionCallingConfig = {"mode": "NONE"};
        } else if (choice == "required") {
            cfg.functionCallingConfig = {"mode": "ANY"};
        } else if (choice == "auto") {
            cfg.functionCallingConfig = {"mode": "AUTO"};
        } else if (choice.typeCode() == NT_HASH && choice.function.name.val()) {
            cfg.functionCallingConfig = {
                "mode": "ANY",
                "allowedFunctionNames": (choice.function.name,),
            };
        }
        return cfg ? cfg : NOTHING;
    }
}

#! Factory for @ref GeminiLlmProvider
public class GeminiLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "gemini";
    }

    string getDisplayName() {
        return "Google Gemini generateContent";
    }

    QoreLlmUtils::AbstractLlmProvider create(
            hash<QoreLlmUtils::LlmBackendConfig> config) {
        return new GeminiLlmProvider(config);
    }

    hash<QoreLlmUtils::LlmProviderInfo> getInfo() {
        return <QoreLlmUtils::LlmProviderInfo>{
            "mode": getMode(),
            "display_name": getDisplayName(),
            "module_name": Class::getClass(self).getModuleName(),
            "supports_streaming": True,
            "supports_tools": True,
            "supports_structured_output": True,
            "supports_multimodal": True,
            "supports_reasoning_token_budget": True,
        };
    }
}
}

public namespace QoreRagUtils {
#! Google Gemini-backed embedder — calls the Gemini \c batchEmbedContents API
/** Wraps @ref GeminiRestClient::GeminiRestClientIo "GeminiRestClientIo".

    @par Configuration

    - \c api_key (required): Google Gemini API key; passed via the
      \c x-goog-api-key header
    - \c url (optional): override the default Gemini URL
    - \c model (optional): model name, default \c "gemini-embedding-001"
    - \c dimension (optional): forwarded as \c outputDimensionality; when
      unset the dimension is auto-detected on first call
    - \c options.taskType (optional): forwarded as Gemini \c taskType
    - \c timeout (optional): default request timeout (per-call \c opts override
      takes precedence)
    - \c connect_timeout (optional): default connection timeout (per-call
      \c opts override takes precedence)
*/
public class GeminiEmbedder inherits AbstractEmbedder {
    public {
        #! Default Gemini embedding model
        const DefaultModel = "gemini-embedding-001";

        #! Backend identifier reported in @c EMBEDDER-MODEL-CONFIG-ERROR
        const Backend = "gemini";

        #! Maximum texts sent to one batchEmbedContents request
        const MaxBatch = 100;
    }

    private {
        #! Captured configuration
        hash<EmbedderConfig> config;
        #! Resolved model name
        string model_name;
        #! Lazily-created REST client
        *GeminiRestClient::GeminiRestClientIo rest_client;
        #! Cached embedding dimension (from config or auto-detected)
        *int cached_dimension;
        #! Guard for lazy initialization and cached dimension updates
        Mutex init_mutex();
    }

    #! Creates the embedder
    /** @param config embedder configuration; \c api_key must be set

        @throw EMBEDDER-CONFIG-ERROR if required fields are missing
    */
    constructor(hash<EmbedderConfig> config) {
        if (!config.api_key.val()) {
            throw "EMBEDDER-CONFIG-ERROR",
                "GeminiEmbedder requires 'api_key' in EmbedderConfig";
        }
        self.config = config;
        model_name = config.model ?? DefaultModel;
        if (exists config.dimension) {
            cached_dimension = config.dimension;
        }
    }

    list<float> encode(string text, *hash<auto> opts) {
        list<list<float>> rv = encodeBatch((text,), opts);
        return rv[0];
    }

    list<list<float>> encodeBatch(list<string> texts, *hash<auto> opts) {
        if (!texts) {
            return ();
        }

        GeminiRestClient::GeminiRestClientIo client = pickRestClient(opts);
        list<list<float>> result = ();
        int offset;
        while (offset < texts.size()) {
            int end = offset + MaxBatch;
            if (end > texts.size()) {
                end = texts.size();
            }
            result += encodeBatchSlice(client, texts[offset .. end - 1]);
            offset = end;
        }
        return result;
    }

    int getDimension() {
        *int dimension = getCachedDimension();
        if (exists dimension) {
            return dimension;
        }
        encode(" ");
        dimension = getCachedDimension();
        return dimension ?? -1;
    }

    *string getModel() {
        return model_name;
    }

    private list<list<float>> encodeBatchSlice(
            GeminiRestClient::GeminiRestClientIo client, list<string> texts) {
        string resource = getModelResourceName();
        list<hash<auto>> requests = ();
        foreach string text in (texts) {
            hash<auto!> req = {
                "model": resource,
                "content": {
                    "parts": ({"text": text},),
                },
            };
            *int dimension = getCachedDimension();
            if (exists dimension) {
                req.outputDimensionality = dimension;
            }
            if (config.options.taskType.val()) {
                req.taskType = config.options.taskType;
            }
            push requests, req;
        }

        hash<auto> resp;
        try {
            resp = client.restPost(resource + ":batchEmbedContents",
                {"requests": requests});
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "REST-RESPONSE-ERROR" && isPermanentEmbedderConfigError(ex)) {
                throwEmbedderModelConfigError(ex, Backend, model_name);
            }
            rethrow;
        }

        *list<auto> embeddings = resp.body.embeddings;
        if (!exists embeddings) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response missing 'embeddings' field", Backend),
                {"body": resp.body};
        }
        if (embeddings.size() != texts.size()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned %d embeddings for %d input texts",
                    Backend, embeddings.size(), texts.size()),
                {"body": resp.body};
        }

        list<list<float>> result = ();
        foreach hash<auto> item in (embeddings) {
            list<float> vec = validateAndCastVector(item.values, resp.body);
            setCachedDimensionIfMissing(vec.size());
            push result, vec;
        }
        return result;
    }

    private *int getCachedDimension() {
        init_mutex.lock();
        on_exit init_mutex.unlock();
        return cached_dimension;
    }

    private setCachedDimensionIfMissing(int dimension) {
        init_mutex.lock();
        on_exit init_mutex.unlock();
        if (!exists cached_dimension) {
            cached_dimension = dimension;
        }
    }

    private string getModelResourceName() {
        if (model_name =~ /^models\//) {
            return model_name;
        }
        return "models/" + model_name;
    }

    private bool isPermanentEmbedderConfigError(hash<ExceptionInfo> ex) {
        *int status_code = ex.arg.status_code;
        if (status_code != 400 && status_code != 404) {
            return False;
        }
        auto body = ex.arg.body;
        *string status = body.error.status ?? body.status;
        if (status == "NOT_FOUND") {
            return True;
        }
        *string message = body.error.message ?? body.message ?? body.error;
        if (!exists message && body.typeCode() == NT_STRING) {
            message = body;
        }
        if (!exists message) {
            return False;
        }
        string lower = message.lwr();
        if (lower.find("model") == -1 && lower.find("embedding") == -1) {
            return False;
        }
        return status == "INVALID_ARGUMENT"
            || lower.find("not found") != -1
            || lower.find("does not exist") != -1
            || lower.find("invalid model") != -1
            || lower.find("unsupported model") != -1
            || lower.find("does not support embeddings") != -1
            || lower.find("not an embedding") != -1;
    }

    private list<float> validateAndCastVector(auto raw, auto body) {
        if (!exists raw) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response item missing 'values' field", Backend),
                {"body": body};
        }
        if (raw.typeCode() != NT_LIST || !raw.lsize()) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response returned an empty or non-list vector",
                    Backend),
                {"body": body};
        }
        try {
            return cast<list<float>>(raw);
        } catch (hash<ExceptionInfo> ex) {
            throw "EMBEDDER-RESPONSE-ERROR",
                sprintf("%s: response vector contains non-numeric elements: %s",
                    Backend, ex.desc),
                {"body": body};
        }
    }

    private GeminiRestClient::GeminiRestClientIo pickRestClient(*hash<auto> opts) {
        if (exists opts.timeout || exists opts.connect_timeout) {
            return new GeminiRestClient::GeminiRestClientIo(
                buildRestOptions(opts.timeout, opts.connect_timeout));
        }
        ensureRestClient();
        return rest_client;
    }

    private hash<auto> buildRestOptions(*timeout req_timeout, *timeout conn_timeout) {
        hash<auto!> opts = {
            "apikey": config.api_key,
        };
        if (config.url.val()) {
            opts.url = config.url;
        }
        *timeout effective_timeout = req_timeout ?? config.timeout;
        if (exists effective_timeout) {
            opts.timeout = effective_timeout;
        }
        *timeout effective_connect = conn_timeout ?? config.connect_timeout;
        if (exists effective_connect) {
            opts.connect_timeout = effective_connect;
        }
        return opts;
    }

    private ensureRestClient() {
        if (!rest_client) {
            init_mutex.lock();
            on_exit init_mutex.unlock();
            if (!rest_client) {
                rest_client = new GeminiRestClient::GeminiRestClientIo(
                    buildRestOptions());
            }
        }
    }
}

#! Factory for @ref GeminiEmbedder
public class GeminiEmbedderFactory inherits AbstractEmbedderFactory {
    string getType() {
        return "gemini";
    }

    string getDisplayName() {
        return "Google Gemini embeddings";
    }

    AbstractEmbedder create(hash<EmbedderConfig> config) {
        return new GeminiEmbedder(config);
    }
}
}
