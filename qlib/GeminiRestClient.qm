# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires HttpClientStreamingIo

module GeminiRestClient {
    version = "1.0";
    desc = "user module for calling Google Gemini REST API services";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("gemini", GeminiRestConnection::ConnectionScheme);
    };
}

/** @mainpage GeminiRestClient Module

    @tableofcontents

    @section geminirestclientintro GeminiRestClient Module Introduction

    The %GeminiRestClient module provides an API for calling Google Gemini REST API services.

    To use this module, use \c "%requires GeminiRestClient" in your code.

    All the public symbols in the module are defined in the GeminiRestClient namespace.

    The main classes are:
    - @ref GeminiRestClient::GeminiRestClient "GeminiRestClient":
      this class provides the REST client API for communication with the Google Gemini REST
      API; it also automates authentication and authorization to the target
    - @ref GeminiRestClient::GeminiRestConnection "GeminiRestConnection":
      provides a REST connection object to Google Gemini cloud services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires GeminiRestClient
%requires ConnectionProvider

GeminiRestClient rest({"apikey": api_key});
hash<auto> ans = rest.get("v1beta/models");
printf("%N\n", ans.body);
    @endcode

    @par Streaming Example:
    @code{.py}
GeminiRestClientIo rest({"apikey": api_key});
GeminiResponseSseStreamIo stream = rest.openStreamingConnection("gemini-2.5-flash", {
    "contents": (
        {"role": "user", "parts": ({"text": "Stream a response"},)},
    ),
});
while (*hash<SseMessageInfo> evt = stream.readEvent(5s)) {
    printf("%s\n", evt.data);
}
stream.close();
    @endcode

    @section GeminiRestClientRelnotes Release Notes

    @subsection GeminiRestClientv1_0 GeminiRestClient v1.0
    - the initial version of the %GeminiRestClient module
*/

%try-module json
%define NoJson
%endtry

#! the GeminiRestClient namespace contains all the objects in the GeminiRestClient module
public namespace GeminiRestClient {
#! Common base class for GeminiRestClient functionality
public class GeminiRestClientBase {
    public {
        #! Default Gemini REST API URL
        const DefaultUrl = "https://generativelanguage.googleapis.com";

        #! Default Gemini API version
        const DefaultApiVersion = "v1beta";

        #! Default data serialization
        const DefaultData = "json";

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "data": DefaultData,
            "default_path": "/" + DefaultApiVersion,
        };

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default ping path
        const DefaultPingPath = "models";
    }

    #! Returns options for the constructor
    /** Maps the \c apikey option to the \c x-goog-api-key header
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        # Map apikey to x-goog-api-key header
        if (rv.apikey) {
            hash<auto> hdr = rv.headers ?? {};
            hdr."x-goog-api-key" = rv.apikey;
            rv += {"headers": hdr};
            delete rv.apikey;
        }
        return rv;
    }
}

#! This class provides the REST client API for communication with Google Gemini servers
/** You must use an API key in the \c apikey option to call Gemini APIs.

    The API key is sent as the \c x-goog-api-key header.
*/
public class GeminiRestClient inherits RestClient::RestClient, GeminiRestClientBase {
    #! Creates the object with the given options
    /**
        @par Example:
        @code{.py}
GeminiRestClient rest({"apikey": api_key});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class; note
        that the URL is set by default if not provided (see @ref DefaultUrl).
        Additional options:
        - \c apikey: the Google Gemini API key (required)
        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(GeminiRestClientBase::getOptions(opts), do_not_connect) {
    }

    #! Opens a Server-Sent Events stream for streaming content generation
    /** @param model the model name (e.g., "gemini-2.5-flash")
        @param req the request body
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading

        @return an SSE stream object for reading events incrementally
    */
    GeminiResponseSseStream openStreamingConnection(string model, hash<auto> req, *hash<auto> hdr, *timeout to) {
        return new GeminiResponseSseStream(self, model, req, hdr, to);
    }
}

#! SSE connection for Gemini streaming content generation
public class GeminiResponseSseStream {
    private {
        GeminiRestClient rest;
        bool chunked;
        string content_encoding;
        StringOutputStream ostream;
        TransformOutputStream dstream;
        bool use_decompressor;
        timeout timeout_ms = 15s;
        bool closed;

        const SseMimeType = "text/event-stream";
    }

    #! Creates the stream connection
    constructor(GeminiRestClient rest, string model, *auto body, *hash<auto> hdr, *timeout to) {
        self.rest = rest;
        if (to) {
            timeout_ms = to;
        }
        hash<auto> headers = rest.getDefaultHeaders() + (hdr ?? {});
        headers.Accept = SseMimeType;
        data payload;
        if (exists body) {
            payload = getSerializedBody(body, \headers);
        }
        string full_path = buildPath("models/" + model + ":streamGenerateContent?alt=sse");
        hash<auto> info;
        hash<auto> resp = rest.send(payload, "POST", full_path, headers, False, \info);
        if (resp.status_code != 200) {
            throw "SSE-ERROR", sprintf("unexpected status code %d %s", resp.status_code, resp.status_message);
        }
        string content_type = normalizeContentType(resp."content-type");
        if (content_type != SseMimeType) {
            throw "SSE-ERROR", sprintf("expected Content-Type %y but got %y", SseMimeType, resp."content-type");
        }
        if (resp."content-encoding".val()) {
            content_encoding = tolower(resp."content-encoding");
        }
        if (resp."transfer-encoding".val()) {
            string transfer_encoding = tolower(resp."transfer-encoding");
            if (transfer_encoding == "chunked") {
                chunked = True;
            } else {
                throw "SSE-ERROR", sprintf("unsupported Transfer-Encoding: %y", resp."transfer-encoding");
            }
        }
        setupDecompression();
    }

    #! Reads the next SSE message
    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (closed) {
            return;
        }
        timeout use_to = to ?? timeout_ms;
        if (chunked) {
            hash<auto> hh = rest.readHTTPChunk(use_to);
            if (!hh.body) {
                return;
            }
            if (use_decompressor) {
                dstream.write(hh.body);
            } else {
                ostream.write(hh.body);
            }
            return rest.parseServerSentEvent(ostream.getData());
        }
        return rest.readServerSentEvent(content_encoding, use_to);
    }

    #! Closes the stream connection
    close() {
        if (!closed) {
            closed = True;
            rest.disconnect();
        }
    }

    private string buildPath(string path) {
        string rv = path;
        rv =~ s/^\/+//;
        rv = "/" + rv;
        *string defp = rest.getDefaultPath();
        if (defp.val() && defp != "/") {
            defp =~ s/\/+$//;
            if (defp !~ /^\//) {
                defp = "/" + defp;
            }
            rv = defp + rv;
        }
        return rv;
    }

    private data getSerializedBody(data body, reference<hash<auto>> headers) {
        if (body.typeCode() == NT_STRING) {
            if (!headers."Content-Type") {
                headers."Content-Type" = "application/json";
            }
            return body;
        }
%ifdef NoJson
        throw "SSE-ERROR", "json module is required to serialize SSE request body";
%else
        if (!headers."Content-Type") {
            headers."Content-Type" = "application/json";
        }
        return call_function_args("to_json", (body,));
%endif
    }

    private setupDecompression() {
        if (!chunked) {
            return;
        }
        ostream = new StringOutputStream();
        Transform decompressor;
        switch (content_encoding) {
            case "deflate":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_ZLIB);
                break;
            case "gzip":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_GZIP);
                break;
            case "bzip2":
                use_decompressor = True;
                decompressor = get_decompressor(Qore::COMPRESSION_ALG_BZIP2);
                break;
            case NOTHING:
            case "identity":
                use_decompressor = False;
                break;

            default:
                throw "ENCODING-ERROR", sprintf("Don't know how to handle Content-Encoding %y", content_encoding);
        }
        if (use_decompressor) {
            dstream = new TransformOutputStream(ostream, decompressor);
        }
    }

    private static string normalizeContentType(*string content_type) {
        if (!content_type.val()) {
            return "";
        }
        string rv = content_type;
        rv =~ s/\s*;.*$//;
        rv =~ s/^\s+//;
        rv =~ s/\s+$//;
        return tolower(rv);
    }
}

#! REST client for Google Gemini REST API using multiplexed HTTP connections
/** @see GeminiRestClient for more information
*/
public class GeminiRestClientIo inherits RestClientIo::RestClientIo, GeminiRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(GeminiRestClientBase::getOptions(opts), shared_mgr) {
    }

    #! Opens a Server-Sent Events stream for streaming content generation using async I/O
    /** Uses HttpClientIo and SseStreamReader for incremental SSE event delivery
        across HTTP/1.x, HTTP/2, and HTTP/3.

        @param model the model name (e.g., "gemini-2.5-flash")
        @param req the request body (will be serialized to JSON)
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading

        @return an SSE stream object for reading events incrementally

        @par Example:
        @code{.py}
GeminiRestClientIo rest({"apikey": api_key});
GeminiResponseSseStreamIo stream = rest.openStreamingConnection("gemini-2.5-flash", {
    "contents": ({"role": "user", "parts": ({"text": "Hello!"},)},),
});
while (*hash<SseMessageInfo> evt = stream.readEvent()) {
    printf("Event: %y\n", evt.data);
}
        @endcode
    */
    GeminiResponseSseStreamIo openStreamingConnection(string model, hash<auto> req, *hash<auto> hdr, *timeout to) {
        return new GeminiResponseSseStreamIo(self, model, req, hdr, to);
    }
}

#! SSE stream for Gemini streaming content generation using async I/O (HttpClientIo + SseStreamReader)
/** Works across HTTP/1.x, HTTP/2, and HTTP/3 via HttpClientIo's multiplexed
    connection manager.

    @note This class is \b not thread-safe.  Use from a single reader thread.
*/
public class GeminiResponseSseStreamIo {
    private {
        #! SSE stream reader
        HttpClientStreamingIo::SseStreamReader reader;

        #! Timeout for SSE event reading
        timeout timeout_ms = 15s;

        #! True when the stream has been closed
        bool closed = False;
    }

    #! Creates the SSE stream connection
    /** @param rest the GeminiRestClientIo instance
        @param model the model name (e.g., "gemini-2.5-flash")
        @param body the request body (serialized to JSON)
        @param hdr optional additional request headers
        @param to optional timeout for SSE event reading
    */
    constructor(GeminiRestClientIo rest, string model, *auto body, *hash<auto> hdr, *timeout to) {
        if (to) {
            timeout_ms = to;
        }
        hash<auto> headers = rest.getDefaultHeaders() + (hdr ?? {});
        headers.Accept = "text/event-stream";

        # Serialize body to JSON
        *data payload;
        if (exists body) {
%ifdef NoJson
            throw "SSE-ERROR", "json module is required to serialize SSE request body";
%else
            if (body.typeCode() != NT_STRING) {
                if (!headers."Content-Type") {
                    headers."Content-Type" = "application/json";
                }
                payload = call_function_args("to_json", (body,));
            } else {
                if (!headers."Content-Type") {
                    headers."Content-Type" = "application/json";
                }
                payload = body;
            }
%endif
        }

        # Build full path: /v1beta/models/{model}:streamGenerateContent?alt=sse
        string full_path = buildPath(rest, "models/" + model + ":streamGenerateContent?alt=sse");

        # Acquire stream and start SSE streaming
        HttpClientIo::HttpClientConnectionManager mgr = rest.getConnectionManager();
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(rest.getUrl());
        stream.startStreaming("POST", full_path, headers, False, payload);

        reader = new HttpClientStreamingIo::SseStreamReader(stream);
    }

    #! Reads the next SSE event
    /** @param to optional timeout override
        @return the parsed SSE event, or NOTHING on timeout or stream end
    */
    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (closed) {
            return NOTHING;
        }
        return reader.readEvent(to ?? timeout_ms);
    }

    #! Returns True if the stream has ended
    bool isDone() {
        return closed || reader.isDone();
    }

    #! Closes the stream
    close() {
        if (!closed) {
            closed = True;
            reader.cancel();
        }
    }

    #! Builds the full API path from connection path + relative path
    private static string buildPath(RestClientIo::RestClientIo rest, string path) {
        string rv = path;
        rv =~ s/^\/+//;
        rv = "/" + rv;
        *string base = rest.getConnectionPath();
        if (base.val() && base != "/") {
            base =~ s/\/+$//;
            if (base !~ /^\//) {
                base = "/" + base;
            }
            rv = base + rv;
        }
        return rv;
    }
}

#! Class for Gemini REST connections; returns @ref GeminiRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestConnection"

    @see @ref GeminiRestClient::GeminiRestClient::constructor() for more information on the above options
*/
public class GeminiRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Gemini REST API URL
        const DefaultUrl = "gemini://generativelanguage.googleapis.com";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Google Gemini REST Connection",
            "short_desc": "A connection to the Google Gemini REST API",
            "desc": "A connection to the [Google Gemini](https://ai.google.dev) REST API for generative AI "
                "services including text generation, embeddings, and multimodal content.\n\n"
                "An API key is required for authentication. To obtain one, visit the "
                "[Google AI Studio](https://aistudio.google.com/apikey) and create a new API key",
            "cls": Class::forName("GeminiRestConnection"),
            "auto_url": True,
            "schemes": {
                "gemini": True,
            },
            "base_scheme_map": {
                "https": "gemini",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Google Gemini API key for authentication",
                    "type": "string",
                    "desc": "The Google Gemini API key used for authentication; sent as the `x-goog-api-key` "
                        "header. To obtain a key, visit "
                        "[Google AI Studio](https://aistudio.google.com/apikey)",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": GeminiRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": GeminiRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": GeminiRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Get Your Google Gemini API Key",
                    "intent": "info",
                    "content": "To connect to Google Gemini, you need an API key:\n\n"
                        "1. Go to [Google AI Studio](https://aistudio.google.com/apikey)\n"
                        "2. Sign in with your Google account\n"
                        "3. Click **Create API Key**\n"
                        "4. Copy the generated key\n\n"
                        "Keep your API key secure and never share it publicly.",
                },
            ),
        };
    }

    #! Creates the GeminiRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! Creates the GeminiRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    #! Returns \c "gemini"
    string getType() {
        return "gemini";
    }

    #! Returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the GeminiDataProvider and creates the data provider
        # object dynamically
        load_module("GeminiDataProvider");
        return create_object("GeminiDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            # Auto-correct ping path - remove leading slash
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! Returns connection options with apikey translated to x-goog-api-key header
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> opts = RestConnection::getConnectionOptions(rtopts);
        return GeminiRestClientBase::getOptions(opts);
    }

    #! Returns a @ref GeminiRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref GeminiRestClient object
    */
    private GeminiRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new GeminiRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new GeminiRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
