# minimum qore version
%requires qore >= 2.0

# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module CircleRestClient {
    version = "1.0";
    desc = "User module for calling Circle REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("circlerest", CircleRestConnection::ConnectionScheme);
    };
}

/** @mainpage CircleRestClient Module

    @tableofcontents

    @section circlerestclientintro CircleRestClient Introduction

    The %CircleRestClient module provides an API for calling Circle REST API services.

    To use this module, use \c "%requires CircleRestClient" in your code.

    All the public symbols in the module are defined in the CircleRestClient namespace.

    The main classes are:
    - @ref CircleRestClient::CircleRestClient "CircleRestClient":
      this class provides the REST client API for communication with the Circle API;
      it handles API key / Bearer token authentication
    - @ref CircleRestClient::CircleRestConnection "CircleRestConnection":
      provides a connection object to Circle services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @section circlerestclientrelnotes Release Notes

    @subsection circlerestclientv1_0 CircleRestClient v1.0
    - the initial version of the %CircleRestClient module
*/

#! the CircleRestClient namespace contains all the objects in the CircleRestClient module
public namespace CircleRestClient {

#! Common base class for CircleRestClient functionality
public class CircleRestClientBase {
    public {
        #! Default Circle API URL
        const DefaultUrl = "https://app.circle.so";

        #! Default API version path
        const DefaultApiVersion = "api/admin/v2";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since default_path provides /api/admin/v2)
        const DefaultPingPath = "spaces";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "default_path": "/" + DefaultApiVersion,
            "headers": DefaultHeaders,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "url": DefaultUrl,
        };

        #! Default connection URL
        const DefaultConnectionUrl = "circlerest://app.circle.so";
    }

    #! returns options for the CircleRestClient constructor
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Ensure URL is always set (auto_url connections may pass NOTHING)
        if (!rv.url) {
            rv.url = DefaultUrl;
        }

        if (opts.apikey) {
            # API key / Bearer token mode
            rv.headers.Authorization = "Bearer " + opts.apikey;
        }

        # Always remove apikey from options to prevent RestClient misinterpretation
        remove rv.apikey;

        return rv;
    }
}

#! This class provides the REST client API for communication with Circle servers
/** Circle uses a REST API at https://app.circle.so/api/admin/v2 with Bearer token
    authentication.

    @par Authentication:
    - API key / Bearer token via Authorization header
    - Token obtained from Developers > Tokens in Circle community settings

    @par API Structure:
    All endpoints are under /api/admin/v2 (set via default_path)
*/
public class CircleRestClient inherits RestClient::RestClient, CircleRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
CircleRestClient circle({
    "apikey": ENV.CIRCLE_API_TOKEN,
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the Circle API token (Bearer token)

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(CircleRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Circle REST connections; returns @ref CircleRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref CircleRestClient::CircleRestClient::constructor() for more information on the above
    options
*/
public class CircleRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Circle REST Connection",
            "short_desc": "A connection to the Circle REST API",
            "desc": "A connection to the Circle REST API for community management including "
                "posts, comments, members, spaces, events, and messaging",
            "cls": Class::forName("CircleRestConnection"),
            "auto_url": True,
            "schemes": {
                "circlerest": True,
            },
            "base_scheme_map": {
                "https": "circlerest",
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Generate Your API Token",
                    "intent": "info",
                    "content": "1. Log in to your Circle community at https://app.circle.so\n"
                        "2. Click on your community in the top-left corner\n"
                        "3. Select **Developer** > **Tokens**\n"
                        "4. Click **Create Token**, select **Admin V2** as the type\n"
                        "5. Copy the token and paste it into the **API Token** field\n\n"
                        "**Important:**\n"
                        "- API access requires a **Business plan** or above\n"
                        "- Rate limit: 2,000 requests per 5 minutes per IP\n"
                        "- Store your token securely; treat it like a password",
                },
            ),
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Token",
                    "short_desc": "Circle API token for authentication",
                    "type": "string",
                    "desc": "The Circle API token used for Bearer token authentication.\n\n"
                        "**To obtain your API token:**\n"
                        "1. Log in to your Circle community as an admin\n"
                        "2. Click on your community in the top-left corner\n"
                        "3. Select **Developer** > **Tokens**\n"
                        "4. Click **Create Token** and select **Admin V2**\n\n"
                        "**Note:** API access requires a Business plan or above.\n\n"
                        "Rate limit: 2,000 requests per 5 minutes per IP",
                    "sensitive": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": CircleRestClientBase::DefaultData,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": CircleRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": CircleRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": CircleRestClientBase::DefaultPingPath,
                },
            },
        };
    }

    #! creates the CircleRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and
        \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = CircleRestClientBase::DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the CircleRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(CircleRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref CircleRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        if (!config.url) {
            config.url = CircleRestClientBase::DefaultConnectionUrl;
        }
        return config;
    }

    #! returns \c "circlerest"
    string getType() {
        return "circlerest";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Circle";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the CircleDataProvider and creates
        # the data provider object dynamically
        load_module("CircleDataProvider");
        return create_object("CircleDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            if (url != CircleRestClientBase::DefaultConnectionUrl) {
                update.url = CircleRestClientBase::DefaultConnectionUrl;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref CircleRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter
        is ignored

        @return a @ref CircleRestClient object
    */
    private CircleRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new CircleRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since CircleRestClient 1.0
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new CircleRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Circle REST API using multiplexed HTTP connections
/** @see CircleRestClient for more information
*/
public class CircleRestClientIo inherits RestClientIo::RestClientIo, CircleRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(CircleRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
