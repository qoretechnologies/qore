        constructor(AbstractDatasource ds, *hash<auto> opts) : AbstractDatabase(ds, opts) {
        }

        #! returns a name as an SQL identifier for Firebird
        /** A name that Firebird reads as one unquoted identifier (an ASCII letter, then ASCII letters, digits,
            underscores or dollar signs) is returned as given, and Firebird folds it to upper case as for any unquoted
            name; a reserved word is returned in double quotes in the case given, as before; any other name is returned
            in upper case in double quotes, with each double quote doubled, so that it names the object that an unquoted
            name of the same letters would: SqlUtil looks up names in upper case on Firebird and gives the names that it
            reads from the database in lower case

            @par Example:
            @code{.py}
# "\"ORDER DATE\""
string sql = db.getSqlIdentifier("Order Date");
            @endcode

            @param name the name of a database object

            @return the name as an SQL identifier for Firebird

            @throw IDENTIFIER-ERROR the name is empty or has a NUL character

            @since XdbcFirebirdSqlUtilBase 0.2
        */
        string getSqlIdentifier(string name) {
            return firebird_get_sql_identifier(name);
        }

        #! Returns @ref True if the driver requires a scale to support decimal values in numeric or decimal columns
        /** @return @ref True if the driver requires a scale to support decimal values in numeric or decimal columns

            @since %XdbcFirebirdSqlUtilBase 1.4.3
        */
        bool requiresScale() {
            # an unqualified NUMERIC or DECIMAL column is NUMERIC(9,0) in Firebird, which silently truncates
            # decimal values, so an explicit scale is required to store them
            return True;
        }

        #! Returns the maximum precision for numeric or decimal columns
        /** @return -1 means, no maximum

            @since %XdbcFirebirdSqlUtilBase 1.4.3
        */
        int getMaximumPrecision() {
            return 18;
        }

        private list<string> featuresImpl() {
            return (DB_TABLES, DB_VIEWS, DB_SEQUENCES);
        }

        string getSchemaName() {
            return ds.getDBName();
        }

        private AbstractSequence makeSequenceImpl(string name, number start = 1, number increment = 1,
                *softnumber end, *hash<auto> opts) {
            return new XdbcFirebirdSequence(name, start, increment, end);
        }

        private *AbstractSequence getSequenceImpl(string name) {
            # the starting value and the increment are kept from Firebird 3 on
            *hash<auto> row = ds.selectRow("select rdb$generator_name as \"sequence\", "
                "rdb$initial_value as \"start\", rdb$generator_increment as \"increment\" from rdb$generators where "
                "rdb$system_flag = 0 and rdb$generator_name = %v", firebird_get_catalog_name(name));
            return row.sequence
                ? new XdbcFirebirdSequence(row.sequence.lwr(), row.start ?? 1, row.increment ?? 1)
                : NOTHING;
        }

        #! returns the view of the given name with its source, or no value if there is no such view
        /** @since XdbcFirebirdSqlUtilBase 0.2 views are read from the catalog; before, no view was ever found
        */
        private *AbstractView getViewImpl(string name) {
            *hash<auto> row = ds.selectRow("select rdb$view_source as \"src\" from rdb$relations "
                "where rdb$view_blr is not null and coalesce(rdb$system_flag, 0) = 0 and rdb$relation_name = %v",
                firebird_get_catalog_name(name));
            if (!row) {
                return;
            }

            return new XdbcFirebirdView(name, row.src);
        }

        private AbstractFunction makeFunctionImpl(string name, string src, *hash<auto> opts) {
            throw "UNSUPPORTED";
        }

        private AbstractFunction makeProcedureImpl(string name, string src, *hash<auto> opts) {
            throw "UNSUPPORTED";
        }

        private *AbstractFunction getFunctionImpl(string name) {
        }

        private *AbstractFunction getProcedureImpl(string name) {
        }

        private list<string> getDropSchemaSqlImpl(hash<auto> schema_hash, *hash<auto> opt) {
            return ();
        }

        private list<string> getAlignSqlImpl(hash schema_hash, *hash<auto> opt) {
            return ();
        }

        #! returns a list of string table names in the database
        private softlist<string> listTablesImpl() {
            return ds.select("select lower(a.rdb$relation_name) as \"name\" from rdb$relations a "
                "where coalesce(rdb$system_flag, 0) = 0 and rdb$relation_type = 0").name;
        }

        #! returns a list of string function names in the database
        /** The function names will include arguments in parentheses after the names

            @return a list of string function names in the database
        */
        private list<string> listFunctionsImpl() {
            return ();
        }

        #! returns a list of string procedure names in the database
        /** The procedure names will include arguments in parentheses after the names

            @return a list of string procedure names in the database
        */
        private list<string> listProceduresImpl() {
            return ();
        }

        #! returns the names of the sequences in the database, in lower case
        /** @since XdbcFirebirdSqlUtilBase 0.2 the sequences are listed; before, none were
        */
        private list<string> listSequencesImpl() {
            # a generator of an identity column has another system flag
            return ds.select("select lower(trim(rdb$generator_name)) as \"name\" from rdb$generators "
                "where rdb$system_flag = 0").name ?? ();
        }

        #! returns the names of the views in the database, in lower case
        /** @since XdbcFirebirdSqlUtilBase 0.2 the names are given in lower case, as the names of tables and
            sequences are; before, they were given in upper case
        */
        private list<string> listViewsImpl() {
            return ds.select("select lower(trim(rdb$relation_name)) as \"name\" from rdb$relations "
                "where rdb$view_blr is not null and coalesce(rdb$system_flag, 0) = 0").name ?? ();
        }

        private string getCreateSqlImpl(list<auto> l) {
            return XdbcFirebirdDatabase::getCreateSql(l);
        }

        static string getCreateSql(list<auto> l) {
            return !l ? "" : foldl $1 + "\n" + $2, (map sprintf("%s%s", $1, $1 =~ /(;|\$)$/ ? "" : ";"), l);
        }

        #! returns the next value in the given sequence
        private softint getNextSequenceValueImpl(string name) {
            # "%s" in SQL with arguments is substituted as given, so the name is given as an identifier here
            return ds.selectRow("select next value for " + firebird_get_sql_identifier(name)
                + " as \"nextval\" from rdb$database").nextval;
        }

        #! returns the last value issued for the given sequence in the current session
        private softint getCurrentSequenceValueImpl(string name) {
            return ds.selectRow("select gen_id(" + firebird_get_sql_identifier(name)
                + ", 0) as \"currentval\" from rdb$database").currentval;
        }

        #! returns @ref True "True" since we have a workaround implementation for sequences in XdbcFirebird
        private bool supportsSequencesImpl() {
            return True;
        }

        #! returns @ref True "True" if the database supports named types
        private bool supportsTypesImpl() {
            return False;
        }

        #! returns @ref True "True" if the database supports packages
        private bool supportsPackagesImpl() {
            return False;
        }

        #! rebuild index implementation. See @ref SqlUtil::AbstractDatabase::rebuildIndex()
        private bool rebuildIndexImpl(string name, *hash<auto> options) {
            throw "REBUILD-INDEX-ERROR", "Firebird does not support index rebuilding";
        }

        #! compute statistics implementation. See @ref SqlUtil::AbstractDatabase::computeStatistics()
        private computeStatisticsImpl(*hash<auto> options) {
        }

        #! reclaim space implementation. See @ref SqlUtil::AbstractDatabase::reclaimSpace()
        private reclaimSpaceImpl(*hash<auto> options) {
        }

        #! @ref SqlUtil::AbstractDatabase.getPhysicalSize()
        private int getPhysicalSizeImpl() {
            throw "UNSUPPORTED";
        }
    }

    #! provides the XdbcFirebird-specific implementation of the AbstractTable interface
    public class XdbcFirebirdTable inherits SqlUtil::AbstractTable {
        public {
            #! maps xdbcfirebird type names to type configurations
            const XdbcFirebirdTypeMap = {
                "bigint": {
                    "qore": Type::Int,
                },
                "binary": {
                    "qore": Type::Binary,
                    "size": SZ_MAND,
                    "size_range": (1, 32767),
                    "default_size": 1,
                },
                "blob": {
                    "qore": Type::Binary,
                },
                "blob sub_type text": {
                    "qore": Type::String,
                },
                "boolean": {
                    "qore": Type::Boolean,
                },
                "char": {
                    "qore": Type::String,
                    "size": SZ_MAND,
                    "size_range": (1, 32767),
                    "is_char": True,
                    "default_size": 1,
                },
                "date": {
                    "qore": Type::Date,
                },
                "decimal": {
                    "qore": Type::Number,
                    "size": SZ_NUM,
                    "size_range": (1, 38),
                    "scale_range": (0, 38),
                    # as for NUMERIC, an unqualified DECIMAL defaults to DECIMAL(9,0) in Firebird
                    "default_size": 18,
                },
                "double": {
                    "qore": Type::Float,
                    "size": SZ_NUM,
                },
                "double precision": {
                    "qore": Type::Float,
                    "size": SZ_NUM,
                },
                "float": {
                    "qore": Type::Float,
                    "size": SZ_NUM,
                },
                "int128": {
                    "qore": Type::String,
                },
                "integer": {
                    "qore": Type::Int,
                },
                "numeric": {
                    "qore": Type::Number,
                    "size": SZ_NUM,
                    # precisions over 18 are supported from Firebird 4 on and are backed by INT128
                    "size_range": (1, 38),
                    "scale_range": (0, 38),
                    # Firebird defaults an unqualified NUMERIC to NUMERIC(9,0); declare the widest int64-backed
                    # precision instead so that unsized numeric columns are not silently limited to 9 digits
                    "default_size": 18,
                },
                "real": {
                    "qore": Type::Float,
                    "size": SZ_NUM,
                },
                "smallint": {
                    "qore": Type::Int,
                },
                "time": {
                    "qore": Type::Date,
                },
                "time with time zone": {
                    "qore": Type::Date,
                },
                "timestamp": {
                    "qore": Type::Date,
                },
                "timestamp with time zone": {
                    "qore": Type::Date,
                },
                "varbinary": {
                    "qore": Type::Binary,
                    "size": SZ_MAND,
                    "size_range": (1, 32765),
                    "default_size": 1,
                },
                "varchar": {
                    "qore": Type::String,
                    "size": SZ_MAND,
                    "size_range": (1, 32765),
                    "is_char": True,
                    "default_size": 1,
                },
            };

            #! maps qore type names to XdbcFirebird type names
            const QoreTypeMap = (
                "integer": "bigint",
                "float": "double precision",
                "number": "numeric",
                "string": "varchar",
                "date": "timestamp",
                "binary": "blob",
                "bool": "boolean",
                SqlUtil::CHAR: "char",
                SqlUtil::CLOB: "blob sub_type text",
                SqlUtil::BLOB: "blob",
            );

            #! column operator specializations for XdbcFirebird
            const XdbcFirebirdCopMap = (
                COP_AS: {
                    "arg": Type::String,
                    "withalias": True,
                    "code": string sub (string cve, string arg, reference<hash<auto>> aliases) {
                        # issue #2163: make sure the unquoted alias is inserted in the map; the alias is given as a
                        # double-quoted identifier, with each double quote doubled (see
                        # XdbcFirebirdTable::getAliasSqlName()), or as an ordinary name
                        if (arg =~ /^".*"$/s) {
                            arg = replace(arg.substr(1, -1), "\"\"", "\"");
                        } else if (arg =~ /^`.*`$/s) {
                            arg = arg.substr(1, -1);
                        }
                        aliases{arg} = cve;
                        # an alias is always given in double quotes, so the result key has its case
                        return sprintf("%s as %s", cve, AbstractSqlUtilBase::getDelimitedIdentifier(arg, "\"", "\"",
                            "Firebird"));
                    },
                },
                COP_CAST: (
                    "code": string sub (string cve, list<auto> args) {
                        string name = QoreTypeMap{args[0]} ?? args[0];
                        *hash<auto> desc = XdbcFirebirdTypeMap{name};
                        string sql = sprintf ("cast (%s as %s", cve, name);
                        switch (name) {
                            default:
                                if (desc.size == SZ_MAND) {
                                    if (!exists args[1] && !exists desc.size_range) {
                                        throw "OPERATOR-ERROR", sprintf ("op_cast operator missing size for type %s",
                                            name);
                                    }
                                    sql += sprintf("(%d)", args[1] ?? desc.size_range[1]);
                                } else if (desc.size == SZ_NUM && exists args[1]) {
                                    sql += args[1] == "*" ? "(*" : sprintf("(%d", args[1]);
                                    sql += exists args[2] ? sprintf(",%d)", args[2]) : ")";
                                } else if (desc.size == SZ_OPT && exists args[1]) {
                                    sql += sprintf("(%d)", args[1]);
                                }
                        }
                        sql += ")";
                        return sql;
                    },
                ),
                COP_LENGTH: {
                    "code": string sub (string cve, auto arg) {
                        return sprintf("char_length(%s)", cve);
                    },
                },
                COP_PREPEND: (
                    "arg": Type::String,
                    "sqlvalue": True,
                    "code": string sub (string cve, string arg) {
                        return sprintf("%s || %s", arg, cve);
                    },
                ),
                COP_APPEND: (
                    "arg": Type::String,
                    "sqlvalue": True,
                    "code": string sub (string cve, string arg) {
                        return sprintf("%s || %s", cve, arg);
                    },
                )
            );

            #! Firebird operator map
            const FirebirdOpMap = DefaultOpMap + {
                OP_IN: AbstractDataProvider::GenericExpressions{DP_SEARCH_OP_IN} + (
                    "code": string sub (reference<hash<QueryInfo>> info, string cn, auto arg) {
                        # firebird accepts max 1500 args in "IN" lists
                        list<string> argl;
                        softlist<auto> args = arg;
                        while (args) {
                            list<auto> arg_slice = extract args, 0, 1500;
                            *string ins = (foldl $1 + "," + $2, (map info.table.getSqlValue($1), arg_slice));
                            if (ins) {
                                argl += ins;
                            }
                        }
                        if (!argl) {
                            return "1 != 1";
                        }
                        return "(" + (foldl $1 + " or " + $2, map sprintf("%s in (%s)", cn, $1), argl) + ")";
                    },
                ),
            };

            #! Firebird Expression map
            const FirebirdExpressionMap = DefaultExpressionMap + {
                # Firebird server-side digest via CRYPT_HASH (Firebird 4+), returning VARBINARY;
                # supports MD5, SHA1, SHA256, and SHA512 (the SHA-2 variants SHA224/SHA384 are not
                # available).  hex/base64 output use HEX_ENCODE()/BASE64_ENCODE() (Firebird 4+).
                DP_FUNC_DIGEST: DefaultExpressionMap{DP_FUNC_DIGEST} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string alg = sqlutil_normalize_digest_algorithm(args[1]);
                        string enc = sqlutil_normalize_digest_encoding(args[2]);
                        string v = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        hash<string, string> algmap = {
                            "md5": "MD5", "sha1": "SHA1", "sha256": "SHA256", "sha512": "SHA512",
                        };
                        *string falg = algmap{alg};
                        if (!falg) {
                            throw "DIGEST-ERROR", sprintf("digest algorithm %y is not supported by the "
                                "Firebird driver; supported algorithms: md5, sha1, sha256, sha512", alg);
                        }
                        # the algorithm is a CRYPT_HASH keyword, not a quoted string
                        string core = sprintf("crypt_hash(%s using %s)", v, falg);
                        switch (enc) {
                            case "binary":
                                return core;
                            case "hex":
                                return sprintf("lower(hex_encode(%s))", core);
                            case "base64":
                                return sprintf("base64_encode(%s)", core);
                        }
                        throw "DIGEST-ERROR", sprintf("invalid digest output encoding %y", enc);
                    },
                },
                COP_AS: {
                    "exp": <DataProviderExpressionInfo>{
                        "type": DET_Operator,
                        "name": "as",
                        "display_name": "as",
                        "short_desc": "aliases a result; args: expression or value, string label",
                        "desc": "aliases a result; args: expression or value, string label",
                        "symbol": "as",
                        "groups": "Alias",
                        "role": ER_Field,
                        "args": (
                            DataProviderSignatureAnyType,
                            DataProviderSignatureStringValueType,
                        ),
                        "return_type": AbstractDataProviderTypeMap."any",
                    },
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        string arg = args[1];
                        info.pseudo_column_map{arg} = exp;
                        # an alias is always given in double quotes, so the result key has its case, and is escaped,
                        # so it cannot change the SQL
                        return sprintf("%s as %s", exp, info.table.getAliasSqlName(arg));
                    },
                },
                COP_CAST: {
                    "exp": <DataProviderExpressionInfo>{
                        "type": DET_Operator,
                        "name": COP_CAST,
                        "display_name": "cast",
                        "short_desc": "cast operator",
                        "desc": "cast operator",
                        "symbol": "cast",
                        "groups": "Data Conversion",
                        "args": (
                            DataProviderSignatureAnyType,
                            DataProviderSignatureStringValueType,
                            DataProviderSignatureOptionalIntValueType,
                            DataProviderSignatureOptionalIntValueType,
                        ),
                        "return_type": AbstractDataProviderTypeMap."any",
                    },
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        # the arguments are the expression, the type, and an optional size and scale
                        string name = QoreTypeMap{args[1]} ?? args[1];
                        *hash<auto> desc = XdbcFirebirdTypeMap{name};
                        string sql = sprintf ("cast (%s as %s", exp0, name);
                        if (desc.size == SZ_MAND) {
                            if (!exists args[2] && !exists desc.size_range)
                                throw "OPERATOR-ERROR", sprintf ("cast operator missing size for type %s",
                                    name);
                            sql += sprintf("(%d)", args[2] ?? desc.size_range[1]);
                        } else if (desc.size == SZ_NUM && exists args[2]) {
                            sql += sprintf("(%d", args[2]);
                            sql += exists args[3] ? sprintf(",%d)", args[3]) : ")";
                        } else if (desc.size == SZ_OPT && exists args[2]) {
                            sql += sprintf("(%d)", args[2]);
                        }
                        sql += ")";
                        return sql;
                    },
                },
                COP_LENGTH: {
                    "exp": <DataProviderExpressionInfo>{
                        "type": DET_Operator,
                        "name": COP_LENGTH,
                        "display_name": COP_LENGTH,
                        "short_desc": "Returns the length of the argument",
                        "desc": "Returns the length of the argument",
                        "symbol": COP_LENGTH,
                        "groups": "Data Manipulation",
                        "args": (
                            DataProviderSignatureAnyType,
                        ),
                        "return_type": AbstractDataProviderTypeMap."int",
                    },
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("char_length(%s)", info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any"));
                    },
                },
                OP_IN: {
                    "exp": <DataProviderExpressionInfo>{
                        "type": DET_Operator,
                        "name": OP_IN,
                        "display_name": OP_IN,
                        "short_desc": "Returns True if the first argument is found in the second argument",
                        "desc": "Returns True if the first argument is found in the second argument",
                        "symbol": OP_IN,
                        "groups": "Comparison",
                        "args": (
                            DataProviderSignatureAnyType,
                            DataProviderSignatureAnyType,
                        ),
                        "return_type": AbstractDataProviderTypeMap."bool",
                    },
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        # firebird accepts max 1500 args in "IN" lists
                        list<string> argl;
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        if (args[1].typeCode() != NT_LIST) {
                            args[1] = (args[1],);
                        }
                        while (args[1]) {
                            list<auto> arg_slice = extract args[1], 0, 1500;
                            *string ins = (foldl $1 + "," + $2, (map info.table.getExpressionArg(\info, role, $1,
                                AbstractDataProviderTypeMap."any"), arg_slice));
                            if (ins) {
                                argl += ins;
                            }
                        }
                        if (!argl) {
                            return "1 != 1";
                        }
                        return "(" + (foldl $1 + " or " + $2, map sprintf("%s in (%s)", exp0, $1), argl) + ")";
                    },
                },
                # --- Date/Time functions for Firebird ---
                # Inherit metadata from DefaultExpressionMap; provide Firebird-native code only.
                DP_FUNC_NOW: DefaultExpressionMap{DP_FUNC_NOW} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return "current_timestamp";
                    },
                },
                # --- Duration functions for Firebird ---
                DP_FUNC_YEARS: DefaultExpressionMap{DP_FUNC_YEARS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("dateadd(%s year to cast(0 as timestamp))",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                    },
                },
                DP_FUNC_MONTHS: DefaultExpressionMap{DP_FUNC_MONTHS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("dateadd(%s month to cast(0 as timestamp))",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                    },
                },
                DP_FUNC_WEEKS: DefaultExpressionMap{DP_FUNC_WEEKS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("dateadd(%s week to cast(0 as timestamp))",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                    },
                },
                DP_FUNC_DAYS: DefaultExpressionMap{DP_FUNC_DAYS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("dateadd(%s day to cast(0 as timestamp))",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                    },
                },
                DP_FUNC_HOURS: DefaultExpressionMap{DP_FUNC_HOURS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("dateadd(%s hour to cast(0 as timestamp))",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                    },
                },
                DP_FUNC_MINUTES: DefaultExpressionMap{DP_FUNC_MINUTES} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("dateadd(%s minute to cast(0 as timestamp))",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                    },
                },
                DP_FUNC_SECONDS: DefaultExpressionMap{DP_FUNC_SECONDS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("dateadd(%s second to cast(0 as timestamp))",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                    },
                },
                DP_FUNC_MILLISECONDS: DefaultExpressionMap{DP_FUNC_MILLISECONDS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("dateadd(%s millisecond to cast(0 as timestamp))",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."int"));
                    },
                },
                # --- Date extraction functions for Firebird ---
                DP_FUNC_GET_YEAR: DefaultExpressionMap{DP_FUNC_GET_YEAR} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("extract(year from %s)",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                    },
                },
                DP_FUNC_GET_MONTH: DefaultExpressionMap{DP_FUNC_GET_MONTH} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("extract(month from %s)",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                    },
                },
                DP_FUNC_GET_DAY: DefaultExpressionMap{DP_FUNC_GET_DAY} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("extract(day from %s)",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                    },
                },
                DP_FUNC_GET_HOUR: DefaultExpressionMap{DP_FUNC_GET_HOUR} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("extract(hour from %s)",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                    },
                },
                DP_FUNC_GET_MINUTE: DefaultExpressionMap{DP_FUNC_GET_MINUTE} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("extract(minute from %s)",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                    },
                },
                DP_FUNC_GET_SECOND: DefaultExpressionMap{DP_FUNC_GET_SECOND} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("extract(second from %s)",
                            info.table.getExpressionArg(\info, role, args[0], AbstractDataProviderTypeMap."date"));
                    },
                },
                # --- String pattern matching operators for Firebird ---
                DP_OP_LIKE: DefaultExpressionMap{DP_OP_LIKE} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        if (args[2]) {
                            return sprintf("upper(%s) like upper(%s)", exp0, exp1);
                        }
                        return sprintf("%s like %s", exp0, exp1);
                    },
                },
                DP_OP_CONTAINS: DefaultExpressionMap{DP_OP_CONTAINS} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        if (args[2]) {
                            return sprintf("upper(%s) like '%%' || upper(%s) || '%%'", exp0, exp1);
                        }
                        return sprintf("%s like '%%' || %s || '%%'", exp0, exp1);
                    },
                },
                DP_OP_STARTS_WITH: DefaultExpressionMap{DP_OP_STARTS_WITH} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."any");
                        if (args[2]) {
                            return sprintf("upper(%s) like upper(%s) || '%%'", exp0, exp1);
                        }
                        return sprintf("%s like %s || '%%'", exp0, exp1);
                    },
                },
                DP_OP_ENDS_WITH: DefaultExpressionMap{DP_OP_ENDS_WITH} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."any");
                        if (args[2]) {
                            return sprintf("upper(%s) like '%%' || upper(%s)", exp0, exp1);
                        }
                        return sprintf("%s like '%%' || %s", exp0, exp1);
                    },
                },
                DP_OP_REPLACE: DefaultExpressionMap{DP_OP_REPLACE} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string");
                        string exp1 = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."string");
                        string exp2 = info.table.getExpressionArg(\info, role, args[2],
                            AbstractDataProviderTypeMap."string");
                        return sprintf("replace(%s, %s, %s)", exp0, exp1, exp2);
                    },
                },
                # --- Type conversion operators for Firebird ---
                DP_OP_TO_STRING: DefaultExpressionMap{DP_OP_TO_STRING} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as varchar(8191))", exp0);
                    },
                },
                DP_OP_TO_INT: DefaultExpressionMap{DP_OP_TO_INT} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as integer)", exp0);
                    },
                },
                DP_OP_TO_FLOAT: DefaultExpressionMap{DP_OP_TO_FLOAT} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as double precision)", exp0);
                    },
                },
                DP_OP_TO_NUMBER: DefaultExpressionMap{DP_OP_TO_NUMBER} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as numeric(18,4))", exp0);
                    },
                },
                DP_OP_TO_DATE: DefaultExpressionMap{DP_OP_TO_DATE} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as timestamp)", exp0);
                    },
                },
                DP_OP_TO_BOOL: DefaultExpressionMap{DP_OP_TO_BOOL} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string exp0 = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("cast(%s as boolean)", exp0);
                    },
                },
                # --- String manipulation operators for Firebird ---
                DP_OP_TO_LOWER: DefaultExpressionMap{DP_OP_TO_LOWER} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("lower(%s)", info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string"));
                    },
                },
                DP_OP_TO_UPPER: DefaultExpressionMap{DP_OP_TO_UPPER} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("upper(%s)", info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."string"));
                    },
                },
                # --- Control flow operators for Firebird ---
                DP_OP_TERNARY: DefaultExpressionMap{DP_OP_TERNARY} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        string cond = info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."bool");
                        string true_val = info.table.getExpressionArg(\info, role, args[1],
                            AbstractDataProviderTypeMap."any");
                        string false_val = info.table.getExpressionArg(\info, role, args[2],
                            AbstractDataProviderTypeMap."any");
                        return sprintf("case when %s then %s else %s end", cond, true_val, false_val);
                    },
                },
                DP_OP_HAS_VALUE: DefaultExpressionMap{DP_OP_HAS_VALUE} + {
                    "code": string sub (reference<hash<QueryInfo>> info, int role, list<auto> args) {
                        return sprintf("%s is not null", info.table.getExpressionArg(\info, role, args[0],
                            AbstractDataProviderTypeMap."any"));
                    },
                },
            };
        }

        constructor(AbstractDatasource ds, string name, *hash<auto> opts) : AbstractTable(ds, name, opts) {
        }

        #! returns the name of the table to be used in SQL, as getSqlIdentifier() returns it
        /** @since XdbcFirebirdSqlUtilBase 0.2 a name that is not an ordinary name is quoted in upper case and escaped
        */
        string getSqlName() {
            return firebird_get_sql_identifier(name);
        }

        #! returns a name as an SQL identifier for Firebird
        /** @copydetails XdbcFirebirdDatabase::getSqlIdentifier()
        */
        string getSqlIdentifier(string name) {
            return firebird_get_sql_identifier(name);
        }

        #! returns an alias for SQL: in double quotes, in the case given, with each double quote doubled
        /** An alias names a key of the result, so it is given in double quotes as before, also when it is an ordinary
            name, and is not given in upper case as other names that need quotes are

            @since XdbcFirebirdSqlUtilBase 0.2
        */
        string getAliasSqlName(string alias) {
            return AbstractSqlUtilBase::getDelimitedIdentifier(alias, "\"", "\"", "Firebird");
        }

        #! returns the column operator map for this object
        private hash getColumnOperatorMapImpl() {
            return XdbcFirebirdCopMap;
        }

        #! returns the "where" operator map for Firebird
        hash<auto> getWhereOperatorMap() {
            return FirebirdOpMap;
        }

        #! Returns the expression map for Firebird
        hash<auto> getExpressionMap() {
            return FirebirdExpressionMap;
        }

        private bool checkExistenceImpl() {
            *hash<auto> row = ds.selectRow("select a.rdb$relation_name as \"name\" from rdb$relations a "
                "where coalesce(rdb$system_flag, 0) = 0 and rdb$relation_type = 0 and a.rdb$relation_name = %v",
                firebird_get_catalog_name(name));
            if (row) {
                return inDb = True;
            }
            return False;
        }

        private Columns describeImpl() {
            # get column descriptions
            *hash<auto> qh = ds.select("select "
                "   lower(rf.rdb$field_name) as \"name\", "
                "   f.rdb$field_length as \"length\", "
                "   f.rdb$character_length as \"char_length\", "
                "   f.rdb$field_precision as \"precision\", "
                "   f.rdb$field_scale as \"scale\", "
                "   f.rdb$field_type as \"type\", "
                "   f.rdb$field_sub_type as \"subtype\", "
                "   rf.rdb$null_flag as \"null_flag\", "
                "   f.rdb$default_value as \"default_value\", "
                "   rf.rdb$description as \"comment\" "
                "from "
                "   rdb$relations r, rdb$relation_fields rf, rdb$fields f "
                "where "
                "   r.rdb$relation_name = %v and r.rdb$relation_name = rf.rdb$relation_name and "
                "   (r.rdb$system_flag is null or r.rdb$system_flag = 0) and r.rdb$view_blr is null "
                "   and f.rdb$field_name = rf.rdb$field_source "
                "order by "
                "   rf.rdb$field_position", firebird_get_catalog_name(name));
            if (!qh.name) {
                throw "TABLE-ERROR", sprintf("cannot retrieve table information for table %y in %y", name, dsdesc);
            }

            hash<string, AbstractColumn> rv;
            foreach hash<auto> row in (qh.contextIterator()) {
                string typename;
                switch (row.type) {
                    case 7: {
                        switch (row.subtype) {
                            case 0: typename = "smallint"; remove row.length; break;
                            case 1: typename = "numeric"; break;
                            case 2: typename = "decimal"; break;
                        }
                        break;
                    }
                    case 8: {
                        switch (row.subtype) {
                            case 0: typename = "integer"; remove row.length; break;
                            case 1: typename = "numeric"; break;
                            case 2: typename = "decimal"; break;
                        }
                        break;
                    }
                    case 9: typename = "quad"; break;
                    case 10: typename = "float"; remove row.length; break;
                    case 12: typename = "date"; remove row.length; break;
                    case 13: typename = "time"; remove row.length; break;
                    case 14: typename = row.subtype == 1 ? "binary" : "char"; break;
                    case 16: {
                        switch (row.subtype) {
                            case 0: typename = "bigint"; remove row.length; break;
                            case 1: typename = "numeric"; break;
                            case 2: typename = "decimal"; break;
                        }
                        break;
                    }
                    case 23: typename = "boolean"; remove row.length; break;
                    # INT128-backed NUMERIC and DECIMAL (precision 19 - 38); supported from Firebird 4 on
                    case 26: {
                        switch (row.subtype) {
                            case 0: typename = "int128"; remove row.length; break;
                            case 1: typename = "numeric"; break;
                            case 2: typename = "decimal"; break;
                        }
                        break;
                    }
                    case 27: typename = "double"; remove row.length; break;
                    case 29: typename = "timestamp with time zone"; remove row.length; break;
                    case 35: typename = "timestamp"; remove row.length; break;
                    case 37: typename = typename = row.subtype == 1 ? "varbinary" : "varchar"; break;
                    case 40: typename = "cstring"; break;
                    case 45: typename = "blob_id"; break;
                    case 261: {
                        typename = "blob";
                        if (row.subtype == 1) {
                            typename += " sub_type text";
                        }
                        remove row.length;
                        break;
                    }
                }
                if (!typename) {
                    throw "FIREBIRD-ERROR", sprintf("column %s.%s: unknown column type %d", getSqlName(), row.name,
                        row.type);
                }
                # "rdb$field_length" gives the storage size in bytes for NUMERIC and DECIMAL columns (2, 4, or 8
                # for the smallint, integer, and bigint backing types), not the declared precision; the precision
                # is only available in "rdb$field_precision"
                if (typename == "numeric" || typename == "decimal") {
                    row.length = row.precision;
                }
                # "rdb$field_length" gives the size in bytes of a character column, which is more than the size in
                # characters that it was declared with in a character set of more than one byte per character (four
                # in UTF8); the declared size is "rdb$character_length"
                else if ((typename == "char" || typename == "varchar") && row.char_length) {
                    row.length = row.char_length;
                }
                if (row.scale < 0) {
                    row.scale = -row.scale;
                }

                auto defval = exists row.default_value && row.default_value !== NULL && row.default_value != "NULL"
                    ? row.default_value
                    : NOTHING;
                *hash<auto> th = XdbcFirebirdTypeMap{typename};
                if (exists defval) {
                    # process default value according to column type
                    switch (th.qore) {
                        case Type::Int: defval = defval.toInt(); break;
                        case Type::Float: defval = defval.toFloat(); break;
                        case Type::Number: defval = defval.toNumber(); break;
                        case Type::Date: {
                            try {
                                defval = date(defval);
                            } catch (hash<ExceptionInfo> ex) {
                                # ignore INVALID-DATE; keep text (ex: "CURRENT_TIMESTAMP")
                                if (ex.err != "INVALID-DATE") {
                                    rethrow;
                                }
                            }
                        }
                        case Type::String: {
                            if (defval =~ /^'.*'$/) {
                                defval = defval[1..(defval.size() - 2)];
                                defval =~ s/''/'/g;
                            }
                            break;
                        }
                        # don't know what to do with Type::Binary ???
                        default: break;
                    }
                    defval = getSqlValue(defval);
                }

                XdbcFirebirdColumn c(row.name, typename, th.qore, row.length ?? 0, !row.null_flag, defval, row.comment,
                    row.scale);
                rv{row.name} = c;
            }

            return new Columns(rv);
        }

        private XdbcFirebirdPrimaryKey getPrimaryKeyImpl() {
            # get primary key description
            *hash<auto> qh = ds.select("select
    ix.rdb$index_name as \"index_name\",
    lower(sg.rdb$field_name) as \"column_name\"
from
    rdb$indices ix
    left join rdb$index_segments sg on ix.rdb$index_name = sg.rdb$index_name
    left join rdb$relation_constraints rc on rc.rdb$index_name = ix.rdb$index_name
where
    rc.rdb$constraint_type = 'PRIMARY KEY' and rc.rdb$relation_name = %v", firebird_get_catalog_name(name));

            hash<auto> rv;
            foreach string col in (qh.column_name) {
                # issue #4348: strip quotes from columns using reserved words
                col =~ s/^"(.*)"$/$1/g;
                rv{col} = columns{col};
            }

            return rv
                ? new XdbcFirebirdPrimaryKey(rv)
                : new XdbcFirebirdPrimaryKey();
        }

        #! describes the indexes of the table from the catalog
        /** Every index of the table is described but the index of its primary key: an index created with
            \c CREATE \c INDEX, and the index that Firebird creates for each unique and foreign constraint, under the
            name of the constraint, as before.  An index of an expression (\c COMPUTED \c BY) is not described, as
            it has no columns.

            @since XdbcFirebirdSqlUtilBase 0.2 an index created with \c CREATE \c INDEX is described; before, only the
            indexes of unique and foreign constraints were
        */
        private Indexes getIndexesImpl() {
            # one row per column of each index, in the order of its columns; names are given in lower case, as for
            # columns
            *hash<auto> qh = ds.select("select "
                "   lower(trim(ix.rdb$index_name)) as \"name\", "
                "   ix.rdb$unique_flag as \"unique\", "
                "   lower(trim(sg.rdb$field_name)) as \"column_name\" "
                "from "
                "   rdb$indices ix "
                "   join rdb$index_segments sg on sg.rdb$index_name = ix.rdb$index_name "
                "   left join rdb$relation_constraints rc on rc.rdb$index_name = ix.rdb$index_name "
                "where "
                "   coalesce(ix.rdb$system_flag, 0) = 0 and ix.rdb$relation_name = %v "
                "   and (rc.rdb$constraint_type is null or rc.rdb$constraint_type != 'PRIMARY KEY') "
                "order by "
                "   ix.rdb$index_name, sg.rdb$field_position", firebird_get_catalog_name(name));

            # the indexes in the order of the query, each with its columns in their order
            hash<string, hash<auto>> ih;
            foreach hash<auto> row in (qh.contextIterator()) {
                on_error rethrow $1.err, sprintf("%s (index %y column %y)", $1.desc, row.name, row.column_name);
                reference<hash<auto>> ix = \ih{row.name};
                if (!ix) {
                    ix = {"unique": boolean(row.unique), "columns": {}};
                }
                ix.columns{row.column_name} = columns{row.column_name};
            }

            hash<string, AbstractIndex> rv;
            foreach hash<auto> i in (ih.pairIterator()) {
                rv{i.key} = new XdbcFirebirdIndex(i.key, i.value.unique, i.value.columns);
            }
            return new Indexes(rv);
        }

        #! describes the foreign constraints of the table, with their referential actions, from the catalog
        /** @since XdbcFirebirdSqlUtilBase 0.2 the foreign constraints are described; before, none were
        */
        private ForeignConstraints getForeignConstraintsImpl(*hash<auto> opts) {
            # one row per column of each constraint: its target column is the column of the referenced primary key
            # or unique constraint at the same position; names are given in lower case, as for columns and indexes
            *hash<auto> qh = ds.select("select "
                "   lower(trim(rc.rdb$constraint_name)) as \"constraint_name\", "
                "   lower(trim(sg.rdb$field_name)) as \"column_name\", "
                "   lower(trim(tc.rdb$relation_name)) as \"target_table\", "
                "   lower(trim(tsg.rdb$field_name)) as \"target_column\", "
                "   trim(ref.rdb$delete_rule) as \"delete_rule\", "
                "   trim(ref.rdb$update_rule) as \"update_rule\" "
                "from "
                "   rdb$relation_constraints rc "
                "   join rdb$ref_constraints ref on ref.rdb$constraint_name = rc.rdb$constraint_name "
                "   join rdb$relation_constraints tc on tc.rdb$constraint_name = ref.rdb$const_name_uq "
                "   join rdb$index_segments sg on sg.rdb$index_name = rc.rdb$index_name "
                "   join rdb$index_segments tsg on tsg.rdb$index_name = tc.rdb$index_name "
                "       and tsg.rdb$field_position = sg.rdb$field_position "
                "where "
                "   rc.rdb$constraint_type = 'FOREIGN KEY' and rc.rdb$relation_name = %v "
                "order by "
                "   rc.rdb$constraint_name, sg.rdb$field_position", firebird_get_catalog_name(name));

            # the constraints in the order of the query, each with its columns in their order
            hash<string, hash<auto>> fks;
            foreach hash<auto> row in (qh.contextIterator()) {
                reference<hash<auto>> fk = \fks{row.constraint_name};
                if (!fk) {
                    fk = {
                        "table": row.target_table,
                        "columns": (),
                        "target_columns": (),
                        # the rules are given once per constraint, the same on every row
                        "on_delete": XdbcFirebirdForeignConstraint::actionFromCatalog(row.delete_rule),
                        "on_update": XdbcFirebirdForeignConstraint::actionFromCatalog(row.update_rule),
                    };
                }
                fk.columns += row.column_name;
                fk.target_columns += row.target_column;
            }

            hash<string, AbstractForeignConstraint> rv;
            foreach hash<auto> i in (fks.pairIterator()) {
                Columns targ_columns = getReferencedTableColumnsUnlocked(i.value.table, opts.table_cache);
                rv{i.key} = new XdbcFirebirdForeignConstraint(i.key, columns.subset(i.value.columns),
                    new ForeignConstraintTarget(i.value.table, targ_columns.subset(i.value.target_columns)),
                    i.value.on_delete, i.value.on_update);
            }
            return new ForeignConstraints(rv);
        }

        #! describes the unique constraints of the table from the catalog
        /** @since XdbcFirebirdSqlUtilBase 0.2 unique constraints are described; before, none were, so that every table
            alignment dropped the index of each unique constraint and added the constraint again
        */
        private Constraints getConstraintsImpl() {
            # one row per column of each unique constraint, in the order of its columns; names are given in lower
            # case, as for columns and indexes
            *hash<auto> qh = ds.select("select "
                "   lower(trim(rc.rdb$constraint_name)) as \"constraint_name\", "
                "   lower(trim(sg.rdb$field_name)) as \"column_name\" "
                "from "
                "   rdb$relation_constraints rc "
                "   join rdb$index_segments sg on sg.rdb$index_name = rc.rdb$index_name "
                "where "
                "   rc.rdb$constraint_type = 'UNIQUE' and rc.rdb$relation_name = %v "
                "order by "
                "   rc.rdb$constraint_name, sg.rdb$field_position", firebird_get_catalog_name(name));

            # the constraints in the order of the query, each with its columns in their order
            hash<string, hash<string, AbstractColumn>> uh;
            foreach hash<auto> row in (qh.contextIterator()) {
                on_error rethrow $1.err, sprintf("%s (unique constraint %y column %y)", $1.desc, row.constraint_name,
                    row.column_name);
                uh{row.constraint_name}{row.column_name} = columns{row.column_name};
            }

            Constraints c();
            map c.add($1.key, new XdbcFirebirdUniqueConstraint($1.key, $1.value)), uh.pairIterator();
            return c;
        }

        private Triggers getTriggersImpl() {
            hash rv;
            /*
            # get trigger description
            *hash qh = ds.select("");

            foreach hash<auto> row in (qh.contextIterator()) {
                string src = sprintf("%s %s on %s for each %s %s", row.action_timing.lwr(),
                    row.event_manipulation.lwr(), name, row.action_orientation.lwr(), row.action_statement);
                rv{row.trigger_name} = new XdbcFirebirdTrigger(row.trigger_name, src);
            }
            */
            return new Triggers(rv);
        }

        string getCreateTableSqlImpl(*hash<auto> opt) {
            string sql = sprintf("create table %s (\n", getSqlName());
            sql += foldl $1 + ",\n" + $2, (map "  " + $1.getCreateSql(self), columns.iterator());
            sql += "\n)";
            return sql;
        }

        #! returns @ref False "False" because the xdbcfirebird driver does not support array binds / bulk DML
        bool hasArrayBind() {
            return False;
        }

        private *list getCreateMiscSqlImpl(*hash<auto> opt, bool cache) {
        }

        private *list getAlignSqlImpl(AbstractTable table, *hash<auto> opt) {
        }

        private string getCreateSqlImpl(list l) {
            return XdbcFirebirdDatabase::getCreateSql(l);
        }

        private string getRenameSqlImpl(string new_name) {
            throw "UNSUPPORTED", "Firebird does not support renaming tables";
        }

        private AbstractColumn addColumnImpl(string cname, hash<auto> opt, bool nullable = True) {
            # numeric types carry their size in "opt.precision"; "opt.size" is cleared for them, so passing
            # "opt.size" here dropped both the precision and the scale from every numeric column
            if (opt.precision) {
                return new XdbcFirebirdColumn(cname, opt.native_type, opt.qore_type, opt.precision, nullable,
                    opt.default_value, opt.comment, opt.scale);
            }
            return new XdbcFirebirdColumn(cname, opt.native_type, opt.qore_type, opt.size, nullable,
                opt.default_value, opt.comment);
        }

        private AbstractPrimaryKey addPrimaryKeyImpl(string cname, hash<auto> ch, *hash<auto> opt) {
            return new XdbcFirebirdPrimaryKey(ch);
        }

        private AbstractIndex addIndexImpl(string iname, bool enabled, hash<auto> ch, *hash<auto> opt) {
            if (opt.method.val() || opt.with || opt.opclass) {
                throw "INDEX-OPTION-ERROR", sprintf("index %y: generic index options method/with/opclass "
                    "are not supported on Firebird", iname);
            }
            return new XdbcFirebirdIndex(iname, enabled, ch);
        }

        private AbstractForeignConstraint addForeignConstraintImpl(string cname, hash<auto> ch, string table,
                hash<auto> tch, *hash<auto> opt) {
            ForeignConstraintTarget fct(table, new Columns(tch));
            return new XdbcFirebirdForeignConstraint(cname, new Columns(ch), fct, opt.on_delete, opt.on_update);
        }

        private AbstractCheckConstraint addCheckConstraintImpl(string cname, string src, *hash<auto> opt) {
            throw "FIREBIRD-CHECK-CONSTRAINT-ERROR", sprintf("not yet implemented");
        }

        private AbstractUniqueConstraint addUniqueConstraintImpl(string cname, hash<auto> ch, *hash<auto> opt) {
            return new XdbcFirebirdUniqueConstraint(cname, ch);
        }

        private AbstractTrigger addTriggerImpl(string tname, string src, *hash<auto> opt) {
            return new XdbcFirebirdTrigger(tname, src);
        }

        private string getTruncateSqlImpl() {
            return sprintf("delete from %s", getSqlName());
        }

        private bool tryInsertImpl(string sql, hash<auto> row) {
            try {
                ds.vexec(sql, row.values());
            } catch (hash<ExceptionInfo> ex) {
                if (isDuplicateRowError(ex)) {
                    return False;
                }
                rethrow;
            }
            return True;
        }

        #! Returns True if the exception was raised because of a duplicate row / key error
        /** @since XdbcFirebirdSqlUtilBase 1.4.2
        */
        private bool isDuplicateRowErrorImpl(hash<ExceptionInfo> ex) {
            return (ex.desc =~ /(attempt to store duplicate value|violation of PRIMARY or UNIQUE KEY constraint)/);
        }

        private hash<auto> getQoreTypeMapImpl() {
            return QoreTypeMap;
        }

        private hash<auto> getTypeMapImpl() {
            return XdbcFirebirdTypeMap;
        }

        #! returns a string for use in SQL queries representing the DB-specific value of the argument
        /** returns NOTHING if the type cannot be converted to an SQL string
        */
        private *string getSqlValueImpl(auto v) {
            return XdbcFirebirdTable::getSqlValueIntern(v);
        }

        #! returns a string for use in SQL queries representing the DB-specific value of the argument
        /** returns NOTHING if the type cannot be converted to an SQL string
        */
        private static *string getSqlValueIntern(auto v) {
            switch (v.typeCode()) {
                case NT_FLOAT:
                case NT_INT: return v.toString();

                case NT_NUMBER: return string(v);

                # double any single quotes in strings
                case NT_STRING: v =~ s/'/''/g; return "'" + v + "'";

                case NT_NULL:
                case NT_NOTHING: return "null";

                case NT_BOOLEAN: return v ? "true" : "false";

                case NT_DATE: {
                    # XdbcFirebird does not allow us to specify the UTC offset in the timestamp literal :(
                    TimeZone tz = TimeZone::get();
                    v = tz.date(v);
                    return "timestamp " + v.format("'YYYY-MM-DDTHH:mm:SS.us'");
                }
            }
        }

        #! Returns the column name for use in SQL strings, as getSqlIdentifier() returns it
        /** @since XdbcFirebirdSqlUtilBase 0.2 a name that is not an ordinary name is quoted in upper case and escaped;
            before, only a reserved word was quoted
        */
        string getColumnSqlName(string col) {
            return firebird_get_sql_identifier(col);
        }

        #! returns a list of column names for use in SQL strings, as getSqlIdentifier() returns them
        list<string> getColumnSqlNames(softlist<auto> cols) {
            return map firebird_get_sql_identifier($1), cols;
        }

        #! returns a string for use in SQL queries representing the DB-specific value of the argument
        /** @par Example:
            @code{.py}
string str = table.getSqlValue(date);
            @endcode

            @param v the value to convert to an SQL value

            @return a string representing the value usable in SQL strings for the given database driver

            @throw VALUE-ERROR the given value cannot be converted to an SQL string (missing rules for value)
         */
        static *string getSqlValue(auto v) {
           *string str = XdbcFirebirdTable::getSqlValueIntern(v);
            if (!exists str)
                throw "VALUE-ERROR", sprintf("class XdbcFirebirdTable cannot convert type %y to an SQL string "
                    "(value: %y)", v.type(), v);
            return str;
        }

        private bool emptyImpl() {
            return True;
        }

        private preSetupTableImpl(reference<hash> desc, *hash<auto> opt) {
            # see if there is an auto-increment column and set the primary key flag if it matches the primary key
            # declaraion
            foreach string k in (desc.columns.keyIterator()) {
                if (desc.columns{k}.auto_increment) {
                    if (!desc.columns{k}.pk) {
                        if (desc.primary_key.columns.lsize() == 1) {
                            softlist cl = desc.primary_key.columns;
                            if (cl[0] == k) {
                                desc.columns{k}.pk = True;
                                # delete the primary key description; it will be added again when the column is added
                                delete desc.primary_key;
                            }
                        }
                    }
                    break;
                }
            }
        }

        private setupTableImpl(hash<auto> desc, *hash<auto> opt) {
        }

        #! returns @ref True "True" if the database links constraints to indexes (ie dropping the constraint drops the index, etc)
        private bool constraintsLinkedToIndexesImpl() {
            return True;
        }

        #! returns @ref True "True" if the database automatically creates a unique constraint when a unique index is created (ex: xdbcfirebird)
        private bool uniqueIndexCreatesConstraintImpl() {
            return True;
        }

        #! returns @ref True "True" if the database support tablespaces
        private bool supportsTablespacesImpl() {
            return False;
        }

        #! Firebird accepts non-unique orderby + offset/limit at the SQL level;
        #! the determinism check in AbstractTable is overly strict here.
        /** Pagination across orderby ties may still yield non-deterministic
            ordering — that's the caller's concern, not a SQL-validity issue.
        */
        bool requireUniqueOrderByWithOffsetLimit() {
            return False;
        }

        #! processes a string for use in SQL select statements when there is a "limit" argument, but no "orderby" or "offset" arguments
        private doSelectLimitOnlyInternImpl(reference<hash<QueryInfo>> info, reference<string> sql) {
            if (!info.query_hash.limit) {
                return;
            }

            # this rule is broken here with reason:
            # In a SELECT statement, always use an ORDER BY clause with the FIRST clause.
            # This is the only way to predictably indicate which rows are affected by FIRST
            sql = regex_subst(sql, "^select ", sprintf("select first %d ", info.query_hash.limit));
        }

        #! processes a string for use in SQL select statements when there is an "order by" and "offset" argument
        private doSelectOrderByWithOffsetSqlInternImpl(reference<hash<QueryInfo>> info, reference<string> sql,
                list<auto> coll) {
            doSelectOrderBySqlIntern(info, \sql, coll);

            # NOTE: we do not bind the variables by value here, because it doesn't work
            sql += sprintf(" offset %d rows", info.query_hash.offset.toInt());

            if (info.query_hash.limit) {
                sql += sprintf(" fetch next %d rows only", info.query_hash.limit.toInt());
            }
        }

        #! returns @ref True if the database requires a wildcard \c "*" to be prefixed with the table name when it appears with other column arguments in a select statement
        private bool asteriskRequiresPrefix() {
            return True;
        }

        private *hash<auto> doReturningImpl(hash<auto> opt, reference<string> sql, list<auto> args) {
            throw "RETURNING-ERROR", sprintf("table %s: returning not yet implemented for Firebird", getSqlName());
        }

        private list<auto> getGroupOrderByListUnlocked(hash<QueryInfo> info, string key, list<auto> coll) {
            list<auto> ce = ();
            foreach auto cv in (info.query_hash{key}) {
                switch (cv.typeCode()) {
                    case NT_STRING: {
                        if (cv.toInt() == cv) {
                            ce += cv;
                        } else {
                            ce += getColumnNameIntern(info, cv);
                        }
                        break;
                    }

                    case NT_HASH: {
                        ce += doColumnOperatorIntern(\info, cv);
                        break;
                    }

                    case NT_INT: {
                        ce += cv.toString();
                        break;
                    }

                    default:
                        throw "SELECT-ERROR", sprintf("%s: don't know how to parse argument type %y (value: %y) in "
                            "%s list, expecting \"string\" or \"hash\"", getDesc(), cv.type(), cv, key);
                }
            }
            return ce;
        }

        #! returns @ref True "True" if the current database driver supports the \c "returning" clause in insert statements, @ref False "False" if not
        bool hasReturningImpl() {
            return False;
        }

