# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module WaveRestClient {
    version = "1.0";
    desc = "User module for calling Wave GraphQL API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("wave", WaveRestConnection::ConnectionScheme);
    };
}

/** @mainpage WaveRestClient Module

    @tableofcontents

    @section waverestclientintro WaveRestClient Introduction

    The %WaveRestClient module provides an API for calling Wave's GraphQL API services.

    To use this module, use \c "%requires WaveRestClient" in your code.

    All the public symbols in the module are defined in the WaveRestClient namespace.

    The main classes are:
    - @ref WaveRestClient::WaveRestClient "WaveRestClient":
      this class provides the GraphQL client API for communication with the Wave API;
      it handles authentication via OAuth2
    - @ref WaveRestClient::WaveRestConnection "WaveRestConnection":
      provides a connection object to Wave services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires WaveRestClient

WaveRestClient wave({"token": ENV.WAVE_TOKEN});
hash<auto> result = wave.graphql("query { user { id firstName lastName defaultEmail } }");
printf("User: %s %s\n", result.body.data.user.firstName, result.body.data.user.lastName);
    @endcode

    @section waverestclientrelnotes Release Notes

    @subsection waverestclientv1_0 WaveRestClient v1.0
    - the initial version of the %WaveRestClient module
*/

#! the WaveRestClient namespace contains all the objects in the WaveRestClient module
public namespace WaveRestClient {

#! Common base class for WaveRestClient functionality
public class WaveRestClientBase {
    public {
        #! Default Wave GraphQL API URL
        const DefaultUrl = "https://gql.waveapps.com/graphql/public";

        #! Default authorization request URL
        const DefaultAuthUrl = "https://api.waveapps.com/oauth2/authorize/";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! Default token request URL
        const DefaultTokenUrl = "https://api.waveapps.com/oauth2/token/";

        #! Default OAuth2 scopes
        const DefaultScopes = (
            "account:read", "account:write",
            "business:read",
            "customer:read", "customer:write",
            "invoice:read", "invoice:write",
            "product:read", "product:write",
            "transaction:read", "transaction:write",
            "user:read",
            "vendor:read",
        );

        #! Default "data" option value
        const DefaultData = "json";

        #! Default Wave ping method
        const DefaultPingMethod = "POST";

        #! Default Wave ping path (empty for GraphQL endpoint)
        const DefaultPingPath = "";

        #! Default Wave ping body (user query)
        const DefaultPingBody = {
            "query": "query { user { id } }",
        };

        #! Default Wave ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
            "Content-Type": MimeTypeJson,
        };

        #! Default auth args for refresh tokens
        const DefaultAuthArgs = {
            "access_type": "offline",
            "prompt": "consent",
        };

        #! Default constructor options (without OAuth2 - added conditionally)
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
            "ping_body": DefaultPingBody,
            "url": DefaultUrl,
        };

        #! OAuth2 options (added when OAuth2 credentials are provided)
        const OAuth2Options = {
            "oauth2_auth_url": DefaultAuthUrl,
            "oauth2_grant_type": DefaultGrantType,
            "oauth2_token_url": DefaultTokenUrl,
            "oauth2_scopes": DefaultScopes,
            "oauth2_auth_args": DefaultAuthArgs,
        };
    }

    #! returns options for @ref WaveRestClient::WaveRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;
        # Only add OAuth2 options if OAuth2 credentials are provided
        if (opts.oauth2_client_id) {
            rv += OAuth2Options;
        } else if (opts.token) {
            # Bearer token mode: Wave requires "Bearer" prefix
            rv.headers.Authorization = "Bearer " + opts.token;
            # Remove token from opts so RestClient doesn't add another "Bearer" prefix
            remove rv.token;
        }
        return rv;
    }
}

#! This class provides the GraphQL client API for communication with Wave servers
/** Wave uses a GraphQL API at https://gql.waveapps.com/graphql/public. This client
    wraps RestClient to handle GraphQL queries and mutations via HTTP POST requests.

    Authentication is done via OAuth2 Bearer tokens.

    @par Rate Limits:
    - 60 requests per minute per token
*/
public class WaveRestClient inherits RestClient::RestClient, WaveRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
WaveRestClient wave({"token": "your_oauth2_token"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c token: the Wave OAuth2 access token

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(WaveRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! Executes a GraphQL query or mutation
    /**
        @param query the GraphQL query or mutation string
        @param variables optional variables for the query
        @param info optional reference to return request/response info

        @return the parsed response body with data and/or errors

        @throw GRAPHQL-ERROR if the GraphQL response contains errors
    */
    hash<auto> graphql(string query, *hash<auto> variables, *reference<hash<auto>> info) {
        hash<auto> body = {
            "query": query,
            "variables": variables,
        };
        hash<auto> response = post("", body, \info);
        return response;
    }

    #! Executes a GraphQL query
    /**
        @param query the GraphQL query string
        @param variables optional variables for the query
        @param info optional reference to return request/response info

        @return the parsed response body

        @see graphql()
    */
    hash<auto> query(string query, *hash<auto> variables, *reference<hash<auto>> info) {
        return graphql(query, variables, \info);
    }

    #! Executes a GraphQL mutation
    /**
        @param mutation the GraphQL mutation string
        @param variables optional variables for the mutation
        @param info optional reference to return request/response info

        @return the parsed response body

        @see graphql()
    */
    hash<auto> mutate(string mutation, *hash<auto> variables, *reference<hash<auto>> info) {
        return graphql(mutation, variables, \info);
    }
}

#! Class for Wave REST connections; returns @ref WaveRestClient objects
/** This class implements all options of \c RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following default values for the following options:
    - \c oauth2_auth_url: \c https://api.waveapps.com/oauth2/authorize/
    - \c oauth2_grant_type: \c authorization_code
    - \c oauth2_token_url: \c https://api.waveapps.com/oauth2/token/

    @see @ref WaveRestClient::WaveRestClient::constructor() for more information on the above options
*/
public class WaveRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Wave API URL
        const DefaultConnectionUrl = "wave://gql.waveapps.com/graphql/public";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Wave REST Connection",
            "short_desc": "A connection to the Wave GraphQL API",
            "desc": "A connection to the Wave GraphQL API for accounting and invoicing",
            "cls": Class::forName("WaveRestConnection"),
            "auto_url": True,
            "schemes": {
                "wave": True,
            },
            "base_scheme_map": {
                "https": "wave",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultData,
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultAuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultGrantType,
                },
                "oauth2_scopes": RestConnection::ConnectionScheme.options.oauth2_scopes
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultScopes,
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultTokenUrl,
                },
                "oauth2_auth_args": RestConnection::ConnectionScheme.options.oauth2_auth_args
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultAuthArgs,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultPingPath,
                },
                "ping_body": RestConnection::ConnectionScheme.options."ping_body"
                + <ConnectionOptionInfo>{
                    "default_value": WaveRestClientBase::DefaultPingBody,
                },
            },
            "required_options": "token|oauth2_auth_url,oauth2_grant_type,oauth2_token_url,"
                "oauth2_client_id,oauth2_client_secret",
        };
    }

    #! creates the WaveRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See \c ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = WaveRestClientBase::DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the WaveRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : RestConnection(config, attr) {
    }

    #! returns \c "wave"
    string getType() {
        return "wave";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the \c getDataProvider() method

        @see \c getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        return "Wave";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the WaveDataProvider and creates the data provider
        # object dynamically
        load_module("WaveDataProvider");
        return create_object("WaveDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    /** The closure or call reference must have the following signature:
        <tt>update_options(hash<auto> options)</tt>
    */
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        # update the URL immediately if necessary
        if (update_options && url != DefaultConnectionUrl) {
            doUpdateOptions(self, {
                "url": DefaultConnectionUrl,
            });
        }
    }

    #! returns a @ref WaveRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref WaveRestClient object
    */
    private WaveRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new WaveRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since WaveRestClient 1.1
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new WaveRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! Wave REST client for non-blocking I/O
public class WaveRestClientIo inherits RestClientIo::RestClientIo, WaveRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(WaveRestClientBase::getOptions(opts), shared_mgr) {
    }

    #! Executes a GraphQL query or mutation
    /** @param query the GraphQL query or mutation string
        @param variables optional variables for the query
        @param hdr optional headers to send with the request

        @return the parsed response body with data and/or errors
    */
    hash<auto> graphql(string query, *hash<auto> variables, *hash<auto> hdr) {
        return restPost("", {"query": query, "variables": variables}, hdr);
    }
}
}
