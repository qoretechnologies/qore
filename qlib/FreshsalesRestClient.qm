# minimum qore version
%requires qore >= 2.0

# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 2.7
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module FreshsalesRestClient {
    version = "1.1";
    desc = "User module for calling Freshsales REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("freshsalesrest",
            FreshsalesRestConnection::ConnectionScheme);
    };
    # the module registers process-wide functionality in its initialization (connection schemes, LLM provider factories)
    domains = "PROCESS_CONTROL";
}

/** @mainpage FreshsalesRestClient Module

    @tableofcontents

    @section freshsalesrestclientintro FreshsalesRestClient Introduction

    The %FreshsalesRestClient module provides an API for calling Freshsales REST API services.

    To use this module, use \c "%requires FreshsalesRestClient" in your code.

    All the public symbols in the module are defined in the FreshsalesRestClient namespace.

    The main classes are:
    - @ref FreshsalesRestClient::FreshsalesRestClient "FreshsalesRestClient":
      this class provides the REST client API for communication with the Freshsales API;
      it authenticates with OAuth2 or with an API key
    - @ref FreshsalesRestClient::FreshsalesRestConnection "FreshsalesRestConnection":
      provides a connection object to Freshsales services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @section freshsalesrestclient_auth Authentication

    |!Method|!What it is|!Options
    |OAuth2|the authorization code flow, with refresh tokens, against OAuth credentials created for the \
Freshworks organization|\c domain, \c oauth2_client_id, \c oauth2_client_secret, \c oauth2_scopes
    |API key|the key shown under Profile Settings > API Settings in Freshsales|\c domain, \c apikey

    OAuth2 is the first alternative of the connection.  Its endpoints are on the organization's own domain:
    \c https://{org}.myfreshworks.com/org/oauth/v2/authorize and \c https://{org}.myfreshworks.com/org/oauth/v2/token,
    both built from the \c domain option; the token endpoint takes the client ID and secret by HTTP basic
    authentication (see
    <a href="https://developers.freshworks.com/docs/app-sdk/v3.0/deal/oauth-implementation-in-apps/oauth-in-external-apps/">OAuth in external apps</a>).
    Freshworks does not publish a list of its scopes, and accepts only the scopes selected for the OAuth credentials
    (ex: \c freshsales.deals.create), so \c oauth2_scopes has no default and must be set to those scopes.

    Freshsales takes an OAuth2 access token in the same form as an API key, \c "Authorization: Token token=TOKEN",
    so the clients send every token in that form, whatever token type the token response names.

    When an \c apikey is given, the OAuth2 options are removed, so that the client does not try to run the OAuth2
    flow.

    @section freshsalesrestclientrelnotes Release Notes

    @subsection freshsalesrestclientv1_1 FreshsalesRestClient v1.1
    - added OAuth2 authorization code authentication with refresh tokens on the organization's domain as the first
      alternative of the connection, with the API key kept as the fallback; OAuth2 access tokens are sent as
      \c "Token token=TOKEN" (<a href="https://github.com/qoretechnologies/qore/issues/6896">issue 6896</a>)

    @subsection freshsalesrestclientv1_0 FreshsalesRestClient v1.0
    - initial release
*/

#! the FreshsalesRestClient namespace contains all the objects in the FreshsalesRestClient module
public namespace FreshsalesRestClient {

#! Common base class for FreshsalesRestClient functionality
public class FreshsalesRestClientBase {
    public {
        #! Default Freshsales API base path
        const DefaultApiPath = "/crm/sales/api";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since default_path provides the API path)
        const DefaultPingPath = "selector/owners";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "default_path": DefaultApiPath,
            "headers": DefaultHeaders,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };

        #! Default connection URL
        const DefaultConnectionUrl = "freshsalesrest://app.myfreshworks.com";

        #! The path of the OAuth2 authorization endpoint on the organization's domain
        const AuthPath = "/org/oauth/v2/authorize";

        #! The path of the OAuth2 token endpoint on the organization's domain
        const TokenPath = "/org/oauth/v2/token";

        #! Default OAuth2 grant type
        const DefaultGrantType = "authorization_code";

        #! The authorization scheme of the \c Authorization header for API keys and OAuth2 access tokens
        /** The header is \c "Token token=TOKEN".
        */
        const TokenAuthPrefix = "Token token=";

        #! Options that only apply to OAuth2; removed when an API key is given
        const OAuth2OptionNames = (
            "oauth2_auth_args",
            "oauth2_auth_url",
            "oauth2_client_id",
            "oauth2_client_secret",
            "oauth2_grant_type",
            "oauth2_redirect_url",
            "oauth2_refresh_token",
            "oauth2_scopes",
            "oauth2_token_url",
            "oauth2_token_use_basic_auth",
        );
    }

    #! Returns the OAuth2 authorization URL for the given domain option value
    /** @param domain a \c domain option value; see @ref getDomainHost()

        @return the OAuth2 authorization URL on the organization's domain
    */
    static string getAuthUrl(string domain) {
        return "https://" + getDomainHost(domain) + AuthPath;
    }

    #! Returns the OAuth2 token URL for the given domain option value
    /** @param domain a \c domain option value; see @ref getDomainHost()

        @return the OAuth2 token URL on the organization's domain
    */
    static string getTokenUrl(string domain) {
        return "https://" + getDomainHost(domain) + TokenPath;
    }

    #! Returns the value of the \c Authorization header for an API key or OAuth2 access token
    static string getAuthHeader(string token) {
        return TokenAuthPrefix + token;
    }

    #! Extracts the host from a domain option value
    /** Handles bare subdomains (\c "mycompany"), full domains
        (\c "mycompany-org.myfreshworks.com"), and full URLs
        (\c "https://mycompany-org.myfreshworks.com/crm/sales")
    */
    static string getDomainHost(string domain) {
        # Strip protocol and path
        domain =~ s/^https?:\/\///;
        domain =~ s/\/.*$//;
        # If just a subdomain (no dots), append .myfreshworks.com
        if (domain !~ /\./) {
            return domain + ".myfreshworks.com";
        }
        return domain;
    }

    #! returns options for the FreshsalesRestClient constructor
    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;
        # the headers are set in an "auto!" local: a caller's headers option may be narrowed (e.g. hash<string, int>
        # for {"X-Count": 1}), and adding a string header would throw
        *hash<auto!> hdr = rv.headers;

        # Always build URL from domain when provided (auto_url may set url to anything)
        if (opts.domain) {
            rv.url = "https://" + getDomainHost(opts.domain);
        } else if (!rv.url) {
            rv.url = "https://app.myfreshworks.com";
        }

        # Set Freshsales token authentication
        if (opts.apikey.val()) {
            hdr.Authorization = getAuthHeader(opts.apikey);
            # a client authenticating with an API key does not use OAuth2; the OAuth2 options are removed after
            # the defaults are applied, or a defaulted grant type would make the client demand a client ID and
            # secret.  The test is whether an API key was given: an authorized OAuth2 connection also has a
            # token and keeps its OAuth2 options so that the token can be refreshed
            rv -= OAuth2OptionNames;
        } else if (opts.oauth2_client_id.val()) {
            # the OAuth2 endpoints are on the organization's domain
            if (opts.domain) {
                rv.oauth2_auth_url = getAuthUrl(opts.domain);
                rv.oauth2_token_url = getTokenUrl(opts.domain);
            }
            if (!rv.oauth2_grant_type) {
                rv.oauth2_grant_type = DefaultGrantType;
            }
            if (!exists rv.oauth2_token_use_basic_auth) {
                rv.oauth2_token_use_basic_auth = True;
            }
        }

        # Remove raw options to prevent RestClient misinterpretation
        remove rv.apikey;
        remove rv.domain;

        if (exists hdr) {
            rv.headers = hdr;
        }
        return rv;
    }
}

#! This class provides the REST client API for communication with Freshsales servers
/** Freshsales uses a REST API at https://{domain}.myfreshworks.com/crm/sales/api with
    token-based authentication.

    @par Authentication:
    - OAuth2 access token or API key via Authorization header: \c "Token token=TOKEN"
    - API key obtained from: Profile Settings > API Settings in Freshsales
    - see @ref freshsalesrestclient_auth

    @par API Structure:
    All endpoints are under /crm/sales/api (set via default_path)
*/
public class FreshsalesRestClient inherits RestClient::RestClient, FreshsalesRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
FreshsalesRestClient freshsales({
    "domain": "mycompany",
    "apikey": ENV.FRESHSALES_API_KEY,
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient"
        class plus:
        - \c domain: the Freshsales subdomain (e.g., \c "mycompany" for
          \c "https://mycompany.myfreshworks.com")
        - \c apikey: the Freshsales API key; if given, the OAuth2 options are removed

        Without \c apikey, the OAuth2 options are used (\c oauth2_client_id and \c oauth2_client_secret, with
        \c token and \c oauth2_refresh_token once authorized); the OAuth2 URLs are built from \c domain.

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(FreshsalesRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! Sets a token for authentication
    /** Freshsales takes an OAuth2 access token as \c "Authorization: Token token=TOKEN", whatever the token type
        of the token response, so the header that the base class sets is replaced with that form.
    */
    setToken(string token_type, string token, *string refresh_token, *date token_expiry) {
        RestClient::setToken(token_type, token, refresh_token, token_expiry);
        addDefaultHeaders({"Authorization": FreshsalesRestClientBase::getAuthHeader(token)});
    }
}

#! Class for Freshsales REST connections; returns @ref FreshsalesRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; the OAuth2
    URLs are always built from the \c domain option (see @ref freshsalesrestclient_auth)

    @see @ref FreshsalesRestClient::FreshsalesRestClient::constructor() for more information on the
    above options
*/
public class FreshsalesRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation("FreshsalesRestClient",
            "FreshsalesRestConnection", "en", <ConnectionSchemeInfo>{
            "display_name": "Freshsales REST Connection",
            "short_desc": "A connection to the Freshsales CRM REST API",
            "desc": "A connection to the Freshsales CRM REST API for managing contacts, accounts, "
                "deals, tasks, appointments, and notes.\n\n"
                "**To obtain your API key:**\n"
                "1. Log in to your Freshsales account\n"
                "2. Click your profile picture in the top-right corner\n"
                "3. Go to **Settings** > **API Settings**\n"
                "4. Copy your API key\n\n"
                "**To find your subdomain:**\n"
                "Your subdomain is the part before `.myfreshworks.com` in your Freshsales URL "
                "(e.g., `mycompany` from `https://mycompany.myfreshworks.com`)\n\n"
                "**OAuth2** can be used instead of an API key: use the client ID and secret of OAuth "
                "credentials created for your Freshworks organization and set the scopes selected for "
                "them. The OAuth2 endpoints are built from your domain.",
            "cls": Class::forName("FreshsalesRestConnection"),
            "auto_url": True,
            "schemes": {
                "freshsalesrest": True,
            },
            "base_scheme_map": {
                "https": "freshsalesrest",
            },
            # OAuth2 is the first alternative and the API key the fallback; both need the organization's domain,
            # which the OAuth2 endpoints are on
            "required_options": "domain,oauth2_client_id,oauth2_client_secret|domain,apikey",
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Freshsales API key for authentication",
                    "type": "string",
                    "desc": "The Freshsales API key used for token authentication.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Freshsales account\n"
                        "2. Click your profile picture in the top-right corner\n"
                        "3. Go to **Settings** > **API Settings**\n"
                        "4. Copy your API key\n\n"
                        "Rate limit: 1,000 API requests per hour per account",
                    "sensitive": True,
                    "preselected": True,
                },
                "data": connection_option_override(RestConnection::ConnectionScheme.options."data", {
                    "default_value": FreshsalesRestClientBase::DefaultData,
                }),
                "domain": <ConnectionOptionInfo>{
                    "display_name": "Freshsales Domain",
                    "short_desc": "Your Freshsales subdomain or full domain",
                    "type": "string",
                    "desc": "The domain of your Freshsales account.\n\n"
                        "You can provide either:\n"
                        "- Just the subdomain (e.g., `mycompany`)\n"
                        "- The full domain (e.g., `mycompany-org.myfreshworks.com`)\n"
                        "- A full URL (e.g., `https://mycompany-org.myfreshworks.com/crm/sales`)\n\n"
                        "The subdomain or domain is extracted automatically",
                    "preselected": True,
                },
                "oauth2_grant_type": connection_option_override(
                    RestConnection::ConnectionScheme.options.oauth2_grant_type, {
                        "default_value": FreshsalesRestClientBase::DefaultGrantType,
                    }),
                "oauth2_token_use_basic_auth": connection_option_override(
                    RestConnection::ConnectionScheme.options.oauth2_token_use_basic_auth, {
                        "default_value": True,
                    }),
                "ping_headers": connection_option_override(RestConnection::ConnectionScheme.options."ping_headers", {
                    "default_value": FreshsalesRestClientBase::DefaultPingHeaders,
                }),
                "ping_method": connection_option_override(RestConnection::ConnectionScheme.options."ping_method", {
                    "default_value": FreshsalesRestClientBase::DefaultPingMethod,
                }),
                "ping_path": connection_option_override(RestConnection::ConnectionScheme.options."ping_path", {
                    "default_value": FreshsalesRestClientBase::DefaultPingPath,
                }),
            },
        });
    }

    #! creates the FreshsalesRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and
        \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description,
            string url = FreshsalesRestClientBase::DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes,
                FreshsalesRestConnection::fixOAuth2Urls(options)) {
    }

    #! creates the FreshsalesRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(FreshsalesRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref FreshsalesRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        if (!config.url || config.url == FreshsalesRestClientBase::DefaultConnectionUrl) {
            string host = FreshsalesRestClientBase::getDomainHost(config.opts.domain ?? "app");
            config.url = "freshsalesrest://" + host;
        }
        if (config.opts) {
            config.opts = FreshsalesRestConnection::fixOAuth2Urls(config.opts);
        }
        return config;
    }

    #! Builds the OAuth2 URLs from the \c domain option, so that they always match it
    /** A connection with an API key does not use OAuth2 and gets no OAuth2 URLs.
    */
    private static hash<auto> fixOAuth2Urls(hash<auto> options) {
        if (options.domain && !options.apikey) {
            options.oauth2_auth_url = FreshsalesRestClientBase::getAuthUrl(options.domain);
            options.oauth2_token_url = FreshsalesRestClientBase::getTokenUrl(options.domain);
        }
        return options;
    }

    #! Returns connection options with the OAuth2 URLs always built from the \c domain option
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        if (rv.domain && !rv.apikey) {
            rv.oauth2_auth_url = FreshsalesRestClientBase::getAuthUrl(rv.domain);
            rv.oauth2_token_url = FreshsalesRestClientBase::getTokenUrl(rv.domain);
        }
        return rv;
    }

    #! returns \c "freshsalesrest"
    string getType() {
        return "freshsalesrest";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Freshsales";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the FreshsalesDataProvider and creates
        # the data provider object dynamically
        load_module("FreshsalesDataProvider");
        return create_object("FreshsalesDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            # Fix URL if it was mangled by auto_url
            string host = FreshsalesRestClientBase::getDomainHost(opts.domain ?? "app");
            string expected_url = "freshsalesrest://" + host;
            if (url != expected_url) {
                update.url = expected_url;
            }
            # Rebuild the OAuth2 URLs from the domain
            if (opts.domain && !opts.apikey) {
                string expected_auth_url = FreshsalesRestClientBase::getAuthUrl(opts.domain);
                if (opts.oauth2_auth_url != expected_auth_url) {
                    update.oauth2_auth_url = expected_auth_url;
                }
                string expected_token_url = FreshsalesRestClientBase::getTokenUrl(opts.domain);
                if (opts.oauth2_token_url != expected_token_url) {
                    update.oauth2_token_url = expected_token_url;
                }
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref FreshsalesRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter
        is ignored

        @return a @ref FreshsalesRestClient object
    */
    private FreshsalesRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new FreshsalesRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new FreshsalesRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Freshsales REST API using multiplexed HTTP connections
/** @see FreshsalesRestClient for more information
*/
public class FreshsalesRestClientIo inherits RestClientIo::RestClientIo, FreshsalesRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(FreshsalesRestClientBase::getOptions(opts), shared_mgr) {
    }

    #! Sets a token for authentication
    /** Freshsales takes an OAuth2 access token as \c "Authorization: Token token=TOKEN", whatever the token type
        of the token response, so the header that the base class sets is replaced with that form.
    */
    setToken(string token_type, string token, *string new_refresh_token, *date token_expiry) {
        RestClientIo::setToken(token_type, token, new_refresh_token, token_expiry);
        addDefaultHeaders({"authorization": FreshsalesRestClientBase::getAuthHeader(token)});
    }
}
}
