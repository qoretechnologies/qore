# minimum qore version
%requires qore >= 2.0

# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module FreshsalesRestClient {
    version = "1.0";
    desc = "User module for calling Freshsales REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("freshsalesrest",
            FreshsalesRestConnection::ConnectionScheme);
    };
}

/** @mainpage FreshsalesRestClient Module

    @tableofcontents

    @section freshsalesrestclientintro FreshsalesRestClient Introduction

    The %FreshsalesRestClient module provides an API for calling Freshsales REST API services.

    To use this module, use \c "%requires FreshsalesRestClient" in your code.

    All the public symbols in the module are defined in the FreshsalesRestClient namespace.

    The main classes are:
    - @ref FreshsalesRestClient::FreshsalesRestClient "FreshsalesRestClient":
      this class provides the REST client API for communication with the Freshsales API;
      it handles API key authentication
    - @ref FreshsalesRestClient::FreshsalesRestConnection "FreshsalesRestConnection":
      provides a connection object to Freshsales services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @section freshsalesrestclientrelnotes Release Notes

    @subsection freshsalesrestclientv1_0 FreshsalesRestClient v1.0
    - the initial version of the %FreshsalesRestClient module
*/

#! the FreshsalesRestClient namespace contains all the objects in the FreshsalesRestClient module
public namespace FreshsalesRestClient {

#! Common base class for FreshsalesRestClient functionality
public class FreshsalesRestClientBase {
    public {
        #! Default Freshsales API base path
        const DefaultApiPath = "/crm/sales/api";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since default_path provides the API path)
        const DefaultPingPath = "contacts?page=1&per_page=1";

        #! Default ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "default_path": DefaultApiPath,
            "headers": DefaultHeaders,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };

        #! Default connection URL
        const DefaultConnectionUrl = "freshsalesrest://app.myfreshworks.com";
    }

    #! returns options for the FreshsalesRestClient constructor
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Build URL from domain if not explicitly set
        if (opts.domain) {
            if (!rv.url || rv.url == DefaultConnectionUrl) {
                rv.url = sprintf("https://%s.myfreshworks.com", opts.domain);
            }
        }

        # Ensure URL is always set (auto_url connections may pass NOTHING)
        if (!rv.url) {
            rv.url = "https://app.myfreshworks.com";
        }

        # Set Freshsales token authentication
        if (opts.apikey) {
            rv.headers.Authorization = "Token token=" + opts.apikey;
        }

        # Remove raw options to prevent RestClient misinterpretation
        remove rv.apikey;
        remove rv.domain;

        return rv;
    }
}

#! This class provides the REST client API for communication with Freshsales servers
/** Freshsales uses a REST API at https://{domain}.myfreshworks.com/crm/sales/api with
    token-based authentication.

    @par Authentication:
    - API key via Authorization header: \c "Token token=API_KEY"
    - API key obtained from: Profile Settings > API Settings in Freshsales

    @par API Structure:
    All endpoints are under /crm/sales/api (set via default_path)
*/
public class FreshsalesRestClient inherits RestClient::RestClient, FreshsalesRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
FreshsalesRestClient freshsales({
    "domain": "mycompany",
    "apikey": ENV.FRESHSALES_API_KEY,
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient"
        class plus:
        - \c domain: the Freshsales subdomain (e.g., \c "mycompany" for
          \c "https://mycompany.myfreshworks.com")
        - \c apikey: the Freshsales API key

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(FreshsalesRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Freshsales REST connections; returns @ref FreshsalesRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref FreshsalesRestClient::FreshsalesRestClient::constructor() for more information on the
    above options
*/
public class FreshsalesRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Freshsales REST Connection",
            "short_desc": "A connection to the Freshsales CRM REST API",
            "desc": "A connection to the Freshsales CRM REST API for managing contacts, accounts, "
                "deals, tasks, appointments, and notes.\n\n"
                "**To obtain your API key:**\n"
                "1. Log in to your Freshsales account\n"
                "2. Click your profile picture in the top-right corner\n"
                "3. Go to **Settings** > **API Settings**\n"
                "4. Copy your API key\n\n"
                "**To find your subdomain:**\n"
                "Your subdomain is the part before `.myfreshworks.com` in your Freshsales URL "
                "(e.g., `mycompany` from `https://mycompany.myfreshworks.com`)",
            "cls": Class::forName("FreshsalesRestConnection"),
            "auto_url": True,
            "schemes": {
                "freshsalesrest": True,
            },
            "base_scheme_map": {
                "https": "freshsalesrest",
            },
            "required_options": "domain,apikey",
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Freshsales API key for authentication",
                    "type": "string",
                    "desc": "The Freshsales API key used for token authentication.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Freshsales account\n"
                        "2. Click your profile picture in the top-right corner\n"
                        "3. Go to **Settings** > **API Settings**\n"
                        "4. Copy your API key\n\n"
                        "Rate limit: 1,000 API requests per hour per account",
                    "sensitive": True,
                    "preselected": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": FreshsalesRestClientBase::DefaultData,
                },
                "domain": <ConnectionOptionInfo>{
                    "display_name": "Freshsales Subdomain",
                    "short_desc": "Your Freshsales account subdomain",
                    "type": "string",
                    "desc": "The subdomain of your Freshsales account.\n\n"
                        "This is the part before `.myfreshworks.com` in your Freshsales URL "
                        "(e.g., `mycompany` from `https://mycompany.myfreshworks.com`)",
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": FreshsalesRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": FreshsalesRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": FreshsalesRestClientBase::DefaultPingPath,
                },
            },
        };
    }

    #! creates the FreshsalesRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and
        \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description,
            string url = FreshsalesRestClientBase::DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the FreshsalesRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(FreshsalesRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref FreshsalesRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        if (!config.url || config.url == FreshsalesRestClientBase::DefaultConnectionUrl) {
            string domain = config.opts.domain ?? "app";
            config.url = sprintf("freshsalesrest://%s.myfreshworks.com", domain);
        }
        return config;
    }

    #! returns \c "freshsalesrest"
    string getType() {
        return "freshsalesrest";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Freshsales";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the FreshsalesDataProvider and creates
        # the data provider object dynamically
        load_module("FreshsalesDataProvider");
        return create_object("FreshsalesDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
        children_can_support_observers = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options) {
            hash<auto> update;
            # Fix URL if it was mangled by auto_url
            string expected_url = sprintf("freshsalesrest://%s.myfreshworks.com",
                opts.domain ?? "app");
            if (url != expected_url) {
                update.url = expected_url;
            }
            if (opts.ping_path =~ /^\//) {
                update.ping_path = opts.ping_path.substr(1);
            }
            if (update) {
                doUpdateOptions(self, update);
            }
        }
    }

    #! returns a @ref FreshsalesRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter
        is ignored

        @return a @ref FreshsalesRestClient object
    */
    private FreshsalesRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new FreshsalesRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since FreshsalesRestClient 1.0
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new FreshsalesRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Freshsales REST API using multiplexed HTTP connections
/** @see FreshsalesRestClient for more information
*/
public class FreshsalesRestClientIo inherits RestClientIo::RestClientIo, FreshsalesRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(FreshsalesRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
