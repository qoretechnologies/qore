# minimum required Qore version
%requires qore >= 1.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) OpenAiRestClient
%requires RestClientIo
%requires FileLocationHandler

%requires json

%try-module yaml
%define NoYaml
%endtry

module OpenAiDataProvider {
    version = "1.6";
    desc = "user module providing a data provider API for OpenAI services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # fix OpenAiModelFileSearchToolCompoundFilterDataType
        OpenAiModelFileSearchToolCompoundFilterDataType.replaceField(new QoreDataField({
            "name": "filters",
            "type": new ListDataType("FilterList", OpenAiModelFileSearchToolFilterDataType),
        }));

        # register the data provider factory
        DataProvider::registerFactory(new OpenAiDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": OpenAiDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "OpenAI Services",
            "short_desc": "OpenAI services",
            "desc": "OpenAI services",
            "scheme": "openai",
            "logo": OpenAiLogo,
            "logo_file_name": "openai-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/multi-chat",
            "action": "multi-chat",
            "display_name": "Multi Chat",
            "short_desc": "Chat with an AI model by sending multiple messages at once and potentially getting "
                "multiple replies",
            "desc": "Chat with an AI model by sending multiple messages at once and potentially getting multiple "
                "replies",
            "action_code": DPAT_API,
            "mutates_state": False,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiChatCompletionRequestType.getFields(){"model", "messages"}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiChatCompletionRequestType.getFields() - ("model", "messages")
            ),
            "output_type": OpenAiChatCompletionDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/simple-chat",
            "action": "simple-chat",
            "display_name": "Simple Chat",
            "short_desc": "Chat with an AI model by sending a single message and receiving a single reply",
            "desc": "Chat with an AI model by sending a single message and receiving a single reply",
            "action_code": DPAT_API,
            "mutates_state": False,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiSimpleChatCompletionRequestType.getFields(){"model", "role", "content"}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiSimpleChatCompletionRequestType.getFields() - ("model", "role", "content")
            ),
            "output_type": OpenAiChatCompletionDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/upload-file",
            "action": "upload-file",
            "display_name": "Upload File",
            "short_desc": "Upload a file for an assistant, for fine tuning, or for batch processing",
            "desc": "Upload a file for an assistant, for fine tuning, or for batch processing",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiFileUploadRequestType.getFields(){"purpose", "file"}, {
                    "preselected": True,
                    "required": True,
                }
            ),
            "output_type": OpenAiFileUploadFromLocationDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/files/{file}/delete",
            "action": "delete-file",
            "display_name": "Delete File",
            "short_desc": "Delete a file stored on OpenAI",
            "desc": "Delete a file stored on OpenAI",
            "action_code": DPAT_API,
            "mutates_state": True,
            "path_vars": {
                "file": <DataProviderPathVarInfo>{
                    "display_name": "File",
                    "short_desc": "The ID or OpenAI file name of the file to delete",
                    "desc": "The ID or OpenAI file name of the file to delete",
                    "example_value": "file-XlKc5wjQpWHfXbKwhCZeAuul",
                },
            },
            "output_type": OpenAiDeleteResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/create-assistant",
            "action": "create-assistant",
            "display_name": "Create an Assistant",
            "short_desc": "Create an assistant",
            "desc": "Create an assistant with a model and instructions",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiAssistantCreateRequestType.getFields(){"model",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiAssistantCreateRequestType.getFields() - ("model",)
            ),
            "output_type": OpenAiAssistantCreateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/assistants/{assistant}/update",
            "action": "update-assistant",
            "display_name": "Update Assistant",
            "short_desc": "Update an assistant",
            "desc": "Update an assistant",
            "action_code": DPAT_API,
            "mutates_state": True,
            "path_vars": {
                "assistant": <DataProviderPathVarInfo>{
                    "display_name": "Assistant",
                    "short_desc": "The ID of the assistant to update",
                    "desc": "The ID of the assistant to update",
                    "example_value": "asst_pOVJLN6z0hTsW1UKpALakcLA",
                },
            },
            # every field is optional on an update, so nothing is preselected automatically;
            # without an explicit set the action opens with an empty form
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiAssistantUpdateRequestType::Fields{"name", "model", "instructions",},
                {"preselected": True})
                + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiAssistantUpdateRequestType::Fields - ("name", "model", "instructions")
            ),
            "output_type": OpenAiAssistantUpdateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/assistants/{assistant}/delete",
            "action": "delete-assistant",
            "display_name": "Delete Assistant",
            "short_desc": "Delete an assistant",
            "desc": "Delete an assistant",
            "action_code": DPAT_API,
            "mutates_state": True,
            "path_vars": {
                "assistant": <DataProviderPathVarInfo>{
                    "display_name": "Assistant",
                    "short_desc": "The ID of the assistant to delete",
                    "desc": "The ID of the assistant to delete",
                    "example_value": "asst_pOVJLN6z0hTsW1UKpALakcLA",
                },
            },
            "output_type": OpenAiDeleteResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/threads/create",
            "action": "create-thread",
            "display_name": "Create a Thread",
            "short_desc": "Create a thread",
            "desc": "Create a thread with the given messages",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiThreadCreateRequestType.getFields(){"messages",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiThreadCreateRequestType.getFields() - ("messages",)
            ),
            "output_type": OpenAiThreadCreateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/threads/update",
            "action": "update-thread",
            "display_name": "Update Thread",
            "short_desc": "Update a thread",
            "desc": "Update a thread",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiThreadUpdateRequestType.getFields(){"thread_id",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiThreadUpdateRequestType.getFields() - "thread_id"
            ),
            "output_type": OpenAiThreadUpdateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/threads/delete",
            "action": "delete-thread",
            "display_name": "Delete Thread",
            "short_desc": "Delete a thread",
            "desc": "Delete a thread",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiThreadIdRequestType.getFields(){"thread_id",}, {
                    "preselected": True,
                    "required": True,
                }
            ),
            "output_type": OpenAiDeleteResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/models/{model}/create-response",
            "action": "create-response",
            "display_name": "Process Request With a Model",
            "short_desc": "Process a request with a model",
            "desc": "Process a request with a model",
            "action_code": DPAT_API,
            "mutates_state": True,
            "path_vars": {
                "model": <DataProviderPathVarInfo>{
                    "display_name": "Model",
                    "short_desc": "The OpenAI model to use",
                    "desc": "The OpenAI model to use",
                    "example_value": "gpt-4o",
                },
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiModelCreateResponseRequestDataType::Fields{"input",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiModelCreateResponseRequestDataType::Fields - "input"
            ),
            "output_type": OpenAiModelCreateResponseResponseDataType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/models/{model}/create-response/stream",
            "action": "stream-response",
            "display_name": "Stream Response",
            "short_desc": "Stream a response from a model",
            "desc": "Stream a response from a model with Server-Sent Events",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_OPENAI_RESPONSE_STREAM,
            "path_vars": {
                "model": <DataProviderPathVarInfo>{
                    "display_name": "Model",
                    "short_desc": "The OpenAI model to use",
                    "desc": "The OpenAI model to use",
                    "example_value": "gpt-4o",
                },
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiModelCreateResponseRequestDataType::Fields{"input",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiModelCreateResponseRequestDataType::Fields - "input"
            ),
            "output_type": OpenAiResponseStreamEventDataType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/conversations/create",
            "action": "create-conversation",
            "display_name": "Create a Conversation",
            "short_desc": "Create a conversation to hold response history",
            "desc": "Create a conversation to hold response history.\n\n"
                "Conversations are the Responses API replacement for Assistants API threads; pass the resulting "
                "conversation ID in the `conversation` field of a create-response request",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationCreateRequestType::Fields{"items",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationCreateRequestType::Fields - ("items",)
            ),
            "output_type": OpenAiConversationCreateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/conversations/get",
            "action": "get-conversation",
            "display_name": "Get a Conversation",
            "short_desc": "Retrieve a conversation",
            "desc": "Retrieve a conversation",
            "action_code": DPAT_API,
            "mutates_state": False,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationIdRequestType::Fields{"conversation_id",}, {
                    "preselected": True,
                    "required": True,
                }
            ),
            "output_type": OpenAiConversationGetDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/conversations/update",
            "action": "update-conversation",
            "display_name": "Update a Conversation",
            "short_desc": "Update the metadata of a conversation",
            "desc": "Update the metadata of a conversation",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationUpdateRequestType::Fields{"conversation_id", "metadata"}, {
                    "preselected": True,
                    "required": True,
                }
            ),
            "output_type": OpenAiConversationUpdateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/conversations/delete",
            "action": "delete-conversation",
            "display_name": "Delete a Conversation",
            "short_desc": "Delete a conversation",
            "desc": "Delete a conversation.\n\n"
                "**Note**: items in the conversation are not deleted",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationIdRequestType::Fields{"conversation_id",}, {
                    "preselected": True,
                    "required": True,
                }
            ),
            "output_type": OpenAiConversationDeleteDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/conversations/items/list",
            "action": "list-conversation-items",
            "display_name": "List Conversation Items",
            "short_desc": "List the items in a conversation",
            "desc": "List the items in a conversation.\n\n"
                "Items are messages, tool calls, and tool call outputs recorded against the conversation",
            "action_code": DPAT_API,
            "mutates_state": False,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationItemListRequestType::Fields{"conversation_id",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationItemListRequestType::Fields{"limit", "order"}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationItemListRequestType::Fields - ("conversation_id", "limit", "order")
            ),
            "output_type": OpenAiConversationItemListDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/conversations/items/create",
            "action": "create-conversation-items",
            "display_name": "Add Items to a Conversation",
            "short_desc": "Add items to a conversation",
            "desc": "Add items to a conversation",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationItemCreateRequestType::Fields{"conversation_id", "items"}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationItemCreateRequestType::Fields - ("conversation_id", "items")
            ),
            "output_type": OpenAiConversationItemCreateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/conversations/items/get",
            "action": "get-conversation-item",
            "display_name": "Get a Conversation Item",
            "short_desc": "Retrieve a single item from a conversation",
            "desc": "Retrieve a single item from a conversation",
            "action_code": DPAT_API,
            "mutates_state": False,
            # conversation_id and item_id are declared inline so that the cascading-dropdown metadata
            # (has_dependents / depends_on / on_change) is propagated; getActionOptionFromFields() drops it
            "options": OpenAiConversationItemActionOptions
                + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiConversationItemGetRequestType::Fields - ("conversation_id", "item_id")
            ),
            "output_type": OpenAiConversationItemGetDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/conversations/items/delete",
            "action": "delete-conversation-item",
            "display_name": "Delete a Conversation Item",
            "short_desc": "Delete an item from a conversation",
            "desc": "Delete an item from a conversation.\n\n"
                "**Note**: the API returns the updated conversation, not a deletion receipt",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": OpenAiConversationItemActionOptions,
            "output_type": OpenAiConversationItemDeleteDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/responses/cancel",
            "action": "cancel-response",
            "display_name": "Cancel a Response",
            "short_desc": "Cancel a background response",
            "desc": "Cancel a background response.\n\n"
                "**Note**: only responses created with `background` set to `True` can be cancelled",
            "action_code": DPAT_API,
            "mutates_state": True,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiModelGetResponseRequestDataType::Fields{"id",}, {
                    "preselected": True,
                    "required": True,
                }
            ),
            "output_type": OpenAiResponseCancelDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/responses/input-items",
            "action": "list-response-input-items",
            "display_name": "List Response Input Items",
            "short_desc": "List the input items used to generate a response",
            "desc": "List the input items used to generate a response.\n\n"
                "This is the Responses API equivalent of listing the steps of an Assistants API run",
            "action_code": DPAT_API,
            "mutates_state": False,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiResponseInputItemsRequestType::Fields{"id",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiResponseInputItemsRequestType::Fields{"limit", "order"}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiResponseInputItemsRequestType::Fields - ("id", "limit", "order")
            ),
            "output_type": OpenAiResponseInputItemsDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpenAiDataProvider::AppName,
            "path": "/create-image",
            "action": "create-image",
            "display_name": "Generate an Image",
            "short_desc": "Generate an image from a prompt",
            "desc": "Generate an image from a prompt",
            "action_code": DPAT_API,
            "mutates_state": False,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiImageCreateRequestType::Fields{"prompt",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpenAiImageCreateRequestType::Fields - "prompt"
            ),
            "output_type": OpenAiCreateImageResponseType,
        });
    };
}

/** @mainpage OpenAiDataProvider Module

    @tableofcontents

    @section openaidataproviderintro Introduction to the OpenAiDataProvider Module

    The %OpenAiDataProvider module provides a @ref dataproviderintro "data provider" API for OpenAI services.

    @section openaidataprovider_examples Examples

    @subsection openaidataprovider_response_tools Responses with Tool Calls and Structured Output

    @code{.py}
%requires OpenAiDataProvider

OpenAiRestConnection rc = get_connection("openai");
OpenAiDataProvider::OpenAiDataProvider prov(rc.get());

AbstractDataProvider resp = prov.getChildProvider("responses").getChildProvider("create");
hash<auto> result = resp.doRequest({
    "model": "gpt-4o-mini",
    "input": (
        {
            "input_item": {
                "role": "user",
                "content": (
                    {
                        "type": "input_text",
                        "text": "Return the sum of 2 and 3",
                    },
                ),
            },
        },
    ),
    "tools": (
        {
            "function": {
                "name": "sum",
                "description": "Returns a+b",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "a": {"type": "integer"},
                        "b": {"type": "integer"},
                    },
                    "required": ("a", "b"),
                },
            },
        },
    ),
    "text": {
        "format": {
            "type": "json_schema",
            "json_schema": {
                "name": "SumAnswer",
                "schema": {
                    "type": "object",
                    "properties": {
                        "answer": {"type": "integer"},
                    },
                    "required": ("answer",),
                },
                "strict": True,
            },
        },
    },
});

# Tool call handling and tool result submission:
if (result.tool_calls) {
    hash<auto> call = result.tool_calls[0];
    # ...call your tool with call.name and call.arguments...
    # Tool results are returned as "function_call_output" input items on a follow-up request; this replaces
    # the deprecated Assistants API "submit_tool_outputs" endpoint
    hash<auto> follow_up = resp.doRequest({
        "model": "gpt-4o-mini",
        "previous_response_id": result.id,
        "input": (
            {
                "function_call_output": {
                    "call_id": call.call_id,
                    "output": "{\"answer\":5}",
                },
            },
        ),
    });
}

# Convenience helpers for downstream use:
list<hash<auto>> tool_calls = result.tool_calls;
list<hash<auto>> tool_results = result.tool_results;
string text = result.output_text;
    @endcode

    @subsection openaidataprovider_context_store Conversation Context Store

    @code{.py}
class MyContextStore inherits OpenAiConversationContextStore {
    *hash<auto> loadContext(string key) { return get_from_store(key); }
    nothing saveContext(string key, hash<auto> ctxt) { save_to_store(key, ctxt); }
}

OpenAiRestConnection rc = get_connection("openai");
OpenAiDataProvider::OpenAiDataProvider prov(rc.get());
prov.setConversationContextStore(new MyContextStore());

AbstractDataProvider resp = prov.getChildProvider("responses").getChildProvider("create");
hash<auto> result = resp.doRequest({
    "model": "gpt-4o-mini",
    "input": (
        {
            "input_item": {
                "role": "user",
                "content": (
                    {
                        "type": "input_text",
                        "text": "Continue our previous conversation",
                    },
                ),
            },
        },
    ),
    "conversation_key": "user-42",
});
    @endcode

    @subsection openaidataprovider_context_callbacks Conversation Context Store Callbacks

    @code{.py}
OpenAiConversationContextStoreCallbacks store(
    sub (string key) { return get_from_store(key); },
    nothing sub (string key, hash<auto> ctxt) { save_to_store(key, ctxt); }
);

OpenAiRestConnection rc = get_connection("openai");
OpenAiDataProvider::OpenAiDataProvider prov(rc.get());
prov.setConversationContextStore(store);
    @endcode

    @subsection openaidataprovider_stream_example Streaming Responses

    @code{.py}
%requires OpenAiDataProvider

OpenAiRestConnection rc = get_connection("openai");
OpenAiDataProvider::OpenAiDataProvider prov(rc.get());

AbstractDataProvider stream = prov.getChildProvider("responses").getChildProvider("stream");
stream.registerObserver(myObserver);
stream.observersReady();
stream.doRequest({
    "model": "gpt-4o-mini",
    "input": (
        {
            "input_item": {
                "role": "user",
                "content": (
                    {
                        "type": "input_text",
                        "text": "Stream a response",
                    },
                ),
            },
        },
    ),
});
@endcode

    For Creator WebSocket integrations, the action-based
    @ref OpenAiDataProvider::OpenAiResponseActionSession "OpenAiResponseActionSession"
    class provides a transport-agnostic interface for response creation and streaming
    with normalized rich content output.

    @subsection openaidataprovider_stream_events Stream Event Payloads

    The stream provider emits SSE events with a `type` field matching the Responses API event types. A few common
    examples:
    - `response.output_text.delta`
    - `response.tool_call.delta`
    - `response.completed`

    The emitted event hash also includes `event` and `id` when provided by the server. The `responses/stream`
    provider will persist conversation context on `response.completed` when a `conversation_key` is used.

    @subsection openaidataprovider_conversations Server-Side Conversations

    Conversations are the Responses API replacement for the deprecated Assistants API threads.  A conversation
    stores items (messages, tool calls, and tool call outputs); attaching a response to a conversation with the
    \c conversation request field prepends the conversation's items to the request input and appends the
    response's input and output items to the conversation automatically.

    @code{.py}
%requires OpenAiDataProvider

OpenAiRestConnection rc = get_connection("openai");
OpenAiDataProvider::OpenAiDataProvider prov(rc.get());

AbstractDataProvider conversations = prov.getChildProvider("conversations");

# create a conversation
hash<auto> conv = conversations.getChildProvider("create").doRequest({
    "metadata": {"topic": "support"},
});

# run a response bound to the conversation; no previous_response_id bookkeeping is needed
AbstractDataProvider create = prov.getChildProvider("responses").getChildProvider("create");
hash<auto> first = create.doRequest({
    "model": "gpt-4o-mini",
    "conversation": conv.id,
    "input": "What is the capital of France?",
});
hash<auto> second = create.doRequest({
    "model": "gpt-4o-mini",
    "conversation": conv.id,
    "input": "And its population?",
});

# list everything recorded against the conversation
hash<auto> items = conversations.getChildProvider("items").getChildProvider("list").doRequest({
    "conversation_id": conv.id,
    "order": "asc",
});
    @endcode

    @section openaidataprovider_assistants_deprecation Assistants API Deprecation

    OpenAI deprecated the Assistants API on 2025-08-26 and will remove it on <b>2026-08-26</b>.  Every
    \c assistants, \c threads, and \c runs data provider in this module calls that API and will stop working on
    that date.  They remain available and unchanged until then, and using one logs a deprecation warning once per
    process.

    Migrate as follows:

    @note Each table row below must stay on a single line; \c qdx does not support backslash line continuation
    inside a table and silently truncates the table where one appears.

    |!Assistants API|!Replacement
    |\c assistants|the \c responses data provider, with configuration moved into a reusable prompt
    |\c threads|the \c conversations data provider
    |\c threads/{thread_id}/messages|the \c conversations/items/list data provider
    |\c runs|the \c responses data provider
    |\c runs/{run_id}/steps|the \c responses/input-items data provider
    |\c runs/{run_id}/cancel|the \c responses/cancel data provider
    |\c runs/{run_id}/submit_tool_outputs|the \c responses/create data provider, with \c function_call_output items

    An assistant's model, tools, and instructions are replaced by a reusable prompt referenced with the \c prompt
    field of a create-response request.  Tool outputs are returned to the model as \c function_call_output input
    items on a follow-up request that sets \c previous_response_id or reuses the same \c conversation.

    @section openaidataprovider_relnotes Release Notes

    @subsection openaidataprovider_v1_6 OpenAiDataProvider v1.6
    - added the \c conversations data provider tree implementing the OpenAI Conversations API
      (create, get, update, delete, and item list/create/get/delete), replacing the deprecated Assistants API
      threads
    - added the \c responses/cancel and \c responses/input-items data providers, replacing the deprecated
      Assistants API run cancel and run steps endpoints
    - added the \c conversation field to create-response requests and responses, binding a response to a
      server-side conversation
    - fixed conversation context propagation: the server-side conversation ID is read from the \c conversation
      object returned by the API instead of a non-existent \c conversation_id response field
    - added \c function_call_output input items to create-response requests, so function tool results can be
      returned to the model; this replaces the deprecated Assistants API \c submit_tool_outputs endpoint
    - deprecated all \c assistants, \c threads, and \c runs data providers ahead of OpenAI's 2026-08-26 removal
      of the Assistants API

    @subsection openaidataprovider_v1_5 OpenAiDataProvider v1.5
    - added OpenAiResponseActionSession for action-based response creation and streaming
    - added typed response output items for tool calls, tool results, and output content parts
    - added response stream data provider for Server-Sent Events streaming
    - response stream requests now accept a model argument for responses API compatibility
    - action session text normalization now tolerates missing output format hints
    - added conversation context store hooks for response continuity
    - added action catalog entry for streaming responses
    - added responses API input content support for text, image, audio, and file parts
    - added conversation context helpers for response continuity
    - missing APIs and actions to handle image analysis
      (<a href="https://github.com/qoretechnologies/qore/issues/4947">issue 4947</a>)
    - added APIs to handle image generation

    @subsection openaidataprovider_v1_0 OpenAiDataProvider v1.0
    - initial release of the module

    @section openaidataprovider_migration Migration Notes

    - Response output items are now typed; downstream code should prefer `output_text`, `tool_calls`, and
      `tool_results` instead of parsing raw hashes.
    - Response streaming is exposed as the `responses/stream` data provider and emits SSE events with a `type`
      field matching the Responses API event types.
    - Conversation persistence can be configured by supplying a `conversation_context_store` and using
      `conversation_key` in requests.
*/

#! contains all public definitions in the OpenAiDataProvider module
public namespace OpenAiDataProvider {
#! OpenAI app name
public const AppName = "OpenAI";

#! Logo file
const OpenAiLogo = File::readTextFile(get_script_dir() + "/openai-logo.svg");
}
