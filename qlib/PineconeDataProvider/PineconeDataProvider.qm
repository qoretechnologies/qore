%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) PineconeRestClient
%requires RestClientIo

module PineconeDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Pinecone vector DB";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new PineconeDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": PineconeDataProvider::AppName,
            "display_name": "Pinecone",
            "short_desc": "Pinecone managed vector database",
            "desc": "Provides access to [Pinecone](https://www.pinecone.io) — a fully "
                "managed vector database with serverless and pod-based deployment "
                "options.\n\n"
                "Use the @ref QoreRagUtils::PineconeVectorStore \"PineconeVectorStore\" "
                "backend in @ref qorerragutilsintro \"QoreRagUtils\" for the supported "
                "ingest/retrieve path through @ref QoreRagUtils::RagPipeline "
                "\"RagPipeline\".",
            "scheme": "pinecone",
            "logo": PineconeLogo,
            "logo_file_name": "pinecone-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Databases,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PineconeDataProvider::AppName,
            "path": "/list-indexes",
            "action": "list-indexes",
            "display_name": "List Indexes",
            "short_desc": "List Pinecone indexes for the current account",
            "desc": "Calls Pinecone's control-plane `GET /indexes` to enumerate available "
                "indexes (name, host, dimension, metric, status).",
            "action_code": DPAT_API,
            "groups": ("Admin",),
            "options": {},
            "output_type": PineconeListIndexesDataProvider::ResponseType,
        });
    };
}

/** @mainpage PineconeDataProvider Module

    @tableofcontents

    @section pineconedataproviderintro PineconeDataProvider Introduction

    Lightweight data-provider integration for
    [Pinecone](https://www.pinecone.io).  Exposes the control-plane
    index-listing endpoint; for full vector operations use the
    @ref QoreRagUtils::PineconeVectorStore "PineconeVectorStore" backend
    via @ref QoreRagUtils::RagPipeline "RagPipeline".

    @section PineconeDataProviderRelnotes Release Notes

    @subsection PineconeDataProviderv1_0 PineconeDataProvider v1.0
    - the initial version of the %PineconeDataProvider module
*/

#! contains all public definitions in the PineconeDataProvider module
public namespace PineconeDataProvider {
#! Pinecone application name
public const AppName = "Pinecone";
}

#! App logo loaded from file
public const PineconeLogo = File::readTextFile(get_script_dir() + "/pinecone-logo.svg");
