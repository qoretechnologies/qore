    #! force disconnect of socket without error
    /** @par Example:
        @code{.py}
pop3.forceDisconnect();
        @endcode

        @note This method communicates with the POP3 server with the internal @ref Qore::Socket "Socket" object and therefore is subject to thread serialization
    */
    forceDisconnect() {
        AutoLock am(mutex);
        forceDisconnectIntern();
    }

    #! Removes any warning @ref Qore::Thread::Queue "Queue" object from the Socket
    /** @par Example:
        @code{.py}
pop3.clearWarningQueue();
        @endcode

        @see setWarningQueue()

        @since %Pop3Client 1.3
    */
    nothing clearWarningQueue() {
        sock.clearWarningQueue();
    }

    #! Sets a @ref Qore::Thread::Queue "Queue" object to receive socket warnings
    /** @par Example:
        @code{.py}
pop3.setWarningQueue(5000, 5000, queue, "socket-1");
        @endcode

        @param warning_ms the threshold in milliseconds for individual socket actions (send, receive, connect), if
        exceeded, a socket warning is placed on the warning queue with the following keys:
        - \c "type": a string with the constant value \c "SOCKET-OPERATION-WARNING"
        - \c "operation": a string giving the operation that caused the warning (ex: \c "connect")
        - \c "us": an integer giving the number of microseconds for the operation
        - \c "timeout": an integer giving the warning threshold in microseconds
        - \c "arg": if any \c "arg" argument is passed to the
          @ref Pop3Client::Pop3Client::setWarningQueue() "Pop3Client::setWarningQueue()" method, it will be included
          in the warning hash here
        @param warning_bs value in bytes per second; if any call has performance below this threshold, a socket
        warning is placed on the warning queue with the following keys:
        - \c "type": a string with the constant value \c "SOCKET-THROUGHPUT-WARNING"
        - \c "dir": either \c "send" or \c "recv" depending on the direction of the data flow
        - \c "bytes": the amount of bytes sent
        - \c "us": an integer giving the number of microseconds for the operation
        - \c "bytes_sec": a float giving the transfer speed in bytes per second
        - \c "threshold": an integer giving the warning threshold in bytes per second
        - \c "arg": if any \c "arg" argument is passed to the
          @ref Pop3Client::Pop3Client::setWarningQueue() "Pop3Client::setWarningQueue()" method, it will be included
          in the warning hash here
        @param queue the @ref Qore::Thread::Queue "Queue" object to receive warning events
        @param arg an optional argument to be placed in the \c "arg" key in each warning hash (could be used to
        identify the socket for example)
        @param min_ms the minimum transfer time with a resolution of milliseconds for a transfer to be eligible for
        triggering a warning; transfers that take less than this period of time are not eligible for raising a warning

        @throw QUEUE-ERROR the Queue passed has a maximum size set
        @throw SOCKET-SETWARNINGQUEUE-ERROR at least one of \a warning_ms and \a warning_bs must be > 0

        @see clearWarningQueue()

        @since %Pop3Client 1.3
    */
    nothing setWarningQueue(int warning_ms, int warning_bs, Queue queue, auto arg, timeout min_ms = 1s) {
        sock.setWarningQueue(warning_ms, warning_bs, queue, arg, min_ms);
    }

    #! Returns performance statistics for the socket
    /** @par Example:
        @code{.py}
hash<auto> h = pop3.getUsageInfo();
        @endcode

        @return a hash with the following keys:
        - \c "bytes_sent": an integer giving the total amount of bytes sent
        - \c "bytes_recv": an integer giving the total amount of bytes received
        - \c "us_sent": an integer giving the total number of microseconds spent sending data
        - \c "us_recv": an integer giving the total number of microseconds spent receiving data
        - \c "arg": (only if warning values have been set with
          @ref Pop3Client::Pop3Client::setWarningQueue() "Pop3Client::setWarningQueue()") the optional argument for
          warning hashes
        - \c "timeout": (only if warning values have been set with
          @ref Pop3Client::Pop3Client::setWarningQueue() "Pop3Client::setWarningQueue()") the warning timeout in
          microseconds
        - \c "min_throughput": (only if warning values have been set with
          @ref Pop3Client::Pop3Client::setWarningQueue() "Pop3Client::setWarningQueue()") the minimum warning
          throughput in bytes/sec

        @since %Pop3Client 1.3

        @see clearStats()
    */
    hash<auto> getUsageInfo() {
        return sock.getUsageInfo();
    }

    #! Clears performance statistics
    /** @par Example:
        @code{.py}
pop3.clearStats();
        @endcode

        @since %Pop3Client 1.3

        @see getUsageInfo()
    */
    clearStats() {
        sock.clearStats();
    }

    #! Sets a @ref Qore::Thread::Queue "Queue" object to receive @ref socket_events "socket events"
    /** @par Example:
        @code{.py}
pop3.setEventQueue(queue);
        @endcode

        @param queue the @ref Qore::Thread::Queue "Queue" object to receive @ref socket_events "socket events"; note
        thatthe Queue passed cannot have any maximum size set or a QUEUE-ERROR will be thrown
        @param arg an argument that will be included in each event hash in the \a arg key
        @param with_data if @ref True, then the actual raw data transferred / received is also included in the events

        @throw QUEUE-ERROR the Queue passed has a maximum size set

        @see @ref event_handling for more information

        @since %Pop3Client 1.8
    */
    setEventQueue(Qore::Thread::Queue queue, auto arg, *bool with_data) {
        sock.setEventQueue(queue, arg, with_data);
    }

    #! Removes any @ref Qore::Thread::Queue "Queue" object, prohibiting the collection of socket events
    /** @par Example:
        @code{.py}
pop3.setEventQueue();
        @endcode

        @see @ref event_handling for more information

        @since %Pop3Client 1.8
    */
    setEventQueue() {
        sock.setEventQueue();
    }

    #! @cond nodoc
    private *hash<auto> getMailAsyncIntern() {
        Pop3FetchPollOperation fetch(self);

        Pop3StatPollOperation stat_op = fetch.getStatOp();
        execPollOperation(stat_op, sprintf("pop3-fetch-stat:%s", connect));

        *Pop3RetrPollOperation retr_op = fetch.createRetrOp();
        if (retr_op) {
            execPollOperation(retr_op, sprintf("pop3-fetch-retr:%s", connect));
        }

        return fetch.getMail();
    }

    private hash<auto> statAsyncIntern() {
        Pop3CommandPollOperation op = commandAsyncIntern("STAT");
        string r = op.getResponseLine();
        my (softint num, softint size) = (r =~ x/\+OK ([0-9]+) ([0-9]+)/);
        logDbg("messages: %d total size: %d bytes", num, size);
        return {
            "num": num,
            "size": size,
        };
    }

    private *hash<auto> listAsyncIntern() {
        hash<auto> mih;
        Pop3CommandPollOperation op = commandAsyncIntern("LIST", True);
        foreach string ml in (op.getDataString().split("\r\n")) {
            if (!ml.val() || ml == ".") {
                continue;
            }
            (string id, softint size) = (ml =~ x/^([0-9]+) ([0-9]+)/);
            mih{id}.size = size;
        }
        return mih.empty() ? NOTHING : mih;
    }

    private Pop3CommandPollOperation commandAsyncIntern(string command, bool multi = False) {
        Pop3CommandPollOperation op(self, command, multi);
        # this pipeline implicitly connects + authenticates, so bound it by connectTimeout
        # (callers only invoke this when the client is not yet connected)
        execPollOperation(op, sprintf("pop3-command:%s:%s", connect, command), connectTimeout);
        return op;
    }

    private Pop3ConnectedCommandPollOperation connectedCommandAsyncIntern(string command, bool multi = False) {
        Pop3ConnectedCommandPollOperation op(sock, command, multi);
        execPollOperation(op, sprintf("pop3-connected-command:%s:%s", connect, command));
        return op;
    }

    private MailMessage::Message getMessageAsyncIntern(softstring id) {
        date start = now_us();
        Pop3CommandPollOperation op = commandAsyncIntern(sprintf("RETR %s", id), True);
        string msg = op.getDataString();
        Message mmsg = new MailMessage::Message(msg);
        int na = mmsg.getAttachments().size();
        log("got msg %s (%d bytes, %d attachment%s) in %y", id, msg.size(), na, na == 1 ? "" : "s",
            now_us() - start);
        return mmsg;
    }

    private *hash<string, bool> capaAsyncIntern() {
        try {
            Pop3CommandPollOperation op = commandAsyncIntern("CAPA", True);
            *string data = op.getData();
            capabilities = {};
            if (!data.val()) {
                return;
            }

            foreach string cap in (data.split("\r\n")) {
                trim cap;
                if (!cap.val() || cap == ".") {
                    continue;
                }
                string capName = (cap =~ x/^(\S+)/)[0];
                if (capName) {
                    capabilities{capName.upr()} = True;
                }
            }
            logDbg("server capabilities: %y", keys capabilities);
            return capabilities;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "POP3-SERVER-ERROR") {
                logDbg("CAPA command not supported by server");
                capabilities = {};
                return;
            }
            rethrow;
        }
    }

    private *hash<string, string> uidlAsyncIntern() {
        try {
            Pop3CommandPollOperation op = commandAsyncIntern("UIDL", True);
            *string data = op.getData();
            if (!data.val()) {
                return;
            }

            hash<string, string> uidls;
            foreach string line in (data.split("\r\n")) {
                trim line;
                if (!line.val() || line == ".") {
                    continue;
                }
                (*string id, *string uid) = (line =~ x/^([0-9]+) (.+)$/);
                if (id && uid) {
                    uidls{id} = uid;
                }
            }
            return uidls;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "POP3-SERVER-ERROR") {
                logDbg("UIDL command not supported by server");
                return;
            }
            rethrow;
        }
    }

    private *string uidlAsyncIntern(softstring msg) {
        try {
            Pop3CommandPollOperation op = commandAsyncIntern(sprintf("UIDL %s", msg));
            string r = op.getResponseLine();
            *string uid = (r =~ x/^\+OK\s+\d+\s+(.+)$/)[0];
            return uid;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "POP3-SERVER-ERROR") {
                logDbg("UIDL command failed for message %s", msg);
                return;
            }
            rethrow;
        }
    }

    private string topAsyncIntern(softstring msg, int lines) {
        Pop3CommandPollOperation op = commandAsyncIntern(sprintf("TOP %s %d", msg, lines), True);
        return op.getDataString();
    }

    private connectAsyncIntern() {
        try {
            Pop3PingPollOperation op(self, sock, False);
            execPollOperation(op, sprintf("pop3-connect:%s", connect), connectTimeout);
        } catch (hash<ExceptionInfo> ex) {
            sock.close();
            rethrow;
        }
    }

    private execPollOperation(Qore::AbstractPollOperation op, string owner, timeout to = ioTimeout) {
        *hash<SocketPollInfo> pi = op.continuePoll();
        if (!pi) {
            if (!op.goalReached()) {
                throw "ASYNC-IO-ERROR", sprintf("%s operation ended before reaching goal: %s", owner, op.getState());
            }
            return;
        }

        hash<SocketPollResultInfo> result = AsyncIoController::exec(operation_info: <SocketPollOperationInfo>{
            "sock": pi.socket,
            "spop": op,
            "owner": owner,
            "to": to,
        });
        if (result.ex) {
            throw result.ex.err, result.ex.desc;
        }
        if (result.canceled) {
            throw "ASYNC-IO-CANCELED", sprintf("%s operation was canceled", owner);
        }
        if (!op.goalReached()) {
            throw "ASYNC-IO-ERROR", sprintf("%s operation ended before reaching goal: %s", owner, op.getState());
        }
    }

    # don't reimplement this method; fix/enhance it in the module
    final private disconnectIntern() {
        if (isConnected()) {
            # send QUIT command if "noquit" is not set and ignore error
            if (!noquit)
                try { connectedCommandAsyncIntern("QUIT"); } catch (hash<ExceptionInfo> ex) { }
            sock.close();
        }
    }

    # don't reimplement this method; fix/enhance it in the module
    final private MailMessage::Message retrIntern(softstring id) {
        date start = now_us();
        Pop3ConnectedCommandPollOperation op = connectedCommandAsyncIntern(sprintf("RETR %s", id), True);
        string msg = op.getDataString();
        Message mmsg = new MailMessage::Message(msg);
        int na = mmsg.getAttachments().size();
        log("got msg %s (%d bytes, %d attachment%s) in %y", id, msg.size(), na, na == 1 ? "" : "s", now_us() - start);
        return mmsg;
    }

    # don't reimplement this method; fix/enhance it in the module
    final private hash statIntern() {
        Pop3ConnectedCommandPollOperation op = connectedCommandAsyncIntern("STAT");
        string r = op.getResponseLine();
        my (softint num, softint size) = (r =~ x/\+OK ([0-9]+) ([0-9]+)/);
        logDbg("messages: %d total size: %d bytes", num, size);
        return {
            "num": num,
            "size": size,
        };
    }

    # don't reimplement this method; fix/enhance it in the module
    final private *hash<auto> listIntern() {
        # message info hash
        hash<auto> mih;
        Pop3ConnectedCommandPollOperation op = connectedCommandAsyncIntern("LIST", True);
        foreach string ml in (op.getDataString().split("\r\n")) {
            if (!ml.val() || ml == ".") {
                continue;
            }
            (string id, softint size) = (ml =~ x/^([0-9]+) ([0-9]+)/);
            mih{id}.size = size;
        }
        #logDbg("messages: %y", mih);
        return mih;
    }

    # don't reimplement this method; fix/enhance it in the module
    # RFC 2449 CAPA command
    final private *hash<string, bool> capaIntern() {
        # return cached capabilities if available
        if (capabilities) {
            return capabilities;
        }

        try {
            Pop3ConnectedCommandPollOperation op = connectedCommandAsyncIntern("CAPA", True);
            # parse capabilities into hash
            capabilities = {};
            foreach string cap in (op.getDataString().split("\r\n")) {
                if (!cap.val() || cap == ".") {
                    continue;
                }
                # capability names are case-insensitive; store uppercase
                string capName = (cap =~ x/^(\S+)/)[0];
                if (capName) {
                    capabilities{capName.upr()} = True;
                }
            }
            logDbg("server capabilities: %y", keys capabilities);
            return capabilities;
        } catch (hash<ExceptionInfo> ex) {
            # CAPA not supported
            if (ex.err == "POP3-SERVER-ERROR") {
                logDbg("CAPA command not supported by server");
                capabilities = {};
                return;
            }
            rethrow;
        }
    }

    # don't reimplement this method; fix/enhance it in the module
    # RFC 1939 UIDL command (optional)
    final private *hash<string, string> uidlIntern() {
        try {
            Pop3ConnectedCommandPollOperation op = connectedCommandAsyncIntern("UIDL", True);
            # parse UIDL responses into hash
            hash<string, string> uidls;
            foreach string ul in (op.getDataString().split("\r\n")) {
                if (!ul.val() || ul == ".") {
                    continue;
                }
                (*string id, *string uid) = (ul =~ x/^([0-9]+) (.+)$/);
                if (id && uid) {
                    uidls{id} = uid;
                }
            }
            return uidls;
        } catch (hash<ExceptionInfo> ex) {
            # UIDL not supported
            if (ex.err == "POP3-SERVER-ERROR") {
                logDbg("UIDL command not supported by server");
                return;
            }
            rethrow;
        }
    }

    # don't reimplement this method; fix/enhance it in the module
    # RFC 1939 UIDL command for single message
    final private *string uidlIntern(softstring msg) {
        try {
            Pop3ConnectedCommandPollOperation op = connectedCommandAsyncIntern(sprintf("UIDL %s", msg));
            string r = op.getResponseLine();
            # parse response: +OK msgnum uniqueid
            *string uid = (r =~ x/^\+OK\s+\d+\s+(.+)$/)[0];
            return uid;
        } catch (hash<ExceptionInfo> ex) {
            # UIDL not supported or message doesn't exist
            if (ex.err == "POP3-SERVER-ERROR") {
                logDbg("UIDL command failed for message %s", msg);
                return;
            }
            rethrow;
        }
    }

    # don't reimplement this method; fix/enhance it in the module
    # RFC 1939 TOP command (optional)
    final private string topIntern(softstring msg, int lines) {
        Pop3ConnectedCommandPollOperation op = connectedCommandAsyncIntern(sprintf("TOP %s %d", msg, lines), True);
        return op.getDataString();
    }

    private log(string msg, ...) {
        if (logger) {
            logArgs(LoggerLevel::INFO, "Pop3Client: " + msg, argv);
        }
    }

    private logError(string msg, ...) {
        if (logger) {
            logArgs(LoggerLevel::ERROR, "Pop3Client: " + msg, argv);
        }
    }

    private logDbg(string msg, ...) {
        if (logger) {
            msg = vsprintf(msg, argv);
            trim msg;
            if (msg.size() > MaxDebugLine) {
                splice msg, MaxDebugLine;
                msg += "...";
            }
            logArgs(LoggerLevel::DEBUG, "%s", "Pop3Client: " + msg);
        }
    }

    private forceDisconnectIntern() {
        if (isConnected()) {
            try {
                disconnectIntern();
            } catch() {
                # ignore
            }
        }
    }
    #! @endcond
}

#! POP3 ping poll operation states
public enum Pop3PingState : string {
    #! Connect state
    Connect = "connect",
    #! Read server greeting state
    ReadGreeting = "read-greeting",
    #! Send STLS command state
    SendStls = "send-stls",
    #! Read STLS response state
    ReadStlsReply = "read-stls-reply",
    #! Upgrade socket connection to TLS state
    UpgradeToTls = "upgrade-tls",
    #! Send USER command state
    SendUser = "send-user",
    #! Read USER response state
    ReadUserReply = "read-user-reply",
    #! Send PASS command state
    SendPass = "send-pass",
    #! Read PASS response state
    ReadPassReply = "read-pass-reply",
    #! Send APOP command state
    SendApop = "send-apop",
    #! Read APOP response state
    ReadApopReply = "read-apop-reply",
    #! Send AUTH XOAUTH2 command state
    SendXoauth2 = "send-xoauth2",
    #! Read AUTH XOAUTH2 response state
    ReadXoauth2Reply = "read-xoauth2-reply",
    #! Send NOOP command state
    SendNoop = "send-noop",
    #! Read NOOP response state
    ReadNoopReply = "read-noop-reply",
    #! Complete state
    Complete = "complete",
}

#! Poll operation for non-blocking POP3 ping operations
/** This class implements a state machine for non-blocking POP3 connection and authentication.

    @since %Pop3Client 2.1
*/
public class Pop3PingPollOperation inherits Qore::PollPipeline {
    #! Creates the object based on the Pop3Client
    /** Builds the complete POP3 ping pipeline from connection configuration.

        The pipeline supports XOAUTH2, APOP, and USER/PASS authentication methods.

        @param pop3 the Pop3Client whose connection info drives the pipeline

        @throw POP3-POLL-ERROR if the POP3 server returns an error response

        @since %Pop3Client 2.2
    */
    constructor(Pop3Client pop3) : PollPipeline(new Socket()) {
        setup(pop3, True);
    }

    #! Creates the object based on the Pop3Client and an existing socket
    /** Builds the complete POP3 authentication pipeline from connection configuration.

        @param pop3 the Pop3Client whose connection info drives the pipeline
        @param sock the socket to connect and leave open after the pipeline completes
        @param send_noop if True, send a NOOP after authentication

        @throw POP3-POLL-ERROR if the POP3 server returns an error response

        @since %Pop3Client 2.2
    */
    constructor(Pop3Client pop3, Socket sock, bool send_noop = True) : PollPipeline(sock) {
        setup(pop3, send_noop);
    }

    private setup(Pop3Client pop3, bool send_noop) {
        hash<auto> info = pop3.getInfo();
        goal = send_noop ? "ping" : "connect";

        bool has_token = info.token.val();
        bool need_stls = !info.ssl && info.tls ? True : False;

        # Pre-compute auth commands
        string xoauth2_cmd = "";
        if (has_token) {
            string login = sprintf("user=%s%sauth=Bearer %s%s%s", info.user, Pop3Client::CtrlA, info.token,
                Pop3Client::CtrlA, Pop3Client::CtrlA).toBase64();
            xoauth2_cmd = sprintf("AUTH XOAUTH2 %s\r\n", login);
        }
        string user_cmd = sprintf("USER %s\r\n", info.user);
        string pass_cmd = sprintf("PASS %s\r\n", info.pass);

        # Pipeline step layout (step indices in comments):
        #   0: setContextBool("need_stls")
        #   1: setContextBool("has_token")
        #   2: setContextBinary("xoauth2_cmd")
        #   3: setContextBinary("user_cmd")
        #   4: setContextBinary("pass_cmd")
        #   5: connect or connectSsl
        #   6: recvUntilBytes("\n")            - read greeting
        #   7: validateResponsePrefix("+OK")   - validate greeting
        #   8: makePop3ApopCommand             - derive APOP command from greeting if available
        #   9: branch(need_stls, 10, 14)       - STLS decision
        #  10: send("STLS\r\n")
        #  11: recvUntilBytes("\n")            - read STLS reply
        #  12: validateResponsePrefix("+OK")   - validate STLS reply
        #  13: sslUpgrade()
        #  14: branch(has_token, 15, 19)       - XOAUTH2 decision
        #  15: sendFromContext("xoauth2_cmd")
        #  16: recvUntilBytes("\n")            - read XOAUTH2 reply
        #  17: validateResponsePrefix("+OK")   - validate XOAUTH2 reply
        #  18: goto(30)                        - skip remaining auth methods
        #  19: branch(has_apop, 20, 24)        - APOP decision
        #  20: sendFromContext("apop_cmd")
        #  21: recvUntilBytes("\n")            - read APOP reply
        #  22: validateResponsePrefix("+OK")   - validate APOP reply
        #  23: goto(30)                        - skip USER/PASS
        #  24: sendFromContext("user_cmd")
        #  25: recvUntilBytes("\n")            - read USER reply
        #  26: validateResponsePrefix("+OK")   - validate USER reply
        #  27: sendFromContext("pass_cmd")
        #  28: recvUntilBytes("\n")            - read PASS reply
        #  29: validateResponsePrefix("+OK")   - validate PASS reply
        #  30: optional send("NOOP\r\n")
        #  31: optional recvUntilBytes("\n")   - read NOOP reply
        #  32: optional validateResponsePrefix("+OK")
        #  33: (past end -> pipeline complete)

        # --- Steps 0-4: configuration transforms ---
        addSetContextBool("need_stls", need_stls);                  # 0
        addSetContextBool("has_token", has_token);                  # 1
        addSetContextBinary("xoauth2_cmd", xoauth2_cmd);           # 2
        addSetContextBinary("user_cmd", user_cmd);                  # 3
        addSetContextBinary("pass_cmd", pass_cmd);                  # 4

        # --- Step 5: connect ---
        if (info.ssl) {
            addConnectSsl(info.target);                             # 5
        } else {
            addConnect(info.target);                                # 5
        }

        # --- Steps 6-7: read and validate server greeting ---
        addRecvUntilBytes("\n");                                    # 6
        addValidateResponsePrefix("+OK", "POP3-POLL-ERROR");       # 7
        addMakePop3ApopCommand("apop_cmd", "has_apop", info.user, info.pass); # 8

        # --- Step 9: branch on STLS decision ---
        addBranchOnContextKey("need_stls", 10, 14);                # 9

        # --- Steps 10-13: STARTTLS handshake ---
        addSend("STLS\r\n");                                       # 10
        addRecvUntilBytes("\n");                                    # 11
        addValidateResponsePrefix("+OK", "POP3-POLL-ERROR");       # 12
        addSslUpgrade();                                           # 13

        # --- Step 14: branch on auth method ---
        addBranchOnContextKey("has_token", 15, 19);                # 14

        # --- Steps 15-18: XOAUTH2 auth path ---
        addSendFromContext("xoauth2_cmd");                         # 15
        addRecvUntilBytes("\n");                                    # 16
        addValidateResponsePrefix("+OK", "POP3-POLL-ERROR");       # 17
        addGoto(30);                                               # 18

        # --- Steps 19-23: APOP auth path ---
        addBranchOnContextKey("has_apop", 20, 24);                 # 19
        addSendFromContext("apop_cmd");                            # 20
        addRecvUntilBytes("\n");                                    # 21
        addValidateResponsePrefix("+OK", "POP3-POLL-ERROR");       # 22
        addGoto(30);                                               # 23

        # --- Steps 24-29: USER/PASS auth path ---
        addSendFromContext("user_cmd");                            # 24
        addRecvUntilBytes("\n");                                    # 25
        addValidateResponsePrefix("+OK", "POP3-POLL-ERROR");       # 26
        addSendFromContext("pass_cmd");                            # 27
        addRecvUntilBytes("\n");                                    # 28
        addValidateResponsePrefix("+OK", "POP3-POLL-ERROR");       # 29

        if (send_noop) {
            # --- Steps 30-32: NOOP ping ---
            addSend("NOOP\r\n");                                   # 30
            addRecvUntilBytes("\n");                                # 31
            addValidateResponsePrefix("+OK", "POP3-POLL-ERROR");   # 32
        }

        # --- Step 30 or 33 (past end): pipeline completes automatically ---
    }

    #! Returns the goal
    /** @return the configured goal, either \c "ping" or \c "connect"
    */
    string getGoal() {
        return goal;
    }

    #! Returns the current state mapped to Pop3PingState values for backward compatibility
    /** @return the current state string
    */
    string getState() {
        if (goalReached()) {
            return Pop3PingState::Complete;
        }
        if (isClosed()) {
            return "error";
        }
        return PollPipeline::getState();
    }
}

#! POP3 command poll operation - connects, authenticates, runs one command, and quits
/** Generic one-shot POP3 command pipeline used by blocking Pop3Client methods
    when the client does not already have an open stateful session.

    @since Pop3Client 2.2
*/
public class Pop3CommandPollOperation inherits Qore::PollPipeline {
    private {
        #! Internal queue receiving the command response line
        int response_queue_id;
        #! Internal queue receiving an optional dot-terminated response body
        int data_queue_id;
        #! True if this command has a dot-terminated response body
        bool multi_response;
    }

    #! Creates a one-shot POP3 command operation
    /** @param pop3 the Pop3Client whose connection info drives the pipeline
        @param command command text without trailing CRLF
        @param multi if True, read a dot-terminated response body after the +OK line

        @throw POP3-SERVER-ERROR if the POP3 server returns an error response
    */
    constructor(Pop3Client pop3, string command, bool multi = False) : PollPipeline(new Socket()) {
        hash<auto> info = pop3.getInfo();
        goal = "command";
        multi_response = multi;
        response_queue_id = addQueue();
        if (multi_response) {
            data_queue_id = addQueue();
        }

        bool has_token = info.token.val();
        bool need_stls = !info.ssl && info.tls ? True : False;

        string xoauth2_cmd = "";
        if (has_token) {
            string login = sprintf("user=%s%sauth=Bearer %s%s%s", info.user, Pop3Client::CtrlA, info.token,
                Pop3Client::CtrlA, Pop3Client::CtrlA).toBase64();
            xoauth2_cmd = sprintf("AUTH XOAUTH2 %s\r\n", login);
        }
        string user_cmd = sprintf("USER %s\r\n", info.user);
        string pass_cmd = sprintf("PASS %s\r\n", info.pass);

        addSetContextBool("need_stls", need_stls);
        addSetContextBool("has_token", has_token);
        addSetContextBinary("xoauth2_cmd", xoauth2_cmd);
        addSetContextBinary("user_cmd", user_cmd);
        addSetContextBinary("pass_cmd", pass_cmd);

        if (info.ssl) {
            addConnectSsl(info.target);
        } else {
            addConnect(info.target);
        }

        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");
        addMakePop3ApopCommand("apop_cmd", "has_apop", info.user, info.pass);

        addBranchOnContextKey("need_stls", 10, 14);

        addSend("STLS\r\n");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");
        addSslUpgrade();

        addBranchOnContextKey("has_token", 15, 19);

        addSendFromContext("xoauth2_cmd");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");
        addGoto(30);

        addBranchOnContextKey("has_apop", 20, 24);
        addSendFromContext("apop_cmd");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");
        addGoto(30);

        addSendFromContext("user_cmd");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");
        addSendFromContext("pass_cmd");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");

        addSend(command + "\r\n");
        addRecvUntilBytes("\n");
        addPushQueue(response_queue_id);
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");

        if (multi_response) {
            addRecvUntilBytes(".\r\n");
            addPushQueue(data_queue_id);
        }

        addSend("QUIT\r\n");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");
    }

    #! Returns the goal
    /** @return \c "command"
    */
    string getGoal() {
        return "command";
    }

    #! Returns the current pipeline state
    /** @return the current pipeline state
    */
    string getState() {
        if (goalReached()) {
            return "complete";
        }
        if (isClosed()) {
            return "error";
        }
        return PollPipeline::getState();
    }

    #! Returns the single-line command response
    /** @return the trimmed single-line command response
    */
    string getResponseLine() {
        *string r = getQueueItem(response_queue_id);
        if (!r.val()) {
            return "";
        }
        trim r;
        return r;
    }

    #! Returns the dot-terminated response body without the terminator
    /** @return the dot-terminated response body without the terminator, or @ref NOTHING if there is no body
    */
    *string getData() {
        if (!multi_response) {
            return;
        }

        *string body = getQueueItem(data_queue_id);
        if (!body.val()) {
            return;
        }
        if (body =~ /\.\r\n$/) {
            body = extract body, 0, body.size() - 3;
        }
        return body;
    }

    #! Returns the dot-terminated response body as a non-optional string
    /** @return the dot-terminated response body without the terminator, or an empty string if there is no body
    */
    string getDataString() {
        return getData() ?? "";
    }
}

#! POP3 connected command poll operation - runs one command on an existing authenticated socket
/** Generic connected POP3 command pipeline used by blocking Pop3Client methods
    when the client already has an open stateful session.

    @since Pop3Client 2.2
*/
public class Pop3ConnectedCommandPollOperation inherits Qore::PollPipeline {
    private {
        #! Internal queue receiving the command response line
        int response_queue_id;
        #! Internal queue receiving an optional dot-terminated response body
        int data_queue_id;
        #! True if this command has a dot-terminated response body
        bool multi_response;
    }

    #! Creates a connected POP3 command operation
    /** @param sock the connected and authenticated POP3 socket
        @param command command text without trailing CRLF
        @param multi if True, read a dot-terminated response body after the +OK line

        @throw POP3-SERVER-ERROR if the POP3 server returns an error response
    */
    constructor(Socket sock, string command, bool multi = False) : PollPipeline(sock) {
        goal = "connected-command";
        multi_response = multi;
        response_queue_id = addQueue();
        if (multi_response) {
            data_queue_id = addQueue();
        }

        addSend(command + "\r\n");
        addRecvUntilBytes("\n");
        addPushQueue(response_queue_id);
        addValidateResponsePrefix("+OK", "POP3-SERVER-ERROR");

        if (multi_response) {
            addRecvUntilBytes(".\r\n");
            addPushQueue(data_queue_id);
        }
    }

    #! Returns the goal
    /** @return \c "connected-command"
    */
    string getGoal() {
        return "connected-command";
    }

    #! Returns the current pipeline state
    /** @return the current pipeline state
    */
    string getState() {
        if (goalReached()) {
            return "complete";
        }
        if (isClosed()) {
            return "error";
        }
        return PollPipeline::getState();
    }

    #! Returns the single-line command response
    /** @return the trimmed single-line command response
    */
    string getResponseLine() {
        *string r = getQueueItem(response_queue_id);
        if (!r.val()) {
            return "";
        }
        trim r;
        return r;
    }

    #! Returns the dot-terminated response body without the terminator
    /** @return the dot-terminated response body without the terminator, or @ref NOTHING if there is no body
    */
    *string getData() {
        if (!multi_response) {
            return;
        }

        *string body = getQueueItem(data_queue_id);
        if (!body.val()) {
            return;
        }
        if (body =~ /\.\r\n$/) {
            body = extract body, 0, body.size() - 3;
        }
        return body;
    }

    #! Returns the dot-terminated response body as a non-optional string
    /** @return the dot-terminated response body without the terminator, or an empty string if there is no body
    */
    string getDataString() {
        return getData() ?? "";
    }
}

#! POP3 stat poll operation - connects, authenticates, and runs STAT + LIST
/** Builds on the same connect + auth sequence as @ref Pop3PingPollOperation,
    but replaces the NOOP ping with STAT + LIST to retrieve the mailbox
    message list.

    After completion, call @ref getStat() for the message count and
    @ref getList() for the per-message size hash. The socket remains
    connected for subsequent RETR operations.

    @since Pop3Client 2.2
*/
public class Pop3StatPollOperation inherits Qore::PollPipeline {
    private {
        #! Reference to the socket for hand-off to RETR pipeline
        Socket my_sock;
        #! Internal queue receiving the STAT response line
        int stat_queue_id;
        #! Internal queue receiving the LIST response body
        int list_queue_id;
        #! Parsed message info keyed by message ID
        hash<auto> message_info;
        #! Parsed STAT info
        hash<auto> stat_info;
    }

    #! Creates the stat pipeline
    /** @param pop3 the Pop3Client whose connection info drives the pipeline
    */
    constructor(Pop3Client pop3) : PollPipeline(my_sock = Pop3StatPollOperation::makeSocket()) {
        hash<auto> info = pop3.getInfo();
        goal = "stat";
        stat_queue_id = addQueue();
        list_queue_id = addQueue();

        bool has_token = info.token.val();
        bool need_stls = !info.ssl && info.tls ? True : False;

        # Pre-compute auth commands
        string xoauth2_cmd = "";
        if (has_token) {
            string login = sprintf("user=%s%sauth=Bearer %s%s%s", info.user, Pop3Client::CtrlA, info.token,
                Pop3Client::CtrlA, Pop3Client::CtrlA).toBase64();
            xoauth2_cmd = sprintf("AUTH XOAUTH2 %s\r\n", login);
        }
        string user_cmd = sprintf("USER %s\r\n", info.user);
        string pass_cmd = sprintf("PASS %s\r\n", info.pass);

        # --- Steps 0-4: configuration transforms ---
        addSetContextBool("need_stls", need_stls);
        addSetContextBool("has_token", has_token);
        addSetContextBinary("xoauth2_cmd", xoauth2_cmd);
        addSetContextBinary("user_cmd", user_cmd);
        addSetContextBinary("pass_cmd", pass_cmd);

        # --- Step 5: connect ---
        if (info.ssl) {
            addConnectSsl(info.target);
        } else {
            addConnect(info.target);
        }

        # --- Steps 6-7: read and validate server greeting ---
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");
        addMakePop3ApopCommand("apop_cmd", "has_apop", info.user, info.pass);

        # --- Step 9: branch on STLS decision ---
        addBranchOnContextKey("need_stls", 10, 14);

        # --- Steps 10-13: STARTTLS handshake ---
        addSend("STLS\r\n");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");
        addSslUpgrade();

        # --- Step 14: branch on auth method ---
        addBranchOnContextKey("has_token", 15, 19);

        # --- Steps 15-18: XOAUTH2 auth path ---
        addSendFromContext("xoauth2_cmd");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");
        addGoto(30);

        # --- Steps 19-23: APOP auth path ---
        addBranchOnContextKey("has_apop", 20, 24);
        addSendFromContext("apop_cmd");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");
        addGoto(30);

        # --- Steps 24-29: USER/PASS auth path ---
        addSendFromContext("user_cmd");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");
        addSendFromContext("pass_cmd");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");

        # --- Steps 30-32: STAT command ---
        addSend("STAT\r\n");                                       # 30
        addRecvUntilBytes("\n");                                    # 31
        addPushQueue(stat_queue_id);
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");      # 32

        # --- Steps 33-36: LIST command (dot-terminated multi-line response) ---
        addSend("LIST\r\n");                                       # 33
        addRecvUntilBytes("\n");                                    # 34 - +OK response line
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");      # 35
        # Dot-terminator: ".\r\n" on its own line. After +OK line consumed,
        # next data starts at column 0 - safe to match ".\r\n" directly.
        addRecvUntilBytes(".\r\n");                                # 36 - dot-terminated body
        addPushQueue(list_queue_id);
        # Step 38 (past end): pipeline complete
    }

    #! Returns the socket for hand-off to a RETR pipeline
    Socket getSocket() {
        return my_sock;
    }

    #! Helper to create a Socket for use in the constructor parent call
    private static Socket makeSocket() {
        return new Socket();
    }

    #! Returns the goal
    string getGoal() {
        return "stat";
    }

    string getState() {
        if (goalReached()) {
            return "complete";
        }
        if (isClosed()) {
            return "error";
        }
        return PollPipeline::getState();
    }

    #! Returns STAT command data in Pop3Client::stat() format
    hash<auto> getStat() {
        if (!stat_info.empty()) {
            return stat_info;
        }

        *string r = getQueueItem(stat_queue_id);
        if (!r.val()) {
            return {};
        }
        trim r;
        my (softint num, softint size) = (r =~ x/\+OK ([0-9]+) ([0-9]+)/);
        return stat_info = {
            "num": num,
            "size": size,
        };
    }

    #! Returns LIST command data in Pop3Client::list() format
    *hash<auto> getList() {
        if (!message_info.empty()) {
            return message_info;
        }

        *string list_text = getQueueItem(list_queue_id);
        if (!list_text.val()) {
            return;
        }

        foreach string line in (list_text.split("\r\n")) {
            trim line;
            if (!line.val() || line == ".") {
                continue;
            }
            (*string id, softint size) = (line =~ x/^([0-9]+)\s+([0-9]+)/);
            if (id.val()) {
                message_info{id}.size = size;
            }
        }
        return message_info.empty() ? NOTHING : message_info;
    }
}

#! POP3 retrieve poll operation - fetches messages on an already-connected socket
/** Takes an already-connected and authenticated POP3 socket (from
    @ref Pop3StatPollOperation) and a list of message IDs, then statically
    unrolls RETR + optional DELE commands per message, followed by QUIT.

    @since Pop3Client 2.2
*/
public class Pop3RetrPollOperation inherits Qore::PollPipeline {
    private {
        #! Fetched message bodies keyed by message ID
        hash<string, string> messages = {};
        #! Current message index (for tracking during pipeline execution)
        list<string> msg_ids;
        #! Internal queue receiving message bodies as they are read
        int body_queue_id;
    }

    #! Creates the retrieve pipeline
    /** @param sock already-connected POP3 socket
        @param msg_ids list of message IDs to fetch (from LIST output)
        @param delete_after_fetch if True, send DELE after each RETR
    */
    constructor(Socket sock, list<string> ids, bool do_delete = False)
            : PollPipeline(sock) {
        msg_ids = ids;
        goal = "retr";
        body_queue_id = addQueue();

        # Statically unroll RETR per message
        foreach string id in (ids) {
            # RETR command
            addSend(sprintf("RETR %s\r\n", id));
            # Read +OK response line
            addRecvUntilBytes("\n");
            addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");
            # Read dot-terminated message body (".\r\n" on its own line)
            addRecvUntilBytes(".\r\n");
            addPushQueue(body_queue_id);

            if (do_delete) {
                addSend(sprintf("DELE %s\r\n", id));
                addRecvUntilBytes("\n");
                addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");
            }
        }

        # QUIT
        addSend("QUIT\r\n");
        addRecvUntilBytes("\n");
        addValidateResponsePrefix("+OK", "POP3-FETCH-ERROR");
    }

    #! Returns the goal
    string getGoal() {
        return "retr";
    }

    string getState() {
        if (goalReached()) {
            return "complete";
        }
        if (isClosed()) {
            return "error";
        }
        return PollPipeline::getState();
    }

    #! Returns fetched raw message bodies keyed by message ID
    hash<string, string> getMessages() {
        if (!messages.empty()) {
            return messages;
        }

        foreach string id in (msg_ids) {
            *string body = getQueueItem(body_queue_id);
            if (!body.val()) {
                continue;
            }
            if (body =~ /\.\r\n$/) {
                body = extract body, 0, body.size() - 3;
            }
            messages{id} = body;
        }
        return messages;
    }
}

#! POP3 fetch orchestrator - two-phase: STAT+LIST then RETR per message
/** Composes @ref Pop3StatPollOperation and @ref Pop3RetrPollOperation.
    Phase 1 runs the stat op (connect+auth+STAT+LIST). The caller submits it
    to the AsyncIoController. When it completes, call @ref createRetrOp() to
    build the RETR pipeline for the discovered messages, then submit that.

    This follows the same pattern as @ref FtpClientPollOperation - the
    orchestrator manages sub-operations but does not inherit
    @c AbstractPollOperation itself.

    @since Pop3Client 2.2
*/
public class Pop3FetchPollOperation {
    private {
        Pop3Client pop3;
        bool delete_after_fetch;
        Pop3StatPollOperation stat_op;
        *Pop3RetrPollOperation retr_op;
        #! Parsed message IDs from LIST
        list<string> msg_ids = ();
        #! Parsed message info keyed by message ID
        hash<auto> message_info;
    }

    #! Creates the fetch orchestrator
    /** @param pop3 the Pop3Client whose connection info drives the pipeline
        @param delete_after_fetch if True, delete messages after fetching
    */
    constructor(Pop3Client client, bool do_delete = False) {
        pop3 = client;
        delete_after_fetch = do_delete;
        stat_op = new Pop3StatPollOperation(client);
    }

    #! Returns the stat poll operation for submission to the controller
    Pop3StatPollOperation getStatOp() {
        return stat_op;
    }

    #! Creates the RETR poll operation after the stat phase completes
    /** Call this after the stat op has reached its goal. Parses the LIST
        output and builds the RETR pipeline on the already-connected socket.

        @return the RETR poll operation, or NOTHING if the mailbox is empty
    */
    *Pop3RetrPollOperation createRetrOp() {
        # Parse LIST output to get message IDs
        parseListOutput(stat_op.getList());

        if (!msg_ids) {
            return NOTHING;
        }

        retr_op = new Pop3RetrPollOperation(
            stat_op.getSocket(), msg_ids, delete_after_fetch);
        return retr_op;
    }

    #! Returns the fetched message IDs (available after stat phase)
    list<string> getMessageIds() {
        return msg_ids;
    }

    #! Returns the number of messages in the mailbox
    int getMessageCount() {
        return msg_ids.size();
    }

    #! Returns fetched messages in Pop3Client::getMail() format
    *hash<auto> getMail() {
        if (message_info.empty()) {
            return;
        }

        if (retr_op) {
            hash<string, string> messages = retr_op.getMessages();
            foreach string id in (keys message_info) {
                if (messages.hasKey(id)) {
                    message_info{id}.msg = new MailMessage::Message(messages{id});
                }
            }
        }
        return message_info;
    }

    #! Returns True when all phases are complete
    bool goalReached() {
        if (!retr_op) {
            # If no retr op yet, check if stat is done with empty mailbox
            return stat_op.goalReached() && !msg_ids;
        }
        return retr_op.goalReached();
    }

    #! Returns the current state
    string getState() {
        if (goalReached()) {
            return "complete";
        }
        if (!retr_op) {
            return "stat:" + stat_op.getState();
        }
        return "retr:" + retr_op.getState();
    }

    #! Abort the current sub-operation
    abort() {
        if (retr_op) {
            retr_op.abort();
        } else {
            stat_op.abort();
        }
    }

    #! Parse LIST output into message IDs
    private parseListOutput(*hash<auto> list_info) {
        if (!list_info) {
            return;
        }
        foreach string id in (keys list_info) {
            msg_ids += id;
            message_info{id}.size = list_info{id}.size;
        }
    }
}

#! class for POP3 connections; returns an object of class @ref Pop3Client for receiving or polling for emails
/** supports the following runtime options in getImpl() for connection logging:
    - \c "log": a closure accepting a single string for logging
    - \c "dbglog": a closure taking a single string for detailed technical connection logging

    @since %Pop3Client 1.5
*/
public class Pop3Connection inherits ConnectionProvider::AbstractConnectionWithInfo {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "POP3 Connection",
            "short_desc": "A connection to a POP3 server",
            "desc": "A connection to a POP3 server for receiving emails",
            "cls": Class::forName("Pop3Connection"),
            "schemes": {
                "pop3s": True,
                "pop3": True,
            },
            "options": {
                "connect_timeout": <ConnectionOptionInfo>{
                    "display_name": "Connect Timeout",
                    "short_desc": "The connect timeout in milliseconds",
                    "type": "int",
                    "desc": "The connect timeout in milliseconds",
                    "default_value": Pop3Client::DefaultConnectTimeout.durationMilliseconds(),
                },
                "io_timeout": <ConnectionOptionInfo>{
                    "display_name": "I/O Timeout",
                    "short_desc": "The I/O timeout in milliseconds",
                    "type": "int",
                    "desc": "The I/O timeout in milliseconds",
                    "default_value": Pop3Client::DefaultIoTimeout.durationMilliseconds(),
                },
                "password": <ConnectionOptionInfo>{
                    "display_name": "Password",
                    "short_desc": "The password for authentication",
                    "type": "string",
                    "desc": "The password for authentication; conflicts with the `token` option",
                    "sensitive": True,
                },
                "tls": <ConnectionOptionInfo>{
                    "display_name": "Secure?",
                    "short_desc": "Use the STLS command after connecting with insecure connections",
                    "type": "bool",
                    "desc": "Use the `STLS` command after connecting with insecure connections",
                    "sensitive": True,
                },
                "token": <ConnectionOptionInfo>{
                    "display_name": "Authorization Token",
                    "short_desc": "Set an authorization token for an SASL XOAUTH2 login",
                    "type": "string",
                    "desc": "Any authorization token to use for the connection; will be used for SASL XOAUTH2 "
                        "logins; conflicts with the `password` option",
                    "sensitive": True,
                },
                "username": <ConnectionOptionInfo>{
                    "display_name": "Username",
                    "short_desc": "Sets the username for authentication",
                    "type": "string",
                    "desc": "The username for authentication; always required",
                },
            },
        };
    }

    #! creates the Pop3Connection connection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url, hash attributes = {}, hash options = {})
            : AbstractConnectionWithInfo(name, description, url, attributes, options) {
    }

    #! creates the Pop3Connection connection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : AbstractConnectionWithInfo(config, attr) {
    }

    #! returns \c "pop3"
    string getType() {
        return "pop3";
    }

    #! returns @ref True, since this connection type supports the %Qore @ref Qore::Socket "Socket-based" polling API
    /** @return @ref True

        @since %Pop3Client 2.1
    */
    bool supportsPollingApi() {
        return True;
    }

    #! Called to start a non-blocking polling ping operation on the remote POP3 server
    /** @param logger an optional logger for the polling operation

        @return a socket poll operation object that will allow the connection goal to be reached with polling

        @see supportsPollingApi()

        @since %Pop3Client 2.1
    */
    Qore::AbstractPollOperation startPollConnect(*Logger::LoggerInterface logger) {
        return new Pop3PingPollOperation(getImpl(False));
    }

    #! Starts a non-blocking fetch operation to retrieve all messages
    /** Connects, authenticates, runs STAT+LIST, then RETR for each message.
        Uses the two-phase @ref Pop3FetchPollOperation orchestrator.

        @param do_delete if True, delete messages after fetching (DELE)
        @return a fetch orchestrator; submit getStatOp() first, then createRetrOp()

        @since Pop3Client 2.2
    */
    Pop3FetchPollOperation startPollFetch(bool do_delete = False) {
        return new Pop3FetchPollOperation(getImpl(False), do_delete);
    }

    #! Performs a blocking ping operation on the POP3 server
    /** This method connects to the server (if not already connected), authenticates, and sends a NOOP command
        to verify the connection is working.

        @since %Pop3Client 2.1
    */
    private pingImpl() {
        Pop3PingPollOperation op(getImpl(False));
        execPollOperation(op, sprintf("pop3-ping:%s", name));
    }

    #! returns a @ref Pop3Client object
    /** @param connect if @ref True "True", then \c Pop3Client::Pop3Client::connect() is called
        @param rtopts runtime options for the connection

        @return a @ref Pop3Client object
    */
    private Pop3Client getImpl(bool connect = True, *hash<auto> rtopts) {
        Pop3Client sc(url, opts + {"logger": logger});
        if (connect) {
            sc.connect();
        }
        return sc;
    }

    #! Execute a polling operation synchronously through the global AsyncIoController
    private static execPollOperation(Qore::AbstractPollOperation op, string owner, timeout to = 30s) {
        *hash<SocketPollInfo> pi = op.continuePoll();
        if (!pi) {
            if (!op.goalReached()) {
                throw "ASYNC-IO-ERROR", sprintf("%s operation ended before reaching goal: %s", owner, op.getState());
            }
            return;
        }

        hash<SocketPollResultInfo> result = AsyncIoController::exec(operation_info: <SocketPollOperationInfo>{
            "sock": pi.socket,
            "spop": op,
            "owner": owner,
            "to": to,
        });
        if (result.ex) {
            throw result.ex.err, result.ex.desc;
        }
        if (result.canceled) {
            throw "ASYNC-IO-CANCELED", sprintf("%s operation was canceled", owner);
        }
        if (!op.goalReached()) {
            throw "ASYNC-IO-ERROR", sprintf("%s operation ended before reaching goal: %s", owner, op.getState());
        }
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}
}
