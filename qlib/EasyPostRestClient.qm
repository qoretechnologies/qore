# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module EasyPostRestClient {
    version = "1.0";
    desc = "User module for calling EasyPost REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("easypostrest", EasyPostRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("easypostrests", EasyPostRestConnection::ConnectionScheme);
    };
    # the module registers process-wide functionality in its initialization (connection schemes, LLM provider factories)
    domains = "PROCESS";
}

/** @mainpage EasyPostRestClient Module

    @tableofcontents

    @section easypostrestclientintro EasyPostRestClient Introduction

    The %EasyPostRestClient module provides an API for calling EasyPost's REST API services.

    To use this module, use \c "%requires EasyPostRestClient" in your code.

    All the public symbols in the module are defined in the EasyPostRestClient namespace.

    The main classes are:
    - @ref EasyPostRestClient::EasyPostRestClient "EasyPostRestClient":
      this class provides the REST client API for communication with the EasyPost API;
      it handles authentication via HTTP Basic Auth using a single API key
    - @ref EasyPostRestClient::EasyPostRestClientIo "EasyPostRestClientIo":
      async/non-blocking I/O variant of the REST client
    - @ref EasyPostRestClient::EasyPostRestConnection "EasyPostRestConnection":
      provides a connection object to EasyPost services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires EasyPostRestClient

EasyPostRestClient easypost({"apikey": ENV.EASYPOST_API_KEY});
hash<auto> result = easypost.get("/addresses?page_size=1");
printf("Addresses: %Y\n", result.body);
    @endcode

    @section easypostrestclientrelnotes Release Notes

    @subsection easypostrestclientv1_0 EasyPostRestClient v1.0
    - initial release
*/

#! the EasyPostRestClient namespace contains all the objects in the EasyPostRestClient module
public namespace EasyPostRestClient {

#! Common base class for EasyPostRestClient functionality
public class EasyPostRestClientBase {
    public {
        #! EasyPost API base URL (includes API version path)
        const DefaultApiUrl = "https://api.easypost.com/v2";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default EasyPost ping method
        const DefaultPingMethod = "GET";

        #! Default EasyPost ping path (no leading slash; appended to base path)
        const DefaultPingPath = "addresses?page_size=1";

        #! Default EasyPost ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! returns options for @ref EasyPostRestClient::EasyPostRestClient::constructor()
    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;

        # the EasyPost API, unless another URL is given, for example of a local server in a test
        rv.url = opts.url ?? DefaultApiUrl;

        # Validate apikey is provided
        if (!opts.apikey) {
            throw "EASYPOST-ERROR", "missing required option 'apikey' (EasyPost API key)";
        }

        # Set HTTP Basic Auth via header: API key as username with empty password.
        # NOTE: do NOT set rv.username / rv.password here; doing so causes RestClient to inject
        # an empty colon-only Basic header alongside the correct one.
        rv.headers = (rv.headers ?? {}) + {
            "Authorization": "Basic " + make_base64_string(opts.apikey + ":"),
        };

        # Remove custom options so RestClient doesn't try to use them
        remove rv.apikey;

        return rv;
    }
}

#! This class provides the REST client API for communication with EasyPost servers
/** EasyPost uses a REST API with HTTP Basic Auth authentication using a single API key.

    Authentication is done via HTTP Basic Auth where:
    - Username = API Key
    - Password = (empty)

    @par API Information:
    - Base URL: https://api.easypost.com/v2
    - Test API keys are prefixed \c EZTK... and only return mocked label/tracker data
    - Production API keys are prefixed \c EZAK... and bill the wallet for real shipments

    @par Rate Limit Handling:
    A rate-limited request (HTTP 429 Too Many Requests) is not retried: its error is raised as for any other error
    status.
*/
public class EasyPostRestClient inherits RestClient::RestClient, EasyPostRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
EasyPostRestClient easypost({"apikey": "EZAK..."});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c apikey: the EasyPost API key (required)

        The \c url option gives the URL of the API; the default is the EasyPost API
        (@ref EasyPostRestClient::EasyPostRestClientBase::DefaultApiUrl "DefaultApiUrl")

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw EASYPOST-ERROR missing required option 'apikey'
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(EasyPostRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for EasyPost REST connections; returns @ref EasyPostRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"; in addition,
    this class provides the following options:
    - \c apikey: the EasyPost API key (used as username for Basic Auth, with empty password)

    @see @ref EasyPostRestClient::EasyPostRestClient::constructor() for more information on the above options
*/
public class EasyPostRestConnection inherits RestClient::RestConnection {
    public {
        #! Default EasyPost API URL (with API version)
        const DefaultConnectionUrl = "easypostrests://api.easypost.com/v2";

        #! Connection entry info
        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation("EasyPostRestClient",
            "EasyPostRestConnection", "en", <ConnectionSchemeInfo>{
            "display_name": "EasyPost REST Connection",
            "short_desc": "A connection to the EasyPost REST API",
            "desc": "A connection to the EasyPost REST API for shipping label generation, tracking, "
                "address verification, rate shopping, and multi-carrier fulfillment.\n\n"
                "EasyPost provides a unified API across 100+ carriers (USPS, UPS, FedEx, DHL, and more).\n\n"
                "**Authentication:** A single API key is used as the HTTP Basic Auth username (with an "
                "empty password).\n\n"
                "**Test vs. production keys:**\n"
                "- Test keys (prefixed `EZTK...`) only return mocked label/tracker data and are free\n"
                "- Production keys (prefixed `EZAK...`) bill the EasyPost wallet for real shipments",
            "cls": Class::forName("EasyPostRestConnection"),
            "auto_url": True,
            "schemes": {
                "easypostrest": True,
                "easypostrests": True,
            },
            "base_scheme_map": {
                "https": "easypostrests",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": connection_option_override(RestConnection::ConnectionScheme.options."data", {
                    "default_value": EasyPostRestClientBase::DefaultData,
                }),
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "EasyPost API key for HTTP Basic Auth",
                    "type": "string",
                    "desc": "Your EasyPost API key. Test keys are prefixed `EZTK...` and only return mocked "
                        "label/tracker data; production keys are prefixed `EZAK...` and bill the wallet for "
                        "real shipments. Obtain a key at https://www.easypost.com/account/api-keys.",
                    "sensitive": True,
                    "preselected": True,
                },
                "ping_headers": connection_option_override(RestConnection::ConnectionScheme.options."ping_headers", {
                    "default_value": EasyPostRestClientBase::DefaultPingHeaders,
                }),
                "ping_method": connection_option_override(RestConnection::ConnectionScheme.options."ping_method", {
                    "default_value": EasyPostRestClientBase::DefaultPingMethod,
                }),
                "ping_path": connection_option_override(RestConnection::ConnectionScheme.options."ping_path", {
                    "default_value": EasyPostRestClientBase::DefaultPingPath,
                }),
            },
            "required_options": "apikey",
            "messages": (
                <UiMessageInfo>{
                    "presentation_id": "setup-1",
                    "title": "How to Obtain Your EasyPost API Key",
                    "intent": "info",
                    "content": "1. Log in to your EasyPost account at https://www.easypost.com/account/api-keys\n"
                        "2. You will see two sets of keys:\n"
                        "   - **Test keys** (prefixed `EZTK...`): free, return mocked label/tracker data; "
                        "use these for development and integration testing\n"
                        "   - **Production keys** (prefixed `EZAK...`): bill the EasyPost wallet for real "
                        "shipments; use these only when you are ready to ship live\n"
                        "3. Copy the appropriate key for your environment\n\n"
                        "**Important:**\n"
                        "- Production keys incur real charges; treat them as secrets\n"
                        "- Test keys cannot purchase real labels or generate real tracking numbers\n"
                        "- The API key is used as the HTTP Basic Auth username with an empty password",
                },
            ),
        });
    }

    #! creates the EasyPostRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the EasyPostRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(EasyPostRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref EasyPostRestConnection::constructor()
    /** Constructs the connection URL (EasyPost has only one API endpoint)
    */
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": DefaultConnectionUrl,
        };
    }

    #! returns \c "easypostrest"
    string getType() {
        return "easypostrest";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the @ref getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        return "EasyPost";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the EasyPostDataProvider and creates the data provider
        # object dynamically
        load_module("EasyPostDataProvider");
        return create_object("EasyPostDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    /** The closure or call reference must have the following signature:
        <tt>update_options(hash<auto> options)</tt>
    */
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        # update the URL immediately if necessary
        if (update_options && url != DefaultConnectionUrl) {
            # NOTE: do not update the URL or real URL values here, or the external update will fail, because it will
            # believe that no changes are necessary
            doUpdateOptions(self, {
                "url": DefaultConnectionUrl,
            });
        }
    }

    #! returns a @ref EasyPostRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref EasyPostRestClient object
    */
    private EasyPostRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new EasyPostRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since EasyPostRestClient 1.0
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new EasyPostRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! EasyPost REST client for non-blocking I/O
public class EasyPostRestClientIo inherits RestClientIo::RestClientIo, EasyPostRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(EasyPostRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
