%requires qore >= 2.0
%modern

%requires(reexport) ConnectionProvider
%requires(reexport) DataProvider
%requires(reexport) RestClientIo

%requires json

%requires NdjsonDataProvider

module SearchIndexDataProvider {
    version = "1.0";
    desc = "user module providing common data provider helpers for REST search-index backends";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage SearchIndexDataProvider Module

    @tableofcontents

    @section searchindexdataproviderintro SearchIndexDataProvider Introduction

    The %SearchIndexDataProvider module provides common implementation helpers for REST data-provider modules that
    expose document-oriented search indexes.  It does not register a data provider factory by itself; concrete
    modules use it to keep backend-neutral behavior consistent while preserving backend-specific public factory
    names, connection schemes, logos, and API dialects.

    Shared behavior includes:
    - REST client construction from a `restclient`, `url`, or `restclient_options` constructor option
    - common logger propagation for REST-backed data providers
    - query-string option handling for request hashes
    - boolean string coercion for REST query parameters
    - O(n) newline-delimited JSON formatting for bulk document operations

    @section searchindexdataprovider_relnotes Release Notes

    @subsection searchindexdataprovider_v1_0 SearchIndexDataProvider v1.0
    - the initial version of the %SearchIndexDataProvider module
*/
