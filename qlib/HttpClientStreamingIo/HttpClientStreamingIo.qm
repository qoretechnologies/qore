%modern
%requires HttpClientIo

module HttpClientStreamingIo {
    version = "1.0";
    desc = "Application-level streaming utilities for HttpClientIo: SSE event reading "
        "and stream decompression across HTTP/1.x, HTTP/2, and HTTP/3";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! Main namespace for the HttpClientStreamingIo module
public namespace HttpClientStreamingIo {
}
