%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) AwsRestClient
%requires(reexport) BedrockRestClient
%requires RestClientIo
%requires RestSchemaActions
%requires OpenApi3
%requires json

module BedrockDataProvider {
    version = "1.0";
    desc = "typed AWS Bedrock inference, guardrail, model, evaluation, and administration actions";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Lightweight exact inventory: qualification can detect an incomplete registration without loading schemas.
        DataProviderActionCatalog::registerDiscoveryInventoryProvider("BedrockDataProvider",
            list<hash<DataProviderDiscoveryExpectedIdentityInfo>> sub () {
                return (<DataProviderDiscoveryExpectedIdentityInfo>{"app": BedrockDataProvider::AppName},)
                    + (map <DataProviderDiscoveryExpectedIdentityInfo>{
                        "app": BedrockDataProvider::AppName, "action": $1.action,
                    }, BedrockControlManifest::Manifest + BedrockRuntimeManifest::Manifest)
                    + (
                        <DataProviderDiscoveryExpectedIdentityInfo>{
                            "app": BedrockDataProvider::AppName, "action": "embed",
                        },
                        <DataProviderDiscoveryExpectedIdentityInfo>{
                            "app": BedrockDataProvider::AppName, "action": "make-api-call",
                        },
                    );
            });

        # register the data provider factory
        DataProvider::registerFactory(new BedrockDataProviderFactory());

        # register the application in the action catalog
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": BedrockDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "AWS Bedrock",
            "short_desc": "Foundation-model inference and administration on AWS",
            "desc": "**AWS Bedrock** gives business workflows typed access to its complete "
                "completed-response API surface through SigV4-signed regional endpoints:\n\n"
                "- Run Converse, generic model inference, token counting, guardrail checks, "
                "asynchronous inference, and curated embedding calls\n"
                "- Discover foundation models and inference profiles, with resource dropdowns "
                "that still accept IDs supplied by earlier workflow steps\n"
                "- Configure guardrails, model access, invocation logging, resource policies, "
                "tags, marketplace endpoints, and provisioned throughput\n"
                "- Manage custom and imported models, deployments, optimization and customization jobs, "
                "evaluations, prompt routers, and Automated Reasoning policies\n\n"
                "The three event-stream operations are available through the native Bedrock client, "
                "not as completed-value actions.\n\n"
                "Authentication uses the standard AWS credential chain: explicit "
                "keys → environment variables → ECS task role → IMDSv2 → STS "
                "AssumeRole — handled by the underlying `AwsRestClient`.\n\n"
                "Project: <https://aws.amazon.com/bedrock/>",
            "scheme": "bedrock",
            "logo": BedrockLogo,
            "logo_file_name": "bedrock-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm,),
        });

        BedrockActions::registerActions();
    };
}

/** @mainpage BedrockDataProvider Module

    @tableofcontents

    @section bedrockdataproviderintro Introduction to the BedrockDataProvider Module

    The %BedrockDataProvider module provides a @ref dataproviderintro "data provider" API for AWS Bedrock.
    It exports all 108 control-plane operations, all eight runtime operations that return completed values,
    the curated embedding action, and the generic API-call action. Requests and responses are recursively
    typed from pinned AWS botocore service descriptions.

    @par Action families

    Inference, asynchronous inference, foundation models, guardrails, inference profiles, custom and imported
    models, model access, marketplace endpoints, evaluation, model customization, invocation jobs, prompt
    routers, provisioned throughput, Automated Reasoning, optimization, account settings, resource policies,
    and tags. The public hand-written Converse provider remains available for source compatibility; the
    `/converse` catalog action uses the pinned schema contract.

    @par Streaming operations

    `ConverseStream`, `InvokeModelWithBidirectionalStream`, and `InvokeModelWithResponseStream` are deliberately
    not registered as completed-value actions. Use `BedrockRestClientIo` for their native event-stream lifetimes,
    including bidirectional input over HTTP/2. `BedrockLlmProvider::chatStream()` emits incremental Converse events.

    @par Factory

    The factory name is <b><tt>bedrock</tt></b>; resolve a connected
    provider via:
    @code{.py}
AbstractDataProvider p = DataProvider::getFactoryObjectFromString(
    "bedrock{aws_region=us-east-1,aws_keyid=...,aws_secret=...}");
    @endcode

    @par Example: DPQL Converse call

    @code{.unparsed}
qdp 'bedrock{aws_region=us-east-1}/converse' \
  modelId=anthropic.claude-3-5-sonnet-20240620-v1:0,'messages=[{role=user,content=[{text="Summarize Q3 results"}]}]'
    @endcode

    @section bedrockdataproviderrelnotes Release Notes

    @subsection bedrockdataprovider_v1_0 BedrockDataProvider v1.0
    - exports all 108 control-plane and eight completed-response runtime operations from pinned AWS service models
    - provides recursive typed options and outputs, enum choices, model/guardrail/profile reference data, and
      explicit mutation metadata, plus the existing curated embedding action
    - publishes an exact lightweight discovery inventory before schema materialization
    - preserves missing, null, empty, union, list, document, and wire-choice values through the schema boundary
    - routes control-plane and runtime calls to the correct regional endpoint with shared SigV4 credentials,
      retaining the source client's connection manager for the lifetime of derived providers
    - ships complete English presentation metadata and exact catalogs in Czech, German, Spanish, French, Italian,
      Japanese, Korean, Polish, Slovak, Ukrainian, Traditional Chinese, and Taiwanese Traditional Chinese

*/

#! Contains all public definitions in the BedrockDataProvider module
public namespace BedrockDataProvider {
#! AWS Bedrock app name
public const AppName = "AWSBedrock";
}

#! Module-level constants in a private namespace per the audit-changes design rule
namespace Priv {
    #! Bedrock logo loaded from the SVG file shipped with the module
    public const BedrockLogo = File::readTextFile(get_script_dir() + "/bedrock-logo.svg");
}
public namespace BedrockDataProvider {
    #! Re-export the logo into the module's public namespace
    public const BedrockLogo = Priv::BedrockLogo;
}
