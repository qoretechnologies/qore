# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) DataProvider
%requires(reexport) KatanaRestClient
%requires RestClientIo

module KatanaDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Katana MRP";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new KatanaDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": KatanaDataProvider::AppName,
            "display_name": "Katana",
            "short_desc": "Katana cloud manufacturing and inventory (MRP) integration",
            "desc": "Katana is a cloud-based manufacturing and inventory management (MRP) "
                "platform. This integration provides full CRUD operations for products, "
                "materials, variants, manufacturing orders, sales orders, purchase orders, "
                "customers, suppliers, locations, stock adjustments, tax rates, and webhooks, "
                "plus inventory visibility, batch stock tracking, and native webhook and "
                "polling event triggers.",
            "scheme": "katanarest",
            "logo": KatanaDataProvider::KatanaLogo,
            "logo_file_name": "katana-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AccountingErp, DataProvider::AppGroup::Ecommerce),
        });

        # ========== PRODUCT ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/products",
            "action": "list-products",
            "groups": "Products",
            "display_name": "List Products",
            "short_desc": "List products with filters and pagination",
            "desc": "List products from Katana MRP with optional filters",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "Get a specific product",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "products",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Filter by product name",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "is_sellable": <ActionOptionInfo>{
                    "display_name": "Is Sellable",
                    "short_desc": "Filter by sellable flag",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "is_producible": <ActionOptionInfo>{
                    "display_name": "Is Producible",
                    "short_desc": "Filter by producible flag",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "is_purchasable": <ActionOptionInfo>{
                    "display_name": "Is Purchasable",
                    "short_desc": "Filter by purchasable flag",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "category_name": <ActionOptionInfo>{
                    "display_name": "Category Name",
                    "short_desc": "Filter by category",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "default_supplier_id": <ActionOptionInfo>{
                    "display_name": "Default Supplier ID",
                    "short_desc": "Filter by default supplier",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "suppliers",
                },
                "batch_tracked": <ActionOptionInfo>{
                    "display_name": "Batch Tracked",
                    "short_desc": "Filter by batch tracking flag",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "serial_tracked": <ActionOptionInfo>{
                    "display_name": "Serial Tracked",
                    "short_desc": "Filter by serial tracking flag",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "uom": <ActionOptionInfo>{
                    "display_name": "UoM",
                    "short_desc": "Filter by unit of measure",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "is_auto_assembly": <ActionOptionInfo>{
                    "display_name": "Is Auto Assembly",
                    "short_desc": "Filter by auto-assembly flag",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
                "include_archived": <ActionOptionInfo>{
                    "display_name": "Include Archived",
                    "short_desc": "Include archived products",
                    "type": AbstractDataProviderTypeMap."*bool",
                    "desc": "If `True`, includes archived products in the response",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/products",
            "action": "get-product",
            "groups": "Products",
            "display_name": "Get Product",
            "short_desc": "Get a single product by ID",
            "desc": "Retrieve a single product by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "The product ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "products",
                },
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/products/create",
            "action": "create-product",
            "groups": "Products",
            "display_name": "Create Product",
            "short_desc": "Create a new product",
            "desc": "Create a new product in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaProductDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaCreateProductRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/products/update",
            "action": "update-product",
            "groups": "Products",
            "display_name": "Update Product",
            "short_desc": "Update an existing product",
            "desc": "Update an existing product in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaProductDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaUpdateProductRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/products/delete",
            "action": "delete-product",
            "groups": "Products",
            "display_name": "Delete Product",
            "short_desc": "Delete a product",
            "desc": "Delete a product from Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaDeleteProductRequestDataType::Fields),
        });

        # ========== MATERIAL ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/materials",
            "action": "list-materials",
            "groups": "Materials",
            "display_name": "List Materials",
            "short_desc": "List materials with filters and pagination",
            "desc": "List materials from Katana MRP with optional filters",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Material ID",
                    "short_desc": "Get a specific material",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "materials",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Filter by material name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "category_name": <ActionOptionInfo>{
                    "display_name": "Category Name",
                    "short_desc": "Filter by category",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "default_supplier_id": <ActionOptionInfo>{
                    "display_name": "Default Supplier ID",
                    "short_desc": "Filter by default supplier",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "suppliers",
                },
                "batch_tracked": <ActionOptionInfo>{
                    "display_name": "Batch Tracked",
                    "short_desc": "Filter by batch tracking",
                    "type": AbstractDataProviderTypeMap."*bool",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/materials",
            "action": "get-material",
            "groups": "Materials",
            "display_name": "Get Material",
            "short_desc": "Get a single material by ID",
            "desc": "Retrieve a single material by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Material ID",
                    "short_desc": "The material ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "materials",
                },
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/materials/create",
            "action": "create-material",
            "groups": "Materials",
            "display_name": "Create Material",
            "short_desc": "Create a new material",
            "desc": "Create a new material in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaMaterialDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaCreateMaterialRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/materials/update",
            "action": "update-material",
            "groups": "Materials",
            "display_name": "Update Material",
            "short_desc": "Update an existing material",
            "desc": "Update an existing material in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaMaterialDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaUpdateMaterialRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/materials/delete",
            "action": "delete-material",
            "groups": "Materials",
            "display_name": "Delete Material",
            "short_desc": "Delete a material",
            "desc": "Delete a material from Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaDeleteMaterialRequestDataType::Fields),
        });

        # ========== VARIANT ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/variants",
            "action": "list-variants",
            "groups": "Variants",
            "display_name": "List Variants",
            "short_desc": "List variants with filters and pagination",
            "desc": "List product/material variants from Katana MRP",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Variant ID",
                    "short_desc": "Get a specific variant",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "variants",
                },
                "sku": <ActionOptionInfo>{
                    "display_name": "SKU",
                    "short_desc": "Filter by SKU",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "Filter by parent product ID",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "products",
                },
                "material_id": <ActionOptionInfo>{
                    "display_name": "Material ID",
                    "short_desc": "Filter by parent material ID",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "materials",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/variants",
            "action": "get-variant",
            "groups": "Variants",
            "display_name": "Get Variant",
            "short_desc": "Get a single variant by ID",
            "desc": "Retrieve a single variant by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Variant ID",
                    "short_desc": "The variant ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "variants",
                },
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/variants/create",
            "action": "create-variant",
            "groups": "Variants",
            "display_name": "Create Variant",
            "short_desc": "Create a new variant",
            "desc": "Create a new variant in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaVariantDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaCreateVariantRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/variants/update",
            "action": "update-variant",
            "groups": "Variants",
            "display_name": "Update Variant",
            "short_desc": "Update an existing variant",
            "desc": "Update an existing variant in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaVariantDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaUpdateVariantRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/variants/delete",
            "action": "delete-variant",
            "groups": "Variants",
            "display_name": "Delete Variant",
            "short_desc": "Delete a variant",
            "desc": "Delete a variant from Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaDeleteVariantRequestDataType::Fields),
        });

        # ========== MANUFACTURING ORDER ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/manufacturing-orders",
            "action": "list-manufacturing-orders",
            "groups": "Manufacturing Orders",
            "display_name": "List Manufacturing Orders",
            "short_desc": "List manufacturing orders with filters",
            "desc": "List manufacturing orders from Katana MRP",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "Get a specific manufacturing order",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "manufacturing_orders",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": MoStatusUpdateAllowed,
                    "preselected": True,
                },
                "location_id": <ActionOptionInfo>{
                    "display_name": "Location ID",
                    "short_desc": "Filter by location",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "locations",
                },
                "order_no": <ActionOptionInfo>{
                    "display_name": "Order Number",
                    "short_desc": "Filter by order number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "is_linked_to_sales_order": <ActionOptionInfo>{
                    "display_name": "Linked To Sales Order",
                    "short_desc": "Filter MOs linked to a sales order",
                    "type": AbstractDataProviderTypeMap."*bool",
                    "desc": "If `True`, returns only MOs created from a sales order; "
                        "if `False`, only standalone MOs",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/manufacturing-orders",
            "action": "get-manufacturing-order",
            "groups": "Manufacturing Orders",
            "display_name": "Get Manufacturing Order",
            "short_desc": "Get a single manufacturing order by ID",
            "desc": "Retrieve a single manufacturing order by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "The manufacturing order ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "manufacturing_orders",
                },
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/manufacturing-orders/create",
            "action": "create-manufacturing-order",
            "groups": "Manufacturing Orders",
            "display_name": "Create Manufacturing Order",
            "short_desc": "Create a new manufacturing order",
            "desc": "Create a new manufacturing order in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaManufacturingOrderDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaCreateManufacturingOrderRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/manufacturing-orders/update",
            "action": "update-manufacturing-order",
            "groups": "Manufacturing Orders",
            "display_name": "Update Manufacturing Order",
            "short_desc": "Update an existing manufacturing order",
            "desc": "Update an existing manufacturing order in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaManufacturingOrderDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaUpdateManufacturingOrderRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/manufacturing-orders/delete",
            "action": "delete-manufacturing-order",
            "groups": "Manufacturing Orders",
            "display_name": "Delete Manufacturing Order",
            "short_desc": "Delete a manufacturing order",
            "desc": "Delete a manufacturing order from Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaDeleteManufacturingOrderRequestDataType::Fields),
        });

        # ========== SALES ORDER ACTIONS ==========

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/sales-orders",
            "action": "list-sales-orders",
            "groups": "Sales Orders",
            "display_name": "List Sales Orders",
            "short_desc": "List sales orders with filters",
            "desc": "List sales orders from Katana MRP",
            "action_code": DPAT_FIND,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "Get a specific sales order",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "sales_orders",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": SoStatusUpdateAllowed,
                    "preselected": True,
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer ID",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "customers",
                },
                "location_id": <ActionOptionInfo>{
                    "display_name": "Location ID",
                    "short_desc": "Filter by location",
                    "type": AbstractDataProviderTypeMap."*int",
                    "ref_data": "locations",
                },
                "order_no": <ActionOptionInfo>{
                    "display_name": "Order Number",
                    "short_desc": "Filter by order number",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "source": <ActionOptionInfo>{
                    "display_name": "Source",
                    "short_desc": "Filter by source",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "invoicing_status": <ActionOptionInfo>{
                    "display_name": "Invoicing Status",
                    "short_desc": "Filter by invoicing status",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "product_availability": <ActionOptionInfo>{
                    "display_name": "Product Availability",
                    "short_desc": "Filter by product availability",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": SoProductAvailabilityAllowed,
                },
                "ingredient_availability": <ActionOptionInfo>{
                    "display_name": "Ingredient Availability",
                    "short_desc": "Filter by ingredient availability",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": SoIngredientAvailabilityAllowed,
                },
                "production_status": <ActionOptionInfo>{
                    "display_name": "Production Status",
                    "short_desc": "Filter by production status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": SoProductionStatusAllowed,
                },
                "ecommerce_store_name": <ActionOptionInfo>{
                    "display_name": "Ecommerce Store Name",
                    "short_desc": "Filter by ecommerce store",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "ecommerce_order_id": <ActionOptionInfo>{
                    "display_name": "Ecommerce Order ID",
                    "short_desc": "Filter by ecommerce order ID",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "ecommerce_order_type": <ActionOptionInfo>{
                    "display_name": "Ecommerce Order Type",
                    "short_desc": "Filter by ecommerce order type",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "currency": <ActionOptionInfo>{
                    "display_name": "Currency",
                    "short_desc": "Filter by currency",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "ISO 4217 currency code (e.g. `USD`, `EUR`)",
                },
            } + CommonListActionOptions,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/sales-orders",
            "action": "get-sales-order",
            "groups": "Sales Orders",
            "display_name": "Get Sales Order",
            "short_desc": "Get a single sales order by ID",
            "desc": "Retrieve a single sales order by its ID",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "The sales order ID",
                    "type": AbstractDataProviderTypeMap."int",
                    "required": True,
                    "ref_data": "sales_orders",
                },
            },
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/sales-orders/create",
            "action": "create-sales-order",
            "groups": "Sales Orders",
            "display_name": "Create Sales Order",
            "short_desc": "Create a new sales order",
            "desc": "Create a new sales order in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaSalesOrderDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaCreateSalesOrderRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/sales-orders/update",
            "action": "update-sales-order",
            "groups": "Sales Orders",
            "display_name": "Update Sales Order",
            "short_desc": "Update an existing sales order",
            "desc": "Update an existing sales order in Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new KatanaSalesOrderDataType();
            },
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KatanaUpdateSalesOrderRequestDataType::Fields),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KatanaDataProvider::AppName,
            "path": "/sales-orders/delete",
            "action": "delete-sales-order",
            "groups": "Sales Orders",
            "display_name": "Delete Sales Order",
            "short_desc": "Delete a sales order",
            "desc": "Delete a sales order from Katana MRP",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return AbstractDataProviderType::get(AutoHashType);
            },
