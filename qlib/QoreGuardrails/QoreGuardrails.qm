# minimum required Qore version
%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires QoreLlmUtils

%try-module json
%define NoJson
%endtry

module QoreGuardrails {
    version = "1.1.0";
    desc = "user module providing input and output guardrails for AI-powered "
        "chat endpoints including PII detection, prompt injection detection, "
        "topic restriction, and output format enforcement";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreGuardrails Module

    @tableofcontents

    @section qoreguardrailsintro QoreGuardrails Module Introduction

    The %QoreGuardrails module provides input and output guardrails for
    AI-powered chat endpoints.  Rules are evaluated in chains with configurable
    severity levels and short-circuit behavior.

    Use guardrails to protect your AI-powered applications from security risks
    and compliance violations -- for example, preventing customers from
    extracting your system prompt, blocking credit card numbers from being sent
    to external AI services, or ensuring AI responses stay on-topic.

    Built-in rules:
    - @ref QoreGuardrails::PiiDetector "PiiDetector" -- pattern-based detection
      and redaction of PII (Personally Identifiable Information) such as email
      addresses, phone numbers, Social Security numbers, and credit card numbers
    - @ref QoreGuardrails::PromptInjectionDetector "PromptInjectionDetector" --
      LLM-based prompt injection classification
    - @ref QoreGuardrails::TopicRestrictionRule "TopicRestrictionRule" --
      LLM-based topic boundary enforcement
    - @ref QoreGuardrails::ToxicityDetector "ToxicityDetector" -- LLM-based
      toxicity classification with configurable thresholds
    - @ref QoreGuardrails::HallucinationDetector "HallucinationDetector" --
      LLM-based grounding check against provided source texts
    - @ref QoreGuardrails::ActionIntentRule "ActionIntentRule" -- LLM-based
      action-intent classification that fails when the user's phrasing is
      ambiguous or clearly informational, gating destructive tool dispatches
    - @ref QoreGuardrails::OutputFormatEnforcer "OutputFormatEnforcer" --
      pattern-based output validation (length, forbidden patterns)

    @par Example: Evaluate input guardrails
    @code{.py}
%requires QoreGuardrails
%modern

GuardrailEngine engine((
    <GuardrailRuleConfig>{"type": "pii", "enabled": True, "severity": "critical",
        "params": {"action": "redact"}},
    <GuardrailRuleConfig>{"type": "prompt_injection", "enabled": True, "severity": "critical"},
));
hash<GuardrailResult> result = engine.evaluateInput("My SSN is 123-45-6789");
if (!result.passed) {
    printf("Blocked: %y\n", result.violations);
}
    @endcode

    @section qoreguardrailsrelnotes QoreGuardrails Module Release Notes

    @subsection qoreguardrails_1_1 QoreGuardrails Module Version 1.1
    - Added a self-describing rule-type registry: every rule class now exposes
      a \c public \c static \c getConfigSchema() method returning a
      \c hash<string, hash<DataProviderOptionInfo>> that describes its
      configuration parameters (display names, descriptions, defaults,
      allowed values, required flags) so UI tools can render a typed editor
      form without hard-coding each rule type.
      @ref QoreGuardrails::GuardrailEngine::getRuleTypeRegistry() "GuardrailEngine::getRuleTypeRegistry()"
      aggregates every rule type's schema into a single keyed map.
    - New public hashdecl @ref QoreGuardrails::RuleTypeInfo "RuleTypeInfo"
      carries the registry entry shape — type name, display name,
      description, default direction, and config schema.
    - New @ref QoreGuardrails::ActionIntentRule "ActionIntentRule" rule type
      wraps @ref QoreLlmUtils::ActionIntentClassifier as an operator-editable
      guardrail; classifies each user turn as \c read-only,
      \c action-requested, or \c confirmation-required and fails when the
      classified label is in the configured \c block_intents set (defaults
      to just \c confirmation-required so ambiguous phrasings surface
      explicitly while clear commands and clear questions pass through).
      Registered as rule type \c "action_intent" in
      @ref QoreGuardrails::GuardrailEngine "GuardrailEngine".
    - @ref QoreLlmUtils is now a hard dependency of the module; the
      previous \c %try-module / \c NoLlmUtils conditional-compilation
      fallback has been removed since QoreLlmUtils ships with the Qore
      distribution.  Every LLM-capable rule
      (@ref QoreGuardrails::PromptInjectionDetector "PromptInjectionDetector",
      @ref QoreGuardrails::TopicRestrictionRule "TopicRestrictionRule",
      @ref QoreGuardrails::ToxicityDetector "ToxicityDetector",
      @ref QoreGuardrails::HallucinationDetector "HallucinationDetector",
      and @ref QoreGuardrails::ActionIntentRule "ActionIntentRule") uses
      QoreLlmUtils unconditionally.

    @subsection qoreguardrails_1_0 QoreGuardrails Module Version 1.0
    - Initial release with @ref QoreGuardrails::GuardrailEngine "GuardrailEngine",
      @ref QoreGuardrails::PiiDetector "PiiDetector",
      @ref QoreGuardrails::PromptInjectionDetector "PromptInjectionDetector",
      @ref QoreGuardrails::TopicRestrictionRule "TopicRestrictionRule", and
      @ref QoreGuardrails::OutputFormatEnforcer "OutputFormatEnforcer"
*/
