        "connection.QmVkcm9ja1Jlc3RDbGllbnQ.scheme.QmVkcm9ja1Jlc3RDb25uZWN0aW9u.option.YXdzX2V4dGVybmFsX2lk.short_desc": {
          "source": "Optional external ID required by the role",
          "message": "역할에 의해 필요할 수 있는 선택적 외부 ID"
        },
        "connection.QmVkcm9ja1Jlc3RDbGllbnQ.scheme.QmVkcm9ja1Jlc3RDb25uZWN0aW9u.option.YXdzX2tleWlk.desc": {
          "source": "AWS access key ID for explicit credentials. Leave this and `aws_secret` empty to use the AWS environment, ECS task-role, or IMDSv2 credential chain.",
          "message": "명시적 자격 증명용 AWS 액세스 키 ID입니다. 이 항목과 `aws_secret`를 비워두면 AWS 환경, ECS 작업 역할 또는 IMDSv2 자격 증명 체인을 사용합니다."
        },
