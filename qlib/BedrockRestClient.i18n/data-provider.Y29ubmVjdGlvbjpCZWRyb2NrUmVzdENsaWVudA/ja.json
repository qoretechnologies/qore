        },
        "connection.QmVkcm9ja1Jlc3RDbGllbnQ.scheme.QmVkcm9ja1Jlc3RDb25uZWN0aW9u.option.YXdzX2V4dGVybmFsX2lk.short_desc": {
          "source": "Optional external ID required by the role",
          "message": "ロールで必要なオプションの外部ID"
