# minimum qore version
%requires qore >= 2.0

# don't use "$" for vars, members, and methods, assume local variable scope
%new-style
%require-types
%enable-all-warnings
%strict-args

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires(reexport) Util

module KatanaRestClient {
    version = "1.0";
    desc = "Katana MRP REST API client module";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "http://qoretechnologies.com";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("katanarest",
            KatanaRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("katanarests",
            KatanaRestConnection::ConnectionScheme);
    };
}

/** @mainpage KatanaRestClient Module

    @tableofcontents

    @section katanarestclientintro KatanaRestClient Introduction

    The %KatanaRestClient module provides an API for calling Katana MRP REST API services.

    Katana is a cloud-based manufacturing and inventory management (MRP) platform. The Katana
    REST API exposes endpoints for managing products, materials, stock, sales orders,
    manufacturing orders, and related resources.

    To use this module, use \c "%requires KatanaRestClient" in your code.

    All the public symbols in the module are defined in the KatanaRestClient namespace.

    The main classes are:
    - @ref KatanaRestClient::KatanaRestClientBase "KatanaRestClientBase":
      abstract base with shared constants and option processing logic
    - @ref KatanaRestClient::KatanaRestClient "KatanaRestClient":
      synchronous REST client API for communication with the Katana MRP API
    - @ref KatanaRestClient::KatanaRestClientIo "KatanaRestClientIo":
      async-I/O-capable REST client for use with data providers
    - @ref KatanaRestClient::KatanaRestConnection "KatanaRestConnection":
      provides a connection object to Katana MRP services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires KatanaRestClient

KatanaRestClient katana({
    "apikey": ENV.KATANA_API_KEY,
});
hash<auto> result = katana.get("tax_rates?limit=1");
printf("Tax rates: %N\n", result.body);
    @endcode

    @section katanarestclientrelnotes Release Notes

    @subsection katanarestclientv1_0 KatanaRestClient v1.0
    - the initial version of the %KatanaRestClient module
*/

#! the KatanaRestClient namespace contains all the objects in the KatanaRestClient module
public namespace KatanaRestClient {

#! Common base class for KatanaRestClient functionality
public class KatanaRestClientBase {
    public {
        #! Default Katana MRP API URL
        const DefaultUrl = "https://api.katanamrp.com";

        #! Default API version path
        const DefaultApiVersion = "v1";

        #! Default "data" option value
        const DefaultData = "json";

        #! Default ping method
        const DefaultPingMethod = "GET";

        #! Default ping path (relative - no leading slash since default_path provides /v1)
        const DefaultPingPath = "tax_rates?limit=1";

        #! Default ping headers (Accept-only; auth header injected by getOptions)
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default headers for all requests
        const DefaultHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Default constructor options
        const DefaultOptions = {
            "url": DefaultUrl,
            "data": DefaultData,
            "default_path": "/" + DefaultApiVersion,
            "headers": DefaultHeaders,
            "http_version": "1.1",
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };

        #! Default connection URL
        const DefaultConnectionUrl = "katanarest://api.katanamrp.com/v1";
    }

    #! returns options for the KatanaRestClient / KatanaRestClientIo constructors
    /** @param opts constructor options including:
        - \c apikey: the Katana MRP API key (sent as a Bearer token in the
          \c Authorization header)

        @return processed options suitable for RestClient/RestClientIo constructors
    */
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto> rv = DefaultOptions + opts;

        # Inject Bearer authentication header from the apikey option
        if (opts.apikey) {
            rv.headers = (rv.headers ?? {}) + {
                "Authorization": sprintf("Bearer %s", opts.apikey),
            };
            remove rv.apikey;
        }

        return rv;
    }
}

#! This class provides the REST client API for communication with Katana MRP servers
/** Katana MRP exposes a REST API at https://api.katanamrp.com/v1 with Bearer token
    authentication.

    @par Authentication:
    - API key via \c Authorization: \c Bearer header
    - API key obtained from: Katana UI > Settings > API > "+ Add new API key"
      (requires the Professional plan)

    @par API Structure:
    All endpoints are under /v1 (set via the \c default_path option).
*/
public class KatanaRestClient inherits RestClient::RestClient, KatanaRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
KatanaRestClient katana({
    "apikey": ENV.KATANA_API_KEY,
});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient"
        class plus:
        - \c apikey: the Katana MRP API key (sent as a Bearer token in the
          \c Authorization header)

        @param do_not_connect if \c False (the default), then a connection will be immediately
        established to the remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data
        serialization, etc
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(KatanaRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }
}

#! Class for Katana MRP REST connections; returns @ref KatanaRestClient objects
/** This class implements all options of @ref RestClient::RestConnection "RestClientConnection"

    @see @ref KatanaRestClient::KatanaRestClient::constructor() for more information on the
    above options
*/
public class KatanaRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Katana MRP REST Connection",
            "short_desc": "A connection to the Katana MRP REST API",
            "desc": "A connection to the **Katana MRP** REST API for managing products, "
                "materials, stock, sales orders, purchase orders, manufacturing orders, "
                "and related manufacturing/inventory resources.\n\n"
                "Katana is a cloud-based manufacturing and inventory management (MRP) "
                "platform. The API uses Bearer token authentication; the API key is sent "
                "on every request in the `Authorization: Bearer <apikey>` header.\n\n"
                "**To obtain your API key:**\n"
                "1. Log in to your Katana account\n"
                "2. Open **Settings** > **API**\n"
                "3. Click **+ Add new API key** and copy the generated key\n\n"
                "**Important:** API access requires the **Professional plan** (or higher). "
                "The key has full access to your Katana data — keep it secure and never "
                "share it publicly.",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your API Key",
                    "intent": "info",
                    "content": "This integration requires a **Katana MRP API key**.\n\n"
                        "**Steps to generate a key:**\n"
                        "1. Log in to your Katana account\n"
                        "2. Open **Settings** > **API**\n"
                        "3. Click **+ Add new API key**\n"
                        "4. Copy the generated key value\n\n"
                        "**Plan requirement:** Katana API access is only available on the "
                        "**Professional plan** (or higher). If you do not see the API "
                        "section under Settings, please upgrade your subscription.\n\n"
                        "**How it is used:**\n"
                        "- The key is sent on every request as the "
                        "`Authorization: Bearer <apikey>` HTTP header\n"
                        "- The key provides full access to your Katana data; keep it "
                        "secure and never share it publicly",
                },
            ),
            "cls": Class::forName("KatanaRestConnection"),
            "auto_url": False,
            "schemes": {
                "katanarest": True,
                "katanarests": True,
            },
            "base_scheme_map": {
                "https": "katanarest",
            },
            "required_options": "apikey",
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Katana MRP API key for Bearer authentication",
                    "type": "string",
                    "desc": "The Katana MRP API key. Sent on every request in the "
                        "`Authorization: Bearer <apikey>` HTTP header.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Katana account\n"
                        "2. Open **Settings** > **API**\n"
                        "3. Click **+ Add new API key** and copy the generated value\n\n"
                        "**Note:** Katana API access requires the **Professional plan** "
                        "(or higher). The key has full access to your Katana data — "
                        "**keep it secure** and never share it publicly.",
                    "sensitive": True,
                    "preselected": True,
                },
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": KatanaRestClientBase::DefaultData,
                },
                "http_version": RestConnection::ConnectionScheme.options."http_version"
                + <ConnectionOptionInfo>{
                    "default_value": "1.1",
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": KatanaRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": KatanaRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": KatanaRestClientBase::DefaultPingPath,
                },
            },
        };
    }

    #! creates the KatanaRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and
        \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description,
            string url = KatanaRestClientBase::DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    #! creates the KatanaRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(KatanaRestConnection::getConfig(config), attr) {
    }

    #! returns config for @ref KatanaRestConnection::constructor()
    private static hash<auto> getConfig(hash<auto> config) {
        if (!config.url) {
            config.url = KatanaRestClientBase::DefaultConnectionUrl;
        }
        return config;
    }

    #! returns \c "katanarest"
    string getType() {
        return "katanarest";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider()
    #! method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Katana";
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the KatanaDataProvider and creates
        # the data provider object dynamically
        load_module("KatanaDataProvider");
        return create_object("KatanaDataProvider", getAsync());
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! returns a @ref KatanaRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter
        is ignored

        @return a @ref KatanaRestClient object
    */
    private KatanaRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new KatanaRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new KatanaRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! REST client for Katana MRP REST API using multiplexed HTTP connections
/** @see KatanaRestClient for more information
*/
public class KatanaRestClientIo inherits RestClientIo::RestClientIo, KatanaRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(KatanaRestClientBase::getOptions(opts), shared_mgr) {
    }
}
}
