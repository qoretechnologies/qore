# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern

%requires(reexport) DataProvider
%requires(reexport) ClickFunnelsRestClient

module ClickFunnelsDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for ClickFunnels 2.0";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new ClickFunnelsDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ClickFunnelsDataProvider::AppName,
            "display_name": "ClickFunnels",
            "short_desc": "ClickFunnels 2.0 marketing and sales funnel platform",
            "desc": "ClickFunnels 2.0 is a marketing and sales funnel platform for managing "
                "contacts, orders, products, funnels, courses, forms, and fulfillments.\n\n"
                "This integration supports full CRUD operations on core resources, "
                "tag management, and event-based triggers.",
            "scheme": "clickfunnelsrest",
            "logo": ClickFunnelsLogo,
            "logo_file_name": "clickfunnels-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Marketing,),
        });

        # ========== CONTACT ACTIONS ==========

        # Create a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contacts/create",
            "action": "create-contact",
            "groups": "Contacts",
            "display_name": "Create a Contact",
            "short_desc": "Create a new contact",
            "desc": "Create a new contact in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsContactDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsCreateContactRequestDataType::Fields),
        });

        # Update a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contacts/update",
            "action": "update-contact",
            "groups": "Contacts",
            "display_name": "Update a Contact",
            "short_desc": "Update an existing contact",
            "desc": "Update an existing contact in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsContactDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsUpdateContactRequestDataType::Fields),
        });

        # Delete a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contacts/delete",
            "action": "delete-contact",
            "groups": "Contacts",
            "display_name": "Delete a Contact",
            "short_desc": "Delete a contact",
            "desc": "Delete a contact from ClickFunnels",
            "action_code": DPAT_API,
            "output_type": AbstractDataProviderTypeMap."hash",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsDeleteContactRequestDataType::Fields),
        });

        # Upsert a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contacts/upsert",
            "action": "upsert-contact",
            "groups": "Contacts",
            "display_name": "Upsert a Contact",
            "short_desc": "Create or update a contact by email",
            "desc": "Create a new contact or update an existing one by email address in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsContactDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsCreateContactRequestDataType::Fields),
        });

        # List Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contacts",
            "action": "list-contacts",
            "groups": "Contacts",
            "display_name": "List Contacts",
            "short_desc": "List all contacts",
            "desc": "List contacts in ClickFunnels with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Filter by contact ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "contacts",
                },
                "email": <ActionOptionInfo>{
                    "display_name": "Email",
                    "short_desc": "Filter by email",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "after": <ActionOptionInfo>{
                    "display_name": "After Cursor",
                    "short_desc": "Pagination cursor",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sort_order": <ActionOptionInfo>{
                    "display_name": "Sort Order",
                    "short_desc": "Sort order",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "display_name": "Ascending"},
                        <AllowedValueInfo>{"value": "desc", "display_name": "Descending"},
                    ),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # Get a Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contacts",
            "action": "get-contact",
            "groups": "Contacts",
            "display_name": "Get a Contact",
            "short_desc": "Get a single contact by ID",
            "desc": "Retrieve a single contact by ID from ClickFunnels",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact ID",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contacts",
                },
            },
        });

        # ========== CONTACT TAG ACTIONS ==========

        # Create a Contact Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contact-tags/create",
            "action": "create-contact-tag",
            "groups": "Contact Tags",
            "display_name": "Create a Contact Tag",
            "short_desc": "Create a new contact tag",
            "desc": "Create a new contact tag in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsContactTagDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsCreateContactTagRequestDataType::Fields),
        });

        # Update a Contact Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contact-tags/update",
            "action": "update-contact-tag",
            "groups": "Contact Tags",
            "display_name": "Update a Contact Tag",
            "short_desc": "Update a contact tag",
            "desc": "Update an existing contact tag in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsContactTagDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsUpdateContactTagRequestDataType::Fields),
        });

        # Delete a Contact Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contact-tags/delete",
            "action": "delete-contact-tag",
            "groups": "Contact Tags",
            "display_name": "Delete a Contact Tag",
            "short_desc": "Delete a contact tag",
            "desc": "Delete a contact tag from ClickFunnels",
            "action_code": DPAT_API,
            "output_type": AbstractDataProviderTypeMap."hash",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsDeleteContactTagRequestDataType::Fields),
        });

        # List Contact Tags
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contact-tags",
            "action": "list-contact-tags",
            "groups": "Contact Tags",
            "display_name": "List Contact Tags",
            "short_desc": "List all contact tags",
            "desc": "List contact tags in ClickFunnels",
            "action_code": DPAT_FIND,
            "options": {
                "tag_id": <ActionOptionInfo>{
                    "display_name": "Tag ID",
                    "short_desc": "Filter by tag ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "contact_tags",
                },
                "name": <ActionOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "Filter by name",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                },
                "after": <ActionOptionInfo>{
                    "display_name": "After Cursor",
                    "short_desc": "Pagination cursor",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sort_order": <ActionOptionInfo>{
                    "display_name": "Sort Order",
                    "short_desc": "Sort order",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "display_name": "Ascending"},
                        <AllowedValueInfo>{"value": "desc", "display_name": "Descending"},
                    ),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # Get a Contact Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/contact-tags",
            "action": "get-contact-tag",
            "groups": "Contact Tags",
            "display_name": "Get a Contact Tag",
            "short_desc": "Get a single contact tag by ID",
            "desc": "Retrieve a single contact tag by ID from ClickFunnels",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "tag_id": <ActionOptionInfo>{
                    "display_name": "Tag ID",
                    "short_desc": "The tag ID to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contact_tags",
                },
            },
        });

        # ========== APPLIED TAG ACTIONS ==========

        # Apply a Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/applied-tags/apply",
            "action": "apply-tag",
            "groups": "Applied Tags",
            "display_name": "Apply Tag to Contact",
            "short_desc": "Apply a tag to a contact",
            "desc": "Apply a tag to a contact in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsAppliedTagDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsCreateAppliedTagRequestDataType::Fields),
        });

        # Remove a Tag
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/applied-tags/remove",
            "action": "remove-tag",
            "groups": "Applied Tags",
            "display_name": "Remove Tag from Contact",
            "short_desc": "Remove a tag from a contact",
            "desc": "Remove an applied tag from a contact in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": AbstractDataProviderTypeMap."hash",
            "options": {
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact",
                    "short_desc": "The contact to remove a tag from",
                    "desc": "Select the contact whose applied tag you want to remove",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "contacts",
                    "has_dependents": True,
                    "on_change": ("refetch",),
                },
                "applied_tag_id": <ActionOptionInfo>{
                    "display_name": "Applied Tag",
                    "short_desc": "The applied tag to remove",
                    "desc": "The applied tag to remove from the contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "depends_on": ("contact_id",),
                    "ref_data": "applied_tags",
                },
            },
        });

        # ========== ORDER ACTIONS ==========

        # Create an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/orders/create",
            "action": "create-order",
            "groups": "Orders",
            "display_name": "Create an Order",
            "short_desc": "Create a new order",
            "desc": "Create a new order in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsOrderDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsCreateOrderRequestDataType::Fields),
        });

        # Update an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/orders/update",
            "action": "update-order",
            "groups": "Orders",
            "display_name": "Update an Order",
            "short_desc": "Update an existing order",
            "desc": "Update an existing order in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsOrderDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsUpdateOrderRequestDataType::Fields),
        });

        # List Orders
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/orders",
            "action": "list-orders",
            "groups": "Orders",
            "display_name": "List Orders",
            "short_desc": "List all orders",
            "desc": "List orders in ClickFunnels",
            "action_code": DPAT_FIND,
            "options": {
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "Filter by order ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "orders",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "Filter by contact",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "contacts",
                    "preselected": True,
                },
                "after": <ActionOptionInfo>{
                    "display_name": "After Cursor",
                    "short_desc": "Pagination cursor",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sort_order": <ActionOptionInfo>{
                    "display_name": "Sort Order",
                    "short_desc": "Sort order",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "display_name": "Ascending"},
                        <AllowedValueInfo>{"value": "desc", "display_name": "Descending"},
                    ),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # Get an Order
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/orders",
            "action": "get-order",
            "groups": "Orders",
            "display_name": "Get an Order",
            "short_desc": "Get a single order by ID",
            "desc": "Retrieve a single order by ID from ClickFunnels",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "order_id": <ActionOptionInfo>{
                    "display_name": "Order ID",
                    "short_desc": "The order ID to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "orders",
                },
            },
        });

        # ========== PRODUCT ACTIONS ==========

        # Create a Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/products/create",
            "action": "create-product",
            "groups": "Products",
            "display_name": "Create a Product",
            "short_desc": "Create a new product",
            "desc": "Create a new product in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsProductDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsCreateProductRequestDataType::Fields),
        });

        # Update a Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/products/update",
            "action": "update-product",
            "groups": "Products",
            "display_name": "Update a Product",
            "short_desc": "Update an existing product",
            "desc": "Update an existing product in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsProductDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsUpdateProductRequestDataType::Fields),
        });

        # List Products
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/products",
            "action": "list-products",
            "groups": "Products",
            "display_name": "List Products",
            "short_desc": "List all products",
            "desc": "List products in ClickFunnels",
            "action_code": DPAT_FIND,
            "options": {
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "Filter by product ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "ref_data": "products",
                },
                "after": <ActionOptionInfo>{
                    "display_name": "After Cursor",
                    "short_desc": "Pagination cursor",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sort_order": <ActionOptionInfo>{
                    "display_name": "Sort Order",
                    "short_desc": "Sort order",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "display_name": "Ascending"},
                        <AllowedValueInfo>{"value": "desc", "display_name": "Descending"},
                    ),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # Get a Product
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/products",
            "action": "get-product",
            "groups": "Products",
            "display_name": "Get a Product",
            "short_desc": "Get a single product by ID",
            "desc": "Retrieve a single product by ID from ClickFunnels",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "product_id": <ActionOptionInfo>{
                    "display_name": "Product ID",
                    "short_desc": "The product ID to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "products",
                },
            },
        });

        # ========== FUNNEL ACTIONS ==========

        # Update a Funnel
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/funnels/update",
            "action": "update-funnel",
            "groups": "Funnels",
            "display_name": "Update a Funnel",
            "short_desc": "Update an existing funnel",
            "desc": "Update an existing funnel in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsFunnelDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ClickFunnelsUpdateFunnelRequestDataType::Fields),
        });

        # List Funnels
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/funnels",
            "action": "list-funnels",
            "groups": "Funnels",
            "display_name": "List Funnels",
            "short_desc": "List all funnels",
            "desc": "List funnels in ClickFunnels",
            "action_code": DPAT_FIND,
            "options": {
                "funnel_id": <ActionOptionInfo>{
                    "display_name": "Funnel ID",
                    "short_desc": "Filter by funnel ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "ref_data": "funnels",
                },
                "after": <ActionOptionInfo>{
                    "display_name": "After Cursor",
                    "short_desc": "Pagination cursor",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sort_order": <ActionOptionInfo>{
                    "display_name": "Sort Order",
                    "short_desc": "Sort order",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "display_name": "Ascending"},
                        <AllowedValueInfo>{"value": "desc", "display_name": "Descending"},
                    ),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # Get a Funnel
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/funnels",
            "action": "get-funnel",
            "groups": "Funnels",
            "display_name": "Get a Funnel",
            "short_desc": "Get a single funnel by ID",
            "desc": "Retrieve a single funnel by ID from ClickFunnels",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "funnel_id": <ActionOptionInfo>{
                    "display_name": "Funnel ID",
                    "short_desc": "The funnel ID to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "funnels",
                },
            },
        });

        # ========== COURSE ACTIONS ==========

        # List Courses
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/courses",
            "action": "list-courses",
            "groups": "Courses",
            "display_name": "List Courses",
            "short_desc": "List all courses",
            "desc": "List courses in ClickFunnels",
            "action_code": DPAT_FIND,
            "options": {
                "course_id": <ActionOptionInfo>{
                    "display_name": "Course ID",
                    "short_desc": "Filter by course ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "preselected": True,
                    "ref_data": "courses",
                },
                "after": <ActionOptionInfo>{
                    "display_name": "After Cursor",
                    "short_desc": "Pagination cursor",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "sort_order": <ActionOptionInfo>{
                    "display_name": "Sort Order",
                    "short_desc": "Sort order",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "asc", "display_name": "Ascending"},
                        <AllowedValueInfo>{"value": "desc", "display_name": "Descending"},
                    ),
                },
                "limit": <ActionOptionInfo>{
                    "display_name": "Limit",
                    "short_desc": "Maximum results",
                    "type": AbstractDataProviderTypeMap."*int",
                    "preselected": True,
                },
            },
        });

        # Get a Course
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/courses",
            "action": "get-course",
            "groups": "Courses",
            "display_name": "Get a Course",
            "short_desc": "Get a single course by ID",
            "desc": "Retrieve a single course by ID from ClickFunnels",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "course_id": <ActionOptionInfo>{
                    "display_name": "Course ID",
                    "short_desc": "The course ID to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "ref_data": "courses",
                },
            },
        });

        # ========== ENROLLMENT ACTIONS ==========

        # Create an Enrollment
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ClickFunnelsDataProvider::AppName,
            "path": "/enrollments/create",
            "action": "create-enrollment",
            "groups": "Enrollments",
            "display_name": "Create an Enrollment",
            "short_desc": "Enroll a contact in a course",
            "desc": "Create a new course enrollment in ClickFunnels",
            "action_code": DPAT_API,
            "output_type": new ClickFunnelsEnrollmentDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
