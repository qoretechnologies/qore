# minimum required Qore version
%requires qore >= 2.0
%modern

%requires(reexport) QoreLlmTypes
%requires reflection

%requires json

module QoreLlmUtils {
    version = "1.0.0";
    desc = "user module providing a pluggable LLM backend abstraction for chat "
        "completions across OpenAI-compatible, vendor-native, and callback LLM providers";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        LlmProviderRegistry::registerFactory(new CallbackLlmProviderFactory());
    };
    # the module registers process-wide functionality in its initialization (connection schemes, LLM provider factories)
    domains = "PROCESS_CONTROL";
}

/** @mainpage QoreLlmUtils Module

    @tableofcontents

    @section qorellmutilsintro QoreLlmUtils Module Introduction

    The %QoreLlmUtils module provides a pluggable LLM backend abstraction for Qore
    AI modules that need to make chat completion calls. An LLM (Large Language Model)
    is an AI system like ChatGPT or Claude that generates text responses.

    @ref QoreLlmUtils::LlmBackend "LlmBackend" selects a provider with the
    @ref QoreLlmUtils::LlmBackendConfig::mode "mode" option.  The \c callback mode calls a
    caller-supplied OpenAI-compatible dispatcher, for example an application
    gateway, tenant proxy, or metered AI routing layer.  All other modes are
    supplied by LLM client modules that are loaded on demand, including:

    - \b http: any OpenAI-compatible \c /v1/chat/completions endpoint, for
      example OpenAI or vLLM, with optional JSON schema enforcement via
      \c response_format
    - \b anthropic: the Anthropic Messages API (\c /v1/messages), with
      native tool-use-based JSON extraction when an output schema is provided
    - \b gemini and \b vertex-ai: Google Gemini models, with native function
      calling and structured outputs
    - \b azure-openai, \b bedrock, \b cohere, \b deepseek, \b fireworks,
      \b grok, \b groq, \b mistral, \b ollama, \b perplexity, \b sglang,
      and \b together

    See @ref QoreLlmUtils::LlmBackend "LlmBackend" for the complete list of
    modes, their client modules, and their configuration requirements.

    The module also includes
    @ref QoreLlmUtils::PromptSecretProtector "PromptSecretProtector", a provider-neutral helper for keeping
    user-supplied credentials out of model-visible prompts by replacing them
    with request-local placeholders, restoring them only at a caller's tool
    execution boundary, and redacting protected values from execution errors
    or logs.  Protection is language-independent: exact canonical machine
    keys, URI userinfo, and the structural <tt>:=</tt> protected-binding delimiter
    identify sensitive values without translated keyword lists.

    Language-independent safety and grounding helpers are provided by
    @ref QoreLlmUtils::LlmRequestClassifier "LlmRequestClassifier",
    @ref QoreLlmUtils::CitationValidator "CitationValidator", and
    @ref QoreLlmUtils::GroundedAnswerVerifier "GroundedAnswerVerifier".
    These classes are generic infrastructure: applications supply their own
    domain policy and authorized source bundles.

    @section qorellmutils_response_text Response Text and Token Budgets

    @ref QoreLlmUtils::LlmBackend::cleanResponseText() removes leading
    reasoning blocks and an enclosing code fence from completed response
    text. Gateways returning OpenAI-compatible response hashes can use
    @ref QoreLlmUtils::LlmBackend::cleanChatCompletionResponse() to clean
    assistant text while preserving tool calls and provider metadata.

    The OpenAI-compatible chat facade preserves the provider-reported \c service_tier
    in synchronous responses, stream chunks, and the final stream response. Applications
    calculating costs should use this served tier instead of the requested tier, since
    providers may downgrade priority traffic. Usage metadata (including cache-write
    counts and Anthropic \c inference_geo) is preserved without reinterpretation.

    Applications that budget each provider attempt can set \c tool_repair_enabled to \c False on the
    OpenAI-compatible facade. Empty or malformed tool responses then return with their original usage, without
    automatically requesting a repair. Transport retries remain independently controlled by \c max_retries.
    The default tool-repair behavior is unchanged; \ref QoreLlmUtils::LlmBackend::SupportedFacadeControls lists
    the controls the installed facade supports.

    To cancel a facade call, pass an @ref QoreLlmUtils::LlmCancellation object as \c cancellation in the
    @ref QoreLlmUtils::LlmFacadeCallOptions "call options" given beside the request (or in the request itself)
    and call its \c cancel() method from any thread. The facade keeps the token out of provider request bodies.
    Both chat-completions entry points report \c LLM-CANCELLED when a request is interrupted. Native HTTP
    transports cancel the in-flight request. In callback mode the application owns the transport; its callback
    can register a close handler on the same token to interrupt a blocked I/O operation.
    @code{.py}
LlmCancellation stop();
# The control thread calls stop.cancel("user requested stop").
hash<auto> result = backend.chatCompletions({"messages": messages},
    <LlmFacadeCallOptions>{"cancellation": stop});
    @endcode

    A cancellation aborts the request in flight at once: a non-streamed request has its connection closed (or
    its HTTP/2 stream reset) while its response is awaited, and a stream's reader stops without waiting for the
    next event. No transport retry or repair request follows a cancellation, and a call cancelled before its
    request is sent sends nothing.

    @section qorellmutils_async Asynchronous Calls

    @ref QoreLlmUtils::LlmBackend::chatCompletionsAsync() "LlmBackend::chatCompletionsAsync()",
    @ref QoreLlmUtils::LlmBackend::chatCompletionsStreamAsync() "chatCompletionsStreamAsync()",
    @ref QoreLlmUtils::LlmBackend::chatAsync() "chatAsync()" and
    @ref QoreLlmUtils::LlmBackend::chatStreamAsync() "chatStreamAsync()" make the calls of their synchronous
    counterparts without holding a thread while the provider is awaited: they return an
    @ref QoreLlmUtils::LlmAsyncOperation "LlmAsyncOperation" at once.  The request waits in the async I/O controller,
    a transport retry waits on a timer, and a tool or structured-output repair request is made when the response
    that needs it has been read.  Every step that runs %Qore code, including the stream callbacks and the completion
    callback, runs in a thread of the @ref QoreLlmUtils::LlmAsyncExecutor "executor" given in
    @ref QoreLlmUtils::LlmAsyncCallOptions "LlmAsyncCallOptions", one step of a call at a time; an application gives
    its own worker pool, or uses @ref QoreLlmUtils::LlmThreadPoolExecutor "LlmThreadPoolExecutor".

    The results (including \c usage), the errors (such as \c LLM-ERROR and \c LLM-CANCELLED), the stream chunks,
    the telemetry events, the retries and the repairs are those of the synchronous calls for the same responses of
    the provider.  A cancellation token given in the call options stops the call as it stops a synchronous call, and
    so does @ref QoreLlmUtils::LlmAsyncOperation::cancel() "LlmAsyncOperation::cancel()".  The Anthropic provider and
    the OpenAI-compatible providers make the request asynchronously; other providers run their synchronous call in
    a thread of the executor (@ref QoreLlmUtils::LlmBackend::supportsAsyncChat() "supportsAsyncChat()").
    @code{.py}
LlmThreadPoolExecutor executor(4);
LlmCancellation stop();
LlmAsyncOperation op = backend.chatCompletionsAsync({"messages": messages}, <LlmAsyncCallOptions>{
    "executor": executor,
    "on_complete": sub (LlmAsyncOperation op) {
        # runs in a thread of the executor when the call has ended
        if (*hash<ExceptionInfo> ex = op.getError()) {
            printf("%s: %s\n", ex.err, ex.desc);
        } else {
            printf("usage: %y\n", op.getResult().usage);
        }
    },
}, <LlmFacadeCallOptions>{"cancellation": stop});
    @endcode

    Reasoning models may consume their output budget before producing visible
    text. Size @c max_output_tokens (or @c max_tokens) for both reasoning and
    the answer, not just the requested answer length. Use supported reasoning
    controls such as @c reasoning_token_budget or @c disable_reasoning when
    appropriate. Explicit caller limits are preserved; there is no universal
    token floor across providers and models.

    @par Example: HTTP mode (OpenAI-compatible)
    @code{.py}
%modern
%requires QoreLlmUtils

LlmBackend llm({"mode": "http", "url": "http://localhost:8080", "model": "gpt-4o"});
hash<LlmCompletionResult> result = llm.complete(
    "You are a helpful assistant.",
    "Summarize this document: ...",
);
printf("Response: %s\n", result.content);
    @endcode

    @par Example: Anthropic mode
    @code{.py}
%modern
%requires QoreLlmUtils

LlmBackend llm({"mode": "anthropic", "url": "https://api.anthropic.com",
    "model": "claude-sonnet-4-20250514", "api_key": ENV.ANTHROPIC_API_KEY});
hash<LlmCompletionResult> result = llm.complete(
    "You are an extraction engine.",
    "Extract entities from: ...",
    {"type": "object", "properties": {"entities": {"type": "array"}}},
);
printf("Structured output: %s\n", result.content);
    @endcode

    @section qorellmutilsrelnotes QoreLlmUtils Module Release Notes

    @subsection qorellmutils_1_0 QoreLlmUtils Module Version 1.0
    - initial release
*/
