# minimum qore version
%requires qore >= 2.0

# assume local variable scope
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module ChargebeeRestClient {
    version = "1.0";
    desc = "User module for calling Chargebee REST API services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("chargebee", ChargebeeRestConnection::ConnectionScheme);
    };
}

/** @mainpage ChargebeeRestClient Module

    @tableofcontents

    @section chargebeerestclientintro ChargebeeRestClient Introduction

    The %ChargebeeRestClient module provides an API for calling Chargebee's REST API services.

    To use this module, use \c "%requires ChargebeeRestClient" in your code.

    All the public symbols in the module are defined in the ChargebeeRestClient namespace.

    The main classes are:
    - @ref ChargebeeRestClient::ChargebeeRestClient "ChargebeeRestClient":
      this class provides the REST client API for communication with the Chargebee API;
      it handles authentication via HTTP Basic Auth
    - @ref ChargebeeRestClient::ChargebeeRestConnection "ChargebeeRestConnection":
      provides a connection object to Chargebee services (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%requires ChargebeeRestClient

ChargebeeRestClient chargebee({"api_key": ENV.CHARGEBEE_API_KEY, "site": ENV.CHARGEBEE_SITE});
hash<auto> result = chargebee.get("subscriptions?limit=1");
printf("Subscriptions: %Y\n", result.body);
    @endcode

    @section chargebeerestclientrelnotes Release Notes

    @subsection chargebeerestclientv1_0 ChargebeeRestClient v1.0
    - the initial version of the %ChargebeeRestClient module
*/

#! the ChargebeeRestClient namespace contains all the objects in the ChargebeeRestClient module
public namespace ChargebeeRestClient {

#! Common base class for ChargebeeRestClient functionality
public class ChargebeeRestClientBase {
    public {
        #! Default "data" option value - form-encoded for Chargebee
        const DefaultData = "url";

        #! Default Chargebee ping method
        const DefaultPingMethod = "GET";

        #! Default Chargebee ping path (no leading slash - base URL has /api/v2 path)
        const DefaultPingPath = "subscriptions?limit=1";

        #! Default Chargebee ping headers
        const DefaultPingHeaders = {
            "Accept": MimeTypeJson,
        };

        #! Maximum total retry time for 429 errors
        const MaxRetryTime = 75s;

        #! Initial retry delay for exponential backoff
        const InitialRetryDelay = 1s;

        #! Maximum single retry delay
        const MaxRetryDelay = 30s;

        #! Default constructor options
        const DefaultOptions = {
            "data": DefaultData,
            "ping_headers": DefaultPingHeaders,
            "ping_method": DefaultPingMethod,
            "ping_path": DefaultPingPath,
        };
    }

    #! Returns the retry delay based on response headers or exponential backoff
    private date getRetryDelay(hash<auto> info, date default_delay) {
        if (info.headers."retry-after") {
            int secs = info.headers."retry-after".toInt();
            if (secs > 0) {
                return seconds(secs);
            }
        }
        return default_delay;
    }

    #! returns options for ChargebeeRestClient constructors
    /** The returned options keep the Chargebee-specific input options (\c api_key, \c site), which the REST client
        ignores, and derive the REST client options from them; this makes the method idempotent, so a client can be
        recreated from its own processed options, as with @ref RestClient::RestClient::copyWithUrl() "copyWithUrl()"

        If the \c url option is given, it takes precedence over the URL derived from \c site, and \c site is not
        required

        @throw CHARGEBEE-ERROR missing \c api_key option, or missing \c site option when no \c url option is given
    */
    static hash<auto> getOptions(hash<auto> opts) {
        # the options have values of different types, so the hash must not take the narrow type of the
        # defaults, which would prevent adding values of other types
        hash<auto!> rv = DefaultOptions + opts;

        # Validate required options
        if (!opts.api_key) {
            throw "CHARGEBEE-ERROR", "missing required option 'api_key' (Chargebee API key)";
        }

        # an explicit URL takes precedence over the URL derived from the site name
        if (!rv.url) {
            if (!opts.site) {
                throw "CHARGEBEE-ERROR", "missing required option 'site' (Chargebee site name) or 'url'";
            }
            rv.url = getApiUrl(opts.site);
        }

        # Set HTTP Basic Auth: username=API_KEY, password=empty; the api_key option is kept so that the options can
        # be processed again
        rv.username = opts.api_key;
        rv.password = "";

        return rv;
    }

    #! Returns the API URL for the given site name
    /** @param site the Chargebee site name

        @return the API URL for the given site name (ex: \c "https://acme.chargebee.com/api/v2")
    */
    static string getApiUrl(string site) {
        return sprintf("https://%s.chargebee.com/api/v2", site);
    }
}

#! This class provides the REST client API for communication with Chargebee servers
/** Chargebee uses a REST API with HTTP Basic Auth authentication.

    Authentication is done via HTTP Basic Auth where:
    - Username = API Key
    - Password = empty string

    @par API Information:
    - Base URL: https://{site}.chargebee.com/api/v2
    - Rate Limit: ~150 requests per minute (test sites), plan-dependent (live)
    - Request Format: form-encoded (application/x-www-form-urlencoded)
    - Response Format: JSON

    @par Rate Limit Handling:
    This client automatically handles HTTP 429 (Too Many Requests) errors by implementing
    retry logic with exponential backoff:
    - Maximum total retry time: 75 seconds
    - Initial retry delay: 1 second
    - Backoff multiplier: 2x
    - Maximum single retry delay: 30 seconds
    - Uses Retry-After header when available
*/
public class ChargebeeRestClient inherits RestClient::RestClient, ChargebeeRestClientBase {
    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
ChargebeeRestClient chargebee({"api_key": "test_xxx", "site": "acme-test"});
        @endcode

        @param opts valid options are all the options for the @ref RestClient::RestClient "RestClient" class
        plus:
        - \c api_key: the Chargebee API key (required)
        - \c site: the Chargebee site name (required if no \c url option is given) - e.g., "acme" for
          acme.chargebee.com

        If the \c url option is given, it takes precedence over the URL derived from \c site; the URL must include
        the API path (ex: \c "https://acme.chargebee.com/api/v2"); this can be used to send requests through a proxy
        or to a test server

        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw CHARGEBEE-ERROR missing required option 'api_key', or 'site' when no 'url' option is given
    */
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(ChargebeeRestClientBase::getOptions(opts), do_not_connect) {
        setAssumedEncoding("UTF-8");
    }

    #! Makes a REST request with automatic retry on 429 (Too Many Requests) errors
    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info, softbool decode_errors = True,
            *hash<auto> hdr) {
        date start_time = now_us();
        date current_delay = InitialRetryDelay;

        while (True) {
            # a 429 response is raised as an error, or returned if errors are passed through
            *hash<auto> response;
            *hash<ExceptionInfo> error;
            # the status code and headers of the response
            *int status;
            *hash<auto> response_headers;
            try {
                response = RestClient::doRequest(m, path, body, \info, decode_errors, hdr);
                status = info."response-code";
                response_headers = info."response-headers";
            } catch (hash<ExceptionInfo> ex) {
                # the synchronous client raises an error status as HTTP-CLIENT-RECEIVE-ERROR, with the status code
                # and the response headers in the exception argument
                status = info."response-code" ?? ex.arg.status_code;
                if ((ex.err != "REST-RESPONSE-ERROR" && ex.err != "HTTP-CLIENT-RECEIVE-ERROR") || status != 429) {
                    rethrow;
                }
                response_headers = info."response-headers" ?? ex.arg;
                error = ex;
            }
            if (status != 429) {
                return response;
            }

            date elapsed = now_us() - start_time;
            date retry_delay = getRetryDelay({"headers": response_headers}, current_delay);
            if (elapsed + retry_delay > MaxRetryTime) {
                retry_delay = MaxRetryTime - elapsed;
            }
            if (retry_delay <= 0s) {
                # the maximum retry time has been exceeded; the 429 error is returned or raised
                if (error) {
                    throw error.err, error.desc, error.arg;
                }
                return response;
            }

            sleep(retry_delay);

            current_delay = current_delay * 2;
            if (current_delay > MaxRetryDelay) {
                current_delay = MaxRetryDelay;
            }
        }
    }
}

#! Class for Chargebee REST connections; returns @ref ChargebeeRestClient objects
public class ChargebeeRestConnection inherits RestClient::RestConnection {
    public {
        #! Default Chargebee connection URL
        const DefaultConnectionUrl = "chargebee://localhost";

        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Chargebee REST Connection",
            "short_desc": "A connection to the Chargebee REST API",
            "desc": "A connection to the Chargebee REST API for subscription billing and revenue management.\n\n"
                "Chargebee is a subscription billing and revenue management platform that helps "
                "businesses manage their recurring revenue. This integration enables managing "
                "subscriptions, customers, invoices, coupons, and receiving event notifications.\n\n"
                "**Rate Limits:**\n"
                "- ~150 requests per minute for test sites\n"
                "- Plan-dependent limits for live sites\n"
                "- HTTP 429 with Retry-After header when exceeded",
            "cls": Class::forName("ChargebeeRestConnection"),
            "auto_url": True,
            "schemes": {
                "chargebee": True,
            },
            "base_scheme_map": {
                "https": "chargebee",
            },
            "options": RestConnection::ConnectionScheme.options + {
                "data": RestConnection::ConnectionScheme.options."data"
                + <ConnectionOptionInfo>{
                    "default_value": ChargebeeRestClientBase::DefaultData,
                },
                "api_key": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Chargebee API key for authentication",
                    "type": "string",
                    "desc": "The Chargebee API key used as the username for HTTP Basic Auth.\n\n"
                        "**To obtain your API key:**\n"
                        "1. Log in to your Chargebee site\n"
                        "2. Go to Settings > Configure Chargebee > API Keys (under API & Webhooks)\n"
                        "3. Copy an existing API key or create a new one\n\n"
                        "**Note:** Use test site keys for development and live site keys for production.",
                    "sensitive": True,
                    "preselected": True,
                },
                "site": <ConnectionOptionInfo>{
                    "display_name": "Site Name",
                    "short_desc": "Chargebee site name",
                    "type": "string",
                    "desc": "Your Chargebee site name. This is the subdomain of your Chargebee URL.\n\n"
                        "For example, if your Chargebee URL is https://acme-test.chargebee.com, "
                        "your site name is 'acme-test'.",
                    "preselected": True,
                },
                "ping_headers": RestConnection::ConnectionScheme.options."ping_headers"
                + <ConnectionOptionInfo>{
                    "default_value": ChargebeeRestClientBase::DefaultPingHeaders,
                },
                "ping_method": RestConnection::ConnectionScheme.options."ping_method"
                + <ConnectionOptionInfo>{
                    "default_value": ChargebeeRestClientBase::DefaultPingMethod,
                },
                "ping_path": RestConnection::ConnectionScheme.options."ping_path"
                + <ConnectionOptionInfo>{
                    "default_value": ChargebeeRestClientBase::DefaultPingPath,
                },
            },
            "required_options": "api_key,site",
            "messages": (
                <UiMessageInfo>{
                    "title": "How to Obtain Your API Key",
                    "intent": "info",
                    "content": "1. Log in to your Chargebee site (e.g., https://your-site.chargebee.com)\n"
                        "2. Go to **Settings** > **Configure Chargebee**\n"
                        "3. Under **API & Webhooks**, click **API Keys**\n"
                        "4. Copy an existing key or click **Add API Key** to create a new one\n\n"
                        "**Important:**\n"
                        "- Use **test site** keys during development\n"
                        "- Use **live site** keys for production\n"
                        "- Full-access keys can perform all API operations\n"
                        "- Read-only keys can only read data",
                },
            ),
        };
    }

    #! creates the ChargebeeRestConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL; if @ref DefaultConnectionUrl is given, the URL is derived from the \c site option
        @param attributes connection attributes
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option
    */
    constructor(string name, string description, string url = DefaultConnectionUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url == DefaultConnectionUrl
                ? ChargebeeRestConnection::getConnectionUrl(options)
                : url, attributes, options) {
    }

    #! creates the ChargebeeRestConnection object
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(ChargebeeRestConnection::getConfig(config), attr) {
    }

    #! returns config for the constructor - builds URL from site option
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": ChargebeeRestConnection::getConnectionUrl(config.opts),
        };
    }

    #! Returns the connection URL for the given connection options
    /** The connection URL is derived from the \c site option (ex: \c "chargebee://acme.chargebee.com/api/v2"); the
        URL given to the client is the connection URL with the \c "chargebee" scheme replaced with \c "https", which
        is the URL that the client would derive from the same option

        @param opts the connection options

        @return the connection URL for the given connection options, or @ref DefaultConnectionUrl if the \c site
        option is not set
    */
    static string getConnectionUrl(*hash<auto> opts) {
        return opts.site
            ? regex_subst(ChargebeeRestClientBase::getApiUrl(opts.site), "^https:", "chargebee:")
            : DefaultConnectionUrl;
    }

    #! returns \c "chargebee"
    string getType() {
        return "chargebee";
    }

    #! returns @ref True as this connection returns a data provider with the @ref getDataProvider() method
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    *string getAppName() {
        return "Chargebee";
    }

    #! returns a data provider object for this connection
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("ChargebeeDataProvider");
        return create_object("ChargebeeDataProvider", self);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
        children_can_support_apis = True;
    }

    #! Sets the update options code for the connection
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
        if (update_options && opts.site) {
            string expected_url = getConnectionUrl(opts);
            if (url != expected_url) {
                doUpdateOptions(self, {
                    "url": expected_url,
                });
            }
        }
    }

    #! returns a @ref ChargebeeRestClient object
    private ChargebeeRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new ChargebeeRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since ChargebeeRestClient 1.1
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new ChargebeeRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! Chargebee REST client for non-blocking I/O
public class ChargebeeRestClientIo inherits RestClientIo::RestClientIo, ChargebeeRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(ChargebeeRestClientBase::getOptions(opts), shared_mgr) {
    }

    #! Makes a REST request with automatic retry on 429 (Too Many Requests) errors
    /** A rate-limited request is retried after the time given in the \c Retry-After response header, or after an
        exponentially increasing delay if the header is not present, for up to @ref MaxRetryTime in total

        @param method the HTTP method
        @param path the request path
        @param body the request body, if any
        @param hdr any additional request headers

        @return the response

        @throw REST-RESPONSE-ERROR an HTTP error response was received, or the request was still rate-limited after
        @ref MaxRetryTime
    */
    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body, *hash<auto> hdr) {
        date start_time = now_us();
        date current_delay = InitialRetryDelay;
        while (True) {
            try {
                return RestClientIo::restDoRequest(method, path, body, hdr);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REST-RESPONSE-ERROR" || ex.arg.status_code != 429) {
                    rethrow;
                }
                date elapsed = now_us() - start_time;
                if (elapsed >= MaxRetryTime) {
                    rethrow;
                }
                date retry_delay = getRetryDelay(ex.arg, current_delay);
                if (elapsed + retry_delay > MaxRetryTime) {
                    retry_delay = MaxRetryTime - elapsed;
                }
                usleep(retry_delay);
                current_delay = current_delay * 2;
                if (current_delay > MaxRetryDelay) {
                    current_delay = MaxRetryDelay;
                }
            }
        }
    }
}
}
