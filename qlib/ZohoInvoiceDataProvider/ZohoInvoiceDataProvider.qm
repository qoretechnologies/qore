# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%new-style
# require type definitions everywhere
%require-types
# strict argument handling
%strict-args
# enable all warnings
%enable-all-warnings

%requires(reexport) DataProvider
%requires(reexport) ZohoInvoiceRestClient
%requires json

module ZohoInvoiceDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Zoho Invoice invoicing and billing";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new ZohoInvoiceDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ZohoInvoiceDataProvider::AppName,
            "display_name": "Zoho Invoice",
            "short_desc": "Zoho Invoice online invoicing software",
            "desc": "Zoho Invoice is online invoicing software that helps businesses create and send "
                "professional invoices, track time, manage expenses, and accept online payments.\n\n"
                "This integration supports invoices, recurring invoices, contacts, estimates, expenses, "
                "recurring expenses, payments, projects, and items.",
            "scheme": "zohoinvoice",
            "logo": ZohoInvoiceLogo,
            "logo_file_name": "zohoinvoice-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AccountingErp,),
        });

        # ========== INVOICE ACTIONS ==========

        # Create Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/create-invoice",
            "action": "create-invoice",
            "groups": "Invoices",
            "display_name": "Create Invoice",
            "short_desc": "Create a new invoice",
            "desc": "Create a new invoice in Zoho Invoice for a customer",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer for the invoice",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
            },
        });

        # Update Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/update-invoice",
            "action": "update-invoice",
            "groups": "Invoices",
            "display_name": "Update Invoice",
            "short_desc": "Update an existing invoice",
            "desc": "Update an existing invoice in Zoho Invoice",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Delete Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/delete-invoice",
            "action": "delete-invoice",
            "groups": "Invoices",
            "display_name": "Delete Invoice",
            "short_desc": "Delete an invoice",
            "desc": "Delete an invoice from Zoho Invoice",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Get Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/get-invoice",
            "action": "get-invoice",
            "groups": "Invoices",
            "display_name": "Get Invoice",
            "short_desc": "Get invoice details",
            "desc": "Retrieve details of a specific invoice",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # List Invoices
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/invoices",
            "action": "list-invoices",
            "groups": "Invoices",
            "display_name": "List Invoices",
            "short_desc": "List all invoices",
            "desc": "Retrieve a list of invoices with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by invoice status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "draft", "desc": "Draft invoices"},
                        <AllowedValueInfo>{"value": "sent", "desc": "Sent invoices"},
                        <AllowedValueInfo>{"value": "overdue", "desc": "Overdue invoices"},
                        <AllowedValueInfo>{"value": "paid", "desc": "Paid invoices"},
                        <AllowedValueInfo>{"value": "void", "desc": "Voided invoices"},
                        <AllowedValueInfo>{"value": "unpaid", "desc": "Unpaid invoices"},
                        <AllowedValueInfo>{"value": "partially_paid", "desc": "Partially paid invoices"},
                    ),
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
            },
        });

        # Email Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/email-invoice",
            "action": "email-invoice",
            "groups": "Invoices",
            "display_name": "Email Invoice",
            "short_desc": "Send an invoice by email",
            "desc": "Send an invoice to the customer via email",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to email",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "to_mail_ids": <ActionOptionInfo>{
                    "display_name": "To",
                    "short_desc": "Recipient email addresses",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "Email addresses to send the invoice to",
                },
                "subject": <ActionOptionInfo>{
                    "display_name": "Subject",
                    "short_desc": "Email subject",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "body": <ActionOptionInfo>{
                    "display_name": "Body",
                    "short_desc": "Email body",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Mark Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/mark-invoice",
            "action": "mark-invoice",
            "groups": "Invoices",
            "display_name": "Mark Invoice Status",
            "short_desc": "Change invoice status",
            "desc": "Change the status of an invoice (sent, void, or draft)",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to mark",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "New status for the invoice",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "sent", "desc": "Mark as sent"},
                        <AllowedValueInfo>{"value": "void", "desc": "Mark as void"},
                        <AllowedValueInfo>{"value": "draft", "desc": "Mark as draft"},
                    ),
                },
            },
        });

        # ========== RECURRING INVOICE ACTIONS ==========

        # Create Recurring Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/create-recurring-invoice",
            "action": "create-recurring-invoice",
            "groups": "Recurring Invoices",
            "display_name": "Create Recurring Invoice",
            "short_desc": "Create a new recurring invoice",
            "desc": "Create a new recurring invoice profile in Zoho Invoice",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer for the recurring invoice",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
            },
        });

        # Update Recurring Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/update-recurring-invoice",
            "action": "update-recurring-invoice",
            "groups": "Recurring Invoices",
            "display_name": "Update Recurring Invoice",
            "short_desc": "Update an existing recurring invoice",
            "desc": "Update an existing recurring invoice profile",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "recurring_invoice_id": <ActionOptionInfo>{
                    "display_name": "Recurring Invoice ID",
                    "short_desc": "The recurring invoice to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Get Recurring Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/get-recurring-invoice",
            "action": "get-recurring-invoice",
            "groups": "Recurring Invoices",
            "display_name": "Get Recurring Invoice",
            "short_desc": "Get recurring invoice details",
            "desc": "Retrieve details of a specific recurring invoice",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "recurring_invoice_id": <ActionOptionInfo>{
                    "display_name": "Recurring Invoice ID",
                    "short_desc": "The recurring invoice to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # List Recurring Invoices
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/recurring-invoices",
            "action": "list-recurring-invoices",
            "groups": "Recurring Invoices",
            "display_name": "List Recurring Invoices",
            "short_desc": "List all recurring invoices",
            "desc": "Retrieve a list of recurring invoices",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
            },
        });

        # Mark Recurring Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/mark-recurring-invoice",
            "action": "mark-recurring-invoice",
            "groups": "Recurring Invoices",
            "display_name": "Mark Recurring Invoice Status",
            "short_desc": "Change recurring invoice status",
            "desc": "Stop or resume a recurring invoice",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "recurring_invoice_id": <ActionOptionInfo>{
                    "display_name": "Recurring Invoice ID",
                    "short_desc": "The recurring invoice to mark",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "New status for the recurring invoice",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "stop", "desc": "Stop recurring invoice"},
                        <AllowedValueInfo>{"value": "resume", "desc": "Resume recurring invoice"},
                    ),
                },
            },
        });

        # ========== CONTACT ACTIONS ==========

        # Create Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/create-contact",
            "action": "create-contact",
            "groups": "Contacts",
            "display_name": "Create Contact",
            "short_desc": "Create a new contact",
            "desc": "Create a new customer contact in Zoho Invoice",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_name": <ActionOptionInfo>{
                    "display_name": "Contact Name",
                    "short_desc": "Name of the contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Update Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/update-contact",
            "action": "update-contact",
            "groups": "Contacts",
            "display_name": "Update Contact",
            "short_desc": "Update an existing contact",
            "desc": "Update an existing contact's information",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
        });

        # Delete Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/delete-contact",
            "action": "delete-contact",
            "groups": "Contacts",
            "display_name": "Delete Contact",
            "short_desc": "Delete a contact",
            "desc": "Delete a contact from Zoho Invoice",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
        });

        # Get Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/get-contact",
            "action": "get-contact",
            "groups": "Contacts",
            "display_name": "Get Contact",
            "short_desc": "Get contact details",
            "desc": "Retrieve details of a specific contact",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
            },
        });

        # List Contacts
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/contacts",
            "action": "list-contacts",
            "groups": "Contacts",
            "display_name": "List Contacts",
            "short_desc": "List all contacts",
            "desc": "Retrieve a list of contacts (customers)",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by contact status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "active", "desc": "Active contacts only"},
                        <AllowedValueInfo>{"value": "inactive", "desc": "Inactive contacts only"},
                    ),
                },
            },
        });

        # Mark Contact
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/mark-contact",
            "action": "mark-contact",
            "groups": "Contacts",
            "display_name": "Mark Contact Status",
            "short_desc": "Change contact status",
            "desc": "Mark a contact as active or inactive",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "contact_id": <ActionOptionInfo>{
                    "display_name": "Contact ID",
                    "short_desc": "The contact to mark",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "contacts",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "New status for the contact",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "active", "desc": "Mark as active"},
                        <AllowedValueInfo>{"value": "inactive", "desc": "Mark as inactive"},
                    ),
                },
            },
        });

        # ========== EXPENSE ACTIONS ==========

        # Create Expense
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/create-expense",
            "action": "create-expense",
            "groups": "Expenses",
            "display_name": "Create Expense",
            "short_desc": "Create a new expense",
            "desc": "Record a new expense in Zoho Invoice",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "account_id": <ActionOptionInfo>{
                    "display_name": "Account",
                    "short_desc": "Expense account",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "amount": <ActionOptionInfo>{
                    "display_name": "Amount",
                    "short_desc": "Expense amount",
                    "type": AbstractDataProviderTypeMap."float",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Update Expense
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/update-expense",
            "action": "update-expense",
            "groups": "Expenses",
            "display_name": "Update Expense",
            "short_desc": "Update an existing expense",
            "desc": "Update an existing expense record",
            "action_code": DPAT_API,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "expense_id": <ActionOptionInfo>{
                    "display_name": "Expense ID",
                    "short_desc": "The expense to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # Delete Expense
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/delete-expense",
            "action": "delete-expense",
            "groups": "Expenses",
            "display_name": "Delete Expense",
            "short_desc": "Delete an expense",
