# minimum required Qore version
%requires qore >= 2.0
# assume local scope for variables, do not use "$" signs
%modern
# require type definitions everywhere
# strict argument handling
# enable all warnings

%requires(reexport) DataProvider
%requires(reexport) ZohoInvoiceRestClient
%try-module json
%define NoJson
%endtry

module ZohoInvoiceDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Zoho Invoice invoicing and billing";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new ZohoInvoiceDataProviderFactory());

        # Register the application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ZohoInvoiceDataProvider::AppName,
            "display_name": "Zoho Invoice",
            "short_desc": "Zoho Invoice online invoicing software",
            "desc": "Zoho Invoice is online invoicing software that helps businesses create and send "
                "professional invoices, track time, manage expenses, and accept online payments.\n\n"
                "This integration supports invoices, recurring invoices, contacts, estimates, expenses, "
                "recurring expenses, payments, projects, and items.",
            "scheme": "zohoinvoice",
            "logo": ZohoInvoiceLogo,
            "logo_file_name": "zohoinvoice-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AccountingErp,),
        });

        # ========== INVOICE ACTIONS ==========

        # Create Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/create-invoice",
            "action": "create-invoice",
            "groups": "Invoices",
            "display_name": "Create Invoice",
            "short_desc": "Create a new invoice",
            "desc": "Create a new invoice in Zoho Invoice for a customer",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new ZohoInvoiceInvoiceDataType();
            },
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer for the invoice",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
                "reference_number": <ActionOptionInfo>{
                    "display_name": "Reference Number",
                    "short_desc": "PO number or external reference",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "External reference such as purchase order number or contract number",
                },
                "date": <ActionOptionInfo>{
                    "display_name": "Invoice Date",
                    "short_desc": "Date of the invoice",
                    "type": AbstractDataProviderTypeMap."*date",
                    "desc": "The date of the invoice (defaults to today if not specified)",
                },
                "due_date": <ActionOptionInfo>{
                    "display_name": "Due Date",
                    "short_desc": "Payment due date",
                    "type": AbstractDataProviderTypeMap."*date",
                    "desc": "The date payment is due",
                },
                "payment_terms": <ActionOptionInfo>{
                    "display_name": "Payment Terms",
                    "short_desc": "Payment terms (days)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Payment terms in days (e.g., 30 for Net 30)",
                },
                "discount": <ActionOptionInfo>{
                    "display_name": "Discount",
                    "short_desc": "Discount amount or percentage",
                    "type": AbstractDataProviderTypeMap."*float",
                    "desc": "Discount applied to the invoice (amount or percentage)",
                },
                "discount_type": <ActionOptionInfo>{
                    "display_name": "Discount Type",
                    "short_desc": "Type of discount",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Whether discount applies to entire invoice or per line item",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "entity_level", "desc": "Discount on entire invoice"},
                        <AllowedValueInfo>{"value": "item_level", "desc": "Discount per line item"},
                    ),
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Invoice notes",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Notes added to the invoice (visible to customer)",
                },
                "terms": <ActionOptionInfo>{
                    "display_name": "Terms",
                    "short_desc": "Terms and conditions",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Terms and conditions for the invoice",
                },
                "salesperson_name": <ActionOptionInfo>{
                    "display_name": "Salesperson",
                    "short_desc": "Name of salesperson",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Name of the salesperson associated with this invoice",
                },
                "template_id": <ActionOptionInfo>{
                    "display_name": "Template",
                    "short_desc": "PDF template ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "ID of the PDF template to use for this invoice",
                },
            },
        });

        # Update Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/update-invoice",
            "action": "update-invoice",
            "groups": "Invoices",
            "display_name": "Update Invoice",
            "short_desc": "Update an existing invoice",
            "desc": "Update an existing invoice in Zoho Invoice",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new ZohoInvoiceInvoiceDataType();
            },
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "invoices",
                },
                "reference_number": <ActionOptionInfo>{
                    "display_name": "Reference Number",
                    "short_desc": "PO number or external reference",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "External reference such as purchase order number or contract number",
                },
                "date": <ActionOptionInfo>{
                    "display_name": "Invoice Date",
                    "short_desc": "Date of the invoice",
                    "type": AbstractDataProviderTypeMap."*date",
                    "desc": "The date of the invoice",
                },
                "due_date": <ActionOptionInfo>{
                    "display_name": "Due Date",
                    "short_desc": "Payment due date",
                    "type": AbstractDataProviderTypeMap."*date",
                    "desc": "The date payment is due",
                },
                "payment_terms": <ActionOptionInfo>{
                    "display_name": "Payment Terms",
                    "short_desc": "Payment terms (days)",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Payment terms in days (e.g., 30 for Net 30)",
                },
                "discount": <ActionOptionInfo>{
                    "display_name": "Discount",
                    "short_desc": "Discount amount or percentage",
                    "type": AbstractDataProviderTypeMap."*float",
                    "desc": "Discount applied to the invoice (amount or percentage)",
                },
                "discount_type": <ActionOptionInfo>{
                    "display_name": "Discount Type",
                    "short_desc": "Type of discount",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Whether discount applies to entire invoice or per line item",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "entity_level", "desc": "Discount on entire invoice"},
                        <AllowedValueInfo>{"value": "item_level", "desc": "Discount per line item"},
                    ),
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Invoice notes",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Notes added to the invoice (visible to customer)",
                },
                "terms": <ActionOptionInfo>{
                    "display_name": "Terms",
                    "short_desc": "Terms and conditions",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Terms and conditions for the invoice",
                },
                "salesperson_name": <ActionOptionInfo>{
                    "display_name": "Salesperson",
                    "short_desc": "Name of salesperson",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Name of the salesperson associated with this invoice",
                },
                "template_id": <ActionOptionInfo>{
                    "display_name": "Template",
                    "short_desc": "PDF template ID",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "ID of the PDF template to use for this invoice",
                },
            },
        });

        # Delete Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/delete-invoice",
            "action": "delete-invoice",
            "groups": "Invoices",
            "display_name": "Delete Invoice",
            "short_desc": "Delete an invoice",
            "desc": "Delete an invoice from Zoho Invoice",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return ZohoInvoiceDeleteInvoiceDataProvider::ResponseType;
            },
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to delete",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "invoices",
                },
            },
        });

        # Get Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/invoices",
            "action": "get-invoice",
            "groups": "Invoices",
            "display_name": "Get Invoice",
            "short_desc": "Get invoice details",
            "desc": "Retrieve details of a specific invoice",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "invoices",
                },
            },
        });

        # List Invoices
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/invoices",
            "action": "list-invoices",
            "groups": "Invoices",
            "display_name": "List Invoices",
            "short_desc": "List all invoices",
            "desc": "Retrieve a list of invoices with optional filtering",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "Filter by invoice status",
                    "type": AbstractDataProviderTypeMap."*string",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "draft", "desc": "Draft invoices"},
                        <AllowedValueInfo>{"value": "sent", "desc": "Sent invoices"},
                        <AllowedValueInfo>{"value": "overdue", "desc": "Overdue invoices"},
                        <AllowedValueInfo>{"value": "paid", "desc": "Paid invoices"},
                        <AllowedValueInfo>{"value": "void", "desc": "Voided invoices"},
                        <AllowedValueInfo>{"value": "unpaid", "desc": "Unpaid invoices"},
                        <AllowedValueInfo>{"value": "partially_paid", "desc": "Partially paid invoices"},
                    ),
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
                "date_start": <ActionOptionInfo>{
                    "display_name": "Date Start",
                    "short_desc": "Filter from this date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter invoices created on or after this date (`YYYY-MM-DD`)",
                },
                "date_end": <ActionOptionInfo>{
                    "display_name": "Date End",
                    "short_desc": "Filter to this date",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Filter invoices created on or before this date (`YYYY-MM-DD`)",
                },
                "invoice_number": <ActionOptionInfo>{
                    "display_name": "Invoice Number",
                    "short_desc": "Search by invoice number",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Search invoices by invoice number",
                },
            },
        });

        # Email Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/email-invoice",
            "action": "email-invoice",
            "groups": "Invoices",
            "display_name": "Email Invoice",
            "short_desc": "Send an invoice by email",
            "desc": "Send an invoice to the customer via email",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return ZohoInvoiceEmailInvoiceDataProvider::ResponseType;
            },
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to email",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "invoices",
                },
                "to_mail_ids": <ActionOptionInfo>{
                    "display_name": "To",
                    "short_desc": "Recipient email addresses",
                    "type": AbstractDataProviderTypeMap."*list",
                    "desc": "Email addresses to send the invoice to",
                },
                "subject": <ActionOptionInfo>{
                    "display_name": "Subject",
                    "short_desc": "Email subject",
                    "type": AbstractDataProviderTypeMap."*string",
                },
                "body": <ActionOptionInfo>{
                    "display_name": "Body",
                    "short_desc": "Email body",
                    "type": AbstractDataProviderTypeMap."*string",
                },
            },
        });

        # Mark Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/mark-invoice",
            "action": "mark-invoice",
            "groups": "Invoices",
            "display_name": "Mark Invoice Status",
            "short_desc": "Change invoice status",
            "desc": "Change the status of an invoice (sent, void, or draft)",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return ZohoInvoiceMarkInvoiceDataProvider::ResponseType;
            },
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "invoice_id": <ActionOptionInfo>{
                    "display_name": "Invoice ID",
                    "short_desc": "The invoice to mark",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "invoices",
                },
                "status": <ActionOptionInfo>{
                    "display_name": "Status",
                    "short_desc": "New status for the invoice",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "sent", "desc": "Mark as sent"},
                        <AllowedValueInfo>{"value": "void", "desc": "Mark as void"},
                        <AllowedValueInfo>{"value": "draft", "desc": "Mark as draft"},
                    ),
                },
            },
        });

        # ========== RECURRING INVOICE ACTIONS ==========

        # Create Recurring Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/create-recurring-invoice",
            "action": "create-recurring-invoice",
            "groups": "Recurring Invoices",
            "display_name": "Create Recurring Invoice",
            "short_desc": "Create a new recurring invoice",
            "desc": "Create a new recurring invoice profile in Zoho Invoice",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new ZohoInvoiceRecurringInvoiceDataType();
            },
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "The customer for the recurring invoice",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "customers",
                },
                "payment_terms": <ActionOptionInfo>{
                    "display_name": "Payment Terms",
                    "short_desc": "Net payment terms in days",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Net payment terms in days (e.g., Net 30, Net 60)",
                },
                "discount": <ActionOptionInfo>{
                    "display_name": "Discount",
                    "short_desc": "Discount amount or percentage",
                    "type": AbstractDataProviderTypeMap."*float",
                    "desc": "Discount amount or percentage to apply to the invoice",
                },
                "discount_type": <ActionOptionInfo>{
                    "display_name": "Discount Type",
                    "short_desc": "How discount is applied",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Whether discount is applied at entity level or item level",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "entity_level", "desc": "Apply discount to entire invoice total"},
                        <AllowedValueInfo>{"value": "item_level", "desc": "Apply discount at line item level"},
                    ),
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Customer-visible notes",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Notes that will be visible to the customer on each invoice",
                },
                "terms": <ActionOptionInfo>{
                    "display_name": "Terms & Conditions",
                    "short_desc": "Terms and conditions",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Terms and conditions for this recurring invoice",
                },
                "template_id": <ActionOptionInfo>{
                    "display_name": "Template",
                    "short_desc": "PDF template to use",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "ID of the PDF template to use for generated invoices",
                },
            },
        });

        # Update Recurring Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/update-recurring-invoice",
            "action": "update-recurring-invoice",
            "groups": "Recurring Invoices",
            "display_name": "Update Recurring Invoice",
            "short_desc": "Update an existing recurring invoice",
            "desc": "Update an existing recurring invoice profile",
            "action_code": DPAT_API,
            "get_output_type": AbstractDataProviderType sub () {
                return new ZohoInvoiceRecurringInvoiceDataType();
            },
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "recurring_invoice_id": <ActionOptionInfo>{
                    "display_name": "Recurring Invoice ID",
                    "short_desc": "The recurring invoice to update",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
                "payment_terms": <ActionOptionInfo>{
                    "display_name": "Payment Terms",
                    "short_desc": "Net payment terms in days",
                    "type": AbstractDataProviderTypeMap."*int",
                    "desc": "Net payment terms in days (e.g., Net 30, Net 60)",
                },
                "discount": <ActionOptionInfo>{
                    "display_name": "Discount",
                    "short_desc": "Discount amount or percentage",
                    "type": AbstractDataProviderTypeMap."*float",
                    "desc": "Discount amount or percentage to apply to the invoice",
                },
                "discount_type": <ActionOptionInfo>{
                    "display_name": "Discount Type",
                    "short_desc": "How discount is applied",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Whether discount is applied at entity level or item level",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "entity_level", "desc": "Apply discount to entire invoice total"},
                        <AllowedValueInfo>{"value": "item_level", "desc": "Apply discount at line item level"},
                    ),
                },
                "notes": <ActionOptionInfo>{
                    "display_name": "Notes",
                    "short_desc": "Customer-visible notes",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Notes that will be visible to the customer on each invoice",
                },
                "terms": <ActionOptionInfo>{
                    "display_name": "Terms & Conditions",
                    "short_desc": "Terms and conditions",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "Terms and conditions for this recurring invoice",
                },
                "template_id": <ActionOptionInfo>{
                    "display_name": "Template",
                    "short_desc": "PDF template to use",
                    "type": AbstractDataProviderTypeMap."*string",
                    "desc": "ID of the PDF template to use for generated invoices",
                },
            },
        });

        # Get Recurring Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/recurring-invoices",
            "action": "get-recurring-invoice",
            "groups": "Recurring Invoices",
            "display_name": "Get Recurring Invoice",
            "short_desc": "Get recurring invoice details",
            "desc": "Retrieve details of a specific recurring invoice",
            "action_code": DPAT_FIND_SINGLE,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "recurring_invoice_id": <ActionOptionInfo>{
                    "display_name": "Recurring Invoice ID",
                    "short_desc": "The recurring invoice to retrieve",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                },
            },
        });

        # List Recurring Invoices
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/recurring-invoices",
            "action": "list-recurring-invoices",
            "groups": "Recurring Invoices",
            "display_name": "List Recurring Invoices",
            "short_desc": "List all recurring invoices",
            "desc": "Retrieve a list of recurring invoices",
            "action_code": DPAT_FIND,
            "options": {
                "organization_id": <ActionOptionInfo>{
                    "display_name": "Organization",
                    "short_desc": "Zoho Invoice organization",
                    "type": AbstractDataProviderTypeMap."string",
                    "required": True,
                    "preselected": True,
                    "ref_data": "organizations",
                },
                "customer_id": <ActionOptionInfo>{
                    "display_name": "Customer",
                    "short_desc": "Filter by customer",
                    "type": AbstractDataProviderTypeMap."*string",
                    "ref_data": "customers",
                },
            },
        });

        # Mark Recurring Invoice
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ZohoInvoiceDataProvider::AppName,
            "path": "/mark-recurring-invoice",
