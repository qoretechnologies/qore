# minimum required Qore version
%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires ml

module DataProviderML {
    version = "1.1.0";
    desc = "user module providing ML-based data pipeline processors wrapping the ml binary module";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the ML processors data provider factory
        DataProvider::registerFactory(new MLProcessorsDataProviderFactory());

        # register the ML Analytics app
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": MLApp::AppName,
            "display_name": "ML Analytics",
            "short_desc": "Analyze data with machine learning algorithms",
            "desc": "Catch fraud, forecast sales, segment customers, and simplify complex "
                "data — all in your data pipeline without external dependencies. Includes "
                "anomaly detection (flag unusual transactions or sensor failures), clustering "
                "(discover customer segments or geographic hotspots), forecasting (predict "
                "revenue with seasonal patterns), regression (estimate prices from features), "
                "and dimensionality reduction (compress 50 fields to 3 key values).",
            "logo": MLApp::MLLogo,
            "logo_file_name": "Qore-Q-square.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (AppGroup::Analytics,),
        });

        # register isolation-forest action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/isolation-forest",
            "action": "isolation-forest",
            "display_name": "Detect Unusual Data Points",
            "short_desc": "Finds anomalies by isolating unusual records from normal ones",
            "desc": "Catches fraudulent transactions, sensor malfunctions, and security "
                "intrusions by flagging records that stand out from normal data. For example, "
                "a $50,000 transaction when most are under $500 scores near `1.0` (highly "
                "anomalous), while a typical $45 purchase scores near `0.0`.\n\n"
                "Records accumulate in a window; when full, all are scored together. Each "
                "record receives:\n"
                "- `anomaly_score` — `0.0` (normal) to `1.0` (highly unusual)\n"
                "- `is_anomaly` — `True`/`False` based on the threshold",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProviderML::QoreIsolationForestProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreIsolationForestProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreIsolationForestProcessor::ConstructorOptions{
                    "n_trees", "sample_size", "threshold",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register dbscan-clustering action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/dbscan-clustering",
            "action": "dbscan-clustering",
            "display_name": "Find Natural Groups in Data",
            "short_desc": "Discovers groups based on data density without specifying how many",
            "desc": "Discovers delivery zones, support ticket themes, or network traffic "
                "hotspots by automatically finding natural groups in data — without needing "
                "to specify how many groups exist. For example, given GPS coordinates of 5,000 "
                "deliveries, it might find 12 distinct delivery zones of varying shapes, plus "
                "label scattered outlier locations as noise.\n\n"
                "Records accumulate in a window; when full, all are clustered. Each record "
                "receives:\n"
                "- `cluster` — group number, or `-1` for noise\n"
                "- `is_noise` — `True` if the record doesn't belong to any group",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProviderML::QoreDBSCANClusteringProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreDBSCANClusteringProcessor::ConstructorOptions{
                    "fields", "window_size", "epsilon",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreDBSCANClusteringProcessor::ConstructorOptions{"min_points", "metric"}, {
                    "loc": "constructor",
                }
            ),
        });

        # register kmeans-clustering action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/kmeans-clustering",
            "action": "kmeans-clustering",
            "display_name": "Divide Data into Groups",
            "short_desc": "Assigns each record to one of a specified number of groups",
            "desc": "Segments customers into spending tiers, classifies products into price "
                "categories, or groups sensor readings into operational modes. You specify how "
                "many groups you want (e.g., `k=5` for 5 customer tiers), and the algorithm "
                "finds the best grouping. Supports incremental learning: once 10,000 customers "
                "are segmented into 5 tiers, new batches refine the tiers without starting "
                "over.\n\n"
                "Records accumulate in a window; when full, all are grouped. Each record "
                "receives:\n"
                "- `cluster` — group number\n"
                "- `distance` — how far from the group center (large distances = borderline "
                "members)",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProviderML::QoreKMeansProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreKMeansProcessor::ConstructorOptions{"fields", "window_size", "k"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreKMeansProcessor::ConstructorOptions{"online",}, {
                    "loc": "constructor",
                }
            ),
        });

        # register pca action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/pca",
            "action": "pca",
            "display_name": "Simplify Complex Data",
            "short_desc": "Reduces many fields to fewer combined values preserving key patterns",
            "desc": "Simplifies complex data for visualization, noise removal, and faster "
                "downstream analysis by compressing many fields into fewer meaningful values. "
                "For example, 50 sensor readings per machine can be reduced to 3 combined "
                "values that capture 95%% of the variance — making it practical to plot "
                "equipment health on a single chart.\n\n"
                "Records accumulate in a window; when full, all are transformed. Each record "
                "receives:\n"
                "- `pc1`, `pc2`, ... — principal component values\n"
                "- `explained_variance` — how much information is retained",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProviderML::QorePCAProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QorePCAProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QorePCAProcessor::ConstructorOptions{"n_components", "variance_threshold"}, {
                    "loc": "constructor",
                }
            ),
        });

        # register holt-winters action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/holt-winters",
            "action": "holt-winters",
            "display_name": "Forecast Future Values",
            "short_desc": "Predicts future values accounting for trends and seasonal patterns",
            "desc": "Forecasts monthly revenue, daily server load, or weekly inventory needs "
                "by learning trends and seasonal patterns from historical data. For example, "
                "with `period=12` (monthly data), it learns that revenue peaks every December "
                "and grows 5%% annually, then forecasts next month's value. After an initial "
                "learning period of 2 x `period` records, each new record produces a "
                "forecast.\n\n"
                "Each record receives:\n"
                "- `forecast` — predicted next value\n"
                "- `trend` — long-term direction\n"
                "- `seasonal` — cyclical component",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProviderML::QoreHoltWintersProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreHoltWintersProcessor::ConstructorOptions{"fields", "window_size", "period"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreHoltWintersProcessor::ConstructorOptions{
                    "alpha", "beta", "gamma", "forecast_steps",
                    "seasonal_type", "damped", "phi",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register linear-regression action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/linear-regression",
            "action": "linear-regression",
            "display_name": "Predict Values from Input Data",
            "short_desc": "Learns a formula to predict a target value from input fields",
            "desc": "Predicts property prices from square footage and location, estimates "
                "delivery times from distance and package weight, or forecasts demand from "
                "advertising spend — by learning the best straight-line relationship between "
                "input fields and a target value.\n\n"
                "Records accumulate in a window; when full, the model learns and produces "
                "predictions. Each record receives:\n"
                "- `prediction` — estimated target value\n"
                "- `r_squared` — model accuracy (e.g., `0.92` means 92%% of variance "
                "explained)\n"
                "- `coefficients` — how much each input matters",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProviderML::QoreLinearRegressionProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreLinearRegressionProcessor::ConstructorOptions{
                    "fields", "target_field", "window_size",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreLinearRegressionProcessor::ConstructorOptions{
                    "fit_intercept", "normalize",
                }, {
                    "loc": "constructor",
                }
            ),
        });

        # register lof action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/lof",
            "action": "lof",
            "display_name": "Detect Local Outliers",
            "short_desc": "Finds points that are unusual compared to their neighbors",
            "desc": "Finds transactions that are unusual for a specific customer segment, or "
                "sensor readings that are anomalous for a particular equipment type — even "
                "when they look normal across all data. For example, a $200 purchase is "
                "normal for premium customers but suspicious for budget customers; LOF "
                "catches this by comparing each point's density to its neighbors.\n\n"
                "Records accumulate in a window; when full, all are scored. Each record "
                "receives:\n"
                "- `lof_score` — `1.0` = normal, higher = more unusual\n"
                "- `is_anomaly` — `True`/`False` based on the threshold",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProviderML::QoreLOFProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreLOFProcessor::ConstructorOptions{"fields", "window_size"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreLOFProcessor::ConstructorOptions{"k", "threshold"}, {
                    "loc": "constructor",
                }
            ),
        });

        # register gmm action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/gmm",
            "action": "gmm",
            "display_name": "Group Data with Probabilities",
            "short_desc": "Assigns each record to groups with probability scores",
            "desc": "Identifies overlapping customer segments, classifies data with genuine "
                "uncertainty, or detects mixed populations — where each record gets a "
                "probability for each group rather than a hard assignment. For example, a "
                "customer might be 70%% 'budget shopper' and 30%% 'impulse buyer,' reflecting "
                "real overlap.\n\n"
                "Records accumulate in a window; when full, all are grouped with "
                "probabilities. Each record receives:\n"
                "- `cluster` — most likely group\n"
                "- `max_probability` — confidence (e.g., `0.70`)\n"
                "- `probabilities` — full breakdown for all groups",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_AGGREGATE,
            "cls": "DataProviderML::QoreGMMProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreGMMProcessor::ConstructorOptions{
                    "fields", "window_size", "n_components",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreGMMProcessor::ConstructorOptions{"covariance_type",}, {
                    "loc": "constructor",
                }
            ),
        });

        # register onnx-model action (only when ONNX Runtime is available)
        if (ML::ml_get_capabilities().has_onnx) {
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": MLApp::AppName,
                "path": "/onnx-model",
                "action": "onnx-model",
                "display_name": "Run Pre-Trained Model",
                "short_desc": "Runs a pre-trained ONNX model on data records",
                "desc": "Runs pre-trained neural networks, gradient-boosted models, or other "
                    "complex models trained in Python or R — without needing those tools "
                    "at runtime. For example, a credit scoring model trained in scikit-learn "
                    "can be exported to ONNX format and deployed here for real-time scoring "
                    "of loan applications. Records accumulate in a batch; when full, all are "
                    "passed through the model. Output fields depend on the specific model "
                    "(e.g., class probabilities, regression values, embeddings).",
                "action_code": DPAT_PIPELINE_PROCESSOR,
                "processor_capabilities": DPC_AGGREGATE,
                "cls": "DataProviderML::QoreOnnxModelProcessor",
                "groups": ("ML Analytics",),
                "options": DataProviderActionCatalog::getActionOptionFromFields(
                    QoreOnnxModelProcessor::ConstructorOptions{
                        "model_path", "fields", "window_size",
                    }, {
                        "preselected": True,
                        "required": True,
                        "loc": "constructor",
                    }
                ) + DataProviderActionCatalog::getActionOptionFromFields(
                    QoreOnnxModelProcessor::ConstructorOptions{
                        "input_tensor", "execution_providers",
                        "cuda_device_id", "intra_op_threads",
                        "inter_op_threads", "graph_optimization_level",
                        "log_severity",
                    }, {
                        "loc": "constructor",
                    }
                ),
            });
        }

        # register seasonal-decomposition action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/seasonal-decomposition",
            "action": "seasonal-decomposition",
            "display_name": "Separate Trends and Seasonal Patterns",
            "short_desc": "Breaks time series data into trend, seasonal, and leftover parts",
            "desc": "Answers 'is this increase real growth or just a seasonal spike?' by "
                "separating a time series into its component parts. For example, monthly sales "
                "of $120K might decompose into $100K trend + $25K seasonal holiday boost - "
                "$5K random dip.\n\n"
                "Records accumulate per field in a window; when full, all values are "
                "decomposed. Each record receives:\n"
                "- `trend` — long-term direction\n"
                "- `seasonal` — cyclical pattern (e.g., holiday shopping cycles)\n"
                "- `residual` — random noise remaining after removing trend and seasonal",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_ANALYTICS,
            "cls": "DataProviderML::QoreSeasonalDecompositionProcessor",
            "groups": ("ML Analytics",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                QoreSeasonalDecompositionProcessor::ConstructorOptions{
                    "fields", "window_size", "period",
                }, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                QoreSeasonalDecompositionProcessor::ConstructorOptions{"type",}, {
                    "loc": "constructor",
                }
            ),
        });
    };
}

/** @mainpage DataProviderML Module

    @tableofcontents

    @section dataprovidermlintro DataProviderML Module Introduction

    The %DataProviderML module brings machine learning to data pipelines, enabling automated
    detection of anomalies, discovery of natural groupings, forecasting of future values, and
    simplification of complex datasets — all without external dependencies like Python.

    These processors solve common business problems:
    - <b>Catch problems early</b>: flag fraudulent transactions, detect sensor malfunctions, or
      identify unusual user behavior before it causes damage
    - <b>Understand your data</b>: automatically discover customer segments, group related events,
      or classify data points with confidence scores
    - <b>Predict what's next</b>: forecast sales with seasonal patterns, estimate delivery times
      from order details, or predict prices from product features
    - <b>Simplify complexity</b>: compress dozens of sensor readings or feature columns into a
      handful of meaningful values for visualization or downstream analysis
    - <b>Explain what drives change</b>: separate long-term growth trends from seasonal cycles
      and random noise in any time series

    @section dataproviderml_whentouse When to Use Each Processor

    @subsection dataproviderml_anomaly Anomaly Detection — "Is this data point unusual?"

    - @ref DataProviderML::QoreIsolationForestProcessor "isolation-forest": best for catching
      <b>globally unusual</b> records across all your data — e.g., a transaction for \$50,000 when
      most are under \$500, or a temperature reading of 200°F in a room that's normally 70°F
    - @ref DataProviderML::QoreLOFProcessor "lof": best for catching records that are
      <b>unusual for their neighborhood</b> — e.g., a \$200 purchase is normal for premium
      customers but unusual for budget customers, or a 90°F reading is fine outdoors but
      anomalous in a server room

    @subsection dataproviderml_clustering Clustering — "What groups exist in my data?"

    - @ref DataProviderML::QoreDBSCANClusteringProcessor "dbscan-clustering": best when you
      <b>don't know how many groups</b> exist and groups may have irregular shapes — e.g.,
      identifying geographic delivery zones, finding clusters of related support tickets, or
      detecting hotspots in network traffic
    - @ref DataProviderML::QoreKMeansProcessor "kmeans-clustering": best when you <b>know how
      many segments</b> you want — e.g., segmenting 10,000 customers into 5 tiers by spending
      patterns, or classifying products into 3 price categories; supports online learning so
      segments update as new data arrives
    - @ref DataProviderML::QoreGMMProcessor "gmm": best when data points may <b>belong to
      multiple groups</b> — e.g., a customer might be 70%% "budget shopper" and 30%% "impulse
      buyer", or a transaction might be 60%% likely legitimate and 40%% suspicious

    @subsection dataproviderml_forecasting Forecasting and Prediction — "What happens next?"

    - @ref DataProviderML::QoreHoltWintersProcessor "holt-winters": best for <b>time series with
      seasonal patterns</b> — e.g., forecasting monthly revenue that peaks every December, predicting
      daily server load that spikes every Monday morning, or estimating weekly inventory needs
    - @ref DataProviderML::QoreLinearRegressionProcessor "linear-regression": best for
      <b>predicting a value from input features</b> — e.g., estimating a property's price from
      square footage and location, predicting delivery time from distance and package weight, or
      forecasting demand from advertising spend

    @subsection dataproviderml_analysis Data Analysis — "What's really going on in this data?"

    - @ref DataProviderML::QorePCAProcessor "pca": best for <b>simplifying high-dimensional
      data</b> — e.g., compressing 50 sensor readings into 3 combined values that capture 95%% of
      the information, or reducing 20 customer attributes to a few key factors for visualization
    - @ref DataProviderML::QoreSeasonalDecompositionProcessor "seasonal-decomposition": best
      for <b>understanding what drives a time series</b> — e.g., separating a sales curve into
      underlying growth trend, holiday shopping spikes, and random daily fluctuations
    - @ref DataProviderML::QoreOnnxModelProcessor "onnx-model": best for <b>running complex
      pre-trained models</b> — e.g., using a neural network trained in Python for image
      classification, or a gradient-boosted model for credit scoring, without needing Python at
      runtime (requires ONNX Runtime)

    @section dataproviderml_example Pipeline Example: Transaction Monitoring

    A typical pipeline might combine several processors to analyze incoming transactions:

    @code{.py}
# Step 1: Flag globally unusual transactions (isolation-forest)
#   Input: {"amount": 50000.0, "merchant_id": 42, "hour": 3, "country_code": 7}
#   Output adds: {"anomaly_score": 0.82, "is_anomaly": True}

# Step 2: Check if flagged transactions are unusual for their local context (lof)
#   Output adds: {"lof_score": 2.4, "is_local_outlier": True}

# Step 3: Segment transactions into behavior clusters (kmeans-clustering, k=4)
#   Output adds: {"cluster": 2, "distance": 0.15}

# Step 4: Forecast expected daily volume (holt-winters, period=7)
#   Output adds: {"forecast": 1250.0, "trend": 1180.0, "seasonal": 70.0}
    @endcode

    Each processor adds its output fields to the record, so downstream processors and business
    logic can combine anomaly scores, cluster assignments, and forecasts for comprehensive
    decision-making.

    @section dataproviderml_relnotes Release Notes

    @subsection dataproviderml_v1_1 DataProviderML v1.1
    - changed \c fields option type from \c string to \c softlist<string> for multi-select UI
      support; all processors accept both comma-separated strings and string lists for backward
      compatibility
    - added \c input_field_names marker to \c fields and \c target_field options for dynamic
      allowed value population from pipeline input types
    - all field-name-based options now support dot-notation for nested field access

    @subsection dataproviderml_v1_0 DataProviderML v1.0
    - initial release with 9 core ML pipeline processors and optional ONNX inference processor
*/

#! Contains all public definitions in the DataProviderML module
public namespace DataProviderML {
    #! Contains constants for the ML data pipeline processors app
    public namespace MLApp {
        #! The application name for the ML processors
        public const AppName = "ML-Analytics";
        #! Logo SVG data (ML-specific logo)
        public const MLLogo = File::readTextFile(get_script_dir() + "/ml-logo.svg");
    }

    #! Isolation Forest anomaly event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl IsolationForestAnomalyEventInfo {
        #! The type of analysis that produced this result (always "isolation-forest")
        string event_type = "isolation-forest";
        #! How unusual this data point is, from 0.0 (completely normal) to 1.0 (highly unusual)
        float anomaly_score;
        #! True if this record was flagged as an anomaly (its score met or exceeded the threshold)
        bool is_anomaly;
        #! How many steps the algorithm needed to isolate this data point; lower values mean the
        #! point was easier to separate from the rest, suggesting it is more unusual
        float average_path_length;
        #! The original input values for the fields that were analyzed
        hash<auto> record_values;
    }

    #! DBSCAN clustering event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl DBSCANClusteringEventInfo {
        #! The type of analysis that produced this result (always "dbscan-clustering")
        string event_type = "dbscan-clustering";
        #! The group number this record was assigned to (0, 1, 2, ...); -1 means the record
        #! did not fit into any group and was classified as noise
        int cluster;
        #! True if this record is at the center of a dense region and helped define a cluster;
        #! False if it is on the edge of a cluster or classified as noise
        bool is_core;
        #! How many other data points are close enough to this one to be considered neighbors
        int neighbor_count;
        #! The original input values for the fields that were analyzed
        hash<auto> record_values;
    }

    #! KMeans clustering event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl KMeansClusteringEventInfo {
        #! The type of analysis that produced this result (always "kmeans-clustering")
        string event_type = "kmeans-clustering";
        #! The group number this record was assigned to (0, 1, 2, ...)
        int cluster;
        #! How far this record is from the center of its assigned group; smaller values mean
        #! the record is a better fit for its group
        float distance;
        #! How far this record is from the center of each group; useful for seeing how
        #! close the record was to being assigned to a different group
        list<float> centroid_distances;
        #! The original input values for the fields that were analyzed
        hash<auto> record_values;
    }

    #! PCA event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl PCAEventInfo {
        #! The type of analysis that produced this result (always "pca")
        string event_type = "pca";
        #! The reduced set of combined values that summarize the original fields; each value
        #! represents a weighted combination of the input fields capturing a different pattern
        list<float> components;
        #! What fraction of the original information is preserved in the reduced output,
        #! from 0.0 (none) to 1.0 (all); for example, 0.95 means 95%% of the meaningful
        #! variation in the data is captured
        float total_explained_variance;
        #! The original input values for the fields that were analyzed
        hash<auto> record_values;
    }

    #! Holt-Winters forecast event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl HoltWintersForecastEventInfo inherits DataProvider::AnalyticsEventInfo {
        #! Predicted future value(s); one value per forecast step requested
        list<float> forecast;
        #! The current baseline value after removing trend and seasonal effects; represents
        #! the "average" level of the data at this point in time
        float level;
        #! The current rate of increase or decrease over time; positive means the data is
        #! trending upward, negative means it is trending downward
        float trend;
        #! The current seasonal effect at this point in the cycle; shows how much the
        #! seasonal pattern adds to or subtracts from the baseline level
        float seasonal;
        #! The difference between the actual observed value and what the model predicted;
        #! large residuals may indicate unexpected changes or anomalies
        float residual;
    }

    #! Linear regression event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl LinearRegressionEventInfo {
        #! The type of analysis that produced this result (always "linear-regression")
        string event_type = "linear-regression";
        #! The value the model predicted for the target field based on the input fields
        float prediction;
        #! The real observed value of the target field from the input record
        float actual;
        #! The difference between the actual value and the prediction (actual minus predicted);
        #! large residuals indicate the model's prediction was far from reality
        float residual;
        #! How well the model fits the data, from 0.0 (no predictive power) to 1.0 (perfect
        #! predictions); for example, 0.85 means the model explains 85%% of the variation in
        #! the target field
        float r_squared;
        #! The weight (importance) the model assigns to each input field, in the same order as
        #! the input fields were specified; larger absolute values mean that field has more
        #! influence on the prediction
        list<float> coefficients;
        #! The model's baseline prediction when all input fields are zero; this is the starting
        #! point to which the weighted input field values are added
        float intercept;
        #! The original input values for the fields that were analyzed
        hash<auto> record_values;
    }

    #! LOF anomaly event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl LOFAnomalyEventInfo {
        #! The type of analysis that produced this result (always "lof")
        string event_type = "lof";
        #! How unusual this data point is compared to its neighbors; a score near 1.0 means
        #! it is similar to its neighbors (normal); scores significantly above 1.0 mean it is
        #! in a sparser region than its neighbors (unusual)
        float lof_score;
        #! True if this record was flagged as an anomaly (its score met or exceeded the threshold)
        bool is_anomaly;
        #! How far away the nearest group of neighbors is; larger values mean this data point
        #! is more isolated from other data points
        float k_distance;
        #! The original input values for the fields that were analyzed
        hash<auto> record_values;
    }

    #! GMM clustering event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl GMMClusteringEventInfo {
        #! The type of analysis that produced this result (always "gmm")
        string event_type = "gmm";
        #! The most likely group number for this record (0, 1, 2, ...)
        int cluster;
        #! How confident the model is in the group assignment, from 0.0 (uncertain) to
        #! 1.0 (very confident); values near 0.5 with 2 groups indicate the record is
        #! between groups
        float max_probability;
        #! The probability that this record belongs to each group; for example, with 3
        #! groups the list might be (0.7, 0.2, 0.1) meaning 70%% chance of group 0,
        #! 20%% chance of group 1, and 10%% chance of group 2
        list<float> probabilities;
        #! A measure of how well this data point fits the overall model; more negative
        #! values indicate the point is less typical; useful for comparing how well
        #! different records fit the discovered groups
        float log_likelihood;
        #! The original input values for the fields that were analyzed
        hash<auto> record_values;
    }

    #! ONNX model inference event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl OnnxInferenceEventInfo {
        #! The type of analysis that produced this result (always "onnx-model")
        string event_type = "onnx-model";
        #! The file path of the ONNX model that was used for inference
        string model_path;
        #! The hardware backend used to run the model (e.g., "CPUExecutionProvider" for CPU
        #! or "CUDAExecutionProvider" for GPU acceleration)
        /** @since %DataProviderML 1.1
        */
        string execution_provider;
        #! The original input values for the fields that were fed into the model
        hash<auto> record_values;
        #! The model's output values; keys are the output names defined in the model and
        #! values are the corresponding results (e.g., predicted classes, probabilities,
        #! or regression values)
        hash<auto> model_output;
    }

    #! Seasonal decomposition event hashdecl
    /** @since %DataProviderML 1.0
    */
    public hashdecl SeasonalDecompositionEventInfo inherits DataProvider::AnalyticsEventInfo {
        #! The original data value before decomposition
        float observed;
        #! The long-term direction of the data (increasing, decreasing, or flat); may be
        #! NOTHING for the first and last few values in the window because the algorithm
        #! needs surrounding values to calculate the trend
        *float trend_value;
        #! The repeating cyclical pattern at this position in the cycle; shows how much the
        #! seasonal effect adds to (or subtracts from) the trend at this time point
        float seasonal_value;
        #! What remains after removing the trend and seasonal effects; large residuals may
        #! indicate unusual events or data quality issues; may be NOTHING at the edges of
        #! the window where the trend cannot be calculated
        *float residual_value;
        #! How the seasonal pattern is applied: "additive" means constant seasonal swings
        #! regardless of the data level; "multiplicative" means seasonal swings scale with
        #! the data level
        string decomposition_type;
        #! The number of data points in one complete seasonal cycle (e.g., 12 for monthly
        #! data with yearly patterns, 7 for daily data with weekly patterns)
        int period;
    }
}
