        # register schema-validation action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": MLApp::AppName,
            "path": "/schema-validation",
            "action": "schema-validation",
            "display_name": "Validate Record Schema",
            "short_desc": "Validates each record against a defined schema with configurable "
                "violation handling",
            "desc": "Validates each record against a user-defined schema specifying type "
                "constraints, required fields, value ranges, string length limits, and allowed "
                "values. Invalid records can be enriched with error details (default), silently "
                "dropped, or cause an exception.\n\n"
                "**Validation rules per field**:\n"
                "- `type` — expected type (string, int, float, bool, date)\n"
                "- `required` — field must be present and non-null\n"
                "- `min` / `max` — numeric value bounds\n"
                "- `min_length` / `max_length` — string length bounds\n"
                "- `allowed_values` — enumeration of valid values\n\n"
                "Each record passes through individually. In **enrich** mode, every record "
                "gets `_is_valid` (bool) and `_validation_errors` (list of strings).",
            "action_code": DPAT_PIPELINE_PROCESSOR,
            "processor_capabilities": DPC_TRANSFORM,
            "cls": "DataProviderML::QoreSchemaValidationProcessor",
            "groups": ("Data Governance",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
