    "PO_BROKEN_SPRINTF": <ParseOptionSourceText>{
        "display_name": "Legacy sprintf Handling",
        "desc": "Restores the pre-0.9 sprintf() format handling, where a missing argument was treated differently from NOTHING.",
    },
    "PO_DEFAULT": <ParseOptionSourceText>{
        "display_name": "Default",
        "desc": "No parse options; the value a Program container starts with when none are given.",
