    "PO_BROKEN_LOGIC_PRECEDENCE": <ParseOptionSourceText>{
        "display_name": "Legacy Logic Precedence",
        "desc": "Restores the pre-0.8.12 precedence of the logical and bitwise operators.",
    },
    "PO_BROKEN_LOOP_STATEMENT": <ParseOptionSourceText>{
        "display_name": "Legacy Loop Statement Handling",
        "desc": "Accepts \"break\" and \"continue\" outside a loop, as before 0.8.13.",
    },
    "PO_BROKEN_NAMESPACE_RESOLUTION": <ParseOptionSourceText>{
        "display_name": "Legacy Namespace Resolution",
        "desc": "Restores the legacy namespace resolution behavior.",
    },
    "PO_BROKEN_RANGE": <ParseOptionSourceText>{
        "display_name": "Legacy Range Handling",
        "desc": "Includes the upper limit in range() and xrange(), as before 0.9.5.",
    },
    "PO_BROKEN_REFERENCES": <ParseOptionSourceText>{
