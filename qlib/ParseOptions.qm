#! Verifies that the source-text table has exactly one entry per parse option
sub check_source_text() {
    if (SourceText.size() != Qore::ParseOptionStringMap.size()) {
        throw "PARSE-OPTION-ERROR", sprintf("ParseOptions::SourceText has %d entries, but Qore declares "
            "%d parse options; every declared option must have exactly one source-text entry",
            SourceText.size(), Qore::ParseOptionStringMap.size());
    }
}

#! Loads the translation catalog for a locale, or nothing when there is none to load
/** Discovery and catalog loading both touch the filesystem, and neither is worth failing a caller
    over: a description is presentation, and English is always a usable answer. Catalog failures
    therefore degrade to the English source; cancellation and program interruption still propagate.

    @param locale the requested BCP-47 locale, or @ref nothing for English

    @return the catalog for @a locale, or @ref nothing when the locale is English-or-unset, no
    catalog is installed for it, or the catalog could not be read
*/
*I18n::MessageCatalog sub get_catalog(*string locale) {
    if (!locale.val()) {
        return;
    }
    try {
        list<string> files = I18n::discover_catalog_files(CatalogDomain, locale);
        if (!files) {
            return;
        }
        # literal_messages: these are prose, not format strings; a brace in a description must stay
        # a brace instead of being read as a placeholder
        return new I18n::MessageCatalog(files, {"literal_messages": True});
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        return;
    }
}

#! Returns the translation of one message, or the English source when there is none
string sub localize(*I18n::MessageCatalog catalog, *string locale, string id, string source) {
    if (!catalog || !locale.val()) {
        return source;
    }
    try {
        return catalog.tc(id, source, locale);
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        return source;
    }
}

#! Assembles the description of one parse option
/** The identities -- the code, the parse directive, the functional domain -- are read from the
    %Qore library's own maps rather than restated, so they cannot disagree with the implementation.
*/
hash<ParseOptionInfo> sub make_info(string name, *I18n::MessageCatalog catalog, *string locale) {
    int code = Qore::ParseOptionStringMap{name};
    string key = code.toString();
    *hash<ParseOptionSourceText> text = SourceText{name};
    if (!text) {
        throw "PARSE-OPTION-ERROR", sprintf("parse option %y has no description in the "
            "ParseOptions module; every parse option Qore declares must have exactly one entry "
            "in ParseOptions::SourceText", name);
    }
    return <ParseOptionInfo>{
        "name": name,
        "code": code,
        "directive": Qore::ParseOptionCmdCodeMap{key},
        "display_name": localize(catalog, locale,
            sprintf("parse-option.%s.display_name", name), text.display_name),
        "desc": localize(catalog, locale, sprintf("parse-option.%s.desc", name), text.desc),
        "domain": Qore::DomainCodeMap{key},
    };
}

#! Returns information about every parse option, sorted by constant name
/** @param locale an optional BCP-47 locale; when present, @ref ParseOptionInfo::display_name and
    @ref ParseOptionInfo::desc are localized against the @ref ParseOptions::CatalogDomain catalog,
    falling back to English for any message with no translation

    @return information about every parse option %Qore declares, sorted by constant name

    @throw PARSE-OPTION-ERROR a parse option was added to %Qore without being described here; the
    module's test fails on the same condition, so this cannot reach a released build

    @throw THREAD-CANCELLED the calling thread was cancelled while loading or using a catalog

    @throw PROGRAM-INTERRUPTED the calling program was interrupted while loading or using a catalog

    @note the option list comes from the %Qore library itself, so it cannot fall out of step with
    the implementation

    @note a missing, unreadable, or incomplete catalog is not an error: the English source text is
    served instead, so a caller always receives usable text
*/
public list<hash<ParseOptionInfo>> sub get_parse_option_info(*string locale) {
    check_source_text();
    *I18n::MessageCatalog catalog = get_catalog(locale);
    list<hash<ParseOptionInfo>> rv = ();
    foreach string name in (sort(keys Qore::ParseOptionStringMap)) {
        rv += make_info(name, catalog, locale);
    }
    return rv;
}

#! Returns information about every parse option, keyed by constant name
/** @param locale an optional BCP-47 locale; see @ref get_parse_option_info()

    @return information about every parse option %Qore declares, keyed by constant name

    @throw PARSE-OPTION-ERROR a parse option was added to %Qore without being described here

    @throw THREAD-CANCELLED the calling thread was cancelled while loading or using a catalog

    @throw PROGRAM-INTERRUPTED the calling program was interrupted while loading or using a catalog
*/
public hash<string, hash<ParseOptionInfo>> sub get_parse_option_info_map(*string locale) {
    check_source_text();
    *I18n::MessageCatalog catalog = get_catalog(locale);
    hash<string, hash<ParseOptionInfo>> rv = {};
    foreach string name in (sort(keys Qore::ParseOptionStringMap)) {
        rv{name} = make_info(name, catalog, locale);
    }
    return rv;
}
}
