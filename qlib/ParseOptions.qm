# minimum Qore version
%requires qore >= 3.0

%modern

%requires i18n

module ParseOptions {
    version = "1.0";
    desc    = "user module describing Qore's parse options for user interfaces";
    author  = "David Nichols <david@qore.org>";
    url     = "http://qore.org";
    license = "MIT";
}

/** @mainpage ParseOptions Module

    @tableofcontents

    @section parseoptionsintro ParseOptions Module Introduction

    The %ParseOptions module describes %Qore's parse options: for each one, a display name and a
    description suitable for presenting to a person choosing parse options in a user interface.

    Applications that let a user configure parse options -- an IDE, a deployment tool, a
    configuration front end -- otherwise each carry their own copy of the list and their own
    wording for it, and every copy drifts from %Qore as options are added. This module is the one
    place that description lives, next to the implementation it describes.

    The list itself is never restated here: the option names and codes come from
    @ref Qore::ParseOptionStringMap, the parse directive names from
    @ref Qore::ParseOptionCmdCodeMap, and the functional domains from @ref Qore::DomainCodeMap, all
    of which the %Qore library generates from its own tables. Only the human-facing text is added,
    and the module's test asserts that every parse option the library declares has exactly one
    entry, so an option cannot be added to %Qore without being described here.

    @section parseoptionsusage Usage

    @code{.py}
%requires ParseOptions

# every parse option, sorted by constant name
list<hash<ParseOptionInfo>> l = get_parse_option_info();

# one option
hash<ParseOptionInfo> info = get_parse_option_info_map(){"PO_REQUIRE_TYPES"};
printf("%s: %s\n", info.display_name, info.desc);
    @endcode

    @section parseoptionsi18n Localization

    Both @ref ParseOptions::ParseOptionInfo::display_name and
    @ref ParseOptions::ParseOptionInfo::desc are localized when a
    locale is given:

    @code{.py}
list<hash<ParseOptionInfo>> l = get_parse_option_info("de-DE");
    @endcode

    Translations are looked up in the @ref ParseOptions::CatalogDomain catalog domain, under the
    message ids @c parse-option.PO_NAME.display_name and @c parse-option.PO_NAME.desc, where
    @c PO_NAME is the parse-option constant name, against the English source text as it appears in
    this module. A locale with no catalog, or a message with no translation, falls back to the
    English source, so a caller always receives usable text.

    Everything else in @ref ParseOptionInfo is an identity, not presentation: the constant name, the
    numeric code, the parse directive and the functional domain are protocol and are never
    translated.

    @section parseoptionsrelnotes Release Notes

    @subsection parseoptions_1_0 ParseOptions v1.0
    - initial release
*/

#! the ParseOptions namespace contains all the definitions in the ParseOptions module
public namespace ParseOptions {
#! Describes one %Qore parse option
public hashdecl ParseOptionInfo {
    #! The parse option constant name (ex: @c "PO_REQUIRE_TYPES")
    /** This is the name used by @ref Qore::ParseOptionStringMap and is the stable identity of the
        option; it is never localized.
    */
    string name;

    #! The parse option's bitfield code
    int code;

    #! The parse directive and command-line name (ex: @c "require-types"), if the option has one
    /** @ref nothing for options that can only be set programmatically, and for composite options
        that the parse-directive table does not name.
    */
    *string directive;

    #! A short display name for the option (ex: @c "Require Types")
    /** Localized when a locale is given; English otherwise.
    */
    string display_name;

    #! A description of what the option does
    /** Localized when a locale is given; English otherwise.
    */
    string desc;

    #! The functional domain the option restricts (ex: @c "NETWORK"), if any
    /** @ref nothing for options that do not restrict a functional domain. Never localized: this is
        the domain's protocol name, as used by @ref Qore::DomainStringMap.
    */
    *string domain;
}

#! English presentation text for one parse option
hashdecl ParseOptionSourceText {
    string display_name;
    string desc;
}

#! The i18n catalog domain holding translations of the text in this module
public const CatalogDomain = "qore.parse-options";

#! English source text for every parse option, keyed by parse option constant name
/** The list itself is never restated here -- it comes from @ref Qore::ParseOptionStringMap -- so a
    parse option added to %Qore without an entry in this table is a test failure rather than a
    silently undescribed option.

    This is the source text every translation is made from, and the text served when a locale has
    no catalog.
*/
const hash<string, hash<ParseOptionSourceText>> SourceText = {
    "PO_ALLOW_BARE_REFS": <ParseOptionSourceText>{
        "display_name": "Bare References",
        "desc": "Requires bare references: the \"$\" character may not be used in variable names, method calls, or object member references. Set implicitly by %new-style.",
    },
    "PO_ALLOW_DEBUGGER": <ParseOptionSourceText>{
        "display_name": "Allow Debugger",
        "desc": "Allows debugging actions that could be insecure, such as reading the thread-local variable stack; required by the Breakpoint, DebugProgram, and ProgramControl classes.",
    },
    "PO_ALLOW_INJECTION": <ParseOptionSourceText>{
        "display_name": "Allow Injection",
        "desc": "Allows code and dependency injection into the Program container.",
    },
    "PO_ALLOW_REPARSE": <ParseOptionSourceText>{
        "display_name": "Allow Reparse",
        "desc": "Allows the Program container to be parsed more than once.",
    },
    "PO_ALLOW_RETURNS": <ParseOptionSourceText>{
        "display_name": "Allow returns Keyword",
        "desc": "Allows the deprecated \"returns\" keyword to be used in declarations.",
    },
    "PO_ALLOW_STATEMENT_NO_EFFECT": <ParseOptionSourceText>{
        "display_name": "Allow Statements With No Effect",
        "desc": "Accepts expression statements that can have no effect, which are otherwise a parse error.",
    },
    "PO_ALLOW_WEAK_REFERENCES": <ParseOptionSourceText>{
        "display_name": "Allow Weak References",
        "desc": "Allows the weak assignment operator (:=) to be used.",
    },
    "PO_ASSUME_LOCAL": <ParseOptionSourceText>{
        "display_name": "Assume Local Variable Scope",
        "desc": "Gives a variable local scope when it is first referenced without \"my\" or \"our\". Set implicitly by %new-style.",
    },
    "PO_BROKEN_CAST": <ParseOptionSourceText>{
        "display_name": "Legacy Cast Handling",
        "desc": "Restores the pre-0.9.4 cast<> behavior, where NOTHING was accepted without an error.",
    },
    "PO_BROKEN_ELLIPSES": <ParseOptionSourceText>{
        "display_name": "Legacy Varargs Handling",
        "desc": "Restores the pre-1.17 behavior of assuming varargs for every abstract method.",
    },
    "PO_BROKEN_LIST_PARSING": <ParseOptionSourceText>{
        "display_name": "Legacy List Parsing",
        "desc": "Restores the pre-0.8.12 list parsing, where certain lists without parentheses were rewritten to make top-level statements such as \"list l = 1, 2, 3;\" valid.",
    },
    "PO_BROKEN_LIST_RANGE": <ParseOptionSourceText>{
        "display_name": "Legacy List Range",
        "desc": "Restores the pre-2.0 behavior of the list range operator.",
