# minimum required Qore version
%requires qore >= 2.0
%modern

%requires(reexport) QoreLlmUtils
%requires json

module QoreStructuredExtraction {
    version = "1.0.0";
    desc = "user module providing LLM-based structured information extraction "
        "with schema enforcement and built-in templates for NER, invoices, "
        "contacts, and sentiment analysis";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
    # the extraction pipeline starts threads for its callers (qorus#867)
    domains = "THREAD_CONTROL";
}

/** @mainpage QoreStructuredExtraction Module

    @tableofcontents

    @section qorestructuredextractionintro QoreStructuredExtraction Module Introduction

    The %QoreStructuredExtraction module extracts typed structured data from unstructured
    text using LLM calls with JSON schema enforcement.  Named Entity Recognition
    (NER) — finding people, organizations, locations, and dates in text — is a
    special case.

    Use this module when you need to pull structured fields from free-text
    documents — for example, extracting invoice numbers from scanned invoices,
    contact details from emails, or sentiment scores from customer reviews.

    The module provides:
    - @ref QoreStructuredExtraction::ExtractionSchema "ExtractionSchema" — schema types
      and built-in templates (NER, Invoice, Contact, Sentiment)
    - @ref QoreStructuredExtraction::ExtractionPipeline "ExtractionPipeline" — core
      extraction engine with validation and retry logic

    @par Example: Named Entity Recognition
    @code{.py}
%requires QoreStructuredExtraction
%modern
%requires QoreLlmUtils

LlmBackend llm(<LlmBackendConfig>{"mode": "http", "url": "http://localhost:8080",
    "model": "gpt-4o"});
ExtractionPipeline pipeline(llm, ExtractionSchema::NerSchema);
hash<ExtractionResult> result = pipeline.extractData("John Smith works at Acme Corp in New York.");
if (result.valid) {
    foreach hash<auto> entity in (result.extracted.entities) {
        printf("%s: %s (%.0f%%)\n", entity.entity_type, entity.text,
            entity.confidence * 100);
    }
}
    @endcode

    @section qorestructuredextractionsandbox QoreStructuredExtraction Module in Sandboxed Programs

    The @ref QoreStructuredExtraction::ExtractionPipeline "ExtractionPipeline" class starts threads for parallel batch extraction (the \c batch_parallel option of
    @ref QoreStructuredExtraction::ExtractionPipelineOptions "ExtractionPipelineOptions").  The module declares the
    \c THREAD_CONTROL @ref function_domains "functional domain" in its module header, so when it is loaded from the
    module path, it starts its threads also for a @ref Qore::Program "Program" with
    @ref Qore::PO_NO_THREAD_CONTROL set; the threads run under the caller's sandbox, whose thread limit bounds them.
    Loading the module source outside the module path requires thread control at parse time.

    - \c start_thread: an optional @ref closure "closure" or @ref call_reference "call reference" that accepts a
      zero-arg code reference and returns the integer thread ID of the new thread; without it, the \c start_thread
      capability that a host sets for the code it runs (@ref Qore::Thread::ThreadCapabilityScope
      "ThreadCapabilityScope") is used, and otherwise the @ref background operator

    When \c batch_parallel is 1, no threads are started and the option is ignored.

    @par Example: Sandboxed parallel extraction
    @code{.py}
Program sandbox(PO_NEW_STYLE | PO_NO_THREAD_CONTROL);
sandbox.loadModule("QoreStructuredExtraction");
code<int(code<nothing()>)> starter = int sub (code<nothing()> body) {
    return background body();
};
ExtractionPipeline pipeline(llm, ExtractionSchema::NerSchema,
    <ExtractionPipelineOptions>{
        "batch_parallel": 4,
        "start_thread": starter,
    });
    @endcode

    @section qorestructuredextractionrelnotes QoreStructuredExtraction Module Release Notes

    @subsection qorestructuredextraction_1_0 QoreStructuredExtraction Module Version 1.0
    - initial release
*/
