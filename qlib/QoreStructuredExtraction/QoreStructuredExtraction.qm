# minimum required Qore version
%requires qore >= 2.0
%modern

%requires(reexport) QoreLlmUtils
%requires json

module QoreStructuredExtraction {
    version = "1.0.0";
    desc = "user module providing LLM-based structured information extraction "
        "with schema enforcement and built-in templates for NER, invoices, "
        "contacts, and sentiment analysis";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage QoreStructuredExtraction Module

    @tableofcontents

    @section qorestructuredextractionintro QoreStructuredExtraction Module Introduction

    The %QoreStructuredExtraction module extracts typed structured data from unstructured
    text using LLM calls with JSON schema enforcement.  Named entity recognition (NER)
    is a special case.

    The module provides:
    - @ref QoreStructuredExtraction::ExtractionSchema "ExtractionSchema" — schema types
      and built-in templates (NER, Invoice, Contact, Sentiment)
    - @ref QoreStructuredExtraction::ExtractionPipeline "ExtractionPipeline" — core
      extraction engine with validation and retry logic

    @par Example: Named Entity Recognition
    @code{.py}
%requires QoreStructuredExtraction
%requires QoreLlmUtils

LlmBackend llm(<LlmBackendConfig>{"mode": "http", "url": "http://localhost:8080",
    "model": "gpt-4o"});
ExtractionPipeline pipeline(llm, ExtractionSchema::NerSchema);
hash<ExtractionResult> result = pipeline.extractData("John Smith works at Acme Corp in New York.");
if (result.valid) {
    foreach hash<auto> entity in (result.extracted.entities) {
        printf("%s: %s (%.0f%%)\n", entity.entity_type, entity.text,
            entity.confidence * 100);
    }
}
    @endcode

    @section qorestructuredextractionrelnotes QoreStructuredExtraction Module Release Notes

    @subsection qorestructuredextraction_1_0 QoreStructuredExtraction Module Version 1.0
    - Initial release with @ref QoreStructuredExtraction::ExtractionPipeline "ExtractionPipeline"
      and four built-in templates: NER, Invoice, Contact, Sentiment
*/
