# minimum qore version
%requires qore >= 2.0

# require type definitions everywhere

# enable all warnings

# don't use "$" for vars, members, and methods, assume local variable scope
%modern

# do not ignore argument errors

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4

module CdsRestClient {
    version = "2.2";
    desc = "user module for calling Microsoft Dynamics 365 Common Data Service REST services";
    author = "David Nichols <david@qore.org>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("cdsrests", CdsRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("dynamics", DynamicsRestConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("bcrests", BusinessCentralRestConnection::ConnectionScheme);
    };
}

/** @mainpage CdsRestClient Module

    @tableofcontents

    @section cdsrestclientintro CdsRestClient Introduction

    The %CdsRestClient module provides an API for calling Microsoft Dynamics 365 Common Data Service REST services.

    To use this module, use \c "%requires CdsRestClient" in your code.

    All the public symbols in the module are defined in the CdsRestClient namespace.

    The main classes are:
    - @ref CdsRestClient::CdsRestClient "CdsRestClient":
      this class provides the REST client API for communuication with the Microsoft Dynamics 365 Common Data Service REST
      API; it also automates authentication and authorization to the target
    - @ref CdsRestClient::CdsRestConnection "CdsRestConnection":
      provides a REST connection object to a Microsoft Dynamics 365 Common Data Service server (based on the
      @ref connectionproviderintro "ConnectionProvider" module)

    @par Example:
    @code{.py}
#!/usr/bin/env qore

%modern

%requires CdsRestClient

hash<auto> opts = {
    "url": "https://my-instance.crm2.dynamics.com",
    "oauth2_client_id": "30e61334-15db-4171-a752-b7c70dca1ebb",
    "oauth2_client_secret": "M09tfOc&NoEP(XCEKkT:T&V<lKR%+=h9hw",
};

CdsRestClient rest(opts);
hash<auto> ans = rest.get("...");
printf("%Y\n", ans.body);
    @endcode

    @section cdsrestclient_discovery Creating a Dynamics Connection Without a URL

    A Dataverse environment's URL is not something a user should have to look up, and it is not knowable
    before the credential exists: **which environments a credential reaches is what Microsoft answers**,
    through the Global Discovery Service.  So a Dynamics connection is created against the discovery
    service and moves to its environment once it has been authorized.

    |!Step|!What happens
    |the connection is created|with no URL, so it targets the discovery service (\c DefaultUrl)
    |it is authorized|the discovery service is an OAuth2 resource of its own, so the profile's <tt>{url}user_impersonation</tt> scope resolves to exactly the scope the discovery call needs - there is no special case
    |the token arrives|the environments the credential reaches are read from <tt>/api/discovery/v2.0/Instances</tt>
    |the environment is chosen|where there is one, it is used; where there are several, \c organization names it
    |the URL is replaced|the environment's URL is returned as an option and promoted onto the connection, and the scope is resolved again against it

    The scheme declares \c auto_url, so nothing asks
    the user for a URL.

    @note **No environment is ever chosen arbitrarily.**  A credential that reaches several environments
    and names none leaves the connection on the discovery service, because connecting to whichever came
    back first would read a different company's data without saying so.  \c organization is not a required
    option either: requiring a value that only the authorization can produce makes the connection
    impossible to create in the first place.

    The discovery runs on all three hooks that can complete an authorization - the connection's
    \c processOAuth2TokenResponseImpl(), which is
    the path a real user goes through, and each client's own \c getUpdateOptionsAfterLogin() - because
    different callers use different ones.  It runs only while the connection still targets the discovery
    service, so an environment that has already been chosen is left alone and a token refresh does not pay
    for the call again, and a failed discovery never breaks an otherwise successful authorization.

    @section cdsrestclientrelnotes Release Notes

    @subsection cdsrestclientv2_2 CdsRestClient v2.2
    - a Dynamics connection is created without a URL and discovers its environment from the credential;
      see @ref cdsrestclient_discovery
    - an API profile's scopes are resolved against the connection URL again when the URL changes, so a
      connection moved to another environment no longer authorizes against the old one

    @subsection cdsrestclientv2_1 CdsRestClient v2.1
    - added support for Microsoft Dynamics 365 Business Central
      - new \c BusinessCentralRestConnection class for BC connections
      - API profile support for BC-specific URL construction and OAuth2 scopes
      - new \c bcrests connection scheme

    @subsection cdsrestclientv2_0 CdsRestClient v2.0
    - updated to use the OAuth2 infrastructure

    @subsection cdsrestclientv1_0 CdsRestClient v1.0
    - the initial version of the %CdsRestClient module
*/

#! the CdsRestClient namespace contains all the objects in the CdsRestClient module
public namespace CdsRestClient {
#! API profile definition for Microsoft Dynamics platforms
/** Contains all platform-specific configuration values for Dynamics 365 and Business Central
*/
public hashdecl CdsApiProfile {
    #! Profile identifier (e.g., "dynamics", "dynamics-business-central")
    string name;

    #! Display name for the platform
    string display_name;

    #! Default API version for this platform
    string default_api_version;

    #! Default base URI (NOTHING for Dynamics where user provides URL, fixed for BC)
    *string default_base_uri;

    #! URI path prefix format (e.g., "/api/data/v" for Dynamics, "" for BC where path is in URL)
    string uri_path_prefix;

    #! Whether instance_type option is required
    bool requires_instance_type;

    #! OAuth2 scopes (may contain {url} placeholder for dynamic substitution)
    list<string> oauth2_scopes;

    #! Ping method for connection testing
    string ping_method;

    #! Ping path for connection testing (may contain {api_uri_path} placeholder)
    string ping_path;

    #! Ping headers for connection testing
    hash<auto> ping_headers;

    #! Connection scheme identifier
    string connection_scheme;

    #! Application name for data provider action catalog
    string app_name;
}

#! Microsoft Dynamics 365 CRM/CDS API profile
public const DynamicsProfile = <CdsApiProfile>{
    "name": "dynamics",
    "display_name": "Microsoft Dynamics 365",
    "default_api_version": "9.2",
    "uri_path_prefix": "/api/data/v",
    "requires_instance_type": False,
    "oauth2_scopes": (
        "offline_access",
        "{url}user_impersonation",
    ),
    "ping_method": "GET",
    "ping_path": "{api_uri_path}/WhoAmI",
    "ping_headers": {
        "Accept": MimeTypeJson,
    },
    "connection_scheme": "cdsrests",
    "app_name": "Dynamics",
};

#! Microsoft Dynamics 365 Business Central API profile
public const BusinessCentralProfile = <CdsApiProfile>{
    "name": "dynamics-business-central",
    "display_name": "Microsoft Dynamics 365 Business Central",
    "default_api_version": "v2.0",
    "default_base_uri": "https://api.businesscentral.dynamics.com/",
    "uri_path_prefix": "",
    "requires_instance_type": True,
    "oauth2_scopes": (
        "https://api.businesscentral.dynamics.com/user_impersonation",
        "https://api.businesscentral.dynamics.com/Financials.ReadWrite.All",
        "offline_access",
    ),
    "ping_method": "GET",
    "ping_path": "companies?$top=1&$select=id",
    "ping_headers": {
        "Accept": MimeTypeJson,
    },
    "connection_scheme": "bcrests",
    "app_name": "BusinessCentral",
};

#! Map of profile names to profile definitions
public const ApiProfileMap = {
    "dynamics": DynamicsProfile,
    "dynamics-business-central": BusinessCentralProfile,
};

#! Common base class for CdsRestClient functionality
public class CdsRestClientBase {
    public {
        #! The placeholder an API profile's scopes use for the connection URL
        /** @see @ref resolveProfileScopes()

            @since CdsRestClient 1.1
        */
        const UrlPlaceholder = "{url}";

        #! The host of Microsoft's Global Discovery Service
        /** @see @ref cdsrestclient_discovery

            @since CdsRestClient 1.1
        */
        const GlobalDiscoveryHost = "globaldisco.crm.dynamics.com";

        #! The URL a Dynamics connection targets until it knows which environment it works in
        /** A Dataverse environment's URL is not something a user should have to look up, and it is not
            knowable before the credential exists: which environments a credential reaches is what the
            Global Discovery Service answers.  So a Dynamics connection is created against the discovery
            service and moves to its environment once it has been authorized.

            The discovery service is also an OAuth2 resource of its own, which is what makes this work
            without a special case: the profile's scope is <tt>{url}user_impersonation</tt>, and resolved
            against this URL it is exactly the scope the discovery call needs.

            @see @ref cdsrestclient_discovery

            @since CdsRestClient 1.1
        */
        const DefaultUrl = "dynamics://" + GlobalDiscoveryHost;

        #! The Global Discovery Service path listing the environments a credential reaches
        /** @since CdsRestClient 1.1
        */
        const DiscoveryInstancesPath = "/api/discovery/v2.0/Instances";

        #! OAuth2 base URL for Microsoft identity platform
        const OAuth2BaseUrl = "https://login.microsoftonline.com/";

        #! OAuth2 auth URI path suffix
        const OAuth2AuthUriPathSuffix = "/oauth2/v2.0/authorize";

        #! OAuth2 token URI path suffix
        const OAuth2TokenUriPathSuffix = "/oauth2/v2.0/token";

        #! Default OAuth2 auth URL (using "common" tenant)
        const OAuth2AuthUrl = sprintf("%scommon%s", OAuth2BaseUrl, OAuth2AuthUriPathSuffix);

        #! Default OAuth2 token URL (using "common" tenant)
        const OAuth2TokenUrl = sprintf("%scommon%s", OAuth2BaseUrl, OAuth2TokenUriPathSuffix);

        #! API profiles for backward compatibility
        /** @deprecated Use ApiProfileMap instead
        */
        const ApiProfiles = {
            "none": {},
            "dynamics": {
                "oauth2_scopes": DynamicsProfile.oauth2_scopes,
                "ping_method": DynamicsProfile.ping_method,
                "ping_path": DynamicsProfile.ping_path,
                "ping_headers": DynamicsProfile.ping_headers,
            },
            "dynamics-business-central": {
                "url": BusinessCentralProfile.default_base_uri,
                "oauth2_scopes": BusinessCentralProfile.oauth2_scopes,
                "ping_method": BusinessCentralProfile.ping_method,
                "ping_path": BusinessCentralProfile.ping_path,
                "ping_headers": BusinessCentralProfile.ping_headers,
            },
        };
    }

    #! throws an exception due to an error
    static raiseError(string fmt, ...) {
        throw "CDSRESTCLIENT-ERROR", vsprintf(fmt, argv);
    }

    #! returns options for the CdsRestClient constructors
    #! Returns @ref True if the given URL still targets the Global Discovery Service
    /** A connection targeting the discovery service has not been given an environment yet, which is what
        says the discovery is still to be done.

        @param url the URL to check

        @since CdsRestClient 1.1
    */
    static bool isDiscoveryUrl(*string url) {
        if (!url.val()) {
            return False;
        }
        # compared as a host rather than matched as a pattern, so that the dots in the host name are not
        # wildcards and a look-alike host cannot pass for the discovery service
        *list<*string> m = (url =~ x/^[a-z]+:\/\/([^\/:]+)/i);
        return m[0].lwr() == GlobalDiscoveryHost;
    }

    #! Asks the Global Discovery Service which environments a credential reaches
    /** @param token the access token to use; the one from the authorization response, not the client's,
        which may not have been updated yet
        @param org the environment to select, where the credential reaches more than one
        @param logger any logger to report the alternatives to

        @return the connection options to update, or @ref nothing when no environment could be chosen

        @see @ref cdsrestclient_discovery

        @since CdsRestClient 1.1
    */
    static *hash<auto> discoverInstanceOptions(string token, *string org, *LoggerInterface logger) {
        RestClientIo::RestClientIo rest({
            "url": "https://" + GlobalDiscoveryHost,
            "data": "json",
            "token": token,
            "token_type": "Bearer",
        });
        on_exit rest.close();

        hash<RestClient::RestResponseInfo> resp = rest.restDoRequest("GET", DiscoveryInstancesPath,
            NOTHING, {"Accept": MimeTypeJson});
        return CdsRestClientBase::getInstanceOptions(resp.body, org, logger);
    }

    #! Returns the connection options for the environment to work in
    /** With one environment there is nothing to choose.  With several, an arbitrary choice would silently
        connect to the wrong company's data, so one is made only when \c organization names it; otherwise
        the alternatives are logged and the connection is left targeting the discovery service, which is
        what says the choice has still to be made.

        @param body the Global Discovery Service response
        @param org the environment to select, by unique name, URL name or friendly name
        @param logger any logger to report the alternatives to

        @return the connection options to update, or @ref nothing when no environment could be chosen

        @since CdsRestClient 1.1
    */
    static *hash<auto> getInstanceOptions(auto body, *string org, *LoggerInterface logger) {
        *list<auto> instances = body.value;
        # an environment with no URL cannot be connected to whatever else it says
        instances = map $1, instances, $1.Url.val();
        if (!instances) {
            if (logger) {
                logger.error("Dynamics: the credential reaches no Dataverse environment");
            }
            return;
        }
        *hash<auto> instance;
        if (org.val()) {
            # an environment need not carry every name, so each is defaulted before it is compared
            string want = org.lwr();
            instance = (map $1, instances,
                ($1.UniqueName ?? "").lwr() == want || ($1.UrlName ?? "").lwr() == want
                    || ($1.FriendlyName ?? "").lwr() == want)[0];
            if (!instance) {
                # the choice named nothing that exists; connecting to another environment instead would
                # read a different company's data
                if (logger) {
                    logger.error("Dynamics: no environment named %y; reachable: %y", org,
                        (map $1.UniqueName, instances));
                }
                return;
            }
        } else if (instances.size() == 1) {
            instance = instances[0];
        } else {
            if (logger) {
                logger.info("Dynamics: the credential reaches %d environments: %y; set the "
                    "\"organization\" option to choose one", instances.size(),
                    (map $1.UniqueName, instances));
            }
            return;
        }
        if (logger) {
            logger.info("Dynamics: working in environment %y (%s)", instance.UniqueName, instance.Url);
        }
        return {
            # the connection's own scheme, not "https": this value is promoted onto the connection
            "url": regex_subst(instance.Url, "^https?", "dynamics"),
            "organization": instance.UniqueName,
        };
    }

    #! Discovers the environment after a client's own login, if it is still to be done
    /** Shared by the clients' login hooks, which differ only in their signatures.

        @param new_opts the options the base class returned
        @param h the token response
        @param url the client's current URL
        @param org the environment to select, where the credential reaches more than one
        @param logger any logger
        @param set_url called with the environment's URL, so that **this** client reaches it at once and
        not only the next one built from the options returned here; @ref nothing for the asynchronous
        client, whose URL is immutable by design because its connection manager pools by URL

        @return the options to update

        @see @ref cdsrestclient_discovery

        @since CdsRestClient 1.1
    */
    static *hash<auto> discoverAfterLogin(*hash<auto> new_opts, hash<auto> h, string url, *string org,
            *LoggerInterface logger, *code set_url) {
        if (!h.access_token.val() || !CdsRestClientBase::isDiscoveryUrl(url)) {
            return new_opts;
        }
        try {
            if (*hash<auto> inst = CdsRestClientBase::discoverInstanceOptions(h.access_token, org,
                    logger)) {
                new_opts += inst;
                if (set_url) {
                    set_url(regex_subst(inst.url, "^[a-z]+:", "https:"));
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            # a failed discovery must not break an otherwise successful authorization
            if (logger) {
                logger.error("Dynamics: cannot determine the environment to work in: %s: %s", ex.err,
                    ex.desc);
            }
        }
        return new_opts;
    }

    #! Resolves an API profile's scopes against the connection URL, re-resolving any that have gone stale
    /** A profile declares its scopes with a \c "{url}" placeholder - Dynamics 365 asks for
        <tt>{url}user_impersonation</tt> - and the placeholder is replaced with the connection URL, so the
        authorization request names the organisation being connected to.

        The resolved value is then **stored** with the connection, which is what makes a later URL change go
        wrong: the stored scope has the old URL baked into it and no placeholder left to substitute, so
        replacing \c "{url}" does nothing and the authorization request keeps naming the old organisation.
        Microsoft answers that with \c AADSTS500011, saying the resource principal was not found in the
        tenant - which is true, and says nothing about the URL being the reason.

        So a scope that has the **shape** of one of the profile's templates is resolved again against the
        current URL, rather than only an unresolved one.  A scope the caller added itself does not have that
        shape and is left exactly as it is.

        @param templates the profile's scopes, which may contain \c "{url}"
        @param scopes the scopes to resolve, which may already have been resolved against another URL
        @param url the connection URL; with none, the scopes are returned unchanged

        @return the scopes, resolved against \a url

        @since CdsRestClient 1.1
    */
    static list<string> resolveProfileScopes(*softlist<string> templates, *softlist<string> scopes,
            *string url) {
        # with no URL there is nothing to resolve against; the scopes are returned as they are rather than
        # the call failing, since a client may legitimately be built from options that carry no URL
        if (!url.val()) {
            return map $1, scopes;
        }
        list<string> rv = ();
        foreach string scope in (scopes) {
            rv += CdsRestClientBase::resolveProfileScope(templates, scope, url);
        }
        return rv;
    }

    #! Resolves one scope against the connection URL
    /** @param templates the profile's scopes, which may contain \c "{url}"
        @param scope the scope to resolve
        @param url the connection URL

        @return the scope, resolved against \a url if it was derived from a template, otherwise unchanged

        @see @ref resolveProfileScopes()

        @since CdsRestClient 1.1
    */
    static string resolveProfileScope(*softlist<string> templates, string scope, string url) {
        foreach string t in (templates) {
            int i = t.find(UrlPlaceholder);
            if (i < 0) {
                continue;
            }
            string prefix = t.substr(0, i);
            string suffix = t.substr(i + UrlPlaceholder.size());
            # what this template resolves to for the URL in hand
            string want = prefix + url + suffix;
            if (scope == want) {
                return scope;
            }
            # the same template resolved against some other URL: there is a URL between the template's
            # fixed parts, and it is not the current one
            if (scope.size() > prefix.size() + suffix.size()
                && (!prefix.val() || scope.substr(0, prefix.size()) == prefix)
                && (!suffix.val() || scope.substr(scope.size() - suffix.size()) == suffix)) {
                return want;
            }
        }
        return scope;
    }

    static hash<auto> getOptions(hash<auto> opts0) {
        # create an untyped hash to avoid type constraints from the input hash
        hash<auto> opts += opts0;
        if (*string prof = opts.api_profile) {
            *hash<CdsApiProfile> profile = ApiProfileMap{prof};
            if (profile) {
                # set ping options from profile if not already set
                if (!opts.hasKey("ping_method")) {
                    opts.ping_method = profile.ping_method;
                }
                if (!opts.hasKey("ping_path")) {
                    opts.ping_path = profile.ping_path;
                }
                if (!opts.hasKey("ping_headers")) {
                    opts.ping_headers = profile.ping_headers;
                }
                if (!opts.hasKey("oauth2_scopes")) {
                    opts.oauth2_scopes = profile.oauth2_scopes;
                }

                # For Business Central, build the full URL with instance_type and API path
                if (profile.default_base_uri && opts.instance_type) {
                    string api = opts.api ?? profile.default_api_version;
                    # Full URL: https://api.businesscentral.dynamics.com/v2.0/{instance_type}/api/v2.0/
                    opts.url = profile.default_base_uri + api + "/" + opts.instance_type + "/api/" + api + "/";
                }

                # resolve the profile's scopes against the URL; a scope already resolved against another
                # URL is resolved again, or a URL change would leave the old one in the scope
                opts.oauth2_scopes = CdsRestClientBase::resolveProfileScopes(profile.oauth2_scopes,
                    opts.oauth2_scopes, opts.url);
            } else if (prof != "none") {
                throw "CDS-RESTCLIENT-ERROR", sprintf("api_profile %y is unknown; known API profiles: %y", prof,
                    keys ApiProfileMap);
            }
        }
        if (opts.url !~ /\/$/) {
            opts.url += "/";
        }
        return opts + {
            "data": "json",
            "oauth2_auth_url": opts.oauth2_auth_url ?? "auto",
            "oauth2_token_url": opts.oauth2_token_url ?? "auto",
            "oauth2_grant_type": opts.oauth2_grant_type ?? "authorization_code",
            "oauth2_client_id": opts.oauth2_client_id,
            "oauth2_client_secret": opts.oauth2_client_secret,
        };
    }
}

#! this class provides the REST client API for communication with Microsoft Dynamics 365 Common Data Service servers
/** This class requires the following options for Microsoft Dynamics 365 Common Data Service authentication and
    authorization to the target server:
    - \c oauth2_client_id: the OAuth2 client ID
    - \c oauth2_client_secret: the OAuth2 client secret

    Errors returned from Dynamics will have the following format:
    - \c err: will be the hex error code from Dynamics (ex: \c 0x8006088a)
    - \c desc: the exception message (ex: <tt>Resource not found for the segment 'WhoAmi'.</tt>)
    - \c arg: the error hash from the server plus a \c decoded_body argument with any decoded message body
*/
public class CdsRestClient inherits RestClient::RestClient, CdsRestClientBase {

    private:internal {
        #! API version
        string api;
        #! URI path prefix for API calls
        string uri_path_pfx;
        #! API profile
        *string api_profile;
        #! API profile definition
        *hash<CdsApiProfile> profile;
        #! Instance type for Business Central (sandbox, production, or GUID)
        *string instance_type;
        #! Tenant ID for Business Central
        *string tenant;
    }

    #! creates the object with the given options
    /**
        @par Example:
        @code{.py}
CdsRestClient rest({
    "url": "https://my-instance.crm2.dynamics.com",
    "oauth2_client_id": oauth2_client_id,
    "oauth2_client_secret": oauth2_client_secret,
    "oauth2_grant_type": "client_credentials",
});
        @endcode

        @param opts valid options are the same as @ref RestClient::RestClient "RestClient" with the following
        differences:
        - \c api: the API version for CDS
        - \c api_profile: one of:
          - \c none (no options set)
          - \c dynamics (set client options for the MS Dynamics 365 API)
          - \c dynamics-business-central (set client options for the MS Dynamics 365 Business Central API)
        - \c instance_type: (required for Business Central) the BC instance type (sandbox, production, or GUID)
        - \c tenant: the Azure AD tenant ID
        - \c data: see @ref RestClient::RestClient::DataSerializationOptions "DataSerializationOptions" for possible
        values; the default is \c "json"
        - \c scope: the OAuth2 scope for the login; the default depends on the \c "api_profile" option
        @param do_not_connect if \c False (the default), then a connection will be immediately established to the
        remote server

        @throw RESTCLIENT-ERROR invalid option passed to constructor, unsupported data serialization, etc
        @throw CDSRESTCLIENT-ERROR missing or invalid required option for REST
        authentication or communication
    */
    constructor(hash<auto> opts, *softbool do_not_connect) : RestClient(CdsRestClientBase::getOptions(opts), True) {
        # check for the OAuth2 client id/secret options
        if (!oauth2_client_id || !oauth2_client_secret) {
            raiseError("missing the \"oauth2_client_id\" and \"oauth2_client_secret\" options");
        }

        api_profile = opts.api_profile;
        profile = ApiProfileMap{api_profile};
        tenant = getString(opts, "tenant") ?? "common";

        if (oauth2_token_url == "auto") {
            oauth2_token_url = OAuth2BaseUrl + tenant + OAuth2TokenUriPathSuffix;
        }
        if (oauth2_auth_url == "auto") {
            oauth2_auth_url = OAuth2BaseUrl + tenant + OAuth2AuthUriPathSuffix;
        }

        if (profile) {
            api = getString(opts, "api") ?? profile.default_api_version;
            if (profile.requires_instance_type) {
                instance_type = getString(opts, "instance_type");
                if (!instance_type) {
                    raiseError("missing the required \"instance_type\" option for %s", profile.display_name);
                }
            }
            uri_path_pfx = profile.uri_path_prefix;
            if (uri_path_pfx) {
                setConnectionPath(uri_path_pfx + api);
            }
        } else if (api_profile && api_profile != "none") {
            raiseError("unknown api_profile %y; known profiles: %y", api_profile, keys ApiProfileMap);
        } else {
            # No profile - use Dynamics defaults for backward compatibility
            api = getString(opts, "api") ?? DynamicsProfile.default_api_version;
            uri_path_pfx = DynamicsProfile.uri_path_prefix;
            setConnectionPath(uri_path_pfx + api);
        }

        if (!do_not_connect) {
            if (!token) {
                loginIntern();
            } else {
                connect();
            }
        }
    }

    #! returns the CDS REST API version currently in use
    string getApi() {
        return api;
    }

    #! Returns the API profile name in use
    *string getApiProfile() {
        return api_profile;
    }

    #! Returns the API profile definition in use
    *hash<CdsApiProfile> getProfile() {
        return profile;
    }

    #! Returns the Business Central instance type (only set for BC profile)
    *string getInstanceType() {
        return instance_type;
    }

    #! Returns the tenant ID
    *string getTenant() {
        return tenant;
    }

    #! Returns the URI path prefix
    string getUriPathPrefix() {
        return uri_path_pfx;
    }

    #! sends the outgoing HTTP message and recodes the response to data
    private hash<auto> sendAndDecodeResponse(*data body, string m, string path, hash<auto> hdr,
            *reference<hash<auto>> info, *softbool decode_errors, *string assume_content_type, *string shdr,
            *code signer) {
        try {
            return RestClient::sendAndDecodeResponse(body, m, path, hdr, \info, decode_errors, assume_content_type,
                shdr, signer);
        } catch (hash<ExceptionInfo> ex) {
            # throw an exception for the CDS error
            if (info."response-body".error && info."response-body".size() == 1
                && info."response-body".error."code".typeCode() == NT_STRING
                && info."response-body".error.message.typeCode() == NT_STRING) {
                hash<auto> error = info."response-body".error;
                string errcode = remove error."code";
                string msg = remove error.message;
                throw errcode, msg, error + ex.arg + {"decoded_body": info."response-body"};
            }
            rethrow;
        }
    }

    #! Processes async response with CDS-specific error wrapping
    /** @since CdsRestClient 2.2
    */
    private hash<auto> processAsyncResponse(hash<auto> resp, string method, string path,
            reference<hash<auto>> info, bool decode_errors) {
        try {
            return RestClient::processAsyncResponse(resp, method, path, \info, decode_errors);
        } catch (hash<ExceptionInfo> ex) {
            # throw an exception for the CDS error
            if (info."response-body".error && info."response-body".size() == 1
                    && info."response-body".error."code".typeCode() == NT_STRING
                    && info."response-body".error.message.typeCode() == NT_STRING) {
                hash<auto> error = info."response-body".error;
                string errcode = remove error."code";
                string msg = remove error.message;
                throw errcode, msg, error + ex.arg + {"decoded_body": info."response-body"};
            }
            rethrow;
        }
    }

    #! Returns options to update after an OAuth2 login, discovering the environment on the first one
    /** The environment a credential reaches does not change, so it is discovered only while this client
        still targets the discovery service - which is exactly the first authorization; a refresh does not
        pay for the call again.

        @see @ref cdsrestclient_discovery
    */
    private *hash<auto> getUpdateOptionsAfterLogin(hash<auto> h, *bool refresh) {
        *hash<auto> new_opts = RestClient::getUpdateOptionsAfterLogin(h, refresh);
        if (refresh) {
            return new_opts;
        }
        return CdsRestClientBase::discoverAfterLogin(new_opts, h, getURL(), NOTHING, getLogger(),
            \self.setURL());
    }
}

#! class for Microsoft Common Data Service REST connections; returns @ref CdsRestClient objects
/** supports options as in @ref RestClient::RestClient with the following differences:
    - \c "api": the API version for CDS
    - \c "api_profile": one of:
      - \c none (no options set)
      - \c dynamics (set client options for the MS Dynamics 365 API)
    - \c "oauth2_client_id": (required) the Microsoft Common Data Service OAuth2 client ID
    - \c "oauth2_client_secret": (required) the Microsoft Common Data Service OAuth2 client secret
    - \c "data": see @ref RestClient::RestClient::DataSerializationOptions "DataSerializationOptions" for possible
      values; the default is \c "json"
    - \c "scope": the OAuth2 scope for the login; the default depends on the \c "api_profile" option

    @see @ref CdsRestClient::CdsRestClient::constructor() for more information on the above options
*/
public class CdsRestConnection inherits RestClient::RestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Microsoft CDS REST Server",
            "short_desc": "A connection to a Microsoft CDS (Common Data Services) REST server",
            "desc": "A connection to a Microsoft CDS (Common Data Services) REST server",
            "cls": Class::forName("CdsRestConnection"),
            "schemes": {
                "cdsrests": True,
            },
            "base_scheme_map": {
                "https": "cdsrests",
            },
            "options": RestConnection::ConnectionScheme.options - (keys OAuth2DifferentOptionMap) + {
                "api": <ConnectionOptionInfo>{
                    "display_name": "API Version",
                    "short_desc": "Sets the API version for CDS",
                    "type": "string",
                    "desc": "Sets the API version for CDS",
                    "default_value": DynamicsProfile.default_api_version,
                },
                "api_profile": <ConnectionOptionInfo>{
                    "display_name": "API Profile",
                    "short_desc": "Sets the API profile for the CDS API to use",
                    "type": "string",
                    "desc": "Sets the API profile according to the CDS API in use; this option will set the REST "
                        "options if they are not already set (`oauth2_scopes`, `ping_body`, `ping_headers`, and "
                        "`ping_method`); valid "
                        "values:\n"
                        "- `none`: no options configured (default)\n"
                        "- `dynamics`: set options for the Dynamics 365 API\n"
                        "- `dynamics-business-central`: set options for the Dynamics 365 Business Central API",
                    "default_value": "none",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "desc": "No options are set",
                            "value": "none",
                        },
                        <AllowedValueInfo>{
                            "desc": "Set REST client options for the Dynamics 365 API",
                            "value": "dynamics",
                        },
                        <AllowedValueInfo>{
                            "desc": "Set REST client options for the Dynamics 365 Business Central API",
                            "value": "dynamics-business-central",
                        },
                    ),
                },
                "instance_type": <ConnectionOptionInfo>{
                    "display_name": "Instance Type",
                    "short_desc": "Business Central instance type",
                    "type": "string",
                    "desc": "Business Central instance type (e.g., 'sandbox', 'production', or environment GUID); "
                        "required when api_profile is 'dynamics-business-central'",
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "sandbox",
                            "display_name": "Sandbox",
                        },
                        <AllowedValueInfo>{
                            "value": "production",
                            "display_name": "Production",
                        },
                    ),
                },
                "tenant": <ConnectionOptionInfo>{
                    "display_name": "Tenant ID",
                    "short_desc": "Azure AD tenant ID",
                    "type": "string",
                    "desc": "Azure AD tenant ID for authentication",
                    "default_value": "common",
                },
                "data": RestConnection::ConnectionScheme.options."data" + <ConnectionOptionInfo>{
                    "default_value": "json",
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url + <ConnectionOptionInfo>{
                    "default_value": CdsRestClientBase::OAuth2AuthUrl,
                },
                "oauth2_grant_type": RestConnection::ConnectionScheme.options.oauth2_grant_type + <ConnectionOptionInfo>{
                    "default_value": "authorization_code",
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url + <ConnectionOptionInfo>{
                    "default_value": CdsRestClientBase::OAuth2TokenUrl,
                },
            },
            "required_options": "oauth2_client_id,oauth2_client_secret",
        };

        #! options required to support the OAuth2 authorization code grant flow
        const OAuth2AuthRequestOptions = (
            "oauth2_client_id",
            "oauth2_client_secret",
            "oauth2_auth_url",
            "oauth2_token_url",
            "oauth2_redirect_url",
        );

        #! Maps CDS REST options to standard options
        const OAuth2Options = {
            "oauth2_auto_refresh": "oauth2_auto_refresh",
            "oauth2_auth_args": "oauth2_auth_args",
            "oauth2_auth_url": "oauth2_auth_url",
            "oauth2_client_id": "oauth2_client_id",
            "oauth2_client_secret": "oauth2_client_secret",
            "oauth2_redirect_url": "oauth2_redirect_url",
            "oauth2_refresh_token": "oauth2_refresh_token",
            "oauth2_scopes": "oauth2_scopes",
            "oauth2_token_url": "oauth2_token_url",
            "password": "password",
            "username": "username",
        };

        #! Maps standard option names to CDS REST option names
        const OAuth2StandardToCdsOptionMap = map {$1.value: $1.key}, OAuth2Options.pairIterator();

        #! Different OAuth2 option map; standard name => our name
        const OAuth2DifferentOptionMap = map {$1.value: $1.key}, OAuth2Options.pairIterator(), $1.key != $1.value;
    }

    #! creates the CdsRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + {"opts": CdsRestConnection::getOptions(config.url, config.opts)}, attr) {
    }

    #! returns \c "cdsrests"
    string getType() {
        return "cdsrests";
    }

    #! returns @ref True as this connection returns a data provider with the \c getDataProvider() method
    /** @return @ref True as this connection returns a data provider with the \c getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! Returns the data provider application name this connection serves, if any
    /** @return the data provider application name this connection serves, if any
    */
    *string getAppName() {
        if (*hash<CdsApiProfile> profile = ApiProfileMap{opts.api_profile}) {
            return profile.app_name;
        }
    }

    #! returns a data provider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return a data provider object for this connection
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the CdsRestDataProvider and creates the data provider
        # object dynamically
        load_module("CdsRestDataProvider");
        if (opts.api_profile == BusinessCentralProfile.name) {
            return create_object("BcRestDataProvider", self);
        }
        return create_object("CdsRestDataProvider", self);
    }

    #! Returns a URI for an authorization code request
    /** The \c oauth2_grant_type must be \c authorization_code, and \c oauth2_client_id, \c oauth2_auth_url,
        \c oauth2_redirect_url must set if the \c redirect_uri option is not used

        @param info context information for the authorization code request

        @since %CdsRestClient 2.0
    */
    string getAuthorizationCodeRequest(hash<AuthCodeInfo> info = <AuthCodeInfo>{}) {
        return RestConnection::getAuthorizationCodeRequest(info) + "&response_mode=query";
    }

    #! Returns the OAuth2 option name for this connection
    /** @since %CdsRestClient 2.0
    */
    string getOAuth2OptionName(string opt) {
        return OAuth2StandardToCdsOptionMap{opt} ?? opt;
    }

    #! Returns OAuth2 options in a standard format
    /** @since %CdsRestClient 2.0
    */
    hash<auto> getOAuth2Options() {
        hash<auto> rv;
        foreach hash<auto> i in (OAuth2Options.pairIterator()) {
            rv{i.value} = real_opts{i.key};
        }
        return rv;
    }

    #! Returns the OAuth2 auth URL or throws an exception if not set
    /*  @param allow_relative if @ref True then a relative URL (path only) can be returned; the default (@ref False)
        is to return a full URL

        @since %CdsRestClient 2.0
    */
    string getAuthUrl(*bool allow_relative) {
        *string rv = opts.oauth2_auth_url;
        if (!rv.val()) {
            throw "OAUTH2-ERROR", sprintf("connection %y has no \"oauth2_auth_url\" option set", name);
        }
        if (rv == "auto") {
            string tenant = opts.tenant ?? "common";
            rv = CdsRestClientBase::OAuth2BaseUrl + tenant + CdsRestClientBase::OAuth2AuthUriPathSuffix;
        } else if (!allow_relative && rv !~ /^http/) {
            string url = real_url;
            if (url !~ /\/$/) {
                url += "/";
            }
            if (rv =~ /^\//) {
                rv = rv[1..];
            }
            rv = url + rv;
        }
        return rv;
    }

    #! Returns the OAuth2 token URL or throws an exception if not set
    /*  @param allow_relative if @ref True then a relative URL (path only) can be returned; the default (@ref False)
        is to return a full URL

        @since %CdsRestClient 2.0
    */
    string getTokenUrl(*bool allow_relative) {
        *string rv = opts.oauth2_token_url;
        if (!rv.val()) {
            throw "OAUTH2-ERROR", sprintf("connection %y has no \"oauth2_token_url\" option set", name);
        }
        if (rv == "auto") {
            string tenant = opts.tenant ?? "common";
            rv = CdsRestClientBase::OAuth2BaseUrl + tenant + CdsRestClientBase::OAuth2TokenUriPathSuffix;
        } else if (!allow_relative && rv !~ /^http/) {
            string url = real_url;
            if (url !~ /\/$/) {
                url += "/";
            }
            rv = url + rv;
        }
        return rv;
    }

    #! Returns @ref True if the response was related to an authorization token error
    /** @return @ref True if the response was related to an authorization token error
    */
    bool isAuthTokenError(int status_code, hash<auto> headers, bool body_deserialized, *string body_content_type,
            auto body) {
        if (status_code != 401) {
            return False;
        }
        if (!body_deserialized) {
            return body =~ /invalid_grant/;
        }
        return body.error == "invalid_grant";
    }

    #! Sets the auth code feature if supported
    private checkAuthCodeFeature() {
        if (opts{OAuth2AuthRequestOptions}.size() == OAuth2AuthRequestOptions.size()) {
            features{RCF_OAUTH2_AUTH_CODE} = True;
        }
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_records = True;
    }

    #! returns a @ref CdsRestClient object
    /** @param connect if @ref True "True", then the connection is returned already connected
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref CdsRestClient object
    */
    private CdsRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new CdsRestClient(getConnectionOptions(rtopts), !connect);
    }

    #! Returns an async-I/O-capable connection object
    /** @since CdsRestClient 2.3
    */
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new CdsRestClientIo(getConnectionOptions(rtopts));
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! returns options for @ref CdsRestConnection::constructor()
    private static hash<auto> getOptions(string url, *hash<auto> orig_opts) {
        # to ensure opts are hash<auto>
        hash<auto> opts += orig_opts;

        if (*string prof = opts.api_profile) {
            *hash<CdsApiProfile> profile = ApiProfileMap{prof};
            if (profile) {
                # set ping options from profile if not already set
                if (!opts.hasKey("ping_method")) {
                    opts.ping_method = profile.ping_method;
                }
                if (!opts.hasKey("ping_path")) {
                    opts.ping_path = profile.ping_path;
                }
                if (!opts.hasKey("ping_headers")) {
                    opts.ping_headers = profile.ping_headers;
                }
                if (!opts.hasKey("oauth2_scopes")) {
                    opts.oauth2_scopes = profile.oauth2_scopes;
                }

                if (opts.url) {
                    url = remove opts.url;
                }
                if (url !~ /^https:\/\//) {
                    url =~ s/^[a-z]+:\/\//https:\/\//;
                }
                if (url !~ /\/$/) {
                    url += "/";
                }
                # resolve the profile's scopes against the URL; a scope already resolved against another
                # URL is resolved again, or changing a connection's URL would leave the old one in the
                # scope and the authorization request would name the wrong organisation
                opts.oauth2_scopes = CdsRestClientBase::resolveProfileScopes(profile.oauth2_scopes,
                    opts.oauth2_scopes, url);

                if (opts.ping_path =~ /\{api_uri_path\}/) {
                    opts.ping_path = replace(opts.ping_path, "{api_uri_path}",
                        profile.uri_path_prefix + (opts.api ?? profile.default_api_version));
                }
            } else if (prof != "none") {
                throw "CDS-RESTCLIENT-ERROR", sprintf("api_profile %y is unknown; known API profiles: %y", prof,
                    keys ApiProfileMap);
            }
        } else if (opts.url) {
            remove opts.url;
        }

        return opts;
    }
}

#! For REST connections to Microsoft Dynamics
public class DynamicsRestConnection inherits CdsRestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Microsoft Dynamics REST Server",
            "short_desc": "A connection to a Microsoft Dynamics REST server",
            "cls": Class::forName("DynamicsRestConnection"),
            "options": CdsRestConnection::ConnectionScheme.options + {
                "api_profile": CdsRestConnection::ConnectionScheme.options.api_profile + <ConnectionOptionInfo>{
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "desc": "Set REST client options for the Dynamics API",
                            "value": "dynamics",
                        },
                    ),
                    "default_value": "dynamics",
                },
                "organization": <ConnectionOptionInfo>{
                    "display_name": "Environment",
                    "short_desc": "The Dataverse environment to work in",
                    "type": "string",
                    "desc": "The Dataverse environment to work in, by its unique name.\n\n"
                        "This is normally **discovered**: authorizing the connection asks Microsoft which "
                        "environments the credential reaches, and where there is one it is used and this "
                        "option is set to it. Set it by hand only where the credential reaches several, "
                        "which is the one case that cannot be resolved without being told - connecting to "
                        "an arbitrary one would read another company's data.",
                    "example_value": "orgb1c2d3e4",
                },
            },
            "schemes": {
                "dynamics": True,
            },
            "base_scheme_map": {
                "https": "dynamics",
            },
            # the environment's URL is discovered from the credential, so the user does not supply one
            "auto_url": True,
        };
    }

    #! creates the CdsRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : CdsRestConnection(DynamicsRestConnection::getConfig(config), attr) {
    }

    #! returns \c "dynamics"
    string getType() {
        return "dynamics";
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! Processes an OAuth2 token response, discovering the environment on the first authorization
    /** This is the authorization code flow's own path: the platform exchanges the code and hands the token
        response here, so it is where a connection that has just been authorized becomes a working one.

        The environment is discovered only while the connection still targets the discovery service, so an
        environment that has already been chosen - or set by hand - is left alone, and a refresh does not
        pay for the call again.

        @see @ref cdsrestclient_discovery
    */
    private *hash<auto> processOAuth2TokenResponseImpl(hash<auto> resp) {
        *hash<auto> new_opts = RestConnection::processOAuth2TokenResponseImpl(resp);
        if (!resp.access_token.val() || !CdsRestClientBase::isDiscoveryUrl(url)) {
            return new_opts;
        }
        try {
            if (*hash<auto> inst = discoverInstance(resp.access_token)) {
                new_opts += inst;
                # the token just issued is for the discovery service, and the connection now targets an
                # environment: a different resource, which no refresh will move it to.  So the platform is
                # asked for a second authorization, now that there is an environment to name in it
                new_opts{RestConnection::ReauthorizationRequiredOption} = True;
                info("Dynamics: environment discovered; a second authorization is needed to reach it");
            }
        } catch (hash<ExceptionInfo> ex) {
            # a failed discovery must not break an otherwise successful authorization
            error("Dynamics: cannot determine the environment to work in: %s: %s", ex.err, ex.desc);
        }
        return new_opts;
    }

    #! Discovers the environment a newly issued credential reaches
    /** The one call the discovery makes; an extension point for reaching Microsoft another way.
    */
    private *hash<auto> discoverInstance(string token) {
        return CdsRestClientBase::discoverInstanceOptions(token, real_opts.organization, getLogger());
    }

    #! Re-derives the URL when the environment is set or changed
    setUpdateOptionsCode(*code update_options) {
        UpdateOptionsInterface::setUpdateOptionsCode(update_options);
    }

    #! returns options for @ref DynamicsRestConnection::constructor()
    /** A Dynamics connection is created against the Global Discovery Service and moves to its environment
        once it has been authorized, so a connection made without a URL gets that one rather than being
        refused - or, with \c auto_url and no URL to build, silently getting
        <tt>dynamics://localhost</tt>.

        @see @ref cdsrestclient_discovery
    */
    private static hash<auto> getConfig(hash<auto> config) {
        return config + {
            "url": config.url.val() ? config.url : CdsRestClientBase::DefaultUrl,
            "opts": config.opts + {
                "api_profile": CdsRestClient::DynamicsProfile.name,
            },
        };
    }
}

#! Class for Microsoft Dynamics 365 Business Central REST connections
/** Supports options as in @ref CdsRestConnection with the following differences:
    - \c "api": the API version for Business Central (default: "v2.0")
    - \c "instance_type": (required) the Business Central instance type (e.g., "sandbox", "production", or
      environment GUID)
    - \c "tenant": the Azure AD tenant ID
    - \c "oauth2_client_id": (required) the Business Central OAuth2 client ID
    - \c "oauth2_client_secret": (required) the Business Central OAuth2 client secret

    @see @ref CdsRestClient::constructor() for more information on the above options
*/
public class BusinessCentralRestConnection inherits CdsRestConnection {
    public {
        #! Connection entry info
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Microsoft Business Central REST Server",
            "short_desc": "A connection to a Microsoft Dynamics 365 Business Central REST server",
            "desc": "A connection to a Microsoft Dynamics 365 Business Central REST server for ERP data access",
            "cls": Class::forName("BusinessCentralRestConnection"),
            "schemes": {
                "bcrests": True,
            },
            "base_scheme_map": {
                "https": "bcrests",
            },
            "auto_url": True,
            "options": CdsRestConnection::ConnectionScheme.options + {
                "api": CdsRestConnection::ConnectionScheme.options.api + <ConnectionOptionInfo>{
                    "default_value": BusinessCentralProfile.default_api_version,
                },
                "api_profile": CdsRestConnection::ConnectionScheme.options.api_profile + <ConnectionOptionInfo>{
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "desc": "Set REST client options for the Dynamics 365 Business Central API",
                            "value": BusinessCentralProfile.name,
                        },
                    ),
                    "default_value": BusinessCentralProfile.name,
                },
                "instance_type": CdsRestConnection::ConnectionScheme.options.instance_type + <ConnectionOptionInfo>{
                    "allowed_values": (
                        <AllowedValueInfo>{
                            "value": "sandbox",
                            "display_name": "Sandbox",
                        },
                        <AllowedValueInfo>{
                            "value": "production",
                            "display_name": "Production",
                        },
                    ),
                },
                "oauth2_auth_url": RestConnection::ConnectionScheme.options.oauth2_auth_url + <ConnectionOptionInfo>{
                    "default_value": "auto",
                },
                "oauth2_token_url": RestConnection::ConnectionScheme.options.oauth2_token_url + <ConnectionOptionInfo>{
                    "default_value": "auto",
                },
                "ping_method": RestConnection::ConnectionScheme.options.ping_method + <ConnectionOptionInfo>{
                    "default_value": BusinessCentralProfile.ping_method,
                },
                "ping_path": RestConnection::ConnectionScheme.options.ping_path + <ConnectionOptionInfo>{
                    "default_value": BusinessCentralProfile.ping_path,
                },
                "ping_headers": RestConnection::ConnectionScheme.options.ping_headers + <ConnectionOptionInfo>{
                    "default_value": BusinessCentralProfile.ping_headers,
                },
            },
            "required_options": "oauth2_client_id,oauth2_client_secret,instance_type",
        };
    }

    #! Creates the BusinessCentralRestConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr)
            : CdsRestConnection(config + BusinessCentralRestConnection::getConfig(config), attr) {
    }

    #! Returns \c "bcrests"
    string getType() {
        return "bcrests";
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    #! returns options for @ref BusinessCentralRestConnection::constructor()
    private static hash<auto> getConfig(*hash<auto> config) {
        string api = config.api ?? BusinessCentralProfile.default_api_version;
        # Full URL: https://api.businesscentral.dynamics.com/v2.0/{instance_type}/api/v2.0/
        string url = BusinessCentralProfile.default_base_uri + api + "/" + config.opts.instance_type + "/api/" + api + "/";
        url =~ s/^https:/bcrests:/;
        return config + {
            "url": url,
            "opts": config.opts + {
                "api_profile": BusinessCentralProfile.name,
            },
        };
    }
}

#! CDS REST client for non-blocking I/O
public class CdsRestClientIo inherits RestClientIo::RestClientIo, CdsRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(CdsRestClientBase::getOptions(opts), shared_mgr) {
    }
}

#! Dynamics REST client for non-blocking I/O
public class DynamicsRestClientIo inherits RestClientIo::RestClientIo, CdsRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(CdsRestClientBase::getOptions(opts + {
                "api_profile": CdsRestClient::DynamicsProfile.name,
            }), shared_mgr) {
    }

    #! Returns options to update after an OAuth2 login, discovering the environment on the first one
    /** The environment a credential reaches does not change, so it is discovered only while this client
        still targets the discovery service - which is exactly the first authorization; a refresh does not
        pay for the call again.

        @see @ref cdsrestclient_discovery
    */
    private *hash<auto> getUpdateOptionsAfterLogin(hash<auto> h) {
        return CdsRestClientBase::discoverAfterLogin(RestClientIo::getUpdateOptionsAfterLogin(h), h,
            getUrl(), NOTHING, getLogger());
    }
}

#! Business Central REST client for non-blocking I/O
public class BusinessCentralRestClientIo inherits RestClientIo::RestClientIo, CdsRestClientBase {
    #! Creates the object with the given options
    /** @param opts constructor options
        @param shared_mgr optional shared connection manager
    */
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(CdsRestClientBase::getOptions(opts + {
                "api_profile": CdsRestClient::BusinessCentralProfile.name,
            }), shared_mgr) {
    }
}
}
