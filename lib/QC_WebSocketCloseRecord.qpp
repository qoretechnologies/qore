#include "qore/Qore.h"
#include "qore/intern/WebSocketCloseRecord.h"

//! The read-only record that a close frame was sent on the stream of a WebSocket connection over HTTP/2 or HTTP/3
/** A WebSocket connection has one close frame, after which no data frame is sent (RFC 6455 section 5.5.1).  The
    HTTP/2 or HTTP/3 session sets the record when it buffers a close frame on the stream, either the one of the
    stream's WebSocket frame state (for an error in the peer's frames) or the application's; the stream context of the
    connection (@ref AsyncSocketIo::AbstractStreamContext::isWebSocketCloseSent() "AbstractStreamContext::isWebSocketCloseSent()")
    reads it before it sends, so that a data frame is refused with \c WEBSOCKET-CLOSING-ERROR, and a second close
    frame is not sent, also after the stream or the session has ended.

    Objects of this class are returned by
    @ref Qore::Socket::getHttp2StreamWebSocketCloseRecord() "Socket::getHttp2StreamWebSocketCloseRecord()" and
    @ref Qore::Socket::getQuicStreamWebSocketCloseRecord() "Socket::getQuicStreamWebSocketCloseRecord()"; they cannot
    be created or changed by Qore code, so the guarantee does not depend on the code of a handler.

    @par Sandboxing
    The class has no functional domain: an object holds one boolean about a stream of a socket that the program
    already holds, and reveals nothing else (no address, data or state of other streams).  Objects can only be
    obtained through the methods of @ref Qore::Socket "Socket" above, whose network domain
    (@ref Qore::PO_NO_NETWORK "PO_NO_NETWORK") keeps them from a program without network access.

    @par Example:
    @code{.py}
*WebSocketCloseRecord rec = sock.getHttp2StreamWebSocketCloseRecord(stream_id);
if (rec && rec.isCloseSent()) {
    # no data frame may be sent on the stream any more
}
    @endcode

    @since %Qore 3.0
*/
qclass WebSocketCloseRecord [arg=WebSocketCloseRecord* r; ns=Qore; flags=final];

//! Objects of this class cannot be created by Qore code
/**
 */
private WebSocketCloseRecord::constructor() {
    assert(false);
}

//! Returns @ref True if a close frame was sent on the stream
/** The value is read without a lock; once @ref True, it stays @ref True.

    @return @ref True if a close frame was sent on the stream, by the stream's WebSocket frame state or by the
    application

    @par Example:
    @code{.py}
bool closing = rec.isCloseSent();
    @endcode

    @since %Qore 3.0
*/
bool WebSocketCloseRecord::isCloseSent() [flags=CONSTANT] {
    return r->isCloseSent();
}
