#include "qore/Qore.h"
#include "qore/intern/QC_Http2ClientPollOperationBase.h"
#include "qore/intern/QC_SocketPollOperation.h"
#include "qore/intern/QC_Socket.h"
#include "qore/intern/QC_Channel.h"
#include "qore/intern/QoreAsyncIoLogger.h"
#include "qore/intern/QoreEventNotifier.h"

// Forward declarations for QPP type references
extern QoreClass* QC_ABSTRACTHTTPPOLLCONNECTION;
extern QoreClass* QC_EVENTNOTIFIER;

/** @cond INTERNAL */

// ============================================================
// Http2ClientPollOperationPriv implementation
// ============================================================

Http2ClientPollOperationPriv::Http2ClientPollOperationPriv(QoreObject* self,
        QoreSocketObject* sock, SocketPollOperationBase* connect_op,
        bool ssl_required, bool proxy_tunnel,
        std::string target_host, int target_port,
        AbstractHttpPollConnectionPriv* conn_priv)
    : SocketPollOperationBase(self), current_op(connect_op), sock_obj(sock),
      ssl_required(ssl_required), proxy_tunnel(proxy_tunnel),
      target_host(std::move(target_host)), target_port(target_port),
      connection_priv(conn_priv) {
    // sock and connect_op are ref'd by the caller; ownership transferred
    // connection_priv is a raw (unrefed) pointer to the C++ priv data;
    // the strong QoreObject ref (for DGC cycle detection) is held in the
    // Qore-level connection_ref member (private, stored in the data hash)
}

Http2ClientPollOperationPriv::~Http2ClientPollOperationPriv() {
    if (current_op || sock_obj || error_info) {
        ExceptionSink xsink;
        cleanup(&xsink);
    }
}

void Http2ClientPollOperationPriv::cleanup(ExceptionSink* xsink) {
    // Clean up stream queues
    clearStreamQueues(xsink);

    // Clean up stream actions — reject pending Promises so Future::get() doesn't hang
    {
        AutoLocker al(stream_lock);
        for (auto& [sid, action] : stream_actions) {
            if (action) {
                action->executeError("HTTP2-ABORT",
                    "poll operation cleaned up before response was received", xsink);
                action->deref(xsink);
            }
        }
        stream_actions.clear();
        active_stream_count = 0;
    }

    if (error_info) {
        error_info->deref(xsink);
        error_info = nullptr;
    }
    connection_priv = nullptr;  // raw pointer — Qore data member (connection_ref) holds the ref
    if (current_op) {
        current_op->deref(xsink);
        current_op = nullptr;
    }
    if (sock_obj) {
        sock_obj->deref(xsink);
        sock_obj = nullptr;
    }
}

const char* Http2ClientPollOperationPriv::getStateImpl() const {
    switch (h2_state.load(std::memory_order_acquire)) {
        case H2State::CONNECTING: return "connecting";
        case H2State::SSL_UPGRADE: return "ssl_upgrade";
        case H2State::PROXY_CONNECT_SEND: return "proxy_connect_send";
        case H2State::PROXY_CONNECT_RECV: return "proxy_connect_recv";
        case H2State::READING: return "reading";
        case H2State::WAIT_READ: return "wait_read";
        case H2State::CLOSED: return "closed";
        default: return "unknown";
    }
}

QoreValue Http2ClientPollOperationPriv::getOutput() const {
    if (current_op) {
        return current_op->getOutput();
    }
    return QoreValue();
}

void Http2ClientPollOperationPriv::releaseCurrentOp(ExceptionSink* xsink) {
    if (current_op) {
        current_op->deref(xsink);
        current_op = nullptr;
    }
}

// --- continuePoll state machine (I/O thread) ---

QoreHashNode* Http2ClientPollOperationPriv::continuePoll(ExceptionSink* xsink) {
    {
        AutoLocker al(stream_lock);
        response_dispatched = false;
    }

    while (true) {
        H2State state = h2_state.load(std::memory_order_acquire);
        switch (state) {
            case H2State::CONNECTING:
                return handleConnecting(xsink);

            case H2State::SSL_UPGRADE:
                return handleSslUpgrade(xsink);

            case H2State::PROXY_CONNECT_SEND:
                return handleProxyConnectSend(xsink);

            case H2State::PROXY_CONNECT_RECV:
                return handleProxyConnectRecv(xsink);

            case H2State::READING:
                return handleReading(xsink);

            case H2State::WAIT_READ:
                h2_state.store(H2State::READING, std::memory_order_release);
                continue;

            case H2State::CLOSED:
                return nullptr;
        }
    }
}

QoreHashNode* Http2ClientPollOperationPriv::handleConnecting(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP2-CONNECT-ERROR", "connect operation not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        const QoreStringNode* err_str = poll_xsink.getExceptionErr().get<const QoreStringNode>();
        const QoreStringNode* desc_str = poll_xsink.getExceptionDesc().get<const QoreStringNode>();
        ASYNC_IO_TRACE("H2 handleConnecting: CONNECT ERROR: %s: %s target=%s:%d\n",
            err_str ? err_str->c_str() : "?",
            desc_str ? desc_str->c_str() : "?",
            target_host.c_str(), target_port);
        setError(err_str ? err_str->c_str() : "HTTP2-CONNECT-ERROR",
            desc_str ? desc_str->c_str() : "TCP connection failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ASYNC_IO_TRACE("H2 handleConnecting: TCP connected to %s:%d ssl=%d\n",
            target_host.c_str(), target_port, (int)ssl_required);
        if (proxy_tunnel) {
            startProxyConnect(xsink);
        } else if (ssl_required) {
            startSslUpgrade(xsink);
        } else {
            startMultiplex(xsink);
        }
        if (*xsink) {
            return nullptr;
        }
        return continuePoll(xsink);
    }

    setError("HTTP2-CONNECT-ERROR", "TCP connection failed", xsink);
    return nullptr;
}

void Http2ClientPollOperationPriv::startProxyConnect(ExceptionSink* xsink) {
    // Build CONNECT request: "CONNECT host:port HTTP/1.1\r\nHost: host:port\r\n\r\n"
    QoreStringNode* connect_req = new QoreStringNode();
    connect_req->sprintf("CONNECT %s:%d HTTP/1.1\r\nHost: %s:%d\r\n\r\n",
        target_host.c_str(), target_port, target_host.c_str(), target_port);

    releaseCurrentOp(xsink);
    sock_obj->ref();
    // SocketSendPollOperation takes ownership of the string ref
    current_op = new SocketSendPollOperation(xsink, connect_req, sock_obj);
    if (*xsink) {
        // Must deref — the op was created but errored; it owns the sock ref
        current_op->deref(xsink);
        current_op = nullptr;
        return;
    }
    current_op->setSelf(*self);
    h2_state.store(H2State::PROXY_CONNECT_SEND, std::memory_order_release);
}

QoreHashNode* Http2ClientPollOperationPriv::handleProxyConnectSend(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP2-CONNECT-ERROR", "proxy CONNECT send not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        const QoreStringNode* err_str = poll_xsink.getExceptionErr().get<const QoreStringNode>();
        const QoreStringNode* desc_str = poll_xsink.getExceptionDesc().get<const QoreStringNode>();
        setError(err_str ? err_str->c_str() : "HTTP2-CONNECT-ERROR",
            desc_str ? desc_str->c_str() : "proxy CONNECT send failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        printd(5, "Http2ClientPollOperationPriv::handleProxyConnectSend() CONNECT sent, reading response\n");
        releaseCurrentOp(xsink);
        sock_obj->ref();
        current_op = new SocketReadHttpHeaderPollOperation(xsink, sock_obj);
        if (*xsink) {
            current_op->deref(xsink);
            current_op = nullptr;
            return nullptr;
        }
        current_op->setSelf(*self);
        h2_state.store(H2State::PROXY_CONNECT_RECV, std::memory_order_release);
        return handleProxyConnectRecv(xsink);
    }

    setError("HTTP2-CONNECT-ERROR", "proxy CONNECT send failed", xsink);
    return nullptr;
}

QoreHashNode* Http2ClientPollOperationPriv::handleProxyConnectRecv(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP2-CONNECT-ERROR", "proxy CONNECT recv not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        const QoreStringNode* err_str = poll_xsink.getExceptionErr().get<const QoreStringNode>();
        const QoreStringNode* desc_str = poll_xsink.getExceptionDesc().get<const QoreStringNode>();
        setError(err_str ? err_str->c_str() : "HTTP2-CONNECT-ERROR",
            desc_str ? desc_str->c_str() : "proxy CONNECT response read failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder output_val(current_op->getOutput(), xsink);
        if (output_val->getType() == NT_HASH) {
            QoreHashNode* output = output_val->get<QoreHashNode>();
            QoreValue hdr_val = output->getKeyValue("hdr");
            if (hdr_val.getType() == NT_HASH) {
                QoreHashNode* hdr = hdr_val.get<QoreHashNode>();
                int status = (int)hdr->getKeyValue("status_code").getAsBigInt();
                if (status < 200 || status >= 300) {
                    SimpleRefHolder<QoreStringNode> desc(new QoreStringNode());
                    QoreValue msg_val = hdr->getKeyValue("status_message");
                    const char* msg = msg_val.getType() == NT_STRING
                        ? msg_val.get<const QoreStringNode>()->c_str() : "unknown";
                    desc->sprintf("proxy CONNECT failed with HTTP %d: %s", status, msg);
                    setError("HTTP2-CONNECT-ERROR", desc->c_str(), xsink);
                    return nullptr;
                }
            }
        }
        printd(5, "Http2ClientPollOperationPriv::handleProxyConnectRecv() tunnel established\n");
        startSslUpgrade(xsink);
        if (*xsink) {
            return nullptr;
        }
        return continuePoll(xsink);
    }

    setError("HTTP2-CONNECT-ERROR", "proxy CONNECT response read failed", xsink);
    return nullptr;
}

void Http2ClientPollOperationPriv::startSslUpgrade(ExceptionSink* xsink) {
    printd(5, "Http2ClientPollOperationPriv::startSslUpgrade()\n");
    releaseCurrentOp(xsink);
    sock_obj->ref();
    current_op = new SocketUpgradeClientSslPollOperation(xsink, sock_obj);
    if (*xsink) {
        current_op->deref(xsink);
        current_op = nullptr;
        return;
    }
    current_op->setSelf(*self);
    h2_state.store(H2State::SSL_UPGRADE, std::memory_order_release);
}

QoreHashNode* Http2ClientPollOperationPriv::handleSslUpgrade(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP2-SSL-ERROR", "SSL operation not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        const QoreStringNode* err_str = poll_xsink.getExceptionErr().get<const QoreStringNode>();
        const QoreStringNode* desc_str = poll_xsink.getExceptionDesc().get<const QoreStringNode>();
        setError(err_str ? err_str->c_str() : "HTTP2-SSL-ERROR",
            desc_str ? desc_str->c_str() : "SSL upgrade failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        // Check ALPN negotiated protocol
        SimpleRefHolder<QoreStringNode> alpn(sock_obj->getAlpnProtocol());
        if (!alpn || strcmp(alpn->c_str(), "h2") != 0) {
            SimpleRefHolder<QoreStringNode> desc(new QoreStringNode());
            desc->sprintf("HTTP/2 not negotiated via ALPN: got %s",
                alpn ? alpn->c_str() : "null");
            setError("HTTP2-ALPN-ERROR", desc->c_str(), xsink);
            return nullptr;
        }
        printd(5, "Http2ClientPollOperationPriv::handleSslUpgrade() SSL done, ALPN=h2\n");
        startMultiplex(xsink);
        if (*xsink) {
            return nullptr;
        }
        return continuePoll(xsink);
    }

    setError("HTTP2-SSL-ERROR", "SSL upgrade failed", xsink);
    return nullptr;
}

void Http2ClientPollOperationPriv::startMultiplex(ExceptionSink* xsink) {
    printd(5, "Http2ClientPollOperationPriv::startMultiplex()\n");
    releaseCurrentOp(xsink);
    sock_obj->ref();
    current_op = new SocketHttp2ClientMultiplexPollOperation(xsink, sock_obj);
    if (*xsink) {
        current_op->deref(xsink);
        current_op = nullptr;
        return;
    }
    current_op->setSelf(*self);
    h2_state.store(H2State::READING, std::memory_order_release);

    if (ssl_required) {
        // HTTPS: ALPN already confirmed H2 during TLS handshake
        h2_confirmed.store(true, std::memory_order_release);
        fireReadyCallback(xsink);
    }
    // Plain HTTP (h2c): defer readyCallback until we see valid H2 output
    // from the server, confirming it supports HTTP/2 prior knowledge
}

QoreHashNode* Http2ClientPollOperationPriv::handleReading(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP2-READ-ERROR", "read operation not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        const QoreStringNode* err_str = poll_xsink.getExceptionErr().get<const QoreStringNode>();
        const QoreStringNode* desc_str = poll_xsink.getExceptionDesc().get<const QoreStringNode>();
        setError(err_str ? err_str->c_str() : "HTTP2-READ-ERROR",
            desc_str ? desc_str->c_str() : "HTTP/2 read error", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    // h2c confirmation: after the initial preface send (cycle 0), if we get
    // a successful poll cycle with valid poll_info, the server has responded
    // with valid H2 data (SETTINGS frame)
    if (!h2_confirmed.load(std::memory_order_acquire) && poll_info) {
        ++reading_cycle_count;
        if (reading_cycle_count > 1) {
            h2_confirmed.store(true, std::memory_order_release);
            printd(5, "Http2ClientPollOperationPriv::handleReading() h2c confirmed\n");
            fireReadyCallback(xsink);
        }
    }

    // Drain registered CONNECT stream queues after every read poll cycle.
    // The inner op may have processed DATA frames for CONNECT streams that
    // need to be delivered to handler threads via their registered Queues.
    drainStreamQueues(xsink);
    if (*xsink) {
        setError("HTTP2-READ-ERROR", "stream queue drain error", xsink);
        return nullptr;
    }

    // Drain completed responses
    int drain_count = 0;
    while (true) {
        ValueHolder output_val(current_op->getOutput(), xsink);
        if (output_val->isNullOrNothing()) {
            break;
        }
        if (++drain_count > MAX_DRAIN_ITERATIONS) {
            break;
        }
        empty_read_count = 0;

        QoreHashNode* output = output_val->get<QoreHashNode>();
        int64_t stream_id_val = output->getKeyValue("stream_id").getAsBigInt();
        std::string sid = std::to_string(stream_id_val);
        bool is_end = output->getKeyValue("end_stream").getAsBool();

        AbstractAsyncAction* action = nullptr;
        {
            AutoLocker al(stream_lock);
            auto it = stream_actions.find(sid);
            if (it != stream_actions.end()) {
                action = it->second;
                action->ref();
                response_dispatched = true;

                // Remove stream BEFORE dispatching so active_stream_count is
                // decremented by the time the action resolves the caller's Future
                if (is_end) {
                    it->second->deref(xsink);
                    stream_actions.erase(it);
                    --active_stream_count;
                }
            }
        }

        if (action) {
            if (is_end && action->isStreaming()) {
                // Streaming (ChannelAction) with end_stream: split body + end marker
                // for readData() consumer, then close the channel
                QoreValue body_val = output->getKeyValue("body");
                if (!body_val.isNullOrNothing()) {
                    // Send body without end_stream — copy before modifying
                    QoreHashNode* body_resp = output->copy();
                    QoreValue removed = body_resp->takeKeyValue("end_stream");
                    removed.discard(xsink);
                    action->execute(body_resp, xsink);

                    // Send end_stream marker with trailers preserved
                    ReferenceHolder<QoreHashNode> end_resp(new QoreHashNode(autoTypeInfo), xsink);
                    end_resp->setKeyValue("end_stream", true, xsink);
                    end_resp->setKeyValue("stream_id", stream_id_val, xsink);
                    // Preserve trailers so getTrailers() works for streaming responses
                    QoreValue trailers_val = output->getKeyValue("trailers");
                    if (!trailers_val.isNullOrNothing()) {
                        end_resp->setKeyValue("trailers", trailers_val.refSelf(), xsink);
                    }
                    action->execute(end_resp.release(), xsink);
                } else {
                    // Just end_stream, no body
                    action->execute(output->hashRefSelf(), xsink);
                }
                action->complete(xsink);
            } else {
                // Non-streaming (PromiseAction) or intermediate streaming data:
                // send complete output to action
                action->execute(output->hashRefSelf(), xsink);
            }
            action->deref(xsink);

            // Signal stream data ready for registered stream listeners
            // (WebSocket/SSE consumers that use the onStreamData dispatch).
            // The ChannelAction already pushed data to the stream handle's
            // Channel; this ensures the controller dispatches onStreamData()
            // so the listener's notifyIo() fires.
            {
                int32_t sid32 = (int32_t)stream_id_val;
                ASYNC_IO_TRACE("H2Client handleReading: stream=%d queues=%d is_end=%d\n",
                    sid32, (int)stream_queues.size(), (int)is_end);
                if (!stream_queues.empty()
                        && stream_queues.find(sid32) != stream_queues.end()) {
                    ASYNC_IO_TRACE("H2Client handleReading: signaling stream=%d\n", sid32);
                    if (std::find(data_ready_streams.begin(), data_ready_streams.end(),
                            sid32) == data_ready_streams.end()) {
                        data_ready_streams.push_back(sid32);
                    }
                }
            }
        }
    }

    // Check dispatched flag
    bool dispatched;
    {
        AutoLocker al(stream_lock);
        dispatched = response_dispatched;
    }
    if (dispatched) {
        h2_state.store(H2State::WAIT_READ, std::memory_order_release);
        // Use C++ events when available — they include SOCK_POLLOUT if there
        // are pending sends (e.g., WINDOW_UPDATE after receiving data)
        if (poll_info) {
            return poll_info;
        }
        return getSocketPollInfoHash(xsink, SOCK_POLLIN);
    }

    if (poll_info) {
        // Valid I/O activity (e.g., WINDOW_UPDATE, PING) even if no
        // response output — reset the empty read counter
        empty_read_count = 0;
        return poll_info;
    }

    ++empty_read_count;
    // Use a much shorter limit during h2c probing — if the server
    // doesn't respond with valid H2 frames quickly, it likely doesn't
    // support HTTP/2 prior knowledge
    int max_reads = h2_confirmed.load(std::memory_order_acquire)
        ? MAX_EMPTY_READS : H2C_PROBE_MAX_EMPTY_READS;
    if (empty_read_count > max_reads) {
        std::string msg = "max consecutive empty reads (" + std::to_string(max_reads) + ") exceeded";
        if (!h2_confirmed.load(std::memory_order_acquire)) {
            msg += " (h2c probe failed — server likely doesn't support HTTP/2)";
        }
        setError("HTTP2-EMPTY-READ", msg.c_str(), xsink);
        return nullptr;
    }

    h2_state.store(H2State::WAIT_READ, std::memory_order_release);
    return getSocketPollInfoHash(xsink, SOCK_POLLIN);
}

void Http2ClientPollOperationPriv::abort(ExceptionSink* xsink) {
    h2_state.store(H2State::CLOSED, std::memory_order_release);
    if (current_op) {
        current_op->abort(xsink);
    }
    clearStreamQueues(xsink);
    notifyPendingStreams("HTTP2-ABORT", "connection aborted", xsink);
    if (connection_priv) {
        connection_priv->setClosed();
    }
    connection_priv = nullptr;
    // Note: do NOT close socket or delete current_op here to avoid
    // Note: do NOT close socket or delete current_op here to avoid
    // use-after-free if a driver thread is still inside continuePoll
}

void Http2ClientPollOperationPriv::setError(const char* err, const char* desc,
        ExceptionSink* xsink) {
    {
        AutoLocker al(stream_lock);
        if (!error_info) {
            error_info = new QoreHashNode(autoTypeInfo);
            error_info->setKeyValue("err", new QoreStringNode(err), xsink);
            error_info->setKeyValue("desc", new QoreStringNode(desc), xsink);
        }
    }
    h2_state.store(H2State::CLOSED, std::memory_order_release);
    // Close the socket to release the fd and prevent CLOSE-WAIT accumulation.
    // Safe here: setError() is called from continuePoll() on the I/O thread.
    if (sock_obj && sock_obj->getSocket() >= 0) {
        sock_obj->close();
    }
    notifyPendingStreams(err, desc, xsink);
    if (connection_priv) {
        connection_priv->setClosed();
    }
    connection_priv = nullptr;
}

void Http2ClientPollOperationPriv::notifyPendingStreams(const char* err, const char* desc,
        ExceptionSink* xsink) {
    std::unordered_map<std::string, AbstractAsyncAction*> actions_copy;
    {
        AutoLocker al(stream_lock);
        actions_copy = std::move(stream_actions);
        stream_actions.clear();
        active_stream_count = 0;
    }

    // Pure C++ error dispatch — no execValue()
    for (auto& [sid, action] : actions_copy) {
        if (action) {
            action->executeError(err, desc, xsink);
            action->deref(xsink);
        }
    }
}

void Http2ClientPollOperationPriv::fireReadyCallback(ExceptionSink* xsink) {
    if (connection_priv) {
        connection_priv->onConnectionReady();  // Pure C++, no evalMethod, I/O-thread safe
    }
}

// --- Stream queue management (I/O thread) ---

void Http2ClientPollOperationPriv::registerStreamQueue(int32_t stream_id, Queue* queue,
        QoreObject* queue_obj, QoreEventNotifier* notifier, QoreObject* notifier_obj) {
    // If there's already a registration for this stream, update it
    auto it = stream_queues.find(stream_id);
    if (it != stream_queues.end()) {
        if (it->second.notifier && it->second.notifier != notifier) {
            ExceptionSink xsink;
            it->second.notifier->deref(&xsink);
        }
        if (it->second.notifier_obj && it->second.notifier_obj != notifier_obj) {
            ExceptionSink xsink;
            it->second.notifier_obj->deref(&xsink);
        }
        if (it->second.queue != queue) {
            ExceptionSink xsink;
            it->second.queue->deref(&xsink);
        }
        if (it->second.queue_obj != queue_obj) {
            ExceptionSink xsink;
            it->second.queue_obj->deref(&xsink);
        }
        it->second = {queue, queue_obj, notifier, notifier_obj};
    } else {
        stream_queues[stream_id] = {queue, queue_obj, notifier, notifier_obj};
    }

    // Immediately drain any data already buffered in the H2 session for this
    // stream. DATA frames may arrive in the same TCP segment as the CONNECT
    // response. Without this drain, the data sits there until the next
    // continuePoll cycle — which may never come because the SSL/TCP buffers
    // are empty (analogous to the SSL data hole).
    ExceptionSink xsink;
    while (true) {
        BinaryNode* data = sock_obj->readHttp2StreamData(stream_id, 0, &xsink);
        if (xsink) {
            xsink.clear();
            break;
        }
        if (!data || data->empty()) {
            if (data) {
                data->deref(&xsink);
            }
            break;
        }
        queue->push(&xsink, data);
        if (xsink) {
            data->deref(&xsink);
            xsink.clear();
            break;
        }
        data_ready_streams.push_back(stream_id);
    }
}

void Http2ClientPollOperationPriv::drainStreamQueues(ExceptionSink* xsink) {
    if (stream_queues.empty()) {
        return;
    }

    std::vector<int32_t> completed;
    for (auto& [stream_id, info] : stream_queues) {
        int drain_count = 0;
        while (true) {
            BinaryNode* data = sock_obj->readHttp2StreamData(stream_id, 0, xsink);
            if (*xsink) {
                return;
            }
            if (!data) {
                break;
            }
            if (data->empty()) {
                data->deref(xsink);
                break;
            }
            ++drain_count;
            info.queue->push(xsink, data);
            if (*xsink) {
                data->deref(xsink);
                return;
            }
        }

        if (drain_count > 0) {
            data_ready_streams.push_back(stream_id);
        }

        // Check stream closure (remote END_STREAM or RST_STREAM/GOAWAY)
        if (sock_obj->isHttp2StreamRemoteClosed(stream_id)
                || sock_obj->isHttp2StreamClosed(stream_id)) {
            // Push NOTHING sentinel so the handler thread knows the stream is done
            info.queue->push(xsink, QoreValue());
            if (*xsink) {
                return;
            }
            if (std::find(data_ready_streams.begin(), data_ready_streams.end(),
                    stream_id) == data_ready_streams.end()) {
                data_ready_streams.push_back(stream_id);
            }
            completed.push_back(stream_id);
        }
    }

    // Remove completed streams and deref their objects
    for (int32_t sid : completed) {
        auto it = stream_queues.find(sid);
        if (it != stream_queues.end()) {
            it->second.queue->deref(xsink);
            it->second.queue_obj->deref(xsink);
            if (it->second.notifier) {
                it->second.notifier->deref(xsink);
            }
            if (it->second.notifier_obj) {
                it->second.notifier_obj->deref(xsink);
            }
            stream_queues.erase(it);
        }
    }
}

void Http2ClientPollOperationPriv::clearStreamQueues(ExceptionSink* xsink) {
    for (auto& [stream_id, info] : stream_queues) {
        // Push an error marker instead of NOTHING so consumers (e.g.,
        // WebSocketClientHcioPollOp) can distinguish "connection closed"
        // from "no data available" (timeout).
        ReferenceHolder<QoreHashNode> err_hash(new QoreHashNode(autoTypeInfo), xsink);
        err_hash->setKeyValue("error", true, xsink);
        err_hash->setKeyValue("end_stream", true, xsink);
        info.queue->push(xsink, err_hash.release());
        if (info.notifier) {
            info.notifier->notify();
        }
        info.queue->deref(xsink);
        info.queue_obj->deref(xsink);
        if (info.notifier) {
            info.notifier->deref(xsink);
        }
        if (info.notifier_obj) {
            info.notifier_obj->deref(xsink);
        }
    }
    stream_queues.clear();
}

// --- Stream management (app thread) ---

int64_t Http2ClientPollOperationPriv::submitRequest(const char* method, const char* path,
        const QoreHashNode* user_headers, const void* body, size_t body_len,
        bool streaming, AbstractAsyncAction* action, int max_streams,
        ExceptionSink* xsink) {
    // State check
    H2State cur_state = h2_state.load(std::memory_order_acquire);
    if (cur_state != H2State::READING && cur_state != H2State::WAIT_READ) {
        action->deref(xsink);
        xsink->raiseException("HTTP2-STATE-ERROR",
            "cannot submit request in state: %s", getStateImpl());
        return -1;
    }

    // Build complete header hash with pseudo-headers
    ReferenceHolder<QoreHashNode> req_headers(new QoreHashNode(autoTypeInfo), xsink);
    if (user_headers) {
        ConstHashIterator hi(user_headers);
        while (hi.next()) {
            req_headers->setKeyValue(hi.getKey(), hi.get().refSelf(), xsink);
        }
    }

    // Set pseudo-headers if not present
    if (req_headers->getKeyValue(":method").isNullOrNothing()) {
        req_headers->setKeyValue(":method", new QoreStringNode(method), xsink);
    }
    if (req_headers->getKeyValue(":path").isNullOrNothing()) {
        req_headers->setKeyValue(":path",
            new QoreStringNode(path && *path ? path : "/"), xsink);
    }
    if (req_headers->getKeyValue(":scheme").isNullOrNothing()) {
        req_headers->setKeyValue(":scheme",
            new QoreStringNode(ssl_required ? "https" : "http"), xsink);
    }
    if (req_headers->getKeyValue(":authority").isNullOrNothing()) {
        int default_port = ssl_required ? 443 : 80;
        if (target_port == default_port) {
            req_headers->setKeyValue(":authority",
                new QoreStringNode(target_host.c_str()), xsink);
        } else {
            QoreStringNode* authority = new QoreStringNode();
            authority->sprintf("%s:%d", target_host.c_str(), target_port);
            req_headers->setKeyValue(":authority", authority, xsink);
        }
    }

    // Check for errors from header construction before acquiring lock
    if (*xsink) {
        action->deref(xsink);
        return -1;
    }

    AutoLocker al(stream_lock);

    // Capacity check
    if (max_streams && active_stream_count >= max_streams) {
        action->deref(xsink);
        xsink->raiseException("HTTP2-CAPACITY-ERROR",
            "connection at capacity: %d/%d streams",
            active_stream_count, max_streams);
        return -1;
    }

    // Submit to socket (acquires socket internal lock)
    int32_t stream_id = sock_obj->submitHttp2Request(*req_headers, body, body_len, xsink,
        streaming);
    if (*xsink || stream_id < 0) {
        action->deref(xsink);
        return -1;
    }

    // If the action is a streaming consumer (ChannelAction), mark the stream
    // for incremental response body delivery.  This enables the existing
    // hasStreamingData()/takeStreamData() mechanism in continuePoll() to
    // deliver DATA chunks to the Channel as they arrive, instead of waiting
    // for END_STREAM (which never comes for SSE streams).
    if (action->isStreaming()) {
        sock_obj->setHttp2StreamStreaming(stream_id);
    }

    // Register action (take ownership — action was created with refcount 1 by caller)
    std::string sid = std::to_string(stream_id);
    stream_actions[sid] = action;
    ++active_stream_count;

    return stream_id;
}

bool Http2ClientPollOperationPriv::cancelStream(int64_t stream_id, ExceptionSink* xsink) {
    std::string sid = std::to_string(stream_id);

    AutoLocker al(stream_lock);
    auto it = stream_actions.find(sid);
    if (it == stream_actions.end()) {
        return false;  // already completed
    }

    // Notify the action of cancellation, then release
    it->second->executeError("HTTP2-CANCELLED", "request cancelled", xsink);
    it->second->deref(xsink);
    stream_actions.erase(it);
    --active_stream_count;
    return true;
}

void Http2ClientPollOperationPriv::sendStreamData(int64_t stream_id, const BinaryNode* data,
        bool end_stream, ExceptionSink* xsink) {
    H2State cur_state = h2_state.load(std::memory_order_acquire);
    if (cur_state != H2State::READING && cur_state != H2State::WAIT_READ) {
        xsink->raiseException("HTTP2-STATE-ERROR",
            "cannot send data in state: %s", getStateImpl());
        return;
    }
    sock_obj->sendHttp2StreamData(stream_id, data, end_stream, xsink);
}

/** @endcond */

//! C++ base class for HTTP/2 client poll operations
/** This class provides the SocketPollOperationBase fast path for the
    AsyncIoController, implementing the HTTP/2 client poll state machine
    (connecting, ssl_upgrade, proxy_connect_send/recv, reading, wait_read,
    closed) entirely in C++.

    The Qore Http2ClientPollOperation class inherits from this base to get
    the C++ fast path while providing the high-level HTTP/2 API.

    @since %Qore 2.3
*/
qclass Http2ClientPollOperationBase [
    private_members=object sock,string goal,auto data_save;
    ns=Qore;
    arg=Http2ClientPollOperationPriv* priv;
    vparent=SocketPollOperationBase
];

//! Creates the HTTP/2 client poll operation base
/** @param sock the TCP socket (must not be connected yet)
    @param connect_target the TCP connect target ("host:port")
    @param target_host the target hostname for :authority and proxy CONNECT
    @param target_port the target port number
    @param ssl_required True if SSL/TLS is required (HTTPS)
    @param proxy_tunnel True if a proxy CONNECT tunnel is needed
    @param connection the owning HttpClientConnection object
*/
Http2ClientPollOperationBase::constructor(Socket[QoreSocketObject] sock, string connect_target,
        string target_host, int target_port, bool ssl_required, bool proxy_tunnel,
        AbstractHttpPollConnection[AbstractHttpPollConnectionPriv] connection) {
    QoreSocketObject* sock_ptr = *sock;

    // Create initial TCP connect operation
    sock_ptr->ref();
    ReferenceHolder<SocketConnectPollOperation> connect_op(
        new SocketConnectPollOperation(xsink, false, connect_target->c_str(), sock_ptr),
        xsink);
    if (*xsink) {
        return;
    }

    // Set up Qore object members
    QoreValue sock_arg = args->retrieveEntry(0);
    QoreObject* sock_obj = sock_arg.getType() == NT_OBJECT
        ? const_cast<QoreObject*>(sock_arg.get<const QoreObject>()) : nullptr;
    if (sock_obj) {
        self->setMemberValue("sock", QC_HTTP2CLIENTPOLLOPERATIONBASE,
            sock_obj->refSelf(), xsink);
    }
    self->setMemberValue("goal", QC_HTTP2CLIENTPOLLOPERATIONBASE,
        new QoreStringNode("http2_client_multiplex"), xsink);

    // Set self on the connect op so it can build SocketPollInfo hashes
    SocketConnectPollOperation* connect_ptr = connect_op.release();
    connect_ptr->setSelf(self);

    // Create the private data — ref sock for private data ownership
    // Extract the raw C++ priv pointer for direct I/O-thread calls;
    // the Qore-level connection_ref member holds the only strong QoreObject ref
    AbstractHttpPollConnectionPriv* conn_priv = *connection;
    sock_ptr->ref();
    self->setPrivate(CID_HTTP2CLIENTPOLLOPERATIONBASE,
        new Http2ClientPollOperationPriv(self, sock_ptr, connect_ptr,
            ssl_required, proxy_tunnel,
            target_host->c_str(), (int)target_port, conn_priv));
}

//! Destroys the object
/** Releases all internal references.
*/
Http2ClientPollOperationBase::destructor() {
    priv->cleanup(xsink);
    priv->deref(xsink);
}

//! Returns the goal
/** @return the goal string
*/
string Http2ClientPollOperationBase::getGoal() [flags=RET_VALUE_ONLY] {
    return self->getReferencedMemberNoMethod("goal", xsink);
}

//! Returns the current state
/** @return the current state string
*/
string Http2ClientPollOperationBase::getState() [flags=RET_VALUE_ONLY] {
    return priv->getState();
}

//! Returns True when the goal has been reached
/** @return always False (long-running multiplexed operation)
*/
bool Http2ClientPollOperationBase::goalReached() [flags=RET_VALUE_ONLY] {
    return priv->goalReached();
}

//! Continues the poll operation
/** @return socket poll info for the next poll cycle, or NOTHING if complete
*/
*hash<SocketPollInfo> Http2ClientPollOperationBase::continuePoll() {
    return priv->continuePoll(xsink);
}

//! Aborts the operation
/** Closes the HTTP/2 connection and notifies all pending streams.
*/
nothing Http2ClientPollOperationBase::abort() {
    priv->abort(xsink);
}

//! Returns output from the inner operation
/** @return any output data from the inner operation
*/
auto Http2ClientPollOperationBase::getOutput() [flags=RET_VALUE_ONLY] {
    return priv->getOutput();
}

//! Returns True if the connection is closed
/** @return True if closed
*/
bool Http2ClientPollOperationBase::isClosed() [flags=RET_VALUE_ONLY] {
    return priv->isClosed();
}

//! Returns True if the connection is ready for requests
/** @return True if ready (in reading state and H2 protocol confirmed)
*/
bool Http2ClientPollOperationBase::isReady() [flags=RET_VALUE_ONLY] {
    return priv->isReady();
}

//! Returns True if an error occurred
/** @return True if error
*/
bool Http2ClientPollOperationBase::hasError() [flags=RET_VALUE_ONLY] {
    return priv->hasError();
}

//! Returns error information if an error occurred
/** @return error hash or NOTHING
*/
*hash<auto> Http2ClientPollOperationBase::getError() [flags=RET_VALUE_ONLY] {
    return priv->getErrorInfo();
}

//! Returns the number of active streams (lock-free)
/** @return active stream count
*/
int Http2ClientPollOperationBase::getActiveStreamCount() [flags=RET_VALUE_ONLY] {
    return priv->getActiveStreamCount();
}

//! Submits an HTTP/2 request with Promise-based response delivery
/** @param method HTTP method (GET, POST, etc.)
    @param path request path
    @param headers optional request headers (may include pseudo-headers)
    @param body optional request body (string or binary)
    @param promise Promise to resolve with the response
    @param max_streams maximum concurrent streams (0 = unlimited)
    @return the stream ID assigned to this request
*/
int Http2ClientPollOperationBase::submitRequest(string method, string path,
        *hash<auto> headers, *data body, Promise[QorePromise] promise, int max_streams) {
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (body) {
        switch (body->getType()) {
            case NT_BINARY: {
                const BinaryNode* b = static_cast<const BinaryNode*>(body);
                body_ptr = b->getPtr();
                body_len = b->size();
                break;
            }
            case NT_STRING: {
                const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
                body_ptr = str->c_str();
                body_len = str->size();
                break;
            }
            default:
                xsink->raiseException("HTTP2-ERROR",
                    "body must be string or binary, got type '%s'",
                    body->getTypeName());
                return -1;
        }
    }

    // Get the Promise QoreObject to prevent GC (which triggers promiseDestroyed())
    QoreObject* promise_obj = const_cast<QoreObject*>(
        get_param_value(args, 4).get<const QoreObject>());

    // Create PromiseAction — caller creates with refcount 1,
    // priv->submitRequest takes ownership (stores or derefs on failure)
    PromiseAction* action = new PromiseAction(*promise, promise_obj);
    return (int)priv->submitRequest(method->c_str(), path->c_str(), headers,
        body_ptr, body_len, false, action, (int)max_streams, xsink);
}

//! Submits an HTTP/2 request with Promise + EventNotifier for poll-based delivery
/** Like submitRequest() but additionally signals @a notifier when the response
    arrives so that a continuePoll() state machine can call Future::get()
    non-blockingly — eliminating the need for a background thread.

    @param method HTTP method (GET, POST, etc.)
    @param path request path
    @param headers optional request headers (may include pseudo-headers)
    @param body optional request body (string or binary)
    @param promise Promise to resolve with the response
    @param notifier EventNotifier to signal after the Promise is resolved
    @param max_streams maximum concurrent streams (0 = unlimited)
    @return the stream ID assigned to this request

    @since %Qore 2.3
*/
int Http2ClientPollOperationBase::submitRequestWithNotifier(string method, string path,
        *hash<auto> headers, *data body, Promise[QorePromise] promise,
        EventNotifier[QoreEventNotifier] notifier, int max_streams) {
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (body) {
        switch (body->getType()) {
            case NT_BINARY: {
                const BinaryNode* b = static_cast<const BinaryNode*>(body);
                body_ptr = b->getPtr();
                body_len = b->size();
                break;
            }
            case NT_STRING: {
                const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
                body_ptr = str->c_str();
                body_len = str->size();
                break;
            }
            default:
                xsink->raiseException("HTTP2-ERROR",
                    "body must be string or binary, got type '%s'",
                    body->getTypeName());
                return -1;
        }
    }

    // Get QoreObject pointers for the Promise and EventNotifier (prevent GC)
    QoreObject* promise_obj = const_cast<QoreObject*>(
        get_param_value(args, 4).get<const QoreObject>());
    QoreObject* notifier_obj = const_cast<QoreObject*>(
        get_param_value(args, 5).get<const QoreObject>());

    // Create CompositeAction: PromiseAction resolves Future, then EventNotifierAction
    // signals the notifier fd — both are pure C++, safe on the I/O thread
    AbstractAsyncAction* action = createPromiseWithNotifierAction(
        promise_obj, notifier_obj, xsink);
    if (!action) {
        return -1;
    }
    return (int)priv->submitRequest(method->c_str(), path->c_str(), headers,
        body_ptr, body_len, false, action, (int)max_streams, xsink);
}

//! Submits an HTTP/2 streaming request with Channel-based response delivery
/** @param method HTTP method (GET, POST, etc.)
    @param path request path
    @param headers optional request headers
    @param body optional request body
    @param channel Channel for incremental response delivery
    @param max_streams maximum concurrent streams (0 = unlimited)
    @param streaming if True, keep the request body stream open (bidirectional)
    @return the stream ID assigned to this request
*/
int Http2ClientPollOperationBase::submitRequestStreaming(string method, string path,
        *hash<auto> headers, *data body, object channel, int max_streams,
        bool streaming = False) {
    // Extract QoreChannel private data from the Channel object
    QoreChannel* ch = static_cast<QoreChannel*>(
        const_cast<QoreObject*>(channel)->getReferencedPrivateData(CID_CHANNEL, xsink));
    if (!ch) {
        if (!*xsink) {
            xsink->raiseException("CHANNEL-ERROR", "invalid Channel object");
        }
        return -1;
    }
    ReferenceHolder<QoreChannel> ch_holder(ch, xsink);

    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (body) {
        switch (body->getType()) {
            case NT_BINARY: {
                const BinaryNode* b = static_cast<const BinaryNode*>(body);
                body_ptr = b->getPtr();
                body_len = b->size();
                break;
            }
            case NT_STRING: {
                const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
                body_ptr = str->c_str();
                body_len = str->size();
                break;
            }
            default:
                xsink->raiseException("HTTP2-ERROR",
                    "body must be string or binary, got type '%s'",
                    body->getTypeName());
                return -1;
        }
    }

    // Create ChannelAction — priv takes ownership
    ChannelAction* action = new ChannelAction(ch);
    return (int)priv->submitRequest(method->c_str(), path->c_str(), headers,
        body_ptr, body_len, streaming, action, (int)max_streams, xsink);
}

//! Cancel a stream
/** @param stream_id the stream to cancel
    @return True if the stream was found and cancelled
*/
bool Http2ClientPollOperationBase::cancelStream(int stream_id) {
    return priv->cancelStream(stream_id, xsink);
}

//! Send data on a streaming HTTP/2 request
/** @param stream_id the stream ID to send data on
    @param data the data to send (string or binary)
    @param end_stream if True, signals end of stream
*/
nothing Http2ClientPollOperationBase::sendStreamData(int stream_id, data data,
        bool end_stream = False) {
    if (data.getType() == NT_BINARY) {
        priv->sendStreamData(stream_id, data.get<const BinaryNode>(), end_stream, xsink);
    } else if (data.getType() == NT_STRING) {
        const QoreStringNode* str = data.get<const QoreStringNode>();
        SimpleRefHolder<BinaryNode> bin(new BinaryNode());
        bin->append(str->c_str(), str->size());
        priv->sendStreamData(stream_id, *bin, end_stream, xsink);
    } else {
        xsink->raiseException("HTTP2-ERROR",
            "data must be string or binary, got type '%s'",
            data.getFullTypeName());
    }
}

//! Registers a Queue for async stream data delivery
/** Called when setting up a CONNECT stream (WebSocket, SSE, etc.) to receive
    data asynchronously via the I/O controller's drain cycle.

    @param stream_id the HTTP/2 stream ID
    @param queue the Queue for data delivery
    @param notifier optional EventNotifier for handler wake-up

    @note Must be called on the I/O controller thread before the handler starts reading.

    @since %Qore 2.3
*/
nothing Http2ClientPollOperationBase::registerStreamQueue(int stream_id,
        Queue[Queue] queue, *EventNotifier[QoreEventNotifier] notifier) {
    Queue* queue_ptr = queue.release();
    const_cast<QoreObject*>(obj_queue)->ref();

    QoreEventNotifier* notifier_ptr = nullptr;
    QoreObject* notifier_obj_ptr = nullptr;
    if (notifier) {
        notifier_ptr = notifier.release();
        notifier_obj_ptr = const_cast<QoreObject*>(obj_notifier);
        notifier_obj_ptr->ref();
    }

    priv->registerStreamQueue(static_cast<int32_t>(stream_id), queue_ptr,
        const_cast<QoreObject*>(obj_queue), notifier_ptr, notifier_obj_ptr);
}

//! Clears all stream queue registrations
/** Pushes NOTHING sentinels to all registered queues and notifies all
    EventNotifiers so handler threads wake up and see the stream is closed.

    @since %Qore 2.3
*/
nothing Http2ClientPollOperationBase::clearStreamQueues() {
    priv->clearStreamQueues(xsink);
}

//! Returns the socket object
/** @return the socket
*/
Socket Http2ClientPollOperationBase::getSocket() [flags=RET_VALUE_ONLY] {
    return self->getReferencedMemberNoMethod("sock", xsink);
}
