#include <qore/Qore.h>
#include "qore/intern/qore_dbi_private.h"
#include "qore/intern/QoreMiscMembersOps.h"

/** @defgroup old_dbi_functions Old DBI Functions
    Old DBI functions; see @ref dbi_functions
 */
///@{
namespace Qore::SQL;

//! Returns a @ref datasource_hash "datasource hash" of the components of a datasource string
/**
    @param ds a string describing the datasource with the following syntax:\n
    <tt>[</tt><em>driver</em><tt>:][</tt><em>user</em><tt>/</tt><em>pass</em><tt>]\@</tt><em>db</em><tt>[(</tt><em>charset</em><tt>)][%</tt><em>host</em><tt>[:</tt><em>port</em><tt>][{</tt><em>option</em><tt>=</tt><em>val</em><tt>[,...]}]</tt> \n
    where all elements except <tt>\@</tt><em>db</em> are optional

    @return a @ref datasource_hash "datasource hash" of the components of a datasource string

    @throw DATASOURCE-PARSE-ERROR a syntax error occurred parsing the datasource string (missing field, unexpected character, etc), or the string contains a NUL character (since %Qore 3.0); the string is not shown in the exception, as it can contain a user name, a password and a database name; only its driver name is shown (since %Qore 3.0)
    @throw ENCODING-CONVERSION-ERROR the string cannot be converted to the @ref default_encoding "default encoding"; the string is not shown in the exception (since %Qore 3.0)

    @note the string is converted to the @ref default_encoding "default encoding", in which the strings of the hash are returned (since %Qore 3.0)
    @note a datasource string without a driver prefix is ambiguous: in a string such as <tt>scott:tiger\@orcl</tt>, the
    text before the first \c ":" is taken as the driver name, so the user name would be shown as the driver name in
    messages (the password and the database name never are); always give the driver prefix (ex:
    <tt>oracle:scott/tiger\@orcl</tt>)

    @deprecated use parse_datasource() instead; camel-case function names were deprecated in %Qore 0.8.12
 */
hash parseDatasource(string ds) [flags=RET_VALUE_ONLY,DEPRECATED] {
    // converted to the default encoding and checked for a NUL character first
    return q_parse_datasource_string(*ds, xsink);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing parseDatasource() [flags=NOOP,DEPRECATED] {
}

//! Returns a list of strings of DBI drivers currently loaded or @ref nothing if no drivers are loaded
/**
    @return a list of strings of DBI drivers currently loaded or @ref nothing if no drivers are loaded

    @deprecated use dbi_get_driver_list() instead; camel-case function names were deprecated in %Qore 0.8.12
 */
*list<string> getDBIDriverList() [flags=CONSTANT,DEPRECATED] {
    return qore_dbi_driver_list_ops(DBI).getDriverList();
}

//! Returns a list of each capability supported by the given DBI driver (see @ref dbi_capabilities) or @ref nothing if the driver cannot be found
/**
    @param driver the name of the driver; if the given driver is not loaded then the function returns @ref nothing

    @return a list of each capability supported by the given DBI driver (see @ref dbi_capabilities) or @ref nothing if the driver cannot be found

    @deprecated use dbi_get_driver_capability_list() instead; camel-case function names were deprecated in %Qore 0.8.12

    @note since %Qore 3.0 a driver name with a NUL character returns @ref nothing, and @ref Qore::errno() "errno()" returns
    \c EINVAL
*/
*list<string> getDBIDriverCapabilityList(string driver) [flags=CONSTANT,DEPRECATED] {
    // the driver name is looked up as a C string, which would be cut at a NUL character
    if (q_check_no_nul(driver->c_str(), driver->size())) {
        return QoreValue();
    }
    DBIDriver *dd = DBI.find(driver->getBuffer());
    return !dd ? QoreValue() : QoreValue(qore_dbi_private::get(*dd)->getCapList());
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing getDBIDriverCapabilityList() [flags=NOOP,DEPRECATED] {
}

//! Returns an integer representing the capabilities of a DBI driver binary-OR'ed together (see @ref dbi_capabilities) or @ref nothing if the driver is not already loaded
/**
    @param driver the name of the driver; if the given driver is not already loaded then this function returns @ref nothing

    @return an integer representing the capabilities of a DBI driver binary-OR'ed together (see @ref dbi_capabilities) or @ref nothing if the driver is not already loaded

    @deprecated use dbi_get_driver_capabilities() instead; camel-case function names were deprecated in %Qore 0.8.12

    @note since %Qore 3.0 a driver name with a NUL character returns @ref nothing, and @ref Qore::errno() "errno()" returns
    \c EINVAL
*/
*int getDBIDriverCapabilities(string driver) [flags=CONSTANT,DEPRECATED] {
    // the driver name is looked up as a C string, which would be cut at a NUL character
    if (q_check_no_nul(driver->c_str(), driver->size())) {
        return QoreValue();
    }
    DBIDriver* dd = DBI.find(driver->getBuffer());
    return !dd ? QoreValue() : QoreValue(qore_dbi_private::get(*dd)->getCaps());
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
*/
nothing getDBIDriverCapabilities() [flags=NOOP,DEPRECATED] {
}
///@}

/** @defgroup dbi_functions DBI Functions
    These DBI functions were added in %Qore 0.8.6; the original functions used camel case names and had @ref NOOP variants (see @ref old_dbi_functions)

    @section datasource_hash Datasource Hash
    |!Key|!Description
    |\c type|the name of the driver, if present
    |\c user|the username given in the string
    |\c pass|the password for the connection
    |\c db|the database name for the connection
    |\c charset|The name of the DB-specific character encoding to use for the connection, if present in the string
    |\c host|the hostname for the connection, if present in the string
    |\c port|the port number to use for the connection, if present in the string
    |\c options|A hash of options given in the string, if present. Special options are \c "min" and \c "max", which \
        are respected by the \
        @ref Qore::SQL::DatasourcePool::constructor(hash<auto>, __7_ Qore::Thread::Queue, auto) "DatasourcePool::constructor(hash<auto>, *Queue, auto)" \
        variant for setting the minimum and maximum connections in the pool, respectively; other options are passed \
        to the DBI driver

    @section datasource_secrets Credentials in Datasource Messages
    The exceptions of %Qore about a datasource string, a @ref datasource_hash "datasource hash" or the connection values
    of a @ref Qore::SQL::Datasource "Datasource" or @ref Qore::SQL::DatasourcePool "DatasourcePool", and the
    descriptions of datasources in its messages and logs, never show the user name, the password or the database name
    of a datasource (since %Qore 3.0):
    - an error about a datasource string that cannot be parsed shows only its driver name (as
      <tt><em>driver</em>:****</tt>), or \c "****" if it has no valid driver name
    - the errors of a datasource show its masked description: its driver, host and port, with the user name, the
      password and the database name masked as \c "****"
      (ex: <tt>pgsql:****</tt><tt>/****</tt><tt>\@****%dbhost:5432</tt>);
      @ref Qore::SQL::mask_datasource(string) "mask_datasource()" and
      @ref Qore::SQL::AbstractDatasource::getMaskedDescription() "AbstractDatasource::getMaskedDescription()" give this
      description to Qore code
    - a driver name is shown only if it is a valid driver name (only ASCII letters, digits, \c "_" and \c "-"); a
      driver name that is not valid, such as a datasource string given as the driver name, is not looked up or loaded
      as a module, and is rejected without being shown
    - a host name is shown only if it has only ASCII letters, digits, \c ".", \c "-", \c "_", \c ":", \c "[" and
      \c "]" (the characters of a host name or an IP address); a host with any other character, such as a control
      character, a space or a \c "/" (a socket path), is shown as \c "****"
    - the option block of a datasource string is found from its last \c "{", so a \c "{" in a password can make a
      part of the password and the database name the option block, and a part of the password the host: a string
      with an option name with \c "@" is refused with \c DATASOURCE-PARSE-ERROR, which shows no option name, and
      @ref Qore::SQL::mask_datasource(string) "mask_datasource()" describes a string with an option value with
      \c "@" by its driver name only; a password with \c "{" can still make a datasource string ambiguous, so give
      such a password in a @ref datasource_hash "datasource hash" or with the connection arguments of
      @ref Qore::SQL::Datasource "Datasource" and @ref Qore::SQL::DatasourcePool "DatasourcePool"
    - the debug output of URL parsing shows no URL or password

    A datasource string without a driver prefix is ambiguous: in a string such as <tt>scott:tiger\@orcl</tt>, the text
    before the first \c ":" is taken as the driver name; always give the driver prefix.

    @subsection datasource_mask_options Masked Forms That Identify a Connection
    The masked description above is for messages, also those that restricted code can see: it shows neither the user
    name nor the database name.  A form that identifies a connection, such as the safe URL of a \c db:// connection
    that a user interface or a log shows, or the configuration that serialized @ref sqlutilintro "SqlUtil" data keeps,
    shows more, given with the \a opts of @ref Qore::SQL::mask_datasource(string, *hash<auto>) "mask_datasource()" and
    @ref Qore::SQL::mask_datasource_hash(string, *hash<auto>) "mask_datasource_hash()":
    |!Option|!Type|!Description
    |\c show_db|\c bool|the database name is shown, if it has no control character
    |\c show_options|\c bool|the character encoding and the names of the options are shown, with every option value \
        masked as \c "****"

    The two rules side by side:
    |!Part|!Messages (the default)|!Forms that identify a connection (\c show_db, \c show_options)
    |driver, host, port|shown|shown
    |user name|\c "****"|\c "****"
    |password|\c "****"|\c "****" (never in the hash form)
    |database name|\c "****"|shown
    |character encoding|not shown|shown
    |option names|not shown|shown
    |option values|not shown|\c "****"

    Every option value is masked, as no DBI driver declares which of its options hold secrets: a driver option can
    hold a credential, such as a full connection string.

    (ex: <tt>pgsql:****</tt><tt>/****</tt><tt>\@orders%dbhost:5432{min=****}</tt>)
*/
///@{
namespace Qore::SQL;

//! Returns a @ref datasource_hash "datasource hash" of the components of a datasource string
/**
    @param datasource a string describing the datasource with the following syntax:\n
    <tt>[</tt><em>driver</em><tt>:][</tt><em>user</em><tt>/</tt><em>pass</em><tt>]\@</tt><em>db</em><tt>[(</tt><em>charset</em><tt>)][%</tt><em>host</em><tt>[:</tt><em>port</em><tt>][{</tt><em>option</em><tt>=</tt><em>val</em><tt>[,...]}]</tt> \n
    where all elements except <tt>\@</tt><em>db</em> are optional

    @return a @ref datasource_hash "datasource hash" of the components of a datasource string

    @par Host and port
    The host ends at the first \c ":" after it, which gives the port; an IPv6 address, which has colons of its own,
    is given in brackets (ex: <tt>%[::1]:5432</tt>), and the \c host key has it without them.  A port is a number
    from 1 to 65535: a port that is 0, larger than 65535, negative or not a number raises \c DATASOURCE-PARSE-ERROR
    (since %Qore 3.0).  A string without a port gives no \c port key: the driver's default port is used.  The port
    argument of the @ref Qore::SQL::Datasource "Datasource" constructor and of
    @ref Qore::SQL::Datasource::setPort() "Datasource::setPort()" is another interface, where 0 means the default
    port.

    @par Example:
    @code{.py}
hash<auto> h = parse_datasource("pgsql:user/pass@dbname(utf8)%dbhost.internal:1521{min=4,max=10}");
    @endcode

    @throw DATASOURCE-PARSE-ERROR a syntax error occurred parsing the datasource string (missing field, unexpected
    character, an invalid port, etc), or the string contains a NUL character (since %Qore 3.0); the string is not
    shown in the exception, as it can contain a user name, a password and a database name; only its driver name is
    shown (since %Qore 3.0)
    @throw ENCODING-CONVERSION-ERROR the string cannot be converted to the @ref default_encoding "default encoding";
    the string is not shown in the exception (since %Qore 3.0)

    @note
    - the string is converted to the @ref default_encoding "default encoding", in which the strings of the hash are
      returned, as a @ref Qore::SQL::Datasource "Datasource" keeps its connection values in it (since %Qore 3.0)
    - similar to parseDatasource() except uses the standard function naming scheme (i.e. \c "names_like_this()"
      instead of \c "camelCase()") and does not have a @ref NOOP variant
    - a datasource string without a driver prefix is ambiguous: in a string such as <tt>scott:tiger\@orcl</tt>, the
      text before the first \c ":" is taken as the driver name, so the user name would be shown as the driver name in
      messages (the password and the database name never are); always give the driver prefix (ex:
      <tt>oracle:scott/tiger\@orcl</tt>)

    @since %Qore 0.8.6
*/
hash<auto> parse_datasource(string datasource) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    // converted to the default encoding and checked for a NUL character first
    return q_parse_datasource_string(*datasource, xsink);
}

//! Returns a list of strings of DBI drivers currently loaded or @ref nothing if no drivers are loaded
/**
    @return a list of strings of DBI drivers currently loaded or @ref nothing if no drivers are loaded

    @par Example:
    @code{.py}
*list<string> l = dbi_get_driver_list();
    @endcode

    @note similar to getDBIDriverList() except uses the standard function naming scheme (i.e. \c "names_like_this()"
    instead of \c "camelCase()")

    @since %Qore 0.8.6
*/
*list<string> dbi_get_driver_list() [flags=CONSTANT] {
    return qore_dbi_driver_list_ops(DBI).getDriverList();
}

//! Returns a list of each capability supported by the given DBI driver (see @ref dbi_capabilities) or @ref nothing if the driver cannot be found
/**
    @param driver the name of the driver; if the given driver is not loaded then the function returns @ref nothing

    @return a list of each capability supported by the given DBI driver (see @ref dbi_capabilities) or @ref nothing if
    the driver cannot be found

    @par Example:
    @code{.py}
*list<string> l = dbi_get_driver_capability_list("pgsql");
    @endcode

    @note similar to getDBIDriverCapabilityList() except uses the standard function naming scheme (i.e.
    \c "names_like_this()" instead of \c "camelCase()") and does not have a @ref NOOP variant

    @since %Qore 0.8.6

    @note since %Qore 3.0 a driver name with a NUL character returns @ref nothing, and @ref Qore::errno() "errno()" returns
    \c EINVAL
*/
*list<string> dbi_get_driver_capability_list(string driver) [flags=CONSTANT,NAMED_ARGS] {
    // the driver name is looked up as a C string, which would be cut at a NUL character
    if (q_check_no_nul(driver->c_str(), driver->size())) {
        return QoreValue();
    }
    DBIDriver *dd = DBI.find(driver->getBuffer());
    return !dd ? 0 : qore_dbi_private::get(*dd)->getCapList();
}

//! Returns an integer representing the capabilities of a DBI driver binary-OR'ed together (see @ref dbi_capabilities) or 0 if the driver is not already loaded
/** @param driver the name of the driver; if the given driver is not already loaded then this function returns
    @ref nothing

    @return an integer representing the capabilities of a DBI driver binary-OR'ed together (see @ref dbi_capabilities)
    or 0 if the driver is not already loaded

    @par Example:
    @code{.py}
int caps = dbi_get_driver_capabilities("pgsql");
    @endcode

    @note similar to getDBIDriverCapabilities() except uses the standard function naming scheme (i.e.
    \c "names_like_this()" instead of \c "camelCase()"), always returns an @ref int_type, and does not have a
    @ref NOOP variant

    @since %Qore 0.8.6

    @note since %Qore 3.0 a driver name with a NUL character returns 0, and @ref Qore::errno() "errno()" returns
    \c EINVAL
*/
int dbi_get_driver_capabilities(string driver) [flags=CONSTANT,NAMED_ARGS] {
    // the driver name is looked up as a C string, which would be cut at a NUL character
    if (q_check_no_nul(driver->c_str(), driver->size())) {
        return 0;
    }
    DBIDriver* dd = DBI.find(driver->getBuffer());
    return !dd ? 0 : qore_dbi_private::get(*dd)->getCaps();
}

//! returns a hash of driver options
/**
    @param driver the name of the driver; if the given driver is not already loaded then this function returns
    @ref nothing

    @return if the given driver is not already loaded then the function returns @ref nothing; if the driver does not
    support any options then an empty hash is returned, otherwise a hash is returned where the keys are valid option
    names, and the values are hashes with the following keys:
    - \c "desc": a string description of the option
    - \c "type": a string giving the data type restriction for the option

    @par Example:
    @code{.py}
*hash<auto> h = dbi_get_driver_options("pgsql");
    @endcode

    @since %Qore 0.8.6

    @note since %Qore 3.0 a driver name with a NUL character returns @ref nothing, and @ref Qore::errno() "errno()" returns
    \c EINVAL
*/
*hash<auto> dbi_get_driver_options(string driver) [flags=CONSTANT,NAMED_ARGS] {
    // the driver name is looked up as a C string, which would be cut at a NUL character
    if (q_check_no_nul(driver->c_str(), driver->size())) {
        return QoreValue();
    }
    DBIDriver* dd = DBI.find(driver->getBuffer());
    return !dd ? 0 : qore_dbi_private::get(*dd)->getOptionHash();
}

//! Returns a datasource connection string from a @ref datasource_hash "datasource hash"
/**
    This is the inverse of @ref Qore::SQL::parse_datasource() "parse_datasource()".

    @param config a @ref datasource_hash "datasource hash" with the following keys:
    - \c type: (required) the driver name
    - \c user: the username for the connection
    - \c pass: the password for the connection
    - \c db: the database name for the connection
    - \c charset: the character encoding to use for the connection
    - \c host: the hostname for the connection
    - \c port: the port number for the connection
    - \c options: a hash of options for the connection

    @return a string in the format:
    <tt><em>driver</em>:[<em>user</em>][/<em>pass</em>]\@[<em>db</em>][(<em>charset</em>)][%<em>host</em>][:<em>port</em>][{<em>opt</em>=<em>val</em>[,...]}]</tt>

    @throw MAKE-DATASOURCE-STRING-ERROR the \c type key is missing or empty

    @par Example:
    @code{.py}
string str = make_datasource_string({
    "type": "pgsql",
    "user": "user",
    "pass": "pass",
    "db": "dbname",
});
    @endcode

    @note to get a safe connection string without the password, remove the \c "pass" key from the hash before
    calling this function

    @see
    - @ref Qore::SQL::parse_datasource() "parse_datasource()"
    - @ref Qore::SQL::Datasource::makeConfigString() "Datasource::makeConfigString()"

    @since %Qore 3.0
*/
string make_datasource_string(hash<auto> config) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return makeConfigString(config, xsink);
}

//! Returns a description of a datasource string for messages, with the user name, password and database name masked
/** The description has the form
    <tt><em>driver</em>:****</tt><tt>/****</tt><tt>\@****[%<em>host</em>[:<em>port</em>]]</tt>:
    the user name, the password and the database name are always replaced with \c "****", whether they are set or
    not, so that the description shows none of them, and not whether they are set; the host and port are shown if
    set; this is the description that %Qore uses for datasources in its own exception messages

    @param datasource a datasource string as accepted by @ref Qore::SQL::parse_datasource() "parse_datasource()"
    @param opts options for the parts that are shown; see @ref datasource_mask_options (since %Qore 3.0)

    @return the masked description of the datasource; a string that cannot be parsed, or whose option block has an
    option with \c "@" (which makes the split of the string ambiguous), is described as
    <tt><em>driver</em>:****</tt> if it starts with a valid driver name followed by \c ":", or as \c "****" otherwise;
    the driver name is shown only if it has only ASCII letters, digits, \c "_" and \c "-", and is replaced with
    \c "****" otherwise; a host name is shown only if it has only ASCII letters, digits, \c ".", \c "-", \c "_", \c ":",
    \c "[" and \c "]", and is replaced with \c "****" otherwise; see @ref datasource_secrets

    @par Example:
    @code{.py}
# shows the driver, host and port; the user name, password and database name are shown as "****"
string desc = mask_datasource("pgsql:user/pass@dbname%dbhost.internal:5432");
    @endcode

    @throw DATASOURCE-MASK-ERROR an unknown key in \a opts

    @note
    - this function never throws an exception for the datasource, also for a string that cannot be parsed
    - a datasource string without a driver prefix is ambiguous: in a string such as <tt>scott:tiger\@orcl</tt>, the
      text before the first \c ":" is taken as the driver name (see
      @ref Qore::SQL::parse_datasource() "parse_datasource()"); always give the driver prefix

    @see
    - @ref Qore::SQL::mask_datasource(hash<auto>) "mask_datasource(hash<auto>)"
    - @ref Qore::SQL::AbstractDatasource::getMaskedDescription() "AbstractDatasource::getMaskedDescription()"

    @since %Qore 3.0
*/
string mask_datasource(string datasource, *hash<auto> opts) [flags=CONSTANT,NAMED_ARGS] {
    unsigned flags;
    if (q_ds_mask_flags(opts, flags, xsink)) {
        return QoreValue();
    }
    QoreStringNodeHolder rv(new QoreStringNode);
    q_ds_append_masked_string_flags(**rv, *datasource, flags);
    return rv.release();
}

//! Returns a description of a datasource hash for messages, with the user name, password and database name masked
/** The description has the form
    <tt><em>driver</em>:****</tt><tt>/****</tt><tt>\@****[%<em>host</em>[:<em>port</em>]]</tt>,
    made from the \c "type", \c "host" and \c "port" keys of the hash: the user name, the password and the database
    name are always replaced with \c "****", whether they are set or not, so that the description shows none of
    them, and not whether they are set; the host and port are shown if set; this is the description that %Qore uses
    for datasources in its own exception messages

    @param config a @ref datasource_hash "datasource hash"; a \c "type" (driver name) or \c "host" value that is not a
    string is ignored, as is a \c "port" value that is not an integer or a string with an integer from 1 to 65535;
    the driver name is shown only if it has only ASCII letters, digits, \c "_" and \c "-", and is replaced with
    \c "****" otherwise; a host name is shown only if it has only ASCII letters, digits, \c ".", \c "-", \c "_", \c ":",
    \c "[" and \c "]", and is replaced with \c "****" otherwise; see @ref datasource_secrets

    @param opts options for the parts that are shown; see @ref datasource_mask_options (since %Qore 3.0)

    @return the masked description of the datasource

    @par Example:
    @code{.py}
# shows the driver, host and port; the user name, password and database name are shown as "****"
string desc = mask_datasource({
    "type": "oracle",
    "user": "scott",
    "pass": "tiger",
    "db": "orcl",
    "host": "dbhost.internal",
    "port": 1521,
});
    @endcode

    @throw DATASOURCE-MASK-ERROR an unknown key in \a opts

    @note this function never throws an exception for the datasource

    @see
    - @ref Qore::SQL::mask_datasource(string) "mask_datasource(string)"
    - @ref Qore::SQL::AbstractDatasource::getMaskedDescription() "AbstractDatasource::getMaskedDescription()"

    @since %Qore 3.0
*/
string mask_datasource(hash<auto> config, *hash<auto> opts) [flags=CONSTANT,NAMED_ARGS] {
    unsigned flags;
    if (q_ds_mask_flags(opts, flags, xsink)) {
        return QoreValue();
    }
    QoreStringNodeHolder rv(new QoreStringNode);
    q_ds_append_masked_flags(**rv, config, flags);
    return rv.release();
}

//! Returns the masked form of a datasource string as a @ref datasource_hash "datasource hash"
/** The hash has the parts of the masked description of
    @ref Qore::SQL::mask_datasource(string, *hash<auto>) "mask_datasource()": the password is never in it, the user name
    is always \c "****", and the other parts are shown as \a opts give; see @ref datasource_mask_options

    @param datasource a datasource string as accepted by @ref Qore::SQL::parse_datasource() "parse_datasource()"
    @param opts options for the parts that are shown; see @ref datasource_mask_options

    @return the masked datasource hash; a string that cannot be parsed, or whose option block has an option with
    \c "@", gives a hash with only \c "type": its driver name, or \c "****"

    @par Example:
    @code{.py}
# {"type": "pgsql", "user": "****", "db": "orders", "host": "dbhost", "port": 5432, "options": {"min": "****"}}
hash<auto> h = mask_datasource_hash("pgsql:user/pass@orders%dbhost:5432{min=2}",
    {"show_db": True, "show_options": True});
    @endcode

    @throw DATASOURCE-MASK-ERROR an unknown key in \a opts

    @since %Qore 3.0
*/
hash<auto> mask_datasource_hash(string datasource, *hash<auto> opts) [flags=CONSTANT,NAMED_ARGS] {
    unsigned flags;
    if (q_ds_mask_flags(opts, flags, xsink)) {
        return QoreValue();
    }
    return q_ds_masked_string_hash(*datasource, flags);
}

//! Returns the masked form of a datasource hash
/** See @ref Qore::SQL::mask_datasource_hash(string, *hash<auto>) "mask_datasource_hash(string)"

    @param config a @ref datasource_hash "datasource hash"
    @param opts options for the parts that are shown; see @ref datasource_mask_options

    @return the masked datasource hash

    @throw DATASOURCE-MASK-ERROR an unknown key in \a opts

    @since %Qore 3.0
*/
hash<auto> mask_datasource_hash(hash<auto> config, *hash<auto> opts) [flags=CONSTANT,NAMED_ARGS] {
    unsigned flags;
    if (q_ds_mask_flags(opts, flags, xsink)) {
        return QoreValue();
    }
    return q_ds_masked_hash(config, flags);
}
///@}

/** @defgroup sql_constants SQL Constants
    SQL constants
*/
///@{
namespace Qore::SQL;

//! for binding string values
const VARCHAR = "string";

//! for binding number values as a number
/** @since %Qore 0.8.6 the value of this constant is \c "number" instead of \c "string"
*/
const NUMBER = "number";

//! for binding numeric values as a number
/** @since %Qore 0.8.6 the value of this constant is \c "number" instead of \c "string"
*/
const NUMERIC = "number";

//! for binding decimal values as a number
/** @since %Qore 0.8.6 the value of this constant is \c "number" instead of \c "string"
*/
const DECIMAL = "number";

//! for binding CLOB values
const CLOB = "clob";

//! for binding BLOB values
const BLOB = "blob";

//! for binding date/time values
const DATE = "date";

//! For binding @ref resultset_output_binding "result set" placeholders
/** For @ref Qore::SQL::SQLStatement "SQLStatement" output values in supported DBI drivers

    @since %Qore 0.8.13
*/
const RESULTSET = "resultset";
///@}
