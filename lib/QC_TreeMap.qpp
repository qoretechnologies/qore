#include <qore/Qore.h>
#include "qore/intern/QC_TreeMap.h"
#include "qore/intern/QoreObjectIntern.h"
#include "qore/intern/RSet.h"

//! A container for efficient path prefix lookup.
/** The primary use of this class is in HttpServer for matching request URIs to handlers.

    Example:
    @code{.py}
TreeMap tm();

tm.put("path/to/resource", handler1);
tm.put("scripts", handler2);
tm.put("scripts/special", handler3);

tm.get("path/to/resource/x");           # returns handler1
tm.get("path/to/resource?arg=1");       # returns handler1
tm.get("path/to/res");                  # returns NOTHING
tm.get("path/to/resourcex");            # returns NOTHING
tm.get("path");                         # returns NOTHING

tm.get("scripts/special/main.js");      # returns handler3
tm.get("scripts/normal/main.js");       # returns handler2
    @endcode
*/
qclass TreeMap [arg=TreeMapData* tm];

//! Creates an empty TreeMap container
/** Creates an empty TreeMap container.
 */
TreeMap::constructor() {
    self->setPrivate(CID_TREEMAP, new TreeMapData);
}

//! Releases any resource held by the instance
/** Releases any resource held by the instance.
 */
TreeMap::destructor() {
    tm->destructor(xsink);
    tm->deref(xsink);
}

//! Throws an exception; objects of this class cannot be copied
/**
    @throw TREEMAP-COPY-ERROR objects of this class cannot be copied
 */
TreeMap::copy() {
    xsink->raiseException("TREEMAP-COPY-ERROR", "objects of this class cannot be copied");
}

//! Puts the mapping of \c path to \c value into the container.
/**
    @param path the path to which \c value will be mapped
    @param value the value to put into the TreeMap

    @see TreeMap::remove()
 */
nothing TreeMap::put(string path, auto value) {
    tm->put(self, path, value, xsink);
}

//! Retrieves a value from the TreeMap and optionally returns the unmatched path suffix
/** @par Example:
    @code{.py}
TreeMap tm();
tm.put("abc", "1");
tm.put("def/g/hi", "5");

auto v;
*string unmatched;
# returns "1"
v = tm.get("abc");
# returns "1" and unmatched is ""
v = tm.get("abc", \unmatched);
# returns "1" and unmatched is "cde/"
v = tm.get("abc/cde/", \unmatched);
*hash h;
v = tm.get("def/g/hi/five", \h.unmatched);  # returns "5" and h.unmatched is "five"
    @endcode

    Looks for an entry whose key is the longest prefix of \c path.

    @param path the path to lookup
    @param unmatched an optional reference to the path suffix; if \c path is not found, then @ref nothing is assigned to the reference

    @return the value pointed to by the longest prefix of \c path or @ref nothing if no such mapping exists

    @since %Qore 0.8.13
 */
auto TreeMap::get(string path, *reference<*string> unmatched) [flags=RET_VALUE_ONLY] {
    return tm->get(path, unmatched, xsink);
}

//! Removes a value from the TreeMap and returns the value removed
/** \c path must be an exact match

    @param path the path to remove

    @return the value removed from the TreeMap or @ref nothing if no exact match was found

    @see TreeMap::put()
*/
auto TreeMap::take(string path) {
    return tm->take(self, path, xsink);
}

//! Retrieves the entire TreeMap as a hash; returns @ref nothing if the TreeMap is empty
/** @return the entire TreeMap as a hash; returns @ref nothing if the TreeMap is empty
 */
*hash TreeMap::getAll() [flags=CONSTANT] {
    return tm->getAll();
}

void TreeMapData::destructor(ExceptionSink* xsink) {
    QoreAutoRWWriteLocker al(rwl);
    for (Map::iterator i = data.begin(), e = data.end(); i != e; ++i) {
        i->second.discard(xsink);
    }
    data.clear();
    scan_count = 0;
}

void TreeMapData::put(QoreObject* self, const QoreStringNode* key, const QoreValue value, ExceptionSink* xsink) {
    TempEncodingHelper keyStr(key, QCS_DEFAULT, xsink);
    if (!keyStr) {
        return;
    }

    bool inc_obj = false;
    bool dec_obj = false;

    {
        QoreAutoRWWriteLocker al(rwl);

        bool old_needs_scan = false;
        bool new_needs_scan = needs_scan(value);

        Map::iterator it = data.find(keyStr->c_str());

        // Check if old value needs scan and discard it
        if (it != data.end()) {
            old_needs_scan = needs_scan(it->second);
            it->second.discard(xsink);
            // Reuse the existing map entry
            it->second = value.refSelf();
        } else {
            // Insert new entry
            data[keyStr->c_str()] = value.refSelf();
        }

        // Update scan_count based on net change
        if (old_needs_scan && !new_needs_scan) {
            --scan_count;
            if (!scan_count) {
                dec_obj = true;
            }
        } else if (!old_needs_scan && new_needs_scan) {
            if (!scan_count) {
                inc_obj = true;
            }
            ++scan_count;
        }
        // If both old and new need scan (or neither does), scan_count doesn't change
    }

    // Update object's scan_private_data outside the lock
    // Note: inc before dec to avoid window where scan_private_data is incorrectly 0
    if (inc_obj) {
        qore_object_private::get(*self)->incScanPrivateData();
    }
    if (dec_obj) {
        qore_object_private::get(*self)->decScanPrivateData();
    }
}

QoreValue TreeMapData::take(QoreObject* self, const QoreStringNode* key, ExceptionSink* xsink) {
    TempEncodingHelper keyStr(key, QCS_DEFAULT, xsink);
    if (!keyStr) {
        return QoreValue();
    }

    bool dec_obj = false;
    QoreValue rv;

    {
        QoreAutoRWWriteLocker al(rwl);
        Map::iterator i = data.find(keyStr->c_str());
        if (i == data.end()) {
            return QoreValue();
        }

        rv = i->second;
        if (needs_scan(rv)) {
            --scan_count;
            if (!scan_count) {
                dec_obj = true;
            }
        }
        data.erase(i);
    }

    if (dec_obj) {
        qore_object_private::get(*self)->decScanPrivateData();
    }

    return rv;
}

bool TreeMapData::scanMembers(RObject& obj, RSetHelper& rsh) {
    // if we cannot lock the lock, then return false to ignore
    // blocking here or returning true could cause a deadlock
    QoreOptionalRWWriteLocker al(rwl);
    if (!al) {
        return false;
    }

    for (Map::iterator i = data.begin(), e = data.end(); i != e; ++i) {
        if (i->second.hasNode() && obj.scanCheck(rsh, i->second.getInternalNode())) {
            return true;
        }
    }

    return false;
}
