//! Compares numbers with a given epsilon
/** @param left the first number
    @param right the second number
    @param epsilon the maximum difference in the numbers under which they are considered equal

    @return -1 if \a left is less then \a right, 0 if the difference between the numbers is less than \a epsilon, 1 if
    \a left is greater than \a right

    @since %Qore 0.9.5
*/
int compare(number left, number right, number epsilon) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    SimpleRefHolder<QoreNumberNode> v(left->doMinus(*right));
    if (v->zero()) {
        return 0;
    }
    int rv = v->sign();
    SimpleRefHolder<QoreNumberNode> tmp(qore_number_private::doUnary(**v, mpfr_abs));
    if (tmp->lessThan(*epsilon)) {
        return 0;
    }
    return rv;
}

//! Compares numbers with a given epsilon
/** @param left the first number
    @param right the second number
    @param epsilon the maximum difference in the numbers under which they are considered equal

    @return -1 if \a left is less then \a right, 0 if the difference between the numbers is less than \a epsilon, 1 if
    \a left is greater than \a right

    @since %Qore 0.9.5
*/
int compare(float left, float right, float epsilon) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    double v = left - right;
    if (v == 0.0) {
        return 0;
    }
    int rv = v < 0 ? -1 : 1;
    if (fabs(v) < epsilon) {
        return 0;
    }
    return rv;
}
///@}

typedef enum {ROUND, CEIL, FLOOR} FUN;
long long round_ceil_floor_intern(long long num, int prec, FUN fun) {
    if (prec >= 0)
        return num;

    string s = string(to_string(LLONG_MAX).length() + 4, '0') + to_string(num < 0 ? -num : num);
    int len = s.length();
    if (len < -prec)
        return 0;

    int pos = len + prec;
    unsigned long long n = stoll(s.substr(0, pos));

    switch (fun) {
        case ROUND: if (s[pos] - '0' > 4)                 n++; break;
        case CEIL:  if (num >= 0 && stoll(s.substr(pos))) n++; break;
        case FLOOR: if (num <  0 && stoll(s.substr(pos))) n++;
    }

    unsigned long long res = stoll(to_string(n) + string(-prec, '0'));
    return num < 0 ? -res : res;
}
