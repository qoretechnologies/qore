///@{

//! Returns the multiple of <b>-precision</b>-th power of 10 that is closest to <b>value</b> (numbers halfway between two such powers of 10 are rounded away from zero). (So, for non-negative <b>precision</b> just returns <b>value</b>).
/** @param value an integer number to round
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     round(-6450, -2);  // returns  -6500
  *     round( 6450, -3);  // returns   6000
  *     round(-6450, -4);  // returns -10000
  *     round( 6450, -5);  // returns      0
  * @endcode
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
int round(softint value, int precision = 0) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return round_ceil_floor_intern(value, precision, ROUND);
}

//! Returns the multiple of <b>-precision</b>-th power of 10 that is closest to <b>value</b> (numbers halfway between two such powers of 10 are rounded away from zero).
/** @par Platform Availability
  * @ref Qore::Option::HAVE_ROUND
  * @param value a number to round
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     round( 6450.36481,  3);  // returns  6450.365
  *     round(-6450.36481,  2);  // returns -6450.36
  *     round( 6450.36481, -2);  // returns  6500.0
  *     round(-6450.36481, -3);  // returns -6000.0
  *     round( 6450.36481, -4);  // returns 10000.0
  *     round(-6450.36481, -5);  // returns     0.0
  * @endcode
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
float round(softfloat value, int precision = 0) [flags=PURE,NAMED_ARGS] {
#ifdef HAVE_ROUND
    if (precision > 0) {
        int c = pow(10, precision);
        return round(c*value)/c;
    }
    if (precision < 0) {
        int c = pow(10, -precision);
        return c*round(value/c);
    }
    return round(value);
#else
    return missing_function_error("round", "ROUND", xsink);
#endif
}

//! Returns the multiple of <b>-precision</b>-th power of 10 that is closest to <b>value</b> (numbers halfway between two such powers of 10 are rounded away from zero).
/** @param value a number to round
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     round( 645084.36481772n,  5);  // returns  645084.36482n
  *     round(-645084.36481772n,  3);  // returns -645084.365n
  *     round( 645084.36481772n, -4);  // returns  650000n
  *     round(-645084.36481772n, -5);  // returns -600000n
  *     round( 645084.36481772n, -6);  // returns 1000000n
  *     round(-645084.36481772n, -7);  // returns       0n
  * @endcode
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
number round(number value, int precision = 0) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return qore_number_private::doRoundNR(*value, mpfr_round, precision);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
float round() [flags=RUNTIME_NOOP] {
   return 0;
}

//! Returns the smallest multiple of <b>-precision</b>-th power of 10 that is greater than or equal to <b>value</b>. (Thus, for non-negative <b>precision</b> just returns <b>value</b>).
/** @param value an integer number to process (to round upwards)
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     ceil( 64501, -2);  // returns 64600
  *     ceil(-64999, -3);  // returns -64000
  *     ceil( 34500, -8);  // returns 100000000
  *     ceil(-34500, -8);  // returns 0
  * @endcode
  *
  * @see floor(softint value, int precision = 0)
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
int ceil(int value, int precision = 0) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return round_ceil_floor_intern(value, precision, CEIL);
}

//! Returns the smallest multiple of <b>-precision</b>-th power of 10 that is greater than or equal to <b>value</b>.
/** @param value the number to process (to round upwards)
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     ceil(   357.271, 2);  // returns 357.28
  *     ceil(  -357.271, 1);  // returns -357.2
  *     ceil(-64599.28, -2);  // returns -64500.0
  *     ceil( 14500.28, -4);  // returns 20000.0
  *     ceil( 34500.28, -7);  // returns 10000000.0
  *     ceil(-34500.28, -7);  // returns 0.0
  * @endcode
  *
  * @see floor(softfloat value, int precision = 0)
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
float ceil(softfloat value, int precision = 0) [flags=TOTAL,NAMED_ARGS] {
    if (precision > 0) {
        int c = pow(10, precision);
        return ceil(c*value)/c;
    }
    if (precision < 0) {
        int c = pow(10, -precision);
        return c*ceil(value/c);
    }
    return ceil(value);
}

//! Returns the smallest multiple of <b>-precision</b>-th power of 10 that is greater than or equal to <b>value</b>.
/** @param value the number to process (to round upwards)
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     ceil(   357.271n, 2);  // returns 357.28n
  *     ceil(  -357.271n, 1);  // returns -357.2n
  *     ceil(-64599.28n, -2);  // returns -64500n
  *     ceil( 14500n,    -4);  // returns 20000n
  *     ceil( 34500.28n, -7);  // returns 10000000n
  *     ceil(-34500.28n, -7);  // returns 0n
  * @endcode
  *
  * @see floor(number value, int precision = 0)
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
number ceil(number value, int precision = 0) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return qore_number_private::doRoundNR(*value, mpfr_ceil, precision);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
float ceil() [flags=RUNTIME_NOOP] {
   return 0;
}

//! Returns the largest multiple of <b>-precision</b>-th power of 10 that is less than or equal to <b>value</b>. (Thus, for non-negative <b>precision</b> just returns <b>value</b>).
/** @param value an integer number to process (to round downwards)
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     floor(-64501, -2);  // returns -64600
  *     floor( 64999, -3);  // returns 64000
  *     floor(-34500, -8);  // returns -100000000
  *     floor( 34500, -8);  // returns 0
  * @endcode
  *
  * @see ceil(softint value, int precision = 0)
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
int floor(int value, int precision = 0) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return round_ceil_floor_intern(value, precision, FLOOR);
}

//! Returns the largest multiple of <b>-precision</b>-th power of 10 that is less than or equal to <b>value</b>.
/** @param value the number to process (to round downwards)
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     floor(   357.271, 2);  // returns 357.27
  *     floor(  -357.271, 1);  // returns -357.3
  *     floor( 64599.28, -2);  // returns 64500.0
  *     floor( 17500.28, -4);  // returns 10000.0
  *     floor( 34500.28, -7);  // returns 0.0
  *     floor(-34500.28, -7);  // returns -10000000.0
  * @endcode
  *
  * @see ceil(softfloat value, int precision = 0)
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
float floor(softfloat value, int precision = 0) [flags=TOTAL,NAMED_ARGS] {
    if (precision > 0) {
        int c = pow(10, precision);
        return floor(c*value)/c;
    }
    if (precision < 0) {
        int c = pow(10, -precision);
        return c*floor(value/c);
    }
    return floor(value);
}

//! Returns the largest multiple of <b>-precision</b>-th power of 10 that is less than or equal to <b>value</b>.
/** @param value the number to process (to round downwards)
  * @param precision rounding precision
  *
  * @par Example:
  * @code{.py}
  *     floor(   357.271n, 2);  // returns 357.27n
  *     floor(  -357.271n, 1);  // returns -357.3n
  *     floor( 64599.28n, -2);  // returns 64500n
  *     floor( 17500.28n, -4);  // returns 10000n
  *     floor( 34500.28n, -7);  // returns 0n
  *     floor(-34500.28n, -7);  // returns -10000000n
  * @endcode
  *
  * @see ceil(number value, int precision = 0)
  *
  * @since %Qore 0.8.13 this function accepts the <b>precision</b> argument to specify the rounding precision
  */
number floor(number value, int precision = 0) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return qore_number_private::doRoundNR(*value, mpfr_floor, precision);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
float floor() [flags=RUNTIME_NOOP] {
   return 0;
}

//! Returns a number raised to the power of another number
/**
    @param base the number to raise to the power of \a exponent
    @param exponent the power to raise \a base to

    @return a number raised to the power of another number

    @par Example:
    @code{.py}
number z = pow(x, y);
    @endcode

    @throw DIVISION-BY-ZERO in pow(x, y), if x = 0 then y must be a non-negative value
 */
number pow(number base, number exponent) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    // NOTE: mpfr_pow() will abort if zero is passed as the exponent
    if (exponent->zero()) {
        return new QoreNumberNode(1ll);
    }
    return qore_number_private::doBinary(*base, mpfr_pow, *exponent, xsink);
}

//! Returns a number raised to the power of another number
/**
    @param base the number to raise to the power of \a exponent
    @param exponent the power to raise \a base to

    @return a number raised to the power of another number

    @par Example:
    @code{.py}
float z = pow(x, y);
    @endcode

    @throw DIVISION-BY-ZERO in pow(x, y), if x = 0 then y must be a non-negative value
    @throw INVALID-POW-ARGUMENTS in pow(x, y), x cannot be negative when y is not an integer value
 */
float pow(softfloat base = 0.0, softfloat exponent = 0.0) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    if (base == 0.0 && exponent < 0) {
        return xsink->raiseException("DIVISION-BY-ZERO", "pow(base, exponent): if base = 0 then exponent must be a "
            "non-negative value");
    }

    if (base < 0 && exponent != ceil(exponent)) {
        return xsink->raiseException("INVALID-POW-ARGUMENTS", "pow(base, exponent): base cannot be negative when "
            "exponent is not an integer value");
    }

    return pow(base, exponent);
}

//! Returns a number raised to the power of another number
/**
    @param base the number to raise to the power of \a exponent
    @param exponent the power to raise \a base to

    @return a number raised to the power of another number

    @par Example:
    @code{.py}
int z = pow(x, y);
    @endcode

    @throw DIVISION-BY-ZERO in pow(x, y), if x = 0 then y must be a non-negative value
    @throw INVALID-POW-ARGUMENTS in pow(x, y), x cannot be negative when y is not an integer value
 */
int pow(int base = 0, int exponent = 0) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    if (!base && exponent < 0) {
        return xsink->raiseException("DIVISION-BY-ZERO", "pow(base, exponent): if base = 0 then exponent must be a "
            "non-negative value");
    }

    return (int64)pow((double)base, (double)exponent);
}

//! Returns the absolute value of the argument passed
/**
    @param value the value to process

    @return the absolute value of the argument passed

    @par Example:
    @code{.py}
int i = abs(-20); # returns 20
    @endcode

    @note equivalent to <int>::abs()
 */
int abs(int value) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return value < 0 ? -value : value;
}

//! Returns the absolute value of the argument passed
/**
    @param value the value to process

    @return the absolute value of the argument passed

    @par Example:
    @code{.py}
number n = abs(-20n); # returns 20n
    @endcode

    @note equivalent to <number>::abs()
 */
number abs(number value) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return qore_number_private::doUnary(*value, mpfr_abs);
}

//! Returns the absolute value of the argument passed
/**
    @param value the value to process

    @return the absolute value of the argument passed

    @par Example:
    @code{.py}
float f = abs(-20.2); # returns 20.2
    @endcode

    @note equivalent to <float>::abs()
 */
float abs(softfloat value) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return fabs(value);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
float abs() [flags=RUNTIME_NOOP] {
    return 0;
}

//! Returns the length of the hypotenuse of a right-angle triangle with sides given as the two arguments
/**
    @param x the length of side x of the right-angle triangle
    @param y the length of side y of the right-angle triangle

    @return the length of the hypotenuse of a right-angle triangle with sides given as the two arguments

    @par Example:
    @code{.py}
number z = hypot(x, y);
    @endcode
 */
number hypot(number x, number y) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    return qore_number_private::doBinary(*x, mpfr_hypot, *y);
}

//! Returns the length of the hypotenuse of a right-angle triangle with sides given as the two arguments
/**
