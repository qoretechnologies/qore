//! Compares numbers with a given epsilon
/** @param left the first number
    @param right the second number
    @param epsilon the maximum difference in the numbers under which they are considered equal

    @return -1 if \a left is less then \a right, 0 if the difference between the numbers is less than \a epsilon, 1 if
    \a left is greater than \a right

    @since %Qore 0.9.5
*/
int compare(number left, number right, number epsilon) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    SimpleRefHolder<QoreNumberNode> v(left->doMinus(*right));
    if (v->zero()) {
        return 0;
    }
    int rv = v->sign();
    SimpleRefHolder<QoreNumberNode> tmp(qore_number_private::doUnary(**v, mpfr_abs));
    if (tmp->lessThan(*epsilon)) {
        return 0;
    }
    return rv;
}

//! Compares numbers with a given epsilon
/** @param left the first number
    @param right the second number
    @param epsilon the maximum difference in the numbers under which they are considered equal

    @return -1 if \a left is less then \a right, 0 if the difference between the numbers is less than \a epsilon, 1 if
    \a left is greater than \a right

    @since %Qore 0.9.5
*/
int compare(float left, float right, float epsilon) [flags=TOTAL,HOST_PORTABLE,NAMED_ARGS] {
    double v = left - right;
    if (v == 0.0) {
        return 0;
    }
    int rv = v < 0 ? -1 : 1;
    if (fabs(v) < epsilon) {
        return 0;
    }
    return rv;
}
///@}

typedef enum {ROUND, CEIL, FLOOR} FUN;
// rounds an int to a multiple of 10^-prec for a negative precision (qore#6212): the precision was cut to an int (so
// -4294967295 rounded at 10^-1), the magnitude of the smallest int and a precision below -19 overflowed, and a result
// out of the range of an int raised a C++ exception that ended the process (round(9223372036854775807, -1)); the
// result is now computed in 128 bits and saturated
long long round_ceil_floor_intern(long long num, int64 prec, FUN fun) {
    if (prec >= 0) {
        return num;
    }
    // any |num| is below 10^19, so every power from 10^20 up gives the same result; 38 keeps 10^k in 128 bits
    uint64_t k = 0 - static_cast<uint64_t>(prec);
    if (k > 38) {
        k = 38;
    }
    __int128 p = 1;
    for (uint64_t i = 0; i < k; ++i) {
        p *= 10;
    }
    __int128 n = num;
    __int128 q = n / p;
    __int128 r = n % p;
    switch (fun) {
        case ROUND:
            // half away from zero
            if (r < 0 ? -r * 2 >= p : r * 2 >= p) {
                q += n < 0 ? -1 : 1;
            }
            break;
        case CEIL:
            if (r > 0) {
                ++q;
            }
            break;
        case FLOOR:
            if (r < 0) {
                --q;
            }
            break;
    }
    // |q| <= 10^19 / p + 1 and p <= 10^38, so the product fits 128 bits
    __int128 rv = q * p;
    if (rv > std::numeric_limits<long long>::max()) {
        return std::numeric_limits<long long>::max();
    }
    if (rv < std::numeric_limits<long long>::min()) {
        return std::numeric_limits<long long>::min();
    }
    return static_cast<long long>(rv);
}
