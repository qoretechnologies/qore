#include <qore/Qore.h>
#include <qore/QoreSandboxManager.h>
#include "qore/intern/QoreSandboxProvenance.h"

//! Port range configuration for network security
/** @since %Qore 3.0
*/
hashdecl PortRangeInfo {
    //! Low port number (inclusive)
    int low;
    //! High port number (inclusive)
    int high;
    //! Protocol (QSEC_NET_TCP, QSEC_NET_UDP, or QSEC_NET_ALL)
    int proto;
}

//! Filesystem path access rule
/** @since %Qore 3.0
*/
hashdecl FilesystemPathInfo {
    //! Path pattern
    string path;
    //! Access mode bitmask (QSEC_READ, QSEC_WRITE, etc.)
    int mode;
}

//! Filesystem security configuration
/** @since %Qore 3.0
*/
hashdecl FilesystemSecurityConfigInfo {
    //! Sandbox root path (if set)
    *string sandbox_root;
    //! Default policy: "allow" or "deny"
    string default_policy;
    //! List of allowed path rules
    list<hash<FilesystemPathInfo>> allowed_paths;
    //! List of denied path patterns
    list<string> denied_paths;
}

//! Network security configuration
/** @since %Qore 3.0
*/
hashdecl NetworkSecurityConfigInfo {
    //! Default policy: "allow" or "deny"
    string default_policy;
    //! List of allowed hostname patterns
    list<string> allowed_hosts;
    //! Count of allowed IP ranges (ranges not exposed for security)
    int allowed_ranges_count;
    //! Count of denied IP ranges (ranges not exposed for security)
    int denied_ranges_count;
    //! List of allowed port configurations
    list<hash<PortRangeInfo>> allowed_ports;
}

//! Full sandbox configuration
/** @since %Qore 3.0
*/
hashdecl SandboxConfigInfo {
    //! Filesystem security configuration
    hash<FilesystemSecurityConfigInfo> filesystem;
    //! Network security configuration
    hash<NetworkSecurityConfigInfo> network;
    //! Maximum number of threads (0 = unlimited)
    int max_threads;
    //! Wall-clock time limit of each call into the sandbox in milliseconds (0 = unlimited)
    int wall_time_limit;
    //! CPU time limit of each call into the sandbox in milliseconds (0 = unlimited)
    int cpu_time_limit;
    //! Stack size limit of each call into the sandbox in bytes (0 = unlimited)
    int max_stack_size;
    //! Memory limit of the sandbox in bytes (0 = unlimited)
    int memory_limit;
    //! Whether an interrupt has been requested
    bool interrupt_requested;
    //! Whether code that the sandbox governs may use uncontrolled APIs (see SandboxManager::setUncontrolledApiPolicy())
    /** @since %Qore 3.0
    */
    bool uncontrolled_api_policy;
}

/** @defgroup sandbox_fs_access Filesystem Access Mode Constants
    These constants are used with the FilesystemSecurityManager class to specify access modes.
*/
///@{
//! Read access to files
const QSEC_READ = QSEC_READ;

//! Write access to files
const QSEC_WRITE = QSEC_WRITE;

//! Execute access to files
const QSEC_EXECUTE = QSEC_EXECUTE;

//! Delete access to files
const QSEC_DELETE = QSEC_DELETE;

//! Create new files
const QSEC_CREATE = QSEC_CREATE;

//! All filesystem access modes
const QSEC_ALL = QSEC_ALL;
///@}

/** @defgroup sandbox_net_proto Network Protocol Constants
    These constants are used with the NetworkSecurityManager class to specify protocols.
*/
///@{
//! TCP protocol
const QSEC_NET_TCP = QSEC_NET_TCP;

//! UDP protocol
const QSEC_NET_UDP = QSEC_NET_UDP;

//! Unix domain sockets
const QSEC_NET_UNIX = QSEC_NET_UNIX;

//! All network protocols
const QSEC_NET_ALL = QSEC_NET_ALL;
///@}

//! Unified sandbox manager combining filesystem, network, and resource controls
/** The SandboxManager class provides a unified interface for all
    sandboxing features including:

    - A limit on the number of threads that sandboxed code runs at once
    - Wall-clock time, CPU time and stack size limits for each call into the sandbox
    - A limit on the memory held by the data that sandboxed code creates
    - Safe interruption of sandboxed code

    @par Example:
    @code{.py}
SandboxManager sm();
sm.setMaxThreads(4);
sm.setWallTimeLimit(5000);  # 5 seconds per call
    @endcode

    @par Changes by Code That Is Not Trusted
    The code of a sandboxed %Program, or of a %Program that restricts a functional domain, can change only a sandbox
    manager that code of its own %Program created in a way that could loosen it: a method that could lift a restriction
    (a higher or no limit, allowing paths, hosts or ports, allowing by default, changing the sandbox root, and
    clearInterrupt()) raises \c SANDBOX-ACCESS-ERROR for any other manager, such as the one that governs the code,
    which @ref Qore::Program::getSandboxManager() "Program::getSandboxManager()" returns, or one that governs another
    %Program.  A change that only adds restrictions (a stricter limit, denying by default, denying a path or address
    range, blockPrivateNetworks(), blockLocalhost(), requestInterrupt(), and allowHTTPSOnly() unless the allowed ports
    are an allowlist that lacks 443/TCP) is allowed.  Such code
    also cannot replace the sandbox manager of a %Program (see
    @ref Qore::Program::setSandboxManager() "Program::setSandboxManager()").  Trusted code may change any manager,
    also when a sandbox governs it because sandboxed code called it.

    @since Qore 3.0
*/
qclass SandboxManager [arg=QoreSandboxManager* sm; ns=Qore];

//! Creates a new sandbox manager with default settings
/** @par Example:
    @code{.py}
SandboxManager sm();
    @endcode
*/
SandboxManager::constructor() {
    QoreSandboxManager* nsm = new QoreSandboxManager();
    // code that is not trusted may change the managers that it creates (issue #5659)
    qore_sandbox_manager_record_creator(nsm);
    self->setPrivate(CID_SANDBOXMANAGER, nsm);
}

//! Destroys the sandbox manager
/** Called automatically when the object is destroyed
*/
SandboxManager::destructor() {
    sm->deref(xsink);
}

//! Creates a copy of this sandbox manager
/** @return A new SandboxManager with the same configuration
*/
SandboxManager::copy() {
    QoreSandboxManager* nsm = sm->copy();
    // code that is not trusted may change the managers that it creates (issue #5659)
    qore_sandbox_manager_record_creator(nsm);
    self->setPrivate(CID_SANDBOXMANAGER, nsm);
}

//! Sets the maximum number of threads that code governed by the sandbox may have running at once
/** The limit counts the threads started on behalf of the sandboxed code: with the @ref background "background"
    operator, @ref Qore::call_async() "call_async()", the workers of @ref Qore::parallel_map() "parallel_map()" and
    @ref Qore::parallel_foreach() "parallel_foreach()", and the threads that module code starts for the sandboxed code,
    also for a Program with @ref Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL", whose code cannot start threads
    itself (see @ref sandbox_po_threads).  The threads of a @ref Qore::Thread::ThreadPool "ThreadPool" (its own thread
    and its workers, also idle ones) count against the limit of the sandbox of the Program that created the pool.  The
    thread that calls into the sandbox, the threads of the async I/O controller and the threads of a pool created by a
    Program without a sandbox manager are not counted.

    Starting a thread at the limit raises \c THREAD-CREATION-FAILURE in the code that starts it; a thread stops
    counting when its work ends.  Lowering the limit does not affect threads already running.

    @param max_threads the maximum number of threads; 0 or a negative value means no limit, which is the default

    @par Example:
    @code{.py}
sm.setMaxThreads(max_threads: 4);
    @endcode

    @note A SandboxManager has no thread limit unless one is set, so sandboxed code is bounded only by the maximum
    number of threads of the process; a host that runs untrusted code should always set a limit (see
    @ref sandbox_resources)
*/
nothing SandboxManager::setMaxThreads(int max_threads) [flags=NAMED_ARGS] {
    // a stricter limit only adds restrictions (see qore_sandbox_manager_check_change())
    int64 current = sm->getMaxThreads();
    if (!(max_threads > 0 && (!current || max_threads <= current))
        && qore_sandbox_manager_check_change(sm, "SandboxManager::setMaxThreads()", xsink)) {
        return QoreValue();
    }
    sm->setMaxThreads(max_threads);
}

//! Gets the max threads limit
/** @return Maximum number of threads, or 0 for unlimited
*/
int SandboxManager::getMaxThreads() {
    return sm->getMaxThreads();
}

//! Sets the wall-clock time limit of each call into the sandbox
/** @param max_wall_time_ms the limit in milliseconds; 0 = unlimited

    A call starts when a thread enters code governed by this sandbox from code that it does not govern: for example
    @ref Qore::Program::run() "Program::run()", @ref Qore::Program::callFunction() "Program::callFunction()" or a
    method call on an object of a Program that has this sandbox manager, or a call of a closure or method of an object
    created under this sandbox.  A thread that is already running a call of this sandbox does not start a new one when
    it re-enters the sandbox.  Threads, thread pool tasks and asynchronous I/O operations that the call starts share
    its deadline.

    When the deadline passes, the threads of the call raise a \c SANDBOX-TIMEOUT exception at their next cancellation
    point, and a thread blocked in an interruptible wait (@ref Qore::sleep() "sleep()", locks, queues, I/O) wakes at
    once.  The exception is raised again at every cancellation point until the thread leaves the call, so code in the
    sandbox cannot catch it and continue, and @ref Qore::clear_thread_cancel() "clear_thread_cancel()" does not clear
    it.  Other calls into the same sandbox are not affected.  Changing the limit affects calls that start afterwards.

    See @ref sandbox_resource_limits for the limitations.

    @par Example:
    @code{.py}
sm.setWallTimeLimit(max_wall_time_ms: 5000);  # 5 seconds per call
    @endcode

    @throw SANDBOX-CONFIG-ERROR the limit is negative

    @since %Qore 3.0
*/
nothing SandboxManager::setWallTimeLimit(int max_wall_time_ms) [flags=NAMED_ARGS] {
    // a stricter limit only adds restrictions (see qore_sandbox_manager_check_change())
    int64 current = sm->getWallTimeLimit();
    if (!(max_wall_time_ms > 0 && (!current || max_wall_time_ms <= current))
        && qore_sandbox_manager_check_change(sm, "SandboxManager::setWallTimeLimit()", xsink)) {
        return QoreValue();
    }
    if (max_wall_time_ms < 0) {
        xsink->raiseException("SANDBOX-CONFIG-ERROR", "the wall time limit cannot be negative; got: " QLLD,
            max_wall_time_ms);
        return QoreValue();
    }
    sm->setWallTimeLimit(max_wall_time_ms);
}

//! Gets the wall-clock time limit of each call into the sandbox
/** @return the limit in milliseconds, or 0 for unlimited

    @since %Qore 3.0
*/
int SandboxManager::getWallTimeLimit() {
    return sm->getWallTimeLimit();
}

//! Sets the CPU time limit of each call into the sandbox
/** @param max_cpu_time_ms the limit in milliseconds; 0 = unlimited

    The limit applies to the CPU time used by all threads of a call together (see setWallTimeLimit() for what a call
    is): the thread that entered the sandbox, threads that the call starts, and thread pool tasks and asynchronous
    I/O operations that run for it.  Time spent waiting (sleeping, blocked on a lock, a queue or I/O) does not count.

    When the CPU time is used up, the threads of the call raise a \c SANDBOX-TIMEOUT exception naming the CPU time
    limit at their next cancellation point, as with the wall time limit.  See @ref sandbox_cpu_limit for how it is
    measured and the platforms where it is enforced.

    @par Example:
    @code{.py}
sm.setCPUTimeLimit(max_cpu_time_ms: 1000);  # 1 second of CPU time per call
    @endcode

    @throw SANDBOX-CONFIG-ERROR the limit is negative

    @since %Qore 3.0
*/
nothing SandboxManager::setCPUTimeLimit(int max_cpu_time_ms) [flags=NAMED_ARGS] {
    // a stricter limit only adds restrictions (see qore_sandbox_manager_check_change())
    int64 current = sm->getCPUTimeLimit();
    if (!(max_cpu_time_ms > 0 && (!current || max_cpu_time_ms <= current))
        && qore_sandbox_manager_check_change(sm, "SandboxManager::setCPUTimeLimit()", xsink)) {
        return QoreValue();
    }
    if (max_cpu_time_ms < 0) {
        xsink->raiseException("SANDBOX-CONFIG-ERROR", "the CPU time limit cannot be negative; got: " QLLD,
            max_cpu_time_ms);
        return QoreValue();
    }
    sm->setCPUTimeLimit(max_cpu_time_ms);
}

//! Gets the CPU time limit of each call into the sandbox
/** @return the limit in milliseconds, or 0 for unlimited

    @since %Qore 3.0
*/
int SandboxManager::getCPUTimeLimit() {
    return sm->getCPUTimeLimit();
}

//! Sets the memory limit of the sandbox
/** @param max_memory_bytes the limit in bytes; 0 = unlimited

    The limit applies to the memory held by the values (strings, lists, hashes, objects, binary data) that code
    governed by the sandbox created and that are still alive, wherever they are now: data passed out of the sandbox
    stays charged to it until it is freed.  Memory allocated inside third-party libraries or by the interpreter itself
    is not counted.  With nested sandboxes, the memory is also charged to every enclosing sandbox call with a memory
    limit.

    When the memory in use exceeds the limit, the thread that exceeded it raises \c SANDBOX-MEMORY-LIMIT at its next
    cancellation point, and again at every cancellation point until the memory in use is below the limit, so code
    that catches the exception and frees memory can go on.  See @ref sandbox_memory_limit for details.

    @par Example:
    @code{.py}
sm.setMemoryLimit(max_memory_bytes: 10 * 1024 * 1024);  # 10MB
    @endcode

    @throw SANDBOX-CONFIG-ERROR the limit is negative

    @since %Qore 3.0
*/
nothing SandboxManager::setMemoryLimit(int max_memory_bytes) [flags=NAMED_ARGS] {
    // a stricter limit only adds restrictions (see qore_sandbox_manager_check_change())
    int64 current = sm->getMemoryLimit();
    if (!(max_memory_bytes > 0 && (!current || max_memory_bytes <= current))
        && qore_sandbox_manager_check_change(sm, "SandboxManager::setMemoryLimit()", xsink)) {
        return QoreValue();
    }
    if (max_memory_bytes < 0) {
        xsink->raiseException("SANDBOX-CONFIG-ERROR", "the memory limit cannot be negative; got: " QLLD,
            max_memory_bytes);
        return QoreValue();
    }
    sm->setMemoryLimit(max_memory_bytes);
}

//! Gets the memory limit of the sandbox
/** @return the limit in bytes, or 0 for unlimited

    @since %Qore 3.0
*/
int SandboxManager::getMemoryLimit() {
    return sm->getMemoryLimit();
}

//! Returns the memory currently charged to the sandbox
/** @return the memory in bytes held by live data that sandboxed code created, including what threads running calls
    into the sandbox have reserved for their next allocations

    @since %Qore 3.0
*/
int SandboxManager::getMemoryUsage() {
    return sm->getMemoryUsage();
}

//! Sets the stack size that each call into the sandbox may use
/** @param max_stack_bytes the limit in bytes; 0 = unlimited

    The stack is measured from the stack position where the call starts (see setWallTimeLimit() for what a call is);
    a thread that continues the call, such as a thread that the call starts or a thread pool task, measures from where
    it starts the work.  A re-entry into the sandbox does not start a new measurement.  The thread's own stack limit
    still applies: the sandbox limit can only make it tighter.

    Exceeding the limit raises \c STACK-LIMIT-EXCEEDED at the next stack check, which is made at every function and
    method call in all execution modes, so the limit bounds the recursion of sandboxed code.  Changing the limit
    affects calls that start afterwards.

    See @ref sandbox_stack_limit for details.

    @par Example:
    @code{.py}
sm.setMaxStackSize(max_stack_bytes: 1024 * 1024);  # 1MB per call
    @endcode

    @throw SANDBOX-CONFIG-ERROR the limit is negative

    @since %Qore 3.0
*/
nothing SandboxManager::setMaxStackSize(int max_stack_bytes) [flags=NAMED_ARGS] {
    // a stricter limit only adds restrictions (see qore_sandbox_manager_check_change())
    int64 current = sm->getMaxStackSize();
    if (!(max_stack_bytes > 0 && (!current || max_stack_bytes <= current))
        && qore_sandbox_manager_check_change(sm, "SandboxManager::setMaxStackSize()", xsink)) {
        return QoreValue();
    }
    if (max_stack_bytes < 0) {
        xsink->raiseException("SANDBOX-CONFIG-ERROR", "the stack size limit cannot be negative; got: " QLLD,
            max_stack_bytes);
        return QoreValue();
    }
    sm->setMaxStackSize(max_stack_bytes);
}

//! Gets the stack size that each call into the sandbox may use
/** @return the limit in bytes, or 0 for unlimited

    @since %Qore 3.0
*/
int SandboxManager::getMaxStackSize() {
    return sm->getMaxStackSize();
}

//! Requests graceful interruption of sandboxed code
/** This sets an interrupt flag that is checked at various points
    during execution. Interrupted code receives a PROGRAM-INTERRUPTED exception.

    @par Example:
    @code{.py}
# From another thread:
sm.requestInterrupt();
    @endcode
*/
nothing SandboxManager::requestInterrupt() {
    // only adds restrictions: allowed for any caller (see qore_sandbox_manager_check_change())
    sm->requestInterrupt();
}

//! Clears the interrupt request
/** Resets the interrupt flag to allow continued execution
*/
nothing SandboxManager::clearInterrupt() {
    if (qore_sandbox_manager_check_change(sm, "SandboxManager::clearInterrupt()", xsink)) {
        return QoreValue();
    }
    sm->clearInterrupt();
}

//! Checks if interrupt has been requested
/** @return True if an interrupt has been requested
*/
bool SandboxManager::isInterruptRequested() {
    return sm->isInterruptRequested();
}

//! Returns the full configuration
/** @return a @ref SandboxConfigInfo hash with the full sandbox configuration

    @see SandboxConfigInfo
*/
hash<SandboxConfigInfo> SandboxManager::getConfiguration() {
    return sm->getConfiguration(xsink);
}

//! Creates a preset for maximum restrictions ("lockdown" mode)
/** @return A new SandboxManager configured for maximum security

    Lockdown mode settings:
    - No filesystem access (empty allow list)
    - No network access (empty allow list)
    - Wall time limit per call: 5000ms (see setWallTimeLimit())
    - CPU time limit per call: 1000ms (see setCPUTimeLimit())
    - Stack size limit per call: 1MB (see setMaxStackSize())
    - Memory limit: 10MB (see setMemoryLimit())
    - Max threads: 1

    @par Example:
    @code{.py}
SandboxManager sm = SandboxManager::createLockdown();
    @endcode
*/
static SandboxManager SandboxManager::createLockdown() {
    QoreObject* obj = new QoreObject(QC_SANDBOXMANAGER, getProgram());
    QoreSandboxManager* nsm = QoreSandboxManager::createLockdown();
    // code that is not trusted may change the managers that it creates (issue #5659)
    qore_sandbox_manager_record_creator(nsm);
    obj->setPrivate(CID_SANDBOXMANAGER, nsm);
    return obj;
}

//! Creates a preset safe for web application sandboxing
/** @return A new SandboxManager with web-safe defaults

    Web-safe mode settings:
    - No filesystem access
    - Network allowed but private networks blocked
    - Wall time limit per call: 30000ms (see setWallTimeLimit())
    - CPU time limit per call: 10000ms (see setCPUTimeLimit())
    - Stack size limit per call: 2MB (see setMaxStackSize())
    - Memory limit: 100MB (see setMemoryLimit())
    - Max threads: 4

    @par Example:
    @code{.py}
SandboxManager sm = SandboxManager::createWebSafe();
    @endcode
*/
static SandboxManager SandboxManager::createWebSafe() {
    QoreObject* obj = new QoreObject(QC_SANDBOXMANAGER, getProgram());
    QoreSandboxManager* nsm = QoreSandboxManager::createWebSafe();
    // code that is not trusted may change the managers that it creates (issue #5659)
    qore_sandbox_manager_record_creator(nsm);
    obj->setPrivate(CID_SANDBOXMANAGER, nsm);
    return obj;
}

//! Adds an allowed filesystem path with specific access modes
/** @param path The filesystem path to allow (will be canonicalized)
    @param access_modes Bitmask of QSEC_* flags specifying allowed access modes

    @par Example:
    @code{.py}
sm.addFilesystemAllowedPath(path: "/data/uploads", access_modes: QSEC_READ | QSEC_WRITE);
    @endcode

    @note The path is canonicalized before it is stored; it does not have to exist yet.  Symbolic
    links are resolved, so a rule always names the real path it grants access to.

    @throw SANDBOX-PATH-ERROR the path cannot be canonicalized
    @throw SANDBOX-CONFIG-ERROR the path lies outside the sandbox root
    @throw SANDBOX-PATH-ERROR the path contains a NUL character; see @ref path_nul_characters
*/
nothing SandboxManager::addFilesystemAllowedPath(string path, int access_modes) [flags=NAMED_ARGS] {
    if (qore_sandbox_manager_check_change(sm, "SandboxManager::addFilesystemAllowedPath()", xsink)) {
        return QoreValue();
    }
    // a path cut at a NUL character would name a shorter path, so the rule would cover more than given
    if (q_check_path(*path, "SANDBOX-PATH-ERROR", xsink)) {
        return QoreValue();
    }
    sm->filesystem().addAllowedPath(path->c_str(), access_modes, xsink);
}

//! Adds a denied filesystem path (takes precedence over allowed paths)
/** @param path The filesystem path to deny (will be canonicalized)

    @note Denied paths always take precedence over allowed paths.
    This allows for fine-grained "allow all except" patterns.

    @note The path is canonicalized before it is stored; it does not have to exist yet.

    @throw SANDBOX-PATH-ERROR the path cannot be canonicalized
    @throw SANDBOX-PATH-ERROR the path contains a NUL character; see @ref path_nul_characters
*/
nothing SandboxManager::addFilesystemDeniedPath(string path) [flags=NAMED_ARGS] {
    // only adds restrictions: allowed for any caller (see qore_sandbox_manager_check_change())
    // a path cut at a NUL character would name a shorter path, so the rule would cover more than given
    if (q_check_path(*path, "SANDBOX-PATH-ERROR", xsink)) {
        return QoreValue();
    }
    sm->filesystem().addDeniedPath(path->c_str(), xsink);
}

//! Sets a sandbox root directory (chroot-like restriction)
/** All path access will be restricted to within this directory.
    Symlinks pointing outside the sandbox root will be blocked.

    @param path The root directory for the sandbox

    @par Example:
    @code{.py}
sm.setFilesystemSandboxRoot(path: "/home/user/sandbox");
    @endcode

    @note When a sandbox root is set, all allowed paths must be within
    this root, and the root itself is implicitly allowed with QSEC_ALL.

    @note The path is canonicalized before it is stored; it does not have to exist yet.

    @throw SANDBOX-PATH-ERROR the path cannot be canonicalized
    @throw SANDBOX-PATH-ERROR the path contains a NUL character; see @ref path_nul_characters
*/
nothing SandboxManager::setFilesystemSandboxRoot(string path) [flags=NAMED_ARGS] {
    if (qore_sandbox_manager_check_change(sm, "SandboxManager::setFilesystemSandboxRoot()", xsink)) {
        return QoreValue();
    }
    // a path cut at a NUL character would name a shorter path, so the rule would cover more than given
    if (q_check_path(*path, "SANDBOX-PATH-ERROR", xsink)) {
        return QoreValue();
    }
    sm->filesystem().setSandboxRoot(path->c_str(), xsink);
}

//! Clears the sandbox root directory
/** Removes any previously set sandbox root restriction
*/
nothing SandboxManager::clearFilesystemSandboxRoot() {
    if (qore_sandbox_manager_check_change(sm, "SandboxManager::clearFilesystemSandboxRoot()", xsink)) {
        return QoreValue();
    }
    sm->filesystem().clearSandboxRoot();
}

//! Gets the sandbox root directory
/** @return The sandbox root path or NOTHING if not set
*/
*string SandboxManager::getFilesystemSandboxRoot() {
    QoreHashNode* config = sm->filesystem().getConfiguration(xsink);
    if (!config) {
        return QoreValue();
    }
    QoreValue v = config->getKeyValue("sandbox_root");
    if (v.isNullOrNothing()) {
        config->deref(xsink);
        return QoreValue();
    }
    QoreStringNodeValueHelper str_value(v);
    QoreStringNode* str = str_value.getReferencedValue();
    config->deref(xsink);
    return str;
}

//! Sets whether unlisted filesystem paths are allowed or denied by default
/** @param allow If @ref Qore::True "True", unlisted paths are allowed; if @ref Qore::False "False" (default), denied

    @note The default policy is "deny" for maximum security. Setting this
    to @ref Qore::True "True" means only explicitly denied paths will be blocked.
*/
nothing SandboxManager::setFilesystemDefaultPolicy(bool allow) [flags=NAMED_ARGS] {
    // denying by default only adds restrictions (see qore_sandbox_manager_check_change())
    if (allow && qore_sandbox_manager_check_change(sm, "SandboxManager::setFilesystemDefaultPolicy()", xsink)) {
        return QoreValue();
    }
    sm->filesystem().setDefaultPolicy(allow);
}

//! Gets the current filesystem default policy
/** @return @ref Qore::True "True" if default is allow, @ref Qore::False "False" if default is deny
*/
bool SandboxManager::getFilesystemDefaultPolicy() {
    return sm->filesystem().getDefaultPolicy();
}

//! Sets whether code that the sandbox governs may use uncontrolled APIs
/** Uncontrolled APIs - functions, methods and classes of the @ref Qore::PO_NO_UNCONTROLLED_APIS
    "uncontrolled API" functional domain, such as the Java classes of the \c jni module and the Python objects of the
    \c python module - do I/O and run code that %Qore does not see, so neither the filesystem and network policy nor
    the parse options of the sandbox apply to what they do.  A sandbox that refuses them (the default) refuses the
    code that it governs every call of them at run time, as @ref Qore::PO_NO_UNCONTROLLED_APIS
    "PO_NO_UNCONTROLLED_APIS" does: a call raises \c INVALID-FUNCTION-ACCESS; a system-policy capability of trusted
    code (createSystemPolicyCall()) is not governed, and isGoverned(), getGoverningPolicies() and
    callWithSystemPolicy() are refused only to the code of a sandboxed %Program (see @ref sandbox_uncontrolled_api).
    The policy is also the trust setting of the code that the sandbox governs: code whose sandbox refuses them counts
    as restricted for the rules that keep sandboxed code from such I/O, such as the @ref DataProvider::DataProviderAppInfo "external_io" apps of the data
    provider catalog (see isRestricted() and isUncontrolledApiAllowed()).  It applies to the code that the sandbox
    governs, to library module code that runs for that code, and to objects and callbacks created under the sandbox,
    also when trusted code calls them later.  When more than one sandbox governs the code, the uncontrolled APIs are
    allowed only if every one of them allows them.

    A host that attaches a sandbox only for its resource limits, interrupts or I/O policy, and trusts the code to use
    uncontrolled APIs, allows them.

    @param allow @ref Qore::True "True" to allow code that the sandbox governs to use uncontrolled APIs,
    @ref Qore::False "False" (the default) to refuse them

    @par Example:
    @code{.py}
# a sandbox for interrupting trusted code: the code may use Java and Python
SandboxManager sm();
sm.setFilesystemDefaultPolicy(True);
sm.setNetworkDefaultPolicy(True);
sm.setUncontrolledApiPolicy(True);
pgm.setSandboxManager(sm);
    @endcode

    @throw SANDBOX-ACCESS-ERROR sandboxed code, or code whose functional domains are restricted, tried to allow
    uncontrolled APIs for a sandbox that its own Program did not create

    @since %Qore 3.0
*/
nothing SandboxManager::setUncontrolledApiPolicy(bool allow) [flags=NAMED_ARGS] {
    // denying only adds restrictions (see qore_sandbox_manager_check_change())
    if (allow && qore_sandbox_manager_check_change(sm, "SandboxManager::setUncontrolledApiPolicy()", xsink)) {
        return QoreValue();
    }
    sm->setUncontrolledApiPolicy(allow);
}

//! Returns whether code that the sandbox governs may use uncontrolled APIs
/** @return @ref Qore::True "True" if code that the sandbox governs may use uncontrolled APIs, @ref Qore::False
    "False" if they are refused (the default)

    @see setUncontrolledApiPolicy()

    @since %Qore 3.0
*/
bool SandboxManager::getUncontrolledApiPolicy() [flags=RET_VALUE_ONLY] {
    return sm->getUncontrolledApiPolicy();
}

//! Returns the filesystem security configuration
/** @return a @ref FilesystemSecurityConfigInfo hash with the current filesystem security configuration

    @see FilesystemSecurityConfigInfo
*/
hash<FilesystemSecurityConfigInfo> SandboxManager::getFilesystemConfiguration() {
    return sm->filesystem().getConfiguration(xsink);
}

//! Adds an allowed hostname pattern for network connections
/** @param host_pattern Hostname pattern with optional wildcards (e.g., "*.example.com")

    @par Example:
    @code{.py}
sm.addNetworkAllowedHost(host_pattern: "api.example.com");
sm.addNetworkAllowedHost(host_pattern: "*.trusted-domain.org");
    @endcode

    @note Wildcards only match single domain components.
    "*.example.com" matches "api.example.com" and "example.com" but not "api.sub.example.com".  Host names are
    compared without regard to case and without a trailing dot.

    @note A connection to a host name matching an allowed pattern is allowed unless an address that the name
    resolves to is in a denied IP range or the port is not allowed; see @ref sandbox_net_rules
*/
nothing SandboxManager::addNetworkAllowedHost(string host_pattern) [flags=NAMED_ARGS] {
    if (qore_sandbox_manager_check_change(sm, "SandboxManager::addNetworkAllowedHost()", xsink)) {
        return QoreValue();
    }
    sm->network().addAllowedHost(host_pattern->c_str(), xsink);
}

//! Adds an allowed IP range in CIDR notation
/** @param cidr IP range in CIDR notation (e.g., "10.0.0.0/8" or "2001:db8::/32")

    @par Example:
    @code{.py}
sm.addNetworkAllowedIPRange(cidr: "203.0.113.0/24");   # IPv4
sm.addNetworkAllowedIPRange(cidr: "2001:db8::/32");    # IPv6
    @endcode
*/
nothing SandboxManager::addNetworkAllowedIPRange(string cidr) [flags=NAMED_ARGS] {
    if (qore_sandbox_manager_check_change(sm, "SandboxManager::addNetworkAllowedIPRange()", xsink)) {
        return QoreValue();
    }
    sm->network().addAllowedIPRange(cidr->c_str(), xsink);
}

//! Adds a denied IP range in CIDR notation (takes precedence over allowed)
/** @param cidr IP range in CIDR notation

    @par Example:
    @code{.py}
sm.addNetworkDeniedIPRange(cidr: "192.168.0.0/16");
    @endcode
*/
nothing SandboxManager::addNetworkDeniedIPRange(string cidr) [flags=NAMED_ARGS] {
    // only adds restrictions: allowed for any caller (see qore_sandbox_manager_check_change())
    sm->network().addDeniedIPRange(cidr->c_str(), xsink);
}

//! Adds an allowed port for network connections
/** @param port Port number to allow (1-65535)
    @param protocol Protocol flags (QSEC_NET_TCP, QSEC_NET_UDP, QSEC_NET_ALL)

    @par Example:
    @code{.py}
sm.addNetworkAllowedPort(port: 443, protocol: QSEC_NET_TCP);  # HTTPS only
sm.addNetworkAllowedPort(port: 53, protocol: QSEC_NET_ALL);   # DNS on both TCP and UDP
    @endcode
*/
nothing SandboxManager::addNetworkAllowedPort(int port, int protocol = QSEC_NET_ALL) [flags=NAMED_ARGS] {
    if (qore_sandbox_manager_check_change(sm, "SandboxManager::addNetworkAllowedPort()", xsink)) {
        return QoreValue();
    }
    sm->network().addAllowedPort(port, protocol);
}

//! Adds an allowed port range for network connections
/** @param start_port Lower bound of port range (inclusive)
    @param end_port Upper bound of port range (inclusive)
    @param protocol Protocol flags

    @par Example:
    @code{.py}
sm.addNetworkAllowedPortRange(start_port: 80, end_port: 443, protocol: QSEC_NET_TCP);  # HTTP and HTTPS
    @endcode
*/
nothing SandboxManager::addNetworkAllowedPortRange(int start_port, int end_port, int protocol = QSEC_NET_ALL)
        [flags=NAMED_ARGS] {
    if (qore_sandbox_manager_check_change(sm, "SandboxManager::addNetworkAllowedPortRange()", xsink)) {
        return QoreValue();
    }
    sm->network().addAllowedPortRange(start_port, end_port, protocol);
}

//! Blocks all private/internal networks (SSRF prevention)
/** Blocks the following ranges:
    - 127.0.0.0/8 (localhost)
    - 10.0.0.0/8 (RFC 1918 Class A)
    - 172.16.0.0/12 (RFC 1918 Class B)
    - 192.168.0.0/16 (RFC 1918 Class C)
    - 169.254.0.0/16 (link-local, includes cloud metadata 169.254.169.254)
    - ::1/128 (IPv6 localhost)
    - fe80::/10 (IPv6 link-local)
    - fc00::/7 (IPv6 unique local)

    @note This is essential for SSRF prevention in web applications.

    @note The ranges deny connections and binds to their addresses, except a bind to a loopback address, which can
    only be reached from the local host; see @ref sandboxing

    @par Example:
    @code{.py}
sm.blockPrivateNetworks();
    @endcode
*/
nothing SandboxManager::blockPrivateNetworks() {
    // only adds restrictions: allowed for any caller (see qore_sandbox_manager_check_change())
    sm->network().blockPrivateNetworks();
}

//! Blocks localhost only (127.0.0.0/8 and ::1/128)
/** Connections to loopback addresses are denied; binding a loopback address is not, because a socket bound there
    can only be reached from the local host; see @ref sandboxing

    @par Example:
    @code{.py}
sm.blockLocalhost();
    @endcode
*/
nothing SandboxManager::blockLocalhost() {
    // only adds restrictions: allowed for any caller (see qore_sandbox_manager_check_change())
    sm->network().blockLocalhost();
}

//! Allows only HTTPS connections (port 443 TCP)
/** @par Example:
    @code{.py}
sm.allowHTTPSOnly();
    @endcode
*/
nothing SandboxManager::allowHTTPSOnly() {
    // it adds 443/TCP to the allowed ports: with no port rule every port is allowed already, so it only restricts
    // the ports then (as it does when 443/TCP is allowed already), but it loosens an allowlist that lacks the port
    // (see qore_sandbox_manager_check_change())
    if (!sm->network().allowsPort(443, QSEC_NET_TCP)
        && qore_sandbox_manager_check_change(sm, "SandboxManager::allowHTTPSOnly()", xsink)) {
        return QoreValue();
    }
    sm->network().allowHTTPSOnly();
}

//! Sets whether unlisted network destinations are allowed or denied by default
/** @param allow If @ref Qore::True "True", unlisted destinations are allowed; if @ref Qore::False "False" (default), denied

    The default policy applies to local addresses bound as well as to destinations: with the default deny policy
    and no allowed IP ranges, no socket can be bound; see @ref sandbox_net_rules

    @par Example:
    @code{.py}
sm.setNetworkDefaultPolicy(allow: True);  # Allow by default, only deny listed
    @endcode
*/
nothing SandboxManager::setNetworkDefaultPolicy(bool allow) [flags=NAMED_ARGS] {
    // denying by default only adds restrictions (see qore_sandbox_manager_check_change())
    if (allow && qore_sandbox_manager_check_change(sm, "SandboxManager::setNetworkDefaultPolicy()", xsink)) {
        return QoreValue();
    }
    sm->network().setDefaultPolicy(allow);
}

//! Gets the current network default policy
/** @return @ref Qore::True "True" if default is allow, @ref Qore::False "False" if default is deny
*/
bool SandboxManager::getNetworkDefaultPolicy() {
    return sm->network().getDefaultPolicy();
}

//! Returns the network security configuration
/** @return a @ref NetworkSecurityConfigInfo hash with the current network security configuration

    @see NetworkSecurityConfigInfo
*/
hash<NetworkSecurityConfigInfo> SandboxManager::getNetworkConfiguration() {
    return sm->network().getConfiguration(xsink);
}

//! Calls the given code with the caller's sandbox policy barriered off
/** Sandbox policy normally propagates across program boundaries: code in a Qore-language
    module executes in the module's own %Program, which has no manager of its own, so
    resolution walks out to the calling program and the module inherits the caller's sandbox.
    That is what stops a module from being used to bypass a sandbox, and it is the correct
    default.

    It is wrong, however, for trusted infrastructure that must use a SYSTEM resource while
    acting on a sandboxed caller's behalf -- reading a service-account credential to
    authenticate an outbound API call, for example.  There the caller must not be able to
    reach the resource, but the infrastructure must.

    Calling through this method stops filesystem/network policy resolution at the %Program
    context of the call for its duration, so the caller's policy is not inherited.  Two
    properties keep it narrow:

    - the managers of the Programs entered inside the call still apply, so if @p call
      re-enters sandboxed code (a callback, for example), that code, and any module code it
      calls, is still checked against its sandbox
    - only filesystem/network policy is affected; interrupt and force-terminate checks
      resolve unchanged, so a barriered call remains cancellable

    @note Object and callback provenance remains enforced through this barrier. A reference created while
    serving a sandboxed caller retains that caller's policy. Trusted infrastructure needing access beyond that
    provenance must register a fixed operation with createSystemPolicyCall() during trusted initialization.
    @note This includes a method that a sandboxed Program's subclass inherits from a trusted class: an object that
    the sandboxed Program creates carries its sandbox, so all of its methods run under it, also when trusted code
    with no sandbox on its stack calls them, and a barrier established inside or around such a method does not
    help; the method calls a capability from createSystemPolicyCall() instead, as shown there

    @param call the code to call with the barrier established
    @param call_args optional arguments to @p call

    @return the return value of @p call

    @par Example:
    @code{.py}
# Register the reference during trusted startup.
code read_credential = \read_system_credential();
# Later, mask inherited caller policy; any active provenance still applies.
auto rv = SandboxManager::callWithSystemPolicy(read_credential);
    @endcode

    @note Restricted to @ref Qore::PO_NO_UNCONTROLLED_APIS "PO_NO_UNCONTROLLED_APIS": this
    is by definition an exception to sandbox inheritance, so sandboxed code cannot call it
    @note At run time it is judged by the code that calls it, not by the whole call stack (see
    @ref sandbox_uncontrolled_api): the code of a sandboxed %Program, including a closure or call reference that such
    code created, is refused with \c INVALID-FUNCTION-ACCESS unless every sandbox that governs it allows uncontrolled
    APIs (setUncontrolledApiPolicy()), so sandboxed code cannot establish a barrier of its own; the code of a %Program
    that is not sandboxed (the host's code, a library module, a closure that trusted code created) calls it for a
    sandboxed caller further down the call stack, for an object or callback created under a sandbox, and in a thread
    that sandboxed code started

    @see design/module-sandboxing-audit-guide.md

    @since Qore 3.0
*/
static auto SandboxManager::callWithSystemPolicy(code call, *softlist<auto> call_args)
        [dom=UNCONTROLLED_API] {
    QoreSandboxPolicyBarrierHelper barrier;
    if (!barrier) {
        xsink->raiseException("SANDBOX-BARRIER-ERROR",
            "cannot establish a sandbox policy barrier: no thread data");
        return QoreValue();
    }
    ReferenceHolder<QoreListNode> arglist(call_args ? call_args->listRefSelf() : nullptr,
        xsink);
    return call->invoke(*arglist, xsink);
}

//! Binds a callback to the sandbox that governs its registration
/** Use this when accepting a pre-existing callback from a sandboxed interface. A method reference can bind a
    pre-existing object's selected method without modifying a shared object. Invoke this method in the registering
    interface's Program context. Existing provenance on @p call remains in force as well.

    @param call the fixed callback to bind
    @return a new callback retaining the current sandbox and @p call
    @par Example:
    @code{.py}
code handler = SandboxManager::bindCall(\configured_handler.handleRequest());
    @endcode
    @since %Qore 3.0
*/
static code SandboxManager::bindCall(code call) [flags=RET_VALUE_ONLY] {
    return qore_bind_sandbox_call(call, false, xsink);
}

//! Registers a fixed privileged resource operation before entering sandbox execution
/** The returned callback masks pre-existing filesystem/network policy, including provenance, for its fixed
    operation. It preserves interruption and thread limits. A sandboxed callback invoked by the operation retains
    its own provenance and Program policy. The operation must validate its arguments; registering an arbitrary
    file reader or callback executor would grant that unrestricted operation to anyone holding the result.

    @param call a callback created outside sandbox execution
    @return a capability for the fixed callback
    @throw SANDBOX-CAPABILITY-ERROR a sandbox governs registration, or @p call has sandbox provenance
    @note Register capabilities during trusted initialization, before loading or invoking tenant code. An ordinary
    callWithSystemPolicy() barrier does not remove object or callback provenance.
    @note The arguments of a call to the returned capability are evaluated by the caller, under the caller's own
    sandbox, before the capability runs; the caller's local variables, including those captured by its closures,
    can be passed to it
    @note This is the mechanism for a method that a sandboxed Program's subclass inherits from a trusted class. An
    object that a sandboxed Program creates carries its sandbox (its provenance), so every method of the object runs
    under it, including one inherited from a trusted class and called by trusted code with no sandbox on its stack:

    |!How the inherited method uses a system resource|!Result
    |directly|denied
    |inside callWithSystemPolicy()|denied: a policy barrier does not mask provenance
    |by calling a capability returned by this method, registered during trusted startup|allowed
    |by calling a capability that calls a method of the sandbox-created object|denied: the method runs with the object's provenance

    @par Example:
    @code{.py}
# During trusted startup; the callback uses a fixed, system-owned credential path.
code authenticate = SandboxManager::createSystemPolicyCall(\authenticate_provider());
# Later, while serving a sandboxed caller:
authenticate();
    @endcode

    @par Example:
    @code{.py}
# a framework base class that sandboxed code subclasses: its method uses the network through a capability
our code Connector;
sub connect_port(int port) { Socket s(); s.connect("127.0.0.1:" + port, 5s); }
class Base {
    connect(int port) { Connector(port); }
}
# during trusted startup, before any sandboxed code runs
Connector = SandboxManager::createSystemPolicyCall(\connect_port());
    @endcode
    @see design/module-sandboxing-audit-guide.md
    @since %Qore 3.0
*/
static code SandboxManager::createSystemPolicyCall(code call) [dom=UNCONTROLLED_API; flags=RET_VALUE_ONLY] {
    return qore_bind_sandbox_call(call, true, xsink);
}

//! Creates a capability that starts a fixed operation in a new thread that no sandbox governs
/** Trusted infrastructure that does work for sandboxed callers, such as building shared state that every caller then
    uses, cannot do that work on the caller's thread: what it creates there keeps the caller's sandbox (its
    provenance), including its interrupts, and a thread that it starts there inherits the sandbox and counts against
    its limits (see createSystemPolicyCall()).  The capability returned by this method starts @p call in a new thread
    of the Program that created the capability, which:
    - does not inherit the sandbox of the code that calls the capability: no sandbox governs it, the sandbox's
      interrupts and limits do not reach it, and it does not count against the sandbox's thread limit
    - runs only @p call, fixed when the capability is created: the capability takes no arguments, so nothing of the
      caller reaches the thread; work for it must arrive through the module's own state, such as a queue that the
      module created during its initialization

    Anyone who can read the capability can start threads that no sandbox governs: keep it where no other code can read
    it, as in an internal member (\c private:internal), never in a public or \c private member, which a subclass,
    possibly a sandboxed one, can read, nor in a global variable.

    The thread is counted as any other thread: the library waits for it to end before the process ends, so the module
    stops it from an exit hook (see register_exit_hook()).  No thread is started once the exit hooks of the process
    have started, so the hook that stops the thread always runs after it was started.

    @param call the operation that the thread runs; a plain callback created by trusted code

    @return a capability that starts a new thread running @p call each time it is called, and returns its TID

    @throw SANDBOX-CAPABILITY-ERROR a sandbox governs the code creating the capability; @p call has sandbox provenance,
    or is a bound callback or a capability; the exit hooks of the process have started; or no module is being loaded:
    the capability can only be created during a module's initialization, before any code it serves runs.  A call of
    the capability raises \c SANDBOX-CAPABILITY-ERROR if it is given arguments, or once the exit hooks of the process
    have started

    @par Example:
    @code{.py}
class Worker {
    private:internal {
        # the work, which reaches the thread only through the module's own state
        static Queue jobs();
        # created when the module is loaded; internal, so that no other code, not even a subclass, can read it
        static code start = Worker::init();
    }

    # also while serving a sandboxed caller
    static submit(string job) {
        jobs.push(job);
        code c = start;
        c();
    }

    private:internal static code init() {
        register_exit_hook(sub () { Worker::jobs.push(NOTHING); });
        return SandboxManager::createSystemThreadCall(\Worker::run());
    }

    private:internal static run() {
        while (*string job = jobs.get()) {
            # ... the module's fixed work
        }
    }
}
    @endcode

    @note Restricted to @ref Qore::PO_NO_UNCONTROLLED_APIS "PO_NO_UNCONTROLLED_APIS" and
    @ref Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL"

    @see design/module-sandboxing-audit-guide.md

    @since %Qore 3.0
*/
static code SandboxManager::createSystemThreadCall(code call) [dom=UNCONTROLLED_API,THREAD_CONTROL;flags=RET_VALUE_ONLY] {
    return qore_create_system_thread_call(call, xsink);
}

//! Returns @ref True if a sandbox governs the filesystem and network access of the current thread's code
/** Resolves the sandbox exactly as the filesystem and network checks do: the Programs on the call stack, the
    provenance of the objects and callbacks whose code runs, the sandbox inherited by a thread started for sandboxed
    code, policy barriers (callWithSystemPolicy()) and system-policy capabilities (createSystemPolicyCall()).  Trusted
    code that decides on behalf of its caller - whether an API may be used, which tenant's resources a name refers to
    - can therefore fail closed when its caller is sandboxed, without keeping that state itself, also on paths where
    its own bookkeeping is not set up, such as a callback that it runs outside its normal request handling.

    @return @ref True if a sandbox governs the current thread's filesystem and network access, @ref False if not

    @par Example:
    @code{.py}
# a trusted service API: administrative operations are not available to sandboxed callers
hash<auto> sub admin_reset(string name) {
    if (SandboxManager::isGoverned()) {
        throw "ACCESS-DENIED", sprintf("%y: administrative operations cannot be called from sandboxed code", name);
    }
    return do_reset(name);
}
    @endcode

    @note
    - inside a policy barrier or a system-policy capability, the caller's sandbox does not govern the access, so
      this method returns @ref False there unless a sandbox governs the code entered inside it, as the filesystem
      and network checks do; use it in the code that acts on behalf of the caller, not in the code run under the
      system policy
    - code of an object that a sandboxed Program created is governed by that Program's sandbox, also when it
      implements a method inherited from a trusted class (see design/module-sandboxing-audit-guide.md)
    - restricted to @ref Qore::PO_NO_UNCONTROLLED_APIS "PO_NO_UNCONTROLLED_APIS", like the other methods that
      expose or mask sandbox policy
    - at run time it is judged by the code that calls it, not by the whole call stack (see
      @ref sandbox_uncontrolled_api): trusted code (the code of a %Program that is not sandboxed, such as the host's
      code, a library module or a closure that trusted code created) calls it for its sandboxed callers, as in the
      example; the code of a sandboxed %Program, including a closure or call reference that such code created, is
      refused with \c INVALID-FUNCTION-ACCESS unless every sandbox that governs it allows uncontrolled APIs
      (setUncontrolledApiPolicy())

    @see
    - getGoverningPolicies()
    - isSandboxed(), which also sees a sandbox through a policy barrier and is not restricted

    @since %Qore 3.0
*/
static bool SandboxManager::isGoverned() [dom=UNCONTROLLED_API; flags=RET_VALUE_ONLY] {
    QoreSandboxManagerHelper policy(QoreSandboxManagerHelper::Policy);
    return static_cast<bool>(policy);
}

//! Returns @ref True if any sandbox governs the current thread's code, also inside a policy barrier
/** Resolves the governing sandbox as interrupts and resource limits do, and as createSystemThreadCall() checks its
    creator: the Programs on the call stack, the provenance of the objects and callbacks whose code runs, and the
    sandbox inherited by a thread started for sandboxed code, through any policy barrier (callWithSystemPolicy()) or
    system-policy capability (createSystemPolicyCall()).  Unlike isGoverned(), which answers whether a sandbox's
    filesystem and network policy applies, it answers whether the thread serves sandboxed code at all: trusted
    infrastructure that keeps state shared with every caller, or that starts work that outlives the call, uses it to
    decide where that work runs, also when it is called under a policy barrier on behalf of a sandboxed caller.

    It masks nothing and reveals only whether the calling code is itself sandboxed, so it is not restricted: trusted
    modules use it also when they serve code restricted with
    @ref Qore::PO_NO_UNCONTROLLED_APIS "PO_NO_UNCONTROLLED_APIS".

    @return @ref True if a sandbox governs the current thread's code, also through a policy barrier; @ref False if
    not

    @par Example:
    @code{.py}
# shared state is built only for trusted callers; sandboxed callers, also under a policy barrier, get it built
# elsewhere
if (SandboxManager::isSandboxed()) {
    queueBuild();
} else {
    build();
}
    @endcode

    @see isGoverned()

    @since %Qore 3.0
*/
static bool SandboxManager::isSandboxed() [flags=RET_VALUE_ONLY] {
    QoreSandboxManagerHelper governing(QoreSandboxManagerHelper::All);
    return static_cast<bool>(governing);
}

//! Returns @ref True if the current thread's code may use uncontrolled APIs
/** Resolves the sandboxes that govern the code as isGoverned() does, as the filesystem and network checks do: a policy
    barrier (callWithSystemPolicy()) and a system-policy capability of trusted code (createSystemPolicyCall()) are
    honoured.  Uncontrolled APIs are allowed if no sandbox governs the code or if every governing sandbox allows them
    (setUncontrolledApiPolicy()).

    Like isSandboxed(), it reveals only whether the calling code is restricted, so it is not restricted itself.

    @return @ref True if the code may use uncontrolled APIs, @ref False if a governing sandbox refuses them

    @see
    - isRestricted(), which sees the sandbox through a policy barrier
    - setUncontrolledApiPolicy()

    @since %Qore 3.0
*/
static bool SandboxManager::isUncontrolledApiAllowed() [flags=RET_VALUE_ONLY] {
    return qore_sandbox_allows_uncontrolled_apis(QoreSandboxManagerHelper::Policy);
}

//! Returns @ref True if a sandbox that does not trust the current thread's code governs it, also inside a policy barrier
/** Resolves the governing sandbox as isSandboxed() does, through any policy barrier or system-policy capability, and
    returns @ref True only if a governing sandbox refuses uncontrolled APIs (setUncontrolledApiPolicy(), the default).
    A sandbox that a host attaches only for resource limits, interrupts or I/O policy, and that allows uncontrolled
    APIs, does not make its code restricted: the host trusts that code to run arbitrary code in Java or Python, which can
    reach everything that a restriction based on this method protects.

    Trusted infrastructure uses it where a sandboxed caller must be refused I/O that the sandbox does not control
    (for example the @ref DataProvider::DataProviderAppInfo::external_io "external_io" apps of the data provider
    catalog), and isSandboxed() where it decides where work runs or refuses a process-wide registration: what code
    that a sandbox governs registers carries that sandbox, whatever its policy.

    It masks nothing and reveals only whether the calling code is restricted, so it is not restricted itself.

    @return @ref True if a governing sandbox refuses uncontrolled APIs, also through a policy barrier; @ref False if
    no sandbox governs the code or every governing sandbox allows them

    @par Example:
    @code{.py}
# I/O that the sandbox does not control: refused to tenants, allowed to trusted code that a sandbox governs only
# for its interrupts
if (SandboxManager::isRestricted()) {
    throw "ACCESS-DENIED", "sandboxed code cannot use this connection";
}
    @endcode

    @see
    - isSandboxed()
    - isUncontrolledApiAllowed()

    @since %Qore 3.0
*/
static bool SandboxManager::isRestricted() [flags=RET_VALUE_ONLY] {
    return !qore_sandbox_allows_uncontrolled_apis(QoreSandboxManagerHelper::All);
}

//! Returns the configuration of each sandbox that governs the filesystem and network access of the current thread's code
/** The sandboxes are resolved as with isGoverned().  When more than one governs the access - the sandbox of the
    Programs on the call stack and that of an object or callback created by sandboxed code, for example - an access
    is allowed only if every one of them allows it, and each is returned.

    @return the configuration of each governing sandbox, in no particular order; an empty list if no sandbox governs
    the access.  The hashes are copies: changing them changes no sandbox

    @par Example:
    @code{.py}
# a trusted service API logs the limits that apply to its caller
list<hash<SandboxConfigInfo>> policies = SandboxManager::getGoverningPolicies();
foreach hash<SandboxConfigInfo> policy in (policies) {
    log(LL_INFO, "caller sandbox: max threads: %d, network default policy: %s", policy.max_threads,
        policy.network.default_policy);
}
    @endcode

    @note restricted to @ref Qore::PO_NO_UNCONTROLLED_APIS "PO_NO_UNCONTROLLED_APIS", like isGoverned(), and judged at
    run time by the code that calls it as isGoverned() is: trusted code calls it for its sandboxed callers, as in the
    example, while the code of a sandboxed %Program is refused with \c INVALID-FUNCTION-ACCESS unless every sandbox
    that governs it allows uncontrolled APIs

    @see isGoverned()

    @since %Qore 3.0
*/
static list<hash<SandboxConfigInfo>> SandboxManager::getGoverningPolicies() [dom=UNCONTROLLED_API; flags=RET_VALUE_ONLY] {
    ReferenceHolder<QoreListNode> rv(new QoreListNode(hashdeclSandboxConfigInfo->getTypeInfo()), xsink);
    QoreSandboxManagerHelper policy(QoreSandboxManagerHelper::Policy);
    if (!policy) {
        return rv.release();
    }
    // a combination of managers has no policy of its own: each member's is returned
    const std::vector<QoreSandboxManager*>* members = QoreSandboxComposition::members(policy.get());
    std::vector<QoreSandboxManager*> single;
    if (!members) {
        single.push_back(policy.get());
        members = &single;
    }
    for (QoreSandboxManager* sm : *members) {
        ReferenceHolder<QoreHashNode> h(sm->getConfiguration(xsink), xsink);
        if (*xsink) {
            return QoreValue();
        }
        rv->push(h.release(), xsink);
        if (*xsink) {
            return QoreValue();
        }
    }
    return rv.release();
}
