#include <qore/Qore.h>

/** @cond INTERNAL */
class AbstractFuture {
};
/** @endcond */

//! Abstract base class for Future objects
/** Future objects allow a thread to block until a result is available from another thread.

    The standard implementation is created by calling
    @ref Qore::Thread::Promise::getFuture() "Promise::getFuture()".
    Subclasses can override get(), isDone(), and isError() to implement
    custom Future behavior (e.g., wrapping another Future with post-processing).

    @par Example: Basic async computation
    @code{.py}
Promise p();
Future f = p.getFuture();
background sub() { p.set(42); }();
auto result = f.get();  # blocks until set, returns 42
    @endcode

    @par Example: Custom Future subclass
    @code{.py}
class TransformingFuture inherits Future {
    private { Future real; code transform; }
    constructor(Future real, code transform) { self.real = real; self.transform = transform; }
    auto get(timeout t = 0) { return transform(real.get(t)); }
    bool isDone() { return real.isDone(); }
    bool isError() { return real.isError(); }
}
    @endcode

    @see @ref Qore::Thread::Promise "Promise"
    @see @ref call_async()

    @note This class is not available with the @ref PO_NO_THREAD_CLASSES parse option.

    @since %Qore 2.3
 */
qclass Future [dom=THREAD_CLASS; arg=AbstractFuture* f; ns=Qore::Thread];

//! Blocks the calling thread until the result is available or an error occurs
/** @param timeout_ms a @ref timeout_type "timeout" value to wait; integers are
    interpreted as milliseconds; @ref relative_dates "relative date/time values"
    are interpreted literally (with a resolution of milliseconds); 0 (the default)
    means wait indefinitely

    @return the value set by the associated Promise

    @throw FUTURE-TIMEOUT timed out waiting for the result
    @throw FUTURE-ERROR Future object was deleted in another thread while waiting
    @throw PROMISE-ERROR Promise was destroyed without setting a value

    @note Any exception set via @ref Qore::Thread::Promise::setError() "Promise::setError()"
    will be re-thrown here
 */
abstract auto Future::get(timeout timeout_ms = 0);

//! Returns @ref True if the Future has been resolved or rejected
/** @return @ref True if the result is available (resolved) or an error has been set (rejected)
 */
abstract bool Future::isDone();

//! Returns @ref True if the Future has been rejected with an error
/** @return @ref True if an error has been set
 */
abstract bool Future::isError();
