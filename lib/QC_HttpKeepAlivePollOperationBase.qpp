#include "qore/Qore.h"
#include "qore/intern/QC_HttpKeepAlivePollOperationBase.h"
#include "qore/intern/QC_SocketPollOperationBase.h"
#include "qore/intern/QC_Socket.h"
#include "qore/intern/qore_socket_private.h"
#include "qore/intern/PollStateCloseHook.h"

/** @cond INTERNAL */

// ============================================================
// HttpKeepAlivePollOperationPriv implementation
// ============================================================

HttpKeepAlivePollOperationPriv::HttpKeepAlivePollOperationPriv(QoreObject* self, QoreSocketObject* sock,
        int64_t ttl_ms)
    : SocketPollOperationBase(self), sock_obj(sock), header_op(nullptr), header_output(nullptr),
      phase(Phase::IDLE), op_state(State::IDLE), header_deadline_us(0), ttl_us(ttl_ms * 1000LL) {
    // sock is already ref'd by the QPP caller
    // ttl_ms comes from Qore's "timeout" type which is milliseconds; convert to microseconds
    deadline_us = nowUs() + ttl_us;
}

HttpKeepAlivePollOperationPriv::~HttpKeepAlivePollOperationPriv() {
    if (sock_obj || header_op || header_output) {
        ExceptionSink xsink;
        cleanup(&xsink);
    }
}

bool HttpKeepAlivePollOperationPriv::goalReached() const {
    return op_state == State::HEADER_COMPLETE
        || op_state == State::CLOSED
        || op_state == State::TIMEOUT;
}

QoreHashNode* HttpKeepAlivePollOperationPriv::continuePoll(ExceptionSink* xsink) {
    if (goalReached()) {
        return nullptr;
    }

    if (phase == Phase::IDLE) {
        return continueIdlePoll(xsink);
    }
    return continueHeaderPoll(xsink);
}

bool HttpKeepAlivePollOperationPriv::transitionState(State from, State to, const char* site) {
#ifdef DEBUG
    bool hook_fired = false;
    if (PollStateCloseHook::take(this, site)) {
        // what another thread does at this moment: the Qore-level abort(), or a timeout's worker abort
        ExceptionSink abort_xsink;
        abort(&abort_xsink);
        abort_xsink.clear();
        hook_fired = true;
    }
#endif
    State expected = from;
    bool rv = op_state.compare_exchange_strong(expected, to, std::memory_order_acq_rel, std::memory_order_acquire);
#ifdef DEBUG
    if (hook_fired) {
        // whether the abort's close was kept: the store did not replace it
        PollStateCloseHook::fired(!rv && op_state.load(std::memory_order_acquire) == State::CLOSED);
    }
#endif
    return rv;
}

void HttpKeepAlivePollOperationPriv::abort(ExceptionSink* xsink) {
    op_state = State::CLOSED;
    // abort() runs on any thread: the header operation is created and released meanwhile, so it is referenced under
    // op_lock
    SocketReadHttpHeaderPollOperation* op;
    {
        AutoLocker al(op_lock);
        op = header_op;
        if (op) {
            op->ref();
        }
    }
    if (op) {
        op->abort(xsink);
        op->deref(xsink);
    }
}

void HttpKeepAlivePollOperationPriv::releaseHeaderOp(ExceptionSink* xsink) {
    SocketReadHttpHeaderPollOperation* op;
    {
        AutoLocker al(op_lock);
        op = header_op;
        header_op = nullptr;
    }
#ifdef DEBUG
    // what another thread's abort() does while the operation is released
    if (op && PollStateCloseHook::take(this, "release-header-op")) {
        ExceptionSink abort_xsink;
        abort(&abort_xsink);
        abort_xsink.clear();
        PollStateCloseHook::fired(op_state.load(std::memory_order_acquire) == State::CLOSED);
    }
#endif
    if (op) {
        op->deref(xsink);
    }
}

QoreValue HttpKeepAlivePollOperationPriv::getOutput() const {
    if (header_output) {
        header_output->ref();
        return header_output;
    }

    ExceptionSink xsink;
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), &xsink);
    h->setKeyValue("sock", getReferencedSocketObject(&xsink), &xsink);

    const char* state_str;
    switch (op_state) {
        case State::IDLE:               state_str = "idle"; break;
        case State::HEADER_READING:     state_str = "header_reading"; break;
        case State::HEADER_COMPLETE:    state_str = "header_complete"; break;
        case State::CLOSED:             state_str = "closed"; break;
        case State::TIMEOUT:            state_str = "timeout"; break;
        default:                        state_str = "unknown"; break;
    }
    h->setKeyValue("state", new QoreStringNode(state_str), &xsink);
    return h.release();
}

void HttpKeepAlivePollOperationPriv::resetForIdle() {
    // CLOSED is final: an operation that abort() closed (any thread) or whose connection was closed is not made idle
    // again; it only releases its header state
    State cur = op_state.load(std::memory_order_acquire);
    bool reset;
    while ((reset = (cur != State::CLOSED))
            && !op_state.compare_exchange_weak(cur, State::IDLE, std::memory_order_acq_rel, std::memory_order_acquire)) {
    }
    if (reset) {
        phase = Phase::IDLE;
    }
    deadline_us = nowUs() + ttl_us;
    header_deadline_us = 0;
    {
        ExceptionSink xsink;
        releaseHeaderOp(&xsink);
    }
    if (header_output) {
        header_output->deref(nullptr);
        header_output = nullptr;
    }
}

void HttpKeepAlivePollOperationPriv::cleanup(ExceptionSink* xsink) {
    releaseHeaderOp(xsink);
    if (header_output) {
        header_output->deref(xsink);
        header_output = nullptr;
    }
    if (sock_obj) {
        sock_obj->deref(xsink);
        sock_obj = nullptr;
    }
}

const char* HttpKeepAlivePollOperationPriv::getStateImpl() const {
    switch (op_state) {
        case State::IDLE:               return "idle";
        case State::HEADER_READING:     return "header_reading";
        case State::HEADER_COMPLETE:    return "header_complete";
        case State::CLOSED:             return "closed";
        case State::TIMEOUT:            return "timeout";
        default:                        return "unknown";
    }
}

QoreHashNode* HttpKeepAlivePollOperationPriv::continueIdlePoll(ExceptionSink* xsink) {
    // Check for timeout
    if (nowUs() > deadline_us) {
        transitionState(State::IDLE, State::TIMEOUT, "idle-timeout");
        return nullptr;
    }

    // Check if socket is still connected
    if (!sock_obj->isOpen()) {
        transitionState(State::IDLE, State::CLOSED, "idle-peer-closed");
        return nullptr;
    }

    // Check for data, EOF, or fatal errors via the central async-safe idle
    // probe. This handles TLS connections with SSL_peek(), so TLS
    // post-handshake records do not look like application data forever.
    int idle_rc = sock_obj->checkIdleDataForAsyncPoll(xsink, true);
    if (*xsink || idle_rc < 0) {
        transitionState(State::IDLE, State::CLOSED, "idle-error");
        sock_obj->closeIo(xsink);
        return nullptr;
    }
    if (idle_rc > 0) {
        return transitionToHeaderPhase(xsink);
    }

    // a draining server closes a connection that has no request (a request that arrived is read above and answered
    // with Connection: close) (qore#5899)
    if (sock_obj->isHttpDraining()) {
        transitionState(State::IDLE, State::CLOSED, "idle-drained");
        return nullptr;
    }

    // Need to wait for data; include poll_timeout_ms so the EventLoop wakes up
    // when the idle deadline expires, not just when the full operation timeout expires
    int64_t remaining_us = deadline_us - nowUs();
    int remaining_ms = static_cast<int>(remaining_us / 1000);
    if (remaining_ms <= 0) {
        remaining_ms = 1;
    }

    ReferenceHolder<QoreHashNode> info(new QoreHashNode(hashdeclSocketPollInfo, xsink), xsink);
    info->setKeyValue("events", SOCK_POLLIN, xsink);
    info->setKeyValue("socket", getReferencedSocketObject(xsink), xsink);
    info->setKeyValue("poll_timeout_ms", remaining_ms, xsink);
    return info.release();
}

QoreHashNode* HttpKeepAlivePollOperationPriv::transitionToHeaderPhase(ExceptionSink* xsink) {
    // an aborted operation does not start reading the request header
    if (!transitionState(State::IDLE, State::HEADER_READING, "header-reading")) {
        return nullptr;
    }
    phase = Phase::HEADER;
    header_deadline_us = nowUs() + DEFAULT_HEADER_READ_TIMEOUT_US;

    // Create the inner header read operation — ref the socket for it
    sock_obj->ref();
    {
        // set with op_lock held: abort() reads it from other threads
        SocketReadHttpHeaderPollOperation* op = new SocketReadHttpHeaderPollOperation(xsink, sock_obj);
        AutoLocker al(op_lock);
        header_op = op;
    }
    if (*xsink) {
        // Construction failed; the SocketReadHttpHeaderPollOperation constructor
        // handles socket cleanup on error internally
        releaseHeaderOp(xsink);
        transitionState(State::HEADER_READING, State::CLOSED, "header-op-error");
        return nullptr;
    }
    // Set our QoreObject as the inner op's self so that getSocketPollInfoHash()
    // can resolve the "sock" member for poll info hashes
    assert(self);
    header_op->setSelf(*self);
#ifdef DEBUG
    // what another thread's abort() does after the header phase started
    if (PollStateCloseHook::take(this, "header-op-created")) {
        ExceptionSink abort_xsink;
        abort(&abort_xsink);
        abort_xsink.clear();
        PollStateCloseHook::fired(op_state.load(std::memory_order_acquire) == State::CLOSED);
    }
#endif

    // Immediately continue the header poll to drive it forward
    return continueHeaderPoll(xsink);
}

QoreHashNode* HttpKeepAlivePollOperationPriv::continueHeaderPoll(ExceptionSink* xsink) {
    // an operation aborted (any thread) after it entered the header phase reads no more
    if (op_state.load(std::memory_order_acquire) != State::HEADER_READING) {
        return nullptr;
    }
    // Enforce header read timeout to prevent slow-loris on keep-alive connections
    if (nowUs() > header_deadline_us) {
        transitionState(State::HEADER_READING, State::TIMEOUT, "header-timeout");
        return nullptr;
    }

    QoreHashNode* info = header_op->continuePoll(xsink);
    if (*xsink) {
        transitionState(State::HEADER_READING, State::CLOSED, "header-error");
        return nullptr;
    }
    if (!info) {
        // Header reading complete, unless the operation was aborted meanwhile
        if (!transitionState(State::HEADER_READING, State::HEADER_COMPLETE, "header-complete")) {
            return nullptr;
        }
        QoreValue output = header_op->getOutput();
        header_output = output.getType() == NT_HASH
            ? output.get<QoreHashNode>() : nullptr;
        return nullptr;
    }
    return info;
}

/** @endcond */

//! C++ base class for combined idle + header read HTTP keep-alive poll operation
/** This class implements the core poll logic for a two-phase keep-alive
    connection operation in pure C++, enabling the AsyncIoController I/O
    thread to drive the poll without Qore interpreter overhead.

    Phase 1 (idle): monitors for incoming data, connection close, or timeout.
    Phase 2 (header): delegates to SocketReadHttpHeaderPollOperation with its
    own timeout for slow-loris protection.

    When data arrives during idle, transitions to header reading inline
    (no return to controller).

    @since %Qore 3.0
*/
qclass HttpKeepAlivePollOperationBase [
    private_members=object sock,string goal;
    ns=Qore;
    arg=HttpKeepAlivePollOperationPriv* priv;
    vparent=SocketPollOperationBase<hash<auto>>
];

//! Creates the keep-alive poll operation
/** @param socket the Socket to monitor
    @param timeout_ms keep-alive timeout in milliseconds
*/
HttpKeepAlivePollOperationBase::constructor(Socket[QoreSocketObject] socket, int timeout_ms) [flags=NAMED_ARGS] {
    QoreSocketObject* sock_ptr = *socket;

    // Store socket as Qore member for DGC visibility
    QoreValue sock_arg = args->retrieveEntry(0);
    QoreObject* sock_qobj = sock_arg.getType() == NT_OBJECT
        ? const_cast<QoreObject*>(sock_arg.get<const QoreObject>()) : nullptr;
    if (sock_qobj) {
        self->setMemberValue("sock", QC_HTTPKEEPALIVEPOLLOPERATIONBASE, sock_qobj->refSelf(), xsink);
    }
    self->setMemberValue("goal", QC_HTTPKEEPALIVEPOLLOPERATIONBASE,
        new QoreStringNode("keep_alive_idle"), xsink);

    sock_ptr->ref();
    self->setPrivate(CID_HTTPKEEPALIVEPOLLOPERATIONBASE,
        new HttpKeepAlivePollOperationPriv(self, sock_ptr, timeout_ms));
}

//! Destroys the object
/** Releases all internal references.
*/
HttpKeepAlivePollOperationBase::destructor() {
    priv->cleanup(xsink);
    priv->deref(xsink);
}

//! Throws an exception; objects of this class cannot be copied
/** @throw HTTPKEEPALIVEPOLLOPERATIONBASE-COPY-ERROR objects of this class cannot be copied
*/
HttpKeepAlivePollOperationBase::copy() {
    xsink->raiseException("HTTPKEEPALIVEPOLLOPERATIONBASE-COPY-ERROR",
        "objects of this class cannot be copied");
}

//! Returns the goal of the operation
/** @return "keep_alive_idle" or "keep_alive_header" depending on the current phase
*/
string HttpKeepAlivePollOperationBase::getGoal() {
    return self->getReferencedMemberNoMethod("goal", xsink);
}

//! Returns the current state
/** @return one of "idle", "header_reading", "header_complete", "closed", or "timeout"
*/
string HttpKeepAlivePollOperationBase::getState() [flags=RET_VALUE_ONLY] {
    return priv->getState();
}

//! Returns True when the operation is complete
/** @return True when headers are read, connection closed, or timeout expired
*/
bool HttpKeepAlivePollOperationBase::goalReached() [flags=RET_VALUE_ONLY] {
    return priv->goalReached();
}

//! Continues the poll operation
/** @return socket poll info for the next poll cycle, or @ref nothing if polling is complete
*/
*hash<SocketPollInfo> HttpKeepAlivePollOperationBase::continuePoll() {
    return priv->continuePoll(xsink);
}

//! Aborts the operation
/** Sets the state to "closed" and aborts any inner header read operation.
*/
nothing HttpKeepAlivePollOperationBase::abort() {
    priv->abort(xsink);
}

//! Returns the output of the operation
/** @return the parsed HTTP header hash if headers were read, or a state hash otherwise
*/
hash<auto> HttpKeepAlivePollOperationBase::getOutput() [flags=RET_VALUE_ONLY] {
    return priv->getOutput();
}

//! Returns True if the operation timed out (idle or header phase)
/** @return True if the idle timeout or header read timeout expired
*/
bool HttpKeepAlivePollOperationBase::timedOut() [flags=RET_VALUE_ONLY] {
    return priv->timedOut();
}

//! Returns True if headers were successfully read
/** @return True if the header phase completed successfully
*/
bool HttpKeepAlivePollOperationBase::headersReady() [flags=RET_VALUE_ONLY] {
    return priv->headersReady();
}

//! Returns True if the connection was closed
/** @return True if the socket was closed by peer or the operation was aborted
*/
bool HttpKeepAlivePollOperationBase::wasClosed() [flags=RET_VALUE_ONLY] {
    return priv->wasClosed();
}

//! Returns the current phase
/** @return "idle" or "header"
*/
string HttpKeepAlivePollOperationBase::getPhase() [flags=RET_VALUE_ONLY] {
    return new QoreStringNode(priv->getPhase());
}

//! Resets the operation for another idle cycle (persistent registration)
/** Resets phase to idle, clears header state, and sets a new deadline.
*/
nothing HttpKeepAlivePollOperationBase::resetForIdle() {
    priv->resetForIdle();
    // Update the goal member
    self->setMemberValue("goal", QC_HTTPKEEPALIVEPOLLOPERATIONBASE,
        new QoreStringNode("keep_alive_idle"), xsink);
}

//! Returns the socket being monitored
/** @return the Socket object
*/
Socket HttpKeepAlivePollOperationBase::getSocket() {
    return self->getReferencedMemberNoMethod("sock", xsink);
}
