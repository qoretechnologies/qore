#include "qore/Qore.h"
#include "qore/intern/EncodingConversionInputStream.h"
#include "qore/intern/QoreObjectIntern.h"
#include "qore/intern/QoreClassIntern.h"

//! An @ref InputStream implementation that performs on-the-fly conversion between two character encodings.
/** @par Example: EncodingConversionInputStream basic usage
    @code{.py}
    EncodingConversionInputStream latin2Stream(sourceUtf8Stream, "UTF-8", "ISO-8859-2");
    binary *b;
    while (b = latin2Stream.read(20)) {
        #b contains up to 20 bytes representing latin-2 characters
    }
    @endcode

    Input that is not valid in the source encoding raises \c INVALID-ENCODING when it is read, unless the
    \c encoding_errors option of the constructor is \c "latin1" or \c "keep"; a character that the target encoding
    cannot hold raises \c ENCODING-CONVERSION-ERROR, as does a byte sequence that has the form of a character but
    is not defined in the source encoding (ex: \c 0x81 in \c CP1252), also with \c "latin1"; \c "keep" also keeps a
    byte order mark that the other values remove; see @ref encoding_conversion_streams.

    @note stream classes are not designed to be accessed from multiple threads; they have been implemented without
    locking for fast and efficient use when used from a single thread.  For methods that would be unsafe to use in
    another thread, any use of such methods in threads other than the thread where the constructor was called will
    cause a \c STREAM-THREAD-ERROR to be thrown, unless the stream is handed
    off to another thread using the @ref Qore::StreamBase::unassignThread() "StreamBase::unassignThread()"
    method in the thread that currently owns the stream, and the
    @ref Qore::StreamBase::reassignThread() "StreamBase::reassignThread()" method in the new thread.

    @see @ref Qore::StreamReader "StreamReader" for a class that can be used to read various kinds of data from an @ref Qore::InputStream "InputStream"

    @since %Qore 0.8.13
 */
qclass EncodingConversionInputStream [arg=EncodingConversionInputStream* is; ns=Qore; vparent=InputStream; flags=final; internal_members=InputStream is;];

//! Creates the EncodingConversionInputStream based on the \ref InputStream given
/**
    @param input_stream the source \ref InputStream to read bytes from
    @param source_encoding the encoding of the characters in the source input stream
    @param target_encoding the destination character encoding
    @param encoding_errors what input that is not valid in the source encoding gives; one of the
    @ref encoding_errors_constants: \c "raise" (the default) raises \c INVALID-ENCODING when it is read,
    \c "latin1" takes each byte that does not start a valid character of the source encoding (in a Unicode encoding
    form such as UTF-16 or UTF-32, each byte of a code unit that does not start one) as the ISO-8859-1 character of
    that byte and converts it to the target encoding, \c "keep" passes the bytes as they are without a check, and is
    only allowed when the source and target encodings are the same; see @ref encoding_errors

    @throw ENCODING-CONVERSION-ERROR if either of the encodings is unsupported
    @throw ENCODING-ERRORS-ERROR an unknown \a encoding_errors value was given, or \c "keep" with different source
    and target encodings

    @since %Qore 3.0 the \a encoding_errors parameter
 */
EncodingConversionInputStream::constructor(Qore::InputStream[InputStream] input_stream, string source_encoding,
        string target_encoding, *string encoding_errors) [flags=NAMED_ARGS] {
   qore_encoding_errors_t ee;
   if (q_get_encoding_errors(encoding_errors, ee, xsink)) {
      return;
   }
   const QoreEncoding* src = QEM.findCreate(source_encoding);
   const QoreEncoding* dst = QEM.findCreate(target_encoding);
   if (EncodingConvertor::checkEncodingErrors(src, dst, ee, "EncodingConversionInputStream", xsink)) {
      return;
   }
   SimpleRefHolder<EncodingConversionInputStream> ecis(new EncodingConversionInputStream(
         input_stream.release(), src, dst, xsink, ee));
   if (*xsink) {
      return;
   }
   self->setPrivate(CID_ENCODINGCONVERSIONINPUTSTREAM, ecis.release());
   qore_object_private* o = qore_object_private::get(*self);
   const qore_class_private* cls = qore_class_private::get(*QC_ENCODINGCONVERSIONINPUTSTREAM);
   o->setValueIntern(cls, "is", static_cast<QoreObject *>(obj_input_stream->refSelf()), xsink);
}

//! Reads bytes (up to a specified limit) from the input stream; returns \ref NOTHING if there are no more bytes in the stream
/**

    @param limit the maximum number of bytes to read
    @return the read bytes (the length is between 1 and <tt>limit</tt> inclusive) or \ref NOTHING if no more bytes are available

    @par Example:
    @code{.py}
    EncodingConversionInputStream latin2Stream(sourceUtf8Stream, "UTF-8", "ISO-8859-2");
    *binary b;
    while (b = latin2Stream.read(20)) {
        #b contains up to 20 bytes representing latin-2 characters
    }
    @endcode

    @throw INVALID-ENCODING the input is not valid in the source encoding (a byte sequence that is not a character
    of the encoding, or a character or shift sequence cut off by the end of the input) and the \a encoding_errors
    option of the constructor is \c "raise"; the message gives the byte offset of the sequence in the input stream
    @throw ENCODING-CONVERSION-ERROR the input has a character that the target encoding cannot hold; the message
    gives the byte offset of the first one in the input stream
    @throw INPUT-STREAM-ERROR \a limit is not positive
    @throw STREAM-THREAD-ERROR this exception is thrown if this method is called from any thread other than the thread that created the object
 */
*binary EncodingConversionInputStream::read(int limit) [flags=NAMED_ARGS] {
   return is->readHelper(limit, xsink);
}

//! Peeks the next byte available from the input stream; returns -1 if no more data available
/**
    @return the next byte available from the input stream or -1 if no more data is available

    @par Example:
    @code{.py}
    EncodingConversionInputStream latin2Stream(sourceUtf8Stream, "UTF-8", "ISO-8859-2");
    int nextByte = latin2Stream.peek();
    @endcode

    @throw INVALID-ENCODING the input is not valid in the source encoding (a byte sequence that is not a character
    of the encoding, or a character or shift sequence cut off by the end of the input) and the \a encoding_errors
    option of the constructor is \c "raise"; the message gives the byte offset of the sequence in the input stream
    @throw ENCODING-CONVERSION-ERROR the input has a character that the target encoding cannot hold; the message
    gives the byte offset of the first one in the input stream
    @throw STREAM-THREAD-ERROR this exception is thrown if this method is called from any thread other than the thread that created the object
 */
int EncodingConversionInputStream::peek() {
   return is->peekHelper(xsink);
}

//! Returns what input that is not valid in the source encoding gives
/** @par Example:
    @code{.py}
string encoding_errors = latin2Stream.getEncodingErrors();
    @endcode

    @return one of the @ref encoding_errors_constants: \c "raise", \c "latin1", or \c "keep"; see
    @ref encoding_errors

    @since %Qore 3.0
 */
string EncodingConversionInputStream::getEncodingErrors() [flags=CONSTANT] {
   return new QoreStringNode(q_encoding_errors_name(is->getEncodingErrors()));
}
