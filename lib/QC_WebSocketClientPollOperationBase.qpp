#include "qore/Qore.h"
#include "qore/intern/QC_WebSocketClientPollOperationBase.h"
#include "qore/intern/QC_SocketPollOperationBase.h"
#include "qore/intern/QC_SocketPollOperation.h"
#include "qore/intern/QC_Socket.h"
#include "qore/intern/qore_socket_private.h"

/** @cond INTERNAL */

// ============================================================
// WebSocketClientPollOperationPriv implementation
// ============================================================

WebSocketClientPollOperationPriv::WebSocketClientPollOperationPriv(QoreObject* self,
        QoreSocketObject* sock, Queue* recv_queue, QoreObject* recv_queue_obj,
        Queue* send_queue, QoreObject* send_queue_obj)
    : SocketPollOperationBase(self),
      sock(sock),
      recv_queue(recv_queue),
      recv_queue_obj(recv_queue_obj),
      send_queue(send_queue),
      send_queue_obj(send_queue_obj) {
    // All pointers are already ref'd by the QPP constructor
}

WebSocketClientPollOperationPriv::~WebSocketClientPollOperationPriv() {
    if (sock || recv_queue || send_queue || send_op || recv_op || error_info) {
        ExceptionSink xsink;
        cleanup(&xsink);
    }
}

bool WebSocketClientPollOperationPriv::goalReached() const {
    return ws_state == WsState::CLOSED || ws_state == WsState::ERROR;
}

QoreHashNode* WebSocketClientPollOperationPriv::continuePoll(ExceptionSink* xsink) {
    printd(5, "WsClientPollOp::continuePoll() state: %s send_op=%p recv_op=%p\n",
        getWsState(), send_op, recv_op);
    // Reset per-cycle counter so controller knows if new frames arrived
    frames_pushed_in_cycle = 0;

    if (goalReached()) {
        return nullptr;
    }

    // Check if socket is still open — skip while echoing a close the server started, because the
    // peer's TCP FIN may arrive before the close echo is sent
    if (!sock->isOpen() && (ws_state != WsState::CLOSING || close_initiated)) {
        endClosed(1006, "Connection lost", xsink);
        return nullptr;
    }

    int poll_events = 0;

    // --- Phase 1: Drive active send operation ---
    if (send_op) {
        QoreHashNode* send_info = send_op->continuePoll(xsink);
        if (*xsink) {
            setError(xsink);
            return nullptr;
        }
        if (!send_info) {
            // Send complete or failed
            if (send_op->goalReached()) {
                releaseSendOp(xsink);
            } else {
                // Send failed without reaching goal
                releaseSendOp(xsink);
                if (!*xsink) {
                    xsink->raiseException("WEBSOCKET-SEND-ERROR",
                        "send operation failed without reaching goal");
                }
                setError(xsink);
                return nullptr;
            }
        } else {
            // Send needs more I/O
            send_info->deref(xsink);
            poll_events |= SOCK_POLLOUT;
        }
    }

    // --- Phase 2: Drive active recv operation ---
    if (recv_op) {
        QoreHashNode* recv_info = recv_op->continuePoll(xsink);
        if (*xsink) {
            releaseRecvOp(xsink);
            // Recv errors on EAGAIN/TIMEOUT are not fatal — clear and continue
            xsink->clear();
            if (waitsForPeerClose()) {
                // the server's close frame can no longer arrive
                endClosed(1006, "Connection lost", xsink);
                return nullptr;
            }
        } else if (!recv_info) {
            // Recv complete — process the data; update heartbeat activity
            last_recv_activity_ms = q_clock_getmillis();
            bool got_data = false;
            if (recv_op->goalReached()) {
                QoreValue output = recv_op->getOutput();
                if (output.getType() == NT_BINARY) {
                    const BinaryNode* bin = output.get<const BinaryNode>();
                    if (bin && bin->size() > 0) {
                        decoder.appendData(bin->getPtr(), bin->size());
                        got_data = true;
                    }
                    output.discard(xsink);
                } else if (output.getType() == NT_STRING) {
                    QoreStringValueHelper str(output);
                    if (str && str->size() > 0) {
                        decoder.appendData(str->c_str(), str->size());
                        got_data = true;
                    }
                    output.discard(xsink);
                } else {
                    output.discard(xsink);
                }
            }
            releaseRecvOp(xsink);

            // Empty recv = EOF (server closed connection)
            if (!got_data) {
                endClosed(1006, "Connection closed", xsink);
                return nullptr;
            }

            // Process any complete frames in the decoder buffer
            processDecodedFrames(xsink);
            if (*xsink) {
                setError(xsink);
                return nullptr;
            }
            if (goalReached()) {
                return nullptr;
            }
        } else {
            // Recv needs more I/O
            recv_info->deref(xsink);
            poll_events |= SOCK_POLLIN;
        }
    }

    // --- Phase 2b: Drain any data left in the socket's internal read buffer ---
    if (!recv_op && !goalReached()) {
        SimpleRefHolder<BinaryNode> pending(sock->drainPendingBuffer());
        if (pending && pending->size() > 0) {
            decoder.appendData(reinterpret_cast<const char*>(pending->getPtr()),
                pending->size());
            processDecodedFrames(xsink);
            if (*xsink) {
                setError(xsink);
                return nullptr;
            }
            if (goalReached()) {
                return nullptr;
            }
        }
    }

    // --- Phase 2b': Close deadline ---
    // A close started by the client ends when the server's close frame arrives; the deadline bounds the wait
    // for a server that does not answer
    if (waitsForPeerClose() && close_deadline_ms && q_clock_getmicros_monotonic() / 1000 >= close_deadline_ms) {
        endClosed(1006, "close handshake timed out", xsink);
        return nullptr;
    }

    // --- Phase 2c: Heartbeat ping ---
    // Send a PING frame when the connection has been idle for
    // heartbeat_interval_ms.  last_ping_sent_ms guards against spamming
    // PINGs when the peer is silent; last_recv_activity_ms reflects real
    // incoming traffic only (so idle-timeout detection below can rely on
    // it even when our own PINGs are in flight).
    if (heartbeat_interval_ms > 0 && ws_state == WsState::CONNECTED && last_recv_activity_ms > 0) {
        int64 now_ms = q_clock_getmillis();
        int64 since_recv = now_ms - last_recv_activity_ms;
        int64 since_ping = last_ping_sent_ms ? now_ms - last_ping_sent_ms : heartbeat_interval_ms;
        if (since_recv >= heartbeat_interval_ms && since_ping >= heartbeat_interval_ms) {
            queueSendPing(nullptr, xsink);
            if (*xsink) {
                return nullptr;
            }
            last_ping_sent_ms = q_clock_getmillis();
        }
    }

    // --- Phase 2d: Idle timeout ---
    // Close the connection if no real incoming traffic arrived within
    // idle_timeout_ms — catches peers that silently went away (no FIN,
    // no pong for our PINGs).
    if (idle_timeout_ms > 0 && ws_state == WsState::CONNECTED && !closed_on_idle
            && last_recv_activity_ms > 0) {
        int64 elapsed = q_clock_getmillis() - last_recv_activity_ms;
        if (elapsed >= idle_timeout_ms) {
            closed_on_idle = true;
            close_cause = "idle-timeout";
            queueSendClose(WSCC_GoingAway, "idle timeout", xsink);
            if (*xsink) {
                return nullptr;
            }
        }
    }

    // --- Phase 3: Start recv if no active recv ---
    // Skip while echoing a close the server started (FIN would cause SSL errors); a close the client started
    // reads on until the server's close frame arrives. No isDataAvailable() — the controller's
    // hasPendingData() check and epoll handle readiness.
    if (!recv_op && !goalReached() && (ws_state != WsState::CLOSING || close_initiated)) {
        if (startRecvOp(xsink)) {
            return nullptr;
        }
        poll_events |= SOCK_POLLIN;
    }

    // --- Phase 4: Check for queued frames to send ---
    if (!send_op && !goalReached()) {
        drainSendQueue(xsink);
        if (*xsink) {
            return nullptr;
        }
        if (pending_send && pending_send->size() > 0) {
            if (startSendOp(xsink)) {
                return nullptr;
            }
            poll_events |= SOCK_POLLOUT;
        }
    }

    // A close the server started is complete once the echo of its close frame has been sent; the server's
    // close frame was reported when it arrived.  A close the client started is complete when the server's close
    // frame arrives (see handleFrame()).
    if (ws_state == WsState::CLOSING && !close_initiated && !send_op && (!pending_send || pending_send->size() == 0)) {
        setWsStateValue(WsState::CLOSED);
    }

    // If we're in CLOSED/ERROR after processing, we're done
    if (goalReached()) {
        return nullptr;
    }

    // Poll for incoming data — skip while echoing a close the server started, to prevent a busy loop from its
    // FIN; a close the client started waits for the server's close frame
    if (ws_state != WsState::CLOSING || close_initiated) {
        poll_events |= SOCK_POLLIN;
    }

    QoreHashNode* poll_info = getSocketPollInfoHash(xsink, poll_events);

    // Set poll_timeout_ms so the controller wakes us for heartbeat and/or
    // idle-timeout, and at the close deadline, even if no socket events arrive.
    if (poll_info) {
        int64 poll_timeout = 0;
        if (ws_state == WsState::CONNECTED && last_recv_activity_ms > 0) {
            int64 now_ms = q_clock_getmillis();
            if (heartbeat_interval_ms > 0) {
                // Anchor PING pacing on whichever is later — real recv activity
                // or our last outgoing PING — so we don't busy-loop after a PING.
                int64 anchor_ms = last_recv_activity_ms;
                if (last_ping_sent_ms > anchor_ms) {
                    anchor_ms = last_ping_sent_ms;
                }
                int64 hb_remaining = heartbeat_interval_ms - (now_ms - anchor_ms);
                if (hb_remaining < 1) {
                    hb_remaining = 1;
                }
                poll_timeout = hb_remaining;
            }
            if (idle_timeout_ms > 0 && !closed_on_idle) {
                int64 idle_remaining = idle_timeout_ms - (now_ms - last_recv_activity_ms);
                if (idle_remaining < 1) {
                    idle_remaining = 1;
                }
                if (poll_timeout == 0 || idle_remaining < poll_timeout) {
                    poll_timeout = idle_remaining;
                }
            }
        }
        if (waitsForPeerClose() && close_deadline_ms) {
            int64 close_remaining = close_deadline_ms - q_clock_getmicros_monotonic() / 1000;
            if (close_remaining < 1) {
                close_remaining = 1;
            }
            if (poll_timeout == 0 || close_remaining < poll_timeout) {
                poll_timeout = close_remaining;
            }
        }
        if (poll_timeout > 0) {
            poll_info->setKeyValue("poll_timeout_ms", poll_timeout, xsink);
        }
    }

    return poll_info;
}

void WebSocketClientPollOperationPriv::abort(ExceptionSink* xsink) {
    setWsStateValue(WsState::CLOSED);
    close_code = 1006;  // Abnormal Closure
    close_reason = "aborted";
    releaseSendOp(xsink);
    releaseRecvOp(xsink);
    // Push "closed" notification to recv_queue (not "close" — "closed" means terminal)
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("type", new QoreStringNode("closed"), xsink);
    h->setKeyValue("code", static_cast<int64>(1006), xsink);
    h->setKeyValue("reason", new QoreStringNode("aborted"), xsink);
    recv_queue->push(xsink, h.release());
    ++frames_pushed_in_cycle;
}

QoreValue WebSocketClientPollOperationPriv::getOutput() const {
    ExceptionSink xsink;
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), &xsink);
    h->setKeyValue("state", new QoreStringNode(getWsState()), &xsink);
    h->setKeyValue("close_code", static_cast<int64>(close_code), &xsink);
    h->setKeyValue("close_reason", new QoreStringNode(close_reason), &xsink);
    if (error_info) {
        error_info->ref();
        h->setKeyValue("error_info", error_info, &xsink);
    }
    return h.release();
}

const char* WebSocketClientPollOperationPriv::getStateImpl() const {
    return getWsState();
}

void WebSocketClientPollOperationPriv::processDecodedFrames(ExceptionSink* xsink) {
    while (decoder.hasCompleteFrame()) {
        WsFrame frame = decoder.nextFrame(xsink);
        if (*xsink) {
            // Protocol error — transition to error state
            setWsStateValue(WsState::ERROR);
            if (frame.payload) {
                frame.payload->deref(xsink);
            }
            return;
        }

        // Check frame size limit
        if (frame.payload && frame.payload->size() > max_frame_size) {
            if (frame.payload) {
                frame.payload->deref(xsink);
            }
            // Send close with 1009 (Message Too Big) — client masked
            queueSendClose(WSCC_MessageTooBig, "Message too big", xsink);
            return;
        }

        handleFrame(frame, xsink);

        // Deref the frame payload — handleFrame copies what it needs
        if (frame.payload) {
            frame.payload->deref(xsink);
        }

        if (*xsink || goalReached()) {
            return;
        }
    }
}

void WebSocketClientPollOperationPriv::handleFrame(const WsFrame& frame, ExceptionSink* xsink) {
    // Control frames (PING, PONG, CLOSE) are never fragmented per RFC 6455
    if (frame.opcode >= WSOP_CLOSE) {
        switch (frame.opcode) {
            case WSOP_PING: {
                // Auto-pong: encode a PONG with the same payload and queue it
                // CLIENT masking: mask=true
                SimpleRefHolder<BinaryNode> pong(
                    WebSocketFrameEncoder::encodePong(
                        frame.payload ? frame.payload->getPtr() : nullptr,
                        frame.payload ? frame.payload->size() : 0,
                        true  // client->server: MUST mask
                    )
                );
                send_queue->push(xsink, pong.release());
                if (*xsink) {
                    return;
                }
                // Also push to recv_queue so the Qore handler sees the ping
                pushRecvFrame("ping", frame.payload ? frame.payload->refSelf() : nullptr,
                    frame.rsv, xsink);
                break;
            }

            case WSOP_PONG: {
                pushRecvFrame("pong", frame.payload ? frame.payload->refSelf() : nullptr,
                    frame.rsv, xsink);
                break;
            }

            case WSOP_CLOSE: {
                // Parse close code and reason from payload
                // a close frame without a status code has the close code 1005 (RFC 6455 section 7.1.5)
                uint16_t code = WSCC_NoStatusRcvd;
                std::string reason;
                if (frame.payload && frame.payload->size() >= 2) {
                    const uint8_t* data = static_cast<const uint8_t*>(frame.payload->getPtr());
                    code = (static_cast<uint16_t>(data[0]) << 8) | data[1];
                    if (frame.payload->size() > 2) {
                        reason.assign(reinterpret_cast<const char*>(data + 2),
                            frame.payload->size() - 2);
                    }
                }

                close_code = code;
                close_reason = reason;

                // Push close frame to recv_queue
                pushRecvCloseFrame(code, reason.c_str(), xsink);
                if (*xsink) {
                    return;
                }

                if (close_initiated) {
                    // We initiated close and received the server's close frame — the handshake is complete, and
                    // the close code and reason are the server's (RFC 6455 sections 7.1.5 and 7.1.6)
                    setWsStateValue(WsState::CLOSED);
                } else {
                    // Peer initiated close — echo the close frame with client masking
                    // Stay in CLOSING so the write phase flushes the echo before CLOSED
                    SimpleRefHolder<BinaryNode> close_frame(
                        WebSocketFrameEncoder::encodeClose(code,
                            reason.empty() ? nullptr : reason.c_str(),
                            true)  // client->server: MUST mask
                    );
                    send_queue->push(xsink, close_frame.release());
                    if (*xsink) {
                        return;
                    }
                    setWsStateValue(WsState::CLOSING);
                }
                break;
            }

            default:
                break;
        }
        return;
    }

    // Validate RSV bits — only when no extensions are active
    if (!has_extensions && frame.rsv != 0) {
        // RSV bits set but no extensions — protocol error
        queueSendClose(WSCC_ProtocolError, "RSV bits set without extensions", xsink);
        return;
    }

    // Data frames: use reassembler for fragmentation support
    bool complete = reassembler.processFrame(frame, xsink);
    if (*xsink) {
        setWsStateValue(WsState::ERROR);
        return;
    }

    if (complete) {
        if (reassembler.isFragmenting() || frame.opcode == WSOP_CONTINUATION) {
            // Reassembled fragmented message
            WsOpcode msg_opcode;
            uint8_t msg_rsv;
            SimpleRefHolder<BinaryNode> msg_payload(reassembler.getCompleteMessage(msg_opcode, msg_rsv));
            if (msg_payload) {
                if (msg_opcode == WSOP_TEXT) {
                    QoreStringNode* text = new QoreStringNode(
                        reinterpret_cast<const char*>(msg_payload->getPtr()),
                        msg_payload->size(), QCS_UTF8);
                    pushRecvFrame("text", text, msg_rsv, xsink);
                } else {
                    pushRecvFrame("binary", msg_payload.release(), msg_rsv, xsink);
                }
            }
        } else {
            // Non-fragmented frame
            if (frame.opcode == WSOP_TEXT) {
                QoreStringNode* text = nullptr;
                if (frame.payload && frame.payload->size() > 0) {
                    text = new QoreStringNode(
                        reinterpret_cast<const char*>(frame.payload->getPtr()),
                        frame.payload->size(), QCS_UTF8);
                } else {
                    text = new QoreStringNode(QCS_UTF8);
                }
                pushRecvFrame("text", text, frame.rsv, xsink);
            } else if (frame.opcode == WSOP_BINARY) {
                pushRecvFrame("binary",
                    frame.payload ? frame.payload->refSelf() : new BinaryNode(),
                    frame.rsv, xsink);
            }
        }
    }
    // If not complete, more fragments expected — nothing to push yet
}

void WebSocketClientPollOperationPriv::pushRecvFrame(const char* type, AbstractQoreNode* data,
        uint8_t rsv, ExceptionSink* xsink) {
    last_recv_activity_ms = q_clock_getmillis();
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("type", new QoreStringNode(type), xsink);
    if (data) {
        h->setKeyValue("data", data, xsink);
    }
    // Always include RSV bits for extension processing in the Qore wrapper
    h->setKeyValue("rsv1", (rsv & 0x04) ? true : false, xsink);
    h->setKeyValue("rsv2", (rsv & 0x02) ? true : false, xsink);
    h->setKeyValue("rsv3", (rsv & 0x01) ? true : false, xsink);
    recv_queue->push(xsink, h.release());
    ++frames_pushed_in_cycle;
}

void WebSocketClientPollOperationPriv::pushRecvCloseFrame(uint16_t code, const char* reason,
        ExceptionSink* xsink) {
    last_recv_activity_ms = q_clock_getmillis();
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("type", new QoreStringNode("close"), xsink);
    h->setKeyValue("code", static_cast<int64>(code), xsink);
    h->setKeyValue("reason", new QoreStringNode(reason ? reason : ""), xsink);
    recv_queue->push(xsink, h.release());
    ++frames_pushed_in_cycle;
}

void WebSocketClientPollOperationPriv::queueSendText(const QoreStringNode* text, ExceptionSink* xsink) {
    // Client->server: MUST mask
    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encode(WSOP_TEXT,
            text->c_str(), text->size(), true, true)  // mask=true
    );
    send_queue->push(xsink, frame.release());
}

void WebSocketClientPollOperationPriv::queueSendBinary(const BinaryNode* data, ExceptionSink* xsink) {
    // Client->server: MUST mask
    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encode(WSOP_BINARY,
            data->getPtr(), data->size(), true, true)  // mask=true
    );
    send_queue->push(xsink, frame.release());
}

void WebSocketClientPollOperationPriv::queueSendPing(const BinaryNode* data, ExceptionSink* xsink) {
    // Client->server: MUST mask
    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encode(WSOP_PING,
            data ? data->getPtr() : nullptr,
            data ? data->size() : 0,
            true, true)  // mask=true
    );
    send_queue->push(xsink, frame.release());
}

void WebSocketClientPollOperationPriv::queueSendRaw(BinaryNode* frame_data, ExceptionSink* xsink) {
    // Pre-encoded frame data — push directly (already masked by Qore wrapper)
    send_queue->push(xsink, frame_data);
}

void WebSocketClientPollOperationPriv::queueSendClose(uint16_t code, const char* reason,
        ExceptionSink* xsink) {
    // an endpoint sends one close frame: a close in progress (started by either side) or a closed connection
    // makes the request moot
    if (ws_state != WsState::CONNECTED) {
        return;
    }
    close_initiated = true;
    close_code = code;
    if (reason) {
        close_reason = reason;
    }
    startCloseWait();

    // Client->server: MUST mask
    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encodeClose(code, reason, true)  // mask=true
    );
    send_queue->push(xsink, frame.release());
    if (!*xsink) {
        setWsStateValue(WsState::CLOSING);
    }
}

void WebSocketClientPollOperationPriv::requestClose(uint16_t code, const char* reason, ExceptionSink* xsink) {
    // the request goes through the send queue: the thread driving the operation takes it in order with the frames
    // queued before it and starts the close handshake there; see applyCloseRequest()
    ReferenceHolder<QoreHashNode> request(new QoreHashNode(autoTypeInfo), xsink);
    request->setKeyValue("close_code", static_cast<int64>(code), xsink);
    request->setKeyValue("close_reason", new QoreStringNode(reason ? reason : ""), xsink);
    if (*xsink) {
        return;
    }
    send_queue->push(xsink, request.release());
    if (!*xsink) {
        close_requested.store(true, std::memory_order_release);
    }
}

void WebSocketClientPollOperationPriv::applyCloseRequest(const QoreHashNode* request, ExceptionSink* xsink) {
    // a close already in progress (for example the echo of a close the peer started) or a closed connection
    // makes the request moot
    if (ws_state != WsState::CONNECTED) {
        return;
    }
    uint16_t code = static_cast<uint16_t>(request->getKeyValue("close_code").getAsBigInt());
    QoreStringValueHelper reason(request->getKeyValue("close_reason"));
    close_initiated = true;
    close_code = code;
    close_reason = reason->c_str();
    startCloseWait();

    // Client->server: MUST mask
    SimpleRefHolder<BinaryNode> frame(WebSocketFrameEncoder::encodeClose(code, close_reason.c_str(), true));
    if (!pending_send) {
        pending_send = new BinaryNode();
    }
    pending_send->append(frame->getPtr(), frame->size());
    close_frame_queued = true;
    setWsStateValue(WsState::CLOSING);
}

QoreValue WebSocketClientPollOperationPriv::getReceivedFrame(ExceptionSink* xsink) {
    if (recv_queue->empty()) {
        return QoreValue();
    }
    bool timed_out = false;
    QoreValue val = recv_queue->shift(xsink, -1, &timed_out);
    if (*xsink || timed_out) {
        if (*xsink) {
            xsink->clear();
        }
        return QoreValue();
    }
    return val;
}

QoreValue WebSocketClientPollOperationPriv::getReceivedFrameBlocking(int timeout_ms,
        ExceptionSink* xsink) {
    bool timed_out = false;
    QoreValue val = recv_queue->shift(xsink, timeout_ms, &timed_out);
    if (*xsink || timed_out) {
        if (*xsink) {
            xsink->clear();
        }
        return QoreValue();
    }
    return val;
}

void WebSocketClientPollOperationPriv::drainSendQueue(ExceptionSink* xsink) {
    // Drain all available frames from the send queue into pending_send; no data frame follows a close frame
    // (RFC 6455 section 5.5.1): a data frame queued by another thread after the close frame was queued is dropped
    while (!send_queue->empty()) {
        bool timed_out = false;
        QoreValue val = send_queue->shift(xsink, -1, &timed_out);
        if (*xsink) {
            return;
        }
        if (timed_out || val.isNothing()) {
            break;
        }
        if (val.getType() == NT_HASH) {
            // a close request from requestClose(): its close frame follows the frames queued before it
            applyCloseRequest(val.get<const QoreHashNode>(), xsink);
            val.discard(xsink);
            if (*xsink) {
                return;
            }
            continue;
        }
        if (val.getType() == NT_BINARY) {
            const BinaryNode* bin = val.get<const BinaryNode>();
            if (bin && bin->size() > 0) {
                // each entry is one encoded frame; the opcode is in the low bits of its first byte
                uint8_t opcode = static_cast<const uint8_t*>(bin->getPtr())[0] & 0x0f;
                if (opcode == WSOP_CLOSE) {
                    close_frame_queued = true;
                } else if (close_frame_queued && opcode < WSOP_CLOSE) {
                    val.discard(xsink);
                    continue;
                }
                if (!pending_send) {
                    pending_send = new BinaryNode();
                }
                pending_send->append(bin->getPtr(), bin->size());
            }
        }
        val.discard(xsink);
    }
}

int WebSocketClientPollOperationPriv::checkDataSend(ExceptionSink* xsink) const {
    if (close_requested.load(std::memory_order_acquire) || closing.load(std::memory_order_acquire)) {
        xsink->raiseException("WEBSOCKET-CLOSING-ERROR", "cannot send a data frame on a WebSocket connection whose "
            "close handshake has started; no data frame may follow a close frame (RFC 6455 section 5.5.1)");
        return -1;
    }
    return 0;
}

int WebSocketClientPollOperationPriv::startRecvOp(ExceptionSink* xsink) {
    assert(!recv_op);
    sock->ref();
    recv_op = new SocketRecvDataPollOperation(xsink, sock, false);
    if (*xsink) {
        recv_op->deref(xsink);
        recv_op = nullptr;
        setError(xsink);
        return -1;
    }
    // Set our QoreObject as the inner op's self for poll info resolution
    assert(self);
    recv_op->setSelf(*self);
    return 0;
}

int WebSocketClientPollOperationPriv::startSendOp(ExceptionSink* xsink) {
    assert(!send_op);
    assert(pending_send);
    assert(pending_send->size() > 0);

    // Transfer ownership of pending_send to the send operation
    BinaryNode* data = pending_send.release();
    sock->ref();
    send_op = new SocketSendPollOperation(xsink, data, sock);
    if (*xsink) {
        send_op->deref(xsink);
        send_op = nullptr;
        setError(xsink);
        return -1;
    }
    // Set our QoreObject as the inner op's self for poll info resolution
    assert(self);
    send_op->setSelf(*self);
    return 0;
}

void WebSocketClientPollOperationPriv::releaseSendOp(ExceptionSink* xsink) {
    if (send_op) {
        send_op->deref(xsink);
        send_op = nullptr;
    }
}

void WebSocketClientPollOperationPriv::releaseRecvOp(ExceptionSink* xsink) {
    if (recv_op) {
        recv_op->deref(xsink);
        recv_op = nullptr;
    }
}

void WebSocketClientPollOperationPriv::setError(ExceptionSink* xsink) {
    setWsStateValue(WsState::ERROR);
    if (!error_info) {
        error_info = new QoreHashNode(autoTypeInfo);
        ExceptionSink save_xsink;
        const QoreValue err_val = xsink->getExceptionErr();
        if (err_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper err(err_val);
            error_info->setKeyValue("err",
                err.getReferencedValue(), &save_xsink);
        }
        const QoreValue desc_val = xsink->getExceptionDesc();
        if (desc_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper desc(desc_val);
            error_info->setKeyValue("desc",
                desc.getReferencedValue(), &save_xsink);
        }
        // Push error notification to recv_queue
        ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), &save_xsink);
        h->setKeyValue("type", new QoreStringNode("error"), &save_xsink);
        error_info->ref();
        h->setKeyValue("error", error_info, &save_xsink);
        recv_queue->push(&save_xsink, h.release());
        ++frames_pushed_in_cycle;
    }
}

void WebSocketClientPollOperationPriv::setClosed(uint16_t code, const char* reason) {
    setWsStateValue(WsState::CLOSED);
    close_code = code;
    if (reason) {
        close_reason = reason;
    }
}

void WebSocketClientPollOperationPriv::endClosed(uint16_t code, const char* reason, ExceptionSink* xsink) {
    setClosed(code, reason);
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("type", new QoreStringNode("closed"), xsink);
    h->setKeyValue("code", static_cast<int64>(code), xsink);
    h->setKeyValue("reason", new QoreStringNode(reason), xsink);
    recv_queue->push(xsink, h.release());
    ++frames_pushed_in_cycle;
}

void WebSocketClientPollOperationPriv::cleanup(ExceptionSink* xsink) {
    releaseSendOp(xsink);
    releaseRecvOp(xsink);
    reassembler.clear(xsink);
    decoder.clear();

    if (recv_queue) {
        recv_queue->deref(xsink);
        recv_queue = nullptr;
    }
    if (recv_queue_obj) {
        recv_queue_obj->deref(xsink);
        recv_queue_obj = nullptr;
    }
    if (send_queue) {
        send_queue->deref(xsink);
        send_queue = nullptr;
    }
    if (send_queue_obj) {
        send_queue_obj->deref(xsink);
        send_queue_obj = nullptr;
    }
    if (error_info) {
        error_info->deref(xsink);
        error_info = nullptr;
    }
    if (sock) {
        sock->deref(xsink);
        sock = nullptr;
    }
}

/** @endcond */

//! C++ base class for WebSocket client-side poll operation
/** This class implements the core WebSocket client frame I/O state machine in
    pure C++, enabling the AsyncIoController I/O thread to drive the poll
    without Qore interpreter overhead.

    Key differences from the server-side @ref HttpWebSocketPollOperationBase "HttpWebSocketPollOperationBase" :
    - ALL outgoing frames use client masking per RFC 6455 Section 5.3
    - RSV bits are included in recv_queue frame hashes for extension processing
    - @ref setHasExtensions() controls RSV bit validation

    The C++ base handles the HTTP/1.1 hot path:
    - Frame decoding via WebSocketFrameDecoder and fragment reassembly
    - Frame encoding with client masking via WebSocketFrameEncoder
    - Automatic PONG responses to PING frames (with client masking)
    - Close handshake per RFC 6455 (with client masking)
    - Non-blocking send/recv via inner SocketSendPollOperation and
      SocketRecvDataPollOperation

    State machine: CONNECTED -> CLOSING -> CLOSED / ERROR

    Communication between the Qore handler and the I/O thread uses two
    thread-safe Queues:
    - recv_queue: decoded frames pushed by C++ (I/O thread), read by handler
    - send_queue: pre-encoded frame bytes pushed by handler, sent by C++ (I/O thread)

    The Qore wrapper (WebSocketClientPollOperation) adds:
    - Extension transforms (incoming/outgoing) via AbstractWebSocketExtension
    - H2/H3 transport support (bypasses C++ continuePoll for non-H1 transports)
    - Raw frame callback
    - on_poll_complete callback via worker dispatch

    @since %Qore 3.0
*/
qclass WebSocketClientPollOperationBase [
    private_members=object sock,string goal,object recv_queue,object send_queue;
    ns=Qore;
    arg=WebSocketClientPollOperationPriv* priv;
    vparent=SocketPollOperationBase<hash<auto>>
];

//! Creates the WebSocket client poll operation base
/** @param socket the WebSocket Socket (after upgrade handshake complete)

    Creates internal recv and send Queues for communication between the I/O
    thread and handler threads.

    The socket must be the underlying socket from the HTTPClient, already
    upgraded to WebSocket (HTTP/1.1 transport).
*/
WebSocketClientPollOperationBase::constructor(Socket[QoreSocketObject] socket) [flags=NAMED_ARGS] {
    QoreSocketObject* sock_ptr = *socket;

    // Store socket as Qore member for DGC visibility
    QoreValue sock_arg = args->retrieveEntry(0);
    QoreObject* sock_qobj = sock_arg.getType() == NT_OBJECT
        ? const_cast<QoreObject*>(sock_arg.get<const QoreObject>()) : nullptr;
    if (sock_qobj) {
        self->setMemberValue("sock", QC_WEBSOCKETCLIENTPOLLOPERATIONBASE, sock_qobj->refSelf(), xsink);
    }
    self->setMemberValue("goal", QC_WEBSOCKETCLIENTPOLLOPERATIONBASE,
        new QoreStringNode("ws-client-io"), xsink);

    // Create recv and send queues (unlimited)
    Queue* recv_q = new Queue(-1);
    QoreObject* recv_q_obj = new QoreObject(QC_QUEUE, getProgram(), recv_q);
    recv_q->ref();  // Extra ref for the C++ priv

    Queue* send_q = new Queue(-1);
    QoreObject* send_q_obj = new QoreObject(QC_QUEUE, getProgram(), send_q);
    send_q->ref();  // Extra ref for the C++ priv

    // Store queue objects as members for DGC visibility
    self->setMemberValue("recv_queue", QC_WEBSOCKETCLIENTPOLLOPERATIONBASE, recv_q_obj->refSelf(), xsink);
    self->setMemberValue("send_queue", QC_WEBSOCKETCLIENTPOLLOPERATIONBASE, send_q_obj->refSelf(), xsink);

    sock_ptr->ref();

    self->setPrivate(CID_WEBSOCKETCLIENTPOLLOPERATIONBASE,
        new WebSocketClientPollOperationPriv(self, sock_ptr,
            recv_q, recv_q_obj, send_q, send_q_obj));
}

//! Destroys the object
/** Releases all internal references.
*/
WebSocketClientPollOperationBase::destructor() {
    priv->cleanup(xsink);
    priv->deref(xsink);
}

//! Throws an exception; objects of this class cannot be copied
/** @throw WEBSOCKETCLIENTPOLLOPERATIONBASE-COPY-ERROR objects of this class cannot be copied
*/
WebSocketClientPollOperationBase::copy() {
    xsink->raiseException("WEBSOCKETCLIENTPOLLOPERATIONBASE-COPY-ERROR",
        "objects of this class cannot be copied");
}

//! Returns the goal of the operation
/** @return "ws-client-io"
*/
string WebSocketClientPollOperationBase::getGoal() {
    return self->getReferencedMemberNoMethod("goal", xsink);
}

//! Returns the current state
/** @return one of "connected", "closing", "closed", or "error"
*/
string WebSocketClientPollOperationBase::getState() [flags=RET_VALUE_ONLY] {
    return priv->getState();
}

//! Returns True when the connection is closed or in error
/** @return True when the state is CLOSED or ERROR
*/
bool WebSocketClientPollOperationBase::goalReached() [flags=RET_VALUE_ONLY] {
    return priv->goalReached();
}

//! Continues the poll operation
/** Drives the WebSocket client I/O state machine: receives frames, processes
    control frames (with client masking on pong/close), sends queued frames.

    @return socket poll info for the next poll cycle, or @ref nothing if polling is complete
*/
*hash<SocketPollInfo> WebSocketClientPollOperationBase::continuePoll() {
    return priv->continuePoll(xsink);
}

//! Aborts the operation
/** Transitions to CLOSED state and releases all inner operations.
*/
nothing WebSocketClientPollOperationBase::abort() {
    priv->abort(xsink);
}

//! Returns the output of the operation
/** @return hash with state, close_code, close_reason, error_info
*/
hash<auto> WebSocketClientPollOperationBase::getOutput() [flags=RET_VALUE_ONLY] {
    return priv->getOutput();
}

//! Sends a text message with client masking
/** The text is encoded as a masked WebSocket TEXT frame and queued for sending.
    Thread-safe: can be called from any thread.

    @param text the UTF-8 text to send

    @note Does NOT apply extension transforms. Use @ref sendRawFrame() for
    pre-encoded frames with extension transforms already applied.
    @throw WEBSOCKET-CLOSING-ERROR the close handshake has started (with @ref sendClose(), or a close frame from the
    server) or the connection has closed: no data frame may follow a close frame (RFC 6455 section 5.5.1)
*/
nothing WebSocketClientPollOperationBase::sendText(string text) [flags=NAMED_ARGS] {
    if (priv->checkDataSend(xsink)) {
        return QoreValue();
    }
    priv->queueSendText(text, xsink);
}

//! Sends a binary message with client masking
/** The data is encoded as a masked WebSocket BINARY frame and queued for sending.
    Thread-safe: can be called from any thread.

    @param data the binary data to send

    @note Does NOT apply extension transforms. Use @ref sendRawFrame() for
    pre-encoded frames with extension transforms already applied.
    @throw WEBSOCKET-CLOSING-ERROR the close handshake has started (with @ref sendClose(), or a close frame from the
    server) or the connection has closed: no data frame may follow a close frame (RFC 6455 section 5.5.1)
*/
nothing WebSocketClientPollOperationBase::sendBinary(binary data) [flags=NAMED_ARGS] {
    if (priv->checkDataSend(xsink)) {
        return QoreValue();
    }
    priv->queueSendBinary(data, xsink);
}

//! Sends a ping frame with client masking
/** The ping is encoded as a masked WebSocket PING frame and queued for sending.
    Thread-safe: can be called from any thread.

    @param payload optional ping payload (string or binary)
*/
nothing WebSocketClientPollOperationBase::sendPing(*data payload) [flags=NAMED_ARGS] {
    // Convert data to binary for the C++ encoder
    const void* payload_ptr = nullptr;
    size_t payload_len = 0;

    if (payload) {
        qore_type_t t = payload->getType();
        if (t == NT_BINARY) {
            const BinaryNode* bin = reinterpret_cast<const BinaryNode*>(payload);
            if (bin->size() > 0) {
                payload_ptr = bin->getPtr();
                payload_len = bin->size();
            }
        } else if (t == NT_STRING) {
            const QoreStringNode* str = reinterpret_cast<const QoreStringNode*>(payload);
            if (str->size() > 0) {
                payload_ptr = str->c_str();
                payload_len = str->size();
            }
        }
    }

    // Client->server: MUST mask
    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encode(WSOP_PING, payload_ptr, payload_len, true, true)
    );
    priv->queueSendRaw(frame.release(), xsink);
}

//! Sends a pong frame with client masking
/** The pong is encoded as a masked WebSocket PONG frame and queued for sending.
    Thread-safe: can be called from any thread.

    @param payload optional pong payload (should echo the ping payload)
*/
nothing WebSocketClientPollOperationBase::sendPong(*data payload) [flags=NAMED_ARGS] {
    // Client->server: MUST mask — encode as pong and push
    const void* payload_ptr = nullptr;
    size_t payload_len = 0;

    if (payload) {
        qore_type_t t = payload->getType();
        if (t == NT_BINARY) {
            const BinaryNode* bin = reinterpret_cast<const BinaryNode*>(payload);
            if (bin->size() > 0) {
                payload_ptr = bin->getPtr();
                payload_len = bin->size();
            }
        } else if (t == NT_STRING) {
            const QoreStringNode* str = reinterpret_cast<const QoreStringNode*>(payload);
            if (str->size() > 0) {
                payload_ptr = str->c_str();
                payload_len = str->size();
            }
        }
    }

    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encodePong(payload_ptr, payload_len, true)
    );
    priv->queueSendRaw(frame.release(), xsink);
}

//! Sends a pre-encoded frame (already masked and extension-transformed)
/** Used by the Qore wrapper for frames that have already been transformed
    by extensions and encoded with client masking.
    Thread-safe: can be called from any thread.

    @param frame_data the pre-encoded frame bytes

    @throw WEBSOCKET-CLOSING-ERROR \a frame_data is a data frame, and the close handshake has started (with
    @ref sendClose(), or a close frame from the server) or the connection has closed: no data frame may follow a
    close frame (RFC 6455 section 5.5.1)
*/
nothing WebSocketClientPollOperationBase::sendRawFrame(binary frame_data) [flags=NAMED_ARGS] {
    // a data frame (opcode below that of a close frame) is refused once the close handshake has started
    if (frame_data->size() && (static_cast<const uint8_t*>(frame_data->getPtr())[0] & 0x0f) < WSOP_CLOSE
            && priv->checkDataSend(xsink)) {
        return QoreValue();
    }
    priv->queueSendRaw(frame_data->binRefSelf(), xsink);
}

//! Initiates the close handshake with client masking
/** Sends a masked WebSocket CLOSE frame with the given code and reason.
    Thread-safe: can be called from any thread.

    The close is queued with the frames to send: the operation's next step sends the frames queued before it, then
    the CLOSE frame.  @ref getState() reports \c "closing" from the call on; a call made when the connection is
    already closing or closed has no effect.

    The close handshake completes when the server's CLOSE frame arrives, as RFC 6455 section 5.5.1 requires; the
    operation goes on reading until then.  The operation then ends with the state \c "closed", and
    @ref getCloseCode() and @ref getCloseReason() return the code and reason of the server's CLOSE frame (RFC 6455
    sections 7.1.5 and 7.1.6), which need not be the ones sent here; a client that needs its own code and reason
    after the close keeps them itself.  The operation also ends \c "closed", with code 1006, when:
    - the server's CLOSE frame does not arrive within the close timeout (see @ref setCloseTimeout()); the reason
      is \c "close handshake timed out"
    - the connection is lost first; the reason is \c "Connection closed" or \c "Connection lost"

    In both cases, a \c "closed" frame with the code and reason is put in the receive queue.

    @par Example:
    @code{.py}
poll_op.sendClose(WSCC_GoingAway, "shutting down");
# ... the operation is driven until goalReached() ...
if (poll_op.getCloseCode() == 1006) {
    printf("the server did not answer the close: %s\n", poll_op.getCloseReason());
} else {
    printf("the server closed with %d: %y\n", poll_op.getCloseCode(), poll_op.getCloseReason());
}
    @endcode

    @param code the close code (default 1000 = normal closure); 1005 and 1006 are never sent in a CLOSE frame (RFC
    6455 section 7.4.1): with one of them, the frame has no status code and no reason
    @param reason the close reason string (default empty)
*/
nothing WebSocketClientPollOperationBase::sendClose(int code = 1000, string reason = "") [flags=NAMED_ARGS] {
    priv->requestClose(static_cast<uint16_t>(code), reason->c_str(), xsink);
}

//! Gets the next received frame (non-blocking)
/** Returns the next frame from the recv queue, or @ref nothing if none available.
    Thread-safe: can be called from any thread.

    The frame hash has the following keys:
    - \c type: "text", "binary", "ping", "pong", or "close"
    - \c data: string for text frames, binary for binary/ping/pong frames
    - \c rsv1: bool RSV1 bit (for extension processing)
    - \c rsv2: bool RSV2 bit (for extension processing)
    - \c rsv3: bool RSV3 bit (for extension processing)
    - \c code: int close code (only for close frames)
    - \c reason: string close reason (only for close frames)

    @return frame info hash or @ref nothing
*/
*hash<auto> WebSocketClientPollOperationBase::getReceivedFrame() {
    return priv->getReceivedFrame(xsink);
}

//! Gets the next received frame with blocking wait
/** Blocks until a frame is available or the timeout expires.
    Thread-safe: can be called from any thread.

    @param timeout_ms timeout in milliseconds (0 = wait forever)
    @return frame info hash or @ref nothing if timed out
*/
*hash<auto> WebSocketClientPollOperationBase::getReceivedFrameBlocking(
        timeout timeout_ms) [flags=NAMED_ARGS] {
    return priv->getReceivedFrameBlocking(static_cast<int>(timeout_ms), xsink);
}

//! Returns True if there are received frames waiting
/** Thread-safe: can be called from any thread.

    @return True if the recv queue has frames available
*/
bool WebSocketClientPollOperationBase::hasReceivedFrames() [flags=RET_VALUE_ONLY] {
    return priv->hasReceivedFrames();
}

//! Returns the number of frames in the recv queue
/** Thread-safe: can be called from any thread.

    @return the number of frames in the recv queue
*/
int WebSocketClientPollOperationBase::getRecvQueueSize() [flags=RET_VALUE_ONLY] {
    return priv->getRecvQueueSize();
}

//! Returns True if the connection is closed
/** @return True if the state is CLOSED or ERROR
*/
bool WebSocketClientPollOperationBase::isClosed() [flags=RET_VALUE_ONLY] {
    return priv->isClosed();
}

//! Returns True if an error occurred
/** @return True if error information is available
*/
bool WebSocketClientPollOperationBase::hasError() [flags=RET_VALUE_ONLY] {
    return priv->hasError();
}

//! Returns error information if an error occurred
/** @return hash with "err" and "desc" keys, or @ref nothing
*/
*hash<auto> WebSocketClientPollOperationBase::getError() [flags=RET_VALUE_ONLY] {
    return priv->getErrorInfo();
}

//! Returns the WebSocket close code
/** Once a CLOSE frame has been received, this is the code of that frame (RFC 6455 section 7.1.5), also when the
    close was started with @ref sendClose(), or 1005 if the frame has no status code; it is 1006 when the connection
    ended without a CLOSE frame from the server.  Before that, it is the code of the close started by @ref sendClose(), if any.

    @return the close code (default 1000)
*/
int WebSocketClientPollOperationBase::getCloseCode() [flags=RET_VALUE_ONLY] {
    return priv->getCloseCode();
}

//! Returns the WebSocket close reason
/** Once a CLOSE frame has been received, this is the reason of that frame (RFC 6455 section 7.1.6), also when
    the close was started with @ref sendClose(); it describes the end when the connection ended without a CLOSE
    frame from the server (see @ref sendClose()).  Before that, it is the reason of the close started by
    @ref sendClose(), if any.

    @return the close reason string
*/
string WebSocketClientPollOperationBase::getCloseReason() [flags=RET_VALUE_ONLY] {
    return new QoreStringNode(priv->getCloseReason());
}

//! Sets whether extensions are active
/** When extensions are active, RSV bit validation is skipped in C++
    (the Qore wrapper handles extension-specific RSV validation).

    @param enabled True if extensions are active
*/
nothing WebSocketClientPollOperationBase::setHasExtensions(bool enabled = True) [flags=NAMED_ARGS] {
    priv->setHasExtensions(enabled);
}

//! Called by the I/O controller when frames have been pushed during continuePoll
/** Override in subclasses to process received frames on a worker thread.
    The default implementation does nothing.

    @since %Qore 3.0
*/
nothing WebSocketClientPollOperationBase::onPollComplete() {
    // Default: no-op; subclasses override to drain recv_queue
}

//! Returns the socket being monitored
/** @return the Socket object
*/
Socket WebSocketClientPollOperationBase::getSocket() {
    return self->getReferencedMemberNoMethod("sock", xsink);
}

//! Sets the heartbeat ping interval in milliseconds
/** When set to a positive value, a PING frame is sent automatically
    when no data has been received for this many milliseconds.  The I/O
    controller wakes at the deadline via @c poll_timeout_ms even if no
    socket events arrive.

    Set to 0 to disable heartbeat (the default).

    @param heartbeat_interval_ms the heartbeat interval in milliseconds (0 = disabled)

    @since %Qore 3.0
*/
nothing WebSocketClientPollOperationBase::setHeartbeat(int heartbeat_interval_ms) [flags=NAMED_ARGS] {
    priv->setHeartbeat(static_cast<int64>(heartbeat_interval_ms));
}

//! Sets the idle timeout in milliseconds (0 = disabled)
/** When set to a positive value, the client closes the connection with
    code @c WSCC_GoingAway and reason @c "idle timeout" if no data
    has been received for this many milliseconds.  Combine with
    @ref setHeartbeat() to detect peers that silently went away: the
    heartbeat sends PINGs and this timer catches the absence of any
    response (PONG or otherwise).

    Set to 0 to disable idle-timeout detection (the default).

    @param idle_timeout_ms the idle timeout in milliseconds (0 = disabled)

    @since %Qore 3.0
*/
nothing WebSocketClientPollOperationBase::setIdleTimeout(int idle_timeout_ms) [flags=NAMED_ARGS] {
    priv->setIdleTimeout(static_cast<int64>(idle_timeout_ms));
}

//! Sets how long a close started by the client waits for the server's CLOSE frame
/** When the server's CLOSE frame does not arrive within this time after the close was started (with
    @ref sendClose(), or by the client itself, for example on an idle timeout), the operation ends with the state
    \c "closed", the close code 1006 and the reason \c "close handshake timed out", and a \c "closed" frame with
    them is put in the receive queue.  The time applies to a close started after the call.

    @param close_timeout_ms the time to wait in milliseconds; 0 or a negative value waits until the server's CLOSE
    frame arrives or the connection is lost; the default is 15 seconds

    @par Example:
    @code{.py}
poll_op.setCloseTimeout(5s);
    @endcode

    @since %Qore 3.0
*/
nothing WebSocketClientPollOperationBase::setCloseTimeout(timeout close_timeout_ms) [flags=NAMED_ARGS] {
    priv->setCloseTimeout(close_timeout_ms);
}

//! Returns the client-initiated close cause tag, if any
/** Populated when the client closed the connection itself (e.g. on idle
    timeout).  Empty string means the close came from the peer or has not
    yet happened.  Distinct from @ref getCloseReason() which returns the
    WebSocket protocol-level close reason string.

    @return the close cause tag (e.g. @c "idle-timeout") or empty string

    @since %Qore 3.0
*/
string WebSocketClientPollOperationBase::getCloseCause() [flags=RET_VALUE_ONLY] {
    return new QoreStringNode(priv->getCloseCause());
}
