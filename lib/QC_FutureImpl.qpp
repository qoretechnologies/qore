#include <qore/Qore.h>
#include <qore/QoreSandboxManager.h>
#include "qore/intern/QC_Future.h"
#include "qore/intern/QC_FutureImpl.h"

//! Concrete Future implementation backed by a QoreFuture (Promise/Future pair)
/** This is the standard Future implementation created by
    @ref Qore::Thread::Promise::getFuture() "Promise::getFuture()" and
    @ref call_async().  It is not intended to be created directly by user code.

    @since %Qore 2.3
 */
qclass FutureImpl [dom=THREAD_CLASS; arg=QoreFuture* f; ns=Qore::Thread; vparent=Future];

//! Throws an exception; FutureImpl objects can only be created internally
/** @throw FUTURE-ERROR FutureImpl objects cannot be created directly
 */
FutureImpl::constructor() {
    xsink->raiseException("FUTURE-ERROR",
        "FutureImpl objects can only be created by calling Promise::getFuture()");
}

//! Destroys the FutureImpl object
/** @throw FUTURE-ERROR Object deleted while other threads blocked on it
 */
FutureImpl::destructor() {
    f->destructor(xsink);
    f->deref(xsink);
}

//! Throws an exception; FutureImpl objects cannot be copied
/** @throw FUTURE-COPY-ERROR Objects of this class cannot be copied
 */
FutureImpl::copy() {
    xsink->raiseException("FUTURE-COPY-ERROR", "objects of this class cannot be copied");
}

//! Blocks the calling thread until the result is available or an error occurs
/** @param timeout_ms timeout; 0 means wait indefinitely
    @return the value set by the associated Promise
 */
auto FutureImpl::get(timeout timeout_ms = 0) {
    return f->get(timeout_ms, xsink);
}

//! Returns True if the Future has been resolved or rejected
/** @return True if the result is available or an error has been set
 */
bool FutureImpl::isDone() [flags=CONSTANT] {
    return f->isDone();
}

//! Returns True if the Future has been rejected with an error
/** @return True if an error has been set
 */
bool FutureImpl::isError() [flags=CONSTANT] {
    return f->isError();
}

//! Cancels the Future if still pending
/** If the Future is still \c PENDING, transitions to \c REJECTED with
    \c "FUTURE-CANCELLED" and wakes all waiting threads.

    @return True if cancelled, False if already resolved or rejected

    @since %Qore 2.4
 */
bool FutureImpl::cancel() {
    return f->cancel();
}
