#include "qore/Qore.h"
#include <qore/HttpClientConnectionManager.h>

/** @cond INTERNAL */

//! C++ base for HTTP client connection managers
/** Type-hierarchy marker enabling the Qore
    @c HttpClientIo::HttpClientConnectionManager to inherit from the C++
    manager base.  The Qore subclass overrides pool management methods at
    the Qore level (keeping its own pool, protocol cache, retry, Alt-Svc,
    cookies); the C++ base's pool is used by standalone C++ callers
    (Phase P10+).

    @since %Qore 2.3
*/
qclass HttpClientConnectionManagerBase [
    ns=Qore;
    arg=HttpClientConnectionManagerBase* priv;
];

//! Default constructor
/** Creates the C++ priv with default options.
*/
HttpClientConnectionManagerBase::constructor() {
    HttpClientConnectionManagerBase::Options opts;
    self->setPrivate(CID_HTTPCLIENTCONNECTIONMANAGERBASE, new HttpClientConnectionManagerBase(opts, xsink));
}

//! Copying is not supported
/** @throw HTTPCLIENTCONNECTIONMANAGERBASE-COPY-ERROR always
*/
HttpClientConnectionManagerBase::copy() {
    xsink->raiseException("HTTPCLIENTCONNECTIONMANAGERBASE-COPY-ERROR",
        "HttpClientConnectionManagerBase objects cannot be copied");
}
