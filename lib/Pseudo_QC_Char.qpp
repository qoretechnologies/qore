#include <qore/Qore.h>

//! Methods in this pseudo-class can be executed on @ref char "char values"
/**
    @par Example:
    @code{.py}
char c = c"\u{E9}";
printf("%d %s\n", c.ord(), c.toString());  # 233 é
    @endcode

    @since %Qore 3.0
 */
qclass <char> [arg=unsigned c = v.getChar();vparent=<value>];

//! Returns Qore::NT_CHAR
/**
    @return Qore::NT_CHAR

    @par Example:
    @code{.py}
assertEq(NT_CHAR, c'A'.typeCode());
    @endcode
 */
int <char>::typeCode() [const;flags=CONSTANT] {
    return NT_CHAR;
}

//! Returns the Unicode codepoint as an integer
/**
    @return the Unicode codepoint stored by the char

    @par Example:
    @code{.py}
assertEq(65, c'A'.ord());
    @endcode
 */
int <char>::ord() [const;flags=CONSTANT] {
    return c;
}

//! Returns the Unicode codepoint as an integer
/**
    This pseudo-method is provided for backwards compatibility with code that
    called &lt;string&gt;[&lt;n&gt;].getUnicode() before single string indexes returned
    @ref char values by default.

    @return the Unicode codepoint stored by the char

    @par Example:
    @code{.py}
assertEq(233, "é"[0].getUnicode());
    @endcode
 */
int <char>::getUnicode() [const;flags=CONSTANT] {
    return c;
}

//! Returns True
/**
    char values are always truthy, including U+0000.

    @return True

    @par Example:
    @code{.py}
assertTrue(c'\u{0}'.val());
    @endcode
 */
bool <char>::val() [const;flags=CONSTANT] {
    return true;
}

//! Returns True because char values can be explicitly converted to integers
/**
    @return True

    @par Example:
    @code{.py}
assertTrue(c'A'.intp());
    @endcode
 */
bool <char>::intp() [const;flags=CONSTANT] {
    return true;
}

//! Returns True because char values can be converted to strings
/**
    @return True

    @par Example:
    @code{.py}
assertTrue(c'A'.strp());
    @endcode
 */
bool <char>::strp() [const;flags=CONSTANT] {
    return true;
}

//! Returns True
/**
    @return True

    @par Example:
    @code{.py}
assertTrue(c'A'.charp());
    @endcode
 */
bool <char>::charp() [const;flags=CONSTANT] {
    return true;
}

//! Returns the char as a single-codepoint UTF-8 string
/**
    @return the char materialized as a string

    @par Example:
    @code{.py}
assertEq("é", c"\u{E9}".toString());
    @endcode
 */
string <char>::toString() [const;flags=RET_VALUE_ONLY] {
    return QoreValue::makeCharString(c, QCS_UTF8, xsink);
}

//! Returns the number of UTF-8 bytes needed to encode the char
/**
    @return the UTF-8 byte length

    @par Example:
    @code{.py}
assertEq(2, c"\u{E9}".size());
    @endcode
 */
int <char>::size() [const;flags=CONSTANT] {
    SimpleRefHolder<QoreStringNode> str(QoreValue::makeCharString(c, QCS_UTF8, xsink));
    return *xsink ? 0 : str->size();
}

//! Returns 1
/**
    @return 1, because a char is exactly one Unicode codepoint

    @par Example:
    @code{.py}
assertEq(1, c"\u{1F600}".length());
    @endcode
 */
int <char>::length() [const;flags=CONSTANT] {
    return 1;
}

//! Returns the number of UTF-8 bytes needed to encode the char
/**
    @return the UTF-8 byte length

    @par Example:
    @code{.py}
assertEq(4, c"\u{1F600}".utf8ByteLen());
    @endcode
 */
int <char>::utf8ByteLen() [const;flags=CONSTANT] {
    SimpleRefHolder<QoreStringNode> str(QoreValue::makeCharString(c, QCS_UTF8, xsink));
    return *xsink ? 0 : str->size();
}

//! Returns the char in lower case
/** The Unicode <i>simple</i> (1-to-1) lower-case mapping is applied, so that the result is
    always a single char; chars with no lower-case mapping are returned unchanged.

    @return the lower-case mapping of the char

    @par Example:
    @code{.py}
assertEq(c'a', c'A'.lwr());
    @endcode

    @note @ref Qore::zzz8stringzzz9::lwr() "<string>::lwr()" applies the Unicode <i>full</i>
    case mapping instead, which is context-sensitive and can map a single character to more
    than one character; for example the lower-case mapping of <tt>U+0130</tt> as a char is
    <tt>U+0069</tt> (@c i), while as a string it is the two-character sequence
    <tt>U+0069 U+0307</tt>

    @see
    - @ref Qore::zzz8charzzz9::upr() "<char>::upr()"
    - @ref Qore::zzz8stringzzz9::lwr() "<string>::lwr()"
 */
char <char>::lwr() [const;flags=CONSTANT] {
    return QoreValue::makeChar(q_unicode_tolower(c));
}

//! Returns the char in upper case
/** The Unicode <i>simple</i> (1-to-1) upper-case mapping is applied, so that the result is
    always a single char; chars with no upper-case mapping are returned unchanged.

    @return the upper-case mapping of the char

    @par Example:
    @code{.py}
assertEq(c'A', c'a'.upr());
    @endcode

    @note @ref Qore::zzz8stringzzz9::upr() "<string>::upr()" applies the Unicode <i>full</i>
    case mapping instead, which can map a single character to more than one character; for
    example <tt>U+00DF</tt> (@c ß) has no simple upper-case mapping, so as a char it is
    returned unchanged, while as a string it maps to the two-character string @c "SS"

    @see
    - @ref Qore::zzz8charzzz9::lwr() "<char>::lwr()"
    - @ref Qore::zzz8stringzzz9::upr() "<string>::upr()"
 */
char <char>::upr() [const;flags=CONSTANT] {
    return QoreValue::makeChar(q_unicode_toupper(c));
}
