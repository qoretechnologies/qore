#include <qore/Qore.h>
#include "qore/intern/QoreEventNotifier.h"

//! Cross-thread event notification class
/** The EventNotifier class provides an efficient mechanism for cross-thread
    event notification, using the most efficient mechanism available on each
    platform:
    - eventfd on Linux (single fd, counter-based, very efficient)
    - pipe on other platforms (BSD, macOS, etc.)

    The notifier can be registered with an EventLoop for integration with
    event-driven I/O.

    @par Example:
    @code{.py}
EventNotifier notifier();
EventLoop loop();

# Register notifier with event loop
loop.add(notifier, SOCK_POLLIN);

# In another thread, to signal:
notifier.notify();

# After poll returns with event on notifier:
notifier.acknowledge();
    @endcode

    @note This class is not available with the @ref PO_NO_NETWORK parse option

    @since %Qore 2.1

    @see EventLoop
*/
qclass EventNotifier [dom=NETWORK; arg=QoreEventNotifier* en; ns=Qore; vparent=AbstractPollableIoObjectBase];

//! Creates a new EventNotifier object
/** @par Example:
    @code{.py} EventNotifier notifier(); @endcode

    @throw EVENT-NOTIFIER-ERROR Failed to create the event notifier
*/
EventNotifier::constructor() {
    ReferenceHolder<QoreEventNotifier> holder(new QoreEventNotifier(xsink), xsink);
    if (*xsink) {
        return;
    }
    if (!holder->isValid()) {
        xsink->raiseException("EVENT-NOTIFIER-ERROR", "Failed to create event notifier");
        return;
    }
    self->setPrivate(CID_EVENTNOTIFIER, holder.release());
}

//! Destroys the EventNotifier object
/** Deterministically closes the underlying file descriptor, even if C++ code
    (e.g., EventNotifierAction) still holds a reference to the private data.
    This prevents eventfd/pipe descriptor leaks when the Qore object is
    collected but the C++ private data outlives it due to non-DGC-visible
    references.
*/
EventNotifier::destructor() {
    en->closeFd();
    en->deref(xsink);
}

//! Creates a copy of the EventNotifier object
/** @note The copy creates a new, independent event notifier
*/
EventNotifier::copy() {
    ReferenceHolder<QoreEventNotifier> holder(new QoreEventNotifier(xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_EVENTNOTIFIER, holder.release());
}

//! Signals the notifier (thread-safe)
/** This method can be called from any thread to wake up an event loop
    waiting on this notifier.

    Multiple calls to notify() before acknowledge() may be coalesced
    (on Linux with eventfd) or queued (on other platforms with pipe).

    @par Example:
    @code{.py} notifier.notify(); @endcode

    @note This method is thread-safe and lock-free
*/
nothing EventNotifier::notify() {
    en->notify();
}

//! Acknowledges/consumes the notification
/** This method should be called after the event loop returns with an
    event on this notifier. It drains any pending notifications.

    @par Example:
    @code{.py}
*list<hash<SocketPollInfo>> events = loop.poll(5s);
for (hash<SocketPollInfo> ev in events) {
    if (ev.socket instanceof EventNotifier) {
        cast<EventNotifier>(ev.socket).acknowledge();
        # process notification...
    }
}
    @endcode

    @throw EVENT-NOTIFIER-ERROR Error reading from notifier
*/
nothing EventNotifier::acknowledge() {
    en->acknowledge(xsink);
}

//! Returns the file descriptor for this notifier
/** This method returns the underlying file descriptor, which can be useful
    for debugging or advanced integration scenarios.

    @return The file descriptor, or -1 if the notifier is not valid

    @par Example:
    @code{.py} int fd = notifier.fd(); @endcode
*/
int EventNotifier::fd() {
    return en->fd();
}

//! Returns True if the notifier is valid
/** @par Example:
    @code{.py} bool valid = notifier.isValid(); @endcode

    @return True if the notifier was created successfully
*/
bool EventNotifier::isValid() {
    return en->isValid();
}

//! Returns the pollable descriptor for use with EventLoop
/** This method is required by AbstractPollableIoObjectBase.

    @return The file descriptor, or -1 if the notifier is not valid
*/
int EventNotifier::getPollableDescriptor() {
    return en->getPollableDescriptor();
}
