#include "qore/Qore.h"
#include "qore/intern/QC_AbstractHttpPollConnection.h"
#include "qore/intern/QoreEventNotifier.h"
#include "qore/intern/SocketSyncPoll.h"
#include "qore/intern/ql_debug.h"

// Forward declaration for EventNotifier QPP type references
extern QoreClass* QC_EVENTNOTIFIER;

// --- AbstractHttpPollConnectionPriv out-of-line method implementations ---

void AbstractHttpPollConnectionPriv::onConnectionReady() {
    std::vector<std::pair<QoreEventNotifier*, QoreObject*>> to_notify;
    {
        AutoLocker al(lock);
        if (state.load(std::memory_order_acquire) == CONNECTING) {
            // Latch was_ready BEFORE the state transition so any reader that
            // observes state != CONNECTING also observes was_ready == true.
            was_ready.store(true, std::memory_order_release);
            state.store(READY, std::memory_order_release);
            ready_cond.broadcast();
            to_notify = std::move(ready_notifiers);
        }
    }
    // Signal outside lock to avoid lock inversion; deref to release our refs
    for (auto& [ptr, obj] : to_notify) {
        ptr->notify();
        ExceptionSink xsink;
        ptr->deref(&xsink);
        obj->deref(&xsink);
    }
}

void AbstractHttpPollConnectionPriv::setClosed() {
    std::vector<std::pair<QoreEventNotifier*, QoreObject*>> to_notify;
    bool fire_hook = false;
    {
        AutoLocker al(lock);
        state.store(CLOSED, std::memory_order_release);
        ready_cond.broadcast();
        to_notify = std::move(ready_notifiers);
        // One-shot guard: fire onClosedHook on the first close transition
        // only.  Subsequent setClosed() calls (e.g., I/O thread idle timeout
        // races with app thread closeConnection) skip the hook to keep
        // manager-side eviction idempotent.
        if (!on_closed_hook_fired) {
            on_closed_hook_fired = true;
            fire_hook = true;
            // Keep the object alive after ready_cond wakes waiters that may
            // release their connection reference before onClosedHook() runs.
            ref();
        }
    }
    for (auto& [ptr, obj] : to_notify) {
        ptr->notify();
        ExceptionSink xsink;
        ptr->deref(&xsink);
        obj->deref(&xsink);
    }
    // Outside the lock — implementations may take other locks here.
    // See AbstractHttpPollConnection.h docs and
    // design/http-client-manager-cpp-port.md for the lock ordering rules.
    if (fire_hook) {
#ifdef DEBUG
        // tests hold the close notification after the connection is marked closed and its waiters are woken
        qore_dbg_conn_close_notify_hook_t notify_hook = qore_dbg_conn_close_notify_hook.load();
        if (notify_hook) {
            notify_hook(this, false);
        }
#endif
        onClosedHook();
#ifdef DEBUG
        if (notify_hook) {
            notify_hook(this, true);
        }
        // tests release a reference here to make the one released below the last one, as when the connection
        // manager evicts the connection in the meantime
        qore_dbg_conn_close_release_hook_t release_hook = qore_dbg_conn_close_release_hook.load();
        bool released = release_hook && release_hook(this);
#endif
        ExceptionSink xsink;
        deref(&xsink);
#ifdef DEBUG
        if (released) {
            qore_dbg_conn_close_released();
        }
#endif
    }
}

int AbstractHttpPollConnectionPriv::waitForStateChange(int from_state, int64_t timeout_ms, ExceptionSink* xsink) {
    // the deadline is on the monotonic clock, so a wall-clock step does not change it, and it is not restarted by
    // a broadcast that does not change the state
    const bool has_deadline = timeout_ms > 0;
    const int64 deadline_us = has_deadline ? q_clock_getmicros_monotonic() + timeout_ms * 1000 : 0;
    AutoLocker al(lock);
    while (true) {
        // every transition stores the state and broadcasts under the lock, so it cannot be missed here
        int current = state.load(std::memory_order_acquire);
        if (current != from_state) {
            return current;
        }
        int64 wait_ms = -1;
        if (has_deadline) {
            int64 remaining_us = deadline_us - q_clock_getmicros_monotonic();
            if (remaining_us <= 0) {
                return current;
            }
            // round up, so the wait never ends before the deadline
            wait_ms = (remaining_us + 999) / 1000;
        }
        if (ready_cond.waitWithInterrupt(lock, wait_ms, xsink) == QORE_COND_RESULT_INTERRUPTED) {
            return -1;
        }
    }
}

bool AbstractHttpPollConnectionPriv::registerReadyNotifier(QoreEventNotifier* notifier,
        QoreObject* notifier_obj) {
    AutoLocker al(lock);
    if (state.load(std::memory_order_acquire) == CONNECTING) {
        ready_notifiers.push_back({notifier, notifier_obj});
        return true;
    }
    // Already decided — caller takes back the refs we were given
    ExceptionSink xsink;
    notifier->deref(&xsink);
    notifier_obj->deref(&xsink);
    return false;
}

//! C++ base class for HTTP client connection state management
/** This class provides the connection state machine (CONNECTING → READY →
    DRAINING/CLOSED) entirely in C++, enabling:

    - Pure C++ onConnectionReady() safe for I/O thread calls
    - Lock-free atomic state reads (isReady, isClosed, isDraining)
    - DGC-compatible ownership when used with internal_members in poll ops

    Qore HttpClientConnection inherits from this class. HTTP/2 and HTTP/3
    poll operations store a raw C++ pointer to this priv data for direct
    I/O-thread calls, while the Qore internal_members slot holds the single
    strong ref visible to the DGC.

    State values match the Qore HttpClientConnectionState enum (0-3).

    @since %Qore 3.0
*/
qclass AbstractHttpPollConnection [
    ns=Qore;
    arg=AbstractHttpPollConnectionPriv* priv
];

//! Creates the connection state object in CONNECTING state
/** The connection starts in CONNECTING state (0).
*/
AbstractHttpPollConnection::constructor() {
    self->setPrivate(CID_ABSTRACTHTTPPOLLCONNECTION, new AbstractHttpPollConnectionPriv());
}

//! Called when the connection becomes ready
/** Transitions from CONNECTING to READY and broadcasts to waiters.
    This method is safe to call from the I/O thread (pure C++ internally).

    @note HTTP/2 and HTTP/3 poll operations bypass this QPP method and call
    the C++ priv directly for zero-overhead I/O-thread notification. This
    QPP method exists for Qore-only poll operations (HTTP/1.1).
*/
nothing AbstractHttpPollConnection::onConnectionReady() {
    priv->onConnectionReady();
}

//! Waits for the connection to become ready
/** Blocks until the state leaves CONNECTING or the timeout expires.

    @param timeout_ms maximum time to wait (default 30s)
    @return True if the connection is in READY state after the wait

    @note Does not throw on CLOSED — the caller should check isClosed()
    and getConnectionState() to determine the reason for a False return.
*/
bool AbstractHttpPollConnection::waitForReady(timeout timeout_ms = 30s) [flags=NAMED_ARGS] {
    SocketSyncPoll::assertNotOnIoThread("AbstractHttpPollConnection", "waitForReady", xsink);
    if (*xsink) {
        return false;
    }
    return priv->waitForReady((int64_t)timeout_ms);
}

//! Waits until the state of the connection changes
/** Returns at once if the state already differs from \a from_state; otherwise blocks until the connection leaves
    \a from_state or the timeout expires.  Use it to see a connection that is in use for a long time, such as a leased
    connection or one with a long-lived stream (a WebSocket, Server-Sent Events or a CONNECT tunnel), go from
    @ref HttpClientIo::HttpClientConnectionState::Ready "Ready" to
    @ref HttpClientIo::HttpClientConnectionState::Draining "Draining" when the server sends HTTP/2 or HTTP/3
    \c GOAWAY: the requests in progress can finish, but the connection accepts no new request, so new work belongs
    on another connection.  A connection goes to
    @ref HttpClientIo::HttpClientConnectionState::Closed "Closed" when it closes, from any state.

    The states are the values of @ref HttpClientIo::HttpClientConnectionState "HttpClientConnectionState": 0
    (connecting), 1 (ready), 2 (draining) and 3 (closed).

    @par Example:
    @code{.py}
# wait for the server to stop accepting requests on a leased connection
HttpClientConnection conn = mgr.leaseConnection(url);
on_exit mgr.releaseConnection(conn);
int state = conn.getConnectionState();
while (state == HttpClientConnectionState::Ready) {
    state = conn.waitForStateChange(state, 1h);
}
if (state == HttpClientConnectionState::Draining) {
    # GOAWAY: finish the work in progress and use a new connection for the rest
}
    @endcode

    @param from_state the state to wait to leave
    @param timeout_ms the maximum time to wait; no value or a value <= 0 means no timeout

    @return the state of the connection after the wait; equal to \a from_state if the timeout expired

    @throw SOCKET-SYNC-ON-IO-THREAD-ERROR called on an async I/O thread, which makes the state changes and so could
    never see one
    @throw THREAD-CANCELLED the thread was cancelled while it waited
    @throw PROGRAM-INTERRUPTED the program was interrupted while it waited

    @since %Qore 3.0
*/
int AbstractHttpPollConnection::waitForStateChange(int from_state, *timeout timeout_ms) [flags=NAMED_ARGS] {
    SocketSyncPoll::assertNotOnIoThread("AbstractHttpPollConnection", "waitForStateChange", xsink);
    if (*xsink) {
        return QoreValue();
    }
    int rv = priv->waitForStateChange(static_cast<int>(from_state), timeout_ms, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return rv;
}

//! Returns True if the connection is in READY state
/** Lock-free atomic read — safe to call from any thread without contention.
    @return True if ready for requests
*/
bool AbstractHttpPollConnection::isReady() [flags=RET_VALUE_ONLY] {
    return priv->isReady();
}

//! Returns True if the connection is in CLOSED state
/** Lock-free atomic read — safe to call from any thread without contention.
    @return True if closed
*/
bool AbstractHttpPollConnection::isClosed() [flags=RET_VALUE_ONLY] {
    return priv->isClosed();
}

//! Returns True if the connection is in DRAINING state
/** Lock-free atomic read — safe to call from any thread without contention.
    @return True if draining (GOAWAY received)
*/
bool AbstractHttpPollConnection::isDraining() [flags=RET_VALUE_ONLY] {
    return priv->isDraining();
}

//! Returns the current connection state as an int matching HttpClientConnectionState
/** @return 0=CONNECTING, 1=READY, 2=DRAINING, 3=CLOSED
*/
int AbstractHttpPollConnection::getConnectionState() [flags=RET_VALUE_ONLY] {
    return priv->getState();
}

//! Transitions the connection to CLOSED state
/** Broadcasts to any threads waiting in waitForReady().
*/
nothing AbstractHttpPollConnection::setClosed() {
    priv->setClosed();
}

//! Transitions the connection to DRAINING state (GOAWAY received)
/** Only transitions if currently in READY state. Broadcasts to any
    threads waiting in waitForReady().
*/
nothing AbstractHttpPollConnection::setDraining() {
    priv->setDraining();
}

//! Registers an EventNotifier to be signaled when the connection becomes ready or closed
/** If the connection is already in a decided state (READY, DRAINING, or CLOSED), returns
    \c False immediately — the caller should not wait.  If the connection is still
    CONNECTING, queues the notifier and returns \c True — the caller should poll the
    notifier's FD for SOCK_POLLIN and re-check state when it fires.

    The caller must ensure the EventNotifier object remains alive until the notifier fires
    (or until the caller cancels and stops polling it).

    @param notifier the EventNotifier to signal

    @return True if the notifier was queued (caller should poll), False if already decided

    @since %Qore 3.0
*/
bool AbstractHttpPollConnection::registerReadyNotifier(EventNotifier[QoreEventNotifier] notifier) [flags=NAMED_ARGS] {
    // Transfer the ref from the QPP ReferenceHolder — priv takes ownership
    QoreEventNotifier* ptr = notifier.release();
    QoreObject* obj = const_cast<QoreObject*>(obj_notifier);
    // Ref the QoreObject so it stays alive until we deref it after signaling
    obj->ref();
    return priv->registerReadyNotifier(ptr, obj);
}
