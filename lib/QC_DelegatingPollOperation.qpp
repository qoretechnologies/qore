#include "qore/Qore.h"
#include "qore/intern/QC_SocketPollOperationBase.h"
#include "qore/intern/QC_DelegatingPollOperation.h"
#include "qore/intern/RSet.h"

/** @cond INTERNAL */
class DelegatingPollOperationPriv : public SocketPollOperationBase {
public:
    QoreObject* inner_obj;
    SocketPollOperationBase* inner_base;
    ResolvedCallReferenceNode* on_complete_code;
    QoreObject* counter_obj;
    bool inner_has_abort;
    bool inner_has_get_output;

    DLLLOCAL DelegatingPollOperationPriv(QoreObject* self, QoreObject* inner_obj,
            SocketPollOperationBase* inner_base, ResolvedCallReferenceNode* on_complete_code,
            QoreObject* counter_obj, bool inner_has_abort, bool inner_has_get_output)
        : SocketPollOperationBase(self), inner_obj(inner_obj), inner_base(inner_base),
          on_complete_code(on_complete_code), counter_obj(counter_obj), inner_has_abort(inner_has_abort),
          inner_has_get_output(inner_has_get_output) {
        inner_obj->ref();
        if (inner_base) {
            inner_base->ref();
        }
        if (on_complete_code) {
            on_complete_code->ref();
        }
        if (counter_obj) {
            counter_obj->ref();
        }
    }

    DLLLOCAL virtual ~DelegatingPollOperationPriv() {
        assert(!inner_obj);
        assert(!inner_base);
        assert(!on_complete_code);
        assert(!counter_obj);
    }

    DLLLOCAL void cleanup(ExceptionSink* xsink) {
        if (inner_obj) {
            inner_obj->deref(xsink);
            inner_obj = nullptr;
        }
        if (inner_base) {
            inner_base->deref(xsink);
            inner_base = nullptr;
        }
        if (on_complete_code) {
            on_complete_code->deref(xsink);
            on_complete_code = nullptr;
        }
        if (counter_obj) {
            counter_obj->deref(xsink);
            counter_obj = nullptr;
        }
    }

    //! DGC custom scanner for the four raw refs this priv holds
    /** @c inner_obj, @c counter_obj, and @c on_complete_code all hold
        strong refs to data structures the normal QoreObject data/cdmap
        scan cannot see (they live in C++ member fields, not in any
        qclass's @c internal_members).  Without this scanner, any cycle
        that routes through one of these refs is invisible to DGC and
        the whole graph leaks.

        The concrete trigger for this scanner is a closure supplied as
        @c on_complete with captured outer-scope variables: the
        closure's @c ResolvedCallReferenceNode holds the captured
        environment, which can transitively point back through other
        Qore objects into the @c DelegatingPollOperation itself.  With
        no scanner, 420 KB / 1.16 MB of parse-tree allocations were
        leaked per submit in @c AsyncSocketIo.qtest's main test.

        See @c design/dgc.md Pattern B.

        @param obj the @c RObject wrapping this private data
        @param rsh the scanner helper
        @return @c true if a lock error forces the scan transaction to
            abort (per the @c scanCheck contract); always @c false here
    */
    DLLLOCAL bool scanMembers(RObject& obj, RSetHelper& rsh) {
        if (inner_obj && obj.scanCheck(rsh, inner_obj)) {
            return true;
        }
        if (counter_obj && obj.scanCheck(rsh, counter_obj)) {
            return true;
        }
        if (on_complete_code && obj.scanCheck(rsh, on_complete_code)) {
            return true;
        }
        return false;
    }

    DLLLOCAL bool goalReached() const override {
        if (inner_base) {
            return inner_base->goalReached();
        }
        // Fall back to evalMethod for non-C++ inner
        ExceptionSink xsink;
        ValueHolder rv(inner_obj->evalMethod("goalReached", nullptr, &xsink), &xsink);
        if (xsink) {
            xsink.clear();
            return false;
        }
        return rv->getAsBool();
    }

    DLLLOCAL void abort(ExceptionSink* xsink) override {
        if (inner_base) {
            inner_base->abort(xsink);
        } else if (inner_has_abort) {
            ValueHolder rv(inner_obj->evalMethod("abort", nullptr, xsink), xsink);
        }
    }

    //! Returns true when the inner op is a Qore object (not a C++ SocketPollOperationBase).
    /** Causes the async I/O controller to dispatch continuePoll() to a worker thread
        instead of running it on the I/O thread, preventing Qore evalMethod calls,
        blocking waits, and synchronous I/O on the I/O thread.
    */
    DLLLOCAL bool needsWorkerDispatch() const override {
        return inner_base == nullptr;
    }

    DLLLOCAL QoreHashNode* continuePoll(ExceptionSink* xsink) override {
        if (inner_base) {
            return inner_base->continuePoll(xsink);
        }
        // inner op is Qore — only called from a worker thread (needsWorkerDispatch() == true)
        ValueHolder rv(inner_obj->evalMethod("continuePoll", nullptr, xsink), xsink);
        if (*xsink) {
            return nullptr;
        }
        if (rv->getType() == NT_HASH) {
            return rv.release().get<QoreHashNode>();
        }
        return nullptr;
    }

    DLLLOCAL int getAndClearItemsPushed() override {
        if (inner_base) {
            return inner_base->getAndClearItemsPushed();
        }
        return 0;
    }

    DLLLOCAL QoreValue getOutput() const override {
        if (inner_base) {
            return inner_base->getOutput();
        }
        if (!inner_has_get_output) {
            return QoreValue();
        }
        ExceptionSink xsink;
        ValueHolder rv(inner_obj->evalMethod("getOutput", nullptr, &xsink), &xsink);
        if (xsink) {
            xsink.clear();
            return QoreValue();
        }
        return rv.release();
    }

protected:
    // cached state string for getStateImpl() lifetime
    mutable std::string cached_state;

    DLLLOCAL const char* getStateImpl() const override {
        // Get state from inner object via Qore method call
        if (inner_obj) {
            ExceptionSink xsink;
            ValueHolder rv(inner_obj->evalMethod("getState", nullptr, &xsink), &xsink);
            if (!xsink && rv->getType() == NT_STRING) {
                QoreStringValueHelper state(*rv);
                cached_state.assign(state->c_str(), state->size());
                return cached_state.c_str();
            }
        }
        return "delegating";
    }
};

static bool qore_delegating_poll_op_has_override(const QoreClass* cls, const char* method) {
    const QoreMethod* meth = cls->findMethod(method);
    return meth && meth->getClass()->getID() != CID_ABSTRACTPOLLOPERATION;
}

// DGC dispatch entry point — see QC_DelegatingPollOperation.h.
bool qore_delegating_poll_op_scan_members(QoreObject& qobj, RObject& obj,
        RSetHelper& rsh, ExceptionSink* xsink) {
    ReferenceHolder<DelegatingPollOperationPriv> priv(
        reinterpret_cast<DelegatingPollOperationPriv*>(
            qobj.getReferencedPrivateData(CID_DELEGATINGPOLLOPERATION, xsink)),
        xsink);
    if (*xsink || !*priv) {
        return false;
    }
    return (*priv)->scanMembers(obj, rsh);
}
/** @endcond */

//! C++ delegating poll operation that wraps any AbstractPollOperation
/** This class delegates all poll methods to an inner operation and provides
    completion handling via onComplete(). Unlike the Qore CompletionPollProxy,
    this class preserves the C++ fast path (spop_base) for continuePoll(),
    which is critical for performance-sensitive operations like HTTP/2.

    Use this for C++ operations we don't control (SSL upgrade, send/recv, connect)
    that need completion handling.

    @since %Qore 2.3
*/
qclass DelegatingPollOperation [
    private_members=object sock,string goal,auto data_save;
    ns=Qore;
    arg=DelegatingPollOperationPriv* poll;
    vparent=SocketPollOperationBase
];

//! Creates a delegating poll operation wrapping an inner operation
/** @param operation the inner poll operation to delegate to
    @param on_complete optional code reference called when the operation completes;
        signature: \c code<nothing(hash<SocketPollResultInfo>)>
    @param done_counter optional Counter to decrement when the operation completes
*/
DelegatingPollOperation::constructor(AbstractPollOperation operation, *code on_complete, *Counter done_counter)
        [flags=NAMED_ARGS] {
    QoreObject* inner_obj = const_cast<QoreObject*>(operation);

    // Get the inner operation's C++ private data if available
    SocketPollOperationBase* inner_base = nullptr;
    const QoreClass* inner_cls = inner_obj->getClass();
    if (inner_cls->getClass(CID_SOCKETPOLLOPERATIONBASE)) {
        inner_base = static_cast<SocketPollOperationBase*>(
            inner_obj->getReferencedPrivateData(CID_SOCKETPOLLOPERATIONBASE, xsink));
        if (*xsink) {
            return;
        }
    }

    ResolvedCallReferenceNode* on_complete_ref = nullptr;
    if (on_complete) {
        on_complete_ref = const_cast<ResolvedCallReferenceNode*>(on_complete);
        on_complete_ref->ref();
    }

    QoreObject* counter_obj = nullptr;
    if (done_counter) {
        counter_obj = const_cast<QoreObject*>(done_counter);
        counter_obj->ref();
    }

    // Copy goal and sock from inner operation
    ValueHolder goal_val(inner_obj->evalMethod("getGoal", nullptr, xsink), xsink);
    if (!*xsink) {
        self->setMemberValue("goal", QC_DELEGATINGPOLLOPERATION, goal_val.release(), xsink);
    }
    // Try to get sock from inner's members (for SocketPollOperationBase subclasses)
    ValueHolder sock_val(inner_obj->getReferencedMemberNoMethod("sock", xsink), xsink);
    if (!*xsink && sock_val->getType() == NT_OBJECT) {
        self->setMemberValue("sock", QC_DELEGATINGPOLLOPERATION, sock_val.release(), xsink);
    } else if (*xsink) {
        xsink->clear();
    }

    self->setPrivate(CID_DELEGATINGPOLLOPERATION,
        new DelegatingPollOperationPriv(self, inner_obj, inner_base, on_complete_ref, counter_obj,
            qore_delegating_poll_op_has_override(inner_cls, "abort"),
            qore_delegating_poll_op_has_override(inner_cls, "getOutput")));

    // DGC custom scanner gate — the priv holds ref'd inner_obj /
    // counter_obj / on_complete_code in raw C++ pointers that the
    // normal data/cdmap scan cannot see.  incScanPrivateData() tells
    // the scanner to dispatch to qore_delegating_poll_op_scan_members
    // on every cycle check for this object.  See design/dgc.md
    // Pattern B.  Dec is in the destructor below.
    qore_object_private::get(*self)->incScanPrivateData();

    // Release extra refs (constructor took ownership)
    if (inner_base) {
        inner_base->deref(xsink);
    }
    if (on_complete_ref) {
        on_complete_ref->deref(xsink);
    }
    if (counter_obj) {
        counter_obj->deref(xsink);
    }
}

//! Destroys the object
/** Releases all internal references.
*/
DelegatingPollOperation::destructor() {
    qore_object_private::get(*self)->decScanPrivateData();
    poll->cleanup(xsink);
    poll->deref(xsink);
}

//! Returns the goal
/** @return the goal string from the inner operation
*/
string DelegatingPollOperation::getGoal() {
    return self->getReferencedMemberNoMethod("goal", xsink);
}

//! Returns the current state
/** @return the current state string from the inner operation
*/
string DelegatingPollOperation::getState() {
    return poll->getState();
}

//! Returns True when the goal has been reached
/** @return True when the inner operation's goal has been reached
*/
bool DelegatingPollOperation::goalReached() {
    return poll->goalReached();
}

//! Continues the poll operation
/** @return socket poll info for the next poll cycle, or @ref nothing if polling is complete
*/
*hash<SocketPollInfo> DelegatingPollOperation::continuePoll() {
    return poll->continuePoll(xsink);
}

//! Aborts the operation
/** Aborts the inner poll operation.
*/
nothing DelegatingPollOperation::abort() {
    poll->abort(xsink);
}

//! Returns any output from the inner operation
/** @return any output data from the inner operation
*/
auto DelegatingPollOperation::getOutput() [flags=RET_VALUE_ONLY] {
    return poll->getOutput();
}

//! Called when the operation completes
/** If a Counter was provided, it is decremented. If an onComplete code reference
    was provided, it is called with the result hash. If both are provided, the
    Counter is decremented first.
*/
nothing DelegatingPollOperation::onComplete(hash<SocketPollResultInfo> result) [flags=NAMED_ARGS] {
    if (poll->counter_obj) {
        // Decrement counter — use separate xsink so counter failures don't block callback
        ExceptionSink dec_xsink;
        ValueHolder rv(poll->counter_obj->evalMethod("dec", nullptr, &dec_xsink), &dec_xsink);
        if (dec_xsink) {
            dec_xsink.clear();
        }
    }
    if (poll->on_complete_code) {
        ExceptionSink cb_xsink;
        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &cb_xsink);
        args->push(result->refSelf(), &cb_xsink);
        ValueHolder rv(poll->on_complete_code->execValue(*args, &cb_xsink), &cb_xsink);
        if (cb_xsink) {
            xsink->assimilate(cb_xsink);
        }
    }
}

//! Called by the I/O controller when items have been pushed during continuePoll
/** Forwards to the inner operation's onPollComplete method.

    @since %Qore 2.3
*/
nothing DelegatingPollOperation::onPollComplete() {
    if (poll->inner_obj) {
        ValueHolder rv(poll->inner_obj->evalMethod("onPollComplete", nullptr, xsink), xsink);
    }
}
