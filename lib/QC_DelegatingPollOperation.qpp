#include <atomic>
#include <limits>
#include <mutex>

/** @cond INTERNAL */
// Kept only by a delegate configured to bound an HTTP/1 response send.
class HttpResponseSendBound {
public:
    HttpResponseSendBound(int64 stall_ms, int64 min_rate, int64 window_ms)
        : stall_ms(stall_ms), rate(makeRateWindow(min_rate, window_ms)) {
    }

    // Called only while the inner operation is pending. A fused operation no longer measures the response once
    // it starts waiting for the next request. Time spent waiting for the body source is excluded from the rate.
    bool check(SocketPollOperationBase& op, QoreHashNode& next, ExceptionSink* xsink) {
        std::lock_guard<std::mutex> lock(mutex);
        bool waiting = true;
        int64 delivered;
        if (auto* send = dynamic_cast<SocketSendPollOperation*>(&op)) {
            delivered = send->getDeliveredBytes();
        } else if (auto* fused = dynamic_cast<SocketSendAndReadHeaderPollOperation*>(&op)) {
            delivered = fused->getResponseSendProgress(waiting);
        } else {
            delivered = static_cast<SocketSendStreamAndReadHeaderPollOperation&>(op).getResponseSendProgress(waiting);
        }
        if (delivered < 0) {
            if (last_progress >= 0) {
                renew = true;
                last_progress = -1;
                rate = makeRateWindow(rate.getMinRate(), rate.getWindowMs());
            }
            return true;
        }
        int64 now = q_get_monotonic_us() / 1000;
        if (last_progress < 0 || delivered > last_progress) {
            renew = true;
            last_progress = delivered;
            since_ms = now;
        }
        int64 remaining = stall_ms - (now - since_ms);
        if (remaining <= 0) {
            xsink->raiseException("SOCKET-TIMEOUT", "HTTP response send made no progress for %lld ms",
                static_cast<long long>(stall_ms));
            return false;
        }
        if (rate.update(delivered, waiting, now)) {
            xsink->raiseException("SOCKET-TIMEOUT", "the client took less than the minimum response rate of %lld bytes/s",
                static_cast<long long>(rate.getMinRate()));
            return false;
        }
        // TCP acknowledgements can advance while the socket is still not writable.
        int64 wake = std::min(remaining, std::max<int64>(1, stall_ms / 2));
        if (rate.enabled()) {
            wake = std::min<int64>(wake, rate.getCheckIntervalMs());
        }
        // The controller converts this interval to microseconds for its poll deadline.
        next.setKeyValue("poll_timeout_ms", std::min<int64>(wake, std::numeric_limits<int>::max()), xsink);
        return !*xsink;
    }

    bool takeRenewal() {
        return renew.exchange(false, std::memory_order_relaxed);
    }

private:
    static SendRateWindow makeRateWindow(int64 min_rate, int64 window_ms) {
        SendRateWindow window(min_rate, window_ms);
        window.enableProgressSteps();
        window.setMaxWaitCharge(2 * window.getCheckIntervalMs());
        return window;
    }

    std::mutex mutex;
    std::atomic<bool> renew{false};
    const int64 stall_ms;
    int64 last_progress = -1;
    int64 since_ms = 0;
    SendRateWindow rate;
};

class DelegatingPollOperationPriv : public SocketPollOperationBase {
public:
    QoreObject* inner_obj;
    SocketPollOperationBase* inner_base;
    ResolvedCallReferenceNode* on_complete_code;
    //! the run-time parse options of the code that created the operation, which on_complete_code runs with
    /** A callback that is a call reference to builtin code sets no options of its own (qore#6208)
    */
    const QoreThreadRuntimeParseOptions on_complete_po = QoreThreadRuntimeParseOptions::capture();
    QoreObject* counter_obj;
    bool inner_has_abort;
    bool inner_has_get_output;
    //! True if the inner operation is implemented in C++ and its getState() is the builtin one
    /** Its state is then read with getStateImpl(), without a Qore method call; see getStateImpl()
    */
    bool inner_native_state;
    std::unique_ptr<HttpResponseSendBound> send_bound;

    DLLLOCAL DelegatingPollOperationPriv(QoreObject* self, QoreObject* inner_obj,
            SocketPollOperationBase* inner_base, ResolvedCallReferenceNode* on_complete_code,
            QoreObject* counter_obj, bool inner_has_abort, bool inner_has_get_output, bool inner_native_state)
        : SocketPollOperationBase(self), inner_obj(inner_obj), inner_base(inner_base),
          on_complete_code(on_complete_code), counter_obj(counter_obj), inner_has_abort(inner_has_abort),
          inner_has_get_output(inner_has_get_output), inner_native_state(inner_native_state) {
        inner_obj->ref();
        if (inner_base) {
            inner_base->ref();
        }
        if (on_complete_code) {
            on_complete_code->ref();
        }
        if (counter_obj) {
            counter_obj->ref();
        }
    }

    DLLLOCAL virtual ~DelegatingPollOperationPriv() {
        assert(!inner_obj);
        assert(!inner_base);
        assert(!on_complete_code);
        assert(!counter_obj);
    }

    //! Releases the operation's state (cleanup()) with its last reference
    /** An async I/O controller that holds the operation can still continue it after the destructor of its object
        (issue #6464)
    */
    DLLLOCAL void deref(ExceptionSink* xsink) override {
        if (ROdereference()) {
            cleanup(xsink);
            delete this;
        }
    }

    //! Releases the operation's state (cleanup()) with its last reference, without a caller's exception sink
    DLLLOCAL void deref() override {
        if (ROdereference()) {
            ExceptionSink xsink;
            cleanup(&xsink);
            delete this;
        }
    }

    DLLLOCAL void cleanup(ExceptionSink* xsink) {
        if (inner_obj) {
            inner_obj->deref(xsink);
            inner_obj = nullptr;
        }
        if (inner_base) {
            inner_base->deref(xsink);
            inner_base = nullptr;
        }
        if (on_complete_code) {
            on_complete_code->deref(xsink);
            on_complete_code = nullptr;
        }
        if (counter_obj) {
            counter_obj->deref(xsink);
            counter_obj = nullptr;
        }
    }

    //! DGC custom scanner for the four raw refs this priv holds
    /** @c inner_obj, @c counter_obj, and @c on_complete_code all hold
        strong refs to data structures the normal QoreObject data/cdmap
        scan cannot see (they live in C++ member fields, not in any
        qclass's @c internal_members).  Without this scanner, any cycle
        that routes through one of these refs is invisible to DGC and
        the whole graph leaks.

        The concrete trigger for this scanner is a closure supplied as
        @c on_complete with captured outer-scope variables: the
        closure's @c ResolvedCallReferenceNode holds the captured
        environment, which can transitively point back through other
        Qore objects into the @c DelegatingPollOperation itself.  With
        no scanner, 420 KB / 1.16 MB of parse-tree allocations were
        leaked per submit in @c AsyncSocketIo.qtest's main test.

        See @c design/dgc.md Pattern B.

        @param obj the @c RObject wrapping this private data
        @param rsh the scanner helper
        @return @c true if a lock error forces the scan transaction to
            abort (per the @c scanCheck contract); always @c false here
    */
    DLLLOCAL bool scanMembers(RObject& obj, RSetHelper& rsh) {
        if (inner_obj && obj.scanCheck(rsh, inner_obj)) {
            return true;
        }
        if (counter_obj && obj.scanCheck(rsh, counter_obj)) {
            return true;
        }
        if (on_complete_code && obj.scanCheck(rsh, on_complete_code)) {
            return true;
        }
        return false;
    }

    DLLLOCAL bool goalReached() const override {
        if (inner_base) {
            return inner_base->goalReached();
        }
        // Fall back to evalMethod for non-C++ inner
        ExceptionSink xsink;
        ValueHolder rv(inner_obj->evalMethod("goalReached", nullptr, &xsink), &xsink);
        if (xsink) {
            xsink.clear();
            return false;
        }
        return rv->getAsBool();
    }

    DLLLOCAL void abort(ExceptionSink* xsink) override {
        if (inner_base) {
            inner_base->abort(xsink);
        } else if (inner_has_abort) {
            ValueHolder rv(inner_obj->evalMethod("abort", nullptr, xsink), xsink);
        }
    }

    //! Returns true when the inner op is a Qore object (not a C++ SocketPollOperationBase).
    /** Causes the async I/O controller to dispatch continuePoll() to a worker thread
        instead of running it on the I/O thread, preventing Qore evalMethod calls,
        blocking waits, and synchronous I/O on the I/O thread.
    */
    DLLLOCAL bool needsWorkerDispatch() const override {
        return inner_base == nullptr;
    }

    // the controller asks the operation that it was given: the renewal of the timeout is the inner operation's
    DLLLOCAL bool renewsTimeout() override {
        bool inner_renew = inner_base && inner_base->renewsTimeout();
        return (send_bound && send_bound->takeRenewal()) || inner_renew;
    }

    DLLLOCAL QoreHashNode* continuePoll(ExceptionSink* xsink) override {
        if (inner_base) {
            QoreHashNode* next = inner_base->continuePoll(xsink);
            if (next && send_bound && !*xsink && !send_bound->check(*inner_base, *next, xsink)) {
                next->deref(xsink);
                return nullptr;
            }
            return next;
        }
        // inner op is Qore — only called from a worker thread (needsWorkerDispatch() == true)
        ValueHolder rv(inner_obj->evalMethod("continuePoll", nullptr, xsink), xsink);
        if (*xsink) {
            return nullptr;
        }
        if (rv->getType() == NT_HASH) {
            return rv.release().get<QoreHashNode>();
        }
        return nullptr;
    }

    DLLLOCAL int getAndClearItemsPushed() override {
        if (inner_base) {
            return inner_base->getAndClearItemsPushed();
        }
        return 0;
    }

    DLLLOCAL QoreValue getOutput() const override {
        if (inner_base) {
            return inner_base->getOutput();
        }
        if (!inner_has_get_output) {
            return QoreValue();
        }
        ExceptionSink xsink;
        ValueHolder rv(inner_obj->evalMethod("getOutput", nullptr, &xsink), &xsink);
        if (xsink) {
            xsink.clear();
            return QoreValue();
        }
        return rv.release();
    }

protected:
    // cached state string for getStateImpl() lifetime
    mutable std::string cached_state;

    DLLLOCAL const char* getStateImpl() const override {
        // the state of an inner C++ operation without a getState() in Qore is read without a Qore method call, so
        // it can be read on the async I/O thread, which drives such an operation
        if (inner_base && inner_native_state) {
            return inner_base->getStateImpl();
        }
        // Get state from inner object via Qore method call
        if (inner_obj) {
            ExceptionSink xsink;
            ValueHolder rv(inner_obj->evalMethod("getState", nullptr, &xsink), &xsink);
            if (!xsink && rv->getType() == NT_STRING) {
                QoreStringValueHelper state(*rv);
                cached_state.assign(state->c_str(), state->size());
                return cached_state.c_str();
            }
        }
        return "delegating";
    }
};

static bool qore_delegating_poll_op_has_override(const QoreClass* cls, const char* method) {
    const QoreMethod* meth = cls->findMethod(method);
    return meth && meth->getClass()->getID() != CID_ABSTRACTPOLLOPERATION;
}

bool qore_delegating_poll_op_reads_state_natively(const SocketPollOperationBase* op) {
    const DelegatingPollOperationPriv* dop = dynamic_cast<const DelegatingPollOperationPriv*>(op);
    // the inner operation of a delegating operation that runs on the I/O thread is implemented in C++ (see
    // needsWorkerDispatch()), but its getState() can still be implemented in Qore
    return !dop || !dop->inner_base || dop->inner_native_state;
}

// DGC dispatch entry point — see QC_DelegatingPollOperation.h.
bool qore_delegating_poll_op_scan_members(AbstractPrivateData* priv_data, RObject& obj,
        RSetHelper& rsh, ExceptionSink* xsink) {
    // the reference can be the last one if the object is deleted meanwhile: its release, which runs the operation's
    // cleanup, is not made in the scan
    QorePollOpOffThreadRef<DelegatingPollOperationPriv> priv(
        reinterpret_cast<DelegatingPollOperationPriv*>(priv_data));
    if (!*priv) {
        return false;
    }
    return (*priv)->scanMembers(obj, rsh);
}
static void init_delegating_poll_operation(QoreObject* self, const QoreObject* operation,
        const ResolvedCallReferenceNode* on_complete, const QoreObject* done_counter, ExceptionSink* xsink,
        int64 response_stall_timeout = -1, int64 response_min_rate = 0, int64 response_rate_window = 0) {
    // the completion code, the methods of the operation and those of the counter run on a worker of the controller;
    // checked before any reference is taken (qore#7056)
    if (qore_check_thread_callable(on_complete, QDOM_THREAD_CONTROL, "DelegatingPollOperation::constructor()", xsink)
            || qore_check_thread_callable(QoreValue(const_cast<QoreObject*>(operation)), QDOM_THREAD_CONTROL,
                "DelegatingPollOperation::constructor()", xsink)
            || (done_counter && qore_check_thread_callable(QoreValue(const_cast<QoreObject*>(done_counter)),
                QDOM_THREAD_CONTROL, "DelegatingPollOperation::constructor()", xsink))) {
        return;
    }
    QoreObject* inner_obj = const_cast<QoreObject*>(operation);

    // Get the inner operation's C++ private data if available
    SocketPollOperationBase* inner_base = nullptr;
    const QoreClass* inner_cls = inner_obj->getClass();
    if (inner_cls->getClass(CID_SOCKETPOLLOPERATIONBASE)) {
        inner_base = static_cast<SocketPollOperationBase*>(
            inner_obj->getReferencedPrivateData(CID_SOCKETPOLLOPERATIONBASE, xsink));
        if (*xsink) {
            return;
        }
    }

    if (response_stall_timeout > 0 && (response_min_rate < 0
            || response_rate_window <= 0 || (!dynamic_cast<SocketSendPollOperation*>(inner_base)
                && !dynamic_cast<SocketSendAndReadHeaderPollOperation*>(inner_base)
                && !dynamic_cast<SocketSendStreamAndReadHeaderPollOperation*>(inner_base)))) {
        if (inner_base) {
            inner_base->deref(xsink);
        }
        xsink->raiseException("POLL-OPERATION-ERROR", "response send bounds require a native response send "
            "operation, a positive stall timeout and rate window, and a non-negative minimum rate");
        return;
    }
    ResolvedCallReferenceNode* on_complete_ref = nullptr;
    if (on_complete) {
        on_complete_ref = const_cast<ResolvedCallReferenceNode*>(on_complete);
        on_complete_ref->ref();
    }

    QoreObject* counter_obj = nullptr;
    if (done_counter) {
        counter_obj = const_cast<QoreObject*>(done_counter);
        counter_obj->ref();
    }

    // Copy goal and sock from inner operation
    ValueHolder goal_val(inner_obj->evalMethod("getGoal", nullptr, xsink), xsink);
    if (!*xsink) {
        qore_poll_op_set_member(self, "goal", goal_val.release(), xsink);
    }
    // Try to get sock from inner's members (for SocketPollOperationBase subclasses)
    ValueHolder sock_val(qore_poll_op_get_referenced_member(inner_obj, "sock", xsink), xsink);
    if (!*xsink && sock_val->getType() == NT_OBJECT) {
        qore_poll_op_set_member(self, "sock", sock_val.release(), xsink);
    } else if (*xsink) {
        xsink->clear();
    }

    // the state of an inner C++ operation can be read without a Qore call unless a Qore subclass overrides getState()
    const QoreMethod* get_state_meth = inner_cls->findMethod("getState");
    bool inner_native_state = inner_base && (!get_state_meth || get_state_meth->isBuiltin());

    auto* delegate = new DelegatingPollOperationPriv(self, inner_obj, inner_base, on_complete_ref, counter_obj,
            qore_delegating_poll_op_has_override(inner_cls, "abort"),
            qore_delegating_poll_op_has_override(inner_cls, "getOutput"), inner_native_state);
    if (response_stall_timeout > 0) {
        delegate->send_bound = std::make_unique<HttpResponseSendBound>(response_stall_timeout, response_min_rate,
            response_rate_window);
    }
    self->setPrivate(CID_DELEGATINGPOLLOPERATION, delegate);

    // DGC custom scanner gate — the priv holds ref'd inner_obj /
    // counter_obj / on_complete_code in raw C++ pointers that the
    // normal data/cdmap scan cannot see.  incScanPrivateData() tells
    // the scanner to dispatch to qore_delegating_poll_op_scan_members
    // on every cycle check for this object.  See design/dgc.md
    // Pattern B.  Dec is in the destructor below.
    qore_object_private::get(*self)->incScanPrivateData();

    // Release extra refs (constructor took ownership)
    if (inner_base) {
        inner_base->deref(xsink);
    }
    if (on_complete_ref) {
        on_complete_ref->deref(xsink);
    }
    if (counter_obj) {
        counter_obj->deref(xsink);
    }
}
/** @endcond */

//! C++ delegating poll operation that wraps any AbstractPollOperation
/** This class delegates all poll methods to an inner operation and provides
    completion handling via onComplete(). Unlike the Qore CompletionPollProxy,
    this class preserves the C++ fast path (spop_base) for continuePoll(),
    which is critical for performance-sensitive operations like HTTP/2.

    Use this for C++ operations we don't control (SSL upgrade, send/recv, connect)
    that need completion handling.

    @since %Qore 3.0
*/
qclass DelegatingPollOperation [
    ns=Qore;
    arg=DelegatingPollOperationPriv* poll;
    vparent=SocketPollOperationBase<auto>
];

//! Creates a delegating poll operation wrapping an inner operation
/** @param operation the inner poll operation to delegate to
    @param on_complete optional code reference called when the operation completes;
        signature: \c code<nothing(hash<SocketPollResultInfo>)>
    @param done_counter optional Counter to decrement when the operation completes
*/
DelegatingPollOperation::constructor(AbstractPollOperation<?> operation, *code on_complete, *Counter done_counter)
        [flags=NAMED_ARGS] {
    init_delegating_poll_operation(self, operation, on_complete, done_counter, xsink);
}

//! Wraps an HTTP/1 response send with a progress timeout and optional minimum rate
/** @param operation the inner poll operation to delegate to
    @param on_complete optional code reference called when the operation completes;
        signature: \c code<nothing(hash<SocketPollResultInfo>)>
    @param done_counter optional Counter to decrement when the operation completes
    @param response_stall_timeout positive time without delivery allowed while sending the response
    @param response_min_rate minimum response bytes per second while waiting for the peer, or zero to disable
    @param response_rate_window measurement interval for the minimum rate
*/
DelegatingPollOperation::constructor(AbstractPollOperation<?> operation, *code on_complete, *Counter done_counter,
        timeout response_stall_timeout, int response_min_rate, timeout response_rate_window)
        [flags=NAMED_ARGS] {
    if (response_stall_timeout <= 0) {
        xsink->raiseException("POLL-OPERATION-ERROR", "the response stall timeout must be positive");
        return;
    }
    init_delegating_poll_operation(self, operation, on_complete, done_counter, xsink, response_stall_timeout,
        response_min_rate, response_rate_window);
}

//! Destroys the object
/** Releases all internal references.
*/
DelegatingPollOperation::destructor() {
    qore_object_private::get(*self)->decScanPrivateData();
    // the operation's state is released with its last reference, which an async I/O controller that continues the
    // operation can hold; the controller cancels the operation
    qore_socket_poll_op_object_deleted(poll);
    poll->deref(xsink);
}

//! Returns the goal
/** @return the goal string from the inner operation
*/
string DelegatingPollOperation::getGoal() {
    return qore_poll_op_get_referenced_member(self, "goal", xsink);
}

//! Returns the current state
/** @return the current state string from the inner operation
*/
string DelegatingPollOperation::getState() {
    return poll->getState();
}

//! Returns True when the goal has been reached
/** @return True when the inner operation's goal has been reached
*/
bool DelegatingPollOperation::goalReached() {
    return poll->goalReached();
}

//! Continues the poll operation
/** @return socket poll info for the next poll cycle, or @ref nothing if polling is complete
*/
*hash<SocketPollInfo> DelegatingPollOperation::continuePoll() {
    return poll->continuePoll(xsink);
}

//! Aborts the operation
/** Aborts the inner poll operation.
*/
nothing DelegatingPollOperation::abort() {
    poll->abort(xsink);
}

//! Returns any output from the inner operation
/** @return any output data from the inner operation
*/
auto DelegatingPollOperation::getOutput() [flags=RET_VALUE_ONLY] {
    return poll->getOutput();
}

//! Called when the operation completes
/** If a Counter was provided, it is decremented. If an onComplete code reference
    was provided, it is called with the result hash. If both are provided, the
    Counter is decremented first.
*/
nothing DelegatingPollOperation::onComplete(hash<SocketPollResultInfo> result) [flags=NAMED_ARGS] {
    if (poll->counter_obj) {
        // Decrement counter — use separate xsink so counter failures don't block callback
        ExceptionSink dec_xsink;
        ValueHolder rv(poll->counter_obj->evalMethod("dec", nullptr, &dec_xsink), &dec_xsink);
        if (dec_xsink) {
            dec_xsink.clear();
        }
    }
    if (poll->on_complete_code) {
        ExceptionSink cb_xsink;
        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &cb_xsink);
        args->push(result->refSelf(), &cb_xsink);
        // the callback runs with the options of the code that created the operation (qore#6208)
        QoreThreadRuntimeParseOptionsHelper po_helper(&poll->on_complete_po);
        ValueHolder rv(poll->on_complete_code->invoke(*args, &cb_xsink), &cb_xsink);
        if (cb_xsink) {
            xsink->assimilate(cb_xsink);
        }
    }
}

//! Called by the I/O controller when items have been pushed during continuePoll
/** Forwards to the inner operation's onPollComplete method, if it has one (an inner PollPipeline has none;
    qore#6804).

    @since %Qore 3.0
*/
nothing DelegatingPollOperation::onPollComplete() {
    if (poll->inner_obj && poll->inner_obj->getClass()->findMethod("onPollComplete")) {
        ValueHolder rv(poll->inner_obj->evalMethod("onPollComplete", nullptr, xsink), xsink);
    }
}
