//! Returns @ref host_information_hash "a hash" representing all host and address information corresponding to the hostname passed as an argument
/**
    @param hostname the name to look up

    @return @ref host_information_hash "a hash" representing all host and address information corresponding to the hostname passed as an argument

    @note delegates to the global async I/O controller and blocks until the async DNS lookup completes

    @par Example:
    @code{.py}
*hash<auto> ah = gethostbyname_long(host);
if (!ah)
    printf("address lookup on %y failed; hostname unknown\n", host);
    @endcode

    @see gethostbyname() for a version of this function that returns just the first network address corresponding to the hostname
 */
*hash<auto> gethostbyname_long(string hostname) [flags=RET_VALUE_ONLY,NAMED_ARGS;dom=EXTERNAL_INFO] {
   return q_gethostbyname_to_hash_asyncio(xsink, hostname->c_str());
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing gethostbyname_long() [flags=RUNTIME_NOOP] {
}

//! Returns @ref host_information_hash "a hash" representing all host and address information corresponding to the address and address type passed as arguments
/** If the address family is invalid or the address string is not a valid address for the given family a \c GETHOSTBYADDR-ERROR exception will be thrown.

    @param address the address to look up
    @param family the network address family; see @ref network_address_family_constants for valid values

    @return @ref host_information_hash "a hash" representing all host and address information corresponding to the address and address type passed as arguments

    @note delegates to the global async I/O controller and blocks until the async reverse DNS lookup completes

    @par Example:
    @code{.py}
*hash<auto> ah = gethostbyaddr_long("192.168.0.33");
if (!ah)
    printf("address lookup on 192.168.0.33 failed\n", host);
    @endcode

    @throw GETHOSTBYADDR-ERROR invalid address for the given family or invalid address family

    @see gethostbyaddr() for a simpler version of this function that returns just a single hostname for the address
 */
*hash<auto> gethostbyaddr_long(string address, softint family = AF_INET) [flags=RET_VALUE_ONLY,NAMED_ARGS;dom=EXTERNAL_INFO] {
   return q_gethostbyaddr_to_hash_asyncio(xsink, address->c_str(), family);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing gethostbyaddr_long() [flags=RUNTIME_NOOP] {
}

//! Returns a list of @ref address_information_hash for the given node name or string address; if no lookup can be performed then an exception is thrown
/** Either node or service may be @ref nothing but not both or a \c QOREADDRINFO-GETINFO-ERROR exception will be thrown

    This function delegates resolution to the global async I/O controller and blocks the caller until the
    controller-backed lookup completes.

    @param node The host name or node name to look up
    @param service The service name to look up to a port number
    @param family The @ref network_address_family_constants "address family" for the lookup, must be one of Qore::AF_INET, Qore::AF_INET6, or Qore::AF_UNSPEC, meaning to return all possible addresses
    @param flags see @ref network_address_information_constants for possible values to be combined with @ref bitwise_or_operator "binary or"

    @return a list of @ref address_information_hash for the given node name or string address; if no lookup can be performed then an exception is thrown

    @par Example:
    @code{.py}
list<hash<auto>> l = getaddrinfo("localhost");
    @endcode

    @throw QOREADDRINFO-GETINFO-ERROR nodename nor servname provided, or not known
 */
list<hash<auto>> getaddrinfo(*string node, *softstring service, softint family = AF_UNSPEC, softint flags = 0) [flags=RET_VALUE_ONLY,NAMED_ARGS;dom=EXTERNAL_INFO] {
   return qore_socket_resolve_addrinfo_asyncio(xsink, node ? node->c_str() : 0, service ? service->c_str() : 0,
      (int)family, (int)flags);
}

//! Starts an asynchronous address information lookup and returns a Future for the result
/** Either node or service may be @ref nothing but not both or the returned Future will be rejected with a
    \c QOREADDRINFO-GETINFO-ERROR exception.

    This function submits the lookup to the global async I/O controller and returns immediately.  The implementation
    creates any internal pollable object needed by the controller; callers do not need to create a Socket or
    EventNotifier for DNS lookups.

    @param node The host name or node name to look up
    @param service The service name to look up to a port number
    @param family The @ref network_address_family_constants "address family" for the lookup, must be one of Qore::AF_INET, Qore::AF_INET6, or Qore::AF_UNSPEC, meaning to return all possible addresses
    @param flags see @ref network_address_information_constants for possible values to be combined with @ref bitwise_or_operator "binary or"
    @param socktype a hint for the type of socket; 0 = any socket type
    @param protocol a hint for the protocol number; 0 = the default protocol
    @param timeout the timeout for the controller-backed resolution operation; -1 = never timeout

    @return a Future that resolves to a list of @ref address_information_hash for the given node name or string address

    @par Example:
    @code{.py}
Future f = getaddrinfo_async("localhost");
list<hash<auto>> l = f.get();
    @endcode

    @throw ASYNC-IO-ERROR the lookup could not be submitted to the global async I/O controller

    @since %Qore 3.0
 */
Future getaddrinfo_async(*string node, *softstring service, softint family = AF_UNSPEC, softint flags = 0, softint socktype = SOCK_STREAM, softint protocol = 0, timeout timeout = -1) [flags=NAMED_ARGS;dom=EXTERNAL_INFO] {
   QoreFuture* future = qore_socket_resolve_addrinfo_asyncio_future(xsink, node ? node->c_str() : 0,
      service ? service->c_str() : 0, (int)family, (int)flags, (int)socktype, (int)protocol, timeout);
   return future ? qore_new_future_impl_object(getProgram(), future) : nullptr;
}

//! Starts an asynchronous reverse address lookup and returns a Future for peer-style address information
/** This function submits reverse address resolution to the global async I/O controller and returns immediately.
    The returned Future resolves to a hash in the same address-info shape used by
    @ref Qore::Socket::getPeerInfo() "Socket::getPeerInfo()", with numeric address fields always present and
    hostname fields present when reverse DNS succeeds.

    @param address the numeric IPv4 or IPv6 address to resolve
    @param family the address family, must be one of Qore::AF_INET or Qore::AF_INET6
    @param port the peer port to include in the returned hash
    @param timeout the timeout for the controller-backed reverse resolution operation; -1 = never timeout

    @return a Future that resolves to a hash with peer-style address information

    @par Example:
    @code{.py}
Future f = getnameinfo_async("127.0.0.1", AF_INET, 12345);
hash<auto> peer_info = f.get(100ms);
    @endcode

    @throw QOREADDRINFO-GETNAMEINFO-ERROR invalid address information
    @throw ASYNC-IO-ERROR the lookup could not be submitted to the global async I/O controller

    @since %Qore 3.0
 */
Future getnameinfo_async(string address, softint family = AF_INET, softint port = 0, timeout timeout = -1) [flags=NAMED_ARGS;dom=EXTERNAL_INFO] {
   struct sockaddr_storage sa;
   socklen_t len = 0;
   if (q_getnameinfo_sockaddr(xsink, address->c_str(), family, port, sa, len) < 0) {
      return QoreValue();
   }

   QoreFuture* future = qore_socket_resolve_nameinfo_asyncio_future(xsink, sa, len, timeout);
   return future ? qore_new_future_impl_object(getProgram(), future) : nullptr;
}

//! closes all possible file descriptors; useful in "daemon" processes that may have inherited open file descriptors
/** @par Platform Availability:
    @ref Qore::Option::HAVE_CLOSE_ALL_FD

    @param standard_fds if @ref True "True" then also stdin, stdout, and stderr are closed, otherwise fds > 2 are closed

    @par Example:
    @code{.py}
close_all_fd();
    @endcode

    @note if there are file descriptors open by Qore when this function is called, this function will also close those
    file descriptors; normally this function should only be used when starting a new process after a fork() and exec()
    to close any inherited descriptors, for example
 */
nothing close_all_fd(*softbool standard_fds) [flags=NAMED_ARGS;dom=PROCESS] {
#if defined(HAVE_UNISTD_H) && defined(_SC_OPEN_MAX)
    int start = standard_fds ? 0 : 3;
    // get max file descriptor
    int max = (int)sysconf(_SC_OPEN_MAX);
    printd(5, "close_all_fd() start: %d max: %d\n", start, max);

    int iter = 0;
    for (;start < max; ++start) {
        if (++iter % 100 == 0 && qore_check_cancel(xsink, "closing file descriptors")) {
            return QoreValue();
        }
        close(start);
    }
#else
    missing_function_error("close_all_fd", xsink);
#endif // HAVE_UNISTD
}

//! returns a list of network interfaces
/** @par Platform Availability:
    @ref Qore::Option::HAVE_GET_NETIF_LIST

    @par Example:
    @code{.py}
list<hash<NetIfInfo>> l = get_netif_list();

results for example into:
list: (8 elements)
  [0]=hash: (5 members)
    interface : "lo"
    address : "00:00:00:00:00:00"
    address_desc : "mac<00:00:00:00:00:00>"
    family : 17
    familystr : "mac"
  [1]=hash: (5 members)
    interface : "eth0"
    address : "44:8a:5b:ba:13:50"
    address_desc : "mac<44:8a:5b:ba:13:50>"
    family : 17
    familystr : "mac"
  [2]=hash: (5 members)
    interface : "lo"
    address : "127.0.0.1"
    address_desc : "ipv4(127.0.0.1)"
    family : 2
    familystr : "ipv4"
  [3]=hash: (5 members)
    interface : "eth0"
    address : "192.168.20.4"
    address_desc : "ipv4(192.168.20.4)"
    family : 2
    familystr : "ipv4"
  [4]=hash: (5 members)
    interface : "lo"
    address : "::1"
    address_desc : "ipv6[::1]"
    family : 10
    familystr : "ipv6"
  [5]=hash: (5 members)
    interface : "eth0"
    address : "fe80::213:3bff:fe0f:d5e1"
    address_desc : "ipv6[fe80::213:3bff:fe0f:d5e1]"
    family : 10
    familystr : "ipv6"
    @endcode

    @return returns a list of network interfaces available on the local machine
*/
list<hash<NetIfInfo>> get_netif_list() [dom=EXTERNAL_INFO] {
#ifdef HAVE_GETIFADDRS
    struct ifaddrs* ifap;
    if (getifaddrs(&ifap)) {
        xsink->raiseErrnoException("GETGETIFLIST-ERROR", errno, "getidaddrs() failed");
        return QoreValue();
    }
    ON_BLOCK_EXIT(freeifaddrs, ifap);

    ReferenceHolder<QoreListNode> rv(new QoreListNode(hashdeclNetIfInfo->getTypeInfo()), xsink);

    int iter = 0;
    for (struct ifaddrs* ifa = ifap; ifa; ifa = ifa->ifa_next) {
        if (++iter % 100 == 0 && qore_check_cancel(xsink, "building network interface list")) {
            return QoreValue();
        }
        // skip interfaces with no address
        if (!ifa->ifa_addr)
            continue;

        ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclNetIfInfo, xsink), xsink);
        qore_hash_private* hh = qore_hash_private::get(**h);

        hh->setKeyValueIntern("interface", new QoreStringNode(ifa->ifa_name));

        switch (ifa->ifa_addr->sa_family) {
            case AF_INET:
            case AF_INET6: {
                // get ipv4 or ipv6 address
                char ifname[INET6_ADDRSTRLEN];
                if (inet_ntop(ifa->ifa_addr->sa_family, qore_get_in_addr(ifa->ifa_addr), ifname, sizeof(ifname))) {
                    QoreStringNode* addrstr = new QoreStringNode(ifname);
                    hh->setKeyValueIntern("address", addrstr);
                    hh->setKeyValueIntern("address_desc", QoreAddrInfo::getAddressDesc(ifa->ifa_addr->sa_family, addrstr->c_str()));
                }
                break;
            }
#if defined(AF_PACKET) && defined(HAVE_LINUX_IF_PACKET_H)
            case AF_PACKET: {
                struct sockaddr_ll* s = (struct sockaddr_ll*)ifa->ifa_addr;
                QoreStringNode* addrstr = new QoreStringNode;
                for (unsigned i = 0; i < s->sll_halen; ++i) {
                    addrstr->sprintf("%02x%s", s->sll_addr[i], static_cast<int>(i) < (s->sll_halen - 1) ? ":" : "");
                }
                hh->setKeyValueIntern("address", addrstr);
                hh->setKeyValueIntern("address_desc", QoreAddrInfo::getAddressDesc(ifa->ifa_addr->sa_family, addrstr->c_str()));
                break;
            }
#endif
#if defined(HAVE_NET_IF_DL_H) && defined(HAVE_LINK_NTOA)
            case AF_LINK: {
                QoreStringNode* addrstr = new QoreStringNode(link_ntoa((struct sockaddr_dl*)ifa->ifa_addr));
                hh->setKeyValueIntern("address", addrstr);
                hh->setKeyValueIntern("address_desc", QoreAddrInfo::getAddressDesc(ifa->ifa_addr->sa_family, addrstr->c_str()));
                break;
            }
#endif
        }

         hh->setKeyValueIntern("family", ifa->ifa_addr->sa_family);
         hh->setKeyValueIntern("familystr", new QoreStringNode(QoreAddrInfo::getFamilyName(ifa->ifa_addr->sa_family)));

         rv->push(h.release(), xsink);
    }

    return rv.release();
#else
    missing_function_error("getifaddrs", xsink);
#endif
}

//! sets %Qore runtime library options
/** @param options the runtime options to set, binary-anded with @ref Qore::QLO_RUNTIME_OPTS; see
    @ref library_option_constants and @ref Qore::QLO_RUNTIME_OPTS "QLO_RUNTIME_OPTS" for more information

    @return the options used

    @see qore_get_library_options()

    @since %Qore 0.9.3.1
*/
int qore_set_library_options(int options) [flags=NAMED_ARGS;dom=PROCESS] {
    return qore_set_library_options(options);
}

//! returns all %Qore library options
/** @return all %Qore library options; see @ref library_option_constants for more information

    @see qore_set_library_options()

    @since %Qore 0.9.3.1
*/
int qore_get_library_options() [dom=PROCESS] {
    return qore_library_options;
}

//! Sets the global HTTP/2 mode that affects all new HTTP connections
/** @param mode the HTTP/2 mode string: \c "auto" (default), \c "disabled", or \c "required"

    Valid mode values:
    - \c "auto": Use HTTP/2 if available via ALPN negotiation, fallback to HTTP/1.1 (default)
    - \c "disabled": Never use HTTP/2, always use HTTP/1.x
    - \c "required": Always require HTTP/2, fail if the server does not support it

    This setting affects:
    - All new @ref Qore::HTTPClient "HTTPClient" connections
    - All new \c HttpServer connections
    - All HTTP-based connections including those via \c ConnectionProvider

    @note This function requires @ref Qore::DOM_PROCESS_CONTROL "DOM_PROCESS_CONTROL" rights (not available with
    @ref Qore::PO_NO_PROCESS_CONTROL "PO_NO_PROCESS_CONTROL")

    @throw SET-GLOBAL-HTTP2-MODE-ERROR invalid mode string

    @see set_global_http2_mode(enum<HTTP2Mode>)
    @see get_global_http2_mode()

    @since %Qore 3.0
*/
nothing set_global_http2_mode(string mode) [flags=NAMED_ARGS;dom=PROCESS] {
    const char* mode_str = mode->c_str();
    int mode_val;
    if (!strcasecmp(mode_str, "auto")) {
        mode_val = HTTP2_MODE_AUTO;
    } else if (!strcasecmp(mode_str, "disabled")) {
        mode_val = HTTP2_MODE_DISABLED;
    } else if (!strcasecmp(mode_str, "required")) {
        mode_val = HTTP2_MODE_REQUIRED;
    } else {
        xsink->raiseException("SET-GLOBAL-HTTP2-MODE-ERROR",
            "invalid HTTP/2 mode '%s'; valid modes are: 'auto', 'disabled', 'required'", mode_str);
        return QoreValue();
    }
    qore_global_http2_mode.store(mode_val, std::memory_order_relaxed);
}

//! Sets the global HTTP/2 mode that affects all new HTTP connections
/** @param mode the HTTP/2 mode: @ref Qore::HTTP2Mode "HTTP2Mode::Auto" (default),
    @ref Qore::HTTP2Mode "HTTP2Mode::Disabled", or @ref Qore::HTTP2Mode "HTTP2Mode::Required"

    @note This function requires @ref Qore::DOM_PROCESS_CONTROL "DOM_PROCESS_CONTROL" rights (not available with
    @ref Qore::PO_NO_PROCESS_CONTROL "PO_NO_PROCESS_CONTROL")

    @throw SET-GLOBAL-HTTP2-MODE-ERROR invalid mode value

    @see set_global_http2_mode(string)
    @see get_global_http2_mode()

    @since %Qore 3.0
*/
nothing set_global_http2_mode(enum<HTTP2Mode> mode) [flags=NAMED_ARGS;dom=PROCESS] {
    int64 mode_val = mode.getAsBigInt();
    if (mode_val < HTTP2_MODE_DISABLED || mode_val > HTTP2_MODE_REQUIRED) {
        xsink->raiseException("SET-GLOBAL-HTTP2-MODE-ERROR",
            "invalid HTTP/2 mode %d; valid modes are: HTTP2_MODE_DISABLED (0), HTTP2_MODE_AUTO (1), "
            "HTTP2_MODE_REQUIRED (2)", (int)mode_val);
        return QoreValue();
    }
    qore_global_http2_mode.store((int)mode_val, std::memory_order_relaxed);
}

//! Returns the current global HTTP/2 mode
/** @return the current global HTTP/2 mode as a string: \c "auto", \c "disabled", or \c "required"

    @see set_global_http2_mode()

    @since %Qore 3.0
*/
string get_global_http2_mode() [dom=PROCESS] {
    int mode = qore_global_http2_mode.load(std::memory_order_relaxed);
    switch (mode) {
        case HTTP2_MODE_DISABLED:
            return new QoreStringNode("disabled");
        case HTTP2_MODE_REQUIRED:
            return new QoreStringNode("required");
        default:
            return new QoreStringNode("auto");
    }
}

//! Adds the given module to the blacklist
/** @param name the name of the module
    @param message the message that will be included in any exception when the module is attempted to be loaded

    @return 0 = module added, -1 = module already loaded, cannot be blacklisted, -2 = module already in blacklist

    @since %Qore 2.0.1
*/
int qore_add_module_to_blacklist(string name, string message = "by an API call") [flags=NAMED_ARGS;dom=PROCESS] {
    TempEncodingHelper n(name, QCS_DEFAULT, xsink);
    if (*xsink) {
        return QoreValue();
    }
    TempEncodingHelper m(message, QCS_DEFAULT, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return QMM.addModuleToBlacklist(n->c_str(), m->c_str());
}

//! Adds the given module to the blacklist and throws an exception if here's an error
/** @param name the name of the module
    @param message the message that will be included in any exception when the module is attempted to be loaded

    @throw BLACKLIST-ERROR could not add module to blacklist

    If the given module is already in the blacklist, then no error is raised

    @since %Qore 2.0.1
*/
int qore_add_module_to_blacklist_ex(string name, string message = "by an API call") [flags=NAMED_ARGS;dom=PROCESS] {
    TempEncodingHelper n(name, QCS_DEFAULT, xsink);
    if (*xsink) {
        return QoreValue();
    }
    TempEncodingHelper m(message, QCS_DEFAULT, xsink);
    if (*xsink) {
        return QoreValue();
    }
    int rc_local = QMM.addModuleToBlacklist(n->c_str(), m->c_str());
    if (rc_local == -1) {
        xsink->raiseException("BLACKLIST-ERROR", "Cannot blacklist module \"%s\", as it is already loaded",
            n->c_str());
    }
}
///@}
