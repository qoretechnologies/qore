//! returns a list of group IDs that the user is a member of
/** @par Platform Availability:
    @ref Qore::Option::HAVE_UNIX_USERMGT

    @par Example:
    @code{.py}
list<int> l = getgroups();
    @endcode

    @return a list of group IDs that the user is a member of

    @since %Qore 0.8.11.1
*/
list<int> getgroups() [dom=EXTERNAL_INFO] {
#ifdef HAVE_GETGROUPS
   gid_t l[MAX_GIDS];

   int n = getgroups(MAX_GIDS, l);
   if (n == -1)
      return xsink->raiseErrnoException("GETGROUPS-ERROR", errno, "error calling getgroups()");

   QoreListNode* rv = new QoreListNode(bigIntTypeInfo);
   for (int i = 0; i < n; ++i) {
      rv->push(l[i], xsink);
   }
   return rv;
#else
   missing_function_error("getgroups", "UNIX_USERMGT", xsink);
#endif
}

//! sets the list of supplementary group IDs for the current process
/** @par Platform Availability:
    @ref Qore::Option::HAVE_UNIX_USERMGT

    @par Example:
    @code{.py}
setgroups(l);
    @endcode

    @param group_ids a list of supplementary group IDs for the current process

    @since %Qore 0.8.11.1
*/
nothing setgroups(softlist<softint> group_ids) [flags=NAMED_ARGS;dom=PROCESS] {
#ifdef HAVE_SETGROUPS
    if (group_ids->empty())
        return QoreValue();

#ifdef HAVE_LOCAL_VARIADIC_ARRAYS_X
    gid_t l[group_ids->size()];
#else
    gid_t* l = (gid_t*)malloc(sizeof(gid_t) * group_ids->size());
    if (!l) {
        xsink->outOfMemory();
        return QoreValue();
    }
    ON_BLOCK_EXIT(free, l);
#endif
    for (size_t i = 0, e = group_ids->size(); i < e; ++i) {
        if (i && !(i % 100) && qore_check_cancel(xsink, "preparing supplementary groups")) {
            return QoreValue();
        }
        l[i] = (int)group_ids->retrieveEntry(i).getAsBigInt();
    }
    if (setgroups(group_ids->size(), l))
        xsink->raiseErrnoException("SETGROUPS-ERROR", errno, "error calling setgroups()");
#else
    missing_function_error("setgroups", "UNIX_USERMGT", xsink);
#endif
}

//! Causes the current thread to sleep for a certain number of seconds
/** @param seconds The amount of time in seconds to sleep; integer arguments are interpreted literally as a number of seconds to sleep, however a @ref relative_dates "relative date/time value" can be given instead of an integer to make the source more readable (ex: \c 5s), however as this function only supports a resolution of 1 second, milliseconds and microseconds are ignored if passed in a @ref relative_dates "relative date/time value"

    @return should always return 0 for success, -1 if interrupted

    @par Example:
    @code{.py}
sleep(10s);
    @endcode

    @throw PROGRAM-INTERRUPTED this exception is thrown if the program has a @ref Qore::SandboxManager "SandboxManager" attached and @ref Qore::SandboxManager::requestInterrupt() "SandboxManager::requestInterrupt()" is called while the function is blocked; the function polls for interrupt requests every 100ms

    @see usleep() for a similar function supporting microsecond resolution

    @since %Qore 3.0 added support for interruption via @ref Qore::SandboxManager "SandboxManager"
 */
int sleep(softint seconds) [flags=NAMED_ARGS;dom=PROCESS] {
   if (!seconds) {
      return 0;
   }

   // Always poll in chunks for cancel/interrupt checking
   int64 remaining_usecs = seconds * 1000000ll;
   const int64 chunk_usecs = 100000ll; // 100ms chunks

   while (remaining_usecs > 0) {
      if (qore_check_cancel(xsink, "sleep")) {
         return -1;
      }

      int64 sleep_time = (remaining_usecs > chunk_usecs) ? chunk_usecs : remaining_usecs;
      int rc_local = qore_usleep(sleep_time);
      if (rc_local != 0) {
         return rc_local;
      }
      remaining_usecs -= sleep_time;
   }
   return 0;
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing sleep() [flags=RUNTIME_NOOP;dom=PROCESS] {
}

//! Causes the current thread to sleep for a certain number of microseconds
/** @param microseconds The amount of time in microseconds to sleep; integer arguments are interpreted literally as a number of microseconds to sleep

    @return should always return 0 for success, -1 if interrupted

    @par Example:
    @code{.py}
usleep(5000);
    @endcode

    @throw PROGRAM-INTERRUPTED this exception is thrown if the program has a @ref Qore::SandboxManager "SandboxManager" attached and @ref Qore::SandboxManager::requestInterrupt() "SandboxManager::requestInterrupt()" is called while the function is blocked; the function polls for interrupt requests every 100ms

    @see sleep() for a similar function supporting second resolution

    @note both sleep() and usleep() are implemented internally by calls to nanosleep() (2) if available on the current platform, otherwise both are implemented by calls to usleep() (3)

    @since %Qore 3.0 added support for interruption via @ref Qore::SandboxManager "SandboxManager"
 */
int usleep(softint microseconds) [flags=NAMED_ARGS;dom=PROCESS] {
   if (!microseconds) {
      return 0;
   }

   // Always poll in chunks for cancel/interrupt checking
   int64 remaining_usecs = microseconds;
   const int64 chunk_usecs = 100000ll; // 100ms chunks

   while (remaining_usecs > 0) {
      if (qore_check_cancel(xsink, "usleep")) {
         return -1;
      }

      int64 sleep_time = (remaining_usecs > chunk_usecs) ? chunk_usecs : remaining_usecs;
      int rc_local = qore_usleep(sleep_time);
      if (rc_local != 0) {
         return rc_local;
      }
      remaining_usecs -= sleep_time;
   }
   return 0;
}

//! Causes the current thread to sleep for a certain number of microseconds
/** @param duration A time value giving the amount of time in microseconds to sleep; this should be a @ref relative_dates "relative date/time value" to make the source more readable (ex: \c 250ms)

    @return should always return 0 for success, -1 if interrupted

    @par Example:
    @code{.py}
usleep(250ms);
    @endcode

    @throw PROGRAM-INTERRUPTED this exception is thrown if the program has a @ref Qore::SandboxManager "SandboxManager" attached and @ref Qore::SandboxManager::requestInterrupt() "SandboxManager::requestInterrupt()" is called while the function is blocked; the function polls for interrupt requests every 100ms

    @see sleep() for a similar function supporting second resolution

    @note both sleep() and usleep() are implemented internally by calls to nanosleep() (2) if available on the current platform, otherwise both are implemented by calls to usleep() (3)

    @since %Qore 3.0 added support for interruption via @ref Qore::SandboxManager "SandboxManager"
 */
int usleep(date duration) [flags=NAMED_ARGS;dom=PROCESS] {
   int64 usecs = duration->getRelativeMicroseconds();
   if (!usecs) {
      return 0;
   }

   // Always poll in chunks for cancel/interrupt checking
   int64 remaining_usecs = usecs;
   const int64 chunk_usecs = 100000ll; // 100ms chunks

   while (remaining_usecs > 0) {
      if (qore_check_cancel(xsink, "usleep")) {
         return -1;
      }

      int64 sleep_time = (remaining_usecs > chunk_usecs) ? chunk_usecs : remaining_usecs;
      int rc_local = qore_usleep(sleep_time);
      if (rc_local != 0) {
         return rc_local;
      }
      remaining_usecs -= sleep_time;
   }
   return 0;
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing usleep() [flags=RUNTIME_NOOP;dom=PROCESS] {
}

