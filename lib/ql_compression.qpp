#ifndef QORE_BZ2_WORK_FACTOR
#define QORE_BZ2_WORK_FACTOR 30
#endif

#ifndef QORE_BZ2_VERBOSITY
#define QORE_BZ2_VERBOSITY 0
#endif

#ifndef BZ2_DEFAULT_COMPRESSION
#define BZ2_DEFAULT_COMPRESSION 3
#endif

#define COMPRESSION_LEVEL_DEFAULT CompressionTransforms::LEVEL_DEFAULT

// The smallest initial output buffer of a one-shot decompression
static constexpr size_t DECOMPRESSION_MIN_INITIAL_SIZE = 1024;

void qore_raise_decompression_limit_exceeded(const char* alg, size_t max_size, ExceptionSink* xsink) {
    xsink->raiseException("DECOMPRESSION-LIMIT-EXCEEDED", "%s decompressed data exceeds the maximum size of %lld "
        "byte%s", alg, static_cast<int64>(max_size), max_size == 1 ? "" : "s");
}

int qore_check_decompression_max_size(int64 max_size, ExceptionSink* xsink) {
    if (max_size < 0) {
        xsink->raiseException("DECOMPRESSION-LIMIT-ERROR", "the maximum decompressed size must not be negative "
            "(value passed: %lld)", max_size);
        return -1;
    }
    return 0;
}

// The output buffer of a one-shot decompression, bounded by an optional maximum decompressed size
/* The buffer never grows beyond the maximum size plus one byte; the extra byte detects output beyond the
    maximum without decompressing any further, so a small input that expands to a huge output never allocates more
    than the maximum.
*/
class DecompressionOutput {
public:
    /* @param alg the name of the algorithm for exception messages
        @param max_size the maximum decompressed size in bytes; 0 = no limit
        @param initial_size the size of the first allocation
    */
    DLLLOCAL DecompressionOutput(const char* alg, size_t max_size, size_t initial_size) : alg(alg),
            max_size(max_size) {
        setInitialSize(initial_size);
    }

    DLLLOCAL ~DecompressionOutput() {
        free(buf);
    }

    // Sets the size of the first allocation; must be called before reserve()
    DLLLOCAL void setInitialSize(size_t size) {
        assert(!buf);
        initial_size = size ? size : 1;
        if (max_size && initial_size > max_size) {
            initial_size = max_size + 1;
        }
    }

    // Returns true if the given number of decompressed bytes exceeds the maximum size
    DLLLOCAL bool exceedsMaxSize(unsigned long long size) const {
        return max_size && size > max_size;
    }

    // Raises the exception for decompressed data that exceeds the maximum size
    DLLLOCAL void raiseMaxSizeExceeded(ExceptionSink* xsink) const {
        qore_raise_decompression_limit_exceeded(alg, max_size, xsink);
    }

    // Returns the position for the next decompressed byte
    DLLLOCAL char* next() const {
        return buf + used;
    }

    // Returns the free space in the buffer
    DLLLOCAL size_t avail() const {
        return cap - used;
    }

    // Ensures that the buffer has free space
    /* @return 0 for OK, -1 if an exception was raised
    */
    DLLLOCAL int reserve(ExceptionSink* xsink) {
        if (used < cap) {
            return 0;
        }
        // a full buffer at the limit has already raised an exception in produced()
        assert(!max_size || cap <= max_size);
        size_t ncap;
        if (!cap) {
            ncap = initial_size;
        } else {
            ncap = cap * 2;
            if (ncap < cap) {
                xsink->outOfMemory();
                return -1;
            }
        }
        if (max_size && ncap > max_size) {
            ncap = max_size + 1;
        }
        void* p = realloc(buf, ncap);
        if (!p) {
            xsink->outOfMemory();
            return -1;
        }
        buf = static_cast<char*>(p);
        cap = ncap;
        return 0;
    }

    // Records decompressed bytes written at next()
    /* @return 0 for OK, -1 if the output exceeds the maximum size (an exception has been raised)
    */
    DLLLOCAL int produced(size_t n, ExceptionSink* xsink) {
        assert(n <= avail());
        used += n;
        if (exceedsMaxSize(used)) {
            raiseMaxSizeExceeded(xsink);
            return -1;
        }
        return 0;
    }

    // Returns the decompressed data as a binary object and releases the buffer
    DLLLOCAL BinaryNode* takeBinary() {
        // release the unused part of the buffer, which can be as large as the data
        if (buf && used < cap) {
            if (!used) {
                free(buf);
                buf = nullptr;
            } else if (void* p = realloc(buf, used)) {
                buf = static_cast<char*>(p);
            }
        }
        BinaryNode* rv = new BinaryNode(buf, used);
        buf = nullptr;
        cap = used = 0;
        return rv;
    }

    // Returns the decompressed data as a string and releases the buffer
    DLLLOCAL QoreStringNode* takeString(const QoreEncoding* enc) {
        if (!buf) {
            return new QoreStringNode(enc);
        }
        // passing the length as the allocated size makes the constructor add the terminator
        QoreStringNode* rv = new QoreStringNode(buf, used, used, enc);
        buf = nullptr;
        cap = used = 0;
        return rv;
    }

private:
    const char* alg;
    size_t max_size;
    size_t initial_size = 1;
    char* buf = nullptr;
    size_t cap = 0;
    size_t used = 0;
};

// Returns the initial output buffer size for a one-shot decompression from the compressed size
static size_t get_initial_decompression_size(size_t compressed_size, size_t factor) {
    if (compressed_size > (SIZE_MAX / 2 - DECOMPRESSION_MIN_INITIAL_SIZE) / factor) {
        return SIZE_MAX / 2;
    }
    return compressed_size * factor + DECOMPRESSION_MIN_INITIAL_SIZE;
}

// Returns a length clamped to the range of the 32-bit length fields of the zlib and bzip2 APIs
static unsigned api_len(size_t len) {
    return len > UINT_MAX ? UINT_MAX : static_cast<unsigned>(len);
}

extern QoreClass* QC_TRANSFORM;

class qore_bz_stream : public bz_stream {
public:
   DLLLOCAL qore_bz_stream() {
      bzalloc = 0;
      bzfree = 0;
      opaque = 0;
   }
};

class qore_bz_compressor : public qore_bz_stream {
   bool ok;

public:
   DLLLOCAL qore_bz_compressor(int level, ExceptionSink* xsink) {
      int rc = BZ2_bzCompressInit(this, level, QORE_BZ2_VERBOSITY, QORE_BZ2_WORK_FACTOR);
      ok = (rc == BZ_OK);
      if (!ok)
	 xsink->raiseException("BZIP2-COMPRESS-ERROR", "code %d returned from BZ2_bzCompressInit()", rc);
   }

   DLLLOCAL ~qore_bz_compressor() {
      if (ok)
	 BZ2_bzCompressEnd(this);
   }
   DLLLOCAL operator bool() const { return ok; }

   DLLLOCAL BinaryNode* compress(const void* ptr, unsigned long len, ExceptionSink* xsink) {
      char* p = (char*)ptr;

      size_t bs = len >> 3;
      if (!bs)
	 bs = 1;

      next_in = p;
      avail_in = len;

      SimpleRefHolder<BinaryNode> b(new BinaryNode);

      if (b->preallocate(bs)) {
	 xsink->outOfMemory();
	 return 0;
      }

      int iter = 0;
      while (true) {
         if (++iter % 10 == 0 && qore_check_cancel(xsink, "compressing bzip2 data")) {
            return nullptr;
         }
	 int64 done = (int64)total_out_lo32 + (((int64)total_out_hi32) << 32);
	 next_out = ((char*)b->getPtr()) + done;
	 avail_out = (unsigned)(bs - done);

	 int rc = BZ2_bzCompress(this, BZ_FINISH);
	 //printd(5, "bs: %lld, done: %lld, avail_out: %d, rc: %d, total_out_lo32: %d, total_out_hi32 = %d\n", bs, done, avail_out, rc, total_out_lo32, total_out_hi32);
	 if (rc == BZ_STREAM_END)
	    break;
	 if (rc != BZ_FINISH_OK) {
	    xsink->raiseException("BZIP2-COMPRESS-ERROR", "error code %d returned from BZ2_bzCompress()", rc);
	    return 0;
	 }
	 bs *= 2;
         // if we get over size of an int, then we have to abort, since avail_out is an unsigned_int
         if ((bs - done) > UINT_MAX) {
	    xsink->raiseException("BZIP2-COMPRESS-ERROR", "the bzip2 library requested a buffer that is too large to be handled by the API");
	    return 0;
         }

	 if (b->preallocate(bs)) {
	    xsink->raiseException("BZIP2-COMPRESS-ERROR", "the bzip2 library requested a buffer that is too large to be handled by the API");
	    return 0;
	 }
      }
      b->setSize((int64)total_out_lo32 + (((int64)total_out_hi32) << 32));

      return b.release();
   }
};

class qore_bz_decompressor : public qore_bz_stream {
    bool ok;

public:
    DLLLOCAL qore_bz_decompressor(ExceptionSink* xsink) {
        int rc = BZ2_bzDecompressInit(this, QORE_BZ2_VERBOSITY, 0);
        ok = (rc == BZ_OK);
        if (!ok)
            xsink->raiseException("BZIP2-DECOMPRESS-ERROR", "code %d returned from BZ2_bzDecompressInit()", rc);
    }

    DLLLOCAL ~qore_bz_decompressor() {
        if (ok)
            BZ2_bzDecompressEnd(this);
    }
    DLLLOCAL operator bool() const { return ok; }

    // Decompresses bzip2 data into the given buffer
    /* @return 0 for OK, -1 if an exception was raised
    */
    DLLLOCAL int decompress(DecompressionOutput& out, const void* ptr, size_t len, ExceptionSink* xsink) {
        next_in = static_cast<char*>(const_cast<void*>(ptr));
        avail_in = api_len(len);
        size_t remaining = len - avail_in;

        int iter = 0;
        while (true) {
            if (++iter % 10 == 0 && qore_check_cancel(xsink, "decompressing bzip2 data")) {
                return -1;
            }
            if (!avail_in && remaining) {
                avail_in = api_len(remaining);
                remaining -= avail_in;
            }
            if (out.reserve(xsink)) {
                return -1;
            }
            unsigned avail = api_len(out.avail());
            next_out = out.next();
            avail_out = avail;

            int rc = BZ2_bzDecompress(this);
            //printd(5, "avail_out: %d, rc: %d\n", avail_out, rc);
            if (rc != BZ_OK && rc != BZ_STREAM_END) {
                xsink->raiseException("BZIP2-DECOMPRESS-ERROR", "error code %d returned from BZ2_bzDecompress()", rc);
                return -1;
            }
            if (out.produced(avail - avail_out, xsink)) {
                return -1;
            }
            if (rc == BZ_STREAM_END) {
                break;
            }
            // all input consumed with free output space left: the stream has not ended
            if (!avail_in && !remaining && avail_out) {
                xsink->raiseException("BZIP2-DECOMPRESS-ERROR", "Unexpected end of compressed data");
                return -1;
            }
        }
        if (avail_in || remaining) {
            xsink->raiseException("BZIP2-DECOMPRESS-ERROR", "Unexpected bytes at the end of compressed data");
            return -1;
        }
        return 0;
    }
};

BinaryNode* qore_bzip2(const void* ptr, unsigned long len, int level, ExceptionSink* xsink) {
    qore_bz_compressor c(level, xsink);
    if (!c) {
        return nullptr;
    }

    return c.compress(ptr, len, xsink);
}

BinaryNode* qore_bunzip2_to_binary(const BinaryNode* b, ExceptionSink* xsink) {
    return qore_bunzip2_to_binary(b, 0, xsink);
}

BinaryNode* qore_bunzip2_to_binary(const BinaryNode* b, size_t max_size, ExceptionSink* xsink) {
    qore_bz_decompressor c(xsink);
    if (!c) {
        return nullptr;
    }

    DecompressionOutput out("bzip2", max_size, get_initial_decompression_size(b->size(), 2));
    return c.decompress(out, b->getPtr(), b->size(), xsink) ? nullptr : out.takeBinary();
}

QoreStringNode* qore_bunzip2_to_string(const BinaryNode* b, const QoreEncoding* enc, ExceptionSink* xsink) {
    return qore_bunzip2_to_string(b, enc, 0, xsink);
}

QoreStringNode* qore_bunzip2_to_string(const BinaryNode* b, const QoreEncoding* enc, size_t max_size,
        ExceptionSink* xsink) {
    qore_bz_decompressor c(xsink);
    if (!c) {
        return nullptr;
    }

    DecompressionOutput out("bzip2", max_size, get_initial_decompression_size(b->size(), 2));
    return c.decompress(out, b->getPtr(), b->size(), xsink) ? nullptr : out.takeString(enc);
}

#ifdef HAVE_GZ_HEADER
class qore_gz_header : public gz_header {
   DLLLOCAL qore_gz_header(bool n_text, char* n_name, char* n_comment) {
      text = n_text;
      time = ::time(0);
      xflags = 0;
      os = 3; // always set to UNIX
      extra = Z_NULL;
      extra_len = 0;
      extra_max = 0;
      name = (Bytef*)n_name;
      name_max = 0;
      comment = (Bytef*)n_comment;
      comm_max = 0;
      hcrc = 0;
      done = 0;
   }
};
#endif

static void do_zlib_exception(int rc, const char* func, ExceptionSink* xsink) {
   QoreStringNode* desc = new QoreStringNode();
   desc->sprintf("%s(): ", func);
   switch (rc) {
      case Z_ERRNO:
	 q_strerror(*desc, errno);
         break;

      case Z_STREAM_ERROR:
         desc->concat("inconsistent stream state");
         break;

      case Z_DATA_ERROR:
         desc->set("unable to process input data; data corrupted");
         break;

      case Z_MEM_ERROR:
         desc->set("insufficient memory to complete operation");
         break;

      case Z_BUF_ERROR:
         desc->set("qore buffer-handling error (report as bug to qore developers)");
         break;

      case Z_VERSION_ERROR:
         desc->set("version mismatch on zlib shared library, check library requirements");
         break;

      default:
         desc->sprintf("error code %d encountered", rc);
         break;
   }
   xsink->raiseException("ZLIB-ERROR", desc);
}

static void do_deflate_end(z_stream* c_stream, ExceptionSink* xsink) {
   int rc = deflateEnd(c_stream);
   if (rc != Z_OK)
      do_zlib_exception(rc, "deflateEnd", xsink);
}

static void do_inflate_end(z_stream* d_stream, ExceptionSink* xsink) {
   int rc = inflateEnd(d_stream);
   if (rc != Z_OK)
      do_zlib_exception(rc, "inflateEnd", xsink);
}

static BinaryNode* qore_deflate_intern(const void* ptr, unsigned long len, int level, bool gzipFormat, ExceptionSink* xsink) {
   z_stream c_stream; // compression stream
   c_stream.zalloc = Z_NULL;
   c_stream.zfree = Z_NULL;
   c_stream.opaque = Z_NULL;
   c_stream.next_in = (Bytef*)ptr;
   c_stream.avail_in = len;

   int rc = deflateInit2(&c_stream, level, Z_DEFLATED, 15 + (gzipFormat ? 16 : 0), 8, Z_DEFAULT_STRATEGY);
   if (rc != Z_OK) {
      do_zlib_exception(rc, "deflateInit2", xsink);
      return 0;
   }

   ON_BLOCK_EXIT(do_deflate_end, &c_stream, xsink);

   // allocate new buffer
   unsigned long bsize = len / 5 + 100;
   void* buf = malloc(bsize);

   c_stream.next_out = (Bytef*)buf;
   c_stream.avail_out = bsize;

   int iter = 0;
   while (c_stream.avail_in) {
      if (++iter % 10 == 0 && qore_check_cancel(xsink, "compressing zlib data")) {
         free(buf);
         return nullptr;
      }
      rc = deflate(&c_stream, Z_NO_FLUSH);
      if (rc != Z_OK && rc != Z_BUF_ERROR) {
         free(buf);
         do_zlib_exception(rc, "deflate", xsink);
         return 0;
      }

      if (!c_stream.avail_out) {
         int new_space = ((len / 3) + 100);
         //printd(5, "deflate() Z_BUF_ERROR:1 bsize: %d->%d, new_space: %d avail_out: %d -> %d next_out: %p\n", bsize, bsize + new_space, new_space, c_stream.avail_out, c_stream.avail_out + new_space, c_stream.next_out);

         bsize += new_space;
         c_stream.avail_out += new_space;
         buf = realloc(buf, bsize);
         c_stream.next_out = ((Bytef*)buf) + c_stream.total_out;
      }
      //printd(5, "deflate() Z_BUF_ERROR:1 bsize: %d, avail_out: %d, next_out: %p\n", bsize, c_stream.avail_out, c_stream.next_out);
   }

   while (true) {
      if (++iter % 10 == 0 && qore_check_cancel(xsink, "compressing zlib data")) {
         free(buf);
         return nullptr;
      }
      rc = deflate(&c_stream, Z_FINISH);
      if (rc == Z_STREAM_END)
         break;
      if (rc != Z_OK && rc != Z_BUF_ERROR) {
         free(buf);
         do_zlib_exception(rc, "deflate", xsink);
         return 0;
      }
      // resize buffer
      int new_space = 2; //((len / 3) + 100);
      //printd(5, "deflate() Z_BUF_ERROR:2 bsize: %d->%d, new_space: %d avail_out: %d -> %d, next_out: %p\n", bsize, bsize + new_space, new_space, c_stream.avail_out, c_stream.avail_out + new_space, c_stream.next_out);

      bsize += new_space;
      c_stream.avail_out += new_space;
      buf = realloc(buf, bsize);
      c_stream.next_out = ((Bytef*)buf) + c_stream.total_out;
   }

   //printd(5, "deflate() buf: %p, bsize: %d, avail_out: %d, size: %d, next_out: %p\n", buf, bsize, c_stream.avail_out, bsize - c_stream.avail_out, c_stream.next_out);
   return new BinaryNode(buf, bsize - c_stream.avail_out);
}

// Decompresses zlib, gzip, or raw DEFLATE data
/* @param out the output buffer
    @param b the compressed data
    @param window_bits the window bits for inflateInit2(); negative for raw DEFLATE
    @param raw true for raw DEFLATE data, which has no trailer: the data may end at any block boundary, as with the
    RFC 7692 permessage-deflate WebSocket extension, where a message ends with a sync flush and not with a final
    block, and bytes after the end of the stream are ignored
    @param xsink exception sink

    @return 0 for OK, -1 if an exception was raised
*/
static int qore_inflate_intern(DecompressionOutput& out, const BinaryNode* b, int window_bits, bool raw,
        ExceptionSink* xsink) {
    z_stream d_stream; // decompression stream
    d_stream.zalloc = Z_NULL;
    d_stream.zfree = Z_NULL;
    d_stream.opaque = Z_NULL;
    d_stream.next_in = const_cast<Bytef*>(static_cast<const Bytef*>(b->getPtr()));
    d_stream.avail_in = api_len(b->size());
    size_t remaining = b->size() - d_stream.avail_in;

    int rc = inflateInit2(&d_stream, window_bits);
    if (rc != Z_OK) {
        do_zlib_exception(rc, "inflateInit2", xsink);
        return -1;
    }

    ON_BLOCK_EXIT(do_inflate_end, &d_stream, xsink);

    const char* desc = raw ? "decompressing raw deflate data" : "decompressing zlib data";
    int iter = 0;
    while (true) {
        if (++iter % 10 == 0 && qore_check_cancel(xsink, desc)) {
            return -1;
        }
        if (!d_stream.avail_in && remaining) {
            d_stream.avail_in = api_len(remaining);
            remaining -= d_stream.avail_in;
        }
        if (out.reserve(xsink)) {
            return -1;
        }
        unsigned avail = api_len(out.avail());
        d_stream.next_out = reinterpret_cast<Bytef*>(out.next());
        d_stream.avail_out = avail;

        rc = inflate(&d_stream, Z_NO_FLUSH);
        if (rc != Z_OK && rc != Z_STREAM_END && rc != Z_BUF_ERROR) {
            do_zlib_exception(rc, "inflate", xsink);
            return -1;
        }
        if (out.produced(avail - d_stream.avail_out, xsink)) {
            return -1;
        }
        if (rc == Z_STREAM_END) {
            break;
        }
        // all input consumed with free output space left: the stream has not ended
        if (!d_stream.avail_in && !remaining && d_stream.avail_out) {
            // raw DEFLATE data may end at a block boundary
            if (raw && (d_stream.data_type & 128)) {
                return 0;
            }
            xsink->raiseException("ZLIB-ERROR", "Unexpected end of compressed data");
            return -1;
        }
    }

    // raw DEFLATE data may be followed by other bytes; see RFC 7692
    if (!raw && (d_stream.avail_in || remaining)) {
        xsink->raiseException("ZLIB-ERROR", "Unexpected bytes at the end of compressed data");
        return -1;
    }
    return 0;
}

// The zlib window bits for zlib or gzip data
static int get_inflate_window_bits(bool gzip_format) {
    return 15 + (gzip_format ? 16 : 0);
}

// The zlib window bits for raw DEFLATE data (no zlib or gzip header or trailer)
static constexpr int INFLATE_RAW_WINDOW_BITS = -15;

// Decompresses zlib, gzip, or raw DEFLATE data to a binary object
static BinaryNode* qore_inflate_to_binary_intern(const char* alg, const BinaryNode* b, int window_bits, bool raw,
        size_t max_size, ExceptionSink* xsink) {
    DecompressionOutput out(alg, max_size, get_initial_decompression_size(b->size(), 2));
    return qore_inflate_intern(out, b, window_bits, raw, xsink) ? nullptr : out.takeBinary();
}

// Decompresses zlib, gzip, or raw DEFLATE data to a string
static QoreStringNode* qore_inflate_to_string_intern(const char* alg, const BinaryNode* b, int window_bits, bool raw,
        const QoreEncoding* enc, size_t max_size, ExceptionSink* xsink) {
    DecompressionOutput out(alg, max_size, get_initial_decompression_size(b->size(), 2));
    return qore_inflate_intern(out, b, window_bits, raw, xsink) ? nullptr : out.takeString(enc);
}

BinaryNode* qore_deflate(const void* ptr, unsigned long len, int level, ExceptionSink* xsink) {
    return qore_deflate_intern(ptr, len, level, false, xsink);
}

QoreStringNode* qore_inflate_to_string(const BinaryNode* b, const QoreEncoding* enc, ExceptionSink* xsink) {
    return qore_inflate_to_string(b, enc, 0, xsink);
}

QoreStringNode* qore_inflate_to_string(const BinaryNode* b, const QoreEncoding* enc, size_t max_size,
        ExceptionSink* xsink) {
    return qore_inflate_to_string_intern("zlib", b, get_inflate_window_bits(false), false, enc, max_size, xsink);
}

BinaryNode* qore_inflate_to_binary(const BinaryNode* b, ExceptionSink* xsink) {
    return qore_inflate_to_binary(b, 0, xsink);
}

BinaryNode* qore_inflate_to_binary(const BinaryNode* b, size_t max_size, ExceptionSink* xsink) {
    return qore_inflate_to_binary_intern("zlib", b, get_inflate_window_bits(false), false, max_size, xsink);
}

BinaryNode* qore_gzip(const void* ptr, unsigned long len, int level, ExceptionSink* xsink) {
    return qore_deflate_intern(ptr, len, level, true, xsink);
}

QoreStringNode* qore_gunzip_to_string(const BinaryNode* bin, const QoreEncoding* enc, ExceptionSink* xsink) {
    return qore_gunzip_to_string(bin, enc, 0, xsink);
}

QoreStringNode* qore_gunzip_to_string(const BinaryNode* bin, const QoreEncoding* enc, size_t max_size,
        ExceptionSink* xsink) {
    return qore_inflate_to_string_intern("gzip", bin, get_inflate_window_bits(true), false, enc, max_size, xsink);
}

BinaryNode* qore_gunzip_to_binary(const BinaryNode* bin, ExceptionSink* xsink) {
    return qore_gunzip_to_binary(bin, 0, xsink);
}

BinaryNode* qore_gunzip_to_binary(const BinaryNode* bin, size_t max_size, ExceptionSink* xsink) {
    return qore_inflate_to_binary_intern("gzip", bin, get_inflate_window_bits(true), false, max_size, xsink);
}

// Raw DEFLATE compression (windowBits = -15, no zlib/gzip header or trailer)
// Used by RFC 7692 permessage-deflate WebSocket extension
static BinaryNode* qore_deflate_raw_intern(const void* ptr, unsigned long len, int level, ExceptionSink* xsink) {
    z_stream c_stream; // compression stream
    c_stream.zalloc = Z_NULL;
    c_stream.zfree = Z_NULL;
    c_stream.opaque = Z_NULL;
    c_stream.next_in = (Bytef*)ptr;
    c_stream.avail_in = len;

    // windowBits = -15 produces raw deflate output (no zlib/gzip header or trailer)
    int rc = deflateInit2(&c_stream, level, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY);
    if (rc != Z_OK) {
        do_zlib_exception(rc, "deflateInit2", xsink);
        return nullptr;
    }

    ON_BLOCK_EXIT(do_deflate_end, &c_stream, xsink);

    // allocate new buffer
    unsigned long bsize = len / 5 + 100;
    void* buf = malloc(bsize);

    c_stream.next_out = (Bytef*)buf;
    c_stream.avail_out = bsize;

    int iter = 0;
    while (c_stream.avail_in) {
        if (++iter % 10 == 0 && qore_check_cancel(xsink, "compressing raw deflate data")) {
            free(buf);
            return nullptr;
        }
        rc = deflate(&c_stream, Z_NO_FLUSH);
        if (rc != Z_OK && rc != Z_BUF_ERROR) {
            free(buf);
            do_zlib_exception(rc, "deflate", xsink);
            return nullptr;
        }

        if (!c_stream.avail_out) {
            int new_space = ((len / 3) + 100);
            bsize += new_space;
            c_stream.avail_out += new_space;
            buf = realloc(buf, bsize);
            c_stream.next_out = ((Bytef*)buf) + c_stream.total_out;
        }
    }

    while (true) {
        if (++iter % 10 == 0 && qore_check_cancel(xsink, "compressing raw deflate data")) {
            free(buf);
            return nullptr;
        }
        rc = deflate(&c_stream, Z_FINISH);
        if (rc == Z_STREAM_END)
            break;
        if (rc != Z_OK && rc != Z_BUF_ERROR) {
            free(buf);
            do_zlib_exception(rc, "deflate", xsink);
            return nullptr;
        }
        // resize buffer
        int new_space = 2;
        bsize += new_space;
        c_stream.avail_out += new_space;
        buf = realloc(buf, bsize);
        c_stream.next_out = ((Bytef*)buf) + c_stream.total_out;
    }

    return new BinaryNode(buf, bsize - c_stream.avail_out);
}

BinaryNode* qore_deflate_raw(const void* ptr, unsigned long len, int level, ExceptionSink* xsink) {
    return qore_deflate_raw_intern(ptr, len, level, xsink);
}

QoreStringNode* qore_inflate_raw_to_string(const BinaryNode* b, const QoreEncoding* enc, size_t max_size,
        ExceptionSink* xsink) {
    return qore_inflate_to_string_intern("raw deflate", b, INFLATE_RAW_WINDOW_BITS, true, enc, max_size, xsink);
}

BinaryNode* qore_inflate_raw_to_binary(const BinaryNode* b, size_t max_size, ExceptionSink* xsink) {
    return qore_inflate_to_binary_intern("raw deflate", b, INFLATE_RAW_WINDOW_BITS, true, max_size, xsink);
}

BinaryNode* qore_brotli(const void* ptr, unsigned long len, int quality, ExceptionSink* xsink) {
    // Calculate maximum compressed size
    size_t max_compressed_size = BrotliEncoderMaxCompressedSize(len);
    if (max_compressed_size == 0) {
        // For very large inputs, use a reasonable estimate
        max_compressed_size = len + (len >> 2) + 10240;
    }

    SimpleRefHolder<BinaryNode> b(new BinaryNode);
    if (b->preallocate(max_compressed_size)) {
        xsink->outOfMemory();
        return nullptr;
    }

    size_t encoded_size = max_compressed_size;
    BROTLI_BOOL result = BrotliEncoderCompress(
        quality,
        BROTLI_DEFAULT_WINDOW,
        BROTLI_DEFAULT_MODE,
        len,
        static_cast<const uint8_t*>(ptr),
        &encoded_size,
        static_cast<uint8_t*>(const_cast<void*>(b->getPtr()))
    );

    if (!result) {
        xsink->raiseException("BROTLI-ERROR", "Brotli compression failed");
        return nullptr;
    }

    b->setSize(encoded_size);
    return b.release();
}

// Decompresses Brotli data
/* @return 0 for OK, -1 if an exception was raised
*/
static int qore_unbrotli_intern(DecompressionOutput& out, const BinaryNode* b, ExceptionSink* xsink) {
    BrotliDecoderState* state = BrotliDecoderCreateInstance(nullptr, nullptr, nullptr);
    if (!state) {
        xsink->raiseException("BROTLI-ERROR", "failed to create Brotli decoder instance");
        return -1;
    }
    ON_BLOCK_EXIT(BrotliDecoderDestroyInstance, state);

    const uint8_t* next_in = static_cast<const uint8_t*>(b->getPtr());
    size_t avail_in = b->size();

    int iter = 0;
    while (true) {
        if (++iter % 10 == 0 && qore_check_cancel(xsink, "decompressing Brotli data")) {
            return -1;
        }
        if (out.reserve(xsink)) {
            return -1;
        }
        size_t avail = out.avail();
        uint8_t* next_out = reinterpret_cast<uint8_t*>(out.next());
        size_t avail_out = avail;

        BrotliDecoderResult result = BrotliDecoderDecompressStream(state, &avail_in, &next_in, &avail_out,
            &next_out, nullptr);
        if (result == BROTLI_DECODER_RESULT_ERROR) {
            xsink->raiseException("BROTLI-ERROR", "Brotli decompression failed: %s",
                BrotliDecoderErrorString(BrotliDecoderGetErrorCode(state)));
            return -1;
        }
        if (out.produced(avail - avail_out, xsink)) {
            return -1;
        }
        if (result == BROTLI_DECODER_RESULT_SUCCESS) {
            break;
        }
        if (result == BROTLI_DECODER_RESULT_NEEDS_MORE_INPUT) {
            xsink->raiseException("BROTLI-ERROR", "Unexpected end of compressed data");
            return -1;
        }
        assert(result == BROTLI_DECODER_RESULT_NEEDS_MORE_OUTPUT);
    }

    if (avail_in) {
        xsink->raiseException("BROTLI-ERROR", "Unexpected bytes at the end of compressed data");
        return -1;
    }
    return 0;
}

BinaryNode* qore_unbrotli_to_binary(const BinaryNode* b, size_t max_size, ExceptionSink* xsink) {
    DecompressionOutput out("Brotli", max_size, get_initial_decompression_size(b->size(), 4));
    return qore_unbrotli_intern(out, b, xsink) ? nullptr : out.takeBinary();
}

QoreStringNode* qore_unbrotli_to_string(const BinaryNode* b, const QoreEncoding* enc, size_t max_size,
        ExceptionSink* xsink) {
    DecompressionOutput out("Brotli", max_size, get_initial_decompression_size(b->size(), 4));
    return qore_unbrotli_intern(out, b, xsink) ? nullptr : out.takeString(enc);
}

BinaryNode* qore_zstd(const void* ptr, unsigned long len, int level, ExceptionSink* xsink) {
    // Calculate maximum compressed size
    size_t max_compressed_size = ZSTD_compressBound(len);

    SimpleRefHolder<BinaryNode> b(new BinaryNode);
    if (b->preallocate(max_compressed_size)) {
        xsink->outOfMemory();
        return nullptr;
    }

    size_t compressed_size = ZSTD_compress(
        const_cast<void*>(b->getPtr()),
        max_compressed_size,
        ptr,
        len,
        level
    );

    if (ZSTD_isError(compressed_size)) {
        xsink->raiseException("ZSTD-ERROR", "Zstd compression failed: %s",
            ZSTD_getErrorName(compressed_size));
        return nullptr;
    }

    b->setSize(compressed_size);
    return b.release();
}

// Decompresses Zstd data, which may consist of several frames
/* @return 0 for OK, -1 if an exception was raised
*/
static int qore_unzstd_intern(DecompressionOutput& out, const BinaryNode* b, ExceptionSink* xsink) {
    // the frame header may declare the decompressed size of the first frame
    unsigned long long content_size = ZSTD_getFrameContentSize(b->getPtr(), b->size());
    if (content_size == ZSTD_CONTENTSIZE_ERROR) {
        xsink->raiseException("ZSTD-ERROR", "Invalid Zstd frame header");
        return -1;
    }
    if (content_size == ZSTD_CONTENTSIZE_UNKNOWN) {
        out.setInitialSize(get_initial_decompression_size(b->size(), 4));
    } else {
        // the decoder verifies the declared size, so data that declares more than the maximum exceeds it
        if (out.exceedsMaxSize(content_size)) {
            out.raiseMaxSizeExceeded(xsink);
            return -1;
        }
        out.setInitialSize(content_size > SIZE_MAX / 2 ? SIZE_MAX / 2 : static_cast<size_t>(content_size));
    }

    ZSTD_DStream* dstream = ZSTD_createDStream();
    if (!dstream) {
        xsink->raiseException("ZSTD-ERROR", "failed to create Zstd decompression stream");
        return -1;
    }
    ON_BLOCK_EXIT(ZSTD_freeDStream, dstream);

    size_t rc = ZSTD_initDStream(dstream);
    if (ZSTD_isError(rc)) {
        xsink->raiseException("ZSTD-ERROR", "failed to initialize Zstd decompression: %s", ZSTD_getErrorName(rc));
        return -1;
    }

    ZSTD_inBuffer input = { b->getPtr(), b->size(), 0 };
    int iter = 0;
    while (true) {
        if (++iter % 10 == 0 && qore_check_cancel(xsink, "decompressing Zstd data")) {
            return -1;
        }
        if (out.reserve(xsink)) {
            return -1;
        }
        ZSTD_outBuffer output = { out.next(), out.avail(), 0 };
        rc = ZSTD_decompressStream(dstream, &output, &input);
        if (ZSTD_isError(rc)) {
            xsink->raiseException("ZSTD-ERROR", "Zstd decompression failed: %s", ZSTD_getErrorName(rc));
            return -1;
        }
        if (out.produced(output.pos, xsink)) {
            return -1;
        }
        // a return value of 0 means that a frame has been completely decoded and flushed; any further input is
        // decoded as another frame
        if (input.pos == input.size) {
            if (!rc) {
                break;
            }
            // all input consumed with free output space left: the frame has not ended
            if (output.pos < output.size) {
                xsink->raiseException("ZSTD-ERROR", "Unexpected end of compressed data");
                return -1;
            }
        }
    }
    return 0;
}

BinaryNode* qore_unzstd_to_binary(const BinaryNode* b, size_t max_size, ExceptionSink* xsink) {
    DecompressionOutput out("Zstd", max_size, 0);
    return qore_unzstd_intern(out, b, xsink) ? nullptr : out.takeBinary();
}

QoreStringNode* qore_unzstd_to_string(const BinaryNode* b, const QoreEncoding* enc, size_t max_size,
        ExceptionSink* xsink) {
    DecompressionOutput out("Zstd", max_size, 0);
    return qore_unzstd_intern(out, b, xsink) ? nullptr : out.takeString(enc);
}

BinaryNode* qore_lz4(const void* ptr, unsigned long len, int acceleration, ExceptionSink* xsink) {
    // Calculate maximum compressed size
    int max_compressed_size = LZ4_compressBound(len);

    SimpleRefHolder<BinaryNode> b(new BinaryNode);
    if (b->preallocate(max_compressed_size)) {
        xsink->outOfMemory();
        return nullptr;
    }

    int compressed_size = LZ4_compress_fast(
        static_cast<const char*>(ptr),
        static_cast<char*>(const_cast<void*>(b->getPtr())),
        len,
        max_compressed_size,
        acceleration
    );

    if (compressed_size == 0) {
        xsink->raiseException("LZ4-ERROR", "LZ4 compression failed");
        return nullptr;
    }

    b->setSize(compressed_size);
    return b.release();
}

static char* qore_unlz4_intern(const BinaryNode* b, int& decoded_size, int max_output_size, ExceptionSink* xsink) {
    // LZ4 needs to know the maximum decompressed size upfront.
    // If max_output_size is not provided, we use a conservative estimate based
    // on the compressed size. For highly compressed data, the real size may be
    // significantly larger; callers should pass max_output_size when known.
    int buf_size;
    if (max_output_size > 0) {
        buf_size = max_output_size;
    } else {
        // Use a 16x safety factor to reduce the chance of failure on valid,
        // highly compressed data, and guard against integer overflow.
        size_t csize = b->size();
        if (csize > static_cast<size_t>(INT_MAX / 16)) {
            buf_size = INT_MAX;
        } else {
            buf_size = static_cast<int>(csize * 16);
        }
    }
    if (buf_size < 4096) {
        buf_size = 4096;
    }

    void* buf = malloc(buf_size);
    if (!buf) {
        xsink->outOfMemory();
        return nullptr;
    }

    int result = LZ4_decompress_safe(
        static_cast<const char*>(b->getPtr()),
        static_cast<char*>(buf),
        b->size(),
        buf_size
    );

    if (result < 0) {
        free(buf);
        xsink->raiseException("LZ4-ERROR", "LZ4 decompression failed - corrupted data or buffer too small");
        return nullptr;
    }

    decoded_size = result;
    return static_cast<char*>(buf);
}

BinaryNode* qore_unlz4_to_binary(const BinaryNode* b, int max_output_size, ExceptionSink* xsink) {
    int len;
    char* buf = qore_unlz4_intern(b, len, max_output_size, xsink);
    return buf ? new BinaryNode(buf, len) : nullptr;
}

QoreStringNode* qore_unlz4_to_string(const BinaryNode* b, int max_output_size, const QoreEncoding* enc, ExceptionSink* xsink) {
    int len;
    char* buf = qore_unlz4_intern(b, len, max_output_size, xsink);
    // NOTE: the null terminator is added by the QoreStringNode constructor
    return buf ? new QoreStringNode(buf, len, len, enc) : nullptr;
}

/** @defgroup compression_constants Compression Constants
 */
///@{
//! gives the default compression level for the compress() and gzip() functions, providing a trade-off between compression speed and compression size
const Z_DEFAULT_COMPRESSION = Z_DEFAULT_COMPRESSION;

//! gives the default compression level for the bzip2() function, providing a trade-off between compression speed and compression size (value: \c 3)
const BZ2_DEFAULT_COMPRESSION = BZ2_DEFAULT_COMPRESSION;

//! Identifies the default compression level appropriate for given algorithm
const COMPRESSION_LEVEL_DEFAULT = COMPRESSION_LEVEL_DEFAULT;

//! gives the default quality level for the brotli() function (value: \c 11)
/** @since %Qore 2.1
 */
const BROTLI_DEFAULT_QUALITY = 11;

//! gives the minimum quality level for the brotli() function (value: \c 0)
/** @since %Qore 2.1
 */
const BROTLI_MIN_QUALITY = 0;

//! gives the maximum quality level for the brotli() function (value: \c 11)
/** @since %Qore 2.1
 */
const BROTLI_MAX_QUALITY = 11;

//! gives the default compression level for the zstd() function (value: \c 3)
/** @since %Qore 2.1
 */
const ZSTD_DEFAULT_LEVEL = qore(ZSTD_CLEVEL_DEFAULT);

//! gives the minimum compression level for the zstd() function (value: \c 1)
/** @since %Qore 2.1
 */
const ZSTD_MIN_LEVEL = 1;

//! gives the maximum compression level for the zstd() function (typically 22)
/** @since %Qore 2.1
 */
const ZSTD_MAX_LEVEL = qore(ZSTD_maxCLevel());

//! gives the default acceleration value for the lz4() function (value: \c 1)
/** Higher acceleration values trade compression ratio for speed.
    @since %Qore 2.1
 */
const LZ4_DEFAULT_ACCELERATION = 1;

//! gives the minimum acceleration value for the lz4() function (value: \c 1)
/** @since %Qore 2.1
 */
const LZ4_MIN_ACCELERATION = 1;

//! gives the maximum acceleration value for the lz4() function (value: \c 65537)
/** @since %Qore 2.1
 */
const LZ4_MAX_ACCELERATION = 65537;
///@}

/** @defgroup compression_transformations Compression Stream Transformations

    The following @ref Transform constants can be used with @ref TransformInputStream and @ref TransformOutputStream to transform stream data

    @par Example:
    @code
Qore::FileOutputStream of("my-file.txt");
Qore::TransformOutputStream ts(of, get_decompressor(Qore::COMPRESSION_ALG_BZIP2));
    @endcode

    @see crypto_transformations

    @since %Qore 0.8.13
 */
///@{
//! Identifies the ZLIB Compressed Data Format (<a href="http://www.ietf.org/rfc/rfc1950.txt">RFC 1950</a>)
const COMPRESSION_ALG_ZLIB = str(CompressionTransforms::ALG_ZLIB);

//! Identifies the GZIP Format (<a href="http://www.ietf.org/rfc/rfc1952.txt">RFC 1952</a>)
const COMPRESSION_ALG_GZIP = str(CompressionTransforms::ALG_GZIP);

//! Identifies the <a href="http://en.wikipedia.org/wiki/Bzip2">bzip2 algorithm</a>
const COMPRESSION_ALG_BZIP2 = str(CompressionTransforms::ALG_BZIP2);

//! Identifies the <a href="https://github.com/google/brotli">Brotli</a> compression algorithm (<a href="https://www.rfc-editor.org/rfc/rfc7932">RFC 7932</a>)
/** @since %Qore 2.1
 */
const COMPRESSION_ALG_BROTLI = str(CompressionTransforms::ALG_BROTLI);

//! Identifies the <a href="https://github.com/facebook/zstd">Zstandard</a> compression algorithm (<a href="https://www.rfc-editor.org/rfc/rfc8878">RFC 8878</a>)
/** @since %Qore 2.1
 */
const COMPRESSION_ALG_ZSTD = str(CompressionTransforms::ALG_ZSTD);

//! Identifies the <a href="https://github.com/lz4/lz4">LZ4</a> compression algorithm
/** @note LZ4 does not store the original size in the compressed data, so decompression requires either a
    max_output_size parameter or knowledge of the original size.

    @since %Qore 2.1
 */
const COMPRESSION_ALG_LZ4 = str(CompressionTransforms::ALG_LZ4);
///@}

/** @defgroup compresssion_functions Compression Functions
    These functions work with compression and decompression
 */
///@{
//! Performs zlib-based "deflate" data compression (<a href="http://www.ietf.org/rfc/rfc1951.txt">RFC 1951</a>) and returns a binary object of the compressed data
/** Note that strings are compressed without the trailing null character.

    @param data The string to compress
    @param level Specifies the compression level; must be an integer between 1 and 9, 9 meaning the highest compression level. The default value Z_DEFAULT_COMPRESSION gives a tradeoff between speed and compression size

    @return a binary object of the compressed data

    @par Example:
    @code{.py}
binary bin = compress(str_data);
    @endcode

    @throw ZLIB-LEVEL-ERROR level must be between 1 - 9 or -1
    @throw ZLIB-ERROR zlib returned an error while processing
*/
binary compress(string data, int level = Z_DEFAULT_COMPRESSION) [flags=NAMED_ARGS] {
   if ((level < 1 && level != -1) || level > 9)
      return xsink->raiseException("ZLIB-LEVEL-ERROR", "level must be between 1 - 9 or -1 (value passed: %d)", level);

   if (!data->strlen())
      return new BinaryNode;

   return qore_deflate(data->getBuffer(), data->strlen(), level, xsink);
}

//! Performs zlib-based "deflate" data compression (<a href="http://www.ietf.org/rfc/rfc1951.txt">RFC 1951</a>) and returns a binary object of the compressed data
/** Note that strings are compressed without the trailing null character.

    @param data The binary object to compress
    @param level Specifies the compression level; must be an integer between 1 and 9, 9 meaning the highest compression level. The default value Z_DEFAULT_COMPRESSION gives a tradeoff between speed and compression size

    @return a binary object of the compressed data

    @par Example:
    @code{.py}
binary bin = compress(bin_data);
    @endcode

    @throw ZLIB-LEVEL-ERROR level must be between 1 - 9 or -1
    @throw ZLIB-ERROR zlib returned an error while processing
*/
binary compress(binary data, int level = Z_DEFAULT_COMPRESSION) [flags=NAMED_ARGS] {
   if ((level < 1 && level != -1) || level > 9)
      return xsink->raiseException("ZLIB-LEVEL-ERROR", "level must be between 1 - 9 or -1 (value passed: %d)", level);

   if (!data->size())
      return new BinaryNode;

   return qore_deflate(data->getPtr(), data->size(), level, xsink);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing compress() [flags=RUNTIME_NOOP] {
}

//! Performs zlib-based decompression of data compressed by the "deflate" algorithm (<a href="http://www.ietf.org/rfc/rfc1951.txt">RFC 1951</a>) and returns a string of the decompressed data
/**
    @param compressed_data the compressed data to decompress
    @param encoding the character encoding tag for the string return value; if not present, the @ref default_encoding "default character encoding" is assumed.
    @param max_size the maximum size of the decompressed data in bytes; 0 (the default) means no limit; decompression
    stops with a \c DECOMPRESSION-LIMIT-EXCEEDED exception as soon as the decompressed data would exceed this size, so
    no more than this size is ever allocated for the output; set this argument when decompressing data from an
    untrusted source to guard against a "decompression bomb", a small input that expands to a huge output

    @return the uncompressed data as a string

    @par Example:
    @code{.py}
string str = uncompress_to_string(bin, "iso-8859-1");
string str = uncompress_to_string(bin, "iso-8859-1", 10 * 1024 * 1024);
    @endcode

    @throw ZLIB-ERROR The zlib library returned an error during processing (possibly due to corrupt input data)
    @throw DECOMPRESSION-LIMIT-EXCEEDED the decompressed data exceeds \a max_size
    @throw DECOMPRESSION-LIMIT-ERROR \a max_size is negative

    @since %Qore 3.0 added the \a max_size parameter
*/
string uncompress_to_string(binary compressed_data, *string encoding, int max_size = 0) [flags=NAMED_ARGS] {
   const QoreEncoding* qe = encoding ? QEM.findCreate(encoding) : QCS_DEFAULT;
   if (qore_check_decompression_max_size(max_size, xsink)) {
      return QoreValue();
   }
   return qore_inflate_to_string(compressed_data, qe, static_cast<size_t>(max_size), xsink);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing uncompress_to_string() [flags=RUNTIME_NOOP] {
}

//! Performs zlib-based decompression of data compressed by the "deflate" algorithm (<a href="http://www.ietf.org/rfc/rfc1951.txt">RFC 1951</a>) and returns a binary object of the decompressed data
/** @param compressed_data the data to decompress
    @param max_size the maximum size of the decompressed data in bytes; 0 (the default) means no limit; decompression
    stops with a \c DECOMPRESSION-LIMIT-EXCEEDED exception as soon as the decompressed data would exceed this size, so
    no more than this size is ever allocated for the output; set this argument when decompressing data from an
    untrusted source to guard against a "decompression bomb", a small input that expands to a huge output

    @return a binary object of the decompressed data

    @par Example:
    @code{.py}
binary bin = uncompress_to_binary(data);
binary bin = uncompress_to_binary(data, max_size: 10 * 1024 * 1024);
    @endcode

    @throw ZLIB-ERROR The zlib library returned an error during processing (possibly due to corrupt input data)
    @throw DECOMPRESSION-LIMIT-EXCEEDED the decompressed data exceeds \a max_size
    @throw DECOMPRESSION-LIMIT-ERROR \a max_size is negative

    @since %Qore 3.0 added the \a max_size parameter
*/
binary uncompress_to_binary(binary compressed_data, int max_size = 0) [flags=NAMED_ARGS] {
   if (qore_check_decompression_max_size(max_size, xsink)) {
      return QoreValue();
   }
   return qore_inflate_to_binary(compressed_data, static_cast<size_t>(max_size), xsink);
}

//! This function variant does nothing at all; it is only included for backwards-compatibility with qore prior to version 0.8.0 for functions that would ignore type errors in arguments
/**
 */
nothing uncompress_to_binary() [flags=RUNTIME_NOOP] {
}

//! Performs raw DEFLATE compression without zlib/gzip headers or trailers
/** This is the raw DEFLATE format as specified in <a href="http://www.ietf.org/rfc/rfc1951.txt">RFC 1951</a>,
    without the zlib header/trailer from RFC 1950 or gzip header/trailer from RFC 1952.

    This is used by the WebSocket permessage-deflate extension (<a href="http://tools.ietf.org/html/rfc7692">RFC 7692</a>).

    @param data The string to compress
    @param level Specifies the compression level; must be an integer between 1 and 9, 9 meaning the highest
    compression level. The default value Z_DEFAULT_COMPRESSION gives a tradeoff between speed and compression size

    @return a binary object of the compressed data in raw DEFLATE format

    @par Example:
    @code{.py}
binary bin = deflate_raw(str_data);
    @endcode

    @throw ZLIB-LEVEL-ERROR level must be between 1 - 9 or -1
    @throw ZLIB-ERROR zlib returned an error while processing

    @since %Qore 3.0
*/
binary deflate_raw(string data, int level = Z_DEFAULT_COMPRESSION) [flags=NAMED_ARGS] {
   if ((level < 1 && level != -1) || level > 9)
      return xsink->raiseException("ZLIB-LEVEL-ERROR", "level must be between 1 - 9 or -1 (value passed: %d)", level);

   if (!data->strlen())
      return new BinaryNode;

   return qore_deflate_raw(data->getBuffer(), data->strlen(), level, xsink);
}

//! Performs raw DEFLATE compression without zlib/gzip headers or trailers
/** This is the raw DEFLATE format as specified in <a href="http://www.ietf.org/rfc/rfc1951.txt">RFC 1951</a>,
    without the zlib header/trailer from RFC 1950 or gzip header/trailer from RFC 1952.

    This is used by the WebSocket permessage-deflate extension (<a href="http://tools.ietf.org/html/rfc7692">RFC 7692</a>).

    @param data The binary object to compress
    @param level Specifies the compression level; must be an integer between 1 and 9, 9 meaning the highest
    compression level. The default value Z_DEFAULT_COMPRESSION gives a tradeoff between speed and compression size

    @return a binary object of the compressed data in raw DEFLATE format

    @par Example:
    @code{.py}
binary bin = deflate_raw(bin_data);
    @endcode

    @throw ZLIB-LEVEL-ERROR level must be between 1 - 9 or -1
    @throw ZLIB-ERROR zlib returned an error while processing

    @since %Qore 3.0
*/
binary deflate_raw(binary data, int level = Z_DEFAULT_COMPRESSION) [flags=NAMED_ARGS] {
   if ((level < 1 && level != -1) || level > 9)
      return xsink->raiseException("ZLIB-LEVEL-ERROR", "level must be between 1 - 9 or -1 (value passed: %d)", level);

   if (!data->size())
      return new BinaryNode;

   return qore_deflate_raw(data->getPtr(), data->size(), level, xsink);
}

