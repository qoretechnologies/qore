#include <qore/Qore.h>
#include "qore/intern/QC_RegexExtract.h"

//! The RegexExtract class provides compiled regular expression extraction that can be applied to multiple strings
/** The class allows for pre-compilation of an extraction pattern once, and then efficiently extracting
    captured groups from multiple strings.

    @par Global Extraction
    When the \c RE_Global option is used, all matches are found and all captured groups from all matches
    are returned in a single list.

    @par Example:
    @code{.py}
# Extract parts of email addresses
RegexExtract email_parts("(\\w+)@(\\w+)\\.(\\w+)");

list<string> addresses = ("user@example.com", "test@domain.org");
foreach string addr in (addresses) {
    *list<*string> parts = email_parts.extractGroups(addr);
    if (parts) {
        printf("user: %s, domain: %s, tld: %s\n", parts[0], parts[1], parts[2]);
    }
}

# Extract all numbers from a string (global extraction)
RegexExtract numbers("(\\d+)", RE_Global);
*list<*string> nums = numbers.extractGroups("test 123 and 456 and 789");
# nums = ("123", "456", "789")
    @endcode

    @since %Qore 2.3
 */
qclass RegexExtract [arg=QoreRegexExtractClass* r; dom=DEFAULT];

//! Creates a compiled regular expression extractor from the given pattern
/** @param pattern the regular expression pattern with capturing groups
    @param options optional regex options; see @ref regex_constants for valid values;
        use \c RE_Global to extract all matches instead of just the first

    @par Example:
    @code{.py}
# Extract first match only
RegexExtract r("(\\d+)-(\\d+)");

# Extract all matches
RegexExtract r_global("(\\d+)", RE_Global);
    @endcode

    @throw REGEX-COMPILATION-ERROR the pattern is not a valid regular expression
    @throw REGEX-OPTION-ERROR the options contain invalid option bits
 */
RegexExtract::constructor(string pattern, softint options = 0) {
    SimpleRefHolder<QoreRegexExtractClass> regex(new QoreRegexExtractClass(*pattern, options, xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_REGEXEXTRACT, regex.release());
}

//! Creates a copy of the RegexExtract object
/**
    @par Example:
    @code{.py}
RegexExtract r2 = r.copy();
    @endcode
 */
RegexExtract::copy() {
    SimpleRefHolder<QoreRegexExtractClass> regex(new QoreRegexExtractClass(*r));
    self->setPrivate(CID_REGEXEXTRACT, regex.release());
}

//! Extracts captured groups from the string using the compiled pattern
/** @param str the string to extract from
    @return a list of captured groups, or @ref nothing if the pattern does not match

    If the pattern has no capturing groups, nothing is returned even if the pattern matches.

    When \c RE_Global is set, all matches are found and all captured groups from all matches
    are returned in a single flat list.

    @par Example:
    @code{.py}
RegexExtract r("(\\w+)@(\\w+)");
*list<*string> parts = r.extractGroups("user@example.com");
# parts = ("user", "example")

# With global extraction
RegexExtract r_global("(\\d+)", RE_Global);
*list<*string> nums = r_global.extractGroups("a1b2c3");
# nums = ("1", "2", "3")
    @endcode

    @throw ENCODING-CONVERSION-ERROR the string could not be converted to UTF-8
 */
*list<*string> RegexExtract::extractGroups(string str) [flags=RET_VALUE_ONLY] {
    return r->extract(str, xsink);
}

//! Tests if the given string matches the compiled pattern
/** @param str the string to test against the pattern
    @return @ref True if the string matches the pattern, @ref False otherwise

    @par Example:
    @code{.py}
RegexExtract r("(\\d+)-(\\d+)");
if (r.match("123-456")) {
    printf("valid format\n");
}
    @endcode

    @throw ENCODING-CONVERSION-ERROR the string could not be converted to UTF-8
 */
bool RegexExtract::match(string str) [flags=RET_VALUE_ONLY] {
    return r->match(str, xsink);
}

//! Returns the compiled pattern string
/** @return the pattern string that was used to create this RegexExtract object

    @par Example:
    @code{.py}
RegexExtract r("(\\d+)");
string pat = r.getPattern();  # returns "(\\d+)"
    @endcode
 */
string RegexExtract::getPattern() [flags=CONSTANT] {
    return new QoreStringNode(*r->getPattern());
}

//! Returns the options used when compiling the pattern
/** @return the regex option flags used when creating this object; see @ref regex_constants for valid values

    @par Example:
    @code{.py}
RegexExtract r("(\\d+)", RE_Global | RE_Caseless);
int opts = r.getOptions();  # returns RE_Global | RE_Caseless
    @endcode
 */
int RegexExtract::getOptions() [flags=CONSTANT] {
    return r->getOptions();
}

//! Returns the number of times the pattern matches in the given string
/** @param str the string to search for matches

    @return the number of non-overlapping matches found; 0 if no match

    @par Example:
    @code{.py}
RegexExtract r("(\\d+)");
int n = r.count("abc 123 def 456"); # returns 2
    @endcode

    @throw ENCODING-CONVERSION-ERROR this exception could be thrown if the string arguments have different
    @ref character_encoding "character encodings" and an error occurs during encoding conversion

    @since %Qore 2.3
*/
int RegexExtract::count(string str) [flags=RET_VALUE_ONLY] {
    return r->countMatches(str, xsink);
}

//! Extracts named capture groups from a string and returns a hash keyed by group name
/** If the pattern has no named groups, @ref nothing is returned. If the @ref RE_Global option was
    used, returns a list of hashes (one per match). Otherwise returns a single hash.

    Named groups are defined with \c (?<name>...) or \c (?P<name>...) syntax.

    @param str the string to match against

    @return for non-global: \c *hash<string, *string> where keys are group names and values are matched text
    (or @ref nothing for unmatched optional groups); for global: \c *list<hash<string, *string>>; returns
    @ref nothing if there are no named groups in the pattern or no match

    @par Example:
    @code{.py}
RegexExtract r("(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})");
auto h = r.extractNamedGroups("2026-04-08");
# h = {"year": "2026", "month": "04", "day": "08"}
    @endcode

    @throw ENCODING-CONVERSION-ERROR this exception could be thrown if the string arguments have different
    @ref character_encoding "character encodings" and an error occurs during encoding conversion

    @since %Qore 2.3
*/
auto RegexExtract::extractNamedGroups(string str) [flags=RET_VALUE_ONLY] {
    return r->extractNamedGroups(str, xsink);
}

//! Returns detailed match information including positions, groups, and named groups
/** Returns a list of @ref Qore::RegexMatchInfo "RegexMatchInfo" hashes, one per match.
    Without the @ref RE_Global option, returns at most one match. With @ref RE_Global,
    returns all non-overlapping matches.

    @param str the string to match against

    @return a list of @ref Qore::RegexMatchInfo "RegexMatchInfo" hashes; @ref nothing if no match

    @par Example:
    @code{.py}
RegexExtract r("(\\d+)", RE_Global);
*list<hash<RegexMatchInfo>> matches = r.extractDetailed("abc 123 def 456");
# matches[0].match = "123", matches[0].offset = 4, matches[0].groups = ("123",)
# matches[1].match = "456", matches[1].offset = 12, matches[1].groups = ("456",)
    @endcode

    @throw ENCODING-CONVERSION-ERROR this exception could be thrown if the string arguments have different
    @ref character_encoding "character encodings" and an error occurs during encoding conversion

    @since %Qore 2.3
*/
*list<hash<RegexMatchInfo>> RegexExtract::extractDetailed(string str) [flags=RET_VALUE_ONLY] {
    return r->extractDetailed(str, xsink);
}
