#include <qore/Qore.h>

#include "qore/intern/QoreListIterator.h"

//! Methods in this pseudo-class can be executed on @ref buffer "buffer values"
/**
    Buffers provide dense, homogeneous storage with source-level types such as
    \c buffer<int64>, \c buffer<float64>, \c buffer<bool>, \c buffer<string>,
    and \c buffer<decimal128>.  Nullable element buffers use \c buffer<*T>.

    \c buffer<decimal128> stores exact fixed-scale decimal values as 16-byte
    unscaled integers.  Use Qore \c number literals, for example \c 12.34n, to
    avoid converting through binary floating-point values.  Decimal scale is
    inferred from list construction and \c filled() construction; values assigned
    later must fit the buffer's scale without losing decimal precision.
 */
qclass <buffer> [arg=const QoreBufferNode* b = v.get<const QoreBufferNode>();vparent=<value>];

//! Returns Qore::NT_BUFFER
/**
    @return Qore::NT_BUFFER

    @par Example:
    @code{.py}
if (measurements.typeCode() == NT_BUFFER) {
    printf("using dense storage: %s\n", measurements.fullType());
}
    @endcode
*/
int <buffer>::typeCode() [flags=CONSTANT] {
   return NT_BUFFER;
}

//! Returns @ref True because buffers always have an element type
/** @return @ref True

    @par Example:
    @code{.py}
buffer<float64> temperatures = new buffer<float64>((21.5, 22.0, 20.75));
assert(temperatures.complexType());
    @endcode

    @see <value>::fullType()
 */
bool <buffer>::complexType() [flags=CONSTANT] {
   return true;
}

//! Returns the number of elements in the buffer
/**
    @return the number of elements in the buffer

    @par Example:
    @code{.py}
buffer<int64> ids = new buffer<int64>((1001, 1002, 1003));
int len = ids.size();
    @endcode
*/
int <buffer>::size() [flags=CONSTANT] {
   return b->size();
}

//! Returns the number of elements in the buffer
/**
    @return the number of elements in the buffer

    @par Example:
    @code{.py}
foreach int offset in (range(0, values.lsize() - 1)) {
    process_value(values[offset]);
}
    @endcode
*/
int <buffer>::lsize() [flags=CONSTANT] {
   return b->size();
}

//! Returns @ref True if the buffer is empty, @ref False otherwise
/**
    @return @ref True if the buffer has no elements

    @par Example:
    @code{.py}
if (!samples.empty()) {
    printf("average sample: %n\n", samples.mean());
}
    @endcode
*/
bool <buffer>::empty() [flags=CONSTANT] {
   return b->empty();
}

//! Returns @ref True if the buffer has at least one element, @ref False otherwise
/**
    @return @ref True if the buffer has at least one element

    @par Example:
    @code{.py}
if (samples.val()) {
    process(samples);
}
    @endcode
*/
bool <buffer>::val() [flags=CONSTANT] {
   return !b->empty();
}

//! Returns @ref True because buffers can return their size
/**
    @return @ref True

    @see <buffer>::size()
*/
bool <buffer>::sizep() [flags=CONSTANT] {
   return true;
}

//! Returns @ref True if the buffer wraps immutable external host storage
/**
    @return @ref True if the buffer uses external host memory owned by another API

    @par Example:
    @code{.py}
if (ids.externalStorage()) {
    ids = ids.clone();  # make an owned mutable copy before passing to a writable plugin
}
    @endcode
*/
bool <buffer>::externalStorage() [flags=CONSTANT] {
   return b->hasExternalStorage();
}

//! Returns @ref True if the buffer wraps immutable external device storage
/**
    Device-backed buffers are created by native modules that own accelerator or
    driver memory.  Ordinary buffer reads materialize host storage when the
    module supplied a copy callback; writes detach into an owned host buffer.

    @return @ref True if the buffer uses external device memory

    @par Example:
    @code{.py}
if (measurements.deviceStorage()) {
    measurements.materialize();
}
    @endcode
*/
bool <buffer>::deviceStorage() [flags=CONSTANT] {
   return b->hasExternalDeviceStorage();
}

//! Returns @ref True if raw host storage is available without a device transfer
/**
    @return @ref True when the buffer is empty, owned by Qore, wraps external
    host memory, or has already materialized its device storage

    @par Example:
    @code{.py}
if (!values.hostStorage()) {
    values.materialize();
}
    @endcode
*/
bool <buffer>::hostStorage() [flags=CONSTANT] {
   return b->hasHostStorage();
}

//! Materializes external device storage into host memory
/**
    This method is a no-op for ordinary host buffers.  It is intended for code
    that wants to force a device-to-host transfer before passing a buffer to an
    API that requires raw host pointers.

    @return the same buffer value

    @throw BUFFER-DEVICE-STORAGE-ERROR if a device-backed buffer cannot be copied to host memory

    @par Example:
    @code{.py}
buffer<float64> values = source.getMeasurements();
values.materialize();
process(values);
    @endcode
*/
auto <buffer>::materialize() {
   if (b->ensureHostStorage(xsink))
      return QoreValue();
   return v.refSelf();
}

//! Returns the number of non-null elements in the buffer
/**
    Nullable buffers skip element values that are @ref nothing.

    @return the number of valid elements in the buffer

    @par Example:
    @code{.py}
buffer<*int64> scores = new buffer<*int64>((10, NOTHING, 30));
assertEq(2, scores.count());
    @endcode
*/
int <buffer>::count() [flags=RET_VALUE_ONLY] {
   return b->countValid(xsink);
}

//! Returns a typed list containing the buffer's elements
/**
    @return a new list containing each buffer element; nullable elements are returned as @ref nothing values

    @par Example:
    @code{.py}
buffer<float64> values = new buffer<float64>((1.5, 2.5));
list<float> boxed = values.toList();
    @endcode
*/
list<auto> <buffer>::toList() [flags=RET_VALUE_ONLY] {
   return b->toList(xsink);
}

//! Returns a deep copy of the buffer
/**
    @return a new buffer with the same element type, nullability, and values

    @par Example:
    @code{.py}
buffer<int64> original = new buffer<int64>((1, 2, 3));
auto copy = original.clone();
    @endcode
*/
auto <buffer>::clone() [flags=RET_VALUE_ONLY] {
   return b->copy(xsink);
}

//! Returns a zero-copy view over a contiguous range of this buffer
/**
    Writes through the returned buffer update this buffer, and writes through this buffer are visible through the
    returned view.

    @param start zero-based first element in the view
    @param count number of elements in the view
    @return a new buffer sharing storage with this buffer

    @throw BUFFER-RANGE-ERROR if @a start or @a count is negative, or if the requested range exceeds the buffer size

    @par Example:
    @code{.py}
buffer<int64> ids = new buffer<int64>((10, 20, 30, 40));
buffer<int64> middle = ids.view(start: 1, count: 2);
middle[0] = 25;
assertEq((10, 25, 30, 40), ids.toList());
    @endcode
*/
auto <buffer>::view(int start, int count) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
   if (start < 0 || count < 0 || start > (int64)b->size() || count > (int64)b->size() - start)
      return xsink->raiseException("BUFFER-RANGE-ERROR", "buffer.view(start: " QLLD ", count: " QLLD
         ") is out of range for buffer length " QSD, start, count, b->size());
   return b->view(static_cast<size_t>(start), static_cast<size_t>(count));
}

//! Returns a ListIterator over a boxed copy of the buffer's values
/**
    @return a ListIterator object over the buffer values

    @par Example:
    @code{.py}
map printf("sample: %n\n", $1), samples.iterator();
    @endcode

    @note The iterator boxes the dense buffer into a list snapshot.
*/
AbstractIterator <buffer>::iterator() [flags=RET_VALUE_ONLY] {
   ReferenceHolder<QoreListNode> l(b->toList(xsink), xsink);
   if (*xsink)
      return QoreValue();
   return qore_new_list_iterator_object(0, *l);
}

//! Returns the sum of valid buffer values
/**
    @return the sum of the valid elements; nullable elements that are @ref nothing are ignored

    @par Example:
    @code{.py}
buffer<*int64> values = new buffer<*int64>((10, NOTHING, 30));
assertEq(40, values.sum());

buffer<decimal128> amounts = new buffer<decimal128>((10.25n, 1.75n));
assertEq(12n, amounts.sum());
    @endcode
*/
auto <buffer>::sum() [flags=RET_VALUE_ONLY] {
   return b->sum(xsink);
}

//! Returns the arithmetic mean of valid buffer values
/**
    @return the arithmetic mean as a floating-point value for integer, boolean, and floating-point buffers, a
    \c number for \c buffer<decimal128>, or @ref nothing if no valid values exist

    @par Example:
    @code{.py}
buffer<float64> temperatures = new buffer<float64>((21.5, 22.5));
assertEq(22.0, temperatures.mean());

buffer<decimal128> amounts = new buffer<decimal128>((10.25n, 1.75n));
assertEq(6n, amounts.mean());
    @endcode
*/
auto <buffer>::mean() [flags=RET_VALUE_ONLY] {
   return b->mean(xsink);
}

//! Returns the minimum valid buffer value
/**
    @return the minimum value, or @ref nothing if no valid values exist

    @par Example:
    @code{.py}
buffer<int64> values = new buffer<int64>((4, 2, 8));
assertEq(2, values.min());
    @endcode
*/
auto <buffer>::min() [flags=RET_VALUE_ONLY] {
   return b->min(xsink);
}

//! Returns the maximum valid buffer value
/**
    @return the maximum value, or @ref nothing if no valid values exist

    @par Example:
    @code{.py}
buffer<int64> values = new buffer<int64>((4, 2, 8));
assertEq(8, values.max());
    @endcode
*/
auto <buffer>::max() [flags=RET_VALUE_ONLY] {
   return b->max(xsink);
}
