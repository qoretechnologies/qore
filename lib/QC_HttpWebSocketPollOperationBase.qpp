/** @cond INTERNAL */

// ============================================================
// WsEchoFrameHandler implementation
// ============================================================

BinaryNode* WsEchoFrameHandler::handleTextFrame(const QoreStringNode* text,
        ExceptionSink* xsink) {
    return WebSocketFrameEncoder::encode(WSOP_TEXT,
        text->c_str(), text->size(), true, false);
}

BinaryNode* WsEchoFrameHandler::handleBinaryFrame(const BinaryNode* data,
        ExceptionSink* xsink) {
    return WebSocketFrameEncoder::encode(WSOP_BINARY,
        data->getPtr(), data->size(), true, false);
}

BinaryNode* WsEchoFrameHandler::handleFrameRaw(WsOpcode opcode,
        const void* data, size_t len, uint8_t rsv, ExceptionSink* xsink) {
    // Encode directly from raw bytes — skips the QoreStringNode / BinaryNode
    // wrapper allocation + copy that the default implementation performs.
    // A compressed message keeps its RSV bits: its payload is echoed compressed, as received (qore#6774); without
    // them the client took the compressed bytes for the message
    return WebSocketFrameEncoder::encode(opcode, data, len, true, false, rsv);
}

// ============================================================
// HttpWebSocketPollOperationPriv implementation
// ============================================================

HttpWebSocketPollOperationPriv::HttpWebSocketPollOperationPriv(QoreObject* self,
        QoreSocketObject* sock, Queue* recv_queue, QoreObject* recv_queue_obj,
        Queue* send_queue, QoreObject* send_queue_obj)
    : SocketPollOperationBase(self),
      sock(sock),
      recv_queue(recv_queue),
      recv_queue_obj(recv_queue_obj),
      send_queue(send_queue),
      send_queue_obj(send_queue_obj) {
    // All pointers are already ref'd by the QPP constructor
}

HttpWebSocketPollOperationPriv::~HttpWebSocketPollOperationPriv() {
    if (sock || recv_queue || send_queue || send_op || recv_op || error_info || frame_callback) {
        ExceptionSink xsink;
        cleanup(&xsink);
    }
}

bool HttpWebSocketPollOperationPriv::goalReached() const {
    return ws_state == WsState::CLOSED || ws_state == WsState::ERROR;
}

int HttpWebSocketPollOperationPriv::checkSendProgress(ExceptionSink* xsink) {
    bool rate = send_rate.enabled();
    if (send_op_start_ms <= 0 || (send_timeout_ms <= 0 && !rate)) {
        return 0;
    }
    int64 now_ms = monotonicMs();
    send_op_waited = true;
    send_rate_sample_ms = now_ms;
    int64 op_bytes = static_cast<int64>(send_op->getBytesSent());
    // progress is what the peer acknowledged: a write only shows room in the local send buffer
    int64 progress = send_bytes_done + op_bytes - qore_socket_object_private(sock).getUnacknowledgedSendBytes();
#ifdef DEBUG
    // tests simulate a peer that takes the data steadily, seen in steps, on the clock of the checks
    if (int64 sim = qore_dbg_ws_simulated_send_progress(now_ms); sim >= 0) {
        progress = sim;
    }
#endif
    if (progress > send_delivered_last) {
        send_delivered_last = progress;
        send_op_start_ms = now_ms;
    }
    if (progress < 0) {
        progress = 0;
    }
    int64 elapsed = now_ms - send_op_start_ms;
    int64 timeout_ms = getEffectiveSendTimeout();
    if (send_timeout_ms > 0 && elapsed > timeout_ms) {
        xsink->raiseException("SOCKET-TIMEOUT", "send operation made no progress for " QLLD " ms (timeout: " QLLD
            " ms)", elapsed, timeout_ms);
        setError(xsink);
        return -1;
    }
    if (send_rate.update(progress, true, now_ms)) {
        xsink->raiseException("SOCKET-TIMEOUT", "the peer took less than the minimum rate of " QLLD " bytes/s",
            send_rate.getMinRate());
        setError(xsink);
        return -1;
    }
    return 0;
}

QoreHashNode* HttpWebSocketPollOperationPriv::continuePoll(ExceptionSink* xsink) {
    // Serialize against user-thread abort()/cleanup() that may concurrently
    // null + deref send_op / recv_op.  Held for the entire body so the inner
    // op pointers we read at the top stay valid through the dispatched
    // continuePoll()/getOutput() calls below.
    AutoLocker al(m);
    printd(5, "HttpWebSocketPollOp::continuePoll() state: %s send_op=%p recv_op=%p\n",
        getWsState(), send_op, recv_op);
    frames_pushed_in_cycle = 0;
    if (goalReached()) {
        return nullptr;
    }

    // Check if socket is still open — skip in CLOSING state because the
    // peer's TCP FIN may have arrived before the close echo is sent
    if (!sock->isOpen() && (ws_state != WsState::CLOSING || waitsForPeerClose())) {
        setConnectionLost();
        return nullptr;
    }

    int poll_events = 0;

    // --- Phase 1: Drive active send operation ---
    if (send_op) {
        int send_events = qore_socket_poll_events_ops::continuePollEvents(send_op, xsink);
        if (*xsink) {
            setError(xsink);
            return nullptr;
        }
        if (!send_events) {
            // Send complete or failed
            if (send_op->goalReached()) {
                releaseSendOp(xsink);
                if (send_rate_below) {
                    send_rate_below = false;
                    xsink->raiseException("SOCKET-TIMEOUT", "the peer took less than the minimum rate of " QLLD
                        " bytes/s", send_rate.getMinRate());
                    setError(xsink);
                    return nullptr;
                }
            } else {
                // Send failed
                releaseSendOp(xsink);
                setError(xsink);
                return nullptr;
            }
        } else {
            // TLS can require the opposite direction to finish this operation.
            poll_events |= send_events;
            // checked after the attempt to send, so that a late wakeup is not charged to a peer that has made room
            if (checkSendProgress(xsink)) {
                return nullptr;
            }
        }
    }

    // --- Phase 2: Drive active recv operation ---
    if (recv_op) {
        int recv_events = qore_socket_poll_events_ops::continuePollEvents(recv_op, xsink);
        if (*xsink) {
            releaseRecvOp(xsink);
            // Recv errors on EAGAIN/TIMEOUT are not fatal — clear and continue
            xsink->clear();
            if (waitsForPeerClose()) {
                // the client's close frame can no longer arrive
                setConnectionLost();
                return nullptr;
            }
        } else if (!recv_events) {
            // Recv complete — process the data
            if (recv_op->goalReached()) {
                QoreValue output = recv_op->getOutput();
                if (output.getType() == NT_BINARY) {
                    const BinaryNode* bin = output.get<const BinaryNode>();
                    if (bin && bin->size() > 0) {
                        feedDecoder(bin->getPtr(), bin->size());
                    }
                    output.discard(xsink);
                } else if (output.getType() == NT_STRING) {
                    QoreStringValueHelper str(output);
                    if (str && str->size() > 0) {
                        feedDecoder(str->c_str(), str->size());
                    }
                    output.discard(xsink);
                } else {
                    output.discard(xsink);
                }
            }
            releaseRecvOp(xsink);

            // Process any complete frames in the decoder buffer BEFORE the
            // EOF check — frames decoded in this cycle must be pushed to
            // recv_queue so the worker can process them.
            processDecodedFrames(xsink);
            if (*xsink) {
                setError(xsink);
                return nullptr;
            }
            if (goalReached()) {
                return nullptr;
            }

            // Check for EOF — the peer closed the connection.
            // If frames were pushed in this cycle, defer the close to keep
            // the op alive for the worker to send responses (echo).
            if (!sock->isOpen() && !frames_pushed_in_cycle) {
                setConnectionLost();
                return nullptr;
            }
        } else {
            // TLS can require the opposite direction to finish this operation.
            poll_events |= recv_events;
        }
    }

    // --- Phase 2b: Drain any data left in the socket's internal read buffer ---
    // After a protocol upgrade (HTTP→WebSocket), SSL_read() may have read a
    // full TLS record containing both HTTP headers and the first WS frame.
    // The header reader consumed only the headers; the frame data stays in
    // the socket's internal buffer.  Drain it into the decoder before
    // starting a new recv op.
    if (!recv_op && !goalReached()) {
        SimpleRefHolder<BinaryNode> pending(sock->drainPendingBuffer());
        if (pending && pending->size() > 0) {
            feedDecoder(reinterpret_cast<const char*>(pending->getPtr()),
                pending->size());
            processDecodedFrames(xsink);
            if (*xsink) {
                setError(xsink);
                return nullptr;
            }
            if (goalReached()) {
                return nullptr;
            }
        }
    }

    // --- Phase 3: Start recv if no active recv ---
    // Skip in CLOSING state (FIN would cause SSL errors on the closing
    // socket). No isDataAvailable() — the controller's hasPendingData()
    // check in Phase 1 detects SSL-buffered data that epoll can't see.
    // A close the server started reads on until the client's close frame arrives.
    if (!recv_op && !goalReached() && (ws_state != WsState::CLOSING || waitsForPeerClose())) {
        if (startRecvOp(xsink)) {
            return nullptr;
        }
        poll_events |= SOCK_POLLIN;
    }

    // In CLOSING state: transition to CLOSED when the close handshake is complete (both close frames have been
    // sent and received, and ours has been written) or the connection is lost; the operation then ends, and the
    // server closes the TCP connection first (RFC 6455 section 7.1.1)
    if (checkClosing(xsink)) {
        return nullptr;
    }

    // --- Idle timeout: close the connection if no recv activity for idle_timeout_ms ---
    // reclaims connection slots/resources held by idle clients (e.g. a client that connects and never sends)
    if (idle_timeout_ms > 0 && !goalReached() && ws_state == WsState::CONNECTED && last_recv_activity_ms > 0
            && (monotonicMs() - last_recv_activity_ms) >= idle_timeout_ms) {
        queueSendClose(WSCC_GoingAway, "idle timeout", xsink);
        return nullptr;
    }

    // --- Heartbeat: auto-send ping if no recv activity ---
    // last_ping_sent_ms guards against spamming PINGs when the peer is
    // silent; last_recv_activity_ms reflects real incoming traffic only
    // so any future idle-timeout check can rely on it.
    if (heartbeat_interval_ms > 0 && ws_state == WsState::CONNECTED && last_recv_activity_ms > 0) {
        int64 now_ms = monotonicMs();
        int64 since_recv = now_ms - last_recv_activity_ms;
        int64 since_ping = last_ping_sent_ms ? now_ms - last_ping_sent_ms : heartbeat_interval_ms;
        if (since_recv >= heartbeat_interval_ms && since_ping >= heartbeat_interval_ms) {
            queueSendPing(nullptr, xsink);
            if (*xsink) {
                return nullptr;
            }
            last_ping_sent_ms = monotonicMs();
        }
    }

    // --- Phase 4: Check for queued frames to send ---
    if (!send_op && !goalReached()) {
        drainSendQueue(xsink);
        if (*xsink) {
            return nullptr;
        }
        if (pending_send && pending_send->size() > 0) {
            if (startSendOp(xsink)) {
                return nullptr;
            }
            // Try to complete the send inline — for small messages on
            // localhost, the kernel buffer has space and send() completes
            // immediately.  This eliminates one poll cycle per echo.
            int send_events = qore_socket_poll_events_ops::continuePollEvents(send_op, xsink);
            if (*xsink) {
                releaseSendOp(xsink);
                xsink->clear();
            } else if (!send_events) {
                if (send_op->goalReached()) {
                    releaseSendOp(xsink);
                    // Send complete — no POLLOUT needed
                } else {
                    releaseSendOp(xsink);
                }
            } else {
                // TLS can require the opposite direction to finish this operation.
                poll_events |= send_events;
                // the send now waits for the peer, even if it ends at its first wakeup
                if (checkSendProgress(xsink)) {
                    return nullptr;
                }
            }
        }
    }

    // If we're in CLOSED/ERROR after processing, we're done
    if (goalReached()) {
        return nullptr;
    }

    // Re-check CLOSING→CLOSED after Phase 4 drains the send queue.
    // The first CLOSING check (above Phase 4) may have failed because the
    // close echo was still in the send_queue; now that Phase 4 has sent it,
    // the transition can complete.
    if (checkClosing(xsink)) {
        return nullptr;
    }

    // An active receive reported its own TLS readiness above. A new receive subscribed
    // to input when it started. Adding POLLIN here would wake a read that needs POLLOUT.
    QoreHashNode* result = getSocketPollInfoHash(xsink, poll_events);
    // Add poll timeout for send timeout or heartbeat interval
    if (result) {
        int64 poll_timeout = 0;
        if (send_op && send_timeout_ms > 0 && send_op_start_ms > 0) {
            poll_timeout = getEffectiveSendTimeout() - (monotonicMs() - send_op_start_ms);
            if (poll_timeout <= 0) {
                poll_timeout = 1;
            }
        }
        // the minimum rate is checked while the send waits, also when the socket is never ready
        if (send_op && send_rate.enabled() && (!poll_timeout || poll_timeout > send_rate.getCheckIntervalMs())) {
            poll_timeout = send_rate.getCheckIntervalMs();
        }
        if (heartbeat_interval_ms > 0 && ws_state == WsState::CONNECTED && last_recv_activity_ms > 0) {
            // Measure from the most recent "ping-pacing anchor" — whichever
            // is later of last recv activity or last ping we sent.  Without
            // this, spinning off a PING would keep hb_remaining pinned at 0.
            int64 anchor_ms = last_recv_activity_ms;
            if (last_ping_sent_ms > anchor_ms) {
                anchor_ms = last_ping_sent_ms;
            }
            int64 hb_remaining = heartbeat_interval_ms - (monotonicMs() - anchor_ms);
            if (hb_remaining <= 0) {
                hb_remaining = 1;
            }
            if (poll_timeout == 0 || hb_remaining < poll_timeout) {
                poll_timeout = hb_remaining;
            }
        }
        // schedule a poll for the idle-timeout deadline so the idle check fires even when heartbeat is disabled
        if (idle_timeout_ms > 0 && ws_state == WsState::CONNECTED && last_recv_activity_ms > 0) {
            int64 idle_remaining = idle_timeout_ms - (monotonicMs() - last_recv_activity_ms);
            if (idle_remaining <= 0) {
                idle_remaining = 1;
            }
            if (poll_timeout == 0 || idle_remaining < poll_timeout) {
                poll_timeout = idle_remaining;
            }
        }
        // wake at the close deadline of a close the server started
        if (waitsForPeerClose() && close_deadline_us) {
            // rounded up, so the wake is not before the deadline
            int64 close_remaining = (close_deadline_us - q_clock_getmicros_monotonic() + 999) / 1000;
            if (close_remaining <= 0) {
                close_remaining = 1;
            }
            if (poll_timeout == 0 || close_remaining < poll_timeout) {
                poll_timeout = close_remaining;
            }
        }
        if (poll_timeout > 0) {
            result->setKeyValue("poll_timeout_ms", poll_timeout, xsink);
        }
    }
    return result;
}

void HttpWebSocketPollOperationPriv::abort(ExceptionSink* xsink) {
    // Serialize against the I/O-thread continuePoll() which may be mid-way
    // through dispatching to send_op->continuePoll() / recv_op->continuePoll().
    // Without this, the non-atomic check+deref+null in releaseSendOp() /
    // releaseRecvOp() races with continuePoll's own release calls and can
    // double-deref the inner op (refcount 0 -> -1 trips
    // QoreReferenceCounter::ROdereference()).
    AutoLocker al(m);
    setWsStateValue(WsState::CLOSED);
    releaseSendOp(xsink);
    releaseRecvOp(xsink);
}

QoreValue HttpWebSocketPollOperationPriv::getOutput() const {
    ExceptionSink xsink;
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), &xsink);
    h->setKeyValue("sock", getReferencedSocketObject(&xsink), &xsink);
    h->setKeyValue("state", new QoreStringNode(getWsState()), &xsink);
    h->setKeyValue("close_code", static_cast<int64>(close_code), &xsink);
    // the close reason and the error are read in one snapshot, under the lock that their writers hold (not with
    // getCloseReason() and getErrorInfo(): the hold points of their debug builds are for the reads of other threads)
    std::string reason;
    QoreHashNode* err;
    {
        AutoLocker al(error_lock);
        reason = close_reason;
        err = error_info;
        if (err) {
            err->ref();
        }
    }
    // the close reason is UTF-8: that of a close frame received, or of one that the server sent (see sendClose())
    h->setKeyValue("close_reason", new QoreStringNode(reason, QCS_UTF8), &xsink);
    if (err) {
        h->setKeyValue("error_info", err, &xsink);
    }
    return h.release();
}

const char* HttpWebSocketPollOperationPriv::getStateImpl() const {
    return getWsState();
}

void HttpWebSocketPollOperationPriv::feedDecoder(const void* data, size_t len) {
    const char* p = static_cast<const char*>(data);
    // the payload of a frame rejected on its header is discarded as it arrives (issue #5878)
    if (skip_bytes) {
        size_t n = skip_bytes < len ? static_cast<size_t>(skip_bytes) : len;
        skip_bytes -= n;
        p += n;
        len -= n;
    }
    if (len) {
        decoder.appendData(p, len);
    }
}

void HttpWebSocketPollOperationPriv::rejectMessage(uint16_t code, const char* reason, ExceptionSink* xsink) {
    // what was received of the message is discarded, and so are the data frames that follow (issue #5878)
    reassembler.clear(xsink);
    fragment_bytes = 0;
    queueSendClose(code, reason, xsink);
}

void HttpWebSocketPollOperationPriv::failConnection(uint16_t code, const char* reason, const char* desc,
        ExceptionSink* xsink) {
    rejectMessage(code, reason, xsink);
    if (*xsink) {
        return;
    }
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("type", new QoreStringNode("error"), xsink);
    h->setKeyValue("code", static_cast<int64>(code), xsink);
    h->setKeyValue("reason", new QoreStringNode(desc, QCS_UTF8), xsink);
    recv_queue->push(xsink, h.release());
    ++frames_pushed_in_cycle;
}

bool HttpWebSocketPollOperationPriv::rejectOversizedFrame(ExceptionSink* xsink) {
    WsFrameHeader h;
    if (!decoder.peekHeader(h)) {
        return false;
    }
    bool data = h.opcode == WSOP_TEXT || h.opcode == WSOP_BINARY || h.opcode == WSOP_CONTINUATION;
    bool control = h.opcode == WSOP_CLOSE || h.opcode == WSOP_PING || h.opcode == WSOP_PONG;
    // an invalid length, a control frame over 125 bytes (RFC 6455 section 5.5) or a reserved opcode is a protocol
    // error: the stream cannot be resynchronized after it, so everything that follows is discarded
    if (h.invalid_length || (!data && !control) || (control && h.payload_len > 125)) {
        decoder.clear();
        skip_bytes = UINT64_MAX;
        protocol_failed = true;
        protocol_reason = h.invalid_length ? "Invalid frame length"
            : (control ? "Control frame too big" : "Reserved opcode");
        rejectMessage(WSCC_ProtocolError, protocol_reason.c_str(), xsink);
        return true;
    }
    if (!data) {
        return false;
    }
    // the size of the message so far plus the frame's, without overflow
    uint64_t so_far = h.opcode == WSOP_CONTINUATION ? fragment_bytes : 0;
    if (h.payload_len <= max_frame_size && so_far <= max_frame_size - h.payload_len) {
        return false;
    }
    // the frame is rejected before its payload is buffered: its header and the payload received so far are
    // discarded now, and the rest as it arrives; the length is valid, so the frame's size does not wrap
    uint64_t frame_bytes = h.header_size + h.payload_len;
    size_t avail = decoder.bufferedBytes();
    size_t n = decoder.discardBytes(frame_bytes < avail ? static_cast<size_t>(frame_bytes) : avail);
    skip_bytes = frame_bytes - n;
    rejectMessage(WSCC_MessageTooBig, "Message too big", xsink);
    return true;
}

void HttpWebSocketPollOperationPriv::processDecodedFrames(ExceptionSink* xsink) {
    while (true) {
        // a frame whose declared length is over the limit is rejected on its header (issue #5878)
        if (rejectOversizedFrame(xsink)) {
            if (*xsink) {
                return;
            }
            continue;
        }
        if (!decoder.hasCompleteFrame()) {
            break;
        }
        WsFrame frame = decoder.nextFrame(xsink);
        if (*xsink) {
            // Protocol error — transition to error state
            setWsStateValue(WsState::ERROR);
            if (frame.payload) {
                frame.payload->deref(xsink);
            }
            return;
        }

        // Check frame size limit
        if (frame.payload && frame.payload->size() > max_frame_size) {
            if (frame.payload) {
                frame.payload->deref(xsink);
            }
            // Send close with 1009 (Message Too Big)
            rejectMessage(WSCC_MessageTooBig, "Message too big", xsink);
            return;
        }

        handleFrame(frame, xsink);

        // Deref the frame payload — handleFrame copies what it needs
        if (frame.payload) {
            frame.payload->deref(xsink);
        }

        if (*xsink || goalReached()) {
            return;
        }
    }
}

void HttpWebSocketPollOperationPriv::handleFrame(const WsFrame& frame, ExceptionSink* xsink) {
    // an RSV bit on a control frame, or RSV1 on a continuation frame, fails the connection whatever extensions are
    // negotiated (RFC 6455 section 5.2, RFC 7692 section 6.1; qore#6781)
    if (const char* rsv_error = q_ws_rsv_position_error(frame.opcode, frame.rsv)) {
        failConnection(WSCC_ProtocolError, "Invalid RSV bits", rsv_error, xsink);
        return;
    }

    // Control frames (PING, PONG, CLOSE) are never fragmented per RFC 6455
    if (frame.opcode >= WSOP_CLOSE) {
        switch (frame.opcode) {
            case WSOP_PING: {
                // Auto-pong: encode a PONG with the same payload and queue it
                SimpleRefHolder<BinaryNode> pong(
                    WebSocketFrameEncoder::encodePong(
                        frame.payload ? frame.payload->getPtr() : nullptr,
                        frame.payload ? frame.payload->size() : 0,
                        false  // server->client: no masking
                    )
                );
                send_queue->push(xsink, pong.release());
                if (*xsink) {
                    return;
                }
                // Also push to recv_queue so the Qore handler sees the ping
                pushRecvFrame("ping", frame.payload ? frame.payload->refSelf() : nullptr, frame.rsv, xsink);
                break;
            }

            case WSOP_PONG: {
                pushRecvFrame("pong", frame.payload ? frame.payload->refSelf() : nullptr, frame.rsv, xsink);
                break;
            }

            case WSOP_CLOSE: {
                // a second close frame is ignored
                if (close_received) {
                    break;
                }
                // the close code and reason, checked (qore#6755, qore#6604)
                uint16_t code;
                std::string reason;
                const char* error = nullptr;
                uint16_t fail = q_ws_parse_close_payload(frame.payload ? frame.payload->getPtr() : nullptr,
                    frame.payload ? frame.payload->size() : 0, code, reason, error);
                if (fail) {
                    // a close frame that is not valid fails the connection (RFC 6455 section 7.1.7): it is answered
                    // with a close frame with the error's code, after which the connection ends; the close code and
                    // reason are the error's, also when the server started the close
                    failConnection(fail, error, error, xsink);
                    close_received = true;
                    close_code = fail;
                    setCloseReason(error);
                    break;
                }
                close_received = true;
                // the close code and reason are those of the client's close frame (RFC 6455 sections 7.1.5 and
                // 7.1.6), also after a close the server started; when the client answers the server's close with
                // the same code and no reason, the server's reason is kept, so that a close for an error (for
                // example 1009 for a message that is too big) keeps its description (issue #5861)
                if (!(close_sent && reason.empty() && code == close_code)) {
                    setCloseReason(reason);
                }
                close_code = code;

                // Push close frame to recv_queue
                pushRecvCloseFrame(code, reason.c_str(), xsink);
                if (*xsink) {
                    return;
                }

                // For peer-initiated close: the close echo is sent by the
                // Qore onPollComplete handler AFTER processing all data frames.
                // This ensures echo responses are sent before the close frame.
                // For server-initiated close (close_sent=true): the close
                // frame was already sent, so no echo is needed, and the handshake is complete.
                setWsStateValue(WsState::CLOSING);
                break;
            }

            default:
                break;
        }
        return;
    }

    // Data frames received after the server's close frame was sent are discarded: the server started closing, so
    // the connection's handler gets no more messages
    if (close_sent) {
        return;
    }

    // an RSV bit that no negotiated extension defines fails the connection (RFC 6455 section 5.2); it is checked here
    // so that it holds for the echo fast path too, which hands no frame to the Qore code; a message with RSV1 set is
    // otherwise taken as compressed, and its text is not checked here (qore#6604)
    if (frame.rsv & ~extension_rsv_mask) {
        QoreStringMaker desc("a data frame has RSV bits 0x%x set that no negotiated extension defines",
            static_cast<unsigned>(frame.rsv & ~extension_rsv_mask));
        failConnection(WSCC_ProtocolError, "Invalid RSV bits", desc.c_str(), xsink);
        return;
    }

    // a fragmented message is checked as its fragments arrive, not once it is complete (issue #5861)
    if (frame.opcode == WSOP_CONTINUATION || !frame.fin) {
        size_t total = (frame.opcode == WSOP_CONTINUATION ? fragment_bytes : 0)
            + (frame.payload ? frame.payload->size() : 0);
        if (total > max_frame_size) {
            fragment_bytes = 0;
            rejectMessage(WSCC_MessageTooBig, "Message too big", xsink);
            return;
        }
        fragment_bytes = frame.fin ? 0 : total;
    }

    // Data frames: use reassembler for fragmentation support
    bool complete = reassembler.processFrame(frame, xsink);
    if (*xsink) {
        setWsStateValue(WsState::ERROR);
        return;
    }

    if (complete) {
        WsOpcode msg_opcode = frame.opcode;
        uint8_t msg_rsv = frame.rsv;
        const void* msg_data = nullptr;
        size_t msg_len = 0;
        SimpleRefHolder<BinaryNode> reassembled_payload;

        if (reassembler.isFragmenting() || frame.opcode == WSOP_CONTINUATION) {
            // Reassembled fragmented message
            reassembled_payload = reassembler.getCompleteMessage(msg_opcode, msg_rsv);
            if (*reassembled_payload) {
                msg_data = reassembled_payload->getPtr();
                msg_len = reassembled_payload->size();
            }
        } else if (frame.payload) {
            msg_data = frame.payload->getPtr();
            msg_len = frame.payload->size();
        }

        // a text message that is not valid UTF-8 fails the connection with 1007 before anything sees it: the echo
        // fast path and the connection's code, gotRawMessage() included (RFC 6455 section 8.1, qore#6604); a
        // compressed message (RSV1 set, permessage-deflate) is checked once it is decompressed
        if (msg_opcode == WSOP_TEXT && !(msg_rsv & 4) && !q_ws_utf8_valid(msg_data, msg_len)) {
            QoreStringMaker desc("a text message of " QLLD " bytes is not valid UTF-8", static_cast<int64>(msg_len));
            failConnection(WSCC_InvalidPayload, "Invalid UTF-8 in a text message", desc.c_str(), xsink);
            return;
        }

        // I/O-thread fast path: handle the frame in C++ without context switch
        if (io_frame_handler) {
            // Raw-bytes dispatch: handlers that can process raw bytes (e.g., echo)
            // override handleFrameRaw() to skip wrapper allocation + copy.  The
            // base-class default wraps the bytes in a QoreStringNode/BinaryNode
            // and calls handleTextFrame/handleBinaryFrame for backward compat.
            BinaryNode* response = io_frame_handler->handleFrameRaw(
                static_cast<WsOpcode>(msg_opcode), msg_data, msg_len, msg_rsv, xsink);
            if (response && !*xsink) {
                if (*pending_send) {
                    pending_send->append(response);
                    response->deref(xsink);
                } else {
                    pending_send = response;
                }
            } else if (response) {
                response->deref(xsink);
            }
            last_recv_activity_ms = monotonicMs();
            return;
        }

        // Standard path: push to recv_queue for worker thread processing
        if (msg_opcode == WSOP_TEXT) {
            QoreStringNode* text = msg_data
                ? new QoreStringNode(reinterpret_cast<const char*>(msg_data),
                    msg_len, QCS_UTF8)
                : new QoreStringNode(QCS_UTF8);
            pushRecvFrame("text", text, msg_rsv, xsink);
        } else if (msg_opcode == WSOP_BINARY) {
            // Must copy the data — frame.payload still owns the pointer
            BinaryNode* bin = new BinaryNode();
            if (msg_data) {
                bin->append(msg_data, msg_len);
            }
            pushRecvFrame("binary", bin, msg_rsv, xsink);
        }
    }
    // If not complete, more fragments expected — nothing to push yet
}

void HttpWebSocketPollOperationPriv::pushRecvFrame(const char* type, AbstractQoreNode* data,
        uint8_t rsv, ExceptionSink* xsink) {
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("type", new QoreStringNode(type), xsink);
    if (data) {
        h->setKeyValue("data", data, xsink);
    }
    h->setKeyValue("rsv1", (rsv & 4) != 0, xsink);
    h->setKeyValue("rsv2", (rsv & 2) != 0, xsink);
    h->setKeyValue("rsv3", (rsv & 1) != 0, xsink);
    recv_queue->push(xsink, h.release());
    ++frames_pushed_in_cycle;
    last_recv_activity_ms = monotonicMs();
}

void HttpWebSocketPollOperationPriv::pushRecvCloseFrame(uint16_t code, const char* reason,
        ExceptionSink* xsink) {
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("type", new QoreStringNode("close"), xsink);
    h->setKeyValue("code", static_cast<int64>(code), xsink);
    // the reason of a close frame is UTF-8 (RFC 6455 section 5.5.1)
    h->setKeyValue("reason", new QoreStringNode(reason ? reason : "", QCS_UTF8), xsink);
    recv_queue->push(xsink, h.release());
    ++frames_pushed_in_cycle;
    last_recv_activity_ms = monotonicMs();
}

void HttpWebSocketPollOperationPriv::queueSendText(const QoreStringNode* text, ExceptionSink* xsink) {
    // a text message is UTF-8 (RFC 6455 section 5.6): a string in another encoding is converted (qore#6775)
    TempEncodingHelper utf8(text, QCS_UTF8, xsink);
    if (*xsink) {
        return;
    }
    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encode(WSOP_TEXT,
            utf8->c_str(), utf8->size(), true, false)
    );
    send_queue->push(xsink, frame.release());
}

void HttpWebSocketPollOperationPriv::queueSendBinary(const BinaryNode* data, ExceptionSink* xsink) {
    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encode(WSOP_BINARY,
            data->getPtr(), data->size(), true, false)
    );
    send_queue->push(xsink, frame.release());
}

void HttpWebSocketPollOperationPriv::queueSendPing(const BinaryNode* data, ExceptionSink* xsink) {
    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encode(WSOP_PING,
            data ? data->getPtr() : nullptr,
            data ? data->size() : 0,
            true, false)
    );
    send_queue->push(xsink, frame.release());
}

void HttpWebSocketPollOperationPriv::queueSendClose(uint16_t code, const char* reason,
        ExceptionSink* xsink) {
    // an endpoint sends one close frame; a closed connection sends none
    if (close_sent || ws_state == WsState::CLOSED || ws_state == WsState::ERROR) {
        return;
    }
    close_sent = true;
    // no data frame may follow the close frame (RFC 6455 section 5.5.1)
    closing.store(true, std::memory_order_release);
    if (!close_received) {
        // a close the server starts; the echo of the client's close frame keeps the client's code and reason
        close_code = code;
        setCloseReason(reason ? reason : "");
    }

    SimpleRefHolder<BinaryNode> frame(
        WebSocketFrameEncoder::encodeClose(code, reason, false)
    );
    send_queue->push(xsink, frame.release());
    if (!*xsink) {
        setWsStateValue(WsState::CLOSING);
    }
}

void HttpWebSocketPollOperationPriv::queueSendCloseExternal(uint16_t code, const char* reason,
        ExceptionSink* xsink) {
    AutoLocker al(m);
    queueSendClose(code, reason, xsink);
}

QoreValue HttpWebSocketPollOperationPriv::getReceivedFrame(ExceptionSink* xsink) {
    if (recv_queue->empty()) {
        return QoreValue();
    }
    bool timed_out = false;
    QoreValue val = recv_queue->shift(xsink, -1, &timed_out);
    if (*xsink || timed_out) {
        if (*xsink) {
            xsink->clear();
        }
        return QoreValue();
    }
    return val;
}

void HttpWebSocketPollOperationPriv::queueSendRawFrame(const BinaryNode* data, ExceptionSink* xsink) {
    send_queue->push(xsink, data->refSelf());
}

void HttpWebSocketPollOperationPriv::setFrameCallback(ResolvedCallReferenceNode* cb, ExceptionSink* xsink) {
    // the options of the code that sets the callback, which it runs with (qore#6208); the old ones are released
    // after the lock, as their references to Programs can be the last ones
    QoreThreadRuntimeParseOptions po = cb ? QoreThreadRuntimeParseOptions::capture() : QoreThreadRuntimeParseOptions();
    {
        AutoLocker al(m);
        if (frame_callback) {
            frame_callback->deref(xsink);
        }
        frame_callback = cb;
        std::swap(frame_callback_po.po, po.po);
        std::swap(frame_callback_po.override, po.override);
        // the callback runs for the code that set it, with its restrictions (qore#6844)
        std::swap(frame_callback_po.caller_domain_restrictions, po.caller_domain_restrictions);
    }
}

void HttpWebSocketPollOperationPriv::dispatchFrameCallback(ExceptionSink* xsink) {
    ReferenceHolder<ResolvedCallReferenceNode> cb(xsink);
    QoreThreadRuntimeParseOptions cb_po;
    {
        AutoLocker al(m);
        if (frame_callback) {
            cb = frame_callback->refRefSelf();
            cb_po = frame_callback_po;
        }
    }
    if (cb) {
        // the callback runs with the options of the code that set it (qore#6208)
        QoreThreadRuntimeParseOptionsHelper po_helper(&cb_po);
        ValueHolder rv(cb->invoke(nullptr, xsink), xsink);
    }
}

void HttpWebSocketPollOperationPriv::drainSendQueue(ExceptionSink* xsink) {
    // Drain all available frames from the send queue into pending_send
    // Note: Queue::shift(xsink, 0) waits forever; use negative timeout for non-blocking
    while (!send_queue->empty()) {
        bool timed_out = false;
        QoreValue val = send_queue->shift(xsink, -1, &timed_out);
        if (*xsink) {
            return;
        }
        if (timed_out || val.isNothing()) {
            break;
        }
        if (val.getType() == NT_BINARY) {
            const BinaryNode* bin = val.get<const BinaryNode>();
            if (bin && bin->size() > 0) {
                // each entry is one encoded frame; the opcode is in the low bits of its first byte.  No data frame
                // follows a close frame (RFC 6455 section 5.5.1): a data frame queued by another thread after the
                // close frame was queued is dropped
                uint8_t opcode = static_cast<const uint8_t*>(bin->getPtr())[0] & 0x0f;
                if (opcode == WSOP_CLOSE) {
                    close_frame_queued = true;
                } else if (close_frame_queued && opcode < WSOP_CLOSE) {
                    val.discard(xsink);
                    continue;
                }
                if (!pending_send) {
                    pending_send = new BinaryNode();
                }
                pending_send->append(bin->getPtr(), bin->size());
            }
        }
        val.discard(xsink);
    }
}

int HttpWebSocketPollOperationPriv::checkDataSend(ExceptionSink* xsink) const {
    if (closing.load(std::memory_order_acquire)) {
        xsink->raiseException("WEBSOCKET-CLOSING-ERROR", "cannot send a data frame on a WebSocket connection whose "
            "close handshake has started; no data frame may follow a close frame (RFC 6455 section 5.5.1)");
        return -1;
    }
    return 0;
}

int HttpWebSocketPollOperationPriv::checkClosing(ExceptionSink* xsink) {
    if (ws_state != WsState::CLOSING || send_op || !send_queue->empty()) {
        return 0;
    }
    // after a protocol error of the client, the connection ends once the close frame is written: the client's close
    // frame cannot be read any more (RFC 6455 section 7.1.7, issue #5878)
    if (protocol_failed) {
        setClosed(WSCC_ProtocolError, protocol_reason.c_str());
        return -1;
    }
    // the connection is lost, or both close frames have been exchanged and ours has been written
    if (!sock->isOpen() || (close_sent && close_received)) {
        // the close reason that is stored stays (passed as a C string, it would be cut at a NUL character)
        setClosed(close_code, nullptr);
        return -1;
    }
    if (waitsForPeerClose()) {
        // the server's close frame has been written: the wait for the client's close frame starts; without a close
        // timeout, the server does not wait
        int64 now_us = q_clock_getmicros_monotonic();
        if (!close_deadline_us) {
            close_deadline_us = now_us + close_timeout_ms * 1000;
        }
        if (now_us >= close_deadline_us) {
            // no close frame was received, so the close code is 1006, which is never sent in a close frame
            // (RFC 6455 section 7.4.1)
            setClosed(1006, "close handshake timed out");
            return -1;
        }
    }
    return 0;
}

int HttpWebSocketPollOperationPriv::startRecvOp(ExceptionSink* xsink) {
    assert(!recv_op);
    sock->ref();
    recv_op = new SocketRecvDataPollOperation(xsink, sock, false);
    if (*xsink) {
        recv_op->deref(xsink);
        recv_op = nullptr;
        setError(xsink);
        return -1;
    }
    // Set our QoreObject as the inner op's self for poll info resolution
    assert(self);
    recv_op->setSelf(*self);
    return 0;
}

int HttpWebSocketPollOperationPriv::startSendOp(ExceptionSink* xsink) {
    assert(!send_op);
    assert(pending_send);
    assert(pending_send->size() > 0);

    // Transfer ownership of pending_send to the send operation
    BinaryNode* data = pending_send.release();
    sock->ref();
    send_op = new SocketSendPollOperation(xsink, data, sock);
    if (*xsink) {
        send_op->deref(xsink);
        send_op = nullptr;
        setError(xsink);
        return -1;
    }
    // Set our QoreObject as the inner op's self for poll info resolution
    assert(self);
    send_op->setSelf(*self);
    send_op_start_ms = monotonicMs();
    return 0;
}

void HttpWebSocketPollOperationPriv::releaseSendOp(ExceptionSink* xsink) {
    // Caller must hold m (continuePoll/abort/cleanup-from-dtor).  Capture-then-
    // null-then-deref makes the helper idempotent and safe to call from any
    // path that holds the mutex: even if the deref() itself is lengthy, no
    // other caller can observe a non-null send_op pointing at a freed object.
    SocketSendPollOperation* op = send_op;
    send_op = nullptr;
    send_op_start_ms = 0;
    if (op) {
        // the time until the next send is not time waiting for the peer
        send_bytes_done += static_cast<int64>(op->getBytesSent());
        // a send that never waited is sampled only now and then, to learn how much the peer's buffers hold: this is
        // the path of every message
        if (send_rate.enabled()) {
            int64 now_ms = monotonicMs();
            if (send_op_waited || now_ms - send_rate_sample_ms >= SendRateSampleMs) {
                send_rate_sample_ms = now_ms;
                int64 delivered = send_bytes_done - qore_socket_object_private(sock).getUnacknowledgedSendBytes();
                // a wait that used up the credit between two checks is decided here, so that no verdict is left
                // for a later send
                send_rate_below = send_rate.update(delivered > 0 ? delivered : 0, false, now_ms);
            }
        }
        send_op_waited = false;
        op->deref(xsink);
    }
}

void HttpWebSocketPollOperationPriv::releaseRecvOp(ExceptionSink* xsink) {
    // Caller must hold m; see releaseSendOp() for the rationale.
    SocketRecvDataPollOperation* op = recv_op;
    recv_op = nullptr;
    if (op) {
        op->deref(xsink);
    }
}

void HttpWebSocketPollOperationPriv::setError(ExceptionSink* xsink) {
    // the state is set after the error (below), so that a thread that sees the error state also sees the error
    if (!hasError()) {
        ExceptionSink save_xsink;
        // the hash is complete before it is recorded
        ReferenceHolder<QoreHashNode> info(new QoreHashNode(autoTypeInfo), &save_xsink);
        const QoreValue err_val = xsink->getExceptionErr();
        if (err_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper err(err_val);
            info->setKeyValue("err",
                err.getReferencedValue(), &save_xsink);
        }
        const QoreValue desc_val = xsink->getExceptionDesc();
        if (desc_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper desc(desc_val);
            info->setKeyValue("desc",
                desc.getReferencedValue(), &save_xsink);
        }
        AutoLocker al(error_lock);
        if (!error_info) {
#ifdef DEBUG
            // a test holds the thread here, in the critical section, to read the error from another thread
            qore_dbg_http_hold(QoreDbgHttpHoldPoint::ErrorRecord, *self);
#endif
            error_info = info.release();
            has_error.store(true, std::memory_order_release);
        }
    }
    setWsStateValue(WsState::ERROR);
}

bool HttpWebSocketPollOperationPriv::hasError() const {
    return has_error.load(std::memory_order_acquire);
}

QoreHashNode* HttpWebSocketPollOperationPriv::getErrorInfo() const {
    // a read that finds the lock taken releases a thread that a test holds while it records the error
    QoreRecordedValueReadLocker al(error_lock, *self);
    if (error_info) {
        error_info->ref();
    }
    return error_info;
}

void HttpWebSocketPollOperationPriv::setClosed(uint16_t code, const char* reason) {
    setWsStateValue(WsState::CLOSED);
    close_code = code;
    if (reason) {
        setCloseReason(reason);
    }
}

void HttpWebSocketPollOperationPriv::setCloseReason(const std::string& reason) {
    // the new reason is complete before it is stored; a reason that does not change is not stored again
    std::string new_reason = reason;
    AutoLocker al(error_lock);
    if (new_reason == close_reason) {
        return;
    }
#ifdef DEBUG
    // a test holds the thread here, in the critical section, to read the close reason from another thread
    qore_dbg_http_hold(QoreDbgHttpHoldPoint::ValueRecord, *self);
#endif
    close_reason.swap(new_reason);
}

std::string HttpWebSocketPollOperationPriv::getCloseReason() const {
    // a read that finds the lock taken releases a thread that a test holds while it stores the close reason
    QoreRecordedValueReadLocker al(error_lock, *self, true);
    return close_reason;
}

void HttpWebSocketPollOperationPriv::cleanup(ExceptionSink* xsink) {
    // Serialize against the I/O-thread continuePoll().  Called from the
    // QPP destructor (where the user thread races the I/O thread) and from
    // ~HttpWebSocketPollOperationPriv() (where refcount is already 0 and the
    // acquisition is uncontended); both paths are safe.
    AutoLocker al(m);
    releaseSendOp(xsink);
    releaseRecvOp(xsink);
    reassembler.clear(xsink);
    decoder.clear();
    skip_bytes = 0;
    fragment_bytes = 0;
    protocol_failed = false;
    protocol_reason.clear();

    if (recv_queue) {
        recv_queue->deref(xsink);
        recv_queue = nullptr;
    }
    if (recv_queue_obj) {
        recv_queue_obj->deref(xsink);
        recv_queue_obj = nullptr;
    }
    if (send_queue) {
        send_queue->deref(xsink);
        send_queue = nullptr;
    }
    if (send_queue_obj) {
        send_queue_obj->deref(xsink);
        send_queue_obj = nullptr;
    }
    if (frame_callback) {
        frame_callback->deref(xsink);
        frame_callback = nullptr;
    }
    if (io_frame_handler) {
        io_frame_handler->deref(xsink);
        io_frame_handler = nullptr;
    }
    // the recorded error is taken under the lock that its readers hold, and released after it
    QoreHashNode* old_error_info;
    {
        AutoLocker al(error_lock);
        old_error_info = error_info;
        error_info = nullptr;
        has_error.store(false, std::memory_order_release);
    }
    if (old_error_info) {
        old_error_info->deref(xsink);
    }
    if (sock) {
        sock->deref(xsink);
        sock = nullptr;
    }
}

/** @endcond */

//! C++ base class for WebSocket server-side poll operation
/** This class implements the core WebSocket frame I/O state machine in pure
    C++, enabling the AsyncIoController I/O thread to drive the poll without
    Qore interpreter overhead.

    The C++ base handles:
    - Frame decoding via WebSocketFrameDecoder and fragment reassembly
    - Frame encoding via WebSocketFrameEncoder
    - Automatic PONG responses to PING frames
    - Close handshake per RFC 6455
    - Non-blocking send/recv via inner SocketSendPollOperation and
      SocketRecvDataPollOperation

    State machine: CONNECTED -> CLOSING -> CLOSED / ERROR

    Communication between the Qore handler and the I/O thread uses two
    thread-safe Queues:
    - recv_queue: decoded frames pushed by C++ (I/O thread), read by handler
    - send_queue: pre-encoded frame bytes pushed by handler, sent by C++ (I/O thread)

    The Qore wrapper (HttpWebSocketPollOperation) adds:
    - High-level API (sendText, sendBinary, sendPing, sendClose, getReceivedFrame)
    - Completion context for HttpConnectionPollOperationBase
    - Channel integration for the WebSocket handler

    @since %Qore 3.0
*/
qclass HttpWebSocketPollOperationBase [
    internal_members=object recv_queue,object send_queue;
    ns=Qore;
    dom=NETWORK;
    arg=HttpWebSocketPollOperationPriv* priv;
    vparent=SocketPollOperationBase<hash<auto>>
];

//! Creates the WebSocket poll operation base
/** @param socket the WebSocket Socket (after upgrade handshake complete)

    Creates internal recv and send Queues for communication between the I/O
    thread and handler threads.
*/
HttpWebSocketPollOperationBase::constructor(Socket[QoreSocketObject] socket) [flags=NAMED_ARGS] {
    QoreSocketObject* sock_ptr = *socket;

    // Store socket as Qore member for DGC visibility
    QoreValue sock_arg = args->retrieveEntry(0);
    QoreObject* sock_qobj = sock_arg.getType() == NT_OBJECT
        ? const_cast<QoreObject*>(sock_arg.get<const QoreObject>()) : nullptr;
    if (sock_qobj) {
        qore_poll_op_set_member(self, "sock", sock_qobj->refSelf(), xsink);
    }
    qore_poll_op_set_member(self, "goal", new QoreStringNode("websocket"), xsink);

    // Create recv and send queues (unlimited)
    Queue* recv_q = new Queue(-1);
    QoreObject* recv_q_obj = new QoreObject(QC_QUEUE, getProgram(), recv_q);
    recv_q->ref();  // Extra ref for the C++ priv

    Queue* send_q = new Queue(-1);
    QoreObject* send_q_obj = new QoreObject(QC_QUEUE, getProgram(), send_q);
    send_q->ref();  // Extra ref for the C++ priv

    // Store queue objects as members for DGC visibility
    self->setMemberValue("recv_queue", QC_HTTPWEBSOCKETPOLLOPERATIONBASE, recv_q_obj->refSelf(), xsink);
    self->setMemberValue("send_queue", QC_HTTPWEBSOCKETPOLLOPERATIONBASE, send_q_obj->refSelf(), xsink);

    sock_ptr->ref();

    self->setPrivate(CID_HTTPWEBSOCKETPOLLOPERATIONBASE,
        new HttpWebSocketPollOperationPriv(self, sock_ptr,
            recv_q, recv_q_obj, send_q, send_q_obj));
}

//! Destroys the object
/** Releases all internal references.
*/
HttpWebSocketPollOperationBase::destructor() {
    // the operation's state is released with its last reference, which an async I/O controller that continues the
    // operation can hold; the controller cancels the operation
    qore_socket_poll_op_object_deleted(priv);
    priv->deref(xsink);
}

//! Throws an exception; objects of this class cannot be copied
/** @throw HTTPWEBSOCKETPOLLOPERATIONBASE-COPY-ERROR objects of this class cannot be copied
*/
HttpWebSocketPollOperationBase::copy() {
    xsink->raiseException("HTTPWEBSOCKETPOLLOPERATIONBASE-COPY-ERROR",
        "objects of this class cannot be copied");
}

//! Returns the goal of the operation
/** @return "websocket"
*/
string HttpWebSocketPollOperationBase::getGoal() {
    return qore_poll_op_get_referenced_member(self, "goal", xsink);
}

//! Returns the current state
/** @return one of "connected", "closing", "closed", or "error"
*/
string HttpWebSocketPollOperationBase::getState() [flags=RET_VALUE_ONLY] {
    return priv->getState();
}

//! Returns True when the connection is closed or in error
/** @return True when the state is CLOSED or ERROR
*/
bool HttpWebSocketPollOperationBase::goalReached() [flags=RET_VALUE_ONLY] {
    return priv->goalReached();
}

//! Continues the poll operation
/** Drives the WebSocket I/O state machine: receives frames, processes
    control frames, sends queued frames.

    @return socket poll info for the next poll cycle, or @ref nothing if polling is complete
*/
*hash<SocketPollInfo> HttpWebSocketPollOperationBase::continuePoll() {
    return priv->continuePoll(xsink);
}

//! Aborts the operation
/** Transitions to CLOSED state and releases all inner operations.
*/
nothing HttpWebSocketPollOperationBase::abort() {
    priv->abort(xsink);
}

//! Returns the output of the operation
/** @return hash with sock, state, close_code, close_reason, error_info
*/
hash<auto> HttpWebSocketPollOperationBase::getOutput() [flags=RET_VALUE_ONLY] {
    return priv->getOutput();
}

//! Sends a text message
/** The text is encoded as a WebSocket TEXT frame and queued for sending.
    Thread-safe: can be called from any thread.

    @param text the text to send; a string in another encoding is converted to UTF-8, as a WebSocket text message is
    UTF-8 (RFC 6455 section 5.6; qore#6775)
    @throw WEBSOCKET-CLOSING-ERROR the close handshake has started (the server's close frame was queued, or the
    connection has closed): no data frame may follow a close frame (RFC 6455 section 5.5.1)
*/
nothing HttpWebSocketPollOperationBase::sendText(string text) [flags=NAMED_ARGS] {
    if (priv->checkDataSend(xsink)) {
        return QoreValue();
    }
    priv->queueSendText(text, xsink);
}

//! Sends a binary message
/** The data is encoded as a WebSocket BINARY frame and queued for sending.
    Thread-safe: can be called from any thread.

    @param data the binary data to send
    @throw WEBSOCKET-CLOSING-ERROR the close handshake has started (the server's close frame was queued, or the
    connection has closed): no data frame may follow a close frame (RFC 6455 section 5.5.1)
*/
nothing HttpWebSocketPollOperationBase::sendBinary(binary data) [flags=NAMED_ARGS] {
    if (priv->checkDataSend(xsink)) {
        return QoreValue();
    }
    priv->queueSendBinary(data, xsink);
}

//! Sends a ping frame
/** The ping is encoded as a WebSocket PING frame and queued for sending.
    Thread-safe: can be called from any thread.

    @param payload optional ping payload
*/
nothing HttpWebSocketPollOperationBase::sendPing(*binary payload) [flags=NAMED_ARGS] {
    priv->queueSendPing(payload, xsink);
}

//! Initiates the close handshake
/** Sends a WebSocket CLOSE frame with the given code and reason.
    Transitions the state to CLOSING.
    Thread-safe: can be called from any thread.

    A close started by the server completes when the client's CLOSE frame arrives (RFC 6455 section 5.5.1): once
    its own CLOSE frame has been written, the operation reads on until then, discarding the data frames it receives,
    and then ends; the server then closes the TCP connection (RFC 6455 section 7.1.1).  The operation also ends when
    the connection is lost, or when the client's CLOSE frame does not arrive within the close timeout (see
    @ref setCloseTimeout()), with the close code 1006 and the reason \c "close handshake timed out".  After a close
    handshake, @ref getCloseCode() and @ref getCloseReason() return the code and reason of the client's CLOSE frame
    (RFC 6455 sections 7.1.5 and 7.1.6).  A call made after the server's CLOSE frame was queued has no effect: an
    endpoint sends one CLOSE frame.  A call made after the client's CLOSE frame arrived sends the answer to it.

    @param code the close code (default 1000 = normal closure); 1005 and 1006 are never sent in a CLOSE frame (RFC
    6455 section 7.4.1): with one of them, the frame has no status code and no reason
    @param reason the close reason string (default empty); sent in UTF-8, the encoding of a close reason (RFC 6455
    section 5.5.1): a reason in another encoding is converted

    @throw ENCODING-CONVERSION-ERROR the reason cannot be converted to UTF-8
*/
nothing HttpWebSocketPollOperationBase::sendClose(int code = 1000, string reason = "") [flags=NAMED_ARGS] {
    // the reason of a close frame is UTF-8 (RFC 6455 section 5.5.1; qore#6604)
    TempEncodingHelper utf8_reason(reason, QCS_UTF8, xsink);
    if (*xsink) {
        return QoreValue();
    }
    // Hold the poll-op lock while mutating ws_state / send_queue: queueSendClose()
    // transitions ws_state to CLOSING and pushes the close frame, and continuePoll()
    // (the I/O thread) reads/writes the same state under this lock.  Without it, a
    // server-initiated close from another thread (e.g. a listener stop via
    // WebSocketConnection::stop() -> signalTransportClose()) races with continuePoll:
    // the CLOSING transition can be missed, so the op never reaches CLOSED, its
    // onComplete() never fires, and the handler thread blocked on its done Counter
    // (and the listener's dThreads.wait()) deadlocks.  The internal callers
    // (idle-timeout / message-too-big in continuePoll) already hold m and call
    // queueSendClose() directly, so this is the only entry point that must lock.
    priv->queueSendCloseExternal(static_cast<uint16_t>(code), utf8_reason->c_str(), xsink);
}

//! Sets the maximum frame/message size in bytes
/** Frames larger than this, and fragmented messages whose fragments together exceed it, are rejected with close code
    1009 (Message Too Big).
    @param max_frame_size the maximum size in bytes; 0 or less means the default of 16 MiB
    @since %Qore 3.0
*/
nothing HttpWebSocketPollOperationBase::setMaxFrameSize(int max_frame_size) [flags=NAMED_ARGS] {
    priv->setMaxFrameSize(max_frame_size > 0 ? static_cast<size_t>(max_frame_size) : WS_DEFAULT_MAX_FRAME_SIZE);
}

//! Sets the RSV bits that the extensions negotiated for the connection define
/** A data frame with an RSV bit set that is not in the mask fails the connection with close code 1002 (Protocol
    Error), also in echo mode (see @ref setEchoMode()); without a call, no RSV bit may be set.  Call it before the
    connection is started.

    @param rsv_mask the RSV bits in the positions of the first byte of a frame (@ref WebSocketUtil::WS_RSV1
    "WS_RSV1", @ref WebSocketUtil::WS_RSV2 "WS_RSV2" and @ref WebSocketUtil::WS_RSV3 "WS_RSV3"); other bits are
    ignored

    @since %Qore 3.0
*/
nothing HttpWebSocketPollOperationBase::setExtensionRsvMask(int rsv_mask) [flags=NAMED_ARGS] {
    priv->setExtensionRsvMask(static_cast<uint8_t>((rsv_mask >> 4) & 0x07));
}

//! Gets the next received frame (non-blocking)
/** Returns the next frame from the recv queue, or @ref nothing if none available.
    Thread-safe: can be called from any thread.

    The frame hash has the following keys:
    - \c type: "text", "binary", "ping", "pong", "close", or "error"
    - \c data: string for text frames, binary for binary/ping/pong frames
    - \c rsv1: bool RSV1 bit from the frame header
    - \c rsv2: bool RSV2 bit from the frame header
    - \c rsv3: bool RSV3 bit from the frame header
    - \c code: int close code (only for close and error frames)
    - \c reason: string close reason, UTF-8 (only for close frames), or the description of the error (only for error
      frames)

    An \c "error" frame reports that the operation failed the connection for a frame that is not valid and sent its
    close frame with the code given: 1007 (invalid payload data) for a text message that is not valid UTF-8 (RFC
    6455 section 8.1; a message with the RSV1 bit, compressed with permessage-deflate, is not checked, as its payload
    is compressed), also in echo mode (see @ref setEchoMode()), or for a close frame whose reason is not valid UTF-8,
    and 1002 (protocol error) for a close frame with a one-byte payload or a close code that a close frame may not
    have (RFC 6455 section 7.4: 1005, 1006, 1015, the reserved 1004, below 1000, 1016 - 2999 and above 4999); the
    message or the close frame is not given in a frame

    @return frame info hash or @ref nothing
*/
*hash<auto> HttpWebSocketPollOperationBase::getReceivedFrame() {
    return priv->getReceivedFrame(xsink);
}

//! Returns True if there are received frames waiting
/** Thread-safe: can be called from any thread.

    @return True if the recv queue has frames available
*/
bool HttpWebSocketPollOperationBase::hasReceivedFrames() [flags=RET_VALUE_ONLY] {
    return priv->hasReceivedFrames();
}

//! Returns True if the connection is closed
/** @return True if the state is CLOSED or ERROR
*/
bool HttpWebSocketPollOperationBase::isClosed() [flags=RET_VALUE_ONLY] {
    return priv->isClosed();
}

//! Returns True if an error occurred
/** @return True if error information is available
*/
bool HttpWebSocketPollOperationBase::hasError() [flags=RET_VALUE_ONLY] {
    return priv->hasError();
}

//! Returns error information if an error occurred
/** @return hash with "err" and "desc" keys, or @ref nothing
*/
*hash<auto> HttpWebSocketPollOperationBase::getError() [flags=RET_VALUE_ONLY] {
    return priv->getErrorInfo();
}

//! Returns the WebSocket close code
/** Once a CLOSE frame has been received, this is the code of the client's CLOSE frame (RFC 6455 section 7.1.5),
    also when the server started the close, or 1005 if the frame has no status code; it is 1006 when the connection
    ended without a CLOSE frame from the client.  Before that, it is the code of a close started by the server, if any.

    @return the close code (default 1000)
*/
int HttpWebSocketPollOperationBase::getCloseCode() [flags=RET_VALUE_ONLY] {
    return priv->getCloseCode();
}

//! Returns the WebSocket close reason
/** Once a CLOSE frame has been received, this is the reason of the client's CLOSE frame (RFC 6455 section 7.1.6),
    also when the server started the close; it describes the end when the connection ended without a CLOSE frame
    from the client (see @ref sendClose()).  Before that, it is the reason of a close started by the server, if any.

    @return the close reason string
*/
string HttpWebSocketPollOperationBase::getCloseReason() [flags=RET_VALUE_ONLY] {
    return new QoreStringNode(priv->getCloseReason(), QCS_UTF8);
}

//! Returns the socket being monitored
/** @return the Socket object
*/
Socket HttpWebSocketPollOperationBase::getSocket() {
    return qore_poll_op_get_referenced_member(self, "sock", xsink);
}

//! Queues a pre-encoded raw WebSocket frame for sending
/** Thread-safe: can be called from any thread.

    @param frame_data the pre-encoded frame bytes (as produced by ws_encode_message())

    @throw WEBSOCKET-CLOSING-ERROR \a frame_data is a data frame, and the close handshake has started (the server's
    close frame was queued, or the connection has closed): no data frame may follow a close frame (RFC 6455 section
    5.5.1)
*/
nothing HttpWebSocketPollOperationBase::sendRawFrame(binary frame_data) [flags=NAMED_ARGS] {
    // a data frame (opcode below that of a close frame) is refused once the close handshake has started
    if (frame_data->size() && (static_cast<const uint8_t*>(frame_data->getPtr())[0] & 0x0f) < WSOP_CLOSE
            && priv->checkDataSend(xsink)) {
        return QoreValue();
    }
    priv->queueSendRawFrame(frame_data, xsink);
}

//! Sets the frame callback, called from onPollComplete() when a frame is received
/** The callback is dispatched by the async I/O controller on a callback worker,
    after the I/O thread has pushed received frames to the internal queue.

    Pass @ref nothing to clear the callback.

    @param callback the callback, or @ref nothing to clear
*/
nothing HttpWebSocketPollOperationBase::setFrameCallback(*code callback) [flags=NAMED_ARGS] {
    // the callback runs on the controller's workers, outside the sandbox of the code that sets it: code that may
    // not control threads cannot give its own code to any operation, also one that its host lends it; module code
    // gives its own callbacks to the operations that it creates (qore#7056)
    if (callback && qore_check_thread_callable(callback, QDOM_THREAD_CONTROL,
            "HttpWebSocketPollOperationBase::setFrameCallback()", xsink)) {
        return QoreValue();
    }
    ResolvedCallReferenceNode* callback_ptr = nullptr;
    if (callback) {
        callback_ptr = callback->refRefSelf();
    }
    priv->setFrameCallback(callback_ptr, xsink);
}

//! Sets the send timeout in milliseconds
/** When a send operation makes no progress for this time, a SOCKET-TIMEOUT exception is raised
    and the connection transitions to ERROR state.

    @param timeout_ms the timeout in milliseconds (0 = no timeout)
*/
nothing HttpWebSocketPollOperationBase::setSendTimeout(int timeout_ms) [flags=NAMED_ARGS] {
    priv->setSendTimeout(static_cast<int64>(timeout_ms));
}

//! Sets whether the send timeout is a default that allows for a progress step at the minimum rate
/** A TCP sender can see no progress from a client reading steadily at a low rate for as long as one step of its
    receive window takes at that rate.  With \a scaled set, the send timeout is at least that time; without it, the
    send timeout is exact.

    @param scaled @ref True if the send timeout is a default rather than a value set explicitly

    @since %Qore 3.0
*/
nothing HttpWebSocketPollOperationBase::setSendTimeoutScaled(bool scaled) [flags=NAMED_ARGS] {
    priv->setSendTimeoutScaled(scaled);
}

//! Sets the minimum average rate at which the peer must take data while a send waits for it
/** The time spent waiting for the peer is measured across the sends on the connection, against a credit of at least
    \a window that the bytes taken by the peer renew (see @ref Qore::SendRateMonitor::enableProgressSteps()); a send to
    a peer below it raises \c SOCKET-TIMEOUT and the connection transitions to the ERROR state.

    @param min_rate the minimum rate in bytes per second; 0 disables the check
    @param window the length of the sliding window

    @throw SEND-RATE-ERROR \a min_rate is negative, or \a window is not positive with a non-zero \a min_rate

    @since %Qore 3.0
*/
nothing HttpWebSocketPollOperationBase::setSendMinRate(int min_rate, timeout window) [flags=NAMED_ARGS] {
    if (min_rate < 0) {
        xsink->raiseException("SEND-RATE-ERROR", "the minimum rate " QLLD " is negative", min_rate);
        return QoreValue();
    }
    if (min_rate > 0 && window <= 0) {
        xsink->raiseException("SEND-RATE-ERROR", "the window of a minimum rate must be positive; got " QLLD " ms",
            (int64)window);
        return QoreValue();
    }
    priv->setSendMinRate(min_rate, window);
}

//! Returns the send timeout in milliseconds
/** @return the send timeout (0 = no timeout)
*/
int HttpWebSocketPollOperationBase::getSendTimeout() [flags=RET_VALUE_ONLY] {
    return priv->getSendTimeout();
}

//! Returns the number of pre-encoded frames currently queued for sending
/** @return the number of queued outbound frames; used to enforce a per-connection outbound queue limit
*/
int HttpWebSocketPollOperationBase::getSendQueueSize() [flags=RET_VALUE_ONLY] {
    return priv->getSendQueueSize();
}

//! Sets the idle timeout in milliseconds; the connection is closed if no inbound activity is seen for this interval
/** @param idle_timeout_ms the idle timeout in milliseconds (0 = disabled)
*/
nothing HttpWebSocketPollOperationBase::setIdleTimeout(int idle_timeout_ms) [flags=NAMED_ARGS] {
    priv->setIdleTimeout(static_cast<int64>(idle_timeout_ms));
}

//! Sets how long a close started by the server waits for the client's CLOSE frame
/** The wait starts when the server's CLOSE frame has been written.  When the client's CLOSE frame does not arrive
    in time, the operation ends with the state \c "closed", the close code 1006 and the reason
    \c "close handshake timed out", and the server closes the TCP connection.

    @param close_timeout_ms the time to wait in milliseconds; 0 or a negative value means that the server does not
    wait: the operation ends when the server's CLOSE frame has been written; the default is 5 seconds

    @since %Qore 3.0
*/
nothing HttpWebSocketPollOperationBase::setCloseTimeout(timeout close_timeout_ms) [flags=NAMED_ARGS] {
    priv->setCloseTimeout(close_timeout_ms);
}

//! Returns how long a close started by the server waits for the client's CLOSE frame
/** @return the close timeout in milliseconds (0 = the server does not wait for the client's CLOSE frame)

    @since %Qore 3.0
*/
int HttpWebSocketPollOperationBase::getCloseTimeout() [flags=RET_VALUE_ONLY] {
    return priv->getCloseTimeout();
}

//! Returns the idle timeout in milliseconds (0 = disabled)
/** @return the idle timeout in milliseconds
*/
int HttpWebSocketPollOperationBase::getIdleTimeout() [flags=RET_VALUE_ONLY] {
    return priv->getIdleTimeout();
}

//! Sets the heartbeat interval in milliseconds
/** When set, the poll operation automatically sends a ping frame if no data
    has been received within this interval. The I/O controller uses
    poll_timeout_ms to wake up in time for the heartbeat.

    @param heartbeat_interval_ms the heartbeat interval in milliseconds (0 = disabled)

    @since %Qore 3.0
*/
nothing HttpWebSocketPollOperationBase::setHeartbeat(int heartbeat_interval_ms) [flags=NAMED_ARGS] {
    priv->setHeartbeat(static_cast<int64>(heartbeat_interval_ms));
}

//! Enables the built-in C++ echo mode for zero-context-switch echo
/** When enabled, text and binary frames are echoed back to the sender
    entirely on the I/O thread — no worker thread dispatch, no Qore
    interpreter overhead. Control frames (ping/pong/close) are still
    handled automatically.

    This is the fastest possible echo implementation.

    @param enabled True to enable echo mode, False to disable (back to
    normal recv_queue + worker dispatch path)

    @since %Qore 3.0
*/
nothing HttpWebSocketPollOperationBase::setEchoMode(bool enabled) [flags=NAMED_ARGS] {
    if (enabled) {
        priv->setIoFrameHandler(new WsEchoFrameHandler());
    } else {
        priv->setIoFrameHandler(nullptr);
    }
}

//! Called by the I/O controller when frames have been pushed during continuePoll
/** Override in subclasses to process received frames on a worker thread.
    Subclasses overriding this method must call the base implementation to
    dispatch any callback registered with @ref setFrameCallback().

    @since %Qore 3.0
*/
nothing HttpWebSocketPollOperationBase::onPollComplete() {
    priv->dispatchFrameCallback(xsink);
}
