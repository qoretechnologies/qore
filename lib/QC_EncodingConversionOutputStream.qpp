#include <qore/Qore.h>
#include "qore/intern/EncodingConversionOutputStream.h"
#include "qore/intern/QoreObjectIntern.h"
#include "qore/intern/QoreClassIntern.h"

//! An @ref OutputStream implementation that performs on-the-fly conversion between two character encodings.
/** @par Example: EncodingConversionOutputStream basic usage
    @code{.py}
    EncodingConversionOutputStream latin2Stream(destUtf8Stream, "ISO-8859-2", "UTF-8");
    latin2Stream.write(latin2Data);     #writes UTF-8 equivalents to destUtf8Stream
    @endcode

    Data written that is not valid in the source encoding raises \c INVALID-ENCODING, unless the
    \c encoding_errors option of the constructor is \c "latin1" or \c "keep"; a character that the target encoding
    cannot hold raises \c ENCODING-CONVERSION-ERROR; see @ref encoding_errors.

    @note stream classes are not designed to be accessed from multiple threads; they have been implemented without
    locking for fast and efficient use when used from a single thread.  For methods that would be unsafe to use in
    another thread, any use of such methods in threads other than the thread where the constructor was called will
    cause a \c STREAM-THREAD-ERROR to be thrown, unless the stream is handed
    off to another thread using the @ref Qore::StreamBase::unassignThread() "StreamBase::unassignThread()"
    method in the thread that currently owns the stream, and the
    @ref Qore::StreamBase::reassignThread() "StreamBase::reassignThread()" method in the new thread.

    @see @ref Qore::StreamWriter "StreamWriter" for a class that can be used to write various kinds of data to an @ref Qore::OutputStream "OutputStream"

    @since %Qore 0.8.13
 */
qclass EncodingConversionOutputStream [arg=EncodingConversionOutputStream* os; ns=Qore; vparent=OutputStream; flags=final; internal_members=OutputStream os;];

//! Creates the EncodingConversionOutputStream based on the \ref OutputStream given
/**
    @param output_stream the destination \ref OutputStream to write bytes to
    @param source_encoding the encoding of the characters that will be written to this stream
    @param target_encoding the destination character encoding that will be written to the underlying OutputStream
    @param encoding_errors what data written that is not valid in the source encoding gives; one of the
    @ref encoding_errors_constants: \c "raise" (the default) raises \c INVALID-ENCODING when it is written,
    \c "latin1" takes each byte that does not start a valid character of the source encoding (in a Unicode encoding
    form such as UTF-16 or UTF-32, each byte of a code unit that does not start one) as the ISO-8859-1 character of
    that byte and converts it to the target encoding, \c "keep" passes the bytes as they are without a check, and is
    only allowed when the source and target encodings are the same; see @ref encoding_errors

    @throw ENCODING-CONVERSION-ERROR if either of the encodings is unsupported
    @throw ENCODING-ERRORS-ERROR an unknown \a encoding_errors value was given, or \c "keep" with different source
    and target encodings

    @since %Qore 3.0 the \a encoding_errors parameter
 */
EncodingConversionOutputStream::constructor(Qore::OutputStream[OutputStream] output_stream, string source_encoding,
        string target_encoding, *string encoding_errors) [flags=NAMED_ARGS] {
   qore_encoding_errors_t ee;
   if (q_get_encoding_errors(encoding_errors, ee, xsink)) {
      return;
   }
   const QoreEncoding* src = QEM.findCreate(source_encoding);
   const QoreEncoding* dst = QEM.findCreate(target_encoding);
   if (EncodingConvertor::checkEncodingErrors(src, dst, ee, "EncodingConversionOutputStream", xsink)) {
      return;
   }
   SimpleRefHolder<EncodingConversionOutputStream> ecos(new EncodingConversionOutputStream(
         output_stream.release(), src, dst, xsink, ee));
   if (*xsink) {
      return;
   }
   self->setPrivate(CID_ENCODINGCONVERSIONOUTPUTSTREAM, ecos.release());
   qore_object_private* o = qore_object_private::get(*self);
   const qore_class_private* cls = qore_class_private::get(*QC_ENCODINGCONVERSIONOUTPUTSTREAM);
   o->setValueIntern(cls, "os", static_cast<QoreObject *>(obj_output_stream->refSelf()), xsink);
}

//! Flushes any buffered (unwritten) bytes, closes the output stream and releases all resources.
/** Any methods called on a closed output stream will throw an exception.

    @throw INVALID-ENCODING the data written ends in the middle of a character or shift sequence and the
    \a encoding_errors option of the constructor is \c "raise"; the message gives its byte offset in the data
    written
    @throw OUTPUT-STREAM-CLOSED-ERROR the output stream has already been closed
    @throw STREAM-THREAD-ERROR this exception is thrown if this method is called from any thread other than the thread that created the object
 */
nothing EncodingConversionOutputStream::close() {
   os->closeHelper(xsink);
}

//! Writes bytes to the output stream
/**
    @param data the data to write

    @par Example:
    @code{.py}
    EncodingConversionOutputStream ecos();
    bos.write(<6162>);
    bos.write(<63>);
    @endcode

    @throw INVALID-ENCODING the data written is not valid in the source encoding (a byte sequence that is not a
    character of the encoding) and the \a encoding_errors option of the constructor is \c "raise"; the message
    gives the byte offset of the sequence in the data written to the stream
    @throw ENCODING-CONVERSION-ERROR the data written has a character that the target encoding cannot hold; the
    message gives the byte offset of the first one in the data written to the stream
    @throw OUTPUT-STREAM-CLOSED-ERROR the output stream has already been closed
    @throw STREAM-THREAD-ERROR this exception is thrown if this method is called from any thread other than the thread that created the object
 */
nothing EncodingConversionOutputStream::write(binary data) [flags=NAMED_ARGS] {
   os->writeHelper(data, xsink);
}

//! Returns what data written that is not valid in the source encoding gives
/** @par Example:
    @code{.py}
string encoding_errors = latin2Stream.getEncodingErrors();
    @endcode

    @return one of the @ref encoding_errors_constants: \c "raise", \c "latin1", or \c "keep"; see
    @ref encoding_errors

    @since %Qore 3.0
 */
string EncodingConversionOutputStream::getEncodingErrors() [flags=CONSTANT] {
   return new QoreStringNode(q_encoding_errors_name(os->getEncodingErrors()));
}
