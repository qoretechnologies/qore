#include <qore/Qore.h>
#include <qore/QoreSocketObject.h>
#include "qore/intern/AsyncIoControllerPriv.h"
#include "qore/intern/qore_thread_intern.h"
#include "qore/intern/QC_Socket.h"

extern qore_classid_t CID_QUEUE;
extern qore_classid_t CID_ASYNCIOCONTROLLER;
extern QoreClass* QC_QUEUE;

// Helper: get the singleton's priv data and QoreObject (both ref'd); caller must deref both
static AsyncIoControllerPriv* get_singleton(QoreObject*& obj, ExceptionSink* xsink) {
    obj = qore_get_async_io_controller_obj(xsink);
    if (!obj) {
        return nullptr;
    }
    AsyncIoControllerPriv* ctrl = static_cast<AsyncIoControllerPriv*>(
        obj->getReferencedPrivateData(CID_ASYNCIOCONTROLLER, xsink));
    if (!ctrl) {
        obj->deref(xsink);
        obj = nullptr;
        return nullptr;
    }
    return ctrl;
}

//! Socket poll state event hash
/** Pushed onto the @ref Qore::SocketPollOperationInfo::stateQueue "stateQueue" of an operation submitted with
    @ref Qore::AsyncIoController::submit() when the operation's state changes, and once more when the operation
    ends; see @ref asynciocontroller_state_events

    @since %Qore 3.0
*/
hashdecl Qore::SocketPollStateInfo {
    //! The pollable I/O object the operation was submitted for
    AbstractPollableIoObjectBase sock;

    //! The poll operation
    AbstractPollOperation<?> spop;

    //! The operation's state: the value of @ref Qore::AbstractPollOperation::getState() "getState()"
    /** In a state change event, the state the operation has after the step that changed it.  In the event with
        \c done set, the last state the controller read, or @ref nothing if the operation ended before its first
        step.
    */
    *string state;

    //! @ref True "True" in the last event of the operation, pushed when the operation ends for any reason
    /** The operation's result is delivered after this event; this event is pushed whatever the
        @ref Qore::SocketPollOperationInfo::notifyStates "notifyStates" of the operation.
    */
    bool done = False;

    //! Free-form data provided when the operation was submitted
    *hash<auto> other;
}

//! Socket polling operation info hash
/** Contains all the information needed to submit an async I/O operation

    @since %Qore 3.0
*/
hashdecl Qore::SocketPollOperationInfo {
    //! Pollable I/O object (Socket, EventNotifier, or any AbstractPollableIoObjectBase subclass)
    AbstractPollableIoObjectBase sock;

    //! Poll operation
    AbstractPollOperation<?> spop;

    //! Last poll info for this operation
    *hash<SocketPollInfo> poll_info;

    //! I/O timeout; use a negative value to disable timeout (operation will wait indefinitely)
    /** Default: 30 seconds
    */
    timeout to = 30s;

    //! Owner identifier for cancellation; required for proper cleanup during shutdown via cancelByOwner()
    string owner;

    //! Free-form data to be returned when the operation completes
    *hash<auto> other;

    //! Optional result Queue; if provided, results will be pushed to this Queue instead of a new one
    /** This allows multiple operations to share a single result Queue for easier coordination.

        If neither a Queue nor an @ref AbstractPollOperation::onComplete() "onComplete()" override
        is provided, a new Queue is created and returned from @ref Qore::AsyncIoController::submit().

        The Queue must not have a maximum size: the I/O thread never waits for room in a Queue.
    */
    *Queue<hash<SocketPollResultInfo>> resultQueue;

    //! Optional Queue for the operation's state events
    /** When given, the controller reports the operation's state on this Queue: an event after each step that
        changes it and a last event with \c done set when the operation ends, before its result is delivered; see
        @ref asynciocontroller_state_events.  Several operations can share one Queue.

        The Queue must not have a maximum size: the I/O thread never waits for room in a Queue.

        @since %Qore 3.0
    */
    *Queue<hash<SocketPollStateInfo>> stateQueue;

    //! The states to report on the @ref stateQueue
    /** When given, only changes into one of these states are reported; the last event, with \c done set, is
        always reported.  Requires a @ref stateQueue.

        @since %Qore 3.0
    */
    *softlist<string> notifyStates;

    //! Optional custom cache key; default: sock.uniqueHash()
    /** Allows multiple concurrent operations on the same socket (e.g., concurrent accepts
        on a listener) by using distinct keys like "accept:<hash>:1", "accept:<hash>:2".
    */
    *string key;

    //! Ignored; accepted for source compatibility
    /** Every operation on one pollable I/O object runs on the same I/O thread, whatever its cache key or this
        value: operations are routed by their \c sock, so a socket, its TLS state and its HTTP/2 or QUIC session are
        only ever used by one I/O thread, and the operations on a socket are processed in order by that thread.

        @since %Qore 3.0
    */
    *string thread_key;

    //! Force onComplete dispatch even if the C++ auto-detection doesn't find an override
    /** Works around C++/Qore multiple inheritance method resolution order issues where
        findMethod("onComplete") returns the base no-op from the wrong parent class.

        @since %Qore 3.0
    */
    bool has_on_complete = False;
}

//! Socket poll result info hash
/** Contains the result of a completed async I/O operation

    @since %Qore 3.0
*/
hashdecl Qore::SocketPollResultInfo {
    //! The pollable I/O object that completed the operation
    AbstractPollableIoObjectBase sock;

    //! The poll operation that completed
    AbstractPollOperation<?> spop;

    //! If the operation was canceled
    *bool canceled;

    //! Any exception raised while executing the operation
    *hash<ExceptionInfo> ex;

    //! Free-form data provided when the operation was submitted
    *hash<auto> other;
}

//! Async I/O controller for managing multiple concurrent socket poll operations
/** The AsyncIoController provides a high-performance event loop for managing multiple concurrent
    socket operations. It uses the most efficient I/O mechanism available on each platform
    (epoll on Linux, kqueue on macOS/BSD) via the EventLoop class.

    The controller runs a dedicated I/O thread that processes socket events and drives poll
    operations through their state machines. Operations are submitted via @ref Qore::AsyncIoController::submit(),
    and results are delivered via callback.

    The controller supports:
    - Multiple concurrent operations on different sockets
    - Multiple concurrent operations on the same socket (using custom keys)
    - Cancellation by socket, key, or owner
    - Autostop behavior (I/O thread exits when all operations complete)
    - Wake/force-poll for handling pending writes (HTTP/2)

    @par Thread Safety
    All public methods are thread-safe. The controller uses a single mutex with careful lock
    ordering to avoid deadlocks.

    @par Three-Phase I/O Cycle
    The I/O thread implements a deterministic three-phase polling cycle:
    - Phase 1 (Snapshot under lock): collect operations needing continuePoll()
    - Phase 2 (continuePoll outside lock): drive operations, collect results
    - Phase 3 (Update under lock + deferred delivery): update cache/EventLoop, deliver callbacks

    @anchor asynciocontroller_state_events
    @par State Events
    An operation submitted with a @ref Qore::SocketPollOperationInfo::stateQueue "stateQueue" reports its state
    on that Queue as @ref Qore::SocketPollStateInfo "SocketPollStateInfo" events, so a caller can wait for the
    operation to reach a state by blocking on the Queue instead of calling
    @ref Qore::AbstractPollOperation::getState() "getState()" repeatedly while the controller drives the operation:
    - the controller reads the operation's state after each step, i.e. each
      @ref Qore::AbstractPollOperation::continuePoll() "continuePoll()" call, whether the step continues the
      operation, completes it or raises an exception, on the thread that made the call: the I/O thread for
      operations implemented in C++, a callback worker for operations implemented in %Qore
    - the state after the first step is always reported; after that, a step is reported when it leaves the
      operation in another state than the step before it.  Several state changes made within one step are seen as
      one change, to the state the step leaves
    - with @ref Qore::SocketPollOperationInfo::notifyStates "notifyStates", only changes into one of the given
      states are reported
    - when the operation ends for any reason (its goal is reached, it raises an exception, times out, is canceled,
      replaced by another operation with the same key, or the controller shuts down), one last event is reported
      with \c done set and the last state the controller read, or no state if the operation ended before its first
      step
    - the events of an operation are pushed in the order of its steps, and all of them, the last one included, are
      pushed before the operation's result is pushed to its result Queue or passed to
      @ref Qore::AbstractPollOperation::onComplete() "onComplete()": once the result is received, all events are
      on the state Queue, and once the last event is received, the result follows
    - a submission without a state Queue costs nothing: the controller does not read the operation's state
    - an exception raised by the %Qore @ref Qore::AbstractPollOperation::getState() "getState()" method of an
      operation ends the operation with that exception, as if its step had raised it
    - submitting the same operation again starts a new submission, which reports its first step again

    @par Example: waiting for an operation to reach a state
    @code{.py}
# wait until a QUIC client has completed its handshake and set up HTTP/3, then send a request
Socket sock();
sock.bindINET("127.0.0.1", "0", False, AF_INET, SOCK_DGRAM);
AbstractPollOperation op = sock.startPollQuicConnect("127.0.0.1", port);
Queue<hash<SocketPollStateInfo>> states();
*Queue<hash<SocketPollResultInfo>> result_queue = AsyncIoController::submit(<SocketPollOperationInfo>{
    "sock": sock,
    "spop": op,
    "owner": "quic-client",
    "stateQueue": states,
    "notifyStates": "reading",
});
hash<SocketPollStateInfo> event = states.get();
if (event.done) {
    # the operation ended before it was ready; its result tells why
    hash<SocketPollResultInfo> result = result_queue.get();
    throw result.ex.err, result.ex.desc;
}
sock.submitQuicRequest("GET", "/");
AsyncIoController::wakeSocket(sock);
    @endcode

    @note This class is not available with the @ref PO_NO_NETWORK parse option

    @since %Qore 3.0
*/
qclass AsyncIoController [dom=NETWORK; arg=AsyncIoControllerPriv* ctrl; ns=Qore];

//! Creates a new AsyncIoController
/** @par Example:
    @code{.py}
    auto ctrl = AsyncIoController::get();
    @endcode

    @param auto_stop if @ref True "True" (default), the I/O thread will automatically exit when
    all operations have completed; if @ref False "False", the I/O thread will keep running
    until explicitly stopped

    @throw ASYNCIOCONTROLLER-CONSTRUCTOR-ERROR cannot be instantiated directly; use
    static methods instead
*/
AsyncIoController::constructor(bool[doc] auto_stop = True) [flags=NAMED_ARGS] {
    xsink->raiseException("ASYNCIOCONTROLLER-CONSTRUCTOR-ERROR",
        "AsyncIoController cannot be instantiated; use static methods");
}

//! Destroys the AsyncIoController
/** The singleton is cleaned up during qore_cleanup(); this destructor handles the
    final dereference of the private data.
*/
AsyncIoController::destructor() {
    ctrl->deref(xsink);
}

//! Creates a copy of the AsyncIoController
/** @throw ASYNCIOCONTROLLER-COPY-ERROR AsyncIoController cannot be copied; use
    AsyncIoController::get() to obtain the singleton
*/
AsyncIoController::copy() {
    xsink->raiseException("ASYNCIOCONTROLLER-COPY-ERROR",
        "AsyncIoController cannot be copied; use AsyncIoController::get()");
}

//! Submits an async I/O operation to the global singleton
/** @par Example:
    @code{.py}
    *Queue<hash<SocketPollResultInfo>> q =
        AsyncIoController::submit(operation_info: {"sock": sock, "spop": op, "owner": "server"});
    hash<SocketPollResultInfo> result = q.get();
    @endcode

    @param operation_info the operation info hash; with a
    @ref Qore::SocketPollOperationInfo::stateQueue "stateQueue", the operation also reports its state; see
    @ref asynciocontroller_state_events
    @param replace_existing if @ref True "True", cancel any existing operation with the same key

    @return a Queue object for receiving the result, or @ref nothing if a callback was provided
    in the info hash

    @throw ASYNC-IO-ERROR if the controller is shutting down or the info hash is invalid: the result Queue or the
    state Queue has a maximum size, \c notifyStates is given without a \c stateQueue, or a \c stateQueue is given
    for an operation implemented in C++ whose continuePoll() runs on the I/O thread while its getState() is
    implemented in %Qore (%Qore code does not run on the I/O thread, where the controller reads the state of such an
    operation)

    @note The steps of the operation that run on callback workers, such as
    @ref Qore::AbstractPollOperation::continuePoll() "continuePoll()" and
    @ref Qore::AbstractPollOperation::onComplete() "onComplete()" of an operation implemented in %Qore, are
    governed by the @ref sandboxing "sandbox" of the code that submits the operation, so that a connection made
    there is subject to the same policy as one made by the submitting code; an operation submitted by such a step
    is governed by the same sandbox

    @since %Qore 3.0
*/
static *Queue<hash<SocketPollResultInfo>> AsyncIoController::submit(hash<SocketPollOperationInfo> operation_info,
        *bool replace_existing)
        [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    // submit() takes ownership of `operation_info` (see the ReferenceHolder in
    // AsyncIoControllerPriv::submit that plugs the per-call leak); our
    // QPP-generated caller still owns its own ref on the method arg, so
    // hand submit() an explicit self-ref via hashRefSelf().
    return ctrl->submit(obj, operation_info->hashRefSelf(), replace_existing, xsink);
}

//! Executes an async I/O operation on the global singleton and waits for its result
/** This is the blocking companion to @ref Qore::AsyncIoController::submit(). It uses the controller event loop
    for the actual I/O operation, then waits on the operation's result Queue.

    @param operation_info the operation info hash; as with @ref Qore::AsyncIoController::submit() "submit()", a
    \c stateQueue receives the operation's state events, all of them before this method returns
    @param replace_existing if @ref True "True", cancel any existing operation with the same key

    @return the operation result hash

    @throw ASYNC-IO-ERROR if the controller is shutting down, the info hash is invalid (see
    @ref Qore::AsyncIoController::submit() "submit()"), or the operation uses an
    @ref AbstractPollOperation::onComplete() "onComplete()" callback, or if called from the async I/O thread

    @since %Qore 3.0
*/
static hash<SocketPollResultInfo> AsyncIoController::exec(hash<SocketPollOperationInfo> operation_info,
        *bool replace_existing) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->exec(obj, operation_info->hashRefSelf(), replace_existing, xsink);
}

//! Cancels an operation by socket on the global singleton
/** @param io_object the I/O object whose operation should be canceled
    @return @ref True "True" if an operation was found and canceled
    @since %Qore 3.0
*/
static bool AsyncIoController::cancel(AbstractPollableIoObjectBase[AbstractPollableIoObjectBase] io_object)
        [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancel(*io_object, xsink);
}

//! Cancels an operation by I/O object and closes it
/** Cancels the poll operation associated with the given I/O object, then shuts down
    and closes it via closeIo(). This is the proper way to tear down a connection whose
    lifecycle is managed by the async I/O controller.

    @param io_object the I/O object whose operation should be canceled and then closed
    @return @ref True "True" if an operation was found and canceled

    @since %Qore 3.0
*/
static bool AsyncIoController::cancelAndClose(AbstractPollableIoObjectBase[AbstractPollableIoObjectBase] io_object)
        [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelAndClose(*io_object, xsink);
}

//! Cancels an operation by key on the global singleton
/** @param key the operation key to cancel
    @return @ref True "True" if an operation was found and canceled
    @since %Qore 3.0
*/
static bool AsyncIoController::cancelByKey(string key) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelByKey(key, xsink);
}

//! Cancels all operations for an owner on the global singleton
/** @param owner the owner identifier whose operations should be canceled
    @return the number of operations canceled
    @since %Qore 3.0
*/
static int AsyncIoController::cancelByOwner(string owner) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelByOwner(owner, xsink);
}

//! Wakes the I/O thread for a specific socket with pending data
/** Enqueues a targeted re-poll command for the given socket. The I/O thread
    includes that socket's operation in the next poll cycle regardless of
    EventLoop socket readiness, allowing queued send data to be transmitted.

    @param io_object the I/O object whose operation needs re-polling

    @since %Qore 3.0
*/
static nothing AsyncIoController::wakeSocket(AbstractPollableIoObjectBase[AbstractPollableIoObjectBase] io_object)
        [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    // Use QoreObject unique hash — the private data pointer
    // (AbstractPollableIoObjectBase*) can change during QUIC handshake when
    // the socket is reconfigured, causing hash mismatches with the cache key.
    // The QoreObject unique hash is stable across the connection lifecycle.
    ctrl->wakeSocketByObject(const_cast<QoreObject*>(obj_io_object), xsink);
}

//! Waits for all pending onComplete/abort callbacks to be processed
/** Call after cancelByOwner() to ensure all cancelled operation callbacks
    have been delivered before stopping thread pools that depend on them.

    This prevents shutdown deadlocks where a ThreadPool.stop() blocks
    waiting for handler threads that are waiting for onComplete() to
    signal their done counter.

    @since %Qore 3.0
*/
static nothing AsyncIoController::flushCallbacks() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->flushCallbacks();
}

//! Waits for in-flight callbacks tagged with the given owner to drain
/** Narrowed-scope companion to @ref flushCallbacks() that only waits for
    callbacks whose operations were submitted with the matching @a owner.
    Safe to call from a per-owner teardown path (e.g. a connection manager's
    destructor) where the global flush would deadlock on unrelated long-running
    work on the shared controller.

    Marks the owner as shutting down for the duration of the wait: any callback
    picked up by a worker while the mark is set is silently discarded instead
    of dispatched to user code.  The mark is cleared before return, so later
    submits by a new object reusing the owner string are unaffected.

    @param owner the owner identifier to wait for

    @since %Qore 3.0
*/
static nothing AsyncIoController::flushCallbacksByOwner(string owner) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->flushCallbacksByOwner(std::string(owner->c_str()));
}

//! Waits for the global singleton's I/O thread to be ready
/** @param timeout_ms timeout for waiting; use 0 to wait indefinitely
    @return @ref True "True" if the I/O thread is ready within the timeout
    @since %Qore 3.0
*/
static bool AsyncIoController::waitReady(*timeout timeout_ms) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->waitReady(timeout_ms, xsink);
}

//! Waits until the global singleton has processed all currently submitted operations
/** @param timeout_ms timeout for waiting; use 0 to wait indefinitely
    @return @ref True "True" if all submitted operations have been processed

    @throw ASYNC-IO-ERROR if called from an async I/O controller I/O thread

    @since %Qore 3.0
*/
static bool AsyncIoController::waitForProcessing(*timeout timeout_ms) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->waitForProcessing(timeout_ms, xsink);
}

//! Returns true if the global singleton's I/O thread is running
/** @return @ref True "True" if the I/O thread is running
    @since %Qore 3.0
*/
static bool AsyncIoController::running() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->running();
}

//! Returns the number of cached operations on the global singleton
/** @return the number of active operations in the cache
    @since %Qore 3.0
*/
static int AsyncIoController::getCacheSize() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getCacheSize();
}

//! Sets the autostop flag on the global singleton
/** @param auto_stop if @ref True "True", the I/O thread will exit when all operations complete
    @since %Qore 3.0
*/
static nothing AsyncIoController::setAutostop(bool auto_stop = True) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setAutostop(auto_stop);
}

//! Returns the autostop flag from the global singleton
/** @return @ref True "True" if autostop is enabled
    @since %Qore 3.0
*/
static bool AsyncIoController::getAutostop() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getAutostop();
}

//! Returns info about the global singleton's state
/** @return a hash with controller state information with the following keys:
    - \c running: @ref True "True" if an I/O thread is running
    - \c autostop: the autostop flag
    - \c shutting_down: @ref True "True" if the controller is shutting down
    - \c tid: the thread ID of the first I/O thread (0 if it is not running)
    - \c cache_size: the number of operations in the controller
    - \c cache_keys: the keys of all operations in the controller
    - \c threads: a list with one hash per running I/O thread, ordered by index, with the keys \c index (the
      thread's index), \c tid (its thread ID), \c cache_keys (the keys of the operations on that thread) and
      \c timeouts (the number of entries in the thread's timeout heap); called from an I/O thread, only that thread
      is listed
    - \c io_threads: the number of I/O threads the controller runs (see @ref setMaxIoThreads())

    @since %Qore 3.0
*/
static hash<auto> AsyncIoController::getInfo() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getInfo(xsink);
}

//! Sets the logger on the global singleton
/** @param logger a @ref Qore::LoggerInterfaceBase "LoggerInterfaceBase" object for logging,
    or @ref nothing "NOTHING" to disable per-controller logging
    @since %Qore 3.0
*/
static nothing AsyncIoController::setLogger(*LoggerInterfaceBase logger) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setLogger(const_cast<QoreObject*>(logger), xsink);
}

//! Adds a timer on the global singleton
/** When \a user_data is a closure or call-reference, the runtime automatically dispatches
    it to a worker thread in the async-I/O controller's dispatcher pool when the
    deadline fires — it is @b not invoked on the I/O thread, so it may block, acquire
    locks, or perform Qore-level I/O.

    For non-callable \a user_data (numbers, strings, hashes, …), the value is passed to
    the timer callback registered via @ref setTimerCallback() (also dispatched to a
    worker thread).  With no callback installed, non-callable \a user_data is silently
    dropped.

    @par Module Code and Restricted Callers
    Module code that runs for a caller that may not control threads (a Qorus service, for example, has
    @ref Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL") can schedule only its own code: code of a %Program that
    allows what the caller may not.  The caller's own code (a closure, or a method that a class of the caller
    overrides) is refused with \c INVALID-FUNCTION-ACCESS, whose description gives the reason, for example <em>the
    callback's Program does not allow thread control (PO_NO_THREAD_CONTROL)</em>, and so is non-callable timer data,
    which the process-wide timer callback would receive; see @ref MODULE_OWNED

    @param deadline the absolute deadline for the timer
    @param user_data either a closure/call-reference to dispatch, or arbitrary user data
        to deliver through the @ref setTimerCallback() handler
    @return the unique timer ID

    @throw INVALID-FUNCTION-ACCESS module code running for a restricted caller added a timer with code that is not
    its own, or with non-callable data

    @since %Qore 3.0
*/
static int AsyncIoController::addTimer(date deadline, auto user_data)
        [dom=NETWORK,THREAD_CONTROL;flags=NAMED_ARGS,MODULE_OWNED] {
    if (qore_check_module_owned_code(user_data, QDOM_NETWORK | QDOM_THREAD_CONTROL, "AsyncIoController::addTimer()",
            "schedule", xsink)) {
        return 0;
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimer(deadline, user_data, xsink);
}

//! Adds an owner-tagged timer on the global singleton
/** Identical to @ref addTimer(date, auto) but tags the timer's callback dispatch with \a owner, so a
    teardown path can deterministically drain a fired-but-not-yet-run callback via
    @ref flushCallbacksByOwner() (in addition to cancelling not-yet-fired timers with @ref cancelTimer()).
    This closes the teardown race where a timer fires, its callback is dispatched to a worker, and the
    owning object is destroyed before the callback runs.

    @par Module Code and Restricted Callers
    Module code that runs for a caller that may not control threads (a Qorus service, for example, has
    @ref Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL") can schedule only its own code: code of a %Program that
    allows what the caller may not.  The caller's own code (a closure, or a method that a class of the caller
    overrides) is refused with \c INVALID-FUNCTION-ACCESS, whose description gives the reason, for example <em>the
    callback's Program does not allow thread control (PO_NO_THREAD_CONTROL)</em>, and so is non-callable timer data,
    which the process-wide timer callback would receive; see @ref MODULE_OWNED

    @param deadline the absolute deadline for the timer
    @param udata either a closure/call-reference to dispatch, or arbitrary user data
        to deliver through the @ref setTimerCallback() handler
    @param owner the owner identifier to tag the timer's callback dispatch with
    @return the unique timer ID

    @throw INVALID-FUNCTION-ACCESS module code running for a restricted caller added a timer with code that is not
    its own, or with non-callable data

    @since %Qore 3.0
*/
static int AsyncIoController::addTimer(date deadline, auto udata, string owner)
        [dom=NETWORK,THREAD_CONTROL;flags=MODULE_OWNED] {
    if (qore_check_module_owned_code(udata, QDOM_NETWORK | QDOM_THREAD_CONTROL, "AsyncIoController::addTimer()",
            "schedule", xsink)) {
        return 0;
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimer(deadline, udata, xsink, owner->c_str());
}

//! Cancels a timer on the global singleton
/** @param timer_id the timer ID returned by @ref addTimer()
    @return @ref True "True" if the timer was found and canceled

    @par Module Code and Restricted Callers
    Module code that runs for an application with restrictions (a Qorus service, for example) can cancel only the
    timers that module code added for the same application, the first %Program in the chain of callers that is not a
    module; for any other timer, this method returns @ref False "False", so a restricted caller cannot use module code
    to cancel timers of other applications or of the host; see @ref MODULE_OWNED

    @since %Qore 3.0
*/
static bool AsyncIoController::cancelTimer(int timer_id) [dom=NETWORK,THREAD_CONTROL;flags=NAMED_ARGS,MODULE_OWNED] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelTimer(timer_id, xsink);
}

//! Sets the timer callback on the global singleton
/** The callback is invoked once per fire of a timer whose \c user_data is @b not a closure or
    call-reference (those are auto-dispatched directly; see @ref addTimer()).  The runtime
    dispatches the callback to a worker thread in the async-I/O controller's dispatcher
    pool — it is @b not invoked on the I/O thread.

    @param callback a callback that accepts a @ref TimerEventInfo hash argument, or
        @ref nothing to disable timer event delivery for non-callable \c user_data

    @since %Qore 3.0
*/
static nothing AsyncIoController::setTimerCallback(*code callback) [dom=NETWORK,PROCESS,THREAD_CONTROL;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setTimerCallback(callback ? callback->refRefSelf() : nullptr, xsink);
}

//! Submits a task to the global singleton's thread pool
/** @param task the @ref closure "closure" or @ref call_reference "call reference" to execute
    @param cancel_callback an optional @ref closure "closure" or @ref call_reference "call reference"
    to execute if the pool is stopped before the task can be executed

    @throw ASYNC-IO-ERROR if the controller's thread pool has been stopped
    @throw INVALID-FUNCTION-ACCESS module code running for a restricted caller submitted code that is not its own

    @par Module Code and Restricted Callers
    Module code that runs for a caller that may not control threads (a Qorus service, for example, has
    @ref Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL") can submit only its own code: code of a %Program that
    allows what the caller may not.  The caller's own code (a closure, or a method that a class of the caller
    overrides) is refused with \c INVALID-FUNCTION-ACCESS, whose description gives the reason, for example <em>the
    callback's Program does not allow thread control (PO_NO_THREAD_CONTROL)</em>; see @ref MODULE_OWNED

    @since %Qore 3.0
*/
static nothing AsyncIoController::submitTask(code<nothing()> task, *code<nothing()> cancel_callback)
        [dom=NETWORK,THREAD_CONTROL;flags=NAMED_ARGS,MODULE_OWNED] {
    if (qore_check_module_owned_code(task, QDOM_NETWORK | QDOM_THREAD_CONTROL, "AsyncIoController::submitTask()",
            "schedule", xsink)
        || (cancel_callback && qore_check_module_owned_code(cancel_callback, QDOM_NETWORK | QDOM_THREAD_CONTROL,
            "AsyncIoController::submitTask()", "schedule", xsink))) {
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->submitTask(task->refRefSelf(), cancel_callback ? cancel_callback->refRefSelf() : nullptr, xsink);
}

//! Sets the maximum number of callback dispatcher worker threads on the global singleton
/** Controls the concurrency of user callback dispatch off the I/O thread.

    The default is @code{.py}hardware_concurrency() * 4@endcode, capped at 512 and falling
    back to 4 if the hardware thread count is unavailable.

    Takes effect when the dispatcher or submitTask() pool is next created.

    @param max_workers the maximum number of workers; 0 = auto (hardware_concurrency() * 4,
    capped at 512, fallback 4)

    @since %Qore 3.0
*/
static nothing AsyncIoController::setMaxCallbackWorkers(int max_workers = 0)
        [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setMaxCallbackWorkers((int)max_workers);
}

//! Sets the number of I/O threads for the global async I/O controller
/** @param max_threads the number of I/O threads; 0 = the default: one per CPU available to the process, at most 8

    Each I/O thread runs its own event loop for its share of the sockets: every operation on one socket runs on
    the same I/O thread, so throughput scales with the number of threads for many concurrent connections, while
    each connection is handled as with a single I/O thread.

    By default the controller runs one I/O thread per CPU available to the process, at most 8: on Linux, the CPUs of
    its CPU affinity mask, and at most the CPU time its cgroup CPU quota allows (\c cpu.max, or
    \c cpu.cfs_quota_us and \c cpu.cfs_period_us with cgroup v1), as in a container started with a CPU limit; the
    \c QORE_IO_THREADS environment variable, read when the controller is created, sets another count.

    @throw ASYNC-IO-ERROR the controller is running; the thread count can only be changed while the controller is
    stopped, for example before its first operation is submitted

    @since %Qore 3.0
*/
static nothing AsyncIoController::setMaxIoThreads(int max_threads = 0) [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setMaxIoThreads((int)max_threads, xsink);
}
