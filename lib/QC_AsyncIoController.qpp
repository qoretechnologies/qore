#include <qore/Qore.h>
#include <qore/QoreSocketObject.h>
#include "qore/intern/AsyncIoControllerPriv.h"
#include "qore/intern/qore_thread_intern.h"
#include "qore/intern/QoreException.h"
#include "qore/intern/QC_Socket.h"

extern qore_classid_t CID_QUEUE;
extern qore_classid_t CID_ASYNCIOCONTROLLER;
extern QoreClass* QC_QUEUE;

// Helper: get the singleton's priv data and QoreObject (both ref'd); caller must deref both
static AsyncIoControllerPriv* get_singleton(QoreObject*& obj, ExceptionSink* xsink) {
    obj = qore_get_async_io_controller_obj(xsink);
    if (!obj) {
        return nullptr;
    }
    AsyncIoControllerPriv* ctrl = static_cast<AsyncIoControllerPriv*>(
        obj->getReferencedPrivateData(CID_ASYNCIOCONTROLLER, xsink));
    if (!ctrl) {
        obj->deref(xsink);
        obj = nullptr;
        return nullptr;
    }
    return ctrl;
}

//! Socket poll state event hash
/** Pushed onto the @ref Qore::SocketPollOperationInfo::stateQueue "stateQueue" of an operation submitted with
    @ref Qore::AsyncIoController::submit() when the operation's state changes, and once more when the operation
    ends; see @ref asynciocontroller_state_events

    @since %Qore 3.0
*/
hashdecl Qore::SocketPollStateInfo {
    //! The pollable I/O object the operation was submitted for
    AbstractPollableIoObjectBase sock;

    //! The poll operation
    AbstractPollOperation<?> spop;

    //! The operation's state: the value of @ref Qore::AbstractPollOperation::getState() "getState()"
    /** In a state change event, the state the operation has after the step that changed it.  In the event with
        \c done set, the last state the controller read, or @ref nothing if the operation ended before its first
        step.
    */
    *string state;

    //! @ref True "True" in the last event of the operation, pushed when the operation ends for any reason
    /** The operation's result is delivered after this event; this event is pushed whatever the
        @ref Qore::SocketPollOperationInfo::notifyStates "notifyStates" of the operation.
    */
    bool done = False;

    //! Free-form data provided when the operation was submitted
    *hash<auto> other;
}

//! Socket polling operation info hash
/** Contains all the information needed to submit an async I/O operation

    @since %Qore 3.0
*/
hashdecl Qore::SocketPollOperationInfo {
    //! Pollable I/O object (Socket, EventNotifier, or any AbstractPollableIoObjectBase subclass)
    AbstractPollableIoObjectBase sock;

    //! Poll operation
    AbstractPollOperation<?> spop;

    //! Last poll info for this operation
    *hash<SocketPollInfo> poll_info;

    //! I/O timeout; use a negative value to disable timeout (operation will wait indefinitely)
    /** Default: 30 seconds
    */
    timeout to = 30s;

    //! Owner identifier for cancellation; required for proper cleanup during shutdown via cancelByOwner()
    string owner;

    //! Free-form data to be returned when the operation completes
    *hash<auto> other;

    //! Optional result Queue; if provided, results will be pushed to this Queue instead of a new one
    /** This allows multiple operations to share a single result Queue for easier coordination.

        If neither a Queue nor an @ref AbstractPollOperation::onComplete() "onComplete()" override
        is provided, a new Queue is created and returned from @ref Qore::AsyncIoController::submit().

        The Queue must not have a maximum size: the I/O thread never waits for room in a Queue.
    */
    *Queue<hash<SocketPollResultInfo>> resultQueue;

    //! Optional Queue for the operation's state events
    /** When given, the controller reports the operation's state on this Queue: an event after each step that
        changes it and a last event with \c done set when the operation ends, before its result is delivered; see
        @ref asynciocontroller_state_events.  Several operations can share one Queue.

        The Queue must not have a maximum size: the I/O thread never waits for room in a Queue.

        @since %Qore 3.0
    */
    *Queue<hash<SocketPollStateInfo>> stateQueue;

    //! The states to report on the @ref stateQueue
    /** When given, only changes into one of these states are reported; the last event, with \c done set, is
        always reported.  Requires a @ref stateQueue.

        @since %Qore 3.0
    */
    *softlist<string> notifyStates;

    //! Optional custom cache key; default: sock.uniqueHash()
    /** Allows multiple concurrent operations on the same socket (e.g., concurrent accepts
        on a listener) by using distinct keys like "accept:<hash>:1", "accept:<hash>:2".
    */
    *string key;

    //! Ignored; accepted for source compatibility
    /** Every operation on one pollable I/O object runs on the same I/O thread, whatever its cache key or this
        value: operations are routed by their \c sock, so a socket, its TLS state and its HTTP/2 or QUIC session are
        only ever used by one I/O thread, and the operations on a socket are processed in order by that thread.

        @since %Qore 3.0
    */
    *string thread_key;

    //! Force onComplete dispatch even if the C++ auto-detection doesn't find an override
    /** Works around C++/Qore multiple inheritance method resolution order issues where
        findMethod("onComplete") returns the base no-op from the wrong parent class.

        @since %Qore 3.0
    */
    bool has_on_complete = False;
}

//! Socket poll result info hash
/** Contains the result of a completed async I/O operation

    @since %Qore 3.0
*/
hashdecl Qore::SocketPollResultInfo {
    //! The pollable I/O object that completed the operation
    AbstractPollableIoObjectBase sock;

    //! The poll operation that completed
    AbstractPollOperation<?> spop;

    //! If the operation was canceled
    *bool canceled;

    //! Any exception raised while executing the operation
    *hash<ExceptionInfo> ex;

    //! Free-form data provided when the operation was submitted
    *hash<auto> other;
}

// a poll operation of a class with Qore code runs that code on the controller's thread and workers: an operation
// whose class code that may not control threads authored is not run there (qore#7056)
static int check_submitted_operation(const QoreHashNode* operation_info, const char* name, ExceptionSink* xsink) {
    QoreValue spop = operation_info->getKeyValue("spop");
    if (spop.getType() != NT_OBJECT || spop.get<const QoreObject>()->getClass()->isSystem()) {
        return 0;
    }
    return qore_check_thread_callable(spop, QDOM_THREAD_CONTROL, name, xsink);
}

//! Async I/O controller for managing multiple concurrent socket poll operations
/** The AsyncIoController provides a high-performance event loop for managing multiple concurrent
    socket operations. It uses the most efficient I/O mechanism available on each platform
    (epoll on Linux, kqueue on macOS/BSD) via the EventLoop class.

    The controller runs a dedicated I/O thread that processes socket events and drives poll
    operations through their state machines. Operations are submitted via @ref Qore::AsyncIoController::submit(),
    and results are delivered via callback.

    The controller supports:
    - Multiple concurrent operations on different sockets
    - Multiple concurrent operations on the same socket (using custom keys)
    - Cancellation by socket, key, or owner
    - Autostop behavior (I/O thread exits when all operations complete)
    - Wake/force-poll for handling pending writes (HTTP/2)

    @par Thread Safety
    All public methods are thread-safe. The controller uses a single mutex with careful lock
    ordering to avoid deadlocks.

    @par Three-Phase I/O Cycle
    The I/O thread implements a deterministic three-phase polling cycle:
    - Phase 1 (Snapshot under lock): collect operations needing continuePoll()
    - Phase 2 (continuePoll outside lock): drive operations, collect results
    - Phase 3 (Update under lock + deferred delivery): update cache/EventLoop, deliver callbacks

    @anchor asynciocontroller_state_events
    @par State Events
    An operation submitted with a @ref Qore::SocketPollOperationInfo::stateQueue "stateQueue" reports its state
    on that Queue as @ref Qore::SocketPollStateInfo "SocketPollStateInfo" events, so a caller can wait for the
    operation to reach a state by blocking on the Queue instead of calling
    @ref Qore::AbstractPollOperation::getState() "getState()" repeatedly while the controller drives the operation:
    - the controller reads the operation's state after each step, i.e. each
      @ref Qore::AbstractPollOperation::continuePoll() "continuePoll()" call, whether the step continues the
      operation, completes it or raises an exception, on the thread that made the call: the I/O thread for
      operations implemented in C++, a callback worker for operations implemented in %Qore
    - the state after the first step is always reported; after that, a step is reported when it leaves the
      operation in another state than the step before it.  Several state changes made within one step are seen as
      one change, to the state the step leaves
    - with @ref Qore::SocketPollOperationInfo::notifyStates "notifyStates", only changes into one of the given
      states are reported
    - when the operation ends for any reason (its goal is reached, it raises an exception, times out, is canceled,
      replaced by another operation with the same key, or the controller shuts down), one last event is reported
      with \c done set and the last state the controller read, or no state if the operation ended before its first
      step
    - the events of an operation are pushed in the order of its steps, and all of them, the last one included, are
      pushed before the operation's result is pushed to its result Queue or passed to
      @ref Qore::AbstractPollOperation::onComplete() "onComplete()": once the result is received, all events are
      on the state Queue, and once the last event is received, the result follows
    - a submission without a state Queue costs nothing: the controller does not read the operation's state
    - an exception raised by the %Qore @ref Qore::AbstractPollOperation::getState() "getState()" method of an
      operation ends the operation with that exception, as if its step had raised it
    - submitting the same operation again starts a new submission, which reports its first step again

    @par Example: waiting for an operation to reach a state
    @code{.py}
# wait until a QUIC client has completed its handshake and set up HTTP/3, then send a request
Socket sock();
sock.bindINET("127.0.0.1", "0", False, AF_INET, SOCK_DGRAM);
AbstractPollOperation op = sock.startPollQuicConnect("127.0.0.1", port);
Queue<hash<SocketPollStateInfo>> states();
*Queue<hash<SocketPollResultInfo>> result_queue = AsyncIoController::submit(<SocketPollOperationInfo>{
    "sock": sock,
    "spop": op,
    "owner": "quic-client",
    "stateQueue": states,
    "notifyStates": "reading",
});
hash<SocketPollStateInfo> event = states.get();
if (event.done) {
    # the operation ended before it was ready; its result tells why
    hash<SocketPollResultInfo> result = result_queue.get();
    throw result.ex.err, result.ex.desc;
}
sock.submitQuicRequest("GET", "/");
AsyncIoController::wakeSocket(sock);
    @endcode

    @note This class is not available with the @ref PO_NO_NETWORK parse option

    @since %Qore 3.0
*/
qclass AsyncIoController [dom=NETWORK; arg=AsyncIoControllerPriv* ctrl; ns=Qore];

//! Creates a new AsyncIoController
/** @par Example:
    @code{.py}
    auto ctrl = AsyncIoController::get();
    @endcode

    @param auto_stop if @ref True "True" (default), the I/O thread will automatically exit when
    all operations have completed; if @ref False "False", the I/O thread will keep running
    until explicitly stopped

    @throw ASYNCIOCONTROLLER-CONSTRUCTOR-ERROR cannot be instantiated directly; use
    static methods instead
*/
AsyncIoController::constructor(bool[doc] auto_stop = True) [flags=NAMED_ARGS] {
    xsink->raiseException("ASYNCIOCONTROLLER-CONSTRUCTOR-ERROR",
        "AsyncIoController cannot be instantiated; use static methods");
}

//! Destroys the AsyncIoController
/** The singleton is cleaned up during qore_cleanup(); this destructor handles the
    final dereference of the private data.
*/
AsyncIoController::destructor() {
    ctrl->deref(xsink);
}

//! Creates a copy of the AsyncIoController
/** @throw ASYNCIOCONTROLLER-COPY-ERROR AsyncIoController cannot be copied; use
    AsyncIoController::get() to obtain the singleton
*/
AsyncIoController::copy() {
    xsink->raiseException("ASYNCIOCONTROLLER-COPY-ERROR",
        "AsyncIoController cannot be copied; use AsyncIoController::get()");
}

//! Submits an async I/O operation to the global singleton
/** @par Example:
    @code{.py}
    *Queue<hash<SocketPollResultInfo>> q =
        AsyncIoController::submit(operation_info: {"sock": sock, "spop": op, "owner": "server"});
    hash<SocketPollResultInfo> result = q.get();
    @endcode

    @param operation_info the operation info hash; with a
    @ref Qore::SocketPollOperationInfo::stateQueue "stateQueue", the operation also reports its state; see
    @ref asynciocontroller_state_events
    @param replace_existing if @ref True "True", cancel any existing operation with the same key and take its place; otherwise (also if not given) an existing operation under the key is left as it is, and the submission is refused: from an I/O thread of the controller the call raises \c ASYNC-IO-ERROR, and from any other thread the operation's result is a canceled result whose \c ex is that \c ASYNC-IO-ERROR (an operation that is submitted again, as the same object, under its own key is not a collision)

    @return a Queue object for receiving the result, or @ref nothing if a callback was provided
    in the info hash

    @throw ASYNC-IO-ERROR if the controller is shutting down or the info hash is invalid: the result Queue or the
    state Queue has a maximum size, \c notifyStates is given without a \c stateQueue, or a \c stateQueue is given
    for an operation implemented in C++ whose continuePoll() runs on the I/O thread while its getState() is
    implemented in %Qore (%Qore code does not run on the I/O thread, where the controller reads the state of such an
    operation)
    @throw ASYNC-IO-SHUTDOWN-ERROR called at the end of the process by the work of an operation that the module
    cleanup canceled; see @ref asynciocontroller_module_cleanup

    @par At the End of the Process
    @anchor asynciocontroller_module_cleanup
    When the process ends, the modules are deleted one after the other, and the destructors of the objects in their
    data run (a connection that a module keeps is closed, for example).  The operations that these destructors
    cancel end before the next module is deleted, and so does the work that they start:
    - an operation that such a destructor submits (sends a close frame, logs out, flushes a log) is waited for until
      the deadline of the module cleanup, whatever its own timeout (\c to): one deadline for the whole cleanup, 5
      seconds after its start by default, set with the \c QORE_MODULE_CLEANUP_TIMEOUT
      @ref environment_variables "environment variable" or the \c --module-cleanup-timeout option of \c qore, in
      milliseconds; at the deadline, the operations that have not ended are canceled (their
      @ref Qore::AbstractPollOperation::onComplete() "onComplete()" runs with a canceled result), and a warning that
      names them is written on the standard error output; an operation that such a destructor submits after the
      deadline is canceled when the cleanup goes on, unless the destructor waits for it.  The deadline is not extended
      by an operation whose own timeout is renewed as it makes progress, such as a connection that keeps receiving data.
      It bounds the waits of the cleanup for this work, not a destructor that itself waits for the result of the
      operation that it submits: such a destructor gives its operation a timeout
    - a task that such a destructor or that work submits (@ref submitTask()) is waited for; it is not canceled
    - work that the cleanup counts and that module code hands over to a thread that is already running (with
      @ref holdModuleCleanupWork(), as a non-blocking gate that leaves a stream notification to the thread already
      processing the stream does) is waited for until that thread releases it, at most the grace period after the
      deadline (\c QORE_MODULE_CLEANUP_HANDOVER_GRACE or the \c --module-cleanup-handover-grace option of \c qore, in
      milliseconds; by default the deadline, but at least 5 seconds); then a warning that names it is written on the
      standard error output, the cleanup no longer waits for it, and the modules and their Programs are left as they
      are, as the threads that hold it can still run in them
    - a timer that such a destructor or that work adds is canceled before the next module is deleted (its cancel
      callback, if it was added with one, runs then); a timer whose
      callback adds it again keeps the cleanup waiting for its callbacks until the deadline, after which the callback
      cannot add it again
    - the work of an operation that the end of the process canceled (its
      @ref Qore::AbstractPollOperation::abort() "abort()", its
      @ref Qore::AbstractPollOperation::onComplete() "onComplete()", and the destructors that the release of its
      references runs) cannot start new asynchronous work: an
      @ref Qore::AbstractPollOperation::onComplete() "onComplete()" that submits its operation again (a reader that
      re-arms itself, a retry), adds a timer or submits a task gets an \c ASYNC-IO-SHUTDOWN-ERROR exception, so that
      the process ends; nor can the work that the cleanup handed over add a timer after its deadline (a timer
      callback that adds its timer again, a heartbeat), nor a task of the cleanup submit a task then (a task that
      submits itself again); an operation that such work submits after the deadline is canceled when the controller
      admits it.  Synchronous I/O and
      @ref exec() are not refused: in the work that the cleanup handed over (a callback worker), an operation that
      they start after the deadline gets a canceled result at once, while in a destructor that the cleanup runs it
      keeps its own timeout

    @note The steps of the operation that run on callback workers, such as
    @ref Qore::AbstractPollOperation::continuePoll() "continuePoll()" and
    @ref Qore::AbstractPollOperation::onComplete() "onComplete()" of an operation implemented in %Qore, are
    governed by the @ref sandboxing "sandbox" of the code that submits the operation, so that a connection made
    there is subject to the same policy as one made by the submitting code; an operation submitted by such a step
    is governed by the same sandbox

    @note A builtin HTTP or WebSocket client or server poll operation, @ref Qore::PollPipeline "PollPipeline" or
    @ref Qore::DelegatingPollOperation "DelegatingPollOperation" that is deleted with the @ref delete "delete operator"
    while the controller holds it is canceled: it is not continued again, and its result is a canceled result; its
    state is released when the controller no longer uses it

    @note An operation belongs to the application that it is submitted for: the Program of the submitting code, or
    the application that module code runs for (also module code that other module code calls for it), or none for
    the initialization of library code (also in a callback); an operation submitted by a callback of an operation
    belongs to that operation's application, unless the callback is the sandboxed code of an application Program,
    whose operations belong to its own application.  Code that is sandboxed, or acts for sandboxed code, does not
    replace the operation of another application with \a replace_existing, nor, if it runs for no known application,
    any operation other than its own operation object: on the I/O thread of the key, the submission raises
    \c ASYNC-IO-KEY-ERROR; from another thread, its operation is not started and its result is a canceled result whose
    \c ex is that error.  Without \a replace_existing, a submission with a key in use is refused as for any caller
    (\c ASYNC-IO-ERROR).  The operation with the key is not affected

    @since %Qore 3.0
*/
static *Queue<hash<SocketPollResultInfo>> AsyncIoController::submit(hash<SocketPollOperationInfo> operation_info,
        *bool replace_existing)
        [flags=NAMED_ARGS] {
    // not refused by the internal submit, which synchronous I/O also uses (qore#7027)
    if (AsyncIoControllerPriv::checkModuleCleanupNewWork("submit", false, xsink)) {
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    // submit() takes ownership of `operation_info` (see the ReferenceHolder in
    // AsyncIoControllerPriv::submit that plugs the per-call leak); our
    // QPP-generated caller still owns its own ref on the method arg, so
    // hand submit() an explicit self-ref via hashRefSelf().
    if (check_submitted_operation(operation_info, "AsyncIoController::submit()", xsink)) {
        return QoreValue();
    }
    return ctrl->submit(obj, operation_info->hashRefSelf(), replace_existing, xsink);
}

//! Executes an async I/O operation on the global singleton and waits for its result
/** This is the blocking companion to @ref Qore::AsyncIoController::submit(). It uses the controller event loop
    for the actual I/O operation, then waits on the operation's result Queue.

    @param operation_info the operation info hash; as with @ref Qore::AsyncIoController::submit() "submit()", a
    \c stateQueue receives the operation's state events, all of them before this method returns
    @param replace_existing if @ref True "True", cancel any existing operation with the same key and take its place; otherwise (also if not given) an existing operation under the key is left as it is, and the submission is refused: from an I/O thread of the controller the call raises \c ASYNC-IO-ERROR, and from any other thread the operation's result is a canceled result whose \c ex is that \c ASYNC-IO-ERROR (an operation that is submitted again, as the same object, under its own key is not a collision)

    @return the operation result hash

    @throw ASYNC-IO-ERROR if the controller is shutting down, the info hash is invalid (see
    @ref Qore::AsyncIoController::submit() "submit()"), or the operation uses an
    @ref AbstractPollOperation::onComplete() "onComplete()" callback, or if called from the async I/O thread
    @since %Qore 3.0
*/
static hash<SocketPollResultInfo> AsyncIoController::exec(hash<SocketPollOperationInfo> operation_info,
        *bool replace_existing) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    if (check_submitted_operation(operation_info, "AsyncIoController::exec()", xsink)) {
        return QoreValue();
    }
    return ctrl->exec(obj, operation_info->hashRefSelf(), replace_existing, xsink);
}

//! Cancels an operation by socket on the global singleton
/** @param io_object the I/O object whose operation should be canceled
    @return @ref True "True" if an operation was found and canceled
    @since %Qore 3.0
*/
static bool AsyncIoController::cancel(AbstractPollableIoObjectBase[AbstractPollableIoObjectBase] io_object)
        [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancel(*io_object, xsink);
}

//! Cancels an operation by I/O object and closes it
/** Cancels the poll operation associated with the given I/O object, then shuts down
    and closes it via closeIo(). This is the proper way to tear down a connection whose
    lifecycle is managed by the async I/O controller.

    @param io_object the I/O object whose operation should be canceled and then closed
    @return @ref True "True" if an operation was found and canceled

    @since %Qore 3.0
*/
static bool AsyncIoController::cancelAndClose(AbstractPollableIoObjectBase[AbstractPollableIoObjectBase] io_object)
        [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelAndClose(*io_object, xsink);
}

//! Cancels an operation by key on the global singleton
/** The operation is found on whichever I/O thread runs it.

    Code that is sandboxed, or acts for sandboxed code, cancels only an operation of its own application: an
    operation belongs to the application that it is submitted for (see the notes of @ref submit()); an operation of
    another application with the key, or of none (an operation of the initialization of library code), is not
    canceled (see @ref sandbox_process_wide_registries)

    The code of a thread that module code starts runs for no application, as such a thread can serve every caller
    of the module: a tenant cannot cancel its own operation or timer through such a thread, nor can any other code that
    is sandboxed; giving the application of a call to the thread that serves it is
    <a href="https://github.com/qoretechnologies/qore/issues/6245">issue #6245</a>.

    @param key the operation key to cancel
    @return @ref True "True" if an operation was found and canceled; when called on an I/O thread of the controller
    (in a poll operation's callback, for example), an operation on another I/O thread is canceled asynchronously, as
    an I/O thread never waits for another one, so @ref True "True" then only means that the cancel was requested, also
    when no operation has the key
    @since %Qore 3.0
*/
static bool AsyncIoController::cancelByKey(string key) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelByKey(key, xsink);
}

//! Cancels all operations for an owner on the global singleton
/** Code that is sandboxed, or acts for sandboxed code, cancels only the operations of its own application (an
    operation belongs to the application that it is submitted for; see the notes of @ref submit()) and records the
    owner as canceled (which cancels the owner's operations submitted meanwhile) only if it canceled one of them; the
    operations of another application with the owner, or of none, are not affected (see
    @ref sandbox_process_wide_registries)

    The code of a thread that module code starts runs for no application, as such a thread can serve every caller
    of the module: a tenant cannot cancel its own operation or timer through such a thread, nor can any other code that
    is sandboxed; giving the application of a call to the thread that serves it is
    <a href="https://github.com/qoretechnologies/qore/issues/6245">issue #6245</a>.

    @param owner the owner identifier whose operations should be canceled
    @return the number of operations canceled
    @since %Qore 3.0
*/
static int AsyncIoController::cancelByOwner(string owner) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelByOwner(owner, xsink);
}

//! Wakes the I/O thread for a specific socket with pending data
/** Enqueues a targeted re-poll command for the given socket. The I/O thread
    includes that socket's operation in the next poll cycle regardless of
    EventLoop socket readiness, allowing queued send data to be transmitted.

    @param io_object the I/O object whose operation needs re-polling

    @since %Qore 3.0
*/
static nothing AsyncIoController::wakeSocket(AbstractPollableIoObjectBase[AbstractPollableIoObjectBase] io_object)
        [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    // Use QoreObject unique hash — the private data pointer
    // (AbstractPollableIoObjectBase*) can change during QUIC handshake when
    // the socket is reconfigured, causing hash mismatches with the cache key.
    // The QoreObject unique hash is stable across the connection lifecycle.
    ctrl->wakeSocketByObject(const_cast<QoreObject*>(obj_io_object), xsink);
}

//! Waits for all pending onComplete/abort callbacks to be processed
/** Call after cancelByOwner() to ensure all cancelled operation callbacks
    have been delivered before stopping thread pools that depend on them.

    This prevents shutdown deadlocks where a ThreadPool.stop() blocks
    waiting for handler threads that are waiting for onComplete() to
    signal their done counter.

    @since %Qore 3.0
*/
static nothing AsyncIoController::flushCallbacks() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->flushCallbacks();
}

//! Waits for in-flight callbacks tagged with the given owner to drain
/** Narrowed-scope companion to @ref flushCallbacks() that only waits for
    callbacks whose operations were submitted with the matching @a owner.
    Safe to call from a per-owner teardown path (e.g. a connection manager's
    destructor) where the global flush would deadlock on unrelated long-running
    work on the shared controller.

    Marks the owner as shutting down for the duration of the wait: any callback
    picked up by a worker while the mark is set is silently discarded instead
    of dispatched to user code.  The mark is cleared before return, so later
    submits by a new object reusing the owner string are unaffected.

    Code that is sandboxed, or acts for sandboxed code, discards only the callbacks of the operations of its own
    application (see @ref cancelByOwner()); the callbacks of other code's operations with the owner run

    @param owner the owner identifier to wait for

    @since %Qore 3.0
*/
static nothing AsyncIoController::flushCallbacksByOwner(string owner) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->flushCallbacksByOwner(std::string(owner->c_str()));
}

//! Waits for the global singleton's I/O thread to be ready
/** @param timeout_ms timeout for waiting; use 0 to wait indefinitely
    @return @ref True "True" if the I/O thread is ready within the timeout
    @since %Qore 3.0
*/
static bool AsyncIoController::waitReady(*timeout timeout_ms) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->waitReady(timeout_ms, xsink);
}

//! Waits until the global singleton has processed all currently submitted operations
/** @param timeout_ms timeout for waiting; use 0 to wait indefinitely
    @return @ref True "True" if all submitted operations have been processed

    @throw ASYNC-IO-ERROR if called from an async I/O controller I/O thread

    @since %Qore 3.0
*/
static bool AsyncIoController::waitForProcessing(*timeout timeout_ms) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->waitForProcessing(timeout_ms, xsink);
}

//! Returns true if the global singleton's I/O thread is running
/** @return @ref True "True" if the I/O thread is running
    @since %Qore 3.0
*/
static bool AsyncIoController::running() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->running();
}

//! Returns the number of cached operations on the global singleton
/** @return the number of active operations in the cache, which counts the operations of every caller in the process

    @throw PERMISSION-DENIED code that is sandboxed or acts for sandboxed code cannot call this method, which counts
    the operations of every caller in the process (see @ref sandbox_process_wide_registries)

    @since %Qore 3.0
*/
static int AsyncIoController::getCacheSize() {
    // the operations of every caller of the process-wide controller: not disclosed to sandboxed code (issue #6836)
    if (qore_caller_is_sandboxed()) {
        xsink->raiseException("PERMISSION-DENIED", "code that is sandboxed or acts for sandboxed code cannot read the "
            "number of operations of the global async I/O controller, which counts the operations of every caller in "
            "the process");
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getCacheSize();
}

//! Sets the autostop flag on the global singleton
/** @param auto_stop if @ref True "True", the I/O thread will exit when all operations complete

    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot change the autostop
    flag, which is process-wide (see @ref sandbox_process_wide_registries)

    @since %Qore 3.0
*/
static nothing AsyncIoController::setAutostop(bool auto_stop = True) [flags=NAMED_ARGS] {
    // the controller is process-wide: refused to sandboxed code (issue #6836)
    if (qore_check_process_wide_registration("change the autostop flag of the global async I/O controller",
            xsink)) {
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setAutostop(auto_stop);
}

//! Returns the autostop flag from the global singleton
/** @return @ref True "True" if autostop is enabled

    @note any code can read the flag, also code that is sandboxed or acts for sandboxed code: it is a setting that only
    trusted code can change (see @ref setAutostop()) and holds no data of any caller

    @since %Qore 3.0
*/
static bool AsyncIoController::getAutostop() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getAutostop();
}

//! Returns info about the global singleton's state
/** @return a hash with controller state information with the following keys:
    - \c running: @ref True "True" if an I/O thread is running
    - \c autostop: the autostop flag
    - \c shutting_down: @ref True "True" if the controller is shutting down
    - \c tid: the thread ID of the first I/O thread (0 if it is not running)
    - \c cache_size: the number of operations in the controller
    - \c cache_keys: the keys of all operations in the controller
    - \c threads: a list with one hash per running I/O thread, ordered by index, with the keys \c index (the
      thread's index), \c tid (its thread ID), \c cache_keys (the keys of the operations on that thread),
      \c timeouts (the number of entries in the thread's timeout heap), \c extra_fds (the number of extra descriptors
      registered for the operations on that thread) and \c orphan_registrations (the number of event registrations
      that the thread has removed because nothing was running for them; not 0 only if an operation left a registration
      behind, which is a bug in %Qore); called from an I/O thread, only that thread is listed
    - \c io_threads: the number of I/O threads the controller runs (see @ref setMaxIoThreads())

    @note code that is sandboxed or acts for sandboxed code gets the settings of the controller only (\c running,
    \c autostop, \c shutting_down and \c io_threads): the other keys give the operations of every caller in the
    process (see @ref getCacheSize())

    @since %Qore 3.0
*/
static hash<auto> AsyncIoController::getInfo() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    // the keys and counts of the operations of every caller of the process-wide controller are not disclosed to
    // sandboxed code (qore#7010), as getCacheSize(); its settings are
    if (qore_caller_is_sandboxed()) {
        return ctrl->getSettingsInfo(xsink);
    }
    return ctrl->getInfo(xsink);
}

//! Sets the logger on the global singleton
/** @param logger a @ref Qore::LoggerInterfaceBase "LoggerInterfaceBase" object for logging,
    or @ref nothing "NOTHING" to disable per-controller logging

    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot set or clear the
    logger, which is process-wide (see @ref sandbox_process_wide_registries)

    @note an \c HttpServer sets its logger here while it runs and gives back the logger it replaced when it stops,
    unless the logger has been replaced since; a server that sandboxed code creates does not

    @note an exception raised by the code of a timer (@ref addTimer(), @ref addTimerDelay()), by the timer callback
    (@ref setTimerCallback()) or by a callback of an operation that the controller runs (a completion, frame or stream
    callback, for example) is logged by this logger at the error level, or else by the async I/O logger
    (@ref Qore::set_async_io_logger() "set_async_io_logger()"); without a logger, it is reported as an unhandled
    exception on the standard error output, so that the failure of a callback is never silent.  An exception raised by
    a task (@ref submitTask()) is always reported as an unhandled exception on the standard error output

    @see getLogger()

    @since %Qore 3.0
*/
static nothing AsyncIoController::setLogger(*LoggerInterfaceBase logger) [flags=NAMED_ARGS] {
    // the controller is process-wide: refused to sandboxed code (issue #6743)
    if (qore_check_process_wide_registration("set the logger of the global async I/O controller", xsink)) {
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setLogger(const_cast<QoreObject*>(logger), xsink);
}

//! Returns the logger of the global singleton
/** @return the logger set with @ref setLogger(), or @ref nothing "NOTHING" if none is set or if the caller is code
    that is sandboxed or acts for sandboxed code, which does not get the logger of the process (see
    @ref sandbox_process_wide_registries)

    @par Example:
    @code{.py}
*LoggerInterfaceBase logger = AsyncIoController::getLogger();
    @endcode

    @see setLogger()

    @since %Qore 3.0
*/
static *LoggerInterfaceBase AsyncIoController::getLogger() {
    // the logger is process-wide and configured by the host: not handed to sandboxed code (issue #6836)
    if (qore_caller_is_sandboxed()) {
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getLogger();
}

//! Adds a timer on the global singleton
/** When \a user_data is a closure or call-reference, the runtime automatically dispatches
    it to a worker thread in the async-I/O controller's dispatcher pool when the
    deadline fires — it is @b not invoked on the I/O thread, so it may block, acquire
    locks, or perform Qore-level I/O.

    For non-callable \a user_data (numbers, strings, hashes, …), the value is passed to
    the timer callback registered via @ref setTimerCallback() (also dispatched to a
    worker thread).  With no callback installed, non-callable \a user_data is silently
    dropped.

    @par Module Code and Restricted Callers
    Module code that runs for a caller that may not control threads (a Qorus service, for example, has
    @ref Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL") can schedule only its own code: code of a %Program that
    allows what the caller may not.  The caller's own code (a closure, or a method that a class of the caller
    overrides) is refused with \c INVALID-FUNCTION-ACCESS, whose description gives the reason, for example <em>the
    callback's Program does not allow thread control (PO_NO_THREAD_CONTROL)</em>, and so is non-callable timer data,
    which the process-wide timer callback would receive; see @ref MODULE_OWNED

    @param deadline the absolute deadline for the timer
    @param user_data either a closure/call-reference to dispatch, or arbitrary user data
        to deliver through the @ref setTimerCallback() handler
    @return the unique timer ID

    @note The deadline is a time of the system clock: a step of the system clock (a VM's time synchronization, a manual
    change) moves the time at which the timer fires; use @ref addTimerDelay() for a timer that fires after an interval

    @note A timer that a destructor adds at the end of the process, when the modules are deleted, is canceled before
    the next module is deleted; see @ref asynciocontroller_module_cleanup

    @throw ASYNC-IO-SHUTDOWN-ERROR called at the end of the process by the work of an operation that the module
    cleanup canceled, or by work that the cleanup handed over after its deadline; see
    @ref asynciocontroller_module_cleanup

    @throw INVALID-FUNCTION-ACCESS module code running for a restricted caller added a timer with code that is not
    its own, or with non-callable data

    @note an exception that the code of the timer raises is logged at the error level by the controller's logger
    (@ref setLogger()) or else by the async I/O logger (@ref Qore::set_async_io_logger() "set_async_io_logger()");
    without a logger, it is reported as an unhandled exception on the standard error output

    @since %Qore 3.0
*/
static int AsyncIoController::addTimer(date deadline, auto user_data)
        [dom=NETWORK,THREAD_CONTROL;flags=NAMED_ARGS,MODULE_OWNED] {
    if (AsyncIoControllerPriv::checkModuleCleanupNewWork("addTimer", true, xsink)) {
        return 0;
    }
    if (qore_check_module_owned_code(user_data, QDOM_NETWORK | QDOM_THREAD_CONTROL, "AsyncIoController::addTimer()",
            "schedule", xsink)
            || qore_check_thread_callable(user_data, QDOM_THREAD_CONTROL, "AsyncIoController::addTimer()", xsink)) {
        return 0;
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimer(deadline, user_data, xsink);
}

//! Adds an owner-tagged timer on the global singleton
/** Identical to @ref addTimer(date, auto) but tags the timer's callback dispatch with \a owner, so a
    teardown path can deterministically drain a fired-but-not-yet-run callback via
    @ref flushCallbacksByOwner() (in addition to cancelling not-yet-fired timers with @ref cancelTimer()).
    This closes the teardown race where a timer fires, its callback is dispatched to a worker, and the
    owning object is destroyed before the callback runs.

    @par Module Code and Restricted Callers
    Module code that runs for a caller that may not control threads (a Qorus service, for example, has
    @ref Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL") can schedule only its own code: code of a %Program that
    allows what the caller may not.  The caller's own code (a closure, or a method that a class of the caller
    overrides) is refused with \c INVALID-FUNCTION-ACCESS, whose description gives the reason, for example <em>the
    callback's Program does not allow thread control (PO_NO_THREAD_CONTROL)</em>, and so is non-callable timer data,
    which the process-wide timer callback would receive; see @ref MODULE_OWNED

    @param deadline the absolute deadline for the timer
    @param udata either a closure/call-reference to dispatch, or arbitrary user data
        to deliver through the @ref setTimerCallback() handler
    @param owner the owner identifier to tag the timer's callback dispatch with
    @param cancel_callback an optional @ref closure "closure" or @ref call_reference "call reference" run when the
    module cleanup cancels the timer at the end of the process (see @ref asynciocontroller_module_cleanup), so that
    code that counts its scheduled timers can balance the count of a timer whose callback then never runs; it is not
    run when the timer fires, when it is canceled with @ref cancelTimer() or when the controller stops
    @return the unique timer ID

    @note The deadline is a time of the system clock: a step of the system clock (a VM's time synchronization, a manual
    change) moves the time at which the timer fires; use @ref addTimerDelay() for a timer that fires after an interval

    @note A timer that a destructor adds at the end of the process, when the modules are deleted, is canceled before
    the next module is deleted; see @ref asynciocontroller_module_cleanup

    @throw ASYNC-IO-SHUTDOWN-ERROR called at the end of the process by the work of an operation that the module
    cleanup canceled, or by work that the cleanup handed over after its deadline; see
    @ref asynciocontroller_module_cleanup

    @throw INVALID-FUNCTION-ACCESS module code running for a restricted caller added a timer with code that is not
    its own, or with non-callable data

    @note an exception that the code of the timer raises is logged at the error level by the controller's logger
    (@ref setLogger()) or else by the async I/O logger (@ref Qore::set_async_io_logger() "set_async_io_logger()");
    without a logger, it is reported as an unhandled exception on the standard error output

    @since %Qore 3.0
*/
static int AsyncIoController::addTimer(date deadline, auto udata, string owner,
        *code<nothing()> cancel_callback)
        [dom=NETWORK,THREAD_CONTROL;flags=MODULE_OWNED] {
    if (AsyncIoControllerPriv::checkModuleCleanupNewWork("addTimer", true, xsink)) {
        return 0;
    }
    if (qore_check_module_owned_code(udata, QDOM_NETWORK | QDOM_THREAD_CONTROL, "AsyncIoController::addTimer()",
            "schedule", xsink)
            || qore_check_thread_callable(udata, QDOM_THREAD_CONTROL, "AsyncIoController::addTimer()", xsink)
        || (cancel_callback
            && (qore_check_module_owned_code(cancel_callback, QDOM_NETWORK | QDOM_THREAD_CONTROL,
                    "AsyncIoController::addTimer()", "schedule", xsink)
                || qore_check_thread_callable(cancel_callback, QDOM_THREAD_CONTROL,
                    "AsyncIoController::addTimer()", xsink)))) {
        return 0;
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimer(deadline, udata, xsink, owner->c_str(),
        const_cast<ResolvedCallReferenceNode*>(cancel_callback));
}

//! Adds a timer on the global singleton that fires after the given delay
/** As @ref addTimer(date, auto), but the timer fires when \a delay has passed since the call, measured on the
    monotonic clock: a step of the system clock (a VM's time synchronization, a manual change) does not move it, as it
    moves a timer added with @ref addTimer() for @ref Qore::now_us() "now_us()" plus an interval.  Use it for timers
    of an interval: heartbeats, idle checks, retries and timeouts.

    @par Example:
    @code{.py}
# check the connection once a second, whatever the system clock does
int timer_id = AsyncIoController::addTimerDelay(1s, sub () { checkConnection(); });
    @endcode

    @par Module Code and Restricted Callers
    As for @ref addTimer(date, auto); see @ref MODULE_OWNED

    @param delay the time after which the timer fires; zero or a negative value fires it at once
    @param user_data either a closure/call-reference to dispatch, or arbitrary user data
        to deliver through the @ref setTimerCallback() handler
    @return the unique timer ID, which @ref cancelTimer() takes

    @note A timer that a destructor adds at the end of the process, when the modules are deleted, is canceled before
    the next module is deleted; see @ref asynciocontroller_module_cleanup

    @throw ASYNC-IO-SHUTDOWN-ERROR called at the end of the process by the work of an operation that the module
    cleanup canceled, or by work that the cleanup handed over after its deadline; see
    @ref asynciocontroller_module_cleanup

    @throw INVALID-FUNCTION-ACCESS module code running for a restricted caller added a timer with code that is not
    its own, or with non-callable data

    @note an exception that the code of the timer raises is logged at the error level by the controller's logger
    (@ref setLogger()) or else by the async I/O logger (@ref Qore::set_async_io_logger() "set_async_io_logger()");
    without a logger, it is reported as an unhandled exception on the standard error output

    @since %Qore 3.0
*/
static int AsyncIoController::addTimerDelay(timeout delay, auto user_data)
        [dom=NETWORK,THREAD_CONTROL;flags=NAMED_ARGS,MODULE_OWNED] {
    if (AsyncIoControllerPriv::checkModuleCleanupNewWork("addTimerDelay", true, xsink)) {
        return 0;
    }
    if (qore_check_module_owned_code(user_data, QDOM_NETWORK | QDOM_THREAD_CONTROL,
            "AsyncIoController::addTimerDelay()", "schedule", xsink)
            || qore_check_thread_callable(user_data, QDOM_THREAD_CONTROL, "AsyncIoController::addTimerDelay()",
                xsink)) {
        return 0;
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimerDelay(delay * 1000, user_data, xsink);
}

//! Adds an owner-tagged timer on the global singleton that fires after the given delay
/** As @ref addTimerDelay(timeout, auto), with the callback dispatch tagged with \a owner as with
    @ref addTimer(date, auto, string)

    @par Example:
    @code{.py}
int timer_id = AsyncIoController::addTimerDelay(30s, sub () { sendHeartbeat(); }, owner);
    @endcode

    @par Module Code and Restricted Callers
    As for @ref addTimer(date, auto); see @ref MODULE_OWNED

    @param delay the time after which the timer fires; zero or a negative value fires it at once
    @param udata either a closure/call-reference to dispatch, or arbitrary user data
        to deliver through the @ref setTimerCallback() handler
    @param owner the owner identifier to tag the timer's callback dispatch with
    @param cancel_callback an optional @ref closure "closure" or @ref call_reference "call reference" run when the
    module cleanup cancels the timer at the end of the process (see @ref asynciocontroller_module_cleanup), so that
    code that counts its scheduled timers can balance the count of a timer whose callback then never runs; it is not
    run when the timer fires, when it is canceled with @ref cancelTimer() or when the controller stops
    @return the unique timer ID, which @ref cancelTimer() takes

    @note A timer that a destructor adds at the end of the process, when the modules are deleted, is canceled before
    the next module is deleted; see @ref asynciocontroller_module_cleanup

    @throw ASYNC-IO-SHUTDOWN-ERROR called at the end of the process by the work of an operation that the module
    cleanup canceled, or by work that the cleanup handed over after its deadline; see
    @ref asynciocontroller_module_cleanup

    @throw INVALID-FUNCTION-ACCESS module code running for a restricted caller added a timer with code that is not
    its own, or with non-callable data

    @note an exception that the code of the timer raises is logged at the error level by the controller's logger
    (@ref setLogger()) or else by the async I/O logger (@ref Qore::set_async_io_logger() "set_async_io_logger()");
    without a logger, it is reported as an unhandled exception on the standard error output

    @since %Qore 3.0
*/
static int AsyncIoController::addTimerDelay(timeout delay, auto udata, string owner,
        *code<nothing()> cancel_callback)
        [dom=NETWORK,THREAD_CONTROL;flags=MODULE_OWNED] {
    if (AsyncIoControllerPriv::checkModuleCleanupNewWork("addTimerDelay", true, xsink)) {
        return 0;
    }
    if (qore_check_module_owned_code(udata, QDOM_NETWORK | QDOM_THREAD_CONTROL,
            "AsyncIoController::addTimerDelay()", "schedule", xsink)
            || qore_check_thread_callable(udata, QDOM_THREAD_CONTROL, "AsyncIoController::addTimerDelay()", xsink)
        || (cancel_callback
            && (qore_check_module_owned_code(cancel_callback, QDOM_NETWORK | QDOM_THREAD_CONTROL,
                    "AsyncIoController::addTimerDelay()", "schedule", xsink)
                || qore_check_thread_callable(cancel_callback, QDOM_THREAD_CONTROL,
                    "AsyncIoController::addTimerDelay()", xsink)))) {
        return 0;
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimerDelay(delay * 1000, udata, xsink, owner->c_str(),
        const_cast<ResolvedCallReferenceNode*>(cancel_callback));
}

//! Cancels a timer on the global singleton
/** @param timer_id the timer ID returned by @ref addTimer()
    @return @ref True "True" if the timer was found and canceled

    @par Sandboxed Code
    A timer belongs to the application of the code that adds it: that of the sandboxed %Program that adds it, or of
    the caller that module code adds it for.  Code that is sandboxed (by a @ref Qore::SandboxManager "SandboxManager"
    or by the restrictions of its %Program) cancels only the timers of the application that it runs for, as timer
    IDs can be guessed: a tenant cancels the timers that it added and that module code added in its calls, and not
    those of the host or of another tenant, directly, through module code or in a thread that module code starts;
    for any other timer, this method returns @ref False "False" (see @ref sandbox_process_wide_registries)

    Sandboxed code that runs for no application cancels only the timers for no application that its own work added.
    Such is the code of a thread that module code starts, which can serve every caller of the module (a module's
    service thread, started during the call of one application): it keeps the restrictions and the sandbox of the
    code that started it, but not its application, so the timers that it adds belong to no application.  No
    application can cancel them, not even the one whose call started the thread, and the thread cancels only the
    timers that it added itself, also through the work that it hands to other threads (a task of a
    @ref Qore::Thread::ThreadPool "ThreadPool", the code of a timer that it adds), not those of an application, of
    the host or of another thread that module code started, even when their work runs on the same worker thread.
    Module
    code cannot yet give the context of a call to the thread that serves it, so that the work of the thread would
    belong to the call's application; see <a href="https://github.com/qoretechnologies/qore/issues/6245">issue
    #6245</a>.

    @par Module Code and Restricted Callers
    Module code that runs for an application with restrictions (a Qorus service, for example) can moreover cancel
    only the timers that module code added for the same application, the first %Program in the chain of callers that
    is not a module, so a restricted caller cannot use module code to cancel timers of other applications or of the
    host; see @ref MODULE_OWNED

    Code that is not sandboxed (the host, and a thread that module code starts outside the call of sandboxed code, as
    in its initialization) can cancel any timer: a module that relays the requests of applications to such a thread
    lets them cancel each other's timers.

    @since %Qore 3.0
*/
static bool AsyncIoController::cancelTimer(int timer_id) [dom=NETWORK,THREAD_CONTROL;flags=NAMED_ARGS,MODULE_OWNED] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelTimer(timer_id, xsink);
}

//! Sets the timer callback on the global singleton
/** The callback is invoked once per fire of a timer whose \c user_data is @b not a closure or
    call-reference (those are auto-dispatched directly; see @ref addTimer()).  The runtime
    dispatches the callback to a worker thread in the async-I/O controller's dispatcher
    pool — it is @b not invoked on the I/O thread.

    @param callback a callback that accepts a @ref TimerEventInfo hash argument, or
        @ref nothing to disable timer event delivery for non-callable \c user_data

    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot set or clear the timer
    callback, which is process-wide (see @ref sandbox_process_wide_registries)

    @note an exception that the callback raises is logged at the error level by the controller's logger
    (@ref setLogger()) or else by the async I/O logger (@ref Qore::set_async_io_logger() "set_async_io_logger()");
    without a logger, it is reported as an unhandled exception on the standard error output

    @since %Qore 3.0
*/
static nothing AsyncIoController::setTimerCallback(*code callback) [dom=NETWORK,PROCESS,THREAD_CONTROL;flags=NAMED_ARGS] {
    // the controller is process-wide: refused to sandboxed code (issue #6743)
    if (qore_check_process_wide_registration("set the timer callback of the global async I/O controller", xsink)) {
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    // the callback runs on the controller's workers (qore#7056)
    if (qore_check_thread_callable(callback, QDOM_THREAD_CONTROL, "AsyncIoController::setTimerCallback()", xsink)) {
        return QoreValue();
    }
    ctrl->setTimerCallback(callback ? callback->refRefSelf() : nullptr, xsink);
}

//! Submits a task to the global singleton's thread pool
/** @param task the @ref closure "closure" or @ref call_reference "call reference" to execute
    @param cancel_callback an optional @ref closure "closure" or @ref call_reference "call reference"
    to execute if the pool is stopped before the task can be executed, or if the end of the process refuses the task
    (see @ref asynciocontroller_module_cleanup); in that case it is run in the calling thread before the
    \c ASYNC-IO-SHUTDOWN-ERROR exception is raised

    @throw ASYNC-IO-ERROR if the controller's thread pool has been stopped
    @throw INVALID-FUNCTION-ACCESS module code running for a restricted caller submitted code that is not its own
    @throw ASYNC-IO-SHUTDOWN-ERROR called at the end of the process by the work of an operation that the module
    cleanup canceled; see @ref asynciocontroller_module_cleanup

    @note A task that a destructor or its work submits at the end of the process, when the modules are deleted, is
    waited for before the next module is deleted; see @ref asynciocontroller_module_cleanup

    @par Module Code and Restricted Callers
    Module code that runs for a caller that may not control threads (a Qorus service, for example, has
    @ref Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL") can submit only its own code: code of a %Program that
    allows what the caller may not.  The caller's own code (a closure, or a method that a class of the caller
    overrides) is refused with \c INVALID-FUNCTION-ACCESS, whose description gives the reason, for example <em>the
    callback's Program does not allow thread control (PO_NO_THREAD_CONTROL)</em>; see @ref MODULE_OWNED

    @note an exception that the task raises is reported as an unhandled exception on the standard error output, not
    to the controller's logger (@ref setLogger())

    @since %Qore 3.0
*/
static nothing AsyncIoController::submitTask(code<nothing()> task, *code<nothing()> cancel_callback)
        [dom=NETWORK,THREAD_CONTROL;flags=NAMED_ARGS,MODULE_OWNED] {
    if (qore_check_module_owned_code(task, QDOM_NETWORK | QDOM_THREAD_CONTROL, "AsyncIoController::submitTask()",
            "schedule", xsink)
        || qore_check_thread_callable(task, QDOM_THREAD_CONTROL, "AsyncIoController::submitTask()", xsink)
        || (cancel_callback
            && (qore_check_module_owned_code(cancel_callback, QDOM_NETWORK | QDOM_THREAD_CONTROL,
                    "AsyncIoController::submitTask()", "schedule", xsink)
                || qore_check_thread_callable(cancel_callback, QDOM_THREAD_CONTROL, "AsyncIoController::submitTask()",
                    xsink)))) {
        return QoreValue();
    }
    if (AsyncIoControllerPriv::checkModuleCleanupNewWork("submitTask", false, xsink)) {
        // the task does not run: its owner is told with the cancel callback, run in this thread before the exception
        // is raised, so that an owner that counts its tasks balances its count (qore#7116); an exception that the
        // callback raises follows the ASYNC-IO-SHUTDOWN-ERROR exception
        if (cancel_callback) {
            ExceptionSink cancel_xsink;
            cancel_callback->execValue(nullptr, &cancel_xsink).discard(&cancel_xsink);
            xsink->assimilate(cancel_xsink);
        }
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->submitTask(task->refRefSelf(), cancel_callback ? cancel_callback->refRefSelf() : nullptr, xsink);
}

//! Sets the maximum number of callback dispatcher worker threads on the global singleton
/** Controls the concurrency of user callback dispatch off the I/O thread.

    The default is @code{.py}hardware_concurrency() * 4@endcode, capped at 512 and falling
    back to 4 if the hardware thread count is unavailable.

    Takes effect when the dispatcher or submitTask() pool is next created.

    @param max_workers the maximum number of workers; 0 = auto (hardware_concurrency() * 4,
    capped at 512, fallback 4)

    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot change the maximum
    number of callback workers, which is process-wide (see @ref sandbox_process_wide_registries)

    @since %Qore 3.0
*/
static nothing AsyncIoController::setMaxCallbackWorkers(int max_workers = 0)
        [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    // the controller is process-wide: refused to sandboxed code (issue #6836)
    if (qore_check_process_wide_registration("change the maximum number of callback workers of the global async I/O "
            "controller", xsink)) {
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setMaxCallbackWorkers((int)max_workers);
}

//! Sets the number of I/O threads for the global async I/O controller
/** @param max_threads the number of I/O threads; 0 = the default: one per CPU available to the process, at most 8

    Each I/O thread runs its own event loop for its share of the sockets: every operation on one socket runs on
    the same I/O thread, so throughput scales with the number of threads for many concurrent connections, while
    each connection is handled as with a single I/O thread.

    By default the controller runs one I/O thread per CPU available to the process, at most 8: on Linux, the CPUs of
    its CPU affinity mask, and at most the CPU time its cgroup CPU quota allows (\c cpu.max, or
    \c cpu.cfs_quota_us and \c cpu.cfs_period_us with cgroup v1), as in a container started with a CPU limit; the
    \c QORE_IO_THREADS environment variable, read when the controller is created, sets another count.

    @throw ASYNC-IO-ERROR the controller is running; the thread count can only be changed while the controller is
    stopped, for example before its first operation is submitted
    @throw SANDBOX-REGISTRATION-ERROR code that is sandboxed or acts for sandboxed code cannot change the number of
    I/O threads, which is process-wide (see @ref sandbox_process_wide_registries)

    @since %Qore 3.0
*/
static nothing AsyncIoController::setMaxIoThreads(int max_threads = 0) [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    // the controller is process-wide: refused to sandboxed code (issue #6836)
    if (qore_check_process_wide_registration("change the number of I/O threads of the global async I/O controller",
            xsink)) {
        return QoreValue();
    }
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setMaxIoThreads((int)max_threads, xsink);
}

//! Hands work of the module cleanup that the current thread runs over to another thread
/** At the end of the process, the module cleanup waits for the work that it hands over to the asynchronous I/O
    controller (the onComplete() of an operation that it canceled, a stream notification, a task) before it deletes the
    modules and their Programs.  Code that hands such work over to a thread that is already running, which then does
    it (a non-blocking gate that leaves the work to the thread already processing a stream, for example), takes a
    handle with this method and gives it to that thread, which releases it with releaseModuleCleanupWork() once it has
    done the work: the cleanup waits for the handle as it waits for the work itself.

    Outside of work that the module cleanup counts (in particular before the end of the process), this method returns
    0 and has no effect, so a handle cannot make the cleanup wait for anything it would not wait for anyway.  A handle
    is waited for at most the grace period after the deadline of the cleanup (\c QORE_MODULE_CLEANUP_HANDOVER_GRACE,
    \c --module-cleanup-handover-grace; by default the deadline of the cleanup, but at least 5 seconds): then the
    cleanup writes a warning that names each handle still held (who took it and where), no longer waits for them, and
    leaves the modules and their Programs as they are, as the threads that hold the handles can still run in them.

    @return a handle to give to releaseModuleCleanupWork(), or 0 if the current thread does not run work that the
    module cleanup counts

    @par Example:
    @code{.py}
# in work of the module cleanup that leaves its job to the thread already running it
int h = AsyncIoController::holdModuleCleanupWork();
# ... the thread that does the job, once it has done it:
on_exit AsyncIoController::releaseModuleCleanupWork(h);
    @endcode

    @note Module code that hands work over between threads uses this; see @ref Qore::AsyncIoController::releaseModuleCleanupWork() "releaseModuleCleanupWork()"

    @since %Qore 3.0
*/
static int AsyncIoController::holdModuleCleanupWork() {
    // outside of work that the module cleanup counts (in particular before the end of the process): no handle, and
    // nothing is formatted, as gates call this method at run time for every notification that they leave to another
    // thread
    if (!qore_module_cleanup_counted_work_running()) {
        return 0;
    }
    std::string where;
    try {
        if (qore_module_cleanup_counted_owner && !qore_module_cleanup_counted_owner->empty()) {
            where = "owner '";
            where += *qore_module_cleanup_counted_owner;
            where += "'";
        } else {
            where = "a task or work handed over";
        }
        // the location of the code that called this method
        ReferenceHolder<QoreHashNode> loc(qore_get_parent_caller_location(0), xsink);
        QoreStringDataHelper file(loc ? loc->getKeyValue("file") : QoreValue());
        where += " at ";
        where += file ? file.c_str() : "<unknown>";
        if (loc) {
            char buf[32];
            snprintf(buf, sizeof buf, ":" QLLD, loc->getKeyValue("line").getAsBigInt());
            where += buf;
        }
    } catch (std::bad_alloc&) {
        // the handle is taken without its description
    }
    return qore_module_cleanup_hold_work(where);
}

//! Releases a handle of holdModuleCleanupWork()
/** Releasing a handle more than once, releasing 0, or releasing a handle that the module cleanup no longer waits for
    (once the grace period after its deadline has passed) has no effect.

    @param handle a handle of @ref Qore::AsyncIoController::holdModuleCleanupWork() "holdModuleCleanupWork()"

    @return @ref True if the handle was released by this call, @ref False if it was not held

    @since %Qore 3.0
*/
static bool AsyncIoController::releaseModuleCleanupWork(int handle) {
    return qore_module_cleanup_release_work(handle);
}

//! Runs code that work of the module cleanup handed over to the current thread, then releases its handle
/** While the code runs, the current thread runs work that the module cleanup counts (if the handle is held), so that
    the code can hand work over in turn (see
    @ref Qore::AsyncIoController::holdModuleCleanupWork() "holdModuleCleanupWork()"); the handle is released when the
    code returns, also if it raises an exception.  For a handle of 0 (taken outside of such work) or one that is not
    held, the code runs as usual.

    @param handle a handle of @ref Qore::AsyncIoController::holdModuleCleanupWork() "holdModuleCleanupWork()"
    @param c the code to run

    @par Example:
    @code{.py}
int h = AsyncIoController::holdModuleCleanupWork();
background AsyncIoController::runModuleCleanupWork(h, sub () { notifyListeners(); });
    @endcode

    @since %Qore 3.0
*/
static nothing AsyncIoController::runModuleCleanupWork(int handle, code<nothing()> c) {
    // released when the code has run, also if it raises an exception
    struct ReleaseHelper {
        int64 handle;
        DLLLOCAL ~ReleaseHelper() {
            qore_module_cleanup_release_work(handle);
        }
    } release_helper{handle};
    QoreModuleCleanupCountedWorkScope counted_scope(qore_module_cleanup_handle_held(handle), nullptr);
    c->execValue(nullptr, xsink).discard(xsink);
    return QoreValue();
}
