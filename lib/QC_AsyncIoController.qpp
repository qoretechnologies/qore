//! Cancels all operations for an owner on the global singleton
/** @param owner the owner identifier whose operations should be canceled
    @return the number of operations canceled
    @since %Qore 3.0
*/
static int AsyncIoController::cancelByOwner(string owner) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelByOwner(owner, xsink);
}

//! Wakes the I/O thread for a specific socket with pending data
/** Enqueues a targeted re-poll command for the given socket. The I/O thread
    includes that socket's operation in the next poll cycle regardless of
    EventLoop socket readiness, allowing queued send data to be transmitted.

    @param io_object the I/O object whose operation needs re-polling

    @since %Qore 3.0
*/
static nothing AsyncIoController::wakeSocket(AbstractPollableIoObjectBase[AbstractPollableIoObjectBase] io_object)
        [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    // Use QoreObject unique hash — the private data pointer
    // (AbstractPollableIoObjectBase*) can change during QUIC handshake when
    // the socket is reconfigured, causing hash mismatches with the cache key.
    // The QoreObject unique hash is stable across the connection lifecycle.
    ctrl->wakeSocketByObject(const_cast<QoreObject*>(obj_io_object), xsink);
}

//! Waits for all pending onComplete/abort callbacks to be processed
/** Call after cancelByOwner() to ensure all cancelled operation callbacks
    have been delivered before stopping thread pools that depend on them.

    This prevents shutdown deadlocks where a ThreadPool.stop() blocks
    waiting for handler threads that are waiting for onComplete() to
    signal their done counter.

    @since %Qore 3.0
*/
static nothing AsyncIoController::flushCallbacks() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->flushCallbacks();
}

//! Waits for in-flight callbacks tagged with the given owner to drain
/** Narrowed-scope companion to @ref flushCallbacks() that only waits for
    callbacks whose operations were submitted with the matching @a owner.
    Safe to call from a per-owner teardown path (e.g. a connection manager's
    destructor) where the global flush would deadlock on unrelated long-running
    work on the shared controller.

    Marks the owner as shutting down for the duration of the wait: any callback
    picked up by a worker while the mark is set is silently discarded instead
    of dispatched to user code.  The mark is cleared before return, so later
    submits by a new object reusing the owner string are unaffected.

    @param owner the owner identifier to wait for

    @since %Qore 3.0
*/
static nothing AsyncIoController::flushCallbacksByOwner(string owner) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->flushCallbacksByOwner(std::string(owner->c_str()));
}

//! Waits for the global singleton's I/O thread to be ready
/** @param timeout_ms timeout for waiting; use 0 to wait indefinitely
    @return @ref True "True" if the I/O thread is ready within the timeout
    @since %Qore 3.0
*/
static bool AsyncIoController::waitReady(*timeout timeout_ms) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->waitReady(timeout_ms, xsink);
}

//! Waits until the global singleton has processed all currently submitted operations
/** @param timeout_ms timeout for waiting; use 0 to wait indefinitely
    @return @ref True "True" if all submitted operations have been processed

    @throw ASYNC-IO-ERROR if called from an async I/O controller I/O thread

    @since %Qore 3.0
*/
static bool AsyncIoController::waitForProcessing(*timeout timeout_ms) [flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->waitForProcessing(timeout_ms, xsink);
}

