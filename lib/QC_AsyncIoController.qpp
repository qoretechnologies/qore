//! Adds a timer on the global singleton
/** When \a user_data is a closure or call-reference, the runtime automatically dispatches
    it to a worker thread in the async-I/O controller's dispatcher pool when the
    deadline fires — it is @b not invoked on the I/O thread, so it may block, acquire
    locks, or perform Qore-level I/O.

    For non-callable \a user_data (numbers, strings, hashes, …), the value is passed to
    the timer callback registered via @ref setTimerCallback() (also dispatched to a
    worker thread).  With no callback installed, non-callable \a user_data is silently
    dropped.

    @param deadline the absolute deadline for the timer
    @param user_data either a closure/call-reference to dispatch, or arbitrary user data
        to deliver through the @ref setTimerCallback() handler
    @return the unique timer ID
    @since %Qore 3.0
*/
static int AsyncIoController::addTimer(date deadline, auto user_data) [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimer(deadline, user_data, xsink);
}

//! Adds an owner-tagged timer on the global singleton
/** Identical to @ref addTimer(date, auto) but tags the timer's callback dispatch with \a owner, so a
    teardown path can deterministically drain a fired-but-not-yet-run callback via
    @ref flushCallbacksByOwner() (in addition to cancelling not-yet-fired timers with @ref cancelTimer()).
    This closes the teardown race where a timer fires, its callback is dispatched to a worker, and the
    owning object is destroyed before the callback runs.

    @param deadline the absolute deadline for the timer
    @param udata either a closure/call-reference to dispatch, or arbitrary user data
        to deliver through the @ref setTimerCallback() handler
    @param owner the owner identifier to tag the timer's callback dispatch with
    @return the unique timer ID
    @since %Qore 3.0
*/
static int AsyncIoController::addTimer(date deadline, auto udata, string owner) [dom=NETWORK,PROCESS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimer(deadline, udata, xsink, owner->c_str());
}

//! Cancels a timer on the global singleton
/** @param timer_id the timer ID returned by @ref addTimer()
    @return @ref True "True" if the timer was found and canceled
    @since %Qore 3.0
*/
static bool AsyncIoController::cancelTimer(int timer_id) [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelTimer(timer_id, xsink);
}

//! Sets the timer callback on the global singleton
/** The callback is invoked once per fire of a timer whose \c user_data is @b not a closure or
    call-reference (those are auto-dispatched directly; see @ref addTimer()).  The runtime
    dispatches the callback to a worker thread in the async-I/O controller's dispatcher
    pool — it is @b not invoked on the I/O thread.

    @param callback a callback that accepts a @ref TimerEventInfo hash argument, or
        @ref nothing to disable timer event delivery for non-callable \c user_data

    @since %Qore 3.0
*/
static nothing AsyncIoController::setTimerCallback(*code callback) [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setTimerCallback(callback ? callback->refRefSelf() : nullptr, xsink);
}

//! Submits a task to the global singleton's thread pool
/** @param task the @ref closure "closure" or @ref call_reference "call reference" to execute
    @param cancel_callback an optional @ref closure "closure" or @ref call_reference "call reference"
    to execute if the pool is stopped before the task can be executed

    @throw ASYNC-IO-ERROR if the controller's thread pool has been stopped

    @since %Qore 3.0
*/
static nothing AsyncIoController::submitTask(code<nothing()> task, *code<nothing()> cancel_callback)
        [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->submitTask(task->refRefSelf(), cancel_callback ? cancel_callback->refRefSelf() : nullptr, xsink);
}

//! Sets the maximum number of callback dispatcher worker threads on the global singleton
/** Controls the concurrency of user callback dispatch off the I/O thread.

    The default is @code{.py}hardware_concurrency() * 4@endcode, capped at 512 and falling
    back to 4 if the hardware thread count is unavailable.

    Takes effect when the dispatcher or submitTask() pool is next created.

    @param max_workers the maximum number of workers; 0 = auto (hardware_concurrency() * 4,
    capped at 512, fallback 4)

    @since %Qore 3.0
*/
static nothing AsyncIoController::setMaxCallbackWorkers(int max_workers = 0)
        [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setMaxCallbackWorkers((int)max_workers);
}

//! Sets the number of I/O threads for the global async I/O controller
/** @param max_threads the maximum number of I/O threads (0 = auto-detect from hardware_concurrency)

    Multiple I/O threads enable nginx-style per-thread connection isolation,
    scaling throughput near-linearly with core count for high connection counts.

    Must be called before the first submit() or from Qore startup code.

    @since %Qore 3.0
*/
static nothing AsyncIoController::setMaxIoThreads(int max_threads = 0) [dom=NETWORK,PROCESS;flags=NAMED_ARGS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setMaxIoThreads((int)max_threads, xsink);
}
