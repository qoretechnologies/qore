#include <qore/Qore.h>
#include <qore/QoreSocketObject.h>
#include "qore/intern/AsyncIoControllerPriv.h"
#include "qore/intern/QC_Socket.h"

extern qore_classid_t CID_QUEUE;
extern QoreClass* QC_QUEUE;

// Helper: get the singleton's priv data and QoreObject (both ref'd); caller must deref both
static AsyncIoControllerPriv* get_singleton(QoreObject*& obj, ExceptionSink* xsink) {
    obj = qore_get_async_io_controller_obj(xsink);
    if (!obj) {
        return nullptr;
    }
    AsyncIoControllerPriv* ctrl = static_cast<AsyncIoControllerPriv*>(
        obj->getReferencedPrivateData(CID_ASYNCIOCONTROLLER, xsink));
    if (!ctrl) {
        obj->deref(xsink);
        obj = nullptr;
        return nullptr;
    }
    return ctrl;
}

//! Socket polling operation info hash
/** Contains all the information needed to submit an async I/O operation

    @since %Qore 2.3
*/
hashdecl Qore::SocketPollOperationInfo {
    //! Socket object
    Socket sock;

    //! Poll operation
    AbstractPollOperation spop;

    //! Last poll info for this operation
    *hash<SocketPollInfo> poll_info;

    //! I/O timeout; use a negative value to disable timeout (operation will wait indefinitely)
    /** Default: 30 seconds
    */
    timeout to = 30s;

    //! Owner identifier for cancellation; required for proper cleanup during shutdown via cancelByOwner()
    string owner;

    //! Free-form data to be returned when the operation completes
    *hash<auto> other;

    //! Optional result Queue; if provided, results will be pushed to this Queue instead of a new one
    /** This allows multiple operations to share a single result Queue for easier coordination
    */
    *Queue resultQueue;

    //! Optional completion callback; called in the I/O thread when the operation completes
    /** When provided, results are delivered via callback instead of Queue.
        The callback signature must accept a single hash<SocketPollResultInfo> argument.
        Mutually exclusive with \c resultQueue.
    */
    *code callback;

    //! Optional custom cache key; default: sock.uniqueHash()
    /** Allows multiple concurrent operations on the same socket (e.g., concurrent accepts
        on a listener) by using distinct keys like "accept:<hash>:1", "accept:<hash>:2".
    */
    *string key;

    //! If True, the operation runs on its own dedicated I/O thread
    /** Useful for QUIC/HTTP/3 connections where the userspace protocol stack
        requires prompt packet processing and cannot share an I/O thread with
        other connections.

        Dedicated threads use a minimal stack (128KB) and call the C++ continuePoll()
        method directly. If the poll operation has a Qore-language override of
        continuePoll(), calls are dispatched to a shared Qore worker thread pool.

        @since %Qore 2.3
    */
    *bool dedicated_thread;
}

//! Socket poll result info hash
/** Contains the result of a completed async I/O operation

    @since %Qore 2.3
*/
hashdecl Qore::SocketPollResultInfo {
    //! The socket that completed the operation
    Socket sock;

    //! The poll operation that completed
    AbstractPollOperation spop;

    //! If the operation was canceled
    *bool canceled;

    //! Any exception raised while executing the operation
    *hash<ExceptionInfo> ex;

    //! Free-form data provided when the operation was submitted
    *hash<auto> other;
}

//! Async I/O controller for managing multiple concurrent socket poll operations
/** The AsyncIoController provides a high-performance event loop for managing multiple concurrent
    socket operations. It uses the most efficient I/O mechanism available on each platform
    (epoll on Linux, kqueue on macOS/BSD) via the EventLoop class.

    The controller runs a dedicated I/O thread that processes socket events and drives poll
    operations through their state machines. Operations are submitted via @ref submit(),
    and results are delivered via callback.

    The controller supports:
    - Multiple concurrent operations on different sockets
    - Multiple concurrent operations on the same socket (using custom keys)
    - Cancellation by socket, key, or owner
    - Autostop behavior (I/O thread exits when all operations complete)
    - Wake/force-poll for handling pending writes (HTTP/2)

    @par Thread Safety
    All public methods are thread-safe. The controller uses a single mutex with careful lock
    ordering to avoid deadlocks.

    @par Three-Phase I/O Cycle
    The I/O thread implements a deterministic three-phase polling cycle:
    - Phase 1 (Snapshot under lock): collect operations needing continuePoll()
    - Phase 2 (continuePoll outside lock): drive operations, collect results
    - Phase 3 (Update under lock + deferred delivery): update cache/EventLoop, deliver callbacks

    @note This class is not available with the @ref PO_NO_NETWORK parse option

    @since %Qore 2.3
*/
qclass AsyncIoController [dom=NETWORK; arg=AsyncIoControllerPriv* ctrl; ns=Qore];

//! Creates a new AsyncIoController
/** @par Example:
    @code{.py}
    auto ctrl = AsyncIoController::get();
    @endcode

    @param autostop if @ref True "True" (default), the I/O thread will automatically exit when
    all operations have completed; if @ref False "False", the I/O thread will keep running
    until explicitly stopped

    @throw ASYNCIOCONTROLLER-CONSTRUCTOR-ERROR cannot be instantiated directly; use
    static methods instead
*/
AsyncIoController::constructor(bool autostop = True) {
    xsink->raiseException("ASYNCIOCONTROLLER-CONSTRUCTOR-ERROR",
        "AsyncIoController cannot be instantiated; use static methods");
}

//! Destroys the AsyncIoController
/** The singleton is cleaned up during qore_cleanup(); this destructor handles the
    final dereference of the private data.
*/
AsyncIoController::destructor() {
    ctrl->deref(xsink);
}

//! Creates a copy of the AsyncIoController
/** @throw ASYNCIOCONTROLLER-COPY-ERROR AsyncIoController cannot be copied; use
    AsyncIoController::get() to obtain the singleton
*/
AsyncIoController::copy() {
    xsink->raiseException("ASYNCIOCONTROLLER-COPY-ERROR",
        "AsyncIoController cannot be copied; use AsyncIoController::get()");
}

//! Submits an async I/O operation to the global singleton
/** @par Example:
    @code{.py}
    Queue q = AsyncIoController::submit({"sock": sock, "spop": op, "owner": "server"});
    hash<SocketPollResultInfo> result = q.get();
    @endcode

    @param info the operation info hash
    @param replace if @ref True "True", cancel any existing operation with the same key

    @return a Queue object for receiving the result, or @ref nothing if a callback was provided
    in the info hash

    @throw ASYNC-IO-ERROR if the controller is shutting down or the info hash is invalid

    @since %Qore 2.3
*/
static *Queue AsyncIoController::submit(hash<SocketPollOperationInfo> info, *bool replace) {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->submit(obj, const_cast<QoreHashNode*>(info), replace, xsink);
}

//! Cancels an operation by socket on the global singleton
/** @param sock the socket whose operation should be canceled
    @return @ref True "True" if an operation was found and canceled
    @since %Qore 2.3
*/
static bool AsyncIoController::cancel(Socket[QoreSocketObject] sock) {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancel(*sock, xsink);
}

//! Cancels an operation by key on the global singleton
/** @param key the operation key to cancel
    @return @ref True "True" if an operation was found and canceled
    @since %Qore 2.3
*/
static bool AsyncIoController::cancelByKey(string key) {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelByKey(key, xsink);
}

//! Cancels all operations for an owner on the global singleton
/** @param owner the owner identifier whose operations should be canceled
    @return the number of operations canceled
    @since %Qore 2.3
*/
static int AsyncIoController::cancelByOwner(string owner) {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelByOwner(owner, xsink);
}

//! Wakes the global singleton's I/O thread to force re-poll on all operations
/** @since %Qore 2.3
*/
static nothing AsyncIoController::wake() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->wake();
}

//! Waits for the global singleton's I/O thread to be ready
/** @param to timeout for waiting; use 0 to wait indefinitely
    @return @ref True "True" if the I/O thread is ready within the timeout
    @since %Qore 2.3
*/
static bool AsyncIoController::waitReady(*timeout to) {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->waitReady(to, xsink);
}

//! Waits until the global singleton has processed all currently submitted operations
/** @param to timeout for waiting; use 0 to wait indefinitely
    @return @ref True "True" if all submitted operations have been processed
    @since %Qore 2.3
*/
static bool AsyncIoController::waitForProcessing(*timeout to) {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->waitForProcessing(to, xsink);
}

//! Returns true if the global singleton's I/O thread is running
/** @return @ref True "True" if the I/O thread is running
    @since %Qore 2.3
*/
static bool AsyncIoController::running() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->running();
}

//! Returns the number of cached operations on the global singleton
/** @return the number of active operations in the cache
    @since %Qore 2.3
*/
static int AsyncIoController::getCacheSize() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getCacheSize();
}

//! Sets the autostop flag on the global singleton
/** @param autostop if @ref True "True", the I/O thread will exit when all operations complete
    @since %Qore 2.3
*/
static nothing AsyncIoController::setAutostop(bool autostop = True) {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setAutostop(autostop);
}

//! Returns the autostop flag from the global singleton
/** @return @ref True "True" if autostop is enabled
    @since %Qore 2.3
*/
static bool AsyncIoController::getAutostop() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getAutostop();
}

//! Returns info about the global singleton's state
/** @return a hash with controller state information
    @since %Qore 2.3
*/
static hash<auto> AsyncIoController::getInfo() {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->getInfo(xsink);
}

//! Sets the logger on the global singleton
/** @param logger a @ref Qore::LoggerInterfaceBase "LoggerInterfaceBase" object for logging,
    or @ref nothing "NOTHING" to disable per-controller logging
    @since %Qore 2.3
*/
static nothing AsyncIoController::setLogger(*LoggerInterfaceBase logger) {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setLogger(const_cast<QoreObject*>(logger), xsink);
}

//! Adds a timer on the global singleton
/** @param deadline the absolute deadline for the timer
    @param udata user data to associate with the timer
    @return the unique timer ID
    @since %Qore 2.3
*/
static int AsyncIoController::addTimer(date deadline, auto udata) [dom=NETWORK,PROCESS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return 0;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->addTimer(deadline, udata, xsink);
}

//! Cancels a timer on the global singleton
/** @param timer_id the timer ID returned by @ref addTimer()
    @return @ref True "True" if the timer was found and canceled
    @since %Qore 2.3
*/
static bool AsyncIoController::cancelTimer(int timer_id) [dom=NETWORK,PROCESS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return false;
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    return ctrl->cancelTimer(timer_id, xsink);
}

//! Sets the timer callback on the global singleton
/** @param callback a callback that accepts a @ref TimerEventInfo hash argument, or @ref nothing
    to disable timer event delivery

    @note The callback is called in the I/O thread context. It should complete quickly to avoid
    blocking other I/O operations.

    @since %Qore 2.3
*/
static nothing AsyncIoController::setTimerCallback(*code callback) [dom=NETWORK,PROCESS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->setTimerCallback(callback ? callback->refRefSelf() : nullptr, xsink);
}

//! Submits a task to the global singleton's thread pool
/** @param task the @ref closure "closure" or @ref call_reference "call reference" to execute
    @param cancel an optional @ref closure "closure" or @ref call_reference "call reference"
    to execute if the pool is stopped before the task can be executed

    @throw ASYNC-IO-ERROR if the controller's thread pool has been stopped

    @since %Qore 2.3
*/
static nothing AsyncIoController::submitTask(code<nothing()> task, *code<nothing()> cancel) [dom=NETWORK,PROCESS] {
    QoreObject* obj;
    AsyncIoControllerPriv* ctrl = get_singleton(obj, xsink);
    if (!ctrl) {
        return QoreValue();
    }
    ReferenceHolder<AsyncIoControllerPriv> ctrl_holder(ctrl, xsink);
    ReferenceHolder<QoreObject> obj_holder(obj, xsink);
    ctrl->submitTask(task->refRefSelf(), cancel ? cancel->refRefSelf() : nullptr, xsink);
}
