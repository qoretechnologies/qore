#include <qore/Qore.h>

class LoggerInterfaceBaseDummy {};

//! Abstract base class for logger interfaces in the Qore core library
/** Defines the minimal logging contract needed by the core runtime for
    async I/O, QUIC, and HTTP/3 logging.

    The full @ref Qore::Logger::LoggerInterface "LoggerInterface" in the Logger module inherits from
    this class, but any user class implementing @ref logArgs() and @ref isEnabledFor() can also
    be used directly.

    @par Example:
    @code{.py}
class MyLogger inherits LoggerInterfaceBase {
    logArgs(int level, string message, *softlist<auto> args) {
        printf("LOG [%d]: %s\n", level, vsprintf(message, args));
    }
    bool isEnabledFor(int level) {
        return level >= LoggerLevel::getLevelInfo().getValue();
    }
}
    @endcode

    @since %Qore 2.3
*/
qclass LoggerInterfaceBase [arg=LoggerInterfaceBaseDummy* lib; ns=Qore];

//! Logs a message with an integer level and format arguments
/** @param level the integer log level
    @param message the log message format string
    @param args optional format arguments

    @since %Qore 2.3
*/
abstract nothing LoggerInterfaceBase::logArgs(int level, string message, *softlist<auto> args);

//! Returns @ref True "True" if logging is enabled for the given integer level
/** @param level the integer log level to check
    @return @ref True "True" if logging is enabled for the given level

    @since %Qore 2.3
*/
abstract bool LoggerInterfaceBase::isEnabledFor(int level);
