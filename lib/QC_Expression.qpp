#include <qore/Qore.h>
#include "qore/intern/QC_Expression.h"
#include "qore/intern/QC_Program.h"
#include "qore/intern/qore_program_private.h"

//! Expression objects represent a single executable expression
/**
    @since Qore 0.9.5
*/
qclass Expression [arg=QoreExpression* e];

//! Creates the expression object
/** @param pgm The @ref Qore::Program "Program" object where the expression will be created
    @param source The source to the expression
    @param label the label for the expression
 */
Expression::constructor(Program[QoreProgram] pgm, string source, string label) {
    ReferenceHolder<QoreExpression> exp(new QoreExpression(**pgm, *source, *label, xsink), xsink);
    if (!*xsink) {
        self->setPrivate(CID_EXPRESSION, exp.release());
    }
}

//! Evaluates the expression and returns any return value
/** @return The return value of the expression after evaluation
*/
auto Expression::eval() {
    return e->eval(xsink);
}
