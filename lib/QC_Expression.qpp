#include <qore/Qore.h>
#include "qore/intern/QC_Expression.h"
#include "qore/intern/QC_Program.h"
#include "qore/intern/qore_program_private.h"

//! Expression objects represent a single executable expression
/**
    @since Qore 0.9.5
*/
qclass Expression [arg=QoreExpression* e];

//! Creates the expression object
/** @param program The @ref Qore::Program "Program" object where the expression will be created
    @param source The source to the expression
    @param label the label for the expression

    @throw PARSE-EXCEPTION the source of the expression cannot be parsed; a parse directive at the start of a line
    (such as \c %%requires, \c %%define or a parse option) cannot be used in it (since %Qore 3.0)
    @throw EXPRESSION-ERROR the Program has code pending (@ref Qore::Program::parsePending() "Program::parsePending()"
    without @ref Qore::Program::parseCommit() "Program::parseCommit()" or
    @ref Qore::Program::parseRollback() "Program::parseRollback()"), or a parse of it was rolled back without
    @ref Qore::PO_ALLOW_REPARSE "PO_ALLOW_REPARSE"; the code must be committed or rolled back before an expression
    can be created in the Program (since %Qore 3.0)

    @note the expression adds no code to the Program and does not change its parse state: a parse directive in its
    source raises a parse exception and is not applied
 */
Expression::constructor(Program[QoreProgram] program, string source, string label) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreExpression> exp(new QoreExpression(**program, *source, *label, xsink), xsink);
    if (!*xsink) {
        self->setPrivate(CID_EXPRESSION, exp.release());
    }
}

//! Evaluates the expression and returns any return value
/** @return The return value of the expression after evaluation
*/
auto Expression::eval() {
    return e->eval(xsink);
}
