#include <qore/Qore.h>
#include "qore/intern/ql_websocket.h"
#include "qore/WebSocketFrameCodec.h"

/** @defgroup websocket_functions WebSocket Functions
    WebSocket frame encoding and data masking functions.

    These C++ builtins provide O(n) performance for WebSocket frame encoding
    and masking/unmasking, replacing the Qore-language implementations that
    had O(n\u00b2) byte-by-byte binary concatenation.
*/
///@{

//! Encodes a WebSocket frame with optional masking (C++ implementation)
/** @par Example:
    @code{.py}
binary frame = ws_encode_frame("hello", WSOP_Text, True);
    @endcode

    @param msg the message data (string or binary)
    @param op the WebSocket opcode (e.g., WSOP_Text, WSOP_Binary, WSOP_Close)
    @param masked if @ref True "True", applies random masking (required for client-to-server frames per RFC 6455)
    @param fin the FIN flag; @ref True "True" for the final (or only) fragment (default: @ref True "True")
    @param rsv_bits RSV extension bits using Qore WebSocket constants (e.g., \c WS_RSV1 = 0x40); default 0

    @return the encoded WebSocket frame as binary data

    @since %Qore 2.3
*/
binary ws_encode_frame(data msg, int op, softbool masked, softbool fin = True, int rsv_bits = 0) [flags=RET_VALUE_ONLY] {
    const void* payload = nullptr;
    size_t payload_len = 0;

    if (!msg.isNullOrNothing()) {
        switch (msg.getType()) {
            case NT_STRING: {
                const QoreStringNode* str = msg.get<const QoreStringNode>();
                payload = str->c_str();
                payload_len = str->size();
                break;
            }
            case NT_BINARY: {
                const BinaryNode* bin = msg.get<const BinaryNode>();
                payload = bin->getPtr();
                payload_len = bin->size();
                break;
            }
            default:
                break;
        }
    }

    // Convert Qore RSV bits (WS_RSV1=0x40, WS_RSV2=0x20, WS_RSV3=0x10) to
    // C++ rsv parameter (3-bit value: bit2=RSV1, bit1=RSV2, bit0=RSV3)
    uint8_t rsv = static_cast<uint8_t>((rsv_bits >> 4) & 0x07);

    return WebSocketFrameEncoder::encode(
        static_cast<WsOpcode>(op), payload, payload_len, (bool)fin, (bool)masked, rsv);
}

//! Applies or removes a WebSocket mask to/from binary data (XOR with 4-byte key)
/** This is an O(n) C++ implementation that replaces the O(n\u00b2) Qore byte-by-byte
    loop used for masking and unmasking WebSocket frame payloads.

    The same function works for both masking and unmasking since XOR is its own inverse.

    @par Example:
    @code{.py}
binary unmasked = ws_unmask_data(masked_payload, mask_key);
    @endcode

    @param data the binary data to mask or unmask
    @param mask the 4-byte masking key

    @return the masked/unmasked binary data

    @throw WEBSOCKET-ERROR if mask is not exactly 4 bytes

    @since %Qore 2.3
*/
binary ws_unmask_data(binary data, binary mask) [flags=RET_VALUE_ONLY] {
    if (mask->size() != 4) {
        xsink->raiseException("WEBSOCKET-ERROR",
            "mask must be exactly 4 bytes; got " QSD " bytes", mask->size());
        return QoreValue();
    }

    size_t len = data->size();
    if (!len) {
        return new BinaryNode();
    }

    const uint8_t* src = static_cast<const uint8_t*>(data->getPtr());
    const uint8_t* mask_key = static_cast<const uint8_t*>(mask->getPtr());

    SimpleRefHolder<BinaryNode> result(new BinaryNode());
    result->preallocate(len);

    uint8_t* dst = const_cast<uint8_t*>(static_cast<const uint8_t*>(result->getPtr()));

    // Process 4 bytes at a time for better throughput
    size_t i = 0;
    size_t aligned_len = len & ~static_cast<size_t>(3);
    for (; i < aligned_len; i += 4) {
        dst[i]     = src[i]     ^ mask_key[0];
        dst[i + 1] = src[i + 1] ^ mask_key[1];
        dst[i + 2] = src[i + 2] ^ mask_key[2];
        dst[i + 3] = src[i + 3] ^ mask_key[3];
    }
    // Handle remaining bytes
    for (; i < len; ++i) {
        dst[i] = src[i] ^ mask_key[i & 3];
    }

    result->setSize(len);
    return result.release();
}

///@}
