#include "qore/Qore.h"
#include "qore/intern/QC_Http1ClientPollOperationBase.h"
#include "qore/intern/QC_SocketPollOperation.h"
#include "qore/intern/QC_Socket.h"
#include "qore/intern/QC_Channel.h"
#include "qore/intern/QoreAsyncIoLogger.h"
#include "qore/intern/QoreEventNotifier.h"
#include "qore/intern/HttpClientEventSink.h"
#include "qore/intern/QoreHttpHeaderPairs.h"

// Forward declarations for QPP type references
extern QoreClass* QC_ABSTRACTHTTPPOLLCONNECTION;
extern QoreClass* QC_EVENTNOTIFIER;

/** @cond INTERNAL */

// Returns epoch time in microseconds
static inline int64 h1_epoch_us() {
    int us;
    int64 secs = q_epoch_us(us);
    return secs * 1000000LL + us;
}

// ============================================================
// Http1ClientPollOperationPriv implementation
// ============================================================

Http1ClientPollOperationPriv::Http1ClientPollOperationPriv(QoreObject* self,
        QoreSocketObject* sock, SocketPollOperationBase* connect_op,
        bool ssl_required, bool proxy_tunnel, bool is_proxy_plain,
        std::string target_host, int target_port,
        AbstractHttpPollConnectionPriv* conn_priv)
    : SocketPollOperationBase(self), current_op(connect_op), sock_obj(sock),
      ssl_required(ssl_required), proxy_tunnel(proxy_tunnel),
      is_proxy_plain(is_proxy_plain),
      target_host(std::move(target_host)), target_port(target_port),
      connection_priv(conn_priv) {
    // sock and connect_op are ref'd by the caller; ownership transferred
    // connection_priv is a raw (unrefed) pointer to the C++ priv data;
    // the strong QoreObject ref (for DGC cycle detection) is held in the
    // Qore-level connection_ref member (private, stored in the data hash)
}

Http1ClientPollOperationPriv::Http1ClientPollOperationPriv(QoreObject* self,
        QoreSocketObject* sock, bool ssl_required,
        std::string target_host, int target_port,
        AbstractHttpPollConnectionPriv* conn_priv)
    : SocketPollOperationBase(self), current_op(nullptr), sock_obj(sock),
      ssl_required(ssl_required), proxy_tunnel(false),
      is_proxy_plain(false),
      target_host(std::move(target_host)), target_port(target_port),
      connection_priv(conn_priv) {
    // Adopt-socket path: no connect op, socket already connected (and
    // TLS-handshook if ssl_required is true).  h1_state stays at its
    // default CONNECTING value; initAdoptedReady() transitions it to
    // READING and fires the ready callback once the owning connection
    // class has set self via setSelf().
}

void Http1ClientPollOperationPriv::initAdoptedReady(ExceptionSink* xsink) {
    // startReady() transitions h1_state CONNECTING -> READING, releases
    // current_op (no-op here since adopt path leaves it nullptr), and
    // invokes fireReadyCallback() which broadcasts the connection READY
    // state to the connection priv.  Safe to call from the app thread
    // before controller submission - the I/O thread will see READING
    // on its first continuePoll().
    startReady(xsink);
}

Http1ClientPollOperationPriv::~Http1ClientPollOperationPriv() {
    if (current_op || send_op || sock_obj || error_info) {
        ExceptionSink xsink;
        cleanup(&xsink);
    }
}

void Http1ClientPollOperationPriv::cleanup(ExceptionSink* xsink) {
    // Clean up single stream action - reject pending Promise so Future::get() doesn't hang
    {
        AutoLocker al(stream_lock);
        if (stream_action) {
            stream_action->executeError("HTTP1-ABORT",
                "poll operation cleaned up before response was received", xsink);
            stream_action->deref(xsink);
            stream_action = nullptr;
        }
        if (completed_channel_action) {
            completed_channel_action->deref(xsink);
            completed_channel_action = nullptr;
            completed_sid = 0;
        }
        active_stream_count = 0;
        if (pending_request_data) {
            pending_request_data->deref(xsink);
            pending_request_data = nullptr;
        }
        // Clean up streaming send queue
        for (auto* s : send_body_queue) {
            if (s) {
                s->deref(xsink);
            }
        }
        send_body_queue.clear();
        if (send_trailers) {
            send_trailers->deref(xsink);
            send_trailers = nullptr;
        }
    }

    if (error_info) {
        error_info->deref(xsink);
        error_info = nullptr;
    }
    if (response_headers) {
        response_headers->deref(xsink);
        response_headers = nullptr;
    }
    if (response_headers_raw) {
        response_headers_raw->deref(xsink);
        response_headers_raw = nullptr;
    }
    if (response_status_message) {
        response_status_message->deref();
        response_status_message = nullptr;
    }
    if (response_http_version) {
        response_http_version->deref();
        response_http_version = nullptr;
    }
    if (response_body) {
        response_body->deref(xsink);
        response_body = nullptr;
    }
    if (protocol_switched_listener) {
        protocol_switched_listener->deref(xsink);
        protocol_switched_listener = nullptr;
    }
    connection_priv = nullptr;  // raw pointer - Qore data member (connection_ref) holds the ref
    if (current_op) {
        current_op->deref(xsink);
        current_op = nullptr;
    }
    if (send_op) {
        send_op->deref(xsink);
        send_op = nullptr;
    }
    if (sock_obj) {
        sock_obj->deref(xsink);
        sock_obj = nullptr;
    }
}

const char* Http1ClientPollOperationPriv::getStateImpl() const {
    switch (h1_state.load(std::memory_order_acquire)) {
        case H1State::CONNECTING: return "connecting";
        case H1State::SSL_UPGRADE: return "ssl_upgrade";
        case H1State::PROXY_CONNECT_SEND: return "proxy_connect_send";
        case H1State::PROXY_CONNECT_RECV: return "proxy_connect_recv";
        case H1State::READING: return "reading";
        case H1State::WAIT_READ: return "wait_read";
        case H1State::PROTOCOL_SWITCHED: return "protocol_switched";
        case H1State::CLOSED: return "closed";
        default: return "unknown";
    }
}

QoreValue Http1ClientPollOperationPriv::getOutput() const {
    if (current_op) {
        return current_op->getOutput();
    }
    return QoreValue();
}

void Http1ClientPollOperationPriv::releaseCurrentOp(ExceptionSink* xsink) {
    if (current_op) {
        current_op->deref(xsink);
        current_op = nullptr;
    }
}

// --- continuePoll state machine (I/O thread) ---

QoreHashNode* Http1ClientPollOperationPriv::continuePoll(ExceptionSink* xsink) {
    {
        AutoLocker al(stream_lock);
        response_dispatched = false;
    }

    while (true) {
        H1State state = h1_state.load(std::memory_order_acquire);
        // The connect-phase budget is enforced here, on the I/O thread, so the
        // operation itself generates a diagnosable error before any caller-side
        // wait can expire; see setConnectTimeout().
        if (isConnectPhase(state) && checkConnectDeadline(xsink)) {
            return nullptr;
        }
        switch (state) {
            case H1State::CONNECTING:
                return clampConnectDeadline(handleConnecting(xsink), xsink);

            case H1State::SSL_UPGRADE:
                return clampConnectDeadline(handleSslUpgrade(xsink), xsink);

            case H1State::PROXY_CONNECT_SEND:
                return clampConnectDeadline(handleProxyConnectSend(xsink), xsink);

            case H1State::PROXY_CONNECT_RECV:
                return clampConnectDeadline(handleProxyConnectRecv(xsink), xsink);

            case H1State::READING:
                return handleReading(xsink);

            case H1State::WAIT_READ:
                h1_state.store(H1State::READING, std::memory_order_release);
                continue;

            case H1State::PROTOCOL_SWITCHED:
                return handleReading(xsink);

            case H1State::CLOSED: {
                // If an error caused the close, raise it so the controller
                // removes this op from its cache.  The pending stream was
                // already notified by setError() -> notifyPendingStreams().
                // For clean closes (Connection: close), just return nullptr -
                // the controller will keep the op but it's harmless since the
                // connection manager evicts it on next use.
                AutoLocker al(stream_lock);
                if (error_info) {
                    QoreValue err_v = error_info->getKeyValue("err");
                    QoreValue desc_v = error_info->getKeyValue("desc");
                    QoreStringValueHelper err_str(err_v);
                    QoreStringValueHelper desc_str(desc_v);
                    xsink->raiseException(
                        err_v.getType() == NT_STRING
                            ? err_str->c_str()
                            : "HTTP1-CLOSED",
                        desc_v.getType() == NT_STRING
                            ? new QoreStringNode(
                                *desc_str)
                            : new QoreStringNode("connection closed"));
                }
                return nullptr;
            }
        }
    }
}

QoreHashNode* Http1ClientPollOperationPriv::handleConnecting(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-CONNECT-ERROR", "connect operation not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        ASYNC_IO_TRACE("H1 handleConnecting: CONNECT ERROR: %s: %s target=%s:%d\n",
            *err_str ? err_str->c_str() : "?",
            *desc_str ? desc_str->c_str() : "?",
            target_host.c_str(), target_port);
        setError(*err_str ? err_str->c_str() : "HTTP1-CONNECT-ERROR",
            *desc_str ? desc_str->c_str() : "TCP connection failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ASYNC_IO_TRACE("H1 handleConnecting: TCP connected to %s:%d ssl=%d\n",
            target_host.c_str(), target_port, (int)ssl_required);
        if (proxy_tunnel) {
            startProxyConnect(xsink);
        } else if (ssl_required) {
            startSslUpgrade(xsink);
        } else {
            startReady(xsink);
        }
        if (*xsink) {
            return nullptr;
        }
        return continuePoll(xsink);
    }

    setError("HTTP1-CONNECT-ERROR", "TCP connection failed", xsink);
    return nullptr;
}

void Http1ClientPollOperationPriv::startProxyConnect(ExceptionSink* xsink) {
    // Build CONNECT request: "CONNECT host:port HTTP/1.1\r\nHost: host:port\r\n\r\n"
    QoreStringNode* connect_req = new QoreStringNode();
    connect_req->sprintf("CONNECT %s:%d HTTP/1.1\r\nHost: %s:%d\r\n\r\n",
        target_host.c_str(), target_port, target_host.c_str(), target_port);

    releaseCurrentOp(xsink);
    sock_obj->ref();
    // SocketSendPollOperation takes ownership of the string ref
    current_op = new SocketSendPollOperation(xsink, connect_req, sock_obj);
    if (*xsink) {
        // Must deref - the op was created but errored; it owns the sock ref
        current_op->deref(xsink);
        current_op = nullptr;
        return;
    }
    current_op->setSelf(*self);
    h1_state.store(H1State::PROXY_CONNECT_SEND, std::memory_order_release);
}

QoreHashNode* Http1ClientPollOperationPriv::handleProxyConnectSend(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-CONNECT-ERROR", "proxy CONNECT send not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        setError(*err_str ? err_str->c_str() : "HTTP1-CONNECT-ERROR",
            *desc_str ? desc_str->c_str() : "proxy CONNECT send failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        printd(5, "Http1ClientPollOperationPriv::handleProxyConnectSend() CONNECT sent, reading response\n");
        releaseCurrentOp(xsink);
        sock_obj->ref();
        current_op = new SocketReadHttpHeaderPollOperation(xsink, sock_obj);
        if (*xsink) {
            current_op->deref(xsink);
            current_op = nullptr;
            return nullptr;
        }
        current_op->setSelf(*self);
        h1_state.store(H1State::PROXY_CONNECT_RECV, std::memory_order_release);
        return handleProxyConnectRecv(xsink);
    }

    setError("HTTP1-CONNECT-ERROR", "proxy CONNECT send failed", xsink);
    return nullptr;
}

QoreHashNode* Http1ClientPollOperationPriv::handleProxyConnectRecv(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-CONNECT-ERROR", "proxy CONNECT recv not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        setError(*err_str ? err_str->c_str() : "HTTP1-CONNECT-ERROR",
            *desc_str ? desc_str->c_str() : "proxy CONNECT response read failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder output_val(current_op->getOutput(), xsink);
        if (output_val->getType() == NT_HASH) {
            QoreHashNode* output = output_val->get<QoreHashNode>();
            QoreValue hdr_val = output->getKeyValue("hdr");
            if (hdr_val.getType() == NT_HASH) {
                QoreHashNode* hdr = hdr_val.get<QoreHashNode>();
                int status = (int)hdr->getKeyValue("status_code").getAsBigInt();
                if (status < 200 || status >= 300) {
                    SimpleRefHolder<QoreStringNode> desc(new QoreStringNode());
                    QoreValue msg_val = hdr->getKeyValue("status_message");
                    QoreStringValueHelper msg_str(msg_val);
                    const char* msg = msg_val.getType() == NT_STRING
                        ? msg_str->c_str() : "unknown";
                    desc->sprintf("proxy CONNECT failed with HTTP %d: %s", status, msg);
                    setError("HTTP1-CONNECT-ERROR", desc->c_str(), xsink);
                    return nullptr;
                }
            }
        }
        printd(5, "Http1ClientPollOperationPriv::handleProxyConnectRecv() tunnel established\n");
        startSslUpgrade(xsink);
        if (*xsink) {
            return nullptr;
        }
        return continuePoll(xsink);
    }

    setError("HTTP1-CONNECT-ERROR", "proxy CONNECT response read failed", xsink);
    return nullptr;
}

void Http1ClientPollOperationPriv::startSslUpgrade(ExceptionSink* xsink) {
    printd(5, "Http1ClientPollOperationPriv::startSslUpgrade()\n");
    releaseCurrentOp(xsink);
    sock_obj->ref();
    current_op = new SocketUpgradeClientSslPollOperation(xsink, sock_obj);
    if (*xsink) {
        current_op->deref(xsink);
        current_op = nullptr;
        return;
    }
    current_op->setSelf(*self);
    h1_state.store(H1State::SSL_UPGRADE, std::memory_order_release);
}

QoreHashNode* Http1ClientPollOperationPriv::handleSslUpgrade(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-SSL-ERROR", "SSL operation not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        setError(*err_str ? err_str->c_str() : "HTTP1-SSL-ERROR",
            *desc_str ? desc_str->c_str() : "SSL upgrade failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder output_val(current_op->getOutput(), xsink);
        if (*xsink) {
            return nullptr;
        }
        std::string alpn_id;
        if (output_val->getType() == NT_HASH) {
            QoreHashNode* output = output_val->get<QoreHashNode>();
            QoreValue proto_val = output->getKeyValue("negotiated_protocol");
            // note: the protocol id is held in inline short string storage (ex: "h2"), which has
            // no QoreStringNode, so the data helper must be used to read the bytes
            if (proto_val.getType() == NT_STRING) {
                alpn_id = QoreStringDataHelper(proto_val).c_str();
            }
        }
        {
            AutoLocker al(stream_lock);
            negotiated_protocol = std::move(alpn_id);
        }

        // No ALPN check for HTTP/1.1 - it is the default protocol
        printd(5, "Http1ClientPollOperationPriv::handleSslUpgrade() SSL done\n");
        startReady(xsink);
        if (*xsink) {
            return nullptr;
        }
        return continuePoll(xsink);
    }

    setError("HTTP1-SSL-ERROR", "SSL upgrade failed", xsink);
    return nullptr;
}

void Http1ClientPollOperationPriv::startReady(ExceptionSink* xsink) {
    printd(5, "Http1ClientPollOperationPriv::startReady()\n");
    releaseCurrentOp(xsink);
    // the connect phase is over; the request budget governs from here on
    connect_deadline_us = 0;
    h1_state.store(H1State::READING, std::memory_order_release);
    req_state = ReqState::IDLE;
    fireReadyCallback(xsink);
}

// --- Main reading/processing state handler ---

QoreHashNode* Http1ClientPollOperationPriv::handleReading(ExceptionSink* xsink) {
    ASYNC_IO_TRACE("H1 handleReading: req_state=%d send_state=%d fd=%d\n", (int)req_state,
        (int)send_state, sock_obj ? sock_obj->getSocket() : -1);
    // Full-duplex streaming send: drive the chunked request body send side
    // concurrently with the response-receive machine (req_state is a RECV_*
    // state here), so the server can reply while the request body is still
    // open (the DataStream / RemoteSqlSession read-your-writes pattern).
    if (send_state != SendState::INACTIVE) {
        return handleFullDuplex(xsink);
    }
    return dispatchReqState(xsink);
}

QoreHashNode* Http1ClientPollOperationPriv::dispatchReqState(ExceptionSink* xsink) {
    switch (req_state) {
        case ReqState::IDLE:
            return handleIdle(xsink);
        case ReqState::SENDING:
            return handleSending(xsink);
        case ReqState::RECV_HEADER:
            return handleRecvHeader(xsink);
        case ReqState::RECV_BODY_LENGTH:
            return handleRecvBodyLength(xsink);
        case ReqState::RECV_CHUNK_SIZE:
            return handleRecvChunkSize(xsink);
        case ReqState::RECV_CHUNK_DATA:
            return handleRecvChunkData(xsink);
        case ReqState::RECV_CHUNK_CRLF:
            return handleRecvChunkCrlf(xsink);
        case ReqState::RECV_BODY_CLOSE:
            return handleRecvBodyClose(xsink);
        case ReqState::AWAIT_SEND:
            return awaitBufferedSend(xsink);
        case ReqState::PROTOCOL_SWITCHED:
            return handleProtocolSwitched(xsink);
    }
    setError("HTTP1-INTERNAL-ERROR", "unknown request sub-state", xsink);
    return nullptr;
}

// --- Full-duplex streaming (concurrent chunked request-body send + response
//     receive on one socket, driven on the I/O thread) ---

QoreHashNode* Http1ClientPollOperationPriv::startBufferedFullDuplex(ExceptionSink* xsink) {
    assert(current_op);
    assert(!send_op);

    // Create the response read first: if it fails, the request send operation is still on current_op and
    // req_state is still SENDING, so the state machine is left exactly as it was found.
    sock_obj->ref();
    SocketPollOperationBase* read_op = new SocketReadHttpHeaderPollOperation(xsink, sock_obj);
    if (*xsink) {
        read_op->deref(xsink);
        return nullptr;
    }
    read_op->setSelf(*self);

    // Hand the partially-written request over to the concurrent send side.  The operation already holds the
    // whole remainder of the request, so unlike a chunked streaming send there is no queue behind it: when it
    // reaches its goal the request body is complete.
    send_op = current_op;
    current_op = read_op;
    send_state = SendState::SENDING;
    send_buffered_body = true;
    send_final_pending = false;
    req_state = ReqState::RECV_HEADER;

    ASYNC_IO_TRACE("H1 handleSending: request headers sent, buffered body still going -> full-duplex "
        "(RECV_HEADER + concurrent send) fd=%d\n", sock_obj ? sock_obj->getSocket() : -1);
    printd(5, "Http1ClientPollOperationPriv::startBufferedFullDuplex() headers sent, reading the response "
        "while the buffered request body is still being sent\n");
    return handleFullDuplex(xsink);
}

QoreHashNode* Http1ClientPollOperationPriv::handleFullDuplex(ExceptionSink* xsink) {
    // The response is already complete and only the rest of the buffered request body is left; there is
    // nothing to receive, so drive the send side alone until it finishes and the response can be delivered.
    if (req_state == ReqState::AWAIT_SEND) {
        return awaitBufferedSend(xsink);
    }

    // 1) Make progress on the response-receive side first.  The RECV_* handlers drive current_op and, on
    //    response completion, reset the response state and tear down the send side (dispatchStreamingEnd /
    //    dispatchResponse -> resetSendState), returning either the idle poll info or nullptr (close).
    //
    //    Receive before send: a peer that answers early - a 413 or another fault raised before it has drained
    //    the request body - very often stops reading or closes right after writing its response, which makes
    //    the next request-body write fail with EPIPE or ECONNRESET.  Draining the response first means the
    //    caller gets the peer's actual answer instead of the write error that answer caused.
    QoreHashNode* recv_info = dispatchReqState(xsink);
    if (!recv_info) {
        // Response completed with a connection close, or an error was raised.
        return nullptr;
    }
    ReferenceHolder<QoreHashNode> info(recv_info, xsink);

    // The response completed and resetSendState() put the send side back to INACTIVE; any unsent request
    // bytes were abandoned there, and dispatchResponse() / dispatchStreamingEnd() forced the connection
    // closed so it cannot be reused with a half-written request on it.  AWAIT_SEND means the opposite: the
    // response is complete and waiting, and awaitBufferedSend() has already driven the send side this cycle.
    if (send_state == SendState::INACTIVE || req_state == ReqState::AWAIT_SEND) {
        return info.release();
    }

    // 2) Make progress on the request-body send side.
    int send_events = driveSendSide(xsink);
    if (send_events < 0) {
        // Error already surfaced (setError() closed the connection, or the
        // send-op constructor left an exception on xsink); the pending stream
        // is notified via setError()->notifyPendingStreams() / controller abort.
        return nullptr;
    }

    // 3) If the request body is still mid-send (partial write), fold its desired POLLOUT into the receive poll
    //    info so the controller wakes us for either direction.
    if (send_events && send_state != SendState::INACTIVE) {
        int64_t ev = info->getKeyValue("events").getAsBigInt();
        info->setKeyValue("events", ev | send_events, xsink);
    }
    return info.release();
}

int Http1ClientPollOperationPriv::driveSendSide(ExceptionSink* xsink) {
    while (true) {
        // Poll an in-flight send op (a request-body chunk or the final terminator)
        if (send_op) {
            ExceptionSink poll_xsink;
            QoreHashNode* poll_info = send_op->continuePoll(&poll_xsink);
            if (poll_xsink) {
                QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
                QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
                setError(*err_str ? err_str->c_str() : "HTTP1-SEND-ERROR",
                    *desc_str ? desc_str->c_str() : "streaming request-body send failed", xsink);
                poll_xsink.clear();
                return -1;
            }
            if (poll_info) {
                // Partial send: keep send_op and report the events it still wants
                // (typically SOCK_POLLOUT) so the controller wakes us to finish.
                int events = (int)poll_info->getKeyValue("events").getAsBigInt();
                poll_info->deref(xsink);
                return events;
            }
            if (!send_op->goalReached()) {
                setError("HTTP1-SEND-ERROR", "streaming request-body chunk send failed", xsink);
                return -1;
            }
            // Chunk fully sent
            releaseSendOp(xsink);
            if (send_buffered_body) {
                // the operation carried the whole rest of the request, so the request body is complete
                send_state = SendState::DONE;
                ASYNC_IO_TRACE("H1 driveSendSide: buffered request body sent, request done fd=%d\n",
                    sock_obj ? sock_obj->getSocket() : -1);
            } else if (send_final_pending) {
                send_final_pending = false;
                send_state = SendState::DONE;
                ASYNC_IO_TRACE("H1 driveSendSide: final chunk sent, request body done fd=%d\n",
                    sock_obj ? sock_obj->getSocket() : -1);
            }
        }

        if (send_state == SendState::DONE) {
            return 0;
        }

        // A buffered request body is a single send operation with no queue behind it, so losing the operation
        // before it reached its goal would silently truncate the request on the wire
        if (send_buffered_body) {
            assert(false);
            setError("HTTP1-INTERNAL-ERROR",
                "the buffered request body lost its send operation before the request was complete", xsink);
            return -1;
        }

        // Pull the next queued request-body chunk (nullptr = end-of-body sentinel)
        QoreStringNode* chunk = nullptr;
        bool have_data = false;
        {
            AutoLocker al(stream_lock);
            if (!send_body_queue.empty()) {
                chunk = send_body_queue.front();
                send_body_queue.pop_front();
                have_data = true;
            }
        }

        if (!have_data) {
            // Nothing queued yet — wait for pushSendData() + wakeSocket().
            send_state = SendState::IDLE;
            return 0;
        }

        if (!chunk) {
            // End-of-body sentinel: send the final "0\r\n" terminator plus any
            // trailers, then "\r\n".
            SimpleRefHolder<BinaryNode> final_chunk(new BinaryNode());
            final_chunk->append("0\r\n", 3);
            QoreHashNode* trailers = nullptr;
            {
                AutoLocker al(stream_lock);
                trailers = send_trailers;
                send_trailers = nullptr;
            }
            if (trailers) {
                ConstHashIterator hi(trailers);
                while (hi.next()) {
                    QoreStringValueHelper sv(hi.get());
                    QoreString trailer_line;
                    trailer_line.sprintf("%s: %s\r\n", hi.getKey(), sv->c_str());
                    final_chunk->append(trailer_line.c_str(), trailer_line.size());
                }
                trailers->deref(xsink);
            }
            final_chunk->append("\r\n", 2);
            ASYNC_IO_TRACE("H1 driveSendSide: sending final chunk fd=%d\n",
                sock_obj ? sock_obj->getSocket() : -1);
            sock_obj->ref();
            send_op = new SocketSendPollOperation(xsink, final_chunk.release(), sock_obj);
            if (*xsink) {
                send_op->deref(xsink);
                send_op = nullptr;
                return -1;
            }
            send_op->setSelf(*self);
            send_state = SendState::SENDING;
            send_final_pending = true;
            continue;  // loop to poll the new send op
        }

        // Normal chunk: HTTP/1.1 chunked TE frame "<hexsize>\r\n<data>\r\n"
        ASYNC_IO_TRACE("H1 driveSendSide: sending chunk (%lu bytes) fd=%d\n",
            (unsigned long)chunk->size(), sock_obj ? sock_obj->getSocket() : -1);
        SimpleRefHolder<BinaryNode> chunk_data(new BinaryNode());
        QoreString size_line;
        size_line.sprintf("%lx\r\n", (unsigned long)chunk->size());
        chunk_data->append(size_line.c_str(), size_line.size());
        chunk_data->append(chunk->c_str(), chunk->size());
        chunk_data->append("\r\n", 2);
        chunk->deref(xsink);

        sock_obj->ref();
        send_op = new SocketSendPollOperation(xsink, chunk_data.release(), sock_obj);
        if (*xsink) {
            send_op->deref(xsink);
            send_op = nullptr;
            return -1;
        }
        send_op->setSelf(*self);
        send_state = SendState::SENDING;
        continue;  // loop to poll the new send op
    }
}

QoreHashNode* Http1ClientPollOperationPriv::awaitBufferedSend(ExceptionSink* xsink) {
    assert(send_buffered_body);
    if (send_op) {
        ExceptionSink poll_xsink;
        QoreHashNode* poll_info = send_op->continuePoll(&poll_xsink);
        if (poll_xsink) {
            // The peer answered and then stopped reading: it closed its read side or reset the connection,
            // so the rest of the request can never be delivered.  The response in hand is complete and
            // authoritative, so that is what the caller gets rather than the write error it caused.
            ASYNC_IO_TRACE("H1 awaitBufferedSend: peer refused the rest of the request body after "
                "responding - delivering the response fd=%d\n", sock_obj ? sock_obj->getSocket() : -1);
            poll_xsink.clear();
            return abandonBufferedSendAndDeliver(xsink);
        }
        if (poll_info) {
            // Partial write: wait for the socket to become writable again.  There is nothing to receive -
            // the response is complete - so the send interest is the whole poll interest here.
            ReferenceHolder<QoreHashNode> info(poll_info, xsink);
            int events = (int)info->getKeyValue("events").getAsBigInt();
            return getSocketPollInfoHash(xsink, events ? events : SOCK_POLLOUT);
        }
        if (!send_op->goalReached()) {
            return abandonBufferedSendAndDeliver(xsink);
        }
        releaseSendOp(xsink);
        send_state = SendState::DONE;
        ASYNC_IO_TRACE("H1 awaitBufferedSend: buffered request body complete, delivering the response "
            "fd=%d\n", sock_obj ? sock_obj->getSocket() : -1);
    }
    return completeDeferredResponse(xsink);
}

QoreHashNode* Http1ClientPollOperationPriv::abandonBufferedSendAndDeliver(ExceptionSink* xsink) {
    releaseSendOp(xsink);
    // send_state stays at SENDING so the dispatch below forces the connection closed; clearing
    // send_buffered_body is what stops the dispatch from deferring this response a second time
    send_buffered_body = false;
    return completeDeferredResponse(xsink);
}

QoreHashNode* Http1ClientPollOperationPriv::completeDeferredResponse(ExceptionSink* xsink) {
    bool streaming_end = deferred_streaming_end;
    deferred_streaming_end = false;
    return streaming_end ? dispatchStreamingEnd(xsink) : dispatchResponse(xsink);
}

void Http1ClientPollOperationPriv::releaseSendOp(ExceptionSink* xsink) {
    if (send_op) {
        send_op->deref(xsink);
        send_op = nullptr;
    }
}

void Http1ClientPollOperationPriv::resetSendState(ExceptionSink* xsink) {
    releaseSendOp(xsink);
    send_state = SendState::INACTIVE;
    send_final_pending = false;
    send_buffered_body = false;
    AutoLocker al(stream_lock);
    for (auto* s : send_body_queue) {
        if (s) {
            s->deref(xsink);
        }
    }
    send_body_queue.clear();
    if (send_trailers) {
        send_trailers->deref(xsink);
        send_trailers = nullptr;
    }
}

// --- Request sub-state handlers ---

QoreHashNode* Http1ClientPollOperationPriv::handleIdle(ExceptionSink* xsink) {
    // Check for pending request under stream_lock
    BinaryNode* req_data = nullptr;
    bool is_streaming = false;
    bool is_streaming_send = false;
    size_t header_len = 0;
    {
        AutoLocker al(stream_lock);
        req_data = pending_request_data;
        pending_request_data = nullptr;
        header_len = pending_request_header_len;
        pending_request_header_len = 0;
        is_streaming = streaming_active;
        is_streaming_send = streaming_send;
        if (req_data) {
            // Claim the send direction here, under the same lock that holds
            // the pending request.  cancelStream() reads req_state to decide
            // whether the exchange has reached the wire; leaving it IDLE until
            // after the send starts lets a concurrent cancel take the "nothing
            // sent yet" branch and drop the stream action while this thread
            // goes on to put the request on the wire anyway — the peer then
            // sees a request the caller has already abandoned, with no EOF and
            // nobody reading the response.
            req_state = ReqState::SENDING;
        }
    }

    if (req_data) {
        // Processing a request - reset the idle deadline so the next idle
        // period starts fresh after the response completes.
        idle_deadline_us = 0;

        // Before sending on a keep-alive connection, do a non-blocking recv to
        // detect server-initiated close (EOF).  This avoids sending a request on
        // a stale connection and waiting for a response that will never arrive.
        // Use the async-poll idle-data helper, which is TLS-aware: for TLS connections it uses SSL_peek
        // to drain TLS post-handshake records (e.g., TLS 1.3 NewSessionTicket) instead
        // of raw recv(MSG_PEEK) which would see the TLS record header byte (0x17) and
        // never be able to consume it, causing a busy-loop.
        int fd = sock_obj->getSocket();
        if (fd >= 0) {
            ExceptionSink idle_xsink;
            int idle_rc = sock_obj->checkIdleDataForAsyncPoll(&idle_xsink);
            if (idle_rc < 0 || idle_xsink) {
                // EOF or SSL error - preserve the underlying error category
                // (e.g. SOCKET-SSL-ERROR when the TLS handshake or an
                // in-flight TLS record surfaced a validation failure).  The
                // previous code always reported HTTP1-CONNECTION-CLOSED,
                // swallowing the SSL error class - callers expecting the
                // typed SOCKET-SSL-ERROR (HTTPClient self-signed cert test)
                // saw only the generic "server closed" message.
                ASYNC_IO_TRACE("H1 handleIdle: checkIdleData rc=%d before send, server closed fd=%d\n",
                    idle_rc, fd);
                {
                    AutoLocker al(stream_lock);
                    pending_request_data = req_data;
                    pending_request_header_len = header_len;
                    streaming_active = is_streaming;
                }
                if (idle_xsink) {
                    QoreStringValueHelper err_str(idle_xsink.getExceptionErr());
                    QoreStringValueHelper desc_str(idle_xsink.getExceptionDesc());
                    std::string err = *err_str ? err_str->c_str()
                        : "HTTP1-CONNECTION-CLOSED";
                    std::string desc = *desc_str ? desc_str->c_str()
                        : "server closed the keep-alive connection";
                    idle_xsink.clear();
                    setError(err.c_str(), desc.c_str(), xsink);
                } else {
                    setError("HTTP1-CONNECTION-CLOSED",
                        "server closed the keep-alive connection", xsink);
                }
                return nullptr;
            }
            if (idle_rc > 0) {
                // Unexpected application data from server before we sent a request - the
                // connection is dirty (partial response from a prior cycle or protocol
                // violation).  Put the request back and close so the caller retries on
                // a fresh connection.
                ASYNC_IO_TRACE("H1 handleIdle: unexpected server data before send, closing fd=%d\n", fd);
                {
                    AutoLocker al(stream_lock);
                    pending_request_data = req_data;
                    pending_request_header_len = header_len;
                    streaming_active = is_streaming;
                }
                sock_obj->closeIo(xsink);
                setError("HTTP1-UNEXPECTED-DATA",
                    "server sent unexpected data on idle keep-alive connection before request", xsink);
                return nullptr;
            }
            // idle_rc == 0: no application data (TLS records drained if any), connection alive
            ASYNC_IO_TRACE("H1 handleIdle: checkIdleData ok (no data), proceeding with send fd=%d\n", fd);
        }

        // Connection is alive - start sending the request
        ASYNC_IO_TRACE("H1 handleIdle: start send (%lu bytes) fd=%d streaming_send=%d\n",
            (unsigned long)req_data->size(), sock_obj ? sock_obj->getSocket() : -1,
            (int)is_streaming_send);
        releaseCurrentOp(xsink);
        sock_obj->ref();
        streaming_active_io = is_streaming;
        streaming_send_io = is_streaming_send;
        request_header_len = header_len;
        interim_response_count = 0;
        current_op = new SocketSendPollOperation(xsink, req_data, sock_obj);
        if (*xsink) {
            current_op->deref(xsink);
            current_op = nullptr;
            // the send never started: give the claim on the send direction
            // back, so no later poll cycle dispatches to handleSending()
            // without an operation to drive
            AutoLocker al(stream_lock);
            req_state = ReqState::IDLE;
            return nullptr;
        }
        current_op->setSelf(*self);
        // req_state was already set to SENDING when the request was taken
        // from pending_request_data above
        return handleSending(xsink);
    }

    // No pending request - wait for wake or socket events.
    // If the event loop fires POLLIN on an idle connection (server FIN),
    // continuePoll() will be called and we'll reach this point again with
    // no pending request.  Use the async-poll idle-data helper, which is TLS-aware.
    int fd = sock_obj->getSocket();
    if (fd >= 0) {
        ExceptionSink idle_xsink;
        int idle_rc = sock_obj->checkIdleDataForAsyncPoll(&idle_xsink);
        if (idle_rc < 0 || idle_xsink) {
            ASYNC_IO_TRACE("H1 handleIdle: checkIdleData rc=%d, closing fd=%d (no pending req)\n",
                idle_rc, fd);
            sock_obj->closeIo(xsink);
            if (idle_xsink) {
                QoreStringValueHelper err_str(idle_xsink.getExceptionErr());
                QoreStringValueHelper desc_str(idle_xsink.getExceptionDesc());
                std::string err = *err_str ? err_str->c_str()
                    : "HTTP1-CONNECTION-CLOSED";
                std::string desc = *desc_str ? desc_str->c_str()
                    : "server closed the connection";
                idle_xsink.clear();
                setError(err.c_str(), desc.c_str(), xsink);
            } else {
                setError("HTTP1-CONNECTION-CLOSED",
                    "server closed the connection", xsink);
            }
            return nullptr;
        }
        if (idle_rc > 0) {
            // Unexpected application-layer data on an idle connection - close it.
            ASYNC_IO_TRACE("H1 handleIdle: unexpected app data on idle conn, closing fd=%d\n", fd);
            sock_obj->closeIo(xsink);
            setError("HTTP1-UNEXPECTED-DATA",
                "server sent unexpected data on idle keep-alive connection", xsink);
            return nullptr;
        }
        // idle_rc == 0: no application data (TLS post-handshake record drained if any)
        ASYNC_IO_TRACE("H1 handleIdle: no pending req, checkIdleData ok (no data) fd=%d\n", fd);
    }

    // Proactive idle timeout check (nginx-style upstream keepalive_timeout).
    // On subsequent entries (after a previous handleIdle or dispatchResponse
    // has armed the deadline), close the connection if the deadline has
    // elapsed.  Defense-in-depth for peers that never close idle connections.
    if (idle_timeout_us > 0 && idle_deadline_us > 0 && h1_epoch_us() >= idle_deadline_us) {
        ASYNC_IO_TRACE("H1 handleIdle: IDLE-TIMEOUT deadline reached fd=%d\n", fd);
        sock_obj->closeIo(xsink);
        setError("HTTP1-IDLE-TIMEOUT",
            "closing idle HTTP/1.1 connection after idle_timeout expired", xsink);
        return nullptr;
    }

    h1_state.store(H1State::WAIT_READ, std::memory_order_release);
    // armIdleDeadline arms idle_deadline_us (if not already armed) and
    // annotates poll_info with poll_timeout_ms so the controller wakes us
    // at the deadline.
    return armIdleDeadline(getSocketPollInfoHash(xsink, SOCK_POLLIN), xsink);
}

int Http1ClientPollOperationPriv::checkConnectDeadline(ExceptionSink* xsink) {
    if (connect_timeout_us <= 0) {
        return 0;
    }
    int64_t now_us = q_get_monotonic_us();
    if (!connect_deadline_us) {
        connect_deadline_us = now_us + connect_timeout_us;
        ASYNC_IO_TRACE("H1 checkConnectDeadline: arming now+%lldus target=%s:%d\n",
            (long long)connect_timeout_us, target_host.c_str(), target_port);
        return 0;
    }
    if (now_us < connect_deadline_us) {
        return 0;
    }
    ASYNC_IO_TRACE("H1 checkConnectDeadline: EXPIRED target=%s:%d\n",
        target_host.c_str(), target_port);
    QoreString desc;
    if (target_port) {
        desc.sprintf("connection to %s:%d was not established within the connect timeout (%lld ms)",
            target_host.c_str(), target_port, (long long)(connect_timeout_us / 1000));
    } else {
        desc.sprintf("connection to UNIX domain socket %s was not established within the connect timeout "
            "(%lld ms)", target_host.c_str(), (long long)(connect_timeout_us / 1000));
    }
    setError("HTTP1-CONNECT-TIMEOUT", desc.c_str(), xsink);
    return -1;
}

QoreHashNode* Http1ClientPollOperationPriv::clampConnectDeadline(QoreHashNode* poll_info,
        ExceptionSink* xsink) {
    if (!poll_info || connect_deadline_us <= 0
        || !isConnectPhase(h1_state.load(std::memory_order_acquire))) {
        return poll_info;
    }
    int64_t now_us = q_get_monotonic_us();
    int64_t remaining_ms = now_us >= connect_deadline_us
        ? 0
        : (connect_deadline_us - now_us + 999) / 1000;
    QoreValue ptv = poll_info->getKeyValue("poll_timeout_ms");
    if (ptv.getType() == NT_INT) {
        int64_t current_ms = ptv.getAsBigInt();
        // < 0 means "no bound", so it always loses to the connect deadline
        if (current_ms >= 0 && current_ms <= remaining_ms) {
            return poll_info;
        }
    }
    poll_info->setKeyValue("poll_timeout_ms", remaining_ms, xsink);
    return poll_info;
}

QoreHashNode* Http1ClientPollOperationPriv::armIdleDeadline(QoreHashNode* poll_info,
        ExceptionSink* xsink) {
    if (idle_timeout_us <= 0 || !poll_info) {
        return poll_info;
    }
    int64_t now_us = h1_epoch_us();
    if (idle_deadline_us == 0) {
        idle_deadline_us = now_us + idle_timeout_us;
        ASYNC_IO_TRACE("H1 armIdleDeadline: arming now+%lldus fd=%d\n",
            (long long)idle_timeout_us, sock_obj ? sock_obj->getSocket() : -1);
    }
    int64_t remaining_us = idle_deadline_us - now_us;
    int64_t timeout_ms = (remaining_us + 999) / 1000;
    if (timeout_ms < 1) {
        timeout_ms = 1;
    }
    poll_info->setKeyValue("poll_timeout_ms", timeout_ms, xsink);
    return poll_info;
}

QoreHashNode* Http1ClientPollOperationPriv::handleSending(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-SEND-ERROR", "send operation not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        setError(*err_str ? err_str->c_str() : "HTTP1-SEND-ERROR",
            *desc_str ? desc_str->c_str() : "send failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        // The socket would not take the whole request.  If the header block has nonetheless reached the wire,
        // the peer can already be answering, so hand the rest of the request over to the concurrent send side
        // and start reading the response now.  Waiting for the upload to finish first deadlocks against any
        // peer that writes a response bigger than the socket buffers before it drains the request body.
        if (!streaming_send_io && send_state == SendState::INACTIVE && req_state == ReqState::SENDING
                && request_header_len) {
            // in ReqState::SENDING with no concurrent send active, current_op is the request send operation
            // created by handleIdle()
            assert(dynamic_cast<SocketSendPollOperation*>(current_op));
            if (static_cast<SocketSendPollOperation*>(current_op)->getBytesSent() >= request_header_len) {
                poll_info->deref(xsink);
                return startBufferedFullDuplex(xsink);
            }
        }
        return poll_info;
    }

    if (current_op->goalReached()) {
        // Streaming send: the request headers (Transfer-Encoding: chunked) have
        // been written.  Restore full-duplex chunked streaming — start reading
        // the response concurrently with sending the chunked request body, so a
        // server can reply while the request body is still open (the DataStream
        // / RemoteSqlSession read-your-writes pattern).  req_state now tracks
        // only the response-receive direction; the request body send side runs
        // on send_op driven by driveSendSide() (see handleFullDuplex()).
        if (streaming_send_io && req_state == ReqState::SENDING) {
            printd(5, "Http1ClientPollOperationPriv::handleSending() headers sent, "
                "entering full-duplex streaming\n");
            releaseCurrentOp(xsink);
            sock_obj->ref();
            current_op = new SocketReadHttpHeaderPollOperation(xsink, sock_obj);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            req_state = ReqState::RECV_HEADER;
            send_state = SendState::IDLE;
            send_final_pending = false;
            ASYNC_IO_TRACE("H1 handleSending: headers sent -> full-duplex "
                "(RECV_HEADER + concurrent send) fd=%d\n",
                sock_obj ? sock_obj->getSocket() : -1);
            return handleFullDuplex(xsink);
        }

        printd(5, "Http1ClientPollOperationPriv::handleSending() request sent, reading response header\n");

        // Stale keep-alive detection (curl Curl_retry_request pattern):
        // On a REUSED connection (not the first request), check for EOF
        // immediately after sending.  Use the async-poll idle-data helper
        // instead of a raw recv(MSG_PEEK), so TLS post-handshake records are
        // processed consistently with the pre-send idle checks above.
        if (next_stream_id > 1) {
            int fd = sock_obj->getSocket();
            if (fd >= 0) {
                ExceptionSink idle_xsink;
                int idle_rc = sock_obj->checkIdleDataForAsyncPoll(&idle_xsink);
                if (idle_rc < 0 || idle_xsink) {
                    // EOF or socket/TLS error before the response header.
                    ASYNC_IO_TRACE("H1 handleSending: stale connection detected "
                        "(checkIdleData rc=%d) fd=%d stream=%d\n", idle_rc, fd, next_stream_id);
                    if (idle_xsink) {
                        // note: these values can be held in inline short string storage, which
                        // has no QoreStringNode, so the data helper must be used
                        QoreStringDataHelper err_str(idle_xsink.getExceptionErr());
                        QoreStringDataHelper desc_str(idle_xsink.getExceptionDesc());
                        std::string err = err_str ? err_str.c_str()
                            : "HTTP1-CONNECTION-CLOSED";
                        std::string desc = desc_str ? desc_str.c_str()
                            : "server closed the keep-alive connection";
                        idle_xsink.clear();
                        setError(err.c_str(), desc.c_str(), xsink);
                    } else {
                        setError("HTTP1-CONNECTION-CLOSED",
                            "server closed the keep-alive connection", xsink);
                    }
                    return nullptr;
                }
                // idle_rc > 0: early response data is possible; read it below.
                // idle_rc == 0: no data yet, connection alive.
            }
        }

        releaseCurrentOp(xsink);
        sock_obj->ref();
        current_op = new SocketReadHttpHeaderPollOperation(xsink, sock_obj);
        if (*xsink) {
            current_op->deref(xsink);
            current_op = nullptr;
            return nullptr;
        }
        current_op->setSelf(*self);
        req_state = ReqState::RECV_HEADER;
        return handleRecvHeader(xsink);
    }

    setError("HTTP1-SEND-ERROR", "send failed", xsink);
    return nullptr;
}

void Http1ClientPollOperationPriv::pushSendData(const QoreStringNode* data, ExceptionSink* xsink) {
    AutoLocker al(stream_lock);
    if (data) {
        send_body_queue.push_back(data->stringRefSelf());
    } else {
        // End sentinel
        send_body_queue.push_back(nullptr);
    }
}

void Http1ClientPollOperationPriv::setTrailers(const QoreHashNode* trailers, ExceptionSink* xsink) {
    AutoLocker al(stream_lock);
    if (send_trailers) {
        send_trailers->deref(xsink);
    }
    send_trailers = trailers ? trailers->hashRefSelf() : nullptr;
}

HttpClientEventSink* Http1ClientPollOperationPriv::getReferencedEventSink() const {
    AutoLocker al(stream_lock);
    if (!stream_action) {
        return nullptr;
    }
    HttpClientEventSink* sink = stream_action->getEventSink();
    if (sink) {
        sink->ref();
    }
    return sink;
}

QoreHashNode* Http1ClientPollOperationPriv::handleRecvHeader(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-RECV-ERROR", "header read not initialized", xsink);
        return nullptr;
    }

    // Stale keep-alive detection on reused connections is performed once
    // at the SEND→RECV_HEADER transition in handleSending() via MSG_PEEK
    // for FIN.  Once we are in RECV_HEADER, any later remote close arrives
    // as an EOF on the underlying recv path
    // (SocketReadHttpHeaderPollOperation), so an additional time-based
    // fallback here would only mistake slow-server response latency for a
    // dead connection — the application's request_timeout covers the
    // half-open ("server alive at TCP, silent at HTTP") case, and the
    // conn-mgr's HTTPCLIENT-TIMEOUT retry rule
    // (HttpClientConnectionManager.qc isConnectionErrorStatic) is the
    // curl Curl_retry_request analog that picks up the recovery.

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    ASYNC_IO_TRACE("H1 handleRecvHeader: poll_info=%p xsink=%d fd=%d\n",
        poll_info, (int)(bool)poll_xsink, sock_obj ? sock_obj->getSocket() : -1);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        ASYNC_IO_TRACE("H1 handleRecvHeader: ERROR %s: %s\n",
            *err_str ? err_str->c_str() : "?", *desc_str ? desc_str->c_str() : "?");
        // Normalize connection-close errors to SOCKET-CLOSED for
        // compatibility with the legacy sync path, which gets EOF on read
        // when the remote closes.
        const char* err_code = *err_str ? err_str->c_str() : "HTTP1-RECV-ERROR";
        if (*err_str && *desc_str) {
            if ((!strcmp(err_str->c_str(), "SOCKET-RECV-ERROR")
                        && strstr(desc_str->c_str(), "Connection reset by peer"))
                    || (!strcmp(err_str->c_str(), "SOCKET-HTTP-ERROR")
                        && strstr(desc_str->c_str(), "remote end closed connection"))) {
                err_code = "SOCKET-CLOSED";
            }
        }
        setError(err_code,
            *desc_str ? desc_str->c_str() : "header read failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder output_val(current_op->getOutput(), xsink);
        if (output_val->getType() != NT_HASH) {
            setError("HTTP1-RECV-ERROR", "header read returned non-hash output", xsink);
            return nullptr;
        }

        QoreHashNode* output = output_val->get<QoreHashNode>();
        QoreValue hdr_val = output->getKeyValue("hdr");
        if (hdr_val.getType() != NT_HASH) {
            setError("HTTP1-RECV-ERROR", "header read returned no 'hdr' hash", xsink);
            return nullptr;
        }

        QoreHashNode* hdr = hdr_val.get<QoreHashNode>();
        response_status_code = (int)hdr->getKeyValue("status_code").getAsBigInt();

        // Capture status message and HTTP version for conn_mgr response format
        if (response_status_message) {
            response_status_message->deref();
            response_status_message = nullptr;
        }
        QoreValue sm_val = hdr->getKeyValue("status_message");
        if (sm_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper sm_str(sm_val);
            response_status_message = sm_str.getReferencedValue();
        }
        if (response_http_version) {
            response_http_version->deref();
            response_http_version = nullptr;
        }
        QoreValue hv_val = hdr->getKeyValue("http_version");
        if (hv_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper hv_str(hv_val);
            response_http_version = hv_str.getReferencedValue();
        }

        // Build response headers hash with lowercase keys
        if (response_headers) {
            response_headers->deref(xsink);
        }
        response_headers = new QoreHashNode(autoTypeInfo);
        if (response_headers_raw) {
            response_headers_raw->deref(xsink);
        }
        response_headers_raw = nullptr;

        ConstHashIterator hi(hdr);
        while (hi.next()) {
            const char* key = hi.getKey();
            // Skip status line pseudo-keys
            if (!strcmp(key, "status_code") || !strcmp(key, "status_message")
                    || !strcmp(key, "http_version")) {
                continue;
            }
            // Convert key to lowercase
            QoreStringNode* lc_key = new QoreStringNode(key);
            lc_key->tolwr();
            response_headers->setKeyValue(lc_key->c_str(), hi.get().refSelf(), xsink);
            lc_key->deref();
        }

        // Extract original-case headers from the info hash produced by
        // processHttpHeaderString -> convertHeaderToHash
        QoreValue info_val = output->getKeyValue("info");
        if (info_val.getType() == NT_HASH) {
            QoreValue raw_val = info_val.get<const QoreHashNode>()->getKeyValue("headers-raw");
            if (raw_val.getType() == NT_HASH) {
                response_headers_raw = raw_val.get<QoreHashNode>()->hashRefSelf();
            }
        }

        // Determine body transfer type
        response_chunked = false;
        response_content_length = -1;
        connection_close = false;
        if (response_body) {
            response_body->deref(xsink);
            response_body = nullptr;
        }

        // Check transfer-encoding - handles both string and list (duplicate headers)
        QoreValue te_val = response_headers->getKeyValue("transfer-encoding");
        if (te_val.getType() == NT_STRING) {
            QoreStringValueHelper te_str(te_val);
            if (strcasestr(te_str->c_str(), "chunked")) {
                response_chunked = true;
            }
        } else if (te_val.getType() == NT_LIST) {
            // Duplicate Transfer-Encoding headers (e.g., CDN adds its own on top of origin's)
            // are stored as a list; scan each element for "chunked"
            ConstListIterator li(te_val.get<const QoreListNode>());
            while (li.next()) {
                QoreValue item = li.getValue();
                if (item.getType() == NT_STRING) {
                    QoreStringValueHelper item_str(item);
                    if (!strcasestr(item_str->c_str(), "chunked")) {
                        continue;
                    }
                    response_chunked = true;
                    break;
                }
            }
        }

        // Check content-length
        if (!response_chunked) {
            QoreValue cl_val = response_headers->getKeyValue("content-length");
            if (!cl_val.isNullOrNothing()) {
                if (cl_val.getType() == NT_STRING) {
                    QoreStringValueHelper cl_str(cl_val);
                    response_content_length = atoll(cl_str->c_str());
                } else {
                    response_content_length = cl_val.getAsBigInt();
                }
            }
        }

        // RFC 9112 section 9.3: HTTP/1.0 is persistent only with keep-alive;
        // a close connection option takes precedence for either version.
        bool keep_alive = false;
        auto inspect_connection = [&](const QoreStringNode& value) -> int {
            const char* start = value.c_str();
            const char* end = start + value.size();
            while (start < end) {
                if (qore_check_cancel(xsink, "HTTP connection options")) {
                    return -1;
                }
                const char* comma = static_cast<const char*>(memchr(start, ',', end - start));
                const char* token_end = comma ? comma : end;
                while (start < token_end && (*start == ' ' || *start == '\t')) {
                    if (qore_check_cancel(xsink, "HTTP connection options")) {
                        return -1;
                    }
                    ++start;
                }
                while (token_end > start && (token_end[-1] == ' ' || token_end[-1] == '\t')) {
                    if (qore_check_cancel(xsink, "HTTP connection options")) {
                        return -1;
                    }
                    --token_end;
                }
                size_t length = token_end - start;
                if (length == 5 && !strncasecmp(start, "close", 5)) {
                    connection_close = true;
                } else if (length == 10 && !strncasecmp(start, "keep-alive", 10)) {
                    keep_alive = true;
                }
                start = comma ? comma + 1 : end;
            }
            return 0;
        };
        QoreValue conn_val = response_headers->getKeyValue("connection");
        if (conn_val.getType() == NT_STRING) {
            if (inspect_connection(*conn_val.get<const QoreStringNode>())) {
                return nullptr;
            }
        } else if (conn_val.getType() == NT_LIST) {
            ConstListIterator li(conn_val.get<const QoreListNode>());
            while (li.next()) {
                if (qore_check_cancel(xsink, "HTTP connection options")) {
                    return nullptr;
                }
                QoreValue item = li.getValue();
                if (item.getType() == NT_STRING && inspect_connection(*item.get<const QoreStringNode>())) {
                    return nullptr;
                }
            }
        }
        if (response_http_version && !strcmp(response_http_version->c_str(), "1.0") && !keep_alive) {
            connection_close = true;
        }

        printd(5, "Http1ClientPollOperationPriv::handleRecvHeader() status=%d chunked=%d "
            "content_length=%lld close=%d streaming=%d\n",
            response_status_code, (int)response_chunked,
            (long long)response_content_length, (int)connection_close,
            (int)streaming_active_io);
        ASYNC_IO_TRACE("H1 handleRecvHeader: status=%d chunked=%d content_length=%lld close=%d fd=%d\n",
            response_status_code, (int)response_chunked,
            (long long)response_content_length, (int)connection_close,
            sock_obj ? sock_obj->getSocket() : -1);

        // Report the response header events on the event queue of the client that issued the
        // request.  Reported here, where the header is parsed, and not when the response is
        // complete: a client that monitors the response must see the header while the body is
        // still being read.
        {
            ReferenceHolder<HttpClientEventSink> sink(getReferencedEventSink(), xsink);
            if (sink) {
                sink->responseHeaders(*hdr);
            }
        }

        // Determine if the response has a body
        // HEAD responses, 1xx, 204, and 304 have no body regardless of headers
        std::string method;
        {
            AutoLocker al(stream_lock);
            method = active_method;
        }

        // 101 Switching Protocols: the HTTP framing layer is done;
        // the socket transitions to raw bidirectional I/O (e.g., WebSocket).
        if (response_status_code == 101) {
            if (streaming_active_io) {
                // Deliver the 101 response headers to the Channel so the
                // stream handle caller can validate the upgrade.
                dispatchStreamingHeaders(xsink);
                if (*xsink) {
                    return nullptr;
                }
            } else {
                // Non-streaming: dispatch as a normal response with no body
                return dispatchResponse(xsink);
            }
            // Enter PROTOCOL_SWITCHED state - continuePoll() will now
            // use separate send/recv ops for full-duplex raw I/O.
            protocol_switched = true;
            req_state = ReqState::PROTOCOL_SWITCHED;
            h1_state.store(H1State::PROTOCOL_SWITCHED, std::memory_order_release);
            ASYNC_IO_TRACE("H1 handleRecvHeader: 101 -> PROTOCOL_SWITCHED\n");
            releaseCurrentOp(xsink);
            return handleProtocolSwitched(xsink);
        }

        // 100 Continue: RFC 9110 section 15.2.1 defines it as the server's promise to send a final response
        // once the request body has been received, so it is never itself an answer - the client discards it
        // and goes on reading.  This is not theoretical here: a peer answering a large request body early
        // answers "100 Continue" first whenever the request carried "Expect: 100-continue" (HttpServer.qm
        // does exactly that), and since startBufferedFullDuplex() reads the response while the body is still
        // going out, that interim response now arrives mid-upload.  Treating it as the answer would leave
        // the real response unread on the connection, where the next request finds it and closes the
        // connection with HTTP1-UNEXPECTED-DATA.
        //
        // Only 100 is consumed: 101 ends HTTP framing and is handled above, and the remaining 1xx codes keep
        // the behavior a handler returning one relies on (see the 102 case in HttpServer.qtest's issue3116),
        // since nothing forces a final response to follow those.
        if (response_status_code == 100) {
            if (++interim_response_count > MAX_INTERIM_RESPONSES) {
                // setError() takes a literal description, not a format string
                QoreString desc;
                desc.sprintf("server sent more than the maximum of %d \"100 Continue\" responses without "
                    "sending a final response", MAX_INTERIM_RESPONSES);
                setError("HTTP1-RECV-ERROR", desc.c_str(), xsink);
                return nullptr;
            }
            ASYNC_IO_TRACE("H1 handleRecvHeader: 100 Continue (%d of max %d), reading the next header "
                "fd=%d\n", interim_response_count, MAX_INTERIM_RESPONSES,
                sock_obj ? sock_obj->getSocket() : -1);
            releaseCurrentOp(xsink);
            sock_obj->ref();
            current_op = new SocketReadHttpHeaderPollOperation(xsink, sock_obj);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            // req_state stays RECV_HEADER; the interim response's parsed values are overwritten by the next
            // header block
            return handleRecvHeader(xsink);
        }

        bool no_body = (method == "HEAD")
            || (response_status_code >= 100 && response_status_code < 200)
            || response_status_code == 204
            || response_status_code == 304;

        if (no_body) {
            if (streaming_active_io) {
                // Deliver the header frame before end_stream so the channel
                // consumer sees status_code; otherwise 204/304/HEAD/1xx
                // streaming responses raise "no response received".
                dispatchStreamingHeaders(xsink);
                if (*xsink) {
                    return nullptr;
                }
                return dispatchStreamingEnd(xsink);
            }
            return dispatchResponse(xsink);
        }

        // For streaming mode: dispatch headers-only callback before reading body
        if (streaming_active_io) {
            dispatchStreamingHeaders(xsink);
            if (*xsink) {
                return nullptr;
            }
        }

        // Start body reading based on transfer type
        if (response_chunked) {
            if (!streaming_active_io) {
                response_body = new BinaryNode();
            }
            releaseCurrentOp(xsink);
            sock_obj->ref();
            SimpleRefHolder<QoreStringNode> pattern(new QoreStringNode("\r\n"));
            current_op = new SocketRecvUntilBytesPollOperation(xsink, *pattern, sock_obj, true);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            req_state = ReqState::RECV_CHUNK_SIZE;
            return handleRecvChunkSize(xsink);
        } else if (response_content_length > 0) {
            releaseCurrentOp(xsink);
            if (streaming_active_io) {
                // Read in chunks for incremental delivery
                streaming_body_remaining = response_content_length;
                ssize_t read_size = streaming_body_remaining < (int64_t)STREAMING_CHUNK_SIZE
                    ? (ssize_t)streaming_body_remaining : (ssize_t)STREAMING_CHUNK_SIZE;
                sock_obj->ref();
                current_op = new SocketRecvPollOperation(xsink, read_size, sock_obj, false);
            } else {
                // the body is read whole, so its declared size is checked before any of it is allocated
                if (checkResponseBodySize(response_content_length, "declared by Content-Length", xsink)) {
                    return nullptr;
                }
                sock_obj->ref();
                current_op = new SocketRecvPollOperation(xsink, (ssize_t)response_content_length,
                    sock_obj, false);
            }
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            req_state = ReqState::RECV_BODY_LENGTH;
            return handleRecvBodyLength(xsink);
        } else if (response_content_length == 0) {
            // Explicit zero-length body
            if (streaming_active_io) {
                // See 204/HEAD note above - channel consumer needs status_code
                // before end_stream or it raises "no response received".
                dispatchStreamingHeaders(xsink);
                if (*xsink) {
                    return nullptr;
                }
                return dispatchStreamingEnd(xsink);
            }
            return dispatchResponse(xsink);
        } else if (connection_close) {
            // No Content-Length, not chunked, but Connection: close - read until EOF
            if (!streaming_active_io) {
                response_body = new BinaryNode();
            }
            releaseCurrentOp(xsink);
            sock_obj->ref();
            current_op = new SocketRecvDataPollOperation(xsink, sock_obj, false);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            req_state = ReqState::RECV_BODY_CLOSE;
            QoreHashNode* rv = handleRecvBodyClose(xsink);
            if (rv && streaming_active_io) {
                // The header readiness event has been consumed, and the first
                // SSE body bytes can arrive while the controller is switching
                // this H1 operation from header parsing to close-delimited body
                // reads.  Queue one explicit self-wake after the body-read poll
                // info is installed so the handoff is checked once without
                // falling back to periodic polling.
                wakeIoThread(xsink);
            }
            return rv;
        } else if (streaming_active_io) {
            // No Content-Length, not chunked, not Connection: close, but streaming -
            // treat as read-until-close (SSE servers, etc.)
            connection_close = true;
            releaseCurrentOp(xsink);
            sock_obj->ref();
            current_op = new SocketRecvDataPollOperation(xsink, sock_obj, false);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            req_state = ReqState::RECV_BODY_CLOSE;
            QoreHashNode* rv = handleRecvBodyClose(xsink);
            if (rv) {
                // See the connection_close branch above.
                wakeIoThread(xsink);
            }
            return rv;
        } else {
            // No Content-Length, not chunked, not Connection: close - treat as no body
            return dispatchResponse(xsink);
        }
    }

    setError("HTTP1-RECV-ERROR", "header read failed", xsink);
    return nullptr;
}

QoreHashNode* Http1ClientPollOperationPriv::handleRecvBodyLength(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-RECV-ERROR", "body read not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        setError(*err_str ? err_str->c_str() : "HTTP1-RECV-ERROR",
            *desc_str ? desc_str->c_str() : "body read failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder data_val(current_op->getOutput(), xsink);
        if (streaming_active_io) {
            // Dispatch chunk and check for more
            const BinaryNode* data = data_val->getType() == NT_BINARY
                ? data_val->get<const BinaryNode>() : nullptr;
            if (data) {
                dispatchStreamingData(data, xsink);
                streaming_body_remaining -= data->size();
            }
            if (streaming_body_remaining <= 0) {
                return dispatchStreamingEnd(xsink);
            }
            ssize_t read_size = streaming_body_remaining < (int64_t)STREAMING_CHUNK_SIZE
                ? (ssize_t)streaming_body_remaining : (ssize_t)STREAMING_CHUNK_SIZE;
            releaseCurrentOp(xsink);
            sock_obj->ref();
            current_op = new SocketRecvPollOperation(xsink, read_size, sock_obj, false);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            return handleRecvBodyLength(xsink);
        }

        // Non-streaming: store full body
        if (data_val->getType() == NT_BINARY) {
            if (response_body) {
                response_body->deref(xsink);
            }
            response_body = data_val.release().get<BinaryNode>();
        }
        return dispatchResponse(xsink);
    }

    setError("HTTP1-RECV-ERROR", "body read failed", xsink);
    return nullptr;
}

QoreHashNode* Http1ClientPollOperationPriv::handleRecvChunkSize(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-RECV-ERROR", "chunk size read not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        setError(*err_str ? err_str->c_str() : "HTTP1-RECV-ERROR",
            *desc_str ? desc_str->c_str() : "chunk size read failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder line_val(current_op->getOutput(), xsink);
        if (line_val->getType() != NT_STRING) {
            setError("HTTP1-RECV-ERROR", "chunk size read returned non-string", xsink);
            return nullptr;
        }

        QoreStringValueHelper line(*line_val);
        const char* str = line->c_str();
        size_t len = line->size();

        // Remove trailing \r\n
        if (len >= 2) {
            len -= 2;
        }

        // Find semicolon (chunk extensions)
        const char* semi = (const char*)memchr(str, ';', len);
        size_t hex_len = semi ? (size_t)(semi - str) : len;

        // Parse the hexadecimal chunk size (RFC 9112 section 7.1); whitespace around it is tolerated, but a line
        // without hexadecimal digits, with other characters, or with a size that overflows is a protocol error
        size_t i = 0;
        while (i < hex_len && (str[i] == ' ' || str[i] == '\t')) {
            ++i;
        }
        size_t digits = 0;
        int64_t chunk_size = 0;
        for (; i < hex_len; ++i, ++digits) {
            char c = str[i];
            int64_t v;
            if (c >= '0' && c <= '9') {
                v = c - '0';
            } else if (c >= 'a' && c <= 'f') {
                v = c - 'a' + 10;
            } else if (c >= 'A' && c <= 'F') {
                v = c - 'A' + 10;
            } else {
                break;
            }
            // the chunk is read with its trailing CRLF, so the size plus 2 must not overflow
            if (chunk_size > ((INT64_MAX - 2) >> 4)) {
                setError("HTTP1-RECV-ERROR", "chunk size overflow", xsink);
                return nullptr;
            }
            chunk_size = (chunk_size << 4) | v;
        }
        while (i < hex_len && (str[i] == ' ' || str[i] == '\t')) {
            ++i;
        }
        if (!digits || i != hex_len) {
            QoreStringMaker desc("invalid chunk size line: %s", QoreString(str, len).c_str());
            setError("HTTP1-RECV-ERROR", desc.c_str(), xsink);
            return nullptr;
        }

        printd(5, "Http1ClientPollOperationPriv::handleRecvChunkSize() chunk_size=%lld\n",
            (long long)chunk_size);

        {
            ReferenceHolder<HttpClientEventSink> sink(getReferencedEventSink(), xsink);
            if (sink) {
                sink->chunkSize((size_t)chunk_size, len);
            }
        }

        if (chunk_size == 0) {
            // Last chunk - read trailing CRLF (or trailers followed by CRLF)
            releaseCurrentOp(xsink);
            sock_obj->ref();
            SimpleRefHolder<QoreStringNode> pattern(new QoreStringNode("\r\n"));
            current_op = new SocketRecvUntilBytesPollOperation(xsink, *pattern, sock_obj, true);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            req_state = ReqState::RECV_CHUNK_CRLF;
            return handleRecvChunkCrlf(xsink);
        }

        // a chunk of a body that is read whole is checked before it is allocated
        if (!streaming_active_io && checkResponseBodySize((response_body ? (int64_t)response_body->size() : 0)
                + chunk_size, "received with chunked transfer encoding", xsink)) {
            return nullptr;
        }

        // Read chunk data + trailing CRLF (chunk_size + 2 bytes)
        releaseCurrentOp(xsink);
        sock_obj->ref();
        current_op = new SocketRecvPollOperation(xsink, (ssize_t)(chunk_size + 2), sock_obj, false);
        if (*xsink) {
            current_op->deref(xsink);
            current_op = nullptr;
            return nullptr;
        }
        current_op->setSelf(*self);
        req_state = ReqState::RECV_CHUNK_DATA;
        return handleRecvChunkData(xsink);
    }

    setError("HTTP1-RECV-ERROR", "chunk size read failed", xsink);
    return nullptr;
}

QoreHashNode* Http1ClientPollOperationPriv::handleRecvChunkData(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-RECV-ERROR", "chunk data read not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        setError(*err_str ? err_str->c_str() : "HTTP1-RECV-ERROR",
            *desc_str ? desc_str->c_str() : "chunk data read failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder data_val(current_op->getOutput(), xsink);
        if (data_val->getType() == NT_BINARY) {
            const BinaryNode* data = data_val->get<const BinaryNode>();
            // Remove trailing CRLF (last 2 bytes)
            if (data->size() > 2) {
                SimpleRefHolder<BinaryNode> chunk(new BinaryNode());
                chunk->append(data->getPtr(), data->size() - 2);
                {
                    ReferenceHolder<HttpClientEventSink> sink(getReferencedEventSink(), xsink);
                    if (sink) {
                        sink->chunkedDataRead(chunk->getPtr(), chunk->size());
                        sink->chunkedDataReceived(chunk->size(), data->size());
                    }
                }
                if (streaming_active_io) {
                    dispatchStreamingData(*chunk, xsink);
                } else if (response_body) {
                    response_body->append(*chunk);
                }
            }
        }

        // Read next chunk size
        releaseCurrentOp(xsink);
        sock_obj->ref();
        SimpleRefHolder<QoreStringNode> pattern(new QoreStringNode("\r\n"));
        current_op = new SocketRecvUntilBytesPollOperation(xsink, *pattern, sock_obj, true);
        if (*xsink) {
            current_op->deref(xsink);
            current_op = nullptr;
            return nullptr;
        }
        current_op->setSelf(*self);
        req_state = ReqState::RECV_CHUNK_SIZE;
        return handleRecvChunkSize(xsink);
    }

    setError("HTTP1-RECV-ERROR", "chunk data read failed", xsink);
    return nullptr;
}

QoreHashNode* Http1ClientPollOperationPriv::handleRecvChunkCrlf(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-RECV-ERROR", "chunk trailer read not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        QoreStringValueHelper err_str(poll_xsink.getExceptionErr());
        QoreStringValueHelper desc_str(poll_xsink.getExceptionDesc());
        setError(*err_str ? err_str->c_str() : "HTTP1-RECV-ERROR",
            *desc_str ? desc_str->c_str() : "chunk trailer read failed", xsink);
        poll_xsink.clear();
        return nullptr;
    }

    if (poll_info) {
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder line_val(current_op->getOutput(), xsink);
        if (line_val->getType() == NT_STRING) {
            QoreStringValueHelper line(*line_val);
            if (line->size() == 2 && !strcmp(line->c_str(), "\r\n")) {
                // Empty line - chunked transfer complete
                return streaming_active_io ? dispatchStreamingEnd(xsink) : dispatchResponse(xsink);
            }
            // Trailer line - read next line
            printd(5, "Http1ClientPollOperationPriv::handleRecvChunkCrlf() trailer line\n");
            releaseCurrentOp(xsink);
            sock_obj->ref();
            SimpleRefHolder<QoreStringNode> pattern(new QoreStringNode("\r\n"));
            current_op = new SocketRecvUntilBytesPollOperation(xsink, *pattern, sock_obj, true);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            return handleRecvChunkCrlf(xsink);
        }

        // Unexpected output type - treat as complete
        return streaming_active_io ? dispatchStreamingEnd(xsink) : dispatchResponse(xsink);
    }

    setError("HTTP1-RECV-ERROR", "chunk trailer read failed", xsink);
    return nullptr;
}

QoreHashNode* Http1ClientPollOperationPriv::handleRecvBodyClose(ExceptionSink* xsink) {
    if (!current_op) {
        setError("HTTP1-RECV-ERROR", "body close read not initialized", xsink);
        return nullptr;
    }

    ExceptionSink poll_xsink;
    QoreHashNode* poll_info = current_op->continuePoll(&poll_xsink);
    if (poll_xsink) {
        // Read error likely means EOF - treat as end of body
        poll_xsink.clear();
        return streaming_active_io ? dispatchStreamingEnd(xsink) : dispatchResponse(xsink);
    }

    if (poll_info) {
        // More I/O needed - return poll info to wait for data
        return poll_info;
    }

    if (current_op->goalReached()) {
        ValueHolder data_val(current_op->getOutput(), xsink);
        bool has_data = false;
        if (data_val->getType() == NT_BINARY) {
            const BinaryNode* data = data_val->get<const BinaryNode>();
            if (data->size() > 0) {
                has_data = true;
                if (streaming_active_io) {
                    dispatchStreamingData(data, xsink);
                } else if (response_body) {
                    response_body->append(data);
                    if (checkResponseBodySize(response_body->size(), "received before the connection closed",
                            xsink)) {
                        return nullptr;
                    }
                }
            }
        }

        // SocketRecvPacketPollState closes the socket on EOF (see
        // lib/QoreSocket.cpp:1894).  After that close, neither the recv
        // loop nor the new SocketRecvDataPollOperation constructor below
        // can do anything useful — both surface as SOCKET-NOT-OPEN to the
        // I/O controller, which routes through handleConnectionResult →
        // conn.close() → poll_op.abort() → HTTP1-ABORT for the still-
        // active stream.  Dispatch the body end now while the response
        // state is intact.
        if (!sock_obj || sock_obj->getSocket() < 0) {
            return streaming_active_io ? dispatchStreamingEnd(xsink) : dispatchResponse(xsink);
        }

        if (has_data) {
            // Read more data
            releaseCurrentOp(xsink);
            sock_obj->ref();
            current_op = new SocketRecvDataPollOperation(xsink, sock_obj, false);
            if (*xsink) {
                current_op->deref(xsink);
                current_op = nullptr;
                return nullptr;
            }
            current_op->setSelf(*self);
            return handleRecvBodyClose(xsink);
        }

        // Empty read means EOF on a close-delimited body.  Non-ready
        // sockets return poll_info above; a completed zero-byte recv must
        // terminate the response rather than re-polling forever.
        return streaming_active_io ? dispatchStreamingEnd(xsink) : dispatchResponse(xsink);
    }

    // Read operation ended without goalReached (likely EOF)
    return streaming_active_io ? dispatchStreamingEnd(xsink) : dispatchResponse(xsink);
}

// --- Protocol-switched (101) raw bidirectional handler ---

QoreHashNode* Http1ClientPollOperationPriv::handleProtocolSwitched(ExceptionSink* xsink) {
    // After 101 Switching Protocols, the H1 poll op's job is done.
    // The socket will be extracted by the WebSocket client and used with
    // WebSocketClientPollOperationBase (the existing C++ WS frame codec).
    // Return nullptr to signal goal reached - the controller will deliver
    // the result and the caller can extract the socket.
    ASYNC_IO_TRACE("H1 PROTOCOL_SWITCHED: goal reached, socket ready for extraction\n");
    return nullptr;
}

// --- Response dispatch ---

QoreHashNode* Http1ClientPollOperationPriv::dispatchResponse(ExceptionSink* xsink) {
    empty_read_count = 0;

    // The response is complete but a buffered request body is not.  The request declared a
    // Content-Length, so stopping short of it would leave the peer holding a request it cannot process -
    // and unlike a chunked streaming send, whose remaining body only the application can produce, the whole
    // body is already in hand here.  Park the finished response in ReqState::AWAIT_SEND and let the send
    // side run to its goal; awaitBufferedSend() re-enters this method when it does, or delivers the
    // response anyway if the peer stops reading.
    if (send_buffered_body && send_state != SendState::DONE) {
        ASYNC_IO_TRACE("H1 dispatchResponse: response complete with the request body still going out "
            "- waiting for it fd=%d\n", sock_obj ? sock_obj->getSocket() : -1);
        releaseCurrentOp(xsink);
        deferred_streaming_end = false;
        req_state = ReqState::AWAIT_SEND;
        return awaitBufferedSend(xsink);
    }

    // Take ownership of stream_action atomically and clear stream_action /
    // active_stream_count / active_sid in the same critical section.  This
    // closes a race against abort() / notifyPendingStreams() which read
    // stream_action under the same lock: if the clear were deferred to a
    // later block (as it used to be), abort() running between the two
    // blocks would see stream_action still set, call executeError(
    // "HTTP1-ABORT") on it, and reject the Future before this method
    // could resolve it with the response.  The local @c action keeps a
    // ref so we can dispatch outside the lock.
    int stream_id;
    AbstractAsyncAction* action = nullptr;
    {
        AutoLocker al(stream_lock);
        stream_id = active_sid;
        action = stream_action;
        if (action) {
            // local takes the existing refcount slot from stream_action;
            // clearing stream_action without deref keeps the count balanced.
            stream_action = nullptr;
            response_dispatched = true;
            // Decrement only when this dispatch owned the active stream.
            // stream_action is set together with the increment in submitRequest()
            // and cleared by whoever consumes the stream, so a null action means
            // the count was already settled — by notifyPendingStreams() (which
            // resets it to 0 on abort()/setError()) or by cancelStream().  An
            // unconditional decrement here underflowed in exactly those cases, and
            // the counter never recovers for the life of the connection.
            // Matches the guarded H2/H3 decrements.
            --active_stream_count;
        }
        active_sid = 0;
        active_method.clear();
    }

    // Convert binary body to string for text-based content types
    QoreValue body = convertBodyEncoding(xsink);

    // Build response hash
    ReferenceHolder<QoreHashNode> resp(new QoreHashNode(autoTypeInfo), xsink);
    resp->setKeyValue("status_code", response_status_code, xsink);
    if (response_status_message) {
        resp->setKeyValue("status_message", response_status_message->stringRefSelf(), xsink);
    }
    if (response_http_version) {
        resp->setKeyValue("http_version", response_http_version->stringRefSelf(), xsink);
    }
    if (response_headers) {
        resp->setKeyValue("headers", response_headers->hashRefSelf(), xsink);
    }
    if (response_headers_raw) {
        resp->setKeyValue("headers_raw", response_headers_raw->hashRefSelf(), xsink);
    }
    if (!body.isNullOrNothing()) {
        resp->setKeyValue("body", body, xsink);
    } else {
        body.discard(xsink);
    }
    resp->setKeyValue("stream_id", (int64_t)stream_id, xsink);
    resp->setKeyValue("end_stream", true, xsink);
    resp->setKeyValue("protocol", new QoreStringNode("h1"), xsink);

    printd(5, "Http1ClientPollOperationPriv::dispatchResponse() stream_id=%d status=%d\n",
        stream_id, response_status_code);

    bool close = connection_close;
    // Full-duplex streaming: a response delivered while the chunked request
    // body is still open means the connection cannot be safely reused — force
    // close (see dispatchStreamingEnd() for the same rationale).
    if (send_state != SendState::INACTIVE && send_state != SendState::DONE) {
        close = true;
    }
    req_state = ReqState::IDLE;
    releaseCurrentOp(xsink);
    resetResponseState(xsink);
    resetSendState(xsink);

    // If the server requested connection close, mark the connection closed
    // BEFORE resolving the response Future.  Otherwise a consumer thread
    // waking from action->execute() can call acquireStream() on this same
    // connection (still marked Ready in the pool) before the close fires,
    // landing a new stream_action that the subsequent abort() in
    // closeImpl() rejects with HTTP1-ABORT.
    if (close) {
        h1_state.store(H1State::CLOSED, std::memory_order_release);
        if (connection_priv) {
            connection_priv->setClosed();
        }
        connection_priv = nullptr;
    }

    // Dispatch to action
    if (action) {
        action->execute(resp.release(), xsink);
        action->deref(xsink);
    }

    if (close) {
        printd(5, "Http1ClientPollOperationPriv::dispatchResponse() connection close\n");
        return nullptr;
    }

    // Return to idle - arm the proactive idle deadline so the controller
    // wakes us up at the timeout (nginx upstream keepalive_timeout pattern).
    idle_deadline_us = 0;  // fresh idle period after completing a request
    h1_state.store(H1State::WAIT_READ, std::memory_order_release);
    return armIdleDeadline(getSocketPollInfoHash(xsink, SOCK_POLLIN), xsink);
}

void Http1ClientPollOperationPriv::dispatchStreamingHeaders(ExceptionSink* xsink) {
    AbstractAsyncAction* action = nullptr;
    int stream_id;
    {
        AutoLocker al(stream_lock);
        stream_id = active_sid;
        action = stream_action;
        if (action) {
            action->ref();
        }
    }

    if (action) {
        ReferenceHolder<QoreHashNode> hdr_resp(new QoreHashNode(autoTypeInfo), xsink);
        hdr_resp->setKeyValue("status_code", response_status_code, xsink);
        if (response_status_message) {
            hdr_resp->setKeyValue("status_message", response_status_message->stringRefSelf(), xsink);
        }
        if (response_http_version) {
            hdr_resp->setKeyValue("http_version", response_http_version->stringRefSelf(), xsink);
        }
        if (response_headers) {
            hdr_resp->setKeyValue("headers", response_headers->hashRefSelf(), xsink);
        }
        if (response_headers_raw) {
            hdr_resp->setKeyValue("headers_raw", response_headers_raw->hashRefSelf(), xsink);
        }
        hdr_resp->setKeyValue("protocol", new QoreStringNode("h1"), xsink);
        hdr_resp->setKeyValue("stream_id", (int64_t)stream_id, xsink);
        action->execute(hdr_resp.release(), xsink);
        action->deref(xsink);
    }
}

void Http1ClientPollOperationPriv::dispatchStreamingData(const BinaryNode* data,
        ExceptionSink* xsink) {
    AbstractAsyncAction* action = nullptr;
    {
        AutoLocker al(stream_lock);
        action = stream_action;
        if (action) {
            action->ref();
        }
    }

    if (action) {
        ReferenceHolder<QoreHashNode> data_resp(new QoreHashNode(autoTypeInfo), xsink);
        data_resp->setKeyValue("body", data->refSelf(), xsink);
        action->execute(data_resp.release(), xsink);
        action->deref(xsink);
    }
}

QoreHashNode* Http1ClientPollOperationPriv::dispatchStreamingEnd(ExceptionSink* xsink) {
    empty_read_count = 0;

    // The response is complete but a buffered request body is not.  The request declared a
    // Content-Length, so stopping short of it would leave the peer holding a request it cannot process -
    // and unlike a chunked streaming send, whose remaining body only the application can produce, the whole
    // body is already in hand here.  Park the finished response in ReqState::AWAIT_SEND and let the send
    // side run to its goal; awaitBufferedSend() re-enters this method when it does, or delivers the
    // response anyway if the peer stops reading.
    if (send_buffered_body && send_state != SendState::DONE) {
        ASYNC_IO_TRACE("H1 dispatchStreamingEnd: response complete with the request body still going out "
            "- waiting for it fd=%d\n", sock_obj ? sock_obj->getSocket() : -1);
        releaseCurrentOp(xsink);
        deferred_streaming_end = true;
        req_state = ReqState::AWAIT_SEND;
        return awaitBufferedSend(xsink);
    }

    int stream_id;
    AbstractAsyncAction* action = nullptr;
    bool close = connection_close;
    bool keep_completed_channel = false;

    // Full-duplex streaming: if the response completed while the chunked
    // request body is still open (the server replied and closed its response
    // before the client finished sending the request body), the connection
    // cannot be safely reused as keep-alive — force close.
    if (send_state != SendState::INACTIVE && send_state != SendState::DONE) {
        ASYNC_IO_TRACE("H1 dispatchStreamingEnd: response ended with request body still "
            "open (send_state=%d) - forcing close fd=%d\n", (int)send_state,
            sock_obj ? sock_obj->getSocket() : -1);
        close = true;
    }
    {
        AutoLocker al(stream_lock);
        stream_id = active_sid;
        action = stream_action;
        if (action) {
            action->ref();
            ChannelAction* ch_action = dynamic_cast<ChannelAction*>(action);
            if (ch_action && ch_action->isSseInstallEligible()) {
                if (completed_channel_action) {
                    completed_channel_action->deref(xsink);
                }
                completed_channel_action = ch_action;
                completed_sid = stream_id;
                keep_completed_channel = true;
            }
            // see dispatchResponse(): decrement only when this dispatch owned the
            // active stream, otherwise the count underflows after
            // notifyPendingStreams() / cancelStream() already settled it
            --active_stream_count;
        }
        stream_action = nullptr;
        active_sid = 0;
        active_method.clear();
    }
    req_state = ReqState::IDLE;
    releaseCurrentOp(xsink);
    resetResponseState(xsink);
    resetSendState(xsink);

    // Mark the connection closed before completing the action — see
    // dispatchResponse() for the full race rationale (consumer thread
    // waking from action->execute() can land a new stream on a connection
    // that is about to be evicted).
    if (close) {
        h1_state.store(H1State::CLOSED, std::memory_order_release);
        if (connection_priv) {
            connection_priv->setClosed();
        }
        connection_priv = nullptr;
    }

    if (action) {
        ReferenceHolder<QoreHashNode> end_resp(new QoreHashNode(autoTypeInfo), xsink);
        end_resp->setKeyValue("end_stream", true, xsink);
        end_resp->setKeyValue("stream_id", (int64_t)stream_id, xsink);
        action->execute(end_resp.release(), xsink);
        action->complete(xsink);
        action->deref(xsink);
        if (!keep_completed_channel) {
            action->deref(xsink);
        }
    }

    if (close) {
        printd(5, "Http1ClientPollOperationPriv::dispatchStreamingEnd() connection close\n");
        return nullptr;
    }

    // Return to idle - arm the proactive idle deadline for nginx-style
    // upstream keepalive_timeout behavior.
    idle_deadline_us = 0;  // fresh idle period after completing a streaming request
    h1_state.store(H1State::WAIT_READ, std::memory_order_release);
    return armIdleDeadline(getSocketPollInfoHash(xsink, SOCK_POLLIN), xsink);
}

void Http1ClientPollOperationPriv::resetResponseState(ExceptionSink* xsink) {
    if (response_headers) {
        response_headers->deref(xsink);
        response_headers = nullptr;
    }
    if (response_headers_raw) {
        response_headers_raw->deref(xsink);
        response_headers_raw = nullptr;
    }
    response_status_code = 0;
    if (response_status_message) {
        response_status_message->deref();
        response_status_message = nullptr;
    }
    if (response_http_version) {
        response_http_version->deref();
        response_http_version = nullptr;
    }
    if (response_body) {
        response_body->deref(xsink);
        response_body = nullptr;
    }
    response_chunked = false;
    response_content_length = -1;
    connection_close = false;
    streaming_active_io = false;
    streaming_body_remaining = 0;
}

QoreValue Http1ClientPollOperationPriv::convertBodyEncoding(ExceptionSink* xsink) {
    if (!response_body || response_body->size() == 0) {
        return QoreValue();
    }

    // Check Content-Type for text-based types
    if (!response_headers) {
        return response_body->refSelf();
    }

    // Don't charset-convert compressed bodies - caller handles decompression first
    QoreValue ce_val = response_headers->getKeyValue("content-encoding");
    if (ce_val.getType() == NT_STRING) {
        QoreStringValueHelper ce_str(ce_val);
        const char* ce = ce_str->c_str();
        if (ce && *ce && strcasecmp(ce, "identity")) {
            return response_body->refSelf();
        }
    }

    QoreValue ct_val = response_headers->getKeyValue("content-type");
    if (ct_val.getType() != NT_STRING) {
        return response_body->refSelf();
    }

    QoreStringValueHelper ct_str(ct_val);
    const char* ct = ct_str->c_str();
    if (!isTextContentType(ct)) {
        return response_body->refSelf();
    }

    // Determine charset
    const QoreEncoding* enc = QCS_UTF8;

    // JSON and YAML are always UTF-8 per RFC 8259 / YAML spec
    bool force_utf8 = strcasestr(ct, "/json") || strcasestr(ct, "/x-yaml")
        || strcasestr(ct, "/yaml") || strcasestr(ct, "+json");

    if (!force_utf8) {
        qore_http_media_type_param charset;
        if (qore_find_http_media_type_param(ct, "charset", charset) && !charset.value.empty()) {
            enc = QEM.findCreate(charset.value.c_str());
        }
    }

    // Convert binary to string with the detected encoding
    QoreStringNode* str = new QoreStringNode(
        (const char*)response_body->getPtr(), response_body->size(), enc);
    return str;
}

bool Http1ClientPollOperationPriv::isTextContentType(const char* ct) {
    if (!ct) {
        return false;
    }
    // Check common text-based content types
    return !strncasecmp(ct, "text/", 5)
        || strcasestr(ct, "/json")
        || strcasestr(ct, "/xml")
        || strcasestr(ct, "/yaml")
        || strcasestr(ct, "/html")
        || strcasestr(ct, "/javascript")
        || strcasestr(ct, "+json")
        || strcasestr(ct, "+xml")
        || strcasestr(ct, "charset=")
        || strcasestr(ct, "x-www-form-urlencoded");
}

// --- Error handling ---

void Http1ClientPollOperationPriv::abort(ExceptionSink* xsink) {
    h1_state.store(H1State::CLOSED, std::memory_order_release);
    if (current_op) {
        current_op->abort(xsink);
    }
    if (send_op) {
        send_op->abort(xsink);
    }
    // Close before notifying, so a caller woken by notifyPendingStreams() cannot
    // check out this connection again — see setError() for the full rationale.
    {
        AutoLocker al(stream_lock);
        if (connection_priv) {
            connection_priv->setClosed();
        }
        connection_priv = nullptr;
    }
    notifyPendingStreams("HTTP1-ABORT", "connection aborted", xsink);
    // Note: do NOT close socket or delete current_op here to avoid
    // use-after-free if a driver thread is still inside continuePoll
}

int Http1ClientPollOperationPriv::checkResponseBodySize(int64_t size, const char* desc, ExceptionSink* xsink) {
    int64_t max_size = max_response_body_size.load(std::memory_order_relaxed);
    if (max_size <= 0 || size <= max_size) {
        return 0;
    }
    QoreStringMaker msg("the response body of at least %lld bytes %s exceeds the maximum response body size of "
        "%lld bytes", (long long)size, desc, (long long)max_size);
    setError("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", msg.c_str(), xsink);
    return -1;
}

void Http1ClientPollOperationPriv::setError(const char* err, const char* desc,
        ExceptionSink* xsink) {
    {
        AutoLocker al(stream_lock);
        if (!error_info) {
            error_info = new QoreHashNode(autoTypeInfo);
            error_info->setKeyValue("err", new QoreStringNode(err), xsink);
            error_info->setKeyValue("desc", new QoreStringNode(desc), xsink);
        }
    }
    h1_state.store(H1State::CLOSED, std::memory_order_release);
    // Close the socket to release the fd and transition from CLOSE-WAIT to CLOSED.
    // Without this, dead sockets accumulate when the remote closes the connection
    // and degrade I/O controller performance.  The epoll cleanup handles EBADF
    // gracefully when the controller unregisters the fd after this returns.
    if (sock_obj && sock_obj->getSocket() >= 0) {
        sock_obj->closeIo(xsink);
    }
    // Mark the connection closed BEFORE notifying the pending streams, for the
    // same reason dispatchResponse() closes before resolving the response
    // Future: notifyPendingStreams() resolves the waiting caller's Promise, so
    // it is a thread wakeup, and everything after it races with a caller that
    // is already running again.  A caller that wakes while the connection is
    // still Ready in the manager's pool gets this dead connection back from its
    // very next checkout — findReusableLocked() screens only on
    // isClosed()/isDraining() and a free stream slot, and notifyPendingStreams()
    // has already zeroed the stream count.  Its submitRequest() then fails on
    // the connection and re-raises the error stored just above (via
    // getStoredError() below, or HttpClientConnectionBase::raiseClosedSubmitError())
    // without ever reaching the wire, so the caller sees this request's failure
    // reported as the next request's failure.
    {
        AutoLocker al(stream_lock);
        if (connection_priv) {
            connection_priv->setClosed();
        }
        connection_priv = nullptr;
    }
    notifyPendingStreams(err, desc, xsink);
}

bool Http1ClientPollOperationPriv::getStoredError(std::string& err, std::string& desc) const {
    AutoLocker al(stream_lock);
    if (!error_info) {
        return false;
    }

    QoreValue ev = error_info->getKeyValue("err");
    QoreValue dv = error_info->getKeyValue("desc");
    if (ev.getType() == NT_STRING) {
        QoreStringValueHelper ev_str(ev);
        err = ev_str->c_str();
    } else {
        err = "HTTP1-CONNECTION-CLOSED";
    }
    if (dv.getType() == NT_STRING) {
        QoreStringValueHelper dv_str(dv);
        desc = dv_str->c_str();
    } else {
        desc = "connection closed before request could be submitted";
    }
    return true;
}

void Http1ClientPollOperationPriv::notifyPendingStreams(const char* err, const char* desc,
        ExceptionSink* xsink) {
    AbstractAsyncAction* action = nullptr;
    {
        AutoLocker al(stream_lock);
        action = stream_action;
        stream_action = nullptr;
        if (completed_channel_action) {
            completed_channel_action->deref(xsink);
            completed_channel_action = nullptr;
            completed_sid = 0;
        }
        active_stream_count = 0;
        // Clean up streaming send queue
        for (auto* s : send_body_queue) {
            if (s) {
                s->deref(xsink);
            }
        }
        send_body_queue.clear();
        if (send_trailers) {
            send_trailers->deref(xsink);
            send_trailers = nullptr;
        }
    }

    if (action) {
        action->executeError(err, desc, xsink);
        action->deref(xsink);
    }
}

void Http1ClientPollOperationPriv::fireReadyCallback(ExceptionSink* xsink) {
    // Read connection_priv under stream_lock to race-free disarm against
    // closeConnection's disarmConnectionPriv - matches the pattern used
    // by abort() / setError() above and by the H2 / H3 equivalents.
    AutoLocker al(stream_lock);
    if (connection_priv) {
        connection_priv->onConnectionReady();  // Pure C++, no evalMethod, I/O-thread safe
    }
}

// --- Stream management (app thread) ---

int64_t Http1ClientPollOperationPriv::submitRequest(const char* method, const char* path,
        const QoreHashNode* user_headers, const void* body, size_t body_len,
        bool streaming, AbstractAsyncAction* action, int max_streams,
        bool streaming_send_flag, ExceptionSink* xsink) {
    // State check
    H1State cur_state = h1_state.load(std::memory_order_acquire);
    if (cur_state != H1State::READING && cur_state != H1State::WAIT_READ) {
        action->deref(xsink);
        std::string err_str;
        std::string desc_str;
        if (cur_state == H1State::CLOSED && getStoredError(err_str, desc_str)) {
            xsink->raiseException(err_str.c_str(), "%s", desc_str.c_str());
            return -1;
        }
        xsink->raiseException("HTTP1-STATE-ERROR",
            "cannot submit request in state: %s", getStateImpl());
        return -1;
    }

    // Build HTTP/1.1 request wire format
    SimpleRefHolder<QoreStringNode> req(new QoreStringNode());

    // Compute host header value
    int default_port = ssl_required ? 443 : 80;
    std::string host_str;
    if (target_port == 0 && !target_host.empty() && target_host[0] == '/') {
        QoreString tmp_path(target_host.c_str());
        QoreString encoded_path;
        encoded_path.concatEncodeUrl(xsink, tmp_path, true);
        if (*xsink) {
            action->deref(xsink);
            return -1;
        }
        host_str = encoded_path.c_str();
    } else if (target_port == default_port) {
        host_str = target_host;
    } else {
        host_str = target_host + ":" + std::to_string(target_port);
    }

    bool has_host_header = false;
    if (user_headers) {
        ConstHashIterator hi(user_headers);
        while (hi.next()) {
            if (!strcasecmp(hi.getKey(), "host") && !hi.get().isNothing()) {
                has_host_header = true;
                break;
            }
        }
    }

    // For plain HTTP through a proxy, use absolute URL in request line
    if (is_proxy_plain) {
        req->sprintf("%s http://%s%s HTTP/1.1\r\n",
            method, host_str.c_str(), (path && *path) ? path : "/");
    } else {
        req->sprintf("%s %s HTTP/1.1\r\n",
            method, (path && *path) ? path : "/");
    }
    if (!has_host_header) {
        req->sprintf("Host: %s\r\n", host_str.c_str());
    }

    // Add request headers (skip HTTP/2 pseudo-headers)
    bool has_content_length = false;
    if (user_headers) {
        ConstHashIterator hi(user_headers);
        while (hi.next()) {
            const char* key = hi.getKey();
            if (key[0] == ':') {
                continue;
            }
            // When streaming-send adds its own "Transfer-Encoding: chunked"
            // below, skip any user-supplied TE header - otherwise the peer
            // sees it twice ("chunked, chunked"), which folds to a list and
            // causes the request body not to be read as chunked.
            if (streaming_send_flag && !strcasecmp(key, "transfer-encoding")) {
                continue;
            }
            QoreValue v = hi.get();
            // Handle list values by emitting multiple header lines
            if (v.getType() == NT_LIST) {
                const QoreListNode* l = v.get<const QoreListNode>();
                ConstListIterator li(l);
                while (li.next()) {
                    req->sprintf("%s: ", key);
                    QoreStringValueHelper sv(li.getValue());
                    req->concat(sv->c_str());
                    req->concat("\r\n");
                }
            } else {
                req->sprintf("%s: ", key);
                QoreStringValueHelper sv(v);
                req->concat(sv->c_str());
                req->concat("\r\n");
            }
            if (!strcasecmp(key, "content-length")) {
                has_content_length = true;
            }
        }
    }

    // Add Content-Length or Transfer-Encoding: chunked
    if (streaming_send_flag) {
        // Streaming send: use chunked TE - body will be pushed via pushSendData()
        req->concat("Transfer-Encoding: chunked\r\n");
    } else if (!has_content_length
            && (body_len > 0 || (strcasecmp(method, "GET")
                && strcasecmp(method, "HEAD") && strcasecmp(method, "TRACE")))) {
        req->sprintf("Content-Length: %lu\r\n", (unsigned long)body_len);
    }
    req->concat("\r\n");

    // Convert to binary and append body (not for streaming send).  The header block and the body stay in one
    // buffer so that a request small enough to fit in the socket's send buffer still reaches the wire in a
    // single write - splitting every request in two would cost an extra syscall and, worse, expose every small
    // POST to the write-write-read delay that Nagle plus delayed ACK produces.  handleSending() uses
    // header_len to recognize when a partial write has nonetheless put the whole header block out.
    size_t header_len = req->size();
    BinaryNode* bin = new BinaryNode();
    bin->append(req->c_str(), req->size());
    if (!streaming_send_flag && body_len > 0 && body) {
        bin->append(body, body_len);
    }

    int64_t stream_id;
    {
        // Under stream_lock: store and register
        AutoLocker al(stream_lock);

        // Re-check state under stream_lock.  The lock-free state read at the
        // top of this function races with setError() on the I/O thread: setError
        // releases stream_lock between writing error_info and storing the
        // CLOSED state, so a window exists where this thread sees the OK state,
        // proceeds to build the request, and then arrives here only after the
        // I/O thread has already drained stream_action via notifyPendingStreams.
        // Without this re-check, our action would attach AFTER the drain - the
        // future would never resolve, manifesting as a FUTURE-TIMEOUT in the
        // caller (mgr.request -> q_future_get_blocking).  Surface the closure
        // error eagerly instead.
        if (h1_state.load(std::memory_order_acquire) == H1State::CLOSED) {
            bin->deref(xsink);
            std::string err_str = "HTTP1-CONNECTION-CLOSED";
            std::string desc_str = "connection closed before request could be submitted";
            if (error_info) {
                QoreValue ev = error_info->getKeyValue("err");
                QoreValue dv = error_info->getKeyValue("desc");
                if (ev.getType() == NT_STRING) {
                    QoreStringValueHelper ev_str(ev);
                    err_str = ev_str->c_str();
                }
                if (dv.getType() == NT_STRING) {
                    QoreStringValueHelper dv_str(dv);
                    desc_str = dv_str->c_str();
                }
            }
            action->deref(xsink);
            xsink->raiseException(err_str.c_str(), "%s", desc_str.c_str());
            return -1;
        }

        // Capacity check
        if (max_streams && active_stream_count >= max_streams) {
            bin->deref(xsink);
            action->deref(xsink);
            xsink->raiseException("HTTP1-CAPACITY-ERROR",
                "connection at capacity: %d/%d streams",
                active_stream_count, max_streams);
            return -1;
        }

        stream_id = ++next_stream_id;
        if (completed_channel_action) {
            completed_channel_action->deref(xsink);
            completed_channel_action = nullptr;
            completed_sid = 0;
        }
        stream_action = action;  // takes ownership
        ++active_stream_count;
        active_sid = (int)stream_id;
        active_method = method;
        streaming_active = streaming;
        streaming_send = streaming_send_flag;
        if (pending_request_data) {
            pending_request_data->deref(xsink);
        }
        pending_request_data = bin;
        pending_request_header_len = header_len;
    }

    return stream_id;
}

bool Http1ClientPollOperationPriv::cancelStream(int64_t stream_id, ExceptionSink* xsink) {
    AbstractAsyncAction* action = nullptr;
    bool in_flight = false;

    {
        AutoLocker al(stream_lock);
        if (!stream_action || active_sid != (int)stream_id) {
            if (completed_channel_action && completed_sid == (int)stream_id) {
                completed_channel_action->deref(xsink);
                completed_channel_action = nullptr;
                completed_sid = 0;
            }
            return false;  // already completed or not found
        }

        action = stream_action;
        stream_action = nullptr;
        --active_stream_count;

        if (req_state == ReqState::IDLE) {
            // Request hasn't started sending yet - safe to cancel
            active_sid = 0;
            active_method.clear();
            if (pending_request_data) {
                pending_request_data->deref(xsink);
                pending_request_data = nullptr;
            }
        } else {
            // Request is in flight - must close connection to avoid
            // corrupting protocol state
            in_flight = true;
        }
    }

    // Close first when the exchange reached the wire: settling the action below
    // wakes the cancelled caller, and a connection that is still Ready in the
    // pool at that moment is handed straight back out — see setError() for the
    // full rationale.  setError() cannot settle this action itself: it was taken
    // out of stream_action under the lock above, so notifyPendingStreams() finds
    // nothing to notify and this remains the only report of the cancellation.
    if (in_flight) {
        printd(5, "Http1ClientPollOperationPriv::cancelStream() in-flight - closing connection\n");
        setError("HTTP1-CANCELLED", "connection closed due to in-flight cancellation", xsink);
    }

    if (action) {
        action->executeError("HTTP1-CANCELLED", "request cancelled", xsink);
        action->deref(xsink);
    }

    return true;
}

void Http1ClientPollOperationPriv::installSseState(int64_t stream_id, Queue* queue,
        QoreEventNotifier* notifier, QoreObject* notifier_obj, QoreValue initial,
        ExceptionSink* xsink) {
    ChannelAction* ch_action = nullptr;
    bool completed_action = false;
    {
        AutoLocker al(stream_lock);
        if (stream_action && active_sid == (int)stream_id) {
            ch_action = dynamic_cast<ChannelAction*>(stream_action);
        } else if (completed_channel_action && completed_sid == (int)stream_id) {
            ch_action = completed_channel_action;
            completed_channel_action = nullptr;
            completed_sid = 0;
            completed_action = true;
        } else {
            initial.discard(xsink);
            xsink->raiseException("HTTPCLIENT-STREAM-CLOSED",
                "cannot install SSE state: stream %lld not found or already complete",
                (long long)stream_id);
            return;
        }
        if (!ch_action) {
            initial.discard(xsink);
            xsink->raiseException("HTTPCLIENT-STATE-ERROR",
                "cannot install SSE state: stream %lld action is not a ChannelAction",
                (long long)stream_id);
            return;
        }
        ch_action->ref();
    }

    ch_action->installSseState(queue, notifier, notifier_obj, initial, xsink);
    ch_action->deref(xsink);
    if (completed_action) {
        ch_action->deref(xsink);
    }
}

/** @endcond */

//! C++ base class for HTTP/1.1 client poll operations
/** This class provides the SocketPollOperationBase fast path for the
    AsyncIoController, implementing the HTTP/1.1 client poll state machine
    (connecting, ssl_upgrade, proxy_connect_send/recv, reading, wait_read,
    closed) entirely in C++.

    HTTP/1.1 is a serial protocol - only one request can be in flight at a
    time. The connection manager creates multiple connections for concurrent
    requests.

    The Qore Http1ClientPollOperation class inherits from this base to get
    the C++ fast path while providing the high-level HTTP/1.1 API.

    @since %Qore 3.0
*/
qclass Http1ClientPollOperationBase [
    private_members=object sock,string goal,auto data_save;
    ns=Qore;
    arg=Http1ClientPollOperationPriv* priv;
    vparent=SocketPollOperationBase<auto>
];

//! Creates the HTTP/1.1 client poll operation base
/** @param socket the TCP socket (must not be connected yet)
    @param connect_target the connect target: "host:port", or the socket path for a UNIX domain socket target
    @param target_host the target hostname for Host header and proxy CONNECT
    @param target_port the target port number
    @param ssl_required True if SSL/TLS is required (HTTPS)
    @param proxy_tunnel True if a proxy CONNECT tunnel is needed
    @param plain_proxy True when using plain HTTP through a proxy (absolute URI)
    @param connection the owning HttpClientConnection object
*/
Http1ClientPollOperationBase::constructor(Socket[QoreSocketObject] socket, string connect_target,
        string target_host, int target_port, bool ssl_required, bool proxy_tunnel,
        bool plain_proxy,
        AbstractHttpPollConnection[AbstractHttpPollConnectionPriv] connection) [flags=NAMED_ARGS] {
    QoreSocketObject* sock_ptr = *socket;

    // Create the initial connect operation.  A UNIX domain socket target carries the socket path in
    // connect_target and port 0 (see HttpClientConnectionManager::isUnixSocketTarget()); it must be connected
    // explicitly as a path, since an automatic target containing ':' would be resolved as a TCP host:port.
    bool unix_target = !proxy_tunnel && !plain_proxy && !target_port && target_host->strlen()
        && target_host->c_str()[0] == '/';
    sock_ptr->ref();
    ReferenceHolder<SocketConnectPollOperation> connect_op(
        unix_target
            ? new SocketConnectPollOperation(xsink, false, connect_target->c_str(), SOCK_STREAM, 0, sock_ptr, true)
            : new SocketConnectPollOperation(xsink, false, connect_target->c_str(), sock_ptr, true),
        xsink);
    if (*xsink) {
        return;
    }

    // Set up Qore object members
    QoreValue sock_arg = args->retrieveEntry(0);
    QoreObject* sock_obj = sock_arg.getType() == NT_OBJECT
        ? const_cast<QoreObject*>(sock_arg.get<const QoreObject>()) : nullptr;
    if (sock_obj) {
        self->setMemberValue("sock", QC_HTTP1CLIENTPOLLOPERATIONBASE,
            sock_obj->refSelf(), xsink);
    }
    self->setMemberValue("goal", QC_HTTP1CLIENTPOLLOPERATIONBASE,
        new QoreStringNode("http1_client"), xsink);

    // Set self on the connect op so it can build SocketPollInfo hashes
    SocketConnectPollOperation* connect_ptr = connect_op.release();
    connect_ptr->setSelf(self);

    // Create the private data - ref sock for private data ownership
    // Extract the raw C++ priv pointer for direct I/O-thread calls;
    // the Qore-level connection_ref member holds the only strong QoreObject ref
    AbstractHttpPollConnectionPriv* conn_priv = *connection;
    sock_ptr->ref();
    self->setPrivate(CID_HTTP1CLIENTPOLLOPERATIONBASE,
        new Http1ClientPollOperationPriv(self, sock_ptr, connect_ptr,
            ssl_required, proxy_tunnel, plain_proxy,
            target_host->c_str(), (int)target_port, conn_priv));
}

//! Destroys the object
/** Releases all internal references.
*/
Http1ClientPollOperationBase::destructor() {
    priv->cleanup(xsink);
    priv->deref(xsink);
}

//! Returns the goal
/** @return the goal string
*/
string Http1ClientPollOperationBase::getGoal() [flags=RET_VALUE_ONLY] {
    return self->getReferencedMemberNoMethod("goal", xsink);
}

//! Returns the current state
/** @return the current state string
*/
string Http1ClientPollOperationBase::getState() [flags=RET_VALUE_ONLY] {
    return priv->getState();
}

//! Returns True when the goal has been reached
/** @return always False (long-running serial operation)
*/
bool Http1ClientPollOperationBase::goalReached() [flags=RET_VALUE_ONLY] {
    return priv->goalReached();
}

//! Continues the poll operation
/** @return socket poll info for the next poll cycle, or NOTHING if complete
*/
*hash<SocketPollInfo> Http1ClientPollOperationBase::continuePoll() {
    return priv->continuePoll(xsink);
}

//! Aborts the operation
/** Closes the HTTP/1.1 connection and notifies the pending stream.
*/
nothing Http1ClientPollOperationBase::abort() {
    priv->abort(xsink);
}

//! Sets the proactive idle timeout for this connection.
/** When the connection has been idle (no pending request, no active stream)
    for this many milliseconds, handleIdle() will close it proactively with
    an \c HTTP1-IDLE-TIMEOUT error.  Mirrors nginx's upstream
    \c keepalive_timeout - defense-in-depth against peers that never close
    idle keep-alive connections.

    @param idle_timeout_ms timeout in milliseconds; <= 0 disables the proactive timeout

    @since %Qore 3.0
*/
nothing Http1ClientPollOperationBase::setIdleTimeout(int idle_timeout_ms) [flags=NAMED_ARGS] {
    priv->setIdleTimeout((int64_t)idle_timeout_ms * 1000);
}

//! Sets the maximum size of a response body that is returned whole
/** A response body that exceeds the limit as received fails the request with
    \c HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE as soon as the limit is exceeded, and the connection is closed; a body
    delivered incrementally to a streaming consumer is not limited.

    @param max_size the maximum size in bytes; <= 0 means no limit

    @since %Qore 3.0
*/
nothing Http1ClientPollOperationBase::setMaxResponseBodySize(int max_size) [flags=NAMED_ARGS] {
    priv->setMaxResponseBodySize(max_size > 0 ? max_size : 0);
}

//! Sets the connect-phase timeout for this connection.
/** Bounds the time spent establishing the connection - TCP connect, TLS handshake and
    proxy \c CONNECT tunnel - independently of the caller's request budget.  When the
    deadline expires the operation fails itself with an \c HTTP1-CONNECT-TIMEOUT error,
    closes the socket and marks the connection closed, so the waiting caller gets
    \c HTTPCLIENT-CONNECT-ERROR naming the real cause instead of a generic
    \c HTTPCLIENT-TIMEOUT once the request budget runs out.

    @param connect_timeout_ms timeout in milliseconds; <= 0 disables the connect deadline

    @note The deadline is enforced by the I/O thread inside \c continuePoll(); it must
    never be duplicated as a caller-side wait, which would abort the operation before it
    can generate the transport error.

    @since %Qore 3.0
*/
nothing Http1ClientPollOperationBase::setConnectTimeout(int connect_timeout_ms) [flags=NAMED_ARGS] {
    priv->setConnectTimeout((int64_t)connect_timeout_ms * 1000);
}

//! Returns output from the inner operation
/** @return any output data from the inner operation
*/
auto Http1ClientPollOperationBase::getOutput() [flags=RET_VALUE_ONLY] {
    return priv->getOutput();
}

//! Returns True if the connection is closed
/** @return True if closed
*/
bool Http1ClientPollOperationBase::isClosed() [flags=RET_VALUE_ONLY] {
    return priv->isClosed();
}

//! Returns True if the connection is ready for requests
/** @return True if ready (in reading or wait_read state)
*/
bool Http1ClientPollOperationBase::isReady() [flags=RET_VALUE_ONLY] {
    return priv->isReady();
}

//! Returns True if the connection is in protocol-switched state (after 101)
/** @return True if the HTTP protocol has been switched (e.g., WebSocket upgrade)
    @since %Qore 3.0
*/
bool Http1ClientPollOperationBase::isProtocolSwitched() [flags=RET_VALUE_ONLY] {
    return priv->isProtocolSwitched();
}

//! Registers a listener object for protocol-switched data notifications
/** The listener's \c notifyIo() method will be called from the I/O thread
    whenever raw data is dispatched in PROTOCOL_SWITCHED state (after 101).

    @param listener an object with a \c notifyIo() method
    @since %Qore 3.0
*/
nothing Http1ClientPollOperationBase::setProtocolSwitchedListener(object listener) [flags=NAMED_ARGS] {
    priv->setProtocolSwitchedListener(const_cast<QoreObject*>(listener), xsink);
}

//! Returns True if an error occurred
/** @return True if error
*/
bool Http1ClientPollOperationBase::hasError() [flags=RET_VALUE_ONLY] {
    return priv->hasError();
}

//! Returns error information if an error occurred
/** @return error hash or NOTHING
*/
*hash<auto> Http1ClientPollOperationBase::getError() [flags=RET_VALUE_ONLY] {
    return priv->getErrorInfo();
}

//! Returns the number of active streams (lock-free)
/** @return active stream count (0 or 1 for HTTP/1.1)
*/
int Http1ClientPollOperationBase::getActiveStreamCount() [flags=RET_VALUE_ONLY] {
    return priv->getActiveStreamCount();
}

//! Submits an HTTP/1.1 request with Promise-based response delivery
/** @param method HTTP method (GET, POST, etc.)
    @param path request path
    @param headers optional request headers (pseudo-headers are skipped)
    @param body optional request body (string or binary)
    @param promise Promise to resolve with the response
    @param max_streams maximum concurrent streams (should be 1 for HTTP/1.1)
    @return the stream ID assigned to this request
*/
int Http1ClientPollOperationBase::submitRequest(string method, string path,
        *hash<auto> headers, *data body, Promise[QorePromise] promise, int max_streams) [flags=NAMED_ARGS] {
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (body) {
        switch (body->getType()) {
            case NT_BINARY: {
                const BinaryNode* b = static_cast<const BinaryNode*>(body);
                body_ptr = b->getPtr();
                body_len = b->size();
                break;
            }
            case NT_STRING: {
                const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
                body_ptr = str->c_str();
                body_len = str->size();
                break;
            }
            default:
                xsink->raiseException("HTTP1-ERROR",
                    "body must be string or binary, got type '%s'",
                    body->getTypeName());
                return -1;
        }
    }

    // Get the Promise QoreObject to prevent GC (which triggers promiseDestroyed())
    QoreObject* promise_obj = const_cast<QoreObject*>(
        get_param_value(args, 4).get<const QoreObject>());

    // Create PromiseAction - caller creates with refcount 1,
    // priv->submitRequest takes ownership (stores or derefs on failure)
    PromiseAction* action = new PromiseAction(*promise, promise_obj);
    return (int)priv->submitRequest(method->c_str(), path->c_str(), headers,
        body_ptr, body_len, false, action, (int)max_streams, false, xsink);
}

//! Submits an HTTP/1.1 request with Promise + EventNotifier for poll-based delivery
/** Like submitRequest() but additionally signals @a notifier when the response
    arrives so that a continuePoll() state machine can call Future::get()
    non-blockingly - eliminating the need for a background thread.

    @param method HTTP method (GET, POST, etc.)
    @param path request path
    @param headers optional request headers (pseudo-headers are skipped)
    @param body optional request body (string or binary)
    @param promise Promise to resolve with the response
    @param notifier EventNotifier to signal after the Promise is resolved
    @param max_streams maximum concurrent streams (should be 1 for HTTP/1.1)
    @return the stream ID assigned to this request

    @since %Qore 3.0
*/
int Http1ClientPollOperationBase::submitRequestWithNotifier(string method, string path,
        *hash<auto> headers, *data body, Promise[QorePromise] promise,
        EventNotifier[QoreEventNotifier] notifier, int max_streams) [flags=NAMED_ARGS] {
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (body) {
        switch (body->getType()) {
            case NT_BINARY: {
                const BinaryNode* b = static_cast<const BinaryNode*>(body);
                body_ptr = b->getPtr();
                body_len = b->size();
                break;
            }
            case NT_STRING: {
                const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
                body_ptr = str->c_str();
                body_len = str->size();
                break;
            }
            default:
                xsink->raiseException("HTTP1-ERROR",
                    "body must be string or binary, got type '%s'",
                    body->getTypeName());
                return -1;
        }
    }

    // Get QoreObject pointers for the Promise and EventNotifier (prevent GC)
    QoreObject* promise_obj = const_cast<QoreObject*>(
        get_param_value(args, 4).get<const QoreObject>());
    QoreObject* notifier_obj = const_cast<QoreObject*>(
        get_param_value(args, 5).get<const QoreObject>());

    // Create CompositeAction: PromiseAction resolves Future, then EventNotifierAction
    // signals the notifier fd - both are pure C++, safe on the I/O thread
    AbstractAsyncAction* action = createPromiseWithNotifierAction(
        promise_obj, notifier_obj, xsink);
    if (!action) {
        return -1;
    }
    return (int)priv->submitRequest(method->c_str(), path->c_str(), headers,
        body_ptr, body_len, false, action, (int)max_streams, false, xsink);
}

//! Submits an HTTP/1.1 streaming request with Channel-based response delivery
/** @param method HTTP method (GET, POST, etc.)
    @param path request path
    @param headers optional request headers
    @param body optional request body
    @param channel Channel for incremental response delivery
    @param max_streams maximum concurrent streams
    @param streaming if True, keep the response stream open for incremental
        body delivery via @a channel (response-side streaming)
    @param body_streaming if True, the request body uses
        \c Transfer-Encoding: \c chunked and chunks are pushed
        incrementally via @ref pushSendData() (request-side streaming).
        When \c True, @a body should be empty — body bytes come from
        subsequent \c pushSendData() calls, terminated by
        \c pushSendData(NOTHING).
    @param notifier optional EventNotifier signaled after channel updates
    @param sse_install_eligible if \c True, the response \c ChannelAction is retained after
    \c end_stream so a later @ref installSseState() call can drain buffered body bytes;
    callers that do not intend to install SSE state must leave this \c False to avoid
    holding the action for the lifetime of the connection
    @return the stream ID assigned to this request

    @since %Qore 3.0
*/
int Http1ClientPollOperationBase::submitRequestStreaming(string method, string path,
        *hash<auto> headers, *data body, object channel, int max_streams,
        bool streaming = False, bool body_streaming = False,
        *EventNotifier[QoreEventNotifier] notifier,
        bool sse_install_eligible = False) [flags=NAMED_ARGS] {
    // Extract QoreChannel private data from the Channel object
    QoreChannel* ch = static_cast<QoreChannel*>(
        const_cast<QoreObject*>(channel)->getReferencedPrivateData(CID_CHANNEL, xsink));
    if (!ch) {
        if (!*xsink) {
            xsink->raiseException("CHANNEL-ERROR", "invalid Channel object");
        }
        return -1;
    }
    ReferenceHolder<QoreChannel> ch_holder(ch, xsink);

    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (body) {
        switch (body->getType()) {
            case NT_BINARY: {
                const BinaryNode* b = static_cast<const BinaryNode*>(body);
                body_ptr = b->getPtr();
                body_len = b->size();
                break;
            }
            case NT_STRING: {
                const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
                body_ptr = str->c_str();
                body_len = str->size();
                break;
            }
            default:
                xsink->raiseException("HTTP1-ERROR",
                    "body must be string or binary, got type '%s'",
                    body->getTypeName());
                return -1;
        }
    }

    QoreEventNotifier* notifier_ptr = nullptr;
    QoreObject* notifier_obj_ptr = nullptr;
    if (notifier) {
        notifier_ptr = notifier.release();
        notifier_obj_ptr = const_cast<QoreObject*>(obj_notifier);
    }

    // Create ChannelAction - priv takes ownership
    ChannelAction* action = new ChannelAction(ch, notifier_ptr, notifier_obj_ptr);
    if (sse_install_eligible) {
        action->setSseInstallEligible();
    }
    if (notifier_ptr) {
        notifier_ptr->deref(xsink);
    }
    return (int)priv->submitRequest(method->c_str(), path->c_str(), headers,
        body_ptr, body_len, streaming, action, (int)max_streams,
        body_streaming, xsink);
}

//! Pushes a request-body chunk on a streaming-send request
/** Used after @ref submitRequestStreaming() with \c body_streaming = \c True
    to feed the chunked request body incrementally.  Each call appends one
    chunk; pass \c NOTHING (or no argument) to signal end-of-stream — the
    poll op writes the final \c "0\\r\\n" terminator (plus any trailers
    set via @ref setTrailers) and transitions to the response-receiving
    phase.

    Thread-safe — may be called from any thread.

    @param data the chunk to send (string or binary); pass \c NOTHING to
        signal end-of-stream

    @since %Qore 3.0
*/
nothing Http1ClientPollOperationBase::pushSendData(*data data) [flags=NAMED_ARGS] {
    if (!data) {
        // EOF sentinel
        priv->pushSendData(nullptr, xsink);
        return QoreValue();
    }
    if (data->getType() == NT_STRING) {
        priv->pushSendData(static_cast<const QoreStringNode*>(data), xsink);
        return QoreValue();
    }
    // NT_BINARY: wrap raw bytes in a QoreStringNode (no transcoding —
    // the priv only emits bytes, doesn't reinterpret encoding).
    const BinaryNode* b = static_cast<const BinaryNode*>(data);
    SimpleRefHolder<QoreStringNode> str(
        new QoreStringNode(static_cast<const char*>(b->getPtr()),
            b->size(), QCS_DEFAULT));
    priv->pushSendData(*str, xsink);
}

//! Sets HTTP/1.1 chunked-transfer trailers for a streaming-send request
/** Trailers are emitted after the final \c "0\\r\\n" chunk terminator
    when @ref pushSendData() receives the \c NOTHING end-of-stream
    sentinel.  Each call replaces any previously-set trailers.

    @param trailers map of trailer header name to value; pass \c NOTHING
        to clear

    @since %Qore 3.0
*/
nothing Http1ClientPollOperationBase::setTrailers(*hash<string, string> trailers) [flags=NAMED_ARGS] {
    priv->setTrailers(trailers, xsink);
}

//! Submits an HTTP/1.1 SSE request with Queue-based parsed event delivery
/** Like submitRequestStreaming() but creates an SseAction that parses SSE events
    on the I/O thread and pushes parsed SseMessageInfo hashes to a Queue.

    @param method HTTP method (GET, POST, etc.)
    @param path request path
    @param headers optional request headers
    @param body optional request body
    @param queue Queue for parsed SSE event delivery
    @param max_streams maximum concurrent streams
    @param notifier optional EventNotifier signaled after queue updates

    @return the stream ID assigned to this request

    @since %Qore 3.0
*/
int Http1ClientPollOperationBase::submitRequestSse(string method, string path,
        *hash<auto> headers, *data body, Queue[Queue] queue, int max_streams,
        *EventNotifier[QoreEventNotifier] notifier) [flags=NAMED_ARGS] {
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (body) {
        switch (body->getType()) {
            case NT_BINARY: {
                const BinaryNode* b = static_cast<const BinaryNode*>(body);
                body_ptr = b->getPtr();
                body_len = b->size();
                break;
            }
            case NT_STRING: {
                const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
                body_ptr = str->c_str();
                body_len = str->size();
                break;
            }
            default:
                xsink->raiseException("HTTP1-ERROR",
                    "body must be string or binary, got type '%s'",
                    body->getTypeName());
                return -1;
        }
    }

    QoreEventNotifier* notifier_ptr = nullptr;
    QoreObject* notifier_obj_ptr = nullptr;
    if (notifier) {
        notifier_ptr = notifier.release();
        notifier_obj_ptr = const_cast<QoreObject*>(obj_notifier);
    }

    // Create SseAction - priv takes ownership; release from QPP holder
    Queue* queue_ptr = queue.release();
    SseAction* action = new SseAction(queue_ptr, notifier_ptr, notifier_obj_ptr);
    queue_ptr->deref(xsink);  // SseAction refs the queue itself
    if (notifier_ptr) {
        notifier_ptr->deref(xsink);  // SseAction refs the notifier itself
    }
    return (int)priv->submitRequest(method->c_str(), path->c_str(), headers,
        body_ptr, body_len, true, action, (int)max_streams, false, xsink);
}

//! Cancel a stream
/** @param stream_id the stream to cancel
    @return True if the stream was found and cancelled
*/
bool Http1ClientPollOperationBase::cancelStream(int stream_id) [flags=NAMED_ARGS] {
    return priv->cancelStream(stream_id, xsink);
}

//! Installs an SSE parser on an active ChannelAction stream
/** @param stream_id the active stream
    @param queue Queue for parsed SSE event delivery
    @param notifier optional EventNotifier signaled after queue updates
    @param initial_body optional body bytes already received before installing
        the SSE parser

    @since %Qore 3.0
*/
nothing Http1ClientPollOperationBase::installSseState(int stream_id, Queue[Queue] queue,
        *EventNotifier[QoreEventNotifier] notifier, *data initial_body) [flags=NAMED_ARGS] {
    QoreEventNotifier* notifier_ptr = nullptr;
    QoreObject* notifier_obj_ptr = nullptr;
    if (notifier) {
        notifier_ptr = notifier.release();
        notifier_obj_ptr = const_cast<QoreObject*>(obj_notifier);
    }
    Queue* queue_ptr = queue.release();
    QoreValue initial;
    if (initial_body) {
        ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
        h->setKeyValue("body", initial_body->refSelf(), xsink);
        if (*xsink) {
            queue_ptr->deref(xsink);
            if (notifier_ptr) {
                notifier_ptr->deref(xsink);
            }
            return QoreValue();
        }
        initial = h.release();
    }
    priv->installSseState(stream_id, queue_ptr, notifier_ptr, notifier_obj_ptr,
        initial, xsink);
    queue_ptr->deref(xsink);
    if (notifier_ptr) {
        notifier_ptr->deref(xsink);
    }
}

//! Returns the socket object
/** @return the socket
*/
Socket Http1ClientPollOperationBase::getSocket() [flags=RET_VALUE_ONLY] {
    return self->getReferencedMemberNoMethod("sock", xsink);
}
