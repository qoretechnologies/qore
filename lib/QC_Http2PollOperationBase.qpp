#include "qore/Qore.h"
#include "qore/intern/QC_Http2PollOperationBase.h"
#include "qore/intern/QC_SocketPollOperationBase.h"
#include "qore/intern/QC_SocketPollOperation.h"
#include "qore/intern/QC_Socket.h"
#include "qore/QoreQueue.h"
#include "qore/intern/QoreEventNotifier.h"
#include "qore/intern/WebSocketStreamFrameState.h"
#include "qore/intern/QoreAsyncIoLogger.h"

// Forward declarations for EventNotifier QPP type references
extern QoreClass* QC_EVENTNOTIFIER;

/** @cond INTERNAL */

// ============================================================
// Http2PollOperationPriv implementation
// ============================================================

Http2PollOperationPriv::Http2PollOperationPriv(QoreObject* self, QoreSocketObject* sock,
        SocketPollOperationBase* initial_op, QoreObject* initial_op_obj, bool headers_only)
    : SocketPollOperationBase(self),
      sock(sock),
      current_op(initial_op),
      current_op_obj(initial_op_obj),
      request(nullptr),
      error_info(nullptr),
      h2_state(H2ServerState::READING),
      headers_only(headers_only),
      request_pending(false),
      keep_alive(true),
      empty_read_count(0) {
    // sock, initial_op, initial_op_obj are already ref'd by the QPP caller
}

Http2PollOperationPriv::~Http2PollOperationPriv() {
    if (sock || current_op || current_op_obj || request || error_info
            || !stream_queues.empty()) {
        ExceptionSink xsink;
        cleanup(&xsink);
    }
}

bool Http2PollOperationPriv::goalReached() const {
    return h2_state == H2ServerState::REQUEST_READY
        || h2_state == H2ServerState::SENT;
}

QoreHashNode* Http2PollOperationPriv::continuePoll(ExceptionSink* xsink) {
    AutoLocker al(op_lock);

    while (true) {
        switch (h2_state) {
            case H2ServerState::INIT:
            case H2ServerState::READING:
            case H2ServerState::WAIT_READ:
                return continueReadPoll(xsink);

            case H2ServerState::SENDING:
                return continueSendPoll(xsink);

            case H2ServerState::REQUEST_READY:
            case H2ServerState::SENT:
            case H2ServerState::CLOSED:
                return nullptr;
        }
    }
    return nullptr;
}

void Http2PollOperationPriv::abort(ExceptionSink* xsink) {
    // abort() is the cancellation entry point for an in-flight operation: it is
    // invoked by program destruction (AsyncIoControllerPriv::cancelByProgram()
    // → DT_ABORT, fired from qore_program_private cleanup before the program's
    // namespace/class data is cleared), by HttpServer stop(), and by
    // per-connection close/idle teardown.  The persistent-session close-delivery
    // binding (a Queue + its wrapper QoreObject ref) must be released HERE,
    // while the program owning the queued objects' class/closure data is still
    // valid.  Deferring it to ~cleanup() (the destructor path) is unsafe: the op
    // object can outlive the cancel (pinned by the dedicated handler thread's
    // deregister closure or the controller's connection map), so the deferred
    // deref runs a Qore destructor over freed program code → SIGSEGV.
    Queue* q;
    QoreObject* qobj;
    {
        AutoLocker al(op_lock);
        if (current_op) {
            current_op->abort(xsink);
        }
        clearStreamQueues(xsink);
        // Capture + clear the binding under op_lock; deref below after releasing
        // it (op_lock is non-recursive — mirrors deregisterPersistentSessionQueue()).
        q = persistent_session_queue;
        qobj = persistent_session_queue_obj;
        persistent_session_queue = nullptr;
        persistent_session_queue_obj = nullptr;
        h2_state = H2ServerState::CLOSED;
    }
    // Idempotent with the dedicated handler's own later deregister and ~cleanup()
    // (both find the binding already null).
    if (q) {
        q->deref(xsink);
    }
    if (qobj) {
        qobj->deref(xsink);
    }
}

QoreValue Http2PollOperationPriv::getOutput() const {
    AutoLocker al(op_lock);
    // Clear the pending flag — getOutput() is the dispatch callback's
    // entry point, so the request is now being processed (or was never set).
    request_pending = false;
    if (request) {
        request->ref();
        return request;
    }
    return QoreValue();
}

void Http2PollOperationPriv::injectSendOp(SocketPollOperationBase* send_op, QoreObject* send_op_obj,
        ExceptionSink* xsink) {
    AutoLocker al(op_lock);
    if (h2_state != H2ServerState::REQUEST_READY && h2_state != H2ServerState::SENT) {
        xsink->raiseException("HTTP2-STATE-ERROR",
            "cannot send response in state: '%s'", getH2State());
        // Caller retains ownership of send_op/send_op_obj on error — they must deref
        return;
    }

    releaseCurrentOp(xsink);
    current_op = send_op;
    current_op_obj = send_op_obj;
    h2_state = H2ServerState::SENDING;
}

void Http2PollOperationPriv::injectReadOp(SocketPollOperationBase* read_op, QoreObject* read_op_obj,
        ExceptionSink* xsink) {
    AutoLocker al(op_lock);
    if (h2_state != H2ServerState::SENT && h2_state != H2ServerState::REQUEST_READY) {
        xsink->raiseException("HTTP2-STATE-ERROR",
            "cannot read next request in state: '%s'", getH2State());
        return;
    }

    if (request) {
        request->deref(xsink);
        request = nullptr;
    }

    releaseCurrentOp(xsink);
    current_op = read_op;
    current_op_obj = read_op_obj;
    h2_state = H2ServerState::READING;
}

void Http2PollOperationPriv::continueReading(ExceptionSink* xsink) {
    AutoLocker al(op_lock);
    if (h2_state == H2ServerState::REQUEST_READY && request_pending) {
        // A request was found by continuePoll() but not yet consumed by
        // getOutput().  A handler thread (via resumeMultiplexedReading) is
        // racing with the I/O controller's dispatch callback.
        xsink->raiseException("HTTP2-STATE-ERROR",
            "cannot continue reading: request pending dispatch");
        return;
    }
    if (h2_state != H2ServerState::REQUEST_READY) {
        xsink->raiseException("HTTP2-STATE-ERROR",
            "cannot continue reading in state: '%s'", getH2State());
        return;
    }
    if (request) {
        request->deref(xsink);
        request = nullptr;
    }
    request_pending = false;
    empty_read_count = 0;
    h2_state = H2ServerState::READING;
}

void Http2PollOperationPriv::cleanup(ExceptionSink* xsink) {
    releaseCurrentOp(xsink);
    clearStreamQueues(xsink);
    deregisterPersistentSessionQueue(xsink);

    if (request) {
        request->deref(xsink);
        request = nullptr;
    }
    if (error_info) {
        error_info->deref(xsink);
        error_info = nullptr;
    }
    if (sock) {
        sock->deref(xsink);
        sock = nullptr;
    }
}

const char* Http2PollOperationPriv::getStateImpl() const {
    return getH2State();
}

void Http2PollOperationPriv::releaseCurrentOp(ExceptionSink* xsink) {
    if (current_op) {
        // current_op was obtained via getReferencedPrivateData() which adds
        // an independent ref — must deref it separately from the QoreObject
        current_op->deref(xsink);
        current_op = nullptr;
    }
    if (current_op_obj) {
        current_op_obj->deref(xsink);
        current_op_obj = nullptr;
    }
}

QoreHashNode* Http2PollOperationPriv::continueReadPoll(ExceptionSink* xsink) {
    // Handle WAIT_READ: start fresh from the existing inner op
    if (h2_state == H2ServerState::WAIT_READ) {
        h2_state = H2ServerState::READING;
        // Fall through to drive the inner op
    }

    if (!current_op) {
        h2_state = H2ServerState::CLOSED;
        return nullptr;
    }

    QoreHashNode* poll_info = current_op->continuePoll(xsink);
    if (*xsink) {
        // Store the error info from xsink for later inspection via hasError()/getError()
        error_info = new QoreHashNode(autoTypeInfo);
        const QoreValue err_val = xsink->getExceptionErr();
        if (err_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper err(err_val);
            error_info->setKeyValue("err",
                err.getReferencedValue(), xsink);
        }
        const QoreValue desc_val = xsink->getExceptionDesc();
        if (desc_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper desc(desc_val);
            error_info->setKeyValue("desc",
                desc.getReferencedValue(), xsink);
        }
        // Push NOTHING sentinels to all registered stream Queues on error
        ExceptionSink clear_xsink;
        clearStreamQueues(&clear_xsink);
        h2_state = H2ServerState::CLOSED;
        return nullptr;
    }

    // Drain registered CONNECT stream queues after every read poll cycle.
    // The inner op may have processed DATA frames for CONNECT streams that
    // need to be delivered to handler threads via their registered Queues.
    drainStreamQueues(xsink);
    if (*xsink) {
        h2_state = H2ServerState::CLOSED;
        return nullptr;
    }

    // Release a persistent dedicated handler thread if the client abandoned a
    // stream on this still-open connection (peer RST_STREAM) — see issue #5339.
    deliverPersistentSessionClose(xsink);
    if (*xsink) {
        h2_state = H2ServerState::CLOSED;
        return nullptr;
    }

    int flush_events = 0;

    // Flush pending outgoing data (responses queued by handler threads via
    // sendHttp2StreamData → nghttp2_session_resume_data).  Without this,
    // WebSocket responses sit in the nghttp2 session buffer and never reach
    // the client — the read poll cycle only reads, it doesn't write.
    {
        int srv = sock->flushHttp2PendingDataForAsyncPoll(xsink);
        if (*xsink) {
            h2_state = H2ServerState::CLOSED;
            return nullptr;
        }
        if (srv < 0) {
            xsink->raiseException("HTTP2-FLUSH-ERROR", "error flushing pending HTTP/2 data");
            h2_state = H2ServerState::CLOSED;
            return nullptr;
        }
        // sendPendingData returns SOCK_POLLIN / SOCK_POLLOUT when the
        // non-blocking flush needs another readiness event.
        flush_events = srv & (SOCK_POLLIN | SOCK_POLLOUT);
        if (flush_events && poll_info) {
            QoreHashNode* pi = poll_info;
            int events = pi->getKeyValue("events").getAsBigInt();
            pi->setKeyValue("events", events | flush_events, xsink);
            if (*xsink) {
                h2_state = H2ServerState::CLOSED;
                return nullptr;
            }
        }
    }

    if (poll_info) {
        // Inner op needs more polling
        return poll_info;
    }

    // Read complete
    if (current_op->goalReached()) {
        QoreValue output = current_op->getOutput();
        if (output.getType() == NT_HASH) {
            request = output.get<QoreHashNode>();
        } else {
            output.discard(xsink);
            request = nullptr;
        }

        if (request) {
            empty_read_count = 0;
            request_pending = true;
            h2_state = H2ServerState::REQUEST_READY;
            return nullptr;
        }

        // goalReached but no request: HTTP/2 control frames were processed
        // (WINDOW_UPDATE, PING, SETTINGS ACK, etc.) without a new request.
        // Wait for new socket data before retrying.
        ++empty_read_count;
        if (empty_read_count > MAX_EMPTY_READS) {
            error_info = new QoreHashNode(autoTypeInfo);
            error_info->setKeyValue("err",
                new QoreStringNode("HTTP2-EMPTY-READ"), xsink);
            QoreStringNode* desc = new QoreStringNode;
            desc->sprintf("max consecutive empty reads (%d) exceeded", MAX_EMPTY_READS);
            error_info->setKeyValue("desc", desc, xsink);
            h2_state = H2ServerState::CLOSED;
            return nullptr;
        }
        h2_state = H2ServerState::WAIT_READ;

        // Return POLLIN on the socket to wait for new data, and preserve any
        // readiness needed by the pending outbound flush.
        return getSocketPollInfoHash(xsink, SOCK_POLLIN | flush_events);
    }

    // Operation failed (goal not reached and returned nullptr — peer closed TCP)
    // Push NOTHING sentinels to all registered stream Queues so handler threads
    // (e.g., WebSocketStreamProcessor) wake up and detect the closure.
    // Without this, handler threads block on Counter::waitForZero() forever because
    // nghttp2 doesn't know about TCP closure (it only sees HTTP/2 frames).
    clearStreamQueues(xsink);
    h2_state = H2ServerState::CLOSED;
    return nullptr;
}

QoreHashNode* Http2PollOperationPriv::continueSendPoll(ExceptionSink* xsink) {
    if (!current_op) {
        h2_state = H2ServerState::CLOSED;
        return nullptr;
    }

    QoreHashNode* poll_info = current_op->continuePoll(xsink);
    if (*xsink) {
        // Store the error info from xsink for later inspection via hasError()/getError()
        error_info = new QoreHashNode(autoTypeInfo);
        const QoreValue err_val = xsink->getExceptionErr();
        if (err_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper err(err_val);
            error_info->setKeyValue("err",
                err.getReferencedValue(), xsink);
        }
        const QoreValue desc_val = xsink->getExceptionDesc();
        if (desc_val.getType() == NT_STRING) {
            QoreStringNodeValueHelper desc(desc_val);
            error_info->setKeyValue("desc",
                desc.getReferencedValue(), xsink);
        }
        h2_state = H2ServerState::CLOSED;
        return nullptr;
    }

    if (poll_info) {
        // Inner op needs more polling
        return poll_info;
    }

    // Send complete
    if (current_op->goalReached()) {
        h2_state = H2ServerState::SENT;
        return nullptr;
    }

    // Operation failed
    h2_state = H2ServerState::CLOSED;
    return nullptr;
}

void Http2PollOperationPriv::registerStreamQueue(int32_t stream_id, Queue* queue,
        QoreObject* queue_obj, QoreEventNotifier* notifier, QoreObject* notifier_obj) {
    // Push to pending queue (sq_lock only — never held during I/O).
    // The pending entry is applied to stream_queues at the start of the
    // next drainStreamQueues() call on the I/O thread, which is the single
    // source of truth for body delivery: it drains buffered DATA via
    // takeStreamData() and pushes a NOTHING sentinel when the stream is
    // remote-closed.
    //
    // We intentionally do NOT drain via takeStreamData() here on the
    // caller (worker) thread.  Doing so created a dual-drain race:
    //   - the worker submits a takeStreamData poll op (runs on I/O thread)
    //     to extract any already-buffered DATA, pushing chunks to `queue`.
    //   - the I/O thread later runs drainStreamQueues() which iterates
    //     stream_queues and again calls takeStreamData (now empty) before
    //     pushing the NOTHING sentinel.
    // Whichever path drains the data wins, but the timing depended on
    // controller scheduling; under load a worker poll op could complete
    // *after* drainStreamQueues had already pushed NOTHING and erased
    // the stream_queues entry, so the worker's chunks were pushed to a
    // queue that the handler thread had already stopped reading (it had
    // received the NOTHING sentinel and exited the read loop with an
    // empty body).  This manifested as a silent HTTP/2 POST → 204 No
    // Content for non-zero Content-Length requests on Alpine ARM64 CI
    // (HttpServer.qtest asyncModeHttp2Test "HTTP/2 POST 50000 bytes" job
    // 174122, develop @ 7c6e45674).
    //
    // The caller (HttpServerAsyncIo register_body_queue closure) calls
    // resumeMultiplexedReading() after this returns, which submits the
    // h2op to the controller; the next continueReadPoll cycle then drains
    // any buffered DATA into the queue and pushes NOTHING on END_STREAM.
    {
        AutoLocker al(sq_lock);
        // Race with shutdown: HttpServer.stop() → asyncIo.stop() iterates
        // active connections and calls abort() on each stream_op → C++
        // Http2PollOperationPriv::abort() → clearStreamQueues() which sets
        // @c stream_queues_closed=true under sq_lock.  An in-flight handler
        // thread that reaches register_body_queue (here) AFTER that point
        // would otherwise leave its Queue stranded in
        // pending_stream_registrations — no I/O thread will drain it, so
        // the handler's body_queue.get(30s) blocks the full body-read
        // timeout and HttpServer.stop() waits 30s for the handler_pool to
        // drain.  Push the NOTHING sentinel directly to the caller's Queue
        // so the handler unblocks immediately and exits with an empty body
        // (the subsequent submitHttp2Response will fail cleanly with
        // HTTP2-ERROR: no HTTP/2 session active — the connection is gone).
        if (stream_queues_closed) {
            queue->push(nullptr, QoreValue());
            if (notifier) {
                notifier->notify();
            }
            queue->deref(nullptr);
            queue_obj->deref(nullptr);
            if (notifier) {
                notifier->deref(nullptr);
            }
            if (notifier_obj) {
                notifier_obj->deref(nullptr);
            }
            return;
        }
        pending_stream_registrations.push_back({stream_id, {queue, queue_obj, notifier, notifier_obj, {}}});
    }

    // Wake the I/O thread so it picks up the pending registration on its
    // next continueReadPoll cycle (resume happens via the caller; this
    // wake only matters when the h2op is already active for unrelated
    // reasons, e.g. another stream's I/O is in flight).
    ExceptionSink wake_xsink;
    wakeIoThread(&wake_xsink);
}

void Http2PollOperationPriv::registerStreamFrameState(int32_t stream_id, Queue* queue,
        QoreObject* queue_obj) {
    // Send callback runs on the I/O thread (from frame_state->feedData()
    // inside drainStreamQueues).  nghttp2 queues the DATA frame; the surrounding
    // continueReadPoll() flushes pending data via flushHttp2PendingDataForAsyncPoll() after
    // drainStreamQueues returns.  `sock` outlives this priv and the frame_state.
    QoreSocketObject* sock_ptr = sock;
    WebSocketStreamFrameState::SendCallback send_cb =
        [sock_ptr, stream_id](BinaryNode* frame_bytes) {
            if (!frame_bytes) {
                return;
            }
            SimpleRefHolder<BinaryNode> holder(frame_bytes);
            ExceptionSink cxsink;
            int rv = sock_ptr->sendHttp2StreamDataForAsyncPoll(stream_id, *holder, false, &cxsink);
            if (cxsink || rv < 0) {
                // Non-fatal: transport teardown handles the close path.
                cxsink.clear();
            }
        };

    // The frame_state constructor takes ONE reference of `queue`; it derefs
    // it in its destructor.  queue_obj is kept in StreamQueueInfo as a DGC
    // anchor for the Qore wrapper and is derefed separately by cleanup.
    auto frame_state = std::make_shared<WebSocketStreamFrameState>(
        queue, std::move(send_cb), /* is_server */ true);

    StreamQueueInfo info;
    info.queue = queue;
    info.queue_obj = queue_obj;
    info.notifier = nullptr;
    info.notifier_obj = nullptr;
    info.frame_state = frame_state;

    {
        AutoLocker al(sq_lock);
        // See registerStreamQueue for the shutdown-race rationale.  Same race
        // here for WS-CONNECT tunnels: if asyncIo.stop() ran before this
        // handler thread reached us, push CLOSE-sentinel and skip enqueue.
        if (stream_queues_closed) {
            frame_state->pushCloseSentinel();
            // The frame_state owns the one queue reference taken above, so it
            // releases it on destruction.  queue_obj is held separately for
            // DGC; deref it here since we never installed the StreamQueueInfo.
            queue_obj->deref(nullptr);
            return;
        }
        pending_stream_registrations.push_back({stream_id, info});
    }

    // Drain any bytes already buffered in the H2 session for this stream
    // directly into the frame state so we don't lose pre-registration data.
    ExceptionSink xsink;
    while (true) {
        BinaryNode* data = sock->readHttp2StreamDataForAsyncPoll(stream_id, 0, &xsink);
        if (xsink) {
            xsink.clear();
            break;
        }
        if (!data || data->empty()) {
            if (data) {
                data->deref(&xsink);
            }
            break;
        }
        frame_state->feedData(data->getPtr(), data->size());
        data->deref(&xsink);
    }

    // Wake the I/O thread so it applies the pending registration
    ExceptionSink wake_xsink;
    wakeIoThread(&wake_xsink);
}

void Http2PollOperationPriv::registerPersistentSessionQueue(Queue* queue, QoreObject* queue_obj,
        ExceptionSink* xsink) {
    AutoLocker al(op_lock);
    // Replace any previous binding (one persistent session per H2 connection).
    if (persistent_session_queue) {
        persistent_session_queue->deref(xsink);
    }
    if (persistent_session_queue_obj) {
        persistent_session_queue_obj->deref(xsink);
    }
    persistent_session_queue = queue;
    persistent_session_queue_obj = queue_obj;
}

void Http2PollOperationPriv::deregisterPersistentSessionQueue(ExceptionSink* xsink) {
    Queue* q;
    QoreObject* qobj;
    {
        AutoLocker al(op_lock);
        q = persistent_session_queue;
        qobj = persistent_session_queue_obj;
        persistent_session_queue = nullptr;
        persistent_session_queue_obj = nullptr;
    }
    if (q) {
        q->deref(xsink);
    }
    if (qobj) {
        qobj->deref(xsink);
    }
}

void Http2PollOperationPriv::deliverPersistentSessionClose(ExceptionSink* xsink) {
    // I/O thread: if the peer reset any stream this cycle, release the
    // persistent dedicated handler thread bound to this connection by pushing a
    // {"type":"close"} hash to its Queue.  One persistent session per H2
    // connection, so any reset abandons it.  The dedicated loop's teardown then
    // runs on the binding thread.
    //
    // NOTE: called from continuePoll() which already holds op_lock, so this
    // method must NOT re-acquire it (op_lock is non-recursive).  register /
    // deregister run on other threads under op_lock, so they are excluded for
    // the duration of this access.
    std::vector<int32_t> resets = sock->takeHttp2PeerResetReportsForAsyncPoll();
    if (resets.empty()) {
        return;
    }
    if (!persistent_session_queue) {
        return;
    }
    // Take ownership of the held refs (clear the binding so a duplicate event
    // does not double-deliver and the dedicated loop's deregister is a no-op).
    Queue* q = persistent_session_queue;
    QoreObject* qobj = persistent_session_queue_obj;
    persistent_session_queue = nullptr;
    persistent_session_queue_obj = nullptr;
    ASYNC_IO_TRACE("Http2PollOperationPriv::deliverPersistentSessionClose "
        "pushing persistent close after %zu peer reset(s)\n", resets.size());
    ReferenceHolder<QoreHashNode> close_entry(new QoreHashNode(autoTypeInfo), xsink);
    close_entry->setKeyValue("type", new QoreStringNode("close"), xsink);
    if (!*xsink) {
        // Queue::push takes the ref on success; on error the caller derefs
        // (mirrors drainStreamQueues()).
        QoreHashNode* entry = close_entry.release();
        q->push(xsink, entry);
        if (*xsink) {
            entry->deref(xsink);
        }
    }
    q->deref(xsink);
    if (qobj) {
        qobj->deref(xsink);
    }
}

void Http2PollOperationPriv::drainStreamQueues(ExceptionSink* xsink) {
    // Apply pending registrations from app threads
    {
        AutoLocker al(sq_lock);
        for (auto& [sid, info] : pending_stream_registrations) {
            auto it = stream_queues.find(sid);
            if (it != stream_queues.end()) {
                if (it->second.notifier && it->second.notifier != info.notifier) {
                    it->second.notifier->deref(xsink);
                }
                if (it->second.notifier_obj && it->second.notifier_obj != info.notifier_obj) {
                    it->second.notifier_obj->deref(xsink);
                }
                if (it->second.queue != info.queue) {
                    it->second.queue->deref(xsink);
                }
                if (it->second.queue_obj != info.queue_obj) {
                    it->second.queue_obj->deref(xsink);
                }
                it->second = info;
            } else {
                stream_queues[sid] = info;
            }
        }
        pending_stream_registrations.clear();
    }

    if (stream_queues.empty()) {
        return;
    }

    std::vector<int32_t> completed;
    for (auto& [stream_id, info] : stream_queues) {
        // Drain all available data from the per-stream buffer
        int drain_count = 0;
        while (true) {
            BinaryNode* data = sock->readHttp2StreamDataForAsyncPoll(stream_id, 0, xsink);
            if (*xsink) {
                return;
            }
            if (!data) {
                break;
            }
            if (data->empty()) {
                data->deref(xsink);
                break;
            }
            if (info.frame_state) {
                // Frame-state fast path: feed raw bytes to the C++ frame
                // decoder, which pushes typed message hashes to info.queue
                // as complete WS messages are reassembled.  The send
                // callback may enqueue control-frame responses via the
                // async-poll send helper; the enclosing continueReadPoll()
                // will flush pending data after drainStreamQueues returns.
                int pushed = info.frame_state->feedData(data->getPtr(), data->size());
                drain_count += pushed;
                data->deref(xsink);
                if (*xsink) {
                    return;
                }
            } else {
                ++drain_count;
                info.queue->push(xsink, data);
                if (*xsink) {
                    data->deref(xsink);
                    return;
                }
            }
        }

        // Track that this stream had data drained — the controller will
        // dispatch onStreamData() to the worker pool after continuePoll returns
        if (drain_count > 0) {
            data_ready_streams.push_back(stream_id);
        }

        // Check stream closure (remote END_STREAM or RST_STREAM/GOAWAY)
        // Also check socket-level closure: for CONNECT streams (WebSocket tunnels),
        // nghttp2 doesn't detect TCP closure — it only processes HTTP/2 frames.
        // When the peer drops the TCP connection, the socket becomes closed but
        // the HTTP/2 stream state in nghttp2 remains unchanged.
        if (sock->isHttp2StreamRemoteClosedForAsyncPoll(stream_id)
                || sock->isHttp2StreamClosedForAsyncPoll(stream_id)
                || !sock->isOpen()) {
            // Push NOTHING sentinel so the handler thread knows the stream is done
            info.queue->push(xsink, QoreValue());
            if (*xsink) {
                return;
            }
            // Also mark as data-ready so the handler wakes up for the sentinel
            if (std::find(data_ready_streams.begin(), data_ready_streams.end(),
                    stream_id) == data_ready_streams.end()) {
                data_ready_streams.push_back(stream_id);
            }
            completed.push_back(stream_id);
        }
    }

    // Remove completed streams and deref their objects
    for (int32_t sid : completed) {
        auto it = stream_queues.find(sid);
        if (it != stream_queues.end()) {
            // In frame-state mode the Queue ref is owned by the frame state
            // (its destructor derefs it when the shared_ptr drops).  Skip the
            // direct Queue deref to avoid a double-free.
            if (!it->second.frame_state) {
                it->second.queue->deref(xsink);
            }
            it->second.queue_obj->deref(xsink);
            if (it->second.notifier) {
                it->second.notifier->deref(xsink);
            }
            if (it->second.notifier_obj) {
                it->second.notifier_obj->deref(xsink);
            }
            stream_queues.erase(it);
        }
    }
}

void Http2PollOperationPriv::clearStreamQueues(ExceptionSink* xsink) {
    // Drain pending registrations so we clean up everything.  Set
    // @c stream_queues_closed under sq_lock so any concurrent
    // registerStreamQueue / registerStreamFrameState call from a handler
    // thread observes it and short-circuits to a NOTHING sentinel — see
    // those methods for the shutdown-race rationale.
    {
        AutoLocker al(sq_lock);
        stream_queues_closed = true;
        for (auto& [sid, info] : pending_stream_registrations) {
            stream_queues[sid] = info;
        }
        pending_stream_registrations.clear();
    }
    for (auto& [stream_id, info] : stream_queues) {
        // Push NOTHING sentinel so handler threads wake up and see closure
        info.queue->push(xsink, QoreValue());
        if (info.notifier) {
            info.notifier->notify();
        }
        // Deref refs — frame_state owns the Queue ref in frame-state mode
        if (!info.frame_state) {
            info.queue->deref(xsink);
        }
        info.queue_obj->deref(xsink);
        if (info.notifier) {
            info.notifier->deref(xsink);
        }
        if (info.notifier_obj) {
            info.notifier_obj->deref(xsink);
        }
    }
    stream_queues.clear();
}

/** @endcond */

//! C++ base class for HTTP/2 server-side poll operation
/** This class implements the core poll state machine for an HTTP/2 connection
    lifecycle in pure C++, enabling the AsyncIoController I/O thread to drive
    the poll without Qore interpreter overhead.

    State machine:
    - READING: delegates to inner SocketHttp2ServerPollOperation for reading requests
    - WAIT_READ: empty read (control frames only), waiting for new socket data
    - REQUEST_READY: a complete HTTP/2 request is available
    - SENDING: delegates to inner send operation (response or streaming)
    - SENT: response send completed
    - CLOSED: connection closed or fatal error

    Inner ops are injected from the Qore wrapper (Http2PollOperation) which
    creates them via Qore Socket methods (startPollReadHttp2Request,
    startPollSendHttp2Response, etc.).

    The Qore wrapper (Http2PollOperation) adds stream queue management,
    completion context, and push promise support.

    @since %Qore 3.0
*/
qclass Http2PollOperationBase [
    private_members=object sock,string goal;
    ns=Qore;
    arg=Http2PollOperationPriv* priv;
    vparent=SocketPollOperationBase<*hash<auto>>
];

//! Creates the HTTP/2 poll operation base
/** @param socket the client Socket with an established HTTP/2 connection
    @param initial_read_operation the initial read poll operation from socket.startPollReadHttp2Request()
    @param headers_only if True, dispatch requests on HEADERS (before END_STREAM)
*/
Http2PollOperationBase::constructor(Socket[QoreSocketObject] socket, object initial_read_operation,
        bool headers_only) [flags=NAMED_ARGS] {
    // Validate that initial_read_operation is a SocketPollOperationBase subclass
    const QoreClass* op_cls = initial_read_operation->getClass();
    if (!op_cls || !op_cls->getClass(CID_SOCKETPOLLOPERATIONBASE)) {
        xsink->raiseException("HTTP2POLLOPERATIONBASE-ERROR",
            "initial_read_operation must be a SocketPollOperationBase subclass");
        return;
    }

    // Extract the SocketPollOperationBase priv from the initial_read_operation
    ReferenceHolder<SocketPollOperationBase> read_priv(reinterpret_cast<SocketPollOperationBase*>(
        const_cast<QoreObject*>(initial_read_operation)->getReferencedPrivateData(
            CID_SOCKETPOLLOPERATIONBASE, xsink)), xsink);
    if (*xsink || !read_priv) {
        return;
    }
    if (read_priv->needsWorkerDispatch()) {
        xsink->raiseException("HTTP2POLLOPERATIONBASE-ERROR",
            "initial_read_operation requires worker dispatch and cannot be used by Http2PollOperationBase");
        return;
    }

    // Store socket as Qore member for DGC visibility
    QoreValue sock_arg = args->retrieveEntry(0);
    QoreObject* sock_qobj = sock_arg.getType() == NT_OBJECT
        ? const_cast<QoreObject*>(sock_arg.get<const QoreObject>()) : nullptr;
    if (sock_qobj) {
        self->setMemberValue("sock", QC_HTTP2POLLOPERATIONBASE, sock_qobj->refSelf(), xsink);
    }
    self->setMemberValue("goal", QC_HTTP2POLLOPERATIONBASE,
        new QoreStringNode("http2_connection"), xsink);

    // Ref the socket for the C++ priv
    QoreSocketObject* sock_ptr = *socket;
    sock_ptr->ref();

    // Ref the initial_read_operation QoreObject for DGC (the priv takes ownership)
    const_cast<QoreObject*>(initial_read_operation)->ref();

    self->setPrivate(CID_HTTP2POLLOPERATIONBASE,
        new Http2PollOperationPriv(self, sock_ptr, read_priv.release(),
            const_cast<QoreObject*>(initial_read_operation), headers_only));
}

//! Destroys the object
/** Releases all internal references.
*/
Http2PollOperationBase::destructor() {
    priv->cleanup(xsink);
    priv->deref(xsink);
}

//! Throws an exception; objects of this class cannot be copied
/** @throw HTTP2POLLOPERATIONBASE-COPY-ERROR objects of this class cannot be copied
*/
Http2PollOperationBase::copy() {
    xsink->raiseException("HTTP2POLLOPERATIONBASE-COPY-ERROR",
        "objects of this class cannot be copied");
}

//! Returns the goal of the operation
/** @return "http2_connection"
*/
string Http2PollOperationBase::getGoal() {
    return self->getReferencedMemberNoMethod("goal", xsink);
}

//! Returns the current state
/** @return one of "init", "reading", "wait_read", "request_ready", "sending", "sent", or "closed"
*/
string Http2PollOperationBase::getState() [flags=RET_VALUE_ONLY] {
    return priv->getState();
}

//! Returns True when a request is ready or a send is complete
/** @return True when the state is REQUEST_READY or SENT
*/
bool Http2PollOperationBase::goalReached() [flags=RET_VALUE_ONLY] {
    return priv->goalReached();
}

//! Continues the poll operation
/** @return socket poll info for the next poll cycle, or @ref nothing if polling is complete
*/
*hash<SocketPollInfo> Http2PollOperationBase::continuePoll() {
    return priv->continuePoll(xsink);
}

//! Aborts the operation
/** Aborts any inner poll operation and transitions to CLOSED state.
*/
nothing Http2PollOperationBase::abort() {
    priv->abort(xsink);
}

//! Returns the HTTP/2 request when ready
/** @return the completed request hash, or @ref nothing

    @note Acquires op_lock to synchronize with continueReading() called from
    handler threads.  Clears request_pending so that concurrent
    continueReading() calls correctly throw instead of clearing a request
    that is being dispatched.
*/
*hash<auto> Http2PollOperationBase::getOutput() [flags=RET_VALUE_ONLY] {
    return priv->getOutput();
}

//! Returns True if the connection is closed
/** @return True if the state is CLOSED
*/
bool Http2PollOperationBase::isClosed() [flags=RET_VALUE_ONLY] {
    return priv->isClosed();
}

//! Returns True if an error occurred
/** @return True if error information is available
*/
bool Http2PollOperationBase::hasError() [flags=RET_VALUE_ONLY] {
    return priv->hasError();
}

//! Returns error information if an error occurred
/** @return hash with "err" and "desc" keys, or @ref nothing
*/
*hash<auto> Http2PollOperationBase::getError() [flags=RET_VALUE_ONLY] {
    return priv->getErrorInfo();
}

//! Returns True if the connection should be kept alive
/** @return True if keep_alive is set, state is not CLOSED, and no error occurred
*/
bool Http2PollOperationBase::shouldKeepAlive() [flags=RET_VALUE_ONLY] {
    return priv->shouldKeepAlive();
}

//! Returns the current H2 state as a string
/** @return one of "init", "reading", "wait_read", "request_ready", "sending", "sent", "closed"
*/
string Http2PollOperationBase::getH2State() [flags=RET_VALUE_ONLY] {
    return new QoreStringNode(priv->getH2State());
}

//! Returns the socket being monitored
/** @return the Socket object
*/
Socket Http2PollOperationBase::getSocket() {
    return self->getReferencedMemberNoMethod("sock", xsink);
}

//! Returns True if headers-only mode is enabled
/** @return True if requests are dispatched on HEADERS before END_STREAM
*/
bool Http2PollOperationBase::isHeadersOnly() [flags=RET_VALUE_ONLY] {
    return priv->isHeadersOnly();
}

//! Injects a send operation created by the Qore wrapper
/** Called from the handler thread when starting to send a response.
    Extracts the SocketPollOperationBase priv from the QoreObject and
    stores it as the current inner operation with SENDING state.

    @param send_operation the poll operation from socket.startPollSendHttp2Response() or similar

    @throw HTTP2-STATE-ERROR if the current state does not allow sending
    @throw HTTP2POLLOPERATIONBASE-ERROR if send_operation is not a SocketPollOperationBase subclass
*/
nothing Http2PollOperationBase::injectSendOp(object send_operation) [flags=NAMED_ARGS] {
    const QoreClass* op_cls = send_operation->getClass();
    if (!op_cls || !op_cls->getClass(CID_SOCKETPOLLOPERATIONBASE)) {
        xsink->raiseException("HTTP2POLLOPERATIONBASE-ERROR",
            "send_operation must be a SocketPollOperationBase subclass");
        return QoreValue();
    }

    SocketPollOperationBase* send_priv = reinterpret_cast<SocketPollOperationBase*>(
        const_cast<QoreObject*>(send_operation)->getReferencedPrivateData(
            CID_SOCKETPOLLOPERATIONBASE, xsink));
    if (*xsink || !send_priv) {
        return QoreValue();
    }
    if (send_priv->needsWorkerDispatch()) {
        send_priv->deref(xsink);
        xsink->raiseException("HTTP2POLLOPERATIONBASE-ERROR",
            "send_operation requires worker dispatch and cannot be used by Http2PollOperationBase");
        return QoreValue();
    }

    // Ref the send_operation QoreObject for DGC before transferring ownership
    const_cast<QoreObject*>(send_operation)->ref();

    priv->injectSendOp(send_priv, const_cast<QoreObject*>(send_operation), xsink);
    if (*xsink) {
        // injectSendOp did not take ownership on error; deref what we ref'd
        send_priv->deref(xsink);
        const_cast<QoreObject*>(send_operation)->deref(xsink);
    }
}

//! Injects a read operation created by the Qore wrapper
/** Called from the handler thread when starting to read the next request.
    Extracts the SocketPollOperationBase priv from the QoreObject and
    stores it as the current inner operation with READING state.

    @param read_operation the poll operation from socket.startPollReadHttp2Request()

    @throw HTTP2-STATE-ERROR if the current state does not allow reading
    @throw HTTP2POLLOPERATIONBASE-ERROR if read_operation is not a SocketPollOperationBase subclass
*/
nothing Http2PollOperationBase::injectReadOp(object read_operation) [flags=NAMED_ARGS] {
    const QoreClass* op_cls = read_operation->getClass();
    if (!op_cls || !op_cls->getClass(CID_SOCKETPOLLOPERATIONBASE)) {
        xsink->raiseException("HTTP2POLLOPERATIONBASE-ERROR",
            "read_operation must be a SocketPollOperationBase subclass");
        return QoreValue();
    }

    SocketPollOperationBase* read_priv = reinterpret_cast<SocketPollOperationBase*>(
        const_cast<QoreObject*>(read_operation)->getReferencedPrivateData(
            CID_SOCKETPOLLOPERATIONBASE, xsink));
    if (*xsink || !read_priv) {
        return QoreValue();
    }
    if (read_priv->needsWorkerDispatch()) {
        read_priv->deref(xsink);
        xsink->raiseException("HTTP2POLLOPERATIONBASE-ERROR",
            "read_operation requires worker dispatch and cannot be used by Http2PollOperationBase");
        return QoreValue();
    }

    // Ref the read_operation QoreObject for DGC before transferring ownership
    const_cast<QoreObject*>(read_operation)->ref();

    priv->injectReadOp(read_priv, const_cast<QoreObject*>(read_operation), xsink);
    if (*xsink) {
        // injectReadOp did not take ownership on error; deref what we ref'd
        read_priv->deref(xsink);
        const_cast<QoreObject*>(read_operation)->deref(xsink);
    }
}

//! Continues reading without creating a new read operation
/** Called from the handler thread after a request has been dispatched in
    multiplexing mode.  The same underlying SocketHttp2ServerPollOperation
    continues reading frames.

    @throw HTTP2-STATE-ERROR if the current state does not allow continuing to read,
    or if a request is pending dispatch
*/
nothing Http2PollOperationBase::continueReading() {
    priv->continueReading(xsink);
}

//! Registers a Queue and optional EventNotifier for a CONNECT stream
/** Called from the Qore wrapper when dispatching an extended CONNECT handler.
    The Queue is used for non-blocking data delivery from the I/O thread to
    handler threads.  The EventNotifier (if provided) is signaled after data
    is pushed to the Queue, enabling efficient cross-thread wake-up without
    Qore interpreter calls.

    @param stream_id the HTTP/2 stream ID
    @param queue the Queue for data delivery (unlimited)
    @param notifier optional EventNotifier for cross-thread wake-up

    @note Must be called on the I/O controller thread before the handler starts reading.

    @since %Qore 3.0
*/
nothing Http2PollOperationBase::registerStreamQueue(int stream_id,
        Queue[Queue] queue, *EventNotifier[QoreEventNotifier] notifier) [flags=NAMED_ARGS] {
    // Transfer the Queue ref from the ReferenceHolder to the C++ priv
    Queue* queue_ptr = queue.release();
    // Ref the QoreObject for DGC preventing garbage collection
    const_cast<QoreObject*>(obj_queue)->ref();

    QoreEventNotifier* notifier_ptr = nullptr;
    QoreObject* notifier_obj_ptr = nullptr;
    if (notifier) {
        // Transfer the EventNotifier ref from the ReferenceHolder to the C++ priv
        notifier_ptr = notifier.release();
        notifier_obj_ptr = const_cast<QoreObject*>(obj_notifier);
        notifier_obj_ptr->ref();
    }

    priv->registerStreamQueue(static_cast<int32_t>(stream_id), queue_ptr,
        const_cast<QoreObject*>(obj_queue), notifier_ptr, notifier_obj_ptr);
}

//! Binds a Queue to receive the persistent-session close signal for this connection
/** Called by the async-I/O controller when a multiplexed persistent handler
    session is dedicated.  When the peer resets a stream on this still-open H2
    connection (e.g. a timed-out request), continuePoll() pushes a
    \c {"type":"close"} hash to the Queue, releasing the dedicated handler thread
    parked on it so its teardown runs on the binding thread.

    @param queue the persistent-session Queue

    @since %Qore 3.0
*/
nothing Http2PollOperationBase::registerPersistentSessionQueue(Queue[Queue] queue) {
    Queue* queue_ptr = queue.release();
    const_cast<QoreObject*>(obj_queue)->ref();
    priv->registerPersistentSessionQueue(queue_ptr, const_cast<QoreObject*>(obj_queue), xsink);
}

//! Unbinds the persistent-session close Queue for this connection
/** Called by the async-I/O controller when the persistent session ends (clean
    commit, explicit end, or after a delivered close).

    @since %Qore 3.0
*/
nothing Http2PollOperationBase::deregisterPersistentSessionQueue() {
    priv->deregisterPersistentSessionQueue(xsink);
}

//! Registers a Queue backed by a C++ WebSocketStreamFrameState for a CONNECT stream
/** Incoming DATA frame payload bytes are fed into a server-side
    @ref WebSocketStreamFrameState that decodes WebSocket frames in C++
    and pushes one typed message hash per complete WebSocket message
    (\c {type, data, [code, reason]}) to the supplied Queue.  Control
    frames (ping / close) are auto-handled with outgoing responses
    submitted via nghttp2 on the I/O thread; no Qore round-trip.

    This replaces the O(N²) Qore-side binary concatenation in
    WebSocketStreamProcessor for H2 WebSocket tunnels (mirrors the H3
    path — see Socket::registerQuicConnectStreamFrameState()).

    @param stream_id the HTTP/2 stream ID
    @param queue the Queue that will receive typed message hashes

    @note Must be called on the I/O controller thread before the handler
    starts reading.

    @since %Qore 3.0
*/
nothing Http2PollOperationBase::registerStreamFrameState(int stream_id,
        Queue[Queue] queue) [flags=NAMED_ARGS] {
    // Transfer the Queue ref from the ReferenceHolder to the C++ priv.
    // The WebSocketStreamFrameState destructor derefs the Queue when the
    // stream is torn down; no separate deref in StreamQueueInfo cleanup.
    Queue* queue_ptr = queue.release();
    // Ref the QoreObject for DGC preventing garbage collection
    const_cast<QoreObject*>(obj_queue)->ref();

    priv->registerStreamFrameState(static_cast<int32_t>(stream_id), queue_ptr,
        const_cast<QoreObject*>(obj_queue));
}

//! Clears all stream queue registrations
/** Pushes NOTHING sentinels to all registered queues and notifies all
    EventNotifiers so handler threads wake up and see the stream is closed.
    Derefs all queue and notifier objects.

    Called by the Qore wrapper in abort() and cleanup paths.

    @since %Qore 3.0
*/
nothing Http2PollOperationBase::clearStreamQueues() {
    priv->clearStreamQueues(xsink);
}

//! Called on a worker thread when stream data has been drained to a Queue
/** Dispatched by the async I/O controller's worker pool after the I/O
    thread's drainStreamQueues() pushes data to a stream's Queue.

    Override in Qore to notify the handler thread (e.g., call notifyIo()
    on the WebSocket connection for the given stream).

    @param stream_id the HTTP/2 stream ID that received data

    @note This is NOT called on the I/O thread — it runs on the controller's
    worker pool thread, safe for Qore method calls.

    @since %Qore 3.0
*/
nothing Http2PollOperationBase::onStreamData(int stream_id) [flags=NAMED_ARGS] {
    // Default no-op — Qore subclass overrides to wake handler
}
