//! statement information hash as returned by @ref Qore::ProgramControl::getStatementIdInfo() "ProgramControl::getStatementIdInfo()"
/**
  In case of one code object in one file, then @ref file is the set, @ref source is nullptr, @ref offset is 0,
  and the line number is taken directly from @ref start_line and @ref end_line.

  In case of multiple code objects in one file, then all members are assigned values, in such cases
  @ref start_line and @ref end_line refer to the line number within the code object, and the line
  number in the file is calculated by adding with @ref offset, giving the line number offset within source.

  @since %Qore 0.8.13
*/
hashdecl StatementInfo {
    //! refers to the label given when parsing the code
    string file;
    //! refers to the actual file name or path of the source code (if the label does not provide this info)
    string source;
    //! the offset of the code in source
    int offset;
    //! statement start line
    int start_line;
    //! statement end line
    int end_line;
    //! list of assigned breakpoints, unavailable if @ref no-debugging "%no-debugging" (since 0.9)
    *list breakpoints;
    //! the 0-based column of the first character of the statement in its start line, or -1 if unknown, as for a block or for a statement of AOT-compiled code; a column counts bytes (since %Qore 3.0)
    int start_column = -1;
    //! the 0-based column after the last character of the statement in its end line, or -1 if unknown (since %Qore 3.0)
    int end_column = -1;
    //! @ref True if the statement is in the body of a try statement of its function, method or top-level code, so an exception that it raises can be caught there (since %Qore 3.0)
    bool in_try = False;
    //! the names of the local variables that the statement can refer to, also those that it declares and the top-level local variables of the program, which have global scope, from the innermost one, as debuggers use them to check the expressions of breakpoints; not set if they are not known, as for a statement of AOT-compiled code (since %Qore 3.0)
    *list<string> locals;
}

//! A call of a statement that a debugger can step into
/** @see @ref Qore::ProgramControl::getStepInTargets() "ProgramControl::getStepInTargets()"

    @since %Qore 3.0
*/
hashdecl StepInTargetInfo {
    //! the name of the called function, or of the method or constructor with its class
    string name;
    //! the name that the called code has in the call stack: the name of the function, or of the method without its class, as a method of a subclass can be called; empty for a call of a call reference
    string function;
    //! the ID of the statement block of the called code, or 0 if the called code is only known at runtime
    int statement_id = 0;
    //! the start line of the call
    int start_line;
    //! the end line of the call
    int end_line;
    //! the 0-based column of the first character of the call in its start line, or -1 if unknown; a column counts bytes
    int start_column = -1;
    //! the 0-based column after the last character of the call in its end line, or -1 if unknown
    int end_column = -1;
}

//! The ProgramControl class provides safe information about a Qore program
/** The object is never instantiated in script but returned by a API function.
    The class provides only safe data non breaking security model.

    @anchor programcontrol_object_identity
    Each call that returns a ProgramControl object, such as
    @ref Qore::Program::getProgram() "Program::getProgram()",
    @ref Qore::ProgramControl::getProgram() "ProgramControl::getProgram()",
    @ref Qore::ProgramControl::resolveProgramId() "ProgramControl::resolveProgramId()",
    @ref Qore::ProgramControl::getAllPrograms() "ProgramControl::getAllPrograms()" and
    @ref Qore::Breakpoint::getProgram() "Breakpoint::getProgram()", returns a new object, so two ProgramControl
    objects for the same Program are not the same object; compare them by their
    @ref Qore::ProgramControl::getProgramId() "program IDs".  The same holds for the
    @ref Qore::Breakpoint "Breakpoint" objects returned by
    @ref Qore::Breakpoint::resolveBreakpointId() "Breakpoint::resolveBreakpointId()" and
    @ref Qore::ProgramControl::getBreakpoints() "ProgramControl::getBreakpoints()", which are compared by their
    @ref Qore::Breakpoint::getBreakpointId() "breakpoint IDs".  A Program or a breakpoint whose last reference has been
    released cannot be found by its ID, is not listed by
    @ref Qore::ProgramControl::getAllPrograms() "ProgramControl::getAllPrograms()" and is not returned by
    @ref Qore::Breakpoint::getProgram() "Breakpoint::getProgram()"; the breakpoints of a Program are unassigned when
    its last reference is released.

    @see
        @ref Qore::Program "Program"

    @since %Qore 0.8.13
 */
qclass ProgramControl [arg=QoreProgram* p; dom=DEBUGGER];

//! Throws an exception to prevent objects of this class being created from script
/**
    @throw PROGRAM-CREATE-ERROR copying ProgramControl objects is currently unsupported
 */
ProgramControl::constructor() {
   xsink->raiseException("PROGRAM-COPY-ERROR", "creating ProgramControl objects is currently unsupported");
}

//! Throws an exception to prevent objects of this class from being copied
/**
    @throw PROGRAM-COPY-ERROR copying Program objects is currently unsupported
 */
ProgramControl::copy() {
   xsink->raiseException("PROGRAM-COPY-ERROR", "copying ProgramControl objects is currently unsupported");
}

//! Dereferences the internal Program object and deletes the %Qore object
/**
 */
ProgramControl::destructor() {
   printd(5, "ProgramControl::destructor() pgm: %p, pgmid: " QLLD ", self: %p\n", p, (int64)p->getProgramId(), self);
   // the object holds its own reference to the Program
   p->deref(xsink);
}

//! Creates a Program whose code can refer to all code of this Program, for evaluating expressions in a debugger
/** The new Program inherits all user code of this Program: its functions, classes, constants, hashdecls, enums,
    typedefs, namespaces and global variables, also those that are not public, which a Program created with
    @ref Qore::Program::constructor() "Program::constructor()" does not inherit.  Functions and methods run in this
    Program, classes are the same classes, so the objects of this Program can be used, and global variables are
    shared.  This Program is not changed; code that is added to it later is not inherited.

    @param parse_options the parse options of the new Program; the restrictions of this Program apply as well;
    @ref Qore::PO_ALLOW_REPARSE "PO_ALLOW_REPARSE" is kept also when this Program does not have it, as it only
    allows code to be parsed in the new Program more than once

    @return the new Program

    @par Example:
    @code{.py}
Program pgm = pc.createEvalProgram(PO_NEW_STYLE | PO_LOCKDOWN | PO_ALLOW_REPARSE);
pgm.parse("auto sub eval() { return calculate(Limit); }", "eval");
auto v = pgm.callFunction("eval");
    @endcode

    @throw PROGRAM-OPTION-ERROR the parse options contain options that can only be set by the system
    @throw PROGRAM-ERROR this Program is being parsed

    @since %Qore 3.0
*/
Program ProgramControl::createEvalProgram(softint parse_options = PO_DEFAULT) [flags=NAMED_ARGS] {
    if (parse_options & PO_SYSTEM_OPS) {
        return xsink->raiseException("PROGRAM-OPTION-ERROR", "parse options (0x" QLLX ") contain restricted "
            "options that can only be set by the system", parse_options);
    }
    // the namespace of this Program is copied when the new Program is created
    if (qore_program_private::get(*p)->parsing_in_progress) {
        return xsink->raiseException("PROGRAM-ERROR", "the Program is currently undergoing parsing; its code "
            "cannot be inherited");
    }
    QoreProgram* pgm;
    {
        InheritAllUserCodeHelper all_user_code;
        pgm = new QoreProgram(p, parse_options);
    }
    // a child Program has only the positive options of its parent; this one only allows the new Program to be
    // parsed again
    if (parse_options & PO_ALLOW_REPARSE) {
        qore_program_private::get(*pgm)->setParseOptionsIntern(PO_ALLOW_REPARSE);
    }
    // the code that creates the Program controls it, as does this Program, its parent, whose chain the new Program
    // already has
    const QoreProgram* creator = getProgram();
    if (creator) {
        qore_program_private::addCreator(*pgm, *creator);
    }
    QoreObject* rv = new QoreObject(QC_PROGRAM, getProgram(), pgm);
    // the object reports the Program's code to the garbage collector (issue #5590)
    qore_program_private::setScanHolder(*pgm, *rv);
    return rv;
}

//! Returns the current binary-or'ed parse option mask for the Program object
/** see Qore::Program::getParseOptions "Program::getParseOptions()"
 */
int ProgramControl::getParseOptions() {
   return p->getParseOptions().getLo();
}

