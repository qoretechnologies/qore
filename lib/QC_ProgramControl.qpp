//! Returns the default local time zone for the object
/** see Qore::Program::getTimeZone "Program::getTimeZone()"
 */
TimeZone ProgramControl::getTimeZone() {
   return new QoreObject(QC_TIMEZONE, 0, new TimeZoneData(p->currentTZ()));
}

//! Returns @ref True if the given @ref conditional_parsing "parse define" is defined in the current Program (does not have to have a value defined to return @ref True), @ref False if not
/** @param parse_define the @ref conditional_parsing "parse define" name to check

    @see Qore::Program::isDefined "Program::isDefined()"

    @note since %Qore 3.0 a name with a NUL character names nothing, and @ref Qore::errno() "errno()"
    returns \c EINVAL
 */
bool ProgramControl::isDefined(string parse_define) [flags=NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name something else
    if (q_check_no_nul(parse_define->c_str(), parse_define->size())) {
        return false;
    }
   TempEncodingHelper t(parse_define, QCS_DEFAULT, xsink);
   return t ? qore_program_private::runTimeIsDefined(p, t->getBuffer()) : false;
}

//! Retrieves the value of the given @ref conditional_parsing "parse define" in the current Program
/** @param parse_define the @ref conditional_parsing "parse define" name to get

    @see Qore::Program::getDefine "Program::getDefine()"

    @note since %Qore 3.0 a name with a NUL character names nothing, and @ref Qore::errno() "errno()"
    returns \c EINVAL
 */
auto ProgramControl::getDefine(string parse_define) [flags=NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name something else
    if (q_check_no_nul(parse_define->c_str(), parse_define->size())) {
        return QoreValue();
    }
   TempEncodingHelper t(parse_define, QCS_DEFAULT, xsink);
   return t ? qore_program_private::runTimeGetDefine(p, t->c_str()) : QoreValue();
}

//! Retrieves all @ref conditional_parsing "parse defines" in the current Program
/** see Qore::Program::getAllDefines "Program::getAllDefines()"
 */
*hash<auto> ProgramControl::getAllDefines() {
   return qore_program_private::runTimeGetAllDefines(p);
}

//! Get program id
/** see Qore::Program::getProgramId "Program::getProgramId()"
 */
int ProgramControl::getProgramId() [flags=RET_VALUE_ONLY;] {
   return p->getProgramId();
}

//! Get instance of program id
/**
   @param program_id the ID of the program to resolve

   @see
      @ref Qore::ProgramControl::resolveProgramId "ProgramControl::resolveProgramId()"

   @throw PROGRAM-ERROR if the programId cannot identify @ref Qore::ProgramControl "ProgramControl" instance

 */
static ProgramControl ProgramControl::resolveProgramId(int program_id) [flags=NAMED_ARGS;dom=DEBUGGER] {
   // a Program ID is positive; the Program is returned with a reference, which the new object takes over
   QoreProgram* pgm = program_id > 0
      ? qore_program_private::getReferencedProgram(static_cast<qore_program_id_t>(program_id))
      : nullptr;
   if (!pgm) {
      return xsink->raiseException("PROGRAM-ERROR", "cannot find program for programId (" QLLD ")", (int64)program_id);
   }
   return new QoreObject(QC_PROGRAMCONTROL, getProgram(), pgm);
}

//! Get control for instance of current program
/**
 */
static ProgramControl ProgramControl::getProgram() [flags=RET_VALUE_ONLY; dom=DEBUGGER] {
   QoreObject* o = qore_program_private::getProgramControl(getProgram());
   if (!o) {
      return xsink->raiseException("PROGRAM-ERROR", "the current Program is being deleted");
   }
   return o;
}

//! Get instance of all programs.
/**
   Use @ref Qore::ProgramControl::resolveProgramId "ProgramControl::resolveProgramId()" to get instance
 */
static list<ProgramControl> ProgramControl::getAllPrograms() [flags=RET_VALUE_ONLY; dom=DEBUGGER] {
   return QoreProgram::getAllQoreObjects(xsink);
}

//! returns a list of thread IDs active in this Program
/** see Qore::Program::getThreadList "Program::getThreadList()"
*/
list<int> ProgramControl::getThreadList() [flags=CONSTANT] {
   return p->getThreadList();
}

//! Checks if a user function exists in the program object
/** @param function_name the function name to check

    @see Qore::Program::existsFunction "Program::existsFunction()"

    @note since %Qore 3.0 a name with a NUL character names nothing, and @ref Qore::errno() "errno()"
    returns \c EINVAL
 */
bool ProgramControl::existsFunction(string function_name) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name something else
    if (q_check_no_nul(function_name->c_str(), function_name->size())) {
        return false;
    }
   if (!p->checkAllowDebugging(xsink))
      return false;
   TempEncodingHelper tmp(function_name, QCS_DEFAULT, xsink);
   if (!tmp)
      return false;
   return p->existsFunction(tmp->getBuffer());
}

//! Returns a the value of the global variable identified by the first string argument
/** @param variable_name the global variable name
    @param found optional reference assigned @ref True if the global variable exists, @ref False if not

    @see Qore::Program::getGlobalVariable "Program::getGlobalVariable()"

    @note since %Qore 3.0 a name with a NUL character names nothing, and @ref Qore::errno() "errno()"
    returns \c EINVAL
 */
auto ProgramControl::getGlobalVariable(string variable_name, *reference<bool> found) [flags=NAMED_ARGS] {
    if (!p->checkAllowDebugging(xsink))
        return QoreValue();
    TempEncodingHelper t(variable_name, QCS_DEFAULT, xsink);
    if (!t)
        return QoreValue();

    // the name is looked up as a C string, which would be cut at a NUL character and name another variable; a name
    // with a NUL character names no variable, and errno is set to EINVAL
    bool is_found = false;
    ValueHolder rv(xsink);
    if (!q_check_no_nul(variable_name->c_str(), variable_name->size())) {
        rv = p->getGlobalVariableValue(t->c_str(), is_found);
    }

    if (found) {
        QoreTypeSafeReferenceHelper r(found, xsink);
        if (!r)
            return QoreValue();

        if (r.assign(is_found))
            return QoreValue();
    }

    return rv.release();
}

//! returns a hash of global variables
/** see Qore::Program::getGlobalVars "Program::getGlobalVars()"
 */
hash<auto> ProgramControl::getGlobalVars() [flags=CONSTANT] {
   if (!p->checkAllowDebugging(xsink))
      return QoreValue();
   return p->getGlobalVars();
}

//! set the value of a global variable
/** @param variable_name the global variable name
    @param value the value to assign

    @see Qore::Program::setGlobalVars "Program::setGlobalVars()"


    @throw UNKNOWN-VARIABLE the variable name contains a NUL character (since %Qore 3.0)
 */
nothing ProgramControl::setGlobalVarValue(string variable_name, auto value) [flags=NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name another variable
    if (q_check_no_nul(variable_name->c_str(), variable_name->size(), "variable name", "variable names", "UNKNOWN-VARIABLE", xsink)) {
        return QoreValue();
    }
   if (!p->checkAllowDebugging(xsink))
      return QoreValue();
   p->setGlobalVarValue(variable_name->c_str(), value.refSelf(), xsink);
}

//! Assign @ref Breakpoint instance to @ref Qore::Program "Program". If breakpoint has been assigned to an program then is unassigned in the first step.
/** @param breakpoint the breakpoint to assign to this program
 */
nothing ProgramControl::assignBreakpoint(Breakpoint[QoreBreakpoint] breakpoint) [flags=NAMED_ARGS] {
   if (!p->checkAllowDebugging(xsink))
      return QoreValue();
   p->assignBreakpoint(*breakpoint, xsink);
}

//! delete all breakpoints from instance
/**
 */
nothing ProgramControl::deleteAllBreakpoints() {
   if (!p->checkAllowDebugging(xsink))
      return QoreValue();
   p->deleteAllBreakpoints();
}

//! get list of breakpoint assigned to program.
/**
 */
list<Breakpoint> ProgramControl::getBreakpoints() {
    if (!p->checkAllowDebugging(xsink))
        return QoreValue();
    QoreBreakpointList_t bl;
    p->getBreakpoints(bl);
    QoreListNode *l = new QoreListNode(QC_BREAKPOINT->getTypeInfo());
    for (QoreBreakpointList_t::iterator it = bl.begin(); it != bl.end(); ++it) {
        // each object takes its own reference; the list releases the ones that getBreakpoints() took
        l->push((*it)->getQoreObject(), nullptr);
    }
    return l;
}

//! Returns the top-level local variables of the Program in the current thread
/** Top-level local variables have global scope: code in functions and methods can refer to them, and each thread has
    its own values of them.  Debuggers evaluate expressions with them, as the code that a thread runs sees them

    @return a hash of the top-level local variables that are instantiated in the current thread; the keys are the
    names of the variables, and the values are hashes as returned by @ref Qore::get_local_vars() "get_local_vars()"

    @par Example:
    @code{.py}
hash<auto> h = pc.getTopLevelLocalVars();
    @endcode

    @since %Qore 3.0
*/
hash<auto> ProgramControl::getTopLevelLocalVars() [dom=DEBUGGER] {
   if (!p->checkAllowDebugging(xsink)) {
      return QoreValue();
   }
   return qore_program_private::get(*p)->getTopLevelLocalVars(xsink);
}

//! get information related to statement id
/**
   @param statement_id the statement ID to resolve
   @param list_breakpoints list also breakpoints assigned to statement, no effect if @ref no-debugging "%no-debugging" (since 0.9)

   @return a hash of statement info

   @see
      @ref Qore::ProgramControl::findStatementId "ProgramControl::findStatementId()"
      @ref Qore::ProgramControl::findFunctionStatementId "ProgramControl::findFunctionStatementId()"
*/
hash<StatementInfo> ProgramControl::getStatementIdInfo(int statement_id, bool list_breakpoints = False) [flags=NAMED_ARGS] {
   if (!p->checkAllowDebugging(xsink))
      return QoreValue();
   AbstractStatement* s = p->resolveStatementId(statement_id);
   if (!s) {
      return xsink->raiseException("PROGRAM-STATEMENT-ERROR", "cannot resolve statement id from (" QLLD ")", (int64)statement_id);
   }
   QoreHashNode* h = new QoreHashNode(hashdeclStatementInfo, nullptr);
   qore_hash_private* ph = qore_hash_private::get(*h);
   ph->setKeyValueIntern("file", new QoreStringNode(s->loc->getFile()));
   ph->setKeyValueIntern("source", new QoreStringNode(s->loc->getSource()));
   ph->setKeyValueIntern("offset", s->loc->offset);
   ph->setKeyValueIntern("start_line", s->loc->start_line);
   ph->setKeyValueIntern("end_line", s->loc->end_line);
   ph->setKeyValueIntern("start_column", s->loc->start_column);
   ph->setKeyValueIntern("end_column", s->loc->end_column);
   ph->setKeyValueIntern("in_try", s->isInTry());
   if (s->isScopeKnown()) {
      // an inner variable hides an outer one with the same name
      ReferenceHolder<QoreListNode> locals(new QoreListNode(stringTypeInfo), xsink);
      std::set<std::string> names;
      for (const LocalVar* lv = s->getScopeLocalVars(); lv; lv = lv->getParseScopePrev()) {
         if (names.insert(lv->getName()).second) {
            locals->push(new QoreStringNode(lv->getName()), xsink);
         }
      }
      // the top-level variables have global scope: all code of the Program can refer to them
      qore_program_private::get(*p)->addTopLevelLocalVarNames(**locals, names, xsink);
      ph->setKeyValueIntern("locals", locals.release());
   }
   if (list_breakpoints && p->checkAllowDebugging(xsink)) {
      QoreBreakpointList_t bl;
      p->getStatementBreakpoints(s, bl);
      QoreListNode *l = new QoreListNode(QC_BREAKPOINT->getTypeInfo());
      for (QoreBreakpointList_t::iterator it = bl.begin(); it != bl.end(); ++it) {
         // each object takes its own reference; the list releases the ones that getStatementBreakpoints() took
         l->push((*it)->getQoreObject(), xsink);
      }
      ph->setKeyValueIntern("breakpoints", l);
   }
   return h;
}

//! Returns the stable statement IDs registered in this Program
/**
   Statement IDs are returned in parse-registration order and can be passed to
   @ref Qore::ProgramControl::getStatementIdInfo() "ProgramControl::getStatementIdInfo()".

   @return a list of statement IDs visible to debugger-domain callers

   @since %Qore 3.0
*/
list<int> ProgramControl::getStatementIds() {
   if (!p->checkAllowDebugging(xsink)) {
      return QoreValue();
   }
   return qore_program_private::get(*p)->getStatementIds(xsink);
}

//! Find statement related to position in file
/**
   @param file name where is looking for. Searching is done in three steps, in the first one is looking for full name match, in the second is looking for label full match (if exists) and
      in the third for end suffix match; finally the name is matched as an absolute path against the absolute path of
      each file, made absolute with the working directory that the file was parsed in, so that a file can be given
      with another path than it was parsed with, as an IDE gives it. File can by empty if program contains only one
      file. Beware of label formating, see @ref Qore::Program::parse
   @param line to find statement. In case of multiple statements of line the first one is found

   @see
      @ref Qore::ProgramControl::findFunctionStatementId "ProgramControl::findFunctionStatementId()"

    @throw PROGRAM-STATEMENT-ERROR the source label contains a NUL character (since %Qore 3.0)
*/
int ProgramControl::findStatementId(string file, int line) [flags=NAMED_ARGS] {
    // the label is looked up as a C string, which would be cut at a NUL character and name another source
    if (q_check_no_nul(file->c_str(), file->size(), "source label", "source labels", "PROGRAM-STATEMENT-ERROR",
            xsink)) {
        return QoreValue();
    }
    if (!p->checkAllowDebugging(xsink))
        return 0;
    AbstractStatement* s = p->findStatement(file->c_str(), line);
    if (!s) {
        // without a file, the line is searched in all files
        if (file->empty()) {
            return xsink->raiseException("PROGRAM-STATEMENT-ERROR", "there is no statement on line " QLLD
                " where the program can pause", (int64)line);
        }
        return xsink->raiseException("PROGRAM-STATEMENT-ERROR", "there is no statement on line " QLLD " of \"%s\" "
            "where the program can pause", (int64)line, file->c_str());
    }
    return p->getStatementId(s);
}

//! Finds the statements of a line in a file
/**
   @param file the name of the file or the label of the source, which is resolved as with
   @ref Qore::ProgramControl::findStatementId() "ProgramControl::findStatementId()"
   @param line the line to find the statements of

   @return the IDs of the statements that start on the line in the order of their columns, the first being the
   statement that @ref Qore::ProgramControl::findStatementId() "ProgramControl::findStatementId()" finds if it has no
   column; if no statement starts on the line, the innermost statement that contains it; an empty list if no
   statement is found

   @par Example:
   @code{.py}
# a breakpoint on the second statement of line 10 of a file with "a(); b();" on it
list<int> ids = pc.findStatementIds("file.q", 10);
Breakpoint bp();
bp.assignStatement(ids[1]);
   @endcode

   A debugger can find the statement of a column of the line with
   @ref Qore::ProgramControl::getStatementIdInfo() "ProgramControl::getStatementIdInfo()", which gives the columns
   of each statement

   @throw PROGRAM-STATEMENT-ERROR the source label contains a NUL character

   @see
      @ref Qore::ProgramControl::findStatementId "ProgramControl::findStatementId()"

   @since %Qore 3.0
*/
list<int> ProgramControl::findStatementIds(string file, int line) [flags=NAMED_ARGS] {
    // the label is looked up as a C string, which would be cut at a NUL character and name another source
    if (q_check_no_nul(file->c_str(), file->size(), "source label", "source labels", "PROGRAM-STATEMENT-ERROR",
            xsink)) {
        return QoreValue();
    }
    if (!p->checkAllowDebugging(xsink)) {
        return QoreValue();
    }
    return qore_program_private::get(*p)->findStatementIds(file->c_str(), line, xsink);
}

//! Returns the calls of a statement that a debugger can step into
/**
   @param statement_id the ID of the statement

   @return the calls that the statement makes, in the order in which they are evaluated, without the calls of the
   blocks of the statement and of closures that it creates; also calls whose called code is only known at runtime,
   such as calls of methods of objects of unknown classes and of call references, whose \c statement_id is 0; calls
   of builtin code and of the user code of other Programs are not given, as a debugger of this Program does not
   stop in them.  A debugger steps into a call by matching the functions that the statement calls with the
   \c function of the call and the number of earlier calls with it in the list; when an operand of a conditional
   operator, such as <tt>?:</tt>, <tt>&&</tt> or <tt>||</tt>, is not evaluated, a later call with the same
   \c function can be stepped into instead
   (<a href="https://github.com/qoretechnologies/qore/issues/5564">issue 5564</a>)

   @par Example:
   @code{.py}
# step into g() in "f(g(x));"
hash<StepInTargetInfo> target = (select pc.getStepInTargets(statement_id), $1.name == "g")[0];
   @endcode

   @throw PROGRAM-STATEMENT-ERROR the statement ID cannot be resolved

   @see
      @ref Qore::ProgramControl::getStatementIdInfo() "ProgramControl::getStatementIdInfo()"

   @since %Qore 3.0
*/
list<hash<StepInTargetInfo>> ProgramControl::getStepInTargets(int statement_id) [flags=NAMED_ARGS] {
    if (!p->checkAllowDebugging(xsink)) {
        return QoreValue();
    }
    return qore_program_private::get(*p)->getStepInTargets(statement_id, xsink);
}

//! Find the first statement for function entry point
/**
   @param function_name function name
   @param params param types to resolve particular variant

   @see
      @ref Qore::ProgramControl::findStatementId "ProgramControl::findStatementId()"


    @throw PROGRAM-STATEMENT-ERROR the function name contains a NUL character (since %Qore 3.0)
*/
int ProgramControl::findFunctionStatementId(string function_name, *list params) [flags=NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name another function
    if (q_check_no_nul(function_name->c_str(), function_name->size(), "function name", "function names", "PROGRAM-STATEMENT-ERROR", xsink)) {
        return QoreValue();
    }
    if (!p->checkAllowDebugging(xsink))
        return 0;
    AbstractStatement* s = p->findFunctionStatement(function_name->c_str(), params, xsink);
    if (!s) {
        if (!*xsink) {
            xsink->raiseException("PROGRAM-STATEMENT-ERROR", "\"%s()\" has no statement where the program can pause",
                function_name->c_str());
        }
        return QoreValue();
    }
    return p->getStatementId(s);
}

//! finds all variants of a function or class method and returns a list of the results
/** @param function_name the function or class method name; may also be namespace-justified

    @return a list of hashes or nothing if the name cannot be resolved; when matched, each hash element has the following keys:
    - \c desc: a string description of the call which includes the name and the full text call signature
    - \c params: a list object that gives the params in a format that can be used by @ref findFunctionStatementId


    @throw PROGRAM-ERROR the function name contains a NUL character (since %Qore 3.0)
*/
list<hash<auto>> ProgramControl::findFunctionVariants(string function_name) [flags=NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name another function
    if (q_check_no_nul(function_name->c_str(), function_name->size(), "function name", "function names", "PROGRAM-ERROR", xsink)) {
        return QoreValue();
    }
    if (!p->checkAllowDebugging(xsink))
        return QoreValue();
    ReferenceHolder<QoreListNode> vl(p->runtimeFindCallVariants(function_name->c_str(), xsink), xsink);
    if (!vl)
        return xsink->raiseException("PROGRAM-ERROR", "cannot find any function or method \"%s\"",
            function_name->c_str());
    return vl.release();
}

//! Get list of label names which has been registered to a statement when parsing source code
/**
    @see
        @ref Qore::ProgramControl::getSourceFileNames "ProgramControl::getSourceFileNames()"

    @return a hash where keys are file names and the value is hash of labels, in this hash, the keys are label names
    and values are the label's section offset in the file.

    @since %Qore 0.8.13.3
*/
hash<string, hash<string, int>> ProgramControl::getSourceLabels() {
   if (!p->checkAllowDebugging(xsink))
      return QoreValue();
   return p->getSourceLabels(xsink);
}

//! Returns a list of file names registered to a statement when parsing source code
/**
    @see
        @ref Qore::ProgramControl::getSourceLabels "ProgramControl::getSourceLabels()"

    @return a hash where keys are file names and the value is hash of labels, in this hash, the keys are label names
   and values are the label's section offset in the file.

    @since %Qore 0.8.13.3
*/
hash<string, hash<string, int>> ProgramControl::getSourceFileNames() {
   if (!p->checkAllowDebugging(xsink))
      return QoreValue();
   return p->getSourceFileNames(xsink);
}
