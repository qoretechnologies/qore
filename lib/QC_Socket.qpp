//! Resolves address information through the async I/O controller
/** This method delegates the address lookup to the global async I/O controller and blocks the caller until the
    controller-backed operation completes.  It returns the same address fields used by the \c getaddrinfo() function:
    \c "address", \c "address_desc", \c "family", \c "familystr", \c "addrlen", and, when \a service is supplied,
    \c "port".

    @param node the node name for the lookup
    @param service the service name (from \c /etc/services, for example) or port number
    @param family a hint for the address family, \c AF_UNSPEC means any family
    @param flags hint flags as per the \c getaddrinfo() call: \c AI_ADDRCONFIG, \c AI_ALL, \c AI_CANONNAME,
    \c AI_NUMERICHOST, \c AI_NUMERICSERV, \c AI_PASSIVE, \c AI_V4MAPPED
    @param socktype a hint for the type of socket; 0 = any socket type
    @param protocol a hint for the protocol number; 0 = the default protocol
    @param timeout_ms the timeout for the controller-backed resolution operation; -1 = never timeout

    @throw QOREADDRINFO-GETINFO-ERROR error looking up either nodename or servicename (or not known)
    @throw ASYNC-IO-ERROR called from the async I/O thread or the global async I/O controller is unavailable

    @since %Qore 2.3
 */
static list<hash<auto>> Socket::resolveAddrInfo(*string node, *softstring service,
        softint family = AF_UNSPEC, softint flags = 0, softint socktype = SOCK_STREAM, softint protocol = 0,
        timeout timeout_ms = -1) [flags=RET_VALUE_ONLY;dom=EXTERNAL_INFO] {
    return qore_socket_resolve_addrinfo_asyncio(xsink, node ? node->c_str() : nullptr,
        service ? service->c_str() : nullptr, family, flags, socktype, protocol, timeout_ms);
}

//! Parse the given string as a Server Sent Event (SSE) string
/** @param str the string to parse as a Server Sent Event (SSE) string

    @return a hash of the event information
*/
static hash<SseMessageInfo> Socket::parseServerSentEvent(string str) {
    return QoreSocket::parseServerSentEvent(xsink, str);
}

//! polls multiple sockets and returns all sockets with events
/** @par Example:
    @code{.py}
list<hash<SocketPollInfo>> l(
    <SocketPollInfo>{
        "events": SOCK_POLLOUT,
        "socket": sock1,
    },
    <SocketPollInfo>{
        "events": SOCK_POLLIN | SOCK_POLLOUT,
        "socket": sock2,
    },
);
l = Socket::poll(l, 2s);
    @endcode

    @param items list of @ref SocketPollInfo hashes of sockets with events in the timeout period
    @param timeout_ms the poll timeout period; -1 = never timeout

    @return a list of sockets with events in the timeout period

    @throw SOCKET-POLL-ERROR \a socket value in the \a items argument is not assigned or there was an error in the
    poll operation
    @throw SOCKET-NOT-OPEN \a socket value in the \a items argument is closed

    @note If a socket being polled is closed or deleted in a background thread, the poll operation is not interrupted
    on Linux; other platforms behave differently (macOS / Darwin interrupts the polling process in this case); for
    proper operation on all platforms, do not assume that the polling operation will return immediately if a socket
    being polled is deleted in a background thread.

    @since %Qore 0.9.11
*/
static list<hash<SocketPollInfo>> Socket::poll(list<hash<SocketPollInfo>> items, timeout timeout_ms) {
    return qore_socket_private::poll(items, timeout_ms, xsink);
}

//! Returns a poll operation for reading an HTTP/2 request on a server connection
/** This poll operation is used for server-side HTTP/2 connections that have been
    negotiated via ALPN during the TLS handshake.

    @par Example:
    @code{.py}
    # After accepting an HTTPS connection with HTTP/2 negotiated
    AbstractPollOperation op = sock.startPollReadHttp2Request();
    while (True) {
        *hash<SocketPollInfo> info = op.continuePoll();
        if (!info) {
            break;
        }
        Socket::poll((info,), 10s);
    }
    # Get the request data
    hash<auto> request = op.getOutput();
    printf("Method: %s, Path: %s\n", request.method, request.path);
    @endcode

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object for reading an HTTP/2 request

    The returned operation produces output with the following keys:
    - \c method: the HTTP method (GET, POST, etc.)
    - \c path: the request path
    - \c stream_id: the HTTP/2 stream ID (needed for sending the response)
    - \c headers: hash of request headers
    - \c body: binary request body (if present)
    - \c authority: the :authority pseudo-header value (if present)
    - \c scheme: the :scheme pseudo-header value (if present)

    @throw SOCKET-NOT-OPEN The socket is not connected
    @throw HTTP2-ERROR HTTP/2 session initialization failed

    @note The socket must be a TLS connection that has negotiated HTTP/2 via ALPN

    @param opts optional hash with options:
    - \c headers_only (bool): if @ref True "True", the poll completes when HEADERS are received
      (before END_STREAM); the stream stays in the session for incremental reading via the
      @ref HttpServerAsyncIo "HttpServerAsyncIo" @c register_body_queue closure (the I/O
      thread pushes inbound DATA chunks to a Qore @ref Queue "Queue").

    @see isHttp2()

    @since %Qore 2.1 (headers_only option added in %Qore 2.3)
*/
AbstractPollOperation Socket::startPollReadHttp2Request(*hash<auto> opts) {
    s->ref();
    ReferenceHolder<SocketPollOperationBase> poller(new SocketHttp2ServerPollOperation(xsink, s), xsink);
    if (*xsink) {
        return QoreValue();
    }

    // Always propagate headers_only mode to the session (resets any sticky state
    // from a previous poll operation on the same connection)
    bool headers_only = opts ? opts->getKeyValue("headers_only").getAsBool() : false;
    (reinterpret_cast<SocketHttp2ServerPollOperation*>(*poller))->setHeadersOnly(headers_only);

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("http2-request"), xsink);
    }
    return rv.release();
}

//! Returns a poll operation for sending an HTTP/2 response
/** This poll operation sends an HTTP/2 response on a stream that received a request.

    @par Example:
    @code{.py}
    # After reading request with startPollReadHttp2Request()
    AbstractPollOperation op = sock.startPollSendHttp2Response(
        request.stream_id,
        200,
        {"Content-Type": "text/plain"},
        "Hello, HTTP/2!"
    );
    while (True) {
        *hash<SocketPollInfo> info = op.continuePoll();
        if (!info) {
            break;
        }
        Socket::poll((info,), 10s);
    }
    @endcode

    @param stream_id the HTTP/2 stream ID from the request
    @param status_code the HTTP status code to send
    @param headers hash of response headers
    @param body the response body (optional)

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object for sending the response

    @throw SOCKET-NOT-OPEN The socket is not connected
    @throw HTTP2-ERROR HTTP/2 response submission failed

    @since %Qore 2.1
*/
AbstractPollOperation Socket::startPollSendHttp2Response(int stream_id, int status_code, *hash<auto> headers,
        *data body) {
    s->ref();

    // Get body data
    const BinaryNode* body_bin = nullptr;
    SimpleRefHolder<BinaryNode> body_holder;
    if (body) {
        qore_type_t body_type = body->getType();
        if (body_type == NT_BINARY) {
            body_bin = static_cast<const BinaryNode*>(body);
        } else if (body_type == NT_STRING) {
            const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
            // Create a binary node from the string's raw bytes
            size_t size = str->size();
            void* copy = malloc(size);
            memcpy(copy, str->c_str(), size);
            body_holder = new BinaryNode(copy, size);
            body_bin = *body_holder;
        }
    }

    ReferenceHolder<SocketPollOperationBase> poller(
        new SocketHttp2SendResponsePollOperation(xsink, s, nullptr, stream_id, status_code,
            headers, body_bin),
        xsink
    );
    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("http2-response"), xsink);
    }
    return rv.release();
}

//! Starts a poll operation to send an HTTP/2 response with a streaming body from an InputStream
/** This method reads from the InputStream in chunks and sends HTTP/2 DATA frames
    without buffering the entire body in memory. This is suitable for large responses.

    The InputStream must have unassignThread() called before passing to this method
    if it was created in a different thread. The poll operation will call reassignThread()
    on the event loop thread.

    @param stream_id the HTTP/2 stream ID
    @param status_code the HTTP status code
    @param headers response headers (optional)
    @param body the InputStream to read the response body from
    @param chunk_size the size of chunks to read from the stream (default: 16384)

    @return an @ref AbstractPollOperation object for the streaming send

    @throw SOCKET-NOT-OPEN The socket is not connected
    @throw HTTP2-ERROR if no HTTP/2 session is available

    @since %Qore 2.2
*/
AbstractPollOperation Socket::startPollSendHttp2StreamingResponse(int stream_id, int status_code,
        *hash<auto> headers, InputStream[InputStream] body, *int chunk_size) {
    // body ref is owned by QPP ReferenceHolder; poll operation takes ownership via release()
    InputStream* body_ptr = body.release();
    // Hold a strong reference to the QoreObject so the InputStream is not garbage collected
    QoreObject* body_obj = const_cast<QoreObject*>(obj_body);
    body_obj->ref();
    s->ref();

    ReferenceHolder<SocketPollOperationBase> poller(
        new SocketHttp2SendStreamingResponsePollOperation(xsink, s, stream_id, status_code,
            headers, body_ptr, body_obj, chunk_size ? chunk_size : 16384),
        xsink
    );
    if (*xsink) {
        return QoreValue();
    }

    // Unassign the stream from the current thread so that the worker thread
    // calling continuePoll() can reassign it to itself
    body_ptr->unassignThread(xsink);
    if (*xsink) {
        return QoreValue();
    }
    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("http2-streaming-response"), xsink);
    }
    return rv.release();
}

//! Submits an HTTP/2 PUSH_PROMISE frame for server push
/** HTTP/2 Server Push allows a server to preemptively send resources to the client
    before the client requests them. This is useful for pushing CSS, JavaScript, or
    images that the server knows the client will need.

    @par Example:
    @code{.py}
    # After receiving a request for index.html, push the CSS file
    int promised_id = sock.submitHttp2PushPromise(
        request.stream_id,
        "/style.css",
        {"content-type": "text/css"}
    );
    if (promised_id > 0) {
        # Now send the pushed response on the promised stream
        sock.startPollSendHttp2Response(promised_id, 200, {"content-type": "text/css"}, css_content);
    }
    @endcode

    @param stream_id the HTTP/2 stream ID of the associated request
    @param path the path of the resource being pushed
    @param headers hash of headers for the pushed resource

    @return the promised stream ID on success (positive integer), or -1 on error

    @throw SOCKET-NOT-OPEN The socket is not connected
    @throw HTTP2-ERROR HTTP/2 push promise submission failed or not in server mode

    @note Server Push can be disabled by clients; check if the push was successful by verifying
    the return value is positive.

    @since %Qore 2.2
*/
int Socket::submitHttp2PushPromise(int stream_id, string path, *hash<auto> headers) {
    return s->submitHttp2PushPromise(stream_id, path->c_str(), headers, xsink);
}

//! Submits an HTTP/2 response through the async I/O controller
/** Copies caller-owned data, queues the response in the nghttp2 session on the
    async I/O controller, and wakes the controller when this socket is registered
    there. The actual socket write is handled by the active read poll operation's
    sendPendingData() calls.

    @param stream_id the HTTP/2 stream ID from the request
    @param status_code the HTTP status code to send
    @param headers hash of response headers
    @param body the response body (optional)

    @throw HTTP2-ERROR no HTTP/2 session active or submission failed

    @since %Qore 2.2
*/
nothing Socket::submitHttp2Response(int stream_id, int status_code, *hash<auto> headers, *data body) {
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    SimpleRefHolder<BinaryNode> body_holder;

    if (body) {
        qore_type_t body_type = body->getType();
        if (body_type == NT_BINARY) {
            const BinaryNode* bin = static_cast<const BinaryNode*>(body);
            body_ptr = bin->getPtr();
            body_len = bin->size();
        } else if (body_type == NT_STRING) {
            const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
            body_ptr = str->c_str();
            body_len = str->size();
        }
    }

    s->submitHttp2Response(stream_id, status_code, headers, body_ptr, body_len, xsink);
}

//! Sets whether to advertise ENABLE_CONNECT_PROTOCOL in HTTP/2 server SETTINGS
/** Must be called before the HTTP/2 session is created (before the socket starts
    processing HTTP/2 traffic). When \c enable is @ref False, the server will not
    advertise RFC 8441 extended CONNECT protocol support, so clients will not attempt
    WebSocket over HTTP/2 CONNECT.

    @param enable @ref True to advertise ENABLE_CONNECT_PROTOCOL (default), @ref False to disable

    @since %Qore 2.3
*/
nothing Socket::setHttp2ConnectProtocolEnabled(bool enable = True) {
    s->setHttp2ConnectProtocolEnabled(enable);
}

//! Submits an HTTP/2 CONNECT response through the async I/O controller (RFC 8441)
/** Queues the CONNECT response in the nghttp2 session without END_STREAM on the
    async I/O controller, keeping the stream open for bidirectional data transfer
    (WebSocket over HTTP/2). The actual socket write is handled by the active
    read poll operation's sendPendingData() calls.

    This is designed for HTTP/2 multiplexing where the read operation stays on the I/O
    thread and CONNECT responses are submitted from handler threads.

    @param stream_id the HTTP/2 stream ID from the CONNECT request
    @param status_code the HTTP status code to send (200 to accept, 4xx to reject)
    @param headers hash of response headers

    @throw HTTP2-ERROR no HTTP/2 session active or submission failed

    @since %Qore 2.3
*/
nothing Socket::submitHttp2ConnectResponse(int stream_id, int status_code, *hash<auto> headers) {
    s->submitHttp2ConnectResponse(stream_id, status_code, headers, xsink);
}

//! Returns a poll operation for sending an HTTP/2 CONNECT response (RFC 8441)
/** This poll operation sends an HTTP/2 response for an extended CONNECT request
    (RFC 8441), used for WebSocket over HTTP/2. Unlike a regular HTTP/2 response,
    a CONNECT response does NOT set the END_STREAM flag, keeping the stream open
    for bidirectional data transfer.

    @par Example:
    @code{.py}
    # After reading a WebSocket CONNECT request with startPollReadHttp2Request()
    if (request.is_websocket_connect) {
        AbstractPollOperation op = sock.startPollSendHttp2ConnectResponse(
            request.stream_id,
            200,
            {"sec-websocket-protocol": "graphql-ws"}
        );
        while (True) {
            *hash<SocketPollInfo> info = op.continuePoll();
            if (!info) {
                break;
            }
            Socket::poll((info,), 10s);
        }
        # Stream is now open for WebSocket data frames
    }
    @endcode

    @param stream_id the HTTP/2 stream ID from the CONNECT request
    @param status_code the HTTP status code to send (200 to accept, 4xx to reject)
    @param headers hash of response headers

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object for sending the response

    @throw SOCKET-NOT-OPEN The socket is not connected
    @throw HTTP2-ERROR HTTP/2 CONNECT response submission failed or stream is not a CONNECT request

    @since %Qore 2.3
*/
AbstractPollOperation Socket::startPollSendHttp2ConnectResponse(int stream_id, int status_code,
        *hash<auto> headers) {
    s->ref();

    ReferenceHolder<SocketPollOperationBase> poller(
        new SocketHttp2SendResponsePollOperation(xsink, s, nullptr, stream_id, status_code,
            headers, nullptr, true),  // is_connect=true
        xsink
    );
    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("http2-connect-response"), xsink);
    }
    return rv.release();
}

//! Waits for an HTTP/2 stream's send buffer to drain below the backpressure threshold
/** @par Example:
    @code{.py}
    while (True) {
        try {
            sock.sendHttp2StreamData(stream_id, chunk);
            break;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "HTTP2-FLOW-CONTROL") {
                controllers[idx].wakeSocket(sock);
                sock.waitForHttp2StreamDrain(stream_id, 5s);
                continue;
            }
            rethrow;
        }
    }
    @endcode

    Blocks the calling thread until the stream's internal buffer drops below the
    backpressure threshold (1 MB), the stream is closed, or the timeout expires.

    Unlike polling with usleep(), this method uses a condition variable signaled by
    the I/O thread when buffer space is freed, providing deterministic wakeup with
    no wasted CPU cycles.

    @note This method does NOT acquire the socket lock, so it is safe to call from
    a handler thread while the I/O thread is running.

    @param stream_id the HTTP/2 stream ID
    @param timeout_ms maximum wait time in milliseconds (0 = no wait, -1 = infinite)

    @return 0 if buffer drained, 1 if timed out, -1 if stream not found or closed

    @since %Qore 2.3
*/
int Socket::waitForHttp2StreamDrain(int stream_id, timeout timeout_ms = 5s) {
    SocketSyncPoll::assertNotOnIoThread("Socket", "waitForHttp2StreamDrain", xsink);
    if (*xsink) {
        return -1;
    }
    return s->waitForHttp2StreamDrain((int32_t)stream_id, (int)timeout_ms, xsink);
}

//! Submits HTTP/2 streaming response headers without body or END_STREAM
/** Used by server-side HTTP/2 handlers driven by an async I/O controller.
    The call copies caller-owned data and delegates HTTP/2 session mutation to
    the async I/O controller.

    Must be paired with @ref sendHttp2StreamData() and/or @ref sendHttp2Trailers();
    flushing to the wire is driven by the I/O thread's existing HTTP/2 flush poll
    operation.  This method wakes the registered async I/O controller; no explicit
    flush call is needed from the handler.

    @param stream_id the HTTP/2 stream ID
    @param status_code HTTP status code (e.g., 200)
    @param headers response headers

    @throw HTTP2-ERROR if no HTTP/2 session is active or submission fails

    @since %Qore 2.3
*/
nothing Socket::submitHttp2StreamingResponseHeaders(int stream_id, int status_code,
        *hash<auto> headers) {
    s->submitHttp2StreamingResponseHeadersAsync((int32_t)stream_id, status_code, headers, xsink);
    return QoreValue();
}

//! Sends HTTP/2 DATA frame payload on a server-side stream
/** Copies caller-owned data and delegates HTTP/2 DATA enqueue to the async I/O
    controller. After a successful enqueue, the registered async I/O controller
    is woken to flush pending frames.

    @param stream_id the HTTP/2 stream ID
    @param data the binary data to send
    @param end_stream set to @ref True "True" to end the stream after sending

    @throw HTTP2-ERROR if no HTTP/2 session is active
    @throw HTTP2-FLOW-CONTROL raised when the stream's send buffer is full; the
    caller should drain via @ref waitForHttp2StreamDrain() and retry

    @since %Qore 2.3
*/
nothing Socket::sendHttp2StreamData(int stream_id, *binary data, softbool end_stream = False) {
    s->sendHttp2StreamDataAsync((int32_t)stream_id, data, (bool)end_stream, xsink);
    return QoreValue();
}

//! Sends HTTP/2 trailer headers on a server-side stream
/** Copies caller-owned data and delegates trailer submission to the async I/O
    controller.

    Submits a trailing HEADERS frame with END_STREAM on the specified stream.
    The stream's data provider is configured to use NGHTTP2_DATA_FLAG_NO_END_STREAM
    on the last DATA frame so that the trailer HEADERS frame carries END_STREAM.

    This is required for protocols like gRPC that communicate status via HTTP/2
    trailers (e.g., \c grpc-status, \c grpc-message).

    @param stream_id the HTTP/2 stream ID
    @param trailers trailer header name/value pairs

    @throw HTTP2-ERROR if no HTTP/2 session is active or trailer submission fails

    @since %Qore 2.3
*/
nothing Socket::sendHttp2Trailers(int stream_id, hash<string, string> trailers) {
    s->sendHttp2TrailersAsync((int32_t)stream_id, trailers, xsink);
    return QoreValue();
}

//! Removes an HTTP/2 stream from the session
/** Delegates stream bookkeeping removal to the async I/O controller.

    @param stream_id the HTTP/2 stream ID to remove

    @since %Qore 2.3
*/
nothing Socket::cleanupHttp2Stream(int stream_id) {
    s->cleanupHttp2StreamAsync((int32_t)stream_id);
    return QoreValue();
}

//! Send RST_STREAM to abort an HTTP/2 stream and clean up the stream state
/** Delegates RST_STREAM submission and stream cleanup to the async I/O
    controller.

    @param stream_id the HTTP/2 stream ID to reset

    @throw HTTP2-ERROR if the RST_STREAM submission fails

    @since %Qore 2.3
*/
nothing Socket::resetHttp2Stream(int stream_id) {
    s->resetHttp2StreamAsync((int32_t)stream_id, xsink);
    return QoreValue();
}

//! Submit HTTP/2 streaming response with InputStream body (non-blocking)
/** Handler thread calls this and returns immediately. The I/O thread reads from the
    InputStream and sends DATA frames incrementally.

    The C++ vtable is the sole authority on I/O thread eligibility. If the stream's C++
    @ref InputStream::isIoThreadSafe() "isIoThreadSafe()" returns @ref False, this method
    returns \c 1 without submitting headers, so the caller can fall back to handler-thread
    streaming.

    @param stream_id the HTTP/2 stream ID
    @param status_code the HTTP status code
    @param headers optional response headers
    @param body the InputStream to read the response body from

    @return 0 = accepted for I/O thread streaming; 1 = not I/O-thread-safe, caller should
    use handler-thread fallback

    @throw HTTP2-ERROR if no HTTP/2 session is available or submission fails

    @since %Qore 2.3
*/
int Socket::submitHttp2StreamingResponseWithStream(int stream_id, int status_code,
        *hash<auto> headers, InputStream[InputStream] body) {
    // Pass raw pointer; only release from SimpleRefHolder if C++ takes ownership (rv == 0).
    // If rv == 1 (not I/O-thread-safe), the SimpleRefHolder destructor will deref the body.
    int rv = s->submitHttp2StreamingResponseWithStream((int32_t)stream_id, status_code, headers,
        *body, xsink);
    if (!rv && !*xsink) {
        body.release();
    }
    return rv;
}

//! Returns a poll operation that flushes pending HTTP/2 outgoing data
/** Drives the HTTP/2 session's @c sendPendingData() until no more data
    remains in the outbound buffer.  Useful from test or manual scenarios
    that enqueue frames via @ref sendHttp2StreamDataAsync() /
    @ref sendHttp2TrailersAsync() / @ref submitHttp2StreamingResponseHeadersAsync()
    and then need to push them to the wire without an async I/O controller.

    Under the @ref HttpServerAsyncIo "HttpServerAsyncIo" controller this is
    not needed — the I/O thread's existing flush poll operation drives the
    session.

    @par Example:
    @code{.py}
    sock.submitHttp2StreamingResponseHeaders(stream_id, 200, headers);
    sock.sendHttp2StreamData(stream_id, body_data, False);
    sock.sendHttp2Trailers(stream_id, {"grpc-status": "0"});

    AbstractPollOperation flush_op = sock.startPollHttp2Flush();
    while (True) {
        *hash<SocketPollInfo> info = flush_op.continuePoll();
        if (!info) {
            break;
        }
        Socket::poll((info,), 10s);
    }
    @endcode

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object for flushing pending data

    @throw SOCKET-NOT-OPEN The socket is not connected

    @since %Qore 2.3
*/
AbstractPollOperation Socket::startPollHttp2Flush() {
    s->ref();
    ReferenceHolder<SocketPollOperationBase> poller(
        new SocketHttp2FlushPollOperation(xsink, s),
        xsink
    );
    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("http2-flush"), xsink);
    }
    return rv.release();
}

//! Returns a poll operation for HTTP/2 client multiplexed connection handling
/** This poll operation manages an HTTP/2 client connection with support for multiple
    concurrent streams (true HTTP/2 multiplexing). Unlike simple request-response patterns,
    this operation:
    - Continuously reads HTTP/2 frames from the server
    - Dispatches completed responses via the session's stream completion callback
    - Supports submitting new requests while responses are being received
    - Handles flow control, PING, and GOAWAY frames automatically

    @par Example:
    @code{.py}
    # After establishing an HTTP/2 connection
    AbstractPollOperation op = sock.startPollHttp2ClientMultiplex();

    # The operation continuously reads responses - use callbacks for dispatch
    while (op.getState() != "closed") {
        *hash<SocketPollInfo> info = op.continuePoll();
        if (!info) {
            break;
        }
        Socket::poll((info,), 1s);
    }
    @endcode

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object for the multiplexed connection

    @throw SOCKET-NOT-OPEN The socket is not connected
    @throw HTTP2-ERROR if HTTP/2 session initialization failed

    @note This operation is designed for use with \c Http2ClientConnectionManager which handles
    stream callback registration and request submission.

    @since %Qore 2.3
*/
AbstractPollOperation Socket::startPollHttp2ClientMultiplex() {
    s->ref();
    ReferenceHolder<SocketPollOperationBase> poller(new SocketHttp2ClientMultiplexPollOperation(xsink, s), xsink);
    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("http2-client-multiplex"), xsink);
    }
    return rv.release();
}

//! Submits an HTTP/2 request on an active multiplexed client connection
/** @par Example:
    @code{.py}
    int stream_id = sock.submitHttp2Request(headers, body);
    @endcode

    @param headers HTTP/2 pseudo-headers and regular headers (must include :method, :path, :scheme, :authority)
    @param body optional request body
    @param streaming if @ref True "True", the request body will be sent in streaming mode

    @return the stream ID assigned to this request

    @throw HTTP2-ERROR if no HTTP/2 session is active or an error occurs

    @note This method requires an active HTTP/2 client session, typically established via
    @ref startPollHttp2ClientMultiplex()

    @since %Qore 2.3
*/
int Socket::submitHttp2Request(hash<auto> headers, *data body, bool streaming = False) {
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (body) {
        switch (body->getType()) {
            case NT_BINARY: {
                const BinaryNode* b = static_cast<const BinaryNode*>(body);
                body_ptr = b->getPtr();
                body_len = b->size();
                break;
            }
            case NT_STRING: {
                const QoreStringNode* str = static_cast<const QoreStringNode*>(body);
                body_ptr = str->c_str();
                body_len = str->size();
                break;
            }
            default:
                xsink->raiseException("HTTP2-ERROR", "body must be string or binary, got type '%s'",
                    body->getTypeName());
                return -1;
        }
    }

    int stream_id = s->submitHttp2Request(headers, body_ptr, body_len, xsink, streaming);
    return stream_id;
}

//! Cancels a pending HTTP/2 stream
/** @par Example:
    @code{.py}
    sock.cancelHttp2Stream(stream_id);
    @endcode

    @param stream_id the stream ID to cancel

    @throw HTTP2-ERROR if no HTTP/2 session is active or an error occurs

    @since %Qore 2.3
*/
nothing Socket::cancelHttp2Stream(int stream_id) {
    s->cancelHttp2Stream(stream_id, xsink);
}

//! Returns a poll operation for a QUIC client: performs QUIC handshake, sets up HTTP/3, and reads responses
/** @par Example:
    @code{.py}
    # Bind a UDP socket and start a QUIC client connection
    Socket sock();
    sock.bindINET("0.0.0.0", 0, True, AF_INET);
    AbstractPollOperation op = sock.startPollQuicConnect("example.com", 443);
    @endcode

    @param host the remote host to connect to
    @param port the remote port to connect to
    @param family the address family to use; default is @ref AF_INET

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object to perform the QUIC
    handshake and read HTTP/3 responses

    The @ref Qore::AbstractPollOperation::getOutput() "AbstractPollOperation::getOutput()" call will return a hash
    with the following keys after a successful response:
    - \c status_code: the HTTP/3 response status code
    - \c method: the request method
    - \c path: the request path
    - \c stream_id: the HTTP/3 stream ID
    - \c headers: response headers hash
    - \c body: response body (binary)
    - \c session_id: the QUIC session ID

    @throw QUIC-ERROR if QUIC/HTTP/3 support is not available or address resolution fails
    @throw SOCKET-NOT-OPEN if the socket is not open

    @note Requires a UDP socket bound with @ref bindINET() before calling this method

    @since %Qore 2.3
*/
AbstractPollOperation Socket::startPollQuicConnect(string host, int port, int family = AF_INET) {
    if (port < 1 || port > 65535) {
        xsink->raiseException("QUIC-ERROR", "port %d is out of range (1-65535)", (int)port);
        return QoreValue();
    }
    s->ref();
    ReferenceHolder<SocketPollOperationBase> poller(
        new SocketQuicClientPollOperation(xsink, s, host->c_str(), static_cast<uint16_t>(port), family),
        xsink
    );
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("quic-connect"), xsink);
    }
    return rv.release();
}

//! Returns a poll operation for a QUIC server: accepts a QUIC connection and reads HTTP/3 requests
/** @par Example:
    @code{.py}
    # Bind a UDP socket and accept QUIC connections
    Socket sock();
    sock.bindINET("0.0.0.0", 8443, True, AF_INET);
    AbstractPollOperation op = sock.startPollQuicAccept();
    @endcode

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object to accept a QUIC connection
    and read the first HTTP/3 request

    The @ref Qore::AbstractPollOperation::getOutput() "AbstractPollOperation::getOutput()" call will return a hash
    with the following keys after a successful request:
    - \c method: the HTTP/3 request method
    - \c path: the request path
    - \c stream_id: the HTTP/3 stream ID
    - \c authority: the request authority (host)
    - \c scheme: the request scheme
    - \c headers: request headers hash; multi-value headers are concatenated into a single
      string per RFC standards: \c cookie values are joined with \c "; " (RFC 9114 section 4.2.1),
      \c set-cookie values are kept as a list (RFC 7230 section 3.2.2), and all other multi-value
      headers are joined with \c ", " (RFC 7230 section 3.2.6)
    - \c body: request body (binary), if present
    - \c session_id: the QUIC session ID
    - \c peer_address: the remote peer IP address
    - \c peer_port: the remote peer port

    @throw QUIC-ERROR if QUIC/HTTP/3 support is not available
    @throw SOCKET-NOT-OPEN if the socket is not open

    @param opts optional options hash:
    - \c "headers_only": if @ref True, dispatches requests as soon as headers are received
      (before the full body arrives); the handler reads body data incrementally via
      @ref readQuicStreamDataBlock().  When enabled:
      - The poll operation completes when HEADERS are received (not when the full body arrives)
      - The output hash will have \c body set to @ref nothing
      - The output hash includes \c hdr set to @ref True to indicate headers-only dispatch
      - The output hash includes \c headers_end_stream: @ref True if END_STREAM was set
        on the HEADERS frame (e.g., GET requests with no body)
      - The handler must call @ref readQuicStreamDataBlock() to read body data and
        @ref cleanupQuicStream() when done

    @par Headers-Only Example
    @code{.py}
    Socket sock();
    sock.bindINET("0.0.0.0", 8443, True, AF_INET);
    AbstractPollOperation op = sock.startPollQuicAccept({"headers_only": True});
    while (*hash<SocketPollInfo> info = op.continuePoll()) {
        Socket::poll((info,), 10s);
    }
    hash<auto> request = op.getOutput();
    # request.hdr is True — body must be read incrementally
    if (!request.headers_end_stream) {
        binary body = binary();
        while (True) {
            *binary chunk = sock.readQuicStreamDataBlock(request.session_id,
                request.stream_id, 30s);
            if (!exists chunk) {
                break;
            }
            body += chunk;
        }
        sock.cleanupQuicStream(request.session_id, request.stream_id);
    }
    @endcode

    @note Requires a UDP socket bound with @ref bindINET() before calling this method

    @since %Qore 2.3
*/
AbstractPollOperation Socket::startPollQuicAccept(*hash<auto> opts) {
    s->ref();
    ReferenceHolder<SocketPollOperationBase> poller(new SocketQuicServerPollOperation(xsink, s), xsink);
    if (*xsink) {
        return QoreValue();
    }

    // Apply options
    if (opts) {
        SocketQuicServerPollOperation* sqspo = reinterpret_cast<SocketQuicServerPollOperation*>(*poller);
        if (opts->getKeyValue("headers_only").getAsBool()) {
            sqspo->setHeadersOnly(true);
        }
        int64 max_body = opts->getKeyValue("max_request_body_size").getAsBigInt();
        if (max_body > 0) {
            sqspo->setMaxRequestBodySize(max_body);
        }
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("quic-accept"), xsink);
    }
    return rv.release();
}

//! Returns a poll operation to send an HTTP/3 response over QUIC
/** @par Example:
    @code{.py}
    # After receiving an HTTP/3 request via startPollQuicAccept()
    AbstractPollOperation op = sock.startPollQuicSendResponse(session_id, stream_id, 200, headers, body);
    @endcode

    @param session_id the QUIC session ID from the request
    @param stream_id the HTTP/3 stream ID from the request
    @param status_code the HTTP/3 response status code
    @param headers response headers
    @param body optional response body

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object to send the HTTP/3 response

    @throw QUIC-ERROR if QUIC/HTTP/3 support is not available or no session with the given ID exists
    @throw SOCKET-NOT-OPEN if the socket is not open

    @since %Qore 2.3
*/
AbstractPollOperation Socket::startPollQuicSendResponse(int session_id, int stream_id, int status_code,
        *hash<auto> headers, *data body) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    if (status_code < 100 || status_code >= 600) {
        xsink->raiseException("QUIC-ERROR", "invalid status_code %d: must be 100-599", (int)status_code);
        return QoreValue();
    }
    s->ref();
    ReferenceHolder<SocketPollOperationBase> poller(
        new SocketQuicSendResponsePollOperation(xsink, s, session_id, stream_id, status_code, headers, body),
        xsink
    );
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("quic-response"), xsink);
    }
    return rv.release();
}

//! Returns @ref True if the socket has an active QUIC/HTTP/3 session
/** @par Example:
    @code{.py}
    if (sock.isQuic()) {
        printf("Socket is using QUIC/HTTP/3\n");
    }
    @endcode

    @return @ref True if the socket has an active QUIC session

    @since %Qore 2.3
*/
bool Socket::isQuic() [flags=CONSTANT] {
    return s->isQuic();
}

//! Submits an HTTP/3 request on an active QUIC client connection
/** @par Example:
    @code{.py}
    int stream_id = sock.submitQuicRequest("GET", "/api/resource");
    @endcode

    @param method HTTP method (GET, POST, etc.)
    @param path request path
    @param headers optional request headers
    @param body optional request body

    @return the stream ID assigned to this request

    @throw QUIC-ERROR if no QUIC session is active or an error occurs

    @note This method requires an active QUIC session, typically established via
    @ref startPollQuicConnect()

    @since %Qore 2.3
*/
int Socket::submitQuicRequest(string method, string path, *hash<auto> headers, *data body) {
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (extractQuicBodyPtrLen(body, body_ptr, body_len, xsink)) {
        return -1;
    }
    int64_t stream_id = s->submitQuicRequest(method->c_str(), path->c_str(), headers, body_ptr, body_len, xsink);
    return stream_id;
}

//! Submits a streaming HTTP/3 request (headers only, no END_STREAM) on the client QUIC session
/** @par Example:
    @code{.py}
    int stream_id = sock.submitQuicRequestStreaming("POST", "/api/stream", headers);
    sock.sendQuicClientStreamData(stream_id, chunk1);
    sock.sendQuicClientStreamData(stream_id, chunk2);
    sock.sendQuicClientStreamData(stream_id, NOTHING, True);  # end stream
    @endcode

    Opens a bidirectional HTTP/3 stream for incremental data exchange.  The request
    headers are sent without END_STREAM; body data is provided incrementally via
    @ref sendQuicClientStreamData().

    @param method HTTP method (POST, etc.)
    @param path request path
    @param headers optional request headers

    @return the stream ID assigned to this request

    @throw QUIC-ERROR if no QUIC session is active or an error occurs

    @since %Qore 2.3
*/
int Socket::submitQuicRequestStreaming(string method, string path, *hash<auto> headers) {
    int64_t stream_id = s->submitQuicRequestStreaming(method->c_str(), path->c_str(), headers, xsink);
    return stream_id;
}

//! Returns @ref True if the QUIC session on this socket is closed or absent
/** @par Example:
    @code{.py}
    if (sock.isQuicSessionClosed()) {
        throw "HTTP3-CONNECTION-CLOSED", "QUIC session is closed";
    }
    @endcode

    Checks whether the QUIC connection has entered CLOSING, DRAINING, or
    idle-closed state. Returns @ref True if no QUIC session exists.

    @return @ref True if the session is closed or absent

    @since %Qore 2.3
*/
bool Socket::isQuicSessionClosed() [flags=CONSTANT] {
    return s->isQuicSessionClosed();
}

//! Sends body data on a client-side streaming HTTP/3 request
/** @par Example:
    @code{.py}
    int rv = sock.sendQuicClientStreamData(stream_id, chunk_data);
    if (rv == 1) {
        # buffer full — wait for drain before retrying
        sock.waitForQuicClientStreamDrain(stream_id, 5s);
    }
    sock.sendQuicClientStreamData(stream_id, NOTHING, True);  # end stream
    @endcode

    @param stream_id the stream ID from submitQuicRequestStreaming()
    @param body optional body data to send
    @param end_stream set to True to signal the end of the request body

    @return 0 on success, 1 if buffer full (backpressure), -1 on error

    @throw QUIC-ERROR if no QUIC session is active

    @since %Qore 2.3
*/
int Socket::sendQuicClientStreamData(int stream_id, *data body, softbool end_stream = False) {
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0",
            (long long)stream_id);
        return -1;
    }
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (extractQuicBodyPtrLen(body, body_ptr, body_len, xsink)) {
        return -1;
    }
    int rc = s->sendQuicClientStreamData(stream_id, body_ptr, body_len, (bool)end_stream, xsink);
    return rc;
}

//! Waits for a client-side HTTP/3 streaming body buffer to drain
/** @par Example:
    @code{.py}
    while (sock.sendQuicClientStreamData(stream_id, chunk, False) == 1) {
        sock.waitForQuicClientStreamDrain(stream_id, 5s);
    }
    @endcode

    Blocks until the stream's buffered data drops below the backpressure threshold,
    the stream is closed, or the timeout expires.

    @param stream_id the stream ID
    @param timeout_ms maximum wait time (0 = no wait, -1 = infinite)

    @return 0 if buffer drained, 1 if timed out, -1 if stream not found or closed

    @throw QUIC-ERROR if no QUIC session is active

    @since %Qore 2.3
*/
int Socket::waitForQuicClientStreamDrain(int stream_id, timeout timeout_ms = 5s) {
    SocketSyncPoll::assertNotOnIoThread("Socket", "waitForQuicClientStreamDrain", xsink);
    if (*xsink) {
        return -1;
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0",
            (long long)stream_id);
        return -1;
    }
    return s->waitForQuicClientStreamDrain(stream_id, (int)timeout_ms, xsink);
}

//! Returns the first QUIC session ID for this socket
/** @par Example:
    @code{.py}
    int session_id = sock.getQuicSessionId();
    @endcode

    This is useful for client connections which have a single QUIC session.
    Returns 0 if no QUIC session is active.

    @return the session ID of the first (or only) QUIC session

    @since %Qore 2.3
*/
int Socket::getQuicSessionId() {
    return s->getFirstQuicSessionId(xsink);
}

//! Cancels a pending HTTP/3 stream on an active QUIC connection
/** @par Example:
    @code{.py}
    sock.cancelQuicStream(session_id, stream_id);
    @endcode

    @param session_id the QUIC session ID
    @param stream_id the stream ID to cancel

    @throw QUIC-ERROR if no QUIC session with the given ID is active

    @since %Qore 2.3
*/
nothing Socket::cancelQuicStream(int session_id, int stream_id) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    s->cancelQuicStream(session_id, stream_id, xsink);
}

//! Submits an HTTP/3 response on an active QUIC server connection
/** @par Example:
    @code{.py}
    sock.submitQuicResponse(session_id, stream_id, 200, {"content-type": "text/plain"}, "OK");
    @endcode

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID to respond on
    @param status_code the HTTP status code
    @param headers optional response headers
    @param body optional response body

    @throw QUIC-ERROR if no QUIC session with the given ID is active or submission fails

    @note This method requires an active QUIC server session, typically established via
    @ref startPollQuicAccept()

    @since %Qore 2.3
*/
nothing Socket::submitQuicResponse(int session_id, int stream_id, int status_code, *hash<auto> headers, *data body) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    if (status_code < 100 || status_code >= 600) {
        xsink->raiseException("QUIC-ERROR", "invalid status_code %d: must be 100-599", (int)status_code);
        return QoreValue();
    }
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (extractQuicBodyPtrLen(body, body_ptr, body_len, xsink)) {
        return QoreValue();
    }
    s->submitQuicResponse(session_id, stream_id, status_code, headers, body_ptr, body_len, xsink);
}

//! Sends an HTTP/3 GOAWAY shutdown notice on a QUIC session
/** @par Example:
    @code{.py}
    sock.submitQuicShutdownNotice(session_id);
    @endcode

    Sends a GOAWAY frame with the maximum stream ID (shutdown notice phase),
    indicating that the server intends to shut down.

    @param session_id the QUIC session ID

    @throw QUIC-ERROR if the session_id is invalid (<= 0)
    @throw QUIC-SESSION-ERROR if no QUIC session with the given ID is active
    @throw QUIC-HTTP3-ERROR if the HTTP/3 layer is not initialized or submission fails

    @since %Qore 2.3
*/
nothing Socket::submitQuicShutdownNotice(int session_id) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    s->submitQuicShutdownNotice(session_id, xsink);
}

//! Sends an HTTP/3 GOAWAY shutdown on a QUIC session
/** @par Example:
    @code{.py}
    sock.submitQuicShutdown(session_id);
    @endcode

    Sends a GOAWAY frame with the actual last stream ID that the server will
    process.  After this, no new streams will be accepted.

    @param session_id the QUIC session ID

    @throw QUIC-ERROR if the session_id is invalid (<= 0)
    @throw QUIC-SESSION-ERROR if no QUIC session with the given ID is active
    @throw QUIC-HTTP3-ERROR if the HTTP/3 layer is not initialized or submission fails

    @since %Qore 2.3
*/
nothing Socket::submitQuicShutdown(int session_id) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    s->submitQuicShutdown(session_id, xsink);
}

//! Returns GOAWAY state for a QUIC session
/** @par Example:
    @code{.py}
    hash<QuicGoawayStateInfo> state = sock.getQuicSessionGoawayState(session_id);
    if (state.goaway_received) {
        # connection is draining — streams above goaway_max_stream_id were not processed
    }
    @endcode

    @param session_id the QUIC session ID

    @return a @ref QuicGoawayStateInfo hash with the session's GOAWAY state

    @throw QUIC-ERROR if the session_id is invalid (<= 0)
    @throw QUIC-SESSION-ERROR if no QUIC session with the given ID is active

    @since %Qore 2.3
*/
hash<QuicGoawayStateInfo> Socket::getQuicSessionGoawayState(int session_id) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    return s->getQuicSessionGoawayState(session_id, xsink);
}

//! Returns True if a GOAWAY has been received from the peer on a QUIC session
/** @par Example:
    @code{.py}
    if (sock.isQuicGoawayReceived(session_id)) {
        # connection is draining
    }
    @endcode

    Lightweight check suitable for calling on every I/O cycle — avoids hash
    allocation.  Returns False (without raising an exception) if the session
    does not exist.

    @param session_id the QUIC session ID

    @return True if a GOAWAY has been received, False otherwise

    @since %Qore 2.3
*/
bool Socket::isQuicGoawayReceived(int session_id) {
    if (session_id <= 0) {
        return false;
    }
    return s->isQuicGoawayReceived(session_id, xsink);
}

//! Returns the peer (client) certificate from a QUIC session after TLS handshake
/** @par Example:
    @code{.py}
    *SSLCertificate cert = sock.getQuicPeerCertificate(session_id);
    if (cert) {
        string subject = cert.getSubjectHash();
    }
    @endcode

    For mutual TLS (mTLS) — returns the client's X.509 certificate presented during
    the QUIC/TLS 1.3 handshake. The server must have been configured with
    @ref SSL_VERIFY_PEER to request client certificates.

    @param session_id the QUIC session ID

    @return the peer's @ref Qore::SSLCertificate "SSLCertificate" object, or @ref nothing
    if no client certificate was presented

    @throw QUIC-ERROR if the session_id is invalid (<= 0)
    @throw QUIC-SESSION-ERROR if no QUIC session with the given ID is active

    @since %Qore 2.3
*/
*SSLCertificate Socket::getQuicPeerCertificate(int session_id) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    return s->getQuicPeerCertificate(session_id, xsink);
}

//! Creates a poll operation for sending an HTTP/3 streaming response via InputStream
/** @par Example:
    @code{.py}
    AbstractPollOperation op = sock.startPollQuicSendStreamingResponse(
        session_id, stream_id, 200, headers, input_stream);
    @endcode

    Reads chunks from the InputStream incrementally and sends them over the QUIC
    stream using the deferred data reader mechanism. This avoids buffering the
    entire response body in memory.

    @param session_id the QUIC session ID from the request
    @param stream_id the HTTP/3 stream ID from the request
    @param status_code the HTTP/3 response status code
    @param headers response headers
    @param body the InputStream providing the response body
    @param chunk_size optional chunk size for reading from the InputStream (default 16384)

    @return an @ref Qore::AbstractPollOperation "AbstractPollOperation" object to send the
    streaming HTTP/3 response

    @throw QUIC-ERROR if QUIC/HTTP/3 support is not available or no session with the given
    ID exists
    @throw SOCKET-NOT-OPEN if the socket is not open

    @since %Qore 2.3
*/
AbstractPollOperation Socket::startPollQuicSendStreamingResponse(int session_id, int stream_id,
        int status_code, *hash<auto> headers, InputStream[InputStream] body, *int chunk_size) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    if (status_code < 100 || status_code >= 600) {
        xsink->raiseException("QUIC-ERROR", "invalid status_code %d: must be 100-599", (int)status_code);
        return QoreValue();
    }
    // body ref is owned by QPP ReferenceHolder; poll operation takes ownership via release()
    InputStream* body_ptr = body.release();
    // Hold a strong reference to the QoreObject so the InputStream is not garbage collected
    QoreObject* body_obj = const_cast<QoreObject*>(obj_body);
    body_obj->ref();
    s->ref();

    ReferenceHolder<SocketPollOperationBase> poller(
        new SocketQuicSendStreamingResponsePollOperation(xsink, s, session_id, stream_id,
            status_code, headers, body_ptr, body_obj, chunk_size ? chunk_size : 16384),
        xsink
    );
    if (*xsink) {
        return QoreValue();
    }

    // Unassign the stream from the current thread so that the worker thread
    // calling continuePoll() can reassign it to itself
    body_ptr->unassignThread(xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_SOCKETPOLLOPERATION, getProgram(), *poller), xsink);
    poller->setSelf(*rv);
    poller.release();

    if (!*xsink) {
        rv->setValue("sock", self->objectRefSelf(), xsink);
        rv->setValue("goal", new QoreStringNode("quic-streaming-response"), xsink);
    }
    return rv.release();
}

//! Submits a streaming HTTP/3 response (headers only) on a QUIC session
/** @par Example:
    @code{.py}
    sock.submitQuicResponseStreaming(session_id, stream_id, 200, {"content-type": "text/plain"});
    # Then send data incrementally:
    sock.submitQuicStreamData(session_id, stream_id, chunk1);
    sock.submitQuicStreamData(session_id, stream_id, chunk2);
    sock.submitQuicStreamData(session_id, stream_id, NOTHING, True); # end stream
    @endcode

    Submits the response headers with a deferred body. Data is provided incrementally
    via @ref submitQuicStreamData(). The registered async I/O controller is woken
    after submission so the I/O thread can flush the data to the network.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID to respond on
    @param status_code the HTTP status code
    @param headers optional response headers

    @throw QUIC-ERROR if no QUIC session with the given ID is active
    @throw QUIC-HTTP3-ERROR if the HTTP/3 layer is not initialized or submission fails

    @since %Qore 2.3
*/
nothing Socket::submitQuicResponseStreaming(int session_id, int stream_id, int status_code,
        *hash<auto> headers) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    if (status_code < 100 || status_code >= 600) {
        xsink->raiseException("QUIC-ERROR", "invalid status_code %d: must be 100-599", (int)status_code);
        return QoreValue();
    }
    s->submitQuicResponseStreaming(session_id, stream_id, status_code, headers, xsink);
}

//! Sends body data on a streaming HTTP/3 response
/** @par Example:
    @code{.py}
    int rv = sock.submitQuicStreamData(session_id, stream_id, chunk_data);
    if (rv == 1) {
        # buffer full — wait for ACKs before retrying
    }
    sock.submitQuicStreamData(session_id, stream_id, NOTHING, True); # end stream
    @endcode

    Appends data to the stream's buffer and resumes the nghttp3 deferred data reader
    if it was waiting. The registered async I/O controller is woken after a
    successful enqueue so the I/O thread can flush pending packets.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID
    @param body optional body data to send
    @param end_stream set to True to signal the end of the response body

    @return 0 on success, 1 if buffer full (backpressure)

    @throw QUIC-ERROR if no QUIC session with the given ID is active
    @throw QUIC-HTTP3-ERROR if no streaming response for the given stream

    @since %Qore 2.3
*/
int Socket::submitQuicStreamData(int session_id, int stream_id, *data body,
        softbool end_stream = False) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return -1;
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return -1;
    }
    const void* body_ptr = nullptr;
    size_t body_len = 0;
    if (extractQuicBodyPtrLen(body, body_ptr, body_len, xsink)) {
        return -1;
    }
    int rc = s->submitQuicStreamData(session_id, stream_id, body_ptr, body_len,
        (bool)end_stream, xsink);
    return rc;
}

//! Submit HTTP/3 streaming response with InputStream body (non-blocking)
/** Handler thread calls this and returns immediately. The I/O thread reads from the
    InputStream and sends HTTP/3 DATA frames incrementally via the QUIC server poll operation.

    The C++ vtable is the sole authority on I/O thread eligibility. If the stream's C++
    @ref InputStream::isIoThreadSafe() "isIoThreadSafe()" returns @ref False, this method
    returns \c 1 without submitting headers, so the caller can fall back to handler-thread
    streaming.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID
    @param status_code the HTTP status code
    @param headers optional response headers
    @param body the InputStream to read the response body from

    @return 0 = accepted for I/O thread streaming; 1 = not I/O-thread-safe, caller should
    use handler-thread fallback

    @throw QUIC-ERROR if the session or stream is not found or submission fails

    @since %Qore 2.3
*/
int Socket::submitQuicStreamingResponseWithStream(int session_id, int stream_id,
        int status_code, *hash<auto> headers, InputStream[InputStream] body) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0",
            (long long)session_id);
        return -1;
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0",
            (long long)stream_id);
        return -1;
    }

    // C++ vtable is the sole authority on I/O thread eligibility.
    // Return 1 (not accepted) so the caller can fall back to handler-thread streaming.
    // Check BEFORE submitting headers — no partial response on rejection.
    if (!body->isIoThreadSafe()) {
        return 1;
    }

    int rv = s->submitQuicStreamingResponseWithStream(session_id, stream_id, status_code, headers, *body, xsink);
    if (!rv && !*xsink) {
        body.release();
    }
    return rv;
}

//! Waits for a streaming HTTP/3 body buffer to drain below the backpressure threshold
/** @par Example:
    @code{.py}
    while (sock.submitQuicStreamData(session_id, stream_id, chunk, False) == 1) {
        controllers[idx].wakeSocket(sock);
        # Deterministic wait — blocks until buffer drains or timeout expires
        sock.waitForQuicStreamDrain(session_id, stream_id, 5s);
    }
    @endcode

    Blocks the calling thread until the stream's internal buffer drops below the
    backpressure threshold (1 MB), the stream is closed, or the timeout expires.

    Unlike polling with usleep(), this method uses a condition variable signaled by
    the I/O thread when buffer space is freed, providing deterministic wakeup with
    no wasted CPU cycles.

    @note This method does NOT acquire the socket lock, so it is safe to call from
    a handler thread while the I/O thread is running. The I/O thread is free to
    call continuePoll() concurrently.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID
    @param timeout_ms maximum wait time in milliseconds (0 = no wait, -1 = infinite)

    @return 0 if buffer drained, 1 if timed out, -1 if stream not found or closed

    @throw QUIC-ERROR if no QUIC session with the given ID is active

    @since %Qore 2.3
*/
int Socket::waitForQuicStreamDrain(int session_id, int stream_id,
        timeout timeout_ms = 5s) {
    SocketSyncPoll::assertNotOnIoThread("Socket", "waitForQuicStreamDrain", xsink);
    if (*xsink) {
        return -1;
    }
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return -1;
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return -1;
    }
    return s->waitForQuicStreamDrain(session_id, stream_id, (int)timeout_ms, xsink);
}

//! Submits an HTTP/3 extended CONNECT response (RFC 9220)
/** Sends response headers without END_STREAM, keeping the stream open for
    bidirectional data transfer (WebSocket over HTTP/3). Subsequent data is sent
    via @ref submitQuicStreamData() and read via @ref readQuicConnectStreamData().

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID from the CONNECT request
    @param status_code the HTTP status code to send (200 to accept, 4xx to reject)
    @param headers optional response headers

    @throw QUIC-ERROR if no QUIC session with the given ID is active
    @throw QUIC-HTTP3-ERROR if the HTTP/3 layer is not initialized, stream is not a CONNECT request,
        or submission fails

    @since %Qore 2.3
*/
nothing Socket::submitQuicConnectResponse(int session_id, int stream_id, int status_code,
        *hash<auto> headers) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    if (status_code < 100 || status_code >= 600) {
        xsink->raiseException("QUIC-ERROR", "invalid status_code %d: must be 100-599", (int)status_code);
        return QoreValue();
    }
    s->submitQuicConnectResponse(session_id, stream_id, status_code, headers, xsink);
}

//! Reads data from an HTTP/3 extended CONNECT stream (RFC 9220)
/** Returns buffered data received on the bidirectional tunnel for the given stream.
    Used to read WebSocket frames from the client on an extended CONNECT stream.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID

    @return binary data if available, or @ref nothing if no data is buffered

    @throw QUIC-ERROR if no QUIC session with the given ID is active

    @since %Qore 2.3
*/
*binary Socket::readQuicConnectStreamData(int session_id, int stream_id) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    return s->readQuicConnectStreamData(session_id, stream_id, xsink);
}

//! Reads body data from a dispatched HTTP/3 stream (headers-only mode)
/** Blocks until body data is available, the stream completes (END_STREAM), or the
    timeout expires.  Used by handler threads to incrementally read request body data
    from streams that were dispatched via headers-only mode.

    @par HTTP/3 vs HTTP/2 Threading Model
    Unlike HTTP/2 where the handler thread drives the TCP socket directly,
    HTTP/3 uses a shared UDP socket where a dedicated I/O thread processes
    datagrams and buffers incoming data per stream.  This method uses a
    per-stream condition variable to wait for data, so only the handler for
    the specific stream that received data is woken (no thundering herd).

    @par Thread Safety
    This method intentionally does @b not acquire the Socket object's mutex, because
    holding the mutex during a blocking wait would prevent other threads from performing
    operations on the same socket.  Thread safety for the QUIC session internals is
    provided by the session's own recursive mutex.

    Multiple handler threads can safely call this method concurrently for different
    streams on the same session — each handler waits on its own per-stream condition
    variable.

    @par Stream Lifecycle
    When a stream is dispatched with the \c headers_only option via
    @ref startPollQuicAccept(), the stream remains in the QuicSession so that body
    data can be read incrementally with this method.  After all data has been consumed
    (this method returns @ref nothing), call @ref cleanupQuicStream() to free the
    stream state.  If the handler is invoked via the @ref HttpServer "HttpServer"
    framework, cleanup is handled automatically by the framework's \c on_exit handler.

    @par Typical Usage (Low-Level Socket API)
    @code{.py}
    # In a handler thread after receiving a headers-only dispatched request:
    int session_id = request.session_id;
    int stream_id = request.stream_id;
    binary body = binary();
    while (True) {
        *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 30s);
        if (!exists chunk) {
            # Stream complete — END_STREAM received and no more buffered data
            break;
        }
        body += chunk;
    }
    # Process the complete body
    process_body(body);
    # Clean up the stream state (required to prevent stream-state accumulation)
    sock.cleanupQuicStream(session_id, stream_id);
    @endcode

    @par Typical Usage (HttpServer Framework)
    @code{.py}
    class MyStreamingHandler inherits AbstractHttpRequestHandler {
        bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
            return True;
        }

        hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
            int session_id = cx."header-info".session_id;
            int stream_id = cx."header-info".stream_id;
            Socket sock = cx."header-info".sock;

            # Read body incrementally — the framework handles cleanup automatically
            binary accumulated = binary();
            while (True) {
                *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 30s);
                if (!exists chunk) {
                    break;
                }
                accumulated += chunk;
            }
            return makeResponse(200, process(accumulated));
        }
    }
    @endcode

    @par Timeout Handling
    @code{.py}
    # Use a short timeout and handle QUIC-STREAM-TIMEOUT for time-sensitive reads
    try {
        *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 5s);
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "QUIC-STREAM-TIMEOUT") {
            # Timeout — no data arrived within 5 seconds
            return makeResponse(408, "Request Timeout");
        }
        rethrow;
    }
    @endcode

    @par Session Closure
    If the QUIC session is closed (e.g., server shutdown or peer disconnect) while
    this method is waiting, it raises a \c QUIC-ERROR exception immediately rather
    than waiting for the timeout to expire.

    @param session_id the QUIC session ID (from \c cx."header-info".session_id)
    @param stream_id the HTTP/3 stream ID (from \c cx."header-info".stream_id)
    @param timeout the maximum time to wait for data; default 30s

    @return binary data if available, or @ref nothing if the stream is complete
    (END_STREAM received and no more buffered data)

    @throw QUIC-ERROR if no QUIC session with the given ID is active, or if the session
    is closed during the wait (e.g., server shutdown)
    @throw QUIC-STREAM-TIMEOUT if the timeout expires before data arrives or the stream
    completes

    @see @ref cleanupQuicStream()
    @see @ref isQuicStreamComplete()
    @see \c wantsBodyStreaming()

    @since %Qore 2.3
*/
*binary Socket::readQuicStreamDataBlock(int session_id, int stream_id, timeout timeout = 30s) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    return s->readQuicStreamDataBlock(session_id, stream_id, (int)timeout, xsink);
}

//! Check if an HTTP/3 stream has received END_STREAM
/** Returns @ref True "True" if all body data has been received for the given stream
    (i.e., END_STREAM has been received), or if the stream is not found in the session.

    @note In most cases, you do not need to call this method directly.
    @ref readQuicStreamDataBlock() returns @ref nothing when the stream is complete,
    which is the recommended way to detect end-of-stream in a read loop.  This method
    is useful for non-blocking status checks without attempting a read.

    @par Example
    @code{.py}
    # Non-blocking check whether more data is expected
    if (!sock.isQuicStreamComplete(session_id, stream_id)) {
        # More data may arrive — continue reading
        *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 30s);
    }
    @endcode

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID

    @return @ref True if END_STREAM has been received (body_complete) or the stream is
    not found (treat unknown streams as complete for safety)

    @see @ref readQuicStreamDataBlock()

    @since %Qore 2.3
*/
bool Socket::isQuicStreamComplete(int session_id, int stream_id) [flags=CONSTANT] {
    if (session_id <= 0 || stream_id < 0) {
        return true;
    }
    return s->isQuicStreamComplete(session_id, stream_id);
}

//! Remove a dispatched HTTP/3 stream from the session map
/** Called after the handler has finished processing all body data from a
    headers-only dispatched stream.  Releases the stream's state (buffered data,
    per-stream notifier, completion flag) from the QuicSession and prevents
    stream-state accumulation on long-lived connections.

    @par When to Call
    Call this method after @ref readQuicStreamDataBlock() returns @ref nothing
    (stream complete) or when the handler decides to stop reading (early return).
    If using the @ref HttpServer "HttpServer" framework with \c wantsBodyStreaming(),
    cleanup is handled automatically by the framework's \c on_exit handler — you do
    @b not need to call this manually.

    @par Typical Usage (Low-Level Socket API)
    @code{.py}
    # Read all data from a headers-only dispatched HTTP/3 stream
    binary body = binary();
    while (True) {
        *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 30s);
        if (!exists chunk) {
            break;
        }
        body += chunk;
    }
    # Free the stream state from the session
    sock.cleanupQuicStream(session_id, stream_id);
    @endcode

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID

    @throw QUIC-ERROR if no QUIC session with the given ID is active

    @see @ref readQuicStreamDataBlock()

    @since %Qore 2.3
*/
nothing Socket::cleanupQuicStream(int session_id, int stream_id) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    s->cleanupQuicStream(session_id, stream_id, xsink);
}

//! Register a Queue for direct data delivery on an HTTP/3 CONNECT tunnel stream
/** Data arriving on the CONNECT tunnel is pushed directly to the Queue from the
    QUIC receive callback, bypassing the intermediate buffer and eliminating the
    dependency on the I/O poll loop for data delivery.

    Any data that was buffered before registration is flushed to the Queue
    immediately.  When END_STREAM arrives, a @ref nothing sentinel is pushed
    and the registration is automatically removed.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID
    @param queue the Queue for data delivery (must be unlimited, i.e. created with max = -1)

    @throw QUIC-ERROR if session_id or stream_id is invalid

    @since %Qore 2.3
*/
nothing Socket::registerQuicConnectStreamQueue(int session_id, int stream_id, Queue[Queue] queue) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    // Queue must be unlimited to ensure pushAndTakeRef() never blocks inside
    // ngtcp2/nghttp3 callbacks where blocking would stall all QUIC I/O
    if (queue->getMax() != -1) {
        xsink->raiseException("QUIC-ERROR", "Queue must be unlimited (max = -1) for "
            "CONNECT stream data delivery; got max = %lld", (long long)queue->getMax());
        return QoreValue();
    }
    // Transfer the reference to QuicSession — it will deref() on cleanup
    s->registerQuicConnectStreamQueue(session_id, stream_id, queue.release(), xsink);
}

//! Deregister a Queue for an HTTP/3 CONNECT tunnel stream
/** @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID

    @since %Qore 2.3
*/
nothing Socket::deregisterQuicConnectStreamQueue(int session_id, int stream_id) {
    if (session_id <= 0) {
        return QoreValue();
    }
    if (stream_id < 0) {
        return QoreValue();
    }
    s->deregisterQuicConnectStreamQueue(session_id, stream_id, xsink);
}

//! Register a C++ WebSocket frame state machine for an HTTP/3 CONNECT tunnel
/** Once registered, the server-side QUIC receive path decodes WebSocket
    frames on the I/O thread (no per-chunk Qore-level concatenation) and
    pushes complete WS messages to @p queue as hashes of shape
    @c {type, data, [code, reason]}.  Only one entry is pushed per complete
    WebSocket message, even if the underlying transport delivered it in
    many small chunks.  Control frames (PING / CLOSE) are auto-handled
    by the state machine.

    @param session_id the QUIC session ID
    @param stream_id  the HTTP/3 stream ID
    @param queue      an unlimited Queue for completed-message delivery

    @throw QUIC-ERROR if session_id or stream_id is invalid

    @since %Qore 2.3
*/
nothing Socket::registerQuicConnectStreamFrameState(int session_id, int stream_id, Queue[Queue] queue) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0",
            (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0",
            (long long)stream_id);
        return QoreValue();
    }
    if (queue->getMax() != -1) {
        xsink->raiseException("QUIC-ERROR", "Queue must be unlimited (max = -1) for "
            "CONNECT stream frame delivery; got max = %lld", (long long)queue->getMax());
        return QoreValue();
    }
    s->registerQuicConnectStreamFrameState(session_id, stream_id, queue.release(), xsink);
}

//! Deregister the WebSocket frame state machine for an HTTP/3 CONNECT tunnel
/** @since %Qore 2.4 */
nothing Socket::deregisterQuicConnectStreamFrameState(int session_id, int stream_id) {
    if (session_id <= 0) {
        return QoreValue();
    }
    if (stream_id < 0) {
        return QoreValue();
    }
    s->deregisterQuicConnectStreamFrameState(session_id, stream_id, xsink);
}

//! Reset an HTTP/3 stream by shutting down the read side and cleaning up
/** Sends a STOP_SENDING signal to the peer for the given stream and removes the stream
    from the QUIC session.

    Use this when a body streaming error is detected mid-stream and remaining data must
    be discarded without corrupting subsequent requests on the same session.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID

    @throw QUIC-ERROR if no QUIC session with the given ID is active

    @since %Qore 2.3
*/
nothing Socket::resetQuicStream(int session_id, int stream_id) {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    s->resetQuicStream(session_id, stream_id, xsink);
}

//! Send a QUIC DATAGRAM frame associated with an HTTP/3 stream (RFC 9221/9297)
/** Sends an unreliable, unordered datagram payload on a QUIC datagram channel
    associated with the given HTTP/3 anchor stream.

    QUIC datagrams (RFC 9221) provide lower latency than streams by avoiding
    head-of-line blocking and retransmission.  HTTP/3 datagrams (RFC 9297)
    associate datagrams with HTTP/3 requests via the quarter-stream-ID.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID (anchor stream for the datagram channel)
    @param data the datagram payload to send

    @throw QUIC-ERROR if no QUIC session with the given ID is active or parameters are invalid
    @throw QUIC-DATAGRAM-NOT-SUPPORTED if the remote peer does not support QUIC datagrams
    @throw QUIC-DATAGRAM-SIZE-ERROR if the payload exceeds the maximum datagram size

    @since %Qore 2.3

    @see @ref readQuicDatagram()
    @see @ref getQuicMaxDatagramSize()
    @see @ref isQuicDatagramSupported()
*/
nothing Socket::submitQuicDatagram(int session_id, int stream_id, binary data) [dom=NETWORK] {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    s->submitQuicDatagram(session_id, stream_id, data, xsink);
}

//! Read the next incoming QUIC datagram for an HTTP/3 stream (RFC 9221/9297)
/** Blocks until a datagram arrives on the given anchor stream or the timeout expires.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID (anchor stream)
    @param timeout maximum wait time (default 30 seconds)

    @return the datagram payload as binary data, or @ref nothing on timeout

    @throw QUIC-ERROR if no QUIC session with the given ID is active or parameters are invalid

    @since %Qore 2.3

    @see @ref submitQuicDatagram()
*/
*binary Socket::readQuicDatagram(int session_id, int stream_id, timeout timeout = 30s) [dom=NETWORK] {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    return s->readQuicDatagram(session_id, stream_id, (int)timeout, xsink);
}

//! Registers a @ref Queue to receive incoming QUIC datagrams for a stream (RFC 9221/9297)
/** Async-path replacement for @ref readQuicDatagram() — once registered, incoming
    datagrams for @a stream_id are pushed to @a queue (as a @ref binary) by the
    I/O thread; handlers block on @c Queue::get(timeout) for delivery.  A
    @ref NOTHING sentinel is pushed when the QUIC session is closed.

    Any datagrams already buffered internally at registration time are drained
    into the Queue in arrival order so no frame is lost in the switch.

    Call @ref unregisterQuicDatagramQueue() when the handler is done reading.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID (anchor stream)
    @param queue the Queue to populate

    @throw QUIC-ERROR if no QUIC session with the given ID is active

    @since %Qore 2.3

    @see @ref unregisterQuicDatagramQueue()
    @see @ref readQuicDatagram()
*/
nothing Socket::registerQuicDatagramQueue(int session_id, int stream_id, Queue[Queue] queue) [dom=NETWORK] {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    // Queue must be unlimited (max = -1) — the recvDatagramCallback runs in the
    // ngtcp2 C callback and cannot block if the Queue fills up.  Matches the
    // contract of registerQuicConnectStreamQueue() for the same reason.
    if (queue->getMax() != -1) {
        xsink->raiseException("QUIC-ERROR", "Queue must be unlimited (max = -1) for "
            "datagram delivery; got max = %lld", (long long)queue->getMax());
        return QoreValue();
    }
    // Transfer the ref to QuicSession — it derefs on unregister / teardown.
    s->registerQuicDatagramQueue(session_id, stream_id, queue.release(), xsink);
    return QoreValue();
}

//! Unregisters the @ref Queue previously registered via @ref registerQuicDatagramQueue()
/** Subsequent datagrams for @a stream_id fall back to the internal buffered path
    used by legacy @ref readQuicDatagram() callers.  Idempotent — calling this
    without a prior register (or on a session that no longer exists) is a no-op.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID

    @since %Qore 2.3

    @see @ref registerQuicDatagramQueue()
*/
nothing Socket::unregisterQuicDatagramQueue(int session_id, int stream_id) [dom=NETWORK] {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return QoreValue();
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return QoreValue();
    }
    s->unregisterQuicDatagramQueue(session_id, stream_id, xsink);
    return QoreValue();
}

//! Get the maximum datagram payload size for a QUIC session (RFC 9221)
/** Returns the maximum payload that can be sent in a single QUIC DATAGRAM frame,
    accounting for quarter-stream-ID encoding overhead and path MTU.

    @param session_id the QUIC session ID
    @param stream_id the HTTP/3 stream ID (for overhead calculation)

    @return maximum payload size in bytes, or 0 if datagrams are not supported

    @throw QUIC-ERROR if no QUIC session with the given ID is active or parameters are invalid

    @since %Qore 2.3

    @see @ref submitQuicDatagram()
    @see @ref isQuicDatagramSupported()
*/
int Socket::getQuicMaxDatagramSize(int session_id, int stream_id) [dom=NETWORK] {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return 0;
    }
    if (stream_id < 0) {
        xsink->raiseException("QUIC-ERROR", "invalid stream_id %lld: must be >= 0", (long long)stream_id);
        return 0;
    }
    return s->getQuicMaxDatagramSize(session_id, stream_id, xsink);
}

//! Check if the remote peer supports QUIC datagrams (RFC 9221)
/** Returns @ref True if the remote peer advertised a non-zero @c max_datagram_frame_size
    in its QUIC transport parameters.

    @param session_id the QUIC session ID

    @return @ref True if datagrams are supported, @ref False otherwise

    @throw QUIC-ERROR if no QUIC session with the given ID is active

    @since %Qore 2.3

    @see @ref submitQuicDatagram()
    @see @ref getQuicMaxDatagramSize()
*/
bool Socket::isQuicDatagramSupported(int session_id) [dom=NETWORK] {
    if (session_id <= 0) {
        xsink->raiseException("QUIC-ERROR", "invalid session_id %lld: must be > 0", (long long)session_id);
        return false;
    }
    return s->isQuicDatagramSupported(session_id, xsink);
}
