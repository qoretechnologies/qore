*/
list<auto> sort_descending_stable(list<auto> values, string comparator) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
   ReferenceHolder<ResolvedCallReferenceNode> fr(getCallReference(comparator, xsink), xsink);
   return !fr ? QoreValue() : values->sortDescendingStable(*fr, xsink);
}

