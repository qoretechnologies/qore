*/
Program::importSystemApi() {
    qore_program_private::runtimeImportSystemApi(*p, xsink);
}

//! Sets a @ref call_reference "call reference" or @ref closure "closure" to run every time a new thread is started
/** This code can be used to initialize @ref threading_and_variables "global thread-local variables", for example.

    @param callback a @ref call_reference "call reference" or @ref closure "closure" to run every time a new thread is started or @ref nothing to clear any thread initialization code

    @return @ref True if there was already user initialization code set, @ref False if not

    @par Example:
    @code{.py}
pgm.setThreadInit(sub () { var = 123; });
    @endcode

    @note
    - the code will be run for all new threads, but is not run by this method for the current thread
    - the code runs only on a thread's first entry into the Program; to set a context every time a thread enters the
      Program, for threads that run the code of more than one Program, use
      @ref Qore::Program::setThreadEntryHandler() "setThreadEntryHandler()"
    - the garbage collector sees the Program's reference to the code: code that refers to this Program object,
      directly or through other objects or Programs, forms a reference cycle that is collected like any other once
      nothing outside it refers to it

    @since %Qore 3.0 a reference cycle through the thread initialization code is collected; before, it kept the
    Program and the values the code refers to alive until the code was cleared

    @see
    - @ref Qore::set_thread_init()
    - @ref Qore::Program::setThreadEntryHandler() "setThreadEntryHandler()"

    @since %Qore 0.8.13
*/
bool Program::setThreadInit(*code callback) [dom=THREAD_CONTROL; flags=NAMED_ARGS] {
    return qore_program_private::setThreadInit(*p, callback, xsink);
}

//! Sets, replaces or clears the code that runs every time a thread enters and leaves this Program
/** An embedding application that keeps a context of its own for each Program it runs (the identity of the code, or
    the restrictions that apply to it) can use these handlers to make that context follow each thread that runs the
    Program's code: the entry handler saves the thread's context and sets the Program's, and the exit handler restores
    the context it saved.  A thread runs the code of many Programs over its life (an async I/O callback worker or a
    thread pool worker runs the callbacks of every Program that uses it), so code that sets the context only on a
    thread's first entry into a Program, as code set with @ref Qore::Program::setThreadInit() "setThreadInit()" does,
    leaves the context of the last Program entered for the code of the next one.

    @param on_enter the code that runs when a thread enters this Program; it is called with no arguments, and the
    value it returns is passed to \a on_exit; @ref nothing for none
    @param on_exit the code that runs when the thread leaves the Program again; it is called with one argument, the
    value returned by \a on_enter (@ref nothing if there is no \a on_enter), so it must accept an argument; @ref
    nothing for none

    @return @ref True if the Program had handlers before, @ref False if not

    @par Example:
    @code{.py}
thread_local *string context;

Program pgm(PO_NO_THREAD_CONTROL);
pgm.setThreadEntryHandler(
    auto sub () { auto old = context; context = "pgm"; return old; },
    sub (auto old) { context = old; }
);
    @endcode

    @par When the Handlers Run
    - a thread enters this Program when it starts running the Program's code while it was running the code of
      another Program, or of no Program: a call of a function, method, closure or call reference that runs in this
      Program, a thread started by the Program's code (for its whole life), and a parse commit started from another
      Program; calls made in the Program while it is entered do not enter it again, and run no handlers
    - \a on_enter runs before any of the Program's code; on a thread's first entry into the Program, it runs before
      the Program's thread initialization code (see @ref Qore::Program::setThreadInit() "setThreadInit()"), so that
      code runs in the context that \a on_enter sets
    - \a on_exit runs when the entry ends, while the thread is still in the Program, and also when the entry ends
      because an exception is propagating
    - entries nest: if the Program's code calls code in another Program that then calls back into this Program, the
      callback is a new entry with its own pair of calls, and the context of the outer entry is restored when it
      returns; the handlers of each entry run in the reverse order of the entries
    - the entry and exit of a thread are paired: the \a on_exit that runs is the one set when \a on_enter ran, with
      the value it returned, even if the handlers have been replaced or cleared since; a replacement applies to the
      entries made after it, and handlers can be replaced while other threads run the Program's code
    - the handlers run in the thread's current context, including any sandbox restrictions of the calling code; code
      that a handler calls enters other Programs without running their handlers, so a handler cannot recurse into
      handlers
    - a thread cannot enter a Program that is being destroyed (the call raises \c PROGRAM-ERROR before any handler
      runs), except the thread destroying it, whose entries to run the destructors of the Program's data run the
      handlers; the handlers are cleared after that

    @par Exceptions
    If \a on_enter raises an exception, the thread does not run the Program's code: the call that entered the
    Program raises the exception instead, and no \a on_exit runs for that entry (a thread started in the Program
    ends without running its code).  An exception raised by \a on_exit is raised after any exception that was already
    propagating; the Program has been left in any case.

    @par Restrictions
    This method requires both @ref Qore::Program::setThreadInit() "setThreadInit()"'s functional domain (@ref
    Qore::PO_NO_THREAD_CONTROL "PO_NO_THREAD_CONTROL") and the domain of creating Program objects (@ref
    Qore::PO_NO_EMBEDDED_LOGIC "PO_NO_EMBEDDED_LOGIC"): it controls the context that
    every thread entering the Program runs in, which is a decision of the code that embeds the Program.  In addition,
    code cannot set the handlers of the Program it runs in, so that code that has its own Program object cannot remove
    or replace the context that the embedding code set for it.

    @par Performance
    Entering a Program that has no handlers costs one atomic load; a call within the entered Program costs one
    pointer comparison.  With handlers set, each entry takes the Program's thread data lock briefly to reference the
    handlers, and makes the calls of the handlers themselves.

    @throw THREAD-ENTRY-HANDLER-ERROR the calling code runs in this Program

    @note
    - the handlers are not run by this method for the current thread
    - the Program keeps strong references to the handlers until they are replaced or cleared, or the Program is
      destroyed; the garbage collector sees these references, so handlers that refer to this Program object,
      directly or through other objects or Programs (for example the handlers of two Programs that call each
      other's Program), form a reference cycle that is collected like any other once nothing outside it refers to
      it; a thread that has run the entry handler holds the handlers until it has run the exit handler, which
      keeps such a cycle until then

    @see @ref Qore::Program::setThreadInit() "setThreadInit()"

    @since %Qore 3.0
*/
bool Program::setThreadEntryHandler(*code on_enter, *code on_exit)
        [dom=THREAD_CONTROL,EMBEDDED_LOGIC; flags=NAMED_ARGS] {
    // code that has its own Program object must not change the context that the embedding code set for its thread
    // entries
    if (getProgram() == p) {
        xsink->raiseException("THREAD-ENTRY-HANDLER-ERROR", "code cannot set the thread entry handlers of the "
            "Program it runs in");
        return QoreValue();
    }
    return qore_program_private::setThreadEntryHandler(*p, on_enter, on_exit, xsink);
}

//! Subscribes a @ref Qore::Thread::Queue "Queue" to the lifecycle events of the background threads of this Program
/** Code that embeds a Program (a REPL, an IDE, a supervisor) can follow the threads that the Program's code starts
    with the \c background operator: when each starts, when cancellation is requested, and when and how it ended
    (normally, by an exception, by cancellation), and when the Program becomes idle.  The runtime pushes a
    @ref Qore::ProgramThreadEvent "ProgramThreadEvent" hash to the queue for each event; no code of the subscriber
    runs in the Program's threads, and the queue can be read by one thread for any number of threads observed.

    @param queue the queue to receive the events; it must have no maximum size, so that publishing an event never
    blocks the thread that publishes it
    @param opts options for the subscription; see @ref Qore::ProgramThreadEventOptions "ProgramThreadEventOptions"

    @return the subscription: its ID, which each event delivered for it carries, and a snapshot of the Program's
    running background threads; every event delivered for the subscription comes after the snapshot (its \c seq is
    greater than the snapshot's), so a thread is either in the snapshot or its \c "STARTED" event is delivered, and
    no event is missed or delivered twice

    @par Example:
    @code{.py}
Program pgm(PO_NEW_STYLE);
Queue events();
hash<ProgramThreadSubscription> sub = pgm.subscribeThreadEvents(events);
pgm.parse("background sub () { throw \"ERR\", \"error\"; }();", "example");
pgm.run();
while (True) {
    hash<ProgramThreadEvent> ev = events.get();
    if (ev.event == "FINISHED") {
        printf("thread %d: %s (%s)\n", ev.tid, ev.outcome, ev.error.err ?? "-");
        break;
    }
}
pgm.unsubscribeThreadEvents(sub.id);
    @endcode

    @par Thread Lifetime
    A background thread starts when it has been registered in the Program, before its code runs, and ends when it
    has left the Program and its thread-local data has been destroyed; its \c "FINISHED" event is published before
    its TID is released, so a thread that reuses the TID cannot publish \c "STARTED" before it.  TIDs are reused,
    so events also carry a \c thread_id that is unique in the process, and the \c thread_id of the thread that
    started the thread (\c parent_thread_id), from which the threads started by the Program's background threads
    can be told apart.  A thread that could not be started (the \c background operator raised an exception) has no
    events.  Threads that call the Program's code without being started by it with \c background (the thread that
    runs it, the threads of @ref Qore::call_async() "call_async()" and of thread pools, which the
    @ref Qore::Thread::Future "Future" or pool reports, I/O callbacks) are not background threads of the Program;
    they make the Program active, which \c "ACTIVITY" events report.

    @par Program Activity
    With @ref Qore::PTE_ACTIVITY "PTE_ACTIVITY", an \c "ACTIVITY" event is published when the Program becomes idle
    (no thread runs its code: @ref Qore::Program::getThreadCount() "getThreadCount()" is 0) and when it becomes
    active again.  An idle Program can become active at any time, so code that waits for it to be idle before
    parsing must check again when it parses.

    @par Program Destruction
    When the Program is destroyed, a \c "CLOSED" event is published once every background thread has published
    \c "FINISHED", and the subscription ends.

    @throw PROGRAM-THREAD-EVENT-ERROR the queue has a maximum size, the \c events option is invalid, the calling
    code runs in this Program, or the Program is being destroyed

    @note
    - the Program keeps a reference to the queue's data until the subscription is removed with
      @ref Qore::Program::unsubscribeThreadEvents() "unsubscribeThreadEvents()" or the Program is destroyed; remove
      it when the events are no longer read, as they are added to the queue until then
    - events refer to no objects or code, so they never keep the values of the Program's threads alive

    @see @ref Qore::Program::unsubscribeThreadEvents() "unsubscribeThreadEvents()"

    @since %Qore 3.0
*/
hash<ProgramThreadSubscription> Program::subscribeThreadEvents(Qore::Thread::Queue[Queue] queue,
        *hash<ProgramThreadEventOptions> opts) [dom=THREAD_CONTROL,EMBEDDED_LOGIC; flags=NAMED_ARGS] {
    // code that has its own Program object must not observe or control the embedding of its own threads
    if (getProgram() == p) {
        return xsink->raiseException("PROGRAM-THREAD-EVENT-ERROR", "code cannot subscribe to the thread events of "
            "the Program it runs in");
    }
    int64 events = QORE_PTE_DEFAULT;
    if (opts) {
        bool found;
        QoreValue v = opts->getKeyValueExistence("events", found);
        if (found && !v.isNothing()) {
            events = v.getAsBigInt();
            if (!events || (events & ~static_cast<int64>(QORE_PTE_ALL))) {
                return xsink->raiseException("PROGRAM-THREAD-EVENT-ERROR", "invalid value " QLLD " for the "
                    "'events' option; expecting a non-zero combination of the PTE_* constants", events);
            }
        }
    }
    // the hub takes the reference, also on error
    return qore_program_private::subscribeThreadEvents(*p, queue.release(), events, xsink);
}

//! Removes a subscription made with @ref Qore::Program::subscribeThreadEvents() "subscribeThreadEvents()"
/** Events already in the queue stay there; they can be told apart by their \c subscription_id key.

    @param id the ID of the subscription

    @return @ref True if the subscription was removed, @ref False if there is no such subscription (it was removed
    already, or ended with the Program's \c "CLOSED" event)

    @par Example:
    @code{.py}
pgm.unsubscribeThreadEvents(sub.id);
    @endcode

    @throw PROGRAM-THREAD-EVENT-ERROR the calling code runs in this Program

    @since %Qore 3.0
*/
bool Program::unsubscribeThreadEvents(int id) [dom=THREAD_CONTROL,EMBEDDED_LOGIC] {
    if (getProgram() == p) {
        return xsink->raiseException("PROGRAM-THREAD-EVENT-ERROR", "code cannot remove subscriptions to the thread "
            "events of the Program it runs in");
    }
    return qore_program_private::unsubscribeThreadEvents(*p, id, xsink);
}

//! returns a hash of global variables
/** @par Example:
    @code{.py}
hash<auto> h = pgm.getGlobalVars();
    @endcode

    @return a hash of global variables and their values

    @see @ref Qore::get_global_vars()

    @since %Qore 0.8.13
 */
hash<auto> Program::getGlobalVars() [flags=CONSTANT] {
   return p->getGlobalVars();
}

//! set the value of a global variable
/** @par Example:
    @code
pgm.setGlobalVarValue("a", 1);
    @endcode

    @param variable_name the name of the variable
    @param value the value to assign

    @throw UNKNOWN-VARIABLE the variable is not a global variable, or the variable name contains a NUL character (since %Qore 3.0)

    @note other exceptions could be thrown if the value cannot be assigned to the given variable

    @see @ref Qore::set_global_var_value()

    @since %Qore 0.8.13
 */
nothing Program::setGlobalVarValue(string variable_name, auto value) [flags=NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name another variable
    if (q_check_no_nul(variable_name->c_str(), variable_name->size(), "variable name", "variable names", "UNKNOWN-VARIABLE", xsink)) {
        return QoreValue();
    }
   p->setGlobalVarValue(variable_name->c_str(), value.refSelf(), xsink);
}

//! finds all variants of a function or class method and returns a list of the results
/** @param function_name the function or class method name; may also be namespace-justified

    @return a list of hashes for each resolved name; when matched, each hash element has the following keys:
    - \c desc: a string description of the call which includes the name and the full text call signature
    - \c params: a QoreListNode object that gives the params in a format that can be used by @ref Qore::ProgramControl::findFunctionStatementId "ProgramControl::findFunctionStatementId"

    @throw PROGRAM-ERROR thrown if the function cannot be found, or the function name contains a NUL character (since %Qore 3.0)

    @since %Qore 0.8.13

    @note the <a href="../../modules/reflection/html/index.html">reflection</a> module supercedes this functionality
*/
list<hash<auto>> Program::findFunctionVariants(string function_name) [flags=NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name another function
    if (q_check_no_nul(function_name->c_str(), function_name->size(), "function name", "function names", "PROGRAM-ERROR", xsink)) {
        return QoreValue();
    }
    ReferenceHolder<QoreListNode> vl(p->runtimeFindCallVariants(function_name->c_str(), xsink), xsink);
    if (!vl)
        return xsink->raiseException("PROGRAM-ERROR", "cannot find any function \"%s\"", function_name->c_str());
    return vl.release();
}

//! returns a list of thread IDs active in this Program
/** @par Example:
    @code
list<int> l = pgm.getThreadList();
    @endcode

    @return a list of thread IDs active in this Program

    @note the %Program of a user module does not list the threads that run its code for calls from other Programs;
    those threads are listed by the Programs that called it (see @ref user_module_runtime_context)

    @since %Qore 0.8.13
*/
list<int> Program::getThreadList() [flags=CONSTANT] {
    return p->getThreadList();
}

//! returns the number of threads currently active in this Program
/** @par Example:
    @code{.py}
int count = pgm.getThreadCount();
    @endcode

    @return the number of threads currently active in this Program

    @since %Qore 3.0
*/
int Program::getThreadCount() [flags=CONSTANT] {
    return p->getThreadCount();
}

//! Waits until no threads or parsing operations are active in this Program
/** @param limit timeout in milliseconds or a relative date; omitted/zero waits indefinitely, negative checks only
    @return true when idle, false on timeout
    @throw PROGRAM-THREAD-ERROR the calling thread is active in this Program
    @note Cancellable and event-driven. Does not wait for final thread-local cleanup or reserve the Program
    for parsing; callers must still handle a new thread starting before their next operation.
    @par Example:
    @code{.py}
background sub () { pgm.waitForThreads(); queue.push("program-idle"); }();
    @endcode
    @since %Qore 3.0
*/
bool Program::waitForThreads(*timeout limit) [dom=THREAD_CONTROL,EMBEDDED_LOGIC] {
    return p->waitForThreads(xsink, limit == 0 ? -1 : (limit < 0 ? 0 : limit));
}

//! Waits for a specific thread to leave this Program
/** @param tid positive thread ID @param limit same semantics as waitForThreads()
    @return true if the thread has left or is not active here, false on timeout
    @throw PROGRAM-THREAD-ERROR invalid ID or self-wait
    @note Does not join final thread-local cleanup; use thread_join() for owned process-level threads.
    @since %Qore 3.0
*/
bool Program::waitForThread(int tid, *timeout limit) [dom=THREAD_CONTROL,EMBEDDED_LOGIC] {
    if (tid <= 0 || tid > INT_MAX) {
        xsink->raiseException("PROGRAM-THREAD-ERROR", "thread ID must be a positive native integer");
        return false;
    }
    return p->waitForThreads(xsink, limit == 0 ? -1 : (limit < 0 ? 0 : limit), tid);
}

//! Requests cooperative cancellation of one of this Program's threads
/** @param tid positive thread ID @param reason optional explanation
    @return true if cancellation was requested, false if the thread is no longer active here
    @throw PROGRAM-THREAD-ERROR invalid ID or self-cancellation
    @note The request is scoped to this Program even if the thread ID is recycled. Code can catch or defer
    cancellation; waitForThreads() observes actual completion. This method never forcibly kills a native thread.
    @since %Qore 3.0
*/
bool Program::cancelThread(int tid, *string reason) [dom=THREAD_CONTROL,EMBEDDED_LOGIC] {
    if (tid <= 0 || tid > INT_MAX) {
        xsink->raiseException("PROGRAM-THREAD-ERROR", "thread ID must be a positive native integer");
        return false;
    }
    return p->cancelThread(tid, reason ? reason->c_str() : nullptr, xsink);
}

//! Requests cooperative cancellation of all threads in this Program
/** @param reason optional explanation @return number of registered threads receiving a request
    @throw PROGRAM-THREAD-ERROR called from inside this Program
    @note Includes starting threads and descendants until the Program next becomes idle, also the threads that a
    @ref Qore::SandboxManager::createSystemThreadCall() "system thread capability" of this Program starts.
    Cancellation can be caught or deferred; use waitForThreads() to observe completion. A later evaluation is
    unaffected.
    @since %Qore 3.0
*/
int Program::cancelThreads(*string reason) [dom=THREAD_CONTROL,EMBEDDED_LOGIC] {
    return p->cancelThreads(xsink, reason ? reason->c_str() : nullptr);
}

//! Get @ref Qore::ProgramControl "ProgramControl"
/**
 */
ProgramControl Program::getProgram() [flags=RET_VALUE_ONLY; dom=DEBUGGER] {
   // the Program object holds a reference to the Program
   QoreObject* o = qore_program_private::getProgramControl(p);
   assert(o);
   return o;
}

//! issues a module command for the given module
/** The module is loaded into the current %Program object if it is not already present

    @par Example:
    @code{.py}
pgm.issueModuleCmd("jni", "define-class " + java_class_path_name + " " + byte_code.toBase64());
    @endcode

    @param module_name the module name
    @param command the command string to execute to be parsed by the module

    @throw PARSE-COMMAND-ERROR the module does not support commands

    @note command errors can result in other module- and command-specific exceptions being thrown; see
    documentation for the module and command in question for more details

    @since %Qore 0.9
*/
nothing Program::issueModuleCmd(string module_name, string command) [dom=MODULES; flags=NAMED_ARGS] {
    TempEncodingHelper tmp_module(module_name, QCS_DEFAULT, xsink);
    if (!tmp_module) {
        return QoreValue();
    }

    TempEncodingHelper tmp_cmd(command, QCS_DEFAULT, xsink);
    if (!tmp_cmd) {
        return QoreValue();
    }

    QMM.issueRuntimeCmd(tmp_module->c_str(), p, **tmp_cmd, xsink);
}

//! resolve the string as a call reference in the given Program
/** @param identifier the string to resolve; function or static class method, can include namespace path

    @return the call reference to the given function or static method; the string is resolved as follows:
    - a name with a class path (<tt>Class::method</tt>, also with a namespace path) is looked up as a public static
      method of the class; a non-static method raises \c CALL-REFERENCE-ERROR, as this method runs without an object
    - if not found, then a function lookup is made
    - if not found, an \c CALL-REFERENCE-ERROR exception is thrown

    @throw CALL-REFERENCE-ERROR cannot resolve call reference; method not accessible in the calling context; a
    non-static method (which needs an object; use <object>::getCallReference() in the object's code); the identifier
    contains a NUL character (since %Qore 3.0)

    @note
    - use <object>::getCallReference() to get call references to non-public class methods; this builtin function
      will always run without any class context, however pseudo-methods run with the class context of the caller, which
      enables it to access any accessible private method
    - call references to non-static methods contain a weak reference to the object; the lifetime of the object is not
      extended by the call reference

    @see
    - @ref Qore::get_call_reference()
    - <object>::getCallReference()

    @since %Qore 0.9.4
 */
code Program::getCallReference(string identifier) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    QoreProgramContextHelper pch(p);
    return get_call_reference_intern(runtime_get_stack_object(), identifier, xsink);
}

//! returns an expression object for the given source code
/** @param source The source to the expression
    @param label the label for the expression

    @since %Qore 0.9.5
*/
Expression Program::getExpression(string source, string label) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreExpression> exp(new QoreExpression(*p, *source, *label, xsink), xsink);
    if (!*xsink) {
        return new QoreObject(QC_EXPRESSION, p, exp.release());
    }
    return QoreValue();
}

//! Returns a list of strings of the builtin and module-supplied features of Qore
/** @return a list of strings of the builtin and module-supplied features of Qore

    @since %Qore 1.0
*/
list<string> Program::getFeatureList() [flags=RET_VALUE_ONLY] {
    return p->getFeatureList();
}

//! Returns the capability mask of the program
/** @return the capability mask of the program

    @since %Qore 2.0
*/
int Program::getCapabilityMask() [flags=RET_VALUE_ONLY] {
    return p->getParseOptions().getLo();
}

//! Returns the LLVM optimization level used when JIT-compiling this %Program's functions
/** @return the level set with
    @ref Qore::Program::setJitOptimizationLevel() "Program::setJitOptimizationLevel()", or the process-wide default (see
    @ref jit_optimization_level) if this %Program has no override of its own

    @par Example:
    @code{.py}
int level = pgm.getJitOptimizationLevel();
    @endcode

    @see
    - @ref Qore::Program::setJitOptimizationLevel() "Program::setJitOptimizationLevel()"
    - @ref jit_optimization_level

    @since %Qore 3.0
 */
int Program::getJitOptimizationLevel() [flags=CONSTANT] {
    return p->getJitOptimizationLevel();
}

//! Sets the LLVM optimization level used when JIT-compiling this %Program's functions
/** @param level the optimization level to use: 0 (no optimization) to 3 (most aggressive), or -1
    to clear this %Program's override so that the process-wide default applies again

    @par Example:
    @code{.py}
pgm.setJitOptimizationLevel(3);
    @endcode

    @throw PROGRAM-JIT-OPTIMIZATION-LEVEL-ERROR the level given is not -1 or in the range 0 - 3

    @note The level is read when a function is compiled, so it affects functions compiled after the
    call; functions already compiled to native code keep the code they were compiled with

    @see
    - @ref Qore::Program::getJitOptimizationLevel() "Program::getJitOptimizationLevel()"
    - @ref jit_optimization_level

    @since %Qore 3.0
 */
nothing Program::setJitOptimizationLevel(softint level) [flags=NAMED_ARGS] {
    if (p->setJitOptimizationLevel(static_cast<int>(level))) {
        xsink->raiseException("PROGRAM-JIT-OPTIMIZATION-LEVEL-ERROR", "JIT optimization level "
            QLLD " is invalid; expecting 0 - 3, or -1 to use the process-wide default", level);
    }
}

//! Returns the capability mask of the program n calls above this call
/** @param frame_offset the number of stack frames above this call; must be a non-negative number

    @return the capability mask of the program \a frame_offset calls above this call

    @since %Qore 2.0
*/
static int Program::getCallerCapabilityMask(int frame_offset = 1)
        [flags=RET_VALUE_ONLY,NAMED_ARGS,CURRENT_THREAD_ONLY;dom=PROCESS] {
    if (frame_offset < 0) {
        xsink->raiseException("INVALID-STACK-FRAME", "The stack frame argument must be a non-negative number; got "
            QLLD, frame_offset);
        return -1;
    }
    return !frame_offset
        ? runtime_get_parse_options().getLo()
        : runtime_get_parse_options_stack(xsink, (size_t)frame_offset).getLo();
}

//! Issues a module command for the given module in the current Program object
/** The module is loaded into the current %Program object if it is not already present

    @par Example:
    @code{.py}
Program::issueModuleCmd("jni", "define-class " + java_class_path_name + " " + byte_code.toBase64());
    @endcode

    @param module_name the module name
    @param command the command string to execute to be parsed by the module

    @throw PARSE-COMMAND-ERROR the module does not support commands

    @note command errors can result in other module- and command-specific exceptions being thrown; see
    documentation for the module and command in question for more details

    @since %Qore 2.0
*/
static nothing Program::issueModuleCmd(string module_name, string command) [dom=MODULES; flags=NAMED_ARGS] {
    TempEncodingHelper tmp_module(module_name, QCS_DEFAULT, xsink);
    if (!tmp_module) {
        return QoreValue();
    }

    TempEncodingHelper tmp_cmd(command, QCS_DEFAULT, xsink);
    if (!tmp_cmd) {
        return QoreValue();
    }

    QMM.issueRuntimeCmd(tmp_module->c_str(), getProgram(), **tmp_cmd, xsink);
}

//! Returns the capability mask of the current program
/** @return the capability mask of the current program

    @since %Qore 2.0
*/
static int Program::getCapabilityMask() [flags=RET_VALUE_ONLY] {
    QoreProgram* pgm = getProgram();
    return pgm ? pgm->getParseOptions().getLo() : runtime_get_parse_options().getLo();
}

//! Checks if a parse option is set in the current Program by name
/** @param name the name of the parse option to check (e.g., "broken-soft-types", "require-types", etc.)

    @return @ref True if the parse option is set in the current Program, @ref False otherwise

    @throw PARSE-OPTION-ERROR if the parse option name is not recognized, or the parse option name contains a NUL character (since %Qore 3.0)

    @note This function checks both standard (lo-word) and extended (hi-word) parse options

    @par Example:
    @code{.py}
if (Program::hasParseOption("broken-soft-types")) {
    printf("broken-soft-types is enabled\n");
}
    @endcode

    @since %Qore 3.0
 */
static bool Program::hasParseOption(string name) [flags=CONSTANT,NAMED_ARGS] {
    // the name is looked up as a C string, which would be cut at a NUL character and name another parse
    if (q_check_no_nul(name->c_str(), name->size(), "parse option name", "parse option names", "PARSE-OPTION-ERROR", xsink)) {
        return false;
    }
    QoreParseOptions opts = runtime_get_parse_options();
    QoreParseOptions opt = ParseOptionMap::find_code(name->c_str());
    if (opt == QoreParseOptions(-1)) {
        xsink->raiseException("PARSE-OPTION-ERROR", "unknown parse option: '%s'", name->c_str());
        return false;
    }
    return opts.hasAll(opt);
}

//! Returns the full parse options as a ParseOptions object (including extended options)
/** @return a @ref Qore::ParseOptions object with all parse options for the current Program

    @par Example:
    @code{.py}
ParseOptions po = Program::getFullParseOptions();
if (po.hasAny("broken-soft-types")) {
    printf("broken-soft-types is enabled\n");
}
    @endcode

    @since %Qore 3.0
 */
static ParseOptions Program::getFullParseOptions() [flags=CONSTANT] {
    QoreObject* obj = new QoreObject(QC_PARSEOPTIONS, getProgram());
    obj->setPrivate(CID_PARSEOPTIONS, new QoreParseOptionsData(runtime_get_parse_options()));
    return obj;
}

//! Retrieves all @ref conditional_parsing "parse defines" in the current Program
/** @return the hash of values of all @ref conditional_parsing "parse defines" in the current Program

    @par Example:
    @code{.py}
*hash<auto> val = Program::getAllDefines();
    @endcode

    @note A parse define may be defined with no value then values may have nothing values

    @since %Qore 3.0
 */
static *hash<auto> Program::getAllDefines() [flags=CONSTANT;dom=PROCESS] {
   return qore_program_private::runTimeGetAllDefines(getProgram());
}

//! Returns the LLVM optimization level used when JIT-compiling the current %Program's functions
/** @return the level set for the current %Program, or the process-wide default (see
    @ref jit_optimization_level) if the current %Program has no override of its own

    @par Example:
    @code{.py}
int level = Program::getJitOptimizationLevel();
    @endcode

    @see
    - @ref Qore::Program::setJitOptimizationLevel() "Program::setJitOptimizationLevel()"
    - @ref jit_optimization_level

    @since %Qore 3.0
 */
static int Program::getJitOptimizationLevel() [flags=CONSTANT;dom=PROCESS] {
    return getProgram()->getJitOptimizationLevel();
}

//! Sets the LLVM optimization level used when JIT-compiling the current %Program's functions
/** @param level the optimization level to use: 0 (no optimization) to 3 (most aggressive), or -1
    to clear the current %Program's override so that the process-wide default applies again

    @par Example:
    @code{.py}
Program::setJitOptimizationLevel(3);
    @endcode

    @throw PROGRAM-JIT-OPTIMIZATION-LEVEL-ERROR the level given is not -1 or in the range 0 - 3

    @note The level is read when a function is compiled, so it affects functions compiled after the
    call; functions already compiled to native code keep the code they were compiled with

    @see
    - @ref Qore::Program::getJitOptimizationLevel() "Program::getJitOptimizationLevel()"
    - @ref jit_optimization_level

    @since %Qore 3.0
 */
static nothing Program::setJitOptimizationLevel(softint level) [flags=NAMED_ARGS;dom=PROCESS] {
    if (getProgram()->setJitOptimizationLevel(static_cast<int>(level))) {
        xsink->raiseException("PROGRAM-JIT-OPTIMIZATION-LEVEL-ERROR", "JIT optimization level "
            QLLD " is invalid; expecting 0 - 3, or -1 to use the process-wide default", level);
    }
}

//! Saves a %Qore object in the %Program's object cache, holding a strong reference to it
/** Objects created from languages without deterministic garbage collection (such as Java via the
    \c jni module or Python via the \c python module) have non-deterministic lifetimes governed by
    the foreign runtime's garbage collector.  Saving such an object in the %Program's object cache
    gives it a deterministic lifetime: the object is held with a strong reference until it is
    explicitly cleared (with @ref Qore::Program::clearObject() "Program::clearObject()" or
    @ref Qore::Program::clearObjectCache() "Program::clearObjectCache()") or until the %Program is
    destroyed, at which point the object's destructor runs while the %Program is still valid.

    @param obj the object to save in the cache; saving the same object more than once has no
    additional effect

    @see
    - @ref Qore::Program::clearObject() "Program::clearObject()"
    - @ref Qore::Program::clearObjectCache() "Program::clearObjectCache()"
    - @ref Qore::Program::objectCacheSize() "Program::objectCacheSize()"

    @since %Qore 3.0
*/
nothing Program::saveObject(object obj) {
    qore_program_private::get(*p)->saveObject(const_cast<QoreObject*>(obj));
}

//! Removes an object from the %Program's object cache and dereferences it
/** @param obj the object to remove from the object cache

    @return @ref True if the object was present in the cache and was removed, @ref False if not

    @see @ref Qore::Program::saveObject() "Program::saveObject()"

    @since %Qore 3.0
*/
bool Program::clearObject(object obj) {
    return qore_program_private::get(*p)->clearObject(const_cast<QoreObject*>(obj), xsink);
}

//! Returns the date/time the object was saved in the object cache, or @ref nothing if not cached
/** @param obj the object to check

    @return the date/time the object was cached, or @ref nothing if the object is not in the cache

    @since %Qore 3.0
*/
*date Program::checkObjectCache(object obj) {
    int64 epoch = qore_program_private::get(*p)->checkSavedObject(const_cast<QoreObject*>(obj));
    // the stored timestamp is a UTC epoch (q_epoch()); present it as an absolute date in the
    // current time zone
    return epoch ? DateTimeNode::makeAbsolute(currentTZ(), epoch, 0) : QoreValue();
}

//! Clears the entire object cache, dereferencing all saved objects
/** @return the number of objects cleared from the cache

    @since %Qore 3.0
*/
int Program::clearObjectCache() {
    return qore_program_private::get(*p)->clearSavedObjects(xsink);
}

//! Clears all objects saved in the cache at or before the given date/time
/** @param cutoff objects saved at or before this date/time are cleared from the cache

    @return the number of objects cleared from the cache

    @since %Qore 3.0
*/
int Program::clearObjectCache(date cutoff) {
    // the stored timestamps are UTC epochs (q_epoch()); compare against the cutoff's UTC epoch
    return qore_program_private::get(*p)->clearSavedObjectsBefore(cutoff->getEpochSecondsUTC(), xsink);
}

//! Returns the number of objects in the %Program's object cache
/** @return the number of objects in the %Program's object cache

    @since %Qore 3.0
*/
int Program::objectCacheSize() {
    return (int64)qore_program_private::get(*p)->getSavedObjectCount();
}
