#include "qore/Qore.h"
#include "qore/intern/QC_SocketPollOperationBase.h"

//! Abstract poll operation object returned by Socket polling methods
/** This class implements the polling logic and the state machine behind it

    It has two \c private:internal members, which only this class reads and writes:
    - object sock: the socket object
    - string goal: the polling goal

    A subclass gets the goal with getGoal() and the socket with the \c getSocket() method of the poll operations
    that have one; a subclass of @ref Qore::PollPipeline "PollPipeline" sets the goal with
    @ref Qore::PollPipeline::setGoal() "PollPipeline::setGoal()".  A member of the same name that a subclass declares
    is a member of its own.  The operations of @ref Qore::SocketPollOperation "SocketPollOperation" objects (also
    those of the synchronous @ref Qore::Socket "Socket" calls) keep the socket and the goal with the operation instead
    of in these members, so that no member storage is allocated for them; the library accesses both forms with
    \c qore_poll_op_set_member() and \c qore_poll_op_get_referenced_member().

    This class is only usable by internal classes; it is not directly usable by %Qore classes.

    @since %Qore 1.12

    @note since %Qore 3.0 the members are \c private:internal; before, they were \c private, so a subclass could read
    and write them, and they were shown with the object (qore#6839)
*/
qclass SocketPollOperationBase<T> [
    internal_members=object sock,string goal;
    ns=Qore;
    arg=SocketPollOperationBase* poll;
    vparent=AbstractPollOperation<T>;
    legacy_raw;
];

//! Throws an exception; this class is not usable by %Qore classes
/** @throw INTERNAL-ONLY this class is not usable by %Qore classes
*/
SocketPollOperationBase::constructor() {
    xsink->raiseException("INTERNAL-ONLY", "the SocketPollOperationBase class is not usable by Qore classes; "
        "inherit a builtin derived class");
}

//! Destroys the object
/**
*/
SocketPollOperationBase::destructor() {
    // the socket and the goal that the operation keeps with it are released with the object, as its members are
    // (qore#6839)
    qore_poll_op_release_members(poll, xsink);
    poll->deref(xsink);
}

//! Returns the goal
/** @return the goal set in the constructor
*/
string SocketPollOperationBase::getGoal() {
    return qore_poll_op_get_referenced_member(self, "goal", xsink);
}

//! Returns the current state
/** @return the current state
*/
string SocketPollOperationBase::getState() [flags=RET_VALUE_ONLY] {
    return poll->getState();
}

//! Returns @ref True when the goal as been reached
/** @return @ref True when the goal as been reached
*/
bool SocketPollOperationBase::goalReached() [flags=RET_VALUE_ONLY] {
    return poll->goalReached();
}

//! Returns any output generated by any completed poll action
/** @return any output generated by any completed poll action
*/
T SocketPollOperationBase::getOutput() [flags=RET_VALUE_ONLY] {
    return poll->getOutput();
}

//! Aborts any asynchroous operation in progress and closes the connected object
/**
*/
SocketPollOperationBase::abort() {
    poll->abort(xsink);
}
