#include <qore/Qore.h>
#include "qore/intern/QC_DebugProgram.h"
#include "qore/intern/QC_Program.h"
#include "qore/intern/qore_program_private.h"
#include "qore/intern/QoreObjectIntern.h"
#include "qore/intern/AbstractStatement.h"

/** @defgroup debug_rs_options Debug Run State Constants

    These are the possible values that can be passed back to program as result to control next debugging process

    @since %Qore 0.8.13
*/
///@{
//! Detach program from debugging, it is not normally used from script
const DebugDetach = DBG_RS_DETACH;

//! Run program, avoid stepping
const DebugRun = DBG_RS_RUN;

//! Run one step in program, in case of function call stepping goes on in function
const DebugStep = DBG_RS_STEP;

//! Run one step in program, in case of function call stepping does not go to function
const DebugStepOver = DBG_RS_STEP_OVER;

//! Run program till function is exited
const DebugUntilReturn = DBG_RS_UNTIL_RETURN;

//! A request that a debugger can set as the run state in an event: the thread is detached and is not offered to the debugger again
/** No @ref Qore::DebugProgram::onAttach() "onAttach()" (and so no @ref Qore::DebugProgram::onDetach() "onDetach()")
    is called for the thread when it enters the program again, as for a thread of another program that calls into
    the debugged program (a callback, a logger) and that the debugger does not want to debug.  It is not a run state
    of a thread.  The thread is offered again after @ref Qore::DebugProgram::attachThread() "DebugProgram::attachThread()",
    or when the program's debugger changes; it is not remembered for a later thread that gets the same thread ID.

    @since %Qore 3.0
*/
const DebugDontAttach = DBG_RS_DONT_ATTACH;

//  const DebugStopped = DBG_RS_STOPPED = 5,    // not needed
///@}

/** @defgroup debug_flow_options Debug Flow Constants
    These are the possible values that are passed back to program to change flow, i.e. exit loops or function from debugger

    Code that was already running when the debugger attached does not take every request with the IR, JIT and tiered
    execution modes; see @ref debugger_running_code

    @since %Qore 0.8.13
 */
///@{
//! force @ref return command
const DebugFlowReturn = RC_RETURN;
//! force @ref break command
const DebugFlowBreak = RC_BREAK;
//! force @ref continue command
const DebugFlowContinue = RC_CONTINUE;
///@}

//! DebugProgram class supports %Qore @ref Qore::Program "Program" debugging via @ref Qore::ProgramControl "ProgramControl".
/** One instance may be assigned to one or more @ref Qore::ProgramControl "ProgramControl" instances which may
    run in one or more threads.
    @ref Qore::ProgramControl "ProgramControl" is added to the debugging list, next the program being debugged notifies the debugger when the next execution event occurs. Calling of notification method is always
    performed in the program thread. When the program flow is to be interrupted
    then it happens in the notification method of this class. Then debugger decides to continue and then returns from the notification function
    and passes @ref debug_rs_options value "step option" code back.

    The debugger should probably handle control in separate thread.

    The notification methods run with the cancellation of the thread deferred (see @ref Qore::defer_thread_cancel()
    "defer_thread_cancel()"), so that the code of the debugger always completes and the debugged code is cancelled
    where it would be without the debugger: a cancellation point in the debugger's code, such as a loop, a lock or a
    wait for a client while the thread is stopped, does not raise a cancellation, which is raised when the method
    returns if it arrived while the method ran, and otherwise where the debugged code raises it.  A thread that is
    cancelled while it is stopped therefore stays stopped until the debugger resumes it: @ref Qore::cancel_thread()
    "cancel_thread()" and @ref Qore::Program::cancelThreads() "Program::cancelThreads()" do not end a stopped thread,
    and a %Program interrupt or a sandbox limit is likewise raised only when the debugged code runs again.  The
    methods of a debugger object of a sandboxed %Program run without the deferral, as sandboxed code never runs with
    it.

    The DebugProgram class defines the interface and the real functionality should be implemented in a child class.

    @par Example:
    @code{.py}

    const code = "for (int i=0; i<10; i++) {}";

    class MyDebugProgram dbg() inherits DebugProgram {
    private:
       onAttach(ProgramControl program, reference run_state, reference run_to_statement_id) {
          run_state = DebugStep;
       }
    }

    ProgramControl p = ProgramControl::getProgram();
    dbg.addProgram(p);

    pgm.parse(code);
    pgm.saveProgram();
    pgm.run();

    @endcode

    @since %Qore 0.8.13
*/
qclass DebugProgram [dom=DEBUGGER; arg=QoreDebugProgramWithQoreObject* dpgm;];

//! Creates the debug program object with notification functions without any functionality
/**
 *
 */
DebugProgram::constructor() {
   self->setPrivate(CID_DEBUGPROGRAM, new QoreDebugProgramWithQoreObject(self));
}

//! Throws an exception to prevent objects of this class from being copied
/**
    @throw DEBUGPROGRAM-COPY-ERROR copying DebugProgram objects is unsupported
 */
DebugProgram::copy() {
   xsink->raiseException("DEBUGPROGRAM-COPY-ERROR", "copying DebugProgram objects is unsupported");
}

//! Waits for all threads to finish executing, then deletes all global variables, dereferences the internal Program object and deletes the %Qore object
/**
 *
 */
DebugProgram::destructor() {
   dpgm->waitForTerminationAndClear(xsink);
   dpgm->deref(xsink);
}

//! Clear all programs and wait for all threads to finish executing callbacks
/**
 *
 */
nothing DebugProgram::waitForTerminationAndClear() {
   dpgm->waitForTerminationAndClear(xsink);
}

//! Get number of interrupted threads
/**
 *
 */
int DebugProgram::getInterruptedCount() [flags=CONSTANT] {
   return dpgm->getInterruptedCount();
}

//! Add program to debugging
/**
 * @param program the program to add to debugging
 */
nothing DebugProgram::addProgram(ProgramControl[QoreProgram] program) [flags=NAMED_ARGS] {
    // another tenant's Program is not used in a trusted build that a tenant called (qore#6536)
    if (qore_sandbox_check_program_isolation(*program, xsink, "accessing a Program")) {
        return QoreValue();
    }
   dpgm->addProgram(*program, xsink);
}

//! Remove program from debugging
/**
 * @param program the program to remove from debugging
 */
nothing DebugProgram::removeProgram(ProgramControl[QoreProgram] program) [flags=NAMED_ARGS] {
    // another tenant's Program is not used in a trusted build that a tenant called (qore#6536)
    if (qore_sandbox_check_program_isolation(*program, xsink, "accessing a Program")) {
        return QoreValue();
    }
   dpgm->removeProgram(*program);
}

//! Get all programs being debugged
/**
 *
 */
list DebugProgram::getAllPrograms() {
   return dpgm->getAllProgramObjects();
}
//! Executed when new thread is attached to program being debugged
/**
    @param program the program being debugged
    @param run_state a reference to the run state to return to the program; @ref Qore::DebugDontAttach "DebugDontAttach"
    for a thread that the debugger does not want to debug: it is not offered again (see
    @ref Qore::DebugProgram::attachThread() "attachThread()")
    @param run_to_statement_id a reference to the statement ID to run to
 */
abstract nothing DebugProgram::onAttach(ProgramControl[QoreProgram] program, reference run_state, reference run_to_statement_id) [flags=NAMED_ARGS];

//! Executed when a thread is detached from the program being debugged
/**
    @param program the program being debugged
    @param run_state a reference to the run state to return to the program
    @param run_to_statement_id a reference to the statement ID to run to
 */
abstract nothing DebugProgram::onDetach(ProgramControl[QoreProgram] program, reference run_state, reference run_to_statement_id) [flags=NAMED_ARGS];

//! Executed when step is performed
/**
    @param program the program being debugged
    @param block_statement_id the statement ID for the current statement block; 0 for the block of the top-level code,
    which has no statement ID (ProgramControl::getStatementIdInfo() does not resolve it)
    @param statement_id the statement ID for the current statement, if available
    @param breakpoint_id the breakpoint ID, if a breakpoint triggered the callback
    @param flow a reference to the flow-control action to return to the program (see @ref debug_flow_options); code
    that was already running when the debugger attached does not take every request with the IR, JIT and tiered
    execution modes (see @ref debugger_running_code)
    @param run_state a reference to the run state to return to the program
    @param run_to_statement_id a reference to the statement ID to run to
 */
abstract nothing DebugProgram::onStep(ProgramControl[QoreProgram] program, int block_statement_id, *int statement_id, *int breakpoint_id, reference flow, reference run_state, reference run_to_statement_id) [flags=NAMED_ARGS];

//! Executed when a function is entered.
/**
    @param program the program being debugged
    @param statement_id the statement ID for the entered function
    @param run_state a reference to the run state to return to the program
    @param run_to_statement_id a reference to the statement ID to run to

    @see
       @ref Qore::ProgramControl::getStatementIdInfo "ProgramControl::getStatementIdInfo"
 */
abstract nothing DebugProgram::onFunctionEnter(ProgramControl[QoreProgram] program, int statement_id, reference run_state, reference run_to_statement_id) [flags=NAMED_ARGS];

//! Executed when a function is exited.
/**
    @param program the program being debugged
    @param statement_id the statement ID for the exited function
    @param return_value a reference to the return value
    @param run_state a reference to the run state to return to the program
    @param run_to_statement_id a reference to the statement ID to run to

    @see
       @ref Qore::ProgramControl::getStatementIdInfo "ProgramControl::getStatementIdInfo"
 */
abstract nothing DebugProgram::onFunctionExit(ProgramControl[QoreProgram] program, int statement_id, reference return_value, reference run_state, reference run_to_statement_id) [flags=NAMED_ARGS];

//! Executed when an exception is raised.
/** The method is called for each statement that the exception leaves, from the statement that raised it to the
    statement that catches it, if any; the exception hash has the same \c debug_id key in each call for the exception,
    also after a @ref rethrow "rethrow" of it, and a new exception has a new one, so that a debugger can stop at an
    exception once

    @param program the program being debugged
    @param statement_id the statement ID where the exception was raised
    @param exception the exception hash, with the \c debug_id key (see @ref Qore::ExceptionInfo "ExceptionInfo")
    @param dismiss a reference to the flag indicating if the exception should be dismissed
    @param run_state a reference to the run state to return to the program
    @param run_to_statement_id a reference to the statement ID to run to

    @see
       @ref Qore::ProgramControl::getStatementIdInfo "ProgramControl::getStatementIdInfo"
 */
abstract nothing DebugProgram::onException(ProgramControl[QoreProgram] program, int statement_id, hash exception, reference dismiss, reference run_state, reference run_to_statement_id) [flags=NAMED_ARGS];

//! Executed when the code of a thread ends, and by default when the code of a program run ends
/** The end of a program run calls @ref Qore::DebugProgram::onRunExit() "onRunExit()", whose default implementation
    calls this method.

    @param program the program being debugged
    @param statement_id the statement ID where the program or thread exited
    @param return_value a reference to the return value
    @param run_state a reference to the run state to return to the program
    @param run_to_statement_id a reference to the statement ID to run to

    @see
       @ref Qore::ProgramControl::getStatementIdInfo "ProgramControl::getStatementIdInfo"
 */
abstract nothing DebugProgram::onExit(ProgramControl[QoreProgram] program, int statement_id, reference return_value, reference run_state, reference run_to_statement_id) [flags=NAMED_ARGS];

//! Offers a thread that the debugger did not want (@ref Qore::DebugDontAttach "DebugDontAttach") to the debugger again
/** The thread is offered to the debugger (@ref Qore::DebugProgram::onAttach() "onAttach()") on its next entry into
    the program.

    @param program the program
    @param thread_id the ID of the thread

    @return @ref True if the thread has data in the program (it has entered it); @ref False, and nothing is done, if it
    has none (it has not entered the program, or it has ended), or if the program is not a debug target of this
    debugger

    @since %Qore 3.0
*/
bool DebugProgram::attachThread(ProgramControl[QoreProgram] program, int thread_id) [flags=NAMED_ARGS] {
    // another tenant's Program is not used in a trusted build that a tenant called (qore#6536)
    if (qore_sandbox_check_program_isolation(*program, xsink, "accessing a Program")) {
        return QoreValue();
    }
   return dpgm->attachThread(*program, thread_id);
}

//! Executed when the code of a program run ends: its top-level code, or its exec class, with the value that @ref Qore::Program::run() "Program::run()" returns
/** The default implementation calls @ref Qore::DebugProgram::onExit() "onExit()"; a debugger overrides it to tell the
    end of a program run from the end of a thread, which gives @ref Qore::DebugProgram::onExit() "onExit()" only.  It
    runs in the thread that called @ref Qore::Program::run() "Program::run()", in the context of the program.

    @param program the program being debugged
    @param statement_id the statement ID of the end, which is 0, as the top-level code has none
    @param return_value a reference to the value that @ref Qore::Program::run() "Program::run()" returns, which the
    debugger can replace; no value when the run ends with an exception
    @param run_state a reference to the run state to return to the program
    @param run_to_statement_id a reference to the statement ID to run to

    @since %Qore 3.0
 */
nothing DebugProgram::onRunExit(ProgramControl[QoreProgram] program, int[doc] statement_id, reference[doc] return_value, reference[doc] run_state, reference[doc] run_to_statement_id) [flags=NAMED_ARGS] {
   self->evalMethod("onExit", args, xsink);
}

//! Break particular program thread
/**
  * @param program the program to interrupt
  * @param thread_id the target thread ID to interrupt
  *
  * @return 0 if the operation was successful, returns -1 if the program does not allow debugging (i.e. @ref Qore::PO_NO_DEBUGGING is set), -2 if the program has not been set as a debug target, or -3 if the given thread is not active in the target program or cannot run debugger callbacks
  */
int DebugProgram::breakProgramThread(ProgramControl[QoreProgram] program, int thread_id) [flags=NAMED_ARGS] {
    // another tenant's Program is not used in a trusted build that a tenant called (qore#6536)
    if (qore_sandbox_check_program_isolation(*program, xsink, "accessing a Program")) {
        return QoreValue();
    }
   return dpgm->breakProgramThread(*program, thread_id);
}

//! Notes that the debugger ends a program by cancelling its threads
/** The threads of the program that end with a \c THREAD-CANCELLED exception, as when the debugger cancels them with
    @ref Qore::cancel_thread() "cancel_thread()" to end the program, end without reporting it as an unhandled
    exception, as their end is not an error; the thread that runs the program with
    @ref Qore::Program::run() "Program::run()" still raises it to the code that runs the program.  The program stays
    marked until it is deleted.

    @param program the program that the debugger ends

    @return 0 if the operation was successful, -1 if the program does not allow debugging (i.e.
    @ref Qore::PO_NO_DEBUGGING is set), or -2 if the program has not been set as a debug target

    @since %Qore 3.0
 */
int DebugProgram::setProgramTerminating(ProgramControl[QoreProgram] program) [flags=NAMED_ARGS] {
    // another tenant's Program is not used in a trusted build that a tenant called (qore#6536)
    if (qore_sandbox_check_program_isolation(*program, xsink, "accessing a Program")) {
        return QoreValue();
    }
   return dpgm->setProgramTerminating(*program);
}

//! Break program, i.e. all threads
/**
  * @param program the program to interrupt
  *
  * @return 0 if the operation was successful, returns -1 if the program does not allow debugging (i.e. @ref Qore::PO_NO_DEBUGGING is set), -2 if the program has not been set as a debug target, or -3 if no active target program thread can run debugger callbacks
  */
int DebugProgram::breakProgram(ProgramControl[QoreProgram] program) [flags=NAMED_ARGS] {
    // another tenant's Program is not used in a trusted build that a tenant called (qore#6536)
    if (qore_sandbox_check_program_isolation(*program, xsink, "accessing a Program")) {
        return QoreValue();
    }
   return dpgm->breakProgram(*program);
}
