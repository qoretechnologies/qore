-      break;
-    }
-
-    if (C_arg && C_arg->Exists() && (C_shape->dim(0).dim_value() != B_shape->dim(1).dim_value() && C_shape->dim(0).dim_value() != B_shape->dim(0).dim_value())) {
-      break;
+    const ONNX_NAMESPACE::TensorShapeProto* C_shape = C_arg && C_arg->Exists() ? C_arg->Shape() : nullptr;
+
+    if (!A_shape || A_shape->dim_size() != 2) {
+      break;
+    }
+
+    if (!B_shape || B_shape->dim_size() != 2 ||
+        B_shape->dim(0).dim_value() <= 0 || B_shape->dim(1).dim_value() <= 0) {
+      break;
+    }
+
+    if (C_arg && C_arg->Exists()) {
+      const auto trans_b = node.GetAttributes().find("transB");
+      const int output_dim = trans_b != node.GetAttributes().end() && trans_b->second.i() != 0 ? 0 : 1;
+      const int64_t output_channels = B_shape->dim(output_dim).dim_value();
+      // The XNNPACK bias buffer has exactly N contiguous elements. Other valid
+      // ONNX broadcasts are handled by another execution provider.
+      if (!C_shape ||
+          !((C_shape->dim_size() == 1 && C_shape->dim(0).dim_value() == output_channels) ||
+            (C_shape->dim_size() == 2 && C_shape->dim(0).dim_value() == 1 &&
+             C_shape->dim(1).dim_value() == output_channels))) {
+        break;
+      }
     }
 
