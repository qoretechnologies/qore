Description: Keep installed CMake configurations relocatable
 Boost's absolute installation directory is Debian's temporary package staging
 directory, not the eventual /usr prefix. Do not embed that build path in the
 exported configurations. The existing paths relative to CMAKE_CURRENT_LIST_DIR
 locate the installed headers and libraries in the multiarch package layout.
Author: Qore Technologies, s.r.o.
Copyright: 2026 Qore Technologies, s.r.o.
Forwarded: no
Last-Update: 2026-10-01

--- a/tools/boost_install/boost-install.jam
+++ b/tools/boost_install/boost-install.jam
@@ -797,24 +797,8 @@
         "get_filename_component(_BOOST_CMAKEDIR \"${CMAKE_CURRENT_LIST_DIR}/../\" REALPATH)"
         : true ;
 
-    if [ path.is-rooted $(cmakedir) ]
-    {
-        local cmakedir-native = [ path-native-fwd $(cmakedir) ] ;
-
-        print.text
-
-            ""
-            "# If the computed and the original directories are symlink-equivalent, use original"
-            "if(EXISTS \"$(cmakedir-native)\")"
-            "  get_filename_component(_BOOST_CMAKEDIR_ORIGINAL \"$(cmakedir-native)\" REALPATH)"
-            "  if(_BOOST_CMAKEDIR STREQUAL _BOOST_CMAKEDIR_ORIGINAL)"
-            "    set(_BOOST_CMAKEDIR \"$(cmakedir-native)\")"
-            "  endif()"
-            "  unset(_BOOST_CMAKEDIR_ORIGINAL)"
-            "endif()"
-            ""
-            : true ;
-    }
+    # Debian stages installation under a temporary build directory. Compute
+    # installed paths only relative to this config, never from that staging path.
 
     get-dir "_BOOST_INCLUDEDIR" : $(includedir) ;
 
