+TEST_P(MockUDPChannelTest, TimeoutValue) {
+  struct timeval tinfo;
+  tinfo.tv_sec = 0;
+  tinfo.tv_usec = 0;
+  struct timeval tmax;
+  tmax.tv_sec = 0;
+  tmax.tv_usec = 10;
+  struct timeval* pt;
+
+  // No timers => get max back.
+  pt = ares_timeout(channel_, &tmax, &tinfo);
+  EXPECT_EQ(&tmax, pt);
+  EXPECT_EQ(0, pt->tv_sec);
+  EXPECT_EQ(10, pt->tv_usec);
+
+  pt = ares_timeout(channel_, nullptr, &tinfo);
+  EXPECT_EQ(nullptr, pt);
+
+  // Queue against the loopback mock server, independent of host DNS routing.
+  DNSPacket reply;
+  reply.set_response().set_aa()
+    .add_question(new DNSQuestion("timer.example", T_A))
+    .add_answer(new DNSARR("timer.example", 100, {1, 2, 3, 4}));
+  EXPECT_CALL(server_, OnRequest("timer.example", T_A))
+    .WillOnce(SetReply(&server_, &reply));
+  HostResult result;
+  ares_gethostbyname(channel_, "timer.example.", AF_INET, HostCallback, &result);
+
+  // Now there's a timer running.
+  pt = ares_timeout(channel_, &tmax, &tinfo);
+  EXPECT_EQ(&tmax, pt);
+  EXPECT_EQ(0, pt->tv_sec);
+  EXPECT_EQ(10, pt->tv_usec);
+
+  tmax.tv_sec = 100;
+  pt = ares_timeout(channel_, &tmax, &tinfo);
+  EXPECT_EQ(&tinfo, pt);
+
+  pt = ares_timeout(channel_, nullptr, &tinfo);
+  EXPECT_EQ(&tinfo, pt);
+
+  EXPECT_FALSE(result.done_);
+  Process();
+  EXPECT_TRUE(result.done_);
+  EXPECT_EQ(ARES_SUCCESS, result.status_);
+  EXPECT_EQ(nullptr, ares_timeout(channel_, nullptr, &tinfo));
+}
+
