#!/bin/sh
#
# Copyright (C) 2003 - 2026 Qore Technologies, s.r.o.
#
# Seed a standalone qcc object group with one shared-parse batch compile.
#
# This is also the builder for any strongly connected component that spans more
# than one source: its members are mutually dependent, so they have no valid
# relative order and must share one parse.  The batch writes every member of
# every component in the group, which is why it holds the GROUP lock rather than
# a component lock, and why it publishes every component's generation record
# when it completes.  `qore-qo-incremental` delegates here with
# QORE_QCC_FORCE_BATCH=1 when a multi-member component is stale.

set -eu

if [ "$#" -ne 4 ]; then
    echo "usage: $0 CONTEXT BOOTSTRAP_STAMP BATCH_SCRIPT SOURCE_ORDER_HELPER" >&2
    exit 2
fi

context=$1
bootstrap_stamp=$2
batch_script=$3
source_order_tool=$4
lock_path="${bootstrap_stamp}.lock"
lock_candidate="${lock_path}.$$"
lock_owned=false
outputs_file=
# Set by qore-qo-incremental when the group holds a component that spans several
# sources. It does NOT skip the currency check -- doing so made every member of
# one component force its own redundant batch -- it only says that a batch
# failure is fatal, because such a component has no per-source fallback.
require_batch=${QORE_QCC_REQUIRE_BATCH:-0}
# A group coordinator has already completed the source-generation currency
# pass. The first lock owner may proceed directly; a process that had to wait
# must recheck because the preceding owner may have completed the same build.
force_batch=${QORE_QCC_FORCE_BATCH:-0}
lock_waited=false

run_source_order() {
    if [ -n "${QORE_QCC_QORE_EXECUTABLE:-}" ] \
            && [ -x "$QORE_QCC_QORE_EXECUTABLE" ]; then
        "$QORE_QCC_QORE_EXECUTABLE" "$source_order_tool" "$@"
    else
        "$source_order_tool" "$@"
    fi
}

#! Removes PATH, tolerating a remover that got there first.
#  Every lock-reclaim caller below wants a state -- PATH gone -- rather than the
#  act of removing it, and two waiters inspecting the same abandoned lock decide
#  to drop it independently.  `rm -f` alone does not express that: it swallows a
#  path that was already missing when it looked, but busybox reports an ENOENT
#  unlink that follows a successful lstat and exits non-zero, so the waiter that
#  loses the race by microseconds fails -- and under `set -e` that ends the
#  build.  GNU coreutils ignores the same errno, which is why this shape only
#  ever fails on musl/busybox hosts.  A removal that fails for any other reason
#  is still an error and is still reported.
remove_raced_path() {
    if rm -f "$1" 2>/dev/null; then
        return 0
    fi
    if [ ! -e "$1" ] && [ ! -L "$1" ]; then
        return 0
    fi
    # Still there, so this was not the race: repeat the removal without
    # suppressing it, and let the utility say why it cannot be done.
    rm -f "$1"
}

cleanup() {
    if [ -n "$outputs_file" ]; then
        rm -f "$outputs_file"
    fi
    if [ "$lock_owned" = true ]; then
        remove_raced_path "$lock_path"
    fi
    remove_raced_path "$lock_candidate"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if [ ! -f "$context" ]; then
    echo "$0: missing qcc context: $context" >&2
    exit 1
fi
if [ ! -f "$batch_script" ]; then
    echo "$0: missing qcc batch script: $batch_script" >&2
    exit 1
fi
if [ ! -x "$source_order_tool" ]; then
    echo "$0: missing qcc source-order helper: $source_order_tool" >&2
    exit 1
fi

mkdir -p "$(dirname "$bootstrap_stamp")"
printf '%s\n' "$$" > "$lock_candidate"
while ! ln "$lock_candidate" "$lock_path" 2>/dev/null; do
    lock_waited=true
    if [ -d "$lock_path" ]; then
        # Migrate a lock directory left by the previous helper version.
        owner=
        if [ -r "$lock_path/pid" ]; then
            IFS= read -r owner < "$lock_path/pid" || true
        fi
        case "$owner" in
            *[!0-9]*|'')
                remove_raced_path "$lock_path/pid"
                rmdir "$lock_path" 2>/dev/null || true
                continue
                ;;
            *)
                if ! kill -0 "$owner" 2>/dev/null; then
                    remove_raced_path "$lock_path/pid"
                    rmdir "$lock_path" 2>/dev/null || true
                    continue
                fi
                ;;
        esac
    elif [ -r "$lock_path" ]; then
        owner=
        IFS= read -r owner < "$lock_path" || true
        case "$owner" in
            *[!0-9]*|'')
                remove_raced_path "$lock_path"
                continue
                ;;
            *)
                if ! kill -0 "$owner" 2>/dev/null; then
                    # Recheck the published owner before reclaiming it.  The
                    # hard link makes initial publication atomic; this check
                    # keeps two stale-lock waiters from removing a successor's
                    # lock in the normal PID-distinct case.
                    current_owner=
                    IFS= read -r current_owner < "$lock_path" || true
                    if [ "$current_owner" = "$owner" ]; then
                        remove_raced_path "$lock_path"
                        remove_raced_path "$lock_path.$owner"
                    fi
                    continue
                fi
                ;;
        esac
    else
        # A dangling or otherwise unreadable legacy lock cannot name a live
        # owner.
        if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
            remove_raced_path "$lock_path"
            continue
        fi
    fi
    sleep 1
done
lock_owned=true

outputs_file=$(mktemp "${TMPDIR:-/tmp}/qore-qo-batch-outputs.XXXXXX")
sed -n 's/^output=//p' "$context" > "$outputs_file"

touch_member_stamps() {
    while IFS= read -r output; do
        [ -n "$output" ] || continue
        touch "$output.stamp"
    done < "$outputs_file"
}

# Currency is a property of every component's published generation, not of a
# per-file sidecar sweep: the whole point of the generation record is that one
# token comparison covers a component's entire transitive source closure.  A
# follower that waited on the lock re-evaluates it here, so a stale marker can
# never hide a crashed or incomplete bootstrap.
#
# The currency helper also owns the group-context generation transition, which a
# `[ "$context" -nt "$bootstrap_stamp" ]` test used to decide here.  Do not move
# that comparison back into the shell: POSIX only requires test(1) to compare
# st_mtime, so busybox ash -- /bin/sh on Alpine -- compares whole seconds, while
# dash and bash compare the nanosecond fields.  Both timestamps are produced by
# this build and are usually less than a second apart, so on busybox the
# transition was invisible whenever the machine was fast enough to publish both
# inside one second, and Make then ran the standalone qcc rule once for every
# source in the group.  The helper compares the same timestamps at full
# resolution on every platform.
current=false
if [ "$force_batch" != 1 ] || [ "$lock_waited" = true ]; then
    if [ -f "$bootstrap_stamp" ]; then
        if run_source_order --scc-current-all --batch-stamp "$bootstrap_stamp" \
                "$context"; then
            current=true
        fi
    elif run_source_order --scc-current-all "$context"; then
        current=true
    fi
fi

if [ "$current" = true ] && [ -f "$bootstrap_stamp" ]; then
    # The custom command can be rerun because an orchestration helper changed
    # even though the published object generation is still current.  Acknowledge
    # that dependency generation once for the whole group; otherwise every
    # member stamp remains older than the helper and Make launches the
    # standalone wrapper for every source.
    touch "$bootstrap_stamp"
    touch_member_stamps
    exit 0
fi

# The marker has to precede every member success stamp: a member whose stamp is
# older than the marker is treated as belonging to a previous bootstrap.
touch "$bootstrap_stamp"

if [ "$current" = true ]; then
    # Adopt an already-current tree whose marker was missing, without rewriting
    # any object or contract content.
    touch_member_stamps
    exit 0
fi

# One shared parse for the whole group. This message is emitted exactly once per
# batch that actually runs, which is what makes "a component was built as one
# unit" observable: several members of one component can each ask for the build,
# but only the lock holder compiles, and the rest find the generation current.
echo "$0: compiling the group in one shared parse"

# One rebuild, never a convergence loop.  A batch can report that its inputs
# moved only because an agent outside the build rewrote a source while qcc was
# reading it; the members of this group cannot move it, because this lock covers
# all of them.
# `$?` after a NEGATED condition is the negation's status, not the command's, so
# the batch status has to be captured in the else branch.
if sh "$batch_script"; then
    batch_rc=0
else
    batch_rc=$?
fi
if [ "$batch_rc" -eq 75 ]; then
    echo "$0: qcc batch inputs moved during compilation; rebuilding the group once"
    if sh "$batch_script"; then
        batch_rc=0
    else
        batch_rc=$?
    fi
    if [ "$batch_rc" -eq 75 ]; then
        echo "$0: qcc batch inputs moved during the group rebuild; the sources are" \
            "being changed by something other than this build" >&2
        exit 1
    fi
fi
if [ "$batch_rc" -ne 0 ]; then
    if [ "$require_batch" = 1 ]; then
        # A multi-member component has no per-source fallback: its members are
        # mutually dependent, so failing to share one parse is a hard failure
        # rather than something the per-file path could finish.
        echo "$0: batch compile failed and this group has a component that spans" \
            "several sources; there is no per-source fallback" >&2
        exit "$batch_rc"
    fi
    echo "$0: batch bootstrap failed; falling back to per-source compilation" >&2
    # Keep the new marker but do not advance any object stamps.  Every
    # per-source command therefore observes an older or missing stamp and
    # rebuilds through the established incremental path.
    exit 0
fi

# Batch parsing has no preloaded source objects, so it inherits no parse
# defines from siblings.  Clear this per-source input before later delta builds.
while IFS= read -r output; do
    [ -n "$output" ] || continue
    : > "$output.source-parse-defines"
done < "$outputs_file"
touch_member_stamps

# The batch rewrote every member of every component, so every generation record
# is committed together.  A partial sweep would leave some component claiming a
# generation the group no longer has.
run_source_order --scc-publish-all "$context"
