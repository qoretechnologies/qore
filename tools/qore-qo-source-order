)


def scan_source_summary(source: str,
        true_parse_defines: set[str] | None = None) -> dict[str, list[str]]:
    with open(source, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    code = apply_known_parse_conditionals(mask_qore_source(text), true_parse_defines)
    literal_code = apply_known_parse_conditionals(
        mask_qore_source(text, preserve_strings=True), true_parse_defines)
    call_ref_classes, call_ref_functions = collect_call_ref_mentions(code)
    return {
        "provides": sorted(collect_provides(code)),
        "classes": sorted(m.group(1) for m in CLASS_RE.finditer(code)),
        "enums": sorted(m.group(1) for m in ENUM_RE.finditer(code)),
        "hashdecls": sorted(m.group(1) for m in HASHDECL_RE.finditer(code)),
        "functions": sorted(m.group(1) for m in SUB_RE.finditer(code)),
        "parse_defines": sorted(collect_parse_defines(code)),
        "inheritance_mentions": sorted(collect_inheritance_mentions(code)),
        "hard_mentions": sorted(collect_hard_mentions(code)),
        "decl_type_mentions": sorted(collect_decl_type_mentions(code)),
        "hash_type_mentions": sorted(collect_hash_type_mentions(code)),
        "enum_type_mentions": sorted(collect_enum_type_mentions(code)),
        "call_ref_classes": sorted(call_ref_classes),
        "call_ref_functions": sorted(call_ref_functions),
        "constructed_decl_type_mentions": sorted(collect_constructed_decl_type_mentions(code)),
        "new_hash_type_mentions": sorted(collect_new_hash_type_mentions(code)),
        "new_object_mentions": sorted(collect_new_object_mentions(code)),
        "class_for_name_mentions": sorted(collect_class_for_name_mentions(literal_code)),
        "create_object_mentions": sorted(collect_create_object_mentions(literal_code)),
        "static_call_mentions": sorted(collect_static_call_mentions(code)),
        "static_ref_mentions": sorted(collect_static_ref_mentions(code)),
        "includes": sorted(collect_includes(code)),
        "parse_define_consumers": sorted(PARSE_DEFINE_CONSUMER_RE.findall(code)),
    }


def source_summary_valid(summary: object) -> bool:
    if not isinstance(summary, dict):
        return False
    return all(
        isinstance(summary.get(key), list)
        and all(isinstance(value, str) for value in summary[key])
        for key in SOURCE_SUMMARY_KEYS
    )


def summary_set(summary: dict[str, list[str]], key: str) -> set[str]:
    return set(summary[key])


def build_hard_graph_from_summaries(inputs: list[str],
        summaries: list[dict[str, list[str]]]
        ) -> tuple[dict[int, set[int]], dict[int, set[int]], set[tuple[int, int]]]:
    provides_by_source = [summary_set(summary, "provides") for summary in summaries]
    provider_sources: dict[str, set[int]] = defaultdict(set)
    class_provider_sources: dict[str, set[int]] = defaultdict(set)
    enum_provider_sources: dict[str, set[int]] = defaultdict(set)
    hashdecl_provider_sources: dict[str, set[int]] = defaultdict(set)
    function_provider_sources: dict[str, set[int]] = defaultdict(set)
    parse_define_provider_sources: dict[str, set[int]] = defaultdict(set)

    for i, summary in enumerate(summaries):
        for symbol in provides_by_source[i]:
            provider_sources[symbol].add(i)
        for symbol in summary["classes"]:
            class_provider_sources[symbol].add(i)
        for symbol in summary["enums"]:
            enum_provider_sources[symbol].add(i)
        for symbol in summary["hashdecls"]:
            hashdecl_provider_sources[symbol].add(i)
        for symbol in summary["functions"]:
            function_provider_sources[symbol].add(i)
        for symbol in summary["parse_defines"]:
            parse_define_provider_sources[symbol].add(i)

    unique_provider = {
        symbol: next(iter(sources))
        for symbol, sources in provider_sources.items()
        if len(sources) == 1
    }
    provider_symbols = set(unique_provider)
    unique_class_symbols = {
        symbol for symbol, sources in class_provider_sources.items()
        if len(sources) == 1 and symbol in unique_provider
    }
    unique_enum_symbols = {
        symbol for symbol, sources in enum_provider_sources.items()
        if len(sources) == 1 and symbol in unique_provider
    }
    unique_hashdecl_symbols = {
        symbol for symbol, sources in hashdecl_provider_sources.items()
        if len(sources) == 1 and symbol in unique_provider
    }
    unique_function_symbols = {
        symbol for symbol, sources in function_provider_sources.items()
        if len(sources) == 1 and symbol in unique_provider
    }
    unique_parse_define = {
        symbol: next(iter(sources))
        for symbol, sources in parse_define_provider_sources.items()
        if len(sources) == 1
    }
    input_basename_sources: dict[str, list[int]] = defaultdict(list)
    for index, path in enumerate(inputs):
        input_basename_sources[os.path.basename(path)].append(index)
    unique_input_basename = {
        name: sources[0]
        for name, sources in input_basename_sources.items()
        if len(sources) == 1
    }

    outgoing: dict[int, set[int]] = defaultdict(set)
    incoming: dict[int, set[int]] = defaultdict(set)
    required_edges: set[tuple[int, int]] = set()

    def add_edge(provider: int, consumer: int, required: bool = False) -> None:
        if provider == consumer:
            return
        if consumer not in outgoing[provider]:
            outgoing[provider].add(consumer)
            incoming[consumer].add(provider)
        if required:
            required_edges.add((provider, consumer))

    for consumer, summary in enumerate(summaries):
        for symbol in summary_set(summary, "inheritance_mentions") & provider_symbols:
            provider = unique_provider[symbol]
            if symbol in provides_by_source[consumer]:
                continue
            add_edge(provider, consumer, required=True)

        for symbol in summary_set(summary, "hard_mentions") & provider_symbols:
            provider = unique_provider[symbol]
            if provider == consumer or symbol in provides_by_source[consumer]:
                continue
            add_edge(provider, consumer, required=True)

        mentions = set()
        mentions.update(summary_set(summary, "decl_type_mentions")
            & (unique_class_symbols | unique_hashdecl_symbols))
        mentions.update(summary_set(summary, "hash_type_mentions") & unique_hashdecl_symbols)
        for symbol in summary_set(summary, "enum_type_mentions") & unique_enum_symbols:
            provider = unique_provider[symbol]
            if symbol in provides_by_source[consumer]:
                continue
            # Enum type annotations (`enum<Foo>`) must resolve while parsing
            # the consumer; unlike class/hashdecl type imports, unresolved enum
            # types are not link-deferred today.
            add_edge(provider, consumer, required=True)
        for symbol in summary_set(summary, "call_ref_functions") & unique_function_symbols:
            provider = unique_provider[symbol]
            if symbol in provides_by_source[consumer]:
                continue
            # Function call references require the target function during
            # parse/commit today; direct calls can be deferred to the linker.
            add_edge(provider, consumer, required=True)
        for symbol in summary_set(summary, "call_ref_classes") & unique_class_symbols:
            provider = unique_provider[symbol]
            if symbol in provides_by_source[consumer]:
                continue
            add_edge(provider, consumer)
        mentions.update(summary_set(summary, "constructed_decl_type_mentions")
            & (unique_class_symbols | unique_hashdecl_symbols))
        mentions.update(summary_set(summary, "new_hash_type_mentions") & unique_hashdecl_symbols)
        for symbol in summary_set(summary, "new_object_mentions") & unique_class_symbols:
            provider = unique_provider[symbol]
            if provider == consumer or symbol in provides_by_source[consumer]:
                continue
            add_edge(provider, consumer)
        for symbol in summary_set(summary, "class_for_name_mentions") & unique_class_symbols:
            provider = unique_provider[symbol]
            if provider == consumer or symbol in provides_by_source[consumer]:
                continue
            add_edge(provider, consumer)
        mentions.update(summary_set(summary, "create_object_mentions") & unique_class_symbols)
        mentions.update(summary_set(summary, "static_call_mentions") & unique_class_symbols)
        static_refs = summary_set(summary, "static_ref_mentions")
        mentions.update(static_refs & unique_class_symbols)
        for symbol in static_refs & unique_enum_symbols:
            provider = unique_provider[symbol]
            if provider == consumer or symbol in provides_by_source[consumer]:
                continue
            # Enum members (`Foo::Bar`) are compile-time constants and require
            # the enum declaration during parse/commit so switch/case and enum
            # value checks see the real enum.
            add_edge(provider, consumer, required=True)
        for symbol in mentions:
            provider = unique_provider[symbol]
            if provider == consumer or symbol in provides_by_source[consumer]:
                continue
            add_edge(provider, consumer)

        for included in summary["includes"]:
            provider = unique_input_basename.get(os.path.basename(included))
            if provider is None or provider == consumer:
                continue
            add_edge(provider, consumer, required=True)

        for symbol in summary["parse_define_consumers"]:
            provider = unique_parse_define.get(symbol)
            if provider is None or provider == consumer:
                continue
            add_edge(provider, consumer, required=True)

    return outgoing, incoming, required_edges


def build_hard_graph(inputs: list[str],
        true_parse_defines: set[str] | None = None
        ) -> tuple[
            dict[int, set[int]], dict[int, set[int]], set[tuple[int, int]],
            list[dict[str, list[str]]]
        ]:
    summaries = [scan_source_summary(source, true_parse_defines) for source in inputs]
    outgoing, incoming, required_edges = build_hard_graph_from_summaries(inputs, summaries)
    return outgoing, incoming, required_edges, summaries


def graph_to_lists(graph: dict[int, set[int]], count: int) -> list[list[int]]:
    return [sorted(graph.get(i, ())) for i in range(count)]


def lists_to_graph(values: list[list[int]]) -> dict[int, set[int]]:
    graph: dict[int, set[int]] = defaultdict(set)
    for i, items in enumerate(values):
        if items:
            graph[i] = set(items)
    return graph


def compute_scc_ids(outgoing: dict[int, set[int]], count: int) -> list[int]:
    indices: list[int] = [-1] * count
    lowlinks: list[int] = [0] * count
    on_stack: list[bool] = [False] * count
    stack: list[int] = []
    scc_ids: list[int] = [-1] * count
    next_index = 0
    next_scc = 0

    def strongconnect(node: int) -> None:
        nonlocal next_index, next_scc
        indices[node] = next_index
        lowlinks[node] = next_index
        next_index += 1
        stack.append(node)
        on_stack[node] = True

        for consumer in sorted(outgoing.get(node, ())):
            if indices[consumer] == -1:
                strongconnect(consumer)
                lowlinks[node] = min(lowlinks[node], lowlinks[consumer])
            elif on_stack[consumer]:
                lowlinks[node] = min(lowlinks[node], indices[consumer])

        if lowlinks[node] != indices[node]:
            return

        while True:
            member = stack.pop()
            on_stack[member] = False
            scc_ids[member] = next_scc
            if member == node:
                break
        next_scc += 1

    for node in range(count):
        if indices[node] == -1:
            strongconnect(node)

    return scc_ids


def edge_pairs_to_lists(required_edges: set[tuple[int, int]], count: int) -> list[list[int]]:
    values: list[list[int]] = [[] for _ in range(count)]
    for provider, consumer in sorted(required_edges):
        values[provider].append(consumer)
    return values


def edge_lists_to_pairs(values: list[list[int]]) -> set[tuple[int, int]]:
    pairs: set[tuple[int, int]] = set()
    for provider, consumers in enumerate(values):
        for consumer in consumers:
            pairs.add((provider, consumer))
    return pairs


def sha256_file(path: str) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def file_record(path: str) -> dict[str, object]:
    return {
        "path": os.path.abspath(path),
        "size": os.path.getsize(path),
        "sha256": sha256_file(path),
    }


def file_records(paths: list[str]) -> list[dict[str, object]]:
    return [file_record(path) for path in paths]


def order_edge_usable(provider: int, consumer: int, scc_ids: list[int],
        required_edges: set[tuple[int, int]]) -> bool:
    # The build graph may only include true compile prerequisites.  Other
    # source-level references are linkable .qo imports and must not serialize
    # clean or delta builds by forcing provider metadata to be present.
    return (provider, consumer) in required_edges


def load_graph_cache(cache_file: str, context: str, inputs: list[str], outputs: list[str],
        true_parse_defines: set[str]
        ) -> tuple[dict[int, set[int]], dict[int, set[int]], set[tuple[int, int]]] | None:
    try:
        cache_mtime_ns = os.stat(cache_file).st_mtime_ns
        with open(cache_file, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    if data.get("version") != CACHE_VERSION:
        return None
    if data.get("inputs") != inputs or data.get("outputs") != outputs:
        return None
    if data.get("parse_defines") != sorted(true_parse_defines):
        return None
    outgoing_data = data.get("outgoing")
    incoming_data = data.get("incoming")
    required_data = data.get("required")
    if not isinstance(outgoing_data, list) or not isinstance(incoming_data, list):
        return None
    if not isinstance(required_data, list):
        return None
    if len(outgoing_data) != len(inputs) or len(incoming_data) != len(inputs):
        return None
    if len(required_data) != len(inputs):
        return None
    old_records = data.get("input_records")
    summaries = data.get("source_summaries")
    if not isinstance(old_records, list) or len(old_records) != len(inputs):
        return None
    if not isinstance(summaries, list) or len(summaries) != len(inputs):
        return None
    if not all(source_summary_valid(summary) for summary in summaries):
        return None

    try:
        if os.stat(context).st_mtime_ns > cache_mtime_ns:
            return None
        if os.stat(__file__).st_mtime_ns > cache_mtime_ns:
            return None
    except OSError:
        return None

    inspect: list[int] = []
    for i, (path, old_record) in enumerate(zip(inputs, old_records)):
        if not isinstance(old_record, dict):
            return None
        try:
            stat = os.stat(path)
        except OSError:
            return None
        if old_record.get("path") != os.path.abspath(path):
            return None
        if old_record.get("size") != stat.st_size or stat.st_mtime_ns > cache_mtime_ns:
            inspect.append(i)

    outgoing = lists_to_graph(outgoing_data)
    incoming = lists_to_graph(incoming_data)
    required_edges = edge_lists_to_pairs(required_data)
    if not inspect:
        return outgoing, incoming, required_edges

    records = list(old_records)
    graph_changed = False
    for i in inspect:
        try:
            record = file_record(inputs[i])
        except OSError:
            return None
        if (record.get("size") != old_records[i].get("size")
                or record.get("sha256") != old_records[i].get("sha256")):
            try:
                summaries[i] = scan_source_summary(inputs[i], true_parse_defines)
            except OSError:
                return None
            graph_changed = True
        records[i] = record

    if graph_changed:
        outgoing, incoming, required_edges = build_hard_graph_from_summaries(inputs, summaries)
    save_graph_cache(cache_file, inputs, outputs, true_parse_defines,
        outgoing, incoming, required_edges, summaries, records)
    return outgoing, incoming, required_edges


def save_graph_cache(cache_file: str, inputs: list[str], outputs: list[str], true_parse_defines: set[str],
        outgoing: dict[int, set[int]], incoming: dict[int, set[int]],
        required_edges: set[tuple[int, int]],
        summaries: list[dict[str, list[str]]],
        input_records: list[dict[str, object]] | None = None) -> None:
    data = {
        "version": CACHE_VERSION,
        "inputs": inputs,
        "outputs": outputs,
        "parse_defines": sorted(true_parse_defines),
        "input_records": input_records if input_records is not None else file_records(inputs),
        "source_summaries": summaries,
        "outgoing": graph_to_lists(outgoing, len(inputs)),
        "incoming": graph_to_lists(incoming, len(inputs)),
        "required": edge_pairs_to_lists(required_edges, len(inputs)),
    }
    tmp = f"{cache_file}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, separators=(",", ":"))
        os.replace(tmp, cache_file)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def load_or_build_hard_graph(context: str, inputs: list[str],
        outputs: list[str]) -> tuple[dict[int, set[int]], dict[int, set[int]], set[tuple[int, int]]]:
    cache_file = context + ".source-order-v2.json"
    true_parse_defines = parse_context_parse_defines(context)
    cached = load_graph_cache(cache_file, context, inputs, outputs, true_parse_defines)
    if cached:
        return cached
    outgoing, incoming, required_edges, summaries = build_hard_graph(inputs, true_parse_defines)
    save_graph_cache(cache_file, inputs, outputs, true_parse_defines,
        outgoing, incoming, required_edges, summaries)
    return outgoing, incoming, required_edges


def collect_prerequisites(target: int, incoming: dict[int, set[int]], scc_ids: list[int],
        required_edges: set[tuple[int, int]]) -> set[int]:
    prerequisites: set[int] = set()
    stack = [(target, provider) for provider in incoming.get(target, ())]
    while stack:
        consumer, provider = stack.pop()
        if not order_edge_usable(provider, consumer, scc_ids, required_edges):
            continue
        if provider in prerequisites:
            continue
        prerequisites.add(provider)
        stack.extend((provider, next_provider) for next_provider in incoming.get(provider, ()))
    return prerequisites


def topo_subset(nodes: set[int], outgoing: dict[int, set[int]], target: int, scc_ids: list[int],
        required_edges: set[tuple[int, int]]) -> list[int]:
    incoming_count = {node: 0 for node in nodes}
    for provider in nodes:
        for consumer in outgoing.get(provider, ()):
            if consumer in nodes and order_edge_usable(provider, consumer, scc_ids, required_edges):
                incoming_count[consumer] += 1

    ready = [node for node, count in incoming_count.items() if count == 0]
    heapq.heapify(ready)
    remaining = set(nodes)
    order: list[int] = []

    while remaining:
        if ready:
            node = heapq.heappop(ready)
            if node not in remaining:
                continue
        else:
            # Hard dependency cycle.  Keep the requested target last so that any
            # usable provider metadata is still available before compiling it.
            cycle_choices = remaining - {target}
            node = min(cycle_choices or remaining)
        remaining.remove(node)
        order.append(node)
        for consumer in sorted(outgoing.get(node, ())):
            if consumer not in remaining or not order_edge_usable(node, consumer, scc_ids, required_edges):
                continue
            incoming_count[consumer] -= 1
            if incoming_count[consumer] == 0:
                heapq.heappush(ready, consumer)

    return order


def build_direct_prerequisite_order(context: str, inputs: list[str], outputs: list[str], target: int) -> list[int]:
    outgoing, incoming, required_edges = load_or_build_hard_graph(context, inputs, outputs)
    scc_ids = compute_scc_ids(outgoing, len(inputs))
    return sorted(
        provider for provider in incoming.get(target, ())
        if order_edge_usable(provider, target, scc_ids, required_edges)
    )


def build_all_direct_prerequisite_orders(context: str, inputs: list[str], outputs: list[str]) -> list[list[int]]:
    outgoing, incoming, required_edges = load_or_build_hard_graph(context, inputs, outputs)
    scc_ids = compute_scc_ids(outgoing, len(inputs))
    return [
        sorted(
            provider for provider in incoming.get(target, ())
            if order_edge_usable(provider, target, scc_ids, required_edges)
        )
        for target in range(len(inputs))
    ]


def cmake_quote(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def emit_cmake_direct_map(prefix: str, context: str, inputs: list[str], outputs: list[str]) -> None:
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", prefix):
        raise ValueError(f"invalid CMake variable prefix: {prefix!r}")
    for target, order in enumerate(build_all_direct_prerequisite_orders(context, inputs, outputs)):
        deps = ";".join(cmake_quote(outputs[index]) for index in order)
        print(f'set({prefix}_{target} "{deps}")')


def parse_make_depfile_inputs(path: str) -> list[str]:
    with open(path, "r", encoding="utf-8") as f:
        text = f.read()
    text = text.replace("\\\n", "")
    colon = text.find(":")
    if colon < 0:
        return []

    values: list[str] = []
    token: list[str] = []
    escaped = False
    for ch in text[colon + 1:]:
        if escaped:
            token.append(ch)
            escaped = False
        elif ch == "\\":
            escaped = True
        elif ch.isspace():
            if token:
                values.append("".join(token))
                token = []
        else:
            token.append(ch)
    if token:
        values.append("".join(token))
    return values


def batch_artifact_current(context: str, inputs: list[str], outputs: list[str],
        target: int, bootstrap_stamp: str | None) -> bool:
    output = outputs[target]
    required = [
        output,
        output + ".d",
        output + ".idx.json",
        output + ".status.json",
        output + ".content.stamp",
        output + ".stamp",
        output + ".source.manifest.json",
        output + ".source-parse-defines",
    ]
    if bootstrap_stamp:
        required.append(bootstrap_stamp)
    try:
        for path in required:
            if not os.path.isfile(path):
                return False
        stamp_time = os.stat(output + ".stamp").st_mtime_ns
        if bootstrap_stamp and os.stat(bootstrap_stamp).st_mtime_ns > stamp_time:
            return False
        if os.stat(inputs[target]).st_mtime_ns > stamp_time:
            return False

        direct = build_direct_prerequisite_order(context, inputs, outputs, target)
        for provider in direct:
            if os.stat(outputs[provider] + ".content.stamp").st_mtime_ns > stamp_time:
                return False
        for dep in parse_make_depfile_inputs(output + ".d"):
            if os.path.exists(dep) and os.stat(dep).st_mtime_ns > stamp_time:
                return False
    except OSError:
        return False
    return True


def build_prerequisite_order(context: str, inputs: list[str], outputs: list[str], target: int) -> list[int]:
    outgoing, incoming, required_edges = load_or_build_hard_graph(context, inputs, outputs)
    scc_ids = compute_scc_ids(outgoing, len(inputs))
    prerequisites = collect_prerequisites(target, incoming, scc_ids, required_edges)
    if not prerequisites:
        return []
    nodes = prerequisites | {target}
    return [node for node in topo_subset(nodes, outgoing, target, scc_ids, required_edges) if node != target]


def main() -> int:
    parser = argparse.ArgumentParser(description="Print source-scanned .qo prerequisites before a target output")
    parser.add_argument(
        "--direct",
        action="store_true",
        help="print only direct prerequisite outputs for build-graph dependencies",
    )
    parser.add_argument(
        "--direct-map-cmake",
        metavar="PREFIX",
        help="emit CMake set() statements with all direct prerequisite outputs for the context",
    )
    parser.add_argument(
        "--source-symbol-manifest",
        metavar="FILE",
        help="write a qcc source-symbol precedence manifest for all context inputs",
    )
    parser.add_argument(
        "--batch-artifact-current",
        metavar="BOOTSTRAP_STAMP",
        help="check whether a batch-seeded output and all precise dependencies are current",
    )
    parser.add_argument(
        "--artifact-current",
        action="store_true",
        help="check output freshness without requiring a batch-bootstrap marker",
    )
    parser.add_argument("context")
    parser.add_argument("target_output", nargs="?")
    args = parser.parse_args()

    inputs, outputs = parse_context(args.context)
    if args.source_symbol_manifest:
        write_if_changed(args.source_symbol_manifest, build_source_symbol_manifest(args.context, inputs))
        return 0

    if args.direct_map_cmake:
        try:
            emit_cmake_direct_map(args.direct_map_cmake, args.context, inputs, outputs)
        except ValueError as exc:
            print(f"{sys.argv[0]}: {exc}", file=sys.stderr)
            return 2
        return 0

    if not args.target_output:
        print(f"{sys.argv[0]}: target output is required unless --direct-map-cmake is used", file=sys.stderr)
        return 2

    normalized_outputs = [os.path.realpath(os.path.abspath(path)) for path in outputs]
    target = os.path.realpath(os.path.abspath(args.target_output))
    try:
        target_index = normalized_outputs.index(target)
    except ValueError:
        print(f"{sys.argv[0]}: target output not present in context: {args.target_output}", file=sys.stderr)
        return 1

    if args.batch_artifact_current or args.artifact_current:
        return 0 if batch_artifact_current(
            args.context, inputs, outputs, target_index,
            args.batch_artifact_current if not args.artifact_current else None) else 1

    if args.direct:
        order = build_direct_prerequisite_order(args.context, inputs, outputs, target_index)
    else:
        order = build_prerequisite_order(args.context, inputs, outputs, target_index)
    for index in order:
        print(outputs[index])
    return 0


if __name__ == "__main__":
    sys.exit(main())
