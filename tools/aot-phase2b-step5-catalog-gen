# Catalog every emitExceptionCheck() call site in lib/QoreIRToLLVM.cpp.

%modern

const FAST_PATH_HELPERS = (
    "emitAnyCmpFastPath": "qore_rt_comparison_op",
    "emitAnyCmpSpaceshipFastPath": "qore_rt_comparison_op",
    "emitAnyArithFastPath": "qore_rt_binary_op",
    "emitAnyBitwiseFastPath": "qore_rt_binary_op",
    "emitAnyUnaryFastPath": "qore_rt_unary_op",
    "emitAnyCompoundAssignFastPath": "qore_rt_binary_op",
);

hash<string, bool> sub value_set(list<string> values) {
    hash<string, bool> result = {};
    foreach string value in (values) {
        result{value} = True;
    }
    return result;
}

list<string> sub sorted_count_keys(hash<string, list<hash<auto>>> groups) {
    return sort(groups.keys(), int sub(string left, string right) {
        int count_cmp = groups{right}.size() <=> groups{left}.size();
        return count_cmp ? count_cmp : left <=> right;
    });
}

*string sub first_group(Regex pattern, string line) {
    *list<*string> groups = pattern.extractGroups(line);
    return groups ? groups[0] : NOTHING;
}

*string sub nearest_preceding(list<string> lines, int line_index, Regex pattern) {
    int lower = max(0, line_index - 200);
    for (int index = line_index - 1; index > lower; --index) {
        string line = lines[index];
        if (line.find("case QoreIROpcode::") < 0) {
            continue;
        }
        *string match = first_group(pattern, line);
        if (exists match) {
            return match;
        }
    }
    return NOTHING;
}

*string sub nearest_preceding_helper(list<string> lines, int line_index,
        Regex case_pattern, Regex helper_pattern, Regex fast_path_pattern) {
    list<string> helpers = ();
    *string fast_path;
    int lower = max(0, line_index - 200);
    for (int index = line_index - 1; index > lower; --index) {
        string line = lines[index];
        if (line.find("case QoreIROpcode::") >= 0 && case_pattern.match(line)) {
            break;
        }
        if (!exists fast_path && line.find("emitAny") >= 0) {
            fast_path = first_group(fast_path_pattern, line);
        }
        *string helper = line.find("getOrInsertFunction(") >= 0
            ? first_group(helper_pattern, line) : NOTHING;
        if (exists helper) {
            push helpers, helper;
        }
    }
    if (exists fast_path) {
        return FAST_PATH_HELPERS{fast_path} + " (via " + fast_path + ")";
    }
    if (!helpers) {
        return NOTHING;
    }
    if (helpers.size() == 1) {
        return helpers[0];
    }
    return join(" / ", sort(value_set(helpers).keys()));
}

string sub site_pattern(list<string> lines, int line_index, Regex maybe_invoke,
        Regex create_call, Regex aot_mode) {
    bool has_invoke = False;
    bool has_call = False;
    bool has_aot_mode = False;
    int lower = max(0, line_index - 100);
    for (int index = line_index - 1; index > lower; --index) {
        string line = lines[index];
        if (!has_invoke && line.find("emitMaybeInvoke(") >= 0) {
            has_invoke = True;
        }
        if (!has_call && line.find("builder->CreateCall(") >= 0) {
            has_call = create_call.match(line);
        }
        if (!has_aot_mode && line.find("aot_mode") >= 0) {
            has_aot_mode = aot_mode.match(line);
        }
    }
    if (has_invoke && !has_call) {
        return "invoke_only";
    }
    if (has_invoke && has_call && has_aot_mode) {
        return "aot_invoke_jit_createcall";
    }
    if (has_invoke && has_call) {
        return "mixed_invoke_createcall";
    }
    return has_call ? "createcall_only" : "unclear";
}

