%modern

%requires Diff
%requires Util

%exec-class QpatchApp

#! Command-line patch tool powered by the Diff module
class QpatchApp {
    private {
        const Version = "1.0.0";

        const Opts = {
            "dryrun":   "d,dry-run",
            "reverse":  "R,reverse",
            "output":   "o,output=s",
            "nocolor":  "C,no-color",
            "verbose":  "v,verbose",
            "help":     "h,help",
            "version":  "V,version",
        };

        TerminalColor color;
    }

    constructor() {
        GetOpt getopt(Opts);
        hash<auto> opts;
        try {
            opts = getopt.parse3(\ARGV);
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("qpatch: %s\n", ex.desc);
            exit(2);
        }

        if (opts.version) {
            printf("qpatch %s\n", Version);
            exit(0);
        }

        if (opts.help || ARGV.size() < 1) {
            usage();
            exit(opts.help ? 0 : 2);
        }

        color = new TerminalColor(!opts.nocolor);

        string file_path = shift ARGV;
        string patch_path = ARGV ? shift ARGV : "-";

        # Read source file
        string source;
        try {
            source = ReadOnlyFile::readTextFile(file_path);
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("qpatch: %s: %s\n", file_path, ex.desc);
            exit(2);
        }

        # Read patch (from file or stdin)
        string patch;
        try {
            if (patch_path == "-") {
                patch = stdin.read(-1);
            } else {
                patch = ReadOnlyFile::readTextFile(patch_path);
            }
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("qpatch: %s: %s\n", patch_path, ex.desc);
            exit(2);
        }

        if (opts.reverse) {
            patch = reversePatch(patch);
        }

        # Apply patch
        string result;
        try {
            result = patch_apply(source, patch);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "PATCH-ERROR") {
                stderr.printf("qpatch: %s: %s\n", color.error("PATCH FAILED"), ex.desc);
                exit(1);
            }
            rethrow;
        }

        if (opts.dryrun) {
            if (opts.verbose) {
                stdout.printf("%s %s\n", color.success("OK"), file_path);
            }
            exit(0);
        }

        if (opts.output) {
            # Write to output file
            File f();
            f.open2(opts.output, O_WRONLY | O_CREAT | O_TRUNC);
            f.write(result);
            if (opts.verbose) {
                stdout.printf("%s %s -> %s\n", color.success("PATCHED"), file_path, opts.output);
            }
        } else {
            # Overwrite original file
            File f();
            f.open2(file_path, O_WRONLY | O_TRUNC);
            f.write(result);
            if (opts.verbose) {
                stdout.printf("%s %s\n", color.success("PATCHED"), file_path);
            }
        }
    }

    #! Reverses a unified diff patch (swaps + and - lines)
    private string reversePatch(string patch) {
        list<string> lines = patch.split("\n");
        list<string> result = ();
        foreach string line in (lines) {
            if (line =~ /^---\s/) {
                push result, regex_subst(line, "^---", "+++");
            } else if (line =~ /^\+\+\+\s/) {
                push result, regex_subst(line, "^\\+\\+\\+", "---");
            } else if (line =~ /^@@/) {
                # Swap -old,count +new,count in hunk header
                *list<*string> m = regex_extract(line,
                    "^@@\\s+-(\\d+(?:,\\d+)?)\\s+\\+(\\d+(?:,\\d+)?)\\s+@@(.*)$");
                if (m) {
                    push result, sprintf("@@ -%s +%s @@%s", m[1], m[0], m[2] ?? "");
                } else {
                    push result, line;
                }
            } else if (line =~ /^\+/) {
                push result, "-" + line.substr(1);
            } else if (line =~ /^-/) {
                push result, "+" + line.substr(1);
            } else {
                push result, line;
            }
        }
        return result.join("\n");
    }

    static usage() {
        stdout.print("Usage: qpatch [options] file [patch]

Apply a unified diff patch to a file.

If no patch file is given, the patch is read from stdin.

Options:
  -d, --dry-run        Check if patch applies without modifying the file
  -R, --reverse        Reverse the patch (undo changes)
  -o, --output=FILE    Write result to FILE instead of overwriting the original
  -v, --verbose        Show status messages
  -C, --no-color       Disable colored output
  -h, --help           Show this help message
  -V, --version        Show version information

Exit codes:
  0  Patch applied successfully (or dry-run passed)
  1  Patch failed (context mismatch)
  2  Error (missing file, invalid options, etc.)

Examples:
  # Apply a patch from a file
  qpatch myfile.txt changes.patch

  # Apply a patch from stdin (e.g., from qdiff)
  qdiff old.txt new.txt | qpatch old.txt

  # Check if a patch applies without modifying
  qpatch -d myfile.txt changes.patch

  # Reverse a previously applied patch
  qpatch -R myfile.txt changes.patch

  # Write patched output to a new file
  qpatch -o result.txt myfile.txt changes.patch
");
    }
}
