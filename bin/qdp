%modern

%requires qore >= 1.0

%requires ConnectionProvider
%requires DatasourceProvider
%requires DbDataProvider
%requires Mapper
%requires Util
%requires Logger
# for webhooks
%requires HttpServer
%requires RestHandler
# to create the data provider index
%requires ProviderIndex
%requires QoreHistory

%try-module yaml
%define NoYaml
%endtry

%requires linenoise

%try-module json
%define NoJson
%endtry

%exec-class QdpCmd

class QdpCmd {
    public {
        #! Version string
        const Version = "1.7.0";

        static HttpServer http;

        static string cmd;
        static string app;
        static string action;

        static bool ix;

        #! port for the HTTP server
        static int http_port = 0;

        # Global mutex for webhook handlers
        static Mutex wh_lock();

        # Global map for webhook handlers: webhook -> handler
        static hash<string, WebhookHandler> whm;

        # console logger
        LoggerInterface logger;

        #! Color output helper
        static Util::TerminalColor color;

        #! Signal handler flag for graceful shutdown
        static bool shutdown_requested = False;

        #! program options
        const Opts = {
            "bulk": "b,bulk",
            "createindex": "I,create-index",
            "dryrun": "d,dry-run",
            "host": "H,host=s",
            "json": "J,json",
            "limit": "l,limit=i",
            "listapps": "a,list-apps",
            "listconnections": "c,list-connections",
            "listfactories": "f,list-factories",
            "mapper": "M,mapper=s",
            "listtypes": "t,list-types",
            "modules": "m,module=s@",
            "nocolor": "C,no-color",
            "offset": "O,offset=i",
            "options": "o,options=s",
            "required": "R,show-required",
            "servers": "S,servers",
            "subtype": "s,subtype=s",
            "timeout": "T,timeout=i",
            "verbose": "v,verbose:i+",
            "version": "V,version",
            "exp": "x,expressions",
            "dpql": "q,dpql",
            "dpqlhelp": "Q,dpql-help",
            "pipelinehelp": "P,pipeline-help",
            "yaml": "Y,yaml",
            "help": "h,help",
        };

        #! commands
        const Cmds = {
            "action-info": \QdpCmd::actionInfo(),
            "ai": \QdpCmd::actionInfo(),
            "ainfo": \QdpCmd::actionInfo(),
            "create": \QdpCmd::create(),
            "create-record": \QdpCmd::getCreateRecord(),
            "crecord": \QdpCmd::getCreateRecord(),
            "delete": \QdpCmd::del(),
            "dorequest": \QdpCmd::doRequest(),
            "errors": \QdpCmd::errors(),
            "event": \QdpCmd::event(),
            "example-error": \QdpCmd::exampleError(),
            "example-event": \QdpCmd::exampleEvent(),
            "example-record": \QdpCmd::exampleRecord(),
            "example-request": \QdpCmd::exampleRequest(),
            "example-response": \QdpCmd::exampleResponse(),
            "exerror": \QdpCmd::exampleError(),
            "exevent": \QdpCmd::exampleEvent(),
            "exrecord": \QdpCmd::exampleRecord(),
            "exrequest": \QdpCmd::exampleRequest(),
            "exresponse": \QdpCmd::exampleResponse(),
            "fadd": \QdpCmd::fieldAdd(),
            "fdelete": \QdpCmd::fieldDelete(),
            "field-add": \QdpCmd::fieldAdd(),
            "field-del": \QdpCmd::fieldDelete(),
            "field-update": \QdpCmd::fieldUpdate(),
            "fupdate": \QdpCmd::fieldUpdate(),
            "info": \QdpCmd::getInfo(),
            "interactive": \QdpCmd::interactive(),
            "ix": \QdpCmd::interactive(),
            "ldetails": \QdpCmd::listChildDetails(),
            "levents": \QdpCmd::listEvents(),
            "list": \QdpCmd::listChildren(),
            "list-details": \QdpCmd::listChildDetails(),
            "list-events": \QdpCmd::listEvents(),
            "listen": \QdpCmd::listen(),
            "lmessages": \QdpCmd::listMessages(),
            "lmsgs": \QdpCmd::listMessages(),
            "message": \QdpCmd::message(),
            "msg": \QdpCmd::message(),
            "pcreate": \QdpCmd::providerCreate(),
            "pdelete": \QdpCmd::providerDelete(),
            "pipe": \QdpCmd::pipeline(),
            "pipeline": \QdpCmd::pipeline(),
            "pl": \QdpCmd::pipeline(),
            "provider-create": \QdpCmd::providerCreate(),
            "provider-delete": \QdpCmd::providerDelete(),
            "record": \QdpCmd::getRecord(),
            "reply": \QdpCmd::response(),
            "request": \QdpCmd::request(),
            "response": \QdpCmd::response(),
            "rsearch": \QdpCmd::doRequestSearch(),
            "search": \QdpCmd::search(),
            "send-message": \QdpCmd::sendMessage(),
            "show-providers": \QdpCmd::showProviders(),
            "smessage": \QdpCmd::sendMessage(),
            "smsg": \QdpCmd::sendMessage(),
            "sp": \QdpCmd::showProviders(),
            "update": \QdpCmd::update(),
            "update-record": \QdpCmd::getUpdateRecord(),
            "urecord": \QdpCmd::getUpdateRecord(),
            "upsert": \QdpCmd::upsert(),
        };

        #! Commands that don't need a data provider
        const NoProviderCmds = (
            "action-info": True,
            "ai": True,
            "ainfo": True,
        );

        #! Disambiguation for common commands with the same initial letters
        const DisambiguationMap = {
            "pipe": "supports_read",
            "pipeline": "supports_read",
            "pl": "supports_read",

            "search": "supports_read",
            "send-message": "supports_messages",
            "smessage": "supports_messages",
            "smsg": "supports_messages",

            "record": "has_record",
            "reply": "supports_request",
            "request": "supports_request",
            "response": "supports_request",
            "rsearch": "supports_request",
        };

        #! valid field keys
        const FieldKeys = (
            "type",
            "desc",
            "default_value",
            "opts",
        );
    }

    constructor() {
        # must be called before any data provider operations are performed to allow for automatic configuration from
        # environment variables by supported data provider modules (ex: SalesforceRestDataProvider)
        DataProvider::setAutoConfig();

        GetOpt g(Opts);
        our hash<auto> opts = g.parse3(\ARGV);

        # Initialize color output early (enabled by default if terminal supports it)
        color = new Util::TerminalColor(!opts.nocolor);

        if (opts.help) {
            usage();
        }
        if (opts.dpqlhelp) {
            showDpqlHelp();
        }
        if (opts.pipelinehelp) {
            showPipelineHelp();
        }
        if (opts.version) {
            showVersion();
        }
        if (opts.dpql && opts.exp) {
            error("options --dpql and --expressions are mutually exclusive");
        }

        # Set up signal handlers for graceful shutdown
        set_signal_handler(SIGINT, \QdpCmd::signalHandler());
        set_signal_handler(SIGTERM, \QdpCmd::signalHandler());

        # load any modules
        map load_module($1), opts.modules;

        logger = getLogger();
        DataProvider::setGlobalLogger(logger);
        ProviderIndex::setGlobalLogger(logger);

        if (opts.listconnections) {
            listConnections();
        }
        if (opts.listfactories) {
            listFactories();
        }
        if (opts.listtypes) {
            listTypes();
        }
        if (opts.listapps) {
            listApps();
        }
        if (opts.createindex) {
            createIndex();
        }
        if (!ARGV[0]) {
            usage();
        }

        on_exit {
            DataProvider::shutdown();
        }

        DataProviderDataContextHelper dch;
        if (opts.options.val()) {
            auto v = parseInputValue(opts.options);
            if (v.typeCode() != NT_HASH) {
                error("options have type %y; expecting \"hash\"", v.fullType());
            }
            dch = new DataProviderDataContextHelper(v);
        }

        logger = getLogger();
        DataProvider::setGlobalLogger(logger);

        if (opts.servers) {
            DataProvider::addOptions(DPO_EnableServers);
        }

        on_error rethrow $1.err, sprintf("%s%s", $1.desc,
            $1.arg instanceof object && $1.arg.hasCallableMethod("getCause")
                ? ": " + $1.arg.getCause().toString()
                : NOTHING);

        AbstractDataProvider provider;
        DataProviderContextHelper pctx;
        try {
            # first extract any data provider options
            string name = shift ARGV;
            # get expression in curly brackets, if any, respecting balanced brackets
            *string dp_opts = (name =~ x/({(?:(?>[^{}]*)|(?0))*})/)[0];
            if (dp_opts) {
                name = replace(name, dp_opts, "");
            } else {
                # remove empty options; the above regex does not catch them :(
                name =~ s/{}//;
            }
            if (name =~ /^@/) {
                splice name, 0, 1;
                # ignore any trailing "/"
                name =~ s/\/+$//;
                list<string> path = name.split("/");
                if (path.size() == 1) {
                    showActions(name);
                }
                app = path[0];
                action = path[1];
                provider = getDataProviderForAppAction(app, action, dp_opts);
            } else {
                list<string> path = name.split("/");
                provider = getDataProvider((shift path) + dp_opts);
                map provider = provider.getChildProviderEx($1), path;
            }
            provider.setLogger(logger);
            # Set debug collector if verbose mode is enabled
            if (opts.verbose) {
                provider.setDebugCollector(new ConsoleDebugInfoCollector(opts.verbose, color));
            }
            pctx = new DataProviderContextHelper(provider);
        } catch (hash<ExceptionInfo> ex) {
            if (!NoProviderCmds{ARGV[0]}) {
                rethrow;
            }
        }

        # Set up fake webhook interface for the TypeScriptActionInterface module if possible
        if (get_module_hash().TypeScriptActionInterface) {
            # make sure symbols are loaded in this Program
            load_module("TypeScriptActionInterface");
            Class cls = Class::forName("TypeScriptActionInterface::TypeScriptActionInterface");
            hash<MethodAccessInfo> info = cls.findStaticMethod("registerWebhookCreateDestroyApis");
            StaticMethodVariant v = info.method.getVariants()[0];
            v.call(\QdpCmd::getWebhook(), \QdpCmd::deleteWebhook());
        }

        on_exit if (http) {
            http.stop();
            delete http;
        }

        cmd = shift ARGV ?? "list";
        *code qdp_action = Cmds{cmd};
        if (!qdp_action) {
            # see if an abbreviation matches
            hash<string, bool> match = map {$1: True}, keys Cmds, $1.equalPartial(cmd);
            # try to disambiguate
            if (provider && (match.size() > 1)) {
                # only consider commands that are applicable for this data provider
                # AbstractDataProvider::getSummaryInfo() is generally faster than getInfo()
                hash<DataProviderSummaryInfo> info = provider.getSummaryInfo();
                match = map {$1: True}, keys match, !exists DisambiguationMap{$1}
                    || (info{DisambiguationMap{$1}} === True)
                    || (info{DisambiguationMap{$1}}.typeCode() == NT_STRING && info{DisambiguationMap{$1}} != "NONE");
            }
            if (match.size() == 1) {
                qdp_action = Cmds{match.firstKey()};
            } else if (match) {
                # check if all matches have the same action
                {
                    foreach string c in (keys match) {
                        if (!qdp_action) {
                            qdp_action = Cmds{c};
                        } else if (Cmds{c} != qdp_action) {
                            break;
                        }
                    }
                }
                if (!qdp_action) {
                    error("unknown action %y; matches %y; please provide additional character(s) to ensure a unique "
                        "match", cmd, keys match);
                }
            } else {
                error("unknown action %y; known actions: %y", cmd, keys Cmds);
            }
        }
        try {
            qdp_action(provider);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "INVALID-OPERATION") {
                error("%s: %s", ex.err, ex.desc);
            } else {
                rethrow;
            }
        }
    }

    hash<auto> getWebhook(hash<auto> h) {
        if (h.method.typeCode() != NT_STRING) {
            throw "WEBHOOK-ERROR", sprintf("\"method\" must be a string when registering a webhook; got type %y (%y)",
                h.method.fullType(), h.method);
        }
        if (!h.callback.callp()) {
            throw "WEBHOOK-ERROR", sprintf("\"callback\" must be a callable value when registering a webhook; got "
                "type %y (%y)", h.callback.fullType(), h.method);
        }
        # auth is validated but ignored
        if (exists h.auth && (h.auth.typeCode() != NT_INT)) {
            throw "WEBHOOK-ERROR", sprintf("\"auth\" must be a valid auth code if present when registering a "
                "webhook; got type %y (%y)", h.auth.fullType(), h.auth);
        }
        # perms is validated but ignored
        if (exists h.perms && h.perms.typeCode() != NT_LIST) {
            throw "WEBHOOK-ERROR", sprintf("\"perms\" must be a list of strings if present when registering a "
                "webhook; got type %y (%y)", h.perms.fullType(), h.perms);
        }

        setupHttpServer();

        string path = get_random_string();

        WebhookHandler handler(h.method, path, h.callback);
        hash<HttpHandlerConfigInfo> hinfo = <HttpHandlerConfigInfo>{
            "path": path,
            "handler": handler,
        };

        AutoLock al(wh_lock);
        http.setDynamicHandler(path, hinfo);
        whm{path} = handler;

        string http_host = opts.host ?? "localhost";
        if (*softint p = (http_host =~ x/:([0-9]+)$/)[0]) {
            http_host =~ s/:.*$//;
            http_port = p;
        }

        return {
            "url": sprintf("http://%s:%d/webhooks/%s", http_host, http_port, path),
        };
    }

    deleteWebhook(hash<auto> info) {
        if (http) {
            string path = (info.url =~ x/\/([^\/]+)$/)[0];
            http.removeDynamicHandler(path, True);
        }
    }

    synchronized setupHttpServer() {
        if (http) {
            return;
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": getLogger("http"),
            "debug": True,
        };

        http = new HttpServer(http_opts);
        http_port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    private Logger getLogger(string name = "console") {
        LoggerLevel level;
        if (opts.verbose > 1) {
            level = LoggerLevel::getLevelDebug();
        } else if (opts.verbose) {
            level = LoggerLevel::getLevelInfo();
        } else {
            level = LoggerLevel::getLevelError();
        }
        Logger logger(name, level);
        logger.addAppender(new ConsoleAppender());
        return logger;
    }

    #! Static version of getLogger() for use in static command methods
    static Logger getStaticLogger(string name = "pipeline") {
        LoggerLevel level;
        if (opts.verbose > 1) {
            level = LoggerLevel::getLevelDebug();
        } else if (opts.verbose) {
            level = LoggerLevel::getLevelInfo();
        } else {
            level = LoggerLevel::getLevelError();
        }
        Logger logger(name, level);
        logger.addAppender(new ConsoleAppender());
        return logger;
    }

    static exampleRequest(AbstractDataProvider provider) {
        output(provider.getExampleRequestData());
    }

    static exampleResponse(AbstractDataProvider provider) {
        output(provider.getExampleResponseData());
    }

    static exampleRecord(AbstractDataProvider provider) {
        output(provider.getExampleRecordData());
    }

    static listEvents(AbstractDataProvider provider) {
        hash<string, hash<DataProviderMessageInfo>> events = provider.getEventTypes();
        map printf(" - %s\n", $1), keys events;
    }

    static event(AbstractDataProvider provider) {
        *string event = QdpCmd::getString("event");
        *hash<auto> req;
        hash<DataProviderMessageInfo> event_info;
        if (event.val() && event =~ /=/) {
            req = getHashIntern(remove event, "request");
        }
        if (event.val()) {
            req = QdpCmd::getHash("request");
            event_info = provider.getEventInfoWithOptions(event, req);
        }
        if (!event.val()) {
            hash<string, hash<DataProviderMessageInfo>> event_types = provider.getEventTypes();
            if (event_types.size() == 1) {
                event = event_types.firstKey();
                if (req) {
                    event_info = provider.getEventInfoWithOptions(event, req);
                } else {
                    event_info = event_types.firstValue();
                }
            } else {
                QdpCmd::error("Missing required event argument; valid events: %y", keys event_types);
            }
        }
        DataProviderDataContextHelper dch(req);
        QdpCmd::showType(provider, event, event_info);
    }

    static exampleEvent(AbstractDataProvider provider) {
        *string event = QdpCmd::getString("event");
        if (!exists event) {
            *list<string> l = keys provider.getEventTypes();
            if (l.size() == 1) {
                event = l[0];
            } else {
                QdpCmd::error("Missing required event argument; valid events: %y", l);
            }
        }
        output(provider.getExampleEventData(event));
    }

    static errors(AbstractDataProvider provider) {
        *hash<string, AbstractDataProviderType> errs = provider.getErrorResponseTypes();
        *string err = QdpCmd::getString("error");
        if (err) {
            *AbstractDataProviderType type = errs{err};
            if (!type) {
                QdpCmd::error("unknown error code %y; known error codes: %y", err, keys errs);
            }
            QdpCmd::showType(provider, type);
            return;
        }

        if (!opts.verbose) {
            printf("%y\n", keys errs);
        } else {
            map (printf("%s:\n", $1.key), QdpCmd::showType(provider, $1.value, "  ")), errs.pairIterator();
        }
    }

    static exampleError(AbstractDataProvider provider) {
        string error = QdpCmd::getString("error", True);
        output(provider.getExampleErrorResponseData(error));
    }

    static AbstractDataField getField(string name, auto f) {
        if (f.typeCode() != NT_HASH) {
            QdpCmd::error("field %y value must be type \"hash\"; got type %y instead", name, f.type());
        }
        if (*hash<auto> err = (f - FieldKeys)) {
            QdpCmd::error("field %y has unknown keys: %y; known keys: %y", name, keys err, FieldKeys);
        }
        return new QoreDataField(name, f.desc, AbstractDataProviderType::get(f.type ?? "string", f.opts),
            f.default_value);
    }

    static providerCreate(AbstractDataProvider provider) {
        string name = QdpCmd::getString("provider-create 'name'", True);
        hash<auto> desc = QdpCmd::getHash("provider-create description", True);
        *hash<auto> opts = QdpCmd::getHash("provider-create options");

        hash<string, AbstractDataField> fields = map {$1.key: QdpCmd::getField($1.key, $1.value)}, desc.pairIterator();
        provider.createChildProvider(name, fields, opts);
        printf("created provider %s/%s\n", provider.getName(), name);
    }

    static providerDelete(AbstractDataProvider provider) {
        string name = QdpCmd::getString("provider-delete 'name'", True);
        provider.deleteChildProvider(name);
        printf("deleted provider %s/%s\n", provider.getName(), name);
    }

    static fieldAdd(AbstractDataProvider provider) {
        string name = QdpCmd::getString("field-add 'name'", True);
        hash<auto> desc = QdpCmd::getHash("field-add description", True);
        *hash<auto> opts = QdpCmd::getHash("field-add options");
        AbstractDataField field = QdpCmd::getField(name, desc);
        provider.addField(field, opts);
        printf("added field %y to provider %y\n", name, provider.getName());
    }

    static fieldUpdate(AbstractDataProvider provider) {
        string old_name = QdpCmd::getString("field-update 'old name'", True);
        string new_name = QdpCmd::getString("field-update 'new name'", True);
        *hash<auto> desc = QdpCmd::getHash("field-update description", True);
        *hash<auto> opts = QdpCmd::getHash("field-update options");
        AbstractDataField field;
        if (desc) {
            field = QdpCmd::getField(new_name, desc);
        } else {
            *hash<string, AbstractDataField> fields = provider.getRecordType();
            if (!fields{old_name}) {
                QdpCmd::error("provider %y has no field %y to update", provider.getName(), old_name);
            }
            field = fields{old_name};
        }
        provider.updateField(old_name, field, opts);
        if (old_name == new_name) {
            printf("updated field %y in provider %y\n", old_name, provider.getName());
        } else {
            printf("renamed field %y -> %y in provider %y\n", old_name, new_name, provider.getName());
        }
    }

    static fieldDelete(AbstractDataProvider provider) {
        string name = QdpCmd::getString("field-delete 'name'", True);
        provider.deleteField(name);
        printf("deleted field %y from provider %y\n", name, provider.getName());
    }

    static getInfo(AbstractDataProvider provider) {
        hash<DataProviderInfo> info = provider.getInfo();

        # For JSON/YAML output, convert type objects to serializable data
        if (opts.json || opts.yaml) {
            output(provider.getInfoAsData());
            return;
        }

        # User-friendly formatted output
        # Basic info section
        printf("%s\n", color.bold("Provider"));
        printf("  %s: %s\n", color.key("Name"), info.name);
        if (info.display_name && info.display_name != info.name) {
            printf("  %s: %s\n", color.key("Display Name"), info.display_name);
        }
        printf("  %s: %s\n", color.key("Type"), color.type(info.type));
        if (info.short_desc) {
            printf("  %s: %s\n", color.key("Description"), info.short_desc);
        }

        # Constructor options
        if (info.constructor_options) {
            printf("%s\n", color.bold("Constructor Options"));
            foreach hash<auto> opt in (info.constructor_options.pairIterator()) {
                string type_str = (map $1.getName(), opt.value.type).join("|");
                string req = opt.value.required ? color.error(" (required)") : "";
                printf("  %s [%s]%s\n", color.key(opt.key), color.type(type_str), req);
                if (opt.value.short_desc) {
                    printf("    %s\n", opt.value.short_desc);
                }
                if (opt.value.allowed_values) {
                    printf("    %s: %s\n", color.dim("values"),
                        (map $1.value, opt.value.allowed_values).join(", "));
                }
                if (exists opt.value.default_value) {
                    printf("    %s: %y\n", color.dim("default"), opt.value.default_value);
                }
            }
        }

        # Capabilities section
        printf("%s\n", color.bold("Capabilities"));
        list<string> caps = ();
        if (info.supports_read) push caps, "read";
        if (info.supports_create) push caps, "create";
        if (info.supports_update) push caps, "update";
        if (info.supports_upsert) push caps, "upsert";
        if (info.supports_delete) push caps, "delete";
        if (info.supports_native_search) push caps, "search";
        if (info.supports_bulk_read) push caps, "bulk-read";
        if (info.supports_bulk_create) push caps, "bulk-create";
        if (info.supports_bulk_upsert) push caps, "bulk-upsert";
        if (info.supports_request) push caps, "request/response";
        if (info.supports_observable) push caps, "events";
        if (info.supports_messages.val() && info.supports_messages != "NONE") push caps, "messages";

        if (caps) {
            printf("  %s\n", caps.join(", "));
        } else {
            printf("  %s\n", color.dim("(none)"));
        }

        # Record operations
        if (info.has_record) {
            printf("%s\n", color.bold("Record Operations"));
            printf("  %s: %s\n", color.key("Has Record Type"), color.success("Yes"));
            if (info.record_requires_search_options) {
                printf("  %s: %s\n", color.key("Requires Search Options"), "Yes");
            }
            if (info.supports_search_expressions) {
                printf("  %s: %s\n", color.key("Supports Search Expressions"), "Yes");
            }
            if (info.expressions) {
                printf("  %s:\n", color.key("Search Expressions"));
                foreach hash<auto> exp in (info.expressions.pairIterator()) {
                    string label = exp.value.symbol && exp.value.symbol != exp.key
                        ? sprintf("%s (%s)", exp.key, exp.value.symbol)
                        : exp.key;
                string desc = exp.value.short_desc ?? AbstractDataField::getShortDescription(exp.value.desc);
                printf("    - %s%s\n", color.type(label), desc ? ": " + desc : "");
            }
        }
        }

        # Request/Response API
        if (info.supports_request) {
            printf("%s\n", color.bold("Request/Response API"));
            printf("  %s: %s\n", color.key("Supported"), color.success("Yes"));
            *AbstractDataProviderType req_type = provider.getRequestType();
            *AbstractDataProviderType resp_type = provider.getResponseType();
            if (req_type) {
                printf("  %s: %s\n", color.key("Request Type"), req_type.getName());
            }
            if (resp_type) {
                printf("  %s: %s\n", color.key("Response Type"), resp_type.getName());
            }
        }

        # Messages
        *hash<string, hash<DataProviderMessageInfo>> messages;
        if (info.supports_messages.val() && info.supports_messages != "NONE") {
            messages = provider.getMessageTypes();
        }
        if (messages) {
            printf("%s\n", color.bold("Messages"));
            foreach hash<auto> msg in (messages.pairIterator()) {
                string type_info = msg.value.type ? msg.value.type.getName() : "auto";
                printf("  %s %s: %s\n", color.dim("→"), color.key(msg.key), color.type(type_info));
            }
        }

        # Events
        *hash<string, hash<DataProviderMessageInfo>> events;
        if (info.supports_observable) {
            events = provider.getEventTypes();
        }
        if (events) {
            printf("%s\n", color.bold("Events"));
            foreach hash<auto> evt in (events.pairIterator()) {
                string type_info = evt.value.type ? evt.value.type.getName() : "auto";
                printf("  %s %s: %s\n", color.dim("←"), color.key(evt.key), color.type(type_info));
            }
        }

        # Children
        *list<string> child_names = info.children ?? provider.getChildProviderNames();
        if (child_names) {
            printf("%s\n", color.bold("Children"));
            if (child_names.size() <= 10) {
                map printf("  • %s\n", color.key($1)), child_names;
            } else {
                map printf("  • %s\n", color.key($1)), child_names[0..9];
                printf("  %s\n", color.dim(sprintf("... and %d more", child_names.size() - 10)));
            }
        }

        # Provider-specific info (only if verbose)
        if (opts.verbose && info.info) {
            printf("%s\n", color.bold("Additional Info"));
            outputRecord(info.info);
        }

        # no trailing blank line
    }

    static listChildren(AbstractDataProvider provider) {
        *list<string> children = provider.getChildProviderNames();
        if (children) {
            output(children);
        } else {
            printf(provider.getName() + " has no children\n");
        }
    }

    static listChildDetails(AbstractDataProvider provider) {
        *list<hash<DataProviderSummaryInfo>> children = provider.getChildProviderSummaryInfo();
        if (children) {
            if (opts.json || opts.yaml) {
                output(children);
                return;
            }

            code get_code = string sub (hash<auto> h) {
                if (h.has_record) {
                    return "REC";
                }
                if (h.supports_request) {
                    return "API";
                }
                if (h.supports_observable) {
                    return "EVT";
                }
                if (h.supports_messages != MSG_None) {
                    return "MSG";
                }
                if (h.children_can_support_records) {
                    return "REC";
                }
                if (h.children_can_support_apis) {
                    return "API";
                }
                if (h.children_can_support_observers) {
                    return "EVT";
                }
                if (h.children_can_support_messages) {
                    return "MSG";
                }
                return "---";
            };
            map printf("- %s: (%s) %s\n", color.key($1.name), color.type(get_code($1)),
                QdpCmd::getDesc(10, $1, "name")), children;
        } else {
            printf(provider.getName() + " has no children\n");
        }
    }

    static string getDesc(int offset, hash<auto> h) {
        int len = TermIOS::getWindowSize().columns - offset;
        map len -= h{$1}.length(), argv;
        string desc = h.desc ?? "";
        desc =~ s/\n/ /g;
        desc =~ s/ +/ /g;
        if (len < 0) {
            return "";
        }
        if (desc.length() > len) {
            if (len <= 3) {
                splice desc, len;
            } else {
                splice desc, len - 3;
                desc += "...";
            }
        }
        return desc;
    }

    static interactive(AbstractDataProvider provider) {
        provider.checkObservable();
        {
            on_error rethrow $1.err, sprintf("%s (try using \"listen\" instead)", $1.desc);
            provider.checkMessages();
        }
        hash<DataProviderInfo> info = provider.getInfo();
        MyObserver observer(info);
        Observable observable = cast<Observable>(provider);

        ix = True;

        InputHelper input_helper(provider);

        # print welcome message
        if (input_helper.active_msgid) {
            stdout.printf("%s %s; active message: %s\n",
                color.green("listening to events from"),
                color.cyan(provider.getName()),
                color.type(input_helper.active_msgid));
            stdout.printf("type data to send, %s for help, %s to exit\n",
                color.bold("/help"),
                color.dim("Ctrl+C"));
        } else {
            stdout.printf("%s %s\n",
                color.green("listening to events from"),
                color.cyan(provider.getName()));
            stdout.printf("type %s to select a message type, %s for help\n",
                color.bold("/use <msg-id>"),
                color.bold("/help"));
        }

        observable.registerObserver(observer);

        if (observable instanceof DataProvider::DelayedObservable) {
            cast<DataProvider::DelayedObservable>(observable).observersReady();
        }

        while (!shutdown_requested) {
            string input = input_helper.get();
            if (shutdown_requested) {
                break;
            }
            if (input == "exit" || input == "quit") {
                break;
            }

            # Handle /send <id> <data>
            if (input =~ /^\/send(\s|$)/) {
                string rest = trim(input.substr(5));
                (*string send_id, *string send_data) = (rest =~ x/(\S+)\s+(.*)/s);
                if (!send_id) {
                    stdout.printf("%s: usage: /send <msg-id> <data>\n", color.error("ERROR"));
                    continue;
                }
                if (!input_helper.mmap.hasKey(send_id)) {
                    stdout.printf("%s: unknown message type %y; available: %s\n",
                        color.error("ERROR"), send_id,
                        (foldl $1 + ", " + $2, keys input_helper.mmap));
                    continue;
                }
                auto v;
                try {
                    v = parseInputValue(send_data);
                } catch (hash<ExceptionInfo> ex) {
                    stderr.printf("%s: %s; client-side error; the message was not sent\n",
                        ex.err, ex.desc);
                    continue;
                }
                printf("> %s %y -> %y\n", color.info("sending"), send_id, v);
                try {
                    provider.sendMessage(send_id, v);
                } catch (hash<ExceptionInfo> ex) {
                    stderr.printf("%s %s: %s\n", color.error("ERROR:"), ex.err, ex.desc);
                }
                continue;
            }

            # Unrecognized slash command (shouldn't reach here normally)
            if (input[0] == "/") {
                stdout.printf("unknown command %y; type /help for help\n", input);
                continue;
            }

            # Default: send data with active message ID
            *string msgid = input_helper.active_msgid;
            if (!msgid) {
                # Auto-select first available
                msgid = input_helper.setFirstMsgId();
                if (!msgid) {
                    stdout.printf("no message types available\n");
                    continue;
                }
                stdout.printf("auto-selected message type: %s\n", color.type(msgid));
            }

            auto v;
            try {
                v = parseInputValue(input);
            } catch (hash<ExceptionInfo> ex) {
                stderr.printf("%s: %s; client-side error; the message was not sent\n",
                    ex.err, ex.desc);
                continue;
            }
            printf("> %s %y -> %y\n", color.info("sending"), msgid, v);
            try {
                provider.sendMessage(msgid, v);
            } catch (hash<ExceptionInfo> ex) {
                stderr.printf("%s %s: %s\n", color.error("ERROR:"), ex.err, ex.desc);
            }
        }
        ix = False;
        printf("stopped\n");
    }

    static listMessages(AbstractDataProvider provider) {
        hash<string, hash<DataProviderMessageInfo>> messages = provider.getMessageTypes();
        map printf(" - %s\n", $1), keys messages;
    }

    static message(AbstractDataProvider provider) {
        *string message = QdpCmd::getString("message");
        if (!exists message) {
            QdpCmd::error("missing required message argument; valid messages: %y", keys provider.getMessageTypes());
        }
        QdpCmd::showType(provider, message, provider.getMessageInfo(message));
    }

    static listen(AbstractDataProvider provider) {
        provider.checkObservable();
        hash<DataProviderInfo> info = provider.getInfo();
        MyObserver observer(info);
        Observable observable = cast<Observable>(provider);

        # print a message
        string timeout_msg = opts.timeout ? sprintf(" %s", color.dim(sprintf("(timeout: %ds)", opts.timeout))) : "";
        stdout.printf("%s %s%s; press any key or %s to stop listening...\n",
            color.green("listening to events from"),
            color.cyan(provider.getName()),
            timeout_msg,
            color.dim("Ctrl+C"));
        {
            Term t();

            observable.registerObserver(observer);

            if (observable instanceof DataProvider::DelayedObservable) {
                cast<DataProvider::DelayedObservable>(observable).observersReady();
            }

            date start = now_us();
            while (observable.isActive() && !shutdown_requested) {
                # Check timeout
                if (opts.timeout && (now_us() - start) > seconds(opts.timeout)) {
                    printf("\n%s listen timed out after %d seconds\n", color.warning("TIMEOUT:"), opts.timeout);
                    break;
                }
                if (stdin.isDataAvailable(250ms)) {
                    stdin.readBinary(1);
                    break;
                }
            }
        }
        bool active = observable.isActive();
        delete provider;
        if (shutdown_requested) {
            printf("listening stopped due to signal\n");
        } else if (active) {
            printf("listening stopped on user request\n");
        } else {
            printf("listening stopped due to an error\n");
        }
    }

    static getRecord(AbstractDataProvider provider) {
        *hash<auto> search_options = QdpCmd::getHash("search options");
        *hash<string, AbstractDataField> rec = provider.getRecordType(search_options);
        if (opts.verbose > 1) {
            printf("%Y\n", (map {$1.key: $1.value.getInfo()}, rec.pairIterator()));
        } else {
            QdpCmd::showRecord(provider, rec);
        }
    }

    static getCreateRecord(AbstractDataProvider provider) {
        *hash<auto> create_options = QdpCmd::getHash("create options");
        *hash<string, AbstractDataField> rec = provider.getCreateRecordType(create_options);
        if (opts.verbose > 1) {
            printf("%Y\n", (map {$1.key: $1.value.getInfo()}, rec.pairIterator()));
        } else {
            QdpCmd::showRecord(provider, rec);
        }
    }

    static getUpdateRecord(AbstractDataProvider provider) {
        *hash<auto> search_options = QdpCmd::getHash("search options");
        *hash<string, AbstractDataField> rec = provider.getUpdateRecordType(search_options);
        if (opts.verbose > 1) {
            printf("%Y\n", (map {$1.key: $1.value.getInfo()}, rec.pairIterator()));
        } else {
            QdpCmd::showRecord(provider, rec);
        }
    }

    static getAllowedValues(reference<string> info, *list<auto> l) {
        if (info) {
            info += " ";
        }
        if (opts.verbose && l[0].typeCode() == NT_HASH) {
            if (l[0].value != l[0].display_name) {
                info += sprintf("allowed_values: %y", (map sprintf("%s (%s)", $1.display_name, $1.value), l));
            } else {
                info += sprintf("allowed_values: %y", (map $1.value, l));
            }
        } else {
            info += sprintf("allowed_values: %y", (map $1.value ?? $1, l));
        }
    }

    static showRecord(*AbstractDataProvider prov, *hash<string, AbstractDataField> rec,
            string offset = "", auto dctxt) {
        hash<string, bool> rmap;
        showRecord(prov, \rmap, rec, offset, dctxt);
    }

    static showRecord(*AbstractDataProvider prov, reference<hash<string, bool>> rmap, *hash<string, AbstractDataField> rec,
            string offset = "", auto dctxt, *bool unsatisfied_deps) {
        foreach hash<auto> i in (rec.pairIterator()) {
            *bool local_unsatisfied_deps = unsatisfied_deps;
            auto dv = i.value.getDefaultValue();
            if (prov && !exists dv && !unsatisfied_deps) {
                if ((*string default_ref_data = i.value.getAttributes().default_ref_data).val()) {
                    dv = prov.getReferenceDataValueSafe(default_ref_data, DataProviderDataContextHelper::getHash());
                } else if (!offset.val() && prov.getSupportedReferenceDataValues(){i.key}) {
                    dv = prov.getReferenceDataValueSafeEx(i.key, DataProviderDataContextHelper::getHash());
                }
            }
            if (opts.required && (!i.value.isMandatory() || exists dv)) {
                continue;
            }
            AbstractDataProviderType type = i.value.getType();
            *hash<auto> attr = i.value.getAttributes();
            # do not request dependent values if dependencies are not satisfied
            if (!local_unsatisfied_deps && attr.depends_on && (dctxt{attr.depends_on}.size() != attr.depends_on.size())) {
                local_unsatisfied_deps = True;
            }
            showField(prov, \rmap, i, dv, type, offset, dctxt, local_unsatisfied_deps);
            *hash<string, AbstractDataField> fields = type.getFields();
            if (fields) {
                string u = type.uniqueHash();
                if (!rmap{u}) {
                    rmap{u} = True;
                    QdpCmd::showRecord(prov, \rmap, fields, offset + "  ", dctxt{i.key}, local_unsatisfied_deps);
                }
            }
        }
    }

    static showField(*AbstractDataProvider prov, reference<hash<string, bool>> rmap, hash<auto> i, auto dv,
            AbstractDataProviderType type, string offset, auto dctxt, *bool unsatisfied_deps) {
        if (opts.verbose) {
            string txt = sprintf("%s%s %s", offset, type.getName(), i.key);
            string info;
            if (*string desc = i.value.getShortDescription()) {
                info = sprintf("desc: %y", QdpCmd::getDesc(0, {"desc": desc}));
            }
            if (exists dv) {
                if (info) {
                    info += " ";
                }
                info += sprintf("default_value: %y", dv);
            }

            if (*list<auto> l = i.value.getAllowedValues()) {
                QdpCmd::getAllowedValues(\info, l);
            } else if (prov && !unsatisfied_deps && (*string ref_data = i.value.getAttributes().ref_data).val()) {
                l = prov.getReferenceDataSafe(ref_data, DataProviderDataContextHelper::getHash());
                QdpCmd::getAllowedValues(\info, l);
            } else if (prov && !unsatisfied_deps && !offset.val() && prov.getSupportedReferenceData(){i.key}
                && (l = prov.getReferenceDataSafeEx(i.key, DataProviderDataContextHelper::getHash()))) {
                QdpCmd::getAllowedValues(\info, l);
            } else if (l = i.value.getElementAllowedValues()) {
                QdpCmd::getAllowedValues(\info, l);
            } else if (prov && !unsatisfied_deps && (ref_data = i.value.getAttributes().element_ref_data).val()) {
                l = prov.getElementReferenceDataSafe(ref_data, DataProviderDataContextHelper::getHash());
                QdpCmd::getAllowedValues(\info, l);
            } else if (prov && !unsatisfied_deps && !offset.val() && prov.getSupportedElementReferenceData(){i.key}
                && (l = prov.getElementReferenceDataSafeEx(i.key, DataProviderDataContextHelper::getHash()))) {
                QdpCmd::getAllowedValues(\info, l);
            }

            if (info) {
                txt += " (" + info + ")";
            }
            print(txt);
        } else {
            string info;
            if (*list<auto> l = i.value.getAllowedValues()) {
                info += sprintf(" (one of: %y)", (map $1.value ?? $1, l));
            } else if (prov && !unsatisfied_deps && (*string ref_data = i.value.getAttributes().ref_data).val()) {
                l = prov.getReferenceDataSafe(ref_data, DataProviderDataContextHelper::getHash());
                if (l) {
                    info += sprintf(" (one of: %y)", (map $1.value ?? $1, l));
                }
            } else if (l = i.value.getElementAllowedValues()) {
                info += sprintf(" (elements: one of: %y)", (map $1.value ?? $1, l));
            } else if (prov && !unsatisfied_deps && (ref_data = i.value.getAttributes().element_ref_data).val()) {
                l = prov.getElementReferenceDataSafe(ref_data, DataProviderDataContextHelper::getHash());
                if (l) {
                    info += sprintf(" (elements: one of: %y)", (map $1.value ?? $1, l));
                }
            }
            printf("%s%s %s%s", offset, type.getName(), i.key, info);
        }
        if (type.getBaseTypeCode() == NT_LIST && (*AbstractDataProviderType element_type = type.getElementType())
            && (*hash<string, AbstractDataField> element_rec = element_type.getFields())) {
            string u = type.uniqueHash();
            if (!rmap{u}) {
                rmap{u} = True;
                print(": elements ->\n");
                QdpCmd::showRecord(prov, \rmap, element_rec, offset + "  ", dctxt{i.key}, unsatisfied_deps);
            } else {
                print(": (type already described)\n");
            }
        } else {
            print("\n");
        }
    }

    static search(AbstractDataProvider provider) {
        *hash<auto> where_cond = QdpCmd::getSearchExpression("search", NOTHING, provider);
        *hash<auto> search_options = QdpCmd::getHash("search options");

        # Add limit/offset to search options if specified
        if (opts.limit) {
            search_options.limit = opts.limit;
        }
        if (opts.offset) {
            search_options.offset = opts.offset;
        }

        AbstractDataProviderRecordIterator i;
        if (opts.bulk) {
            i = provider.searchRecordsBulk(NOTHING, where_cond, search_options).getRecordIterator();
        } else {
            i = provider.searchRecords(where_cond, search_options);
        }

        # Collect results for JSON/YAML output or output directly
        if (opts.json || opts.yaml) {
            list<auto> results = ();
            int count = 0;
            date start = now_us();
            while (i.next()) {
                if (shutdown_requested) {
                    stderr.printf("Search interrupted after %d records\n", count);
                    break;
                }
                if (opts.timeout && (now_us() - start) > seconds(opts.timeout)) {
                    stderr.printf("Search timed out after %d seconds (%d records)\n", opts.timeout, count);
                    break;
                }
                push results, i.getValue();
                ++count;
            }
            output(results);
        } else {
            int count = 0;
            date start = now_us();
            while (i.next()) {
                if (shutdown_requested) {
                    stderr.printf("\nSearch interrupted after %d records\n", count);
                    break;
                }
                if (opts.timeout && (now_us() - start) > seconds(opts.timeout)) {
                    stderr.printf("\nSearch timed out after %d seconds (%d records)\n", opts.timeout, count);
                    break;
                }
                outputRecord(i.getValue());
                ++count;
            }
        }
    }

    static pipeline(AbstractDataProvider provider) {
        # Get output provider spec (required)
        *string output_spec = shift ARGV;
        if (!output_spec) {
            error("pipeline command requires an output provider argument\n"
                "  Usage: qdp <input-provider> pipeline <output-provider> [search-criteria]");
        }

        # Get optional search criteria (reuses existing DPQL/hash/expression patterns)
        *hash<auto> where_cond = QdpCmd::getSearchExpression("pipeline search", NOTHING, provider);
        *hash<auto> search_options = QdpCmd::getHash("search options");

        # Add limit/offset to search options if specified
        if (opts.limit) {
            search_options.limit = opts.limit;
        }
        if (opts.offset) {
            search_options.offset = opts.offset;
        }

        # Resolve output provider
        AbstractDataProvider output_provider;
        try {
            output_provider = resolveProvider(output_spec);
        } catch (hash<ExceptionInfo> ex) {
            error("cannot resolve output provider %y: %s: %s", output_spec, ex.err, ex.desc);
        }

        # Pre-flight validation
        hash<DataProviderSummaryInfo> in_info = provider.getSummaryInfo();
        hash<DataProviderSummaryInfo> out_info = output_provider.getSummaryInfo();
        if (!in_info.supports_read) {
            error("input provider %y does not support reading records", provider.getName());
        }
        if (!out_info.supports_create) {
            error("output provider %y does not support creating records", output_provider.getName());
        }

        # Load optional mapper
        *Mapper mapper = loadMapper();

        # Dry-run: show pipeline plan without executing
        if (opts.dryrun) {
            printf("%s\n", color.bold("Pipeline Plan (dry-run):"));
            printf("  %s %s\n", color.key("Input:"), provider.getName());
            if (mapper) {
                printf("  %s %s (%d field%s)\n", color.key("Mapper:"),
                    is_readable(opts.mapper) ? "file: " + opts.mapper : "inline",
                    mapper.getMapHash().size(),
                    mapper.getMapHash().size() == 1 ? "" : "s");
            } else {
                printf("  %s no (pass-through)\n", color.key("Mapper:"));
            }
            printf("  %s %s\n", color.key("Output:"), output_provider.getName());
            if (where_cond) {
                printf("  %s %y\n", color.key("Filter:"), where_cond);
            }
            if (opts.limit) {
                printf("  %s %d\n", color.key("Limit:"), opts.limit);
            }
            if (opts.offset) {
                printf("  %s %d\n", color.key("Offset:"), opts.offset);
            }
            printf("  %s %s\n", color.key("Bulk:"), opts.bulk ? "yes" : "no");
            printf("  %s %s\n", color.key("Input supports read:"), in_info.supports_read ? "yes" : "no");
            printf("  %s %s\n", color.key("Output supports create:"), out_info.supports_create ? "yes" : "no");
            if (opts.bulk) {
                printf("  %s %s\n", color.key("Output supports bulk create:"),
                    out_info.supports_bulk_create ? "yes" : "no");
            }
            return;
        }

        # Build pipeline with logging + metrics
        Logger plogger = getStaticLogger("pipeline");
        hash<PipelineOptionInfo> pl_opts = <PipelineOptionInfo>{
            "name": sprintf("%s -> %s", provider.getName(), output_provider.getName()),
            "info_log": sub (string fmt) { plogger.info(vsprintf(fmt, argv)); },
            "error_log": sub (string fmt) { plogger.error(vsprintf(fmt, argv)); },
            "debug_log": sub (string fmt) { plogger.debug(vsprintf(fmt, argv)); },
        };

        # Add progress metrics unless JSON/YAML output mode (clean machine-readable output)
        if (!opts.json && !opts.yaml) {
            pl_opts.metrics_collector = new ProgressMetricsCollector();
        }

        DataProviderPipeline pipeline(pl_opts);
        if (mapper) {
            pipeline.append(mapper);
        }
        pipeline.append(new DataProviderOutputProcessor(output_spec, out_info.supports_bulk_create));

        # Handle signal interrupt for graceful shutdown
        code orig_handler = \QdpCmd::signalHandler();
        set_signal_handler(SIGINT, sub (int sig) {
            orig_handler(sig);
            pipeline.abort(True);
        });

        on_exit {
            set_signal_handler(SIGINT, orig_handler);
        }

        # Get search iterator and submit to pipeline
        try {
            if (opts.bulk) {
                AbstractDataProviderBulkRecordInterface bi =
                    provider.searchRecordsBulk(NOTHING, where_cond, search_options);
                pipeline.submit(bi);
            } else {
                AbstractDataProviderRecordIterator i = provider.searchRecords(where_cond, search_options);
                pipeline.submit(i);
            }
            pipeline.waitDone();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "PIPELINE-FAILED") {
                stderr.printf("%s pipeline failed: %s\n", color.error("ERROR:"), ex.desc);
                if (ex.arg) {
                    foreach auto err in (ex.arg) {
                        stderr.printf("  %s %s: %s\n", color.error("-"), err.err, err.desc);
                    }
                }
                exit(1);
            }
            rethrow;
        }

        # Print final summary
        hash<PipelineInfo> info = pipeline.getInfo();
        if (opts.json || opts.yaml) {
            output(info);
        } else {
            printf("%s %d records in %s (%.1f rec/s)\n",
                color.info("pipeline complete:"),
                info.record_count,
                info.duration.format("HH:mm:SS.xx"),
                info.recs_per_sec);
        }
    }

    static sendMessage(AbstractDataProvider provider) {
        string message_id = QdpCmd::getString("message_id", True);
        auto val = QdpCmd::getAny("data");
        *hash<auto> send_options = QdpCmd::getHash("send options");

        if (provider instanceof DataProvider::DelayedObservable) {
            cast<DataProvider::DelayedObservable>(provider).observersReady();
        }

        provider.sendMessage(message_id, val, send_options);
    }

    static showProviders(AbstractDataProvider provider) {
        QdpCmd::showProviders("/", provider);
    }

    static showProviders(string path, AbstractDataProvider provider) {
        hash<DataProviderInfo> info = provider.getInfo();
        string type;
        if (info.supports_request) {
            type += "A";
        } else {
            type += "-";
        }
        if (info.supports_observable) {
            type += "E";
        } else {
            type += "-";
        }
        if (info.supports_messages != MSG_None) {
            type += "M";
        } else {
            type += "-";
        }
        if (info.has_record && (info.supports_read || info.supports_create || info.supports_update
            || info.supports_upsert)) {
            type += "R";
        } else {
            type += "-";
        }
        if (type != "----") {
            string desc = sprintf("(%s) %s", type, path);
            if (opts.verbose) {
                desc += sprintf(": %s", provider.getShortDesc());
            }
            printf("- %s\n", desc);
        }
        if (path !~ /\/$/) {
            path += "/";
        }
        *list<string> l = QdpCmd::time(sprintf("get provider names: %y", provider.getName()),
            \provider.getChildProviderNames());
        foreach string child in (l) {
            AbstractDataProvider cp = QdpCmd::time(sprintf("get child %y from %y (%s)", child, provider.getName(),
                provider.className()),
                \provider.getChildProviderEx(), child);
            QdpCmd::showProviders(path + child, cp);
        }

        #map QdpCmd::showProviders(path + $1, provider.getChildProviderEx($1)), provider.getChildProviderNames();
    }

    static auto time(string label, code call, ...) {
        date start = now_us();
        auto rv = call_function_args(call, argv);
        date d = now_us() - start;
        if (d > 500ms) {
            printf("CALL %y: %y\n", label, d);
        }
        return rv;
    }

    static actionInfo(*AbstractDataProvider provider) {
        if (!exists app) {
            QdpCmd::error("Missing app and action for action info; use:\n    %s @<app>/<action> %s",
                get_script_name(), cmd);
        }
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx(app, QdpCmd::action);
        printf("%s/%s (%s%s): %s\n", color.key("@" + app), color.bold(QdpCmd::action),
            color.type(ActionNameMap{action.action_code}),
            (action.action_val.val() ? " \"" + action.action_val + "\"" : ""), action.short_desc);
        action = DataProviderActionCatalog::checkAppActionOptions(action.app, action.action);
        *hash<auto> req = getHashIntern(shift ARGV, "options");
        *hash<string, hash<ActionOptionInfo>> opts = provider
            ? provider.tryGetActionOptionsWithOptions(action, req)
            : action.options;
        if (opts) {
            printf("%s\n", color.bold("Options"));
            foreach hash<auto> i in (opts.pairIterator()) {
                string tn = i.value.type.getName();
                # get allowed values or element allowed values
                string info;
                if (*list<auto> l = i.value.allowed_values) {
                    info += sprintf(", one of: %y", (map $1.value ?? $1, l));
                } else if (provider && (*string ref_data = i.value.ref_data).val()) {
                    l = provider.getReferenceDataSafe(ref_data, DataProviderDataContextHelper::getHash());
                    if (l) {
                        info += sprintf(", one of: %y", (map $1.value ?? $1, l));
                    }
                } else if (l = i.value.element_allowed_values) {
                    info += sprintf(", elements: one of: %y", (map $1.value ?? $1, l));
                } else if (provider && (ref_data = i.value.element_ref_data).val()) {
                    l = provider.getElementReferenceDataSafe(ref_data, DataProviderDataContextHelper::getHash());
                    if (l) {
                        info += sprintf(", elements: one of: %y", (map $1.value ?? $1, l));
                    }
                }
                string req_str = i.value.required ? color.error(" (required)") : "";
                printf("  %s [%s%s]%s: %s\n", color.key(i.key),
                    i.value.required || tn =~ /^\*/ ? "" : "*", color.type(tn), req_str,
                    i.value.short_desc);
                if (info) {
                    printf("    %s%s\n", color.dim("values"), info);
                }
            }
        } else {
            printf("Options: %s\n", color.dim("none"));
        }
        if (action.output_type) {
            printf("%s\n", color.bold("Output"));
            QdpCmd::showType(provider, action.output_type, "  ");
        }
    }

    static update(AbstractDataProvider provider) {
        hash<auto> set = QdpCmd::getHash("update 'set'", True);
        *hash<auto> where_cond = QdpCmd::getSearchExpression("update 'where'", True, provider);

        if (opts.dryrun) {
            printf("%s Would update records matching:\n", color.warning("[DRY-RUN]"));
            printf("  %s: ", color.key("where"));
            outputRecord(where_cond);
            printf("  %s: ", color.key("set"));
            outputRecord(set);
            return;
        }

        int rec_count = provider.updateRecords(set, where_cond);
        printf("%s %d record%s updated\n", color.success("SUCCESS:"), rec_count, rec_count == 1 ? "" : "s");
    }

    static create(AbstractDataProvider provider) {
        *hash<auto> rec = QdpCmd::getHash("create");
        if (!exists rec) {
            QdpCmd::error("missing argument to 'create' action; a hash is required");
        }

        if (opts.dryrun) {
            printf("%s Would create record(s):\n", color.warning("[DRY-RUN]"));
            outputRecord(rec);
            return;
        }

        *hash<auto> rv = provider.createRecordsBulk(rec);
        if (opts.verbose) {
            printf("new record(s): ");
            output((map $1, rv.contextIterator()));
        }
        int size = rv.firstValue().lsize();
        printf("%s %d record%s successfully created\n", color.success("SUCCESS:"), size, size == 1 ? "" : "s");
    }

    static upsert(AbstractDataProvider provider) {
        *hash<auto> rec = QdpCmd::getHash("upsert");
        *hash<auto> upsert_options = QdpCmd::getHash("upsert options");

        if (opts.dryrun) {
            printf("%s Would upsert record(s):\n", color.warning("[DRY-RUN]"));
            outputRecord(rec);
            if (upsert_options) {
                printf("  %s: ", color.key("options"));
                outputRecord(upsert_options);
            }
            return;
        }

        *list<string> result = provider.upsertRecordsBulk(rec, upsert_options);
        printf("%s upsert result: ", color.success("SUCCESS:"));
        output(result);
    }

    static del(AbstractDataProvider provider) {
        *hash<auto> where_cond = QdpCmd::getSearchExpression("delete", NOTHING, provider);

        if (opts.dryrun) {
            printf("%s Would delete records matching:\n", color.warning("[DRY-RUN]"));
            outputRecord(where_cond);
            return;
        }

        int rec_count = provider.deleteRecords(where_cond);
        printf("%s %d record%s deleted\n", color.success("SUCCESS:"), rec_count, rec_count == 1 ? "" : "s");
    }

    static doRequest(AbstractDataProvider provider) {
        *hash<auto> req = QdpCmd::getHash("request");
        *hash<auto> options = QdpCmd::getHash("request-options");

        # Add timeout to options if specified
        if (opts.timeout && !options.timeout) {
            options.timeout = opts.timeout * 1000;  # convert seconds to milliseconds
        }

        auto resp = provider.doRequest(req, options);
        if (!opts.verbose && resp.hasKey("info") && resp.info."response-uri" && exists resp.body) {
            if (opts.json || opts.yaml) {
                output(resp.body);
            } else {
                printf("%s: ", color.info(resp.info."response-uri"));
                outputRecord(resp.body);
            }
        } else {
            output(resp);
        }
    }

    static doRequestSearch(AbstractDataProvider provider) {
        hash<auto> req = QdpCmd::getHash("request", True);
        hash<auto> where_cond = QdpCmd::getSearchExpression("request-search", True, provider);
        *hash<auto> options = QdpCmd::getHash("request-options");

        # Add limit/offset to options if specified
        if (opts.limit) {
            options.limit = opts.limit;
        }
        if (opts.offset) {
            options.offset = opts.offset;
        }
        # Add timeout if specified
        if (opts.timeout && !options.timeout) {
            options.timeout = opts.timeout * 1000;
        }

        AbstractDataProviderRecordIterator i = provider.requestSearchRecords(req, where_cond, options);

        # Collect results for JSON/YAML output or output directly
        if (opts.json || opts.yaml) {
            list<auto> results = ();
            int count = 0;
            date start = now_us();
            while (i.next()) {
                if (shutdown_requested) {
                    stderr.printf("Search interrupted after %d records\n", count);
                    break;
                }
                if (opts.timeout && (now_us() - start) > seconds(opts.timeout)) {
                    stderr.printf("Search timed out after %d seconds (%d records)\n", opts.timeout, count);
                    break;
                }
                push results, i.getValue();
                ++count;
            }
            output(results);
        } else {
            int count = 0;
            date start = now_us();
            while (i.next()) {
                if (shutdown_requested) {
                    stderr.printf("\nSearch interrupted after %d records\n", count);
                    break;
                }
                if (opts.timeout && (now_us() - start) > seconds(opts.timeout)) {
                    stderr.printf("\nSearch timed out after %d seconds (%d records)\n", opts.timeout, count);
                    break;
                }
                outputRecord(i.getValue());
                ++count;
            }
        }
    }

    static request(AbstractDataProvider provider) {
        if (*hash<auto> req = QdpCmd::getHash("request")) {
            DataProviderDataContextHelper dch(req);
            QdpCmd::showType(provider, provider.getRequestTypeWithData(req));
        } else {
            QdpCmd::showType(provider, provider.getRequestType());
        }
        if (opts.verbose) {
            *hash<string, hash<DataProviderOptionInfo>> opts = provider.getRequestOptions();
            if (opts) {
                QdpCmd::showOptionHash(provider, opts);
            }
        }
    }

    static response(AbstractDataProvider provider) {
        if (*hash<auto> req = QdpCmd::getHash("request")) {
            DataProviderDataContextHelper dch(req);
            QdpCmd::showType(provider, provider.getResponseTypeWithData(req));
        } else {
            QdpCmd::showType(provider, provider.getResponseType());
        }
    }

    static showOptionHash(AbstractDataProvider prov, *hash<auto> req, string offset = "") {
        foreach hash<auto> i in (req.pairIterator()) {
            foreach AbstractDataProviderType type in (i.value.type) {
                if (i.value.type.lsize() > 1) {
                    printf("%s[%d]: %s %s\n", offset, $#, type.getName(), i.key);
                } else {
                    printf("%s%s %s\n", offset, type.getName(), i.key);
                }
                *hash<string, AbstractDataField> fields = type.getFields();
                if (fields) {
                    QdpCmd::showRecord(prov, fields, offset + "  ");
                }
            }
        }
    }

    static showType(*AbstractDataProvider prov) {
        # intentionally empty
    }

    static showType(*AbstractDataProvider prov, string msg, hash<DataProviderMessageInfo> info) {
        printf("%y: %s\n", msg, QdpCmd::getDesc(0, info));
        hash<string, bool> rmap;
        # For simple types without fields, show explanation
        if (info.type && !info.type.getFields()) {
            string type_name = info.type.getName();
            string explanation = QdpCmd::getSimpleTypeExplanation(type_name);
            printf("%s%s\n", type_name, explanation ? " (" + explanation + ")" : "");
        } else if (info.type) {
            QdpCmd::showType(prov, \rmap, info.type);
        }
    }

    #! Returns a human-readable explanation for simple type names
    static string getSimpleTypeExplanation(string type_name) {
        # Handle optional types (starting with *)
        bool optional = type_name[0] == "*";
        string base_type = optional ? type_name.substr(1) : type_name;
        string opt_prefix = optional ? "optional " : "";

        switch (base_type) {
            case "auto": return opt_prefix + "any value of any type";
            case "data": return opt_prefix + "string or binary data";
            case "string": return opt_prefix + "text string";
            case "binary": return opt_prefix + "binary data";
            case "int": return opt_prefix + "integer number";
            case "float": return opt_prefix + "floating-point number";
            case "number": return opt_prefix + "arbitrary-precision number";
            case "bool": return opt_prefix + "true or false";
            case "date": return opt_prefix + "date/time value";
            case "hash": return opt_prefix + "key-value mapping";
            case "list": return opt_prefix + "list of values";
            case "nothing": return "no value (null)";
            case "softstring": return opt_prefix + "value converted to string";
            case "softint": return opt_prefix + "value converted to integer";
            case "softbool": return opt_prefix + "value converted to boolean";
            case "softdate": return opt_prefix + "value converted to date";
            case "softfloat": return opt_prefix + "value converted to float";
            case "softnumber": return opt_prefix + "value converted to number";
            case "softlist": return opt_prefix + "value converted to list";
            default: return "";
        }
    }

    static showType(*AbstractDataProvider prov, AbstractDataProviderType type, *string offset) {
        hash<string, bool> rmap;
        QdpCmd::showType(prov, \rmap, type, offset);
    }

    static showType(*AbstractDataProvider prov, reference<hash<string, bool>> rmap, AbstractDataProviderType type,
            *string offset) {
        *hash<string, AbstractDataField> fields = type.getFields();
        # get data context
        auto dctxt = DataProviderDataContextHelper::get();
        if (fields) {
            QdpCmd::showRecord(prov, \rmap, fields, offset, dctxt);
        } else {
            if (type.getBaseTypeCode() == NT_LIST && (*AbstractDataProviderType element_type = type.getElementType())
                && (*hash<string, AbstractDataField> element_rec = element_type.getFields())) {
                printf("%s%s elements ->\n", type.getName(), offset);
                QdpCmd::showRecord(prov, \rmap, element_rec, offset + "  ", dctxt[0]);
            } else {
                printf("%s%s\n", offset, type.getName());
            }
        }

        if (prov) {
            *hash<auto> tags = type.getTags();
            string info;
            if (tags.ref_data.val()) {
                *list<auto> l = prov.getReferenceDataSafe(tags.ref_data, DataProviderDataContextHelper::getHash());
                QdpCmd::getAllowedValues(\info, l);
            } else if (tags.element_ref_data.val()) {
                *list<auto> l = prov.getElementReferenceDataSafe(tags.element_ref_data, DataProviderDataContextHelper::getHash());
                QdpCmd::getAllowedValues(\info, l);
            }
            if (info) {
                printf("  %s%s\n", offset, info);
            }
        }
    }

    static *hash<auto> getSearchExpression(string action, *bool required, *AbstractDataProvider provider) {
        auto arg = shift ARGV;
        if (opts.dpql) {
            if (!exists arg) {
                if (required) {
                    QdpCmd::error("Missing required %s argument; expecting type \"string\"", action);
                }
                return;
            }
            return QdpCmd::parseDpqlExpression(arg, provider, DataProviderDataContextHelper::getHash());
        }

        *hash<auto> rv;
        if (opts.exp) {
            rv = QdpCmd::getHashIntern(arg, action, required);
            if (rv && rv.size() == 2 && rv.exp.typeCode() == NT_STRING && rv.hasKey("args")) {
                return QdpCmd::getExpression(rv.exp, rv.args);
            }
            return rv;
        }

        if (!exists arg) {
            if (required) {
                QdpCmd::error("Missing required %s argument; expecting type \"hash\"", action);
            }
            return;
        }

        if (QdpCmd::isDpqlCandidate(arg)) {
            hash<auto> parsed = QdpCmd::parseDpqlExpressionWithErrors(arg, provider,
                DataProviderDataContextHelper::getHash());
            if (!parsed.errors) {
                return parsed.expression;
            }
            # Legacy fallback is only for qdp auto-detection (no --dpql / --expressions).
            *hash<auto> legacy = QdpCmd::tryGetHashValue(arg);
            if (legacy) {
                return legacy;
            }
            QdpCmd::error(QdpCmd::formatDpqlErrors(parsed.errors, parsed.diagnostics, arg));
        }

        # Try legacy key=value syntax (parse_to_qore_value) before format-dependent parsing,
        # since parseInputValue with -Y/--yaml won't understand key=value syntax.
        {
            *hash<auto> legacy = QdpCmd::tryGetHashValue(arg);
            if (legacy) {
                return legacy;
            }
        }

        return QdpCmd::getHashIntern(arg, action, required);
    }

    static bool isDpqlCandidate(string text) {
        return (text =~ /@/)
            || (text =~ /==|!=|=~|&&|\|\|/)
            || (text =~ /\bbetween\b|\bin\b/);
    }

    static bool isEmptyDpqlExpression(string dpql) {
        string trimmed = trim(dpql);
        return !trimmed || trimmed == "-" || trimmed == "{}";
    }

    static *hash<DataProviderExpression> parseDpqlExpression(string dpql, *AbstractDataProvider provider,
            *hash<auto> action_opts) {
        hash<auto> parsed = QdpCmd::parseDpqlExpressionWithErrors(dpql, provider, action_opts);
        if (parsed.errors) {
            QdpCmd::error(QdpCmd::formatDpqlErrors(parsed.errors, parsed.diagnostics, dpql));
        }
        return parsed.expression;
    }

    static hash<auto> parseDpqlExpressionWithErrors(string dpql, *AbstractDataProvider provider,
            *hash<auto> action_opts) {
        if (QdpCmd::isEmptyDpqlExpression(dpql)) {
            return {
                "expression": NOTHING,
                "diagnostics": (),
                "errors": (),
            };
        }
        *hash<string, hash<DataProviderExpressionInfo>> expressions;
        if (provider) {
            expressions = provider.getExpressionsWithOptions(action_opts);
        }
        hash<DpqlParseResult> result = DataProvider::parseDpqlExpressionWithInfo(dpql, expressions);
        list<hash<DpqlDiagnostic>> diagnostics = result.diagnostics ?? ();
        if (provider) {
            *hash<string, AbstractDataField> fields = provider.getRecordTypeWithOptions(action_opts, NOTHING);
            if (fields) {
                diagnostics += DataProvider::validateDpqlExpression(dpql, fields, expressions);
            }
        }
        diagnostics = QdpCmd::dedupeDpqlDiagnostics(diagnostics);
        list<hash<DpqlDiagnostic>> errors = QdpCmd::getDpqlErrors(diagnostics);
        if (result.success && result.expression && !QdpCmd::hasDpqlFieldReferences(result.expression)) {
            hash<DpqlDiagnostic> diag = <DpqlDiagnostic>{
                "severity": "error",
                "message": "DPQL expression does not reference any server fields; use @field or legacy search syntax",
                "code": "DPQL-E020",
                "line": 1,
                "column": 1,
                "end_line": 1,
                "end_column": 1,
            };
            diagnostics += diag;
            errors += diag;
        }
        errors = QdpCmd::dedupeDpqlDiagnostics(errors);
        return {
            "expression": result.expression,
            "diagnostics": diagnostics,
            "errors": errors,
        };
    }

    static list<hash<DpqlDiagnostic>> getDpqlErrors(list<hash<DpqlDiagnostic>> diagnostics) {
        if (!diagnostics) {
            return ();
        }
        return select diagnostics, $1.severity == "error";
    }

    static list<hash<DpqlDiagnostic>> dedupeDpqlDiagnostics(list<hash<DpqlDiagnostic>> diagnostics) {
        if (!diagnostics) {
            return ();
        }
        hash<string, bool> seen = {};
        list<hash<DpqlDiagnostic>> rv = ();
        foreach hash<DpqlDiagnostic> diag in (diagnostics) {
            string key = sprintf("%s|%s|%d|%d|%s", diag.severity, diag.code, diag.line, diag.column, diag.message);
            if (!seen{key}) {
                seen{key} = True;
                rv += diag;
            }
        }
        return rv;
    }

    static string formatDpqlErrors(list<hash<DpqlDiagnostic>> errors, list<hash<DpqlDiagnostic>> diagnostics,
            string dpql) {
        if (!errors && diagnostics) {
            errors = diagnostics;
        }
        if (!errors) {
            return "DPQL parse error";
        }
        string msg = sprintf("DPQL parse error: %s", QdpCmd::sanitizeDpqlErrorMessage(errors[0].message, dpql));
        if (errors.size() > 1) {
            list<string> details = ();
            foreach hash<DpqlDiagnostic> diag in (errors) {
                details += sprintf("  - %s (line %d, column %d)",
                    QdpCmd::sanitizeDpqlErrorMessage(diag.message, dpql), diag.line, diag.column);
            }
            msg += "\n" + details.join("\n");
        } else if (errors[0].line) {
            msg += sprintf(" (line %d, column %d)", errors[0].line, errors[0].column);
        }
        return msg;
    }

    static bool hasDpqlFieldReferences(hash<DataProviderExpression> exp) {
        if (!exp) {
            return False;
        }
        if (exp.hasKey("field")) {
            return True;
        }
        if (!exp.args) {
            return False;
        }
        foreach auto arg in (exp.args) {
            if (arg.typeCode() == NT_HASH) {
                if (arg.hasKey("field")) {
                    return True;
                }
                if (arg.hasKey("exp") && QdpCmd::hasDpqlFieldReferences(arg)) {
                    return True;
                }
            }
        }
        return False;
    }

    static string sanitizeDpqlErrorMessage(string message, string dpql) {
        if (message =~ /^Internal parser error:/) {
            string hint;
            if (QdpCmd::isEmptyDpqlExpression(dpql)) {
                hint = " (use '-' or '{}' for an empty expression)";
            }
            return "invalid DPQL expression" + hint;
        }
        return message;
    }

    static hash<DataProviderExpression> getExpression(string exp, auto args) {
        return <DataProviderExpression>{
            "exp": exp,
            "args": QdpCmd::getExpressionArgs(args),
        };
    }

    static *softlist<auto> getExpressionArgs(auto args) {
        if (!exists args) {
            return;
        }
        list<auto> rv = ();
        foreach auto arg in (args) {
            if (arg.size() == 2 && arg.exp.typeCode() == NT_STRING && arg.hasKey("args")) {
                rv += QdpCmd::getExpression(arg.exp, arg.args);
            } else if (arg.field.typeCode() == NT_STRING) {
                rv += cast<hash<DataProviderFieldReference>>(arg);
            } else {
                push rv, arg;
            }
        }
        return rv;
    }

    static *hash<auto> getHash(string action, *bool required) {
        auto arg = shift ARGV;
        return getHashIntern(arg, action, required);
    }

    static *hash<auto> tryGetHashValue(string text) {
        if (!exists text) {
            return;
        }
        try {
            # Always use parse_to_qore_value for legacy key=value parsing,
            # regardless of the -Y/--yaml or --json output format flags.
            auto val = parse_to_qore_value(text);
            if (exists val && val.typeCode() == NT_HASH) {
                return val;
            }
        } catch (hash<ExceptionInfo> ex) {
            # no-op: only used for fallback detection
        }
        return;
    }

    static *hash<auto> getHashIntern(auto arg, string action, *bool required) {
        if (exists arg) {
            arg = parseInputValue(arg);
            if (exists arg && arg.typeCode() != NT_HASH) {
                QdpCmd::error("Invalid %s argument %y; expecting type \"hash\"; got type %y instead", action, arg,
                    arg.type());
            }
        }
        if (required && !exists arg) {
            QdpCmd::error("Missing required %s argument; expecting type \"hash\"", action);
        }
        return arg;
    }

    static *string getString(string action, *bool required) {
        auto arg = shift ARGV;
        if (exists arg) {
            return arg;
        }
        if (required && !arg) {
            QdpCmd::error("Missing required %s argument; expecting type \"string\"", action);
        }
    }

    static auto getAny(string action) {
        auto arg = shift ARGV;
        if (exists arg) {
            arg = parseInputValue(arg);
        }
        return arg;
    }

    private showActions(string app) {
        if (!ENV.QORE_PROVIDER_INDEX_DIR) {
            DataProvider::registerKnownFactories();
        }
        *hash<string, hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActionHash(app);
        if (!actions) {
            error("Application %y is unknown; known applications: %y", app, (map $1.name,
                DataProviderActionCatalog::getAllApps()));
        }
        printf("Application %y:\n", app);
        printf("- actions: %y\n", keys actions);
        if (opts.verbose) {
            hash<DataProviderAppInfo> info = DataProviderActionCatalog::getAppEx(app);
            if (info.scheme) {
                hash<ConnectionSchemeInfo> sinfo = ConnectionSchemeCache::getSchemeEx(info.scheme);
                printf("- schemes: %y\n", keys sinfo.schemes);
                *hash<auto> opts = map {$1.key: $1.value.default_value}, sinfo.options.pairIterator(),
                    exists $1.value.default_value;
                if (opts) {
                    printf("- connection options:\n");
                    map printf("  - %s: %y\n", $1.key, $1.value), opts.pairIterator();
                }
            }
        }
        exit(0);
    }

    private AbstractDataProvider getDataProviderForAppAction(string app_name, string action_name, *string opts) {
        if (!ENV.QORE_PROVIDER_INDEX_DIR) {
            DataProvider::registerKnownFactories();
        }
        *hash<string, hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActionHash(app_name);
        if (!actions) {
            error("Application %y is unknown", app_name);
        }
        *hash<DataProviderActionInfo> action = actions{action_name};
        if (!action) {
            error("Application %y does not provide action %y; available actions: %y", app_name, action_name,
                keys actions);
        }
        *hash<auto> options;
        if (opts) {
            options = parseInputValue(opts);
            if (exists options && options.typeCode() != NT_HASH) {
                throw "ACTION-ERROR", sprintf("option string for @%s/%s does not parse to type \"hash\"; got "
                    "type %y instead", app_name, action_name, options.type());
            }
        }
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getAppEx(app_name);

        string connection;
        AbstractConnection conn;
        if (app.scheme.val()) {
            connection = OptionHelper::getString(options, "connection", True);
            remove options.connection;
            conn = get_connection(connection);
            hash<ConnectionSchemeInfo> scheme_info = ConnectionSchemeCache::getSchemeEx(app.scheme);
            if (!scheme_info.schemes{string scheme = conn.getType()}) {
                throw "APP-CONFIG-ERROR", sprintf("app %y action %y: connection %y has scheme %y; expecting %y", app.name,
                    action.action, connection, scheme, keys scheme_info.schemes);
            }
            if (!conn.hasDataProvider()) {
                throw "APP-CONFIG-ERROR", sprintf("connection %y has no data provider but should be valid for "
                    "app %y action %y", connection, app.name, action.action);
            }
        }

        # check data provider path options
        foreach hash<auto> i in (action.path_vars.pairIterator()) {
            if (!options{i.key}.val()) {
                throw "ACTION-ARG-ERROR", sprintf("app %y action %y: required option %y is missing in \"options\"",
                    app.name, action.action, i.key);
            }
        }

        AbstractDataProvider prov;
        try {
            # NOTE: action.subtype may be NOTHING
            if (conn) {
                prov = conn.getDataProvider(action.subtype);
            } else if (action.cls) {
                prov = DataProviderActionCatalog::getDataProviderForAction(action, \options);
            }
            # set logger on data provider
            prov.setLogger(logger);

            DataProviderDataContextHelper dch(options);
            foreach string seg in (action.path[1..].split("/")) {
                if (!seg.val()) {
                    continue;
                }
                if (*string var = (seg =~ x/^\{([^\}]+)\}$/)[0]) {
                    seg = remove options{var};
                }
                prov = prov.getChildProviderEx(seg);
            }
        } catch (hash<ExceptionInfo> ex) {
            rethrow "ACTION-ERROR", sprintf("error acquiring data provider for app %y action: %y: %s: %s", app.name,
                action.action, ex.err, ex.desc);
        }
        return prov;
    }

    private AbstractDataProvider getDataProvider(string name) {
        if (name =~ /{([^}]*)}/) {
            try {
                AbstractDataProvider dp = DataProvider::getFactoryObjectFromStringUseEnv(name);
                # set logger on data provider
                dp.setLogger(logger);
                return dp;
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "FACTORY-ERROR") {
                    error("%s", ex.desc);
                }
                rethrow;
            }
        }

        # load providers from environment and try to load a connection
        try {
            *AbstractDataProvider dp = DataProvider::tryLoadProviderForConnectionFromEnv(name, opts.subtype,
                logger);
            if (dp) {
                # set logger on data provider
                dp.setLogger(logger);
                return dp;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "DATA-PROVIDER-ERROR") {
                error("connection %y exists but does not support the data provider API", name);
            }
            rethrow;
        }

        error("no connection or datasource connection %y exists in any known data provider", name);
    }

    #! Resolve a data provider from a CLI spec string (factory or connection)
    static AbstractDataProvider resolveProvider(string spec) {
        # Extract factory options in balanced braces (same regex as constructor line 292)
        *string dp_opts = (spec =~ x/({(?:(?>[^{}]*)|(?0))*})/)[0];
        string name = spec;
        if (dp_opts) {
            name = replace(name, dp_opts, "");
        } else {
            name =~ s/{}//;
        }

        list<string> path = name.split("/");
        string root = shift path;

        AbstractDataProvider provider;
        string full_root = root + (dp_opts ?? "");

        if (full_root =~ /\{/) {
            # Factory resolution
            provider = DataProvider::getFactoryObjectFromStringUseEnv(full_root);
        } else {
            # Connection resolution
            Logger plogger = getStaticLogger("resolve");
            *AbstractDataProvider dp = DataProvider::tryLoadProviderForConnectionFromEnv(
                root, opts.subtype, plogger);
            if (!dp) {
                error("cannot resolve provider from %y; no matching connection or factory found", spec);
            }
            provider = dp;
        }

        # Navigate child path segments
        map provider = provider.getChildProviderEx($1), path;
        return provider;
    }

    #! Load a Mapper from the -M/--mapper option value (inline hash or file path)
    /** @return a Mapper object, or NOTHING if -M was not specified
    */
    static *Mapper loadMapper() {
        if (!opts.mapper) {
            return;
        }
        string spec = opts.mapper;
        hash<auto> mapv;

        if (is_readable(spec)) {
            string content = ReadOnlyFile::readTextFile(spec);
            if (spec =~ /\.ya?ml$/i) {
%ifndef NoYaml
                mapv = parse_yaml(content);
%else
                error("YAML mapper file requested but yaml module is not available");
%endif
            } else if (spec =~ /\.json$/i) {
%ifndef NoJson
                mapv = parse_json(content);
%else
                error("JSON mapper file requested but json module is not available");
%endif
            } else {
                mapv = parse_to_qore_value(content);
            }
        } else {
            mapv = parseInputValue(spec);
        }

        if (mapv.typeCode() != NT_HASH) {
            error("mapper spec must be a hash; got type %y", mapv.fullType());
        }
        return new Mapper(mapv);
    }

    static createIndex() {
        *hash<auto> index = QdpCmd::getHash("index");
        try {
            hash<auto> info = ProviderIndex::createDataProviderIndex(
                index ? cast<hash<DataProviderIndexInfo>>(index) : NOTHING
            );
            printf("Created index %y: %d bytes in %y (%y)\n", info.path, info.size, info.delta, info.summary);
            exit(0);
        } catch (hash<ExceptionInfo> ex) {
            error("%s: %s", ex.err, ex.desc);
        }
    }

    static listApps() {
        DataProvider::registerKnownFactories();
        *list<hash<DataProviderAppInfo>> l = DataProviderActionCatalog::getAllApps();

        if (opts.json || opts.yaml) {
            list<hash<auto>> result = ();
            foreach hash<DataProviderAppInfo> app in (l) {
                *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(app.name);
                push result, app + {"actions": actions};
            }
            output(result);
            exit(0);
        }

        foreach hash<DataProviderAppInfo> app in (l) {
            # get actions for app
            *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(app.name);
            printf("%s: scheme %y, %d action%s: %s\n", color.bold(app.name), app.scheme, actions.size(),
                actions.size() == 1 ? "" : "s", app.desc);
            if (opts.verbose) {
                map printf(" + %s (%s %y): %s\n", color.key($1.action), ActionNameMap{$1.action_code}, $1.path,
                    $1.short_desc), actions;
            }
        }
        exit(0);
    }

    static listConnections() {
        # get connections
        *hash<string, string> h = map {$1.key: $1.value.url}, get_connection_hash(True).pairIterator();
        # add datasource connections
        h += get_ds_hash(True);

        if (opts.json || opts.yaml) {
            output(h);
            exit(0);
        }

        if (!h) {
            printf("no connections are present\n");
        } else {
            if (opts.verbose) {
                map printf("%s: %s\n", color.key($1.key), color.value($1.value)), h.pairIterator();
            } else {
                map printf("%s\n", color.key($1)), keys h;
            }
        }
        exit(0);
    }

    static listFactories() {
        # load known data provider factories
        DataProvider::registerKnownFactories();
        # load providers from environment
        DataProvider::loadProvidersFromEnvironment();
        *list<string> flist = DataProvider::listFactories();

        if (opts.json || opts.yaml) {
            if (opts.verbose) {
                hash<auto> result = map {$1: DataProvider::getFactory($1).getInfoAsData()}, flist;
                output(result);
            } else {
                output(flist);
            }
            exit(0);
        }

        if (opts.verbose) {
            foreach string f in (flist) {
                printf("%s: ", color.bold(f));
                output(DataProvider::getFactory(f).getInfoAsData());
            }
        } else {
            output(flist);
        }
        exit(0);
    }

    static listTypes() {
        # load known data provider factories
        DataProvider::registerKnownTypes();
        # load types from environment
        DataProvider::loadTypesFromEnvironment();
        *list<string> tlist = DataProvider::listTypes();

        if (opts.json || opts.yaml) {
            if (opts.verbose) {
                hash<auto> result = map {$1: DataProvider::getType($1).getInfo()}, tlist;
                output(result);
            } else {
                output(tlist);
            }
            exit(0);
        }

        if (opts.verbose) {
            foreach string t in (tlist) {
                printf("%s: ", color.bold(t));
                output(DataProvider::getType(t).getInfo());
            }
        } else {
            output(tlist);
        }
        exit(0);
    }

    private static printHelpLine(string colored, string desc, int width) {
        printf("  %s %s\n", TerminalColor::padRight(colored, width), desc);
    }

