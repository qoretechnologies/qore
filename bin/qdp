            script, color.dim("# Import from CSV"));
        printf("  %s mydb/tables/users pipeline 'csvwrite{path=out.csv}' -d %s\n",
            script, color.dim("# Dry-run pipeline"));

        exit(1);
    }

    static showDpqlHelp() {
        printf("%s\n", color.bold("DPQL (Data Provider Query Language)"));
        printf("  %s\n", color.info("DPQL is a user-friendly server-independent syntax for fast native server-side record-based data provider searches, updates, and delete operations."));
        printf("\n%s\n", color.bold("SYNTAX"));
        printf("  %s %s %s\n", color.key("@field"), color.type("<op>"), color.key("value"));
        printf("  %s\n", color.key("(@field <op> value) && (@field2 <op> value2)"));
        printf("\n%s\n", color.bold("FIELD REFERENCES"));
        printf("  %s\n", color.key("@name"));
        printf("  %s\n", color.key("@user.email"));
        printf("  %s  %s\n", color.key("@\"field with spaces\""), color.dim("(quoted for special chars)"));
        printf("  %s  %s\n", color.key("@\"literal.dot.name\""), color.dim("(literal dots, not nested)"));
        printf("\n%s\n", color.bold("QUOTING FIELD NAMES"));
        printf("  %s\n", color.dim("Quote field names with special characters using double quotes:"));
        printf("  %s  %s\n", color.key("@\"items[0]\""), color.dim("field name contains brackets"));
        printf("  %s  %s\n", color.key("@\"user==admin\""), color.dim("field name contains operators"));
        printf("  %s  %s\n", color.key("@\"123field\""), color.dim("field name starts with digit"));
        printf("\n%s\n", color.bold("ESCAPE SEQUENCES"));
        printf("  %s\n", color.dim("Use backslash to escape special characters in quoted names:"));
        printf("  %s  %s\n", color.key("@\"field\\\"name\""), color.dim("embedded quote"));
        printf("  %s  %s\n", color.key("@\"path\\\\file\""), color.dim("embedded backslash"));
        printf("  %s  %s\n", color.key("\\n \\r \\t"), color.dim("newline, carriage return, tab"));
        printf("\n%s\n", color.bold("FIELD ACCESSORS"));
        printf("  %s  %s\n", color.key("@items[0]"), color.dim("index accessor (0 = first, -1 = last)"));
        printf("  %s  %s\n", color.key("@items[0..2]"), color.dim("slice accessor (inclusive range)"));
        printf("  %s  %s\n", color.key("@record{key}"), color.dim("key accessor (single key)"));
        printf("  %s  %s\n", color.key("@record{a, b}"), color.dim("key accessor (multiple keys)"));
        printf("  %s  %s\n", color.key("@record.field"), color.dim("dot accessor (member access)"));
        printf("  %s  %s\n", color.key("@data[0]{user}.name"), color.dim("chained accessors"));
        printf("\n%s\n", color.bold("OPERATORS"));
        printf("  %s\n", color.type("== != < <= > >= =~ between in"));
        printf("  %s\n", color.dim("Note: available operators depend on the data provider and server capabilities."));
        printf("  %s\n", color.dim("Use \"qdp <provider> info\" to see supported search expressions."));
        printf("\n%s\n", color.bold("LOGICAL"));
        printf("  %s\n", color.type("&& || !"));
        printf("\n%s\n", color.bold("LITERALS"));
        printf("  %s\n", color.key("strings, numbers, true/false, null"));
        printf("  %s\n", color.key("dates: 2026-01-02 or 2026-01-02T15:20:11.123+01:00"));
        printf("  %s\n", color.key("binary: <deadbeef>"));
        printf("  %s\n", color.key("lists: (one, two, 3)"));
        printf("  %s\n", color.key("hashes: {a=1, b=two}"));
        printf("  %s\n", color.key("unquoted identifiers are strings (ex: @domain == omq)"));
        printf("\n%s\n", color.bold("EMPTY EXPRESSION"));
        printf("  %s\n", color.key("Use '-' or '{}' to search without filters"));
        printf("\n%s\n", color.bold("EXAMPLES"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@name == \"John\"'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@age between 18 and 65'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@role in (\"admin\", \"editor\")'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '(@active == true) && (@age >= 21)'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@email =~ /example.com$/i'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@created < 2026-12-01'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@blob == <deadbeef>'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@tags == (one, two, three)'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@meta == {a=1, b=two}'"));
        printf("\n%s\n", color.bold("ACCESSOR EXAMPLES"));
        printf("  %s\n", color.key("qdp mydb/tables/orders search '@items[0]{product_id} == 123'"));
        printf("  %s\n", color.key("qdp mydb/tables/users search '@address{city} == \"NYC\"'"));
        printf("  %s\n", color.key("qdp mydb/tables/events search '@tags[-1] == \"important\"'"));
        exit(0);
    }

