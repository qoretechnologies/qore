            "Limit number of records to transfer");
        printf("  %s  %s\n", color.key("-O, --offset=N"),
            "Skip first N records");
        printf("  %s  %s\n", color.key("-b, --bulk"),
            "Use bulk API for reading and writing");
        printf("  %s  %s\n", color.key("-T, --timeout=N"),
            "Timeout in seconds for the search");
        printf("  %s  %s\n", color.key("-v, --verbose"),
            "Show pipeline logging (repeat for debug)");
        printf("  %s  %s\n", color.key("-J, --json"),
            "Output final summary as JSON (suppresses progress)");
        printf("  %s  %s\n", color.key("-Y, --yaml"),
            "Output final summary as YAML (suppresses progress)");
        printf("  %s  %s\n", color.key("-M, --mapper=X"),
            "Field mapper (inline hash or file path)");
        printf("  %s  %s\n", color.key("-q, --dpql"),
            "Force DPQL parsing for search criteria");
        printf("  %s  %s\n", color.key("-x, --expressions"),
            "Use legacy search expressions");

        printf("\n%s\n", color.bold("MAPPER"));
        printf("  %s\n", color.info("Transform records between input and output using a field mapper."));
        printf("  %s\n", color.info("The mapper uses the Mapper module (inherits AbstractDataProcessor)."));

        printf("\n  %s\n", color.bold("Inline mapper (Qore hash syntax):"));
        printf("  %s\n", color.dim("  -M '{output_field = True}'                    # pass-through (same name)"));
        printf("  %s\n", color.dim("  -M '{out_name = \"in_name\"}'                   # rename field"));
        printf("  %s\n", color.dim("  -M '{age = {name = \"in_age\", type = \"int\"}}' # rename + type coercion"));
        printf("  %s\n", color.dim("  -M '{status = {constant = \"active\"}}'         # constant value"));
        printf("  %s\n", color.dim("  -M '{name = {name = \"in_name\", default = \"N/A\"}}'  # default value"));
        printf("  %s\n", color.dim("With -J, use JSON syntax: -M '{\"out\": \"in\"}'"));

        printf("\n  %s\n", color.bold("File mapper:"));
        printf("  %s\n", color.dim("  -M mapper.yaml    # YAML file (.yaml/.yml)"));
        printf("  %s\n", color.dim("  -M mapper.json    # JSON file (.json)"));
        printf("  %s\n", color.dim("  -M mapper.q       # Qore hash literal (any other extension)"));

        printf("\n  %s\n", color.bold("Mapping value types:"));
        printf("  %s  %s\n", color.key("True"),
            "Pass-through: output field = input field with same name");
        printf("  %s  %s\n", color.key("\"field_name\""),
            "Rename: output field = input field with given name");
        printf("  %s  %s\n", color.key("{name = ..., type = ...}"),
            "Rename with type coercion (int, number, string, date, hash, any)");
        printf("  %s  %s\n", color.key("{constant = value}"),
            "Set a constant value for every record");
        printf("  %s  %s\n", color.key("{name = ..., default = ...}"),
            "Map field with a fallback default value");

        printf("\n  %s\n", color.bold("YAML file example (mapper.yaml):"));
        printf("  %s\n", color.dim("  full_name: \"name\""));
        printf("  %s\n", color.dim("  user_age:"));
        printf("  %s\n", color.dim("    name: \"age\""));
        printf("  %s\n", color.dim("    type: \"int\""));
        printf("  %s\n", color.dim("  status:"));
        printf("  %s\n", color.dim("    constant: \"active\""));

        printf("\n%s\n", color.bold("EXAMPLES"));
        printf("  %s  %s\n",
            color.key(sprintf("%s mydb/tables/users pipeline 'csvwrite{path=users.csv}'", script)),
            color.dim("# Export table to CSV"));
        printf("  %s  %s\n",
            color.key(sprintf("%s 'csvread{path=data.csv}' pipeline mydb/tables/users", script)),
            color.dim("# Import CSV to table"));
        printf("  %s  %s\n",
            color.key(sprintf("%s mydb/tables/users pl 'csvwrite{path=out.csv}' '@active == true'", script)),
            color.dim("# Export filtered records"));
        printf("  %s  %s\n",
            color.key(sprintf("%s mydb/tables/users pipeline mydb2/tables/archive -l 1000", script)),
            color.dim("# Copy 1000 records between DBs"));
        printf("  %s  %s\n",
            color.key(sprintf("%s mydb/tables/users pipeline 'csvwrite{path=out.csv}' -b", script)),
            color.dim("# Bulk mode for large exports"));
        printf("  %s  %s\n",
            color.key(sprintf("%s mydb/tables/users pipeline 'csvwrite{path=out.csv}' -d", script)),
            color.dim("# Dry-run: show plan only"));
        printf("  %s  %s\n",
            color.key(sprintf("%s -J mydb/tables/users pipeline 'csvwrite{path=out.csv}'", script)),
            color.dim("# JSON summary output"));
        printf("  %s  %s\n",
            color.key(sprintf("%s 'csvread{path=in.csv}' pl 'csvwrite{path=out.csv}'"
                " -M '{full_name = \"name\", age = {name = \"user_age\", type = \"int\"}}'", script)),
            color.dim("# Inline mapper"));
        printf("  %s  %s\n",
            color.key(sprintf("%s 'csvread{path=in.csv}' pl 'csvwrite{path=out.csv}' -M mapper.yaml", script)),
            color.dim("# File mapper"));
        printf("  %s  %s\n",
            color.key(sprintf("%s 'csvread{path=in.csv}' pl 'csvwrite{path=out.csv}'"
                " -M '{name = True, status = {constant = \"active\"}}'", script)),
            color.dim("# Pass-through + constant"));

        printf("\n%s\n", color.bold("PROGRESS"));
        printf("  %s\n", color.dim("Progress is shown on stderr every 2 seconds (suppressed with -J/-Y)."));
        printf("  %s\n", color.dim("Press Ctrl+C for graceful shutdown — records already submitted will complete."));

        printf("\n%s\n", color.bold("OUTPUT"));
        printf("  %s\n", color.dim("Default: human-readable summary with record count and throughput."));
        printf("  %s\n", color.dim("With -J/-Y: structured pipeline info (name, status, record_count, duration, recs_per_sec)."));
        exit(0);
    }

    static error(string fmt) {
        stderr.printf("%s: %s %s\n", get_script_name(), color.error("ERROR:"), vsprintf(fmt, argv));
        exit(1);
    }

    static showVersion() {
        printf("%s version %s\n", get_script_name(), Version);
        printf("Qore %s\n", Qore::VersionString);
%ifndef NoJson
        printf("JSON I/O: supported\n");
%else
        printf("JSON I/O: not available (json module not installed)\n");
%endif
%ifndef NoYaml
        printf("YAML I/O: supported\n");
%else
        printf("YAML I/O: not available (yaml module not installed)\n");
%endif
        printf("Line editing: supported (linenoise)\n");
        exit(0);
    }

    static signalHandler(int sig) {
        shutdown_requested = True;
        # Print message about graceful shutdown
        stderr.printf("\n%s: received signal %d, shutting down gracefully...\n", get_script_name(), sig);
    }

    #! Output data in the requested format (JSON, YAML, or Qore)
    static output(auto data) {
        if (opts.json) {
%ifndef NoJson
            printf("%s\n", make_json(data, JGF_ADD_FORMATTING));
%else
            error("JSON output requested but json module is not available");
%endif
        } else if (opts.yaml) {
%ifndef NoYaml
            printf("%s", make_yaml(data, YAML::BlockStyle));
%else
            error("YAML output requested but yaml module is not available");
%endif
        } else {
            printf("%Y\n", data);
        }
    }

    #! Parse input value according to the current format (JSON, YAML, or Qore)
    static auto parseInputValue(string text) {
        if (opts.json) {
%ifndef NoJson
            return parse_json(text);
%else
            error("JSON input requested but json module is not available");
%endif
        }
        if (opts.yaml) {
%ifndef NoYaml
            return parse_yaml(text);
%else
            error("YAML input requested but yaml module is not available");
%endif
        }
        return parse_to_qore_value(text);
    }

    #! Output a single record/hash with optional color formatting
    static outputRecord(auto data) {
        if (opts.json || opts.yaml) {
            output(data);
        } else {
            printf("%s\n", color.formatValue(data));
        }
    }
}

#! Wraps an output data provider's createRecord()/createRecordsBulk() as an AbstractDataProcessor
#! The output provider is created lazily on first submit to ensure it runs in the pipeline's worker thread
#! (some providers like CsvWriteDataProvider create thread-locked streams on construction)
class DataProviderOutputProcessor inherits DataProvider::AbstractDataProcessor {
    private {
        #! Spec string for lazy resolution in worker thread
        string output_spec;
        #! Provider resolved lazily on first submit
        *AbstractDataProvider output_provider;
        #! Whether the output provider supports bulk create
        bool supports_bulk;
    }

    constructor(string output_spec, bool supports_bulk) {
        self.output_spec = output_spec;
        self.supports_bulk = supports_bulk;
    }

    private submitImpl(code enqueue, auto _data) {
        # Lazy-resolve on first call (runs in pipeline worker thread)
        if (!output_provider) {
            output_provider = QdpCmd::resolveProvider(output_spec);
        }
        if (_data.typeCode() == NT_HASH) {
            if (_data.firstValue().typeCode() == NT_LIST) {
                output_provider.createRecordsBulk(_data);
            } else {
                output_provider.createRecord(_data);
            }
        }
        enqueue(_data);
    }

    private bool supportsBulkApiImpl() {
        return supports_bulk;
    }
}

#! Reports pipeline progress to stderr
class ProgressMetricsCollector inherits DataProvider::AbstractPipelineMetricsCollector {
    private {
        date start;
    }

    constructor() {
        start = now_us();
    }

    int getIntervalMs() {
        return 2000;
    }

    int getRecordInterval() {
        return 0;
    }

    reportMetrics(hash<PipelineMetricsSnapshot> snapshot) {
        float elapsed = (now_us() - start).durationSecondsFloat();
        stderr.printf("\r%s %d records (%.1f rec/s, %.0fs elapsed)   ",
            QdpCmd::color.info("progress:"), snapshot.total_records_submitted,
            snapshot.throughput_rps, elapsed);
    }

    shutdown() {
        stderr.printf("\n");
    }
}

class Term {
    public {}
    private {
        TermIOS orig;
    }

    constructor() {
        TermIOS t();

        # get current terminal attributes for stdin
        stdin.getTerminalAttributes(t);

        # save a copy
        orig = t.copy();

        # get local flags
        int lflag = t.getLFlag();

        # disable canonical input mode (= turn on "raw" mode)
        lflag &= ~ICANON;

        # turn off echo mode
        lflag &= ~ECHO;

        # do not check for special input characters (INTR, QUIT, and SUSP)
        lflag &= ~ISIG;

        # set the new local flags
        t.setLFlag(lflag);

        # set minimum characters to return on a read
        t.setCC(VMIN, 1);

        # set character input timer in 0.1 second increments (= no timer)
        t.setCC(VTIME, 0);

        # make these terminal attributes active
        stdin.setTerminalAttributes(TCSADRAIN, t);
    }

    destructor() {
        restore();
    }

    restore() {
        # restore terminal attributes
        stdin.setTerminalAttributes(TCSADRAIN, orig);
    }
}

class MyObserver inherits Observer {
    public {}

    private {
        hash<DataProviderInfo> info;
        TermIOS t();
    }

    constructor(hash<DataProviderInfo> info) {
        self.info = info;
        # get current terminal attributes for stdin
        stdin.getTerminalAttributes(t);
    }

    update(string event_id, hash<auto> data_) {
        string msg = sprintf("received event %s:", QdpCmd::color.cyan(event_id));
        if (!data_) {
            msg += " " + QdpCmd::color.dim("no data");
        }
        if (data_) {
            msg += sprintf("\n%s", QdpCmd::color.formatValue(data_));
        }
        log("<", msg);
        if (info.connection_event == event_id) {
            string protocol = data_.http2 ? "HTTP/2" : "HTTP/1.1";
            log("<", "%s (WebSocket over %s)", QdpCmd::color.success("connected to server"),
                QdpCmd::color.info(protocol));
        } else if (info.disconnection_event == event_id) {
            if (info.supports_auto_reconnect) {
                log("<", "%s%s", QdpCmd::color.warning("disconnected from server"),
                    QdpCmd::ix ? "; trying to reconnect..." : "");
            } else {
                log("<", "%s; auto_reconnect not enabled; exiting",
                    QdpCmd::color.error("disconnected from server"));
                # restore original terminal attributes
                stdin.setTerminalAttributes(TCSADRAIN, t);
                exit(0);
            }
        }
        stdout.sync();
    }

    log(string inout, string fmt, ...) {
        if (QdpCmd::ix) {
            stdout.print("\r");
        }
        string direction_color = inout == "<" ? QdpCmd::color.green(inout) : QdpCmd::color.yellow(inout);
        string timestamp = QdpCmd::color.dim(now_us().format("YYYY-MM-DD HH:mm:SS.xx"));
        fmt = sprintf("%s %s ", direction_color, timestamp) + fmt;
        string msg = vsprintf(fmt, argv);
        msg =~ s/\n/\015\012/g;
        stdout.print(msg + "\n");
        if (QdpCmd::ix) {
            stdout.print("\r");
        }
    }
}

class ConsoleAppender inherits LoggerAppenderWithLayout {
    constructor() : LoggerAppenderWithLayout("console", new LoggerLayoutPattern("%d{YYYY-MM-DD HH:mm:SS.xx} T%t [%p]: %m%n")) {
        open();
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
                params =~ s/\n/\r\n/g;
                print(params);
                break;
        }
    }
}

class InputHelper {
    public {
        AbstractDataProvider provider;
        # message map
        hash<string, hash<DataProviderMessageInfo>> mmap;
        # event map
        *hash<string, hash<DataProviderMessageInfo>> emap;

        #! Active message ID for default send
        *string active_msgid;

        #! Current input/output format for interactive mode ("qore", "json", "yaml")
        string input_format = "qore";

        #! Cached schema hint strings per message ID
        hash<string, string> schema_hints;

        #! Shared history manager
        QoreHistory::History qhistory({"max_length": 100, "dedup_mode": QoreHistory::DEDUP_FULL});

        #! Path to history file (NOTHING if HOME is not set)
        *string history_path;
        const HistoryFile = ".qdp-history";

        const Commands = {
            "/event": True,
            "/events": True,
            "/exit": True,
            "/format": True,
            "/help": True,
            "/history": True,
            "/info": True,
            "/msgs": True,
            "/msg": True,
            "/quit": True,
            "/send": True,
            "/use": True,
        };
    }

    string getPrompt() {
        return active_msgid ? active_msgid + "> " : "> ";
    }

    #! Set active_msgid to the first available message ID; returns the ID or NOTHING
    *string setFirstMsgId() {
        if (mmap) {
            active_msgid = mmap.firstKey();
        }
        return active_msgid;
    }

    constructor(AbstractDataProvider provider) {
        self.provider = provider;
        mmap = provider.getMessageTypes();
        emap = provider.getEventTypes();

        # Initialize format from command-line flags
        if (opts.json) {
            input_format = "json";
        } else if (opts.yaml) {
            input_format = "yaml";
        }

        # Auto-select if only one message type
        if (mmap.size() == 1) {
            active_msgid = mmap.firstKey();
        }

        if (exists ENV.HOME) {
            history_path = ENV.HOME + DirSep + HistoryFile;
        } else {
            stderr.printf("WARNING: HOME not set, history will not be saved\n");
        }

        # Load history via QoreHistory (owns persistence and file format)
        if (history_path) {
            try {
                qhistory.load(history_path);
            } catch (hash<ExceptionInfo> ex) {
                stderr.printf("%y: WARNING: cannot load history: %s: %s\n", history_path,
                    ex.err, ex.desc);
            }
        }

        Linenoise::set_callback(\completion());
        Linenoise::set_hints_callback(\hintsForInput());
        Linenoise::set_syntax_callback(\syntaxHighlight());
        Linenoise::set_right_prompt(getRightPrompt());
        Linenoise::set_completion_case_insensitive(True);
        # Delegate history navigation to QoreHistory (single source of truth)
        Linenoise::set_history_provider(new QoreHistory::QoreHistoryProvider(qhistory));
    }

    destructor() {
        if (history_path) {
            try {
                qhistory.save(history_path);
            } catch (hash<ExceptionInfo> ex) {
                stderr.printf("%y: WARNING: cannot save history: %s: %s\n", history_path,
                    ex.err, ex.desc);
            }
        }
    }

    string get() {
        string line;
        while (True) {
            *string line0 = Linenoise::line(getPrompt());
            if (!exists line0) {
                line = "exit";
                break;
            }
            line = line0;

            if (!line.val()) {
                continue;
            }

            # History expansion (!! !n !-n !prefix !$)
            if (line[0] == "!" && line.length() >= 2) {
                *string expanded = qhistory.expand(line);
                if (exists expanded) {
                    printf("! %s\n", expanded);
                    line = expanded;
                }
            }

            # Add to QoreHistory (owns persistence, timestamps, dedup)
            qhistory.add(line);
            # Save eagerly after each command
            if (history_path) {
                try {
                    qhistory.save(history_path);
                } catch (hash<ExceptionInfo> ex) {
                    stderr.printf("%y: WARNING: cannot save history: %s: %s\n", history_path,
                        ex.err, ex.desc);
                }
            }

            # Slash commands
            if (line == "/help" || line == "/?") {
                interactiveHelp();
                continue;
            }
            if (line == "/info") {
                interactiveInfo(provider);
                continue;
            }
            if (line == "/msgs") {
                showAllMessages();
                continue;
            }
            if (line == "/events") {
                showAllEvents();
                continue;
            }
            if (line =~ /^\/msg\s+/) {
                showMessageInfo(provider, trim(line.substr(5)));
                continue;
            }
            if (line =~ /^\/event\s+/) {
                showEventInfo(provider, trim(line.substr(7)));
                continue;
            }
            if (line == "/history" || line =~ /^\/history\s/) {
                handleHistory(line.length() > 8 ? trim(line.substr(8)) : "");
                continue;
            }
            if (line == "/use" || line =~ /^\/use\s/) {
                handleUse(line.size() > 4 ? trim(line.substr(4)) : "");
                continue;
            }
            if (line == "/format" || line =~ /^\/format\s/) {
                handleFormat(line.length() > 7 ? trim(line.substr(7)) : "");
                continue;
            }
            # /send is returned to interactive() for processing
            if (line =~ /^\/send(\s|$)/) {
                break;
            }
            if (line == "/exit" || line == "/quit") {
                line = "exit";
                break;
            }
            # Bare exit/quit for convenience
            if (line == "exit" || line == "quit") {
                break;
            }
            # Unrecognized slash command
            if (line[0] == "/") {
                printf("unknown command %y; type /help for help\n", line);
                continue;
            }

            # Default: return as data to send
            break;
        }

        return line;
    }

    private handleUse(string args) {
        string id = trim(args);
        if (!id.val()) {
            # Show current
            if (active_msgid) {
                printf("active message type: %s\n", QdpCmd::color.type(active_msgid));
            } else {
                printf("no active message type; use /use <id> to set one\n");
            }
            return;
        }
        if (!mmap.hasKey(id)) {
            printf("unknown message type %y; available: %s\n", id,
                (foldl $1 + ", " + $2, (map QdpCmd::color.type($1), keys mmap)));
            return;
        }
        active_msgid = id;
        printf("active message type set to: %s\n", QdpCmd::color.type(id));
    }

    #! Returns the right prompt string, including format indicator if not default
    private string getRightPrompt() {
        if (input_format == "json") {
            return "[JSON] " + provider.getName();
        }
        if (input_format == "yaml") {
            return "[YAML] " + provider.getName();
        }
        return provider.getName();
    }

    private handleFormat(string args) {
        string mode = trim(args);
        if (!mode.val()) {
            printf("current format: %s\n", QdpCmd::color.type(input_format));
            return;
        }
        switch (mode) {
            case "qore":
                input_format = "qore";
                delete opts.json;
                delete opts.yaml;
                break;
            case "json":
%ifndef NoJson
                input_format = "json";
                opts.json = True;
                delete opts.yaml;
%else
                printf("%s: JSON format not available (json module not installed)\n",
                    QdpCmd::color.error("ERROR"));
                return;
%endif
                break;
            case "yaml":
%ifndef NoYaml
                input_format = "yaml";
                delete opts.json;
                opts.yaml = True;
%else
                printf("%s: YAML format not available (yaml module not installed)\n",
                    QdpCmd::color.error("ERROR"));
                return;
%endif
                break;
            default:
                printf("%s: unknown format %y; use: json, yaml, qore\n",
                    QdpCmd::color.error("ERROR"), mode);
                return;
        }
        Linenoise::set_right_prompt(getRightPrompt());
        printf("format set to: %s\n", QdpCmd::color.type(input_format));
    }

    private handleHistory(string args) {
        if (!args.val()) {
            # Show all history
            int i = 1;
            foreach hash<QoreHistory::HistoryEntry> item in (qhistory.getItems()) {
                printf("  %3d  %s  %s\n", i++,
                    format_date("YYYY-MM-DD HH:mm:SS", item.timestamp), item.text);
            }
            return;
        }

        if (args =~ /^search\s+/) {
            string pattern = trim(args.substr(7));
            if (!pattern.val()) {
                printf("usage: /history search <pattern>\n");
                return;
            }
            list<hash<QoreHistory::HistoryEntry>> matches =
                qhistory.search(pattern, QoreHistory::MATCH_SUBSTRING);
            if (!matches) {
                printf("no history entries matching %y\n", pattern);
                return;
            }
            foreach hash<QoreHistory::HistoryEntry> item in (matches) {
                printf("  %s  %s\n", format_date("YYYY-MM-DD HH:mm:SS", item.timestamp),
                    item.text);
            }
            printf("  %d match%s\n", matches.size(), matches.size() == 1 ? "" : "es");
            return;
        }

        if (args == "clear") {
            int count = qhistory.size();
            qhistory.clear();
            printf("history cleared (%d entr%s removed)\n", count, count == 1 ? "y" : "ies");
            return;
        }

        if (args =~ /^delete\s+/) {
            string nstr = trim(args.substr(7));
            if (nstr !~ /^\d+$/) {
                printf("usage: /history delete <n> (1-based entry number)\n");
                return;
            }
            int n = nstr.toInt();
            if (n < 1) {
                printf("entry number must be >= 1\n");
                return;
            }
            if (qhistory.removeAt(n - 1)) {
                printf("history entry %d deleted\n", n);
            } else {
                printf("invalid entry number %d (history has %d entries)\n", n, qhistory.size());
            }
            return;
        }

        printf("unknown /history subcommand %y; use: search <pat>, clear, delete <n>\n", args);
    }

    private interactiveHelp() {
        printf("%s\n", QdpCmd::color.bold("SENDING MESSAGES"));
        printHelpLine("<data>", "Send data using the active message type");
        printHelpLine("/send <id> <data>", "Send data with a specific message type");
        printHelpLine("/use <id>", "Set the active message type");
        printHelpLine("/use", "Show the current active message type");
        printf("                    Example: action=ping,id=123\n");
        if (mmap) {
            printf("  %s: %s\n", QdpCmd::color.key("Available"),
                (foldl $1 + ", " + $2, (map QdpCmd::color.type($1), keys mmap)));
        }
        printf("%s\n", QdpCmd::color.bold("SESSION COMMANDS"));
        printHelpLine("/help, /?", "Show this help");
        printHelpLine("/info", "Show connection info");
        printHelpLine("/msgs", "List all available messages");
        printHelpLine("/events", "List all available events");
        printHelpLine("/msg <id>", "Show message type details");
        printHelpLine("/event <id>", "Show event type details");
        printHelpLine("/format [mode]", "Set input/output format (json, yaml, qore)");
        printHelpLine("/quit, /exit", "Exit interactive mode");
        printHelpLine("quit, exit", "Exit interactive mode");
        printf("%s\n", QdpCmd::color.bold("HISTORY"));
        printHelpLine("/history", "Show command history");
        printHelpLine("/history search <pat>", "Search history for pattern");
        printHelpLine("/history clear", "Clear command history");
        printHelpLine("/history delete <n>", "Delete history entry by number");
        printHelpLine("!!", "Repeat last command");
        printHelpLine("!<n>", "Repeat command by number");
        printHelpLine("!-<n>", "Repeat command relative to end");
        printHelpLine("!<prefix>", "Repeat last command starting with prefix");
        printHelpLine("!$", "Last word of last command");
        printf("%s\n", QdpCmd::color.bold("KEYBOARD SHORTCUTS"));
        printHelpLine("Enter", "Send message / execute command");
        printHelpLine("Ctrl+C", "Exit interactive mode");
        printHelpLine("Up/Down", "Previous command in history");
        printHelpLine("Ctrl+R/Ctrl+S", "Search history backward/forward");
        printHelpLine("Tab", "Autocomplete");
    }

    private printHelpLine(string key, string desc) {
        int padding = 20 - key.length();
        if (padding < 2) {
            padding = 2;
        }
        printf("  %s%s%s\n", QdpCmd::color.key(key), strmul(" ", padding), desc);
    }

    private interactiveInfo(AbstractDataProvider provider) {
        printf("%s\n", QdpCmd::color.bold("Connection Info"));
        printf("  %s: %s\n", QdpCmd::color.key("Provider"), provider.getName());
        printf("  %s: %s\n", QdpCmd::color.key("Description"), provider.getShortDesc());

        # Connection details
        *hash<DataProviderConnectionInfo> cinfo = provider.getConnectionInfo();
        if (cinfo) {
            if (cinfo.url) {
                printf("  %s: %s\n", QdpCmd::color.key("URL"), cinfo.url);
                printf("  %s: %s\n", QdpCmd::color.key("Connected"),
                    cinfo.connected ? QdpCmd::color.success("Yes") : QdpCmd::color.error("No"));
                printf("  %s: %s\n", QdpCmd::color.key("Auto Reconnect"),
                    cinfo.auto_reconnect ? "Yes" : "No");
            }
            if (cinfo.info) {
                formatConnectionInfo(cinfo.info);
            }
        }

        # Messages summary
        *hash<string, hash<DataProviderMessageInfo>> messages = provider.getMessageTypes();
        if (messages) {
            printf("  %s: %s (type '%s <id>' for details)\n", QdpCmd::color.key("Outgoing Messages"),
                (foldl $1 + ", " + $2, keys messages), QdpCmd::color.key("/msg"));
        }

        # Events summary
        *hash<string, hash<DataProviderMessageInfo>> events = provider.getEventTypes();
        if (events) {
            printf("  %s: %s (type '%s <id>' for details)\n", QdpCmd::color.key("Incoming Events"),
                (foldl $1 + ", " + $2, keys events), QdpCmd::color.key("/event"));
        }
    }

    private formatConnectionInfo(hash<auto> info) {
        # Format HTTP/2 info if available
        if (info.hasKey("http2")) {
            string protocol = info.http2 ? "HTTP/2 (RFC 8441)" : "HTTP/1.1";
            printf("  %s: %s\n", QdpCmd::color.key("Protocol"), QdpCmd::color.info(protocol));
        }
        # Format peer info (remote endpoint)
        if (info.peer) {
            string peer_str = info.peer.hostname ?? info.peer.address;
            if (info.peer.port) {
                peer_str += ":" + info.peer.port;
            }
            if (info.peer.hostname && info.peer.address && info.peer.address != info.peer.hostname) {
                peer_str += " (" + info.peer.address + ")";
            }
            printf("  %s: %s\n", QdpCmd::color.key("Peer"), peer_str);
        }
        # Format local socket info
        if (info.socket.port) {
            printf("  %s: %d\n", QdpCmd::color.key("Local Port"), info.socket.port);
        }
    }

    private showMessageInfo(AbstractDataProvider provider, string msg_id) {
        if (!msg_id.val()) {
            printf("%s: usage: /msg <message-id>; valid: %s\n", QdpCmd::color.error("ERROR"),
                (foldl $1 + ", " + $2, keys mmap));
            return;
        }
        *hash<DataProviderMessageInfo> info;
        try {
            info = provider.getMessageInfo(msg_id);
        } catch (hash<ExceptionInfo> ex) {
            printf("%s: %s\n", QdpCmd::color.error("ERROR"), ex.desc);
            return;
        }
        if (!info) {
            printf("%s: unknown message '%s'; valid: %s\n", QdpCmd::color.error("ERROR"),
                msg_id, (foldl $1 + ", " + $2, keys mmap));
            return;
        }
        QdpCmd::showType(provider, msg_id, info);
    }

    private showEventInfo(AbstractDataProvider provider, string event_id) {
        if (!event_id.val()) {
            *hash<string, hash<DataProviderMessageInfo>> events = provider.getEventTypes();
            printf("%s: usage: /event <event-id>; valid: %s\n", QdpCmd::color.error("ERROR"),
                events ? (foldl $1 + ", " + $2, keys events) : "(none)");
            return;
        }
        *hash<DataProviderMessageInfo> info;
        try {
            info = provider.getEventInfo(event_id);
        } catch (hash<ExceptionInfo> ex) {
            printf("%s: %s\n", QdpCmd::color.error("ERROR"), ex.desc);
            return;
        }
        if (!info) {
            *hash<string, hash<DataProviderMessageInfo>> events = provider.getEventTypes();
            printf("%s: unknown event '%s'; valid: %s\n", QdpCmd::color.error("ERROR"),
                event_id, events ? (foldl $1 + ", " + $2, keys events) : "(none)");
            return;
        }
        QdpCmd::showType(provider, event_id, info);
    }

    private showAllMessages() {
        if (!mmap) {
            printf("No messages available for this provider\n");
            return;
        }
        printf("%s (type '%s <id>' for type details)\n", QdpCmd::color.bold("SUPPORTED MESSAGES"),
            QdpCmd::color.key("/msg"));
        foreach hash<auto> msg in (mmap.pairIterator()) {
            string desc = msg.value.desc ?? "(no description)";
            printf("  %s %s\n", QdpCmd::color.dim("→"), QdpCmd::color.key(msg.key));
            printf("    %s\n", desc);
        }
    }

    private showAllEvents() {
        if (!emap) {
            printf("No events available for this provider\n");
            return;
        }
        printf("%s (type '%s <id>' for type details)\n", QdpCmd::color.bold("SUPPORTED EVENTS"),
            QdpCmd::color.key("/event"));
        foreach hash<auto> evt in (emap.pairIterator()) {
            string desc = evt.value.desc ?? "(no description)";
            printf("  %s %s\n", QdpCmd::color.dim("→"), QdpCmd::color.key(evt.key));
            printf("    %s\n", desc);
        }
    }

    #! Hints callback — shows inline argument hints while typing
    private *string hintsForInput(string input) {
        try {
            # Slash command argument hints
            if (input[0] == "/") {
                if (input == "/" || "/use".equalPartial(input)) {
                    return " <msg-id>";
                }
                if ("/send".equalPartial(input)) {
                    return " <msg-id> <data>";
                }
                if ("/msg".equalPartial(input)) {
                    return " <msg-id>";
                }
                if ("/event".equalPartial(input)) {
                    return " <event-id>";
                }
                if ("/format".equalPartial(input)) {
                    return " <json|yaml|qore>";
                }
                if ("/history".equalPartial(input)) {
                    return " [search <pat> | clear | delete <n>]";
                }
                return;
            }

            # Empty input hint
            if (!input.val()) {
                return " type data to send or /help";
            }

            # Bare data input — show schema hint for active message type
            if (active_msgid) {
                if (!schema_hints.hasKey(active_msgid)) {
                    *hash<DataProviderMessageInfo> info = mmap{active_msgid};
                    if (info) {
                        AbstractDataProviderType type = info.type;
                        *hash<string, AbstractDataField> fields = type.getFields();
                        if (fields) {
                            list<string> parts = ();
                            foreach hash<auto> f in (fields.pairIterator()) {
                                parts += f.key + ": " + f.value.getType().getName();
                            }
                            schema_hints{active_msgid} = " {" + (foldl $1 + ", " + $2, parts) + "}";
                        } else {
                            schema_hints{active_msgid} = " (" + type.getName() + ")";
                        }
                    }
                }
                *string hint = schema_hints{active_msgid};
                if (hint) {
                    # Truncate if too long for terminal
                    int cols = Linenoise::columns();
                    int avail = cols - input.length() - 1;
                    if (avail > 3 && hint.length() > avail) {
                        hint = hint.substr(0, avail - 3) + "...";
                    }
                    return avail > 3 ? hint : NOTHING;
                }
            }
        } catch () {
            # Never crash from hints
        }
    }

    #! Syntax highlighting callback — colorizes input
    private string syntaxHighlight(string input) {
        try {
            # Slash commands: command name in cyan
            if (input[0] == "/") {
                # Find end of command name
                int sp = index(input, " ");
                if (sp > 0) {
                    return "\033[36m" + input.substr(0, sp) + "\033[0m" + input.substr(sp);
                }
                return "\033[36m" + input + "\033[0m";
            }

            # JSON mode: JSON-specific highlighting
            if (input_format == "json") {
                string result = input;
                # Keys ("key":) → cyan (key + colon together)
                result = regex_subst(result, "(\"[^\"]*\")\\s*:", "\033[36m$1\033[0m:", RE_Global);
                # Value strings (not already colored as keys) → yellow
                # Match quoted strings not preceded by escape codes
                result = regex_subst(result, "(?<!\033\\[0m)(\"[^\"]*\")", "\033[33m$1\033[0m",
                    RE_Global);
                # true/false/null → magenta
                result = regex_subst(result, "\\b(true|false|null)\\b", "\033[35m$&\033[0m",
                    RE_Global);
                # Numbers → bright blue
                result = regex_subst(result, "(?<!\\[)\\b\\d+(\\.\\d+)?\\b", "\033[94m$&\033[0m",
                    RE_Global);
                return result;
            }

            # YAML mode: skip highlighting (too many edge cases for simple regex)
            if (input_format == "yaml") {
                return input;
            }

            # Qore mode: colorize value literals
            string result = input;

            # Double-quoted strings → yellow
            result = regex_subst(result, "\"[^\"]*\"", "\033[33m$&\033[0m", RE_Global);
            # Single-quoted strings → yellow
            result = regex_subst(result, "'[^']*'", "\033[33m$&\033[0m", RE_Global);
            # Special values → magenta
            result = regex_subst(result, "\\b(True|False|NOTHING)\\b", "\033[35m$&\033[0m",
                RE_Global);
            # Numbers → bright blue
            result = regex_subst(result, "\\b\\d+(\\.\\d+)?\\b", "\033[94m$&\033[0m", RE_Global);

            return result;
        } catch () {
            return input;
        }
    }

    softlist<string> completion(string str) {
        list<string> rv = ();

        # For empty input, suggest slash commands
        if (!str.val()) {
            rv += keys Commands;
            return rv;
        }

        # After "/use " or "/send ", complete with message IDs
        if (str =~ /^\/use\s+/) {
            string prefix = trim(str.substr(4));
            foreach string msg in (keys mmap) {
                if (!prefix.val() || msg.equalPartial(prefix)) {
                    rv += "/use " + msg;
                }
            }
            return rv;
        }
        if (str =~ /^\/send\s+/) {
            string prefix = trim(str.substr(5));
            # Only complete the message ID part (before any space in the rest)
            if (prefix !~ /\s/) {
                foreach string msg in (keys mmap) {
                    if (!prefix.val() || msg.equalPartial(prefix)) {
                        rv += "/send " + msg + " ";
                    }
                }
            }
            return rv;
        }

        # After "/msg ", complete with message IDs
        if (str =~ /^\/msg\s+/) {
            string prefix = trim(str.substr(4));
            foreach string msg in (keys mmap) {
                if (!prefix.val() || msg.equalPartial(prefix)) {
                    rv += "/msg " + msg;
                }
            }
            return rv;
        }

        # After "/event ", complete with event IDs
        if (str =~ /^\/event\s+/) {
            string prefix = trim(str.substr(6));
            if (emap) {
                foreach string evt in (keys emap) {
                    if (!prefix.val() || evt.equalPartial(prefix)) {
                        rv += "/event " + evt;
                    }
                }
            }
            return rv;
        }

        # After "/format ", complete with available formats
        if (str =~ /^\/format\s+/) {
            string prefix = trim(str.substr(7));
            list<string> formats = ("qore",);
%ifndef NoJson
            formats += "json";
%endif
%ifndef NoYaml
            formats += "yaml";
%endif
            foreach string fmt in (formats) {
                if (!prefix.val() || fmt.equalPartial(prefix)) {
                    rv += "/format " + fmt;
                }
            }
            return rv;
        }

        # After "/history ", complete with subcommands
        if (str =~ /^\/history\s+/) {
            string prefix = trim(str.substr(8));
            foreach string subcmd in ("search", "clear", "delete") {
                if (!prefix.val() || subcmd.equalPartial(prefix)) {
                    rv += "/history " + subcmd + " ";
                }
            }
            return rv;
        }

        # Complete slash command names
        if (str[0] == "/") {
            foreach string cmd in (keys Commands) {
                if (cmd.equalPartial(str)) {
                    rv += cmd;
                }
            }
            return rv;
        }

        return rv;
    }
}

class WebhookHandler inherits RestHandler {
    private {
        string rest_method;
        string root_path;
        code callback;

        static bool cors_enable = DefaultCorsEnable;
        static *softlist<string> cors_accept_origin;
        static *string cors_allow_methods = foldl $1 + ", " + $2, DefaultCorsAllowMethods;
        static softstring cors_max_age = DefaultCorsMaxAge;
        static *string cors_allow_headers = foldl $1 + ", " + $2, DefaultCorsAllowHeaders;
        static bool cors_allow_credentials = DefaultCorsAllowCredentials;
        static bool cors_accept_all_origins = DefaultCorsAcceptAllOrigins;
        static hash<string, bool> cors_origin_map;

        const DefaultCorsEnable = True;
        const DefaultCorsAllowMethods = ("GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS");
        const DefaultCorsMaxAge = 9999999;
        const DefaultCorsAllowHeaders = (
            "Content-Type", "content-type", "Content-Language", "content-language",
            "Accept", "Accept-Language", "Authorization", "Qorus-Token", "Qorus-Client-Time-Zone",
        );
        const DefaultCorsAllowCredentials = True;
        const DefaultCorsAcceptAllOrigins = True;
    }

    constructor(string method, string path, code callback) : RestHandler() {
        rest_method = method;
        root_path = (path =~ /^\//) ? path[1..] : path;
        self.callback = callback;
    }

    removeRootPath(reference<string> path) {
        if (path.startsWith(root_path)) {
            splice path, 0, root_path.size();
        }
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpHandlerResponseInfo> post(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpHandlerResponseInfo> put(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpHandlerResponseInfo> patch(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpHandlerResponseInfo> del(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data b) {
        #logDebug("Webhook headers: %Y", hdr);

        # handle OPTIONS requests
        if (hdr.method == "OPTIONS" && (*hash<auto> cors_hdrs = getCorsResponseHeaders(cx))) {
            # return a CORS response
            return AbstractHttpRequestHandler::makeResponse(200, NOTHING, cors_hdrs);
        }

        # check for valid method
        if (hdr.method != rest_method) {
            # get rest class name
            string path = cx.url.path ?? "";
            removeRootPath(\path);
            return AbstractHttpRequestHandler::makeResponse(405, sprintf("HTTP method %y is not supported with URI "
                "path %y; supported method: %s", hdr.method, path, rest_method), getCorsResponseHeaders(cx) +
                {"Allow": rest_method});
        }

        cx.sctx.listener = listener;
        hash<HttpResponseInfo> rv = RestHandler::handleRequest(listener, s, cx, hdr, b);
        if (!rv.hdr."Access-Control-Allow-Origin") {
            rv.hdr += getCorsResponseHeaders(cx);
        }
        return rv;
    }

    hash<HttpHandlerResponseInfo> callWebhook(hash<auto> cx, *hash<auto> ah) {
        logInfo("Webhook %y called", root_path);
        logDebug("Webhook %y args: %y", root_path, ah);
        on_error QdpCmd::http.logError("%s", get_exception_string($1));
        try {
            return <HttpHandlerResponseInfo>{
                "code": 200,
                "body": callback(ah),
            };
        } catch (hash<ExceptionInfo> ex) {
            QdpCmd::http.logError("Webhook %y args: %y error: %s", root_path, ah, get_exception_string(ex));
            return <HttpHandlerResponseInfo>{
                "code": 500,
                "body": sprintf("%s: %s", ex.err, ex.desc),
            };
        }
    }

    private hash<HttpHandlerResponseInfo> returnRestException(hash<ExceptionInfo> ex) {
        try {
            if (ex.arg.typeCode() == NT_OBJECT) {
                remove ex.arg;
            }
        } catch (hash<ExceptionInfo> ex0) {
            remove ex.arg;
        }
        if (ex.err =~ /-ARG-ERROR$/) {
            return <HttpHandlerResponseInfo>{
                "code": 400,
                "body": ex.desc,
            };
        }
        if (ex.err == "AUTHORIZATION-ERROR" || ex.err =~ /-ACCESS-ERROR$/) {
            return <HttpHandlerResponseInfo>{
                "code": 403,
                "body": ex,
            };
        }
        if (ex.err == "REST-NOT-FOUND-ERROR") {
            return <HttpHandlerResponseInfo>{
                "code": 404,
                "body": ex.desc,
            };
        }
        # for all other errors, return the standard "409 Conflict" response
        return RestHandler::returnRestException(ex);
    }

    private *hash<auto> errorResponseHeaders(hash<auto> cx) {
        return getCorsResponseHeaders(cx);
    }

    static *hash<auto> getCorsResponseHeaders(hash<auto> cx) {
        bool explicit_match;
        if (!WebhookHandler::corsOriginOk(cx, \explicit_match)) {
            return;
        }
        return WebhookHandler::getCorsResponseHeadersIntern(cx, explicit_match);
    }

    static private hash<auto> getCorsResponseHeadersIntern(hash<auto> cx, *bool explicit_match) {
        hash<auto> rv;
        # https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Access-Control-Allow-Origin
        # if the server supports clients from multiple origins, it must return the origin for the specific client
        # making the request
        if (cx.hdr.origin && !cors_accept_all_origins) {
            rv = {
                "Access-Control-Allow-Origin": cx.hdr.origin,
                "Vary": "Origin",
            };
        } else {
            rv = {
                "Access-Control-Allow-Origin": "*",
            };
        }
        # return other headers for preflight (OPTIONS) requests
        if (cx.hdr.method == "OPTIONS") {
            rv += {
                "Access-Control-Allow-Methods": cors_allow_methods,
                "Access-Control-Max-Age": cors_max_age,
            };
            if (cors_allow_headers) {
                rv."Access-Control-Allow-Headers" = cors_allow_headers;
            }
        }
        if (cors_allow_credentials) {
            rv."Access-Control-Allow-Credentials" = "true";
        }
        return rv;
    }

    static bool corsOriginOk(hash<auto> cx, *reference<bool> explicit_match) {
        if (!cors_enable) {
            return False;
        }
        if (cors_accept_all_origins) {
            return True;
        }
        if (cors_origin_map{cx.hdr.origin}) {
            explicit_match = True;
            return True;
        }
        return False;
    }

    static corsUpdateOption(string opt, auto value) {
        switch (opt) {
            case "cors-enable":
                cors_enable = value;
                break;

            case "cors-allow-origin": {
                cors_accept_origin = value;
                cors_accept_all_origins = False;
                foreach string origin in (cors_accept_origin) {
                    if (origin == "*") {
                        cors_accept_all_origins = True;
                    }
                    cors_origin_map{origin} = True;
                }
                break;
            }

            case "cors-allow-methods":
                cors_allow_methods = foldl $1 + ", " + $2, value;
                break;

            case "cors-max-age":
                cors_max_age = value.toString();
                break;

            case "cors-allow-headers":
                cors_allow_headers = foldl $1 + ", " + $2, value;
                break;

            case "cors-allow-credentials":
                cors_allow_credentials = value;
                break;
        }
    }
}
