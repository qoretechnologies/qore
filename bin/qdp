        printHelpLine(color.key("-V, --version"), "Show version info", key_width);
        printHelpLine(color.key("-h, --help"), "Show this help", key_width);
        printf("\n");

        printf("%s\n", color.bold("EXAMPLES"));
        printf("  %s mydb info                        %s\n",
            script, color.dim("# Show database provider info"));
        printf("  %s mydb/tables/users search '@name == \"John\"'  %s\n",
            script, color.dim("# Search users table with DPQL"));
