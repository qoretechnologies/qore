        printf("%s\n", color.bold("EXAMPLES"));
        printf("  %s mydb info                        %s\n",
            script, color.dim("# Show database provider info"));
        printf("  %s mydb/users search name=John      %s\n",
            script, color.dim("# Search users table"));
        printf("  %s -J mydb/users search -l 10       %s\n",
            script, color.dim("# JSON output, limit 10"));
        printf("  %s rest'{url=http://api.example.com}' list\n", script);
        printf("  %s @salesforce/search-records '{query=\"SELECT Id FROM Account\"}'\n", script);

        exit(1);
    }

    static error(string fmt) {
        stderr.printf("%s: %s %s\n", get_script_name(), color.error("ERROR:"), vsprintf(fmt, argv));
        exit(1);
    }

    static showVersion() {
        printf("%s version %s\n", get_script_name(), Version);
        printf("Qore %s\n", Qore::VersionString);
%ifndef NoJson
        printf("JSON output: supported\n");
%else
        printf("JSON output: not available (json module not installed)\n");
%endif
%ifndef NoYaml
        printf("YAML output: supported\n");
%else
        printf("YAML output: not available (yaml module not installed)\n");
%endif
%ifndef NoLinenoise
        printf("Line editing: supported (linenoise)\n");
%else
        printf("Line editing: basic (linenoise module not installed)\n");
%endif
        exit(0);
    }

    static signalHandler(int sig) {
        shutdown_requested = True;
        # Print message about graceful shutdown
        stderr.printf("\n%s: received signal %d, shutting down gracefully...\n", get_script_name(), sig);
    }

    #! Output data in the requested format (JSON, YAML, or Qore)
    static output(auto data) {
        if (opts.json) {
%ifndef NoJson
            printf("%s\n", make_json(data, JGF_ADD_FORMATTING));
%else
            error("JSON output requested but json module is not available");
%endif
        } else if (opts.yaml) {
%ifndef NoYaml
            printf("%s", make_yaml(data));
%else
            error("YAML output requested but yaml module is not available");
%endif
        } else {
            printf("%Y\n", data);
        }
    }

    #! Output a single record/hash with optional color formatting
    static outputRecord(auto data) {
        if (opts.json || opts.yaml) {
            output(data);
        } else {
            printf("%s\n", color.formatValue(data));
        }
    }
}

class Term {
    public {}
    private {
        TermIOS orig;
    }

    constructor() {
        TermIOS t();

        # get current terminal attributes for stdin
        stdin.getTerminalAttributes(t);

        # save a copy
        orig = t.copy();

        # get local flags
        int lflag = t.getLFlag();

        # disable canonical input mode (= turn on "raw" mode)
        lflag &= ~ICANON;

        # turn off echo mode
        lflag &= ~ECHO;

        # do not check for special input characters (INTR, QUIT, and SUSP)
        lflag &= ~ISIG;

        # set the new local flags
        t.setLFlag(lflag);

        # set minimum characters to return on a read
        t.setCC(VMIN, 1);

        # set character input timer in 0.1 second increments (= no timer)
        t.setCC(VTIME, 0);

        # make these terminal attributes active
        stdin.setTerminalAttributes(TCSADRAIN, t);
    }

    destructor() {
        restore();
    }

    restore() {
        # restore terminal attributes
        stdin.setTerminalAttributes(TCSADRAIN, orig);
    }
}

class MyObserver inherits Observer {
    public {}

    private {
        hash<DataProviderInfo> info;
        TermIOS t();
    }

    constructor(hash<DataProviderInfo> info) {
        self.info = info;
        # get current terminal attributes for stdin
        stdin.getTerminalAttributes(t);
    }

    update(string event_id, hash<auto> data_) {
        string msg = sprintf("received event %s:", QdpCmd::color.cyan(event_id));
        if (!data_) {
            msg += " " + QdpCmd::color.dim("no data");
        }
        if (data_) {
            msg += sprintf("\n%s", QdpCmd::color.formatValue(data_));
        }
        log("<", msg);
        if (info.connection_event == event_id) {
            string protocol = data_.http2 ? "HTTP/2" : "HTTP/1.1";
            log("<", "%s (WebSocket over %s)", QdpCmd::color.success("connected to server"),
                QdpCmd::color.info(protocol));
        } else if (info.disconnection_event == event_id) {
            if (info.supports_auto_reconnect) {
                log("<", "%s%s", QdpCmd::color.warning("disconnected from server"),
                    QdpCmd::ix ? "; trying to reconnect..." : "");
            } else {
                log("<", "%s; auto_reconnect not enabled; exiting",
                    QdpCmd::color.error("disconnected from server"));
                # restore original terminal attributes
                stdin.setTerminalAttributes(TCSADRAIN, t);
                exit(0);
            }
        }
        stdout.sync();
    }

    log(string inout, string fmt, ...) {
        if (QdpCmd::ix) {
            stdout.print("\r");
        }
        string direction_color = inout == "<" ? QdpCmd::color.green(inout) : QdpCmd::color.yellow(inout);
        string timestamp = QdpCmd::color.dim(now_us().format("YYYY-MM-DD HH:mm:SS.xx"));
        fmt = sprintf("%s %s ", direction_color, timestamp) + fmt;
        string msg = vsprintf(fmt, argv);
%ifndef NoLinenoise
        msg =~ s/\n/\015\012/g;
%endif
        stdout.print(msg + "\n");
        if (QdpCmd::ix) {
            stdout.print("\r");
        }
    }
}

class ConsoleAppender inherits LoggerAppenderWithLayout {
    constructor() : LoggerAppenderWithLayout("console", new LoggerLayoutPattern("%d{YYYY-MM-DD HH:mm:SS.xx} T%t [%p]: %m%n")) {
        open();
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
%ifndef NoLinenoise
                params =~ s/\n/\r\n/g;
%endif
                print(params);
                break;
        }
    }
}

class InputHelper {
    public {
        AbstractDataProvider provider;
        # message map
        hash<string, hash<DataProviderMessageInfo>> mmap;
        # event map
        *hash<string, hash<DataProviderMessageInfo>> emap;

%ifndef NoLinenoise
        static string path;
        const HistoryFile = ".qdp-history";
%endif

        const Prompt = "> ";

        const Commands = {
            "event": True,
            "exit": True,
            "help": True,
            "history": True,
            "info": True,
            "msg": True,
            "quit": True,
        };
    }

    constructor(AbstractDataProvider provider) {
        self.provider = provider;
        mmap = provider.getMessageTypes();
        emap = provider.getEventTypes();

%ifndef NoLinenoise
        Linenoise::history_set_max_len(100);
        Linenoise::set_callback(\completion());

        path = ENV.HOME + DirSep + HistoryFile;

        bool ok;
        try {
            # create history file if it doesn't exist
            if (!is_file(path)) {
                File f();
                f.open2(path, O_CREAT | O_WRONLY);
            }
            ok = True;
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("%y: WARNING: cannot create history file: %s: %s\n", path, ex.err, ex.desc);
        }

        if (ok) {
            try {
                Linenoise::history_load(path);
            } catch (hash<ExceptionInfo> ex) {
                stderr.printf("%y: WARNING: cannot load history: %s: %s\n", path, ex.err, ex.desc);
            }
        }
%endif
    }

    destructor() {
%ifndef NoLinenoise
        Linenoise::history_save(path);
%endif
    }

    string get() {
        string line;
        while (True) {
%ifndef NoLinenoise
            *string line0 = Linenoise::line(Prompt);
            if (!exists line0) {
                line = "exit";
                break;
            }
            line = line0;
            Linenoise::history_add(line);
%else
            stdout.print(Prompt);
            stdout.sync();
            line = trim(stdin.readLine());
%endif

%ifndef NoLinenoise
                # save history
                Linenoise::history_save(InputHelper::path);
%endif

            if (line == 'help' || line == '?') {
                interactiveHelp();
                continue;
            }
            if (line == "info") {
                interactiveInfo(provider);
                continue;
            }
            if (line == "info messages" || line == "info msgs") {
                showAllMessages();
                continue;
            }
            if (line == "info events") {
                showAllEvents();
                continue;
            }
            if (line =~ /^msg\s+/) {
                showMessageInfo(provider, trim(line.substr(4)));
                continue;
            }
            if (line =~ /^event\s+/) {
                showEventInfo(provider, trim(line.substr(6)));
                continue;
            }
%ifndef NoLinenoise
            if (line == 'history') {
                map printf("%s\n", $1), Linenoise::history();
                continue;
            }
%endif

            if (!line.val()) {
                continue;
            }

            break;
        }

        return line;
    }

    private interactiveHelp() {
        printf("%s\n", QdpCmd::color.bold("SENDING MESSAGES"));
        printHelpLine("<msg-id>: <data>", "Send a message to the provider");
        printf("                    Example: data: action=ping,id=123\n");
        if (mmap) {
            printf("  %s: %s\n", QdpCmd::color.key("Available"),
                (foldl $1 + ", " + $2, (map QdpCmd::color.type($1), keys mmap)));
            printf("  (type '%s' or '%s <id>' for details)\n", QdpCmd::color.key("info msgs"),
                QdpCmd::color.key("msg"));
        }
        printf("%s\n", QdpCmd::color.bold("SESSION COMMANDS"));
        printHelpLine("help, ?", "Show this help");
        printHelpLine("info", "Show connection info");
        printHelpLine("info msgs", "List all available messages");
        printHelpLine("info events", "List all available events");
        printHelpLine("msg <id>", "Show message type details");
        printHelpLine("event <id>", "Show event type details");
%ifndef NoLinenoise
        printHelpLine("history", "Show command history");
%endif
        printHelpLine("quit, exit", "Exit interactive mode");
        printf("%s\n", QdpCmd::color.bold("KEYBOARD SHORTCUTS"));
        printHelpLine("Enter", "Send message / execute command");
        printHelpLine("Ctrl+C", "Exit interactive mode");
%ifndef NoLinenoise
        printHelpLine("Up/Down", "Previous command in history");
        printHelpLine("Tab", "Autocomplete message ID");
%endif
    }

    private printHelpLine(string key, string desc) {
        printf("  %s%s%s\n", QdpCmd::color.key(key), strmul(" ", 18 - key.length()), desc);
    }

    private interactiveInfo(AbstractDataProvider provider) {
        printf("%s\n", QdpCmd::color.bold("Connection Info"));
        printf("  %s: %s\n", QdpCmd::color.key("Provider"), provider.getName());
        printf("  %s: %s\n", QdpCmd::color.key("Description"), provider.getShortDesc());

        # Connection details
        *hash<DataProviderConnectionInfo> cinfo = provider.getConnectionInfo();
        if (cinfo) {
            if (cinfo.url) {
                printf("  %s: %s\n", QdpCmd::color.key("URL"), cinfo.url);
                printf("  %s: %s\n", QdpCmd::color.key("Connected"),
                    cinfo.connected ? QdpCmd::color.success("Yes") : QdpCmd::color.error("No"));
                printf("  %s: %s\n", QdpCmd::color.key("Auto Reconnect"),
                    cinfo.auto_reconnect ? "Yes" : "No");
            }
            if (cinfo.info) {
                formatConnectionInfo(cinfo.info);
            }
        }

        # Messages summary
        *hash<string, hash<DataProviderMessageInfo>> messages = provider.getMessageTypes();
        if (messages) {
            printf("  %s: %s (type '%s <id>' for details)\n", QdpCmd::color.key("Outgoing Messages"),
                (foldl $1 + ", " + $2, keys messages), QdpCmd::color.key("msg"));
        }

        # Events summary
        *hash<string, hash<DataProviderMessageInfo>> events = provider.getEventTypes();
        if (events) {
            printf("  %s: %s (type '%s <id>' for details)\n", QdpCmd::color.key("Incoming Events"),
                (foldl $1 + ", " + $2, keys events), QdpCmd::color.key("event"));
        }
    }

    private formatConnectionInfo(hash<auto> info) {
        # Format HTTP/2 info if available
        if (info.hasKey("http2")) {
            string protocol = info.http2 ? "HTTP/2 (RFC 8441)" : "HTTP/1.1";
            printf("  %s: %s\n", QdpCmd::color.key("Protocol"), QdpCmd::color.info(protocol));
        }
        # Format peer info (remote endpoint)
        if (info.peer) {
            string peer_str = info.peer.hostname ?? info.peer.address;
            if (info.peer.port) {
                peer_str += ":" + info.peer.port;
            }
            if (info.peer.hostname && info.peer.address && info.peer.address != info.peer.hostname) {
                peer_str += " (" + info.peer.address + ")";
            }
            printf("  %s: %s\n", QdpCmd::color.key("Peer"), peer_str);
        }
        # Format local socket info
        if (info.socket.port) {
            printf("  %s: %d\n", QdpCmd::color.key("Local Port"), info.socket.port);
        }
    }

    private showMessageInfo(AbstractDataProvider provider, string msg_id) {
        if (!msg_id.val()) {
            printf("%s: usage: msg <message-id>; valid: %s\n", QdpCmd::color.error("ERROR"),
                (foldl $1 + ", " + $2, keys mmap));
            return;
        }
        *hash<DataProviderMessageInfo> info;
        try {
            info = provider.getMessageInfo(msg_id);
        } catch (hash<ExceptionInfo> ex) {
            printf("%s: %s\n", QdpCmd::color.error("ERROR"), ex.desc);
            return;
        }
        if (!info) {
            printf("%s: unknown message '%s'; valid: %s\n", QdpCmd::color.error("ERROR"),
                msg_id, (foldl $1 + ", " + $2, keys mmap));
            return;
        }
        QdpCmd::showType(provider, msg_id, info);
    }

    private showEventInfo(AbstractDataProvider provider, string event_id) {
        if (!event_id.val()) {
            *hash<string, hash<DataProviderMessageInfo>> events = provider.getEventTypes();
            printf("%s: usage: event <event-id>; valid: %s\n", QdpCmd::color.error("ERROR"),
                events ? (foldl $1 + ", " + $2, keys events) : "(none)");
            return;
        }
        *hash<DataProviderMessageInfo> info;
        try {
            info = provider.getEventInfo(event_id);
        } catch (hash<ExceptionInfo> ex) {
            printf("%s: %s\n", QdpCmd::color.error("ERROR"), ex.desc);
            return;
        }
        if (!info) {
            *hash<string, hash<DataProviderMessageInfo>> events = provider.getEventTypes();
            printf("%s: unknown event '%s'; valid: %s\n", QdpCmd::color.error("ERROR"),
                event_id, events ? (foldl $1 + ", " + $2, keys events) : "(none)");
            return;
        }
        QdpCmd::showType(provider, event_id, info);
    }

    private showAllMessages() {
        if (!mmap) {
            printf("No messages available for this provider\n");
            return;
        }
        printf("%s (type '%s <id>' for type details)\n", QdpCmd::color.bold("SUPPORTED MESSAGES"),
            QdpCmd::color.key("msg"));
        foreach hash<auto> msg in (mmap.pairIterator()) {
            string desc = msg.value.desc ?? "(no description)";
            printf("  %s %s\n", QdpCmd::color.dim("→"), QdpCmd::color.key(msg.key));
            printf("    %s\n", desc);
        }
    }

    private showAllEvents() {
        if (!emap) {
            printf("No events available for this provider\n");
            return;
        }
        printf("%s (type '%s <id>' for type details)\n", QdpCmd::color.bold("SUPPORTED EVENTS"),
            QdpCmd::color.key("event"));
        foreach hash<auto> evt in (emap.pairIterator()) {
            string desc = evt.value.desc ?? "(no description)";
            printf("  %s %s\n", QdpCmd::color.dim("→"), QdpCmd::color.key(evt.key));
            printf("    %s\n", desc);
        }
    }

    softlist<string> completion(string str) {
        list<string> rv = ();
        # Info subcommands
        list<string> info_subcmds = ("msgs", "messages", "events");
        # For empty input (after "msg ", "event ", or "info ")
        if (!str.val()) {
            rv += keys mmap;
            if (emap) {
                rv += keys emap;
            }
            rv += info_subcmds;
            return rv;
        }
        # Complete command names
        foreach string cmd in (keys Commands) {
            if (cmd.equalPartial(str)) {
                rv += cmd;
            }
        }
        # Complete info subcommands (for after "info ")
        foreach string subcmd in (info_subcmds) {
            if (subcmd.equalPartial(str)) {
                rv += subcmd;
            }
        }
        # Complete message IDs (user adds ":" for sending)
        foreach string msg in (keys mmap) {
            if (msg.equalPartial(str)) {
                rv += msg;
            }
        }
        # Complete event IDs (for after "event ")
        if (emap) {
            foreach string evt in (keys emap) {
                if (evt.equalPartial(str)) {
                    rv += evt;
                }
            }
        }
        return rv;
    }
}

class WebhookHandler inherits RestHandler {
    private {
        string rest_method;
        string root_path;
        code callback;

        static bool cors_enable = DefaultCorsEnable;
        static *softlist<string> cors_accept_origin;
        static *string cors_allow_methods = foldl $1 + ", " + $2, DefaultCorsAllowMethods;
        static softstring cors_max_age = DefaultCorsMaxAge;
        static *string cors_allow_headers = foldl $1 + ", " + $2, DefaultCorsAllowHeaders;
        static bool cors_allow_credentials = DefaultCorsAllowCredentials;
        static bool cors_accept_all_origins = DefaultCorsAcceptAllOrigins;
        static hash<string, bool> cors_origin_map;

        const DefaultCorsEnable = True;
        const DefaultCorsAllowMethods = ("GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS");
        const DefaultCorsMaxAge = 9999999;
        const DefaultCorsAllowHeaders = (
            "Content-Type", "content-type", "Content-Language", "content-language",
            "Accept", "Accept-Language", "Authorization", "Qorus-Token", "Qorus-Client-Time-Zone",
        );
        const DefaultCorsAllowCredentials = True;
        const DefaultCorsAcceptAllOrigins = True;
    }

    constructor(string method, string path, code callback) : RestHandler() {
        rest_method = method;
        root_path = (path =~ /^\//) ? path[1..] : path;
        self.callback = callback;
    }

    removeRootPath(reference<string> path) {
        if (path.startsWith(root_path)) {
            splice path, 0, root_path.size();
        }
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpHandlerResponseInfo> post(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpHandlerResponseInfo> put(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpHandlerResponseInfo> patch(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpHandlerResponseInfo> del(hash<auto> cx, *hash<auto> ah) {
        return callWebhook(cx, ah);
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data b) {
        #logDebug("Webhook headers: %N", hdr);

        # handle OPTIONS requests
        if (hdr.method == "OPTIONS" && (*hash<auto> cors_hdrs = getCorsResponseHeaders(cx))) {
            # return a CORS response
            return AbstractHttpRequestHandler::makeResponse(200, NOTHING, cors_hdrs);
        }

        # check for valid method
        if (hdr.method != rest_method) {
            # get rest class name
            string path = cx.url.path ?? "";
            removeRootPath(\path);
            return AbstractHttpRequestHandler::makeResponse(405, sprintf("HTTP method %y is not supported with URI "
                "path %y; supported method: %s", hdr.method, path, rest_method), getCorsResponseHeaders(cx) +
                {"Allow": rest_method});
        }

        cx.sctx.listener = listener;
        hash<HttpResponseInfo> rv = RestHandler::handleRequest(listener, s, cx, hdr, b);
        if (!rv.hdr."Access-Control-Allow-Origin") {
            rv.hdr += getCorsResponseHeaders(cx);
        }
        return rv;
    }

    hash<HttpHandlerResponseInfo> callWebhook(hash<auto> cx, *hash<auto> ah) {
        logInfo("Webhook %y called", root_path);
        logDebug("Webhook %y args: %y", root_path, ah);
        on_error QdpCmd::http.logError("%s", get_exception_string($1));
        try {
            return <HttpHandlerResponseInfo>{
                "code": 200,
                "body": callback(ah),
            };
        } catch (hash<ExceptionInfo> ex) {
            QdpCmd::http.logError("Webhook %y args: %y error: %s", root_path, ah, get_exception_string(ex));
            return <HttpHandlerResponseInfo>{
                "code": 500,
                "body": sprintf("%s: %s", ex.err, ex.desc),
            };
        }
    }

    private hash<HttpHandlerResponseInfo> returnRestException(hash<ExceptionInfo> ex) {
        try {
            if (ex.arg.typeCode() == NT_OBJECT) {
                remove ex.arg;
            }
        } catch (hash<ExceptionInfo> ex0) {
            remove ex.arg;
        }
        if (ex.err =~ /-ARG-ERROR$/) {
            return <HttpHandlerResponseInfo>{
                "code": 400,
                "body": ex.desc,
            };
        }
        if (ex.err == "AUTHORIZATION-ERROR" || ex.err =~ /-ACCESS-ERROR$/) {
            return <HttpHandlerResponseInfo>{
                "code": 403,
                "body": ex,
            };
        }
        if (ex.err == "REST-NOT-FOUND-ERROR") {
            return <HttpHandlerResponseInfo>{
                "code": 404,
                "body": ex.desc,
            };
        }
        # for all other errors, return the standard "409 Conflict" response
        return RestHandler::returnRestException(ex);
    }

    private *hash<auto> errorResponseHeaders(hash<auto> cx) {
        return getCorsResponseHeaders(cx);
    }

    static *hash<auto> getCorsResponseHeaders(hash<auto> cx) {
        bool explicit_match;
        if (!WebhookHandler::corsOriginOk(cx, \explicit_match)) {
            return;
        }
        return WebhookHandler::getCorsResponseHeadersIntern(cx, explicit_match);
    }

    static private hash<auto> getCorsResponseHeadersIntern(hash<auto> cx, *bool explicit_match) {
        hash<auto> rv;
        # https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Access-Control-Allow-Origin
        # if the server supports clients from multiple origins, it must return the origin for the specific client
        # making the request
        if (cx.hdr.origin && !cors_accept_all_origins) {
            rv = {
                "Access-Control-Allow-Origin": cx.hdr.origin,
                "Vary": "Origin",
            };
        } else {
            rv = {
                "Access-Control-Allow-Origin": "*",
            };
        }
        # return other headers for preflight (OPTIONS) requests
        if (cx.hdr.method == "OPTIONS") {
            rv += {
                "Access-Control-Allow-Methods": cors_allow_methods,
                "Access-Control-Max-Age": cors_max_age,
            };
            if (cors_allow_headers) {
                rv."Access-Control-Allow-Headers" = cors_allow_headers;
            }
        }
        if (cors_allow_credentials) {
            rv."Access-Control-Allow-Credentials" = "true";
        }
        return rv;
    }

    static bool corsOriginOk(hash<auto> cx, *reference<bool> explicit_match) {
        if (!cors_enable) {
            return False;
        }
        if (cors_accept_all_origins) {
            return True;
        }
        if (cors_origin_map{cx.hdr.origin}) {
            explicit_match = True;
            return True;
        }
        return False;
    }

    static corsUpdateOption(string opt, auto value) {
        switch (opt) {
            case "cors-enable":
                cors_enable = value;
                break;

            case "cors-allow-origin": {
                cors_accept_origin = value;
                cors_accept_all_origins = False;
                foreach string origin in (cors_accept_origin) {
                    if (origin == "*") {
                        cors_accept_all_origins = True;
                    }
                    cors_origin_map{origin} = True;
                }
                break;
            }

            case "cors-allow-methods":
                cors_allow_methods = foldl $1 + ", " + $2, value;
                break;

            case "cors-max-age":
                cors_max_age = value.toString();
                break;

            case "cors-allow-headers":
                cors_allow_headers = foldl $1 + ", " + $2, value;
                break;

            case "cors-allow-credentials":
                cors_allow_credentials = value;
                break;
        }
    }
}