            script, color.dim("# JSON output, limit 10"));
        printf("  %s rest'{url=http://api.example.com}' list\n", script);
        printf("  %s @salesforce/search-records search '@query == \"SELECT Id FROM Account\"'\n", script);
        printf("  %s mydb/tables/users search '@name == \"John\"'\n", script);
        printf("  %s mydb/tables/users search -q '@name == \"John\"'\n", script);
