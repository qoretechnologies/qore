            color.dim("Factory with inline options"));
        printf("  %s  %s\n", color.key("csvread{path=file.csv}"),
            color.dim("CSV file reader"));
        printf("  %s  %s\n", color.key("csvwrite{path=file.csv}"),
            color.dim("CSV file writer"));

        printf("\n%s\n", color.bold("OPTIONS"));
        printf("  %s  %s\n", color.key("-d, --dry-run"),
            "Show pipeline plan without executing");
