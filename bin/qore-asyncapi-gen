%modern

%requires AsyncApi
%requires Util

%try-module yaml >= 0.5
%define NoYaml
%endtry

%exec-class AsyncApiGenCmd

class AsyncApiGenCmd {
    public {
        #! program options
        const Opts = {
            "output":      "o,output=s",
            "format":      "f,format=s",
            "title":       "t,title=s",
            "version":     "V,api-version=s",
            "description": "d,description=s",
            "server":      "s,server=s@",
            "channel":     "c,channel=s@",
            "verbose":     "v,verbose:i+",
            "help":        "h,help",
        };

        const DefaultFormat = "yaml";
        const Version = "1.0";
    }

    private {
        hash<auto> opt;
    }

    constructor() {
        GetOpt g(Opts);
        opt = g.parse3(\ARGV);

        if (opt.help) {
            usage();
            exit(0);
        }

        if (!ARGV) {
            stderr.printf("Error: no source files specified\n\n");
            usage();
            exit(1);
        }

        # Check format option
        string fmt = opt.format ?? DefaultFormat;
        if (fmt != "yaml" && fmt != "json") {
            stderr.printf("Error: invalid format '%s', must be 'yaml' or 'json'\n", fmt);
            exit(1);
        }

%ifdef NoYaml
        if (fmt == "yaml") {
            stderr.printf("Error: YAML format requested but yaml module is not available\n");
            exit(1);
        }
%endif

        try {
            generateSchema(cast<list<string>>(ARGV));
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("Error: %s: %s\n", ex.err, ex.desc);
            if (opt.verbose) {
                stderr.printf("%s\n", get_exception_string(ex));
            }
            exit(1);
        }
    }

    private usage() {
        printf("qore-asyncapi-gen v%s - Generate AsyncAPI 3 schemas from Qore source files\n\n", Version);
        printf("Usage: qore-asyncapi-gen [options] <source-files...>\n\n");
        printf("Options:\n");
        printf("  -o, --output=FILE        Output file (default: stdout)\n");
        printf("  -f, --format=FORMAT      Output format: yaml|json (default: yaml)\n");
        printf("  -t, --title=TITLE        API title (default: 'Event API')\n");
        printf("  -V, --api-version=VER    API version (default: '1.0.0')\n");
        printf("  -d, --description=DESC   API description\n");
        printf("  -s, --server=URL         Server URL (can be specified multiple times)\n");
        printf("  -c, --channel=PATH       Channel path (can be specified multiple times)\n");
        printf("  -v, --verbose            Increase verbosity\n");
        printf("  -h, --help               Show this help message\n\n");
        printf("The tool parses @EVENT/@EVENTSCHEMA and @WEBSOCKET/@ASYNCAPI blocks in Qore\n");
        printf("source files and generates an AsyncAPI 3.0.0 specification.\n\n");
        printf("Example:\n");
        printf("  qore-asyncapi-gen -t 'My Events' -V '2.0' -o events.yaml src/*.qclass\n");
    }

    private generateSchema(list<string> files) {
        # Filter out empty strings
        files = select files, $1.val();

        # Build API info
        hash<auto> api_info = {
            "title": opt.title ?? "Event API",
            "version": opt{"api-version"} ?? opt.version ?? "1.0.0",
        };

        if (opt.description) {
            api_info.description = opt.description;
        }

        # Create generator
        AsyncApi::AsyncApiSchemaGenerator gen(api_info);

        # Add servers if specified
        if (opt.server) {
            int idx = 0;
            foreach string url in (opt.server) {
                string name = idx == 0 ? "default" : sprintf("server%d", idx);
                gen.addServer(name, {
                    "host": url,
                    "protocol": url =~ /^wss/ ? "wss" : "ws",
                });
                idx++;
            }
        }

        # Add channels if specified
        if (opt.channel) {
            foreach string path in (opt.channel) {
                gen.addChannel(cast<hash<AsyncApi::ChannelSchemaInfo>>({
                    "path": path,
                    "summary": sprintf("Channel %s", path),
                }));
            }
        }

        # Process each source file
        int total_events = 0;
        int total_channels = 0;
        foreach string filepath in (files) {
            if (opt.verbose) {
                stderr.printf("Processing: %s\n", filepath);
            }

            if (!is_readable(filepath)) {
                stderr.printf("Warning: cannot read file '%s', skipping\n", filepath);
                continue;
            }

            string content = ReadOnlyFile::readTextFile(filepath);

            # Parse event blocks
            list<hash<AsyncApi::EventSchemaInfo>> events = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlocks(content);
            if (opt.verbose > 1) {
                stderr.printf("  Found %d events\n", events.size());
            }

            foreach hash<AsyncApi::EventSchemaInfo> event in (events) {
                gen.addEvent(event);
                total_events++;
            }

            # Parse channel blocks
            list<hash<AsyncApi::ChannelSchemaInfo>> channels = AsyncApi::AsyncApiSchemaTokenizer::parseChannelBlocks(content);
            if (opt.verbose > 1) {
                stderr.printf("  Found %d channels\n", channels.size());
            }

            foreach hash<AsyncApi::ChannelSchemaInfo> channel in (channels) {
                gen.addChannel(channel);
                total_channels++;
            }
        }

        if (opt.verbose) {
            stderr.printf("Total events processed: %d\n", total_events);
            stderr.printf("Total channels processed: %d\n", total_channels);
        }

        # Generate output
        string fmt = opt.format ?? DefaultFormat;
        string output;

        if (fmt == "yaml") {
%ifdef NoYaml
            throw "YAML-ERROR", "YAML format requested but yaml module is not available";
%else
            output = gen.toYaml();
%endif
        } else {
            output = gen.toJson();
        }

        # Write output
        if (opt.output) {
            File f();
            f.open(opt.output, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(output);
            f.close();
            if (opt.verbose) {
                stderr.printf("Output written to: %s\n", opt.output);
            }
        } else {
            print(output);
        }
    }
}
