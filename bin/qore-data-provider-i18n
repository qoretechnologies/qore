%modern
%requires DataProvider
%requires FsUtil
%requires i18n
%requires json
%requires Util

%exec-class QoreDataProviderI18nCmd

class QoreDataProviderI18nCmd {
    public {
        const Version = "0.1";
        const Opts = {
            "output":  "o,output=s",
            "module":  "m,module=s@",
            "app":     "a,app=s@",
            "check":   "check",
            "check_tree": "check-tree",
            "verbose": "v,verbose:i+",
            "help":    "h,help",
        };
    }

    private {
        Util::TerminalColor color;
    }

    constructor() {
        bool no_color = removeNoColorOption();
        color = new Util::TerminalColor(!no_color);
        GetOpt g(Opts);
        hash<auto> opt = g.parse3(\ARGV);
        if (opt.help) {
            usage();
            return;
        }
        if (ARGV) {
            fail("unexpected positional arguments: " + ARGV.join(" "));
        }
        if (!opt.output.val()) {
            fail("--output is required");
        }

        try {
            run(opt);
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("%s %s: %s\n", color.error("ERROR:"), ex.err,
                ex.desc);
            exit(1);
        }
    }

    private run(hash<auto> opt) {
        if (opt.check_tree) {
            if (opt.module || opt.app) {
                fail("--check-tree cannot be combined with --module or --app");
            }
            checkTree(opt.output, opt.verbose);
            return;
        }

        foreach string module_name in (cast<list<string>>(opt.module ?? ())) {
            if (opt.verbose) {
                printf("loading provider module %s\n", color.key(module_name));
            }
            load_module(module_name);
        }

        hash<string, hash<auto>> app_map = {};
        foreach hash<auto> app in (
                DataProviderActionCatalog::getAllApps()) {
            app_map{app.name} = app;
        }
        list<string> app_names = opt.app
            ? cast<list<string>>(opt.app) : sort(keys app_map);
        if (!app_names) {
            throw "DATA-PROVIDER-I18N-ERROR",
                "no provider applications are registered";
        }

        hash<string, hash<auto>> catalogs = {};
        foreach string app_name in (app_names) {
            if (!exists app_map{app_name}) {
                throw "DATA-PROVIDER-I18N-ERROR",
                    sprintf("provider application %y is not registered",
                        app_name);
            }
            hash<auto> app = app_map{app_name};
            list<hash<auto>> actions =
                DataProviderActionCatalog::getActions(app_name, False);
            mergeCatalogs(\catalogs,
                DataProviderPresentation::buildSourceCatalogs(app,
                    actions));
        }

        int stale = 0;
        foreach string domain in (sort(keys catalogs)) {
            # Reuse the native validation boundary before treating a domain as
            # a directory name. An empty search path performs no file access.
            list<string> validated_catalog_files = I18n::discover_catalog_files(domain,
                DataProviderPresentation::RootLocale,
                {"search_path": ()});
            string path = join_paths(opt.output, domain, "root.json");
            string data = make_json(catalogs{domain}, JGF_ADD_FORMATTING)
                + "\n";
            if (opt.check) {
                if (!is_readable(path)
                        || parse_json(ReadOnlyFile::readTextFile(path))
                            != catalogs{domain}) {
                    ++stale;
                    stderr.printf("%s %s\n", color.error("STALE:"), path);
                }
                stale += checkTranslations(domain,
                    catalogs{domain}.locales.root.messages, opt.output,
                    opt.verbose);
                continue;
            }
            mkdir_ex(dirname(path), 0755, True);
            writeFile(path, data);
            if (opt.verbose) {
                printf("wrote %s (%d messages)\n", color.key(path),
                    catalogs{domain}.locales.root.messages.size());
            }
        }
        if (stale) {
            exit(2);
        }
        printf("%s %d app(s), %d catalog domain(s)\n",
            opt.check ? "verified" : "extracted", app_names.size(),
            catalogs.size());
    }

    private checkTree(string output, *int verbose) {
        list<hash<auto>> roots = ();
        collectRootCatalogs(output, \roots);
        if (!roots) {
            throw "DATA-PROVIDER-I18N-ERROR", sprintf(
                "no source-owned provider root catalogs found below %y",
                output);
        }

        int stale = 0;
        int translation_count = 0;
        foreach hash<auto> root in (roots) {
            hash<auto> catalog = I18n::load_native_catalog(root.path);
            I18n::MessageCatalog validated(catalog,
                {"literal_messages": True});
            if (sort(keys catalog.locales)
                    != (DataProviderPresentation::RootLocale,)) {
                ++stale;
                stderr.printf("%s %s must contain only locale %y\n",
                    color.error("STALE:"), root.path,
                    DataProviderPresentation::RootLocale);
                continue;
            }
            hash<auto> result =
                DataProviderPresentation::inspectTranslationCatalogs(
                    root.domain, catalog.locales.root.messages,
                    {"search_path": (root.search_root,)});
            translation_count += result.translation_count;
            foreach hash<auto> issue in (result.issues) {
                ++stale;
                stderr.printf("%s %s%s: %s\n", color.error("STALE:"),
                    issue.path, issue.message_id.val()
                        ? ": " + issue.message_id : "", issue.reason);
            }
            if (verbose) {
                printf("verified %s\n", color.key(root.path));
            }
        }
        if (stale) {
            exit(2);
        }
        printf("verified %d catalog domain(s), %d translation(s)\n",
            roots.size(), translation_count);
    }

    private collectRootCatalogs(string path,
            reference<list<hash<auto>>> roots) {
        if (!is_dir(path)) {
            throw "DATA-PROVIDER-I18N-ERROR",
                sprintf("catalog tree %y is not a directory", path);
        }
        string name = basename(path);
        string nested_root = path + DirSep
            + DataProviderPresentation::RootLocale + ".json";
        if (name.startsWith(DataProviderPresentation::CatalogDomainPrefix)
                && is_file(nested_root)) {
            roots += {
                "domain": name,
                "path": nested_root,
                "search_root": dirname(path),
            };
        }

        string flat_suffix = "."
            + DataProviderPresentation::RootLocale + ".json";
        foreach string file in (glob(path + DirSep
                + DataProviderPresentation::CatalogDomainPrefix + "*"
                + flat_suffix)) {
            if (!is_file(file)) {
                continue;
            }
            string file_name = basename(file);
            roots += {
                "domain": file_name.substr(0,
                    file_name.length() - flat_suffix.length()),
                "path": file,
                "search_root": path,
            };
        }

        Dir dir();
        if (!dir.chdir(path)) {
            throw "DATA-PROVIDER-I18N-ERROR",
                sprintf("cannot read catalog tree directory %y", path);
        }
        foreach string child in (dir.listDirs()) {
            collectRootCatalogs(path + DirSep + child, \roots);
        }
    }

    private int checkTranslations(string domain, hash<auto> root_messages,
            string output, *int verbose) {
        hash<auto> result =
            DataProviderPresentation::inspectTranslationCatalogs(domain,
                root_messages, {"search_path": (output,)});
        foreach hash<auto> issue in (result.issues) {
            stderr.printf("%s %s%s: %s\n", color.error("STALE:"),
                issue.path, issue.message_id.val()
                    ? ": " + issue.message_id : "", issue.reason);
        }
        if (verbose) {
            printf("checked %d translation(s) for %s\n",
                result.translation_count, color.key(domain));
        }
        return result.issues.size();
    }

    private mergeCatalogs(reference<hash<string, hash<auto>>> target,
            hash<string, hash<auto>> source) {
        foreach hash<auto> catalog_entry in (source.pairIterator()) {
            string domain = catalog_entry.key;
            hash<auto> source_messages =
                catalog_entry.value.locales.root.messages;
            if (!exists target{domain}) {
                target{domain} = catalog_entry.value;
                continue;
            }
            foreach hash<auto> message in (
                    source_messages.pairIterator()) {
                if (exists target{domain}.locales.root.messages{message.key}
                        && target{domain}.locales.root.messages{message.key}
                            != message.value) {
                    throw "DATA-PROVIDER-I18N-ERROR",
                        sprintf("catalog domain %y has conflicting message "
                            "id %y", domain, message.key);
                }
                target{domain}.locales.root.messages{message.key} =
                    message.value;
            }
        }
    }

    private writeFile(string path, string data) {
        File file();
        file.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        file.write(data);
        file.close();
    }

    private bool removeNoColorOption() {
        bool no_color = False;
        list<string> args = ();
        foreach string arg in (ARGV) {
            if (arg == "-C" || arg == "--no-color") {
                no_color = True;
            } else {
                args += arg;
            }
        }
        ARGV = args;
        return no_color;
    }

    private fail(string message) {
        stderr.printf("%s %s\n\n", color.error("ERROR:"), message);
        usage();
        exit(1);
    }

    private usage() {
        printf("%s v%s - Extract source-owned data-provider i18n catalogs\n\n",
            color.bold("qore-data-provider-i18n"), Version);
        printf("%s\n", color.bold("USAGE"));
        printf("  qore-data-provider-i18n [options]\n\n");
        printf("%s\n", color.bold("OPTIONS"));
        printf("  -o, --output=DIR   Root output directory (required)\n");
        printf("  -m, --module=MOD   Load provider module; repeatable\n");
        printf("  -a, --app=APP      Extract exact app identifier; repeatable\n");
        printf("      --check        Exit 2 if any generated root or translation is stale\n");
        printf("      --check-tree   Recursively verify catalogs without loading providers\n");
        printf("  -v, --verbose      Show loaded modules and written files\n");
        printf("  -C, --no-color     Disable colored output\n");
        printf("  -h, --help         Show this help\n");
    }
}
