#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires qore >= 2.0
%requires WebSocketClient
%requires yaml >= 0.5
%requires DebugCmdLine
%requires DebugLinenoiseCmdLine
%requires ConnectionProvider
%requires Logger

%allow-debugger
%no-debugging

%exec-class DebugWrapper

class DebugCommandLineRemote inherits DebugLinenoiseCommandLine {
    const WSC_TIMEOUT = 1500ms;
    public {
        ResponseSync sync();
        int pendingUid;
        WebSocketClient wsc;
        timeout wscTimeout;
        bool connecting;
        string serverName;
        string url;
        *hash<auto> headers;
        #! serializes the commands, as one response is waited for at a time; the commands of stopping all threads
        #! together are sent in background threads
        Mutex cmdLock();
    }

    constructor(hash<auto> opts) : DebugLinenoiseCommandLine() {
        wscTimeout = opts.response_timeout ?? WSC_TIMEOUT;
        opts.logger = logger;
        url = opts.url;
        if (opts.header) {
            foreach string h in (opts.header) {
                *list<string> rv = (h =~ x/^([a-zA-Z0-9\-]+)=(.*)$/);
                if (!rv) {
                    throw "GETOPT-ERROR", sprintf("Wrong header specification %y", h);
                }
                headers{rv[0]} = rv[1];
            }
        }
        wsc = new WebSocketClient(\wscEvent(), opts);
    }

    public *hash<auto> doCommandImpl(hash<auto> data) {
        # a command that resumes the thread returns when it stops again (see waitsForStops); the wait starts before
        # the command is sent, as the thread can stop again before the answer to the command is received
        bool resumes = resumesWithWait(data);
        if (resumes) {
            expectStop(data.tid);
        }
        on_error if (resumes) {
            cancelStop();
        }
        *hash<auto> ret;
        {
            AutoLock al(cmdLock);
            pendingUid = clock_getmicros();
            # an untyped hash, as a hash of strings, such as {"cmd": "session"}, also gets the integer ID
            hash<auto!> cmd = data;
            cmd.uid = pendingUid;
            string d = make_yaml(cmd);
            sync.prepare();
            debug("send: %y", d);
            wsc.send(d);
            ret = sync.waitForResponse(wscTimeout);
        }
        if (resumes) {
            if (!ret || ret.type == DebugResponseType::Error) {
                cancelStop();
            } else {
                waitForStop();
            }
        }
        return ret;
    }

    public nothing connect() {
        connecting = True;
        sync.prepare();
        hash<auto> hh = wsc.connect({"hdr": headers});
        *string prot_ver = hh{QoreDebugWsProtocolHeader.lwr()};
        if (!prot_ver.val()) {
            throw "QORE-DEBUG", sprintf("Connected to %y, but no %y header received in response; check the URI path "
                "and try again", url, QoreDebugWsProtocolHeader);
        }
        if (prot_ver != QoreDebugProtocolVersion) {
            throw "QORE-DEBUG", sprintf("Qore debug server at %y claims unsupported protocol version %y; expecting "
                "%y", url, prot_ver, QoreDebugProtocolVersion);
        }
        *auto resp = sync.waitForResponse(wscTimeout);
        if (!exists resp) {
            throw "QORE-DEBUG", "No response from debug server";
        } else {
            serverName = resp.result;
        }
    }

    public wscEvent(*data msg) {
        debug("received: %y", msg);
        if (!exists msg) {
            return;
        }
        try {
            auto d = parse_yaml(msg);
            if (d.typeCode() != NT_HASH) {
                error("wscEvent: received non-hash data, ignoring");
                return;
            }
            if (sync.isPending()) {
                if (((d.type == DebugResponseType::Response || d.type == DebugResponseType::Error) && pendingUid == d.uid && !connecting) ||
                    (d.type == DebugResponseType::Event && d.cmd == DebugEventCmd::Welcome && connecting)) {
                    sync.deliver(d);
                    connecting = False;
                    return;
                }
            }
            printData(d);
            eventReceived(d);
            processEvent(d);
        } catch (hash<ExceptionInfo> ex) {
            error("wscEvent: %s", get_exception_string(ex));
        }
    }
}

class DebugWrapper {
    private {
        hash<auto> opts = (
            'help': 'h,help',
            'verbose': 'v,verbose:+',
            'url': 'u,url=s',
            'max_redirects': 'm,max-redir=i',
            'header': 'H,header=s@',
            'proxy': 'P,proxy=s',
            'timeout': 't,timeout=i',
            'connect_timeout': 'c,conn-timeout=i',
            'response_timeout': 'w,resp-timeout=i',
            "history": "y,history=s",
            "session": "s,session=s",
            "color": "color",
            "no_color": "no-color",
        );
        DebugCommandLineRemote dcl;
        Logger logger;
    }

    constructor() {
        hash<auto> opt;
        try {
            GetOpt g(opts);
            list<auto> a = ARGV;
            opt = g.parse2(\a);
            # the help is shown without a URL
            if (opt.help) {
                help();
            }
            opt.url = shift a;
            if (a) {
                throw "GETOPT-ERROR", "Only one URL can be specified";
            }
            if (!exists opt.url) {
                throw "GETOPT-ERROR", "the URL of the debug server is missing";
            }
            *string path_suffix;
            string orig_url = opt.url;
            try {
                # check if it's in "connection_name/path" format
                *list<auto> l = opt.url =~ x/^([A-Za-z_\-0-9]+)\/([A-Za-z_\-0-9\.]+)$/;
                if (l) {
                    opt.url = get_connection_url(l[0]);
                    path_suffix = l[1];
                } else {
                    opt.url = get_connection_url(opt.url);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "CONNECTION-ERROR") {
                    rethrow;
                }
                if (opt.url !~ /:\/\// && opt.url !~ /:/ && opt.url !~ /\//) {
                    throw "CONNECTION-ERROR", sprintf("URL %y is not a valid URL and no connection can be found with "
                        "this name; connection providers searched (QORE_CONNECTION_PROVIDERS env var): %y", opt.url,
                        ENV.QORE_CONNECTION_PROVIDERS);
                }
            }
            if (orig_url != opt.url) {
                if (opt.url =~ /^https?:\/+[^\/]+$/) {
                    # use "debug" path if none present
                    opt.url += "/debug";
                }
                if (path_suffix.val()) {
                    if (opt.url !~ /\/$/) {
                        opt.url += "/";
                    }
                    opt.url += path_suffix;
                }
                if (opt.url =~ /^https?:/) {
                    opt.url =~ s/^http/ws/;
                }
                if (opt.verbose) {
                    stderr.printf("Using connection %y url: %y\n", orig_url, opt.url);
                }
            }
            switch (opt.url) {
            case /^wss?:\/\//:
                break;
            case /^[a-zA-Z0-9_]+:\/\//:
                throw "GETOPT-ERROR", sprintf("the URL %y must start with ws:// or wss://", opt.url);
            default:
                opt.url = "ws://"+opt.url;
            }
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("%s: %s\n", ex.err, ex.desc);
            help(-1);
        }

        if (opt.help) {
            help();
        }
        logger = new Logger();
        logger.addAppender(new LoggerAppenderStdErr("stderr", new LoggerLayoutPattern("%d{YYYY-MM-DD HH:mm:SS.xx} T%t [%p]: %m%n")));
        if (opt.verbose) {
            if (opt.verbose == 1) {
                logger.setLevel("INFO");
            } else if (opt.verbose == 2) {
                logger.setLevel("DEBUG");
            } else if (opt.verbose == 3) {
                logger.setLevel("TRACE");
            } else {
                logger.setLevel("ALL");
            }
        } else {
            logger.setLevel("WARN");
        }
        logger.info("url: %s verbose: %s", opt.url, logger.getLevel().getStr());
        dcl = new DebugCommandLineRemote(opt + {"logger": logger});
        # signal handler for clean WebSocket shutdown
        code sig_handler = sub (int sig) {
            try {
                dcl.wsc.disconnect();
            } catch () {
                # suppress exceptions during signal-triggered disconnect
            }
        };
        set_signal_handler(SIGINT, sig_handler);
        set_signal_handler(SIGTERM, sig_handler);
        try {
            dcl.connect();
            # unconditional connection message
            stdout.printf("connected to debug server %y: %s; \"help\" for help\n", opt.url, dcl.serverName);
            # the debugged programs, and the threads that are stopped, such as the thread of a program that the server
            # holds at its start
            *hash<auto> sess = dcl.doCommandImpl({'cmd': 'session/get'});
            if (sess.result) {
                string pgmId = sess.result.firstKey();
                dcl.setContextValue('programId', pgmId);
                if (sess.result{pgmId}.interrupted) {
                    dcl.setContextValue('threadId', sess.result{pgmId}.interrupted[0]);
                }
            }
            dcl.init(opt);
            # each command of a script is processed when the program is stopped
            dcl.waitsForStops = !stdin.isTty();
            dcl.runCmdLine();
            dcl.wsc.disconnect();
        } catch (hash<ExceptionInfo> e) {
            stderr.printf("%s: %s\n", e.err, e.desc);
            exit(-1);
        }
        # remove signal handlers before exit so their closures release
        # references to dcl; otherwise dcl is destroyed during program
        # shutdown when module programs may already be deleted
        remove_signal_handler(SIGINT);
        remove_signal_handler(SIGTERM);
    }

    private help(int exCode=1) {
        printf(
            "usage: %s [options] <url>\n"
            "       %s [options] <connection>[/<path>]\n"
            "Debugs the programs of a debug server, such as qdbg-server, in the terminal.  Type \"help\" at the prompt\n"
            "for all commands.\n"
            "\n"
            "  <url>                        the URL of the debug server, such as localhost:8001 or\n"
            "                               wss://myhost:8001/debug; ws:// is added when it has no scheme; for a UNIX\n"
            "                               socket: ws://socket=<URL-encoded path of the socket>/<path>\n"
            "  <connection>                 the name of a connection (QORE_CONNECTION_PROVIDERS) to the debug server;\n"
            "                               http and https in its URL are changed to ws and wss, the path /debug is\n"
            "                               added when the URL has no path, and <path> is added to the URL\n"
            "\n"
            "  -h                           show this help\n"
            "  -v                           show more details of what the debugger does; repeat for more (-v -v)\n"
            "  -H, --header=<name>=<value>  add an HTTP header to the connection, such as\n"
            "                               -H \"Authorization=Bearer <token>\" for a server that requires a token\n"
            "  -m, --max-redir=<number>     the maximum number of HTTP redirects; the default is 5\n"
            "  -P, --proxy=<url>            connect through an HTTP proxy\n"
            "  -t, --timeout=<ms>           how long reading from or writing to the connection may take, in\n"
            "                               milliseconds\n"
            "  -c, --conn-timeout=<ms>      how long opening the connection may take, in milliseconds\n"
            "  -w, --resp-timeout=<ms>      how long to wait for the answer of the debug server to a command, in\n"
            "                               milliseconds; the default is %d\n"
            "  -y, --history=file           the file of the commands that the up and down arrow keys recall; the\n"
            "                               default is %s in the home folder; \".\" keeps no history\n"
            "  -s, --session=file           load the breakpoints and settings that \"session save\" saved to a file\n"
            "  --color, --no-color          always or never show colors; by default, colors are shown in a terminal\n"
            "\n"
            "When the input is not a terminal, it is a script of commands: each command that resumes a thread waits\n"
            "until the thread pauses again or ends.\n"
            "\n"
            "Keys:\n"
            "  Ctrl+D                       end the debugger\n"
            "  Ctrl+G                       show the current program and thread\n"
            "  Tab                          complete a command (press again for the next match)\n"
            "\n"
            "Examples:\n"
            "  %s localhost:8001\n"
            "  %s -H \"Authorization=Bearer s3cret\" myhost:8001\n"
            "  %s qorus/qjob-test_v1.0-1\n"
            "\n"
            ,
            get_script_name(),
            get_script_name(),
            DebugCommandLineRemote::WSC_TIMEOUT.durationMilliseconds(),
            DebugLinenoiseCommandLine::defaultHistoryFileName,
            get_script_name(),
            get_script_name(),
            get_script_name(),
        );
        exit(exCode);
    }

    public dummy() {
    }
}
