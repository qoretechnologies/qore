#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-debugger
%no-debugging

%requires qore >= 2.0
%requires HttpServer
%requires DebugProgramControl
%requires DebugHandler
%requires Logger

%exec-class DebugWrapper

class WebSocketDebugProgramControlHost inherits WebSocketDebugProgramControl {
    public {
        DebugWrapper dw;
    }
    constructor(DebugWrapper n_dw, *Logger::LoggerInterface logger) : WebSocketDebugProgramControl("qdb-server v1.0", logger) {
        dw = n_dw;
    }
}

#! authenticates the clients of the debug server with a token, given as a bearer token in the \c Authorization header
class TokenAuthenticator inherits AbstractAuthenticator {
    private:internal {
        binary token;
    }

    constructor(string token) {
        self.token = binary(token);
    }

    *hash<HttpResponseInfo> authenticateRequest(HttpListenerInterface listener, hash<auto> hdr,
            reference<hash<auto>> cx) {
        *string auth = hdr.authorization;
        *list<*string> m = auth ? (auth =~ x/^Bearer\s+(.+)$/i) : NOTHING;
        if (!m || !TokenAuthenticator::equalTokens(binary(trim(m[0])), token)) {
            return <HttpResponseInfo>{
                "code": 401,
                "body": "a valid token of the debug server is required",
                "hdr": {"WWW-Authenticate": "Bearer realm=\"qdbg-server\""},
            };
        }
    }

    #! Compares tokens in a time that does not depend on where they differ
    static bool equalTokens(binary a, binary b) {
        if (a.size() != b.size()) {
            return False;
        }
        int diff = 0;
        int len = a.size();
        for (int i = 0; i < len; ++i) {
            diff |= a[i] ^ b[i];
        }
        return !diff;
    }
}

#! writes the log of the server to the original stdout or stderr, so that it is not sent to clients as the output of
#! the program
class ServerLogAppender inherits LoggerAppenderWithLayout {
    private:internal {
        DebugWrapper dw;
        bool err;
    }

    constructor(string name, DebugWrapper dw, bool err)
            : LoggerAppenderWithLayout(name, new LoggerLayoutPattern("%d{YYYY-MM-DD HH:mm:SS.xx} T%t [%p]: %m%n")) {
        self.dw = dw;
        self.err = err;
        open();
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
                dw.getLogFile(err).print(params);
                break;
        }
    }
}

class DebugWrapper {
    private {
        hash<auto> opts = (
            'help': 'h,help',
            'verbose': 'v,verbose:+',
            'listen': 'l,listen=s@',
            'path': 'p,path=s',
            'token_file': 'k,token-file=s',
        );
        Logger logger;
        WebSocketDebugHandler wsHandler;
        HttpServer mServer;
        *WebSocketDebugProgramControlHost dpc;
    }

    constructor() {
        WrapperGetOpt g(opts);
        # first we need split debug args and program args, 'qore-dbg debug-args program-name program-args'
        # it is not trivial, e.g.
        #    qore-dbg -v -l xxx xxx     #the second xxx is program name
        #   qore-dbg -v -h xxx xxx     #the first xxx is program name
        #    qore-dbg -v --listen=xxx xxx     #the second xxx is program name
        #    qore-dbg -v --listen xxx xxx     #the second xxx is program name
        # GetOpt does not support such a parse function
        #
        list<auto> dargs;
        hash<auto> opt;
        *string fileName;
        g.split(cast<list<string>>(ARGV), \dargs, \fileName, \ARGV);

        try {
            opt = g.parse2(\dargs);
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("%s: %s\n", ex.err, ex.desc);
            help(-1);
        }

        if (opt.help) {
            help();
        }

        logger = new Logger();
        logger.addAppender(new ServerLogAppender("stderr", self, True));
        if (opt.verbose > 1) {
            logger.setLevel("DEBUG");
        } else if (opt.verbose) {
            logger.setLevel("INFO");
        } else {
            logger.setLevel("ERROR");
        }
        try {
            logger.debug("create DebugProgram");
            dpc = new WebSocketDebugProgramControlHost(self, logger);
            logger.debug("create WebSocketDebugHandler");
            # the token of the clients, from a file or the environment, as the arguments of a process can be read by
            # other users
            *string token = opt.token_file
                ? trim(ReadOnlyFile::readTextFile(opt.token_file))
                : ENV.QDBG_SERVER_TOKEN;
            if (exists token && !token.val()) {
                throw "QDBG-SERVER-ERROR", "the token of the debug server is empty";
            }
            AbstractWebSocketDebugHandler wsHandler = new WebSocketDebugHandler(dpc,
                token ? new TokenAuthenticator(token) : NOTHING, {"logger": logger});

            logger.debug("create HttpServer");

            Logger http_logger("my-logger", LoggerLevel::getLevelInfo());
            if (opt.verbose > 1) {
                http_logger.addAppender(new ServerLogAppender("stdout", self, False));
            }
            hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
                "logger": http_logger,
                "debug": True,
            };
            mServer = new HttpServer(http_opts);
            mServer.setHandler("ws-handler", opt.path ?? "", wsHandler.getContentType(), wsHandler);
            mServer.setDefaultHandler("ws-handler", wsHandler);
            if (opt.listen) {
                foreach string l in (opt.listen) {
                    mServer.addListener(http_get_listener_options_from_bind(l));
                    logger.info("started debug server listener: %s", l);
                    # a client can evaluate expressions and change the program, so a server that other hosts can
                    # reach should require a token
                    if (!token && l !~ /^(\/|127\.|localhost:|\[::1\]:)/) {
                        stderr.printf("WARNING: the debug server listens on %y without a token; any client that can "
                            "reach it can debug the program (see -k)\n", l);
                    }
                }
            } else {
                # only local clients by default
                int port = mServer.addListener(http_get_listener_options_from_bind("127.0.0.1:0")).port;
                stdout.printf("debug server listening on port %d\n", port);
            }

            # the output of the debugged programs is sent to the clients and written to the terminal
            dpc.captureOutput();
            if (exists fileName) {
                Program pgm = dpc.createProgram(fileName, opt, ARGV);
                logger.info("run program");
                background sub () {
                    # all output of the program is sent before the server ends with it
                    on_exit dpc.stopOutputCapture();
                    pgm.run();
                }();
            }
            # signal handler for graceful shutdown
            code sig_handler = sub (int sig) {
                dpc.stopOutputCapture();
                dpc.shutdown();
                dpc.waitForTerminationAndClear();
                mServer.stop();
                # remove signal handlers so their closures release references
                # to dpc/mServer before program shutdown
                remove_signal_handler(SIGINT);
                remove_signal_handler(SIGTERM);
            };
            set_signal_handler(SIGINT, sig_handler);
            set_signal_handler(SIGTERM, sig_handler);
            # background or http server uses own thread, loop
        } catch (hash<ExceptionInfo> ex) {
            # the original stderr, as the output of the process can be captured for the clients; the call stack of
            # the error with -v
            File err = getLogFile(True);
            if (opt.verbose) {
                err.printf("%s\n", get_exception_string(ex));
            } else {
                err.printf("%s: error: %s (%s)\n", get_script_name(), ex.desc, ex.err);
            }
            exit(-1);
        }
    }

    public httplog(string fmt, ...) {
        logger.logArgs(LoggerLevel::INFO, fmt, argv);
    }

    public httperr(string fmt, ...) {
        stderr.vprintf(fmt, argv);
    }

    #! Returns the file that the log of the server is written to: the original stdout or stderr
    File getLogFile(bool err) {
        *DebugOutputCapture capture = dpc ? dpc.getOutputCapture() : NOTHING;
        if (err) {
            return capture ? capture.getStderr() : stderr;
        }
        return capture ? capture.getStdout() : stdout;
    }

    private help(int exCode=1) {
        printf("usage: %s [options] [<script> [<script arguments> ...]]\n"
            "Runs a Qore script with a debug server, so that debuggers such as qdbg-remote and Visual Studio Code can\n"
            "connect to it and debug it.  The output of the script is shown here and sent to the debuggers.\n"
            "\n"
            "  <script>                     the script to debug; /dev/stdin reads it from the standard input\n"
            "\n"
            "  -h                           show this help\n"
            "  -v                           show more details of what the server does; -v -v shows all of them\n"
            "  -l, --listen=<addr:port>     where the server listens for debuggers; can be given more than once; a\n"
            "                               port without an address listens on all network interfaces, and a path\n"
            "                               that starts with \"/\" is a UNIX socket; by default, the server listens on\n"
            "                               a free port of 127.0.0.1 (this machine only) and shows the port\n"
            "  -p, --path=<path>            the URL path of the debug server, such as \"debug\"; by default, any path\n"
            "  -k, --token-file=<file>      require the token in the file from the debuggers, which send it in the\n"
            "                               HTTP header \"Authorization: Bearer <token>\"; the QDBG_SERVER_TOKEN\n"
            "                               environment variable can give the token instead\n"
            "\n"
            "A debug server lets its debuggers run code in the script, so a server that listens on other network\n"
            "interfaces than 127.0.0.1 should require a token.\n"
            "\n"
            "Example:\n"
            "  %s -l 0.0.0.0:8001 -k token.txt myscript.q arg1 arg2\n"
            "\n"
            ,
            get_script_name(),
            get_script_name()

        );
        exit(exCode);
    }

    public dummy() {
    }
}
