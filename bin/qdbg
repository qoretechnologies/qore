#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires linenoise
%requires qore >= 2.0
%requires DebugCmdLine
%requires DebugLinenoiseCmdLine
%requires DebugProgramControl
%requires Util
%requires Logger

%allow-debugger
%no-debugging

%exec-class DebugWrapper

class DebugCommandLineLocal inherits DebugLinenoiseCommandLine {
    public {
        DebugProgramControlLocal dpc;
        ResponseSync sync();
        #! gives the commands sent to stopped threads their unique IDs
        Sequence uidSeq();
    }

    private {
        #! serializes the commands sent to stopped threads, as their responses are delivered one at a time; the
        #! commands of stopping all threads together are sent in background threads
        Mutex cmdLock();
    }
    constructor(DebugProgramControlLocal n_dpc): DebugLinenoiseCommandLine() {
        dpc = n_dpc;
        dpc.dcl = self;
    }
    public *hash<auto> doCommandImpl(hash<auto> data) {
        if (!exists data.tid) {
            return dpc.processCommand(DebugProgramControlLocal::CX, data);
        }
        # a command that resumes the thread returns when it stops again; the wait starts before the command is sent,
        # as the thread can stop again before the answer to the command is received
        # a command with "wait" False, as of the threads that continue with another one, does not wait
        bool resumes = resumesWithWait(data);
        if (resumes) {
            expectStop(data.tid);
        }
        on_error if (resumes) {
            cancelStop();
        }
        *hash<auto> ret;
        {
            AutoLock al(cmdLock);
            # the stopped thread answers every command, with the unique ID of the command
            data.uid = string(uidSeq.next());
            sync.prepare(data.uid);
            on_error sync.cancel();
            ret = dpc.processCommand(DebugProgramControlLocal::CX, data);
            if (ret.type == DebugResponseType::Thread) {
                ret = sync.waitForResponse();
            } else {
                # answered without the thread, such as a thread that is not stopped
                sync.cancel();
            }
        }
        if (resumes) {
            if (ret.type == DebugResponseType::Error) {
                cancelStop();
            } else {
                waitForStop();
            }
        }
        return ret;
    }
}

class DebugProgramControlLocal inherits DebugProgramControl {
    public {
        DebugCommandLineLocal dcl;
    }
    const CX = ('id': 1);
    constructor () : DebugProgramControl(QORE_ARGV[0]) {
        registerConnection(CX);
    }
    destructor() {
        try {
            unregisterConnection(CX);
        } catch () {
            # suppress exceptions during program shutdown (PROGRAM-ERROR)
        }
    }
    public nothing sendDataImpl(hash<auto> cx, any data) {    # TODO: nothing needed. why? I cannot reproduce in simple case to report issue
        debug("sendDataImpl: %y: %y", cx, data);
        if (!dcl.sync.deliver(data)) {
            dcl.printData(data);
        }
    }
    #! Ends debugging: the programs are no longer debugged, and their stopped threads continue
    /** The programs are removed first, so that a thread that continues does not stop again, as at the end of a
        program, with nobody to resume it
    */
    endDebugging() {
        map removeProgram($1), getAllPrograms();
        shutdown();
    }

    public nothing broadcastDataImpl(any data) {
        debug("broadcastDataImpl: %y", data);
        dcl.printData(data);
        if (data.typeCode() == NT_HASH) {
            # the state of the threads is updated before a command that waits for the event continues
            dcl.processEvent(data);
            dcl.eventReceived(data);
        }
    }
}

class DebugWrapper {
    private {
        hash<auto> opts = (
            'help': 'h,help',
            'verbose': 'v,verbose:+',
            'run': 'r,run',
            "parse_option": "p,set-parse-option=s@",
            #"charset": "c,charset=s",
            "define": "D,define=s@",
            "time_zone": "z,time-zone=s",
            #"exec_class": "x,exec-class:s",
            "history": "y,history=s",
            "session": "s,session=s",
            "color": "color",
            "no_color": "no-color",
        );
        DebugCommandLineLocal dcl;
        Logger logger;
    }

    constructor() {
        WrapperGetOpt g(opts);
        # first we need split debug args and program args, 'qore-dbg debug-args program-name program-args'
        # it is not trivial, e.g.
        #    qore-dbg -v -l xxx xxx         #the second xxx is program name
        #    qore-dbg -v -h xxx xxx         #the first xxx is program name
        #    qore-dbg -v --listen=xxx xxx   #the second xxx is program name
        #    qore-dbg -v --listen xxx xxx   #the second xxx is program name
        # GetOpt does not support such a parse function
        #
        list<auto> dargs;
        hash<auto> opt;
        *string fileName;
        g.split(cast<list<string>>(ARGV), \dargs, \fileName, \ARGV);

        try {
            opt = g.parse2(\dargs);
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("%s: %s\n", ex.err, ex.desc);
            help(-1);
        }

        if (opt.help) {
            help();
        }
        logger = new Logger();
        logger.addAppender(new LoggerAppenderStdErr("stderr", new LoggerLayoutPattern("%d{YYYY-MM-DD HH:mm:SS.xx} T%t [%p]: %m%n")));
        if (opt.verbose > 1) {
            logger.setLevel("DEBUG");
        } else if (opt.verbose) {
            logger.setLevel("INFO");
        } else {
            logger.setLevel("ERROR");
        }
        DebugProgramControlLocal dpcl();
        dcl = new DebugCommandLineLocal(dpcl);
        dcl.setLogger(logger);
        dcl.dpc.setLogger(logger);
        # signal handler for graceful shutdown
        code sig_handler = sub (int sig) {
            dpcl.endDebugging();
        };
        set_signal_handler(SIGINT, sig_handler);
        set_signal_handler(SIGTERM, sig_handler);
        try {
            if (fileName == "--") {
                fileName = "/dev/stdin";
            }
            # with input that is not a terminal (a script), the commands are processed when the program is stopped
            # each command of a script is processed when the program is stopped
            dcl.waitsForStops = !stdin.isTty();
            if (exists fileName) {
                Program pgm = dcl.dpc.createProgram(fileName, opt, ARGV);
                logger.info("run program");
                if (dcl.waitsForStops) {
                    # the first command is processed when the program has attached to the debugger
                    dcl.expectStop();
                }
                background sub () {
                    # a wait for the program ends with it
                    on_exit dcl.cancelStop();
                    try {
                        pgm.run();
                    } catch (hash<ExceptionInfo> ex) {
                        # a program that the debugger ended ("kill"); the thread is no longer cancelled
                        if (DebugProgramControl::isTerminateException(ex)) {
                            clear_thread_cancel();
                            return;
                        }
                        rethrow;
                    }
                }();
            }
            dcl.init(opt);
            if (dcl.waitsForStops) {
                dcl.waitForStop();
            }
            dcl.runCmdLine();

            # explicit cleanup before program exit to avoid PROGRAM-ERROR
            # in destructors when module programs are destroyed first
            dpcl.endDebugging();
        } catch (hash<ExceptionInfo> ex) {
            # the call stack of the error with -v
            if (opt.verbose) {
                stderr.printf("%s\n", get_exception_string(ex));
            } else {
                stderr.printf("%s: error: %s (%s)\n", get_script_name(), ex.desc, ex.err);
            }
            exit(-1);
        }
        # remove signal handlers before exit so their closures release
        # references to dpcl; otherwise dpcl is destroyed during program
        # shutdown when module programs may already be deleted
        remove_signal_handler(SIGINT);
        remove_signal_handler(SIGTERM);
    }

    private help(int exCode=1) {
        printf("usage: %s [options] [<script> [<script arguments> ...]]\n"
            "Debugs a Qore script in the terminal.  The script pauses when it starts; then commands such as\n"
            "\"break create <line>\" (pause at a line) and \"go\" (continue) control it.  Type \"help\" at the prompt for\n"
            "all commands.\n"
            "\n"
            "  <script>                     the script to debug; \"--\" reads it from the standard input\n"
            "\n"
            "  -h                           show this help\n"
            "  -v                           show more details of what the debugger does; -v -v shows all of them\n"
            "  -D, --define=name[=value]    set a parse define of the script\n"
            "  -p, --set-parse-option=opt   set a parse option of the script, such as -pno-database\n"
            "  -z, --time-zone=zone         the time zone of the script: a region name, such as Europe/Prague, or a\n"
            "                               UTC offset, such as +01:00\n"
            "  -y, --history=file           the file of the commands that the up and down arrow keys recall; the\n"
            "                               default is %s in the home folder; \".\" keeps no history\n"
            "  -s, --session=file           load the breakpoints and settings that \"session save\" saved to a file\n"
            "  --color, --no-color          always or never show colors; by default, colors are shown in a terminal\n"
            "\n"
            "When the input is not a terminal, it is a script of commands: the first command runs when the script\n"
            "pauses at its start, and a command that resumes a thread waits until the thread pauses\n"
            "again or ends.\n"
            "\n"
            "Keys:\n"
            "  Ctrl+D                       end the debugger\n"
            "  Ctrl+G                       show the current program and thread\n"
            "  Tab                          complete a command (press again for the next match)\n"
            "\n"
            "Example:\n"
            "  %s myscript.q arg1 arg2\n"
            "\n"
            ,
            get_script_name(),
            DebugLinenoiseCommandLine::defaultHistoryFileName,
            get_script_name(),
        );
        exit(exCode);
    }


    public dummy() {
    }
}
