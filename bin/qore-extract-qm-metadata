%modern
%requires QoreApiMetadata

#! Extract metadata from a Qore source file and output as JSON
/**
    Usage: qore-extract-qm-metadata <source-file> [output-file]

    If output-file is not specified, writes to stdout.
*/

if (!ARGV[0]) {
    stderr.printf("Usage: %s <source-file> [output-file]\n", get_script_name());
    exit(1);
}

string source_file = ARGV[0];
if (!is_readable(source_file)) {
    stderr.printf("ERROR: cannot read file: %s\n", source_file);
    exit(1);
}

hash<QoreApiMetadata::NamespaceInfo> metadata =
    QoreApiMetadata::fromSourceFile(source_file);
string json = QoreApiMetadata::toJson(metadata);

if (ARGV[1]) {
    File f();
    f.open2(ARGV[1], O_CREAT | O_WRONLY | O_TRUNC);
    f.write(json);
} else {
    print(json);
}
