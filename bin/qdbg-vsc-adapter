#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires qore >= 2.0
%requires VscDebugAdapter
%requires DebugProgramControl >= 0.1.2

%requires WebSocketClient
%requires yaml >= 0.5
%requires ConnectionProvider

%allow-debugger
%no-debugging

%exec-class DebugWrapper

string sub get_full_log_file_path(string ext) {
    if (PlatformOS == "Windows") {
        return getenv("APPDATA") + DirSep + "QoreDebugAdapter" + DirSep + "qda" + ext;
    } else {
        return getenv("HOME") + DirSep + ".qoredebugadapter" + ext;
    }
}

sub printErr(string fmt) {
    string s = vsprintf(fmt, argv)+"\r\n";
    stderr.print(s);
%ifdef VDA_EARLY_LOG
    # in case of an exception when starting adapter the VSC does not print stderr output
    # so get what is wrong is pain, intended to be uncommented only when required
    # Infamous "Debug adapter process has terminated unexpectedly" is such a case
    File f();
    f.open(get_full_log_file_path(".stderr"), O_WRONLY|O_APPEND|O_CREAT);  # no O_TRUNC
    f.printf("[pid %d] %s", getpid(), s);
    f.close();
%endif
}

class VscDebugAdapterLocal inherits VscDebugAdapter {
    public {
        DebugProgramControlLocal dpc;
        ResponseSync sync();
        #! gives the commands sent to stopped threads their unique IDs
        Sequence uidSeq();
        *hash<auto> programOpts;
    }
    constructor(Logger logger, DebugProgramControlLocal n_dpc, hash<auto> opts) : VscDebugAdapter(logger) {
        dpc = n_dpc;
        dpc.vda = self;
        programOpts = opts;
    }
    public *hash<auto> doCommandImpl(hash<auto> data) {
        if (!exists data.tid) {
            return dpc.processCommand(DebugProgramControlLocal::CX, data);
        }
        # the stopped thread answers every command, with the unique ID of the command
        data.uid = string(uidSeq.next());
        sync.prepare(data.uid);
        on_error sync.cancel();
        *hash<auto> ret = dpc.processCommand(DebugProgramControlLocal::CX, data);
        if (ret.type == DebugResponseType::Thread) {
            return sync.waitForResponse();
        }
        # answered without the thread, such as a thread that is not stopped
        sync.cancel();
        return ret;
    }
}

class DebugProgramControlLocal inherits DebugProgramControl {
    public {
        VscDebugAdapterLocal vda;
    }
    const CX = ('id': 1);
    constructor(*Logger::LoggerInterface logger) : DebugProgramControl(QORE_ARGV[0], logger) {
        registerConnection(CX);
    }
    destructor() {
        try {
            unregisterConnection(CX);
        } catch () {
            # suppress exceptions during program shutdown (PROGRAM-ERROR)
        }
    }
    public sendDataImpl(hash<auto> cx, auto data) {
        logger.debug("sendDataImpl: %y: %y", cx, data);
        if (!vda.sync.deliver(data)) {
            vda.pushEvent(data);
        }
    }
    public broadcastDataImpl(auto data) {
        logger.debug("broadcastDataImpl: %y", data);
        vda.pushEvent(data);
    }
}

class VscDebugAdapterRemote inherits VscDebugAdapter {
    const WSC_TIMEOUT = 1500ms;
    public {
        ResponseSync sync();
        int pendingUid;
        WebSocketClient wsc;
        timeout wscTimeout;
        bool connecting;
        string serverName;
        string url;
        *hash<auto> headers;
        #! the error connecting to the debug server, which the requests of the IDE are answered with
        *hash<ExceptionInfo> connectError;
        #! True when the adapter closes the connection itself
        bool closing;
    }

    constructor(hash<auto> opts, *Logger::LoggerInterface logger) : VscDebugAdapter(logger) {
        wscTimeout = opts.response_timeout ?? WSC_TIMEOUT;
        opts.log = \wscLog();
        opts.errlog = \wscErr();
        opts.debuglog = \wscDebug();
        url = opts.url;
        if (opts.header) {
            foreach string h in (opts.header) {
                *list<string> rv = regex_extract(h, "^([a-zA-Z0-9\\-]+)=(.*)$");
                if (!rv) {
                    throw "GETOPT-ERROR", sprintf("Wrong header specification %y", h);
                }
                headers{rv[0]} = rv[1];
            }
        }
        wsc = new WebSocketClient(\wscEvent(), opts);
    }

    public *hash<auto> doCommandImpl(hash<auto> data) {
        if (connectError) {
            throw "DEBUG-CONNECT-ERROR", sprintf("cannot connect to the debug server at %s: %s: %s", url,
                connectError.err, connectError.desc);
        }
        pendingUid = clock_getmicros();
        data.uid = pendingUid;
        string d = make_yaml(data);
        sync.prepare();
        logger.debug("send: %y", d);
        wsc.send(d);
        return sync.waitForResponse(wscTimeout);
    }

    public nothing connect() {
        connecting = True;
        sync.prepare();
        hash<auto> hh = wsc.connect({"hdr": headers});
        *string prot_ver = hh{QoreDebugWsProtocolHeader.lwr()};
        if (!prot_ver.val()) {
            throw "QORE-DEBUG", sprintf("Connected to %y, but no %y header received in response; check the URI path "
                "and try again", url, QoreDebugWsProtocolHeader);
        }
        if (prot_ver != QoreDebugProtocolVersion) {
            throw "QORE-DEBUG", sprintf("Qore debug server at %y claims unsupported protocol version %y; expecting "
                "%y", url, prot_ver, QoreDebugProtocolVersion);
        }
        *auto resp = sync.waitForResponse(wscTimeout);
        if (!exists resp) {
            throw "QORE-DEBUG", "No response from debug server";
        } else {
            serverName = resp.result;
        }
    }

    public wscEvent(*data msg) {
        logger.debug("received: %y", msg);
        if (!exists msg) {
            # the debug server closed the connection: the session ends
            if (!connecting && !closing) {
                serverClosed(sprintf("the connection to the debug server at %s was closed", url));
            }
            return;
        }
        try {
            auto d = parse_yaml(msg);
            if (d.typeCode() != NT_HASH) {
                wscErr("wscEvent: received non-hash data, ignoring");
                return;
            }
            if (sync.isPending()) {
                if (((d.type == DebugResponseType::Response || d.type == DebugResponseType::Error) && pendingUid == d.uid && !connecting) ||
                    (d.type == DebugResponseType::Event && d.cmd == DebugEventCmd::Welcome && connecting)) {
                    sync.deliver(d);
                    connecting = False;
                    return;
                }
            }
            # the event is handled for the IDE; it is not written to the debug console
            pushEvent(d);
        } catch (hash<ExceptionInfo> ex) {
            wscErr(sprintf("wscEvent: %Y", ex));
        }
    }

    public wscLog(string s) {
        logger.info(s);
    }

    public wscDebug(string s) {
        logger.debug(s);
    }

    public wscErr(string s) {
        logger.info(s);
    }
}

class DebugWrapper {
    private {
        hash<auto> opts = (
            'help': 'h,help',
            'verbose': 'v,verbose:+',
            'full_exception': 'f,full-exception',
            #'run': 'r,run',
            "parse_option": "p,set-parse-option=s@",
            #"charset": "c,charset=s",
            "define": "D,define=s@",
            "time_zone": "z,time-zone=s",
            #"exec_class": "x,exec-class:s",
            "logfile": "l,logger-filename=s",
            "append_to_log": "A,append-to-log",
            "program": "g,program=s",
            # for attach
            'url': 'a,attach=s',
            'header': 'H,header=s@',
            'max_redirects': 'm,max-redir=i',
            'proxy': 'P,proxy=s',
            'timeout': 't,timeout=i',
            'connect_timeout': 'c,conn-timeout=i',
            'response_timeout': 'w,resp-timeout=i',
            # exec command
            'execute': 'X,execute=s',

        );
        VscDebugAdapter vda;
        VscDebugLogger logger;
    }

    constructor() {
        GetOpt g(opts);
        hash<auto> opt;
        try {
            opt = g.parse2(\ARGV);
        } catch (hash<ExceptionInfo> ex) {
            printErr("QORE_ARGV: %y", QORE_ARGV);
            printErr("ARGV: %y", ARGV);
            printErr("%s: %s", ex.err, ex.desc);
            help(-1);
        }

        if (opt.help) {
            help();
        }
        # the log is also shown in the debug console of the IDE unless it is written to a given file
        bool log_to_console = opt.verbose && !exists opt.logfile;
        if (!opt.verbose) {
            remove opt.logfile;
        } else if (!exists opt.logfile) {
            opt.logfile = get_full_log_file_path(".log");
        }
        logger = new VscDebugLogger(opt.logfile, opt.append_to_log === True);
        if (opt.verbose) {
            logger.setLevel("DEBUG");
        }
        logger.info("Adapter arguments: %y", QORE_ARGV);
        try {
            if (opt.url) {
                trim opt.url;
                string orig_url = opt.url;
                try {
                    opt.url = get_connection_url(opt.url);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "CONNECTION-ERROR") {
                        rethrow;
                    }
                    if (opt.url !~ /:\/\//) {
                        throw "CONNECTION-ERROR", sprintf("URL %y is not a valid URL and no connection can be found with this name; connection providers searched (QORE_CONNECTION_PROVIDERS env var): %y", opt.url, ENV.QORE_CONNECTION_PROVIDERS);
                    }
                }
                if (orig_url != opt.url) {
                    if (opt.url =~ /^https?:\/+[^\/]+$/) {
                        # use "debug" path if none present
                        opt.url += "/debug";
                    }
                    if (opt.url =~ /^https?:/) {
                        opt.url =~ s/^http/ws/;
                    }
                    logger.info("Using connection %y url: %y\n", orig_url, opt.url);
                }
                switch (opt.url) {
                case /^wss?:\/\//:
                    break;
                case /^[a-zA-Z0-9_]+:\/\//:
                    throw "GETOPT-ERROR", sprintf("the URL %y must start with ws:// or wss://", opt.url);
                default:
                    opt.url = "ws://"+opt.url;
                }
                logger.debug("Connection url: %s", opt.url);
                logger.debug("Create VscDebugAdapterRemote(%y) instance", opt.url);
                vda = new VscDebugAdapterRemote(opt);
            } else {
                logger.debug("Create DebugProgramControlLocal instance");
                DebugProgramControlLocal dpcl(logger);
                logger.debug("Create VscDebugAdapterLocal instance");
                vda = new VscDebugAdapterLocal(logger, dpcl, opt);
            }
            vda.showFullException = exists opt.full_exception;
            vda.setLogger(logger);
            vda.defaultProgram = opt.program;
            if (log_to_console) {
                logger.debugAdapter = vda;
            }

            if (vda instanceof VscDebugAdapterRemote) {
                logger.debug("Connect remote adapter");
                try {
                    cast<VscDebugAdapterRemote>(vda).connect();
                } catch (hash<ExceptionInfo> ex) {
                    # a command is executed only with a connection; the IDE is answered with the error, so that it
                    # can show it, instead of the adapter ending without an answer
                    if (opt.execute) {
                        rethrow;
                    }
                    logger.info("cannot connect: %s: %s", ex.err, ex.desc);
                    cast<VscDebugAdapterRemote>(vda).connectError = ex;
                }
            }
            if (opt.execute) {
                logger.debug("Execute command: %y", opt.execute);
                vda.execute(opt.execute);
            } else {
                # programs debugged in this process write to stdout, which is the channel of the protocol
                if (vda instanceof VscDebugAdapterLocal) {
                    if (vda.captureProgramOutput()) {
                        # the output that a thread writes before an interrupt reaches the IDE before the interrupt
                        cast<VscDebugAdapterLocal>(vda).dpc.setOutputCapture(vda.getOutputCapture());
                    }
                }
                logger.debug("Run vda adapter");
                vda.run();
            }

            # resume any blocked debug threads and clean up before program exit
            # to avoid PROGRAM-ERROR in destructors
            if (vda instanceof VscDebugAdapterLocal) {
                logger.debug("Shutdown local adapter");
                VscDebugAdapterLocal local_vda = cast<VscDebugAdapterLocal>(vda);
                local_vda.dpc.shutdown();
                local_vda.dpc.unregisterConnection(DebugProgramControlLocal::CX);
                local_vda.dpc.waitForTerminationAndClear();
                vda.stopProgramOutputCapture();
                delete vda;
            } else {
                logger.debug("Disconnect remote adapter");
                cast<VscDebugAdapterRemote>(vda).closing = True;
                cast<VscDebugAdapterRemote>(vda).wsc.disconnect();
            }
        } catch (hash<ExceptionInfo> e) {
            logger.info("%y", e);
            printErr("%s: %s", e.err, e.desc);
            exit(-1);
        }

    }

    private help(int exCode=1) {
        printf("usage: %s [options]\n"
            "The debug adapter of Visual Studio Code and other IDEs that use the Debug Adapter Protocol: the IDE\n"
            "starts it and talks to it through the standard input and output.  It debugs scripts in its own process,\n"
            "or the programs of a debug server, such as qdbg-server, with -a.\n"
            "\n"
            "  -h                           show this help\n"
            "  -v, --verbose                write a log of what the adapter does\n"
            "  -f, --full-exception         show exceptions with all their details, such as their call stacks\n"
            "  -l, --logger-filename=<file> the file of the log of -v; the default is %s;\n"
            "                               without this option, the log is also shown in the debug console of the IDE\n"
            "  -A, --append-to-log          add to the log file instead of replacing it\n"
            "  -g, --program=<program>      the program of the debug server to debug, when the IDE does not give it\n"
            "\n"
            "Scripts debugged in the adapter process:\n"
            "  -D, --define=name[=value]    set a parse define of the scripts\n"
            "  -p, --set-parse-option=opt   set a parse option of the scripts, such as -pno-database\n"
            "  -z, --time-zone=zone         the time zone of the scripts: a region name, such as Europe/Prague, or a\n"
            "                               UTC offset, such as +01:00\n"
            "\n"
            "Programs of a debug server:\n"
            "  -a, --attach=<url>           the URL of the debug server, such as ws://localhost:8001/debug, or the\n"
            "                               name of a connection to it (QORE_CONNECTION_PROVIDERS)\n"
            "  -H, --header=<name>=<value>  add an HTTP header to the connection, such as\n"
            "                               -H \"Authorization=Bearer <token>\" for a server that requires a token\n"
            "  -m, --max-redir=<number>     the maximum number of HTTP redirects; the default is 5\n"
            "  -P, --proxy=<url>            connect through an HTTP proxy\n"
            "  -t, --timeout=<ms>           how long reading from or writing to the connection may take, in\n"
            "                               milliseconds\n"
            "  -c, --conn-timeout=<ms>      how long opening the connection may take, in milliseconds\n"
            "  -w, --resp-timeout=<ms>      how long to wait for the answer of the debug server to a command, in\n"
            "                               milliseconds; the default is %d\n"
            "  -X, --execute=pgmlist        list the programs of the debug server as JSON and end\n"
            "\n"
            "Examples:\n"
            "  %s -v -l vscda.log\n"
            "  %s -a ws://localhost:8001/debug -X pgmlist\n"
            "\n"
            ,
            get_script_name(),
            get_full_log_file_path(".log"),
            VscDebugAdapterRemote::WSC_TIMEOUT.durationMilliseconds(),
            get_script_name(),
            get_script_name(),

        );
        exit(exCode);
    }


    public dummy() {
    }
}
