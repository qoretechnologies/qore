# interactive bidi socket handler: holds in-memory state for the stream lifetime;
# reads framed YAML ops (blocking), replies per op; a "select" sees prior "insert"s (read-your-writes)
class SqlSessionHandler inherits AbstractHttpSocketHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (is_extended_connect(cx, hdr)) {
            return <HttpResponseInfo>{"code": 200, "streaming": True};
        }
        return makeResponse(400, "expected extended CONNECT");
    }
    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Socket s) {
        Queue q = cx."header-info".stream_data_queue;
        code send = cx."header-info".send_stream_data;
        list<auto> rows = ();
        while (True) {
            auto chunk = q.get(10s);
            if (!exists chunk) break;                    # END_STREAM
            hash<auto> op = parse_yaml(chunk.toString("utf-8"));
            hash<auto> reply;
            switch (op.cmd) {
                case "insert": rows += op.row; reply = {"status": "ok", "n": rows.size()}; break;
                case "select": reply = {"status": "ok", "rows": rows}; break;
            }
            send(binary(make_yaml(reply)));
        }
        send(NOTHING, True);
        return False;
    }
}
binary sub readFrame(HTTPClient c, int sid) {
    date deadline = now_us() + 10s;
    while (now_us() < deadline) {
        *binary b = c.readHttp2StreamData(sid, 2000);
        if (b) return b;
        if (c.isHttp2StreamClosed(sid)) break;
    }
    return binary();
}
class Main {
    constructor() {
        HttpServer http(<HttpServerOptionInfo>{});
        http.waitForAsyncIo();
        http.setHandler("s", "/bidi", MimeTypeText, new SqlSessionHandler(), NOTHING, True);
        http.setDefaultHandler("s", new SqlSessionHandler());
        int port = http.addListener(<HttpListenerOptionInfo>{"service": "0", "node": "127.0.0.1",
            "family": AF_INET, "cert": new SSLCertificate(CertPem), "key": new SSLPrivateKey(KeyPem)}).port;
        printf("listening on %d\n", port);
        HTTPClient c({"url": sprintf("https://127.0.0.1:%d", port), "ssl_verify_cert": False, "http_version": "2.0"});
        c.connect();
        hash<auto> resp = c.sendHttp2Connect("/bidi", NOTHING, "bidi-stream");
        printf("connect code=%y\n", resp.status_code);
        int sid = resp.stream_id;
        # INTERACTIVE: insert, read ack, select, read result (must see the insert), insert, select
        c.sendHttp2StreamData(sid, binary(make_yaml({"cmd": "insert", "row": {"id": 1}})));
        auto a1 = parse_yaml(readFrame(c, sid).toString("utf-8"));
        printf("insert1 ack: %y\n", a1);
        c.sendHttp2StreamData(sid, binary(make_yaml({"cmd": "select"})));
        auto s1 = parse_yaml(readFrame(c, sid).toString("utf-8"));
        printf("select1 saw %d rows\n", s1.rows.size());
        c.sendHttp2StreamData(sid, binary(make_yaml({"cmd": "insert", "row": {"id": 2}})));
        readFrame(c, sid);
        c.sendHttp2StreamData(sid, binary(make_yaml({"cmd": "select"})));
        auto s2 = parse_yaml(readFrame(c, sid).toString("utf-8"));
        printf("select2 saw %d rows: %y\n", s2.rows.size(), (map $1.id, s2.rows));
        c.sendHttp2StreamData(sid, NOTHING, True);
        printf("INTERACTIVE-RYW: %s\n", s2.rows.size() == 2 ? "WORKS" : "BROKEN");
        delete http;
    }
}
