%modern

%requires HttpServer
%requires Logger

# HttpServer with a trivial handler; GET /quit ends it and reports the process CPU time
#
# It listens on the port in HTTP_BENCH_PORT, else on a port of its own (port 0), so that concurrent runs on a host do
# not share a server, and prints "ready <port>" once it listens.

class QuickHandler inherits AbstractHttpRequestHandler {
    private {
        Counter quit();
    }

    constructor() {
        quit.inc();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<HttpResponseInfo> rv = makeResponse(200, "ok", {"Content-Type": "text/plain"});
        if (hdr.path == "quit") {
            # the server is stopped once the response has been written to the socket: HttpServer::stop() cancels the
            # sends that are still pending, so stopping it as soon as the request arrives could close the connection
            # before the response was sent (SOCKET-CLOSED in the client, #5811)
            Counter q = quit;
            rv.after_send = sub (hash<auto> cx, bool sent) {
                q.dec();
            };
        }
        return rv;
    }

    #! with HTTP_BENCH_INLINE=1 the handler opts in to inline dispatch on the async callback dispatcher worker
    bool canHandleInline(hash<auto> cx, hash<auto> hdr) {
        return ENV.HTTP_BENCH_INLINE == "1" && !hdr.path.endsWith("quit");
    }

    hash<HttpResponseInfo> handleInlineRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "ok", {"Content-Type": "text/plain"});
    }

    waitForQuit() {
        quit.waitForZero();
    }
}

Logger logger("bench", LoggerLevel::getLevelError());
HttpServer server(<HttpServerOptionInfo>{"logger": logger});
QuickHandler handler();
server.setHandler("handler", "", NOTHING, handler);
server.setDefaultHandler("handler", handler);
int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1",
    "service": (ENV.HTTP_BENCH_PORT ?? 0).toInt()}).port;
server.waitForAsyncIo();
# with HTTP_BENCH_FAST=1 "GET /" is a fast route: the async I/O thread answers it without calling Qore code
if (ENV.HTTP_BENCH_FAST == "1") {
    server.addFastRoute("/", {"public": True, "response": {"code": 200, "body": "ok", "content_type": "text/plain"}});
}
printf("ready %d\n", port);
stdout.sync();
handler.waitForQuit();
# fields 14 and 15 of /proc/self/stat are utime and stime in clock ticks
list<string> f = (split(" ", (File::readTextFile("/proc/self/stat") =~ x/\) (.*)$/)[0]));
printf("server_cpu_ticks user=%s sys=%s\n", f[11], f[12]);
server.stop();
