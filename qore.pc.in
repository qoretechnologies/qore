prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
datarootdir=@CMAKE_INSTALL_FULL_DATAROOTDIR@
moduledir=${libdir}/qore-modules
usermoddir=${datarootdir}/qore-modules
usermodverdir=${usermoddir}/@VERSION@

Name: Qore
Description: Qore programming language library
URL: http://qore.org
Version: @VERSION@
Libs: -L${libdir} -lqore
Cflags: -I${includedir}
